#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

Процедура УстановитьСтатусВыписки(Ссылка, Статус) Экспорт
	
	СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Ссылка);
	Запись = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
	Запись.ПлатежноРасчетныйДокумент 	= Ссылка;
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		Попытка
			Запись[Ресурс.Имя]	= СостояниеВыписки[Ресурс.Имя];
		Исключение
		КонецПопытки;	
	КонецЦикла;
	Запись.ПервичныйОбразИРеквизиты = СостояниеВыписки.ПервичныйОбразИРеквизиты;
	Запись.Статус = Статус;
	Запись.Записать();
	
КонецПРоцедуры	

// Создает документ "ВыпискаИзЛицевогоСчетаУчреждения" по данным, полученным из ЕБП.
// 
// Параметры:
//   ДанныеКОбработке - Структура;
//    * ПОКАЗАТЕЛИПФХД - ТаблицаЗначений
//    * ОПЕРАЦИИСЦЕЛЕВЫМИСУБСИДИЯМИ - ТаблицаЗначений 
//    * ОПЕРАЦИИПОСЧЕТУ - ТаблицаЗначений 
//		* ВидСтроки - Строка
//		* ТипОперации - Строка, принимает значения: 
//  		1 - Поступление
//  		2 - Возврат поступлений
//  		3 - Кассовый расход
//  		4 - Восстановление кассового расхода 
//		* ГУИДПодтверждающегоДокументаСтрокой - Строка 
//		* ГУИДПодтверждающегоДокумента - УникальныйИдентификатор 
//		* ГУИДДокументаАУБУСтрокой - Строка  
//		* ГУИДДокументаАУБУ - УникальныйИдентификатор 
//		* НомерПодтверждающегоДокумента - Строка
//		* ДатаПодтверждающегоДокумента - Дата
//		* ИдентификаторСоставителя - Строка
//		* НаименованиеДокументаАУБУ - Строка
//		* НомерДокументаАУБУ - Строка
//		* ДатаДокументаАУБУ - Дата
//		* ТипКБК - Строка
//		* КодБК - Строка
//		* КодПоступленияЕБП - Строка
//		* КодПрослеживаемости - Строка
//		* КодФАИП - Строка
//		* ИдентификаторКонтракта - Строка
//		* КодЦелевойСубсидии - Строка
//		* СуммаОперации - Число
//		* СуммаБезПраваРасходования - Число
//		* Примечание - Строка  
//    * ДокументыБГУ - ТаблицаЗначений, содержит документы выписки, уже существующие в БГУ 
//		* Ссылка ДокументСсылка: РСКППеречисление, РСКПВозврат, РСКПУточнение, РСКППеречислениеМир, ПоступлениеНаСчет.
//		* GUID - УникальныйИдентификатор
//    * ГУИДДокументов - ТаблицаЗначений, содержит уникальные идентификаторы документов, включенных в выписку
//		* ГУИДПодтверждающегоДокументаСтрокой - Строка 
//		* ГУИДПодтверждающегоДокумента - УникальныйИдентификатор 
//		* ГУИДДокументаАУБУСтрокой - Строка  
//		* ГУИДДокументаАУБУ - УникальныйИдентификатор
//
Процедура СоздатьВыпискуПоДаннымЕБП(ДанныеКОбработке, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаВыписка) Экспорт    
	
	// Проверка наличия лицевого счета. Лицевой счет должен быть заведен до формирования документов.
	ЛицевойСчетДляЗагрузки = Справочники.ЛицевыеСчета.ЛицевойСчетПоНомеру(ДанныеКОбработке.ЛицевойСчет, Организация);
	Если Не ЗначениеЗаполнено(ЛицевойСчетДляЗагрузки) Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Не найден лицевой счет № %1. Документ %2 от %3 ID %4 не может быть обработан'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ИнформацияОбОшибке, 
		ДанныеКОбработке.ЛицевойСчет, 
		ДанныеКОбработке.НомерВыписки, 
		ДанныеКОбработке.ДатаВыписки, 
		ДанныеКОбработке.ИдентификаторВыписки);
		Возврат;
	КонецЕсли; 
	// Проверка типа лицевого счета.
	ТипЛС = Неопределено;
	Если Лев(ДанныеКОбработке.ЛицевойСчет, 2) = "80" Или Лев(ДанныеКОбработке.ЛицевойСчет, 2) = "90" Тогда
		ТипЛС = "АУБУ";
	ИначеЕсли Лев(ДанныеКОбработке.ЛицевойСчет, 2) = "05"	Тогда
		ТипЛС = "ВРПБС";
	КонецЕсли;
	Если ТипЛС = Неопределено Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Неизвестный тип лицевого счета № %1'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ДанныеКОбработке.ЛицевойСчет); 
		Возврат;
	КонецЕсли; 

	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы.ВыпискаИзЛицевогоСчетаУчреждения.СоздатьДокумент(); 
		НовыйДокумент.УстановитьСсылкуНового(СсылкаВыписка); 
		НовыйДокумент.Заблокировать();  
		
		НовыйДокумент.Внешнее = Истина;
		НовыйДокумент.Организация = Организация; 
		НовыйДокумент.МодульИнтеграции = ДанныеКОбработке.МодульИнтеграции;
		
		// Лицевой счет  
		НовыйДокумент.ЛицевойСчет = ЛицевойСчетДляЗагрузки;
		            		
		// Заголовочная часть выписки 
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НовыйДокумент.ДатаВыписки = ДанныеКОбработке.ДатаВыписки; 
		НовыйДокумент.НомерВыписки = ДанныеКОбработке.НомерВыписки;  
		НовыйДокумент.НачалоПериода = ДанныеКОбработке.ДатаС;  
		НовыйДокумент.ОкончаниеПериода = ДанныеКОбработке.ДатаПо;
		НовыйДокумент.РежимФормирования = ДанныеКОбработке.РежимФормирования;  
		Если НЕ НачалоДня(НовыйДокумент.НачалоПериода) = НачалоДня(НовыйДокумент.ОкончаниеПериода) Тогда
			ИнформацияОбОшибке = ИнформацияОбОшибке + "
			|" + НСтр("ru = 'Период выписки не может быть более одного дня. В файле - начало периода %1, окончание периода %2'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, НовыйДокумент.НачалоПериода, НовыйДокумент.ОкончаниеПериода); 
			ОтменитьТранзакцию();
			Возврат; 
		КонецЕсли;	
 
	    // Остатки на начало и конец дня, обороты
		СтрОстатки = НовыйДокумент.Остатки.Добавить();
		СтрОстатки.Показатель = ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ОстатокСредствНаСчете");
		ДанныеКОбработке.Свойство("ОстатокНаНачалоДня", СтрОстатки.ОстатокНаНачалоДня);
		ДанныеКОбработке.Свойство("ОстатокНаКонецДня", СтрОстатки.ОстатокНаКонецДня);  
		СтрОстатки = НовыйДокумент.Остатки.Добавить();
		СтрОстатки.Показатель = ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ОстатокСредствБезПраваРасходования"); 
		ДанныеКОбработке.Свойство("ОстатокНаНачалоНеразрешенный", СтрОстатки.ОстатокНаНачалоДня);
		ДанныеКОбработке.Свойство("ОстатокНаКонецНеразрешенный", СтрОстатки.ОстатокНаКонецДня); 
		
		ДанныеКОбработке.Свойство("ПоступилоЗаДень", НовыйДокумент.Поступило);  
		ДанныеКОбработке.Свойство("ВыбылоЗаДень", НовыйДокумент.Выбыло); 

		// Операции по счету 
		
		ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ФайловаяСистема.СоздатьВременныйКаталог());
		ДанныеКОбработке.ЧтениеZipФайла.ИзвлечьВсе(ВременныйКаталог);
		// Цикл по уникальным идентификатором документов из выписки.
		Для Каждого ИдентификаторДокумента Из ДанныеКОбработке.ГУИДДокументов Цикл 
			ДокументБГУ = Неопределено;
			ГУИДВложения = "";  
			ГУИДДокументаБГУСтрокой = ?(ТипЛС = "АУБУ", ИдентификаторДокумента.ГУИДДокументаАУБУСтрокой, ИдентификаторДокумента.ГУИДДокументаКУСтрокой); 
			ГУИДДокументаБГУ = ?(ТипЛС = "АУБУ", ИдентификаторДокумента.ГУИДДокументаАУБУ, ИдентификаторДокумента.ГУИДДокументаКУ);
			ИмяГУИДДокументаБГУ = ?(ТипЛС = "АУБУ", "ГУИДДокументаАУБУ", "ГУИДДокументаКУ");
			
			// Документ, поступивший из бухгалтерской системы, возможно - ранее выгруженный из БГУ документ.
			Если ЗначениеЗаполнено(ГУИДДокументаБГУСтрокой) Тогда
				СтрТЧДокументБГУ = ДанныеКОбработке.ДокументыБГУ.Найти(ГУИДДокументаБГУ, "GUID");
				Если НЕ СтрТЧДокументБГУ = Неопределено Тогда
					// Документ есть в БД. 
					СтрокаДокумента = НовыйДокумент.ДокументыДвижений.Добавить();
					СтрокаДокумента.ИсполняющийДокумент = СтрТЧДокументБГУ.Ссылка; 
					ГУИДВложения = ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой;
					ДокументБГУ = СтрТЧДокументБГУ.Ссылка;  
					// Статус документа
					ТекущийСтатусДокумента = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументБГУ);  
					Если НЕ ТекущийСтатусДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")
						И НЕ ТекущийСтатусДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично") Тогда 
						ДанныеДокумента = ДанныеКОбработке.ОПЕРАЦИИПОСЧЕТУ.Скопировать(Новый Структура("ВидСтроки, " + ИмяГУИДДокументаБГУ, "INDICATOR", ГУИДДокументаБГУ));
						Если ДанныеДокумента.Количество() > 0 Тогда  
							СуммаПоВыписке = ДанныеДокумента.Итог("СуммаОперации");
						Иначе
							СуммаПоВыписке = 0;
						КонецЕсли;  
						Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокументаВВалюте", ДокументБГУ.Метаданные()) Тогда 
							ДокументБГУРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументБГУ, "ДатаРСКП,НомерРСКП,СуммаДокумента,СуммаДокументаВВалюте"); 
						Иначе 
							ДокументБГУРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументБГУ, "ДатаРСКП,НомерРСКП,СуммаДокумента"); 
							ДокументБГУРеквизиты.Вставить("СуммаДокументаВВалюте", ДокументБГУРеквизиты.СуммаДокумента); 
						КонецЕсли;
						Блокировка = Новый БлокировкаДанных;
						ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
						ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", ДокументБГУ); 
						Блокировка.Заблокировать();  
						НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(ДокументБГУ);
						НаборЗаписей.Прочитать(); 
						Если НаборЗаписей.Количество() = 0 Тогда
							Запись = НаборЗаписей.Добавить();
						Иначе
							Запись = НаборЗаписей[0];
						КонецЕсли;
						Запись.ПлатежноРасчетныйДокумент = ДокументБГУ; 
						Если СуммаПоВыписке = ДокументБГУРеквизиты.СуммаДокумента 
							ИЛИ СуммаПоВыписке = ДокументБГУРеквизиты.СуммаДокументаВВалюте Тогда
							Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен"); 
						Иначе
							Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично"); 
						КонецЕсли;
						Запись.ДатаПроведения = НовыйДокумент.НачалоПериода;
						НаборЗаписей.Записать(); 
						
						// Номер и дата РСКП
						Если (НЕ ЗначениеЗаполнено(ДокументБГУРеквизиты.ДатаРСКП) 
							Или НЕ ЗначениеЗаполнено(ДокументБГУРеквизиты.НомерРСКП))
							И ДанныеДокумента.Количество() > 0 Тогда
							Блокировка = Новый БлокировкаДанных;
							ЭлементБлокировки = Блокировка.Добавить("Документ." + ДокументБГУ.Метаданные().Имя);
							ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументБГУ); 
							Блокировка.Заблокировать(); 
							ДокументБГУОбъект = ДокументБГУ.ПолучитьОбъект();
							Если ТипЛС = "АУБУ" Тогда
								ДокументБГУОбъект.ДатаРСКП = ДанныеДокумента[0].ДатаДокументаАУБУ;
								ДокументБГУОбъект.НомерРСКП = ДанныеДокумента[0].НомерДокументаАУБУ; 
							Иначе
								ДокументБГУОбъект.ДатаРСКП = ДанныеДокумента[0].ДатаДокументаКУ;
								ДокументБГУОбъект.НомерРСКП = ДанныеДокумента[0].НомерДокументаКУ;
							КонецЕсли;
							ДокументБГУОбъект.Записать();
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли; 	 
			
			// Документа в БД нет - входящий документ или РСКП, сформированное в ЕБП и не переданное в БГУ
			Если ДокументБГУ = Неопределено И ЗначениеЗаполнено(ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой) Тогда
				// Если это входящий документ - возможно в БГУ уже загружался
				СтрТЧДокументБГУ = ДанныеКОбработке.ДокументыБГУ.Найти(ИдентификаторДокумента.ГУИДПодтверждающегоДокумента, "GUID");
				
				// Документ есть в БД. 
				Если НЕ СтрТЧДокументБГУ = Неопределено Тогда
					
					СтрокаДокумента = НовыйДокумент.ДокументыДвижений.Добавить();
					СтрокаДокумента.ИсполняющийДокумент = СтрТЧДокументБГУ.Ссылка; 
					ГУИДВложения = ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой;
					ДокументБГУ = СтрТЧДокументБГУ.Ссылка;
				КонецЕсли;  
				
				// Нет документа в БД, пробуем определить что это и создать документ.
				Если ДокументБГУ = Неопределено Тогда	
					ДанныеДокумента = ДанныеКОбработке.ОПЕРАЦИИПОСЧЕТУ.Скопировать(Новый Структура("ВидСтроки, ГУИДПодтверждающегоДокумента", 
					"INDICATOR", ИдентификаторДокумента.ГУИДПодтверждающегоДокумента));    
					// Нет данных для загрузки
					Если ДанныеДокумента.Количество() = 0 Тогда
						ИнформацияОбОшибке = ИнформацияОбОшибке + "
						|" + НСтр("ru = 'Отсутствуют данные документа с идентификатором %1'");
						ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой); 
						Продолжить;
					КонецЕсли;
					
					ДанныеЗаголовка = ДанныеДокумента.Скопировать();
					ДанныеЗаголовка.Свернуть( 
					"ГУИДПодтверждающегоДокумента, ГУИДПодтверждающегоДокументаСтрокой, ДатаПодтверждающегоДокумента, НаименованиеПодтверждающегоДокумента, НомерПодтверждающегоДокумента, НаименованиеДокументаАУБУ, НаименованиеДокументаКУ, ТипОперации",
					"СуммаБезПраваРасходования, СуммаОперации"); 
					ДанныеРасшифровки = ДанныеДокумента.Скопировать();
					ДанныеРасшифровки.Свернуть(
					"ИдентификаторКонтракта, КодБК, КодПоступленияЕБП, КодПрослеживаемости, КодФАИП, КодЦелевойСубсидии, ТипКБК, Примечание, ТипОперации",
					"СуммаБезПраваРасходования, СуммаОперации");
					
					// Для РСКП (уточнение) документов поступления/выбытия не загружаем
					Если (ДанныеЗаголовка[0].НаименованиеПодтверждающегоДокумента = "РСКП (уточнение)"
						ИЛИ ДанныеЗаголовка[0].НаименованиеДокументаАУБУ = "РСКП (уточнение)"
						ИЛИ ДанныеЗаголовка[0].НаименованиеДокументаКУ = "РСКП (уточнение)") Тогда 
						Продолжить;
					КонецЕсли;
					
					// Обрабатываем поступления (1) и восстановление расходов (4).
					// Всегда входящие документы. Создаем документ ПоступлениеНаСчет.
					Если НЕ ДанныеЗаголовка.Найти("1", "ТипОперации") = Неопределено
						ИЛИ НЕ ДанныеЗаголовка.Найти("4", "ТипОперации") = Неопределено Тогда
						
						// В одном документе могут быть типы операций 1 (4) и 2.
						// Известен пример передачи средств временного распоряжения на ПД - в одном документе 1 и 2.
						// Обрабатываем только поступления.
						ДанныеЗаголовкаДляЗагрузки = ДанныеЗаголовка.Скопировать(Новый Структура("ТипОперации", "1"));
						ДанныеРасшифровкиДляЗагрузки  = ДанныеРасшифровки.Скопировать(Новый Структура("ТипОперации", "1")); 
						Если ДанныеЗаголовкаДляЗагрузки.Количество() = 0 Тогда
							ДанныеЗаголовкаДляЗагрузки = ДанныеЗаголовка.Скопировать(Новый Структура("ТипОперации", "4"));
							ДанныеРасшифровкиДляЗагрузки  = ДанныеРасшифровки.Скопировать(Новый Структура("ТипОперации", "4")); 
						КонецЕсли;
						
						СтрокаВложения = ДанныеКОбработке.ЭлементыВыпискиXml.Найти(ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой, "ГУИДВложения"); 
						// Нет данных для загрузки
						Если СтрокаВложения = Неопределено Тогда 
							ИнформацияОбОшибке = ИнформацияОбОшибке + "
							|" + НСтр("ru = 'Отсутствуют данные документа с идентификатором %1'");
							ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой);
							Продолжить;
						Иначе 
							ТекстОшибки = "";
							ДвоичныеДанные = Новый ДвоичныеДанные(ВременныйКаталог + СтрокаВложения.ЭлементZipФайла.Имя);  
							ДанныеФайлаВложения = ЖурналыДокументов.ВзаимодействияСЕБП.ПолучитьДанныеФайлаВложений(ДвоичныеДанные, ДанныеКОбработке.ТипОбмена, ТекстОшибки); 
							Если ЗначениеЗаполнено(ТекстОшибки) Тогда
								ИнформацияОбОшибке = ИнформацияОбОшибке + "
								|" + ТекстОшибки + " " + НСтр("ru = 'Не удалось обработать файл %1'");
								ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, СтрокаВложения.Имя);
								Продолжить;
							КонецЕсли;
						КонецЕсли;   
							
						СсылкаНаПоступление = Документы.ПоступлениеНаСчет.Получитьссылку(ИдентификаторДокумента.ГУИДПодтверждающегоДокумента);  
						
						ПараметрыНовогоДокумента = Новый Структура;
						ПараметрыНовогоДокумента.Вставить("МодульИнтеграции", ДанныеКОбработке.МодульИнтеграции);
						ПараметрыНовогоДокумента.Вставить("ДатаУчетная", ДанныеКОбработке.ДатаС);
						ПараметрыНовогоДокумента.Вставить("ДанныеЗаголовка", ДанныеЗаголовкаДляЗагрузки[0]);
						ПараметрыНовогоДокумента.Вставить("ДанныеРасшифровки", ДанныеРасшифровкиДляЗагрузки);  
						ПараметрыНовогоДокумента.Вставить("ДанныеФайлаВложения", ДанныеФайлаВложения); 
						ПараметрыНовогоДокумента.Вставить("ТипЛС", ТипЛС); 
						Если ДанныеЗаголовкаДляЗагрузки[0].ТипОперации = "1" Тогда 
							Если ТипЛС = "АУБУ" Тогда
								ПараметрыНовогоДокумента.Вставить("КорСчет", БухгалтерскийУчет.СчетПоКоду("205.00", ДанныеКОбработке.ДатаС, Организация)); 
							КонецЕсли;
						ИначеЕсли ДанныеЗаголовкаДляЗагрузки[0].ТипОперации = "4" Тогда 
							Если ТипЛС = "АУБУ" Тогда
								ПараметрыНовогоДокумента.Вставить("КорСчет", БухгалтерскийУчет.СчетПоКоду("302.00", ДанныеКОбработке.ДатаС, Организация));
							КонецЕсли;
						КонецЕсли;	
						ТекстОшибки = "";
						Документы.ПоступлениеНаСчет.СоздатьНовыйПоступлениеНаСчетПоДаннымЕБП(СсылкаНаПоступление, ПараметрыНовогоДокумента, Организация, НовыйДокумент.ЛицевойСчет, ТекстОшибки);
						// Не смогли обработать файл.
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда
							ИнформацияОбОшибке = ИнформацияОбОшибке + "
							|" + ТекстОшибки + " " + НСтр("ru = 'Не удалось обработать файл %1'");
							ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, СтрокаВложения.Имя);
							Продолжить;
						КонецЕсли;
							
						ЕстьОшибка = НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СсылкаНаПоступление))
						ИЛИ НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаНаПоступление);
						Если ЕстьОшибка Тогда
							Продолжить;
						КонецЕсли;
							
						СтрокаДокумента = НовыйДокумент.ДокументыДвижений.Добавить();
						СтрокаДокумента.ИсполняющийДокумент = СсылкаНаПоступление; 
						ГУИДВложения = ИдентификаторДокумента.ГУИДПодтверждающегоДокументаСтрокой;
						ДокументБГУ = СсылкаНаПоступление;
							
					КонецЕсли;	
				КонецЕсли; 
			КонецЕсли;	
			
			// Приложение к документу
			Если НЕ ДокументБГУ = Неопределено Тогда
				СтрокаВложения = ДанныеКОбработке.ЭлементыВыпискиXml.Найти(ГУИДВложения, "ГУИДВложения"); 
				Если НЕ СтрокаВложения = Неопределено Тогда
					СтрокаПриложения = ДанныеКОбработке.ЭлементыВыпискиPdf.Найти(СтрокаВложения.Имя, "Имя");  
					Если НЕ СтрокаПриложения = Неопределено Тогда 
						ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
						ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
						ПараметрыФайла.ВладелецФайлов = ДокументБГУ;
						ПараметрыФайла.ИмяБезРасширения = СтрокаПриложения.Имя; 
						ПараметрыФайла.РасширениеБезТочки = СтрокаПриложения.Расширение;
						 
						ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ВременныйКаталог + СтрокаПриложения.ЭлементZipФайла.Имя); 
						АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла); 
						ДанныеПриложения = ДанныеКОбработке.ОПЕРАЦИИПОСЧЕТУ.Скопировать(Новый Структура("ВидСтроки, ГУИДПодтверждающегоДокументаСтрокой", "INDICATOR", ГУИДВложения));    
						Если ДанныеПриложения.Количество() > 0 Тогда 
							ОписаниеВложения = СокрЛП(ДанныеПриложения[0].НаименованиеПодтверждающегоДокумента)
							+ " № " + СокрЛП(ДанныеПриложения[0].НомерПодтверждающегоДокумента)
							+ " от " + Формат(ДанныеПриложения[0].ДатаПодтверждающегоДокумента, "ДФ=dd.MM.yyyy; ДП=-");
						Иначе
							ОписаниеВложения = "";
						КонецЕсли;	
						РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВременногоХранилищаФайла,, ОписаниеВложения); 
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли; 
				
		КонецЦикла; 
		
		НовыйДокумент.Записать(); 
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
		ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", НовыйДокумент.Ссылка); 
		Блокировка.Заблокировать();  
		НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(НовыйДокумент.Ссылка);
		НаборЗаписей.Прочитать(); 
		Если НаборЗаписей.Количество() =0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.ПлатежноРасчетныйДокумент = НовыйДокумент.Ссылка; 
		Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен"); 
		
		//нужная дата проведения - дата за которую сформирована выписка (дата окончания периода), 
		//т.к. выписка может быть сформирована позднее, и дата (формирования) выписки будет отличаться, 
		//но если вдруг дата окончания по какой-то причине будет не заполнена, пишем дату выписки

		Запись.ДатаПроведения = ?(ЗначениеЗаполнено(НовыйДокумент.ОкончаниеПериода),НовыйДокумент.ОкончаниеПериода,НовыйДокумент.ДатаВыписки);
		
		НаборЗаписей.Записать();
				
		ЗафиксироватьТранзакцию();
		ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);
    Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПРоцедуры	
	

#КонецОбласти

#КонецЕсли
