Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Контрагент,
	ДокументОбъект.Контрагент,
	Форма.Элементы.ГруппаКонтрагент);
	
КонецПроцедуры


// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьГрафикПлатежейПоПараметрам(ДокументОбъект, ПараметрыГрафиков) Экспорт
	
	ГрафикПлатежейИсходный = ДокументОбъект.ГрафикПлатежей.Выгрузить();
	ГрафикПлатежейНовый = ГрафикПлатежейИсходный.СкопироватьКолонки();
	ГрафикПлатежейНовый.Колонки.Добавить("БазаРаспределения", Новый ОписаниеТипов("Число"));
	
	ПараметрыПериода = УчетДоходовРасходов.ПараметрыПризнанияДоходовРасходовПоМесяцам(ПараметрыГрафиков.НачалоПериодаПлатежей, ПараметрыГрафиков.КонецПериодаПлатежей);
	ПлатежиВКонцеПериода = (ПараметрыГрафиков.ВариантПлатежей = 0);
	
	// Инициализация переменных цикла.
	Если ПараметрыГрафиков.ПериодичностьПлатежей = "ПоМесяцам" Тогда // Начало месяца.
		ОчереднойМесяц = НачалоМесяца(ПараметрыГрафиков.НачалоПериодаПлатежей);
	ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоКварталам" Тогда // Начало квартала.
		ОчереднойМесяц = НачалоКвартала(ПараметрыГрафиков.НачалоПериодаПлатежей);
	ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоПолугодиям" Тогда // Начало полугодия.
		ОчереднойМесяц = ?(Месяц(ПараметрыГрафиков.НачалоПериодаПлатежей) <= 6, НачалоГода(ПараметрыГрафиков.НачалоПериодаПлатежей),
			Дата(Год(ПараметрыГрафиков.НачалоПериодаПлатежей), 7, 1) );
	ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоГодам" Тогда // Начало года.
		ОчереднойМесяц = НачалоГода(ПараметрыГрафиков.НачалоПериодаПлатежей);
	Иначе // Раз в месяц, в 3 месяца, в 6 месяцев, в 12 месяцев.
		ОчереднойМесяц = НачалоДня(ПараметрыГрафиков.НачалоПериодаПлатежей);
	КонецЕсли;
	СчетчикПоКварталам = 0;
	СчетчикПоПолугодиям = 0;
	СчетчикПоГодам = 0;
	
	// Цикл по месяцам.
	Пока КонецДня(ОчереднойМесяц) <= КонецДня(ПараметрыГрафиков.КонецПериодаПлатежей) Цикл
		
		ДоляМесяца = 0;
		Если ПараметрыГрафиков.ПериодичностьПлатежей = "ПоМесяцам"
		 ИЛИ ПараметрыГрафиков.ПериодичностьПлатежей = "ПоКварталам"
		 ИЛИ ПараметрыГрафиков.ПериодичностьПлатежей = "ПоПолугодиям"
		 ИЛИ ПараметрыГрафиков.ПериодичностьПлатежей = "ПоГодам" Тогда
			
			НачалоПериода = Макс(ПараметрыГрафиков.НачалоПериодаПлатежей, НачалоДня(ОчереднойМесяц));
			КонецПериода = Мин(ПараметрыГрафиков.КонецПериодаПлатежей,  НачалоДня(КонецМесяца(ОчереднойМесяц)));
			
			Если КонецПериода < НачалоПериода Тогда
				ДоляМесяца = 0; // Месяц за пределами выбранного периода.
			ИначеЕсли НачалоПериода >= ПараметрыПериода.НачалоПериодаЦелыхМесяцев
				И КонецПериода <= ПараметрыПериода.КонецПериодаЦелыхМесяцев Тогда // Внутри периода целых месяцев.
				ДоляМесяца = 1; // Целый месяц.
			Иначе
				НецелыйМесяц = ПараметрыПериода.НецелыеМесяцы.Найти(НачалоМесяца(ОчереднойМесяц), "Месяц");
				Если НецелыйМесяц = Неопределено Тогда
					ДоляМесяца = 1; // Целый месяц.
				Иначе
					ДоляМесяца = НецелыйМесяц.Вес; // Нецелый месяц.
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			НачалоПериода = Макс(ПараметрыГрафиков.НачалоПериодаПлатежей, НачалоДня(ОчереднойМесяц));
			КонецПериода = Мин(ПараметрыГрафиков.КонецПериодаПлатежей,  ДобавитьМесяц(ОчереднойМесяц, 1));
			ДоляМесяца = 1;
			
		КонецЕсли;
		
		Если ПараметрыГрафиков.ПериодичностьПлатежей = "ПоМесяцам"
		 ИЛИ ПараметрыГрафиков.ПериодичностьПлатежей = "РазВ1Месяц" Тогда
			
			НоваяСтрока = ГрафикПлатежейНовый.Добавить();
			НоваяСтрока.БазаРаспределения = ДоляМесяца;
			НоваяСтрока.СрокПлатежа = ?(ПлатежиВКонцеПериода, КонецПериода, НачалоПериода);
			
		ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоКварталам"
			ИЛИ   ПараметрыГрафиков.ПериодичностьПлатежей = "РазВ3Месяца" Тогда
			
			СчетчикПоКварталам = СчетчикПоКварталам + 1;
			Если СчетчикПоКварталам > 3 Тогда
				СчетчикПоКварталам = 1; // Новый квартал.
			КонецЕсли;
			
			Если СчетчикПоКварталам = 1 Тогда
				НоваяСтрока = ГрафикПлатежейНовый.Добавить();
				НоваяСтрока.БазаРаспределения = ДоляМесяца;
			Иначе
				НоваяСтрока.БазаРаспределения = НоваяСтрока.БазаРаспределения + ДоляМесяца;
			КонецЕсли;
			
			Если Не ПлатежиВКонцеПериода И СчетчикПоКварталам = 1 Тогда
				НоваяСтрока.СрокПлатежа = НачалоПериода;
			ИначеЕсли ПлатежиВКонцеПериода Тогда
				НоваяСтрока.СрокПлатежа = КонецПериода;
			КонецЕсли;
			
		ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоПолугодиям"
			ИЛИ   ПараметрыГрафиков.ПериодичностьПлатежей = "РазВ6Месяцев" Тогда
			
			СчетчикПоПолугодиям = СчетчикПоПолугодиям + 1;
			Если СчетчикПоПолугодиям > 6 Тогда
				СчетчикПоПолугодиям = 1; // Новое полугодие.
			КонецЕсли;
			
			Если СчетчикПоПолугодиям = 1 Тогда
				НоваяСтрока = ГрафикПлатежейНовый.Добавить();
				НоваяСтрока.БазаРаспределения = ДоляМесяца;
			Иначе
				НоваяСтрока.БазаРаспределения = НоваяСтрока.БазаРаспределения + ДоляМесяца;
			КонецЕсли;
			
			Если Не ПлатежиВКонцеПериода И СчетчикПоПолугодиям = 1 Тогда
				НоваяСтрока.СрокПлатежа = НачалоПериода;
			ИначеЕсли ПлатежиВКонцеПериода Тогда
				НоваяСтрока.СрокПлатежа = КонецПериода;
			КонецЕсли;
			
		ИначеЕсли ПараметрыГрафиков.ПериодичностьПлатежей = "ПоГодам"
			ИЛИ   ПараметрыГрафиков.ПериодичностьПлатежей = "РазВ12Месяцев" Тогда
			
			СчетчикПоГодам = СчетчикПоГодам + 1;
			Если СчетчикПоГодам > 12 Тогда
				СчетчикПоГодам = 1; // Новый год.
			КонецЕсли;
			
			Если СчетчикПоГодам = 1 Тогда
				НоваяСтрока = ГрафикПлатежейНовый.Добавить();
				НоваяСтрока.БазаРаспределения = ДоляМесяца;
			Иначе
				НоваяСтрока.БазаРаспределения = НоваяСтрока.БазаРаспределения + ДоляМесяца;
			КонецЕсли;
			
			Если Не ПлатежиВКонцеПериода И СчетчикПоГодам = 1 Тогда
				НоваяСтрока.СрокПлатежа = НачалоПериода;
			ИначеЕсли ПлатежиВКонцеПериода Тогда
				НоваяСтрока.СрокПлатежа = КонецПериода;
			КонецЕсли;
			
		КонецЕсли;
		
		// Следующее значение переменной цикла.
		ОчереднойМесяц = ДобавитьМесяц(ОчереднойМесяц, 1);
		
	КонецЦикла;
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ПараметрыГрафиков.СуммаВРублях, ГрафикПлатежейНовый, "СуммаВРублях", "БазаРаспределения");
	Если ДокументОбъект.Валюта <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ПараметрыГрафиков.СуммаВВалюте, ГрафикПлатежейНовый, "СуммаВВалюте", "БазаРаспределения");
	КонецЕсли;
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(ДокументОбъект.СтатусОперации);
	Если ПризнакиСтатусаОперации.ЭтоУточнениеДоходов Тогда
		
		// Очищаем изменения в графике.
		СтрокиКУдалению = Новый Массив;
		Для Каждого СтрокаГрафикПлатежей Из ДокументОбъект.ГрафикПлатежей Цикл
			Если СтрокаГрафикПлатежей.СуммаВВалютеДоИзменения = 0
				И СтрокаГрафикПлатежей.СуммаВРубляхДоИзменения = 0 Тогда
				СтрокиКУдалению.Добавить(СтрокаГрафикПлатежей);
			Иначе
				СтрокаГрафикПлатежей.СуммаВВалюте = 0;
				СтрокаГрафикПлатежей.СуммаВРублях = 0;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ДокументОбъект.ГрафикПлатежей.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		// Добавляем новые платежи к старому графику.
		Для Каждого НовыйПлатеж Из ГрафикПлатежейНовый Цикл
			
			Отбор = Новый Структура("СрокПлатежа", НовыйПлатеж.СрокПлатежа);
			НайденныеСтроки = ДокументОбъект.ГрафикПлатежей.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаГрафикПлатежей = ДокументОбъект.ГрафикПлатежей.Добавить();
				СтрокаГрафикПлатежей.СрокПлатежа = НовыйПлатеж.СрокПлатежа;
			Иначе
				СтрокаГрафикПлатежей = НайденныеСтроки[0];
			КонецЕсли;
			
			СтрокаГрафикПлатежей.СуммаВВалюте = СтрокаГрафикПлатежей.СуммаВВалюте + НовыйПлатеж.СуммаВВалюте;
			СтрокаГрафикПлатежей.СуммаВРублях = СтрокаГрафикПлатежей.СуммаВРублях + НовыйПлатеж.СуммаВРублях;
			
		КонецЦикла;
		
		ДокументОбъект.ГрафикПлатежей.Сортировать("СрокПлатежа");
		
	Иначе // Загружаем новый график в табличную часть.
		ДокументОбъект.ГрафикПлатежей.Очистить();
		ДокументОбъект.ГрафикПлатежей.Загрузить(ГрафикПлатежейНовый);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ИзвещениеОНачисленииДоходов";
	КомандаПечати.Идентификатор		= "Форма0510432";
	КомандаПечати.Представление		= НСтр("ru = 'Извещение о начислении дохода (уточнении начисления) (ф. 0510432)'");
	КомандаПечати.Порядок			= 1;
		
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510432") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"Форма0510432",
		НСтр("ru = 'Извещение о начислении дохода (уточнении начисления) (ф. 0510432)'"),
		ПечатьИзвещенияОНачислении(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, "ПФ_MXL_Форма0510432"));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьИзвещенияОНачислении(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, ИмяМакета)
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);

	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ИзвещениеОНачисленииДоходов.Ссылка КАК Ссылка,
	|	ИзвещениеОНачисленииДоходов.Номер КАК Номер,
	|	ИзвещениеОНачисленииДоходов.Дата КАК ДатаДок,
	|	ИзвещениеОНачисленииДоходов.НормативныйАкт КАК НормативныйАкт,
	|	ИзвещениеОНачисленииДоходов.СтатусОперации.Код КАК СтатусОперации,
	|	ИзвещениеОНачисленииДоходов.СтатусОперации.ПолноеНаименование КАК НаименованиеСтатусаСперации,
	|	ИзвещениеОНачисленииДоходов.Организация.ОГРН КАК ОГРН,
	|	ИзвещениеОНачисленииДоходов.ЛицевойСчет КАК ЛицевойСчет,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.ЛицевойСчет.Код, """") КАК ЛицевойСчетКод,
	|	ИзвещениеОНачисленииДоходов.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,  
	|	ИзвещениеОНачисленииДоходов.СчетПолучателя КАК СчетПолучателя,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.СчетПолучателя.Код, """") КАК СчетПолучателяКод,
	|	ИзвещениеОНачисленииДоходов.ПолучательПлатежа КАК ПолучательПлатежа, 
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходов.ПолучательПлатежа.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
    |			ТОГДА ИзвещениеОНачисленииДоходов.ПолучательПлатежа.ЮридическоеФизическоеЛицо.ОГРН 
	|		ИНАЧЕ """" 
	|	КОНЕЦ КАК ПолучательОГРН,
	|	ИзвещениеОНачисленииДоходов.ИдентификаторПлательщика КАК ИдентификаторПлательщика,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента, """") = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо) КАК ЭтоФизЛицо,
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ИзвещениеОНачисленииДоходов.Контрагент.НаименованиеСокращенное
	|		ИНАЧЕ ИзвещениеОНачисленииДоходов.Контрагент.Наименование
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоИП,
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ""индивидуальный предприниматель""
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ""физическое лицо""
	|		КОГДА ИзвещениеОНачисленииДоходов.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|				И (ИзвещениеОНачисленииДоходов.Контрагент.ТипКонтрагента.Код = ""8""
	|					ИЛИ ИзвещениеОНачисленииДоходов.Контрагент.ТипКонтрагента.Код = ""9"")
	|			ТОГДА ""юридическое лицо - нерезидент Российской Федерации""
	|		ИНАЧЕ ""юридическое лицо - резидент Российской Федерации""
	|	КОНЕЦ КАК ТипПлательщика,
	|	ИзвещениеОНачисленииДоходов.Контрагент.ЮридическоеФизическоеЛицо КАК ЮрфизЛицо,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.Контрагент.ИНН, """") КАК ИННКонтрагента,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.Контрагент.КПП, """") КАК КППКонтрагента,
	|	ИзвещениеОНачисленииДоходов.СтатусСоставителя КАК СтатусСоставителя,
	|	ИзвещениеОНачисленииДоходов.ВидДокументаФизЛиц КАК ВидДокументаФизЛиц,
	|	ИзвещениеОНачисленииДоходов.ДоговорКонтрагента.УИН КАК УникальныйИдентификаторНачисления,
	|	ИзвещениеОНачисленииДоходов.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ИзвещениеОНачисленииДоходов.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ИзвещениеОНачисленииДоходов.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ИзвещениеОНачисленииДоходов.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.КПС.Код, """") КАК КПС,
	|	ИзвещениеОНачисленииДоходов.КФО КАК КФО,
	|	ЕСТЬNULL(ИзвещениеОНачисленииДоходов.КОСГУ.Код, """") КАК КОСГУ,
	|	ИзвещениеОНачисленииДоходов.КодОКТМО КАК КодОКТМО,
	|	ИзвещениеОНачисленииДоходов.ДатаПризнанияДоходов КАК ДатаПризнанияДоходов,
	|	ИзвещениеОНачисленииДоходов.ПредельнаяДатаИсполнения КАК ПредельнаяДатаИсполнения,
	|	ИзвещениеОНачисленииДоходов.Валюта.Код КАК КодОКВ,
	|	ИзвещениеОНачисленииДоходов.СуммаВВалюте КАК СуммаВВалютеЧислом,
	|	ИзвещениеОНачисленииДоходов.СуммаДокумента КАК СуммаЧислом,
	|	ИзвещениеОНачисленииДоходов.Номенклатура.НаименованиеПолное КАК НаименованиеПлатежа,
	|	ИзвещениеОНачисленииДоходов.ДатаОтсылки КАК ДатаОтсылки,
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходов.ПризнакПредвНачисления
	|			ТОГДА ""Предварительное начисление""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПризнакПредвНачисления,
	|	ИзвещениеОНачисленииДоходов.ДатаАктуальности КАК ДатаАктуальности,
	|	ИзвещениеОНачисленииДоходов.ПериодПовторногоПредставления КАК ПериодПовторногоПредставления,
	|	ИзвещениеОНачисленииДоходов.СуммаСкидки КАК СуммаСкидки,
	|	ИзвещениеОНачисленииДоходов.ПроцентСкидки КАК ПроцентСкидки,
	|	ИзвещениеОНачисленииДоходов.ПонижающийКоэффициент КАК ПонижающийКоэффициент,
	|	ИзвещениеОНачисленииДоходов.СрокДействияСкидки КАК СрокДействияСкидки,
	|	ИзвещениеОНачисленииДоходов.ПоказательОснования КАК ПоказательОснования,
	|	ИзвещениеОНачисленииДоходов.ПоказательПериода КАК ПоказательПериода,
	|	ИзвещениеОНачисленииДоходов.ПоказательНомера КАК ПоказательНомера,
	|	ИзвещениеОНачисленииДоходов.ПоказательДаты КАК ПоказательДаты,
	|	ИзвещениеОНачисленииДоходов.ОсобыеОтметки КАК ОсобыеОтметки,
	|	ИзвещениеОНачисленииДоходов.ПризнаниеПоГрафику КАК ПризнаниеПоГрафику
	|ИЗ
	|	Документ.ИзвещениеОНачисленииДоходов КАК ИзвещениеОНачисленииДоходов
	|ГДЕ
	|	ИзвещениеОНачисленииДоходов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеОНачисленииДоходовГрафикПлатежей.Ссылка КАК Ссылка,
	|	ИзвещениеОНачисленииДоходовГрафикПлатежей.СрокПлатежа КАК СрокПлатежа,
	|	ИзвещениеОНачисленииДоходовГрафикПлатежей.СуммаВВалюте КАК СуммаВВалюте,
	|	ИзвещениеОНачисленииДоходовГрафикПлатежей.СуммаВРублях КАК СуммаВРублях,
	|	ВЫБОР
	|		КОГДА ИзвещениеОНачисленииДоходовГрафикПлатежей.Ссылка.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.Пустаяссылка)
	|			ТОГДА ""643""
	|		ИНАЧЕ ИзвещениеОНачисленииДоходовГрафикПлатежей.Ссылка.Валюта.Код
	|	КОНЕЦ КАК КодВалюты
	|ИЗ
	|	Документ.ИзвещениеОНачисленииДоходов.ГрафикПлатежей КАК ИзвещениеОНачисленииДоходовГрафикПлатежей
	|ГДЕ
	|	ИзвещениеОНачисленииДоходовГрафикПлатежей.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	СрокПлатежа";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[0].Выбрать();
	
	ГрафикПлатежей = Результат[1].Выгрузить();
			
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ИзвещениеОНачисленииДоходов_" + ИмяМакета;
    	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИзвещениеОНачисленииДоходов." + ИмяМакета);
		
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
        ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;  
		
		ОбщиеСведенияОрг =  ОбщиеСведения.Получить(Выборка.Ссылка);  
		Если ОбщиеСведенияОрг = Неопределено Тогда
			ОбщиеСведенияОрг = Новый Структура; 
		КонецЕсли;
		
		СтруктураДанных = Новый Структура;
		
		Для Каждого Колонка ИЗ Результат[0].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
				
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.ДатаДок);
        СтруктураДанных.Вставить("ЧислоДаты", СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", СтруктураДаты.Год);  
		
		Если СтруктураДанных.ПризнаниеПоГрафику Тогда
			СтруктураДанных.Вставить("ДатаПризнанияДоходов", "по графику");
		Иначе
			СтруктураДанных.Вставить("ДатаПризнанияДоходов", Формат(СтруктураДанных.ДатаПризнанияДоходов, "ДФ=dd.MM.yyyy; ДП=31.12.2999"));
		КонецЕсли;	
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("НомерДок", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.Номер));
		
		ВыводитьСуммуВКруглыхСкобках = УчетДоходовРасходов.ВыводитьСуммуВКруглыхСкобках(СтруктураДанных.СтатусОперации);
		
		Если СтруктураДанных.СуммаВВалютеЧислом < 0 Тогда
			Если ВыводитьСуммуВКруглыхСкобках Тогда
				СтруктураДанных.Вставить("СуммаВВалюте", Формат(СтруктураДанных.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=0"));
			Иначе
				СтруктураДанных.Вставить("СуммаВВалюте", Формат(СтруктураДанных.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1"));
			КонецЕсли;
		Иначе
			СтруктураДанных.Вставить("СуммаВВалюте", Формат(СтруктураДанных.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1"));
		КонецЕсли;
		
		Если СтруктураДанных.СуммаЧислом < 0 Тогда
			Если ВыводитьСуммуВКруглыхСкобках Тогда
				СтруктураДанных.Вставить("СуммаДокумента", Формат(СтруктураДанных.СуммаЧислом, "ЧДЦ=2; ЧО=0"));
			Иначе
				СтруктураДанных.Вставить("СуммаДокумента", Формат(СтруктураДанных.СуммаЧислом, "ЧДЦ=2; ЧО=1"));
			КонецЕсли;
		Иначе
			СтруктураДанных.Вставить("СуммаДокумента", Формат(СтруктураДанных.СуммаЧислом, "ЧДЦ=2; ЧО=1"));
		КонецЕсли;

		СтруктураДанных.Вставить("КБК", ?(ЗначениеЗаполнено(ОбщиеСведенияОрг.ГлаваБК), ОбщиеСведенияОрг.ГлаваБК, "000") + СтруктураДанных.КПС);

		Если НЕ ЗначениеЗаполнено(СтруктураДанных.КодОКВ) Тогда
			СтруктураДанных.КодОКВ = "643";
		КонецЕсли;
		
		Если СтруктураДанных.ЭтоФизЛицо И НЕ СтруктураДанных.ЭтоИП Тогда
			
			ЗапросДок = Новый Запрос;			
			ЗапросДок.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
			|	ДокументыФизическихЛицСрезПоследних.Номер КАК Номер,
			|	ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК КАК КодФК
			|ИЗ
			|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Период, ) КАК ДокументыФизическихЛицСрезПоследних
			|ГДЕ
			|	ДокументыФизическихЛицСрезПоследних.Физлицо = &Физлицо";
			
			ЗапросДок.УстановитьПараметр("Физлицо", СтруктураДанных.ЮрфизЛицо);
			ЗапросДок.УстановитьПараметр("Период", СтруктураДанных.ДатаДок);
			
			Если ЗначениеЗаполнено(СтруктураДанных.ВидДокументаФизЛиц) Тогда 
				ЗапросДок.Текст = ЗапросДок.Текст + "
				|	И ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК = &КодФК";
				ЗапросДок.УстановитьПараметр("КодФК", СтруктураДанных.ВидДокументаФизЛиц); 
			Иначе
				ЗапросДок.Текст = ЗапросДок.Текст + "
				|	И ДокументыФизическихЛицСрезПоследних.ЯвляетсяДокументомУдостоверяющимЛичность";
			КонецЕсли;
			
			ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
			Если ВыборкаДок.Следующий() Тогда
				СерияНомерДокументаФизЛиц = "";
				Если ЗначениеЗаполнено(ВыборкаДок.Серия) Тогда
					СерияНомерДокументаФизЛиц = ВыборкаДок.Серия + " ";
				КонецЕсли;
				СерияНомерДокументаФизЛиц = СерияНомерДокументаФизЛиц + ВыборкаДок.Номер;
				СтруктураДанных.Вставить("СерияНомерДокументаФизЛиц", СерияНомерДокументаФизЛиц);
				СтруктураДанных.Вставить("СерияДокументаФизЛиц", ВыборкаДок.Серия);
				СтруктураДанных.Вставить("НомерДокументаФизЛиц", ВыборкаДок.Номер);
				СтруктураДанных.Вставить("ВидДокументаФизЛиц", ВыборкаДок.КодФК);
			КонецЕсли;	
			
		Иначе
			СтруктураДанных.ВидДокументаФизЛиц = "";
		КонецЕсли;	
		
		РеквизитыПлательщика = Новый Структура("ИНН, КПП, НаименованиеПолучателя, РасчетныйСчет, Банк, БИК, КорСчет", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
		
		Если ЗначениеЗаполнено(СтруктураДанных.ПолучательПлатежа) Тогда
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СтруктураДанных.СчетПолучателя, СтруктураДанных.СчетПолучателя, РеквизитыПлательщика, ИСТИНА);//Истина);
			РеквизитыПлательщика.Вставить("КассовыйОрган","");
			РеквизитыПлательщика.Вставить("ЛицевойСчетНомер", СОКРЛП(СтруктураДанных.СчетПолучателяКод));
			ДанныеОК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.СчетПолучателя,"КассовыйОрган.Наименование,КассовыйОрган.НаименованиеПолное");	
			РеквизитыПлательщика.Вставить("КассовыйОрган", ?(НЕ ЗначениеЗаполнено(ДанныеОК.КассовыйОрганНаименование), ДанныеОК.КассовыйОрганНаименованиеПолное, ДанныеОК.КассовыйОрганНаименование));
			РеквизитыПлательщика.Вставить("ОГРН", СтруктураДанных.ПолучательОГРН); 
		Иначе	
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СтруктураДанных.ЛицевойСчет, СтруктураДанных.РеквизитыЛицевогоСчета, РеквизитыПлательщика, ЛОЖЬ);//Истина);
			РеквизитыПлательщика.Вставить("КассовыйОрган","");
			РеквизитыПлательщика.Вставить("ЛицевойСчетНомер", СОКРЛП(СтруктураДанных.ЛицевойСчетКод));
			ДанныеОК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.РеквизитыЛицевогоСчета,"КассовыйОрган.Наименование,КассовыйОрган.НаименованиеПолное");	
			РеквизитыПлательщика.Вставить("КассовыйОрган", ?(НЕ ЗначениеЗаполнено(ДанныеОК.КассовыйОрганНаименование), ДанныеОК.КассовыйОрганНаименованиеПолное, ДанныеОК.КассовыйОрганНаименование));
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(СтруктураДанных, РеквизитыПлательщика, ИСТИНА);
		
		ОбластьМакетаШапка         		= Макет.ПолучитьОбласть("Шапка");
		ОбластьМакетаПлательщик         = Макет.ПолучитьОбласть("Плательщик");
		ОбластьМакетаПолучатель   		= Макет.ПолучитьОбласть("Получатель");
		ОбластьМакетаСведенияДоход   	= Макет.ПолучитьОбласть("СведенияДоход");
		ОбластьМакетаДопСведенияДоход	= Макет.ПолучитьОбласть("ДопСведенияДоход");
		ОбластьМакетаПодписи 			= Макет.ПолучитьОбласть("Подписи");

		ОбластьМакетаШапка.Параметры.Заполнить(СтруктураДанных); 
		ОбластьМакетаШапка.Параметры.Заполнить(ОбщиеСведенияОрг); 

		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
				
		ОбластьМакетаПлательщик.Параметры.Заполнить(СтруктураДанных);	
		ТабличныйДокумент.Вывести(ОбластьМакетаПлательщик);
		
		ОбластьМакетаПолучатель.Параметры.Заполнить(СтруктураДанных);	
		ТабличныйДокумент.Вывести(ОбластьМакетаПолучатель);
		
		ОбластьМакетаСведенияДоход.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьМакетаСведенияДоход);
		
		ОбластьМакетаДопСведенияДоход.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьМакетаДопСведенияДоход);
		
		Если СтруктураДанных.ПризнаниеПоГрафику Тогда
			ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПоГрафикуШапка"));
			ОбластьПоГрафикуСтрока = Макет.ПолучитьОбласть("ПоГрафикуСтрока");
			ГрафикПлатежейПоДокументу = ГрафикПлатежей.Скопировать(Новый Структура("Ссылка", СтруктураДанных.Ссылка));
			
			Для Каждого СтрТаб Из ГрафикПлатежейПоДокументу Цикл
				ОбластьПоГрафикуСтрока.Параметры.Заполнить(СтрТаб);	
			    ТабличныйДокумент.Вывести(ОбластьПоГрафикуСтрока);
			КонецЦикла;
			
			ОбластьИтог = Макет.ПолучитьОбласть("ПоГрафикуИтог");
			ОбластьИтог.Параметры.Заполнить(Новый Структура("КодВалюты,СуммаВВалюте,СуммаВРублях",
			СтруктураДанных.КодОКВ,
			ГрафикПлатежейПоДокументу.Итог("СуммаВВалюте"), 
			ГрафикПлатежейПоДокументу.Итог("СуммаВРублях")));  

			ТабличныйДокумент.Вывести(ОбластьИтог);
			
		КонецЕсли;	
		
		ОбластьМакетаПодписи = Макет.ПолучитьОбласть("Подписи");
		ОбластьМакетаПодписи.Параметры.Заполнить(ОбщиеСведенияОрг); 

		ТабличныйДокумент.Вывести(ОбластьМакетаПодписи);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,ИФО,Дата,Контрагент,ДоговорКонтрагента,СчетДоходов,КОСГУ,КПС,
		|СтатусОперации,ДатаПризнанияДоходов,ПредельнаяДатаИсполнения,ПризнаниеПоГрафику,АвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(ЗначенияРеквизитов.СтатусОперации);
	Если СтрНайти(ПризнакиСтатусаОперации.СтатусОперацииСчетРасчетов, "207.00") > 0 Тогда // 207.00
		СчетРасчетов = УчетРасчетов.СчетРасчетовПредоставленногоЗайма(ЗначенияРеквизитов.ДоговорКонтрагента, ЗначенияРеквизитов.Дата);
		ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.Проценты;
	Иначе // 205.00, 209.00
		СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(ЗначенияРеквизитов.КОСГУ, ПризнакиСтатусаОперации.СтатусОперацииСчетРасчетов,,,,, ЗначенияРеквизитов.КПС);
		ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Контрагент", ЗначенияРеквизитов.Контрагент);
	Запрос.УстановитьПараметр("Договор", ЗначенияРеквизитов.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("ИФО", ЗначенияРеквизитов.ИФО);
	Запрос.УстановитьПараметр("ПериодНач", ЗначенияРеквизитов.ДатаПризнанияДоходов);
	Запрос.УстановитьПараметр("ПериодОпл", ЗначенияРеквизитов.ПредельнаяДатаИсполнения);
	Запрос.УстановитьПараметр("СчетРасчетов", СчетРасчетов);
	Запрос.УстановитьПараметр("ВидРасчетов", ВидРасчетов);
	Запрос.УстановитьПараметр("ВалютаРегУчета", Константы.ВалютаРегламентированногоУчета.Получить()); 
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("СпособПризнанияДоходов", 
		?(ЗначенияРеквизитов.ПризнаниеПоГрафику, 
		ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"),
		ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.НаДатуПризнания")));
	
	Запрос.УстановитьПараметр("ЭтоНачислениеДоходовБудущихПериодов",  ПризнакиСтатусаОперации.ЭтоНачислениеДоходовБудущихПериодов);
	Запрос.УстановитьПараметр("ЭтоУточнениеДатыПризнанияДоходов",     ПризнакиСтатусаОперации.ЭтоУточнениеДатыПризнанияДоходов);
	Запрос.УстановитьПараметр("ЭтоУточнениеПредельнойДатыИсполнения", ПризнакиСтатусаОперации.ЭтоУточнениеПредельнойДатыИсполнения);
	Запрос.УстановитьПараметр("ЭтоУточнениеДатИсполнения",            ПризнакиСтатусаОперации.ЭтоУточнениеДатИсполнения);
	
	НомераТаблиц = Новый Структура;   
	НомераТаблиц.Вставить("СтатусыОперацийДоходов", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеОНачисленииДоходов.Ссылка КАК Регистратор,
	|	ИзвещениеОНачисленииДоходов.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = &ПустаяДата
	|			ТОГДА ИзвещениеОНачисленииДоходов.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ИзвещениеОНачисленииДоходов.Контрагент КАК Контрагент,
	|	ИзвещениеОНачисленииДоходов.ДоговорКонтрагента КАК Договор,
	|	ИзвещениеОНачисленииДоходов.КПС КАК КПС,
	|	ИзвещениеОНачисленииДоходов.КОСГУ КАК КОСГУ,
	|	ИзвещениеОНачисленииДоходов.СтатусОперации КАК СтатусОперации
	|ИЗ
	|	Документ.ИзвещениеОНачисленииДоходов КАК ИзвещениеОНачисленииДоходов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ИзвещениеОНачисленииДоходов.Ссылка)
	|ГДЕ
	|	ИзвещениеОНачисленииДоходов.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	НачислениеДоходовБудущихПериодов.Ссылка КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = &ПустаяДата
	|			ТОГДА НачислениеДоходовБудущихПериодов.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	НачислениеДоходовБудущихПериодов.ДоговорКонтрагента КАК Договор,
	|	НачислениеДоходовБудущихПериодов.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ПрочиеДоходыБудущихПериодов) КАК ВидОперации,
	|	&СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаНачалаСписания,
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаОкончанияСписания,
	|	НачислениеДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка) КАК ВидДеятельностиНУ,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетДоходовНУ,
	|	ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка) КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.ИзвещениеОНачисленииДоходов КАК НачислениеДоходовБудущихПериодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = НачислениеДоходовБудущихПериодов.Ссылка)
	|ГДЕ
	|	НачислениеДоходовБудущихПериодов.Ссылка = &Ссылка
	|	И &ЭтоНачислениеДоходовБудущихПериодов";
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров И ЗначенияРеквизитов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
		
		Если ПризнакиСтатусаОперации.ЭтоНачислениеДоходовБудущихПериодов Тогда // 01.21, 01.22, 02.21 и пр.
			
			// План-график реализации.
			Если ЗначенияРеквизитов.ПризнаниеПоГрафику Тогда 
				
				НомераТаблиц.Вставить("ИзвещениеОНачисленииДоходовГрафикИсполнения", НомераТаблиц.Количество());
				Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
				"ВЫБРАТЬ
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка КАК Ссылка,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Организация КАК Организация,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.ИФО КАК ИФО,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Контрагент КАК Контрагент,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.ДоговорКонтрагента КАК Договор,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.СрокПлатежа КАК ИсполнитьДо,
				|	&СчетРасчетов КАК СчетРасчетов,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.КФО КАК КФО,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.КПС КАК КПС,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.КОСГУ КАК КЭК,
				|	ВЫБОР
				|		КОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
				|			ТОГДА &ВалютаРегУчета
				|		ИНАЧЕ ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Валюта
				|	КОНЕЦ КАК Валюта,
				|	ВЫБОР
				|		КОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
				|				ИЛИ ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка.Валюта = &ВалютаРегУчета
				|			ТОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.СуммаВРублях
				|		ИНАЧЕ ИзвещениеОНачисленииДоходовГрафикИсполнения.СуммаВВалюте
				|	КОНЕЦ КАК СуммаВВалюте
				|ПОМЕСТИТЬ ИзвещениеОНачисленииДоходовГрафикИсполнения
				|ИЗ
				|	Документ.ИзвещениеОНачисленииДоходов.ГрафикПлатежей КАК ИзвещениеОНачисленииДоходовГрафикИсполнения
				|ГДЕ
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка = &Ссылка";
				
			Иначе
				
				НомераТаблиц.Вставить("ИзвещениеОНачисленииДоходовГрафикИсполнения", НомераТаблиц.Количество());
				Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
				"ВЫБРАТЬ
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Ссылка КАК Ссылка,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Организация КАК Организация,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.ИФО КАК ИФО,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.Контрагент КАК Контрагент,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.ДоговорКонтрагента КАК Договор,
				|	ВЫБОР
				|		КОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.ДатаПризнанияДоходов = &ПустаяДата
				|			ТОГДА &ПредельнаяДата
				|		ИНАЧЕ ИзвещениеОНачисленииДоходовГрафикИсполнения.ДатаПризнанияДоходов
				|	КОНЕЦ КАК ИсполнитьДо,
				|	&СчетРасчетов КАК СчетРасчетов,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.КФО КАК КФО,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.КПС КАК КПС,
				|	ИзвещениеОНачисленииДоходовГрафикИсполнения.КОСГУ КАК КЭК,
				|	ВЫБОР
				|		КОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
				|			ТОГДА &ВалютаРегУчета
				|		ИНАЧЕ ИзвещениеОНачисленииДоходовГрафикИсполнения.Валюта
				|	КОНЕЦ КАК Валюта,
				|	ВЫБОР
				|		КОГДА ИзвещениеОНачисленииДоходовГрафикИсполнения.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
				|				ИЛИ ИзвещениеОНачисленииДоходовГрафикИсполнения.Валюта = &ВалютаРегУчета
