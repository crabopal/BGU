#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ПризнаниеПоГрафику Тогда // Проверим соответствие сумм документа итоговым суммам по графику платежей.
		
		Если СуммаДокумента <> ГрафикПлатежей.Итог("СуммаВРублях") Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Итоговая сумма в рублях по графику платежей (%1 %3) не соответствует итоговой сумме документа (%2 %3).'"),
					ГрафикПлатежей.Итог("СуммаВРублях"),
					СуммаДокумента,
					ВалютаРегламентированногоУчета);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СуммаДокумента", "Объект", Отказ);
		КонецЕсли;
		
		Если Валюта <> ВалютаРегламентированногоУчета И СуммаВВалюте <> ГрафикПлатежей.Итог("СуммаВВалюте") Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Итоговая сумма в валюте по графику платежей (%1 %3) не соответствует итоговой сумме документа (%2 %3).'"),
					ГрафикПлатежей.Итог("СуммаВВалюте"),
					СуммаВВалюте,
					Валюта);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СуммаВВалюте", "Объект", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации);
	Если ПризнакиСтатусаОперации.ЭтоНачислениеДоходовБудущихПериодов
		ИЛИ ПризнакиСтатусаОперации.ЭтоУточнениеДатыПризнанияДоходов
		ИЛИ ПризнакиСтатусаОперации.ЭтоУточнениеПредельнойДатыИсполнения
		ИЛИ ПризнакиСтатусаОперации.ЭтоУточнениеДатИсполнения
		ИЛИ ПризнакиСтатусаОперации.ЭтоНачислениеДоходовТекущегоПериода
		ИЛИ ПризнакиСтатусаОперации.ЭтоПризнаниеДоходовТекущегоПериода Тогда
		
		ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
		Если ИспользоватьКонтрольИсполненияДоговоров И АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
			Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента, "ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
				Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
					Если НЕ (РеквизитыДоговора.ВестиГрафикПлатежей) Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в графиках исполнения договоров, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""График платежей"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								ДоговорКонтрагента);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДоговорКонтрагента", "Объект", Отказ);
					КонецЕсли;
				Иначе // СПокупателем
					Если НЕ (РеквизитыДоговора.ВестиГрафикПлатежей И РеквизитыДоговора.ВестиПланГрафикИсполнения) Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в графиках исполнения договоров, в том числе, учета задолженности в разрезе дат исполнения, следует установить признаки ""График платежей"" и ""План-график реализации"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								ДоговорКонтрагента);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДоговорКонтрагента", "Объект", Отказ);
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru = 'Для автоматического отражения в графиках исполнения договоров, в том числе, учета задолженности в разрезе дат исполнения, необходимо заполнить договор (основание расчетов).'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДоговорКонтрагента", "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолучательПлатежа) Тогда
		Если НЕ ЗначениеЗаполнено(СчетПолучателя) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан лицевой счет получателя платежа.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СчетПолучателя", "Объект", Отказ);  
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан лицевой счет получателя платежа.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ЛицевойСчет", "Объект", Отказ);  
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Валюта = ВалютаРегламентированногоУчета;
	КонецЕсли;
	
	НачислениеДоходовВалюте = (Валюта <> ВалютаРегламентированногоУчета);
	Если Не НачислениеДоходовВалюте Тогда // Обнулим валютные суммы.
		СуммаВВалюте = 0;
		Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
			СтрокаГрафика.СуммаВВалюте = 0;
		КонецЦикла;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПолучательПлатежа) Тогда
		ЛицевойСчет = ПредопределенноеЗначение("Справочник.ЛицевыеСчета.ПустаяСсылка");
		РеквизитыЛицевогоСчета = ПредопределенноеЗначение("Справочник.РеквизитыЛицевыхСчетов.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли