				Объект.СуммаДокумента = ДоходКПризнанию.Сумма;
			Иначе
				Объект.СуммаВВалюте = ДоходКПризнанию.Сумма;
				КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
				Объект.СуммаДокумента = Объект.СуммаВВалюте * КурсВалюты.Курс / ?(КурсВалюты.Кратность=0, 1, КурсВалюты.Кратность);
			КонецЕсли;
			
			Если ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
				
