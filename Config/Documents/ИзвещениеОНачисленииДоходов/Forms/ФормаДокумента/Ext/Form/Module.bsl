&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(Объект.СтатусОперации);
	Для Каждого Признак Из ПризнакиСтатусаОперации Цикл // Сохраним в локальных параметрах.
		ЭтотОбъект.КэшПараметров.Локальные.Вставить(Признак.Ключ, Признак.Значение);
	КонецЦикла;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СтатусОперацииДоИзменения", Объект.СтатусОперации);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредупреждениеКонтрольИсполненияДоговоров", "Заголовок",
		КонтрольИсполненияДоговоров.ТекстПредупрежденияУчетЗадолженностиВРазрезеДатИсполнения());
	
	ГрафикПлатежейЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьВидимостьРеквизитовТекущихДоходов(); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Реквизиты порядка оплаты доступны для редактирования только в строках, введенных вручную.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейСрокПлатежа");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ГрафикПлатежей.СуммаВРубляхДоИзменения", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДатаПризнанияДоходов", "Доступность", НЕ Объект.ПризнаниеПоГрафику);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтраницаГрафикПлатежей", "Видимость", Объект.ПризнаниеПоГрафику); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПолучательПлатежа", "Видимость", НЕ Форма.ПолучательПлатежаОрганизация); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЛицевойСчет", "Видимость", Форма.ПолучательПлатежаОрганизация);
	
	НачислениеДоходовВалюте = (Объект.Валюта <> Форма.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭтоНачислениеДоходовБудущихПериодов = Форма.КэшПараметров.Локальные.ЭтоНачислениеДоходовБудущихПериодов;
	ЭтоУточнениеДатыПризнанияДоходов = Форма.КэшПараметров.Локальные.ЭтоУточнениеДатыПризнанияДоходов;
	ЭтоУточнениеПредельнойДатыИсполнения = Форма.КэшПараметров.Локальные.ЭтоУточнениеПредельнойДатыИсполнения;
	ЭтоУточнениеДатИсполнения = Форма.КэшПараметров.Локальные.ЭтоУточнениеДатИсполнения;
	ЭтоНачислениеДоходовТекущегоПериода = Форма.КэшПараметров.Локальные.ЭтоНачислениеДоходовТекущегоПериода;
	ЭтоПризнаниеДоходовТекущегоПериода = Форма.КэшПараметров.Локальные.ЭтоПризнаниеДоходовТекущегоПериода;
	ЭтоУточнениеДоходов = Форма.КэшПараметров.Локальные.ЭтоУточнениеДоходов;
	
	ВалютныеСуммы = Новый Массив;
	ВалютныеСуммы.Добавить("СуммаВВалюте");
	ВалютныеСуммы.Добавить("ГрафикПлатежейСуммаВВалюте");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ВалютныеСуммы, "Видимость", НачислениеДоходовВалюте);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АвтоматическиОтразитьВГрафикахИсполненияДоговоров",
		"Видимость", ЭтоНачислениеДоходовБудущихПериодов
			ИЛИ ЭтоУточнениеДатыПризнанияДоходов ИЛИ ЭтоУточнениеПредельнойДатыИсполнения ИЛИ ЭтоУточнениеДатИсполнения
			ИЛИ ЭтоНачислениеДоходовТекущегоПериода ИЛИ ЭтоПризнаниеДоходовТекущегоПериода);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДатаПризнанияДоходовДоИзменения",
		"Видимость", (ЭтоУточнениеДатыПризнанияДоходов ИЛИ ЭтоУточнениеДатИсполнения) И НЕ Объект.ПризнаниеПоГрафику);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПредельнаяДатаИсполненияДоИзменения",
		"Видимость", (ЭтоУточнениеПредельнойДатыИсполнения ИЛИ ЭтоУточнениеДатИсполнения) И НЕ Объект.ПризнаниеПоГрафику);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГрафикПлатежейСрокПлатежаДоИзменения",
		"Видимость", (ЭтоУточнениеДатыПризнанияДоходов ИЛИ ЭтоУточнениеПредельнойДатыИсполнения ИЛИ ЭтоУточнениеДатИсполнения) И Объект.ПризнаниеПоГрафику);
	
	ПредупреждениеКонтрольИсполненияДоговоров = Новый Массив;
	ПредупреждениеКонтрольИсполненияДоговоров.Добавить("ПредупреждениеКонтрольИсполненияДоговоров");
	ПредупреждениеКонтрольИсполненияДоговоров.Добавить("ДекорацияПредупреждениеКонтрольИсполненияДоговоров");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ПредупреждениеКонтрольИсполненияДоговоров, "Видимость",
		НЕ Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "Подсказка", "");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "ОтображениеПодсказки", ОтображениеПодсказки.Нет);
	Если ЭтоНачислениеДоходовБудущихПериодов Тогда
		
		Если НЕ Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "Подсказка",
				НСтр("ru = 'Для автоматического признания доходов текущего периода по договору необходимо включить опцию ""Вести и контролировать исполнение графиков по договорам с контрагентами"" в настройках параметров учета (закладка ""Ведение учета"" в разделе ""Администрирование - Настройка параметров учета"").'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "ОтображениеПодсказки", ОтображениеПодсказки.ОтображатьСнизу);
		ИначеЕсли Не Форма.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "Подсказка",
				НСтр("ru = 'Для автоматического признания доходов текущего периода следует установить признак ""Вести графики исполнения - План-график реализации"" в карточке договора.'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаОтражениеВДоходахТекущегоПериода", "ОтображениеПодсказки", ОтображениеПодсказки.ОтображатьСнизу);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПричинаОшибки", "Видимость", Форма.КэшПараметров.Локальные.ЭтоИсправлениеОшибокПрошлыхЛет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КонструкторГрафиковИсполненияДоговоров", "Доступность",
		Не ЭтоУточнениеДатыПризнанияДоходов И Не ЭтоУточнениеПредельнойДатыИсполнения И Не ЭтоУточнениеДатИсполнения);
	
	// Для операций уточнения доходов в форме отображаются колонки "До изменения - Изменение - После изменения".
	СтрокиДоИзменения = Объект.ГрафикПлатежей.НайтиСтроки(Новый Структура("СуммаВРубляхДоИзменения", 0)); // В "старых" документах колонка СуммаВРубляхДоИзменения не заполнена.
	ПоказыватьКолонкиДоПослеИзменения = ЭтоУточнениеДоходов
		И (Объект.ГрафикПлатежей.Количество() <> СтрокиДоИзменения.Количество()); // В "старых" документах показываем без колонок "До изменения - Изменение - После изменения"..
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГрафикПлатежейГруппаСумма", "Видимость", Не ПоказыватьКолонкиДоПослеИзменения);
	
	СуммыДоПослеИзменения = Новый Массив;
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВРубляхДоИзменения");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВРубляхИзменение");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВРубляхПослеИзменения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, СуммыДоПослеИзменения, "Видимость", ПоказыватьКолонкиДоПослеИзменения);
	
	СуммыДоПослеИзменения = Новый Массив;
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейЗаголовокВРублях");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейЗаголовокВВалюте");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВВалютеДоИзменения");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВВалютеИзменение");
	СуммыДоПослеИзменения.Добавить("ГрафикПлатежейСуммаВВалютеПослеИзменения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, СуммыДоПослеИзменения, "Видимость", ПоказыватьКолонкиДоПослеИзменения И НачислениеДоходовВалюте);
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьРеквизитовТекущихДоходов()
	
	Если ЗначениеЗаполнено(Объект.СчетДоходов) И Объект.СчетДоходов.ВидыСубконто.Количество() > 0 Тогда
		Элементы.ГруппаОтражениеВДоходахТекущегоПериода.Видимость = Истина;
		УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект);
	Иначе
		Элементы.ГруппаОтражениеВДоходахТекущегоПериода.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект)
	Перем МассивПолей;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
	"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
	"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
	"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоответствиеЗначенийРеквизитов()
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ПризнакиСтатусаОперации = КлассифицироватьСтатусОперацииНачисленияДоходов(Объект.СтатусОперации);
	ВСтатусеОперацииЕстьНастройкиПроводок = ЗначениеЗаполнено(ПризнакиСтатусаОперации.СтатусОперацииСчетДт);
	
	ТекстПредупреждения = "";
	
	Если НЕ ВСтатусеОперацииЕстьНастройкиПроводок Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Для статуса %1 отсутствует настройка для отражения в учете. Проводки сформированы не будут.'"),
				Объект.СтатусОперации);
	КонецЕсли;
	
	Если (ПризнакиСтатусаОперации.ЭтоНачислениеДоходов ИЛИ ПризнакиСтатусаОперации.ЭтоДеаннулированиеДоходов)
		И (Объект.СуммаДокумента < 0 Или Объект.СуммаВВалюте < 0) Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте сумму начисления. Для статуса %1 сумма начисления должна быть больше нуля.'"),
				Объект.СтатусОперации);
	КонецЕсли;
	
	Если (ПризнакиСтатусаОперации.ЭтоАннулированиеДоходов)
		И (Объект.СуммаДокумента > 0 Или Объект.СуммаВВалюте > 0) Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте сумму начисления. Для статуса %1 сумма начисления должна быть меньше нуля.'"),
				Объект.СтатусОперации);
	КонецЕсли;
	
	Если ПризнакиСтатусаОперации.ЭтоУточнениеДоходов
		И ЗначениеЗаполнено(Объект.ДатаПризнанияДоходов)
		И Объект.ДатаПризнанияДоходов < Объект.Дата Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте дату признания дохода. Для статуса %1 дата признания дохода не может быть ранее даты формирования извещения %2.'"),
				Объект.СтатусОперации,
				Объект.Дата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПредельнаяДатаИсполнения) 
		И (НЕ ЗначениеЗаполнено(Объект.ДатаПризнанияДоходов)
		ИЛИ Объект.ПредельнаяДатаИсполнения < Объект.ДатаПризнанияДоходов
		ИЛИ Объект.ПредельнаяДатаИсполнения < Объект.Дата) Тогда
		ТекстПредупреждения = ТекстПредупреждения + 
			НСтр("ru='Проверьте предельную дату исполнения. Дата исполнения не может быть ранее даты признания дохода и даты формирования извещения.'");
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПредупреждения,,, "Объект");
	Иначе
		ТекстПредупреждения = ПроверитьНаличиеУточняемыхДоходов(Объект.СтатусОперации,
			Объект.Контрагент,
			Объект.ДоговорКонтрагента,
			Объект.КОСГУ,
			Объект.КПС,
			Объект.КФО,
			Объект.Дата,
			Объект.Организация);
		Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПредупреждения,,,, "Объект"); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации)
	Возврат УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьНаличиеУточняемыхДоходов(СтатусОперации, Контрагент, ДоговорКонтрагента, КОСГУ, КПС, КФО, Дата, Организация)
	Возврат Документы.ВедомостьНачисленияДоходов.ПроверитьНаличиеУточняемыхДоходов(СтатусОперации, Контрагент, ДоговорКонтрагента, КОСГУ, КПС, КФО, Дата, Организация);
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц);
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура СтатусОперацииПриИзмененииНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(Объект.СтатусОперации);
	Для Каждого Признак Из ПризнакиСтатусаОперации Цикл // Сохраним в локальных параметрах.
		ЭтотОбъект.КэшПараметров.Локальные.Вставить(Признак.Ключ, Признак.Значение);
	КонецЦикла;
	
	Если ПризнакиСтатусаОперации.ЭтоНачислениеДоходовБудущихПериодов Тогда
		Объект.СчетДоходов = БухгалтерскийУчет.СчетПоКоду("401.10", Объект.Дата, Объект.Организация);
		Объект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров;
	Иначе
		Объект.СчетДоходов = "";
		Если ПризнакиСтатусаОперации.ЭтоУточнениеДатыПризнанияДоходов
			ИЛИ ПризнакиСтатусаОперации.ЭтоУточнениеПредельнойДатыИсполнения
			ИЛИ ПризнакиСтатусаОперации.ЭтоУточнениеДатИсполнения
			ИЛИ ПризнакиСтатусаОперации.ЭтоНачислениеДоходовТекущегоПериода
			ИЛИ ПризнакиСтатусаОперации.ЭтоПризнаниеДоходовТекущегоПериода Тогда
			Объект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров;
		Иначе
			Объект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров Тогда
		ЗаполнитьДокументПоГрафикамИсполнения();
		ГрафикПлатежейЗаполнитьДобавленныеКолонки();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьВидимостьРеквизитовТекущихДоходов(); 
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СтатусОперацииДоИзменения", Объект.СтатусОперации);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоГрафикамИсполнения()
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("СчетРасчетов", БухгалтерскийУчет.СписокСчетов(
		ЭтотОбъект.КэшПараметров.Локальные.СтатусОперацииСчетРасчетов, Объект.Дата,, Объект.Организация));
	
	Если СтрНайти(ЭтотОбъект.КэшПараметров.Локальные.СтатусОперацииСчетРасчетов, "207.00") > 0 Тогда
		Отбор.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.Проценты);
	Иначе
		Отбор.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг);
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", Объект.ИФО);
	КонецЕсли;
	Отбор.Вставить("Контрагент", Объект.Контрагент);
	Отбор.Вставить("Договор", Объект.ДоговорКонтрагента);
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ЭтоУточнениеДатыПризнанияДоходов
		И ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		
		ДоходыКПризнанию = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, Объект.Организация);
		Если ДоходыКПризнанию.Количество() = 1 Тогда
			
			// Частный случай - одна строка доходов к признанию по договору, все доходы признаются на заданную дату ИсполнитьДо.
			ДоходКПризнанию = ДоходыКПризнанию[0];
			ЗаполнитьЗначенияСвойств(Объект, ДоходКПризнанию, "КФО,КПС,Валюта");
			Объект.КОСГУ = ДоходКПризнанию.КЭК;
