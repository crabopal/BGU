&НаСервере
Процедура ДоговорКонтрагентаПриИзмененииНаСервере()
	
	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("ВидПервичногоДокумента", "ВидОбязательства");
	РеквизитыДоговора.Вставить("ДатаПервичногоДокумента", "ДатаДоговора");
	РеквизитыДоговора.Вставить("НомерПервичногоДокумента", "НомерДоговора");
	РеквизитыДоговора.Вставить("ВестиГрафикПлатежей", "ВестиГрафикПлатежей");
	РеквизитыДоговора.Вставить("ВестиПланГрафикИсполнения", "ВестиПланГрафикИсполнения");
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, РеквизитыДоговора); 
	
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыДоговора, "ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента");
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПлатежаОрганизацияПриИзменении(Элемент)
	
	Если ПолучательПлатежаОрганизация Тогда
		Объект.ПолучательПлатежа = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		Объект.СчетПолучателя = ПредопределенноеЗначение("Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка");
		Если НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			ПолучательПлатежаОрганизацияПриИзмененииНаСервере();
		КонецЕсли;
	Иначе
		Объект.ЛицевойСчет = ПредопределенноеЗначение("Справочник.ЛицевыеСчета.ПустаяСсылка");
		Объект.РеквизитыЛицевогоСчета = ПредопределенноеЗначение("Справочник.РеквизитыЛицевыхСчетов.ПустаяСсылка");
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры  
	
&НаКлиенте
Процедура ПолучательПлатежаОрганизацияПриИзмененииНаСервере()
	ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
КонецПроцедуры	

