&НаКлиенте
Процедура ГрафикПлатежейПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикПлатежей.ТекущиеДанные;
	
	Если Объект.ПризнаниеПоГрафику Тогда
		
		Объект.СуммаДокумента = Объект.ГрафикПлатежей.Итог("СуммаВРублях");
		Объект.СуммаВВалюте   = Объект.ГрафикПлатежей.Итог("СуммаВВалюте");
		
		Если ЭтотОбъект.КэшПараметров.Локальные.ЭтоУточнениеДоходов Тогда
			ГрафикПлатежейЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
			ИтогСуммаВРубляхПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВРубляхПослеИзменения");
			ИтогСуммаВВалютеПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВВалютеПослеИзменения");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПлатежейПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ГрафикПлатежей.ТекущиеДанные;
	Отказ = (ТекущиеДанные.СуммаВРубляхДоИзменения <> 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПлатежейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ГрафикПлатежей.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		
		Если Объект.ПризнаниеПоГрафику И ЭтотОбъект.КэшПараметров.Локальные.ЭтоУточнениеДоходов Тогда
			Если НЕ Копирование Тогда
				ГрафикПлатежейЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
			КонецЕсли;
			ИтогСуммаВРубляхПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВРубляхПослеИзменения");
			ИтогСуммаВВалютеПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВВалютеПослеИзменения");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГрафикПлатежейЗаполнитьДобавленныеКолонки()
	
	Если Не Объект.ПризнаниеПоГрафику Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.ГрафикПлатежей Цикл
		ГрафикПлатежейЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
	КонецЦикла;
	
	ИтогСуммаВРубляхПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВРубляхПослеИзменения");
	ИтогСуммаВВалютеПослеИзменения = Объект.ГрафикПлатежей.Итог("СуммаВВалютеПослеИзменения");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ГрафикПлатежейЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы.ЗаголовокВВалюте = НСтр("ru = 'В валюте:'");
	СтрокаТаблицы.ЗаголовокВРублях = НСтр("ru = 'В рублях:'");
	
	СтрокаТаблицы.СуммаВВалютеПослеИзменения = СтрокаТаблицы.СуммаВВалютеДоИзменения + СтрокаТаблицы.СуммаВВалюте;
	СтрокаТаблицы.СуммаВРубляхПослеИзменения = СтрокаТаблицы.СуммаВРубляхДоИзменения + СтрокаТаблицы.СуммаВРублях;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КонструкторГрафикаПлатежей(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Договор", Объект.ДоговорКонтрагента);
	ПараметрыФормы.Вставить("Валюта", Объект.Валюта);
	ПараметрыФормы.Вставить("СуммаВВалюте", Объект.СуммаВВалюте);
	ПараметрыФормы.Вставить("СуммаВРублях", Объект.СуммаДокумента);
	
	ОткрытьФорму("Документ.ИзвещениеОНачисленииДоходов.Форма.КонструкторГрафикаПлатежей",
		ПараметрыФормы, ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

