			КонецЕсли;
			
			Если ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
				
				// Дополним структуру отбора, определяем дату признания дохода по данным графика платежей (справочно).
				Отбор.Вставить("КФО", НеисполненныйПлатеж.КФО);
				Отбор.Вставить("КПС", НеисполненныйПлатеж.КПС);
				Отбор.Вставить("КЭК", НеисполненныйПлатеж.КЭК);
				Отбор.Вставить("Валюта", НеисполненныйПлатеж.Валюта);
				Отбор.Вставить("Сумма", НеисполненныйПлатеж.Сумма);
				ДоходыКПризнанию = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, Объект.Организация);
				Если ДоходыКПризнанию.Количество() > 0 Тогда
					ДоходКПризнанию = ДоходыКПризнанию[0];
					Объект.ДатаПризнанияДоходовДоИзменения = ДоходКПризнанию.ИсполнитьДо;
					Объект.ДатаПризнанияДоходов = Объект.ДатаПризнанияДоходовДоИзменения;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли НеисполненныеПлатежи.Количество() > 0 Тогда // По графику.
			
			// Частный случай - план-график реализации совпадает графиком платежей (суммы, даты ИсполнитьДо и ОплатитьДо) в точности.
			ДоходКПризнанию = НеисполненныеПлатежи[0];
			ЗаполнитьЗначенияСвойств(Объект, ДоходКПризнанию, "КФО,КПС,Валюта");
			Объект.КОСГУ = ДоходКПризнанию.КЭК;
			
			Объект.ПризнаниеПоГрафику = Истина;
			Объект.ГрафикПлатежей.Очистить();
			Для Каждого НеисполненныйПлатеж Из НеисполненныеПлатежи Цикл
				
				НоваяСтрока = Объект.ГрафикПлатежей.Добавить();
				НоваяСтрока.СрокПлатежаДоИзменения = НеисполненныйПлатеж.ОплатитьДо;
				НоваяСтрока.СрокПлатежа = НоваяСтрока.СрокПлатежаДоИзменения;
				
				Если НеисполненныйПлатеж.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
					НоваяСтрока.СуммаВРублях = НеисполненныйПлатеж.Сумма;
				Иначе
					НоваяСтрока.СуммаВВалюте = НеисполненныйПлатеж.Сумма;
					КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
					НоваяСтрока.СуммаВРублях = НоваяСтрока.СуммаВВалюте * КурсВалюты.Курс / ?(КурсВалюты.Кратность=0, 1, КурсВалюты.Кратность);
				КонецЕсли;
				
			КонецЦикла;
			
			Объект.СуммаДокумента = Объект.ГрафикПлатежей.Итог("СуммаВРублях");
			Объект.СуммаВВалюте   = Объект.ГрафикПлатежей.Итог("СуммаВВалюте");
			
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.ЭтоУточнениеДоходов
		И ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
		
		// Заполняем по графику платежей, поскольку для доходов текущего периода движения "план" и "факт" в план-график реализации выполняются одновременно.
		
		НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, Объект.Организация);
		Если НеисполненныеПлатежи.Количество() = 1 Тогда
			
			// Частный случай - один планируемый платеж по договору, вся задолженность оплачивается не позднее даты ОплатитьДо.
			НеисполненныйПлатеж = НеисполненныеПлатежи[0];
			ЗаполнитьЗначенияСвойств(Объект, НеисполненныйПлатеж, "КФО,КПС,Валюта");
