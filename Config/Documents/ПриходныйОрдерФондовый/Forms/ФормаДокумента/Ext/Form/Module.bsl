&НаКлиенте
Процедура РасшифровкаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
		
	Если НоваяСтрока Тогда
		СуммаБезСтроки = Объект.Расшифровка.Итог("Сумма") - Элемент.ТекущиеДанные.Сумма;
		Остаток = Объект.СуммаДокумента - СуммаБезСтроки;
		Элемент.ТекущиеДанные.Сумма = ?(Элемент.ТекущиеДанные.Сумма = 0, Остаток, Мин(Элемент.ТекущиеДанные.Сумма, Остаток));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Расшифровка.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПС, 
													Объект.Организация,
													Объект.ИФО,
													ТекущиеДанные.КФО,
													Объект.КорСчет,
													Объект.Дата);
КонецПроцедуры

