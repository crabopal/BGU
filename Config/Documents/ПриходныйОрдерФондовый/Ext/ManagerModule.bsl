#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПроведениеДокумента

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Приходный кассовый ордер (фондовый)");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоДенежнымДокументам(Запрос, НомераТаблиц);
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоДенежнымДокументам(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ДенежныеДокументы", НомераТаблиц.Количество());
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	             |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.Дата КАК Период,
	             |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.Организация,
	             |	ВЫБОР
	             |		КОГДА ПриходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение.ВедетсяКассоваяКнига
	             |			ТОГДА ПриходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение
	             |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	             |	КОНЕЦ КАК Подразделение,
	             |	ПриходныйОрдерФондовыйРасшифровка.КФО,
	             |	ПриходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
	             |	СУММА(ПриходныйОрдерФондовыйРасшифровка.Количество) КАК Количество,
	             |	СУММА(ПриходныйОрдерФондовыйРасшифровка.Сумма) КАК Сумма,
	             |	ПриходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента
	             |ИЗ
	             |	Документ.ПриходныйОрдерФондовый.Расшифровка КАК ПриходныйОрдерФондовыйРасшифровка
	             |ГДЕ
	             |	ПриходныйОрдерФондовыйРасшифровка.Ссылка = &Ссылка
	             |	И ПриходныйОрдерФондовыйРасшифровка.Ссылка.Оплачено
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.Организация,
	             |	ПриходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
	             |	ПриходныйОрдерФондовыйРасшифровка.КФО,
	             |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.Дата,
	             |	ПриходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента,
	             |	ВЫБОР
	             |		КОГДА ПриходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение.ВедетсяКассоваяКнига
	             |			ТОГДА ПриходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение
	             |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	             |	КОНЕЦ";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПриходныйОрдерФондовый КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПриходныйКассовыйОрдер";
	КомандаПечати.Идентификатор		= "КО1";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный кассовый ордер'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"КО1") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"КО1","ПКО",ПечатьКО1(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.ПриходныйОрдерФондовый -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 12
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
		
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка,
	|	ПКО.ДокументОснование,
	|	СоставДокумента.ДенежныйДокумент,
	|	ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка) КАК СерияБСО,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки),
	|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка),
	|	СоставДокумента.Количество,
	|	0 КАК НомерНачальный,
	|	0 КАК НомерКонечный
	|ИЗ
	|	Документ.ПриходныйОрдерФондовый КАК ПКО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерФондовый.Расшифровка КАК СоставДокумента
	|		ПО ПКО.Ссылка = СоставДокумента.Ссылка
	|ГДЕ
	|	ПКО.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ПКО.ПометкаУдаления
	|	И ПКО.Ссылка <> &ПриходныйОрдерФондовыйСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьДанныеКонтрагента(Контрагент, ПринятоОт) Экспорт
	
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ПолучитьОтКого", Контрагент);
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	Если ЗначениеЗаполнено(ДанныеКонтрагента.ПолучитьОтКого) Тогда
		ПринятоОт = ДанныеКонтрагента.ПолучитьОтКого;
	ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
		ПринятоОт = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
	Иначе
		ПринятоОт = ДанныеКонтрагента.НаименованиеПолное;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьКО1(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КО1";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КО1");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ПриходныйОрдерФондовый.Номер КАК Номер,
	             |	ПриходныйОрдерФондовый.Дата КАК ДатаДокумента,
	             |	ПриходныйОрдерФондовый.Организация КАК ПредставлениеОрганизации,
	             |	ПриходныйОрдерФондовый.Подразделение КАК ПредставлениеПодразделения,
	             |	ПриходныйОрдерФондовый.Подразделение.Код КАК КодПодразделения,
	             |	ПриходныйОрдерФондовый.Счет,
	             |	ПриходныйОрдерФондовый.КорСчет,
	             |	ПриходныйОрдерФондовый.ПодразделениеКор,
	             |	ПриходныйОрдерФондовый.СуммаДокумента КАК Сумма,
	             |	ПриходныйОрдерФондовый.ГлБухгалтер,
	             |	ПриходныйОрдерФондовый.Кассир,
	             |	ПриходныйОрдерФондовый.ПринятоОт,
	             |	ПриходныйОрдерФондовый.Основание,
	             |	ПриходныйОрдерФондовый.Приложение,
	             |	ПриходныйОрдерФондовый.Ссылка,
	             |	ПриходныйОрдерФондовый.Организация.Префикс КАК ПрефиксОрганизации,
	             |	ВЫБОР
	             |		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	             |			ТОГДА ВложенныйЗапрос.КФО
	             |		ИНАЧЕ ""0""
	             |	КОНЕЦ КАК КФО,
	             |	ПриходныйОрдерФондовый.КодЦелевогоНазначения.Код КАК КодЦелевогоНазначения,
	             |	ПриходныйОрдерФондовый.КодАналитическогоУчета,
	             |	ПриходныйОрдерФондовый.Организация.КодОКПО КАК ОрганизацияПоОКПО
	             |ИЗ
	             |	Документ.ПриходныйОрдерФондовый КАК ПриходныйОрдерФондовый
	             |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	             |			ПриходныйОрдерФондовыйРасшифровка.Ссылка КАК Ссылка,
	             |			МАКСИМУМ(ПриходныйОрдерФондовыйРасшифровка.КФО) КАК КФО,
	             |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПриходныйОрдерФондовыйРасшифровка.КФО) КАК КоличествоКФО
	             |		ИЗ
	             |			Документ.ПриходныйОрдерФондовый.Расшифровка КАК ПриходныйОрдерФондовыйРасшифровка
	             |		ГДЕ
	             |			ПриходныйОрдерФондовыйРасшифровка.Ссылка В(&МассивОбъектов)
	             |		
	             |		СГРУППИРОВАТЬ ПО
	             |			ПриходныйОрдерФондовыйРасшифровка.Ссылка) КАК ВложенныйЗапрос
	             |		ПО ПриходныйОрдерФондовый.Ссылка = ВложенныйЗапрос.Ссылка
	             |ГДЕ
	             |	ПриходныйОрдерФондовый.Ссылка В(&МассивОбъектов)
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Номер";
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();					 
	
	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, Шапка);
		
		СтруктураОбластьШапка = Новый Структура("Сумма,СуммаРубКоп,СуммаПрописью,ВТомЧисле,КодДебета,СубСчет,ФИОГлавногоБухгалтера,ФИОКассира,НомерДокумента,ДатаДокументаКв");
		СтруктураОбластьШапка.Сумма = Формат(Шапка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧГ=0");
		СтруктураОбластьШапка.СуммаРубКоп = РубКоп(Шапка.Сумма, Константы.ВалютаРегламентированногоУчета.Получить());
		СтруктураОбластьШапка.СуммаПрописью=ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Шапка.Сумма,Константы.ВалютаРегламентированногоУчета.Получить());
		СтруктураОбластьШапка.ВТомЧисле = "";
		
		СтруктураОбластьШапка.Вставить("КодЦелевогоНазначения", СокрЛП(Шапка.КодЦелевогоНазначения));
		
		СтруктураОбластьШапка.КодДебета = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.Счет, , Шапка.КФО);
		СтруктураОбластьШапка.СубСчет = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.КорСчет, , Шапка.КФО);
		
		СтруктураОбластьШапка.ФИОГлавногоБухгалтера=Справочники.Контрагенты.ФамилияИО(Шапка.ГлБухгалтер, Истина, Шапка.ДатаДокумента); 
		СтруктураОбластьШапка.ФИОКассира=Справочники.Контрагенты.ФамилияИО(Шапка.Кассир, Истина, Шапка.ДатаДокумента); 
		
		СтруктураОбластьШапка.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка,Шапка.Номер);
		СтруктураОбластьШапка.ДатаДокументаКв = Формат(Шапка.ДатаДокумента,"ДЛФ=DD");
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Объединить();
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Обвести(Линия, Линия, Линия, Линия);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Текст                   = "Ф О Н Д О В Ы Й";
		ЦветПечати                                              = Новый Цвет(83,114,187); 
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветТекста              = ЦветПечати;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветРамки               = ЦветПечати;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
		ЖирныйШрифт                                             = Новый Шрифт(ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт,, 11, Истина);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт                   = ЖирныйШрифт;
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции // ПечатьКО1

// Формирует представление суммы в рублях
//
// Параметры
//  Сумма  - Число - Заданная сумма
//  Валюта  - СправочникСсылка.Валюты - Валюта суммы
//
// Возвращаемое значение:
//   Строка   - Строковое представление суммы.
//
Функция РубКоп(Сумма, Валюта)
	
	Если Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		 ОписаниеВал1 = " руб. ";
		 ОписаниеВал2 = " коп. ";
	Иначе
		 ОписаниеВал1 =  "-";
		 ОписаниеВал2 =  " " + Валюта.Наименование;
	КонецЕсли;	
	
	Коп = ОКР(100*(Сумма-Цел(Сумма)),0,1);
	Руб = Формат(Цел(Сумма), "ЧЦ=15; ЧРД=-; ЧГ=0");
	
	СуммаРубКоп= " " + Руб + ОписаниеВал1 + Строка(Цел(Коп/10)) + Строка(Коп-10*Цел(Коп/10)) + ОписаниеВал2;
	
	Возврат СуммаРубКоп;
	
КонецФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДокументИнвентаризации - ДокументСсылка.ИнвентаризационнаяОписьБСО - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.ПриходныйОрдерФондовый, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510465(ДокументИнвентаризации, ЗаполняемыйДокумент) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокументаИнвентаризации.СчетУчета КАК СчетУчета,
	|	ДанныеДокументаИнвентаризации.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ДанныеДокументаИнвентаризации.ДенежныйДокумент КАК ДенежныйДокумент,
	|	ДанныеДокументаИнвентаризации.КФО КАК КФО,
	|	ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество,
	|	ДанныеДокументаИнвентаризации.СуммаИзлишкиНеПодтверждено КАК Сумма
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеДокументаИнвентаризации
	|ГДЕ
	|	(ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.СуммаИзлишкиНеПодтверждено <> 0)
	|	И ДанныеДокументаИнвентаризации.ВидОбъекта = 12";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаполняемыйДокумент.СуммаДокумента = 0;
	Пока Выборка.Следующий() Цикл
		ЗаполняемыйДокумент.Счет = Выборка.СчетУчета;
		НоваяСтрока = ЗаполняемыйДокумент.Расшифровка.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ЗаполняемыйДокумент.СуммаДокумента = ЗаполняемыйДокумент.СуммаДокумента + НоваяСтрока.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
