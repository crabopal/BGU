#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Заполняет документ остатками авансов к зачету.
//
Процедура ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ) Экспорт

	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("Организация", Организация);
	ПараметрыЗаполнения.Вставить("Дата",        Дата);
	ПараметрыЗаполнения.Вставить("Ссылка",      Ссылка);
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ЭтотОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		
		ЗачетАвансов.Очистить();
		
		АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
			Новый Структура("ЭтоЗачетАванса", Истина));
		
		Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
			
			Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЗачетАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету, "КФО,КПС");
			
			НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
			НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(АвансКЗачету.СчетАвансов);
			НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Перем ИсходныйРежимЗаписи;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект); 
	
	ДополнительныеСвойства.Свойство("ИсходныйРежимЗаписи", ИсходныйРежимЗаписи);
	
	ТекущиеПрава = КассаОрганизации.ПраваНаТекущийКассовыйДокумент(Ссылка);
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьОтменуПроведения;
	ИначеЕсли Проведен Тогда
		Если ИсходныйРежимЗаписи <> Неопределено 
			И ИсходныйРежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
		Иначе
			Отказ = Не ТекущиеПрава.РазрешитьПроведение;
		КонецЕсли;
	Иначе
		Отказ = НЕ ТекущиеПрава.РазрешитьПроведение;
	КонецЕсли;
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для выполнения операции'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОтчетКассира=Неопределено;
		Отказ = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Изменение документа запрещено. Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение и Оплачено = Ложь Тогда
		ОтчетКассира=Неопределено;
		Отказ = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Нельзя снять флаг ""Оплачено"". Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	ОтчетКассира = Неопределено;
	Отказ        = БухгалтерскийУчет.ЕстьПроведенныйОтчетКассираЗаЭтотДень(ЭтотОбъект, ОтчетКассира);
	Если Отказ Тогда
		
		ТекстСообщения = НСтр("ru='Документ не может быть записан с текущей датой, т.к. за данный день уже имеется проведенный документ Отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ПриходныйОрдерФондовый.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДенежныеДокументы");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ОтражениеЭДВУчете");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения) Тогда
		ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокОснование = Неопределено;
		ДанныеЗаполнения.Свойство("Основание", ДокОснование);
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияКассы.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		ИначеЕсли ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			
			Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДокОснование.Организация) Тогда
				РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДокОснование);
				Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
					ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДокОснование, РазличающаясяНоменклатураКонтрагентаИОрганизации);
					ВызватьИсключение ТекстСообщения;
				КонецЕсли;
			КонецЕсли;	
			
			ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		
		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
		
		ЗаполнитьПоОтчетуОРасходахПодотчетногоЛица(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	КассаОрганизации.ПроверитьКорректностьЗаполненияТаблицыКассовогоДокумента(ЭтотОбъект, "Расшифровка", Отказ);
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	УчетРасчетов.ЗачетАвансовВыданныхОбработкаПроверкиЗаполнения(ЭтотОбъект, НепроверяемыеРеквизиты, Отказ);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПриходныйОрдерФондовый;
	
	Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ДокументОснование = ДанныеЗаполнения;
	
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	Счет = БухгалтерскийУчетПовтИсп.СчетПоКоду("201.35", Дата);
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Извещение) Тогда
		КорСчет = БухгалтерскийУчетПовтИсп.СчетПоКоду("304.04", Дата);
	Иначе
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			Если ДанныеЗаполнения.Свойство("КорСчет") Тогда
				КорСчет = ДанныеЗаполнения.КорСчет;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Основание = ?(ЗначениеЗаполнено(ВидПервичногоДокумента) + " ", ВидПервичногоДокумента, "") +
		?(ЗначениеЗаполнено(НомерПервичногоДокумента), " № " + СокрЛП(НомерПервичногоДокумента), "") +
		?(ЗначениеЗаполнено(ДатаПервичногоДокумента), " от " +  Формат(ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy"), "");
	
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование);
	КонецЕсли;	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДокументОснование = ДанныеЗаполнения.ДокументОснование;
		СписокНоменклатуры = ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить();
	КонецЕсли;	
		
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если КорСчет = СтрокаТЧ.СчетУчетаРасчетов Тогда
			НоваяСтрока = Расшифровка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ВидДенежногоДокумента = СтрокаТЧ.Номенклатура.Владелец;
			НоваяСтрока.ДенежныйДокумент = СтрокаТЧ.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	
	СуммаДокумента = Расшифровка.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьПоОтчетуОРасходахПодотчетногоЛица(ОтчетОРасходах)
	
	РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетОРасходах, "Организация, ИФО, Сотрудник");
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыОтчета.Сотрудник, "Контрагент");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОтчетОРасходахПодотчетногоЛица", ОтчетОРасходах);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|	И ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Номенклатура ССЫЛКА Справочник.ДенежныеДокументы";
	
	ВОтчетеЕстьДенежныеДокументы = НЕ Запрос.Выполнить().Пустой();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛицаПолучено.ДокументАванса КАК ДокументАванса
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.Получено КАК ОтчетОРасходахПодотчетногоЛицаПолучено
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаПолучено.Ссылка = &ОтчетОРасходахПодотчетногоЛица";
	
	ДокументыАванса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументАванса");
	
	Запрос.УстановитьПараметр("ДокументыАвансов", ДокументыАванса);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.СуммаПринято) КАК СуммаПринято
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ОтчетОРасходахПодотчетногоЛица";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Остаток = - Выборка.СуммаПринято;
	Иначе
		Остаток = 0;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.КПС КАК КПС,
	|	ВТ.КФО КАК КФО,
	|	ВТ.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ВТ.ДенежныйДокумент КАК ДенежныйДокумент,
	|	СУММА(ВТ.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ДетальныеДанные
	|ИЗ
	|	(ВЫБРАТЬ
	|		РасходныйОрдерФондовыйРасшифровка.КПС КАК КПС,
	|		РасходныйОрдерФондовыйРасшифровка.КФО КАК КФО,
	|		РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|		РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент КАК ДенежныйДокумент,
	|		РасходныйОрдерФондовыйРасшифровка.Сумма КАК Сумма
	|	ИЗ
	|		Документ.РасходныйОрдерФондовый.Расшифровка КАК РасходныйОрдерФондовыйРасшифровка
	|	ГДЕ
	|		РасходныйОрдерФондовыйРасшифровка.Ссылка В(&ДокументыАвансов)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.КПС,
	|		ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.КФО,
	|		ВЫРАЗИТЬ(ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Номенклатура КАК Справочник.ДенежныеДокументы).Владелец,
	|		ВЫРАЗИТЬ(ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Номенклатура КАК Справочник.ДенежныеДокументы),
	|		-ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.СуммаПринято
	|	ИЗ
	|		Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|	ГДЕ
	|		ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|		И ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Номенклатура ССЫЛКА Справочник.ДенежныеДокументы) КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.КПС,
	|	ВТ.КФО,
	|	ВТ.ВидДенежногоДокумента,
	|	ВТ.ДенежныйДокумент
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ.Сумма) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходныйОрдерФондовый.КорСчет КАК КорСчет
	|ИЗ
	|	Документ.РасходныйОрдерФондовый КАК РасходныйОрдерФондовый
	|ГДЕ
	|	РасходныйОрдерФондовый.Ссылка В(&ДокументыАвансов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДетальныеДанные.КПС КАК КПС,
	|	ДетальныеДанные.КФО КАК КФО,
	|	ДетальныеДанные.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ДетальныеДанные.ДенежныйДокумент КАК ДенежныйДокумент,
	|	ДетальныеДанные.Сумма КАК Сумма,
	|	ОтчетОРасходахПодотчетногоЛица.Организация КАК Организация,
	|	ОтчетОРасходахПодотчетногоЛица.ИФО КАК ИФО,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение КАК Подразделение,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение КАК ПодразделениеКор,
	|	ОтчетОРасходахПодотчетногоЛица.ОснованиеПринятияОбязательства КАК Договор
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные,
	|	Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка = &ОтчетОРасходахПодотчетногоЛица";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ВыборкаКорСчет = Пакет[1].Выбрать();
	ВыборкаКорСчет.Следующий();
	
	Выборка = Пакет[2].Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	
	ДокументОснование = ОтчетОРасходах;
	Организация = РеквизитыОтчета.Организация;
	СпособЗачетаАванса = ПредопределенноеЗНачение("Перечисление.СпособыЗачетаАвансов.Автоматически");
	
	Счет = БухгалтерскийУчет.СчетПоКоду("201.35");
	КорСчет = ВыборкаКорСчет.КорСчет;
	
	Документы.ПриходныйОрдерФондовый.ЗаполнитьДанныеКонтрагента(Контрагент, ПринятоОт);
	
	Выборка.Сбросить();
	Пока Выборка.Следующий() Цикл
		
		НовСтрока = Расшифровка.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
		
		Если ВОтчетеЕстьДенежныеДокументы Тогда
			НомСтоимость = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтрока.ДенежныйДокумент, "НомСтоимость");
			Если НомСтоимость > 0 Тогда
				НовСтрока.Количество = НовСтрока.Сумма / НомСтоимость;
			КонецЕсли;
			СуммаДокумента = СуммаДокумента + Выборка.Сумма;
		Иначе
			НовСтрока.Сумма = 0;
			Остаток = Остаток + Выборка.Сумма;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ВОтчетеЕстьДенежныеДокументы Тогда
		
		СуммаДокумента = ?(Остаток > 0, Остаток, 0);
		
		Если Расшифровка.Количество() = 1 Тогда
			Расшифровка[0].Сумма = СуммаДокумента;
			НомСтоимость = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Расшифровка[0].ДенежныйДокумент, "НомСтоимость");
			Если НомСтоимость > 0 Тогда
				Расшифровка[0].Количество = СуммаДокумента / НомСтоимость;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		И ДанныеЗаполнения.Свойство("Разделитель");
КонецФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДанныеЗаполнения - Структура:
//   * Разделитель - Структура
//   * ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьБСО
Процедура ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения)
	Расшифровка.Очистить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация"));
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	КорСчет = БухгалтерскийУчет.СчетПоКоду("401.10", Дата, Организация);
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
	Документы.ПриходныйОрдерФондовый.ЗаполнитьПоИнвентаризации0510465(
		ДанныеЗаполнения.ДокументОснование,
		ЭтотОбъект);
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Счет = БухгалтерскийУчет.СчетПоКоду("201.35", Дата, Организация);
	КонецЕсли;
КонецПроцедуры

