&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

	БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтаФорма, Команда);	

КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПроверитьИзменитьРеквизит("Организация", Объект.Организация, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстФинансовыйГодПриИзменении(Элемент)
	
	Если ТекстФинансовыйГод < 2000 Тогда
		ТекстФинансовыйГод = 2000;
	КонецЕсли;
	
	Если Объект.ОстаткиОчередногоГода.Количество() > 0
		ИЛИ Объект.ОстаткиПервогоГодаЗаОчередным.Количество() > 0
		ИЛИ Объект.ОстаткиВторогоГодаЗаОчередным.Количество() > 0 Тогда
		Если ТекстФинансовыйГод <> ФинансовыйГодПрежняя Тогда
			ТекстВопроса = НСтр("ru = 'При изменении финансового года табличные части будут очищены.
										|Изменить финансовый год?'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить финансовый год и очистить табличные части'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять финансовый год'"));
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ТекстФинансовыйГодПриИзмененииЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 15, КодВозвратаДиалога.Да);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекстФинансовыйГодПриИзмененииДействие();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстФинансовыйГодПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ТекстФинансовыйГод = ФинансовыйГодПрежняя;
		Возврат;
	КонецЕсли;
	
	Объект.ОстаткиОчередногоГода.Очистить();
	Объект.ОстаткиПервогоГодаЗаОчередным.Очистить();
	Объект.ОстаткиВторогоГодаЗаОчередным.Очистить();
	
	ТекстФинансовыйГодПриИзмененииДействие();

КонецПроцедуры

&НаКлиенте
Процедура ТекстФинансовыйГодПриИзмененииДействие()
	
	Объект.ФинансовыйГод = Дата(ТекстФинансовыйГод, 12, 31, 23, 59, 59);

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыОстаткиОчередногоГода

&НаКлиенте
Процедура ОстаткиОчередногоГодаСчетПриемникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ОграниченияСписокСчетов, ТекущаяСтрока",
									СчетаТекущийГод, 
									Элементы.ОстаткиОчередногоГода.ТекущиеДанные.СчетПриемник);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиОчередногоГодаСубконтоПриемник1ПриИзменении(Элемент)
	БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элемент, "СубконтоПриемник");
