&НаКлиенте
Процедура ПоказатьПредупреждениеОНевозможностиЗаписи()
	ПоказатьПредупреждение(,НСтр("ru = 'Существует документ Закрытие счетов санкционирования завершаемого финансового года 
	|с включенной опцией ""Перерегистрировать бюджетные данные"", перенос показателей не может быть выполнен.'"));
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму() 
	
	ТолькоПросмотр = Объект.Проведен;
	
	Если НЕ ДатыЗапретаИзменения.ИзменениеЗапрещено("Документ.ПереносПоказателейПоСанкционированию", Объект.Ссылка)
		И ПравоДоступа("ОтменаПроведения", Метаданные.Документы.ПереносПоказателейПоСанкционированию) Тогда
		Элементы.ФормаКнопкаОтменитьПроведение.Видимость = Истина;
	КонецЕсли;	
			
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьДокумент()
	
	Если НЕ ПроверитьВозможностьПереноса(ТекстФинансовыйГод, Объект.Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСчетовСанкционирования.ТекущийГод,
	|	ТаблицаСчетовСанкционирования.ОчереднойГод,
	|	ТаблицаСчетовСанкционирования.ОчереднойГод1,
	|	ТаблицаСчетовСанкционирования.ОчереднойГод2
	|ПОМЕСТИТЬ ВсеСчета
	|ИЗ
	|	&ТаблицаСчетовСанкционирования КАК ТаблицаСчетовСанкционирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение
	|ПОМЕСТИТЬ Остатки1
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодКонец,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВсеСчета.ТекущийГод
	|				ИЗ
	|					ВсеСчета КАК ВсеСчета
	|			
	|				ОБЪЕДИНИТЬ ВСЕ
	|			
	|				ВЫБРАТЬ
	|					ВсеСчета.ОчереднойГод
	|				ИЗ
	|					ВсеСчета КАК ВсеСчета
	|			
	|				ОБЪЕДИНИТЬ ВСЕ
	|			
	|				ВЫБРАТЬ
	|					ВсеСчета.ОчереднойГод1
	|				ИЗ
	|					ВсеСчета КАК ВсеСчета
	|			
	|				ОБЪЕДИНИТЬ ВСЕ
	|			
	|				ВЫБРАТЬ
	|					ВсеСчета.ОчереднойГод2
	|				ИЗ
	|					ВсеСчета КАК ВсеСчета),
	|			,
	|			Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ИФО,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.КЭК,
	|	Остатки.Счет,
	|	Остатки.Подразделение,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.СуммаОстатокДт КАК ОстатокДебет,
	|	Остатки.СуммаОстатокКт КАК ОстатокКредит,
	|	ВсеСчета.ТекущийГод КАК СчетПриемник,
	|	Остатки.Субконто1 КАК СубконтоПриемник1,
	|	Остатки.Субконто2 КАК СубконтоПриемник2,
	|	Остатки.Субконто3 КАК СубконтоПриемник3
	|ИЗ
	|	ВсеСчета КАК ВсеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки1 КАК Остатки
	|		ПО ВсеСчета.ОчереднойГод = Остатки.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ИФО,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.КЭК,
	|	Остатки.Счет,
	|	Остатки.Подразделение,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.СуммаОстатокДт КАК ОстатокДебет,
	|	Остатки.СуммаОстатокКт КАК ОстатокКредит,
	|	ВсеСчета.ОчереднойГод КАК СчетПриемник,
	|	Остатки.Субконто1 КАК СубконтоПриемник1,
	|	Остатки.Субконто2 КАК СубконтоПриемник2,
	|	Остатки.Субконто3 КАК СубконтоПриемник3
	|ИЗ
	|	ВсеСчета КАК ВсеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки1 КАК Остатки
	|		ПО ВсеСчета.ОчереднойГод1 = Остатки.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ИФО,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.КЭК,
	|	Остатки.Счет,
	|	Остатки.Подразделение,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.СуммаОстатокДт КАК ОстатокДебет,
	|	Остатки.СуммаОстатокКт КАК ОстатокКредит,
	|	ВсеСчета.ОчереднойГод1 КАК СчетПриемник,
	|	Остатки.Субконто1 КАК СубконтоПриемник1,
	|	Остатки.Субконто2 КАК СубконтоПриемник2,
	|	Остатки.Субконто3 КАК СубконтоПриемник3
	|ИЗ
	|	ВсеСчета КАК ВсеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки1 КАК Остатки
	|		ПО ВсеСчета.ОчереднойГод2 = Остатки.Счет";
	
	Запрос.УстановитьПараметр("ПериодКонец", 					НачалоГода(Объект.ФинансовыйГод+1));

	Запрос.УстановитьПараметр("Организация", 					Объект.Организация);
	Запрос.УстановитьПараметр("ТаблицаСчетовСанкционирования", 	Документы.ПереносПоказателейПоСанкционированию.ТаблицаСчетовСанкционирования());
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Объект.ОстаткиОчередногоГода.Загрузить(РезультатЗапроса[2].Выгрузить());
	Объект.ОстаткиПервогоГодаЗаОчередным.Загрузить(РезультатЗапроса[3].Выгрузить());
	Объект.ОстаткиВторогоГодаЗаОчередным.Загрузить(РезультатЗапроса[4].Выгрузить());

	УстановитьКоличествоСубконто();
	
	Возврат Истина;
	
КонецФункции // ЗаполнитьДокумент()

&НаКлиенте
Процедура ПроверитьИзменитьРеквизит(ИмяРеквизита, СтароеЗначение, ВыбранноеЗначение)
	
	// если реквизит не изменился, то и менять нечего
	Если СтароеЗначение = ВыбранноеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	// если документ пустой, то можно менять любой реквизит
	Если Объект.ОстаткиОчередногоГода.Количество() = 0
		И Объект.ОстаткиПервогоГодаЗаОчередным.Количество() = 0
		И Объект.ОстаткиВторогоГодаЗаОчередным.Количество() = 0 Тогда
		
		Объект[ИмяРеквизита] = ВыбранноеЗначение;
		
		Возврат;
		
	КонецЕсли;

	Если ИмяРеквизита = "Организация" Тогда
		ПараметрыПодстановки = Новый Структура("Реквизит1, Реквизит2", "организации", "организацию");
	Иначе
		Объект[ИмяРеквизита] = ВыбранноеЗначение;
		Возврат;
	КонецЕсли;
		
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
								НСтр("ru = 'При изменении [Реквизит1] документ будет очищен.
											|Изменить [Реквизит2]?'"),
								ПараметрыПодстановки);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
											НСтр("ru = 'Изменить [Реквизит2] и очистить документ'"),
											ПараметрыПодстановки));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
											НСтр("ru = 'Не изменять [Реквизит2]'"),
											ПараметрыПодстановки));

	ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьИзменитьРеквизитЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеЗначение, ИмяРеквизита", ВыбранноеЗначение, ИмяРеквизита)), ТекстВопроса,Кнопки,15,КодВозвратаДиалога.Нет);
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИзменитьРеквизитЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВыбранноеЗначение 	= ДополнительныеПараметры.ВыбранноеЗначение;
	ИмяРеквизита 		= ДополнительныеПараметры.ИмяРеквизита;
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОстаткиОчередногоГода.Очистить();
	Объект.ОстаткиПервогоГодаЗаОчередным.Очистить();
	Объект.ОстаткиВторогоГодаЗаОчередным.Очистить();
	
	Объект[ИмяРеквизита] = ВыбранноеЗначение;

КонецПроцедуры // МожноИзменятьРеквизит()

&НаСервере
Процедура УстановитьВидимостьРеквизитов()

	СчетаСписком = Истина;
	СписокСчетовСанкционирования = Документы.ПереносПоказателейПоСанкционированию
											.ТаблицаСчетовСанкционирования(СчетаСписком);
	СвойстваСчетов = БухгалтерскийУчет.ПолучитьСвойстваСчетов(СписокСчетовСанкционирования, 
																Ложь, 
																"УчетПоПодразделениям, КоличествоСубконто");
	
	УчетПоПодразделениям = Ложь;
	КоличествоСубконто = 0;
	
	Соответствие = Новый Соответствие;
	Для каждого ТекСчет Из СвойстваСчетов Цикл
	
		СтруктураСвойств = Новый Структура("УчетПоПодразделениям, КоличествоСубконто");
		ЗаполнитьЗначенияСвойств(СтруктураСвойств, ТекСчет.Значение);
		
		УчетПоПодразделениям = Макс(УчетПоПодразделениям, СтруктураСвойств.УчетПоПодразделениям);
		КоличествоСубконто = Макс(КоличествоСубконто, СтруктураСвойств.КоличествоСубконто);
		Соответствие.Вставить(ТекСчет.Ключ, Новый ФиксированнаяСтруктура(СтруктураСвойств));
	
	КонецЦикла; 
	
	СчетаСанкционирования = Новый ФиксированноеСоответствие(Соответствие);
	
	Элементы.ОстаткиОчередногоГодаПодразделение.Видимость 			= УчетПоПодразделениям;
	Элементы.ОстаткиПервогоГодаЗаОчереднымПодразделение.Видимость 	= УчетПоПодразделениям;
	Элементы.ОстаткиВторогоГодаЗаОчереднымПодразделение.Видимость 	= УчетПоПодразделениям;
	
	Для Индекс = КоличествоСубконто + 1 По БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
	
		Элементы["ОстаткиОчередногоГодаСубконто"+Индекс].Видимость 					= Ложь;	
		Элементы["ОстаткиОчередногоГодаСубконтоПриемник"+Индекс].Видимость 			= Ложь;	
		Элементы["ОстаткиПервогоГодаЗаОчереднымСубконто"+Индекс].Видимость 			= Ложь;	
		Элементы["ОстаткиПервогоГодаЗаОчереднымСубконтоПриемник"+Индекс].Видимость 	= Ложь;	
		Элементы["ОстаткиВторогоГодаЗаОчереднымСубконто"+Индекс].Видимость 			= Ложь;	
		Элементы["ОстаткиВторогоГодаЗаОчереднымСубконтоПриемник"+Индекс].Видимость	= Ложь;	
	     
	КонецЦикла; 
	
	Если НЕ ПроверитьВозможностьПереноса(ТекстФинансовыйГод, Объект.Организация) Тогда
		Элементы.ФормаЗаполнить.Доступность = Ложь;	
	КонецЕсли;

КонецПроцедуры // ВидимостьРеквизитов()

&НаСервере
Процедура УстановитьКоличествоСубконто()

	Для каждого ТекСтр Из Объект.ОстаткиОчередногоГода Цикл
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.Счет);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконто 	= ТекСчет.КоличествоСубконто;
			ТекСтр.УчетПоПодразделениям = ТекСчет.УчетПоПодразделениям;
		КонецЕсли;
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.СчетПриемник);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконтоПриемник = ТекСчет.КоличествоСубконто;
		КонецЕсли;
	
	КонецЦикла; 	
	Для каждого ТекСтр Из Объект.ОстаткиПервогоГодаЗаОчередным Цикл
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.Счет);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконто 	= ТекСчет.КоличествоСубконто;
			ТекСтр.УчетПоПодразделениям = ТекСчет.УчетПоПодразделениям;
		КонецЕсли;
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.СчетПриемник);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконтоПриемник = ТекСчет.КоличествоСубконто;
		КонецЕсли;
	
	КонецЦикла; 	
	Для каждого ТекСтр Из Объект.ОстаткиВторогоГодаЗаОчередным Цикл
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.Счет);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконто 	= ТекСчет.КоличествоСубконто;
			ТекСтр.УчетПоПодразделениям = ТекСчет.УчетПоПодразделениям;
		КонецЕсли;
	
		ТекСчет = СчетаСанкционирования.Получить(ТекСтр.СчетПриемник);
		Если ТекСчет <> Неопределено Тогда
			ТекСтр.КоличествоСубконтоПриемник = ТекСчет.КоличествоСубконто;
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры // УстановитьКоличествоСубконто()

&НаСервереБезКонтекста
Функция ПроверитьВозможностьПереноса(ФинГод, ОбъектОрганизация)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗакрытиеСчетовСанкционирования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСчетовСанкционирования КАК ЗакрытиеСчетовСанкционирования
	|ГДЕ
	|	ЗакрытиеСчетовСанкционирования.Организация = &Организация
	|	И ГОД(ЗакрытиеСчетовСанкционирования.ФинансовыйГод) = &ФинансовыйГод
	|	И ЗакрытиеСчетовСанкционирования.ПеререгистрироватьБюджетныеДанные = ИСТИНА
	|	И ЗакрытиеСчетовСанкционирования.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("ФинансовыйГод",  ФинГод);
	Запрос.УстановитьПараметр("Организация",  ОбъектОрганизация);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции	
	
