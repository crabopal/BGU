#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ТаблицаСчетовСанкционирования = Документы.ПереносПоказателейПоСанкционированию.ТаблицаСчетовСанкционирования();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПроводокЕПСБУОстатки.Счет
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, 
	|													Счет В (&СчетаТекущегоГода),
	|													, 
	|													Организация = &Организация
	|																) КАК ЖурналПроводокЕПСБУОстатки";
	Запрос.УстановитьПараметр("Период", НачалоДня(ФинансовыйГод + 1));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетаТекущегоГода", ТаблицаСчетовСанкционирования.ВыгрузитьКолонку("ТекущийГод"));
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru = 'По счетам санкционирования текущего года обнаружены остатки."
					+ "Перед проведением документа необходимо выполнить закрытие счетов санкционирования расходов'");	
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
