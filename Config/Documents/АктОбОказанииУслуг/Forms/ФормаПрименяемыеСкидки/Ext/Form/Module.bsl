
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИтогСкидка = 0;
	ФормаВладельца = ЭтаФорма.ВладелецФормы;
	ВсеСкидкиНаценки.Очистить();
	Для Каждого ТекСтрока Из ФормаВладельца.ВсеСкидкиНаценки Цикл
		НоваяСтрока = ВсеСкидкиНаценки.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		ИтогСкидка = ИтогСкидка + ТекСтрока.Всего;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти
