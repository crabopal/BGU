&НаКлиенте
Процедура УслугиОказанныеНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.УслугиОказанные.ТекущиеДанные;
	ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура,
		Объект.ТипЦены, Объект.Организация, Объект.Дата);
	ТекущиеДанные.СодержаниеУслуги 	= ДанныеНоменклатуры.СодержаниеУслуги;
	
	РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.УслугиОказанные, ТекущиеДанные, "КлючСвязи");
	Если Объект.ИспользоватьСкидкиНаценки Тогда 
		ТекущиеДанные.ЦенаБезСкидок = ДанныеНоменклатуры.Цена;
		ТекущиеДанные.Цена 			= ДанныеНоменклатуры.Цена - ТекущиеДанные.Скидка;
	Иначе
		ТекущиеДанные.Цена 			= ДанныеНоменклатуры.Цена;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Количество) Тогда
		ТекущиеДанные.Количество 	= 1;	
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.СтавкаНДС) Тогда
		ТекущиеДанные.СтавкаНДС		= ДанныеНоменклатуры.СтавкаНДС;
	КонецЕсли;
	ТекущиеДанные.ПрослеживаемыйТовар = ДанныеНоменклатуры.ПрослеживаемыйТовар;
	ТекущиеДанные.КомплектСПрослеживаемымиТоварами = ДанныеНоменклатуры.КомплектСПрослеживаемымиТоварами;
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
КонецПроцедуры

&НаКлиенте
Процедура УслугиОказанныеНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.УслугиОказанные.ТекущиеДанные;
	ТипыНоменклатуры = Новый Массив;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	ПараметрыФормы = Новый Структура("Отбор, ТекущаяСтрока", Новый Структура("ТипНоменклатуры", ТипыНоменклатуры),
		ТекущиеДанные.Номенклатура);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура УслугиОказанныеСодержаниеУслугиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Оповещение = Новый ОписаниеОповещения("СодержаниеУслугиЗавершениеВвода", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(
		Оповещение, Элемент.ТекстРедактирования, НСтр("ru='Содержание услуги'"));
КонецПроцедуры

&НаКлиенте
Процедура УслугиОказанныеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование И Объект.РеализацияПоСтавке0 Тогда
		ТекущиеДанные = Элементы.УслугиОказанные.ТекущиеДанные;
		ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
	КонецЕсли;
	
	Если НоваяСтрока И Копирование Тогда
		ТекущиеДанные = Элементы.УслугиОказанные.ТекущиеДанные;
		ТекущиеДанные.ИДСтроки = "";
	КонецЕсли;
	
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные = Элементы.УслугиОказанные.ТекущиеДанные;
		ТекущиеДанные.КлючСвязи = 0;
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.УслугиОказанные, ТекущиеДанные, "КлючСвязи");
	КонецЕсли;
	
	Элементы.УслугиОказанныеСтавкаНДС.ТолькоПросмотр = Объект.РеализацияПоСтавке0;
КонецПроцедуры

