Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИспользоватьСкидкиНаценкиПриИзмененииНаСервере()
	
	Если Объект.ИспользоватьСкидкиНаценки Тогда 
		Для Каждого ТекСтрока Из Объект.УслугиОказанные Цикл
			Если ТекСтрока.ЦенаБезСкидок = 0 Тогда
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Организация", Объект.Организация);
				СтруктураПараметров.Вставить("Номенклатура", ТекСтрока.Номенклатура);
				СтруктураПараметров.Вставить("ТипЦены", Объект.ТипЦены);
				СтруктураПараметров.Вставить("ДатаЦены", Объект.Дата);
				ТекСтрока.ЦенаБезСкидок = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
				Если ТекСтрока.ЦенаБезСкидок = 0 Тогда 
					ТекСтрока.ЦенаБезСкидок = ТекСтрока.Цена;	
				КонецЕсли;	
			КонецЕсли;
			Если ТекСтрока.КлючСвязи = 0 Тогда
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.УслугиОказанные, ТекСтрока, "КлючСвязи");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормыСкидки(Форма)
	
	Объект = Форма.Объект;
	ИспользоватьСкидкиНаценки = Объект.ИспользоватьСкидкиНаценки;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиОказанныеЦенаБезСкидок", "Видимость", ИспользоватьСкидкиНаценки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиОказанныеСкидка", "Видимость", ИспользоватьСкидкиНаценки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиОказанныеГруппаУправлениеСкидками", "Видимость", ИспользоватьСкидкиНаценки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСкидкиДляУслуги", "Видимость", ИспользоватьСкидкиНаценки);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценок(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДобавитьОбщуюСкидкуДляМатериаловНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбщуюСкидкуДляМатериаловНаСервере(СкидкаНаценка)
	
	Для Каждого ТекСтрока Из Объект.УслугиОказанные Цикл
		НоваяСтрока = Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.КлючСвязи = ТекСтрока.КлючСвязи;
		НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
		
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		
		НоваяСтрока.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
			
		ТекСтрока.Скидка 	= ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
		ТекСтрока.Цена 		= ЦенаБезСкидок - ТекСтрока.Скидка;
		
		РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;	
	ОбновитьСкидкиНаценкиНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры)
	
	Возврат РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
	
КонецФункции

&НаСервере
Функция ОбщаяСкидкаПоНоменклатуре(КлючСвязи)
	
	ПараметрыОтбора = Новый Структура("КлючСвязи", КлючСвязи); 	
	МассивОтбора = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Результат = 0;
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		Результат = Результат + СтрокаОтбора.Сумма;
	КонецЦикла;	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокОтмена(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ОтменитьОбщуюСкидкуНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьОбщуюСкидкуНаСервере(СкидкаНаценка)
	
	ПараметрыОтбора = Новый Структура("СкидкаНаценка", СкидкаНаценка); 	
	МассивКУдалению = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СкидкиНаценки.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Для каждого ТекСтрока Из Объект.УслугиОказанные Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
			
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;
	ОбновитьСкидкиНаценкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкидкиНаценкиНаСервере()

	ДанныеВсеСкидкиНаценки = ДанныеВсеСкидкиНаценки();
	
	ЭтаФорма.ВсеСкидкиНаценки.Загрузить(ДанныеВсеСкидкиНаценки);	
	
КонецПроцедуры

&НаСервере
Функция ДанныеВсеСкидкиНаценки()
	
	Скидки = Объект.СкидкиНаценки.Выгрузить();	
	Услуги = Объект.УслугиОказанные.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Услуги.КлючСвязи,
	               |	Услуги.НомерСтроки,
	               |	Услуги.Номенклатура,
	               |	Услуги.Количество
	               |ПОМЕСТИТЬ Услуги
	               |ИЗ
	               |	&Услуги КАК Услуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СкидкиНаценки.КлючСвязи,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма
	               |ПОМЕСТИТЬ СкидкиНаценки
	               |ИЗ
	               |	&СкидкиНаценки КАК СкидкиНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Услуги.НомерСтроки,
	               |	Услуги.Номенклатура,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма,
	               |	Услуги.Количество,
	               |	Услуги.Количество * СкидкиНаценки.Сумма КАК Всего
	               |ПОМЕСТИТЬ ИтогиСкидокНаценок
	               |ИЗ
	               |	Услуги КАК Услуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СкидкиНаценки КАК СкидкиНаценки
	               |		ПО Услуги.КлючСвязи = СкидкиНаценки.КлючСвязи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогиСкидокНаценок.НомерСтроки,
	               |	ИтогиСкидокНаценок.Номенклатура,
	               |	ИтогиСкидокНаценок.СкидкаНаценка,
	               |	ИтогиСкидокНаценок.Сумма,
	               |	ИтогиСкидокНаценок.Количество,
	               |	ИтогиСкидокНаценок.Всего
	               |ИЗ
	               |	ИтогиСкидокНаценок КАК ИтогиСкидокНаценок
	               |ГДЕ
	               |	ИтогиСкидокНаценок.Всего <> 0";
				   
	Запрос.УстановитьПараметр("Услуги", Услуги);
	Запрос.УстановитьПараметр("СкидкиНаценки", Скидки);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыСкидокПриАктивизацииУслуг()
	
	Элемент = Элементы.УслугиОказанные;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда 
		ОтборДляСкидок(Элемент.ТекущиеДанные.КлючСвязи);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляСкидок(КлючСвязи)
	
	Если Элементы.СкидкиНаценки.ОтборСтрок = Неопределено ИЛИ НЕ (Элементы.СкидкиНаценки.ОтборСтрок.Свойство("КлючСвязи") И Элементы.СкидкиНаценки.ОтборСтрок.КлючСвязи = КлючСвязи) Тогда
		Элементы.СкидкиНаценки.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСвязи", КлючСвязи));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиОказанныеПослеУдаленияНаСервере()
	
	ОбновитьСкидкиНаценкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКонтрактуНаСервере()
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьПоКонтрактуНаСервере(ЭтотОбъект);
	ЭлектронноеАктированиеБГУ.ЗаполнитьСлужебныеДанныеЕИС(ЭтотОбъект, "УслугиОказанные", "УслугиОказанные");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКонтрактуПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоКонтрактуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(КлючевойДопРеквизит = Неопределено)
	ЭлектронныеДокументыБГУ.ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(ЭтотОбъект, КлючевойДопРеквизит);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСведенийЭлектронногоУПДПоставщика(ДанныеДляУПД)
 	
	Объект.РеквизитыЛицевогоСчета = ДанныеДляУПД.РеквизитыЛицевогоСчета;
	Объект.РасчетныйСчетКонтрагента = ДанныеДляУПД.РасчетныйСчетКонтрагента;
	
	Объект.КПСПродавца = ДанныеДляУПД.КПСПродавца;
	Объект.КодЦелиПродавца = ДанныеДляУПД.КодЦелиПродавца;

	Объект.ТРУПереданы = ДанныеДляУПД.ТРУПереданы;
	Объект.ДатаПередачиТРУ = ДанныеДляУПД.ДатаПередачиТРУ;
	Объект.ОтветственныйПередалТРУ = ДанныеДляУПД.ОтветственныйПередалТРУ;
	Объект.ОтветственныйПередалТРУВид = ДанныеДляУПД.ОтветственныйПередалТРУВид;
	Объект.ОтветственныйПередалТРУДоверенность = ДанныеДляУПД.ОтветственныйПередалТРУДоверенность;
	Объект.ОтветственныйПередалТРУДолжность = ДанныеДляУПД.ОтветственныйПередалТРУДолжность;
	Объект.ОтветственныйПередалТРУИныеСведения = ДанныеДляУПД.ОтветственныйПередалТРУИныеСведения;
	Объект.ОтветственныйПередалТРУКонтрагент = ДанныеДляУПД.ОтветственныйПередалТРУКонтрагент;
	Объект.ОтветственныйПередалТРУОснованиеПолномочий = ДанныеДляУПД.ОтветственныйПередалТРУОснованиеПолномочий;
	Объект.ОтветственныйПередалТРУДокументПолномочий = ДанныеДляУПД.ОтветственныйПередалТРУДокументПолномочий;

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(ДанныеДляУПД.РеквизитыЛицевогоСчета);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСведенияОПриемкеПередачеПоставщикаДляУПД()
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;	
	КонецЕсли;
	
	ЛицевойСчетОрганизиции = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация,
			"Документ.АктОбОказанииУслуг", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский,,"");
	Если ЗначениеЗаполнено(ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета) Тогда
		Объект.РеквизитыЛицевогоСчета = ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета;
	КонецЕсли;
	
	Если ЭлектронныеДокументыБГУ.УПДЗаполнятьДатуПередачиПоДатеДокументаРеализации(Объект.Организация) Тогда
		
		Объект.ДатаПередачиТРУ = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
		Объект.ТРУПереданы = Истина;
		
	КонецЕсли;  
	
	СведенияПоОтветственному = ЭлектронныеДокументыБГУ.ПолучитьСведенияОтветственныхЭлектронныУПД(Объект.Организация);
	
	Если ЗначениеЗаполнено(СведенияПоОтветственному) Тогда
		
		Объект.ОтветственныйПередалТРУ 						= СведенияПоОтветственному.ОтветственныйПередалТРУ;	
		Объект.ОтветственныйПередалТРУВид 					= СведенияПоОтветственному.ОтветственныйПередалТРУВид;
		Объект.ОтветственныйПередалТРУДоверенность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДоверенность;
		Объект.ОтветственныйПередалТРУДолжность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДолжность;
		Объект.ОтветственныйПередалТРУИныеСведения 			= СведенияПоОтветственному.ОтветственныйПередалТРУИныеСведения;
		Объект.ОтветственныйПередалТРУКонтрагент 			= СведенияПоОтветственному.ОтветственныйПередалТРУКонтрагент;
		Объект.ОтветственныйПередалТРУДокументПолномочий 	= СведенияПоОтветственному.ОтветственныйПередалТРУДокументПолномочий;
		Объект.ОтветственныйПередалТРУОснованиеПолномочий 	= ""; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
		ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(Объект.РеквизитыЛицевогоСчета);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийУПД()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийУПД();
КонецФункции

&НаСервереБезКонтекста
Функция ПредельнаяДатаОплатыЗадолженности(ДатаДокумента, Договор)
	
	Возврат КонтрольИсполненияДоговоров.ПредельнаяДатаОплатыЗадолженности(ДатаДокумента, Договор);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовАгентскаяУслуга(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаАгентскиеУслуги", "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПрослеживаемости(Форма)

	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОтражатьВПрослеживаемости");
	ИменаЭлементовПрослеживаемости.Добавить("УслугиОказанныеПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ИменаЭлементовДвиженияПрослеживаемости = Новый Массив;
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("УслугиОказанныеСтранаПроисхождения");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("УслугиОказанныеРНПТ");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовДвиженияПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости И Форма.Объект.ОтражатьВПрослеживаемости);

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Выключенный флажок "КомиссионнаяТорговля" - недоступные поля "Комитент", "ДоговорКомитента"
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиОказанныеКомитент");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиОказанныеДоговорКомитента");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.УслугиОказанные.КомиссионнаяТорговля", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	ПрослеживаемостьФормыБГУ.УстановитьУсловноеОформление(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УслугиОказанныеПриИзмененииСервер()
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.УслугиОказанные);
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТНаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.УслугиОказанные.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
		СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.УслугиОказанные.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

