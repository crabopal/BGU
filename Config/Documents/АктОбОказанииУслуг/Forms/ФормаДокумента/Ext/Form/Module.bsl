&НаКлиенте
Процедура СкидкиНаценкиПослеУдаления(Элемент)
	
	ТекСтрока = Элементы.УслугиОказанные.ТекущиеДанные;
	ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
	ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;

	РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиСкидкаНаценкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СкидкиНаценки.ТекущиеДанные;
	ТекущиеДанныеНоменклатуры = Элементы.УслугиОказанные.ТекущиеДанные;
	ЦенаБезСкидок = ТекущиеДанныеНоменклатуры.ЦенаБезСкидок;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СкидкаНаценка) Тогда
		ТекущиеДанные.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(ТекущиеДанные.СкидкаНаценка, ЦенаБезСкидок);
		ТекущиеДанныеНоменклатуры.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекущиеДанные.КлючСвязи);
		ТекущиеДанныеНоменклатуры.Цена = ТекущиеДанныеНоменклатуры.ЦенаБезСкидок - ТекущиеДанныеНоменклатуры.Скидка;
		РасчитатьСтроку(ТекущиеДанныеНоменклатуры, Объект.СуммаВключаетНДС, "Цена");
		ОбновитьСкидкиНаценкиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

