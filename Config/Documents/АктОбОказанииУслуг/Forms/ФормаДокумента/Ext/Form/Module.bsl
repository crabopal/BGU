		ОткрытьФорму("Документ.ОтчетПоКассовойСмене.ФормаВыбора",ПараметрыФормы,Элемент);
	Иначе	
		ОткрытьФорму("Документ.СчетНаОплату.Форма.ФормаВыбора",ПараметрыФормы,Элемент);
