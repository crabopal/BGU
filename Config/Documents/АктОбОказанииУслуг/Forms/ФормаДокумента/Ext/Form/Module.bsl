Процедура ПересчитатьСуммаВключаетНДС()

	Для каждого ТекУслуга Из Объект.УслугиОказанные Цикл
	
		РасчитатьСтроку(ТекУслуга, Объект.СуммаВключаетНДС, "Сумма");
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьТипЦены()

	МассивНоменклатуры = Объект.УслугиОказанные.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	ЦеныНоменклатуры = ПолучитьЦенуНоменклатуры(МассивНоменклатуры, Объект.ТипЦены, Объект.Организация, Объект.Дата);
	Для каждого ТекущиеДанные Из Объект.УслугиОказанные Цикл
	
		СтрЦена = ЦеныНоменклатуры.Найти(ТекущиеДанные.Номенклатура, "Номенклатура");
		Если СтрЦена <> Неопределено Тогда
			ТекущиеДанные.Цена = СтрЦена.Цена;
		Иначе
			ТекущиеДанные.Цена = 0;
		КонецЕсли;
		РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Организация, Дата)

	МассивНоменклатуры = ТипЗнч(Номенклатура) = Тип("Массив");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ТипЦен = &ТипЦены
	|				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних";
	Если МассивНоменклатуры Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",			Дата); 
	Запрос.УстановитьПараметр("Организация",	Организация); 
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены); 
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура); 
	Результат = Запрос.Выполнить();
	Если МассивНоменклатуры Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		Иначе
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Цена;
		КонецЕсли;
	КонецЕсли;

КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(Номенклатура, ТипЦены, Организация, Дата)

	ДанныеНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(Номенклатура, Дата);

	Результат = Новый Структура;
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.НаименованиеПолное) Тогда
		Результат.Вставить("СодержаниеУслуги", ДанныеНоменклатуры.НаименованиеПолное);
	Иначе
		Результат.Вставить("СодержаниеУслуги", ДанныеНоменклатуры.Наименование);
	КонецЕсли;
	Результат.Вставить("СтавкаНДС", ДанныеНоменклатуры.СтавкаНДС);
	Результат.Вставить("ПрослеживаемыйТовар", ДанныеНоменклатуры.ПрослеживаемыйТовар);
	Результат.Вставить("КомплектСПрослеживаемымиТоварами", ДанныеНоменклатуры.КомплектСПрослеживаемымиТоварами);
	Результат.Вставить("Цена", ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Организация, Дата));
	Возврат Результат;

КонецФункции

