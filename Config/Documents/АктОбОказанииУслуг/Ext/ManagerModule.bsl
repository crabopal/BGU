#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктОбОказанииУслуг.Номер КАК НомерАкта,
	|	АктОбОказанииУслуг.Дата КАК ДатаАкта,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЭД.ПродажаКомиссия) КАК ВидОперации,
	|	АктОбОказанииУслуг.Организация КАК Организация,
	|	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	|	АктОбОказанииУслуг.ДокументОснование КАК ДокументОснование,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(АктОбОказанииУслуг.ВалютаДокумента КАК Справочник.Валюты).Код
	|		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	|	КОНЕЦ КАК ВалютаКод,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(АктОбОказанииУслуг.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	|		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	|	КОНЕЦ КАК ВалютаНаименование,
	|	&КурсВзаиморасчетов КАК Курс,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА АктОбОказанииУслуг.ВалютаДокумента
	|		ИНАЧЕ &РегламентированнаяВалюта
	|	КОНЕЦ КАК Валюта,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.Контрагент.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					КОГДА НЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	|						ТОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	|					КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	|					ИНАЧЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.Контрагент.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					ИНАЧЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	|	АктОбОказанииУслуг.Ссылка КАК Ссылка,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУВид КАК ОтветственныйПередалТРУВид,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУДолжность КАК ОтветственныйПередалТРУДолжность,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУОснованиеПолномочий КАК ОтветственныйПередалТРУОснованиеПолномочий,
	|	АктОбОказанииУслуг.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	|	АктОбОказанииУслуг.ДатаПередачиТРУ КАК ДатаПередачиТРУ,
	|	АктОбОказанииУслуг.ТРУПереданы КАК ТРУПереданы
	|ИЗ
	|	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	|ГДЕ
	|	АктОбОказанииУслуг.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Услуги.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК НаименованиеНоменклатуры,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).Наименование КАК НаименованиеЭлементаНоменклатуры,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер = """"
	|			ТОГДА ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).Код
	|		ИНАЧЕ ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер
	|	КОНЕЦ КАК КодТовара,
	|	ВЫБОР
	|		КОГДА Услуги.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА Услуги.Номенклатура.ЕдиницаИзмерения.Наименование
	|		ИНАЧЕ Услуги.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА Услуги.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА Услуги.Номенклатура.ЕдиницаИзмерения.Код
	|		ИНАЧЕ Услуги.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	Услуги.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА Услуги.Ссылка.СуммаВключаетНДС
	|			ТОГДА ВЫБОР
	|					КОГДА Услуги.Количество = 0
	|						ТОГДА Услуги.Всего - Услуги.СуммаНДС
	|					КОГДА Услуги.СуммаНДС = 0 И Услуги.Цена <> 0
	|						ТОГДА Услуги.Цена
	|					ИНАЧЕ ВЫРАЗИТЬ((Услуги.Всего - Услуги.СуммаНДС) / Услуги.Количество КАК ЧИСЛО(14, 2))
	|				КОНЕЦ
	|		ИНАЧЕ Услуги.Цена
	|	КОНЕЦ КАК Цена,
	|	Услуги.Цена КАК ЦенаАктаВыполненныхРабот,
	|	Услуги.Всего - Услуги.СуммаНДС КАК СуммаБезНДС,
	|	Услуги.СуммаНДС КАК СуммаНДС,
	|	Услуги.Всего КАК СуммаСНДС,
	|	Услуги.СодержаниеУслуги КАК Описание,
	|	Услуги.Номенклатура КАК Номенклатура,
	|	Услуги.СтавкаНДС КАК СтавкаНДС,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).КодКаталога КАК КодКаталога,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).КодПоКТРУ КАК КодПоКТРУ,
	|	ВЫРАЗИТЬ(Услуги.Номенклатура КАК Справочник.Номенклатура).КодТНВЭД КАК КодТНВЭД,
	|	Услуги.ИДСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.НомерСтроки КАК НомерСтроки,
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС КАК ИдентификаторДляАктированияЕИС,
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.СтранаПроизводителя КАК СтранаПроизводителя,
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.ОбъемВТекстовомВыражении КАК ОбъемВТекстовомВыражении
	|ИЗ
	|	Документ.АктОбОказанииУслуг.ДанныеДляАктированияЕИС КАК АктОбОказанииУслугДанныеДляАктированияЕИС
	|ГДЕ
	|	АктОбОказанииУслугДанныеДляАктированияЕИС.Ссылка = &Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);	
	Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);	
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", ВалютаРегУчета);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Структура = Новый Структура("Шапка, ТабЧасть, ДанныеЭлектронногоАктирования", МассивРезультатов[0].Выгрузить(), МассивРезультатов[1].Выгрузить(), МассивРезультатов[2].Выгрузить());
	
	Возврат Структура;
	
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	НеобходимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(ДокументСсылка.Контрагент, ДокументСсылка.Организация);
	Если НеобходимостьДанныхЭДОПродавцаДляГосНужд Тогда
		ДанныеЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументСсылка);
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.ДатаГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата гос.контракта в карточке договора %1 (реквизит ""от"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.НомерГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен номер гос.контракта в карточке договора %1 (реквизит ""№"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.УслугиОказанные Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения, КодПоКТРУ, КодКаталога");
			
			Если НЕ ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмерения) И НЕ ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в карточке номенклатуры в строке %1 таблицы на закладке ""Услуги"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Услуги"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти    

#Область СлужебныйПрограммныйИнтерфейс   

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	ДобавитьДвиженияАгентскиеУслуги(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка)
	
КонецПроцедуры

#КонецОбласти     

#КонецЕсли

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбОказанииУслуг";
	КомандаПечати.Идентификатор		= "АктОбОказанииУслуг";
	КомандаПечати.Представление		= НСтр("ru = 'Акт об оказании услуг'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктОбОказанииУслуг",
															"Акт об оказании услуг",
															ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктВыполненныхУслуг");
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги 	= Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_АКТВЫПОЛНЕННЫХУСЛУГ";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктОбОказанииУслуг.Ссылка КАК Ссылка,
	|	АктОбОказанииУслуг.Номер КАК пНомер,
	|	АктОбОказанииУслуг.Дата КАК пДата,
	|	АктОбОказанииУслуг.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕСТЬNULL(АктОбОказанииУслуг.Подразделение.ОбособленноеПодразделение, ЛОЖЬ)
	|				И ЕСТЬNULL(АктОбОказанииУслуг.Подразделение.НаименованиеПолное, """") <> """"
	|			ТОГДА АктОбОказанииУслуг.Подразделение.НаименованиеПолное
	|		КОГДА АктОбОказанииУслуг.Организация.НаименованиеПолное = """"
	|			ТОГДА АктОбОказанииУслуг.Организация.Наименование
	|		ИНАЧЕ АктОбОказанииУслуг.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	АктОбОказанииУслуг.Организация.ИНН КАК ИННОрганизации,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕСТЬNULL(АктОбОказанииУслуг.Подразделение.ОбособленноеПодразделение, ЛОЖЬ)
	|				И ЕСТЬNULL(АктОбОказанииУслуг.Подразделение.РегистрацияВНалоговомОргане, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|			ТОГДА АктОбОказанииУслуг.Подразделение.РегистрацияВНалоговомОргане.КПП
	|		ИНАЧЕ АктОбОказанииУслуг.Организация.КПП
	|	КОНЕЦ КАК КППОрганизации,
	|	АктОбОказанииУслуг.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	|	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА АктОбОказанииУслуг.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ АктОбОказанииУслуг.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА АктОбОказанииУслуг.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ АктОбОказанииУслуг.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ АктОбОказанииУслуг.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	АктОбОказанииУслуг.Контрагент.ИНН КАК КонтрагентИНН,
	|	АктОбОказанииУслуг.Контрагент.КПП КАК КонтрагентКПП,
	|	ВЫБОР
	|		КОГДА КонтрагентыКППИстория.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК БылоИзменениеКППКонтрагента,
	|	ПРЕДСТАВЛЕНИЕ(АктОбОказанииУслуг.Договор) КАК пДоговор,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.ВалютаДокумента = &ПустаяВалюта
	|			ТОГДА &РегламентированнаяВалюта
	|		ИНАЧЕ АктОбОказанииУслуг.ВалютаДокумента
	|	КОНЕЦ КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.ВалютаДокумента = &ПустаяВалюта
	|				ИЛИ АктОбОказанииУслуг.ВалютаДокумента = &РегламентированнаяВалюта
	|			ТОГДА ""Руб.""
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(АктОбОказанииУслуг.ВалютаДокумента)
	|	КОНЕЦ КАК пВалюта,
	|	АктОбОказанииУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	АктОбОказанииУслуг.Руководитель КАК Руководитель,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	|	ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.Контрагент.ОбособленноеПодразделение = ИСТИНА ТОГДА
	|			ВЫБОР
	|				КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|					""""
	|				КОГДА НЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """" ТОГДА
	|					// Если задано наименование для печати - используем его
	|					АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	|					
	|				КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|					И НЕ АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|					// Для юридических лиц есть реквизит НаименованиеПолное
	|					ВЫРАЗИТЬ(АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное	КАК СТРОКА(1000))
	|					
	|				ИНАЧЕ
	|					АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.Наименование
	|			КОНЕЦ	
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ													КАК КонтрагентГоловнаяОрганизацияПредставление,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.Контрагент.ОбособленноеПодразделение = ИСТИНА ТОГДА
	|			ВЫБОР
	|				КОГДА АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|					""""
	|				ИНАЧЕ
	|					// Реквизит ИНН есть и у юридических, и у физических лиц
	|					АктОбОказанииУслуг.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	|			КОНЕЦ
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ													КАК КонтрагентГоловнаяОрганизацияИНН
	|ИЗ
	|	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КППИстория КАК КонтрагентыКППИстория
	|		ПО АктОбОказанииУслуг.Контрагент = КонтрагентыКППИстория.Ссылка
	|			И (КонтрагентыКППИстория.НомерСтроки = 1)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
	|		ПО (ИСТИНА)
	|ГДЕ
	|	АктОбОказанииУслуг.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктОбОказанииУслугУслугиОказанные.Ссылка КАК Ссылка,
	|	АктОбОказанииУслугУслугиОказанные.НомерСтроки КАК пНом,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА АктОбОказанииУслугУслугиОказанные.СодержаниеУслуги
	|		КОГДА ПОДСТРОКА(АктОбОказанииУслугУслугиОказанные.СодержаниеУслуги, 1, 1000) <> """"
	|			ТОГДА АктОбОказанииУслугУслугиОказанные.СодержаниеУслуги
	|		КОГДА АктОбОказанииУслугУслугиОказанные.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА АктОбОказанииУслугУслугиОказанные.Номенклатура.Наименование
	|		ИНАЧЕ АктОбОказанииУслугУслугиОказанные.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК пНаименование,
	|	ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.Количество, 0) КАК пКоличество,
	|	ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.Цена, 0) КАК пЦена,
	|	ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.Сумма, 0) КАК пСумма,
	|	АктОбОказанииУслугУслугиОказанные.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.СуммаНДС, 0) КАК пСуммаНДС,
	|	ЕСТЬNULL(АктОбОказанииУслугУслугиОказанные.Всего, 0) КАК Всего,   
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслугУслугиОказанные.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА АктОбОказанииУслугУслугиОказанные.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ АктОбОказанииУслугУслугиОказанные.ЕдиницаИзмерения.Представление
	|	КОНЕЦ КАК пЕдИзм
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК АктОбОказанииУслугУслугиОказанные
	|ГДЕ
	|	АктОбОказанииУслугУслугиОказанные.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	пНом
	|ИТОГИ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПустаяВалюта",Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", Константы.ВалютаРегламентированногоУчета.Получить());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ВыборкаВсеСтроки = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		МассивДляПроверки = Новый Массив;
		МассивДляПроверки.Добавить(ОбластьИтоги);
		МассивДляПроверки.Добавить(ОбластьПодвал);
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		НаименованиеОрганизации = СтрШаблон(НСтр("ru = '%1 ИНН %2 КПП %3'"),
			ВыборкаШапка.НаименованиеОрганизации, ВыборкаШапка.ИННОрганизации, ВыборкаШапка.КППОрганизации);
		ПараметрОрганизация = Новый Структура;
		ПараметрОрганизация.Вставить("пНаименованиеОрганизации", НаименованиеОрганизации);
		ОбластьШапка.Параметры.Заполнить(ПараметрОрганизация);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьШапка,
			"пНомер",ВыборкаШапка.пНомер, ВыборкаШапка.Ссылка, Неопределено, Истина);
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
			
		ДопДанныеПечати = Новый Структура;
		
		ДопДанныеПечати.Вставить("пАдресТелефон", АдресОрганизации + ?(ПустаяСтрока(ТелефонОрганизации), "", ", тел.:"+ТелефонОрганизации));
		
		Если ВыборкаШапка.БылоИзменениеКППКонтрагента Тогда
			КПП = Справочники.Контрагенты.ПолучитьКПП(ВыборкаШапка.Контрагент, ВыборкаШапка.пДата);
		Иначе
			КПП = ВыборкаШапка.КонтрагентКПП;
		КонецЕсли;
		
		ДанныеКонтрагента = Новый Массив;
		Если ВыборкаШапка.КонтрагентОбособленноеПодразделение Тогда
			ДанныеКонтрагента.Добавить(ВыборкаШапка.КонтрагентГоловнаяОрганизацияПредставление);
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентГоловнаяОрганизацияИНН) Тогда
				ДанныеКонтрагента.Добавить(СтрШаблон(НСтр("ru = 'ИНН %1'"), ВыборкаШапка.КонтрагентГоловнаяОрганизацияИНН));
			КонецЕсли;
			Если ЗначениеЗаполнено(КПП) Тогда
				ДанныеКонтрагента.Добавить(СтрШаблон(НСтр("ru = 'КПП %1'"), КПП));
			КонецЕсли;
		Иначе
			ДанныеКонтрагента.Добавить(ВыборкаШапка.КонтрагентНаименование);
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентИНН) Тогда
				ДанныеКонтрагента.Добавить(СтрШаблон(НСтр("ru = 'ИНН %1'"), ВыборкаШапка.КонтрагентИНН));
			КонецЕсли;
			Если ЗначениеЗаполнено(КПП) Тогда
				ДанныеКонтрагента.Добавить(СтрШаблон(НСтр("ru = 'КПП %1'"), КПП));
			КонецЕсли;
		КонецЕсли;
		
		ДопДанныеПечати.Вставить("пЗаказчик", СтрСоединить(ДанныеКонтрагента, " "));
		ДопДанныеПечати.Вставить("пДата", Формат(ВыборкаШапка.пДата, "ДЛФ=DD"));
		
		ОбластьШапка.Параметры.Заполнить(ДопДанныеПечати);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ВыборкаВсеСтроки.Сбросить();
		ОтборСтрок = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
		Если ВыборкаВсеСтроки.НайтиСледующий(ОтборСтрок) Тогда
			ВыборкаСтрок = ВыборкаВсеСтроки.Выбрать();
			КоличествоСтрок = ВыборкаСтрок.Количество();
		Иначе
			КоличествоСтрок = 0;
		КонецЕсли;
		ИтогСумма = 0;
		ИтогНДС = 0;
		
		СтавкиНДС = Новый Массив();
		
		Пока КоличествоСтрок > 0 И ВыборкаСтрок.Следующий() Цикл
			
			Попытка 
				
				Если ВыборкаСтрок.пНом = КоличествоСтрок Тогда
					
					МассивДляПроверки.Добавить(ОбластьСтрока);
					
					Если НЕ ТабличныйДокумент.ПроверитьВывод(МассивДляПроверки) Тогда
						ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						ТабличныйДокумент.Вывести(ОбластьЗаголовок);
					КонецЕсли;
					
				ИначеЕсли НЕ ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьЗаголовок);
				КонецЕсли;	
				
			Исключение 
				ОписаниеОшибки = НСтр("ru='В системе не установлено ни одного принтера.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			КонецПопытки;
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрок);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			ИтогСумма 	= ИтогСумма + ВыборкаСтрок.пСумма;
			ИтогНДС 	= ИтогНДС 	+ ВыборкаСтрок.пСуммаНДС;
			
			Если СтавкиНДС.Найти(ВыборкаСтрок.СтавкаНДС) = Неопределено Тогда
				СтавкиНДС.Добавить(ВыборкаСтрок.СтавкаНДС);
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоСтрок = 0 Тогда
			Область = Макет.ПолучитьОбласть("Строка");
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		ДопДанныеПечати = Новый Структура;
		
		ДопДанныеПечати.Вставить("пИтогСумма", ИтогСумма);
		
		ДанныеПечатиИтоговНДС = УправлениеПечатьюБГУ.ДанныеПечатиИтоговНДС(ИтогНДС, СтавкиНДС, ВыборкаШапка.СуммаВключаетНДС);
		
		ДопДанныеПечати.Вставить("пТекстНДС",	ДанныеПечатиИтоговНДС.Заголовок);
		ДопДанныеПечати.Вставить("пИтогНДС",	ДанныеПечатиИтоговНДС.Сумма);
		
		Если ВыборкаШапка.СуммаВключаетНДС Тогда
			пИтогВсего = ИтогСумма;
		Иначе
			пИтогВсего = ИтогСумма + ИтогНДС;
		КонецЕсли;
		
		ДопДанныеПечати.Вставить("пИтогВсего", пИтогВсего);
		
		ОбластьИтоги.Параметры.Заполнить(ДопДанныеПечати);
		
		ТабличныйДокумент.Вывести(ОбластьИтоги);
		
		ДопДанныеПечати = Новый Структура;
		
		ДопДанныеПечати.Вставить("пИтогВсегоПрописью", ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(пИтогВсего, ВыборкаШапка.ВалютаДокумента));
		ДопДанныеПечати.Вставить("пИтогНДСПрописью", ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ИтогНДС, ВыборкаШапка.ВалютаДокумента));
		ДопДанныеПечати.Вставить("РуководительФИО",  Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Истина, ВыборкаШапка.пДата));
		
		ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
		
		ДопДанныеПечати.Вставить("РуководительДолжность", ДанныеПодписанта.Должность);
		
		ОбластьПодвал.Параметры.Заполнить(ДопДанныеПечати);
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;
	
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		// Заполнение шапки
			
		ЗаполняемыеРеквизиты = "Организация, ИФО, Подразделение, Договор, Контрагент, СуммаВключаетНДС, ТипЦены, ВалютаДокумента";
		ЗаполнитьЗначенияСвойств(Объект, Основание, ЗаполняемыеРеквизиты);
		Объект.ДокументОснование = Основание.Ссылка;
		
		Для Каждого ТекСтрока Из Основание.Услуги Цикл
			НоваяСтрока = Объект.УслугиОказанные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.СодержаниеУслуги = ТекСтрока.Содержание;
		КонецЦикла;
		
		Если Основание.ИспользоватьСкидкиНаценки Тогда 
			Объект.ИспользоватьСкидкиНаценки = Истина;
			Для Каждого ТекСтрока Из Основание.СкидкиНаценки Цикл
				НоваяСтрока = Объект.СкидкиНаценки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОтчетПоКассовойСмене.Ссылка КАК ДокументОснование,
		               |	ОтчетПоКассовойСмене.Организация КАК Организация,
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).КонтрагентДляРозничныхПродаж КАК Контрагент,
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).ДоговорДляРозничныхПродаж КАК Договор,
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).ТипЦены КАК ТипЦены,
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).СуммаВключаетНДС КАК СуммаВключаетНДС,
		               |	&ВалютаДокумента КАК ВалютаДокумента
		               |ИЗ
		               |	Документ.ОтчетПоКассовойСмене КАК ОтчетПоКассовойСмене
		               |ГДЕ
		               |	ОтчетПоКассовойСмене.Ссылка = &ОтчетПоКассовойСмене
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСменеПродажиРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК Номенклатура,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.Количество КАК Количество,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.Цена КАК Цена,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.Сумма КАК Сумма,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.СтавкаНДС КАК СтавкаНДС,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.СуммаНДС КАК СуммаНДС,
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.Всего КАК Всего
		               |ПОМЕСТИТЬ РезультатыПродаж
		               |ИЗ
		               |	Документ.ОтчетПоКассовойСмене.ПродажиРаботыУслуги КАК ОтчетПоКассовойСменеПродажиРаботыУслуги
		               |ГДЕ
		               |	ОтчетПоКассовойСменеПродажиРаботыУслуги.Ссылка = &ОтчетПоКассовойСмене
		               |	И ОтчетПоКассовойСменеПродажиРаботыУслуги.ЭтоРозничныйПокупатель = ИСТИНА
					   |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОтменаРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
		               |	-1 * ОтчетПоКассовойСменеОтменаРаботыУслуги.Количество,
		               |	ОтчетПоКассовойСменеОтменаРаботыУслуги.Цена,
		               |	-1 * ОтчетПоКассовойСменеОтменаРаботыУслуги.Сумма,
		               |	ОтчетПоКассовойСменеОтменаРаботыУслуги.СтавкаНДС,
		               |	-1 * ОтчетПоКассовойСменеОтменаРаботыУслуги.СуммаНДС,
		               |	-1 * ОтчетПоКассовойСменеОтменаРаботыУслуги.Всего
		               |ИЗ
		               |	Документ.ОтчетПоКассовойСмене.ОтменаРаботыУслуги КАК ОтчетПоКассовойСменеОтменаРаботыУслуги
		               |ГДЕ
		               |	ОтчетПоКассовойСменеОтменаРаботыУслуги.Ссылка = &ОтчетПоКассовойСмене
		               |	И ОтчетПоКассовойСменеОтменаРаботыУслуги.ЭтоРозничныйПокупатель = ИСТИНА
					   |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РезультатыПродаж.Номенклатура КАК Номенклатура,
		               |	СУММА(РезультатыПродаж.Количество) КАК Количество,
		               |	РезультатыПродаж.Цена КАК Цена,
		               |	СУММА(РезультатыПродаж.Сумма) КАК Сумма,
		               |	РезультатыПродаж.СтавкаНДС КАК СтавкаНДС,
		               |	СУММА(РезультатыПродаж.СуммаНДС) КАК СуммаНДС,
		               |	СУММА(РезультатыПродаж.Всего) КАК Всего,
		               |	ЕПСБУ.Ссылка КАК СчетУчета
		               |ПОМЕСТИТЬ РезультатыПродажИСчетаУчета
		               |ИЗ
		               |	РезультатыПродаж КАК РезультатыПродаж
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
		               |		ПО РезультатыПродаж.Номенклатура = СпрНоменклатура.Ссылка
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	РезультатыПродаж.Номенклатура,
		               |	РезультатыПродаж.СтавкаНДС,
		               |	ЕПСБУ.Ссылка,
		               |	РезультатыПродаж.Цена
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РезультатыПродажИСчетаУчета.Номенклатура КАК Номенклатура,
		               |	РезультатыПродажИСчетаУчета.Количество КАК Количество,
		               |	РезультатыПродажИСчетаУчета.Цена КАК Цена,
		               |	РезультатыПродажИСчетаУчета.Сумма КАК Сумма,
		               |	РезультатыПродажИСчетаУчета.СтавкаНДС КАК СтавкаНДС,
		               |	РезультатыПродажИСчетаУчета.СуммаНДС КАК СуммаНДС,
		               |	РезультатыПродажИСчетаУчета.Всего КАК Всего,
		               |	РезультатыПродажИСчетаУчета.СчетУчета КАК СчетУчета
		               |ИЗ
		               |	РезультатыПродажИСчетаУчета КАК РезультатыПродажИСчетаУчета
		               |ГДЕ
		               |	РезультатыПродажИСчетаУчета.Количество <> 0";
		
		Запрос.УстановитьПараметр("ОтчетПоКассовойСмене", Основание);
		Запрос.УстановитьПараметр("ВалютаДокумента", ВалютаРубли);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаШапка	= РезультатЗапроса[0].Выгрузить();
		ВыборкаУслуги	= РезультатЗапроса[3].Выгрузить();
		
		ЗаполнитьЗначенияСвойств(Объект, ВыборкаШапка[0]);
		Объект.УслугиОказанные.Загрузить(ВыборкаУслуги);
		Объект.СуммаДокумента = ВыборкаУслуги.Итог("Всего");
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

Процедура ДобавитьДвиженияАгентскиеУслуги(ТаблицыДляДвижений, ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	АктОбОказанииУслуг.Дата КАК Период,
	|	АктОбОказанииУслуг.Организация КАК Организация,
	|	АктОбОказанииУслугУслугиОказанные.Комитент КАК Контрагент,
	|	АктОбОказанииУслугУслугиОказанные.ДоговорКомитента КАК ДоговорКомитента,
	|	АктОбОказанииУслугУслугиОказанные.Номенклатура КАК Номенклатура,
	|	АктОбОказанииУслуг.Контрагент КАК Покупатель,
	|	АктОбОказанииУслуг.Дата КАК ДатаРеализации,
	|	АктОбОказанииУслуг.Ссылка КАК ДокументРасчетов,
	|	СУММА(АктОбОказанииУслугУслугиОказанные.Количество) КАК Количество,
	|	СУММА(АктОбОказанииУслугУслугиОказанные.Всего) КАК Выручка,
	|	СУММА(АктОбОказанииУслугУслугиОказанные.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК АктОбОказанииУслугУслугиОказанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	|		ПО АктОбОказанииУслугУслугиОказанные.Ссылка = АктОбОказанииУслуг.Ссылка
	|ГДЕ
	|	АктОбОказанииУслуг.Ссылка = &Ссылка
	|	И АктОбОказанииУслугУслугиОказанные.КомиссионнаяТорговля
	|
	|СГРУППИРОВАТЬ ПО
	|	АктОбОказанииУслугУслугиОказанные.Номенклатура,
	|	АктОбОказанииУслуг.Организация,
	|	АктОбОказанииУслугУслугиОказанные.Комитент,
	|	АктОбОказанииУслугУслугиОказанные.ДоговорКомитента,
	|	АктОбОказанииУслуг.Контрагент,
	|	АктОбОказанииУслуг.Дата,
	|	АктОбОказанииУслуг.Ссылка,
	|	АктОбОказанииУслуг.Дата";
	
	РеализованныеАгентскиеУслуги = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений.Вставить("РеализованныеТоварыКомитентов", РеализованныеАгентскиеУслуги);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
