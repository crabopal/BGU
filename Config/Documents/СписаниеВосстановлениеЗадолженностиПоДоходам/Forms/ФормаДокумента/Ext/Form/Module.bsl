Функция ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц);
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборСтрокВТаблицеЗадолженность()
	
	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("Контрагент", Неопределено);
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("Контрагент", ТекущиеДанные.Контрагент);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.Задолженность.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.Контрагент <> НовыйОтборСтрок.Контрагент Тогда
		Элементы.Задолженность.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыЛокальногоАкта()
	
	// Реквизиты локального акта, которым установлен порядок принятия решения.
	РеквизитыЛокальногоАкта = ОбщегоНазначенияБГУ.РеквизитыЛокальногоАктаПоУмолчанию("СписаниеВосстановлениеЗадолженностиПоДоходам", Объект.Организация);
	
	Если Объект.ВидЛокальногоАкта <> РеквизитыЛокальногоАкта.ВидЛокальногоАкта
	 ИЛИ Объект.НомерЛокальногоАкта <> РеквизитыЛокальногоАкта.НомерЛокальногоАкта
	 ИЛИ Объект.ДатаЛокальногоАкта <> РеквизитыЛокальногоАкта.ДатаЛокальногоАкта Тогда
		СообщатьОбИзмененииРеквизитовЛокальногоАкта = Истина;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыЛокальногоАкта);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВосстановлениеЗадолженностиПоДоходам(СтрокиРешенияОСписании)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Восстановление задолженности по доходам'");
	ИспользоватьУчетПоИФО = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
	
	// Проверим, что выбраны строки с одинаковым счетом и ИФО.
	ЭтоПерваяСтрока = Истина;
	НомераСтрокРешенияОСписании = Новый Массив;
	Для Каждого СтрокаРешенияОСписании Из СтрокиРешенияОСписании Цикл
		
		Если ТипЗнч(СтрокаРешенияОСписании) = Тип("Число") Тогда
			ДанныеСтроки = Объект.Задолженность.НайтиПоИдентификатору(СтрокаРешенияОСписании);
		Иначе
			ДанныеСтроки = СтрокаРешенияОСписании;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			ПредыдущийИФО = ДанныеСтроки.ИФО;
			ЭтоПерваяСтрока = Ложь;
		Иначе
			// Проверим, что выбраны строки с одинаковым ИФО.
			Если ИспользоватьУчетПоИФО И (ПредыдущийИФО <> ДанныеСтроки.ИФО) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями полей ИФО.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		НомераСтрокРешенияОСписании.Добавить(ДанныеСтроки.НомерСтроки);
		
	КонецЦикла;
	
	// Создание документа восстановления задолженности по доходам.
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("НомераСтрокРешенияОСписании", НомераСтрокРешенияОСписании);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаСервере
Функция СведенияОДоговорахСтудентов()
	
	ДоговорыВДокументе = Объект.Задолженность.Выгрузить().ВыгрузитьКолонку("Договор");
	
	Возврат РаботаСоСтудентами.СведенияОДоговорахСтудентов(ДоговорыВДокументе);
	
КонецФункции

&НаСервере
Функция ЗаполнитьСведенияОСтудентахПоУмолчанию()
	
	СведенияОДоговорахСтудентов = СведенияОДоговорахСтудентов();
	
	Для Каждого СтрокаЗадолженность Из Объект.Задолженность Цикл
		
		ОтборПоДоговору = Новый Структура("Договор", СтрокаЗадолженность.Договор);
		НайденныеСтроки = СведенияОДоговорахСтудентов.НайтиСтроки(ОтборПоДоговору);
		
		Если НайденныеСтроки.Количество() = 1 Тогда // Единственный вариант.
			
			СведенияОДоговоре = НайденныеСтроки[0];
			Если Не СведенияОДоговоре.ЭтоДоговорСтудентаЗаПрочиеУслуги Тогда // За услуги образования.
				ЗаполнитьЗначенияСвойств(СтрокаЗадолженность, СведенияОДоговоре, "Студент,Факультет");
			Иначе // За прочие услуги.
				ЗаполнитьЗначенияСвойств(СтрокаЗадолженность, СведенияОДоговоре, "Студент,Факультет,НачислениеЗаУслугу");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(ТолькоВВыделенныхСтроках)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачальныеЗначения = Новый Структура(
		"СлучайСписанияВосстановленияЗадолженности,
		|МерыПоВзысканиюЗадолженности,
		|КодФормыБухгалтерскойОтчетности,
		|ОснованиеВозникновенияЗадолженности,
		|ОснованиеВозникновенияЗадолженностиНомер,
		|ОснованиеВозникновенияЗадолженностиДата,
		|ОснованиеПризнанияСомнительнойЗадолженности,
		|ОснованиеПризнанияСомнительнойЗадолженностиНомер,
		|ОснованиеПризнанияСомнительнойЗадолженностиДата");
	ЗаполнитьЗначенияСвойств(НачальныеЗначения, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	ПараметрыФормы.Вставить("ВидОперации", Объект.ВидОперации);
	ПараметрыФормы.Вставить("ТолькоВВыделенныхСтроках", ТолькоВВыделенныхСтроках);
	ПараметрыФормы.Вставить("СписокВыбораКодФормыБухОтчетности", Элементы.ЗадолженностьКодФормыБухгалтерскойОтчетности.СписокВыбора.Скопировать());
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТолькоВВыделенныхСтроках", ТолькоВВыделенныхСтроках);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ТолькоВВыделенныхСтроках")
		И ДополнительныеПараметры.ТолькоВВыделенныхСтроках Тогда
		
		Для Каждого ИдентификаторСтроки Из Элементы.Задолженность.ВыделенныеСтроки Цикл
			ТекущиеДанные = Объект.Задолженность.НайтиПоИдентификатору(ИдентификаторСтроки);
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
		КонецЦикла;
		
	Иначе // Во всех строках.
		
		Для Каждого СтрокаЗадолженность Из Объект.Задолженность Цикл
			ЗаполнитьЗначенияСвойств(СтрокаЗадолженность, Результат);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

