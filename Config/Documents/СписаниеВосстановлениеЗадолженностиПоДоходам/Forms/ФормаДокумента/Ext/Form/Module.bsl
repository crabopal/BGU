&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаИтогов = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	
	ЗаполнитьСписокВыбораКодФормыБухгалтерскойОтчетности();
	ЗадолженностьЗаполнитьДобавленныеКолонки();
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоСписаниеСомнительнойЗадолженности = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности"));
	ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЗадолженностьСчетСписания", "Видимость", Не ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЗадолженностьКЭК", "Видимость", ЭтоСписаниеСомнительнойЗадолженности ИЛИ ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	
	ОснованиеПризнанияСомнительнойЗадолженности = Новый Массив;
	ОснованиеПризнанияСомнительнойЗадолженности.Добавить("ЗадолженностьОснованиеПризнанияСомнительнойЗадолженности");
	ОснованиеПризнанияСомнительнойЗадолженности.Добавить("ЗадолженностьОснованиеПризнанияСомнительнойЗадолженностиНомер");
	ОснованиеПризнанияСомнительнойЗадолженности.Добавить("ЗадолженностьОснованиеПризнанияСомнительнойЗадолженностиДата");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОснованиеПризнанияСомнительнойЗадолженности, "Видимость", Не ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЗадолженностьМерыПоВзысканиюЗадолженности", "Видимость", ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЗадолженностьКодФормыБухгалтерскойОтчетности", "Видимость", ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	
	// По расчетам со студентами отражаем при признании задолженности безнадежной к взысканию.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОтразитьПоРасчетамСоСтудентами", "Видимость", ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности);
	
	РасчетыСоСтудентами = Новый Массив;
	РасчетыСоСтудентами.Добавить("ЗадолженностьСтудент");
	РасчетыСоСтудентами.Добавить("ЗадолженностьФакультет");
	РасчетыСоСтудентами.Добавить("ЗадолженностьНачислениеЗаУслугу");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РасчетыСоСтудентами, "Видимость", ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности И Объект.ОтразитьПоРасчетамСоСтудентами);
	
	КомандыВосстановитьЗадолженность = Новый Массив;
	КомандыВосстановитьЗадолженность.Добавить("ЗадолженностьВосстановитьЗадолженностьВоВсехСтроках");
	КомандыВосстановитьЗадолженность.Добавить("ЗадолженностьВосстановитьЗадолженностьВВыделенныхСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КомандыВосстановитьЗадолженность, "Видимость", ЭтоСписаниеСомнительнойЗадолженности);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Валютные суммы.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьОстатокСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьСписатьСуммаВал");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Валюта", ВидСравненияКомпоновкиДанных.Равно,
			ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Решение сотрудника.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	// Расчеты со студентами.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьСтудент");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ЭтоДоговорСтудента", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<не требуется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьСтудент");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ЭтоДоговорСтудента", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Студент", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<не выбран>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьФакультет");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ЭтоДоговорСтудента", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьНачислениеЗаУслугу");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ЭтоДоговорСтудентаЗаПрочиеУслуги", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ЗадолженностьПоляАналитикиСчета());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораКодФормыБухгалтерскойОтчетности()
	
	ЭтоКазенноеУчреждение = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение;
	
	СписокВыбораКодФормыБухОтчетности = Элементы.ЗадолженностьКодФормыБухгалтерскойОтчетности.СписокВыбора;
	СписокВыбораКодФормыБухОтчетности.Очистить();
	Если ЭтоКазенноеУчреждение Тогда
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Сведения по дебиторской и кредиторской задолженности (ф. 0503169)'"));
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Сведения о государственном (муниципальном) долге, предоставленных бюджетных кредитах (ф. 0503172)'"));
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Справка о наличии имущества и обязательств на забалансовых счетах (ф. 0503130)'"));
	Иначе
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Сведения по дебиторской и кредиторской задолженности (ф. 0503769)'"));
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Сведения о суммах заимствований (ф. 0503772)'"));
		СписокВыбораКодФормыБухОтчетности.Добавить(НСтр("ru='Справка о наличии имущества и обязательств на забалансовых счетах (ф. 0503730)'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Отказ = Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьПоДаннымУчета(Объект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ОтразитьПоРасчетамСоСтудентами Тогда
		ЗаполнитьСведенияОСтудентахПоУмолчанию();
	КонецЕсли;
	
	ЗадолженностьЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

