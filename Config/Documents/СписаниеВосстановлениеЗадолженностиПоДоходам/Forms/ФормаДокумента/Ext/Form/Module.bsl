Процедура ЗадолженностьСписатьСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = ТекущиеДанные.ВалютаРеглУчета Тогда
		ТекущиеДанные.СписатьСуммаВал = ТекущиеДанные.СписатьСумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗадолженностьПоляАналитикиСчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение",
		"Объект.Задолженность.Счет",
		"Объект.Задолженность.КПС",
		"Объект.Задолженность.Подразделение");

КонецФункции

&НаСервере
Процедура ЗадолженностьЗаполнитьДобавленныеКолонки()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	Если Объект.ОтразитьПоРасчетамСоСтудентами Тогда
		СведенияОДоговорахСтудентов = СведенияОДоговорахСтудентов();
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		Если Объект.ОтразитьПоРасчетамСоСтудентами Тогда
			
			ОтборПоДоговору = Новый Структура("Договор", СтрокаТаблицы.Договор);
			НайденныеСтроки = СведенияОДоговорахСтудентов.НайтиСтроки(ОтборПоДоговору);
			
			СтрокаТаблицы.ЭтоДоговорСтудента = (НайденныеСтроки.Количество() > 0);
			Если СтрокаТаблицы.ЭтоДоговорСтудента Тогда
				СтрокаТаблицы.ЭтоДоговорСтудентаЗаПрочиеУслуги = НайденныеСтроки[0].ЭтоДоговорСтудентаЗаПрочиеУслуги;
			Иначе
				СтрокаТаблицы.ЭтоДоговорСтудентаЗаПрочиеУслуги = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.Счет);
		Если СвойстваСчетаУчета.Забалансовый Тогда // Счет 04 "Сомнительная задолженность".
			СтрокаТаблицы.КЭКУчета = Строка(СтрокаТаблицы.КЭК);
		ИначеЕсли СвойстваСчетаУчета.БезДетализацииКОСГУ Тогда
			СтрокаТаблицы.КЭКУчета = "000";
		Иначе
			СтрокаТаблицы.КЭКУчета = "00" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Контрагент, "ТипКонтрагента.Код");
		КонецЕсли;
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.Счет, ЗадолженностьПоляАналитикиСчета());
		
		ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

