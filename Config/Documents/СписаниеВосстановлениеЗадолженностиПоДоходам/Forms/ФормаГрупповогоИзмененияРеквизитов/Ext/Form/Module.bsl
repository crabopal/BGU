#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("НачальныеЗначения") И Параметры.Свойство("ВидОперации") Тогда
		
		НачальныеЗначения = Параметры.НачальныеЗначения;
		ЗаполнитьСтрокиТаблицы(НачальныеЗначения, Параметры.ВидОперации);
		
		ЗначениеСвойства = Неопределено;
		Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
			Если НачальныеЗначения.Свойство(СтрокаТаблицы.ИмяРеквизита, ЗначениеСвойства) Тогда
				СтрокаТаблицы.ЗначениеРеквизита = ЗначениеСвойства;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Параметры.Свойство("СписокВыбораКодФормыБухОтчетности") Тогда
		КодыФормБухОтчетности = Параметры.СписокВыбораКодФормыБухОтчетности;
	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоВВыделенныхСтроках") И Параметры.ТолькоВВыделенныхСтроках Тогда
		Заголовок = НСтр("ru='Изменить реквизиты в выделенных строках'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТаблицаРеквизитов", "Подсказка",
			НСтр("ru='В выделенных строках документа будут установлены значения реквизитов, которые отмечены флажком.'"));
	Иначе
		Заголовок = НСтр("ru='Изменить реквизиты во всех строках'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТаблицаРеквизитов", "Подсказка",
			НСтр("ru='Во всех строках документа будут установлены значения реквизитов, которые отмечены флажком.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаРеквизитов

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ТекущиеДанные.ИзменятьРеквизит = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "КодФормыБухгалтерскойОтчетности" Тогда
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ЗначениеРеквизитаПослеВыбора", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, КодыФормБухОтчетности, Элемент, );
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ИзменятьРеквизит = Истина;
		
		Если Результат <> Неопределено Тогда
			Если ТекущиеДанные.ИмяРеквизита = "КодФормыБухгалтерскойОтчетности" Тогда
				ТекущиеДанные.ЗначениеРеквизита = СокрЛП(Результат.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВозвращаемоеЗначение = Новый Структура;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если СтрокаТаблицы.ИзменятьРеквизит Тогда
			ВозвращаемоеЗначение.Вставить(СтрокаТаблицы.ИмяРеквизита, СтрокаТаблицы.ЗначениеРеквизита);
		КонецЕсли;
	
	КонецЦикла;
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтрокиТаблицы(НачальныеЗначения, ВидОперации)

	ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности = (ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности"));
	
	Если НачальныеЗначения.Свойство("СлучайСписанияВосстановленияЗадолженности") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "СлучайСписанияВосстановленияЗадолженности";
		НоваяСтрока.ПредставлениеРеквизита = "Случай списания (восстановления) задолженности";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("СправочникСсылка.СлучаиСписанияВосстановленияЗадолженностиПоДоходам");
	КонецЕсли;
	
	Если ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности
		И НачальныеЗначения.Свойство("МерыПоВзысканиюЗадолженности") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "МерыПоВзысканиюЗадолженности";
		НоваяСтрока.ПредставлениеРеквизита = "Меры по взысканию задолженности";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("СправочникСсылка.МерыПоВзысканиюЗадолженности");
	КонецЕсли;
	
	Если ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности
		И НачальныеЗначения.Свойство("КодФормыБухгалтерскойОтчетности") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "КодФормыБухгалтерскойОтчетности";
		НоваяСтрока.ПредставлениеРеквизита = "Код формы бухгалтерской (бюджетной) отчетности";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	// Основание возникновения задолженности (документ, номер, дата).
	Если НачальныеЗначения.Свойство("ОснованиеВозникновенияЗадолженности") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеВозникновенияЗадолженности";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание возникновения задолженности";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Если НачальныеЗначения.Свойство("ОснованиеВозникновенияЗадолженностиНомер") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеВозникновенияЗадолженностиНомер";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание возникновения задолженности, номер";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Если НачальныеЗначения.Свойство("ОснованиеВозникновенияЗадолженностиДата") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеВозникновенияЗадолженностиДата";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание возникновения задолженности, дата";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата));
	КонецЕсли;
	
	// Основание признания (восстановления) сомнительной задолженности (документ, номер, дата).
	Если НЕ ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности
		И НачальныеЗначения.Свойство("ОснованиеПризнанияСомнительнойЗадолженности") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеПризнанияСомнительнойЗадолженности";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание признания (восстановления) сомнительной задолженности";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Если НЕ ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности
		И НачальныеЗначения.Свойство("ОснованиеПризнанияСомнительнойЗадолженностиНомер") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеПризнанияСомнительнойЗадолженностиНомер";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание признания (восстановления) сомнительной задолженности, номер";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Если НЕ ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности
		И НачальныеЗначения.Свойство("ОснованиеПризнанияСомнительнойЗадолженностиДата") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ОснованиеПризнанияСомнительнойЗадолженностиДата";
		НоваяСтрока.ПредставлениеРеквизита = "Документ-основание признания (восстановления) сомнительной задолженности, дата";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

