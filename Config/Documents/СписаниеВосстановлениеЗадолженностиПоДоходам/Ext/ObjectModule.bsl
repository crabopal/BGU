#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование);
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризацияРасчетовСКонтрагентами") Тогда
				Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьНаОснованииИнвентаризацииРасчетовСКонтрагентами(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.ВидОперации, ДанныеЗаполнения.НомераСтрокИнвентаризации);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризацияРасчетовПоПоступлениям") Тогда
				Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьНаОснованииИнвентаризацииРасчетовПоПоступлениям(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.ВидОперации, ДанныеЗаполнения.НомераСтрокИнвентаризации);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеВосстановлениеЗадолженностиПоДоходам") Тогда
				Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьНаОснованииРешенияОПризнанииСомнительнойЗадолженности(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.НомераСтрокРешенияОСписании);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
				Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовПоПоступлениям(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.ВидОперации, ДанныеЗаполнения.НомераСтрокИнвентаризации, ДанныеЗаполнения.ВидСуммы);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
				Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовСКонтрагентами(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.ВидОперации, ДанныеЗаполнения.НомераСтрокИнвентаризации);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеЗаполнения = Неопределено Или ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ОбщегоНазначенияБГУ.ЗаполнитьРеквизитыЛокальногоАкта(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ДокументОснование)
		И Дата < ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Дата") Тогда
		ТекстСообщения = СтрШаблон("Дата документа установлена ранее даты документа-основания: %1
			|Это корректно только в случае отражения отклонений при инвентаризации согласно положениям Стандарта ""События после отчетной даты"".", ДокументОснование);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Дата", "Объект");
	КонецЕсли;
	
	Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ПроверитьСоответствиеИнвентаризационнойОписиРасчетов(Ссылка, ДокументОснование);
	
	ИспользоватьУчетСтудентов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов");
	Если ИспользоватьУчетСтудентов И ОтразитьПоРасчетамСоСтудентами Тогда
		
		ДоговорыУчащихсяЗаПрочиеУслуги = Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ДоговорыУчащихсяЗаПрочиеУслуги(Ссылка);
		
		Для Каждого СтрокаТаблицы Из Задолженность Цикл
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.Студент) Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Факультет) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Факультет'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Задолженность'"));
					ПолеОшибки = "Задолженность[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Факультет";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если ДоговорыУчащихсяЗаПрочиеУслуги.Найти(СтрокаТаблицы.Договор) <> Неопределено Тогда // За прочие услуги.
					
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.НачислениеЗаУслугу) Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
							НСтр("ru = 'Прочие услуги'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Задолженность'"));
						ПолеОшибки = "Задолженность[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].НачислениеЗаУслугу";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РеквизитыСчетаУчетаЗадолженности = Новый Структура("Счет, КПС, Подразделение",
		"Счет", "КПС", "Подразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчетаЗадолженности,
		ЭтотОбъект, "Задолженность", Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности =
		(ВидОперации = Перечисления.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности);
	Если Не ЭтоСписаниеБезнадежнойКВзысканиюЗадолженности Тогда
		ОтразитьПоРасчетамСоСтудентами = Ложь; // По расчетам со студентами отражаем при признании задолженности безнадежной к взысканию.
	КонецЕсли;
	
	СуммаДокумента = Задолженность.Итог("СписатьСумма");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
