#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура СформироватьОписаниеДокументовСТабличнымиЧастями(Форма, Описание) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "СписокКонтрагентов", "СписокКонтрагентовКонтрагент", "");

КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата,Номер");
	
	ИспользоватьУчетСтудентов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИспользоватьУчетСтудентов", ИспользоватьУчетСтудентов);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("Задолженность", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задолженность.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Задолженность.Ссылка.Дата КАК Период,
	|	Задолженность.Ссылка.Организация КАК Организация,
	|	Задолженность.Факультет КАК Факультет,
	|	Задолженность.Студент КАК Студент,
	|	Задолженность.Контрагент КАК Контрагент,
	|	Задолженность.Договор КАК ДоговорКонтрагента,
	|	Задолженность.Валюта КАК ВалютаВзаиморасчетов,
	|	Задолженность.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
	|	ВЫБОР
	|		КОГДА Задолженность.Валюта = &ВалютаРеглУчета
	|				ИЛИ Задолженность.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА Задолженность.СписатьСумма
	|		ИНАЧЕ Задолженность.СписатьСуммаВал
	|	КОНЕЦ КАК СуммаВзаиморасчетов,
	|	Задолженность.СписатьСумма КАК СуммаРегл
	|ИЗ
	|	Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.Задолженность КАК Задолженность
	|ГДЕ
	|	Задолженность.Ссылка = &Ссылка
	|	И &ИспользоватьУчетСтудентов
	|	И Задолженность.Ссылка.ОтразитьПоРасчетамСоСтудентами
	|	И Задолженность.Студент <> ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(ДокументСсылка);
	
	Если ИспользоватьУчетСтудентов Тогда
		
		РасчетыСоСтудентами = РегистрыНакопления.РасчетыСоСтудентами.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		РасчетыСоСтудентамиДопУслуги = РегистрыНакопления.РасчетыСоСтудентамиДопУслуги.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		ДоговорыУчащихсяЗаПрочиеУслуги = Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ДоговорыУчащихсяЗаПрочиеУслуги(ДокументСсылка);
		
		Задолженность = Результат[НомераТаблиц.Задолженность].Выгрузить();
		Для Каждого СтрокаЗадолженности Из Задолженность Цикл
			
			РезультатГолосования = РезультатыГолосования.Найти(СтрокаЗадолженности.ИдентификаторСтроки, "ИдентификаторСтроки");
			Если РезультатГолосования = Неопределено ИЛИ Не РезультатГолосования.РезолюцияКомиссииОдобрена Тогда
				Продолжить; // Движения формируются только по строкам, одобренным комиссией в результате голосования, как и бух.записи.
			КонецЕсли;
			
			Если ДоговорыУчащихсяЗаПрочиеУслуги.Найти(СтрокаЗадолженности.ДоговорКонтрагента) = Неопределено Тогда // За услуги образования.
				
				НоваяСтрока = РасчетыСоСтудентами.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗадолженности,
					"Период,Организация,Факультет,Студент,Контрагент,ДоговорКонтрагента,ВалютаВзаиморасчетов,СуммаВзаиморасчетов,СуммаРегл");
				
			Иначе // За прочие услуги.
				
				НоваяСтрока = РасчетыСоСтудентамиДопУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗадолженности,
					"Период,Организация,Факультет,Студент,Контрагент,ДоговорКонтрагента,ВалютаВзаиморасчетов,НачислениеЗаУслугу,СуммаВзаиморасчетов,СуммаРегл");
				
			КонецЕсли;
			
		КонецЦикла;
		
		ВидПервичногоДокумента = НСтр("ru = 'Акт о признании безнадежной к взысканию задолженности по доходам'");
		НомерПервичногоДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер);
		ДатаПервичногоДокумента = ЗначенияРеквизитов.Дата;
		
		РасчетыСоСтудентами.ЗаполнитьЗначения(Истина, "Активность");
		РасчетыСоСтудентами.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
		РасчетыСоСтудентами.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход, "ВидДвижения");
		РасчетыСоСтудентами.ЗаполнитьЗначения(ВидПервичногоДокумента, "ВидПервичногоДокумента");
		РасчетыСоСтудентами.ЗаполнитьЗначения(НомерПервичногоДокумента, "НомерПервичногоДокумента");
		РасчетыСоСтудентами.ЗаполнитьЗначения(ДатаПервичногоДокумента, "ДатаПервичногоДокумента");
		ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("РасчетыСоСтудентами", РасчетыСоСтудентами);
		
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(Истина, "Активность");
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход, "ВидДвижения");
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(ВидПервичногоДокумента, "ВидПервичногоДокумента");
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(НомерПервичногоДокумента, "НомерПервичногоДокумента");
		РасчетыСоСтудентамиДопУслуги.ЗаполнитьЗначения(ДатаПервичногоДокумента, "ДатаПервичногоДокумента");
		ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("РасчетыСоСтудентамиДопУслуги", РасчетыСоСтудентамиДопУслуги);
		
	КонецЕсли;
	
	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

// Для списка договоров в документе возвращает массив договоров с учащимися за прочие услуги.
// Договоры за прочие услуги определяются по наличию движений в регистре РасчетыСоСтудентамиДопУслуги.
//
Функция ДоговорыУчащихсяЗаПрочиеУслуги(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетыСоСтудентамиДопУслуги.ДоговорКонтрагента КАК Договор
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентамиДопУслуги КАК РасчетыСоСтудентамиДопУслуги
	|ГДЕ
	|	РасчетыСоСтудентамиДопУслуги.ДоговорКонтрагента В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Задолженность.Договор
	|			ИЗ
	|				Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.Задолженность КАК Задолженность
	|			ГДЕ
	|				Задолженность.Ссылка = &Ссылка
	|				И Задолженность.Студент <> ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка))";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Договор");
	
КонецФункции

// Проверяет данные в документе списания задолженности на соответствие инвентаризационной описи расчетов.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.СписаниеВосстановлениеЗадолженностиПоДоходам, ДокументСсылка.СписаниеКредиторскойЗадолженности - ссылка на документ списания задолженности,
//  ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям, ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами - ссылка на инв.опись,
//  Отказ - Булево - признак блокирования проведения документа при обнаружении ошибок.
//
// Возвращаемое значение:
//  Структура - результат проверки соответствия документа списания задолженности инвентаризационной описи расчетов^:
//      Отказ - Булево - признак обнаружения ошибок при проверке.
//      СообщенияПользователю - Массив - сообщения об ошибках пользователю.
//
Функция ПроверитьСоответствиеИнвентаризационнойОписиРасчетов(ДокументСсылка, ДокументОснование, Отказ = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Отказ);
	Результат.Вставить("СообщенияПользователю", Новый Массив);
	
	Если ЗначениеЗаполнено(ДокументОснование)
		И ( ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") ) Тогда
		
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеВосстановлениеЗадолженностиПоДоходам") Тогда
			ИмяТабЧасти = "Раздел21"; // Дебиторская задолженность.
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеКредиторскойЗадолженности") Тогда
			ИмяТабЧасти = "Раздел22"; // Кредиторская задолженность.
		Иначе
			Возврат Результат;
		КонецЕсли;
		
		ТаблицаИнвОписи = ДокументОснование[ИмяТабЧасти].Выгрузить(, "Контрагент,Договор,Счет");
		
		Для Каждого СтрокаЗадолженность Из ДокументСсылка["Задолженность"] Цикл
			
			Отбор = Новый Структура;
			Если ЗначениеЗаполнено(СтрокаЗадолженность.Счет) Тогда
				Отбор.Вставить("Счет", СтрокаЗадолженность.Счет);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаЗадолженность.Контрагент) Тогда
				Отбор.Вставить("Контрагент", СтрокаЗадолженность.Контрагент);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаЗадолженность.Договор) Тогда
				Отбор.Вставить("Договор", СтрокаЗадолженность.Договор);
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаИнвОписи.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда 
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='В инвентаризационной описи ""%1"" отсутствуют данные о задолженности по счету %2, контрагенту ""%3"", договору ""%4"".'"),
						ДокументОснование,
						Отбор.Счет,
						Отбор.Контрагент,
						Отбор.Договор);
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Счет'"), СтрокаЗадолженность.НомерСтроки, НСтр("ru = 'Задолженность'"), ТекстСообщения);
				ПолеОшибки = "Задолженность[" + Формат(СтрокаЗадолженность.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Счет";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, ПолеОшибки, "Объект", Отказ);
				
				Результат.СообщенияПользователю.Добавить(ТекстСообщения);
				Результат.Отказ = Отказ;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ГруппаГолосование");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьИтогГолосования");
	ЭлементыГолосование.Добавить("ЗадолженностьРезолюцияКомиссииОдобрена");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования ИЛИ Объект.Проведен);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Решение о признании (восстановлении) сомнительной задолженности по доходам (ф.0510445).
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор       = "СписаниеСомнительнойЗадолженности_Форма0510445";
	КомандаПечати.Представление       = НСтр("ru = 'Решение о признании сомнительной задолженности по доходам (ф.0510445)'");
	КомандаПечати.МенеджерПечати      = "Документ.СписаниеВосстановлениеЗадолженностиПоДоходам";
	КомандаПечати.Порядок             = 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВидОперации",
		Перечисления.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор       = "ВосстановлениеСомнительнойЗадолженности_Форма0510445";
	КомандаПечати.Представление       = НСтр("ru = 'Решение о восстановлении сомнительной задолженности по доходам (ф.0510445)'");
	КомандаПечати.МенеджерПечати      = "Документ.СписаниеВосстановлениеЗадолженностиПоДоходам";
	КомандаПечати.Порядок             = 2;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВидОперации",
		Перечисления.ВидыОперацийСписанияЗадолженностиПоДоходам.ВосстановлениеСомнительнойЗадолженности);
	
	// Акт о признании безнадежной к взысканию задолженности по доходам (ф.0510436).
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор       = "СписаниеБезнадежнойКВзысканиюЗадолженности_Форма0510436";
	КомандаПечати.Представление       = НСтр("ru = 'Акт о признании безнадежной к взысканию задолженности по доходам (ф.0510436)'");
	КомандаПечати.МенеджерПечати      = "Документ.СписаниеВосстановлениеЗадолженностиПоДоходам";
	КомандаПечати.Порядок             = 3;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВидОперации",
		Перечисления.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеСомнительнойЗадолженности_Форма0510445") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"СписаниеСомнительнойЗадолженности_Форма0510445",
			"Решение о признании сомнительной задолженности по доходам (ф.0510445)",
			ПечатьФормы0510445(МассивОбъектов, ОбъектыПечати, 1));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ВосстановлениеСомнительнойЗадолженности_Форма0510445") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ВосстановлениеСомнительнойЗадолженности_Форма0510445",
			"Решение о восстановлении сомнительной задолженности по доходам (ф.0510445)",
			ПечатьФормы0510445(МассивОбъектов, ОбъектыПечати, 2));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеБезнадежнойКВзысканиюЗадолженности_Форма0510436") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"СписаниеБезнадежнойКВзысканиюЗадолженности_Форма0510436",
			"Решение о признании безнадежной к взысканию задолженности по доходам (ф.0510436)",
			ПечатьФормы0510436(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьФормы0510445(МассивОбъектов, ОбъектыПечати, КодОперации)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.ПФ_MXL_Ф0510445");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб				= Истина;
	ТабДокумент.ОриентацияСтраницы		= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_СписаниеВосстановлениеЗадолженностиПоДоходам_ф0510445";
	
	ДанныеДляПечати = ПолучитьДанныеДляПечати(МассивОбъектов);
	ВыборкаШапка = ДанныеДляПечати.Шапка.Выбрать();
	ВыборкаСписокКонтрагентов = ДанныеДляПечати.СписокКонтрагентов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЗадолженность = ДанныеДляПечати.Задолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл // Цикл по документам.
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбщиеСведенияПоДокументу = ДанныеДляПечати.ОбщиеСведения.Получить(ВыборкаШапка.Ссылка);
		
		ВывестиШапку(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу, КодОперации);
		ВывестиРаздел1РеквизитыКонтрагента(Макет, ТабДокумент, ВыборкаШапка, ВыборкаСписокКонтрагентов);
		ВывестиРаздел2СведенияОЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность);
		ВывестиРаздел3ЗаключениеКомиссии(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность, ДанныеДляПечати.РезультатыГолосования);
		ВывестиПодвал(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу, ДанныеДляПечати.СоставКомиссий);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
		
	КонецЦикла;
	
	ТабДокумент.ВерхнийКолонтитул.Выводить			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа		= НСтр("ru='Форма 0510445 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

