&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭлектроннойПочты = РезультатОткрытияФормы.Email;
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонSMS = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			ТелефонSMS = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, ТелефонSMS, ТелефонСтрокой);
			АбонентскийНомерТелефона = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭлектроннойПочты = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ТелефонSMS = 0;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаИсправляемыйЧекККМ", "Видимость", Объект.ВидОперации =
		Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаИсправительныйЧекККМ", "Видимость", Объект.ВидОперации =
		Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаКассовыйЧекКоррекции", "Видимость", Объект.ВидОперации =
		Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДокументыОснования", "Видимость", Объект.ВидОперации =
		Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ФискальныйПризнакИсправляемогоЧекаККМ", "ТолькоПросмотр", ЗначениеЗаполнено(Объект.ИдентификаторЗаписиФискальнойОперации));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВыбратьЧекККМИзСписка", "Видимость", Объект.ЧекИзРеестраПлатежей);
	
	Если Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ Тогда
		ТолькоПросмотрСуммыЧекаККМ = Истина;	
	Иначе
		ТолькоПросмотрСуммыЧекаККМ = Ложь;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ВидимостьРеквизитовЧекаККМ = ?(Объект.НомерИсправляемогоЧекаККМ = 0, Ложь, Истина);
		ТолькоПросмотрРеквизитовЧекаККМ = Истина;
		ВидимостьДопРеквизитовЧекаККМ = Ложь;
		ВидимостьНезаполненныхРеквизитовОплаты = Ложь;
	Иначе
		ВидимостьРеквизитовЧекаККМ = Истина;
		ТолькоПросмотрРеквизитовЧекаККМ = Ложь;
		ВидимостьДопРеквизитовЧекаККМ = Истина;
		ВидимостьНезаполненныхРеквизитовОплаты = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаДокумента", "ТолькоПросмотр", ТолькоПросмотрСуммыЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаОплата", "ТолькоПросмотр", ТолькоПросмотрСуммыЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТипРасчетаИсправляемогоЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТипРасчетаИсправляемогоЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДатаИсправляемогоЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДатаИсправляемогоЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НомерИсправляемогоЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НомерИсправляемогоЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаИсправляемогоЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаИсправляемогоЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаНаличныеЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаНаличныеЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаЭлектронноЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаЭлектронноЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПостоплатаЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПостоплатаЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПредоплатаЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПредоплатаЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаВстречноеПредоставлениеЧекаККМ", "Видимость", ВидимостьРеквизитовЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаВстречноеПредоставлениеЧекаККМ", "ТолькоПросмотр", ТолькоПросмотрРеквизитовЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ФормаОплатыИсправляемогоЧекаККМ", "Видимость", ВидимостьДопРеквизитовЧекаККМ);
	
	Если Объект.ОплатаНаличные = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОплатаНаличныеЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	КонецЕсли;
	
	Если Объект.ОплатаЭлектронно = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОплатаЭлектронноЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	КонецЕсли;
	
	Если Объект.ОплатаПостоплата = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОплатаПостоплатаЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	КонецЕсли;
	
	Если Объект.ОплатаПредоплата = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОплатаПредоплатаЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	КонецЕсли;
	
	Если Объект.ОплатаВстречноеПредоставление = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОплатаВстречноеПредоставлениеЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНоменклатураЧекаККМ", "Видимость", ВидимостьНезаполненныхРеквизитовОплаты);
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ФормаНапечататьЧек", "Видимость", ?(НомерКассовогоЧека = 0, Истина, Ложь));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)
	Объект = Форма.Объект;
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)

	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если (НЕ ЗначениеЗаполнено(Объект.КассаККМ)) ИЛИ ИзмененаОрганизация Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
		Если ЗначениеЗаполнено(НастройкиОборудования.ФискальныйРегистратор) Тогда
			Объект.ТипЦены = НастройкиОборудования.ФискальныйРегистратор.ТипЦены;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОчиститьДанныеИсправляемогоЧекаККМ();
		УстановитьВидимостьЭлементовФормы();
		
		Возврат;
	КонецЕсли;	
	
	ТипДокумента = ПодключаемоеОборудованиеБГУВызовсервера.ТипДокумента(Объект.ДокументОснование);
	
	Если ТипДокумента = 14 Тогда
		Объект.ЧекИзРеестраПлатежей = Истина;
		
		НомерЧека = Объект.НомерИсправляемогоЧекаККМ;
		Если НомерЧека = 0 Тогда
			ОчиститьДанныеИсправляемогоЧекаККМ();
			
			УстановитьВидимостьЭлементовФормы();

			Возврат;
		Иначе	
			ОчиститьДанныеИсправляемогоЧекаККМ();
			
			ФискальнаяОперация = ПодключаемоеОборудованиеБГУ.ИсточникДанныхИсправляемогоЧекаККМ(Объект.ДокументОснование, НомерЧека);
		КонецЕсли;
	Иначе
		ОчиститьДанныеИсправляемогоЧекаККМ();
		
		Объект.ЧекИзРеестраПлатежей = Ложь;
		
		Если ТипДокумента = 5 ИЛИ ТипДокумента = 6 Тогда
			Объект.ТипЦены = Объект.ДокументОснование.ТипЦены;
		КонецЕсли;
		
		ФискальнаяОперация = ПодключаемоеОборудованиеБГУ.ИсточникДанныхИсправляемогоЧекаККМ(Объект.ДокументОснование);
	КонецЕсли;	
	
	Если ФискальнаяОперация.ИсточникДанных > 0 Тогда
		ДанныеЧекаККМ = ФискальнаяОперация.ДанныеЧекаККМ;
		Если ДанныеЧекаККМ <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Объект, ДанныеЧекаККМ);
			
			Объект.ИдентификаторЗаписиФискальнойОперации = ДанныеЧекаККМ.ИдентификаторЗаписи;
			Объект.НомерИсправляемогоЧекаККМ = ДанныеЧекаККМ.НомерЧекаККМ;
			Объект.ДатаИсправляемогоЧекаККМ = ДанныеЧекаККМ.ДатаЧекаККМ;
			Объект.СуммаИсправляемогоЧекаККМ = ДанныеЧекаККМ.СуммаЧекаККМ;
			Объект.ФискальныйПризнакИсправляемогоЧекаККМ = ДанныеЧекаККМ.ФискальныйПризнак;
			Объект.ТипРасчетаИсправляемогоЧекаККМ = ДанныеЧекаККМ.ТипРасчета;
			Объект.ТипРасчета = ПодключаемоеОборудованиеБГУВызовсервера.ОбратныйТипРасчета(Объект.ТипРасчетаИсправляемогоЧекаККМ);
			
			Объект.СуммаДокумента = Объект.СуммаИсправляемогоЧекаККМ;
			
			Объект.СуммаОплатыНаличными = Объект.ОплатаНаличные;
			Объект.СуммаОплатыЭлектронно = Объект.ОплатаЭлектронно;
			Объект.СуммаПредоплаты = Объект.ОплатаПредоплата;
			Объект.СуммаПостоплаты = Объект.ОплатаПостоплата;
			Объект.СуммаОплатыВстречнымПредоставлением = Объект.ОплатаВстречноеПредоставление;
			
		Иначе
			Если ТипДокумента = 5 ИЛИ ТипДокумента = 6 Тогда
				Объект.ФискальныйПризнакИсправляемогоЧекаККМ = Объект.ДокументОснование.ФискальныйПризнак;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	ПроверитьЗаполнениеДанныхИсправляемогоЧека();
	ВывестиПредставлениеЧекаККМ();
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	ДокументОснованиеПриИзмененииНаСервере();
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ВывестиПредставлениеЧекаККМ()
	ТекстСообщенияXML = Объект.ТекстовыеДанныеXML;
	
	Если ЗначениеЗаполнено(ТекстСообщенияXML) Тогда
		ПараметрыФорматирования = Новый ПараметрыЗаписиXML("UTF-8", "1.0", Истина, Истина, "  ");
		ТекстXML.УстановитьТекст(ФорматироватьXMLСПараметрами(ТекстСообщенияXML, ПараметрыФорматирования));
		
		ОбщиеПараметры = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ТекстСообщенияXML);
		ТекстЧекаККМ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоДокумента(0, ОбщиеПараметры, 48);
	ИначеЕсли ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ДанныеЧека = ПодключаемоеОборудованиеБГУ.ДанныеЧека(Объект.Ссылка);
		Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) Тогда
			ТекстСообщенияXMLЭтогоЧека = ДанныеЧека.ТекстовыеДанныеXML;
			ОбщиеПараметры = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ТекстСообщенияXMLЭтогоЧека);
			ОбщиеПараметры.ТипРасчета = ПодключаемоеОборудованиеБГУВызовСервера.ОбратныйТипРасчета(ОбщиеПараметры.ТипРасчета);
			ТекстЧекаККМ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоДокумента(0, ОбщиеПараметры, 48);
		Иначе	
			Если Объект.НомерИсправляемогоЧекаККМ <> 0 Тогда 
				ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаПоДокументуОснованию();
				
				ТекстЧекаККМ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 48);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Форматирует текст сообщения в формате XML
//
&НаСервере
Функция ФорматироватьXMLСПараметрами(ТекстСообщенияXML, ПараметрыФорматирования) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСообщенияXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ПараметрыФорматирования);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			Попытка
				СохраненныйТелефон = Число(АбонентскийНомерТелефона);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"АбонентскийНомерТелефона");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонSMS = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, ТелефонSMS, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧекаПоДокументуОснованию()
	Если Объект.ЧекИзРеестраПлатежей Тогда
		ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект.ДокументОснование, Объект.ДокументОснование, Объект.НомерИсправляемогоЧекаККМ);
	Иначе	
		ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект.ДокументОснование, Объект.ДокументОснование);
	КонецЕсли;
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека = 1)
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧекаКоррекции()
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧекаКоррекции(Объект, Объект.Ссылка);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаСервере
Процедура ОчиститьДанныеИсправляемогоЧекаККМ()
	Объект.ФискальныйПризнакИсправляемогоЧекаККМ = "";
	Объект.ТипРасчетаИсправляемогоЧекаККМ = "";
	Объект.НомерИсправляемогоЧекаККМ = 0;
	Объект.ДатаИсправляемогоЧекаККМ = Дата(1,1,1);
	Объект.СистемаНалогообложенияЧекаККМ = "";
	Объект.ПараметрыДоговораПлатежногоАгента = "";
	Объект.СуммаИсправляемогоЧекаККМ = 0;
	Объект.ОплатаНаличные = 0;
	Объект.ОплатаЭлектронно = 0;
	Объект.ОплатаПостоплата = 0;
	Объект.ОплатаПредоплата = 0;
	Объект.ОплатаВстречноеПредоставление = 0;
	Объект.ИдентификаторЗаписиФискальнойОперации = "";
	Объект.ТекстовыеДанныеXML = "";
	Объект.ТипРасчета = "";
	Объект.Контрагент = "";
	Объект.Договор = "";
	
	ТекстXML = "";
	ТекстЧекаККМ = "";
КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуЧековККМДляПлатежаВХранилище(МассивЧековОтбора)
	
	ТаблицаЧековККМ = Новый ТаблицаЗначений;
	ТаблицаЧековККМ.Колонки.Добавить("КлючЧека", Новый ОписаниеТипов("Строка"));
	ТаблицаЧековККМ.Колонки.Добавить("НомерЧекаККМ", Новый ОписаниеТипов("Число"));
	ТаблицаЧековККМ.Колонки.Добавить("ТекстОписанияЧекаККМ", Новый ОписаниеТипов("Строка"));

	Для каждого ТекКлючЧека Из МассивЧековОтбора Цикл
		ТекСтрока = ЧекККМПоКлючуЧека(ТекКлючЧека);
		ТекстОписанияЧекаККМ = ТекстОписанияЧекаККМ(ТекСтрока, ВалютаРубли);
		
		НоваяСтрока = ТаблицаЧековККМ.Добавить();
		НоваяСтрока.КлючЧека = ТекКлючЧека;
		НоваяСтрока.НомерЧекаККМ = ТекСтрока.НомерЧекаККМ;
		НоваяСтрока.ТекстОписанияЧекаККМ = ТекстОписанияЧекаККМ;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаЧековККМ);

КонецФункции

&НаСервере
Функция МассивЧековОтбора(ДокументПечатьЧековККМСписком)
	Результат = Новый Массив;
	
	Для каждого ТекСтрока Из ДокументПечатьЧековККМСписком.ЧекиККМ Цикл
		Если ТекСтрока.НомерЧекаККМ > 0 Тогда
			Результат.Добавить(ТекСтрока.КлючЧека);
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ТекстОписанияЧекаККМ(ТекЧекККМ, ВалютаРубли)
	Результат = "";
	
	ДанныеЧека = ПодключаемоеОборудованиеБГУ.ДанныеЧекаГруппыПлатежей(Объект.ДокументОснование, , ТекЧекККМ.НомерЧекаККМ);
	
	Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) Тогда
		Результат = " Чек ККМ № "+СокрЛП(ДанныеЧека.НомерЧекаККМ) + ", ФП "+СокрЛП(ДанныеЧека.ФискальныйПризнак) + ", " +
			ПодключаемоеОборудованиеБГУ.НаименованиеКонтрагентаПлательщика(ДанныеЧека.Контрагент)+" ("+Формат(ДанныеЧека.СуммаЧекаККМ, "ЧЦ=15; ЧДЦ=2")+" "+СокрЛП(ВалютаРубли)+")";
	Иначе	
		Результат = " Чек ККМ № "+СокрЛП(ТекЧекККМ.НомерЧекаККМ) + " " +
			ПодключаемоеОборудованиеБГУ.НаименованиеКонтрагентаПлательщика(ДанныеЧека.Контрагент)+" ("+Формат(ДанныеЧека.СуммаЧекаККМ, "ЧЦ=15; ЧДЦ=2")+" "+СокрЛП(ВалютаРубли)+")";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЧекККМПоКлючуЧека(КлючЧекаККМ)
	Результат = Новый Структура("КлючЧека, Сумма, ДатаЧекаККМ, НомерЧекаККМ, НомерСтроки,   
		|Контрагент, Плательщик, ТипРасчета, ПараметрыДоговораПлатежногоАгента, НомерСменыККМ, 
		|СтатусЧекаККМ, СистемаНалогообложенияЧекаККМ, Телефон, АдресЭП, НомерЧекаККМ,
		|ОтказКлиентаОтСохраненияТелефонаEmail, НеНаправлятьПокупателюЭлектронныйЧек");
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ПараметрыОтбора = Новый Структура("КлючЧека", КлючЧекаККМ); 	
		МассивЧековОтбора = Объект.ДокументОснование.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
	КонецЕсли;
	
	Для каждого ТекСтрока Из МассивЧековОтбора Цикл
		ЗаполнитьЗначенияСвойств(Результат, ТекСтрока);
		
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьФискальнуюОперациюДляЧекаККМИзСписка(ДанныеВыбранногоЧекаККМ)
	Объект.НомерИсправляемогоЧекаККМ = ДанныеВыбранногоЧекаККМ.НомерЧекаККМ;
	
	ДокументОснованиеПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Ложь);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Ложь);
	
	Форма.НадписьТипЦенНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	Если ТипЦеныДоИзменения <> Объект.ТипЦены Тогда
		
		Если Объект.НоменклатураЧекаККМ.Количество() = 0 ИЛИ Не ЗначениеЗаполнено(Объект.ТипЦены) Тогда
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'Цены не могут быть пересчитаны автоматически. Требеуется ручная корректировка.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.НоменклатураЧекаККМ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	СтрокаТЧ.ЦенаСоСкидками = СтрокаТЧ.Цена;
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтоги()
	ИтогВсего = Объект.НоменклатураЧекаККМ.Итог("Всего");
	ИтогНДС   = Объект.НоменклатураЧекаККМ.Итог("СуммаНДС");
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеДанныхИсправляемогоЧека()
	ЕстьЗамечания = Ложь;
	Если (ЗначениеЗаполнено(Объект.ДокументОснование)) И (Объект.НомерИсправляемогоЧекаККМ = 0) 
		И (НЕ ЗначениеЗаполнено(Объект.ФискальныйПризнакИсправляемогоЧекаККМ)) Тогда
		ЕстьЗамечания = Истина;	
	КонецЕсли;
	
	Если ЕстьЗамечания Тогда
		ОчиститьДанныеИсправляемогоЧекаККМ();
		ТекстСообщения = НСтр("ru = 'Чек ККМ для этого документа не пробит (не фискализирован)!'");
		ВажноеСообщениеПользователю = ТекстСообщения;
	Иначе
		ТекстСообщения = НСтр("ru = ''");
		ВажноеСообщениеПользователю = ТекстСообщения;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ВидИсправительногоЧекаККМПриИзмененииНаСервере()
	Если Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ Тогда
		Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	Иначе	
		Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
			Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);

	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		
		ЭтотОбъект.Доступность = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнить(ОповещениеПриЗавершении)
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если НомерКассовогоЧека <> 0 Тогда
		ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Документ не проведен!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;

	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ);
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.КассаККМ];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		
		ТекстСообщения = НСтр("ru = 'Документ предназначен только для ККТ с передачей данных (онлайн-касс).'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		ЭтотОбъект.Доступность = Истина;
		
		НомерКассовогоЧека  = НомерЧекаДляДокумента();
		ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
		
		УстановитьВидимостьЭлементовФормы();
		
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		ЭтотОбъект.Доступность = Ложь;

		СтандартнаяКоррекция = Истина;
		// Готовим данные
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ") Тогда
			ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаКоррекции();
			ЗаполнитьЗначенияСвойств(ОбщиеПараметры, ДанныеДляЧека());
		ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ") Тогда 
			Если ЗначениеЗаполнено(Объект.ИдентификаторЗаписиФискальнойОперации) Тогда
				Если ЗначениеЗаполнено(Объект.ТекстовыеДанныеXML) Тогда
					СтандартнаяКоррекция = Ложь;
					ОбщиеПараметры = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(Объект.ТекстовыеДанныеXML);
					ОбщиеПараметры.ТипРасчета = Объект.ТипРасчета;
					ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
					
					ТипФискальногоДокументаККТ = ?(Объект.ВерсияФФД = "1.05", ПредопределенноеЗначение("Перечисление.ТипыФискальныхДокументовККТ.КассовыйЧек"), 
						ПредопределенноеЗначение("Перечисление.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции"));
					
					ОбщиеПараметры.Вставить("ТипДокумента", ТипФискальногоДокументаККТ);
					ОбщиеПараметры.Вставить("НеприменениеККТ", Ложь);
					ДанныеЧекаКоррекции = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеКоррекции();
					ОбщиеПараметры.Вставить("ДанныеКоррекции", ДанныеЧекаКоррекции);
					ОбщиеПараметры.Вставить("ДокументОснование", Объект.Ссылка);
					
					Если Объект.ИсправлениеВстречнымПредоставлением Тогда
						Оплаты = Новый Массив;
						ВсегоОплата = 0;
						Для каждого ТекОплата Из ОбщиеПараметры.ТаблицаОплат Цикл
							ВсегоОплата = ВсегоОплата + ТекОплата.Сумма;
						КонецЦикла;
						СтруктураОплаты = Новый Структура;
						СтруктураОплаты.Вставить("ТипОплаты", ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.ВстречноеПредоставление"));
						СтруктураОплаты.Вставить("Сумма", ВсегоОплата);
						Оплаты.Добавить(СтруктураОплаты);
						ОбщиеПараметры.ТаблицаОплат = Оплаты;
					КонецЕсли;	
					
					ЗаполнитьЗначенияСвойств(ОбщиеПараметры, ДанныеДляЧека());
				Иначе	
					ТекстСообщения = НСтр("ru = 'XML-данные чека документа-основания не заполнены! Чек не может быть сформирован. 
					|Заполните чек без документа-основания и повторите попытку.'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
					Возврат;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
				СтандартнаяКоррекция = Ложь;
				ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаПоДокументуОснованию();
				ОбщиеПараметры.ТипРасчета = Объект.ТипРасчета;
				ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
				ОбщиеПараметры.Вставить("НеприменениеККТ", Ложь);
				ОбщиеПараметры.Вставить("ДокументОснование", Объект.Ссылка);
			Иначе
				СтандартнаяКоррекция = Ложь;
				ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека();
				ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
			КонецЕсли;	
		КонецЕсли;			
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст); 
		
		ПроверитьКодыМаркировки(ИдентификаторУстройстваФР);
		
		Если СтандартнаяКоррекция Тогда
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеЧекаКоррекцииНаФискальномУстройстве(Оповещение, 
																											 УникальныйИдентификатор,
																											 ИдентификаторУстройстваФР,
																											 ОбщиеПараметры);
		Иначе
			ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   			ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    		ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
		КонецЕсли;		
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены()
	Результат = Истина;
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка);
	СуммаПоТаблицеНоменклатуры = ТаблицаНоменклатуры.Итог("Сумма");
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ТипРасчета");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" реквизита ""Ответственный""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СистемаНалогообложенияЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ЕстьПустыеНаименованияТоваровУслуг = Ложь;
		ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
		НомераСтрокПустыхНаименований = "";
		НомераСтрокПустыхПредметовРасчета = "";
	
		Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
			Если Не ЗначениеЗаполнено(ТекСтрока.Наименование) Тогда
				ЕстьПустыеНаименованияТоваровУслуг = Истина;
				НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрока.НомерСтроки)+", ";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета) Тогда
				ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
				НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрока.НомерСтроки)+", ";
			КонецЕсли;
		КонецЦикла;	
		
		Если ЕстьПустыеНаименованияТоваровУслуг Тогда
			НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
			Если НомераСтрокПустыхНаименований = "1" Тогда
				ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека пустое наименование номенклатуры! 
				|Следует в документе-основании заполнить номенклатуру и повторить попытку!'");
			Иначе
				ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека пустые наименования номенклатуры!
				|Следует в документах-основаниях для этих строк заполнить номенклатуру и повторить попытку!'");
			КонецЕсли;	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
			НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
			Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
				ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета! 
				|Следует в документе-основании заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
			Иначе
				ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета!
				|Следует в документах-основаниях для этих строк заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
			КонецЕсли;	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
			
			Результат = Ложь;	
		КонецЕсли;
	КонецЕсли;	
	
	Если Объект.СуммаОплатыНаличными = 0 И Объект.СуммаОплатыЭлектронно = 0 И Объект.СуммаПостоплаты = 0 И
		Объект.СуммаПредоплаты = 0 И Объект.СуммаОплатыВстречнымПредоставлением = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен ни один реквизит вида оплаты исправительного чека'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОплатаНаличные");
		
		Результат = Ложь;	
	КонецЕсли;	
	
	Если Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ОписаниеКоррекции) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Описание коррекции""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОписаниеКоррекции");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если Объект.ДатаКоррекции  = Дата(1,1,1) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Дата коррекции""!''");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОписаниеКоррекции");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если (Объект.ТипКоррекции = 1) И (Объект.НомерПредписания = 0) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Номер предписания""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НомерПредписания");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если ТаблицаНоменклатуры.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен список номенклатуры чека ККМ!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НоменклатураЧекаККМ");
			
			Результат = Ложь;
		ИначеЕсли СуммаПоТаблицеНоменклатуры = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Сумма в списке номенклатуры чека ККМ равна 0!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НоменклатураЧекаККМ");
			
			Результат = Ложь;
		КонецЕсли;
		
		Если СуммаПоТаблицеНоменклатуры > 0 Тогда
			СуммаВсехВидовОплаты = Объект.СуммаОплатыНаличными + Объект.СуммаОплатыЭлектронно + Объект.СуммаПостоплаты +
					Объект.СуммаПредоплаты + Объект.СуммаОплатыВстречнымПредоставлением;
			Если ТаблицаНоменклатуры.Итог("Сумма") <> СуммаВсехВидовОплаты Тогда
				ТекстСообщения = НСтр("ru = 'Сумма значений реквизитов вида оплаты %1 не равна сумме списка номенклатуры %2!'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Формат(СуммаВсехВидовОплаты, "ЧЦ=15; ЧДЦ=2"), Формат(СуммаПоТаблицеНоменклатуры, "ЧЦ=15; ЧДЦ=2"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НоменклатураЧекаККМ");
				
				Результат = Ложь;	
			КонецЕсли;		
		КонецЕсли;		
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ФискальныйПризнакИсправляемогоЧекаККМ) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Фискальный признак исправляемого чека ККМ""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ФискальныйПризнакИсправляемогоЧекаККМ");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если Объект.СуммаИсправляемогоЧекаККМ = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнена сумма оплаты исправляемого чека'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СуммаИсправляемогоЧекаККМ");
			
			Результат = Ложь;	
		КонецЕсли;	
		
		Если Объект.ОплатаНаличные = 0 И Объект.ОплатаЭлектронно = 0 И Объект.ОплатаПостоплата = 0 И
			Объект.ОплатаПредоплата = 0 И Объект.ОплатаВстречноеПредоставление = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен ни один реквизит вида оплаты исправляемого чека'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОплатаНаличные");
			
			Результат = Ложь;	
		КонецЕсли;
		
	КонецЕсли;
	
	ПолучательЧекаККМ = Объект.Контрагент;
	Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
		ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.НомерТелефонаДляЭлектронногоЧекаКорректен(АбонентскийНомерТелефона) Тогда
			ТекстСообщения = НСтр("ru = 'Номер телефона для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АбонентскийНомерТелефона");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес электронной почты для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АдресЭлектроннойПочты");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции	

&НаКлиенте
Процедура ПробитьЧекНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовФормы();
	
	Оповестить("ФискальныеОперацииБГУИзменение");
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
		
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	
	УстановитьВидимостьЭлементовФормы();
	
	Оповестить("ФискальныеОперацииБГУИзменение");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма, НомерЧекаККМ = 0)
	
	ТекстЗаголовкаДанныхЧека = "";
	
	Объект = Форма.Объект;
	
	Если НомерЧекаККМ <> 0 Тогда
		ТекстЗаголовкаДанныхЧека = НСтр("ru='ФД № '")+Формат(НомерЧекаККМ, "ЧГ=");
	КонецЕсли;
	
	Форма.ДанныеЗаголовкаСтраницыЧекаККМ = ТекстЗаголовкаДанныхЧека;

КонецПроцедуры

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ПризнакСпособаРасчетаПоУмолчанию = Объект.КассаККМ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеНоменклатуры(Номенклатура, Организация, ТипЦены, ДатаСведений)
	СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Код, НаименованиеПолное, НаименованиеДляЧекаККМ, 
		|ПризнакПредметаРасчета, СтавкаНДС, НомерГТД, ЕдиницаИзмерения, СтранаПроисхождения");
	
	Цена = ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, ДатаСведений, Организация);
	
	СтруктураРезультат.Вставить("Цена", Цена);
	
	Возврат СтруктураРезультат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Функция НомерЧекаДляДокумента()
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Функция ДанныеДляЧека()
	Результат = Новый Структура;
	
	// Общие параметры чека
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("Телефон");
	СтруктураРеквизитов.Вставить("АдресЭП");
	СтруктураРеквизитов.Вставить("Дата");
	СтруктураРеквизитов.Вставить("Ответственный");
	СтруктураРеквизитов.Вставить("ПараметрыДоговораПлатежногоАгента");
	СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ");
	СтруктураРеквизитов.Вставить("СуммаДокумента");
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, СтруктураРеквизитов);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("НаименованиеПолное");
	СтруктураРеквизитов.Вставить("ИНН");
	СтруктураРеквизитов.Вставить("КПП");
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Организация, СтруктураРеквизитов);
	
	Результат.Вставить("Организация", РеквизитыДокумента.Организация);
	Результат.Вставить("ОрганизацияНазвание", РеквизитыОрганизация.НаименованиеПолное);
	Результат.Вставить("ОрганизацияИНН", РеквизитыОрганизация.ИНН);
	Результат.Вставить("ОрганизацияКПП", РеквизитыОрганизация.КПП);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоДаннымНоменклатуры(ВыбранноеЗначение)
	
	Если Объект.ДатаИсправляемогоЧекаККМ = Дата(1,1,1) Тогда
		ДатаСведений = Объект.Дата;
	Иначе
		ДатаСведений = Объект.ДатаИсправляемогоЧекаККМ;
	КонецЕсли;	
	
	СтруктураДанных = ПолучитьДанныеНоменклатуры(ВыбранноеЗначение, Объект.Организация, Объект.ТипЦены, ДатаСведений);
	
	ТекущиеДанные = Элементы.НоменклатураЧекаКоррекции.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ТекущиеДанные.Номенклатура = ВыбранноеЗначение;
		Если ЗначениеЗаполнено(СтруктураДанных.СтавкаНДС) Тогда
			ТекущиеДанные.СтавкаНДС = СтруктураДанных.СтавкаНДС;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.НаименованиеДляЧекаККМ) Тогда
			ТекущиеДанные.НаименованиеНоменклатуры = СтруктураДанных.НаименованиеДляЧекаККМ;
		Иначе
			ТекущиеДанные.НаименованиеНоменклатуры = СтруктураДанных.НаименованиеПолное;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ПризнакПредметаРасчета) Тогда
			ТекущиеДанные.ПризнакПредметаРасчета = СтруктураДанных.ПризнакПредметаРасчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ЕдиницаИзмерения) Тогда
			ТекущиеДанные.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.СтранаПроисхождения) Тогда
			ТекущиеДанные.СтранаПроисхождения = СтруктураДанных.СтранаПроисхождения;
			ДанныеСтраны = ПолучитьДанныеСтраны(СтруктураДанных.СтранаПроисхождения);
			ТекущиеДанные.КодСтраныПроисхожденияТовара = ДанныеСтраны.Код;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.НомерГТД) Тогда
			ТекущиеДанные.НомерГТД = СтруктураДанных.НомерГТД;
			ДанныеГТД = ПолучитьДанныеГТД(СтруктураДанных.НомерГТД);
			ТекущиеДанные.НомерТаможеннойДекларации = ДанныеГТД.Код;
		КонецЕсли;
		
		ТекущиеДанные.Цена = СтруктураДанных.Цена;
		ТекущиеДанные.ЦенаСоСкидками = СтруктураДанных.Цена;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьПоДаннымНоменклатурыИсправления(ВыбранноеЗначение)
	Если Объект.ДатаИсправляемогоЧекаККМ = Дата(1,1,1) Тогда
		ДатаСведений = Объект.Дата;
	Иначе
		ДатаСведений = Объект.ДатаИсправляемогоЧекаККМ;
	КонецЕсли;	
	
	СтруктураДанных = ПолучитьДанныеНоменклатуры(ВыбранноеЗначение, Объект.Организация, Объект.ТипЦены, ДатаСведений);
	
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	ТекущиеДанные.Номенклатура = ВыбранноеЗначение;
	Если ЗначениеЗаполнено(СтруктураДанных.СтавкаНДС) Тогда
		ТекущиеДанные.СтавкаНДС = СтруктураДанных.СтавкаНДС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанных.НаименованиеДляЧекаККМ) Тогда
		ТекущиеДанные.НаименованиеНоменклатуры = СтруктураДанных.НаименованиеДляЧекаККМ;
	Иначе
		ТекущиеДанные.НаименованиеНоменклатуры = СтруктураДанных.НаименованиеПолное;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ПризнакПредметаРасчета) Тогда
		ТекущиеДанные.ПризнакПредметаРасчета = СтруктураДанных.ПризнакПредметаРасчета;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ЕдиницаИзмерения) Тогда
		ТекущиеДанные.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.СтранаПроисхождения) Тогда
		ТекущиеДанные.СтранаПроисхождения = СтруктураДанных.СтранаПроисхождения;
		ДанныеСтраны = ПолучитьДанныеСтраны(СтруктураДанных.СтранаПроисхождения);
		ТекущиеДанные.КодСтраныПроисхожденияТовара = ДанныеСтраны.Код;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.НомерГТД) Тогда
		ТекущиеДанные.НомерГТД = СтруктураДанных.НомерГТД;
		ДанныеГТД = ПолучитьДанныеГТД(СтруктураДанных.НомерГТД);
		ТекущиеДанные.НомерТаможеннойДекларации = ДанныеГТД.Код;
	КонецЕсли;
	
	ТекущиеДанные.Цена = СтруктураДанных.Цена;
	ТекущиеДанные.ЦенаСоСкидками = СтруктураДанных.Цена;
КонецПроцедуры	

&НаКлиенте
Процедура ВывестиПредставлениеЧека()
	ЕстьОшибки = Ложь;
	ЧекСформирован = Ложь;
	
	КассаККМЧека = Объект.КассаККМ;
	
	ОчиститьСообщения();
	
	Если ЭтаФорма.Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ДанныеЧекаДляДокумента = ДанныеЧекаДляДокумента();
		
		НомерКассовогоЧека = ДанныеЧекаДляДокумента.НомерЧекаККМ;		
		
		Если НомерКассовогоЧека = 0 Тогда 
			НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерДокКассыККМ = ?(НомерДокументаКассыККМ[Объект.КассаККМ]=Неопределено, 0, НомерДокументаКассыККМ[Объект.КассаККМ]);
			НомерЧека = НомерДокКассыККМ+1;
		Иначе
			НомерЧека = НомерКассовогоЧека;	
			ЧекСформирован = Истина;
		КонецЕсли;	
		ОбщиеПараметры = ПодготовитьДанныеДляПросмотраЧека();
		Если ОбщиеПараметры = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Недостаточно данных для просмотра чека'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли;			
		
		Если ЧекСформирован Тогда
			ОбщиеПараметры.ДатаВремя = ДанныеЧекаДляДокумента.ДатаЧекаККМ;	
		КонецЕсли;	
		
		ВерсияФФД = ВерсияФФД(КассаККМЧека);
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ") Тогда
			ТекстЧека = НСтр("ru = 'Возможность просмотреть 
			|представление чека
			|коррекции отсутствует'");
		Иначе	
			ТекстЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 34, ВерсияФФД);
		КонецЕсли;
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстЧека);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("ИдентификаторЗаписи", ДанныеЧекаДляДокумента.ИдентификаторЗаписи);

		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраЧекаККМ", ПараметрыФормы, , Объект,,,, Режим);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДанныеДляПросмотраЧека()
	Результат = Неопределено;
	
	ДанныеЧека = ДанныеЧекаДляДокумента();
	Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) Тогда
		Результат = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ДанныеЧека.ТекстовыеДанныеXML);
		
		Возврат Результат;
	КонецЕсли;	
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ") Тогда
		ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаКоррекции();
		ЗаполнитьЗначенияСвойств(ОбщиеПараметры, ДанныеДляЧека());
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ") Тогда 
		Если ЗначениеЗаполнено(Объект.ИдентификаторЗаписиФискальнойОперации) Тогда
			Если ЗначениеЗаполнено(Объект.ТекстовыеДанныеXML) Тогда
				СтандартнаяКоррекция = Ложь;
				ОбщиеПараметры = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(Объект.ТекстовыеДанныеXML);
				ОбщиеПараметры.ТипРасчета = Объект.ТипРасчета;
				ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
				
				ТипФискальногоДокументаККТ = ?(Объект.ВерсияФФД = "1.05", ПредопределенноеЗначение("Перечисление.ТипыФискальныхДокументовККТ.КассовыйЧек"), 
					ПредопределенноеЗначение("Перечисление.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции"));
				
				ОбщиеПараметры.Вставить("ТипДокумента", ТипФискальногоДокументаККТ);
				ОбщиеПараметры.Вставить("НеприменениеККТ", Ложь);
				ДанныеЧекаКоррекции = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеКоррекции();
				ОбщиеПараметры.Вставить("ДанныеКоррекции", ДанныеЧекаКоррекции);
				ОбщиеПараметры.Вставить("ДокументОснование", Объект.Ссылка);
				
				Если Объект.ИсправлениеВстречнымПредоставлением Тогда
					Оплаты = Новый Массив;
					ВсегоОплата = 0;
					Для каждого ТекОплата Из ОбщиеПараметры.ТаблицаОплат Цикл
						ВсегоОплата = ВсегоОплата + ТекОплата.Сумма;
					КонецЦикла;
					СтруктураОплаты = Новый Структура;
					СтруктураОплаты.Вставить("ТипОплаты", ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.ВстречноеПредоставление"));
					СтруктураОплаты.Вставить("Сумма", ВсегоОплата);
					Оплаты.Добавить(СтруктураОплаты);
					ОбщиеПараметры.ТаблицаОплат = Оплаты;
				КонецЕсли;	
				
				ЗаполнитьЗначенияСвойств(ОбщиеПараметры, ДанныеДляЧека());
			Иначе	
				ТекстСообщения = НСтр("ru = 'XML-данные чека документа-основания не заполнены! Чек не может быть сформирован. 
				|Заполните чек без документа-основания и повторите попытку.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
			ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаПоДокументуОснованию();
			ОбщиеПараметры.ТипРасчета = Объект.ТипРасчета;
			ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
			ОбщиеПараметры.Вставить("НеприменениеККТ", Ложь);
			ОбщиеПараметры.Вставить("ДокументОснование", Объект.Ссылка);
		Иначе
			ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека();
			ОбщиеПараметры.ДополнительныйРеквизит = Объект.ФискальныйПризнакИсправляемогоЧекаККМ;
		КонецЕсли;	
	КонецЕсли;			
	
	Результат = ОбщиеПараметры;
	
	Возврат Результат;
КонецФункции
	
&НаСервере
Функция ВерсияФФД(КассаККМЧека) Экспорт
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
КонецФункции

&НаСервере
Функция ДанныеЧекаДляДокумента()
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура ЗаполнитьКассовыйЧекКоррекцииНаСервере()
	ТипРасчетаПоДокументам = Перечисления.ТипыРасчетаДенежнымиСредствами.ПустаяСсылка();
	
	СписокСНО = Новый Массив;
	ЕстьПустыеСНО = Ложь;
	СписокДокументовСПустымиСНО = Новый Массив;
	
	ЕстьПриход = Ложь;
	ЕстьРасход = Ложь;
	
	КоличествоДокументовОснований = 0;
	
	Для каждого ТекСтрока Из Объект.ДокументыОснованияКорректировки Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ДокументБезЧекаККМ) Тогда
			КоличествоДокументовОснований = КоличествоДокументовОснований + 1;
			Если ТипЗнч(ТекСтрока.ДокументБезЧекаККМ) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
				ЕстьПриход = Истина;
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументБезЧекаККМ) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
				ЕстьПриход = Истина;
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументБезЧекаККМ) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
				Если ТекСтрока.ДокументБезЧекаККМ.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой
					ИЛИ ТекСтрока.ДокументБезЧекаККМ.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж Тогда
					ЕстьПриход = Истина;
				Иначе
					ЕстьРасход = Истина;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументБезЧекаККМ) = Тип("ДокументСсылка.ЧекККМ") Тогда
				ЕстьПриход = Истина;
			Иначе
				ЕстьРасход = Истина;
			КонецЕсли;
			
			СНО = ТекСтрока.ДокументБезЧекаККМ.СистемаНалогообложенияЧекаККМ;
			Если ЗначениеЗаполнено(СНО) Тогда
				Если СписокСНО.Найти(СНО) = Неопределено Тогда
					СписокСНО.Добавить(СНО);
				КонецЕсли;
			Иначе
				ЕстьПустыеСНО = Истина;
				СписокДокументовСПустымиСНО.Добавить(ТекСтрока.ДокументБезЧекаККМ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если КоличествоДокументовОснований = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не указаны документы-основания корректировки для заполнения данных чека коррекции. 
		|Следует указать один или несколько документов-оснований без чека ККМ одного типа расчета на закладке ""Документы-основания"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыОснованияКорректировки");
		
		Возврат;
	КонецЕсли;	
	
	Если ЕстьПриход И НЕ ЕстьРасход Тогда
		ТипРасчетаПоДокументам = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	ИначеЕсли ЕстьРасход И НЕ ЕстьПриход Тогда
		ТипРасчетаПоДокументам = Перечисления.ТипыРасчетаДенежнымиСредствами.РасходДенежныхСредств;
	КонецЕсли;	
	
	Объект.ТипРасчета = ТипРасчетаПоДокументам;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Данные чека коррекции не могут быть заполнены однозначно по причине того, 
		|что в списке документов-оснований коррекции присутствуют как приходные, так и расходные операции. 
		|Необходимо оставить в списке документы только на приход или только на расход денежных средств и повторить заполнение!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыОснованияКорректировки");
		
		Возврат;
	КонецЕсли;
	
	Если ЕстьПустыеСНО Тогда
		ТекстСообщения = НСтр("ru = 'У документов-оснований не указана система налогообложения для чека ККМ:'"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		Для каждого ТекДок Из СписокДокументовСПустымиСНО Цикл
			ТекстСообщения = СокрЛП(ТекДок); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		КонецЦикла;
	Иначе
		Если СписокСНО.Количество() = 1 Тогда
			Объект.СистемаНалогообложенияЧекаККМ = СписокСНО[0];	
		ИначеЕсли СписокСНО.Количество() > 1 Тогда
			ТекстСообщения = НСтр("ru = 'В документах-основаниях указано несколько различных систем налогообложения для чека ККМ. Следует отобрать документы по одной системе налогообложения.'"); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		КонецЕсли;	
	КонецЕсли;
	
	Объект.ДатаКоррекции = ТекущаяДатаСеанса();
	
	ВсегоОплачено = 0;
	ВсегоНаличными = 0;
	ВсегоБезналичными = 0;
	ВсегоПредоплата = 0;
	ВсегоПостоплата = 0;
	
	Объект.НоменклатураЧекаККМ.Очистить();
	
	Для каждого ТекДок Из Объект.ДокументыОснованияКорректировки Цикл
		ДокументБезЧека = ТекДок.ДокументБезЧекаККМ;
		
		ОбщиеПараметрыДокументаБезЧека  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ДокументБезЧека.ПолучитьОбъект(), ДокументБезЧека, 1);
		
		Если ТипЗнч(ОбщиеПараметрыДокументаБезЧека.ТаблицаОплат) = Тип("Массив") Тогда
			Для каждого ТекОплата Из ОбщиеПараметрыДокументаБезЧека.ТаблицаОплат Цикл
				Если ТекОплата.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
					ВсегоНаличными = ВсегоНаличными + ТекОплата.Сумма;
				ИначеЕсли ТекОплата.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
					ВсегоБезналичными = ВсегоБезналичными + ТекОплата.Сумма;
				ИначеЕсли ТекОплата.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
					ВсегоПредоплата = ВсегоПредоплата + ТекОплата.Сумма;
				ИначеЕсли ТекОплата.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
					ВсегоПостоплата = ВсегоПостоплата + ТекОплата.Сумма;
				КонецЕсли;
				ВсегоОплачено = ВсегоОплачено + ТекОплата.Сумма;
			КонецЦикла;	
		КонецЕсли;
		
		Для Каждого ТекНоменклатура Из ОбщиеПараметрыДокументаБезЧека.ПозицииЧека Цикл 
			Если ТекНоменклатура.Свойство("Наименование") Тогда
				НоваяСтрока = Объект.НоменклатураЧекаККМ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНоменклатура);
				НоваяСтрока.НаименованиеНоменклатуры = ТекНоменклатура.Наименование;
				НоваяСтрока.СтавкаНДС = ПодключаемоеОборудованиеБГУ.СтавкаНДСПоСтавкеНДСЧислом(ТекНоменклатура.СтавкаНДС);
				НоваяСтрока.ДокументБезЧекаККМ = ДокументБезЧека;  
			КонецЕсли;
		КонецЦикла;	
		
	КонецЦикла;
	
	Объект.СуммаДокумента = ВсегоОплачено;
	Объект.СуммаОплатыНаличными = ВсегоНаличными;
	Объект.СуммаОплатыЭлектронно = ВсегоБезналичными;
	Объект.СуммаПредоплаты = ВсегоПредоплата;
	Объект.СуммаПостоплаты = ВсегоПостоплата;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеСтраны(Страна)
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Страна, "Код");
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьДанныеГТД(ГТД)
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГТД, "Код");
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаполнениеДанныхДляЧекаККМ()

	НомерКассовогоЧека = НомерЧекаДляДокумента();
	Если Не ЗначениеЗаполнено(НомерКассовогоЧека) Тогда
		АдресЭлектроннойПочты = "";
		АбонентскийНомерТелефона = "";
		
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ДополнительныеДанныеЧекаККМ = Новый Структура;
		ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", Объект.Ссылка);
		ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", Объект.Контрагент);
		ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", АбонентскийНомерТелефона);
		ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
		ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказПокупателяОтСохраненияДанных);
		
		ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ);
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(Объект.Ссылка);
	АбонентскийНомерТелефона = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭлектроннойПочты = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	ОтказПокупателяОтСохраненияДанных = ДополнительныеСведенияКассовогоЧека.ОтказПокупателяОтСохраненияДанных;
	Если Объект.ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		ОтказПокупателяОтСохраненияДанных = Объект.ОтказКлиентаОтСохраненияТелефонаEmail;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ИсправлениеВстречнымПредоставлениемПриИзмененииНаСервере()
	Если Объект.ИсправлениеВстречнымПредоставлением Тогда
		ОбщаяСуммаОплаты = Объект.ОплатаНаличные + Объект.ОплатаЭлектронно 
			+ Объект.ОплатаПредоплата + Объект.ОплатаПостоплата + Объект.ОплатаВстречноеПредоставление;
		Объект.СуммаОплатыВстречнымПредоставлением = ОбщаяСуммаОплаты;
		Объект.СуммаОплатыНаличными = 0;
		Объект.СуммаОплатыЭлектронно = 0;
		Объект.СуммаПостоплаты = 0;
		Объект.СуммаПредоплаты = 0;
	Иначе
		Объект.СуммаОплатыВстречнымПредоставлением = Объект.ОплатаВстречноеПредоставление;
		Объект.СуммаОплатыНаличными = Объект.ОплатаНаличные;
		Объект.СуммаОплатыЭлектронно = Объект.ОплатаЭлектронно;
		Объект.СуммаПостоплаты = Объект.ОплатаПостоплата;
		Объект.СуммаПредоплаты = Объект.ОплатаПредоплата;
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормыЧека(Форма)
	Объект = Форма.Объект;
	
	ВидимостьЭлементовФФД105 = Истина;
	Если Объект.ВерсияФФД = "1.1" Тогда
		ВидимостьЭлементовФФД105 = Ложь;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсправлениеВстречнымПредоставлением", "Видимость", ВидимостьЭлементовФФД105);
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодыМаркировки(ИдентификаторУстройстваФР)
	
	МенеджерОборудованияКлиент.НачатьПодключениеОборудования(Неопределено, ЭтотОбъект, , ИдентификаторУстройстваФР);

	Если ИспользуетсяККТСПередачейДанных() И ВерсияФФД(Объект.КассаККМ) = "1.2" Тогда       
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЧекККМ") Тогда 
			СписокКодовМаркировки = ПолучитьСписокКодовМаркировки(Объект.ДокументОснование);
			Для Каждого СтрокаТовар Из СписокКодовМаркировки Цикл 
				ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР);	
			КонецЦикла;	                                                                  
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ИспользуетсяККТСПередачейДанных()
	
	Возврат ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокКодовМаркировки(Ссылка)
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЧекККМТоварыРаботыУслуги.КодМаркировки КАК КодМаркировки,
	               |	ЧекККМТоварыРаботыУслуги.Количество КАК Количество
	               |ИЗ
	               |	Документ.ЧекККМ.ТоварыРаботыУслуги КАК ЧекККМТоварыРаботыУслуги
	               |ГДЕ
	               |	ЧекККМТоварыРаботыУслуги.Ссылка = &Ссылка
	               |	И ЧекККМТоварыРаботыУслуги.МаркируемыйТовар = ИСТИНА
	               |	И ЧекККМТоварыРаботыУслуги.КодМаркировки <> """"";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	СписокКодовМаркировки = Новый Массив;
	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл 
		КодМаркировки = Новый Структура("КодМаркировки, Количество", СтрокаРезультат.КодМаркировки, СтрокаРезультат.Количество);
		СписокКодовМаркировки.Добавить(КодМаркировки);
	КонецЦикла;	
	Возврат СписокКодовМаркировки;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР)
	
	УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
	ПараметрыОперации.ИдентификаторЗапроса 			= УникальныйИдентификаторЗапроса;
	ПараметрыОперации.Количество 					= СтрокаТовар.Количество;  
	ПараметрыОперации.ДробноеКоличество.Числитель   = 0;     
	ПараметрыОперации.ДробноеКоличество.Знаменатель = 0;     
	ПараметрыОперации.МераКоличестваПредметаРасчета = ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Штука");
	ПараметрыОперации.ПланируемыйСтатусТовара 		= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	ПараметрыОперации.КонтрольнаяМарка 				= СтрокаТовар.КодМаркировки;
	ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ 	= Ложь;
	
	ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", УникальныйИдентификаторЗапроса, ИдентификаторУстройстваФР);
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМ", ЭтотОбъект, ДопПараметры);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗапросКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", Параметры.УникальныйИдентификаторЗапроса, Параметры.ИдентификаторУстройстваФР);
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПолучениеОтветаКМ", ЭтотОбъект, ДопПараметры);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолученияРезультатовЗапросаКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, Неопределено);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершениеПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершениеПолучениеОтветаКМ(РезультатВыполнения, Параметры) Экспорт

	Если РезультатВыполнения.Результат Тогда
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		ПараметрыОперации.ИдентификаторЗапроса 	= Параметры.УникальныйИдентификаторЗапроса;
		ПараметрыОперации.Выбытие				= Истина;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПодтвержденияКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, ПараметрыОперации);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	

