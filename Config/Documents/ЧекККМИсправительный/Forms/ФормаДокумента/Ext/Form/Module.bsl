&НаКлиенте
Перем ТипЦеныДоИзменения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
			Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ;
		КонецЕсли;	
		
		ПроверитьЗаполнениеДанныхИсправляемогоЧека();
	КонецЕсли;
	
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	ПризнакСпособаРасчетаПоУмолчанию = Объект.КассаККМ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	ИспользоватьВалютныйУчет = Ложь;
	Объект.СуммаВключаетНДС = Истина;
	
	ПрочитатьДополнительныеДанныеЧековККМ();
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);

	УстановитьДанныеДляПечатиЧековККМ();
	УстановитьВидимостьЭлементовФормы();
	УстановитьДоступностьДоговора(ЭтаФорма);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтаФорма);
	ВывестиПредставлениеЧекаККМ();
	
	Если Параметры.Ключ.Пустая() Тогда
		Если ВерсияФФД(Объект.КассаККМ) = "1.1" Тогда
			Объект.ВерсияФФД = "1.1";
		Иначе	
			Объект.ВерсияФФД = "1.05";
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормыЧека(ЭтаФорма);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, ЭтаФорма.Элементы.ИнформационныеСсылки);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьДоступностьДоговора(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ЗаписатьДополнительныеДанныеЧековККМ();
	
	УстановитьВидимостьЭлементовФормы();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Объект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ Тогда
		ОчиститьДанныеИсправляемогоЧекаККМ();
		Объект.ДокументОснование = "";
	Иначе	
		Объект.ОписаниеКоррекции = "";
		Объект.ДатаКоррекции = Дата(1,1,1);
		Объект.НомерПредписания = 0;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "Документ.ЧекККМИсправительный.Форма.ФормаВыбораЧекаККМ" Тогда
		ЗаполнитьФискальнуюОперациюДляЧекаККМИзСписка(ВыбранноеЗначение);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КассаККМПриИзменении(Элемент)
	КассаККМПриИзмененииНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентЧекаККМПриИзменении(Элемент)
	УстановитьДоступностьДоговора(ЭтаФорма);
	
	ЗаполнениеДанныхДляЧекаККМ();
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьТипЦенНДСНажатие(Элемент, СтандартнаяОбработка)
	
	ТипЦеныДоИзменения = Объект.ТипЦены;
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
		
КонецПроцедуры
	
&НаКлиенте
Процедура НадписьТипЦенНДСЧекаКоррекцииНажатие(Элемент, СтандартнаяОбработка)
	
	ТипЦеныДоИзменения = Объект.ТипЦены;
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
		
КонецПроцедуры	

&НаКлиенте
Процедура ФискальныйПризнакИсправляемогоЧекаККМПриИзменении(Элемент)
	ПроверитьЗаполнениеДанныхИсправляемогоЧека();
КонецПроцедуры

&НаКлиенте
Процедура ВидИсправительногоЧекаККМПриИзменении(Элемент)
	ВидИсправительногоЧекаККМПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТипРасчетаИсправляемогоЧекаККМПриИзменении(Элемент)
	Объект.ТипРасчета = ПодключаемоеОборудованиеБГУВызовсервера.ОбратныйТипРасчета(Объект.ТипРасчетаИсправляемогоЧекаККМ);
КонецПроцедуры

&НаКлиенте
Процедура СуммаИсправляемогоЧекаККМПриИзменении(Элемент)
	Если Объект.СуммаДокумента = 0 Тогда
		Объект.СуммаДокумента = Объект.СуммаИсправляемогоЧекаККМ;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаНаличныеЧекаККМПриИзменении(Элемент)
	Объект.СуммаОплатыНаличными = Объект.ОплатаНаличные;	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаЭлектронноЧекаККМПриИзменении(Элемент)
	Объект.СуммаОплатыЭлектронно = Объект.ОплатаЭлектронно;	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПредоплатаЧекаККМПриИзменении(Элемент)
	Объект.СуммаПредоплаты = Объект.ОплатаПредоплата;	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПостоплатаЧекаККМПриИзменении(Элемент)
	Объект.СуммаПостоплаты = Объект.ОплатаПостоплата;	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаВстречноеПредоставлениеЧекаККМПриИзменении(Элемент)
	Объект.СуммаОплатыВстречнымПредоставлением = Объект.ОплатаВстречноеПредоставление;	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаФормаОплатыИсправляемогоЧекаККМПриИзменении(Элемент)
	Если Объект.ФормаОплатыИсправляемогоЧекаККМ = 1 Тогда
		Объект.ОплатаНаличные = Объект.СуммаИсправляемогоЧекаККМ;
		Объект.ОплатаЭлектронно = 0;
		Объект.СуммаОплатыНаличными = Объект.ОплатаНаличные;	
	ИначеЕсли Объект.ФормаОплатыИсправляемогоЧекаККМ = 2 Тогда	
		Объект.ОплатаЭлектронно = Объект.СуммаИсправляемогоЧекаККМ;
		Объект.ОплатаНаличные = 0;
		Объект.СуммаОплатыЭлектронно = Объект.ОплатаЭлектронно;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИсправлениеВстречнымПредоставлениемПриИзменении(Элемент)
	ИсправлениеВстречнымПредоставлениемПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВерсияФФДПриИзменении(Элемент)
	УстановитьВидимостьЭлементовФормыЧека(ЭтотОбъект);
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_НоменклатураЧекаККМ

&НаКлиенте
Процедура НоменклатураЧекаККМСтранаПроисхожденияПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СтранаПроисхождения) Тогда
		СтруктураДанных = ПолучитьДанныеСтраны(ТекущиеДанные.СтранаПроисхождения);
		ТекущиеДанные.КодСтраныПроисхожденияТовара = СтруктураДанных.Код;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНомерГТДПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.НомерГТД) Тогда
		СтруктураДанных = ПолучитьДанныеГТД(ТекущиеДанные.НомерГТД);
		ТекущиеДанные.НомерТаможеннойДекларации = СтруктураДанных.Код;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМСтранаПроисхожденияОчистка(Элемент, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	ТекущиеДанные.КодСтраныПроисхожденияТовара = "";
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНомерГТДОчистка(Элемент, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	ТекущиеДанные.НомерТаможеннойДекларации = "";
КонецПроцедуры


&НаКлиенте
Процедура НоменклатураЧекаККМКоличествоПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Количество");
	РассчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМЦенаПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Цена");
	РассчитатьИтоги();
	
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	ТекущиеДанные.ЦенаСоСкидками = ТекущиеДанные.Цена;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМЦенаСоСкидкамиПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	ТекущиеДанные.Цена = ТекущиеДанные.ЦенаСоСкидками;
	
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Цена");
	РассчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМСтавкаНДСПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "СтавкаНДС");
	РассчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущиеДанные.НомерСекции = 2;
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
			ТекущиеДанные.ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
		Иначе			
			ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
		КонецЕсли;
		ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		ТекущиеДанные.Количество = 1;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНаименованиеНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНаименованиеНоменклатурыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ЗаполнитьПоДаннымНоменклатурыИсправления(ВыбранноеЗначение);		
		РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Количество");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ЗаполнитьПоДаннымНоменклатурыИсправления(ВыбранноеЗначение);		
		РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Количество");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМНоменклатураПриИзменении(Элемент)
	НоменклатураСтроки = Элементы.НоменклатураЧекаККМ.ТекущиеДанные.Номенклатура;
	
	Если ЗначениеЗаполнено(НоменклатураСтроки) Тогда
