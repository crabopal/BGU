&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданыйСписокЧеков(Параметры.АдресТаблицыЧековККМДляПлатежаВХранилище);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если ПеренестиВДокумент = Истина Тогда    
		ТекущиеДанные = Элементы.ЧекиККМ.ТекущиеДанные;
		КлючЧекаККМ = ТекущиеДанные.КлючЧека;
		НомерЧекаККМ = ТекущиеДанные.НомерЧекаККМ;
		ДанныеЧекаККМ = Новый Структура ("НомерЧекаККМ, КлючЧекаККМ", НомерЧекаККМ, КлючЧекаККМ);
		ОповеститьОВыборе(ДанныеЧекаККМ);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовЧекиККМ

&НаКлиенте
Процедура ЧекиККМВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданыйСписокЧеков(АдресСпискаЧековВХранилище)

	Если ЭтоАдресВременногоХранилища(АдресСпискаЧековВХранилище) Тогда
		ТаблицаЧеков = ПолучитьИзВременногоХранилища(АдресСпискаЧековВХранилище);
		ЧекиККМ.Загрузить(ТаблицаЧеков);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
