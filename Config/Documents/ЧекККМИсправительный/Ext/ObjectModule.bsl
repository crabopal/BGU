#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
	
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	Если ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ Тогда
		ЭтотОбъект.ДокументыОснованияКорректировки.Очистить();
	КонецЕсли;
	
	Если ВерсияФФД = "1.1" Тогда
		ИсправлениеВстречнымПредоставлением = Ложь;
	КонецЕсли;	
	
	СуммаДокумента = СуммаОплатыНаличными +
		СуммаОплатыЭлектронно + СуммаПредоплаты +
		СуммаПостоплаты + СуммаОплатыВстречнымПредоставлением;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ДокументЗаполненНаОсновании = Ложь;
	Если ЕстьЧекНепримененияККТ(ДанныеЗаполнения) Тогда
		ВызватьИсключение "На основании выбранного документа нельзя ввести документ ""Исправительный чек ККМ"""; 
	КонецЕсли;	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ЗаполнитьПоПКО(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ЗаполнитьПоРКО(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеПоступление")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеНаСчет") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		ЗаполнитьПоЭквайринговойОперации(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМ") Тогда
		ЗаполнитьПоРозничномуЧеку(ДанныеЗаполнения);	
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМНаВозврат") Тогда
		ЗаполнитьПоРозничномуЧеку(ДанныеЗаполнения);	
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМНаПередачу") Тогда
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		ЗаполнитьПоБезналичномуПоступлениюВыбытию(ДанныеЗаполнения);
		ДокументЗаполненНаОсновании = Истина;;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекиККМДляРеестраПлатежей") Тогда
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения;
		ЭтотОбъект.ЧекИзРеестраПлатежей = Истина;
		ЭтотОбъект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ;
		ДокументЗаполненНаОсновании = Истина;
		
		Возврат;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМИсправительный") Тогда
		
	КонецЕсли;
	Если ДокументЗаполненНаОсновании И (ЭтотОбъект.НомерИсправляемогоЧекаККМ = 0) Тогда
		ЭтотОбъект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ;
		НоваяСтрока = ЭтотОбъект.ДокументыОснованияКорректировки.Добавить();
		НоваяСтрока.ДокументБезЧекаККМ = ДанныеЗаполнения;
		ЭтотОбъект.ДокументОснование = "";
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоПКО(ДокументОснование)
	ЧекИзРеестраПлатежей = Ложь;

	ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
	|Телефон, АдресЭП, ОтказКлиентаОтСохраненияТелефонаEmail";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	ЭтотОбъект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ;
	ЭтотОбъект.ЧекИзРеестраПлатежей = ЧекИзРеестраПлатежей;
	
	ЗаполнитьПоФискальнойОперации(ДокументОснование);
	
КонецПроцедуры

Процедура ЗаполнитьПоРКО(ДокументОснование)
	ЧекИзРеестраПлатежей = Ложь;

	ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
	|Телефон, АдресЭП, ОтказКлиентаОтСохраненияТелефонаEmail";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	ЭтотОбъект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ;
	ЭтотОбъект.ЧекИзРеестраПлатежей = ЧекИзРеестраПлатежей;
	
	ЗаполнитьПоФискальнойОперации(ДокументОснование);
	
КонецПроцедуры

Процедура ЗаполнитьПоЭквайринговойОперации(ДокументОснование)
	Если ДокументОснование.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 нельзя ввести на основании данный вид документа.'"), ДокументОснование);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ЧекИзРеестраПлатежей = Ложь;

	ЗаполняемыеДанные = "Организация, ФискальныйРегистратор, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
	|Телефон, АдресЭП, ОтказКлиентаОтСохраненияТелефонаEmail, РасчетВИнтернете, АдресСайта";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	ЭтотОбъект.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ;
	ЭтотОбъект.ЧекИзРеестраПлатежей = ЧекИзРеестраПлатежей;
	ЭтотОбъект.КассаККМ = ДанныеДокументаОснования.ФискальныйРегистратор;
	
	ЗаполнитьПоФискальнойОперации(ДокументОснование);
	
КонецПроцедуры

Процедура ЗаполнитьПоФискальнойОперации(ДокументОснование)

	ФискальнаяОперация = ПодключаемоеОборудованиеБГУ.ИсточникДанныхИсправляемогоЧекаККМ(ДокументОснование);
	
	Если ФискальнаяОперация.ИсточникДанных > 0 Тогда
		ДанныеЧекаККМ = ФискальнаяОперация.ДанныеЧекаККМ;
		Если ДанныеЧекаККМ <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЧекаККМ);
			
			ЭтотОбъект.ИдентификаторЗаписиФискальнойОперации = ДанныеЧекаККМ.ИдентификаторЗаписи;
			ЭтотОбъект.НомерИсправляемогоЧекаККМ = ДанныеЧекаККМ.НомерЧекаККМ;
			ЭтотОбъект.ДатаИсправляемогоЧекаККМ = ДанныеЧекаККМ.ДатаЧекаККМ;
			ЭтотОбъект.СуммаИсправляемогоЧекаККМ = ДанныеЧекаККМ.СуммаЧекаККМ;
			ЭтотОбъект.ФискальныйПризнакИсправляемогоЧекаККМ = ДанныеЧекаККМ.ФискальныйПризнак;
			ЭтотОбъект.ТипРасчетаИсправляемогоЧекаККМ = ДанныеЧекаККМ.ТипРасчета;
			ЭтотОбъект.ТипРасчета = ПодключаемоеОборудованиеБГУВызовсервера.ОбратныйТипРасчета(ЭтотОбъект.ТипРасчетаИсправляемогоЧекаККМ);
			
			ЭтотОбъект.СуммаДокумента = ЭтотОбъект.СуммаИсправляемогоЧекаККМ;
			
			ЭтотОбъект.СуммаОплатыНаличными = ЭтотОбъект.ОплатаНаличные;
			ЭтотОбъект.СуммаОплатыЭлектронно = ЭтотОбъект.ОплатаЭлектронно;
			ЭтотОбъект.СуммаПредоплаты = ЭтотОбъект.ОплатаПредоплата;
			ЭтотОбъект.СуммаПостоплаты = ЭтотОбъект.ОплатаПостоплата;
			ЭтотОбъект.СуммаОплатыВстречнымПредоставлением = ЭтотОбъект.ОплатаВстречноеПредоставление;
			
		КонецЕсли;
	ИначеЕсли ФискальнаяОперация.ИсточникДанных = 0 Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМ")
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМНаВозврат") Тогда
			ЭтотОбъект.ФискальныйПризнакИсправляемогоЧекаККМ = ДокументОснование.ФискальныйПризнак;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

