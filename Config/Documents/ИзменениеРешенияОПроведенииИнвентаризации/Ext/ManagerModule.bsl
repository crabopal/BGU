#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	ПараметрыПроверкиЗаполненияРешения = ИнвентаризацияСервер.ПолучитьПараметрыПроверкиЗаполненияРешения(ДокументОбъект);
	
	НастройкиДокумента = ПолучитьНастройкиДокумента();
	
	МетаданныеДокумента = Метаданные.Документы.ИзменениеРешенияОПроведенииИнвентаризации;
	
	ПроверитьОшибкиЗаполненияШапки(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ПроверитьОшибкиЗаполненияТабличнойЧастиОбъекты(ДокументОбъект, НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ПроверитьОшибкиЗаполненияТабличнойЧастиКомиссии(ДокументОбъект, НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения);
	
	Если ИнвентаризацияСервер.ЕстьДублиСтрокТабличнаяЧастьКомиссии(ДокументОбъект) Тогда
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;
	
	Если ИнвентаризацияСервер.ЕстьНедопустимыеНомераКомиссий(ДокументОбъект) Тогда
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьДублиСотрудников(
		ДокументОбъект.ЛистСогласования,
		ДокументОбъект.Ссылка,
		"ЛистСогласования",
		НСтр("ru='Лист согласования'"),
		ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьДублиСотрудников(
		ДокументОбъект.ЛистОзнакомления,
		ДокументОбъект.Ссылка,
		"ЛистОзнакомления",
		НСтр("ru='Лист ознакомления'"),
		ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьНаличиеРабочихКомиссийБезУполномоченногоЛицаПоОбъекту(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьОтсутствиеМОЛвСоставеКомиссииРешения(ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ПроверитьНаличиеМодифицированности(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ПроверитьНачалоИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаРешения(
		ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ПроверитьЛистОзнакомления(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ЗаполнитьНаОсновании(Знач ДанныеЗаполнения, ТекстЗаполнения = Неопределено, СтандартнаяОбработка = Неопределено, ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации")
		И ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		
		ДокументОбъект.НомерИзменения = 1;
		
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьДанныеДляЗаполненияНаОсновании(ДанныеЗаполнения, ДокументОбъект.Ссылка);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Данные.Шапка);
	
	ДокументОбъект["Объекты"].Загрузить(Данные.ТаблицаОбъекты);
	
	ДокументОбъект["Комиссии"].Загрузить(Данные.ТаблицаКомиссии);
	
	ДокументОбъект["АктыОПроведенииИнвентаризации"].Загрузить(Данные.ТаблицаАктыОПроведенииИнвентаризации);
	
	ДокументОбъект["ЛистОзнакомления"].Загрузить(Данные.ТаблицаЛистОзнакомления);
	
	ДокументОбъект["ЛистСогласования"].Загрузить(Данные.ТаблицаЛистСогласования);
	
КонецПроцедуры

Функция ПолучитьДанныеДляЗаполненияНаОсновании(Знач ОснованиеСсылка, Знач ЗаполняемыйДокументСсылка, Знач ВызыватьИсключение = Истина) Экспорт
	
	РезультатПроверки = ИнвентаризацияСервер.ПостроитьДеревоДокументовДляВводаНаОсновании(ОснованиеСсылка, ЗаполняемыйДокументСсылка);
	
	Если Не РезультатПроверки.ДопустимоСозданиеИзмененияРешения Тогда
		Если ВызыватьИсключение Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Ввод на основании отменен.
				|%1'"),
				РезультатПроверки.ТекстОшибки);
				
			ВызватьИсключение ТекстСообщения;
		Иначе
			Возврат РезультатПроверки;
		КонецЕсли;
	КонецЕсли;
	
	ПоследнийДокумент = РезультатПроверки.Дерево.ПоследнийДокумент;
	
	Если ЗначениеЗаполнено(ПоследнийДокумент) Тогда
		ОснованиеСсылка = ПоследнийДокумент;
	КонецЕсли;
	
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации") Тогда
		Возврат ПолучитьДанныеДляЗаполненияНаОсновании_Решение(ОснованиеСсылка);
		
	ИначеЕсли ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		Возврат ПолучитьДанныеДляЗаполненияНаОсновании_ИзменениеРешения(ОснованиеСсылка);
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНастройкиДокумента() Экспорт
	
	ПостфиксыИменКолонокПоказателей = ПолучитьПостфиксыИменКолонокПоказателей();
	
	ВидыИспользуемыхКолонок = ПолучитьВидыИспользуемыхКолонок();
	
	Настройки = Новый Структура();
	
	Настройки.Вставить("ПостфиксыИменКолонокПоказателей",	ПостфиксыИменКолонокПоказателей);
	Настройки.Вставить("ВидыИспользуемыхКолонок",			ВидыИспользуемыхКолонок);
	Настройки.Вставить("ДопустимыеТипыИзмененияСтроки",		ПолучитьДопустимыеТипыИзмененияСтроки());
	
	Настройки.Вставить("ТаблицаОбъекты",					ПолучитьНастройкиТаблицыОбъекты(ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок));
	Настройки.Вставить("ТаблицаКомиссии",					ПолучитьНастройкиТаблицыКомиссии(ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок));
	
	Возврат Настройки;
	
КонецФункции

Процедура ОчиститьНеиспользуемыеКолонки(ДокументОбъект, НастройкиДокумента) Экспорт
	
	ОчиститьНеиспользуемыеКолонкиТаблицы(ДокументОбъект, НастройкиДокумента, "Объекты");
	
	ОчиститьНеиспользуемыеКолонкиТаблицы(ДокументОбъект, НастройкиДокумента, "Комиссии");
	
КонецПроцедуры

Процедура ДобавитьРеквизитыФормыКолонкиПредыдущихПоказателей(Форма) Экспорт
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	НастройкиДокумента = ПолучитьНастройкиДокумента();
	
	ДобавитьРеквизитыФормыКолонкиПредыдущихПоказателейТаблицы(ДобавляемыеРеквизиты, Форма, НастройкиДокумента, "Объекты");
	
	ДобавитьРеквизитыФормыКолонкиПредыдущихПоказателейТаблицы(ДобавляемыеРеквизиты, Форма, НастройкиДокумента, "Комиссии");
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуМодифицированность(ДокументОбъект, НастройкиДокумента) Экспорт
	
	ПредыдущийДокумент = ?(ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения),
		ДокументОбъект.ПредыдущееИзменениеРешения,
		ДокументОбъект.Решение);
	
	ТаблицыПредыдущегоДокумента = ПолучитьАктуальныеПоказателиДокумента(ПредыдущийДокумент);
	
	ЗаполнитьКолонкуМодифицированностьТаблицы(ДокументОбъект, ТаблицыПредыдущегоДокумента, НастройкиДокумента, "Объекты");
	
	ЗаполнитьКолонкуМодифицированностьТаблицы(ДокументОбъект, ТаблицыПредыдущегоДокумента, НастройкиДокумента, "Комиссии");
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиПредыдущихПоказателей(Форма) Экспорт
	
	ДокументОбъект = Форма.Объект;
	
	Таблица = ДокументОбъект.Объекты;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения) Тогда
		ТаблицыПредыдущегоДокумента = ПолучитьАктуальныеПоказателиДокумента(ДокументОбъект.ПредыдущееИзменениеРешения);
		
		ТаблицыИсходногоРешения = ПолучитьАктуальныеПоказателиДокумента(ДокументОбъект.Решение);
	Иначе
		ТаблицыПредыдущегоДокумента = ПолучитьАктуальныеПоказателиДокумента(ДокументОбъект.Решение);
		
		ТаблицыИсходногоРешения = ТаблицыПредыдущегоДокумента;
	КонецЕсли;
	
	НастройкиДокумента = ПолучитьНастройкиДокумента();
	
	ЗаполнитьКолонкиПредыдущихПоказателейТаблицы(Форма, ТаблицыИсходногоРешения, ТаблицыПредыдущегоДокумента, НастройкиДокумента, "Объекты");
	
	ЗаполнитьКолонкиПредыдущихПоказателейТаблицы(Форма, ТаблицыИсходногоРешения, ТаблицыПредыдущегоДокумента, НастройкиДокумента, "Комиссии");
	
КонецПроцедуры

Функция ПолучитьДанныеСотрудника(ТаблицаДанныеСотрудников, Сотрудник, ПолучитьДолжность = Ложь, ПолучитьПодразделение = Ложь) Экспорт
	
	Перем Должность, ФИО, Подразделение;
	
	Если ЗначениеЗаполнено(Сотрудник) И ТаблицаДанныеСотрудников <> Неопределено Тогда
		
		Поиск = Новый Структура("Ссылка", Сотрудник);
		
		МассивСтрок = ТаблицаДанныеСотрудников.НайтиСтроки(Поиск);
		
		СтрокаДанных = МассивСтрок[0];
		
		ФИО = СтрокаДанных.Фамилия + " " + СтрокаДанных.Имя + " " + СтрокаДанных.Отчество;
		
		Если ПолучитьДолжность Тогда
			Должность = СтрокаДанных.ДолжностьНаименование;
		КонецЕсли;
		
		Если ПолучитьПодразделение Тогда
			Подразделение = СтрокаДанных.Подразделение;
		КонецЕсли;
		
		Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
			ДолжностьПодразделение = Должность + ?(ЗначениеЗаполнено(Подразделение), ", " + Подразделение,	"");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ФИО", ФИО);
	
	Если ПолучитьДолжность Тогда
		Результат.Вставить("Должность", Должность);
	КонецЕсли;
	
	Если ПолучитьПодразделение Тогда
		Результат.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
		Результат.Вставить("ДолжностьПодразделение", ДолжностьПодразделение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРасположениеСотрудниковВРазделахДокумента(МассивДокументов) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Расчет колонок признаков принадлежности сотрудника различным разделам документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК Ссылка,
	|	Сотрудник					КАК Сотрудник,
	|	МАКСИМУМ(УказанВРазделе1)	КАК УказанВРазделе1,
	|	МАКСИМУМ(УказанВРазделе2)	КАК УказанВРазделе2
	|ИЗ
	|	(ВЫБРАТЬ
	|		Док.Ссылка			КАК Ссылка,
	|		ТЧОбъекты.Сотрудник	КАК Сотрудник,
	|		Истина				КАК УказанВРазделе1,
	|		Ложь				КАК УказанВРазделе2
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|			ПО	Док.Ссылка = ТЧОбъекты.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Док.Ссылка						КАК Ссылка,
	|		ТЧОбъекты.СотрудникДоИзменения	КАК Сотрудник,
	|		Истина							КАК УказанВРазделе1,
	|		Ложь							КАК УказанВРазделе2
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|			ПО	Док.Ссылка = ТЧОбъекты.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Док.Ссылка					КАК Ссылка,
	|		ТЧСоставКомиссии.Сотрудник	КАК Сотрудник,
	|		Ложь						КАК УказанВРазделе1,
	|		Истина						КАК УказанВРазделе2
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|			ПО	Док.Ссылка = ТЧКомиссии.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|			ПО	ТЧКомиссии.Комиссия = ТЧСоставКомиссии.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Док.Ссылка					КАК Ссылка,
	|		ТЧСоставКомиссии.Сотрудник	КАК Сотрудник,
	|		Ложь						КАК УказанВРазделе1,
	|		Истина						КАК УказанВРазделе2
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|			ПО	Док.Ссылка = ТЧКомиссии.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|			ПО	ТЧКомиссии.КомиссияДоИзменения = ТЧСоставКомиссии.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Сотрудник
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьЛистОзнакомления(ДокументОбъект) Экспорт
	
	Данные = ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект);
	
	ТаблицаСотрудников = ИнвентаризацияСервер.СоставитьТаблицуСотрудниковДляЗаполненияТабличнойЧастиЛистОзнакомления(Данные);
	
	ДокументОбъект.ЛистОзнакомления.Загрузить(ТаблицаСотрудников);
	
КонецПроцедуры

Процедура ЗаполнитьЛистСогласования(ДокументОбъект) Экспорт
	
	СогласующиеЛица = ДокументОбъект.СогласующиеЛица;
	
	ТаблицаСотрудников = ИнвентаризацияСервер.ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистСогласования(СогласующиеЛица);
	
	ДокументОбъект.ЛистСогласования.Загрузить(ТаблицаСотрудников);
	
КонецПроцедуры

#Область МеханизмОзнакомленияСотрудников

// ТаблицаНастроекДокумента - см. ОбщегоНазначенияБГУ.МеханизмОзнакомленияСотрудников_ПустаяТаблицаНастроекДокумента()
Функция МеханизмОзнакомленияСотрудников_НастройкиДокумента(ТаблицаНастроекДокумента) Экспорт
	
	НоваяСтрока = ТаблицаНастроекДокумента.Добавить();
	НоваяСтрока.ИмяТабличнойЧасти								= "ЛистОзнакомления";
	НоваяСтрока.ВидДействияСотрудникаСДокументом				= Перечисления.ВидыДействийСотрудникаСДокументом.Ознакомление;
