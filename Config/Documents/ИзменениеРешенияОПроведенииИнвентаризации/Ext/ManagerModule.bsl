Функция ПолучитьДанныеДляЗаполненияНаОсновании_Решение(ОснованиеСсылка)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ОснованиеСсылка", ОснованиеСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организация							КАК Организация,
	|	ИФО									КАК ИФО,
	|	Подразделение						КАК Подразделение,
	|	ОснованиеПроведенияИнвентаризации	КАК ОснованиеПроведенияИнвентаризации,
	|	СогласующиеЛица						КАК СогласующиеЛица,
	|	
	|	Ссылка								КАК Решение,
	|	Неопределено						КАК ПредыдущееИзменениеРешения,
	|	1									КАК НомерИзменения
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части Объекты
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки				КАК НомерСтроки,
	|	Примечание				КАК Примечание,
	|	// Показатели актуальные
	|	КФО						КАК КФО,
	|	Счет					КАК Счет,
	|	Сотрудник				КАК Сотрудник,
	|	ДатаИнвентаризации		КАК ДатаИнвентаризации,
	|	ДатаНачала				КАК ДатаНачала,
	|	ДатаОкончания			КАК ДатаОкончания,
	|	НомерКомиссии			КАК НомерКомиссии,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации		КАК МестоИнвентаризации
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части Комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки	КАК НомерСтроки,
	|	// Показатели актуальные
	|	Комиссия	КАК Комиссия
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для табличной части АктыОПроведенииИнвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Наименование	КАК Наименование,
	|	Дата			КАК Дата,
	|	Номер			КАК Номер
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.АктыОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для табличной части ЛистОзнакомления
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.ЛистОзнакомления
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для табличной части ЛистСогласования
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.ЛистСогласования
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Данные для шапки
	ТаблицаШапка = РезультатыЗапроса[0].Выгрузить();
	СтруктураШапка = Новый Структура();
	Если ТаблицаШапка.Количество() > 0 Тогда
		СтруктураШапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		
		ЗаполнениеРеквизитовОбъектов.ОчиститьИФОПодразделениеПриОтключеннойОпцииПриКопировании(СтруктураШапка);
	КонецЕсли;
	
	// [1]. Данные для табличной части Объекты
	ТаблицаОбъекты = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Данные для табличной части Комиссии
	ТаблицаКомиссии = РезультатыЗапроса[2].Выгрузить();
	
	// [3]. Данные для табличной части АктыОПроведенииИнвентаризации
	ТаблицаАктыОПроведенииИнвентаризации = РезультатыЗапроса[3].Выгрузить();
	
	// [4]. Данные для табличной части ЛистОзнакомления
	ТаблицаЛистОзнакомления = РезультатыЗапроса[4].Выгрузить();
	
	// [5]. Данные для табличной части ЛистСогласования
	ТаблицаЛистСогласования = РезультатыЗапроса[5].Выгрузить();
	
	Данные = Новый Структура();
	Данные.Вставить("Шапка", СтруктураШапка);
	Данные.Вставить("ТаблицаОбъекты", ТаблицаОбъекты);
	Данные.Вставить("ТаблицаКомиссии", ТаблицаКомиссии);
	Данные.Вставить("ТаблицаАктыОПроведенииИнвентаризации", ТаблицаАктыОПроведенииИнвентаризации);
	Данные.Вставить("ТаблицаЛистОзнакомления", ТаблицаЛистОзнакомления);
	Данные.Вставить("ТаблицаЛистСогласования", ТаблицаЛистСогласования);
	
	Возврат Данные;
	
КонецФункции

