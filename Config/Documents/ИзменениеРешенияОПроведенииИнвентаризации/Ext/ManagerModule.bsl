КонецФункции


Функция ПолучитьДанныеСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	СписокСотрудников = ПолучитьСписокСотрудников(МассивДокументов, ИменаТабличныхЧастей);
	
	Результат = Новый Соответствие();
	
	Поиск = Новый Структура();
	
	Для Каждого Дата Из СписокСотрудников["ДатыОпределенияСведений"] Цикл
		ПорцияСведений = ИнвентаризацияСервер.ПолучитьПорциюСведенийСотрудниковНаДату(СписокСотрудников["ТаблицаСотрудников"], Дата);
		
		Результат.Вставить(Дата, ПорцияСведений);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСотрудниковИзТабличнойЧастиКомиссии(ДанныеВосходящихЦепочек, ДокументОбъект)
	
	ДеревоДокументов = ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	Таблица = ИнвентаризацияСервер.ПолучитьПустуюТаблицуСотрудниковДляЛистаОзнакомления();
	
	СтрокаДокумента = ИнвентаризацияСервер.ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов);
	
	ТаблицаПодразделов = СтрокаДокумента["ТаблицаПодразделовРаздела2"];
	
	ТипИзмененияКорректировка = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка;
	
	Для Каждого СтрокаПодраздела Из ТаблицаПодразделов Цикл
		
		ТаблицаСравнения = СтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"];
		
		Для Каждого СтрокаТаблицы Из ТаблицаСравнения Цикл
			НоваяСтрока = Таблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			Если СтрокаТаблицы.ТипИзменения = ТипИзмененияКорректировка Тогда
				НоваяСтрока = Таблица.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				
				НоваяСтрока.Сотрудник = СтрокаТаблицы.СотрудникДоИзменения;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект, ДобавитьЧленовКомиссииВСвязиСКорректировкамиРаздела1 = Ложь)
	
	// Сотрудники из табличной части Объекты
	
	ТаблицаСотрудниковТЧОбъекты = ДокументОбъект.Объекты.Выгрузить(, "Сотрудник,Модифицированность");
	ТаблицаСотрудниковТЧОбъекты.Свернуть("Сотрудник,Модифицированность");
	
	ТаблицаСотрудниковТЧОбъектыДоИзменения = ДокументОбъект.Объекты.Выгрузить(, "СотрудникДоИзменения,Модифицированность");
	ТаблицаСотрудниковТЧОбъектыДоИзменения.Свернуть("СотрудникДоИзменения,Модифицированность");
	ТаблицаСотрудниковТЧОбъектыДоИзменения.Колонки.Найти("СотрудникДоИзменения").Имя = "Сотрудник";
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаСотрудниковТЧОбъектыДоИзменения, ТаблицаСотрудниковТЧОбъекты);
	
	// Сотрудники из табличной части Комиссии
	
	ПредыдущийДокумент = ?(ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения),
		ДокументОбъект.ПредыдущееИзменениеРешения,
		ДокументОбъект.Решение);

	СписокДокументов = Новый Массив();
	
	Если ЗначениеЗаполнено(ПредыдущийДокумент) Тогда
		СписокДокументов.Добавить(ПредыдущийДокумент);
	КонецЕсли;
	
	ДанныеВосходящихЦепочек = ИнвентаризацияСервер.ПолучитьДанныеВосходящихЦепочек(СписокДокументов, ДокументОбъект);
	
	ТаблицаСотрудниковРаздел2 = ПолучитьСотрудниковИзТабличнойЧастиКомиссии(ДанныеВосходящихЦепочек, ДокументОбъект);
	
	Данные = Новый Структура();
	
	Данные.Вставить("ТаблицаСотрудниковРаздел1",	ТаблицаСотрудниковТЧОбъекты);
	Данные.Вставить("ТаблицаСотрудниковРаздел2",	ТаблицаСотрудниковРаздел2);
	
	Если ДобавитьЧленовКомиссииВСвязиСКорректировкамиРаздела1 Тогда
		Данные.Вставить("ТаблицаСотрудниковРаздела2ВСвязиСКорректировкамиРаздела1", ПолучитьСотрудниковРаздела2ВСвязиСКорректировкамиРаздела1(ДанныеВосходящихЦепочек, ДокументОбъект));
	КонецЕсли;

	Возврат Данные;
	
КонецФункции

Функция ПолучитьСотрудниковРаздела2ВСвязиСКорректировкамиРаздела1(ДанныеВосходящихЦепочек, ДокументОбъект)
	
	// При выявлении корректировки этих полей в строке раздела 1
	// добавляются члены соответствующих комиссий (из раздела 2)
	
	АнализируемыеПоля = Новый Массив();
	АнализируемыеПоля.Добавить("ДатаНачала");
	АнализируемыеПоля.Добавить("ДатаОкончания");
	АнализируемыеПоля.Добавить("НомерКомиссии");
	АнализируемыеПоля.Добавить("НомерРабочейКомиссии");
	АнализируемыеПоля.Добавить("МестоИнвентаризации");
	
	Таблица = ИнвентаризацияСервер.ПолучитьПустуюТаблицуСотрудниковДляЛистаОзнакомления();
	
	ДеревоДокументов = ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	СтрокаДокумента = ИнвентаризацияСервер.ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов);
	
	ТаблицаПодразделов = СтрокаДокумента["ТаблицаПодразделовРаздела2"];
	
	ПостфиксыИменКолонокПоказателей = ПолучитьПостфиксыИменКолонокПоказателей();
	
	ПостфиксАктуальный	= ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксПредыдущий	= ПостфиксыИменКолонокПоказателей.Предыдущий;
	
	Для Каждого СтрокаТаблицыОбъекты Из ДокументОбъект.Объекты Цикл
		Если Не СтрокаТаблицыОбъекты.Модифицированность Тогда
			Продолжить;
		КонецЕсли;
		
		МодифицированностьАнализируемыхПолей = Ложь;
		МодифицированностьНомеровКомиссии = Ложь;
		
		Для Каждого ИмяПоля Из АнализируемыеПоля Цикл
			Если СтрокаТаблицыОбъекты[ИмяПоля + ПостфиксАктуальный] = СтрокаТаблицыОбъекты[ИмяПоля + ПостфиксПредыдущий] Тогда
				Продолжить;
			КонецЕсли;
			
			МодифицированностьАнализируемыхПолей = Истина;
			
			Если ИмяПоля = "НомерКомиссии" Или ИмяПоля = "НомерРабочейКомиссии" Тогда
				МодифицированностьНомеровКомиссии = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если Не МодифицированностьАнализируемыхПолей Тогда
			Продолжить;
		КонецЕсли;
		
		// Актуальную комиссию ознакомляем независимо от модифицированности номеров комисси
		
		ДобавитьСотрудниковИзОбслуживающейКомиссии(Таблица, ТаблицаПодразделов, ПостфиксыИменКолонокПоказателей,
			СтрокаТаблицыОбъекты["НомерКомиссии" + ПостфиксыИменКолонокПоказателей.Актуальный],
			СтрокаТаблицыОбъекты["НомерРабочейКомиссии" + ПостфиксыИменКолонокПоказателей.Актуальный]);
		
		// Предыдущую комиссию ознакомляем только при модифицированности номеров комиссии
		
		Если МодифицированностьНомеровКомиссии Тогда
			ДобавитьСотрудниковИзОбслуживающейКомиссии(Таблица, ТаблицаПодразделов, ПостфиксыИменКолонокПоказателей,
				СтрокаТаблицыОбъекты["НомерКомиссии" + ПостфиксыИменКолонокПоказателей.Предыдущий],
				СтрокаТаблицыОбъекты["НомерРабочейКомиссии" + ПостфиксыИменКолонокПоказателей.Предыдущий]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьСотрудниковИзОбслуживающейКомиссии(ТаблицаСотрудников, ТаблицаПодразделов, ПостфиксыИменКолонокПоказателей, НомерКомиссии, НомерРабочейКомиссии)
	
	КоличествоПодразделов = ТаблицаПодразделов.Количество();
	
	Если НомерКомиссии = 0 Или НомерКомиссии > КоличествоПодразделов Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКомиссии = ТаблицаПодразделов[НомерКомиссии - 1];
	
	ТаблицаСравнения = СтрокаКомиссии["ТаблицаСравненияСоставаКомиссий"];
	
	Для Каждого СтрокаТаблицы Из ТаблицаСравнения Цикл
		Если ЗначениеЗаполнено(НомерРабочейКомиссии) И СтрокаТаблицы.НомерРабочейКомиссии <> НомерРабочейКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		Сотрудник = СтрокаТаблицы["Сотрудник" + ПостфиксыИменКолонокПоказателей.Актуальный];
		
		Поиск = Новый Структура("Сотрудник", Сотрудник);
		
		МассивСтрок = ТаблицаСотрудников.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСотрудников.Добавить();
		НоваяСтрока.Сотрудник			= Сотрудник;
		НоваяСтрока.Модифицированность	= Истина;
	КонецЦикла;
	
КонецПроцедуры

// Проверка заполнения

Процедура ПроверитьОшибкиЗаполненияШапки(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Решение) Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Поле ""Решение о проведении инвентаризации"" не заполнено'"),
			ДокументСсылка,
			"НадписьДокументЦепочкиПервыйПредставление");
	КонецЕсли;
		
	Если ДокументОбъект.НомерИзменения >= 2 И Не ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения) Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Поле ""Предыдущее Изменение решения о проведении инвентаризации"" не заполнено'"),
			ДокументСсылка,
			"НадписьДокументЦепочкиПредыдущийПредставление");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОшибкиЗаполненияТабличнойЧастиОбъекты(ДокументОбъект, НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения)
	
	Если ДокументОбъект.Аннулирующее Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗаполненностьКолонокТабличнойЧастиОбъекты(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ПроверитьСтрокиКорректировокТабличнойЧасти(ДокументОбъект, "Объекты", НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьНеобходимостьУказанияМОЛВТабличнойЧастиОбъекты(ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
КонецПроцедуры

Процедура ПроверитьЗаполненностьКолонокТабличнойЧастиОбъекты(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	ТекстШаблон = НСтр("ru='Не заполнена колонка ""%1"" в строке %2 списка ""Объекты инвентаризации""'");
	
	ПроверяемыеПоля = Новый Массив();
	ПроверяемыеПоля.Добавить("Счет");
	ПроверяемыеПоля.Добавить("ДатаИнвентаризации");
	ПроверяемыеПоля.Добавить("ДатаНачала");
	ПроверяемыеПоля.Добавить("ДатаОкончания");
	ПроверяемыеПоля.Добавить("НомерКомиссии");
	ПроверяемыеПоля.Добавить("МестоИнвентаризации");
	
	МетаданныеРеквизитов = Метаданные.Документы.ИзменениеРешенияОПроведенииИнвентаризации.ТабличныеЧасти.Объекты.Реквизиты;
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	Для Каждого СтрокаТаблицыОбъекты Из ДокументОбъект.Объекты Цикл
		
		ТипИзменения = СтрокаТаблицыОбъекты.ТипИзменения;
		
		Если Не ЗначениеЗаполнено(ТипИзменения) Или ТипИзменения = ТипИзмененияОтмена Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ПроверяемоеПоле Из ПроверяемыеПоля Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицыОбъекты[ПроверяемоеПоле]) Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьОшибкиЗаполнения = Истина;
			
			НомерСтроки = СтрокаТаблицыОбъекты.НомерСтроки;
			
			ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон, МетаданныеРеквизитов[ПроверяемоеПоле].Синоним, НомерСтроки),
				ДокументСсылка,
				"Объект.Объекты[" + ИндексСтрокиТекст + "]." + ПроверяемоеПоле);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьОшибкиЗаполненияТабличнойЧастиКомиссии(ДокументОбъект, НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения)
	
	Если ДокументОбъект.Аннулирующее Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗаполненностьКолонокТабличнойЧастиКомиссии(ДокументОбъект, НастройкиДокумента, ЕстьОшибкиЗаполнения);
	
	ПроверитьСтрокиКорректировокТабличнойЧасти(ДокументОбъект, "Комиссии", НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения);
	
КонецПроцедуры

Процедура ПроверитьЗаполненностьКолонокТабличнойЧастиКомиссии(ДокументОбъект, НастройкиДокумента, ЕстьОшибкиЗаполнения)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	ТекстШаблон = НСтр("ru='Не заполнена колонка ""%1"" в строке %2 списка ""Инвентаризационные комиссии""'");
	
	ПроверяемыеПоля = Новый Массив();
	ПроверяемыеПоля.Добавить("Комиссия");
	
	МетаданныеРеквизитов = Метаданные.Документы.ИзменениеРешенияОПроведенииИнвентаризации.ТабличныеЧасти.Комиссии.Реквизиты;
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	Для Каждого СтрокаТаблицыКомиссии Из ДокументОбъект.Комиссии Цикл
		
		ТипИзменения = СтрокаТаблицыКомиссии.ТипИзменения;
		
		Если Не ЗначениеЗаполнено(ТипИзменения) Или ТипИзменения = ТипИзмененияОтмена Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ПроверяемоеПоле Из ПроверяемыеПоля Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицыКомиссии[ПроверяемоеПоле]) Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьОшибкиЗаполнения = Истина;
			
			НомерСтроки = СтрокаТаблицыКомиссии.НомерСтроки;
			
			ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон, МетаданныеРеквизитов[ПроверяемоеПоле].Синоним, НомерСтроки),
				ДокументСсылка,
				"Объект.Комиссии[" + ИндексСтрокиТекст + "]." + ПроверяемоеПоле);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСтрокиКорректировокТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти, НастройкиДокумента, МетаданныеДокумента, ЕстьОшибкиЗаполнения)
	
	ТекстШаблон = НСтр("ru='В строке %1 списка ""%2"" отсутствуют измененные поля (тип изменения Корректировка)'");
	
	ПредставлениеТабличнойЧасти = МетаданныеДокумента.ТабличныеЧасти[ИмяТабличнойЧасти].Синоним;
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТабличнойЧасти].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	ТипИзмененияКорректировка = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		
		Если СтрокаТаблицы.ТипИзменения <> ТипИзмененияКорректировка Тогда
			Продолжить;
		КонецЕсли;
		
		ВсеПоказателиСовпадают = Истина;
		
		Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
			ИмяКолонкиАктуальный	= ИмяПоказателя + ПостфиксАктуальный;
			ИмяКолонкиДоИзменения	= ИмяПоказателя + ПостфиксДоИзменения;
			
			Если СтрокаТаблицы[ИмяКолонкиАктуальный] <> СтрокаТаблицы[ИмяКолонкиДоИзменения] Тогда
				ВсеПоказателиСовпадают = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсеПоказателиСовпадают Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			НомерСтроки = СтрокаТаблицы.НомерСтроки;
			
			ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон, НомерСтроки, ПредставлениеТабличнойЧасти),
				ДокументОбъект.Ссылка,
				"Объект." + ИмяТабличнойЧасти + "[" + ИндексСтрокиТекст + "].НомерСтроки");
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеМодифицированности(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	Если ДокументОбъект.Аннулирующее Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Модифицированность", Истина);
	
	МассивСтрок = ДокументОбъект.Объекты.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок = ДокументОбъект.Комиссии.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения) Тогда
		ВидДокумента = НСтр("ru='Изменения решения'");
	Иначе
		ВидДокумента = НСтр("ru='Решения'");
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru='Документ не содержит изменений по сравнению с предыдущим документом %1'"), ВидДокумента),
		ДокументОбъект.Ссылка);
	
КонецПроцедуры

Процедура ПроверитьНачалоИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения)

	ТекстШаблон = НСтр("ru='Изменение решения датировано после начала инвентаризации (строка %1 списка ""Объекты инвентаризации"")'");
	
	ДатаИзмененияРешения = НачалоДня(ДокументОбъект.Дата);
	
	Если Не ЗначениеЗаполнено(ДатаИзмененияРешения) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Объекты Цикл
		Если СтрокаТаблицы.ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаНачала = СтрокаТаблицы.ДатаНачала;
		
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаИзмененияРешения >= ДатаНачала Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			НомерСтроки = СтрокаТаблицы.НомерСтроки;
			
			ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон, НомерСтроки),
				ДокументОбъект.Ссылка,
				"Объект.Объекты[" + ИндексСтрокиТекст + "].ДатаНачала");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ПроверитьЛистОзнакомления(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	ТекстСообщения = НСтр("ru='В листе ознакомления не указаны некоторые сотрудники из разделов 1 и 2. Рекомендуется выполнить автозаполнение листа ознакомления.'");
	
	Данные = ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект);
	
	ТаблицаОбязательныхСотрудников = ИнвентаризацияСервер.СоставитьТаблицуСотрудниковДляЗаполненияТабличнойЧастиЛистОзнакомления(Данные);
	
	Поиск = Новый Структура("Сотрудник");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбязательныхСотрудников Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = ДокументОбъект.ЛистОзнакомления.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				"Объект.ЛистОзнакомления");
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//---
// Печать
//---

// Решение с учетом изменений

Функция Печать_РешениеСУчетомИзменений(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РешениеОПроведенииИнвентаризации.ПФ_MXL_Ф0510439");
	
	КлючПараметровПечати = "ПечатьРешениеСУчетомИзменений";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("ЗаголовокНачало",				Макет.ПолучитьОбласть("ЗаголовокНачало"));
	ОбластиМакета.Вставить("ИзменяющийДокументЗаголовок",	Макет.ПолучитьОбласть("ИзменяющийДокументЗаголовок"));
	ОбластиМакета.Вставить("ИзменяющийДокументСтрока",		Макет.ПолучитьОбласть("ИзменяющийДокументСтрока"));
	ОбластиМакета.Вставить("ЗаголовокКонец",				Макет.ПолучитьОбласть("ЗаголовокКонец"));
	
	ОбластиМакета.Вставить("СтрокаАкта",					Макет.ПолучитьОбласть("СтрокаАкта"));
	ОбластиМакета.Вставить("Раздел1Заголовок",				Макет.ПолучитьОбласть("Раздел1Заголовок"));
	ОбластиМакета.Вставить("Раздел1ШапкаТаблицы",			Макет.ПолучитьОбласть("Раздел1ШапкаТаблицы"));
	
	ОбластиМакета.Вставить("Раздел1СтрокаТаблицы",			Макет.ПолучитьОбласть("Раздел1СтрокаТаблицы"));
	
	ОбластиМакета.Вставить("Раздел1Подвал",					Макет.ПолучитьОбласть("Раздел1Подвал"));
	ОбластиМакета.Вставить("Раздел2Заголовок",				Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2НомерКомиссии",			Макет.ПолучитьОбласть("Раздел2НомерКомиссии"));
	ОбластиМакета.Вставить("Раздел2СтрокаАкта",				Макет.ПолучитьОбласть("Раздел2СтрокаАкта"));
	ОбластиМакета.Вставить("Раздел2ШапкаТаблицы",			Макет.ПолучитьОбласть("Раздел2ШапкаТаблицы"));
	ОбластиМакета.Вставить("Раздел2СтрокаТаблицы",			Макет.ПолучитьОбласть("Раздел2СтрокаТаблицы"));
	ОбластиМакета.Вставить("Раздел2Подвал",					Макет.ПолучитьОбласть("Раздел2Подвал"));
	ОбластиМакета.Вставить("Подвал",						Макет.ПолучитьОбласть("Подвал"));
	
	Данные = ПолучитьДанныеДокументовДляПечати(МассивОбъектов, Истина);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НастройкиДокумента", Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьНастройкиДокумента());
	ДополнительныеПараметры.Вставить("СоответствиеПоказателейИГрафРаздела1", ПолучитьСоответствиеПоказателейИГрафРаздела1());
	ДополнительныеПараметры.Вставить("ПечатьРешениеСУчетомИзменений", Истина);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		// ЗАГОЛОВОК
		
		ЗначенияПараметров = Новый Структура();
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
		
		ЗначенияПараметров.Вставить("ОснованиеПроведения", СтрокаШапки.ОснованиеПроведения);
		ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.РешениеДата);
		ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.Решение,
			СтрокаШапки.РешениеНомер));
		
		Область = ОбластиМакета["ЗаголовокНачало"];
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
		
		Область = ОбластиМакета["ИзменяющийДокументЗаголовок"];
		ТабДокумент.Вывести(Область);
		
		ВывестиСписокИзменяющихДокументов_РешениеСУчетомИзменений(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		Область = ОбластиМакета["ЗаголовокКонец"];
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.РешениеДата, Истина));
		ТабДокумент.Вывести(Область);
		
		// АКТЫ, ОПРЕДЕЛЯЮЩИЕ ПОРЯДОК ПРОВЕДЕНИЯ ИНВЕНТАРИЗАЦИИ
		
		ВывестиАктыОбИнвентаризации(ТабДокумент, Данные["АктыОбИнвентаризации"], СтрокаШапки.Ссылка, ОбластиМакета);
		
		// РАЗДЕЛ 1
		
		ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		// РАЗДЕЛ 2
		
		ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			СтрокаШапки.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиСписокИзменяющихДокументов_РешениеСУчетомИзменений(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ДеревоДокументов = Данные.ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	Поиск = Новый Структура("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИзменяющиеДокументы = Новый Массив();
	
	СтрокаДокумента = МассивСтрок[0];
	
	Пока Истина Цикл
		Если СтрокаДокумента.НомерИзменения > 0 Тогда
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("Дата", СтрокаДокумента.Дата);
			ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
				СтрокаДокумента.Документ,
				СтрокаДокумента.Номер));
			ЗначенияПараметров.Вставить("НомерИзменения", СтрокаДокумента.НомерИзменения);
			
			ИзменяющиеДокументы.Добавить(ЗначенияПараметров);
		КонецЕсли;
		
		Если СтрокаДокумента.Родитель = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаДокумента = СтрокаДокумента.Родитель;
	КонецЦикла;
	
	КоличествоДокументов = ИзменяющиеДокументы.Количество();
	
	Для Счетчик = 1 По КоличествоДокументов Цикл
		Индекс = КоличествоДокументов - Счетчик;
		
		ЗначенияПараметров = ИзменяющиеДокументы[Индекс];
		
		Область = ОбластиМакета["ИзменяющийДокументСтрока"];
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

// Форма 0510447

Функция ПечатьФормы0510447(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода, ФорматПечати = "61н")
	
	Макет = ПолучитьМакетФормы0510447();
	
	КлючПараметровПечати = "ПечатьФормы0510447";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаДокументаИзмененияРешения(Макет, ФорматПечати);
	
	Данные = ПолучитьДанныеДокументовДляПечати(МассивОбъектов,, ФорматПечати);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыПечати0510447(ФорматПечати);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиДокументИзмененияРешения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати, ДополнительныеПараметры);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиДокументИзмененияРешения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати, ДополнительныеПараметры)
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// УТВЕРЖДАЮ
	
	ЗначенияПараметров = Новый Структура();
	
	ФИОУтверждаю = Справочники.Сотрудники.ФамилияИО(СтрокаШапки.Руководитель, Ложь, СтрокаШапки.Дата);
	
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", СтрокаШапки.Руководитель, СтрокаШапки.Дата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	ДолжностьУтверждаю = ДанныеПодписанта.Должность;
	
	ЗначенияПараметров.Вставить("Должность",	ДолжностьУтверждаю);
	ЗначенияПараметров.Вставить("ФИО",			ФИОУтверждаю);
	
	Область = ОбластиМакета["Утверждаю"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиРуководитель, Истина));
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	ЗначенияПараметров.Вставить("ОснованиеПроведения", СтрокаШапки.ОснованиеПроведения);
	ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("НомерИзменения", СтрокаШапки.НомерИзменения);
	ЗначенияПараметров.Вставить("НомерДокументаИзменения", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер));
		
	Область = ОбластиМакета["Заголовок"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// АКТЫ, ОПРЕДЕЛЯЮЩИЕ ПОРЯДОК ПРОВЕДЕНИЯ ИНВЕНТАРИЗАЦИИ
	
	ВывестиАктыОбИнвентаризации(ТабДокумент, Данные["АктыОбИнвентаризации"], СтрокаШапки.Ссылка, ОбластиМакета);
	
	// ЗАГОЛОВОК РЕШЕНИЯ
	
	НомерРешения = "";
		
	Если ЗначениеЗаполнено(СтрокаШапки.РешениеНомер) Тогда
		НомерРешения = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.Решение,
			СтрокаШапки.РешениеНомер);
	КонецЕсли;
	
	НомерДокументаИзменения = "";
	
	Если ЗначениеЗаполнено(СтрокаШапки.ПредыдущееИзменениеРешенияНомер) Тогда
		НомерДокументаИзменения = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.ПредыдущееИзменениеРешения,
			СтрокаШапки.ПредыдущееИзменениеРешенияНомер);
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ДатаРешения", СтрокаШапки.РешениеДата);
	ЗначенияПараметров.Вставить("НомерРешения", НомерРешения);
	ЗначенияПараметров.Вставить("ДатаИзменения", СтрокаШапки.ПредыдущееИзменениеРешенияДата);
	ЗначенияПараметров.Вставить("НомерИзменения", СтрокаШапки.ПредыдущееИзменениеРешенияНомерИзменения);
	ЗначенияПараметров.Вставить("НомерДокументаИзменения", НомерДокументаИзменения);
	
	Область = ОбластиМакета["ЗаголовокРешения"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 1
	
	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры);
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// РАЗДЕЛ 2
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// ПОДВАЛ
	
	ДанныеОтветственногоИсполнителя = ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки);
	
	Область = ОбластиМакета["Подвал"];
	Область.Параметры.Заполнить(ДанныеОтветственногоИсполнителя);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиОтветственный, Истина));
	ТабДокумент.Вывести(Область);
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры

Процедура ВывестиРаздел1(ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры)
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	ПечататьТолькоМодифицированные = ИнвентаризацияКлиентСервер.ПечататьТолькоМодифицированныеСтрокиИзмененияРешения();
	
	ДокументСсылка = СтрокаШапки.Ссылка;
	
	ТабДок.Вывести(ОбластиМакета["Раздел1Заголовок"]);
	
	ТабДок.Вывести(ОбластиМакета["Раздел1ШапкаТаблицы"]);
	
	ЗначенияПараметров = Новый Структура();
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = Данные["Объекты"].НайтиСтроки(Поиск);
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		Аннулирующее		= СтрокаШапки.Аннулирующее;
		ТипИзменения		= СтрокаТаблицы.ТипИзменения;
		Модифицированность	= СтрокаТаблицы.Модифицированность;
		
		Если Аннулирующее Тогда
			ВывестиСтроку = (ТипИзменения <> ТипИзмененияОтмена);
			
		ИначеЕсли ПечататьТолькоМодифицированные Тогда
			// Разрешаем вывод строки с пустым типом изменения, если он был сброшен
			ВывестиСтроку = Модифицированность;
		КонецЕсли;
		
		Если НЕ ВывестиСтроку Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ПечатьРешениеСУчетомИзменений") Тогда
			ВывестиСтрокуРаздела1_Решение(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры);
			
		ИначеЕсли ДополнительныеПараметры.ФорматПечати = "61н" Тогда
			ВывестиСтрокуРаздела1(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры);
			
		ИначеЕсли ДополнительныеПараметры.ФорматПечати = "157н" Тогда
			ВывестиСтрокуРаздела1Приказ157н(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры);
		КонецЕсли;
	
	КонецЦикла;
	
	ТабДок.Вывести(ОбластиМакета["Раздел1Подвал"]);
	
КонецПроцедуры

Процедура ВывестиСтрокуРаздела1(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры)
	
	Перем ДанныеСотрудникаДоИзменения;
	
	Аннулирующее		= СтрокаШапки.Аннулирующее;
	ТипИзменения		= СтрокаТаблицы.ТипИзменения;
	Модифицированность	= СтрокаТаблицы.Модифицированность;
	
	ЭтоКорректировка	= (ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	ЭтоОтмена			= (ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	
	ОбластьСтрока							= ОбластиМакета["Раздел1СтрокаТаблицы"];
	ОбластьСтрокаОтмена						= ОбластиМакета["Раздел1СтрокаТаблицыОтмена"];
	ОбластьСтрокаКорректировкаДоИзменения	= ОбластиМакета["Раздел1СтрокаТаблицыКорректировкаДоИзменения"];
	ОбластьСтрокаКорректировкаАктуальный	= ОбластиМакета["Раздел1СтрокаТаблицыКорректировкаАктуальный"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.Вставить("ДоИзменения", Новый Структура());
	КонецЕсли;
	
	ДобавитьПараметрыИзСтроки(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры, Аннулирующее, ЭтоКорректировка);
	
	ЗначенияПараметров.Актуальный.Вставить("НомерКомиссии",
		ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
			СтрокаТаблицы.НомерКомиссии,
			СтрокаТаблицы.НомерРабочейКомиссии,
			Истина));
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.ДоИзменения.Вставить("НомерКомиссии",
			ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
				СтрокаТаблицы.НомерКомиссииДоИзменения,
				СтрокаТаблицы.НомерРабочейКомиссииДоИзменения,
				Истина));
	КонецЕсли;
	
	ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(СтрокаТаблицы, Истина);
	
	ПолучитьДолжность = Истина;
	
	ДанныеСотрудника = Новый Структура();
	
	Сотрудник = СтрокаТаблицы.Сотрудник;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		ВремСтруктура = ПолучитьДанныеСотрудника(
			Данные["ДанныеСотрудников"].Получить(СтрокаШапки.Дата),
			Сотрудник,
			ПолучитьДолжность);
	Иначе
		ВремСтруктура = Новый Структура("ФИО,Должность", "Х", "Х");
	КонецЕсли;
	ДанныеСотрудника.Вставить("Актуальный", ВремСтруктура);
	
	Если ЭтоКорректировка Тогда
		Сотрудник = СтрокаТаблицы.СотрудникДоИзменения;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ВремСтруктура = ПолучитьДанныеСотрудника(
				Данные["ДанныеСотрудников"].Получить(СтрокаШапки.Дата),
				Сотрудник,
				ПолучитьДолжность);
		Иначе
			ВремСтруктура = Новый Структура("ФИО,Должность", "Х", "Х");
		КонецЕсли;
		ДанныеСотрудника.Вставить("ДоИзменения", ВремСтруктура);
	КонецЕсли;
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	// Опциональная строка
	Если ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаДоИзменения;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.ДоИзменения);
		Область.Параметры.Заполнить(ПредставлениеСчета.ДоИзменения);
		Область.Параметры.Заполнить(ДанныеСотрудника.ДоИзменения);
		
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	// Обязательная строка
	Если ЭтоОтмена Тогда
		Область = ОбластьСтрокаОтмена;
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаАктуальный;
	Иначе
		Область = ОбластьСтрока;
	КонецЕсли;
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
	Область.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
	Область.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
	
	Если ЭтоКорректировка Тогда
		ЗавершитьВыводСтрокиКорректировки(СтрокаТаблицы, ТабДок, Область, ДополнительныеПараметры);
	Иначе
		ТабДок.Вывести(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗавершитьВыводСтрокиКорректировки(СтрокаТаблицы, ТабДок, ОбластьСтрокаАктуальная, ДополнительныеПараметры)
	
	КоличествоГраф = 12;
	
	ТабДок.Вывести(ОбластьСтрокаАктуальная);
	
	// Выводим строку повторно (лишняя строка) для сохранения правых и нижних границ
	// при последующем удалении и объединении областей 
	ТабДок.Вывести(ОбластьСтрокаАктуальная);
	
	НомераГрафПоказателиРазличные = ОпределитьНомераГрафРаздела1ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры);
	
	НомерЛишнейСтроки		= ТабДок.ВысотаТаблицы;
	НомерСтрокиАктуальный	= НомерЛишнейСтроки - 1;
	НомерСтрокиДоИзменения	= НомерЛишнейСтроки - 2;
	
	Для НомерГрафы = 1 По КоличествоГраф Цикл
		
		ПоказателиРазличные = (НомераГрафПоказателиРазличные.Найти(НомерГрафы) <> Неопределено);
		
		Если ПоказателиРазличные Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьЯчейкаСтрокиДоИзменения = ТабДок.Область(НомерСтрокиДоИзменения, НомерГрафы, НомерСтрокиДоИзменения, НомерГрафы);
		
		ОбластьЯчейкиДвухСтрок = ТабДок.Область(НомерСтрокиДоИзменения, НомерГрафы, НомерСтрокиАктуальный, НомерГрафы);
		
		ТабДок.УдалитьОбласть(ОбластьЯчейкаСтрокиДоИзменения, ТипСмещенияТабличногоДокумента.ПоВертикали);
		
		ОбластьЯчейкиДвухСтрок.Объединить();
	КонецЦикла;
	
	ОбластьЛишняяСтрока	= ТабДок.Область(НомерЛишнейСтроки,, НомерЛишнейСтроки);
	
	ТабДок.УдалитьОбласть(ОбластьЛишняяСтрока, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры

Процедура ДобавитьПараметрыИзСтроки(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры, Аннулирующее, ЭтоКорректировка)
	
	НомерСтроки = СтрокаТаблицы.НомерСтроки;
	
	Если НомерСтроки <= 999 Тогда
		КодСтроки = Формат(НомерСтроки, "ЧЦ=3;ЧВН=;ЧГ=");
	Иначе
		// Код строки состоит из более чем 3 разрядов.
		КодСтроки = Формат(НомерСтроки, "ЧГ=");
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("КодСтроки", КодСтроки);
	
	Если Аннулирующее Тогда
		ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Аннулирование;
	Иначе
		ТипИзменения = СтрокаТаблицы.ТипИзменения;
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ТипИзменения", ТипИзменения);
	
	ЗначенияПараметров.Вставить("Примечание", СтрокаТаблицы.Примечание);
	
	ИменаПоказателей = ДополнительныеПараметры.НастройкиДокумента.ТаблицаОбъекты.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= ДополнительныеПараметры.НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= ДополнительныеПараметры.НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		ЗначенияПараметров.Актуальный.Вставить(ИмяПоказателя, СтрокаТаблицы[ИмяПоказателя + ПостфиксАктуальный]);
		
		Если ЭтоКорректировка Тогда
			ЗначенияПараметров.ДоИзменения.Вставить(ИмяПоказателя, СтрокаТаблицы[ИмяПоказателя + ПостфиксДоИзменения]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеДокументовДляПечати(МассивОбъектов, ПечатьРешениеСУчетомИзменений = Ложь, ФорматПечати = "61н")
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата", '00010101');
	ЗапросПоиск.УстановитьПараметр("ПустаяСтрока", "");
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзменениеРешения.Ссылка													КАК Ссылка,
	|	ИзменениеРешения.Номер													КАК Номер,
	|	ИзменениеРешения.Дата													КАК Дата,
	|	ИзменениеРешения.Организация											КАК Организация,
	|	ИзменениеРешения.Организация.НаименованиеПолное							КАК НаименованиеОрганизации,
	|	ИзменениеРешения.Подразделение											КАК Подразделение,
	|	ИзменениеРешения.Подразделение.Наименование								КАК НаименованиеПодразделения,
	|	ИзменениеРешения.ОснованиеПроведенияИнвентаризации.НаименованиеПолное	КАК ОснованиеПроведения,
	|	ИзменениеРешения.Комментарий											КАК Комментарий,
	|	ИзменениеРешения.Ответственный											КАК Ответственный,
	|	ИзменениеРешения.ОтветственныйИсполнитель								КАК ОтветственныйИсполнитель,
	|	ИзменениеРешения.ДатаПодписиРуководитель								КАК ДатаПодписиРуководитель,
	|	ИзменениеРешения.ДатаПодписиОтветственный								КАК ДатаПодписиОтветственный,
	|	ИзменениеРешения.Руководитель											КАК Руководитель,
	|	
	|	ИзменениеРешения.НомерИзменения											КАК НомерИзменения,
	|	ИзменениеРешения.Аннулирующее											КАК Аннулирующее,
	|	
	|	Решение																	КАК Решение,
	|	ЕСТЬNULL(ДокументРешения.Дата, &ПустаяДата)								КАК РешениеДата,
	|	ЕСТЬNULL(ДокументРешения.Номер, &ПустаяСтрока)							КАК РешениеНомер,
	|	
	|	ПредыдущееИзменениеРешения												КАК ПредыдущееИзменениеРешения,
	|	ЕСТЬNULL(ПредыдущееИзменениеРешения.Дата, &ПустаяДата)					КАК ПредыдущееИзменениеРешенияДата,
	|	ЕСТЬNULL(ПредыдущееИзменениеРешения.Номер, &ПустаяСтрока)				КАК ПредыдущееИзменениеРешенияНомер,
	|	ЕСТЬNULL(ПредыдущееИзменениеРешения.НомерИзменения, &ПустаяСтрока)		КАК ПредыдущееИзменениеРешенияНомерИзменения
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК ИзменениеРешения
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации КАК ДокументРешения
	|		ПО	ИзменениеРешения.Решение = ДокументРешения.Ссылка
	|ГДЕ
	|	ИзменениеРешения.Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	ИзменениеРешения.Дата ВОЗР
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица объектов инвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка											КАК Ссылка,
	|	НомерСтроки										КАК НомерСтроки,
	|	Примечание										КАК Примечание,
	|	ТипИзменения									КАК ТипИзменения,
	|	Модифицированность								КАК Модифицированность,
	|	// Показатели актуальные
	|	КФО												КАК КФО,
	|	ПРЕДСТАВЛЕНИЕ(КФО)								КАК КФОНаименование,
	|	Счет											КАК Счет,
	|	ЕСТЬNULL(Счет.Код, """")							КАК СчетКод,
	|	ЕСТЬNULL(Счет.Наименование, """")					КАК СчетНаименование,
	|	ЕСТЬNULL(Счет.УчетПоКЭК, ЛОЖЬ)					КАК СчетУчетПоКЭК,
	|	ЕСТЬNULL(Счет.Забалансовый, ЛОЖЬ)				КАК СчетЗабалансовый,
	|	Сотрудник										КАК Сотрудник,
	|	ДатаИнвентаризации								КАК ДатаИнвентаризации,
	|	ДатаНачала										КАК ДатаНачала,
	|	ДатаОкончания									КАК ДатаОкончания,
	|	НомерКомиссии									КАК НомерКомиссии,
	|	НомерРабочейКомиссии							КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации								КАК МестоИнвентаризации,
	|	// Показатели до изменения
	|	КФОДоИзменения									КАК КФОДоИзменения,
	|	ПРЕДСТАВЛЕНИЕ(КФОДоИзменения)					КАК КФОДоИзмененияНаименование,
	|	СчетДоИзменения									КАК СчетДоИзменения,
	|	ЕСТЬNULL(СчетДоИзменения.Код, """")				КАК СчетДоИзмененияКод,
	|	ЕСТЬNULL(СчетДоИзменения.Наименование, """")		КАК СчетДоИзмененияНаименование,
	|	ЕСТЬNULL(СчетДоИзменения.УчетПоКЭК, ЛОЖЬ)		КАК СчетДоИзмененияУчетПоКЭК,
	|	ЕСТЬNULL(СчетДоИзменения.Забалансовый, ЛОЖЬ)	КАК СчетДоИзмененияЗабалансовый,
	|	СотрудникДоИзменения							КАК СотрудникДоИзменения,
	|	ДатаИнвентаризацииДоИзменения					КАК ДатаИнвентаризацииДоИзменения,
	|	ДатаНачалаДоИзменения							КАК ДатаНачалаДоИзменения,
	|	ДатаОкончанияДоИзменения						КАК ДатаОкончанияДоИзменения,
	|	НомерКомиссииДоИзменения						КАК НомерКомиссииДоИзменения,
	|	НомерРабочейКомиссииДоИзменения					КАК НомерРабочейКомиссииДоИзменения,
	|	МестоИнвентаризацииДоИзменения					КАК МестоИнвентаризацииДоИзменения
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица актов о проведении инвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	Наименование	КАК Наименование,
	|	Дата			КАК Дата,
	|	Номер			КАК Номер
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.АктыОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	ДанныеДокументов = Новый Структура();
	
	// [0]. Шапки документов
	ДанныеДокументов.Вставить("Шапки", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Таблица объектов инвентаризации
	ДанныеДокументов.Вставить("Объекты", РезультатыЗапроса[1].Выгрузить());
	
	// [2]. Таблица актов о проведении инвентаризации
	ДанныеДокументов.Вставить("АктыОбИнвентаризации", РезультатыЗапроса[2].Выгрузить());
	
	ДанныеДокументов.Вставить("ДанныеСотрудников", ПолучитьДанныеСотрудников(МассивОбъектов, "Объекты,Комиссии"));
	
	ДанныеДокументов.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	ДанныеВосходящихЦепочек = ИнвентаризацияСервер.ПолучитьДанныеВосходящихЦепочек(МассивОбъектов,, ПечатьРешениеСУчетомИзменений, ФорматПечати);
	
	ДанныеДокументов.Вставить("ДанныеВосходящихЦепочек", ДанныеВосходящихЦепочек);
	
	Если ПечатьРешениеСУчетомИзменений Тогда
		ПреобразоватьТаблицуОбъектыВАктуальныеНаДату(ДанныеДокументов.Объекты);
	КонецЕсли;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Функция ПолучитьСписокСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	МассивИмен = СтрРазделить(ИменаТабличныхЧастей, ", ", Ложь);
	
	ВыбиратьИзТЧОбъекты				= (МассивИмен.Найти("Объекты") <> Неопределено);
	ВыбиратьИзТЧКомиссии			= (МассивИмен.Найти("Комиссии") <> Неопределено);
	ВыбиратьИзТЧЛистОзнакомления	= (МассивИмен.Найти("ЛистОзнакомления") <> Неопределено);
	ВыбиратьИзТЧЛистСогласования	= (МассивИмен.Найти("ЛистСогласования") <> Неопределено);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",					МассивДокументов);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧКомиссии",			ВыбиратьИзТЧКомиссии);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧОбъекты",			ВыбиратьИзТЧОбъекты);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧЛистОзнакомления",	ВыбиратьИзТЧЛистОзнакомления);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧЛистСогласования",	ВыбиратьИзТЧЛистСогласования);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Полный список всех сотрудников
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧСоставКомиссии.Сотрудник	КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО	&ВыбиратьИзТЧКомиссии
	|		И	Док.Ссылка = ТЧКомиссии.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО	ТЧКомиссии.Комиссия = ТЧСоставКомиссии.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧСоставКомиссии.Сотрудник	КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО	&ВыбиратьИзТЧКомиссии
	|		И	Док.Ссылка = ТЧКомиссии.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО	ТЧКомиссии.КомиссияДоИзменения = ТЧСоставКомиссии.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.Сотрудник				КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧ
	|		ПО	&ВыбиратьИзТЧОбъекты
	|		И	Док.Ссылка = ТЧ.Ссылка
	|		И	ТЧ.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.СотрудникДоИзменения		КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧ
	|		ПО	&ВыбиратьИзТЧОбъекты
	|		И	Док.Ссылка = ТЧ.Ссылка
	|		И	ТЧ.СотрудникДоИзменения <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	Сотрудник					КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.ЛистОзнакомления КАК ТЧ
	|		ПО	&ВыбиратьИзТЧЛистОзнакомления
	|		И	Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	Сотрудник					КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.ЛистСогласования КАК ТЧ
	|		ПО	&ВыбиратьИзТЧЛистСогласования
	|		И	Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)";
	
	ТаблицаСотрудников = ЗапросПоиск.Выполнить().Выгрузить();
	
	ВремТаблица = ТаблицаСотрудников.Скопировать(, "ДатаОпределенияСведений");
	ВремТаблица.Свернуть("ДатаОпределенияСведений");
	
	ДатыОпределенияСведений = ВремТаблица.ВыгрузитьКолонку("ДатаОпределенияСведений");
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаСотрудников",		ТаблицаСотрудников);
	Результат.Вставить("ДатыОпределенияСведений",	ДатыОпределенияСведений);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки)
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	СтрокаШапки.ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			СтрокаШапки.Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	Результат = Новый Структура();
	Результат.Вставить("Должность",	ДанныеСотрудника.ДолжностьНаименование);
	Результат.Вставить("ФИО",		КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника));
	Результат.Вставить("Телефон",	ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	Результат.Вставить("Адрес",		ДанныеСотрудника.EmailФизическиеЛица);
	
	Возврат Результат;

КонецФункции

Процедура ПреобразоватьТаблицуОбъектыВАктуальныеНаДату(ТаблицаОбъекты)
	
	Поиск = Новый Структура("ТипИзменения", Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	
	МассивУдалить = ТаблицаОбъекты.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаУдалить Из МассивУдалить Цикл
		ТаблицаОбъекты.Удалить(СтрокаУдалить);
	КонецЦикла;
	
	ТаблицаОбъекты.ЗаполнитьЗначения(Истина, "Модифицированность");
	ТаблицаОбъекты.ЗаполнитьЗначения(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка(), "ТипИзменения");
	
КонецПроцедуры

Процедура ВывестиСтрокуРаздела1_Решение(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры)
	
	Аннулирующее = СтрокаШапки.Аннулирующее;
	
	ОбластьСтрока = ОбластиМакета["Раздел1СтрокаТаблицы"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	Если Аннулирующее Тогда
		ЗначенияПараметров.Вставить("КодСтроки", СтрокаТаблицы.НомерСтроки);

		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
		
	Иначе
		ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
		
		ДобавитьПараметрыИзСтроки(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры, Аннулирующее, Ложь);
		
		ЗначенияПараметров.Актуальный.Вставить("НомерКомиссии",
			ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
				СтрокаТаблицы.НомерКомиссии,
				СтрокаТаблицы.НомерРабочейКомиссии,
				Истина));
		
		ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(СтрокаТаблицы, Истина);
		
		ПолучитьДолжность = Истина;
		
		ДанныеСотрудника = Новый Структура();
		
		Сотрудник = СтрокаТаблицы.Сотрудник;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ВремСтруктура = ПолучитьДанныеСотрудника(
				Данные["ДанныеСотрудников"].Получить(СтрокаШапки.Дата),
				Сотрудник,
				ПолучитьДолжность);
		Иначе
			ВремСтруктура = Новый Структура("ФИО,Должность", "Х", "Х");
		КонецЕсли;
		
		ДанныеСотрудника.Вставить("Актуальный", ВремСтруктура);
		
		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		ОбластьСтрока.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
		ОбластьСтрока.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
	КонецЕсли;
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	ТабДок.Вывести(ОбластьСтрока);
	
КонецПроцедуры

#Область Приказ157н

Процедура ВывестиСтрокуРаздела1Приказ157н(СтрокаТаблицы, ТабДок, Данные, СтрокаШапки, ОбластиМакета, ДополнительныеПараметры)
	
	Перем ДанныеСотрудникаДоИзменения;
	
	Аннулирующее		= СтрокаШапки.Аннулирующее;
	ТипИзменения		= СтрокаТаблицы.ТипИзменения;
	Модифицированность	= СтрокаТаблицы.Модифицированность;
	
	ЭтоКорректировка	= (ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	ЭтоОтмена			= (ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	ЭтоДополнение		= (ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение);
	ЭтоПустой			= Не ЗначениеЗаполнено(ТипИзменения);
	
	ОбластьСтрокаПустая						= ОбластиМакета["Раздел1СтрокаТаблицыПриказ157нПустая"];
	ОбластьСтрокаДополнение					= ОбластиМакета["Раздел1СтрокаТаблицыПриказ157нДополнение"];
	ОбластьСтрокаОтмена						= ОбластиМакета["Раздел1СтрокаТаблицыПриказ157нОтмена"];
	ОбластьСтрокаКорректировкаДоИзменения	= ОбластиМакета["Раздел1СтрокаТаблицыПриказ157нКорректировкаДоИзменения"];
	ОбластьСтрокаКорректировкаАктуальный	= ОбластиМакета["Раздел1СтрокаТаблицыПриказ157нКорректировкаАктуальный"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.Вставить("ДоИзменения", Новый Структура());
	КонецЕсли;
	
	ДобавитьПараметрыИзСтроки(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры, Аннулирующее, ЭтоКорректировка);
	
	ЗначенияПараметров.Актуальный.Вставить("НомерКомиссии",
		ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
			СтрокаТаблицы.НомерКомиссии,
			СтрокаТаблицы.НомерРабочейКомиссии,
			Истина));
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.ДоИзменения.Вставить("НомерКомиссии",
			ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
				СтрокаТаблицы.НомерКомиссииДоИзменения,
				СтрокаТаблицы.НомерРабочейКомиссииДоИзменения,
				Истина));
	КонецЕсли;
	
	ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(СтрокаТаблицы, Истина);
	
	ПолучитьДолжность = Истина;
	
	ДанныеСотрудника = Новый Структура();
	
	Сотрудник = СтрокаТаблицы.Сотрудник;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		ВремСтруктура = ПолучитьДанныеСотрудника(
			Данные["ДанныеСотрудников"].Получить(СтрокаШапки.Дата),
			Сотрудник,
			ПолучитьДолжность);
	Иначе
		ВремСтруктура = Новый Структура("ФИО,Должность", "Х", "Х");
	КонецЕсли;
	ДанныеСотрудника.Вставить("Актуальный", ВремСтруктура);
	
	Если ЭтоКорректировка Тогда
		Сотрудник = СтрокаТаблицы.СотрудникДоИзменения;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ВремСтруктура = ПолучитьДанныеСотрудника(
				Данные["ДанныеСотрудников"].Получить(СтрокаШапки.Дата),
				Сотрудник,
				ПолучитьДолжность);
		Иначе
			ВремСтруктура = Новый Структура("ФИО,Должность", "Х", "Х");
		КонецЕсли;
		ДанныеСотрудника.Вставить("ДоИзменения", ВремСтруктура);
	КонецЕсли;
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	// Первая строка
	
	Если ЭтоДополнение Тогда
		Область = ОбластьСтрокаПустая;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли ЭтоОтмена Тогда
		Область = ОбластьСтрокаОтмена;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		Область.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
		Область.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
		
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаДоИзменения;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.ДоИзменения);
		Область.Параметры.Заполнить(ПредставлениеСчета.ДоИзменения);
		Область.Параметры.Заполнить(ДанныеСотрудника.ДоИзменения);
		
	ИначеЕсли ЭтоПустой Тогда
		Область = ОбластьСтрокаДополнение;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		Область.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
		Область.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
	КонецЕсли;
	
	ТабДок.Вывести(Область);
	
	// Вторая строка
	Если ЭтоДополнение Или ЭтоПустой Тогда
		Область = ОбластьСтрокаДополнение;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		Область.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
		Область.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
		
	ИначеЕсли ЭтоОтмена Тогда
		Область = ОбластьСтрокаПустая;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаАктуальный;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		Область.Параметры.Заполнить(ПредставлениеСчета.Актуальный);
		Область.Параметры.Заполнить(ДанныеСотрудника.Актуальный);
	КонецЕсли;
	
	Если Не ЭтоПустой Тогда
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	Если ЭтоКорректировка Тогда
		ВыделитьИзмененныеЗначенияКорректировкиРаздел1Приказ157н(СтрокаТаблицы, ТабДок, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыделитьИзмененныеЗначенияКорректировкиРаздел1Приказ157н(СтрокаТаблицы, ТабДок, ДополнительныеПараметры)
	
	КоличествоГраф = 12;
	
	НомераГрафПоказателиРазличные = ОпределитьНомераГрафРаздела1ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры);
	
	НомерПоследнейСтроки = ТабДок.ВысотаТаблицы;
	
	Для НомерГрафы = 1 По КоличествоГраф Цикл
		ПоказателиРазличные = (НомераГрафПоказателиРазличные.Найти(НомерГрафы) <> Неопределено);
		
		Если Не ПоказателиРазличные Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьЯчейка = ТабДок.Область(НомерПоследнейСтроки, НомерГрафы, НомерПоследнейСтроки, НомерГрафы);
		
		ЗаполнитьЗначенияСвойств(ОбластьЯчейка, ДополнительныеПараметры.ОформлениеИзмененныхЗначенийКорректировкиПриказ157н.Раздел1);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Раздел 1

Функция ПолучитьСоответствиеПоказателейИГрафРаздела1()
	
	Результат = Новый Структура();
	
	Показатель = "Счет";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(2);
	Результат[Показатель].Добавить(3);
	
	Показатель = "КФО";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(3);
	
	Показатель = "Сотрудник";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(4);
	Результат[Показатель].Добавить(5);
	
	Показатель = "ДатаИнвентаризации";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(6);
	
	Показатель = "ДатаНачала";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(7);
	
	Показатель = "ДатаОкончания";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(8);
	
	Показатель = "НомерКомиссии";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(9);
	
	Показатель = "НомерРабочейКомиссии";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(9);
	
	Показатель = "МестоИнвентаризации";
	Результат.Вставить(Показатель, Новый Массив());
	Результат[Показатель].Добавить(10);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьНомераГрафРаздела1ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры)
	
	НомераГраф = Новый Массив();
	
	СоответствиеГраф = ДополнительныеПараметры.СоответствиеПоказателейИГрафРаздела1;
	
	ИменаПоказателей = ДополнительныеПараметры.НастройкиДокумента.ТаблицаОбъекты.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= ДополнительныеПараметры.НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= ДополнительныеПараметры.НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		Если СтрокаТаблицы[ИмяПоказателя + ПостфиксАктуальный] = СтрокаТаблицы[ИмяПоказателя + ПостфиксДоИзменения] Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаГраф = СоответствиеГраф[ИмяПоказателя];
		
		Для Каждого НомерГрафы Из НастройкаГраф Цикл
			Если НомераГраф.Найти(НомерГрафы) = Неопределено Тогда
				НомераГраф.Добавить(НомерГрафы);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НомераГраф;
	
КонецФункции

// Раздел 2

Процедура ВывестиРаздел2(ТабДок, Данные, СтрокаШапки, ОбластиМакета)
	
	ДанныеВосходящихЦепочек = Данные["ДанныеВосходящихЦепочек"];
	
	ДеревоДокументов = ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	ТабДок.Вывести(ОбластиМакета["Раздел2Заголовок"]);
	
	Поиск = Новый Структура("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
	
	Для Каждого СтрокаДокумента Из МассивСтрок Цикл
		
		ТаблицаПодразделов = СтрокаДокумента["ТаблицаПодразделовРаздела2"];
		
		НомерПодраздела = 0;
		
		Для Каждого СтрокаПодраздела Из ТаблицаПодразделов Цикл
			
			НомерПодраздела = НомерПодраздела + 1;
			
			ВывестиРаздел = СтрокаШапки.Аннулирующее ИЛИ СтрокаПодраздела["ЕстьМодифицированныеСтроки"];
			
			Если НЕ ВывестиРаздел Тогда
				Продолжить;
			КонецЕсли;
			
			ВывестиЗаголовокПодразделаРаздела2(ТабДок, Данные, СтрокаШапки, ОбластиМакета,
				СтрокаПодраздела["КомиссияЗаголовка"],
				НомерПодраздела);
			
			ТабДок.Вывести(СтрокаПодраздела["ТабличныйДокумент"]);
			
			// Восстановим ширину колонок, если она сбилась из-за выполненного удаления первой колонки
			НомерСтроки = ТабДок.ВысотаТаблицы;
			
			КоличествоСтрокОбластиПодраздела = СтрокаПодраздела["ТабличныйДокумент"].ВысотаТаблицы;
			
			Для НомерКолонки = 1 По СтрокаПодраздела["ТабличныйДокумент"].ШиринаТаблицы Цикл
				ОбластьПодраздела = СтрокаПодраздела["ТабличныйДокумент"].Область(КоличествоСтрокОбластиПодраздела, НомерКолонки, КоличествоСтрокОбластиПодраздела, НомерКолонки);
				
				Если НомерКолонки = 1 И ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).ШиринаКолонки = ОбластьПодраздела.ШиринаКолонки Тогда
					Прервать;
				КонецЕсли;
				
				ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).ШиринаКолонки = ОбластьПодраздела.ШиринаКолонки;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластиМакета["Раздел2Подвал"]);
	
КонецПроцедуры

Процедура ВывестиЗаголовокПодразделаРаздела2(ТабДок, Данные, СтрокаШапки, ОбластиМакета, КомиссияСсылка, НомерПодраздела)
	
	// НОМЕР КОМИССИИ
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерКомиссии", ИнвентаризацияКлиентСервер.ФорматироватьНомерКомиссии(НомерПодраздела, Истина));
	
	Область = ОбластиМакета["Раздел2НомерКомиссии"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДок.Вывести(Область);
	
	// АКТЫ, ОПРЕДЕЛЯЮЩИЕ СОСТАВ КОМИССИИ
	
	ВывестиАктыОСоставеКомиссии(ТабДок, Данные.ДанныеВосходящихЦепочек.ДанныеКомиссий, КомиссияСсылка, ОбластиМакета);
	
КонецПроцедуры

Процедура ВывестиАктыОбИнвентаризации(ТабДок, ТаблицаАктыОбИнвентаризации, ДокументСсылка, ОбластиМакета, МинимальноеКоличествоСтрок = 2)
	
	Область = ОбластиМакета["СтрокаАкта"];
	
	ОчищающаяСтруктура = Новый Структура("Наименование,Номер,Дата");
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = ТаблицаАктыОбИнвентаризации.НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДок, МассивСтрок, Область, ОчищающаяСтруктура, 2, 2);
	
КонецПроцедуры

Процедура ВывестиАктыОСоставеКомиссии(ТабДок, ДанныеКомиссий, КомиссияСсылка, ОбластиМакета, МинимальноеКоличествоСтрок = 2)
	
	Область = ОбластиМакета["Раздел2СтрокаАкта"];
	
	ОчищающаяСтруктура = Новый Структура("Наименование,Номер,Дата");
	
	Поиск = Новый Структура("Ссылка", КомиссияСсылка);
	
	МассивСтрок = ДанныеКомиссий["АктыОСоставеКомиссий"].НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДок, МассивСтрок, Область, ОчищающаяСтруктура, 2, 2);
	
КонецПроцедуры

// Лист согласования

Функция ПечатьЛистСогласования(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510447();
	
	КлючПараметровПечати = "ЛистСогласованияФ0510447";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаЛистаСогласования(Макет);
	
	Данные = ПолучитьДанныеЛистовСогласованияДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиЛистСогласования(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати);
			
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЛистСогласования(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати)

	Поиск = Новый Структура();
	Поиск.Вставить("ВидДействия", Перечисления.ВидыДействийСотрудникаСДокументом.Согласование);
	
	ЗначенияПараметров = Новый Структура();
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// ЗАГОЛОВОК
	
	Область = ОбластиМакета["ЛистСогласованияЗаголовок"];
	
	ЗначенияПараметров.Вставить("НомерИзменения", СтрокаШапки.НомерИзменения);
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ТАБЛИЦА
	
	Область = ОбластиМакета["ЛистСогласованияСтрока"];
	
	КомпонентыПустойДаты = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи('00010101', Истина);
	
	ОчищающаяСтруктура = Новый Структура("Должность,Подразделение,ДолжностьПодразделение,ФИО,Дня,Месяца,Года");
	
	ЗаполнитьЗначенияСвойств(ОчищающаяСтруктура, КомпонентыПустойДаты);
	
	Поиск.Вставить("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = Данные["ТаблицаСотрудников"].НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДокумент, МассивСтрок, Область, ОчищающаяСтруктура, 3);
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры

Функция ПолучитьДанныеЛистовСогласованияДляПечати(МассивДокументов)
	
	ДанныеЛистовСогласования = ПолучитьДанныеЛистовСогласования(МассивДокументов);
	
	ДополнитьДанныеЛистовСогласованияДляПечати(ДанныеЛистовСогласования, МассивДокументов);
	
	Возврат ДанныеЛистовСогласования;
	
КонецФункции

Функция ПолучитьДанныеЛистовСогласования(МассивДокументов)

	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	НомерИзменения	КАК НомерИзменения,
	|	Номер			КАК Номер,
	|	Дата			КАК Дата,
	|	Аннулирующее	КАК Аннулирующее,
	|	Решение			КАК Решение,
	|	Решение.Номер	КАК РешениеНомер,
	|	Решение.Дата	КАК РешениеДата
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ТаблицаШапки = ЗапросПоиск.Выполнить().Выгрузить();
	
	ТаблицаСотрудников = ОбщегоНазначенияБГУ.РезультатыОзнакомленияСотрудниковПоДокументам(МассивДокументов, "ЛистСогласования");
	
	ДанныеЛистовСогласования = Новый Структура();
	ДанныеЛистовСогласования.Вставить("Шапки", ТаблицаШапки);
	ДанныеЛистовСогласования.Вставить("ТаблицаСотрудников", ТаблицаСотрудников);
	
	Возврат ДанныеЛистовСогласования;

КонецФункции

Процедура ДополнитьДанныеЛистовСогласованияДляПечати(ДанныеЛистовСогласования, МассивОбъектов)
	
	Таблица = ДанныеЛистовСогласования["ТаблицаСотрудников"];
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Таблица.Колонки.Добавить("ДолжностьПодразделение",	ТипСтрока);
	Таблица.Колонки.Добавить("ФИО",						ТипСтрока);
	Таблица.Колонки.Добавить("Дня",						ТипСтрока);
	Таблица.Колонки.Добавить("Месяца",					ТипСтрока);
	Таблица.Колонки.Добавить("Года",					ТипСтрока);
	
	ДанныеСотрудников = ПолучитьДанныеСотрудников(МассивОбъектов, "ЛистСогласования");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДанныеСотрудников.Получить(СтрокаТаблицы.ДокументДата),
			СтрокаТаблицы.Сотрудник,
			Истина,		// ПолучитьДолжность
			Истина);	// ПолучитьПодразделение
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСотрудника);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаТаблицы.Дата, Истина), "Дня,Месяца,Года");
		
	КонецЦикла;
	
КонецПроцедуры

// Лист ознакомления

Функция ПечатьЛистОзнакомления(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510447();
	
	КлючПараметровПечати = "ЛистОзнакомленияФ0510447";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаЛистаОзнакомления(Макет);
	
	Данные = ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиЛистОзнакомления(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЛистОзнакомления(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати)

	ПечататьТолькоМодифицированныеСтрокиЛистаОзнакомления = ИнвентаризацияКлиентСервер.ПечататьТолькоМодифицированныеСтрокиЛистаОзнакомления();
	
	ПервыйДокумент = Истина;
	
	Поиск = Новый Структура();
	Поиск.Вставить("ВидДействия", Перечисления.ВидыДействийСотрудникаСДокументом.Ознакомление);
	
	ЗначенияПараметров = Новый Структура();
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// ЗАГОЛОВОК
	
	Область = ОбластиМакета["ЛистОзнакомленияЗаголовок"];
	
	ЗначенияПараметров.Вставить("НомерИзменения", СтрокаШапки.НомерИзменения);

	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ТАБЛИЦА
	
	Область = ОбластиМакета["ЛистОзнакомленияСтрока"];
	
	Поиск.Вставить("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = Данные["ТаблицаСотрудников"].НайтиСтроки(Поиск);
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ВывестиСтроку = Истина;
		
		Если Не СтрокаШапки.Аннулирующее И ПечататьТолькоМодифицированныеСтрокиЛистаОзнакомления Тогда
			ВывестиСтроку = СтрокаТаблицы.Модифицированность;
		КонецЕсли;
		
		Если Не ВывестиСтроку Тогда
			Продолжить;
		КонецЕсли;
		
		Область.Параметры.Заполнить(СтрокаТаблицы);
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	// В табличном документе зададим имя области, в которую был выведен объект.
	// Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры

Функция ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивДокументов)
	
	ДанныеЛистовОзнакомления = ПолучитьДанныеЛистовОзнакомления(МассивДокументов);
	
	ДополнитьДанныеЛистовОзнакомленияДляПечати(ДанныеЛистовОзнакомления, МассивДокументов);
	
	Возврат ДанныеЛистовОзнакомления;
	
КонецФункции

Функция ПолучитьДанныеЛистовОзнакомления(МассивДокументов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	НомерИзменения	КАК НомерИзменения,
	|	Номер			КАК Номер,
	|	Дата			КАК Дата,
	|	Аннулирующее	КАК Аннулирующее,
	|	Решение			КАК Решение,
	|	Решение.Номер	КАК РешениеНомер,
	|	Решение.Дата	КАК РешениеДата
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ТаблицаШапки = ЗапросПоиск.Выполнить().Выгрузить();
	
	ТаблицаСотрудников = ОбщегоНазначенияБГУ.РезультатыОзнакомленияСотрудниковПоДокументам(МассивДокументов, "ЛистОзнакомления");
	
	ДополнитьТаблицуЛистаОзнакомленияПризнакамиМодифицированностиСтрок(ТаблицаСотрудников, МассивДокументов);
	
	ДанныеЛистовОзнакомления = Новый Структура();
	ДанныеЛистовОзнакомления.Вставить("Шапки", ТаблицаШапки);
	ДанныеЛистовОзнакомления.Вставить("ТаблицаСотрудников", ТаблицаСотрудников);
	
	Возврат ДанныеЛистовОзнакомления;
	
КонецФункции

Процедура ДополнитьТаблицуЛистаОзнакомленияПризнакамиМодифицированностиСтрок(ТаблицаСотрудников, МассивДокументов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Документ,
	|	НомерСтроки			КАК НомерСтроки,
	|	Модифицированность	КАК Модифицированность
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.ЛистОзнакомления
	|ГДЕ
	|	Ссылка В(&МассивСсылок)";
	
	ТаблицаМодифицированности = ЗапросПоиск.Выполнить().Выгрузить();
	
	Поиск = Новый Структура("Документ,НомерСтроки");
	
	ТаблицаСотрудников.Колонки.Добавить("Модифицированность", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицыСотрудников Из ТаблицаСотрудников Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыСотрудников, "Документ,НомерСтроки");
		
		МассивСтрок = ТаблицаМодифицированности.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыМодифицированности = МассивСтрок[0];
		
		СтрокаТаблицыСотрудников.Модифицированность = СтрокаТаблицыМодифицированности.Модифицированность;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьДанныеЛистовОзнакомленияДляПечати(ДанныеЛистовОзнакомления, МассивОбъектов)
	
	ТаблицаСотрудников = ДанныеЛистовОзнакомления["ТаблицаСотрудников"];
	
	ТаблицаСотрудников.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка"));
	
	ДанныеСотрудников = ПолучитьДанныеСотрудников(МассивОбъектов, "ЛистОзнакомления");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСотрудников Цикл
		
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДанныеСотрудников.Получить(СтрокаТаблицы.ДокументДата),
			СтрокаТаблицы.Сотрудник,
			Ложь,	// ПолучитьДолжность
			Ложь);	// ПолучитьПодразделение
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСотрудника);
		
	КонецЦикла;
	
КонецПроцедуры

// Настройки печати

Функция ПолучитьМакетФормы0510447()
	
	Возврат УправлениеПечатью.МакетПечатнойФормы("Документ.ИзменениеРешенияОПроведенииИнвентаризации.ПФ_MXL_Ф0510447");
	
КонецФункции

Функция ПолучитьОбластиМакетаДокументаИзмененияРешения(Макет, ФорматПечати)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Утверждаю",							Макет.ПолучитьОбласть("Утверждаю"));
	ОбластиМакета.Вставить("Заголовок",							Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("СтрокаАкта",						Макет.ПолучитьОбласть("СтрокаАкта"));
	ОбластиМакета.Вставить("ЗаголовокРешения",					Макет.ПолучитьОбласть("ЗаголовокРешения"));
	ОбластиМакета.Вставить("Раздел1Заголовок",					Макет.ПолучитьОбласть("Раздел1Заголовок"));
	ОбластиМакета.Вставить("Раздел1ШапкаТаблицы",				Макет.ПолучитьОбласть("Раздел1ШапкаТаблицы"));
	
	Если ФорматПечати = "61н" Тогда
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицы",							Макет.ПолучитьОбласть("Раздел1СтрокаТаблицы"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыОтмена",					Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыОтмена"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыКорректировкаДоИзменения",	Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыКорректировкаДоИзменения"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыКорректировкаАктуальный",	Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыКорректировкаАктуальный"));
		
	ИначеЕсли ФорматПечати = "157н" Тогда
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыПриказ157нПустая",						Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыПриказ157нПустая"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыПриказ157нДополнение",					Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыПриказ157нДополнение"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыПриказ157нОтмена",						Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыПриказ157нОтмена"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыПриказ157нКорректировкаДоИзменения",	Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыПриказ157нКорректировкаДоИзменения"));
		ОбластиМакета.Вставить("Раздел1СтрокаТаблицыПриказ157нКорректировкаАктуальный",		Макет.ПолучитьОбласть("Раздел1СтрокаТаблицыПриказ157нКорректировкаАктуальный"));
	КонецЕсли;
	
	ОбластиМакета.Вставить("Раздел1Подвал",						Макет.ПолучитьОбласть("Раздел1Подвал"));
	ОбластиМакета.Вставить("Раздел2Заголовок",					Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2НомерКомиссии",				Макет.ПолучитьОбласть("Раздел2НомерКомиссии"));
	ОбластиМакета.Вставить("Раздел2СтрокаАкта",					Макет.ПолучитьОбласть("Раздел2СтрокаАкта"));
	ОбластиМакета.Вставить("Раздел2ШапкаТаблицы",				Макет.ПолучитьОбласть("Раздел2ШапкаТаблицы"));
	ОбластиМакета.Вставить("Раздел2СтрокаТаблицы",				Макет.ПолучитьОбласть("Раздел2СтрокаТаблицы"));
	ОбластиМакета.Вставить("Раздел2Подвал",						Макет.ПолучитьОбласть("Раздел2Подвал"));
	ОбластиМакета.Вставить("Подвал",							Макет.ПолучитьОбласть("Подвал"));
	
	Возврат ОбластиМакета;
	
КонецФункции

Функция ПолучитьОбластиМакетаЛистаСогласования(Макет)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("ЛистСогласованияЗаголовок",	Макет.ПолучитьОбласть("ЛистСогласованияЗаголовок"));
	ОбластиМакета.Вставить("ЛистСогласованияСтрока",	Макет.ПолучитьОбласть("ЛистСогласованияСтрока"));
	
	Возврат ОбластиМакета;
	
КонецФункции

Функция ПолучитьОбластиМакетаЛистаОзнакомления(Макет)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("ЛистОзнакомленияЗаголовок",							Макет.ПолучитьОбласть("ЛистОзнакомленияЗаголовок"));
	ОбластиМакета.Вставить("ЛистОзнакомленияСтрока",							Макет.ПолучитьОбласть("ЛистОзнакомленияСтрока"));
	ОбластиМакета.Вставить("ЛистОзнакомленияСтрокаКорректировкаДоИзменения",	Макет.ПолучитьОбласть("ЛистОзнакомленияСтрокаКорректировкаДоИзменения"));
	ОбластиМакета.Вставить("ЛистОзнакомленияСтрокаКорректировкаАктуальный",		Макет.ПолучитьОбласть("ЛистОзнакомленияСтрокаКорректировкаАктуальный"));
	
	Возврат ОбластиМакета;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыПечати0510447(ФорматПечати)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НастройкиДокумента", Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьНастройкиДокумента());
	ДополнительныеПараметры.Вставить("СоответствиеПоказателейИГрафРаздела1", ПолучитьСоответствиеПоказателейИГрафРаздела1());
	ДополнительныеПараметры.Вставить("ФорматПечати", ФорматПечати);
	
	Если ФорматПечати = "157н" Тогда
		ИнвентаризацияСервер.ДобавитьНастройкиОформленияИзмененныхЗначенийКорректировкиПриказ157н(ДополнительныеПараметры);
	КонецЕсли;

	Возврат ДополнительныеПараметры;
	
КонецФункции

// Форма 0510447 с листами согласования, ознакомления

Функция ПечатьФормы0510447СЛистами(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода, ФорматПечати = "157н")
	
	Макет = ПолучитьМакетФормы0510447();
	
	КлючПараметровПечати = "ПечатьФормы0510447СЛистами";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакетаДокумента			= ПолучитьОбластиМакетаДокументаИзмененияРешения(Макет, ФорматПечати);
	ОбластиМакетаЛистаСогласования	= ПолучитьОбластиМакетаЛистаСогласования(Макет);
	ОбластиМакетаЛистаОзнакомления	= ПолучитьОбластиМакетаЛистаОзнакомления(Макет);
	
	ДанныеСЛистами = ПолучитьДанныеДокументовДляПечатиСЛистами(МассивОбъектов, ФорматПечати);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыПечати0510447(ФорматПечати);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из ДанныеСЛистами.ДанныеДокументов.Шапки Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиДокументИзмененияРешения(ТабДокумент, ДанныеСЛистами.ДанныеДокументов, СтрокаШапки, ОбластиМакетаДокумента, ОбъектыПечати, ДополнительныеПараметры);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтрокаШапкиЛиста = ПолучитьСтрокуШапкиЛиста(ДанныеСЛистами.ДанныеЛистовСогласования.Шапки, СтрокаШапки);

		ВывестиЛистСогласования(ТабДокумент, ДанныеСЛистами.ДанныеЛистовСогласования, СтрокаШапкиЛиста, ОбластиМакетаЛистаСогласования, ОбъектыПечати);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтрокаШапкиЛиста = ПолучитьСтрокуШапкиЛиста(ДанныеСЛистами.ДанныеЛистовОзнакомления.Шапки, СтрокаШапки);
		
		ВывестиЛистОзнакомления(ТабДокумент, ДанныеСЛистами.ДанныеЛистовОзнакомления, СтрокаШапкиЛиста, ОбластиМакетаЛистаОзнакомления, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДокументовДляПечатиСЛистами(МассивОбъектов, ФорматПечати)
	
	ДанныеДляПечати = Новый Структура();
	
	ДанныеДляПечати.Вставить("ДанныеДокументов",			ПолучитьДанныеДокументовДляПечати(МассивОбъектов,, ФорматПечати));
	ДанныеДляПечати.Вставить("ДанныеЛистовСогласования",	ПолучитьДанныеЛистовСогласованияДляПечати(МассивОбъектов));
	ДанныеДляПечати.Вставить("ДанныеЛистовОзнакомления",	ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивОбъектов));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ПолучитьСтрокуШапкиЛиста(Данные, СтрокаШапкиДокумента)
	
	Поиск = Новый Структура("Ссылка", СтрокаШапкиДокумента.Ссылка);
	
	МассивСтрок = Данные.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

