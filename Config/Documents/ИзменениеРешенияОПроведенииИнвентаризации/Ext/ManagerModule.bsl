	|	ДатаНачала						КАК ДатаНачала,
	|	ДатаОкончания					КАК ДатаОкончания,
	|	НомерКомиссии					КАК НомерКомиссии,
	|	НомерРабочейКомиссии			КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации				КАК МестоИнвентаризации,
	|	// Показатели до изменения
	|	КФОДоИзменения					КАК КФОДоИзменения,
	|	СчетДоИзменения					КАК СчетДоИзменения,
	|	СотрудникДоИзменения			КАК СотрудникДоИзменения,
	|	ДатаИнвентаризацииДоИзменения	КАК ДатаИнвентаризацииДоИзменения,
	|	ДатаНачалаДоИзменения			КАК ДатаНачалаДоИзменения,
	|	ДатаОкончанияДоИзменения		КАК ДатаОкончанияДоИзменения,
	|	НомерКомиссииДоИзменения		КАК НомерКомиссииДоИзменения,
	|	НомерРабочейКомиссииДоИзменения	КАК НомерРабочейКомиссииДоИзменения,
	|	МестоИнвентаризацииДоИзменения	КАК МестоИнвентаризацииДоИзменения
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части Комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки				КАК НомерСтроки,
	|	ТипИзменения			КАК ТипИзменения,
	|	// Показатели актуальные
	|	Комиссия				КАК Комиссия,
	|	// Показатели до изменения
	|	КомиссияДоИзменения		КАК КомиссияДоИзменения
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для табличной части АктыОПроведенииИнвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Наименование	КАК Наименование,
	|	Дата			КАК Дата,
	|	Номер			КАК Номер
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.АктыОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для табличной части ЛистОзнакомления
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.ЛистОзнакомления
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для табличной части ЛистСогласования
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.ЛистСогласования
	|ГДЕ
	|	Ссылка = &ОснованиеСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Данные для шапки
	ТаблицаШапка = РезультатыЗапроса[0].Выгрузить();
	СтруктураШапка = Новый Структура();
	Если ТаблицаШапка.Количество() > 0 Тогда
		СтруктураШапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		
		ЗаполнениеРеквизитовОбъектов.ОчиститьИФОПодразделениеПриОтключеннойОпцииПриКопировании(СтруктураШапка);
	КонецЕсли;
	
	// [1]. Данные для табличной части Объекты
	ТаблицаОбъекты = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Данные для табличной части Комиссии
	ТаблицаКомиссии = РезультатыЗапроса[2].Выгрузить();
	
	// [3]. Данные для табличной части АктыОПроведенииИнвентаризации
	ТаблицаАктыОПроведенииИнвентаризации = РезультатыЗапроса[3].Выгрузить();
	
	// [4]. Данные для табличной части ЛистОзнакомления
	ТаблицаЛистОзнакомления = РезультатыЗапроса[4].Выгрузить();
	
	// [5]. Данные для табличной части ЛистСогласования
	ТаблицаЛистСогласования = РезультатыЗапроса[5].Выгрузить();
	
	Данные = Новый Структура();
	Данные.Вставить("Шапка", СтруктураШапка);
	Данные.Вставить("ТаблицаОбъекты", ТаблицаОбъекты);
	Данные.Вставить("ТаблицаКомиссии", ТаблицаКомиссии);
	Данные.Вставить("ТаблицаАктыОПроведенииИнвентаризации", ТаблицаАктыОПроведенииИнвентаризации);
	Данные.Вставить("ТаблицаЛистОзнакомления", ТаблицаЛистОзнакомления);
	Данные.Вставить("ТаблицаЛистСогласования", ТаблицаЛистСогласования);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьНастройкиТаблицыОбъекты(ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок)
	
	Показатели = Новый Структура();
	
	ИменаПоказателей = Новый Массив();
	ИменаПоказателей.Добавить("КФО");
	ИменаПоказателей.Добавить("Счет");
	ИменаПоказателей.Добавить("Сотрудник");
	ИменаПоказателей.Добавить("ДатаИнвентаризации");
	ИменаПоказателей.Добавить("ДатаНачала");
	ИменаПоказателей.Добавить("ДатаОкончания");
	ИменаПоказателей.Добавить("НомерКомиссии");
	ИменаПоказателей.Добавить("НомерРабочейКомиссии");
	ИменаПоказателей.Добавить("МестоИнвентаризации");
	
	Показатели.Вставить("ДопустимаКорректировка", Новый ФиксированныйМассив(ИменаПоказателей));
	
	ИменаПоказателей.Добавить("ТипИзменения");
	
	Показатели.Вставить("ИсточникМодифицированности", Новый ФиксированныйМассив(ИменаПоказателей));
	
	Настройки = Новый Структура();
	Настройки.Вставить("Показатели",			Показатели);
	Настройки.Вставить("ОчищающиеСтруктуры",	ПолучитьОчищающиеСтруктуры(Показатели.ДопустимаКорректировка, ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок));
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучитьНастройкиТаблицыКомиссии(ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок)
	
	Показатели = Новый Структура();
	
	ИменаПоказателей = Новый Массив();
	ИменаПоказателей.Добавить("Комиссия");
	
	Показатели.Вставить("ДопустимаКорректировка", Новый ФиксированныйМассив(ИменаПоказателей));
	
	ИменаПоказателей.Добавить("ТипИзменения");
	
	Показатели.Вставить("ИсточникМодифицированности", Новый ФиксированныйМассив(ИменаПоказателей));
	
	ПостфиксыИменКолонокПоказателей = ПолучитьПостфиксыИменКолонокПоказателей();
	
	ВидыИспользуемыхКолонок = ПолучитьВидыИспользуемыхКолонок();
	
	Настройки = Новый Структура();
	Настройки.Вставить("Показатели",			Показатели);
	Настройки.Вставить("ОчищающиеСтруктуры",	ПолучитьОчищающиеСтруктуры(Показатели.ДопустимаКорректировка, ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок));
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучитьПостфиксыИменКолонокПоказателей()
	
	ПостфиксыИменКолонокПоказателей = Новый Структура();
	ПостфиксыИменКолонокПоказателей.Вставить("Актуальный",	"");
	ПостфиксыИменКолонокПоказателей.Вставить("ДоИзменения",	"ДоИзменения");
	ПостфиксыИменКолонокПоказателей.Вставить("Предыдущий",	"Предыдущий");
	
	Возврат ПостфиксыИменКолонокПоказателей;
	
КонецФункции

Функция ПолучитьВидыИспользуемыхКолонок()
	
	ВидыИспользуемыхКолонок = Новый Соответствие();
	
	ВидыИспользуемыхКолонок.Вставить(
		Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение,
		Новый Структура("Актуальный,ДоИзменения", Истина, Ложь));
		
	ВидыИспользуемыхКолонок.Вставить(
		Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена,
		Новый Структура("Актуальный,ДоИзменения", Истина, Ложь));
		
	ВидыИспользуемыхКолонок.Вставить(
		Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка,
		Новый Структура("Актуальный,ДоИзменения", Истина, Истина));
		
	ВидыИспользуемыхКолонок.Вставить(
		Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка(),
		Новый Структура("Актуальный,ДоИзменения", Истина, Ложь));
		
	Возврат ВидыИспользуемыхКолонок;
	
КонецФункции

Процедура ОчиститьНеиспользуемыеКолонкиТаблицы(ДокументОбъект, НастройкиДокумента, ИмяТаблицы)
	
	ОчищающиеСтруктуры = НастройкиДокумента["Таблица" + ИмяТаблицы].ОчищающиеСтруктуры;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Объекты Цикл
		
		ОчищающаяСтруктура = ОчищающиеСтруктуры.Получить(СтрокаТаблицы.ТипИзменения);
		
		Если ОчищающаяСтруктура = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДопустимыеТипыИзмененияСтроки()
	
	СписокИсходноеРешение = Новый СписокЗначений();
	СписокИсходноеРешение.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	СписокИсходноеРешение.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	
	
	СписокДобавленныеРанее = Новый СписокЗначений();
	СписокДобавленныеРанее.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение);
	СписокДобавленныеРанее.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	
	Если ИнвентаризацияКлиентСервер.КорректироватьДобавленныеСтрокиРешения() Тогда
		СписокДобавленныеРанее.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	КонецЕсли;
	
	
	СписокДобавленныеСейчас = Новый СписокЗначений();
	СписокДобавленныеСейчас.Добавить(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение);
	
	
	Результат = Новый Структура();
	Результат.Вставить("ИсходноеРешение",	СписокИсходноеРешение);
	Результат.Вставить("ДобавленныеРанее",	СписокДобавленныеРанее);
	Результат.Вставить("ДобавленныеСейчас",	СписокДобавленныеСейчас);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ПолучитьОчищающиеСтруктуры(ИменаПоказателей, ПостфиксыИменКолонокПоказателей, ВидыИспользуемыхКолонок)
	
	// Для очистки неиспользуемых колонок в зависимости от типа изменения строки
	
	ОчищающиеСтруктуры = Новый Соответствие();
	
	Для Каждого ЭлементСоответствия Из ВидыИспользуемыхКолонок Цикл
		
		ТипИзменения = ЭлементСоответствия.Ключ;
		
		ОчищающаяСтруктура = Новый Структура();
		
		Для Каждого ЭлементСтруктуры Из ЭлементСоответствия.Значение Цикл
			ВидКолонок = ЭлементСтруктуры.Ключ;
			ПризнакИспользования = ЭлементСтруктуры.Значение;
			
			Если ПризнакИспользования Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
				ОчищающаяСтруктура.Вставить(ИмяПоказателя + ПостфиксыИменКолонокПоказателей[ВидКолонок], Неопределено);
			КонецЦикла;
		КонецЦикла;
		
		ОчищающиеСтруктуры.Вставить(ТипИзменения, ОчищающаяСтруктура);
		
	КонецЦикла;
	
	Возврат ОчищающиеСтруктуры;
	
КонецФункции

Процедура ДобавитьРеквизитыФормыКолонкиПредыдущихПоказателейТаблицы(ДобавляемыеРеквизиты, Форма, НастройкиДокумента, ИмяТаблицы)
	
	ДокументОбъект = Форма.Объект;
	
	МетаданныеКолонок = Метаданные.Документы.ИзменениеРешенияОПроведенииИнвентаризации.ТабличныеЧасти[ИмяТаблицы].Реквизиты;
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ИсточникМодифицированности;
	
	ПостфиксПредыдущий = НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Предыдущий;
	
	// КОЛОНКИ ТАБЛИЧНОЙ ЧАСТИ
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		ТипЗначенияКолонки = МетаданныеКолонок[ИмяПоказателя].Тип;
		
		ИмяКолонки = ИмяПоказателя + ПостфиксПредыдущий;
		
		НовыйРеквизитФормы = Новый РеквизитФормы(
			ИмяКолонки,
			Новый ОписаниеТипов(ТипЗначенияКолонки),
			"Объект." + ИмяТаблицы);
			
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиПредыдущихПоказателейТаблицы(Форма, ТаблицыИсходногоРешения, ТаблицыПредыдущегоДокумента, НастройкиДокумента, ИмяТаблицы)
	
	ДокументОбъект = Форма.Объект;
	
	Таблица = ДокументОбъект[ИмяТаблицы];
	
	ТаблицаИсходногоРешения = ТаблицыИсходногоРешения[ИмяТаблицы];
	
	ТаблицаПредыдущегоДокумента = ТаблицыПредыдущегоДокумента[ИмяТаблицы];
	
	КоличествоСтрокТаблицы = Таблица.Количество();
	
	КоличествоСтрокИсходногоРешения = ТаблицаИсходногоРешения.Количество();
	
	КоличествоСтрокПредыдущегоДокумента = ТаблицаПредыдущегоДокумента.Количество();
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ИсточникМодифицированности;
	
	ПостфиксПредыдущий = НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Предыдущий;
	
	Для НомерСтроки = 1 По КоличествоСтрокПредыдущегоДокумента Цикл
		
		Если НомерСтроки > КоличествоСтрокТаблицы Тогда
			// Экстренная ситуация
			Прервать;
		КонецЕсли;
		
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		СтрокаПредыдущегоДокумента = ТаблицаПредыдущегоДокумента[НомерСтроки - 1];
		
		Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
			
			СтрокаТаблицы[ИмяПоказателя + ПостфиксПредыдущий] = СтрокаПредыдущегоДокумента[ИмяПоказателя];
			
		КонецЦикла;
		
		Если НомерСтроки <= КоличествоСтрокИсходногоРешения Тогда
			СтрокаТаблицы["ЭтоСтрокаИсходногоРешения"] = Истина;
		Иначе
			СтрокаТаблицы["ЭтоДобавленнаяРанееСтрока"] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуМодифицированностьТаблицы(ДокументОбъект, ТаблицыПредыдущегоДокумента, НастройкиДокумента, ИмяТаблицы)
	
	ИмяКолонкиМодифицированность = "Модифицированность";
	
	ТаблицаПредыдущегоДокумента = ТаблицыПредыдущегоДокумента[ИмяТаблицы];
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ИсточникМодифицированности;
	
	Таблица = ДокументОбъект[ИмяТаблицы];
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ИнвентаризацияКлиентСервер.РассчитатьМодифицированностьВСтрокеТаблицы(
			СтрокаТаблицы,
			НастройкиДокумента,
			ИмяТаблицы,
			ТаблицаПредыдущегоДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьАктуальныеПоказателиДокумента(ДокументСсылка)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Актуальные показатели таблицы Объекты
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки				КАК НомерСтроки,
	|	КФО						КАК КФО,
	|	Счет					КАК Счет,
	|	Сотрудник				КАК Сотрудник,
	|	ДатаИнвентаризации		КАК ДатаИнвентаризации,
	|	ДатаНачала				КАК ДатаНачала,
	|	ДатаОкончания			КАК ДатаОкончания,
	|	НомерКомиссии			КАК НомерКомиссии,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации		КАК МестоИнвентаризации,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка)	КАК ТипИзменения
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	КФО						КАК КФО,
	|	Счет					КАК Счет,
	|	Сотрудник				КАК Сотрудник,
	|	ДатаИнвентаризации		КАК ДатаИнвентаризации,
	|	ДатаНачала				КАК ДатаНачала,
	|	ДатаОкончания			КАК ДатаОкончания,
	|	НомерКомиссии			КАК НомерКомиссии,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации		КАК МестоИнвентаризации,
	|	ТипИзменения			КАК ТипИзменения
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Актуальные показатели таблицы Комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки				КАК НомерСтроки,
	|	Комиссия				КАК Комиссия,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка)	КАК ТипИзменения
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	Комиссия				КАК Комиссия,
