&НаКлиенте
Процедура СдвинутьТекущуюСтроку(ИмяТаблицы, Смещение)
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект[ИмяТаблицы].Сдвинуть(ТекДанные.НомерСтроки - 1, Смещение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьДопустимыеДействияНадТекущейСтрокой(ИмяТаблицы)
	
	ДопустимыеДействия = Новый Структура();
	ДопустимыеДействия.Вставить("Удалить",			Ложь);
	ДопустимыеДействия.Вставить("ПереместитьВверх",	Ложь);
	ДопустимыеДействия.Вставить("ПереместитьВниз",	Ложь);
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат ДопустимыеДействия;
	КонецЕсли;
	
	Если ТекДанные.ЭтоСтрокаИсходногоРешения ИЛИ ТекДанные.ЭтоДобавленнаяРанееСтрока Тогда
		Возврат ДопустимыеДействия;
	КонецЕсли;
	
	ДопустимыеДействия.Вставить("Удалить", Истина);
	
	НомерСтроки = ТекДанные.НомерСтроки;
	
	КоличествоСтрок = Объект[ИмяТаблицы].Количество();
	
	Если НомерСтроки > 1 Тогда
		ПредыдущаяСтрока = Объект[ИмяТаблицы][НомерСтроки - 2];
		
		Если НЕ ПредыдущаяСтрока.ЭтоСтрокаИсходногоРешения И НЕ ПредыдущаяСтрока.ЭтоДобавленнаяРанееСтрока Тогда
			ДопустимыеДействия.Вставить("ПереместитьВверх",	Истина);
		КонецЕсли;
	КонецЕсли;
	
	ДопустимыеДействия.Вставить("ПереместитьВниз",	НомерСтроки < КоличествоСтрок);
	
	Возврат ДопустимыеДействия;
	
КонецФункции

&НаКлиенте
Процедура НастроитьДоступностьКнопокПеремещенияСтрок(ИмяТаблицы)
	
	ДопустимыеДействия = ОпределитьДопустимыеДействияНадТекущейСтрокой(ИмяТаблицы);
	
	Элементы[ИмяТаблицы + "Команда" + ИмяТаблицы + "ПереместитьСтрокуВниз"].Доступность = ДопустимыеДействия.ПереместитьВниз;
	
	Элементы[ИмяТаблицы + "Команда" + ИмяТаблицы + "ПереместитьСтрокуВверх"].Доступность = ДопустимыеДействия.ПереместитьВверх;
	
КонецПроцедуры

