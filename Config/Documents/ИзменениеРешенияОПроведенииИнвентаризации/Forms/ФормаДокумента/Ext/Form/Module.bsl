&НаКлиенте
Процедура ЗаполнитьНовуюСтрокуТаблицы(ИмяТаблицы)
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура("
		|Комиссия,
		|КомиссияДоИзменения,
		|ЭтоСтрокаИсходногоРешения,
		|ЭтоДобавленнаяРанееСтрока");
	
	ЗначенияПараметров.Вставить("Модифицированность",	Истина);
	ЗначенияПараметров.Вставить("ТипИзменения",			ПредопределенноеЗначение("Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение"));
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
	ТекДанные.ИндексКартинки = ОпределитьИндексКартинки(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыТипИзменения_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ТипИзменения = Результат.Значение;
	
	Модифицированность = Истина;
	
	ОбработатьИзменениеТипаИзменения("Объекты", ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссииТипИзменения_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Комиссии.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ТипИзменения = Результат.Значение;
	
	Модифицированность = Истина;
	
	ОбработатьИзменениеТипаИзменения("Комиссии", ТекДанные, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеТипаИзменения(ИмяТаблицы, ТекДанные, КэшироватьДанныеКомиссий = Ложь)
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.ТипИзменения) Тогда
		УстановитьТипИзмененияПослеОчистки(ТекДанные);
	КонецЕсли;
	
	Если ТекДанные.ТипИзменения = ПредопределенноеЗначение("Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка") Тогда
		ИнициализироватьКолонкиДоИзменения(ИмяТаблицы, ТекДанные);
	Иначе
		ИнициализироватьКолонкиАктуальные(ИмяТаблицы, ТекДанные);
	КонецЕсли;
	
	ТекДанные.ИндексКартинки = ОпределитьИндексКартинки(ТекДанные);
	
	ИнвентаризацияКлиентСервер.РассчитатьМодифицированностьВСтрокеТаблицы(
		ТекДанные,
		НастройкиДокумента,
		ИмяТаблицы);
	
	ОчиститьНеиспользуемыеПоляСтроки(ИмяТаблицы, ТекДанные);
	
	Если КэшироватьДанныеКомиссий Тогда
		КэшироватьДанныеКомиссийДокумента();
	КонецЕсли;
	
	Если ИмяТаблицы = "Объекты" Тогда
		ЗаполнитьСлужебныеКолонкиТаблицыОбъектыВТекущейСтроке();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОНевозможностиУдалитьСтроку(ИмяТаблицы, Отказ)
	
	ДопустимыеДействия = ОпределитьДопустимыеДействияНадТекущейСтрокой(ИмяТаблицы);
	
	Если НЕ ДопустимыеДействия.Удалить Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='Выбранную строку удалить нельзя, поскольку она принадлежит предыдущему документу цепочки'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокВыбораТипИзменения(ИмяТаблицы)
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТекДанные.ЭтоСтрокаИсходногоРешения Тогда
		ИмяСвойства = "ИсходноеРешение";
		
	ИначеЕсли ТекДанные.ЭтоДобавленнаяРанееСтрока Тогда
		ИмяСвойства = "ДобавленныеРанее";
		
	Иначе
		ИмяСвойства = "ДобавленныеСейчас";
	КонецЕсли;
	
	СписокВыбора = НастройкиДокумента.ДопустимыеТипыИзмененияСтроки[ИмяСвойства];
	
	Возврат СписокВыбора;
	
КонецФункции

