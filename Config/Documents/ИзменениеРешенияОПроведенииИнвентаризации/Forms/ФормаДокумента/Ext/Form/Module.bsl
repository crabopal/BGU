&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// Вывод 0 в пустой колонке КФО
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Вывод 0 в пустой колонке КФО'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.КФО");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "0");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОбъектыКФО");
	
	
	//---
	// Вывод 0 в пустой колонке КФО (до изменения)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Вывод 0 в пустой колонке КФО (до изменения)'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.КФОДоИзменения");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "0");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОбъектыКФОДоИзменения");
	
	
	ДобавитьУсловноеОформлениеТипИзменения("Объекты");
	
	ДобавитьУсловноеОформлениеТипИзменения("Комиссии");
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформление_ТаблицаОбъекты_МОЛ(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеТипИзменения(ИмяТаблицы)
	
	ДобавитьУсловноеОформление_СкрытьНеиспользуемыеКолонки(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение);
	ДобавитьУсловноеОформление_СкрытьНеиспользуемыеКолонки(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	ДобавитьУсловноеОформление_СкрытьНеиспользуемыеКолонки(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	ДобавитьУсловноеОформление_СкрытьНеиспользуемыеКолонки(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка());
	
	ДобавитьУсловноеОформление_ТолькоПросмотрИспользуемыхКолонок(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	ДобавитьУсловноеОформление_ТолькоПросмотрИспользуемыхКолонок(ИмяТаблицы, Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка());
	
	ДобавитьУсловноеОформление_СкорректированныеПоказатели(ИмяТаблицы);
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_СкрытьНеиспользуемыеКолонки(ИмяТаблицы, ТипИзменения)
	
	ТекстНадписиПрежнее	= НСтр("ru='Прежнее'");
	ТекстНадписиНовое	= НСтр("ru='Новое'");
	
	Используемые = НастройкиДокумента.ВидыИспользуемыхКолонок.Получить(ТипИзменения);
	
	ВидыИспользуемыхКолонок = Новый Массив();
	ВидыНеиспользуемыхКолонок = Новый Массив();
	
	ВидКолонок = "Актуальный";
	Если Используемые[ВидКолонок] Тогда
		ВидыИспользуемыхКолонок.Добавить(ВидКолонок);
	Иначе
		ВидыНеиспользуемыхКолонок.Добавить(ВидКолонок);
	КонецЕсли;
	
	ВидКолонок = "ДоИзменения";
	Если Используемые[ВидКолонок] Тогда
		ВидыИспользуемыхКолонок.Добавить(ВидКолонок);
	Иначе
		ВидыНеиспользуемыхКолонок.Добавить(ВидКолонок);
	КонецЕсли;
	
	//---
	// Скрываем неиспользуемые колонки
	//---
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		Для Каждого ВидКолонки Из ВидыНеиспользуемыхКолонок Цикл
			Постфикс = НастройкиДокумента.ПостфиксыИменКолонокПоказателей[ВидКолонки];
			
			ИмяКолонки = ИмяПоказателя + Постфикс;
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" скрываем колонку %2'"),
				ТипИзменения,
				ИмяКолонки);
			
			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Условие.ПравоеЗначение = ТипИзменения;
			
			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
			
			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки);
			
			Если ИмяПоказателя = "Счет" Тогда
				// Для счета дополнительно выводится колонка с наименованием счета
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки + "Наименование");
				
			ИначеЕсли ИмяТаблицы = "Комиссии" И ИмяПоказателя = "Комиссия" Тогда
				// Для комиссии дополнительно выводятся колонки с номерами РК и актами о составе комиссии
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ПредставлениеАктовДоИзменения");
				
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ПредставлениеРабочихКомиссийДоИзменения");
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	//---
	// Скрываем надписи "Прежнее", "Новое"
	//---
	
	Для Каждого ВидКолонки Из ВидыНеиспользуемыхКолонок Цикл
		ИмяКолонки = ?(ВидКолонки = "ДоИзменения", "НадписьДоИзменения", "НадписьПослеИзменения");
		
		ТекстНадписи = ?(ВидКолонки = "ДоИзменения", ТекстНадписиПрежнее, ТекстНадписиНовое);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" скрываем надпись ""%2""'"),
			ТипИзменения,
			ТекстНадписи);
			
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ТипИзменения;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки);
	КонецЦикла;
	
	//---
	// Показываем надписи "Прежнее", "Новое"
	//---
	
	Для Каждого ВидКолонки Из ВидыИспользуемыхКолонок Цикл
		ИмяКолонки = ?(ВидКолонки = "ДоИзменения", "НадписьДоИзменения", "НадписьПослеИзменения");
		
		ТекстНадписи = ?(ВидКолонки = "ДоИзменения", ТекстНадписиПрежнее, ТекстНадписиНовое);
		
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" показываем надпись ""%2""'"),
			ТипИзменения,
			ТекстНадписи);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ТипИзменения;
		
		// Оформление
		Если ВидыИспользуемыхКолонок.Количество() = 1 Тогда
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
		Иначе
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ТекстНадписи);
		КонецЕсли;
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_ТолькоПросмотрИспользуемыхКолонок(ИмяТаблицы, ТипИзменения)
	
	Используемые = НастройкиДокумента.ВидыИспользуемыхКолонок.Получить(ТипИзменения);
	
	Если НЕ Используемые["Актуальный"] Тогда
		Возврат;
	КонецЕсли;
	
	//---
	// Только просмотр актуальных колонок
	//---
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный = НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		ИмяКолонки = ИмяПоказателя + ПостфиксАктуальный;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" только просмотр колонки %2'"),
			ТипИзменения,
			ИмяКолонки);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ТипИзменения;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки);
		
		Если ИмяТаблицы = "Объекты" И ИмяПоказателя = "Счет" Тогда
			// Для счета дополнительно выводится колонка с наименованием счета
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонки + "Наименование");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_СкорректированныеПоказатели(ИмяТаблицы)
	
	ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка;
	
	ШрифтПоУмолчанию = Элементы[ИмяТаблицы].Шрифт;
	
	ШрифтЗачеркнутый = Новый Шрифт(ШрифтПоУмолчанию,,,,,,Истина);
	ШрифтПолужирный = Новый Шрифт(ШрифтПоУмолчанию,,,Истина);
	
	Используемые = НастройкиДокумента.ВидыИспользуемыхКолонок.Получить(ТипИзменения);
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		ИмяКолонкиАктуальный	= ИмяПоказателя + ПостфиксАктуальный;
		ИмяКолонкиДоИзменения	= ИмяПоказателя + ПостфиксДоИзменения;
		
		//---
		// Зачеркнуто прежнее значение показателя
		//---
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" прежнее значение показателя %2'"),
			ТипИзменения,
			ИмяКолонкиДоИзменения);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ТипИзменения;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + "." + ИмяКолонкиАктуальный);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + "." + ИмяКолонкиДоИзменения);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЗачеркнутый);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонкиДоИзменения);
		
		Если ИмяТаблицы = "Объекты" И ИмяПоказателя = "Счет" Тогда
			// Для счета дополнительно выводится колонка с наименованием счета
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонкиДоИзменения + "Наименование");
		КонецЕсли;
		
		//---
		// Выделено новое значение показателя
		//---
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При типе изменения ""%1"" новое значение показателя %2'"),
			ТипИзменения,
			ИмяКолонкиДоИзменения);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + ".ТипИзменения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ТипИзменения;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + "." + ИмяКолонкиАктуальный);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицы + "." + ИмяКолонкиДоИзменения);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонкиАктуальный);
		
		Если ИмяТаблицы = "Объекты" И ИмяПоказателя = "Счет" Тогда
			// Для счета дополнительно выводится колонка с наименованием счета
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ИмяКолонкиАктуальный + "Наименование");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРешения(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Решение = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
	ЗаполнитьНаОснованииРешенияСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаОснованииРешенияСервер()
	
	Документы.ИзменениеРешенияОПроведенииИнвентаризации.ЗаполнитьНаОсновании(Объект.Решение,,,Объект);
	
	НастроитьФормуСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипИзмененияПослеОчистки(ТекДанные)
	
	Если ТекДанные.ЭтоСтрокаИсходногоРешения Тогда
		ТипИзменения = Неопределено;
	Иначе
		ТипИзменения = ПредопределенноеЗначение("Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение");
	КонецЕсли;
	
	ТекДанные.ТипИзменения = ТипИзменения;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОчиститьНеиспользуемыеПоляСтроки(ИмяТаблицы, ТекДанные)
	
	ОчищающаяСтруктура = НастройкиДокумента["Таблица" + ИмяТаблицы].ОчищающиеСтруктуры.Получить(ТекДанные.ТипИзменения);
	
	Если ОчищающаяСтруктура = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьКолонкиДоИзменения(ИмяТаблицы, ТекДанные)
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		ТекДанные[ИмяПоказателя + ПостфиксДоИзменения] = ТекДанные[ИмяПоказателя + ПостфиксАктуальный];
		
	КонецЦикла;
	
	Если ИмяТаблицы = "Комиссии" Тогда
		// Для комиссии дополнительно выводятся колонки с номерами РК и актами о составе комиссии
		
		ИменаКолонок = ПолучитьИменаКолонокПредставленийКомиссий();
		
		Для Каждого ИмяПоказателя Из ИменаКолонок Цикл
			ТекДанные[ИмяПоказателя + ПостфиксДоИзменения] = ТекДанные[ИмяПоказателя + ПостфиксАктуальный];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьКолонкиАктуальные(ИмяТаблицы, ТекДанные)
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиДокумента.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	ЗначенияПараметров = Новый Структура();
	
	ЕстьЗаполненный = Ложь;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		ЗначениеПоказателя = ТекДанные[ИмяПоказателя + ПостфиксДоИзменения];
		
		Если ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
			ЕстьЗаполненный = Истина;
		КонецЕсли;
		
		ЗначенияПараметров.Вставить(ИмяПоказателя + ПостфиксАктуальный, ЗначениеПоказателя);
	КонецЦикла;
	
	Если НЕ ЕстьЗаполненный Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
	Если ИмяТаблицы = "Комиссии" Тогда
		// Для комиссии дополнительно выводятся колонки с номерами РК и актами о составе комиссии
		
		ИменаКолонок = ПолучитьИменаКолонокПредставленийКомиссий();
		
		Для Каждого ИмяПоказателя Из ИменаКолонок Цикл
			ТекДанные[ИмяПоказателя + ПостфиксАктуальный] = ТекДанные[ИмяПоказателя + ПостфиксДоИзменения];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИменаКолонокПредставленийКомиссий()
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("ПредставлениеРабочихКомиссий");
	ИменаКолонок.Добавить("ПредставлениеАктов");
	
	Возврат ИменаКолонок;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИОткрытьФормуВыбораКомиссии()
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Новый Структура("НомерКомиссии,НомерРабочейКомиссии");
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекДанные);
	
	Если ЕстьДублиСтрокТабличнаяЧастьКомиссии() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресХранилища", Этаформа.АдресХранилища);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	ОписаниеОповещенияЗакрытие = Новый ОписаниеОповещения("ВыбранаСтрокаКомиссии", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ДеревоРабочихКомиссийДокумента", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияЗакрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаСервере
Функция ЕстьДублиСтрокТабличнаяЧастьКомиссии()
	
	Возврат ИнвентаризацияСервер.ЕстьДублиСтрокТабличнаяЧастьКомиссии(Объект);
	
КонецФункции

&НаСервере
Процедура КэшироватьДанныеКомиссийДокумента(ОбновитьТабличныеДокументы = Истина)
	
	ИнвентаризацияСервер.КэшироватьДанныеКомиссийДокумента(ЭтаФорма, ОбновитьТабличныеДокументы, "ГруппаТабличныеДокументы");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранаСтрокаКомиссии(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ВыбранноеЗначение, "НомерКомиссии,НомерРабочейКомиссии");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер(ИмяСобытия = Неопределено)
	
	Если Не ВыполненаИнициализация Тогда
		ИнициализироватьФормуСервер();
	КонецЕсли;
	
	Если ИмяСобытия = "ПриЧтении" Тогда
		ВыполненаНастройкаПриЧтении = Истина;
		
	ИначеЕсли ИмяСобытия = "ПриСоздании" И ВыполненаНастройкаПриЧтении Тогда
		Возврат;
	КонецЕсли;
	
	КэшироватьДанныеКомиссийДокумента();
	
	НастроитьФормуСерверПроверитьЦепочкуДокументов();
	
	Документы.ИзменениеРешенияОПроведенииИнвентаризации.ЗаполнитьКолонкиПредыдущихПоказателей(ЭтаФорма);
	
	ИнициализироватьКолонкиИндексКартинки();
	
	ЗаполнитьСлужебныеКолонкиТаблицыОбъекты();
	
	ИнвентаризацияСервер.ЗаполнитьКолонкиРасположенияСотрудниковВРазделахДокумента(Объект);
	
	РазрешитьВыборГруппСчетов();
	
	ИнвентаризацияСервер.НастроитьОтборПоПодразделениюНаФормеРешения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура РазрешитьВыборГруппСчетов()
	
	НовыйПараметр = Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	
	НовыеПараметрыВыбора = Новый Массив();
	НовыеПараметрыВыбора.Добавить(НовыйПараметр);

	Элементы.ОбъектыСчет.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Метаданные.Документы.РешениеОПроведенииИнвентаризации);
	
	НастройкиДокумента = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьНастройкиДокумента();
	
	Документы.ИзменениеРешенияОПроведенииИнвентаризации.ДобавитьРеквизитыФормыКолонкиПредыдущихПоказателей(ЭтаФорма);
	
	УстановитьУсловноеОформление();
	
	ВыполненаИнициализация = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиТаблицыОбъекты()
	
	ИнвентаризацияСервер.КэшироватьТаблицуНастроекЗаполненияОписейПоРешению(ЭтаФорма);
	
	ИнвентаризацияСервер.ЗаполнитьСлужебныеКолонкиТаблицыОбъекты(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверПроверитьЦепочкуДокументов()
	
	ИнвентаризацияСервер.ИнициализироватьСостояниеЦепочкиДокументов(ЭтаФорма);
	
	ИнвентаризацияСервер.НастроитьФормуИндикаторыОшибокЦепочкиДокументов(ЭтаФорма);
	
	ИнвентаризацияСервер.НастроитьФормуИндикаторОкружающиеДокументы(ЭтаФорма);
	
	НастроитьФормуБлокЗаголовокИзменения();
	
	НастроитьФормуОграничениеРаботы();

КонецПроцедуры

&НаСервере
Процедура НастроитьФормуБлокЗаголовокИзменения()
	
	// Решение
	
	УказаноРешение = ЗначениеЗаполнено(Объект.Решение);
	
	Элемент = Элементы.НадписьДокументЦепочкиПервыйПредставление;
	
	ЦветТекста = Новый Цвет();
	
	Если Не УказаноРешение Тогда
		ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
		
		НадписьДокументЦепочкиПервыйПредставление = НСтр("ru='не заполнено, выбрать...'");
	КонецЕсли;
	
	Элемент.ЦветТекста = ЦветТекста;
	
	// Вид изменения
	
	НовДоступность = НЕ ЕстьОшибкиЦепочки
		И НЕ ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка)
		И УказаноРешение;
	
	Элементы.Аннулирующее.Доступность = НовДоступность;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуОграничениеРаботы()
	
	РаботаФормыОграничена = ЕстьОшибкиЦепочки
		Или Объект.ПометкаУдаления
		Или ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка)
		Или Не ЗначениеЗаполнено(Объект.Решение)
		Или (ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Аннулирующий.ДокументСсылка) И Объект.Ссылка <> ОкружающиеДокументыЦепочки.Аннулирующий.ДокументСсылка)
		Или Объект.Аннулирующее
		Или Не ПравоДоступаИзменение;
		
	РаботаЛистовОзнакомленияСогласованияОграничена = ЕстьОшибкиЦепочки
		Или Объект.ПометкаУдаления
		Или Не ЗначениеЗаполнено(Объект.Решение)
		Или (ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка)
			И Не ИнвентаризацияКлиентСервер.РазрешатьМодификациюЛистовОзнакомленияСогласованияЕслиВыполненыПоследующиеИзмененияРешения());
		
	Элементы.ГруппаНомерИзменения.ТолькоПросмотр = Объект.ПометкаУдаления;
	
	Элементы.ГруппаКомиссии.ТолькоПросмотр						= РаботаФормыОграничена;
	Элементы.ГруппаАктыОПроведенииИнвентаризации.ТолькоПросмотр	= РаботаФормыОграничена;
	Элементы.ГруппаОбъекты.ТолькоПросмотр						= РаботаФормыОграничена;
	
	Элементы.ГруппаЛистСогласования.ТолькоПросмотр	= РаботаЛистовОзнакомленияСогласованияОграничена;
	Элементы.ГруппаЛистОзнакомления.ТолькоПросмотр	= РаботаЛистовОзнакомленияСогласованияОграничена;
	
	Элементы.ОбъектыКомандаОбъектыПереместитьСтрокуВниз.Доступность		= Не РаботаФормыОграничена;
	Элементы.ОбъектыКомандаОбъектыПереместитьСтрокуВверх.Доступность	= Не РаботаФормыОграничена;
	
	Элементы.КомиссииКомандаКомиссииПереместитьСтрокуВниз.Доступность	= Не РаботаФормыОграничена;
	Элементы.КомиссииКомандаКомиссииПереместитьСтрокуВверх.Доступность	= Не РаботаФормыОграничена;
	
	Элементы.ЛистОзнакомленияГруппаЗаполнить.Доступность = Не РаботаЛистовОзнакомленияСогласованияОграничена;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКолонкиИндексКартинки()
	
	Для Каждого СтрокаТаблицы Из Объект.Объекты Цикл
		
		СтрокаТаблицы.ИндексКартинки = ОпределитьИндексКартинки(СтрокаТаблицы);
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.Комиссии Цикл
		
		СтрокаТаблицы.ИндексКартинки = ОпределитьИндексКартинки(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьИндексКартинки(ТекДанные)
	
	
	Если ТекДанные.ЭтоСтрокаИсходногоРешения Тогда
		Возврат 1;
		
	ИначеЕсли ТекДанные.ЭтоДобавленнаяРанееСтрока Тогда
		Возврат 2;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура АннулирующееПриИзменении_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
