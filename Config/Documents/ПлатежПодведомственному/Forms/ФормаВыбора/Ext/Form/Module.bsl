
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Организация;
	
	Параметры.Отбор.Свойство("Организация", Организация);
	Если ЗначениеЗаполнено(Организация) Тогда
		Элементы.Начисление.ПараметрыВыбора = Новый ФиксированныйМассив(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
			Новый ПараметрВыбора("Отбор.Организация", Организация)));
	КонецЕсли;
	
	Параметры.Свойство("Начисление",Начисление);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Начисление", Начисление);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ПоНачислению", ЗначениеЗаполнено(Начисление));
	
	Если ЗначениеЗаполнено(Начисление) Тогда
		Элементы.Начисление.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
КонецПроцедуры

#КонецОбласти

