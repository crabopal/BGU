
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", 
		Новый Структура("ДокументОснование, ВводНаОсновании", ПараметрКоманды, Истина));
	ОткрытьФорму("Документ.РегистрацияКапвложений.ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры