// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаОсновании()
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		ПараметрыЗаполнения = Новый Структура("ДокументОснование, ВводНаОсновании", Объект.ДокументОснование, Истина);
		ТекОбъект.Заполнить(ПараметрыЗаполнения);
		ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	КонецЕсли;	
КонецПроцедуры	

