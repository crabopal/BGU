#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыЗапроса = Новый Массив;
	
	Запрос = Новый Запрос;
	ТаблицыЗапроса.Добавить("ОперацииКапвложений");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка.Дата КАК Период,
	|	ТЧ.Ссылка.Организация КАК Организация,
	|	ТЧ.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ТЧ.Ссылка.ДокументОснование КАК ДокументКапвложений
	|ИЗ
	|	Документ.РегистрацияКапвложений.ОбъектыВложений КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(
		СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
КонецПроцедуры

