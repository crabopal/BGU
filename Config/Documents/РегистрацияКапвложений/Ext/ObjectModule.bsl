#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Отработает закрытие/открытие карточки капвложений. Если режим записи отмена проведения, то закрытие/открытие
	// карточки выполнится в подписке "СнятьСтатусЗакрытаКарточекКапвложения" на событие "Обработка удаления проведения" 
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если НЕ ДополнительныеСвойства.Свойство("КарточкиКапвложений") Тогда
			КарточкиКапвложений = Новый Массив;
			Для каждого ТекСтрока из ОбъектыВложений Цикл
				Если НЕ ЗначениеЗаполнено(ТекСтрока.КарточкаКапвложений) Тогда
					Продолжить;
				КонецЕсли;	
				КарточкиКапвложений.Добавить(ТекСтрока.КарточкаКапвложений);
			КонецЦикла;	
			ДополнительныеСвойства.Вставить("КарточкиКапвложений", КарточкиКапвложений);
		КонецЕсли;	
		Если ДополнительныеСвойства.Свойство("КарточкиКапвложений") Тогда
			ОбслуживаниеКарточекКапвложений.УстановитьСтатусЗакрытияКарточекКапвложений(
				ДополнительныеСвойства.КарточкиКапвложений, Ссылка);
		КонецЕсли;		
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ДокументОснование") 
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда	
		
			СтандартнаяОбработка = Ложь;
			ЗаполнитьПоДокументуОснованию(ДанныеЗаполнения.ДокументОснование);
		КонецЕсли;	
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоДокументуОснованию(ДокОснование)
	ОбъектыВложений.Очистить();
	
	РеквизитыШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Организация, Дата");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыШапки);
	ДокументОснование = ДокОснование;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ КАК ОбъектВложений
	|Поместить ТабОбъектов
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Регистратор
	|	И СчетКт В ИЕРАРХИИ (&Счет10600)
	|	И (ВидСубконтоКт1 = &СубконтоОС
	|	ИЛИ ВидСубконтоКт2 = &СубконтоОС),,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ
	|
	|Объединить все
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ КАК ОбъектВложений
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Регистратор
	|	И СчетДт В ИЕРАРХИИ (&Счет10600)
	|	И (ВидСубконтоДт1 = &СубконтоОС
	|	ИЛИ ВидСубконтоДт2 = &СубконтоОС),,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &СубконтоОС
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений КАК ОбъектВложений
	|ПОМЕСТИТЬ ТабЗарегистрированныхОбъектов
	|ИЗ
	|	РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|ГДЕ
	|	ОперацииКапвложений.Регистратор = &Регистратор
	|	И ОперацииКапвложений.Активность
	|СГРУППИРОВАТЬ ПО
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОбъектов.ОбъектВложений КАК ОбъектВложений
	|ИЗ
	|	ТабОбъектов КАК ТабОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЗарегистрированныхОбъектов КАК ТабЗарегистрированныхОбъектов
	|		ПО ТабОбъектов.ОбъектВложений = ТабЗарегистрированныхОбъектов.ОбъектВложений
	|ГДЕ
	|	ТабОбъектов.ОбъектВложений <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	И ТабЗарегистрированныхОбъектов.ОбъектВложений Есть NULL
	|СГРУППИРОВАТЬ ПО
	|	ТабОбъектов.ОбъектВложений";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Регистратор", ДокОснование); 
	Запрос.УстановитьПараметр("Счет10600", БухгалтерскийУчет.СчетПоКоду("106.00")); 
	Запрос.УстановитьПараметр("СубконтоОС", 
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОбъектыВложений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;		
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли
