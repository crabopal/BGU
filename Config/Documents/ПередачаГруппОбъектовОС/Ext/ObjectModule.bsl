#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивРеквизитовКУдалению = Новый Массив;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации) Тогда
		
		УправлениеОсновнымиСредствами.ПроверитьСобытиеОСвПользовании(
			ОсновныеСредства.Выгрузить(,"НомерСтроки, ОсновноеСредство, ИнвентарныйНомер"),
			Организация,
			Дата,
			Ссылка,
			,
			,
			Отказ);
			
		Если Отказ Тогда
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
		
	Иначе
			
		МассивРеквизитовКУдалению.Добавить("ЦМОПолучатель");
		МассивРеквизитовКУдалению.Добавить("ПодразделениеПолучатель");
			
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00");
		МассивРеквизитовКУдалению.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
		МассивРеквизитовКУдалению.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("01");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02.1");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("106.00");
		МассивРеквизитовКУдалению.Добавить("ЦМО");
		МассивРеквизитовКУдалению.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСАренда Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("25");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСвПользование Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("26");
	КонецЕсли;

	Если НЕ СвойстваСчета.УчетПоКПС Тогда
		МассивРеквизитовКУдалению.Добавить("КПС");
	КонецЕсли;
	Если НЕ (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчета.УчетПоПодразделениям) Тогда
		МассивРеквизитовКУдалению.Добавить("Подразделение");
		МассивРеквизитовКУдалению.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	//Если ОсновныеСредства.Количество()>0 Тогда
	//	Если ОсновныеСредства[0].ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
	//		МассивРеквизитовКУдалению.Добавить("ЦМО");
	//	КонецЕсли;
	//КонецЕсли;
	//
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивРеквизитовКУдалению);
	
	Для каждого ТекСтр Из ОсновныеСредства Цикл
	
		Если ЗначениеЗаполнено(ТекСтр.ИнвентарныйНомер) и ТекСтр.Количество>1 Тогда
			ТекстПредупреждения = НСтр("ru='Для объектов с присвоенным инвентарным номером не может быть количество больше 1'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,"Объект.ОсновныеСредства["+(ТекСтр.НомерСтроки-1)+"].Количество",,Отказ);
		КонецЕсли;			
	
	КонецЦикла; 	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ДатаСписанияСБухУчета) Тогда
		ДатаСписанияСБухУчета = Дата;
	КонецЕсли;
	
	СуммаПродажиВсего = ОсновныеСредства.Итог("Всего");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли