&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	СписокСостояний = Новый СписокЗначений;
	СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
	
	ПараметрыОтбора = Новый Структура("Владелец, ОС, ЦМО, Состояние",
										Объект.Организация,
										ТекущиеДанные.ОсновноеСредство,
										Объект.ЦМО,
										СписокСостояний);
	ПараметрыФормы = Новый Структура("Отбор, ТекущаяСтрока, НаДату",
										ПараметрыОтбора,
										ТекущиеДанные.ОсновноеСредство,
										Объект.Дата - 1);
	
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

