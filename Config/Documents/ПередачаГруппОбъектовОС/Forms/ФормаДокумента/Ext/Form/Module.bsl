&НаКлиенте
Процедура ОбработкаВопросаИзменитьВидОперации(РезультатВопроса, ДополнительныеПараметры) Экспорт

	ТребуетсяПересчитатьСуммы = Ложь;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ТребуетсяПересчитатьСуммы = Истина;
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Нет Тогда
		Объект.ВидОперации = ВидОперацииПрежний;
		Возврат;
	КонецЕсли;
	
	ВидОперацииПрежний = Объект.ВидОперации;
	
	ТребуетсяПерезаполнитьСчета = ВидОперацииПрежний = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет");
	
	Если ТребуетсяПерезаполнитьСчета Тогда
		УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	КонецЕсли;
	
	Если ТребуетсяПересчитатьСуммы Тогда
		РассчитатьСуммы(Ложь);
	КонецЕсли;
	
	УстановитьВидимостьСтраницыЦМОПодразделение(ЭтаФорма, Объект);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);

КонецПроцедуры

&НаКлиенте
Функция ИзменилисьСчетаУчета(СтарыйВидОперации, НовыйВидОперации)

	Если СтарыйВидОперации = НовыйВидОперации Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГруппыВидовОпераций = Новый Массив;
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	СтарыйИндекс = -1;
	НовыйИндекс = -1;
	ТекущийИндекс = 0;
	Для каждого ГруппаОпераций Из ГруппыВидовОпераций Цикл
	
		Если ГруппаОпераций.Найти(СтарыйВидОперации) <> Неопределено Тогда
			СтарыйИндекс = ТекущийИндекс;
		КонецЕсли;
		Если ГруппаОпераций.Найти(НовыйВидОперации) <> Неопределено Тогда
			НовыйИндекс = ТекущийИндекс;
		КонецЕсли;
		ТекущийИндекс = ТекущийИндекс + 1;
	
	КонецЦикла;
	
	Возврат СтарыйИндекс <> НовыйИндекс;

КонецФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьДоговора(ЭтаФорма, Объект);
	УстановитьВидимостьСтраницыЦМОПодразделение(ЭтаФорма, Объект);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Форма.Элементы.РеквизитыЛицевогоСчета.Доступность	= ДоступностьРеквизитов;
	Форма.Элементы.Подразделение.Доступность			= ДоступностьРеквизитов;
	Форма.Элементы.ЦМО.Доступность					= ДоступностьРеквизитов;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)

	Форма.Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтраницыЦМОПодразделение(Форма, Объект)

	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации) Тогда
		Форма.Элементы.ГруппаЦМОПодразделениеПолучательСтраницы.ТекущаяСтраница = Форма.Элементы.СтраницаЦМОПодразделениеПолучатель;
	Иначе
		Форма.Элементы.ГруппаЦМОПодразделениеПолучательСтраницы.ТекущаяСтраница = Форма.Элементы.СтраницаЦМОПодразделениеПолучательПустая;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)

	Элементы = Форма.Элементы;

	КПСОбязательно 				= Ложь;
	ПодразделениеОбязательно	= Ложь;
	КонтрагентОбязательно		= Ложь;
	ЦМООбязательно				= Истина;
	
	СвойстваСчета = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПризнакиУчетаСчетаПоВидуПередачиОС(
						Объект.ВидОперации, ЦМООбязательно, КонтрагентОбязательно);
	Если СвойстваСчета <> Неопределено Тогда
		КПСОбязательно 				= СвойстваСчета.УчетПоКПС;
		ПодразделениеОбязательно	= ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям") И СвойстваСчета.УчетПоПодразделениям;
	КонецЕсли;
	
	Если КПСОбязательно Тогда
		Элементы.КПС.АвтоОтметкаНезаполненного  = Истина;
		Элементы.КПС.ОтметкаНезаполненного		= НЕ ЗначениеЗаполнено(Объект.КПС);
	Иначе
		Элементы.КПС.АвтоОтметкаНезаполненного  = Ложь;
		Элементы.КПС.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;
	Если ПодразделениеОбязательно Тогда
		Элементы.Подразделение.АвтоОтметкаНезаполненного	= Истина;
		Элементы.Подразделение.ОтметкаНезаполненного		= НЕ ЗначениеЗаполнено(Объект.Подразделение);
	Иначе
		Элементы.Подразделение.АвтоОтметкаНезаполненного	= Ложь;
		Элементы.Подразделение.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;
	Если КонтрагентОбязательно Тогда
		Элементы.Контрагент.АвтоОтметкаНезаполненного	= Истина;
		ЭЛементы.Контрагент.ОтметкаНезаполненного		= Не ЗначениеЗаполнено(Объект.Контрагент);
	Иначе
		Элементы.Контрагент.АвтоОтметкаНезаполненного	= Ложь;
		ЭЛементы.Контрагент.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;		
	Если ЦМООбязательно Тогда
		Элементы.ЦМО.АвтоОтметкаНезаполненного	= Истина;
		ЭЛементы.ЦМО.ОтметкаНезаполненного		= Не ЗначениеЗаполнено(Объект.ЦМО);
	Иначе
		Элементы.ЦМО.АвтоОтметкаНезаполненного	= Ложь;
		ЭЛементы.ЦМО.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеТаблицыОсновныеСредства()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = УправлениеОсновнымиСредствами.ДанныеОбъектовОС(МассивОбъектовОС, Объект.Ссылка);
	
	Для каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
		Если ДанныеОбъектаОС <> Неопределено Тогда
			УстановитьДинамическиеДанныеСтрокиОсновныеСредства(СтрокаТаблицы, ДанныеОбъектаОС);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеСтрокиОсновныеСредства(СтрокаТаблицы, ДанныеОбъектаОС)
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС, "ГрупповойУчет,ВидНФА");
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
	 ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
	 ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование Тогда
		СтрокаТаблицы.СчетУчета = ДанныеОбъектаОС.ЗабалансовыйСчет;
		СтрокаТаблицы.ЭтоСчетБиблиотеки = Ложь;
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		СтрокаТаблицы.СчетУчета = ДанныеОбъектаОС.СчетВложений;
		СтрокаТаблицы.ЭтоСчетБиблиотеки = Ложь;
	Иначе
		СтрокаТаблицы.СчетУчета = ДанныеОбъектаОС.СчетУчета;
		СтрокаТаблицы.ЭтоСчетБиблиотеки = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(
			СтрокаТаблицы.СчетУчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	Если ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если Элементы.КПС.ОтметкаНезаполненного Тогда
		СтруктураРеквизитов.Вставить("КПС");
	КонецЕсли;
	Если Элементы.ЦМО.ОтметкаНезаполненного Тогда
		СтруктураРеквизитов.Вставить("ЦМО", "МОЛ/Место хранения");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.Подразделение.ОтметкаНезаполненного Тогда
			СтруктураРеквизитов.Вставить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхвПользование")
	 ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		СтруктураРеквизитов.Вставить("Контрагент");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ОбнулитьСуммы()

	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТаблицы.Сумма = 0;
		СтрокаТаблицы.СуммаАмортизации = 0;
		СтрокаТаблицы.Цена = 0;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Истина)

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, СообщатьОбОшибках);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ПараметрыПолученияОстатков = ПараметрыПолученияОстатков();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Объект.ОсновныеСредства, ПараметрыПолученияОстатков.ТаблицаОС);
	ПараметрыПолученияОстатков.ТаблицаОС.ЗаполнитьЗначения(Объект.КФО, "КФО");
	ПараметрыПолученияОстатков.ТаблицаОС.ЗаполнитьЗначения(Объект.КПС, "КПС");
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков); 
	Иначе
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ОсновноеСредство",	"ОсновноеСредство");
	ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",	"ИнвентарныйНомер");
	ПараметрыЗаполнения.Вставить("Количество",			"Количество");
	ПараметрыЗаполнения.Вставить("Цена",				"Цена");
	ПараметрыЗаполнения.Вставить("Сумма",				"Сумма");
	ПараметрыЗаполнения.Вставить("СуммаАмортизации",	"СуммаАмортизации");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(СтрокаТаблицы.СчетУчета) Тогда
			ПараметрыЗаполнения.Вставить("ЭтоБиблиотечныйФонд", Истина);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер", Ложь);
	
	Для каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, СтрокаТаблицы, ПараметрыЗаполнения);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПараметрыПолученияОстатков()
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
	ПараметрыПолученияОстатков.ЦМО 				= Объект.ЦМО;
	ПараметрыПолученияОстатков.Подразделение	= Объект.Подразделение;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
	 ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда")
	 ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование") Тогда
		ПараметрыПолученияОстатков.ИспользуемыйСчет = "ЗабалансовыйСчет";
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	КонецЕсли;
	
	Возврат ПараметрыПолученияОстатков;

КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация",	Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО",			Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО",			Объект.КФО);
	
	Если Элементы.КПС.АвтоОтметкаНезаполненного Тогда
		ПараметрыПодбора.Отбор.Вставить("КПС", Объект.КПС);
	КонецЕсли;
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
		ПараметрыПодбора.Отбор.Вставить("ЦМО",				Объект.ЦМО);
		ПараметрыПодбора.Отбор.Вставить("Подразделение",	Объект.Подразделение);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ПоказыватьОстатки", Истина);
	ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер", Истина);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда") 
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование") Тогда
		ПараметрыПодбора.Вставить("ВключатьЗабалансовыеСчета", Истина);
	Иначе
		ПараметрыПодбора.Вставить("ВключатьБалансовыеСчета", Истина);
		Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
			СостоянияОС = Новый СписокЗначений;
			СостоянияОС.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
			СостоянияОС.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
			ПараметрыПодбора.Отбор.Вставить("Состояние", СостоянияОС);
		КонецЕсли;
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиент.ДобавитьОбщиеПараметрыВыбораОсновныхСредствПриВыбытии(
		ПараметрыПодбора, Объект.ВидОперации);
		
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
		НастройкиВыбора = Новый НастройкиКомпоновкиДанных;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиВыбора.Отбор,
			"СобытиеВПользовании",, ВидСравненияКомпоновкиДанных.НеЗаполнено,, Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ПараметрыПодбора.Вставить("ДополнительныйОтбор", НастройкиВыбора.Отбор);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ТребуемыеДанные", "Цена");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаКлиенте
Процедура ПересчитатьНДС(ТекущиеДанные)

	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС);
	Если Объект.СуммаВключаетНДС Тогда
		ТекущиеДанные.СуммаНДС = ТекущиеДанные.ЦенаПродажи / (100 + СтавкаНДС) *СтавкаНДС;
	Иначе
		ТекущиеДанные.СуммаНДС = ТекущиеДанные.ЦенаПродажи / 100 *СтавкаНДС;
	КонецЕсли;
	ПересчитатьВсего(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсего(ТекущиеДанные)

	Если Объект.СуммаВключаетНДС Тогда
		ТекущиеДанные.Всего = ТекущиеДанные.ЦенаПродажи;
	Иначе
		ТекущиеДанные.Всего = ТекущиеДанные.ЦенаПродажи + ТекущиеДанные.СуммаНДС;
	КонецЕсли;

КонецПроцедуры

