&НаКлиенте
Процедура ЗаполнитьРаздел3Клиент()
	
	Объект.Раздел3.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	ЗаполнитьРаздел3Сервер();
	
	Если Объект.Раздел3.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='В разделе 3 отсутствуют строки'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 10);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел3Сервер()
	
	Документы.ИнвентаризационнаяОписьОстатковНаСчетах.ЗаполнитьРаздел3(Объект);
	
КонецПроцедуры

#КонецОбласти

