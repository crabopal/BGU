&НаСервере
Процедура ИнициализироватьФорму()
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	НастроитьНедоступностьИзмененияКолонок();
	
	УстановитьУсловноеОформление();
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	УстановитьПредставлениеСчета();
	
	УстановитьПредставлениеНомераКомиссии();
	
	УстановитьПредставлениеМестаПроведения();
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ЭтаФорма);
	
КонецПроцедуры
	
&НаСервере
Процедура УстановитьПредставлениеСчета()
	
	ПредставлениеСчета = "";
	
	Если ЗначениеЗаполнено(Объект.КФО) Или ЗначениеЗаполнено(Объект.Счет) Тогда
		ПредставлениеСчета = СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(Объект.КФО), Строка(Объект.КФО), "0"),
			?(ЗначениеЗаполнено(Объект.Счет), Строка(Объект.Счет), "000"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНомераКомиссии()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеНомераКомиссии(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеМестаПроведения()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеМестаПроведения(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонок()
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("Раздел1КассовыйОрган");
	НедоступныеКолонки.Добавить("Раздел1ЛицевойСчет");
	НедоступныеКолонки.Добавить("Раздел1ВалютаСчета");
	НедоступныеКолонки.Добавить("Раздел1СуммаПоУчетуВал");
	НедоступныеКолонки.Добавить("Раздел1СуммаПоУчетуРуб");
	
	НедоступныеКолонки.Добавить("Раздел2КассовыйОрган");
	НедоступныеКолонки.Добавить("Раздел2ЛицевойСчет");
	НедоступныеКолонки.Добавить("Раздел2ВалютаСчета");
	НедоступныеКолонки.Добавить("Раздел2СуммаОтклоненийВал");
	
	НедоступныеКолонки.Добавить("Раздел3КассовыйОрган");
	НедоступныеКолонки.Добавить("Раздел3ЛицевойСчет");
	НедоступныеКолонки.Добавить("Раздел3ВалютаСчета");
	НедоступныеКолонки.Добавить("Раздел3СуммаОтклоненийВал");
	НедоступныеКолонки.Добавить("Раздел3СуммаОтклоненийРуб");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтаФорма, НедоступныеКолонки);
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииСотрудник");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки, Ложь);
	
КонецПроцедуры

