#Область ОбработчикиСобытийЭлементовТаблицыФормы_Раздел2

&НаКлиенте
Процедура Раздел2ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		СтруктураИнициализации = Новый Структура();
		СтруктураИнициализации.Вставить("ДобавленоВручную", Истина);
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураИнициализации);
	КонецЕсли;
	
КонецПроцедуры

