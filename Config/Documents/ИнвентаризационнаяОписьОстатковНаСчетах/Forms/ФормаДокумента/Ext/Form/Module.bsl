&НаКлиенте
Процедура ЗаполнитьРаздел2Клиент()
	
	Объект.Раздел2.Очистить();
	Объект.Раздел3.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	ЗаполнитьРаздел2Сервер();
	
	Если Объект.Раздел2.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='В разделе 1 отсутствуют строки'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 10);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел2Сервер()
	
