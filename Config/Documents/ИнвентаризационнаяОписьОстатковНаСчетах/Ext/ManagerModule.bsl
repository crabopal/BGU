#Область ПрограммныйИнтерфейс

Функция ПолучитьДанныеУчета(ПараметрыПроцедуры) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатковНаСчетах(ПараметрыПроцедуры);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДатаИнвентаризации",				ПараметрыПоиска.ДатаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",						ПараметрыПоиска.ДатаОстатков);
	ЗапросПоиск.УстановитьПараметр("ДатаСреза",							ПараметрыПоиска.ДатаСреза);
	ЗапросПоиск.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросПоиск.УстановитьПараметр("КФО",								ПараметрыПоиска.КФО);
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("Подразделение",						ПараметрыПоиска.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",						ПараметрыПоиска.ПустаяДата);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьКазначейскиеЛицевыеСчета",	ПараметрыПоиска.ВыбиратьКазначейскиеЛицевыеСчета);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьБанковскиеЛицевыеСчета",	ПараметрыПоиска.ВыбиратьБанковскиеЛицевыеСчета);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстатки();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаОстатков = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела1", ТаблицаОстатков);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРаздел2(ДокументОбъект) Экспорт
	
	// Заполняет отклонения в раздел 2 по формуле гр.6 "минус" гр.13
	
	ДокументОбъект.Раздел2.Очистить();
	
	КурсыВалют = ПолучитьКурсыВалют(ДокументОбъект);
	
	Для Каждого СтрокаРаздела1 Из ДокументОбъект.Раздел1 Цикл
		НоваяСтрока = ДокументОбъект.Раздел2.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела1, "КассовыйОрган,ЛицевойСчет,ВалютаСчета");
		
		НоваяСтрока.Курс = ПолучитьКурсВалюты(СтрокаРаздела1.ВалютаСчета, КурсыВалют);
		НоваяСтрока.СуммаОтклоненийВал = СтрокаРаздела1.СуммаПоУчетуВал - СтрокаРаздела1.СуммаПоВыпискеВал;
		НоваяСтрока.СуммаОтклоненийРуб = НоваяСтрока.СуммаОтклоненийВал * НоваяСтрока.Курс;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел3(ДокументОбъект) Экспорт
	
	// В случае если по итогам инвентаризации отклонения не установлены, то в графах 1 и 7 Раздела 3 проставляются нули,
	// в графе 8 отражается заключение инвентаризационной комиссии – "Отклонения не выявлены..."
	
	ТекстЗаключенияКомиссииОтклоненияНеВыявлены = ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ДокументОбъект.Ссылка);
	
	ДокументОбъект.Раздел3.Очистить();
	
	Для Каждого СтрокаРаздела2 Из ДокументОбъект.Раздел2 Цикл
		НоваяСтрока = ДокументОбъект.Раздел3.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела2);
		
		ОтклоненияУстановлены = СтрокаРаздела2.СуммаОтклоненийВал <> 0 Или СтрокаРаздела2.СуммаОтклоненийРуб <> 0;
		
		Если Не ОтклоненияУстановлены Тогда
			НоваяСтрока.ЗаключениеКомиссии = ТекстЗаключенияКомиссииОтклоненияНеВыявлены;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьВыявленыОтклонения(ДокументОбъект);
	
КонецПроцедуры

Процедура УстановитьВыявленыОтклонения(ДокументОбъект) Экспорт
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел3 Цикл
		Если СтрокаТаблицы.СуммаОтклоненийВал <> 0 Или СтрокаТаблицы.СуммаОтклоненийРуб <> 0 Тогда
			ДокументОбъект.ВыявленыОтклонения = Истина;
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ВыявленыОтклонения = Ложь;
	
КонецПроцедуры

Процедура ПроверитьЗаполнение(Знач ДокументОбъект, Отказ) Экспорт
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

