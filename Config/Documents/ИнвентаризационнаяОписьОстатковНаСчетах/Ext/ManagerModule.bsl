Функция ПолучитьДанныеДляПечати0510464(МассивОбъектов)
	
	СвойстваВалютыУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Константы.ВалютаРегламентированногоУчета.Получить(), "Код,НаименованиеПолное");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",				МассивОбъектов);
	ЗапросПоиск.УстановитьПараметр("КодВалютыУчета",			СвойстваВалютыУчета.Код);
	ЗапросПоиск.УстановитьПараметр("НаименованиеВалютыУчета",	СвойстваВалютыУчета.НаименованиеПолное);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510464();
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	Данные.Вставить("ДополнительныеПараметры", ПолучитьДополнительныеПараметрыПечати0510464());
	
	Данные.Выборки.Вставить("Шапки", РезультатыЗапроса[0].Выбрать());
	Данные.Выборки.Вставить("Раздел1", РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2", РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел3", РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат Данные;
	
КонецФункции

