Функция ПолучитьПараметрыПоискаОстатковНаСчетах(ПараметрыПроцедуры)
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ДатаСреза = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(ПараметрыПроцедуры.Счет, ДатаСреза);
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Счета20110 = БухгалтерскийУчет.СписокСчетов("201.10", ДатаСреза);
	Счета20120 = БухгалтерскийУчет.СписокСчетов("201.20", ДатаСреза);
	
	ПараметрыПоиска = Новый Структура();
	
	ПараметрыПоиска.Вставить("ДатаИнвентаризации",					ПараметрыПроцедуры.ДатаИнвентаризации);
	ПараметрыПоиска.Вставить("ДатаОстатков",						ДатаОстатков);
	ПараметрыПоиска.Вставить("ДатаСреза",							ДатаСреза);
	ПараметрыПоиска.Вставить("Организация",							ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("КФО",									ПараметрыПроцедуры.КФО);
	ПараметрыПоиска.Вставить("СписокСчетов",						СписокСчетов);
	ПараметрыПоиска.Вставить("ИспользоватьВалютныйУчет",			ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",									ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоПодразделению",	ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("Подразделение",						ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ПустаяДата",							'00010101');
	ПараметрыПоиска.Вставить("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ПараметрыПоиска.Вставить("ВыбиратьКазначейскиеЛицевыеСчета",	Счета20110.Найти(ПараметрыПроцедуры.Счет) <> Неопределено);
	ПараметрыПоиска.Вставить("ВыбиратьБанковскиеЛицевыеСчета",		Счета20120.Найти(ПараметрыПроцедуры.Счет) <> Неопределено);
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстатки()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все лицевые счета учреждения без отбора по КФО
	|//
	|ВЫБРАТЬ
	|	Ссылка		КАК Ссылка,
	|	ВалютаСчета	КАК ВалютаСчета
	|ПОМЕСТИТЬ
	|	ВсеЛицевыеСчета
	|ИЗ
	|	Справочник.ЛицевыеСчета
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Владелец = &Организация
	|	И (&ВыбиратьКазначейскиеЛицевыеСчета И ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|		ИЛИ &ВыбиратьБанковскиеЛицевыеСчета И ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Банковский))
	|	И ВЫБОР
	|		КОГДА НЕ ДатаОткрытия = &ПустаяДата И НЕ ДатаЗакрытия = &ПустаяДата ТОГДА
	|			&ДатаИнвентаризации МЕЖДУ ДатаОткрытия И ДатаЗакрытия
	|			ИЛИ &ДатаИнвентаризации МЕЖДУ ДатаЗакрытия И ДатаОткрытия
	|		КОГДА НЕ ДатаОткрытия = &ПустаяДата ТОГДА
	|			ДатаОткрытия <= &ДатаИнвентаризации
	|		КОГДА НЕ ДатаЗакрытия = &ПустаяДата ТОГДА
	|			&ДатаИнвентаризации <= ДатаЗакрытия
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Лицевые счета учреждения с отбором по КФО
	|//
	|ВЫБРАТЬ
	|	ЛицевойСчет	КАК Ссылка,
	|	ВалютаСчета	КАК ВалютаСчета
	|ПОМЕСТИТЬ
	|	ЛицевыеСчета
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВсеЛицевыеСчета.Ссылка							КАК ЛицевойСчет,
	|		ВсеЛицевыеСчета.ВалютаСчета						КАК ВалютаСчета,
