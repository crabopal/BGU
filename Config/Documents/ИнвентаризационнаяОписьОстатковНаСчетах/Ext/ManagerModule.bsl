Функция СформироватьПечатнуюФорму0510464(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	КлючПараметровПечати = "ПечатьФормы0510464";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.Автомасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерДокументаДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	КодСчета = СтрШаблон("%1.%2",
		?(ЗначениеЗаполнено(СтрокаШапки.КФО), Строка(СтрокаШапки.КФО), "0"),
		?(ЗначениеЗаполнено(СтрокаШапки.Счет), Строка(СтрокаШапки.Счет), "000.00"));
	
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.РешениеОПроведенииИнвентаризации,
		СтрокаШапки.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("Дата",				СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер",			НомерДокументаДляПечати);
	ЗначенияПараметров.Вставить("КодСчета",			КодСчета);
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапки.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапки.НомерКомиссии, СтрокаШапки.НомерРабочейКомиссии, Истина));
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 1
	
	ВывестиТаблицуРаздела0510464("1", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ВывестиТаблицуРаздела0510464("2", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// РАЗДЕЛ 3
	
	ВывестиТаблицуРаздела0510464("3", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// ПРИЛОЖЕНИЯ
	
	УправлениеПечатьюБГУ.ВывестиПриложенияПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.Приложение);
	
	// КОМИССИЯ
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапки.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссий, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиТаблицуРаздела0510464(НомерРазделаСтрокой, ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["Раздел" + НомерРазделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	// В случае отсутствия информации по разделам 2 и 3 указанные разделы не формируются
	Если Выборка.Количество() = 0 И (НомерРазделаСтрокой = "2" Или НомерРазделаСтрокой = "3") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Заголовок"];
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Шапка"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Строка"];
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Итого"];
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.ИнвентаризационнаяОписьОстатковНаСчетах.ЗаполнитьОбластьСтрокаТаблицы0510464_Раздел" + НомерРазделаСтрокой;
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ВремЗапрос = Новый Запрос("ВЫБРАТЬ 0 КАК Поле1");
	ВыборкаИтогиТаблицы = ВремЗапрос.Выполнить().Выбрать();
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаИтогиТаблицы;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
КонецПроцедуры

	
Процедура ЗаполнитьОбластьСтрокаТаблицы0510464_Раздел1(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", Выборка.НомерСтроки);
	ЗначенияПараметров.Вставить("НомерСчета", СокрЛП(Выборка.НомерСчета));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел1");
	
	Если СокрЛП(Выборка.КодВалюты) = "643" Тогда
		// В случае если по графе 4 цифровой код валюты имеет значение "643" (Российский рубль), графы 7 – 9 не заполняются.
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(ДополнительныеПараметры.ОчищающаяСтруктураРаздела1);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510464_Раздел2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", Выборка.НомерСтроки);
	ЗначенияПараметров.Вставить("НомерСчета", СокрЛП(Выборка.НомерСчета));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел2");
	
	Если Выборка.СуммаОтклоненийВал = 0 И Выборка.СуммаОтклоненийРуб = 0 Тогда
		// В случае если в результате инвентаризации не выявлены отклонения, в графах 1 – 8 Раздела 2 отражаются нули.
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(ДополнительныеПараметры.ОчищающаяСтруктураРаздела2);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510464_Раздел3(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", Выборка.НомерСтроки);
	ЗначенияПараметров.Вставить("НомерСчета", СокрЛП(Выборка.НомерСчета));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел3");
	
	Если Выборка.СуммаОтклоненийВал = 0 И Выборка.СуммаОтклоненийРуб = 0 Тогда
		// В случае если по итогам инвентаризации отклонения не установлены, то в графах 1 и 7 Раздела 3 проставляются нули
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(ДополнительныеПараметры.ОчищающаяСтруктураРаздела3);
	КонецЕсли;	
	
КонецПроцедуры

