Функция ПолучитьКурсыВалют(ДокументОбъект)
	
	ДатаКурса = КонецДня(ДокументОбъект.ДатаИнвентаризации);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВремТаблица = ДокументОбъект.Раздел1.Выгрузить(, "ВалютаСчета");
	ВремТаблица.Свернуть("ВалютаСчета");
	МассивВалют = ВремТаблица.ВыгрузитьКолонку("ВалютаСчета");
	
	КурсыВалют = Новый Соответствие();
	
	Для Каждого Валюта Из МассивВалют Цикл
		Если Не ЗначениеЗаполнено(Валюта) Тогда
			Продолжить;
		КонецЕсли;
		
		КурсыВалют.Вставить(Валюта, РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса));
	КонецЦикла;
	
	Возврат КурсыВалют;
	
КонецФункции

Функция ПолучитьКурсВалюты(Валюта, КурсыВалют)
	
	СтруктураКурса = КурсыВалют.Получить(Валюта);
	
	Если СтруктураКурса = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если СтруктураКурса.Кратность = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат СтруктураКурса.Курс / СтруктураКурса.Кратность;
	
КонецФункции

#Область Печать

Функция ПечатьФормы0510464(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	КлючПараметровПечати = "ПечатьФормы0510464";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.Автомасштаб = Истина;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати0510464(МассивОбъектов);
	
	ОбластиМакета = ПолучитьОбластиМакета0510464();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		ТабДокумент = СформироватьПечатнуюФорму0510464(Данные, ВыборкаШапка, ОбластиМакета, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510464 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

