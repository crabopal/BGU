&НаСервереБезКонтекста
Функция ЗначенияРеквизитовОС(ОсновноеСредство, Организация, Дата)

	Результат = Новый Структура("ПервоначальнаяСтоимость, КодПоОКОФ, АмортизационнаяГруппа", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
	|	ЕСТЬNULL(ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость, 0) КАК ПервоначальнаяСтоимость
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ПервоначальнаяСтоимость = Выборка.ПервоначальнаяСтоимость;
	КонецЕсли;
	
	ДанныеОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, "АмортизационнаяГруппа");
	
	ЗаполнитьЗначенияСвойств(Результат, ДанныеОбъекта);
	
	Возврат Результат;

КонецФункции // ЗначенияРеквизитовОС()

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗначенияРевизитовИзОС(Форма, ИдентификаторСтроки, ТолькоРеквизитыФормы = Ложь)

	ТекущиеДанные = Форма.Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ТекущиеДанные <> Неопределено Тогда
		ПервоначальнаяСтоимость = 0;
		
		РеквизитыОС = ЗначенияРеквизитовОС(ТекущиеДанные.ОсновноеСредство, Форма.Объект.Организация, Форма.Объект.Дата);
		
		РеквизитыОС.Свойство("КодПоОКОФ", 				Форма.ОС_КодОКОФ);
		РеквизитыОС.Свойство("АмортизационнаяГруппа",	Форма.ОС_АмортизационнаяГруппа);
		Если НЕ ТолькоРеквизитыФормы Тогда
			РеквизитыОС.Свойство("ПервоначальнаяСтоимость",	ПервоначальнаяСтоимость);
			Если ПервоначальнаяСтоимость <> 0 Тогда
				Если Не ЗначениеЗаполнено(ТекущиеДанные.Количество) Тогда
					ТекущиеДанные.Количество = 1;
				КонецЕсли;
				ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ПервоначальнаяСтоимость;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

