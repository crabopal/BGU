&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборОСОбработан = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("КодПоОКОФ", 			ОС_КодОКОФ);
		ВыбранноеЗначение.Свойство("СчетУчета", 			ОС_СчетУчета);
		ВыбранноеЗначение.Свойство("АмортизационнаяГруппа",	ОС_АмортизационнаяГруппа);
	КонецЕсли;
	
	СоответствиеРеквизитов = Новый Соответствие;
	СоответствиеРеквизитов.Вставить("ГрупповойУчет", 			"ГрупповойУчет");
	СоответствиеРеквизитов.Вставить("ИнвентарныйНомер", 		"ИнвентарныйНомер");
	СоответствиеРеквизитов.Вставить("ПервоначальнаяСтоимость",	"Сумма");
	
	УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбораОсновногоСредства(ВыбранноеЗначение, ТекущиеДанные, СоответствиеРеквизитов, ВыборОСОбработан);
	Если ТекущиеДанные.Сумма <> 0 И ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление") Тогда
		ТекДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ПараметрыФормы = Новый Структура("Отбор, НаДату, ТекущаяСтрока",
											Новый Структура("Владелец, ОС",
															Объект.Организация,
															ТекДанные.ОсновноеСредство),
											?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата),													
											ТекДанные.ИнвентарныйНомер);
		//Параметры для формирования Инвентарных номеров
		ПараметрыФормы.Вставить("Дата",								Объект.Дата);
		ПараметрыФормы.Вставить("КФО",								ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
		ПараметрыФормы.Вставить("СчетУчета",						ТекДанные.СчетУчета);
		ПараметрыФормы.Вставить("Организация",						Объект.Организация);
		ПараметрыФормы.Вставить("ОсновноеСредство",					ТекДанные.ОсновноеСредство);
		ПараметрыФормы.Вставить("ИнвентарныйНомер",					ТекДанные.ИнвентарныйНомер);
		ПараметрыФормы.Вставить("ФормированиеИзДокумента",			Истина);
		ПараметрыФормы.Вставить("Регистратор",						Объект.Ссылка);
	    ПараметрыФормы.Вставить("ФормированиеИнвНомераБезОбработки",Ложь);
		ПараметрыФормы.Вставить("ПроверитьСоздатьИнвентарныйНомер",	Истина);
		ПараметрыФормы.Вставить("ПеренестиВсеНомера",				Истина);
		ПараметрыФормы.Вставить("ТЧОсновныеСредства",				Объект.ОсновныеСредства);
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ПометкаУдаления, Владелец, ОС", Ложь, Объект.Организация, ТекДанные.ОсновноеСредство));
		
		ДопустимыеВидыКПС = Новый СписокЗначений;
		ДопустимыеВидыКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
	
		ПараметрыФормы.Вставить("ДопустимыеВидыКПС",ДопустимыеВидыКПС);
		ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", ПараметрыФормы, Элемент);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ЭтоПервый = Истина;
		Для Каждого СтрокаСписка Из ВыбранноеЗначение Цикл
			Если ЭтоПервый Тогда
				ЭтоПервый = Ложь;
				ТекДанные.ИнвентарныйНомер 	= СтрокаСписка.Значение;	
				ТекДанные.Количество		= 1;
			Иначе
				НоваяСтрока = Объект.ОсновныеСредства.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекДанные);
				НоваяСтрока.ИнвентарныйНомер 	= СтрокаСписка.Значение;
				НоваяСтрока.Количество			= 1;
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) И ТекущиеДанные.Количество<>1 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
КонецПроцедуры

