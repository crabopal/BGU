////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ПриложениеЗавершениеВвода(Знач ВведенныйТекст, Знач ДополнительныеПараметры) Экспорт
	
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Приложение = ВведенныйТекст;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	//ПараметрыПодбора.Отбор.Вставить("ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.Казна"));
	ПараметрыПодбора.Вставить("Казна", Истина);
	ПараметрыПодбора.Вставить("ТребуемыеДанные","ГрупповойУчет,ПервоначальнаяСтоимость");
	
	ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер", ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны);
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление") Тогда
		НастройкиПодбора = Новый НастройкиКомпоновкиДанных;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиПодбора.Отбор, "Состояние",,ВидСравненияКомпоновкиДанных.НеЗаполнено,, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ПараметрыПодбора.Вставить("ДополнительныйОтбор", НастройкиПодбора.Отбор);
	Иначе
		Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
			СостоянияОС = Новый СписокЗначений;
			СостоянияОС.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
			СостоянияОС.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
			ПараметрыПодбора.Отбор.Вставить("Состояние",СостоянияОС);
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПоступления", НСтр("ru='Вид поступления'"));
	СтруктураРеквизитов.Вставить("Организация");
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда")
		ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование") Тогда
		СтруктураРеквизитов.Вставить("Контрагент", "Поставщик");
		Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
			СтруктураРеквизитов.Вставить("ИФО");
		КонецЕсли;
		Если УчитываетсяПодразделение(Объект.ВидПоступления) Тогда
			СтруктураРеквизитов.Вставить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	
    Возврат СтруктураРеквизитов;
КонецФункции

&НаСервере
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	
	Элементы.Подразделение.Доступность						= ДоступностьЭлементов;
	Элементы.РеквизитыЛицевогоСчета.Доступность				= ДоступностьЭлементов;

	Элементы.СоставКомиссииПодобратьСотрудников.Доступность	= ДоступностьЭлементов И ТолькоПросмотр <> Истина;
	Элементы.ВыбратьКомиссию.Доступность					= ДоступностьЭлементов И ТолькоПросмотр <> Истина;
	Элементы.ВыбратьПредседателя.Доступность				= ДоступностьЭлементов И ТолькоПросмотр <> Истина;

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ЭтоПоступление = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление");
	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	ВедениеАналитическогоУчета = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	Элементы.ПорядокПогашенияСтоимости.Доступность				= ЭтоПоступление;
	Элементы.ЗаполнитьДанныеОбОС.Доступность					= ДоступностьЭлементов;
	Элементы.СрокПолезногоИспользования.Доступность 			= ДоступностьЭлементов И ЭтоПоступление И ВедениеАналитическогоУчета;
	Элементы.ПорядокПогашенияСтоимости.Доступность 				= ДоступностьЭлементов И ЭтоПоступление И ВедениеАналитическогоУчета;
	
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровАмортизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	Если Объект.ОсновныеСредства.Количество()>0 Тогда
		
		УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	Объект.ПорядокПогашенияСтоимости,
																									Элементы.СпособНачисленияАмортизации,
																									ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));
		Элементы.НачислятьАмортизацию.Доступность = Объект.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
		
		ДоступностьЭлементовГруппыСчетаЗатрат = Объект.ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
												И ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости);
		УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, ДоступностьЭлементовГруппыСчетаЗатрат);
	Иначе
		Элементы.СпособНачисленияАмортизации.Доступность	= Ложь;
		Элементы.НачислятьАмортизацию.Доступность			= Ложь;
		УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, Ложь);		
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьПараметровАмортизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, ДоступностьЭлементов = Истина)

	Элементы = Форма.Элементы;
	
	Элементы.СчетУчетаЗатрат.Доступность	= ДоступностьЭлементов;	
	Элементы.КЭКЗатрат.Доступность 			= ДоступностьЭлементов;	
	Элементы.КПСЗатрат.Доступность 			= ДоступностьЭлементов;	

КонецПроцедуры // УстановитьДоступностьЭлементовГруппыСчетаЗатрат()
 
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(Форма)

	Если Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
		И Форма.Объект.ОсновныеСредства.Количество() > 0
		И ЗначениеЗаполнено(Форма.Объект.ОсновныеСредства[0].ОсновноеСредство) Тогда
		
		СтруктураРеквизитовОС = Новый Структура("КодПоОКОФ, АмортизационнаяГруппа",
												Форма.ОС_КодОКОФ,
												Форма.ОС_АмортизационнаяГруппа);
		
		Форма.ЗаполнитьДанныеОбОС = УправлениеОсновнымиСредствамиКлиентСервер.ПредставлениеСтрокиЗаполнитьДанныеОбОС(
			СтруктураРеквизитовОС, Форма.Объект.Дата);
		
	Иначе
		Форма.ЗаполнитьДанныеОбОС = "";
	КонецЕсли;

КонецПроцедуры // УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС()

&НаКлиенте
Процедура РассчитатьОставшийсяСрокПолезногоИспользования()
	
	Если Объект.СрокПолезногоИспользования=0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования = 0;
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаВводаВЭксплуатацию) Тогда
		ДатаОкончанияЭксплуатации = КонецМесяца(ДобавитьМесяц(ТекущиеДанные.ДатаВводаВЭксплуатацию, Объект.СрокПолезногоИспользования));
		ВрДата = НачалоМесяца(ДобавитьМесяц(Объект.Дата,1));
		Пока КонецМесяца(ВрДата) <= ДатаОкончанияЭксплуатации Цикл
			ТекущиеДанные.ОставшийсяСрокПолезногоИспользования = ТекущиеДанные.ОставшийсяСрокПолезногоИспользования + 1;
			ВрДата = ДобавитьМесяц(ВрДата, 1);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры // РассчитатьОставшийсяСрокПолезногоИспользования()

&НаКлиенте
Процедура ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Организация,
													СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьВыборСубконто()

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);

	БухгалтерскиеОперацииКлиент.СубконтоПриИзмененииСпр(Элемент, СтрокаДанных, НомерСубконто);
	
	Для Счетчик = НомерСубконто По 3 Цикл
		Если Объект["СубконтоЗатрат"+Счетчик] <> СтрокаДанных["Субконто"+Счетчик] Тогда
			Объект["СубконтоЗатрат"+Счетчик] = СтрокаДанных["Субконто"+Счетчик];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ОбработатьИзменениеСубконто()

&НаСервере
Процедура УстановитьГрупповойУчет()

	МассивСсылок = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСсылок, "ГрупповойУчет");
	Для каждого ТекущиеДанные Из Объект.ОсновныеСредства Цикл
		
		ТекОС = ЗначенияРеквизитов[ТекущиеДанные.ОсновноеСредство];
		Если ТекОС <> Неопределено Тогда
			ТекущиеДанные.ГрупповойУчет = ТекОС.ГрупповойУчет;
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры // УстановитьГрупповойУчет()

&НаКлиенте
Процедура ПриИзмененииОсновногоСредства(ПолучатьИнвентарныйНомер)
	
	ЭтоПоступление = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление");
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ВыборОСОбработан Тогда
		ЗаполнитьЗначенияРевизитовИзОС(ЭтаФорма, ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	Если ПолучатьИнвентарныйНомер И ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		УстановитьИнвентарныйНомер(ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер, Объект.Дата);
	КонецЕсли;
	
	УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма);
	Если ЭтоПоступление Тогда
		УстановитьСрокПолезногоИспользования();
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
		УстановитьПорядокПогашенияСтоимости();
		ПолучитьПараметрыНачисленияАмортизации(ТекущиеДанные.ОсновноеСредство);																								
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости) Тогда
		Объект.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
		Объект.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		Объект.СчетУчетаЗатрат 				= ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, Новый Структура("СчетОбъекта, Субконто1, Субконто2, Субконто3,
																									|Подразделение,
																									|ОчищатьОтстуствующие,
																									|ИспользоватьУчетПоПодразделениям,
																									|СубконтоОбъекта1, СубконтоОбъекта2, СубконтоОбъекта3",
																									"СчетУчетаЗатрат",
																									"СубконтоЗатрат1",
																									"СубконтоЗатрат2",
																									"СубконтоЗатрат3",
																									"ПодразделениеЗатрат",
																									,
																									ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям"),
																									"СубконтоЗатрат1",
																									"СубконтоЗатрат2",
																									"СубконтоЗатрат3"));
	
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			

КонецПроцедуры // ПриИзмененииОсновногоСредства()

&НаСервере
Процедура УстановитьИнвентарныйНомер(ОсновноеСредство, ИнвентарныйНомер, Дата)
    
	Если НЕ Параметры.Ключ.Пустая() Тогда
		ПериодЗапроса = Параметры.Ключ.МоментВремени();
	Иначе
		ПериодЗапроса = КонецДня(Дата);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	               |	ЕСТЬNULL(МестонахождениеОССрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)) КАК Состояние
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |				&Период,
	               |				ОсновноеСредство = &ОсновноеСредство
	               |					И Регистратор <> &Ссылка) КАК МестонахождениеОССрезПоследних
	               |		ПО ИнвентарныеНомераОС.Ссылка = МестонахождениеОССрезПоследних.ИнвНомер
	               |ГДЕ
	               |	ЕСТЬNULL(МестонахождениеОССрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	               |	И ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	               |	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	Запрос.УстановитьПараметр("ОсновноеСредство", 	ОсновноеСредство);
	Запрос.УстановитьПараметр("Период",				ПериодЗапроса);
	Запрос.УстановитьПараметр("Ссылка",				Параметры.Ключ);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Иначе
		ТаблицаИнвНомеров = Результат.Выгрузить();
		//ИнвентарныйНомер = ТаблицаИнвНомеров[0].ИнвентарныйНомер;
		СтрокаИнвНомера = Неопределено;
		Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
			СтрокаИнвНомера = ТаблицаИнвНомеров.Найти(ИнвентарныйНомер, "ИнвентарныйНомер");
		КонецЕсли;
		Если СтрокаИнвНомера = Неопределено Тогда
			МассивВыбранныхИнвНомеров = Объект.ОсновныеСредства.Выгрузить(,"ИнвентарныйНомер");
			Для каждого ТекСтрокаИнвНомера Из ТаблицаИнвНомеров Цикл
			
				Если МассивВыбранныхИнвНомеров.Найти(ТекСтрокаИнвНомера.ИнвентарныйНомер) = Неопределено Тогда
					ИнвентарныйНомер = ТекСтрокаИнвНомера.ИнвентарныйНомер;
					Возврат;
				КонецЕсли;
			
			КонецЦикла; 
		Иначе
			ИнвентарныйНомер = СтрокаИнвНомера.ИнвентарныйНомер;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ИнвентарныйНомер = Неопределено;

КонецПроцедуры // УстановитьИнвентарныйНомер()

&НаКлиенте
Процедура УстановитьСрокПолезногоИспользования()

	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(ОС_АмортизационнаяГруппа);
	Если Объект.СрокПолезногоИспользования = 0 ИЛИ СрокПолезногоИспользования <> 0 Тогда
		Объект.СрокПолезногоИспользования = СрокПолезногоИспользования;	
	КонецЕсли;

КонецПроцедуры // УстановитьСрокПолезногоИспользования()

&НаСервере
Процедура ПолучитьПараметрыНачисленияАмортизации(ОсновноеСредство)

	Если (Объект.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации 
		ИЛИ Объект.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
		И НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатрат) Тогда
		
		СведенияОбОС = УправлениеОсновнымиСредствами.ПолучитьСведенияОбОС(Объект.Дата, ОсновноеСредство, "СчетУчетаЗатрат, ПодразделениеЗатрат, КЭКЗатрат, КПСЗатрат, СубконтоЗатрат1, СубконтоЗатрат2, СубконтоЗатрат3");
		ЗаполнитьЗначенияСвойств(Объект, СведенияОбОС);
	КонецЕсли;

КонецПроцедуры // ПолучитьПараметрыНачисленияАмортизации()

&НаКлиенте
Процедура УстановитьПараметрыАмортизации()

	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление") Тогда
		Если Объект.ОсновныеСредства.Количество()>0 И Не ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости) Тогда
			Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
				Объект.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
				Объект.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
			Иначе
				Объект.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");	
				Объект.СпособНачисленияАмортизации	= Неопределено;
			КонецЕсли;
			Если Объект.СрокПолезногоИспользования = 0 И ЗначениеЗаполнено(ОС_АмортизационнаяГруппа) Тогда
				УстановитьСрокПолезногоИспользования();
			КонецЕсли;
			ПараметрыВыбораЗначения = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
			УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
							Объект.СпособНачисленияАмортизации,
							Объект.НачислятьАмортизацию,
							ПараметрыВыбораЗначения);
			УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			
		КонецЕсли;
	Иначе
		Объект.СрокПолезногоИспользования 			= 0;
		Объект.ПорядокПогашенияСтоимости 			= Неопределено;
		Объект.СпособНачисленияАмортизации 			= Неопределено;
		Объект.НачислятьАмортизацию					= Ложь;
		Объект.СчетУчетаЗатрат						= Неопределено;
		Объект.КЭКЗатрат							= Неопределено;
		ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, Новый Структура("СчетОбъекта, Субконто1, Субконто2, Субконто3,
																										|Подразделение,
																										|ОчищатьОтстуствующие,
																										|СубконтоОбъекта1, СубконтоОбъекта2, СубконтоОбъекта3",
																										"СчетУчетаЗатрат",
																										"СубконтоЗатрат1",
																										"СубконтоЗатрат2",
																										"СубконтоЗатрат3",
																										"ПодразделениеЗатрат",
																										,
																										"СубконтоЗатрат1",
																										"СубконтоЗатрат2",
																										"СубконтоЗатрат3"));
		УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			
	КонецЕсли;

КонецПроцедуры // УстановитьПараметрыАмортизации()

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьЭлементовПоОперации(Форма, Объект)

	Элементы = Форма.Элементы;
	ЭтоВозврат = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда")
				ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование");
	Элементы.Контрагент.АвтоОтметкаНезаполненного = ЭтоВозврат;				
	Если ЭтоВозврат Тогда
		Элементы.Контрагент.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Контрагент);
	Иначе
		Элементы.Контрагент.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	Элементы.ОсновныеСредстваРассчитать.Доступность = ЭтоВозврат;
	
КонецПроцедуры // ДоступностьЭлементовПоОперации()

&НаСервере
Процедура РассчитатьСуммуВозврата()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОСДокумента.ОсновноеСредство,
	               |	ОСДокумента.ИнвентарныйНомер
	               |ПОМЕСТИТЬ ОСДокумента
	               |ИЗ
	               |	&ОСДокумента КАК ОСДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СобытияОС.ОсновноеСредство,
	               |	СобытияОС.ИнвНомер,
	               |	СобытияОС.Событие,
	               |	СобытияОС.ДатаСобытия
	               |ПОМЕСТИТЬ СобытияОС
	               |ИЗ
	               |	РегистрСведений.СобытияОС КАК СобытияОС
	               |ГДЕ
	               |	СобытияОС.Организация = &Организация
	               |	И (СобытияОС.ОсновноеСредство, СобытияОС.ИнвНомер) В
	               |			(ВЫБРАТЬ
	               |				ОСДокумента.ОсновноеСредство,
	               |				ОСДокумента.ИнвентарныйНомер
	               |			ИЗ
	               |				ОСДокумента)
	               |	И СобытияОС.Событие В (&СобытиеПередача, &СобытиеВозврат)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПереданныеВАренду.ОсновноеСредство,
	               |	ПереданныеВАренду.ИнвНомер,
	               |	ПереданныеВАренду.ДатаСобытия
	               |ПОМЕСТИТЬ ОСвАренде
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		СобытияОС.ИнвНомер КАК ИнвНомер,
	               |		МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |	ИЗ
	               |		СобытияОС КАК СобытияОС
	               |	ГДЕ
	               |		СобытияОС.Событие = &СобытиеПередача
	               |		И СобытияОС.ИнвНомер ЕСТЬ НЕ NULL 
	               |		И СобытияОС.ИнвНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер) КАК ПереданныеВАренду
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СобытияОС КАК СобытияОС
	               |		ПО ПереданныеВАренду.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |			И ПереданныеВАренду.ИнвНомер = СобытияОС.ИнвНомер
	               |			И ПереданныеВАренду.ДатаСобытия < СобытияОС.ДатаСобытия
	               |			И (СобытияОС.Событие = &СобытиеВозврат)
	               |ГДЕ
	               |	СобытияОС.ДатаСобытия ЕСТЬ NULL 
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОСДокумента.ОсновноеСредство,
	               |	ОСДокумента.ИнвентарныйНомер,
	               |	СобытияОС.ДатаСобытия
	               |ИЗ
	               |	ОСДокумента КАК ОСДокумента
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СобытияОС КАК СобытияОС
	               |		ПО ОСДокумента.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |			И ОСДокумента.ИнвентарныйНомер = СобытияОС.ИнвНомер
	               |			И (НЕ(ОСДокумента.ИнвентарныйНомер ЕСТЬ НЕ NULL 
	               |					И ОСДокумента.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаВАренде,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВАренде
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	ОСвАренде КАК ОСвАренде,
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			,
	               |			Счет В (&Счет),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &Контрагент
	               |				И Субконто2 В
	               |					(ВЫБРАТЬ
	               |						ОСвАренде.ОсновноеСредство
	               |					ИЗ
	               |						ОСвАренде)) КАК ЖурналПроводокЕПСБУОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОСвАренде.ОсновноеСредство,
	               |	ОСвАренде.ИнвНомер КАК ИнвентарныйНомер,
	               |	Остатки.СуммаВАренде,
	               |	Остатки.КоличествоВАренде
	               |ИЗ
	               |	ОСвАренде КАК ОСвАренде
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	               |		ПО ОСвАренде.ОсновноеСредство = Остатки.ОсновноеСредство";
	Если Объект.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда Тогда
		Запрос.УстановитьПараметр("Счет",	БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("25"));
		Запрос.УстановитьПараметр("СобытиеПередача",	Перечисления.ВидыСобытийОС.СдачаВАренду);
		Запрос.УстановитьПараметр("СобытиеВозврат",		Перечисления.ВидыСобытийОС.ВозвратИзАренды);
	Иначе
		Запрос.УстановитьПараметр("Счет",	БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("26"));
		Запрос.УстановитьПараметр("СобытиеПередача",	Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование);
		Запрос.УстановитьПараметр("СобытиеВозврат",		Перечисления.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата-1));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ОСДокумента", Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер"));
	Результат = Запрос.Выполнить().Выгрузить();
    Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
	
		СтрокиТекОС = Результат.НайтиСтроки(Новый Структура("ОсновноеСредство, ИнвентарныйНомер", ТекСтр.ОсновноеСредство, ТекСтр.ИнвентарныйНомер));
		Если СтрокиТекОС.Количество() = 0 Тогда
			ТекСтр.Количество 	= 0;
			ТекСтр.Сумма		= 0;
		Иначе
			Если ТекСтр.Количество = 0 Тогда
				ТекСтр.Количество = СтрокиТекОС[0].КоличествоВАренде;
			КонецЕсли;
			Если СтрокиТекОС[0].КоличествоВАренде = 0
				ИЛИ СтрокиТекОС[0].КоличествоВАренде = ТекСтр.Количество Тогда
				ТекСтр.Сумма = СтрокиТекОС[0].СуммаВАренде;
			Иначе
				ТекСтр.Сумма = ТекСтр.Количество * СтрокиТекОС[0].СуммаВАренде / СтрокиТекОС[0].КоличествоВАренде; 
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла; 
	
	
КонецПроцедуры // РассчитатьСуммуВозврата()

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтруктуруПроверяемыхРеквизитов(ВидПоступления, ВключатьПодразделение=Ложь)
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПоступления", НСтр("ru='Вид поступления'"));
	СтруктураРеквизитов.Вставить("Организация");
	Если ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда")
		ИЛИ ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование") Тогда
		СтруктураРеквизитов.Вставить("Контрагент", "Поставщик");
		Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
			СтруктураРеквизитов.Вставить("ИФО");
		КонецЕсли;
		Если ВключатьПодразделение Тогда
			СтруктураРеквизитов.Вставить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	
    Возврат СтруктураРеквизитов;
КонецФункции

