&НаКлиенте
Процедура ВыбратьКомиссию(Команда)
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Организация));
		ОткрытьФорму("Справочник.ПостоянноДействующиеКомиссии.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='Сначала необходимо выбрать организацию'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПредседателя(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьВыборПредседателяКомиссии(ЭтаФорма, Объект.Организация, Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьСотрудников(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборКомиссии(Элементы.СоставКомиссии, Объект.Организация, Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(СформироватьСтруктуруПроверяемыхРеквизитов(Объект.ВидПоступления, УчитываетсяПодразделение(Объект.ВидПоступления)),Объект,Истина) Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммуВозврата();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеОбОСНажатие(Элемент, СтандартнаяОбработка)
	Если Объект.ОсновныеСредства.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Объект.ОсновныеСредства[0];
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		СписокСпособов = Новый СписокЗначений;
		СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации"
															+ ".ПриВводеВЭксплуатацию"));
		ПараметрыФормы = Новый Структура("Ключ, СпособыНачисленияАмортизации",
										ТекущиеДанные.ОсновноеСредство,
										СписокСпособов);
		ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаЭлемента", ПараметрыФормы);
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
