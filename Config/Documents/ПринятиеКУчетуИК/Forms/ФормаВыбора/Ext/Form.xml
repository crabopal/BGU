	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПринятиеКУчетуИК.Ссылка,
	ДокументПринятиеКУчетуИК.ВерсияДанных,
	ДокументПринятиеКУчетуИК.ПометкаУдаления,
	ДокументПринятиеКУчетуИК.Номер,
	ДокументПринятиеКУчетуИК.Дата,
	ДокументПринятиеКУчетуИК.Проведен,
	ДокументПринятиеКУчетуИК.Организация,
	ДокументПринятиеКУчетуИК.ИФО,
	ДокументПринятиеКУчетуИК.Подразделение,
	ДокументПринятиеКУчетуИК.СрокПолезногоИспользования,
	ДокументПринятиеКУчетуИК.НачислятьАмортизацию,
	ДокументПринятиеКУчетуИК.СчетУчетаЗатрат,
	ДокументПринятиеКУчетуИК.СубконтоЗатрат1,
	ДокументПринятиеКУчетуИК.СубконтоЗатрат2,
	ДокументПринятиеКУчетуИК.СубконтоЗатрат3,
	ДокументПринятиеКУчетуИК.Комментарий,
	ДокументПринятиеКУчетуИК.ОснованиеДляАкта,
	ДокументПринятиеКУчетуИК.НомерОснованияДляАкта,
	ДокументПринятиеКУчетуИК.ДатаОснованияДляАкта,
	ДокументПринятиеКУчетуИК.КЭКЗатрат,
	ДокументПринятиеКУчетуИК.Контрагент,
	ДокументПринятиеКУчетуИК.ДолжностьПредседателяКомиссии,
	ДокументПринятиеКУчетуИК.ФамилияПредседателяКомиссии,
	ДокументПринятиеКУчетуИК.ИмяПредседателяКомиссии,
	ДокументПринятиеКУчетуИК.ОтчествоПредседателяКомиссии,
	ДокументПринятиеКУчетуИК.Приложение,
	ДокументПринятиеКУчетуИК.СпособНачисленияАмортизации,
	ДокументПринятиеКУчетуИК.ПорядокПогашенияСтоимости,
	ДокументПринятиеКУчетуИК.РеквизитыЛицевогоСчета,
	ДокументПринятиеКУчетуИК.ИДИсточника,
	ДокументПринятиеКУчетуИК.СуммаДокумента,
	ДокументПринятиеКУчетуИК.КПСЗатрат,
	ДокументПринятиеКУчетуИК.ПодразделениеЗатрат,
	ДокументПринятиеКУчетуИК.ВидПервичногоДокумента,
	ДокументПринятиеКУчетуИК.ДатаПервичногоДокумента,
	ДокументПринятиеКУчетуИК.НомерПервичногоДокумента,
	ДокументПринятиеКУчетуИК.ВидПоступления,
	ДокументПринятиеКУчетуИК.МоментВремени,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
ДокументПринятиеКУчетуИК.Ответственный
ИЗ
	Документ.ПринятиеКУчетуИК КАК ДокументПринятиеКУчетуИК
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ДокументПринятиеКУчетуИК.Ссылка = ОперацииДокументов.Документ}</QueryText>
				<MainTable>Document.ПринятиеКУчетуИК</MainTable>
