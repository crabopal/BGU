	// Действия при изменении ЦМО отправителя должны быть прописаны в процедуре ОбработкаИзмененияЦМООтправителя
	ПараметрыИзмененияЦМО = УправлениеНФАКлиент.ПараметрыИзмененияРеквизитаСОчисткойТЧ();
	ПараметрыИзмененияЦМО.ЗначениеДоИзменения = ЦМООтправительДоИзменения;
	ПараметрыИзмененияЦМО.ИмяРеквизита = "ЦМООтправитель";
	ПараметрыИзмененияЦМО.СинонимРеквизита = НСтр("ru = 'МОЛ/Место хранения'");
	ПараметрыИзмененияЦМО.ИменаТабличныхЧастей = "ОсновныеСредства";

	// Можно добавить обработчик ПриИзмененииЦМООТправитель
	ОбработчикПриИзмененииЦМО = Новый ОписаниеОповещения("ОбработкаИзмененияЦМООтправителя", ЭтотОбъект);
	ПараметрыИзмененияЦМО.ОбработчикПриИзменении = ОбработчикПриИзмененииЦМО;
	
	УправлениеНФАКлиент.ПриИзмененииРеквизитаСОчисткойТЧ(Объект, ПараметрыИзмененияЦМО);
