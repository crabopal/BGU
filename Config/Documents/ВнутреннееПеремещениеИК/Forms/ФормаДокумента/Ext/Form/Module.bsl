&НаСервере
Функция ПараметрыПолученияУчетныхДанных(ТаблицаОС)
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПараметрыДляРасчетаУчетныхДанных();
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект);
	ПараметрыПолученияОстатков.ЦМО = Объект.ЦМООтправитель;
	ПараметрыПолученияОстатков.Подразделение = Объект.ПодразделениеОтправитель;
	ПараметрыПолученияОстатков.ТаблицаОС = ТаблицаОС;
	Дата = НачалоДня(Объект.Дата);
	Счета = Новый Массив;
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("108.00", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.50", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("02.50", Дата));
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("02.5", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("01.50", Дата));
	КонецЕсли;	
	ПараметрыПолученияОстатков.Счета = Счета;
	
	Возврат ПараметрыПолученияОстатков;
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуТЧ(ТекСтрока, ТабОстатков)
	Если ЗначениеЗаполнено(ТекСтрока.ИнвентарныйНомер) Тогда
		СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Иначе	
		СтруктураПоиска = Новый Структура("ОсновноеСредство");
	КонецЕсли;	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
	СтрокиОстатков = ТабОстатков.НайтиСтроки(СтруктураПоиска);
	Если СтрокиОстатков.Количество() = 1 Тогда
		СтрокаОстатков = СтрокиОстатков[0];
		ЗаполнитьЗначенияСвойств(ТекСтрока, СтрокаОстатков,, "Количество, Сумма");
		ТекСтрока.Цена = СтрокаОстатков.СтоимостьЕдиницы;
		
		Если ТипЗнч(СтрокаОстатков.ДопАналитика) = Тип("СправочникСсылка.Договоры") 
			И ЗначениеЗаполнено(СтрокаОстатков.ДопАналитика) Тогда
			ТекСтрока.Договор = СтрокаОстатков.ДопАналитика;
			ТекСтрока.Контрагент = СтрокаОстатков.Контрагент;
		ИначеЕсли ТипЗнч(СтрокаОстатков.ДопАналитика) = Тип("СправочникСсылка.Контрагенты") 
			И ЗначениеЗаполнено(СтрокаОстатков.ДопАналитика) Тогда
			ТекСтрока.Контрагент = СтрокаОстатков.ДопАналитика;
		КонецЕсли;		
		
		Если ТекСтрока.Количество = 0 ИЛИ ТекСтрока.Количество > СтрокаОстатков.Количество Тогда
			ТекСтрока.Количество = 1;
			ТекСтрока.Сумма = ТекСтрока.Цена;
		Иначе
			ТекСтрока.Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	НоваяСтрока = ТаблицаОС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	ЗаполнитьСтрокуТЧ(ТекущиеДанные, ТабОстатков);
	
КонецПроцедуры

