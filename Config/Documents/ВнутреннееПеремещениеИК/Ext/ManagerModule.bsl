#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует данные табличной части (ТЧ) документа для проверки остатков в функции ПолучитьОстаткиОСЗабаланс
// общего модуля БухгалтерскиеОперацииПовтИсп
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВнутреннееПеремещениеИК - документ, для которого собираем данные ТЧ
//
// Возвращаемое значение:
//  - ТаблицаЗначений - таблица, содержащая данные ТЧ 
Функция ДанныеТЧдляПроверкиОстатковЗабалансомВТО(ДокументСсылка) Экспорт
	ДоговорВТабличнойЧасти = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДоговорВТабличнойЧасти");
	
	Если ДоговорВТабличнойЧасти Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Сумма КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ВнутреннееПеремещениеИК.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьДоговоры,		
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьКонтрагенты
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.Ссылка В
		|		(ВЫБРАТЬ
		|			Таб.СчетУчета
		|		ИЗ
		|			ТабЧасть КАК Таб)
		|	И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|	ИЛИ ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУВидыСубконто.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть.НомерСтроки КАК НомерСтроки,
		|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
		|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТабЧасть.КПС КАК КПС,
		|	ТабЧасть.КФО КАК КФО,
		|	ТабЧасть.Количество КАК Количество,
		|	ТабЧасть.Сумма КАК Сумма,
		|	ТабЧасть.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьКонтрагенты
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьДоговоры
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Договор
		|	КОНЕЦ КАК Договор
		|ИЗ
		|	ТабЧасть КАК ТабЧасть
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
		|		ПО Счета.Ссылка = ТабЧасть.СчетУчета
		|";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Сумма КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.ВнутреннееПеремещениеИК.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
	"Организация,МоментВремени, Резервировать");
	
	Если ЗначенияРеквизитов.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям();
	
	// Получим дату проведения документа              
	Отбор = Новый Структура("Документ", ДокументСсылка);
	ВыборкаДатыПроведения = РегистрыСведений.ДатыПроведенияДокументов.Выбрать(Отбор);
	ДатаПолученияДанных = ЗначенияРеквизитов.МоментВремени;
	Если ВыборкаДатыПроведения.Следующий() И ЗначениеЗаполнено(ВыборкаДатыПроведения.ДатаПроведения) Тогда
		ДатаПолученияДанных = ВыборкаДатыПроведения.ДатаПроведения;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Период"				, ДатаПолученияДанных);
	Запрос.УстановитьПараметр("ИмяДокумента"		, ДокументСсылка.Метаданные().Представление());
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПоПодразделениям);
	Запрос.УстановитьПараметр("Счета90"				, БухгалтерскийУчет.СписокСчетов("108.90"));
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА Таблица.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	Таблица.Ссылка.Организация КАК Организация,
	|	Таблица.Ссылка.ВидОперации КАК ВидОперации,
	|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Таблица.Ссылка.ЦМООтправитель КАК ЦМООтправитель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА Таблица.Ссылка.ПодразделениеОтправитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеОтправитель,
	|	Таблица.Ссылка.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА Таблица.Ссылка.ПодразделениеПолучатель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеПолучатель,
	|	Таблица.Сумма КАК Стоимость,
	|	Таблица.Количество КАК Количество,
	|	Таблица.СчетУчета КАК СчетУчета,
	|	Таблица.СчетУчетаНовый КАК СчетУчетаНовый,
	|	Таблица.Договор КАК Договор,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	Таблица.Ссылка.Номер КАК НомерДокумента,
	|	Таблица.Ссылка.Дата КАК ДатаДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение) КАК Событие,
	|	ВЫБОР
	|		КОГДА Таблица.Ссылка.ВидОперации 
	|			= ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|		КОГДА Таблица.Ссылка.ВидОперации 
	|			= ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) 
	|	КОНЕЦ КАК ВидРаспоряжения,
	|	Таблица.Ссылка.ДоговорВТабличнойЧасти КАК ДоговорВТабличнойЧасти,
	|	Таблица.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Документ.ВнутреннееПеремещениеИК.ОсновныеСредства КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = Таблица.Ссылка)
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ВТ_Данные КАК ВТ_Данные)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Период КАК Период,
	|	ВТ_Данные.Организация КАК Организация,
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Данные.ЦМООтправитель КАК ЦМООтправитель,
	|	ВТ_Данные.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	ВТ_Данные.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ВТ_Данные.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	|	ВТ_Остатки.Договор КАК ДоговорОтправитель,
	|	ВТ_Остатки.Договор КАК ДоговорПолучатель,
	|	ВТ_Данные.Стоимость КАК Стоимость,
	|	ВТ_Данные.Количество КАК Количество,
	|	ВТ_Данные.НазваниеДокумента КАК НазваниеДокумента,
	|	ВТ_Данные.НомерДокумента КАК НомерДокумента,
	|	ВТ_Данные.ДатаДокумента КАК ДатаДокумента,
	|	ВТ_Данные.Событие КАК Событие,
	|	ВТ_Данные.ВидРаспоряжения КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Данные.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ВТ_Данные.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|ГДЕ
	|	ВТ_Данные.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС)
	|	И (ВТ_Данные.ЦМООтправитель <> ВТ_Данные.ЦМОПолучатель
	|			ИЛИ ВТ_Данные.ПодразделениеОтправитель <> ВТ_Данные.ПодразделениеПолучатель
	|				И &УчетПоПодразделениям)
	|	И (ВТ_Данные.Стоимость <> 0
	|			ИЛИ ВТ_Данные.Количество <> 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Данные.Период,
	|	ВТ_Данные.Организация,
	|	ВТ_Данные.ОсновноеСредство,
	|	ВТ_Остатки.ИнвентарныйНомер,
	|	ВТ_Данные.ЦМООтправитель,
	|	ВТ_Данные.ПодразделениеОтправитель,
	|	ВТ_Данные.ЦМОПолучатель,
	|	ВТ_Данные.ПодразделениеПолучатель,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.СчетУчета В (&Счета90)
	|			ТОГДА ВТ_Остатки.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.СчетУчетаНовый В (&Счета90)
	|			ТОГДА ВТ_Данные.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВТ_Остатки.СтоимостьОстаток,
	|	ВТ_Остатки.КоличествоОстаток,
	|	ВТ_Данные.НазваниеДокумента,
	|	ВТ_Данные.НомерДокумента,
	|	ВТ_Данные.ДатаДокумента,
	|	ВТ_Данные.Событие,
	|	ВТ_Данные.ВидРаспоряжения
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Данные.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|ГДЕ
