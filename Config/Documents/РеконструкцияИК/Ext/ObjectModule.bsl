#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если НЕ БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Дата).ВедениеАналитическогоУчетаИмуществаКазны Тогда
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.ИнвентарныйНомер");
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		НеПроверяемыеРеквизиты.Добавить("ВнеоборотныйАктив");
		НеПроверяемыеРеквизиты.Добавить("СчетКредита");
		НеПроверяемыеРеквизиты.Добавить("СуммаДокумента");
	КонецЕсли;
	
	// Уберем проверку заполненности карточки капвложений из стандартной проверки. Проверим сами
	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС);
	Если ОперацииСоСчетом106.Найти(ЭтотОбъект.ВидОперации) = Неопределено ИЛИ НЕ ЭтотОбъект.ОтразитьВКарточкеКапвложений Тогда
		НепроверяемыеРеквизиты.Добавить("КарточкаКапвложений");
	КонецЕсли;		
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	// Суммы в табличной части равны сумме капитальных вложений.
	СуммаМодернизацииРемонта = СуммаДокумента - (СуммаДемонтажа + СуммаТранспортировки);
	Если ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		
		Если ОсновныеСредства.Итог("СуммаРемонта") <> СуммаМодернизацииРемонта Тогда
			ТекстОшибки = НСтр("ru='Стоимость работ по ремонту не совпадает в итоговой стоимостью работ по ремонту табличной части.
				|В табличной части: %1; стоимость ремонта: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОсновныеСредства.Итог("СуммаРемонта"),
				СуммаМодернизацииРемонта);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "СуммаРемонта", , Отказ);
		КонецЕсли;
		
	Иначе
		
		Если ОсновныеСредства.Итог("СуммаМодернизации") <> СуммаМодернизацииРемонта Тогда
			ТекстОшибки = НСтр("ru='Стоимость работ по модернизации не совпадает в итоговой стоимостью работ по модернизации табличной части.
				|В табличной части: %1; стоимость модернизации: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОсновныеСредства.Итог("СуммаМодернизации"),
				СуммаМодернизацииРемонта);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "СуммаМодернизации", , Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОсновныеСредства.Итог("СуммаДемонтажа") <> ЭтотОбъект.СуммаДемонтажа Тогда
		ТекстОшибки = НСтр("ru='Стоимость работ по демонтажу не совпадает в итоговой стоимостью работ по демонтажу табличной части.
			|В табличной части: %1; затраты на демонтаж: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОсновныеСредства.Итог("СуммаДемонтажа"),
			ЭтотОбъект.СуммаДемонтажа);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "СуммаДемонтажа", "Объект", Отказ);
	КонецЕсли;
	
	Если ОсновныеСредства.Итог("СуммаТранспортировки") <> ЭтотОбъект.СуммаТранспортировки Тогда
		ТекстОшибки = НСтр("ru='Стоимость работ по транспортировке не совпадает в итоговой стоимостью работ по транспортировке табличной части.
			|В табличной части: %1; затраты по транспортировке: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОсновныеСредства.Итог("СуммаТранспортировки"),
			ЭтотОбъект.СуммаТранспортировки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "СуммаТранспортировки", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
		ЗаполнитьНаОсновании_РешениеОПризнанииОбъектовОСИК(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапроса_По_РешениеОПризнанииОбъектовОСИК()
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокШапка.Организация КАК Организация,
	|	ДокШапка.ИФО КАК ИФО,
	|	ДокШапка.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеконструкцияОС.МодернизацияОС) КАК ВидОперации,
	|	ДокШапка.КапитальноеВложение КАК ВнеоборотныйАктив,
	|	ДокШапка.СчетВложений КАК СчетКредита,
	|	ДокШапка.КФО КАК КФО,
	|	ДокШапка.СуммаВложений КАК СуммаДокумента
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК КАК ДокШапка
	|ГДЕ
	|	ДокШапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧКапитальныеВложения.ЦМО КАК ЦМО,
	|	ТЧКапитальныеВложения.Договор КАК Договор,
	|	ТЧКапитальныеВложения.КПС КАК КПС,
	|	ТЧКапитальныеВложения.Сумма КАК Сумма
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.КапитальныеВложения КАК ТЧКапитальныеВложения
	|ГДЕ
	|	ТЧКапитальныеВложения.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТЧОсновныеСредства.СрокПолезногоИспользования КАК СрокПолезногоИспользованияПослеМодернизации,
	|	ТЧОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧОсновныеСредства.Ссылка.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧСведенияОВидахРабот.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧСведенияОВидахРабот.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧСведенияОВидахРабот.ВидРаботы КАК ВидРаботы,
	|	ТЧСведенияОВидахРабот.СуммаДемонтажа КАК СуммаДемонтажа,
	|	ТЧСведенияОВидахРабот.СуммаТранспортировки КАК СуммаТранспортировки,
	|	ТЧСведенияОВидахРабот.СуммаРемонта КАК СуммаРемонта,
	|	ТЧСведенияОВидахРабот.СуммаМодернизации КАК СуммаМодернизации,
	|	ТЧСведенияОВидахРабот.СтоимостьПоОкончанииРабот КАК СтоимостьПоОкончанииРабот
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.СведенияОВидахРабот КАК ТЧСведенияОВидахРабот
	|ГДЕ
	|	ТЧСведенияОВидахРабот.Ссылка = &Ссылка";

	Возврат ТекстЗапроса;
КонецФункции	

Процедура ЗаполнитьНаОсновании_РешениеОПризнанииОбъектовОСИК(ДанныеЗаполнения)     
	КапитальныеВложения.Очистить();
	ОсновныеСредства.Очистить();
	
	Запрос = Новый Запрос(ТекстЗапроса_По_РешениеОПризнанииОбъектовОСИК());
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка    = Результат[0].Выбрать();
	ВыборкаВложения = Результат[1].Выбрать();
	ВыборкаОС       = Результат[2].Выбрать();
	ВыборкаРаботы   = Результат[3].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		ДокументОснование = ДанныеЗаполнения;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
		
		Пока ВыборкаВложения.Следующий() Цикл
			СтрокаВложения = КапитальныеВложения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВложения, ВыборкаВложения);
		КонецЦикла;	     
		
		ПерваяСтрока = Истина;
		ПоискРабот = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
		Пока ВыборкаОС.Следующий() Цикл
			Если ПерваяСтрока И ОсновныеСредства.Количество() > 0 Тогда
				СтрокаОС = ОсновныеСредства[0];
			Иначе	
				СтрокаОС = ОсновныеСредства.Добавить();
			КонецЕсли;	
			ПерваяСтрока = Ложь;
			ЗаполнитьЗначенияСвойств(СтрокаОС, ВыборкаОС);              
			
			ВидРаботы_П                 = "";
			СуммаДемонтажа_П            = 0;
			СуммаТранспортировки_П      = 0;
			СуммаРемонта_П              = 0;
			СуммаМодернизации_П         = 0;
			СтоимостьПоОкончанииРабот_П = 0;
			
			ЗаполнитьЗначенияСвойств(ПоискРабот, СтрокаОС);
			Пока ВыборкаРаботы.НайтиСледующий(ПоискРабот) Цикл
				ВидРаботы_П = ВидРаботы_П + ?(ЗначениеЗаполнено(ВидРаботы_П), "; ", "") + ВыборкаРаботы.ВидРаботы;
				СуммаДемонтажа_П            = СуммаДемонтажа_П + ВыборкаРаботы.СуммаДемонтажа;
				СуммаТранспортировки_П      = СуммаТранспортировки_П + ВыборкаРаботы.СуммаТранспортировки;
				СуммаРемонта_П              = СуммаРемонта_П + ВыборкаРаботы.СуммаРемонта;
				СуммаМодернизации_П         = СуммаМодернизации_П + ВыборкаРаботы.СуммаМодернизации;
				СтоимостьПоОкончанииРабот_П = СтоимостьПоОкончанииРабот_П + ВыборкаРаботы.СтоимостьПоОкончанииРабот;
			КонецЦикла;	             
			СтрокаОС.ВидРаботы = ВидРаботы_П;
			СтрокаОС.СуммаДемонтажа            = СуммаДемонтажа_П;
			СтрокаОС.СуммаТранспортировки      = СуммаТранспортировки_П;
			СтрокаОС.СуммаРемонта              = СуммаРемонта_П;
			СтрокаОС.СуммаМодернизации         = СуммаМодернизации_П;
			СтрокаОС.СтоимостьПоОкончанииРабот = СтоимостьПоОкончанииРабот_П;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли
