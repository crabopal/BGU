#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС);
	Если ОперацииСоСчетом106.Найти(ДокументОбъект.ВидОперации) = Неопределено 
		ИЛИ НЕ ДокументОбъект.ОтразитьВКарточкеКапвложений Тогда
		Возврат Истина;	
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Стоимость вложений"" включен флажок 
		|""Отразить в:"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;	
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДокументОбъект.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;

	Возврат Истина;
КонецФункции	

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Реквизиты = Новый Структура("МоментВремени,Дата,Номер,Организация,ВидОперации,ТолькоРегистрацияАкта");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
	
	Если ЗначенияРеквизитов.ТолькоРегистрацияАкта Тогда
		// Очистим старые движения документа. Автоматически они не удаляются.  
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Для каждого НаборЗаписей из ДокументОбъект.Движения Цикл
			ИмяРегистра = НаборЗаписей.Метаданные().Имя;
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяРегистра, НаборЗаписей.ВыгрузитьКолонки());
		КонецЦикла;	
		
		Возврат;
	КонецЕсли;	
	
	НомерДокументаПоНастройке = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер);
	
	УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата);
	НачислятьАмортизацию = УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяФормыДокумента"	, НСтр("ru = 'Акт приема-сдачи отремонтированных, реконструированных и модернизированных объектов основных средств'"));
	Запрос.УстановитьПараметр("НомерДокумента"		, НомерДокументаПоНастройке);
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("МоментВремени"		, Новый Граница(ЗначенияРеквизитов.МоментВремени, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям());
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ДанныеДокумента", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаИК.Ссылка.Дата КАК Период,
	|	ТаблицаИК.Ссылка.Организация КАК Организация,
	|	ТаблицаИК.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаИК.Ссылка.ВидОперации КАК ВидОперации,
	|	ТаблицаИК.Ссылка.НаименованиеГарантийногоТалона КАК НаименованиеГТ,
	|	ТаблицаИК.Ссылка.НомерГарантийногоТалона КАК НомерГТ,
	|	ТаблицаИК.Ссылка.ДатаГарантийногоТалона КАК ДатаГТ,
	|	ТаблицаИК.Ссылка.СрокДействияГарантийногоТалона КАК СрокДействияГТ,
	|	ТаблицаИК.Ссылка.Договор КАК ДоговорИсполнителя,
	|	ТаблицаИК.ВидРаботы КАК ВидРаботы,
	|	ТаблицаИК.СчетУчета КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ТаблицаИК.Ссылка.ВидПервичногоДокумента = """"
	|			ТОГДА &ИмяФормыДокумента
	|		ИНАЧЕ ТаблицаИК.Ссылка.ВидПервичногоДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаИК.Ссылка.НомерПервичногоДокумента = """"
	|			ТОГДА &НомерДокумента
	|		ИНАЧЕ ТаблицаИК.Ссылка.НомерПервичногоДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаИК.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ТаблицаИК.Ссылка.Дата
	|		ИНАЧЕ ТаблицаИК.Ссылка.ДатаПервичногоДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ТаблицаИК.НомерСтроки КАК НомерСтроки,
	|	ТаблицаИК.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаИК.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаИК.ЦМО КАК ЦМО,
	|	ТаблицаИК.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
	|	ТаблицаИК.СрокЭксплуатацииФакт КАК СрокЭксплуатацииФакт,
	|	ТаблицаИК.СрокПолезногоИспользованияПослеМодернизации КАК СрокПолезногоИспользованияПослеМодернизации,
	|	ТаблицаИК.СуммаМодернизации + ТаблицаИК.СуммаДемонтажа + ТаблицаИК.СуммаТранспортировки КАК СуммаМодернизации,
	|	ТаблицаИК.СуммаРемонта + ТаблицаИК.СуммаДемонтажа + ТаблицаИК.СуммаТранспортировки КАК СуммаРемонта
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.РеконструкцияИК.ОсновныеСредства КАК ТаблицаИК
	|ГДЕ
	|	ТаблицаИК.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("ОстаткиРН_СтоимостьОбъектовОС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СтоимостьОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(СтоимостьОбъектовОСОстатки.Договор) КАК Договор
	|ПОМЕСТИТЬ ОстаткиРН_СтоимостьОбъектовОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&МоментВремени, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ДанныеДокумента КАК Таб)
	|	И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ДанныеДокумента.Период КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеДокумента.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ДанныеДокумента.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ДанныеДокумента.СуммаМодернизации КАК Стоимость,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция) КАК Событие,
	|	ДанныеДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ДанныеДокумента.НомерДокумента КАК НомерДокумента,
	|	ДанныеДокумента.ДатаДокумента КАК ДатаДокумента,
	|	ДанныеДокумента.ДоговорИсполнителя КАК ДоговорИсполнителя,
	|	ДанныеДокумента.ВидРаботы КАК ВидРаботы,
	|	ВЫБОР
	|		КОГДА НЕ СубконтоДоговоры.Ссылка ЕСТЬ NULL
	|		И НЕ ОстаткиРН_СтоимостьОбъектовОС.Договор ЕСТЬ NULL
	|			ТОГДА ОстаткиРН_СтоимостьОбъектовОС.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРН_СтоимостьОбъектовОС КАК ОстаткиРН_СтоимостьОбъектовОС
	|		ПО ДанныеДокумента.ОсновноеСредство = ОстаткиРН_СтоимостьОбъектовОС.ОсновноеСредство
	|		И ДанныеДокумента.ИнвентарныйНомер = ОстаткиРН_СтоимостьОбъектовОС.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК СубконтоДоговоры
	|		ПО ДанныеДокумента.СчетУчета = СубконтоДоговоры.Ссылка
	|		И СубконтоДоговоры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|ГДЕ
	|	ДанныеДокумента.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС)
	|	И ДанныеДокумента.СуммаМодернизации <> 0";
	
	Если НачислятьАмортизацию И Реквизиты.ВидОперации <> Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		
		НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости,
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации
		|ПОМЕСТИТЬ ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
		|ИЗ
		|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ОСДокумента.ОсновноеСредство
		|					ИЗ
		|						ДанныеДокумента КАК ОСДокумента)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство";
		
		НомераТаблиц.Вставить("РасчетАмортизацииОС", НомераТаблиц.Количество());
		// группировка в запросе, на случай, если моедрнизируются ОС с групповым инвентарным учетом,
		// тогда в ДанныеДокумента будет столько строк, сколько инвентарных номеров, но в регистре "РасчетАмортизацииОС"
		// данные хранятся для объекта в целом, без инвентарных номеров.
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ДанныеДокумента.Период КАК Период,
		|	ДанныеДокумента.Организация КАК Организация,
		|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
		|	МАКСИМУМ(ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации) КАК СрокПолезногоИспользования,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации > ДанныеДокумента.СрокЭксплуатацииФакт
		|				ТОГДА ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации - ДанныеДокумента.СрокЭксплуатацииФакт
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК СрокИспользованияДляВычисленияАмортизации,
		|	МАКСИМУМ(ДанныеДокумента.ОстаточнаяСтоимость + ДанныеДокумента.СуммаМодернизации) КАК СтоимостьДляВычисленияАмортизации
		|ИЗ
		|	ДанныеДокумента КАК ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
		|		ПО ДанныеДокумента.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
		|ГДЕ
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
		|	И ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеДокумента.Период,
		|	ДанныеДокумента.Организация,
		|	ДанныеДокумента.ОсновноеСредство";
		
	КонецЕсли;
	
	НомераТаблиц.Вставить("КапРемонтОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ДанныеДокумента.Период КАК Период,
	|	ДанныеДокумента.ОсновноеСредство КАК ОС,
	|	ДанныеДокумента.ИнвентарныйНомер КАК ИнвНомер,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.СуммаРемонта КАК СуммаНаКапРемонт,
	|	ДанныеДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ДанныеДокумента.НомерДокумента КАК НомерДокумента,
	|	ДанныеДокумента.ДатаДокумента КАК ДатаДокумента,
	|	ДанныеДокумента.НаименованиеГТ КАК НаименованиеГТ,
	|	ДанныеДокумента.НомерГТ КАК НомерГТ,
	|	ДанныеДокумента.ДатаГТ КАК ДатаГТ,
	|	ДанныеДокумента.СрокДействияГТ КАК СрокДействияГТ,
	|	ДанныеДокумента.ДоговорИсполнителя КАК ДоговорИсполнителя,
	|	ДанныеДокумента.ВидРаботы КАК ВидРаботы
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

