Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперации()
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОпределитьНаличиеДоговораВложения()
	
	Элементы.КапитальныеВложенияДоговор.Видимость = ?(ЗначениеЗаполнено(Объект.СчетКредита),
		БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетКредита, ПланыВидовХарактеристик.ВидыСубконто.Договоры),
		Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаОснованииНаСервере()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ДокументОбъект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтразитьВКарточкеКапвложений(Форма)
	ЭтоКапвложение = ЭтоОперацияКапвложения(Форма.Объект.ВидОперации) И НЕ Форма.Объект.ТолькоРегистрацияАкта;
	Если НЕ ЭтоКапвложение И Форма.Объект.ОтразитьВКарточкеКапвложений Тогда
		Форма.Объект.ОтразитьВКарточкеКапвложений = Ложь;
	ИначеЕсли ЭтоКапвложение И НЕ Форма.Объект.ОтразитьВКарточкеКапвложений Тогда
		Форма.Объект.ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма);
КонецПроцедуры	

&НаСервере
Процедура ПослеВводаНаОснованииНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;	
	//ВидОперацииПриИзмененииНаСервере();
	УстановитьОтразитьВКарточкеКапвложений(ЭтотОбъект);
	РассчитатьСуммуВложенийНаСервере(Ложь);
	
	// Отработаем изменение основного средства
	Если НЕ РежимФормыСписокОбъектов Тогда
		ТекущаяСтрока = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ТекущаяСтрока.ОсновноеСредство = ОсновноеСредство;
		// Обработаем изменение основного средства в строке табличной части.
		ОсновноеСредствоПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
		// Обновим реквизиты на форме из строки табличной части.
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтотОбъект, Объект);
	КонецЕсли;
КонецПроцедуры	

// Обработчик выбора строки постоянно действующией комиссии. 
// См. ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии
// "Объект" передается явно, без этого данные объекта не заполняются в web-клиенте.
// 
// Параметры:
//  Результат - см. ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент.Результат
//  ДопПараметры - см. ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент.ДопПараметры
&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;	
	
	Объект.Комиссия = Результат;
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект);	
	УстановитьДоступностьРеквизитовКомиссии(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеЧленаКомиссии(ОбъектЗаполнения, ЧленКомиссии, ТипЧленаКомиссии = "ЧленКомиссии")
	СтруктураИменРеквизитов = Новый Структура();
	Если ТипЧленаКомиссии = "Председатель" Тогда
		СтруктураИменРеквизитов.Вставить("Должность", "ДолжностьПредседателяКомиссии");
		СтруктураИменРеквизитов.Вставить("Фамилия", "ФамилияПредседателяКомиссии");
		СтруктураИменРеквизитов.Вставить("Имя", "ИмяПредседателяКомиссии");
		СтруктураИменРеквизитов.Вставить("Отчество", "ОтчествоПредседателяКомиссии");
	Иначе	
		СтруктураИменРеквизитов.Вставить("Должность", "ДолжностьЧленаКомиссии");
		СтруктураИменРеквизитов.Вставить("Фамилия", "ФамилияЧленаКомиссии");
		СтруктураИменРеквизитов.Вставить("Имя", "ИмяЧленаКомиссии");
		СтруктураИменРеквизитов.Вставить("Отчество", "ОтчествоЧленаКомиссии");
	КонецЕсли;	
	
	ДанныеСотрудника = ДанныеСотрудника(ЧленКомиссии, Объект.Дата);
	ОбъектЗаполнения[СтруктураИменРеквизитов.Должность] = ДанныеСотрудника.Должность;
	ОбъектЗаполнения[СтруктураИменРеквизитов.Фамилия]   = ДанныеСотрудника.Фамилия;
	ОбъектЗаполнения[СтруктураИменРеквизитов.Имя]       = ДанныеСотрудника.Имя;
	ОбъектЗаполнения[СтруктураИменРеквизитов.Отчество]  = ДанныеСотрудника.Отчество;
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ДанныеСотрудника(Сотрудник, Дата)
	Возврат Справочники.Сотрудники.ДанныеСотрудника(Сотрудник, "Должность, Фамилия, Имя, Отчество", Дата);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитовКомиссии(Форма)
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ДолжностьПредседателяКомиссии");
	ТекЭлементы.Добавить("ГруппаФИОПредседателя");
	ТекЭлементы.Добавить("СоставКомиссииДолжностьЧленаКомиссии");
	ТекЭлементы.Добавить("СоставКомиссииФамилияЧленаКомиссии");
	ТекЭлементы.Добавить("СоставКомиссииИмяЧленаКомиссии");
	ТекЭлементы.Добавить("СоставКомиссииОтчествоЧленаКомиссии");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ТекЭлементы, "Доступность", НЕ ЗначениеЗаполнено(Форма.Объект.Комиссия));
КонецПроцедуры	

