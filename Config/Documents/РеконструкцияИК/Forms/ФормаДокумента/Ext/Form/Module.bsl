
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
		//ЗаполнитьКФО_гКБК(ЭтотОбъект);
		Если ЗначениеЗаполнено(Параметры.Основание) Тогда
			ПослеВводаНаОснованииНаСервере();
		Иначе	
			ЗаполнитьКФО_гКБК(ЭтотОбъект);
		КонецЕсли;	
	
		Если Не ЗначениеЗаполнено(Объект.Руководитель) Тогда
			Подписанты = Новый Структура;
			Подписанты.Вставить("Руководитель", 
				ЗаполнениеРеквизитовОбъектов.СтруктураПодписанта("Руководитель", Объект.Подразделение));
			ЗаполнениеРеквизитовОбъектов.ЗаполнитьПодписантов(Объект, Подписанты);
		КонецЕсли;
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// СтандартныеПодсистемы.УчетОригиналовПервчиныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервчиныхДокументов 
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(ЭтотОбъект);
	УстановитьДоступностьРеквизитовКомиссии(ЭтотОбъект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДоступностьСвязанныхРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	УстановитьВидимостьЭлементовЗаполненияЗатрат();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(ЭтаФорма, Объект);
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	Оповестить("ДокументыПоУчетуОСИзменение");
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	Если РежимФормыСписокОбъектов Тогда
		ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
	КонецЕсли;
	
	РассчитатьОставшиесяСрокиИспользования(ЭтотОбъект);
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "Справочник.ПостоянноДействующиеКомиссии.Форма.ФормаВыбора" Тогда
		УправлениеОсновнымиСредствамиКлиент.УстановитьКомиссиюВДокументОС(ВыбранноеЗначение,
			Объект, ЭтаФорма, Объект.НомерПриказа, Объект.ДатаПриказа);
	ИначеЕсли Лев(ИсточникВыбора.ИмяФормы, 22) = "Справочник.Сотрудники." Тогда 
		УправлениеОсновнымиСредствамиКлиент.ОбработатьВыборПредседателяКомиссии(ЭтаФорма,
			ВыбранноеЗначение, Ложь,
			Объект.ДолжностьПредседателяКомиссии,
			Объект.ФамилияПредседателяКомиссии,
			Объект.ИмяПредседателяКомиссии,
			Объект.ОтчествоПредседателяКомиссии);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииТиповойОперации(Элемент)
	
	ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

	БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтаФорма, Команда);	

КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	ЗаполнитьНаОснованииНаСервере();

	РежимФормыСписокОбъектов = ?(Объект.ОсновныеСредства.Количество() > 1, 1, 0);
	ПриИзмененииРежимаФормыСписокОбъектов();
	
	ВидОперацииПриИзмененииНаКлиенте();
	РассчитатьСуммуВложенийНаСервере(Ложь);

	Если РежимФормыСписокОбъектов Тогда
		Для каждого СтрокаОС из Объект.ОсновныеСредства Цикл
			ОсновноеСредствоПриИзмененииНаСервере(СтрокаОС.ПолучитьИдентификатор());
		КонецЦикла;	
	Иначе	
		ОсновноеСредствоПриИзмененииНаКлиенте();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
		ЗаполнитьКФО_гКБК(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ДоступностьСвязанныхРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьКФО_гКБК(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьКФО_гКБК(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	ВидОперацииПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзмененииНаКлиенте()
	ВидОперацииПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	УстановитьОтразитьВКарточкеКапвложений(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	
//	ОтражатьВНалоговомУчете =
//		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеМодернизацию(Объект);
//	ОтражатьВУСНДоходыМинусРасходы =
//		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыМодернизацию(Объект);
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если РежимФормыСписокОбъектов И Объект.ВидОперации <> Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
			Объект.ОсновныеСредства.Очистить();
		Иначе
			Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
				ГрупповойУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство,"ГрупповойУчет");
				Если ГрупповойУчет И Объект.ВидОперации <> Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
					Объект.ОсновныеСредства.Очистить(); // Групповые ОС нельзя модернизировать.
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		
		// При кап.ремонте срок полезного использования не изменяется.
		ДатаСреза = ПериодПолученияОстатков(Объект);
		Для Каждого СтрокаОС Из Объект.ОсновныеСредства Цикл
			
			СведенияОбОС = УправлениеОсновнымиСредствами.ПолучитьСведенияОбОС(ДатаСреза, СтрокаОС.ОсновноеСредство,
				"СрокПолезногоИспользования,СрокПолезногоИспользованияНУ");
			
			СтрокаОС.СрокПолезногоИспользованияПослеМодернизации   = СведенияОбОС.СрокПолезногоИспользования;
			
			СтрокаОС.ОставшийсяСрок   = РассчитатьОставшийсяСрокПолезногоИспользования(
				СтрокаОС.СрокПолезногоИспользованияПослеМодернизации, СтрокаОС.СрокЭксплуатацииФакт);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьИОтборыКапВложения();
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	ОбнулитьСуммы();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимФормыСписокОбъектовПриИзменении(Элемент)
	
	Если НЕ РежимФормыСписокОбъектов И Объект.ОсновныеСредства.Количество() > 1 Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросОчиститьТабЧастьОсновныеСредстваЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, Нстр("ru='Список объектов ОС, НМА будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ПриИзмененииРежимаФормыСписокОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьТабЧастьОсновныеСредстваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПриИзмененииРежимаФормыСписокОбъектов();
	Иначе // Нет
		РежимФормыСписокОбъектов = 1; // Вернем прежнее значение режима формы.
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРежимаФормыСписокОбъектов()
	
	Если НЕ РежимФормыСписокОбъектов Тогда
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект)
	КонецЕсли;
	
	УстановитьВидимостьЗакладок(ЭтотОбъект);
	УстановитьВидимостьЭлементовЗаполненияЗатрат();
	
	РассчитатьОставшиесяСрокиИспользования(ЭтотОбъект);
	
	Если РежимФормыСписокОбъектов Тогда
		
		//Если ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда 
		//	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОсновныеСредства;
		//КонецЕсли;
		
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
		
		ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

// Страница "Стоимость вложений"

&НаКлиенте
Процедура ВнеоборотныйАктивПриИзменении(Элемент)
	
	ОбнулитьСуммы();
	
	ВнеоборотныйАктивПриИзмененииНаСервере();
	
	// В процедуре ВнеоборотныйАктивПриИзмененииНаСервере мог быть установлен
	// упрощенный режим формы (один объект ОС, НМА). Обновим форму.
	Если Не РежимФормыСписокОбъектов Тогда
		ПриИзмененииРежимаФормыСписокОбъектов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВнеоборотныйАктивПриИзмененииНаСервере()
	
	ДанныеОбъектаВложений = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.ВнеоборотныйАктив, Объект.Ссылка);
	Объект.СчетКредита = ДанныеОбъектаВложений.СчетВложений;
	
	ОбъектВложений_ВидНФА = ДанныеОбъектаВложений.ВидНФА;
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма) Тогда
		РассчитатьСуммуВложенийНаСервере();
	КонецЕсли;
	
	Если ОбъектВложений_ВидНФА = Перечисления.ВидыНФА.ОС
		ИЛИ ОбъектВложений_ВидНФА = Перечисления.ВидыНФА.НМА Тогда
		
		// Если для учета суммы вложений используется не отдельный объект кап.вложений, а сам объект ОС (НМА),
		// то нужно просто перенести сумму модернизации со счета вложений (106) на счет учета (101, 102).
		// Поскольку модернизация групповых ОС не поддерживается, в таб. части "Основные средства"
		// может быть только одна строка.
		ПерваяСтрокаТаблицыОС = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ПерваяСтрокаТаблицыОС.ОсновноеСредство = Объект.ВнеоборотныйАктив;
		ОсновноеСредствоПриИзмененииНаСервере(ПерваяСтрокаТаблицыОС.ПолучитьИдентификатор());
		
		РежимФормыСписокОбъектов = 0; // Установим упрощенный режим формы - один объект ОС, НМА.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКредитаПриИзменении(Элемент)
	
	ОбнулитьСуммы();
	
	ОпределитьНаличиеДоговораВложения();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКредитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КодыСчетов = "";
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.МодернизацияНМА") Тогда
		КодыСчетов = ?(Объект.Дата < '20210101', "106.22,106.32,106.42", "106.54,106.9I");
	Иначе
		КодыСчетов = ?(Объект.Дата < '20210101', "106.11,106.КС,106.21,106.31,106.41", "106.51,106.52,106.91,106.92");
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.СчетКредита);
	Если ЗначениеЗаполнено(КодыСчетов) Тогда
		ПараметрыФормы.Вставить("ОграниченияСписокСчетов", СтрРазделить(КодыСчетов, ","));
	КонецЕсли;
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ОсновноеСредство = ВыбранноеЗначение Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	ОсновноеСредствоПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерПриИзменении(Элемент)
	
	Если НЕ РежимФормыСписокОбъектов Тогда
		
		// Установим новый ИнвентарныйНомер в первой строке табличной части.
		ТекущаяСтрока = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ТекущаяСтрока.ИнвентарныйНомер = ИнвентарныйНомер;
		
		// Обработаем изменение основного средства в строке табличной части.
		ОсновноеСредствоПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
		
		// Обновим реквизиты на форме из строки табличной части.
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидРаботыПриИзменении(Элемент)
	
	Если НЕ РежимФормыСписокОбъектов Тогда
		
		// Установим новый ВидРаботы в первой строке табличной части.
		ТекущаяСтрока = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ТекущаяСтрока.ВидРаботы = ВидРаботы;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СрокПолезногоИспользованияПослеМодернизацииПриИзменении(Элемент)
	
	Если НЕ РежимФормыСписокОбъектов Тогда
		
		// Установим новый СрокПолезногоИспользованияПослеМодернизации в первой строке табличной части.
		ТекущаяСтрока = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ТекущаяСтрока.СрокПолезногоИспользованияПослеМодернизации = СрокПолезногоИспользованияПослеМодернизации;
		
		// Рассчитаем ОставшийсяСрок в первой строке табличной части.
		ТекущаяСтрока.ОставшийсяСрок = РассчитатьОставшийсяСрокПолезногоИспользования(
			ТекущаяСтрока.СрокПолезногоИспользованияПослеМодернизации, ТекущаяСтрока.СрокЭксплуатацииФакт);
		
		// Обновим реквизиты на форме из строки табличной части.
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
		СрокПолезногоИспользованияПослеМодернизацииОставшийся = ТекущаяСтрока.ОставшийсяСрок;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаВложенийВРемонтПриИзменении(Элемент)
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	
	Если РежимФормыСписокОбъектов Тогда
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	Иначе
		ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(ЭтаФорма, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДемонтажаПриИзменении(Элемент)
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	
	Если РежимФормыСписокОбъектов Тогда
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	Иначе
		ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(ЭтаФорма, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаТранспортировкиПриИзменении(Элемент)
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	
	Если РежимФормыСписокОбъектов Тогда
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	Иначе
		ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(ЭтаФорма, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора", Неопределено, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтразитьВКарточкеКапвложенийПриИзменении(Элемент)
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(ЭтотОбъект);
КонецПроцедуры

// страница "Акт"

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	УстановитьДоступностьДоговора();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	ДатаНачалаРаботПоДоговору = Объект.Договор.ДатаДоговора;
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		СрокиПоДоговорам = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(Объект.Договор, Объект.Дата);
		СрокиПоДоговору = СрокиПоДоговорам.Найти(Объект.Договор, "Договор");
		ДатаОкончанияРаботПоДоговору = ?(СрокиПоДоговору = Неопределено, Дата(1,1,1), СрокиПоДоговору.ОкончаниеДействия);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		СвойстваОбъекта = УправлениеСвойствами.ЗначенияСвойств(Объект.Договор, Истина, Ложь);
		СтруктураДатаОкончанияДоговора = СвойстваОбъекта.Найти(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора, "Свойство");
		ДатаОкончанияРаботПоДоговору = ?(СтруктураДатаОкончанияДоговора = Неопределено, "", СтруктураДатаОкончанияДоговора.Значение);
	КонецЕсли;
	
	Если Объект.ДатаНачалаРаботПоДоговору = Дата(1,1,1) Тогда
		Объект.ДатаНачалаРаботПоДоговору = ДатаНачалаРаботПоДоговору;
	КонецЕсли;
	Если Объект.ДатаОкончанияРаботПоДоговору = Дата(1,1,1) Тогда
		Объект.ДатаОкончанияРаботПоДоговору = ДатаОкончанияРаботПоДоговору;
	КонецЕсли;
	
	Если Объект.ДатаНачала = Дата(1,1,1) Тогда
		Объект.ДатаНачала =  ДатаНачалаРаботПоДоговору;
	КонецЕсли;
	Если Объект.ДатаОкончания = Дата(1,1,1) Тогда
		Объект.ДатаОкончания = ДатаОкончанияРаботПоДоговору;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НаименованиеГарантийногоТалонаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
