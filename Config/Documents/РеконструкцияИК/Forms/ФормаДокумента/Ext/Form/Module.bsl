// Капитальные вложения

&НаКлиенте
Процедура РассчитатьСуммуВложений(Команда)
	
	Перем Ошибки;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма, Ошибки) Тогда
		РассчитатьСуммуВложенийНаСервере();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуДемонтажа(Команда)
	
	Объект.СуммаДемонтажа = Объект.ОсновныеСредства.Итог("СуммаДемонтажа");
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуТранспортировки(Команда)
	
	Объект.СуммаТранспортировки = Объект.ОсновныеСредства.Итог("СуммаТранспортировки");
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);

КонецПроцедуры

// Основные средства

&НаКлиенте
Процедура ОбновитьОС(Команда)
	ОсновноеСредствоПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПодборОС(Команда)
	
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьОС(Команда)
	
	Перем Ошибки;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСтоимостиОС(ЭтаФорма,, Ошибки) Тогда
	
		РаспределятьВложения = Истина;
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			ОсновноеСредствоПриИзмененииНаСервере(СтрокаТаблицы.ПолучитьИдентификатор());
			Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаМодернизации)
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.СуммаДемонтажа) 
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.СуммаТранспортировки) Тогда
				РаспределятьВложения = Ложь;
			КонецЕсли;	
		КонецЦикла;
		
		Если РаспределятьВложения = Истина Тогда
			РаспределитьСуммыВложенийПоСтрокамТаблицыОС();
		КонецЕсли;
		
		Для каждого СтрокаТаблицы из Объект.ОсновныеСредства Цикл
			РассчитатьСтоимостьПоОкончанииРабот(ЭтотОбъект, СтрокаТаблицы);
		КонецЦикла;	
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;

КонецПроцедуры

// Комиссия

&НаКлиенте
Процедура ВыбратьКомиссию(Команда)
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Организация));
		ОткрытьФорму("Справочник.ПостоянноДействующиеКомиссии.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Сначала необходимо выбрать организацию'"));
	КонецЕсли;
	
КонецПроцедуры

