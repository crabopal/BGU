	ИменаРеквизитов = ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии(
		"ДолжностьПредседателяКомиссии", "ФамилияПредседателяКомиссии", "ИмяПредседателяКомиссии",
		"ОтчествоПредседателяКомиссии");
	ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии(ЭтотОбъект, ИменаРеквизитов, Истина, Объект.Дата);
