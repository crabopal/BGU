	РеконструкцияИК.ИФО КАК ИФО,
	РеконструкцияИК.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	РеконструкцияИК.СчетКредита КАК СчетКредита,
	РеконструкцияИК.Контрагент КАК Контрагент,
	РеконструкцияИК.Договор КАК Договор,
	РеконструкцияИК.КФО КАК КФО,
	РеконструкцияИК.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	РеконструкцияИК.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	РеконструкцияИК.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	РеконструкцияИК.СуммаДокумента КАК СуммаДокумента,
	РеконструкцияИК.СуммаДемонтажа КАК СуммаДемонтажа,
	РеконструкцияИК.СуммаТранспортировки КАК СуммаТранспортировки,
	РеконструкцияИК.ДатаНачала КАК ДатаНачала,
	РеконструкцияИК.ДатаОкончания КАК ДатаОкончания,
	РеконструкцияИК.Комментарий КАК Комментарий,
	РеконструкцияИК.НомерПриказа КАК НомерПриказа,
	РеконструкцияИК.ДатаПриказа КАК ДатаПриказа,
	РеконструкцияИК.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	РеконструкцияИК.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	РеконструкцияИК.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	РеконструкцияИК.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	РеконструкцияИК.Подразделение КАК Подразделение,
	РеконструкцияИК.ВидОперации КАК ВидОперации,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	РеконструкцияИК.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен
