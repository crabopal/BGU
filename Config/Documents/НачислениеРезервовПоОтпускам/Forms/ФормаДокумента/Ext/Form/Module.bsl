Процедура ОценочныеОбязательстваОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыбраннаяСтрока = Элементы.ОценочныеОбязательства.ТекущаяСтрока;
	ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ОценочныеОбязательстваКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ВидОперацииПоЗарплате) Тогда
		ОграниченияКЭК = ПолучитьОграниченияОперации(ТекущиеДанные.ВидОперацииПоЗарплате, "КЭК");
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭК,
								Объект.Организация, 
								ТекущиеДанные.ИФО,
								ТекущиеДанные.КФО, 
								Неопределено,
								Объект.Дата,
								Неопределено,
								ОграниченияКЭК,
								Истина,
								Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОценочныеОбязательстваКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(Элемент, 
												СтандартнаяОбработка, 
												ТекущиеДанные.КПС, 
												Объект.Организация,
												ТекущиеДанные.ИФО,
												ТекущиеДанные.КФО,
												Неопределено,
												Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ОценочныеОбязательстваКФОПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   ТекущиеДанные.ИФО,
											   ТекущиеДанные.КФО,
											   Объект.Дата,
											   ТекущиеДанные.КПС,
											   Неопределено);
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные,
		Новый Структура("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете));
	
КонецПроцедуры

