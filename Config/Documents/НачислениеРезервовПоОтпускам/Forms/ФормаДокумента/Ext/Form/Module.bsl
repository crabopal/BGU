&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитовОповещение(Результат, ДопПараметры) Экспорт
	Перем ВоВсехСтроках;
	
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ВоВсехСтроках", ВоВсехСтроках);
	
	Если ВоВсехСтроках Тогда
		Для Каждого Стр Из Объект.ОценочныеОбязательства Цикл
			Для Каждого КлючИЗначение Из Результат Цикл
				Стр[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	Иначе
		ВыделенныеСтроки = Элементы.ОценочныеОбязательства.ВыделенныеСтроки;
		
		Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
			Стр = Объект.ОценочныеОбязательства[НомерСтроки];
			
			Для Каждого КлючИЗначение Из Результат Цикл
				Стр[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитов(ВоВсехСтроках = Истина)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ВоВсехСтроках", ВоВсехСтроках);	
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуЗаполненияРеквизитовОповещение", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРеквизитов", СписокРеквизитов());
	
	ОткрытьФорму("Документ.НачислениеРезервовПоОтпускам.Форма.ФормаЗаполненияРеквизитов", 
				ПараметрыФормы, 
				ЭтаФорма, 
				, , , 
				Оповещение, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция СписокРеквизитов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НаименованиеРеквизита");
	Результат.Колонки.Добавить("СинонимРеквизита");
	Результат.Колонки.Добавить("Заполнять");
	Результат.Колонки.Добавить("ЗначениеРеквизита");
	Результат.Колонки.Добавить("ТипЗначенияРеквизита");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "Подразделение";
		Стр.СинонимРеквизита = НСтр("ru = 'Подразделение'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "ИФО";
		Стр.СинонимРеквизита = НСтр("ru = 'ИФО'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	КонецЕсли;	
	
	Если Объект.ИмпортированИзЗГУ Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "СпособОтраженияЗарплатыВУчете";
		Стр.СинонимРеквизита = НСтр("ru = 'Способ отражения в учете'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.СпособыОтраженияЗарплатыВБухУчете");
		
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "СтатьяФинансированияЗарплата";
		Стр.СинонимРеквизита = НСтр("ru = 'Статья финансирования'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.СтатьиФинансированияЗарплата");
	КонецЕсли;		
		
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "ВидОперацииПоЗарплате";
	Стр.СинонимРеквизита = НСтр("ru = 'Вид операции'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийПоЗарплате");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КФО";
	Стр.СинонимРеквизита = НСтр("ru = 'КФО'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КПС";
	Стр.СинонимРеквизита = НСтр("ru = 'КПС'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КЭК";
	Стр.СинонимРеквизита = НСтр("ru = 'КЭК'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
	
	Если ПлательщикЕНВД Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "ОблагаетсяЕНВД";
		Стр.СинонимРеквизита = НСтр("ru = 'Облагается ЕНВД'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("Булево");
	КонецЕсли;	
		
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	Для Каждого СтрокаТаблицы Из Объект.ОценочныеОбязательства Цикл
		ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете",
			НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, СтрокаТаблицы.КФО));
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта);
		
		ОграниченияОперации = ПолучитьОграниченияОперации(СтрокаТаблицы.ВидОперацииПоЗарплате, "Счет");
		ОтражениеВУчетеДоступность = Не (ТипЗнч(ОграниченияОперации)=Тип("Массив") И ОграниченияОперации.Количество()=0);
		СтрокаТаблицы.ОтражениеВУчетеДоступность = ОтражениеВУчетеДоступность;
		
		Если Не ОтражениеВУчетеДоступность Тогда
			СтрокаТаблицы.Счет          = Неопределено;
			СтрокаТаблицы.Субконто1     = Неопределено;
			СтрокаТаблицы.Субконто2     = Неопределено;
			СтрокаТаблицы.Субконто3     = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеКолонкиОтражениеВУчете()
	
	СтрокиБезЗаполнения = Объект.ОценочныеОбязательства.НайтиСтроки(Новый Структура("ОтражениеВУчетеЗаполнено", Ложь));
	
	Если СтрокиБезЗаполнения.Количество() > 0 Тогда
		ЗаполнитьДобавленныеКолонкиТаблиц();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОграниченияОперации(ВидОперации, Ограничение)
	
	ТекстМакета = Документы.НачислениеРезервовПоОтпускам.ПолучитьМакет("ОграниченияОпераций").ПолучитьТекст(); 
	ВидыОпераций = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
	
	СтрокаОграничений = ВидыОпераций.Найти(ВидОперации, "ВидОперацииПоЗарплате");
	
	Если СтрокаОграничений = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Объект.Ссылка КАК Ссылка
	               |ИЗ
	               |	&Справочник КАК Объект
	               |ГДЕ
	               |	Объект.Код В (&МассивОграничений)
				   |УПОРЯДОЧИТЬ ПО
				   |	Объект.Код";
	Если Ограничение = "Счет" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Справочник", "ПланСчетов.ЕПСБУ");
		Запрос.УстановитьПараметр("МассивОграничений", СтрРазделить(СтрокаОграничений.ОграничениеСчет, ","));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Справочник", "Справочник.КОСГУ");
		Запрос.УстановитьПараметр("МассивОграничений", СтрРазделить(СтрокаОграничений.ОграничениеКЭК, ","));
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ОценочныеОбязательства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      Истина);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.Субконто1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.Субконто2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.Субконто3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка принятия к учету резерва по отпускам'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет расходов'"));
	
	МассивСчетов = ПолучитьОграниченияОперации(ДанныеСтроки.ВидОперацииПоЗарплате, "Счет");
	Если ТипЗнч(МассивСчетов) = Тип("Массив") Тогда
		Если МассивСчетов.Количество() > 0 Тогда
			ПараметрыСчета = Новый Структура;
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", МассивСчетов);
			ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
			ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	// Карточка капвложений
	ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзмененииНаКлиенте()
	
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;
	
	ТекущиеДанные.Счет        = Неопределено;
	ТекущиеДанные.КФО         = Неопределено;
	ТекущиеДанные.КПС         = Неопределено;
	ТекущиеДанные.Субконто1   = Неопределено;
	ТекущиеДанные.Субконто2   = Неопределено;
	ТекущиеДанные.Субконто3   = Неопределено;
	ТекущиеДанные.СчетНУ      = Неопределено;
	ТекущиеДанные.СубконтоНУ1 = Неопределено;
	ТекущиеДанные.СубконтоНУ2 = Неопределено;
	ТекущиеДанные.СубконтоНУ3 = Неопределено;
	ТекущиеДанные.ОтражениеВУчете = "<...>";
	ТекущиеДанные.ОтражениеВУчетеЗаполнено = Ложь;
	
	ОграниченияОперации = ПолучитьОграниченияОперации(ТекущиеДанные.ВидОперацииПоЗарплате, "Счет");
	ТекущиеДанные.ОтражениеВУчетеДоступность = Не (ТипЗнч(ОграниченияОперации)=Тип("Массив") И ОграниченияОперации.Количество()=0);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете); // КФО, КПС, КЭК и пр.
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные,
		Новый Структура("ОтражатьВНалоговомУчете",
			НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, ТекущиеДанные.КФО)));
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыУчета(ТекущиеДанные)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата", Объект.Дата);
	СтруктураПараметров.Вставить("Организация", Объект.Организация);
	СтруктураПараметров.Вставить("СтатьяФинансированияЗарплата", ТекущиеДанные.СтатьяФинансированияЗарплата);
	СтруктураПараметров.Вставить("СпособОтраженияЗарплатыВУчете", ТекущиеДанные.СпособОтраженияЗарплатыВУчете);
	СтруктураПараметров.Вставить("ВидОперацииПоЗарплате", ТекущиеДанные.ВидОперацииПоЗарплате);
	
	ПолучитьДанныеУчета(СтруктураПараметров);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураПараметров); 
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполненыВсеПараметры(ТекущиеДанные)
	
	Возврат ЗначениеЗаполнено(ТекущиеДанные.СтатьяФинансированияЗарплата) 
			И ЗначениеЗаполнено(ТекущиеДанные.СпособОтраженияЗарплатыВУчете)
			И ЗначениеЗаполнено(ТекущиеДанные.ВидОперацииПоЗарплате);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПолучитьДанныеУчета(СтруктураПараметров)
	
	СтруктураПараметров.Вставить("КФО");
	СтруктураПараметров.Вставить("КПС");
	СтруктураПараметров.Вставить("КЭК");
	СтруктураПараметров.Вставить("Счет");
	СтруктураПараметров.Вставить("Субконто1");
	СтруктураПараметров.Вставить("Субконто2");
	СтруктураПараметров.Вставить("Субконто3");
	СтруктураПараметров.Вставить("СчетНУ");
	СтруктураПараметров.Вставить("СубконтоНУ1");
	СтруктураПараметров.Вставить("СубконтоНУ2");
	СтруктураПараметров.Вставить("СубконтоНУ3");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ОценкаОбязательстваИФормированиеРезервов) КАК ВидОперацииПоЗарплате,
	|	КОСГУ.Ссылка КАК КЭК
	|ПОМЕСТИТЬ ДопустимыеКЭК
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код = ""211""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ФСС),
	|	КОСГУ.Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код = ""213""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ФССНС),
	|	КОСГУ.Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код = ""213""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&СпособОтраженияЗарплатыВУчете КАК СпособОтраженияЗарплатыВУчете,
	|	&СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
	|	&ВидОперацииПоЗарплате КАК ВидОперацииПоЗарплате,
	|	НастройкаСтатейФинансирования.КФО КАК КФО,
	|	НастройкаСтатейФинансирования.КПС КАК КПС,
	|	ДопустимыеКЭК.КЭК КАК КЭК,
	|	НастройкаСпособовОтражения.СчетДт КАК Счет,
	|	НастройкаСпособовОтражения.Субконто1 КАК Субконто1,
	|	НастройкаСпособовОтражения.Субконто2 КАК Субконто2,
	|	НастройкаСпособовОтражения.Субконто3 КАК Субконто3,
	|	НастройкаСпособовОтражения.СчетНУ КАК СчетНУ,
	|	НастройкаСпособовОтражения.СубконтоНУ1 КАК СубконтоНУ1,
	|	НастройкаСпособовОтражения.СубконтоНУ2 КАК СубконтоНУ2,
	|	НастройкаСпособовОтражения.СубконтоНУ3 КАК СубконтоНУ3
	|ИЗ
	|	Справочник.СтатьиФинансированияЗарплата КАК СтатьиФинансирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаСтатейФинансированияЗарплата.СрезПоследних(&НаДату, ) КАК НастройкаСтатейФинансирования
	|		ПО (&Организация = НастройкаСтатейФинансирования.Организация)
	|			И (&СтатьяФинансированияЗарплата = НастройкаСтатейФинансирования.СтатьяФинансированияЗарплата)
	|			И (&ВидОперацииПоЗарплате = НастройкаСтатейФинансирования.ВидОперации)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СрезПоследних(&НаДату, ) КАК НастройкаСпособовОтражения
	|		ПО (&Организация = НастройкаСпособовОтражения.Организация)
	|			И (&СпособОтраженияЗарплатыВУчете = НастройкаСпособовОтражения.СпособОтраженияЗарплатыВБухУчете)
	|			И (&ВидОперацииПоЗарплате = НастройкаСпособовОтражения.ВидОперации)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДопустимыеКЭК КАК ДопустимыеКЭК
	|		ПО (&ВидОперацииПоЗарплате = ДопустимыеКЭК.ВидОперацииПоЗарплате)
	|ГДЕ
	|	СтатьиФинансирования.Ссылка = &СтатьяФинансированияЗарплата";
	
	Запрос.УстановитьПараметр("НаДату", СтруктураПараметров.Дата);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("СтатьяФинансированияЗарплата", СтруктураПараметров.СтатьяФинансированияЗарплата);
	Запрос.УстановитьПараметр("СпособОтраженияЗарплатыВУчете", СтруктураПараметров.СпособОтраженияЗарплатыВУчете);
	Запрос.УстановитьПараметр("ВидОперацииПоЗарплате", СтруктураПараметров.ВидОперацииПоЗарплате);

	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, Результат[0]);
		
		СтруктураПараметров.Вставить("ОтражениеВУчете");
		СтруктураПараметров.Вставить("ОтражениеВУчетеЗаполнено");
		СтруктураПараметров.Вставить("ОтражениеВУчетеДоступность");
		СтруктураПараметров.Вставить("ОблагаетсяЕНВД");
		
		ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете",
			НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(СтруктураПараметров.Организация, СтруктураПараметров.Дата, СтруктураПараметров.КФО));
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтруктураПараметров, ПараметрыОбъекта);
	
		ОграниченияОперации = ПолучитьОграниченияОперации(СтруктураПараметров.ВидОперацииПоЗарплате, "Счет");
		ОтражениеВУчетеДоступность = Не (ТипЗнч(ОграниченияОперации)=Тип("Массив") И ОграниченияОперации.Количество()=0);
		СтруктураПараметров.ОтражениеВУчетеДоступность = ОтражениеВУчетеДоступность;
		
		Если Не ОтражениеВУчетеДоступность Тогда
			СтруктураПараметров.Счет          = Неопределено;
			СтруктураПараметров.Субконто1     = Неопределено;
			СтруктураПараметров.Субконто2     = Неопределено;
			СтруктураПараметров.Субконто3     = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеКЭКПоВидуОперации(ВидОперации)
	Если ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ОценкаОбязательстваИФормированиеРезервов Тогда
		Возврат Справочники.КОСГУ.НайтиПоКоду("211");
	Иначе 
		Возврат Справочники.КОСГУ.НайтиПоКоду("213");
	КонецЕсли;
КонецФункции

