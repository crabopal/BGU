	Иначе
		ВидОперацииПриИзмененииНаКлиенте();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОценочныеОбязательстваВидОперацииПоЗарплатеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОценочныеОбязательства.ТекущиеДанные;
	
	Если ЗаполненыВсеПараметры(ТекущиеДанные) Тогда
		УстановитьПараметрыУчета(ТекущиеДанные);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ВидОперацииПоЗарплате) Тогда
		ТекущиеДанные.КЭК = ЗначениеКЭКПоВидуОперации(ТекущиеДанные.ВидОперацииПоЗарплате);
	Иначе
		ВидОперацииПриИзмененииНаКлиенте();
	КонецЕсли;
КонецПроцедуры

