
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем СписокРеквизитов;
	
	Параметры.Свойство("СписокРеквизитов", СписокРеквизитов);
	
	Если ЗначениеЗаполнено(СписокРеквизитов) Тогда
		ТаблицаРеквизитов = ПолучитьИзВременногоХранилища(СписокРеквизитов);
		
		Если ТипЗнч(ТаблицаРеквизитов) = Тип("ТаблицаЗначений") Тогда
			ЗначениеВРеквизитФормы(ТаблицаРеквизитов, "ТаблицаРеквизитовИЗначений");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыТаблицаРеквизитовИЗначений

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПриАктивизацииЯчейки(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаРеквизитовИЗначенийЗначениеРеквизита" Тогда
		ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Элемент.ТекущийЭлемент.ОграничениеТипа = ТекущиеДанные.ТипЗначенияРеквизита;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр) 
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Заполнять = ЗначениеЗаполнено(ТекущиеДанные.ЗначениеРеквизита);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьРеквизиты(Команда)
	Закрыть(РезультатЗаполнения());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РезультатЗаполнения()
	РезультатЗаполнения = Новый Структура;
	
	Для Каждого Стр Из ТаблицаРеквизитовИЗначений Цикл
		Если Стр.Заполнять Тогда
			РезультатЗаполнения.Вставить(Стр.НаименованиеРеквизита, 
										?(ЗначениеЗаполнено(Стр.ЗначениеРеквизита),
											Стр.ЗначениеРеквизита,
											Стр.ТипЗначенияРеквизита.ПривестиЗначение()));
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатЗаполнения;
КонецФункции

#КонецОбласти