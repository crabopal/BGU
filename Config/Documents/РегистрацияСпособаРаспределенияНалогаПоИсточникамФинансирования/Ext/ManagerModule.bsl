Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыЗапроса = Новый Структура;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РегистрацияСпособа.Дата КАК Период,
	|	РегистрацияСпособа.Организация КАК Организация,
	|	РегистрацияСпособа.ВидНалога КАК ВидНалога,
	|	РегистрацияСпособа.ИФО КАК ИФО,
	|	РегистрацияСпособа.КФО КАК КФО,
	|	РегистрацияСпособа.КПС КАК КПС,
	|	РегистрацияСпособаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияСпособаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияСпособа.Ссылка КАК СпособРаспределения
	|ИЗ
	|	Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования КАК РегистрацияСпособа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования.ОсновныеСредства КАК РегистрацияСпособаОсновныеСредства
	|		ПО РегистрацияСпособа.Ссылка = РегистрацияСпособаОсновныеСредства.Ссылка
	|ГДЕ
	|	РегистрацияСпособа.Ссылка = &Ссылка";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрацияСпособа.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");	
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("СпособыРаспределенияНалогаПоИсточникамФинансирования",
		Запрос.Выполнить().Выгрузить());	
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
