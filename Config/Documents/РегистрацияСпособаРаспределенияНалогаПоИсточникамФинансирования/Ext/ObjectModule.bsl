#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Перем ПоВсемОС;
	
	Если Не ДополнительныеСвойства.Свойство("ПоВсемОС", ПоВсемОС) Тогда
		ПоВсемОС = ОсновныеСредства.Количество() = 0;	
	КонецЕсли;

	ПроверитьДублиДокументов(ПоВсемОС, Отказ);
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	Если ПоВсемОС Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ОсновныеСредства");
		МассивНепроверяемыхРеквизитов.Добавить("ОсновныеСредства.ОсновноеСредство");
		
	Иначе
		
		МассивНепроверяемыхРеквизитов.Добавить("ИФО");
		МассивНепроверяемыхРеквизитов.Добавить("КФО");

		ПроверитьДублиСтрокОсновныеСредства(Отказ);

	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ОсновныеСредства.Количество() > 0 Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
		КФО = Перечисления.КВД.ПустаяСсылка();
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();	
	КонецЕсли;
	
	Если РазделЛицевогоСчетаВТаблице = 0 Тогда
		Для каждого Строка Из ПорядокОтраженияВУчете Цикл
			Строка.РазделЛицевогоСчета = РазделЛицевогоСчета;		
		КонецЦикла;
	Иначе
		РазделЛицевогоСчета = Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиДокументов(ПоВсемОС, Отказ)
	
	Если ПоВсемОС Тогда
		ПроверитьДублиДокументовПоУчетнымДанным(Отказ);
	Иначе
		ПроверитьДублиДокументовПоСпискуОС(Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДублиДокументовПоУчетнымДанным(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Регистрация.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования КАК Регистрация
		|ГДЕ
		|	Регистрация.Дата = &Дата
		|	И Регистрация.Проведен
		|	И Регистрация.ВидНалога = &ВидНалога
		|	И Регистрация.Организация = &Организация
		|	И &УсловиеПоИФО
		|	И Регистрация.КФО = &КФО
		|	И Регистрация.КПС = &КПС
		|	И Регистрация.Ссылка <> &Ссылка";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ИспользоватьУчетПоИФО, "Регистрация.ИФО = &ИФО", "ИСТИНА"));	
		
	Запрос.Текст = ТекстЗапроса;	
		
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидНалога", ВидНалога);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("КПС", КПС);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		ШаблонТекста = НСтр("ru = 'Датой %1 уже был проведен документ %2 по налогу ""%3"", ИФО ""%4"", КФО %5, КПС %6'");
		
		Если Не ИспользоватьУчетПоИФО Тогда
			ШаблонТекста = СтрЗаменить(ШаблонТекста, ", ИФО ""%4""", "%4");
		КонецЕсли;

		Выборка = Результат.Выбрать();
		Выборка.Следующий();
			
		ТекстОшибки = СтрШаблон(ШаблонТекста,
			Дата,
			Выборка.Ссылка,
			ВидНалога,
			?(ИспользоватьУчетПоИФО, ИФО, ""),
			КФО,
			?(ЗначениеЗаполнено(КПС), КПС, "<для всех>"));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Дата", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиДокументовПоСпискуОС(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТОсновныеСредства
	|ИЗ
	|	&ОсновныеСредства КАК ОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистрация.Ссылка КАК Ссылка,
	|	РегистрацияОсновныеСредства.ОсновноеСредство.Представление КАК ОсновноеСредство,
	|	РегистрацияОсновныеСредства.ИнвентарныйНомер.Представление КАК ИнвентарныйНомер
	|ИЗ
	|	Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования.ОсновныеСредства КАК РегистрацияОсновныеСредства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования КАК Регистрация
	|		ПО РегистрацияОсновныеСредства.Ссылка = Регистрация.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОсновныеСредства КАК ВТОсновныеСредства
	|		ПО РегистрацияОсновныеСредства.ОсновноеСредство = ВТОсновныеСредства.ОсновноеСредство
	|			И РегистрацияОсновныеСредства.ИнвентарныйНомер = ВТОсновныеСредства.ИнвентарныйНомер
	|ГДЕ
	|	Регистрация.Дата = &Дата
	|	И Регистрация.Проведен
	|	И Регистрация.ВидНалога = &ВидНалога
	|	И Регистрация.Организация = &Организация
	|	И Регистрация.Ссылка <> &Ссылка");
	
		
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидНалога", ВидНалога);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновныеСредства", ОсновныеСредства.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		ШаблонТекста = НСтр("ru = 'Датой %1 уже был проведен документ %2 по налогу ""%3"", объект ОС: ""%4""%5'");
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ТекстОшибки = СтрШаблон(ШаблонТекста,
				Дата,
				Выборка.Ссылка,
				ВидНалога,
				Выборка.ОсновноеСредство,
				?(ЗначениеЗаполнено(Выборка.ИнвентарныйНомер), СтрШаблон(НСтр("ru=' (инв.№: %1)'"), Выборка.ИнвентарныйНомер), ""));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Дата", "Объект", Отказ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиСтрокОсновныеСредства(Отказ)

	КолонкиДублей = "ОсновноеСредство,ИнвентарныйНомер";
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ОсновныеСредства, КолонкиДублей, Истина);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		
		Отказ = Истина;
		
		ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
		ПараметрыВывода.ТаблицаИмя = "ОсновныеСредства";
		ПараметрыВывода.ТаблицаПредставление = "Основные средства";
		ПараметрыВывода.ОбъектСсылка = Ссылка;
		ПараметрыВывода.ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
		ПараметрыВывода.ИмяПоляДляВыводаСообщений = "ОсновноеСредство";
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
	КонецЕсли;

КонецПроцедуры


#КонецОбласти

#КонецЕсли