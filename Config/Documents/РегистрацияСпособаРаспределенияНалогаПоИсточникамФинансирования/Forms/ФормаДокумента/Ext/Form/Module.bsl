#КонецОбласти

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.ОсновныеСредства.ИнвентарныйНомер",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'по всем'"));
	
КонецПроцедуры

// Возвращает рекомендуемый КПС для учета налога по объекту налогообложения.
//
// Параметры:
//  ВидНалога	- ПеречислениеСсылка.ВидыИмущественныхНалогов
//  КПС 		- СправочникСсылка.КлассификационныеПризнакиСчетов - КПС объекта налогообложения
//  Дата 		- Дата
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификационныеПризнакиСчетов - Рекомендуемый КПС
//
&НаСервереБезКонтекста
Функция КПСУчетаНалогаПоУмолчанию(Знач ВидНалога, Знач КПС, Знач Дата)

	Возврат 
		УправлениеОсновнымиСредствами.КПСУчетаНалогаПоУмолчанию(ВидНалога, КПС, Дата);

КонецФункции 

