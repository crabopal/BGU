
#Область ОписаниеПеременных

&НаКлиенте
Перем ЭтоНоваяСтрока;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части

	Если Параметры.Ключ.Пустая() Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;

	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части

	ПодготовитьФормуНаСервере();
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);

	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		
		ОбработкаВыбораОтраженияВУчетеНаКлиенте(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ПоВсемОС = 1 И ТекущийОбъект.ОсновныеСредства.Количество() > 0 Тогда
		ТекущийОбъект.ОсновныеСредства.Очистить();	
	КонецЕсли;

	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	ПроверяемыеРеквизиты.Очистить();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПоВсемОС", ПоВсемОС = 1);
	Отказ = Не ДокументОбъект.ПроверитьЗаполнение();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНалогаПриИзменении(Элемент)
	
	Если Объект.ПорядокОтраженияВУчете.Количество() > 0 Тогда
		ВидНалогаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		Объект.ОсновныеСредства.Очистить();	
	КонецЕсли;

	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаКлиенте
Процедура ПоВсемОСПриИзменении(Элемент)
	ВидимостьСтраницыОсновныеСредства(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПоСпискуОСПриИзменении(Элемент)
	ВидимостьСтраницыОсновныеСредства(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура РазделЛицевогоСчетаВТаблицеПриИзменении(Элемент)
	
	РазделЛицевогоСчетаВТаблицеПриИзмененииНаКлиенте();
	ВидимостьРазделЛицевогоСчета(ЭтотОбъект);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПорядокОтраженияВУчете

&НаКлиенте
Процедура ПорядокОтраженияВУчетеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ПорядокОтраженияВУчетеОтражениеВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ЭтоНоваяСтрока И ТекущиеДанные <> Неопределено Тогда
		Если Элемент.ТекущийЭлемент.Имя = "ПорядокОтраженияВУчетеОтражениеВУчете"
			И НЕ ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ОткрытьФормуНастройкиОтраженияВУчете(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ЭтоНоваяСтрока = НоваяСтрока;
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные = Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
		Если ПоВсемОС = 1 Тогда
			ТекущиеДанные.ИФО = Объект.ИФО;
			ТекущиеДанные.КФО = Объект.КФО;
			ТекущиеДанные.КПС = КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, Объект.КПС, Объект.Дата);
		КонецЕсли;
		ТекущиеДанные.КЭК = ЭтотОбъект.КэшПараметров.Локальные.КЭКПоУмолчанию;
		
		Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение Тогда
			ТекущиеДанные.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.СчетДтПоУмолчанию;
			ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);
		Иначе	
			ТекущиеДанные.ОтражениеВУчете = "<...>";
		КонецЕсли;
		
		ТекущиеДанные.Коэффициент = 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ЭтоНоваяСтрока = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеКФОПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КЭКПоУмолчанию",
		БухгалтерскийУчетПовтИсп.КЭКПоКоду("291"));

	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетДтПоУмолчанию",
		БухгалтерскийУчет.СчетПоКоду("401.20", Объект.Дата));
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ПоВсемОС = Объект.ОсновныеСредства.Количество() = 0;
	ВидимостьСтраницыОсновныеСредства(ЭтотОбъект);
	ВидимостьРазделЛицевогоСчета(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	Для Каждого СтрокаТаблицы Из Объект.ПорядокОтраженияВУчете Цикл
		ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчете(УчетнаяПолитика, СтрокаТаблицы)
	
	ПоляФормы = Новый Структура;
	ПоляФормы.Вставить("КПС",			"КПСДт");
	ПоляФормы.Вставить("Подразделение",	"ПодразделениеДт");
	ПоляФормы.Вставить("Счет",			"СчетДт");
	ПоляФормы.Вставить("Субконто1",		"СубконтоДт1");
	ПоляФормы.Вставить("Субконто2",		"СубконтоДт2");
	ПоляФормы.Вставить("Субконто3",		"СубконтоДт3");
	
	ОтражатьВНалоговомУчете = УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьНДС", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьКПС",
		НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт));
	ПараметрыОбъекта.Вставить("ЕстьКЭК", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьПодразделение",
		НЕ СтрокаТаблицы.Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
	ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", СтрокаТаблицы.ОтразитьВКарточкеКапвложений);
	ПараметрыОбъекта.Вставить("КарточкаКапвложений", СтрокаТаблицы.КарточкаКапвложений);
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("КФО", ДанныеСтроки.КФО);
	
	ПараметрыФормы.Вставить("КПС", 
		?(ЗначениеЗаполнено(ДанныеСтроки.КПСДт), ДанныеСтроки.КПСДт, ДанныеСтроки.КПС));
		
	Если Не ЗначениеЗаполнено(ПараметрыФормы.КПС) Тогда
		ПараметрыФормы.Вставить("ОбязательностьКПС", 	Ложь);
		ПараметрыФормы.Вставить("ВидимостьКПС", 	 	Ложь);
	Иначе
		ПараметрыФормы.Вставить("ВидимостьКПС", 		Истина);
	КонецЕсли;	
		
	ПараметрыФормы.Вставить("Подразделение", 
		?(ЗначениеЗаполнено(ДанныеСтроки.ПодразделениеДт), ДанныеСтроки.ПодразделениеДт, ДанныеСтроки.Подразделение));
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", 
		БухгалтерскийУчетКлиентСервер.СписокСчетов("106.00,109.00,110.00,401.20", Объект.Дата, , Объект.Организация));
	ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыСчета.Вставить("Организация", 			Объект.Организация);
	ПараметрыСчета.Вставить("ИФО", 					ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("ПараметрыСчета", 		ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ЕстьНДС", Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", Неопределено);

	ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетКлиентСервер.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02", Объект.Дата, , Объект.Организация));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	// УСН
	ПараметрыФормы.Вставить("ОтражениеВУСН", ДанныеСтроки.ОтражениеВУСН);
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	ТекущиеДанные = Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
 
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,, "КФО, КПС, КЭК"); 
	
	Если НЕ ТекущиеДанные.КПС = СтруктураОтражениеВУчете.КПС Тогда
		ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	Иначе
		ТекущиеДанные.КПСДт = Неопределено;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.Подразделение = СтруктураОтражениеВУчете.Подразделение Тогда
		ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	Иначе
		ТекущиеДанные.ПодразделениеДт = Неопределено;
	КонецЕсли;
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьСтраницыОсновныеСредства(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаОсновныеСредства",
		"Видимость", Форма.ПоВсемОС = 0);
	
	Если Форма.ПоВсемОС = 1 Тогда
		Элементы.ГруппаУчетныеДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаСчет;
	Иначе
		Элементы.ГруппаУчетныеДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаПоДаннымОбъекта;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьРазделЛицевогоСчета(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РазделЛицевогоСчета",
		"Видимость", Объект.РазделЛицевогоСчетаВТаблице = 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПорядокОтраженияВУчетеРазделЛицевогоСчета",
		"Видимость", Объект.РазделЛицевогоСчетаВТаблице = 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидНалогаПриИзмененииНаСервере()
	
	Для каждого Строка Из Объект.ПорядокОтраженияВУчете Цикл
		Строка.КПС 		= КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, Строка.КПС, Объект.Дата);
		Строка.КПСДт 	= КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, Строка.КПСДт, Объект.Дата);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаКлиенте
Процедура РазделЛицевогоСчетаВТаблицеПриИзмененииНаКлиенте()
	
	Если Объект.ПорядокОтраженияВУчете.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Если Объект.РазделЛицевогоСчетаВТаблице = 0
		И Не ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
		
		Объект.РазделЛицевогоСчета = Объект.ПорядокОтраженияВУчете[0].РазделЛицевогоСчета;
		
	ИначеЕсли Объект.РазделЛицевогоСчетаВТаблице = 1
		И ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
		
		ЗаполнитьРазделЛицевогоСчетаВТабличнойЧасти();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазделЛицевогоСчетаВТабличнойЧасти()
	
	РазделЛицевогоСчета = Объект.РазделЛицевогоСчета;	
	ДопустимыеКФО = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазделыЛицевыхСчетовДопустимыеКФО.КФО КАК КФО
		|ИЗ
		|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
		|ГДЕ
		|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка = &РазделЛицевогоСчета";
	
	Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
	
	ВыборкаДопустимыеКФО = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДопустимыеКФО.Следующий() Цикл
		ДопустимыеКФО.Вставить(ВыборкаДопустимыеКФО.КФО, Истина);		
	КонецЦикла;
	
	Для каждого Строка Из Объект.ПорядокОтраженияВУчете Цикл
		Если ДопустимыеКФО[Строка.КФО] <> Неопределено Тогда
			Строка.РазделЛицевогоСчета = РазделЛицевогоСчета;		
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

