#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НачислениеДоходов";
	КомандаПечати.Идентификатор		= "ВедомостьНачисленийЗаУслугу";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость начислений за услугу'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НачислениеДоходов";
	КомандаПечати.Идентификатор		= "АктОбОказанииУслуг";
	КомандаПечати.Представление		= НСтр("ru = 'Акт об оказании услуг'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ВедомостьНачисленийЗаУслугу") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ВедомостьНачисленийЗаУслугу",
															НСтр("ru = 'Ведомость начислений за услугу'"),
															ПечатьВедомостьНачисленийЗаУслугу(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктОбОказанииУслуг",
															НСтр("ru = 'Акт об оказании услуг'"),
															ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
			
	КонецЕсли;

КонецПроцедуры

Функция ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	Если МассивОбъектов.Количество() > 0 И ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
	
		СчетаФактуры = МассивОбъектов;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.Ссылка В(&МассивОбъектов)";
		Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
		МассивОбъектов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументОснование");
		
	Иначе
		
		НачисленияДоходов = МассивОбъектов;
		СчетаФактуры = Неопределено;
		
	КонецЕсли;
	
	Возврат СформироватьПечатнуюФормуАктаОбОказанииУслуг(МассивОбъектов, СчетаФактуры, ОбъектыПечати, ПараметрыПечати);
	
КонецФункции

Функция СформироватьПечатнуюФормуАктаОбОказанииУслуг(МассивОбъектов, СчетаФактуры, ОбъектыПечати, ПараметрыПечати)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктВыполненныхУслуг");
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги  = Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	МассивДляПроверки = Новый Массив;
	МассивДляПроверки.Добавить(ОбластьИтоги);
	МассивДляПроверки.Добавить(ОбластьПодвал);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "НачислениеДоходов_АктВыполненныхУслуг";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеДоходовНачисления.Контрагент КАК Контрагент,
	|	НачислениеДоходовНачисления.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СУММА(НачислениеДоходовНачисления.Количество) КАК Количество,
	|	НачислениеДоходовНачисления.Ссылка КАК Ссылка,
	|	СУММА(НачислениеДоходовНачисления.Сумма) КАК Сумма,
	|	СУММА(НачислениеДоходовНачисления.СуммаНДС) КАК СуммаНДС,
	|	СУММА(НачислениеДоходовНачисления.Всего) КАК Всего,
	|	МИНИМУМ(НачислениеДоходовНачисления.НомерСтроки) КАК НомерСтроки,
	|	НачислениеДоходовНачисления.ОформлятьЭД КАК ОформлятьЭД,
	|	НачислениеДоходовНачисления.ИдентификаторЭД КАК ИдентификаторЭД
	|ПОМЕСТИТЬ КоличествоУслуг
	|ИЗ
	|	Документ.НачислениеДоходов.Начисления КАК НачислениеДоходовНачисления
	|ГДЕ
	|	НачислениеДоходовНачисления.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	НачислениеДоходовНачисления.Ссылка,
	|	НачислениеДоходовНачисления.Контрагент,
	|	НачислениеДоходовНачисления.ДоговорКонтрагента,
	|	НачислениеДоходовНачисления.ОформлятьЭД,
	|	НачислениеДоходовНачисления.ИдентификаторЭД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НачислениеДоходов.Ссылка КАК ДокументОснование,
	|	НачислениеДоходов.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА НачислениеДоходов.Организация.НаименованиеПолное = """"
	|			ТОГДА НачислениеДоходов.Организация.Наименование
	|		ИНАЧЕ НачислениеДоходов.Организация.НаименованиеПолное
	|	КОНЕЦ КАК пНаименованиеОрганизации,
	|	НачислениеДоходов.Организация.ИНН КАК ОрганизацияИНН,
	|	НачислениеДоходов.Организация.КПП КАК ОрганизацияКПП,
	|	КоличествоУслуг.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА КоличествоУслуг.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА КоличествоУслуг.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ВЫРАЗИТЬ(КоличествоУслуг.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное = """"
	|						ТОГДА КоличествоУслуг.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ КоличествоУслуг.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ КоличествоУслуг.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	КоличествоУслуг.Контрагент.ИНН КАК КонтрагентИНН,
	|	КоличествоУслуг.Контрагент.КПП КАК КонтрагентКПП,
	|	НачислениеДоходов.Дата КАК пДата,
	|	КоличествоУслуг.ДоговорКонтрагента.Представление КАК пДоговор,
	|	1 КАК пНом,
	|	НачислениеДоходов.Номенклатура.Представление КАК пНаименование,
	|	НачислениеДоходов.Номенклатура.ЕдиницаИзмерения.Представление КАК пЕдИзм,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КоличествоУслуг.Количество, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ КоличествоУслуг.Количество
	|	КОНЕЦ КАК пКоличество,
	|	КоличествоУслуг.Всего / ВЫБОР
	|		КОГДА ЕСТЬNULL(КоличествоУслуг.Количество, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ КоличествоУслуг.Количество
	|	КОНЕЦ КАК пЦена,
	|	КоличествоУслуг.Всего КАК пСумма,
	|	КоличествоУслуг.СуммаНДС КАК пИтогНДС,
	|	КоличествоУслуг.Всего КАК пИтогСумма,
	|	КоличествоУслуг.Всего КАК пИтогВсего,
	|	НачислениеДоходов.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ЕСТЬNULL(СчетФактураВыданный.ВалютаДокумента, &ВалютаРубли) КАК ВалютаДокумента,
	|	НачислениеДоходов.Номер КАК НомерНачисления,
	|	НачислениеДоходов.Ссылка КАК Начисление,
	|	ЕСТЬNULL(СчетФактураВыданный.Номер, """") КАК НомерСФ,
	|	СчетФактураВыданный.Ссылка КАК СФСсылка,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.ВалютаДокумента ЕСТЬ NULL
	|			ТОГДА &РублиПредставление
	|		ИНАЧЕ СчетФактураВыданный.ВалютаДокумента.Представление
	|	КОНЕЦ КАК пВалюта,
	|	НачислениеДоходов.Руководитель КАК Руководитель,
	|	КоличествоУслуг.НомерСтроки КАК НомерСтроки,
	|	КоличествоУслуг.ОформлятьЭД КАК ОформлятьЭД,
	|	КоличествоУслуг.ИдентификаторЭД КАК ИдентификаторЭД
	|ИЗ
	|	КоличествоУслуг КАК КоличествоУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ПО (СчетФактураВыданный.Контрагент = КоличествоУслуг.Контрагент)
	|			И (СчетФактураВыданный.Договор = КоличествоУслуг.ДоговорКонтрагента)
	|			И (СчетФактураВыданный.ДокументОснование = КоличествоУслуг.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеДоходов КАК НачислениеДоходов
	|		ПО КоличествоУслуг.Ссылка = НачислениеДоходов.Ссылка
	|ГДЕ
	|	&УсловиеСчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	НомерНачисления,
	|	НомерСФ,
	|	НомерСтроки
	|ИТОГИ ПО
	|	ДокументОснование";
	
	Запрос.УстановитьПараметр("МассивОбъектов",     МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРубли",        Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("РублиПредставление", Строка(Константы.ВалютаРегламентированногоУчета.Получить()));
	
	Если СчетаФактуры = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСчетФактура", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСчетФактура", "СчетФактураВыданный.Ссылка В(&СчетаФактуры)");
		Запрос.УстановитьПараметр("СчетаФактуры", СчетаФактуры);
	КонецЕсли;
	
	ВыборкаОснование = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаОснование.Следующий() Цикл
		
		ВыборкаШапка = ВыборкаОснование.Выбрать();
		ЗапомнитьНачалоОбласти = Истина;
		
		Пока ВыборкаШапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			Если ВыборкаШапка.ОформлятьЭД Тогда
				//Электронные акты
				Продолжить;
			КонецЕсли;	
			
			ПервыйДокумент = Ложь;
			Если ЗапомнитьНачалоОбласти Тогда
				НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
				ЗапомнитьНачалоОбласти = Ложь;
			КонецЕсли;
			
			ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
			
			АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
			ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
			
			СтруктураОбластьШапка = Новый Структура("пАдресТелефон,пЗаказчик,пДата,пНомер,пНаименованиеОрганизации");
			
			СтруктураОбластьШапка.пНаименованиеОрганизации = СтрШаблон(НСтр("ru = '%1 ИНН %2 КПП %3'"),
				ВыборкаШапка.пНаименованиеОрганизации, ВыборкаШапка.ОрганизацияИНН, ВыборкаШапка.ОрганизацияКПП);
			
			СоставАдреса = Новый Массив;
			СоставАдреса.Добавить(АдресОрганизации);
			Если ЗначениеЗаполнено(ТелефонОрганизации) Тогда
				СоставАдреса.Добавить(СтрШаблон(НСтр("ru = 'тел.:%1'"), ТелефонОрганизации));
			КонецЕсли;
			СтруктураОбластьШапка.пАдресТелефон = СтрСоединить(СоставАдреса, ", ");
			
			СоставНаименования = Новый Массив;
			СоставНаименования.Добавить(ВыборкаШапка.КонтрагентНаименование);
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентИНН) Тогда
				СоставНаименования.Добавить(НСтр("ru = 'ИНН'"));
				СоставНаименования.Добавить(ВыборкаШапка.КонтрагентИНН);
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентКПП) Тогда
				СоставНаименования.Добавить(НСтр("ru = 'КПП'"));
				СоставНаименования.Добавить(ВыборкаШапка.КонтрагентКПП);
			КонецЕсли;
			СтруктураОбластьШапка.пЗаказчик = СтрСоединить(СоставНаименования, " ");
			
			Если ЗначениеЗаполнено(ВыборкаШапка.СФСсылка) Тогда
				СуффиксНомера = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.СФСсылка,ВыборкаШапка.НомерСФ);
			Иначе
				СуффиксНомера = ВыборкаШапка.НомерСтроки;
			КонецЕсли;
			НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Начисление,ВыборкаШапка.НомерНачисления);
			СтруктураОбластьШапка.пДата  = Формат(ВыборкаШапка.пДата, "ДЛФ=DD");
			СтруктураОбластьШапка.пНомер = СтрШаблон(НСтр("ru = '%1/%2'"), НомерДокумента, СуффиксНомера);
			
			ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаШапка);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			ТекстНДС = Новый Структура("пТекстНДС");
			Если ВыборкаШапка.СуммаВключаетНДС Тогда
				ТекстНДС.пТекстНДС = НСтр("ru = 'В том числе НДС'");
			Иначе
				ТекстНДС.пТекстНДС = НСтр("ru = 'Итого НДС'");
			КонецЕсли;
			ОбластьИтоги.Параметры.Заполнить(ТекстНДС);
			ОбластьИтоги.Параметры.Заполнить(ВыборкаШапка);
			
			ТабличныйДокумент.Вывести(ОбластьИтоги);
			
			СтруктураОбластьПодвал = Новый Структура("пИтогВсегоПрописью,пИтогНДСПрописью");
			СтруктураОбластьПодвал.пИтогВсегоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогВсего, ВыборкаШапка.ВалютаДокумента);
			СтруктураОбластьПодвал.пИтогНДСПрописью   = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогНДС, ВыборкаШапка.ВалютаДокумента);
			СтруктураОбластьПодвал.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Истина, ВыборкаШапка.пДата));
			
			ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
			
			СтруктураОбластьПодвал.Вставить("РуководительДолжность", ДанныеПодписанта.Должность);
			
			ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
		КонецЦикла;
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаОснование.ДокументОснование);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьВедомостьНачисленийЗаУслугу(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НачислениеДоходов.Организация,
				   |	НачислениеДоходов.Ссылка,
				   |	НачислениеДоходов.ИнформацияОНачислении,
				   |	НачислениеДоходов.Руководитель,
	               |	НачислениеДоходов.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	НачислениеДоходов.Номенклатура.Представление КАК Услуга,
	               |	НачислениеДоходов.Начисления.(
	               |		НомерСтроки КАК НомерСтроки,
	               |		Контрагент КАК КонтрагентСсылка,
	               |		ВЫБОР
	               |			КОГДА НачислениеДоходов.Начисления.Контрагент.Наименование = """"
	               |				ТОГДА НачислениеДоходов.Начисления.Контрагент.НаименованиеСокращенное
	               |			ИНАЧЕ НачислениеДоходов.Начисления.Контрагент.Наименование
	               |		КОНЕЦ КАК Контрагент,
	               |		СуммаНДС,
	               |		Всего КАК Всего,
	               |		Сумма КАК Сумма
	               |	),
	               |	НачислениеДоходов.СуммаВключаетНДС,
	               |	НачислениеДоходов.Организация.ИНН КАК ИНН,
	               |	НачислениеДоходов.Дата,
	               |	НачислениеДоходов.Номер,
	               |	НачислениеДоходов.ВалютаДокумента
	               |ИЗ
	               |	Документ.НачислениеДоходов КАК НачислениеДоходов
	               |ГДЕ
	               |	НачислениеДоходов.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НачислениеДоходов.ПФ_MXL_ВедомостьНачисленийЗаУслугу");
	
	ОбластьМакетаЗаголовок         = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаВидУслуги         = Макет.ПолучитьОбласть("ВидУслуги");
	ОбластьМакетаШапкаТаблицы      = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьМакетаСтрока            = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтоги             = Макет.ПолучитьОбласть("Итоги");
	ОбластьМакетаПодвал            = Макет.ПолучитьОбласть("Подвал");
					   
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
        ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(Выборка);
		
		//НастройкаПечатиНомера
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаЗаголовок,"Номер",Выборка.Номер,Выборка.Ссылка,Неопределено, Истина);
		//
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		ДопДанныеПечати = Новый Структура;
		ДопДанныеПечати.Вставить("Дата",Формат(Выборка.Дата, "ДЛФ = Д")); 
		ДопДанныеПечати.Вставить("АдресТелефон","Адрес (юридический): "+  АдресОрганизации + "," + Символы.ПС + "Телефоны: "+ТелефонОрганизации);
        ДопДанныеПечати.Вставить("НаименованиеОрганизации", "" + Выборка.НаименованиеОрганизации + ", ИНН: " + Выборка.ИНН);

		ОбластьМакетаЗаголовок.Параметры.Заполнить(ДопДанныеПечати);
				
		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
		
		ОбластьМакетаВидУслуги.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(ОбластьМакетаВидУслуги);
		
		ОбластьМакетаШапкаТаблицы.Параметры.Заполнить(Выборка);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаШапкаТаблицы);
		
		ИтогСумма = 0; ИтогВсего = 0; ИтогНДС = 0;
		ВыборкаНачислений = Выборка.Начисления.Выбрать();
		Пока ВыборкаНачислений.Следующий() Цикл
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаНачислений);
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			ИтогСумма = ИтогСумма + ВыборкаНачислений.Сумма;
			ИтогВсего = ИтогВсего + ВыборкаНачислений.Всего;
			ИтогНДС   = ИтогНДС + ВыборкаНачислений.СуммаНДС;
		КонецЦикла;	
		СтруктураИтогов = Новый Структура("ИтогСумма,ИтогНДС,ИтогВсего",ИтогСумма,ИтогНДС,ИтогВсего);
		СтруктураИтогов.Вставить("ТекстНДС",?(Выборка.СуммаВключаетНДС, "В том числе НДС", "Итого НДС"));
		ОбластьМакетаИтоги.Параметры.Заполнить(СтруктураИтогов);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаИтоги);
		
		ОбластьМакетаПодвал.Параметры.Заполнить(Выборка);
		
		СтруктураОбластьПодвал = Новый Структура("ИтогВсегоПрописью,ИтогНДСПрописью");
		СтруктураОбластьПодвал.ИтогВсегоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ИтогВсего, Выборка.ВалютаДокумента);
		СтруктураОбластьПодвал.ИтогНДСПрописью 	 = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ИтогНДС, 	Выборка.ВалютаДокумента);
		
		СтруктураОбластьПодвал.Вставить("ФИОИсполнитель",  Справочники.Сотрудники.ФамилияИО(Выборка.Руководитель, Истина, Выборка.Дата));
		
		ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", Выборка.Руководитель, Выборка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
		
		СтруктураОбластьПодвал.Вставить("ДолжностьИсполнитель", ДанныеПодписанта.Должность);
		
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
