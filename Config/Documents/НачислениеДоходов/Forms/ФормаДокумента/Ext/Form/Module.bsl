&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияОтразитьВГрафикеИсполненияДоговора");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ВестиПланГрафикИсполнения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не ведется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДоговоров(Договора)
	
	Если ТипЗнч(Договора) = Тип("СправочникСсылка.Договоры") Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Договора);
	Иначе
		Ссылки = Договора;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ссылки, "Ссылка,ВидДоговора,ВестиПланГрафикИсполнения");
	
КонецФункции

&НаСервере
Функция ПоместитьКонтрагентовВХранилище()

	ТаблицаКонтрагентов = Объект.Начисления.Выгрузить(,"Контрагент,ДоговорКонтрагента");
	Возврат ПоместитьВоВременноеХранилище(ТаблицаКонтрагентов);

КонецФункции

&НаСервере
Процедура ПриИзмененииНоменклатуры()
	
	ЦенаЗаполненаПоНоменклатуре = Ложь;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура,"ТипНоменклатуры") = Перечисления.ТипыНоменклатуры.Госуслуга Тогда 
					
		ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, Объект.Дата));
		
		Объект.КодБКНалога = ГосУслуги.ПолучитьКодБК(Объект.Организация, ХарактеристикиГосуслуги.КПС, ХарактеристикиГосуслуги.КЭК, ХарактеристикиГосуслуги.НачалоДействияКПС, Объект.ИФО);   
		
		Объект.КодОКАТО 				= ХарактеристикиГосуслуги.КодОКАТО;

		ПолеВводаПоказательОснования 	= ХарактеристикиГосуслуги.ПоказательОснования;
		ПолеВводаПоказательТипа 		= ХарактеристикиГосуслуги.ПоказательТипа;
		ПолеВводаСтатусСоставителя		= ХарактеристикиГосуслуги.СтатусСоставителя;
		ПолеВводаПоказательПериода		= ХарактеристикиГосуслуги.ПоказательПериода;
		
		ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура("СтатусСоставителя,ПоказательОснования,ПоказательТипа", ПолеВводаСтатусСоставителя,ПолеВводаПоказательОснования,ПолеВводаПоказательТипа)));
		
		ПолеВводаГодПериода  			= "";
		ПолеВводаДатаПериода 			= "";
		ПолеВводаКодТаможенногоОргана 	= "";
		ПолеВводаНомерПериода 			= "";
		
		ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
	    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
		БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, Ложь, Объект.Дата, ЗначенияРеквизитов);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
		БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);	
			
		СтараяЦена = Объект.Цена;
		Объект.Цена = ХарактеристикиГосуслуги.Стоимость;
		Если ЗначениеЗаполнено(Объект.Цена) Тогда
			ЦенаЗаполненаПоНоменклатуре = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	СтараяСтавкаНДС  = Объект.СтавкаНДС;
	Объект.СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура,"СтавкаНДС");
	Если СтараяСтавкаНДС <> Объект.СтавкаНДС Тогда
		Для Каждого Строка Из Объект.Начисления Цикл					
			РассчитатьСтроку(Строка, "Сумма", Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);			
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииТипаЦен()
	
	Если ЦенаЗаполненаПоНоменклатуре Тогда
		ЦенаЗаполненаПоНоменклатуре = Ложь;
	Иначе
		
		Если НЕ (ЗначениеЗаполнено(Объект.Номенклатура) И ЗначениеЗаполнено(Объект.ТипЦены)) Тогда
			Возврат;
		КонецЕсли;
		
		СтараяЦена = Объект.Цена;
		СтруктураПараметров = Новый Структура("Организация,ТипЦены,ДатаЦены,Номенклатура", Объект.Организация, Объект.ТипЦены, Объект.Дата, Объект.Номенклатура);
		Объект.Цена = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
			
	КонецЕсли;
	
	Если НЕ (СтараяЦена<>Объект.Цена И ЗначениеЗаполнено(Объект.Цена)) Тогда
		Возврат; // Цена не изменилась или цена не заполнена, пересчитывать не нужно.
	КонецЕсли;
	
	Если Объект.Начисления.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Табличная часть документа содержит записи.
							|Пересчитать суммы табличной части по новой цене?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Да, пересчитать");
	Кнопки.Добавить(КодВозвратаДиалога.Нет, "Нет, не пересчитывать");

	ПоказатьВопрос(Новый ОписаниеОповещения("ПриИзмененииТипаЦенЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииТипаЦенЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСуммы();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы()
	
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		СтрТЧ.Сумма = СтрТЧ.Количество*Объект.Цена;
		РассчитатьСтроку(СтрТЧ,"Сумма", Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьУчетаНДС()
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("СтавкаНДС");
	МассивЭлементов.Добавить("НачисленияСуммаНДС");
	МассивЭлементов.Добавить("НачисленияВсего");
	МассивЭлементов.Добавить("НачисленияЗаполнитьПорядокВыпискиСФ");
	МассивЭлементов.Добавить("НачисленияПорядокВыпискиСФ");
	МассивЭлементов.Добавить("УправлениеСчетФактурами");
	МассивЭлементов.Добавить("ИтогоНДС");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Объект.УчитыватьНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьНадписьНДСВалюта(Форма)
	
	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, УчитыватьНДС, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, ИмяРеквизита, УчитыватьНДС, СтавкаНДС, СуммаВключаетНДС)
	
	Если УчитыватьНДС Тогда
		
		Если ИмяРеквизита = "Сумма" Тогда 
			
			СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", СтрокаТЧ.Сумма, СтавкаНДС);
			СтрокаТЧ.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
			СтруктураПараметров.Вставить("СуммаНДС", СтрокаТЧ.СуммаНДС);
			СтрокаТЧ.Всего    = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
			
		ИначеЕсли ИмяРеквизита = "СуммаНДС" Тогда 
			
			СтруктураПараметров = Новый Структура("Сумма, СуммаНДС", СтрокаТЧ.Сумма, СтрокаТЧ.СуммаНДС);
			СтрокаТЧ.Всего    = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
			
		ИначеЕсли ИмяРеквизита = "Всего" Тогда 
			СтруктураПараметров = Новый Структура("Всего, СтавкаНДС, СуммаНДС", СтрокаТЧ.Всего, СтавкаНДС, СтрокаТЧ.СуммаНДС);
			СтруктураДанных = УправлениеНФАКлиентСервер.ПриИзмененииВсегоТабЧасти(СтруктураПараметров, "Сумма, СуммаНДС", СуммаВключаетНДС);
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураДанных);
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТЧ.СуммаНДС 	= 0;
		СтрокаТЧ.Всего	 	= СтрокаТЧ.Сумма;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте()
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, Ложь, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, Объект[ИмяПоказателя]);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));
	
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаТЧНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ТекДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ТекДанные<>Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ТекДанные, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНалоговыеРевизитыТЧ()
	
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		Результат = Новый Структура;
		Если СтрТЧ.ПоказательНомера <> "0" Тогда
			Результат.Вставить("ПолеВводаПоказательНомера", СтрТЧ.ПоказательНомера);
		Иначе
			Результат.Вставить("ПолеВводаПоказательНомера", "");
		КонецЕсли;	
	
		Если ЗначениеЗаполнено(СтрТЧ.ПоказательДаты) И СокрЛП(СтрТЧ.ПоказательДаты) <> "0" Тогда
			СоставДаты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(СтрТЧ.ПоказательДаты), ".");
			Если СоставДаты.Количество() = 3 
				И ЗначениеЗаполнено(СоставДаты[0])
				И ЗначениеЗаполнено(СоставДаты[1])
				И ЗначениеЗаполнено(СоставДаты[2]) Тогда
				Попытка
					Результат.Вставить("ПолеВводаПоказательДаты", Дата(СоставДаты[2], СоставДаты[1], СоставДаты[0]));
				Исключение
					Результат.Вставить("ПолеВводаПоказательДаты", "");
				КонецПопытки;
			Иначе
				Результат.Вставить("ПолеВводаПоказательДаты", "");
			КонецЕсли;
		Иначе
			Результат.Вставить("ПолеВводаПоказательДаты", "");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрТЧ,Результат);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораКонтрагентовСервер(Знач ВыбранноеЗначение)
	
	ТаблицаКонтрагентов = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресКонтрагентовВХранилище);
	
	ИсходныеДанные = Объект.Начисления.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("Контрагент,ДоговорКонтрагента");
	
	РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаКонтрагентов.ВыгрузитьКолонку("ДоговорКонтрагента")),
			"ВестиПланГрафикИсполнения");
	
	Объект.Начисления.Очистить();
	Для каждого СтрокаТаблицы Из ТаблицаКонтрагентов Цикл
		СтруктураПоиска = Новый Структура("Контрагент,ДоговорКонтрагента");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицы);
		НайденныеСтроки = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество()>0 Тогда
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НоваяСтрока = Объект.Начисления.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока);
				Если РеквизитыДоговоров[НайденнаяСтрока.ДоговорКонтрагента] <> Неопределено
					И РеквизитыДоговоров[НайденнаяСтрока.ДоговорКонтрагента].ВестиПланГрафикИсполнения Тогда
					НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора =
						Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		Иначе
			НоваяСтрока = Объект.Начисления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Сумма = Объект.Цена;
			РассчитатьСтроку(НоваяСтрока,"Сумма",Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);
			Если РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента] <> Неопределено
					И РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента].ВестиПланГрафикИсполнения Тогда
				НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора =
					Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;
	
	НачисленияЗаполнитьДобавленныеКолонки();
	
	//Электронные документы (акты)
	НастройкаДоступностиЭДО();
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(СтрТЧ.Контрагент);
		СтрТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		СтрТЧ.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	КонецЦикла;
	
КонецПроцедуры

