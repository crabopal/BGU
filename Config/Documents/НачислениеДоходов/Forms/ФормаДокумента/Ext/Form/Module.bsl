&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	КонецЕсли;
	
	Если НоваяСтрока И Копирование Тогда
		ТекущиеДанные.ИДСтроки = "";
		ТекущиеДанные.ИдентификаторЭД = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДоговорКонтрагента) Тогда
		
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные, 
			РеквизитыДоговоров(ТекущиеДанные.ДоговорКонтрагента));
		
		Если ТекущиеДанные.ВестиПланГрафикИсполнения Тогда
			ТекущиеДанные.ОтразитьВГрафикеИсполненияДоговора =
				ПредопределенноеЗначение("Перечисление.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
		//Электронные документы (акты)
		НастройкаДоступностиЭДО();
		
		ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(ТекущиеДанные.Контрагент);
		ТекущиеДанные.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		ТекущиеДанные.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДоговорКонтрагентаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДоговорКонтрагента) Тогда
		
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные, 
			РеквизитыДоговоров(ТекущиеДанные.ДоговорКонтрагента));
		
		Если ТекущиеДанные.ВестиПланГрафикИсполнения Тогда
			ТекущиеДанные.ОтразитьВГрафикеИсполненияДоговора =
				ПредопределенноеЗначение("Перечисление.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСуммаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	РассчитатьСтроку(ТекущаяСтрока, "Сумма", Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСуммаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	РассчитатьСтроку(ТекущаяСтрока, "СуммаНДС", Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКоличествоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * Объект.Цена;
	РассчитатьСтроку(ТекущаяСтрока, "Сумма", Объект.УчитыватьНДС, Объект.СтавкаНДС, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

&НаСервере
Процедура НачисленияЗаполнитьДобавленныеКолонки()
	
	РеквизитыДоговоров = РеквизитыДоговоров(Объект.Начисления.Выгрузить(,"ДоговорКонтрагента").ВыгрузитьКолонку("ДоговорКонтрагента"));
	
	Для Каждого СтрокаТаблицы Из Объект.Начисления Цикл
		
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы, РеквизитыДоговоров);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы, РеквизитыДоговоров = Неопределено)
	
	Если ТипЗнч(РеквизитыДоговоров) = Тип("Соответствие")
		И РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента] <> Неопределено Тогда
		СтрокаТаблицы.ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента].ВестиПланГрафикИсполнения;
	Иначе
		СтрокаТаблицы.ВестиПланГрафикИсполнения = Ложь;
	КонецЕсли;
	
	СтрокаТаблицы.ЗаголовокОформлятьЭД = НСтр("ru = 'Передача по ЭДО:'");
	СтрокаТаблицы.ЗаголовокПередаточныйДокументЭД = НСтр("ru = 'Передаточный документ:'");
	
	СтрокаТаблицы.ЗаголовокПросмотретьЭД = НСтр("ru = 'Электронный документ:'");
	СтрокаТаблицы.ЗаголовокСостояниеЭД = НСтр("ru = 'Состояние ЭД:'");
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияОформлятьЭДПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.ДоступностьЭДО Тогда
		ТекущаяСтрока.ОформлятьЭД = Ложь;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УправлениеСчетамиФактурамиПечати(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ не записан. Сначала следует записать документ!'"));
		
	ИначеЕсли ЭтаФорма.Модифицированность Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ был изменен. Сначала следует записать документ!'"));
		
	ИначеЕсли Объект.ПометкаУдаления Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Счет-фактуры нельзя вводить на основании документа, помеченного на удаление!'"));
		
	Иначе
		
		ПараметрыФормы = Новый Структура("Документ, ТиповаяОперация", Объект.Ссылка, Неопределено);
		
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
		ПараметрыФормы.Вставить("Дата", Объект.Дата);

		ПараметрыФормы.Вставить("КФО",  ПредопределенноеЗначение("Перечисление.КВД.Внебюджет")); 
		
		ОткрытьФорму("ОбщаяФорма.ФормаУправлениеСчетФактурамиПечати", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПередаточныеДокументыДляЭДО(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Реквизиты лицевого счета"" на закладке ""ЭДО с контрагентами"". Следует заполнить этот реквизит и повторно нажать кнопку ""Создать передаточные документы для ЭДО"".'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат;
	КонецЕсли;
	
	СоздатьПередаточныеДокументыДляЭДОНаСервере();
КонецПроцедуры

