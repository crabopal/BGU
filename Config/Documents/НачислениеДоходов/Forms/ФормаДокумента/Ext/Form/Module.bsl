	ПоказатьВводЗначения(Новый ОписаниеОповещения("ЗаполнитьПорядокВыпискиСФЗавершение", ЭтотОбъект, 
	Новый Структура("ПорядокВыпСФ", ПорядокВыпСФ)), 
	ПорядокВыпСФ,Нстр("ru='Укажите порядок выписки счет-фактуры'"),Тип("ПеречислениеСсылка.ПорядокВыпискиСФЗаУслуги"));
	
