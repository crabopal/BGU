#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("Студент") И ДанныеЗаполнения.Свойство("Договор") Тогда
			
			ТекущиеПлательщикиПоДоговору = РаботаСоСтудентами.СписокПлательщиковПоДоговору(
				ДанныеЗаполнения.Договор,
				ДанныеЗаполнения.Студент);
			
			Если ТекущиеПлательщикиПоДоговору.Количество() = 0 Тогда
				// По умолчанию 1 плательщик с долей оплаты 100%.
				НоваяСтрока = Плательщики.Добавить();
				НоваяСтрока.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Студент, "Контрагент");
				НоваяСтрока.ДоляОплаты = 100;
				НоваяСтрока.ПорядокВыпискиСФ = Перечисления.ПорядокВыпискиСФЗаУслуги.Сводно;
			Иначе
				Для Каждого Плательщик Из ТекущиеПлательщикиПоДоговору Цикл
					НоваяСтрока = Плательщики.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Плательщик, "Контрагент,ДоляОплаты,ПорядокВыпискиСФ");
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого СтрокаТЧ Из Плательщики Цикл
		
		ПроверитьРеквизитТЧ(СтрокаТЧ, "Контрагент", "Контрагент",, Отказ);
		ПроверитьРеквизитТЧ(СтрокаТЧ, "ПорядокВыпискиСФ", "Порядок выписки СФ",, Отказ);
		ПроверитьРеквизитТЧ(СтрокаТЧ, "ДоляОплаты", "Доля оплаты",, Отказ);
		 
	КонецЦикла;
	
	ПроверитьДублиСтрок(Отказ);
	
	Если Плательщики.Итог("ДоляОплаты") <> 100 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Колонка ""%1"" заполнена некорректно. Общий итог по колонке ""%1"" по всем плательщикам не равен 100 процентам.
			|Итоговый процент оплаты по договору: %2. Скорректируйте значения в колонке ""%1"".'"),
				НСтр("ru = '% оплаты'"),
				Плательщики.Итог("ДоляОплаты"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.Плательщики",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.РегистрацияПлательщиковПоДоговоруОбразование.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПлательщикиПоДоговоруОбразование");
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиСтрок(Отказ)
	
	ШаблонТекстДублей = НСтр("ru = 'Контрагент ""%1"" указан в списке более одного раза!'");
		
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Плательщики.НомерСтроки,
	               |	Плательщики.Контрагент
	               |ПОМЕСТИТЬ ТаблицаПлательщиков
	               |ИЗ
	               |	&Плательщики КАК Плательщики
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ТаблицаПлательщиков.НомерСтроки) КАК НомерСтроки,
	               |	ТаблицаПлательщиков.Контрагент
	               |ИЗ
	               |	ТаблицаПлательщиков КАК ТаблицаПлательщиков
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаПлательщиков.Контрагент
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(*) > 1";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Плательщики", Плательщики.Выгрузить(, "НомерСтроки, Контрагент")) ;
	
	ВыборкаДублей = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДублей.Следующий() Цикл
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстДублей,
			ВыборкаДублей.Контрагент);
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Плательщики", ВыборкаДублей.НомерСтроки, "Контрагент");
		ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект, Поле,, Отказ);
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПроверитьРеквизитТЧ(СтрокаТЧ, ИмяРеквизита, Представление, ИмяРеквизитаПривязки = Неопределено, Отказ)
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]) Тогда
				
		ТекстОшибки = НСтр("ru='Не заполнена колонка """ + Представление + """ в строке " + СтрокаТЧ.НомерСтроки + " списка ""Плательщики""'");
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Плательщики", СтрокаТЧ.НомерСтроки, ?(ИмяРеквизитаПривязки = Неопределено, ИмяРеквизита, ИмяРеквизитаПривязки));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, Поле,, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли