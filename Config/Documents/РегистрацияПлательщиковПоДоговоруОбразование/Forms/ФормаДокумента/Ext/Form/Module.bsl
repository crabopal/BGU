#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВопросОЗаменеДоговора(ОтветНаВопрос, ДопПараметры) Экспорт
	Если ОтветНаВопрос <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуСозданиеДоговора();
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОткрытьФормуСозданиеДоговора()
	
	ЗначенияЗаполнения = Новый Структура("Организация, Контрагент, ВидДоговора");
	ЗначенияЗаполнения.Организация = Объект.Организация;
	ЗначенияЗаполнения.Контрагент = КонтрагентСсылка;
	ЗначенияЗаполнения.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем");
	ДополнительныеЗначенияЗаполнения = Новый Структура("ВидОбязательства, Наименование, КонтрольЗаполненияРабочегоНаименования");
	ДополнительныеЗначенияЗаполнения.ВидОбязательства = "Договор на оплату за обучение";
	ДополнительныеЗначенияЗаполнения.Наименование = "Договор на обучение " + Объект.Студент;
	ДополнительныеЗначенияЗаполнения.КонтрольЗаполненияРабочегоНаименования = Ложь;
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		// По долгосрочным договорам студентов графики ведутся автоматически, не нужно вводить дополнительных данных,
		// поэтому по умолчанию в договоре со студентом установим ведение графиков.
		ДополнительныеЗначенияЗаполнения.Вставить("ВестиГрафикПлатежей", Истина);
		ДополнительныеЗначенияЗаполнения.Вставить("ВестиПланГрафикИсполнения", Истина);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",						ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ДополнительныеЗначенияЗаполнения",			ДополнительныеЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ЗаполнятьДополнительныеЗначенияЗаполнения",Истина);
	ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов",				"Организация,ВидДоговора");
	ПараметрыФормы.Вставить("ИменаНевидимыхЭлементов",					"ВвестиИзменитьГрафикиИсполнения");
	
	ОткрытьФорму("Справочник.Договоры.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СтудентПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Студент) Тогда
		КонтрагентСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Студент, "Контрагент");
	Иначе
		КонтрагентСсылка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаДоговора(ДоговорСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка,"Контрагент");
	
КонецФункции

&НаСервере
Функция ПорядокВыпискиСФПоКонтрагенту(ТекКонтрагент)
	
	ТекПорядокВыпискиСФ = Неопределено;
	ВидКонтрагента =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекКонтрагент, "ВидКонтрагента");
	
	Если ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ТекПорядокВыпискиСФ = Перечисления.ПорядокВыпискиСФЗаУслуги.НаПлательщика;
	ИначеЕсли ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		ТекПорядокВыпискиСФ = Перечисления.ПорядокВыпискиСФЗаУслуги.Сводно;
	КонецЕсли; 
	
	Возврат ТекПорядокВыпискиСФ;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьДолиОплаты()
	
	Если Объект.Плательщики.Итог("СуммаОплаты") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивКоэффициентов = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.Плательщики Цикл
		МассивКоэффициентов.Добавить(СтрокаТаблицы.СуммаОплаты);
	КонецЦикла;
	
	МассивДолиОплаты = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		100, МассивКоэффициентов, 4); // Распределим 100% пропорционально введенным суммам оплаты.
	Для Инд = 0 По МассивКоэффициентов.Количество() - 1 Цикл
		СтрокаТаблицы = Объект.Плательщики[Инд];
		СтрокаТаблицы.ДоляОплаты = ?(МассивДолиОплаты = Неопределено, 0, МассивДолиОплаты[Инд]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыОплаты()
	
	МассивКоэффициентов = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.Плательщики Цикл
		МассивКоэффициентов.Добавить(СтрокаТаблицы.ДоляОплаты);
	КонецЦикла;
	
	МассивСуммОплаты = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		Объект.Плательщики.Итог("СуммаОплаты"), МассивКоэффициентов); // Распределим общую сумму оплаты пропорционально введенным долям оплаты.
	Для Инд = 0 По МассивКоэффициентов.Количество() - 1 Цикл
		СтрокаТаблицы = Объект.Плательщики[Инд];
		СтрокаТаблицы.СуммаОплаты = ?(МассивСуммОплаты = Неопределено, 0, МассивСуммОплаты[Инд]);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
		
	Если Объект.Плательщики.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
				
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		
	КонецЕсли; 
	
КонецПроцедуры

#Область ПроцедурыИФункцииПодсистемыСвойства

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
