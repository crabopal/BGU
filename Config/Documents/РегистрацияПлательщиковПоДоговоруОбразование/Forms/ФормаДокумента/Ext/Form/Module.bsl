
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ЗначениеЗаполнено(Объект.Студент) Тогда
		КонтрагентСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Студент, "Контрагент");
	КонецЕсли;
	
	УстановитьПредупреждение();

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
		
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если ТипЗнч(НовыйОбъект) = Тип("СправочникСсылка.Договоры") Тогда
		
		// Записан новый договор, созданный для плательщика по обучению
		Объект.Договор = НовыйОбъект;
		Модифицированность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
		
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Оповестить("ОбновитьДанныеСтудента");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Объект.Плательщики.Очистить();
	УстановитьПредупреждение();

КонецПроцедуры

&НаКлиенте
Процедура СтудентПриИзменении(Элемент)
	
	СтудентПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	Если НЕ Объект.Договор.Пустая() И Объект.Плательщики.Количество() = 0 Тогда
		
		НоваяСтрокаПлательщики = Объект.Плательщики.Добавить();
		НоваяСтрокаПлательщики.Контрагент = ПолучитьКонтрагентаДоговора(Объект.Договор);
		НоваяСтрокаПлательщики.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно");
		НоваяСтрокаПлательщики.ДоляОплаты = 100;
		
	КонецЕсли;
	
	УстановитьПредупреждение();
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПлательщики

&НаКлиенте
Процедура ПлательщикиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ПересчитатьДолиОплаты();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиПослеУдаления(Элемент)
	
	ПересчитатьДолиОплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиСуммаОплатыПриИзменении(Элемент)
	
	ПересчитатьДолиОплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиДоляОплатыПриИзменении(Элемент)
	
	ПересчитатьСуммыОплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Плательщики.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекКонтрагент = ТекущиеДанные.Контрагент;
	ТекущиеДанные.ПорядокВыпискиСФ = ПорядокВыпискиСФПоКонтрагенту(ТекКонтрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиПриИзменении(Элемент)
	УстановитьПредупреждение();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДоговорОбучения(Команда)
	
	Отказ = Ложь;
	
	Если Объект.Организация.Пустая() Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Организация"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,	"Объект.Организация", , Отказ);
		
	КонецЕсли;
	
	Если Объект.Студент.Пустая() Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Студент"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,	"Объект.Студент", , Отказ);
		
	ИначеЕсли НЕ Объект.Договор.Пустая() Тогда
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заменить договор'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ТекстВопроса = НСтр("ru =  'Заменить текущий договор на вновь созданный?'");
		
		Оповещение = Новый ОписаниеОповещения("ВопросОЗаменеДоговора", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Отмена);

		Возврат;
		
	КонецЕсли; 
		
	Если НЕ Отказ Тогда
		
		ОткрытьФормуСозданиеДоговора();

	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
