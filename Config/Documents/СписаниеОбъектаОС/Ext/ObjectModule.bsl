#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаСписанияСБухУчета) Тогда
		ЭтотОбъект.ДатаСписанияСБухУчета = ЭтотОбъект.Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивУдаляемыхРеквизитов = Новый Массив;
	
	СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Ссылка);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаОС);
	
	Если НЕ СвойстваСчета.УчетПоКПС Тогда
		МассивУдаляемыхРеквизитов.Добавить("КПС");
	КонецЕсли;
	Если Не (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчета.УчетПоПодразделениям) Тогда
		МассивУдаляемыхРеквизитов.Добавить("Подразделение");
	КонецЕсли;
	Если ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
		МассивУдаляемыхРеквизитов.Добавить("ЦМО");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивУдаляемыхРеквизитов);
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		
		ПараметрыУчетаОС = УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПределыОС(НачалоГода(Дата));
		Если Сумма <= ПараметрыУчетаОС.ПервыйПределОС Тогда
			ТекстСообщения = НСтр("ru='Документ предназначен для отражения выбытия объекта ОС стоимостью более %1 рублей'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПараметрыУчетаОС.ПервыйПределОС);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.ОсновноеСредство",,Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Сумма = 0;
	СуммаАмортизации = 0;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли