Процедура Подключаемый_ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииТиповойОперации(Элемент)
	
	ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

	БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтаФорма, Команда);	

КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиент.ЗапроситьИзменениеДатыСписанияСБухУчета(Объект);
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦМОПриИзменении(Элемент)
	ОбнулитьСуммы();
КонецПроцедуры

&НаКлиенте
Процедура КФОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   Объект.Дата,
											   ,
											   Объект.КПС);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	ОбнулитьСуммы();
КонецПроцедуры

&НаКлиенте
Процедура КПСПриИзменении(Элемент)
	ОбнулитьСуммы();
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ПараметрыФормы = ОбщиеПараметрыВыбораОбъектаОС();
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ОсновноеСредство);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Организация", Объект.Организация));
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	ОсновноеСредствоПриИзмененииНаСервере();
	
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	УстановитьОбязательностьИнвНомера();
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере()
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.ОсновноеСредство, Объект.Ссылка);
	Если ЗначениеЗаполнено(ДанныеОбъектаОС.СчетУчета) Тогда
		Объект.СчетУчета = ДанныеОбъектаОС.СчетУчета;
	Иначе
		Объект.СчетУчета = ДанныеОбъектаОС.СчетВложений;
	КонецЕсли;
	
	ЗаполнитьРеквизитыФормыПоОбъектуОС(ЭтаФорма, Объект);
	
	Если НЕ НеВсеРеквизитыДляИнвНомераЗаполнены(ЭтаФорма, Объект, Ложь) Тогда
		
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
		ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "ОсновноеСредство, Организация, ЦМО");
		
		ДанныеИнвентарногоНомера = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыПолученияОстатков);
		Объект.ИнвентарныйНомер = ДанныеИнвентарногоНомера.ИнвентарныйНомер;
		Если Не ЗначениеЗаполнено(Объект.ЦМО) ТОгда
			Объект.ЦМО = ДанныеИнвентарногоНомера.ЦМО;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ НеВсеРеквизитыДляЗаполненияЗаполнены(ЭтаФорма, Объект, Ложь) Тогда
		РассчитатьБалансовуюСтоимостьИАмортизацию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.ЦМО) Тогда
		ТекстСообщения = НСтр("ru='Не выбран МОЛ/Место хранения'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ЦМО");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	СписокСостояний = Новый СписокЗначений;
	СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
	ПараметрыФормы = Новый Структура("Отбор, НаДату, ТекущаяСтрока",
									Новый Структура("Владелец, ОС, Состояние, ЦМО",
													Объект.Организация,
													Объект.ОсновноеСредство,
													СписокСостояний,
													Объект.ЦМО),
									Объект.Дата,
									Объект.ИнвентарныйНомер);
	Если НЕ Объект.Ссылка.Пустая() Тогда
		ПараметрыФормы.Вставить("ГраницаОтбора", Объект.Ссылка);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерПриИзменении(Элемент)
	
	Если НЕ НеВсеРеквизитыДляЗаполненияЗаполнены(ЭтаФорма, Объект) Тогда
		РассчитатьБалансовуюСтоимостьИАмортизацию();
	КонецЕсли;
	
КонецПроцедуры

