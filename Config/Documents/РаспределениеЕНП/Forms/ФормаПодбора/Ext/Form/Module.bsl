		СтрокаОстатка = ОстаткиРасчетовДетально.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОстатка, ВыборкаРасчетовДетально);
	КонецЦикла;
	
	ОстаткиРасчетов.Очистить();
	ВыборкаОстаткиРасчетов = РезультатЗапроса[НомераТаблиц.ОстаткиРасчетов].Выбрать();
