		КонецЕсли;
	КонецЦикла;
	
	ОстатокРасчетовВсего = ОстаткиРасчетов.Итог("ОстатокРасчетов");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиЕНП()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	(Организации.ГоловнаяОрганизация = &ГоловнаяОрганизация
		|			ИЛИ Организации.Ссылка = &ГоловнаяОрганизация)
		|	И НЕ Организации.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК ОстатокЕНП
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&НаДату,
		|			Счет = &СчетЕНП,
		|			,
		|			Организация В
		|				(ВЫБРАТЬ
		|					ВТОрганизации.Ссылка КАК Ссылка
		|				ИЗ
		|					ВТОрганизации КАК ВТОрганизации)) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	-ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			Регистратор = &Регистратор
		|				И Организация В
		|					(ВЫБРАТЬ
		|						ВТОрганизации.Ссылка КАК Ссылка
		|					ИЗ
		|						ВТОрганизации КАК ВТОрганизации)
		|				И Активность
		|				И СчетДт = &СчетЕНП
		|				И Период < &НаДату,
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			Регистратор = &Регистратор
		|				И Организация В
		|					(ВЫБРАТЬ
		|						ВТОрганизации.Ссылка КАК Ссылка
		|					ИЗ
		|						ВТОрганизации КАК ВТОрганизации)
		|				И Активность
		|				И СчетКт = &СчетЕНП
		|				И Период < &НаДату,
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|ИТОГИ
		|	СУММА(ОстатокЕНП)
		|ПО
		|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("НаДату", 	 КонецДня(ДатаОстаткиЕНП) + 1);
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", ГоловнаяОрганизация);
	Запрос.УстановитьПараметр("СчетЕНП", 	 СчетЕНП);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаИтоги = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаИтоги.Следующий();
		ОстатокЕНП = ВыборкаИтоги.ОстатокЕНП;
	КонецЕсли;
	
	ОбновитьЗначениеОстатокЕНППослеРаспределения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВПодобрано(ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ОчиститьПодборПоВидуНалога(ЭтотОбъект, ТекущиеДанные.ВидНалогаИлиПлатежа, ТекущиеДанные.Счет);

	Подобрано = 0;
	Для каждого СтрокаОстаткиДетально Из ОстаткиРасчетовДетально Цикл
		Если СтрокаОстаткиДетально.ВидНалогаИлиПлатежа = ТекущиеДанные.ВидНалогаИлиПлатежа
			И СтрокаОстаткиДетально.Счет = ТекущиеДанные.Счет Тогда

			СтрокаПодобрано = ПодобранныеРасчеты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПодобрано, СтрокаОстаткиДетально);
			СтрокаПодобрано.Сумма = СтрокаОстаткиДетально.ОстатокРасчетов;
			
			Подобрано = Подобрано + СтрокаПодобрано.Сумма;
			
			ОбновитьТекстОтражениеВУчете(СтрокаПодобрано);
			
		КонецЕсли;
	КонецЦикла;
	ТекущиеДанные.Подобрано = Подобрано;

	ОбновитьЗначениеПодобраноВсего(ЭтотОбъект);
	ОбновитьНумерациюСтрок(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПодобрано(ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	ОчиститьПодборПоВидуНалога(ЭтотОбъект, ТекущиеДанные.ВидНалогаИлиПлатежа, ТекущиеДанные.Счет);
	ОбновитьЗначениеПодобраноВсего(ЭтотОбъект);
	ОбновитьНумерациюСтрок(ЭтотОбъект);
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодбораДанныеСтроки(ТекущиеДанные)

    ПоместитьТаблицуОстаткиРасчетовДетальноВоВременноеХранилище(
		ТекущиеДанные.ВидНалогаИлиПлатежа,
		ТекущиеДанные.Счет);
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	ПараметрыОткрытияФормы.Вставить("Организация", 				Организация);
	ПараметрыОткрытияФормы.Вставить("ДатаДокумента", 			ДатаДокумента);
	ПараметрыОткрытияФормы.Вставить("ДатаОстаткиРасчетов", 		ДатаОстаткиРасчетов);
	ПараметрыОткрытияФормы.Вставить("ДатаОстаткиЕНП", 			ДатаОстаткиЕНП);
	ПараметрыОткрытияФормы.Вставить("ВидНалогаИлиПлатежа",		ТекущиеДанные.ВидНалогаИлиПлатежа);
	ПараметрыОткрытияФормы.Вставить("Счет",						ТекущиеДанные.Счет);
	ПараметрыОткрытияФормы.Вставить("КБК",						ТекущиеДанные.КБК);
	ПараметрыОткрытияФормы.Вставить("Ссылка",					Ссылка);
	ПараметрыОткрытияФормы.Вставить("ОстатокЕНП",				ОстатокЕНП);
	ПараметрыОткрытияФормы.Вставить("СчетЕНП",					СчетЕНП);
	ПараметрыОткрытияФормы.Вставить("ПодобраноВсего",			ПодобраноВсего);
	ПараметрыОткрытияФормы.Вставить("ГоловнаяОрганизация", 		ГоловнаяОрганизация);
	ПараметрыОткрытияФормы.Вставить("ЕстьУчетОбособленныхПодразделений", ЕстьУчетОбособленныхПодразделений);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработатьРезультатРедактированияСтроки", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РаспределениеЕНП.Форма.ФормаПодбораДанныеСтроки", ПараметрыОткрытияФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицуОстаткиРасчетовДетальноВоВременноеХранилище(Знач ВидНалогаИлиПлатежа, Знач Счет)
	
	Отбор = Новый Структура("ВидНалогаИлиПлатежа,Счет", ВидНалогаИлиПлатежа, Счет);
	ТаблицаПодбораПоВидуНалога = ОстаткиРасчетовДетально.Выгрузить(Отбор);
	
	СтрокиПодобрано = ПодобранныеРасчеты.НайтиСтроки(Отбор);

	ПоляОтбора = "ВидНалогаИлиПлатежа,НалогСборПлатеж,Счет,Субконто1,Субконто2,Субконто3,ИФО,Подразделение,КФО,КПС";
	Отбор = Новый Структура(ПоляОтбора);
	
	Для каждого СтрокаПодобрано Из СтрокиПодобрано Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаПодобрано);
		СтрокиОстатки = ТаблицаПодбораПоВидуНалога.НайтиСтроки(Отбор);
		Если СтрокиОстатки.Количество() > 0 Тогда
			СтрокиОстатки[0].Подобрано = СтрокиОстатки[0].Подобрано + СтрокаПодобрано.Сумма;
		Иначе
			СтрокаПодбора = ТаблицаПодбораПоВидуНалога.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПодбора, СтрокаПодобрано);
			СтрокаПодбора.Подобрано = СтрокаПодобрано.Сумма;
		КонецЕсли;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаПодбораПоВидуНалога, АдресВременногоХранилища);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатРедактированияСтроки(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = "ОК" Тогда
		
		ОбработатьРезультатРедактированияСтрокиНаСервере();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатРедактированияСтрокиНаСервере()
	
	ДанныеВозврата = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	ОчиститьПодборПоВидуНалога(ЭтотОбъект, ДанныеВозврата.ВидНалогаИлиПлатежа, ДанныеВозврата.Счет);
	ДобавитьПодборПоВидуНалога(ДанныеВозврата.ТаблицаПодбораПоВидуНалога,
		ДанныеВозврата.ВидНалогаИлиПлатежа, ДанныеВозврата.Счет);

	ОбновитьЗначениеПодобраноВсего(ЭтотОбъект);
	ОбновитьНумерациюСтрок(ЭтотОбъект);

	Модифицированность = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьПодборПоВидуНалога(Форма, ВидНалогаИлиПлатежа, Счет)
	
	ПодобранныеРасчеты = Форма.ПодобранныеРасчеты;
	ОстаткиРасчетов    = Форма.ОстаткиРасчетов;
	
	Отбор = Новый Структура("ВидНалогаИлиПлатежа,Счет", ВидНалогаИлиПлатежа, Счет);
	
	СтрокиКУдалению = ПодобранныеРасчеты.НайтиСтроки(Отбор);
	Для каждого Строка Из СтрокиКУдалению Цикл
		ПодобранныеРасчеты.Удалить(Строка);
	КонецЦикла;

	СтрокиКОчистке = ОстаткиРасчетов.НайтиСтроки(Отбор);
	Для каждого Строка Из СтрокиКОчистке Цикл
		Строка.Подобрано = 0;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодборПоВидуНалога(ТаблицаПодбораПоВидуНалога, ВидНалогаИлиПлатежа, Счет)
	
	Если ТаблицаПодбораПоВидуНалога.Итог("Подобрано") = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Для каждого Строка Из ТаблицаПодбораПоВидуНалога Цикл
		Если Строка.Подобрано = 0 Тогда
			Продолжить;		
		КонецЕсли;
		
		СтрокаПодобранныеРасчеты = ПодобранныеРасчеты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПодобранныеРасчеты, Строка);
		СтрокаПодобранныеРасчеты.Сумма = Строка.Подобрано;		
	
	КонецЦикла;
	
	Отбор = Новый Структура("ВидНалогаИлиПлатежа,Счет", ВидНалогаИлиПлатежа, Счет);
	СтрокиОстаткиРасчетов = ОстаткиРасчетов.НайтиСтроки(Отбор);
	Если СтрокиОстаткиРасчетов.Количество() > 0 Тогда
		СтрокиОстаткиРасчетов[0].Подобрано = ТаблицаПодбораПоВидуНалога.Итог("Подобрано");	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИсключитьИзСпискаНаРаспределение(ТекущиеДанные)
	
	СтруктураЗаписи = Новый Структура;
	
	СтруктураЗаписи.Вставить("Организация", 		Организация); 
	СтруктураЗаписи.Вставить("ВидНалогаИлиПлатежа",	ТекущиеДанные.ВидНалогаИлиПлатежа);
 	СтруктураЗаписи.Вставить("НеВключать",			Истина); 

	Попытка
		ИсключитьИзСпискаНаРаспределениеНаСервере(СтруктураЗаписи);
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	ОчиститьПодборПоВидуНалога(ЭтотОбъект, ТекущиеДанные.ВидНалогаИлиПлатежа, ТекущиеДанные.Счет);
	
	Если ТекущиеДанные.Подобрано = 0 И Не ПоказатьВсеРасчеты Тогда
		ОстаткиРасчетов.Удалить(ТекущиеДанные);
	КонецЕсли;
	
	ОбновитьЗначениеПодобраноВсего(ЭтотОбъект);
	ОбновитьНумерациюСтрок(ЭтотОбъект);
	Модифицированность = Истина;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИсключитьИзСпискаНаРаспределениеНаСервере(Знач СтруктураЗаписи)
	МенеджерЗаписи = РегистрыСведений.НастройкаСпискаПлатежиВСоставеЕНП.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);
	МенеджерЗаписи.Записать();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗначениеПодобраноВсего(Форма)
	Форма.ПодобраноВсего = Форма.ОстаткиРасчетов.Итог("Подобрано");
	ОбновитьЗначениеОстатокЕНППослеРаспределения(Форма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗначениеОстатокЕНППослеРаспределения(Форма)
	Форма.ОстатокЕНППослеРаспределения = Форма.ОстатокЕНП - Форма.ПодобраноВсего;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНумерациюСтрок(Форма)
	
	ПодобранныеРасчеты = Форма.ПодобранныеРасчеты;
	КоличествоСтрок = ПодобранныеРасчеты.Количество() - 1;
	Для ИндексСтроки = 0 По КоличествоСтрок Цикл
		ПодобранныеРасчеты[ИндексСтроки].НомерСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчете(ДанныеСтроки)
	
	ЕдиныйНалоговыйСчетКлиентСервер.ОбновитьТекстОтражениеВУчетеРаспределениеЕНП(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)

	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	
	ПараметрыФормы.Вставить("ВидимостьКФО", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Ложь);
	ПараметрыФормы.Вставить("ОбязательностьКПС", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);

	ПараметрыФормы.Вставить("Подразделение", ДанныеСтроки.Подразделение);
	ПараметрыФормы.Вставить("РежимОбязательноУказатьПодразделение", Истина);
	
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.Субконто1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.Субконто2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.Субконто3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Аналитика распределения единого налогового платежа'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение'"));
	
	ПараметрыФормы.Вставить("ЕстьНДС", 			 Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", 	 Неопределено);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьГоловнаяОрганизация()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГоловнаяОрганизация",
		"Видимость", ЕстьУчетОбособленныхПодразделений);

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодобранныеРасчетыПодразделение");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ПодобранныеРасчеты.УчетПоПодразделениям", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

#КонецОбласти