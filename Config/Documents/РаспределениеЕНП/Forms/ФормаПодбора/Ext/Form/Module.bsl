#Область ОписаниеПеременных

&НаКлиенте
Перем РезультатЗакрытия;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Организация 			 = Параметры.Организация;
	ДатаДокумента			 = Параметры.ДатаДокумента;
	ДатаОстаткиРасчетов		 = Параметры.ДатаДокумента;
	ДатаОстаткиЕНП			 = Параметры.ДатаДокумента;
	АдресВременногоХранилища = Параметры.АдресВременногоХранилища;
	Ссылка 					 = Параметры.Ссылка;
	СчетЕНП 				 = Параметры.СчетЕНП;
	
	Если Не ЗначениеЗаполнено(СчетЕНП) Тогда
		СчетЕНП = БухгалтерскийУчет.СчетПоКоду("303.14");
	КонецЕсли;
	
	ГоловнаяОрганизация 			  = РегламентированнаяОтчетность.ГоловнаяОрганизация(Организация);
	ЕстьУчетОбособленныхПодразделений = ЕстьУчетОбособленныхПодразделений();
	УстановитьВидимостьГоловнаяОрганизация();
	
	Заголовок = СтрШаблон(НСтр("ru = 'Подбор налогов в %1 %2 от %3'"),
		Ссылка.Метаданные().Представление(), Параметры.НомерДокумента, ДатаДокумента);
	
	ВосстановитьТаблицуПодобранныеРасчеты();
    ЗаполнитьОстаткиЕНП();
	ЗаполнитьОстаткиРасчетов();
	ОбновитьЗначениеПодобраноВсего(ЭтотОбъект);

	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И РезультатЗакрытия = Неопределено Тогда
		Отказ = Истина;
		ВопросПередЗакрытиемПеренестиДанныеАсинх();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаОстаткиРасчетовНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыбратьДатуОстатковРасчетовАсинх();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОстаткиЕНПНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыбратьДатуОстатковЕНПАсинх();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеРасчетыПриИзменении(Элемент)
	ЗаполнитьОстаткиРасчетов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОстаткиРасчетов

&НаКлиенте
Процедура ОстаткиРасчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Поле.Имя = "ОстаткиРасчетовКартинкаПереместитьВПраво" Тогда
		ПеренестиВПодобрано(ТекущиеДанные);
	Иначе
		ОткрытьФормуПодбораДанныеСтроки(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстаткиРасчетовВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	Для каждого ИдентификаторСтроки Из Значение Цикл
		ТекущиеДанные = ОстаткиРасчетов.НайтиПоИдентификатору(ИдентификаторСтроки);	
		ПеренестиВПодобрано(ТекущиеДанные);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодобранныеРасчеты

&НаКлиенте
Процедура ПодобранныеРасчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ПодобранныеРасчетыОтражениеВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ПодготовитьИПередатьДанные();
	РезультатЗакрытия = "ПеренестиВДокумент";
	Закрыть(РезультатЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	РезультатЗакрытия = "Отмена";
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для каждого СтрокаРасчетов Из ОстаткиРасчетов Цикл
		ПеренестиВПодобрано(СтрокаРасчетов);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	ТекущиеДанные = Элементы.ОстаткиРасчетов.ТекущиеДанные;
	ОчиститьПодобрано(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсе(Команда)
	Для каждого СтрокаРасчетов Из ОстаткиРасчетов Цикл
		ОчиститьПодобрано(СтрокаРасчетов);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписок(Команда)

    ОткрытьФормуНастройкиСписка();

КонецПроцедуры

&НаКлиенте
Процедура ИсключитьИзСпискаПлатежиВСоставеЕНП(Команда)
	ИсключитьИзСпискаНаРаспределение(Элементы.ОстаткиРасчетов.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЕстьУчетОбособленныхПодразделений()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	(Организации.ГоловнаяОрганизация = &ГоловнаяОрганизация
		|			ИЛИ Организации.Ссылка = &ГоловнаяОрганизация)
		|	И НЕ Организации.Ссылка = &Организация
		|	И НЕ Организации.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьДвижения
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
		|ГДЕ
		|	ЖурналПроводокЕПСБУ.Организация В
		|			(ВЫБРАТЬ
		|				ВТОрганизации.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТОрганизации КАК ВТОрганизации)";
	
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", ГоловнаяОрганизация);
	Запрос.УстановитьПараметр("Организация",         Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

&НаСервере
Процедура ВосстановитьТаблицуПодобранныеРасчеты()

	ТаблицаНалоги = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	ПодобранныеРасчеты.Загрузить(ТаблицаНалоги);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьДатуОстатковРасчетовАсинх()
	
	НоваяДата = Ждать ВвестиДатуАсинх(ДатаОстаткиРасчетов, НСтр("ru = 'Остатки расчетов'"), ЧастиДаты.Дата);
	
	Если НоваяДата <> Неопределено Тогда
		ДатаОстаткиРасчетов = НоваяДата;
		ЗаполнитьОстаткиРасчетов();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьДатуОстатковЕНПАсинх()
	
	НоваяДата = Ждать ВвестиДатуАсинх(ДатаОстаткиЕНП, НСтр("ru = 'Остаток ЕНП'"), ЧастиДаты.Дата);
	
	Если НоваяДата <> Неопределено И НоваяДата <> ДатаОстаткиЕНП Тогда
		ДатаОстаткиЕНП = НоваяДата;
		ЗаполнитьОстаткиЕНП();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередЗакрытиемПеренестиДанныеАсинх()

	ТекстВопроса = НСтр("ru = 'Результат распределения не перенесен в документ.
		|
		|Перенести?'");
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Отмена);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПодготовитьИПередатьДанные();
		РезультатЗакрытия = "ПеренестиВДокумент";
		Закрыть(РезультатЗакрытия);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		РезультатЗакрытия = "Отмена";
		Закрыть(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьИПередатьДанные()
	
	ТаблицаНалоги = РеквизитФормыВЗначение("ПодобранныеРасчеты");
	ПоместитьВоВременноеХранилище(ТаблицаНалоги, АдресВременногоХранилища);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСписка()
	
	ПоместитьВидыНалогаСпискаВоВременноеХранилище();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", 				Организация);
	ПараметрыФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбновитьСписокПослеНастройки", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.НастройкаСпискаПлатежиВСоставеЕНП.Форма.ФормаНастройки", ПараметрыФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
&НаСервере
Процедура ПоместитьВидыНалогаСпискаВоВременноеХранилище()

	ВидыНалогаСписка = ОбщегоНазначения.ВыгрузитьКолонку(ОстаткиРасчетов, "ВидНалогаИлиПлатежа", Истина);
	ПоместитьВоВременноеХранилище(ВидыНалогаСписка, АдресВременногоХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПослеНастройки(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ЗаполнитьОстаткиРасчетов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиРасчетов()
	Перем ТекущийВидНалога;
	
	ТекущаяСтрока = Элементы.ОстаткиРасчетов.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущийВидНалога = ОстаткиРасчетов.НайтиПоИдентификатору(ТекущаяСтрока).ВидНалогаИлиПлатежа;
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ВТПодобранныеРасчеты", 	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТВидыНалоговИПлатежей", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТОстаткиРасчетов", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиРасчетовДетально", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиРасчетов", 		НомераТаблиц.Количество());

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодобранныеРасчеты.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
		|	ПодобранныеРасчеты.Счет КАК Счет,
		|	ПодобранныеРасчеты.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТПодобранныеРасчеты
		|ИЗ
		|	&ПодобранныеРасчеты КАК ПодобранныеРасчеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыНалоговИПлатежей.Ссылка КАК ВидНалогаИлиПлатежа
		|ПОМЕСТИТЬ ВТВидыНалоговИПлатежей
		|ИЗ
		|	Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаСпискаПлатежиВСоставеЕНП КАК НастройкаСпискаПлатежиВСоставеЕНП
		|		ПО (НастройкаСпискаПлатежиВСоставеЕНП.Организация = &Организация)
		|			И (НастройкаСпискаПлатежиВСоставеЕНП.НеВключать)
		|			И ВидыНалоговИПлатежей.Ссылка = НастройкаСпискаПлатежиВСоставеЕНП.ВидНалогаИлиПлатежа
		|ГДЕ
		|	(НастройкаСпискаПлатежиВСоставеЕНП.НеВключать ЕСТЬ NULL
		|			ИЛИ ВидыНалоговИПлатежей.Ссылка В
		|				(ВЫБРАТЬ
		|					ВТПодобранныеРасчеты.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа
		|				ИЗ
		|					ВТПодобранныеРасчеты КАК ВТПодобранныеРасчеты)
		|			ИЛИ &ПоказатьВсеРасчеты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ВидыНалоговИПлатежей.Ссылка, ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка)) КАК ВидНалогаИлиПлатежа,
		|	ЕСТЬNULL(НалогиИПлатежиОрганизации.Ссылка, ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка)) КАК НалогСборПлатеж,
		|	ВЫБОР
		|		КОГДА &УчетПоИФО
		|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|	-ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК ОстатокРасчетов,
		|	0 КАК Подобрано,
		|	ИСТИНА КАК ОстаткиДетально
		|ПОМЕСТИТЬ ВТОстаткиРасчетов
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&НаДату,
		|			Счет В (&СчетаРасчетов),
		|			,
		|			Организация = &Организация
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ВТВидыНалоговИПлатежей.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа
		|					ИЗ
		|						ВТВидыНалоговИПлатежей КАК ВТВидыНалоговИПлатежей)) КАК ЖурналПроводокЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
		|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ВидыНалоговИПлатежей.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
		|		ПО ЖурналПроводокЕПСБУОстатки.Субконто2 = НалогиИПлатежиОрганизации.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВидыНалоговИПлатежей.Ссылка, ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка)),
