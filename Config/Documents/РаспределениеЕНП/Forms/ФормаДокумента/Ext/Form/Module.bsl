&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыУстановкиСвойствСубконтоЕНП(Форма)

	Результат = БухгалтерскийУчетКлиентСервер.ПараметрыУстановкиСвойствСубконтоПоШаблону(
		"СубконтоЕНП", "СубконтоЕНП", "СчетЕНП");
		
	Результат.ДопРеквизиты.Вставить("Организация", Форма.Объект.Организация);
	
	Возврат Результат;

КонецФункции

// Параметры:
//  ДанныеСтроки - Структура:
//    * НаДату              - Дата
//    * Организация         - СправочникСсылка.Организации
//    * ВидНалогаИлиПлатежа - СправочникСсылка.ВидыНалоговИПлатежей
//    * НалогСборПлатеж     - СправочникСсылка.НалогиИПлатежиОрганизации
//    * Субконто1 - Характеристика.ВидыСубконто
//    * Субконто2 - Характеристика.ВидыСубконто
//    * Субконто3 - Характеристика.ВидыСубконто
//
// Возвращаемое значение:
//   - Структура - пустая структура
//   - Структура:
//       * НалогСборПлатеж - СправочникСсылка.НалогиИПлатежиОрганизации
//       * Счет      - ПланСчетовСсылка.ЕПСБУ
//       * Субконто1 - Характеристика.ВидыСубконто
//       * Субконто2 - Характеристика.ВидыСубконто
//       * Субконто3 - Характеристика.ВидыСубконто
//
&НаСервереБезКонтекста
Функция ДанныеСтрокиНалогиПриИзмененииВидНалогаИлиПлатежа(Знач ДанныеСтроки)

	Результат = Новый Структура;
	
	Если Не ЗначениеЗаполнено(ДанныеСтроки.ВидНалогаИлиПлатежа) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Результат.Вставить("НалогСборПлатеж");
	Результат.Вставить("Счет");
	Результат.Вставить("Субконто1");
	Результат.Вставить("Субконто2");
	Результат.Вставить("Субконто3");
	
	Результат.НалогСборПлатеж = НалогСборПлатежПоУмолчанию(ДанныеСтроки.Организация,
		ДанныеСтроки.ВидНалогаИлиПлатежа);
	
	Счет = Справочники.ВидыНалоговИПлатежей.СчетУчета(ДанныеСтроки.ВидНалогаИлиПлатежа, ДанныеСтроки.НаДату);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	Результат.Счет = Счет;
	
	Для Индекс = 1 По 3 Цикл
		Если Индекс > СвойстваСчета.КоличествоСубконто Тогда
			ЗначениеСубконто = Неопределено;
		Иначе
			ТипЗначенияСубконто = СвойстваСчета[СтрШаблон("ВидСубконто%1ТипЗначения", Индекс)];
			Если ТипЗначенияСубконто.СодержитТип(Тип("СправочникСсылка.ВидыНалоговИПлатежей")) Тогда
				ЗначениеСубконто = ДанныеСтроки.ВидНалогаИлиПлатежа;
		    ИначеЕсли ТипЗначенияСубконто.СодержитТип(Тип("СправочникСсылка.НалогиИПлатежиОрганизации")) Тогда
				ЗначениеСубконто = Результат.НалогСборПлатеж;
			Иначе
				ЗначениеСубконто = ТипЗначенияСубконто.ПривестиЗначение(ДанныеСтроки["Субконто" + Индекс]);
			КонецЕсли;
		КонецЕсли;
		Результат["Субконто" + Индекс] = ЗначениеСубконто;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ЗаполнениеДокумента

&НаСервере
Процедура ЗаполнитьРеквизитыНовогоДокумента()

	Если Не ЗначениеЗаполнено(Объект.СчетЕНП) Тогда
		Объект.СчетЕНП = БухгалтерскийУчет.СчетПоКоду("303.14");
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетЕНП);
	
	Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл

		Объект["СубконтоЕНП" + Индекс] = СвойстваСчета[СтрШаблон("ВидСубконто%1ТипЗначения", Индекс)].
			ПривестиЗначение(Объект["СубконтоЕНП" + Индекс]);
	
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.СубконтоЕНП1) И СвойстваСчета.КоличествоСубконто > 0
		И ТипЗнч(Объект.СубконтоЕНП1) = Тип("СправочникСсылка.ВидыНалоговИПлатежей") Тогда
		Объект.СубконтоЕНП1 = Справочники.ВидыНалоговИПлатежей.ЕНП;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СубконтоЕНП2) И СвойстваСчета.КоличествоСубконто > 1
		И ТипЗнч(Объект.СубконтоЕНП2) = Тип("СправочникСсылка.НалогиИПлатежиОрганизации") Тогда
		Объект.СубконтоЕНП2 = НалогСборПлатежПоУмолчанию(Объект.Организация, Объект.СубконтоЕНП1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодбора()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
    ПоместитьТаблицуНалогиВоВременноеХранилище();
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	ПараметрыОткрытияФормы.Вставить("Организация", 				Объект.Организация);
	ПараметрыОткрытияФормы.Вставить("ДатаДокумента",			Объект.Дата);
	ПараметрыОткрытияФормы.Вставить("Ссылка", 					Объект.Ссылка);
	ПараметрыОткрытияФормы.Вставить("СчетЕНП", 					Объект.СчетЕНП);
	ПараметрыОткрытияФормы.Вставить("НомерДокумента",			Объект.Номер);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьТаблицуНалогиПодбором", ЭтотОбъект);
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыРаспределениеЕНПФормаПодбора");
	
	ОткрытьФорму("Документ.РаспределениеЕНП.Форма.ФормаПодбора", ПараметрыОткрытияФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ПоместитьТаблицуНалогиВоВременноеХранилище()

	ТаблицаНалоги = Объект.Налоги.Выгрузить();
	ПоместитьВоВременноеХранилище(ТаблицаНалоги, АдресВременногоХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуНалогиПодбором(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = "ПеренестиВДокумент" Тогда
		
		ЗаполнитьТаблицуНалогиПодборомНаСервере();
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНалогиПодборомНаСервере()
	
	ТаблицаНалоги = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Объект.Налоги.Загрузить(ТаблицаНалоги);
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("КФО", ДанныеСтроки.КФО);
	ПараметрыФормы.Вставить("КПС", ДанныеСтроки.КПС);
	
	ПараметрыФормы.Вставить("Подразделение", ДанныеСтроки.Подразделение);
	ПараметрыФормы.Вставить("РежимОбязательноУказатьПодразделение", Истина);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКФО", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ОбязательностьКПС", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.Субконто1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.Субконто2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.Субконто3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Аналитика распределения единого налогового платежа'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", СписокСчетов("303.00", Объект.Дата, Объект.Организация));
	ПараметрыСчета.Вставить("ВидСравненияВСписке", 	Истина);
	ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыСчета.Вставить("Организация", 			Объект.Организация);
	ПараметрыСчета.Вставить("ИФО", 					ДанныеСтроки.ИФО);
	ПараметрыСчета.Вставить("НаДату",				Объект.Дата);
	ПараметрыФормы.Вставить("ПараметрыСчета", 		ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ЕстьНДС", Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", Неопределено);

	ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

