&НаКлиентеНаСервереБезКонтекста
Процедура СчетЕНПОбработатьИзменение(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.СчетЕНП);

	Элементы.ПодразделениеЕНП.Видимость = Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И СвойстваСчета.УчетПоПодразделениям;
	
	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЕНП1", "СубконтоЕНП1", Истина, "СубконтоЕНП1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЕНП2", "СубконтоЕНП2", Истина, "СубконтоЕНП2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЕНП3", "СубконтоЕНП3", Истина, "СубконтоЕНП3", Истина, Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетЕНП, Форма, Объект, МассивПолей);

	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыВыбораСубконтоПриИзмененииСчета(
		Форма, Объект, ПараметрыУстановкиСвойствСубконтоЕНП(Форма));
	
КонецПроцедуры

