#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СведенияОбУдержанномНДФЛ") Тогда	
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		ДокументОснование = ДанныеЗаполнения;
		Организация       = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "Организация");

		ЗаполнитьПоДокументуСведенияОбУдержанномНДФЛ();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента  = Налоги.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетЕНП);
	
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
			И Не ЗначениеЗаполнено(ЭтотОбъект["СубконтоЕНП" + НомерСубконто]) Тогда
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не заполнено субконто ""%1"" на закладке ""Счет ЕНП""'"),
				СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"]);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "СубконтоЕНП" + НомерСубконто, "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ПроверятьПодразделениеЕНПВСтроке = УчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям 
		И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение И Не ЗначениеЗаполнено(ПодразделениеЕНП);
	ПодразделениеЕНПЗаполнено = Истина;
	ИмяСписка = НСтр("ru = 'Принадлежность сумм ЕНП'");
	
	Для каждого СтрокаДокумента Из Налоги Цикл

		Префикс = "Налоги[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента.Счет);
		Если УчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение
			И Не ЗначениеЗаполнено(СтрокаДокумента.Подразделение) Тогда
		
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Подразделение'"),
				СтрокаДокумента.НомерСтроки, ИмяСписка);

			Поле = Префикс + "Подразделение";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ЭтотОбъект,
				Поле,
				"Объект",
				Отказ);
				
		КонецЕсли;
		
		Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
				И Не ЗначениеЗаполнено(СтрокаДокумента["Субконто" + НомерСубконто]) Тогда
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не заполнено субконто ""%1"" в строке %2 списка ""%3""'"),
					СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"],
					СтрокаДокумента.НомерСтроки,
					ИмяСписка);
					
				Поле = Префикс + "ОтражениеВУчете";
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ЭтотОбъект,
					Поле,
					"Объект",
					Отказ);
				
			КонецЕсли;
		КонецЦикла;
		
		Если ПроверятьПодразделениеЕНПВСтроке И Не ЗначениеЗаполнено(СтрокаДокумента.Подразделение) Тогда
			ПодразделениеЕНПЗаполнено = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПодразделениеЕНПЗаполнено Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Поле ""Подразделение"" не заполнено. Не во всех строках списка ""%1"" заполнена колонка ""Подразделение""'"),
			ИмяСписка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ПодразделениеЕНП", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ДокументОснование = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
 
Процедура ЗаполнитьПоДокументуСведенияОбУдержанномНДФЛ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияОбУдержанномНДФЛНДФЛ.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА СведенияОбУдержанномНДФЛНДФЛ.Субконто1 ССЫЛКА Справочник.ВидыНалоговИПлатежей
		|			ТОГДА СведенияОбУдержанномНДФЛНДФЛ.Субконто1
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка)
		|	КОНЕЦ КАК ВидНалогаИлиПлатежа,
		|	ВЫБОР
		|		КОГДА СведенияОбУдержанномНДФЛНДФЛ.Субконто2 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
		|			ТОГДА СведенияОбУдержанномНДФЛНДФЛ.Субконто2
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка)
		|	КОНЕЦ КАК НалогСборПлатеж,
		|	СведенияОбУдержанномНДФЛНДФЛ.Счет КАК Счет,
		|	СведенияОбУдержанномНДФЛНДФЛ.Субконто1 КАК Субконто1,
		|	СведенияОбУдержанномНДФЛНДФЛ.Субконто2 КАК Субконто2,
		|	СведенияОбУдержанномНДФЛНДФЛ.Субконто3 КАК Субконто3,
		|	СведенияОбУдержанномНДФЛНДФЛ.Сумма КАК Сумма,
		|	СведенияОбУдержанномНДФЛНДФЛ.ИФО КАК ИФО,
		|	СведенияОбУдержанномНДФЛНДФЛ.Подразделение КАК Подразделение,
		|	СведенияОбУдержанномНДФЛНДФЛ.КФО КАК КФО,
		|	СведенияОбУдержанномНДФЛНДФЛ.КПС КАК КПС
		|ИЗ
		|	Документ.СведенияОбУдержанномНДФЛ.НДФЛ КАК СведенияОбУдержанномНДФЛНДФЛ
		|ГДЕ
		|	СведенияОбУдержанномНДФЛНДФЛ.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";

	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить();
	
	СчетНДФЛ      = БухгалтерскийУчет.СчетПоКоду("303.01", Дата, Организация);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетНДФЛ);
		
	ВидНалогаАвто = Справочники.ВидыНалоговИПлатежей.НДФЛ;
	НалогАвто     = Справочники.НалогиИПлатежиОрганизации.НалогСборПлатежПоУмолчанию(Организация, ВидНалогаАвто);

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Налоги.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Если Не ЗначениеЗаполнено(Строка.Счет) Тогда
			Если Не ЗначениеЗаполнено(Строка.ВидНалогаИлиПлатежа) Тогда
				Строка.ВидНалогаИлиПлатежа = ВидНалогаАвто;
				Строка.НалогСборПлатеж     = НалогАвто;
			КонецЕсли;
			Строка.Счет = СчетНДФЛ;
			Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
				ТипЗначенияСубконто = СвойстваСчета["ВидСубконто" + Индекс + "ТипЗначения"];
				Если ТипЗначенияСубконто.СодержитТип(Тип("СправочникСсылка.ВидыНалоговИПлатежей")) Тогда
					ЗначениеСубконто = Строка.ВидНалогаИлиПлатежа;
			    ИначеЕсли ТипЗначенияСубконто.СодержитТип(Тип("СправочникСсылка.НалогиИПлатежиОрганизации")) Тогда
					ЗначениеСубконто = Строка.НалогСборПлатеж;
				Иначе
					ЗначениеСубконто = ТипЗначенияСубконто.ПривестиЗначение();
				КонецЕсли;
				Строка["Субконто" + Индекс] = ЗначениеСубконто;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли