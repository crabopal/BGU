&НаКлиенте
Процедура ДенежныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекДанныеДенежныеСредства = Элементы.ДенежныеСредства.ТекущиеДанные;
		
		Если Копирование Тогда
			ТекДанныеДенежныеСредства.ВыставленСФ = Ложь;
			ТекДанныеДенежныеСредства.СчетФактура = Неопределено;
			ТекДанныеДенежныеСредства.НомерСФ =  "";
			ТекДанныеДенежныеСредства.ДатаСФ = "";
			ТекДанныеДенежныеСредства.ПредставлениеСчетаФактуры = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеСредстваПредставлениеСчетаФактурыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыбраннаяСтрока = Элементы.Покупатели.ТекущаяСтрока;
	
	Если ЗначениеЗаполнено(ВыбраннаяСтрока.СчетФактура) Тогда
	
		ОткрытьСчетФактуру(ЭтаФорма, ВыбраннаяСтрока.СчетФактура, "СчетФактураВыданный");
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДенежныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ДенежныеСредства.ТекущиеДанные;
	
	Если Поле.Имя = "ДенежныеСредстваПредставлениеСчетаФактуры" И ЗначениеЗаполнено(ТекущаяСтрока.СчетФактура) Тогда
	
		СтандартнаяОбработка = Ложь;
		ОткрытьСчетФактуру(ЭтотОбъект, ТекущаяСтрока.СчетФактура, "СчетФактураВыданный");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДенежныеСредстваВидОтчетаПоПлатежамПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДенежныеСредства.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные.ВидОтчетаПоПлатежам = ПредопределенноеЗначение("Перечисление.ВидыОтчетовПоПлатежамКомиссия.Аванс") Тогда
		ТекущиеДанные.ВыставленСФ = "";
		ТекущиеДанные.ДатаСФ = "";
		ТекущиеДанные.НомерСФ = "";
		ТекущиеДанные.СчетФактура = "";
		ТекущиеДанные.ПредставлениеСчетаФактуры = "";
	КонецЕсли;
	
КонецПроцедуры

