&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоги(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ИтогНДСОтгрузки   = Объект.Номенклатура.Итог("СуммаНДС") + Объект.Услуги.Итог("СуммаНДС");
	Форма.ИтогСуммаОтгрузки = Объект.Номенклатура.Итог("Сумма") + Объект.Услуги.Итог("Сумма") 
		+ ?(Объект.СуммаВключаетНДС, 0, Форма.ИтогНДСОтгрузки);
		
	Форма.ИтогНДСВозвраты   = Объект.ТоварыВозвращенные.Итог("СуммаНДС");
	Форма.ИтогСуммаВозвраты = Объект.ТоварыВозвращенные.Итог("Сумма")
		+ ?(Объект.СуммаВключаетНДС, 0, Форма.ИтогНДСВозвраты);
	
	Форма.ИтогВсегоНДСВознаграждения = Объект.Номенклатура.Итог("СуммаНДСВознаграждения") 
		+ Объект.Услуги.Итог("СуммаНДСВознаграждения") - Объект.ТоварыВозвращенные.Итог("СуммаНДСВознаграждения");
	Форма.ИтогВсегоВознаграждение = Объект.Номенклатура.Итог("СуммаВознаграждения") 
		+ Объект.Услуги.Итог("СуммаВознаграждения") - Объект.ТоварыВозвращенные.Итог("СуммаВознаграждения") 
		+ ?(Объект.СуммаВключаетНДС, 0, Форма.ИтогВсегоНДСВознаграждения);
	
	Форма.ИтогВсегоПоСФВыставленным    = Объект.Покупатели.Итог("ВсегоПоСФ");
	Форма.ИтогВсегоНДСПоСФВыставленным = Объект.Покупатели.Итог("НДСПоСФ");
	
	Форма.ИтогВсегоПоСФПолученным    = Объект.Возвраты.Итог("ВсегоПоСФ");
	Форма.ИтогВсегоНДСПоСФПолученным = Объект.Возвраты.Итог("НДСПоСФ");
	
	ЗаполнитьТекстПроСчетФактуру(Форма);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	МаксимальныйКлючСтроки = Документы.ОтчетКомиссионера.ПолучитьМаксимальныйКлючСтроки(Объект.Покупатели);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	ТекущаяДатаДокумента = Объект.Дата;
	
	ДоговорУказан = ЗначениеЗаполнено(Объект.Договор);
	
	Если ДоговорУказан Тогда
		ТребуетсяСчетФактура = Истина;
	Иначе
		ТребуетсяСчетФактура = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьРеквизитовДокумента(ЭтотОбъект);
	
	// Настраиваем внешний вид формы:
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНовыйКлючСтроки()
	
	// Если в табл. части уже присутствуют строки, то новое «свободное» значение ключа
	// рассчитывается от максимального существующего значения.
	Если Объект.Покупатели.Количество() > 1 Тогда
		МаксимальныйКлючСтроки = МаксимальныйКлючСтроки + 1;
	КонецЕсли;

	Возврат МаксимальныйКлючСтроки;
	
КонецФункции

&НаКлиенте
Процедура ДанныеПокупателиУстановитьОтборСтрок()
	
	ТекДанныеПокупатели = Элементы.Покупатели.ТекущиеДанные;
	Если ТекДанныеПокупатели <> Неопределено Тогда
		Элементы.Покупатели.ТекущаяСтрока = ТекДанныеПокупатели.ПолучитьИдентификатор();
		КлючСтроки = ТекДанныеПокупатели.КлючСтроки;
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", КлючСтроки);
		Элементы.Услуги.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", КлючСтроки);
	Иначе
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", 0);
		Элементы.Услуги.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", 0);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередНачаломДобавленияСтрокиТоваровУслуг(ДанныеСтрокиПокупателя, Отказ)
	
	Если ДанныеСтрокиПокупателя = Неопределено Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru = 'Не выбрана строка в списке Покупатели!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Покупатели", "Объект", Отказ);
	ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеСтрокиПокупателя.Покупатель) Тогда
		Отказ = Истина;
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка", , "Покупатель", ДанныеСтрокиПокупателя.НомерСтроки, "Покупатели");
		ПутьКДанным = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
			"Покупатели", ДанныеСтрокиПокупателя.НомерСтроки, "Покупатель");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ПутьКДанным, "Объект", Отказ);
    Иначе
		СуммаПоСтрокеДоИзменения    = 0;
		СуммаНДСПоСтрокеДоИзменения = 0;
        КлючСтрокиДоИзменения = ДанныеСтрокиПокупателя.КлючСтроки; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеРедактированияСтрокиТоваровУслуг(ДанныеСтроки, ДанныеСтрокиПокупателя, НоваяСтрока, Копирование)

	Если НоваяСтрока И ДанныеСтрокиПокупателя <> Неопределено Тогда
		ДанныеСтроки.КлючСтроки = ДанныеСтрокиПокупателя.КлючСтроки;
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		СуммаПоСтрокеДоИзменения    = 0;
		СуммаНДСПоСтрокеДоИзменения = 0;
		
	Иначе
		СуммаПоСтрокеДоИзменения    = ДанныеСтроки.Сумма;
		СуммаНДСПоСтрокеДоИзменения = ДанныеСтроки.СуммаНДС;
	КонецЕсли;
	
	КлючСтрокиДоИзменения = ДанныеСтроки.КлючСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСуммыПоСтрокеПокупателя(КлючСтроки, НоваяСуммаПоСтроке, НоваяСуммаНДСПоСтроке)
	
	Отбор = Новый Структура("КлючСтроки", КлючСтроки);
	
	МассивСтрок = Объект.Покупатели.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокиПокупателя = МассивСтрок[0];
	
	РазницаСумм = НоваяСуммаПоСтроке - СуммаПоСтрокеДоИзменения;
	РазницаНДС  = НоваяСуммаНДСПоСтроке - СуммаНДСПоСтрокеДоИзменения;
	
	СуммаПоСтрокеДоИзменения    = НоваяСуммаПоСтроке; 
	СуммаНДСПоСтрокеДоИзменения = НоваяСуммаНДСПоСтроке;
	
	ДанныеСтрокиПокупателя.Всего = ДанныеСтрокиПокупателя.Всего + РазницаСумм + ?(Объект.СуммаВключаетНДС, 0, РазницаНДС);
	ДанныеСтрокиПокупателя.НДС   = ДанныеСтрокиПокупателя.НДС + РазницаНДС;
	ДанныеСтрокиПокупателя.ВсегоПоСФ = ?(ДанныеСтрокиПокупателя.ВыставленСФ, ДанныеСтрокиПокупателя.Всего, 0);
	ДанныеСтрокиПокупателя.НДСПоСФ   = ?(ДанныеСтрокиПокупателя.ВыставленСФ, ДанныеСтрокиПокупателя.НДС, 0);
	ОбновитьИтоги(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаОперацииНаСервере()
	
	Если Объект.Номенклатура.Количество() > 0 Тогда
		Объект.Покупатели.Очистить();
		НоваяСтрокаПокупатели 				= Объект.Покупатели.Добавить();
		НоваяСтрокаПокупатели.Покупатель 	= Объект.Контрагент;
		Документы.ОтчетКомиссионера.ЗаполнитьСуммыВСтрокеПриИзмененииВидаОперации(ЭтотОбъект, "Товары", НоваяСтрокаПокупатели, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект); 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуТабЧасти(СтрокаТаблицы, ЗначениеПустогоКоличества = 0, СоответствиеРеквизитов = Неопределено) Экспорт
	
	Если СоответствиеРеквизитов <> Неопределено Тогда
		СтрокаТабличнойЧасти = ПолучитьИзСтрокиТаблицыДокумента(СтрокаТаблицы, СоответствиеРеквизитов);
	Иначе
		СтрокаТабличнойЧасти = СтрокаТаблицы;
	КонецЕсли; 

	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * ?(СтрокаТабличнойЧасти.Количество = 0, ЗначениеПустогоКоличества, СтрокаТабличнойЧасти.Количество);
	
	Если СоответствиеРеквизитов <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			СтрокаТаблицы, 
			ВСтрокуТаблицыДокумента(СтрокаТаблицы, СоответствиеРеквизитов));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуНДСТабЧасти(СтрокаТаблицы, СуммаВключаетНДС = Ложь, СоответствиеРеквизитов = Неопределено) Экспорт
	
	Если СоответствиеРеквизитов <> Неопределено Тогда
		СтрокаТабличнойЧасти = ПолучитьИзСтрокиТаблицыДокумента(СтрокаТаблицы, СоответствиеРеквизитов);
	Иначе
		СтрокаТабличнойЧасти = СтрокаТаблицы;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТабличнойЧасти) = Тип("Структура") Тогда
		Если СтрокаТабличнойЧасти.Свойство("Сумма") И СтрокаТабличнойЧасти.Свойство("СтавкаНДС") Тогда
			СтрокаТабличнойЧасти.СуммаНДС = РассчитатьСуммуНДС(
												СтрокаТабличнойЧасти.Сумма - ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрокаТабличнойЧасти, "СуммаСкидки", 0),
												СуммаВключаетНДС,
												УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС));
		КонецЕсли;
	Иначе // Строка табличной части
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС) Тогда
			СтрокаТабличнойЧасти.СуммаНДС = РассчитатьСуммуНДС(
												СтрокаТабличнойЧасти.Сумма,
												СуммаВключаетНДС,
												УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС));
		КонецЕсли;
	КонецЕсли;
	
	Если СоответствиеРеквизитов <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			СтрокаТаблицы, 
			ВСтрокуТаблицыДокумента(СтрокаТаблицы, СоответствиеРеквизитов));
	КонецЕсли;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьСуммуНДС(Сумма, СуммаВключаетНДС, СтавкаНДС) Экспорт

	Если СуммаВключаетНДС Тогда
		СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
		СуммаНДС = Сумма - СуммаБезНДС;
	Иначе
		СуммаБезНДС = Сумма;
	КонецЕсли;

	Если НЕ СуммаВключаетНДС Тогда
		СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
	КонецЕсли;
	
	Возврат СуммаНДС;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИзСтрокиТаблицыДокумента(ИсходнаяСтрока, СоответствиеРеквизитов)
	
	Результат = Новый Структура;
	
	Для каждого СоответствиеРеквизита Из СоответствиеРеквизитов Цикл
		Результат.Вставить(СоответствиеРеквизита.Ключ, ИсходнаяСтрока[СоответствиеРеквизита.Значение]);
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВСтрокуТаблицыДокумента(ИсходнаяСтрока, СоответствиеРеквизитов)
	
	Результат = Новый Структура;
	
	Для каждого СоответствиеРеквизита Из СоответствиеРеквизитов Цикл
		Результат.Вставить(СоответствиеРеквизита.Значение, ИсходнаяСтрока[СоответствиеРеквизита.Ключ]);
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьСумму(Строка, СуммаВключаетНДС = Ложь, ЗначениеПустогоКоличества = 0) Экспорт

	Строка.Сумма = Строка.Цена * ?(Строка.Количество = 0, ЗначениеПустогоКоличества, Строка.Количество);
	
	Если Строка.Свойство("СтавкаНДС") И Строка.Свойство("Всего") Тогда
		ПересчитатьСуммуНДС(Строка, СуммаВключаетНДС);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)
	
	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ВалютаДокумента, ПринятьНДСКВычету, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
	ПараметрыПредставления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуНДС(Строка, СуммаВключаетНДС) Экспорт
	
	Перем СуммаСкидки;
	
	Если Строка.Свойство("СуммаСкидки", СуммаСкидки) И СуммаСкидки > 0 Тогда
		Если Строка.Сумма > 0 Тогда
			Сумма = Строка.Сумма - Мин(СуммаСкидки, Строка.Сумма);
		Иначе
			Сумма = Строка.Сумма + Мин(СуммаСкидки, -Строка.Сумма);
		КонецЕсли; 
	Иначе
		Сумма = Строка.Сумма;
	КонецЕсли;
	
	Строка.СуммаНДС = РассчитатьСуммуНДС(Сумма, СуммаВключаетНДС, УчетНДСКлиентСервер.ЗначениеСтавкиНДС(Строка.СтавкаНДС));
	
	Строка.Всего    = Сумма + ?(СуммаВключаетНДС, 0, Строка.СуммаНДС);

КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора(ИмяТаблицы)
	
	СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("ТПР", Объект.Дата, Объект.Организация);
	
	ПараметрыПодбора = Новый Структура;
	Если ИмяТаблицы = "Номенклатура" Тогда
	
		ПараметрыПодбора.Вставить("СчетУчета",				СчетУчета);
		ПараметрыПодбора.Вставить("КФО",					Объект.КФО);
		ПараметрыПодбора.Вставить("Подразделение",			Объект.Подразделение);
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
		ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
		ПараметрыПодбора.Вставить("ВключатьСчетТПР", Истина);
		ПараметрыПодбора.Вставить("ПодборПереданныхНаРеализациюТоваров", Истина);
		ПараметрыПодбора.Вставить("КонтрагентОстатковВПользовании",	Объект.Контрагент);
		ПараметрыПодбора.Вставить("ПоказыватьЦены",			Истина);
		ПараметрыПодбора.Вставить("ПодборОстатковВПользовании", Истина);
		
		ТипыНоменклатуры = Новый СписокЗначений;
	
		ПараметрыПодбора.Вставить("ИмяТаблицы",				"Номенклатура");
		
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
		
	ИначеЕсли ИмяТаблицы = "Услуги" Тогда
		
		ЗаголовокПодбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Подбор услуг/работ в %1 (%2)'"), Объект.Ссылка, "Услуги и работы");

		ПараметрыПодбора.Вставить("Заголовок", ЗаголовокПодбора);
		
		ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);

		ТипыНоменклатуры = Новый СписокЗначений;
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
		
		ПараметрыПодбора.Вставить("ТипыНоменклатуры", ТипыНоменклатуры);
		ПараметрыПодбора.Вставить("ЕстьЦена", Ложь);
		ПараметрыПодбора.Вставить("ВыводитьНулевуюНоменклатуру", Истина);
		ПараметрыПодбора.Вставить("ИмяТаблицы", "Услуги");
		ПараметрыПодбора.Вставить("ПоказыватьЦены", Ложь);
		
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ТипыНоменклатуры", ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("Валюта", Объект.ВалютаДокумента);
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение, ИмяТаблицы)
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	ДобавитьСчетУчетаПоУмолчаниюВПодборе(СписокПодбора);
	
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		
		НоваяСтрока = Объект[ИмяТаблицы].Добавить();
		
		НоваяСтрока.КлючСтроки = ЭтаФорма.ТекущийКлючСтроки;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		
		РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");
		
		Если ЗначениеЗаполнено(Объект.ПроцентКомиссионногоВознаграждения) Тогда
			РассчитатьВознаграждениеВСтроке(НоваяСтрока, ИмяТаблицы, Объект);
		КонецЕсли;
		
		Если ИмяТаблицы = "Номенклатура" Тогда
			НоваяСтрока.СчетУчета = УправлениеМатериальнымиЗапасами.ПолучитьСчетНоменклатурыПоУмолчанию(НоваяСтрока.Номенклатура);
			НоваяСтрока.ДополнительнаяАналитикаСчета = "";
			НоваяСтрока.Партия = ЭлементПодбора.ДополнительнаяАналитикаСчета;
			НоваяСтрока.ЦенаПередачи = ЭлементПодбора.Цена;
			НоваяСтрока.СуммаПередачи = ЭлементПодбора.Сумма;
			ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	УправлениеФормой(ЭтаФорма);
	ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", ИмяРеквизита <> "Цена");
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВставкиДанныхИзБуфераОбмена(Ссылка, ИмяТаблицы) Экспорт
	
	ПараметрыВставки = Новый Структура;
	ПараметрыВставки.Вставить("ЭтоВставкаИзБуфера",		 Истина);
	ДанныеИзБуфераОбмена = ОбщегоНазначения.СтрокиИзБуфераОбмена();
	ПараметрыВставки.Вставить("Источник",				 ДанныеИзБуфераОбмена.Источник);
	ПараметрыВставки.Вставить("Данные",					 ДанныеИзБуфераОбмена.Данные);
	ПараметрыВставки.Вставить("ИмяТаблицы",				 ИмяТаблицы);
	
	ПараметрыВставки.Вставить("ИсточникИДокументОдногоВида",
		Ссылка.Метаданные().Имя = ДанныеИзБуфераОбмена.Источник);
		
	ПараметрыВставки.Вставить("КоличествоДобавленныхСтрок",		 0);
	ПараметрыВставки.Вставить("СписокСвойств",					 "");
		
	Возврат ПараметрыВставки;
	
КонецФункции

&НаКлиенте
Процедура ОповеститьОКопированииСтрокВБуферОбмена(Форма, КоличествоСтрок) Экспорт
	
	НавигационнаяСсылка = Форма.Окно.ПолучитьНавигационнуюСсылку();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Копирование в буфер обмена'"), НавигационнаяСсылка,
		СтрШаблон(НСтр("ru = 'Скопировано строк: %1'"), КоличествоСтрок));
	Оповестить("ДанныеСкопированыВБуферОбмена");

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
		
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения, "СчетФактураПолученный");
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена, ЦенаВключаетНДС, СуммаВключаетНДС, СтавкаНДС)

	// Инициализация переменных
	НадоВключитьНДС  = Ложь;
	НадоИсключитьНДС = Ложь;
	НоваяЦена		 = Цена;

	Если СуммаВключаетНДС
		И (НЕ ЦенаВключаетНДС) Тогда
		
		// Надо добавлять НДС       
		НадоВключитьНДС = Истина;
	ИначеЕсли (НЕ СуммаВключаетНДС)
		И ЦенаВключаетНДС  Тогда
		
		// Надо исключать НДС       
		НадоИсключитьНДС = Истина;
	КонецЕсли;
		
	Если НадоИсключитьНДС Тогда
		НоваяЦена = (НоваяЦена * 100) / (100 + СтавкаНДС);
	КонецЕсли;

	Если НадоВключитьНДС Тогда
		НоваяЦена = (НоваяЦена * (100 + СтавкаНДС)) / 100;
	КонецЕсли;

	Возврат НоваяЦена;

КонецФункции

// ПодключаемыеОбработчики
&НаКлиенте
Процедура Подключаемый_УдалитьСвязанныеЗаписи()
	
	УдалитьСвязанныеЗаписиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСвязанныеЗаписиНаСервере()
	
	ВидыУдаляемыхСтрок = Новый Структура; 
	
	ВидыУдаляемыхСтрок.Вставить("Номенклатура", ТаблицаУдаленныхКлючей);
	ВидыУдаляемыхСтрок.Вставить("Услуги", ТаблицаУдаленныхКлючей);
	ВидыУдаляемыхСтрок.Вставить("ТоварыВозвращенные", ТаблицаУдаленныхКлючейВозвраты);
	
	Для каждого ВидУдаляемыхСтрок Из ВидыУдаляемыхСтрок Цикл
		ИмяТабличнойЧасти 		= ВидУдаляемыхСтрок.Ключ;
		СписокУдаленныхКлючей 	= ВидУдаляемыхСтрок.Значение;
		Для каждого СтрокаКлюча Из СписокУдаленныхКлючей Цикл
			КлючПоиска = Новый Структура("КлючСтроки", СтрокаКлюча.КлючСтроки);
			МассивСтрокТовары = Объект[ИмяТабличнойЧасти].НайтиСтроки(КлючПоиска);
			
			Для каждого СтрокаТЧ Из МассивСтрокТовары Цикл
				Если ИмяТабличнойЧасти = "Номенклатура" Тогда
					НоваяСтрока = ТаблицаУдаленныхСтрок.Добавить();
					НоваяСтрока.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
				КонецЕсли;
				Объект[ИмяТабличнойЧасти].Удалить(СтрокаТЧ);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаУдаленныхКлючей.Очистить();
	ТаблицаУдаленныхКлючейВозвраты.Очистить();
	
	ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц(ИмяТаблицы = "", ДобавленныеСтроки = Неопределено)

	Если ПустаяСтрока(ИмяТаблицы) ИЛИ ИмяТаблицы = "Покупатели" Тогда
		
		СуммыПоКлючам = Объект.Номенклатура.Выгрузить(, "КлючСтроки,Сумма,СуммаНДС");
		Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
			НоваяСтрока = СуммыПоКлючам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
		СуммыПоКлючам.Свернуть("КлючСтроки", "Сумма,СуммаНДС");
		
		Если НЕ Объект.СуммаВключаетНДС Тогда
			Для каждого СтрокаТаблицы Из СуммыПоКлючам Цикл
				СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
			КонецЦикла;
		КонецЕсли;
		
		СуммыПоКлючам.Колонки.Сумма.Имя = "Всего";
		СуммыПоКлючам.Колонки.СуммаНДС.Имя = "НДС";
		СуммыПоКлючам.Индексы.Добавить("КлючСтроки");
		
		Для каждого СтрокаТаблицы Из Объект.Покупатели Цикл
			СуммыПоКлючу = СуммыПоКлючам.Найти(СтрокаТаблицы.КлючСтроки, "КлючСтроки");
			Если СуммыПоКлючу <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СуммыПоКлючу);
			КонецЕсли;
			СтрокаТаблицы.ВсегоПоСФ = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.Всего, 0);
			СтрокаТаблицы.НДСПоСФ   = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.НДС, 0);
			
			СтрокаТаблицы.ПредставлениеСчетаФактуры = 
				ОписаниеПеревыставленногоСчетаФактуры(СтрокаТаблицы.СчетФактура);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяТаблицы) ИЛИ ИмяТаблицы = "Возвраты" Тогда
		
		СуммыПоКлючам = Объект.ТоварыВозвращенные.Выгрузить(, "КлючСтроки,Сумма,СуммаНДС");
		СуммыПоКлючам.Свернуть("КлючСтроки", "Сумма,СуммаНДС");

		ИсправляемыеДокументыПоКлючам = Объект.ТоварыВозвращенные.Выгрузить(, "КлючСтроки");
		ИсправляемыеДокументыПоКлючам.Свернуть("КлючСтроки");
		
		Если НЕ Объект.СуммаВключаетНДС Тогда
			Для каждого СтрокаТаблицы Из СуммыПоКлючам Цикл
				СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
			КонецЦикла;
		КонецЕсли;
		
		СуммыПоКлючам.Колонки.Сумма.Имя = "Всего";
		СуммыПоКлючам.Колонки.СуммаНДС.Имя = "НДС";
		СуммыПоКлючам.Индексы.Добавить("КлючСтроки");
		
		Для каждого СтрокаТаблицы Из Объект.Возвраты Цикл
			СуммыПоКлючу = СуммыПоКлючам.Найти(СтрокаТаблицы.КлючСтроки, "КлючСтроки");
			Если СуммыПоКлючу <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СуммыПоКлючу);
			КонецЕсли;
			СтрокаТаблицы.ВсегоПоСФ = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.Всего, 0);
			СтрокаТаблицы.НДСПоСФ   = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.НДС, 0);
			
			ЗаполнитьСтрокуПоСчетуФактуре(СтрокаТаблицы);
				
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Объект.ДенежныеСредства Цикл
		СтрокаТаблицы.ВсегоПоСФ = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.Сумма, 0);
		СтрокаТаблицы.НДСПоСФ   = ?(СтрокаТаблицы.ВыставленСФ, СтрокаТаблицы.СуммаНДС, 0);
			
		ЗаполнитьСтрокуПоСчетуФактуре(СтрокаТаблицы);
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеПеревыставленногоСчетаФактуры(СчетФактура)
	
	Возврат Документы.ОтчетКомиссионера.ОписаниеСчетаФактуры(СчетФактура);

КонецФункции

&НаКлиенте
Процедура ОткрытьСчетФактуру(Форма, СчетФактура, ВидСчетаФактуры) Экспорт

	СтандартнаяОбработка = Ложь;

	Если НЕ ЗначениеЗаполнено(Форма.Параметры.Ключ) ИЛИ Форма.Модифицированность Тогда
		ОбъектЗаписан = Форма.Записать();
		
		Если НЕ ОбъектЗаписан Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ПараметрыДляФормы = Новый Структура("Ключ", СчетФактура);
	Иначе
		Если Форма.Объект.ПометкаУдаления Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Счет-фактуру нельзя вводить на основании документа, помеченного на удаление.'"));
			Возврат;
		КонецЕсли;

		ПараметрыДляФормы = Новый Структура("Основание", Форма.Параметры.Ключ);
	КонецЕсли;
	
	ФормаСФ = ОткрытьФорму("Документ." + ВидСчетаФактуры + ".ФормаОбъекта", ПараметрыДляФормы, Форма);

КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемСчетовФактурРеализацииЗавершение (Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьСчетаФактурыСервер("Покупатели");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемСчетовФактурПоВозвратамЗавершение (Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьСчетаФактурыСервер("Возвраты");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемСчетовФактурПоАвансамЗавершение (Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьСчетаФактурыСервер("ДенежныеСредства");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСчетаФактурыСервер(ТабличнаяЧастьДляСФ)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ОбъектФормы = РеквизитФормыВЗначение("Объект");
		
		РеквизитыШапки = ПолучитьДанныеДляЗаполненияШапкиСчетаФактуры(Объект.Ссылка, ТабличнаяЧастьДляСФ);
		
		Если ТабличнаяЧастьДляСФ = "Покупатели" Тогда
			ВсеПодчиненныеСчетаФактуры = ПолучитьТаблицыПодчиненныхСчетовФактурРеализацииАвансов(Объект.Ссылка, ТабличнаяЧастьДляСФ);
		ИначеЕсли ТабличнаяЧастьДляСФ = "Возвраты" Тогда
			ВсеПодчиненныеСчетаФактуры = ПолучитьТаблицыПодчиненныхСчетовФактурВозвратов(Объект.Ссылка);
		ИначеЕсли ТабличнаяЧастьДляСФ = "ДенежныеСредства" Тогда
			ВсеПодчиненныеСчетаФактуры = ПолучитьТаблицыПодчиненныхСчетовФактурРеализацииАвансов(Объект.Ссылка, ТабличнаяЧастьДляСФ);
		КонецЕсли;
			
		Для каждого КлючИЗначение Из ВсеПодчиненныеСчетаФактуры Цикл
			
			ИмяТаблицы = КлючИЗначение.Ключ;
			ПодчиненныеСчетаФактуры = КлючИЗначение.Значение;
			
			ДанныеСчетовФактур = ДанныеСчетовФактурПоДокументу(ИмяТаблицы, ОбъектФормы, ТабличнаяЧастьДляСФ);
			НайтиСоздатьПодчиненныеСчетаФактуры(Объект.Ссылка, ДанныеСчетовФактур, ПодчиненныеСчетаФактуры, ИмяТаблицы, ОбъектФормы, РеквизитыШапки);
			
		КонецЦикла;
		
		ЗаполнитьДобавленныеКолонкиТаблиц();
		УправлениеФормой(ЭтотОбъект);
		
		Записать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицыПодчиненныхСчетовФактурРеализацииАвансов(ДокументСсылка, ВидОперацииСФ)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК КлючСтроки,
	|	СчетФактураВыданный.Ссылка КАК Ссылка,
	|	СчетФактураВыданный.Контрагент КАК Покупатель,
	|	НАЧАЛОПЕРИОДА(СчетФактураВыданный.Дата, ДЕНЬ) КАК ДатаСФ,
	|	СчетФактураВыданный.Проведен КАК Проведен,
	|	СчетФактураВыданный.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.КодВидаОперации = ""27""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СводныйСФ
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетФактураВыданный.Дата,
	|	ПометкаУдаления УБЫВ,
	|	Ссылка";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат.Вставить(ВидОперацииСФ, ПолучитьТаблицуПодчиненныхСчетовФактур(РезультатыЗапроса[0]));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицыПодчиненныхСчетовФактурВозвратов(ДокументСсылка)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК КлючСтроки,
	|	КорректировочныйСчетФактураВыданный.Ссылка КАК Ссылка,
	|	КорректировочныйСчетФактураВыданный.Контрагент КАК Покупатель,
	|	НАЧАЛОПЕРИОДА(КорректировочныйСчетФактураВыданный.Дата, ДЕНЬ) КАК ДатаСФ,
	|	КорректировочныйСчетФактураВыданный.Проведен КАК Проведен,
	|	КорректировочныйСчетФактураВыданный.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА КорректировочныйСчетФактураВыданный.КодВидаОперации = ""27""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СводныйСФ
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	|ГДЕ
	|	КорректировочныйСчетФактураВыданный.ДокументКорректировки = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировочныйСчетФактураВыданный.Дата,
	|	ПометкаУдаления УБЫВ,
	|	Ссылка";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат.Вставить("Возвраты", ПолучитьТаблицуПодчиненныхСчетовФактур(РезультатыЗапроса[0]));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСоздатьПодчиненныеСчетаФактуры(ДокументСсылка, ДанныеСчетовФактур, ПодчиненныеСчетаФактуры, ИмяТаблицы, ОбъектФормы, РеквизитыШапки)
	
	СписокДобавленныхСФ = Новый СписокЗначений;
	
	Для каждого СтрокаТаблицы Из ДанныеСчетовФактур Цикл
		
		СтрокаСФ = НайтиСтрокуСчетаФактуры(ПодчиненныеСчетаФактуры, СтрокаТаблицы, ИмяТаблицы, СписокДобавленныхСФ);
		
		Если СтрокаСФ <> Неопределено Тогда
			
			Если СтрокаСФ.ДатаСФ <> СтрокаТаблицы.ДатаСФ
				ИЛИ СтрокаСФ.СводныйСФ <> СтрокаТаблицы.СводныйСФ Тогда 
				
				ДокументСФ		=  СтрокаСФ.Ссылка.ПолучитьОбъект();
				Если СтрокаСФ.ДатаСФ <> СтрокаТаблицы.ДатаСФ Тогда
					Если ТипЗнч(ДокументСФ) = Тип("ДокументОбъект.СчетФактураВыданный") ИЛИ ТипЗнч(ДокументСФ) = Тип("ДокументОбъект.КорректировочныйСчетФактураВыданный") Тогда
						ДокументСФ.Дата = СтрокаТаблицы.ДатаСФ;
					Иначе
						ДокументСФ.ДатаВходящегоДокумента = СтрокаТаблицы.ДатаСФ;
					КонецЕсли;
				КонецЕсли;
				
				ДокументСФ.ДополнительныеСвойства.Вставить("ОбновлятьРеквизитыПриЗаписи", Ложь);
				ДокументСФ.Записать();
				// Обновить значение строки таблицы с счетами-фактурами
				ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
				ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
			КонецЕсли;
			
			Если НЕ ИмяТаблицы = "ДенежныеСредства" Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("КлючСтроки", СтрокаТаблицы.КлючСтроки);
				СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
				Если СтрокаТЧ <> Неопределено Тогда
					СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
					СтрокаСФ.Использован = Истина;
					Если ИмяТаблицы = "Покупатели" Тогда
						СписокДобавленныхСФ.Добавить(СтрокаСФ.Ссылка);
					КонецЕсли;	
				КонецЕсли;
			Иначе
				Отбор = Новый Структура;
				Отбор.Вставить("Покупатель", СтрокаТаблицы.Покупатель);
				СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
				Если СтрокаТЧ <> Неопределено Тогда
					СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
					СтрокаСФ.Использован = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Продолжить;
			
		ИначеЕсли ИмяТаблицы = "Покупатели" Тогда	
			
			ДокументСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(ДокументСФ, РеквизитыШапки);
			
			ДокументСФ.Дата                   = СтрокаТаблицы.ДатаСФ;
			ДокументСФ.Контрагент             = СтрокаТаблицы.Покупатель;
			ДокументСФ.Договор                = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
			ДокументСФ.Ответственный          = Пользователи.ТекущийПользователь();
			ДокументСФ.Комментарий     = 
				НСтр("ru = 'Создан автоматически на основании документа отчет комиссионера о продажах'");
				
			ЗаполнитьТаблицуПокупатели(ДокументСФ, ДанныеСчетовФактур, СтрокаТаблицы.СводныйСФ);
				
			Если СтрокаТаблицы.СводныйСФ Тогда
				ДокументСФ.КодВидаОперации = "27";
			Иначе
				ДокументСФ.КодВидаОперации = "01";
			КонецЕсли;
				
			ДокументСФ.КодСпособаВыставления	= 1;
			ДокументСФ.Выставлен				= Истина;
			ДокументСФ.ДатаВыставления			= Объект.Дата;
			
			Документы.СчетФактураВыданный.УстановитьОтветственныхЛиц(ДокументСФ);
			
			// Получим коды ключей для заполнения табличной части Номенклатура
			КлючиСчетаФактуры = Новый Массив;
			Если СтрокаТаблицы.СводныйСФ Тогда
				Для каждого СтрокаДанныхСФ Из ДанныеСчетовФактур Цикл
					Если СтрокаДанныхСФ.ДатаСФ = СтрокаТаблицы.ДатаСФ Тогда
						КлючиСчетаФактуры.Добавить(СтрокаДанныхСФ.КлючСтроки);
					КонецЕсли;
				КонецЦикла;
			Иначе
				КлючиСчетаФактуры.Добавить(СтрокаТаблицы.КлючСтроки);
			КонецЕсли;
				
			ДанныеНоменклатурыДляСФ = ПолучитьТаблицуНоменклатурыДляСФ(ОбъектФормы, ДокументСФ, СтрокаТаблицы, КлючиСчетаФактуры);
			
			Документы.СчетФактураВыданный.ЗаполнитьКолонкиСчетов(РеквизитыШапки, ДанныеНоменклатурыДляСФ, ДокументСФ, Истина);
			
			ДокументСФ.СоставНФА.Загрузить(ДанныеНоменклатурыДляСФ);
			
			ДокументСФ.ДокументОснование = ДокументСсылка;
			
		ИначеЕсли ИмяТаблицы = "Возвраты" Тогда	
			
			ДокументСФ = Документы.КорректировочныйСчетФактураВыданный.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(ДокументСФ, РеквизитыШапки);
			
			ДокументСФ.Дата                   = СтрокаТаблицы.ДатаСФ;
			ДокументСФ.Контрагент             = СтрокаТаблицы.Покупатель;
			ДокументСФ.Договор                = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
			ДокументСФ.ВариантРегистрации     = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
			ДокументСФ.Ответственный          = Пользователи.ТекущийПользователь();
			ДокументСФ.Комментарий     = 
				НСтр("ru = 'Создан автоматически на основании документа отчет комиссионера о продажах'");
			
			ЗаполнитьТаблицуПокупатели(ДокументСФ, ДанныеСчетовФактур, СтрокаТаблицы.СводныйСФ);
				
			ДокументСФ.КодВидаОперации = "18";
				
			ДокументСФ.КодСпособаВыставления	= 1;
			ДокументСФ.Выставлен				= Истина;
			ДокументСФ.ДатаВыставления			= Объект.Дата;
			
			Документы.КорректировочныйСчетФактураВыданный.УстановитьОтветственныхЛиц(ДокументСФ);
			
			ДокументСФ.ДокументКорректировки = ДокументСсылка;
			
		ИначеЕсли ИмяТаблицы = "ДенежныеСредства" Тогда
			
			ДокументСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(ДокументСФ, РеквизитыШапки);
			
			ДокументСФ.Дата                   = СтрокаТаблицы.ДатаСФ;
			ДокументСФ.Контрагент             = СтрокаТаблицы.Покупатель;
			ДокументСФ.Договор                = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
			ДокументСФ.Ответственный          = Пользователи.ТекущийПользователь();
			ДокументСФ.Комментарий     = 
				НСтр("ru = 'Создан автоматически на основании документа отчет комиссионера о продажах'");
				
			ДокументСФ.КодВидаОперации = "02";
				
			ДокументСФ.КодСпособаВыставления	= 1;
			ДокументСФ.Выставлен				= Истина;
			ДокументСФ.ДатаВыставления			= Объект.Дата;
			
			РеквизитыШапки.Вставить("Контрагент", ДокументСФ.Контрагент);
			
			ДанныеАвансовДляСФ = ПолучитьТаблицуСоставНФАПоАвансам(ОбъектФормы, ДокументСФ, РеквизитыШапки, ДанныеСчетовФактур);
			
			ДокументСФ.СоставНФА.Загрузить(ДанныеАвансовДляСФ);
			
			Документы.СчетФактураВыданный.УстановитьОтветственныхЛиц(ДокументСФ);
			
			ДокументСФ.ДокументОснование = ДокументСсылка;
			
		КонецЕсли;
		
		ДокументСФ.Записать();
		
		// Этот новый счет-фактуру нужно зафиксировать в таблице счетов-фактур
		СтрокаСФ = ПодчиненныеСчетаФактуры.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
		ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
		
		Если НЕ ИмяТаблицы = "ДенежныеСредства" Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("КлючСтроки", СтрокаТаблицы.КлючСтроки);
			СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
			Если СтрокаТЧ <> Неопределено Тогда 
				СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
				СтрокаСФ.Использован = Истина;
			КонецЕсли;
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("Покупатель", СтрокаТаблицы.Покупатель);
			СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
			Если СтрокаТЧ <> Неопределено Тогда
				СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
				СтрокаСФ.Использован = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ДанныеСчетовФактурПоДокументу(ИмяТаблицы, ОбъектФормы, ТабличнаяЧастьДляСФ)
	
	ТаблицаДокумента = ОбъектФормы[ИмяТаблицы];
	
	//Если счета-фактуры генерируются сводно, то получим из таблицы счета-фактуры которые будут сводными
	ТаблицаДатСФ = Новый ТаблицаЗначений;
	Если Объект.ВыписыватьСчетаФактурыСводно И ТабличнаяЧастьДляСФ = "Покупатели" Тогда
		ТаблицаДатСФ = ТаблицаДокумента.Выгрузить().Скопировать(Новый Структура("ВыставленСФ", Истина),"ДатаСФ");
		ТаблицаДатСФ.Колонки.Добавить("КоличествоСФ", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
		ТаблицаДатСФ.ЗаполнитьЗначения(1, "КоличествоСФ");
		ТаблицаДатСФ.Свернуть("ДатаСФ", "КоличествоСФ");
	КонецЕсли;
	
	ПоляКолонок  = "Покупатель, ДатаСФ, СчетФактура";
	Если Не ИмяТаблицы = "ДенежныеСредства" Тогда
		ПоляКолонок = ПоляКолонок + ", КлючСтроки";
	КонецЕсли;
	
	ДанныеСчетовФактур = ТаблицаДокумента.ВыгрузитьКолонки(ПоляКолонок);
	ДанныеСчетовФактур.Колонки.Добавить("НомерСФ", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ДанныеСчетовФактур.Колонки.Добавить("СводныйСФ", Новый ОписаниеТипов("Булево"));
	ДанныеСчетовФактур.Колонки.Добавить("ЕдиныйСФ", Новый ОписаниеТипов("Булево"));
	ДанныеСчетовФактур.Колонки.Добавить("ПокупательСФ", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	Для каждого СтрокаТабличнойЧасти Из ТаблицаДокумента Цикл
		Если СтрокаТабличнойЧасти.ВыставленСФ Тогда
			НоваяСтрока = ДанныеСчетовФактур.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
			НоваяСтрока.ПокупательСФ = СтрокаТабличнойЧасти.Покупатель;
			СчетФактураПоДате = ТаблицаДатСФ.Найти(СтрокаТабличнойЧасти.ДатаСФ);
			Если СчетФактураПоДате <> Неопределено
				И СчетФактураПоДате.КоличествоСФ > 1 Тогда 
				//переопределим покупателя, установим признак СводныйСФ
				НоваяСтрока.Покупатель = Объект.Контрагент;
				НоваяСтрока.СводныйСФ = Истина;
			Иначе
				НоваяСтрока.СводныйСФ = Ложь;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаТабличнойЧасти.СчетФактура) Тогда
			СтрокаТабличнойЧасти.СчетФактура = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	// Самые ранние счета-фактуры создаем сначала
	ДанныеСчетовФактур.Сортировать("ДатаСФ Возр");
	
	Возврат ДанныеСчетовФактур;

КонецФункции

&НаСервере
Функция ПолучитьТаблицуПодчиненныхСчетовФактур(РезультатЗапроса)

	ТаблицаСФ = РезультатЗапроса.Выгрузить();
	ТаблицаСФ.Колонки.Добавить("Использован", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаСФ;

КонецФункции

&НаСервере
Функция НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаДокумента, ИмяТаблицы, СписокДобавленныхСФ)
	
	СтруктураПоиска  = Новый Структура("Ссылка", СтрокаДокумента.СчетФактура);
	НайденныеСтроки  = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Покупатель = СтрокаДокумента.Покупатель
			ИЛИ НЕ ЗначениеЗаполнено(НайденнаяСтрока.Покупатель) Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураПоиска = Новый Структура("ДатаСФ", СтрокаДокумента.ДатаСФ);
	НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Покупатель = СтрокаДокумента.Покупатель
			ИЛИ НЕ ЗначениеЗаполнено(НайденнаяСтрока.Покупатель) Тогда
			
			Если СтрокаДокумента.СводныйСФ Тогда
				// найден подходящий счет-фактура
				Возврат НайденнаяСтрока;
			ИначеЕсли НайденнаяСтрока.КлючСтроки <> Неопределено Тогда
				Если НайденнаяСтрока.КлючСтроки = СтрокаДокумента.КлючСтроки Тогда
					// найден подходящий счет-фактура
					Возврат НайденнаяСтрока;
				Иначе
					Продолжить;
				КонецЕсли;
			ИначеЕсли СписокДобавленныхСФ.НайтиПоЗначению(НайденнаяСтрока.Ссылка) <> Неопределено Тогда
				Продолжить;
			Иначе
				// найден подходящий счет-фактура
				Возврат НайденнаяСтрока;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПолучитьТаблицуНоменклатурыДляСФ(ОбъектФормы, ДокументСФ, СтрокаТаблицы, КлючиСчетаФактуры)
	
	ТаблицыДокумента = Новый Структура;
	
	ТаблицыДокумента.Вставить("Номенклатура", ОбъектФормы.Номенклатура);
	ТаблицыДокумента.Вставить("Услуги", ОбъектФормы.Услуги);
	
	ДанныеНоменклатурыДляСФ = ТаблицыДокумента.Номенклатура.ВыгрузитьКолонки("ЕдиницаИзмерения, Количество, Сумма, Цена, Всего, СтавкаНДС, СуммаНДС");
	ДанныеНоменклатурыДляСФ.Колонки.Добавить("НФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	ПараметрыОтбора = Новый Структура;
	
	Для каждого ТаблицаДокумента Из ТаблицыДокумента Цикл
		Для Каждого КлючСтроки Из КлючиСчетаФактуры Цикл
			ПараметрыОтбора.Вставить("КлючСтроки", КлючСтроки);
			НайденныеСтроки = ТаблицаДокумента.Значение.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаПоКлючу Из НайденныеСтроки Цикл
				СтрокаТЧ = ДанныеНоменклатурыДляСФ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаПоКлючу);
				
				СтрокаТЧ.НФА = СтрокаПоКлючу.Номенклатура;
				
				Если ОбъектФормы.СуммаВключаетНДС Тогда 
					СтрокаТЧ.Сумма = СтрокаПоКлючу.Всего - СтрокаПоКлючу.СуммаНДС;
				Иначе
					СтрокаТЧ.Сумма = СтрокаПоКлючу.Сумма;
				КонецЕсли;
				
				Если ОбъектФормы.СуммаВключаетНДС И НЕ СтрокаПоКлючу.Сумма = 0 Тогда 
					СтрокаТЧ.Цена = СтрокаПоКлючу.Цена - СтрокаПоКлючу.СуммаНДС * (СтрокаПоКлючу.Цена / СтрокаПоКлючу.Сумма);
				Иначе
					СтрокаТЧ.Цена = СтрокаПоКлючу.Цена;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДанныеНоменклатурыДляСФ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуПокупатели(ДокументСФ, ДанныеСчетовФактур, СводныйКомиссионныйСчетФактура)
	
	Для каждого СтрокаПокупатели Из ДанныеСчетовФактур Цикл
		Если СтрокаПокупатели.ДатаСФ = НачалоДня(ДокументСФ.Дата) И СтрокаПокупатели.Покупатель = ДокументСФ.Контрагент Тогда
			СтрокаТЧ = ДокументСФ.СчетаФактурыОтКомиссионера.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаПокупатели);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуСоставНФАПоАвансам(ОбъектФормы, ДокументСФ, РеквизитыШапки, ДанныеСчетовФактур)
	
	МетаданныеТабличныхЧастей = Метаданные.Документы.СчетФактураВыданный.ТабличныеЧасти;
	
	ТаблицаСоставНФА = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(МетаданныеТабличныхЧастей.СоставНФА);
	
	ПредставлениеПозицииАванса = УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса();
	
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(Объект.Ссылка, "КДБ");
	
	Для каждого СтрокаТабличнойЧасти Из ОбъектФормы.ДенежныеСредства Цикл
		Если СтрокаТабличнойЧасти.ВыставленСФ Тогда
			Если СтрокаТабличнойЧасти.Покупатель = ДокументСФ.Контрагент Тогда
				НоваяСтрока = ТаблицаСоставНФА.Добавить();
				НоваяСтрока.НФА = ПредставлениеПозицииАванса;
				НоваяСтрока.Всего = СтрокаТабличнойЧасти.Сумма;
				НоваяСтрока.СтавкаНДС = СтрокаТабличнойЧасти.СтавкаНДС;
				НоваяСтрока.СуммаНДС = СтрокаТабличнойЧасти.СуммаНДС;
				НоваяСтрока.КПССчетРасчетов	= Основание_ТиповаяОперация.КДБ;
				НоваяСтрока.КПСВычетКт		= Основание_ТиповаяОперация.КДБ;
				НоваяСтрока.КПСНачислениеДт	= Основание_ТиповаяОперация.КДБ;
				НоваяСтрока.НДСКВычету		= Истина;
				НоваяСтрока.СчетРасчетов	= БухгалтерскийУчет.СчетПоКоду("АК");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Удаляем колонки для их автоматического заполнения далее.
	УдаляемыеКолонки = Новый Массив();
	УдаляемыеКолонки.Добавить("СчетНачислениеДт");
	УдаляемыеКолонки.Добавить("КЭКНачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто1НачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто2НачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто3НачислениеДт");
	УдаляемыеКолонки.Добавить("СчетВычетКт");
	УдаляемыеКолонки.Добавить("Счет30304");
	УдаляемыеКолонки.Добавить("КПС30304");
	
	Для Каждого ИмяКолонки Из УдаляемыеКолонки Цикл
		ТаблицаСоставНФА.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
	Документы.СчетФактураВыданный.ЗаполнитьКолонкиСчетов(РеквизитыШапки, ТаблицаСоставНФА, ДокументСФ, Истина);
			
	УчетНДСКлиентСервер.ПрименитьСтавкуДляАванса(ТаблицаСоставНФА, ДокументСФ.Дата, НоваяСтрока.СтавкаНДС);
	
	Возврат ТаблицаСоставНФА;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляЗаполненияШапкиСчетаФактуры(ОснованиеСсылка, ТабличнаяЧастьДляСФ)
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ТабличнаяЧастьДляСФ", ТабличнаяЧастьДляСФ);
	
	ЗапросЗаполнение.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка КАК ДокументОснование,
	|	ОтчетКомиссионера.Дата КАК Дата,
	|	ОтчетКомиссионера.Организация КАК Организация,
	|	ОтчетКомиссионера.ИФО КАК ИФО,
	|	ОтчетКомиссионера.Подразделение КАК Подразделение,
	|	ОтчетКомиссионера.Контрагент КАК Посредник,
	|	ОтчетКомиссионера.Договор КАК Договор,
	|	ОтчетКомиссионера.ВалютаДокумента КАК ВалютаДокумента,
	|	ОтчетКомиссионера.КФО КАК КФО,
	|	ЛОЖЬ КАК РеализацияПоСтавке0,
	|	ВЫБОР
	|		КОГДА &ТабличнаяЧастьДляСФ = ""ДенежныеСредства""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаРеализацию)
	|	КОНЕЦ КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ОтчетКомиссионера
	|ГДЕ
	|	ОтчетКомиссионера.Ссылка = &ДокументОснованиеСсылка";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	Возврат Шапка;
	
КонецФункции

Функция ПолучитьОтветственныхЛиц(Шапка)
	
	ОтветственныеЛица = Новый Структура();
	ОтветственныеЛица.Вставить("Руководитель");
	ОтветственныеЛица.Вставить("ГлавныйБухгалтер");
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Организация")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Дата")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Подразделение") Тогда
		Возврат ОтветственныеЛица;
	КонецЕсли;
	
	ЛицоРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ЛицоГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ОтветственныеЛица.Руководитель		= ЛицоРуководитель.ОтветственноеЛицоСсылка;
	ОтветственныеЛица.ГлавныйБухгалтер	= ЛицоГлавныйБухгалтер.ОтветственноеЛицоСсылка;
	
	Возврат ОтветственныеЛица;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуПередачиПоДаннымПартии(Партия, Номенклатура)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", Партия);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускМ15Материалы.Цена КАК Цена
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
	|ГДЕ
	|	НакладнаяНаОтпускМ15Материалы.Ссылка = &Ссылка
	|	И НакладнаяНаОтпускМ15Материалы.Номенклатура = &Номенклатура";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Цена;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовДокумента(Форма)
	
	Объект = Форма.Объект;
	ЭтоОптовыеПродажи = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтчетКомиссионера.ОтчетОПродажах"));
	ЭтоРозничныеПродажи = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтчетКомиссионера.ОтчетОРозничныхПродажах"));
	
	ИменаЭлементовОптовыхПродаж = Новый Массив;
	ИменаЭлементовОптовыхПродаж.Добавить("ГруппаСводныеСчетаФактуры");
	ИменаЭлементовОптовыхПродаж.Добавить("ПокупателиТоварыВыставленСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ПокупателиТоварыНомерСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ПокупателиТоварыДатаСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ПокупателиПредставлениеСчетаФактуры");
	ИменаЭлементовОптовыхПродаж.Добавить("ПокупателиСоздатьСчетаФактурыПоДаннымРеализации");
	ИменаЭлементовОптовыхПродаж.Добавить("ГруппаНадписиПоСчетамФактурам");
	ИменаЭлементовОптовыхПродаж.Добавить("ВозвратыЗаголовокСчетФактура");
	ИменаЭлементовОптовыхПродаж.Добавить("ВозвратыГруппаПолученныеОтКомиссионера");
	ИменаЭлементовОптовыхПродаж.Добавить("ВозвратыВыставленныеКомиссионеру");
	ИменаЭлементовОптовыхПродаж.Добавить("СоздатьКорректировочныеСчетаФактурыПоДаннымВозвратов");
	ИменаЭлементовОптовыхПродаж.Добавить("ДенежныеСредстваВыставленСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ДенежныеСредстваНомерСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ДенежныеСредстваДатаСФ");
	ИменаЭлементовОптовыхПродаж.Добавить("ДенежныеСредстваПредставлениеСчетаФактуры");
	ИменаЭлементовОптовыхПродаж.Добавить("ДенежныеСредстваСоздатьСчетаФактурыПоДаннымАвансов");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовОптовыхПродаж,
		"Видимость", ЭтоОптовыеПродажи);
	
	ИменаЭлементовРозничныхПродаж = Новый Массив;
	ИменаЭлементовРозничныхПродаж.Добавить("КонтрагентДляРозничныхПродаж");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовРозничныхПродаж,
		"Видимость", ЭтоРозничныеПродажи);
	
КонецПроцедуры

&НаСервере
Процедура ТоварыВозвращенныеНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ДанныеОбъекта)
	
	СведенияОНоменклатуре = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СтрокаТабличнойЧасти.Номенклатура, "НаименованиеПолное, ТипНоменклатуры, ЕдиницаИзмерения");
		
	Если СведенияОНоменклатуре = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.ЕдиницаИзмерения		= СведенияОНоменклатуре.ЕдиницаИзмерения;
	
	РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти);
	РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, ДанныеОбъекта.СуммаВключаетНДС);
	РассчитатьВознаграждениеВСтроке(СтрокаТабличнойЧасти, "ТоварыВозвращенные", ДанныеОбъекта);
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеВозвратыУстановитьОтборСтрок()
	
	ТекДанныеВозвраты = Элементы.Возвраты.ТекущиеДанные;
	Если ТекДанныеВозвраты <> Неопределено Тогда
		КлючСтроки = ТекДанныеВозвраты.КлючСтроки;
		Элементы.ТоварыВозвращенные.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", КлючСтроки);
	Иначе
		Элементы.ТоварыВозвращенные.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", 0);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораВозвратыПредставлениеСчетаФактуры(ТекущаяСтрока)

	Если ЗначениеЗаполнено(ТекущаяСтрока.СчетФактура) Тогда
		
		ОткрытьСчетФактуру(ЭтаФорма, ТекущаяСтрока.СчетФактура, "КорректировочныйСчетФактураВыданный");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСуммыПоСтрокеВозвраты(КлючСтроки, НоваяСуммаПоСтроке, НоваяСуммаНДСПоСтроке)
	
	Отбор = Новый Структура("КлючСтроки", КлючСтроки);
	
	МассивСтрок = Объект.Возвраты.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокиПокупателя = МассивСтрок[0];
	
	РазницаСумм = НоваяСуммаПоСтроке - СуммаПоСтрокеДоИзмененияВозвраты;
	РазницаНДС  = НоваяСуммаНДСПоСтроке - СуммаНДСПоСтрокеДоИзмененияВозвраты;
	
	СуммаПоСтрокеДоИзмененияВозвраты    = НоваяСуммаПоСтроке; 
	СуммаНДСПоСтрокеДоИзмененияВозвраты = НоваяСуммаНДСПоСтроке;
	
	ДанныеСтрокиПокупателя.Всего = ДанныеСтрокиПокупателя.Всего + РазницаСумм + ?(Объект.СуммаВключаетНДС, 0, РазницаНДС);
	ДанныеСтрокиПокупателя.НДС   = ДанныеСтрокиПокупателя.НДС + РазницаНДС;
	ДанныеСтрокиПокупателя.ВсегоПоСФ = ?(ДанныеСтрокиПокупателя.ВыставленСФ, ДанныеСтрокиПокупателя.Всего, 0);
	ДанныеСтрокиПокупателя.НДСПоСФ   = ?(ДанныеСтрокиПокупателя.ВыставленСФ, ДанныеСтрокиПокупателя.НДС, 0);
	ОбновитьИтоги(ЭтаФорма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьДанныеВыбораДокументРеализации()
	
	ДанныеВыбора = Новый СписокЗначений;
	
	ПредставлениеСтроки = Новый Массив;
	
	СтрокаПредставление = НСтр("ru='Текущий документ'");
	СтрокаЗначение = "ТекущийДокумент";
	ПредставлениеСтроки.Добавить(Новый ФорматированнаяСтрока(СтрокаПредставление));
	ДанныеВыбора.Добавить(СтрокаЗначение, Новый ФорматированнаяСтрока(ПредставлениеСтроки));
	
	ПредставлениеСтроки = Новый Массив;
	СтрокаПредставление = НСтр("ru='<...>'");
	СтрокаЗначение = "ОтключитьТекущийДокумент";
	ПредставлениеСтроки.Добавить(Новый ФорматированнаяСтрока(СтрокаПредставление));
	ДанныеВыбора.Добавить(СтрокаЗначение, Новый ФорматированнаяСтрока(ПредставлениеСтроки));
	
	Возврат ДанныеВыбора;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьВозвратыПоДокументу()

	ПараметрыФормы = Новый Структура;
	
	ТекущаяСтрокаВозвраты = Элементы.Возвраты.ТекущиеДанные;
	
	Если ТекущаяСтрокаВозвраты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьВозвратПоРеализацииЗавершение", ЭтотОбъект);	
	
	ОткрытьФорму("Документ.ОтчетКомиссионера.ФормаВыбора",
	ПараметрыФормы, Элементы.ТоварыВозвращенные, , , , ОповещениеОЗакрытии);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВозвратПоРеализацииЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Результат = РезультатЗакрытия;
	
	ДанныеВозвраты = Элементы.Возвраты.ТекущиеДанные;
	Если ДанныеВозвраты <> Неопределено Тогда
		
		ЗаполнитьПоДокументу(Результат, ДанныеВозвраты.Покупатель, ДанныеВозвраты.КлючСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументу(Сделка, Покупатель, КлючСтроки)
	
	Если Сделка <> Неопределено Тогда
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.ЗаполнитьПоДокументу(Сделка, Покупатель, КлючСтроки);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
		ЗаполнитьДобавленныеКолонкиТаблиц();
		ОбновитьИтоги(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВозвращенныеДокументРеализацииНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущаяСтрокаВозвраты = Элементы.Возвраты.ТекущиеДанные;
	
	Если ТекущаяСтрокаВозвраты.ВыставленСФ Тогда
	
		СтандартнаяОбработка = Ложь;
	
		ПараметрыФормы = Новый Структура;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Объект.Организация);
		Отбор.Вставить("Контрагент", Объект.Контрагент);

		ПараметрыФормы.Вставить("Отбор", Отбор);
			
		ОткрытьФорму("Документ.ОтчетКомиссионера.Форма.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКолонкамиВозврат(Форма)

	СпособРегистрацииСчетФактуры = Форма.СпособРегистрацииСчетФактуры;
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ОтображатьВозврат = Истина;
	
	Элементы.ВозвратыГруппаПолученныеОтКомиссионера.ОтображатьВШапке = ОтображатьВозврат;
	Элементы.ВозвратыПредставлениеСчетаФактуры.ОтображатьВШапке = НЕ ОтображатьВозврат;
	Элементы.ВозвратыВыставленныеКомиссионеру.ОтображатьВШапке = ОтображатьВозврат;
	Элементы.ВозвратыЗаголовокСчетФактура.Заголовок = 
		?(ОтображатьВозврат, НСтр("ru = 'Корректировочный счет-фактура'"), НСтр("ru = 'СФ'"));
	
	Элементы.ВозвратыГруппаПояснение.Видимость = ОтображатьВозврат;
	Элементы.ВозвратыНомерСФ.Заголовок = ?(ОтображатьВозврат, НСтр("ru = 'Номер'"), НСтр("ru = 'Номер СФ'"));
	Элементы.ВозвратыДатаСФ.Заголовок = ?(ОтображатьВозврат, НСтр("ru = 'Дата'"), НСтр("ru = 'Дата СФ'"));
	Элементы.ВозвратыКСчетамФактурамКомиссионера.Видимость = ОтображатьВозврат;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыВТаблицеВозвратов()

	ТекущиеДанные = Элементы.Возвраты.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
	
		КлючСтроки = ТекущиеДанные.КлючСтроки;
		
		НайденныеСтроки = Объект.ТоварыВозвращенные.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки));
		
		Для каждого ТекущаяСтрокаНайденныеСтроки Из НайденныеСтроки Цикл
		
			ТекущаяСтрокаНайденныеСтроки.ДокументРеализации = "";
			ТекущаяСтрокаНайденныеСтроки.ПоТекущемуДокументу = Ложь;
		
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуПоСчетуФактуре(СтрокаТаблицы)

	Если СтрокаТаблицы.ВыставленСФ Тогда
	
		СтрокаТаблицы.ПредставлениеСчетаФактуры = 
			ОписаниеПеревыставленногоСчетаФактуры(СтрокаТаблицы.СчетФактура);
				
	Иначе
	
		СтрокаТаблицы.ПредставлениеСчетаФактуры = "";

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратыОбработкаЗаполненияЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
	
		ЗаполнитьВозвратыПоДокументу();

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСчетУчетаПоУмолчаниюВПодборе(СписокПодбора);

СписокПодбора.Колонки.Добавить("СчетУчетаПоУмолчанию");




КонецПроцедуры

