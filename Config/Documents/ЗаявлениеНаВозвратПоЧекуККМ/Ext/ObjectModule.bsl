#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМ") Тогда
		ЗаполнитьПоЧекуККМ(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ЗаявлениеНаВозвратПоЧекуККМ.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по учету остатков
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ТоварыВТорговыхТочках");
	
	ПроверитьКодыМаркировки();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры


#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоЧекуККМ(ДокументОснование)

	ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
	|ЭтоРозничныйПокупатель, ФормаОплаты, СуммаДокумента, НомерЧекаККМ, ТипЦены, СуммаВключаетНДС, Подразделение";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	Если ДокументОснование.НомерЧекаККМ<>0 Тогда
		ЭтотОбъект.НомерЧекаККМ = ДокументОснование.НомерЧекаККМ;
		ЭтотОбъект.ДатаЧекаККМ = ДокументОснование.Дата;
	Иначе
		ДанныеЧека = ПодключаемоеОборудованиеБГУ.ДанныеЧека(ДокументОснование);
		ЭтотОбъект.НомерЧекаККМ = ДанныеЧека.НомерЧекаККМ;	 
		ЭтотОбъект.ДатаЧекаККМ = ДанныеЧека.ДатаЧекаККМ;
	КонецЕсли;	
	
	ЗаполнятьКонтрагентаИДоговор = ЗаполнятьКонтрагентаИДоговор(ДанныеДокументаОснования.КассаККМ, ДанныеДокументаОснования.ЭтоРозничныйПокупатель);
	
	Если ЗаполнятьКонтрагентаИДоговор Тогда
		ЭтотОбъект.Выдать = Строка(ДанныеДокументаОснования.Контрагент);	
		ЭтотОбъект.Основание = Строка(ДанныеДокументаОснования.Договор);	
	КонецЕсли;	
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	
	Если ЭтотОбъект.ФормаОплаты = 2 Тогда 
		ЭтотОбъект.ФормаОплаты = 1;	
	КонецЕсли;	
	Если ЭтотОбъект.ФормаОплаты = 1 Тогда 
		ЭтотОбъект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
	Иначе
		ЭтотОбъект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
	КонецЕсли;	
	
	ТЧ_ТоварыРаботыУслуги = ДокументОснование.ТоварыРаботыуслуги.Выгрузить();
	ТЧ_РасшифровкаОплаты = ДокументОснование.РасшифровкаОплаты.Выгрузить();
	
	ЭтотОбъект.ТоварыРаботыуслуги.Загрузить(ТЧ_ТоварыРаботыУслуги);
	ЭтотОбъект.РасшифровкаОплаты.Загрузить(ТЧ_РасшифровкаОплаты);
	
КонецПроцедуры

Функция ЗаполнятьКонтрагентаИДоговор(КассаККМ, ЭтоРозничныйПокупатель)
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, "ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя");
		ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя = ЗначенияРеквизитов.ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя;
	Иначе
		ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя = Ложь;
	КонецЕсли;	
	
	Если ЭтоРозничныйПокупатель Тогда
		Если ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя Тогда
			ЗаполнятьКонтрагентаИДоговор = Истина;
		Иначе
			ЗаполнятьКонтрагентаИДоговор = Ложь;
		КонецЕсли;	
	Иначе	
		ЗаполнятьКонтрагентаИДоговор = Истина;
	КонецЕсли;
	
	Возврат ЗаполнятьКонтрагентаИДоговор;
КонецФункции

Процедура ПроверитьКодыМаркировки()
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	Если НЕ ДополнительныеСвойства.Свойство("СозданИзРМК") И РозничнаяРеализацияМаркированныхТоваров Тогда 
		Для Каждого СтрокаТаблицы Из ЭтотОбъект.ТоварыРаботыУслуги Цикл 
			Если СтрокаТаблицы.МаркируемыйТовар И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КодМаркировки) Тогда 
				ТекстОшибки = НСтр("ru='В строке %1 списка ""Товары, работы, услуги"" не заполнен код маркировки!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ТоварыРаботыУслуги", "Объект");
			КонецЕсли;	
			Если СтрокаТаблицы.МаркируемыйТовар И СтрокаТаблицы.Количество <> 1 Тогда 
				ТекстОшибки = НСтр("ru='В строке %1 списка ""Товары, работы, услуги"" количество не равно 1!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ТоварыРаботыУслуги", "Объект");
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли