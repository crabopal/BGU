&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	ДокументОснование = Объект.ДокументОснование;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
		|ЭтоРозничныйПокупатель, ФормаОплаты, СуммаДокумента, НомерЧекаККМ, ТипЦены, СуммаВключаетНДС";
		ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
		ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
		
		Если ДокументОснование.НомерЧекаККМ<>0 Тогда
			Объект.НомерЧекаККМ = ДокументОснование.НомерЧекаККМ;
			Объект.ДатаЧекаККМ = ДокументОснование.Дата;
		Иначе
			ДанныеЧека = ПодключаемоеОборудованиеБГУ.ДанныеЧека(ДокументОснование);
			Объект.НомерЧекаККМ = ДанныеЧека.НомерЧекаККМ;	 
			Объект.ДатаЧекаККМ = ДанныеЧека.ДатаЧекаККМ;
		КонецЕсли;	
		
		Если Объект.ФормаОплаты = 2 Тогда 
			Объект.ФормаОплаты = 1;
		КонецЕсли;	
		Если Объект.ФормаОплаты = 1 Тогда 
			Объект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		Иначе
			Объект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
		КонецЕсли;
		
		ТЧ_ТоварыРаботыУслуги = ДокументОснование.ТоварыРаботыуслуги.Выгрузить();
		ТЧ_РасшифровкаОплаты = ДокументОснование.РасшифровкаОплаты.Выгрузить();
		
		Объект.ТоварыРаботыуслуги.Загрузить(ТЧ_ТоварыРаботыУслуги);
		Объект.РасшифровкаОплаты.Загрузить(ТЧ_РасшифровкаОплаты);
	Иначе	
		Объект.НомерЧекаККМ = "";
		Объект.ДатаЧекаККМ = ДАТА(1,1,1);
		Объект.СистемаНалогообложенияЧекаККМ = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ПустаяСсылка();
		Объект.ПараметрыДоговораПлатежногоАгента = Справочники.ПараметрыДоговораПлатежногоАгента.ПустаяСсылка();
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		Объект.Договор = Справочники.Договоры.ПустаяСсылка();
		Объект.СуммаДокумента = 0;
		Объект.ЭтоРозничныйПокупатель = Ложь;
		Объект.ФормаОплаты = 0;
		Объект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПустаяСсылка();
		Объект.КассаККМ = Справочники.ФискальныеРегистраторы.ПустаяСсылка();
		Объект.ТоварыРаботыУслуги.Очистить();
		Объект.РасшифровкаОплаты.Очистить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма)
	Объект = Форма.Объект;
	
	ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
	
	Если Объект.НомерЧекаККМ > 0 Тогда
		Если ИспользуетсяККТСПередачейДанных Тогда
			ТекстНомераЧека = НСтр("ru='ФД № '")+Формат(Объект.НомерЧекаККМ,"ЧГ=");
		Иначе	
			ТекстНомераЧека = НСтр("ru='чек № '")+Формат(Объект.НомерЧекаККМ,"ЧГ=");
		КонецЕсли;
		ТекстЗаголовкаДанныхЧека = ТекстНомераЧека+?(Объект.ДатаЧекаККМ = Дата(1,1,1), "", НСтр("ru=' от '")+Формат(Объект.ДатаЧекаККМ, "ДФ=dd.MM.yyyy"));
	Иначе
		ТекстЗаголовкаДанныхЧека = "";
	КонецЕсли;	
	
	Форма.ДанныеЗаголовкаСтраницыЧекаККМ = ТекстЗаголовкаДанныхЧека;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаОплата(Форма)
	
	Объект = Форма.Объект;
	ИтогОплатаВсего = Объект.ТоварыРаботыУслуги.Итог("Всего");
	
	ТекстЗаголовкаДанныхОплатыИЧека = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 %2'"),
			Формат(ИтогОплатаВсего, "ЧЦ=15; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));
			
	Форма.ДанныеЗаголовкаОплата = ТекстЗаголовкаДанныхОплатыИЧека;
КонецПроцедуры

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.ИспользоватьВалютныйУчет);
	
	Форма.НадписьТипЦенНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если СуммаВключаетНДСДоИзменения <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
			РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Сумма");
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	Если ТипЦеныДоИзменения <> Объект.ТипЦены Тогда
		
		Если Объект.ТоварыРаботыУслуги.Количество() = 0 ИЛИ Не ЗначениеЗаполнено(Объект.ТипЦены) Тогда
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Изменился тип цены.
							|Пересчитать цены в таблице документа?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Да, пересчитать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Нет, не пересчитывать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не изменять тип цены");

		ПоказатьВопрос(Новый ОписаниеОповещения("ТипЦеныПриИзмененииЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Отмена);
		
	КонецЕсли;

КонецПроцедуры
	
&НаКлиенте
Процедура ТипЦеныПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПересчитатьЦеныНоменклатуры();
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Нет Тогда
		Объект.ТипЦены = ТипЦеныДоИзменения;
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныНоменклатуры()

	МассивНоменклатуры = МассивНоменклатуры(Объект.ТоварыРаботыУслуги.Выгрузить(, "Номенклатура"));
	
	ТаблицаЦен = ПолучитьЦенуНоменклатуры(МассивНоменклатуры,
		Объект.ТипЦены, Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
	
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрока.Номенклатура.Номенклатура, "Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			ТекСтрока.Цена = СтрокаЦены.Цена;
		Иначе
			ТекСтрока.Цена = 0;
		КонецЕсли;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

	ОбновитьДанныеЗаголовкаОплата(ЭтаФорма);
	
КонецПроцедуры // ПересчитатьЦеныНоменклатуры()

&НаСервере
Функция МассивНоменклатуры(МассивИзПрейскуранта)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Номенклатура
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Ссылка В(&МассивИзПрейскуранта)";
	Запрос.УстановитьПараметр("МассивИзПрейскуранта", МассивИзПрейскуранта);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.ВыгрузитьКолонку("Номенклатура");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура.Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ", "");
		СтруктураРеквизитов.Вставить("СуммаВключаетНДС", "");
		СтруктураРеквизитов.Вставить("ТипЦены", "");
		СтруктураРеквизитов.Вставить("Подразделение", "");
		
		РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, СтруктураРеквизитов);
		
		Объект.ТипЦены = РеквизитыККТ.ТипЦены;
		Объект.СуммаВключаетНДС = РеквизитыККТ.СуммаВключаетНДС;
		Объект.СистемаНалогообложенияЧекаККМ = РеквизитыККТ.СистемаНалогообложенияЧекаККМ;
		Объект.Подразделение = РеквизитыККТ.Подразделение;
		
		ВестиКонтрольОстатковТоваров = РозничныеПродажиБГУ.ВестиКонтрольОстатковТоваров(Объект.КассаККМ);
		Если ВестиКонтрольОстатковТоваров Тогда
			Объект.ПоступлениеТоваровНаСкладТорговойТочки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	УстановитьВидимостьУсловноеОформлениеМаркировка();

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеНоменклатуры(НоменклатураСсылка) 
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка.Номенклатура, "СтавкаНДС");
	СтруктураДанных.Вставить("Количество", НоменклатураСсылка.Количество);
	
	Возврат СтруктураДанных;
КонецФункции

&НаСервере
Процедура ЭтоРозничныйПокупательПриИзмененииНаСервере()
	Если Объект.ЭтоРозничныйПокупатель Тогда
		Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
			Объект.Контрагент = Объект.КассаККМ.КонтрагентДляРозничныхПродаж;
			Объект.Договор = Объект.КассаККМ.ДоговорДляРозничныхПродаж;
		КонецЕсли;
	Иначе
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		Объект.Договор = Справочники.Договоры.ПустаяСсылка();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УдалитьТоварыУслугиКромеОтмеченныхНаСервере()
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка", Ложь);
	НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(ПараметрыОтбора);
	ВсегоНайдено = НайденныеСтроки.Количество();
	Если ВсегоНайдено > 0 Тогда
		Для н = 1 По ВсегоНайдено Цикл
			Объект.ТоварыРаботыУслуги.Удалить(НайденныеСтроки[ВсегоНайдено-н].НомерСтроки-1);
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

