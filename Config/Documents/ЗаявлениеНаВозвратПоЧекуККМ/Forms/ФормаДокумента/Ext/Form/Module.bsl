&НаКлиенте
Процедура УдалитьТоварыУслугиКромеОтмеченных(Команда)
	Если Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатЧекаККМ.ПлатежнаяКарта") Тогда
		ТекстВопроса = НСтр("ru = 'Возврат оплаты платежной картой не предполагает частичный возврат. Отменить удаление строк?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Да'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Продолжить'"));
		
		Оповещение = Новый ОписаниеОповещения("УдалитьСтрокиТоваровУслугОбработатьОтвет", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
	Иначе
		УдалитьТоварыУслугиКромеОтмеченныхНаСервере();
	КонецЕсли;
	
КонецПроцедуры

