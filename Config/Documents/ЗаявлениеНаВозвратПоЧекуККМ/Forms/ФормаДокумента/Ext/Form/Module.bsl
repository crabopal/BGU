#Область ОбработчикиСобытийЭлементовТаблицыФормыТоварыРаботыУслуги
&НаКлиенте
Процедура ТоварыРаботыУслугиНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.ТипЦены, Объект.Дата,
		Объект.Организация);
	ТекущиеДанные.Цена = Цена;
	КоличествоПоУмолчанию = 1;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
		ТекущиеДанные.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
		КоличествоПоУмолчанию = ДанныеНоменклатуры.Количество;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = КоличествоПоУмолчанию;
		
		РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
	КонецЕсли;	
	
	ТекущиеДанные.МаркируемыйТовар = МаркируемыйТовар(ТекущиеДанные.ПолучитьИдентификатор());
	
	ОбновитьДанныеЗаголовкаОплата(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПослеУдаления(Элемент)
	ОбновитьДанныеЗаголовкаОплата(ЭтаФорма);
КонецПроцедуры

