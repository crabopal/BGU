
&НаКлиенте
Перем СуммаВключаетНДСДоИзменения;
&НаКлиенте
Перем ТипЦеныДоИзменения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИспользоватьВалютныйУчет = Ложь;
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма);
	ОбновитьДанныеЗаголовкаОплата(ЭтаФорма);
	
	Если Параметры.Ключ.Пустая() Тогда
		ВестиКонтрольОстатковТоваров = РозничныеПродажиБГУ.ВестиКонтрольОстатковТоваров(Объект.КассаККМ);
		Если ВестиКонтрольОстатковТоваров Тогда
			Объект.ПоступлениеТоваровНаСкладТорговойТочки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные Тогда 
		ЭтаФорма.Элементы.СобственныеСредства.Заголовок = "Наличные";	
	Иначе 
		ЭтаФорма.Элементы.СобственныеСредства.Заголовок = "Платежная карта";
	КонецЕсли;	
	СуммаСобственныхСредств 		= Объект.ТоварыРаботыУслуги.Итог("Всего") - Объект.ТоварыРаботыУслуги.Итог("СуммаЭС");
	СуммаЭлектронныхСертификатов 	= Объект.ТоварыРаботыУслуги.Итог("СуммаЭС"); 
	
	УстановитьВидимостьЭлементовФормы();
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	УстановитьВидимостьУсловноеОформлениеМаркировка();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, ЭтаФорма.Элементы.ИнформационныеСсылки);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ИспользоватьВалютныйУчет = Ложь;
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма);
	ОбновитьДанныеЗаголовкаОплата(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьДобавленныеКолонки();
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.СуммаДокумента = Объект.ТоварыРаботыУслуги.Итог("Всего");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЧекККМТоварыРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).ОсновнаяСтатьяАналитикиОплаты КАК СтатьяАналитикиОплаты,
	               |	ЧекККМТоварыРаботыУслуги.Всего КАК СуммаДляОплаты,
	               |	0 КАК Сумма,
	               |	0 КАК СуммаКомиссии,
	               |	1 КАК КлючСвязиОплаты
	               |ИЗ
	               |	Документ.ЗаявлениеНаВозвратПоЧекуККМ.ТоварыРаботыУслуги КАК ЧекККМТоварыРаботыУслуги
	               |ГДЕ
	               |	ЧекККМТоварыРаботыУслуги.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЧекККМТоварыРаботыУслуги.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ТЗ_ТоварыУслуги = РезультатЗапроса.Выгрузить();
	
	ЧекПродажи = Объект.ДокументОснование;
	
	Если ЗначениеЗаполнено(ЧекПродажи) Тогда
		ВсегоОплачено = ЧекПродажи.Оплата[0].Сумма;
		ВсегоКомиссияБанка = ЧекПродажи.Оплата[0].СуммаКомиссии;
		ПроцентБанка = ЧекПродажи.Оплата[0].ПроцентКомиссии; 
		Для каждого ТекТоварУслуга Из ТЗ_ТоварыУслуги Цикл
			Если ВсегоОплачено = 0 Тогда 
				Прервать;
			КонецЕсли;
			
			ПолноеПогашение = Истина;
			Если ВсегоОплачено < ТекТоварУслуга.СуммаДляОплаты Тогда
				ПолноеПогашение = Ложь;
			КонецЕсли;	
			
			ТекТоварУслуга.Сумма = ?(ПолноеПогашение, ТекТоварУслуга.СуммаДляОплаты, ВсегоОплачено);
			Если ВсегоКомиссияБанка > 0 Тогда
				ТекТоварУслуга.СуммаКомиссии = Окр(ТекТоварУслуга.Сумма * ПроцентБанка / 100, 2);	
				
				Если НЕ ПолноеПогашение Тогда
					ТекТоварУслуга.СуммаКомиссии = ВсегоКомиссияБанка;
				КонецЕсли;	
				
				ВсегоКомиссияБанка = ВсегоКомиссияБанка - ТекТоварУслуга.СуммаКомиссии;
			Конецесли;	
			
			ВсегоОплачено = ВсегоОплачено - ТекТоварУслуга.Сумма;
		КонецЦикла;	
		
		ТекущийОбъект.РасшифровкаОплаты.Загрузить(ТЗ_ТоварыУслуги);
	КонецЕсли;
	
	СохранитьДобавленныеКолонки();
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

