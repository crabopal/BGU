Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("Организация");
	Результат.Добавить("ОбъектУчетаИмущества");
	
	Возврат Результат;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	ИмяЭлементаФормыКнопокПечати = "ГруппаКнопкиПечати";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	ПечатныеФормыВидовКартСведенийОбИмуществе.Наименование КАК Наименование,
	|	ПечатныеФормыВидовКартСведенийОбИмуществе.Ссылка КАК ПечатнаяФорма,
	|	ПечатныеФормыВидовКартСведенийОбИмуществе.Владелец КАК ВидКарты
	|ИЗ
	|	Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе КАК ПечатныеФормыВидовКартСведенийОбИмуществе
	|ГДЕ
	|	НЕ ПечатныеФормыВидовКартСведенийОбИмуществе.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПечатныеФормыВидовКартСведенийОбИмуществе.РеквизитДопУпорядочивания";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Сч = 1;
	
	Пока Выборка.Следующий() Цикл
		
		КомандаПечати = КомандыПечати.Добавить();
		
		КомандаПечати.МенеджерПечати = "Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе";
		КомандаПечати.Идентификатор = ИмяЭлементаФормыКнопокПечати + "ПодменюПечать" + ИмяЭлементаФормыКнопокПечати + "ПодменюПечать" + "КомандаПечати" + Строка(Сч-1);
		КомандаПечати.Представление = Выборка.Наименование;
		КомандаПечати.СписокФорм = "ФормаДокумента";
		
		КомандаПечати.ДополнительныеПараметры.Вставить("ВидКарты"		, Выборка.ВидКарты);
		КомандаПечати.ДополнительныеПараметры.Вставить("ПечатнаяФорма"	, Выборка.ПечатнаяФорма);
		КомандаПечати.ДополнительныеПараметры.Вставить("СинонимМакета"	, Выборка.Наименование);
		
		КомандаПечати.Порядок = Сч;
		Сч = Сч + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияРеквизитов.Ссылка.Дата КАК Период,
	|	ЗначенияРеквизитов.Ссылка.Организация КАК Организация,
	|	ЗначенияРеквизитов.Ссылка.ОбъектУчетаИмущества КАК ОбъектУчетаИмущества,
	|	ЗначенияРеквизитов.РеквизитСведений КАК РеквизитСведений,
	|	ЗначенияРеквизитов.Значение КАК Значение,
	|	ЗначенияРеквизитов.ИдентификаторСтрокиТабличнойЧасти КАК ИдентификаторСтрокиТабличнойЧасти
	|ИЗ
	|	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК ЗначенияРеквизитов
	|ГДЕ
	|	ЗначенияРеквизитов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		// У проведенного документа должна быть хотя бы одна запись в регистре
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РегистрацияСведенийОбИмуществе.Дата КАК Период,
		|	РегистрацияСведенийОбИмуществе.Организация КАК Организация,
		|	РегистрацияСведенийОбИмуществе.ОбъектУчетаИмущества КАК ОбъектУчетаИмущества,
		|	РеквизитКартыДокумента.РеквизитСведений КАК РеквизитСведений,
		|	НЕОПРЕДЕЛЕНО КАК Значение,
		|	"""" КАК ИдентификаторСтрокиТабличнойЧасти
		|ИЗ
		|	Документ.РегистрацияСведенийОбИмуществе КАК РегистрацияСведенийОбИмуществе,
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		РеквизитыСведенийОбИмуществе.Ссылка КАК РеквизитСведений
		|	ИЗ
		|		Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
		|	ГДЕ
		|		НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
		|		И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
		|		И РеквизитыСведенийОбИмуществе.Владелец В
		|				(ВЫБРАТЬ
		|					Док.ОбъектУчетаИмущества.ВидКарты
		|				ИЗ
		|					Документ.РегистрацияСведенийОбИмуществе КАК Док
		|				ГДЕ
		|					Док.Ссылка = &Ссылка)) КАК РеквизитКартыДокумента
		|ГДЕ
		|	РегистрацияСведенийОбИмуществе.Ссылка = &Ссылка";
		
		Результат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("СведенияОбОбъектеИмущества", Результат);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
