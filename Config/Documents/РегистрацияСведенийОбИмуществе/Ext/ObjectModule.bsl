#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	// На основании документа "Регистрация сведений об имуществе"
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияСведенийОбИмуществе") Тогда
		
		СтруктураДляЗаполнения = ПолучитьСтруктуруДляЗаполненияПоДокументу(ДанныеЗаполнения);
		ПроверитьДопустимостьЗаполненияПоДокументу(СтруктураДляЗаполнения);
		
		Регистратор = ДанныеЗаполнения;
		
	// На основании объекта учета имущества
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ОбъектыУчетаСистемыУчетаИмущества") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияОбОбъектеИмуществаСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.СведенияОбОбъектеИмущества.СрезПоследних(, ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК СведенияОбОбъектеИмуществаСрезПоследних";
		
		Запрос.УстановитьПараметр("ОбъектУчетаИмущества", ДанныеЗаполнения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Регистратор = Выборка.Регистратор;
		Иначе
			ОбъектУчетаИмущества = ДанныеЗаполнения;
			Организация = ДанныеЗаполнения.Организация;
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
		
		// Типовое заполнение
	Иначе
		Возврат;
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	// Заполняем шапку документа
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Регистратор, "Организация,ОбъектУчетаИмущества");
	ЭтотОбъект.ДокументОснование = Регистратор;
	
	// Заполняем данными документ	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОбОбъектеИмущества.РеквизитСведений КАК РеквизитСведений,
	|	СведенияОбОбъектеИмущества.ИдентификаторСтрокиТабличнойЧасти КАК ИдентификаторСтрокиТабличнойЧасти,
	|	СведенияОбОбъектеИмущества.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.СведенияОбОбъектеИмущества КАК СведенияОбОбъектеИмущества
	|ГДЕ
	|	СведенияОбОбъектеИмущества.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	ЭтотОбъект.ЗначенияРеквизитов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтруктуруДляЗаполненияПоДокументу(ДанныеЗаполнения)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РСИ.ПометкаУдаления КАК ПометкаУдаления,
	|	РСИ.Представление КАК Представление,
	|	РСИ.Проведен КАК Проведен,
	|	РСИ.Ссылка КАК Ссылка,
	|	РСИ.ОбъектУчетаИмущества КАК ОбъектУчетаИмущества
	|ИЗ
	|	Документ.РегистрацияСведенийОбИмуществе КАК РСИ
	|ГДЕ
	|	РСИ.Ссылка = &Ссылка";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	ВыборкаШапки = Запрос.Выполнить().Выбрать();
	ВыборкаШапки.Следующий();
	
	Возврат ВыборкаШапки;
	
КонецФункции

Процедура ПроверитьДопустимостьЗаполненияПоДокументу(СтруктураДляЗаполнения)
	
	Если СтруктураДляЗаполнения.ПометкаУдаления Тогда
		ТекстОшибки = НСтр("ru='Документ %Документ% помечен на удаление. Ввод на основании невозможен.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
		ВызватьИсключение ТекстОшибки;
		
	ИначеЕсли Не СтруктураДляЗаполнения.Проведен Тогда
		ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании невозможен.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
		ВызватьИсключение ТекстОшибки;
		
	Иначе
		
		// Ввод разрешен только для действующего документа
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияОбОбъектеИмуществаСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.СведенияОбОбъектеИмущества.СрезПоследних(, ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК СведенияОбОбъектеИмуществаСрезПоследних";
		
		Запрос.УстановитьПараметр("ОбъектУчетаИмущества", СтруктураДляЗаполнения.ОбъектУчетаИмущества);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И СтруктураДляЗаполнения.Ссылка <> Выборка.Регистратор Тогда
			
			ТекстОшибки = НСтр("ru='Недействующая редакция документа  %Документ%. Ввод на основании невозможен.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
