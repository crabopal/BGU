// Статус документа

&НаСервере
Процедура ПолучитьУчетныеСведенияОбъектаУчета()
	
	СтатусПустой = Справочники.СтатусыКартРеестраИмущества.ПустаяСсылка();
	
	СтатусДокумента		= СтатусПустой;
	СтатусЗапроса		= СтатусПустой;
	СтатусПоУмолчанию	= СтатусПустой;
	
	Если ЗначениеЗаполнено(Объект.ОбъектУчетаИмущества) Тогда
		
		СтатусПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОбъектУчетаИмущества, "ВидКарты.СтатусПоУмолчанию");
		
		// Статус объекта учета имущества
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СостояниеОбъектовУчетаРеестраИмуществаСрезПоследних.Статус
		               |ИЗ
		               |	РегистрСведений.СостояниеОбъектовУчетаРеестраИмущества.СрезПоследних(
		               |			,
		               |			Организация = &Организация
		               |				И ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК СостояниеОбъектовУчетаРеестраИмуществаСрезПоследних";
		
		Запрос.УстановитьПараметр("Организация",			Объект.Организация);
		Запрос.УстановитьПараметр("ОбъектУчетаИмущества",	Объект.ОбъектУчетаИмущества);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтатусДокумента = Выборка.Статус;			
		КонецЕсли;
		
		// Статус редакции карты
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СостояниеКарт.Статус
		               |ИЗ
		               |	РегистрСведений.СостояниеКартРеестраИмущества КАК СостояниеКарт
		               |ГДЕ
		               |	СостояниеКарт.Карта = &Документ
		               |	И СостояниеКарт.Статус <> ЗНАЧЕНИЕ(Справочник.СтатусыКартРеестраИмущества.ПустаяСсылка)";	
		
		Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		СтатусЗапроса = ?(Выборка.Следующий(), Выборка.Статус, СтатусПоУмолчанию); 
		
	КонецЕсли;	
	
	УстановитьСтатусДокумента(СтатусДокумента, "Документ");
	УстановитьСтатусДокумента(СтатусЗапроса);
	
	Если СтатусЗапроса = СтатусПоУмолчанию Или СтатусЗапроса = СтатусПустой Тогда
		Элементы.ДокументПодготовлен.Пометка = Ложь;
	ИначеЕсли СтатусЗапроса = Справочники.СтатусыКартРеестраИмущества.НайтиПоКоду("Ready") Тогда
		Элементы.ДокументПодготовлен.Пометка = Истина;
	Иначе
		Элементы.ГруппаКнопкиСтатуса.Видимость = Ложь;
	КонецЕсли;
	
	// Читаем сведения реестрового учета
	
	ВедущиеОбъекты  = Новый Структура("Организация, ОбъектУчетаИмущества", Объект.Организация, Объект.ОбъектУчетаИмущества);
    ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтаФорма, "СведенияРеестровогоУчетаИмущества", ВедущиеОбъекты, "РеестровыйУчет");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента(Статус, ПолеСтатуса = "Запрос")
		
	Если ЗначениеЗаполнено(Статус) Тогда	
		Цвет = Статус.Цвет.Получить();	
		ЦветТекста = ?(Цвет = Неопределено, ЦветаСтиля.ЦветТекстаПоля, Цвет);
	Иначе
		ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	КонецЕсли;
	
	ЭтаФорма["СлужебноеПоле_Статус" + ПолеСтатуса + "а"] = Статус;	
	Элементы["Статус" + ПолеСтатуса + "а"].ЦветТекста = ЦветТекста;
	
КонецПроцедуры

