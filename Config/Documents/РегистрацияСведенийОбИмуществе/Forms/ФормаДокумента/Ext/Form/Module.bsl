&НаСервере
Процедура ОпределитьПараметрыРедакцииДокумента()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СведенияОбОбъектеИмуществаСрезПоследних.Регистратор
	               |ИЗ
	               |	РегистрСведений.СведенияОбОбъектеИмущества.СрезПоследних(
	               |			,
	               |			Организация = &Организация
	               |				И ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК СведенияОбОбъектеИмуществаСрезПоследних";
				   
	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектУчетаИмущества",	Объект.ОбъектУчетаИмущества);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СлужебноеПоле_ДействующийДокумент = Выборка.Регистратор;
	Иначе
		СлужебноеПоле_ДействующийДокумент = Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка();
	КонецЕсли;
	
	ЭтоДействующийДокумент = (СлужебноеПоле_ДействующийДокумент = Объект.Ссылка Или СлужебноеПоле_ДействующийДокумент.Пустая());
	ТолькоПросмотр = (Не ЭтоДействующийДокумент И Объект.Проведен);
		
	Если Не ЗначениеЗаполнено(Объект.ОбъектУчетаИмущества) Тогда
		ВидимаяРедакция = 1;
	ИначеЕсли Не Объект.Проведен Тогда
		ВидимаяРедакция = 2;		
	ИначеЕсли ЭтоДействующийДокумент Тогда
		ВидимаяРедакция = 3;
	Иначе
		ВидимаяРедакция = 4;
	КонецЕсли;
			
	Элементы.ГруппаНеопределеннаяРедакцияДокумента.Видимость		= (ВидимаяРедакция = 1);
	
	Элементы.ГруппаНеПодтвержденнаяРедакцияДокумента.Видимость		= (ВидимаяРедакция = 2);	
	Элементы.ДокументНеПодтвержденнаяРедакцияДокумента.Видимость	= (Не СлужебноеПоле_ДействующийДокумент.Пустая());	
	
	Элементы.ГруппаДействующаяРедакцияДокумента.Видимость			= (ВидимаяРедакция = 3);
	Элементы.ДокументДействующаяРедакцияДокумента.Видимость			= Ложь; // (Не Объект.ДокументОснование.Пустая());
	
	Элементы.ГруппаНеДействующаяРедакцияДокумента.Видимость			= (ВидимаяРедакция = 4);
	Элементы.ДокументНеДействующаяРедакцияДокумента.Видимость		= (Не СлужебноеПоле_ДействующийДокумент.Пустая());

КонецПроцедуры

