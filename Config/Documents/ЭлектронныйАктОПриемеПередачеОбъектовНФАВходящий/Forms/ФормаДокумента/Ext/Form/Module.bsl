&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыПереданныеНФА(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокНФАОтправителя = НСтр("ru = 'НФА:'");
	Если ТекущаяСтрока.ТипСправочника = НСтр("ru = 'ОсновныеСредства'") Тогда
		ТекущаяСтрока.ЗаголовокИнвНомерОтправителя = НСтр("ru = 'Инв. №:'");
		ТекущаяСтрока.ЗаголовокИнвНомерПолучателя = НСтр("ru = 'Инв. №:'");
		ТекущаяСтрока.ПояснениеДляИнвНомера = НСтр("ru = '<заполняется в документе учета>'");
	Иначе
		ТекущаяСтрока.ЗаголовокИнвНомерОтправителя = "";
		ТекущаяСтрока.ЗаголовокИнвНомерПолучателя = "";
		ТекущаяСтрока.ПояснениеДляИнвНомера = "";
	КонецЕсли;
	ТекущаяСтрока.ЗаголовокКПС = НСтр("ru = 'КПС:'");
	ТекущаяСтрока.ЗаголовокСчетУчета = НСтр("ru = 'Счет учета:'");

	ТекущаяСтрока.ЗаголовокНФАПолучателя = НСтр("ru = 'НФА:'");
	
	
	ТекущаяСтрока.ЗаголовокКоличество = НСтр("ru = 'Количество:'");
	ТекущаяСтрока.ЗаголовокСтоимость = НСтр("ru = 'Балансовая стоимость:'");

	ТекущаяСтрока.ЗаголовокАмортизация = НСтр("ru = 'Сумма амортизации:'");
	ТекущаяСтрока.ЗаголовокОбесценение = НСтр("ru = 'Сумма обесценения:'");
	
	Если ТекущаяСтрока.Количество = 0 Тогда
		ТекущаяСтрока.КоличествоСЕдИзм = НСтр("ru = '-'");
	Иначе	
		ТекущаяСтрока.КоличествоСЕдИзм = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2", ТекущаяСтрока.Количество, ТекущаяСтрока.ЕдИзмНаим);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыПереданныеНФА(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ПереданныеНФА Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыПереданныеНФА(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

