&НаКлиенте
Процедура ОткрытьЭлектронныйДокументИзФайла(ВыбранноеЗначение)
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		ДанныеСтроки = ФайлыПриложенийКАкту.НайтиПоИдентификатору(ВыбранноеЗначение);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеСтроки.СодержимоеФайла) Тогда
			Если ЗначениеЗаполнено(ДанныеСтроки.ВременныйФайлПриложения) Тогда
				ИмяВременногоФайла = ДанныеСтроки.ВременныйФайлПриложения;
			Иначе
	            ИмяВременногоФайла = ВременныйФайлПриложенияНаКлиенте(ДанныеСтроки);
			КонецЕсли;	
			Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
				ДанныеСтроки.ВременныйФайлПриложения = ИмяВременногоФайла;
			    ФайловаяСистемаКлиент.ОткрытьФайл(ИмяВременногоФайла);
			КонецЕсли;
		КонецЕсли;	
	Иначе	
		ДанныеСтроки = Объект.ФайлыПриложений.НайтиПоИдентификатору(ВыбранноеЗначение);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ПрисоединенныйФайл) Тогда
			ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
				ДанныеСтроки.ПрисоединенныйФайл, Неопределено, УникальныйИдентификатор);
			
			РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура СоздатьНФАНаСервере()
	
	ТаблицаНоменклатурыНФА = ТаблицаСозданнойНоменклатурыНФА(Объект.Организация);
	ГруппаНовогоЭлементаОС = ЭлектронныеДокументыБГУ.ГруппаДляНовыхНФА("ОсновныеСредства", Объект.Организация);
	ГруппаНовогоЭлементаМЗ = ЭлектронныеДокументыБГУ.ГруппаДляНовыхНФА("Номенклатура", Объект.Организация);
	
	Для Каждого ТекСтрока Из Объект.ПереданныеНФА Цикл
		НаименованиеСправочника = ТекСтрока.ТипСправочника;
		Если НаименованиеСправочника = "ОсновныеСредства" Тогда
			НоменклатураНеНайдена = Истина;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("GUIDНоменклатурыУОтправителя", ТекСтрока.GUIDНоменклатурыУОтправителя);
			НайденныеСтроки = ТаблицаНоменклатурыНФА.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ОсновноеСредство = НайденныеСтроки[0].Ссылка;
				НоменклатураНеНайдена = Ложь;
			КонецЕсли;
			
			Если НоменклатураНеНайдена Тогда
				ГруппаНовогоЭлемента = ГруппаНовогоЭлементаОС;
				
				НоваяНоменклатураНФА = Справочники.ОсновныеСредства.СоздатьЭлемент();
				НоваяНоменклатураНФА.Наименование = ТекСтрока.НаименованиеНоменклатурыНФА;
				НоваяНоменклатураНФА.НаименованиеПолное = ТекСтрока.НаименованиеНФА;
				НоваяНоменклатураНФА.НоменклатурныйНомер = ТекСтрока.НоменклатурныйНомерУОтправителя;
				
				НоваяНоменклатураНФА.Родитель = ГруппаНовогоЭлемента;
				НоваяНоменклатураНФА.Организация = Объект.Организация;
				НоваяНоменклатураНФА.GUIDНоменклатурыОтправителя = ТекСтрока.GUIDНоменклатурыУОтправителя;
				НоваяНоменклатураНФА.ВидНФА = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ВидыНФА", ТекСтрока.ВидНФА);
				НоваяНоменклатураНФА.ТипНФА = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ТипыНФА", ТекСтрока.ТипНФА);
				
				КодОКПД = Справочники.ОбщероссийскийКлассификаторПродукции.НайтиПоКоду(ТекСтрока.КодОКПД);									
				КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(ТекСтрока.КодТНВЭД);									
				
				НоваяНоменклатураНФА.ОКП = КодОКПД;
				НоваяНоменклатураНФА.КодТНВЭД = КодТНВЭД;

				СтранаПроисхожденияКод = ТекСтрока.КодСтраныПроисхождения;
				СтранаПроисхожденияСсылка = Справочники.СтраныМира.НайтиПоКоду(СтранаПроисхожденияКод);
				НоваяНоменклатураНФА.СтранаПроисхождения = СтранаПроисхожденияСсылка;
				НоваяНоменклатураНФА.ПрослеживаемыйТовар = ТекСтрока.ПрослеживаемыйТовар;

				НоваяНоменклатураНФА.ИмуществоКазны = ТекСтрока.ИмуществоКазны;
				НоваяНоменклатураНФА.МожетСодержатьДрагМатериалы = ТекСтрока.МожетСодержатьДрагМатериалы;

				НоваяНоменклатураНФА.АмортизационнаяГруппа = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("АмортизационныеГруппы", ТекСтрока.АмортизационнаяГруппа);;
				НоваяНоменклатураНФА.ГрупповойУчет = ТекСтрока.ГрупповойУчет;

				КодОКОФ = Справочники.ОбщероссийскийКлассификаторОсновныхФондов.НайтиПоКоду(ТекСтрока.КодОКОФ);									
				НоваяНоменклатураНФА.КодОКОФ = КодОКОФ;
				
				НоваяНоменклатураНФА.КодФАИП = ТекСтрока.КодФАИП;
				НоваяНоменклатураНФА.КодЕКПС = ТекСтрока.КодЕКПС;
				НоваяНоменклатураНФА.Сведения = ТекСтрока.Сведения;
				Попытка
					НоваяНоменклатураНФА.Записать();
					ОсновноеСредство = НоваяНоменклатураНФА.Ссылка;

					НоваяСтрока = ТаблицаНоменклатурыНФА.Добавить();
					НоваяСтрока.Ссылка = ОсновноеСредство;
					НоваяСтрока.GUIDНоменклатурыУОтправителя = ТекСтрока.GUIDНоменклатурыУОтправителя;
				Исключение
					ШаблонСообщения = Нстр("ru='Не удалось записать основное средство %1, по причине:'");
					ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекСтрока.НаименованиеНФА);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
			ТекСтрока.НФА = ОсновноеСредство;
			
		Иначе
			ГруппаНовогоЭлемента = ГруппаНовогоЭлементаМЗ;

			НоваяНоменклатураНФА = Справочники.Номенклатура.СоздатьЭлемент();
			НоваяНоменклатураНФА.Наименование = ТекСтрока.НаименованиеНоменклатурыНФА;
			НоваяНоменклатураНФА.НаименованиеПолное = ТекСтрока.НаименованиеНФА;
			НоваяНоменклатураНФА.НоменклатурныйНомер = ТекСтрока.НоменклатурныйНомерУОтправителя;
			
			НоваяНоменклатураНФА.Родитель = ГруппаНовогоЭлемента;
			НоваяНоменклатураНФА.GUIDНоменклатурыОтправителя = ТекСтрока.GUIDНоменклатурыУОтправителя;
			НоваяНоменклатураНФА.ТипНоменклатуры = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ТипыНоменклатуры", ТекСтрока.ТипНоменклатуры);
			
			КодОКДП = Справочники.ОбщероссийскийКлассификаторПродукции.НайтиПоКоду(ТекСтрока.КодОКДП);									
			КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(ТекСтрока.ТНВЭД);									
			
			НоваяНоменклатураНФА.ОКП = КодОКДП;
			НоваяНоменклатураНФА.КодТНВЭД = КодТНВЭД;

			СтранаПроисхожденияКод = ТекСтрока.КодСтраныПроисхождения;
			СтранаПроисхожденияСсылка = Справочники.СтраныМира.НайтиПоКоду(СтранаПроисхожденияКод);
			НоваяНоменклатураНФА.СтранаПроисхождения = СтранаПроисхожденияСсылка;
			НоваяНоменклатураНФА.ПрослеживаемыйТовар = ТекСтрока.ПрослеживаемыйТовар;

			НоваяНоменклатураНФА.МожетСодержатьДрагМатериалы = ТекСтрока.МожетСодержатьДрагМатериалы;
			
			НоваяНоменклатураНФА.КодЕКПС = ТекСтрока.КодЕКПС;

			Попытка
				НоваяНоменклатураНФА.Записать();
			Исключение
				ШаблонСообщения = Нстр("ru='Не удалось записать номенклатуру %1, по причине:'");
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекСтрока.НаименованиеНФА);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
			
			Номенклатура = НоваяНоменклатураНФА.Ссылка;
			
			ТекСтрока.НФА = Номенклатура;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ТаблицаСозданнойНоменклатурыНФА(Организация)
	GUIDНоменклатурыОтправителя = Объект.ПереданныеНФА.Выгрузить(, "GUIDНоменклатурыУОтправителя");
	
	Возврат ЭлектронныеДокументыБГУ.ТаблицаСозданнойНоменклатурыНФАПоАкту(Организация, GUIDНоменклатурыОтправителя);
КонецФункции	

&НаСервере
Процедура ЗаполнитьДанныеФайловПриОграниченияхДоступаПоОрганизациям()
	УстановитьПривилегированныйРежим(Истина);
	ИспользуетсяОграничениеДоступаНаУровнеЗаписей = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ФайлыПриложенийКАкту.Очистить();
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		СведенияАктаПередачиНФА = ЭлектронныеДокументыБГУ.СведенияЭДАктаПередачиНФАСФайламиПоДокументу(Объект.Ссылка);
		Если ЗначениеЗаполнено(СведенияАктаПередачиНФА) Тогда
			Если СведенияАктаПередачиНФА.ФайлыПриложений.Количество() > 0 Тогда
				Для Каждого ТекФайл Из СведенияАктаПередачиНФА.ФайлыПриложений Цикл
					НоваяСтрока = ФайлыПриложенийКАкту.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекФайл);
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры	

&НаКлиенте
Процедура ПриВыбореФайлаПриложения(ВыбраннаяСтрока)
	МожноОткрытьФайл = Истина;
	
	#Если ВебКлиент Тогда
	МожноОткрытьФайл = Ложь;
	#КонецЕсли
		
	Если МожноОткрытьФайл Тогда
		ОткрытьЭлектронныйДокументИзФайла(ВыбраннаяСтрока);
	Иначе
		ФайлВыгрузки = ФайлПриложения(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ФайлВыгрузки.АдресФайла) Тогда
			ПродолжитьВыгрузкуПриложенногоФайла(ФайлВыгрузки);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВременныйФайлПриложенияНаКлиенте(ДанныеСтроки)
	ИмяФайла = ДанныеСтроки.ИмяФайла; 
	СодержимоеФайлаBase64 = ДанныеСтроки.СодержимоеФайла;
	
	ИмяБезРасширения = Лев(ИмяФайла, СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца) - 1);
	ПозицияРасширениеБезТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ЗначениеЗаполнено(ПозицияРасширениеБезТочки) Тогда 
		РасширениеБезТочки = Сред(ИмяФайла, ПозицияРасширениеБезТочки + 1);
	Иначе 
		РасширениеБезТочки = "pdf";
	КонецЕсли;

	ДвоичныеДанные = Base64Значение(СтрЗаменить(СодержимоеФайлаBase64,"  ",Символы.ВК));
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ИмяВременногоФайла = Неопределено;
		Возврат ИмяВременногоФайла;
	КонецЕсли;	

	АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);

	#Если ВебКлиент Тогда
		Каталог = КаталогВременныхФайлов();
		ИмяФайла = Строка(Новый УникальныйИдентификатор) + "." + РасширениеБезТочки;
		ИмяВременногоФайла = Каталог + ИмяФайла;
	#Иначе
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеБезТочки);
	#КонецЕсли

	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Возврат ИмяВременногоФайла;
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыгрузкуПриложенногоФайла(ФайлВыгрузки)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1'"),
		"pdf");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(
		Оповещение, ФайлВыгрузки.АдресФайла, ФайлВыгрузки.ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СохранитьДокументПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл сохранен:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Функция ФайлПриложения(ВыбранноеЗначение)

	Результат = Новый Структура;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;

	ДанныеСтроки = ФайлыПриложенийКАкту.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;

	ИмяФайла = ДанныеСтроки.ИмяФайла;
	СодержимоеФайлаBase64 = ДанныеСтроки.СодержимоеФайла;
	
	ДвоичныеДанные = Base64Значение(СтрЗаменить(СодержимоеФайлаBase64,"  ",Символы.ВК));
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;	

	АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("АдресФайла", АдресДвоичныхДанных);
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура УдалениеВременныхФайловПриложенийАкта()
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		Для Каждого ТекСтрока Из ФайлыПриложенийКАкту Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ВременныйФайлПриложения) Тогда
				Попытка
					УдалитьФайлы(ТекСтрока.ВременныйФайлПриложения);
				Исключение
					// Дополнительная обработка не требуется. Файл будет удален после закрытия приложения, если не будет открыт.
				КонецПопытки;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти


