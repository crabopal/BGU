#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоОтветныйАкт = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий") Тогда
			ЭтоОтветныйАкт = Истина;
		КонецЕсли;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументОснование", "Видимость", ЭтоОтветныйАкт);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаПереданныеНФА", "Видимость", НЕ ЭтоОтветныйАкт);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаПринятыеНФА", "Видимость", ЭтоОтветныйАкт);

	ПередачаКапвложений = Ложь;
	Если Объект.КодВидаОперации = НСтр("ru = 'ПередачаКапвложений'")
		ИЛИ Объект.КодВидаОперации = НСтр("ru = 'УчетКапвложений'") Тогда
		ПередачаКапвложений = Истина;
	КонецЕсли;	

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАЗаголовокИнвНомерОтправителя", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАИнвентарныйНомерУОтправителя", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАЗаголовокИнвНомерПолучателя", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАИнвентарныйНомер", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАПояснениеДляИнвНомера", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАИнвентарныйНомер", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАИнвентарныйНомерУОтправителя", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФААмортизационнаяГруппа", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАМетодНачисленияАмортизации", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФААналитическаяГруппа", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАФактическийСрокЭксплуатации", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАДатаОкончанияНачисленияАмортизации", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАСрокПолезногоИспользования", "Видимость", НЕ ПередачаКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПринятыеНФАСуммаНормыАмортизации", "Видимость", НЕ ПередачаКапвложений);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАИнвентарныйНомер", "Видимость", Объект.ЭтоВозвратНФА);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПереданныеНФАПояснениеДляИнвНомера", "Видимость", НЕ Объект.ЭтоВозвратНФА);
	
	ТЧДрагМатериалы = Объект.СведенияОСодержанииДрагМатериалов;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСодержанияДрагМатериалов", "Видимость", ТЧДрагМатериалы.Количество() > 0 ); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СведенияОСодержанииДрагМатериаловГруппаМЦ", "Видимость", (ТЧДрагМатериалы.Количество() > 0 И ЗначениеЗаполнено(ТЧДрагМатериалы[0].НаименованиеМЦ))); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СведенияОСодержанииДрагМатериаловИнвентарныйНомерУОтправителя", "Видимость", (ТЧДрагМатериалы.Количество() > 0 И НЕ ЗначениеЗаполнено(ТЧДрагМатериалы[0].НаименованиеМЦ)));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
