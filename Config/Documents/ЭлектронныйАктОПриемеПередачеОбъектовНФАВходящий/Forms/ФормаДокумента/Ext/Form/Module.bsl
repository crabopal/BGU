	ТекущаяСтрока.ЗаголовокКФО = НСтр("ru = 'КФО:'");
	ТекущаяСтрока.ЗаголовокКПС = НСтр("ru = 'КПС:'");
	ТекущаяСтрока.ЗаголовокСчетУчета = НСтр("ru = 'Счет учета:'");

	ТекущаяСтрока.ЗаголовокКоличество = НСтр("ru = 'Количество:'");
	ТекущаяСтрока.ЗаголовокСтоимость = НСтр("ru = 'Балансовая стоимость:'");
	
	Если ТекущаяСтрока.Количество = 0 Тогда
		ТекущаяСтрока.КоличествоСЕдИзм = НСтр("ru = '-'");
	Иначе	
		ТекущаяСтрока.КоличествоСЕдИзм = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2", ТекущаяСтрока.Количество, ТекущаяСтрока.ЕдИзмНаим);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыПринятыеНФА(Форма)

