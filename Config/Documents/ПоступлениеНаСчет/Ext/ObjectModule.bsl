#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);	
	
	ИспользуетсяНастройкаПогашенияЗадолженности = УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет);
	
	ЛишниеСтроки = Новый Массив;
	ПоляИсключения = "Сумма,СуммаВал,КБКНазначениеПлатежа,КодЦели";
	Если РодительскаяПлата Тогда
		ПоляИсключения = ПоляИсключения + ",Контрагент,Договор";
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаСостава = РасшифровкаПлатежа.Найти(СтрокаРасшифровки.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		Иначе  
			Если НЕ ЗначениеЗаполнено(СтрокаСостава.Контрагент) Тогда
				 СтрокаСостава.Контрагент = Контрагент;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаСостава, , ПоляИсключения);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ДетализацияПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;	

	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		Если НЕ ИспользуетсяНастройкаПогашенияЗадолженности Тогда
			СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			СтрокаРасшифровки.ДопСубконтоРасчетов = Неопределено;
		КонецЕсли;
	КонецЦикла;   
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ТекстСообщения = НСтр("ru='Проведение невозможно.'"); 
		НельзяПровести = Ложь;
		
		Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
			Состав = ДетализацияПлатежа.Выгрузить(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
			Если НЕ Состав.Итог("СуммаВал") = СтрокаРасшифровки.СуммаВал Тогда  
				НельзяПровести = Истина;
				ТекстСообщения = ТекстСообщения + "
				|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В строке %1 сумма расшифровки не равна сумме детализации платежа. Не распределена сумма: %2'"),
				СтрокаРасшифровки.НомерСтроки, Формат((СтрокаРасшифровки.СуммаВал - Состав.Итог("СуммаВал")),"ЧДЦ=2"));
			КонецЕсли;  
		КонецЦикла;
		Если НЕ СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал") Тогда
			НельзяПровести = Истина;
			ТекстСообщения = ТекстСообщения + "
			|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: %1'"),
			Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2"));
		КонецЕсли;	
		
		Если НельзяПровести Тогда  
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла;
	Внешнее = Ложь;
	ДатаПервичногоДокумента = "";  
	НомерПервичногоДокумента = "";  
	ДокументОснование = Неопределено; 
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		
		ВалютаЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ВалютаСчета");
		ТипЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ТипЛицевогоСчета");
		
		Если ЗначениеЗаполнено(ВалютаДокумента)
			И ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И НЕ ВалютаДокумента = ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка()
			И НЕ ЗначениеЗаполнено(СуммаКупленнойВалюты) Тогда
			
			ПроверяемыеРеквизиты.Добавить("СуммаКупленнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КурсКупленнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КратностьКупленнойВалюты");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ остатками задолженности к погашению.
//
Процедура ЗаполнитьПоОстаткамЗадолженности() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	
	ПлатежноРасчетныеДокументы.ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(
		РасшифровкаПлатежа, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли