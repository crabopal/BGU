#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// См. ЗапретРедактированияРеквизитовОбъектовПереопределяемый.ПриОпределенииОбъектовСЗаблокированнымиРеквизитами.
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
    Результат = Новый Массив;
    Результат.Добавить("ДокументОснование");
    Возврат Результат;
КонецФункции

Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Контрагент,
	ДокументОбъект.Контрагент,
	Форма.Элементы.ГруппаКонтрагент);
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Плательщик,
	ДокументОбъект.Плательщик,
	Форма.Элементы.ГруппаПлательщик);

	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти   

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура СоздатьНовыйПоступлениеНаСчетПоДаннымЕБП(ДокументПоступление, ДанныеКОбработке, Организация, ЛицевойСчет, ИнформацияОбОшибке) Экспорт   
	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы.ПоступлениеНаСчет.СоздатьДокумент(); 
		НовыйДокумент.УстановитьСсылкуНового(ДокументПоступление); 
		НовыйДокумент.Заблокировать();  
		                                    
		НовыйДокумент.Внешнее = Истина;
		НовыйДокумент.Организация = Организация;  
		НовыйДокумент.ЛицевойСчет = ЛицевойСчет; 
		НовыйДокумент.Дата = ДанныеКОбработке.ДатаУчетная; 
		НовыйДокумент.МодульИнтеграции = ДанныеКОбработке.МодульИнтеграции;   
		
		ДанныеКОбработке.Свойство("КорСчет", НовыйДокумент.КорСчет); 
		ТипЛС = ДанныеКОбработке.ТипЛС;
			
		ВидДокумента = "";
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НаименованиеРаспоряжения", ВидДокумента);
		Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
			ВидДокумента = ДанныеКОбработке.ДанныеЗаголовка.НаименованиеПодтверждающегоДокумента;   
		КонецЕсли;	
		НовыйДокумент.ВидПервичногоДокумента = ВидДокумента; 
		НовыйДокумент.ДатаПервичногоДокумента = ДанныеКОбработке.ДанныеЗаголовка.ДатаПодтверждающегоДокумента; 
		НовыйДокумент.НомерПервичногоДокумента = ДанныеКОбработке.ДанныеЗаголовка.НомерПодтверждающегоДокумента;
		
		НовыйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();  
		НовыйДокумент.Курс = 1; 
		НовыйДокумент.Кратность = 1;
		НовыйДокумент.СуммаДокументаВВалюте = ДанныеКОбработке.ДанныеЗаголовка.СуммаОперации; 
		НовыйДокумент.СуммаДокумента = ДанныеКОбработке.ДанныеЗаголовка.СуммаОперации;
		НовыйДокумент.СуммаДокументаБезПраваРасходования = ДанныеКОбработке.ДанныеЗаголовка.СуммаБезПраваРасходования;
		
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НазначениеПлатежа", НовыйДокумент.НазначениеПлатежа);  
		
		ЭтоКазенное = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, НовыйДокумент.Дата).ЭтоКазенноеУчреждение; 
		
		// Налоговые реквизиты
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("УИН", НовыйДокумент.УИН);  
		Если НЕ ЗначениеЗаполнено(НовыйДокумент.УИН) Тогда
			ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ИдентификаторПлатежа", НовыйДокумент.УИН); 
		КонецЕсли;	
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("СтатусСоставителя", НовыйДокумент.СтатусСоставителя);
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("КодБКНалога", НовыйДокумент.КодБКНалога);
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("КодОКАТО", НовыйДокумент.КодОКАТО);
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательОснования", НовыйДокумент.ПоказательОснования);
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательПериода", НовыйДокумент.ПоказательПериода);
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательДаты", НовыйДокумент.ПоказательДаты); 
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательТипа", НовыйДокумент.ПоказательТипа); 
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательИдентификатора", НовыйДокумент.ПоказательНомера); 
		Если ЗначениеЗаполнено(НовыйДокумент.ПоказательНомера) Тогда
			НовыйДокумент.ПоказательИдентификатора = Истина;
		Иначе
			ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ПоказательНомера", НовыйДокумент.ПоказательНомера);
		КонецЕсли;
		// НалогСборПлатеж  - попробовать определить
		
		// Контрагент
		КонтрагентНаименование = "";
		КонтрагентФИО = "";  
		ИННПлательщика = "";
		КПППлательщика = "";
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ИННПлательщика", ИННПлательщика); 
		ДанныеКОбработке.ДанныеФайлаВложения.Свойство("КПППлательщика", КПППлательщика);
		Если ЗначениеЗаполнено(ИННПлательщика) Тогда
			Если СтрДлина(ИННПлательщика) = 12 ИЛИ ИННПлательщика = "0" Тогда
				КонтрагентНаименование = ""; 
				ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НаименованиеПлательщика", КонтрагентФИО);
				Если НЕ ЗначениеЗаполнено(КонтрагентФИО) Тогда
					ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ТекстПлательщика", КонтрагентФИО);	
				КонецЕсли; 
				// 	Возможно указание в документе составного наименования, например 
				// "ПАО СБЕРБАНК//ИВАНОВ ИВАН ИВАНОВИЧ//2199999999999//186888, РОССИЯ, КАРЕЛИЯ РЕСП, РАЙОН Р-Н, Г ГОРОД, УЛ УЛИЦА, Д 25 КВ 20//"
				СоставНаименования   = СтрРазделить(КонтрагентФИО, "//", Ложь);
				Для Каждого ЭлементСостава Из СоставНаименования Цикл
					//в фио может быть дефис в двойных фамилиях, например: Вербицкая-Борщ, Терновая-Евсеева и тд.
					//в наименовании могут быть скобки - если это ИП: ИП Шепель Анастасия Игоревна (Шепель Анастасия Игоревна (Кфх)
					//уберем дефис и скобки и проверим что все остальные символы нац. алфавита
					АнализируемаяЧастьСтроки = СтрСоединить(СтрРазделить(ЭлементСостава,"-()",Ложь)," ");
					Если СтроковыеФункцииКлиентСервер.ТолькоСимволыНациональногоАлфавитаВСтроке(АнализируемаяЧастьСтроки, " ") Тогда 
						ЭлементСостава = Трег(ЭлементСостава);
						МассивЧастей = СтрРазделить(ЭлементСостава, " ", Ложь);
						//сначала попробуем поискать по полному совпадению, это значительно быстнее
						ФИОПоКлассификатору = ПодборФИО.НайтиФИО(МассивЧастей, Истина);
						Если ФИОПоКлассификатору.Фамилии.Количество() > 0 
							ИЛИ ФИОПоКлассификатору.Имена.Количество() > 0
							ИЛИ ФИОПоКлассификатору.Отчества.Количество() > 0 Тогда
							КонтрагентФИО = СтрСоединить(МассивЧастей, " ");
							Прервать;
						КонецЕсли;
						//а если не нашли по полному совпадению, то как обычно
						ФИОПоКлассификатору = ПодборФИО.НайтиФИО(МассивЧастей, Ложь); 
						Если ФИОПоКлассификатору.Фамилии.Количество() > 0 
							ИЛИ ФИОПоКлассификатору.Имена.Количество() > 0
							ИЛИ ФИОПоКлассификатору.Отчества.Количество() > 0 Тогда
							КонтрагентФИО = СтрСоединить(МассивЧастей, " ");
							Прервать;
						КонецЕсли;	
					КонецЕсли;
				КонецЦикла;	
			Иначе       
				КонтрагентФИО = "";
				ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НаименованиеПлательщика", КонтрагентНаименование);
				Если НЕ ЗначениеЗаполнено(КонтрагентНаименование) Тогда
					ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ТекстПлательщика", КонтрагентНаименование);	
				КонецЕсли;  
			КонецЕсли;
		Иначе // считаем, что физлицо
			КонтрагентНаименование = "";     
			ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НаименованиеПлательщика", КонтрагентФИО);
			Если НЕ ЗначениеЗаполнено(КонтрагентФИО) Тогда
				ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ТекстПлательщика", КонтрагентФИО);	
			КонецЕсли; 
			// 	Возможно указание в документе составного наименования, например 
			// "ПАО СБЕРБАНК//ИВАНОВ ИВАН ИВАНОВИЧ//2199999999999//186888, РОССИЯ, КАРЕЛИЯ РЕСП, РАЙОН Р-Н, Г ГОРОД, УЛ УЛИЦА, Д 25 КВ 20//"
			СоставНаименования   = СтрРазделить(КонтрагентФИО, "//", Ложь);
			Для Каждого ЭлементСостава Из СоставНаименования Цикл
				//в фио может быть дефис в двойных фамилиях, например: Вербицкая-Борщ, Терновая-Евсеева и тд.
				//в наименовании могут быть скобки - если это ИП: ИП Шепель Анастасия Игоревна (Шепель Анастасия Игоревна (Кфх)
				//уберем дефис и скобки и проверим что все остальные символы нац. алфавита
				АнализируемаяЧастьСтроки = СтрСоединить(СтрРазделить(ЭлементСостава,"-()",Ложь)," ");
				Если СтроковыеФункцииКлиентСервер.ТолькоСимволыНациональногоАлфавитаВСтроке(АнализируемаяЧастьСтроки, " ") Тогда 
					ЭлементСостава = Трег(ЭлементСостава);
					МассивЧастей = СтрРазделить(ЭлементСостава, " ", Ложь);
					//сначала попробуем поискать по полному совпадению, это значительно быстнее
					ФИОПоКлассификатору = ПодборФИО.НайтиФИО(МассивЧастей, Истина);
					Если ФИОПоКлассификатору.Фамилии.Количество() > 0 
						ИЛИ ФИОПоКлассификатору.Имена.Количество() > 0
						ИЛИ ФИОПоКлассификатору.Отчества.Количество() > 0 Тогда
						КонтрагентФИО = СтрСоединить(МассивЧастей, " ");
						Прервать;
					КонецЕсли;
					//а если не нашли по полному совпадению, то как обычно
					ФИОПоКлассификатору = ПодборФИО.НайтиФИО(МассивЧастей, Ложь); 
					Если ФИОПоКлассификатору.Фамилии.Количество() > 0 
						ИЛИ ФИОПоКлассификатору.Имена.Количество() > 0
						ИЛИ ФИОПоКлассификатору.Отчества.Количество() > 0 Тогда
						КонтрагентФИО = СтрСоединить(МассивЧастей, " ");
						Прервать;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		НовыйДокумент.Контрагент = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ИННПлательщика, КПППлательщика, КонтрагентНаименование, КонтрагентФИО);
        // Контрагент  
		
		// Договор 
		ОдинДоговор = Истина;
		Если ДанныеКОбработке.ДанныеЗаголовка.ТипОперации = "1" Тогда
			// Это новое поступление, доходы, надо искать по УИН
			Если ЗначениеЗаполнено(НовыйДокумент.УИН) Тогда
				// ищем
			КонецЕсли;
		ИначеЕсли ДанныеКОбработке.ДанныеЗаголовка.ТипОперации = "4" Тогда
			// Это восстановление кассового расхода, можно поискать по реестровому номеру
			ДоговорыСлужебная = ДанныеКОбработке.ДанныеРасшифровки.Скопировать();
			ДоговорыСлужебная.Свернуть("ИдентификаторКонтракта", "СуммаОперации");
			Если ДоговорыСлужебная.Количество() = 1 И ЗначениеЗаполнено(ДоговорыСлужебная[0].ИдентификаторКонтракта) Тогда
				// ищем
			Иначе ОдинДоговор = Ложь; 
			КонецЕсли;
		КонецЕсли;	 
		
		// Расшифровка платежа 
		Если ДанныеКОбработке.ДанныеФайлаВложения.Свойство("РЕЕСТР") Тогда
			// Платежное поручение с реестром, в Расшифровке может быть только одна строка  
			Если НЕ ДанныеКОбработке.ДанныеРасшифровки.Количество() = 1 Тогда
				ИнформацияОбОшибке = ИнформацияОбОшибке + "
				|" + НСтр("ru = 'Платежное поручение на общую сумму с реестром может быть составлено только по одному коду БК.'"); 
			Иначе  
				НовыйДокумент.ПоРеестру = Истина;
				СтрокаРасшифровки = ДанныеКОбработке.ДанныеРасшифровки[0];
				// КПС
				Если ЗначениеЗаполнено(СтрокаРасшифровки.ТипКБК) Тогда
					ТипКБК = БиблиотекаФункцийОбмена.ПолучитьВидКБК(СтрокаРасшифровки.ТипКБК);	
				Иначе
					ТипКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
				КонецЕсли;  
				КодКПС = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтрокаРасшифровки.КодБК, 20, "0");
				Если ЭтоКазенное Тогда
					КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(КодКПС, ТипКБК,, НовыйДокумент.Дата, ИнформацияОбОшибке);
				Иначе
					КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(КодКПС, Перечисления.ВидыКБК.АУИБУ, ТипКБК, НовыйДокумент.Дата, ИнформацияОбОшибке); 
				КонецЕсли;
                // Раздел лицевого счета   
				Если ЗначениеЗаполнено(НовыйДокумент.ЛицевойСчет) Тогда 
					РазделЛС = Справочники.РазделыЛицевыхСчетов.РазделЛСПоКодуПоступленияЕБП(НовыйДокумент.ЛицевойСчет, СтрокаРасшифровки.КодПоступленияЕБП, ИнформацияОбОшибке, Истина); 
				Иначе РазделЛС = Неопределено;	
				КонецЕсли;  
				КодЦели = Справочники.ВидыЦелевыхСредств.ВидЦелевыхТекстовомуКоду(СтрокаРасшифровки.КодЦелевойСубсидии); 
				ОбъектФАИП = БиблиотекаФункцийОбмена.ОбъектФАИПКМИПоТекстовомуКоду(СтрокаРасшифровки.КодФАИП, Организация);  
				КодПрослеживаемости = СтрокаРасшифровки. КодПрослеживаемости;
				Примечание = СтрокаРасшифровки.Примечание;
				Сумма = СтрокаРасшифровки.СуммаОперации;
				СуммаВал = СтрокаРасшифровки.СуммаОперации;
				СуммаБезПраваРасходования = СтрокаРасшифровки.СуммаБезПраваРасходования;
				
				Для Каждого СтрРеестра Из ДанныеКОбработке.ДанныеФайлаВложения.РЕЕСТР Цикл   
					СтрДок = НовыйДокумент.РасшифровкаПлатежа.Добавить();
					СтрДок.ИдентификаторСтроки = Новый УникальныйИдентификатор();
					СтрДок.КБКНазначениеПлатежа = КБКНазначениеПлатежа;
					СтрДок.РазделЛС = РазделЛС;
					СтрДок.КодЦели = КодЦели; 
					СтрДок.ОбъектФАИП = ОбъектФАИП; 
					СтрДок.КодПрослеживаемости = КодПрослеживаемости;
					СтрДок.Примечание = Примечание;
					СтрДок.Сумма = СтрРеестра.Сумма;
					СтрДок.СуммаВал = СтрРеестра.Сумма; 
					СтрДок.НазначениеПлатежа = СтрРеестра.НазначениеПлатежа;  
					СтрДок.ИдентификаторПлательщика = СтрРеестра.ИдентификаторПлательщика;
					СтрДок.АдресПлательщика = СтрРеестра.Адрес;
					СтрДок.Контрагент = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(?(СтрРеестра.ИНН = "0", "", СтрРеестра.ИНН),,, СтрРеестра.ФИО);  
					// Добавляем одну строку в таблицу Детализация платежа
					СтрокаДетализации = НовыйДокумент.ДетализацияПлатежа.Добавить(); 
					ЗаполнитьЗначенияСвойств(СтрокаДетализации, СтрДок); 
					СтрокаДетализации.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДетализации.РазделЛС, "КодПоступленияЕБП"));
				КонецЦикла;	
				
			КонецЕсли;	
		ИначеЕсли ТипЛС = "ВРПБС" Тогда  
			СтрДок = НовыйДокумент.РасшифровкаПлатежа.Добавить();
			СтрДок.ИдентификаторСтроки = Новый УникальныйИдентификатор(); 
			СтрДок.РазделЛС = Справочники.РазделыЛицевыхСчетов.РазделЛСПоКодуПоступленияЕБП(НовыйДокумент.ЛицевойСчет, "ВР", ИнформацияОбОшибке, Истина); 
			СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК("00000000000000000000", Перечисления.ВидыКБК.гКБК,, НовыйДокумент.Дата, ИнформацияОбОшибке);   
			СтрДок.Сумма = НовыйДокумент.СуммаДокумента;
			СтрДок.СуммаВал = НовыйДокумент.СуммаДокументаВВалюте;
			СтрДок.Контрагент = НовыйДокумент.Контрагент;
			СтрДок.Договор = НовыйДокумент.Договор;
            // Добавляем одну строку в таблицу Детализация платежа
			СтрокаДетализации = НовыйДокумент.ДетализацияПлатежа.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДетализации, СтрДок); 
			СтрокаДетализации.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДетализации.РазделЛС, "КодПоступленияЕБП"));

		Иначе	
			Для Каждого СтрокаРасшифровки Из ДанныеКОбработке.ДанныеРасшифровки Цикл 
				СтрДок = НовыйДокумент.РасшифровкаПлатежа.Добавить();
				СтрДок.ИдентификаторСтроки = Новый УникальныйИдентификатор();
							
				// КПС 
				Если ЗначениеЗаполнено(СтрокаРасшифровки.ТипКБК) Тогда
					ТипКБК = БиблиотекаФункцийОбмена.ПолучитьВидКБК(СтрокаРасшифровки.ТипКБК);	
				Иначе
					ТипКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
				КонецЕсли;  
				КодКПС = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтрокаРасшифровки.КодБК, 20, "0");
				Если ЭтоКазенное Тогда
					СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(КодКПС, ТипКБК,, НовыйДокумент.Дата, ИнформацияОбОшибке);
				Иначе
					СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(КодКПС, Перечисления.ВидыКБК.АУИБУ, ТипКБК, НовыйДокумент.Дата, ИнформацияОбОшибке); 
				КонецЕсли;
				
				// Раздел лицевого счета   
				Если ЗначениеЗаполнено(НовыйДокумент.ЛицевойСчет) Тогда 
					СтрДок.РазделЛС = Справочники.РазделыЛицевыхСчетов.РазделЛСПоКодуПоступленияЕБП(НовыйДокумент.ЛицевойСчет, СтрокаРасшифровки.КодПоступленияЕБП, ИнформацияОбОшибке, Истина); 
				КонецЕсли;  
				
				СтрДок.КодЦели = Справочники.ВидыЦелевыхСредств.ВидЦелевыхТекстовомуКоду(СтрокаРасшифровки.КодЦелевойСубсидии); 
				СтрДок.ОбъектФАИП = БиблиотекаФункцийОбмена.ОбъектФАИПКМИПоТекстовомуКоду(СтрокаРасшифровки.КодФАИП, Организация);   
				
				// Договор
				Если НЕ ОдинДоговор И ДанныеКОбработке.ДанныеЗаголовка.ТипОперации = "4" Тогда
					Если ЗначениеЗаполнено(СтрокаРасшифровки.ИдентификаторКонтракта) Тогда
						// ищем по реестровому номеру
					КонецЕсли;
				КонецЕсли;	
				
				СтрДок.Контрагент = НовыйДокумент.Контрагент;
				СтрДок.КодПрослеживаемости = СтрокаРасшифровки.КодПрослеживаемости;
				СтрДок.Примечание = СтрокаРасшифровки.Примечание;
				СтрДок.Сумма = СтрокаРасшифровки.СуммаОперации;
				СтрДок.СуммаВал = СтрокаРасшифровки.СуммаОперации;
				СтрДок.СуммаБезПраваРасходования = СтрокаРасшифровки.СуммаБезПраваРасходования;
				
				// Добавляем одну строку в таблицу Детализация платежа
				СтрокаДетализации = НовыйДокумент.ДетализацияПлатежа.Добавить(); 
				ЗаполнитьЗначенияСвойств(СтрокаДетализации, СтрДок); 
				СтрокаДетализации.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДетализации.РазделЛС, "КодПоступленияЕБП"));

			КонецЦикла;  
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
			ОтменитьТранзакцию(); 
			ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ИнформацияОбОшибке);
		Иначе
			НовыйДокумент.Записать();  
			
			Если НЕ ДанныеКОбработке.ДанныеФайлаВложения.Свойство("ДатаДокумента") Тогда
				ДанныеКОбработке.ДанныеФайлаВложения.Вставить("ДатаДокумента", Дата(1, 1, 1));
			КонецЕсли;
			Если НЕ ДанныеКОбработке.ДанныеФайлаВложения.Свойство("НомерДокумента") Тогда
				ДанныеКОбработке.ДанныеФайлаВложения.Вставить("НомерДокумента", "");
			КонецЕсли;	
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
			ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", НовыйДокумент.Ссылка); 
			Блокировка.Заблокировать();  
			
			НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(НовыйДокумент.Ссылка);
			НаборЗаписей.Прочитать(); 
			Если НаборЗаписей.Количество() =0 Тогда
				Запись = НаборЗаписей.Добавить();
			Иначе
				Запись = НаборЗаписей[0];
			КонецЕсли;
			Запись.ПлатежноРасчетныйДокумент = НовыйДокумент.Ссылка; 
			Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен"); 
			Запись.ДатаПроведения = ДанныеКОбработке.ДатаУчетная; 
			НаборЗаписей.Записать();
						
			ЗафиксироватьТранзакцию(); 
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
