	ТекущиеДанные.СуммаКомиссииЭСП = ?(ТекущиеДанные.СуммаОплатыЭСП > 0,
		ТекущиеДанные.СуммаОплатыЭСП - ТекущиеДанные.ДетализацияСумма,	0);

