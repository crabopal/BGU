&НаСервере
Процедура ПрочитатьТаблицыДокумента()
	
	Если Не ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		Возврат;
	КонецЕсли;

	ТаблицыДокумента = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	СобственныеПоляДетализации = СобственныеПоляДетализации();
	ПоляИсключения = СтрСоединить(СобственныеПоляДетализации, ",");
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторСтроки", Неопределено);
	Для Каждого ИсходнаяСтрока Из ТаблицыДокумента.РасшифровкаПлатежа Цикл
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
		НоваяСтрока.НомерСтрокиРасшифровки = ИсходнаяСтрока.НомерСтроки;
		Отбор.ИдентификаторСтроки = ИсходнаяСтрока.ИдентификаторСтроки;
		НашлиДетализацию = ТаблицыДокумента.ДетализацияПлатежа.НайтиСтроки(Отбор);
		Если НашлиДетализацию.Количество() > 0 Тогда
			ПерваяСтрока = Истина;
			Для Каждого ИсходнаяСтрокаДетализации Из НашлиДетализацию Цикл
				Если Не ПерваяСтрока Тогда
					НоваяСтрока = РасшифровкаПлатежа.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
					НоваяСтрока.НомерСтрокиРасшифровки = ИсходнаяСтрока.НомерСтроки;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрокаДетализации, , ПоляИсключения);
				Для Каждого ИмяПоля Из СобственныеПоляДетализации Цикл
					НоваяСтрока["Детализация" + ИмяПоля] = ИсходнаяСтрокаДетализации[ИмяПоля];
				КонецЦикла;
				Если Не ЗначениеЗаполнено(НоваяСтрока.Ребенок) Тогда
					НоваяСтрока.ДетализацияКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
					НоваяСтрока.ДетализацияДоговор = Справочники.Договоры.ПустаяСсылка();
				КонецЕсли;
				ПерваяСтрока = Ложь;
			КонецЦикла;
		Иначе
			НоваяСтрока.ДетализацияСумма = НоваяСтрока.Сумма;
			НоваяСтрока.ДетализацияСуммаВал = НоваяСтрока.СуммаВал;
			НоваяСтрока.ДетализацияКодЦели = НоваяСтрока.КодЦели;
			НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;  
			НоваяСтрока.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(
				КодПоступленияЕБП(НоваяСтрока.РазделЛС));
		КонецЕсли;
	КонецЦикла;
	
	СчетчикСтрокиРасшифровки = ТаблицыДокумента.РасшифровкаПлатежа.Количество();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередЗакрытиемПеренестиДанныеАсинх()

	ТекстВопроса = НСтр("ru = 'Родительская плата не перенесена в документ.
		|Перенести?'");
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПодготовитьИПередатьДанные();
		РезультатЗакрытия = "ПеренестиВДокумент";
		Закрыть(РезультатЗакрытия);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		РезультатЗакрытия = "Отмена";
		Закрыть(РезультатЗакрытия);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьИПередатьДанные()
	
	ТаблицыДокумента = РазделитьРасшифровкуНаТаблицы();
	ТаблицыДокумента.Вставить("РасшифровкаИзменена", РасшифровкаИзменена);
	ПоместитьВоВременноеХранилище(ТаблицыДокумента, АдресВременногоХранилища);
	
	СохранитьНастройкиЗаполнения();
	Если ЕстьДанныеГруппы Тогда
		СохранитьНастройкиСоответствияГрупп();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РазделитьРасшифровкуНаТаблицы()
	
	ТаблицаРасшифровкаСДетализацией = РеквизитФормыВЗначение("РасшифровкаПлатежа");
	
	ИменаКолонокРасшифровки = ИменаКолонокРасшифровки();
	ИменаКолонокДетализации = "ВидРасчетов,Договор,ДопКлассификация,ДопСубконтоРасчетов,ИдентификаторСтроки,"
		+ "КБКНазначениеПлатежа,КодМероприятия,КодЦели,Контрагент,КОСГУНазначениеПлатежа,КФО,ОплатитьДо,"
		+ "Подразделение,РазделЛС,СпособПогашенияЗадолженности,Сумма,СуммаВал,СуммаКомиссииЭСП,СуммаОплатыЭСП,"
		+ "СчетРасчетов,Ребенок";

	ТаблицаРасшифровки = ТаблицаРасшифровкаСДетализацией.СкопироватьКолонки(ИменаКолонокРасшифровки);
	ТаблицаДетализации = ТаблицаРасшифровкаСДетализацией.СкопироватьКолонки(ИменаКолонокДетализации);
	СобственныеПоляДетализации = СобственныеПоляДетализации();
	СобственныеПоляДетализацииСтрокой = СтрСоединить(СобственныеПоляДетализации, ",");
	
	ДобавилиСтроку = Новый Соответствие;
	Для Каждого ИсходнаяСтрока Из ТаблицаРасшифровкаСДетализацией Цикл
		
		Если Не Внешнее Или РасшифровкаИзменена Тогда
			ДобавитьСтрокуВТаблицуРасшифровки(ТаблицаРасшифровки, ИсходнаяСтрока, ДобавилиСтроку);
		КонецЕсли;
		
		СтрокаДетализации = ТаблицаДетализации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДетализации, ИсходнаяСтрока, , СобственныеПоляДетализацииСтрокой);
		Для Каждого ИмяПоля Из СобственныеПоляДетализации Цикл
			СтрокаДетализации[ИмяПоля] = ИсходнаяСтрока["Детализация" + ИмяПоля];
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаРасшифровки.Сортировать("НомерСтрокиРасшифровки");
	ТаблицыДокумента = Новый Структура;
	ТаблицыДокумента.Вставить("РасшифровкаПлатежа", ТаблицаРасшифровки);
	ТаблицыДокумента.Вставить("ДетализацияПлатежа", ТаблицаДетализации);
	
	Возврат ТаблицыДокумента;
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуВТаблицуРасшифровки(ТаблицаРасшифровки, ИсходнаяСтрока, ДобавилиСтроку)
	
	Если ДобавилиСтроку[ИсходнаяСтрока.ИдентификаторСтроки] = Неопределено Тогда
		СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, ИсходнаяСтрока);
		Если Не Внешнее Тогда
			СтрокаРасшифровки.Сумма = ИсходнаяСтрока.ДетализацияСумма;
			СтрокаРасшифровки.СуммаВал = ИсходнаяСтрока.ДетализацияСуммаВал;
		КонецЕсли;
		ДобавилиСтроку.Вставить(ИсходнаяСтрока.ИдентификаторСтроки, СтрокаРасшифровки);
	Иначе
		Если Не Внешнее Тогда
			СтрокаРасшифровки = ДобавилиСтроку[ИсходнаяСтрока.ИдентификаторСтроки];
			СтрокаРасшифровки.Сумма = СтрокаРасшифровки.Сумма + ИсходнаяСтрока.ДетализацияСумма;
			СтрокаРасшифровки.СуммаВал = СтрокаРасшифровки.СуммаВал + ИсходнаяСтрока.ДетализацияСуммаВал;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИменаКолонокРасшифровки()

	ИменаКолонокРасшифровки = "ИдентификаторСтроки,Договор,КБКНазначениеПлатежа,РазделЛС,КодПрослеживаемости,"
		+ "ОбъектФАИП,КодЦели,Примечание,Сумма,СуммаВал,СуммаБезПраваРасходования,АдресПлательщика,"
		+ "ИдентификаторПлательщика,Контрагент,НазначениеПлатежа,НомерСтрокиРасшифровки";
	
	Возврат ИменаКолонокРасшифровки;
	
КонецФункции

&НаСервере
Функция СобственныеПоляДетализации()
	СобственныеПоляДетализации = Новый Массив;
	СобственныеПоляДетализации.Добавить("Договор");
	СобственныеПоляДетализации.Добавить("КБКНазначениеПлатежа");
	СобственныеПоляДетализации.Добавить("КодЦели");
	СобственныеПоляДетализации.Добавить("Контрагент");
	СобственныеПоляДетализации.Добавить("Сумма");
	СобственныеПоляДетализации.Добавить("СуммаВал");
	Возврат СобственныеПоляДетализации;
КонецФункции

&НаСервере
Процедура ОбработатьГрупповоеЗаполнениеРеквизитов(Знач ВыделенныеСтроки)
	
	РеквизитыЗаполнения = Новый Структура;
	Для Каждого Строка Из ТаблицаРеквизитов Цикл
		Если Строка.ИзменятьРеквизит Тогда
			РеквизитыЗаполнения.Вставить(Строка.ИмяРеквизита, Строка.ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	СоответствиеГрупп = Новый Соответствие;
	Если ЕстьДанныеГруппы И ЗаполнитьДоговорПоНазначению Тогда
		Для Каждого Строка Из ТаблицаГрупп Цикл
			СоответствиеГрупп.Вставить(Строка.НомерГруппы, Строка.ГруппаДетскогоУчреждения);
		КонецЦикла;
	КонецЕсли;
	ОпределитьРебенкаПоНазначению = ЕстьДанныеРебенка И ЗаполнитьРебенка;
	ОпределитьДоговорПоНазначению = ЕстьДанныеРебенка И ЕстьДанныеГруппы И ЗаполнитьДоговорПоНазначению;
	ОпределитьДоговорПоОсновнойГруппе = ЕстьДанныеРебенка И ЗаполнитьДоговорПоОсновнойГруппе;
	ПараметрыЗаполненияРебенка = Новый Структура;
	ПараметрыЗаполненияРебенка.Вставить("Организация", Организация);
	ПараметрыЗаполненияРебенка.Вставить("ДатаДокумента", ДатаДокумента);
	ПараметрыЗаполненияРебенка.Вставить("СтрокаНазначениеПлатежа", "");
	ПараметрыЗаполненияРебенка.Вставить("СоответствиеГрупп", СоответствиеГрупп);
	ПараметрыЗаполненияРебенка.Вставить("ОпределитьРебенкаПоНазначению", ОпределитьРебенкаПоНазначению);
	ПараметрыЗаполненияРебенка.Вставить("ОпределитьДоговорПоНазначению", ОпределитьДоговорПоНазначению);
	ПараметрыЗаполненияРебенка.Вставить("Ребенок", Справочники.Дети.ПустаяСсылка());
	
	ЗаполнитьВсеСтроки = ВыделенныеСтроки.Количество() = РасшифровкаПлатежа.Количество();

	Если ЗаполнитьВсеСтроки Тогда
		КоллекцияЗначений = РасшифровкаПлатежа;
	Иначе
		КоллекцияЗначений = ВыделенныеСтроки;
	КонецЕсли;

	ЗначенияКПСРасшифровки = Новый Соответствие;
	КэшДопустимыеКоды = Новый Соответствие;
	КэшРеквизитыКПС = Новый Соответствие;
	Для Каждого ЗначениеКоллекции Из КоллекцияЗначений Цикл
		
		Если ЗаполнитьВсеСтроки Тогда
			Строка = ЗначениеКоллекции;
		Иначе
			Строка = РасшифровкаПлатежа.НайтиПоИдентификатору(ЗначениеКоллекции);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Строка, РеквизитыЗаполнения);
			
		Если РеквизитыЗаполнения.Свойство("КФО") Тогда

			Если Не КФОСоответствуетРазделуЛС(Строка.КФО, Строка.РазделЛС, ДатаДокумента, КэшДопустимыеКоды) Тогда
				Строка.КФО = Перечисления.КВД.ПустаяСсылка();
				ТекстСообщения = СтрШаблон(НСтр(
					"ru='Выбранный КФО ""%1"" не соответствует разделу лицевого счета ""%2""'"),
					РеквизитыЗаполнения.КФО, Строка.РазделЛС);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		Если РеквизитыЗаполнения.Свойство("КБКНазначениеПлатежа") Тогда
			Строка.ДетализацияКБКНазначениеПлатежа = Строка.КБКНазначениеПлатежа;
			ЗначенияКПСРасшифровки.Вставить(Строка.ИдентификаторСтроки, Строка.КБКНазначениеПлатежа);
		КонецЕсли;
		
		Если РеквизитыЗаполнения.Свойство("ДетализацияКБКНазначениеПлатежа") Тогда
			Если Внешнее Тогда
				Если Не КПСДетализацииСоответствуетКБКРасшифровки(Строка.ДетализацияКБКНазначениеПлатежа,
					Строка.КБКНазначениеПлатежа, КэшРеквизитыКПС) Тогда
					Строка.ДетализацияКБКНазначениеПлатежа = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
					ТекстСообщения = СтрШаблон(НСтр(
						"ru='Выбранный КПС ""%1"" не соответствует КБК платежа ""%2""'"),
						РеквизитыЗаполнения.ДетализацияКБКНазначениеПлатежа, Строка.КБКНазначениеПлатежа);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;
			Иначе
				Строка.КБКНазначениеПлатежа = Строка.ДетализацияКБКНазначениеПлатежа;
				ЗначенияКПСРасшифровки.Вставить(Строка.ИдентификаторСтроки, Строка.КБКНазначениеПлатежа);
			КонецЕсли;
		КонецЕсли;

		Если РеквизитыЗаполнения.Свойство("КодМероприятия") Тогда
			УстановитьДопСубконтоРасчетов(Строка, "КодМероприятия");
		КонецЕсли;
		Если РеквизитыЗаполнения.Свойство("ДопКлассификация") Тогда
		    УстановитьДопСубконтоРасчетов(Строка, "ДопКлассификация");
		КонецЕсли;
		Если РеквизитыЗаполнения.Свойство("ДетализацияКодЦели") Тогда
		    УстановитьДопСубконтоРасчетов(Строка, "ДетализацияКодЦели");
		КонецЕсли;
		
		Если РеквизитыЗаполнения.Свойство("СчетРасчетов") Тогда
			ПриИзмененииСчетаРасчетовВСтрокеРасшифровки(Строка, КорСчет, ДатаДокумента, Организация, ИФО);
		КонецЕсли;
		
		Если ОпределитьРебенкаПоНазначению Или ОпределитьДоговорПоНазначению Тогда
			ПараметрыЗаполненияРебенка.СтрокаНазначениеПлатежа = Строка.НазначениеПлатежа;
			ПараметрыЗаполненияРебенка.Ребенок = Строка.Ребенок;
			ДанныеРебенкаПоНазначению = РодительскаяПлата.ДанныеРебенкаПоСтрокеНазначенияПлатежа(
				ПараметрыЗаполненияРебенка);
			Если ОпределитьРебенкаПоНазначению Тогда
				Строка.Ребенок = ДанныеРебенкаПоНазначению.Ребенок;
				Строка.ДетализацияКонтрагент = ДанныеРебенкаПоНазначению.Контрагент;
				
				Если Не ЗначениеЗаполнено(Строка.Ребенок) Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось определить ребенка по строке: %1'"),
					Строка.НазначениеПлатежа);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;	
				
			КонецЕсли;
			Если ОпределитьДоговорПоНазначению Тогда
				Строка.ДетализацияДоговор = ДанныеРебенкаПоНазначению.Договор;
			Иначе
				Если Не ДоговорСоответствуетКонтрагенту(Строка.ДетализацияДоговор, Строка.ДетализацияКонтрагент) Тогда
					Строка.ДетализацияДоговор = Справочники.Договоры.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОпределитьДоговорПоОсновнойГруппе Тогда
			Если Не ЗначениеЗаполнено(Строка.ДетализацияДоговор) Или Не ОпределитьДоговорПоНазначению Тогда
				Строка.ДетализацияДоговор = РодительскаяПлата.ОсновнойДоговорРебенка(Строка.Ребенок, ДатаДокумента);
			КонецЕсли;
		КонецЕсли;
		
		Если (ОпределитьДоговорПоНазначению Или ОпределитьДоговорПоОсновнойГруппе)
			И ЗначениеЗаполнено(Строка.Ребенок)	И Не ЗначениеЗаполнено(Строка.ДетализацияДоговор) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось определить договор ребенка %1'"), Строка.Ребенок);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;	

	КонецЦикла;
	
	Если Не ЗаполнитьВсеСтроки И Не Внешнее Тогда
		
		Для Каждого КлючИЗначение Из ЗначенияКПСРасшифровки Цикл
			ОбработатьИзменениеВСтрокеРасшифровки("КБКНазначениеПлатежа", КлючИЗначение.Значение,
				КлючИЗначение.Ключ, Неопределено);			
			ОбработатьИзменениеВСтрокеРасшифровки("ДетализацияКБКНазначениеПлатежа", КлючИЗначение.Значение,
				КлючИЗначение.Ключ, Неопределено);			
		КонецЦикла;
		
	КонецЕсли;

	СохранитьНастройкиЗаполнения();
	Если ЕстьДанныеГруппы Тогда
		СохранитьНастройкиСоответствияГрупп();
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КФОСоответствуетРазделуЛС(КФО, РазделЛС, ДатаДокумента, КэшДопустимыеКоды)
	
	Если Не ЗначениеЗаполнено(КФО) Или Не ЗначениеЗаполнено(РазделЛС) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДопустимыеКоды = КэшДопустимыеКоды[РазделЛС];	
	Если ДопустимыеКоды = Неопределено Тогда
		СоотвествиеКодов = ПлатежноРасчетныеДокументыКлиентСервер.СоответствиеКФОКодамПоступленийЕБП(ДатаДокумента);
		КодПоступленияЕБП = КодПоступленияЕБП(РазделЛС);
		ДопустимыеКоды = Новый Массив;
		Для Каждого КлючИЗначение Из СоотвествиеКодов Цикл 
			Если КлючИЗначение.Значение = КодПоступленияЕБП Тогда
				ДопустимыеКоды.Добавить(КлючИЗначение.Ключ);	
			КонецЕсли;
		КонецЦикла;
		КэшДопустимыеКоды.Вставить(РазделЛС, ДопустимыеКоды);
	КонецЕсли;
	
	Возврат ДопустимыеКоды.Найти(КФО) <> Неопределено;
	
КонецФункции

&НаСервере
Функция КПСДетализацииСоответствуетКБКРасшифровки(КПСДетализации, КБКРасшифровки, КэшРеквизитыКПС)
	
	Если Не ЗначениеЗаполнено(КПСДетализации) Или Не ЗначениеЗаполнено(КБКРасшифровки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	РеквизитыКПСДетализации = КэшРеквизитыКПС[КПСДетализации];
	Если РеквизитыКПСДетализации = Неопределено Тогда
		РеквизитыКПСДетализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КПСДетализации,
			"ВидПоказателя,УточнениеПоказателя,Код");
		КэшРеквизитыКПС.Вставить(КПСДетализации, РеквизитыКПСДетализации);
	КонецЕсли;

	РеквизитыКБКРасшифровки = КэшРеквизитыКПС[КБКРасшифровки];
	Если РеквизитыКБКРасшифровки = Неопределено Тогда
		РеквизитыКБКРасшифровки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КБКРасшифровки,
			"ВидПоказателя,УточнениеПоказателя,Код");
		КэшРеквизитыКПС.Вставить(КБКРасшифровки, РеквизитыКБКРасшифровки);
	КонецЕсли;
	
	Возврат 
		РеквизитыКПСДетализации.ВидПоказателя = РеквизитыКБКРасшифровки.ВидПоказателя
		И РеквизитыКПСДетализации.УточнениеПоказателя = РеквизитыКБКРасшифровки.УточнениеПоказателя
		И Прав(РеквизитыКПСДетализации.Код, 3) = Прав(РеквизитыКБКРасшифровки.Код, 3);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДоговорСоответствуетКонтрагенту(Договор, Контрагент)
	Если Не ЗначениеЗаполнено(Договор) Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Истина;
	КонецЕсли;
	КонтрагентДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Контрагент");
	Возврат КонтрагентДоговора = Контрагент Или Не ЗначениеЗаполнено(КонтрагентДоговора); 
КонецФункции

&НаСервереБезКонтекста
Функция КодПоступленияЕБП(Знач РазделЛС)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛС, "КодПоступленияЕБП");
КонецФункции

&НаСервереБезКонтекста
Функция ДополнительныйОтборКБК(Знач КБКИсходный)
	
	ОтборКБК = Новый Структура;
	РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КБКИсходный, "ВидПоказателя,УточнениеПоказателя,Код"); 
	ОтборКБК.Вставить("ВидПоказателя", РеквизитыКБК.ВидПоказателя);
	ОтборКБК.Вставить("УточнениеПоказателя", РеквизитыКБК.УточнениеПоказателя);
	ОтборКБК.Вставить("КодАналитическойГруппы", Прав(РеквизитыКБК.Код, 3));

	Возврат ОтборКБК;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииРебенкаВСтроке(СтрокаДетализации)
	ЗапомнилиКонтрагента = СтрокаДетализации.ДетализацияКонтрагент;
	СтрокаДетализации.ДетализацияКонтрагент = КонтрагентРебенка(СтрокаДетализации.Ребенок);
	Если СтрокаДетализации.ДетализацияКонтрагент <> ЗапомнилиКонтрагента Тогда
		СтрокаДетализации.ДетализацияДоговор = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтрагентРебенка(Знач Ребенок)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ребенок, "Контрагент");
КонецФункции 

&НаСервереБезКонтекста
Функция СписокОчередныхПлатежейПоГрафику(Знач Организация, Знач Договор, Знач Отбор)
	
	Отбор.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	Возврат КонтрольИсполненияДоговоров.СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеСтрокиПриИзмененииКОСГУНазначениеПлатежа(Знач ДанныеСтроки, Знач ДанныеОбъекта)
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(ДанныеОбъекта.КорСчет) Тогда
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
			ДанныеСтроки.КОСГУНазначениеПлатежа, ДанныеОбъекта.КорСчет, ДанныеОбъекта.Дата, ДанныеОбъекта.Организация,
			ДанныеОбъекта.ИФО);
	КонецЕсли;   
	
	Возврат ДанныеСтроки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСчетаРасчетовВСтрокеРасшифровки(ТекущиеДанные, КорСчет, ДатаДокумента, Организация, ИФО)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("КОСГУНазначениеПлатежа", ТекущиеДанные.КОСГУНазначениеПлатежа);
	ДанныеСтроки.Вставить("СчетРасчетов", ТекущиеДанные.СчетРасчетов);
	ДанныеСтроки.Вставить("СпособПогашенияЗадолженности", ТекущиеДанные.СпособПогашенияЗадолженности);
	ДанныеСтроки.Вставить("ДопСубконтоРасчетов", ТекущиеДанные.ДопСубконтоРасчетов);
	ДанныеСтроки.Вставить("ДопСубконтоРасчетовВид", ТекущиеДанные.ДопСубконтоРасчетовВид);
	ДанныеСтроки.Вставить("ДопСубконтоРасчетовДоступность", ТекущиеДанные.ДопСубконтоРасчетовДоступность);
	ДанныеСтроки.Вставить("ДопСубконтоРасчетовНомер", ТекущиеДанные.ДопСубконтоРасчетовНомер);
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("КорСчет", КорСчет);
	ДанныеОбъекта.Вставить("Дата", ДатаДокумента);
	ДанныеОбъекта.Вставить("Организация", Организация);
	ДанныеОбъекта.Вставить("ИФО", ИФО);
	
	ДанныеСтрокиПриИзмененииСчетаРасчетов = ДанныеСтрокиПриИзмененииСчетаРасчетов(ДанныеСтроки, ДанныеОбъекта);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСтрокиПриИзмененииСчетаРасчетов);
	
	УстановитьДопСубконтоРасчетов(ТекущиеДанные, "КодМероприятия");
    УстановитьДопСубконтоРасчетов(ТекущиеДанные, "ДопКлассификация");
    УстановитьДопСубконтоРасчетов(ТекущиеДанные, "ДетализацияКодЦели");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСтрокиПриИзмененииСчетаРасчетов(Знач ДанныеСтроки, Знач ДанныеОбъекта)
	
	ДанныеСтроки.ДопСубконтоРасчетов = Неопределено;
	ДанныеСтроки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки, ДанныеСтроки.КОСГУНазначениеПлатежа,
		ДанныеОбъекта.КорСчет, ДанныеОбъекта.Дата, ДанныеОбъекта.Организация, ДанныеОбъекта.ИФО, Истина);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КОСГУНазначениеПлатежа) И ЗначениеЗаполнено(ДанныеСтроки.СчетРасчетов) Тогда
		ДанныеСтроки.КОСГУНазначениеПлатежа = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(ДанныеСтроки.СчетРасчетов);
	КонецЕсли;
	
	Возврат ДанныеСтроки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопСубконтоРасчетов(ТекущиеДанные, ИмяИсточника)  
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные[ИмяИсточника]) = ТипЗнч(ТекущиеДанные.ДопСубконтоРасчетов)
		И НЕ ТекущиеДанные[ИмяИсточника] = ТекущиеДанные.ДопСубконтоРасчетов Тогда
		ТекущиеДанные.ДопСубконтоРасчетов = ТекущиеДанные[ИмяИсточника];
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСчетчикСтрокПослеУдаления()
	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		СчетчикСтрокиРасшифровки = 0;
		Возврат;
	КонецЕсли;
	ТаблицаСтрок = РасшифровкаПлатежа.Выгрузить(, "НомерСтрокиРасшифровки,ИдентификаторСтроки");
	ТаблицаСтрок.Свернуть("НомерСтрокиРасшифровки,ИдентификаторСтроки");
	ТаблицаСтрок.Сортировать("НомерСтрокиРасшифровки");
	НовыйНомерСтроки = 0;
	Для Каждого Строка Из ТаблицаСтрок Цикл
		НовыйНомерСтроки = НовыйНомерСтроки + 1;
		Если Строка.НомерСтрокиРасшифровки <> НовыйНомерСтроки Тогда
			ОбработатьИзменениеВСтрокеРасшифровки("НомерСтрокиРасшифровки", НовыйНомерСтроки, Строка.ИдентификаторСтроки,
				Неопределено);
		КонецЕсли;
	КонецЦикла;
	СчетчикСтрокиРасшифровки = НовыйНомерСтроки;	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеВСтрокеРасшифровки(Знач ИмяПоля, Знач Значение, Знач ИдентификаторСтроки,
	Знач ИдентификаторТекущейСтроки)
	
	НашлиСтроки = РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого Строка Из НашлиСтроки Цикл
		Если Строка.ПолучитьИдентификатор() = ИдентификаторТекущейСтроки Тогда
			Продолжить;
		КонецЕсли;
		Строка[ИмяПоля] = Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаРазделЛС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаКБКНазначениеПлатежа");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаОбъектФАИП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаИдентификаторПлательщика");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаАдресПлательщика");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаКодЦели");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаКодПрослеживаемости");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаСуммаБезПраваРасходования");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаПримечание");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Внешнее", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);

	// Счет расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаСчетРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<авто>'"));
	
	// Доступность реквизитов "Способ погашения задолженности" и "Доп. аналитика расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаСпособПогашенияЗадолженности");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Если "Способ погашения задолженности" не заполнен, значит погашаем автоматически.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаСпособПогашенияЗадолженности");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.СпособПогашенияЗадолженности", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Автоматически'"));
	
	// Для доп.субконто "Документы расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетовВид", ВидСравненияКомпоновкиДанных.Равно,
			ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.СпособПогашенияЗадолженности", ВидСравненияКомпоновкиДанных.НеРавно,
			Перечисления.СпособыПогашенияЗадолженности.ПоДокументу);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Обязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Необязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 2);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Нет доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Автоматически определять дату оплаты по графику платежей.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасшифровкаПлатежаОплатитьДо");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РасшифровкаПлатежа.ОплатитьДо", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<авто>");

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаГруппГруппаДетскогоУчреждения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЗаполнитьДоговорПоНазначению", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовРасчеты()
	
	ИспользуетсяНастройкаПогашенияЗадолженности = УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет);
	НастройкаПогашенияЗадолженности = Новый Массив;
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСчетРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСпособПогашенияЗадолженности");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		НастройкаПогашенияЗадолженности, "Видимость", ИспользуетсяНастройкаПогашенияЗадолженности);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовГрафикПлатежей()
	
	ВидимостьЭлементовГрафикаПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И КонтрольИсполненияДоговоров.ВедетсяГрафикПлатежейПоСчетуРасчетов(КорСчет, Истина);
	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("РасшифровкаПлатежаВидРасчетов");
	ЭлементыГрафикПлатежей.Добавить("РасшифровкаПлатежаОплатитьДо");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГрафикПлатежей, "Видимость", ВидимостьЭлементовГрафикаПлатежей);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"РасшифровкаПлатежаВидРасчетовБезГрафика", "Видимость",
			НЕ ВидимостьЭлементовГрафикаПлатежей И БухгалтерскийУчет.СчетВИерархии(КорСчет, "207.00") );
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРеквизитов()
	
	Если Не Внешнее Тогда
		ДобавитьСтрокуРеквизита("КБКНазначениеПлатежа", НСтр("ru = 'КБК'"),
			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов")); 
	КонецЕсли;
	
	ДобавитьСтрокуРеквизита("КФО", НСтр("ru = 'КФО'"),
		Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		
	Если Внешнее Тогда
		ДобавитьСтрокуРеквизита("ДетализацияКБКНазначениеПлатежа", НСтр("ru = 'КПС'"),
			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	
	ДобавитьСтрокуРеквизита("КОСГУНазначениеПлатежа", НСтр("ru = 'КОСГУ'"),
		Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); 
	ДобавитьСтрокуРеквизита("КодМероприятия", НСтр("ru = 'Код мероприятия'"),
		Новый ОписаниеТипов("СправочникСсылка.Мероприятия")); 
	ДобавитьСтрокуРеквизита("ДопКлассификация", НСтр("ru = 'Доп. классификация'"),
		Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация")); 
	ДобавитьСтрокуРеквизита("ДетализацияКодЦели", НСтр("ru = 'Код цели'"),
		Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет) Тогда	 
		ДобавитьСтрокуРеквизита("СчетРасчетов", НСтр("ru = 'Счет расчетов'"),
			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
		 
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРеквизита(Имя, Представление, Тип)
	НоваяСтрока = ТаблицаРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита = Имя;
	НоваяСтрока.ПредставлениеРеквизита = Представление;
	НоваяСтрока.ТипРеквизита = Тип;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОграниченияВыбираемыхТиповИПараметрыВыбораЗначения(ТабличноеПоле)

	ТекущиеДанные = ТабличноеПоле.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВвода = ТабличноеПоле.ПодчиненныеЭлементы[ТабличноеПоле.Имя + "ЗначениеРеквизита"];
	ПараметрыВыбораМассив = Новый Массив;
	
	Если ТекущиеДанные.ИмяРеквизита = "КФО" Тогда
		ПараметрыВыбораМассив.Добавить(Новый ПараметрВыбора("НаДату", ДатаДокумента));
		ПараметрыВыбораМассив.Добавить(Новый ПараметрВыбора("Организация", Организация));
		Если ИспользоватьУчетПоИФО Тогда
			ПараметрыВыбораМассив.Добавить(Новый ПараметрВыбора("ИФО", ИФО));
		КонецЕсли;
	ИначеЕсли ТекущиеДанные.ИмяРеквизита = "ДетализацияКБКНазначениеПлатежа"
			Или ТекущиеДанные.ИмяРеквизита = "КБКНазначениеПлатежа" Тогда
		ПараметрыВыбораМассив.Добавить(Новый ПараметрВыбора("Организация", Организация));
		Если ИспользоватьУчетПоИФО Тогда
			ПараметрыВыбораМассив.Добавить(Новый ПараметрВыбора("ИФО", ИФО));
		КонецЕсли;
		ПолеВвода.ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
	КонецЕсли;
	
	ПолеВвода.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораЗначенияРеквизита(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ИмяРеквизита = ТекущиеДанные.ИмяРеквизита;
	
	Если ИмяРеквизита = "ДетализацияКБКНазначениеПлатежа"
		Или ИмяРеквизита = "КБКНазначениеПлатежа" Тогда
		
		СтандартнаяОбработка = Ложь;
		ОтборКБК = Новый Структура;
		ОтборКБК.Вставить("НаДату", ДатаДокумента);
		ОтборКБК.Вставить("Организация", Организация);
	    ОтборКБК.Вставить("ИФО", ИФО);
		ПараметрыКБК = Новый Структура("Отбор", ОтборКБК);
		ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыКБК, Элемент);
		
	ИначеЕсли ИмяРеквизита = "СчетРасчетов" Тогда
		
		ДанныеОбъекта = Новый Структура;
		ДанныеОбъекта.Вставить("Дата", ДатаДокумента);
		ДанныеОбъекта.Вставить("Организация", Организация);
		ДанныеОбъекта.Вставить("ИФО", ИФО);
		
		ПараметрыОтбораСчетаРасчетов = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
			ДанныеОбъекта, Неопределено, КорСчет, ТекущиеДанные.ЗначениеРеквизита);
	
		УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовНачалоВыбора(ПараметрыОтбораСчетаРасчетов,
			Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

