&НаКлиенте
Процедура РасшифровкаПлатежаРебенокОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
		
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь; 
		ТекущиеДанные.Ребенок = ВыбранноеЗначение.Ребенок;			
		ТекущиеДанные.ДетализацияКонтрагент = ВыбранноеЗначение.Контрагент;
		ТекущиеДанные.ДетализацияДоговор = ВыбранноеЗначение.Договор;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаРебенокНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("НаДату", НачалоДня(ДатаДокумента));
	ПараметрыФормы.Вставить("Ребенок", ТекущиеДанные.Ребенок);
	ПараметрыФормы.Вставить("Договор", ТекущиеДанные.ДетализацияДоговор);
	ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбораПоГруппам", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДетализацияКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если ТекущиеДанные.ДетализацияКонтрагент <> КонтрагентРебенка(ТекущиеДанные.Ребенок) Тогда
		ТекущиеДанные.Ребенок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидРасчетов", ТекущиеДанные.ВидРасчетов);
	Отбор.Вставить("КФО", ТекущиеДанные.КФО);
	Отбор.Вставить("КодЦели", ТекущиеДанные.ДетализацияКодЦели);
	Отбор.Вставить("КодМероприятия", ТекущиеДанные.КодМероприятия);
	Отбор.Вставить("ДопКлассификация", ТекущиеДанные.ДопКлассификация);
	Отбор.Вставить("ИФО", ИФО);
	Отбор.Вставить("Контрагент", ТекущиеДанные.ДетализацияКонтрагент);
	Отбор.Вставить("Договор", ТекущиеДанные.ДетализацияДоговор);
	Отбор.Вставить("КПС", ТекущиеДанные.КБКНазначениеПлатежа);
	Отбор.Вставить("КЭК", ТекущиеДанные.КОСГУНазначениеПлатежа);
	Отбор.Вставить("ЭтоПоступление", Истина);
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Организация, ТекущиеДанные.ДетализацияДоговор, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

