&НаСервере
Процедура ОпределитьПараметрыЗаполненияРебенка()
	
	Если Не ПоРеестру Или РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаНазначениеПлатежа = ВРег(РасшифровкаПлатежа[0].НазначениеПлатежа);
	
	ЕстьДанныеРебенка = СтрНайти(СтрокаНазначениеПлатежа, "PERSACC:") > 0
		И СтрНайти(СтрокаНазначениеПлатежа, "CHILDFIO:") > 0;

	ЕстьДанныеГруппы = СтрНайти(СтрокаНазначениеПлатежа, "CLASSNUM:") > 0 И ЕстьДанныеРебенка;
	
	Если ЕстьДанныеГруппы Тогда
		НомераГрупп = Новый Массив;
		Для Каждого Строка Из РасшифровкаПлатежа Цикл
			НомераГрупп.Добавить(РодительскаяПлата.ЗначенияПолейСтрокиПлатежаПоРеестру(Строка.НазначениеПлатежа,
				"НомерГруппы").НомерГруппы);
		КонецЦикла;
		НомераГрупп = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НомераГрупп);
		Для Каждого НомерГруппы Из НомераГрупп Цикл
			Если Не ЗначениеЗаполнено(НомерГруппы) Тогда
				Продолжить;
			КонецЕсли; 
			НоваяСтрока = ТаблицаГрупп.Добавить();
			НоваяСтрока.НомерГруппы = НомерГруппы;
			НоваяСтрока.ГруппаДетскогоУчреждения = РодительскаяПлата.ГруппаДетскогоУчрежденияПоНаименованию(
				НомерГруппы, Организация);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиЗаполнения()
	Перем ЗначенияРеквизитов;
	
	НастройкиЗаполнения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиЗаполнения(), Новый Структура);

	Если ТипЗнч(НастройкиЗаполнения) <> Тип("Структура") Тогда
		НастройкиЗаполнения = Новый Структура;
	КонецЕсли;

	Если ЕстьДанныеРебенка Тогда
		НастройкиЗаполнения.Вставить("ЗаполнитьРебенка", ЗаполнитьРебенка);
		НастройкиЗаполнения.Вставить("ЗаполнитьДоговорПоОсновнойГруппе", ЗаполнитьДоговорПоОсновнойГруппе);
		НастройкиЗаполнения.Вставить("ЗаполнитьДоговорПоНазначению", ЗаполнитьДоговорПоНазначению);
	КонецЕсли;
	НастройкиЗаполнения.Свойство("ЗначенияРеквизитов", ЗначенияРеквизитов);
	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Структура") Тогда
		ЗначенияРеквизитов = Новый Структура;
	КонецЕсли;
	Для Каждого Строка Из ТаблицаРеквизитов Цикл
		Если Строка.ИзменятьРеквизит Или ЗначениеЗаполнено(Строка.ЗначениеРеквизита) Тогда
			ЗначенияРеквизитов.Вставить(Строка.ИмяРеквизита, Новый Структура("ИзменятьРеквизит,ЗначениеРеквизита",
				Строка.ИзменятьРеквизит, Строка.ЗначениеРеквизита));
		КонецЕсли;
	КонецЦикла;
	НастройкиЗаполнения.Вставить("ЗначенияРеквизитов", ЗначенияРеквизитов);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиЗаполнения(), НастройкиЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиСоответствияГрупп()
	
	СоответствиеГрупп = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиСоответствияГрупп(), Новый Соответствие);
	Если ТипЗнч(СоответствиеГрупп) <> Тип("Соответствие") Тогда
		СоответствиеГрупп = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаГрупп Цикл
		Если ЗначениеЗаполнено(Строка.ДатаАктуальности) Тогда
			СоответствиеГрупп.Вставить(Строка.НомерГруппы, Новый Структура("ГруппаДетскогоУчреждения,ДатаАктуальности",
				Строка.ГруппаДетскогоУчреждения, ДатаАктуальности));
		КонецЕсли;
	КонецЦикла;
	
	ГлубинаАктуальности = 12;
	КлючиКОчистке = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеГрупп Цикл
		Если ДобавитьМесяц(КлючИЗначение.Значение.ДатаАктуальности, ГлубинаАктуальности) < ДатаАктуальности Тогда
			КлючиКОчистке.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого НомерГруппы Из КлючиКОчистке Цикл
		СоответствиеГрупп.Удалить(НомерГруппы);
	КонецЦикла;
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиСоответствияГрупп(), СоответствиеГрупп);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиЗаполнения()
	Перем ЗначенияРеквизитов;
	
	НастройкиЗаполнения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиЗаполнения(), Новый Структура);

	Если ТипЗнч(НастройкиЗаполнения) <> Тип("Структура") Тогда
		НастройкиЗаполнения = Новый Структура;
	КонецЕсли;
	
	СписокСвойств = Новый Массив;
	СписокСвойств.Добавить("ЗаполнитьРебенка");
	СписокСвойств.Добавить("ЗаполнитьДоговорПоОсновнойГруппе");
	СписокСвойств.Добавить("ЗаполнитьДоговорПоНазначению");
	Для Каждого ИмяСвойства Из СписокСвойств Цикл
		Если НастройкиЗаполнения.Свойство(ИмяСвойства) Тогда
			ЭтотОбъект[ИмяСвойства] = НастройкиЗаполнения[ИмяСвойства];
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкиЗаполнения.Свойство("ЗначенияРеквизитов", ЗначенияРеквизитов)
		И ТипЗнч(ЗначенияРеквизитов) = Тип("Структура") Тогда
		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Если ЗначенияРеквизитов.Свойство(Строка.ИмяРеквизита) Тогда
				ЗаполнитьЗначенияСвойств(Строка, ЗначенияРеквизитов[Строка.ИмяРеквизита]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиСоответствияГрупп()
	
	СоответствиеГрупп = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастройкиЗаполнения(),
		КлючНастройкиСоответствияГрупп(), Новый Соответствие);
	Если ТипЗнч(СоответствиеГрупп) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаГрупп Цикл
		СохраненноеЗначение = СоответствиеГрупп[Строка.НомерГруппы];
		Если СохраненноеЗначение <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Строка, СохраненноеЗначение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КлючОбъектаНастройкиЗаполнения()
	Возврат "ПоступлениеНаСчет.ПомощникЗаполнения";
КонецФункции

&НаСервере
Функция КлючНастройкиЗаполнения()
	Возврат СтрШаблон("РодительскаяПлата-%1", Организация.УникальныйИдентификатор());
КонецФункции

&НаСервере
Функция КлючНастройкиСоответствияГрупп()
	Возврат СтрШаблон("РодительскаяПлата.СоответствиеГрупп-%1", Организация.УникальныйИдентификатор());
КонецФункции

#КонецОбласти
