#Область ОписаниеПеременных

&НаКлиенте
Перем РезультатЗакрытия;

&НаКлиенте
Перем ДанныеТекущейСтроки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И РезультатЗакрытия = Неопределено Тогда
		Отказ = Истина;
		ВопросПередЗакрытиемПеренестиДанныеАсинх();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресВременногоХранилища = Параметры.АдресВременногоХранилища;
	ВидПервичногоДокумента = Параметры.ВидПервичногоДокумента;
	Внешнее = Параметры.Внешнее;
	ДатаДокумента = Параметры.ДатаДокумента;
	ДатаПервичногоДокумента = Параметры.ДатаПервичногоДокумента;
	ИФО = Параметры.ИФО;
	МодульИнтеграции = Параметры.МодульИнтеграции;
	НомерПервичногоДокумента = Параметры.НомерПервичногоДокумента;
	Организация = Параметры.Организация;
	НазначениеПлатежа = Параметры.НазначениеПлатежа;
	ПоРеестру = Параметры.ПоРеестру;
	ЛицевойСчет = Параметры.ЛицевойСчет;
	КорСчет = Параметры.КорСчет;
	Контрагент = Параметры.Контрагент;

	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");

	Заголовок = СтрШаблон(НСтр("ru = 'Помощник заполнения родительской платы в %1 %2 от %3'"),
		Параметры.Ссылка.Метаданные().Представление(), Параметры.НомерДокумента, ДатаДокумента);

	КлючФормы = СтрШаблон("ФормаЗаполненияРодительскаяПлата%1%2",
		?(Внешнее, "Внешнее", ""), ?(ПоРеестру, "ПоРеестру", ""));
	КлючНазначенияИспользования = КлючФормы;
	КлючСохраненияПоложенияОкна = КлючФормы;

	НомерКартинкиМаршрут = ?(Внешнее, 2, 0);
	
	ПрочитатьТаблицыДокумента();
	
	Элементы.РасшифровкаПлатежаНазначениеПлатежа.Видимость = ПоРеестру;
	Элементы.РасшифровкаПлатежаНазначениеПлатежа.РедактированиеТекста = Не Внешнее;
	Элементы.РасшифровкаПлатежаДетализацияКБКНазначениеПлатежа.Видимость = Внешнее;
	
	Элементы.РасшифровкаПлатежаКонтрагент.Видимость = ПоРеестру;
	Элементы.РасшифровкаПлатежаИдентификаторПлательщика.Видимость = ПоРеестру;
	Элементы.РасшифровкаПлатежаАдресПлательщика.Видимость = ПоРеестру;
	
	Элементы.РасшифровкаПлатежа.ИзменятьСоставСтрок = Не (Внешнее И ПоРеестру);

	УстановитьУсловноеОформление();
	
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
	ЗаполнитьСписокРеквизитов();
	ОпределитьПараметрыЗаполненияРебенка();

	Элементы.ЗаполнитьРебенка.Видимость = ЕстьДанныеРебенка;
	Элементы.ЗаполнитьДоговорПоОсновнойГруппе.Видимость = ЕстьДанныеРебенка;
	Элементы.ЗаполнитьДоговорПоНазначению.Видимость = ЕстьДанныеРебенка И ЕстьДанныеГруппы;
	Элементы.ТаблицаГрупп.Видимость = ЕстьДанныеРебенка И ЕстьДанныеГруппы;	

	ЗаполнитьРебенка = Истина;
	ЗаполнитьДоговорПоОсновнойГруппе = Истина;
	ЗаполнитьДоговорПоНазначению = Истина;
	
	ДатаАктуальности = НачалоДня(ТекущаяДатаСеанса());
	ВосстановитьНастройкиЗаполнения();
	Если ЕстьДанныеГруппы Тогда
		ВосстановитьНастройкиСоответствияГрупп();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежа

&НаКлиенте
Процедура РасшифровкаПлатежаПослеУдаления(Элемент)
	Если Не Внешнее Тогда
		ОбновитьСчетчикСтрокПослеУдаления();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)

	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	ДанныеТекущейСтроки = Новый Структура(ИменаКолонокРасшифровки());

	Если Копирование Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные = Неопределено И Внешнее Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные <> Неопределено И (Внешнее Или Не ПоРеестру) Тогда
		ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;

	Если НоваяСтрока И Не Копирование Тогда
		
		Если Внешнее Или Не ПоРеестру Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеТекущейСтроки);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
			ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			СчетчикСтрокиРасшифровки = СчетчикСтрокиРасшифровки + 1;
			ТекущиеДанные.НомерСтрокиРасшифровки = СчетчикСтрокиРасшифровки;
		КонецЕсли;
		
		Если Не ПоРеестру Тогда
			ТекущиеДанные.Контрагент = Контрагент;
		КонецЕсли;
		
		ТекущиеДанные.ДетализацияКодЦели = ТекущиеДанные.КодЦели;
		ТекущиеДанные.СпособПогашенияЗадолженности =
			ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");  
		ТекущиеДанные.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(
			КодПоступленияЕБП(ТекущиеДанные.РазделЛС));
		
	КонецЕсли;
	
	Если Копирование И Не Внешнее И ПоРеестру Тогда
		ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		СчетчикСтрокиРасшифровки = СчетчикСтрокиРасшифровки + 1;
		ТекущиеДанные.НомерСтрокиРасшифровки = СчетчикСтрокиРасшифровки;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаРазделЛСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ОбработатьИзменениеВСтрокеРасшифровки("РазделЛС", ТекущиеДанные.РазделЛС,
		ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
	
	КэшДопустимыеКоды = Новый Соответствие;
	УстановитьКФО = Не ЗначениеЗаполнено(ТекущиеДанные.КФО)
		Или Не КФОСоответствуетРазделуЛС(ТекущиеДанные.КФО, ТекущиеДанные.РазделЛС, ДатаДокумента, КэшДопустимыеКоды);
	
	Если УстановитьКФО Тогда
		КодПоступленияЕБП = КодПоступленияЕБП(ТекущиеДанные.РазделЛС);
		ТекущиеДанные.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступленияЕБП);
		ОбработатьИзменениеВСтрокеРасшифровки("КФО", ТекущиеДанные.КФО,
			ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКБКНазначениеПлатежаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	ОбработатьИзменениеВСтрокеРасшифровки("КБКНазначениеПлатежа", ТекущиеДанные.КБКНазначениеПлатежа,
		ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
	Если Не Внешнее Тогда
		ТекущиеДанные.ДетализацияКБКНазначениеПлатежа = ТекущиеДанные.КБКНазначениеПлатежа;
		ОбработатьИзменениеВСтрокеРасшифровки("ДетализацияКБКНазначениеПлатежа", ТекущиеДанные.КБКНазначениеПлатежа,
			ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОтборКБК = Новый Структура;
	ОтборКБК.Вставить("НаДату", ДатаДокумента);
	ОтборКБК.Вставить("Организация", Организация);
    ОтборКБК.Вставить("ИФО", ИФО);
	ПараметрыКБК = Новый Структура("Отбор", ОтборКБК);
	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыКБК, Элемент);
	 
КонецПроцедуры

