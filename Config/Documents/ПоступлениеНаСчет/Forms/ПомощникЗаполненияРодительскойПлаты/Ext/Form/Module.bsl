КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКФОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Элемент.СписокВыбора.Очистить();
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	СоотвествиеКодов = ПлатежноРасчетныеДокументыКлиентСервер.СоответствиеКФОКодамПоступленийЕБП(ДатаДокумента);
	КодПоступленияЕБП = КодПоступленияЕБП(ТекущиеДанные.РазделЛС);
	Для Каждого КлючИЗначение Из СоотвествиеКодов Цикл 
		Если КлючИЗначение.Значение = КодПоступленияЕБП Тогда
			Элемент.СписокВыбора.Добавить(КлючИЗначение.Ключ);	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДетализацияКБКНазначениеПлатежаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если Не Внешнее Тогда
		ТекущиеДанные.КБКНазначениеПлатежа = ТекущиеДанные.ДетализацияКБКНазначениеПлатежа;
		ОбработатьИзменениеВСтрокеРасшифровки("КБКНазначениеПлатежа", ТекущиеДанные.КБКНазначениеПлатежа,
			ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
		ОбработатьИзменениеВСтрокеРасшифровки("ДетализацияКБКНазначениеПлатежа", ТекущиеДанные.КБКНазначениеПлатежа,
			ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДетализацияКБКНазначениеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	Если Внешнее Тогда
		ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
		КэшРеквизитыКПС = Новый Соответствие;
		Если Не КПСДетализацииСоответствуетКБКРасшифровки(ВыбранноеЗначение,
			ТекущиеДанные.КБКНазначениеПлатежа, КэшРеквизитыКПС) Тогда
				СтандартнаяОбработка = Ложь;
				ТекстСообщения = СтрШаблон(НСтр(
					"ru='Выбранный КПС ""%1"" не соответствует КБК платежа ""%2""'"),
					ВыбранноеЗначение, ТекущиеДанные.КБКНазначениеПлатежа);
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДетализацияКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	СтандартнаяОбработка = Ложь;
	ОтборКБК = Новый Структура;
	ОтборКБК.Вставить("НаДату", ДатаДокумента);
	ОтборКБК.Вставить("Организация", Организация);
    ОтборКБК.Вставить("ИФО", ИФО);
	Если Внешнее Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ОтборКБК,
			ДополнительныйОтборКБК(ТекущиеДанные.КБКНазначениеПлатежа), Истина);   
	КонецЕсли;
	ПараметрыКБК = Новый Структура("Отбор", ОтборКБК);
	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыКБК, Элемент);
	 
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКОСГУНазначениеПлатежаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(КорСчет) Тогда
		
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("КОСГУНазначениеПлатежа", ТекущиеДанные.КОСГУНазначениеПлатежа);
		ДанныеСтроки.Вставить("СчетРасчетов", ТекущиеДанные.СчетРасчетов);
		ДанныеСтроки.Вставить("СпособПогашенияЗадолженности", ТекущиеДанные.СпособПогашенияЗадолженности);
		ДанныеСтроки.Вставить("ДопСубконтоРасчетов", ТекущиеДанные.ДопСубконтоРасчетов);
		ДанныеСтроки.Вставить("ДопСубконтоРасчетовВид", ТекущиеДанные.ДопСубконтоРасчетовВид);
		ДанныеСтроки.Вставить("ДопСубконтоРасчетовДоступность", ТекущиеДанные.ДопСубконтоРасчетовДоступность);
		ДанныеСтроки.Вставить("ДопСубконтоРасчетовНомер", ТекущиеДанные.ДопСубконтоРасчетовНомер);
		
		ДанныеОбъекта = Новый Структура;
		ДанныеОбъекта.Вставить("КорСчет", КорСчет);
		ДанныеОбъекта.Вставить("Дата", ДатаДокумента);
		ДанныеОбъекта.Вставить("Организация", Организация);
		ДанныеОбъекта.Вставить("ИФО", ИФО);
		
		ДанныеСтрокиПриИзмененииКОСГУНазначениеПлатежа = ДанныеСтрокиПриИзмененииКОСГУНазначениеПлатежа(ДанныеСтроки,
			ДанныеОбъекта);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСтрокиПриИзмененииКОСГУНазначениеПлатежа);
		
	КонецЕсли;
	 
    УстановитьДопСубконтоРасчетов(ТекущиеДанные, "КодЦели");
    УстановитьДопСубконтоРасчетов(ТекущиеДанные, "КодМероприятия");
	УстановитьДопСубконтоРасчетов(ТекущиеДанные, "ДопКлассификация");
	
КонецПроцедуры

