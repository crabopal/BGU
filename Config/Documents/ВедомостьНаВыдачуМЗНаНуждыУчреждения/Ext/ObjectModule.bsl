#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		
		ЗаполнитьПоПоступлению(ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
			
		ЗаполнитьПоТребованиюНакладной(ДанныеЗаполнения, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = Неопределено;
	НеПересчитыватьСумму = Ложь;
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	
	Для каждого Строка Из МатериальныеЗапасы Цикл
		
		Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
			ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
			ПараметрыОбработки.Счет         = Строка.СчетУчета;
			
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
		КонецЕсли;
	
	КонецЦикла;
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ОчиститьДопСубконто = УправлениеМатериальнымиЗапасами.ПараметрыПроверкиЗаполненияДопСубконто(ОтразитьНаСчете27, Дата, Организация);
	УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(МатериальныеЗапасы, СтруктураДействий);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ПроверитьОчиститьКПС = Истина;
	Если Не КФОВТабличнойЧасти Тогда
		СтруктураДействий.ОчиститьКФО = Истина;
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(МатериальныеЗапасы, СтруктураДействий);
	УправлениеМатериальнымиЗапасами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "МатериальныеЗапасы", "Материальные запасы", Отказ);
	
	НепроверяемыеРеквизиты = Новый Массив;
	Если КФОВТабличнойЧасти Тогда
		НепроверяемыеРеквизиты.Добавить("КФО");
	Иначе
		НепроверяемыеРеквизиты.Добавить("МатериальныеЗапасы.КФО");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);

	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоПоступлению(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |ГДЕ
	               |	ЖурналПроводокЕПСБУ.Регистратор = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЖурналПроводокЕПСБУ.КФО КАК КФО
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |ГДЕ
	               |	ЖурналПроводокЕПСБУ.Регистратор = &ДокументОснование
	               |	И ЖурналПроводокЕПСБУ.СчетДт В (&Счет105)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗ.Ссылка КАК ДокументОснование,
	               |	ПоступлениеМЗ.Организация КАК Организация,
	               |	ПоступлениеМЗ.ИФО КАК ИФО,
	               |	ПоступлениеМЗ.Подразделение КАК Подразделение,
	               |	ПоступлениеМЗ.ЦМО КАК ЦМО
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |ГДЕ
	               |	ПоступлениеМЗ.Ссылка = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	               |	ПоступлениеМЗМатериалы.Количество КАК Количество,
	               |	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	               |	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	               |	ПоступлениеМЗМатериалы.КПС КАК КПС,
	               |	ПоступлениеМЗМатериалы.КФО КАК КФО
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	               |ГДЕ
	               |	ПоступлениеМЗМатериалы.Ссылка = &ДокументОснование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПоступлениеМЗМатериалы.НомерСтроки";
	Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СписокСчетов("105.00"));
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ЕстьПроводкиПоДокументу = НЕ РезультатЗапроса[0].Пустой();
	ПроводкиПо105 = РезультатЗапроса[1].Выгрузить();
	
	Если ЕстьПроводкиПоДокументу И ПроводкиПо105.Количество() = 0 Тогда
		ТекстИсключения = НСтр("ru = 'Документом %1 не оформляется поступление МЗ на счет 105.00'");
		ТекстОшибки = НСтр("ru = 'Документом %1 не оформляется поступление МЗ на счет 105.00.
								|Ведомость на выдачу МЗ на нужды учреждения оформляется только для материалов, учитываемых на субсчетах группы 105.00'");
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ДанныеЗаполнения), ДанныеЗаполнения);
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИсключения, ДанныеЗаполнения);
	КонецЕсли;
	
	ДанныеШапки = РезультатЗапроса[2].Выбрать();
	ДанныеШапки.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеШапки);
	
	МатериальныеЗапасы.Загрузить(РезультатЗапроса[3].Выгрузить());
	
	КФОВТабличнойЧасти = Ложь;
	Если МатериальныеЗапасы.Количество() > 0 Тогда
		ТекКФО = МатериальныеЗапасы[0].КФО;
		Для Индекс = 1 По МатериальныеЗапасы.Количество() - 1 Цикл
			Если ТекКФО <> МатериальныеЗапасы[Индекс].КФО Тогда
				КФОВТабличнойЧасти = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не КФОВТабличнойЧасти Тогда
			КФО = ТекКФО;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоТребованиюНакладной(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТребованиеНакладная0315006.Организация,
	|	ТребованиеНакладная0315006.ИФО,
	|	ТребованиеНакладная0315006.ПодразделениеПолучатель КАК Подразделение,
	|	ТребованиеНакладная0315006.ЦМОПолучатель КАК ЦМО,
	|	ТребованиеНакладная0315006.Ссылка КАК ДокументОснование,
	|	ТребованиеНакладная0315006.НоменклатураЛома,
	|	ТребованиеНакладная0315006.АналитикаОперацииСДрагМатериалами
	|ИЗ
	|	Документ.ТребованиеНакладная0315006 КАК ТребованиеНакладная0315006
	|ГДЕ
	|	ТребованиеНакладная0315006.Ссылка = &ТребованиеНакладная
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТребованиеНакладная0315006Материалы.Номенклатура,
	|	ТребованиеНакладная0315006Материалы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТребованиеНакладная0315006Материалы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ТребованиеНакладная0315006Материалы.КоличествоЗатребовано,
	|	ТребованиеНакладная0315006Материалы.Количество,
	|	ТребованиеНакладная0315006Материалы.СчетУчета,
	|	ТребованиеНакладная0315006Материалы.ДополнительнаяАналитикаСчета,
	|	ТребованиеНакладная0315006Материалы.КПС,
	|	ТребованиеНакладная0315006Материалы.КФО,
	|	ТребованиеНакладная0315006Материалы.КоличествоВсегоДМ
	|ИЗ
	|	Документ.ТребованиеНакладная0315006.Материалы КАК ТребованиеНакладная0315006Материалы
	|ГДЕ
	|	ТребованиеНакладная0315006Материалы.Ссылка = &ТребованиеНакладная
	|УПОРЯДОЧИТЬ ПО
	|	ТребованиеНакладная0315006Материалы.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ОбъектНФА,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ВидДрагМатериала,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.МассаДМ,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ЛигатурнаяМасса,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ЧистаяМасса,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ЕдИзм,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.КоличествоДМ,
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.ИсточникОбразования
	|ИЗ
	|	Документ.ТребованиеНакладная0315006.ДрагоценныеМатериалы КАК ТребованиеНакладная0315006ДрагоценныеМатериалы
	|ГДЕ
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.Ссылка = &ТребованиеНакладная
	|УПОРЯДОЧИТЬ ПО
	|	ТребованиеНакладная0315006ДрагоценныеМатериалы.НомерСтроки";
	Запрос.УстановитьПараметр("ТребованиеНакладная", ДанныеЗаполнения);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаДокумента = РезультатЗапроса[0].Выбрать();
	Если ТаблицаДокумента.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ТаблицаДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаОпределенияКЭК = Дата;
	Иначе
		ДатаОпределенияКЭК = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ИспользуемыеКФО = Новый Соответствие;
	МатериальныеЗапасы.Очистить();
	ВыборкаМатериалы = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрока = МатериальныеЗапасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы);
		НоваяСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Организация, ИФО, ВыборкаМатериалы.КФО, ДатаОпределенияКЭК,
			НоваяСтрока.СчетУчета, ВыборкаМатериалы.ТипНоменклатуры, "Кт");
		ИспользуемыеКФО.Вставить(ВыборкаМатериалы.КФО);
	КонецЦикла;
	
	Если ИспользуемыеКФО.Количество() = 1 Тогда
		Для Каждого ИспользуемыйКФО Из ИспользуемыеКФО Цикл
			КФО = ИспользуемыйКФО.Ключ;
		КонецЦикла;
	КонецЕсли;
	
	ДрагоценныеМатериалы.Очистить();
	ВыборкаДМ = РезультатЗапроса[2].Выбрать();
	Пока ВыборкаДМ.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДрагоценныеМатериалы.Добавить(), ВыборкаДМ);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = МатериальныеЗапасы.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ДрагМатериалыДокумента.ОбъектНФА,
	               |	ДрагМатериалыДокумента.МассаДМ,
	               |	ДрагМатериалыДокумента.ЛигатурнаяМасса,
	               |	ДрагМатериалыДокумента.ЧистаяМасса,
	               |	ДрагМатериалыДокумента.КоличествоДМ
	               |ПОМЕСТИТЬ ДрагМатериалыДокумента
	               |ИЗ
	               |	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ОбъектыДокумента.Номенклатура
	               |ПОМЕСТИТЬ ОбъектыДокумента
	               |ИЗ
	               |	&ОбъектыДокумента КАК ОбъектыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОбъектыНФАДокумента.Организация,
	               |	ОбъектыНФАДокумента.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЛигатурнаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЧистаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьДрагМатериалы
	               |ПОМЕСТИТЬ ОбъектыНФАДокумента
	               |ИЗ
	               |	ОбъектыДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
	               |			И ОбъектыНФАДокумента.Номенклатура = ДрагМатериалыДокумента.ОбъектНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	               |	0 КАК ЧистаяМассаОстаток,
	               |	0 КАК ЛигатурнаяМассаОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	               |		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток,
	               |	0,
	               |	0,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
	               |		ПО (НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВЛомеИОтходахОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
				   
	ТаблицаОбъектовНФА = МатериальныеЗапасы.Выгрузить(,"Номенклатура");
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" из списка ""Материальные запасы"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"", если это списание МЦ и провести документ.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ОбъектНФА);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли