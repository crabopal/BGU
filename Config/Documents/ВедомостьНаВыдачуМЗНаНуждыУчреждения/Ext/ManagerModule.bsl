// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	
	// Реквизит "НеПересчитыватьСумму" устанавливается только при загрузке данных
	НеРедактируемыеРеквизиты.Добавить("НеПересчитыватьСумму");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы:
// * Материалы - Массив из Строка - имена элементов
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("ЕдиницаИзмерения");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("МатериальныеЗапасы", ИменаРеквизитов);
	ИменаСкрываемыхКнопок = Новый Массив;
	ИменаСкрываемыхКнопок.Добавить("МатериальныеЗапасыЗаполнитьКПСНоменклатура");
	Результат.Вставить("ИменаСкрываемыхКнопок", ИменаСкрываемыхКнопок);
	Возврат Результат;
КонецФункции

// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.АктСписанияМЗ
//  Параметры - Структура
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	Параметры.Вставить("НеПроверятьЗаполнение", Истина);
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	
	ИмяСписка = "МатериальныеЗапасы";
	СинонимСписка = Документ.Метаданные().ТабличныеЧасти.МатериальныеЗапасы.Синоним;
	
	Для Каждого СтрокаДокумента Из Документ.МатериальныеЗапасы Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ИмяСписка = ИмяСписка;
		НоваяСтрока.СинонимСписка = СинонимСписка;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
			"НомерСтроки, КПС, КЭК, СчетУчета, Номенклатура, Количество, СуммаСписания, СуммаСписанияНУ");
		НоваяСтрока.ДопАналитика = СтрокаДокумента.ДополнительнаяАналитикаСчета;
		НоваяСтрока.ДопИзмерение = Документ.ЦМО;
		НоваяСтрока.ДопИзмерениеПолучатель = СтрокаДокумента.ЦМОПолучатель;
		НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ,
			"ИФО, НеПересчитыватьСумму");
		НоваяСтрока.Подразделение = Документ.Подразделение;
		НоваяСтрока.ПодразделениеПолучатель = СтрокаДокумента.ПодразделениеПолучатель;
		
		Если Документ.КФОВТабличнойЧасти Тогда
			НоваяСтрока.КФО = СтрокаДокумента.КФО;
		Иначе
			НоваяСтрока.КФО = Документ.КФО;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДокумента;

КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти


#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", НСтр("ru = 'Ведомость на выдачу МЦ на нужды учреждения'"));
	
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Организация,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ВидДрагМатериала,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ЕдИзм,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.ДрагоценныеМатериалы КАК ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы
	 |ГДЕ
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	 "ВЫБРАТЬ
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.МассаДМ КАК ЧистаяМасса,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	 |ИЗ
	 |	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.ДрагоценныеМатериалы КАК ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы
	 |ГДЕ
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.МассаДМ > 0
	 |	И НЕ ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.НоменклатураЛома = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	 |
	 |ОБЪЕДИНИТЬ ВСЕ
	 |
	 |ВЫБРАТЬ
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка.Дата,
	 |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияДрагоценныеМатериалы.Ссылка,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
