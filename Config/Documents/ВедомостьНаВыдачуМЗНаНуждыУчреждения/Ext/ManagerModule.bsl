// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения";
	КомандаПечати.Идентификатор		= "ВедомостьНаВыдачуМЗ_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ведомость выдачи МЦ на нужды учреждения'"), "0504210", "52н", "103н");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения";
	КомандаПечати.Идентификатор		= "ВедомостьНаВыдачуМЗ_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ведомость выдачи МЦ на нужды учреждения'"), "0504210", "52н");
	КомандаПечати.Порядок			= 2;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения";
	КомандаПечати.Идентификатор		= "ВедомостьНаВыдачуМЗ";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Ведомость выдачи МЦ на нужды учреждения (ф. 0504210)'");
	КомандаПечати.Порядок			= 150;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения", 4);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуМЗ_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ВедомостьНаВыдачуМЗ_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ведомость выдачи МЦ на нужды учреждения'"), "0504210", "52н", "103н"),
			ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуМЗ_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ВедомостьНаВыдачуМЗ_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ведомость выдачи МЦ на нужды учреждения'"), "0504210", "52н"),
			ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_52н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуМЗ") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ВедомостьНаВыдачуМЗ", "Ведомость выдачи МЦ",
			ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериаловДляВнутреннегоПеремещения(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения","Справка о содержании драг. материалов", ТабличныйДокумент);
	
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ДвиженияССубконто.Регистратор КАК Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения) КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|		КОГДА ДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|		КОГДА ДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|	КОНЕЦ КАК Номенклатура,
	|	ДвиженияССубконто.КоличествоКт КАК Количество,
	|	ДвиженияССубконто.Сумма,
	|	ДвиженияССубконто.СчетДт,
	|	ДвиженияССубконто.КПСДт,
	|	ДвиженияССубконто.КЭКДт,
	|	ДвиженияССубконто.СчетКт,
	|	ДвиженияССубконто.КПСКт,
	|	ДвиженияССубконто.КЭККт,
	|	ДвиженияССубконто.КФО
	|ПОМЕСТИТЬ Движения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор ССЫЛКА Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения
	|				И Регистратор В (&МассивОбъектов)
	|				И СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский),
	|			,
	|			) КАК ДвиженияССубконто
	|ГДЕ
	|	(ДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ИЛИ ДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ИЛИ ДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ИЛИ ДвиженияССубконто.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))";
	Запрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаДокумента.Ссылка,
	|	ШапкаДокумента.Дата КАК Дата,
	|	ШапкаДокумента.Номер КАК Номер,
	|	ШапкаДокумента.Организация,
	|	ШапкаДокумента.Организация.НаименованиеПолное КАК ОрганизацияНаименование,
	|	ШапкаДокумента.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	|	ШапкаДокумента.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	ШапкаДокумента.ЦМО.Сотрудник КАК МОЛ,
	|	ШапкаДокумента.Подразделение,
	|	ШапкаДокумента.ОтветственныйИсполнитель,
	|	ШапкаДокумента.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения КАК ШапкаДокумента
	|ГДЕ
	|	ШапкаДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетДт) КАК СчетДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСДт) КАК КПСДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭКДт) КАК КЭКДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетКт) КАК СчетКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСКт) КАК КПСКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭККт) КАК КЭККтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КФО) КАК КФОПредставление,
	|	Движения.СчетДт.Порядок,
	|	Движения.СчетКт.Порядок
	|ИЗ
	|	Движения КАК Движения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Движения.СчетДт.Порядок,
	|	Движения.СчетКт.Порядок
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	МИНИМУМ(ТЧДокумента.НомерСтроки) КАК НомерСтроки,
	|	ТЧДокумента.ЦМОПолучатель,
	|	ВЫБОР
	|		КОГДА ТЧДокумента.ЦМОПолучатель ССЫЛКА Справочник.ЦМО
	|			ТОГДА ТЧДокумента.ЦМОПолучатель.Сотрудник
	|		ИНАЧЕ ТЧДокумента.ЦМОПолучатель
	|	КОНЕЦ КАК Сотрудник
	|ИЗ
	|	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК ТЧДокумента
	|ГДЕ
	|	ТЧДокумента.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧДокумента.Ссылка,
	|	ТЧДокумента.ЦМОПолучатель,
	|	ВЫБОР
	|		КОГДА ТЧДокумента.ЦМОПолучатель ССЫЛКА Справочник.ЦМО
	|			ТОГДА ТЧДокумента.ЦМОПолучатель.Сотрудник
	|		ИНАЧЕ ТЧДокумента.ЦМОПолучатель
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура,
	|	Т.НомерСтроки,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.НаименованиеПолное = """"
	|			ТОГДА СправочникНоменклатура.Наименование
	|		ИНАЧЕ СправочникНоменклатура.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМатериал,
	|	СправочникНоменклатура.Код КАК КодМатериал,
	|	СправочникНоменклатура.ЕдиницаИзмерения.Наименование КАК НаименованиеЕдИзм,
	|	СправочникНоменклатура.ЕдиницаИзмерения.Код КАК КодЕдИзм
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТЧДокумента.Ссылка КАК Ссылка,
	|		ТЧДокумента.Номенклатура КАК Номенклатура,
	|		МИНИМУМ(ТЧДокумента.НомерСтроки) КАК НомерСтроки
	|	ИЗ
	|		Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК ТЧДокумента
	|	ГДЕ
	|		ТЧДокумента.Ссылка В(&МассивОбъектов)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТЧДокумента.Ссылка,
	|		ТЧДокумента.Номенклатура) КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Ссылка,
	|	Т.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	ТЧДокумента.НомерСтроки,
	|	ТЧДокумента.Номенклатура,
	|	ТЧДокумента.ЦМОПолучатель,
	|	ТЧДокумента.Количество
	|ИЗ
	|	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК ТЧДокумента
	|ГДЕ
	|	ТЧДокумента.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Движения.Регистратор КАК Ссылка,
	|	Движения.Номенклатура,
	|	СУММА(Движения.Количество) КАК Количество,
	|	СУММА(Движения.Сумма) КАК Сумма,
	|	ВЫБОР
	|		КОГДА СУММА(Движения.Количество) <> 0
	|			ТОГДА ВЫРАЗИТЬ(СУММА(Движения.Сумма) / СУММА(Движения.Количество) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Движения КАК Движения
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Регистратор,
	|	Движения.Номенклатура";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат УправлениеПечатьюБГУ.ПечатьВедомостиВыдачиНФА_0504210(РезультатЗапроса, ОбъектыПечати, ИмяМакета);
	
КонецФункции

#КонецОбласти

#КонецЕсли
