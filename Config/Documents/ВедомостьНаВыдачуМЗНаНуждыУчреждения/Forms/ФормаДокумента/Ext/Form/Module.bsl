&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект, Объект,
		"МатериальныеЗапасы");
	УстановитьОграничениеТипаРеквизитаЦМОПолучатель(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьВидимостьЭлементовЗагруженногоДокумента(ЭтотОбъект,
		"МатериальныеЗапасы");
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	
	ПериодСчета = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетУчетаИмуществаВПользовании", БухгалтерскийУчет.СчетПоКоду("27.02", ПериодСчета, Объект.Организация));
	УправлениеМатериальнымиЗапасами.УстановитьВидДопСубконтоЛичногоПользования(
	ЭтотОбъект,
	Объект.ОтразитьНаСчете27,
	ЭтотОбъект.КэшПараметров.Локальные.СчетУчетаИмуществаВПользовании,
	"МатериальныеЗапасыДополнительноеСубконтоСчета",
	"МатериальныеЗапасы");
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	УстановитьТекстДобавленныхКолонок();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	УстановитьДоступностьКФО(ЭтотОбъект);
	// Старые значения (до изменения) запомним в кэше в локальных параметрах.
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДокументОснование", Объект.ДокументОснование);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗначениядляЗаполнения(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.МатериальныеЗапасы.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Выделена всего одна строка.
			|Есть возможность установить выбранное значение во все строки документа.'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Установить только в выделенную строку'"));
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Установить во все строки документа'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВопросаУстановитьПоВсем", ЭтотОбъект,
			Новый Структура("ВыбранноеЗначение, ИмяКолонки", ВыбранноеЗначение, ДополнительныеПараметры.ИмяКолонки));
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки,,КодВозвратаДиалога.Да);
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьВыбранноеЗначениеВВыбранныеСтроки(ВыбранноеЗначение, ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаУстановитьПоВсем(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыОповещения = Новый Структура("ИмяКолонки", ДополнительныеПараметры.ИмяКолонки);
	ВыбранноеЗначение = ДополнительныеПараметры.ВыбранноеЗначение;
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		ПараметрыОповещения.Вставить("УстановитьПоВсем", Истина);
	КонецЕсли;
	
	УстановитьВыбранноеЗначениеВВыбранныеСтроки(ВыбранноеЗначение, ПараметрыОповещения);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыбранноеЗначениеВВыбранныеСтроки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Перем УстановитьПоВсем;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		ИмяКолонки = ДополнительныеПараметры.ИмяКолонки;
		
		ДополнительныеПараметры.Свойство("УстановитьПоВсем", УстановитьПоВсем);
		
		Если УстановитьПоВсем = Истина Тогда
			Для каждого ТекСтрока Из Объект.МатериальныеЗапасы Цикл
				ТекСтрока[ИмяКолонки] = ВыбранноеЗначение;
			КонецЦикла;
		Иначе
			Для каждого ВыделеннаяСтрока Из Элементы.МатериальныеЗапасы.ВыделенныеСтроки Цикл
				ТекСтрока = Объект.МатериальныеЗапасы.НайтиПоИдентификатору(ВыделеннаяСтрока);
				ТекСтрока[ИмяКолонки] = ВыбранноеЗначение;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()

	СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("105.00", Объект.Дата, Объект.Организация);
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",				СчетУчета);	
	ПараметрыПодбора.Вставить("КФО",					Объект.КФО);
	ПараметрыПодбора.Вставить("ЦМО", 					Объект.ЦМО);
	ПараметрыПодбора.Вставить("Подразделение",			Объект.Подразделение);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"МатериальныеЗапасы");
	ПараметрыПодбора.Вставить("ПредставлениеТаблицы",	"Материальные запасы");
	
	ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер.ДополнительнаяАналитикаСчетаУчетаМатериалов(СчетУчета, Объект.Организация);
	Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
		ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
	КонецЕсли;
	Возврат ПараметрыПодбора;

КонецФункции

