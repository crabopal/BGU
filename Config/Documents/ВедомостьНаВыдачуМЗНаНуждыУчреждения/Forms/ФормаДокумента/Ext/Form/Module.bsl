&НаКлиенте
Процедура МатериальныеЗапасыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.МатериальныеЗапасы.ТекущийЭлемент.Имя = "МатериальныеЗапасыНормаСотрудника" Тогда
		УправлениеНФАКлиент.ОткрытьОбеспечениеСотрудникаИмуществом(Элементы.МатериальныеЗапасы.ТекущиеДанные.ЦМОПолучатель);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеЗапасыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если ОбщегоНазначенияБГУКлиентСервер.ЗапрещеноДобавлениеСтрокВДокументыНФА(ЭтотОбъект) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения=НСтр("ru='Перед заполнением табличной части необходимо выбрать организацию'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.Организация",,Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеЗапасыПередУдалением(Элемент, Отказ)
	ОбъектНаУдаление = Элементы.МатериальныеЗапасы.ТекущиеДанные.Номенклатура;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА (%1) на закладке ""Драгоценные материалы""?'"),
			СокрЛП(ОбъектНаУдаление));
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеЗапасыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекНомерСтроки = Объект.МатериальныеЗапасы.Количество();
		ТекущиеДанные = Элементы.МатериальныеЗапасы.ТекущиеДанные;
		Если ТекНомерСтроки>1 Тогда
			ПредыдущаяСтрока = Объект.МатериальныеЗапасы[ТекНомерСтроки-2];
			ТекущиеДанные.ЦМОПолучатель = ПредыдущаяСтрока.ЦМОПолучатель;
			ТекущиеДанные.ПодразделениеПолучатель = ПредыдущаяСтрока.ЦМОПолучатель;
		КонецЕсли;
		УстановитьТекстКолонкиНорма(ТекущиеДанные);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Элементы.МатериальныеЗапасыПодразделениеПолучатель.Доступность = ЗначениеЗаполнено(Объект.Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеЗапасыНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.МатериальныеЗапасы.ТекущиеДанные;
	ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата, Объект.Организация);
	ТекущиеДанные.ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, Истина);
КонецПроцедуры

