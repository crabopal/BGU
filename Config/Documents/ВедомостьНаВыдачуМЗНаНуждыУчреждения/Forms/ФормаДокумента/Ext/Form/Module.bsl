	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораЗначениядляЗаполнения", ЭтотОбъект,
		Новый Структура("ИмяКолонки", "ПодразделениеПолучатель"));
	
	ПараметрыВыбораЗначения = Новый Структура;
	ОтборВыбора = Новый Структура;
	ОтборВыбора.Вставить("Владелец", Объект.Организация);
	ПараметрыВыбораЗначения.Вставить("Отбор", ОтборВыбора);
	ПараметрыВыбораЗначения.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбораЗначения.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.Подразделения.ФормаВыбора", ПараметрыВыбораЗначения, ЭтотОбъект,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
