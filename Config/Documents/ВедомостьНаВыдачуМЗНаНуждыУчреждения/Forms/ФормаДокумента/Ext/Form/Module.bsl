#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	ПараметрыПодбора = УправлениеМатериальнымиЗапасамиФормыКлиент.ПараметрыОткрытияПодбора();
	ПроверяемыеРеквизиты = Новый Массив;
	ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'Организация'"));
	ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'ЦМО, МОЛ/Место хранения'"));
	Если Не Объект.КФОВТабличнойЧасти Тогда
		ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'КФО'"));
	КонецЕсли;
	ПараметрыПодбора.ПроверяемыеРеквизиты = СтрСоединить(ПроверяемыеРеквизиты, ";");
	ПараметрыПодбора.ПараметрыОтбора = ДополнитьСтруктуруПодбора();
	Если Объект.МатериальныеЗапасы.Количество() Тогда
		ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора);
	КонецЕсли;
	УправлениеМатериальнымиЗапасамиФормыКлиент.ОткрытьПодборМатериалов(ЭтотОбъект, Объект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦМО(Команда)
	ВыделенныеСтроки = Элементы.МатериальныеЗапасы.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораЗначениядляЗаполнения", ЭтотОбъект,
		Новый Структура("ИмяКолонки", "ЦМОПолучатель"));
	
	ПараметрыВыбораЗначения = Новый Структура;
	ОтборВыбора = Новый Структура;
	ОтборВыбора.Вставить("Владелец", Объект.Организация);
	ПараметрыВыбораЗначения.Вставить("Отбор", ОтборВыбора);
	ПараметрыВыбораЗначения.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбораЗначения.Вставить("РежимВыбора", Истина);
	
	Если Объект.ОтразитьНаСчете27 Тогда
		ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыВыбораЗначения, ЭтотОбъект,,,,
			ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Справочник.ЦМО.ФормаВыбора", ПараметрыВыбораЗначения, ЭтотОбъект,,,,
			ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

