&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(ТекНоменклатура, ТекДата, ТекОрганизация)
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура, "ЕдиницаИзмерения, СчетУчета");
	Если ЗначениеЗаполнено(СтруктураДанных.СчетУчета) Тогда
		СтруктураДанных.СчетУчета = БухгалтерскийУчет.СчетПоКоду(СтруктураДанных.СчетУчета, ТекДата, ТекОрганизация);
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект.МатериальныеЗапасы.Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				УстановитьТекстКолонкиНорма(СтрокаМатериалы);
				ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаМатериалы, Ложь);
				ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(СтрокаМатериалы.Номенклатура, Объект.Дата, Объект.Организация);
				СтрокаМатериалы.ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЦикла;
		
		Объект.МатериальныеЗапасы.Загрузить(ВтМатериалы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	Если ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
		Строка.ДополнительноеСубконтоВидСубконто = Форма.ДополнительноеСубконто27ВидСубконто;
	КонецЕсли;

КонецПроцедуры


