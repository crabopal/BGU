// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик выбора строки постоянно действующией комиссии. см.ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии.
// "Объект" передается явно, без этого данные объекта не заполняются в web-клиенте.
&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект)	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПоБУЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КомандаЗаполнитьПоБУФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПоБУФрагмент()
	
	ЗаполнитьТаблицуИнвентаризацияПоБУ();
	
	Если Объект.Инвентаризация.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Нет данных для заполнения инвентаризации'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИнвентаризацияПоУчетуИНВ9(МассивЦМО, МассивДрагМатериалов, ТолькоПересчитать = Ложь)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство
			|ПОМЕСТИТЬ СписокОС
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовОС),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОбъектНФА,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ДанныеОСВсе
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И &ПодразделенияНет
			|				И ОсновноеСредство В
			|					(ВЫБРАТЬ
			|						СписокОС.ОсновноеСредство
			|					ИЗ
			|						СписокОС КАК СписокОС)) КАК СтоимостьОбъектовОСОстатки
			|ГДЕ
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток > 0
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В ИЕРАРХИИ(&МассивСчетовМЦ),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность),
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество,
			|	0 КАК ТипОбъектаНФА
			|ПОМЕСТИТЬ ДанныеМЗНеИК
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗНеИК), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0"
			+
			УчетДрагМатериалов.ДополнитьТекстЗапросаИнвентаризацияПоУчетуИНВИК()
			+
			"ВЫБРАТЬ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ВЫБОР
			|		КОГДА ДанныеОС.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|			ТОГДА ДанныеОС.Количество
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Количество,
			|	ВЫБОР
			|		КОГДА ДанныеОС.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(ДанныеОСВсе.Количество, 1) + ЕСТЬNULL(ДанныеМЗНеИК.Количество, 0)
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК КоличествоВсего
			|ПОМЕСТИТЬ ПолныеДанныеОС
			|ИЗ
			|	ДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОСВсе КАК ДанныеОСВсе
			|		ПО (ДанныеОСВсе.ОбъектНФА = ДанныеОС.ОбъектНФА)
			|			И (ДанныеОСВсе.ИнвентарныйНомер = ДанныеОС.ИнвентарныйНомер)
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеМЗНеИК КАК ДанныеМЗНеИК
			|		ПО ДанныеОС.ОбъектНФА = ДанныеМЗНеИК.ОбъектНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОС.Количество КАК Количество,
			|	ДанныеОС.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК ЧИСЛО(17, 8))) * (ВЫРАЗИТЬ(ДанныеОС.Количество КАК ЧИСЛО(17, 8))) / (ВЫРАЗИТЬ(ДанныеОС.КоличествоВсего КАК ЧИСЛО(17, 8))) КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК ЧИСЛО(17, 8))) * (ВЫРАЗИТЬ(ДанныеОС.Количество КАК ЧИСЛО(17, 8))) / (ВЫРАЗИТЬ(ДанныеОС.КоличествоВсего КАК ЧИСЛО(17, 8))) КАК ЧИСЛО(17, 8)) КАК КоличествоДМУчет,
			|	ВЫБОР
			|		КОГДА ДанныеОС.ОбъектНФА ССЫЛКА Справочник.Номенклатура
			|			ТОГДА ДанныеОС.ОбъектНФА.ЕдиницаИзмерения
			|		ИНАЧЕ &ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдиницаИзмеренияДрагМатериала
			|ПОМЕСТИТЬ ДанныеВУчетныхЕдиницах
			|ИЗ
			|	ПолныеДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ВидДрагМатериала В (&МассивДрагМатериалов)) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ДанныеОС.ОбъектНФА = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И ДанныеОС.ИнвентарныйНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
			|ПОМЕСТИТЬ НастройкиЕдиницУчета
			|ИЗ
			|	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
			|ГДЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения = &Караты
			|	И НастройкиЕдиницИзмеренияДрагМатериалов.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеВУчетныхЕдиницах.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеВУчетныхЕдиницах.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеВУчетныхЕдиницах.Количество КАК Количество,
			|	ДанныеВУчетныхЕдиницах.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(ДанныеВУчетныхЕдиницах.МассаДМУчет * ВЫБОР
			|			КОГДА НастройкиЕдиницУчета.Коэффициент ЕСТЬ NULL
			|				ТОГДА 1
			|			КОГДА НастройкиЕдиницУчета.Коэффициент = 0
			|				ТОГДА 1
			|			ИНАЧЕ НастройкиЕдиницУчета.Коэффициент
			|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ДанныеВУчетныхЕдиницах.КоличествоДМУчет КАК КоличествоДМУчет,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала,
			|	ДанныеВУчетныхЕдиницах.КоличествоВсего КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеПоДМ
			|ИЗ
			|	ДанныеВУчетныхЕдиницах КАК ДанныеВУчетныхЕдиницах
			|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницУчета КАК НастройкиЕдиницУчета
			|		ПО ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала = НастройкиЕдиницУчета.УчетнаяЕдиницаИзмерения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеПоДМ.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеПоДМ.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СУММА(ДанныеПоДМ.Количество) КАК Количество,
			|	ДанныеПоДМ.ВидДрагМатериала КАК ВидДрагМатериала,
			|	СУММА(ДанныеПоДМ.МассаДМУчет) КАК МассаДМУчет,
			|	СУММА(ДанныеПоДМ.КоличествоДМУчет) КАК КоличествоДМУчет,
			|	ДанныеПоДМ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала,
			|	СУММА(ДанныеПоДМ.КоличествоВсего) КАК КоличествоВсего
			|ИЗ
			|	ДанныеПоДМ КАК ДанныеПоДМ
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеПоДМ.ОбъектНФА,
			|	ДанныеПоДМ.ИнвентарныйНомер,
			|	ДанныеПоДМ.ВидДрагМатериала,
			|	ДанныеПоДМ.ЕдиницаИзмерения,
			|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала";			
			
			
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗИК();
	МассивСчетовМЗНеИК = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	МассивСчетовМЦ = БухгалтерскийУчет.СписокСчетов("МЦК");
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	
	МассивСчетовКапвложенийИК = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийИК();
	
	МассивСубконтоКапвложений = Новый Массив;
	МассивСубконтоКапвложений.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Если ЗначениеЗаполнено(Объект.ЦМО) Тогда
		МассивСубконтоКапвложений.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПодразделенияНет", "Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",	Объект.Подразделение);
	Иначе
		Запрос.УстановитьПараметр("ПодразделенияНет",	Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЦМО) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтобратьКапвложенияПоЦМО", 
			"Субконто2 В (&МассивЦМО)");
		Запрос.УстановитьПараметр("МассивЦМО", МассивЦМО);
  	Иначе
		Запрос.УстановитьПараметр("ОтобратьКапвложенияПоЦМО", Истина);	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", 					ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(Объект.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация",				Объект.Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",			УчетДрагМатериалов.Штуки());
	Запрос.УстановитьПараметр("МассивСчетовОС",				МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСчетовМЗ",				МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСчетовМЗНеИК",			МассивСчетовМЗНеИК);
	Запрос.УстановитьПараметр("МассивСчетовМЦ",				МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоОС",			МассивСубконтоОС);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",			МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ",			МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСчетовКапвложенийИК",	МассивСчетовКапвложенийИК);
	Запрос.УстановитьПараметр("МассивСубконтоКапвложений",	МассивСубконтоКапвложений);
	Запрос.УстановитьПараметр("МассивДрагМатериалов",		МассивДрагМатериалов);
	Запрос.УстановитьПараметр("Караты",						УчетДрагМатериалов.Караты());
	
	РезультатЗапроса = Запрос.Выполнить();
	Объект.Инвентаризация.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуИнвентаризацияПоБУ(ТолькоПересчитать = Ложь)
	
	МассивЦМО = МассивЦМО();
	МассивДМ = МассивДМ();
	
	ЗаполнитьТаблицуИнвентаризацияПоУчетуИНВ9(МассивЦМО, МассивДМ, ТолькоПересчитать);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыИнвентаризация();
	
КонецПроцедуры // ЗаполнитьТаблицуИнвентаризацияПоБУ()

&НаСервере
Функция МассивЦМО()
	
	МассивЦМО = Новый Массив;
	Если ТипЗнч(Объект.ЦМО) = Тип("СправочникСсылка.Сотрудники") Тогда
		ЗапросМОЛ = Новый Запрос;
		ЗапросМОЛ.Текст = "ВЫБРАТЬ
		                  |	ЦМО.Ссылка
		                  |ИЗ
		                  |	Справочник.ЦМО КАК ЦМО
		                  |ГДЕ
		                  |	ЦМО.Сотрудник = &Сотрудник
		                  |	И ЦМО.ПометкаУдаления = ЛОЖЬ";
					
		ЗапросМОЛ.УстановитьПараметр("Сотрудник", Объект.ЦМО);
		РезультатЗапросаМОЛ = ЗапросМОЛ.Выполнить();
		Выборка = РезультатЗапросаМОЛ.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивЦМО.Добавить(Выборка.Ссылка);
		КонецЦикла;	
	ИначеЕсли ТипЗнч(Объект.ЦМО) = Тип("СправочникСсылка.ЦМО") Тогда	
		МассивЦМО.Добавить(Объект.ЦМО);
	КонецЕсли;	
	
	Возврат МассивЦМО;
КонецФункции	

&НаСервере
Функция МассивДМ()
	ТипДМ = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни;
	
	МассивДМ = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ОтборДрагоценныйМатериал) Тогда
		Если Объект.ОтборДрагоценныйМатериал.ЭтоГруппа Тогда
			МассивДМ = УчетДрагМатериалов.МассивДрагМатериалов(ТипДМ, Объект.ОтборДрагоценныйМатериал);
		Иначе	
			МассивДМ.Добавить(Объект.ОтборДрагоценныйМатериал);
		КонецЕсли;
	Иначе
		МассивДМ = УчетДрагМатериалов.МассивДрагМатериалов(ТипДМ);
	КонецЕсли;
	
	Возврат МассивДМ;	
КонецФункции	

&НаСервере
Процедура ПересчитатьФУпоБУ()

	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Для каждого ТекущиеДанные Из Объект.Инвентаризация Цикл
		ТекущиеДанные.МассаДМФакт = ТекущиеДанные.МассаДМУчет;
		ТекущиеДанные.КоличествоДМФакт = ТекущиеДанные.КоличествоДМУчет;
	КонецЦикла; 	

КонецПроцедуры // ПересчитатьФУпоБУ()

&НаКлиенте
Функция НельзяДобавитьВТЧИнвентаризация()

	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									НСтр("ru = 'Не заполнен обязательный реквизит ""Организация""'"),
									,
									"Объект.Организация",,Отказ);
	КонецЕсли;
	Возврат Отказ;							

КонецФункции // НельзяДобавитьВТЧИнвентаризация()

