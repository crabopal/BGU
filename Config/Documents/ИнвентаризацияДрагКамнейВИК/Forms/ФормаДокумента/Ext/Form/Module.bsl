&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	РазрешеноРедактированиеОбъекта = РазрешеноРедактированиеОбъекта(Объект)
									И ПравоДоступа("Изменение", Метаданные.Документы.ИнвентаризацияДрагМеталловВИК);

	МассивРеквизитовТолькоПросмотр = Новый Массив;
	МассивРеквизитовТолькоПросмотр.Добавить("Номер");
	МассивРеквизитовТолькоПросмотр.Добавить("Дата");
	МассивРеквизитовТолькоПросмотр.Добавить("Организация");
	МассивРеквизитовТолькоПросмотр.Добавить("Подразделение");
	МассивРеквизитовТолькоПросмотр.Добавить("ЦМО");
	МассивРеквизитовТолькоПросмотр.Добавить("НомерПриказа");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаПриказа");
	МассивРеквизитовТолькоПросмотр.Добавить("ДолжностьПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ФамилияПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ИмяПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ОтчествоПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("НомерПриказаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаПриказаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаНачала");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаОкончания");
	МассивРеквизитовТолькоПросмотр.Добавить("ПричинаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("МестоИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("Комментарий");
	
	МассивРеквизитовТолькоПросмотр.Добавить("СоставКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("Инвентаризация");
	
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(	Элементы, 
																		МассивРеквизитовТолькоПросмотр,
																		"ТолькоПросмотр",
																		НЕ РазрешеноРедактированиеОбъекта);
																		
КонецПроцедуры // УстановитьДоступностьЭлементов()

&НаКлиентеНаСервереБезКонтекста
Функция РазрешеноРедактированиеОбъекта(Объект)

	Если Объект.Проведен Тогда
		#Если НаКлиенте Тогда
		ТекстПредупреждения = НСтр("ru = 'Редактирование проведенного документа запрещено. 
										|Для изменения документа необходимо отменить проведение.'");
		ПоказатьПредупреждение(,ТекстПредупреждения, 15);
		#КонецЕсли
		Возврат Ложь;
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
		
	Возврат НЕ Объект.Проведен;

КонецФункции // РазрешеноРедактированиеОбъекта()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Элементы.ИнвентаризацияДрагКамниНФАКоличествоЗаголовок.Видимость = Истина;
	Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМУчет.Видимость = Истина;
	Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМФакт.Видимость = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоОбъектовНФАЗаголовок = НСтр("ru = 'Количество:'");
	ТекущаяСтрока.ЧистаяМассаЗаголовок = НСтр("ru = 'Масса (кар):'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Количество (шт):'");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыИнвентаризация()

	Для Каждого ТекущаяСтрока Из Объект.Инвентаризация Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока);
	КонецЦикла;
		
КонецПроцедуры

