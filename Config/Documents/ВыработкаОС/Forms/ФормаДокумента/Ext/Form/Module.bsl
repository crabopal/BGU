#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация"	, "Организация");
	СтруктураРеквизитов.Вставить("Дата"			, "Дата");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, "101.00");
	ПараметрыПодбора.Отбор.Вставить("СпособНачисленияАмортизации",
		ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));
		
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "ИФО,КФО,КПС,СчетУчета,Подразделение,ЦМО,Количество,Цена,Сумма");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодборНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство,ИнвентарныйНомер");	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(Знач ВыбранноеЗначение)

	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ПараметрыВыработки = ПолучитьПараметрыВыработкиОС(ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"), Объект.Дата);
		
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		
		Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер", СтрокаОС.ОсновноеСредство, СтрокаОС.ИнвентарныйНомер);
		СтрокиТаблицы = Объект.ОсновныеСредства.НайтиСтроки(Отбор);
		
		Если СтрокиТаблицы.Количество() = 0 Тогда
			НоваяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
			НоваяСтрока.ПараметрВыработки = ПараметрыВыработки[НоваяСтрока.ОсновноеСредство];
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнвентарныйНомер(ОсновноеСредство, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СобытияОССрезПоследних.ИнвНомер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство = &ОсновноеСредство
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ИнвНомер, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыВыработкиОС(ОсновноеСредство, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетАмортизации.ОсновноеСредство,
	|	РасчетАмортизации.ПараметрВыработки
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство В (&ОсновноеСредство)) КАК РасчетАмортизации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ОсновноеСредство, Выборка.ПараметрВыработки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполнитьОС(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьОСНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОСНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Объект.Дата);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение"	, Объект.Подразделение);
	Запрос.УстановитьПараметр("Счет"			, БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("101.00,102.00"));
	Запрос.УстановитьПараметр("СчетАм"			, БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("104.00"));  
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, Организация = &Организация) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|ГДЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И Подразделение = &Подразделение
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ КАК ВТ)) КАК ЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетАм),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И Подразделение = &Подразделение
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ_Стоимость КАК ВТ)) КАК ЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки
	|ПОМЕСТИТЬ ВТ_Расчет
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ВТ.ОсновноеСредство
	|				ИЗ
	|					ВТ_Стоимость КАК ВТ)) КАК РасчетАмортизацииОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыработкаОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	ВыработкаОСОбороты.ПараметрВыработки КАК ПараметрВыработки,
	|	ВыработкаОСОбороты.КоличествоОборот КАК Количество
	|ПОМЕСТИТЬ ВТ_Выработка
	|ИЗ
	|	РегистрНакопления.ВыработкаОС.Обороты(
	|			НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ),
	|			&Период,
	|			Месяц,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_Стоимость.ОсновноеСредство
	|					ИЗ
	|						ВТ_Стоимость КАК ВТ_Стоимость)) КАК ВыработкаОСОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ИнвНомер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_Стоимость.ОсновноеСредство
	|					ИЗ
	|						ВТ_Стоимость КАК ВТ_Стоимость)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия < НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Стоимость.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ИнвНомер.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Расчет.ПараметрВыработки КАК ПараметрВыработки,
	|	ВТ_Выработка.Количество КАК Количество
	|ИЗ
	|	ВТ_Стоимость КАК ВТ_Стоимость
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИнвНомер КАК ВТ_ИнвНомер
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_ИнвНомер.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_Амортизация.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Расчет КАК ВТ_Расчет
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_Расчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выработка КАК ВТ_Выработка
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_Выработка.ОсновноеСредство
	|			И (ВТ_Расчет.ПараметрВыработки = ВТ_Выработка.ПараметрВыработки)
	|ГДЕ
	|	ВТ_Стоимость.СуммаОстаток > ЕСТЬNULL(ВТ_Амортизация.СуммаОстаток, 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство";
	
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.ОсновныеСредства.Загрузить(Результат);	
	
КонецПроцедуры

