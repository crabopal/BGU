&НаКлиенте
Процедура ЗаполнитьОС(Команда)
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполнитьОС", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Таблица будет перезаполнена. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,); 
	Иначе	
		ЗаполнитьОСНаСервере();
	КонецЕсли;

КонецПроцедуры

