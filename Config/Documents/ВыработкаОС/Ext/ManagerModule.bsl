#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация,
	|	ОсновныеСредства.ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер,
	|	ОсновныеСредства.ПараметрВыработки,
	|	ОсновныеСредства.Количество
	|ИЗ
	|	Документ.ВыработкаОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка";

	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ВыработкаОС",
		Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

