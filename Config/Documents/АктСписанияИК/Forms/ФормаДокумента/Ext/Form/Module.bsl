КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаДокументаОснования()
	ТипыОснований = Объект.Ссылка.Метаданные().Реквизиты.ДокументОснование.Тип.Типы();
	
	ТипыОграничений = Новый Массив;
	Для Каждого ТипОснования Из ТипыОснований Цикл
		Если ТипОснования <> Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК") Тогда
			ТипыОграничений.Добавить(ТипОснования);				
		КонецЕсли;
	КонецЦикла;
	Элементы.ДокументОснование.ОграничениеТипа = Новый ОписаниеТипов(ТипыОграничений);
	Элементы.РешениеОПрекращенииПризнанияАктивом.ОграничениеТипа =
		Новый ОписаниеТипов("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК");
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЕстьРешениеОПрекращенииПризнанияАктивомПриИзмененииАсинх()
	ФлагИзменился = Ждать ЕстьСогласиеПользователяНаИзменениеФлагаЕстьРешение(); 
	Если Не ФлагИзменился Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		ОчиститьРеквизитыНедоступныеЕслиВыбраноРешение(Объект);
	Иначе
		Объект.ДокументОснование = Неопределено;
		ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(ЭтотОбъект);	
	КонецЕсли;
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Асинх Функция ЕстьСогласиеПользователяНаИзменениеФлагаЕстьРешение()
	
	ТекстВопроса = "";
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
	Иначе
		Если ЗначениеЗаполнено(Объект.ДокументОснование)
			И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК") Тогда
			ТекстВопроса = НСтр("ru = 'Будет очищен документ ""Решение""'");				
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстВопроса) Тогда
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Если Результат <> КодВозвратаДиалога.ОК Тогда
			Объект.ЕстьРешениеОПрекращенииПризнанияАктивом = Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПослеИзмененияДокументаОснования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоДокументуОснованию();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ПодготовитьФормуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияФлажкаАннулирован(Результат, ДополнительныеПараметры) Экспорт
	Если ЭтоАктСписания0510460 Тогда
		УправлениеЭлементамиГолосования();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПервичныйДокументПриИзмененииНаСервере()
	
	Если ЭтоАктСписания0510460 И Объект.Материалы.Количество() > 0 Тогда
		ПроверитьЗаполнениеИдентификатораСтроки();
	КонецЕсли;
	
	Если ЭтоАктСписания0510460 И Не ЗначениеЗаполнено(Объект.Комиссия) И Объект.СоставКомиссии.Количество() > 0 Тогда
		Объект.СоставКомиссии.Очистить();
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЭтоАктСписания0510460(Форма)
	Форма.ЭтоАктСписания0510460 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Форма.Объект.ПервичныйДокумент, "АктОСписанииМЗ0510460_157н");	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Знач Организация, Знач Подразделение, Знач Дата, Руководитель)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", Организация, Дата, Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		#Если НаКлиенте Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель"" на закладке ""Заключение комиссии""'"));			
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФлагОтразитьВМежотчетномПериодеПриИзмененииДаты()
	ВидМежотчетногоПериодаДоИзменения = Объект.ВидМежотчетногоПериода;
	БухгалтерскийУчетКлиент.ОчиститьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	Если Объект.ВидМежотчетногоПериода <> ВидМежотчетногоПериодаДоИзменения Тогда
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	ОчиститьФлагОтразитьВМежотчетномПериодеПриИзмененииДаты();

	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или (СчетУчета108(ЭтотОбъект) 
			И УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
				ЭтотОбъект.КэшПараметров.Дата,
				ЭтотОбъект.КэшПараметров.Организация,
				Объект.Дата,
				Объект.Организация));

	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	Если Не ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		УстановитьРуководителя(Объект.Организация, Объект.ПодразделениеОтправитель, Объект.Дата, Объект.Руководитель);
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		УстановитьПараметрыУчетаИКПоЦМОиПодразделениям();
		ЗаполнитьДанныеСчетовВФорме();
		УстановитьВидимостьКолонкиСумма(ЭтотОбъект);
		
	КонецЕсли;
	
	Если СчетУчета108(ЭтотОбъект) Тогда
		УправлениеМатериальнымиЗапасами.ОбработатьИзменениеПримененияДетальногоКЭК340и440(ЭтотОбъект,
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	ЗаполнитьДанныеСчетовВФорме();
	УстановитьВидимостьКолонкиСумма(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСчетаУчета(Результат, Параметры) Экспорт
	
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

// Обработчик выбора строки постоянно действующией комиссии. 
// См. ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии
// "Объект" передается явно, без этого данные объекта не заполняются в web-клиенте.
// 
// Параметры:
//  Результат - см. ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент.Результат
//  ДопПараметры - см. ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент.ДопПараметры
&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект)	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводДлинногоТекста(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля; 
	ТекущиеДанные[ИмяПоля] = Результат;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеИдентификатораСтроки()

	Для каждого Строка Из Объект.Материалы Цикл
		Если Не ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
			Строка.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла; 

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Форма)

	РедактированиеЗапрещено = Форма.Объект.ЕстьРешениеОПрекращенииПризнанияАктивом
		И ЗначениеЗаполнено(Форма.Объект.ДокументОснование);
	
	БлокируемыеЭлементы = Новый Массив;
	БлокируемыеЭлементы.Добавить("ЦМООтправитель");
	БлокируемыеЭлементы.Добавить("ПодразделениеОтправитель");
	БлокируемыеЭлементы.Добавить("ИФО");
	БлокируемыеЭлементы.Добавить("МатериалыНоменклатура");
	БлокируемыеЭлементы.Добавить("МатериалыКПС");
	БлокируемыеЭлементы.Добавить("МатериалыКФО");
	БлокируемыеЭлементы.Добавить("МатериалыСчетУчета");
	БлокируемыеЭлементы.Добавить("МатериалыКЭК");
	БлокируемыеЭлементы.Добавить("МатериалыДополнительнаяАналитикаСчета");
	БлокируемыеЭлементы.Добавить("МатериалыКоличество");
	БлокируемыеЭлементы.Добавить("ТребуетсяУтилизация");
	БлокируемыеЭлементы.Добавить("ПервичныйДокумент");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, БлокируемыеЭлементы,
		"ТолькоПросмотр", РедактированиеЗапрещено);
	Если Не РедактированиеЗапрещено Тогда 
		ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(Форма);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьРеквизитыНедоступныеЕслиВыбраноРешение(Объект)
	Объект.Комиссия = ПредопределенноеЗначение("Справочник.ПостоянноДействующиеКомиссии.ПустаяСсылка");
	Объект.СоставКомиссии.Очистить();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоАктОСписании0510460 = Форма.ЭтоАктСписания0510460;
	
	ЭлементыСписанияБезРешения = Новый Массив;
	ЭлементыСписанияБезРешения.Добавить("ДокументОснование");
	ЭлементыСписанияБезРешения.Добавить("АналитикаОперацииСДрагМатериалами");
	ЭлементыСписанияБезРешения.Добавить("НоменклатураЛома");
	ЭлементыСписанияБезРешения.Добавить("СписокНФАДокументаОснования");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалы");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалыЗаполнитьСписокДМДляСписания");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыСписанияБезРешения,
		"Видимость", Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РешениеОПрекращенииПризнанияАктивом",
		"Видимость", Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	// Элементы только акта списания 0510460
	
	Элементы61нДляСписания = Новый Массив;
	Элементы61нДляСписания.Добавить("ГруппаИндикаторКворумаПрисутствия");
	Элементы61нДляСписания.Добавить("НадписьГолосование");
	Элементы61нДляСписания.Добавить("Сотрудник");
	Элементы61нДляСписания.Добавить("СохранитьРезультатыГолосования");
	Элементы61нДляСписания.Добавить("НадписьФайл");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы61нДляСписания,
		"Видимость", ЭтоАктОСписании0510460 И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФайлСотрудника",
		"Видимость", ЭтоАктОСписании0510460 И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом
		И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУдалитьФайл",
		"Видимость", ЭтоАктОСписании0510460 И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом
		И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьФайлНеВыбран",
		"Видимость", ЭтоАктОСписании0510460 И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом
		И Не ЗначениеЗаполнено(Форма.ФайлСотрудника));
	
	// Элементы акта списания 0504230
	Элементы52н = Новый Массив;
	Элементы52н.Добавить("ЗаключениеКомиссии");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы52н,
		"Видимость",
		Не ЭтоАктОСписании0510460
		И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	// Основание списания
	ЭлементыОснования = Новый Массив;
	ЭлементыОснования.Добавить("ВидОснованияСписания");
	ЭлементыОснования.Добавить("ДатаОснованияСписания");
	ЭлементыОснования.Добавить("НомерОснованияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыОснования,
		"Видимость", Не ЭтоАктОСписании0510460);
		
	// Резервирование и подбор
	ЭлементыРезервированияПодбор = Новый Массив;
	ЭлементыРезервированияПодбор.Добавить("ПереключательРезервирование");
	ЭлементыРезервированияПодбор.Добавить("Аннулирован");
	ЭлементыРезервированияПодбор.Добавить("МатериалыПодборНоменклатуры");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыРезервированияПодбор,
		"Видимость", Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
		
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(Форма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме = Неопределено)
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	СчетСсылка108 = БухгалтерскийУчет.СчетПоКоду("108.00", ДатаСчетов, Объект.Организация);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет108", СчетСсылка108);
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать105 = Ложь;
	ПараметрыЗаполненияСчета.Включать108 = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовые = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовыеИК = Ложь;
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);
	
КонецПроцедуры

&НаКлиенте
