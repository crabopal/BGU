#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ТекущиеДанные.РезолюцияКомиссииОдобрена = Ложь;
		ТекущиеДанные.ИтогГолосования = 0;
		ТекущиеДанные.РешениеСотрудникаПоРезолюции
			= ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.ПустаяСсылка");
	КонецЕсли;

	Если НоваяСтрока И НЕ Копирование Тогда
		Если НЕ СчетУчета108(ЭтотОбъект) Тогда
			ТекущиеДанные.СчетУчета = Объект.СчетУчета;
			УправлениеМатериальнымиЗапасамиКлиентСервер
				.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.НаправленияРасходаМПЗ") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписания = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПричиныСписанияНФА") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписанияСсылка = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПередУдалением(Элемент, Отказ)
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ОбъектНаУдаление = Элементы.Материалы.ТекущиеДанные.Номенклатура;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА (%1) на закладке ""Драгоценные материалы""?'"),
			СокрЛП(ОбъектНаУдаление));
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	КонецЕсли;	
КонецПроцедуры

