	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияИК";
	КомандаПечати.Идентификатор		= "АктОСписанииМЗ0510460_157н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании МЗ'"), "0510460", "61н", "157н");
	КомандаПечати.Порядок			= 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВыдатьВЛичноеПользование", Ложь);
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
