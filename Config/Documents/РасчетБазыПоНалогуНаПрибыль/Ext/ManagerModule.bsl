#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область ЗаполнениеДокумента

Процедура ЗаполнитьРасчетБазыПоНалогуНаПрибыль(ДокументОбъект) Экспорт

	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.РасчетБазыПоНалогуНаПрибыль") Тогда
		Возврат; // неверный тип документа
	КонецЕсли;
	
	// Получим коэффициент распределения расходов по видам деятельности.
	ДокументОбъект.ДоляЕНВД = НалоговыйУчет.КоэффициентРаспределенияРасходовПоВидамДеятельности(
		ДокументОбъект.Организация, ДокументОбъект.Дата); // За месяц
	
	// Получим данные для закрытия счетов Н90 И Н91.
	ПараметрыОперации = Новый Структура("Организация, Дата",
		ДокументОбъект.Организация, ДокументОбъект.Дата);
	ТаблицыЗакрытияСчетов = ПодготовитьТаблицыЗакрытияСчетовН90иН91(ПараметрыОперации);
	
	// В таблице "Закрытие счета Н90" содержится финансовый результат от обычных видов деятельности.
	Для Каждого ЗакрытиеН90 Из ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчетаН90 Цикл
		
		Если ЗакрытиеН90.ПрибыльНУ = 0
		   И ЗакрытиеН90.ПрибыльНеУчитываетсяНУ = 0
		   И ЗакрытиеН90.ПрибыльЕНВД = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.ЗакрытиеСчетаН90.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗакрытиеН90);
		
		НоваяСтрока.СуммаНУ              = ЗакрытиеН90.ПрибыльНУ;
		НоваяСтрока.СуммаНеУчитываетсяНУ = ЗакрытиеН90.ПрибыльНеУчитываетсяНУ;
		НоваяСтрока.СуммаЕНВД            = ЗакрытиеН90.ПрибыльЕНВД;
		
	КонецЦикла;
	
	// В таблице "Закрытие счета Н91" содержится финансовый результат от прочих операций.
	Для Каждого ЗакрытиеН91 Из ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчетаН91 Цикл
		
		Если ЗакрытиеН91.ПрибыльНУ = 0
		   И ЗакрытиеН91.ПрибыльНеУчитываетсяНУ = 0
		   И ЗакрытиеН91.ПрибыльЕНВД = 0
		   И ЗакрытиеН91.СуммаРаспределяемыхЗатрат = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.ЗакрытиеСчетаН91.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗакрытиеН91);
		
		НоваяСтрока.СуммаНУ                   = ЗакрытиеН91.ПрибыльНУ;
		НоваяСтрока.СуммаНеУчитываетсяНУ      = ЗакрытиеН91.ПрибыльНеУчитываетсяНУ;
		НоваяСтрока.СуммаЕНВД                 = ЗакрытиеН91.ПрибыльЕНВД;
		НоваяСтрока.СуммаРаспределяемыхЗатрат = ЗакрытиеН91.СуммаРаспределяемыхЗатрат;
		
	КонецЦикла;
	
	// Получим данные для списания убытков прошлых лет.
	ПараметрыОперации = Новый Структура("Организация, Дата",
		ДокументОбъект.Организация, ДокументОбъект.Дата);
	ТаблицыСписанияУбытковПрошлыхЛет = ПодготовитьТаблицыСписанияУбытковПрошлыхЛет(
		ПараметрыОперации, ТаблицыЗакрытияСчетов);
	
	Для Каждого СтрокаТаблицы Из ТаблицыСписанияУбытковПрошлыхЛет.ТаблицаПрибыльСНачалаГода Цикл
	
		// Рассчитываем списание убытков для каждого ИФО, КФО отдельно.
		Отбор = Новый Структура("ИФО, КФО", СтрокаТаблицы.ИФО, СтрокаТаблицы.КФО);
		
		УбыткиПрошлыхЛет = ТаблицыСписанияУбытковПрошлыхЛет.ТаблицаУбытковПрошлыхЛет.Скопировать(Отбор);
		ВсегоУбытков        = УбыткиПрошлыхЛет.Итог("ВсегоУбытков");
		ВсегоУбытковСписано = УбыткиПрошлыхЛет.Итог("ВсегоУбытковСписано");
		ПрибыльСНачалаГода  = СтрокаТаблицы.ПрибыльСНачалаГода;
		
		КоэффициентОграниченияУбытков = МаксимальнаяДоляУменьшенияПрибылиЗаСчетУбытковПрошлыхЛет(ПараметрыОперации.Дата);
		ЛимитСписанияУбытка = (ПрибыльСНачалаГода + ВсегоУбытковСписано) * КоэффициентОграниченияУбытков;
		
		Если ПрибыльСНачалаГода > 0 Тогда
			Если КоэффициентОграниченияУбытков < 1 Тогда
				МожноСписать = Мин(ПрибыльСНачалаГода, ВсегоУбытков, ЛимитСписанияУбытка - ВсегоУбытковСписано);
			Иначе // Нет ограничений на сумму списания убытков, можно списывать весь остаток.
				МожноСписать = Мин(ПрибыльСНачалаГода, ВсегоУбытков);
			КонецЕсли;
		Иначе
			Если КоэффициентОграниченияУбытков < 1 Тогда
				МожноСписать = Макс(ПрибыльСНачалаГода - ЛимитСписанияУбытка, -ВсегоУбытковСписано);
			Иначе // Нет ограничений на сумму списания убытков.
				МожноСписать = Макс(ПрибыльСНачалаГода, -ВсегоУбытковСписано);
			КонецЕсли;
		КонецЕсли;
		
		Если МожноСписать = 0 Тогда
			Продолжить;
		ИначеЕсли МожноСписать > 0 Тогда // Списываем сначала самые ранние.
			УбыткиПрошлыхЛет.Сортировать("ДатаНачалаСписания Возр");
		Иначе // Восстанавливаем сначала самые поздние.
			УбыткиПрошлыхЛет.Сортировать("ДатаНачалаСписания Убыв");
		КонецЕсли;
		
		Для Каждого Убыток Из УбыткиПрошлыхЛет Цикл
			
			Если МожноСписать = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если МожноСписать > 0 Тогда // Списываем убытки.
				СуммаКСписанию = Мин(МожноСписать, Убыток.ВсегоУбытков);
			Иначе // Восстанавливаем убытки, списанные ранее в этом году.
				СуммаКСписанию = Макс(МожноСписать, -Убыток.ВсегоУбытковСписано);
			КонецЕсли;
			
			Если МожноСписать <> 0 И СуммаКСписанию <> 0 Тогда
				
				НоваяСтрока = ДокументОбъект.СписаниеУбытковПрошлыхЛет.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Убыток);
				
				НоваяСтрока.ОстатокНУ = Убыток.ВсегоУбытков;
				НоваяСтрока.СписатьНУ = СуммаКСписанию;
				
				МожноСписать = МожноСписать - СуммаКСписанию;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует таблицы для отражения операции закрытия счетов Н90 и Н91.
//
Функция ПодготовитьТаблицыЗакрытияСчетовН90иН91(ПараметрыОперации)
	
	НомераТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	
	НомераТаблиц.Вставить("СчетаН90", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗакрытиеСчетаН90", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаН90
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СчетаДоходыИРасходыПоОбычнымВидамДеятельностиНУ)
	|	И ЕПСБУ.Ссылка <> &СчетПрибыльУбытокОтПродажНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Организация,
	|	ЕПСБУ.ИФО КАК ИФО,
	|	ЕПСБУ.КФО КАК КФО,
	|	ЕСТЬNULL(ЕПСБУ.СуммаОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаОборотДт, 0) КАК ПрибыльНУ,
	|	ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотДт, 0) КАК ПрибыльНеУчитываетсяНУ,
	|	ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотДт, 0) КАК ПрибыльЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачДата,
	|			&КонДата,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаН90.Счет
	|				ИЗ
	|					СчетаН90),
	|			,
	|			Организация В (&Организация),
	|			КорСчет <> &СчетПрибыльУбытокОтПродажНУ,
	|			) КАК ЕПСБУ";
	
	НомераТаблиц.Вставить("СчетаН91", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОборотыН91", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗакрытиеСчетаН91", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаН91
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СчетаПрочиеДоходыИРасходыНУ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Организация,
	|	ЕПСБУ.ИФО,
	|	ЕПСБУ.КФО,
	|	ВЫРАЗИТЬ(ЕПСБУ.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы) КАК СтатьяПрочихДоходовРасходов,
	|	ЕСТЬNULL(ЕПСБУ.СуммаОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаОборотДт, 0) КАК СуммаОборот,
	|	ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотДт, 0) КАК СуммаНеУчитываетсяНУОборот,
	|	ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотДт, 0) КАК СуммаЕНВДОборот
	|ПОМЕСТИТЬ ОборотыН91
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачДата,
	|			&КонДата,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаН91.Счет
	|				ИЗ
	|					СчетаН91),
	|			,
	|			Организация В (&Организация),
	|			КорСчет <> &СчетСальдоПрочихДоходовИРасходовНУ,
	|			) КАК ЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыН91.Организация КАК Организация,
	|	ОборотыН91.ИФО КАК ИФО,
	|	ОборотыН91.КФО КАК КФО,
	|	СУММА(ОборотыН91.СуммаОборот) КАК ПрибыльНУ,
	|	СУММА(ОборотыН91.СуммаНеУчитываетсяНУОборот) КАК ПрибыльНеУчитываетсяНУ,
	|	СУММА(ОборотыН91.СуммаЕНВДОборот) КАК ПрибыльЕНВД,
	|	СУММА(ВЫБОР
	|			КОГДА ОборотыН91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты)
	|				ТОГДА -ОборотыН91.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаРаспределяемыхЗатрат
	|ИЗ
	|	ОборотыН91 КАК ОборотыН91
	|
	|СГРУППИРОВАТЬ ПО
	|	ОборотыН91.Организация,
	|	ОборотыН91.ИФО,
	|	ОборотыН91.КФО";
	
	Запрос.УстановитьПараметр("НачДата",     НачалоМесяца(ПараметрыОперации.Дата));
	Запрос.УстановитьПараметр("КонДата",     КонецМесяца(ПараметрыОперации.Дата));
	Запрос.УстановитьПараметр("КонГраница",  Новый Граница(КонецМесяца(ПараметрыОперации.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ПараметрыОперации.Организация);
	Запрос.УстановитьПараметр("СписокКФО",   НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	
	Запрос.УстановитьПараметр("СчетаДоходыИРасходыПоОбычнымВидамДеятельностиНУ",
		БухгалтерскийУчет.СписокСчетов("Н90"));
	Запрос.УстановитьПараметр("СчетПрибыльУбытокОтПродажНУ",
		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.09"));
	Запрос.УстановитьПараметр("СчетаПрочиеДоходыИРасходыНУ",
		БухгалтерскийУчет.СписокСчетов("Н91"));
	Запрос.УстановитьПараметр("СчетСальдоПрочихДоходовИРасходовНУ",
		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н91.09"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура("ТаблицаЗакрытиеСчетаН90, ТаблицаЗакрытиеСчетаН91",
		Результат[НомераТаблиц.ТаблицаЗакрытиеСчетаН90].Выгрузить(),
		Результат[НомераТаблиц.ТаблицаЗакрытиеСчетаН91].Выгрузить());
	
КонецФункции

// Формирует таблицы для отражения операции списания убытков прошлых лет.
//
Функция ПодготовитьТаблицыСписанияУбытковПрошлыхЛет(ПараметрыОперации, ТаблицыЗакрытияСчетов)
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("НалоговаяБазаПредыдущихМесяцев", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПрибыльУбытокОтПродажТекущегоМесяца", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СальдоПрочихДоходовРасходовТекущегоМесяца", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаПрибыльСНачалаГода", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.ИФО КАК ИФО,
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт КАК ПрибыльСНачалаГода
	|ПОМЕСТИТЬ НалоговаяБазаПредыдущихМесяцев
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачДата, &КонДата, , Счет В (&СчетаПрибылиИУбыткиНУ), , Организация = &Организация, , ) КАК ЕПСБУОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗакрытиеСчетаН90.ИФО КАК ИФО,
	|	ЗакрытиеСчетаН90.КФО КАК КФО,
	|	ЗакрытиеСчетаН90.ПрибыльНУ КАК ПрибыльНУ
	|ПОМЕСТИТЬ ПрибыльУбытокОтПродажТекущегоМесяца
	|ИЗ
