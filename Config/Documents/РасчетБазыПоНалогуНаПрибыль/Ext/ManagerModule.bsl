// Устарела. Функция использовалась в ранней версии операции "Расчет базы по налогу на прибыль".
//
Функция РасчетБазыПоНалогуНаПрибыль(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Записывать = Истина;
	ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Очистить();
	ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Записать();
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	// Получим остатки и обороты по счетам Н90 И Н91.
	ПараметрыОперации = Новый Структура("Организация, Дата", ДокументОбъект.Организация, ДокументОбъект.Дата);
	ТаблицыЗакрытияСчетов = НалоговыйУчет.ПодготовитьТаблицыЗакрытияСчетовН90иН91(ПараметрыОперации);
	
	// Сформируем проводки.
	СформироватьПроводкиЗакрытие9Х(ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчета90, ТаблицаПроводок, Отказ);
	СформироватьПроводкиЗакрытие9Х(ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчета91, ТаблицаПроводок, Отказ);
	
	СкорректироватьЗакрытиеРаспределяемыхРасходов(ТаблицаПроводок, Отказ);
	
	Если Отказ = Истина Тогда
		ТаблицаПроводок.Очистить();
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Организация, "Организация");
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Дата, "Период");
	
	Возврат ТаблицаПроводок;

КонецФункции

// Формирует проводки по закрытию счета Н90.
//
Процедура СформироватьПроводкиЗакрытие9Х(ТаблицаЗакрытиеСчета9Х, ТаблицаПроводок, Отказ)
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗакрытиеСчета9Х Цикл
		
		МассивСумм = Новый Массив;
		МассивСумм.Добавить("ПрибыльНУ");
		МассивСумм.Добавить("ПрибыльНеУчитываетсяНУ");
		МассивСумм.Добавить("ПрибыльЕНВД");
		
		Для Каждого ВидСуммы Из МассивСумм Цикл
			
			Прибыль = СтрокаТаблицы[ВидСуммы];
			
			Если Прибыль <> 0 Тогда
				
				Проводка = ТаблицаПроводок.Добавить();
				ЗаполнитьЗначенияСвойств(Проводка, СтрокаТаблицы, "ИФО,КФО");
				
				Если Прибыль > 0 Тогда
					
					Проводка.СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н99");
					
					Проводка.СчетДт = СтрокаТаблицы.СчетПрибылейУбытков;
					
					Для НомерСубконто = 1 По 3 Цикл
						// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
						Проводка["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(Проводка.СчетДт, НомерСубконто,
							СтрокаТаблицы.ВидСубконто1, СтрокаТаблицы.Субконто1,
							СтрокаТаблицы.ВидСубконто2, СтрокаТаблицы.Субконто2,
							СтрокаТаблицы.ВидСубконто3, СтрокаТаблицы.Субконто3);
					КонецЦикла;
					
					Если ВидСуммы = "ПрибыльНУ" Тогда
						Проводка.Сумма = Прибыль;
					ИначеЕсли ВидСуммы = "ПрибыльНеУчитываетсяНУ" Тогда
						Проводка.СуммаНеУчитываетсяНУ = Прибыль;
					ИначеЕсли ВидСуммы = "ПрибыльЕНВД" Тогда
						Проводка.СуммаЕНВД = Прибыль;
					КонецЕсли;
					
				КонецЕсли;
				
				Если Прибыль < 0 Тогда
					
					Проводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н99");
					
					Проводка.СчетКт = СтрокаТаблицы.СчетПрибылейУбытков;
					
					Для НомерСубконто = 1 По 3 Цикл
						// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
						Проводка["СубконтоКт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(Проводка.СчетКт, НомерСубконто,
							СтрокаТаблицы.ВидСубконто1, СтрокаТаблицы.Субконто1,
							СтрокаТаблицы.ВидСубконто2, СтрокаТаблицы.Субконто2,
							СтрокаТаблицы.ВидСубконто3, СтрокаТаблицы.Субконто3);
					КонецЦикла;
					
					Если ВидСуммы = "ПрибыльНУ" Тогда
						Проводка.Сумма = - Прибыль;
					ИначеЕсли ВидСуммы = "ПрибыльНеУчитываетсяНУ" Тогда
						Проводка.СуммаНеУчитываетсяНУ = - Прибыль;
					ИначеЕсли ВидСуммы = "ПрибыльЕНВД" Тогда
						Проводка.СуммаЕНВД = - Прибыль;
					КонецЕсли;
					
				КонецЕсли;
				
				Проводка.Содержание = НСтр("ru = 'Расчет налоговой базы по налогу на прибыль'");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьЗакрытиеРаспределяемыхРасходов(ТаблицаПроводок, Отказ)
	
	ВидыДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат;
	
	КоличествоПроводок = ТаблицаПроводок.Количество();
	Для НомерПроводки = 1 По КоличествоПроводок Цикл
		
		ИндексПроводки = КоличествоПроводок - НомерПроводки;
		Проводка = ТаблицаПроводок[ИндексПроводки];
		
		ЭтоРаспределяемыеЗатраты = Ложь;
		Если Проводка.СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н91.09")
		   И ЗначениеЗаполнено(Проводка.СубконтоКт1)
		   И ТипЗнч(Проводка.СубконтоКт1) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
			ЭтоРаспределяемыеЗатраты = (Проводка.СубконтоКт1.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВидыДеятельностиНУ.РаспределяемыеЗатраты);
		КонецЕсли;
		
		Если ЭтоРаспределяемыеЗатраты И Проводка.СуммаЕНВД > 0 Тогда
		
			НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
				"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3"); // без корреспонденции
			
			НоваяПроводка.Сумма     = Проводка.СуммаЕНВД;
			НоваяПроводка.СуммаЕНВД = - Проводка.СуммаЕНВД;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
