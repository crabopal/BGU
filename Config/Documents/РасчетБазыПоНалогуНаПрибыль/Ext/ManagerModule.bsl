	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИФО,
	|	КФО";
	Запрос.УстановитьПараметр("ТаблицаЗакрытиеСчетаН90", ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчетаН90);
	Запрос.УстановитьПараметр("ТаблицаЗакрытиеСчетаН91", ТаблицыЗакрытияСчетов.ТаблицаЗакрытиеСчетаН91);
	
	// До налогового периода 2017 года можно было списывать убытки за 10 предыдущих лет.
	// С 2017 года этот период зафиксирован "снизу" (401-ФЗ): 
	// можно списывать убытки прошлых лет, начиная с 2007 года, бессрочно.
	Если ПараметрыОперации.Дата < '2017-01-01' Тогда
		// Здесь проверяем только, что срок списания убытка не истек.
		Запрос.УстановитьПараметр("ДатаНачалаСписания", '0001-01-01');
		Запрос.УстановитьПараметр("ПродолжительностьСписанияУбытковОграничена", Истина);
	Иначе
		// Убытки 2007 года списываются начиная с 01.01.2008.
		Запрос.УстановитьПараметр("ДатаНачалаСписания", '2008-01-01');
		Запрос.УстановитьПараметр("ПродолжительностьСписанияУбытковОграничена", Ложь);
	КонецЕсли;
	
	НомераТаблиц.Вставить("УбыткиПрошлыхЛет", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаУбытковПрошлыхЛет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасходыБудущихПериодов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ УбыткиПрошлыхЛет
	|ИЗ
	|	Справочник.РасходыБудущихПериодов КАК РасходыБудущихПериодов
	|ГДЕ
	|	РасходыБудущихПериодов.ВидРБП = ЗНАЧЕНИЕ(Перечисление.ВидыРБП.УбыткиПрошлыхЛет)
	|	И РасходыБудущихПериодов.ДатаНачалаСписания МЕЖДУ &ДатаНачалаСписания И &НачДата
	|	И (НЕ &ПродолжительностьСписанияУбытковОграничена
	|			ИЛИ РасходыБудущихПериодов.ДатаОкончанияСписания >= &ДатаОкончанияСписания)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.РасходыБудущихПериодов) КАК УбыткиПрошлыхЛет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.РасходыБудущихПериодов).ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	ЕПСБУОбороты.СуммаКонечныйОстаток КАК ВсегоУбытков,
	|	СУММА(ЕПСБУОбороты.СуммаОборотКт) КАК ВсегоУбытковСписано
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	|			&НачДата,
	|			&КонДата,
	|			,
	|			,
	|			Счет В (&СчетаРасходыБудущихПериодовНУ),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.РасходыБудущихПериодов),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						УбыткиПрошлыхЛет.Ссылка
	|					ИЗ
	|						УбыткиПрошлыхЛет)) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.Счет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.РасходыБудущихПериодов),
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.РасходыБудущихПериодов).ДатаНачалаСписания,
	|	ЕПСБУОбороты.СуммаКонечныйОстаток";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОперации.Организация);
	Запрос.УстановитьПараметр("НачДата",     НачалоГода(ПараметрыОперации.Дата));
	Запрос.УстановитьПараметр("КонДата",     КонецМесяца(ПараметрыОперации.Дата));
	Запрос.УстановитьПараметр("ДатаОкончанияСписания", НачалоДня(КонецМесяца(ПараметрыОперации.Дата)));
	
	Запрос.УстановитьПараметр("СчетаПрибылиИУбыткиНУ",         БухгалтерскийУчет.СписокСчетов("Н99"));
	Запрос.УстановитьПараметр("СчетаРасходыБудущихПериодовНУ", БухгалтерскийУчет.СписокСчетов("Н97"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура("ТаблицаПрибыльСНачалаГода, ТаблицаУбытковПрошлыхЛет",
		Результат[НомераТаблиц.ТаблицаПрибыльСНачалаГода].Выгрузить(),
		Результат[НомераТаблиц.ТаблицаУбытковПрошлыхЛет].Выгрузить());
	
КонецФункции

Функция МаксимальнаяДоляУменьшенияПрибылиЗаСчетУбытковПрошлыхЛет(Период)
	
	// В отчетные (налоговые) периоды с 1 января 2017 года по 31 декабря 2030 года
	// налоговая база по налогу за текущий отчетный (налоговый) период... 
	// не может быть уменьшена на сумму убытков, полученных в предыдущих налоговых периодах,
	// более чем на 50 процентов (п.2.1 cт. 283 НК РФ в редакции от 15.12.2025).
	Если (НачалоГода(Период) >= '2017-01-01' И НачалоГода(Период) <= '2030-01-01') Тогда
		Возврат 0.5;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

