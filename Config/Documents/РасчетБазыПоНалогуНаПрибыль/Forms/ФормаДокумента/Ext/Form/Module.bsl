Процедура ПодготовитьФормуНаСервере()
	
	ВалютаРубли = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	
	ЗакрытиеСчетаН90ЗаполнитьДобавленныеКолонки();
	ЗакрытиеСчетаН91ЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ЗакрытиеСчетаН90ЗаполнитьДобавленныеКолонки();
	ЗакрытиеСчетаН91ЗаполнитьДобавленныеКолонки();
	РассчитатьСуммуДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеВДокументе()
	
	Возврат (Объект.ЗакрытиеСчетаН90.Количество() > 0)
		ИЛИ (Объект.ЗакрытиеСчетаН91.Количество() > 0)
		ИЛИ (Объект.СписаниеУбытковПрошлыхЛет.Количество() > 0);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуДокумента(Объект)
	
	Объект.СуммаДокумента =
		Объект.ЗакрытиеСчетаН90.Итог("СуммаНУ")
		+ Объект.ЗакрытиеСчетаН91.Итог("СуммаНУ")
		- Объект.СписаниеУбытковПрошлыхЛет.Итог("СписатьНУ");
	
КонецПроцедуры

