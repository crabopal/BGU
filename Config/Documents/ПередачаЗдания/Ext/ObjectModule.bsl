#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ДатаСписанияСБухУчета) Тогда
		ДатаСписанияСБухУчета = Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ПередачаЗдания.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Движения по регистрам накопления
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОбъектовОС");
	
	// Движения по регистрам сведений
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "МестонахождениеОС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ОсновныеСредстваВПользовании");

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(ОсновноеСредство) Тогда
		ПроверяемыеРеквизиты.Очистить();
		ПроверяемыеРеквизиты.Добавить("ОсновноеСредство");
		Возврат;
	КонецЕсли;
	
	СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Ссылка);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаОС);
	
	Если СвойстваСчета = Неопределено Тогда
		ПроверяемыеРеквизиты.Очистить();
		ТекстСообщения = НСтр("ru='В выбранное объекте не указан счет учета'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
		Возврат;
	КонецЕсли;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации) Тогда
		
		УправлениеОсновнымиСредствами.ПроверитьСобытиеОСвПользовании(
			УправлениеОсновнымиСредствами.НоваяТаблицаОСИнвНомер(ОсновноеСредство, ИнвентарныйНомер),
			Организация,
			Дата,
			Ссылка,
			,
			,
			Отказ);
			
		Если Отказ Тогда
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
		
	Иначе
			
		НеПроверяемыеРеквизиты.Добавить("ЦМОПолучатель");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	
	КонецЕсли;
	
	
	УчетПоПодразделениям = Ложь;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		УчетПоПодразделениям = СвойстваСчета.УчетПоПодразделениям;
	КонецЕсли;
	Если Не УчетПоПодразделениям Тогда
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	Если ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
		НеПроверяемыеРеквизиты.Добавить("ЦМО");
	КонецЕсли;
	Если НЕ СвойстваСчета.УчетПоКПС Тогда
		НеПроверяемыеРеквизиты.Добавить("КПС");
	КонецЕсли;
	Если НЕ (СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
			ИЛИ СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
			ИЛИ СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) Тогда
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);	
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		ТекстСообщения = НСтр("ru='Документ применяется только для отражения передачи объектов ОС - зданий (сооружений)'");
		Если ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
			ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ИнвентарныйНомер"));	
		ИначеЕсли ОсновноеСредство.ВидНФА <> Перечисления.ВидыНФА.ОС Тогда
			Отказ = Истина;
		Иначе
			СчетаУчетаЗданий = УправлениеОсновнымиСредствамиПовтИсп.ПолучитьМассивСчетовОС(	Неопределено,
																							Истина,
																							Истина,
																							Истина,
																							Ложь,
																							Ложь,
																							Ложь,
																							Ложь,
																							Ложь,
																							Истина,
																							Истина);
			Если СчетаУчетаЗданий.Найти(СчетУчетаОС) = Неопределено Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Отказ Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство");
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли