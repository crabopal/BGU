&НаКлиенте
Процедура ОбнулитьСуммы()

	Объект.Сумма 			= 0;
	Объект.СуммаАмортизации	= 0;

КонецПроцедуры // ОбнулитьСуммы()

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Ложь)

	Если НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках) Тогда
		Возврат;
	КонецЕсли;
	РассчитатьБалансовуюСтоимостьИАмортизацию();
	УстановитьОбязательностьИнвНомера();
КонецПроцедуры // РассчитатьСуммы()

&НаСервере
Процедура РассчитатьБалансовуюСтоимостьИАмортизацию()

	ЭтоКапВложение =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОсновноеСредство, "ВидНФА") = Перечисления.ВидыНФА.КапВложения;
	Если ОС_СчетУчета_Забалансовый Тогда
		Если Параметры.Ключ.Пустая() Тогда
			Если ЭтоПередачаВПользование(Объект.ВидОперации) Тогда
				ПериодОстатков = КонецДня(Объект.Дата);
			Иначе
				ПериодОстатков = ?(ЗначениеЗаполнено(Объект.ДатаСписанияСБухУчета), КонецДня(Объект.ДатаСписанияСБухУчета), КонецДня(Объект.Дата));
			КонецЕсли;
		Иначе
			Если ЭтоПередачаВПользование(Объект.ВидОперации) 
				ИЛИ Не ЗначениеЗаполнено(Объект.ДатаСписанияСБухУчета)
				ИЛИ НачалоДня(Объект.Дата) = НачалоДня(Объект.ДатаСписанияСБухУчета) Тогда
				
				ПериодОстатков = Объект.Ссылка.МоментВремени();
			Иначе
				ПериодОстатков = Объект.ДатаСписанияСБухУчета-1;
			КонецЕсли;
		КонецЕсли;		
		
		ПараметрыЗапроса = Новый Структура("Период, Организация, КПС, КФО, ИФО, Подразделение, ЦМО, Контрагент",
											ПериодОстатков,
											Объект.Организация,
											Объект.КПС,
											Объект.КФО,
											Объект.ИФО,
											Объект.Подразделение,
											Объект.ЦМО,
											Объект.Контрагент);					
		СтоимостьОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьОбъектаОС(Объект.ОсновноеСредство, ПараметрыЗапроса,ПериодОстатков);						
		Сумма = 0;
		Количество = 0;
		Если СтоимостьОС.Количество()>0 Тогда
			Сумма = СтоимостьОС[0].Сумма;
			Количество = СтоимостьОС[0].Количество;
		КонецЕсли;
							
		Если Количество>0 Тогда
			Цена = Сумма / Количество;
		Иначе
			Цена = 0;
		КонецЕсли;
		
		Объект.Сумма 			= Цена;
		Объект.СуммаАмортизации	= 0;
	Иначе
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
		ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер = Не ЗначениеЗаполнено(Объект.ИнвентарныйНомер);
		ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
			ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков); 
		Иначе
			ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
		КонецЕсли;
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ОсновноеСредство",	"ОсновноеСредство");
		ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",	"ИнвентарныйНомер");
	//	ПараметрыЗаполнения.Вставить("Количество",			"Количество");
	//	ПараметрыЗаполнения.Вставить("Цена",				"Цена");
		ПараметрыЗаполнения.Вставить("Сумма",				"Сумма");
		ПараметрыЗаполнения.Вставить("КПС",					"КПС");
		ПараметрыЗаполнения.Вставить("СуммаАмортизации",	"СуммаАмортизации");
		ПараметрыЗаполнения.Вставить("ИсходноеКоличество",	1);
		
		ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер", Истина);
		ПараметрыЗаполнения.Вставить("УстанавливатьКПС",	Истина);
			
		УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, Объект, ПараметрыЗаполнения);
	КонецЕсли;	

КонецПроцедуры // РассчитатьБалансовуюСтоимостьИАмортизацию()

&НаСервере
Процедура ПолучитьИнвентарныйНомер()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	МестонахождениеОССрезПоследних.ИнвНомер
				   |ИЗ
				   |	РегистрСведений.МестонахождениеОС.СрезПоследних(
				   |			&Период,
				   |			ОсновноеСредство = &ОсновноеСредство
				   |				И Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
				   |				И ЦМО = &ЦМО) КАК МестонахождениеОССрезПоследних";
	Запрос.УстановитьПараметр("ОсновноеСредство", 	Объект.ОсновноеСредство);
	Запрос.УстановитьПараметр("Период",				?(Параметры.Ключ.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени()));
	Запрос.УстановитьПараметр("ЦМО",				Объект.ЦМО);
	Результат = Запрос.Выполнить();
	ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			ИнвентарныйНомер = Выборка.ИнвНомер;
		КонецЕсли;
	КонецЕсли;		
	Объект.ИнвентарныйНомер = ИнвентарныйНомер;
	
КонецПроцедуры // ПриИзмененииОсновногоСредства()

&НаКлиенте
Процедура ПересчитатьНДС()

	Ставка = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(Объект.СтавкаНДС);
	Если Объект.СуммаВключаетНДС Тогда
		Объект.СуммаНДС = Объект.ЦенаПродажи / (100 + Ставка) * Ставка;
	Иначе
		Объект.СуммаНДС = Объект.ЦенаПродажи / 100 * Ставка;
	КонецЕсли;
    ПересчитатьВсего();
	
КонецПроцедуры // ПересчитатьНДС()
 
&НаКлиенте
Процедура ПересчитатьВсего()
	Если Объект.СуммаВключаетНДС Тогда
		Объект.Всего = Объект.ЦенаПродажи;
	Иначе
		Объект.Всего = Объект.ЦенаПродажи + Объект.СуммаНДС;
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбязательностьРеквизитов()

	Если ЗначениеЗаполнено(ОС_СчетУчета) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ОС_СчетУчета);
		Элементы.КПС.АвтоОтметкаНезаполненного 				= СвойстваСчета.УчетПоКПС;
		Элементы.Подразделение.АвтоОтметкаНезаполненного	= ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям;
		Элементы.Контрагент.АвтоОтметкаНезаполненного		= СвойстваСчета.ВидСубконто1 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
																ИЛИ СвойстваСчета.ВидСубконто2 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
																ИЛИ СвойстваСчета.ВидСубконто3 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты");
	Иначе
		Элементы.КПС.АвтоОтметкаНезаполненного 				= Ложь;
		Элементы.Подразделение.АвтоОтметкаНезаполненного	= Ложь;
		Элементы.Контрагент.АвтоОтметкаНезаполненного		= Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидНФАДокумента) Тогда
		Элементы.ЦМО.АвтоОтметкаНезаполненного = ВидНФАДокумента <> ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения");
	Иначе
		Элементы.ЦМО.АвтоОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Если Элементы.КПС.АвтоОтметкаНезаполненного Тогда
		Элементы.КПС.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.КПС);
	Иначе
		Элементы.КПС.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	Если Элементы.Подразделение.АвтоОтметкаНезаполненного Тогда
		Элементы.Подразделение.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.Подразделение);
	Иначе
		Элементы.Подразделение.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	Если Элементы.Контрагент.АвтоОтметкаНезаполненного Тогда
		Элементы.Контрагент.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.Контрагент);
	Иначе
		Элементы.Контрагент.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	Если Элементы.ЦМО.АвтоОтметкаНезаполненного Тогда
		Элементы.ЦМО.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ЦМО);
	Иначе
		Элементы.ЦМО.ОтметкаНезаполненного = Ложь;
	КонецЕсли;

КонецПроцедуры // УстановитьОбязательностьРеквизитов()

&НаКлиенте
Процедура УстановитьОбязательностьИнвНомера()

	Элементы.ИнвентарныйНомер.АвтоОтметкаНезаполненного = ЗначениеЗаполнено(ВидНФАДокумента)
														И ВидНФАДокумента <> ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения")
														И Объект.Сумма > 3000;
														
	Если Элементы.ИнвентарныйНомер.АвтоОтметкаНезаполненного Тогда
		Элементы.ИнвентарныйНомер.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ИнвентарныйНомер);
	Иначе
		Элементы.ИнвентарныйНомер.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
		
КонецПроцедуры // УстановитьОбязательностьИнвНомера()

&НаКлиенте
Процедура ПриИзмененииОсновногоСредства(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость, СообщатьОбОшибках)

	Если ПолучатьИнвНомер Тогда
		ПолучатьИнвНомер = НЕ НеВсеРеквизитыДляИнвНомераЗаполнены(СообщатьОбОшибках);
	КонецЕсли;
	Если РассчитыватьСтоимость Тогда
		РассчитыватьСтоимость = НЕ НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках);
	КонецЕсли;
	
	Если ЗаполнятьРеквизитыОС ИЛИ ПолучатьИнвНомер ИЛИ РассчитыватьСтоимость Тогда
		ОбработатьИзменениеОсновногоСредстваНаСервере(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость);
	КонецЕсли;
	УстановитьОбязательностьИнвНомера();

КонецПроцедуры // ПриИзмененииОсновногоСредства()

&НаСервере
Процедура ОбработатьИзменениеОсновногоСредстваНаСервере(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость)

	Если ЗаполнятьРеквизитыОС Тогда
		ПрочитатьРеквизитыОС(Объект.Организация,Объект.ОсновноеСредство, ВидНФАДокумента, ГрупповойУчет, ОС_СчетУчета, ОС_СчетУчета_Забалансовый,Объект.Дата);
	КонецЕсли;
	
	Если ПолучатьИнвНомер Тогда
		ПолучитьИнвентарныйНомер();	
	КонецЕсли;
	
	Если РассчитыватьСтоимость Тогда
		РассчитатьБалансовуюСтоимостьИАмортизацию();
	КонецЕсли;

КонецПроцедуры // ОбработатьИзменениеОсновногоСредстваНаСервере()

&НаКлиенте
Функция НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках = Истина)

	Отказ = Ложь;
	Если ИспользоватьУчетПоИФО И НЕ ЗначениеЗаполнено(Объект.ИФО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит ИФО'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИФО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Элементы.ЦМО.АвтоОтметкаНезаполненного И НЕ ЗначениеЗаполнено(Объект.ЦМО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит МОЛ/Место хранения'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ЦМО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Элементы.Подразделение.АвтоОтметкаНезаполненного И НЕ ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Подразделение'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Подразделение",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Элементы.Контрагент.АвтоОтметкаНезаполненного И НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Контрагент'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Контрагент",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит КФО'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.КФО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	//Если Элементы.КПС.АвтоОтметкаНезаполненного И НЕ ЗначениеЗаполнено(Объект.КПС) Тогда
	//	Если СообщатьОбОшибках Тогда
	//		ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит КПС'");
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.КПС",,Отказ);
	//	Иначе
	//		Отказ = Истина;
	//		Возврат Отказ;
	//	КонецЕсли;
	//КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Объект'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Отказ;	

КонецФункции // НеВсеРеквизитыДляЗаполненияЗаполнены()

&НаКлиенте
Функция НеВсеРеквизитыДляИнвНомераЗаполнены(СообщатьОбОшибках = Истина)

	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Объект'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ЦМО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит МОЛ/Место хранения'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ЦМО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
    Возврат Отказ;
	
КонецФункции // НеВсеРеквизитыДляИнвНомераЗаполнены()

&НаСервереБезКонтекста
Процедура ПрочитатьРеквизитыОС(Организация, ОсновноеСредство, ВидНФА, ГрупповойУчет, СчетУчета, СчетУчетаЗабалансовый, НаДату)
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, НаДату);
	ВидНФА          = ДанныеОбъектаОС.ВидНФА;
	ГрупповойУчет   = ДанныеОбъектаОС.ГрупповойУчет;
	СчетУчета       = ДанныеОбъектаОС.СчетУчета;
	
	СчетУчетаЗабалансовый = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).Забалансовый;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыДляВыбораОС()

	Отбор = Новый Структура("Организация", Объект.Организация);
	ПараметрыФормы = Новый Структура;
	ПараметрыСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхвПользование") Тогда
		ПараметрыСчетов.Аренда			= Истина;
		
		ПараметрыФормы.Вставить("ОС",	Истина);
		ПараметрыФормы.Вставить("НПА",	Истина);
		
		Отбор.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		ПараметрыСчетов.Хранение		= Истина;
		
		ПараметрыФормы.Вставить("ОС", Истина);
		
		Отбор.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаОтветственномХранении"));
		
	Иначе
		ПараметрыСчетов.ЖилыеПомещения		= Истина;
		ПараметрыСчетов.НежилыеПомещения	= Истина;
		ПараметрыСчетов.Сооружения			= Истина;
		
		ПараметрыФормы.Вставить("ОС",	Истина);
		ПараметрыФормы.Вставить("НПА",	Истина);
		ПараметрыФормы.Вставить("НМА",	Истина);
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
			ПараметрыФормы.Вставить("КапВложения",	Истина);
		КонецЕсли;
		
		Отбор.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаБалансе"));
		
	КонецЕсли;
	ПараметрыФормы.Вставить("СписокВидовОС",	ПараметрыСчетов);
	ПараметрыФормы.Вставить("ТекущаяСтрока",	Объект.ОсновноеСредство);
	ПараметрыФормы.Вставить("ТребуемыеДанные",	"ГрупповойУчет,ВидНФА,СчетУчета,СчетУчетаЗабалансовый");
	ПараметрыФормы.Вставить("Отбор",			Отбор);
	Возврат ПараметрыФормы;

КонецФункции // ПараметрыДляВыбораОС()

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормойПоВидуОперации(Форма)

	Если ЭтоПередачаВПользование(Форма.Объект.ВидОперации) Тогда
		Форма.Элементы.ГруппаЦМОПодразделениеПолучательСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаЦМОПодразделениеПолучатель;
	Иначе
		Форма.Элементы.ГруппаЦМОПодразделениеПолучательСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаЦМОПодразделениеПолучатель1;
	КонецЕсли;		

КонецПроцедуры // УправлениеФормойПоВидуОперации()

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПередачаВПользование(ВидОперации)

	Возврат ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда")
			ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование");

КонецФункции // ЭтоПередачаВПользование()

