&НаКлиентеНаСервереБезКонтекста
Функция ЗадолженностьПоляАналитикиСчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение",
		"Объект.Задолженность.Счет",
		"Объект.Задолженность.КПС",
		"Объект.Задолженность.Подразделение");

КонецФункции

&НаСервере
Процедура ЗадолженностьЗаполнитьДобавленныеКолонки()
	
	Если Объект.ВидОперации <> Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиУчитываемойНаЗабалансе Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		СтрокаТаблицы.КЭКУчета = Строка(СтрокаТаблицы.КЭК); // Для счета 20 "Задолженность, невостребованная кредиторами".
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.Счет, ЗадолженностьПоляАналитикиСчета());
		
		ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетРасчетов);
	
	СтрокаТаблицы.ДоговорДоступность = 0;
	СтрокаТаблицы.ДопСубконтоРасчетовДоступность = 0;
	СтрокаТаблицы.НалогСборПлатежДоступность = 0;
	Для НомерСубконто = 1 По СвойстваСчетаРасчетов.КоличествоСубконто Цикл
		Если СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры") Тогда
			СтрокаТаблицы.ДоговорДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
		ИначеЕсли СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] <> ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
				И СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] <> ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры")
				И СтрНайти(СвойстваСчетаРасчетов["Код"], "303") = 0 Тогда // Кроме счетов 303.00.
			СтрокаТаблицы.ДопСубконтоРасчетовДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
			СтрокаТаблицы.ДопСубконтоРасчетовНомер = НомерСубконто;
		ИначеЕсли СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации") Тогда
			СтрокаТаблицы.НалогСборПлатежДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ЗадолженностьРанееНеУчитываемая

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетРасчетов, ЗадолженностьРанееНеУчитываемаяПоляАналитикиСчетаРасчетов(), "ЗадолженностьРанееНеУчитываемая");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		СтрокаДокументСписанияЗадолженности = Элементы.ДокументыСписанияКредиторскойЗадолженности.ТекущиеДанные;
		Если СтрокаДокументСписанияЗадолженности <> Неопределено Тогда
			ТекущиеДанные.ДокументСписанияЗадолженности = СтрокаДокументСписанияЗадолженности.ДокументСписанияЗадолженности;
		КонецЕсли;
		
		ТекущиеДанные.Валюта = Объект.ВалютаРасчетов;
		ТекущиеДанные.Контрагент = Объект.Контрагент;
		
		Если Не Копирование Тогда
			ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяСчетРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
	ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяСчетРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
	
	ТекущийСчет = Новый Структура("Счет, КПС, КФО");
	ТекущийСчет.Счет = ТекущиеДанные.СчетРасчетов;
	ТекущийСчет.КПС  = ТекущиеДанные.КПС;
	ТекущийСчет.КФО  = ТекущиеДанные.КФО;
	
	ОграниченияСписокСчетов = Новый СписокЗначений;
	ОграниченияСписокСчетов.Добавить("205.00");
	ОграниченияСписокСчетов.Добавить("208.00");
	ОграниченияСписокСчетов.Добавить("209.00");
	ОграниченияСписокСчетов.Добавить("301.00");
	ОграниченияСписокСчетов.Добавить("302.00");
	ОграниченияСписокСчетов.Добавить("303.00");
	ОграниченияСписокСчетов.Добавить("304.01");
	ОграниченияСписокСчетов.Добавить("304.02");
	ОграниченияСписокСчетов.Добавить("304.03");
	ОграниченияСписокСчетов.Добавить("304.06");
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка,
		ТекущийСчет, Объект.Организация, Объект.ИФО, ОграниченияСписокСчетов, ТекущиеДанные.КФО, , Объект.Дата,, );
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяСчетРасчетовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение, ТекущиеДанные.КПС, ТекущиеДанные.КФО);
	
	ТекущиеДанные.КЭК = БухгалтерскийУчетВызовСервераПовтИсп.АналитическийКЭКпоСчету(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяДопСубконтоРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗадолженностьРанееНеУчитываемая.ТекущиеДанные;
	
	Если ТекущиеДанные.ДопСубконтоРасчетовДоступность > 0 Тогда
		ПараметрыВыбораДопСубконто = Новый Структура;
		ПараметрыВыбораДопСубконто.Вставить("Организация",   Объект.Организация);
		ПараметрыВыбораДопСубконто.Вставить("Счет",          ТекущиеДанные.СчетРасчетов);
		ПараметрыВыбораДопСубконто.Вставить("КПС",			 ТекущиеДанные.КПС);
		ПараметрыВыбораДопСубконто.Вставить("КЭК",			 ТекущиеДанные.КЭК);
		ПараметрыВыбораДопСубконто.Вставить("НомерСубконто", ТекущиеДанные.ДопСубконтоРасчетовНомер);
		ПараметрыВыбораДопСубконто.Вставить("Субконто" + ТекущиеДанные.ДопСубконтоРасчетовНомер, ТекущиеДанные.ДопСубконтоРасчетов);
		БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораДопСубконто);
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРанееНеУчитываемаяОснованиеВозникновенияЗадолженностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора",,Элемент);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗадолженностьРанееНеУчитываемаяПоляАналитикиСчетаРасчетов()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение",
		"Объект.Задолженность.СчетРасчетов",
		"Объект.Задолженность.КПС",
		"Объект.Задолженность.Подразделение");

КонецФункции

&НаСервере
Процедура ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонки()
	
	Если Объект.ВидОперации <> Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетРасчетов); // Балансовые счета расчетов.
		Если СвойстваСчетаРасчетов.БезДетализацииКОСГУ Тогда
			СтрокаТаблицы.КЭКУчета = "000";
		Иначе
			СтрокаТаблицы.КЭКУчета = "00" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Контрагент, "ТипКонтрагента.Код");
		КонецЕсли;
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетРасчетов, ЗадолженностьРанееНеУчитываемаяПоляАналитикиСчетаРасчетов());
		
		ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетРасчетов);
	
	СтрокаТаблицы.ДоговорДоступность = 0;
	СтрокаТаблицы.ДопСубконтоРасчетовДоступность = 0;
	СтрокаТаблицы.НалогСборПлатежДоступность = 0;
	Для НомерСубконто = 1 По СвойстваСчетаРасчетов.КоличествоСубконто Цикл
		Если СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры") Тогда
			СтрокаТаблицы.ДоговорДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
		ИначеЕсли СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] <> ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
				И СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] <> ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры")
				И СтрНайти(СвойстваСчетаРасчетов["Код"], "303") = 0 Тогда // Кроме счетов 303.00.
			СтрокаТаблицы.ДопСубконтоРасчетовДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
			СтрокаТаблицы.ДопСубконтоРасчетовНомер = НомерСубконто;
		ИначеЕсли СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации") Тогда
			СтрокаТаблицы.НалогСборПлатежДоступность = ?(СвойстваСчетаРасчетов["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ИФО");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВалютаРасчетов) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Валюта расчетов'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ВалютаРасчетов");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыВопроса = ЗаполнитьДокументПараметрыВопроса();
	Если ЗначениеЗаполнено(ПараметрыВопроса.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументОбработкаОтвета", ЭтотОбъект, ПараметрыЗаполнения);
		ПоказатьВопрос(Оповещение, ПараметрыВопроса.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
	УстановитьОтборСтрокВТаблицеЗадолженность();
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// СтандартныеПодсистемы.Свойства
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
    УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

