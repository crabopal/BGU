	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Валютные суммы.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьОстатокСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьВосстановитьСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяВосстановитьСуммаВал");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Валюта", ВидСравненияКомпоновкиДанных.Равно,
			ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ЗадолженностьПоляАналитикиСчета());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ЗадолженностьРанееНеУчитываемаяПоляАналитикиСчетаРасчетов(), "ЗадолженностьРанееНеУчитываемая");
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьДокументПараметрыВопроса()
	
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ЗадатьВопрос", Ложь);
	ПараметрыВопроса.Вставить("ТекстВопроса",
		НСтр("ru = 'Заполнить документ по данным бухгалтерского учета?'") );
	
	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат ПараметрыВопроса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДокументОбработкаОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
	Иначе
		Объект.ДокументыСписанияКредиторскойЗадолженности.Очистить();
		Объект.Задолженность.Очистить();
	КонецЕсли;
	
	УстановитьОтборСтрокВТаблицеЗадолженность();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере(ДокументСписанияЗадолженности = Неопределено)
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Отказ = Документы.ВосстановлениеКредиторскойЗадолженности.ЗаполнитьПоДаннымУчета(Объект, ДокументСписанияЗадолженности);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗадолженностьЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеВДокументе()
	
	Возврат (Объект.ДокументыСписанияКредиторскойЗадолженности.Количество() > 0)
		ИЛИ (Объект.Задолженность.Количество() > 0);
	
КонецФункции

&НаКлиенте
Функция ОчиститьПлатежныеРеквизиты()
	
	Объект.СчетКонтрагента = "";
	Объект.БанковскаяКарта = "";
	Объект.НомерБанковскогоСчета = "";
	Объект.НомерКазначейскогоСчета = "";
	Объект.НомерЛицевогоСчета = "";
	Объект.НомерБанковскойКарты = "";
	Объект.НаименованиеБанка = "";
	Объект.БИКБанка = "";
	Объект.КоррСчетБанка = "";
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПлатежныеРеквизитыНаСервере()
	
	Если Объект.СпособОплатыНаличными Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантВозвратаСредств = 0 Тогда // На счет.
		
		Объект.НомерБанковскойКарты = "";
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БанковскиеИКазначейскиеСчета.Код КАК НомерСчета,
		|	БанковскиеИКазначейскиеСчета.КассовыйОрган КАК Банк,
		|	БанковскиеИКазначейскиеСчета.КассовыйОрган.Наименование КАК НаименованиеБанка,
		|	БанковскиеИКазначейскиеСчета.КассовыйОрган.Код КАК БИКБанка,
		|	БанковскиеИКазначейскиеСчета.КассовыйОрган.КоррСчет КАК КоррСчетБанка,
		|	БанковскиеИКазначейскиеСчета.ТипЛицевогоСчета КАК ТипЛицевогоСчета
		|ИЗ
		|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
		|ГДЕ
		|	БанковскиеИКазначейскиеСчета.Ссылка = &ВыбранныйСчет
		|	И БанковскиеИКазначейскиеСчета.Владелец = &Контрагент";
		Запрос.УстановитьПараметр("ВыбранныйСчет", Объект.СчетКонтрагента);
		Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ЗаполнитьЗначенияСвойств(Объект, Выборка, "НаименованиеБанка, БИКБанка, КоррСчетБанка");
			
			Если Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда
				Объект.НомерБанковскогоСчета = Выборка.НомерСчета;
			ИначеЕсли Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
				Объект.НомерЛицевогоСчета = Выборка.НомерСчета;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе // На карту.
		
		Объект.НомерБанковскогоСчета = "";
		Объект.НомерКазначейскогоСчета = "";
		Объект.НомерЛицевогоСчета = "";
		Объект.НаименованиеБанка = "";
		Объект.БИКБанка = "";
		Объект.КоррСчетБанка = "";
		
		Объект.НомерБанковскойКарты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.БанковскаяКарта, "Код");
		
	КонецЕсли;
	
КонецПроцедуры

