&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаИтогов = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	КонтрагентФизЛицо = ( ВидКонтрагента(Объект.Контрагент) = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") );
	
	Если ЗначениеЗаполнено(Объект.БанковскаяКарта) Тогда
		ВариантВозвратаСредств = 1; // На карту.
	КонецЕсли;
	
	ЗадолженностьЗаполнитьДобавленныеКолонки();
	ЗадолженностьРанееНеУчитываемаяЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВидДокумента", "Видимость", Форма.КонтрагентФизЛицо);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Кредитор", "Доступность", Объект.ЗаявительЯвляетсяПравопреемникомКредитора);
	
	ЭтоВосстановлениеЗадолженностиРанееНеУчитываемой = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Задолженность", "Видимость", Не ЭтоВосстановлениеЗадолженностиРанееНеУчитываемой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЗадолженностьРанееНеУчитываемая", "Видимость", ЭтоВосстановлениеЗадолженностиРанееНеУчитываемой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Заполнить", "Видимость", Не ЭтоВосстановлениеЗадолженностиРанееНеУчитываемой);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументыСписанияКредиторскойЗадолженностиДокументСписанияЗадолженности", "ПодсказкаВвода",
			?(ЭтоВосстановлениеЗадолженностиРанееНеУчитываемой, НСтр("ru = '<необязательно>'"), ""));
	
	ВариантыВозвратаСредств = Новый Массив;
	ВариантыВозвратаСредств.Добавить("ВариантВозвратаСредствНаСчет");
	ВариантыВозвратаСредств.Добавить("ВариантВозвратаСредствНаКарту");
	ВариантыВозвратаСредств.Добавить("СчетКонтрагента");
	ВариантыВозвратаСредств.Добавить("БанковскаяКарта");
	ВариантыВозвратаСредств.Добавить("НомерБанковскогоСчета");
	ВариантыВозвратаСредств.Добавить("НомерКазначейскогоСчета");
	ВариантыВозвратаСредств.Добавить("НомерЛицевогоСчета");
	ВариантыВозвратаСредств.Добавить("НомерБанковскойКарты");
	ВариантыВозвратаСредств.Добавить("НаименованиеБанка");
	ВариантыВозвратаСредств.Добавить("БИКБанка");
	ВариантыВозвратаСредств.Добавить("КоррСчетБанка");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ВариантыВозвратаСредств, "Доступность", Не Объект.СпособОплатыНаличными);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СчетКонтрагента", "Доступность", Не Объект.СпособОплатыНаличными И (Форма.ВариантВозвратаСредств = 0)); // На счет.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"БанковскаяКарта", "Доступность", Не Объект.СпособОплатыНаличными И (Форма.ВариантВозвратаСредств = 1)); // На карту.
	
	УстановитьВидимостьКонтроляЛБО(Форма);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Счета30300 = Новый СписокЗначений;
	Счета30300.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("303.00"));
	
	// Расчеты по договорам с контрагентами.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДоговор");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.СчетРасчетов", ВидСравненияКомпоновкиДанных.ВСписке, Счета30300);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДоговор");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.СчетРасчетов", ВидСравненияКомпоновкиДанных.ВСписке, Счета30300);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Вид налога, платежа для счетов 303.00.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьВидНалогаИлиПлатежа");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьНалогСборПлатеж");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.СчетРасчетов", ВидСравненияКомпоновкиДанных.НеВСписке, Счета30300);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяВидНалогаИлиПлатежа");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяНалогСборПлатеж");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.СчетРасчетов", ВидСравненияКомпоновкиДанных.НеВСписке, Счета30300);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Обязательный договор.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДоговор");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДоговор");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДоговорДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Договор", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Необязательный договор.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДоговор");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДоговор");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДоговорДоступность", ВидСравненияКомпоновкиДанных.Равно, 2);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Договор", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Нет договора.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДоговор");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДоговор");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДоговорДоступность", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Обязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДопСубконтоРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Необязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДопСубконтоРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 2);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Нет доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДопСубконтоРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРанееНеУчитываемаяДопСубконтоРасчетов");
