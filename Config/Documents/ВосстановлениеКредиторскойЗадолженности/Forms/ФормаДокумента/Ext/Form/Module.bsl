&НаСервере
Функция ПараметрыКонтроляЛБО()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("Период", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");

	Если Объект.Ссылка.Пустая() Тогда
		Основание = "Восстановление кредиторской задолженности " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + " (Новый)";
	Иначе
		Основание = Объект.Ссылка;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("Основание", Основание);
	
	ТабДок = Объект.Задолженность.Выгрузить(, "ИФО,КФО,КПС,КЭК,ВосстановитьСумма");
	ТабДок.Колонки.Найти("ВосстановитьСумма").Имя = "СуммаОбъект";
	ТабДок.ЗаполнитьЗначения(Объект.ИФО, "ИФО");
	ТабДок.Свернуть("ИФО,КФО,КПС,КЭК", "СуммаОбъект");
	
	ПараметрыФормы.Вставить("ХранилищеТаблицы", Новый ХранилищеЗначения(ТабДок));
	
	Возврат ПараметрыФормы;
		
КонецФункции	

