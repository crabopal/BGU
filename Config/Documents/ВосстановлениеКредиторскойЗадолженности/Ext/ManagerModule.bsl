#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Контрагент,
	ДокументОбъект.Контрагент,
	Форма.Элементы.ГруппаКонтрагент);
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Решение о восстановлении кредиторской задолженности (ф.0510446).
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор       = "ВосстановлениеКредиторскойЗадолженности_Форма0510446";
	КомандаПечати.Представление       = НСтр("ru = 'Решение о восстановлении кредиторской задолженности (ф.0510446)'");
	КомандаПечати.МенеджерПечати      = "Документ.ВосстановлениеКредиторскойЗадолженности";
	КомандаПечати.Порядок             = 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ВосстановлениеКредиторскойЗадолженности_Форма0510446") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ВосстановлениеКредиторскойЗадолженности_Форма0510446",
			"Решение о восстановлении кредиторской задолженности (ф.0510446)",
			ПечатьФормы0510446(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьФормы0510446(МассивОбъектов, ОбъектыПечати)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВосстановлениеКредиторскойЗадолженности.ПФ_MXL_Ф0510446");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб				= Истина;
	ТабДокумент.ОриентацияСтраницы		= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ВосстановлениеКредиторскойЗадолженности_ф0510446";
	
	ДанныеДляПечати = ПолучитьДанныеДляПечати(МассивОбъектов);
	ВыборкаШапка = ДанныеДляПечати.Шапка.Выбрать();
	ВыборкаЗадолженность = ДанныеДляПечати.Задолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл // Цикл по документам.
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбщиеСведенияПоДокументу = ДанныеДляПечати.ОбщиеСведения.Получить(ВыборкаШапка.Ссылка);
		
		ВывестиШапку(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу);
		
		ВывестиРаздел1ВосстанавливаемаяКредиторскаяЗадолженность(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность);
		ВывестиРаздел2СведенияОСписаннойКредиторскойЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность);
		ВывестиРаздел3ПлатежныеРеквизиты(Макет, ТабДокумент, ВыборкаШапка);
		
		ВывестиПодвал(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
		
	КонецЦикла;
	
	ТабДокумент.ВерхнийКолонтитул.Выводить			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа		= НСтр("ru='Форма 0510446 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ТекстыЗапросов     = Новый Массив;
	ИндексыРезультатов = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ИндексыРезультатов.Вставить("Шапка", ТекстыЗапросов.Количество());
	ТекстыЗапросов.Добавить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВосстановлениеКредиторскойЗадолженности.Ссылка КАК Ссылка,
	|	ВосстановлениеКредиторскойЗадолженности.Номер КАК пНомер,
	|	ВосстановлениеКредиторскойЗадолженности.Дата КАК пДата,
	|	ВосстановлениеКредиторскойЗадолженности.Организация КАК Организация,
	|	ВосстановлениеКредиторскойЗадолженности.Руководитель КАК Руководитель,
	|	ВосстановлениеКредиторскойЗадолженности.Ответственный КАК Ответственный,
	|	ВосстановлениеКредиторскойЗадолженности.ОтветственныйФинЭкономПодразделения КАК ОтветственныйФинЭкономПодразделения,
	|	ВосстановлениеКредиторскойЗадолженности.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И ВосстановлениеКредиторскойЗадолженности.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ ВосстановлениеКредиторскойЗадолженности.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ВосстановлениеКредиторскойЗадолженности.Контрагент.НаименованиеСокращенное
	|		ИНАЧЕ ВосстановлениеКредиторскойЗадолженности.Контрагент.Наименование
	|	КОНЕЦ КАК НаименованиеКонтрагента,
	|	ВосстановлениеКредиторскойЗадолженности.ИдентификаторПлательщика КАК ИдентификаторПлательщика,
	|	ВЫБОР
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.ВалютаРасчетов <> &ВалютаРегламентированногоУчета
	|			ТОГДА ВосстановлениеКредиторскойЗадолженности.ВалютаРасчетов.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодВалютыРасчетов,
	|	ВЫБОР
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.ВалютаРасчетов <> &ВалютаРегламентированногоУчета
	|			ТОГДА ВосстановлениеКредиторскойЗадолженности.ВалютаРасчетов.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НаименованиеВалютыРасчетов,
	|	ВЫБОР
	|		КОГДА ВосстановлениеКредиторскойЗадолженности.СпособОплатыНаличными
	|			ТОГДА ""наличными""
	|		ИНАЧЕ ""безналично""
	|	КОНЕЦ КАК СпособОплаты,
	|	ВосстановлениеКредиторскойЗадолженности.НомерБанковскогоСчета КАК НомерБанковскогоСчета,
	|	ВосстановлениеКредиторскойЗадолженности.НомерКазначейскогоСчета КАК НомерКазначейскогоСчета,
	|	ВосстановлениеКредиторскойЗадолженности.НомерЛицевогоСчета КАК НомерЛицевогоСчета,
	|	ВосстановлениеКредиторскойЗадолженности.НомерБанковскойКарты КАК НомерБанковскойКарты,
	|	ВосстановлениеКредиторскойЗадолженности.НаименованиеБанка КАК НаименованиеБанка,
	|	ВосстановлениеКредиторскойЗадолженности.БИКБанка КАК БИК,
	|	ВосстановлениеКредиторскойЗадолженности.КоррСчетБанка КАК КоррСчет,
	|	ВосстановлениеКредиторскойЗадолженности.ДокументОснованиеЗаявителя КАК ДокументОснованиеЗаявителя,
	|	ВосстановлениеКредиторскойЗадолженности.ДокументОснованиеЗаявителяНомер КАК ДокументОснованиеЗаявителяНомер,
	|	ВосстановлениеКредиторскойЗадолженности.ДокументОснованиеЗаявителяДата КАК ДокументОснованиеЗаявителяДата,
	|	ВосстановлениеКредиторскойЗадолженности.ЗаявительЯвляетсяПравопреемникомКредитора КАК ЗаявительЯвляетсяПравопреемникомКредитора,
	|	ВосстановлениеКредиторскойЗадолженности.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.ВосстановлениеКредиторскойЗадолженности КАК ВосстановлениеКредиторскойЗадолженности
	|ГДЕ
	|	ВосстановлениеКредиторскойЗадолженности.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер");
	
	ИндексыРезультатов.Вставить("Задолженность", ТекстыЗапросов.Количество());
	ТекстыЗапросов.Добавить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Задолженность.Ссылка КАК Ссылка,
	|	Задолженность.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Задолженность.НомерСтроки КАК КодСтроки,
	|	Задолженность.ДокументСписанияЗадолженности КАК ДокументСписанияЗадолженности,
	|	Задолженность.ИФО КАК ИФО,
	|	Задолженность.КФО КАК КФО,
	|	Задолженность.Подразделение КАК Подразделение,
	|	Задолженность.Счет КАК Счет,
	|	Задолженность.КПС КАК КПС,
	|	Задолженность.КЭК КАК КЭК,
	|	Задолженность.СчетРасчетов КАК СчетРасчетов,
	|	Задолженность.СчетРасчетов.БезДетализацииКОСГУ КАК СчетРасчетовБезДетализацииКОСГУ,
	|	Задолженность.Контрагент КАК Контрагент,
	|	Задолженность.Контрагент.ТипКонтрагента.Код КАК ТипКонтрагентаКод,
	|	ВЫБОР
	|		КОГДА Задолженность.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА Задолженность.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ Задолженность.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА Задолженность.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ Задолженность.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ Задолженность.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК НаименованиеКонтрагента,
	|	Задолженность.Договор КАК Договор,
	|	Задолженность.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	Задолженность.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	Задолженность.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	Задолженность.Договор.УИН КАК ДоговорУИН,
	|	УчетныеНомераОбязательств.УчетныйНомерОбязательства КАК УчетныйНомерОбязательства,
	|	Задолженность.ОснованиеВозникновенияЗадолженности КАК ОснованиеВозникновенияЗадолженности,
	|	Задолженность.ОснованиеВозникновенияЗадолженностиНомер КАК ОснованиеВозникновенияЗадолженностиНомер,
	|	Задолженность.ОснованиеВозникновенияЗадолженностиДата КАК ОснованиеВозникновенияЗадолженностиДата,
	|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
	|	Задолженность.Валюта КАК Валюта,
	|	Задолженность.Валюта.Код КАК КодВалюты,
	|	Задолженность.ОстатокСумма КАК СписаннаяЗадолженностьРуб,
	|	ВЫБОР
	|		КОГДА Задолженность.Валюта <> &ВалютаРегламентированногоУчета
	|			ТОГДА Задолженность.ОстатокСуммаВал
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СписаннаяЗадолженностьВал,
	|	Задолженность.ВосстановитьСумма КАК ЗадолженностьРуб,
	|	ВЫБОР
	|		КОГДА Задолженность.Валюта <> &ВалютаРегламентированногоУчета
	|			ТОГДА Задолженность.ВосстановитьСуммаВал
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЗадолженностьВал
	|ИЗ
	|	Документ.ВосстановлениеКредиторскойЗадолженности.Задолженность КАК Задолженность
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	|		ПО Задолженность.Договор = УчетныеНомераОбязательств.Обязательство
	|ГДЕ
	|	Задолженность.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	КодСтроки
	|ИТОГИ
	|	СУММА(СписаннаяЗадолженностьРуб),
	|	СУММА(ЗадолженностьРуб)
	|ПО
	|	Ссылка,
	|	ДокументСписанияЗадолженности");
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("Шапка",              Результаты[ИндексыРезультатов.Шапка]);
	ДанныеДляПечати.Вставить("Задолженность",      Результаты[ИндексыРезультатов.Задолженность]);
	
	// Добавим общие сведения для печати.
	ДанныеДляПечати.Вставить("ОбщиеСведения", 
		УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ВывестиШапку(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведения)
	
	ОбластьШапка         = Макет.ПолучитьОбласть("Шапка");
	ОбластьТитул1        = Макет.ПолучитьОбласть("Титул1");
	ОбластьТитулКредитор = Макет.ПолучитьОбласть("ТитулКредитор");
	
	ОбластьШапка.Параметры.ФИОРуководителя =
		Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Ложь, ВыборкаШапка.пДата);
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	ОбластьШапка.Параметры.ДолжностьРуководителя = ДанныеПодписанта.Должность;
	
	ОбластьТитул1.Параметры.Заполнить(ВыборкаШапка);
	
	ЗаполнитьЗначенияСвойств(ОбластьТитул1.Параметры, ОбщиеСведения,
		"НаименованиеОрганизации, НаименованиеОбособленногоПодразделения, НаименованиеСтруктурногоПодразделения, СтруктурноеПодразделение,
		|Учредитель, БюджетНаименование, КодРПБС, КодРПБСОбособленногоПодразделения, ГлаваБК, ОКТМО");
	
	РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьТитул1,
		"пНомер",ВыборкаШапка.пНомер, ВыборкаШапка.Ссылка, Неопределено, Истина);
	
	ОбластьТитул1.Параметры.ДатаСтрокой = Формат(ВыборкаШапка.пДата, "ДЛФ=ДД");
	
	ОбластьТитулКредитор.Параметры.Кредитор = ВыборкаШапка.НаименованиеКонтрагента;
	
	ОбластьТитулКредитор.Параметры.ДокументОснованиеЗаявителя      = ВыборкаШапка.ДокументОснованиеЗаявителя;
	ОбластьТитулКредитор.Параметры.ДокументОснованиеЗаявителяНомер = ВыборкаШапка.ДокументОснованиеЗаявителяНомер;
	ОбластьТитулКредитор.Параметры.ДокументОснованиеЗаявителяДата  = ВыборкаШапка.ДокументОснованиеЗаявителяДата;
	
	Если ВыборкаШапка.ЗаявительЯвляетсяПравопреемникомКредитора Тогда
		ОбластьТитулКредитор.Параметры.Правопреемник = НСтр("ru = 'правопреемник'");
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.Вывести(ОбластьТитул1);
	ТабДокумент.Вывести(ОбластьТитулКредитор);
	
КонецФункции

Функция ВывестиРаздел1ВосстанавливаемаяКредиторскаяЗадолженность(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность)
	
	ОбластьЗаголовокСведенияОЗадолженности = Макет.ПолучитьОбласть("ЗаголовокРаздела1ВосстанавливаемаяКредиторскаяЗадолженность");
	ОбластьЗаголовокТаблицыЗадолженности   = Макет.ПолучитьОбласть("ЗаголовокТаблицыЗадолженности");
	ОбластьСтрокаТаблицыЗадолженности      = Макет.ПолучитьОбласть("СтрокаТаблицыЗадолженности");
	ОбластьИтогПоРазделу1                  = Макет.ПолучитьОбласть("ИтогПоРазделу1");
	
	ВыборкаЗадолженность.Сбросить();
	ОтборСтрок = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
	Если ВыборкаЗадолженность.НайтиСледующий(ОтборСтрок) Тогда
		ВыборкаИтогиПоДокументамСписания = ВыборкаЗадолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		КоличествоСтрок = ВыборкаИтогиПоДокументамСписания.Количество();
	Иначе
		КоличествоСтрок = 0;
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьЗаголовокСведенияОЗадолженности);
	
	ОбластьЗаголовокТаблицыЗадолженности.Параметры.ЗаголовокЗадолженность = НСтр("ru = 'Восстанавливаемая задолженность'");
	ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
	
	ОбщийИтог = 0;
	
	Если КоличествоСтрок > 0 Тогда
		
		Пока ВыборкаИтогиПоДокументамСписания.Следующий() Цикл
			
			ВыборкаСтрок = ВыборкаИтогиПоДокументамСписания.Выбрать();
			Пока ВыборкаСтрок.Следующий() Цикл
				
				Попытка 
					
					Если НЕ ТабДокумент.ПроверитьВывод(ОбластьСтрокаТаблицыЗадолженности) Тогда
						ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
					КонецЕсли;
					
				Исключение
					//Сообщить("В системе не установлено ни одного принтера.");
				КонецПопытки;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.Заполнить(ВыборкаСтрок);
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.НаименованиеКонтрагента = ВыборкаШапка.НаименованиеКонтрагента;
				ОбластьСтрокаТаблицыЗадолженности.Параметры.ИдентификаторКонтрагента = ВыборкаШапка.ИдентификаторПлательщика;
				
				Если Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженности)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата) Тогда // Из реквизитов договора.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ДоговорВидОбязательства;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ДоговорНомерДоговора;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ДоговорДатаДоговора;
				Иначе // Из реквизитов документа.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ОснованиеВозникновенияЗадолженности;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата;
				КонецЕсли;
				
				ЭтоСчетРасчетовПоДоходам = БухгалтерскийУчет.СчетВИерархии(ВыборкаСтрок.СчетРасчетов, "205.00,209.00");
				Если ЭтоСчетРасчетовПоДоходам Тогда
					ОбластьСтрокаТаблицыЗадолженности.Параметры.УчетныйНомерОбязательства = СокрЛП(ВыборкаСтрок.ДоговорУИН);
				Иначе
					ОбластьСтрокаТаблицыЗадолженности.Параметры.УчетныйНомерОбязательства = СокрЛП(ВыборкаСтрок.УчетныйНомерОбязательства);
				КонецЕсли;
				
				Если ВыборкаСтрок.СчетРасчетовБезДетализацииКОСГУ Тогда
					КЭКУчета = "000";
				Иначе
					КЭКУчета = "00" + ВыборкаСтрок.ТипКонтрагентаКод;
				КонецЕсли;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.НомерСчета = СтрШаблон("%1 %2 %3 %4",
					СокрЛП(ВыборкаСтрок.КПС),
					СокрЛП(ВыборкаСтрок.КФО),
					СтрЗаменить(Строка(ВыборкаСтрок.СчетРасчетов), ".", " "),
					КЭКУчета);
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КодПоБК = ВыборкаСтрок.КПС;
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КОСГУ = ВыборкаСтрок.КЭК;
				
				ТабДокумент.Вывести(ОбластьСтрокаТаблицыЗадолженности);
				
				ОбщийИтог = ОбщийИтог + ВыборкаСтрок.ЗадолженностьРуб;
				
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		ТабДокумент.Вывести(ОбластьСтрокаТаблицыЗадолженности);
	КонецЕсли;
	
	ОбластьИтогПоРазделу1.Параметры.ЗадолженностьРуб = ОбщийИтог;
	ТабДокумент.Вывести(ОбластьИтогПоРазделу1);
	
КонецФункции

Функция ВывестиРаздел2СведенияОСписаннойКредиторскойЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность)
	
	ОбластьЗаголовокСведенияОЗадолженности = Макет.ПолучитьОбласть("ЗаголовокРаздел2СведенияОСписаннойКредиторскойЗадолженности");
	ОбластьЗаголовокТаблицыЗадолженности   = Макет.ПолучитьОбласть("ЗаголовокТаблицыЗадолженности");
	ОбластьСтрокаТаблицыЗадолженности      = Макет.ПолучитьОбласть("СтрокаТаблицыЗадолженности");
	ОбластьИтогПоДокументуСписания         = Макет.ПолучитьОбласть("ИтогПоДокументуСписания");
	ОбластьОбщийИтог                       = Макет.ПолучитьОбласть("ИтогПоРазделу2");
	
	ВыборкаЗадолженность.Сбросить();
	ОтборСтрок = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
	Если ВыборкаЗадолженность.НайтиСледующий(ОтборСтрок) Тогда
		ОбластьОбщийИтог.Параметры.Заполнить(ВыборкаЗадолженность);
		ВыборкаИтогиПоДокументамСписания = ВыборкаЗадолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		КоличествоСтрок = ВыборкаИтогиПоДокументамСписания.Количество();
	Иначе
		КоличествоСтрок = 0;
	КонецЕсли;
	
	ОбщийИтог = 0;
	НомерДокументаСписания = 0;
	
	Если КоличествоСтрок > 0 Тогда
		
		Пока ВыборкаИтогиПоДокументамСписания.Следующий() Цикл
			
			НомерДокументаСписания = НомерДокументаСписания + 1;
			
			ОбластьЗаголовокСведенияОЗадолженности.Параметры.Заполнить(ВыборкаИтогиПоДокументамСписания);
			ОбластьЗаголовокСведенияОЗадолженности.Параметры.НомерПодраздела = "2." + НомерДокументаСписания;
			
			Если ЗначениеЗаполнено(ВыборкаИтогиПоДокументамСписания.ДокументСписанияЗадолженности) Тогда
				МетаданныеДокумента = ВыборкаИтогиПоДокументамСписания.ДокументСписанияЗадолженности.Метаданные();
				Если МетаданныеДокумента.Имя = "СписаниеКредиторскойЗадолженности" Тогда
					РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаИтогиПоДокументамСписания.ДокументСписанияЗадолженности, "Номер, Дата, СчетУчета");
					ДокументСписанияЗадолженности = СтрШаблон(НСтр("ru = 'Решение о списании задолженности, невостребованной кредиторами 
						|со счета %1 № %2 от %3'"),
						СокрЛП(РеквизитыДокумента.СчетУчета),
						СокрЛП(РеквизитыДокумента.Номер),
						Формат(РеквизитыДокумента.Дата, "ДЛФ=Д"));
				Иначе
					РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаИтогиПоДокументамСписания.ДокументСписанияЗадолженности, "Номер, Дата");
					ДокументСписанияЗадолженности = СтрШаблон("%1 %2 от %3",
						МетаданныеДокумента.Синоним,
						СокрЛП(РеквизитыДокумента.Номер),
						Формат(РеквизитыДокумента.Дата, "ДЛФ=Д"));
				КонецЕсли;
			Иначе
				ДокументСписанияЗадолженности = "";
			КонецЕсли;
			ОбластьЗаголовокСведенияОЗадолженности.Параметры.ДокументСписанияЗадолженности = ДокументСписанияЗадолженности;
			
			ТабДокумент.Вывести(ОбластьЗаголовокСведенияОЗадолженности);
			
			ОбластьЗаголовокТаблицыЗадолженности.Параметры.ЗаголовокЗадолженность = НСтр("ru = 'Списанная задолженность'");
			ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
			
			ВыборкаСтрок = ВыборкаИтогиПоДокументамСписания.Выбрать();
			Пока ВыборкаСтрок.Следующий() Цикл
				
				Попытка 
					
					Если НЕ ТабДокумент.ПроверитьВывод(ОбластьСтрокаТаблицыЗадолженности) Тогда
						ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
					КонецЕсли;
					
				Исключение
					//Сообщить("В системе не установлено ни одного принтера.");
				КонецПопытки;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.Заполнить(ВыборкаСтрок);
				
				Если Не ВыборкаШапка.ЗаявительЯвляетсяПравопреемникомКредитора Тогда // Реквизиты Заявителя.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.НаименованиеКонтрагента = ВыборкаШапка.НаименованиеКонтрагента;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ИдентификаторКонтрагента = ВыборкаШапка.ИдентификаторПлательщика;
				Иначе // Невостребованная задолженность учтена по первоначальному кредитору.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.НаименованиеКонтрагента = ВыборкаСтрок.НаименованиеКонтрагента;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ИдентификаторКонтрагента = "";
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженности)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата) Тогда // Из реквизитов договора.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ДоговорВидОбязательства;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ДоговорНомерДоговора;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ДоговорДатаДоговора;
				Иначе // Из реквизитов документа.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ОснованиеВозникновенияЗадолженности;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата;
				КонецЕсли;
				
				ЭтоСчетРасчетовПоДоходам = БухгалтерскийУчет.СчетВИерархии(ВыборкаСтрок.СчетРасчетов, "205.00,209.00");
				Если ЭтоСчетРасчетовПоДоходам Тогда
					ОбластьСтрокаТаблицыЗадолженности.Параметры.УчетныйНомерОбязательства = СокрЛП(ВыборкаСтрок.ДоговорУИН);
				Иначе
					ОбластьСтрокаТаблицыЗадолженности.Параметры.УчетныйНомерОбязательства = СокрЛП(ВыборкаСтрок.УчетныйНомерОбязательства);
				КонецЕсли;
				
				Если ВыборкаСтрок.СчетРасчетовБезДетализацииКОСГУ Тогда
					КЭКУчета = "000";
				Иначе
					КЭКУчета = "00" + ВыборкаСтрок.ТипКонтрагентаКод;
				КонецЕсли;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.НомерСчета = СтрШаблон("%1 %2 %3 %4",
					СокрЛП(ВыборкаСтрок.КПС),
					СокрЛП(ВыборкаСтрок.КФО),
					СтрЗаменить(Строка(ВыборкаСтрок.СчетРасчетов), ".", " "),
					КЭКУчета);
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КодПоБК = ВыборкаСтрок.КПС;
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КОСГУ = ВыборкаСтрок.КЭК;
				
				Если ВыборкаШапка.ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой Тогда
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ЗадолженностьВал = ВыборкаСтрок.ЗадолженностьВал;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ЗадолженностьРуб = ВыборкаСтрок.ЗадолженностьРуб;
				Иначе
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ЗадолженностьВал = ВыборкаСтрок.СписаннаяЗадолженностьВал;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ЗадолженностьРуб = ВыборкаСтрок.СписаннаяЗадолженностьРуб;
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьСтрокаТаблицыЗадолженности);
				
				ОбщийИтог = ОбщийИтог + ВыборкаСтрок.СписаннаяЗадолженностьРуб;
				
			КонецЦикла;
			
			ОбластьИтогПоДокументуСписания.Параметры.ЗадолженностьРуб = ВыборкаИтогиПоДокументамСписания.СписаннаяЗадолженностьРуб;
			ТабДокумент.Вывести(ОбластьИтогПоДокументуСписания);
			
		КонецЦикла;
		
	Иначе
		
		ОбластьЗаголовокСведенияОЗадолженности.Параметры.НомерПодраздела = "2";
		ТабДокумент.Вывести(ОбластьЗаголовокСведенияОЗадолженности);
		
		ОбластьЗаголовокТаблицыЗадолженности.Параметры.ЗаголовокЗадолженность = НСтр("ru = 'Списанная задолженность'");
		ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
		
		ТабДокумент.Вывести(ОбластьСтрокаТаблицыЗадолженности);
		
	КонецЕсли;
	
	ОбластьОбщийИтог.Параметры.ЗадолженностьРуб = ОбщийИтог;
	ТабДокумент.Вывести(ОбластьОбщийИтог);
	
КонецФункции

Функция ВывестиРаздел3ПлатежныеРеквизиты(Макет, ТабДокумент, ВыборкаШапка)
	
	ОбластьЗаголовокРаздела3 = Макет.ПолучитьОбласть("ЗаголовокРаздела3ПлатежныеРеквизиты");
	ОбластьЗаголовокТаблицы  = Макет.ПолучитьОбласть("ЗаголовокТаблицыПлатежныеРеквизиты");
	ОбластьСтрокаТаблицы     = Макет.ПолучитьОбласть("СтрокаТаблицыПлатежныеРеквизиты");
	ОбластьПодвалТаблицы     = Макет.ПолучитьОбласть("ПодвалТаблицыПлатежныеРеквизиты");
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ВыборкаШапка);
	
	ОбластьСтрокаТаблицы.Параметры.НомерБанковскогоСчета = СокрЛП(ВыборкаШапка.НомерБанковскогоСчета);
	ОбластьСтрокаТаблицы.Параметры.НомерКазначейскогоСчета = СокрЛП(ВыборкаШапка.НомерКазначейскогоСчета);
	ОбластьСтрокаТаблицы.Параметры.НомерЛицевогоСчета = СокрЛП(ВыборкаШапка.НомерЛицевогоСчета);
	ОбластьСтрокаТаблицы.Параметры.НомерБанковскойКарты = СокрЛП(ВыборкаШапка.НомерБанковскойКарты);
	
	ТабДокумент.Вывести(ОбластьЗаголовокРаздела3);
	ТабДокумент.Вывести(ОбластьЗаголовокТаблицы);
	ТабДокумент.Вывести(ОбластьСтрокаТаблицы);
	ТабДокумент.Вывести(ОбластьПодвалТаблицы);
	
КонецФункции

Функция ВывестиПодвал(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведения)
	
	// Приложение.
	Файлы = УправлениеПечатьюБГУ.ПолучитьСписокФайловДокумента(ВыборкаШапка.Ссылка);
	Для Каждого Приложение Из Файлы Цикл
		ОбластьМакетаПриложение = Макет.ПолучитьОбласть("Приложение");
		ОбластьМакетаПриложение.Параметры.Заполнить(Приложение);
		ТабДокумент.Вывести(ОбластьМакетаПриложение);
	КонецЦикла;
	
	// Ответственный исполнитель.
	ОбластьМакетаОтветственныйИсполнитель = Макет.ПолучитьОбласть("ОтветственныйИсполнитель");
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ЗаголовокОтветственныйИсполнитель = НСтр("ru = 'Ответственный исполнитель'");
	ЗаполнитьЗначенияСвойств(ОбластьМакетаОтветственныйИсполнитель.Параметры, ОбщиеСведения,
		"ОтветственныйФИО, ОтветственныйДолжность, ОтветственныйТелефон, ОтветственныйЭлПочта");
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ДатаСтрокой = Формат(ВыборкаШапка.пДата, "ДЛФ=ДД");
	ТабДокумент.Вывести(ОбластьМакетаОтветственныйИсполнитель);
	
	// Ответственный исполнитель финансово-экономической службы.
	ОбластьМакетаОтветственныйИсполнитель = Макет.ПолучитьОбласть("ОтветственныйИсполнитель");
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Фамилия,Имя,Отчество,Должность",
		ВыборкаШапка.ОтветственныйФинЭкономПодразделения, "", "", "", "");
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ЗаголовокОтветственныйИсполнитель = НСтр("ru = 'Ответственный исполнитель финансово-экономической службы '");
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника);
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ОтветственныйДолжность = ДанныеСотрудника.Должность;
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ОтветственныйТелефон = ДанныеСотрудника.ТелефонРабочийФизическиеЛица;
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ОтветственныйЭлПочта = ДанныеСотрудника.EmailФизическиеЛица;
	ОбластьМакетаОтветственныйИсполнитель.Параметры.ДатаСтрокой = Формат(ВыборкаШапка.пДата, "ДЛФ=ДД");
	ТабДокумент.Вывести(ОбластьМакетаОтветственныйИсполнитель);
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОснованииСписанияКредиторскойЗадолженности(Объект, ДокументОснование, НомераСтрок = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",  ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КредиторскаяЗадолженность.Ссылка КАК ДокументОснование,
	|	КредиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	КредиторскаяЗадолженность.Договор КАК Договор,
	|	КредиторскаяЗадолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
	|	КредиторскаяЗадолженность.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	КредиторскаяЗадолженность.НалогСборПлатеж КАК НалогСборПлатеж,
	|	КредиторскаяЗадолженность.Счет КАК Счет,
	|	КредиторскаяЗадолженность.Счет.Забалансовый КАК СчетЗабалансовый,
	|	КредиторскаяЗадолженность.ИФО КАК ИФО,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.КЭК КАК КЭК,
	|	КредиторскаяЗадолженность.Подразделение КАК Подразделение,
	|	КредиторскаяЗадолженность.Валюта КАК Валюта,
	|	КредиторскаяЗадолженность.ОстатокСумма КАК ОстатокСумма,
	|	КредиторскаяЗадолженность.ОстатокСуммаВал КАК ОстатокСуммаВал,
	|	КредиторскаяЗадолженность.СписатьСумма КАК СписатьСумма,
	|	КредиторскаяЗадолженность.СписатьСуммаВал КАК СписатьСуммаВал,
	|	КредиторскаяЗадолженность.СрокНаблюдения КАК СрокНаблюдения,
	|	КредиторскаяЗадолженность.ОснованиеВозникновенияЗадолженности КАК ОснованиеВозникновенияЗадолженности,
	|	КредиторскаяЗадолженность.ОснованиеВозникновенияЗадолженностиНомер КАК ОснованиеВозникновенияЗадолженностиНомер,
	|	КредиторскаяЗадолженность.ОснованиеВозникновенияЗадолженностиДата КАК ОснованиеВозникновенияЗадолженностиДата
	|ПОМЕСТИТЬ СтрокиРешенияОСписании
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности.Задолженность КАК КредиторскаяЗадолженность
	|ГДЕ
	|	КредиторскаяЗадолженность.Ссылка = &Ссылка
	|	И &УсловиеПоНомерамСтрок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиРешенияОСписании.ДокументОснование.Организация КАК Организация,
	|	СтрокиРешенияОСписании.ДокументОснование.ВидОперации КАК ВидОперацииСписанияКредиторскойЗадолженности,
	|	СтрокиРешенияОСписании.ИФО КАК ИФО,
	|	СтрокиРешенияОСписании.Контрагент КАК Контрагент,
	|	СтрокиРешенияОСписании.Валюта КАК Валюта
	|ИЗ
	|	СтрокиРешенияОСписании КАК СтрокиРешенияОСписании
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиРешенияОСписании.ДокументОснование КАК ДокументОснование,
	|	СтрокиРешенияОСписании.НомерСтроки КАК НомерСтроки,
	|	СтрокиРешенияОСписании.Контрагент КАК Контрагент,
	|	СтрокиРешенияОСписании.Договор КАК Договор,
	|	СтрокиРешенияОСписании.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	СтрокиРешенияОСписании.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	СтрокиРешенияОСписании.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	СтрокиРешенияОСписании.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
	|	СтрокиРешенияОСписании.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	СтрокиРешенияОСписании.НалогСборПлатеж КАК НалогСборПлатеж,
	|	СтрокиРешенияОСписании.Счет КАК Счет,
	|	СтрокиРешенияОСписании.СчетЗабалансовый КАК СчетЗабалансовый,
	|	СтрокиРешенияОСписании.ИФО КАК ИФО,
	|	СтрокиРешенияОСписании.КФО КАК КФО,
	|	СтрокиРешенияОСписании.КПС КАК КПС,
	|	СтрокиРешенияОСписании.КЭК КАК КЭК,
	|	СтрокиРешенияОСписании.Подразделение КАК Подразделение,
	|	СтрокиРешенияОСписании.Валюта КАК Валюта,
	|	СтрокиРешенияОСписании.ОстатокСумма КАК ОстатокСумма,
	|	СтрокиРешенияОСписании.ОстатокСуммаВал КАК ОстатокСуммаВал,
	|	СтрокиРешенияОСписании.СписатьСумма КАК СписатьСумма,
	|	СтрокиРешенияОСписании.СписатьСуммаВал КАК СписатьСуммаВал,
	|	СтрокиРешенияОСписании.СрокНаблюдения КАК СрокНаблюдения,
	|	СтрокиРешенияОСписании.ОснованиеВозникновенияЗадолженности КАК ОснованиеВозникновенияЗадолженности,
	|	СтрокиРешенияОСписании.ОснованиеВозникновенияЗадолженностиНомер КАК ОснованиеВозникновенияЗадолженностиНомер,
	|	СтрокиРешенияОСписании.ОснованиеВозникновенияЗадолженностиДата КАК ОснованиеВозникновенияЗадолженностиДата
	|ИЗ
	|	СтрокиРешенияОСписании КАК СтрокиРешенияОСписании
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если НомераСтрок <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "КредиторскаяЗадолженность.НомерСтроки В(&НомераСтрок)");
		Запрос.УстановитьПараметр("НомераСтрок", НомераСтрок);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("КредиторскаяЗадолженность", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Задолженность", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ВидОперацииСписанияКредиторскойЗадолженности =
		Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением; // По умолчанию.
	
	// Реквизиты шапки.
	Шапка = Результат[НомераТаблиц.Шапка].Выбрать();
	Если Шапка.Следующий() Тогда
		
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Шапка.Организация;
		Если ИспользоватьУчетПоИФО Тогда
			Объект.ИФО = Шапка.ИФО;
		КонецЕсли;
		
		Объект.ВалютаРасчетов = Шапка.Валюта;
		Объект.Контрагент = Шапка.Контрагент;
		Объект.ИдентификаторПлательщика = БухгалтерскийУчет.ИдентификаторКонтрагента(Объект.Контрагент, Объект.ВидДокументаФизЛиц);
		
		ВидОперацииСписанияКредиторскойЗадолженности = Шапка.ВидОперацииСписанияКредиторскойЗадолженности; // Из документа списания КЗ.
		
		Если ВидОперацииСписанияКредиторскойЗадолженности = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			Объект.ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиУчитываемойНаЗабалансе;
		Иначе
			Объект.ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой;
		КонецЕсли;
		
	КонецЕсли;
	
	// Документ-основание списания кредиторской задолженности.
	НоваяСтрока = Объект.ДокументыСписанияКредиторскойЗадолженности.Добавить();
	НоваяСтрока.ДокументСписанияЗадолженности = ДокументОснование;
	
	// Задолженность.
	Задолженность = Результат[НомераТаблиц.Задолженность].Выбрать();
	Пока Задолженность.Следующий() Цикл
		
		НоваяСтрока = Объект.Задолженность.Добавить();
		НоваяСтрока.ДокументСписанияЗадолженности = ДокументОснование;
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Задолженность,
			"ИФО,КФО,КПС,Контрагент,Договор,ДопСубконтоРасчетов,Валюта,СрокНаблюдения");
		Если ИспользоватьУчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Задолженность.Подразделение;
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(Задолженность.Счет, "303.00") Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Задолженность, "ВидНалогаИлиПлатежа,НалогСборПлатеж");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Задолженность.ОснованиеВозникновенияЗадолженности)
			И Не ЗначениеЗаполнено(Задолженность.ОснованиеВозникновенияЗадолженностиНомер)
			И Не ЗначениеЗаполнено(Задолженность.ОснованиеВозникновенияЗадолженностиДата) Тогда // Из реквизитов договора.
			НоваяСтрока.ОснованиеВозникновенияЗадолженности      = Задолженность.ДоговорВидОбязательства;
			НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = Задолженность.ДоговорНомерДоговора;
			НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = Задолженность.ДоговорДатаДоговора;
		Иначе // Из реквизитов документа.
			НоваяСтрока.ОснованиеВозникновенияЗадолженности      = Задолженность.ОснованиеВозникновенияЗадолженности;
			НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = Задолженность.ОснованиеВозникновенияЗадолженностиНомер;
			НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = Задолженность.ОснованиеВозникновенияЗадолженностиДата;
		КонецЕсли;
		
		Если ВидОперацииСписанияКредиторскойЗадолженности = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			
			НоваяСтрока.Счет = БухгалтерскийУчет.СчетПоКоду("20", Объект.Дата, Объект.Организация);
			НоваяСтрока.КЭК = Задолженность.КЭК;
			
			НоваяСтрока.СчетРасчетов = Задолженность.Счет;
			
		ИначеЕсли ВидОперацииСписанияКредиторскойЗадолженности = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			
			Если БухгалтерскийУчет.СчетВИерархии(Задолженность.Счет, "303.00") Тогда
				НоваяСтрока.КЭК = Задолженность.КЭК;
			Иначе
				НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Задолженность.Счет);
			КонецЕсли;
			
			НоваяСтрока.СчетРасчетов = Задолженность.Счет;
			
		ИначеЕсли ВидОперацииСписанияКредиторскойЗадолженности = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			
			НоваяСтрока.КЭК = Задолженность.КЭК; // КЭК счета 20.
			
			// Если это Решение о списании с забалансоввых счетов (о прекращении наблюдения задолженности),
			// счета расчетов по умолчанию определяем по КЭК.
			Если БухгалтерскийУчет.КЭКВИерархии(НоваяСтрока.КЭК, "100") Тогда
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
					"205.00", Ложь, Объект.Дата, Объект.Организация, Объект.ИФО, НоваяСтрока.КПС);
			Иначе
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
					"302.00", Ложь, Объект.Дата, Объект.Организация, Объект.ИФО);
			КонецЕсли;
			
		КонецЕсли;
		
		// По умолчанию восстанавливаем столько же, скольки списали по документу-основанию.
		НоваяСтрока.ОстатокСумма         = Задолженность.СписатьСумма;
		НоваяСтрока.ОстатокСуммаВал      = Задолженность.СписатьСуммаВал;
		НоваяСтрока.ВосстановитьСумма    = НоваяСтрока.ОстатокСумма;
		НоваяСтрока.ВосстановитьСуммаВал = НоваяСтрока.ОстатокСуммаВал;
		
	КонецЦикла;
	
КонецФункции

Функция ЗаполнитьПоДаннымУчета(Объект, ДокументСписанияЗадолженности = Неопределено) Экспорт
	
	Отказ = Ложь;
	
	Если Объект.ЗаявительЯвляетсяПравопреемникомКредитора Тогда
		Контрагент = Объект.Кредитор; // Первоначальный кредитор, по которому отбираются данные о списанной кредиторской задолженности.
	Иначе
		Контрагент = Объект.Контрагент; // Контрагент - заявитель.
	КонецЕсли;
	
	ЗаполнитьДокументыСписанияЗадолженности = (ДокументСписанияЗадолженности = Неопределено);
	Если ЗаполнитьДокументыСписанияЗадолженности Тогда
		
		Объект.ДокументыСписанияКредиторскойЗадолженности.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация",  Объект.Организация);
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Счета20",      БухгалтерскийУчет.СписокСчетов("20"));
		Запрос.УстановитьПараметр("Контрагент",   Контрагент);
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОборотыСчета20.Регистратор КАК ДокументСписанияЗадолженности
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
		|			,
		|			&КонецПериода,
		|			Регистратор,
		|			СчетДт В (&Счета20),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
		|			,
		|			,
		|			Организация = &Организация
		|				И &УсловиеПоИФО) КАК ОборотыСчета20
		|ГДЕ
		|	ОборотыСчета20.СубконтоДт1 = &Контрагент";
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО = &ИФО");
			Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
		КонецЕсли;
		
		Объект.ДокументыСписанияКредиторскойЗадолженности.Загрузить(
			Запрос.Выполнить().Выгрузить());
		
	КонецЕсли;
	
	ЗаполнитьЗадолженность = Истина;
	Если ЗаполнитьЗадолженность Тогда
		
		ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		
		Если ДокументСписанияЗадолженности = Неопределено Тогда
			
			Объект.Задолженность.Очистить();
			
			ДокументыСписанияКредиторскойЗадолженности =
				Объект.ДокументыСписанияКредиторскойЗадолженности.Выгрузить().ВыгрузитьКолонку("ДокументСписанияЗадолженности");
			
		Иначе // Заполнение по выбранному документу списания задолженности.
			
			ОтборПоДокументуСписанияЗадолженности = Новый Структура("ДокументСписанияЗадолженности", ДокументСписанияЗадолженности);
			СтрокиПоДокументуСписанияЗадолженности = Объект.Задолженность.НайтиСтроки(ОтборПоДокументуСписанияЗадолженности);
			Для Каждого СтрокаЗадолженность Из СтрокиПоДокументуСписанияЗадолженности Цикл
				Объект.Задолженность.Удалить(Объект.Задолженность.Индекс(СтрокаЗадолженность));
			КонецЦикла;
			
			ДокументыСписанияКредиторскойЗадолженности = Новый Массив;
			ДокументыСписанияКредиторскойЗадолженности.Добавить(ДокументСписанияЗадолженности);
			
		КонецЕсли;
		
		СчетаУчетаЗадолженности = СчетаУчетаКредиторскойЗадолженности(ДокументыСписанияКредиторскойЗадолженности);
		СписаннаяКредиторскаяЗадолженность = БухгалтерскийУчет.ПроводкиДокументов(
			ДокументыСписанияКредиторскойЗадолженности, "20", "Дт").Выгрузить();
		
		Для Каждого СтрокаСписаннаяЗадолженность Из СписаннаяКредиторскаяЗадолженность Цикл
			
			АналитикаСписаннойЗадолженности = Новый Структура;
			Если СтрокаСписаннаяЗадолженность.ВидСубконтоДт1 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
				И ЗначениеЗаполнено(СтрокаСписаннаяЗадолженность.СубконтоДт1) Тогда
				АналитикаСписаннойЗадолженности.Вставить("Контрагент", СтрокаСписаннаяЗадолженность.СубконтоДт1);
			КонецЕсли;
			Если СтрокаСписаннаяЗадолженность.ВидСубконтоДт2 = ПланыВидовХарактеристик.ВидыСубконто.Договоры
				И ЗначениеЗаполнено(СтрокаСписаннаяЗадолженность.СубконтоДт2) Тогда
				АналитикаСписаннойЗадолженности.Вставить("Договор", СтрокаСписаннаяЗадолженность.СубконтоДт2);
			КонецЕсли;
			
			Если Не АналитикаСписаннойЗадолженности.Свойство("Контрагент")
				ИЛИ Контрагент <> АналитикаСписаннойЗадолженности.Контрагент Тогда
				Продолжить; // Задолженность другого контрагента.
			КонецЕсли;
			
			Если ИспользоватьУчетПоПодразделениям
				И ЗначениеЗаполнено(Объект.Подразделение)
				И СтрокаСписаннаяЗадолженность.ПодразделениеДт <> Объект.Подразделение Тогда
				Продолжить; // Отбор активен, только если заполнено Подразделение в шапке документа.
			КонецЕсли;
			
			Если ИспользоватьВалютныйУчет
				И ЗначениеЗаполнено(Объект.ВалютаРасчетов)
				И Объект.ВалютаРасчетов <> ВалютаРегламентированногоУчета
				И СтрокаСписаннаяЗадолженность.ВалютаДт <> Объект.ВалютаРасчетов Тогда
				Продолжить; // Расчеты в другой валюте.
			КонецЕсли;
			
			НоваяСтрока = Объект.Задолженность.Добавить();
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
			НоваяСтрока.ДокументСписанияЗадолженности = СтрокаСписаннаяЗадолженность.Регистратор;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписаннаяЗадолженность, "ИФО,КФО");
			
			НоваяСтрока.Счет = СтрокаСписаннаяЗадолженность.СчетДт;
			НоваяСтрока.КПС  = СтрокаСписаннаяЗадолженность.КПСДт;
			НоваяСтрока.КЭК  = СтрокаСписаннаяЗадолженность.КЭКДт;
			
			НоваяСтрока.Контрагент = Контрагент;
			Если АналитикаСписаннойЗадолженности.Свойство("Договор") Тогда
				НоваяСтрока.Договор = АналитикаСписаннойЗадолженности.Договор;
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					НоваяСтрока.Договор, "ВидОбязательства,НомерДоговора,ДатаДоговора");
				НоваяСтрока.ОснованиеВозникновенияЗадолженности      = РеквизитыДоговора.ВидОбязательства;
				НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = РеквизитыДоговора.НомерДоговора;
				НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = РеквизитыДоговора.ДатаДоговора;
			КонецЕсли;
			
			Если ИспользоватьУчетПоПодразделениям
				И ЗначениеЗаполнено(СтрокаСписаннаяЗадолженность.ПодразделениеДт) Тогда
				НоваяСтрока.Подразделение = СтрокаСписаннаяЗадолженность.ПодразделениеДт;
			КонецЕсли;
			
			НоваяСтрока.ОстатокСумма = СтрокаСписаннаяЗадолженность.Сумма;
			
			Если НЕ ЗначениеЗаполнено(СтрокаСписаннаяЗадолженность.ВалютаДт) Тогда
				НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
				НоваяСтрока.ОстатокСуммаВал = 0;
			Иначе
				НоваяСтрока.Валюта = СтрокаСписаннаяЗадолженность.ВалютаДт;
				НоваяСтрока.ОстатокСуммаВал = СтрокаСписаннаяЗадолженность.ВалютнаяСуммаДт;
			КонецЕсли;
			
			НоваяСтрока.ВосстановитьСумма    = НоваяСтрока.ОстатокСумма;
			НоваяСтрока.ВосстановитьСуммаВал = НоваяСтрока.ОстатокСуммаВал;
			
			СчетУчетаЗадолженности = СчетаУчетаЗадолженности.Получить(СтрокаСписаннаяЗадолженность.Регистратор);
			Если ЗначениеЗаполнено(СчетУчетаЗадолженности) Тогда // Счет, указанный в шапке документа списания задолженности.
				Если ТипЗнч(СчетУчетаЗадолженности) = Тип("ПланСчетовСсылка.ЕПСБУ") И Не СчетУчетаЗадолженности.ЭлементГруппа Тогда
					НоваяСтрока.СчетРасчетов = СчетУчетаЗадолженности;
				Иначе
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
						СчетУчетаЗадолженности, Ложь, Объект.Дата, Объект.Организация, Объект.ИФО, НоваяСтрока.КПС);
				КонецЕсли;
			Иначе // Для ручных операций по умолчанию 302.хх.
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
					"302.00", Ложь, Объект.Дата, Объект.Организация, Объект.ИФО);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

Функция СчетаУчетаКредиторскойЗадолженности(ДокументыСписанияКредиторскойЗадолженности)
	
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	 |	СписаниеКредиторскойЗадолженности.Ссылка КАК Документ,
	 |	СписаниеКредиторскойЗадолженности.СчетУчета КАК СчетУчета
	 |ИЗ
	 |	Документ.СписаниеКредиторскойЗадолженности КАК СписаниеКредиторскойЗадолженности
	 |ГДЕ
	 |	СписаниеКредиторскойЗадолженности.Ссылка В(&ДокументыСписанияКредиторскойЗадолженности)";
	 Запрос.УстановитьПараметр("ДокументыСписанияКредиторскойЗадолженности", ДокументыСписанияКредиторскойЗадолженности);
	 
	 СчетаУчетаКредиторскойЗадолженности = Новый Соответствие;
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
	 	СчетаУчетаКредиторскойЗадолженности.Вставить(Выборка.Документ, Выборка.СчетУчета);
	 КонецЦикла;
	 
	 Возврат СчетаУчетаКредиторскойЗадолженности;
	
КонецФункции

#КонецОбласти

#КонецОбласти

