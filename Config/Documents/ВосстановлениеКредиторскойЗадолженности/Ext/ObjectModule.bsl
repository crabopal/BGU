#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокументОснование = Неопределено;
		ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование);
		Если ЗначениеЗаполнено(ДокументОснование)
			И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеКредиторскойЗадолженности") Тогда
			
			Документы.ВосстановлениеКредиторскойЗадолженности.ЗаполнитьНаОснованииСписанияКредиторскойЗадолженности(ЭтотОбъект,
				ДокументОснование, ДанныеЗаполнения.НомераСтрокРешенияОСписании);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если Не ЗаявительЯвляетсяПравопреемникомКредитора Тогда
		НепроверяемыеРеквизиты.Добавить("Кредитор");
	КонецЕсли;
	
	Если Не СпособОплатыНаличными Тогда // Безналично.
		Если НЕ ЗначениеЗаполнено(НомерБанковскогоСчета)
			И НЕ ЗначениеЗаполнено(НомерКазначейскогоСчета)
			И НЕ ЗначениеЗаполнено(НомерЛицевогоСчета)
			И НЕ ЗначениеЗаполнено(НомерБанковскойКарты) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнены реквизиты заявителя: номер банковского (казначейского, лицевого) счета, банковской карты.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "НомерБанковскогоСчета", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Если ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиУчитываемойНаЗабалансе Тогда
		
		РеквизитыСчетаУчетаЗадолженности = Новый Структура("Счет, КПС, Подразделение",
			"Счет", "КПС", "Подразделение");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчетаЗадолженности,
			ЭтотОбъект, "Задолженность", Отказ);
		
		Для Каждого СтрокаТаблицы Из Задолженность Цикл
			
			Если ЗначениеЗаполнено(ДокументОснованиеЗаявителяДата)
				И ЗначениеЗаполнено(СтрокаТаблицы.СрокНаблюдения)
				И НачалоДня(ДокументОснованиеЗаявителяДата) > НачалоДня(СтрокаТаблицы.СрокНаблюдения) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Дата документа-основания требования Заявителя %1 превышает дату завершения срока наблюдения задолженности %2'"),
					Формат(ДокументОснованиеЗаявителяДата, "ДЛФ=Д"),
					Формат(СтрокаТаблицы.СрокНаблюдения, "ДЛФ=Д") );
				ПолеОшибки = "Задолженность[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СрокНаблюдения";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой Тогда
		
		РеквизитыСчетаУчетаЗадолженности = Новый Структура("Счет, КПС, Подразделение",
			"СчетРасчетов", "КПС", "Подразделение");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчетаЗадолженности,
			ЭтотОбъект, "Задолженность", Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Для Каждого СтрокаЗадолженность Из Задолженность Цикл
			СтрокаЗадолженность.ИФО = ЭтотОбъект.ИФО;
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Задолженность.Итог("ВосстановитьСумма");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
