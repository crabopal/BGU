&НаСервере
Процедура ВвестиНаОсновании(ДокументОснования, Разделитель)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.ТребованиеНакладнаяОС"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента",
		ДокументОснования, Разделитель, Истина, Неопределено);
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
