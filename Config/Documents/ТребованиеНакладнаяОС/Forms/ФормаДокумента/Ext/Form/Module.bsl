Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧ(Команда)
	Реквизиты = Новый Структура;
	
	Реквизиты.Вставить("Примечание");
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
		"ТребованиеНакладнаяОС", "ОсновныеСредства", "ОсновныеСредства", Реквизиты);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработкаИзмененияЦМООтправителя(Результат, ДополнительныеПараметры) Экспорт                
	УправлениеНФАКлиент.ЗаполнитьПодразделениеСотрудникаЦМО(Объект, Объект.ЦМООтправитель, Объект.Дата, "ПодразделениеОтправитель");
КонецПроцедуры	

&НаСервере
Процедура УстановитьРуководителя()

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), Объект.Организация,
		Объект.Дата, Объект.ПодразделениеОтправитель);

	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаКлиенте
