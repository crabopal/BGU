#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры

// Возвращает таблицу значений по данным табличной части документа для формирования резерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДокументОснованиеДата) 
		И ЭтотОбъект.ДокументОснованиеДата > ЭтотОбъект.Дата Тогда
		ТекстСообщения = НСтр("ru = 'Дата документа-основания на закладке ""Дополнительно"" больше даты документа'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ДокументОснованиеДата","Объект.ДокументОснованиеДата", Отказ);
	КонецЕсли;	
	
	Если ВидОперацииДокумента = 1 Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка заполненого инвентарного номера
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновныеСредства"	, ОсновныеСредства);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Выразить(ОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ОС1
	|ИЗ
	|	&ОсновныеСредства КАК ОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	ВТ_ОС1 КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|	И ОсновныеСредства.ОсновноеСредство.ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости
	|ПОМЕСТИТЬ ВТ_ПараметрыАмортизации
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство
	|		ИЗ
	|			ВТ_ОС КАК ВТ)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
	|ПОМЕСТИТЬ ВТ_УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство
	|		ИЗ
	|			ВТ_ОС КАК ВТ)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизации КАК ВТ_ПараметрыАмортизации
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_ПараметрыАмортизации.ОсновноеСредство
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_УчетныеДанные КАК ВТ_УчетныеДанные
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_УчетныеДанные.ОсновноеСредство
	|ГДЕ
	|	(ВТ_ПараметрыАмортизации.ПорядокПогашенияСтоимости <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
	|	ИЛИ ВТ_УчетныеДанные.ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.НедвижимоеИмущество))";
	
	СписокОС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	ШаблонСообщения = НСтр("ru = 'В строке %1 не заполнен инвентарный номер.'");
	ШаблонПоля = "Объект.ОсновныеСредства[%1].ИнвентарныйНомер";
	
	Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер)
			И СписокОС.Найти(СтрокаТаблицы.ОсновноеСредство) <> Неопределено Тогда
			
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СтрокаТаблицы.НомерСтроки);
			Поле = СтрШаблон(ШаблонПоля, СтрокаТаблицы.НомерСтроки - 1);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, Поле,, Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	// Проверка состояния инвентарных объектов (уже введен, списан)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выразить(ОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ОС1
	|ИЗ
	|	&ОсновныеСредства КАК ОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	ВТ_ОС1 КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.ОсновноеСредство.ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ПринятоКУчету,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ВведеноВЭксплуатацию,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК Списано
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация
	|	И (ОсновноеСредство, ИнвНомер) В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство,
	|			ВТ.ИнвентарныйНомер
	|		ИЗ
	|			ВТ_ОС КАК ВТ)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ВТ_События.ПринятоКУчету, ЛОЖЬ) КАК ПринятоКУчету,
	|	ЕСТЬNULL(ВТ_События.ВведеноВЭксплуатацию, ЛОЖЬ) КАК ВведеноВЭксплуатацию,
	|	ЕСТЬNULL(ВТ_События.Списано, ЛОЖЬ) КАК Списано
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_События КАК ВТ_События
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_События.ОсновноеСредство
	|		И ВТ_ОС.ИнвентарныйНомер = ВТ_События.ИнвентарныйНомер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = НСтр("ru='%1 инв.№%2 %3'");
		Если Выборка.Списано И ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			// Если инвентарный номер не заполнен, то это ОС малоценное, и может иметь групповой количественный учет
			// Соответственно, наличие статуса "Списано" не означает, что такого ОС не будет в остатках, т.к. списано может 
			// быть только часть количества.			
			ПричинаОшибки = НСтр("ru='уже списано'");;
		ИначеЕсли Выборка.ВведеноВЭксплуатацию Тогда
			ПричинаОшибки = НСтр("ru='уже введено в эксплуатацию'");
		ИначеЕсли Не Выборка.ПринятоКУчету Тогда
			ПричинаОшибки = НСтр("ru='еще не принято к учету'");
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			Выборка.ОсновноеСредство, Выборка.ИнвентарныйНомер, ПричинаОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		
	КонецЦикла;
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") И ДанныеЗаполнения.ВводНаОсновании
			И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
				ЗаполнитьНаОсновании_РешениеОПризнанииОбъектовОС(ДанныеЗаполнения);
				СтандартнаяОбработка = Ложь;  
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ЗаполнитьНаОсновании_РешениеОПризнанииОбъектовОС(ДанныеЗаполнения)
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокОснование = ДанныеЗаполнения.ДокументОснование;

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Организация КАК Организация,
	|	Шапка.ИФО КАК ИФО
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Количество = 0
	|			ТОГДА ОсновныеСредства.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ОсновныеСредства.Сумма / ОсновныеСредства.Количество КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК Цена,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Ссылка.КФО КАК КФО,
	|	ОсновныеСредства.Ссылка.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДрагоценныеМатериалы.ОсновноеСредство КАК ОбъектНФА,
	|	ДрагоценныеМатериалы.ИнвентарныйНомер КАК ИнвНомер,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка = &Ссылка"; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	ДокументОснование = ДокОснование;
	
	Результат = Запрос.ВыполнитьПакет();
	Шапка = Результат[0].Выбрать();
	ТЧОС  = Результат[1].Выбрать();
	ТЧДМ  = Результат[2].Выбрать();

	Если Шапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Шапка);
	КонецЕсли;	
	
	ОсновныеСредства.Очистить();
	Пока ТЧОС.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТЧОС);
	КонецЦикла;	

	ДрагоценныеМатериалы.Очистить();
	Пока ТЧДМ.Следующий() Цикл
		НоваяСтрока = ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТЧДМ);
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбъектНФА,
				ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	ДрагМатериалыДокумента.ОбъектНФА КАК ОбъектНФА,
	|	ДрагМатериалыДокумента.ИнвНомер КАК ИнвНомер,
	|	ДрагМатериалыДокумента.МассаДМ КАК МассаДМ,
	|	ДрагМатериалыДокумента.КоличествоДМ КАК КоличествоДМ
	|ПОМЕСТИТЬ ДрагМатериалыДокумента
	|ИЗ
	|	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	ОбъектыДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбъектыДокумента.ИнвентарныйНомер КАК ИнвНомер
	|ПОМЕСТИТЬ ОбъектыДокумента
	|ИЗ
	|	&ОбъектыДокумента КАК ОбъектыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыНФАДокумента.Организация КАК Организация,
	|	ОбъектыНФАДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбъектыНФАДокумента.ИнвНомер КАК ИнвНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
	|				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьДрагМатериалы
	|ПОМЕСТИТЬ ОбъектыНФАДокумента
	|ИЗ
	|	ОбъектыДокумента КАК ОбъектыНФАДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	|		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
	|			И ОбъектыНФАДокумента.ОсновноеСредство = ДрагМатериалыДокумента.ОбъектНФА
	|			И ОбъектыНФАДокумента.ИнвНомер = ДрагМатериалыДокумента.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК ИнвНомер,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	|	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
	|ИЗ
	|	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	|		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.ОсновноеСредство)
	|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
	|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер = ОбъектыНФАДокумента.ИнвНомер)
	|ГДЕ
	|	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
	|	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер, МассаДМ, КоличествоДМ");
	ТаблицаОбъектовНФА = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ОбъектНФА, Выборка.ИнвНомер);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(
		ОсновныеСредства.ВыгрузитьКолонку("СчетУчета"));
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Для каждого СтрокаТЧ из ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, КФО, Количество, Сумма, НомерСтроки");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация");

		НоваяСтрока.ЦМО = ЦМООтправитель;
		НоваяСтрока.ПередачаЧастейОбъектов = Ложь;
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		Если СтрокаСчета.УчетПоКПС Тогда
			НоваяСтрока.КПС = СтрокаТЧ.КПС;
		КонецЕсли;	
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = ПодразделениеОтправитель;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	// Теперь нужно заполнить ДопАналитику по остаткам, если она есть на счетах. Например, если передача идет
	// по счетам 111.60, то там может быть договор	
	УправлениеОсновнымиСредствами.ЗаполнитьДопАналитикуВТаблицеСписанияОС(ТабСчетов, ТаблицаДока, ЭтотОбъект);
	
	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	
	ТаблицаДока = ТаблицаСписанияОС();

	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(
	ТаблицаДока, ЭтотОбъект, Ложь);
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецЕсли