#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Цена");
	ИменаРеквизитов.Добавить("Сумма");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	ИменаСкрываемыхКнопок = Новый Массив;
	ИменаСкрываемыхКнопок.Добавить("ОсновныеСредстваРассчитатьСтоимость");
	Результат.Вставить("ИменаСкрываемыхКнопок", ИменаСкрываемыхКнопок);
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаШапкиДляПечатиТребованияНакладной0510451() Экспорт
	
	Возврат
	"ВЫБРАТЬ
	|	ТребованиеНакладнаяОС.Ссылка КАК Ссылка,
	|	ТребованиеНакладнаяОС.Номер КАК Номер,
	|	ТребованиеНакладнаяОС.Дата КАК Дата,
	|	ТребованиеНакладнаяОС.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТребованиеНакладнаяОС.ПодразделениеОтправитель.НаименованиеПолное <> """"
	|			ТОГДА ТребованиеНакладнаяОС.ПодразделениеОтправитель.НаименованиеПолное
	|		ИНАЧЕ ТребованиеНакладнаяОС.ПодразделениеОтправитель.Наименование
	|	КОНЕЦ КАК НаименованиеОтправитель,
	|	ТребованиеНакладнаяОС.ЦМООтправитель.Сотрудник КАК СотрудникОтправитель,
	|	ТребованиеНакладнаяОС.ЦМООтправитель.МестоХранения КАК МестоХраненияОтправитель,
	|	ВЫБОР
	|		КОГДА ТребованиеНакладнаяОС.ПодразделениеПолучатель.НаименованиеПолное <> """"
	|			ТОГДА ТребованиеНакладнаяОС.ПодразделениеПолучатель.НаименованиеПолное
	|		ИНАЧЕ ТребованиеНакладнаяОС.ПодразделениеПолучатель.Наименование
	|	КОНЕЦ КАК НаименованиеПолучатель,
	|	ТребованиеНакладнаяОС.ЦМОПолучатель.Сотрудник КАК СотрудникПолучатель,
	|	ТребованиеНакладнаяОС.ЦМОПолучатель.МестоХранения КАК МестоХраненияПолучатель,
	|	ТребованиеНакладнаяОС.ДокументОснованиеВид КАК ДокументОснование,
	|	ТребованиеНакладнаяОС.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ТребованиеНакладнаяОС.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ТребованиеНакладнаяОС.Затребовал КАК Затребовал,
	|	ТребованиеНакладнаяОС.ОтпускРазрешил КАК ОтпускРазрешил,
	|	ТребованиеНакладнаяОС.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ТребованиеНакладнаяОС.ИФО КАК ИФО,
	|	ТребованиеНакладнаяОС.Руководитель КАК УполномоченноеЛицо,
	|	ИСТИНА КАК СуммаУказанаВДокументе
	|ИЗ
	|	Документ.ТребованиеНакладнаяОС КАК ТребованиеНакладнаяОС
	|ГДЕ
	|	ТребованиеНакладнаяОС.Ссылка В (&МассивОбъектов)";
	
КонецФункции

Функция ТекстЗапросаТаблицДляПечатиТребованияНакладной0510451() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НФАНаименование,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ОсновныеСредства.ИнвентарныйНомер.Код
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НоменклатурныйНомер
	|	КОНЕЦ КАК НомерНоменклатурный,
	|	ОсновныеСредства.ИнвентарныйНомер.НомерПаспорта КАК НомерПаспорта,
	|	ЕдИзм.Код КАК ЕдИзмКод,
	|	ЕдИзм.НаименованиеПолное КАК ЕдИзмНаименование,
	|	ОсновныеСредства.Количество КАК Затребовано,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Цена КАК Цена,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство.Код КАК НФАКод
	|ИЗ
	|	Документ.ТребованиеНакладнаяОС.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдИзм
	|		ПО (ЕдИзм.Ссылка = &ЕдИзмШт)
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу разделителей для формирования документа "Требование-накладная (Основные средства)"
// на основании документа "Решение о признании объектов нефинансовых активов"                  
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.РешениеОПризнанииОбъектовОС - документ-основание
//
// Возвращаемое значение: 
// 	- ТаблицаЗначений - таблица с полями:
//    * ЦМО - СправочникСсылка.ЦМО
//    * Подразделение - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РешениеОПризнанииОбъектовОС.ЦМО КАК ЦМООтправитель,
	|	РешениеОПризнанииОбъектовОС.Подразделение КАК ПодразделениеОтправитель
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС КАК РешениеОПризнанииОбъектовОС
	|ГДЕ
	|	РешениеОПризнанииОбъектовОС.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);

	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, Резервировать");
	
	Если ЗначенияРеквизитов.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ЗначенияРеквизитов.Вставить("Дата", ДатаПроведения);
	КонецЕсли;	
	УчетНаСчете21ВУсловнойОценке = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата).УчетНаСчете21ВУсловнойОценке;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"					, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"				, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("НазваниеДокумента"		, "Требование - накладная");
	Запрос.УстановитьПараметр("УчетПоПодразделениям"	, УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	Запрос.УстановитьПараметр("Учет21ВУсловнойОценке"	, УчетНаСчете21ВУсловнойОценке);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМООтправитель КАК ЦМООтправитель,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.ПодразделениеОтправитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.ПодразделениеПолучатель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеПолучатель,
	|	ТаблицаОсновныеСредства.Ссылка.ВидОперацииДокумента КАК ВидОперацииДокумента,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.ПервичныйДокумент.ВидПервичногоДокумента
	|		ИНАЧЕ &НазваниеДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ТребованиеНакладнаяОС.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_ПараметрыАмортизации
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ТаблицаОсновныеСредства КАК ВТ)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних";
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию) КАК Событие,
	|	&Период КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.Номер КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаДокумента
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И ТаблицаОсновныеСредства.ВидОперацииДокумента = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание),
	|	&Период,
	|	ТаблицаОсновныеСредства.НазваниеДокумента,
	|	ТаблицаОсновныеСредства.Номер,
	|	ТаблицаОсновныеСредства.Дата
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизации КАК ВТ_ПараметрыАмортизации
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ВТ_ПараметрыАмортизации.ОсновноеСредство
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И ТаблицаОсновныеСредства.ВидОперацииДокумента = 0
	|	И ВТ_ПараметрыАмортизации.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор
	|ПОМЕСТИТЬ ВТ_Договор
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			&Организация = Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ТаблицаОсновныеСредства КАК ВТ)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.ЦМООтправитель КАК ЦМООтправитель,
	|	ТаблицаОсновныеСредства.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	ТаблицаОсновныеСредства.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТаблицаОсновныеСредства.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	|	ТаблицаОсновныеСредства.Сумма КАК Стоимость,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.Номер КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.ВидОперацииДокумента КАК ВидОперацииДокумента,
	|	ВТ_Договор.Договор КАК Договор,
	|	ЕСТЬNULL(ВТ_ПараметрыАмортизации.ПорядокПогашенияСтоимости, ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию) КАК СписатьПриВводе
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Договор КАК ВТ_Договор
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ВТ_Договор.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ВТ_Договор.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизации КАК ВТ_ПараметрыАмортизации
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ВТ_ПараметрыАмортизации.ОсновноеСредство
	|ГДЕ
	|	(ТаблицаОсновныеСредства.ЦМООтправитель <> ТаблицаОсновныеСредства.ЦМОПолучатель
	|			ИЛИ ТаблицаОсновныеСредства.ПодразделениеОтправитель <> ТаблицаОсновныеСредства.ПодразделениеПолучатель
	|			ИЛИ ВТ_ПараметрыАмортизации.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))
	|	И (ТаблицаОсновныеСредства.Сумма <> 0
	|			ИЛИ ТаблицаОсновныеСредства.Количество <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ВТ_Таблица.Период КАК Период,
	|	ВТ_Таблица.Организация КАК Организация,
	|	ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Таблица.ЦМООтправитель КАК ЦМО,
	|	ВТ_Таблица.Договор КАК Договор,
	|	ВТ_Таблица.ПодразделениеОтправитель КАК Подразделение,
	|	ВТ_Таблица.Стоимость КАК Стоимость,
	|	ВТ_Таблица.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ВТ_Таблица.ВидОперацииДокумента = 0
	|				И ВТ_Таблица.СписатьПриВводе
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение)
	|	КОНЕЦ КАК Событие,
	|	ВТ_Таблица.НазваниеДокумента КАК НазваниеДокумента,
	|	ВТ_Таблица.НомерДокумента КАК НомерДокумента,
	|	ВТ_Таблица.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВЫБОР
	|		КОГДА ВТ_Таблица.ВидОперацииДокумента = 0
	|				И ВТ_Таблица.СписатьПриВводе
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	КОНЕЦ,
	|	ВТ_Таблица.Период,
	|	ВТ_Таблица.Организация,
	|	ВТ_Таблица.ОсновноеСредство,
	|	ВТ_Таблица.ИнвентарныйНомер,
	|	ВТ_Таблица.ЦМОПолучатель,
	|	ВТ_Таблица.Договор,
	|	ВТ_Таблица.ПодразделениеПолучатель,
	|	ВЫБОР
	|		КОГДА &Учет21ВУсловнойОценке
	|				И ВТ_Таблица.ВидОперацииДокумента = 0
	|				И ВТ_Таблица.СписатьПриВводе
	|			ТОГДА ВТ_Таблица.Количество
	|		ИНАЧЕ ВТ_Таблица.Стоимость
	|	КОНЕЦ,
	|	ВТ_Таблица.Количество,
	|	ВЫБОР
	|		КОГДА ВТ_Таблица.ВидОперацииДокумента = 0
	|				И ВТ_Таблица.СписатьПриВводе
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение)
	|	КОНЕЦ,
	|	ВТ_Таблица.НазваниеДокумента,
	|	ВТ_Таблица.НомерДокумента,
	|	ВТ_Таблица.ДатаДокумента
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица";
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ПодразделениеПолучатель КАК Подразделение,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Сумма КАК СуммаАмортизации
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизации КАК ВТ_ПараметрыАмортизации
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ВТ_ПараметрыАмортизации.ОсновноеСредство
	|			И (ВТ_ПараметрыАмортизации.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации))
	|			И (ВТ_ПараметрыАмортизации.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию))
	|ГДЕ
	|	ТаблицаОсновныеСредства.ВидОперацииДокумента = 0
	|	И ТаблицаОсновныеСредства.Сумма <> 0";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТребованиеНакладнаяОС";
	КомандаПечати.Идентификатор		= "Накладная0504204_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 101;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТребованиеНакладнаяОС";
	КомандаПечати.Идентификатор		= "Накладная0504204_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", , Истина);
	КомандаПечати.Порядок			= 102;
	ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати(КомандаПечати);
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТребованиеНакладнаяОС";
	КомандаПечати.Идентификатор		= "Накладная0315006";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Требование - накладная (M-11)'");
	КомандаПечати.Порядок			= 103;
	ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати(КомандаПечати);
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "ТребованиеНакладная0510451_100н", 1);
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная0315006") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0315006", "Требование-накладная (ф. 0315006)", ПечатьНакладной0315006(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная0504204_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_103н", "Требование-накладная (ф. 0504204)", ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "_103н"));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная0504204_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_52н", "Требование-накладная (ф. 0504204)", ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОСодержанииДрагМатериалов") Тогда
	
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов", "Справка о содержании драг. материалов", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьНакладной0315006(МассивОбъектов, ОбъектыПечати)
	
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт", ЕдиницаИзмерения);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТребованиеНакладнаяОСОсновныеСредства.ОсновноеСредство,
	|	ТребованиеНакладнаяОСОсновныеСредства.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТребованиеНакладнаяОС.ОсновныеСредства КАК ТребованиеНакладнаяОСОсновныеСредства
	|ГДЕ
	|	ТребованиеНакладнаяОСОсновныеСредства.Ссылка В(&МассивОбъектов)
	|ИТОГИ ПО
	|	Ссылка";
	
	ТаблицаОС = Новый ТаблицаЗначений;
	ТаблицаОС.Колонки.Добавить("Регистратор", Новый ОписаниеТипов("ДокументСсылка.ТребованиеНакладнаяОС"));
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОС.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		МассивОС = Новый Массив;
		ВыборкаОС = Выборка.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			
			МассивОС.Добавить(ВыборкаОС.ОсновноеСредство);
			
		КонецЦикла;
		
		ДанныеОбъектовОС = УправлениеОсновнымиСредствами.ДанныеОбъектовОС(МассивОС, Выборка.Ссылка);
		
		Для каждого СтрокаДанных Из ДанныеОбъектовОС Цикл
			
			НоваяСтрокаОС = ТаблицаОС.Добавить();
			НоваяСтрокаОС.Регистратор = Выборка.Ссылка;
			НоваяСтрокаОС.ОсновноеСредство = СтрокаДанных.ОсновноеСредство;
			НоваяСтрокаОС.СчетУчета = СтрокаДанных.СчетУчета;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.Регистратор КАК Регистратор,
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.СчетУчета
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Регистратор";
	Запрос.Выполнить();
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТребованиеНакладнаяОС.Дата КАК Дата,
	|	ТребованиеНакладнаяОС.Номер КАК Номер,
	|	ТребованиеНакладнаяОС.Проведен КАК Проведен,
	|	ТребованиеНакладнаяОС.Организация КАК Организация,
	|	ТребованиеНакладнаяОС.ИФО КАК ИФО,
	|	"""" КАК пКоррСчет,
	|	ТребованиеНакладнаяОС.ЦМОПолучатель КАК ЦМО,
	|	ТребованиеНакладнаяОС.ЦМООтправитель КАК ЦМООтправитель,
	|	ТребованиеНакладнаяОС.Ссылка КАК Ссылка,
	|	ТребованиеНакладнаяОС.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	ТребованиеНакладнаяОС.Организация.КодОКПО КАК пКодОКПО,
