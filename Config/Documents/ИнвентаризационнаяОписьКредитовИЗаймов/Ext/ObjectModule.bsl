#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЗаполнитьПризнакиВыявленныхОтклонений();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты);
	
	Если Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПризнакиВыявленныхОтклонений()
	
	НовоеЗначениеВыявленаНеПодтвержденная = Ложь;
	НовоеЗначениеВыявленаПросроченная = Ложь;
	
	Для Каждого СтрокаТаблицы Из Раздел2 Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДНеподтвержденнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДНеподтвержденная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовНеподтвержденнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовНеподтвержденная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовНеподтвержденнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовНеподтвержденная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейНеподтвержденнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейНеподтвержденная) Тогда
			
			НовоеЗначениеВыявленаНеПодтвержденная = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДПросроченнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДПросроченная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовПросроченнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовПросроченная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовПросроченнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовПросроченная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейПросроченнаяВалютная)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейПросроченная) Тогда
			
			НовоеЗначениеВыявленаПросроченная = Истина;
		КонецЕсли;
		
		Если НовоеЗначениеВыявленаНеПодтвержденная И НовоеЗначениеВыявленаПросроченная Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ВыявленаНеПодтвержденная = НовоеЗначениеВыявленаНеПодтвержденная;
	ВыявленаПросроченная = НовоеЗначениеВыявленаПросроченная;
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	НепроверяемыеРеквизиты.Добавить("Раздел2");
	
	НепроверяемыеРеквизиты.Добавить("Раздел2.ДатаАктаСверкиОД");
	НепроверяемыеРеквизиты.Добавить("Раздел2.ДатаАктаСверкиПроцентов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.ДатаАктаСверкиШтрафов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.ДатаАктаСверкиПеней");
	
	НепроверяемыеРеквизиты.Добавить("Раздел2.НомерАктаСверкиОД");
	НепроверяемыеРеквизиты.Добавить("Раздел2.НомерАктаСверкиПроцентов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.НомерАктаСверкиШтрафов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.НомерАктаСверкиПеней");
	
	НепроверяемыеРеквизиты.Добавить("Раздел2.СтатусЗадолженностиОД");
	НепроверяемыеРеквизиты.Добавить("Раздел2.СтатусЗадолженностиПроцентов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.СтатусЗадолженностиШтрафов");
	НепроверяемыеРеквизиты.Добавить("Раздел2.СтатусЗадолженностиПеней");
	
	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли