		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля + "Валютная");
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		
		Если ОбщиеПараметры.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);
		КонецЕсли;
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
	КонецЦикла;
	
	// Рублевый итог при отличии валютного итога отмечаем лишь цветом.
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Итог по таблице фрагментов отличается от показателя исходной строки (%1 в рублях)'"), ИмяПоля);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоИностраннаяВалюта");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИсходнаяСтрока" + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИсходнаяСтрока" + ИмяПоля + "Валютная");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля + "Валютная");
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

