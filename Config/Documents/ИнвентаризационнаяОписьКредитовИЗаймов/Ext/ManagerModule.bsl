Функция ПолучитьПараметрыФормыРазбивкиСтроки(ФормаДокумента, ТекДанные) Экспорт
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		ТаблицаФрагментов = ПолучитьФрагментыРазбитойСтроки(ДокументОбъект.Раздел2, ТекДанные.ИдентификаторСтроки);
		
		ИсходнаяСтрока = СобратьИсходнуюСтрокуПоФрагментам(ТаблицаФрагментов);
		
		ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаФрагментов);
	Иначе
		ФрагментыСтроки = Неопределено;
		
		ИсходнаяСтрока = НовыйСтруктураИсходнойСтроки();
		
		ЗаполнитьЗначенияСвойств(ИсходнаяСтрока, ТекДанные);
	КонецЕсли;
	
	ПараметрыФормыРазбивки = Новый Структура();
	ПараметрыФормыРазбивки.Вставить("ИсходнаяСтрока",	ИсходнаяСтрока);
	ПараметрыФормыРазбивки.Вставить("ФрагментыСтроки",	ФрагментыСтроки);
	ПараметрыФормыРазбивки.Вставить("ВалютаРУ");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФормыРазбивки, ФормаДокумента, "ВалютаРУ");
	
	Возврат ПараметрыФормыРазбивки;
	
КонецФункции

