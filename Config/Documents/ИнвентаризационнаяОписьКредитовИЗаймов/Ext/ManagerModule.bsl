Функция ПолучитьДополнительныеПараметрыПечати0510471()
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СтрокаШапки", Неопределено);
	ДополнительныеПараметры.Вставить("РазмерыРазделов",	Новый Структура());
	ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	ДополнительныеПараметры.Вставить("ОписаниеСтатусовЗадолженности", ИнвентаризацияКлиентСервер.ПолучитьОписаниеСтатусовЗадолженности());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Раздел1", "НаименованиеКонтрагента,ИдентификаторКонтрагента,НаименованиеДокумента"
		+ ",ДатаДокумента,НомерДокумента,ДатаИсполнения,НомерСчета,КодВалюты");
	
	ИменаПолей.Вставить("Раздел2_Часть1", "НаименованиеКонтрагента,ИдентификаторКонтрагента,НаименованиеДокумента"
		+ ",ДатаДокумента,НомерДокумента,ДатаИсполнения,НомерСчета,КодВалюты,КодСтатусаОД,НаименованиеСтатусаОД");
		
	ИменаПолей.Вставить("Раздел2_Часть2", "КодСтатусаПроцентов,НаименованиеСтатусаПроцентов"
		+ ",КодСтатусаШтрафов,НаименованиеСтатусаШтрафов"
		+ ",КодСтатусаПеней,НаименованиеСтатусаПеней");
		
	ИменаПолей.Вставить("Раздел2_Часть3", "ДатаАктаСверкиОД,НомерАктаСверкиОД"
		+ ",ДатаАктаСверкиПроцентов,НомерАктаСверкиПроцентов"
		+ ",ДатаАктаСверкиШтрафов,НомерАктаСверкиШтрафов");
		
	ИменаПолей.Вставить("Раздел2_Часть4", "ДатаАктаСверкиПеней,НомерАктаСверкиПеней");
    
	ИменаПолей.Вставить("Раздел2_Часть5", "ЗаключениеКомиссии");
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
КонецФункции

Функция СформироватьПечатнуюФорму0510471(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	Перем ОписаниеСерииДокументов, СтрокаШапкиДокументаСРаспиской;
	
	КлючПараметровПечати = "ПечатьФормы0510471";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ИнвентаризацияСервер.ЗаполнитьРазмерыРазделов(Данные, "Раздел1,Раздел2", СтрокаШапки.Ссылка);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерДокументаДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.РешениеОПроведенииИнвентаризации,
		СтрокаШапки.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("Дата",				СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер",			НомерДокументаДляПечати);
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапки.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапки.НомерКомиссии, СтрокаШапки.НомерРабочейКомиссии, Истина));
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	Данные.ДополнительныеПараметры.СтрокаШапки = СтрокаШапки;
	
	// РАЗДЕЛ 1

	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии:'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапки.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссии, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки.Раздел1;
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= ОбластиМакета.Раздел1Заголовок;
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета.Раздел1Шапка;
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета.Раздел1Строка;
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета.Раздел1Итого;
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ЗаполнитьОбластьСтрокаТаблицы0510471_Раздел1";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
КонецПроцедуры

Процедура ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокумент.Вывести(ОбластиМакета.Раздел2Заголовок);
	
	// ТАБЛИЦА
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	Для НомерЧасти = 1 По 5 Цикл
		ОбщаяВыборка = Данные.Выборки["Раздел2"];
		ОбщаяВыборка.Сбросить();
		ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
		
		Выборка = ОбщаяВыборка.Выбрать();
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета[СтрШаблон("Раздел2Шапка%1", НомерЧасти)];
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета[СтрШаблон("Раздел2Строка%1", НомерЧасти)];
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета[СтрШаблон("Раздел2Итого%1", НомерЧасти)];
		
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = СтрШаблон(
			"Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ЗаполнитьОбластьСтрокаТаблицы0510471_Раздел2_Часть%1", НомерЧасти);
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		//*** Отключенная опция.
		//Если НомерЧасти = 3 Или НомерЧасти = 4 Тогда
		//	ПолеПропускаСтроки = "ЭтоОчереднаяСтрокаФрагментовСтрок";
		//Иначе
		//	ПолеПропускаСтроки = "";
		//КонецЕсли;
		//
		//ПараметрыВыводаТаблицы.НастройкиВывода.ПолеПропускаСтроки = ПолеПропускаСтроки;
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510471_Раздел1(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерСчета", ПолучитьПолныйНомерСчета(Выборка));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел1");
	
КонецПроцедуры

