		ИмяПоляСуммаВал = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная");
		ИмяПоляСуммаРуб = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "");
		ИмяПоляТребуетРеклассификации = ИмяПоляТребуетРеклассификации(ПостфиксВидаРасчета);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность флажка ""Требует реклассификации"" (%1)'"), ПостфиксВидаРасчета);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + ИмяПоляСуммаВал);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + ИмяПоляСуммаРуб);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + ИмяПоляТребуетРеклассификации);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоляТребуетРеклассификации);
	КонецЦикла;
	
КонецПроцедуры

