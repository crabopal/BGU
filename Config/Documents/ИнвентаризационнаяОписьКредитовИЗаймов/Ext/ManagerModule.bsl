Функция ПечатьФормы0510471(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	КлючПараметровПечати = "ПечатьФормы0510471";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.АвтоМасштаб = Истина;
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати0510471(МассивОбъектов);
	
	ОбластиМакета = ПолучитьОбластиМакета0510471();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		Если МассивОбъектов.Найти(ВыборкаШапка.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент = СформироватьПечатнуюФорму0510471(Данные, ВыборкаШапка, ОбластиМакета, ТиповыеПараметры);
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510471 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

