Функция ПолучитьТаблицыИтоговСуммБухУчетаФрагментовСтрок(ФормаДокумента, СписокИдентификаторовСтрок, НастройкиПодтвержденияАктамиСверки) Экспорт
	
	ИменаПолейСуммыБухУчета = Новый Массив();
	
	Для Каждого Элемент Из НастройкиПодтвержденияАктамиСверки Цикл
		ВидРасчетов = Элемент.Ключ;
		
		ИменаПолейСуммыБухУчета.Добавить(ИмяПоляСумма(ВидРасчетов, "", "Валютная"));
		ИменаПолейСуммыБухУчета.Добавить(ИмяПоляСумма(ВидРасчетов, "", ""));
	КонецЦикла;
	
	ИменаПолейСуммыБухУчетаСтрокой = СтрСоединить(ИменаПолейСуммыБухУчета, ",");
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ТаблицыИтогов = Новый Соответствие();
	
	Для Каждого ИдентификаторСтроки Из СписокИдентификаторовСтрок Цикл
		Поиск.ИдентификаторСтроки = ИдентификаторСтроки;
		
		ТаблицаФрагментов = ФормаДокумента.Объект.Раздел2.Выгрузить(Поиск, ИменаПолейСуммыБухУчетаСтрокой);
		ТаблицаФрагментов.Свернуть(, ИменаПолейСуммыБухУчетаСтрокой);
		
		ТаблицыИтогов.Вставить(ИдентификаторСтроки, ТаблицаФрагментов);
	КонецЦикла;
	
	Возврат ТаблицыИтогов;
	
КонецФункции

