#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПроверкаЗаполнения

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел2", ЕстьОшибки);
	КонецЕсли;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов();
	
	ПроверитьРаздел2(ДокументОбъект, ОбщиеПараметры, ЕстьОшибки);
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("МестоИнвентаризации");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("НаименованиеЗадолженности");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "СписокСчетов", Отказ);
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьФормуРазбивкиСтроки(ФормаРазбивкиСтроки, Отказ) Экспорт
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов();
	
	СтрокаТаблицы = ФормаРазбивкиСтроки.ТаблицаИсходнаяСтрока[0];
	
	ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(Неопределено, СтрокаТаблицы, ОбщиеПараметры, Отказ, Истина);

	Для Каждого СтрокаТаблицы Из ФормаРазбивкиСтроки.ТаблицаФрагментыСтроки Цикл
		ПроверитьРаздел2_ЗаполненыСтатусыЗадолженности(Неопределено, СтрокаТаблицы, ОбщиеПараметры, Отказ, Истина);
		
		ПроверитьРаздел2_ЗаполненыСуммыФрагментовСтроки(Неопределено, СтрокаТаблицы, ОбщиеПараметры, Отказ);
	КонецЦикла;
	
	ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам(ФормаРазбивкиСтроки, ОбщиеПараметры, Отказ);	
	
КонецПроцедуры
	
#КонецОбласти

#Область НастройкаФорм

Процедура УстановитьУсловноеОформление(ФормаДокумента) Экспорт
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента);
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыУсловногоОформления();
	
	// Раздел 1.
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел1");
	
	// Раздел 2.
	
	ДобавитьУсловноеОформление_НадписиВидовСуммы(УсловноеОформление, "Раздел2");
	
	Если ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности() Тогда
		ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры);
	Иначе
		ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры);
	КонецЕсли;
	
	ДобавитьУсловноеОформление_НедоступностьСтатусаЗадолженности(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_НедоступностьВидовСуммы(УсловноеОформление, ОбщиеПараметры);
	
	ДобавитьУсловноеОформление_НедоступностьРедактированияПросроченныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_НедоступностьФлажковТребуетРеклассификации(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_ПрочеркиПросроченныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел2");
	
	ДобавитьУсловноеОформление_ПоляФрагментовСтрокиРедактируемыеСОткрытиемФормы(УсловноеОформление);
	
	ДобавитьУсловноеОформление_ПервыеФрагментыСтрок(УсловноеОформление, ОбщиеПараметры);
	
	ДобавитьУсловноеОформление_ОчередныеФрагментыСтрок(УсловноеОформление, ОбщиеПараметры);
	
	// Список счетов.
	
	ДобавитьУсловноеОформление_КФО0ВСпискеСчетов(УсловноеОформление);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление_ФормаРазбивкиСтроки(ФормаДокумента) Экспорт
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыУсловногоОформления();
	
	ДобавитьУсловноеОформление_НадписиВидовСуммы(УсловноеОформление, "ТаблицаФрагментыСтроки");
	ДобавитьУсловноеОформление_НадписиВидовСуммы(УсловноеОформление, "ТаблицаИсходнаяСтрока");
	
	Если ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности() Тогда
		ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, Истина);
	Иначе
		ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, Истина);
	КонецЕсли;
	
	ДобавитьУсловноеОформление_НедоступностьСуммФрагментов(УсловноеОформление, ОбщиеПараметры);
	
	ДобавитьУсловноеОформление_НедоступностьСтатусаЗадолженности(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьВидовСуммы(УсловноеОформление, ОбщиеПараметры, Истина);
	
	ДобавитьУсловноеОформление_НедоступностьРедактированияПросроченныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьФлажковТребуетРеклассификации(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_ПрочеркиПросроченныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_ИтогиРасходятсяСИсходнойСтрокой_ИностраннаяВалюта(УсловноеОформление, ОбщиеПараметры);
	ДобавитьУсловноеОформление_ИтогиРасходятсяСИсходнойСтрокой_Рубли(УсловноеОформление);
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	ПрежнийИдентификаторСтроки = Неопределено;
	
	Для Каждого СтрокаТаблицы Из Объект.Раздел2 Цикл
		СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
		
		Если СтрокаТаблицы.ПризнакФрагментаСтроки И ПрежнийИдентификаторСтроки <> СтрокаТаблицы.ИдентификаторСтроки Тогда
			ПрежнийИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
			
			СтрокаТаблицы.ПризнакПервогоФрагментаСтроки = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьКэшИменПолейДляФормыДокумента(ФормаДокумента) Экспорт
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	ПостфиксыВидовСуммы = ПолучитьПостфиксыВидовСуммы();
	
	ПостфиксыВалютная = Новый Массив();
	ПостфиксыВалютная.Добавить("Валютная");
	ПостфиксыВалютная.Добавить("");
	
	ИмяПоляСумма = Новый Соответствие();
	
	КомпонентыИмени = Новый Соответствие();
	
	Для Каждого ВидРасчетов Из ПостфиксыВидовРасчета Цикл
		Для Каждого ВидСуммы Из ПостфиксыВидовСуммы Цикл
			Для Каждого Валютная Из ПостфиксыВалютная Цикл
				КомпонентыИмени.Вставить(ИмяПоляСумма(ВидРасчетов, ВидСуммы, Валютная), НовыйКомпонентыИмени(ВидРасчетов, ВидСуммы, Валютная));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	КэшИменПолей = Новый Структура();
	КэшИменПолей.Вставить("КомпонентыИмени", КомпонентыИмени);
	
	ФормаДокумента.КэшИменПолей = Новый ФиксированнаяСтруктура(КэшИменПолей);
	
КонецПроцедуры

Процедура ЗаполнитьСписокВыбораНаименованияЗадолженности(Знач ФормаДокумента, НовоеЗначениеНаименованияЗадолженности = Неопределено) Экспорт
	
	СписокВыбораОграниченный = ПолучитьСписокВыбораНаименованияЗадолженности(ФормаДокумента);
	
	ЭлементФормы = ФормаДокумента.Элементы.НаименованиеЗадолженности;
	
	ЭлементФормы.РежимВыбораИзСписка = (СписокВыбораОграниченный.Количество() > 0);
	
	ЭлементФормы.СписокВыбора.Очистить();
	
	Для Каждого Элемент Из СписокВыбораОграниченный Цикл
		ЭлементФормы.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Если СписокВыбораОграниченный.Количество() = 1 Тогда
		НовоеЗначениеНаименованияЗадолженности = СписокВыбораОграниченный[0].Значение;
	Иначе
		НовоеЗначениеНаименованияЗадолженности = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокВыбораНаименованияЗадолженности(ФормаДокумента) Экспорт
	
	СоответствиеСчетВидыЗаимствований = ПолучитьСоответствиеСчетВидыЗаимствований();
	
	УникальныеЗначения = Новый Массив();
	
	ТребуетсяОграничение = Истина;
	
	Для Каждого СтрокаТаблицы Из ФормаДокумента.Объект.СписокСчетов Цикл
		КодСчета = Строка(СтрокаТаблицы.Счет);
		
		ЗначенияСтрокой = СоответствиеСчетВидыЗаимствований.Получить(КодСчета);
		
		Если ЗначенияСтрокой = Неопределено Тогда
			ТребуетсяОграничение = Ложь;
			
			Прервать;
		КонецЕсли;
		
		МассивЗначений = СтрРазделить(ЗначенияСтрокой, ", ", Ложь);
		
		Для Каждого ЗначениеСтрокой Из МассивЗначений Цикл
			ВидЗаимствования = Перечисления.ВидыЗаимствований[ЗначениеСтрокой];
			
			Если УникальныеЗначения.Найти(ВидЗаимствования) = Неопределено Тогда
				УникальныеЗначения.Добавить(ВидЗаимствования);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Не ТребуетсяОграничение Тогда
		УникальныеЗначения.Очистить();
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений();
	
	СписокВыбора.ЗагрузитьЗначения(УникальныеЗначения);
	
	Возврат СписокВыбора;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеРазделов

Функция ПолучитьДанныеУчета(ПараметрыПроцедуры) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ПараметрыПроцедуры);
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",						ПараметрыПоиска.ДатаОстатков);
	ЗапросПоиск.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("Подразделение",						ПараметрыПоиска.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	
	ЗапросПоиск.УстановитьПараметр("ВидыСубконто",						ПараметрыПоиска.ВидыСубконто);
	
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетаДляКолонкиОД",		ПараметрыПоиска.СписокВидовРасчетаДляКолонкиОД);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетаДляКолонкиПроцентов",	ПараметрыПоиска.СписокВидовРасчетаДляКолонкиПроцентов);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетаДляКолонкиШтрафов",	ПараметрыПоиска.СписокВидовРасчетаДляКолонкиШтрафов);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетаДляКолонкиПеней",		ПараметрыПоиска.СписокВидовРасчетаДляКолонкиПеней);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстатки();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДляРаздела1 = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	РассчитатьИтогиРаздела1(ТаблицаДляРаздела1);
	
	ЗаполнитьДолгосрочнуюПросроченнуюЗадолженность(ТаблицаДляРаздела1, ПараметрыПоиска, ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ЗаполнитьИдентификаторыКонтрагентов(ТаблицаДляРаздела1);
	
	ПоляСортировки = ПолучитьПоляСортировкиТаблицыРаздела1ПоУмолчанию();
	
	ТаблицаДляРаздела1.Сортировать(ПоляСортировки);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаДляРаздела1", ТаблицаДляРаздела1);
	
	Возврат Результат;
	
