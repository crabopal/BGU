Процедура ДобавитьКодНаименованиеСтатусаЗадолженности(ЗначенияПараметров, ПостфиксВидаРасчета, Выборка, ДополнительныеПараметры)
	
	ОписаниеСтатусаЗадолженности = ИнвентаризацияКлиентСервер.ПолучитьОписаниеСтатусаЗадолженности(
		Выборка[ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета)],
		ДополнительныеПараметры.ОписаниеСтатусовЗадолженности);
	
	ИмяПараметраКод = СтрШаблон("КодСтатуса%1", ПостфиксВидаРасчета);
	ИмяПараметраНаименование = СтрШаблон("НаименованиеСтатуса%1", ПостфиксВидаРасчета);
	
	ЗначенияПараметров.Вставить(ИмяПараметраКод,			ОписаниеСтатусаЗадолженности.Код);
	ЗначенияПараметров.Вставить(ИмяПараметраНаименование,	ОписаниеСтатусаЗадолженности.Наименование);
	
КонецПроцедуры

Функция ПолучитьПолныйНомерСчета(Выборка)
	
	Если ЗначениеЗаполнено(Выборка.КПС)
		Или ЗначениеЗаполнено(Выборка.КФО)
		Или ЗначениеЗаполнено(Выборка.Счет) Тогда
		
		СчетУчетПоКЭК = Ложь;
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет,,, Выборка.СчетУчетПоКПС, СчетУчетПоКЭК);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

