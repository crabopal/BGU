Функция ПолучитьДанныеДляПечати0510471(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510471();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	Данные.Вставить("ДополнительныеПараметры", ПолучитьДополнительныеПараметрыПечати0510471());
	
	Данные.Выборки.Вставить("Шапки",	РезультатыЗапроса[0].Выбрать());
	Данные.Выборки.Вставить("Раздел1",	РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2",	РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("СоставКомиссии", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссии"));
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат Данные;
	
КонецФункции

