Функция ПолучитьПараметрыПоискаОстатков(ПараметрыПроцедуры)
	
	ИспользоватьУчетПоИФО					= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет				= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьУчетПоПодразделениям		= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьКонтрольИсполненияДоговоров	= ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	НастройкиОтбораСчетовИКФО = ИнвентаризацияСервер.ПолучитьНастройкиОтбораСчетовИКФО(ПараметрыПроцедуры.СписокСчетов, ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовПоЗаймам);
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",							ДатаОстатков);
	ПараметрыПоиска.Вставить("Организация",								ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",					ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",					ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",										ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",		ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоПодразделению",		ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("Подразделение",							ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКонтрагенту",			Ложь);
	ПараметрыПоиска.Вставить("СписокКонтрагентов",						Новый Массив());
	ПараметрыПоиска.Вставить("КЭК000",									БухгалтерскийУчетПовтИсп.КЭК0());
	ПараметрыПоиска.Вставить("ИспользоватьКонтрольИсполненияДоговоров",	ИспользоватьКонтрольИсполненияДоговоров);
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",					НастройкиОтбораСчетовИКФО.ИспользоватьОтборПоКФО);
	ПараметрыПоиска.Вставить("СписокКФО",								НастройкиОтбораСчетовИКФО.СписокКФО);
	ПараметрыПоиска.Вставить("СписокСчетов",							НастройкиОтбораСчетовИКФО.СписокСчетов);
	ПараметрыПоиска.Вставить("ТаблицаИсключаемыхСчетов",				НастройкиОтбораСчетовИКФО.ДетальнаяТаблицаИсключаемыеСчета);
	
	ПараметрыПоиска.Вставить("ИспользоватьВалютныйУчет",				ИспользоватьВалютныйУчет);
	ПараметрыПоиска.Вставить("ВалютаРУ",								Константы.ВалютаРегламентированногоУчета.Получить());
	
	ПараметрыПоиска.Вставить("ВидыСубконто",							ВидыСубконто);
	
	ПараметрыПоиска.Вставить("СписокВидовРасчетаДляКолонкиОД",			ПолучитьСписокВидовРасчетаДляКолонкиОД());
	ПараметрыПоиска.Вставить("СписокВидовРасчетаДляКолонкиПроцентов",	ПолучитьСписокВидовРасчетаДляКолонкиПроцентов());
	ПараметрыПоиска.Вставить("СписокВидовРасчетаДляКолонкиШтрафов",		ПолучитьСписокВидовРасчетаДляКолонкиШтрафов());
	ПараметрыПоиска.Вставить("СписокВидовРасчетаДляКолонкиПеней",		ПолучитьСписокВидовРасчетаДляКолонкиПеней());
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстатки()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые счета
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО	КАК КФО,
	|	ТЗ.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблицаИсключаемыхСчетов
	|ИЗ
	|	&ТаблицаИсключаемыхСчетов КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Остатки по данным бух.учета
	|//
	|ВЫБРАТЬ
	|	Счет												КАК Счет,
	|	КФО													КАК КФО,
	|	КПС													КАК КПС,
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты)		КАК Контрагент,
	|	ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры)			КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|			ЕСТЬNULL(Валюта, &ВалютаРУ)
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ												КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ												КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ												КАК Подразделение,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиОД) ТОГДА
	|				СуммаОстаток
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаОД,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиПроцентов) ТОГДА
	|				СуммаОстаток
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаПроцентов,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиШтрафов) ТОГДА
	|				СуммаОстаток
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаШтрафов,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиПеней) ТОГДА
	|				СуммаОстаток
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаПеней,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиОД) ТОГДА
	|				ВЫБОР
	|					КОГДА &ИспользоватьВалютныйУчет И НЕ ЕСТЬNULL(Валюта, &ВалютаРУ) = &ВалютаРУ ТОГДА
	|						ЕСТЬNULL(ВалютнаяСуммаОстаток, 0)
	|					ИНАЧЕ
	|						0
	|				КОНЕЦ 
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаОДВалютная,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиПроцентов) ТОГДА
	|				ВЫБОР
	|					КОГДА &ИспользоватьВалютныйУчет И НЕ ЕСТЬNULL(Валюта, &ВалютаРУ) = &ВалютаРУ ТОГДА
	|						ЕСТЬNULL(ВалютнаяСуммаОстаток, 0)
	|					ИНАЧЕ
	|						0
	|				КОНЕЦ 
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаПроцентовВалютная,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиШтрафов) ТОГДА
	|				ВЫБОР
	|					КОГДА &ИспользоватьВалютныйУчет И НЕ ЕСТЬNULL(Валюта, &ВалютаРУ) = &ВалютаРУ ТОГДА
	|						ЕСТЬNULL(ВалютнаяСуммаОстаток, 0)
	|					ИНАЧЕ
	|						0
	|				КОНЕЦ 
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаШтрафовВалютная,
	|	СУММА(ВЫБОР
	|			КОГДА Субконто3 В(&СписокВидовРасчетаДляКолонкиПеней) ТОГДА
	|				ВЫБОР
	|					КОГДА &ИспользоватьВалютныйУчет И НЕ ЕСТЬNULL(Валюта, &ВалютаРУ) = &ВалютаРУ ТОГДА
	|						ЕСТЬNULL(ВалютнаяСуммаОстаток, 0)
	|					ИНАЧЕ
	|						0
	|				КОНЕЦ 
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ)											КАК СуммаПенейВалютная
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков,			// 1 Период
	|		Счет В (&СписокСчетов),	// 2 Условие счета
	|		&ВидыСубконто,			// 3 ВидыСубконто
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|ГДЕ
	|	ВЫБОР 
	|		КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|			Счет.УчетПоПодразделениям И Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И НЕ (КФО, Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов)
	|СГРУППИРОВАТЬ ПО
	|	Счет,
	|	КФО,
	|	КПС,
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры),
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|			ЕСТЬNULL(Валюта, &ВалютаРУ)
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ";
	
КонецФункции

Процедура РассчитатьИтогиРаздела1(ТаблицаДляРаздела1)
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	ТаблицаДляРаздела1.Колонки.Добавить("СуммаИтого", ТипСумма);
	ТаблицаДляРаздела1.Колонки.Добавить("СуммаИтогоВалютная", ТипСумма);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДляРаздела1 Цикл
		СтрокаТаблицы.СуммаИтого = СтрокаТаблицы.СуммаОД
			+ СтрокаТаблицы.СуммаПроцентов
			+ СтрокаТаблицы.СуммаШтрафов
			+ СтрокаТаблицы.СуммаПеней;
			
		СтрокаТаблицы.СуммаИтогоВалютная = СтрокаТаблицы.СуммаОДВалютная
			+ СтрокаТаблицы.СуммаПроцентовВалютная
			+ СтрокаТаблицы.СуммаШтрафовВалютная
			+ СтрокаТаблицы.СуммаПенейВалютная;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела2(ПараметрыФункции)
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьКредитовИЗаймов.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НаименованиеЗадолженности КАК НаименованиеЗадолженности
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьКредитовИЗаймов
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросЗаполнение.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаРаздела1			= РезультатыЗапроса[0].Выгрузить();
	ТаблицаШапкаДокумента	= РезультатыЗапроса[1].Выгрузить();
	
	ПараметрыФункции.Вставить("ТаблицаРаздела1",	ТаблицаРаздела1);
	ПараметрыФункции.Вставить("Шапка",				ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапкаДокумента[0]));
	
КонецПроцедуры

Процедура ДозаполнитьТаблицуРаздела2(ПараметрыФункции)
	
	Перем КомпонентыСумм;
	
	ТаблицаРаздела2 = ПараметрыФункции.ТаблицаРаздела1;
	
	ИсключитьТипNullВКолонкахТаблицы(ТаблицаРаздела2);
	
	ИнвентаризацияСервер.ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(ТаблицаРаздела2,
		Метаданные.Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ТабличныеЧасти.Раздел2);
	
	ТаблицаФрагментовСтрок = ТаблицаРаздела2.СкопироватьКолонки();
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ИменаВсехЧисловыхКолонокРаздела1", СтрСоединить(ПолучитьИменаВсехЧисловыхКолонокРаздела1(), ","));
	ПараметрыЗаполнения.Вставить("ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной",
		ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной());
	ПараметрыЗаполнения.Вставить("СтатусыПросроченнойЗадолженности",
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности());
	ПараметрыЗаполнения.Вставить("ПостфиксыВидовРасчета", ПолучитьПостфиксыВидовРасчета());
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела2 Цикл
		СтрокаТаблицы.КодСтроки = СтрокаТаблицы.НомерСтроки;
		
		Если Не РассчитатьФрагментыСтроки(ТаблицаФрагментовСтрок, СтрокаТаблицы, ПараметрыЗаполнения, КомпонентыСумм) Тогда
			// Фрагменты строки отсутствуют.
			// Дозаполняем текущую строку.
			ЗаполнитьСтрокуПоВыделеннымКомпонентамСумм(СтрокаТаблицы, КомпонентыСумм, ПараметрыЗаполнения);
			
			Если ПараметрыЗаполнения.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
				ЗаполнитьНеподтвержденныеСуммыСтрокиРаздела2(СтрокаТаблицы);
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьВсеИтоги(СтрокаТаблицы);
	КонецЦикла;
	
	ДобавитьФрагментыСтрок(ТаблицаРаздела2, ТаблицаФрагментовСтрок, ПараметрыЗаполнения);
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности)
	
	Если ТаблицаЗадолженности.Колонки.Найти("ИдентификаторКонтрагента") = Неопределено Тогда
		ТаблицаЗадолженности.Колонки.Добавить("ИдентификаторКонтрагента", ОбщегоНазначения.ОписаниеТипаСтрока(22));
	КонецЕсли;
	
	ВремТЗ = ТаблицаЗадолженности.Скопировать(, "Контрагент");
	ВремТЗ.Свернуть("Контрагент");
	СписокКонтрагентов = ВремТЗ.ВыгрузитьКолонку("Контрагент");
	
	ИдентификаторыКонтрагентов = БухгалтерскийУчет.ИдентификаторыКонтрагентов(СписокКонтрагентов);
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		СтрокаТаблицы.ИдентификаторКонтрагента = ИдентификаторыКонтрагентов.Получить(СтрокаТаблицы.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИсключитьТипNullВКолонкахТаблицы(Таблица)
	
	ИнвентаризацияСервер.ИсключитьТипNullВКолонкахТаблицы(Таблица, ПолучитьИменаВсехЧисловыхКолонокРаздела1());
	
КонецПроцедуры

Функция ПолучитьИменаВсехЧисловыхКолонокРаздела1()
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("СуммаОДВалютная");
	ИменаКолонок.Добавить("СуммаОД");
	ИменаКолонок.Добавить("СуммаПроцентовВалютная");
	ИменаКолонок.Добавить("СуммаПроцентов");
	ИменаКолонок.Добавить("СуммаШтрафовВалютная");
	ИменаКолонок.Добавить("СуммаШтрафов");
	ИменаКолонок.Добавить("СуммаПенейВалютная");
	ИменаКолонок.Добавить("СуммаПеней");
	ИменаКолонок.Добавить("СуммаИтогоВалютная");
	ИменаКолонок.Добавить("СуммаИтого");
	ИменаКолонок.Добавить("СуммаОДПросроченнаяВалютная");
	ИменаКолонок.Добавить("СуммаОДПросроченная");
	ИменаКолонок.Добавить("СуммаОДДолгосрочнаяВалютная");
	ИменаКолонок.Добавить("СуммаОДДолгосрочная");
	ИменаКолонок.Добавить("СуммаПроцентовПросроченнаяВалютная");
	ИменаКолонок.Добавить("СуммаПроцентовПросроченная");
	ИменаКолонок.Добавить("СуммаПроцентовДолгосрочнаяВалютная");
	ИменаКолонок.Добавить("СуммаПроцентовДолгосрочная");
	ИменаКолонок.Добавить("СуммаШтрафовПросроченнаяВалютная");
	ИменаКолонок.Добавить("СуммаШтрафовПросроченная");
	ИменаКолонок.Добавить("СуммаШтрафовДолгосрочнаяВалютная");
	ИменаКолонок.Добавить("СуммаШтрафовДолгосрочная");
	ИменаКолонок.Добавить("СуммаПенейПросроченнаяВалютная");
	ИменаКолонок.Добавить("СуммаПенейПросроченная");
	ИменаКолонок.Добавить("СуммаПенейДолгосрочнаяВалютная");
	ИменаКолонок.Добавить("СуммаПенейДолгосрочная");
	
	Возврат ИменаКолонок;
	
КонецФункции

Процедура ЗаполнитьВсеИтоги(СтрокаТаблицы)
	
	ЗаполнитьИтогоБухУчет(СтрокаТаблицы);
	
	ЗаполнитьИтогоПодтвержденная(СтрокаТаблицы);
	
	ЗаполнитьИтогоНеподтвержденная(СтрокаТаблицы);
		
	ЗаполнитьИтогоПросроченная(СтрокаТаблицы);
		
КонецПроцедуры

Процедура ЗаполнитьИтогоБухУчет(СтрокаТаблицы);
	
	СтрокаТаблицы.СуммаИтого = СтрокаТаблицы.СуммаОД
		+ СтрокаТаблицы.СуммаПроцентов
		+ СтрокаТаблицы.СуммаШтрафов
		+ СтрокаТаблицы.СуммаПеней;
		
	СтрокаТаблицы.СуммаИтогоВалютная = СтрокаТаблицы.СуммаОДВалютная
		+ СтрокаТаблицы.СуммаПроцентовВалютная
		+ СтрокаТаблицы.СуммаШтрафовВалютная
		+ СтрокаТаблицы.СуммаПенейВалютная;
		
КонецПроцедуры

Процедура ЗаполнитьИтогоПодтвержденная(СтрокаТаблицы)
	
	СтрокаТаблицы.СуммаИтогоПодтвержденная = СтрокаТаблицы.СуммаОДПодтвержденная
		+ СтрокаТаблицы.СуммаПроцентовПодтвержденная
		+ СтрокаТаблицы.СуммаШтрафовПодтвержденная
		+ СтрокаТаблицы.СуммаПенейПодтвержденная;
		
	СтрокаТаблицы.СуммаИтогоПодтвержденнаяВалютная = СтрокаТаблицы.СуммаОДПодтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаПроцентовПодтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаШтрафовПодтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаПенейПодтвержденнаяВалютная;
		
КонецПроцедуры

Процедура ЗаполнитьИтогоНеподтвержденная(СтрокаТаблицы)
	
	СтрокаТаблицы.СуммаИтогоНеподтвержденная = СтрокаТаблицы.СуммаОДНеподтвержденная
		+ СтрокаТаблицы.СуммаПроцентовНеподтвержденная
		+ СтрокаТаблицы.СуммаШтрафовНеподтвержденная
		+ СтрокаТаблицы.СуммаПенейНеподтвержденная;
		
	СтрокаТаблицы.СуммаИтогоНеподтвержденнаяВалютная = СтрокаТаблицы.СуммаОДНеподтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаПроцентовНеподтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаШтрафовНеподтвержденнаяВалютная
		+ СтрокаТаблицы.СуммаПенейНеподтвержденнаяВалютная;
		
КонецПроцедуры

Процедура ЗаполнитьИтогоПросроченная(СтрокаТаблицы)
	
	СтрокаТаблицы.СуммаИтогоПросроченная = СтрокаТаблицы.СуммаОДПросроченная
		+ СтрокаТаблицы.СуммаШтрафовПросроченная 
		+ СтрокаТаблицы.СуммаПроцентовПросроченная
		+ СтрокаТаблицы.СуммаПенейПросроченная;
	
	СтрокаТаблицы.СуммаИтогоПросроченнаяВалютная = СтрокаТаблицы.СуммаОДПросроченнаяВалютная
		+ СтрокаТаблицы.СуммаШтрафовПросроченнаяВалютная 
		+ СтрокаТаблицы.СуммаПроцентовПросроченнаяВалютная
		+ СтрокаТаблицы.СуммаПенейПросроченнаяВалютная;
		
КонецПроцедуры


Процедура ЗаполнитьНеподтвержденныеСуммыСтрокиРаздела2(СтрокаТаблицы)
	
	СтрокаТаблицы.СуммаОДНеподтвержденнаяВалютная			= СтрокаТаблицы.СуммаОДВалютная;
	СтрокаТаблицы.СуммаОДНеподтвержденная					= СтрокаТаблицы.СуммаОД;
	
	СтрокаТаблицы.СуммаПроцентовНеподтвержденнаяВалютная	= СтрокаТаблицы.СуммаПроцентовВалютная;
	СтрокаТаблицы.СуммаПроцентовНеподтвержденная			= СтрокаТаблицы.СуммаПроцентов;
	
	СтрокаТаблицы.СуммаШтрафовНеподтвержденнаяВалютная		= СтрокаТаблицы.СуммаШтрафовВалютная;
	СтрокаТаблицы.СуммаШтрафовНеподтвержденная				= СтрокаТаблицы.СуммаШтрафов;
	
	СтрокаТаблицы.СуммаПенейНеподтвержденнаяВалютная		= СтрокаТаблицы.СуммаПенейВалютная;
	СтрокаТаблицы.СуммаПенейНеподтвержденная				= СтрокаТаблицы.СуммаПеней;
	
КонецПроцедуры

Процедура УвеличитьНеподтвержденныеСуммыСтрокиРаздела2(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.СуммаОДНеподтвержденнаяВалютная = СтрокаПриемник.СуммаОДНеподтвержденнаяВалютная
		+ СтрокаИсточник.СуммаОДВалютная;
	СтрокаПриемник.СуммаОДНеподтвержденная = СтрокаПриемник.СуммаОДНеподтвержденная
		+ СтрокаИсточник.СуммаОД;
	
	СтрокаПриемник.СуммаПроцентовНеподтвержденнаяВалютная = СтрокаПриемник.СуммаПроцентовНеподтвержденнаяВалютная
		+ СтрокаИсточник.СуммаПроцентовВалютная;
	СтрокаПриемник.СуммаПроцентовНеподтвержденная = СтрокаПриемник.СуммаПроцентовНеподтвержденная
		+ СтрокаИсточник.СуммаПроцентов;
	
	СтрокаПриемник.СуммаШтрафовНеподтвержденнаяВалютная = СтрокаПриемник.СуммаШтрафовНеподтвержденнаяВалютная
		+ СтрокаИсточник.СуммаШтрафовВалютная;
	СтрокаПриемник.СуммаШтрафовНеподтвержденная = СтрокаПриемник.СуммаШтрафовНеподтвержденная
		+ СтрокаИсточник.СуммаШтрафов;
	
	СтрокаПриемник.СуммаПенейНеподтвержденнаяВалютная = СтрокаПриемник.СуммаПенейНеподтвержденнаяВалютная
		+ СтрокаИсточник.СуммаПенейВалютная;
	СтрокаПриемник.СуммаПенейНеподтвержденная = СтрокаПриемник.СуммаПенейНеподтвержденная
		+ СтрокаИсточник.СуммаПеней;
	
КонецПроцедуры

Процедура ЗаполнитьПросроченныеСуммыСтрокиРаздела2(СтрокаТаблицы, ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.СтатусыПросроченнойЗадолженности.Найти(СтрокаТаблицы.СтатусЗадолженностиОД) <> Неопределено Тогда
		СтрокаТаблицы.СуммаОДПросроченнаяВалютная	= СтрокаТаблицы.СуммаОДВалютная;
		СтрокаТаблицы.СуммаОДПросроченная			= СтрокаТаблицы.СуммаОД;
		СтрокаТаблицы.СуммаОДТребуетРеклассификации	= Истина;
	Иначе
		СтрокаТаблицы.СуммаОДПросроченнаяВалютная	= 0;
		СтрокаТаблицы.СуммаОДПросроченная			= 0;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.СтатусыПросроченнойЗадолженности.Найти(СтрокаТаблицы.СтатусЗадолженностиПроцентов) <> Неопределено Тогда
		СтрокаТаблицы.СуммаПроцентовПросроченнаяВалютная	= СтрокаТаблицы.СуммаПроцентовВалютная;
		СтрокаТаблицы.СуммаПроцентовПросроченная			= СтрокаТаблицы.СуммаПроцентов;
		СтрокаТаблицы.СуммаПроцентовТребуетРеклассификации	= Истина;
	Иначе
		СтрокаТаблицы.СуммаПроцентовПросроченнаяВалютная	= 0;
		СтрокаТаблицы.СуммаПроцентовПросроченная			= 0;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.СтатусыПросроченнойЗадолженности.Найти(СтрокаТаблицы.СтатусЗадолженностиШтрафов) <> Неопределено Тогда
		СтрокаТаблицы.СуммаШтрафовПросроченнаяВалютная		= СтрокаТаблицы.СуммаШтрафовВалютная;
		СтрокаТаблицы.СуммаШтрафовПросроченная				= СтрокаТаблицы.СуммаШтрафов;
		СтрокаТаблицы.СуммаШтрафовТребуетРеклассификации	= Истина;
	Иначе
		СтрокаТаблицы.СуммаШтрафовПросроченнаяВалютная	= 0;
		СтрокаТаблицы.СуммаШтрафовПросроченная			= 0;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.СтатусыПросроченнойЗадолженности.Найти(СтрокаТаблицы.СтатусЗадолженностиПеней) <> Неопределено Тогда
		СтрокаТаблицы.СуммаПенейПросроченнаяВалютная	= СтрокаТаблицы.СуммаПенейВалютная;
		СтрокаТаблицы.СуммаПенейПросроченная			= СтрокаТаблицы.СуммаПеней;
		СтрокаТаблицы.СуммаПенейТребуетРеклассификации	= Истина;
	Иначе
		СтрокаТаблицы.СуммаПенейПросроченнаяВалютная	= 0;
		СтрокаТаблицы.СуммаПенейПросроченная			= 0;
	КонецЕсли;
	
КонецПроцедуры

#Область ДолгосрочнаяПросроченная

Процедура ЗаполнитьДолгосрочнуюПросроченнуюЗадолженность(ТаблицаОписи, ПараметрыПоиска, ДатаИнвентаризации)
	
	// В строку описи устанавливается одна максимальная дата исполнения из всех дат исполнения всех видов расчетов.
	
	ДобавитьСлужебныеКолонкиДляАнализаЗадолженности(ТаблицаОписи);
	
	СпискиВидовРасчета = ПолучитьСпискиВидовРасчетаВсехКолонок();
	
	Если ПараметрыПоиска.ИспользоватьКонтрольИсполненияДоговоров Тогда
		ИменаКолонок = ПолучитьИменаКолонокДляАнализаЗадолженности(ПараметрыПоиска);
		
		АнализЗадолженности = ПолучитьТаблицуАнализаЗадолженности(ТаблицаОписи, ПараметрыПоиска, ИменаКолонок);
		
		ТаблицаСумм = НовыйТаблицаСуммИзАнализаЗадолженности();
		
		Для Каждого СтрокаОписи Из ТаблицаОписи Цикл
			ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеОписи(СтрокаОписи, АнализЗадолженности,
				ПараметрыПоиска, ИменаКолонок, СпискиВидовРасчета, ТаблицаСумм);
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаОписи.Индексы.Добавить("ПросроченнаяЗадолженностьУстановлена");
	
	ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ДатаИнвентаризации);
	
КонецПроцедуры

Процедура ДобавитьСлужебныеКолонкиДляАнализаЗадолженности(ТаблицаОписи)
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ТаблицаОписи.Колонки.Добавить("СуммаОДПросроченнаяВалютная",			ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаОДПросроченная",					ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаОДДолгосрочнаяВалютная",			ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаОДДолгосрочная",					ОписаниеТипаСуммы);
	
	ТаблицаОписи.Колонки.Добавить("СуммаПроцентовПросроченнаяВалютная",		ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПроцентовПросроченная",				ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПроцентовДолгосрочнаяВалютная",		ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПроцентовДолгосрочная",				ОписаниеТипаСуммы);
	
	ТаблицаОписи.Колонки.Добавить("СуммаШтрафовПросроченнаяВалютная",		ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаШтрафовПросроченная",				ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаШтрафовДолгосрочнаяВалютная",		ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаШтрафовДолгосрочная",				ОписаниеТипаСуммы);
	
	ТаблицаОписи.Колонки.Добавить("СуммаПенейПросроченнаяВалютная",			ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПенейПросроченная",					ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПенейДолгосрочнаяВалютная",			ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("СуммаПенейДолгосрочная",					ОписаниеТипаСуммы);
	
	ТаблицаОписи.Колонки.Добавить("ДатаИсполнения",							Новый ОписаниеТипов("Дата"));
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяЗадолженностьУстановлена",	Новый ОписаниеТипов("Булево"));
	
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрокОД",					ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрокПроцентов",			ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрокШтрафов",				ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрокПеней",				ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	
	ТаблицаОписи.Колонки.Добавить("МаксимальноеКоличествоПодстрок",			ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	
КонецПроцедуры

Функция ПолучитьТаблицуАнализаЗадолженности(ТаблицаОписи, ПараметрыПоиска, ИменаКолонок)
	
	НаДату = ПолучитьДатуДляАнализаЗадолженности(ПараметрыПоиска);
	
	ТаблицаОтбора = ПолучитьТаблицуОтбораДляАнализаЗадолженности(ТаблицаОписи, ПараметрыПоиска, ИменаКолонок);
	
	АнализЗадолженности = КонтрольИсполненияДоговоров.АнализЗадолженности(
		ПараметрыПоиска.Организация,
		НаДату,
		ТаблицаОтбора,
		Перечисления.ВидыЗадолженности.Дебиторская);
	
	АнализЗадолженности.Свернуть(ИменаКолонок.СверткаТаблицыАнализаЗадолженности,
		"Остаток,Краткосрочная,Долгосрочная,Просроченная");
	
	АнализЗадолженности.Индексы.Добавить(ИменаКолонок.ПоискВАнализеЗадолженности);
	
	Возврат АнализЗадолженности;
	
КонецФункции

Функция ПолучитьТаблицуОтбораДляАнализаЗадолженности(ТаблицаОписи, ПараметрыПоиска, ИменаКолонок)
	
	ТаблицаОтбора = ТаблицаОписи.Скопировать(, ИменаКолонок.СверткаТаблицыОтбора);
	
	ТаблицаОтбора.Свернуть(ИменаКолонок.СверткаТаблицыОтбора);
	
	ТаблицаОтбора.Колонки.Счет.Имя = "СчетРасчетов";
	
	Возврат ТаблицаОтбора;
	
КонецФункции

Функция ПолучитьИменаКолонокДляАнализаЗадолженности(ПараметрыПоиска)
	
	СовпадающиеБезСчета = "Контрагент,Договор,КПС,КФО,Валюта" + ?(ПараметрыПоиска.ИспользоватьУчетПоИФО, ",ИФО", "");
	
	СверткаТаблицыОтбора = СовпадающиеБезСчета + ",Счет";
	
	ПоискВАнализеЗадолженности = СовпадающиеБезСчета + ",СчетРасчетов,ВидРасчетов";
	
	СверткаТаблицыАнализаЗадолженности = ПоискВАнализеЗадолженности + ",СрокИсполнения";
	
	ИменаКолонок = Новый Структура();
	ИменаКолонок.Вставить("СверткаТаблицыОтбора", СверткаТаблицыОтбора);
	ИменаКолонок.Вставить("ПоискВАнализеЗадолженности", ПоискВАнализеЗадолженности);
	ИменаКолонок.Вставить("СверткаТаблицыАнализаЗадолженности", СверткаТаблицыАнализаЗадолженности);
	
	Возврат ИменаКолонок;
	
КонецФункции

Функция ПолучитьДатуДляАнализаЗадолженности(ПараметрыПоиска)
	
	ДатаОстатков = ПараметрыПоиска.ДатаОстатков;
	
	Если ТипЗнч(ДатаОстатков) = Тип("Граница") Тогда
		ДатаОстатков = ДатаОстатков.Значение;
	КонецЕсли;
	
	Возврат КонецДня(ДатаОстатков);
	
КонецФункции

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеОписи(СтрокаОписи, АнализЗадолженности, ПараметрыПоиска, ИменаКолонок, СпискиВидовРасчета, ТаблицаСумм)
	
	ЗаполненныеВидыРасчетов = ПолучитьЗаполненныеВидыРасчетовПоБухУчету(СтрокаОписи);
	
	Если ЗаполненныеВидыРасчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УказанаИностраннаяВалюта = ПараметрыПоиска.ИспользоватьВалютныйУчет И СтрокаОписи.Валюта <> ПараметрыПоиска.ВалютаРУ;
	
	МаксимальнаяДатаИсполнения = '00010101';
	
	ПросроченнаяЗадолженностьУстановлена = Ложь;
	
	Для Каждого ВидРасчетов Из ЗаполненныеВидыРасчетов Цикл
		СписокВидаРасчетов = СпискиВидовРасчета.Получить(ВидРасчетов);
	
		РезультатАнализа = НайтиСтрокиАнализаПоСтрокеОписи(СтрокаОписи, АнализЗадолженности, ПараметрыПоиска, ИменаКолонок,
			СписокВидаРасчетов, ТаблицаСумм);
		
		ИтогДолгосрочная = РезультатАнализа.ИтогДолгосрочная;
		ИтогПросроченная = РезультатАнализа.ИтогПросроченная;
		
		ОстатокИзОписи = СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "", ?(УказанаИностраннаяВалюта, "Валютная", ""))];
		
		Если РезультатАнализа.ИтогОстаток <= 0 Или ОстатокИзОписи <> РезультатАнализа.ИтогОстаток Тогда
		//***Если РезультатАнализа.ИтогОстаток = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаИсполнения = РезультатАнализа.МаксимальныйСрокИсполнения;
		
		Если Не ЗначениеЗаполнено(ИтогДолгосрочная)
			И Не ЗначениеЗаполнено(ИтогПросроченная)
			И Не ЗначениеЗаполнено(ДатаИсполнения) Тогда
			Продолжить;
		КонецЕсли;
		
		Если УказанаИностраннаяВалюта Тогда
			// Расчеты в валюте.
			КурсВалютыРасчетов = ПолучитьКурсВалютыРасчетов(СтрокаОписи, ВидРасчетов);
			
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Долгосрочная", "Валютная")]	= ИтогДолгосрочная;
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Долгосрочная", "")]			= ИтогДолгосрочная * КурсВалютыРасчетов;
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная")]	= ИтогПросроченная;
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Просроченная", "")]			= ИтогПросроченная * КурсВалютыРасчетов;
		Иначе
			// Расчеты в рублях.
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Долгосрочная", "")]	= ИтогДолгосрочная;
			СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "Просроченная", "")]	= ИтогПросроченная;
		КонецЕсли;
		
		МаксимальнаяДатаИсполнения = Макс(ДатаИсполнения, МаксимальнаяДатаИсполнения);
		
		ИмяПоляКоличествоПодстрок = СтрШаблон("КоличествоПодстрок%1", ВидРасчетов);
		
		Если ЗначениеЗаполнено(ИтогДолгосрочная) Тогда
			СтрокаОписи[ИмяПоляКоличествоПодстрок] = СтрокаОписи[ИмяПоляКоличествоПодстрок] + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИтогПросроченная) Тогда
			СтрокаОписи[ИмяПоляКоличествоПодстрок] = СтрокаОписи[ИмяПоляКоличествоПодстрок] + 1;
		КонецЕсли;
		
		СтрокаОписи.МаксимальноеКоличествоПодстрок = Макс(
			СтрокаОписи.МаксимальноеКоличествоПодстрок,
			СтрокаОписи[ИмяПоляКоличествоПодстрок]);
		
		ПросроченнаяЗадолженностьУстановлена = Истина;
	КонецЦикла;
	
	Если ПросроченнаяЗадолженностьУстановлена Тогда
		СтрокаОписи.ДатаИсполнения = МаксимальнаяДатаИсполнения;
		
		СтрокаОписи.ПросроченнаяЗадолженностьУстановлена = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКурсВалютыРасчетов(СтрокаОписи, ВидРасчетов)
	
	// Считаем, что график (в валюте) задан на весь остаток задолженности по счету расчетов (в рублях) => расчет через пропорцию. 
	СуммаВал = СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
	
	Если ЗначениеЗаполнено(СуммаВал) Тогда
		Возврат СтрокаОписи[ИмяПоляСумма(ВидРасчетов, "", "")] / СуммаВал;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция НайтиСтрокиАнализаПоСтрокеОписи(СтрокаОписи, АнализЗадолженности, ПараметрыПоиска, ИменаКолонок, СписокВидаРасчетов, ТаблицаСумм)
	
	ТаблицаСумм = ТаблицаСумм.СкопироватьКолонки();
	
	ПустаяДата = '00010101';
	
	МаксимальныйСрокИсполнения = ПустаяДата;
	
	МассивСтрок = НайтиСтрокиАнализаЗадолженности(АнализЗадолженности, СтрокаОписи, ИменаКолонок, СписокВидаРасчетов);
	
	Для Каждого СтрокаАнализаЗадолженности Из МассивСтрок Цикл
		Если СтрокаАнализаЗадолженности.Остаток = 0 Тогда
			Продолжить; // Пропускаем строки, на которые не распределены остатки задолженности.
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСумм.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАнализаЗадолженности);
		
		СрокИсполнения = ?(ЗначениеЗаполнено(СтрокаАнализаЗадолженности.СрокИсполнения), СтрокаАнализаЗадолженности.СрокИсполнения, ПустаяДата);
		
		МаксимальныйСрокИсполнения = Макс(СрокИсполнения, МаксимальныйСрокИсполнения);
	КонецЦикла;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ТаблицаСумм",		ТаблицаСумм);
	Результат.Вставить("ИтогОстаток",		ТаблицаСумм.Итог("Остаток"));
	Результат.Вставить("ИтогДолгосрочная",	ТаблицаСумм.Итог("Долгосрочная"));
	Результат.Вставить("ИтогПросроченная",	ТаблицаСумм.Итог("Просроченная"));

	Результат.Вставить("МаксимальныйСрокИсполнения", МаксимальныйСрокИсполнения);
	
	Возврат Результат;
	
КонецФункции

Функция НовыйТаблицаСуммИзАнализаЗадолженности()
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	ТаблицаСумм = Новый ТаблицаЗначений();
	ТаблицаСумм.Колонки.Добавить("СрокИсполнения",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаСумм.Колонки.Добавить("Остаток",			ТипСумма);
	ТаблицаСумм.Колонки.Добавить("Долгосрочная",	ТипСумма);
	ТаблицаСумм.Колонки.Добавить("Просроченная",	ТипСумма);
	
	Возврат ТаблицаСумм;
	
КонецФункции
	
Функция ПолучитьЗаполненныеВидыРасчетовПоБухУчету(СтрокаОписи)
	
	ВидыРасчетов = Новый Массив();
	
	Если ЗначениеЗаполнено(СтрокаОписи.СуммаОДВалютная) Или ЗначениеЗаполнено(СтрокаОписи.СуммаОД) Тогда
		ВидыРасчетов.Добавить("ОД");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОписи.СуммаПроцентовВалютная) Или ЗначениеЗаполнено(СтрокаОписи.СуммаПроцентов) Тогда
		ВидыРасчетов.Добавить("Процентов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОписи.СуммаШтрафовВалютная) Или ЗначениеЗаполнено(СтрокаОписи.СуммаШтрафов) Тогда
		ВидыРасчетов.Добавить("Штрафов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОписи.СуммаПенейВалютная) Или ЗначениеЗаполнено(СтрокаОписи.СуммаПеней) Тогда
		ВидыРасчетов.Добавить("Пеней");
	КонецЕсли;
	
	Возврат ВидыРасчетов;
	
КонецФункции

Функция ПолучитьСпискиВидовРасчетаВсехКолонок()
	
	Списки = Новый Соответствие();
	
	Списки.Вставить("ОД", ПолучитьСписокВидовРасчетаДляКолонкиОД());
	Списки.Вставить("Процентов", ПолучитьСписокВидовРасчетаДляКолонкиПроцентов());
	Списки.Вставить("Штрафов", ПолучитьСписокВидовРасчетаДляКолонкиШтрафов());
	Списки.Вставить("Пеней", ПолучитьСписокВидовРасчетаДляКолонкиПеней());
	
	Возврат Списки;
	
КонецФункции

Функция НайтиСтрокиАнализаЗадолженности(АнализЗадолженности, СтрокаОписи, ИменаКолонок, СписокВидаРасчетов)
	
	СтрокиАнализаЗадолженности = Новый Массив();
	
	Для Каждого ВидРасчетов Из СписокВидаРасчетов Цикл
		Поиск = Новый Структура(ИменаКолонок.ПоискВАнализеЗадолженности);
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаОписи);
		
		Поиск.ВидРасчетов = ВидРасчетов;
		Поиск.СчетРасчетов = СтрокаОписи.Счет;
		
		МассивСтрок = АнализЗадолженности.НайтиСтроки(Поиск);
		
		Если СтрокиАнализаЗадолженности.Количество() = 0 Тогда
			СтрокиАнализаЗадолженности = МассивСтрок;
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиАнализаЗадолженности, МассивСтрок);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокиАнализаЗадолженности;
	
КонецФункции

Процедура ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ДатаИнвентаризации)
	
	Поиск = Новый Структура("ПросроченнаяЗадолженностьУстановлена", Ложь);
	
	МассивСтрок = ТаблицаОписи.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КонецПериодаКраткосрочнойЗадолженности = КонецДня(ДобавитьМесяц(ДатаИнвентаризации, 12));
	ДатаИсполненияПриНевозможностиУстановления = ИнвентаризацияКлиентСервер.ПолучитьДатуИсполненияПриНевозможностиУстановления();
	
	ВремТЗ = ТаблицаОписи.Скопировать(МассивСтрок, "Договор");
	ВремТЗ.Свернуть("Договор");
	
	СписокДоговоров = ВремТЗ.ВыгрузитьКолонку("Договор");
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		// Считываем регистр сведений СрокиИсполненияИСуммыОбязательствСрезПоследних.
		ТаблицаСвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаИнвентаризации);
	Иначе
		// Считываем свойства договора.
		ТаблицаСвойстваДоговоров = ИнвентаризацияСервер.ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Поиск = Новый Структура("Договор");
	
	Для Каждого СтрокаОписи Из МассивСтрок Цикл
		СтрокаОписи.ПросроченнаяЗадолженностьУстановлена = Истина;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаОписи);
		
		МассивСвойств = ТаблицаСвойстваДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСвойств.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваДоговора = МассивСвойств[0];
		
		ОкончаниеДоговора = СвойстваДоговора.ОкончаниеДоговора;
		ДоговорПросрочен = СвойстваДоговора.ДоговорПросрочен;
		
		СтрокаОписи.ДатаИсполнения = ОкончаниеДоговора;
		
		УказаноЗначениеДоговорПросрочен = (ТипЗнч(ДоговорПросрочен) = Тип("Булево"));
		УказаноЗначениеОкончаниеДоговора = (ТипЗнч(ОкончаниеДоговора) = Тип("Дата"));
		
		ЗадолженностьПросроченная = Ложь;
		ЗадолженностьДолгосрочная = Ложь;
		
		Если УказаноЗначениеОкончаниеДоговора И ЗначениеЗаполнено(ОкончаниеДоговора) Тогда
			Если КонецПериодаКраткосрочнойЗадолженности < ОкончаниеДоговора
				И ОкончаниеДоговора < ДатаИсполненияПриНевозможностиУстановления Тогда
				ЗадолженностьДолгосрочная = Истина;
				
			ИначеЕсли ОкончаниеДоговора < ДатаИнвентаризации Тогда
				ЗадолженностьПросроченная = Истина;
			КонецЕсли;
			
		ИначеЕсли УказаноЗначениеДоговорПросрочен Тогда
			ЗадолженностьПросроченная = ДоговорПросрочен;
		КонецЕсли;
		
		Если ЗадолженностьПросроченная Тогда
			СтрокаОписи.СуммаОДПросроченнаяВалютная			= СтрокаОписи.СуммаОДВалютная;
			СтрокаОписи.СуммаОДПросроченная					= СтрокаОписи.СуммаОД;
			
			СтрокаОписи.СуммаПроцентовПросроченнаяВалютная	= СтрокаОписи.СуммаПроцентовВалютная;
			СтрокаОписи.СуммаПроцентовПросроченная			= СтрокаОписи.СуммаПроцентов;
			
			СтрокаОписи.СуммаШтрафовПросроченнаяВалютная	= СтрокаОписи.СуммаШтрафовВалютная;
			СтрокаОписи.СуммаШтрафовПросроченная			= СтрокаОписи.СуммаШтрафов;
			
			СтрокаОписи.СуммаПенейПросроченнаяВалютная		= СтрокаОписи.СуммаПенейВалютная;
			СтрокаОписи.СуммаПенейПросроченная				= СтрокаОписи.СуммаПеней;
			
		ИначеЕсли ЗадолженностьДолгосрочная Тогда
			СтрокаОписи.СуммаОДДолгосрочнаяВалютная			= СтрокаОписи.СуммаОДВалютная;
			СтрокаОписи.СуммаОДДолгосрочная					= СтрокаОписи.СуммаОД;
			
			СтрокаОписи.СуммаПроцентовДолгосрочнаяВалютная	= СтрокаОписи.СуммаПроцентовВалютная;
			СтрокаОписи.СуммаПроцентовДолгосрочная			= СтрокаОписи.СуммаПроцентов;
			
			СтрокаОписи.СуммаШтрафовДолгосрочнаяВалютная	= СтрокаОписи.СуммаШтрафовВалютная;
			СтрокаОписи.СуммаШтрафовДолгосрочная			= СтрокаОписи.СуммаШтрафов;
			
			СтрокаОписи.СуммаПенейДолгосрочнаяВалютная		= СтрокаОписи.СуммаПенейВалютная;
			СтрокаОписи.СуммаПенейДолгосрочная				= СтрокаОписи.СуммаПеней;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ФрагментыСтрокиРаздела2

Функция РассчитатьФрагментыСтроки(ТаблицаФрагментовСтрок, СтрокаТаблицы, Знач ПараметрыЗаполнения, КомпонентыСумм)
	
	Перем МаксимальноеКоличествоКомпонент;
	
	// Фрагменты строки образуются только при необходимости разбить исходную строку на 2 и более подстроки.
	
	КомпонентыСумм = ВыделитьКомпонентыСумм(СтрокаТаблицы, МаксимальноеКоличествоКомпонент);
	
	Если МаксимальноеКоличествоКомпонент = 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	
	СтрокаТаблицы.ИдентификаторСтроки = ИдентификаторСтроки;
	
	СтрокаПервогоФрагмента = Неопределено;
	
	Для Счетчик = 1 По МаксимальноеКоличествоКомпонент Цикл
		НоваяСтрока = ТаблицаФрагментовСтрок.Добавить();
		
		Если Счетчик = 1 Тогда
			СтрокаПервогоФрагмента = НоваяСтрока;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, ПараметрыЗаполнения.ИменаВсехЧисловыхКолонокРаздела1);
		
		Для Каждого Элемент Из КомпонентыСумм Цикл
			ВидРасчетов		= Элемент.Ключ;
			КомпонентыСуммы	= Элемент.Значение;
			
			Если КомпонентыСуммы.Количество() < Счетчик Тогда
				Продолжить;
			КонецЕсли;
			
			КомпонентаСуммы = КомпонентыСуммы[Счетчик - 1];
			
			НоваяСтрока[ИмяПоляСумма(ВидРасчетов, "", "Валютная")]	= КомпонентаСуммы.СуммаВал;
			НоваяСтрока[ИмяПоляСумма(ВидРасчетов, "", "")]			= КомпонентаСуммы.СуммаРуб;
			НоваяСтрока[ИмяПоляСтатусЗадолженности(ВидРасчетов)]	= КомпонентаСуммы.СтатусЗадолженности;
		КонецЦикла;
		
		Если ПараметрыЗаполнения.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
			Если Счетчик = 1 Тогда
				ЗаполнитьНеподтвержденныеСуммыСтрокиРаздела2(СтрокаПервогоФрагмента);
			Иначе
				УвеличитьНеподтвержденныеСуммыСтрокиРаздела2(СтрокаПервогоФрагмента, НоваяСтрока);
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьВсеИтоги(НоваяСтрока);
	КонецЦикла;
	
	ЗаполнитьВсеИтоги(СтрокаПервогоФрагмента);
	
	Возврат Истина;
	
КонецФункции

Функция ВыделитьКомпонентыСумм(Знач СтрокаРаздела2, МаксимальноеКоличествоКомпонент)
	
	КомпонентыСумм = Новый Структура();
	
	МаксимальноеКоличествоКомпонент = 0;
	
	ЗаполненныеВидыРасчетов = ПолучитьЗаполненныеВидыРасчетов(СтрокаРаздела2);
	
	Для Каждого ВидРасчетов Из ЗаполненныеВидыРасчетов Цикл
		КомпонентыСуммы = ВыделитьКомпонентыСуммыДляВидаСчетов(СтрокаРаздела2, ВидРасчетов);
		
		КомпонентыСумм.Вставить(ВидРасчетов, КомпонентыСуммы);
		
		МаксимальноеКоличествоКомпонент = Макс(КомпонентыСуммы.Количество(), МаксимальноеКоличествоКомпонент);
	КонецЦикла;
	
	Возврат КомпонентыСумм;
	
КонецФункции

Функция ВыделитьКомпонентыСуммыДляВидаСчетов(СтрокаРаздела2, ВидРасчетов)
	
	КомпонентыСуммы = Новый Массив();
	
	ДолгосрочнаяВал = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "Долгосрочная", "Валютная")];
	ДолгосрочнаяРуб = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "Долгосрочная", "")];
	
	Если ЗначениеЗаполнено(ДолгосрочнаяВал) Или ЗначениеЗаполнено(ДолгосрочнаяРуб) Тогда
		КомпонентаСуммы = НовыйОписаниеКомпонентыСуммы();
		
		КомпонентаСуммы.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Долгосрочная;
		КомпонентаСуммы.СуммаВал = ДолгосрочнаяВал;
		КомпонентаСуммы.СуммаРуб = ДолгосрочнаяРуб;
		
		КомпонентыСуммы.Добавить(КомпонентаСуммы);
	КонецЕсли;
	
	ПросроченнаяВал = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная")];
	ПросроченнаяРуб = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "Просроченная", "")];
	
	Если ЗначениеЗаполнено(ПросроченнаяВал) Или ЗначениеЗаполнено(ПросроченнаяРуб) Тогда
		КомпонентаСуммы = НовыйОписаниеКомпонентыСуммы();
		
		КомпонентаСуммы.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Просроченная;
		КомпонентаСуммы.СуммаВал = ПросроченнаяВал;
		КомпонентаСуммы.СуммаРуб = ПросроченнаяРуб;
		
		КомпонентыСуммы.Добавить(КомпонентаСуммы);
	КонецЕсли;
	
	ЕстьДолгосрочнаяИлиПросроченная = КомпонентыСуммы.Количество() > 0;
	
	БухУчетВал = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
	БухУчетРуб = СтрокаРаздела2[ИмяПоляСумма(ВидРасчетов, "", "")];
	
	ЭтоИностраннаяВалюта = ЗначениеЗаполнено(БухУчетВал);
	
	ТекущаяВал = БухУчетВал - ДолгосрочнаяВал - ПросроченнаяВал;
	ТекущаяРуб = БухУчетРуб - ДолгосрочнаяРуб - ПросроченнаяРуб;
	
	Если ЗначениеЗаполнено(ТекущаяВал) Или ЗначениеЗаполнено(ТекущаяРуб) Тогда
		КомпонентаСуммы = НовыйОписаниеКомпонентыСуммы();
		
		Если ЭтоИностраннаяВалюта И ЕстьДолгосрочнаяИлиПросроченная Тогда
			КурсВалютыРасчетов = ПолучитьКурсВалютыРасчетов(СтрокаРаздела2, ВидРасчетов);
			
			ТекущаяРуб = Окр(ТекущаяВал * КурсВалютыРасчетов, 2);
		КонецЕсли;
		
		КомпонентаСуммы.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Текущая;
		КомпонентаСуммы.СуммаВал = ТекущаяВал;
		КомпонентаСуммы.СуммаРуб = ТекущаяРуб;
		
		КомпонентыСуммы.Вставить(0, КомпонентаСуммы);
	КонецЕсли;
	
	Если ЭтоИностраннаяВалюта
		И КомпонентыСуммы.Количество() > 1
		И ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме() Тогда
		
		ТекущийИтог = ДолгосрочнаяРуб + ПросроченнаяРуб + ТекущаяРуб;
		
		Если ТекущийИтог <> БухУчетРуб Тогда
			КомпонентаСуммы = ИнвентаризацияКлиентСервер.ПолучитьЭлементКоллекцииСМаксимальнымЗначениемПоказателяПоМодулю(
				КомпонентыСуммы, "СуммаРуб");
				
			КомпонентаСуммы.СуммаРуб = БухУчетРуб - (ТекущийИтог - КомпонентаСуммы.СуммаРуб);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КомпонентыСуммы;
	
КонецФункции

Функция ПолучитьЗаполненныеВидыРасчетов(СтрокаТаблицы)
	
	ВидыРасчетов = Новый Массив();
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОД)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДПросроченнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДПросроченная)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДДолгосрочнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаОДДолгосрочная) Тогда
		ВидыРасчетов.Добавить("ОД");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентов)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовПросроченнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовПросроченная)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовДолгосрочнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПроцентовДолгосрочная) Тогда
		ВидыРасчетов.Добавить("Процентов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафов)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовПросроченнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовПросроченная)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовДолгосрочнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаШтрафовДолгосрочная) Тогда
		ВидыРасчетов.Добавить("Штрафов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПеней)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейПросроченнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейПросроченная)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейДолгосрочнаяВалютная) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаПенейДолгосрочная) Тогда
		ВидыРасчетов.Добавить("Пеней");
	КонецЕсли;
	
	Возврат ВидыРасчетов;
	
КонецФункции

Функция НовыйОписаниеКомпонентыСуммы()
	
	ОписаниеФрагмента = Новый Структура("СтатусЗадолженности,СуммаВал,СуммаРуб", Неопределено, 0, 0);
	
	Возврат ОписаниеФрагмента;
	
КонецФункции

Процедура ЗаполнитьСтрокуПоВыделеннымКомпонентамСумм(СтрокаТаблицы, КомпонентыСумм, ПараметрыЗаполнения)
	
	Перем КомпонентыСуммы;
	
	// Здесь если есть компоненты суммы, то только одно значение (уже проверено ранее).
	// Статусом задолженности по умолчанию является "Текущая".
	СтатусТекущая = Перечисления.СтатусыЗадолженности.Текущая;
	
	Если СтрокаТаблицы.СуммаОДВалютная <> 0 Или СтрокаТаблицы.СуммаОД <> 0 Тогда
		Если КомпонентыСумм.Свойство("ОД", КомпонентыСуммы) Тогда
			СтатусЗадолженности = КомпонентыСуммы[0].СтатусЗадолженности;
		Иначе
			СтатусЗадолженности = СтатусТекущая;
		КонецЕсли;
		СтрокаТаблицы.СтатусЗадолженностиОД = СтатусЗадолженности;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПроцентовВалютная <> 0 Или СтрокаТаблицы.СуммаПроцентов <> 0 Тогда
		Если КомпонентыСумм.Свойство("Процентов", КомпонентыСуммы) Тогда
			СтатусЗадолженности = КомпонентыСуммы[0].СтатусЗадолженности;
		Иначе
			СтатусЗадолженности = СтатусТекущая;
		КонецЕсли;
		СтрокаТаблицы.СтатусЗадолженностиПроцентов = СтатусЗадолженности;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаШтрафовВалютная <> 0 Или СтрокаТаблицы.СуммаШтрафов <> 0 Тогда
		Если КомпонентыСумм.Свойство("Штрафов", КомпонентыСуммы) Тогда
			СтатусЗадолженности = КомпонентыСуммы[0].СтатусЗадолженности;
		Иначе
			СтатусЗадолженности = СтатусТекущая;
		КонецЕсли;
		СтрокаТаблицы.СтатусЗадолженностиШтрафов = СтатусЗадолженности;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПенейВалютная <> 0 Или СтрокаТаблицы.СуммаПеней <> 0 Тогда
		Если КомпонентыСумм.Свойство("Пеней", КомпонентыСуммы) Тогда
			СтатусЗадолженности = КомпонентыСуммы[0].СтатусЗадолженности;
		Иначе
			СтатусЗадолженности = СтатусТекущая;
		КонецЕсли;
		СтрокаТаблицы.СтатусЗадолженностиПеней = СтатусЗадолженности;
	КонецЕсли;
	
	ЗаполнитьПросроченныеСуммыСтрокиРаздела2(СтрокаТаблицы, ПараметрыЗаполнения);
	
КонецПроцедуры

Процедура ДобавитьФрагментыСтрок(ТаблицаРаздела2, ТаблицаФрагментовСтрок, ПараметрыЗаполнения)
	
	// Фрагменты замещают собой исходную строку.
	
	КоличествоСтрокФрагментов = ТаблицаФрагментовСтрок.Количество();
	
	ПрежнийНомерСтроки = Неопределено;
	
	Для Счетчик = 1 По КоличествоСтрокФрагментов Цикл
		СтрокаФрагмента = ТаблицаФрагментовСтрок[КоличествоСтрокФрагментов - Счетчик];
		
		НомерСтроки = СтрокаФрагмента.НомерСтроки;
		
		ИндексСтроки = НомерСтроки - 1;
		
		Если ПрежнийНомерСтроки <> НомерСтроки Тогда
			ПрежнийНомерСтроки = НомерСтроки;
			
			ТаблицаРаздела2.Удалить(ИндексСтроки);
		КонецЕсли;
		
		СтрокаТаблицы = ТаблицаРаздела2.Вставить(ИндексСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаФрагмента);
		
		ЗаполнитьПросроченныеСуммыСтрокиРаздела2(СтрокаТаблицы, ПараметрыЗаполнения);
		
		ЗаполнитьВсеИтоги(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ПолучитьОбщиеПараметрыПроверкиВсехРазделов()
	
	ОбщиеПараметры = Новый Структура();
	ОбщиеПараметры.Вставить("ИспользоватьВалютныйУчет",	ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ОбщиеПараметры.Вставить("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ОбщиеПараметры.Вставить("ПостфиксыВидовРасчета",	ПолучитьПостфиксыВидовРасчета());
	ОбщиеПараметры.Вставить("ПостфиксыВидовСуммы",		ПолучитьПостфиксыВидовСуммы());
	ОбщиеПараметры.Вставить("МетаданныеРаздел2",		Метаданные.Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ТабличныеЧасти.Раздел2);
	ОбщиеПараметры.Вставить("ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме",
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме());
		
	ОбщиеПараметры.Вставить("ПредставлениеТаблицыФрагментовСтроки",	НСтр("ru='Фрагменты строки'"));
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Процедура ПроверитьРаздел2(ДокументОбъект, ОбщиеПараметры, ЕстьОшибки)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел2 Цикл
		ПроверитьРаздел2_ЗаполненыСтатусыЗадолженности(ДокументСсылка, СтрокаТаблицы, ОбщиеПараметры, ЕстьОшибки);
		
		ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(ДокументСсылка, СтрокаТаблицы, ОбщиеПараметры, ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_ЗаполненыСтатусыЗадолженности(ДокументСсылка, СтрокаТаблицы, ОбщиеПараметры, ЕстьОшибки, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Статус задолженности должен быть указан при наличии суммы по данным бух.учета.
	
	Если ЭтоФормаРазбивкиСтроки Тогда
		ИмяРеквизитаТаблицы = "ТаблицаФрагментыСтроки";
		ИмяСписка = ОбщиеПараметры.ПредставлениеТаблицыФрагментовСтроки;
		ПутьКДанным = "";
	Иначе
		ИмяРеквизитаТаблицы = "Раздел2";
		ИмяСписка = ОбщиеПараметры.МетаданныеРаздел2.Синоним;
		ПутьКДанным = "Объект";
	КонецЕсли;
	
	ПостфиксВидаСуммы = "";
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ИмяПоляВалютная	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная");
		ИмяПоля			= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "");
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляВалютная]) И Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляСтатус = ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета);
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляСтатус]) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоляСтатус].Синоним,
				СтрокаТаблицы.НомерСтроки,
				ИмяСписка);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяРеквизитаТаблицы, СтрокаТаблицы.НомерСтроки, ИмяПоляСтатус),
				ПутьКДанным, ЕстьОшибки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(ДокументСсылка, СтрокаТаблицы, ОбщиеПараметры, ЕстьОшибки, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Реквизиты акта сверки должны быть указаны при наличии любой подтвержденной суммы.
	
	ПостфиксВидаСуммы = "Подтвержденная";
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ИмяПоляВалютная	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная");
		ИмяПоля			= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "");
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляВалютная]) И Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляДата		= ИмяПоляДатаАктаСверки(ПостфиксВидаРасчета);
		ИмяПоляНомер	= ИмяПоляНомерАктаСверки(ПостфиксВидаРасчета);
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляДата]) Тогда
			Если ЭтоФормаРазбивкиСтроки Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоляДата].Синоним);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаИсходнаяСтрока", 1, ИмяПоляДата),
					, ЕстьОшибки);
			Иначе
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоляДата].Синоним,
					СтрокаТаблицы.НомерСтроки,
					ОбщиеПараметры.МетаданныеРаздел2.Синоним);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел2", СтрокаТаблицы.НомерСтроки, ИмяПоляДата),
					"Объект", ЕстьОшибки);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляНомер]) Тогда
			Если ЭтоФормаРазбивкиСтроки Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоляНомер].Синоним);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаИсходнаяСтрока", 1, ИмяПоляНомер),
					, ЕстьОшибки);
			Иначе
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоляНомер].Синоним,
					СтрокаТаблицы.НомерСтроки,
					ОбщиеПараметры.МетаданныеРаздел2.Синоним);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел2", СтрокаТаблицы.НомерСтроки, ИмяПоляНомер),
					"Объект", ЕстьОшибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_ЗаполненыСуммыФрагментовСтроки(ДокументСсылка, СтрокаТаблицы, ОбщиеПараметры, ЕстьОшибки)
	
	// Статус задолженности должен быть указан при наличии суммы по данным бух.учета.
	
	ИмяРеквизитаТаблицы = "ТаблицаФрагментыСтроки";
	ИмяСписка = ОбщиеПараметры.ПредставлениеТаблицыФрагментовСтроки;
	ПутьКДанным = "";
	
	ПостфиксВидаСуммы = "";
	
	ЕстьЗаполненные = Ложь;
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ИмяПоляВалютная	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная");
		ИмяПоля			= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "");
		
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляВалютная]) Или ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			ЕстьЗаполненные = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьЗаполненные Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоляСтатус = ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета);
	
	ТекстСообщения = СтрШаблон(НСтр("ru='В строке %1 все суммы нулевые'"), СтрокаТаблицы.НомерСтроки);
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяРеквизитаТаблицы, СтрокаТаблицы.НомерСтроки, "НомерСтроки"),
		ПутьКДанным, ЕстьОшибки);
	
КонецПроцедуры

Процедура ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки)
	
	// Итоги по таблице должны совпадать с разбиваемой суммой.
	
	ЭтоИностраннаяВалюта = (ФормаРазбивкиСтроки.Валюта <> ОбщиеПараметры.ВалютаРУ);
	
	ПостфиксВалютная = ?(ЭтоИностраннаяВалюта, "Валютная", "");
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам_ПроверитьВидРасчетов(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки,
			ПостфиксВидаРасчета, ПостфиксВалютная);
		
		Если ЭтоИностраннаяВалюта И ОбщиеПараметры.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
			// Проверяем также равенство рублевых итогов.
			ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам_ПроверитьВидРасчетов(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки,
				ПостфиксВидаРасчета, "");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам_ПроверитьВидРасчетов(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки, ПостфиксВидаРасчета, ПостфиксВалютная)
	
	ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, "", ПостфиксВалютная);
	
	РазбиваемаяСумма	= ФормаРазбивкиСтроки["ИсходнаяСтрока" + ИмяПоля];
	ИтогПоТаблице		= ФормаРазбивкиСтроки["Итог" + ИмяПоля];
	
	Если ИтогПоТаблице <> РазбиваемаяСумма Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Итог по колонке ""%1"" (%2) отличается от разбиваемой суммы (%3) исходной строки'"),
			ОбщиеПараметры.МетаданныеРаздел2.Реквизиты[ИмяПоля].Синоним,
			Формат(ИтогПоТаблице, "ЧДЦ=2"),
			Формат(РазбиваемаяСумма, "ЧДЦ=2"));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
			"Итог" + ИмяПоля,, ЕстьОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтроки

