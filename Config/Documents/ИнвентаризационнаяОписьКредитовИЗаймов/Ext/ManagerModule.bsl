Процедура ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Валютные суммы недоступны при указании валюты Рубль.
	
	ПутьКДанным = ?(ЭтоФормаРазбивкиСтроки, "", "Объект.") + ИмяТЧ;
	
	Для Каждого ПостфиксВидаСуммы Из ОбщиеПараметры.ПостфиксыВидовСуммы Цикл
		Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
			ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная");
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность валютных сумм (%1, %2)'"), ИмяПоля, ИмяТЧ);
			
			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Условие.ПравоеЗначение = ОбщиеПараметры.ВалютаРУ;
			
			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
			
			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
			
			Если ЭтоФормаРазбивкиСтроки И ИмяТЧ = "ТаблицаФрагментыСтроки" Тогда
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
				
			ИначеЕсли ИмяТЧ = "Раздел2" Тогда
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "СуммаИтого" + ПостфиксВидаСуммы + "Валютная");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Рублевые суммы недоступны и рассчитываются автоматически при указании иностранной валюты.
	
	ПутьКДанным = ?(ЭтоФормаРазбивкиСтроки, "", "Объект.") + ИмяТЧ;
	
	Для Каждого ПостфиксВидаСуммы Из ОбщиеПараметры.ПостфиксыВидовСуммы Цикл
		Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
			ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "");
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность валютных сумм (%1, %2)'"), ИмяПоля, ИмяТЧ);
			
			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
			
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
			Условие.ПравоеЗначение = ОбщиеПараметры.ВалютаРУ;
			
			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
			
			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
			
			Если ЭтоФормаРазбивкиСтроки И ИмяТЧ = "ТаблицаФрагментыСтроки" Тогда
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_ПоляФрагментовСтрокиРедактируемыеСОткрытиемФормы(УсловноеОформление)
	
	ИменаПолейСОткрытием = ПолучитьИменаПолейРаздела2РедактируемыхСОткрытиемФормыРазбивкиСтроки();
	
	ШрифтНаклонный = Новый Шрифт(,,,Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение полей во фрагментах разбитой строки, редактируемых с открытием формы разбивки'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Раздел2.ПризнакФрагментаСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтНаклонный);
	
	// Оформляемые поля
	Для Каждого ИмяПоля Из ИменаПолейСОткрытием Цикл
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Раздел2" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьСуммФрагментов(УсловноеОформление, ОбщиеПараметры)
	
	// Если разбиваемая сумма равна 0, то ее нельзя разбивать и редактировать ее фрагменты.
	
	ИмяТЧ = "ТаблицаФрагментыСтроки";
	
	ПостфиксВидаСуммы = "";
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ИменаПолей = Новый Массив();
		ИменаПолей.Добавить(ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная"));
		ИменаПолей.Добавить(ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ""));
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступно указание суммы фрагмента при нулевой сумме бух.учета (Раздел 2, %1)'"), ИмяПоля);
			
			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИсходнаяСтрока" +ИмяПоля);
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
			
			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
			
			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьВидовСуммы(УсловноеОформление, ОбщиеПараметры, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Если сумма по бух.учету равна 0, то нельзя указывать виды суммы Подтвержденная, Неподтвержденная, Просроченная.
	
	Если ЭтоФормаРазбивкиСтроки Тогда
		НачалоПутиКДанным = "ТаблицаИсходнаяСтрока";
		НачалоИмениЭлемента = "ТаблицаИсходнаяСтрока";
	Иначе
		НачалоПутиКДанным = "Объект.Раздел2";
		НачалоИмениЭлемента = "Раздел2";
	КонецЕсли;
	
	Для Каждого ПостфиксВидаСуммы Из ОбщиеПараметры.ПостфиксыВидовСуммы Цикл
		Если ПостфиксВидаСуммы = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
			ИменаПолей = Новый Структура();
			ИменаПолей.Вставить(
				ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, "Валютная"),
				ИмяПоляСумма(ПостфиксВидаРасчета, "", "Валютная"));
			ИменаПолей.Вставить(
				ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ""),
				ИмяПоляСумма(ПостфиксВидаРасчета, "", ""));
			
			Для Каждого Элемент Из ИменаПолей Цикл
				ИмяПоля			= Элемент.Ключ;
				ИмяПоляБухУчета	= Элемент.Значение;
				
				ЭлементУО = УсловноеОформление.Элементы.Добавить();
				ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность поля %1 при нулевой сумме бух.учета (%2)'"), ИмяПоля, НачалоИмениЭлемента);
				
				// Условия
				Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиКДанным + "." + ИмяПоляБухУчета);
				Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				
				// Оформление
				ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
				ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
				ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
				
				// Оформляемые поля
				ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(НачалоИмениЭлемента + ИмяПоля);
				
				Если ЭтоФормаРазбивкиСтроки Тогда
					ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
					ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоляБухУчета);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьРедактированияПросроченныхСумм(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Интерактивное редактирование сумм просроченной задолженности допускается лишь для списка статусов.
	// Для всех остальных статусов интерактивное редактирование просроченной суммы запрещено.
	
	НачалоПутиПоляУсловия = СтрШаблон("%1%2.", ?(ЭтоФормаРазбивкиСтроки, "", "Объект."), ИмяТЧ);
	
	СтатусыДопускающиеРедактирование = Новый СписокЗначений();
	СтатусыДопускающиеРедактирование.ЗагрузитьЗначения(
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы());
	
	Для Каждого ПостфиксВидаРасчета Из ОбщиеПараметры.ПостфиксыВидовРасчета Цикл
		ИмяПоляСтатус = ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета);
		
		ИмяПоляСуммаПросроченнаяВал = ИмяПоляСумма(ПостфиксВидаРасчета, "Просроченная", "Валютная");
		ИмяПоляСуммаПросроченнаяРуб = ИмяПоляСумма(ПостфиксВидаРасчета, "Просроченная", "");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность редактирования просроченных сумм ""%1"" (%2)'"), ПостфиксВидаРасчета, ИмяТЧ);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + ИмяПоляСтатус);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
		Условие.ПравоеЗначение = СтатусыДопускающиеРедактирование;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоляСуммаПросроченнаяВал);
		
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоляСуммаПросроченнаяРуб);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьФлажковТребуетРеклассификации(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Флажок "Требует реклассификации" доступен для редактирования при заполненной просроченной сумме.
	// Если просроченная сумма не заполнена, то флажок недоступен.
	
	НачалоПутиПоляУсловия = СтрШаблон("%1%2.", ?(ЭтоФормаРазбивкиСтроки, "", "Объект."), ИмяТЧ);
	
