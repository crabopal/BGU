Процедура ДобавитьУсловноеОформление_НадписиВидовСуммы(УсловноеОформление, ИмяТЧ)
	
	//
	// Надпись "По данным бух.учета"
	//
	ТекстНадписи = НСтр("ru='По данным бух.учета'");
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Надпись ""%1"" (%2)'"), ТекстНадписи, ИмяТЧ);
	
	// Условия
