	ДобавитьКодНаименованиеСтатусаЗадолженности(ЗначенияПараметров, "ОД", Выборка, ДополнительныеПараметры);
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел2_Часть1");
	
