&НаКлиенте
Процедура ПроверитьРублевыеСуммыФрагментов(Отказ)
	
	СписокИтогов = ПолучитьСписокОтличающихсяИтоговРублевыхСумм();
	
	КоличествоОтличающихсяИтогов = СписокИтогов.Количество();
	
	Если КоличествоОтличающихсяИтогов > 0 Тогда
		Если КоличествоОтличающихсяИтогов = 1 Тогда
			ТекстВопроса = НСтр("ru='Продолжить и заменить указанную сумму в исходной строке на значение итога?'");
		Иначе
			ТекстВопроса = НСтр("ru='Продолжить и заменить указанные суммы в исходной строке на значения итогов?'");
		КонецЕсли;
		
		Отказ = Истина;
		
		Оповещение = Новый ОписаниеОповещения("ПроверитьРублевыеСуммыФрагментовВыбор", ЭтотОбъект);
	
		ТекстСообщения = СтрШаблон(НСтр("ru='Для справки.
			|%1
			|
			|%2'"),
			СтрСоединить(СписокИтогов, ";" + Символы.ПС) + ".",
			ТекстВопроса);
		
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРублевыеСуммыФрагментовВыбор(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Закрыть(ПолучитьВозвращаемоеЗначениеКлиент());
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокОтличающихсяИтоговРублевыхСумм()
	
	СписокИтогов = Новый Массив();
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	ПредставлениеКолонки = "";
	
	Для Каждого ПостфиксВидаРасчета Из ПостфиксыВидовРасчета Цикл
		Если ПостфиксВидаРасчета = "ОД" Тогда
			ПредставлениеКолонки = НСтр("ru='Основной долг, в рублях'");
		ИначеЕсли ПостфиксВидаРасчета = "Процентов" Тогда
			ПредставлениеКолонки = НСтр("ru='Проценты, в рублях'");
		ИначеЕсли ПостфиксВидаРасчета = "Штрафов" Тогда
			ПредставлениеКолонки = НСтр("ru='Штрафы, в рублях'");
		ИначеЕсли ПостфиксВидаРасчета = "Пеней" Тогда
			ПредставлениеКолонки = НСтр("ru='Пени, в рублях'");
		КонецЕсли;
		
		ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, "", "");
		
		РазбиваемаяСумма	= ЭтотОбъект["ИсходнаяСтрока" + ИмяПоля];
		ИтогПоТаблице		= ЭтотОбъект["Итог" + ИмяПоля];
		
		Если ИтогПоТаблице <> РазбиваемаяСумма Тогда
			СписокИтогов.Добавить(СтрШаблон(
				НСтр("ru='Итог по колонке ""%1"" (%2) отличается от разбиваемой суммы (%3) исходной строки'"),
				ПредставлениеКолонки,
				Формат(ИтогПоТаблице, "ЧДЦ=2"),
				Формат(РазбиваемаяСумма, "ЧДЦ=2")));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокИтогов;
	
КонецФункции


#КонецОбласти

#Область ВозвращаемоеЗначение

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		
		Закрыть();
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИПеренестиВДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИПеренестиВДокумент()
	
	Если Не ПроверитьПередЗакрытием() Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Закрыть(ПолучитьВозвращаемоеЗначениеКлиент());
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначениеКлиент()
	
	Возврат ПолучитьВозвращаемоеЗначениеСервер();
	
КонецФункции

&НаСервере
Функция ПолучитьВозвращаемоеЗначениеСервер()
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Таблица = ТаблицаФрагментыСтроки.Выгрузить();
	
	ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	
	Счетчик = 0;
	
	Для Каждого СтруктураСтроки Из ФрагментыСтроки Цикл
		Счетчик = Счетчик + 1;
		
		СтруктураСтроки.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		СтруктураСтроки.Вставить("ПризнакФрагментаСтроки", Истина);
		СтруктураСтроки.Вставить("ПризнакПервогоФрагментаСтроки", (Счетчик = 1));
		
		СтруктураСтроки.Удалить("НомерСтроки");
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ИсходнаяСтрока",		ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаИсходнаяСтрока.Выгрузить())[0]);
	Результат.Вставить("ФрагментыСтроки",		ФрагментыСтроки);
	Результат.Вставить("НомераСтрокФрагментов",	НомераСтрокФрагментов);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область НедоступныеКолонки

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонок()
	
	НедоступныеКолонки = Новый Массив();
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаНомерСтроки");
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаОДВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаОД");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаОДПросроченнаяВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаОДПросроченная");
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПроцентовВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПроцентов");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПроцентовПросроченнаяВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПроцентовПросроченная");
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаШтрафовВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаШтрафов");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаШтрафовПросроченнаяВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаШтрафовПросроченная");
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПенейВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПеней");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПенейПросроченнаяВалютная");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаПенейПросроченная");
	
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаИтого");
	НедоступныеКолонки.Добавить("ТаблицаИсходнаяСтрокаСуммаИтогоВалютная");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки);
	
КонецПроцедуры

