#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьФорму()
	
	// Значения настроек из общего модуля.
	ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной =
		ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной();
	
	ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности =
		ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности();
	
	ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме =
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме();
		
	СтатусыПросроченнойЗадолженности.ЗагрузитьЗначения(
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности());
		
	СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы.ЗагрузитьЗначения(
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы());
		
	ПредставлениеВалюты = Строка(Валюта);
	
	НастроитьФормуПоВалюте();
	
	НастроитьИтогиНулевыхСуммБухУчета();
	
	НастроитьНедоступностьИзмененияКолонок();
	
	НастроитьСпискиВыбораСтатусовЗадолженности();
	
	УстановитьУсловноеОформление(); // Важно размещение в конец процедуры, после полного выполнения инициализации.
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеВалюты(ФормаДокумента, ЭтоИностраннаяВалюта)
	
	Если ЭтоИностраннаяВалюта Тогда
		Возврат ФормаДокумента.ПредставлениеВалюты;
	Иначе
		Возврат НСтр("ru='руб.'");
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ИнвентаризационнаяОписьКредитовИЗаймов.УстановитьУсловноеОформление_ФормаРазбивкиСтроки(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ИсходнаяСтрока,
		"Контрагент,Договор,КФО,Счет,КПС,Валюта,ИФО,Подразделение");
	
	// Переносим суммы исходной строки на форму для работы условного оформления.
	ИсходнаяСтрокаСуммаОДВалютная 			= Параметры.ИсходнаяСтрока.СуммаОДВалютная;
	ИсходнаяСтрокаСуммаОД 					= Параметры.ИсходнаяСтрока.СуммаОД;
	ИсходнаяСтрокаСуммаПроцентовВалютная 	= Параметры.ИсходнаяСтрока.СуммаПроцентовВалютная;
	ИсходнаяСтрокаСуммаПроцентов 			= Параметры.ИсходнаяСтрока.СуммаПроцентов;
	ИсходнаяСтрокаСуммаШтрафовВалютная 		= Параметры.ИсходнаяСтрока.СуммаШтрафовВалютная;
	ИсходнаяСтрокаСуммаШтрафов 				= Параметры.ИсходнаяСтрока.СуммаШтрафов;
	ИсходнаяСтрокаСуммаПенейВалютная 		= Параметры.ИсходнаяСтрока.СуммаПенейВалютная;
	ИсходнаяСтрокаСуммаПеней 				= Параметры.ИсходнаяСтрока.СуммаПеней;
	
	ЭтоИностраннаяВалюта = ЗначениеЗаполнено(Валюта) И Валюта <> Параметры.ВалютаРУ;
	
	ИдентификаторСтроки = Параметры.ИсходнаяСтрока.ИдентификаторСтроки;
	
	ТаблицаИсходнаяСтрока.Очистить();
	
	НоваяСтрока = ТаблицаИсходнаяСтрока.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
	
	ТаблицаФрагментыСтроки.Очистить();
	
	СписокНомеров = Новый СписокЗначений();
	
	Если Параметры.ФрагментыСтроки = Неопределено Тогда
		НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
		
		СписокНомеров.Добавить(Параметры.ИсходнаяСтрока.НомерСтроки);
	Иначе
		Для Каждого СтруктураСтроки Из Параметры.ФрагментыСтроки Цикл
			НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			
			СписокНомеров.Добавить(СтруктураСтроки.НомерСтроки);
		КонецЦикла;
	КонецЕсли;
	
	СписокНомеров.СортироватьПоЗначению();
	
	НомераСтрокФрагментов = Новый ФиксированныйМассив(СписокНомеров.ВыгрузитьЗначения());
	
	ВремСтруктураЗаполненияНовойСтроки = Новый Структура("
		|Валюта");
	
	ЗаполнитьЗначенияСвойств(ВремСтруктураЗаполненияНовойСтроки, Параметры.ИсходнаяСтрока);
	
	СтруктураЗаполненияНовойСтроки = Новый ФиксированнаяСтруктура(ВремСтруктураЗаполненияНовойСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСлужебныеКолонкиТаблицы()
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментыСтроки Цикл
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаТаблицы.НомерСтроки = НомерСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСпискиВыбораСтатусовЗадолженности()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ТаблицаФрагментыСтрокиСтатусЗадолженностиОД");
	ИменаЭлементов.Добавить("ТаблицаФрагментыСтрокиСтатусЗадолженностиПроцентов");
	ИменаЭлементов.Добавить("ТаблицаФрагментыСтрокиСтатусЗадолженностиШтрафов");
	ИменаЭлементов.Добавить("ТаблицаФрагментыСтрокиСтатусЗадолженностиПеней");
	
	Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].СписокВыбора.ЗагрузитьЗначения(Список);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоВалюте()
	
	Если Не ЭтоИностраннаяВалюта Тогда
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить("ИтогСуммаОДВалютная");
		ИменаЭлементов.Добавить("ИтогСуммаПроцентовВалютная");
		ИменаЭлементов.Добавить("ИтогСуммаШтрафовВалютная");
		ИменаЭлементов.Добавить("ИтогСуммаПенейВалютная");
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов, "ФорматРедактирования", "ЧН=х");
	КонецЕсли;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ИтогСуммаОДОтклонение");
	ИменаЭлементов.Добавить("ИтогСуммаПроцентовОтклонение");
	ИменаЭлементов.Добавить("ИтогСуммаШтрафовОтклонение");
	ИменаЭлементов.Добавить("ИтогСуммаПенейОтклонение");
	
	Положение = ?(ЭтоИностраннаяВалюта, ГоризонтальноеПоложениеЭлемента.Лево, ГоризонтальноеПоложениеЭлемента.Право);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов, "ГоризонтальноеПоложение", Положение);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИтогиНулевыхСуммБухУчета()
	
	ИменаЭлементов = Новый Массив();
	
	Если ИсходнаяСтрокаСуммаОДВалютная = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаОДВалютная");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаОД = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаОД");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаПроцентовВалютная = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаПроцентовВалютная");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаПроцентов = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаПроцентов");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаШтрафовВалютная = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаШтрафовВалютная");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаШтрафов = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаШтрафов");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаПенейВалютная = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаПенейВалютная");
	КонецЕсли;
	
	Если ИсходнаяСтрокаСуммаПеней = 0 Тогда
		ИменаЭлементов.Добавить("ИтогСуммаПеней");
	КонецЕсли;
	
	Если ИменаЭлементов.Количество() > 0 Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов, "ФорматРедактирования", "ЧН=х");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтатусаЗадолженности(Элемент)
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(Элемент.Имя);
	
	ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
	
	НастроитьПросроченнуюВСтрокеФрагмента(ТекДанные,
		КомпонентыИмени.ВидРасчетов, "Валютная", Истина,
		СтатусыПросроченнойЗадолженности, СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы);
		
	НастроитьПросроченнуюВСтрокеФрагмента(ТекДанные,
		КомпонентыИмени.ВидРасчетов, "", Истина,
		СтатусыПросроченнойЗадолженности, СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы);
	
	НастроитьФлажокТребуетРеклассификации(ТекДанные, КомпонентыИмени.ВидРасчетов);
	
КонецПроцедуры

#Область ИменаПолей

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПостфиксыВидовРасчета()
	
	ПостфиксыВидовРасчета = Новый Массив();
	
	ПостфиксыВидовРасчета.Добавить("ОД");
	ПостфиксыВидовРасчета.Добавить("Процентов");
	ПостфиксыВидовРасчета.Добавить("Штрафов");
	ПостфиксыВидовРасчета.Добавить("Пеней");
	
	Возврат ПостфиксыВидовРасчета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПостфиксыВидовСуммы()
	
	ПостфиксыВидовСуммы = Новый Массив();
	
	ПостфиксыВидовСуммы.Добавить("");
	ПостфиксыВидовСуммы.Добавить("Подтвержденная");
	ПостфиксыВидовСуммы.Добавить("Неподтвержденная");
	ПостфиксыВидовСуммы.Добавить("Просроченная");
	
	Возврат ПостфиксыВидовСуммы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ПостфиксВалютная)
	
	Возврат СтрШаблон("Сумма%1%2%3", ПостфиксВидаРасчета, ПостфиксВидаСуммы, ПостфиксВалютная);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета)
	
	Возврат СтрШаблон("СтатусЗадолженности%1", ПостфиксВидаРасчета);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляТребуетРеклассификации(ПостфиксВидаРасчета)
	
	Возврат СтрШаблон("Сумма%1ТребуетРеклассификации", ПостфиксВидаРасчета);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляИтогКолонкиФрагментов(КомпонентыИмени)
	
	Возврат СтрШаблон("ИтогСумма%1%2", КомпонентыИмени.ВидРасчетов, КомпонентыИмени.Валютная);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыделитьКомпонентыИмениПоля(ИмяПоля)
	
	КомпонентыИмени = НовыйКомпонентыИмениПоля();
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	Для Каждого ВидРасчетов Из ПостфиксыВидовРасчета Цикл
		Если СтрНайти(ИмяПоля, ВидРасчетов) > 0 Тогда
			КомпонентыИмени.ВидРасчетов = ВидРасчетов;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПостфиксыВидовСуммы = ПолучитьПостфиксыВидовСуммы();
	
	Для Каждого ВидСуммы Из ПостфиксыВидовСуммы Цикл
		Если Не ЗначениеЗаполнено(ВидСуммы) Тогда
			// Для бух.учета применяется пустая строка, и это значение не может быть найдено при поиске.
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(ИмяПоля, ВидСуммы) > 0 Тогда
			КомпонентыИмени.ВидСуммы = ВидСуммы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КомпонентыИмени.Валютная = ?(СтрНайти(ИмяПоля, "Валютная") > 0, "Валютная", "");
	
	Возврат КомпонентыИмени;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйКомпонентыИмениПоля(ПостфиксВидаРасчетов = "", ПостфиксВидаСуммы = "", ПостфиксВалютная = "")
	
	КомпонентыИмени = Новый Структура();
	КомпонентыИмени.Вставить("ВидРасчетов", ПостфиксВидаРасчетов);
	КомпонентыИмени.Вставить("ВидСуммы", ПостфиксВидаСуммы);
	КомпонентыИмени.Вставить("Валютная", ПостфиксВалютная);
	
	Возврат КомпонентыИмени;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДиагностироватьНаличиеОтклонения(ФормаДокумента, КомпонентыИмени)
	
	РазбиваемаяСумма = ПолучитьРазбиваемуюСумму(ФормаДокумента, КомпонентыИмени);
	
	Итог = ПолучитьИтогКолонкиФрагментов(ФормаДокумента, КомпонентыИмени);
	
	Результат = Новый Структура("Совпадает,ПревышеноНа,НеХватает", Ложь, 0, 0);
	
	Результат.Совпадает = (Итог = РазбиваемаяСумма);
	
	Если Итог > РазбиваемаяСумма Тогда
		Результат.ПревышеноНа = Итог - РазбиваемаяСумма;
	Иначе
		Результат.НеХватает = РазбиваемаяСумма - Итог;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РедактированиеИсходнойСтроки

&НаКлиенте
Процедура РассчитатьСуммыВИсходнойСтроке(Элемент)
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(Элемент.Имя);
	
	ПостфиксВидаРасчета	= КомпонентыИмени.ВидРасчетов;
	ПостфиксВидаСуммы	= КомпонентыИмени.ВидСуммы;
	ПостфиксВалютная	= КомпонентыИмени.Валютная;
	
	ИмяПоляБухУчет	= ИмяПоляСумма(ПостфиксВидаРасчета, "", ПостфиксВалютная);
	ИмяПоляСумма	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ПостфиксВалютная);
	
	ТекДанные = Элементы.ТаблицаИсходнаяСтрока.ТекущиеДанные;
	
	СуммаБухУчет	= ТекДанные[ИмяПоляБухУчет];
	Сумма			= ТекДанные[ИмяПоляСумма];
	
	ИзмененныеПоля = Новый Структура();
	ИзмененныеПоля.Вставить(ИмяПоляСумма, КомпонентыИмени);
	
	// Любая сумма <= Бух.учет (вал., руб.)
	Если (СуммаБухУчет >= 0 И Сумма > СуммаБухУчет) Или (СуммаБухУчет <= 0 И Сумма < СуммаБухУчет) Тогда
		ТекДанные[ИмяПоляСумма] = СуммаБухУчет;
		
		Сумма = СуммаБухУчет;
	КонецЕсли;
	
	Если ПостфиксВидаСуммы = "Подтвержденная" Или ПостфиксВидаСуммы = "Неподтвержденная" Тогда
		// Бух.учет = Подтвержденная + Неподтвержденная (вал., руб.)
		// Такое равенство поддерживается при опциональной настройке.
		
		ПостфиксВидСуммыКор = ?(ПостфиксВидаСуммы = "Подтвержденная", "Неподтвержденная", "Подтвержденная");
		
		ИмяПоляСуммаКор	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидСуммыКор, ПостфиксВалютная);
		
		Если Сумма = 0 И Не ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
			СуммаКор = 0;
		Иначе
			СуммаКор = СуммаБухУчет - Сумма;
		КонецЕсли;
		
		ТекДанные[ИмяПоляСумма]		= Сумма;
		ТекДанные[ИмяПоляСуммаКор]	= СуммаКор;
		
		ИзмененныеПоля.Вставить(ИмяПоляСуммаКор, ВыделитьКомпонентыИмениПоля(ИмяПоляСуммаКор));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПостфиксВалютная) Тогда
		ПересчитатьРублевыеСуммыВИсходнойСтроке(ТекДанные, ИзмененныеПоля);
	КонецЕсли;
	
	ОчиститьНедоступныеПоляВИсходнойСтроке(ТекДанные, ПостфиксВидаРасчета);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьРублевыеСуммыВИсходнойСтроке(ТекДанные, ИзмененныеПоля)
	
	Перем Курс;
	
	// В исходной строке редактируются только Подтвержденная и Неподтвержденная задолженности.
	// Просроченная не редактируется.
	// Поэтому ВидСуммы всегда Подтвержденная или Неподтвержденная.
	
	ВидРасчетов = "";
	
	Для Каждого Элемент Из ИзмененныеПоля Цикл
		ИмяПоляСуммаВал = Элемент.Ключ;
		КомпонентыИмени = Элемент.Значение;
		
		// Во всех элементах ИзмененныеПоля указано одинаковое значение ВидаРасчетов.
		ВидРасчетов = КомпонентыИмени.ВидРасчетов;
		
		Если Курс = Неопределено Тогда
			Курс = ПолучитьКурсВалютыРасчетов(ЭтотОбъект, ВидРасчетов);
		КонецЕсли;
		
		ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, КомпонентыИмени.ВидСуммы, "");
		
		ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаВал] * Курс;
	КонецЦикла;
	
	Если ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
		ВыравнятьИтогРублевыхСуммВИсходнойСтроке(ТекДанные, ВидРасчетов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКурсВалютыРасчетов(ФормаДокумента, ВидРасчетов)
	
	// Курс определяем из остатков бух.учета.
	ИсходнаяСтрока = ФормаДокумента.ТаблицаИсходнаяСтрока[0];
	
	СуммаВал = ИсходнаяСтрока[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
	
	Если ЗначениеЗаполнено(СуммаВал) Тогда
		Возврат ИсходнаяСтрока[ИмяПоляСумма(ВидРасчетов, "", "")] / СуммаВал;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевыхСуммВИсходнойСтроке(ТекДанные, ВидРасчетов)
	
	ИмяПоляСуммаБухУчетРуб = "";
	ИмяПоляСуммаПодтвержденнаяРуб = "";
	ИмяПоляСуммаНеподтвержденнаяРуб = "";
	
	Если НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб) Тогда
		ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб)
	
	ИмяПоляСуммаПодтвержденнаяВал = ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "Валютная");
	ИмяПоляСуммаНеподтвержденнаяВал = ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "Валютная");
	
	Если ТекДанные[ИмяПоляСуммаПодтвержденнаяВал] = 0 И ТекДанные[ИмяПоляСуммаНеподтвержденнаяВал] = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоляСуммаБухУчетРуб = ИмяПоляСумма(ВидРасчетов, "", "");
	ИмяПоляСуммаПодтвержденнаяРуб = ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "");
	ИмяПоляСуммаНеподтвержденнаяРуб = ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "");
	
	Возврат (ТекДанные[ИмяПоляСуммаПодтвержденнаяРуб] + ТекДанные[ИмяПоляСуммаНеподтвержденнаяРуб]) <>
		ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб)
	
	// Корректируем наибольшую рублевую сумму.
	
	СуммаПодтвержденнаяРуб = ТекДанные[ИмяПоляСуммаПодтвержденнаяРуб];
	СуммаНеподтвержденнаяРуб = ТекДанные[ИмяПоляСуммаНеподтвержденнаяРуб];
	СуммаБухУчетРуб = ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
	Подтвержденная = Макс(СуммаПодтвержденнаяРуб, -СуммаПодтвержденнаяРуб);
	Неподтвержденная = Макс(СуммаНеподтвержденнаяРуб, -СуммаНеподтвержденнаяРуб);
	
	Если Подтвержденная > Неподтвержденная Тогда
		ИмяПоля = ИмяПоляСуммаПодтвержденнаяРуб;
	Иначе
		ИмяПоля = ИмяПоляСуммаНеподтвержденнаяРуб;
	КонецЕсли;
	
	ТекДанные[ИмяПоля] = СуммаБухУчетРуб - (СуммаПодтвержденнаяРуб + СуммаНеподтвержденнаяРуб - ТекДанные[ИмяПоля]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНедоступныеПоляВИсходнойСтроке(СтрокаТаблицы, ПостфиксВидаРасчета)
	
	Если Не ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности Тогда
		ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы, ПостфиксВидаРасчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы, ПостфиксВидаРасчета)
	
	// Поля акта сверки недоступны (очищаются), если отсутствует подтвержденная сумма.
	
	ПустаяДата = '00010101';
	ПустойНомер = "";
	
	Если СтрокаТаблицы.СуммаОДПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаОДПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиОД = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиОД = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПроцентовПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаПроцентовПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиПроцентов = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиПроцентов = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаШтрафовПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаШтрафовПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиШтрафов = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиШтрафов = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПенейПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаПенейПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиПеней = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиПеней = ПустойНомер;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьРазбиваемуюСумму(ФормаДокумента, КомпонентыИмени)
	
	Возврат ФормаДокумента["ИсходнаяСтрока" + ИмяПоляСумма(КомпонентыИмени.ВидРасчетов, "", КомпонентыИмени.Валютная)];
	
КонецФункции

#КонецОбласти

#Область РедактированиеФрагментовСтроки

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеФрагмента(Элемент)
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(Элемент.Имя);
	
	ИдСтроки = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные.ПолучитьИдентификатор();
	
	РассчитатьСуммыВСтрокеФрагментаСервер(ИдСтроки, КомпонентыИмени);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыВСтрокеФрагментаСервер(ИдСтроки, КомпонентыИмени)
	
	ПостфиксВидаРасчета	= КомпонентыИмени.ВидРасчетов;
	ПостфиксВидаСуммы	= КомпонентыИмени.ВидСуммы;
	ПостфиксВалютная	= КомпонентыИмени.Валютная;
	
	ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ПостфиксВалютная);
	
	РазбиваемаяСумма = ПолучитьРазбиваемуюСумму(ЭтотОбъект, КомпонентыИмени);
	
	ТекДанные = ТаблицаФрагментыСтроки.НайтиПоИдентификатору(ИдСтроки);
	
	ВведеннаяСумма = ТекДанные[ИмяПоля];
	
	ИзмененныеПоля = Новый Структура();
	ИзмененныеПоля.Вставить(ИмяПоля, КомпонентыИмени);
	
	// Любая сумма <= сумма в исходной строке
	Если (РазбиваемаяСумма >= 0 И ВведеннаяСумма > РазбиваемаяСумма) Или (РазбиваемаяСумма <= 0 И ВведеннаяСумма < РазбиваемаяСумма) Тогда
		ВведеннаяСумма = РазбиваемаяСумма;
		
		ТекДанные[ИмяПоля] = ВведеннаяСумма;
	КонецЕсли;
	
	ПросроченнаяБылаИзменена = Ложь;
	
	НастроитьПросроченнуюВСтрокеФрагмента(ТекДанные,
		ПостфиксВидаРасчета, ПостфиксВалютная, Ложь,
		СтатусыПросроченнойЗадолженности, СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы,
		ПросроченнаяБылаИзменена);
		
	Если ПросроченнаяБылаИзменена Тогда
		ИмяПоляПросроченная = ИмяПоляСумма(ПостфиксВидаРасчета, "Просроченная", ПостфиксВалютная);
		
		КомпонентыИмениПросроченная = НовыйКомпонентыИмениПоля(ПостфиксВидаРасчета, "Просроченная", ПостфиксВалютная);
		
		ИзмененныеПоля.Вставить(ИмяПоляПросроченная, КомпонентыИмениПросроченная);
	КонецЕсли;
	
	НастроитьФлажокТребуетРеклассификации(ТекДанные, ПостфиксВидаРасчета);
	
	ОчиститьСтатусПриПустойСуммеБухУчета(ТекДанные, ПостфиксВидаРасчета);
	
	Если ПостфиксВалютная = "Валютная" Тогда
		ПересчитатьРублевыеСуммыВСтрокеФрагмента(ЭтотОбъект, ТекДанные, ИзмененныеПоля);
	КонецЕсли;
	
	ОбновитьИтогиТаблицы(ЭтотОбъект, ПостфиксВидаРасчета);
	
	ОбновитьТекстыОтклонений(ЭтотОбъект, ПостфиксВидаРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСтатусПриПустойСуммеБухУчета(СтрокаТаблицы, ПостфиксВидаРасчета)
	
	// Поле статуса задолженности недоступно (очищается), если отсутствует сумма по бух.учету.
	
	СуммаБухУчетВалютная= СтрокаТаблицы[ИмяПоляСумма(ПостфиксВидаРасчета, "", "Валютная")];
	СуммаБухУчет		= СтрокаТаблицы[ИмяПоляСумма(ПостфиксВидаРасчета, "", "")];
	
	Если СуммаБухУчетВалютная = 0 И СуммаБухУчет = 0 Тогда
		СтрокаТаблицы[ИмяПоляСтатусЗадолженности(ПостфиксВидаРасчета)] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммыВНовойСтрокеТаблицыФрагментов(СтрокаТаблицы)
	
	ПостфиксВалютная = ?(ЭтоИностраннаяВалюта, "Валютная", "");
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	Для Каждого ПостфиксВидаРасчета Из ПостфиксыВидовРасчета Цикл
		КомпонентыИмени = НовыйКомпонентыИмениПоля(ПостфиксВидаРасчета, "", ПостфиксВалютная);
		
		РезультатДиагностики = ДиагностироватьНаличиеОтклонения(ЭтотОбъект, КомпонентыИмени);
		
		Если ЗначениеЗаполнено(РезультатДиагностики.НеХватает) Тогда
			ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, "" , ПостфиксВалютная);
			
			СтрокаТаблицы[ИмяПоля] = РезультатДиагностики.НеХватает;
			
			Если ЭтоИностраннаяВалюта Тогда
				ИзмененноеПоле = Новый Структура();
				ИзмененноеПоле.Вставить(ИмяПоля, ВыделитьКомпонентыИмениПоля(ИмяПоля));
				
				ПересчитатьРублевыеСуммыВСтрокеФрагмента(ЭтотОбъект, СтрокаТаблицы, ИзмененноеПоле);
			КонецЕсли;
			
			ОбновитьИтогиТаблицы(ЭтотОбъект, ПостфиксВидаРасчета);
			
			ОбновитьТекстыОтклонений(ЭтотОбъект, ПостфиксВидаРасчета);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРублевыеСуммыВСтрокеФрагмента(ФормаДокумента, ТекДанные, ИзмененныеПоля)
	
	Для Каждого Элемент Из ИзмененныеПоля Цикл
		ИмяПоляСуммаВал = Элемент.Ключ;
		КомпонентыИмени = Элемент.Значение;
		
		// Во всех элементах ИзмененныеПоля указано одинаковое значение ВидаРасчетов.
		ВидРасчетов = КомпонентыИмени.ВидРасчетов;
		
		ИмяПоляСуммаРуб = ИмяПоляСумма(КомпонентыИмени.ВидРасчетов, КомпонентыИмени.ВидСуммы, "");
		
		// При равенстве просроченной валютной суммы с бух.учетом должны быть равны и рублевые суммы.
		Если КомпонентыИмени.ВидСуммы = "Просроченная" И КомпонентыИмени.Валютная = "Валютная" Тогда
			СуммаБухУчетВал = ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
			СуммаПросроченнаяВал = ТекДанные[ИмяПоляСуммаВал];

			Если СуммаПросроченнаяВал = СуммаБухУчетВал Тогда
				ИмяПоляСуммаБухУчетРуб = ИмяПоляСумма(ВидРасчетов, "", "");
				
				ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаБухУчетРуб];
				
				Продолжить;;
			КонецЕсли;
		КонецЕсли;
		
		Курс = ПолучитьКурсВалютыРасчетов(ФормаДокумента, КомпонентыИмени.ВидРасчетов);
		
		ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаВал] * Курс;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьРублевыеСуммыВТаблицеФрагментов()
	
	// Курс определяем из остатков бух.учета.
	ИсходнаяСтрока = ТаблицаИсходнаяСтрока[0];
	
	Если ИсходнаяСтрока.СуммаИтогоВалютная <> 0 Тогда
		Курс = ИсходнаяСтрока.СуммаИтого / ИсходнаяСтрока.СуммаИтогоВалютная;
	Иначе
		Курс = 0;
	КонецЕсли;
	
	ВидовРасчетов = ПолучитьЗаполненныеВидыРасчетовИсходнойСтроки(ИсходнаяСтрока);
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментыСтроки Цикл
		Для Каждого ВидРасчетов Из ВидовРасчетов Цикл
			ИмяПоляСуммаВал = ИмяПоляСумма(ВидРасчетов, "", "Валютная");
			ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, "", "");
			
			СтрокаТаблицы[ИмяПоляСуммаРуб] = СтрокаТаблицы[ИмяПоляСуммаВал] * Курс;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗаполненныеВидыРасчетовИсходнойСтроки(ИсходнаяСтрока)
	
	ВидовРасчетов = Новый Массив();
	
	Если ЗначениеЗаполнено(ИсходнаяСтрока.СуммаОДВалютная) Тогда
		ВидовРасчетов.Добавить("ОД");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходнаяСтрока.СуммаПроцентовВалютная) Тогда
		ВидовРасчетов.Добавить("Процентов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходнаяСтрока.СуммаШтрафовВалютная) Тогда
		ВидовРасчетов.Добавить("Штрафов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходнаяСтрока.СуммаПенейВалютная) Тогда
		ВидовРасчетов.Добавить("Пеней");
	КонецЕсли;
	
	Возврат ВидовРасчетов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФлажокТребуетРеклассификации(ТекДанные, ВидРасчетов)
	
	ТекДанные[ИмяПоляТребуетРеклассификации(ВидРасчетов)] = ПросроченнаяЗаполнена(ТекДанные, ВидРасчетов);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПросроченнаяЗаполнена(ТекДанные, ВидРасчетов)
	
	ИмяПоляСуммаВал = ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная");
	ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, "Просроченная", "");
	
	Возврат ЗначениеЗаполнено(ТекДанные[ИмяПоляСуммаВал]) Или ЗначениеЗаполнено(ТекДанные[ИмяПоляСуммаРуб]);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьПросроченнуюВСтрокеФрагмента(ТекДанные, ВидРасчетов, ПостфиксВалютная, ИзмененСтатус = Ложь,
	СтатусыПросроченнойЗадолженности, СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы,
	ЗначениеБылоИзменено = Ложь)
	
	// Возможность указания просроченной суммы определяется статусом задолженности.
	// При этом просроченная сумма либо равна сумме бух.учета, либо не превышает ее.
	// Возможные значения просроченной задолженности также определяются статусом задолженности.
	
	ИмяПоляСуммаБухУчет			= ИмяПоляСумма(ВидРасчетов, "", ПостфиксВалютная);
	ИмяПоляСуммаПросроченная	= ИмяПоляСумма(ВидРасчетов, "Просроченная", ПостфиксВалютная);
	ИмяПоляСтатусЗадолженности	= ИмяПоляСтатусЗадолженности(ВидРасчетов);
	
	СуммаБухУчет		= ТекДанные[ИмяПоляСуммаБухУчет];
	СуммаПросроченная	= ТекДанные[ИмяПоляСуммаПросроченная];
	СтатусЗадолженности = ТекДанные[ИмяПоляСтатусЗадолженности];
	
	Если СтатусыПросроченнойЗадолженности.НайтиПоЗначению(СтатусЗадолженности) <> Неопределено Тогда
		Если ИзмененСтатус Тогда
			// Просроченная = бух.учет
			СуммаПросроченная = СуммаБухУчет;
			
		ИначеЕсли СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы.НайтиПоЗначению(СтатусЗадолженности) <> Неопределено Тогда
			// Просроченная <= бух.учет
			Если (СуммаБухУчет >= 0 И СуммаПросроченная > СуммаБухУчет) Или (СуммаБухУчет <= 0 И СуммаПросроченная < СуммаБухУчет) Тогда
				СуммаПросроченная = СуммаБухУчет;
			КонецЕсли;
		Иначе
			// Просроченная = бух.учет
			СуммаПросроченная = СуммаБухУчет;
		КонецЕсли;
	Иначе
		СуммаПросроченная = 0;
	КонецЕсли;
	
	ЗначениеБылоИзменено = (ТекДанные[ИмяПоляСуммаПросроченная] <> СуммаПросроченная);
	
	ТекДанные[ИмяПоляСуммаПросроченная] = СуммаПросроченная;
	
КонецПроцедуры

#КонецОбласти

#Область ИтогиФрагментовСтроки

&НаКлиенте
Процедура НажатаГиперссылкаИтого(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяПоля = СтрЗаменить(Элемент.Имя, "Итог", "");
	ИмяПоля = СтрЗаменить(ИмяПоля, "Отклонение", "");
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(ИмяПоля);
	
	КомпонентыИмени.Валютная = ?(ЭтоИностраннаяВалюта, "Валютная", "");
	
	ПостфиксВидаРасчета	= КомпонентыИмени.ВидРасчетов;
	ПостфиксВидаСуммы	= КомпонентыИмени.ВидСуммы;
	ПостфиксВалютная	= КомпонентыИмени.Валютная;
	
	РезультатДиагностики = ДиагностироватьНаличиеОтклонения(ЭтотОбъект, КомпонентыИмени);
	
	Если РезультатДиагностики.Совпадает
		И ЭтоИностраннаяВалюта И ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
		ПостфиксВалютная = "";
		
		КомпонентыИмени.Валютная = ПостфиксВалютная;
		
		РезультатДиагностики = ДиагностироватьНаличиеОтклонения(ЭтотОбъект, КомпонентыИмени);
	КонецЕсли;
	
	ДиагностикаВыполненаДляВалютнойСуммы = (КомпонентыИмени.Валютная = "Валютная");
	
	Если РезультатДиагностики.Совпадает Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстНаправление = ?(ЗначениеЗаполнено(РезультатДиагностики.ПревышеноНа), НСтр("ru='Уменьшить'"), НСтр("ru='Увеличить'"));
	
	ВеличинаИзменения = ?(ЗначениеЗаполнено(РезультатДиагностики.ПревышеноНа), РезультатДиагностики.ПревышеноНа, РезультатДиагностики.НеХватает);
	
	ИмяПоля = ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидаСуммы, ПостфиксВалютная);
	
	Если ПостфиксВидаРасчета = "ОД" Тогда
		ПредставлениеПоля = НСтр("ru='основного долга'");
	ИначеЕсли ПостфиксВидаРасчета = "Процентов" Тогда
		ПредставлениеПоля = НСтр("ru='процентов'");
	ИначеЕсли ПостфиксВидаРасчета = "Штрафов" Тогда
		ПредставлениеПоля = НСтр("ru='штрафов'");
	ИначеЕсли ПостфиксВидаРасчета = "Процентов" Тогда
		ПредставлениеПоля = НСтр("ru='процентов'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяПоля",					ИмяПоля);
	ДополнительныеПараметры.Вставить("КомпонентыИмени",			КомпонентыИмени);
	ДополнительныеПараметры.Вставить("ТекДанные",				ТекДанные);
	ДополнительныеПараметры.Вставить("РезультатДиагностики",	РезультатДиагностики);
	ДополнительныеПараметры.Вставить("ДиагностикаВыполненаДляВалютнойСуммы", ДиагностикаВыполненаДляВалютнойСуммы);
	
	Оповещение = Новый ОписаниеОповещения("НажатаГиперссылкаИтогоВыбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = СтрШаблон(НСтр("ru='%1 на %2 %3 сумму %4 в текущей строке таблицы фрагментов?'"),
		ТекстНаправление,
		Формат(ВеличинаИзменения, "ЧДЦ=2"),
		ПолучитьПредставлениеВалюты(ЭтотОбъект, ДиагностикаВыполненаДляВалютнойСуммы),
		ПредставлениеПоля);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура НажатаГиперссылкаИтогоВыбор(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля;
	
	КомпонентыИмени = ДополнительныеПараметры.КомпонентыИмени;
	
	РазбиваемаяСумма = ПолучитьРазбиваемуюСумму(ЭтотОбъект, КомпонентыИмени);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.РезультатДиагностики.НеХватает) Тогда
		НовоеЗначение = ДополнительныеПараметры.ТекДанные[ИмяПоля]
			+ ДополнительныеПараметры.РезультатДиагностики.НеХватает;
			
	ИначеЕсли ЗначениеЗаполнено(ДополнительныеПараметры.РезультатДиагностики.ПревышеноНа) Тогда
		НовоеЗначение = ДополнительныеПараметры.ТекДанные[ИмяПоля]
			- ДополнительныеПараметры.РезультатДиагностики.ПревышеноНа;
	КонецЕсли;
	
	Если НовоеЗначение < 0 Тогда
		НовоеЗначение = 0;
	КонецЕсли;
	
	Если РазбиваемаяСумма >= 0 И НовоеЗначение > РазбиваемаяСумма Или РазбиваемаяСумма <= 0 И НовоеЗначение < РазбиваемаяСумма Тогда
		НовоеЗначение = РазбиваемаяСумма;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекДанные[ИмяПоля] = НовоеЗначение;
	
	Если НовоеЗначение = 0 Тогда
		// Очищаем статус задолженности.
		ДополнительныеПараметры.ТекДанные[ИмяПоляСтатусЗадолженности(КомпонентыИмени.ВидРасчетов)] = Неопределено;
		ДополнительныеПараметры.ТекДанные[ИмяПоляТребуетРеклассификации(КомпонентыИмени.ВидРасчетов)] = Ложь;
	КонецЕсли;
	
	ПросроченнаяБылаИзменена = Ложь;
	
	НастроитьПросроченнуюВСтрокеФрагмента(ДополнительныеПараметры.ТекДанные,
		КомпонентыИмени.ВидРасчетов, КомпонентыИмени.Валютная, Ложь,
		СтатусыПросроченнойЗадолженности, СтатусыПросроченнойЗадолженностиДопускающиеРедактированиеСуммы,
		ПросроченнаяБылаИзменена);
	
	НастроитьФлажокТребуетРеклассификации(ДополнительныеПараметры.ТекДанные, КомпонентыИмени.ВидРасчетов);
	
	Если ДополнительныеПараметры.ДиагностикаВыполненаДляВалютнойСуммы Тогда
		КомпонентыИмени = ВыделитьКомпонентыИмениПоля(ИмяПоля);
		
		ИзмененныеПоля = Новый Структура();
		ИзмененныеПоля.Вставить(ИмяПоля, КомпонентыИмени);
		
		Если ПросроченнаяБылаИзменена Тогда
			ИмяПоляПросроченная = ИмяПоляСумма(КомпонентыИмени.ВидРасчетов, "Просроченная", КомпонентыИмени.Валютная);
			
			КомпонентыИмениПросроченная = НовыйКомпонентыИмениПоля(КомпонентыИмени.ВидРасчетов, "Просроченная", КомпонентыИмени.Валютная);
			
			ИзмененныеПоля.Вставить(ИмяПоляПросроченная, КомпонентыИмениПросроченная);
		КонецЕсли;
		
		ПересчитатьРублевыеСуммыВСтрокеФрагмента(ЭтотОбъект, ДополнительныеПараметры.ТекДанные, ИзмененныеПоля);
	КонецЕсли;
	
	ОбновитьИтогиТаблицы(ЭтотОбъект, КомпонентыИмени.ВидРасчетов);
	
	ОбновитьТекстыОтклонений(ЭтотОбъект, КомпонентыИмени.ВидРасчетов);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиТаблицы(ФормаДокумента, ВидРасчетов = Неопределено)
	
	ТаблицаФрагментыСтроки = ФормаДокумента.ТаблицаФрагментыСтроки;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "ОД" Тогда
		ФормаДокумента.ИтогСуммаОДВалютная			= ТаблицаФрагментыСтроки.Итог("СуммаОДВалютная");
		ФормаДокумента.ИтогСуммаОД					= ТаблицаФрагментыСтроки.Итог("СуммаОД");
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Процентов" Тогда
		ФормаДокумента.ИтогСуммаПроцентовВалютная	= ТаблицаФрагментыСтроки.Итог("СуммаПроцентовВалютная");
		ФормаДокумента.ИтогСуммаПроцентов			= ТаблицаФрагментыСтроки.Итог("СуммаПроцентов");
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Штрафов" Тогда
		ФормаДокумента.ИтогСуммаШтрафовВалютная	= ТаблицаФрагментыСтроки.Итог("СуммаШтрафовВалютная");
		ФормаДокумента.ИтогСуммаШтрафов			= ТаблицаФрагментыСтроки.Итог("СуммаШтрафов");
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Пеней" Тогда
		ФормаДокумента.ИтогСуммаПенейВалютная		= ТаблицаФрагментыСтроки.Итог("СуммаПенейВалютная");
		ФормаДокумента.ИтогСуммаПеней				= ТаблицаФрагментыСтроки.Итог("СуммаПеней");
	КонецЕсли;
	
	ФормаДокумента.КоличествоФрагментовСтроки = ТаблицаФрагментыСтроки.Количество();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстыОтклонений(ФормаДокумента, ВидРасчетов = Неопределено)
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "ОД" Тогда
		ФормаДокумента.ИтогСуммаОДОтклонение		= ПолучитьТекстОтклонения(ФормаДокумента, "ОД", ФормаДокумента.ЭтоИностраннаяВалюта);
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Процентов" Тогда
		ФормаДокумента.ИтогСуммаПроцентовОтклонение= ПолучитьТекстОтклонения(ФормаДокумента, "Процентов", ФормаДокумента.ЭтоИностраннаяВалюта);
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Штрафов" Тогда
		ФормаДокумента.ИтогСуммаШтрафовОтклонение	= ПолучитьТекстОтклонения(ФормаДокумента, "Штрафов", ФормаДокумента.ЭтоИностраннаяВалюта);
	КонецЕсли;
	
	Если ВидРасчетов = Неопределено Или ВидРасчетов = "Пеней" Тогда
		ФормаДокумента.ИтогСуммаПенейОтклонение	= ПолучитьТекстОтклонения(ФормаДокумента, "Пеней", ФормаДокумента.ЭтоИностраннаяВалюта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТекстОтклонения(ФормаДокумента, ПостфиксВидаРасчета, ЭтоИностраннаяВалюта)
	
	ПостфиксВалютная = ?(ЭтоИностраннаяВалюта, "Валютная", "");
	
	КомпонентыИмени = НовыйКомпонентыИмениПоля(ПостфиксВидаРасчета,, ПостфиксВалютная);
	
	РазбиваемаяСумма = ПолучитьРазбиваемуюСумму(ФормаДокумента, КомпонентыИмени);
	
	Если РазбиваемаяСумма = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатДиагностики = ДиагностироватьНаличиеОтклонения(ФормаДокумента, КомпонентыИмени);
	
	Если РезультатДиагностики.Совпадает Тогда
		Если ЭтоИностраннаяВалюта И ФормаДокумента.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
			Возврат ПолучитьТекстОтклонения(ФормаДокумента, ПостфиксВидаРасчета, Ложь);
		Иначе
			Возврат НСтр("ru='Совпадает'");
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(РезультатДиагностики.ПревышеноНа) Тогда
		Возврат СтрШаблон(НСтр("ru='Превышено на %1 %2'"),
			Формат(РезультатДиагностики.ПревышеноНа, "ЧДЦ=2"),
			ПолучитьПредставлениеВалюты(ФормаДокумента, ЭтоИностраннаяВалюта));
		
	Иначе
		Возврат СтрШаблон(НСтр("ru='Не хватает %1 %2'"),
			Формат(РезультатДиагностики.НеХватает, "ЧДЦ=2"),
			ПолучитьПредставлениеВалюты(ФормаДокумента, ЭтоИностраннаяВалюта));
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИтогКолонкиФрагментов(ФормаДокумента, КомпонентыИмени)
	
	ИмяПоляИтог = ИмяПоляИтогКолонкиФрагментов(КомпонентыИмени);
	
	Возврат ФормаДокумента[ИмяПоляИтог];
	
КонецФункции

