#Область РасчетСуммРаздела2

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеРаздела2(Элемент)
	
	ИмяПоляСумма = СтрЗаменить(Элемент.Имя, "Раздел2", "");
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(ИмяПоляСумма);
	
	ПостфиксВидаРасчета	= КомпонентыИмени.ВидРасчетов;
	ПостфиксВидаСуммы	= КомпонентыИмени.ВидСуммы;
	ПостфиксВалютная	= КомпонентыИмени.Валютная;
	
	ИмяПоляБухУчет = ИмяПоляСумма(ПостфиксВидаРасчета, "", ПостфиксВалютная);
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	СуммаБухУчет	= ТекДанные[ИмяПоляБухУчет];
	Сумма			= ТекДанные[ИмяПоляСумма];
	
	ИзмененныеПоля = Новый Структура();
	ИзмененныеПоля.Вставить(ИмяПоляСумма, КомпонентыИмени);
	
	// Любая сумма <= Бух.учет (вал., руб.)
	Если (СуммаБухУчет >= 0 И Сумма > СуммаБухУчет) Или (СуммаБухУчет <= 0 И Сумма < СуммаБухУчет) Тогда
		ТекДанные[ИмяПоляСумма] = СуммаБухУчет;
		
		Сумма = СуммаБухУчет;
	КонецЕсли;
	
	Если ПостфиксВидаСуммы = "Подтвержденная" Или ПостфиксВидаСуммы = "Неподтвержденная" Тогда
		// Бух.учет = Подтвержденная + Неподтвержденная (вал., руб.)
		// Такое равенство поддерживается только при опциональной настройке.
		
		ПостфиксВидСуммыКор = ?(ПостфиксВидаСуммы = "Подтвержденная", "Неподтвержденная", "Подтвержденная");
		
		ИмяПоляСуммаКор	= ИмяПоляСумма(ПостфиксВидаРасчета, ПостфиксВидСуммыКор, ПостфиксВалютная);
		
		Если Сумма = 0 И Не ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
			СуммаКор = 0;
		Иначе
			СуммаКор = СуммаБухУчет - Сумма;
		КонецЕсли;
		
		ТекДанные[ИмяПоляСумма]		= Сумма;
		ТекДанные[ИмяПоляСуммаКор]	= СуммаКор;
		
		ИзмененныеПоля.Вставить(ИмяПоляСуммаКор, ВыделитьКомпонентыИмениПоля(ИмяПоляСуммаКор));
		
		ЗаполнитьИтогоПоВидуСуммы(ТекДанные, ПостфиксВидаСуммы, ПостфиксВалютная);
		ЗаполнитьИтогоПоВидуСуммы(ТекДанные, ПостфиксВидСуммыКор, ПостфиксВалютная);
	Иначе
		ЗаполнитьИтогоПоВидуСуммы(ТекДанные, ПостфиксВидаСуммы, ПостфиксВалютная);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПостфиксВалютная) Тогда
		ПересчитатьРублевыеСуммы(ТекДанные, ИзмененныеПоля);
	КонецЕсли;

	ОчиститьНедоступныеПоляВСтрокеРаздела2(ТекДанные, ПостфиксВидаРасчета, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьРублевыеСуммы(ТекДанные, ИзмененныеПоля)
	
	Перем Курс;
	
	// Во всех элементах ИзмененныеПоля указано одинаковое значение ВидаРасчетов.
	ВидРасчетов = "";
	
	ВидыСумм = Новый Соответствие();
	
	Для Каждого Элемент Из ИзмененныеПоля Цикл
		ИмяПоляСуммаВал = Элемент.Ключ;
		КомпонентыИмени = Элемент.Значение;
		
		// Во всех элементах ИзмененныеПоля указано одинаковое значение ВидаРасчетов.
		ВидРасчетов = КомпонентыИмени.ВидРасчетов;
		
		Если Курс = Неопределено Тогда
			Курс = ПолучитьКурсВалютыРасчетов(ТекДанные, ВидРасчетов);
		КонецЕсли;
		
		ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, КомпонентыИмени.ВидСуммы, "");
		
		ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаВал] * Курс;
		
		ВидыСумм.Вставить(КомпонентыИмени.ВидСуммы, Истина);
	КонецЦикла;
	
	Если ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
		ВыравнятьИтогРублевыхСумм(ТекДанные, ВидРасчетов, ВидыСумм);
	КонецЕсли;
	
	ЗаполнитьИтогоВРубляхПоВидамСумм(ТекДанные, ВидыСумм);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКурсВалютыРасчетов(ТекДанные, ВидРасчетов)
	
	// Курс определяем из остатков бух.учета.
	СуммаВал = ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
	
	Если ЗначениеЗаполнено(СуммаВал) Тогда
		Возврат ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "")] / СуммаВал;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевыхСумм(ТекДанные, ВидРасчетов, ВидыСумм)
	
	Если ВидыСумм.Получить("Просроченная") <> Неопределено Тогда
		ИмяПоляСуммаБухУчетРуб = "";
		ИмяПоляСуммаПросроченнаяРуб = "";
		
		Если НужноВыравнятьИтогРублевойСуммыПросроченная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПросроченнаяРуб) Тогда
			ВыравнятьИтогРублевойСуммыПросроченная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПросроченнаяРуб);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидыСумм.Получить("Подтвержденная") <> Неопределено
		Или ВидыСумм.Получить("Неподтвержденная") <> Неопределено Тогда
		
		ИмяПоляСуммаБухУчетРуб = "";
		ИмяПоляСуммаПодтвержденнаяРуб = "";
		ИмяПоляСуммаНеподтвержденнаяРуб = "";
		
		Если НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб) Тогда
			ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НужноВыравнятьИтогРублевойСуммыПросроченная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПросроченнаяРуб)
	
	// При равенстве с бух.учетом валютных сумм должны быть равны и рублевые суммы.
	
	ВидСуммы = "Просроченная";
	
	ЗаполнитьИтогоПоВидуСуммы(ТекДанные, ВидСуммы, "");
	
	СуммаБухУчетВал = ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
	СуммаПросроченнаяВал = ТекДанные[ИмяПоляСумма(ВидРасчетов, ВидСуммы, "Валютная")];
	
	Если СуммаПросроченнаяВал <> СуммаБухУчетВал Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоляСуммаБухУчетРуб = ИмяПоляСумма(ВидРасчетов, "", "");
	ИмяПоляСуммаПросроченнаяРуб = ИмяПоляСумма(ВидРасчетов, ВидСуммы, "");
	
	Возврат ТекДанные[ИмяПоляСуммаПросроченнаяРуб] <> ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевойСуммыПросроченная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПросроченнаяРуб)
	
	// Просрочена в полной сумме бух.учета.
	
	ТекДанные[ИмяПоляСуммаПросроченнаяРуб] = ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
КонецПроцедуры

&НаКлиенте
Функция НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ВидРасчетов, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб)
	
	ЗаполнитьИтогоПоВидуСуммы(ТекДанные, "Подтвержденная", "");
	ЗаполнитьИтогоПоВидуСуммы(ТекДанные, "Неподтвержденная", "");
	
	ИмяПоляСуммаПодтвержденнаяВал = ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "Валютная");
	ИмяПоляСуммаНеподтвержденнаяВал = ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "Валютная");
	
	Если ТекДанные[ИмяПоляСуммаПодтвержденнаяВал] = 0 И ТекДанные[ИмяПоляСуммаНеподтвержденнаяВал] = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоляСуммаБухУчетРуб = ИмяПоляСумма(ВидРасчетов, "", "");
	ИмяПоляСуммаПодтвержденнаяРуб = ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "");
	ИмяПоляСуммаНеподтвержденнаяРуб = ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "");
	
	Возврат (ТекДанные[ИмяПоляСуммаПодтвержденнаяРуб] + ТекДанные[ИмяПоляСуммаНеподтвержденнаяРуб]) <>
		ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные, ИмяПоляСуммаБухУчетРуб, ИмяПоляСуммаПодтвержденнаяРуб, ИмяПоляСуммаНеподтвержденнаяРуб)
	
	// Корректируем наибольшую рублевую сумму.
	
	СуммаПодтвержденнаяРуб = ТекДанные[ИмяПоляСуммаПодтвержденнаяРуб];
	СуммаНеподтвержденнаяРуб = ТекДанные[ИмяПоляСуммаНеподтвержденнаяРуб];
	СуммаБухУчетРуб = ТекДанные[ИмяПоляСуммаБухУчетРуб];
	
	Подтвержденная = Макс(СуммаПодтвержденнаяРуб, -СуммаПодтвержденнаяРуб);
	Неподтвержденная = Макс(СуммаНеподтвержденнаяРуб, -СуммаНеподтвержденнаяРуб);
	
	Если Подтвержденная > Неподтвержденная Тогда
		ИмяПоля = ИмяПоляСуммаПодтвержденнаяРуб;
	Иначе
		ИмяПоля = ИмяПоляСуммаНеподтвержденнаяРуб;
	КонецЕсли;
	
	ТекДанные[ИмяПоля] = СуммаБухУчетРуб - (СуммаПодтвержденнаяРуб + СуммаНеподтвержденнаяРуб - ТекДанные[ИмяПоля]);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПросроченную(ТекДанные, ВидРасчетов, СтатусыПросроченнойЗадолженности)
	
	ИмяПоляСуммаВал = ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная");
	ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, "Просроченная", "");
	
	СтатусЗадолженности = ТекДанные[ИмяПоляСтатусЗадолженности(ВидРасчетов)];
	
	Если СтатусыПросроченнойЗадолженности.Найти(СтатусЗадолженности) <> Неопределено Тогда
		СуммаБухУчетВал = ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "Валютная")];
		СуммаБухУчетРуб = ТекДанные[ИмяПоляСумма(ВидРасчетов, "", "")];
		
		ТекДанные[ИмяПоляСуммаВал] = СуммаБухУчетВал;
		ТекДанные[ИмяПоляСуммаРуб] = СуммаБухУчетРуб;
	Иначе
		ТекДанные[ИмяПоляСуммаВал] = 0;
		ТекДанные[ИмяПоляСуммаРуб] = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПросроченнаяЗаполнена(ТекДанные, ВидРасчетов)
	
	ИмяПоляСуммаВал = ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная");
	ИмяПоляСуммаРуб = ИмяПоляСумма(ВидРасчетов, "Просроченная", "");
	
	Возврат ЗначениеЗаполнено(ТекДанные[ИмяПоляСуммаВал]) Или ЗначениеЗаполнено(ТекДанные[ИмяПоляСуммаРуб]);
	
КонецФункции

