Процедура УстановитьПредставлениеМестаПроведения()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеМестаПроведения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеСпискаСчетов(СписокСчетов, МаксимальнаяДлинаСтроки = 50)
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаТаблицы.КФО), Строка(СтрокаТаблицы.КФО), "0"),
			Строка(СтрокаТаблицы.Счет)));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Представление = НСтр("ru='<отсутствует>'");
	Иначе
		Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "), МаксимальнаяДлинаСтроки);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

&НаСервере
Процедура НастроитьСпискиВыбораСтатусовЗадолженности()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел2СтатусЗадолженностиОД");
	ИменаЭлементов.Добавить("Раздел2СтатусЗадолженностиПроцентов");
	ИменаЭлементов.Добавить("Раздел2СтатусЗадолженностиШтрафов");
	ИменаЭлементов.Добавить("Раздел2СтатусЗадолженностиПеней");
	
	Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].СписокВыбора.ЗагрузитьЗначения(Список);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровкуСтрокиРаздела(ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	
	// В отчете дата задается не границей, а датой.
	ПараметрыФормы.Вставить("ДатаОтчета",						ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации));
	ПараметрыФормы.Вставить("Организация",						Объект.Организация);
	ПараметрыФормы.Вставить("ВидЗадолженности",					ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская"));
	ПараметрыФормы.Вставить("ВидЗадолженностиИспользование",	Истина);
	ПараметрыФормы.Вставить("Контрагент",						ТекДанные.Контрагент);
	ПараметрыФормы.Вставить("Договор",							ТекДанные.Договор);
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки",	"ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов",			ТекДанные.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС",					ТекДанные.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО",					ТекДанные.КФО);
	ПараметрыФормы.Расшифровка.Вставить("ИФО",					ТекДанные.ИФО);
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, ТекДанные.ИсходныйНомерСтроки);
	
КонецПроцедуры

