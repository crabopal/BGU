#Область Раздел1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент()
	
	Отказ = Ложь;
	
	ПроверитьИЗаполнитьРаздел1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Раздел1.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением по данным учета все табличные части документа будут очищены.
			|
			|Продолжить и заполнить по данным учета?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРаздел1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаполнитьРаздел1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРаздел1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	Объект.Раздел1.Очистить();
	Объект.Раздел2.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер()
	
	ПараметрыФункции = Новый Структура("
		|ДатаИнвентаризации,
		|Организация,
		|Подразделение,
		|ИФО,
		|СписокСчетов,
		|МестоИнвентаризации,
		|НаименованиеЗадолженности");
		
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыФункции.СписокСчетов = Объект.СписокСчетов.Выгрузить();
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510471'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьДанныеУчета",
		ПараметрыФункции);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ТекстСообщения = Неопределено;
		
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел1.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении по данным учета возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел1.Загрузить(Результат.ТаблицаДляРаздела1);
	
	ЗаполнитьСлужебныеКолонки();
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Раздел2

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2Клиент(Команда)
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтаФорма,
		НСтр("ru = 'Заполнить по данным раздела 1'"),
		"ПроверитьИЗаполнитьРаздел2ПослеПроверкиЗаписиДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел2.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличная часть документа будет очищена.
			|
			|Продолжить и заполнить раздел 2?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел2КлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРаздел2Клиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2КлиентЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРаздел2Клиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел2Клиент(ДополнительныеПараметры)
	
	Объект.Раздел2.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел2Сервер(ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел2Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел2Сервер(ДополнительныеПараметры)
	
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции.Вставить("ДокументСсылка", Объект.Ссылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 2 инвентаризационной описи 0510471'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьДанныеДляЗаполненияРаздела2",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел2Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел2Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел2.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 2 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 2 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел2Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел2.Загрузить(Результат.ТаблицаРаздела2);
	
	ЗаполнитьСлужебныеКолонки();
	
	Модифицированность = Истина;
	
КонецПроцедуры

