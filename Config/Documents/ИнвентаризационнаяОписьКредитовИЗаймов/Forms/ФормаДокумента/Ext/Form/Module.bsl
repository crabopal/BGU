#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьФорму();
	
	НастроитьФорму();
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект);
	// Конец Централизованная бухгалтерия
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		// Обработчик подсистемы запрета редактирования реквизитов объектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1Сдокументооборотом
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВидимостьИтоговРаздела2 Тогда
		Элементы.ГруппаРаздел2Итого.Показать();
	Иначе
		Элементы.ГруппаРаздел2Итого.Скрыть();
	КонецЕсли;
	
	Если ВидимостьСведенийОбИнвентаризацииИзРешения Тогда
		Элементы.ГруппаСведенияИзРешения.Показать();
	Иначе
		Элементы.ГруппаСведенияИзРешения.Скрыть();
	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ВидимостьИтоговРаздела2 = Не Элементы.ГруппаРаздел2Итого.Скрыта();
	
	ВидимостьСведенийОбИнвентаризацииИзРешения = Не Элементы.ГруппаСведенияИзРешения.Скрыта();
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПанельРасписки
	Если ИмяСобытия = "ЗаписанДокументРаспискиИнвентаризации" И Объект.Ссылка = Параметр.ДокументОписи Тогда
		НастроитьФормуПоРасписке();
	КонецЕсли;
	// Конец ПанельРасписки
	
	// Внутренний ЭДО
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	// Конец Внутренний ЭДО
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ИнициализацияФормыВыполнена Тогда
		НастроитьФорму();
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом  
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1Сдокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НастроитьФорму();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		// Обработчик подсистемы запрета редактирования реквизитов объектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РешениеОПроведенииИнвентаризацииПриИзменении(Элемент)
	
	// РешениеОПроведенииИнвентаризации
	ИнвентаризацияКлиент.ВыбраноРешениеОПроведенииИнвентаризации(ЭтотОбъект);
	// Конец РешениеОПроведенииИнвентаризации
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеСпискаСчетовНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущийЭлемент = Элементы.ГруппаСписокСчетов;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеМестаПроведенияНажатие(Элемент, СтандартнаяОбработка)
	
	ИнвентаризацияКлиент.ПоказатьМестоПроведенияИнвентаризации(ЭтотОбъект, СтандартнаяОбработка);
	
КонецПроцедуры

#Область ПанельРасписки

&НаКлиенте
Процедура ДекорацияРаспискаНадписьНажатие(Элемент)
	
	ДополнительноПроверяемыеПоляПередСозданиемРасписки = Новый Структура();
	ДополнительноПроверяемыеПоляПередСозданиемРасписки.Вставить("НаименованиеЗадолженности",
		НСтр("ru='Наименование задолженности'"));
	
	ИнвентаризацияКлиент.ПриНажатииНадписиРасписка(ЭтаФорма, ДополнительноПроверяемыеПоляПередСозданиемРасписки);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРаспискаКомментарийГиперссылкаНадписьНажатие(Элемент)
	
	ИнвентаризацияКлиент.ПриНажатииГиперссылкиКомментарияПанелиРасписки(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область РешениеОПроведенииИнвентаризации

&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтотОбъект, РезультатВыбора);
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
	Объект.Раздел1.Очистить();
	Объект.Раздел2.Очистить();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
	НовоеЗначениеНаименованияЗадолженности = Неопределено;
	Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ЗаполнитьСписокВыбораНаименованияЗадолженности(ЭтотОбъект, НовоеЗначениеНаименованияЗадолженности);
	Объект.НаименованиеЗадолженности = НовоеЗначениеНаименованияЗадолженности;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

#Область ОтборПоПодразделению

&НаКлиенте
Процедура ДекорацияПодразделениеНажатие(Элемент)
	
	ИнвентаризацияКлиент.ПриНажатииНаДекорациюПодразделение(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

#КонецОбласти

// Внутренний ЭДО
&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры
// Конец Внутренний ЭДО

// СтандартныеПодсистемы.РаботаСФайлами
&НаКлиенте
Процедура Подключаемый_ПолеПредпросмотраНажатие(Элемент, СтандартнаяОбработка)
    
    РаботаСФайламиКлиент.ПолеПредпросмотраНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
    
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолеПредпросмотраПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
    
    РаботаСФайламиКлиент.ПолеПредпросмотраПеретаскивание(ЭтотОбъект, Элемент,
                ПараметрыПеретаскивания, СтандартнаяОбработка);
    
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолеПредпросмотраПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
    
    РаботаСФайламиКлиент.ПолеПредпросмотраПроверкаПеретаскивания(ЭтотОбъект, Элемент,
                ПараметрыПеретаскивания, СтандартнаяОбработка);
    
КонецПроцедуры
// Конец СтандартныеПодсистемы.РаботаСФайлами

// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
	УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект);
КонецПроцедуры
//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Раздел2

&НаКлиенте
Процедура Раздел2Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если НеобходимоОткрытьФормуРазбивкиСтроки(Поле) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПроверитьИОткрытьФормуРазбивкиСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел2ВалютаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если ТекДанные.Валюта = ВалютаРУ Тогда
		ОчиститьВалютныеСуммыВСтрокеТаблицы(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтатусаЗадолженности(Элемент)
	
	ВидРасчетов = СтрЗаменить(Элемент.Имя, "Раздел2СтатусЗадолженности", "");
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	ЗаполнитьПросроченную(ТекДанные, ВидРасчетов, ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности());
	
	ЗаполнитьИтогоПросроченная(ТекДанные);
	
	НастроитьФлажокТребуетРеклассификации(ТекДанные, ВидРасчетов);
	
КонецПроцедуры

// Осн. долг, вал.

&НаКлиенте
Процедура Раздел2СуммаОДВалютнаяПриИзменении(Элемент)
	
	РассчитатьСуммыВСтрокеРаздела2(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел2СуммаОДПодтвержденнаяВалютнаяПриИзменении(Элемент)
	
	РассчитатьСуммыВСтрокеРаздела2(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел2СуммаОДНеподтвержденнаяВалютнаяПриИзменении(Элемент)
	
	РассчитатьСуммыВСтрокеРаздела2(Элемент);
	
