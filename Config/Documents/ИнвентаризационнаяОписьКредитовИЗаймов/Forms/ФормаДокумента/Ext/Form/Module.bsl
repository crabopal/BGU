	ИменаЭлементов.Добавить("Раздел2РазбитьСтроку");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		РаспискаПроведена);
	
