&НаСервере
Процедура ИнициализироватьФорму()
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Значения настроек из общего модуля.
	ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной =
		ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной();
	
	ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности =
		ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности();
	
	ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме =
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме();
		
	Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ИнициализироватьКэшИменПолейДляФормыДокумента(ЭтотОбъект);
	
	ИменаПолейБезОткрытияФормыРазбивкиСтроки.ЗагрузитьЗначения(
		Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьИменаПолейРаздела2РедактируемыхБезОткрытияФормыРазбивкиСтроки());
		
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	НастроитьНедоступностьИзмененияКолонок();
	
	НастроитьСпискиВыбораСтатусовЗадолженности();
	
	УстановитьУсловноеОформление();
	
	ВидимостьИтоговРаздела2 = Истина; // Значение по умолчанию.
	ВидимостьСведенийОбИнвентаризацииИзРешения = Истина; // Значение по умолчанию.
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	УстановитьПредставлениеНомераКомиссии();
	
	УстановитьПредставлениеМестаПроведения();
	
	ЗаполнитьСлужебныеКолонки();
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
	НастроитьОтборПоПодразделению();
	
	Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ЗаполнитьСписокВыбораНаименованияЗадолженности(ЭтотОбъект);
	
КонецПроцедуры

