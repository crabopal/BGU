#Область ГрупповоеЗаполнениеСтрок

&НаКлиенте
Процедура ПроверитьИОткрытьФормуГрупповогоЗаполненияСтрок()
	
	Перем КоличествоВыделенныхСтрок;
	
	Если Не ПроверитьПередОткрытиемФормыГрупповогоЗаполненияСтрок(КоличествоВыделенныхСтрок) Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтотОбъект);
	
	ПараметрыФормы = ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(КоличествоВыделенныхСтрок);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьКредитовИЗаймов.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередОткрытиемФормыГрупповогоЗаполненияСтрок(КоличествоВыделенныхСтрок)
	
	КоличествоВыделенныхСтрок = Элементы.Раздел2.ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенныхСтрок <= 1 Тогда
		ТекстСообщения = НСтр("ru='Выделите более одной строки для выполнения группового заполнения.'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(КоличествоСтрок)
	
	ДополнительныеПараметры = Новый Структура("
		|Дата,
		|ДатаИнвентаризации,
		|Организация,
		|ИФО,
		|Подразделение,
		|НаименованиеЗадолженности");
	
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, Объект);
	
	ЗначенияЗаполнения = Новый Структура();
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("ЗаключениеКомиссии");
		
		ЗначенияЗаполнения.Вставить("ПодтверждениеАктомСверкиОД");
		ЗначенияЗаполнения.Вставить("ПодтверждениеАктомСверкиПроцентов");
		ЗначенияЗаполнения.Вставить("ПодтверждениеАктомСверкиШтрафов");
		ЗначенияЗаполнения.Вставить("ПодтверждениеАктомСверкиПеней");
		
		ЗначенияЗаполнения.Вставить("ДатаАктаСверкиОД");
		ЗначенияЗаполнения.Вставить("ДатаАктаСверкиПроцентов");
		ЗначенияЗаполнения.Вставить("ДатаАктаСверкиШтрафов");
		ЗначенияЗаполнения.Вставить("ДатаАктаСверкиПеней");
		
		ЗначенияЗаполнения.Вставить("НомерАктаСверкиОД");
		ЗначенияЗаполнения.Вставить("НомерАктаСверкиПроцентов");
		ЗначенияЗаполнения.Вставить("НомерАктаСверкиШтрафов");
		ЗначенияЗаполнения.Вставить("НомерАктаСверкиПеней");
		
		ЗначенияЗаполнения.Вставить("СтатусЗадолженностиОД");
		ЗначенияЗаполнения.Вставить("СтатусЗадолженностиПроцентов");
		ЗначенияЗаполнения.Вставить("СтатусЗадолженностиШтрафов");
		ЗначенияЗаполнения.Вставить("СтатусЗадолженностиПеней");
		
		ЗначенияЗаполнения.Вставить("СуммаОДТребуетРеклассификации");
		ЗначенияЗаполнения.Вставить("СуммаПроцентовТребуетРеклассификации");
		ЗначенияЗаполнения.Вставить("СуммаШтрафовТребуетРеклассификации");
		ЗначенияЗаполнения.Вставить("СуммаПенейТребуетРеклассификации");
		
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ТекДанные);
		
		ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДополнительныеПараметры",	ДополнительныеПараметры);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("ОписьСсылка",				Объект.Ссылка);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьВыделенныеСтрокиРаздела2(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыделенныеСтрокиРаздела2(ВыбранноеЗначение)
	
	Перем СписокИдентификаторовСтрок;
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыГрупповогоЗаполненияСтрок();
	
	НастройкиСтатусовЗадолженности = ПолучитьЗаполненныеНастройкиГрупповогоЗаполненияСтрок(ВыбранноеЗначение, "СтатусЗадолженности");
	
	НастройкиТребуетРеклассификации = ПолучитьЗаполненныеНастройкиГрупповогоЗаполненияСтрок(ВыбранноеЗначение, "ТребуетРеклассификации", "Сумма%2%1");
	
	НастройкиПодтвержденияАктамиСверки = ПолучитьЗаполненныеНастройкиГрупповогоЗаполненияСтрок(ВыбранноеЗначение, "ПодтверждениеАктомСверки");
	
	НастройкиОчисткиСуммАктовСверки = ПолучитьЗаполненныеНастройкиГрупповогоЗаполненияСтрок(ВыбранноеЗначение, "ОчиститьВсеСуммыПриОтсутствииАктаСверки");
	
	ЕстьНастройкиСвязанныеСАктомСверки = (НастройкиПодтвержденияАктамиСверки.Количество() > 0
		Или НастройкиОчисткиСуммАктовСверки.Количество() > 0);
	
	ВыделенныеСтроки = Элементы.Раздел2.ВыделенныеСтроки;
	
	// Некоторые показатели указываются только в первом фрагменте строки,
	// а в последующих фрагментах строки (очередных) должны быть пустыми.
	ПервыеСтрокиВыделенныхФрагментов = ПолучитьПервыеСтрокиВыделенныхФрагментов(ВыделенныеСтроки, СписокИдентификаторовСтрок);
	
	ТаблицыИтоговФрагментовСтрок = Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьТаблицыИтоговСуммБухУчетаФрагментовСтрок(
		ЭтотОбъект, СписокИдентификаторовСтрок, НастройкиПодтвержденияАктамиСверки);
	
	ОбработанныеИдентификаторыСтрокФрагментов = Новый Соответствие();
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Раздел2.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыбранноеЗначение);
		
		Если НастройкиСтатусовЗадолженности.Количество() > 0 Тогда
			ЗаполнитьСтатусыЗадолженностиВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры);
			
			ЗаполнитьПросроченныеСуммыВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры);
			
			ЗаполнитьТребуетРеклассификацииВыделеннойСтрокиРаздела2ПоНастройкамСтатусов(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры);
		КонецЕсли;
		
		Если НастройкиТребуетРеклассификации.Количество() > 0 Тогда
			ЗаполнитьТребуетРеклассификацииВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиТребуетРеклассификации, ДополнительныеПараметры);
		КонецЕсли;
		
		ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		
		ЭтоСтрокаФрагмента = ЗначениеЗаполнено(ИдентификаторСтроки);
		
		Если ЭтоСтрокаФрагмента И Не СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
			// Выделенная строка фрагмента - очередная строка.
			// В таких строках очищаем показатели, связанные с актом сверки.
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДополнительныеПараметры.ОчищающаяСтруктураОчередныхСтрокФрагментов);
		КонецЕсли;
		
		Если ЕстьНастройкиСвязанныеСАктомСверки Тогда
			Если ЭтоСтрокаФрагмента Тогда
				ВремИдСтроки = ОбработанныеИдентификаторыСтрокФрагментов.Получить(ИдентификаторСтроки);
				
				Если ВремИдСтроки <> Неопределено Тогда
					// В первой строке этих фрагментов строк уже обработаны все показатели, зависящие от акта сверки.
					Продолжить;
				КонецЕсли;
				
				СтрокаТаблицы = ПолучитьСтрокуПервогоФрагмента(СтрокаТаблицы, ПервыеСтрокиВыделенныхФрагментов);
				
				ОбработанныеИдентификаторыСтрокФрагментов.Вставить(ИдентификаторСтроки, Истина);
			КонецЕсли;
			
			Если НастройкиПодтвержденияАктамиСверки.Количество() > 0 Тогда
				ТаблицаИтоговФрагментовСтрок = ТаблицыИтоговФрагментовСтрок.Получить(ИдентификаторСтроки);
				
				ИтогиФрагментовСтрок = ?(ТаблицаИтоговФрагментовСтрок <> Неопределено,
					ТаблицаИтоговФрагментовСтрок[0], Неопределено);
				
				ПрименитьНастройкиПодтвержденияАктамиСверки(СтрокаТаблицы, ВыбранноеЗначение, НастройкиПодтвержденияАктамиСверки,
					ИтогиФрагментовСтрок, ДополнительныеПараметры);
			КонецЕсли;

			Если НастройкиОчисткиСуммАктовСверки.Количество() > 0 Тогда
				ПрименитьНастройкиОчисткиСуммАктовСверки(СтрокаТаблицы, НастройкиОчисткиСуммАктовСверки, ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуПервогоФрагмента(СтрокаТаблицы, ПервыеСтрокиВыделенныхФрагментов)
	
	Если СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
		Возврат СтрокаТаблицы;
	КонецЕсли;
	
	ИдСтроки = ПервыеСтрокиВыделенныхФрагментов.Получить(СтрокаТаблицы.ИдентификаторСтроки);
	
	Возврат Объект.Раздел2.НайтиПоИдентификатору(ИдСтроки);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтатусыЗадолженностиВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры)
	
	// При групповом заполнении строк статус задолженности устанавливается только при заполненной сумме бух.учета.
	
	Для Каждого Элемент Из НастройкиСтатусовЗадолженности Цикл
		ВидРасчетов = Элемент.Ключ;
		СтатусЗадолженности = Элемент.Значение;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ВидРасчетов];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИменаПолей.СуммаВалютная])
			И Не ЗначениеЗаполнено(СтрокаТаблицы[ИменаПолей.Сумма]) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы[ИменаПолей.СтатусЗадолженности] = СтатусЗадолженности;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПросроченныеСуммыВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры)
	
	// При групповом заполнении строк просроченные суммы заполняются при условии свершившейся установки
	// статуса задолженности, связанного с просроченной задолженность.
	
	Для Каждого Элемент Из НастройкиСтатусовЗадолженности Цикл
		ВидРасчетов = Элемент.Ключ;
		СтатусЗадолженности = Элемент.Значение;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ВидРасчетов];
		
		Если ДополнительныеПараметры.СтатусыПросроченнойЗадолженности.Найти(СтатусЗадолженности) <> Неопределено Тогда
			СуммаПросроченнаяВалютная = СтрокаТаблицы[ИменаПолей.СуммаВалютная];
			СуммаПросроченная = СтрокаТаблицы[ИменаПолей.Сумма];
		Иначе
			СуммаПросроченнаяВалютная = 0;
			СуммаПросроченная = 0;
		КонецЕсли;
		
		СтрокаТаблицы[ИменаПолей.СуммаПросроченнаяВалютная]	= СуммаПросроченнаяВалютная;
		СтрокаТаблицы[ИменаПолей.СуммаПросроченная]			= СуммаПросроченная;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТребуетРеклассификацииВыделеннойСтрокиРаздела2ПоНастройкамСтатусов(СтрокаТаблицы, НастройкиСтатусовЗадолженности, ДополнительныеПараметры)
	
	// При групповом заполнении строк флажок "Требует реклассификации" устанавливается
	// только при наличии заполненной просроченной суммы.
	// Просроченная сумма могла быть установлена ранее, при применении статусов по указанным настройкам.
	
	Для Каждого Элемент Из НастройкиСтатусовЗадолженности Цикл
		ВидРасчетов = Элемент.Ключ;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ВидРасчетов];
		
		СуммаПросроченнаяВалютная = СтрокаТаблицы[ИменаПолей.СуммаПросроченнаяВалютная];
		СуммаПросроченная = СтрокаТаблицы[ИменаПолей.СуммаПросроченная];
		
		СтрокаТаблицы[ИменаПолей.СуммаТребуетРеклассификации] =
			ЗначениеЗаполнено(СуммаПросроченнаяВалютная) Или ЗначениеЗаполнено(СуммаПросроченная);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТребуетРеклассификацииВыделеннойСтрокиРаздела2(СтрокаТаблицы, НастройкиТребуетРеклассификации, ДополнительныеПараметры)
	
	// При групповом заполнении строк флажок "Требует реклассификации" устанавливается
	// только при наличии заполненной просроченной суммы.
	
	Для Каждого Элемент Из НастройкиТребуетРеклассификации Цикл
		ВидРасчетов = Элемент.Ключ;
		ТребуетРеклассификации = Элемент.Значение;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ВидРасчетов];
		
		СуммаПросроченнаяВалютная = СтрокаТаблицы[ИменаПолей.СуммаПросроченнаяВалютная];
		СуммаПросроченная = СтрокаТаблицы[ИменаПолей.СуммаПросроченная];
		
		Если ТребуетРеклассификации И (ЗначениеЗаполнено(СуммаПросроченнаяВалютная) Или ЗначениеЗаполнено(СуммаПросроченная)) Тогда
			СтрокаТаблицы[ИменаПолей.СуммаТребуетРеклассификации] = Истина;
			
		ИначеЕсли Не ТребуетРеклассификации Тогда
			СтрокаТаблицы[ИменаПолей.СуммаТребуетРеклассификации] = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПервыеСтрокиВыделенныхФрагментов(Знач ВыделенныеСтроки, СписокИдентификаторовСтрок)
	
	СписокИдентификаторовСтрок = Новый Массив();
	
	ПервыеСтрокиФрагментов = Новый Соответствие();
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Раздел2.НайтиПоИдентификатору(ИдСтроки);
		
		ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		
		Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		ИдПервойСтроки = ПервыеСтрокиФрагментов.Получить(ИдентификаторСтроки);
		
		Если ИдПервойСтроки <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
			ПервыеСтрокиФрагментов.Вставить(ИдентификаторСтроки, ИдСтроки);
		Иначе
			Поиск.ИдентификаторСтроки = ИдентификаторСтроки;
			
			МассивСтрок = Объект.Раздел2.НайтиСтроки(Поиск);
			
			ПервыеСтрокиФрагментов.Вставить(ИдентификаторСтроки, МассивСтрок[0].ПолучитьИдентификатор());
		КонецЕсли;
		
		СписокИдентификаторовСтрок.Добавить(ИдентификаторСтроки);
	КонецЦикла;
	
	Возврат ПервыеСтрокиФрагментов;
	
КонецФункции

&НаСервере
Функция ПолучитьЗаполненныеНастройкиГрупповогоЗаполненияСтрок(ВыбранноеЗначение, ПрефиксИменПолей, Шаблон = "%1%2")
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	Настройки = Новый Структура();
	
	Для Каждого ПостфиксВидаРасчета Из ПостфиксыВидовРасчета Цикл
		ИмяПоля = СтрШаблон(Шаблон, ПрефиксИменПолей, ПостфиксВидаРасчета);
		
		Если ВыбранноеЗначение.Свойство(ИмяПоля) Тогда
			Настройки.Вставить(ПостфиксВидаРасчета, ВыбранноеЗначение[ИмяПоля]);
			
			ВыбранноеЗначение.Удалить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

&НаСервере
Процедура ПрименитьНастройкиПодтвержденияАктамиСверки(СтрокаТаблицы, ВыбранноеЗначение, НастройкиПодтвержденияАктамиСверки,
	ИтогиФрагментовСтрок, ДополнительныеПараметры)
	
	Для Каждого Элемент Из НастройкиПодтвержденияАктамиСверки Цикл
		ПостфиксВидаРасчета = Элемент.Ключ;
		ПодтверждениеАктомСверки = Элемент.Значение;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ПостфиксВидаРасчета];
		Настройка = ДополнительныеПараметры.НастройкиПодтвержденияАктамиСверки[ПостфиксВидаРасчета];
		
		Если ИтогиФрагментовСтрок <> Неопределено Тогда
			ИсточникСведений = ИтогиФрагментовСтрок;
		Иначе
			ИсточникСведений = СтрокаТаблицы;
		КонецЕсли;
		
		СуммаБухУчетВалютная= ИсточникСведений[ИменаПолей.СуммаВалютная];
		СуммаБухУчет		= ИсточникСведений[ИменаПолей.Сумма];
		
		Если ПодтверждениеАктомСверки = 0 Тогда
			// Сумма не подтверждена в полном объеме.
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Настройка.ОчищающаяСтруктураЕслиНеПодтверждена);
			
			СтрокаТаблицы[ИменаПолей.СуммаНеподтвержденнаяВалютная] = СуммаБухУчетВалютная;
			СтрокаТаблицы[ИменаПолей.СуммаНеподтвержденная] = СуммаБухУчет;
			
		ИначеЕсли ПодтверждениеАктомСверки = 1 Тогда
			// Сумма подтверждена в полном объеме.
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Настройка.ОчищающаяСтруктураЕслиПодтверждена);
			
			СтрокаТаблицы[ИменаПолей.СуммаПодтвержденнаяВалютная] = СуммаБухУчетВалютная;
			СтрокаТаблицы[ИменаПолей.СуммаПодтвержденная] = СуммаБухУчет;
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыбранноеЗначение,
				ИменаПолей.ДатаАктаСверки + "," + ИменаПолей.НомерАктаСверки);
		КонецЕсли;
		
		ОчиститьНедоступныеПоляВСтрокеРаздела2(СтрокаТаблицы, ПостфиксВидаРасчета, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьНастройкиОчисткиСуммАктовСверки(СтрокаТаблицы, НастройкиОчисткиСуммАктовСверки, ДополнительныеПараметры)
	
	Для Каждого Элемент Из НастройкиОчисткиСуммАктовСверки Цикл
		ПостфиксВидаРасчета = Элемент.Ключ;
		ОчиститьСуммы = Элемент.Значение;
		
		Если Не ОчиститьСуммы Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПолей = ДополнительныеПараметры.НастройкиИменПолей[ПостфиксВидаРасчета];
		Настройка = ДополнительныеПараметры.НастройкиОчисткиСуммАктовСверки[ПостфиксВидаРасчета];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИменаПолей.ДатаАктаСверки])
			И Не ЗначениеЗаполнено(СтрокаТаблицы[ИменаПолей.НомерАктаСверки]) Тогда
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Настройка.ОчищающаяСтруктура);
		КонецЕсли;
    КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДополнительныеПараметрыГрупповогоЗаполненияСтрок()
	
	ПустаяДата = '00010101';
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	ОчищающаяСтруктураОчередныхСтрокФрагментов = Новый Структура();
	
	НастройкиИменПолей = Новый Структура();
	
	НастройкиПодтвержденияАктамиСверки = Новый Структура();
	
	НастройкиОчисткиСуммАктовСверки = Новый Структура();
	
	Для Каждого ВидРасчетов Из ПостфиксыВидовРасчета Цикл
		ИменаПолей = Новый Структура();
		ИменаПолей.Вставить("СуммаВалютная",					ИмяПоляСумма(ВидРасчетов, "", "Валютная"));
		ИменаПолей.Вставить("Сумма",							ИмяПоляСумма(ВидРасчетов, "", ""));
		ИменаПолей.Вставить("СуммаПросроченнаяВалютная",		ИмяПоляСумма(ВидРасчетов, "Просроченная", "Валютная"));
		ИменаПолей.Вставить("СуммаПросроченная",				ИмяПоляСумма(ВидРасчетов, "Просроченная", ""));
		ИменаПолей.Вставить("СуммаПодтвержденнаяВалютная",		ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "Валютная"));
		ИменаПолей.Вставить("СуммаПодтвержденная",				ИмяПоляСумма(ВидРасчетов, "Подтвержденная", ""));
		ИменаПолей.Вставить("СуммаНеподтвержденнаяВалютная",	ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "Валютная"));
		ИменаПолей.Вставить("СуммаНеподтвержденная",			ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", ""));
		ИменаПолей.Вставить("СтатусЗадолженности",				ИмяПоляСтатусЗадолженности(ВидРасчетов));
		ИменаПолей.Вставить("ДатаАктаСверки",					ИмяПоляДатаАктаСверки(ВидРасчетов));
		ИменаПолей.Вставить("НомерАктаСверки",					ИмяПоляНомерАктаСверки(ВидРасчетов));
		ИменаПолей.Вставить("СуммаТребуетРеклассификации",		ИмяПоляТребуетРеклассификации(ВидРасчетов));
		
		НастройкиИменПолей.Вставить(ВидРасчетов, ИменаПолей);
		
		// Фрагменты строки
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.ДатаАктаСверки, ПустаяДата);
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.НомерАктаСверки, "");
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.СуммаПодтвержденнаяВалютная, 0);
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.СуммаПодтвержденная, 0);
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.СуммаНеподтвержденнаяВалютная, 0);
		ОчищающаяСтруктураОчередныхСтрокФрагментов.Вставить(ИменаПолей.СуммаНеподтвержденная, 0);
		
		// Для настройки подтверждения актами сверки.
		
		ОчищающаяСтруктураЕслиНеПодтверждена = Новый Структура();
		ОчищающаяСтруктураЕслиНеПодтверждена.Вставить(ИменаПолей.СуммаПодтвержденнаяВалютная, 0);
		ОчищающаяСтруктураЕслиНеПодтверждена.Вставить(ИменаПолей.СуммаПодтвержденная, 0);
		ОчищающаяСтруктураЕслиНеПодтверждена.Вставить(ИменаПолей.ДатаАктаСверки, ПустаяДата);
		ОчищающаяСтруктураЕслиНеПодтверждена.Вставить(ИменаПолей.НомерАктаСверки, "");
		
		ОчищающаяСтруктураЕслиПодтверждена = Новый Структура();
		ОчищающаяСтруктураЕслиПодтверждена.Вставить(ИменаПолей.СуммаНеподтвержденнаяВалютная, 0);
		ОчищающаяСтруктураЕслиПодтверждена.Вставить(ИменаПолей.СуммаНеподтвержденная, 0);
		
		Настройка = Новый Структура();
		Настройка.Вставить("ОчищающаяСтруктураЕслиНеПодтверждена", ОчищающаяСтруктураЕслиНеПодтверждена);
		Настройка.Вставить("ОчищающаяСтруктураЕслиПодтверждена", ОчищающаяСтруктураЕслиПодтверждена);
		
		НастройкиПодтвержденияАктамиСверки.Вставить(ВидРасчетов, Настройка);
		
		// Для настройки очистки сумм при отсутствии акта сверки.
		ИменаПолей = Новый Структура();
		ИменаПолей.Вставить("ДатаАктаСверки", ИмяПоляДатаАктаСверки(ВидРасчетов));
		ИменаПолей.Вставить("НомерАктаСверки", ИмяПоляНомерАктаСверки(ВидРасчетов));
		
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить(ИмяПоляСумма(ВидРасчетов, "Подтвержденная", "Валютная"), 0);
		ОчищающаяСтруктура.Вставить(ИмяПоляСумма(ВидРасчетов, "Подтвержденная", ""), 0);
		ОчищающаяСтруктура.Вставить(ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", "Валютная"), 0);
		ОчищающаяСтруктура.Вставить(ИмяПоляСумма(ВидРасчетов, "Неподтвержденная", ""), 0);
		
		Настройка = Новый Структура();
		Настройка.Вставить("ОчищающаяСтруктура", ОчищающаяСтруктура);
		
		НастройкиОчисткиСуммАктовСверки.Вставить(ВидРасчетов, Настройка);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НастройкиИменПолей", НастройкиИменПолей);
	ДополнительныеПараметры.Вставить("ОчищающаяСтруктураОчередныхСтрокФрагментов", ОчищающаяСтруктураОчередныхСтрокФрагментов);
	ДополнительныеПараметры.Вставить("НастройкиПодтвержденияАктамиСверки", НастройкиПодтвержденияАктамиСверки);
	ДополнительныеПараметры.Вставить("НастройкиОчисткиСуммАктовСверки", НастройкиОчисткиСуммАктовСверки);
	ДополнительныеПараметры.Вставить("СтатусыПросроченнойЗадолженности", ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьНедоступныеПоляВСтрокеРаздела2(СтрокаТаблицы, ПостфиксВидаРасчета, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности)
	
	Если Не ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности Тогда
		ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы, ПостфиксВидаРасчета);
	КонецЕсли;
	
	ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета(СтрокаТаблицы, ПостфиксВидаРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета(СтрокаТаблицы, ПостфиксВидаРасчета)
	
	// Поле статуса задолженности недоступно (очищается), если отсутствует сумма по бух.учету.
	
	ПустойСтатус = Неопределено;
	
	Если СтрокаТаблицы.СуммаОДВалютная = 0 И СтрокаТаблицы.СуммаОД = 0 Тогда
		СтрокаТаблицы.СтатусЗадолженностиОД = ПустойСтатус;
		СтрокаТаблицы.СуммаОДТребуетРеклассификации = Ложь;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПроцентовВалютная = 0 И СтрокаТаблицы.СуммаПроцентов = 0 Тогда
		СтрокаТаблицы.СтатусЗадолженностиПроцентов = ПустойСтатус;
		СтрокаТаблицы.СуммаПроцентовТребуетРеклассификации = Ложь;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаШтрафовВалютная = 0 И СтрокаТаблицы.СуммаШтрафов = 0 Тогда
		СтрокаТаблицы.СтатусЗадолженностиШтрафов = ПустойСтатус;
		СтрокаТаблицы.СуммаШтрафовТребуетРеклассификации = Ложь;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПенейВалютная = 0 И СтрокаТаблицы.СуммаПеней = 0 Тогда
		СтрокаТаблицы.СтатусЗадолженностиПеней = ПустойСтатус;
		СтрокаТаблицы.СуммаПенейТребуетРеклассификации = Ложь;
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы, ПостфиксВидаРасчета)
	
	// Поля акта сверки недоступны (очищаются), если отсутствует подтвержденная сумма.
	
	ПустаяДата = '00010101';
	ПустойНомер = "";
	
	Если СтрокаТаблицы.СуммаОДПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаОДПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиОД = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиОД = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПроцентовПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаПроцентовПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиПроцентов = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиПроцентов = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаШтрафовПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаШтрафовПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиШтрафов = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиШтрафов = ПустойНомер;
	КонецЕсли;
	
	Если СтрокаТаблицы.СуммаПенейПодтвержденнаяВалютная = 0 И СтрокаТаблицы.СуммаПенейПодтвержденная = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверкиПеней = ПустаяДата;
		СтрокаТаблицы.НомерАктаСверкиПеней = ПустойНомер;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтроки

&НаКлиенте
Процедура ПроверитьИОткрытьФормуРазбивкиСтроки()
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если Не ПроверитьПередОткрытиемФормыРазбивкиСтроки(ТекДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуРазбивкиСтроки();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередОткрытиемФормыРазбивкиСтроки(ТекДанные)
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку.'"));
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоВыделенныхСтрок = Элементы.Раздел2.ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенныхСтрок > 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите только одну строку для разбивки.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) И Не ЕстьЗаполненныеСуммыБухУчета(ТекДанные) Тогда
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке все суммы бух.учета нулевые. Разбивка таких строк не предусмотрена.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПодтвержденоОткрытиеФормыРазбивкиСтроки(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОткрытьФормуРазбивкиСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтроки()
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	ПараметрыФормыРазбивки = ПолучитьПараметрыФормыРазбивкиСтроки(ТекДанные.ПолучитьИдентификатор());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИсходнаяСтрока", ПараметрыФормыРазбивки.ИсходнаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьКредитовИЗаймов.Форма.РазбивкаСтроки", ПараметрыФормыРазбивки,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьЗаполненныеСуммыБухУчета(СтрокаТаблицы)
	
	Возврат СтрокаТаблицы.СуммаОДВалютная <> 0
		Или СтрокаТаблицы.СуммаПроцентовВалютная <> 0
		Или СтрокаТаблицы.СуммаШтрафовВалютная <> 0
		Или СтрокаТаблицы.СуммаПенейВалютная <> 0
		Или СтрокаТаблицы.СуммаОД <> 0
		Или СтрокаТаблицы.СуммаПроцентов <> 0
		Или СтрокаТаблицы.СуммаШтрафов <> 0
		Или СтрокаТаблицы.СуммаПеней <> 0;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФормыРазбивкиСтроки(ИдСтроки)
	
	ТекДанные = Объект.Раздел2.НайтиПоИдентификатору(ИдСтроки);
	
	Возврат Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьПараметрыФормыРазбивкиСтроки(ЭтотОбъект, ТекДанные);
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтроки(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// НомераСтрокФрагментов упорядочены по возрастанию.
	НомераСтрокФрагментов	= РезультатВыбора.НомераСтрокФрагментов;
	ФрагментыСтроки			= РезультатВыбора.ФрагментыСтроки;
	
	КоличествоПрежнихФрагментов = НомераСтрокФрагментов.Количество();
	КоличествоНовыхФрагментов = ФрагментыСтроки.Количество();
	
	// Удаляем прежние фрагменты, начиная с последнего.
	Для Счетчик = 1 По КоличествоПрежнихФрагментов Цикл
		Индекс = КоличествоПрежнихФрагментов - Счетчик;
		
		Объект.Раздел2.Удалить(НомераСтрокФрагментов[Индекс] - 1);
	КонецЦикла;
	
	// Вставляем новые фрагменты на место первой строки прежних фрагментов, начиная с последнего.
	ИндексВставки = НомераСтрокФрагментов[0] - 1;
	
	ОбщиеПоля = "КодСтроки,Контрагент,ИдентификаторКонтрагента,Договор,ДатаИсполнения,КФО,Счет,КПС,Валюта,ИФО,Подразделение";
	
	// Реквизиты акта сверки и суммы подтвержденной и неподтвержденной задолженностей
	// указываются лишь в одной первой строке фрагментов.
	// В очередных строках фрагментов эти показатели должны быть пустыми.
	// Итоги здесь не указываются, т.к. не используются на форме разбивки строки.
	ИменаПолейУказываемыхВПервойСтрокеФрагментов = "ДатаАктаСверкиОД,
		|ДатаАктаСверкиПроцентов,
		|ДатаАктаСверкиШтрафов,
		|ДатаАктаСверкиПеней,
		|НомерАктаСверкиОД,
		|НомерАктаСверкиПроцентов,
		|НомерАктаСверкиШтрафов,
		|НомерАктаСверкиПеней,
		|СуммаОДПодтвержденнаяВалютная,
		|СуммаОДПодтвержденная,
		|СуммаПроцентовПодтвержденнаяВалютная,
		|СуммаПроцентовПодтвержденная,
		|СуммаШтрафовПодтвержденнаяВалютная,
		|СуммаШтрафовПодтвержденная,
		|СуммаПенейПодтвержденнаяВалютная,
		|СуммаПенейПодтвержденная,
		|СуммаОДНеподтвержденнаяВалютная,
		|СуммаОДНеподтвержденная,
		|СуммаПроцентовНеподтвержденнаяВалютная,
		|СуммаПроцентовНеподтвержденная,
		|СуммаШтрафовНеподтвержденнаяВалютная,
		|СуммаШтрафовНеподтвержденная,
		|СуммаПенейНеподтвержденнаяВалютная,
		|СуммаПенейНеподтвержденная";
	
	ОчищающаяСтруктураОчередныхФрагментовСтроки = Новый Структура(ИменаПолейУказываемыхВПервойСтрокеФрагментов);
	
	ПостфиксыВидовРасчета = ПолучитьПостфиксыВидовРасчета();
	
	СписокСтатусов = ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности();
	
	// Применяем обратный порядок обхода фрагментов.
	Для Счетчик = 1 По КоличествоНовыхФрагментов Цикл
		Индекс = КоличествоНовыхФрагментов - Счетчик;
		
		СтруктураСтроки = ФрагментыСтроки[Индекс];
		
		НоваяСтрока = Объект.Раздел2.Вставить(ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры.ИсходнаяСтрока, ОбщиеПоля);
		
		Если СтруктураСтроки.ПризнакПервогоФрагментаСтроки Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатВыбора.ИсходнаяСтрока, ИменаПолейУказываемыхВПервойСтрокеФрагментов);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктураОчередныхФрагментовСтроки);
		КонецЕсли;
		
		ЗаполнитьВсеИтоги(НоваяСтрока);
	КонецЦикла;
	
	Если КоличествоНовыхФрагментов = 1 Тогда
		НоваяСтрока.ИдентификаторСтроки = Неопределено;
		НоваяСтрока.ПризнакФрагментаСтроки = Ложь;
		НоваяСтрока.ПризнакПервогоФрагментаСтроки = Ложь;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Элементы.Раздел2.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимоОткрытьФормуРазбивкиСтроки(Поле)
	
	ТекДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "Раздел2", "");
	
	Если ТекДанные.ПризнакФрагментаСтроки
		И ИменаПолейБезОткрытияФормыРазбивкиСтроки.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

