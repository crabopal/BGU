&НаКлиенте
Процедура ЗаполнитьИтогоПоВидуСуммы(ТекДанные, Знач ПостфиксВидаСуммы, Знач ПостфиксВалютная)
	
	Если ПостфиксВидаСуммы = "Просроченная" И ПостфиксВалютная = "Валютная" Тогда
		ТекДанные.СуммаИтогоПросроченнаяВалютная = ТекДанные.СуммаОДПросроченнаяВалютная 
			+ ТекДанные.СуммаПроцентовПросроченнаяВалютная
			+ ТекДанные.СуммаШтрафовПросроченнаяВалютная
			+ ТекДанные.СуммаПенейПросроченнаяВалютная;
	
	ИначеЕсли ПостфиксВидаСуммы = "Просроченная" И ПостфиксВалютная = "" Тогда
		ТекДанные.СуммаИтогоПросроченная = ТекДанные.СуммаОДПросроченная 
			+ ТекДанные.СуммаПроцентовПросроченная
			+ ТекДанные.СуммаШтрафовПросроченная
			+ ТекДанные.СуммаПенейПросроченная;
			
	ИначеЕсли ПостфиксВидаСуммы = "Подтвержденная" И ПостфиксВалютная = "Валютная" Тогда
		ТекДанные.СуммаИтогоПодтвержденнаяВалютная = ТекДанные.СуммаОДПодтвержденнаяВалютная 
			+ ТекДанные.СуммаПроцентовПодтвержденнаяВалютная
			+ ТекДанные.СуммаШтрафовПодтвержденнаяВалютная
			+ ТекДанные.СуммаПенейПодтвержденнаяВалютная;
	
	ИначеЕсли ПостфиксВидаСуммы = "Подтвержденная" И ПостфиксВалютная = "" Тогда
		ТекДанные.СуммаИтогоПодтвержденная = ТекДанные.СуммаОДПодтвержденная 
			+ ТекДанные.СуммаПроцентовПодтвержденная
			+ ТекДанные.СуммаШтрафовПодтвержденная
			+ ТекДанные.СуммаПенейПодтвержденная;
			
	ИначеЕсли ПостфиксВидаСуммы = "Неподтвержденная" И ПостфиксВалютная = "Валютная" Тогда
		ТекДанные.СуммаИтогоНеподтвержденнаяВалютная = ТекДанные.СуммаОДНеподтвержденнаяВалютная 
			+ ТекДанные.СуммаПроцентовНеподтвержденнаяВалютная
			+ ТекДанные.СуммаШтрафовНеподтвержденнаяВалютная
			+ ТекДанные.СуммаПенейНеподтвержденнаяВалютная;
	
	ИначеЕсли ПостфиксВидаСуммы = "Неподтвержденная" И ПостфиксВалютная = "" Тогда
		ТекДанные.СуммаИтогоНеподтвержденная = ТекДанные.СуммаОДНеподтвержденная 
			+ ТекДанные.СуммаПроцентовНеподтвержденная
			+ ТекДанные.СуммаШтрафовНеподтвержденная
			+ ТекДанные.СуммаПенейНеподтвержденная;
		
	ИначеЕсли ПостфиксВидаСуммы = "" И ПостфиксВалютная = "Валютная" Тогда
		ТекДанные.СуммаИтогоВалютная = ТекДанные.СуммаОДВалютная 
			+ ТекДанные.СуммаПроцентовВалютная
			+ ТекДанные.СуммаШтрафовВалютная
			+ ТекДанные.СуммаПенейВалютная;
	
	ИначеЕсли ПостфиксВидаСуммы = "" И ПостфиксВалютная = "" Тогда
		ТекДанные.СуммаИтого = ТекДанные.СуммаОД 
			+ ТекДанные.СуммаПроцентов
			+ ТекДанные.СуммаШтрафов
			+ ТекДанные.СуммаПеней;
	КонецЕсли;
	
КонецПроцедуры

