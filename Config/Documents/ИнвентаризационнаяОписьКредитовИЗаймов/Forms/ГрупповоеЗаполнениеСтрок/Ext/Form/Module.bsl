//---
// Параметры формы
//---
//
//	<обязательные>
//		ДополнительныеПараметры	- Структура	- Набор значений, используемых произвольным образом;
//		ЗначенияЗаполнения		- Структура	- Набор значений, присваиваемых реквизитам этой формы;
//		КоличествоСтрок			- Число		- Число строк, выводимое для справки в шапке формы;
//
//	<опциональные>
//		НеиспользуемыеПоля			- Строка или массив	- Имена скрываемых реквизитов;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОпределитьИменаПолей();
	
	ЗагрузитьПереданныеЗначения();
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьДоступностьРеквизитовАктаСверки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗаключениеКомиссииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДокументОписи", Объект.Ссылка);
	
	Оповещение = Новый ОписаниеОповещения("ЗакрытаФормаВыбораЗаключенияКомиссии", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.ЗаключенияКомиссииПоИнвентаризационнымОписям.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаключениеКомиссииОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ЗакрытаФормаРедактированияТекстаЗаключенияКомиссии", ЭтотОбъект);
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, ЗаключениеКомиссии, НСтр("ru='Заключение комиссии по результатам инвентаризации'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокПодтверждениеАктомСверкиПриИзменении(Элемент)
	
	ОчиститьИныеНастройкиАктаСверки(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеАктомСверкиПриИзменении(Элемент)
	
	ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(Элемент.Имя);
	
	Если ЭтотОбъект["ПодтверждениеАктомСверки" + ПостфиксВидаРасчета] = 0 Тогда
		ЭтотОбъект["ДатаАктаСверки" + ПостфиксВидаРасчета] = Неопределено;
		ЭтотОбъект["НомерАктаСверки" + ПостфиксВидаРасчета] = Неопределено;
	КонецЕсли;
	
	НастроитьДоступностьРеквизитовАктаСверки(ПостфиксВидаРасчета);
	
	ПолеПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеСуммыПриОтсутствииАктаСверкиОДПриИзменении(Элемент)
	
	ОчиститьИныеНастройкиАктаСверки(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеСуммыПриОтсутствииАктаСверкиПроцентовПриИзменении(Элемент)
	
	ОчиститьИныеНастройкиАктаСверки(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеСуммыПриОтсутствииАктаСверкиШтрафовПриИзменении(Элемент)
	
	ОчиститьИныеНастройкиАктаСверки(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеСуммыПриОтсутствииАктаСверкиПенейПриИзменении(Элемент)
	
	ОчиститьИныеНастройкиАктаСверки(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	ПроверитьЗаполнениеИЗакрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьИменаВсехПолей()
	
	Возврат Новый Структура("
		|ЗаключениеКомиссии,
		|ПодтверждениеАктомСверкиОД,
		|ПодтверждениеАктомСверкиПроцентов,
		|ПодтверждениеАктомСверкиШтрафов,
		|ПодтверждениеАктомСверкиПеней,
		|СтатусЗадолженностиОД,
		|СтатусЗадолженностиПроцентов,
		|СтатусЗадолженностиШтрафов,
		|СтатусЗадолженностиПеней,
		|СуммаОДТребуетРеклассификации,
		|СуммаПроцентовТребуетРеклассификации,
		|СуммаШтрафовТребуетРеклассификации,
		|СуммаПенейТребуетРеклассификации");
	
КонецФункции

&НаСервере
Процедура ЗагрузитьПереданныеЗначения()
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ЗначенияЗаполнения);
	
	ВремОбъект = Новый Структура("Ссылка", Параметры.ОписьСсылка);
	
	Объект = Новый ФиксированнаяСтруктура(ВремОбъект);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// Скрываем неиспользуемые поля.
	ИменаПолей = Новый Массив();
	
	Для Каждого Элемент Из НеиспользуемыеПоля Цикл
		ИмяЭлементаФормы = Элемент.Ключ;
		
		ИменаПолей.Добавить(ИмяЭлементаФормы);
		ИменаПолей.Добавить("Флажок" + ИмяЭлементаФормы);
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаПолей, "Видимость", Ложь);
	
	НастроитьСпискиВыбораСтатусовЗадолженности();
	
	// Категории для русского языка:
	//	Ноль	(-);
	//	Один	(1 шт);
	//	Два		(-);
	//	Немного	(2 шт);
	//	Много	(5 шт);
	//	Другое	(-)
	НадписьКоличествоСтрок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 строку;;%1 строки;%1 строк;'"),
		Параметры.КоличествоСтрок);
	
	Элементы["ЗакрытьФорму"].Заголовок = СтрШаблон(
		НСтр("ru='Заполнить %1'"),
		НадписьКоличествоСтрок);
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСпискиВыбораСтатусовЗадолженности()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("СтатусЗадолженностиОД");
	ИменаЭлементов.Добавить("СтатусЗадолженностиПроцентов");
	ИменаЭлементов.Добавить("СтатусЗадолженностиШтрафов");
	ИменаЭлементов.Добавить("СтатусЗадолженностиПеней");
	
	Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].СписокВыбора.ЗагрузитьЗначения(Список);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяПоля = Элемент.Ключ;
		
		ИмяПоляФлажок = "Флажок" + ИмяПоля;
		
		//
		// N. Поле при сброшенном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " при сброшенном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.НедоступныеДанныеЦвет);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",				Новый Цвет(250, 250, 250));
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		
		// Оформляемые поля
		Если СтрНачинаетсяС(ИмяПоля, "ПодтверждениеАктомСверки") Тогда
			ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(ИмяПоля);
			
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПодтверждениеАктомСверки" + ПостфиксВидаРасчета);
			
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДатаАктаСверки" + ПостфиксВидаРасчета);
			
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("НомерАктаСверки" + ПостфиксВидаРасчета);
		Иначе
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЕсли;
		
		//
		// N+1. Поле пустое при установленном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " пустое при установленном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		// Оформляемые поля
		Если СтрНачинаетсяС(ИмяПоля, "ПодтверждениеАктомСверки") Тогда
			ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(ИмяПоля);
			
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДатаАктаСверки" + ПостфиксВидаРасчета);
			
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("НомерАктаСверки" + ПостфиксВидаРасчета);
		Иначе
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьИменаПолей()
	
	ИменаВсехПолей = ПолучитьИменаВсехПолей();
	
	ВремИспользуемыеПоля = ИменаВсехПолей;
	
	ВремНеиспользуемыеПоля = Новый Структура();
	
	МассивИмен = СтрРазделить(Параметры.НеиспользуемыеПоля, ", ", Ложь);
	
	Для Каждого ИмяПоля Из МассивИмен Цикл
		Если ИменаВсехПолей.Свойство(ИмяПоля) Тогда
			ВремНеиспользуемыеПоля.Вставить(ИмяПоля);
			ВремИспользуемыеПоля.Удалить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	ИспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремИспользуемыеПоля);
	
	НеиспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремНеиспользуемыеПоля);
	
КонецФункции

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	
	Перем ОчищенноеИмяЭлемента;
	
	ИмяЭлемента = Элемент.Имя;
	
	ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(ИмяЭлемента, ОчищенноеИмяЭлемента);
	
	Если СтрНачинаетсяС(ИмяЭлемента, "ДатаАктаСверки") Или СтрНачинаетсяС(ИмяЭлемента, "НомерАктаСверки") Тогда
		ОчищенноеИмяЭлемента = "ПодтверждениеАктомСверки";
		
		ИмяЭлемента = ОчищенноеИмяЭлемента + ПостфиксВидаРасчета;
	КонецЕсли;
	
	ИмяПоляФлажок = "Флажок" + ИмяЭлемента;
	
	ЭтаФорма[ИмяПоляФлажок] = Истина;
	
	Если ОчищенноеИмяЭлемента = "ПодтверждениеАктомСверки" Тогда
		ОчиститьИныеНастройкиАктаСверки(Элементы[ИмяЭлемента]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИныеНастройкиАктаСверки(ИзмененныйЭлемент)
	
	Перем ОчищенноеИмяЭлемента;
	
	ИмяИзмененногоЭлемента = ИзмененныйЭлемент.Имя;
	
	ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(ИмяИзмененногоЭлемента, ОчищенноеИмяЭлемента);
	
	Если ОчищенноеИмяЭлемента = "ОчиститьВсеСуммыПриОтсутствииАктаСверки" Тогда
		ОчиститьНастройкуПодтвержденияАктомСверкиЗадолженностиВПолнойСумме(ПостфиксВидаРасчета);
		
		НастроитьДоступностьРеквизитовАктаСверки(ПостфиксВидаРасчета);
		
	ИначеЕсли ОчищенноеИмяЭлемента = "ПодтверждениеАктомСверки"
		Или ОчищенноеИмяЭлемента = "ФлажокПодтверждениеАктомСверки" Тогда
		ОчиститьНастройкуПриОтсутствииАктаСверки(ПостфиксВидаРасчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройкуПодтвержденияАктомСверкиЗадолженностиВПолнойСумме(ПостфиксВидаРасчета)
	
	ЭтотОбъект[СтрШаблон("ФлажокПодтверждениеАктомСверки%1", ПостфиксВидаРасчета)] = Ложь;
	ЭтотОбъект[СтрШаблон("ПодтверждениеАктомСверки%1", ПостфиксВидаРасчета)] = 0;
	
	ЭтотОбъект[СтрШаблон("ДатаАктаСверки%1", ПостфиксВидаРасчета)] = Неопределено;
	ЭтотОбъект[СтрШаблон("НомерАктаСверки%1", ПостфиксВидаРасчета)] = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройкуПриОтсутствииАктаСверки(ПостфиксВидаРасчета)
	
	ЭтотОбъект[СтрШаблон("ОчиститьВсеСуммыПриОтсутствииАктаСверки%1", ПостфиксВидаРасчета)] = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеИЗакрыть()
	
	ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
	
	Этаформа.Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	// Возвращаем лишь значения, которые отмечены флажком
	
	ВозвращаемоеЗначение = Новый Структура();
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяРеквизита = Элемент.Ключ;
		
		Если ЭтаФорма["Флажок" + ИмяРеквизита] Тогда
			Если СтрНачинаетсяС(ИмяРеквизита, "ПодтверждениеАктомСверки") Тогда
				ПостфиксВидаРасчета = ВыделитьПостфиксВидаРасчета(ИмяРеквизита);

				ВозвращаемоеЗначение.Вставить("ПодтверждениеАктомСверки" + ПостфиксВидаРасчета,	ЭтотОбъект["ПодтверждениеАктомСверки" + ПостфиксВидаРасчета]);
				ВозвращаемоеЗначение.Вставить("ДатаАктаСверки" + ПостфиксВидаРасчета,			ЭтотОбъект["ДатаАктаСверки" + ПостфиксВидаРасчета]);
				ВозвращаемоеЗначение.Вставить("НомерАктаСверки" + ПостфиксВидаРасчета,			ЭтотОбъект["НомерАктаСверки" + ПостфиксВидаРасчета]);
				
				Продолжить;
			КонецЕсли;
			
			ЗначениеРеквизита = ЭтаФорма[ИмяРеквизита];
			
			ВозвращаемоеЗначение.Вставить(ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Если ОчиститьВсеСуммыПриОтсутствииАктаСверкиОД Тогда
		ВозвращаемоеЗначение.Вставить("ОчиститьВсеСуммыПриОтсутствииАктаСверкиОД", Истина);
	КонецЕсли;
	
	Если ОчиститьВсеСуммыПриОтсутствииАктаСверкиПроцентов Тогда
		ВозвращаемоеЗначение.Вставить("ОчиститьВсеСуммыПриОтсутствииАктаСверкиПроцентов", Истина);
	КонецЕсли;
	
	Если ОчиститьВсеСуммыПриОтсутствииАктаСверкиШтрафов Тогда
		ВозвращаемоеЗначение.Вставить("ОчиститьВсеСуммыПриОтсутствииАктаСверкиШтрафов", Истина);
	КонецЕсли;
	
	Если ОчиститьВсеСуммыПриОтсутствииАктаСверкиПеней Тогда
		ВозвращаемоеЗначение.Вставить("ОчиститьВсеСуммыПриОтсутствииАктаСверкиПеней", Истина);
	КонецЕсли;
	
	Если ВозвращаемоеЗначение.Количество() = 0 Тогда
		ВозвращаемоеЗначение = Неопределено;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРедактированияТекстаЗаключенияКомиссии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаключениеКомиссии = ВыбранноеЗначение;
	
	ПолеПриИзменении(Элементы.ЗаключениеКомиссии);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаВыбораЗаключенияКомиссии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗаключения = ИнвентаризацияВызовСервера.ПолучитьТекстЗаключенияКомиссииПоОписи(ВыбранноеЗначение);
	
	ЗаключениеКомиссии = ТекстЗаключения;
	
	ПолеПриИзменении(Элементы.ЗаключениеКомиссии);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьРеквизитовАктаСверки(ПостфиксВидаРасчета = Неопределено)
	
	Если ПостфиксВидаРасчета <> Неопределено Тогда
		ПостфиксыВидаРасчета = Новый Массив();
		ПостфиксыВидаРасчета.Добавить(ПостфиксВидаРасчета);
	Иначе
		ПостфиксыВидаРасчета = ПолучитьПостфиксыВидаРасчета();
	КонецЕсли;
	
	Для Каждого Постфикс Из ПостфиксыВидаРасчета Цикл
		НовДоступность = (ЭтотОбъект["ПодтверждениеАктомСверки" + Постфикс] = 1);
		
		Элементы["ДатаАктаСверки" + Постфикс].Доступность = НовДоступность;
		Элементы["НомерАктаСверки" + Постфикс].Доступность = НовДоступность;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПостфиксыВидаРасчета()
	
	ПостфиксыВидаРасчета = Новый Массив();
	
	ПостфиксыВидаРасчета.Добавить("ОД");
	ПостфиксыВидаРасчета.Добавить("Процентов");
	ПостфиксыВидаРасчета.Добавить("Штрафов");
	ПостфиксыВидаРасчета.Добавить("Пеней");
	
	Возврат ПостфиксыВидаРасчета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыделитьПостфиксВидаРасчета(Знач ИмяЭлемента, ОчищенноеИмяЭлемента = Неопределено)
	
	ПостфиксыВидаРасчета = ПолучитьПостфиксыВидаРасчета();
	
	Для Каждого ВидРасчетов Из ПостфиксыВидаРасчета Цикл
		Если СтрНайти(ИмяЭлемента, ВидРасчетов) > 0 Тогда
			ОчищенноеИмяЭлемента = СтрЗаменить(ИмяЭлемента, ВидРасчетов, "");
			
			Возврат ВидРасчетов;
		КонецЕсли;
	КонецЦикла;
	
	ОчищенноеИмяЭлемента = ИмяЭлемента;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
