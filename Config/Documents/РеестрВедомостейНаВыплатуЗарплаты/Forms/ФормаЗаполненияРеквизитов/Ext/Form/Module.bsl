
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем СписокРеквизитов;
	
	Параметры.Свойство("СписокРеквизитов", СписокРеквизитов);
	Параметры.Свойство("Организация", ОтборОрганизация);
	Параметры.Свойство("Дата", ОтборДата);
	
	Если ЗначениеЗаполнено(СписокРеквизитов) Тогда
		ТаблицаРеквизитов = ПолучитьИзВременногоХранилища(СписокРеквизитов);
		
		Если ТипЗнч(ТаблицаРеквизитов) = Тип("ТаблицаЗначений") Тогда
			ЗначениеВРеквизитФормы(ТаблицаРеквизитов, "ТаблицаРеквизитовИЗначений");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыТаблицаРеквизитовИЗначений

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПриАктивизацииЯчейки(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаРеквизитовИЗначенийЗначениеРеквизита" Тогда
		ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Элемент.ТекущийЭлемент.ОграничениеТипа = ТекущиеДанные.ТипЗначенияРеквизита;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр) 
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередНачаломИзменения(Элемент, Отказ)
	
	Если Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
	
	ТипРеквизита = ТекущиеДанные.ТипЗначенияРеквизита;
	ИмяРеквизита = ТекущиеДанные.НаименованиеРеквизита;
	ТекущееЗначениеРеквизита = ТекущиеДанные.ЗначениеРеквизита;
	
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.ОграничениеТипа = ТипРеквизита;
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.СписокВыбора.Очистить();
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.РежимВыбораИзСписка = Ложь;

	Если Найти(ИмяРеквизита, "КПС") > 0 Тогда
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент, 
														Ложь, 
														ТекущееЗначениеРеквизита, 
														ОтборОрганизация,
														ОтборИФО,
														ОтборКФО,
														Неопределено,
														ОтборДата);
		
	ИначеЕсли Найти(ИмяРеквизита, "КФО") > 0 Тогда
		
		СписокЗначенийКФО = ЗаполнитьСписокВыбораКФОСервер(ТекущееЗначениеРеквизита);
		
		Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(СписокЗначенийКФО.ВыгрузитьЗначения());
		Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.РежимВыбораИзСписка = Истина;
		
	ИначеЕсли Найти(ИмяРеквизита, "Договор") > 0 Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", ОтборОрганизация);
		Отбор.Вставить("Контрагент", ОтборКонтрагент);
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("Отбор", Отбор);
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		
		ОткрытьФорму("Справочник.Договоры.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	ИначеЕсли Найти(ИмяРеквизита, "Подразделение") > 0 Тогда
		
		Отбор = Новый Структура("Владелец", ОтборОрганизация);
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("Отбор", Отбор);
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		
		ОткрытьФорму("Справочник.Подразделения.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	ИначеЕсли Найти(ИмяРеквизита, "ДопКлассификация") > 0 Тогда
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
		
		ОткрытьФорму("Справочник.ДополнительнаяБюджетнаяКлассификация.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	ИначеЕсли Найти(ИмяРеквизита, "КодМероприятия") > 0 Тогда
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		
		ОткрытьФорму("Справочник.Мероприятия.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	ИначеЕсли Найти(ИмяРеквизита, "КодЦели") > 0 Тогда
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		
		ОткрытьФорму("Справочник.ВидыЦелевыхСредств.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Заполнять = ЗначениеЗаполнено(ТекущиеДанные.ЗначениеРеквизита);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьРеквизиты(Команда)
	Закрыть(РезультатЗаполнения());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РезультатЗаполнения()
	РезультатЗаполнения = Новый Структура;
	
	Для Каждого Стр Из ТаблицаРеквизитовИЗначений Цикл
		Если Стр.Заполнять Тогда
			РезультатЗаполнения.Вставить(Стр.НаименованиеРеквизита, 
										?(ЗначениеЗаполнено(Стр.ЗначениеРеквизита),
											Стр.ЗначениеРеквизита,
											Стр.ТипЗначенияРеквизита.ПривестиЗначение()));
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатЗаполнения;
КонецФункции

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийЗначениеРеквизитаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)

	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Контрагенты") Тогда
		ОтборКонтрагент = ВыбранноеЗначение;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
		ОтборИФО = ВыбранноеЗначение;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ПеречислениеСсылка.КВД") Тогда
		ОтборКФО = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораКФОСервер(ТекущееЗначениеКФО)
	
	СписокЗначенийКФО = Новый СписокЗначений;
	
	БухгалтерскийУчет.ЗаполнитьСписокКФО(
			СписокЗначенийКФО,
			ТекущееЗначениеКФО,
			ПолучитьМассивКФО(),
			"КФО",
			"",
			Новый Структура("Организация, ИФО, Дата, НаНачалоСледующегоГода", ОтборОрганизация, ОтборИФО, ОтборДата, Истина));
	
	Возврат СписокЗначенийКФО;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивКФО()
	
	Результат = Новый Массив;
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение"));
	Возврат Результат;
	
КонецФункции

#КонецОбласти