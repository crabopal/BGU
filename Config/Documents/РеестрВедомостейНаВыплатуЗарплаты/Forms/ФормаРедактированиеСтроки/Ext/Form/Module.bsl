#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолучитьПараметры();
	
	ПолучитьРасшифровкаПлатежа();
	
	ЗаполнитьПараметрыВыбора();
	
	ПлатежноРасчетныеДокументы.ЗаполнитьСписокВыбораКодовДохода(Элементы.РасшифровкаПлатежаКодВидаДохода);
	
	ЗаполнитьПараметрыСвязи();
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьИЗакрыть", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для ИндексСтроки = 0 По РасшифровкаПлатежа.Количество() - 1 Цикл
		
		Если НЕ ЗначениеЗаполнено(РасшифровкаПлатежа[ИндексСтроки].Сотрудник) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Не указан сотрудник'"),, 
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("РасшифровкаПлатежа", ИндексСтроки + 1, "Сотрудник"),,
				Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(РасшифровкаПлатежа[ИндексСтроки].Сумма) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Не заполнена сумма'"),, 
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("РасшифровкаПлатежа", ИндексСтроки + 1, "Сумма"),,
				Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	СохранитьИЗакрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Модифицированность = Ложь;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСостав

&НаКлиенте
Процедура ЗаполнитьРеквизитыВоВсехСтроках(Команда)
	ОткрытьФормуЗаполненияРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыВВыбранныхСтроках(Команда)
	ОткрытьФормуЗаполненияРеквизитов(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьПараметры()
	
	Параметры.Свойство("ИдентификаторСтроки",	ИдентификаторСтроки);
	Параметры.Свойство("ИдентификаторФормы",	ИдентификаторФормы);
	Параметры.Свойство("Дата",					Дата);
	Параметры.Свойство("Организация",			Организация);
	Параметры.Свойство("Контрагент",			Контрагент);
	Параметры.Свойство("КэшПараметров",			КэшПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРасшифровкаПлатежа()
	
	РасшифровкаПлатежа.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресВХранилищеРасшифровкаПлатежаПоСтроке));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыВыбора()
	
	// КПС
	МассивВидовПоказателей = Новый Массив;
	МассивВидовПоказателей.Добавить(Перечисления.ВидыКБК.Произвольный);
	МассивВидовПоказателей.Добавить(Перечисления.ВидыКБК.КРБ);
	МассивВидовПоказателей.Добавить(Перечисления.ВидыКБК.АУИБУ);
	
	МассивУточненияПоказателей = Новый Массив;
	МассивУточненияПоказателей.Добавить(Перечисления.ВидыКБК.ПустаяСсылка());
	МассивУточненияПоказателей.Добавить(Перечисления.ВидыКБК.КРБ);
	
	МассивОтборовКПС = Новый Массив;
	МассивОтборовКПС.Добавить(Новый ПараметрВыбора("Отбор.ВидПоказателя", Новый ФиксированныйМассив(МассивВидовПоказателей)));
	МассивОтборовКПС.Добавить(Новый ПараметрВыбора("Отбор.УточнениеПоказателя", Новый ФиксированныйМассив(МассивУточненияПоказателей)));
	ПараметрВыбораКПС = Новый ФиксированныйМассив(МассивОтборовКПС);
	Элементы.РасшифровкаПлатежаКПС.ПараметрыВыбора = ПараметрВыбораКПС;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыСвязи()
	
	// Подразделение
	МассивОтборовПодразделение = Новый Массив;
	МассивОтборовПодразделение.Добавить(Новый СвязьПараметраВыбора("Отбор.Организация", "Организация"));
	СвязиПараметровВыбораПодразделение = Новый ФиксированныйМассив(МассивОтборовПодразделение);
	Элементы.РасшифровкаПлатежаПодразделение.СвязиПараметровВыбора = СвязиПараметровВыбораПодразделение;
	
	// Сотрудник
	МассивОтборовСотрудник = Новый Массив;
	МассивОтборовСотрудник.Добавить(Новый СвязьПараметраВыбора("Отбор.Организация", "Организация"));
	МассивОтборовСотрудник.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Контрагент"));
	СвязиПараметровВыбораСотрудник = Новый ФиксированныйМассив(МассивОтборовСотрудник);
	Элементы.РасшифровкаПлатежаСотрудник.СвязиПараметровВыбора = СвязиПараметровВыбораСотрудник;
	
	// КФО
	МассивОтборовКФО = Новый Массив;
	МассивОтборовКФО.Добавить(Новый СвязьПараметраВыбора("НаДату", "Дата"));
	МассивОтборовКФО.Добавить(Новый СвязьПараметраВыбора("Организация", "Организация"));
	МассивОтборовКФО.Добавить(Новый СвязьПараметраВыбора("ИФО", "РасшифровкаПлатежа.ИФО"));
	СвязиПараметровВыбораКФО = Новый ФиксированныйМассив(МассивОтборовКФО);
	Элементы.РасшифровкаПлатежаКФО.СвязиПараметровВыбора = СвязиПараметровВыбораКФО;
	
	// КПС
	МассивОтборовКПС = Новый Массив;
	МассивОтборовКПС.Добавить(Новый СвязьПараметраВыбора("Отбор.НаДату", "Дата"));
	МассивОтборовКПС.Добавить(Новый СвязьПараметраВыбора("Отбор.Организация", "Организация"));
	МассивОтборовКПС.Добавить(Новый СвязьПараметраВыбора("Отбор.ИФО", "РасшифровкаПлатежа.ИФО"));
	СвязиПараметровВыбораКПС = Новый ФиксированныйМассив(МассивОтборовКПС);
	Элементы.РасшифровкаПлатежаКПС.СвязиПараметровВыбора = СвязиПараметровВыбораКПС;
	
	// КЭК
	МассивОтборовКЭК = Новый Массив;
	МассивОтборовКЭК.Добавить(Новый СвязьПараметраВыбора("Отбор.КПС", "РасшифровкаПлатежа.КПС"));
	СвязиПараметровВыбораКЭК = Новый ФиксированныйМассив(МассивОтборовКЭК);
	Элементы.РасшифровкаПлатежаКЭК.СвязиПараметровВыбора = СвязиПараметровВыбораКЭК;
	
	// ДопКлассификация
	МассивОтборовДопКлассификация = Новый Массив;
	МассивОтборовДопКлассификация.Добавить(Новый СвязьПараметраВыбора("Отбор.КПС", "РасшифровкаПлатежа.КПС"));
	МассивОтборовДопКлассификация.Добавить(Новый СвязьПараметраВыбора("Отбор.КЭК", "РасшифровкаПлатежа.КЭК"));
	СвязиПараметровВыбораДопКлассификация = Новый ФиксированныйМассив(МассивОтборовДопКлассификация);
	Элементы.РасшифровкаПлатежаДопКлассификация.СвязиПараметровВыбора = СвязиПараметровВыбораДопКлассификация;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	Элементы.РасшифровкаПлатежаИФО.Видимость = КэшПараметров.ИспользоватьУчетПоИФО;
	Элементы.РасшифровкаПлатежаПодразделение.Видимость = КэшПараметров.ИспользоватьУчетПоПодразделениям;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ПроверитьЗаполнение() Тогда
		
		РезультатыРедактирования = Новый Структура;
		РезультатыРедактирования.Вставить("Модифицированность", Модифицированность);
		РезультатыРедактирования.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		РезультатыРедактирования.Вставить("АдресВХранилищеРасшифровкаПлатежаПоСтроке", АдресВХранилищеРасшифровкаПлатежаПоСтроке());
		
		Модифицированность = Ложь;
		Закрыть(РезультатыРедактирования)
		
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция АдресВХранилищеРасшифровкаПлатежаПоСтроке()
	
	ТЗРасшифровкаПлатежа = РасшифровкаПлатежа.Выгрузить();
	ТЗРасшифровкаПлатежа.ЗаполнитьЗначения(ИдентификаторСтроки, "ИдентификаторСтроки");
	ТЗРасшифровкаПлатежа.ЗаполнитьЗначения(Контрагент, "Контрагент");
	
	Возврат ПоместитьВоВременноеХранилище(ТЗРасшифровкаПлатежа, УникальныйИдентификатор);
	
КонецФункции	

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитов(ВоВсехСтроках = Истина)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ВоВсехСтроках", ВоВсехСтроках);	
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуЗаполненияРеквизитовОповещение", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРеквизитов", СписокРеквизитов());
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Дата", Дата);
	
	ОткрытьФорму("Документ.РеестрВедомостейНаВыплатуЗарплаты.Форма.ФормаЗаполненияРеквизитов", 
				ПараметрыФормы, 
				ЭтаФорма, 
				, , , 
				Оповещение, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитовОповещение(Результат, ДопПараметры) Экспорт
	
	Перем ВоВсехСтроках;
	
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ВоВсехСтроках", ВоВсехСтроках);
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаРасшифровка Из РасшифровкаПлатежа Цикл
			Для Каждого КлючИЗначение Из Результат Цикл
				СтрокаРасшифровка[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	Иначе
		ВыделенныеСтроки = Элементы.РасшифровкаПлатежа.ВыделенныеСтроки;
		
		Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
			СтрокаРасшифровка = РасшифровкаПлатежа[НомерСтроки];
			Для Каждого КлючИЗначение Из Результат Цикл
				СтрокаРасшифровка[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция СписокРеквизитов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НаименованиеРеквизита");
	Результат.Колонки.Добавить("СинонимРеквизита");
	Результат.Колонки.Добавить("Заполнять");
	Результат.Колонки.Добавить("ЗначениеРеквизита");
	Результат.Колонки.Добавить("ТипЗначенияРеквизита");
	
	Если КэшПараметров.ИспользоватьУчетПоИФО Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "ИФО";
		Стр.СинонимРеквизита = НСтр("ru = 'ИФО'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КФО";
	Стр.СинонимРеквизита = НСтр("ru = 'КФО'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КПС";
	Стр.СинонимРеквизита = НСтр("ru = 'КПС'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	
	Если КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "Подразделение";
		Стр.СинонимРеквизита = НСтр("ru = 'Подразделение'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "ДопКлассификация";
	Стр.СинонимРеквизита = НСтр("ru = 'Доп. классификация'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация");

	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КодМероприятия";
	Стр.СинонимРеквизита = НСтр("ru = 'Код мероприятия'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.Мероприятия");

	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КодЦели";
	Стр.СинонимРеквизита = НСтр("ru = 'Код цели'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств");
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти
