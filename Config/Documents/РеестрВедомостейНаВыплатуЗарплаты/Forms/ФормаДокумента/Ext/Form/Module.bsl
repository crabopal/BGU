&НаКлиенте
Процедура РедактироватьРасшифровкаПлатежаСтроки(ДанныеСтроки) Экспорт
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Дата", Объект.Дата);
	ПараметрыОткрытия.Вставить("Организация", Объект.Организация);
	ПараметрыОткрытия.Вставить("Контрагент", ДанныеСтроки.Контрагент);
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ИдентификаторФормы", ЭтаФорма.УникальныйИдентификатор);
	ПараметрыОткрытия.Вставить("КэшПараметров", ЭтотОбъект.КэшПараметров);
	ПараметрыОткрытия.Вставить("АдресВХранилищеРасшифровкаПлатежаПоСтроке", 
	                           АдресВХранилищеРасшифровкаПлатежаПоСтроке(ДанныеСтроки.ИдентификаторСтроки));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	Оповещение = Новый ОписаниеОповещения("РедактироватьРасшифровкаПлатежаСтрокиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму(
		"Документ.РеестрВедомостейНаВыплатуЗарплаты.Форма.ФормаРедактированиеСтроки", 
		ПараметрыОткрытия, ЭтаФорма, , , , 
		Оповещение, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьРасшифровкаПлатежаСтрокиЗавершение(РезультатыРедактирования, ДополнительныеПараметры) Экспорт
	
	Если РезультатыРедактирования <> Неопределено И РезультатыРедактирования.Модифицированность Тогда
		
		РедактироватьРасшифровкаПлатежаСтрокиНаСервере(РезультатыРедактирования);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура  РедактироватьРасшифровкаПлатежаСтрокиНаСервере(РезультатыРедактирования)
	
	ИдентификаторСтроки = РезультатыРедактирования.ИдентификаторСтроки;
	
	СтрокиСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если СтрокиСостава.Количество() <> 0 Тогда
		СтрокаСостава  = СтрокиСостава[0]
	Иначе
		Возврат
	КонецЕсли;
	
	РасшифровкаПлатежаСтроки = ПолучитьИзВременногоХранилища(РезультатыРедактирования.АдресВХранилищеРасшифровкаПлатежаПоСтроке);
	
	УдаляемыеСтроки = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Объект.РасшифровкаПлатежа.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РасшифровкаПлатежаСтроки, Объект.РасшифровкаПлатежа);
	
	СтрокаСостава.Сумма = РасшифровкаПлатежаСтроки.Итог("Сумма");
	
	ПриПолученииДанныхСтрокСоставаФинансирование();
	
КонецПроцедуры

&НаСервере
Функция АдресВХранилищеРасшифровкаПлатежаПоСтроке(ИдентификаторСтроки)
	Возврат ПоместитьВоВременноеХранилище(Объект.РасшифровкаПлатежа.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)), ЭтаФорма.УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитов(ВоВсехСтроках = Истина)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ВоВсехСтроках", ВоВсехСтроках);	
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуЗаполненияРеквизитовОповещение", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРеквизитов", СписокРеквизитов());
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	
	ОткрытьФорму("Документ.РеестрВедомостейНаВыплатуЗарплаты.Форма.ФормаЗаполненияРеквизитов", 
				ПараметрыФормы, 
				ЭтаФорма, 
				, , , 
				Оповещение, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитовОповещение(Результат, ДопПараметры) Экспорт
	
	Перем ВоВсехСтроках;
	
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ВоВсехСтроках", ВоВсехСтроках);
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаРасшифровка Из Объект.РасшифровкаПлатежа Цикл
			Для Каждого КлючИЗначение Из Результат Цикл
				СтрокаРасшифровка[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	Иначе
		ВыделенныеСтроки = Элементы.Состав.ВыделенныеСтроки;
		
		Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
			ТекСтрока = Объект.Состав[НомерСтроки];
			СтрокиРасшифровка = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекСтрока.ИдентификаторСтроки));
			Для Каждого СтрокаРасшифровка Из СтрокиРасшифровка Цикл
				Для Каждого КлючИЗначение Из Результат Цикл
					СтрокаРасшифровка[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокРеквизитов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НаименованиеРеквизита");
	Результат.Колонки.Добавить("СинонимРеквизита");
	Результат.Колонки.Добавить("Заполнять");
	Результат.Колонки.Добавить("ЗначениеРеквизита");
	Результат.Колонки.Добавить("ТипЗначенияРеквизита");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "ИФО";
		Стр.СинонимРеквизита = НСтр("ru = 'ИФО'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КФО";
	Стр.СинонимРеквизита = НСтр("ru = 'КФО'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КПС";
	Стр.СинонимРеквизита = НСтр("ru = 'КПС'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Стр = Результат.Добавить();
		Стр.НаименованиеРеквизита = "Подразделение";
		Стр.СинонимРеквизита = НСтр("ru = 'Подразделение'");
		Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "ДопКлассификация";
	Стр.СинонимРеквизита = НСтр("ru = 'Доп. классификация'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация");

	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КодМероприятия";
	Стр.СинонимРеквизита = НСтр("ru = 'Код мероприятия'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.Мероприятия");

	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КодЦели";
	Стр.СинонимРеквизита = НСтр("ru = 'Код цели'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств");
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ДействияПриИзмененииКонтрагента(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ИдентификаторСтроки", ДополнительныеПараметры.ИдентификаторСтроки);
	
	СтрокиРасшифровка = Объект.РасшифровкаПлатежа.НайтиСтроки(ОтборСтрок);
	Для Каждого СтрокаРасшифровка Из СтрокиРасшифровка Цикл
		СтрокаРасшифровка.Контрагент = ДополнительныеПараметры.Контрагент;
		СтрокаРасшифровка.Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриПолученииДанныхСтрокСоставаФинансирование()
	
	СтрокиСостава = Объект.Состав;
	
	ПоляСтатей = Новый Массив;
	ПоляСтатей.Добавить("СтатьяФинансированияЗарплата");
	ПоляСтатей.Добавить("КЭК");
	СтрокаПоляСтатей = СтрСоединить(ПоляСтатей, ", ");
	Если ПоляСтатей.Количество() = 0 Тогда
		ПоляОтбора = "ИдентификаторСтроки";
	Иначе
		ПоляОтбора = "ИдентификаторСтроки,"+СтрокаПоляСтатей;
	КонецЕсли;
	Расшифровка = Объект.РасшифровкаПлатежа.Выгрузить(,ПоляОтбора);
	Расшифровка.Свернуть(ПоляОтбора);
	Расшифровка.Индексы.Добавить("ИдентификаторСтроки");
	
	ПредставленияСтатейФинансирования = ПредставленияСтатейФинансирования();
	
	СтруктураОтбора = Новый Структура("ИдентификаторСтроки");
	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		
		СтруктураОтбора.ИдентификаторСтроки = СтрокаСостава.ИдентификаторСтроки;
		СочетанияСтатей = Расшифровка.НайтиСтроки(СтруктураОтбора);
		
		РасшифровкаФинансирования = "";
		Для Индекс = 0 По СочетанияСтатей.Количество()-1 Цикл
			
			Если Индекс = 3 Тогда
				РасшифровкаФинансирования = РасшифровкаФинансирования + "...";
				Прервать
			ИначеЕсли Индекс > 0 Тогда
				РасшифровкаФинансирования = РасшифровкаФинансирования + Символы.ПС;
			КонецЕсли;
			
			РасшифровкаФинансирования = РасшифровкаФинансирования 
			+ СтрШаблон(
			"%1(%2)",
			ПредставленияСтатейФинансирования[СочетанияСтатей[Индекс].СтатьяФинансированияЗарплата],
			СочетанияСтатей[Индекс].КЭК.Код);
			
		КонецЦикла;
		
		СтрокаСостава.РасшифровкаСтроки = РасшифровкаФинансирования;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПредставленияСтатейФинансирования() Экспорт
	
	Представления = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиФинансированияЗарплата.Ссылка,
	|	СтатьиФинансированияЗарплата.Код
	|ИЗ
	|	Справочник.СтатьиФинансированияЗарплата КАК СтатьиФинансированияЗарплата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представления.Вставить(Выборка.Ссылка, СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Выборка.Код, 3, " ", "Справа"));
	КонецЦикла;
	
	Возврат Представления
	
КонецФункции

