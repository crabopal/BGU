#Область ОбработчикиСобытийЭлементовТаблицыФормыСостав

&НаКлиенте
Процедура СоставПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
		Если Поле.Вид = ВидПоляФормы.ПолеНадписи Тогда
			РедактироватьРасшифровкаПлатежаСтроки(ТекущиеДанные);
			СтандартнаяОбработка = Ложь;
		КонецЕсли	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПередУдалением(Элемент, Отказ)
	
	ТекИдентификаторыСтрок = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элемент.ВыделенныеСтроки Цикл
		
		Строка = Объект.Состав.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка <> Неопределено Тогда
			ТекИдентификаторыСтрок.Добавить(Строка.ИдентификаторСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ИдентификаторыСтрок = Новый ФиксированныйМассив(ТекИдентификаторыСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПослеУдаления(Элемент)
	
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
		
		УдаляемыеСтроки = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
		Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
			Объект.РасшифровкаПлатежа.Удалить(УдаляемаяСтрока);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыВоВсехСтроках(Команда)
	ОткрытьФормуЗаполненияРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыВВыбранныхСтроках(Команда)
	ОткрытьФормуЗаполненияРеквизитов(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СоставКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	
	ТекКонтрагент = ТекущиеДанные.Контрагент;
	ТекИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ИдентификаторСтроки", ТекИдентификаторСтроки);
	
	СтрокиРасшифровка = Объект.РасшифровкаПлатежа.НайтиСтроки(ОтборСтрок);
	Если СтрокиРасшифровка.Количество() > 0 Тогда
		
		ДопПараметр = Новый Структура;
		ДопПараметр.Вставить("Контрагент", ТекКонтрагент);
		ДопПараметр.Вставить("ИдентификаторСтроки", ТекИдентификаторСтроки);
		
		ТекстВопроса = НСтр("ru = 'Сотрудник и Платежная карта будут очищены. Продолжить?'");
		ОписаниеОповещенияИзменение = Новый ОписаниеОповещения("ДействияПриИзмененииКонтрагента", ЭтотОбъект, ДопПараметр);
		ПоказатьВопрос(ОписаниеОповещенияИзменение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьНомераКарт(Команда)
	
	НовааяПометка = НЕ Элементы.СоставПоказатьНомераКарт.Пометка;
	
	Элементы.СоставМаскированныйНомерКарты.Видимость = НЕ НовааяПометка; 
	Элементы.СоставНомерПлатежнойКарты.Видимость = НовааяПометка;
	Элементы.СоставПоказатьНомераКарт.Пометка = НовааяПометка; 
	
КонецПроцедуры

