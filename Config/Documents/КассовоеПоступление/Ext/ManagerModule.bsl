#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьНаОснованииПлановыхПоступленийРодительскойПлаты(КассовоеПоступлениеОбъект, ОснованиеСсылка, СтандартнаяОбработка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Ссылка КАК ДокументОснование,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Организация,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Подразделение,
				   |	ПлановыеПоступленияОплатыРодительскаяПлата.ИФО,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.ДатаОплаты КАК Дата,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.НачалоПериода,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.КонецПериода,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.ГруппаДетскогоУчреждения.Представление КАК Группа,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.ПометкаУдаления,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Проведен,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Представление,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.КПС КАК КБКНазначениеПлатежа,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.КЭК КАК КОСГУНазначениеПлатежа,
	               |	ИСТИНА КАК РодительскаяПлата,
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Дети.(
	               |		Ребенок,
	               |		Контрагент,
	               |		ДоговорКонтрагента КАК Договор,
	               |		Сумма,
	               |		Сумма КАК СуммаВал,
	               |		Аннуляция
	               |	)
	               |ИЗ
	               |	Документ.ПлановыеПоступленияОплатыРодительскаяПлата КАК ПлановыеПоступленияОплатыРодительскаяПлата
	               |ГДЕ
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ОснованиеСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(КассовоеПоступлениеОбъект, Выборка);
		
		КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Очистить();
		
		КассовоеПоступлениеОбъект.КорСчет = БухгалтерскийУчет.СчетПоКоду("205.00", Выборка.Дата, Выборка.Организация);
		
		СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(Выборка.КОСГУНазначениеПлатежа, "205.00,209.00",, Выборка.Дата, Выборка.Организация, Выборка.ИФО);
		
		ВыборкаТЧ = Выборка.Дети.Выбрать();
		
		Пока ВыборкаТЧ.Следующий() Цикл
			
			Если ВыборкаТЧ.Аннуляция ИЛИ НЕ ВыборкаТЧ.Сумма > 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			НовСтр = КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Добавить();
			
			ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаТЧ);
			                     
			НовСтр.КБКНазначениеПлатежа = Выборка.КБКНазначениеПлатежа;
			НовСтр.КОСГУНазначениеПлатежа = Выборка.КОСГУНазначениеПлатежа;  
			НовСтр.СчетРасчетов = СчетРасчетов;
			
			КассовоеПоступлениеОбъект.СуммаДокумента = КассовоеПоступлениеОбъект.СуммаДокумента + НовСтр.Сумма;
			
			КассовоеПоступлениеОбъект.СуммаДокументаВВалюте =  КассовоеПоступлениеОбъект.СуммаДокумента;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьНаОснованииСчетаНаОплату(КассовоеПоступлениеОбъект, ОснованиеСсылка, СтандартнаяОбработка) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	СчетНаОплатуВозвратнаяТара.Сумма КАК Сумма,
	|	СчетНаОплатуВозвратнаяТара.Ссылка.КПС КАК КПС,
	|	СчетНаОплатуВозвратнаяТара.Ссылка.КОСГУ КАК КОСГУ,
	|	СчетНаОплатуВозвратнаяТара.Ссылка.КФО КАК КФО,
	|	СчетНаОплатуВозвратнаяТара.Ссылка.Договор КАК Договор
	|ПОМЕСТИТЬ СуммыПлатежа
	|ИЗ
	|	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
	|ГДЕ
	|	СчетНаОплатуВозвратнаяТара.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетНаОплатуМатериалы.Всего,
	|	СчетНаОплатуМатериалы.Ссылка.КПС,
	|	СчетНаОплатуМатериалы.Ссылка.КОСГУ,
	|	СчетНаОплатуМатериалы.Ссылка.КФО,
	|	СчетНаОплатуМатериалы.Ссылка.Договор
	|ИЗ
	|	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	|ГДЕ
	|	СчетНаОплатуМатериалы.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетНаОплатуОсновныеСредства.Всего,
	|	СчетНаОплатуОсновныеСредства.Ссылка.КПС,
	|	СчетНаОплатуОсновныеСредства.Ссылка.КОСГУ,
	|	СчетНаОплатуОсновныеСредства.Ссылка.КФО,
	|	СчетНаОплатуОсновныеСредства.Ссылка.Договор
	|ИЗ
	|	Документ.СчетНаОплату.ОсновныеСредства КАК СчетНаОплатуОсновныеСредства
	|ГДЕ
	|	СчетНаОплатуОсновныеСредства.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетНаОплатуУслуги.Всего,
	|	СчетНаОплатуУслуги.Ссылка.КПС,
	|	СчетНаОплатуУслуги.Ссылка.КОСГУ,
	|	СчетНаОплатуУслуги.Ссылка.КФО,
	|	СчетНаОплатуУслуги.Ссылка.Договор
	|ИЗ
	|	Документ.СчетНаОплату.Услуги КАК СчетНаОплатуУслуги
	|ГДЕ
	|	СчетНаОплатуУслуги.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(СуммыПлатежа.Сумма) КАК СуммаВал,
	|	СуммыПлатежа.КПС КАК КБКНазначениеПлатежа,
	|	СуммыПлатежа.КОСГУ КАК КОСГУНазначениеПлатежа,
	|	СуммыПлатежа.КФО КАК КФО,
	|	СуммыПлатежа.Договор КАК Договор
	|ИЗ
	|	СуммыПлатежа КАК СуммыПлатежа
	|
	|СГРУППИРОВАТЬ ПО
	|	СуммыПлатежа.КПС,
	|	СуммыПлатежа.КОСГУ,
	|	СуммыПлатежа.КФО,
	|	СуммыПлатежа.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетНаОплату.Ссылка КАК ДокументОснование, 
	|	СчетНаОплату.ВалютаДокумента КАК ВалютаДокумента,
	|	СчетНаОплату.ИФО КАК ИФО,
	|	СчетНаОплату.Организация КАК Организация,
	|	СчетНаОплату.Подразделение КАК Подразделение,
	|	СчетНаОплату.Контрагент КАК Контрагент,
	|	СчетНаОплату.Плательщик КАК Плательщик,
	|	СчетНаОплату.СчетПлательщика КАК СчетКонтрагента,
	|	СчетНаОплату.ЛицевойСчет КАК ЛицевойСчет,
	|	СчетНаОплату.НазначениеПлатежа КАК НазначениеПлатежа,
	|	СчетНаОплату.КФО КАК КФО,
	|	СчетНаОплату.КОСГУ КАК КОСГУ
	|ИЗ
	|	Документ.СчетНаОплату КАК СчетНаОплату
	|ГДЕ
	|	СчетНаОплату.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ОснованиеСсылка);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = МассивРезультатов[2].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(КассовоеПоступлениеОбъект, ВыборкаШапка);

		КассовоеПоступлениеОбъект.КорСчет = БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, ВыборкаШапка.Организация);
		
		ТаблицаКФОиИсточниковСредств = Новый ТаблицаЗначений;
		ТаблицаКФОиИсточниковСредств.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ТаблицаКФОиИсточниковСредств.Колонки.Добавить("СписокИсточников", Новый ОписаниеТипов("СписокЗначений")); 
		
		ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(
		   КассовоеПоступлениеОбъект.ЛицевойСчет,
		   Новый СписокЗначений,
		   ТаблицаКФОиИсточниковСредств);
		   
		СтрокаИсточникаСредств = ТаблицаКФОиИсточниковСредств.Найти(ВыборкаШапка.КФО, "КФО");
		Если НЕ СтрокаИсточникаСредств = Неопределено И СтрокаИсточникаСредств.СписокИсточников.Количество() > 0 Тогда
			НужныйИсточник = СтрокаИсточникаСредств.СписокИсточников[0].Значение;
		Иначе
			НужныйИсточник = Неопределено;
		КонецЕсли;	
		
		СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(ВыборкаШапка.КОСГУ, "205.00,209.00",,, ВыборкаШапка.Организация, ВыборкаШапка.ИФО);

		ТабРасшифрока = КассовоеПоступлениеОбъект.РасшифровкаПлатежа;

		Выборка = МассивРезультатов[1].Выбрать();
				
		Пока Выборка.Следующий() Цикл
			
			Если НЕ Выборка.СуммаВал > 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			НовСтр = ТабРасшифрока.Добавить();
			
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			
			НовСтр.ИсточникСредств = НужныйИсточник;
			
			НовСтр.СчетРасчетов = СчетРасчетов;
			
		КонецЦикла;
		
		КассовоеПоступлениеОбъект.СуммаДокументаВВалюте = ТабРасшифрока.Итог("СуммаВал");
		
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(КассовоеПоступлениеОбъект.ВалютаДокумента, КассовоеПоступлениеОбъект.Дата);
		КассовоеПоступлениеОбъект.Курс = КурсКратность.Курс;
		КассовоеПоступлениеОбъект.Кратность = КурсКратность.Кратность;
		
		КассовоеПоступлениеОбъект.СуммаДокумента = КассовоеПоступлениеОбъект.СуммаДокументаВВалюте*КассовоеПоступлениеОбъект.Курс/?(КассовоеПоступлениеОбъект.Кратность=0,1,КассовоеПоступлениеОбъект.Кратность);
		
		Для Каждого ДанныеСтроки Из КассовоеПоступлениеОбъект.РасшифровкаПлатежа Цикл
			ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*КассовоеПоступлениеОбъект.Курс/?(КассовоеПоступлениеОбъект.Кратность=0,1,КассовоеПоступлениеОбъект.Кратность);
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ЗаполнитьНаОснованииАвансовогоОтчета(КассовоеПоступлениеОбъект, ДокументОснование, СтандартнаяОбработка) Экспорт
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.Сотрудник, "Контрагент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("пСчет", 							БухгалтерскийУчет.СписокСчетов("208.00")); 
	Запрос.УстановитьПараметр("Организация", 					ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Субконто1", 						Контрагент);
	Запрос.УстановитьПараметр("АвансовыйОчетСсылка",			ДокументОснование);
	Запрос.УстановитьПараметр("ДокументыАвансов", 				ДокументОснование.Получено.ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("ДокументыИзрасходовано", 		ДокументОснование.Израсходовано.ВыгрузитьКолонку("ПриходныйДокумент"));
	Запрос.УстановитьПараметр("ДокументыПерерасхода", 			ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументПерерасхода"));
	Запрос.УстановитьПараметр("ДокументыОстатка", 				ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументОстатка"));
	
	Запрос.УстановитьПараметр("МоментВремени", РасчетыСПодотчетнымиЛицами.МоментВремениДокументаНачальногоОстатка(ДокументОснование));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
