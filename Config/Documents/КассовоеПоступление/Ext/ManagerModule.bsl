		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, КассовоеПоступлениеОбъект, "ЛицевойСчет");
	КонецЕсли;
	
	КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(КассовоеПоступлениеОбъект.ВалютаДокумента, КассовоеПоступлениеОбъект.Дата);
	КассовоеПоступлениеОбъект.Курс = КурсКратность.Курс;
	КассовоеПоступлениеОбъект.Кратность = КурсКратность.Кратность;
	
	КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Очистить();
	
	ВыборкаРасшифровка = Выборка.Выбрать();
	Пока ВыборкаРасшифровка.Следующий() Цикл
		
		СтрРасшифровка = КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Добавить();
		СтрРасшифровка.КФО = ВыборкаРасшифровка.КФО;
		СтрРасшифровка.КБКНазначениеПлатежа = ВыборкаРасшифровка.КПС;
		СтрРасшифровка.КОСГУНазначениеПлатежа = ВыборкаРасшифровка.КЭК;
		СтрРасшифровка.СуммаВал = ВыборкаРасшифровка.Сумма;
		СтрРасшифровка.Сумма = ВыборкаРасшифровка.Сумма * КассовоеПоступлениеОбъект.Курс / ?(КассовоеПоступлениеОбъект.Кратность = 0, 1, КассовоеПоступлениеОбъект.Кратность);
		СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(КассовоеПоступлениеОбъект.ЛицевойСчет, СтрРасшифровка.КФО);
		Если ДопустимыеИсточникиСредств.Количество() = 1 Тогда
			СтрРасшифровка.ИсточникСредств = ДопустимыеИсточникиСредств[0];
		КонецЕсли;
		
	КонецЦикла;
	
	КассовоеПоступлениеОбъект.СуммаДокументаВВалюте = КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Итог("СуммаВал");
	КассовоеПоступлениеОбъект.СуммаДокумента = КассовоеПоступлениеОбъект.РасшифровкаПлатежа.Итог("Сумма");
	
