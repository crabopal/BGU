#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти


#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПлановыеПоступленияОплатыРодительскаяПлата") Тогда
		
		Документы.КассовоеПоступление.ЗаполнитьНаОснованииПлановыхПоступленийРодительскойПлаты(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);	
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		Документы.КассовоеПоступление.ЗаполнитьНаОснованииСчетаНаОплату(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		
		Документы.КассовоеПоступление.ЗаполнитьНаОснованииАвансовогоОтчета(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);	
	
	Договор = СтрСоединить(ОбщегоНазначения.ВыгрузитьКолонку(РасшифровкаПлатежа, "Договор", Истина), "; ");
	
	ИспользуетсяНастройкаПогашенияЗадолженности =
		УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет);
	
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаРасшифровки.Контрагент) Тогда
			СтрокаРасшифровки.Контрагент = Контрагент;
		КонецЕсли;
		
		Если НЕ ИспользуетсяНастройкаПогашенияЗадолженности Тогда
			СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			СтрокаРасшифровки.ДопСубконтоРасчетов = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	НельзяПровести = НЕ (СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма"));
	
	Если НельзяПровести Тогда
		
		Если СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал") Тогда
			ИмяПоля = "СуммаДокумента";
			НераспределеннаяСумма = Формат((СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма")),"ЧДЦ=2");
		Иначе
			ИмяПоля = "СуммаДокументаВВалюте";
			НераспределеннаяСумма = Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2");
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Проведение невозможно. Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: '") + НераспределеннаяСумма;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ИмяПоля, "Объект");
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НельзяПровести Тогда
		
		Отказ = Истина;
		
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		
		ВалютаЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ВалютаСчета");
		ТипЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ТипЛицевогоСчета");
		
		Если ЗначениеЗаполнено(ВалютаДокумента)
			И ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И НЕ ВалютаДокумента = ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка()
			И НЕ ЗначениеЗаполнено(СуммаКупленнойВалюты) Тогда
			
			ПроверяемыеРеквизиты.Добавить("СуммаКупленнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КурсКупленнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КратностьКупленнойВалюты");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ остатками задолженности к погашению.
//
Процедура ЗаполнитьПоОстаткамЗадолженности() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	
	ПлатежноРасчетныеДокументы.ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(
		РасшифровкаПлатежа, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли