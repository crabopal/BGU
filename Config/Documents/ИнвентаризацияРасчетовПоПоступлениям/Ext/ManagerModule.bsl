//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0504091
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504091_103н";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504091) (в ред.103н)'");
	
	// Форма 0504091 расширенная (долгосрочная и просроченная задолженности)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504091Расширенная_103н";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504091) расширенная (в ред.103н)'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504091";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504091)'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504091_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504091_103н",
			"Инвентаризационная опись расчетов по поступлениям (ф. 0504091)",
			ПечатьФормы0504091(МассивОбъектов, ОбъектыПечати, "103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504091Расширенная_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504091Расширенная_103н",
			"Инвентаризационная опись расчетов по поступлениям расширенная (ф. 0504091)",
			ПечатьФормы0504091(МассивОбъектов, ОбъектыПечати, "103н", Истина));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504091") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504091",
			"Инвентаризационная опись расчетов по поступлениям (ф. 0504091)",
			ПечатьФормы0504091(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

Функция СчетаРасчетовССубконтоДоговоры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&СчетаРасчетов)
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Договоры)";
	
	Запрос.УстановитьПараметр("СчетаРасчетов", ПолучитьСписокСчетовПоУмолчанию(Ложь));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

