		Если Расширенная Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовПоПоступлениям.ПФ_MXL_Ф0504091_Расширенная_103н");
			
			КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовПоПоступлениям_ф0504091_Расширенная_103н";
		Иначе
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовПоПоступлениям.ПФ_MXL_Ф0504091_103н");
			
			КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовПоПоступлениям_ф0504091_103н";
