	|			ВЫРАЗИТЬ(Субконто2 КАК Справочник.Контрагенты).Наименование
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.Контрагенты).Наименование
	|		
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент.Наименование, """")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент.Наименование, """")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент.Наименование, """")
	|		
	|		ИНАЧЕ
	|			Счет.Наименование
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто1	КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто2	КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто3	КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент.ТипКонтрагента.Код, ""0"")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент.ТипКонтрагента.Код, ""0"")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент.ТипКонтрагента.Код, ""0"")
	|			
	|		ИНАЧЕ
	|			""0""
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ЗаполнятьКодЦели И ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.ВидыЦелевыхСредств) ТОГДА
	|			Субконто1
	|		КОГДА &ЗаполнятьКодЦели И ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.ВидыЦелевыхСредств) ТОГДА
	|			Субконто2
	|		КОГДА &ЗаполнятьКодЦели И ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.ВидыЦелевыхСредств) ТОГДА
	|			Субконто3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
	|	КОНЕЦ
	|ИМЕЮЩИЕ
	|	СУММА(СуммаОстаток) <> 0
	|УПОРЯДОЧИТЬ ПО
	|	КонтрагентНаименование, " + ?(ДокументОбъект.РежимЗаполнения = 1, "Договор,", "") + "
	|	Договор,
	|	Счет.Порядок,
	|	КФО.Порядок
	|;";
	
	ТаблицаЗадолженность = ЗапросЗаполнение.Выполнить().Выгрузить();
	
	Если ДокументОбъект.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
		ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(ТаблицаЗадолженность);
	КонецЕсли;
	
	ДополнительныеПараметры = ИнвентаризацияСервер.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации();
	ДополнительныеПараметры.ВидЗадолженности						= Перечисления.ВидыЗадолженности.Дебиторская;
	ДополнительныеПараметры.ИспользоватьУчетПоИФО					= ИспользоватьУчетПоИФО;
	ДополнительныеПараметры.ИспользоватьКонтрольИсполненияДоговоров	= ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	ИнвентаризацияСервер.ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации(ТаблицаЗадолженность, ДокументОбъект, ДополнительныеПараметры);
	
	Если РежимЗаполнения > 0 Тогда
		ПараметрыПоискаОборотов = ИнвентаризацияСервер.ПолучитьПустыеПараметрыПоискаОборотовСНачалаГода();
		ПараметрыПоискаОборотов.Организация							= ДокументОбъект.Организация;
		ПараметрыПоискаОборотов.ДатаИнвентаризации					= ДокументОбъект.ДатаИнвентаризации;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоИФО				= ИспользоватьУчетПоИФО;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоПодразделениям	= ИспользоватьУчетПоПодразделениям;
		
		ИнвентаризацияСервер.ОставитьОстаткиТолькоПросроченнойЗадолженности52н(ТаблицаЗадолженность, ПараметрыПоискаОборотов, РежимЗаполнения);
	КонецЕсли;
	
	ДокументОбъект["Задолженность"].Загрузить(ТаблицаЗадолженность);
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ДатаИнвентаризации,РежимЗаполнения");
	
	//по счетам 205, 208, 209 отрицательные суммы это Кредиторская задолженность
	МассивАПСчетов = БухгалтерскийУчет.СписокСчетов("205.00, 208.00, 209.00"); 
	
	ФормироватьДвиженияДолгосрочнойПросроченной = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.РазрешеноФормированиеДвиженийСтороннимиДокументами(ЗначенияРеквизитов.ДатаИнвентаризации);
	
	Если Не ФормироватьДвиженияДолгосрочнойПросроченной Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",					ДокументСсылка);
	Запрос.УстановитьПараметр("ДатаИнвентаризации",		НачалоДня(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("ДатаНачалоГода",			НачалоГода(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация",			ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Дебиторская",			Перечисления.ВидыЗадолженности.Дебиторская);
	Запрос.УстановитьПараметр("Кредиторская",			Перечисления.ВидыЗадолженности.Кредиторская);
	Запрос.УстановитьПараметр("МассивАПСчетов",			МассивАПСчетов);
	Запрос.УстановитьПараметр("ДетализацияПоДоговорам",	ЗначенияРеквизитов.РежимЗаполнения = 1);
	
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру сведений ДолгосрочнаяПросроченнаяЗадолженность
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаИнвентаризации КАК Период,
	|	&ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	&Организация КАК Организация,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Счет КАК СчетРасчетов,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Счет В (&МассивАПСчетов)
	|				И (ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Долгосрочная < 0
	|					ИЛИ ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Просроченная < 0)
	|			ТОГДА &Кредиторская
	|		ИНАЧЕ &Дебиторская
	|	КОНЕЦ КАК ВидЗадолженности,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ИФО КАК ИФО,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.КФО КАК КФО,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.КПС КАК КПС,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.КЭК КАК КЭК,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА &ДетализацияПоДоговорам
	|			ТОГДА ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Счет В (&МассивАПСчетов)
	|				И ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Долгосрочная < 0
	|			ТОГДА -ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Долгосрочная
	|		ИНАЧЕ ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Долгосрочная
	|	КОНЕЦ КАК Долгосрочная,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Счет В (&МассивАПСчетов)
	|				И ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Просроченная < 0
	|			ТОГДА -ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Просроченная
	|		ИНАЧЕ ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Просроченная
	|	КОНЕЦ КАК Просроченная,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ДатаИсполнения КАК ДатаИсполнения,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ПричинаОбразованияКод КАК ПричинаОбразованияКод,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ПричинаОбразованияПояснение КАК ПричинаОбразованияПояснение,
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.ПричинаОбразованияДополнительно КАК ПричинаОбразованияДополнительно
	|ИЗ
	|	Документ.ИнвентаризацияРасчетовПоПоступлениям.Задолженность КАК ИнвентаризацияРасчетовПоПоступлениямЗадолженность
	|ГДЕ
	|	ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Ссылка = &Ссылка
	|	И (&ДатаИнвентаризации = &ДатаНачалоГода
	|			ИЛИ (ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Долгосрочная <> 0
	|				ИЛИ ИнвентаризацияРасчетовПоПоступлениямЗадолженность.Просроченная <> 0))";
	
	Результат = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ДолгосрочнаяПросроченнаяЗадолженность", Результат.Выгрузить());
	
КонецПроцедуры

