#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьСписокСчетовПоУмолчанию(ДокументОбъект) Экспорт
	
	СписокСчетовПоУмолчанию = ПолучитьСписокСчетовПоУмолчанию();
	
	ТабличнаяЧасть = ДокументОбъект["СписокСчетов"];
	
	ТабличнаяЧасть.Очистить();
	
	Для Каждого Счет Из СписокСчетовПоУмолчанию Цикл
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		НоваяСтрока["Счет"] = Счет;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект, РежимЗаполнения) Экспорт
	
	ДатаОпределенияОстатков	= ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации);
	
	СписокСчетов = ПолучитьМассивЗаполненныхЗначений(ДокументОбъект["СписокСчетов"], "Счет");
	
	СписокКонтрагентов = ПолучитьМассивЗаполненныхЗначений(ДокументОбъект["СписокКонтрагентов"], "Контрагент");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ИспользоватьОтборПоПодразделению = ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект["Подразделение"]);
	
	ИспользоватьОтборПоКонтрагенту = (СписокКонтрагентов.Количество() > 0);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьОтборПоИФО = ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект["ИФО"]);
	
	ИспользоватьОтборПоКФО = ЗначениеЗаполнено(ДокументОбъект["КФО"]);
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДатаЗапроса",						ДатаОпределенияОстатков);
	ЗапросЗаполнение.УстановитьПараметр("СписокСчетов",						СписокСчетов);
	ЗапросЗаполнение.УстановитьПараметр("СписокКонтрагентов",				СписокКонтрагентов);
	ЗапросЗаполнение.УстановитьПараметр("Организация",						ДокументОбъект["Организация"]);
	ЗапросЗаполнение.УстановитьПараметр("Подразделение",					ДокументОбъект["Подразделение"]);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",								ДокументОбъект["ИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",								ДокументОбъект["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ИспользоватьОтборПоКонтрагенту);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоИФО",			ИспользоватьОтборПоИФО);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоКФО",			ИспользоватьОтборПоКФО);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",			ИспользоватьУчетПоИФО);
	ЗапросЗаполнение.УстановитьПараметр("КЭК000",							БухгалтерскийУчетПовтИсп.КЭК0());
	ЗапросЗаполнение.УстановитьПараметр("ЗаполнятьКодЦели",					ДокументОбъект.ЗаполнятьКодЦели);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Отбор контрагентов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
