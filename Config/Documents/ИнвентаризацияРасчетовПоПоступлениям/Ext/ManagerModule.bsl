	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		
	|		ИНАЧЕ
	|			Счет.Наименование
	|	КОНЕЦ													КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты).Наименование
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто2 КАК Справочник.Контрагенты).Наименование
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.Контрагенты).Наименование
	|		
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент.Наименование, """")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент.Наименование, """")
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент.Наименование, """")
