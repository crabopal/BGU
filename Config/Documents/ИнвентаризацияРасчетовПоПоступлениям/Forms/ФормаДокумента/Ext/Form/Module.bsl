&НаКлиенте
Процедура ПроверитьИЗаполнитьСчетамиПоУмолчанию()
	
	// Есть строки с непустым счетом?
	ЕстьСчета = ОпределитьНаличиеНепустыхСчетовВТаблице();
	
	Если ЕстьСчета Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением будет очищена
			|табличная часть ""Счета учета расчетов""
			|
			|Продолжить и заполнить?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСчетамиПоУмолчанию_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьСчетамиПоУмолчаниюКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьСчетамиПоУмолчанию_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСчетамиПоУмолчаниюКлиент();
	КонецЕсли;
		
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьСчетамиПоУмолчаниюКлиент()
	
	ЗаполнитьСчетамиПоУмолчаниюНаСервере();
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьСчетамиПоУмолчаниюНаСервере()
	
	Документы.ИнвентаризацияРасчетовПоПоступлениям.ЗаполнитьСписокСчетовПоУмолчанию(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета(РежимЗаполнения = 0)
	
	Если ВходныеДанныеЗаполнены() Тогда
		
		Если Объект["Задолженность"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
				|табличная часть ""Дебиторская задолженность""
				|
				|Продолжить и очистить?'");
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("РежимЗаполнения", РежимЗаполнения);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчета_Выбор", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);		
		Иначе
			ЗаполнитьПоДаннымУчетаКлиент(РежимЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент(ПараметрыОповещения.РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент(РежимЗаполнения)
	
	ЗаполнитьПоДаннымУчетаНаСервере(РежимЗаполнения);
	
	Если Объект["Задолженность"].Количество() = 0 Тогда
		Текст = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
		ПоказатьПредупреждение(, Текст, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьПоДаннымУчетаНаСервере(РежимЗаполнения)
	
	Документы.ИнвентаризацияРасчетовПоПоступлениям.ЗаполнитьПоДаннымУчета(Объект, РежимЗаполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьСписатьНаКлиенте(ВидОперации)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание дебиторской задолженности'");
	
	// Проверим модифицированность.
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Данные были изменены. Необходимо сначала сохранить изменения.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Задолженность.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВидОперации", ВидОперации);
		ДопПараметры.Вставить("СтрокиИнвентаризации", ВыделенныеСтроки);
		
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьСписаниеДебиторскойЗадолженностиЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = НСтр("ru='Списать дебиторскую задолженность в выделенной строке или во всех строках таблицы?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Во всех строках'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='В выделенной строке'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Нет);
		
	Иначе
		СоздатьСписаниеДебиторскойЗадолженности(ВидОперации, ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ВопросСоздатьСписаниеДебиторскойЗадолженностиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда // Во всех строках.
		СоздатьСписаниеДебиторскойЗадолженности(ДополнительныеПараметры.ВидОперации);
	Иначе // В выделенной строке.
		СоздатьСписаниеДебиторскойЗадолженности(ДополнительныеПараметры.ВидОперации, ДополнительныеПараметры.СтрокиИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоздатьСписаниеДебиторскойЗадолженности(ВидОперации, СтрокиИнвентаризации = Неопределено)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание дебиторской задолженности'");
	
	// Проверим, что выбраны строки с одинаковым ИФО.
	СтрокиДляПроверки = ?(СтрокиИнвентаризации = Неопределено, Объект.Задолженность, СтрокиИнвентаризации);
	ЭтоПерваяСтрока = Истина;
	НомераСтрокИнвентаризации = Новый Массив;
	Для Каждого СтрокаИнвентаризации Из СтрокиДляПроверки Цикл
		
		Если ТипЗнч(СтрокаИнвентаризации) = Тип("Число") Тогда
			ДанныеСтроки = Объект.Задолженность.НайтиПоИдентификатору(СтрокаИнвентаризации);
		Иначе
			ДанныеСтроки = СтрокаИнвентаризации;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			ПредыдущийИФО  = ДанныеСтроки.ИФО;
			ЭтоПерваяСтрока = Ложь;
		Иначе
			// Проверим, что выбраны строки с одинаковым ИФО.
			Если ИспользоватьУчетПоИФО И (ПредыдущийИФО <> ДанныеСтроки.ИФО) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями поля ИФО.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// Проверим корректность выбранного вида операции.
		Если ЗначениеЗаполнено(ДанныеСтроки.Счет)
			И (Счета04.НайтиПоЗначению(ДанныеСтроки.Счет) <> Неопределено) // Это счет 04.
			И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности") Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для задолженности на забалансовом счете 04 не применяется вид операции ""Списать сомнительную задолженность"".'"), 10, ТекстЗаголовкаПредупреждений);
			Возврат;
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Счет)
			И (Счета04.НайтиПоЗначению(ДанныеСтроки.Счет) = Неопределено) // Это не счет 04.
			И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.ВосстановлениеСомнительнойЗадолженности") Тогда
			ПоказатьПредупреждение(, НСтр("ru='Вид операции ""Восстановить сомнительную задолженность"" применяется только для задолженности на забалансовом счете 04.'"), 10, ТекстЗаголовкаПредупреждений);
			Возврат;
		КонецЕсли;
		
		НомераСтрокИнвентаризации.Добавить(ДанныеСтроки.НомерСтроки);
		
	КонецЦикла;
	
	// Создание документа списания дебиторской задолженности.
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
	ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАнализЗадолженности(СтрокаДокумента, ВидЗадолженности)

	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СчетаРасчетовССубконтоДоговоры.НайтиПоЗначению(СтрокаДокумента.Счет) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ДатаОтчета,Организация,
		|ВидЗадолженности,ВидЗадолженностиИспользование,Контрагент,Договор");
	
	ПараметрыФормы.Вставить("ДатаОтчета", ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(Объект.ДатаИнвентаризации));
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ВидЗадолженности", ВидЗадолженности);
	ПараметрыФормы.Вставить("ВидЗадолженностиИспользование", Истина);
	
	ПараметрыФормы.Вставить("Контрагент", СтрокаДокумента.Контрагент);
	Если Объект.РежимЗаполнения <> 0 Тогда
		ПараметрыФормы.Вставить("Договор", СтрокаДокумента.Договор);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки", "ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов", СтрокаДокумента.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС", СтрокаДокумента.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО", СтрокаДокумента.КФО);
	ПараметрыФормы.Расшифровка.Вставить("ИФО", СтрокаДокумента.ИФО);
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, СтрокаДокумента.ИсходныйНомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВведенТекстПричиныЗадолженности(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = "";
	ДопПараметры.Свойство("ИмяЭлемента", ИмяЭлемента);
	
	ИмяТаблицы = "";
	ДопПараметры.Свойство("ИмяТаблицы", ИмяТаблицы);
	
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные[ИмяЭлемента] = СокрЛП(Результат);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

