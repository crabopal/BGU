&НаСервере
Процедура НастроитьФормуСервер()
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияРасчетовПоПоступлениям.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Счета04.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("04"));
	СчетаРасчетовССубконтоДоговоры.ЗагрузитьЗначения(Документы.ИнвентаризацияРасчетовПоПоступлениям.СчетаРасчетовССубконтоДоговоры());
	
	ПричиныОбразованияДт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Дебиторская);
	Элементы.ЗадолженностьПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияДт);
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ВходныеДанныеЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не выбрана организация'"),
			Объект["Ссылка"],
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект["ДатаИнвентаризации"]) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	ЕстьСчета = ОпределитьНаличиеНепустыхСчетовВТаблице();
	Если НЕ ЕстьСчета Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указаны счета учета расчетов'"),
			Объект["Ссылка"],
			"Объект.СписокСчетов");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьСуммыВСтроке()
	
	ИмяТаблЧасти = "Задолженность";
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьЗначениеОтметитьСтроку(ТекДанные);
	
КонецПроцедуры

// Определяет наличие хотя бы одной строки в табл.части "Список счетов" с непустым счетом.
&НаКлиенте
Функция ОпределитьНаличиеНепустыхСчетовВТаблице()
	
	Для Каждого СтрокаТЧ Из Объект["СписокСчетов"] Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ["Счет"]) Тогда
			// Обнаружили непустой счет.
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


// Рассчитывает колонку "ОтметитьСтроку" в табл.части "Задолженность".
&НаСервере
Процедура РассчитатьКолонкуОтметитьСтрокуНаСервере();
	
	ТаблЧасть = Объект["Задолженность"];
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		ОбновитьЗначениеОтметитьСтроку(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗначениеОтметитьСтроку(СтрокаТЧ)
	
	СтрокаТЧ["ОтметитьСтроку"] = НЕ (СтрокаТЧ["Всего"] = (СтрокаТЧ["Подтверждено"] + СтрокаТЧ["НеПодтверждено"] + СтрокаТЧ["ИстекСрокДавности"]));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокСпискаКонтрагентов()
	
	КоличествоКонтрагентов = Объект["СписокКонтрагентов"].Количество();
	
	Если КоличествоКонтрагентов > 0 Тогда
		ЗаголовокСпискаКонтрагентов = Строка(КоличествоКонтрагентов);
	Иначе
		ЗаголовокСпискаКонтрагентов = НСтр("ru='без ограничения'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонтрагентаИзФормыПодбора(ВыбранноеЗначение)
	
	НоваяСтрока = Объект["СписокКонтрагентов"].Добавить();
	
	НоваяСтрока["Контрагент"] = ВыбранноеЗначение;
	
	ОбновитьЗаголовокСпискаКонтрагентов();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	КолонкаДоговор = Новый Массив;
	КолонкаДоговор.Добавить("ЗадолженностьДоговор");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкаДоговор, "Видимость", Объект.РежимЗаполнения <> 0);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЗаполнятьКодЦели()
	
	Элементы.ЗаполнятьКодЦели.Доступность = (Объект.РежимЗаполнения <> 0);
	
КонецПроцедуры

