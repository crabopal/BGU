#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = ТоварыРаботыУслуги.Итог("Сумма");
	
	Для Каждого Строка Из ТоварыРаботыУслуги Цикл
		
		Если ЗначениеЗаполнено(Строка.ИдентификационныйКодЗакупки)
			И (СтрДлина(СокрЛП(Строка.ИдентификационныйКодЗакупки)) < 36
				ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Строка.ИдентификационныйКодЗакупки)) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Идентификационный код закупки не корректен: должен быть 36-ти значный цифровой код'"),
				, "Объект.ТоварыРаботыУслуги["+(Строка.НомерСтроки - 1)+"].ИдентификационныйКодЗакупки", , Отказ);
		КонецЕсли;
		
		Если Строка.СпособЗакупки <> ПредопределенноеЗначение("Перечисление.СпособыЗакупки.Электронно") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.ДатаДокументаОбОсуществленииЗакупки) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 не заполнена дата документа закупки'"), Строка.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
				"Объект.ТоварыРаботыУслуги["+(Строка.НомерСтроки - 1)+"].ДатаДокументаОбОсуществленииЗакупки", , Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.НомерДокументаОбОсуществленииЗакупки) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 не заполнен номер документа закупки'"), Строка.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
				"Объект.ТоварыРаботыУслуги["+(Строка.НомерСтроки - 1)+"].НомерДокументаОбОсуществленииЗакупки", , Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.СтатусЗакупки) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 не заполнен статус закупки'"), Строка.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
				"Объект.ТоварыРаботыУслуги["+(Строка.НомерСтроки - 1)+"].СтатусЗакупки", , Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснованиеДата) И ДокументОснованиеДата > НачалоДня(Дата) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата документа-основания не должна быть больше даты заявки'"),
			, "Объект.ДокументОснованиеДата", , Отказ);
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Задолженность.Очистить();
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если СпособВыдачиДенежныхСредств <> ПредопределенноеЗначение(
		"Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Безналичными") Тогда
		НеПроверяемыеРеквизиты.Добавить("СчетДляПеречисленияДенежныхСредств");
	КонецЕсли;
	
	Если СпособВыдачиДенежныхСредств = ПредопределенноеЗначение(
		"Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы") Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ТоварыРаботыУслуги.СпособОбеспечения"); 
		
		// В соответствии Письмом Минфина России от 30.07.2024 N 02-06-06/70843 Заявка-обоснование закупки товаров, работ, 
		// услуг малого объема через подотчетное лицо (ф.0510121) при выдаче в подотчет денежных документов:
		// "в графе 1 - код вида денежного документа в соответствии с "Общероссийским классификатором продукции по видам 
		// экономической деятельности" (ОКПД2) (поле не обязательное для заполнения);"	
		НеПроверяемыеРеквизиты.Добавить("ТоварыРаботыУслуги.ОКПД");

	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли