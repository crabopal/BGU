	|		КОГДА ТИПЗНАЧЕНИЯ(ДвиженияССубконто.СубконтоКт3) = ТИП(Справочник.Мероприятия)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт3 КАК Справочник.Мероприятия)
	|		КОГДА ТИПЗНАЧЕНИЯ(ДвиженияССубконто.СубконтоДт1) = ТИП(Справочник.Мероприятия)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт1 КАК Справочник.Мероприятия)
	|		КОГДА ТИПЗНАЧЕНИЯ(ДвиженияССубконто.СубконтоДт2) = ТИП(Справочник.Мероприятия)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт2 КАК Справочник.Мероприятия)
	|		КОГДА ТИПЗНАЧЕНИЯ(ДвиженияССубконто.СубконтоДт3) = ТИП(Справочник.Мероприятия)
	|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт3 КАК Справочник.Мероприятия)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
	|	КОНЕЦ,
	|	ДвиженияССубконто.КФО,
	|	ВЫБОР
	|		КОГДА ДвиженияССубконто.ВалютаКт ЕСТЬ NULL
	|				ИЛИ ДвиженияССубконто.ВалютаКт = &ВалютаРегУчета
	|			ТОГДА """"
	|		ИНАЧЕ ДвиженияССубконто.ВалютаКт
	|	КОНЕЦ";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДанныеДляВводаВедомостиНаВыдачуДенегИзКассы(МассивСсылок) Экспорт
	
	Результат = Новый Массив;
	
	ВалютаРегУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка КАК Ссылка,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка.Организация КАК Организация,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка.ИФО КАК ИФО,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка.ПодотчетноеЛицо КАК Сотрудник,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка.Подразделение КАК Подразделение,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Сумма КАК Сумма,
	|	&ВалютаРегУчета КАК Валюта,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.КФО КАК КФО,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.КПС КАК КПС,
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.КЭК КАК КЭК
	|ПОМЕСТИТЬ ТаблицаРасходов
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТоварыРаботыУслуги КАК ЗаявкаОбоснованиеТоварыРаботыУслуги
	|ГДЕ
	|	ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка В(&МассивСсылок)
	|	И ЗаявкаОбоснованиеТоварыРаботыУслуги.Ссылка.СпособВыдачиДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Наличными), ЗНАЧЕНИЕ(Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Безналичными))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРасходов.Ссылка КАК Ссылка,
	|	ТаблицаРасходов.Организация КАК Организация,
	|	ТаблицаРасходов.ИФО КАК ИФО,
	|	ТаблицаРасходов.Сотрудник КАК Сотрудник,
	|	ТаблицаРасходов.Подразделение КАК Подразделение,
	|	СУММА(ТаблицаРасходов.Сумма) КАК Сумма,
	|	ТаблицаРасходов.Валюта КАК Валюта,
	|	ТаблицаРасходов.КФО КАК КФО,
	|	ТаблицаРасходов.КПС КАК КПС,
	|	ТаблицаРасходов.КЭК КАК КЭК
	|ПОМЕСТИТЬ ТаблицаРасходовСгруппированная
	|ИЗ
	|	ТаблицаРасходов КАК ТаблицаРасходов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРасходов.Ссылка,
	|	ТаблицаРасходов.Организация,
	|	ТаблицаРасходов.ИФО,
	|	ТаблицаРасходов.КЭК,
	|	ТаблицаРасходов.Сотрудник,
	|	ТаблицаРасходов.Подразделение,
	|	ТаблицаРасходов.КФО,
	|	ТаблицаРасходов.Валюта,
	|	ТаблицаРасходов.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаРасходовСгруппированная.Организация КАК Организация,
	|	ТаблицаРасходовСгруппированная.Валюта КАК Валюта,
	|	ТаблицаРасходовСгруппированная.ИФО КАК ИФО,
	|	АВТОНОМЕРЗАПИСИ() КАК ИдентификаторНабора
	|ПОМЕСТИТЬ ТаблицаШапок
	|ИЗ
	|	ТаблицаРасходовСгруппированная КАК ТаблицаРасходовСгруппированная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаШапок.Организация КАК Организация,
	|	ТаблицаШапок.Валюта КАК Валюта,
	|	ТаблицаШапок.ИФО КАК ИФО,
	|	ТаблицаШапок.ИдентификаторНабора КАК ИдентификаторНабора,
	|	ТаблицаРасходовСгруппированная.Ссылка КАК ДокументОснование,
	|	ТаблицаРасходовСгруппированная.Сотрудник КАК Сотрудник,
	|	ТаблицаРасходовСгруппированная.Подразделение КАК ПодразделениеКор,
	|	ТаблицаРасходовСгруппированная.Сумма КАК Сумма,
	|	ТаблицаРасходовСгруппированная.КФО КАК КФО,
	|	ТаблицаРасходовСгруппированная.КПС КАК КПС,
	|	ТаблицаРасходовСгруппированная.КЭК КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет КАК КорСчет
	|ИЗ
	|	ТаблицаШапок КАК ТаблицаШапок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаРасходовСгруппированная КАК ТаблицаРасходовСгруппированная
	|		ПО ТаблицаШапок.Организация = ТаблицаРасходовСгруппированная.Организация
	|			И ТаблицаШапок.Валюта = ТаблицаРасходовСгруппированная.Валюта
	|			И ТаблицаШапок.ИФО = ТаблицаРасходовСгруппированная.ИФО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО (ТаблицаРасходовСгруппированная.КЭК = СоответствияАналитическихСчетовКЭК.КЭК
	|			ИЛИ ТаблицаРасходовСгруппированная.КЭК.Родитель = СоответствияАналитическихСчетовКЭК.КЭК)
	|			И (СоответствияАналитическихСчетовКЭК.Счет В (&Счет208))
	|			И (НЕ СоответствияАналитическихСчетовКЭК.Счет.ЭлементГруппа)
	|ИТОГИ
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(Валюта),
	|	МАКСИМУМ(ИФО),
	|	СУММА(Сумма)
	|ПО
	|	ИдентификаторНабора";
	
	Запрос.УстановитьПараметр("ВалютаРегУчета", ВалютаРегУчета);
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("Счет208",
		БухгалтерскийУчет.СписокСчетов("208.00", Новый Граница(МассивСсылок[0].МоментВремени())));
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Ведомость = Новый Структура;
		Ведомость.Вставить("Организация", ВыборкаШапка.Организация);
		Ведомость.Вставить("Валюта", ВыборкаШапка.Валюта);
		Ведомость.Вставить("ИФО", ВыборкаШапка.ИФО);
		Ведомость.Вставить("Ключ", Строка(ВыборкаШапка.Организация) + Строка(ВыборкаШапка.Валюта) + Строка(ВыборкаШапка.ИФО));
		
		ВедомостьТЧ = Новый Массив;
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
			СтрокаТЧ = Новый Структура;
			СтрокаТЧ.Вставить("Сотрудник", ВыборкаСтроки.Сотрудник);
			СтрокаТЧ.Вставить("ДокументОснование", ВыборкаСтроки.ДокументОснование);
			СтрокаТЧ.Вставить("КорСчет", ВыборкаСтроки.КорСчет);
			СтрокаТЧ.Вставить("ПодразделениеКор", ВыборкаСтроки.ПодразделениеКор);
			СтрокаТЧ.Вставить("КФО", ВыборкаСтроки.КФО);
			СтрокаТЧ.Вставить("КПС", ВыборкаСтроки.КПС);
			СтрокаТЧ.Вставить("КЭК", ВыборкаСтроки.КЭК);
			СтрокаТЧ.Вставить("Сумма", ВыборкаСтроки.Сумма);
			ВедомостьТЧ.Добавить(СтрокаТЧ);
		КонецЦикла;
		Ведомость.Вставить("РасшифровкаПлатежа", ВедомостьТЧ);
		
		Результат.Добавить(Ведомость);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо";
	КомандаПечати.Идентификатор = "ПФ_MXL_ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо";
	КомандаПечати.Представление = НСтр("ru = 'Заявка-обоснование закупки малого объема через подотчетное лицо'");
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо",
			"Заявка-обоснование закупки малого объема через подотчетное лицо",
			ПечатьЗаявкиОбоснованияЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

Функция ПечатьЗаявкиОбоснованияЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы(
		"Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ПФ_MXL_ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо");
	
	ОбластьЗаголовок 								= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрокаФинансовоеОбоснование 				= Макет.ПолучитьОбласть("СтрокаФинансовоеОбоснование");
	ОбластьИтогоФинансовоеОбоснование 				= Макет.ПолучитьОбласть("ИтогоФинансовоеОбоснование");
	ОбластьПодвалФинансовоеОбоснование 				= Макет.ПолучитьОбласть("ПодвалФинансовоеОбоснование");
	ОбластьШапкаСведенияОМалойЗакупке 				= Макет.ПолучитьОбласть("ШапкаСведенияОМалойЗакупке");
	ОбластьСтрокаСведенияОМалойЗакупке 				= Макет.ПолучитьОбласть("СтрокаСведенияОМалойЗакупке");
	ОбластьШапкаПодотчетноеЛицо 					= Макет.ПолучитьОбласть("ШапкаПодотчетноеЛицо");
	ОбластьСтрокаЗадолженностьВсегоПервая 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьВсегоПервая");
	ОбластьСтрокаЗадолженностьВсего 				= Макет.ПолучитьОбласть("СтрокаЗадолженностьВсего");
	ОбластьСтрокаЗадолженностьНаПроверкеПервая 		= Макет.ПолучитьОбласть("СтрокаЗадолженностьНаПроверкеПервая");
	ОбластьСтрокаЗадолженностьНаПроверке 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьНаПроверке");
	ОбластьСтрокаЗадолженностьПросроченнаяПервая 	= Макет.ПолучитьОбласть("СтрокаЗадолженностьПросроченнаяПервая");
	ОбластьСтрокаЗадолженностьПросроченная 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьПросроченная");
	ОбластьПодвалЗадолженность 						= Макет.ПолучитьОбласть("ПодвалЗадолженность");
	
	СведенияУчреждений = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Ссылка КАК Ссылка,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Номер КАК Номер,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Дата КАК Дата,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Организация КАК Организация,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОрганизацияОсуществляющаяОбеспечение КАК ОрганизацияОсуществляющаяОбеспечение,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОрганизацияОсуществляющаяОбеспечение.НаименованиеПолное КАК НаименованиеОрганизацииПБС,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеВид КАК ДокументОснованиеВид,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ПодотчетноеЛицо КАК ПодотчетноеЛицо,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ПодотчетноеЛицо.Код КАК ТабельныйНомер,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Руководитель КАК Руководитель,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.РуководительПодразделения КАК РуководительПодразделения,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.РуководительОрганизацииОсуществляющейОбеспечение КАК РуководительОрганизацииОсуществляющейОбеспечение,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Ответственный КАК Ответственный,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОтветственныйИсполнительБух КАК ОтветственныйИсполнительБух,
