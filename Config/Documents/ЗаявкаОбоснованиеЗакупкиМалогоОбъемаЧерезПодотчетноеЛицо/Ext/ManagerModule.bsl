		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.Дата);
		СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
		
		СтруктураДанных.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.Номер);
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(СтруктураДанных, СтруктураДанных.Ссылка, СведенияУчреждений);
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураДанных);
		Если СтруктураДанных.Организация = СтруктураДанных.ОрганизацияОсуществляющаяОбеспечение Тогда
			ОбластьЗаголовок.Параметры.НаименованиеОрганизацииПБС = "";
			ОбластьЗаголовок.Параметры.РуководительОрганизацииПБСИнициалыФамилия = "";
			ОбластьЗаголовок.Параметры.РуководительОрганизацииПБСДолжность = "";
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		СтрокиФинансовоеОбоснование = СтруктураДанных.ТоварыРаботыУслуги.Выбрать();
		Пока СтрокиФинансовоеОбоснование.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаФинансовоеОбоснование.Параметры, СтрокиФинансовоеОбоснование);
			ТабличныйДокумент.Вывести(ОбластьСтрокаФинансовоеОбоснование);
		КонецЦикла;
		
		ОбластьИтогоФинансовоеОбоснование.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьИтогоФинансовоеОбоснование);
		
		// Раздел СПРАВОЧНО. Сведения о малой закупке не выводится при выдаче денежных документов
		
		Если СтруктураДанных.СпособВыдачиДенежныхСредств <>
			ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы") Тогда
			
			ТабличныйДокумент.Вывести(ОбластьШапкаСведенияОМалойЗакупке);
			
			СтрокиФинансовоеОбоснование = СтруктураДанных.ТоварыРаботыУслуги.Выбрать();
			Пока СтрокиФинансовоеОбоснование.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ОбластьСтрокаСведенияОМалойЗакупке.Параметры, СтрокиФинансовоеОбоснование);
				ТабличныйДокумент.Вывести(ОбластьСтрокаСведенияОМалойЗакупке);
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьПодвалФинансовоеОбоснование.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалФинансовоеОбоснование);
		
		Если СтруктураДанных.СпособВыдачиДенежныхСредств =
			ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Безналичными")
			И ЗначениеЗаполнено(СтруктураДанных.СчетДляПеречисленияДенежныхСредств) Тогда
			
			БанковскийСчетОбъект = СтруктураДанных.СчетДляПеречисленияДенежныхСредств.ПолучитьОбъект();
			
			ПлатежныеРеквизиты = Новый Структура;
			ПлатежныеРеквизиты.Вставить("КорреспондентИНН", "ИНН");
			ПлатежныеРеквизиты.Вставить("КорреспондентКПП", "КПП");
			ПлатежныеРеквизиты.Вставить("КорреспондентТекст", "Корреспондент");
			ПлатежныеРеквизиты.Вставить("НомерСчетаПолучателя", "СчетНомер");
			ПлатежныеРеквизиты.Вставить("НаименованиеБанкаПолучателя", "Банк");
			ПлатежныеРеквизиты.Вставить("БикБанкаПолучателя", "БИК");
			
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(
				БанковскийСчетОбъект,
				БанковскийСчетОбъект,
				ПлатежныеРеквизиты,
				Истина,
				Ложь);
			
			Если НЕ ПустаяСтрока(БанковскийСчетОбъект.КорреспондентТекст) Тогда
				ПлатежныеРеквизиты.КорреспондентТекст = БанковскийСчетОбъект.КорреспондентТекст;
				ПлатежныеРеквизиты.КорреспондентИНН = БанковскийСчетОбъект.КорреспондентИНН;
				ПлатежныеРеквизиты.КорреспондентКПП = БанковскийСчетОбъект.КорреспондентКПП;
			КонецЕсли;
			
			СтруктураДанных.Вставить("РеквизитыДляПеречисленияДенежныхСредств",
				НСтр("ru = 'Получатель:'") + Символы.НПП + ПлатежныеРеквизиты.КорреспондентТекст
				+ ?(ЗначениеЗаполнено(ПлатежныеРеквизиты.НомерСчетаПолучателя),
					НСтр("ru = ', Р/счет'") + Символы.НПП + ПлатежныеРеквизиты.НомерСчетаПолучателя, "")
				+ ?(ЗначениеЗаполнено(ПлатежныеРеквизиты.БикБанкаПолучателя),
					НСтр("ru = ', БИК'") + Символы.НПП + ПлатежныеРеквизиты.БикБанкаПолучателя, "")
				+ ?(ЗначениеЗаполнено(ПлатежныеРеквизиты.НаименованиеБанкаПолучателя),
					НСтр("ru = ', Банк получателя'") + Символы.НПП + ПлатежныеРеквизиты.НаименованиеБанкаПолучателя, "")
				+ ?(ЗначениеЗаполнено(ПлатежныеРеквизиты.КорреспондентИНН),
					НСтр("ru = ', ИНН'") + Символы.НПП + ПлатежныеРеквизиты.КорреспондентИНН, "")
				+ ?(ЗначениеЗаполнено(ПлатежныеРеквизиты.КорреспондентКПП),
					НСтр("ru = ', КПП'") + Символы.НПП + ПлатежныеРеквизиты.КорреспондентКПП, ""));
			
		КонецЕсли;
		
		ОбластьШапкаПодотчетноеЛицо.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаПодотчетноеЛицо);
		
		СтрокиЗадолженность = СтруктураДанных.Задолженность.Выбрать();
		
		Если СтрокиЗадолженность.Количество() = 0 Тогда
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьВсегоПервая);
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
		КонецЕсли;
		
		НомерОбхода = 0;
		Пока НомерОбхода < 3 Цикл
			НомерОбхода = НомерОбхода + 1;
			Пока СтрокиЗадолженность.Следующий() Цикл
				Если НомерОбхода = 1 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьВсегоПервая, ОбластьСтрокаЗадолженностьВсего);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.Сумма;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 2 И СтрокиЗадолженность.СуммаНаПроверкеРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьНаПроверкеПервая, ОбластьСтрокаЗадолженностьНаПроверке);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаНаПроверке;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаНаПроверкеРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 3 И СтрокиЗадолженность.СуммаПросроченнаяРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьПросроченнаяПервая, ОбластьСтрокаЗадолженностьПросроченная);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаПросроченная;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаПросроченнаяРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				КонецЕсли;
			КонецЦикла;
			СтрокиЗадолженность.Сбросить();
		КонецЦикла;     
		
		//если не все строки СПРАВОЧНО было выведены ранее
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьНаПроверкеПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
		КонецЕсли;     
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьПросроченнаяПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
	    КонецЕсли; 
		
		ОбластьПодвалЗадолженность.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗадолженность);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТоварыРаботыУслуги КАК Заявка
	|
	|СГРУППИРОВАТЬ ПО
	|	Заявка.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(Заявка.Сумма) <> Заявка.Ссылка.СуммаДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заявка.Ссылка
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТоварыРаботыУслуги КАК Заявка
	|ГДЕ
	|	Заявка.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ПустаяСсылка)
	|	И Заявка.Ссылка.СпособВыдачиДенежныхСредств <> ЗНАЧЕНИЕ(Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы)";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	ДенежныеДокументы = ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	АвансПодотчетномуЛицу = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
		
			Итог = Объект.ТоварыРаботыУслуги.Итог("Сумма");
			
			Если Объект.СуммаДокумента <> Итог Тогда
				Объект.СуммаДокумента = Итог;
			КонецЕсли;
			
			Если Объект.СпособВыдачиДенежныхСредств <> ДенежныеДокументы Тогда
				Для Каждого Стр Из Объект.ТоварыРаботыУслуги Цикл
					Если НЕ ЗначениеЗаполнено(Стр.СпособОбеспечения) Тогда
						Стр.СпособОбеспечения = АвансПодотчетномуЛицу;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Объект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
