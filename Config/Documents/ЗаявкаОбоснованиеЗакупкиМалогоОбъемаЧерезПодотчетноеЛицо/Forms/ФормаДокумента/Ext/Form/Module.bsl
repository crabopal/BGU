&НаКлиенте
Процедура ПроверитьНаличиеЛБО(Команда)
	
	Если НеЗаполненРеквзитВТаблицеОбъекта("ТоварыРаботыУслуги", "ФинансовыйГод", НСтр("ru = 'финансовый год'")) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаличиеОбъемаФОНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыПодбора.Вставить("ИФО", Объект.ИФО);
	ПараметрыПодбора.Вставить("Дата", ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, Неопределено));
	ПараметрыПодбора.Вставить("ПоказыватьОстатки", Истина);
	ПараметрыПодбора.Вставить("ОстаткиПоРегиструНакопления", Истина);
	ПараметрыПодбора.Вставить("ЕстьКоличество", Истина);
	ПараметрыПодбора.Вставить("ЕстьСумма", Ложь);
	
	ТекЗаголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Подбор данных в %1'"), Объект.Ссылка);
	ПараметрыПодбора.Вставить("Заголовок", ТекЗаголовок);
	
	ОткрытьФорму("Справочник.ДенежныеДокументы.Форма.ФормаПодбораДенежныхДокументов", ПараметрыПодбора, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("ВыполнитьИзменениеРеквизитовСтрок", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	
	ПараметрыФормы.Вставить("ДопустимыеВидыРасходовКРБ", ДопустимыеВидыРасходовКРБ);
	ПараметрыФормы.Вставить("ДопустимыеКОСГУ", ДопустимыеКОСГУ);
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		НачальныеЗначения = Новый СписокЗначений;
		НачальныеЗначения.Добавить(ТекущиеДанные.КФО, "КФО");
		НачальныеЗначения.Добавить(ТекущиеДанные.КПС, "КПС");
		НачальныеЗначения.Добавить(ТекущиеДанные.КЭК, "КЭК");
		НачальныеЗначения.Добавить(ТекущиеДанные.КодЦели, "КодЦели");
		НачальныеЗначения.Добавить(ТекущиеДанные.КодМероприятия, "КодМероприятия");
		НачальныеЗначения.Добавить(ТекущиеДанные.ДопКлассификация, "ДопКлассификация");
		ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.Форма.ФормаГрупповогоИзмененияРеквизитов",
		ПараметрыФормы, ЭтотОбъект,,,, ОбработкаЗавершения);
	
КонецПроцедуры

