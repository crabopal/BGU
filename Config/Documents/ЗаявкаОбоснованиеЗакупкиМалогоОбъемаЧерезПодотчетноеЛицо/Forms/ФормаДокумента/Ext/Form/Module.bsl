&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	
	УстановитьДоступностьРеквизитов(ЭтотОбъект);
	
	ОрганизацииСовпадают = Не ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
		ИЛИ Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	
	ВыдачаДенежныхДокументов = Форма.Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ФинансовоеОбеспечениеПроверитьНаличиеЛБО", "Видимость", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиНоменклатура", "Видимость", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиФинансовыйГод", "Видимость", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиНаличиеЛБО", "Видимость", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиСпособОбеспечения", "Видимость", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиПодобрать", "Видимость", ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиДенежныйДокумент", "Видимость", ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СведенияОМалойЗакупке", "Видимость", НЕ ВыдачаДенежныхДокументов);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитов(Форма)
	
	БезналичноеПеречислениеДенежныхСредств = Форма.Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Безналичными");
	ВыдачаДенежныхДокументов = Форма.Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СчетДляПеречисленияДенежныхСредств", "Доступность", БезналичноеПеречислениеДенежныхСредств);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиНаименование", "ТолькоПросмотр", НЕ ВыдачаДенежныхДокументов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиДополнительнаяИнформация", "ТолькоПросмотр", ВыдачаДенежныхДокументов); 
		
	// В соответствии Письмом Минфина России от 30.07.2024 N 02-06-06/70843 Заявка-обоснование закупки товаров, работ, 
	// услуг малого объема через подотчетное лицо (ф.0510121) при выдаче в подотчет денежных документов:
	// "в графе 1 - код вида денежного документа в соответствии с "Общероссийским классификатором продукции по видам 
	// экономической деятельности" (ОКПД2) (поле не обязательное для заполнения);"	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ТоварыРаботыУслугиОКПД", "АвтоотметкаНезаполненного", НЕ ВыдачаДенежныхДокументов);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьКФОпоУмолчанию();
	
	УстановитьОтветственныхЛиц(Объект.Руководитель, Объект.ОтветственныйФинЭкономПодразделения,
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	ОтветственныйФинЭкономПодразделения = Объект.ОтветственныйФинЭкономПодразделения;
	
	ВыдачаДенежныхДокументов = Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	
	Если ВыдачаДенежныхДокументов Тогда
		Объект.ОтветственныйФинЭкономПодразделения = "";
	КонецЕсли;
	
	Если Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение Тогда
		ОрганизацииСовпадают = Истина;
	ИначеЕсли ОрганизацииСовпадают Тогда
		Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация;
		УстановитьОтветственныхЛицОбеспечение(Объект.РуководительОрганизацииОсуществляющейОбеспечение,
			Объект.ОрганизацияОсуществляющаяОбеспечение, Объект.Дата);
	КонецЕсли;
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьКФОпоУмолчанию();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Руководитель, РуководительФЭП, Организация, Дата, Подразделение)
	
