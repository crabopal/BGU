КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСведенияОМалойЗакупке

&НаКлиенте
Процедура СведенияОМалойЗакупкеСпособЗакупкиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СведенияОМалойЗакупке.ТекущиеДанные;
	
	СпособЗакупкиЭлектронно = ТекущиеДанные.СпособЗакупки = ПредопределенноеЗначение("Перечисление.СпособыЗакупки.Электронно");
	
	Если НЕ СпособЗакупкиЭлектронно Тогда
		ТекущиеДанные.ДатаДокументаОбОсуществленииЗакупки = "";
		ТекущиеДанные.НомерДокументаОбОсуществленииЗакупки = "";
		ТекущиеДанные.СтатусЗакупки = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыЗадолженность

&НаКлиенте
Процедура ЗадолженностьСуммаНаПроверкеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	
	Курс = ?(ТекущиеДанные.Сумма = 0, 1, ТекущиеДанные.СуммаРуб / ТекущиеДанные.Сумма);
	
	ТекущиеДанные.СуммаНаПроверкеРуб = ТекущиеДанные.СуммаНаПроверке * Курс;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьСуммаПросроченнаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	
	Курс = ?(ТекущиеДанные.Сумма = 0, 1, ТекущиеДанные.СуммаРуб / ТекущиеДанные.Сумма);
	
	ТекущиеДанные.СуммаПросроченнаяРуб = ТекущиеДанные.СуммаПросроченная * Курс;
	
КонецПроцедуры

