		"Руководитель", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	РуководительФЭП = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель ПФС", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛицОбеспечение(Руководитель, Организация, Дата)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаКлиенте
Функция НеЗаполненРеквзитВТаблицеОбъекта(ИмяТЧ, ИмяРеквизита, ПредставлениеРеквизита)
	
	Отказ = Ложь;
	
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		
		Если ЗначениеЗаполнено(Строка[ИмяРеквизита]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексСтроки = Объект[ИмяТЧ].Индекс(Строка);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В строке %1 не заполнен %2'"),
			ИндексСтроки + 1, ПредставлениеРеквизита);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ТекстСообщения,
			,
			"Объект."+ИмяТЧ+"["+ИндексСтроки+"]."+ИмяРеквизита,
			,
			Отказ);
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаличиеОбъемаФОНаСервере()
	
	ЭтоКазенноеУчреждение = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение;
	
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		Строка.НаличиеОбъемаФинансовогоОбеспечения =
			ПредопределенноеЗначение("Перечисление.ПризнакиНаличияОбъемаФОНаЗакупку.НетТребуетсяВнесениеИзменения");
	КонецЦикла;
	
	// По каждому финансовому году будет выполнен отдельный запрос
	Года = Объект.ТоварыРаботыУслуги.Выгрузить().ВыгрузитьКолонку("ФинансовыйГод");
	Года = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Года);
	
	Для Каждого Год Из Года Цикл
		
		Если Не ЗначениеЗаполнено(Год) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Год < Год(Объект.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		КодСчета = Строка(Год - Год(Объект.Дата) + 1);
		Если ЭтоКазенноеУчреждение Тогда
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("501."+КодСчета+"3");
		Иначе
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("506."+КодСчета+"0");
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) КАК КоличествоКЭК,
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) КАК КЭК,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК ОстатокФО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) = 1 И
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) = &КЭК000";
		
		Запрос.УстановитьПараметр("ДатаОстатков",
			?(Объект.Ссылка.Пустая(), ТекущаяДатаСеанса(), Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая)));
		Запрос.УстановитьПараметр("СчетЛБО", СчетаФинансирование);
		Запрос.УстановитьПараметр("Организация",
			?(ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение), Объект.ОрганизацияОсуществляющаяОбеспечение, Объект.Организация));
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование)
			И (НЕ ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
			ИЛИ Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация) Тогда
			Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Запрос.УстановитьПараметр("РазделЛицевогоСчета", Объект.РазделЛицевогоСчета);
		Запрос.УстановитьПараметр("КЭК000", БухгалтерскийУчетПовтИсп.КЭКПоКоду("000"));
		
		ЛБОсДетализациейПоКЭК = Запрос.Выполнить().Пустой();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК ОстатокФО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки";
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если НЕ БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Если НЕ ЛБОсДетализациейПоКЭК Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,", "");
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
			
			Если Строка.ФинансовыйГод <> Год Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЛБОсДетализациейПоКЭК Тогда
				Отбор = Новый Структура("КФО, КПС, КЭК", Строка.КФО, Строка.КПС, Строка.КЭК);
			Иначе
				Отбор = Новый Структура("КФО, КПС", Строка.КФО, Строка.КПС);
			КонецЕсли;
			
			Строки = Результат.НайтиСтроки(Отбор);
			Если Строки.Количество() > 0 Тогда
				Если Строки[0].ОстатокФО >= Строка.Сумма Тогда
					Строка.НаличиеОбъемаФинансовогоОбеспечения =
						ПредопределенноеЗначение("Перечисление.ПризнакиНаличияОбъемаФОНаЗакупку.Да");
				КонецЕсли;
				Строки[0].ОстатокФО = Строки[0].ОстатокФО - Строка.Сумма;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЗадолженностьНаСервере()
	
	Объект.Задолженность.Очистить();
	
	ВыборкаЗадолженностьПоВалютам = РасчетыСПодотчетнымиЛицами.ЗадолженностьСотрудникаНаДатуПоВалютам(
		Объект.Организация, Объект.ИФО, Объект.ПодотчетноеЛицо, Объект.Дата);
	
	Пока ВыборкаЗадолженностьПоВалютам.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.Задолженность.Добавить(), ВыборкаЗадолженностьПоВалютам);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДопустимуюБюджетнуюКлассификацию()
	
	ЗаполнитьКФОпоУмолчанию();
	
	ДопустимыеКОСГУ.ЗагрузитьЗначения(БухгалтерскийУчет.СписокКЭК("200, 300"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыРасходовКРБ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ
	|ГДЕ
	|	ВидыРасходовКРБ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВидыРасходовКРБ.Ссылка КАК Ссылка
	|			ИЗ
	|				Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ
	|			ГДЕ
	|				ВидыРасходовКРБ.Код = &Код200)";
	Запрос.УстановитьПараметр("Код200", "200");
	ДопустимыеВидыРасходовКРБ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКФОпоУмолчанию()
	
	КФОпоУмолчанию = "";
	Для Каждого КФО Из БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Объект.Организация, Объект.ИФО, Объект.Дата) Цикл
		Если КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет") Тогда
			КФОпоУмолчанию = КФО;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.ТоварыРаботыУслуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура СпособВыдачиДенежныхСредствПриИзмененииНаКлиенте()
	
	БезналичноеПеречислениеДенежныхСредств = Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.Безналичными");
	
	ВыдачаДенежныхДокументов = Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	
	Если НЕ БезналичноеПеречислениеДенежныхСредств Тогда
		Объект.СчетДляПеречисленияДенежныхСредств = "";
	КонецЕсли;
	
	Если ВыдачаДенежныхДокументов Тогда
		Объект.ОтветственныйФинЭкономПодразделения = "";
	Иначе
		Объект.ОтветственныйФинЭкономПодразделения = ОтветственныйФинЭкономПодразделения;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		ЗаполнитьРеквизитыСтроки(Строка, ЭтотОбъект);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыСтроки(СтрокаТаблицы, Форма)
	
	ВыдачаДенежныхДокументов = Форма.Объект.СпособВыдачиДенежныхСредств =
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы");
	
	Если ВыдачаДенежныхДокументов Тогда
		СтрокаТаблицы.ФинансовыйГод = "";
		СтрокаТаблицы.НаличиеОбъемаФинансовогоОбеспечения = "";
		СтрокаТаблицы.ДополнительнаяИнформация = НСтр("ru = 'денежные документы'");
		СтрокаТаблицы.СпособОбеспечения = "";
	Иначе
		СтрокаТаблицы.ФинансовыйГод = Год(Форма.Объект.Дата);
		Если СтрокаТаблицы.ДополнительнаяИнформация = НСтр("ru = 'денежные документы'") Тогда
			СтрокаТаблицы.ДополнительнаяИнформация = "";
		КонецЕсли;
		СтрокаТаблицы.СпособОбеспечения =
			ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.КФОпоУмолчанию) Тогда
		СтрокаТаблицы.КФО = Форма.КФОпоУмолчанию;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НаименованиеОКПД(ОКПД)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОКПД, "НаименованиеПолное");
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокиПослеПодбора(АдресДанныхВХранилище)
	
	ТаблицаПодобранных = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
	
	Для Каждого ПодобраннаяСтрока Из ТаблицаПодобранных Цикл
		
		РеквизитыВидаДД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ПодобраннаяСтрока.ВидДенежногоДокумента, "Наименование, ОКП");
			
		РеквизитыДД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ПодобраннаяСтрока.ДенежныйДокумент, "Наименование, ЕдиницаИзмерения");
		
		НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
		НоваяСтрока.ОКПД = РеквизитыВидаДД.ОКП;
		НоваяСтрока.Наименование = РеквизитыВидаДД.Наименование;
		НоваяСтрока.ИндивидуальнаяХарактеристика = РеквизитыДД.Наименование;
		НоваяСтрока.ДенежныйДокумент = ПодобраннаяСтрока.ДенежныйДокумент;
		НоваяСтрока.ЕдиницаИзмерения = РеквизитыДД.ЕдиницаИзмерения;
		НоваяСтрока.Количество = ПодобраннаяСтрока.Количество;
		НоваяСтрока.Сумма = ПодобраннаяСтрока.Сумма;
		
		ЗаполнитьРеквизитыСтроки(НоваяСтрока, ЭтотОбъект);
		
	КонецЦикла;
	
	Если ТаблицаПодобранных.Количество() > 0 И НЕ Модифицированность Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменениеРеквизитовСтрок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Идентификатор Из Элементы.ТоварыРаботыУслуги.ВыделенныеСтроки Цикл
		ТекСтрока = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(Идентификатор);
		ЗаполнитьЗначенияСвойств(ТекСтрока, Результат);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЕдинственныйРазделЛицевогоСчета()
	
	КФОВТаблице = Новый Соответствие;
	Для Каждого Строка из Объект.ТоварыРаботыУслуги Цикл
		Если ЗначениеЗаполнено(Строка.КФО) Тогда
			КФОВТаблице.Вставить(Строка.КФО, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если КФОВТаблице.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивКФО = Новый Массив;
	Для Каждого КФО Из КФОВТаблице Цикл
		МассивКФО.Добавить(КФО.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РазделыЛицевыхСчетовДопустимыеКФО.КФО) КАК КоличествоПодходящихКФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец.Владелец = &Организация
	|	И РазделыЛицевыхСчетовДопустимыеКФО.КФО В(&МассивКФО)
	|
	|СГРУППИРОВАТЬ ПО
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РазделыЛицевыхСчетовДопустимыеКФО.КФО) = &КоличествоКФО";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("МассивКФО", МассивКФО);
	Запрос.УстановитьПараметр("КоличествоКФО", МассивКФО.Количество());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Объект.РазделЛицевогоСчета = Выборка.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
		Пока Выборка.Следующий() Цикл
			Если Объект.РазделЛицевогоСчета = Выборка.Ссылка Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		// Если текущий раздел лицевого счета не подходит, то он очищается
		Объект.РазделЛицевогоСчета = "";
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Очищен раздел лицевого счета'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВСтроке(ТекущаяСтрока)
	
	Если Объект.СпособВыдачиДенежныхСредств <>
		ПредопределенноеЗначение("Перечисление.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы") Тогда
		Возврат;
	КонецЕсли;
	
	Цена = НоминальнаяСтоимостьДенежногоДокумента(ТекущаяСтрока.ДенежныйДокумент);
	
	Если ЗначениеЗаполнено(Цена) Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * Цена;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НоминальнаяСтоимостьДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДенежныйДокумент, "НомСтоимость");
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииДенежногоДокумента()
	
	ТекущаяСтрока = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	РеквизитыДД = РеквизитыДенежногоДокумента(ТекущаяСтрока.ДенежныйДокумент);
	
	ТекущаяСтрока.ОКПД = РеквизитыДД.ВладелецОКП;
	ТекущаяСтрока.Наименование = РеквизитыДД.ВладелецНаименование;
	ТекущаяСтрока.ИндивидуальнаяХарактеристика = РеквизитыДД.Наименование;
	ТекущаяСтрока.ЕдиницаИзмерения = РеквизитыДД.ЕдиницаИзмерения;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * РеквизитыДД.НомСтоимость;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДенежныйДокумент,
		"Владелец.Наименование, Владелец.ОКП, Наименование, ЕдиницаИзмерения, НомСтоимость");
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииНоменклатуры()
	
	ТекущаяСтрока = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	РеквизитыДД = РеквизитыДенежногоДокумента(ТекущаяСтрока.ДенежныйДокумент);
	
	РеквизитыНоменклатуры = РеквизитыНоменклатуры(ТекущаяСтрока.Номенклатура);
	
	ТекущаяСтрока.ОКПД = РеквизитыНоменклатуры.ОКП;
	ТекущаяСтрока.Наименование = РеквизитыНоменклатуры.ОКПНаименованиеПолное;
	ТекущаяСтрока.ИндивидуальнаяХарактеристика = РеквизитыНоменклатуры.Сведения;
	ТекущаяСтрока.ЕдиницаИзмерения = РеквизитыНоменклатуры.ЕдиницаИзмерения;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Номенклатура)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"ЕдиницаИзмерения, Сведения, ОКП, ОКП.НаименованиеПолное");
	
КонецФункции

