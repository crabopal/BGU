#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнвентаризацияСервер.УстановитьДатуИнвентаризации(ДанныеЗаполнения, ЭтотОбъект);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияМЗ.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ЭтотОбъект, НастройкиМеханизма, ДанныеЗаполнения);
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ТипДанныхЗаполнения = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("СписокНоменклатуры") Тогда
		
		ЗаполнитьИнвентаризациюСОтборомПоНоменклатуре(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	НепроверяемыеРеквизиты.Добавить("Материалы.Счет");
	НепроверяемыеРеквизиты.Добавить("Материалы.КФО");
	НепроверяемыеРеквизиты.Добавить("Материалы.КПС");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ЭтотОбъект, Отказ);
	
	НастройкиГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьНастройкиГруппСчетов(ЭтотОбъект, Ложь);
	
	СвойстваВыбраннойГруппыСчетов = НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"];
	
	// Запоминаем полученные настройки для использования в событии ПередЗаписью
	ДополнительныеСвойства.Вставить("СвойстваВыбраннойГруппыСчетов", СвойстваВыбраннойГруппыСчетов);
	
	ГруппаСчетовПоддерживается = НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"]["Поддерживается"];
	
	Если НЕ ГруппаСчетовПоддерживается Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Указанная группа счетов учета не поддерживается документом в настоящее время'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ЭтотОбъект["Ссылка"],
			,
			"Объект.СчетГруппа");
			
		// Выходим, дальнейшие проверки не выполняем
		Возврат;
	КонецЕсли;
	
	// Есть дубли номенклатуры в таблице Материалы?
	Если Документы.ИнвентаризацияМЗ.ЕстьОшибкиЗаполненияТаблицыМатериалы(ЭтотОбъект, СвойстваВыбраннойГруппыСчетов) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьЗаполнениеПолногоСчетаВТабличнойЧасти(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Перем СвойстваВыбраннойГруппыСчетов;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ДополнительныеСвойства.Свойство("СвойстваВыбраннойГруппыСчетов", СвойстваВыбраннойГруппыСчетов) Тогда
		НастройкиГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьНастройкиГруппСчетов(ЭтотОбъект, Ложь);
		
		СвойстваВыбраннойГруппыСчетов = НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"];
	КонецЕсли;
	
	// Удаляем неиспользуемые строки из служебных табличных частей, которые не видны на форме,
	// и которые пользователь не может отредактировать вручную
	Документы.ИнвентаризацияМЗ.УдалитьНеиспользуемыеСтрокиВНевидимыхТаблЧастях(ЭтотОбъект, СвойстваВыбраннойГруппыСчетов);
	
	// Удаляем неиспользуемые реквизиты для текущего варианта использования описи
	ИнвентаризацияСервер.ВариантФормированияОписи0504087_ОчиститьНеиспользуемыеРеквизиты(ЭтотОбъект);
	
	МаксимальноеКоличествоСтрок = 99999;
	
	Если ЭтотОбъект.Материалы.Количество() <= МаксимальноеКоличествоСтрок И ЭтотОбъект.Остатки.Количество() > МаксимальноеКоличествоСтрок Тогда
		КоличествоСтрок = ЭтотОбъект.Остатки.Количество();
		
		НомерПервойУдаляемойСтроки = МаксимальноеКоличествоСтрок + 1;
		
		Для Счетчик = НомерПервойУдаляемойСтроки По КоличествоСтрок Цикл
			ЭтотОбъект.Остатки.Удалить(НомерПервойУдаляемойСтроки - 1);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Прослеживаемость.ВедетсяУчетПрослеживаемыхТоваров(Дата) Тогда
		ПрослеживаемостьБГУ.ЗарегистрироватьПрослеживаемыйТовар(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПрослеживаемостьБГУ.УдалениеПроведенияПервичногоДокумента(Ссылка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИнвентаризациюСОтборомПоНоменклатуре(ДанныеЗаполнения)
	
	Дата         = ДанныеЗаполнения.Дата;
	Организация  = ДанныеЗаполнения.Организация;
	ЦМО          = ДанныеЗаполнения.ЦМО;
	ГруппаСчетов = ДанныеЗаполнения.ГруппаСчетов;
	ВариантФормированияОписи = 1;
	
	ДатаИнвентаризации = Дата;
	ДатаНачала         = Дата;
	ДатаОкончания      = Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&ГруппаСчетов)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)";
	Запрос.УстановитьПараметр("ГруппаСчетов", ГруппаСчетов);
	СчетаОстатков = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ПараметрыОтбора = Документы.ИнвентаризацияМЗ.ПараметрыНакладываемогоОтбора_Пустая();
	ПараметрыОтбора.ЗначенияДляОтбораПоМОЛ.Добавить(ЦМО);
	ПараметрыОтбора.СчетаОстатков = СчетаОстатков;
	ПараметрыОтбора.ЗначенияДляОтбораПоНоменклатуре = ДанныеЗаполнения.СписокНоменклатуры;
	Документы.ИнвентаризацияМЗ.ЗаполнитьОбъектПоДаннымУчета(ЭтотОбъект, ПараметрыОтбора);
	
	ТаблицаТоваров = ЭтотОбъект.Материалы.Выгрузить(, "Номенклатура,КоличествоУчет,СуммаУчет");
	ТаблицаТоваров.Колонки.Найти("КоличествоУчет").Имя = "Количество";
	ТаблицаТоваров.Колонки.Найти("СуммаУчет").Имя = "Сумма";
	ЭтотОбъект.ПрослеживаемыеТовары.Загрузить(ТаблицаТоваров);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли