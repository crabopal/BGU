	|////////////////////////////////////////////////////////////////////////////////
	|// [13]. Потенциальные субконто для МОЛ,
	|//		определяется для Потенциально допустимых счетов
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	НомерГруппы		КАК НомерГруппы,
	|	ВидСубконто		КАК ВидСубконто
	|ИЗ
	|	ПотенциальныеCубконтоДляМОЛ
	|ИТОГИ
	|ПО
	|	НомерГруппы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [14]. Количество Потенциальных субконто для МОЛ,
	|//		определяется для Потенциально допустимых счетов
	|//
	|ВЫБРАТЬ
	|	НомерГруппы				КАК НомерГруппы,
	|	КОЛИЧЕСТВО(ВидСубконто)	КАК КоличествоВозможныхЗначений
	|ПОМЕСТИТЬ
	|	КоличествоПотенциальныхCубконтоДляМОЛ
	|ИЗ
	|	ПотенциальныеCубконтоДляМОЛ
	|СГРУППИРОВАТЬ ПО
	|	НомерГруппы
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерГруппы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [15]. Потенциальные дополнительные субконто
	|//		определяется для Потенциально допустимых счетов
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыСубконтоПотенциальноДопустимыхСчетов.НомерГруппы	КАК НомерГруппы,
	|	ВидыСубконтоПотенциальноДопустимыхСчетов.ВидСубконто	КАК ВидСубконто
	|ИЗ
	|	ВидыСубконтоПотенциальноДопустимыхСчетов
	|	ЛЕВОЕ СОЕДИНЕНИЕ	КоличествоПотенциальныхCубконтоДляМОЛ
	|		ПО	ВидыСубконтоПотенциальноДопустимыхСчетов.НомерГруппы = КоличествоПотенциальныхCубконтоДляМОЛ.НомерГруппы
	|ГДЕ
	|	ВЫБОР
	|		КОГДА КоличествоПотенциальныхCубконтоДляМОЛ.КоличествоВозможныхЗначений ЕСТЬ NULL ТОГДА
	|			// Для группы вообще не нашлось возможных значений Субконто для МОЛ
	|			ИСТИНА
	|			
	|		КОГДА КоличествоПотенциальныхCубконтоДляМОЛ.КоличествоВозможныхЗначений = 1
	|			И ВидыСубконтоПотенциальноДопустимыхСчетов.ВидСубконто В (&ВидыСубконтоДляМОЛ) ТОГДА
	|			// Для группы нашлось 1 возможное значение Субконто для МОЛ
	|			ЛОЖЬ
	|			
	|		ИНАЧЕ
	|			// Для группы нашлось несколько (>1) возможных значений Субконто для МОЛ
	|			ИСТИНА
	|	КОНЕЦ
	|			
	|ИТОГИ
	|ПО
	|	НомерГруппы
	|;";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	// [7]. Допустимые счета и их признаки учета
	ВыборкаДопустимыеСчетаПоГруппировкам = РезультатыПоиска[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// [8]. Счета отбора = Основные счета групп + Допустимые счета + их родители
	ВыборкаСчетаОтбораПоГруппировкам = РезультатыПоиска[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// [9]. Свойства основных счетов групп
	ВыборкаСвойстваОсновныхСчетовГрупп = РезультатыПоиска[9].Выбрать();
	
	// [13]. Потенциальные субконто для МОЛ
	ВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам = РезультатыПоиска[13].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	// [15]. Потенциальные дополнительные субконто
	ВыборкаПотенциальныеДопСубконтоПоГруппировкам = РезультатыПоиска[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		НомерГруппы = СтрокаТаблицыНастроек["НомерГруппы"];
		
		// Продвигаемся в выборках
		Поиск = Новый Структура("НомерГруппы", НомерГруппы);
		ВыборкаДопустимыеСчетаПоГруппировкам.Сбросить();
		ВыборкаСчетаОтбораПоГруппировкам.Сбросить();
		ВыборкаСвойстваОсновныхСчетовГрупп.Сбросить();
		ВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам.Сбросить();
		ВыборкаПотенциальныеДопСубконтоПоГруппировкам.Сбросить();
		ЕстьВыборкаДопустимыеСчетаПоГруппировкам				= ВыборкаДопустимыеСчетаПоГруппировкам.НайтиСледующий(Поиск);
		ЕстьВыборкаСчетаОтбораПоГруппировкам					= ВыборкаСчетаОтбораПоГруппировкам.НайтиСледующий(Поиск);
		ВыборкаСвойстваОсновныхСчетовГрупп.НайтиСледующий(Поиск);
		ЕстьВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам	= ВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам.НайтиСледующий(Поиск);
		ЕстьВыборкаПотенциальныеДопСубконтоПоГруппировкам		= ВыборкаПотенциальныеДопСубконтоПоГруппировкам.НайтиСледующий(Поиск);
		
		//
		// Свойства допустимых счетов
		//
		СвойстваДопустимыхСчетов = Новый Структура();
		СвойстваДопустимыхСчетов.Вставить("УчетПоКПС",									Ложь);
		СвойстваДопустимыхСчетов.Вставить("УчетПоКЭК",									Ложь);
		СвойстваДопустимыхСчетов.Вставить("УчетПоПодразделениям",						Ложь);
		СвойстваДопустимыхСчетов.Вставить("ТаблицаАналитикиДопустимыхСчетов",		Неопределено);
		СвойстваДопустимыхСчетов.Вставить("РеальныеДополнительныеСубконто",				Новый Массив());
		СвойстваДопустимыхСчетов.Вставить("ТипыЗначенийРеальныхДополнительныхСубконто",	Новый Массив());
		
		//
		// Допустимые счета
		//
		ДопустимыеСчета = Новый Массив();
		Если ЕстьВыборкаДопустимыеСчетаПоГруппировкам Тогда
			
			// Сами допустимые счета
			Выборка = ВыборкаДопустимыеСчетаПоГруппировкам.Выбрать();
			Пока Выборка.Следующий() Цикл
				ДопустимыеСчета.Добавить(Выборка["Счет"]);
			КонецЦикла;
			
			// Свойства допустимых счетов
			ЗаполнитьЗначенияСвойств(СвойстваДопустимыхСчетов, ВыборкаДопустимыеСчетаПоГруппировкам);
		КонецЕсли;

		// Аналитика допустимых счетов
		Если ДляФормыРедактированияГруппСчетов = Ложь Тогда
			Аналитика = ПолучитьАналитикуДопустимыхСчетов(ДопустимыеСчета, СтрокаТаблицыНастроек["СубконтоДляМОЛ"]);
			СвойстваДопустимыхСчетов["ТаблицаАналитикиДопустимыхСчетов"]		= Аналитика["ТаблицаАналитикиДопустимыхСчетов"];
			СвойстваДопустимыхСчетов["РеальныеДополнительныеСубконто"]				= Аналитика["РеальныеДополнительныеСубконто"];
			СвойстваДопустимыхСчетов["ТипыЗначенийРеальныхДополнительныхСубконто"]	= ПолучитьТипыЗначений(СвойстваДопустимыхСчетов["РеальныеДополнительныеСубконто"]);
		КонецЕсли;
		
		//
		// Счета отбора
		//
		СчетаОтбора = Новый Массив();
		Если ЕстьВыборкаСчетаОтбораПоГруппировкам Тогда
			Выборка = ВыборкаСчетаОтбораПоГруппировкам.Выбрать();
			Пока Выборка.Следующий() Цикл
				СчетаОтбора.Добавить(Выборка["Счет"]);
			КонецЦикла;
		КонецЕсли;
		
		//
		// Свойства основного счета группы
		//
		СвойстваОсновногоСчетаГруппы = Новый Структура("
			|Код,
			|Наименование,
			|Предопределенный,
			|УчетПоКПС,
			|УчетПоКЭК,
			|УчетПоПодразделениям");
		ЗаполнитьЗначенияСвойств(СвойстваОсновногоСчетаГруппы, ВыборкаСвойстваОсновныхСчетовГрупп);
		
		//
		// Свойства потенциально допустимых счетов
		//
		СвойстваПотенциальноДопустимыхСчетов = Новый Структура();
		СвойстваПотенциальноДопустимыхСчетов.Вставить("ПотенциальныеСубконтоДляМОЛ",			Новый Массив());
		СвойстваПотенциальноДопустимыхСчетов.Вставить("ПотенциальныеДополнительныеСубконто",	Новый Массив());
		
		// Потенциальные субконто для МОЛ
		Если ЕстьВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам Тогда
			Выборка = ВыборкаПотенциальныеСубконтоДляМОЛПоГруппировкам.Выбрать();
			Пока Выборка.Следующий() Цикл
				СвойстваПотенциальноДопустимыхСчетов["ПотенциальныеСубконтоДляМОЛ"].Добавить(Выборка["ВидСубконто"]);
			КонецЦикла;
		КонецЕсли;
		
		// Потенциальные дополнительного субконто
		Если ЕстьВыборкаПотенциальныеДопСубконтоПоГруппировкам Тогда
			Выборка = ВыборкаПотенциальныеДопСубконтоПоГруппировкам.Выбрать();
			Пока Выборка.Следующий() Цикл
				СвойстваПотенциальноДопустимыхСчетов["ПотенциальныеДополнительныеСубконто"].Добавить(Выборка["ВидСубконто"]);
			КонецЦикла;
		КонецЕсли;
		
		//
		// Корректность указанных настроек дополнительного субконто
		//
		КорректностьНастроекДополнительногоСубконто = ПроверитьКорректностьНастроекДополнительногоСубконто(
			СтрокаТаблицыНастроек,
			СвойстваПотенциальноДопустимыхСчетов["ПотенциальныеДополнительныеСубконто"]);
			
		//
		// Свойства субконто для МОЛ
		//
		СвойстваСубконтоДляМОЛ = ПолучитьСвойстваСубконтоДляМОЛ(СтрокаТаблицыНастроек["СубконтоДляМОЛ"]);
		
		ДетальныеСвойства = Новый Структура();
		
		ДетальныеСвойства.Вставить("ДопустимыеСчета",						ДопустимыеСчета);//Новый ФиксированныйМассив(ДопустимыеСчета));
		ДетальныеСвойства.Вставить("СчетаОтбора",							СчетаОтбора);//Новый ФиксированныйМассив(СчетаОтбора));
		ДетальныеСвойства.Вставить("СвойстваДопустимыхСчетов",				СвойстваДопустимыхСчетов);//Новый ФиксированнаяСтруктура(СвойстваДопустимыхСчетов));
		ДетальныеСвойства.Вставить("СвойстваОсновногоСчетаГруппы",			СвойстваОсновногоСчетаГруппы);//Новый ФиксированнаяСтруктура(СвойстваОсновногоСчетаГруппы));
		ДетальныеСвойства.Вставить("СвойстваПотенциальноДопустимыхСчетов",	СвойстваПотенциальноДопустимыхСчетов);//Новый ФиксированнаяСтруктура(СвойстваПотенциальноДопустимыхСчетов));
		ДетальныеСвойства.Вставить("КорректностьНастроекДополнительногоСубконто",	КорректностьНастроекДополнительногоСубконто);//Новый ФиксированнаяСтруктура(КорректностьНастроекДополнительногоСубконто));
		ДетальныеСвойства.Вставить("СвойстваСубконтоДляМОЛ",				СвойстваСубконтоДляМОЛ);
		
		
		ДетальныеСвойстваВсехГруппСчетов.Вставить(НомерГруппы, ДетальныеСвойства);//Новый ФиксированнаяСтруктура(ДетальныеСвойства));
	КонецЦикла;
	
	Возврат ДетальныеСвойстваВсехГруппСчетов;
	
КонецФункции

Функция ПолучитьСвойстваСубконтоДляМОЛ(СубконтоДляМОЛ)
	
	ВидыСубконто = Новый Массив();
	
	Если ЗначениеЗаполнено(СубконтоДляМОЛ) Тогда
		ВидыСубконто.Добавить(СубконтоДляМОЛ);
		ТипыЗначений = ПолучитьТипыЗначений(ВидыСубконто);
	Иначе
		ТипыЗначений = Новый Массив();
	КонецЕсли;
	
	ТипыЗначенийДляПоляОтбора = Новый Массив();
	
	Если СубконтоДляМОЛ = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
		Заголовок = НСтр("ru='ЦМО'");
		
		ТипыЗначенийДляПоляОтбора.Добавить(Тип("СправочникСсылка.ЦМО"));
		ТипыЗначенийДляПоляОтбора.Добавить(Тип("СправочникСсылка.Сотрудники"));

	ИначеЕсли СубконтоДляМОЛ = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
		Заголовок = НСтр("ru='Контрагент'");
		
		ТипыЗначенийДляПоляОтбора.Добавить(Тип("СправочникСсылка.Контрагенты"));
		
	Иначе
		Заголовок = НСтр("ru='МОЛ'");
		
		ТипыЗначенийДляПоляОтбора = ТипыЗначений;
		
	КонецЕсли;
	
	Свойства = Новый Структура();
	Свойства.Вставить("ТипыЗначений",				ТипыЗначений);
	Свойства.Вставить("ТипыЗначенийДляПоляОтбора",	ТипыЗначенийДляПоляОтбора);
	Свойства.Вставить("Заголовок",					Заголовок);
	
	Возврат Свойства;
	
КонецФункции

Функция ПолучитьДетальныеСвойстваОднойГруппыСчетовПоНомеру(ТаблицаНастроек, НомерГруппы)
	
	ВремТаблица = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	НоваяСтрока = ВремТаблица.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаНастроек[НомерГруппы - 1]); 
	
	ДетальныеСвойства = ПолучитьДетальныеСвойстваВсехГруппСчетов(ВремТаблица);
	
	Возврат ДетальныеСвойства.Получить(НомерГруппы);
	
КонецФункции

Функция ПолучитьДетальныеСвойстваОднойГруппыСчетовПоСчету(ОсновнойСчетГруппы)
	
	ВремТаблица = ПолучитьПустуюТаблицуНастроекДляФормыРедактированияГруппСчетов();
	НоваяСтрока = ВремТаблица.Добавить();
	НомерГруппы = 1;
	НоваяСтрока["НомерГруппы"]			= НомерГруппы;
	НоваяСтрока["ОсновнойСчетГруппы"]	= ОсновнойСчетГруппы;
	
	ДетальныеСвойства = ПолучитьДетальныеСвойстваВсехГруппСчетов(ВремТаблица);
	
	Возврат ДетальныеСвойства.Получить(НомерГруппы);
	
КонецФункции

Функция ПроверитьКорректностьНастроекДополнительногоСубконто(СтрокаТаблицыНастроек, ПотенциальныеДополнительныеСубконто) Экспорт
	
	Перем	НастройкиКорректные,
			ОписаниеОшибки,
			СледуетИспользовать,
			СледуетИспользовать1Значение,
			СледуетИспользоватьНесколькоЗначений;
	
	НастройкиКорректные						= Истина;
	ОписаниеОшибки							= "";
	СледуетИспользовать						= Ложь;
	СледуетИспользовать1Значение			= Ложь;
	СледуетИспользоватьНесколькоЗначений	= Ложь;
	
	ИспользуетсяДополнительноеСубконто	= СтрокаТаблицыНастроек["ИспользуетсяДополнительноеСубконто"];
	ДополнительноеСубконто				= СтрокаТаблицыНастроек["ДополнительноеСубконто"];
	
	Если ИспользуетсяДополнительноеСубконто Тогда
		Если ЗначениеЗаполнено(ДополнительноеСубконто) Тогда
			// При явно указанном значении это значение должно быть в списке возможных
			
			ЗначениеВСписке = НЕ (ПотенциальныеДополнительныеСубконто.Найти(ДополнительноеСубконто) = Неопределено);
			
			Если ЗначениеВСписке Тогда
				СледуетИспользовать1Значение = Истина;
			Иначе
				НастройкиКорректные	= Ложь;
				ОписаниеОшибки		= НСтр("ru='Значение отсутствует в списке допустимых значений'");
			КонецЕсли;
			
		Иначе
			// Пустое значение допустимо лишь при нескольких возможных значениях
			
			КоличествоВозможныхЗначений = ПотенциальныеДополнительныеСубконто.Количество();
			
			Если КоличествоВозможныхЗначений = 0 Тогда
				НастройкиКорректные	= Ложь;
				ОписаниеОшибки		= НСтр("ru='Несогласованные значения настроек. Признак использования установлен, а значение дополнительного субконто не заполнено'");
				
			ИначеЕсли КоличествоВозможныхЗначений = 1 Тогда
				НастройкиКорректные	= Ложь;
				ОписаниеОшибки		= НСтр("ru='Значение дополнительного субконто не заполнено'");
				
			Иначе
				СледуетИспользоватьНесколькоЗначений = Истина;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		// Дополнительное субконто не используется
		
		Если ЗначениеЗаполнено(ДополнительноеСубконто) Тогда
			НастройкиКорректные	= Ложь;
			ОписаниеОшибки		= НСтр("ru='Несогласованные значения настроек. Признак использования сброшен, а значение дополнительного субконто указано'");
		КонецЕсли;
		
	КонецЕсли;
	
	СледуетИспользовать = (СледуетИспользовать1Значение ИЛИ СледуетИспользоватьНесколькоЗначений);
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("НастройкиКорректные",					НастройкиКорректные);
	РезультатПроверки.Вставить("ОписаниеОшибки",						ОписаниеОшибки);
	РезультатПроверки.Вставить("СледуетИспользовать",					СледуетИспользовать);
	РезультатПроверки.Вставить("СледуетИспользовать1Значение",			СледуетИспользовать1Значение);
	РезультатПроверки.Вставить("СледуетИспользоватьНесколькоЗначений",	СледуетИспользоватьНесколькоЗначений);
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция ПолучитьАналитикуДопустимыхСчетов(ДопустимыеСчета, ВидСубконтоДляМОЛ)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоНоменклатура",	ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоДляМОЛ",			ВидСубконтоДляМОЛ);
	ЗапросПоиск.УстановитьПараметр("ДопустимыеСчета",			ДопустимыеСчета);
	ЗапросПоиск.УстановитьПараметр("ПустойВидСубконто",			ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Признаки учета допустимых счетов
	|//
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка				КАК Счет,
	|	ЕПСБУ.УчетПоКПС				КАК УчетПоКПС,
	|	ЕПСБУ.УчетПоКЭК				КАК УчетПоКЭК,
	|	ЕПСБУ.УчетПоПодразделениям	КАК УчетПоПодразделениям
	|ПОМЕСТИТЬ
	|	ПризнакиУчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ	КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&ДопустимыеСчета)
	|ИНДЕКСИРОВАТЬ ПО
	|	ЕПСБУ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Виды субконто допустимых счетов (может быть более 1 значения для счета)
	|//
	|ВЫБРАТЬ
	|	ПризнакиУчета.Счет				КАК Счет,
	|	ЕПСБУВидыСубконто.ВидСубконто	КАК ВидСубконто,
	|	ЕПСБУВидыСубконто.НомерСтроки	КАК НомерСубконто
	|ПОМЕСТИТЬ
	|	ВидыСубконто
	|ИЗ
	|	ПризнакиУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПланСчетов.ЕПСБУ.ВидыСубконто	КАК ЕПСБУВидыСубконто
	|		ПО	ПризнакиУчета.Счет = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	НЕ ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоНоменклатура
	|	И НЕ ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоДляМОЛ
	|ИНДЕКСИРОВАТЬ ПО
	|	ПризнакиУчета.Счет,
	|	ЕПСБУВидыСубконто.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Выбираем один вид субконто для каждого счета
	|//
	|ВЫБРАТЬ
	|	Счет					КАК Счет,
	|	МИНИМУМ(НомерСубконто)	КАК НомерСубконто
	|ПОМЕСТИТЬ
	|	ВыбранныеНомераСубконто
	|ИЗ
	|	ВидыСубконто
	|СГРУППИРОВАТЬ ПО
	|	Счет
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	НомерСубконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (подготовка) Аналитика допустимых счетов
	|//
	|ВЫБРАТЬ
	|	ПризнакиУчета.Счет										КАК Счет,
	|	ПризнакиУчета.УчетПоКПС									КАК УчетПоКПС,
	|	ПризнакиУчета.УчетПоКЭК									КАК УчетПоКЭК,
	|	ПризнакиУчета.УчетПоПодразделениям						КАК УчетПоПодразделениям,
	|	ЕСТЬNULL(ВидыСубконто.ВидСубконто, &ПустойВидСубконто)	КАК ВидСубконто,
	|	ЕСТЬNULL(ВыбранныеНомераСубконто.НомерСубконто, 0)		КАК НомерСубконто
	|ПОМЕСТИТЬ
	|	АналитикаДопустимыхСчетов
	|ИЗ
	|	ПризнакиУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ВыбранныеНомераСубконто
	|		ПО	ПризнакиУчета.Счет			= ВыбранныеНомераСубконто.Счет
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ВидыСубконто
	|		ПО	ВыбранныеНомераСубконто.Счет			= ВидыСубконто.Счет
	|		И	ВыбранныеНомераСубконто.НомерСубконто	= ВидыСубконто.НомерСубконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Аналитика допустимых счетов
	|//
	|ВЫБРАТЬ
	|	Счет					КАК Счет,
	|	ВидСубконто				КАК РеальноеДополнительноеСубконто,
	|	НомерСубконто			КАК НомерРеальногоДополнительногоСубконто,
	|	УчетПоКПС				КАК УчетПоКПС,
	|	УчетПоКЭК				КАК УчетПоКЭК,
	|	УчетПоПодразделениям	КАК УчетПоПодразделениям
	|ИЗ
	|	АналитикаДопустимыхСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Реальные дополнительные субконто
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидСубконто	КАК ВидСубконто
	|ИЗ
	|	АналитикаДопустимыхСчетов
	|ГДЕ
	|	НЕ ВидСубконто = &ПустойВидСубконто
	|;";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	// [4]. Аналитика допустимых счетов
	ТаблицаАналитикиДопустимыхСчетов = РезультатыПоиска[4].Выгрузить();
	
	// [5]. Реальные дополнительные субконто
	РеальныеДополнительныеСубконто = РезультатыПоиска[5].Выгрузить().ВыгрузитьКолонку("ВидСубконто");
	
	Аналитика = Новый Структура();
	Аналитика.Вставить("ТаблицаАналитикиДопустимыхСчетов",	ТаблицаАналитикиДопустимыхСчетов);
	Аналитика.Вставить("РеальныеДополнительныеСубконто",	РеальныеДополнительныеСубконто);
	
	Возврат Аналитика;
	
КонецФункции

Функция ПолучитьТипыЗначений(ВидыСубконто)
	
	МассивТипов = Новый Массив();
	
	Для Каждого ВидСубконто Из ВидыСубконто Цикл
		Для Каждого ТипЗначения Из ВидСубконто.ТипЗначения.Типы() Цикл
			ТипУжеДобавлен = НЕ (МассивТипов.Найти(ТипЗначения) = Неопределено);
			Если НЕ ТипУжеДобавлен Тогда
				МассивТипов.Добавить(ТипЗначения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивТипов;
	
КонецФункции

Процедура ЗаполнитьПустыеНаименованияГруппСчетов(ТаблицаНастроек)
	
	Поиск = Новый Структура("Наименование", "");
	
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// Выходим
		Возврат;
	КонецЕсли;
	
	МассивСчетов = ТаблицаНастроек.Скопировать(МассивСтрок, "ОсновнойСчетГруппы").ВыгрузитьКолонку("ОсновнойСчетГруппы");
	
	ЗапросСвойства = Новый Запрос();
	ЗапросСвойства.УстановитьПараметр("МассивСчетов", МассивСчетов);
	ЗапросСвойства.Текст = "
	|ВЫБРАТЬ
	|	ПланСчетовЕПСБУ.Ссылка			КАК Ссылка,
	|	ПланСчетовЕПСБУ.Код				КАК Код,
	|	ПланСчетовЕПСБУ.Наименование	КАК Наименование
	|ИЗ
	|	ПланСчетов.ЕПСБУ	КАК ПланСчетовЕПСБУ
	|ГДЕ
	|	Ссылка В (&МассивСчетов)
	|;";
	
	Выборка = ЗапросСвойства.Выполнить().Выбрать();
	
	Поиск = Новый Структура();
	
	Пока Выборка.Следующий() Цикл
		Поиск.Вставить("ОсновнойСчетГруппы", Выборка["Ссылка"]);
		
		СтрокаТаблицыНастроек = ТаблицаНастроек.НайтиСтроки(Поиск)[0];
		
		СтрокаТаблицыНастроек["Наименование"] = ОпределитьАвтоматическиНаименованиеГруппыСчетов(Выборка["Код"], Выборка["Наименование"]);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьПараметрыНакладываемогоОтбора(Форма)
	
	Перем	ИспользоватьУчетПоИФО,
			ИспользоватьУчетПоПодразделениям,
			НакладыватьОтборПоКФО,
			НакладыватьОтборПоИФО,
			НакладыватьОтборПоКПС,
			НакладыватьОтборПоПодразделению,
			НакладыватьОтборПоДополнительномуСубконто,
			СледуетИспользоватьДополнительноеСубконто,
			СчетаОстатков,
			ИсключенныеСчетаОстатков,
			ЗначенияДляОтбораПоМОЛ,
			ТаблицаРеальныхДополнительныхСубконто;
	
	ДокументОбъект						= Форма["Объект"];
	
	ТаблицаАналитикиДопустимыхСчетов	= Форма[ПолучитьИмяРеквизитаФормыТаблицаАналитикиДопустимыхСчетов()];
	ДетальныеСвойства					= Форма[ПолучитьИмяРеквизитаФормыСвойстваВыбраннойГруппыСчетов()]["ДетальныеСвойства"];
	СвойстваДопустимыхСчетов			= ДетальныеСвойства["СвойстваДопустимыхСчетов"];
	
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	
	НакладыватьОтборПоКФО						= ЗначениеЗаполнено(ДокументОбъект["КФО"]);
	
	НакладыватьОтборПоИФО						= ИспользоватьУчетПоИФО
													И НЕ ДокументОбъект["БезУчетаИФО"];
													
	НакладыватьОтборПоКПС						= СвойстваДопустимыхСчетов["УчетПоКПС"]
													И ЗначениеЗаполнено(ДокументОбъект["КПС"]);
													
	НакладыватьОтборПоПодразделению				= ИспользоватьУчетПоПодразделениям
													И СвойстваДопустимыхСчетов["УчетПоПодразделениям"]
													И ЗначениеЗаполнено(ДокументОбъект["Подразделение"]);
													
	СледуетИспользоватьДополнительноеСубконто	= ДетальныеСвойства["КорректностьНастроекДополнительногоСубконто"]["СледуетИспользовать"];
	
	НакладыватьОтборПоДополнительномуСубконто	= СледуетИспользоватьДополнительноеСубконто
													И ЗначениеЗаполнено(ДокументОбъект["Субконто3"]);
													
	
	СчетаОстатков								= Новый Массив();
	ИсключенныеСчетаОстатков					= Новый Массив();
	
	// Счет отбора сужает список проверяемых счетов
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Счет", ДокументОбъект["Счет"]);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&Счет)
	|;";
	
	ПотенциальныеСчетаОстатков = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// Таблица реальных дополнительных субконто - для Счетов остатков
	// Сведения по Исключаемым счетам в эту таблиццу не включаем
	ТаблицаРеальныхДополнительныхСубконто = ПолучитьПустуюТаблицуАналитикиДопустимыхСчетов();
	
	Для Каждого СтрокаТаблицы Из ТаблицаАналитикиДопустимыхСчетов Цикл
		ДопустимыйСчет = СтрокаТаблицы["Счет"];
		
		Если ПотенциальныеСчетаОстатков.Найти(ДопустимыйСчет) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НакладыватьОтборПоКПС И НЕ СтрокаТаблицы["УчетПоКПС"] Тогда
			ИсключенныеСчетаОстатков.Добавить(ДопустимыйСчет);
			Продолжить;
		КонецЕсли;
		
		Если НакладыватьОтборПоПодразделению И НЕ СтрокаТаблицы["УчетПоПодразделениям"] Тогда
			ИсключенныеСчетаОстатков.Добавить(ДопустимыйСчет);
			Продолжить;
		КонецЕсли;
		
		Если НакладыватьОтборПоДополнительномуСубконто Тогда
			ИсключитьЭтотСчет = Ложь;
			
			Если ЗначениеЗаполнено(СтрокаТаблицы["РеальноеДополнительноеСубконто"]) Тогда
				ПриведенноеЗначение = СтрокаТаблицы["РеальноеДополнительноеСубконто"].ТипЗначения.ПривестиЗначение(ДокументОбъект["Субконто3"]);
				
				Если НЕ ЗначениеЗаполнено(ПриведенноеЗначение) Тогда
					ИсключитьЭтотСчет = Истина;
				КонецЕсли;
			Иначе
				ИсключитьЭтотСчет = Истина;
			КонецЕсли;
			
			Если ИсключитьЭтотСчет Тогда
				ИсключенныеСчетаОстатков.Добавить(ДопустимыйСчет);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СчетаОстатков.Добавить(ДопустимыйСчет);
		
		НоваяСтрока = ТаблицаРеальныхДополнительныхСубконто.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	// Применяемые значения для отбора по МОЛ
	МОЛ = ДокументОбъект["ЦМО"];
	Если ТипЗнч(МОЛ) = Тип("СправочникСсылка.Сотрудники") Тогда
		// 1 Сотрудник -> N ЦМО,
		// ЦМО определяются для одной указанной организации из шапки документа
		// Может оказаться несколько значений
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("Сотрудник",		МОЛ);
		ЗапросПоиск.УстановитьПараметр("Организация",	ДокументОбъект["Организация"]);
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЦМО
		|ГДЕ
		|	Сотрудник = &Сотрудник
		|	И Владелец = &Организация
		|;";
		
		ЗначенияДляОтбораПоМОЛ = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Иначе
		// Используем только 1 указанное значение
		
		ЗначенияДляОтбораПоМОЛ = Новый Массив();
		ЗначенияДляОтбораПоМОЛ.Добавить(МОЛ);
	КонецЕсли;
	
	
	ПараметрыНакладываемогоОтбора = ПараметрыНакладываемогоОтбора_Пустая();
	
	ПараметрыНакладываемогоОтбора.ИспользоватьУчетПоИФО                     = ИспользоватьУчетПоИФО;
	ПараметрыНакладываемогоОтбора.ИспользоватьУчетПоПодразделениям          = ИспользоватьУчетПоПодразделениям;
	ПараметрыНакладываемогоОтбора.НакладыватьОтборПоКФО                     = НакладыватьОтборПоКФО;
	ПараметрыНакладываемогоОтбора.НакладыватьОтборПоИФО                     = НакладыватьОтборПоИФО;
	ПараметрыНакладываемогоОтбора.НакладыватьОтборПоКПС                     = НакладыватьОтборПоКПС;
	ПараметрыНакладываемогоОтбора.НакладыватьОтборПоПодразделению           = НакладыватьОтборПоПодразделению;
	ПараметрыНакладываемогоОтбора.НакладыватьОтборПоДополнительномуСубконто = НакладыватьОтборПоДополнительномуСубконто;
	ПараметрыНакладываемогоОтбора.СледуетИспользоватьДополнительноеСубконто = СледуетИспользоватьДополнительноеСубконто;
	ПараметрыНакладываемогоОтбора.СчетаОстатков                             = СчетаОстатков;
	ПараметрыНакладываемогоОтбора.ИсключенныеСчетаОстатков                  = ИсключенныеСчетаОстатков;
	ПараметрыНакладываемогоОтбора.ЗначенияДляОтбораПоМОЛ                    = ЗначенияДляОтбораПоМОЛ;
	ПараметрыНакладываемогоОтбора.ТаблицаРеальныхДополнительныхСубконто     = ТаблицаРеальныхДополнительныхСубконто;
	
	Возврат ПараметрыНакладываемогоОтбора;
	
КонецФункции

Функция ПараметрыНакладываемогоОтбора_Пустая() Экспорт

	ПараметрыНакладываемогоОтбора = Новый Структура;
	ПараметрыНакладываемогоОтбора.Вставить("ИспользоватьУчетПоИФО",                     Ложь);
