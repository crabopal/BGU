	|			И	ВЫБОР КОГДА &ИспользуетсяКолонкаЦМО ТОГДА		ОстаткиКУдалению.ЦМО = ПорядокСписания.ЦМО				ИНАЧЕ ИСТИНА КОНЕЦ
	|			И	ВЫБОР КОГДА &ИспользуетсяКолонкаКПС ТОГДА		ОстаткиКУдалению.КПС = ПорядокСписания.КПС				ИНАЧЕ ИСТИНА КОНЕЦ
	|			И	ВЫБОР КОГДА &ИспользуетсяКолонкаСчет ТОГДА		ОстаткиКУдалению.Счет = ПорядокСписания.Счет			ИНАЧЕ ИСТИНА КОНЕЦ
	|			И	ВЫБОР КОГДА &ИспользуетсяКолонкаСубконто3 ТОГДА	ОстаткиКУдалению.Субконто3 = ПорядокСписания.Субконто3	ИНАЧЕ ИСТИНА КОНЕЦ
	|	СГРУППИРОВАТЬ ПО
	|		ПорядокСписания.НомерСтроки
	|	)	КАК КоличествоСсылокНаОстатки
	|СГРУППИРОВАТЬ ПО
	|	НомерСтроки
	|ИМЕЮЩИЕ
	|	СУММА(КоличествоСтрокОстатков) = СУММА(КоличествоСтрокОстатковКУдалению)
	|	И СУММА(КоличествоСтрокОстатковКУдалению) > 0
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки УБЫВ // Строго по убыванию для дальнейшего корректного удаления
	|;";
	
	Результаты = ЗапросУдаление.ВыполнитьПакет();
	
	// [7]. Номера удаляемых строк в таблице Остатки
	Выборка = Результаты[7].Выбрать();
	ТаблЧасть = ДокументОбъект["Остатки"];
	Пока Выборка.Следующий() Цикл
		ИндексСтроки = Выборка["НомерСтроки"] - 1;
		ТаблЧасть.Удалить(ИндексСтроки);
	КонецЦикла;
	
	// [8]. Номера удаляемых строк в таблице ПорядокСписания
	Выборка = Результаты[8].Выбрать();
	ТаблЧасть = ДокументОбъект["ПорядокСписания"];
	Пока Выборка.Следующий() Цикл
		ИндексСтроки = Выборка["НомерСтроки"] - 1;
		ТаблЧасть.Удалить(ИндексСтроки);
	КонецЦикла;
	
КонецПроцедуры

