Процедура КэшироватьНастройкиНаФорму(Форма, НастройкиГруппСчетов)
	
	//
	// Таблица аналитики допустимых счетов выбранной группы счетов
	//
	ИмяРеквизитаФормы			= ПолучитьИмяРеквизитаФормыТаблицаАналитикиДопустимыхСчетов();	
	СвойстваДопустимыхСчетов	= НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"]["ДетальныеСвойства"]["СвойстваДопустимыхСчетов"];
	ТаблицаАналитики			= СвойстваДопустимыхСчетов["ТаблицаАналитикиДопустимыхСчетов"];
	Форма[ИмяРеквизитаФормы].Загрузить(ТаблицаАналитики);
	
	// Удаляем настройки, имеющие несовместимый с кэшированием тип значения
	СвойстваДопустимыхСчетов.Удалить("ТаблицаАналитикиДопустимыхСчетов");
	
	//
	// Структура свойств выбранной группы счетов
	//
	ИмяРеквизитаФормы				= ПолучитьИмяРеквизитаФормыСвойстваВыбраннойГруппыСчетов();
	СвойстваВыбраннойГруппыСчетов	= НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"];
	Форма[ИмяРеквизитаФормы] = СвойстваВыбраннойГруппыСчетов;
	
КонецПроцедуры

Функция ОпределитьАвтоматическиНаименованиеГруппыСчетов(КодСчета, НаименованиеСчета, ГруппаПоддерживается = Истина)
	
	НаименованиеШаблон	= "[Префикс][Код]: [Наименование]";
	
	ВставляемыеЗначения	= Новый Структура();
	
	Если ГруппаПоддерживается = Истина Тогда
		ВставляемыеЗначения.Вставить("Префикс",		"");
	Иначе
		ВставляемыеЗначения.Вставить("Префикс",		"(!) ");
	КонецЕсли;
	
	ВставляемыеЗначения.Вставить("Код",				КодСчета);
	ВставляемыеЗначения.Вставить("Наименование",	НаименованиеСчета);
	
	Возврат СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НаименованиеШаблон, ВставляемыеЗначения);
	
КонецФункции
	
Функция ПолучитьВидыСубконтоДляМОЛ()
	
	ВидыСубконтоДляМОЛ = Новый Массив();
	
	ВидыСубконтоДляМОЛ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ВидыСубконтоДляМОЛ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	Возврат ВидыСубконтоДляМОЛ;
	
КонецФункции

Функция ПолучитьОсновныеСвойстваОднойГруппыСчетовПоНомеру(ТаблицаНастроек, НомерГруппы)
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[НомерГруппы - 1];
	
	ОсновныеСвойства = ПолучитьПустуюСтруктуруОсновныхСвойств();
	
	ЗаполнитьЗначенияСвойств(ОсновныеСвойства, СтрокаТаблицыНастроек);
	
	Возврат ОсновныеСвойства;
	
КонецФункции

Функция	ПолучитьПустуюСтруктуруОсновныхСвойств()
	
	// Основные свойства - это описание группы счетов в таблице настроек
	
	ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	
	ОсновныеСвойства = Новый Структура();
	
	Для Каждого Колонка Из ТаблицаНастроек.Колонки Цикл
		ОсновныеСвойства.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Возврат ОсновныеСвойства;
	
КонецФункции

Функция ПолучитьИмяРеквизитаФормыТаблицаАналитикиДопустимыхСчетов()
	
	Возврат "НастройкиГруппСчетов_ТаблицаАналитикиДопустимыхСчетов";
	
КонецФункции

Функция ПолучитьИмяРеквизитаФормыСвойстваВыбраннойГруппыСчетов()
	
	Возврат "НастройкиГруппСчетов_СвойстваВыбраннойГруппыСчетов";
	
КонецФункции

Функция ПолучитьПустуюТаблицуНастроекГруппСчетов()
	
	ТипБулево		= Новый ОписаниеТипов("Булево");
	ТипСтрока		= Новый ОписаниеТипов("Строка");
	ТипЧисло		= Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(2,0,ДопустимыйЗнак.Неотрицательный));
	ТипВидСубконто	= Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	ТипСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипМассив		= Новый ОписаниеТипов("Массив");
	
	ТаблицаНастроек = Новый ТаблицаЗначений();
	
	ТаблицаНастроек.Колонки.Добавить("НомерГруппы",							ТипЧисло);
	ТаблицаНастроек.Колонки.Добавить("ГруппаСчетовПредопределенная",		ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ОсновнойСчетГруппы",					ТипСчет);
	ТаблицаНастроек.Колонки.Добавить("Наименование",						ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("СубконтоДляМОЛ",						ТипВидСубконто);
	ТаблицаНастроек.Колонки.Добавить("ИспользуетсяДополнительноеСубконто",	ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ДополнительноеСубконто",				ТипВидСубконто);
	ТаблицаНастроек.Колонки.Добавить("ЗаголовокДополнительногоСубконто",	ТипСтрока);
	
	ТаблицаНастроек.Колонки.Добавить("ОграниченияСчетовГруппы",				ТипМассив);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьПустуюТаблицуНастроекДляФормыРедактированияГруппСчетов()
	
	// Состав колонок должен совпадать со специфичными колонками в функции
	// ПолучитьСпецифичныеКолонкиТаблицыНастроекДляФормыРедактированияГруппСчетов
	
	ТипЧисло		= Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(2,0,ДопустимыйЗнак.Неотрицательный));
	ТипБулево			= Новый ОписаниеТипов("Булево");
	ТипФиксМассив	= Новый ОписаниеТипов("ФиксированныйМассив");
	//ТипСписокЗначений	= Новый ОписаниеТипов("СписокЗначений");
	
	ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	
	ТаблицаНастроек.Колонки.Добавить("ПотенциальныеДополнительныеСубконто", 	ТипФиксМассив);//ТипСписокЗначений);
	ТаблицаНастроек.Колонки.Добавить("ПотенциальныеСубконтоДляМОЛ",				ТипФиксМассив);//ТипСписокЗначений);
	ТаблицаНастроек.Колонки.Добавить("КоличествоПотенциальныхДополнительныхСубконто",	ТипЧисло);
	ТаблицаНастроек.Колонки.Добавить("КоличествоПотенциальныхСубконтоДляМОЛ",			ТипЧисло);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьПустуюТаблицуАналитикиДопустимыхСчетов()
	
	ТипБулево		= Новый ОписаниеТипов("Булево");
	ТипЧисло		= Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0,ДопустимыйЗнак.Неотрицательный));
	ТипСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипВидСубконто	= Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаАналитики = Новый ТаблицаЗначений();
	
	ТаблицаАналитики.Колонки.Добавить("Счет",									ТипСчет);
	ТаблицаАналитики.Колонки.Добавить("РеальноеДополнительноеСубконто",			ТипВидСубконто);
	ТаблицаАналитики.Колонки.Добавить("НомерРеальногоДополнительногоСубконто",	ТипЧисло);
	ТаблицаАналитики.Колонки.Добавить("УчетПоКПС",								ТипБулево);
	ТаблицаАналитики.Колонки.Добавить("УчетПоПодразделениям",					ТипБулево);
	
	Возврат ТаблицаАналитики;
	
КонецФункции

Функция ПолучитьСпецифичныеКолонкиТаблицыНастроекДляФормыРедактированияГруппСчетов()
	
	// Состав полей должен совпадать со специфичными колонками в функции
	// ПолучитьПустуюТаблицуНастроекДляФормыРедактированияГруппСчетов
	
	ПустойМассив = Новый Массив();
	
	СпецифичныеКолонки = Новый Структура();
	СпецифичныеКолонки.Вставить("ПотенциальныеДополнительныеСубконто",	Новый ФиксированныйМассив(ПустойМассив));//СписокЗначений());
	СпецифичныеКолонки.Вставить("ПотенциальныеСубконтоДляМОЛ",			Новый ФиксированныйМассив(ПустойМассив)); //СписокЗначений());
	СпецифичныеКолонки.Вставить("КоличествоПотенциальныхДополнительныхСубконто",	0);
	СпецифичныеКолонки.Вставить("КоличествоПотенциальныхСубконтоДляМОЛ",			0);
	
	Возврат СпецифичныеКолонки;
	
КонецФункции

Функция ПолучитьТаблицуНастроекГруппСчетов(ДокументОбъект, ДляФормыРедактированияГруппСчетов = Ложь) Экспорт
	
	Если ДляФормыРедактированияГруппСчетов = Истина Тогда
		ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекДляФормыРедактированияГруппСчетов();
	Иначе
		ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	КонецЕсли;
	
	// Предопределенные группы счетов
	ДобавитьНастройкиПредопределенныхГруппСчетов(ТаблицаНастроек, ДокументОбъект);
	
	// Пользовательские группы счетов
	ДобавитьНастройкиПользовательскихГруппСчетов(ТаблицаНастроек, ДокументОбъект);
	
	ЗаполнитьПустыеНаименованияГруппСчетов(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьТаблицуНастроекГруппСчетовДляВводаОстатковМЗ(НаДату, Организация = Неопределено) Экспорт
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("ДатаИнвентаризации", НаДату);
	ШапкаДокумента.Вставить("Организация", Организация);
	
	ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	
	ДобавитьНастройкиПредопределенныхГруппСчетов(ТаблицаНастроек, ШапкаДокумента);
	
	ДобавитьНастройкиПользовательскихГруппСчетов(ТаблицаНастроек, ШапкаДокумента);
	
	ТаблицаНастроек.Колонки.Добавить("НаДату", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	ТаблицаНастроек.ЗаполнитьЗначения(НаДату, "НаДату");
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьСписокВыбораГруппСчетов(ТаблицаНастроек)
	
	СписокВыбораГруппСчетов = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		СписокВыбораГруппСчетов.Добавить(
			СтрокаТаблицы["ОсновнойСчетГруппы"],
			СтрокаТаблицы["Наименование"]);
	КонецЦикла;
	
	Возврат СписокВыбораГруппСчетов;
	
КонецФункции

Процедура ДобавитьНастройкиПредопределенныхГруппСчетов(ТаблицаНастроек, ДокументОбъект = Неопределено)
	
	Перем НаДату;
	
	Если ДокументОбъект <> Неопределено И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДатаИнвентаризации") Тогда
		Если ЗначениеЗаполнено(ДокументОбъект.ДатаИнвентаризации) Тогда
			НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ВидСубконтоЦМО			= ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
	ВидСубконтоКонтрагенты	= ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	
