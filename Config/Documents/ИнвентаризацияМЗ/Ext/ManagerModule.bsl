		|	Счет										КАК Счет,
		|	КПС											КАК КПС,
		|	КФО											КАК КФО
		|ИЗ
		|	("
		
		+ ПолучитьТекстЗапросаСвернутыеОстаткиДляТаблицыМатериалы(
			ВариантФормированияОписи,
			ИспользоватьБалансовуюСтоимость)
			
		+ ")	КАК СвернутыеОстаткиПОВыбраннымЦМО
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Наименование
		|;";
		
	 	// [4Б]. Данные для заполнения таблицы Остатки (указанный тип цен)
		ИндексТаблицыОстатки = 4;
		
		// [5Б]. Данные для заполнения таблицы Материалы (указанный тип цен)
		ИндексТаблицыМатериалы = 5 + СдвигИндексаТаблицыМатериалы;
		
	КонецЕсли;
	
	ЗапросОстатки.Текст = ТекстЗапроса;
	
	Результаты = ЗапросОстатки.ВыполнитьПакет();
	
	// [2]. Данные для заполнения таблицы ПорядокСписания
	ДокументОбъект["ПорядокСписания"].Загрузить(Результаты[2].Выгрузить());
	
	// [Х1]. Данные для заполнения таблицы Материалы
	ТаблицаМатериалы = Результаты[ИндексТаблицыМатериалы].Выгрузить();
	
	ИменаКолонок = Неопределено;
	ИнвентаризацияСервер.Редактирование0504087_СоздатьКолонкиЧисловыхПоказателей(ТаблицаМатериалы, ДокументОбъект.Ссылка, ИменаКолонок);
	
	Если ВыбиратьНулевоеКоличество И ЗаменятьНулевоеКоличество Тогда
		ИнвентаризацияСервер.УстановитьКоличествоПоУмолчанию(
			ТаблицаМатериалы,
			ИменаКолонок,
			ИспользоватьБалансовуюСтоимость,
			ДокументОбъект["НеЗаполнятьЦену"],
			Истина);
	КонецЕсли;
	
	ИнвентаризацияСервер.Редактирование0504087_РассчитатьРасхождениеВТаблице(ТаблицаМатериалы, ИменаКолонок);
	
	ДокументОбъект["Материалы"].Загрузить(ТаблицаМатериалы);
	
 	// [Х2]. Данные для заполнения таблицы Остатки
	ТаблицаОстатки = Результаты[ИндексТаблицыОстатки].Выгрузить();
	
	Если ВыбиратьНулевоеКоличество И ЗаменятьНулевоеКоличество Тогда
		ИнвентаризацияСервер.УстановитьКоличествоПоУмолчанию(
			ТаблицаОстатки,
			ИменаКолонок);
	КонецЕсли;
	
	ДокументОбъект["Остатки"].Загрузить(ТаблицаОстатки);
	
КонецПроцедуры


Функция ПолучитьТекстЗапросаСвернутыеОстаткиДляТаблицыМатериалы(ВариантФормированияОписи, ИспользоватьБалансовуюСтоимость)
	
	// Заполненность полей счета определяется значением реквизита ВариантФормированияОписи
	
	Если ИспользоватьБалансовуюСтоимость Тогда
		// Балансовая стоимость
		
		Если ВариантФормированияОписи = 0 Тогда
			// Балансовая стоимость
			// 0. Опись до 2018 г. Счет в шапке
			// Выбираем: ничего
			
			Возврат "
				|ВЫБРАТЬ
				|	Субконто3					КАК Субконто3,
				|	Номенклатура				КАК Номенклатура,
				|	НЕОПРЕДЕЛЕНО				КАК Счет,
				|	НЕОПРЕДЕЛЕНО				КАК КПС,
				|	НЕОПРЕДЕЛЕНО				КАК КФО,
				|	СУММА(КоличествоУчет)		КАК КоличествоУчет,
				|	СУММА(СуммаУчетБалансовая)	КАК СуммаУчетБалансовая
				|ИЗ
				|	А_ОстаткиСОтборомПоМОЛ
				|СГРУППИРОВАТЬ ПО
				|	Субконто3,
				|	Номенклатура";
		
		ИначеЕсли ВариантФормированияОписи = 1 Тогда
			// Балансовая стоимость
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			// Выбираем: Счет, КПС, КФО
		
			Возврат "
				|ВЫБРАТЬ
				|	Субконто3					КАК Субконто3,
				|	Номенклатура				КАК Номенклатура,
				|	Счет						КАК Счет,
				|	КПС							КАК КПС,
				|	КФО							КАК КФО,
				|	СУММА(КоличествоУчет)		КАК КоличествоУчет,
				|	СУММА(СуммаУчетБалансовая)	КАК СуммаУчетБалансовая
				|ИЗ
				|	А_ОстаткиСОтборомПоМОЛ
				|СГРУППИРОВАТЬ ПО
				|	Субконто3,
				|	Номенклатура,
				|	Счет,
				|	КПС,
				|	КФО";
			
		ИначеЕсли ВариантФормированияОписи = 2 Тогда
			// Балансовая стоимость
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// Выбираем: Счет
			
			Возврат "
				|ВЫБРАТЬ
				|	Субконто3					КАК Субконто3,
				|	Номенклатура				КАК Номенклатура,
				|	Счет						КАК Счет,
				|	НЕОПРЕДЕЛЕНО				КАК КПС,
				|	НЕОПРЕДЕЛЕНО				КАК КФО,
				|	СУММА(КоличествоУчет)		КАК КоличествоУчет,
				|	СУММА(СуммаУчетБалансовая)	КАК СуммаУчетБалансовая
				|ИЗ
				|	А_ОстаткиСОтборомПоМОЛ
				|СГРУППИРОВАТЬ ПО
				|	Субконто3,
				|	Номенклатура,
				|	Счет";
			
		Иначе
			// Балансовая стоимость
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			// Выбираем: Счет
			
			Возврат "
				|ВЫБРАТЬ
				|	Субконто3							КАК Субконто3,
				|	А_ОстаткиСОтборомПоМОЛ.Номенклатура	КАК Номенклатура,
				|	БлижайшиеОбщиеРодителиСчетов.Счет	КАК Счет,
				|	НЕОПРЕДЕЛЕНО						КАК КПС,
				|	НЕОПРЕДЕЛЕНО						КАК КФО,
				|	СУММА(КоличествоУчет)				КАК КоличествоУчет,
				|	СУММА(СуммаУчетБалансовая)			КАК СуммаУчетБалансовая
				|ИЗ
				|	А_ОстаткиСОтборомПоМОЛ
				|	ЛЕВОЕ СОЕДИНЕНИЕ БлижайшиеОбщиеРодителиСчетов
				|		ПО	А_ОстаткиСОтборомПоМОЛ.Номенклатура = БлижайшиеОбщиеРодителиСчетов.НФА
				|СГРУППИРОВАТЬ ПО
				|	Субконто3,
				|	А_ОстаткиСОтборомПоМОЛ.Номенклатура,
				|	БлижайшиеОбщиеРодителиСчетов.Счет";
			
		КонецЕсли;
	
	Иначе
		// Указанный тип цен
		
		Если ВариантФормированияОписи = 0 Тогда
			// Указанный тип цен
			// 0. Опись до 2018 г. Счет в шапке
			// Выбираем: ничего
			
			Возврат "
				|ВЫБРАТЬ
				|	Остатки.Субконто3									КАК Субконто3,
				|	Остатки.Номенклатура								КАК Номенклатура,
				|	НЕОПРЕДЕЛЕНО										КАК Счет,
				|	НЕОПРЕДЕЛЕНО										КАК КПС,
				|	НЕОПРЕДЕЛЕНО										КАК КФО,
				|	СУММА(Остатки.КоличествоУчет)						КАК КоличествоУчет,
				|	ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена), 0)						КАК Цена,
				|	СУММА(Остатки.КоличествоУчет) * ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена),0)	КАК СуммаУчет
				|ИЗ
				|	ОстаткиСОтборомПоМОЛ	КАК Остатки
				|	ЛЕВОЕ СОЕДИНЕНИЕ	Б_ЦеныНоменклатуры	КАК Цены
				|		ПО	Остатки.Номенклатура = Цены.Номенклатура
				|СГРУППИРОВАТЬ ПО
				|	Остатки.Субконто3,
				|	Остатки.Номенклатура";
		
		ИначеЕсли ВариантФормированияОписи = 1 Тогда
			// Указанный тип цен
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			// Выбираем: Счет, КПС, КФО
		
			Возврат "
				|ВЫБРАТЬ
				|	Остатки.Субконто3									КАК Субконто3,
				|	Остатки.Номенклатура								КАК Номенклатура,
				|	Остатки.Счет										КАК Счет,
				|	Остатки.КПС											КАК КПС,
				|	Остатки.КФО											КАК КФО,
				|	СУММА(Остатки.КоличествоУчет)						КАК КоличествоУчет,
				|	ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена), 0)						КАК Цена,
				|	СУММА(Остатки.КоличествоУчет) * ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена),0)	КАК СуммаУчет
				|ИЗ
				|	ОстаткиСОтборомПоМОЛ	КАК Остатки
				|	ЛЕВОЕ СОЕДИНЕНИЕ	Б_ЦеныНоменклатуры	КАК Цены
				|		ПО	Остатки.Номенклатура = Цены.Номенклатура
				|СГРУППИРОВАТЬ ПО
				|	Остатки.Субконто3,
				|	Остатки.Номенклатура,
				|	Остатки.Счет,
				|	Остатки.КПС,
				|	Остатки.КФО";
			
		ИначеЕсли ВариантФормированияОписи = 2 Тогда
			// Указанный тип цен
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// Выбираем: Счет
			
			Возврат "
				|ВЫБРАТЬ
				|	Остатки.Субконто3									КАК Субконто3,
				|	Остатки.Номенклатура								КАК Номенклатура,
				|	Остатки.Счет										КАК Счет,
				|	НЕОПРЕДЕЛЕНО										КАК КПС,
				|	НЕОПРЕДЕЛЕНО										КАК КФО,
				|	СУММА(Остатки.КоличествоУчет)						КАК КоличествоУчет,
				|	ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена), 0)						КАК Цена,
				|	СУММА(Остатки.КоличествоУчет) * ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена),0)	КАК СуммаУчет
				|ИЗ
				|	ОстаткиСОтборомПоМОЛ	КАК Остатки
				|	ЛЕВОЕ СОЕДИНЕНИЕ	Б_ЦеныНоменклатуры	КАК Цены
				|		ПО	Остатки.Номенклатура = Цены.Номенклатура
				|СГРУППИРОВАТЬ ПО
				|	Остатки.Субконто3,
				|	Остатки.Номенклатура,
				|	Остатки.Счет";
			
		Иначе
			// Указанный тип цен
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			// Выбираем: Счет
			
			Возврат "
				|ВЫБРАТЬ
				|	Остатки.Субконто3									КАК Субконто3,
				|	Остатки.Номенклатура								КАК Номенклатура,
				|	БлижайшиеОбщиеРодителиСчетов.Счет					КАК Счет,
				|	НЕОПРЕДЕЛЕНО										КАК КПС,
				|	НЕОПРЕДЕЛЕНО										КАК КФО,
				|	СУММА(Остатки.КоличествоУчет)						КАК КоличествоУчет,
				|	ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена), 0)						КАК Цена,
				|	СУММА(Остатки.КоличествоУчет) * ЕСТЬNULL(СРЕДНЕЕ(Цены.Цена),0)	КАК СуммаУчет
				|ИЗ
				|	ОстаткиСОтборомПоМОЛ	КАК Остатки
				|	ЛЕВОЕ СОЕДИНЕНИЕ	Б_ЦеныНоменклатуры	КАК Цены
				|		ПО	Остатки.Номенклатура = Цены.Номенклатура
				|	ЛЕВОЕ СОЕДИНЕНИЕ БлижайшиеОбщиеРодителиСчетов
				|		ПО	Остатки.Номенклатура = БлижайшиеОбщиеРодителиСчетов.НФА
				|СГРУППИРОВАТЬ ПО
				|	Остатки.Субконто3,
				|	Остатки.Номенклатура,
				|	БлижайшиеОбщиеРодителиСчетов.Счет";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции


Процедура ЗаполнитьРасхождения(Форма, ЭтоНедостача) Экспорт
	
	ДокументОбъект = Форма["Объект"];
	
	ПараметрыНакладываемогоОтбора				= ОпределитьПараметрыНакладываемогоОтбора(Форма);
	СледуетИспользоватьДополнительноеСубконто	= ПараметрыНакладываемогоОтбора["СледуетИспользоватьДополнительноеСубконто"];
	
	ТаблицаОстатки		= ДокументОбъект["Остатки"].Выгрузить();
	ТаблицаРасхождения	= ПолучитьТаблицуРасхождений(ДокументОбъект["Материалы"], ЭтоНедостача);
		
	// Переименовываем колонки для дальнейшего сопоставления показателей
	// Приводим к именам, используемым в табличных частях Излишки/Недостачи 
	Если ЭтоНедостача Тогда
		ТаблицаРасхождения.Колонки.Найти("НедостачаКоличество").Имя	= "Количество";
		ТаблицаОстатки.Колонки.Найти("КоличествоУчет").Имя			= "Количество";
	Иначе
		ТаблицаРасхождения.Колонки.Найти("ИзлишекКоличество").Имя	= "Количество";
		ТаблицаОстатки.Колонки.Найти("КоличествоУчет").Имя			= "Количество";
		
		ТаблицаРасхождения.Колонки.Найти("ИзлишекСумма").Имя		= "Сумма";
		ТаблицаОстатки.Колонки.Найти("СуммаУчет").Имя				= "Сумма";
	КонецЕсли;
	
	// Показатели расхождения выражены неотрицательными числами,
	// а остатки могут быть отрицательными.
	// Сделаем все остатки также неотрицательными для корректного дальнейшего сопоставления.
	Для Каждого СтрокаТаблицы Из ТаблицаОстатки Цикл
		// Колонка Количество существует для обоих видов расхождений
		Если СтрокаТаблицы["Количество"] < 0 Тогда
			СтрокаТаблицы["Количество"] = -СтрокаТаблицы["Количество"];
		КонецЕсли;
		
		// Колонка Сумма существует только для излишков
		Если НЕ ЭтоНедостача И СтрокаТаблицы["Сумма"] < 0 Тогда
			СтрокаТаблицы["Сумма"] = -СтрокаТаблицы["Сумма"];
		КонецЕсли;
	КонецЦикла;
	
	ИменаКолонокСвязи = "Номенклатура";
	Если СледуетИспользоватьДополнительноеСубконто Тогда
		ИменаКолонокСвязи = ИменаКолонокСвязи + ", Субконто3";
	КонецЕсли;
	
	Если ЭтоНедостача Тогда
		// Недостачи
		ИменаКолонокПоказателей	= "Количество";
	Иначе
		// Излишки
		ИменаКолонокПоказателей = "Количество, Сумма";
	КонецЕсли;
	
	Если ЭтоНедостача Тогда
		// Недостачи заполняем с учетом таблицы "Порядок списания недостач"
		
		// Упорядочиваем остатки
		ПризнакиИспользованияКолонок = ПолучитьПризнакиИспользованияКолонокТаблицыПорядокСписания();
		КолонкиСвязиПорядка = Новый Массив();
		Для Каждого ПризнакИспользования Из ПризнакиИспользованияКолонок Цикл
			КолонкаИспользуется = (ПризнакИспользования.Значение);
			Если КолонкаИспользуется Тогда
				КолонкиСвязиПорядка.Добавить(ПризнакИспользования.Ключ);
			КонецЕсли;
		КонецЦикла;
		ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоТаблицеПорядка(
			ТаблицаОстатки,
			ДокументОбъект["ПорядокСписания"].Выгрузить(),
			КолонкиСвязиПорядка);
		
		// Сравниваем показатели
		РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаРасхождения,
			ТаблицаОстатки,
			ИменаКолонокСвязи,
			ИменаКолонокПоказателей,
			"СписанияВТаблице2ВРазмереСоответствия");
		ТаблицаРезультат = РезультатыСравнения["СписанияВТаблице2ВРазмереСоответствия"];
	Иначе
		// Излишки берем в готовом виде из основной таблицы
		
		ТаблицаРезультат = ТаблицаРасхождения;
		
		ТаблицаРезультат.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
		
		ТаблицаРезультат.ЗаполнитьЗначения(ДокументОбъект["ЦМО"], "ЦМО");
	КонецЕсли;
	
	// Дополнительная обработка строк С ПУСТЫМ СЧЕТОМ.
	// Если для счета возможен выбор лишь из 1 значения, то выбираем его принудительно.
	// А если оказалось так, что Субконто3 заполнено, а счет нет, то очищаем Субконто3.
	// Все равно при указании счета в такой строке Субконто3 очистится.
	ВставляемыеЗначения = Новый Структура();
	Если ПараметрыНакладываемогоОтбора["СчетаОстатков"].Количество() = 1 Тогда
		ВставляемыеЗначения.Вставить("Счет", ПараметрыНакладываемогоОтбора["СчетаОстатков"][0]);
	КонецЕсли;
	Если СледуетИспользоватьДополнительноеСубконто Тогда
		ВставляемыеЗначения.Вставить("Субконто3", Неопределено);
	КонецЕсли;
	Если ВставляемыеЗначения.Количество() > 0 Тогда
		Поиск = Новый Структура("Счет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		МассивСтрок = ТаблицаРезультат.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВставляемыеЗначения);
		КонецЦикла;
	КонецЕсли;
	
	// Дополнительная обработка строк С ПУСТЫМ МОЛ.
	// Если для отбора по МОЛ применяется лишь 1 значение, то выбираем его принудительно.
	Если ПараметрыНакладываемогоОтбора["ЗначенияДляОтбораПоМОЛ"].Количество() = 1 Тогда
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ЦМО", ПараметрыНакладываемогоОтбора["ЗначенияДляОтбораПоМОЛ"][0]);
		
		Поиск = Новый Структура("ЦМО", Неопределено);
		МассивСтрок = ТаблицаРезультат.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВставляемыеЗначения);
		КонецЦикла;
	КонецЕсли;
	
	ТабличнаяЧасть = ?(ЭтоНедостача,
		ДокументОбъект["Недостачи"],
		ДокументОбъект["Излишки"]);
	ТабличнаяЧасть.Загрузить(ТаблицаРезультат);
	
	Если НЕ ЭтоНедостача Тогда
		// Излишки
		
		// Заполняем колонку Цена
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			Если СтрокаТаблицы["Количество"] = 0 Тогда
				СтрокаТаблицы["Цена"] = 0;
			Иначе
				СтрокаТаблицы["Цена"] = СтрокаТаблицы["Сумма"] / СтрокаТаблицы["Количество"];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКоличествоДокументовВведенныхНаОсновании(ДокументОбъект) Экспорт
	
	КоличествоСписаний		= 0;
	КоличествоПоступлений	= 0;
	
	ДокСсылка = ДокументОбъект["Ссылка"];
	
	Если НЕ ДокСсылка.Пустая() Тогда
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", ДокСсылка);
		ЗапросПоиск.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Количество документов 'Поступление МЗ', введенных на основании
		|//
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)	КАК КоличествоДокументов
		|ИЗ
		|	Документ.ПоступлениеМЗ	КАК Док
		|ГДЕ
		|	Док.ДокументОснование = &ДокСсылка
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|// [1]. Количество документов 'Акт списания МЗ', введенных на основании
		|//
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)	КАК КоличествоДокументов
		|ИЗ
		|	Документ.АктСписанияМЗ	КАК Док
		|ГДЕ
		|	Док.ДокументОснование = &ДокСсылка
		|;";
		
		РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
		
		// [0]. Количество документов 'Поступление МЗ', введенных на основании
		Выборка = РезультатыПоиска[0].Выбрать();
		Выборка.Следующий();
		КоличествоПоступлений = Выборка["КоличествоДокументов"];
		
		// [1]. Количество документов 'Акт списания МЗ', введенных на основании
		Выборка = РезультатыПоиска[1].Выбрать();
		Выборка.Следующий();
		КоличествоСписаний = Выборка["КоличествоДокументов"];
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("КоличествоСписаний",	КоличествоСписаний);
	Результат.Вставить("КоличествоПоступлений",	КоличествоПоступлений);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьФактическоеНаличие(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		
		Если Объект.ВариантФормированияОписи = 0 Тогда
			// 0. Опись до 2018 г.
			
			СтрокаТаблицы["КоличествоФакт"]	= СтрокаТаблицы["КоличествоУчет"];
			СтрокаТаблицы["СуммаФакт"]		= СтрокаТаблицы["СуммаУчет"];
			
			СтрокаТаблицы["НедостачаСумма"]			= 0;
			СтрокаТаблицы["НедостачаКоличество"]	= 0;
			СтрокаТаблицы["ИзлишекСумма"]			= 0;
			СтрокаТаблицы["ИзлишекКоличество"]		= 0;
		Иначе
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			
			СтрокаТаблицы["КоличествоФакт"] = СтрокаТаблицы["КоличествоУчет"];
			
			ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьФактическиеПоказатели(
				ФормаДокумента,
				СтрокаТаблицы,
				"КоличествоФакт");
					
			ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(
				ФормаДокумента,
				СтрокаТаблицы);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

// Флажок <без ограничения>
Функция ФлажокБезОграничения_ПолучитьНастройкиМеханизма() Экспорт
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяРеквизитаСсылка",	"ИФО");
	НастройкиМеханизма.Вставить("ИмяРеквизитаФлажок",	"БезУчетаИФО");
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ПолучитьНастройкиГруппСчетов(ДокументОбъект, ЗаполнитьДетальныеСвойстваВыбраннойГруппыСчетов = Истина) Экспорт
	
	Организация		= ДокументОбъект["Организация"];
	ГруппаСчетов	= ДокументОбъект["СчетГруппа"];
	
	// Таблица настроек ВСЕХ групп счетов
	ТаблицаНастроек = ПолучитьТаблицуНастроекГруппСчетов(ДокументОбъект);
	
	Если ЗначениеЗаполнено(ГруппаСчетов) Тогда
		ИспользуемаяГруппаСчетов			= ГруппаСчетов;
		ГруппаСчетовНазначенаПринудительно	= Ложь;
	Иначе
		// Явно назначаем выбранную группу счетов
		ИспользуемаяГруппаСчетов			= ТаблицаНастроек[0]["ОсновнойСчетГруппы"];
		ГруппаСчетовНазначенаПринудительно	= Истина;
	КонецЕсли;
	
	// Группа счетов, указанная в документе, поддерживается?
	Поиск = Новый Структура("ОсновнойСчетГруппы", ИспользуемаяГруппаСчетов);
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		// Поддерживается
		
		ГруппаСчетовПоддерживается	= Истина;
		
		СтрокаТаблицыНастроек		= МассивСтрок[0];
		
	Иначе
		// Не поддерживается
		
		ГруппаСчетовПоддерживается	= Ложь;
		
		ДобавитьНастройкуНеподдерживаемойГруппыСчетов(ТаблицаНастроек, ИспользуемаяГруппаСчетов);
		
		СтрокаТаблицыНастроек		= ТаблицаНастроек[ТаблицаНастроек.Количество() - 1];
	КонецЕсли;
	
	НомерГруппы = СтрокаТаблицыНастроек["НомерГруппы"];
	
	СвойстваВыбраннойГруппыСчетов = Новый Структура();
	СвойстваВыбраннойГруппыСчетов.Вставить("Поддерживается",			ГруппаСчетовПоддерживается);
	СвойстваВыбраннойГруппыСчетов.Вставить("НазначенаПринудительно",	ГруппаСчетовНазначенаПринудительно);
	СвойстваВыбраннойГруппыСчетов.Вставить("ОсновныеСвойства",			ПолучитьОсновныеСвойстваОднойГруппыСчетовПоНомеру(ТаблицаНастроек, НомерГруппы));
	Если ЗаполнитьДетальныеСвойстваВыбраннойГруппыСчетов = Истина Тогда
		СвойстваВыбраннойГруппыСчетов.Вставить("ДетальныеСвойства",		ПолучитьДетальныеСвойстваОднойГруппыСчетовПоНомеру(ТаблицаНастроек, НомерГруппы));
	КонецЕсли;
	
	НастройкиГруппСчетов = Новый Структура();
	НастройкиГруппСчетов.Вставить("ТаблицаНастроек",					ТаблицаНастроек);
	НастройкиГруппСчетов.Вставить("СписокГруппСчетов",					ПолучитьСписокВыбораГруппСчетов(ТаблицаНастроек));
	НастройкиГруппСчетов.Вставить("СвойстваВыбраннойГруппыСчетов", 		СвойстваВыбраннойГруппыСчетов);//Новый ФиксированнаяСтруктура(СвойстваВыбраннойГруппыСчетов));
	
	Возврат НастройкиГруппСчетов;//Новый ФиксированнаяСтруктура(НастройкиГруппСчетов);
	
КонецФункции

Функция ПолучитьСписокСчетовПоУмолчанию(ДатаИнвентаризации, Организация) Экспорт
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("ДатаИнвентаризации",	ДатаИнвентаризации);
	ШапкаДокумента.Вставить("Организация",			Организация);
	
	ТаблицаНастроекГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьТаблицуНастроекГруппСчетов(ШапкаДокумента);
	
	Возврат ТаблицаНастроекГруппСчетов.ВыгрузитьКолонку("ОсновнойСчетГруппы");
	
КонецФункции

Функция ОпределитьГруппуСчетовПоСчету(Счет, ДатаИнвентаризации, Организация) Экспорт
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("ДатаИнвентаризации",	ДатаИнвентаризации);
	ШапкаДокумента.Вставить("Организация",			Организация);
	
	ТаблицаНастроекГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьТаблицуНастроекГруппСчетов(ШапкаДокумента);
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроекГруппСчетов Цикл
		ГруппаСчетов = СтрокаТаблицы["ОсновнойСчетГруппы"];
		
		Если Счет = ГруппаСчетов Тогда
			Возврат ГруппаСчетов;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроекГруппСчетов Цикл
		ГруппаСчетов = СтрокаТаблицы["ОсновнойСчетГруппы"];
		
		Если БухгалтерскийУчет.СчетВИерархии(Счет, ГруппаСчетов) Тогда
			Возврат ГруппаСчетов;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Для формы регистра ДополнительныеГруппыСчетовИнвентаризацииМЗ
Функция ПолучитьНастройкиВсехГруппДляФормыРедактированияГруппСчетов(ДокументОбъект) Экспорт
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекГруппСчетов(ДокументОбъект, Истина);
	
	// Отбираем пользовательские группы счетов,
	// и только для них определяем детальные настройки.
	// Для предопределенных групп детальные настройки не определяем,
	// т.к. не допускается модификация настроек предопределенных групп счетов.
	
	Поиск = Новый Структура("ГруппаСчетовПредопределенная", Ложь);
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	КоличествоСтрокВсего			= ТаблицаНастроек.Количество();
	КоличествоСтрокПользовательские = МассивСтрок.Количество();
	КоличествоСтрокПредопределенные	= КоличествоСтрокВсего - КоличествоСтрокПользовательские;
	
	Если КоличествоСтрокПользовательские > 0 Тогда
		// Есть пользовательские группы счетов
		
		ТаблицаНастроекПользовательскиеГруппы = ТаблицаНастроек.Скопировать(МассивСтрок);
		
		ДетальныеСвойстваВсехГруппСчетов = ПолучитьДетальныеСвойстваВсехГруппСчетов(ТаблицаНастроекПользовательскиеГруппы, Истина);
		
		Для Каждого СтрокаНастроек Из ТаблицаНастроек Цикл
			Если СтрокаНастроек["ГруппаСчетовПредопределенная"] Тогда
				Продолжить;
			КонецЕсли;
			
			НомерГруппы = СтрокаНастроек["НомерГруппы"];
			
			ДетальныеСвойства = ДетальныеСвойстваВсехГруппСчетов.Получить(НомерГруппы);
			
			ДанныеСпецифичныхКолонок = ПолучитьДанныеСпецифичныхКолонокОднойГруппыДляФормыРедактированияГруппСчетов(ДетальныеСвойства);
			
			ЗаполнитьЗначенияСвойств(СтрокаНастроек, ДанныеСпецифичныхКолонок);
		КонецЦикла;
	КонецЕсли;
	
	// Возможные пользовательские группы счетов
	// Исключаем счета предопределенных групп
	СписокСчетовИсключений = Новый СписокЗначений();
	Поиск = Новый Структура("ГруппаСчетовПредопределенная", Истина);
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		ОсновныеСчетаГрупп = ТаблицаНастроек.Скопировать(Поиск, "ОсновнойСчетГруппы").ВыгрузитьКолонку("ОсновнойСчетГруппы");
		СписокСчетовИсключений.ЗагрузитьЗначения(ОсновныеСчетаГрупп);
	КонецЕсли;
	
	ВозможныеПользовательскиеГруппыСчетов = ПолучитьВозможныеПользовательскиеГруппыСчетов(СписокСчетовИсключений);
	
	Статистика = Новый Структура();
	Статистика.Вставить("КоличествоСтрокВсего",				КоличествоСтрокВсего);
	Статистика.Вставить("КоличествоСтрокПользовательские",	КоличествоСтрокПользовательские);
	Статистика.Вставить("КоличествоСтрокПредопределенные",	КоличествоСтрокПредопределенные);
	
	НастройкиДляФормы = Новый Структура();
	НастройкиДляФормы.Вставить("ТаблицаНастроек",	ТаблицаНастроек);
	НастройкиДляФормы.Вставить("Статистика",		Новый ФиксированнаяСтруктура(Статистика));
	НастройкиДляФормы.Вставить("СписокВыбораСчета",	ВозможныеПользовательскиеГруппыСчетов);
	
	Возврат НастройкиДляФормы;
	
КонецФункции

// Для формы регистра ДополнительныеГруппыСчетовИнвентаризацииМЗ
Функция ПолучитьНастройкиОднойГруппыДляФормыРедактированияГруппСчетов(ОсновнойСчетГруппы) Экспорт
	
	Перем НастройкиГруппы;
	
	ПустойВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ОсновнойСчетГруппы) Тогда
		// Будем возвращать содержательные настройки
		
		ДетальныеСвойства				= ПолучитьДетальныеСвойстваОднойГруппыСчетовПоСчету(ОсновнойСчетГруппы);
		СвойстваОсновногоСчетаГруппы	= ДетальныеСвойства["СвойстваОсновногоСчетаГруппы"];
		
		НастройкиГруппы = ПолучитьДанныеСпецифичныхКолонокОднойГруппыДляФормыРедактированияГруппСчетов(ДетальныеСвойства);
		
		Наименование = ОпределитьАвтоматическиНаименованиеГруппыСчетов(
			СвойстваОсновногоСчетаГруппы["Код"],
			СвойстваОсновногоСчетаГруппы["Наименование"]);
	Иначе
		// Будем возвращать "очищающие" настройки
		
		НастройкиГруппы = ПолучитьСпецифичныеКолонкиТаблицыНастроекДляФормыРедактированияГруппСчетов();
		
		Наименование = "";
	КонецЕсли;
	
	// Добавляем еще свойств
	НастройкиГруппы.Вставить("Наименование",						Наименование);
	НастройкиГруппы.Вставить("СубконтоДляМОЛ",						ПустойВидСубконто);
	НастройкиГруппы.Вставить("ДополнительноеСубконто",				ПустойВидСубконто);
	НастройкиГруппы.Вставить("ЗаголовокДополнительногоСубконто",	"");
	НастройкиГруппы.Вставить("ИспользуетсяДополнительноеСубконто",	Ложь);
	
	Если НастройкиГруппы["ПотенциальныеСубконтоДляМОЛ"].Количество() > 0 Тогда
		// Принудительно устанавливаем значение,
		// выбираем самое первое из списка допустимых значений
		
		ВидСубконто = НастройкиГруппы["ПотенциальныеСубконтоДляМОЛ"][0];
		НастройкиГруппы.Вставить("СубконтоДляМОЛ", ВидСубконто);
	КонецЕсли;
	
	Если НастройкиГруппы["ПотенциальныеДополнительныеСубконто"].Количество() > 0 Тогда
		// Принудительно устанавливаем значение,
		// выбираем самое первое из списка допустимых значений,
		// и отличающееся от субконто для МОЛ
		
		Установить = Ложь;
		Для Каждого ВидСубконто Из НастройкиГруппы["ПотенциальныеДополнительныеСубконто"] Цикл
			Если НЕ ВидСубконто = НастройкиГруппы["СубконтоДляМОЛ"] Тогда
				Установить = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Установить Тогда
			НастройкиГруппы.Вставить("ДополнительноеСубконто",				ВидСубконто);
			НастройкиГруппы.Вставить("ЗаголовокДополнительногоСубконто",	Строка(ВидСубконто));
			НастройкиГруппы.Вставить("ИспользуетсяДополнительноеСубконто",	Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НастройкиГруппы;
	
КонецФункции

Процедура ИнициализироватьРеквизитыФормыДляНастроекГруппСчетов(Форма) Экспорт
	
	// СОЗДАЕМ РЕКВИЗИТЫ ФОРМЫ
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	// Колонки таблицы аналитики допустимых счетов
	ИмяРеквизитаФормыТаблица = ПолучитьИмяРеквизитаФормыТаблицаАналитикиДопустимыхСчетов();
	ПустаяТаблица = ПолучитьПустуюТаблицуАналитикиДопустимыхСчетов();
	Для Каждого Колонка Из ПустаяТаблица.Колонки Цикл
		НовыйРеквизитФормы = Новый РеквизитФормы(
			Колонка.Имя,
			Новый ОписаниеТипов(Колонка.ТипЗначения.Типы()),
			ИмяРеквизитаФормыТаблица);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	КонецЦикла;
	
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбновитьИКэшироватьНастройкиГруппСчетов(Форма) Экспорт
	
	ДокументОбъект = Форма["Объект"];
	
	// Получаем свежую версию настроек
	НастройкиГруппСчетов			= ПолучитьНастройкиГруппСчетов(ДокументОбъект);
	СвойстваВыбраннойГруппыСчетов	= НастройкиГруппСчетов["СвойстваВыбраннойГруппыСчетов"];
	
	
	// ОБНОВЛЯЕМ РЕКВИЗИТЫ ОБЪЕКТА
	
	Если СвойстваВыбраннойГруппыСчетов["НазначенаПринудительно"] Тогда
		ДокументОбъект["СчетГруппа"] = СвойстваВыбраннойГруппыСчетов["ОсновныеСвойства"]["ОсновнойСчетГруппы"];
	КонецЕсли;
	
	
	// ОБНОВЛЯЕМ РЕКВИЗИТЫ ФОРМЫ
	
	// Список выбора Группа счетов учета
	НастраиваемыйСписок = Форма.Элементы["СчетГруппа"].СписокВыбора;
	НастраиваемыйСписок.Очистить();
	Для Каждого ЭлементСписка Из НастройкиГруппСчетов["СписокГруппСчетов"] Цикл
		НастраиваемыйСписок.Добавить(
			ЭлементСписка.Значение,
			ЭлементСписка.Представление);
	КонецЦикла;
	
	// Значения автоподстановки
	// (при добавлении новой строки в табличные части)
	Форма["ЗначенияАвтоподстановки"] = ПолучитьЗначенияАвтоподстановки(СвойстваВыбраннойГруппыСчетов);
	
	// Отдельные признаки
	Форма["ГруппаСчетовПоддерживается"] = СвойстваВыбраннойГруппыСчетов["Поддерживается"];
	
	
	// КЭШИРУЕМ НАСТРОЙКИ В РЕКВИЗИТЫ ФОРМЫ
	
	КэшироватьНастройкиНаФорму(Форма, НастройкиГруппСчетов);
	
КонецПроцедуры

Процедура ОбновитьРеальныеДополнительныеСубконто(Форма) Экспорт
	
	ДокументОбъект = Форма["Объект"];
	
	ТаблицаАналитикиДопустимыхСчетов = Форма[ПолучитьИмяРеквизитаФормыТаблицаАналитикиДопустимыхСчетов()];
	
	ОбновитьРеальныеДополнительныеСубконтоВТабличнойЧасти(ДокументОбъект["Недостачи"],			ТаблицаАналитикиДопустимыхСчетов);
	ОбновитьРеальныеДополнительныеСубконтоВТабличнойЧасти(ДокументОбъект["Излишки"],			ТаблицаАналитикиДопустимыхСчетов);
	ОбновитьРеальныеДополнительныеСубконтоВТабличнойЧасти(ДокументОбъект["ПорядокСписания"],	ТаблицаАналитикиДопустимыхСчетов);
	
КонецПроцедуры

Функция ОпределитьАвтоматическиЗаголовокДополнительногоСубконто(ПараметрыОпределенияЗаголовка) Экспорт
	
	ВидСубконто								= ПараметрыОпределенияЗаголовка["ВидСубконто"];
	СледуетИспользоватьНесколькоЗначений	= ПараметрыОпределенияЗаголовка["СледуетИспользоватьНесколькоЗначений"];
	
	Если ЗначениеЗаполнено(ВидСубконто) Тогда
		ЗаголовокДополнительногоСубконто = Строка(ВидСубконто);
	Иначе
		Если СледуетИспользоватьНесколькоЗначений = Истина Тогда
			ЗаголовокДополнительногоСубконто = НСтр("ru='Доп. субконто'");
		Иначе
			ЗаголовокДополнительногоСубконто = "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаголовокДополнительногоСубконто;
	
КонецФункции

Функция ПолучитьПризнакиИспользованияКолонокТаблицыПорядокСписания(СтруктураПараметров = Неопределено) Экспорт
	
	ПризнакиИспользования = Новый Структура();
	
	ПризнакиИспользования.Вставить("ИФО",		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ПризнакиИспользования.Вставить("КФО",		Истина);
	ПризнакиИспользования.Вставить("ЦМО",		Истина);
	
	ПризнакиИспользования.Вставить("КПС",		Ложь);
	ПризнакиИспользования.Вставить("Счет",		Ложь);
	ПризнакиИспользования.Вставить("Субконто3",	Ложь);
	
	Возврат ПризнакиИспользования;
	
КонецФункции

// Удаляет неиспользуемые строки в служебных табличных частях Остатки и ПорядокСписания.
// Неиспользуемые строки - это строки, которые связаны с неиспользуемой номенклатурой.
// Неиспользуемая номенклатура - номенклатура, отсутствующая в редактируемых
// табличных частях Материалы, Недостачи, Излишки.
Процедура УдалитьНеиспользуемыеСтрокиВНевидимыхТаблЧастях(ДокументОбъект, СвойстваВыбраннойГруппыСчетов) Экспорт
	
	ПризнакиИспользованияКолонок = Документы.ИнвентаризацияМЗ.ПолучитьПризнакиИспользованияКолонокТаблицыПорядокСписания();
	
	ЗапросУдаление = Новый Запрос();
	ЗапросУдаление.УстановитьПараметр("ТЗМатериалы",					ДокументОбъект["Материалы"].Выгрузить(, "Номенклатура"));
	ЗапросУдаление.УстановитьПараметр("ТЗНедостачи",					ДокументОбъект["Недостачи"].Выгрузить(, "Номенклатура"));
	ЗапросУдаление.УстановитьПараметр("ТЗИзлишки",						ДокументОбъект["Излишки"].Выгрузить(, "Номенклатура"));
	ЗапросУдаление.УстановитьПараметр("ТЗОстатки",						ДокументОбъект["Остатки"].Выгрузить());
	ЗапросУдаление.УстановитьПараметр("ТЗПорядокСписания",				ДокументОбъект["ПорядокСписания"].Выгрузить());
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаИФО",			ПризнакиИспользованияКолонок["ИФО"]);
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаКФО",			ПризнакиИспользованияКолонок["КФО"]);
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаЦМО",			ПризнакиИспользованияКолонок["ЦМО"]);
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаКПС",			ПризнакиИспользованияКолонок["КПС"]);
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаСчет",		ПризнакиИспользованияКолонок["Счет"]);
	ЗапросУдаление.УстановитьПараметр("ИспользуетсяКолонкаСубконто3",	ПризнакиИспользованияКолонок["Субконто3"]);
	ЗапросУдаление.Текст = "
