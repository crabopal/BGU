	Если НаДату >= '20230101' Тогда
		ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"106.00",	ВидСубконтоЦМО,,, НаДату, "106.24,106.27,106.34,106.37,106.56");
	ИначеЕсли НаДату >= '20210101' Тогда
		ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"106.00",	ВидСубконтоЦМО,,, НаДату, "106.24,106.34,106.56");
