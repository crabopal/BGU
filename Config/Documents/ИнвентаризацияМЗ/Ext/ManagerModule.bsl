	ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"26",		ВидСубконтоКонтрагенты,,, НаДату, "26.24,26.34,26.56");
	
	Если НаДату >= '20210101' Тогда
		ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"27.02",	ВидСубконтоКонтрагенты,,, НаДату, "27.02");
	Иначе
		НаДату = '20191231';
		ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"27",		ВидСубконтоКонтрагенты,,, НаДату);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьНастройкиПользовательскихГруппСчетов(ТаблицаНастроек, ДокументОбъект)
	
	Если ДокументОбъект = Неопределено
		ИЛИ НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Организация")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументОбъект["Организация"]) Тогда
		
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация", ДокументОбъект["Организация"]);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетГруппа							КАК ОсновнойСчетГруппы,
	|	СубконтоДляМОЛ						КАК СубконтоДляМОЛ,
	|	ИспользуетсяДополнительноеСубконто	КАК ИспользуетсяДополнительноеСубконто,
	|	ДополнительноеСубконто				КАК ДополнительноеСубконто,
	|	ЗаголовокДополнительногоСубконто	КАК ЗаголовокДополнительногоСубконто,
	|	НПП									КАК НПП
	|ИЗ
	|	РегистрСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ
	|ГДЕ
	|	Организация = &Организация
	|УПОРЯДОЧИТЬ ПО
	|	НПП
	|;";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДобавитьНастройкуПользовательскойГруппыСчетов(ТаблицаНастроек, Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,
														КодОсновногоСчетаГруппы,
														СубконтоДляМОЛ,
														ДополнительноеСубконто = Неопределено,
														ЗаголовокДополнительногоСубконто = Неопределено,
														НаДату = Неопределено,
														ОграниченияСчетовГруппы = "")
														
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ОсновнойСчетГруппы = БухгалтерскийУчет.СчетПоКоду(КодОсновногоСчетаГруппы, НаДату);
	
	Если НЕ ЗначениеЗаполнено(ОсновнойСчетГруппы) Тогда
		// Настройку не добавляем для такой группы счетов
		// Выходим:
		Возврат;
	КонецЕсли;
	
	МассивСчетов = Новый Массив();
	
	Если ЗначениеЗаполнено(ОграниченияСчетовГруппы) Тогда
		МассивСчетов = БухгалтерскийУчет.СписокСчетов(ОграниченияСчетовГруппы, НаДату);
	КонецЕсли;
	
	ИспользуетсяДополнительноеСубконто = НЕ (ДополнительноеСубконто = Неопределено);
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	НоваяСтрока["НомерГруппы"]							= ТаблицаНастроек.Количество();
	НоваяСтрока["ГруппаСчетовПредопределенная"]			= Истина;
	НоваяСтрока["ОсновнойСчетГруппы"]					= ОсновнойСчетГруппы;
	НоваяСтрока["СубконтоДляМОЛ"]						= СубконтоДляМОЛ;
	НоваяСтрока["ИспользуетсяДополнительноеСубконто"]	= ИспользуетсяДополнительноеСубконто;
	
	Если ИспользуетсяДополнительноеСубконто Тогда
		НоваяСтрока["ДополнительноеСубконто"]	= ДополнительноеСубконто;
		Если НЕ (ЗаголовокДополнительногоСубконто = Неопределено) Тогда
			НоваяСтрока["ЗаголовокДополнительногоСубконто"]	= ЗаголовокДополнительногоСубконто;
		КонецЕсли;
	КонецЕсли;
	
	НоваяСтрока["ОграниченияСчетовГруппы"]				= МассивСчетов;
	
КонецПроцедуры

Процедура ДобавитьНастройкуПользовательскойГруппыСчетов(ТаблицаНастроек, Выборка)
	
	ОсновнойСчетГруппы = Выборка["ОсновнойСчетГруппы"];
	
	Если НЕ ЗначениеЗаполнено(ОсновнойСчетГруппы) Тогда
		// Настройку не добавляем для такой группы счетов
		// Выходим:
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	
	НоваяСтрока["НомерГруппы"] = ТаблицаНастроек.Количество();
	
КонецПроцедуры

Процедура ДобавитьНастройкуНеподдерживаемойГруппыСчетов(ТаблицаНастроек, ОсновнойСчетГруппы)
	
	ЗапросСвойства = Новый Запрос();
	ЗапросСвойства.УстановитьПараметр("Счет", ОсновнойСчетГруппы);
	ЗапросСвойства.Текст = "
	|ВЫБРАТЬ
	|	ПланСчетовЕПСБУ.Код				КАК Код,
	|	ПланСчетовЕПСБУ.Наименование	КАК Наименование
	|ИЗ
	|	ПланСчетов.ЕПСБУ	КАК ПланСчетовЕПСБУ
	|ГДЕ
	|	Ссылка = &Счет
	|;";
	
	Выборка = ЗапросСвойства.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Наименование = ОпределитьАвтоматическиНаименованиеГруппыСчетов(Выборка["Код"], Выборка["Наименование"], Ложь);
		Прервать;
	КонецЦикла;
	
	ОписаниеГруппыСчетов = Новый Структура();
	ОписаниеГруппыСчетов.Вставить("ОсновнойСчетГруппы",					ОсновнойСчетГруппы);
	ОписаниеГруппыСчетов.Вставить("Наименование",						Наименование);
	ОписаниеГруппыСчетов.Вставить("СубконтоДляМОЛ",						ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ОписаниеГруппыСчетов.Вставить("ИспользуетсяДополнительноеСубконто",	Ложь);
	
	ДобавитьНастройкуПользовательскойГруппыСчетов(ТаблицаНастроек, ОписаниеГруппыСчетов);
	
КонецПроцедуры

Функция ПолучитьДетальныеСвойстваВсехГруппСчетов(ТаблицаНастроек, ДляФормыРедактированияГруппСчетов = Ложь)
	
	// Возвращаемое значение
	//	Ключ:		НомерГруппы
	//	Значение:	ДетальныеСвойства
	ДетальныеСвойстваВсехГруппСчетов = Новый Соответствие();
	
	// Если указаны ограничения группы счетов, то заменим соответствующую строку группы счетов
	// (одну строку) на строки ограничений
	ВремТЗ = ТаблицаНастроек.СкопироватьКолонки();
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		Если СтрокаТаблицы["ОграниченияСчетовГруппы"].Количество() > 0 Тогда
			// Такую строку заменяем на новые строки
			
			Для Каждого Счет Из СтрокаТаблицы["ОграниченияСчетовГруппы"] Цикл
				НоваяСтрока = ВремТЗ.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "НомерГруппы,СубконтоДляМОЛ");
				
				НоваяСтрока["ОсновнойСчетГруппы"] = Счет;
			КонецЦикла;
			
		Иначе
			// Такую строку оставляем как есть
			
			НоваяСтрока = ВремТЗ.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	// Настраиваем запрос
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаНастройкиГруппСчетов",	ВремТЗ);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоНоменклатура",		ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоДляМОЛ",			ПолучитьВидыСубконтоДляМОЛ());
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица настроек всех групп счетов
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерГруппы			КАК НомерГруппы,
	|	ТЗ.ОсновнойСчетГруппы	КАК ОсновнойСчетГруппы,
	|	ТЗ.СубконтоДляМОЛ		КАК СубконтоДляМОЛ
	|ПОМЕСТИТЬ
	|	НастройкиГруппСчетов
	|ИЗ
	|	&ТаблицаНастройкиГруппСчетов КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Субсчета 1 уровня вложенности
	|//
	|ВЫБРАТЬ
	|	НастройкиГруппСчетов.НомерГруппы	КАК НомерГруппы,
	|	ЕПСБУ.Ссылка						КАК Счет,
	|	ЕПСБУ.Родитель						КАК Родитель
	|ПОМЕСТИТЬ
	|	Субсчета1УровняВложенности
	|ИЗ
	|	НастройкиГруппСчетов	КАК НастройкиГруппСчетов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ПланСчетов.ЕПСБУ	КАК ЕПСБУ
	|		ПО	НастройкиГруппСчетов.ОсновнойСчетГруппы = ЕПСБУ.Родитель
	|ИНДЕКСИРОВАТЬ ПО
	|	ЕПСБУ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Субсчета 2 уровня вложенности
	|//
	|ВЫБРАТЬ
	|	СубсчетаПредыдущегоУровня.НомерГруппы	КАК НомерГруппы,
	|	ЕПСБУ.Ссылка							КАК Счет,
	|	ЕПСБУ.Родитель							КАК Родитель
	|ПОМЕСТИТЬ
	|	Субсчета2УровняВложенности
	|ИЗ
	|	Субсчета1УровняВложенности	КАК СубсчетаПредыдущегоУровня
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ПланСчетов.ЕПСБУ	КАК ЕПСБУ
	|		ПО	ЕПСБУ.Родитель = СубсчетаПредыдущегоУровня.Счет
