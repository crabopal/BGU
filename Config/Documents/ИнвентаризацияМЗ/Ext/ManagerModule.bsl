Процедура ЗаполнитьИнвентаризационнуюКомиссию(ДокОбъектНовый, ДокОснованиеСсылка)
	
	// Настраиваем запрос:
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ДокСсылка", ДокОснованиеСсылка);
	ЗапросВыборка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Председатель комиссии, прочие сведения о ней.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьПредседателяКомиссии	КАК ДолжностьПредседательКомиссии,
	|	ФамилияПредседателяКомиссии		КАК ФамилияПредседательКомиссии,
	|	ИмяПредседателяКомиссии			КАК ИмяПредседательКомиссии,
	|	ОтчествоПредседателяКомиссии	КАК ОтчествоПредседательКомиссии,
	|	ДатаПриказаКомиссии				КАК ДатаПриказа,
	|	НомерПриказаКомиссии			КАК НомерПриказа
	|ИЗ
	|	Документ.ИнвентаризацияМЗ
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица ""Состав комиссии"".
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ФамилияЧленаКомиссии	КАК ФамилияЧленаКомиссии,
	|	ИмяЧленаКомиссии		КАК ИмяЧленаКомиссии,
	|	ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияМЗ.СоставКомиссии
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;";
	
	РезультатыВыборки = ЗапросВыборка.ВыполнитьПакет();
	
	// Заполняем реквизиты, относящиеся к инвентаризационной комиссии.
	
	// Шапка:
	Выборка = РезультатыВыборки[0].Выбрать();
	Пока Выборка.Следующий() Цикл // В выборке всего 0 или 1 запись.
		ЗаполнитьЗначенияСвойств(ДокОбъектНовый, Выборка);
	КонецЦикла;
	
	// Табл.часть:
	СоставКомиссии = РезультатыВыборки[1].Выгрузить();
	ДокОбъектНовый["СоставКомиссии"].Загрузить(СоставКомиссии);
	
КонецПроцедуры

Функция ПолучитьТаблицуРасхождений(ТабличнаяЧастьМатериалы, ЭтоНедостача)
	
	ТаблицаРезультат = ТабличнаяЧастьМатериалы.Выгрузить();
	
	КоличествоСтрок = ТаблицаРезультат.Количество();
	
	Для сч = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - сч;
		
		СтрокаТаблицы = ТаблицаРезультат[ИндексСтроки];
		
		Если ЭтоНедостача Тогда
			// Недостачи
			СтрокаСодержитРасхождения = (СтрокаТаблицы["НедостачаКоличество"] > 0);
		Иначе
			// Излишки
			СтрокаСодержитРасхождения = (СтрокаТаблицы["ИзлишекКоличество"] > 0 ИЛИ СтрокаТаблицы["ИзлишекСумма"] > 0);
		КонецЕсли;
		
		Если НЕ СтрокаСодержитРасхождения Тогда
			ТаблицаРезультат.Удалить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура ВывестиСообщения(ДокументОбъект, РезультатПроверки, ТекстШаблон)
	
	ИмяТаблЧастиДляВыводаСообщений	= "Материалы";
	ИмяПоляДляВыводаСообщений		= "НомерСтроки";
	МаксДлинаСообщения				= 200;
	
	ДеревоВыборка = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаГруппировки Из ДеревоВыборка.Строки Цикл
		НомераСтрок = СтрокаГруппировки.Строки.ВыгрузитьКолонку("НомерСтроки");
		
		ИндексСтроки = НомераСтрок[НомераСтрок.Количество() - 1] - 1;
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстШаблон, НомераСтрок, МаксДлинаСообщения, "%1");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект["Ссылка"],
			"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
	
КонецПроцедуры

