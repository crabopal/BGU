	ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"13.2",		ВидСубконтоЦМО,,, НаДату);
	
	Если НаДату >= '20230101' Тогда
		ДобавитьНастройкуПредопределеннойГруппыСчетов(ТаблицаНастроек,	"22",		ВидСубконтоЦМО,
			ПланыВидовХарактеристик.ВидыСубконто.Договоры,
			НСтр("ru='Договор'"),
