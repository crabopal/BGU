Функция ВводНаОсновании_НастройкиМеханизма(ПараметрыВводаНаОсновании = Неопределено) Экспорт
	
	Перем	НастройкиМеханизма,
			СвязиРеквизитов,
			КолонкиТаблицыОтметки;
	
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Определим дополнительные параметры
	ДокументОснованиеСсылка = ПараметрыВводаНаОсновании["ДокументОснованиеСсылка"];
	ЭтоБаланс				= Ложь;
	ЭтоЗабаланс				= Ложь;
	ЭтоСчет27				= Ложь;
	Если НЕ ПараметрыВводаНаОсновании = Неопределено Тогда
		СчетГруппаСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка, "СчетГруппа");
		Если ЗначениеЗаполнено(СчетГруппаСсылка) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетГруппаСсылка, "Забалансовый") Тогда
				ЭтоЗабаланс	= Истина;
			Иначе
				ЭтоБаланс	= Истина;
			КонецЕсли;
			
			Если СчетГруппаСсылка = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("27") Тогда
				ЭтоСчет27	= Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Недостачи (1 вид документов)
	//	АктСписанияМЗ
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "АктСписанияМЗ";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания	Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",							"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",					"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",						"ДокументОснование");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.КФО",				"КФО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.Счет",				"Материалы.СчетУчета");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.Номенклатура",		"Материалы.Номенклатура");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.Количество",			"Материалы.Количество");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.КПС",				"Материалы.КПС");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Недостачи.ИФО",				"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Подразделение",				"ПодразделениеОтправитель");
	КонецЕсли;
	// Особенности счета 27
	Если ЭтоСчет27 Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.ЦМО",			"Материалы.ДополнительнаяАналитикаСчета");
	Иначе
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.ЦМО",			"ЦМООтправитель");
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Недостачи.Субконто3",		"Материалы.ДополнительнаяАналитикаСчета");
	КонецЕсли;
	РеквизитыТиповойОперации	= Новый Массив();
	Если ЭтоБаланс Тогда
		ТиповаяОперацияСсылка		= Справочники.ТиповыеОперации.АктСписанияМЗ_СписаниеНедостачХищений;
	ИначеЕсли ЭтоЗабаланс Тогда
		ТиповаяОперацияСсылка		= Справочники.ТиповыеОперации.АктСписанияМЗ_СписаниеМатериаловЗабаланс;
	Иначе
		ТиповаяОперацияСсылка		= Неопределено;
	КонецЕсли;
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ЦМО",					"ЦМООтправитель");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"КФО",					"КФО");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"СчетУчета",			"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Номенклатура",			"");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"ИФО",					"ИФО");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
		
		
	//
	// Излишки (1 вид документов)
	//	ПоступлениеМЗ
	//
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "ПоступлениеМЗ";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания	Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",							"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",					"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",						"ДокументОснование");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Счет",					"Материалы.СчетУчета");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.КФО",					"Материалы.КФО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Номенклатура",			"Материалы.Номенклатура");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Количество",			"Материалы.Количество");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Сумма",				"Материалы.Сумма");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.КПС",					"Материалы.КПС");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Излишки.ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Подразделение",				"Подразделение");
	КонецЕсли;
	// Особенности счета 27
	Если ЭтоСчет27 Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.ЦМО",				"Материалы.ДополнительнаяАналитикаСчета");
	Иначе
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.ЦМО",				"ЦМО");
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Субконто3",		"Материалы.ДополнительнаяАналитикаСчета");
	КонецЕсли;
	РеквизитыТиповойОперации	= Новый Массив();
	Если ЭтоБаланс Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.КПС",				"КПСКт");
		ТиповаяОперацияСсылка		= Справочники.ТиповыеОперации.ПоступлениеМЗ_ОприходованиеИзлишковБаланс;
		РеквизитыТиповойОперации.Добавить("КПСКт");
	ИначеЕсли ЭтоЗабаланс Тогда
		ТиповаяОперацияСсылка		= Справочники.ТиповыеОперации.ПоступлениеМЗ_ОприходованиеИзлишковЗабаланс;
	Иначе
		ТиповаяОперацияСсылка		= Неопределено;
	КонецЕсли;
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ЦМО",					"ЦМО");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"КФО",					"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"СчетУчета",			"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Номенклатура",			"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Сумма",				"");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Подразделение",		"Подразделение");
	КонецЕсли;
	Если ЭтоБаланс Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"КПСКт",				"КПСКт");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
	
	
	//////////////////////////////////////////////////////////////////////////////
	// Общие настройки механизма (для всех видов документов)
	//
	РеквизитыТиповойОперацииОснование = Новый Массив();
	ЗаголовкиКолонокТаблицыОтметки = Новый Структура();
	ЗаголовкиКолонокТаблицыОтметки.Вставить("СчетУчета",	"Счет учета");
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ЦМО",			"МОЛ/Место хранения");
	ВводНаОсновании.ДобавитьОбщиеНастройкиМеханизма(НастройкиМеханизма, РеквизитыТиповойОперацииОснование, ЗаголовкиКолонокТаблицыОтметки);
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ВводНаОсновании_НастройкиФормыСпискаДокументовВведенныхНаОсновании(ДополнительныйПараметр = Неопределено) Экспорт
	
	Перем	Таблица,
			МассивФлажков;
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "АктСписанияМЗ";
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО",		"МОЛ/Место хранения", "ЦМООтправитель");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "СчетУчета",	"Счет учета");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	
	ЗаголовокФлажка = "Списания недостач";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидДокумента, ЗаголовокФлажка);
	
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "ПоступлениеМЗ";
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО",		"МОЛ/Место хранения");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "СчетУчета",	"Счет учета");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,					"СуммаДокумента");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	
	ЗаголовокФлажка = "Оприходования излишков";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидДокумента, ЗаголовокФлажка);
	
	
	НастройкиФормыСписка = Новый Структура();
	НастройкиФормыСписка.Вставить("ТаблицаОписаниеКолонок",	Таблица);
	НастройкиФормыСписка.Вставить("МассивФлажков",			МассивФлажков);
	
	Возврат НастройкиФормыСписка;
	
КонецФункции

// Позволяет переопределить имена колонок, определенные автоматически из настроек механизма.
Процедура ВводНаОсновании_Переопределяемый_КолонкиТаблицыОтметки(ПараметрыВводаНаОсновании, АвтоопределенныеИменаКолонок) Экспорт
	
КонецПроцедуры

Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	ВводНаОсновании.ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения);
	
	// Продолжаем заполнение нового документа
	
	ВидДокумента			= ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"]["ВидДокумента"];
	ДокументОснованиеСсылка	= ДанныеЗаполнения["Основание"];
	
	СчетГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка, "СчетГруппа");
	
	Если ВидДокумента = "ПоступлениеМЗ" Тогда
		// Шапка
		ЗаполняемыйДокумент["СпособЗачетаАванса"]	= Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
		ЗаполняемыйДокумент["ВидПоступленияМЗ"]		= Перечисления.ВидыПоступленийМЗ.Поступление;
		ЗаполняемыйДокумент["СчетУчета"]			= СчетГруппа;
		
		// Табличная часть Материалы
		МассивСсылок = ЗаполняемыйДокумент["Материалы"].Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
		ЕдиницыИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСсылок, "ЕдиницаИзмерения");
		
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Для Каждого СтрокаТЧ Из ЗаполняемыйДокумент["Материалы"] Цикл
			СтрокаТЧ["СтавкаНДС"]			= СтавкаНДС;
			СтрокаТЧ["Всего"]				= СтрокаТЧ["Сумма"];
			
			СтрокаТЧ["Всего"]				= СтрокаТЧ["Сумма"];
			СтрокаТЧ["ЕдиницаИзмерения"]	= ЕдиницыИзмерения.Получить(СтрокаТЧ["Номенклатура"]);
			СтрокаТЧ["КоличествоМест"]		= 1;
			СтрокаТЧ["Коэффициент"]			= 1;
		КонецЦикла;
		
	ИначеЕсли ВидДокумента = "АктСписанияМЗ" Тогда
		// Шапка
		ЗаполняемыйДокумент["СчетУчета"] = СчетГруппа;
		
		// Заполним сведения об инвентаризационной комиссии
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент, ДокументОснованиеСсылка);
		
	КонецЕсли;
	
	ЗаполняемыйДокумент["СчетУчета"] = УправлениеМатериальнымиЗапасами.ОпределитьСчетУчетаДляШапкиДокументаМЗ(
		ЗаполняемыйДокумент["Организация"],
		ЗаполняемыйДокумент["СчетУчета"]);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ЗаполняющаяСтруктура = Новый Структура();
		ЗаполняющаяСтруктура.Вставить("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
		
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, ЗаполняющаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

