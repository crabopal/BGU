Процедура ОбновитьРеальныеДополнительныеСубконтоВТабличнойЧасти(ТабличнаяЧасть, ТаблицаАналитикиДопустимыхСчетов)
	
	ТаблицаЗаполнена = (ТаблицаАналитикиДопустимыхСчетов.Количество() > 0);
	
	ЗаполняемаяСтруктура = Новый Структура();
	ЗаполняемаяСтруктура.Вставить("РеальноеДополнительноеСубконто",			ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	ЗаполняемаяСтруктура.Вставить("НомерРеальногоДополнительногоСубконто",	0);
	
	ОчищающаяСтруктура = Новый ФиксированнаяСтруктура(ЗаполняемаяСтруктура);
	
	Поиск = Новый Структура("Счет");
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		Если ТаблицаЗаполнена Тогда
			// Ищем Реальное дополнительное субконто для текущего счета
			
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
			
			МассивСтрок = ТаблицаАналитикиДопустимыхСчетов.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ЗаполняемаяСтруктура, МассивСтрок[0]);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаполняемаяСтруктура);
			Иначе
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
			КонецЕсли;
		Иначе
			// Таблица не заполнена, поэтому искать субконто не имеет смысла
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначенияАвтоподстановки(СвойстваВыбраннойГруппыСчетов)
	
	Счет									= Неопределено;
	РеальноеДополнительноеСубконто			= Неопределено;
	НомерРеальногоДополнительногоСубконто	= 0;
	
	ДопустимыеСчета = СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["ДопустимыеСчета"];
	
	Если ДопустимыеСчета.Количество() = 1 Тогда
		// Редактируемые колонки
		Счет = ДопустимыеСчета[0];
		
		// Служебные колонки Реальных дополнительных субконто
		ТаблицаАналитикиДопустимыхСчетов = СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["СвойстваДопустимыхСчетов"]["ТаблицаАналитикиДопустимыхСчетов"];
		Поиск = Новый Структура("Счет", Счет);
		МассивСтрок = ТаблицаАналитикиДопустимыхСчетов.НайтиСтроки(Поиск);
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаАналитики = МассивСтрок[0];
			
			РеальноеДополнительноеСубконто			= СтрокаАналитики["РеальноеДополнительноеСубконто"];
			НомерРеальногоДополнительногоСубконто	= СтрокаАналитики["НомерРеальногоДополнительногоСубконто"];
		КонецЕсли;
	КонецЕсли;
	
	
	ЗначенияАвтоподстановки = Новый Структура();
	
	ЗначенияАвтоподстановки.Вставить("Счет",									Счет);
	ЗначенияАвтоподстановки.Вставить("РеальноеДополнительноеСубконто",			РеальноеДополнительноеСубконто);
	ЗначенияАвтоподстановки.Вставить("НомерРеальногоДополнительногоСубконто",	НомерРеальногоДополнительногоСубконто);
	
	Возврат Новый ФиксированнаяСтруктура(ЗначенияАвтоподстановки);
	
КонецФункции

// Для формы регистра ДополнительныеГруппыСчетовИнвентаризацииМЗ
Функция ПолучитьДанныеСпецифичныхКолонокОднойГруппыДляФормыРедактированияГруппСчетов(ДетальныеСвойства)
	
	СвойстваПотенциальноДопустимыхСчетов = ДетальныеСвойства["СвойстваПотенциальноДопустимыхСчетов"];
	
	ПотенциальныеДополнительныеСубконто	= Новый ФиксированныйМассив(СвойстваПотенциальноДопустимыхСчетов["ПотенциальныеДополнительныеСубконто"]);
	
	ПотенциальныеСубконтоДляМОЛ			= Новый ФиксированныйМассив(СвойстваПотенциальноДопустимыхСчетов["ПотенциальныеСубконтоДляМОЛ"]);
	
	ДанныеСпецифичныхКолонок = Новый Структура();
	ДанныеСпецифичныхКолонок.Вставить("ПотенциальныеДополнительныеСубконто",			ПотенциальныеДополнительныеСубконто);
	ДанныеСпецифичныхКолонок.Вставить("ПотенциальныеСубконтоДляМОЛ",					ПотенциальныеСубконтоДляМОЛ);
	ДанныеСпецифичныхКолонок.Вставить("КоличествоПотенциальныхДополнительныхСубконто",	ПотенциальныеДополнительныеСубконто.Количество());
	ДанныеСпецифичныхКолонок.Вставить("КоличествоПотенциальныхСубконтоДляМОЛ",			ПотенциальныеСубконтоДляМОЛ.Количество());
	
	Возврат ДанныеСпецифичныхКолонок;
	
КонецФункции

