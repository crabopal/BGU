КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетВТекущейСтрокеПоНоменклатуре(ЭтоНедостача)
	
	// Входная проверка
	Если НЕ ЭтоНедостача = Истина Тогда
		ЭтоНедостача = Ложь;
	КонецЕсли;
		
	ТекДанные = Элементы[?(ЭтоНедостача, "Недостачи", "Излишки")].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СчетНоменклатуры = ПолучитьСчетНоменклатурыСервер(ТекДанные["Номенклатура"]);
	
	// Если счет номенклатуры находится в списке Допустимых счетов,
	// то принимаем его значение.
	СвойстваВыбраннойГруппыСчетов	= ЭтаФорма["НастройкиГруппСчетов_СвойстваВыбраннойГруппыСчетов"];
	ДопустимыеСчета					= СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["ДопустимыеСчета"];
	
	СчетНоменклатурыДопустимый		= НЕ (ДопустимыеСчета.Найти(СчетНоменклатуры) = Неопределено);
	
	Если СчетНоменклатурыДопустимый Тогда
		ТекДанные["Счет"] = СчетНоменклатуры;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетНоменклатурыСервер(НоменклатураСсылка)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Результат = УправлениеМатериальнымиЗапасами.СчетУчетаСсылкаИзНоменклатуры(НоменклатураСсылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СчетГруппаЗапомнитьТекущееЗначение()
	
	СчетГруппаПрежнееЗначение = Объект["СчетГруппа"];
	
КонецПроцедуры

&НаКлиенте
Процедура СчетГруппаВосстановитьПрежнееЗначение()
	
	Объект["СчетГруппа"] = СчетГруппаПрежнееЗначение;
	
КонецПроцедуры

&НаКлиенте
Функция СчетГруппаЗначениеИзменено()
	
	Возврат НЕ (Объект["СчетГруппа"] = СчетГруппаПрежнееЗначение);
	
КонецФункции

&НаСервере
Процедура НастроитьФормуПоВыбраннойГруппеСчетов(ИзмененаГруппаСчетов = Ложь, ИзмененСписокГруппСчетов = Ложь)
	
	Документы.ИнвентаризацияМЗ.ОбновитьИКэшироватьНастройкиГруппСчетов(ЭтаФорма);
	
	Документы.ИнвентаризацияМЗ.ОбновитьРеальныеДополнительныеСубконто(ЭтаФорма);
	
	СвойстваВыбраннойГруппыСчетов = ЭтаФорма["НастройкиГруппСчетов_СвойстваВыбраннойГруппыСчетов"];
	
	НастроитьПоляОтбораПоВыбраннойГруппеСчетов(СвойстваВыбраннойГруппыСчетов, ИзмененаГруппаСчетов, ИзмененСписокГруппСчетов);
	
	НастроитьТабличныеЧастиПоВыбраннойГруппеСчетов(СвойстваВыбраннойГруппыСчетов);
	
	ДополнительноНастроитьФормуЕслиГруппаСчетовНеПоддерживается();
	
	НастроитьДоступностьЭлементов();
	
	НастроитьВидимостьКолонкиЕдИзм();
	
	// Обновляем данные при необходимости
	
	Если ИзмененаГруппаСчетов Тогда
		Объект["Материалы"].Очистить();
		Объект["Излишки"].Очистить();
		Объект["Недостачи"].Очистить();
		Объект["Остатки"].Очистить();
		Объект["ПорядокСписания"].Очистить();
	КонецЕсли;
	
	Если ИзмененаГруппаСчетов ИЛИ ИзмененСписокГруппСчетов Тогда
		ОчиститьНеподдерживаемоеЗначениеСубконтоДляМОЛ(СвойстваВыбраннойГруппыСчетов);
		
		ОчиститьНеподдерживаемоеЗначениеДополнительногоСубконто(СвойстваВыбраннойГруппыСчетов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКолонкиЕдИзм()
	
	НовВидимость = ИнвентаризацияСервер.УстанавливатьКоличествоПоУмолчанию(Объект);
	
	Элементы.МатериалыЕдИзм.Видимость = НовВидимость;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПоляОтбораПоВыбраннойГруппеСчетов(СвойстваВыбраннойГруппыСчетов, ИзмененаГруппаСчетов, ИзмененСписокГруппСчетов)
	
	Перем	ИнициализацияФормыНовогоДокументаНеКопирование,
			ЗначениеКопирования;
	
	Если Параметры.Свойство("ЗначениеКопирования", ЗначениеКопирования) Тогда
		ИнициализацияФормыНовогоДокументаНеКопирование = (Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(ЗначениеКопирования));
	Иначе
		ИнициализацияФормыНовогоДокументаНеКопирование = Ложь;
	КонецЕсли;
	
	ОсновныеСвойства	= СвойстваВыбраннойГруппыСчетов["ОсновныеСвойства"];
	ДетальныеСвойства	= СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"];
	
	//
	// МОЛ
	//
	СвойстваСубконтоДляМОЛ	= ДетальныеСвойства["СвойстваСубконтоДляМОЛ"];
	ТипыЗначений			= СвойстваСубконтоДляМОЛ["ТипыЗначенийДляПоляОтбора"];
	Элементы["ЦМО"].ОграничениеТипа = Новый ОписаниеТипов(ТипыЗначений);
	
	//
	// Счет
	//
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", ДетальныеСвойства["СчетаОтбора"]);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["Счет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
	УстановитьПолеСчет	= (ИзмененаГруппаСчетов ИЛИ ИзмененСписокГруппСчетов ИЛИ ИнициализацияФормыНовогоДокументаНеКопирование);
	
	Если УстановитьПолеСчет Тогда
		Объект["Счет"] = Объект["СчетГруппа"];
	КонецЕсли;
	
	//
	// КПС
	//
	УчетПоКПС = ДетальныеСвойства["СвойстваДопустимыхСчетов"]["УчетПоКПС"];
	Элементы["КПС"].Видимость = УчетПоКПС;
	
	УстановитьПолеКПС	= (ИзмененаГруппаСчетов ИЛИ ИзмененСписокГруппСчетов) И НЕ УчетПоКПС;
	
	Если УстановитьПолеКПС Тогда
		Объект["КПС"] = Неопределено;
	КонецЕсли;
	
	//
	// Дополнительное субконто
	//
	КорректностьНастроек						= ДетальныеСвойства["КорректностьНастроекДополнительногоСубконто"];
	ТипыЗначенийРеальныхДополнительныхСубконто	= ДетальныеСвойства["СвойстваДопустимыхСчетов"]["ТипыЗначенийРеальныхДополнительныхСубконто"];
	
	НоваяВидимость = КорректностьНастроек["СледуетИспользовать"];
	Элементы["Субконто3"].Видимость = НоваяВидимость;
	
	Если КорректностьНастроек["СледуетИспользовать"] Тогда
		Элементы["Субконто3"].Заголовок = ОсновныеСвойства["ЗаголовокДополнительногоСубконто"];
		
		Элементы["Субконто3"].ОграничениеТипа = Новый ОписаниеТипов(ТипыЗначенийРеальныхДополнительныхСубконто);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТабличныеЧастиПоВыбраннойГруппеСчетов(СвойстваВыбраннойГруппыСчетов)
	
	ОсновныеСвойства	= СвойстваВыбраннойГруппыСчетов["ОсновныеСвойства"];
	ДетальныеСвойства	= СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"];
	
	//
	// МОЛ
	//
	СвойстваСубконтоДляМОЛ	= ДетальныеСвойства["СвойстваСубконтоДляМОЛ"];
	ТипыЗначений			= СвойстваСубконтоДляМОЛ["ТипыЗначений"];
	НовоеЗначение			= СвойстваСубконтоДляМОЛ["Заголовок"];
	
	Элементы["НедостачиЦМО"].Заголовок					= НовоеЗначение;
	Элементы["ИзлишкиЦМО"].Заголовок					= НовоеЗначение;
	Элементы["ПорядокСписанияНедостачЦМО"].Заголовок	= НовоеЗначение;
	
	Элементы["НедостачиЦМО"].ОграничениеТипа				= Новый ОписаниеТипов(ТипыЗначений);
	Элементы["ИзлишкиЦМО"].ОграничениеТипа					= Новый ОписаниеТипов(ТипыЗначений);
	Элементы["ПорядокСписанияНедостачЦМО"].ОграничениеТипа	= Новый ОписаниеТипов(ТипыЗначений);
	
	//
	// КПС
	//
	НоваяВидимость = ДетальныеСвойства["СвойстваДопустимыхСчетов"]["УчетПоКПС"];
	Элементы["НедостачиКПС"].Видимость						= НоваяВидимость;
	Элементы["ИзлишкиКПС"].Видимость						= НоваяВидимость;
	Элементы["МатериалыКПС"].Видимость						= НоваяВидимость;
	
	//
	// Счет
	//
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", ДетальныеСвойства["ДопустимыеСчета"]);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["НедостачиСчет"].ПараметрыВыбора	= Новый ФиксированныйМассив(НовыйМассив);
	Элементы["ИзлишкиСчет"].ПараметрыВыбора		= Новый ФиксированныйМассив(НовыйМассив);
	Элементы["МатериалыСчет"].ПараметрыВыбора	= Новый ФиксированныйМассив(НовыйМассив);
	
	//
	// Дополнительное субконто
	//
	КорректностьНастроек						= ДетальныеСвойства["КорректностьНастроекДополнительногоСубконто"];
	ТипыЗначенийРеальныхДополнительныхСубконто	= ДетальныеСвойства["СвойстваДопустимыхСчетов"]["ТипыЗначенийРеальныхДополнительныхСубконто"];
	
	НоваяВидимость = КорректностьНастроек["СледуетИспользовать"];
	Элементы["МатериалыСубконто3"].Видимость	= НоваяВидимость;
	Элементы["НедостачиСубконто3"].Видимость	= НоваяВидимость;
	Элементы["ИзлишкиСубконто3"].Видимость		= НоваяВидимость;
	
	Если КорректностьНастроек["СледуетИспользовать"] Тогда
		НовоеЗначение = ОсновныеСвойства["ЗаголовокДополнительногоСубконто"];
		
		Элементы["МатериалыСубконто3"].Заголовок	= НовоеЗначение;
		Элементы["НедостачиСубконто3"].Заголовок	= НовоеЗначение;
		Элементы["ИзлишкиСубконто3"].Заголовок		= НовоеЗначение;
		
		Элементы["МатериалыСубконто3"].ОграничениеТипа	= Новый ОписаниеТипов(ТипыЗначенийРеальныхДополнительныхСубконто);
		Элементы["НедостачиСубконто3"].ОграничениеТипа	= Новый ОписаниеТипов(ТипыЗначенийРеальныхДополнительныхСубконто);
		Элементы["ИзлишкиСубконто3"].ОграничениеТипа	= Новый ОписаниеТипов(ТипыЗначенийРеальныхДополнительныхСубконто);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДополнительноНастроитьФормуЕслиГруппаСчетовНеПоддерживается()
	
	Если ГруппаСчетовПоддерживается Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Указанная группа счетов более не поддерживается документом.
		|Возможность редактирования документа частично отключена.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
		,
		"СчетГруппа",
		"Объект");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьЭлементов()
	
	Если ПравоДоступаИзменение Тогда
		
		НовДоступностьТаблицы	= ЗначениеЗаполнено(Объект["Организация"]) И ГруппаСчетовПоддерживается;
		НовДоступностьКомиссия	= ЗначениеЗаполнено(Объект["Организация"]);
		
		// Отдельные элементы
		Элементы["СтраницаМатериалы"].ТолькоПросмотр	= НЕ НовДоступностьТаблицы;
		Элементы["СтраницаНедостачи"].ТолькоПросмотр	= НЕ НовДоступностьТаблицы;
		Элементы["СтраницаИзлишки"].ТолькоПросмотр		= НЕ НовДоступностьТаблицы;
		
		// Кнопки (6)
		Элементы["МатериалыЗаполнитьПоДаннымУчета"].Доступность			= НовДоступностьТаблицы;
		Элементы["МатериалыЗаполнитьФактическоеНаличие"].Доступность	= НовДоступностьТаблицы;
		Элементы["НедостачиЗаполнитьНедостачи"].Доступность				= НовДоступностьТаблицы;
		Элементы["ИзлишкиЗаполнитьИзлишки"].Доступность					= НовДоступностьТаблицы;
		
		// Инвентаризационная комиссия
		Элементы["СтраницаИнвентаризация"].ТолькоПросмотр			= НЕ НовДоступностьКомиссия;
		Элементы["УстановитьПериод"].Доступность					= НовДоступностьКомиссия;
		Элементы["КомандаВыбратьКомиссию"].Доступность				= НовДоступностьКомиссия;
		Элементы["ВыбратьПредседателяКомиссии"].Доступность			= НовДоступностьКомиссия;
		Элементы["СоставКомиссииПодобратьСотрудников"].Доступность	= НовДоступностьКомиссия;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ОчиститьНеподдерживаемоеЗначениеСубконтоДляМОЛ(СвойстваВыбраннойГруппыСчетов)
	
	ПроверяемоеЗначение = Объект["ЦМО"];
	
	ТипыЗначений = СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["СвойстваСубконтоДляМОЛ"]["ТипыЗначений"];
	
	Если ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда
		// Оставляем текущее значение, если его тип по-прежнему является допустимым
		
		ТипЗначения = ТипЗнч(ПроверяемоеЗначение);
		
		ТипЗначенияДопустимый = НЕ (ТипыЗначений.Найти(ТипЗначения) = Неопределено);
		
		Если ТипЗначенияДопустимый Тогда
			НовоеЗначение = ПроверяемоеЗначение;
		Иначе
			НовоеЗначение = Неопределено;
		КонецЕсли;
		
	Иначе
		// Очищаем значение
		
		НовоеЗначение = Неопределено;
	КонецЕсли;
	
	Если НЕ ПроверяемоеЗначение = НовоеЗначение Тогда
		ПроверяемоеЗначение = НовоеЗначение;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНеподдерживаемоеЗначениеДополнительногоСубконто(СвойстваВыбраннойГруппыСчетов)
	
	КорректностьНастроек						= СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["КорректностьНастроекДополнительногоСубконто"];
	ТипыЗначенийРеальныхДополнительныхСубконто	= СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["СвойстваДопустимыхСчетов"]["ТипыЗначенийРеальныхДополнительныхСубконто"];
	
	ТекущееЗначение = Объект["Субконто3"];
	
	Если КорректностьНастроек["СледуетИспользовать"]
		И ЗначениеЗаполнено(ТекущееЗначение) Тогда
		// Дополнительное субконто используется
		// Оставляем текущее значение, если его тип по-прежнему является допустимым
		
		ТипЗначения = ТипЗнч(ТекущееЗначение);
		
		ТипЗначенияДопустимый = НЕ (ТипыЗначенийРеальныхДополнительныхСубконто.Найти(ТипЗначения) = Неопределено);
		
		Если ТипЗначенияДопустимый Тогда
			НовоеЗначение = ТекущееЗначение;
		Иначе
			НовоеЗначение = Неопределено;
		КонецЕсли;
		
	Иначе
		// Дополнительное субконто не используется
		// Очищаем значение
		
		НовоеЗначение = Неопределено;
	КонецЕсли;
	
	Если НЕ ТекущееЗначение = НовоеЗначение Тогда
		Объект["Субконто3"] = НовоеЗначение;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	
	Документы.ИнвентаризацияМЗ.ИнициализироватьРеквизитыФормыДляНастроекГруппСчетов(ЭтаФорма);
	
	УстановитьУсловноеОформление();
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеальноеДополнительноеСубконтоВТекущейСтроке(ТекущиеДанные)
	
	ВставляемыеЗначения = Новый Структура("
		|РеальноеДополнительноеСубконто,
		|НомерРеальногоДополнительногоСубконто,
		|Субконто3");
	
	// Обновляем служебную колонку
	ТаблицаАналитики = ЭтаФорма["НастройкиГруппСчетов_ТаблицаАналитикиДопустимыхСчетов"];
	Поиск = Новый Структура("Счет");
	ЗаполнитьЗначенияСвойств(Поиск, ТекущиеДанные);
	МассивСтрок = ТаблицаАналитики.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ВставляемыеЗначения, МассивСтрок[0]);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВставляемыеЗначения);
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКэшДатаИнвентаризации(Форма)
	
	Форма["КэшДатаИнвентаризации"] = Форма.Объект["ДатаИнвентаризации"];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВосстановитьИзКэшаДатаИнвентаризации(Форма)
	
	Форма.Объект["ДатаИнвентаризации"] = Форма["КэшДатаИнвентаризации"];
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ОбновитьКэшДатаИнвентаризации(ЭтаФорма);
		
		ЭтаФорма.Модифицированность = Истина;
		
		НастроитьФормуПоВыбраннойГруппеСчетов(Истина, Истина);
		
		// Прослеживаемость
		НастроитьФормуПрослеживаемостьСервер();
		// Конец Прослеживаемость
		
	Иначе
		
		ВосстановитьИзКэшаДатаИнвентаризации(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

