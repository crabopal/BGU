&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле Организация не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЦМО) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле МОЛ не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ЦМО");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьНедостачуИзлишек(ТекДанные)
	
	Если Объект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г. Счет в шапке
		
		ДельтаКолво = ТекДанные["КоличествоУчет"] - ТекДанные["КоличествоФакт"];
		ДельтаСумма = ТекДанные["СуммаУчет"] - ТекДанные["СуммаФакт"];
			
		// Недостача
		ТекДанные["НедостачаКоличество"]	= ?(ДельтаКолво>0, ДельтаКолво, 0);
		ТекДанные["НедостачаСумма"]			= ?(ДельтаСумма>0, ДельтаСумма, 0);
		
		// Излишек
		ТекДанные["ИзлишекКоличество"]		= ?(ДельтаКолво<0, -ДельтаКолво, 0);
		ТекДанные["ИзлишекСумма"]			= ?(ДельтаСумма<0, -ДельтаСумма, 0);
		
	Иначе
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(ЭтаФорма, ТекДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗначениеЦеныПоДаннымУчета(ТекущиеДанныеТаблицыМатериалы)
	
	Если ЗначениеЗаполнено(ТекущиеДанныеТаблицыМатериалы["КоличествоУчет"]) Тогда
		Возврат ТекущиеДанныеТаблицыМатериалы["СуммаУчет"] / ТекущиеДанныеТаблицыМатериалы["КоличествоУчет"];
		
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьЦенуСумму(ТекущиеДанные, Элемент)
	
	Перем ЦенаПоДаннымУчета;
	
	ИмяЭлемента = Элемент.Имя;
	
	// Таблица Материалы
	Если ИмяЭлемента = "МатериалыКоличествоФакт" Тогда
		ИмяИзмененногоПоля	= "КоличествоФакт";
		ИмяТабличнойЧасти	= "Материалы";
		
	ИначеЕсли ИмяЭлемента = "МатериалыЦена" Тогда
		ИмяИзмененногоПоля	= "Цена";
		ИмяТабличнойЧасти	= "Материалы";
		
	ИначеЕсли ИмяЭлемента = "МатериалыСуммаФакт" Тогда
		ИмяИзмененногоПоля	= "СуммаФакт";
		ИмяТабличнойЧасти	= "Материалы";
		
	// Таблица Излишки
	ИначеЕсли ИмяЭлемента = "ИзлишкиКоличество" Тогда
		ИмяИзмененногоПоля	= "Количество";
		ИмяТабличнойЧасти	= "Излишки";
		
	ИначеЕсли ИмяЭлемента = "ИзлишкиЦена" Тогда
		ИмяИзмененногоПоля	= "Цена";
		ИмяТабличнойЧасти	= "Излишки";
		
	ИначеЕсли ИмяЭлемента = "ИзлишкиСумма" Тогда
		ИмяИзмененногоПоля	= "Сумма";
		ИмяТабличнойЧасти	= "Излишки";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	//
	// Материалы
	//
	Если ИмяТабличнойЧасти = "Материалы" Тогда
		
		Если Объект["ВариантФормированияОписи"] = 0 Тогда
			// 0. Опись до 2018 г. Счет в шапке
			
			РассчитатьЦенуСумму_Материалы_Вариант0(ТекущиеДанные, ИмяИзмененногоПоля);
		Иначе
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			
			РассчитатьЦенуСумму_Материалы_Вариант123(ТекущиеДанные, ИмяИзмененногоПоля);
		КонецЕсли;
		
	//
	// Излишки
	//
	ИначеЕсли ИмяТабличнойЧасти = "Излишки" Тогда
		
		Если ИмяИзмененногоПоля = "Количество" ИЛИ ИмяИзмененногоПоля = "Цена" Тогда
			ТекущиеДанные["Сумма"] = ТекущиеДанные["Количество"] * ТекущиеДанные["Цена"];
			
		ИначеЕсли ИмяИзмененногоПоля = "Сумма" Тогда
			Если ТекущиеДанные["Количество"] = 0 Тогда
				Цена = 0;
			Иначе
				Цена = ТекущиеДанные["Сумма"] / ТекущиеДанные["Количество"];
			КонецЕсли;
			
			ТекущиеДанные["Цена"] = Цена;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦенуСумму_Материалы_Вариант0(ТекущиеДанные, ИмяИзмененногоПоля)
	
	// п.1 Недостача
	Недостача = (ТекущиеДанные["КоличествоУчет"] > 0 И ТекущиеДанные["КоличествоФакт"] < ТекущиеДанные["КоличествоУчет"]);
	
	// п.2 Расхождение отсутствует
	РасхождениеОтсутствует = (ТекущиеДанные["КоличествоУчет"] > 0 И ТекущиеДанные["КоличествоФакт"] = ТекущиеДанные["КоличествоУчет"]);
	
	// п.3 Излишек в отдельной строке
	ИзлишекВОтдельнойСтроке = (ТекущиеДанные["КоличествоУчет"] = 0);
	
	// п.4 Излишек в общей строке
	ИзлишекВОбщейСтроке = (ТекущиеДанные["КоличествоУчет"] > 0 И ТекущиеДанные["КоличествоФакт"] > ТекущиеДанные["КоличествоУчет"]);
	
	Если РасхождениеОтсутствует Тогда
		// Расхождение отсутствует, поэтому сумма по факту определяется как сумма по учету.
		// Цена является балансовой, и поэтому не редактируется
		
		ТекущиеДанные["Цена"] = ПолучитьЗначениеЦеныПоДаннымУчета(ТекущиеДанные);
		
		ТекущиеДанные["СуммаФакт"] = ТекущиеДанные["СуммаУчет"];
		
		Возврат;
		
	ИначеЕсли Недостача Тогда
		// При недостаче цена является балансовой, и поэтому не редактируется
		
		Цена = ПолучитьЗначениеЦеныПоДаннымУчета(ТекущиеДанные); // точность без округления
		
		ТекущиеДанные["Цена"] = Цена;
		
		ТекущиеДанные["СуммаФакт"] = ТекущиеДанные["КоличествоФакт"] * Цена;
		
		Возврат;
	КонецЕсли;
	
	Если ИзлишекВОбщейСтроке Тогда
		// Для излишка в общей строке доступно редактирование цены и суммы,
		// но только с соблюдением минимальных значений.
		
		МинимальнаяСумма	= ТекущиеДанные["СуммаУчет"];
		МинимальнаяЦена		= Окр(МинимальнаяСумма / ТекущиеДанные["КоличествоФакт"], 2);
	КонецЕсли;
	
	Если ИмяИзмененногоПоля = "КоличествоФакт" ИЛИ ИмяИзмененногоПоля = "Цена" Тогда
		// Рассчитываем поле СуммаФакт
		
		Если ИзлишекВОбщейСтроке Тогда
			Если ТекущиеДанные["Цена"] <= МинимальнаяЦена Тогда
				ТекущиеДанные["Цена"]		= МинимальнаяЦена;
				ТекущиеДанные["СуммаФакт"]	= МинимальнаяСумма;
				
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ТекущиеДанные["СуммаФакт"] = ТекущиеДанные["КоличествоФакт"] * ТекущиеДанные["Цена"];
		
	ИначеЕсли ИмяИзмененногоПоля = "СуммаФакт" Тогда
		// Рассчитываем поле Цена
		
		Если ИзлишекВОбщейСтроке Тогда
			Если ТекущиеДанные["СуммаФакт"] <= МинимальнаяСумма Тогда
				ТекущиеДанные["Цена"]		= МинимальнаяЦена;
				ТекущиеДанные["СуммаФакт"]	= МинимальнаяСумма;
				
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ТекущиеДанные["КоличествоФакт"] = 0 Тогда
			Цена = 0;
		Иначе
