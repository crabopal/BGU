&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	ПараметрыФормы = ИнвентаризацияКлиент.ПараметрыФормыРазбивкиСтрокиИнвентаризацииНфа();
	
	ПараметрыФормы.ИмяТабличнойЧасти = "Материалы";
	ПараметрыФормы.ТочностьКоличества = 3;
	
	ПараметрыФормы.СоответствиеИмен.КоличествоФакт	= "КоличествоФакт";
	ПараметрыФормы.СоответствиеИмен.СуммаФакт		= "СуммаФакт";
