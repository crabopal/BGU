&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИнициализироватьФорму();
	
	Если Объект.Ссылка.Пустая() Тогда
		
		// Этот документ создан копированием?
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			// Это копия существующего документа
			
			// Очищаем некоторые реквизиты
			Объект["Материалы"].Очистить();
			Объект["Недостачи"].Очистить();
			Объект["Излишки"].Очистить();
			Объект["Остатки"].Очистить();
			Объект["ПорядокСписания"].Очистить();
			
			// Выводим сообщение:
			ТекстСообщения = НСтр("ru='Этот документ был создан путем копирования другого документа. Поэтому некоторые табличные части и реквизиты копии были очищены.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	НастроитьФормуПоВыбраннойГруппеСчетов();
	
	НастроитьВидимостьКолонокТаблицыПорядокСписанияНедостач();
	
	ОпределитьКоличествоДокументовВведенныхНаОсновании();
	
	
	ИгнорироватьРеквизитКПС = НЕ НастройкиГруппСчетов_СвойстваВыбраннойГруппыСчетов["ДетальныеСвойства"]["СвойстваДопустимыхСчетов"]["УчетПоКПС"];
	
	ИнвентаризацияСервер.ВариантФормированияОписи0504087_ИнициализироватьФорму(ЭтаФорма, ИгнорироватьРеквизитКПС);
	
	ОбновитьКэшДатаИнвентаризации(ЭтаФорма);
	
	ДатыИзмененияСоставаГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьДатыИзмененияСоставаГруппСчетов();
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияМЗ.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	// Если нет прав на изменение документа, то дополнительно отключаем еще элементы:
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		// Кнопки (6)
		"МатериалыЗаполнитьПоДаннымУчета, МатериалыЗаполнитьФактическоеНаличие,"
		+ "НедостачиЗаполнитьНедостачи,"
		+ "ИзлишкиЗаполнитьИзлишки,"
		
		// Инвентаризационная комиссия
		+ "УстановитьПериод, КомандаВыбратьКомиссию, ВыбратьПредседателяКомиссии, СоставКомиссииПодобратьСотрудников"
		);
		
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
КонецПроцедуры

