&НаКлиенте
Процедура НастроитьСписокСчетов(Команда)
	
	Если ЗначениеЗаполнено(Объект["Организация"]) Тогда
		ПараметрыФормы = Новый Структура("Организация, ИФО, СчетГруппа");
		ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
		
		ПараметрыФормы.Вставить("Дата", Объект.ДатаИнвентаризации);
		
		ОткрытьФорму("РегистрСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ.Форма.НастройкаСпискаСчетов", ПараметрыФормы,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено. Список счетов редактируется только для конкретной организации, поэтому сначала выберите ее.'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
	КонецЕсли;
	
КонецПроцедуры

