#Область ОбработчикиСобытийЭлементовТаблицыФормы_Материалы

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы["Материалы"].ТекущиеДанные;
	
	// При копировании очищаем поля, заполняемые по данным учета:
	Если Копирование Тогда
		ОчищающаяСтруктура = Новый Структура("
			|КоличествоУчет,
			|СуммаУчет,
			|НедостачаКоличество,
			|НедостачаСумма,
			|ИзлишекКоличество,
			|ИзлишекСумма");
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	РедактируемаяСтрока = Новый Структура("Субконто3, Номенклатура, Цена, КоличествоФакт, СуммаФакт,
		|КоличествоУчет,
		|СуммаУчет,
		|НедостачаКоличество,
		|НедостачаСумма,
		|ИзлишекКоличество,
		|ИзлишекСумма");
	ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы["Материалы"].ТекущиеДанные;
	
	Если ОтменаРедактирования Тогда
		
		Если НЕ НоваяСтрока Тогда
			// Восстанавливаем значение всех полей строки,
			// которые были запомнены в момент начала ее редактирования:
			ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	РассчитатьНедостачуИзлишек(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	ТекДанные = Элементы["Материалы"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Прослеживаемость
	ТекДанные.ПрослеживаемыйТовар = Ложь;
	// Конец Прослеживаемость
	
	Номенклатура = ТекДанные["Номенклатура"];
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваНоменклатуры = ПолучитьСвойстваНоменклатурыСервер(Объект.Организация, Номенклатура, Объект.ТипЦен, Объект.ДатаИнвентаризации);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СвойстваНоменклатуры);
	
	Если ЗначениеЗаполнено(Объект.ТипЦен) Тогда
		РассчитатьЦенуСумму(ТекДанные, Элементы.МатериалыЦена);
		
		РассчитатьНедостачуИзлишек(ТекДанные);
	КонецЕсли;
	
	// Прослеживаемость
	ВозможноИзменениеВидимостиКолонкиПрослеживаемыйТовар = (СвойстваНоменклатуры.ПрослеживаемыйТовар <> ЕстьПрослеживаемыеТовары);
	Если ВозможноИзменениеВидимостиКолонкиПрослеживаемыйТовар Тогда
		НастроитьФормуПрослеживаемостьСервер();
	КонецЕсли;
	// Конец Прослеживаемость
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
