Функция ПолучитьСвойстваНоменклатурыСервер(Организация, Номенклатура, ТипЦены, ДатаЦены)
	
	СвойстваНоменклатуры = УправлениеМатериальнымиЗапасами.ПризнакиПрослеживаемостиНоменклатуры(
	ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Номенклатура),
	ДатаЦены);
	
	Если ЗначениеЗаполнено(ТипЦены) Тогда
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("Организация",		Организация);
		СтруктураПараметров.Вставить("Номенклатура",	Номенклатура);
		СтруктураПараметров.Вставить("ТипЦены",			ТипЦены);
		СтруктураПараметров.Вставить("ДатаЦены",		ДатаЦены);
		
		СвойстваНоменклатуры.Вставить("Цена", УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров));
	КонецЕсли;
	
	Возврат СвойстваНоменклатуры;
	
КонецФункции

// Прослеживаемость
&НаСервере
Процедура НастроитьФормуПрослеживаемостьСервер()
	
	ПрослеживаемостьФормыБГУ.НастроитьФормуИКолонкуПрослеживаемыйТовар(
		ЭтаФорма,
		Объект.ДатаИнвентаризации,
		"Материалы",
		"Номенклатура");
	
КонецПроцедуры
// Конец Прослеживаемость

&НаКлиенте
Процедура ПроверитьИЗаполнитьПрослеживаемыеТовары(ТолькоИзлишки)
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		Если Объект["ПрослеживаемыеТовары"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением прослеживаемых товаров будет очищена
				|табличная часть ""Прослеживаемые товары"".
				|
				|Продолжить и заполнить прослеживаемые товары?'");
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ТолькоИзлишки", ТолькоИзлишки);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПрослеживаемыеТовары_Выбор", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьПрослеживаемыеТоварыКлиент(ТолькоИзлишки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПрослеживаемыеТовары_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПрослеживаемыеТоварыКлиент(ПараметрыОповещения.ТолькоИзлишки);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПрослеживаемыеТоварыКлиент(ТолькоИзлишки)
	
	ЗаполнитьПрослеживаемыеТоварыСервер(ТолькоИзлишки);
	
	Если Объект["ПрослеживаемыеТовары"].Количество() = 0 Тогда
		
		ТекстШаблон = "%1
			|
			|%2";
		
		Если ТолькоИзлишки Тогда
			Текст1 = НСтр("ru='В излишках табличной части ""Материалы"" не выявлены прослеживаемые товары.'");
		Иначе
			Текст1 = НСтр("ru='В данных учёта табличной части ""Материалы"" не выявлены прослеживаемые товары.'");
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Текст1,
			НСтр("ru='Либо эти товары в полном объеме уже были зарегистрированы в системе прослеживаемости ранее.
				|В этом случае не требуется их повторная регистрация.'"));
		
		ПоказатьПредупреждение(, ТекстСообщения,, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьПрослеживаемыеТоварыСервер(ТолькоИзлишки)
	
	ПрослеживаемостьБГУ.ЗаполнитьПрослеживаемыеТовары(Объект, ТолькоИзлишки);
	
КонецПроцедуры

