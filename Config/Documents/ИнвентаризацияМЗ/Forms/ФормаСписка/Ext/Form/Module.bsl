&НаСервере
Процедура ОтборЗабалансовыйПриИзмененииНаСервере()
	
	ЭтоЗабалансовый = (ОтборЗабалансовый = 3);
	ЭтоВсеСчета = (ОтборЗабалансовый = 1);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
		"Счет.Забалансовый",	// ИмяПоля
		ЭтоЗабалансовый,	// ПравоеЗначение
		,	// ВидСравнения
		,	// Представление
		НЕ ЭтоВсеСчета);	// Использование
	
КонецПроцедуры

