#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
	Если Параметры.ПустойСчетУчета И Параметры.Отбор.Свойство("Счет") Тогда
		ГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор, , ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		Если ТипЗнч(Параметры.Отбор.Счет) = Тип("Массив")
			Или ТипЗнч(Параметры.Отбор.Счет) = Тип("ФиксированныйМассив") Тогда
			Счет = Новый СписокЗначений;
			Счет.ЗагрузитьЗначения(Параметры.Отбор.Счет);
		Иначе
			Счет = Параметры.Отбор.Счет;
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИли, "Счет", Счет);
		ЭлементОтбора = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Счет");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Параметры.Отбор.Удалить("Счет")
	КонецЕсли;
	Если Параметры.Отбор.Свойство("СчетГруппа")
		И Параметры.Отбор.СчетГруппа = БухгалтерскийУчет.СчетПоКоду("105.00") Тогда
		// в новом документе СчетГруппа может быть пустой, если пользователь его не менял
		ГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор, , ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИли, "СчетГруппа", Параметры.Отбор.СчетГруппа);
		ЭлементОтбора = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СчетГруппа");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Параметры.Отбор.Удалить("СчетГруппа")
	КонецЕсли;
	Если Параметры.Отбор.Свойство("ЦМО") Тогда
		ЦМО = Параметры.Отбор.ЦМО;
		Если ЗначениеЗаполнено(ЦМО) И ТипЗнч(ЦМО) = Тип("СправочникСсылка.ЦМО") Тогда
			Параметры.Отбор.Удалить("ЦМО");
			Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМО, "Сотрудник");
			ГруппаЦМОИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор, , ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаЦМОИли, "ЦМО", ЦМО);
			ЭлементОтбора = ГруппаЦМОИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦМО");
			ЭлементОтбора.ПравоеЗначение = Сотрудник;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти