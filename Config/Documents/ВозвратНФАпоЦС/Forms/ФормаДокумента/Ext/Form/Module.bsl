#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередаваемыеПроводкиСодержаниеЗавершениеВвода(Знач ВведенныйТекст, Знач ДополнительныеПараметры) Экспорт
	
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	ТекущиеДанные.Содержание = ВведенныйТекст;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПодставитьЗначенияСубконтоПоУмолчанию(ТекущиеДанные, ПараметрыПодстановки)

	Если ПараметрыПодстановки.СторонаПроводки = "Дт" Тогда
		Элементы.ПередаваемыеПроводкиСубконтоДт1.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
		ТекущиеДанные.СубконтоДт1 = Объект.Поставщик;
		ТекущиеДанные.СубконтоДт2 = Объект.Договор;
	Иначе
		Элементы.ПередаваемыеПроводкиСубконтоКт1.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
		ТекущиеДанные.СубконтоКт1 = Объект.Получатель;
	КонецЕсли;

КонецПроцедуры // ПодставитьЗначенияСубконтоПоУмолчанию()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРеквизитыСчета(Счет, ДанныеСтроки, Сторона = "Дт")

	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
		ДанныеСтроки["Счет" + Сторона + "УчетПоПодразделениям"]	= СвойстваСчета.УчетПоПодразделениям;
		ДанныеСтроки["Счет" + Сторона + "УчетПоКПС"] 			= СвойстваСчета.УчетПоКПС;
		ДанныеСтроки["Счет" + Сторона + "УчетПоКЭК"] 			= СвойстваСчета.УчетПоКЭК;
		ДанныеСтроки["Счет" + Сторона + "КоличествоСубконто"] 	= СвойстваСчета.КоличествоСубконто;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьТолькоПросмотрРеквизитовСтрокиПроводок()

	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетДт) Тогда
		ТекущиеДанные.СчетДтУчетПоПодразделениям	= Ложь;
		ТекущиеДанные.СчетДтУчетПоКПС				= Ложь;
		ТекущиеДанные.СчетДтУчетПоКЭК				= Ложь;
		ТекущиеДанные.СчетДтКоличествоСубконто		= 0;
	КонецЕсли;
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиПодразделениеДт",	НЕ ТекущиеДанные.СчетДтУчетПоПодразделениям);
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиКПСДт", 				НЕ ТекущиеДанные.СчетДтУчетПоКПС);
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиКЭКДт", 				НЕ ТекущиеДанные.СчетДтУчетПоКЭК);
	
	Если ТекущиеДанные.СчетДтКоличествоСубконто > 0 Тогда
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт1", 	Ложь);
		Если ТекущиеДанные.СчетДтКоличествоСубконто > 1 Тогда
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт2", 	Ложь);
			Если ТекущиеДанные.СчетДтКоличествоСубконто > 2 Тогда
				УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт3",	Ложь);
			Иначе
				УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт3", 	Истина);	
			КонецЕсли;
		Иначе
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт2",	Истина);
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт3", 	Истина);
		КонецЕсли;
	Иначе
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт1", 	Истина);
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт2", 	Истина);
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоДт3", 	Истина);
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетКт) Тогда
		ТекущиеДанные.СчетКтУчетПоПодразделениям	= Ложь;
		ТекущиеДанные.СчетКтУчетПоКПС				= Ложь;
		ТекущиеДанные.СчетКтУчетПоКЭК				= Ложь;
		ТекущиеДанные.СчетКтКоличествоСубконто		= 0;
	КонецЕсли;
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиПодразделениеКт",	НЕ ТекущиеДанные.СчетКтУчетПоПодразделениям);
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиКПСКт",	 			НЕ ТекущиеДанные.СчетКтУчетПоКПС);
	УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиКЭККт", 				НЕ ТекущиеДанные.СчетКтУчетПоКЭК);
	
	Если ТекущиеДанные.СчетКтКоличествоСубконто > 0 Тогда
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт1", 	Ложь);
		Если ТекущиеДанные.СчетКтКоличествоСубконто > 1 Тогда
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт2", 	Ложь);
			Если ТекущиеДанные.СчетКтКоличествоСубконто > 2 Тогда
				УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт3",	Ложь);
			Иначе
				УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт3", 	Истина);	
			КонецЕсли;
		Иначе
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт2",	Истина);
			УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт3", 	Истина);
		КонецЕсли;
	Иначе
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт1", 	Истина);
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт2", 	Истина);
		УстановитьТолькоПросмотрЭлементаФормы("ПередаваемыеПроводкиСубконтоКт3", 	Истина);
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьРеквизитовСтрокиПроводок()

&НаКлиенте
Процедура УстановитьТолькоПросмотрЭлементаФормы(ИмяЭлемента, ТолькоПросмотр)

	Если Элементы[ИмяЭлемента].ТолькоПросмотр <> ТолькоПросмотр Тогда
		Элементы[ИмяЭлемента].ТолькоПросмотр = ТолькоПросмотр;
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьЭлементаФормы()

&НаСервере
Процедура ПрочитатьПередаваемыеПроводки()

	Для каждого ТекСтр Из Объект.ПередаваемыеПроводки Цикл
	
		УстановитьРеквизитыСчета(ТекСтр.СчетДт, ТекСтр, "Дт");	
		УстановитьРеквизитыСчета(ТекСтр.СчетКт, ТекСтр, "Кт");	
	
	КонецЦикла; 

КонецПроцедуры // ПрочитатьПередаваемыеПроводки()

&НаСервере
Процедура ЗаполнитьНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

КонецПроцедуры // ЗаполнитьНаСервере()

&НаСервере
Функция ОграничениеСчета(ДтКт = "Дт", РезультатВМассив = Ложь)

	ОграниченияСчета = Неопределено;
	Если ДтКт = "Дт" Тогда
		ОграниченияСчета =  БухгалтерскийУчет.СписокСчетов("206.00,302.00", Объект.Дата,, Объект.Организация);
	Иначе
		ОграниченияСчета = БухгалтерскийУчет.СчетПоКоду("304.04", Объект.Дата, Объект.Организация);
	КонецЕсли;		
		
	Если РезультатВМассив Тогда
		Если ТипЗнч(ОграниченияСчета) = Тип("Массив") Тогда
		ИначеЕсли ТипЗнч(ОграниченияСчета) <> Тип("СписокЗначений") Тогда
			Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОграниченияСчета);
		Иначе
			Возврат ОграниченияСчета.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОграниченияСчета;
	
КонецФункции

&НаСервере
Функция СчетУчетаНФА(ВидНФА = "ОС")
	
	Если ВидНФА = "ОС" Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("05.1", Объект.Дата, Объект.Организация);
	Иначе
		Возврат БухгалтерскийУчет.СчетПоКоду("05.2", Объект.Дата, Объект.Организация);
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");

КонецФункции // СчетУчетаНФА()

&НаКлиенте
Процедура ПроверитьПодстановкуЗначенийСубконтоПоУмолчанию()

	ПараметрыПодстановкиДт = Новый Структура("СторонаПроводки", "Дт");
	ПараметрыПодстановкиКт = Новый Структура("СторонаПроводки", "Кт");
	Для каждого ТекПроводка Из Объект.ПередаваемыеПроводки Цикл
	
		ПодставитьЗначенияСубконтоПоУмолчанию(ТекПроводка, ПараметрыПодстановкиДт);
		ПодставитьЗначенияСубконтоПоУмолчанию(ТекПроводка, ПараметрыПодстановкиКт);
	
	КонецЦикла; 

КонецПроцедуры // ПроверитьПод()

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти
	
