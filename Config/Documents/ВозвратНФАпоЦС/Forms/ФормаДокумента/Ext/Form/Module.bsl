&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПередаваемыеПроводки

&НаКлиенте
Процедура ПередаваемыеПроводкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	УстановитьТолькоПросмотрРеквизитовСтрокиПроводок();
КонецПроцедуры

&НаКлиенте
Процедура ПередаваемыеПроводкиКФОПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   ТекущиеДанные.КФО,
											   Объект.Дата,
											   ТекущиеДанные.КПСДт,
											   ТекущиеДанные.КПСКт);
КонецПроцедуры

&НаКлиенте
Процедура ПередаваемыеПроводкиКПСДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПСДт, 
													Объект.Организация,
													Объект.ИФО,
													ТекущиеДанные.КФО,
													ТекущиеДанные.СчетДт,
