#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
		
		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			ГраницаЗапроса = Ссылка.Дата;//Новый Граница(Ссылка, ВидГраницы.Исключая);
		Иначе
			ГраницаЗапроса = КонецДня(ТекущаяДатаСеанса());//Новый Граница(КонецДня(ТекущаяДатаСеанса()), ВидГраницы.Включая);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Извещение", ДанныеЗаполнения);
		Запрос.УстановитьПараметр("ДатаКонца", ГраницаЗапроса);
		Запрос.УстановитьПараметр("Счет05"	 , БухгалтерскийУчет.СписокСчетов("05"));
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИзвещениеИсходящее.Организация,
		               |	ИзвещениеИсходящее.ИФО,
		               |	ИзвещениеИсходящее.Получатель,
		               |	&Извещение КАК ДокументОснование,
		               |	ИзвещениеИсходящее.Поставщик
		               |ИЗ
		               |	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
		               |ГДЕ
		               |	ИзвещениеИсходящее.Ссылка = &Извещение
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЖурналПроводокЕПСБУОстатки.Счет,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто2,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто3,
		               |	ЖурналПроводокЕПСБУОстатки.КФО,
		               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
		               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
		               |ПОМЕСТИТЬ Остатки
		               |ИЗ
		               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаКонца, Счет В (&Счет05), , Субконто2 = &Извещение) КАК ЖурналПроводокЕПСБУОстатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИзвещениеИсходящееОсновныеСредства.ОсновноеСредство,
		               |	ИзвещениеИсходящееОсновныеСредства.КФО,
		               |	ИзвещениеИсходящееОсновныеСредства.СчетУчета,
		               |	Остатки.СуммаОстатокДт КАК Сумма,
		               |	ВЫБОР
		               |		КОГДА ИзвещениеИсходящееОсновныеСредства.Сумма <> Остатки.СуммаОстатокДт
		               |				И ИзвещениеИсходящееОсновныеСредства.Количество <> 0
		               |			ТОГДА ВЫРАЗИТЬ(Остатки.СуммаОстатокДт * ИзвещениеИсходящееОсновныеСредства.Количество / ИзвещениеИсходящееОсновныеСредства.Сумма КАК ЧИСЛО(10, 0))
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ИзвещениеИсходящее.ОсновныеСредства КАК ИзвещениеИсходящееОсновныеСредства
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		               |		ПО ИзвещениеИсходящееОсновныеСредства.ОсновноеСредство = Остатки.Субконто3
		               |ГДЕ
		               |	Остатки.СуммаОстатокДт <> 0
		               |	И ИзвещениеИсходящееОсновныеСредства.Ссылка = &Извещение
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИзвещениеИсходящееМатериалы.Номенклатура,
		               |	ИзвещениеИсходящееМатериалы.КФО,
		               |	ИзвещениеИсходящееМатериалы.СчетУчета,
		               |	Остатки.СуммаОстатокДт КАК Сумма,
		               |	ВЫБОР
		               |		КОГДА ИзвещениеИсходящееМатериалы.Сумма <> Остатки.СуммаОстатокДт
		               |				И ИзвещениеИсходящееМатериалы.Количество <> 0
		               |			ТОГДА Остатки.СуммаОстатокДт * ИзвещениеИсходящееМатериалы.Количество / ИзвещениеИсходящееМатериалы.Сумма
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ИзвещениеИсходящее.Материалы КАК ИзвещениеИсходящееМатериалы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		               |		ПО ИзвещениеИсходящееМатериалы.Номенклатура = Остатки.Субконто3
		               |ГДЕ
		               |	Остатки.СуммаОстатокДт <> 0
		               |	И ИзвещениеИсходящееМатериалы.Ссылка = &Извещение
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИзвещениеИсходящееВозвратнаяТара.Номенклатура,
		               |	ИзвещениеИсходящееВозвратнаяТара.КФО,
		               |	ИзвещениеИсходящееВозвратнаяТара.СчетУчета,
		               |	Остатки.СуммаОстатокДт КАК Сумма,
		               |	ВЫБОР
		               |		КОГДА ИзвещениеИсходящееВозвратнаяТара.Сумма <> Остатки.СуммаОстатокДт
		               |				И ИзвещениеИсходящееВозвратнаяТара.Количество <> 0
		               |			ТОГДА Остатки.СуммаОстатокДт * ИзвещениеИсходящееВозвратнаяТара.Количество / ИзвещениеИсходящееВозвратнаяТара.Сумма
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ИзвещениеИсходящее.ВозвратнаяТара КАК ИзвещениеИсходящееВозвратнаяТара
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		               |		ПО ИзвещениеИсходящееВозвратнаяТара.Номенклатура = Остатки.Субконто3
		               |ГДЕ
		               |	Остатки.СуммаОстатокДт <> 0
		               |	И ИзвещениеИсходящееВозвратнаяТара.Ссылка = &Извещение
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИзвещениеИсходящееПередаваемыеПроводки.КФО,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СчетДт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.КПСДт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.КЭКДт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоДт1,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоДт2,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоДт3,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.ПодразделениеДт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СчетКт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.КПСКт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.КЭККт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоКт1,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоКт2,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.СубконтоКт3,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.ПодразделениеКт,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.Сумма,
		               |	ИзвещениеИсходящееПередаваемыеПроводки.Содержание
		               |ИЗ
		               |	Документ.ИзвещениеИсходящее.ПередаваемыеПроводки КАК ИзвещениеИсходящееПередаваемыеПроводки
		               |ГДЕ
		               |	ИзвещениеИсходящееПередаваемыеПроводки.Ссылка = &Извещение";
		Результат = Запрос.ВыполнитьПакет();
		
		ШапкаДокумента = Результат[0].Выгрузить();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ШапкаДокумента[0]);
		
		ОсновныеСредства.Загрузить(Результат[2].Выгрузить());
		Материалы.Загрузить(Результат[3].Выгрузить());
		ВозвратнаяТара.Загрузить(Результат[4].Выгрузить());
		ПроводкиОригинал = Результат[5].Выгрузить();
		
		ВрТаблицаПроводок = ПередаваемыеПроводки.ВыгрузитьКолонки();
		
		ЕстьОшибкаЗаполнения = Ложь;
		Если ОсновныеСредства.Количество()>0 Тогда
			ВрОсновныеСредства = ОсновныеСредства.Выгрузить();
			ВрОсновныеСредства.Свернуть("КФО", "Сумма");
			Для каждого ТекВрОС Из ВрОсновныеСредства Цикл
			    СтруктураПоиска = Новый Структура(	"СчетДт, КЭКДт, СчетКт, КФО",
													БухгалтерскийУчет.СчетПоКоду("304.04", Дата, Организация),
													БухгалтерскийУчетПовтИсп.КЭКПоКоду("310"),
													БухгалтерскийУчет.СчетПоКоду("302.31", Дата, Организация),
													ТекВрОС.КФО);
				СоотвСтроки = ПроводкиОригинал.НайтиСтроки(СтруктураПоиска);									
				Если СоотвСтроки.Количество()=1 Тогда
					НовПроводка = ВрТаблицаПроводок.Добавить();
					НайденаПроводка = СоотвСтроки[0];
					НовПроводка.КФО				= НайденаПроводка.КФО;
					НовПроводка.СчетДт			= НайденаПроводка.СчетКт;
					НовПроводка.КПСДт			= НайденаПроводка.КПСКт;
					СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НовПроводка.СчетДт);
					Если ЗначениеЗаполнено(СвойстваСчета.КОСГУДт) Тогда
						НовПроводка.КЭКДт		= СвойстваСчета.КОСГУДт;	
					Иначе
						НовПроводка.КЭКДт		= НайденаПроводка.КЭККт;
					КонецЕсли;
					НовПроводка.СубконтоДт1		= НайденаПроводка.СубконтоКт1;
					НовПроводка.СубконтоДт2		= НайденаПроводка.СубконтоКт2;
					НовПроводка.СубконтоДт3		= НайденаПроводка.СубконтоКт3;
					НовПроводка.ПодразделениеДт	= НайденаПроводка.ПодразделениеКт;
					НовПроводка.СчетКт			= НайденаПроводка.СчетДт;
					НовПроводка.КПСКт			= НайденаПроводка.КПСДт;
					СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НовПроводка.СчетКт);
					Если ЗначениеЗаполнено(СвойстваСчета.КОСГУКт) Тогда
						НовПроводка.КЭККт		= СвойстваСчета.КОСГУКт;	
					Иначе
						НовПроводка.КЭККт		= НайденаПроводка.КЭКДт;
					КонецЕсли;
					НовПроводка.СубконтоКт1		= НайденаПроводка.СубконтоДт1;
					НовПроводка.СубконтоКт2		= НайденаПроводка.СубконтоДт2;
					НовПроводка.СубконтоКт3		= НайденаПроводка.СубконтоДт3;
					НовПроводка.ПодразделениеКт	= НайденаПроводка.ПодразделениеДт;
					НовПроводка.Сумма			= ТекВрОС.Сумма;
					НовПроводка.Содержание		= НайденаПроводка.Содержание;
				Иначе
					ЕстьОшибкаЗаполнения = Истина;	
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
		Если НЕ ЕстьОшибкаЗаполнения Тогда
		    Если Материалы.Количество() > 0 ИЛИ ВозвратнаяТара.Количество()>0 Тогда
				
				ВрМатериалы = Материалы.Выгрузить();
				Для каждого ТекВозврТара Из ВозвратнаяТара Цикл
					ЗаполнитьЗначенияСвойств(ВрМатериалы.Добавить(), ТекВозврТара);
				КонецЦикла; 
				
			ВрМатериалы.Свернуть("КФО", "Сумма");
			Для каждого ТекВрОС Из ВрМатериалы Цикл
			    СтруктураПоиска = Новый Структура(	"СчетДт, КЭКДт, СчетКт, КФО",
													БухгалтерскийУчет.СчетПоКоду("304.04", Дата, Организация),
													БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"),
													БухгалтерскийУчет.СчетПоКоду("302.34", Дата, Организация),
													ТекВрОС.КФО);
				СоотвСтроки = ПроводкиОригинал.НайтиСтроки(СтруктураПоиска);									
				Если СоотвСтроки.Количество()=1 Тогда
					НовПроводка = ВрТаблицаПроводок.Добавить();
					НайденаПроводка = СоотвСтроки[0];
					НовПроводка.КФО				= НайденаПроводка.КФО;
					НовПроводка.СчетДт			= НайденаПроводка.СчетКт;
					НовПроводка.КПСДт			= НайденаПроводка.КПСКт;
					СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НовПроводка.СчетДт);
					Если ЗначениеЗаполнено(СвойстваСчета.КОСГУДт) Тогда
						НовПроводка.КЭКДт		= СвойстваСчета.КОСГУДт;	
					Иначе
						НовПроводка.КЭКДт		= НайденаПроводка.КЭККт;
					КонецЕсли;
					НовПроводка.СубконтоДт1		= НайденаПроводка.СубконтоКт1;
					НовПроводка.СубконтоДт2		= НайденаПроводка.СубконтоКт2;
					НовПроводка.СубконтоДт3		= НайденаПроводка.СубконтоКт3;
					НовПроводка.ПодразделениеДт	= НайденаПроводка.ПодразделениеКт;
					НовПроводка.СчетКт			= НайденаПроводка.СчетДт;
					НовПроводка.КПСКт			= НайденаПроводка.КПСДт;
					СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НовПроводка.СчетКт);
					Если ЗначениеЗаполнено(СвойстваСчета.КОСГУКт) Тогда
						НовПроводка.КЭККт		= СвойстваСчета.КОСГУКт;	
					Иначе
						НовПроводка.КЭККт		= НайденаПроводка.КЭКДт;
					КонецЕсли;
					НовПроводка.СубконтоКт1		= НайденаПроводка.СубконтоДт1;
					НовПроводка.СубконтоКт2		= НайденаПроводка.СубконтоДт2;
					НовПроводка.СубконтоКт3		= НайденаПроводка.СубконтоДт3;
					НовПроводка.ПодразделениеКт	= НайденаПроводка.ПодразделениеДт;
					НовПроводка.Сумма			= ТекВрОС.Сумма;
					НовПроводка.Содержание		= НайденаПроводка.Содержание;
				Иначе
					ЕстьОшибкаЗаполнения = Истина;	
				КонецЕсли;
			КонецЦикла; 
				
			КонецЕсли;
		КонецЕсли; 
		
		Если ЕстьОшибкаЗаполнения Тогда
			ВрТаблицаПроводок.Очистить();
		КонецЕсли;
		ПередаваемыеПроводки.Загрузить(ВрТаблицаПроводок);
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ПередаваемыеПроводки.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли