#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачалоПериода", 			НачалоКвартала(Объект.ОтчетныйПериод));	
	ПараметрыФормы.Вставить("КонецПериода", 			Объект.ОтчетныйПериод);	
	ПараметрыФормы.Вставить("НарастающимИтогом", 		Ложь);	
	ПараметрыФормы.Вставить("БезПоследнегоКвартала", 	Ложь);	

	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаКвартал", ПараметрыФормы, Элементы.ПредставлениеПериодаРегистрации);
	
КонецПроцедуры

