&НаКлиенте
Процедура ПоКадастровойПриИзмененииПоказателяРасчета()
	
	ТекущиеДанные = Элементы.ПоКадастровой.ТекущиеДанные;
	
	ПараметрыРасчета = 
		РасчетИмущественныхНалоговКлиентСервер.ПараметрыРасчетаСуммаНалогаНаИмуществоПоКадастровойСтоимости();
	
	ЗаполнитьЗначенияСвойств(ПараметрыРасчета, ТекущиеДанные);
	
	ТекущиеДанные.СуммаИсчислено =
		РасчетИмущественныхНалоговКлиентСервер.СуммаНалогаНаИмуществоПоКадастровойСтоимости(ПараметрыРасчета);
	
	ГодовойРасчет = Месяц(Объект.ОтчетныйПериод) = 12;
	ТекущиеДанные.Сумма = ТекущиеДанные.СуммаИсчислено - ?(ГодовойРасчет, ТекущиеДанные.СуммаАванса, 0);

КонецПроцедуры

&НаКлиенте
Процедура ВыборКодаВидаИмущества(Элемент, СтандартнаяОбработка, Префикс)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Код вида имущества");
	ПараметрыФормы.Вставить("Префикс", Префикс);
	ПараметрыФормы.Вставить("ИмяМакета", "Документ.РегистрацияСтавкиНалогаНаИмущество.СпискиВыбора");
	ПараметрыФормы.Вставить("ТекущийПериод", Объект.ОтчетныйПериод);
	ПараметрыФормы.Вставить("ТекущийКод", Элемент.ТекстРедактирования);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

