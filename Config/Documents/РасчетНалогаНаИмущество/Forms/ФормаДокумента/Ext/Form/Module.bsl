&НаСервере
Функция НачатьЗаполнениеПоСреднейНаСервере()
	
	Объект.ПоСреднегодовой.Очистить();
	
	ПараметрыРасчета = РасчетИмущественныхНалогов.ПараметрыРасчетаНалогаНаИмущество();
	ПараметрыРасчета.Организация 	= Объект.Организация;
	ПараметрыРасчета.ОтчетныйПериод = Объект.ОтчетныйПериод;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение документа ""Расчета налога на имущество"" по среднегодовой стоимости'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат 
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"РасчетИмущественныхНалогов.ТаблицаРасчетаПоСреднегодовой", ПараметрыРасчета);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоСреднейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ТекстПредупреждения = НСтр("ru = 'При расчете возникла ошибка:
			|%1'");
		ТекстПредупреждения = СтрШаблон(ТекстПредупреждения, Результат.КраткоеПредставлениеОшибки);
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоСреднейЗавершениеНаСервере(Результат.АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСреднейЗавершениеНаСервере(Знач АдресРезультата)
	
	ТаблицаПоСреднегодовой = ПолучитьИзВременногоХранилища(АдресРезультата);	
	Для Каждого СтрокаРасчета Из ТаблицаПоСреднегодовой Цикл
		ЗаполнитьЗначенияСвойств(Объект.ПоСреднегодовой.Добавить(), СтрокаРасчета);
	КонецЦикла;
	УстановитьТребуетсяРасчетСреднегодовой(ЭтотОбъект, Ложь);

	УдалитьИзВременногоХранилища(АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетНалогаПоСреднегодовойСтоимости()
	
	ПараметрыРасчета = РасчетИмущественныхНалогов.ПараметрыРасчетаНалогаНаИмущество();
	ПараметрыРасчета.Организация 	= Объект.Организация;
    ПараметрыРасчета.ОтчетныйПериод = Объект.ОтчетныйПериод;
	
	ТаблицаПоСреднегодовой = РасчетИмущественныхНалогов.НоваяТаблицаПоСреднегодовой();
	Для каждого Строка Из Объект.ПоСреднегодовой Цикл
		НоваяСтрока = ТаблицаПоСреднегодовой.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.КодПоОКТМО = СокрЛП(Строка.КодПоОКТМО);
		Если Строка.ПорядокНалогообложения <> Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму Тогда
			НоваяСтрока.СуммаУменьшенияСуммыНалога = 0;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПоСреднегодовой.ЗаполнитьЗначения(0, "СуммаИсчислено,Сумма");
	Если КонецДня(ПараметрыРасчета.ОтчетныйПериод) <> КонецГода(ПараметрыРасчета.ОтчетныйПериод) Тогда
		ТаблицаПоСреднегодовой.ЗаполнитьЗначения(0,
			"СуммаАвансовыхПлатежей1Кв,СуммаАвансовыхПлатежей2Кв,СуммаАвансовыхПлатежей3Кв");
	КонецЕсли;
	
	РасчетИмущественныхНалогов.ВыполнитьРасчетНалогаПоСреднегодовойСтоимости(ТаблицаПоСреднегодовой, ПараметрыРасчета);
	Объект.ПоСреднегодовой.Загрузить(ТаблицаПоСреднегодовой);
	
	УстановитьТребуетсяРасчетСреднегодовой(ЭтотОбъект, Ложь);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТребуетсяРасчетСреднегодовой(Форма, ТребуетсяРасчет)
	
