	ТекущиеДанные = Элементы.ПоСреднегодовой.ТекущиеДанные;
	Если ТекущиеДанные.КодВидаИмущества <> 2 Тогда
		ТекущиеДанные.ДоляСтоимостиЧислитель = 0;
		ТекущиеДанные.ДоляСтоимостиЗнаменатель = 0;
	КонецЕсли;
	
	УстановитьТребуетсяРасчетСреднегодовой(ЭтотОбъект, Истина);
