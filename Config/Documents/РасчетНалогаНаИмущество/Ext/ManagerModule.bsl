Функция ПолучитьОбластиМакетаРасчет(Макет, ОтчетныйПериод, ГодовойРасчет)
	
	ОбластиМакета = Новый Структура;
	
	Аванс = ?(ГодовойРасчет, "", СтрШаблон("Аванс%1кв", Формат(ОтчетныйПериод, "ДФ=к")));
	
	ОбластиМакета.Вставить("ШапкаСреднегодовой", 	Макет.ПолучитьОбласть("ШапкаСреднегодовой" 	+ Аванс));
	ОбластиМакета.Вставить("НОСреднегодовой", 		Макет.ПолучитьОбласть("НОСреднегодовой" 	+ Аванс));
	ОбластиМакета.Вставить("ОКТМОСреднегодовой", 	Макет.ПолучитьОбласть("ОКТМОСреднегодовой" 	+ Аванс));
	ОбластиМакета.Вставить("РасчетСреднегодовой", 	Макет.ПолучитьОбласть("РасчетСреднегодовой" + Аванс));
	ОбластиМакета.Вставить("СтрокаСреднегодовой", 	Макет.ПолучитьОбласть("СтрокаСреднегодовой" + Аванс));
	ОбластиМакета.Вставить("РасчетСреднегодовойЛьгота",
													Макет.ПолучитьОбласть("РасчетСреднегодовойЛьгота" + Аванс));
	ОбластиМакета.Вставить("ИтогиСреднегодовой", 	Макет.ПолучитьОбласть("ИтогиСреднегодовой"  + Аванс));
	
	Аванс = ?(ГодовойРасчет, "", "Аванс");
	
	ОбластиМакета.Вставить("ШапкаПоКадастровой", 	Макет.ПолучитьОбласть("ШапкаПоКадастровой" 	+ Аванс));
	ОбластиМакета.Вставить("НОПоКадастровой", 		Макет.ПолучитьОбласть("НОПоКадастровой"		+ Аванс));
	ОбластиМакета.Вставить("ОКТМОПоКадастровой", 	Макет.ПолучитьОбласть("ОКТМОПоКадастровой" 	+ Аванс));
	ОбластиМакета.Вставить("СтрокаПоКадастровой", 	Макет.ПолучитьОбласть("СтрокаПоКадастровой" + Аванс));
	ОбластиМакета.Вставить("ИтогиПоКадастровой", 	Макет.ПолучитьОбласть("ИтогиПоКадастровой"  + Аванс));
	
	Возврат ОбластиМакета;
	
КонецФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Если СтруктураДополнительныеСвойства.Свойство("ГодовойРасчет")
		И СтруктураДополнительныеСвойства.ГодовойРасчет Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Запрос.Текст =
