#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РасчетНалогаНаИмущество";
	КомандаПечати.Идентификатор		= "РасчетНалогаНаИмущество";
	КомандаПечати.Представление		= НСтр("ru = 'Расчет налога на имущество'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РасчетНалогаНаИмущество") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"РасчетНалогаНаИмущество",
			НСтр("ru = 'Расчет налога на имущество'"),
			ПечатьРасчетНалогаНаИмущество(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из СправочникОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьРасчетНалогаНаИмущество(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПараметрыПечати_РасчетНИ";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РасчетНалогаНаИмущество.ПФ_MXL_РасчетНалогаНаИмущество");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьПодписи		= Макет.ПолучитьОбласть("Подписи");
	ОбщиеСведения       = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = ТекстЗапросаПечатьРасчета(НомераТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументов 				= Результат[НомераТаблиц.ВыборкаДокументов]		.Выбрать();
	ВыборкаПоСреднегодовойРасчет 	= Результат[НомераТаблиц.ПоСреднегодовойРасчет]	.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПоКадастровой 			= Результат[НомераТаблиц.ПоКадастровой]			.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаПоСреднегодовой 			= Результат[НомераТаблиц.ПоСреднегодовой]		.Выгрузить();
	Для каждого Строка Из ТаблицаПоСреднегодовой Цикл
		Строка.КодПоОКТМО = СокрЛП(Строка.КодПоОКТМО);	
	КонецЦикла;

	КолонкиГруппировокПоСтавке = ""
		+ "Ссылка,"
		+ "НалоговыйОрган,"
		+ "КодПоОКТМО,"
		+ "КодВидаИмущества,"
		+ "ДоляСтоимостиЧислитель,"
		+ "ДоляСтоимостиЗнаменатель,"
		+ "НалоговаяСтавка";

	КолонкиГруппировокПоЛьготе = КолонкиГруппировокПоСтавке + ","
		+ "ПорядокНалогообложения,"
		+ "КодНалоговойЛьготы,"
		+ "КодОснованияЛьготы,"
		+ "ПроцентУменьшенияСуммыНалога";
	
	ТаблицаПоСреднегодовой.Индексы.Добавить(КолонкиГруппировокПоСтавке);
	ТаблицаПоСреднегодовой.Индексы.Добавить(КолонкиГруппировокПоЛьготе);

	ПараметрыПоСреднегодовой = Новый Структура;
	ПараметрыПоСреднегодовой.Вставить("ТаблицаПоСреднегодовой", 		ТаблицаПоСреднегодовой);
	ПараметрыПоСреднегодовой.Вставить("ТребуетсяРасчетСреднегодовой", 	Ложь);
	ПараметрыПоСреднегодовой.Вставить("ГодовойРасчет",					Истина);
	ПараметрыПоСреднегодовой.Вставить("ОтчетныйПериод",					Дата(1,1,1));
	ПараметрыПоСреднегодовой.Вставить("Организация",					Справочники.Организации.ПустаяСсылка());
	ПараметрыПоСреднегодовой.Вставить("КолонкиГруппировокПоСтавке",		КолонкиГруппировокПоСтавке);
	ПараметрыПоСреднегодовой.Вставить("КолонкиГруппировокПоЛьготе",		КолонкиГруппировокПоЛьготе);
	ПараметрыПоСреднегодовой.Вставить("ОтборПоСтавке",					Новый Структура(КолонкиГруппировокПоСтавке));
	ПараметрыПоСреднегодовой.Вставить("ОтборСтрок",						Новый Структура(КолонкиГруппировокПоЛьготе));
	ПараметрыПоСреднегодовой.Вставить("ЧислоПериодов",					1);
	ПараметрыПоСреднегодовой.Вставить("НомерПоПорядку",					0);
	
	Первый = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не Первый Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЗначенияЗаполнения = Новый Структура;
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияЗаполнения, ВыборкаДокументов.Ссылка, 
			ОбщиеСведения);
		ЗначенияЗаполнения.Вставить("Номер",
			ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер));
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ВыборкаДокументов.Дата);
		ЗначенияЗаполнения.Вставить("Дата",   ВыборкаДокументов.Дата);			
		ЗначенияЗаполнения.Вставить("Дня",    СтруктураДаты.Число);
		ЗначенияЗаполнения.Вставить("Месяца", СтруктураДаты.Месяц);
		ЗначенияЗаполнения.Вставить("Года",   СтруктураДаты.Год);
		
		ГодовойРасчет = Месяц(ВыборкаДокументов.ОтчетныйПериод) = 12;
		НачалоПериода = ?(ГодовойРасчет, НачалоГода(ВыборкаДокументов.ОтчетныйПериод),
			НачалоКвартала(ВыборкаДокументов.ОтчетныйПериод));
			
		Если ГодовойРасчет Тогда
			НачалоПериода = НачалоГода(ВыборкаДокументов.ОтчетныйПериод);
			ШаблонПериода = НСтр("ru = 'за налоговый период %1'");
		Иначе	
			НачалоПериода = НачалоКвартала(ВыборкаДокументов.ОтчетныйПериод);
			ШаблонПериода = НСтр("ru = 'за отчетный период %1'");
		КонецЕсли;	
			
		ПредставлениеОтчетногоПериода = СтрШаблон(ШаблонПериода,
			ПредставлениеПериода(НачалоПериода, ВыборкаДокументов.ОтчетныйПериод, "ФП = Истина"));		
			
		ЗначенияЗаполнения.Вставить("ПредставлениеОтчетногоПериода", ПредставлениеОтчетногоПериода);
		ОбластьЗаголовок.Параметры.Заполнить(ЗначенияЗаполнения);		
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластиМакета = ПолучитьОбластиМакетаРасчет(Макет, ВыборкаДокументов.ОтчетныйПериод, ГодовойРасчет);
		
		ВыборкаПоСреднегодовойРасчет.Сбросить();
		Если ВыборкаПоСреднегодовойРасчет.НайтиСледующий(ВыборкаДокументов.Ссылка, "Ссылка") Тогда
			
			ПараметрыПоСреднегодовой.ТребуетсяРасчетСреднегодовой = ВыборкаДокументов.ТребуетсяРасчетСреднегодовой;
			ПараметрыПоСреднегодовой.ЧислоПериодов = Месяц(ВыборкаДокументов.ОтчетныйПериод) + 1;
			ПараметрыПоСреднегодовой.ГодовойРасчет = ГодовойРасчет;
			ПараметрыПоСреднегодовой.ОтчетныйПериод = ВыборкаДокументов.ОтчетныйПериод;
			ПараметрыПоСреднегодовой.Организация   = ВыборкаДокументов.Организация;
			
			ВывестиНаПечатьРасчетПоСреднегодовой(ВыборкаПоСреднегодовойРасчет, ТабличныйДокумент, 
				ОбластиМакета, ПараметрыПоСреднегодовой);
			
		КонецЕсли;
		
		ВыборкаПоКадастровой.Сбросить();
		Если ВыборкаПоКадастровой.НайтиСледующий(ВыборкаДокументов.Ссылка, "Ссылка") Тогда
			ВывестиНаПечатьРасчетПоКадастровой(ВыборкаПоКадастровой, ТабличныйДокумент, ОбластиМакета);
		КонецЕсли;
		
		СведенияПоДокументу = ОбщиеСведения[ВыборкаДокументов.Ссылка];
		
		ТребуемыеДанные          = "ДолжностьНаименование,НаименованиеПолное";
		ДанныеГлавногоБухгалтера = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаДокументов.ГлавныйБухгалтер, 
			ТребуемыеДанные, ВыборкаДокументов.Дата);
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ДолжностьГлБух",   ДанныеГлавногоБухгалтера.ДолжностьНаименование);
		ФИОГлБух = КорреспондентыКлиентСервер.ФИО(ДанныеГлавногоБухгалтера.НаименованиеПолное);
		ЗначенияЗаполнения.Вставить("ФИОГлБух",         ФИОГлБух);
		ЗначенияЗаполнения.Вставить("Должность",        СведенияПоДокументу.ОтветственныйДолжность);
		ЗначенияЗаполнения.Вставить("ФИО",              СведенияПоДокументу.ОтветственныйФамилияИнициалы);
		ЗначенияЗаполнения.Вставить("НомерТелефона",    СведенияПоДокументу.ОтветственныйТелефон);
		ЗначенияЗаполнения.Вставить("ЭлектроннаяПочта", СведенияПоДокументу.ОтветственныйЭлПочта);
		
		ОбластьПодписи.Параметры.Заполнить(ЗначенияЗаполнения);
		ТабличныйДокумент.Вывести(ОбластьПодписи);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
		
	ТабличныйДокумент.ФиксацияСлева = 2;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ВывестиНаПечатьРасчетПоСреднегодовой(ВыборкаПоСреднегодовойРасчет, ТабличныйДокумент,
												ОбластиМакета, ПараметрыПоСреднегодовой)

	ОбластьШапка 		= ОбластиМакета.ШапкаСреднегодовой;

	ОбластьНО 			= ОбластиМакета.НОСреднегодовой;
	ОбластьОКТМО 		= ОбластиМакета.ОКТМОСреднегодовой;
	ОбластьРасчет 		= ОбластиМакета.РасчетСреднегодовой;
	ОбластьРасчетЛьгота = ОбластиМакета.РасчетСреднегодовойЛьгота;
	ОбластьСтрока 		= ОбластиМакета.СтрокаСреднегодовой;
	ОбластьИтоги 		= ОбластиМакета.ИтогиСреднегодовой;

	ПараметрыПоСреднегодовой.НомерПоПорядку = 0;
	ИменаКолонокОстаточнаяСтоимость = РасчетИмущественныхНалогов.ИменаКолонокОстаточнаяСтоимость();
	КолонкиСуммирования = СтрСоединить(ИменаКолонокОстаточнаяСтоимость, ",");
	КолонкиСуммирования = КолонкиСуммирования + ","
		+ "СуммаИсчислено,"
		+ "СуммаУменьшенияСуммыНалога,"
		+ "СуммаАвансовыхПлатежей1Кв,"
		+ "СуммаАвансовыхПлатежей2Кв,"
		+ "СуммаАвансовыхПлатежей3Кв,"
		+ "Сумма";

	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТекстПредупреждения", ?(ПараметрыПоСреднегодовой.ТребуетсяРасчетСреднегодовой,
		НСтр("ru = 'расчет не выполнен'"), ""));
	ОбластьШапка.Параметры.Заполнить(ЗначенияЗаполнения);

	ТабличныйДокумент.Вывести(ОбластьШапка);

	Аванс = ?(ПараметрыПоСреднегодовой.ГодовойРасчет, "", СтрШаблон("Аванс%1кв", Формат(
		ПараметрыПоСреднегодовой.ОтчетныйПериод, "ДФ=к")));

	ОбластьОстаточнаяСтоимость = ТабличныйДокумент.Области.Найти("ОстаточнаяСтоимость" + Аванс);
	Если ОбластьОстаточнаяСтоимость <> Неопределено Тогда
		ОбластьГруппировки = ТабличныйДокумент.Область( , ОбластьОстаточнаяСтоимость.Лево,
			ОбластьОстаточнаяСтоимость.Верх, ОбластьОстаточнаяСтоимость.Право);
		ОбластьГруппировки.Сгруппировать();
	КонецЕсли;

	ТаблицаПоСреднегодовой = ПараметрыПоСреднегодовой.ТаблицаПоСреднегодовой;
	КолонкиГруппировокПоЛьготе = ПараметрыПоСреднегодовой.КолонкиГруппировокПоЛьготе;
	ОтборПоСтавке = ПараметрыПоСреднегодовой.ОтборПоСтавке;
	НалогНаИмуществоОбъединятьЛисты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ПараметрыПоСреднегодовой.Организация, ПараметрыПоСреднегодовой.ОтчетныйПериод).НалогНаИмуществоОбъединятьЛисты;

	ВыборкаНО = ВыборкаПоСреднегодовойРасчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНО.Следующий() Цикл

		ОбластьНО.Параметры.Заполнить(ВыборкаНО);
		ТабличныйДокумент.Вывести(ОбластьНО, ВыборкаНО.Уровень());

		ВыборкаОКТМО = ВыборкаНО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОКТМО.Следующий() Цикл

			ОбластьОКТМО.Параметры.Заполнить(ВыборкаОКТМО);
			ТабличныйДокумент.Вывести(ОбластьОКТМО, ВыборкаОКТМО.Уровень());

			ВыборкаРасчет = ВыборкаОКТМО.Выбрать();

			Пока ВыборкаРасчет.Следующий() Цикл

				ЗаполнитьЗначенияСвойств(ОтборПоСтавке, ВыборкаРасчет);
				РасчетНалогаПоЛистам = ТаблицаПоСреднегодовой.Скопировать(ОтборПоСтавке);
				РасчетНалогаПоЛистам.Свернуть(КолонкиГруппировокПоЛьготе, КолонкиСуммирования);
				ЛистыСложения = РасчетИмущественныхНалогов.СложитьРасчетНалогаПоЛистам(РасчетНалогаПоЛистам,
					НалогНаИмуществоОбъединятьЛисты);

				ВывелиСложение = Ложь;	
				Если НалогНаИмуществоОбъединятьЛисты И ЛистыСложения.Сложение <> Неопределено Тогда

					ВывестиОбластьРасчетаНалоговойБазыПоСреднегодовой(ТабличныйДокумент, ОбластьРасчет,
						ЛистыСложения.Сложение, ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

					ВывестиОбластьРасчетаНалоговойБазыПоСреднегодовой(ТабличныйДокумент, ОбластьРасчетЛьгота,
						ЛистыСложения.Льготируемое, ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

 					ЗаполнитьЗначенияСвойств(ПараметрыПоСреднегодовой.ОтборСтрок, ЛистыСложения.Сложение);
					ВывестиДетальныеЗаписиРасчетПоСреднегодовой(ТабличныйДокумент, ОбластьСтрока,
						ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

 					ЗаполнитьЗначенияСвойств(ПараметрыПоСреднегодовой.ОтборСтрок, ЛистыСложения.Льготируемое);
					ВывестиДетальныеЗаписиРасчетПоСреднегодовой(ТабличныйДокумент, ОбластьСтрока,
						ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

					ВывелиСложение = Истина;

				КонецЕсли;

				Для каждого СтрокаТаблицы Из РасчетНалогаПоЛистам Цикл

					Если ВывелиСложение И (СтрокаТаблицы = ЛистыСложения.Сложение Или СтрокаТаблицы
						= ЛистыСложения.Льготируемое) Тогда
						Продолжить;
					КонецЕсли;

					ВывестиОбластьРасчетаНалоговойБазыПоСреднегодовой(ТабличныйДокумент, ОбластьРасчет,
						СтрокаТаблицы, ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

					ЗаполнитьЗначенияСвойств(ПараметрыПоСреднегодовой.ОтборСтрок, СтрокаТаблицы);
					ВывестиДетальныеЗаписиРасчетПоСреднегодовой(ТабличныйДокумент, ОбластьСтрока,
						ПараметрыПоСреднегодовой, ВыборкаРасчет.Уровень());

				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ОбластьИтоги.Параметры.Заполнить(ВыборкаПоСреднегодовойРасчет);
	ТабличныйДокумент.Вывести(ОбластьИтоги);

	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();

КонецПроцедуры

Процедура ВывестиОбластьРасчетаНалоговойБазыПоСреднегодовой(ТабличныйДокумент, ОбластьРасчет, СтрокаТаблицы,
			ПараметрыПоСреднегодовой, Уровень)

	ОбластьРасчет.Параметры.Заполнить(СтрокаТаблицы);
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("СредняяСтоимость", 0);
	ЗначенияЗаполнения.Вставить("ДоляСтоимости", "");
	ЗначенияЗаполнения.Вставить("НалоговаяЛьгота", "");
	ЗначенияЗаполнения.Вставить("КодНалоговойЛьготы", "");
	ИменаКолонокОстаточнаяСтоимость = РасчетИмущественныхНалогов.ИменаКолонокОстаточнаяСтоимость();
	
	ЗначенияЗаполнения.СредняяСтоимость = РасчетИмущественныхНалогов.СредняяСтоимостьЗаПериод(СтрокаТаблицы,
		ИменаКолонокОстаточнаяСтоимость, ПараметрыПоСреднегодовой.ЧислоПериодов, 0);

	ЗначенияЗаполнения.ДоляСтоимости = ПредставлениеКоэффициента(
		СтрокаТаблицы.ДоляСтоимостиЧислитель, СтрокаТаблицы.ДоляСтоимостиЗнаменатель);
		
	ЗначенияЗаполнения.НалоговаяЛьгота = ТекстНалоговойЛьготы(СтрокаТаблицы);
	ЗначенияЗаполнения.КодНалоговойЛьготы = ПредставлениеКодаНалоговойЛьготы(СтрокаТаблицы);
	
	ОбластьРасчет.Параметры.Заполнить(ЗначенияЗаполнения);
	ТабличныйДокумент.Вывести(ОбластьРасчет, Уровень);
	
КонецПроцедуры

Процедура ВывестиДетальныеЗаписиРасчетПоСреднегодовой(ТабличныйДокумент, ОбластьСтрока,
			ПараметрыПоСреднегодовой, Уровень);

	ТаблицаПоСреднегодовой = ПараметрыПоСреднегодовой.ТаблицаПоСреднегодовой;
	
	ТаблицаРасчет = ТаблицаПоСреднегодовой.Скопировать(ПараметрыПоСреднегодовой.ОтборСтрок);
	ТаблицаРасчет.Сортировать("ОсновноеСредствоНаименованиеПолное");
	
	Для каждого Строка Из ТаблицаРасчет Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Строка);
		
		ПараметрыПоСреднегодовой.НомерПоПорядку = ПараметрыПоСреднегодовой.НомерПоПорядку + 1;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ДоляСтоимости", ПредставлениеКоэффициента(
			Строка.ДоляСтоимостиЧислитель, Строка.ДоляСтоимостиЗнаменатель));
		ЗначенияЗаполнения.Вставить("НомерПоПорядку", ПараметрыПоСреднегодовой.НомерПоПорядку);
		ЗначенияЗаполнения.Вставить("НалоговаяЛьгота", ТекстНалоговойЛьготы(Строка));
		ЗначенияЗаполнения.Вставить("КодНалоговойЛьготы", ПредставлениеКодаНалоговойЛьготы(Строка));
		ОбластьСтрока.Параметры.Заполнить(ЗначенияЗаполнения);

		ТабличныйДокумент.Вывести(ОбластьСтрока, Уровень + 1);
	КонецЦикла;
														
КонецПроцедуры

Процедура ВывестиНаПечатьРасчетПоКадастровой(ВыборкаПоКадастровой, ТабличныйДокумент, ОбластиМакета)

	ОбластьШапка 	= ОбластиМакета.ШапкаПоКадастровой;

	ОбластьНО 		= ОбластиМакета.НОПоКадастровой;
	ОбластьОКТМО 	= ОбластиМакета.ОКТМОПоКадастровой;
	ОбластьСтрока 	= ОбластиМакета.СтрокаПоКадастровой;
	ОбластьИтоги 	= ОбластиМакета.ИтогиПоКадастровой;
	
	НомерПоПорядку = 0;
	
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ВыборкаНО = ВыборкаПоКадастровой.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНО.Следующий() Цикл
		
		ОбластьНО.Параметры.Заполнить(ВыборкаНО);
		ТабличныйДокумент.Вывести(ОбластьНО, ВыборкаНО.Уровень());
		
		ВыборкаОКТМО = ВыборкаНО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОКТМО.Следующий() Цикл
			
			ОбластьОКТМО.Параметры.Заполнить(ВыборкаОКТМО);
			ТабличныйДокумент.Вывести(ОбластьОКТМО, ВыборкаОКТМО.Уровень());
			
			ВыборкаСтрока = ВыборкаОКТМО.Выбрать();
			Пока ВыборкаСтрока.Следующий() Цикл
				
				ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрока);

				НомерПоПорядку = НомерПоПорядку + 1;
				ЗначенияЗаполнения = Новый Структура;
				ЗначенияЗаполнения.Вставить("НомерПоПорядку", НомерПоПорядку);
				ЗначенияЗаполнения.Вставить("ДоляВПраве", ПредставлениеКоэффициента(
					ВыборкаСтрока.ДоляВПравеОбщейСобственностиЧислитель,
					ВыборкаСтрока.ДоляВПравеОбщейСобственностиЗнаменатель));
				ЗначенияЗаполнения.Вставить("ДоляСтоимости", ПредставлениеКоэффициента(
					ВыборкаСтрока.ДоляСтоимостиЧислитель, ВыборкаСтрока.ДоляСтоимостиЗнаменатель));
				ОбластьСтрока.Параметры.Заполнить(ЗначенияЗаполнения);
					
				ТабличныйДокумент.Вывести(ОбластьСтрока, ВыборкаСтрока.Уровень());
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ОбластьИтоги.Параметры.Заполнить(ВыборкаПоКадастровой);
	ТабличныйДокумент.Вывести(ОбластьИтоги);
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
КонецПроцедуры

Функция ПредставлениеКоэффициента(Числитель, Знаменатель)
	
	Возврат	
		?(Числитель = 0 И Знаменатель = 0 , "1",
			СтрШаблон("%1/%2", Формат(Числитель, "ЧГ="), Формат(Знаменатель, "ЧГ=")));
		
КонецФункции

Функция ТекстНалоговойЛьготы(Параметры)

	ТекстНалоговойЛьготы = "";

	Если Параметры.ПорядокНалогообложения 
			= Перечисления.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения Тогда

		ТекстНалоговойЛьготы = НСтр("ru = 'Освобождается от налогообложения'");

	ИначеЕсли Параметры.ПорядокНалогообложения 
				= Перечисления.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке Тогда

		ТекстНалоговойЛьготы = НСтр("ru = 'Облагается по сниженной ставке'");

	ИначеЕсли Параметры.ПорядокНалогообложения 
				= Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент Тогда

		ТекстНалоговойЛьготы = СтрШаблон(НСтр("ru = 'Снижение суммы налога на %1 %%'"),
			Параметры.ПроцентУменьшенияСуммыНалога);

	ИначеЕсли Параметры.ПорядокНалогообложения
				= Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму Тогда

		ТекстНалоговойЛьготы = НСтр("ru = 'Снижение суммы налога (на указанную сумму)'");

	КонецЕсли;

	Возврат ТекстНалоговойЛьготы;

КонецФункции

Функция ПредставлениеКодаНалоговойЛьготы(Параметры)

	//@skip-check bsl-nstr-string-literal-format
	Разделитель = НСтр("ru = '/ '");

	ЧастиКода = Новый Массив;
	Если ЗначениеЗаполнено(Параметры.КодНалоговойЛьготы) Тогда
		ЧастиКода.Добавить(Параметры.КодНалоговойЛьготы);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.КодОснованияЛьготы) Тогда
		ЧастиКода.Добавить(Параметры.КодОснованияЛьготы);
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиКода, Разделитель);

КонецФункции

Функция ТекстЗапросаПечатьРасчета(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТПоСреднегодовой", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПоСреднегодовойРасчет", 	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПоСреднегодовой", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПоКадастровой", 			НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВыборкаДокументов", 		НомераТаблиц.Количество());
	
	Возврат
		"ВЫБРАТЬ
		|	РасчетНалогаНаИмуществоПоСреднегодовой.Ссылка КАК Ссылка,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОсновноеСредство КАК ОсновноеСредство,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.НалоговыйОрган КАК НалоговыйОрган,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.КодПоОКТМО КАК КодПоОКТМО,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.КодВидаИмущества КАК КодВидаИмущества,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0101 КАК ОстаточнаяСтоимостьНа0101,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0102 КАК ОстаточнаяСтоимостьНа0102,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0103 КАК ОстаточнаяСтоимостьНа0103,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0104 КАК ОстаточнаяСтоимостьНа0104,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0105 КАК ОстаточнаяСтоимостьНа0105,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0106 КАК ОстаточнаяСтоимостьНа0106,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0107 КАК ОстаточнаяСтоимостьНа0107,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0108 КАК ОстаточнаяСтоимостьНа0108,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0109 КАК ОстаточнаяСтоимостьНа0109,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0110 КАК ОстаточнаяСтоимостьНа0110,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0111 КАК ОстаточнаяСтоимостьНа0111,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа0112 КАК ОстаточнаяСтоимостьНа0112,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОстаточнаяСтоимостьНа3112 КАК ОстаточнаяСтоимостьНа3112,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.СредняяСтоимость КАК СредняяСтоимость,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ДоляСтоимостиЧислитель КАК ДоляСтоимостиЧислитель,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ДоляСтоимостиЗнаменатель КАК ДоляСтоимостиЗнаменатель,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.НалоговаяСтавка КАК НалоговаяСтавка,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения КАК ПорядокНалогообложения,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ПроцентУменьшенияСуммыНалога КАК ПроцентУменьшенияСуммыНалога,
		|	ВЫБОР
		|		КОГДА
		|			РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения)
		|			ТОГДА РасчетНалогаНаИмуществоПоСреднегодовой.КодНалоговойЛьготыОсвобождениеОтНалогообложения
		|		КОГДА
		|			РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке)
		|			ТОГДА ""2012400""
		|		КОГДА
		|			РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент)
		|		ИЛИ
		|			РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму)
		|			ТОГДА ""2012500""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК КодНалоговойЛьготы,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.КодОснованияЛьготы КАК КодОснованияЛьготы,
		|	ВЫБОР
		|		КОГДА РасчетНалогаНаИмуществоПоСреднегодовой.Ссылка.ТребуетсяРасчетСреднегодовой
		|			ТОГДА 0
		|		ИНАЧЕ РасчетНалогаНаИмуществоПоСреднегодовой.СуммаИсчислено
		|	КОНЕЦ КАК СуммаИсчислено,
		|	ВЫБОР
		|		КОГДА РасчетНалогаНаИмуществоПоСреднегодовой.Ссылка.ТребуетсяРасчетСреднегодовой
		|		И НЕ
		|			РасчетНалогаНаИмуществоПоСреднегодовой.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму)
		|			ТОГДА 0
