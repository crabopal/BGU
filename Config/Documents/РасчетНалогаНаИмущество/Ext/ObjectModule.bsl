#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если КонецГода(ОтчетныйПериод) = ОтчетныйПериод
		И ПоСреднегодовой.Количество() > 0 Тогда
		
		ДополнительныеСвойства.Вставить("ГодовойРасчет", Истина);
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("ПоСреднегодовой.ПроцентУменьшенияСуммыНалога");
	НепроверяемыеРеквизиты.Добавить("ПоСреднегодовой.СуммаУменьшенияСуммыНалога");
	
	ИмяСписка = НСтр("ru = 'По среднегодовой стоимости'");
	Для каждого СтрокаТаблицы Из ПоСреднегодовой Цикл
		
		Префикс = "ПоСреднегодовой[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		
		Если СтрокаТаблицы.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения
			И Не ЗначениеЗаполнено(СтрокаТаблицы.КодНалоговойЛьготыОсвобождениеОтНалогообложения) Тогда
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				,
				НСтр("ru = 'Код льготы'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
				
			Поле = Префикс + "КодНалоговойЛьготыОсвобождениеОтНалогообложения";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		Если СтрокаТаблицы.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент
			И Не ЗначениеЗаполнено(СтрокаТаблицы.ПроцентУменьшенияСуммыНалога) Тогда
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				,
				НСтр("ru = 'Процент уменьшения'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
				
			Поле = Префикс + "ПроцентУменьшенияСуммыНалога";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		Если СтрокаТаблицы.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму
			И СтрокаТаблицы.СуммаИсчислено > 0
			И СтрокаТаблицы.СуммаУменьшенияСуммыНалога = 0 Тогда
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				,
				НСтр("ru = 'Сумма льготы'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
				
			Поле = Префикс + "СуммаУменьшенияСуммыНалога";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
	
	КонецЦикла;

	Если ТребуетсяРасчетСреднегодовой И ПоСреднегодовой.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не выполнен расчет налога в списке ""По среднегодовой стоимости""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ПоСреднегодовой", "Объект", Отказ);
	КонецЕсли;

	ПроверитьДублиСтрок(Отказ);
	ПроверитьДублиДокумента(Отказ);

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяРасчетСреднегодовой И ПоСреднегодовой.Количество() = 0 Тогда
		ТребуетсяРасчетСреднегодовой = Ложь;	
	КонецЕсли;
	
	СуммаДокумента = ?(ТребуетсяРасчетСреднегодовой, 0, ПоСреднегодовой.Итог("Сумма"))
		+ ПоКадастровой.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиДокумента(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РасчетНалогаНаИмущество.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчетНалогаНаИмущество.ПоСреднегодовой КАК РасчетНалогаНаИмуществоПоСреднегодовой
		|		ПО РасчетНалогаНаИмущество.Ссылка = РасчетНалогаНаИмуществоПоСреднегодовой.Ссылка
		|			И (РасчетНалогаНаИмуществоПоСреднегодовой.НомерСтроки = 1)
		|ГДЕ
		|	РасчетНалогаНаИмущество.Проведен
		|	И РасчетНалогаНаИмущество.Организация = &Организация
		|	И РасчетНалогаНаИмущество.ОтчетныйПериод = &ОтчетныйПериод
		|	И РасчетНалогаНаИмущество.Ссылка <> &Ссылка
		|	И &ПроверитьПоСреднегодовой
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РасчетНалогаНаИмущество.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчетНалогаНаИмущество.ПоКадастровой КАК РасчетНалогаНаИмуществоПоКадастровой
		|		ПО РасчетНалогаНаИмущество.Ссылка = РасчетНалогаНаИмуществоПоКадастровой.Ссылка
		|			И (РасчетНалогаНаИмуществоПоКадастровой.НомерСтроки = 1)
		|ГДЕ
		|	РасчетНалогаНаИмущество.Проведен
		|	И РасчетНалогаНаИмущество.Организация = &Организация
		|	И РасчетНалогаНаИмущество.ОтчетныйПериод = &ОтчетныйПериод
		|	И РасчетНалогаНаИмущество.Ссылка <> &Ссылка
		|	И &ПроверитьПоКадастровой";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтчетныйПериод", ОтчетныйПериод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ПроверитьПоСреднегодовой", ПоСреднегодовой.Количество() > 0);
	Запрос.УстановитьПараметр("ПроверитьПоКадастровой", ПоКадастровой.Количество() > 0);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДублиПоСреднегодовой = Результат[0];
	ДублиПоКадастровой	 = Результат[1];
	
	Если Не ДублиПоСреднегодовой.Пустой() Тогда
	
		Выборка = ДублиПоСреднегодовой.Выбрать();
		Выборка.Следующий();

		ПредставлениеПериода = ПредставлениеПериода(НачалоГода(ОтчетныйПериод), ОтчетныйПериод, "ФП = Истина");
		
		ШаблонСообщения = НСтр("ru = 'Расчет налога на имущество по среднегодовой стоимости за %1 выполнен ранее.
			|Используйте документ %2'");
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ПредставлениеПериода,
			Выборка.Ссылка);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);

	КонецЕсли;

	Если Не ДублиПоКадастровой.Пустой() Тогда
	
		Выборка = ДублиПоКадастровой.Выбрать();
		Выборка.Следующий();
		
		ПредставлениеПериода = ПредставлениеПериода(НачалоКвартала(ОтчетныйПериод), ОтчетныйПериод, "ФП = Истина");

		ШаблонСообщения = НСтр("ru = 'Расчет налога на имущество по кадастровой стоимости за %1 выполнен ранее.
			|Используйте документ %2'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ПредставлениеПериода,
			Выборка.Ссылка);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);

	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиСтрок(Отказ)

	КолонкиДублей = ""
	+ "ОсновноеСредство,"
	+ "ИнвентарныйНомер,"
	+ "НалоговыйОрган,"
	+ "КодПоОКТМО,"
	+ "КодВидаИмущества,"
	+ "ДоляСтоимостиЧислитель,"
	+ "ДоляСтоимостиЗнаменатель,"
	+ "НалоговаяСтавка,"
	+ "ПорядокНалогообложения,"
	+ "КодНалоговойЛьготыОсвобождениеОтНалогообложения";
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ПоСреднегодовой, КолонкиДублей, Истина);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		
		Отказ = Истина;
		
		ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
		ПараметрыВывода.ТаблицаИмя = "ПоСреднегодовой";
		ПараметрыВывода.ТаблицаПредставление = "По среднегодовой стоимости";
		ПараметрыВывода.ОбъектСсылка = Ссылка;
		ПараметрыВывода.ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
		ПараметрыВывода.ИмяПоляДляВыводаСообщений = "ОсновноеСредство";
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
