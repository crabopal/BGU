// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0510458_157н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0510458_157н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на отпуск материальных ценностей на сторону'"), "0510458", "61н", "157н"),
			УправлениеПечатьюБГУ.НапечататьНакладнуюНаОтпускМЗ0510458(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0510450") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0510450",
			"Накладная на внутреннее перемещение НФА (ф.0510450)",
			УправлениеПечатьюБГУ.Напечатать0510450(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504102") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504102",
			"Накладная на внутреннее перемещение объектов НФА (ф.0504102)",
			УправлениеПечатьюБГУ.Напечатать0504102(МассивОбъектов, ОбъектыПечати));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504102_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504102_103н",
			"Накладная на внутреннее перемещение объектов НФА (ф.0504102)) (в ред.103н)",
			УправлениеПечатьюБГУ.Напечатать0504102(МассивОбъектов, ОбъектыПечати, "103н"));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акт0510434") Тогда
		
		ТабличныйДокумент = Напечатать0510434(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Акт0510434", "Акт приема-передачи в личное пользование (ф.0510434)", ТабличныйДокумент);
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОС2") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ОС2", "ОС-2", ПечатьОС2(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериаловДляВнутреннегоПеремещения(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения","Справка о содержании драг. материалов", ТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьОС2(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ОС2";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_2");
	ОблШапка1 	= Макет.ПолучитьОбласть("Шапка1");
	ОблСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОблСтрокаП	= Макет.ПолучитьОбласть("СтрокаП");
	ОблШапка2 	= Макет.ПолучитьОбласть("Шапка2");
	ОблПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НакладнаяНаВнутреннееПеремещениеОС2.Ссылка КАК Ссылка,
	|	НакладнаяНаВнутреннееПеремещениеОС2.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	НакладнаяНаВнутреннееПеремещениеОС2.Организация.КодОКПО КАК пКодОКПО,
	|	ПРЕДСТАВЛЕНИЕ(НакладнаяНаВнутреннееПеремещениеОС2.ПодразделениеОтправитель) КАК пПодразделениеОтправитель,
	|	ПРЕДСТАВЛЕНИЕ(НакладнаяНаВнутреннееПеремещениеОС2.ПодразделениеПолучатель) КАК пПодразделениеПолучатель,
	|	НакладнаяНаВнутреннееПеремещениеОС2.ЦМООтправитель.Сотрудник.Ссылка КАК МолСдал,
	|	НакладнаяНаВнутреннееПеремещениеОС2.ЦМООтправитель.Сотрудник.Код КАК ТабНомМОЛсдал,
	|	НакладнаяНаВнутреннееПеремещениеОС2.ЦМОПолучатель.Сотрудник.Ссылка КАК МОЛ,
	|	НакладнаяНаВнутреннееПеремещениеОС2.ЦМОПолучатель.Сотрудник.Код КАК ТабНомМОЛ,
	|	НакладнаяНаВнутреннееПеремещениеОС2.Дата КАК пДата,
	|	НакладнаяНаВнутреннееПеремещениеОС2.Номер КАК пНомер,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.НомерСтроки КАК Ном,
	|	ВЫБОР
	|		КОГДА НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаимОС,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Количество КАК КоличествоПеремещения,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Цена КАК ЦенаПеремещения,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Сумма КАК СуммаПеремещения,
	|	НакладнаяНаВнутреннееПеремещениеОС2.Организация,
	|	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска КАК ДатаПоступления
	|ИЗ
	|	Документ.НакладнаяНаВнутреннееПеремещениеОС2 КАК НакладнаяНаВнутреннееПеремещениеОС2
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаВнутреннееПеремещениеОС2.ОсновныеСредства КАК НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства
	|		ПО НакладнаяНаВнутреннееПеремещениеОС2.Ссылка = НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Ссылка
	|ГДЕ
	|	НакладнаяНаВнутреннееПеремещениеОС2.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер,
	|	Ном
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОблШапка1.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(
			ОблШапка1, "пНомер", ВыборкаШапка.пНомер, ВыборкаШапка.Ссылка, Неопределено, Истина);

		ТабличныйДокумент.Вывести(ОблШапка1);
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		КоличествоСтрок = ВыборкаСтроки.Количество();
		ТекущаяСтрока = 0;
		ПерваяСтраница = Истина;
		СумИтого = 0;
		Пока ВыборкаСтроки.Следующий() Цикл
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаСтроки.Ном) Тогда
				Продолжить;
			КонецЕсли;
			
			ОблСтрока.Параметры.Заполнить(ВыборкаСтроки);
			ПереводСтраницы = Ложь;
			Если НЕ ТабличныйДокумент.ПроверитьВывод(ОблСтрока) Тогда
				ПереводСтраницы = Истина;
			КонецЕсли;
			
			Если Не ПереводСтраницы И ТекущаяСтрока = КоличествоСтрок И НЕ ПерваяСтраница Тогда
				// проверим, что последняя строка + подвал уместится
				Массив = Новый Массив;
				Массив.Добавить(ОблСтрока);
				Массив.Добавить(ОблПодвал);
				Если НЕ ТабличныйДокумент.ПроверитьВывод(Массив) Тогда
					ПереводСтраницы = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ПереводСтраницы Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ПерваяСтраница = Ложь;
				ТабличныйДокумент.Вывести(ОблШапка2);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОблСтрока);
			СумИтого = СумИтого + ВыборкаСтроки.СуммаПеремещения;
			
		КонецЦикла;
		
		Пока ПерваяСтраница Цикл
			Если ТабличныйДокумент.ПроверитьВывод(ОблСтрокаП) Тогда
				ТабличныйДокумент.Вывести(ОблСтрокаП);
			Иначе
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОблШапка2);
				ПерваяСтраница = Ложь;
			КонецЕсли;
		КонецЦикла;
		Массив = Новый Массив;
		Массив.Добавить(ОблСтрокаП);
		Массив.Добавить(ОблПодвал);
		
		Пока ТабличныйДокумент.ПроверитьВывод(Массив) Цикл
			ТабличныйДокумент.Вывести(ОблСтрокаП);
		КонецЦикла;
		
		ОблПодвал.Параметры.Заполнить(ВыборкаШапка);
		ОблПодвал.Параметры.ИтогСумма = СумИтого;
		
		Бухгалтер = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(
			ВыборкаШапка.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ВыборкаШапка.пДата);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			Бухгалтер.ОтветственноеЛицоСсылка, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		ОблПодвал.Параметры.ОргБухгалтер = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
			ВыборкаШапка.МОЛСдал, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		ОблПодвал.Параметры.ОтправительДолжность = ДанныеСотрудника.Должность;
		ОблПодвал.Параметры.ФИОМОЛотправитель = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
			ВыборкаШапка.МОЛ, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		ОблПодвал.Параметры.ПолучательДолжность = ДанныеСотрудника.Должность;
		ОблПодвал.Параметры.ФИОМОЛполучатель = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		ТабличныйДокумент.Вывести(ОблПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

