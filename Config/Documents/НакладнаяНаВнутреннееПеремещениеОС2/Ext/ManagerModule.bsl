	|			ТОГДА Документ.ПодразделениеОтправитель.Наименование
	|		ИНАЧЕ Документ.ПодразделениеОтправитель.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияОтправитель,
	|	Документ.СотрудникПолучатель КАК СотрудникПолучатель,
	|	ЕСТЬNULL(Документ.СотрудникПолучатель.Код, """") КАК ТабельныйНомерПолучатель,
	|	Документ.МестонахождениеПолучатель КАК МестонахождениеПолучатель,
	|	Документ.ПодразделениеПолучатель КАК СтруктурноеПодразделениеПолучатель,
	|	ВЫБОР
	|		КОГДА Документ.ПодразделениеПолучатель.НаименованиеПолное = """"
	|			ТОГДА Документ.ПодразделениеПолучатель.Наименование
	|		ИНАЧЕ Документ.ПодразделениеПолучатель.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияПолучатель,
	|	Документ.Операция КАК Операция,
	|	Документ.ВидПервичногоДокумента КАК НаименованиеПриказа,
	|	Документ.НомерПервичногоДокумента КАК НомерПриказа,
	|	Документ.ДатаПервичногоДокумента КАК ДатаПриказа
	|ИЗ
	|	ВТ_Документ КАК Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	ОсновныеСредства.ОсновноеСредство.Сведения КАК Сведения,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.ИнвентарныйНомер)
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НоменклатурныйНомер <> """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.НоменклатурныйНомер
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.Код
	|	КОНЕЦ КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.Дефекты КАК Дефекты,
	|	ОсновныеСредства.ОсобыеОтметки КАК ОсобыеОтметки,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.Приспособления, """") КАК Приспособления,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.НормаВыдачи, 0) КАК НормаВыдачи,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.СрокИспользованияПоНормативу, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.ЕдиницаИзмеренияСрока, 0) КАК ЕдиницаИзмеренияСрока,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.КодУсловияВозвратаИмущества, """") КАК КодВозврата
	|ИЗ
	|	ВТ_ОС КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Документ КАК ВТ_Документ
	|		ПО ОсновныеСредства.Ссылка = ВТ_Документ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК ОбеспечениеИмуществом
	|		ПО (ВТ_Документ.СотрудникОбеспечения = ОбеспечениеИмуществом.Ссылка.Владелец)
	|			И ОсновныеСредства.ОсновноеСредство = ОбеспечениеИмуществом.Имущество
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеРеквизиты.Ссылка КАК ОсновноеСредство,
	|	ДополнительныеРеквизиты.Свойство.Заголовок КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ДополнительныеРеквизиты.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектов
	|			ТОГДА ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ДополнительныеРеквизиты.Значение.ПолноеНаименование КАК СТРОКА(1))) = """"
	|						ТОГДА ДополнительныеРеквизиты.Значение.Наименование
	|					ИНАЧЕ ВЫРАЗИТЬ(ДополнительныеРеквизиты.Значение.ПолноеНаименование КАК СТРОКА(1000))
	|				КОНЕЦ
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ДополнительныеРеквизиты.Значение)
	|	КОНЕЦ КАК ЗначениеХарактеристики,
	|	ДополнительныеРеквизиты.ТекстоваяСтрока КАК ТекстоваяСтрока
	|ИЗ
	|	Справочник.ОсновныеСредства.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство
	|			ИЗ
	|				ВТ_ОС КАК ВТ)
	|	И ДополнительныеРеквизиты.Значение <> НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Объект,
	|	ДополнительныеСведения.Свойство.Заголовок,
	|	ВЫБОР
	|		КОГДА ДополнительныеСведения.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектов
	|			ТОГДА ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ДополнительныеСведения.Значение.ПолноеНаименование КАК СТРОКА(1))) = """"
	|						ТОГДА ДополнительныеСведения.Значение.Наименование
	|					ИНАЧЕ ВЫРАЗИТЬ(ДополнительныеСведения.Значение.ПолноеНаименование КАК СТРОКА(1000))
	|				КОНЕЦ
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ДополнительныеСведения.Значение)
	|	КОНЕЦ,
	|	""""
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.ОсновныеСредства) В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство
	|			ИЗ
	|				ВТ_ОС КАК ВТ)
	|	И ДополнительныеСведения.Значение <> НЕОПРЕДЕЛЕНО";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов"	, РезультатЗапроса[2]);
	ДанныеДляПечати.Вставить("ВыборкаОСДок"			, РезультатЗапроса[3]);
	ДанныеДляПечати.Вставить("ХарактеристикиОС"		, РезультатЗапроса[4]);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция Напечатать0510434(МассивОбъектов, ОбъектыПечати)
	
	ДанныеДляПечати		= ДанныеДляПечати0510434(МассивОбъектов);
	ВыборкаДокументов	= ДанныеДляПечати.ВыборкаДокументов.Выбрать();
	ВыборкаОСДок		= ДанныеДляПечати.ВыборкаОСДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ХарактеристикиОС	= ДанныеДляПечати.ХарактеристикиОС.Выгрузить();
	
	ХарактеристикиОС.Индексы.Добавить("ОсновноеСредство");
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
	Пока ВыборкаДокументов.Следующий() Цикл
		
		// Шапка
		СтрокаДокумента = ДанныеДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);

		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникОтправитель);
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникПолучатель);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия,Имя,Отчество,Должность,ДолжностьНаименование,НаименованиеПолное",
			ВыборкаДокументов.ДатаАкта);
		ДанныеСотрудникаОтправителя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникОтправитель);	
		СтрокаДокумента.ФИООтправитель = ДанныеСотрудникаОтправителя.НаименованиеПолное;
		
		ДанныеСотрудникаПолучателя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникПолучатель);	
		СтрокаДокумента.ФИОПолучатель = ДанныеСотрудникаПолучателя.НаименованиеПолное;
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокаДокумента.ОсновныеСредства = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахОСДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
		
		ВыборкаОСДок.Сбросить();
		Если ВыборкаОСДок.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаОС = ВыборкаОСДок.Выбрать();
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
				СтрокаОС = СтрокаДокумента.ОсновныеСредства.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаОС, ВыборкаОС);
				СтрокаОС.Характеристики = ПредставлениеХарактеристикОС0510434(ВыборкаОС.ОсновноеСредство, ХарактеристикиОС);
			КонецЦикла;
		КонецЕсли;
		
		СтрокаДокумента.ОбъектыСдалНаименованиеДолжности = ДанныеСотрудникаОтправителя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалСотрудник = ВыборкаДокументов.СотрудникОтправитель;
		СтрокаДокумента.ОбъектыСдалФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаОтправителя, Истина);
		
		СтрокаДокумента.ОбъектыПринялНаименованиеДолжности = ДанныеСотрудникаПолучателя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялСотрудник = ВыборкаДокументов.СотрудникПолучатель;
		СтрокаДокумента.ОбъектыПринялФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаПолучателя, Истина);
		
	КонецЦикла;
	
	Возврат УправлениеПечатьюБГУ.Напечатать0510434(МассивОбъектов, ОбъектыПечати, ДанныеДокументов);
	
КонецФункции

Функция ПредставлениеХарактеристикОС0510434(ОсновноеСредство, Характеристики)
	
	СписокХарактеристик = Новый Массив;
	
	СтрокиОС = Характеристики.НайтиСтроки(Новый Структура("ОсновноеСредство", ОсновноеСредство));
	
	Для Каждого СтрокаОС Из СтрокиОС Цикл
		Значение = ?(ЗначениеЗаполнено(СтрокаОС.ТекстоваяСтрока), СтрокаОС.ТекстоваяСтрока, СтрокаОС.ЗначениеХарактеристики);
		Представление = СтрокаОС.Характеристика + ": " + Значение;
		СписокХарактеристик.Добавить(Представление);
	КонецЦикла;
	
	Результат = СтрСоединить(СписокХарактеристик, ", ");
	
	Возврат Результат;
	
КонецФункции

Процедура СобратьДанныеДляНакладной0510458(ДанныеДляПечати, МассивОбъектов, Запрос) Экспорт
	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеДляПечати.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.ИННОрганизации = ДанныеОрганизации.ИНН;
		СтрокаШапки.КППОрганизации = ДанныеОрганизации.КПП;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.УполномоченноеЛицо) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
				ВыборкаШапка.УполномоченноеЛицо, ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.УполномоченноеЛицоДатаПодписи = ВыборкаШапка.Дата;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.СотрудникОтправитель) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, НаименованиеПолное",
				ВыборкаШапка.СотрудникОтправитель, ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтрокаШапки.ЦМООтправитель = ДанныеСотрудника.НаименованиеПолное;
			СтрокаШапки.ОтпустилДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.ОтпустилФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.ОтпустилДатаПодписи = ВыборкаШапка.Дата;
			СтрокаШапки.УчетныйНомерОтправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаШапка.СотрудникОтправитель, "Код");
		КонецЕсли;
		
		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("Группа", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		Всего = 0;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				ГрупповойСчет = ТекущаяГруппаНФА.Группа;
			Иначе
				ГрупповойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			КонецЕсли;
			
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(ГрупповойСчет);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = УправлениеПечатьюБГУ.ЗаголовокТабличнойЧастиДляПечатиНакладной0510458();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.Группа = ГрупповойСчет;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					Если СтрДлина(ТекущаяГруппаНФА.Код) > 4 Тогда
						ЗаголовокТабличнойЧасти.КодГруппыНФА = Сред(ТекущаяГруппаНФА.Код, 5);
					Иначе
						ЗаголовокТабличнойЧасти.КодГруппыНФА = ТекущаяГруппаНФА.Код;
					КонецЕсли;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(ГрупповойСчет, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			Всего = Всего + НоваяСтрокаСостава.Всего;
		КонецЦикла;
		
		СтрокаШапки.Всего = Всего;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.Группа);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		СтрокаШапки.СоставДокумента = ДанныеТабличныхЧастейДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

