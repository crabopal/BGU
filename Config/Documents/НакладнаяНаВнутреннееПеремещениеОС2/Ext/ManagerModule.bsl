	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомерПервичногоДокумента", 
	"ВЫБОР
	|		КОГДА Таблица.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
