#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Возвращает таблицу значений по данным табличной части документа для формирования резерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
		НеПроверяемыеРеквизиты.Добавить("ЦМООтправитель");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
		НеПроверяемыеРеквизиты.Добавить("ЦМОПолучатель");
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.КФО");
		
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
		
		СписокОС = ОсновныеСредства.Выгрузить(, "ОсновноеСредство");
		КоличествоОС = СписокОС.Количество();
		СписокОС.Свернуть("ОсновноеСредство");
		Если СписокОС.Количество() < КоличествоОС Тогда
			ТекстСообщения = НСтр("ru = 'В табличной части документа содержатся дубли основных средств.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	УправлениеОсновнымиСредствами.ПроверитьЗаполнениеКПСвТЧ(ЭтотОбъект, "ОсновныеСредства", "Основные средства", "", Отказ);
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС Тогда
		СчетУчета = "101.00,102.00,103.00,111.60";
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет Тогда
		СчетУчета = "21";
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование Тогда
		СчетУчета = "01";
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении Тогда
		СчетУчета = "02";
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхПоЦС Тогда
		СчетУчета = "22";
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений Тогда
		СчетУчета = "106.10,106.20,106.30,106.60,106.90";
	Иначе
		СчетУчета = "";
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='В строке %1 счет учета объекта не соответствует выбранному виду учета'");
	ШаблонСообщения1 = НСтр("ru = 'В строке %1 не заполнена карточка капвложений'");
	Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		Если Не БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетУчета, СчетУчета) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, СтрокаТаблицы.НомерСтроки),,,
				"Объект.ОсновныеСредства["+(СтрокаТаблицы.НомерСтроки-1)+"].ОсновноеСредство", Отказ);
		КонецЕсли;

		Если СтрокаТаблицы.ОтразитьВКарточкеКапвложений
			И ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(СтрокаТаблицы.СчетУчета) 
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КарточкаКапвложений) Тогда

			Отказ = Истина;
			ТекстСообщения1 = СтрШаблон(ШаблонСообщения1, СтрокаТаблицы.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения1, ЭтотОбъект.Ссылка, 
				"ОсновныеСредства[" + ОсновныеСредства.Индекс(СтрокаТаблицы) + "].КарточкаКапвложений", "Объект");
		КонецЕсли;	
	КонецЦикла;
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ДополнительноеСобытие = Перечисления.ВидыСобытийОС.ПередачаВЛичноеПользование Тогда
		ПроверитьНормуВыдачи();
	КонецЕсли;
	
	Если Не БухгалтерскийУчет.ПодразделениеОбязательно(ОсновныеСредства.ВыгрузитьКолонку("СчетУчета")) Тогда
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
	УправлениеОсновнымиСредствами.ПроверитьОчиститьКПСвТаблицеДокумента(ОсновныеСредства, "");
	
	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНормуВыдачи()
	
	пСотрудник = ?(ЗначениеЗаполнено(СотрудникЛП), СотрудникЛП, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМОПолучатель, "Сотрудник"));
	пКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(пСотрудник, "Контрагент");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, Ссылка);
	Запрос.УстановитьПараметр("Период"		, МоментВремени());
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Сотрудник"	, пСотрудник);
	Запрос.УстановитьПараметр("Контрагент"	, пКонтрагент);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	Документ.НакладнаяНаВнутреннееПеремещениеОС2.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_ОС.ОсновноеСредство
	|					ИЗ
	|						ВТ_ОС КАК ВТ_ОС)
	|				И Контрагент = &Контрагент) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОбеспечениеИмуществом.Имущество КАК Справочник.ОсновныеСредства) КАК Имущество,
	|	ОбеспечениеИмуществом.НормаВыдачи КАК НормаВыдачи,
	|	0 КАК Выдано
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК ОбеспечениеИмуществом
	|ГДЕ
	|	ОбеспечениеИмуществом.Ссылка.Владелец = &Сотрудник
	|	И ОбеспечениеИмуществом.Имущество ССЫЛКА Справочник.ОсновныеСредства
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство,
	|	0,
	|	ВТ_ОС.Количество
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Остатки.ОсновноеСредство,
	|	0,
	|	ВТ_Остатки.Количество
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Имущество КАК Имущество,
	|	ВТ_Данные.Имущество.Наименование КАК НаименованиеОС,
	|	СУММА(ВТ_Данные.НормаВыдачи) КАК НормаВыдачи,
	|	СУММА(ВТ_Данные.Выдано) КАК Выдано
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.Имущество";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Шаблон = НСтр("ru = 'По имуществу ""%1"" выдано (%2) больше нормы (%3)'");
	Пока Выборка.Следующий() Цикл
		Если Выборка.Выдано > Выборка.НормаВыдачи Тогда
			ТекстСообщения = СтрШаблон(Шаблон, Выборка.НаименованиеОС, Выборка.Выдано, Выборка.НормаВыдачи);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(
		ОсновныеСредства.ВыгрузитьКолонку("СчетУчета"));
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	СубконтоДоговоры = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	СубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	
	Для каждого СтрокаТЧ из ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, КФО, Количество, Сумма, НомерСтроки");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация");

		НоваяСтрока.ЦМО = ЦМООтправитель;
		НоваяСтрока.ПередачаЧастейОбъектов = Ложь;
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		Если СтрокаСчета.ВидДопАналитики = СубконтоДоговоры И ЗначениеЗаполнено(СтрокаТЧ.Договор) Тогда
			НоваяСтрока.ДопАналитика = СтрокаТЧ.Договор;
		ИначеЕсли СтрокаСчета.ВидДопАналитики = СубконтоКонтрагенты И ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
			НоваяСтрока.ДопАналитика = СтрокаТЧ.Контрагент;
		КонецЕсли;	
		
		Если СтрокаСчета.УчетПоКПС Тогда
			НоваяСтрока.КПС = СтрокаТЧ.КПС;
		КонецЕсли;	
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = ПодразделениеОтправитель;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	// Теперь нужно заполнить ДопАналитику по остаткам, если она есть на счетах. Например, если передача идет
	// по счетам, у которых есть субконто "Договор" и он не указан в документе. Если договор указан в документе
	// и он заполнен в таблице ТаблицаДока вколонке "ДопАналитика", то это значение меняться не будет
	УправлениеОсновнымиСредствами.ЗаполнитьДопАналитикуВТаблицеСписанияОС(ТабСчетов, ТаблицаДока, ЭтотОбъект);
	
	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	
	Если ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами Тогда
		ТаблицаДока = ОсновныеСредства.Выгрузить(, "ОсновноеСредство, НомерСтроки");
		ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_НаличиеРезерваПоОбъекту(ТаблицаДока, ЭтотОбъект);
	Иначе
		ТаблицаДока = ТаблицаСписанияОС();
	
		МассивВОсКонтролемОбременений = Новый Массив;
		МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС);
		МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет);
		НуженКонтрольОбременений = ЗначениеЗаполнено(ДополнительноеСобытие) 
			И ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование") 
			И МассивВОсКонтролемОбременений.Найти(ВидОперации) <> Неопределено;
		ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(
			ТаблицаДока, ЭтотОбъект, НуженКонтрольОбременений);
	КонецЕсли;		
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецЕсли