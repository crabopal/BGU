&НаКлиенте
Процедура УстановитьНовыйСчет(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОграниченияСчета", "101.00,102.00,103.00,111.60");
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораНовогоСчета", ЭтотОбъект);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНовогоСчета(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТаблицы.СчетУчетаНовый = Результат;
	КонецЦикла;
	
КонецПроцедуры	

