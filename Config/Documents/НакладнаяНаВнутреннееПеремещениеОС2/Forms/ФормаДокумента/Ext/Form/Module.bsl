&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьДопСобытий(Форма, Объект)
	ЭтоПеремещениеОС = (
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС")
		ИЛИ 
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет"));
	
	Форма.Элементы.ГруппаУчетВЛП.Видимость = ЭтоПеремещениеОС;
	Форма.Элементы.СтраницыДопСобытия.Видимость = 
		Форма.УчетВЛичномПользовании ИЛИ Форма.ПередачаВРемонт;                        
		
	Форма.Элементы.СтраницыДопСобытия.ТекущаяСтраница = Форма.Элементы.СтраницаВЛичноеПользование;
	Если Форма.ПередачаВРемонт Тогда
		Форма.Элементы.СтраницыДопСобытия.ТекущаяСтраница = Форма.Элементы.СтраницаПередачаВРемонт;
	КонецЕсли;	
	
	Форма.Элементы.ОсновныеСредстваСведенияВидимыеДефекты.Видимость	= Форма.УчетВЛичномПользовании И ЭтоПеремещениеОС;
	Форма.Элементы.ОсновныеСредстваСведенияОсобыеОтметки.Видимость	= Форма.УчетВЛичномПользовании И ЭтоПеремещениеОС;
КонецПроцедуры	

