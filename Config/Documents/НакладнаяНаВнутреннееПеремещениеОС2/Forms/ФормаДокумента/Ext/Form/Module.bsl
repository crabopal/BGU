&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Форма.Элементы.ПодразделениеОтправитель.Доступность		= ДоступностьЭлементов;
	Форма.Элементы.ПодразделениеПолучатель.Доступность		= ДоступностьЭлементов;
	Форма.Элементы.ЦМООтправитель.Доступность				= ДоступностьЭлементов;
	Форма.Элементы.ЦМОПолучатель.Доступность				= ДоступностьЭлементов;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС") Тогда
		СписокСчетов = "101.00,102.00,103.00,111.60";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет") Тогда
		СписокСчетов = "21";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование") Тогда
		СписокСчетов = "01";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении") Тогда
		СписокСчетов = "02.1,02.3,02.11,02.21,02.31";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхПоЦС") Тогда
		СписокСчетов = "22.1";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений") Тогда
		СписокСчетов = "106.10,106.20,106.30,106.60,106.90";
	Иначе
		СписокСчетов = "";
	КонецЕсли;
	
	Форма.ОграниченияСчета = СписокСчетов;
	
	ПодразделениеОбязательно = Ложь;
	Если СписокСчетов <> "" Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета(СписокСчетов,, Объект.Дата);
		Если СвойстваСчета <> Неопределено Тогда
			ПодразделениеОбязательно = Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям
				И СвойстваСчета.УчетПоПодразделениям И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение;
		КонецЕсли;
	КонецЕсли;
	
	Если ПодразделениеОбязательно Тогда
		Форма.Элементы.ПодразделениеОтправитель.АвтоОтметкаНезаполненного	= Истина;
		Форма.Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного		= Не ЗначениеЗаполнено(Объект.ПодразделениеОтправитель);
		Форма.Элементы.ПодразделениеПолучатель.АвтоОтметкаНезаполненного	= Истина;
		Форма.Элементы.ПодразделениеПолучатель.ОтметкаНезаполненного		= Не ЗначениеЗаполнено(Объект.ПодразделениеПолучатель);
	Иначе
		Форма.Элементы.ПодразделениеОтправитель.АвтоОтметкаНезаполненного	= Ложь;
		Форма.Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного		= Ложь;
		Форма.Элементы.ПодразделениеПолучатель.АвтоОтметкаНезаполненного	= Ложь;
		Форма.Элементы.ПодразделениеПолучатель.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;
	
	ЭтоПеремещениеПоСчетам	= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами"));
	ЭтоПеремещениеОС		= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет"));
	
	
	Форма.Элементы.ГруппаОтправительПолучатель.Видимость	= Не ЭтоПеремещениеПоСчетам;
	Форма.Элементы.ГруппаОсновныеСредства.Видимость			= Не ЭтоПеремещениеПоСчетам;
	Форма.Элементы.ГруппаПеремещениеМеждуСчетами.Видимость	= ЭтоПеремещениеПоСчетам;
	
	ВидимостьДопСобытий(Форма, Объект);
	
	ВидимостьЭлементовКарточки = ЭтоОперацияКапвложений(Объект);
	ЭлементыКарточкаКапвложений = Новый Массив;
	ЭлементыКарточкаКапвложений.Добавить("ГруппаКарточкаКапвложений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыКарточкаКапвложений, "Видимость", ВидимостьЭлементовКарточки);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРеквизитыДопСобытия(Форма, Объект)
	
	Форма.УчетВЛичномПользовании = ЗначениеЗаполнено(Объект.ДополнительноеСобытие) И 
		(Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование")
		ИЛИ Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ВозвратИзЛичногоПользования"));

	Форма.ПередачаВРемонт = ЗначениеЗаполнено(Объект.ДополнительноеСобытие) И 
		Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.КапитальныйРемонт");
		
	Форма.ПередачаЛичноеПользование = ?(Форма.УчетВЛичномПользовании И Объект.ДополнительноеСобытие =
		ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ВозвратИзЛичногоПользования"), 1, 0);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеТаблицыОсновныеСредства()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ДанныеОбъектаОС = ДанныеОбъектовОС[СтрокаТаблицы.ОсновноеСредство];
		Если ДанныеОбъектаОС = Неопределено Тогда
			ДанныеОбъектаОС = Новый Структура;
		КонецЕсли;
		УстановитьДинамическиеДанныеСтрокиОсновныеСредства(СтрокаТаблицы, ДанныеОбъектаОС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеСтрокиОсновныеСредства(СтрокаТаблицы, ДанныеОбъектаОС)
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС);
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета);
	СтрокаТаблицы.УчетПоКПС = СвойстваСчета.УчетПоКПС;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УчетПоКПСНаСчете(СчетУчета)
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	Возврат СвойстваСчета.УчетПоКПС;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеОСКратко(ОсновноеСредство, Период)
	
	Данные = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, Период);
	Результат = Новый Структура("СчетУчета,ВидНФА", Данные.СчетУчета, Данные.ВидНФА);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммы()
	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Расчет доступен только в непроведенном документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(СтруктураПроверяемыхРеквизитов(), Объект, Истина);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	РассчитатьСуммыНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьОбщиеПараметрыПодбора(ПараметрыПодбора)
	
	СписокСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет") Тогда
		СписокСчетов.ЖилыеПомещения		= Истина;
		СписокСчетов.НежилыеПомещения	= Истина;
		СписокСчетов.Сооружения			= Истина;
		СписокСчетов.Машины				= Истина;
		СписокСчетов.Транспорт			= Истина;
		СписокСчетов.ХозИнвентарь		= Истина;
		СписокСчетов.Библиотека			= Истина;
		СписокСчетов.Прочие				= Истина;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование") Тогда
		СписокСчетов.Аренда				= Истина;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении") Тогда
		СписокСчетов.Хранение			= Истина;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхПоЦС") Тогда
		СписокСчетов.ПолученныеПоЦС			= Истина;
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ОС"	, Истина);
	ПараметрыПодбора.Вставить("НМА"	, Истина);
	ПараметрыПодбора.Вставить("НПА"	, Истина);
	
	ПараметрыПодбора.Вставить("СписокСчетов",	СписокСчетов);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	
	СтруктураРеквизитов.Вставить("Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И НЕ ЗначениеЗаполнено(Объект.ИФО) Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами") Тогда 
		
		Если Элементы.ЦМООтправитель.ОтметкаНезаполненного Тогда
			СтруктураРеквизитов.Вставить("ЦМООтправитель", "МОЛ/Место хранения (отправитель)");
		КонецЕсли;
		Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
			Если Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного Тогда
				СтруктураРеквизитов.Вставить("ПодразделениеОтправитель", "Подразделение (отправитель)");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами") Тогда 
		ПараметрыПодбора.Отбор.Вставить("ЦМО"			, Объект.ЦМООтправитель);
		ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.ПодразделениеОтправитель);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, Неопределено);
	Если НЕ Объект.ДоговорВТабличнойЧасти Тогда
		ПараметрыПодбора.Вставить("СкрытьКолонки"	, "Контрагент");
	КонецЕсли;	
	ПараметрыПодбора.Вставить("Период", Объект.Дата);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		ДополнитьПараметрыВЛичномПользовании(ПараметрыПодбора);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет");
		ДополнитьПараметрыВЛичномПользовании(ПараметрыПодбора)
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПолученоВПользование");
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении");
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхПоЦС") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "ЦентрализованноеСнабжение";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "УчетныеДанные";
		ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС");
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00,102.00,103.00,111.60,21");
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "Вложения";
		ПараметрыПодбора.Отбор.Вставить("Счет", ОграниченияСчета);
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДоговорВТабличнойЧасти", Объект.ДоговорВТабличнойЧасти);
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьПараметрыВЛичномПользовании(ПараметрыПодбора)
	
	Если УчетВЛичномПользовании И ПередачаЛичноеПользование = 1 Тогда
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование"));
		// Параметр отбора КонтрагентВЛП - контрагент в личном пользовании. Это отбор по регистру 
		// "Стоимость объектов ОС с контрагентами" и может отличаться от контрагента на счете БУ (101, 21). 
		ПараметрыПодбора.Отбор.Вставить("КонтрагентЛП", КонтрагентВЛичномПользовании(Объект.СотрудникЛП, Объект.ЦМООтправитель));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтрагентВЛичномПользовании(СотрудникЛП, ЦМО)
	
	Если ЗначениеЗаполнено(СотрудникЛП) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникЛП, "Контрагент");
	Иначе
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМО, "Сотрудник.Контрагент");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами Тогда 
		
		ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
			Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство");
		
		Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
			СтрокаТаблицы.СчетУчетаНовый = СтрокаТаблицы.СчетУчета;
		КонецЦикла;
		
	Иначе
		
		ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
			Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
		
		УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
		
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
			
			Если ЭтоОперацияКапвложений(Объект) И НЕ СтрокаТаблицы.ОтразитьВКарточкеКапвложений Тогда
				СтрокаТаблицы.ОтразитьВКарточкеКапвложений = Истина;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВводДлинногоТекста(ИмяПоля, ЗаголовокФормыВвода)
	
	ТекущиеДанные = Элементы.ОсновныеСредстваСведения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ИмяПоля", ИмяПоля);
	ОбработчикИзменения = Новый ОписаниеОповещения("ЗавершитьВводДлинногоТекста", ЭтотОбъект, ДополнительныеПараметры);
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(ОбработчикИзменения, ТекущиеДанные[ИмяПоля], ЗаголовокФормыВвода);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводДлинногоТекста(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОсновныеСредстваСведения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля;
	ТекущиеДанные[ИмяПоля] = Результат;
	
	Модифицированность = Истина;
	
КонецПроцедуры

