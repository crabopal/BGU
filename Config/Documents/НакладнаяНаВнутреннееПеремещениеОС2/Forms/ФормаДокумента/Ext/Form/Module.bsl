&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОперацияКапвложений(Объект)
	Возврат(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений"));
КонецФункции	              

&НаКлиенте
Процедура ОтключитьУчетВКарточкахКапвложений()
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений") Тогда
		
		Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
			Если СтрокаТЧ.ОтразитьВКарточкеКапвложений Тогда
				СтрокаТЧ.ОтразитьВКарточкеКапвложений = Ложь;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;		
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьДополнительноеСобытие()
	Если (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет")) Тогда
		
		Если УчетВЛичномПользовании Тогда
			Объект.ДополнительноеСобытие = ?(ПередачаЛичноеПользование = 1,
			ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ВозвратИзЛичногоПользования"),
			ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование"));
			Объект.КонтрагентПолучатель = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		ИначеЕсли ПередачаВРемонт Тогда
			Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.КапитальныйРемонт");
			Объект.СотрудникЛП = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
		Иначе	
			Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПустаяСсылка");
			Объект.СотрудникЛП = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
			Объект.КонтрагентПолучатель = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли;		
	Иначе
		Объект.ДополнительноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПустаяСсылка");
		Объект.СотрудникЛП = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
		Объект.КонтрагентПолучатель = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбора_ОчисткаТабЧастей_Завершение(Результат, ДопПараметры) Экспорт
	Если ДопПараметры.Параметры.ИмяРеквизита = "Организация" Тогда
		ОрганизацияПриИзменении(ДопПараметры.Элемент);
	ИначеЕсли ДопПараметры.Параметры.ИмяРеквизита = "ИФО" Тогда
		ПриИзмененииИФО();
	КонецЕсли;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	Элементы = Форма.Элементы;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоговорВТабличнойЧасти", "Видимость", ЭтоВО_СДоговоромВТЧ(Объект.ВидОперации));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКонтрагентДоговор", "Видимость", Объект.ДоговорВТабличнойЧасти);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВО_СДоговоромВТЧ(ВО)
	Возврат(ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование")
		ИЛИ ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении")
		ИЛИ ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеКапВложений"));
КонецФункции	

