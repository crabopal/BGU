#Область КонтрольИсполненияДоговоров

&НаСервереБезКонтекста
Функция СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор)
	
	Возврат КонтрольИсполненияДоговоров.СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьПодборПоГрафикуПлатежей(ОтменитьПроведениеДокумента)
	
	Если ОтменитьПроведениеДокумента Тогда
		ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
		ЭтотОбъект.Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура("Организация,ИФО,Контрагент,Договор");
	ЗаполнитьЗначенияСвойств(ПараметрыПодбора, Объект);
	ПараметрыПодбора.Вставить("СчетРасчетов", Объект.КорСчет);
	ПараметрыПодбора.Вставить("ЭтоПоступление", Ложь);
	
	ПараметрыФормы = Новый Структура("ПараметрыПодбора, ТолькоПросмотр",
		ПараметрыПодбора, ТолькоПросмотр);
	ОткрытьФорму("ОбщаяФорма.ПодборПлатежейПоГрафику", ПараметрыФормы, ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборПоГрафикуПлатежейНаСервере(АдресВыбранныхПлатежейВХранилище)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	КонтрольИсполненияДоговоров.ОбработатьПодборПлатежейПоГрафику(ДокументОбъект, АдресВыбранныхПлатежейВХранилище);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("СуммаВал") - Объект.СуммаДокументаВВалюте;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовГрафикПлатежей()
	
	ВидимостьЭлементовГрафикаПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И КонтрольИсполненияДоговоров.ВедетсяГрафикПлатежейПоДоговору(Объект.Договор)
		И КонтрольИсполненияДоговоров.ВедетсяГрафикПлатежейПоСчетуРасчетов(Объект.КорСчет, Ложь);
	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("РасшифровкаПлатежаВидРасчетов");
	ЭлементыГрафикПлатежей.Добавить("РасшифровкаПлатежаОплатитьДо");
	ЭлементыГрафикПлатежей.Добавить("РасшифровкаПлатежаПодборПоГрафикуПлатежей");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГрафикПлатежей, "Видимость", ВидимостьЭлементовГрафикаПлатежей);
	
	// По кредитным договорам без графика платежей показываем только вид расчетов в отдельной колонке.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"РасшифровкаПлатежаВидРасчетовБезГрафикаПлатежей", "Видимость",
			НЕ ВидимостьЭлементовГрафикаПлатежей И БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "301.00") );
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ФискальныеОперации

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы(ВыбранныйКонтрагент = Неопределено)
	
	Если ВыбранныйКонтрагент = Неопределено Тогда
		ВыбранныйКонтрагент = Объект.Контрагент;
	КонецЕсли;
	
	Если ЭтоФизЛицо(ВыбранныйКонтрагент) Тогда
		
		ВидимостьВозможностиПечатиЧекаККМ = Истина;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПосмотретьПредставлениеЧека", 		"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеЧекаККМ", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		
		НомерКассовогоЧека = НомерЧекаДляДокумента();
		СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
		
		ВидимостьКнопкиПечатьЧекаККМ = Истина;
		ЕстьЗаключительныйЧекИсправительный = Ложь;
		
		Если СтатусЧекаККМПробит Тогда
			ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);
			Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
				ВидимостьКнопкиПечатьЧекаККМ = Истина;
				ЕстьЗаключительныйЧекИсправительный = Истина;
			Иначе
				ВидимостьКнопкиПечатьЧекаККМ = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 		"Видимость", ВидимостьКнопкиПечатьЧекаККМ);
		
		ВидимостьКомандККТ = ПодключаемоеОборудованиеБГУ.ВидимостьКомандККТПоТипуКассыККМ(Объект.КассаККМ);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаEmail", 											"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаSMS", 											"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтказКлиентаОтСохраненияТелефонаEmail", 		"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДанныеSMSИлиEmail", 									"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОчиститьEmailИSMS",								"Видимость", ВидимостьКомандККТ);
	Иначе
		ВидимостьВозможностиПечатиЧекаККМ = Ложь;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПосмотретьПредставлениеЧека", 		"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеЧекаККМ", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
	КонецЕсли;
	
	Элементы.РасшифровкаПлатежаНаправлениеРасходованияВР.Видимость = НЕ СписокДопустимыхКФО.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение")) = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.СистемаНалогообложенияЧекаККМ = ПодключаемоеОборудованиеБГУ.ВидСистемыНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
		Объект.СистемаНалогообложенияЧекаККМ = НастройкиОборудования.ФискальныйРегистратор.СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ПараметрыДоговораПлатежногоАгента) Тогда
		Объект.ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Если Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
			ИспользоватьПодключаемоеОборудование = Ложь;
		Иначе
			ИспользоватьПодключаемоеОборудование = Истина;
		КонецЕсли;
		
		ПризнакСпособаРасчетаПоУмолчанию = Объект.КассаККМ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		Иначе
			ПризнакСпособаРасчетаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ");
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭлектроннойПочты = РезультатОткрытияФормы.Email;
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонSMS = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			ТелефонSMS = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, ТелефонSMS, ТелефонСтрокой);
			АбонентскийНомерТелефона = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭлектроннойПочты = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ТелефонSMS = 0;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнить(ОповещениеПриЗавершении)
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если НомерКассовогоЧека <> 0 Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
		
		Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Документ не проведен!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ);  
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.КассаККМ];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		
		Если ИспользоватьБезПримененияККТ Тогда
			ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи);
			
			НомерДокументаКассыККМ[Объект.КассаККМ] = ПорядковыйНомерПродажи +	1;
				
			Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
			
			ЭтотОбъект.Доступность = Истина;
			НомерКассовогоЧека = НомерЧекаДляДокумента();
			ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
			УстановитьВидимостьЭлементовФормы();
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
			
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		ЭтотОбъект.Доступность = Ложь;

		// Готовим данные
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
										
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается при нажатии кнопки "НапечататьЧек" командной панели.
//
&НаКлиенте
Процедура ПробитьЧекНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ПробитьЧекСПроверкойСтавокНДС();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если ЧекПробит Тогда
		ТолькоПросмотр = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКнопокПроведенияКлиент()
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Функция ЕстьЧекНепримененияККТ()
	Результат = Ложь;
	
	ЧекНепримененияККТ = ПодключаемоеОборудованиеБГУ.ИсправительныйЧекККМОперацииНепримененияККТ(Объект.Ссылка);
	Если ЗначениеЗаполнено(ЧекНепримененияККТ) Тогда
		ТекстСообщения = НСтр("ru = 'Кассовый чек не может быть напечатан. Для документа %1 
		|введен документ ""Исправительный чек ККМ"" с видом операции ""Неприменение ККТ""!
		|Документ %2 можно открыть через ""Связанные документы"" меню навигации.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.Ссылка, ЧекНепримененияККТ);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , );
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены(ПросмотрЧека = Ложь)
	Результат = Истина;
	
	Если НЕ ПросмотрЧека Тогда
		ЕстьЧекНепримененияККТ = ЕстьЧекНепримененияККТ();
		Если ЕстьЧекНепримененияККТ Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ ПодключаемоеОборудованиеБГУВызовСервера.ПлатежноРасчетныйДокументИсполнен(Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'Документ не исполнен!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СтатусЭтогоДокумента");
		
		Результат = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" у реквизита ""Ответственный""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СистемаНалогообложенияЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ТипРасчета");
		
		Результат = Ложь;	
	КонецЕсли;
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	СуммаВсего = СтавкаДокумента.Всего;
	Если СуммаВсего <> Объект.СуммаДокумента Тогда
		ЕстьЧастичнаяОплата = Ложь;
		Для каждого ТекОплата Из Объект.ДокументыЧекаККМ Цикл
			Если ТекОплата.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаЧастичная Тогда
				ЕстьЧастичнаяОплата = Истина;
		        Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьЧастичнаяОплата Тогда
			ТекстСообщения = НСтр("ru = 'Сумма документа не равна итоговой сумме товаров/услуг документов-оснований чека ККМ! Следует использовать команду ""Заполнить сумму документа""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
	Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
		Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
			ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Результат = Ложь;
		ИначеЕсли Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
			ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
			Если ЗначениеЗаполнено(ВозвратНоменклатурыПрейскуранта) Тогда
				Если НЕ(Объект.СистемаНалогообложенияЧекаККМ = ВозвратНоменклатурыПрейскуранта.СистемаНалогообложенияЧекаККМ) Тогда
					ТекстСообщения = НСтр("ru = 'Система налогообложения в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствует системе налогообложения на закладке ""Чек ККМ""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
				Если НЕ(Объект.ПараметрыДоговораПлатежногоАгента = ВозвратНоменклатурыПрейскуранта.ПараметрыДоговораПлатежногоАгента) Тогда
					ТекстСообщения = НСтр("ru = 'Параметры договора платежного агента в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствуют параметрам на закладке ""Чек ККМ""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru = 'Не заполнен документ-основание ""Перечень номенклатуры прейскуранта для возврата""!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка);
	ЕстьПустыеНаименованияТоваровУслуг = Ложь;
	ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
	НомераСтрокПустыхНаименований = "";
	НомераСтрокПустыхПредметовРасчета = "";
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Наименование) Тогда
			ЕстьПустыеНаименованияТоваровУслуг = Истина;
			НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета) Тогда
			ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
			НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
	КонецЦикла;	
	
	Если ЕстьПустыеНаименованияТоваровУслуг Тогда
		НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
		Если НомераСтрокПустыхНаименований = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека пустое наименование номенклатуры! 
			|Следует в документе-основании заполнить номенклатуру и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека пустые наименования номенклатуры!
			|Следует в документах-основаниях для этих строк заполнить номенклатуру и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
		НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
		Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета! 
			|Следует в документе-основании заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета!
			|Следует в документах-основаниях для этих строк заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	ПолучательЧекаККМ = Объект.Контрагент;
	Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
		ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.НомерТелефонаДляЭлектронногоЧекаКорректен(АбонентскийНомерТелефона) Тогда
			ТекстСообщения = НСтр("ru = 'Номер телефона для электронного чека указан некорректно!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.АбонентскийНомерТелефона");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес электронной почты для электронного чека указан некорректно!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.АдресЭлектроннойПочты");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			Попытка
				СохраненныйТелефон = Число(АбонентскийНомерТелефона);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,"АбонентскийНомерТелефона");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонSMS = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, ТелефонSMS, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма, НомерЧекаККМ = 0)
	ТекстЗаголовкаДанныхЧека = "";
	
	Объект = Форма.Объект;
	
	ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
	
	НомерЧекаККМ = ?(НомерЧекаККМ<>0, НомерЧекаККМ, Объект.НомерЧекаККМ);
	
	Если ИспользуетсяККТСПередачейДанных Тогда
		ТекстНомераЧека = НСтр("ru='ФД № '")+Формат(НомерЧекаККМ,"ЧГ=");
	Иначе	
		ТекстНомераЧека = НСтр("ru='№ '")+Формат(НомерЧекаККМ,"ЧГ=");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Форма.ЗаключительныйЧекИсправительный) Тогда
		ТекстНомераЧека = ТекстНомераЧека + " отменен";
	КонецЕсли;	
	
	Если НомерЧекаККМ<>0 Тогда
		ТекстЗаголовкаДанныхЧека = ТекстНомераЧека;
	КонецЕсли;	
	
	Форма.ДанныеЗаголовкаСтраницыЧекаККМ = ТекстЗаголовкаДанныхЧека;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьЗаполненияСуммы(Форма) Экспорт
	
	Результат = Истина;
	
	Если Форма.Модифицированность Тогда
		
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после записи документа'"));
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПроверитьВозможностьПечатиЧека()

&НаСервере
Процедура КомандаЗаполнитьСуммуДокументаНаСервере()
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	Объект.СуммаДокумента = СтавкаДокумента.Всего;
	Объект.СуммаДокументаВВалюте = СтавкаДокумента.Всего;
	
	Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		Объект.РасшифровкаПлатежа[0].Сумма = СтавкаДокумента.Всего;
	КонецЕсли;	
	
	ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
	Для Каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
		Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
			ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ИначеЕсли Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
			ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
			Если ЗначениеЗаполнено(ВозвратНоменклатурыПрейскуранта) Тогда
				Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
					Объект.Договор = ВозвратНоменклатурыПрейскуранта.Договор;
				КонецЕсли;
				Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
					БК = РасшифровкаПоВозвратуНоменклатурыПрейскуранта(ВозвратНоменклатурыПрейскуранта);
					БК.Свернуть("КФО, КБКНазначениеПлатежа, КОСГУНазначениеПлатежа, КодЦели, КодМероприятия, ДопКлассификация, СтрокаНазначениеПлатежа",
						"Сумма, СуммаВал");
					Объект.РасшифровкаПлатежа.Загрузить(БК);
					Объект.СуммаДокумента = БК.Итог("Сумма");
					Объект.СуммаДокументаВВалюте = БК.Итог("СуммаВал");
				КонецЕсли;
					
				Если НЕ ЗначениеЗаполнено(Объект.КорСчет) Тогда
					Объект.КорСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("205.31");
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

