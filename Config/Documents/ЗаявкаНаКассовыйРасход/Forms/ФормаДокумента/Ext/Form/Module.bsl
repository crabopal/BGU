&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
		Если Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			
			ОбновитьКурсВалюты();
			
			Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС);
			
			БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(Истина, Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	КонецЕсли; 
	
	Если ЭтотОбъект.КэшПараметров.ИзменилсяГодДаты Тогда
		ПлатежноРасчетныеДокументы.КорСчетЗаполнитьСписокВыбора(ЭтотОбъект);
	КонецЕсли;	
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ЗаполнитьПредельнуюДатуИсполненияЗаявки(Объект.ПредельнаяДатаИсполнения, Объект.Дата, Объект.ЛицевойСчет, СвойстваЛицевогоСчета);  
	
	БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановленнаяДлинаНазначенияПлатежаКлиент();
	УстановитьДоступностьРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КорСчетПриИзменении(Элемент)
	
	КорСчетПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура КорСчетПриИзмененииНаСервере()
	
	Объект.ПризнакАвансовогоПлатежа = БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "206.00");
	
	Для Каждого СтрокаДокумента Из Объект.РасшифровкаПлатежа Цикл
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(СтрокаДокумента,
			СтрокаДокумента.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЦикла;
	
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	УстановленнаяДлинаНазначенияПлатежаКлиент();
	
	УстановитьВидимостьВалютныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
	ПолучитьЛицевойСчетОрганКазначейства();
	УстановленнаяДлинаНазначенияПлатежаКлиент();
	
	УстановитьВидимостьВалютныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Организация, ТекущаяСтрока, ТипЛицевогоСчета, НаДату", Объект.Организация, Объект.РеквизитыЛицевогоСчета, ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Казначейский"), Объект.Дата);
	ОткрытьФорму("Справочник.РеквизитыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	
	УстановитьДоступностьРеквизитовКонтрагента();
	УстановитьДоступностьДоговора();
	
	ЗаполнениеДанныхДляЧекаККМ();
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элемент);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.ЗаявкаНаКассовыйРасход");
	
	ПолучательПриИзмененииНаСервере();
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры   

&НаСервере
Процедура ИнойПлательщикПриИзмененииНаСервере()   
	
	Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыИногоПлательщика(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнойПлательщикПриИзменении(Элемент)  
	
	ИнойПлательщикПриИзмененииНаСервере();   
	
КонецПроцедуры


&НаКлиенте
Процедура СчетКонтрагентаПриИзменении(Элемент)
	
	ПолучательПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		
		РеквизитыДоговора = ПолучитьРеквизитыДоговора(Объект.Договор);
		
		Объект.НомерОбязательства = РеквизитыДоговора.УчетныйНомерОбязательства;
		
		Если Объект.РеквизитыДокументаОснования.Количество() = 0 Тогда
			Объект.РеквизитыДокументаОснования.Добавить();
		КонецЕсли;
		
		ТекущаяСтрокаРеквизитов = Объект.РеквизитыДокументаОснования[0];
		ТекущаяСтрокаРеквизитов.ДокументОснованиеВид		= РеквизитыДоговора.ВидОбязательства;
		ТекущаяСтрокаРеквизитов.ДокументОснованиеДата 		= РеквизитыДоговора.ДатаДоговора;
		ТекущаяСтрокаРеквизитов.ДокументОснованиеНомер		= РеквизитыДоговора.НомерДоговора;
		ТекущаяСтрокаРеквизитов.ДокументОснованиеПредмет 	= РеквизитыДоговора.КраткоеСодержание; 
		ТекущаяСтрокаРеквизитов.ВидРеестра = Сред(БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "КодВидаРеестра"), 1, 2);
    	ТекущаяСтрокаРеквизитов.НомерРеестровойЗаписи = БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "НомерРеестровойЗаписиВРеестреКонтрактов"); 
		ТекущаяСтрокаРеквизитов.ИдентификаторДокумента = БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "ИдентификаторЭтапа");
		
		ОплатаВРублях = РеквизитыДоговора.ОплатаВРублях;
		
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		КонецЕсли;
		
	Иначе
		
		ОплатаВРублях = Ложь;
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	УстановитьВидимостьВалютныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

