&НаКлиенте
Процедура УстановленнаяДлинаНазначенияПлатежаКлиент()
	
	ИННКПП = "";
		
	Если ЗначениеЗаполнено(Объект.ИННПлательщика) Тогда 
		ИННКПП = "(ИНН " + Объект.ИННПлательщика + " КПП " + Объект.КПППлательщика + ") "
	КонецЕсли;
	
	ДлинаПоля = СтрДлина(ИННКПП + СокрП(Объект.НазначениеПлатежа));
	
	УстановленнаяДлинаНазначенияПлатежа = " " +  Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")+ " симв., макс. " + Формат(УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧН=0; ЧГ=0") + " симв."
	+ ?(ДлинаПоля > УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, ", превышение " + Формат(ДлинаПоля - УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧГ=0") + " симв.", "");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовОрганизации()

	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	
	Элементы.ЛицевойСчет.Доступность 	= ДоступностьРеквизитов;
	Элементы.Подразделение.Доступность 	= ДоступностьРеквизитов;
	Элементы.ПерваяПодпись.Доступность 	= ДоступностьРеквизитов;
	Элементы.ВтораяПодпись.Доступность 	= ДоступностьРеквизитов;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовКонтрагента()

	Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация);	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСуммуНДС(СуммаДокумента, СтавкаНДС)
	
	ПроцентНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
	СуммаНДС   = Окр(СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);
	
	Возврат СуммаНДС;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРублевоеПокрытие(Форма, Объект)
	
	Объект.СуммаДокумента 	= Объект.СуммаДокументаВВалюте*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	
	Для Каждого ДанныеСтроки Из Объект.РасшифровкаПлатежа Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКурсВалюты()
	
	КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
	Объект.Курс = КурсКратность.Курс;
	Объект.Кратность = КурсКратность.Кратность;
	
	ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьВалютныхРеквизитов(Форма)
	
	Видимость = (Форма.Объект.ВалютаДокумента <> Форма.КэшПараметров.ВалютаРегламентированногоУчета)
		И Форма.ОплатаВРублях;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Курс", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Кратность", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуммаДокумента", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "РасшифровкаПлатежаСумма", "Видимость", Видимость);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ИнформацияОКурсеПлатежа", "Видимость",
		Форма.Объект.ВалютаДокумента <> Форма.КэшПараметров.ВалютаРегламентированногоУчета
		И НЕ Форма.ОплатаВРублях);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИнформационнаяСтрокаОКурсеПлатежа(РеквизитыИсполнения)
	
	Если ЗначениеЗаполнено(РеквизитыИсполнения.ДатаПроведения) Тогда
		ТекстСообщения = НСтр("ru = 'Курс иностранной валюты: %1 (установлен при исполнении документа)'");
		ИнформацияОКурсеПлатежа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, РеквизитыИсполнения.Курс);
	Иначе
		ИнформацияОКурсеПлатежа = НСтр("ru = 'Курс иностранной валюты устанавливается при исполнении документа'");
	КонецЕсли;
	
	Возврат ИнформацияОКурсеПлатежа;
	
КонецФункции

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаНаСервере()
	
	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика");
	
	Если ЗначениеЗаполнено(Объект.НалогСборПлатеж) Тогда
		
		Результат = Новый Структура("ИННПлательщика, КПППлательщика");
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.НалогСборПлатеж, Результат);
		
		Если ЗначениеЗаполнено(Результат.ИННПлательщика) Тогда
			РеквизитыПлательщика.Вставить("ИННПлательщика", Результат.ИННПлательщика);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат.КПППлательщика) Тогда
			РеквизитыПлательщика.Вставить("КПППлательщика", Результат.КПППлательщика);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыПлательщика);
	
	СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьПредельнуюДатуИсполненияЗаявки(Объект.ПредельнаяДатаИсполнения, ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()), Объект.ЛицевойСчет, СвойстваЛицевогоСчета);  
	
	Элементы.РасшифровкаПлатежаИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
	
	ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(Объект.ЛицевойСчет,СписокДопустимыхКФО,СписокИсточниковСредствПоКФО);
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		
		Если СписокДопустимыхКФО.НайтиПоЗначению(Стр.КФО) = Неопределено Тогда
			Стр.КФО = "";
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Стр.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет,Стр.КФО);
		Если ДопустимыеИсточникиСредств.Найти(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				Стр.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановленнаяМаксимальнаяДлинаНазначенияПлатежа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет, "МаксДлинаНазначенияПлатежа");
	
	Элементы.РасшифровкаПлатежаНаправлениеРасходованияВР.Видимость = НЕ СписокДопустимыхКФО.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение")) = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаКассовыйРасход", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчетаНаСервере();

КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьДолжность(Знач Подпись, ПодписьПечататьДолжность, Знач Дата)
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДолжностьСотрудника(Подпись, ПодписьПечататьДолжность, Дата);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыДоговора(Знач Договор)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора,КраткоеСодержание");
	
	РеквизитыДоговора.Вставить("УчетныйНомерОбязательства", РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(Договор));
	
	СведенияОВалютеОбязательства = РаботаСОбязательствами.СведенияОВалютеОбязательства(Договор);
	РеквизитыДоговора.Вставить("ОплатаВРублях", СведенияОВалютеОбязательства.ОплатаВРублях);
	
	Возврат РеквизитыДоговора;
	
КонецФункции

&НаСервере
Процедура НалогСборПлатежПриИзмененииНаСервере()
	
	НалоговыеНастройки =  БухгалтерскийУчет.ПолучитьНастройкиНалоговогоПлатежа(Объект.НалогСборПлатеж, Истина, Объект.Дата, Объект.Организация);
	
	ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем 	= НалоговыеНастройки.ЗаполнятьНезаполненныеНулем;
	ТаможенныйПлатеж 								= НалоговыеНастройки.ТаможенныйПлатеж;
	ПолеВводаСтатусСоставителя 						= НалоговыеНастройки.СтатусСоставителя;
	ПолеВводаПоказательОснования 					= НалоговыеНастройки.ПоказательОснования;
	ПолеВводаПоказательПериода 						= НалоговыеНастройки.ПоказательПериода;
	ПолеВводаПоказательТипа 						= НалоговыеНастройки.ПоказательТипа;

	Объект.ОчередностьПлатежа						= НалоговыеНастройки.ОчередностьПлатежа;
    Объект.КодБКНалога								= НалоговыеНастройки.КодБКНалога;
	Объект.КодОКАТО 								= БухгалтерскийУчетКлиентСервер.ОКАТООКТМОПоДате(Объект.Дата, НалоговыеНастройки.КодОКАТО, НалоговыеНастройки.КодОКТМО);

	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(НалоговыеНастройки)); 

    ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода"); 
	ЗначенияРеквизитов.Вставить("ПолеВводаКодТаможенногоОргана", НалоговыеНастройки.КодТаможенногоОргана);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);

    БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(НалоговыеНастройки.ИННПлательщика) Тогда
		
		Объект.ИННПлательщика = НалоговыеНастройки.ИННПлательщика;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НалоговыеНастройки.КПППлательщика) Тогда
		
		Объект.КПППлательщика = НалоговыеНастройки.КПППлательщика;
		
	КонецЕсли;
    	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, ,ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);
	
	// Контрагент и договор
	Если ЗначениеЗаполнено(НалоговыеНастройки.Контрагент) И НЕ НалоговыеНастройки.Контрагент = Объект.Контрагент Тогда
		
		Объект.Контрагент 		= НалоговыеНастройки.Контрагент;
		Объект.СчетКонтрагента 	= НалоговыеНастройки.СчетКонтрагента;
		
		ПолучательПриИзмененииНаСервере();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПолучательПриИзмененииНаСервере()
		
	Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте(ПересчитатьНомерПериода = Ложь)
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов, ПересчитатьНомерПериода);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, Объект[ИмяПоказателя]);
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));

	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция КонтрольДокументаПоОбязательствамСервер(Адрес)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Ложь, ТекущийОбъект, Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись), ЭтотОбъект);
	
	КонтрольРасходов.Контроль(ТекущийОбъект, Ложь,, Истина, Адрес);
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОстаткамЗадолженностиНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоОстаткамЗадолженности();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("СуммаВал") - Объект.СуммаДокументаВВалюте;
	
КонецПроцедуры

&НаСервере
Процедура РеквизитыДокументаОснованияПриНачалеРедактированияНаСервере(ВидРеестра, НомерРеестровойЗаписи);
	ВидРеестра = Сред(БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "КодВидаРеестра"), 1, 2);
    НомерРеестровойЗаписи = БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "НомерРеестровойЗаписиВРеестреКонтрактов");
КонецПроцедуры	

// СтандартныеПодсистемы.Свойства 
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры
