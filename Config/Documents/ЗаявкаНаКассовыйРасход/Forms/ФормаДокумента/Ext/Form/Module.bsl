КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КБКНазначениеПлатежа, 
													Объект.Организация,
													Объект.ИФО,
													,
													,
													Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКОСГУНазначениеПлатежаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.КорСчет) Тогда
		РасшифровкаПлатежаКОСГУНазначениеПлатежаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаКОСГУНазначениеПлатежаПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(Элементы.РасшифровкаПлатежа.ТекущаяСтрока);
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
			ДанныеСтроки.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаВалПриИзменении(Элемент)
		
	СтрокаТаблицы = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) И Объект.РасшифровкаПлатежа.Итог("СуммаВал") = Объект.СуммаДокументаВВалюте Тогда
		// Надо списать весь остаток рублевого покрытия
		СтрокаТаблицы.Сумма = Объект.СуммаДокумента - (Объект.РасшифровкаПлатежа.Итог("Сумма") - СтрокаТаблицы.Сумма)
	Иначе		
		СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность); 
	КонецЕсли;	
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("СуммаВал") - Объект.СуммаДокументаВВалюте;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовПриИзменении(Элемент)
	
	РасшифровкаПлатежаСчетРасчетовПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаСчетРасчетовПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(Элементы.РасшифровкаПлатежа.ТекущаяСтрока);
	
	ДанныеСтроки.ДопСубконтоРасчетов = Неопределено;
	ДанныеСтроки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
		ДанныеСтроки.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КОСГУНазначениеПлатежа) И ЗначениеЗаполнено(ДанныеСтроки.СчетРасчетов) Тогда
		ДанныеСтроки.КОСГУНазначениеПлатежа = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(ДанныеСтроки.СчетРасчетов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, ТекущиеДанные.КОСГУНазначениеПлатежа, Объект.КорСчет, ТекущиеДанные.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовНачалоВыбора(ПараметрыОтбора,
		Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, ТекущиеДанные.КОСГУНазначениеПлатежа, Объект.КорСчет, ТекущиеДанные.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовАвтоПодбор(ПараметрыОтбора,
		Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, ТекущиеДанные.КОСГУНазначениеПлатежа, Объект.КорСчет, ТекущиеДанные.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовОкончаниеВводаТекста(ПараметрыОтбора,
		Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДопСубконтоРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДопСубконтоРасчетовВид) Тогда
		ПараметрыВыбораДопСубконто = Новый Структура;
		ПараметрыВыбораДопСубконто.Вставить("Организация",   Объект.Организация);
		ПараметрыВыбораДопСубконто.Вставить("Счет",          ТекущиеДанные.СчетРасчетов);
		ПараметрыВыбораДопСубконто.Вставить("КПС",			 ТекущиеДанные.КБКНазначениеПлатежа);
		ПараметрыВыбораДопСубконто.Вставить("КЭК",			 ТекущиеДанные.КОСГУНазначениеПлатежа);
		ПараметрыВыбораДопСубконто.Вставить("НомерСубконто", ТекущиеДанные.ДопСубконтоРасчетовНомер);
		ПараметрыВыбораДопСубконто.Вставить("Субконто" + ТекущиеДанные.ДопСубконтоРасчетовНомер, ТекущиеДанные.ДопСубконтоРасчетов);
		БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораДопСубконто);
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Отбор = Новый Структура("ВидРасчетов,КФО,КодЦели,КодМероприятия,ДопКлассификация");
	ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
	Отбор.Вставить("ИФО", Объект.ИФО);
	Отбор.Вставить("Контрагент", Объект.Контрагент);
	Отбор.Вставить("Договор", Объект.Договор);
	Отбор.Вставить("Валюта", Объект.ВалютаДокумента);
	Отбор.Вставить("КПС", ТекущиеДанные.КБКНазначениеПлатежа);
	Отбор.Вставить("КЭК", ТекущиеДанные.КОСГУНазначениеПлатежа);
	Отбор.Вставить("ЭтоПоступление", Ложь);
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Объект.Организация, Объект.Договор, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаЗаполнитьДобавленныеКолонки()
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		
		Для Каждого СтрокаДокумента Из Объект.РасшифровкаПлатежа Цикл
			УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(СтрокаДокумента,
				СтрокаДокумента.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКодЦелиПриИзменении(Элемент)
	УстановитьДопСубконтоРасчетов(Элементы.РасшифровкаПлатежа.ТекущиеДанные, "КодЦели");
КонецПроцедуры 

&НаКлиенте
Процедура РасшифровкаПлатежаКодМероприятияПриИзменении(Элемент)
	УстановитьДопСубконтоРасчетов(Элементы.РасшифровкаПлатежа.ТекущиеДанные, "КодМероприятия");
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаДопКлассификацияПриИзменении(Элемент)
	УстановитьДопСубконтоРасчетов(Элементы.РасшифровкаПлатежа.ТекущиеДанные, "ДопКлассификация");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежа(Команда)
	
	СписокШаблонов = СписокШаблонов();
	
	Если СписокШаблонов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не найдено ни одного подходящего шаблона заполнения.'"));
	ИначеЕсли СписокШаблонов.Количество() = 1 Тогда
		ЗаполнитьНазначениеПлатежаНаКлиенте(СписокШаблонов[0], "");
	Иначе
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьНазначениеПлатежаНаКлиенте", ЭтотОбъект);
		СписокШаблонов.ПоказатьВыборЭлемента(Оповещение, "Выберите шаблон", СписокШаблонов[0]);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуПлатежа(Команда)
	
	Объект.СуммаДокумента 			= Объект.РасшифровкаПлатежа.Итог("Сумма");
	Объект.СуммаДокументаВВалюте 	= Объект.РасшифровкаПлатежа.Итог("СуммаВал"); 
	РазницаИтогаТЧ 					= 0;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткамЗадолженности(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Договор)
		И Не Объект.КорСчет = ЭтотОбъект.КэшПараметров.Локальные.Счет20800 Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Договор'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Договор");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.РасшифровкаПлатежа.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьПоОстаткамЗадолженностиЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоОстаткамЗадолженностиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПоОстаткамЗадолженностиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоОстаткамЗадолженностиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольДокументаПоОбязательствам(Команда)
	Адрес = Неопределено;
	
	ЕстьПревышения = КонтрольДокументаПоОбязательствамСервер(Адрес);
	
	Если ЕстьПревышения Тогда
		ОткрытьФорму("Справочник.НастройкиКонтроляОбязательств.Форма.ФормаРезультатовПроверки", Новый Структура("Адрес, ПредставлениеДокумента", Адрес, Объект.Ссылка));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЧек(Команда)
	
	ПробитьЧекНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьПредставлениеЧека(Команда)
	ВывестиПредставлениеЧека();
КонецПроцедуры

&НаКлиенте
Процедура КомандаEmail(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаEmail", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Email", АдресЭлектроннойПочты);
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Введите адрес электронной почты (Email)'"));
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияEmail", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУКлиент.ОткрытьФормуВводаEmailОтправкиЧерезОФД(ОбработчикОповещения, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаSMS(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаТелефона", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		ТелефонSMS = Число(АбонентскийНомерТелефона);
	Иначе
		ТелефонSMS = 0;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок" , НСтр("ru = 'Введите номер телефона'"));
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("ЧислоВвода", ТелефонSMS);
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияТелефона", ОтказПокупателяОтСохраненияДанных);
	
