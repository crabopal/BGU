// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВидМежотчетногоПериода,ВидОперации,КФО,СчетДоходовНУ");
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВидМежотчетногоПериода),
		КонецГода(ЗначенияРеквизитов.Дата) + 1, ЗначенияРеквизитов.Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчет.ОтражатьВНалоговомУчете(ЗначенияРеквизитов.Организация, ДатаУчетнойПолитики, ЗначенияРеквизитов.КФО)
		И НЕ ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	Запрос.УстановитьПараметр("ЭтоПрочиеДоходы",
		БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.СчетДоходовНУ, "Н91.01"));
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Ссылка КАК Регистратор,
	|	НачислениеДоходовБудущихПериодов.Дата КАК Период,
	|	НачислениеДоходовБудущихПериодов.Договор КАК Договор,
	|	НачислениеДоходовБудущихПериодов.Организация КАК Организация,
	|	НачислениеДоходовБудущихПериодов.ВидОперации КАК ВидОперации,
	|	НачислениеДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	НачислениеДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	НачислениеДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	НачислениеДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	НачислениеДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА НачислениеДоходовБудущихПериодов.ВидДеятельностиНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДеятельностиНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА НачислениеДоходовБудущихПериодов.СчетДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетДоходовНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И &ЭтоПрочиеДоходы
	|			ТОГДА НачислениеДоходовБудущихПериодов.СтатьяПрочихДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.НачислениеДоходовБудущихПериодов КАК НачислениеДоходовБудущихПериодов
	|ГДЕ
	|	НачислениеДоходовБудущихПериодов.Ссылка = &Ссылка";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

