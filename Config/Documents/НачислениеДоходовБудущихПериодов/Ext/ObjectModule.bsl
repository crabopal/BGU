#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
	 ИЛИ СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		
		Если ЗначениеЗаполнено(ДатаНачалаСписания) И ЗначениеЗаполнено(ДатаОкончанияСписания)
			И (ДатаОкончанияСписания < ДатаНачалаСписания) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Дата окончания списания'"),,,
				НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДатаОкончанияСписания", "Объект", Отказ);
		КонецЕсли;
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ДатаНачалаСписания");
		НепроверяемыеРеквизиты.Добавить("ДатаОкончанияСписания");
	КонецЕсли;
	
	РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДоходов,
		ЭтотОбъект, , Отказ);
	
	// Налоговый учет.
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
	Если ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
	ИначеЕсли НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, ДатаУчетнойПолитики, КФО) Тогда
		
		ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетДоходовНУ, "Н91.01");
		Если НЕ ЭтоПрочиеДоходы Тогда
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		КонецЕсли;
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
		
	ИначеЕсли УчетУСНКлиентСервер.ОтражатьВУСН(Организация, ДатаУчетнойПолитики, КФО) Тогда
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	// Способ признания расходов "По графику" нельзя использовать при безвозмездном поступлении имущества.
	Если ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование
		И СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Способ признания доходов'"), , ,
			НСтр("ru='Способ ""По графику"" нельзя использовать по договорам безвозмездного пользования.'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СпособПризнанияДоходов", "Объект", Отказ);
		
	КонецЕсли;
	
	// Контроль ведения расчетов в иностранной валюте.
	Если ЗначениеЗаполнено(ВалютаДокумента)
		И ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить()
		И  (ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях
		ИЛИ ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Учет в иностранной валюте не поддерживается для вида операции ""%1"".'"), ВидОперации);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ВидОперации", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = УслугиИРаботы.Итог("ВсегоСправедливая");
	
	Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику
		И ВидОперации <> Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях Тогда
		ДатаНачалаСписания = Неопределено;
		ДатаОкончанияСписания = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли