&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетДоходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()

	ПараметрыПодбора = Новый Структура;
	
	ЗаголовокПодбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Подбор услуг/работ в %1 (%2)'"),Объект.Ссылка,"Услуги");
	
	ПараметрыПодбора.Вставить("Заголовок", ЗаголовокПодбора);

	ПараметрыПодбора.Вставить("Подразделение",Объект.Подразделение);
	
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.УслугиАренды"));

	ПараметрыПодбора.Вставить("ТипыНоменклатуры",ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("Валюта",Объект.ВалютаДокумента);
	ПараметрыПодбора.Вставить("ЕстьЦена",Истина);
	ПараметрыПодбора.Вставить("ВыводитьНулевуюНоменклатуру",Истина);
	ПараметрыПодбора.Вставить("ИмяТаблицы","УслугиИРаботы");
	ПараметрыПодбора.Вставить("ПоказыватьЦены",Истина);
	ПараметрыПодбора.Вставить("ТипЦен",Объект.ТипЦены);
	
	Возврат ПараметрыПодбора; 

КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект.УслугиИРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		НоваяСтрока.ЦенаСправедливая = НоваяСтрока.Цена;
		НоваяСтрока.СуммаСправедливая = НоваяСтрока.Сумма;
		РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");
		РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "СуммаСправедливая");
		УслугиИРаботыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(НоваяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтавкиНДСизНоменклатуры()

	Для каждого ТекСтр Из Объект.УслугиИРаботы Цикл
		
		СтавкаНДСНоменклатуры =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.Номенклатура, "СтавкаНДС");
		Если ЗначениеЗаполнено(СтавкаНДСНоменклатуры) Тогда
			ТекСтр.СтавкаНДС = СтавкаНДСНоменклатуры;
			РасчитатьСтроку(ТекСтр, Объект.СуммаВключаетНДС, "Цена");
			РасчитатьСтроку(ТекСтр, Объект.СуммаВключаетНДС, "ЦенаСправедливая");
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

