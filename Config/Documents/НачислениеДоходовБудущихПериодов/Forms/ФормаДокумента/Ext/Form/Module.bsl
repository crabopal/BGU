	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДС");
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДССправедливая");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыСуммаНДССправедливаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УслугиИРаботы.ТекущиеДанные;
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДССправедливая");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыВсегоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УслугиИРаботы.ТекущиеДанные;
	ТекущиеДанные.ВсегоСправедливая = ТекущиеДанные.Всего;
	
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Всего");
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "ВсегоСправедливая");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыВсегоСправедливаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УслугиИРаботы.ТекущиеДанные;
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "ВсегоСправедливая");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыСчетДБППриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УслугиИРаботы.ТекущиеДанные;
	
	ТекущиеДанные.ЕстьКодЦели = БухгалтерскийУчетВызовСервераПовтИсп.ЕстьСубконтоСчета(ТекущиеДанные.СчетДБП,
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств"));
	
	Если Не ТекущиеДанные.ЕстьКодЦели Тогда
		ТекущиеДанные.КодЦели = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УслугиИРаботыЗаполнитьДобавленныеКолонки(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.УслугиИРаботы Цикл
		
		ТекущаяСтрока.ЕстьКодЦели = БухгалтерскийУчетВызовСервераПовтИсп.ЕстьСубконтоСчета(ТекущаяСтрока.СчетДБП,
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств"));
		
		УслугиИРаботыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ТекущаяСтрока);
		
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УслугиИРаботыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСтоимостьПоДоговору   = НСтр("ru = 'Сумма по договору:'");
	ТекущаяСтрока.ЗаголовокСтоимостьСправедливая = НСтр("ru = 'Справедливая стоимость:'");
	
	Если БухгалтерскийУчетКлиентСервер.МодульЧисла(ТекущаяСтрока.ВсегоСправедливая) > 
			БухгалтерскийУчетКлиентСервер.МодульЧисла(ТекущаяСтрока.Всего) Тогда
		ТекущаяСтрока.УпущеннаяВыгода = Формат(ТекущаяСтрока.ВсегоСправедливая - ТекущаяСтрока.Всего, "ЧЦ=12; ЧДЦ=2");
	Иначе
		ТекущаяСтрока.УпущеннаяВыгода = НСтр("ru = 'Отсутствует'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

