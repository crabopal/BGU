&НаСервере
Процедура ПересчитатьТипЦены()

	МассивНоменклатуры = Объект.УслугиИРаботы.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	ЦеныНоменклатуры = ПолучитьЦенуНоменклатуры(МассивНоменклатуры, Объект.ТипЦены, Объект.Организация, Объект.Дата);
	Для каждого ТекущиеДанные Из Объект.УслугиИРаботы Цикл
	
		СтрЦена = ЦеныНоменклатуры.Найти(ТекущиеДанные.Номенклатура, "Номенклатура");
		Если СтрЦена <> Неопределено Тогда
			ТекущиеДанные.Цена = СтрЦена.Цена;
		Иначе
			ТекущиеДанные.Цена = 0;
		КонецЕсли;
		РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Организация, Дата)

	МассивНоменклатуры = ТипЗнч(Номенклатура) = Тип("Массив");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ТипЦен = &ТипЦены
	|				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних";
	Если МассивНоменклатуры Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",			Дата); 
	Запрос.УстановитьПараметр("Организация",	Организация); 
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены); 
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура); 
	Результат = Запрос.Выполнить();
	Если МассивНоменклатуры Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		Иначе
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Цена;
		КонецЕсли;
	КонецЕсли;

КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(Номенклатура, ТипЦены, Организация, Дата)

	СтруктураДанных = Новый Структура("ЕдиницаИзмерения,СтавкаНДС");
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, СтруктураДанных);
	ДанныеНоменклатуры.Вставить("Цена", ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Организация, Дата));
	Возврат ДанныеНоменклатуры;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	
	ЭтоРеквизитГруппыСправедливаяСтоимость = (СтрНайти(ВРЕГ(ИмяРеквизита), "СПРАВЕДЛИВАЯ") <> 0);
	
	Если НЕ ЭтоРеквизитГруппыСправедливаяСтоимость Тогда
		
		// Расчет реквизитов "Цена", "Сумма", "СуммаНДС", "Всего".
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
		
	КонецЕсли;
	
	Если ЭтоРеквизитГруппыСправедливаяСтоимость ИЛИ ИмяРеквизита = "Количество" ИЛИ ИмяРеквизита = "СтавкаНДС" Тогда
		
		// Расчет реквизитов "ЦенаСправедливая", "СуммаСправедливая", "СуммаНДССправедливая", "ВсегоСправедливая".
		ПараметрыРасчета.Вставить("ИмяРеквизитаЦена",     "ЦенаСправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСумма",    "СуммаСправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСуммаНДС", "СуммаНДССправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаВсего",    "ВсегоСправедливая");
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ,
			СтрЗаменить(ВРЕГ(ИмяРеквизита), "СПРАВЕДЛИВАЯ", ""), ПараметрыРасчета);
		
	КонецЕсли;
	
	УслугиИРаботыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТЧ);
	
КонецПроцедуры

