&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	УслугиИРаботыЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Объект.ВидОперации);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УстановитьДоступностьПодразделения(ЭтотОбъект);
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВАрендуПользование =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАренду")
	 ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях")
	 ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("УслугиИРаботыСтоимостьАрендыЗаголовки");
	ЭлементыАмортизации.Добавить("УслугиИРаботыЦенаСправедливая");
	ЭлементыАмортизации.Добавить("УслугиИРаботыСуммаСправедливая");
	ЭлементыАмортизации.Добавить("УслугиИРаботыСтавкаНДССправедливая");
	ЭлементыАмортизации.Добавить("УслугиИРаботыСуммаНДССправедливая");
	ЭлементыАмортизации.Добавить("УслугиИРаботыВсегоСправедливая");
	ЭлементыАмортизации.Добавить("УслугиИРаботыУпущеннаяВыгода");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ЭтоПередачаВАрендуПользование);
	
	ЭтоПередачаВАрендуНаЛьготныхУсловиях = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях"));
	
	ОсобыйПорядокПризнанияДоходовТекущегоПериода =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке"));
	ПризнаниеДоходовТекущегоПериодаПоГрафику =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
	ВедетсяГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедетсяГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору;
	ЕстьГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ЕстьГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ЕстьГрафикПоДоговору;
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ДатаНачалаСписания");
	СрокСписания.Добавить("ДатаОкончанияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ ПризнаниеДоходовТекущегоПериодаПоГрафику ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходов",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходовПредупреждение",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ВедетсяГрафикПоДоговору);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВвестиГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ЕстьГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОткрытьГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ЕстьГрафикПоДоговору);
	
	Если ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаНачалаСписания));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаОкончанияСписания));
	КонецЕсли;
	
	Если ПризнаниеДоходовТекущегоПериодаПоГрафику Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Доходы будущих периодов относятся на финансовый результат текущего периода согласно графику, установленному договором.'"));
	ИначеЕсли ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Суммы списания доходов будущих периодов указываются вручную в регламентном документе ""Списание доходов будущих периодов"".'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'В течение указанного срока доходы будущих периодов относятся на финансовый результат текущего периода.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО)
		И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НЕ ЭтоПередачаВБезвозмездноеПользование;
	ОтражатьВНалоговомУчетеУСН = УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Объект.КФО)
		И (Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходы
		ИЛИ Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы)
		И НЕ ЭтоПередачаВБезвозмездноеПользование;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Доступность и оформление сумм в зависимости от вида операции.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыЦенаСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыСуммаСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыСуммаНДССправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыВсегоСправедливая");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыЦена");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыСумма");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыСуммаНДС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыВсего");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствует'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	// Доступность поля КодЦели в зависимости от настроек счета ДБП (401.4Х).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыКодЦели");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.УслугиИРаботы.ЕстьКодЦели", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

