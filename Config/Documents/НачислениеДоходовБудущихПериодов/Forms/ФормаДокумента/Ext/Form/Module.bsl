&НаКлиенте
Процедура КЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЭтоПередачаВАренду =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАренду"));
	ЭтоПередачаВАрендуНаЛьготныхУсловиях =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях"));
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	ЭтоПрочиеДоходы =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПрочиеДоходыБудущихПериодов"));	
	
	Если ЭтоПередачаВАренду ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПередачаВБезвозмездноеПользование Тогда
		ДопустимыеКЭК = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			"121,122,123", ",");
		ПараметрВыбораКЭК = Новый ПараметрВыбора("Отбор.Код", Новый ФиксированныйМассив(ДопустимыеКЭК));
	ИначеЕсли ЭтоПрочиеДоходы Тогда
		// Устанавливаем отбор по допустимым КОСГУ счета 401.40
		ПараметрВыбораКЭК = Новый ПараметрВыбора("ДополнительныйОтбор.Счет", "401.40");
	Иначе
		ПараметрВыбораКЭК = Новый ПараметрВыбора("Отбор.Код", "000");
	КонецЕсли;
		
	ПараметрыВыбораКЭК = Новый Массив();
	ПараметрыВыбораКЭК.Добавить(ПараметрВыбораКЭК);
	
	Элементы.КЭК.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКЭК);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьВалютаНДСНажатие(Элемент, СтандартнаяОбработка)
	
	// Старые значения (до изменения) запомним в кэше в локальных параметрах.
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЦены", Объект.ТипЦены);
	
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		ПересчитатьСуммаВключаетНДС();
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЦены <> Объект.ТипЦены Тогда
		
		Если Объект.УслугиИРаботы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Табличная часть документа содержит услуги.
								|Пересчитать цены табличной части?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Да, пересчитать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Нет, не пересчитывать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не изменять тип цены");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ТипЦеныПриИзмененииЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки,,КодВозвратаДиалога.Отмена);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ПересчитатьТипЦены();
		
	Иначе // Восстанавливаем предыдущее значение типа цен.
		
		Объект.ТипЦены = ЭтотОбъект.КэшПараметров.Локальные.ТипЦены;
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

