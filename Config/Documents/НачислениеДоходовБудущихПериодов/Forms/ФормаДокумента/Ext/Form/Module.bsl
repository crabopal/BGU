КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	
	ЭтоПередачаВАренду =
		(Объект.ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭтоПередачаВАрендуНаЛьготныхУсловиях =
		(Объект.ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях);
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	Если ЭтоПередачаВАренду ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПередачаВБезвозмездноеПользование Тогда
		
		Объект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам;
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата);
		
	Иначе
		
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата);
		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.УслугиИРаботы Цикл
		
		Если ЭтоПередачаВАренду Тогда
			СтрокаТаблицы.ЦенаСправедливая     = СтрокаТаблицы.Цена;
			СтрокаТаблицы.СуммаСправедливая    = СтрокаТаблицы.Сумма;
			СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.СуммаНДС;
			СтрокаТаблицы.ВсегоСправедливая    = СтрокаТаблицы.Всего;
		ИначеЕсли ЭтоПередачаВБезвозмездноеПользование Тогда
			СтрокаТаблицы.Цена     = 0;
			СтрокаТаблицы.Сумма    = 0;
			СтрокаТаблицы.СуммаНДС = 0;
			СтрокаТаблицы.Всего    = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Объект.ВидОперации);
	
	УслугиИРаботыЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

