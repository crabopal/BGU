#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыЧекаККМ

&НаКлиенте
Процедура ДокументыЧекаККМДокументОснованиеЧекаККМПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДокументыЧекаККМ.ТекущиеДанные;
	
	Если (Объект.ТипПередачи = 3) Тогда
		ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОснованиеЧекаККМ) Тогда
			СуммаДокОснования = ПолучитьСуммуДокументаОснования(ТекущиеДанные.ДокументОснованиеЧекаККМ);
			ТекущиеДанные.СуммаВстречногоПредоставления = СуммаДокОснования;
			ТекущиеДанные.СуммаПредоплаты = 0;
		КонецЕсли;	
		
		УстановитьВидимостьЭлементовФормы();
		
		РасчетЗачетаАвансаПостоплаты();

		Возврат;
	КонецЕсли;
	
	ОпределениеЗачетаАвансаПостоплаты();
	
	Если (Объект.ТипПередачи = 1) Тогда
		ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
	Иначе
		ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОснованиеЧекаККМ) И (Объект.ТипПередачи <> 3) Тогда
		РасчетЗачетаАвансаПостоплаты();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЧекаККМСуммаПредоплатыПриИзменении(Элемент)
	РасчетЗачетаАвансаПостоплаты()
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЧекаККМСуммаВстречногоПредоставленияПриИзменении(Элемент)
	РасчетЗачетаАвансаПостоплаты()
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЧекаККМПослеУдаления(Элемент)
	РасчетЗачетаАвансаПостоплаты()
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаEmail(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаEmail", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Email", АдресЭлектроннойПочты);
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Введите адрес электронной почты (Email)'"));
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияEmail", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУКлиент.ОткрытьФормуВводаEmailОтправкиЧерезОФД(ОбработчикОповещения, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаSMS(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаТелефона", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		ТелефонSMS = Число(АбонентскийНомерТелефона);
	Иначе
		ТелефонSMS = 0;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок" , НСтр("ru = 'Введите номер телефона'"));
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("ЧислоВвода", ТелефонSMS);
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияТелефона", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУКлиент.ОткрытьФормуВводаТелефонаДляОтправкиЧерезОФД(ОбработчикОповещения, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчиститьEmailИSMS(Команда)
	АдресЭлектроннойПочты = "";
	АбонентскийНомерТелефона = "";
	ДанныеSMSИлиEmail = "";
	ТелефонСтрокой = "";
	ОтказПокупателяОтСохраненияДанных = Истина;
	
	ОбновитьФормуSMSИEmail();
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЧек(Команда)
	ПробитьЧекНаКлиенте();
КонецПроцедуры

