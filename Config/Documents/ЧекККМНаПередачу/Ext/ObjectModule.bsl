#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	ЭтотОбъект.НомерЧекаККМ = 0;
	ЭтотОбъект.НомерСменыККМ = 0;
	ЭтотОбъект.СтатусЧекаККМ = "";
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив();
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ЧекиККМСпискомСсылка = НайтиЧекиККМ(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(ЧекиККМСпискомСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 уже введен документ %2.'"), ДанныеЗаполнения, ЧекиККМСпискомСсылка);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнитьПоДокументуРеализации(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиЧекиККМ(ДокументОснование)
	Результат = Документы.ЧекККМНаПередачу.ПустаяСсылка();

	Если ТипЗнч(ДокументОснование) = Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧекККМНаПередачуДокументыЧекаККМ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЧекККМНаПередачу.ДокументыЧекаККМ КАК ЧекККМНаПередачуДокументыЧекаККМ
	               |ГДЕ
	               |	ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ = &ДокументОснование
	               |	И ЧекККМНаПередачуДокументыЧекаККМ.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Процедура ЗаполнитьПоДокументуРеализации(ДокументОснование)
	ЗаполняемыеДанные = "Организация, Контрагент, Договор";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
	ЭтотОбъект.ДокументыЧекаККМ.Очистить();
	НоваяСтрока = ЭтотОбъект.ДокументыЧекаККМ.Добавить();
	НоваяСтрока.ДокументОснованиеЧекаККМ = ДокументОснование;
	
	СписокДокументовОснованийЧекаККМ = ЭтотОбъект.ДокументыЧекаККМ.Выгрузить();
	СписокДокументовОснованийЧекаККМ.Колонки.Добавить("ОписаниеОшибки", Новый ОписаниеТипов("Строка"));
	СписокДокументовОснованийЧекаККМ.Колонки.Добавить("ТипПередачи", Новый ОписаниеТипов("Число"));
	СписокДокументовОснованийЧекаККМ.Колонки.Добавить("СуммаДокументаОснования", Новый ОписаниеТипов("Число"));
	
	СведенияОПредоплатеПоДокументуРеализации = ПодключаемоеОборудованиеБГУ.ДанныеЧекаККМНаЗачетАвансаПоДокументамОснованиям(КонецДня(ТекущаяДата()),
		СписокДокументовОснованийЧекаККМ);
		
	Для каждого ТекСтрока Из ДокументыЧекаККМ Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ДокументОснованиеЧекаККМ", ТекСтрока.ДокументОснованиеЧекаККМ);
				
		МассивСведенийОЗачтенныхАвансах = СведенияОПредоплатеПоДокументуРеализации.ТаблицаПредоплаты.НайтиСтроки(ПараметрыОтбора);
		Для каждого ТекЗачетАванса Из МассивСведенийОЗачтенныхАвансах Цикл
			ТекСтрока.СуммаПредоплаты = ТекЗачетАванса.СуммаПредоплаты;
			
			Если ТекЗачетАванса.СуммаПредоплаты > 0 Тогда
				Если ТекЗачетАванса.СуммаПредоплаты = ТекЗачетАванса.СуммаДокументаОснования Тогда
					ТекСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
				Иначе
					ТекСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты;
				КонецЕсли;	
			Иначе
				ТекСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты;
			Конецесли;	
			
			Если ЗначениеЗаполнено(ТекЗачетАванса.ОписаниеОшибки) Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекЗачетАванса.ОписаниеОшибки);
			КонецЕсли;	
			
			Прервать;
		КонецЦикла;	
	КонецЦикла;		
	
	ЭтотОбъект.ТипПередачи = СведенияОПредоплатеПоДокументуРеализации.ТипПередачи;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли