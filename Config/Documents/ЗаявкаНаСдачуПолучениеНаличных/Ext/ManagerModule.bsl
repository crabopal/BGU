КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Возвращает массив структур, содержащих значения реквизитов документа для выгрузки
//
// Параметры:
// МассивОбъектов               - Массив объектов данного вида
// ИспользоватьДопКл            - Признак применения доп. классификации и указании ее значений в структурах реквизитов документов
// ИспользоватьКодМероприятия   - Признак применения кодов мероприятий
// ИспользоватьКЭК              - Признак использования КЭК
// ИспользоватьАналитическийКод - Признак использования аналитического кода
// ИспользоватьКФО              - Признак применения КФО и указания значений КФО в структурах реквизитов документа
// ИспользоватьКОСГУПолучателя  - Признак использования КОСГУПолучателя
Функция ЗначенияРеквизитовДокумента(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт  
	
	Возврат ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаСдачуПолучениеНаличных(МассивОбъектов, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьАналитическийКод, ИспользоватьКФО, ИспользоватьКОСГУПолучателя);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЗаявкаДляОбеспеченияНаличными") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
КонецФункции	

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
		
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаСдачуПолучениеНаличных";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0402108";
	КомандаПечати.Представление		= НСтр("ru = 'Заявка на сдачу/получение наличных денег (ф. 0402108)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0402108") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0402108",
			"Заявка на сдачу/получение наличных денег",
			ПечатьЗаявкиНаСдачуПолучениеНД(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует табличный документ Заявка на сдачу/получение наличных денег (ф. 0402108)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявкиНаСдачуПолучениеНД(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкиНаСдачуПолучениеНаличных";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Форма0402108");
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаСдачуПолучениеНаличных(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
				
		// Вывод в табличный документ
		ОбластьВывода = Макет.ПолучитьОбласть("Шапка");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);  
		
		ОбластьВывода.Параметры["НаименованиеЗаявки"] = "Заявка на " + ?(ДанныеДляПечати.ЭтоПолучение, "получение", "сдачу") + " наличных денег"; 
		ОбластьВывода.Параметры["ИмяСообщения"]       = "Сообщаем о " + ?(ДанныеДляПечати.ЭтоПолучение, "получении", "сдаче");
		ОбластьВывода.Параметры["НазваниеСчета"]      = "Для " + ?(ДанныеДляПечати.ЭтоПолучение, "зачисления на счет №", "списания со счета №");
		
		ТабДокумент.Вывести(ОбластьВывода);   
		
		Для каждого Банкнота Из ДанныеДляПечати.Банкноты Цикл  
			
			ОбластьВывода = Макет.ПолучитьОбласть("Банкноты");
		    ОбластьВывода.Параметры.Заполнить(Банкнота);     
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЦикла;    
		
		Если ДанныеДляПечати.Монеты.Количество()>0 Тогда
			
			ОбластьВывода = Макет.ПолучитьОбласть("МонетыШапка");   
			ТабДокумент.Вывести(ОбластьВывода);     
			
		КонецЕсли;     
		
		Для каждого Монета Из ДанныеДляПечати.Монеты Цикл  
			
			ОбластьВывода = Макет.ПолучитьОбласть("Монеты");
		    ОбластьВывода.Параметры.Заполнить(Монета);     
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЦикла;   
		
		Если ДанныеДляПечати.Источники.Количество()>0 Тогда
			
			ОбластьВывода = Макет.ПолучитьОбласть("ИсточникиШапка");   
			ТабДокумент.Вывести(ОбластьВывода);     
			
		КонецЕсли;     
		
		Для каждого Источник Из ДанныеДляПечати.Источники Цикл  
			
			ОбластьВывода = Макет.ПолучитьОбласть("Источники");
		    ОбластьВывода.Параметры.Заполнить(Источник);     
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЦикла;  
				
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);  
		
		ОбластьВывода.Параметры["НазваниеРаботника"] = ?(ДанныеДляПечати.ЭтоПолучение, "Получатель", "Вноситель") + " наличных денег"; 
				
		ТабДокумент.Вывести(ОбластьВывода);   

    КонецЦикла;	
		
	Возврат ТабДокумент;
	
КонецФункции


#КонецОбласти

#КонецОбласти

#КонецЕсли

