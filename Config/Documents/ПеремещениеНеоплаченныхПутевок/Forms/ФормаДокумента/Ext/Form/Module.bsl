&НаСервере
Функция ПоместитьДанныеВХранилище()

	ТаблицаДанных = Объект.Материалы.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДанных);

КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()
	
	Элементы.ЦМООтправитель.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЦМОПолучатель.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПодразделениеПолучатель.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПодразделениеОтправитель.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	
	ТаблицаДанных = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДанныхВХранилище);
	
	Объект.Материалы.Очистить();
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
		НоваяСтрока.КоличествоЗатребовано = НоваяСтрока.Количество;
	КонецЦикла;

КонецПроцедуры

