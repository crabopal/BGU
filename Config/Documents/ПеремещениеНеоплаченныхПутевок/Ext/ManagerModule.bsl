Функция ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, ИмяМакета)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеНеоплаченныхПутевок.Ссылка КАК Ссылка,
	|	ПеремещениеНеоплаченныхПутевок.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ СчетаДокументов
	|ИЗ
	|	Документ.ПеремещениеНеоплаченныхПутевок КАК ПеремещениеНеоплаченныхПутевок
	|ГДЕ
	|	ПеремещениеНеоплаченныхПутевок.Ссылка В(&МассивОбъектов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	СчетУчета";
	Запрос.Выполнить();
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеНеоплаченныхПутевок.Дата КАК Дата,
	|	ПеремещениеНеоплаченныхПутевок.Номер,
	|	ПеремещениеНеоплаченныхПутевок.Проведен,
	|	ПеремещениеНеоплаченныхПутевок.Организация,
	|	ПеремещениеНеоплаченныхПутевок.ИФО,
	|	ПеремещениеНеоплаченныхПутевок.СчетУчета.Код КАК пКоррСчет,
	|	ПеремещениеНеоплаченныхПутевок.ЦМОПолучатель КАК ЦМО,
	|	ПеремещениеНеоплаченныхПутевок.ЦМООтправитель КАК ЦМООтправитель,
	|	ПеремещениеНеоплаченныхПутевок.Ссылка КАК Ссылка,
	|	ПеремещениеНеоплаченныхПутевок.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	ПеремещениеНеоплаченныхПутевок.Организация.КодОКПО КАК пКодОКПО,
	|	ПеремещениеНеоплаченныхПутевок.ЦМОПолучатель.Сотрудник КАК МолПолучатель,
	|	ПеремещениеНеоплаченныхПутевок.ЦМООтправитель.Сотрудник КАК МолОтправитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПеремещениеНеоплаченныхПутевок.ПодразделениеОтправитель, 0) <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА ПеремещениеНеоплаченныхПутевок.ПодразделениеОтправитель.ОбособленноеПодразделение
	|						ТОГДА ПеремещениеНеоплаченныхПутевок.ПодразделениеОтправитель.НаименованиеПолное
	|					ИНАЧЕ ПеремещениеНеоплаченныхПутевок.ПодразделениеОтправитель.Наименование
	|				КОНЕЦ
	|	КОНЕЦ КАК пПодразделениеОтправитель,
	|	ПеремещениеНеоплаченныхПутевок.ПодразделениеОтправитель.Код КАК пПодразделениеОтправительКод,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПеремещениеНеоплаченныхПутевок.ПодразделениеПолучатель, 0) <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА ПеремещениеНеоплаченныхПутевок.ПодразделениеПолучатель.ОбособленноеПодразделение
	|						ТОГДА ПеремещениеНеоплаченныхПутевок.ПодразделениеПолучатель.НаименованиеПолное
	|					ИНАЧЕ ПеремещениеНеоплаченныхПутевок.ПодразделениеПолучатель.Наименование
	|				КОНЕЦ
	|	КОНЕЦ КАК пПодразделениеПолучатель,
	|	ПеремещениеНеоплаченныхПутевок.ПодразделениеПолучатель.Код КАК пПодразделениеПолучательКод,
	|	ПеремещениеНеоплаченныхПутевок.Затребовал,
	|	ПеремещениеНеоплаченныхПутевок.ОтпускРазрешил
	|ИЗ
	|	Документ.ПеремещениеНеоплаченныхПутевок КАК ПеремещениеНеоплаченныхПутевок
	|ГДЕ
	|	ПеремещениеНеоплаченныхПутевок.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Ссылка КАК Ссылка,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент КАК Номенклатура,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Код КАК пКодМЦ,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Наименование + "" ("" + ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Серия + "" "" + ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Номер + "")"" КАК пНоменклатура,
	|	ВЫРАЗИТЬ(ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК пКодЕдиницы,
	|	ВЫРАЗИТЬ(ПеремещениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК пЕдиница,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Количество КАК пЗатребовано,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Количество КАК пКоличество,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Примечание КАК Примечание,
	|	1 КАК пЦена,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Количество КАК пСумма,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Ссылка.СчетУчета КАК Счет,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Ссылка.СчетУчета.КОСГУКт КАК КЭК,
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Ссылка.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	"""" КАК пНоменклатурныйНомер
	|ИЗ
	|	Документ.ПеремещениеНеоплаченныхПутевок.Материалы КАК ПеремещениеНеоплаченныхПутевокМатериалы
	|ГДЕ
	|	ПеремещениеНеоплаченныхПутевокМатериалы.Ссылка В(&МассивОбъектов)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
