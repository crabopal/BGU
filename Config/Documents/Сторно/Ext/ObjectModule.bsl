#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВидМежотчетногоПериода", ДанныеЗаполнения.Метаданные())
			И ЗначениеЗаполнено(ДанныеЗаполнения.ВидМежотчетногоПериода) Тогда
			
			ТекстСообщения = НСтр("ru='Нельзя сторнировать документ межотчетного периода!'");
			ВызватьИсключение ТекстСообщения;
			
			Возврат;
			
		КонецЕсли;
		
		ДокументОснование = ДанныеЗаполнения;
		
		Организация = ДокументОснование.Организация;
		
		Если ДокументОснование.Метаданные().Реквизиты.Найти("ИФО") <> Неопределено Тогда
			СтарыйИФО = ДокументОснование.ИФО;
		Иначе
			СтарыйИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйИФО) Тогда
			НовыйИФО = СтарыйИФО;
		КонецЕсли;
		
		Дата = НачалоДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
		
		ЗаполнитьПоДокументуОснованию(Истина, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
	ТаблицаРезультат = СтарыеПроводки.Выгрузить();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ВалютнаяСуммаДт"	, 0);
	ПараметрыОтбора.Вставить("КоличествоДт"		, 0);
	ПараметрыОтбора.Вставить("ВалютнаяСуммаКт"	, 0);
	ПараметрыОтбора.Вставить("КоличествоКт"		, 0);
	ПараметрыОтбора.Вставить("Сумма"			, 0);
	ПараметрыОтбора.Вставить("СуммаНеУчитываетсяНУ"	, 0);
	ПараметрыОтбора.Вставить("СуммаЕНВД"			, 0);
	ПараметрыОтбора.Вставить("СуммаНДС"				, 0);
	
	НулевыеСтроки = ТаблицаРезультат.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого НулеваяСтрока Из НулевыеСтроки Цикл
		ТаблицаРезультат.Удалить(НулеваяСтрока);
	КонецЦикла;
	
	Для Каждого ТекНоваяПроводка Из НовыеПроводки Цикл	
		ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), ТекНоваяПроводка);
	КонецЦикла;
	
	ДополнитьТаблицуПроводок(ТаблицаРезультат);
	
	Движения.ЖурналПроводокЕПСБУ.Записывать = Истина;
	Движения.ЖурналПроводокЕПСБУ.Загрузить(ТаблицаРезультат);
	Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		МетаданныеОснования = ДокументОснование.Метаданные();
		ЕстьИФОВШапке = ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеОснования);
		ИмпортированИзЗГУ = ОбщегоНазначения.ЕстьРеквизитОбъекта("ИмпортированИзЗГУ", МетаданныеОснования);
		ЕстьИФОВТч = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ИФО", МетаданныеОснования);
		 
		ДоступноИФОВШапке = ЕстьИФОВШапке И Не ИмпортированИзЗГУ;
		СтарыеПроводкиИФОЗаполненыВТЧ = ЕстьИФОВТч;
		НовыеПроводкиИФОЗаполненыВТЧ = ЕстьИФОВТч И (Не ДоступноИФОВШапке Или Не ЗначениеЗаполнено(НовыйИФО));

		Если Не НовыеПроводкиИФОЗаполненыВТЧ Тогда
			Для Каждого ТекНоваяПроводка Из НовыеПроводки Цикл
				
				ТекНоваяПроводка.ИФО = НовыйИФО;
				
			КонецЦикла;
		КонецЕсли;
		
		Если Не СтарыеПроводкиИФОЗаполненыВТЧ Тогда
			Для Каждого ТекСтараяПроводка Из СтарыеПроводки Цикл
				ТекСтараяПроводка.ИФО = СтарыйИФО;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если Документы.Сторно.ЭтоДокументПоДенежнымСредствам(ДокументОснование) Тогда
		ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка;
	КонецЕсли;
	
	ИзменитьПризнакСторнированияДокументаОснования(РежимЗаписи);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	// обнулить реквизит
	ТребуетсяПерезаполнитьПроводки = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДополнитьТаблицуПроводок(ТаблицаРезультат)
	
	Если ТаблицаРезультат.Колонки.Найти("Период") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("Организация") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("Регистратор") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("Регистратор", Новый ОписаниеТипов("ДокументСсылка.Сторно"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоДт1") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоДт1", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоДт2") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоДт2", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоДт3") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоДт3", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоКт1") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоКт1", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоКт2") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоКт2", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	Если ТаблицаРезультат.Колонки.Найти("ВидСубконтоКт3") = Неопределено Тогда
		ТаблицаРезультат.Колонки.Добавить("ВидСубконтоКт3", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	
	Для Каждого ТекПроводка Из ТаблицаРезультат Цикл
		ТекПроводка.Организация = Организация;
		ТекПроводка.Регистратор = Ссылка;
		ТекПроводка.Период		= Дата;
		Если ЗначениеЗаполнено(ТекПроводка.СчетДт) Тогда
			Для каждого ТекВидСубконто Из ТекПроводка.СчетДт.ВидыСубконто Цикл
				ТекПроводка["ВидСубконтоДт"+ТекВидСубконто.НомерСтроки] = ТекВидСубконто.ВидСубконто;
			КонецЦикла;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекПроводка.СчетКт) Тогда
			Для каждого ТекВидСубконто Из ТекПроводка.СчетКт.ВидыСубконто Цикл
				ТекПроводка["ВидСубконтоКт"+ТекВидСубконто.НомерСтроки] = ТекВидСубконто.ВидСубконто;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьПризнакСторнированияДокументаОснования(РежимЗаписи)
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		ОснованиеСторнирован = (РежимЗаписи = РежимЗаписиДокумента.Проведение);
		ДанныеОперации = РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(ДокументОснование);
		
		Если ЗначениеЗаполнено(ДанныеОперации.Документ)
			И ДанныеОперации.ДокументСторнирован <> ОснованиеСторнирован Тогда
			
			ДанныеОперации.ДокументСторнирован = ОснованиеСторнирован;
			РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(ДокументОснование, ДанныеОперации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ЗаполнениеДокумента

// Процедура заполняет табличные части документа по проводкам документа основания. В ТЧ СтарыеПроводки заполняются
// проводки красным, в ТЧ НовыеПроводки заполняются проводки черным.
//
// Параметры:
//  ЗаполнятьСтарыеПроводки - Булево - признак необходимости заполнения ТЧ СтарыеПроводки.
//  ЗаполнятьНовыеПроводки  - Булево - признак необходимости заполнения ТЧ НовыеПроводки.
//
Процедура ЗаполнитьПоДокументуОснованию(ЗаполнятьСтарыеПроводки = Истина, Знач ЗаполнятьНовыеПроводки = Истина,
	ПорядокИсправлениОшибок = Неопределено, пВыявительОшибки = Неопределено, пПричинаОшибки = Неопределено) Экспорт
	
	Если ЗаполнятьСтарыеПроводки Тогда
		Если СтарыеПроводки.Количество() > 0 Тогда
			СтарыеПроводки.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполнятьНовыеПроводки Тогда
		Если НовыеПроводки.Количество() > 0 Тогда
			НовыеПроводки.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	ДвиженияДокументаОснования = ДокументОснование.ПолучитьОбъект().Движения;
	Если ДвиженияДокументаОснования.Найти("ЖурналПроводокЕПСБУ") = Неопределено Тогда
		// ошибка. документ не формирует проводок
		Возврат;
	КонецЕсли;
	
	МассивИспользуемыхКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, НовыйИФО, Дата);
	МассивИспользуемыхКПС = Новый Массив;
	
	Для Каждого ТекКФО Из МассивИспользуемыхКФО Цикл
		МассивИспользуемыхКПС.Добавить(БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Организация, НовыйИФО, ТекКФО, Дата));
	КонецЦикла;
	
	ДвиженияДокументаОснования = ДвиженияДокументаОснования.ЖурналПроводокЕПСБУ;
	ДвиженияДокументаОснования.Прочитать();
	ТаблицаДвижений = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для Каждого ТекДвижение Из ДвиженияДокументаОснования Цикл
		
		НовДвижение = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(НовДвижение, ТекДвижение);
		Если ЗначениеЗаполнено(ТекДвижение.СчетДт) Тогда
			Для каждого ТекВидСубконто Из ТекДвижение.СчетДт.ВидыСубконто Цикл
				НовДвижение["ВидСубконтоДт"+ТекВидСубконто.НомерСтроки] = ТекВидСубконто.ВидСубконто;
				НовДвижение["СубконтоДт"+ТекВидСубконто.НомерСтроки] = ТекДвижение.СубконтоДт[ТекВидСубконто.ВидСубконто];
			КонецЦикла;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекДвижение.СчетКт) Тогда
			Для каждого ТекВидСубконто Из ТекДвижение.СчетКт.ВидыСубконто Цикл
				НовДвижение["ВидСубконтоКт"+ТекВидСубконто.НомерСтроки] = ТекВидСубконто.ВидСубконто;
				НовДвижение["СубконтоКт"+ТекВидСубконто.НомерСтроки] = ТекДвижение.СубконтоКт[ТекВидСубконто.ВидСубконто];
			КонецЦикла;
		КонецЕсли;
		
		Если ЗаполнятьСтарыеПроводки Тогда
			НовПроводка = СтарыеПроводки.Добавить();
			ЗаполнитьЗначенияСвойств(НовПроводка, НовДвижение);
			НовПроводка.Сумма                = - НовПроводка.Сумма;
			НовПроводка.СуммаНеУчитываетсяНУ = - НовПроводка.СуммаНеУчитываетсяНУ;
			НовПроводка.СуммаЕНВД            = - НовПроводка.СуммаЕНВД;
			НовПроводка.СуммаНДС             = - НовПроводка.СуммаНДС;
			НовПроводка.КоличествоДт         = - НовПроводка.КоличествоДт;
			НовПроводка.КоличествоКт         = - НовПроводка.КоличествоКт;
			НовПроводка.ВалютнаяСуммаДт      = - НовПроводка.ВалютнаяСуммаДт;
			НовПроводка.ВалютнаяСуммаКт      = - НовПроводка.ВалютнаяСуммаКт;
		КонецЕсли;
		
		Если ЗаполнятьНовыеПроводки Тогда
			ТекПроводка = НовыеПроводки.Добавить();
			ЗаполнитьЗначенияСвойств(ТекПроводка, НовДвижение);
			
			СтрКФО = МассивИспользуемыхКФО.Найти(ТекПроводка.КФО);
			Если СтрКФО = Неопределено Тогда
				ТекПроводка.КФО = Перечисления.КВД.ПустаяСсылка();
			Иначе
				Если ЗначениеЗаполнено(ТекПроводка.КПСДт) И
					МассивИспользуемыхКПС[СтрКФО].Найти(ТекПроводка.КПСДт.ВидПоказателя) = Неопределено Тогда
					ТекПроводка.КПСДт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
				КонецЕсли;
				Если ЗначениеЗаполнено(ТекПроводка.КПСКт) И
					МассивИспользуемыхКПС[СтрКФО].Найти(ТекПроводка.КПСКт.ВидПоказателя) = Неопределено Тогда
					ТекПроводка.КПСКт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ТаблицаДвижений.Удалить(НовДвижение);
		
	КонецЦикла;
	
	// Корректировка проводок, отражение исправления ошибок прошлых лет
	
	Если ЗначениеЗаполнено(ПорядокИсправлениОшибок)
		И ПорядокИсправлениОшибок <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка
		И Не Документы.Сторно.ЭтоДокументПоДенежнымСредствам(ДокументОснование) Тогда
		
		ПараметрыИсправленияОшибок = БухгалтерскийУчет.ПараметрыИсправленияОшибокПрошлыхЛет();
		ПараметрыИсправленияОшибок.ПорядокИсправленияОшибок	= ПорядокИсправлениОшибок;
		ПараметрыИсправленияОшибок.ВыявительОшибки			= пВыявительОшибки;
		ПараметрыИсправленияОшибок.ПричинаОшибки			= пПричинаОшибки;
		
		Если ЗаполнятьСтарыеПроводки И СтарыеПроводки.Количество() > 0 Тогда
			
			Табл = СтарыеПроводки.Выгрузить();
