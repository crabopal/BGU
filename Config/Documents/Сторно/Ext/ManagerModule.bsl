#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументОснование, Дата, ИсправлениеОшибки");
	Если Не ЗначениеЗаполнено(ДанныеДокумента.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	МетаданныеДокумента = ДанныеДокумента.ДокументОснование.Метаданные();
	
	ИндексВт = 1;
	ТекстЗапроса = "";
	СоответствиеТаблиц = Новый Соответствие;
	КоличествоТаблицДвижения = -1;
	ЕстьДвиженияПоРегистрам = Ложь;
	
	Для Каждого ТекДвижение Из МетаданныеДокумента.Движения Цикл
	
		ПолноеИмя = ТекДвижение.ПолноеИмя();
		СоставИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ПолноеИмя);
		
		Если СоставИмени[0] = "РегистрСведений" Тогда
			
			ЕстьДвиженияПоРегистрам  = Истина;
			
			ИмяВТ = "ВременнаяТаблица" + ИндексВТ;
			ИмяВТСрез = "ВременнаяТаблицаСрез" + ИндексВТ;
			
			// измерения регистра выделяются в отдельный массив: по ним будет соединение таблиц
			Измерения = Новый Массив;
			Для каждого ТекИзмерение Из ТекДвижение.Измерения Цикл
				Измерения.Добавить(ТекИзмерение.Имя);
			КонецЦикла; 
			
			// ресурсы и реквизиты заносим в один массив
			Ресурсы = Новый Массив;
			Для каждого ТекРесурс Из ТекДвижение.Ресурсы Цикл
				Ресурсы.Добавить(ТекРесурс.Имя);
			КонецЦикла; 
			Для каждого ТекРеквизит Из ТекДвижение.Реквизиты Цикл
				Ресурсы.Добавить(ТекРеквизит.Имя);
			КонецЦикла;
			
			Если ТекДвижение.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				// для непериодических регистров будем копировать запись сторнируемого документа заменяя ресурсы и реквизиты на NULL
				
				Если Не ПустаяСтрока(ТекстЗапроса) Тогда
					ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
				КонецЕсли;
				
				ТекстЗапроса = ТекстЗапроса + "
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|&Регистратор Как Регистратор";
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	Т." + ИмяИзмерения;
				КонецЦикла;
				Для Каждого ИмяРесурса Из Ресурсы Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	NULL КАК " + ИмяРесурса;
				КонецЦикла;
				ТекстЗапроса = ТекстЗапроса + "
				|ИЗ
				|	РегистрСведений." + СоставИмени[1] + " КАК Т
				|ГДЕ
				|	Т.Регистратор = &ДокументОснование";
				
				КоличествоТаблицДвижения = КоличествоТаблицДвижения + 1;
				СоответствиеТаблиц.Вставить(СоставИмени[1], КоличествоТаблицДвижения);
				
			Иначе
				// в периодические регистры пишем состояние до момента проведения сторнируемого документа
				
				Если Не ПустаяСтрока(ТекстЗапроса) Тогда
					ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
				КонецЕсли;
				
				// временная таблица будет содержать все сочетания измерений регистра из движений сторнируемого документа
				ТекстЗапроса = ТекстЗапроса + "
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|&Регистратор Как Регистратор"; // поле "Регистратор" добавляется во все таблицы и впоследствии используется как первое поле соединения
				Первый = Истина;
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	Т." + ИмяИзмерения;
				КонецЦикла;
				ТекстЗапроса = ТекстЗапроса + "
				|ПОМЕСТИТЬ " + ИмяВТ + "
				|ИЗ
				|	РегистрСведений." + СоставИмени[1] + " КАК Т
				|ГДЕ
				|	Т.Регистратор = &ДокументОснование";
				
				ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
				
				// временная таблица будет содержать срезы последних по всем измерениям регистра
				ТекстЗапроса = ТекстЗапроса + "
				|ВЫБРАТЬ
				|&Регистратор Как Регистратор";
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	Т." + ИмяИзмерения;
				КонецЦикла;
				Для Каждого ИмяРесурса Из Ресурсы Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	Т." + ИмяРесурса;
				КонецЦикла;
				ТекстЗапроса = ТекстЗапроса + " 
				|ПОМЕСТИТЬ " + ИмяВТСрез + "
				|ИЗ
				|	РегистрСведений." + СоставИмени[1] + ".СрезПоследних(
				|			&Период,";
				Первый = Истина;
				// условие виртуальной таблицы накладывается списками значений измерений без учета их сочетаний
				// сочетания будут использованы вдальнейшем соединением таблиц
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + "
					|			" + ?(Первый, "", "И ") + ИмяИзмерения + " В
					|					(ВЫБРАТЬ
					|						ВТ." + ИмяИзмерения + "
					|					ИЗ
					|						" + ИмяВТ + " КАК ВТ)";
					Первый = Ложь;
				КонецЦикла;
				ТекстЗапроса = ТекстЗапроса + ") КАК Т";
				
				ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
				
				// соединяется временная таблица различных сочетаний измерений с временной таблицей срезов последних
				// результат запроса пишется в движения документа "Сторно"
				ТекстЗапроса = ТекстЗапроса + "
				|ВЫБРАТЬ
				|&ПериодДокумента Как Период,
				|ВТ.Регистратор";
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	ВТ." + ИмяИзмерения;
				КонецЦикла;
				Для Каждого ИмяРесурса Из Ресурсы Цикл
					ТекстЗапроса = ТекстЗапроса + ",
					|	ВТСрез." + ИмяРесурса;
				КонецЦикла;
				ТекстЗапроса = ТекстЗапроса + "
				|	ИЗ " + ИмяВТ + " КАК ВТ
				|		Левое СОЕДИНЕНИЕ " + ИмяВТСрез + " КАК ВТСрез
				// соединение начинаем с поля "Регистратор", т.к. оно гарантированно есть в обоих временных таблицах
				|		ПО ВТ.Регистратор = ВТСрез.Регистратор";
				Для Каждого ИмяИзмерения Из Измерения Цикл
					ТекстЗапроса = ТекстЗапроса + "
					|		И ВТ." + ИмяИзмерения + " = ВТСрез." + ИмяИзмерения;
				КонецЦикла;
				
				КоличествоТаблицДвижения = КоличествоТаблицДвижения + 3; // 2 временные таблицы и таблица соедниения
				СоответствиеТаблиц.Вставить(СоставИмени[1], КоличествоТаблицДвижения);
				
				ИндексВт = ИндексВт + 1;
			КонецЕсли;
			
		ИначеЕсли СоставИмени[0] = "РегистрНакопления" Тогда
			// по регистрам накопления копируем все движения сторнируемого документа и умножаем все ресурсы на "-1"
			
			ЕстьДвиженияПоРегистрам  = Истина;
			
			Если Не ПустаяСтрока(ТекстЗапроса) Тогда
				ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
			КонецЕсли;
			
			// измерения и реквизиты заносим в один массив: они копируются "один в один"
			Измерения = Новый Массив;
			Для каждого ТекИзмерение Из ТекДвижение.Измерения Цикл
				Измерения.Добавить(ТекИзмерение.Имя);
			КонецЦикла;
			Для каждого ТекРеквизит Из ТекДвижение.Реквизиты Цикл
				Измерения.Добавить(ТекРеквизит.Имя);
			КонецЦикла;
			// ресурсы заносим в отдельный массив: они будут умножаться на "-1"
			Ресурсы = Новый Массив;
			Для каждого ТекРесурс Из ТекДвижение.Ресурсы Цикл
				Ресурсы.Добавить(ТекРесурс.Имя);
			КонецЦикла;
			
			ТекстЗапроса = ТекстЗапроса + "
			|ВЫБРАТЬ
			|	&ПериодДокумента Как Период,
			|	&Регистратор Как Регистратор";
			
			Если ТекДвижение.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|	Т.ВидДвижения";
			КонецЕсли;
			
			Для Каждого ИмяИзмерения Из Измерения Цикл
				ТекстЗапроса = ТекстЗапроса + ",
				|	Т." + ИмяИзмерения;
			КонецЦикла;
			
			Для Каждого ИмяРесурса Из Ресурсы Цикл
				ТекстЗапроса = ТекстЗапроса + ",
				|	ВЫБОР
				|		КОГДА Т." + ИмяРесурса + " ЕСТЬ NULL
				|			ТОГДА NULL
				|		ИНАЧЕ - Т." + ИмяРесурса + "
				|	КОНЕЦ КАК " + ИмяРесурса;
			КонецЦикла;
			ТекстЗапроса = ТекстЗапроса + "
			|ИЗ
			|	РегистрНакопления." + СоставИмени[1] + " КАК Т
			|ГДЕ
			|	Т.Регистратор = &ДокументОснование";
			
			КоличествоТаблицДвижения = КоличествоТаблицДвижения + 1;
			СоответствиеТаблиц.Вставить(СоставИмени[1], КоличествоТаблицДвижения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьДвиженияПоРегистрам Тогда
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Период"				, Новый Граница(ДанныеДокумента.ДокументОснование.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("ПериодДокумента"		, ДанныеДокумента.Дата);
		Запрос.УстановитьПараметр("ДокументОснование"	, ДанныеДокумента.ДокументОснование);
		Запрос.УстановитьПараметр("Регистратор"			, ДокументСсылка);
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		Для Каждого ТекСоответствиеТаблиц Из СоответствиеТаблиц Цикл
			
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ТекСоответствиеТаблиц.Ключ, РезультатЗапроса[ТекСоответствиеТаблиц.Значение].Выгрузить());
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.ИсправлениеОшибки)
		И ДанныеДокумента.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка Тогда
		// Это исправление ошибок прошлых лет.
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ОплатаОтПокупателейДебиторов");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ОплатаПоставщикамКредиторам");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ИсполнениеДоговоровСПокупателями");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ИсполнениеОбязательствПоставщиками");
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументДвигаетРегистры(СторнируемыйДокумент) Экспорт
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СторнируемыйДокумент));
	
	Для Каждого Движение Из МетаданныеДокумента.Движения Цикл
		
		Если ОбщегоНазначения.ЭтоРегистрНакопления(Движение) Тогда
			ИмяТаблицы = "РегистрНакопления";
		ИначеЕсли ОбщегоНазначения.ЭтоРегистрСведений(Движение) Тогда
			ИмяТаблицы = "РегистрСведений";
		Иначе
			Продолжить;
		КонецЕсли;
		
		Шаблон =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегистрЗапроса.Активность КАК Активность
		|ИЗ
		|	&Таблица КАК РегистрЗапроса
		|ГДЕ
		|	РегистрЗапроса.Регистратор = &Регистратор";
		
		ТекстЗапроса = СтрЗаменить(Шаблон, "&Таблица", ИмяТаблицы + "." + Движение.Имя);
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Регистратор", СторнируемыйДокумент);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	//
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоДокументПоДенежнымСредствам(ДокументСсылка) Экспорт
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		СписокДокументов = ДокументыПоДенежнымСредствам();
		Результат = (СписокДокументов.Найти(ДокументСсылка.Метаданные()) <> Неопределено);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыПоДенежнымСредствам()
	
	СписокДокументов = Новый Массив;
	
	// Получаем список подситем, объекты которых подлежать свертке	
	КорневыеПодсистемы = Новый Массив;
	УчетГУ = Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы.ДенежныеСредства;
	КорневыеПодсистемы.Добавить(УчетГУ);
	
	МассивПодсистем = Новый Массив;
	Для Каждого КорневаяПодсистема Из КорневыеПодсистемы Цикл	
		ДобавитьПодсистемуСПодчиненными(МассивПодсистем, КорневаяПодсистема);
	КонецЦикла;
	
	ОснованияСторно = Метаданные.Документы.Сторно.ВводитсяНаОсновании;
	Для Каждого ТекПодсистема Из МассивПодсистем Цикл
		Для Каждого ТекОбъект Из ТекПодсистема.Состав Цикл
			Если ОбщегоНазначения.ЭтоДокумент(ТекОбъект) Тогда
				Если ОснованияСторно.Содержит(ТекОбъект) Тогда
					СписокДокументов.Добавить(ТекОбъект);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
