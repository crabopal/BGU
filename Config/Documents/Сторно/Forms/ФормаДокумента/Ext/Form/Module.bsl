&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	ПроверитьПравильностьКФО_КПС();
	УстановитьВидимостьИФОДокумента();
КонецПроцедуры

&НаСервере
Процедура ПроверитьПравильностьКФО_КПС()
	
	МассивИспользуемыхКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Объект.Организация, Объект.НовыйИФО, Объект.Дата);
	МассивИспользуемыхКПС = Новый Массив;
	
	Для Каждого ТекКФО Из МассивИспользуемыхКФО Цикл
		
		МассивИспользуемыхКПС.Добавить(БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(
			Объект.Организация, Объект.НовыйИФО, ТекКФО, Объект.Дата));
		
	КонецЦикла;
	
	Для Каждого ТекПроводка Из Объект.НовыеПроводки Цикл
		
		СтрКФО = МассивИспользуемыхКФО.Найти(ТекПроводка.КФО);
		Если СтрКФО = Неопределено Тогда
			ТекПроводка.КФО = Перечисления.КВД.ПустаяСсылка();
		Иначе
			Если ЗначениеЗаполнено(ТекПроводка.КПСДт) И
				МассивИспользуемыхКПС[СтрКФО].Найти(ТекПроводка.КПСДт.ВидПоказателя) = Неопределено Тогда
				ТекПроводка.КПСДт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекПроводка.КПСКт) И
				МассивИспользуемыхКПС[СтрКФО].Найти(ТекПроводка.КПСКт.ВидПоказателя) = Неопределено Тогда
				ТекПроводка.КПСКт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоле(Поле, Очищать)
	
	Если Очищать Тогда
		Если ЗначениеЗаполнено(Поле) Тогда
			Поле = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляСубконто(ТекущиеДанные, КоличествоСубконто, ДтКт = "Дт")
	
	Если КоличествоСубконто < 3 Тогда
		ТекущиеДанные["Субконто"+ДтКт+"3"] = Неопределено;
		Если КоличествоСубконто < 2 Тогда
			ТекущиеДанные["Субконто"+ДтКт+"2"] = Неопределено;
			Если КоличествоСубконто < 1 Тогда
				ТекущиеДанные["Субконто"+ДтКт+"1"] = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДинамическиеКолонки()
	
	Для Каждого ТекущиеДанные Из Объект.НовыеПроводки Цикл
		
		ДанныеСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетДт);
		ТекущиеДанные.КоличествоСубконтоДт		= ДанныеСчета.КоличествоСубконто;
		ТекущиеДанные.ВалютныйДт				= ДанныеСчета.Валютный;
		ТекущиеДанные.КоличественныйДт			= ДанныеСчета.Количественный;
		ТекущиеДанные.УчетПоПодразделениямДт	= ДанныеСчета.УчетПоПодразделениям;
		ТекущиеДанные.УчетПоКПСДт				= ДанныеСчета.УчетПоКПС;
		ТекущиеДанные.УчетПоКЭКДт				= ДанныеСчета.УчетПоКЭК;
		
		ДанныеСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетКт);
		ТекущиеДанные.КоличествоСубконтоКт		= ДанныеСчета.КоличествоСубконто;
		ТекущиеДанные.ВалютныйКт				= ДанныеСчета.Валютный;
		ТекущиеДанные.КоличественныйКт			= ДанныеСчета.Количественный;
		ТекущиеДанные.УчетПоПодразделениямКт	= ДанныеСчета.УчетПоПодразделениям;
		ТекущиеДанные.УчетПоКПСКт				= ДанныеСчета.УчетПоКПС;
		ТекущиеДанные.УчетПоКЭККт				= ДанныеСчета.УчетПоКЭК;
		
	КонецЦикла;
	
	Для Каждого ТекущиеДанные Из Объект.СтарыеПроводки Цикл
		
		ДанныеСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетДт);
		ТекущиеДанные.ВалютныйДт				= ДанныеСчета.Валютный;
		ТекущиеДанные.КоличественныйДт			= ДанныеСчета.Количественный;
		
		ДанныеСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетКт);
		ТекущиеДанные.ВалютныйКт				= ДанныеСчета.Валютный;
		ТекущиеДанные.КоличественныйКт			= ДанныеСчета.Количественный; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьРедактирования()
	
	РедактированиеПроводокРазрешено = ЗначениеЗаполнено(Объект.ДокументОснование)
		И Не Документы.Сторно.ДокументДвигаетРегистры(Объект.ДокументОснование);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСтраницуИнформацииОДокументе(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	НевидимыеЭлементы = Новый Массив;
	НевидимыеЭлементы.Добавить("Декорация7");
	НевидимыеЭлементы.Добавить("Декорация8");
	НевидимыеЭлементы.Добавить("Декорация1");
	НевидимыеЭлементы.Добавить("Декорация2");
	НевидимыеЭлементы.Добавить("Декорация5");
	НевидимыеЭлементы.Добавить("Декорация3");
	НевидимыеЭлементы.Добавить("Декорация6");
	НевидимыеЭлементы.Добавить("Декорация4");
	НевидимыеЭлементы.Добавить("КнопкаЗаполнитьДокумент");
	
	ВидимыеЭлементы = Новый Массив;
	
	Доступность = Истина;
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ВидимыеЭлементы.Добавить("Декорация7");
		ВидимыеЭлементы.Добавить("Декорация8");
	ИначеЕсли Форма.РедактированиеПроводокРазрешено Тогда
		ВидимыеЭлементы.Добавить("Декорация1");
		ВидимыеЭлементы.Добавить("Декорация2");
	ИначеЕсли Объект.ТребуетсяПерезаполнитьПроводки ИЛИ Объект.НовыеПроводки.Количество() > 0 Тогда
		ВидимыеЭлементы.Добавить("Декорация6");
		ВидимыеЭлементы.Добавить("Декорация4");
		ВидимыеЭлементы.Добавить("КнопкаЗаполнитьДокумент");
	Иначе
		ВидимыеЭлементы.Добавить("Декорация5");
		ВидимыеЭлементы.Добавить("Декорация3");
		Доступность = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаИсправлениеОшибокПрошлыхЛет.Видимость = ЗначениеЗаполнено(Объект.ДокументОснование)
		И Не ЭтоДокументПоДенежнымСредствам(Объект.ДокументОснование);
	Элементы.ПереключательИсправлениеОшибокПрошлыхЛет.Видимость	= Форма.ФлажокИсправлениеОшибокПрошлыхЛет;
	Элементы.ПереключательВыявительОшибкиПрошлыхЛет.Видимость	= Форма.ФлажокИсправлениеОшибокПрошлыхЛет И Объект.Дата >= '20210101';
	Элементы.ПереключательПричинаОшибки.Видимость				= Форма.ФлажокИсправлениеОшибокПрошлыхЛет И Объект.Дата >= '20230101'
		И Форма.ПереключательВыявительОшибкиПрошлыхЛет = ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.Самостоятельно");
	Элементы.ГруппаПодсказка.Видимость = Ложь;
	
	Для Каждого Элемент Из ВидимыеЭлементы Цикл
	
		НевидимыеЭлементы.Удалить(НевидимыеЭлементы.Найти(Элемент));
	
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, НевидимыеЭлементы,
		"Видимость", Ложь);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ВидимыеЭлементы,
		"Видимость", Истина);
	
	ЭлементыТолькоПросмотр = Новый Массив;
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиВалютнаяСуммаДт");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиКоличествоДт");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиВалютнаяСуммаКт");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиКоличествоКт");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиСумма");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиСуммаНеУчитываетсяНУ");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиСуммаЕНВД");
	ЭлементыТолькоПросмотр.Добавить("СтарыеПроводкиСуммаНДС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыТолькоПросмотр,
		"ТолькоПросмотр", НЕ Доступность);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НовыеПроводки",
		"Доступность", Доступность);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаНовыеПроводки",
		"Доступность", Доступность);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоДокументПоДенежнымСредствам(ДокументСсылка)
	
	Возврат Документы.Сторно.ЭтоДокументПоДенежнымСредствам(ДокументСсылка);	
	
КонецФункции

&НаСервере
Процедура ОграничитьСписокТиповДокументаОснования()
	
	МассивТипов = Новый Массив;
	
	Для Каждого ДокументОснование Из Метаданные.Документы.Сторно.ВводитсяНаОсновании Цикл
		
		МассивТипов.Добавить(Тип("ДокументСсылка." + ДокументОснование.Имя));
		
	КонецЦикла;
	
	Элементы.ДокументОснование.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.НовыеПроводки.ТекущиеДанные;
	
	ДлинаТекста = СтрДлина(Элемент.Имя);
	СторонаПроводки = Сред(Элемент.Имя, ДлинаТекста - 2, 2);
	НомерСубконто = Прав(Элемент.Имя, 1);
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("НомерСубконто"	, Число(НомерСубконто));
	ПараметрыДляВыбора.Вставить("Организация"	, Объект.Организация);
	ПараметрыДляВыбора.Вставить("ИФО"			, ТекущиеДанные.ИФО);
	ПараметрыДляВыбора.Вставить("КФО"			, ТекущиеДанные.КФО);
	ПараметрыДляВыбора.Вставить("Счет"			, ТекущиеДанные["Счет" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КПС"			, ТекущиеДанные["КПС" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КЭК"			, ТекущиеДанные["КЭК" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("Субконто1"		, ТекущиеДанные["Субконто" + СторонаПроводки + "1"]);
	ПараметрыДляВыбора.Вставить("Субконто2"		, ТекущиеДанные["Субконто" + СторонаПроводки + "2"]);
	ПараметрыДляВыбора.Вставить("Субконто3"		, ТекущиеДанные["Субконто" + СторонаПроводки + "3"]);
	
	БухгалтерскийУчетКлиент.ОкончаниеВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, ПараметрыДляВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПодскази(Видимость)
	
	Если Видимость Тогда
		Элементы.ГруппаПодсказка.Видимость = (Объект.НовыеПроводки.Количество() > 0);
	Иначе
		Элементы.ГруппаПодсказка.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьГлБухгалтера(Организация, Дата)

	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат ОрганизационнаяСтруктураВызовСервераПовтИсп.ОтветственноеЛицоОрганизации(Организация,
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"),
			Дата).ОтветственноеЛицоСсылка;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	КонецЕсли;

КонецФункции

