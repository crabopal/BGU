	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетКт);
	ТекущиеДанные.КоличествоСубконтоКт		= ДанныеСчета.КоличествоСубконто;
	ТекущиеДанные.ВалютныйКт				= ДанныеСчета.Валютный;
	ТекущиеДанные.КоличественныйКт			= ДанныеСчета.Количественный;
	ТекущиеДанные.УчетПоПодразделениямКт	= ДанныеСчета.УчетПоПодразделениям;
	ТекущиеДанные.УчетПоКПСКт				= ДанныеСчета.УчетПоКПС;
	ТекущиеДанные.УчетПоКЭККт				= ДанныеСчета.УчетПоКЭК;
	
	ОчиститьПоле(ТекущиеДанные.ВалютаКт			, Не ДанныеСчета.Валютный);
	ОчиститьПоле(ТекущиеДанные.ВалютнаяСуммаКт	, Не ДанныеСчета.Валютный);
	ОчиститьПоле(ТекущиеДанные.КоличествоКт		, Не ДанныеСчета.Количественный);
	ОчиститьПоле(ТекущиеДанные.КПСКт			, Не ДанныеСчета.УчетПоКПС);
	ОчиститьПоле(ТекущиеДанные.КЭККт			, Не ДанныеСчета.УчетПоКЭК);
	ОчиститьПоле(ТекущиеДанные.ПодразделениеКт	, Не ДанныеСчета.УчетПоПодразделениям);
	
	ОчиститьПоляСубконто(ТекущиеДанные, ДанныеСчета.КоличествоСубконто, "Кт");
	
	ТекущиеДанные.ЖурналОпераций = БухгалтерскиеОперацииВызовСервера.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
	
