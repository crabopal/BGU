
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОграничитьСписокТиповДокументаОснования();
	
	УстановитьВидимостьИФОДокумента();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.ГлБухгалтер = ПолучитьГлБухгалтера(Объект.Организация, Объект.Дата);
	
		ЗаполнитьДинамическиеКолонки();
		УстановитьДоступностьРедактирования();
		УстановитьСтраницуИнформацииОДокументе(ЭтаФорма, Объект);
		
		ПереключательИсправлениеОшибокПрошлыхЛет	= Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода;
		ПереключательВыявительОшибкиПрошлыхЛет		= Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно;
		ПереключательПричинаОшибки					= Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
		
	КонецЕсли;
	
	Элементы.ГруппаИсправлениеОшибокПрошлыхЛетРасширеннаяПодсказка.Заголовок = ОбщегоНазначенияБГУ.ПодсказкаГруппыИсправлениеОшибок();
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьОрганизации();
	
	УстановитьДоступностьДокументаОснования();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ФлажокИсправлениеОшибокПрошлыхЛет = ЗначениеЗаполнено(ТекущийОбъект.ИсправлениеОшибки)
		И ТекущийОбъект.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка;
	Если ФлажокИсправлениеОшибокПрошлыхЛет Тогда
		ПереключательИсправлениеОшибокПрошлыхЛет	= ТекущийОбъект.ИсправлениеОшибки;
		ПереключательВыявительОшибкиПрошлыхЛет		= ТекущийОбъект.ВыявительОшибки;
		ПереключательПричинаОшибки					= ТекущийОбъект.ПричинаОшибки;
	Иначе
		ПереключательИсправлениеОшибокПрошлыхЛет	= Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода;
		ПереключательВыявительОшибкиПрошлыхЛет		= Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно;
		ПереключательПричинаОшибки					= Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли;
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ЗаполнитьДинамическиеКолонки();
	
	УстановитьДоступностьРедактирования();
	
	УстановитьСтраницуИнформацииОДокументе(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОповеститьОбИзменении(Объект.ДокументОснование);
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьДинамическиеКолонки();
	УстановитьДоступностьРедактирования();
	УстановитьСтраницуИнформацииОДокументе(ЭтаФорма, Объект);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ФлажокИсправлениеОшибокПрошлыхЛет Тогда
		ТекущийОбъект.ИсправлениеОшибки	= ПереключательИсправлениеОшибокПрошлыхЛет;
		ТекущийОбъект.ВыявительОшибки	= ПереключательВыявительОшибкиПрошлыхЛет;
		ТекущийОбъект.ПричинаОшибки		= ПереключательПричинаОшибки;
	Иначе
		ТекущийОбъект.ИсправлениеОшибки	= Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка;
		ТекущийОбъект.ВыявительОшибки	= Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
		ТекущийОбъект.ПричинаОшибки		= Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И ВыбранноеЗначение <> Объект.ДокументОснование
		И (Объект.СтарыеПроводки.Количество() > 0 Или Объект.НовыеПроводки.Количество() > 0) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекстВопроса = НСтр("ru = 'При изменении документа-основания будут перезаполнены проводки.
                             |Изменить документ-основание?'");
		
		ДопПараметры = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ДокументОснованиеОбработкаВыбораЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеОбработкаВыбораЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВыбранноеЗначение = ДополнительныеПараметры.ВыбранноеЗначение;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.ДокументОснование = ВыбранноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Если ФлажокИсправлениеОшибокПрошлыхЛет Тогда
			ПорядокИсправлениОшибок	= ПереключательИсправлениеОшибокПрошлыхЛет;
			ВыявительОшибки			= ПереключательВыявительОшибкиПрошлыхЛет;
			ПричинаОшибки			= ПереключательПричинаОшибки;
		Иначе
			ПорядокИсправлениОшибок	= Неопределено;
			ВыявительОшибки			= Неопределено;
			ПричинаОшибки			= Неопределено;
		КонецЕсли;
		
		ЗаполнитьПоДокументуОснованию(Истина, Истина, ПорядокИсправлениОшибок, ВыявительОшибки, ПричинаОшибки);
		
	Иначе
		
		ОчиститьПроводки();
		Объект.СтарыйИФО = ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
		РедактированиеПроводокРазрешено = Ложь;
		
	КонецЕсли;
	
	УстановитьДоступностьОрганизации();
	УстановитьСтраницуИнформацииОДокументе(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		СтандартнаяОбработка = Ложь;
		ТекстПредупреждения = НСтр("ru='Перед изменением организации необходимо очистить сторнируемый документ.'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьДоступностьДокументаОснования();
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ПроверитьПравильностьКФО_КПС();
	
	Элементы.ПереключательПричинаОшибки.Видимость = ФлажокИсправлениеОшибокПрошлыхЛет И Объект.Дата >= '20230101'
		И ПереключательВыявительОшибкиПрошлыхЛет = ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.Самостоятельно");
	Если Объект.Дата < '20230101' Тогда
		ПереключательПричинаОшибки = ПредопределенноеЗначение("Справочник.ПричиныОшибокПрошлыхЛет.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокИсправлениеОшибокПрошлыхЛетПриИзменении(Элемент)
	
	ПроверитьЗаполнитьТаблицы(Объект.СтарыеПроводки.Количество(),, Истина, Ложь, Ложь);
	
	УстановитьВидимостьПодскази(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательИсправлениеОшибокПрошлыхЛетПриИзменении(Элемент)
	
	ПроверитьЗаполнитьТаблицы(Объект.СтарыеПроводки.Количество(),, Истина, Ложь, Ложь);
	
	УстановитьВидимостьПодскази(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательВыявительОшибкиПрошлыхЛетПриИзменении(Элемент)
	
	ПроверитьЗаполнитьТаблицы(Объект.СтарыеПроводки.Количество(),, Истина, Ложь, Ложь);
	
	УстановитьВидимостьПодскази(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательПричинаОшибкиПриИзменении(Элемент)
	
	ПроверитьЗаполнитьТаблицы(Объект.СтарыеПроводки.Количество(),, Истина, Ложь, Ложь);
	
	УстановитьВидимостьПодскази(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрытьПодсказку(Команда)
	
	УстановитьВидимостьПодскази(Ложь);
	
