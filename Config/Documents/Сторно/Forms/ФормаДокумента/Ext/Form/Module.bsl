// Процедура заполняет табличные части. В табличную часть СтарыеПроводки пишутся проводки со знаком минус. 
// В табличную часть НовыеПроводки пишутся проводки документа основания как есть.
//
// Параметры
//  СтарыеПроводки  - Булево - признак перезполнения тч СтарыеПроводки
//  НовыеПроводки   - Булево - признак перезполнения тч НовыеПроводки
//
&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(Знач СтарыеПроводки = Истина, Знач НовыеПроводки = Истина,
	ПорядокИсправлениОшибок = Неопределено, ВыявительОшибки = Неопределено, ПричинаОшибки = Неопределено)
	
	Если Объект.ДокументОснование.Метаданные().Реквизиты.Найти("ИФО") <> Неопределено Тогда
		Объект.СтарыйИФО = Объект.ДокументОснование.ИФО;
	Иначе
		Объект.СтарыйИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	
	Если НовыеПроводки = Истина Тогда
		Если Документы.Сторно.ДокументДвигаетРегистры(Объект.ДокументОснование) Тогда
			Объект.НовыеПроводки.Очистить();
			НовыеПроводки = Ложь;
		КонецЕсли;
		
		Объект.НовыйИФО = Объект.СтарыйИФО;
		
	КонецЕсли;
	
	Если СтарыеПроводки = Истина Тогда
		
		Объект.ТребуетсяПерезаполнитьПроводки = Ложь;
		
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоДокументуОснованию(СтарыеПроводки, НовыеПроводки, ПорядокИсправлениОшибок, ВыявительОшибки, ПричинаОшибки);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ЗаполнитьДинамическиеКолонки();
	УстановитьВидимостьИФОДокумента();
	УстановитьДоступностьРедактирования();
	УстановитьСтраницуИнформацииОДокументе(ЭтаФорма, Объект);
	
	Если СтарыеПроводки = Истина Тогда
		
		Объект.ТребуетсяПерезаполнитьПроводки = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПроводки()
	
	Если Объект.СтарыеПроводки.Количество() > 0 Тогда
		
		Объект.СтарыеПроводки.Очистить();
		
	КонецЕсли;
	
	Если Объект.НовыеПроводки.Количество() > 0 Тогда
		
		Объект.НовыеПроводки.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИФОДокумента()
	
	ГруппаИФОВидимость = Ложь;
	СтарыеПроводкиИФОВидимость = Ложь;
	НовыеПроводкиИФОВидимость = Ложь;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		МетаданныеОснования = Объект.ДокументОснование.Метаданные();
		ЕстьИФОВШапке = ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеОснования);
		ИмпортированИзЗГУ = ОбщегоНазначения.ЕстьРеквизитОбъекта("ИмпортированИзЗГУ", МетаданныеОснования);
		ЕстьИФОВТч = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ИФО", МетаданныеОснования);
		 
		ГруппаИФОВидимость = ЕстьИФОВШапке И Не ИмпортированИзЗГУ;
		СтарыеПроводкиИФОВидимость = ЕстьИФОВТч;
		НовыеПроводкиИФОВидимость = ЕстьИФОВТч И (Не ГруппаИФОВидимость Или Не ЗначениеЗаполнено(Объект.НовыйИФО));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаИФО",
		"Видимость", ГруппаИФОВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтарыеПроводкиИФО",
		"Видимость", СтарыеПроводкиИФОВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НовыеПроводкиИФО",
		"Видимость", НовыеПроводкиИФОВидимость);
	
КонецПроцедуры

// Проверяет возможность перезаполнения табличных частей. Если ТЧ не пустые, то задается вопрос об их очистке.
// Возвращает Истина если ТЧ пустые или пользователь дал согласие на очистку и перезаполнение ТЧ.
//
// Параметры
//  СтрокСтарых  - Число - количество строк ТЧ СтарыеПроводки
//  СтрокНовых   - Число - количество строк ТЧ НовыеПроводки
//
// Возвращаемое значение:
//   Булево   
//
&НаКлиенте
Процедура ПроверитьЗаполнитьТаблицы(СтрокСтарых=0, СтрокНовых=0, СтарыеПроводки, НовыеПроводки, ЗадаватьВопрос = Истина)
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекстСообщения = НСтр("ru='Не выбран сторнируемый документ'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.ДокументОснование");
		Возврат;
	КонецЕсли;
	
	Если ФлажокИсправлениеОшибокПрошлыхЛет Тогда
		ПорядокИсправлениОшибок	= ПереключательИсправлениеОшибокПрошлыхЛет;
		ВыявительОшибки			= ПереключательВыявительОшибкиПрошлыхЛет;
		ПричинаОшибки			= ПереключательПричинаОшибки;
	Иначе
		ПорядокИсправлениОшибок	= Неопределено;
		ВыявительОшибки			= Неопределено;
		ПричинаОшибки			= Неопределено;
	КонецЕсли;
	
	Элементы.ПереключательИсправлениеОшибокПрошлыхЛет.Видимость	= ФлажокИсправлениеОшибокПрошлыхЛет;
	Элементы.ПереключательВыявительОшибкиПрошлыхЛет.Видимость	= ФлажокИсправлениеОшибокПрошлыхЛет И Объект.Дата >= '20210101';
	Элементы.ПереключательПричинаОшибки.Видимость				= ФлажокИсправлениеОшибокПрошлыхЛет И Объект.Дата >= '20230101'
		И ПереключательВыявительОшибкиПрошлыхЛет = ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.Самостоятельно");
	
	Если СтрокСтарых = 0 И СтрокНовых = 0 Или Не ЗадаватьВопрос Тогда
		ЗаполнитьПоДокументуОснованию(СтарыеПроводки, НовыеПроводки, ПорядокИсправлениОшибок, ВыявительОшибки, ПричинаОшибки);
		Возврат;
	КонецЕсли;
	
	Шаблон = НСтр("ru='Будут перезаполны %1 проводки.%2'");
	Вставка1 = "";
	Вставка2 = "";
	
	Если СтрокСтарых > 0 И СтрокНовых > 0 Тогда
		Вставка1 = НСтр("ru='сторнируемые и исправительные'");
	ИначеЕсли СтрокСтарых > 0 Тогда
		Вставка1 = НСтр("ru='сторнируемые'");
	ИначеЕсли СтрокНовых > 0 Тогда
		Вставка1 = НСтр("ru='исправительные'");
	КонецЕсли;
	Если СтрокНовых > 0 Тогда
		Вставка2 = " " + НСтр("ru='Все ручные изменения в исправительных проводках будут утеряны.'");
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(Шаблон, Вставка1, Вставка2) + Символы.ПС + НСтр("ru='Перезаполнить проводки?'");
	
	ДопПараметры = Новый Структура("НовыеПроводки,СтарыеПроводки,ПорядокИсправлениОшибок,ВыявительОшибки,ПричинаОшибки",
		НовыеПроводки, СтарыеПроводки, ПорядокИсправлениОшибок, ВыявительОшибки, ПричинаОшибки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьЗаполнитьТаблицыЗавершение", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнитьТаблицыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	НовыеПроводки			= ДополнительныеПараметры.НовыеПроводки;
	СтарыеПроводки			= ДополнительныеПараметры.СтарыеПроводки;
	ПорядокИсправлениОшибок	= ДополнительныеПараметры.ПорядокИсправлениОшибок;
	ВыявительОшибки			= ДополнительныеПараметры.ВыявительОшибки;
	ПричинаОшибки			= ДополнительныеПараметры.ПричинаОшибки;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДокументуОснованию(СтарыеПроводки, НовыеПроводки, ПорядокИсправлениОшибок, ВыявительОшибки, ПричинаОшибки);
	КонецЕсли;
	
	УстановитьВидимостьПодскази(Ложь);
	
КонецПроцедуры

