/// ДЕБЕТ //////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура НовыеПроводкиСчетДтПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НовыеПроводки.ТекущиеДанные;
	
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетДт);
	ТекущиеДанные.КоличествоСубконтоДт		= ДанныеСчета.КоличествоСубконто;
	ТекущиеДанные.ВалютныйДт				= ДанныеСчета.Валютный;
	ТекущиеДанные.КоличественныйДт			= ДанныеСчета.Количественный;
	ТекущиеДанные.УчетПоПодразделениямДт	= ДанныеСчета.УчетПоПодразделениям;
	ТекущиеДанные.УчетПоКПСДт				= ДанныеСчета.УчетПоКПС;
	ТекущиеДанные.УчетПоКЭКДт				= ДанныеСчета.УчетПоКЭК;
	
	ОчиститьПоле(ТекущиеДанные.ВалютаДт			, Не ДанныеСчета.Валютный);
	ОчиститьПоле(ТекущиеДанные.ВалютнаяСуммаДт	, Не ДанныеСчета.Валютный);
	ОчиститьПоле(ТекущиеДанные.КоличествоДт		, Не ДанныеСчета.Количественный);
	ОчиститьПоле(ТекущиеДанные.КПСДт			, Не ДанныеСчета.УчетПоКПС);
	ОчиститьПоле(ТекущиеДанные.КЭКДт			, Не ДанныеСчета.УчетПоКЭК);
	ОчиститьПоле(ТекущиеДанные.ПодразделениеДт	, Не ДанныеСчета.УчетПоПодразделениям);
	
	ОчиститьПоляСубконто(ТекущиеДанные, ДанныеСчета.КоличествоСубконто, "Дт");
	
	ТекущиеДанные.ЖурналОпераций = БухгалтерскиеОперацииВызовСервера.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
	
	// Уточняем КОСГУ по контрагентами или МЗ
	БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элементы.НовыеПроводкиСубконтоДт1,,, Истина);
	
КонецПроцедуры

