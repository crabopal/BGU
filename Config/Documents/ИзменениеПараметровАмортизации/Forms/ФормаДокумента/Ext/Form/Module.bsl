&НаКлиенте
Процедура УстановитьВыбранныйКПСВСтроки(Результат, ДополнительныеРеквизиты) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		УстановитьСчетИКПСЗатратНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Объект.Организация, Объект.Дата);
	
	ЭтаФорма.Элементы.ДекорацияОтражатьВ.Видимость = ПлательщикНалогаНаПрибыль;
	
	Элементы.ГруппаПараметрыАмортизацииНУЛевая.Видимость	= ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаПараметрыАмортизацииНУПравая.Видимость	= ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаНачислениеАмортизацииНУЛевая.Видимость	= ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаНачислениеАмортизацииНУПРавая.Видимость	= ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаРасчетАмортизацииНУЛевая.Видимость		= ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаРасчетАмортизацииНУПравая.Видимость		= ПлательщикНалогаНаПрибыль;
	
	Элементы.ОсновныеСредстваГруппаНачислятьАмортизациюНУ.Видимость			= ПлательщикНалогаНаПрибыль;
	Элементы.ОсновныеСредстваГруппаСрокПолезногоИспользованияНУ.Видимость	= ПлательщикНалогаНаПрибыль;
	Элементы.ОсновныеСредстваГруппаСпециальныйКоэффициентНУ.Видимость		= ПлательщикНалогаНаПрибыль;
	Элементы.ОсновныеСредстваГруппаСтатьяПрочихРасходовНУ.Видимость			= ПлательщикНалогаНаПрибыль;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		Если Объект.ОсновныеСредства.Количество() = 0 Тогда
			Объект.ОсновныеСредства.Добавить();
		КонецЕсли;
		ПерваяСтрока = Объект.ОсновныеСредства[0];
		ПорядокВключенияСтоимостиОСВСоставРасходовНУ =
			БухгалтерскиеОперацииПовтИсп.ПолучитьПараметрыАмортизацииОС(ПерваяСтрока.ОсновноеСредство, Объект.Дата).ПорядокВключенияСтоимостиВСоставРасходовНУ;
		ВыбранСчетПрочихРасходов = НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ПерваяСтрока.СчетУчетаЗатрат);
		УстановитьЗаголовкиСубконтоСчетаЗатрат(ЭтаФорма, Истина);
	КонецЕсли;
	
	РежимФормыСписокОбъектов = ?(Объект.ИспользоватьСписокОбъектов, 1, 0);
	
	ДоступностьОсновногоСредства(ЭтаФорма, Объект);
	ДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	ДоступностьПорядокПогашенияСтоимости(ЭтаФорма, Объект);
	ДоступностьНачислениеАмортизации(ЭтаФорма, Объект);
	ДоступностьРасчетАмортизации(ЭтаФорма, Объект);
	
	УстановитьФункциональныеОпцииФормы();
	
	ТекущаяДатаДокумента = Объект.Дата;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если НЕ ПлательщикНалогаНаПрибыль Тогда
		Объект.ОтражатьВБухгалтерскомУчете = Истина;
		Объект.ОтражатьВНалоговомУчете = Истина;
	КонецЕсли;
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		ТекущиеДанные = Объект.ОсновныеСредства[0];
		ПорядокВключенияСтоимостиОСВСоставРасходовНУ =
		БухгалтерскиеОперацииПовтИсп.ПолучитьПараметрыАмортизацииОС(ТекущиеДанные.ОсновноеСредство, Объект.Дата).ПорядокВключенияСтоимостиВСоставРасходовНУ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если НЕ ПлательщикНалогаНаПрибыль Тогда
		Объект.ОтражатьВБухгалтерскомУчете = Истина;
		Объект.ОтражатьВНалоговомУчете = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоСчетаЗатрат(Форма, Стар = Ложь)
	
	ПерваяСтрока = Форма.Объект.ОсновныеСредства[0];
	
	СтруктураИменЭлементов = СтруктураИменЭлементовСубконтоЗатрат(Форма.ИспользоватьУчетПоПодразделениям);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(Форма, ПерваяСтрока, СтруктураИменЭлементов);
	
	Если Стар Тогда
		СтруктураИменЭлементов = СтруктураИменЭлементовСубконтоЗатратСтар(Форма.ИспользоватьУчетПоПодразделениям);
		ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(Форма, ПерваяСтрока, СтруктураИменЭлементов);
		Форма.Элементы.Субконто1Стар.Доступность = Истина;
		Форма.Элементы.Субконто2Стар.Доступность = Истина;
		Форма.Элементы.Субконто3Стар.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураИменЭлементовСубконтоЗатрат(ИспользоватьУчетПоПодразделениям)
	
	СтруктураИмен = ОбщегоНазначенияБГУКлиентСервер.СтруктураИменЭлементовСубконтоЗатрат(
		ИспользоватьУчетПоПодразделениям, Ложь, Истина);
		
	СтруктураИмен["СчетОбъекта"]      = "СчетУчетаЗатрат";
	СтруктураИмен["Субконто1"]        = "Субконто1";
	СтруктураИмен["Субконто2"]        = "Субконто2";
	СтруктураИмен["Субконто3"]        = "Субконто3";
	СтруктураИмен["Подразделение"]    = "ПодразделениеЗатрат";
	СтруктураИмен["СубконтоОбъекта1"] = "Субконто1";
	СтруктураИмен["СубконтоОбъекта2"] = "Субконто2";
	СтруктураИмен["СубконтоОбъекта3"] = "Субконто3";
	
	Возврат СтруктураИмен;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураИменЭлементовСубконтоЗатратСтар(ИспользоватьУчетПоПодразделениям)
	
	СтруктураИмен = ОбщегоНазначенияБГУКлиентСервер.СтруктураИменЭлементовСубконтоЗатрат(
		ИспользоватьУчетПоПодразделениям, Ложь, Истина);
		
	СтруктураИмен["СчетОбъекта"]	= "СчетУчетаЗатратПрежняя";
	СтруктураИмен["Субконто1"]		= "Субконто1Стар";
	СтруктураИмен["Субконто2"]		= "Субконто2Стар";
	СтруктураИмен["Субконто3"]		= "Субконто3Стар";
	СтруктураИмен["Подразделение"]	= "ПодразделениеЗатратСтар";
	
	Возврат СтруктураИмен;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьПараметровАмортизации(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		
		// Бухгалтерский учет
		ДоступностьЭлементовБухгалтерскогоУчета = Объект.ИзменятьПараметрыАмортизации И Объект.ОтражатьВБухгалтерскомУчете;		
		Элементы.ГруппаПараметрыАмортизацииЛевая.Доступность = ДоступностьЭлементовБухгалтерскогоУчета;
		
		// Налоговый учет
		ДоступностьЭлементовНалоговогоУчета = Объект.ИзменятьПараметрыАмортизации И Объект.ОтражатьВНалоговомУчете
			И Форма.ПорядокВключенияСтоимостиОСВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации");
		Элементы.СтатьяПрочихРасходовНУ.Доступность = ДоступностьЭлементовНалоговогоУчета И Форма.ВыбранСчетПрочихРасходов;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьПорядокПогашенияСтоимости(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		
		ПерваяСтрока = Объект.ОсновныеСредства[0];
		
		// Бухгалтерский учет
		ДоступностьЭлементовБухгалтерскогоУчета = Объект.ИзменятьПорядокПогашенияСтоимости И Объект.ОтражатьВБухгалтерскомУчете;
		Элементы.ПорядокПогашенияСтоимости.Доступность   = ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.СпособНачисленияАмортизации.Доступность = ДоступностьЭлементовБухгалтерскогоУчета
			И ПерваяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьНачислениеАмортизации(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		
		ПерваяСтрока = Объект.ОсновныеСредства[0];
		
		// Бухгалтерский учет
		ДоступностьЭлементовБухгалтерскогоУчета = Объект.ИзменятьНачислениеАмортизации И Объект.ОтражатьВБухгалтерскомУчете;
		Элементы.НачислятьАмортизацию.Доступность = ДоступностьЭлементовБухгалтерскогоУчета;
		
		// Налоговый учет
		ДоступностьЭлементовНалоговогоУчета = Объект.ИзменятьНачислениеАмортизации И Объект.ОтражатьВНалоговомУчете
			И Форма.ПорядокВключенияСтоимостиОСВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации");
		Элементы.НачислятьАмортизациюНУ.Доступность = ДоступностьЭлементовНалоговогоУчета;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьРасчетАмортизации(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		
		// Бухгалтерский учет
		ДоступностьЭлементовБухгалтерскогоУчета = Объект.ИзменятьРасчетАмортизации И Объект.ОтражатьВБухгалтерскомУчете;
		Элементы.СрокПолезногоИспользования.Доступность						= ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.СрокИспользованияДляВычисленияАмортизации.Доступность		= ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.СтоимостьДляВычисленияАмортизации.Доступность				= ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.ОсновныеСредстваКоэффициентУскорения.Доступность			= ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.ОсновныеСредстваПараметрВыработки.Доступность				= ДоступностьЭлементовБухгалтерскогоУчета;
		Элементы.ОсновныеСредстваПредполагаемыйОбъемВыработки.Доступность	= ДоступностьЭлементовБухгалтерскогоУчета;
		
		// Налоговый учет
		ДоступностьЭлементовНалоговогоУчета = Объект.ИзменятьРасчетАмортизации И Объект.ОтражатьВНалоговомУчете
			И Форма.ПорядокВключенияСтоимостиОСВСоставРасходовНУ =
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации");
		Элементы.СрокПолезногоИспользованияНУ.Доступность	= ДоступностьЭлементовНалоговогоУчета;
		Элементы.СпециальныйКоэффициентНУ.Доступность		= ДоступностьЭлементовНалоговогоУчета;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьОсновногоСредства(Форма, Объект)
	
	Форма.Элементы.ОсновноеСредство.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьКомандУстановкиПараметровАмортизации(Форма, Объект)
	
	Доступность = Объект.ИзменятьПараметрыАмортизации И Объект.ОтражатьВБухгалтерскомУчете;
	Форма.Элементы.ОсновныеСредстваУстановитьКПС.Доступность = Доступность;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИСброситьПараметрыНачисленияАмортизации()
	
	ТекущиеДанные = Объект.ОсновныеСредства[0];
	
	Если ТекущиеДанные.ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		ТекущиеДанные.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		Если ТекущиеДанные.СпособНачисленияАмортизации <> ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ТекущиеДанные.НачислятьАмортизацию = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)
	
	ТекущиеДанные = Объект.ОсновныеСредства[0];
	
	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("Счет"		, ТекущиеДанные.СчетУчетаЗатрат);
	СтрокаДанных.Вставить("Субконто1"	, ТекущиеДанные.Субконто1);
	СтрокаДанных.Вставить("Субконто2"	, ТекущиеДанные.Субконто2);
	СтрокаДанных.Вставить("Субконто3"	, ТекущиеДанные.Субконто3);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
		ДанныеВыбора, СтандартнаяОбработка, Объект.Организация, СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	ТекущиеДанные = Объект.ОсновныеСредства[0];
	
	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("Счет"		, ТекущиеДанные.СчетУчетаЗатрат);
	СтрокаДанных.Вставить("Субконто1"	, ТекущиеДанные.Субконто1);
	СтрокаДанных.Вставить("Субконто2"	, ТекущиеДанные.Субконто2);
	СтрокаДанных.Вставить("Субконто3"	, ТекущиеДанные.Субконто3);
	
	БухгалтерскиеОперацииКлиент.СубконтоПриИзмененииСпр(Элемент, СтрокаДанных, НомерСубконто);
	
	Для Счетчик = НомерСубконто По 3 Цикл
		Если ТекущиеДанные["Субконто"+Счетчик] <> СтрокаДанных["Субконто"+Счетчик] Тогда
			ТекущиеДанные["Субконто"+Счетчик] = СтрокаДанных["Субконто"+Счетчик];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеТекущегоОС(КоллекцияПриемник, Источник, ЗаполнятьНовыйДанные, ЗаполнятьПрежниеДанные, ПрежниеДанныеКопированием = Ложь)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("СчетУчетаЗатрат");
	ИменаРеквизитов.Добавить("КПСЗатрат");
	ИменаРеквизитов.Добавить("ПодразделениеЗатрат");
	ИменаРеквизитов.Добавить("КЭК");
	ИменаРеквизитов.Добавить("Субконто1");
	ИменаРеквизитов.Добавить("Субконто2");
	ИменаРеквизитов.Добавить("Субконто3");
	ИменаРеквизитов.Добавить("СтатьяПрочихРасходовНУ");
	ИменаРеквизитов.Добавить("НачислятьАмортизацию");
	ИменаРеквизитов.Добавить("ПорядокПогашенияСтоимости");
	ИменаРеквизитов.Добавить("СпособНачисленияАмортизации");
	ИменаРеквизитов.Добавить("КоэффициентУскорения");
	ИменаРеквизитов.Добавить("ПараметрВыработки");
	ИменаРеквизитов.Добавить("ПредполагаемыйОбъемВыработки");
	ИменаРеквизитов.Добавить("СрокПолезногоИспользования");
	ИменаРеквизитов.Добавить("СрокИспользованияДляВычисленияАмортизации");
	ИменаРеквизитов.Добавить("СтоимостьДляВычисленияАмортизации");
	ИменаРеквизитов.Добавить("НачислятьАмортизациюНУ");
	ИменаРеквизитов.Добавить("СрокПолезногоИспользованияНУ");
	ИменаРеквизитов.Добавить("СпециальныйКоэффициентНУ");
	
	Для Каждого СтрокаПриемник Из КоллекцияПриемник Цикл
		
		Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
			СтрокаИсточник = Источник.Получить(СтрокаПриемник.ОсновноеСредство);
			Если СтрокаИсточник = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			СтрокаИсточник = Источник;
		КонецЕсли;
		
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			
			Если ЗаполнятьНовыйДанные Тогда
				СтрокаПриемник[ИмяРеквизита] = СтрокаИсточник[ИмяРеквизита];
			КонецЕсли;
			
			Если ЗаполнятьПрежниеДанные Тогда
				Постфикс = ?(ПрежниеДанныеКопированием, "Прежняя", "");
				СтрокаПриемник[ИмяРеквизита + "Прежняя"] = СтрокаИсточник[ИмяРеквизита + Постфикс];
			КонецЕсли;
			
		КонецЦикла;
		
		ПриИзмененииСчетаУчетаЗатрат(СтрокаПриемник);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОС(Знач ОсновныеСредства, Знач Организация, Знач Период)
	
	Период = ?(ТипЗнч(Период) = Тип("Дата"),
		Новый Граница(КонецДня(Период), ВидГраницы.Включая),
		Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая));
	
	КлючиСтруктуры = "СчетУчетаЗатрат,КПСЗатрат,КЭК,ПодразделениеЗатрат,Субконто1,Субконто2,Субконто3,СтатьяПрочихРасходовНУ,"
		+ "НачислятьАмортизацию,ПорядокПогашенияСтоимости,СпособНачисленияАмортизации,СрокПолезногоИспользования,"
		+ "СрокИспользованияДляВычисленияАмортизации,СтоимостьДляВычисленияАмортизации,НачислятьАмортизациюНУ,"
		+ "СрокПолезногоИспользованияНУ,СпециальныйКоэффициентНУ,КоэффициентУскорения,ПараметрВыработки,ПредполагаемыйОбъемВыработки";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	АмортизацияОС_БУ.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС_БУ.КПС КАК КПСЗатрат,
	|	АмортизацияОС_БУ.КЭК КАК КЭК,
	|	АмортизацияОС_БУ.Подразделение КАК ПодразделениеЗатрат,
	|	АмортизацияОС_БУ.Субконто1 КАК Субконто1,
	|	АмортизацияОС_БУ.Субконто2 КАК Субконто2,
	|	АмортизацияОС_БУ.Субконто3 КАК Субконто3,
	|	АмортизацияОС_БУ.СубконтоНУ КАК СтатьяПрочихРасходовНУ,
	|	НачислениеАмортизацииОС_БУ.НачислятьАмортизацию КАК НачислятьАмортизацию,
	|	ПараметрыАмортизацииОС_БУ.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОС_БУ.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	РасчетАмортизацииОС_БУ.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	РасчетАмортизацииОС_БУ.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
	|	РасчетАмортизацииОС_БУ.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	РасчетАмортизацииОС_БУ.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОС_БУ.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОС_БУ.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
	|	НачислениеАмортизацииОС_НУ.НачислятьАмортизацию КАК НачислятьАмортизациюНУ,
	|	ПараметрыАмортизацииОС_НУ.СрокПолезногоИспользования КАК СрокПолезногоИспользованияНУ,
	|	СпециальныйКоэффициент_НУ.СпециальныйКоэффициент КАК СпециальныйКоэффициентНУ
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АмортизацияОС.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК АмортизацияОС_БУ
	|		ПО ОсновныеСредства.Ссылка = АмортизацияОС_БУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК НачислениеАмортизацииОС_БУ
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизацииОС_БУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК ПараметрыАмортизацииОС_БУ
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизацииОС_БУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК РасчетАмортизацииОС_БУ
	|		ПО ОсновныеСредства.Ссылка = РасчетАмортизацииОС_БУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОСНалоговыйУчет.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК НачислениеАмортизацииОС_НУ
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизацииОС_НУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСНалоговыйУчет.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК ПараметрыАмортизацииОС_НУ
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизацииОС_НУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет.СрезПоследних(
	|				&Период,
	|				ОсновноеСредство В (&ОсновныеСредства)
	|					И Организация = &Организация) КАК СпециальныйКоэффициент_НУ
	|		ПО ОсновныеСредства.Ссылка = СпециальныйКоэффициент_НУ.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОсновныеСредства)";
	
	Запрос.УстановитьПараметр("ОсновныеСредства",	ОсновныеСредства);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Период",				Период);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		ДанныеОС = Новый Структура(КлючиСтруктуры);
		ЗаполнитьЗначенияСвойств(ДанныеОС, Выборка);
		Результат.Вставить(Выборка.ОсновноеСредство, ДанныеОС);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииОС(ТекущиеДанные)
	
	Период = ?(Объект.Ссылка.Пустая(), Объект.Дата, Объект.Ссылка);
	
	ДанныеОС = ПолучитьДанныеОС(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные.ОсновноеСредство),
		Объект.Организация, Период);
	
	ЗаполнитьДанныеТекущегоОС(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные), ДанныеОС, Истина, Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСчетаУчетаЗатрат(ТекущиеДанные)
		
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетУчетаЗатрат);
	ТекущиеДанные.КоличествоСубконто = ДанныеСчета.КоличествоСубконто;
	ТекущиеДанные.УчетПоПодразделениям = ДанныеСчета.УчетПоПодразделениям;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ПриИзмененииОС(ТекущиеДанные);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПрежниеДанныеВТаблице()
	
	МассивОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Период = ?(Объект.Ссылка.Пустая(), Объект.Дата, Объект.Ссылка);
	
	ДанныеОС = ПолучитьДанныеОС(МассивОС, Объект.Организация, Период);
	ЗаполнитьДанныеТекущегоОС(Объект.ОсновныеСредства, ДанныеОС, Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСписокОбъектовПриИзменении(Элемент)
	
	Объект.ИспользоватьСписокОбъектов = (РежимФормыСписокОбъектов = 1);
	
	Если Не Объект.ИспользоватьСписокОбъектов Тогда
		Если Объект.ОсновныеСредства.Количество() = 0 Тогда
			Объект.ОсновныеСредства.Добавить();
		ИначеЕсли Объект.ОсновныеСредства.Количество() > 1 Тогда
			ТекстВопроса = Нстр("ru='Список объектов ОС, НМА содержит больше одного объекта.
			|Лишние объекты будут удалены. Продолжить?'");
			Оповещение = Новый ОписаниеОповещения("ВопросОчиститьТабЧастьОсновныеСредстваЗавершение", ЭтотОбъект);
