&НаКлиенте
Процедура УстановитьКПС(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("ВидимостьЭлементовНалоговогоУчета", ПлательщикНалогаНаПрибыль);
	ПараметрыФормы.Вставить("КоличествоВыделенныхСтрок", Элементы.ОсновныеСредства.ВыделенныеСтроки.Количество());
	ПараметрыФормы.Вставить("КоличествоСтрокВсего", Объект.ОсновныеСредства.Количество());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьВыбранныйКПСВСтроки", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ИзменениеПараметровАмортизации.Форма.ФормаУстановкиСчета", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

