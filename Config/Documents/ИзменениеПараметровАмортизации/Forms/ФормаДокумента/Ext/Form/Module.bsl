&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В ИЕРАРХИИ (&СчетОС),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КПС = &КПС
	|				И КФО = &КФО
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).ВидНФА = &ВидНФА) КАК ЖурналПроводокЕПСБУОстатки";
	
	Если Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ИФО = &ИФО", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КПС) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И КПС = &КПС", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И КФО = &КФО", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидНФА) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).ВидНФА = &ВидНФА", "");
	КонецЕсли;
	
	Период = ?(Объект.Ссылка.Пустая(),
		Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая),
		Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	
	Если ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		СчетОС = Объект.СчетУчета;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЕРАРХИИ", "");
		СчетОС = БухгалтерскийУчет.СписокСчетов(ОтборСчетов.ВыгрузитьЗначения());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("СчетОС"		, СчетОС);
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("ИФО"			, Объект.ИФО);
	Запрос.УстановитьПараметр("КФО"			, Объект.КФО);
	Запрос.УстановитьПараметр("КПС"			, Объект.КПС);
	Запрос.УстановитьПараметр("ВидНФА"		, Объект.ВидНФА);
	
	МассивОС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Период = ?(Объект.Ссылка.Пустая(), Объект.Дата, Объект.Ссылка);
	ДанныеОС = ПолучитьДанныеОС(МассивОС, Объект.Организация, Период);
	
	Объект.ОсновныеСредства.Очистить();
	Для Каждого ТекОС Из МассивОС Цикл
		
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		НоваяСтрока.ОсновноеСредство = ТекОС;
		
	КонецЦикла;
	
	ЗаполнитьДанныеТекущегоОС(Объект.ОсновныеСредства, ДанныеОС, Истина, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораЭлементов()
	
	МассивВидовНФА = Новый Массив;
	МассивВидовНФА.Добавить(Перечисления.ВидыНФА.ОС);
	МассивВидовНФА.Добавить(Перечисления.ВидыНФА.НМА);
	Если ЗначениеЗаполнено(Объект.ВидНФА) И МассивВидовНФА.Найти(Объект.ВидНФА) = Неопределено Тогда
		МассивВидовНФА.Добавить(Объект.ВидНФА);
	КонецЕсли;
	
	Элементы.ВидНФА.СписокВыбора.ЗагрузитьЗначения(МассивВидовНФА);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСчетаПоВидуНФА()
	
	ОтборСчетов.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ВидНФА)
		Или Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		ОтборСчетов.Добавить("101.00");
		ОтборСчетов.Добавить("108.51");
		ОтборСчетов.Добавить("108.52");
		ОтборСчетов.Добавить("108.91");
		ОтборСчетов.Добавить("108.92");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидНФА)
		Или Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		ОтборСчетов.Добавить("102.00");
		ОтборСчетов.Добавить("108.54");
		ОтборСчетов.Добавить("108.9I");
		ОтборСчетов.Добавить("111.60");
	КонецЕсли;
	
КонецПроцедуры

