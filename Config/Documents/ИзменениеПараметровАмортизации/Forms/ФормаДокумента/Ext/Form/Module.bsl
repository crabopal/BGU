&НаСервере
Процедура УстановитьСчетИКПСЗатратНаСервере(ПараметрыУстановки)
	
	Если ПараметрыУстановки.ВоВсехСтроках Тогда
		ИсточникСтрок = Объект.ОсновныеСредства;
	Иначе
		ИсточникСтрок = Элементы.ОсновныеСредства.ВыделенныеСтроки;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из ИсточникСтрок Цикл
		
		Если ТипЗнч(ЭлементКоллекции) = Тип("ДанныеФормыЭлементКоллекции") Тогда
			УстановитьСчетИКПСЗатратВСтроке(ЭлементКоллекции, ПараметрыУстановки);
		Иначе
			УстановитьСчетИКПСЗатратВСтроке(Объект.ОсновныеСредства.НайтиПоИдентификатору(ЭлементКоллекции), ПараметрыУстановки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетИКПСЗатратВСтроке(Знач ТекущаяСтрока, ПараметрыУстановки)
	
	Если ПараметрыУстановки.УстанавливатьСчет Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыУстановки,
			"СчетУчетаЗатрат, КЭК, ПодразделениеЗатрат, Субконто1, Субконто2, Субконто3");
		Если ПлательщикНалогаНаПрибыль Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыУстановки, "СтатьяПрочихРасходовНУ");
		КонецЕсли;
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущаяСтрока.СчетУчетаЗатрат);
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СвойстваСчета, "УчетПоПодразделениям, КоличествоСубконто");
		
	КонецЕсли;
	
	Если ПараметрыУстановки.УстанавливатьКПС Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыУстановки, "КПСЗатрат");
	КонецЕсли;
	
	Если ПараметрыУстановки.УстановитьНачислениеАмортизации Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыУстановки, "ПорядокПогашенияСтоимости, СпособНачисленияАмортизации,"
			+ "НачислятьАмортизацию, НачислятьАмортизациюНУ");
	КонецЕсли;
	
	Если ПараметрыУстановки.УстановитьРасчетАмортизации Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыУстановки, "СрокПолезногоИспользования,"
			+ "СрокИспользованияДляВычисленияАмортизации, СтоимостьДляВычисленияАмортизации,"
			+ "СрокПолезногоИспользованияНУ, СпециальныйКоэффициентНУ");
	КонецЕсли;
	
КонецПроцедуры

