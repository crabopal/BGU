#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, Дата, ИФО, ВидимостьЭлементовНалоговогоУчета, КоличествоВыделенныхСтрок, КоличествоСтрокВсего");
	УстановитьЗаголовкиСубконтоЗатрат(ЭтаФорма, ЭтаФорма);
	УстановитьДоступностьПорядкаНачисленияАмортизации(ЭтотОбъект);
	
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтаФорма);
	УстановитьВидимостьЭлементовНУ(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СчетУчетаЗатратПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.СчетУчетаЗатратПриИзменении(Элемент, СчетУчетаЗатрат, КЭКЗатрат);
	УстановитьЗаголовкиСубконтоЗатрат(ЭтаФорма, ЭтаФорма);
	
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КЭКЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет затрат'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СчетУчетаЗатрат");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	ДанныеВыбора = Новый СписокЗначений;
	Если Лев(Строка(СчетУчетаЗатрат), 3) = "106" Тогда
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("340"));
	Иначе		
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("271"));
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаЗатратОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															КПСЗатрат,
															,
															,);
КонецПроцедуры

&НаКлиенте
Процедура КПСЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВидыКБК = Новый Массив;
	ВидыКБК.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ВидыКБК.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	ВидыКБК.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													КПСЗатрат, 
													Организация,
													ИФО,
													,
													ВидыКБК,
													Дата);
КонецПроцедуры

&НаКлиенте
Процедура КПСЗатратОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Элементы.КПСЗатрат.РежимВыбораИзСписка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат1ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 1);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат2ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 2);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат3ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 3);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 1);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 2);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 3);
КонецПроцедуры

&НаКлиенте
Процедура ПорядокПогашенияСтоимостиПриИзменении(Элемент)
	ОчиститьЗначенияПорядкаНачисленияАмортизации();
	УстановитьДоступностьПорядкаНачисленияАмортизации(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СпособНачисленияАмортизацииПриИзменении(Элемент)
	ОчиститьЗначенияПорядкаНачисленияАмортизации();
	УстановитьДоступностьПорядкаНачисленияАмортизации(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьВДокументе(Команда)
	УстановитьЗначенияВДокумент(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВоВсехСтроках(Команда)
	УстановитьЗначенияВДокумент(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНУ(Форма)

	ВидимостьЭлементовНалоговогоУчета = Форма.ВидимостьЭлементовНалоговогоУчета;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НачислятьАмортизациюНУ",
		"Видимость", ВидимостьЭлементовНалоговогоУчета);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СрокПолезногоИспользованияНУ",
		"Видимость", ВидимостьЭлементовНалоговогоУчета);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпециальныйКоэффициентНУ",
		"Видимость", ВидимостьЭлементовНалоговогоУчета);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект)
	Перем МассивПолей;
	
	//БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
	//	"КПС", "КПСЗатрат", "ЗаголовокКПСЗатрат", Ложь, "КПСЗатрат", Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КЭК", "КЭКЗатрат", "", Ложь, "КЭКЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ЗаголовокПодразделениеЗатрат", Ложь, "ПодразделениеЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);

КонецПроцедуры // УстановитьЗаголовокиСубконтоЗатрат()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихРасходов(Форма)

	ВидимостьЭлементовНалоговогоУчета = Форма.ВидимостьЭлементовНалоговогоУчета;
	
	ВыбранСчетПрочихРасходов = (БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("401.20").Найти(Форма.СчетУчетаЗатрат) <> Неопределено);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтатьяПрочихРасходов",
		"Видимость",  ВидимостьЭлементовНалоговогоУчета И ВыбранСчетПрочихРасходов);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									СчетУчетаЗатрат,
									СубконтоЗатрат1,
									СубконтоЗатрат2,
									СубконтоЗатрат3);
	УправлениеОсновнымиСредствамиКлиент.ОбработатьИзменениеСубконто(Элемент, ЭтаФорма, СтрокаДанных, НомерСубконто)									

КонецПроцедуры // ОбработатьИзменениеСубконто()

&НаКлиенте
Процедура ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									СчетУчетаЗатрат,
									СубконтоЗатрат1,
									СубконтоЗатрат2,
									СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
														ДанныеВыбора, 
														СтандартнаяОбработка, 
														Организация,
														СтрокаДанных, 
														ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьВыборСубконто()

&НаКлиенте
Функция РеквизитыЗаполнены()

	Если НЕ УстановитьСчет
		И НЕ УстановитьКПС
		И НЕ УстановитьНачислениеАмортизации
		И НЕ УстановитьРасчетАмортизации Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны изменяемые реквизиты.
			|Установите один или несколько флагов:
			|Установить счет, КЭК и субконто затрат,
			|Установить КПС затрат,
			|Установить начисление амортизации,
			|Установить расчет амортизации.'"));
		
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ШаблонОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,"%1");
	
	Если УстановитьСчет Тогда
		
		Если Не ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Счет учета затрат'")),,"СчетУчетаЗатрат");
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КЭКЗатрат) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'КЭК затрат'")),,"КЭКЗатрат",,Отказ);
		КонецЕсли;
		Если Элементы.ПодразделениеЗатрат.АвтоОтметкаНезаполненного = Истина И Не ЗначениеЗаполнено(ПодразделениеЗатрат) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Подразделение затрат'")),,"ПодразделениеЗатрат",,Отказ);
		КонецЕсли;
		Если Элементы.СубконтоЗатрат1.АвтоОтметкаНезаполненного = Истина И Не ЗначениеЗаполнено(СубконтоЗатрат1) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Субконто 1'")),,"СубконтоЗатрат1",,Отказ);
		КонецЕсли;
		Если Элементы.СубконтоЗатрат2.АвтоОтметкаНезаполненного = Истина И Не ЗначениеЗаполнено(СубконтоЗатрат2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Субконто 2'")),,"СубконтоЗатрат2",,Отказ);
		КонецЕсли;
		Если Элементы.СубконтоЗатрат3.АвтоОтметкаНезаполненного = Истина И Не ЗначениеЗаполнено(СубконтоЗатрат3) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Субконто 3'")),,"СубконтоЗатрат3",,Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если УстановитьНачислениеАмортизации Тогда
		
		Если Не ЗначениеЗаполнено(ПорядокПогашенияСтоимости) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Порядок погашения стоимости'")),,"ПорядокПогашенияСтоимости",,Отказ);
		ИначеЕсли ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			И Не ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НСтр("ru = 'Способ начисления амортизации'")),,"СпособНачисленияАмортизации",,Отказ);
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Не Отказ;

КонецФункции

&НаКлиенте
Процедура УстановитьЗначенияВДокумент(ВоВсехСтроках = Ложь)
	
	Если НЕ РеквизитыЗаполнены() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыУстановки = Новый Структура("СчетУчетаЗатрат,КПСЗатрат,ПодразделениеЗатрат,СтатьяПрочихРасходовНУ,"
		+ "Субконто1,Субконто2,Субконто3,КЭК,УстанавливатьСчет,УстанавливатьКПС,ВоВсехСтроках,"
		+ "УстановитьНачислениеАмортизации, ПорядокПогашенияСтоимости, СпособНачисленияАмортизации,"
		+ "НачислятьАмортизацию, НачислятьАмортизациюНУ, УстановитьРасчетАмортизации, СрокПолезногоИспользования,"
		+ "СрокИспользованияДляВычисленияАмортизации, СтоимостьДляВычисленияАмортизации,"
		+ "СрокПолезногоИспользованияНУ, СпециальныйКоэффициентНУ");
	ЗаполнитьЗначенияСвойств(ПараметрыУстановки, ЭтаФорма, "СчетУчетаЗатрат,КПСЗатрат,ПодразделениеЗатрат");
	ПараметрыУстановки.Субконто1              = СубконтоЗатрат1;
	ПараметрыУстановки.Субконто2              = СубконтоЗатрат2;
	ПараметрыУстановки.Субконто3              = СубконтоЗатрат3;
	ПараметрыУстановки.КЭК                    = КЭКЗатрат;
	ПараметрыУстановки.СтатьяПрочихРасходовНУ = СтатьяПрочихРасходов;
	ПараметрыУстановки.УстанавливатьСчет      = УстановитьСчет;
	ПараметрыУстановки.УстанавливатьКПС       = УстановитьКПС;
	ПараметрыУстановки.ВоВсехСтроках          = ВоВсехСтроках;
	
	ПараметрыУстановки.УстановитьНачислениеАмортизации = УстановитьНачислениеАмортизации;
	ПараметрыУстановки.ПорядокПогашенияСтоимости       = ПорядокПогашенияСтоимости;
	ПараметрыУстановки.СпособНачисленияАмортизации     = СпособНачисленияАмортизации;
	ПараметрыУстановки.НачислятьАмортизацию            = НачислятьАмортизацию;
	ПараметрыУстановки.НачислятьАмортизациюНУ          = НачислятьАмортизациюНУ;
	
	ПараметрыУстановки.УстановитьРасчетАмортизации               = УстановитьРасчетАмортизации;
	ПараметрыУстановки.СрокПолезногоИспользования                = СрокПолезногоИспользования;
	ПараметрыУстановки.СрокИспользованияДляВычисленияАмортизации = СрокИспользованияДляВычисленияАмортизации;
	ПараметрыУстановки.СтоимостьДляВычисленияАмортизации         = СтоимостьДляВычисленияАмортизации;
	ПараметрыУстановки.СрокПолезногоИспользованияНУ              = СрокПолезногоИспользованияНУ;
	ПараметрыУстановки.СпециальныйКоэффициентНУ                  = СпециальныйКоэффициентНУ;
	
	Модифицированность = Ложь;
	Закрыть(ПараметрыУстановки);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПорядкаНачисленияАмортизации(Форма)

	НачислениеАмортизации = Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
	ЛинейныйСпособ = Форма.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпособНачисленияАмортизации",
		"Доступность", НачислениеАмортизации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НачислятьАмортизацию",
		"Доступность", НачислениеАмортизации И ЛинейныйСпособ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НачислятьАмортизациюНУ",
		"Доступность", НачислениеАмортизации И ЛинейныйСпособ);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗначенияПорядкаНачисленияАмортизации()

	Если ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
	КонецЕсли;
	
	Если ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
		И СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
		НачислятьАмортизацию = Ложь;
		НачислятьАмортизациюНУ = Ложь;
	КонецЕсли;

КонецПроцедуры // ОчиститьЗначенияПорядкаНачисленияАмортизации()
 

#КонецОбласти
