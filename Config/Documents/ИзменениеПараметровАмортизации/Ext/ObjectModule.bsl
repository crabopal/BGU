#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Проверяет заполнение строки табличной части. Устанавливает флаг Отказ = Ложь при наличии ошибок
//
// Параметры:
//  ТекСтрока - СтрокаТабличнойЧасти - строка табличной части
//  Ошибки - Структура - см. ДобавитьОшибкуПользователю() общего модуля ОбщегоНазначенияКлиентСервер
//  Отказ - Булево - флаг отказа от записи документа
//  ИспользоватьУчетПоПодразделениям - Булево - значение одноименой функционально опции 
Процедура ПроверитьЗаполнениеСтрокиТЧ(ТекСтрока, Ошибки, Отказ, ИспользоватьУчетПоПодразделениям) Экспорт
	НомерСтроки = ?(ИспользоватьСписокОбъектов, ТекСтрока.НомерСтроки, Неопределено);
	
	Если ОтражатьВБухгалтерскомУчете И ИзменятьПараметрыАмортизации Тогда
		
		Если Не ЗначениеЗаполнено(ТекСтрока.СчетУчетаЗатрат) Тогда
			ДобавитьОшибку(Ошибки, "СчетУчетаЗатрат", "Счет учета затрат", НомерСтроки);
			
		Иначе
			Если Не ЗначениеЗаполнено(ТекСтрока.КЭК) Тогда
				ДобавитьОшибку(Ошибки, "КЭК", "КЭК затрат", НомерСтроки);
			КонецЕсли;
			
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекСтрока.СчетУчетаЗатрат);
			
			Если ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям
				И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение
				И Не ЗначениеЗаполнено(ТекСтрока.ПодразделениеЗатрат) Тогда
				
				ДобавитьОшибку(Ошибки, "ПодразделениеЗатрат", "Подразделение затрат", НомерСтроки);
			КонецЕсли;
			
			Для к = 1 по 3 Цикл
				Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + к])
					И СвойстваСчета["ВидСубконто" + к + "Обязательный"]
					И Не ЗначениеЗаполнено(ТекСтрока["Субконто" + к]) Тогда
					
					ДобавитьОшибку(Ошибки, "Субконто" + к, "Субконто " + к, НомерСтроки);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОтражатьВБухгалтерскомУчете И ИзменятьПорядокПогашенияСтоимости Тогда
		Если Не ЗначениеЗаполнено(ТекСтрока.ПорядокПогашенияСтоимости) Тогда
			ДобавитьОшибку(Ошибки, "ПорядокПогашенияСтоимости", "Порядок погашения стоимости", НомерСтроки);
			
		ИначеЕсли ТекСтрока.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
			И Не ЗначениеЗаполнено(ТекСтрока.СпособНачисленияАмортизации) Тогда
			
			ДобавитьОшибку(Ошибки, "СпособНачисленияАмортизации", "Способ начисления амортизации", НомерСтроки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Перем Ошибки;
	
	Если НЕ ИспользоватьСписокОбъектов Тогда
		// табличную часть не проверяем, т.к. проверка производится в форме документа
		Возврат;
	КонецЕсли;
	
	ШаблонТекстаСообщения =  НСтр("ru='В строке ""%1"" не заполнено поле ""%2""'");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата);
	
	Для каждого ТекущиеДанные Из ОсновныеСредства Цикл
		ПроверитьЗаполнениеСтрокиТЧ(ТекущиеДанные, Ошибки, Отказ, ИспользоватьУчетПоПодразделениям);
	КонецЦикла; 
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата) Тогда
		// Флаги не видны на форме и не должны влиять на отражение в учете
		ОтражатьВБухгалтерскомУчете = Истина;
		ОтражатьВНалоговомУчете = Истина;
	КонецЕсли;

	Если ОсновныеСредства.Количество() > 1 Тогда
		ИспользоватьСписокОбъектов = Истина;
	КонецЕсли;	
	
	Если ОсновныеСредства.Количество() = 1 Тогда
		ОсновноеСредство = ОсновныеСредства[0].ОсновноеСредство;
	Иначе
		ОсновноеСредство = Справочники.ОсновныеСредства.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);		
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОшибку(Ошибки, ИмяПоля, ПредставлениеПоля, НомерСтроки = Неопределено)

	Если НомерСтроки = Неопределено Тогда
		ШаблонТекстаСообщения = НСтр("ru='Не заполнено поле ""%1""'");
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстаСообщения, ПредставлениеПоля);
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, ИмяПоля, ТекстСообщения,,);
	Иначе	
		ШаблонТекстаСообщения =  НСтр("ru='В строке ""%1"" не заполнено поле ""%2""'");
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,
							НомерСтроки, ПредставлениеПоля);
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1]." + ИмяПоля, ТекстСообщения,, НомерСтроки - 1);
	КонецЕсли;		

КонецПроцедуры
 
#КонецОбласти

#КонецЕсли
