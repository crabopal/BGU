#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ОтражатьВБухгалтерскомУчете,ОтражатьВНалоговомУчете,Организация,Дата");
	
	ОтражатьВБухгалтерскомУчете = ЗначенияРеквизитов.ОтражатьВБухгалтерскомУчете;
	ОтражатьВНалоговомУчете = ЗначенияРеквизитов.ОтражатьВНалоговомУчете 
		И НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата);
	
	Если Не ОтражатьВБухгалтерскомУчете И Не ОтражатьВНалоговомУчете Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ТаблицыЗапроса = Новый Массив;
	
	// Бухгалтерский учет
	Если ОтражатьВБухгалтерскомУчете Тогда
		
		СчетаУчетаПрочихРасходов = БухгалтерскийУчет.СписокСчетов("401.20");
		Запрос.УстановитьПараметр("СчетаУчетаПрочихРасходов", СчетаУчетаПрочихРасходов);
		Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
		
		ТаблицыЗапроса.Добавить("АмортизацияОС");
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Организация КАК Организация,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ИзменениеПараметровАмортизацииОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
		|	ИзменениеПараметровАмортизацииОС.КЭК КАК КЭК,
		|	ИзменениеПараметровАмортизацииОС.Субконто1 КАК Субконто1,
		|	ИзменениеПараметровАмортизацииОС.Субконто2 КАК Субконто2,
		|	ИзменениеПараметровАмортизацииОС.Субконто3 КАК Субконто3,
		|	ИзменениеПараметровАмортизацииОС.КПСЗатрат КАК КПС,
		|	ИзменениеПараметровАмортизацииОС.ПодразделениеЗатрат КАК Подразделение,
		|	ВЫБОР
		|		КОГДА &ОтражатьВНалоговомУчете
		|				И ИзменениеПараметровАмортизацииОС.СчетУчетаЗатрат В (&СчетаУчетаПрочихРасходов)
		|			ТОГДА ИзменениеПараметровАмортизацииОС.СтатьяПрочихРасходовНУ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяССылка)
		|	КОНЕЦ КАК СубконтоНУ
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизацииОС.Ссылка.ИзменятьПараметрыАмортизации";
		
		ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСБухгалтерскийУчет");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Организация КАК Организация,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ИзменениеПараметровАмортизацииОС.НачислятьАмортизацию КАК НачислятьАмортизацию,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	ЛОЖЬ КАК Консервация,
		|	0 КАК СрокПриостановки
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизацииОС.Ссылка.ИзменятьНачислениеАмортизации
		|	И ИзменениеПараметровАмортизацииОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
		|	И ИзменениеПараметровАмортизацииОС.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)";
		
		ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Организация КАК Организация,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ИзменениеПараметровАмортизацииОС.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
		|	ИзменениеПараметровАмортизацииОС.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизацииОС.Ссылка.ИзменятьПорядокПогашенияСтоимости";
		
		ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.Ссылка.Организация КАК Организация,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ИзменениеПараметровАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
		|	ИзменениеПараметровАмортизацииОС.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
		|	ИзменениеПараметровАмортизацииОС.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
		|	ВЫБОР
		|		КОГДА ИзменениеПараметровАмортизацииОС.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
		|			ТОГДА ИзменениеПараметровАмортизацииОС.КоэффициентУскорения
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоэффициентУскорения,
		|	ВЫБОР
		|		КОГДА ИзменениеПараметровАмортизацииОС.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
		|			ТОГДА ИзменениеПараметровАмортизацииОС.ПараметрВыработки
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПараметрыВыработкиОС.ПустаяСсылка)
		|	КОНЕЦ КАК ПараметрВыработки,
		|	ВЫБОР
		|		КОГДА ИзменениеПараметровАмортизацииОС.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
		|			ТОГДА ИзменениеПараметровАмортизацииОС.ПредполагаемыйОбъемВыработки
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПредполагаемыйОбъемВыработки
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизацииОС.Ссылка.ИзменятьРасчетАмортизации";
		
	КонецЕсли;
	
	// Налоговый учет
	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСНалоговыйУчет");
		Запрос.Текст = Запрос.Текст + ?(ОтражатьВБухгалтерскомУчете, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизации.Ссылка КАК Регистратор,
		|	ИзменениеПараметровАмортизации.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство,
		|	ИзменениеПараметровАмортизации.Организация,
		|	ИзменениеПараметровАмортизацииОС.НачислятьАмортизациюНУ КАК НачислятьАмортизацию
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеПараметровАмортизации КАК ИзменениеПараметровАмортизации
		|		ПО ИзменениеПараметровАмортизацииОС.Ссылка = ИзменениеПараметровАмортизации.Ссылка
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.ИзменятьНачислениеАмортизации";
		
		ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСНалоговыйУчет");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизации.Ссылка КАК Регистратор,
		|	ИзменениеПараметровАмортизации.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство,
		|	ИзменениеПараметровАмортизации.Организация,
		|	ИзменениеПараметровАмортизацииОС.СрокПолезногоИспользованияНУ КАК СрокПолезногоИспользования
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеПараметровАмортизации КАК ИзменениеПараметровАмортизации
		|		ПО ИзменениеПараметровАмортизацииОС.Ссылка = ИзменениеПараметровАмортизации.Ссылка
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.ИзменятьРасчетАмортизации";
		
		ТаблицыЗапроса.Добавить("НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИзменениеПараметровАмортизации.Ссылка КАК Регистратор,
		|	ИзменениеПараметровАмортизации.Дата КАК Период,
		|	ИзменениеПараметровАмортизацииОС.ОсновноеСредство,
		|	ИзменениеПараметровАмортизации.Организация,
		|	ИзменениеПараметровАмортизацииОС.СпециальныйКоэффициентНУ КАК СпециальныйКоэффициент
		|ИЗ
		|	Документ.ИзменениеПараметровАмортизации.ОсновныеСредства КАК ИзменениеПараметровАмортизацииОС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеПараметровАмортизации КАК ИзменениеПараметровАмортизации
		|		ПО ИзменениеПараметровАмортизацииОС.Ссылка = ИзменениеПараметровАмортизации.Ссылка
		|ГДЕ
		|	ИзменениеПараметровАмортизацииОС.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.Ссылка = &Ссылка
		|	И ИзменениеПараметровАмортизации.ИзменятьРасчетАмортизации";
		
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса); 
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
