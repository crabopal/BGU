КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыФормыПриЧтении(Форма, Объект)
	
	ЗаполнитьРеквизитыФормыПоСчетуУчета(Форма, Объект);
	ЗаполнитьРеквизитыФормыПоОбъектуОС(Форма, Объект);
	
	УстановитьСрокПолезногоИспользованияВГодах(Форма, Объект);
	
	УстановитьОбязательностьЭлементовФормы(Форма, Объект);
	УстановитьВидимостьПараметровАмортизации(Форма, Объект);
	УстановитьДоступностьПараметровАмортизации(Форма, Объект);
	УстановитьСчетИмуществаВПользовании(Форма, Объект);
	
	// Налоговый учет и УСН.
	Форма.ОтражатьВНалоговомУчете =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(Объект);
	Форма.ОтражатьВУСНДоходыМинусРасходы =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(Объект);
	
	УстановитьВидимостьЭлементовНалоговогоУчета(Форма);
	УстановитьВидимостьЭлементовНалоговогоУчетаУСН(Форма);
	
	Форма.ВключитьАмортизационнуюПремиюВСоставРасходов = ПараметрыАмортизационнойПремииЗаполнены(Объект);
	УстановитьВидимостьПараметровАмортизационнойПремии(Форма);
	УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыФормыПоСчетуУчета(Форма, Объект)

	Если ЗначениеЗаполнено(Объект.СчетОС) Тогда
		Форма.ОС_СчетУчета_Забалансовый = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.СчетОС).Забалансовый;
	Иначе
		Форма.ОС_СчетУчета_Забалансовый = Ложь;
	КонецЕсли;
	
	Форма.ОС_ВидУчета = УправлениеОсновнымиСредствамиКлиентСервер.ВидУчетаПоСчетуУчета(Объект.СчетОС);
	Форма.ОС_ВидНФА = УправлениеОсновнымиСредствамиКлиентСервер.ВидНФАпоСчетуУчета(Объект.СчетОС);
	
	УстановитьОбязательностьЭлементовФормы(Форма, Объект);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыФормыПоОбъектуОС(Форма, Объект)
	
	Если Объект.ОсновныеСредства.Количество() > 0 
		И ЗначениеЗаполнено(Объект.ОсновныеСредства[0].ОсновноеСредство) Тогда
		ДанныеОбъектаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ОсновныеСредства[0].ОсновноеСредство,
																"АмортизационнаяГруппа");
		Форма.ОС_АмортизационнаяГруппа	= ДанныеОбъектаОС.АмортизационнаяГруппа;
		Форма.ОС_КодОКОФ				= "";
	Иначе
		Форма.ОС_АмортизационнаяГруппа	= Перечисления.АмортизационныеГруппы.ПустаяСсылка();
		Форма.ОС_КодОКОФ				= "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет") Тогда
		ПараметрыПодбора.Вставить("ОС", Истина);			
		ПараметрыПодбора.Вставить("ВозвратИзПользованияОперУчет", Истина);
		ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер",	Истина);
	Иначе
	//	ПараметрыПодбора.Отбор.Вставить("СчетУчета", Объект.СчетОС);
		ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер",	Истина);
	КонецЕсли;
	ПараметрыПодбора.Вставить("НеПоказыватьКолонки", "ПервоначальнаяСтоимость");

	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		
		ПараметрыПодбора.Вставить("ВозвратИзПользования", 	Истина);
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет") Тогда
			ПараметрыПодбора.Вставить("ВключатьЗабалансовыеСчета",	Истина);
		Иначе
			ПараметрыПодбора.Вставить("ВключатьБалансовыеСчета",	Истина);
		КонецЕсли;
		ПараметрыПодбора.Вставить("ТребуемыеДанные", "Цена,ПервоначальнаяСтоимость,ГрупповойУчет");
		
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет") Тогда
			ПараметрыПодбора.Отбор.Вставить("СобытиеВПользовании", ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.СдачаВАренду"));
		Иначе
			ПараметрыПодбора.Отбор.Вставить("СобытиеВПользовании", ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование"));
		КонецЕсли;
		
		ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ИФО);
		ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМООтправитель);
		ПараметрыПодбора.Отбор.Вставить("Контрагент", Объект.Контрагент);
		Если Элементы.ДоговорКонтрагента.АвтоотметкаНезаполненного = Истина Тогда
			ПараметрыПодбора.Отбор.Вставить("Договор", Объект.Договор);
		КонецЕсли;
		
	Иначе
		
		ПараметрыПодбора.Вставить("ТребуемыеДанные", "ПервоначальнаяСтоимость,ГрупповойУчет");
		// в подборе выводим инв. номера по справочнику, а не по регистрам
		ПараметрыПодбора.Вставить("ПоказыватьВсеИнвентарныеНомера", Истина);
		
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		ПараметрыПодбора.Вставить("НеВыводитьСумму", Истина);
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СчетДляПроверки = ?(ЗначениеЗаполнено(Объект.СчетОС), Объект.СчетОС, "101.00");
	ПараметрыСчетаУчета = ПолучитьПараметрыСчетаУчета(ЭтаФорма, СчетДляПроверки);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация", "Организация");
	Если ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО", "ИФО");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО", "КФО");
	СтруктураРеквизитов.Вставить("СчетОС", "Счет учета");
	Если ПараметрыСчетаУчета.УчетПоКПС Тогда
		СтруктураРеквизитов.Вставить("КПС", "КПС");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям И ПараметрыСчетаУчета.УчетПоПодразделениям Тогда
		СтруктураРеквизитов.Вставить("Подразделение", "Подразделение");
	КонецЕсли;
	Если ПараметрыСчетаУчета.Контрагенты Тогда
		СтруктураРеквизитов.Вставить("Контрагент", "Контрагент");
	КонецЕсли;
	Если ПараметрыСчетаУчета.Договоры Тогда
		СтруктураРеквизитов.Вставить("Договор", "Договор");
	КонецЕсли;
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		СтруктураРеквизитов.Вставить("ЦМООтправитель", "МОЛ/Место хранения (отправитель)");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		СтруктураРеквизитов.Вставить("ВнеоборотныйАктив", "Объект вложений");
		СтруктураРеквизитов.Вставить("СчетКредита", "Счет объекта вложений");
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
			СтруктураРеквизитов.Вставить("Количество", "Количество");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЗаполнениеРеквизитов(Форма, Объект, Ошибки)

	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды") Тогда
		СчетДляПроверки = ?(ЗначениеЗаполнено(Форма.СчетИмуществаВПользовании), Форма.СчетИмуществаВПользовании, "25");
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования") Тогда
		СчетДляПроверки = ?(ЗначениеЗаполнено(Форма.СчетИмуществаВПользовании), Форма.СчетИмуществаВПользовании, "26");
	Иначе
		СчетДляПроверки = ?(ЗначениеЗаполнено(Объект.СчетОС), Объект.СчетОС, "101.00");
	КонецЕсли;
	
	ПараметрыСчетаУчета = ПолучитьПараметрыСчетаУчета(Форма, СчетДляПроверки);
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("СчетОС", "Счет учета");
	Если ПараметрыСчетаУчета.УчетПоКПС Тогда
		РеквизитыДляПроверки.Вставить("КПС", "КПС");
	КонецЕсли;
	Если Форма.ИспользоватьУчетПоПодразделениям И ПараметрыСчетаУчета.УчетПоПодразделениям Тогда
		РеквизитыДляПроверки.Вставить("Подразделение", "Подразделение");
	КонецЕсли;
	Если ПараметрыСчетаУчета.Контрагенты Тогда
		РеквизитыДляПроверки.Вставить("Контрагент", "Контрагент");
	КонецЕсли;
	Если ПараметрыСчетаУчета.Договоры Тогда
		РеквизитыДляПроверки.Вставить("Договор", "Договор");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		РеквизитыДляПроверки.Вставить("ВнеоборотныйАктив", "Объект вложений");
		РеквизитыДляПроверки.Вставить("СчетКредита", "Счет объекта вложений");
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
			РеквизитыДляПроверки.Вставить("Количество", "Количество");
		КонецЕсли;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	Для каждого ТекРеквизит Из РеквизитыДляПроверки Цикл
	
		Если Не ЗначениеЗаполнено(Объект[ТекРеквизит.Ключ]) Тогда
			
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				Ошибки,
				"Объект." + ТекРеквизит.Ключ,
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,ТекРеквизит.Значение),"");
				
			ЕстьОшибки = Истина;
				
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовФормы(Форма, Объект)

	УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект);
	УстановитьДоступностьДоговора(Форма, Объект);
	УстановитьДоступностьСвязанныхРеквизитовКонтрагента(Форма, Объект);
	УстановитьДоступностьКапвложения(Форма, Объект);
	УстановитьВидимостьСтраницыЦМОПодразделение(Форма, Объект);
	УстановитьВидимостьПараметровАмортизации(Форма, Объект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	МассивИменЭлементов = Новый Массив;
	МассивИменЭлементов.Добавить("РеквизитыЛицевогоСчета");
	МассивИменЭлементов.Добавить("ОсновноеСредство");
	МассивИменЭлементов.Добавить("ЦМО");
	МассивИменЭлементов.Добавить("Подразделение");
	МассивИменЭлементов.Добавить("ЦМООтправитель");
	МассивИменЭлементов.Добавить("ПодразделениеОтправитель");
	МассивИменЭлементов.Добавить("КФО");
	МассивИменЭлементов.Добавить("КПС");
	МассивИменЭлементов.Добавить("ВыбратьКомиссию");
	МассивИменЭлементов.Добавить("ВыбратьПредседателяКомиссии");
	МассивИменЭлементов.Добавить("СоставКомиссииПодобратьСотрудников");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "Доступность", ДоступностьЭлементов);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовКонтрагента(Форма, Объект)

	Форма.Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)

	Форма.Элементы.ДоговорКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКапвложения(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ВидПоступленияЗаполнен = ЗначениеЗаполнено(Объект.ВидПоступления);
	ЭтоПриобретениеИлиИзготовление = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
	
	Элементы.РассчитатьСуммуВложений.Доступность = ЭтоПриобретениеИлиИзготовление ИЛИ ЭтоПоступлениеИзПользования;
	
	Если ВидПоступленияЗаполнен 
		И (Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21")
			ИЛИ ЭтоПоступлениеИзПользования) Тогда
		Элементы.Количество.ТолькоПросмотр = Ложь;
		Элементы.Количество.ПропускатьПриВводе = Ложь;
	Иначе
		Элементы.Количество.ТолькоПросмотр = Истина;
		Элементы.Количество.ПропускатьПриВводе = Истина;
	КонецЕсли;
	
	МожноРедактироватьСтоимость = ВидПоступленияЗаполнен
		И (Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21"));
	Элементы.ПервоначальнаяСтоимость.ТолькоПросмотр       = Не МожноРедактироватьСтоимость;
	Элементы.ПервоначальнаяСтоимость.ПропускатьПриВводе   = Не МожноРедактироватьСтоимость;
	Элементы.ПервоначальнаяСтоимостьНУ.ТолькоПросмотр     = Не МожноРедактироватьСтоимость;
	Элементы.ПервоначальнаяСтоимостьНУ.ПропускатьПриВводе = Не МожноРедактироватьСтоимость;
	Элементы.РасходыНеУчитываетсяНУ.ТолькоПросмотр        = Не МожноРедактироватьСтоимость;
	Элементы.РасходыНеУчитываетсяНУ.ПропускатьПриВводе    = Не МожноРедактироватьСтоимость;
	Элементы.РасходыЕНВД.ТолькоПросмотр                   = Не МожноРедактироватьСтоимость;
	Элементы.РасходыЕНВД.ПропускатьПриВводе               = Не МожноРедактироватьСтоимость;
	
	Если ЭтоПриобретениеИлиИзготовление Тогда
		Элементы.Количество.АвтоотметкаНезаполненного = Истина;
		Элементы.Количество.ОтметкаНезаполненного = Объект.Количество = 0;
	Иначе
		Элементы.Количество.АвтоотметкаНезаполненного = Ложь;
		Элементы.Количество.ОтметкаНезаполненного = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровАмортизации(Форма, Объект)
	Перем ДоступностьГруппыСчетаЗатрат;

	Элементы = Форма.Элементы;
	
	Если НЕ ЗначениеЗаполнено(Форма.ОС_ВидНФА) 
		ИЛИ Форма.ОС_ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		Элементы.СрокПолезногоИспользования.Доступность						= Ложь;
		Элементы.ПорядокПогашенияСтоимости.Доступность						= Ложь;
		Элементы.СпособНачисленияАмортизации.Доступность					= Ложь;
		
		Элементы.НачислятьАмортизацию.Доступность							= Ложь;
	Иначе
		Элементы.СрокПолезногоИспользования.Доступность						= Истина;
		Элементы.ПорядокПогашенияСтоимости.Доступность						= Истина;
		
		УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	
						Объект.ПорядокПогашенияСтоимости,
						Элементы.СпособНачисленияАмортизации,
						ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));
		Элементы.НачислятьАмортизацию.Доступность = Объект.СпособНачисленияАмортизации 
									= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
	КонецЕсли;
	УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьГруппыСчетаЗатрат(Объект.ПорядокПогашенияСтоимости, 
																				 Элементы.ГруппаЗатратыПоАмортизации, 
																				 Форма,
																				 ДоступностьГруппыСчетаЗатрат);
	УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОчиститьСчетаУчета()
	
	Если ЭтаФорма.ТекущийВидПоступления <> Объект.ВидПоступления Тогда
		
		// Для вида операциии ПоступлениеНаСчет21 в реквизите СчетУчета указываются счета 21.ХХ,
		// при остальных видах операций - счета 101.ХХ, 102.ХХ, 103.ХХ, 01.ХХ, 02.ХХ.
		Если ЭтаФорма.ТекущийВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21")
		 ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
			Объект.СчетОС = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
			Объект.КПС = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтраницыЦМОПодразделение(Форма, Объект)

	НевидимыеЭлементы = Новый Массив;
	НевидимыеЭлементы.Добавить("ЦМООтправитель");
	НевидимыеЭлементы.Добавить("ПодразделениеОтправитель");
	НевидимыеЭлементы.Добавить("ВнеоборотныйАктив");
	НевидимыеЭлементы.Добавить("СчетКредита");
	
	ВидимыеЭлементы = Новый Массив;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Форма.Объект.ВидПоступления) Тогда
		ВидимыеЭлементы.Добавить("ЦМООтправитель");
		ВидимыеЭлементы.Добавить("ПодразделениеОтправитель");
	ИначеЕсли Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
		ИЛИ Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
	Иначе
		ВидимыеЭлементы.Добавить("ВнеоборотныйАктив");
		ВидимыеЭлементы.Добавить("СчетКредита");
	КонецЕсли;
	
	Для каждого Элемент Из ВидимыеЭлементы Цикл
	
		НевидимыеЭлементы.Удалить(НевидимыеЭлементы.Найти(Элемент));
	
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, НевидимыеЭлементы,
		"Видимость", Ложь);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ВидимыеЭлементы,
		"Видимость", Истина);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		Элементы.СтраницаПараметрыАмортизации.Видимость = Ложь;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		Элементы.СтраницаПараметрыАмортизации.Видимость = Истина;
		Элементы.АмортизацияСтраницы.ТекущаяСтраница = Элементы.АмортизацияСтраницаНеизменяется;
	Иначе
		Элементы.СтраницаПараметрыАмортизации.Видимость = Истина;
		Элементы.АмортизацияСтраницы.ТекущаяСтраница = Элементы.АмортизацияСтраницаДоступна;
	КонецЕсли;
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		СчетЗатратДоступен = Ложь;
	ИначеЕсли Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Элементы.СпособНачисленияАмортизацииСтраницы.ТекущаяСтраница = Элементы.СпособНачисленияАмортизацииСтраницаНачислять;
		СчетЗатратДоступен = Истина;
	ИначеЕсли Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
		Элементы.СпособНачисленияАмортизацииСтраницы.ТекущаяСтраница = Элементы.СпособНачисленияАмортизацииСтраницаСписывать;
		СчетЗатратДоступен = Истина;
	Иначе
		Элементы.СпособНачисленияАмортизацииСтраницы.ТекущаяСтраница = Элементы.СпособНачисленияАмортизацииСтраницаНеНачислять;
		СчетЗатратДоступен = Ложь;
	КонецЕсли;
	
	Если СчетЗатратДоступен Тогда
		Элементы.ЗатратыПоАмортизацииСтраницы.ТекущаяСтраница = Элементы.ЗатратыПоАмортизацииСтраницаДоступны;
	Иначе
		Элементы.ЗатратыПоАмортизацииСтраницы.ТекущаяСтраница = Элементы.ЗатратыПоАмортизацииСтраницаНедоступны;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет")
		ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет") Тогда
		СчетДляПроверки = ?(ЗначениеЗаполнено(Форма.СчетИмуществаВПользовании), Форма.СчетИмуществаВПользовании, "21");
	Иначе
		СчетДляПроверки = ?(ЗначениеЗаполнено(Объект.СчетОС), Объект.СчетОС, "101.00");
	КонецЕсли;
	
	ПараметрыСчетаУчета = ПолучитьПараметрыСчетаУчета(Форма, СчетДляПроверки);
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		ОбязательностьКПС = Истина;
		ОбязательностьПервональнойСтоимости = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
		ИЛИ УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		ОбязательностьКПС = ПараметрыСчетаУчета.УчетПоКПС;
		ОбязательностьПервональнойСтоимости = Ложь;
	Иначе
		ОбязательностьКПС = Ложь;
		ОбязательностьПервональнойСтоимости = Истина;
	КонецЕсли;

	Элементы.КПС.АвтоотметкаНезаполненного = ОбязательностьКПС;
	Если ОбязательностьКПС Тогда
		Элементы.КПС.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.КПС);
	Иначе
		Элементы.КПС.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Элементы.ПервоначальнаяСтоимость.АвтоотметкаНезаполненного = ОбязательностьПервональнойСтоимости;
	Если ОбязательностьПервональнойСтоимости Тогда
		Элементы.ПервоначальнаяСтоимость.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ПервоначальнаяСтоимость);
	Иначе
		Элементы.ПервоначальнаяСтоимость.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	ОбязательностьПодразделения = ПараметрыСчетаУчета.УчетПоПодразделениям;
	Элементы.ПодразделениеОтправитель.АвтоотметкаНезаполненного = ОбязательностьПодразделения;
	Элементы.Подразделение.АвтоотметкаНезаполненного = ОбязательностьПодразделения;
	Если ОбязательностьПодразделения Тогда
		Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ПодразделениеОтправитель);
		Элементы.Подразделение.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.Подразделение);
	Иначе
		Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного = Ложь;
		Элементы.Подразделение.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Если ПараметрыСчетаУчета.Контрагенты
	 ИЛИ УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		Элементы.Контрагент.АвтоотметкаНезаполненного = Истина;
		Элементы.Контрагент.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Контрагент);
	Иначе
		Элементы.Контрагент.АвтоотметкаНезаполненного = Ложь;
		Элементы.Контрагент.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Если ПараметрыСчетаУчета.Договоры Тогда
		Элементы.ДоговорКонтрагента.АвтоотметкаНезаполненного = Истина;
		Элементы.ДоговорКонтрагента.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.ДоговорКонтрагента);
	Иначе
		Элементы.ДоговорКонтрагента.АвтоотметкаНезаполненного = Ложь;
		Элементы.ДоговорКонтрагента.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьИнвентарногоНомера(Форма, Объект)

	ПределыОС = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПределыОС(Объект.Дата);

	ИнвНомерОбязательный = 
		(Форма.ОС_ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные")
		Или Форма.ОС_ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаБалансе")
		И Объект.ПервоначальнаяСтоимость > ПределыОС.ПервыйПределОС);
	
	Форма.Элементы.ОсновныеСредстваИнвентарныйНомер.АвтоОтметкаНезаполненного = ИнвНомерОбязательный;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетКонтрагента(Знач КонтрагентСсылка)
	
	Возврат Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(КонтрагентСсылка, "Документ.ПринятиеКУчетуОС");
	
КонецФункции

&НаКлиенте
Процедура УстановитьПорядокПогашенияСтоимостиПоУмолчанию(ТекущиеДанные)
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиент.УстановитьПорядокПогашенияСтоимости(
								Объект.ПорядокПогашенияСтоимости,
								Объект.СпособНачисленияАмортизации,
								Объект.НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации(Неопределено));
	
 	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
					Объект.СпособНачисленияАмортизации,
					Объект.НачислятьАмортизацию,
					ПараметрыВыбораПараметровНачисленияАмортизации(?(Объект.ОсновныеСредства.Количество()=0,Неопределено,Объект.ОсновныеСредства[0])));
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(ЭтаФорма);
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСчетИмуществаВПользовании(Форма, Объект)

	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления)
	   И ЗначениеЗаполнено(Объект.СчетОС) Тогда
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет") Тогда
			Форма.СчетИмуществаВПользовании = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.СчетПередачиОСВАренду(Объект.СчетОС);
		Иначе
			Форма.СчетИмуществаВПользовании = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.СчетПередачиОСВПользование(Объект.СчетОС);
		КонецЕсли;
		
		Форма.ТекстСчетИмуществаВПользовании = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru = 'Счет в пользовании: %1'"), Форма.СчетИмуществаВПользовании);
	Иначе
		Форма.ТекстСчетИмуществаВПользовании	= "";
		Форма.СчетИмуществаВПользовании			= Неопределено;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ТекстСчетИмуществаВПользовании",
		"Видимость", Не ПустаяСтрока(Форма.ТекстСчетИмуществаВПользовании));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыНачисленияАмортизацииОСвОперУчете()

	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		Объект.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСрокПолезногоИспользования()

	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
																							ОС_АмортизационнаяГруппа);
	Если Объект.СрокПолезногоИспользования = 0 ИЛИ СрокПолезногоИспользования <> 0 Тогда
		Объект.СрокПолезногоИспользования = СрокПолезногоИспользования;
	КонецЕсли;
	
	Если Объект.СрокПолезногоИспользованияНУ = 0 Тогда
		Объект.СрокПолезногоИспользованияНУ = Объект.СрокПолезногоИспользования;
	КонецЕсли;
	
	Если Объект.СрокПолезногоИспользованияУСН = 0 Тогда
		Объект.СрокПолезногоИспользованияУСН = Объект.СрокПолезногоИспользования;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСрокПолезногоИспользованияВГодах(Форма, Объект, ВидУчета = "Все")

	Если ВидУчета = "Все" ИЛИ ВидУчета = "БУ" Тогда
		Форма.СрокПолезногоИспользованияЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользования);
	КонецЕсли;
	
	Если ВидУчета = "Все" ИЛИ ВидУчета = "НУ" Тогда
		Форма.СрокПолезногоИспользованияНУЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияНУ);
	КонецЕсли;
	
	Если ВидУчета = "Все" ИЛИ ВидУчета = "УСН" Тогда
		Форма.СрокПолезногоИспользованияУСНЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияУСН);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьИнвентарныйНомер(Форма, Объект, ИдентификаторСтроки, ОчищатьПередУстановкой = Ложь)

	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ОчищатьПередУстановкой Тогда
		ТекущиеДанные.ИнвентарныйНомер = ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		
		ПараметрыСчетаУчета = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПараметрыСчетаУчетаИзФормы(Форма, Объект.ВидПоступления, Форма.ОС_ВидУчета);
		ДанныеОбъекта = ПолучитьПереданныйИнвентарныйНомерИСуммуПередачи(Объект, ТекущиеДанные, ПараметрыСчетаУчета, Истина, Форма.ИспользоватьУчетПоИФО, Форма.ИспользоватьУчетПоПодразделениям);
		ТекущиеДанные.ИнвентарныйНомер = ДанныеОбъекта.ИнвентарныйНомер;
		Объект.ПервоначальнаяСтоимость = ?(ДанныеОбъекта.Количество = 0, 0, ДанныеОбъекта.Сумма / ДанныеОбъекта.Количество);
		Объект.Количество = ДанныеОбъекта.Количество;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
			ТекущиеДанные.ИнвентарныйНомер = УправлениеОсновнымиСредствами.ПолучитьИнвентарныйНомерНеВЭкплуатации(
											ТекущиеДанные.ОсновноеСредство, Объект.Организация, ПериодПолученияОстатков(Объект), Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ИнвентарныйНомер"));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПереданныйИнвентарныйНомерИСуммуПередачи(Объект, ТекущиеДанные, ПараметрыСчетаУчета, УстанавливатьИнвНомер, Знач ИспользоватьУчетПоИФО, Знач ИспользоватьУчетПоПодразделениям)

	ПараметрыЗапроса = Новый Структура("Дата,ИФО,Контрагент,КПС,КФО,Организация,ПодразделениеОтправитель,ВидПоступления,ЦМООтправитель");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	ПараметрыЗапроса.Вставить("УчетПоКПС",							ПараметрыСчетаУчета.УчетПоКПС);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям И ПараметрыСчетаУчета.УчетПоПодразделениям);
	ПараметрыЗапроса.Вставить("Договор",							Объект.ДоговорКонтрагента);
	ПараметрыЗапроса.Вставить("Период",								ПериодПолученияОстатков(Объект));
	ПараметрыЗапроса.Вставить("ОсновноеСредство",					ТекущиеДанные.ОсновноеСредство);
	ПараметрыЗапроса.Вставить("ИнвентарныйНомер",					ТекущиеДанные.ИнвентарныйНомер);
	ИспользованныеИнвНомера = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ИнвентарныйНомер");
	ИндексТекущегоИнвНомера = ИспользованныеИнвНомера.Найти(ТекущиеДанные.ИнвентарныйНомер);
	Если ИндексТекущегоИнвНомера <> Неопределено Тогда
		ИспользованныеИнвНомера.Удалить(ИндексТекущегоИнвНомера);
	КонецЕсли;
	ПараметрыЗапроса.Вставить("ИспользованныеИнвНомера",			ИспользованныеИнвНомера);
	
	Возврат УправлениеОсновнымиСредствами.ПолучитьПереданныйИнвентарныйНомерИСуммуПередачи(ПараметрыЗапроса, ПараметрыСчетаУчета.Договоры, УстанавливатьИнвНомер);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПараметрыСчетаУчета(Форма, СчетОС)
	Перем ПараметрыСчета;
	
	Если ЗначениеЗаполнено(СчетОС) Тогда
		ПараметрыСчета = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПараметрыСчетаУчетаИзФормы(Форма,,,СчетОС);
	КонецЕсли;
	
	Возврат ПараметрыСчета;

КонецФункции

&НаКлиенте
Функция ПараметрыВыбораОбъектаВложений()

	СчетаВложений = БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("106.10,106.21,106.22,106.31,106.32,106.41,106.42,106.43");
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("СчетУчета",   СчетаВложений);
	
	Возврат Новый Структура("Отбор, ТекущаяСтрока, ПериодУчетныхДанных",
		Отбор, Объект.ВнеоборотныйАктив, Объект.Ссылка);
	
КонецФункции

&НаКлиенте
Функция ПараметрыВыбораОбъектаОС()

	ПараметрыФормыВыбора = Новый Структура;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация",	Объект.Организация);
	ПараметрыФормыВыбора.Вставить("Отбор", Отбор);
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;
	
	Возврат ПараметрыФормыВыбора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПериодПолученияОстатков(Объект)

	Возврат ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбнулитьСуммы(Объект)

	Объект.Количество                = 0;
	Объект.ПервоначальнаяСтоимость   = 0;
	Объект.ПервоначальнаяСтоимостьНУ = 0;
	Объект.РасходыНеУчитываетсяНУ    = 0;
	Объект.РасходыЕНВД               = 0;

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуВложений()

	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		
		ПараметрыСчетаУчета = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПараметрыСчетаУчетаИзФормы(ЭтаФорма, Объект.ВидПоступления, ЭтаФорма.ОС_ВидУчета);
		ПараметрыЗапроса = Новый Структура("Дата,ИФО,Контрагент,КПС,КФО,Организация,ПодразделениеОтправитель,ВидПоступления,ЦМООтправитель");
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
		ПараметрыЗапроса.Вставить("УчетПоКПС",							ПараметрыСчетаУчета.УчетПоКПС);
		ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
		ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям И ПараметрыСчетаУчета.УчетПоПодразделениям);
		ПараметрыЗапроса.Вставить("Договор",							Объект.ДоговорКонтрагента);
		ПараметрыЗапроса.Вставить("Период",								ПериодПолученияОстатков(Объект));
		ПараметрыЗапроса.Вставить("ТаблицаОС",							Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер"));
		ДанныеОС = УправлениеОсновнымиСредствами.ПолучитьПереданныйИнвентарныйНомерИСуммуПередачи(ПараметрыЗапроса, ПараметрыСчетаУчета.Договоры, Ложь, Истина);
		Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
		
			Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер", ТекСтр.ОсновноеСредство, ТекСтр.ИнвентарныйНомер);
			Строки = ДанныеОС.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда
				ТекСтр.ПервоначальнаяСтоимость = 0;
			Иначе
				ТекСтр.Количество = 1;
				ТекСтр.ПервоначальнаяСтоимость = ?(Строки[0].КоличествоОстатокЗаб = 0, 0, Строки[0].СуммаОстатокЗаб / Строки[0].КоличествоОстатокЗаб);
			КонецЕсли;
			
			РассчитатьСуммуТекущейСтроки(ТекСтр, Объект);
			
		КонецЦикла;
		
	Иначе
		
		ПараметрыОстатков = Новый Структура;
		ПараметрыОстатков.Вставить("ПериодОстатков", ПериодПолученияОстатков(Объект));
		ПараметрыОстатков.Вставить("Дата",           Объект.Дата);
		ПараметрыОстатков.Вставить("Организация",    Объект.Организация);
		ПараметрыОстатков.Вставить("Подразделение",  Объект.Подразделение);
		ПараметрыОстатков.Вставить("ИФО",            Объект.ИФО);
		ПараметрыОстатков.Вставить("КФО",            Объект.КФО);
		ПараметрыОстатков.Вставить("КПС",            Объект.КПС);
		ПараметрыОстатков.Вставить("ОбъектВложений", Объект.ВнеоборотныйАктив);
		ПараметрыОстатков.Вставить("СчетВложений",   Объект.СчетКредита);
		ОстаткиПоОбъектуВложений = УправлениеОсновнымиСредствами.ПолучитьОстаткиПоОбъектуВложенийВНФА(ПараметрыОстатков);
		
		Если Объект.ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление Тогда
			Объект.Количество = ОстаткиПоОбъектуВложений.Количество;
		КонецЕсли;
		
		Объект.ПервоначальнаяСтоимость   = ?(Объект.Количество = 0, 0, ОстаткиПоОбъектуВложений.Сумма                / Объект.Количество);
		Объект.ПервоначальнаяСтоимостьНУ = ?(Объект.Количество = 0, 0, ОстаткиПоОбъектуВложений.СуммаНУ              / Объект.Количество);
		Объект.РасходыНеУчитываетсяНУ    = ?(Объект.Количество = 0, 0, ОстаткиПоОбъектуВложений.СуммаНеУчитываетсяНУ / Объект.Количество);
		Объект.РасходыЕНВД               = ?(Объект.Количество = 0, 0, ОстаткиПоОбъектуВложений.СуммаЕНВД            / Объект.Количество);
		
		Для каждого СтрокаТабЧасти Из Объект.ОсновныеСредства Цикл
			РассчитатьСуммуТекущейСтроки(СтрокаТабЧасти, Объект,, ОстаткиПоОбъектуВложений.Количество, ОстаткиПоОбъектуВложений.Сумма);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетСуммыВложений(СообщатьОбОшибках, СообщатьОбИзмененииДаты = Истина)
	
	Если НЕ СообщатьОбИзмененииДаты Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ (Параметры.Ключ.Пустая() ИЛИ ЗаписаннаяДатаДокумента = Объект.Дата) Тогда
		
		 УправлениеОсновнымиСредствамиКлиент.ПроверитьЗаписатьПринятиеКУчетуПередРасчетомСтоимости(ЭтотОбъект, "ВыполнитьРасчетСуммыВложенийЗавершение", СообщатьОбОшибках);
		 
		 Возврат;
		 
	КонецЕсли;
	
	РасчетСуммыВложений(СообщатьОбОшибках) 

КонецПроцедуры

&НаКлиенте
Процедура РасчетСуммыВложений(СообщатьОбОшибках) 
	
	Перем Ошибки;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		Если ПроверитьЗаполнениеРеквизитов(ЭтаФорма, Объект, Ошибки) Тогда
			РассчитатьСуммуВложений();
		КонецЕсли;
	Иначе
		Если ПроверитьЗаполнениеРеквизитов(ЭтаФорма, Объект, Ошибки) Тогда
			РассчитатьСуммуВложений();
			УстановитьПорядокПогашенияСтоимостиПоУмолчанию(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Если СообщатьОбОшибках Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетСуммыВложенийЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Записать(Новый Структура("РежимЗаписи", ДопПараметры.РежимЗаписи));
	
	РасчетСуммыВложений(ДопПараметры.СообщатьОбОшибках);

КонецПроцедуры	

&НаКлиенте
Функция ПараметрыВыбораПараметровНачисленияАмортизации(Знач ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Если Объект.ОсновныеСредства.Количество() > 0 Тогда
			ТекущиеДанные = Объект.ОсновныеСредства[0];
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормыВыбора = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыФормыВыбора.ПорядокПогашенияСтоимости	= Объект.ПорядокПогашенияСтоимости;
	ПараметрыФормыВыбора.ДатаДокумента				= Объект.Дата;
	ПараметрыФормыВыбора.ВидНФА						= ОС_ВидНФА;
	ПараметрыФормыВыбора.ПоступлениеНаСчет21			= Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21");
	ПараметрыФормыВыбора.СчетУчета					= Объект.СчетОС;
	ПараметрыФормыВыбора.СчетУчетаЗабалансовый		= ОС_СчетУчета_Забалансовый;
	ПараметрыФормыВыбора.БиблФонд					= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(Объект.СчетОС);
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормыВыбора.ДатаВвода				= ТекущиеДанные.ДатаВводаВЭксплуатацию;
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101") Тогда
			Если ТекущиеДанные.ПервоначальнаяСтоимость <> 0 Тогда
				ПараметрыФормыВыбора.СтоимостьНФА	= ТекущиеДанные.ПервоначальнаяСтоимость;
			Иначе
				ПараметрыФормыВыбора.СтоимостьНФА	= Объект.ПервоначальнаяСтоимость;
			КонецЕсли;
		Иначе
			ПараметрыФормыВыбора.СтоимостьНФА		= Объект.ПервоначальнаяСтоимость;
		КонецЕсли;
	Иначе
		ПараметрыФормыВыбора.СтоимостьНФА			= Объект.ПервоначальнаяСтоимость;
	КонецЕсли;
	
	Возврат ПараметрыФормыВыбора;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);
	УправлениеОсновнымиСредствамиКлиент.ОбработатьИзменениеСубконто(Элемент, Объект, СтрокаДанных, НомерСубконто);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
														ДанныеВыбора, 
														СтандартнаяОбработка, 
														Объект.Организация,
														СтрокаДанных, 
														ТекНомерСубконто);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект)
	Перем МассивПолей;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КПС", "КПСЗатрат", "ЗаголовокКПСЗатрат", Ложь, "КПСЗатрат", Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КЭК", "КЭКЗатрат", "", Ложь, "КЭКЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ЗаголовокПодразделениеЗатрат", Ложь, "ПодразделениеЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьНеиспользуемыеРеквизитыПередЗаписью(Объект)
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект, СуммаВПодборе = 0, КоличествоПоДокументу = 0, СуммаПоДокументу = 0)

	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
		ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		Если СуммаВПодборе = 0 Тогда
			ТекущиеДанные.Сумма = ?(Объект.ПервоначальнаяСтоимость = 0, ТекущиеДанные.ПервоначальнаяСтоимость, Объект.ПервоначальнаяСтоимость)
									* ТекущиеДанные.Количество;
		Иначе
			ТекущиеДанные.Сумма = СуммаВПодборе;
		КонецЕсли;
	ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.ПервоначальнаяСтоимость * ТекущиеДанные.Количество;
	Иначе
		Если ТекущиеДанные.Количество = КоличествоПоДокументу Тогда
			ТекущиеДанные.Сумма = СуммаПоДокументу;
		Иначе
			ТекущиеДанные.Сумма = Объект.ПервоначальнаяСтоимость * ТекущиеДанные.Количество;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеДанныеВТабличнойЧасти()
	
	ЗначенияРеквизитов = УправлениеОсновнымиСредствами.ДанныеОбъектовОС(
		Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство"), Объект.Дата);
		
	Для Каждого ТекущиеДанные Из Объект.ОсновныеСредства Цикл
		ЗначенияРеквизитовОС = ЗначенияРеквизитов.Найти(ТекущиеДанные.ОсновноеСредство, "ОсновноеСредство");
		Если ЗначенияРеквизитовОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ЗначенияРеквизитовОС,
				"ГрупповойУчет, ПервоначальнаяСтоимость");
		КонецЕсли;
	КонецЦикла;		

КонецПроцедуры

&НаСервере
Процедура ОбработкаГрупповогоВводаОССервер(ВыбранноеЗначение)

	ТаблицаСозданныхОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	ПерваяДобавленнаяСтрока = Неопределено;
	Для каждого Строка Из ТаблицаСозданныхОС Цикл
	
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Сумма = Объект.ПервоначальнаяСтоимость;
		РассчитатьСуммуТекущейСтроки(НоваяСтрока, Объект);
		
		Если ПерваяДобавленнаяСтрока = Неопределено Тогда
			ПерваяДобавленнаяСтрока = НоваяСтрока;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ТаблицаСозданныхОС.Количество() > 0 Тогда
		ОсновноеСредствоПриИзмененииНаСервере(НоваяСтрока.ПолучитьИдентификатор());
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	
	ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОсновноеСредство");
	
	ПерваяСтрока = Истина;
	
	Объект.ОсновныеСредства.Очистить();
	Для каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		ЭлементКоллекции = Объект.ОсновныеСредства.Добавить();
		СтрокаИсходныхДанных = ИсходныеДанные.Найти(СтрокаТаблицыОС.ОсновноеСредство,"ОсновноеСредство");
		Если СтрокаИсходныхДанных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаИсходныхДанных);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
		
		ЭлементКоллекции.Количество = ?(ЭлементКоллекции.Количество=0, 1, ЭлементКоллекции.Количество);
		РассчитатьСуммуТекущейСтроки(ЭлементКоллекции, Объект, СтрокаТаблицыОС.Сумма);
		
		Если ПерваяСтрока Тогда
			ЗаполнитьРеквизитыФормыПоОбъектуОС(ЭтаФорма, Объект);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда 
		ТаблицаОС.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
		Для каждого ТекСтрока Из ТаблицаОС Цикл
			
			Если ЗначениеЗаполнено(ТекСтрока.ПервоначальнаяСтоимость) Тогда
				ТекСтрока.Цена = ТекСтрока.ПервоначальнаяСтоимость;
			ИначеЕсли ТекСтрока.Количество <> 0 Тогда
				ТекСтрока.Цена = ТекСтрока.Сумма / ТекСтрока.Количество;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции


#Область НалоговыйУчет

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)

	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете;
	
	Форма.Элементы.ГруппаНалоговыйУчет.Видимость                = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.Видимость = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ПервоначальнаяСтоимостьНУ.Доступность        = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РасходыНеУчитываетсяНУ.Доступность           = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РасходыЕНВД.Доступность                      = ВидимостьЭлементовНалоговогоУчета;
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(Форма)

	Если НЕ Форма.ОтражатьВНалоговомУчете Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
		И НЕ ЗначениеЗаполнено(Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ) Тогда
		Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы");
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
	ПорядокВключенияСтоимостиВСоставРасходовНУ = Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	ЭтоНачислениеАмортизации = (ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации"));
	ЭтоМатериальныеРасходы = (ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету"));
	НеВключатьВСоставРасходов = (ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы"));
	
	Если ЭтоНачислениеАмортизации Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУНачислениеАмортизации;
	ИначеЕсли ЭтоМатериальныеРасходы Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУВключениеВРасходыПриПринятииКУчету;
	ИначеЕсли НеВключатьВСоставРасходов Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУСтоимостьНеВключаетсяВРасходы;
	Иначе
		ТекущаяСтраница = Форма.Элементы.ГруппаНУПорядокВключенияСтоимостиВСоставРасходовНеУказан;
	КонецЕсли;
	Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = ТекущаяСтраница;
	
	УстановитьВидимостьСтатьиПрочихРасходов(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихРасходов(Форма)

	Объект = Форма.Объект;
	
	Если Форма.ОтражатьВНалоговомУчете
		И НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетУчетаЗатрат)
		И Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходов;
	Иначе
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходовНеТребуется;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Знач Объект)

	Если Объект.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)

	Форма.Элементы.ГруппаСтраницыПараметрыАмортизационнойПремии.ТекущаяСтраница =
		?(Форма.ВключитьАмортизационнуюПремиюВСоставРасходов,
			Форма.Элементы.ГруппаПараметрыАмортизационнойПремии,
			Форма.Элементы.ГруппаАмортизационнаяПремияНеИспользуется);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Объект)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеПоАмортизационнойПремии", "ЗаголовокПодразделение", Истина, "ПодразделениеПоАмортизационнойПремии", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоПоАмортизационнойПремии1", "ЗаголовокСубконто1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоПоАмортизационнойПремии2", "ЗаголовокСубконто2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоПоАмортизационнойПремии3", "ЗаголовокСубконто3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатратПоАмортизационнойПремии, Форма, Объект, МассивПолей);

КонецПроцедуры

#КонецОбласти

#Область УпрощеннаяСистемаНалогообложения

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчетаУСН(Форма)

	Форма.Элементы.ГруппаНалоговыйУчетУСН.Видимость = Форма.ОтражатьВУСНДоходыМинусРасходы;
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(Форма)

	Если НЕ Форма.ОтражатьВУСНДоходыМинусРасходы Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
		И НЕ ЗначениеЗаполнено(Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН) Тогда
		Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов");
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
	ПорядокВключенияСтоимостиВСоставРасходовУСН = Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН;
	ЭтоРасходыНаОСиНМА = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА"));
	ЭтоМатериальныеРасходы = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов"));
	НеВключатьВСоставРасходов = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов"));
	
	Если ЭтоРасходыНаОСиНМА Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаВключитьВСоставРасходовНаОСиНМАприУСН;
	ИначеЕсли ЭтоМатериальныеРасходы Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаВключитьВСоставМатериальныхРасходовУСН;
	ИначеЕсли НеВключатьВСоставРасходов Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНеВключатьВСоставРасходовУСН;
	Иначе
		ТекущаяСтраница = Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНеУказанУСН;
	КонецЕсли;
	Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН.ТекущаяСтраница = ТекущаяСтраница;

КонецПроцедуры

#КонецОбласти

