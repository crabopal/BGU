&НаКлиенте
Процедура КЭКЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатрат) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет затрат'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СчетУчетаЗатрат");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	ДанныеВыбора = Новый СписокЗначений;
	Если Лев(Строка(Объект.СчетУчетаЗатрат), 3) = "106" Тогда
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("340"));
	Иначе		
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("271"));
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

