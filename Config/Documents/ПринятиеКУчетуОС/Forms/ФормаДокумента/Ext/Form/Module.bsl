&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	ТекущаяДатаДокумента = Объект.Дата;
	ЗаписаннаяДатаДокумента = Объект.Дата;
	ТекущийВидПоступления = Объект.ВидПоступления;
	
	ЗаполнитьДополнительныеДанныеВТабличнойЧасти();
	ЗаполнитьРеквизитыФормыПриЧтении(ЭтаФорма, Объект);
	
	УстановитьДоступностьЭлементовФормы(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	ЭтаФорма.ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ЭтаФорма.ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	НедоступныеДанныеЦвет = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		НедоступныеДанныеЦвет);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст",			НСтр("ru = 'не заполняется для выбранного вида поступления или счета учета'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементОформления.Отбор.Элементы,,ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИЛИ, 
		"Объект.ВидПоступления", 
		Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101,
		ВидСравненияКомпоновкиДанных.НеРавно,,
		Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИЛИ, 
		"ОС_СчетУчета_Забалансовый", 
		Истина,
		ВидСравненияКомпоновкиДанных.Равно,,
		Истина);
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Использование = Истина;
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ОсновныеСредстваСуммаАмортизации");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		НедоступныеДанныеЦвет);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст",			НСтр("ru = 'не заполняется для выбранного вида поступления или счета учета'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, 
		"Объект.ВидПоступления", 
		Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21,
		ВидСравненияКомпоновкиДанных.НеРавно,,
		Истина);
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементОформления.Отбор.Элементы,,ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИЛИ, 
		"Объект.ВидПоступления", 
		Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101,
		ВидСравненияКомпоновкиДанных.НеРавно,,
		Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИЛИ, 
		"ОС_СчетУчета_Забалансовый", 
		Истина,
		ВидСравненияКомпоновкиДанных.Равно,,
		Истина);
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Использование = Истина;
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ОсновныеСредстваДатаВводаВЭксплуатацию");
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Использование = Истина;
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ОсновныеСредстваОставшийсяСрокПолезногоИспользования");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
