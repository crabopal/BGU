#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		Если ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
			Если Объект.ПервоначальнаяСтоимость = 0 Тогда
				ТекстПредупреждения = НСтр("ru='Не расчитана стоимость вложений.
										|Перед добавлением строк необходимо расчитать стоимость вложений'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения,,"Объект.ПервоначальнаяСтоимость",,Отказ);
			ИначеЕсли Объект.ОсновныеСредства.Итог("Количество") >= Объект.Количество Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В табличной части превышено доступное количество ОС'"),,"Объект.Количество",,Отказ);
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбран объект капитальных вложений'"),,"Объект.ВнеоборотныйАктив",,Отказ);
		КонецЕсли;
	Иначе
		Если Объект.Количество = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнено количество по документу'"),,"Объект.Количество",,Отказ);
		ИначеЕсли Объект.ОсновныеСредства.Итог("Количество") >= Объект.Количество Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В табличной части превышено доступное количество ОС'"),,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления)
	   И Не ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Перед выбором принимаемого к учету объекта необходимо выбрать объект капитальных вложений'"),,
			"Объект.ВнеоборотныйАктив");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если НоваяСтрока Тогда
		
		Если Копирование Тогда
			ТекущиеДанные.ИнвентарныйНомер = "";
			Если Не ТекущиеДанные.ГрупповойУчет Тогда
				ТекущиеДанные.ОсновноеСредство = "";
			Иначе
				ОсновноеСредствоПриИзмененииНаСервере(Элементы.ОсновныеСредства.ТекущиеДанные.ПолучитьИдентификатор());
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыВыбораОбъектаОС(), Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере(Элементы.ОсновныеСредства.ТекущиеДанные.ПолучитьИдентификатор());
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) ИЛИ Не ТекущиеДанные.ГрупповойУчет Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект);
	
	ОсновноеСредствоПриИзмененииНаКлиенте();

КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки)

	УстановитьИнвентарныйНомер(ЭтаФорма, Объект, ИдентификаторСтроки, Истина);
	
	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТекущаяСтрока.ГрупповойУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "ГрупповойУчет");
	
	Если Объект.ОсновныеСредства.Количество() = 1 Тогда
		ЗаполнитьРеквизитыФормыПоОбъектуОС(ЭтаФорма, Объект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзмененииНаКлиенте()

	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	УстановитьОбязательностьИнвентарногоНомера(ЭтаФорма, Объект);
	УстановитьСрокПолезногоИспользования();
	УстановитьСрокПолезногоИспользованияВГодах(ЭтаФорма, Объект);
	УправлениеОсновнымиСредствамиКлиент.УстановитьПорядокПогашенияСтоимости(
								Объект.ПорядокПогашенияСтоимости,
								Объект.СпособНачисленияАмортизации,
								Объект.НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации(Неопределено));
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
								Объект.СпособНачисленияАмортизации,
								Объект.НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации(Неопределено));
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(ЭтаФорма);
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Если НЕ ПустаяСтрока(Текст) Тогда
		ПараметрыФормыВыбора = ПараметрыВыбораОбъектаОС();
		ПараметрыФормыВыбора.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормыВыбора);
		СтандартнаяОбработка = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ПустаяСтрока(Текст) Тогда
		ПараметрыФормыВыбора = ПараметрыВыбораОбъектаОС();
		ПараметрыФормыВыбора.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормыВыбора);
		СтандартнаяОбработка = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ПараметрыФормы = Новый Структура("Отбор, НаДату, ТекущаяСтрока",
										Новый Структура("Владелец, ОС",
														Объект.Организация,
														ТекДанные.ОсновноеСредство),
										?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата),
										ТекДанные.ИнвентарныйНомер);
	
	//Параметры для формирования Инвентарных номеров
	ПараметрыФормы.Вставить("Дата",									Объект.Дата);
	ПараметрыФормы.Вставить("КФО",									Объект.КФО);
	ПараметрыФормы.Вставить("СчетУчета",							Объект.СчетОС);
	ПараметрыФормы.Вставить("КПС",									Объект.КПС);
	ПараметрыФормы.Вставить("Организация",							Объект.Организация);
	ПараметрыФормы.Вставить("ОсновноеСредство",						ТекДанные.ОсновноеСредство);
	ПараметрыФормы.Вставить("ИнвентарныйНомер",						ТекДанные.ИнвентарныйНомер);
	ПараметрыФормы.Вставить("ФормированиеИзДокумента",				Истина);
	ПараметрыФормы.Вставить("Регистратор",							Объект.Ссылка);
	ПараметрыФормы.Вставить("ФормированиеИнвНомераБезОбработки",	Ложь);
	ПараметрыФормы.Вставить("ПроверитьСоздатьИнвентарныйНомер",		Истина);
	ПараметрыФормы.Вставить("ПеренестиВсеНомера",					Истина);
	ПараметрыФормы.Вставить("ТЧОсновныеСредства",					Объект.ОсновныеСредства);
	
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", 		ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)	
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ЭтоПервый = Истина;
		Для Каждого СтрокаСписка Из ВыбранноеЗначение Цикл
			Если ЭтоПервый Тогда
				ЭтоПервый = Ложь;
				ТекДанные.ИнвентарныйНомер = СтрокаСписка.Значение;
				НоваяСтрока = ТекДанные;
			Иначе
				НоваяСтрока = Объект.ОсновныеСредства.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекДанные);
				НоваяСтрока.ИнвентарныйНомер = СтрокаСписка.Значение;
			КонецЕсли;			
			НоваяСтрока.Количество = 1;
			НоваяСтрока.Сумма = Объект.ПервоначальнаяСтоимость;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) ИЛИ Не ТекущиеДанные.ГрупповойУчет Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
	РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваДатаВводаВЭксплуатациюПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			ТекущиеДанные.ДатаВводаВЭксплуатацию, Объект.СрокПолезногоИспользования, Объект.Дата);
	
КонецПроцедуры

