////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДнейПосещенияКОплате 	= Параметры.ДнейПосещенияКОплате;
	ДнейПосещенияПоГрафику 	= Параметры.ДнейПосещенияПоГрафику;
	КонецПериода 			= Параметры.КонецПериода;
	Льгота 					= Параметры.Льгота;
	НачалоПериода 			= Параметры.НачалоПериода;
	СтавкаОплаты 			= Параметры.СтавкаОплаты;
	Долг					= Параметры.Задолженность;
		
	Если Льгота.Пустая() Тогда
		
		Элементы.ДекорацияЛьгота.Видимость 	= Истина;
		Элементы.Льгота.Видимость 			= Ложь;
		
	КонецЕсли; 
	
	СтруктураДанных = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(СтавкаОплаты, КонецПериода);
	
	Если СтруктураДанных.ЭтоФиксированнаяСтавкаЗаПериод = Истина Тогда
		
		Элементы.ДнейПосещенияКОплате.Видимость = Ложь;
		Элементы.ДнейПосещенияПоГрафику.Видимость = Ложь;
		
		КоличествоДнейПериода = День(КонецМесяца(КонецПериода));
		КоличествоДнейРасчета = День(КонецПериода) - День(НачалоПериода) + 1;
		
      	ТекстФормулыРасчета 	= "(Ставка / Дней в месяце * Дней расчета) ";
		ТекстФормулыЧисла 		= "(" + Строка(СтруктураДанных.СуммаНачисления) + " / " + Строка(КоличествоДнейПериода) + " * " + Строка(КоличествоДнейРасчета) + ")";
						 
		Если НЕ Льгота.Пустая() Тогда

			ТекстФормулыРасчета = ТекстФормулыРасчета + "* (100 - Процент льготы) / 100 ";
			ТекстФормулыЧисла 	= ТекстФормулыЧисла + " * (100 - " + Строка( ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Льгота, "ПроцентЛьготы")) + ") / 100";
			
		КонецЕсли; 						
		
		ТекстФормулыРасчета = ТекстФормулыРасчета + " + Долг на начало периода = Результат"; 
		
		СуммаСтавки 		= РаботаСоСтудентамиКлиентСервер.ПолучитьЗначениеСтавки(СтавкаОплаты,,, НачалоПериода, КонецПериода);
		КоэфЛьготы 			= РаботаСоСтудентамиПовтИсп.ПолучитьКоэффициентЛьготы(Льгота); 
		ТекстФормулыЧисла 	= ТекстФормулыЧисла + " = " + Строка(Формат(СуммаСтавки * КоэфЛьготы, "ЧЦ=15; ЧДЦ=2; ЧН=0"));
		
		Элементы.ДекорацияФормулаТекст.Заголовок = ТекстФормулыРасчета;
		Элементы.ДекорацияФормулаЧисла.Заголовок = ТекстФормулыЧисла;
		
	Иначе
		
		Элементы.КоличествоДнейПериода.Видимость = Ложь;
		Элементы.КоличествоДнейРасчета.Видимость = Ложь;
		
		Мультипликатор = Месяц(КонецПериода) - Месяц(НачалоПериода) + 1 + (Год(КонецПериода) - Год(НачалоПериода)) * 12;
		
		ТекстФормулыРасчета = "(Фиксированная ставка за месяц * Количество месяцев + 
								    |Переменная ставка за месяц * Количество месяцев * Дней посещения / Количество дней по графику+ 
								    |Ставка за день * Дней посещения) ";									
									
		ТекстФормулыЧисла = "(" + СтруктураДанных.СуммаФиксированнаяСтавкаЗаМесяц + " * " + Формат(Мультипликатор, "ЧЦ=2") + " + " 
		                        + СтруктураДанных.СуммаПеременнаяСтавкаЗаМесяц + " * " + Формат(Мультипликатор, "ЧЦ=2") + " * " 
								+ Формат(ДнейПосещенияКОплате, "ЧН=0") + " / " + Строка(Формат(ДнейПосещенияПоГрафику, "ЧН=0")) + " + "
						            + СтруктураДанных.СуммаСтавкаЗаДень + " * " + Строка(Формат(ДнейПосещенияКОплате, "ЧН=0")) + ")";
		
		Если НЕ Льгота.Пустая() Тогда

			ТекстФормулыРасчета = ТекстФормулыРасчета + "* (100 - Процент льготы) / 100 ";
			ТекстФормулыЧисла 	= ТекстФормулыЧисла + " * (100 - " + Строка( ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Льгота, "ПроцентЛьготы")) + ") / 100";
			
		КонецЕсли;
		
		ТекстФормулыРасчета = ТекстФормулыРасчета + " + Долг на начало периода = Результат"; 
		
		СуммаСтавки 		= РаботаСоСтудентамиКлиентСервер.ПолучитьЗначениеСтавки(СтавкаОплаты, ДнейПосещенияПоГрафику, ДнейПосещенияКОплате, НачалоПериода, КонецПериода);
		КоэфЛьготы 			= РаботаСоСтудентамиПовтИсп.ПолучитьКоэффициентЛьготы(Льгота); 
		ТекстФормулыЧисла 	= ТекстФормулыЧисла + " " + ?(Долг > 0, "+ ", "") + Формат(Долг, "ЧДЦ=2; ЧО=2") + " = " + Строка(Формат(СуммаСтавки * КоэфЛьготы + Долг , "ЧЦ=15; ЧДЦ=2; ЧН=0"));
		
		Элементы.ДекорацияФормулаТекст.Заголовок = ТекстФормулыРасчета;
		Элементы.ДекорацияФормулаЧисла.Заголовок = ТекстФормулыЧисла;
		
	КонецЕсли;
	
КонецПроцедуры