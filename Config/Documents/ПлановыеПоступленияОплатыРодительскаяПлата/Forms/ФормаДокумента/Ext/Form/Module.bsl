&НаКлиенте
Процедура ДетиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ДетиГруппаДетскогоУчреждения" Тогда
		ТекущиеДанные = Элементы.Дети.ТекущиеДанные;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Владелец", Объект.Организация);
		
		ОпределитьГруппыРебенка(Отбор, ТекущиеДанные.Ребенок, ТекущиеДанные.ДоговорКонтрагента,
			Объект.РодительскаяПлатаДопУслуги, Объект.НачалоПериода, Объект.КонецПериода);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Отбор);
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ГруппаДетскогоУчреждения);
		
		ОткрытьФорму("Справочник.ГруппыДетскогоУчреждения.Форма.ФормаВыбора", ПараметрыФормы, Элемент, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

