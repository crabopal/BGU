&НаКлиенте
Процедура ДетиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.Дети.ТекущиеДанные;
	
	Если НоваяСтрока Тогда 
		Если НЕ Копирование Тогда
		
			ТекущаяСтрока.НачалоПериода 			= Объект.НачалоПериода;               
			ТекущаяСтрока.КонецПериода 				= Объект.КонецПериода;
			ТекущаяСтрока.ДатаОплаты 				= Объект.ДатаОплаты;
			ТекущаяСтрока.ДнейПосещенияПоГрафику 	= ДнейПоГрафику;
			ТекущаяСтрока.ДнейПосещенияКОплате 		= ДнейПоГрафику;
			ТекущаяСтрока.ГруппаДетскогоУчреждения  = Объект.ГруппаДетскогоУчреждения;
		Иначе
			ТекущаяСтрока.ИДСтроки = "";
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДетиРебенокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Дети.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация",              Объект.Организация);
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения",
		?(ЗначениеЗаполнено(ТекущаяСтрока.ГруппаДетскогоУчреждения),
			ТекущаяСтрока.ГруппаДетскогоУчреждения,
			Объект.ГруппаДетскогоУчреждения));
	ПараметрыФормы.Вставить("НаДату",                   НачалоДня(Объект.НачалоПериода));
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Ребенок) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущаяСтрока.Ребенок);
	КонецЕсли;
	
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
	Иначе
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбораДопУслуги", ПараметрыФормы, Элемент);
	КонецЕсли;
КонецПроцедуры

