&НаКлиенте
Процедура ЗапроситьОчисткуТабличнойЧасти(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.СДополнительнымОтбором Тогда
		ОткрытьФормуОтбора();
	Иначе
		ЗаполнитьСпискомДетей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПользователяПослеПроверкиТЧ(Ответ, ДопПараметры) Экспорт
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		ВыполнитьСвертку = Неопределено;
		МассивКвитанций = Неопределено;
		
		Ответ.Свойство("ВыполнитьСвертку", ВыполнитьСвертку);
		Ответ.Свойство("МассивКвитанций", МассивКвитанций);
	
		Если ВыполнитьСвертку Тогда
			Попытка
				СвернутьПовторящиесяСтрокиСервер(МассивКвитанций);
			Исключение
				Ошибка = ИнформацияОбОшибке();
				ПричинаОшибки = Ошибка.Причина;
				
				ТекстСообщения = НСтр("ru='Не удалось выполнить свертку строк табличной части по причине:
										|%1'");
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПричинаОшибки));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

