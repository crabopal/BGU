&НаКлиенте
Процедура ПоказатьФормулуРасчета(Команда)
	
	ТекущаяСтрока = Элементы.Дети.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Если ТекущаяСтрока.СтавкаОплаты.Пустая() Тогда
			
			ПоказатьПредупреждение(, НСтр("ru='Не указана ставка оплаты!'"), 20);
			
		Иначе
			
			ПараметрыРасчета = Новый Структура("СтавкаОплаты, НачалоПериода, КонецПериода, Льгота, ДнейПосещенияКОплате,
												|ДнейПосещенияПоГрафику,Ребенок,ГруппаДетскогоУчреждения,
												|РодительскаяПлатаДопУслуги,Организация,ДоговорКонтрагента,Ребенок,Сумма");
			ЗаполнитьЗначенияСвойств(ПараметрыРасчета, ТекущаяСтрока);
			ПараметрыРасчета.Вставить("НастройкаРасчета", Объект.НастройкаРасчета);
			ПараметрыРасчета.Вставить("Организация", Объект.Организация);
			ПараметрыРасчета.Вставить("РежимОткрытияОкна", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ПараметрыРасчета.Вставить("Расчет", 0);
			ПараметрыРасчета.Вставить("СостояниеРасчетов", ТекущаяСтрока.Задолженность);
			
			ОткрытьФорму("Справочник.НастройкиРасчетовПоРодительскойПлате.Форма.ФормулаРасчета", ПараметрыРасчета);
			
		КонецЕсли; 
	
	КонецЕсли; 
		
КонецПроцедуры

