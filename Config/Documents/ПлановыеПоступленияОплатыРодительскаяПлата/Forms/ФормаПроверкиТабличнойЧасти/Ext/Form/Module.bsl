
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТабАннуляцииАдрес = Неопределено;
	ТабКвитанцийАдрес = Неопределено;
	
	Параметры.Свойство("ТаблицаСтрокАннуляции", ТабАннуляцииАдрес);
	Параметры.Свойство("ТаблицаСтрокКвитанций", ТабКвитанцийАдрес);
	
	Если ЗначениеЗаполнено(ТабАннуляцииАдрес) Тогда
		ТаблицаСтрокАннуляции.Загрузить(ПолучитьИзВременногоХранилища(ТабАннуляцииАдрес));
	КонецЕсли;
	Элементы.ГруппаТаблицаСтрокСАннуляцией.Видимость = ТаблицаСтрокАннуляции.Количество() > 0;
	
	Если ЗначениеЗаполнено(ТабКвитанцийАдрес) Тогда
		ТаблицаСтрокКвитанций.Загрузить(ПолучитьИзВременногоХранилища(ТабКвитанцийАдрес));
	КонецЕсли;
	Элементы.ГруппаТаблицаСтрокСКвитанциями.Видимость = ТаблицаСтрокКвитанций.Количество() > 0;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	ОтветФормы = Новый Структура;
	ОтветФормы.Вставить("ВыполнитьСвертку", Истина);
	ОтветФормы.Вставить("МассивКвитанций", МассивКвитанций());
	
	Закрыть(ОтветФормы); 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция МассивКвитанций()
	ТабКвитанций = РеквизитФормыВЗначение("ТаблицаСтрокКвитанций");
	
	Возврат ТабКвитанций.ВыгрузитьКолонку("Квитанция");
КонецФункции

#КонецОбласти
