#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	Для каждого СтрокаТЧ Из Дети Цикл
		
		Если НЕ СтрокаТЧ.Аннуляция Тогда
			
			ПроверитьРеквизитТЧ(СтрокаТЧ, "Ребенок", "Ребенок", Отказ);
			ПроверитьРеквизитТЧ(СтрокаТЧ, "Контрагент", "Контрагент", Отказ);
			ПроверитьРеквизитТЧ(СтрокаТЧ, "ДоговорКонтрагента", "Договор контрагента", Отказ);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ПроверитьДублиСтрок(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Ссылка.Пустая() Тогда
		УстановитьНовыеИдентификаторыСтрок();
	Иначе
		ПроверитьУстановитьИдентификаторыСтрок();
	КонецЕсли;
	
	СуммаДокумента = Дети.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.ПлановыеПоступленияОплатыРодительскаяПлата.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПлановыеДатыОплатыРодительскойПлаты");
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Для Каждого СтрТЧ Из Дети Цикл
		СтрТЧ.ИДСтроки = "";
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	Иначе
		ЗаполнитьИзДанныхЗаполнения(Новый Структура, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьНовыеИдентификаторыСтрок()

	МассивИдентификаторовСтрок = Новый Массив;
	Для Каждого СтрТЧ Из Дети Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки)
			ИЛИ МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки) <> Неопределено Тогда
			
			СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьУстановитьИдентификаторыСтрок()
	
	МассивИдентификаторовСтрок = Новый Массив;
	// Если ссылка не пустая, нужен анализ идентификаторов строк.
	// Т.к. возможна ситуация, когда строку скопировали, а исходную - удалили.
	// В этом случае нужно ранее присвоенные идентификаторы назначить новым строкам.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеРодительскойПлатыНачисления.НомерСтроки,
	|	НачислениеРодительскойПлатыНачисления.Ребенок КАК Учащийся,
	|	НачислениеРодительскойПлатыНачисления.Контрагент,
	|	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
	|	НачислениеРодительскойПлатыНачисления.ИДСтроки
	|ПОМЕСТИТЬ ТекущиеНачисления
	|ИЗ
	|	&Начисления КАК НачислениеРодительскойПлатыНачисления
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НачислениеРодительскойПлатыНачисления.НомерСтроки,
	|	НачислениеРодительскойПлатыНачисления.Ребенок КАК Учащийся,
	|	НачислениеРодительскойПлатыНачисления.Контрагент,
	|	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
	|	НачислениеРодительскойПлатыНачисления.ИДСтроки
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.ПлановыеПоступленияОплатыРодительскаяПлата.Дети КАК НачислениеРодительскойПлатыНачисления
	|ГДЕ
	|	НачислениеРодительскойПлатыНачисления.Ссылка = &Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТекущиеНачисления.НомерСтроки,
	|	ТекущиеНачисления.Учащийся,
	|	ТекущиеНачисления.Контрагент,
	|	ТекущиеНачисления.ДоговорКонтрагента,
	|	ТекущиеНачисления.ИДСтроки,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтрокиИсх,
	|	ДанныеДокумента.ИДСтроки КАК ИДСтрокиИсх,
	|	ДанныеДокумента.Учащийся КАК УчащийсяИсх,
	|	ДанныеДокумента.Контрагент КАК КонтрагентИсх,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагентаИсх
	|ПОМЕСТИТЬ СвязанныеТаблицы
	|ИЗ
	|	ТекущиеНачисления КАК ТекущиеНачисления
	|		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
	|		ПО ТекущиеНачисления.Учащийся = ДанныеДокумента.Учащийся
	|		И ТекущиеНачисления.Контрагент = ДанныеДокумента.Контрагент
	|		И ТекущиеНачисления.ДоговорКонтрагента = ДанныеДокумента.ДоговорКонтрагента
	|		И ТекущиеНачисления.ИДСтроки = ДанныеДокумента.ИДСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязанныеТаблицы.НомерСтрокиИсх,
	|	СвязанныеТаблицы.ИДСтрокиИсх,
	|	СвязанныеТаблицы.УчащийсяИсх,
	|	СвязанныеТаблицы.КонтрагентИсх,
	|	СвязанныеТаблицы.ДоговорКонтрагентаИсх
	|ПОМЕСТИТЬ СвободныеИдентификаторы
	|ИЗ
	|	СвязанныеТаблицы КАК СвязанныеТаблицы
	|ГДЕ
	|	СвязанныеТаблицы.НомерСтроки ЕСТЬ NULL
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязанныеТаблицы.НомерСтроки КАК НомерСтроки,
	|	СвободныеИдентификаторы.ИДСтрокиИсх
	|ИЗ
	|	СвязанныеТаблицы КАК СвязанныеТаблицы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвободныеИдентификаторы КАК СвободныеИдентификаторы
	|		ПО СвязанныеТаблицы.Учащийся = СвободныеИдентификаторы.УчащийсяИсх
	|		И СвязанныеТаблицы.Контрагент = СвободныеИдентификаторы.КонтрагентИсх
	|		И СвязанныеТаблицы.ДоговорКонтрагента = СвободныеИдентификаторы.ДоговорКонтрагентаИсх
	|ГДЕ
	|	СвязанныеТаблицы.НомерСтрокиИсх ЕСТЬ NULL
	|	И
	|	НЕ СвободныеИдентификаторы.ИДСтрокиИсх ЕСТЬ NULL
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Начисления",Дети.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Для Каждого СтрТЧ Из Дети Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
			Если Выборка.НайтиСледующий(Новый Структура("НомерСтроки",СтрТЧ.НомерСтроки)) Тогда
				УстановитьИдТекущейСтроки(СтрТч, МассивИдентификаторовСтрок, Выборка);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
		Иначе
			Если МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки) <> Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;
		МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьИдТекущейСтроки(СтрТч, МассивИдентификаторовСтрок, Выборка)
	ВыборкаДетальная = Выборка.Выбрать();
	Пока ВыборкаДетальная.Следующий() Цикл
		Если МассивИдентификаторовСтрок.Найти(ВыборкаДетальная.ИДСтрокиИсх) = Неопределено Тогда
			СтрТЧ.ИДСтроки = ВыборкаДетальная.ИДСтрокиИсх;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Дата", ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	НачалоПериода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "НачалоПериода", НачалоМесяца(Дата));
	КонецПериода  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "КонецПериода",  КонецМесяца(Дата));
	ДатаОплаты    = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "ДатаОплаты",    КонецПериода);
	РасчетЗаНесколькоМесяцев = НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода);

КонецПроцедуры

Процедура ПроверитьДублиСтрок(Отказ)
	
	ШаблонТекстДублей = НСтр("ru = 'Ребенок ""%1"" указан в списке более одного раза для даты оплаты %2 и группы ""%3""'");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Поступления.НомерСтроки,
	|	Поступления.Ребенок,
	|	Поступления.ДатаОплаты,
	|	Поступления.ГруппаДетскогоУчреждения
	|ПОМЕСТИТЬ Поступления
	|ИЗ
	|	&Поступления КАК Поступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Поступления.НомерСтроки) КАК НомерСтроки,
	|	Поступления.Ребенок,
	|	Поступления.ДатаОплаты,
	|	Поступления.ГруппаДетскогоУчреждения
	|ИЗ
	|	Поступления КАК Поступления
	|
	|СГРУППИРОВАТЬ ПО
	|	Поступления.Ребенок,
	|	Поступления.ДатаОплаты,
	|	Поступления.ГруппаДетскогоУчреждения
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1");
	
	Запрос.УстановитьПараметр("Поступления", Дети.Выгрузить(, "НомерСтроки, Ребенок, ДатаОплаты, ГруппаДетскогоУчреждения")) ;
	
	ВыборкаДублей = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДублей.Следующий() Цикл
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстДублей,
			ВыборкаДублей.Ребенок,
			Формат(ВыборкаДублей.ДатаОплаты, "ДЛФ=DD"),
			ВыборкаДублей.ГруппаДетскогоУчреждения
		);
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Дети", ВыборкаДублей.НомерСтроки, "Ребенок");
		
		ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект, Поле,, Отказ);
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПроверитьРеквизитТЧ(СтрокаТЧ, ИмяРеквизита, Представление, Отказ)
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]) Тогда
		
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", Представление, СтрокаТЧ.НомерСтроки, "Дети");
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Дети", СтрокаТЧ.НомерСтроки, ИмяРеквизита);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, Поле,, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли