&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Отложенные курсовые разницы (НУ).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУ");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУИзменение");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУПослеПереоценки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТаблицаПереоценки.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, Счета20500);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТаблицаПереоценки.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, Счета30200);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУИзменение");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУПослеПереоценки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТаблицаПереоценки.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, Счета20500);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТаблицаПереоценки.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, Счета30200);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление,
		ТаблицаПереоценкиПоляАналитикиСчета());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов(НовыйДокумент = Ложь)
	
	Если Элементы.ИФО.Видимость Тогда
		Элементы.ТаблицаПереоценкиИФО.Видимость = Не ЗначениеЗаполнено(Объект.ИФО);
	КонецЕсли;
	
	Если НовыйДокумент Или (Не НовыйДокумент И Не Объект.Проведен) Тогда
		СообщениеПользователю = "";
		Элементы.ГруппаАктуальностьКурсовВалют.Видимость = УстановитьАктуальностьКурсовВалют(СообщениеПользователю);
		Элементы.НадписьАктуальностьКурсовВалют.Заголовок = СообщениеПользователю;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КФО) Тогда
		ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
			И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО);
	Иначе
		ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	КонецЕсли;
	
	ОтложенныеКурсовыеРазницыНУ = Новый Массив;
	ОтложенныеКурсовыеРазницыНУ.Добавить("НадписьКурсовыеРазницыНУ");
	ОтложенныеКурсовыеРазницыНУ.Добавить("ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУ");
	ОтложенныеКурсовыеРазницыНУ.Добавить("ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУИзменение");
	ОтложенныеКурсовыеРазницыНУ.Добавить("ТаблицаПереоценкиОтложенныеКурсовыеРазницыНУПослеПереоценки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ОтложенныеКурсовыеРазницыНУ, "Видимость", ОтражатьВНалоговомУчете);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыПризнанияОтложенныхКурсовыхРазницНУ()
	
	// Федеральным законом от 26.03.2022 № 67-ФЗ предусмотрена возможность отложить до момента погашения задолженности
	// признание в базе по налогу на прибыль положительных и отрицательных курсовых разниц, возникших в 2022 - 2024 годах,
	// по требованиям и обязательствам в иностранной валюте (за исключением авансов).
	ДатаПереоценки = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	Если Год(ДатаПереоценки) = 2022 Тогда
		Объект.ОтложитьПоложительныеКурсовыеРазницыНУ = Истина;
		Объект.ОтложитьОтрицательныеКурсовыеРазницыНУ = Ложь;
	ИначеЕсли Год(ДатаПереоценки) = 2023 ИЛИ Год(ДатаПереоценки) = 2024 Тогда
		Объект.ОтложитьПоложительныеКурсовыеРазницыНУ = Истина;
		Объект.ОтложитьОтрицательныеКурсовыеРазницыНУ = Истина;
	Иначе
		Объект.ОтложитьПоложительныеКурсовыеРазницыНУ = Ложь;
		Объект.ОтложитьОтрицательныеКурсовыеРазницыНУ = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКурсВалютыВФормеДокумента()
	
	Если ЗначениеЗаполнено(Объект.Валюта) И НЕ Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
		Объект.Курс = КурсКратность.Курс;
		Объект.Кратность = КурсКратность.Кратность;
	Иначе
		Объект.Курс = 0;
		Объект.Кратность = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСубконто(ИмяЭлемента = "")
	Если ИмяЭлемента = "ТаблицаПереоценкиСчет" Тогда
		Счет = Элементы.ТаблицаПереоценки.ТекущиеДанные.Счет;
	Иначе
		Счет = Объект.Счет;
	КонецЕсли;
	
	ДоступныеСубконто = ОпределитьДоступныеСубконто(Счет);
	
	Для К = 0 По 2 Цикл
		Если К > ДоступныеСубконто.Количество() - 1 Тогда
			Элементы["ТаблицаПереоценкиСубконто"+(К+1)].ТолькоПросмотр = Истина;
		Иначе
			Элементы["ТаблицаПереоценкиСубконто"+(К+1)].ТолькоПросмотр = Ложь;
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ОпределитьДоступныеСубконто(Счет)
	Результат = Новый Массив;
	
	Для Каждого ВидСубконто Из Счет.ВидыСубконто Цикл
		Результат.Добавить(Истина);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьСписокВалютныхСчетов()
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ЕПСБУ.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Код В (""201.00"", ""204.00"", ""205.00"", ""207.00"", ""208.00"", ""209.00"", ""215.00"", ""301.00"", ""302.00""))
	|	И ЕПСБУ.Валютный
	|	И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) <> ""А""";
	Счета = Запрос.Выполнить();
	
	Если Не Счета.Пустой() Тогда
		Результат = Счета.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПроверитьВозможностьВыбораСубконто(Элемент, СтандартнаяОбработка)
	Индекс = Число(Прав(Элемент.Имя ,1)) - 1;
		
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		Счет = Объект.Счет;
	ИначеЕсли ЗначениеЗаполнено(Элементы.ТаблицаПереоценки.ТекущиеДанные.Счет) Тогда
		Счет = Элементы.ТаблицаПереоценки.ТекущиеДанные.Счет;
	КонецЕсли;
	
	Если Не МожноВыбратьСубконто(Счет, Индекс) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция МожноВыбратьСубконто(Счет, Индекс)
	Возврат Индекс <= Счет.ВидыСубконто.Количество() - 1;
КонецФункции

&НаСервере
Функция УстановитьАктуальностьКурсовВалют(СообщениеПользователю="")
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втВалюты
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.ЗагружаетсяИзИнтернета = ИСТИНА
	|	И Валюты.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВалюты КАК втВалюты
	|		ПО КурсыВалют.Валюта = втВалюты.Ссылка
	|ГДЕ
	|	КурсыВалют.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
	
	ДатаЗапроса = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаЗапроса);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить().Пустой();
	
	Если Результат Тогда
		Сообщение = НСтр("ru='Курсы валют актуальны на %1 Нажмите, чтобы обновить курсы валют.'");
		
		Курсы = РегистрыСведений.КурсыВалют.СрезПоследних(ДатаЗапроса);
		
		Если Курсы.Количество() > 0 Тогда
			СообщениеПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, Формат(Курсы[0].Период, "ДЛФ=DD"));	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Источник = РеквизитФормыВЗначение("Объект");
	Документы.ПереоценкаВалютныхОстатков.СформироватьДанныеДляПереоценки(Источник);
	ЗначениеВРеквизитФормы(Источник, "Объект");
	
	ТаблицаПереоценкиЗаполнитьДобавленныеКолонки();
	ОбновитьПризнакСуммаОтличаетсяОтРассчитанной();
	УправлениеВидимостьюГруппыОтличияОтРассчитанныхСумм(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбОчистке(Элемент, Источник, ПараметрыОткрытия = Неопределено)
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Элемент", Элемент);
	ДопПараметры.Вставить("Источник", Источник);
	ДопПараметры.Вставить("ПараметрыОткрытия", ПараметрыОткрытия);
	
	Если Объект.ТаблицаПереоценки.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ОчисткаПередВыборомЗначения", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru='Табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ОткрытьФормуВыбораЗначения(ДопПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораЗначения(ПараметрыВыбора)
	Владелец = ПараметрыВыбора.Элемент;
	Источник = ПараметрыВыбора.Источник;
	ПараметрыОткрытия = ПараметрыВыбора.ПараметрыОткрытия;
	
	ОткрытьФорму(Источник + ".ФормаВыбора", ПараметрыОткрытия, Владелец, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ОбновитьПризнакСуммаОтличаетсяОтРассчитанной()
	
	Для Каждого СтрокаПереоценка Из Объект.ТаблицаПереоценки Цикл
		ОбновитьПризнакСуммаОтличаетсяОтРассчитаннойВСтроке(СтрокаПереоценка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПризнакСуммаОтличаетсяОтРассчитаннойВСтроке(Строка)
	
	Строка.СуммаОтличаетсяОтРассчитанной = ?(
		Строка.СуммаПослеПереоценки = Окр(Строка.ВалютнаяСумма * Строка.Курс / Строка.Кратность, 2), Ложь, Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюГруппыОтличияОтРассчитанныхСумм(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаЕстьОтличияОтРассчитанныхСумм",
		"Видимость", ЕстьСтрокиССуммамиОтличающимисяОтРассчитанных(Форма.Объект.ТаблицаПереоценки));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьСтрокиССуммамиОтличающимисяОтРассчитанных(ТаблицаПереоценки)
	
	Для Каждого СтрокаПереоценка Из ТаблицаПереоценки Цикл
		Если СтрокаПереоценка.СуммаОтличаетсяОтРассчитанной Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
