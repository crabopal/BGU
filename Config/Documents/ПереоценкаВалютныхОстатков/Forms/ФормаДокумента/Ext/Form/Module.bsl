	ТекущиеДанные = Элементы.ТаблицаПереоценки.ТекущиеДанные;
	ТекущиеДанные.КурсоваяРазница = ТекущиеДанные.СуммаПослеПереоценки - ТекущиеДанные.СуммаТекущая;
	
	ТаблицаПереоценкиЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные,
		Объект.ОтложитьПоложительныеКурсовыеРазницыНУ, Объект.ОтложитьОтрицательныеКурсовыеРазницыНУ);
	
	ОбновитьПризнакСуммаОтличаетсяОтРассчитаннойВСтроке(ТекущиеДанные);
	УправлениеВидимостьюГруппыОтличияОтРассчитанныхСумм(ЭтотОбъект)
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаПереоценкиЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ТаблицаПереоценки Цикл
		
		ТаблицаПереоценкиЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы,
			Объект.ОтложитьПоложительныеКурсовыеРазницыНУ, Объект.ОтложитьОтрицательныеКурсовыеРазницыНУ);
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.Счет, ТаблицаПереоценкиПоляАналитикиСчета());
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ТаблицаПереоценкиЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы, ОтложитьПоложительныеКурсовыеРазницыНУ, ОтложитьОтрицательныеКурсовыеРазницыНУ)
	
	СтрокаТаблицы.ЗаголовокДоПереоценки    = НСтр("ru = 'До переоценки:'");
	СтрокаТаблицы.ЗаголовокИзменение       = НСтр("ru = 'Изменение:'");
	СтрокаТаблицы.ЗаголовокПослеПереоценки = НСтр("ru = 'После переоценки:'");
	
	СтрокаТаблицы.ЗаголовокКурс      = НСтр("ru = 'Курс:'");
	СтрокаТаблицы.ЗаголовокКратность = НСтр("ru = 'Кратность:'");
	
	ЭтоПоложительнаяКурсоваяРазница =
		(Форма.Счета20500.НайтиПоЗначению(СтрокаТаблицы.Счет) <> Неопределено И СтрокаТаблицы.КурсоваяРазница > 0) ИЛИ
		(Форма.Счета30200.НайтиПоЗначению(СтрокаТаблицы.Счет) <> Неопределено И СтрокаТаблицы.КурсоваяРазница < 0);
	
	ПогаситьКурсоваяРазница = ?(СтрокаТаблицы.КурсоваяРазница > 0, СтрокаТаблицы.КурсоваяРазница, -СтрокаТаблицы.КурсоваяРазница);
	
	СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение = 0;
	Если ЭтоПоложительнаяКурсоваяРазница Тогда
		Если СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУ < 0 Тогда // Есть доступная отложенная отрицательная курсовая разница.
			СписаноОтложенных = Мин(ПогаситьКурсоваяРазница, -СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУ);
			СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение = СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение + СписаноОтложенных;
			ПогаситьКурсоваяРазница = ПогаситьКурсоваяРазница - СписаноОтложенных;
		КонецЕсли;
		Если ПогаситьКурсоваяРазница > 0 И ОтложитьПоложительныеКурсовыеРазницыНУ Тогда // Есть остаток после зачета отложенных курсовых разниц.
			СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение = СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение + ПогаситьКурсоваяРазница;
		КонецЕсли;
	Иначе // Отрицательная.
		Если СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУ > 0 Тогда // Есть доступная отложенная положительная курсовая разница.
			СписаноОтложенных = Мин(ПогаситьКурсоваяРазница, СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУ);
			СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение = СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение - СписаноОтложенных;
			ПогаситьКурсоваяРазница = ПогаситьКурсоваяРазница - СписаноОтложенных;
		КонецЕсли;
		Если ПогаситьКурсоваяРазница > 0 И ОтложитьОтрицательныеКурсовыеРазницыНУ Тогда // Есть остаток после зачета отложенных курсовых разниц.
			СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение = СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение - ПогаситьКурсоваяРазница;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУПослеПереоценки = СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУ + СтрокаТаблицы.ОтложенныеКурсовыеРазницыНУИзменение;
	
КонецПроцедуры

