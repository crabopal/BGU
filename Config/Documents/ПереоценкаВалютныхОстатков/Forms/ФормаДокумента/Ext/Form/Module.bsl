&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Счета20500.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("205.00, 207.00, 209.00"));
	Счета30200.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("208.00, 301.00, 302.00"));
	
	ТаблицаПереоценкиЗаполнитьДобавленныеКолонки();
	
