Процедура СформироватьДанныеДляПереоценки(Источник) Экспорт
	
	Если ТипЗнч(Источник) <> Тип("ДокументОбъект.ПереоценкаВалютныхОстатков") Тогда
		Возврат;
	КонецЕсли;
	
	СКД = ПолучитьМакет("ПереоценкаВалюты");
	СКД.Параметры["НаДату"].Значение = Источник.Дата;
	СКД.Параметры["Организация"].Значение = Источник.Организация;
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Отборы = Настройки.Отбор.Элементы;
	
	УстановитьОтборы(Отборы, Источник);
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(СКД, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Источник.ТаблицаПереоценки.Очистить();
	Источник.ТаблицаПереоценки.Загрузить(Результат);
	
	Если НалоговыйУчет.ПлательщикНалогаНаПрибыль(Источник.Организация, Источник.Дата) Тогда
		
		// Остатки отложенных (до момента погашения задолженности) курсовых разниц на счетах Н92.01 и Н92.02.
		ПериодОстатков = ?(Источник.Ссылка.Пустая(), КонецДня(Источник.Дата), Новый Граница(Источник.МоментВремени(), ВидГраницы.Исключая));
		ТаблицаОтбора = Источник.ТаблицаПереоценки.Выгрузить(, "ИФО,КФО,Субконто1,Субконто2");
		ТаблицаОтбора.Колонки.Субконто1.Имя = "Контрагент";
		ТаблицаОтбора.Колонки.Субконто2.Имя = "Договор";
		ОтложенныеКурсовыеРазницыНУ = НалоговыйУчет.ОтложенныеКурсовыеРазницыНУ(ПериодОстатков, ТаблицаОтбора, Источник);
		
		Если ОтложенныеКурсовыеРазницыНУ.Количество() > 0 Тогда
		
			ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
			ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
			
			// Распределим отложенные курсовые разницы пропорционально остаткам задолженности.
			Для Каждого СтрокаКурсовыеРазницыНУ Из ОтложенныеКурсовыеРазницыНУ Цикл
				
				ОтборСтрок = Новый Структура("ИФО,КФО,КПС");
				ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаКурсовыеРазницыНУ);
				ОтборСтрок.Вставить("Субконто1", СтрокаКурсовыеРазницыНУ.Контрагент);
				ОтборСтрок.Вставить("Субконто2", ?(ЗначениеЗаполнено(СтрокаКурсовыеРазницыНУ.Договор), СтрокаКурсовыеРазницыНУ.Договор, Неопределено));
				НайденныеСтрокиЗадолженности = Источник.ТаблицаПереоценки.НайтиСтроки(ОтборСтрок);
				
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаКурсовыеРазницыНУ.ОстатокОтложенныхКурсовыхРазницНУ,
					НайденныеСтрокиЗадолженности, "ОтложенныеКурсовыеРазницыНУ", "ВалютнаяСумма", Ложь);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

