// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОтборы(Отборы, Источник)
	Для Каждого Отбор Из Отборы Цикл
		ИмяЭлемента = Строка(Отбор.ЛевоеЗначение);
		
		Если ИмяЭлемента = "ВалютнаяСумма" Тогда
			Отбор.Использование = Не Источник.ВключаяНулевыеВалютныеОстатки;
			Продолжить;
		КонецЕсли;
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента(ИмяЭлемента, Источник.Метаданные()) 
			И ЗначениеЗаполнено(Источник[ИмяЭлемента]) Тогда
			Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Отбор.Использование = Истина;
			Отбор.ПравоеЗначение = Источник[ИмяЭлемента];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
