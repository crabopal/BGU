		<query>ВЫБРАТЬ
	Счета.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВалютныеСчета
ИЗ
	ПланСчетов.ЕПСБУ КАК Счета
ГДЕ
	Счета.Ссылка В ИЕРАРХИИ
			(ВЫБРАТЬ
				Счета.Ссылка
			ИЗ
				ПланСчетов.ЕПСБУ КАК Счета
			ГДЕ
				Счета.Код В ("201.00", "204.00", "205.00", "207.00", "208.00", "209.00", "215.00", "301.00", "302.00"))
	И ПОДСТРОКА(Счета.Код, 6, 1) &lt;&gt; "А"
	И Счета.Валютный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Регистр.Счет КАК Счет,
	Регистр.Счет.Вид КАК ВидСчета,
	Регистр.Субконто1 КАК Субконто1,
	Регистр.Субконто2 КАК Субконто2,
	Регистр.Субконто3 КАК Субконто3,
	Регистр.Организация КАК Организация,
	Регистр.КПС КАК КПС,
	Регистр.ИФО КАК ИФО,
	Регистр.Валюта КАК Валюта,
	Регистр.Подразделение КАК Подразделение,
	Регистр.КФО КАК КФО,
	ВЫБОР
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА Регистр.СуммаОстатокДт
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА Регистр.СуммаОстатокКт
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
			ТОГДА ВЫБОР
					КОГДА Регистр.ВалютнаяСуммаОстаток = 0
						ТОГДА Регистр.СуммаОстаток
					КОГДА ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "208"
						ТОГДА Регистр.СуммаОстатокКт
					КОГДА ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "205"
							ИЛИ ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "209"
						ТОГДА Регистр.СуммаОстатокДт
				КОНЕЦ
	КОНЕЦ КАК СуммаТекущая,
	ВЫБОР
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА Регистр.ВалютнаяСуммаОстатокДт
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА Регистр.ВалютнаяСуммаОстатокКт
		КОГДА Регистр.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
			ТОГДА ВЫБОР
					КОГДА ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "208"
						ТОГДА Регистр.ВалютнаяСуммаОстатокКт
					КОГДА ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "205"
							ИЛИ ПОДСТРОКА(Регистр.Счет.Код, 1, 3) = "209"
						ТОГДА Регистр.ВалютнаяСуммаОстатокДт
				КОНЕЦ
	КОНЕЦ КАК ВалютнаяСумма
ПОМЕСТИТЬ ВТПереоценка
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			&amp;НаДату,
			Счет В
				(ВЫБРАТЬ
					ВалютныеСчета.Ссылка
				ИЗ
					ВалютныеСчета),
			,
			Организация = &amp;Организация
				И Валюта &lt;&gt; ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Регистр
;

