ВЫБРАТЬ
	ВТПереоценка.Счет КАК Счет,
	ВТПереоценка.Счет.Вид КАК ВидСчета,
	ВТПереоценка.Субконто1 КАК Субконто1,
	ВТПереоценка.Субконто2 КАК Субконто2,
	ВТПереоценка.Субконто3 КАК Субконто3,
	ВТПереоценка.Организация КАК Организация,
	ВТПереоценка.КПС КАК КПС,
	ВТПереоценка.ИФО КАК ИФО,
	ВТПереоценка.Валюта КАК Валюта,
	ВТПереоценка.Подразделение КАК Подразделение,
	ВТПереоценка.КФО КАК КФО,
	ВТПереоценка.СуммаТекущая КАК СуммаТекущая,
	ВТПереоценка.ВалютнаяСумма КАК ВалютнаяСумма,
	КурсыВалют.Курс КАК Курс,
	КурсыВалют.Кратность КАК Кратность,
	ВТПереоценка.ВалютнаяСумма * КурсыВалют.Курс / КурсыВалют.Кратность КАК СуммаПослеПереоценки,
	ВТПереоценка.ВалютнаяСумма * КурсыВалют.Курс / КурсыВалют.Кратность - ВТПереоценка.СуммаТекущая КАК КурсоваяРазница
{ВЫБРАТЬ
	Счет.*,
	ВидСчета,
	Субконто1.*,
	Субконто2.*,
	Субконто3.*,
	Организация.*,
	КПС.*,
	ИФО.*,
	Валюта.*,
	Курс,
	Кратность,
	Подразделение.*,
	КФО.*,
	СуммаТекущая,
	ВалютнаяСумма,
	СуммаПослеПереоценки,
	КурсоваяРазница}
ИЗ
	ВТПереоценка КАК ВТПереоценка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;НаДату, ) КАК КурсыВалют
		ПО ВТПереоценка.Валюта = КурсыВалют.Валюта
ГДЕ
	(ВЫРАЗИТЬ(ВТПереоценка.ВалютнаяСумма * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(18, 2))) - ВТПереоценка.СуммаТекущая &lt;&gt; 0
{ГДЕ
	ВТПереоценка.Счет.*,
	ВТПереоценка.Субконто1.*,
	ВТПереоценка.Субконто2.*,
	ВТПереоценка.Субконто3.*,
	ВТПереоценка.Организация.*,
	ВТПереоценка.КПС.*,
	ВТПереоценка.ИФО.*,
	ВТПереоценка.Валюта.*,
	ВТПереоценка.Подразделение.*,
	ВТПереоценка.КФО.*,
	ВТПереоценка.ВалютнаяСумма КАК ВалютнаяСумма}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
