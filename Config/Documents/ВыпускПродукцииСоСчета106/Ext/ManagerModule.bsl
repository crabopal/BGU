КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Выпуск продукции");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.Ссылка.Организация,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.ВидДрагМатериала,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.ЕдИзм
	 |ИЗ
	 |	Документ.ВыпускПродукцииСоСчета106.ДрагоценныеМатериалы КАК ВыпускПродукцииСоСчета106ДрагоценныеМатериалы
	 |ГДЕ
	 |	ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ВыпускПродукцииСоСчета106ДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
 
КонецПроцедуры	

// Структура таблицы источника данных "Выпуск продукции со счета 106.хИ".
//
Функция ПустаяТаблицаВыпускПродукцииСоСчета106() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Счет и аналитика учета готовой продукции (материальные запасы).
	ПустаяТаблица.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("СчетГотовойПродукции",    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСГотовойПродукции",     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКГотовойПродукции",     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	// Счет и аналитика учета себестоимости готовой продукции (затраты).
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",         Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("КПСЗатрат",         Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоЗатрат", ОписаниеТиповСубконто); // Реквизит ДополнительноеСубконто106 табчасти.
	// Количество и сумма выпущенных единиц.
	ПустаяТаблица.Колонки.Добавить("Количество", ОписаниеТипаКоличества); // Заполняется только в первой строке
																		// для каждой выпущенной позиции номенклатуры.
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Выпуск продукции со счета 106.хИ".
//
Функция ТаблицаВыпускПродукцииСоСчета106(ДокументСсылка) Экспорт
	
	ТаблицаВыпускПродукции = ПустаяТаблицаВыпускПродукцииСоСчета106();
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаВыпускПродукции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Продукция.Ссылка КАК Ссылка,
	|	""Продукция"" КАК ИмяСписка,
	|	""Продукция"" КАК СинонимСписка,
	|	Продукция.НомерСтроки КАК НомерСтроки,
	|	Продукция.Номенклатура КАК Номенклатура,
	|	Продукция.СчетУчета КАК СчетГотовойПродукции,
	|	Продукция.КПСДебета КАК КПСГотовойПродукции,
	|	Продукция.КЭКДебета КАК КЭКГотовойПродукции,
	|	Продукция.ДополнительнаяАналитикаСчета КАК ДопАналитика,
	|	Продукция.Количество КАК КоличествоВыпущено,
	|	Затраты.ВидЗатрат КАК ВидЗатрат,
	|	Затраты.КПСЗатрат КАК КПСЗатрат,
	|	Затраты.ДополнительноеСубконто106 КАК ДопСубконтоЗатрат,
	|	Затраты.Сумма
	|ИЗ
	|	Документ.ВыпускПродукцииСоСчета106.Продукция КАК Продукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукцииСоСчета106.Затраты КАК Затраты
	|		ПО Продукция.ИдСтроки = Затраты.ИдСтроки
	|ГДЕ
	|	Продукция.Ссылка = &Ссылка
	|	И Затраты.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продукция.НомерСтроки,
	|	Затраты.НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(КоличествоВыпущено)
	|ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	
	ВыборкаПоНоменклатуре = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоНоменклатуре.Следующий() Цикл
		
		КоличествоВыпущено = ВыборкаПоНоменклатуре.КоличествоВыпущено;
		
		ВыборкаЗатрат = ВыборкаПоНоменклатуре.Выбрать();
		Пока ВыборкаЗатрат.Следующий() Цикл
			
			НоваяСтрока = ТаблицаВыпускПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗатрат);
			
			НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(НоваяСтрока.СчетГотовойПродукции);
			
			// Все выпущенное количество в первой строке для каждой выпущенной позиции номенклатуры.
			Если НоваяСтрока.Сумма <> 0 Тогда
				НоваяСтрока.Количество = КоличествоВыпущено;
				КоличествоВыпущено = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаВыпускПродукции;
	
КонецФункции

// Структура таблицы источника данных "Выпуск продукции со счета 106.хИ (НУ)".
//
Функция ПустаяТаблицаВыпускПродукцииСоСчета106НУ() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Счет и аналитика учета готовой продукции (материальные запасы).
	ПустаяТаблица.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("СчетГотовойПродукции",    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСГотовойПродукции",     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	// Счет и аналитика учета себестоимости готовой продукции (затраты).
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоЗатрат",       ОписаниеТиповСубконто); // Реквизит ДополнительноеСубконто табчасти.
	// Количество и сумма выпущенных единиц.
	ПустаяТаблица.Колонки.Добавить("Количество", ОписаниеТипаКоличества); // Заполняется только в первой строке
																		// для каждой выпущенной позиции номенклатуры.
	ПустаяТаблица.Колонки.Добавить("СуммаНУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВД",            ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Выпуск продукции со счета 106.хИ (НУ)".
//
Функция ТаблицаВыпускПродукцииСоСчета106НУ(ДокументСсылка) Экспорт
	
	ТаблицаВыпускПродукции = ПустаяТаблицаВыпускПродукцииСоСчета106НУ();
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаВыпускПродукции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Продукция.Ссылка КАК Ссылка,
	|	""Продукция"" КАК ИмяСписка,
	|	""Продукция"" КАК СинонимСписка,
	|	Продукция.НомерСтроки КАК НомерСтроки,
	|	Продукция.Номенклатура КАК Номенклатура,
	|	Продукция.СчетУчета КАК СчетГотовойПродукции,
	|	Продукция.КПСДебета КАК КПСГотовойПродукции,
	|	Продукция.ДополнительнаяАналитикаСчета КАК ДопАналитика,
	|	Продукция.Количество КАК КоличествоВыпущено,
	|	ЗатратыНУ.ВидЗатрат КАК ВидЗатрат,
	|	ЗатратыНУ.ДополнительноеСубконто КАК ДопСубконтоЗатрат,
	|	ЗатратыНУ.СуммаНУ,
	|	ЗатратыНУ.СуммаНеУчитываетсяНУ,
	|	ЗатратыНУ.СуммаЕНВД
	|ИЗ
	|	Документ.ВыпускПродукцииСоСчета106.Продукция КАК Продукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукцииСоСчета106.ЗатратыНУ КАК ЗатратыНУ
	|		ПО Продукция.ИдСтроки = ЗатратыНУ.ИдСтроки
	|ГДЕ
	|	Продукция.Ссылка = &Ссылка
	|	И ЗатратыНУ.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Продукция.НомерСтроки,
	|	ЗатратыНУ.НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(КоличествоВыпущено)
	|ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	
	ВыборкаПоНоменклатуре = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоНоменклатуре.Следующий() Цикл
		
		КоличествоВыпущеноНУ = ВыборкаПоНоменклатуре.КоличествоВыпущено;
		
		ВыборкаЗатрат = ВыборкаПоНоменклатуре.Выбрать();
		Пока ВыборкаЗатрат.Следующий() Цикл
			
			НоваяСтрока = ТаблицаВыпускПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗатрат);
			
			НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(НоваяСтрока.СчетГотовойПродукции);
			
			// Все выпущенное количество в первой строке для каждой выпущенной позиции номенклатуры.
			Если НоваяСтрока.СуммаНУ <> 0 ИЛИ НоваяСтрока.СуммаНеУчитываетсяНУ <> 0 ИЛИ НоваяСтрока.СуммаЕНВД <> 0 Тогда
				НоваяСтрока.Количество = КоличествоВыпущеноНУ;
				КоличествоВыпущеноНУ = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаВыпускПродукции;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
