#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	НепроверяемыеРеквизиты = Новый Массив;
	
	Если НЕ ИспользоватьУчетПоПодразделениямНаСчетах105() Тогда
		НепроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	Если НЕ ИспользоватьУчетПоПодразделениямНаСчете106() Тогда
		НепроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
	КонецЕсли;
	
	Если НЕ БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СчетПроизводства, ПланыВидовХарактеристик.ВидыСубконто.ЦМО) Тогда
		НепроверяемыеРеквизиты.Добавить("ЦМООтправитель");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);

	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Продукция.Итог("Сумма");
	
	// Удалим лишние строки из табчастях "Затраты".
	ДействующиеИд = Продукция.ВыгрузитьКолонку("ИдСтроки");
	СтрокиКУдалению = Новый Массив;
	Для каждого СтрокаЗатрат Из Затраты Цикл
		Если ДействующиеИд.Найти(СтрокаЗатрат.ИдСтроки) = Неопределено Тогда
			СтрокиКУдалению.Добавить(СтрокаЗатрат);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрока Из СтрокиКУдалению Цикл
		Затраты.Удалить(ТекСтрока);
	КонецЦикла;
	
	// Удалим лишние строки из табчастях "Затраты НУ".
	СтрокиКУдалению = Новый Массив;
	Для каждого СтрокаЗатрат Из ЗатратыНУ Цикл
		Если ДействующиеИд.Найти(СтрокаЗатрат.ИдСтроки) = Неопределено Тогда
			СтрокиКУдалению.Добавить(СтрокаЗатрат);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрока Из СтрокиКУдалению Цикл
		ЗатратыНУ.Удалить(ТекСтрока);
	КонецЦикла;
	
	ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, "Продукция", "Оприходование комплекта", Отказ);
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Продукция", Истина);
	ПрослеживаемостьБГУ.СписаниеМЗПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи, "Продукция");
	ОбщегоНазначенияБГУ.ЗаполнитьИдентификаторыСтрок(Продукция, Ложь);
			
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИспользоватьУчетПоПодразделениямНаСчетах105()
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УчетПоПодразделениямНаСчетах = Новый Соответствие;
	Для Каждого Строка Из Продукция Цикл
		УчетПоПодразделениямНаСчете = УчетПоПодразделениямНаСчетах.Получить(Строка.СчетУчета);
		Если УчетПоПодразделениямНаСчете = Неопределено Тогда
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетУчета);
			УчетПоПодразделениямНаСчете = СвойстваСчета.УчетПоПодразделениям И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение;
			УчетПоПодразделениямНаСчетах.Вставить(Строка.СчетУчета, УчетПоПодразделениямНаСчете);
		КонецЕсли;
		Если УчетПоПодразделениямНаСчете Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИспользоватьУчетПоПодразделениямНаСчете106()
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") ИЛИ НЕ ЗначениеЗаполнено(СчетПроизводства)Тогда
		Возврат Ложь;
	КонецЕсли;

	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПроизводства);
	
	Возврат СвойстваСчета.УчетПоПодразделениям И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Продукция.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Продукция"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли
