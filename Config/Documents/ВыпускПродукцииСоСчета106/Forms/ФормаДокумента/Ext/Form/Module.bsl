&НаСервере
Процедура РассчитатьПрослеживаемыеТовары()
	
	СтрокиПТ = Объект.Продукция.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	ЕстьПрослеживаемыеТовары   = СтрокиПТ.Количество();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПрослеживаемости(Форма)
	
	Элементы = Форма.Элементы;
	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	
	ИменаЭлементовДвиженияПрослеживаемости = Новый Массив;
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("ПродукцияПрослеживаемыйТовар");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("ПродукцияРНПТ");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("ПродукцияПТ");
    ИменаЭлементовДвиженияПрослеживаемости.Добавить("ПродукцияСтранаПроисхождения");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовДвиженияПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
		
КонецПроцедуры

