		Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗатратыНУЗавершение", ЭтотОбъект, ТекущиеДанные);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоОстаткам(ТекущиеДанные.ПолучитьИдентификатор(), "НУ");
	КонецЕсли;

КонецПроцедуры

