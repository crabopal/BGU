&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СчетПроизводства) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Счет производства'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.СчетПроизводства");
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		СвойстваСчета106 = СвойстваСчета(Объект.СчетПроизводства);
		Если СвойстваСчета106.УчетПоПодразделениям
		И НЕ СвойстваСчета106.РазрешитьНеУказыватьПодразделение
		И НЕ ЗначениеЗаполнено(Объект.ПодразделениеОтправитель) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Подразделение (отправитель)'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ПодразделениеОтправитель");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Продукция.Количество() > 0
	 ИЛИ Объект.Затраты.Количество() > 0
	 ИЛИ Объект.ЗатратыНУ.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		
		ЗаполнитьПоОстаткам();
		
		Если Объект.Продукция.Количество() > 0 Тогда
			Элементы.Продукция.ТекущаяСтрока = Объект.Продукция[0].ПолучитьИдентификатор();
			ПродукцияОбработкаИзмененияТекущейСтроки();
			РассчитатьПрослеживаемыеТовары();
			УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗатраты(Команда)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	Если СтрокаПродукцииНеАктивизирована(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	Если Объект.Затраты.НайтиСтроки(СтруктураПоиска).Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Перезаполнить затраты по выбранной позиции номенклатуры?'");
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗатратыЗавершение", ЭтотОбъект, ТекущиеДанные);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоОстаткам(ТекущиеДанные.ПолучитьИдентификатор(), "БУ");
	КонецЕсли;

КонецПроцедуры

