&НаСервере
Процедура ПодготовитьФормуНаСервере()

	УстановитьФункциональныеОпцииФормы();
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "Продукция");
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		Объект.Организация, Объект.Дата, Объект.КФО);
	
	ВалютаРубли = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект,
		Объект, "Продукция");
	ПродукцияЗаполнитьДобавленныеКолонки();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтотОбъект, Объект);
	ТекущийИдСтроки = ПолучитьНовыйИдСтроки();
	УстановитьВидимостьДополнительногоСубконто("БУ");
	УстановитьВидимостьДополнительногоСубконто("НУ");
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтотОбъект);
	БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Элементы.БухгалтерскаяОперация);
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	РассчитатьПрослеживаемыеТовары();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	Элементы.ПодразделениеПолучатель.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЦМОПолучатель.Доступность				= ЗначениеЗаполнено(Объект.Организация);
	Элементы.КПСПроизводства.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	Элементы.КФО.Доступность						= ЗначениеЗаполнено(Объект.Организация);
	Элементы.СчетПроизводства.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	Элементы.КЭКПроизводства.Доступность			= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДополнительногоСубконто(ВидУчета = "БУ")

	Если ВидУчета = "БУ" Тогда
		СчетПроизводства = Объект.СчетПроизводства;
		ИмяПоляДопСубконто = "ЗатратыДополнительноеСубконто106";
	Иначе // "НУ"
		СчетПроизводства = ?(ОтражатьВНалоговомУчете,
			БухгалтерскийУчет.СчетПоКоду("Н20.01", Объект.Дата, Объект.Организация),
			ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
		ИмяПоляДопСубконто = "ЗатратыНУДополнительноеСубконто";
	КонецЕсли;
	
	ВидДопСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	Если ЗначениеЗаполнено(СчетПроизводства) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕПСБУВидыСубконто.ВидСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.Ссылка = &СчетПроизводства
		|	И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		|	И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
		|	И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)";
		Запрос.УстановитьПараметр("СчетПроизводства", СчетПроизводства);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВидДопСубконто = Выборка.ВидСубконто;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы[ИмяПоляДопСубконто].Видимость = ЗначениеЗаполнено(ВидДопСубконто);
	Если ЗначениеЗаполнено(ВидДопСубконто) Тогда
		Элементы[ИмяПоляДопСубконто].ОграничениеТипа = ВидДопСубконто.ТипЗначения;
		Элементы[ИмяПоляДопСубконто].Заголовок = ВидДопСубконто.Наименование;
	КонецЕсли;
	
	Если ВидУчета = "БУ" Тогда // Считаем, что на счетах БУ и НУ одни и те же настройки учета по подразделениям.
		
		Элементы.ПодразделениеОтправитель.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного = Ложь;
		
		Если ЗначениеЗаполнено(Объект.СчетПроизводства)
			И ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетПроизводства);
			Если СвойстваСчета.УчетПоПодразделениям И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение Тогда
				Элементы.ПодразделениеОтправитель.АвтоОтметкаНезаполненного = Истина;
				Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.ПодразделениеОтправитель); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПродукцияГруппаСуммыНУ", "Видимость", Форма.ОтражатьВНалоговомУчете);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаНалоговыйУчет", "Видимость", Форма.ОтражатьВНалоговомУчете);
	
	Если Форма.ОтражатьВНалоговомУчете Тогда
		Форма.Элементы.ГруппаСтраницыБУиНУ.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	Иначе
		Форма.Элементы.ГруппаСтраницыБУиНУ.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОбязательностьПодразделенияПолучателя()

	Элементы.ПодразделениеПолучатель.АвтоОтметкаНезаполненного = Ложь;
	Элементы.ПодразделениеПолучатель.ОтметкаНезаполненного = Ложь;
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		ПризнакиУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.00");
		Если ПризнакиУчета.УчетПоПодразделениям И НЕ ПризнакиУчета.РазрешитьНеУказыватьПодразделение Тогда
			Элементы.ПодразделениеПолучатель.АвтоОтметкаНезаполненного = Истина;
			Элементы.ПодразделениеПолучатель.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.ПодразделениеПолучатель);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ПараметрыПодбора.Вставить("ИмяТаблицы", "Продукция");
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	
	ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер.ДополнительнаяАналитикаСчетаУчетаМатериалов(
		БухгалтерскийУчетКлиентСервер.СчетПоКоду("105.00", Объект.Дата, Объект.Организация), Объект.Организация);
	Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
		ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
	КонецЕсли;
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция ПолучитьНовыйИдСтроки()

	КолонкаИД = Объект.Продукция.Выгрузить(,"ИдСтроки");
	КолонкаИД.Сортировать("ИдСтроки Убыв");
	Если КолонкаИД.Количество() = 0 Тогда
		Возврат 1;
	Иначе
		Возврат КолонкаИД[0].ИдСтроки + 1;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ЗаполнитьПоОстаткам(ИдСтроки = Неопределено, ВидУчета = Неопределено)

	ЗаполнитьЗатратыБУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "БУ");
	ЗаполнитьЗатратыНУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "НУ") И ОтражатьВНалоговомУчете;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",           Объект.Организация);
	Запрос.УстановитьПараметр("ИФО",                   Объект.ИФО);
	Запрос.УстановитьПараметр("КФО",                   Объект.КФО);
	Запрос.УстановитьПараметр("Подразделение",         Объект.ПодразделениеОтправитель);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Если Объект.Ссылка.Пустая() Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	
	ПоВсейНоменклатуре = (ИдСтроки = Неопределено);
	Если ПоВсейНоменклатуре Тогда
		// Заполняем пустой документ всеми позициями номенклатуры, по которым есть остатки затрат.
		Объект.Продукция.Очистить();
		Объект.Затраты.Очистить();
		Объект.ЗатратыНУ.Очистить();
		СтрокаПродукции = Неопределено;
		Запрос.УстановитьПараметр("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Иначе
		// Заполняем затраты только для выбранной позиции номенклатуры.
		СтрокаПродукции = Объект.Продукция.НайтиПоИдентификатору(ИдСтроки);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаПродукции.Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПоВсейНоменклатуре", ПоВсейНоменклатуре);
	Запрос.УстановитьПараметр("ДатаПроверки", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ВедетсяУчетПрослеживаемыхТоваров", ВедетсяУчетПрослеживаемыхТоваров);
	
	Если ЗаполнитьЗатратыБУ Тогда // Бухгалтерский учет.
	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).Наименование КАК НаименованиеНоменклатуры,
		|	&ВедетсяУчетПрослеживаемыхТоваров
		|		И (ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ПрослеживаемыйТовар)
		|			ИЛИ ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами,
		|					ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами)) КАК ПрослеживаемыйТовар,
		|	&ВедетсяУчетПрослеживаемыхТоваров
		|		И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, 
		|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СтранаПроисхождения КАК СтранаПроисхождения,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СчетУчета КАК КодСчетаУчета,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат).Наименование КАК НаименованиеВидаЗатрат,
		|	&ДопСубконто106 КАК ДополнительноеСубконто106,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПСЗатрат,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет = &СчетПроизводства,
		|			&Субконто,
		|			Организация = &Организация
		|				И КФО = &КФО
		|				И &УсловиеЦМО
		|				И (&ИспользоватьУчетПоИФО = ЛОЖЬ
		|					ИЛИ ИФО = &ИФО)
		|				И (&ИспользоватьУчетПоПодразделениям = ЛОЖЬ
		|					ИЛИ Подразделение = &Подразделение)
		|				И (&ПоВсейНоменклатуре = ИСТИНА
		|					ИЛИ Субконто1 = &Номенклатура)) КАК ЖурналПроводокЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Т2.Ссылка КАК Ссылка,
		|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
		|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
		|		ИЗ
		|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
		|					Т1.Ссылка КАК Ссылка
		|				ИЗ
		|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
		|				ГДЕ
		|					Т1.ДатаИзменения > &ДатаПроверки
		|				
		|				СГРУППИРОВАТЬ ПО
		|					Т1.Ссылка) КАК Т1
		|				ПО Т2.Ссылка = Т1.Ссылка
		|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
		|		ПО (&ВедетсяУчетПрослеживаемыхТоваров)
		|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = ДанныеИзИстории.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеНоменклатуры,
		|	НаименованиеВидаЗатрат
		|ИТОГИ
		|	МАКСИМУМ(КодСчетаУчета),
		|	СУММА(Сумма)
		|ПО
		|	Номенклатура";
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетПроизводства);
		СубконтоЗапроса = Новый Массив;
		СубконтоЗапроса.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		СубконтоЗапроса.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
		ЕстьСубконтоЦМО = Ложь;
		Для НомерСубконто = 1 По 3 Цикл
			ТекВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
			Если ТекВидСубконто = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Если ТекВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				ИЛИ ТекВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				Продолжить;
			КонецЕсли;
			СубконтоЗапроса.Добавить(ТекВидСубконто);
			Если ТекВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
				ЕстьСубконтоЦМО = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если СубконтоЗапроса.Количество() = 2 Или ЕстьСубконтоЦМО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопСубконто106", "Неопределено");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопСубконто106", "ЖурналПроводокЕПСБУОстатки.Субконто3");
		КонецЕсли;
		Если ЕстьСубконтоЦМО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦМО", "Субконто3 = &ЦМО");
			Запрос.УстановитьПараметр("ЦМО", Объект.ЦМООтправитель);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦМО", "Истина");
		КонецЕсли;
		Запрос.УстановитьПараметр("Субконто", СубконтоЗапроса);
		Запрос.УстановитьПараметр("СчетПроизводства", Объект.СчетПроизводства);
		Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",
			ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям
			И СвойстваСчета.УчетПоПодразделениям);
		
		ВыборкаПродукция = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПродукция.Следующий() Цикл
			
			Если ПоВсейНоменклатуре Тогда
				СтрокаПродукции = НайтиДобавитьСтрокуВыпущеннойПродукции(ВыборкаПродукция);
			КонецЕсли;
			
			СтрокаПродукции.Сумма = ВыборкаПродукция.Сумма;
			
			ВыборкаВидыЗатрат = ВыборкаПродукция.Выбрать();
			Пока ВыборкаВидыЗатрат.Следующий() Цикл
				
				СтрокаЗатрат = Объект.Затраты.Добавить();
				СтрокаЗатрат.ИдСтроки = СтрокаПродукции.ИдСтроки;
				ЗаполнитьЗначенияСвойств(СтрокаЗатрат, ВыборкаВидыЗатрат,
					"ВидЗатрат,ДополнительноеСубконто106,КПСЗатрат,Сумма");
			
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗаполнитьЗатратыНУ Тогда // Налоговый учет.
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).Наименование КАК НаименованиеНоменклатуры,
		|	&ВедетсяУчетПрослеживаемыхТоваров
		|		И (ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ПрослеживаемыйТовар)
		|			ИЛИ ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами,
		|					ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами)) КАК ПрослеживаемыйТовар,
		|	&ВедетсяУчетПрослеживаемыхТоваров
		|		И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами,
		|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СтранаПроисхождения КАК СтранаПроисхождения,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СчетУчета КАК КодСчетаУчета,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат).Наименование КАК НаименованиеВидаЗатрат,
		|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК ДополнительноеСубконто,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаНУ,
		|	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ,
		|	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВД
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет = &СчетПроизводстваНУ,
		|			,
		|			Организация = &Организация
		|				И КФО = &КФО
		|				И (&ИспользоватьУчетПоИФО = ЛОЖЬ
		|					ИЛИ ИФО = &ИФО)
		|				И (&ИспользоватьУчетПоПодразделениямНУ = ЛОЖЬ
		|					ИЛИ Подразделение = &Подразделение)
		|				И (&ПоВсейНоменклатуре = ИСТИНА
		|					ИЛИ Субконто1 = &Номенклатура)) КАК ЖурналПроводокЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Т2.Ссылка КАК Ссылка,
		|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
		|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
		|		ИЗ
		|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
		|					Т1.Ссылка КАК Ссылка
		|				ИЗ
		|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
		|				ГДЕ
		|					Т1.ДатаИзменения > &ДатаПроверки
		|				
		|				СГРУППИРОВАТЬ ПО
		|					Т1.Ссылка) КАК Т1
		|				ПО Т2.Ссылка = Т1.Ссылка
		|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
		|		ПО (&ВедетсяУчетПрослеживаемыхТоваров)
		|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = ДанныеИзИстории.Ссылка
		|ГДЕ
		|	ЖурналПроводокЕПСБУОстатки.Субконто2 <> ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеНоменклатуры,
		|	НаименованиеВидаЗатрат
		|ИТОГИ
		|	МАКСИМУМ(КодСчетаУчета),
		|	СУММА(СуммаНУ),
		|	СУММА(СуммаНеУчитываетсяНУ),
		|	СУММА(СуммаЕНВД)
		|ПО
		|	Номенклатура";
		Запрос.УстановитьПараметр("СчетПроизводстваНУ", БухгалтерскийУчет.СчетПоКоду("Н20.01", Объект.Дата, Объект.Организация));
		Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениямНУ",
			ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям
			И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запрос.Параметры.СчетПроизводстваНУ).УчетПоПодразделениям);
		
		ВыборкаПродукция = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПродукция.Следующий() Цикл
			
			Если ПоВсейНоменклатуре Тогда
				СтрокаПродукции = НайтиДобавитьСтрокуВыпущеннойПродукции(ВыборкаПродукция);
			КонецЕсли;
			
			СтрокаПродукции.СуммаНУ              = ВыборкаПродукция.СуммаНУ;
			СтрокаПродукции.СуммаНеУчитываетсяНУ = ВыборкаПродукция.СуммаНеУчитываетсяНУ;
			СтрокаПродукции.СуммаЕНВД            = ВыборкаПродукция.СуммаЕНВД;
			
			ВыборкаВидыЗатрат = ВыборкаПродукция.Выбрать();
			Пока ВыборкаВидыЗатрат.Следующий() Цикл
				
				СтрокаЗатрат = Объект.ЗатратыНУ.Добавить();
				СтрокаЗатрат.ИдСтроки = СтрокаПродукции.ИдСтроки;
				ЗаполнитьЗначенияСвойств(СтрокаЗатрат, ВыборкаВидыЗатрат,
					"ВидЗатрат,ДополнительноеСубконто,СуммаНУ,СуммаНеУчитываетсяНУ,СуммаЕНВД");
			
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПоВсейНоменклатуре Тогда
		ТекущийИдСтроки = Объект.Продукция.Количество() + 1; // В реквизите формы запомним текущий ИдСтроки.
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект,
		Объект, "Продукция");
	ПродукцияЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Функция НайтиДобавитьСтрокуВыпущеннойПродукции(Выборка)
	
	ОтборПоНоменклатуре = Новый Структура("Номенклатура", Выборка.Номенклатура);
	НайденныеСтроки = Объект.Продукция.НайтиСтроки(ОтборПоНоменклатуре);
	Если НайденныеСтроки.Количество() > 0 Тогда
		// Возвращаем найденную строку с нужной позицией номенклатуры.
		Возврат НайденныеСтроки[0];
	Иначе
		// Такой позиции номенклатуры нет, добавляем новую строку.
		НоваяСтрока = Объект.Продукция.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Номенклатура,ПрослеживаемыйТовар,СтранаПроисхождения,КомплектСПрослеживаемымиТоварами");
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, Истина);
		НоваяСтрока.КПСДебета = Объект.КПСПроизводства; // По умолчанию устанавливаем КПС из шапки документа.
		НоваяСтрока.ИдСтроки = Объект.Продукция.Количество() + 1;
		Возврат НоваяСтрока;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УдалитьЗатраты(Знач ИдСтроки, ВидУчета = Неопределено)

	УдалитьЗатратыБУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "БУ");
	УдалитьЗатратыНУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "НУ");
	
	ОтборПоИдСтроки = Новый Структура("ИдСтроки", ИдСтроки);
	
	Если УдалитьЗатратыБУ Тогда
		СтрокиКУдалению = Объект.Затраты.НайтиСтроки(ОтборПоИдСтроки);
		Для каждого Строка Из СтрокиКУдалению Цикл
			Объект.Затраты.Удалить(Строка);
		КонецЦикла;
	КонецЕсли;
	
	Если УдалитьЗатратыНУ Тогда
		СтрокиКУдалению = Объект.ЗатратыНУ.НайтиСтроки(ОтборПоИдСтроки);
		Для каждого Строка Из СтрокиКУдалению Цикл
			Объект.ЗатратыНУ.Удалить(Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаПродукцииНеАктивизирована(ТекущиеДанные)
	
	Отказ = Ложь;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Если Объект.Продукция.Количество() = 0 Тогда
			ТекстПредупреждения = НСтр("ru = 'Перед заполнением затрат необходимо ввести номенклатуру выпущенной продукции.'");
		Иначе
			ТекстПредупреждения = НСтр("ru = 'Выберите строку с номенклатурой выпущенной продукции.'");
		КонецЕсли;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПредупреждения, , "Объект.Продукция", , Отказ);
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимостьПродукции(ТекущиеДанные, ВидУчета = Неопределено)
	
	РассчитатьСтоимостьБУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "БУ");
	РассчитатьСтоимостьНУ = (ВидУчета = Неопределено ИЛИ ВидУчета = "НУ");
	
	ОтборПоИдСтроки = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	
	Если РассчитатьСтоимостьБУ Тогда
		НайденныеСтроки = Объект.Затраты.НайтиСтроки(ОтборПоИдСтроки);
		ТекущиеДанные.Сумма = 0;
		Для каждого Строка Из НайденныеСтроки Цикл
			ТекущиеДанные.Сумма = ТекущиеДанные.Сумма + Строка.Сумма;
		КонецЦикла;
	КонецЕсли;
	
	Если РассчитатьСтоимостьНУ Тогда
		НайденныеСтроки = Объект.ЗатратыНУ.НайтиСтроки(ОтборПоИдСтроки);
		ТекущиеДанные.СуммаНУ = 0;
		ТекущиеДанные.СуммаНеУчитываетсяНУ = 0;
		ТекущиеДанные.СуммаЕНВД = 0;
		Для каждого Строка Из НайденныеСтроки Цикл
			ТекущиеДанные.СуммаНУ              = ТекущиеДанные.СуммаНУ              + Строка.СуммаНУ;
			ТекущиеДанные.СуммаНеУчитываетсяНУ = ТекущиеДанные.СуммаНеУчитываетсяНУ + Строка.СуммаНеУчитываетсяНУ;
			ТекущиеДанные.СуммаЕНВД            = ТекущиеДанные.СуммаЕНВД            + Строка.СуммаЕНВД;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваСчета(Счет)
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект.Продукция.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
		НоваяСтрока.ИдСтроки = ТекущийИдСтроки;
		ТекущийИдСтроки = ТекущийИдСтроки + 1;
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, Истина);
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЦикла;
	РассчитатьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
	
КонецПроцедуры

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0) И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе	
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);

	ТаблицаНФА = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок,
		"ОбъектНФА, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЕдИзм");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНФА);

КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ПараметрыПодбора.ОбъектНФА);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеСтроки;
КонецФункции	

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
		Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ВидДрагМатериала");
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, "");
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.Продукция.Выгрузить(,"Номенклатура, Количество");
	
	ТаблицаОбъектовМЗ = Новый ТаблицаЗначений;
	ТаблицаОбъектовМЗ.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	НеСодержатДрагМатериалы = УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НеСодержатДрагМатериалы.Найти(ТекСтрока.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
				НоваяСтрока = ТаблицаОбъектовМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.Номенклатура, ""); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовМЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = ОбъектыНФАСДрагМатериалами.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.Номенклатура;
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);

КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	ТаблицаДМ.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьПоОстаткам();
		
		Если Объект.Продукция.Количество() > 0 Тогда
			Элементы.Продукция.ТекущаяСтрока = Объект.Продукция[0].ПолучитьИдентификатор();
			ПродукцияОбработкаИзмененияТекущейСтроки();
			РассчитатьПрослеживаемыеТовары();
			УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗатратыЗавершение(Результат, ТекущиеДанные) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьЗатраты(ТекущиеДанные.ИдСтроки, "БУ");
		ЗаполнитьПоОстаткам(ТекущиеДанные.ПолучитьИдентификатор(), "БУ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗатратыНУЗавершение(Результат, ТекущиеДанные) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьЗатраты(ТекущиеДанные.ИдСтроки, "НУ");
		ЗаполнитьПоОстаткам(ТекущиеДанные.ПолучитьИдентификатор(), "НУ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
		ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
			Объект.Организация, Объект.Дата, Объект.КФО);
		УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		Объект.Организация, Объект.Дата, Объект.КФО);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	УстановитьРуководителя(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), Объект.Организация,
		Объект.Дата, Объект.ПодразделениеОтправитель);

	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПродукция

&НаКлиенте
Процедура ПродукцияПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ПродукцияОбработкаИзмененияТекущейСтроки", 0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередУдалением(Элемент, Отказ)
	
	УдалитьЗатраты(Элементы.Продукция.ТекущиеДанные.ИдСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ПродукцияОбновитьТекстЗаголовковВСтрокеТаблицы(ТекущиеДанные);
	КонецЕсли;
	
	Если Копирование И ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = ПредопределенноеЗначение("Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока И НЕ ОтменаРедактирования Тогда
		Элементы.Продукция.ТекущиеДанные.ИдСтроки = ТекущийИдСтроки;
		ТекущийИдСтроки = ТекущийИдСтроки + 1;  
		Элементы.Продукция.ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	ПродукцияНоменклатураПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияСчетУчетаПриИзменении(Элемент)

	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, Элементы.Продукция.ТекущиеДанные, Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияОбработкаИзмененияТекущейСтроки()
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПозицияСтрокиИзменилась = ИдентификаторТекущейСтроки <> Неопределено;
	Иначе
		ПозицияСтрокиИзменилась = ТекущиеДанные.ПолучитьИдентификатор() <> ИдентификаторТекущейСтроки;
	КонецЕсли;
	
	Если НЕ ПозицияСтрокиИзменилась Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтбор = Новый Структура("ИдСтроки", -1);
	Иначе
		НовыйОтбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	Элементы.Затраты.ОтборСтрок   = Новый ФиксированнаяСтруктура(НовыйОтбор);
	Элементы.ЗатратыНУ.ОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтбор);
	
КонецПроцедуры

&НаСервере
Процедура ПродукцияЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.Продукция Цикл
		ПродукцияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПродукцияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияРНПТНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, "Продукция");
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияРНПТОчистка(Элемент, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.Продукция.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	Иначе
		СтрокаТабличнойЧасти.РНПТ = Неопределено;
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ПродукцияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПрослеживаемостьФормыБГУКлиент.МатериалыВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка, Ложь, "Продукция");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗатраты

&НаКлиенте
Процедура ЗатратыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если СтрокаПродукцииНеАктивизирована(Элементы.Продукция.ТекущиеДанные) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.Затраты.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки = Элементы.Продукция.ТекущиеДанные.ИдСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Не ОтменаРедактирования Тогда
		ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
		РассчитатьСтоимостьПродукции(ТекущиеДанные, "БУ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	РассчитатьСтоимостьПродукции(ТекущиеДанные, "БУ");
	
КонецПроцедуры

#КонецОбласти

