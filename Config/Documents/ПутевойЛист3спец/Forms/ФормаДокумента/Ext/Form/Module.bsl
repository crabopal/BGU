&НаКлиенте
Процедура ДобавитьОбратныйМаршрут(Команда)
	ТекущаяСтрока = Элементы.МаршрутДвижения.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		НоваяСтрока = Объект.МаршрутДвижения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , 
			"ВремяПрибытия, ВремяУбытия, ПоказанияСпидометраПриПрибытии, ПоказанияСпидометраПриУбытии");
		ДанныеМаршрута = ПолучитьДанныеМаршрутаДвижения(ТекущаяСтрока.МаршрутДвижения);
		НоваяСтрока.МаршрутДвижения = ДанныеМаршрута.ОбратныйМаршрутДвижения;
		
		Если ЗначениеЗаполнено(ДанныеМаршрута.ОбратныйМаршрутДвижения) Тогда
			ДанныеОбратногоМаршрута = ПолучитьДанныеМаршрутаДвижения(ДанныеМаршрута.ОбратныйМаршрутДвижения);
			НоваяСтрока.МаршрутДвиженияОбъектРаботы = ДанныеОбратногоМаршрута.МестоНазначения;
			
			ПротяженностьОбратногоМаршрута = ДанныеОбратногоМаршрута.Протяженность;
			Если ПротяженностьОбратногоМаршрута > 0 Тогда
				НоваяСтрока.ПройденоКилометров = ПротяженностьОбратногоМаршрута;	
			КонецЕсли;
		Иначе
			НоваяСтрока.ПройденоКилометров = ТекущаяСтрока.ПройденоКилометров;
		КонецЕсли;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбран маршрут из списка! Операция не выполнена.'");
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

