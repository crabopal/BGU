&НаСервере
Процедура ПрочитатьРежимыЗаполненияДанных()
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	СтруктураРежимовЗаполнения = УчетГСМ.РежимыНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства, ИдентификаторДокумента, Объект.ТранспортноеСредство);
	ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
	ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
	ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ;
	ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ;
	ЗаполнятьРеквизитВодительПринял = СтруктураРежимовЗаполнения.ЗаполнятьРеквизитВодительПринял;
	ЗаполнятьРеквизитВодительСдал = СтруктураРежимовЗаполнения.ЗаполнятьРеквизитВодительСдал;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияДокумента(ОсновноеСредство)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	ТаблицаНастроек = УчетГСМ.ДанныеНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства, ИдентификаторДокумента, ОсновноеСредство);
	
	Для Каждого ТекСтрока Из ТаблицаНастроек Цикл
		ЗаполнятьРеквизитВодительПринял = ТекСтрока.ЗаполнятьРеквизитВодительПринял;
		ЗаполнятьРеквизитВодительСдал = ТекСтрока.ЗаполнятьРеквизитВодительСдал;
		ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
		ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
		ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ = ТекСтрока.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ;
		ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ = ТекСтрока.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ;
		
		Объект.Водитель = ТекСтрока.Водитель;
		
		Если ЗаполнятьРеквизитВодительПринял Тогда
			Объект.ВодительПринялТС = ТекСтрока.Водитель;
		КонецЕсли;
		
		Если ЗаполнятьРеквизитВодительСдал Тогда
			Объект.ВодительСдалТС = ТекСтрока.Водитель;
		КонецЕсли;
		
		Объект.ЛицензионнаяКарточка = ТекСтрока.ЛицензионнаяКарточка;
		Объект.ВыездРазрешилМеханик = ТекСтрока.МеханикПриВыезде;
		Объект.ПринялТСМеханик = ТекСтрока.МеханикПриВозвращении;
		Объект.ВыпускающийТСДиспетчер = ТекСтрока.ДиспетчерПриВыезде;
		Объект.ЛицоДопускающееВодителяПоСостояниюЗдоровья = ТекСтрока.ЛицоДопускающееВодителяПоСостояниюЗдоровья;
		Объект.ОсобыеОтметки = ТекСтрока.ОсобыеОтметки;
		Если НЕ ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
			Объект.ВидПеревозки = ТекСтрока.ВидПеревозки;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
			Объект.ВидПеревозки = ТекСтрока.ВидПеревозки;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.СведенияОВидахСообщения) Тогда
			Объект.СведенияОВидахСообщения = ТекСтрока.СведенияОВидахСообщения;
			Если НЕ ЗначениеЗаполнено(ТекСтрока.СведенияОВидахСообщения) Тогда
				Объект.СведенияОВидахСообщения = СокрЛП(ТекСтрока.ВидСообщения);
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.Водитель) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Подразделение", ТекСтрока.Водитель, Объект.Дата);
			СотрудникСтруктура = ПолучитьДанныеСотрудника(ДанныеСотрудника);
			
			Объект.Бригада = СотрудникСтруктура.КодПодразделения;
		КонецЕсли;
		
		Прервать;
	КонецЦикла;	
	
	Объект.Колонна = УчетГСМ.ПолучитьКолоннуТС(ОсновноеСредство);
	
	//прицепы
	НастройкиПрицепов = УчетГСМ.ДанныеНастроекПрицеповТС(Объект.Организация, ОсновноеСредство);
	
	Объект.Прицепы.Очистить();
	Для Каждого ТекСтрока Из НастройкиПрицепов Цикл
		НоваяСтрока = Объект.Прицепы.Добавить();
		НоваяСтрока.Прицеп = ТекСтрока.Прицеп;
		НоваяСтрока.ГаражныйНомер = ?(ЗначениеЗаполнено(ТекСтрока.Прицеп),УчетГСМ.ПолучитьГаражныйНомерТС(ТекСтрока.Прицеп),"");
		НоваяСтрока.РегистрационныйНомернойЗнак = ?(ЗначениеЗаполнено(ТекСтрока.Прицеп),УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ТекСтрока.Прицеп),"");
		НоваяСтрока.Марка = ?(ЗначениеЗаполнено(ТекСтрока.Прицеп),УчетГСМ.ПолучитьМаркуТС(ТекСтрока.Прицеп),"");
	КонецЦикла;	
	
	//горючее
	НастройкиГорючего = УчетГСМ.ДанныеНастроекГорючегоТС(Объект.Организация, ОсновноеСредство);
	
	Объект.ДвижениеГорючего.Очистить();
	Для Каждого ТекСтрока Из НастройкиГорючего Цикл
		НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
		НоваяСтрока.ВидГСМ = ТекСтрока.МаркаГорючего;
		Если ЗначениеЗаполнено(ТекСтрока.МаркаГорючего) Тогда
			НоваяСтрока.МаркаГорючего = ТекСтрока.МаркаГорючего.МаркаГорючего;
			НоваяСтрока.КодМаркиГорючего = ТекСтрока.МаркаГорючего.КодМаркиГорючего;
			НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.МаркаГорючего.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЦикла;	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Процедура ВодительПриИзмененииНаСервере()
	Если ЗаполнятьРеквизитВодительПринял Тогда
		Объект.ВодительПринялТС = Объект.Водитель;
	КонецЕсли;
		
	Если ЗаполнятьРеквизитВодительСдал Тогда
		Объект.ВодительСдалТС = Объект.Водитель;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОПоказанияхСпидометра()
	ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
	
	ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
		ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраРасчетные(ПредыдущийПутевойЛист);
		Объект.ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	ИначеЕсли ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ Тогда
		Объект.ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеОбОстаткахГорючего()
	Если НЕ ЗначениеЗаполнено(ПредыдущийПутевойЛист) Тогда
		ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
	КонецЕсли;
	
	ДанныеГорючего = УчетГСМ.ОстаткиГорючегоПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПредыдущийПутевойЛист);
	ИначеЕсли ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ Тогда
		Объект.ДвижениеГорючего.Очистить();
		Для Каждого ТекСтрока Из ДанныеГорючего Цикл
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
			Если ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.ЕдиницаИзмерения;
			Иначе	
				Если ЗначениеЗаполнено(ТекСтрока.ВидГСМ) Тогда
					НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;	
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГСМ;
			НоваяСтрока.МаркаГорючего = ТекСтрока.МаркаГСМ;
			НоваяСтрока.КодМаркиГорючего = ТекСтрока.КодМаркиГСМ;
		КонецЦикла;
		ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПутевойЛистТС)
	
	ОстатокГСМ = 0;
	
	ДанныеГорючего = УчетГСМ.ДвиженияГорючегоРасчетные(ПутевойЛистТС);
	
	Объект.ДвижениеГорючего.Очистить();
	Для каждого ТекСтрока Из ДанныеГорючего Цикл
		Если ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении;
			НоваяСтрока.МаркаГорючего = СокрЛП(ТекСтрока.ВидГСМ.МаркаГорючего);
			НоваяСтрока.КодМаркиГорючего = СокрЛП(ТекСтрока.ВидГСМ.КодМаркиГорючего);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

