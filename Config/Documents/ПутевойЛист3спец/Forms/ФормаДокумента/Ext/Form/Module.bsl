&НаКлиенте
Процедура ДвижениеГорючегоПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Объект.ДвижениеГорючего.Количество()>1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В печатной форме путевого листа отразится только 1 строка. Данная строка %1 в списке.'"), Объект.ДвижениеГорючего.Количество());
		Сообщение.Сообщить();
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДвижениеГорючего.ТекущиеДанные;
	ОбновитьТекстЗаголовковВСтрокеТаблицыДвижениеГорючего(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвижениеГорючегоМаркаГорючегоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.ВидыГСМ.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДвижениеГорючегоМаркаГорючегоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ВидГСМ = ПолучитьДанныеВидаГСМ(ВыбранноеЗначение);
		ВыбранноеЗначение = ВидГСМ.МаркаГорючего;
		Элементы.ДвижениеГорючего.ТекущиеДанные.КодМаркиГорючего = ВидГСМ.КодМаркиГорючего;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДвижениеГорючегоВремяРаботыСпецоборудованияСтрПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДвижениеГорючего.ТекущиеДанные;

	Если Не УчетВремениКлиентСервер.ПроверитьФормат(ТекущиеДанные.ВремяРаботыСпецоборудованияСтр) Тогда
		ТекущиеДанные.ВремяРаботыСпецоборудованияСтр = "";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Количество времени работы спецоборудования не соответствует формату ЧЧ:мм для строки %1.'"), ТекущиеДанные.НомерСтроки);
		Сообщение.Сообщить();
	КонецЕсли;
	
	ТекущиеДанные.ВремяРаботыСпецоборудования = УчетВремениКлиентСервер.ЧислоИзСтроки(ТекущиеДанные.ВремяРаботыСпецоборудованияСтр);
КонецПроцедуры

