&НаСервере
Функция ПолучитьДанныеНоменклатуры(Номенклатура)
	Возврат УчетГСМ.ПолучитьДанныеНоменклатуры(Номенклатура);
КонецФункции

&НаСервере
Функция ДанныеПрицепа(Прицеп)
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("МаркаТС", УчетГСМ.ПолучитьМаркуТС(Прицеп));
	СтруктураДанных.Вставить("ГосударственныйНомернойЗнакТС", УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(Прицеп));
	СтруктураДанных.Вставить("ГаражныйНомерТС", УчетГСМ.ПолучитьГаражныйНомерТС(Прицеп));
	
	Возврат СтруктураДанных;
КонецФункции	

&НаСервере
Процедура ПриИзмененииДатыНаСервере()
	
	Объект.НомерСмены = УчетГСМ.НомерСменыДляПутевогоЛиста(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата) + 1;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВодителя()
	Если НЕ ЗначениеЗаполнено(Объект.ТранспортноеСредство)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	ТаблицаВодителей = УчетГСМ.ДанныеНастроекВодителиТС(Объект.Организация, Объект.ТранспортноеСредство);
	Элементы.Водитель.СписокВыбора.Очистить();
	Для каждого ТекСтрока Из ТаблицаВодителей Цикл
		Элементы.Водитель.СписокВыбора.Добавить(ТекСтрока.Водитель);
	КонецЦикла;
КонецПроцедуры		

