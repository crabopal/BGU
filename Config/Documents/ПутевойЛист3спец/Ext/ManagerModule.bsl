// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист3спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345002_390";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист специального автомобиля (пр. № 390 от 28.09.2022)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист3спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345002_368";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист специального автомобиля (пр. № 368 от 11.09.2020)'");
	КомандаПечати.Порядок			= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист3спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345002_152";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист специального автомобиля (пр. № 152 от 18.09.2008)'");
	КомандаПечати.Порядок			= 3;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист3спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345002";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист специального автомобиля (ф. 3 спец)'");
	КомандаПечати.Порядок			= 4;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_390") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_390", "Путевой лист специального автомобиля (пр. № 390 от 28.09.2022)", ПечатьПутевогоЛиста390ПриказМинтранса(МассивОбъектов, ОбъектыПечати));

	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_368") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_368", "Путевой лист специального автомобиля (пр. № 368 от 11.09.2020)", ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_152") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002_152", "Путевой лист специального автомобиля (пр. № 152 от 18.09.2008)", ПечатьПутевогоЛиста152ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345002", "Путевой лист специального автомобиля (ф. 3 спец)", ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист3спец";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист3спец.ПФ_MXL_Форма0345002");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист3спец.Ссылка КАК Ссылка,
	|	ПутевойЛист3спец.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист3спец.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист3спец.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист3спец.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист3спец.СрокДействия,
	|	ПутевойЛист3спец.ТранспортноеСредство,
	|	ПутевойЛист3спец.Водитель,
	|	ПутевойЛист3спец.ЛицензионнаяКарточка,
	|	ПутевойЛист3спец.Комментарий,
	|	ПутевойЛист3спец.ВремяВыездаТС,
	|	ПутевойЛист3спец.ВремяВозвращенияТС,
	|	ПутевойЛист3спец.ВыпускающийТСДиспетчер,
	|	ПутевойЛист3спец.ЛицоДопускающееВодителяПоСостояниюЗдоровья,
	|	ПутевойЛист3спец.ОсобыеОтметки,
	|	ПутевойЛист3спец.ВодительПринялТС,
	|	ПутевойЛист3спец.ВодительСдалТС,
	|	ПутевойЛист3спец.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист3спец.ВыездРазрешилМеханик,
	|	ПутевойЛист3спец.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист3спец.ПринялТСМеханик,
	|	ПутевойЛист3спец.РасчетЗаработнойПлаты,
	|	ПутевойЛист3спец.ТаксировщикПутевогоЛиста,
	|	ПутевойЛист3спец.НулевойПробегПриВыезде,
	|	ПутевойЛист3спец.НулевойПробегПриВозвращении,
	|	ПутевойЛист3спец.ВремяВыездаТСФактическое,
	|	ПутевойЛист3спец.ВремяВозвращенияТСФактическое,
	|	ПутевойЛист3спец.ПриВозвращенииТСНеисправно,
	|	ПутевойЛист3спец.РежимРаботы,
	|	ПутевойЛист3спец.ВыдатьГорючего,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛист3спец.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист3спец.ГаражныйНомер,
	|	ПутевойЛист3спец.Бригада,
	|	ПутевойЛист3спец.Колонна,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК ОрганизацияСокращенно,
	|	ПутевойЛист3спец.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		АдресЗаказчика,
	|		ВремяПрибытия,
	|		ВремяУбытия,
	|		КоличествоЧасов,
	|		КоличествоЕздок,
	|		ВидРаботы
	|	),
	|	ПутевойЛист3спец.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВыезде,
	|		ОстатокГорючегоПриВозвращении,
	|		СданоГорючее,
	|		КоэффициентИзмененияНормы,
	|		ВремяРаботыСпецоборудования,
	|		ВремяРаботыДвигателя
	|	),
	|	ПутевойЛист3спец.ВыданныеТалоныНаГорючее.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДенежныйДокумент
	|	),
	|	ПутевойЛист3спец.ОтветственныеЗаГруз.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИООтветственного,
	|		ДолжностьОтветственного,
	|		ФИООтветственногоОтЗаказчика,
	|		ДолжностьОтветственногоОтЗаказчика
	|	),
	|	ПутевойЛист3спец.Такелажники.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФамилияИнициалыТакелажника,
	|		НомерУдостоверения
	|	),
	|	ПутевойЛист3спец.Прицепы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Прицеп,
	|		ГаражныйНомер,
	|		РегистрационныйНомернойЗнак
	|	)
	|ИЗ
	|	Документ.ПутевойЛист3спец КАК ПутевойЛист3спец
	|ГДЕ
	|	ПутевойЛист3спец.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345002";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("ОрганизацияСокращенно", СтруктураДанных.ОрганизацияСокращенно);
	
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		СтруктураДанных.Вставить("ОтСрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия, Истина));
		
		СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьМаркуТС(СтруктураДанных.ТранспортноеСредство));	
		
		СтруктураДанных.Вставить("ЧислоВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ:мм"""));	       //
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ЧислоВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ:мм"""));	//
		
