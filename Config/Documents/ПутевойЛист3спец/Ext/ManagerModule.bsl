			ПараметрыПрописи = "целая, целых, целых, ж, сотая, сотых, сотых, м, 2";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		КонецЕсли;	
		СтруктураДанных.Вставить("ВыдатьГорючегоПрописью", КоличествоЛитровГСМ);	
		
