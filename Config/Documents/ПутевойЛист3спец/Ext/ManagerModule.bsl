	|	ПутевойЛист3спец.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист3спец.ВыездРазрешилМеханик,
	|	ПутевойЛист3спец.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист3спец.ПринялТСМеханик,
	|	ПутевойЛист3спец.РасчетЗаработнойПлаты,
	|	ПутевойЛист3спец.ТаксировщикПутевогоЛиста,
	|	ПутевойЛист3спец.НулевойПробегПриВыезде,
	|	ПутевойЛист3спец.НулевойПробегПриВозвращении,
	|	ПутевойЛист3спец.ВремяВыездаТСФактическое,
	|	ПутевойЛист3спец.ВремяВозвращенияТСФактическое,
	|	ПутевойЛист3спец.ПриВозвращенииТСНеисправно,
	|	ПутевойЛист3спец.РежимРаботы,
	|	ПутевойЛист3спец.ВыдатьГорючего,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛист3спец.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист3спец.ГаражныйНомер,
	|	ПутевойЛист3спец.Бригада,
	|	ПутевойЛист3спец.Колонна,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК ОрганизацияСокращенно,
	|	ПутевойЛист3спец.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		АдресЗаказчика,
	|		ВремяПрибытия,
	|		ВремяУбытия,
	|		КоличествоЧасов,
	|		КоличествоЕздок,
	|		ВидРаботы
	|	),
	|	ПутевойЛист3спец.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВыезде,
	|		ОстатокГорючегоПриВозвращении,
	|		СданоГорючее,
	|		КоэффициентИзмененияНормы,
	|		ВремяРаботыСпецоборудования,
	|		ВремяРаботыДвигателя
	|	),
	|	ПутевойЛист3спец.ВыданныеТалоныНаГорючее.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДенежныйДокумент
	|	),
	|	ПутевойЛист3спец.ОтветственныеЗаГруз.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИООтветственного,
	|		ДолжностьОтветственного,
	|		ФИООтветственногоОтЗаказчика,
	|		ДолжностьОтветственногоОтЗаказчика
	|	),
	|	ПутевойЛист3спец.Такелажники.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФамилияИнициалыТакелажника,
	|		НомерУдостоверения
	|	),
	|	ПутевойЛист3спец.Прицепы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Прицеп,
	|		ГаражныйНомер,
	|		РегистрационныйНомернойЗнак
	|	)
	|ИЗ
	|	Документ.ПутевойЛист3спец КАК ПутевойЛист3спец
	|ГДЕ
	|	ПутевойЛист3спец.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345002";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("ОрганизацияСокращенно", СтруктураДанных.ОрганизацияСокращенно);
	
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		СтруктураДанных.Вставить("ОтСрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия, Истина));
		
		СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьМаркуТС(СтруктураДанных.ТранспортноеСредство));	
		
		СтруктураДанных.Вставить("ЧислоВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	       //
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ЧислоВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	//
		
		СтруктураДанных.Вставить("ВремяВозвращенияФактическое", Формат(ВыборкаДокументов.ВремяВозвращенияТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		//выдать горючего прописью
		КоличествоЛитровГСМ = "";
		ДробнаяЧасть = ВыборкаДокументов.ВыдатьГорючего - Цел(ВыборкаДокументов.ВыдатьГорючего);
		Если (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть = 0) Тогда
			ПараметрыПрописи = ",,,,,,,,0";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		ИначеЕсли (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть > 0) Тогда
			ПараметрыПрописи = "целая, целых, целых, ж, сотая, сотых, сотых, м, 2";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		КонецЕсли;	
		СтруктураДанных.Вставить("ВыдатьГорючегоПрописью", КоличествоЛитровГСМ);	
		
		//Движение горючего
		ВыборкаГорючее = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаГорючее.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 1 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Горючего", ВыборкаГорючее.МаркаГорючего);
			СтруктураДанных.Вставить("КодМарки"+НомерСтроки+"Горючего", ВыборкаГорючее.КодМаркиГорючего);
			СтруктураДанных.Вставить("Выдано"+НомерСтроки+"Горючего", ВыборкаГорючее.ВыданоГорючее);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВыезде", ВыборкаГорючее.ОстатокГорючегоПриВыезде);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВозвращении", ВыборкаГорючее.ОстатокГорючегоПриВозвращении);
			СтруктураДанных.Вставить("Сдано"+НомерСтроки+"Горючего", ВыборкаГорючее.СданоГорючее);
			СтруктураДанных.Вставить("Коэффициент"+НомерСтроки+"Горючего", ВыборкаГорючее.КоэффициентИзмененияНормы);
			СтруктураДанных.Вставить("ВремяРаботы"+НомерСтроки+"Спецоборудования", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаГорючее.ВремяРаботыСпецоборудования));
			СтруктураДанных.Вставить("ВремяРаботы"+НомерСтроки+"Двигателя", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаГорючее.ВремяРаботыДвигателя)); 
		КонецЦикла;
		
		//Талоны на топливо
		ВыданыТалоныНаТопливо = Ложь;
		ТалоныНаТопливо = "";
		ВыборкаТалоны = ВыборкаДокументов.ВыданныеТалоныНаГорючее.Выбрать();
		
		Пока ВыборкаТалоны.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаТалоны.ДенежныйДокумент) Тогда
				ТалоныНаТопливо = ТалоныНаТопливо + СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Серия)+" "+СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Номер)+"; ";
				
				ВыданыТалоныНаТопливо = Истина;
			КонецЕсли;
		КонецЦикла;
		СтруктураДанных.Вставить("ТалоныНаТопливо", ТалоныНаТопливо);
		
		//Задание водителю
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		КоличествоСтрокВЗадании = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Заказчик"+НомерСтроки+"НаименованиеАдрес", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика)+", "+СокрЛП(ВыборкаЗадания.АдресЗаказчика));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Прибытие", Формат(ВыборкаЗадания.ВремяПрибытия,"ДФ=""ЧЧ:мм"""));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Убытие", Формат(ВыборкаЗадания.ВремяУбытия,"ДФ=""ЧЧ:мм"""));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЧасов);
			СтруктураДанных.Вставить("Ездки"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЕздок);
			СтруктураДанных.Вставить("Вид"+НомерСтроки+"Работы", СокрЛП(ВыборкаЗадания.ВидРаботы));
			
			СтруктураДанных.Вставить("Заказчик"+НомерСтроки+"Наименование", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика));
			
			КоличествоСтрокВЗадании = КоличествоСтрокВЗадании + 1;
		КонецЦикла;
		
		//Прицепы
		ВыборкаПрицепы = ВыборкаДокументов.Прицепы.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаПрицепы.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 1 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьМаркуТС(ВыборкаПрицепы.Прицеп));
			СтруктураДанных.Вставить("ГосНомер"+НомерСтроки+"Прицепа", ВыборкаПрицепы.РегистрационныйНомернойЗнак);
			СтруктураДанных.Вставить("ГаражныйНомер"+НомерСтроки+"Прицепа", ВыборкаПрицепы.ГаражныйНомер);
		КонецЦикла;
		
		//Ответственные за безопасность груза
		ВыборкаОтветственнных = ВыборкаДокументов.ОтветственныеЗаГруз.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаОтветственнных.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
		
			СтруктураДанных.Вставить("ДолжностьФИООтветственного"+НомерСтроки+"ЗаГруз", СокрЛП(ВыборкаОтветственнных.ДолжностьОтветственного)+", "+СокрЛП(ВыборкаОтветственнных.ФИООтветственного));
			
			СтруктураДанных.Вставить("ДолжностьФИООтветственногоОтЗаказчика"+НомерСтроки+"ЗаГруз", СокрЛП(ВыборкаОтветственнных.ДолжностьОтветственногоОтЗаказчика)+", "+СокрЛП(ВыборкаОтветственнных.ФИООтветственногоОтЗаказчика));
		КонецЦикла;
		
		//Такелажники
		ВыборкаТакелажники = ВыборкаДокументов.Такелажники.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаТакелажники.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
		
			СтруктураДанных.Вставить("Такелажник"+НомерСтроки+"ФамилияИнициалы", СокрЛП(ВыборкаТакелажники.ФамилияИнициалыТакелажника));
			СтруктураДанных.Вставить("Такелажник"+НомерСтроки+"НомерУдостоверения", СокрЛП(ВыборкаТакелажники.НомерУдостоверения));
		КонецЦикла;
		
	
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВыпускающийТСДиспетчер, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ДиспетчерВыпустилИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.ЛицоДопускающееВодителяПоСостояниюЗдоровья, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ДолжностьМедРаботника", ДанныеСотрудника.Должность);
		СтруктураДанных.Вставить("МедРаботник", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВыездРазрешилМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикВыпустилТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ПринялТСМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительПринялТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительСдалТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительСдалТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ТаксировщикПутевогоЛиста, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("Таксировщик", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		СтруктураДанных.Вставить("СтандартнаяКарточка", 	"стандартная, ");
		СтруктураДанных.Вставить("ОграниченнаяКарточка", 	"ограниченная");
		
		//вывод областей табличного документа
		ДанныеВодителя = УчетГСМ.ПолучитьДанныеВодителя(СтруктураДанных.Водитель, СтруктураДанных.ДатаПутевогоЛиста);
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Водитель, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
		СтруктураДанных.Водитель = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
			
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(СтруктураДанных);
		Область.Параметры.Заполнить(ДанныеВодителя);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		ЗачеркнутыйШрифт = Новый Шрифт("Arial",9,,,,Истина);
		Если ЗначениеЗаполнено(СтруктураДанных.ЛицензионнаяКарточка) Тогда
			Если СтруктураДанных.ЛицензионнаяКарточка.ОграниченнаяКарточка Тогда
				ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			Иначе
				ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			КонецЕсли;
		Иначе
			ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
		КонецЕсли;	
		
		Область = Макет.ПолучитьОбласть("РаботаВодителяТСДвижениеГорючего");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);

		ТабличныйДокумент.Вывести(Область);
		
		Если КоличествоСтрокВЗадании > 0 Тогда
			Если ЗначениеЗаполнено(СокрЛП(СтруктураДанных.ОсобыеОтметки)) Тогда
				Область = Макет.ПолучитьОбласть("ЗаданиеВодителюОтметкиЗаполнены");
			Иначе
				Область = Макет.ПолучитьОбласть("ЗаданиеВодителюЗаполненоОтметкиПусты");
			КонецЕсли;	
		Иначе
			Область = Макет.ПолучитьОбласть("ЗаданиеВодителюПустое");
		КонецЕсли;	
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		
		Область = Макет.ПолучитьОбласть("ЗаголовокОборотнойСтороны");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ВыполнениеЗадания");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ОтветственныеЗаГрузИТакелажники");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("РезультатРаботыТС");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист3спец";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист3спец.ПФ_MXL_Форма0345002_368");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист3спец.Ссылка КАК Ссылка,
	|	ПутевойЛист3спец.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист3спец.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист3спец.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист3спец.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист3спец.СрокДействия,
	|	ПутевойЛист3спец.ТранспортноеСредство,
	|	ПутевойЛист3спец.Водитель,
	|	ПутевойЛист3спец.ЛицензионнаяКарточка,
	|	ПутевойЛист3спец.Комментарий,
	|	ПутевойЛист3спец.ВремяВыездаТС,
	|	ПутевойЛист3спец.ВремяВозвращенияТС,
	|	ПутевойЛист3спец.ВыпускающийТСДиспетчер,
	|	ПутевойЛист3спец.ЛицоДопускающееВодителяПоСостояниюЗдоровья,
	|	ПутевойЛист3спец.ОсобыеОтметки,
	|	ПутевойЛист3спец.ВодительПринялТС,
	|	ПутевойЛист3спец.ВодительСдалТС,
	|	ПутевойЛист3спец.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист3спец.ВыездРазрешилМеханик,
	|	ПутевойЛист3спец.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист3спец.ПринялТСМеханик,
	|	ПутевойЛист3спец.РасчетЗаработнойПлаты,
	|	ПутевойЛист3спец.ТаксировщикПутевогоЛиста,
	|	ПутевойЛист3спец.НулевойПробегПриВыезде,
	|	ПутевойЛист3спец.НулевойПробегПриВозвращении,
	|	ПутевойЛист3спец.ВремяВыездаТСФактическое,
	|	ПутевойЛист3спец.ВремяВозвращенияТСФактическое,
	|	ПутевойЛист3спец.ПриВозвращенииТСНеисправно,
	|	ПутевойЛист3спец.РежимРаботы,
	|	ПутевойЛист3спец.ВыдатьГорючего,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛист3спец.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист3спец.ГаражныйНомер,
	|	ПутевойЛист3спец.Бригада,
	|	ПутевойЛист3спец.Колонна,
	|	ПутевойЛист3спец.СведенияОПеревозке,
	|	ВЫРАЗИТЬ(ПутевойЛист3спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК ОрганизацияСокращенно,
	|	ПутевойЛист3спец.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		АдресЗаказчика,
	|		ВремяПрибытия,
	|		ВремяУбытия,
	|		КоличествоЧасов,
	|		КоличествоЕздок,
	|		ВидРаботы
	|	),
	|	ПутевойЛист3спец.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВыезде,
	|		ОстатокГорючегоПриВозвращении,
	|		СданоГорючее,
	|		КоэффициентИзмененияНормы,
	|		ВремяРаботыСпецоборудования,
	|		ВремяРаботыДвигателя
	|	),
	|	ПутевойЛист3спец.ВыданныеТалоныНаГорючее.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДенежныйДокумент
	|	),
	|	ПутевойЛист3спец.ОтветственныеЗаГруз.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИООтветственного,
	|		ДолжностьОтветственного,
	|		ФИООтветственногоОтЗаказчика,
	|		ДолжностьОтветственногоОтЗаказчика
	|	),
	|	ПутевойЛист3спец.Такелажники.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФамилияИнициалыТакелажника,
	|		НомерУдостоверения
	|	),
	|	ПутевойЛист3спец.Прицепы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Прицеп,
	|		ГаражныйНомер,
	|		РегистрационныйНомернойЗнак
	|	)
	|ИЗ
	|	Документ.ПутевойЛист3спец КАК ПутевойЛист3спец
	|ГДЕ
	|	ПутевойЛист3спец.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345002";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
