&НаКлиенте
Процедура РаспределениеОбщихЗатратКорСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОбщиеЗатраты.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетУчета)
		И (Счета10970.НайтиПоЗначению(ТекущиеДанные.СчетУчета) = Неопределено
		 И Счета10980.НайтиПоЗначению(ТекущиеДанные.СчетУчета) = Неопределено) Тогда
		СписокСчетов = Новый Массив;
		СписокСчетов.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н20.01"));
	Иначе
		СписокСчетов = Счета10960;
	КонецЕсли;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетУчета, 
																			ТекущиеДанные.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															СписокСчетов,
															Объект.КФО,
															,
															Объект.Дата);
	
КонецПроцедуры

