&НаКлиенте
Процедура ДоляРасходовНеУчитываетсяНУПриИзменении(Элемент)
	
	Если Объект.ДоляРасходовНеУчитываетсяНУ > 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Доля распределяемых расходов, относящихся к уставной бюджетной деятельности, не направленной на получение дохода, не может превышать единицу (100%)!'"));
		Объект.ДоляРасходовНеУчитываетсяНУ   = ЭтотОбъект.КэшПараметров.Локальные.ДоляРасходовНеУчитываетсяНУ; // Восстанавливаем прежнее значение.
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();
	Если Не ЕстьДанныеВДокументе Тогда
		УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено, а данные будут перезаполнены. Продолжить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут перезаполнены. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ДоляРасходовНеУчитываетсяНУПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументВФонеНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

