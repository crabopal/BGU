&НаКлиенте
Процедура ОбщиеЗатратыПередНачаломИзменения(Элемент, Отказ)
	
	СтрокаОбщиеЗатраты = Элементы.ОбщиеЗатраты.ТекущиеДанные;
	
	Если СтрокаОбщиеЗатраты.БазаРаспределения <>
			ПредопределенноеЗначение("Перечисление.БазыРаспределенияКосвенныхЗатрат.РучноеРаспределение") Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'Будет установлен признак ручного распределения затрат в колонке ""База распределения"".
			|Установить ручное распределение затрат и продолжить редактирование?'");
		Оповещение = Новый ОписаниеОповещения("ВопросУстановитьРучноеРаспределениеЗатратЗавершение", ЭтотОбъект,
			Новый Структура("СтрокаОбщиеЗатраты,ИмяТаблицы,Действие", СтрокаОбщиеЗатраты, "ОбщиеЗатраты", "ИзменитьСтроку"));
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, СтрокаОбщиеЗатраты.СчетУчета, ОбщиеЗатратыПоляАналитикиСчетаУчета());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеЗатратыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.ОбщиеЗатраты.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки = Новый УникальныйИдентификатор;
		
		ТекущиеДанные.БазаРаспределения =
			ПредопределенноеЗначение("Перечисление.БазыРаспределенияКосвенныхЗатрат.РучноеРаспределение");
		ТекущиеДанные.СуммаБазы = 0;
		ТекущиеДанные.СуммаБазыЕНВД = 0;
		ТекущиеДанные.СуммаБазыНеУчитываетсяНУ = 0;
		
		ТекущиеДанные.Сумма = 0;
		ТекущиеДанные.СуммаЕНВД = 0;
		ТекущиеДанные.СуммаНеУчитываетсяНУ = 0;
		
		ТекущийСписок = СписокСчетовОбщихЗатрат();
		Если ТекущийСписок.Количество() = 1 Тогда
			ТекущиеДанные.СчетУчета = ТекущийСписок[0].Значение;
			УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
			ЗаполнитьПоясненияКСуммамВСтрокеОбщиеЗатраты(ТекущиеДанные, ТекущиеДанные.СчетУчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

