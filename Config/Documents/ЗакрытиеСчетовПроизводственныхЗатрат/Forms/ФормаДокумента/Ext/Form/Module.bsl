&НаКлиенте
Процедура РаспределениеОбщихЗатратПередУдалением(Элемент, Отказ)
	
	СтрокаОбщиеЗатраты = Элементы.ОбщиеЗатраты.ТекущиеДанные;
	
	Если СтрокаОбщиеЗатраты.БазаРаспределения <>
			ПредопределенноеЗначение("Перечисление.БазыРаспределенияКосвенныхЗатрат.РучноеРаспределение") Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'Будет установлен признак ручного распределения затрат в колонке ""База распределения"".
			|Установить ручное распределение затрат и продолжить редактирование?'");
		Оповещение = Новый ОписаниеОповещения("ВопросУстановитьРучноеРаспределениеЗатратЗавершение", ЭтотОбъект,
			Новый Структура("СтрокаОбщиеЗатраты,ИмяТаблицы,Действие", СтрокаОбщиеЗатраты, "РаспределениеОбщихЗатрат", "УдалитьСтроку"));
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбщихЗатратПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.РаспределениеОбщихЗатрат.ТекущиеДанные;
		
		Если Счета10960.Количество() = 1 Тогда
			ТекущиеДанные.СчетУчета = Счета10960[0].Значение;
			УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
		КонецЕсли;
		
		СтрокаОбщиеЗатраты = Элементы.ОбщиеЗатраты.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки = СтрокаОбщиеЗатраты.ИдСтроки;
		ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(ТекущиеДанные, СтрокаОбщиеЗатраты);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбщихЗатратПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеОбщиеЗатраты = Элементы.ОбщиеЗатраты.ТекущиеДанные;
	Если ТекущиеОбщиеЗатраты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		РассчитатьСуммыБазыВСтрокеОбщиеЗатраты(ТекущиеОбщиеЗатраты);
		РассчитатьСуммыПриИзмененииБазыРаспределения(ТекущиеОбщиеЗатраты);
		РассчитатьСуммыВСтрокеОбщиеЗатраты(ТекущиеОбщиеЗатраты);
	КонецЕсли;
	
КонецПроцедуры

