&НаКлиенте
Процедура ПроверитьКорректностьУчетаПЗ(Команда)
	
	Уникальность = "Отчет.КонтрольВеденияПроизводственногоУчета/КлючВарианта.ПроверкаПроизводственногоУчета";
	ПараметрыОтчета = Новый Структура("СформироватьПриОткрытии", Истина);
	ПараметрыОтчета.Вставить("КлючВарианта",                     "ПроверкаПроизводственногоУчета");
	ПараметрыОтчета.Вставить("КлючПараметровПечати",             Уникальность);
	ПараметрыОтчета.Вставить("КлючСохраненияПоложенияОкна",      Уникальность);
	ПараметрыОтчета.Вставить("ВидимостьКомандВариантовОтчетов",  Ложь);
	ПараметрыОтчета.Вставить("Отбор",                            Новый Структура);
	
	ПериодОтчета = Новый СтандартныйПериод(ВариантСтандартногоПериода.Месяц);
	ПериодОтчета.ДатаНачала    = НачалоМесяца(Объект.Дата);
	ПериодОтчета.ДатаОкончания = КонецМесяца(Объект.Дата);
	ПараметрыОтчета.Отбор.Вставить("Организация", Объект.Организация);
	ПараметрыОтчета.Отбор.Вставить("Период", ПериодОтчета);

	ОткрытьФорму("Отчет.КонтрольВеденияПроизводственногоУчета.ФормаОбъекта", ПараметрыОтчета);
КонецПроцедуры

