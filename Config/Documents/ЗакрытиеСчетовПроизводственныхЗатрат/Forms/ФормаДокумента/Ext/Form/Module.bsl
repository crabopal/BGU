&НаКлиенте
Процедура ПерейтиКПредыдущейСтранице(Команда)
	
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	ТекущаяСтраницаСписка = СтраницыФормы.НайтиПоЗначению(ТекущаяСтраница.Имя);
	ИндексТекущейСтраницыСписка = СтраницыФормы.Индекс(ТекущаяСтраницаСписка);
	
	Если ИндексТекущейСтраницыСписка > 0 Тогда // не первая
		ПредыдущаяСтраницаСписка = СтраницыФормы.Получить(ИндексТекущейСтраницыСписка - 1);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ПредыдущаяСтраницаСписка.Значение];
		ПриИзмененииТекущейСтраницыФормы(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКСледующейСтранице(Команда)
	
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	ТекущаяСтраницаСписка = СтраницыФормы.НайтиПоЗначению(ТекущаяСтраница.Имя);
	ИндексТекущейСтраницыСписка = СтраницыФормы.Индекс(ТекущаяСтраницаСписка);
	
	Если ИндексТекущейСтраницыСписка < СтраницыФормы.Количество() - 1 Тогда // не последняя
		СледующаяСтраницаСписка = СтраницыФормы.Получить(ИндексТекущейСтраницыСписка + 1);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[СледующаяСтраницаСписка.Значение];
		ПриИзмененииТекущейСтраницыФормы(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументВФоне(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументВФонеНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДолюРасходовНеучитываемыхНУ(Команда)
	
	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено, а данные будут перезаполнены. Продолжить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут перезаполнены. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		ДополнительныеПараметры = Новый Структура("ЕстьДанныеВДокументе", ЕстьДанныеВДокументе);
		Оповещение = Новый ОписаниеОповещения("РассчитатьДолюРасходовНеучитываемыхНУЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе // НЕ ЕстьДанныеВДокументе
		Объект.ДоляРасходовНеУчитываетсяНУ = ДоляРасходовНеучитываемыхНУ(НачалоМесяца(Объект.Дата), КонецМесяца(Объект.Дата), Объект.Организация);
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоляРасходовНеУчитываетсяНУ", Объект.ДоляРасходовНеУчитываетсяНУ);
		УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

