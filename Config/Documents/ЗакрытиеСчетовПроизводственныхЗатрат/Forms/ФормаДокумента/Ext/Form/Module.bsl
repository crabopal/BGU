		"Объект.КорректировкаСписанияЗатрат.КорСубконто2",
		"Объект.КорректировкаСписанияЗатрат.КорСубконто3");

КонецФункции

&НаСервере
Процедура КорректировкаСписанияЗатратЗаполнитьДобавленныеКолонки()
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
		Объект.КорректировкаСписанияЗатрат, "СчетУчета",
		КорректировкаСписанияЗатратПоляАналитикиСчетаУчета());
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
		Объект.КорректировкаСписанияЗатрат, "КорСчет",
		КорректировкаСписанияЗатратПоляАналитикиКорСчета());
КонецПроцедуры

// Общие процедуры и функции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовкиКолонокПояснение(ЭтоНУ = Ложь)
	ЗаголовкиКолонок = Новый Структура;
	Если ЭтоНУ Тогда
		ЗаголовкиКолонок.Вставить("НадписьСумма", НСтр("ru = 'Сумма (НУ):'"));
		ЗаголовкиКолонок.Вставить("НадписьСуммаНеУчитываетсяНУ", НСтр("ru = 'Не уч. (НУ):'"));
		ЗаголовкиКолонок.Вставить("НадписьСуммаЕНВД", НСтр("ru = 'ЕНВД (НУ):'"));
	Иначе
		ЗаголовкиКолонок.Вставить("НадписьСумма", НСтр("ru = 'Сумма:'"));
	КонецЕсли;
	Возврат ЗаголовкиКолонок;
КонецФункции

&НаСервере
Процедура УстановитьПризнакНаправленияДеятельностиПодразделенияВТаблице(Таблица)
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(СтрокаТаблицы, ДанныеСчетов);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоляРасходовУчитываетсяНУ(Форма)
	Форма.ДоляРасходовУчитываетсяНУ = 1 - Форма.Объект.ДоляЕНВД - Форма.Объект.ДоляРасходовНеУчитываетсяНУ;
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьПараметрыУчетнойПолитикиНаСервере();
	
	ТекущийИФО = Объект.ИФО;
	ТекущийКФО = Объект.КФО;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоляРасходовНеУчитываетсяНУ", Объект.ДоляРасходовНеУчитываетсяНУ);
	УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
	
	ЗаполнитьДанныеСчетов();
	
	// Если документ скопирован, все строки помечаем как распределенные вручную.
	Если Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Для Каждого СтрокаТаблицы Из Объект.РаспределениеОбщихЗатрат Цикл
			СтрокаТаблицы.БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.РучноеРаспределение;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьТаблицуОбщиеЗатраты();
	
	СписаниеРасходовНУЗаполнитьДобавленныеКолонки();
	ОбщиеЗатратыЗаполнитьДобавленныеКолонки();
	РаспределениеОбщихЗатратЗаполнитьДобавленныеКолонки();
	РасчетСебестоимостиПродукцииЗаполнитьДобавленныеКолонки();
	КорректировкаСписанияПродукцииЗаполнитьДобавленныеКолонки();
	КорректировкаРаспределенияЗатратЗаполнитьДобавленныеКолонки();
	КорректировкаСписанияЗатратЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);
	УстановитьВидимостьНаправленияДеятельностиПодразделения();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма, Объект)

	Форма.Элементы.ГруппаОтражатьВУчете.Видимость = Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	
	Форма.Элементы.СтраницаРаспределениеОбщихЗатрат.Видимость =
		Форма.РаспределятьОбщепроизводственныеЗатраты ИЛИ Форма.РаспределятьОбщехозяйственныеЗатраты;
	
	// Налоговый учет
	Если ЗначениеЗаполнено(Объект.КФО) Тогда
		ВидимостьЭлементовНалоговогоУчета = Объект.ОтражатьВНалоговомУчете
			И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	Иначе
		ВидимостьЭлементовНалоговогоУчета = Объект.ОтражатьВНалоговомУчете
			И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	КонецЕсли;
	
	Форма.Элементы.СтраницаРасчетРасходовНУ.Видимость = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.СтраницаСписаниеРасходовНУ.Видимость = ВидимостьЭлементовНалоговогоУчета;
	
	Форма.Элементы.ОбщиеЗатратыГруппаПоясненияКСуммам.Видимость = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ОбщиеЗатратыСуммаЕНВД.Видимость              = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ОбщиеЗатратыСуммаНеУчитываетсяНУ.Видимость   = ВидимостьЭлементовНалоговогоУчета;
	
	Форма.Элементы.РаспределениеОбщихЗатратСуммаБазыЕНВД.Видимость              = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РаспределениеОбщихЗатратСуммаБазыНеУчитываетсяНУ.Видимость   = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РаспределениеОбщихЗатратКоэффициентЕНВД.Видимость            = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РаспределениеОбщихЗатратКоэффициентНеУчитываетсяНУ.Видимость = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РаспределениеОбщихЗатратСуммаЕНВД.Видимость                  = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РаспределениеОбщихЗатратСуммаНеУчитываетсяНУ.Видимость       = ВидимостьЭлементовНалоговогоУчета;
	
	// Синхронизируем доступные страницы документа с механизмом переключения страниц.
	Форма.СтраницыФормы.Очистить();
	Форма.Элементы.СтраницаФормыТекущая.СписокВыбора.Очистить();
	Для Каждого СтраницаФормы Из Форма.Элементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
		Если СтраницаФормы.Видимость Тогда
			Форма.СтраницыФормы.Добавить(СтраницаФормы.Имя, СтраницаФормы.Заголовок);
			Форма.Элементы.СтраницаФормыТекущая.СписокВыбора.Добавить(СтраницаФормы.Имя, СтраницаФормы.Заголовок);
		КонецЕсли;
	КонецЦикла;
	Если НЕ Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница.Видимость Тогда
		Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница = Форма.Элементы.СтраницаРасчетСебестоимостиПродукции;
	КонецЕсли;
	ПриИзмененииТекущейСтраницыФормы(Форма);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНаправленияДеятельностиПодразделения()

	ВидимостьНаправленияДеятельности	= Ложь;
	ВидимостьПодразделения				= Ложь;
	Для каждого ТекСчет Из Счета10960 Цикл
	
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
			ВидимостьНаправленияДеятельности = Истина;
		КонецЕсли;
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
			ВидимостьПодразделения = Истина;
		КонецЕсли;
		
		Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла; 
	
	Элементы.РаспределениеОбщихЗатратКорНаправлениеДеятельности.Видимость	= ВидимостьНаправленияДеятельности;
	Элементы.РаспределениеОбщихЗатратКорПодразделение.Видимость				= ВидимостьПодразделения;
	
	ВидимостьНаправленияДеятельности	= Ложь;
	ВидимостьПодразделения				= Ложь;
	Для каждого ТекСчет Из Счета10970 Цикл
	
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
			ВидимостьНаправленияДеятельности = Истина;
		КонецЕсли;
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
			ВидимостьПодразделения = Истина;
		КонецЕсли;
		
		Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	Если Не (ВидимостьНаправленияДеятельности И ВидимостьПодразделения) Тогда
		Для каждого ТекСчет Из Счета10980 Цикл
		
			Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
				ВидимостьНаправленияДеятельности = Истина;
			КонецЕсли;
			Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
				ВидимостьПодразделения = Истина;
			КонецЕсли;
			
			Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	Элементы.ОбщиеЗатратыНаправлениеДеятельности.Видимость	= ВидимостьНаправленияДеятельности;
	Элементы.ОбщиеЗатратыПодразделение.Видимость			= ВидимостьПодразделения;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекСтрока, ДанныеСчетов)

	ДанныеСчета = ДанныеСчетов.Получить(ТекСтрока.СчетУчета);
	Если ДанныеСчета = Неопределено Тогда
		ТекСтрока.ЕстьНаправлениеДеятельности	= Ложь;
		ТекСтрока.ЕстьПодразделение				= Ложь;
	Иначе
		ТекСтрока.ЕстьНаправлениеДеятельности	= ДанныеСчета.ЕстьНаправлениеДеятельности;
		ТекСтрока.ЕстьПодразделение				= ДанныеСчета.ЕстьПодразделение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетов()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	|	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ЕПСБУ.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Код = ""109.60"")
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	|	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ЕПСБУ.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Код = ""109.70"")
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	|	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ЕПСБУ.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Код = ""109.80"")
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
	Результат = Запрос.ВыполнитьПакет();
	ДанныеИспользуемыхСчетов = Новый Соответствие;
	
	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10960.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10970.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10980.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	ДанныеСчетов = Новый ФиксированноеСоответствие(ДанныеИспользуемыхСчетов);

КонецПроцедуры

&НаКлиенте
Функция СписокСчетовОбщихЗатрат()

	Список = Новый СписокЗначений;
	
	// Бухгалтерский учет
	Для Каждого Счет10970 Из Счета10970 Цикл
		Список.Добавить(Счет10970.Значение);
	КонецЦикла;
	Для Каждого Счет10980 Из Счета10980 Цикл
		Список.Добавить(Счет10980.Значение);
	КонецЦикла;
	
	// Налоговый учет
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль И Объект.ОтражатьВНалоговомУчете Тогда
		Список.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н25.01"));
		Список.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н26.01"));
	КонецЕсли;
	
	Возврат Список;

КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыУчетнойПолитикиНаСервере()
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата);
	
	РаспределятьОбщепроизводственныеЗатраты = УчетнаяПолитика.РаспределятьОПЗ;
	РаспределятьОбщехозяйственныеЗатраты    = УчетнаяПолитика.РаспределятьОХЗ;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументВФонеНаКлиенте()
	РезультатЗадания = ЗаполнитьДокументВФонеНаСервере();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеДокументаВФоне", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещения, ПараметрыОжидания);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДокументВФонеНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;

	Объект.РаспределениеОбщихЗатрат.Очистить();
	Объект.СписаниеРасходовНУ.Очистить();
	Объект.РасчетСебестоимостиПродукции.Очистить();
	Объект.ФактическаяСтоимостьПродукции.Очистить();
	Объект.КорректировкаСписанияПродукции.Очистить();
	Объект.КорректировкаРаспределенияЗатрат.Очистить();
	Объект.КорректировкаСписанияЗатрат.Очистить();

	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = СтрШаблон(НСтр("ru = 'Заполнение закрытия счетов производственных затрат №%1 от %2'"),
		Объект.Номер, Объект.Дата);
		
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДанныеШапки", ДанныеШапкиДокумента());
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ЗаполнитьЗакрытиеСчетовПроизводственныхЗатратВФоне",
		ПараметрыПроцедуры, ПараметрыЗадания);

КонецФункции

&НаСервере
Функция ДанныеШапкиДокумента()

	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Дата", Объект.Дата);
	Для каждого РеквизитШапки Из Объект.Ссылка.Метаданные().Реквизиты Цикл
	
		ДанныеШапки.Вставить(РеквизитШапки.Имя, Объект[РеквизитШапки.Имя]);
	
	КонецЦикла; 
	Возврат ДанныеШапки;

КонецФункции

&НаКлиенте
Процедура ЗавершитьЗаполнениеДокументаВФоне(ДлительнаяОперация, ДополнительныеПараметры) Экспорт

	Если ДлительнаяОперация = Неопределено Тогда
		Возврат; // Отменено
	КонецЕсли;

	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		ЗаполнитьДанныеВДокумент(ДлительнаяОперация.АдресРезультата);
		УстановитьОтборВТаблицеРаспределениеОбщихЗатрат();
	Иначе
		ДанныеОшибки = Новый Массив;
		ДанныеОшибки.Добавить(НСтр("ru = 'Ошибка при заполнении:'"));
		ДанныеОшибки.Добавить(ДлительнаяОперация.КраткоеПредставлениеОшибки);
		ВызватьИсключение СтрСоединить(ДанныеОшибки, Символы.ПС);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВДокумент(АдресРезультата)

	РезультатЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	ЗаполнитьЗначенияСвойств(Объект, РезультатЗаполнения.ДанныеШапки);
	Для Каждого ТабличнаяЧасть Из Объект.Ссылка.Метаданные().ТабличныеЧасти Цикл
		ДанныеТабличнойЧасти = РезультатЗаполнения[ТабличнаяЧасть.Имя];
		Объект[ТабличнаяЧасть.Имя].Загрузить(ДанныеТабличнойЧасти);
	КонецЦикла;
	
	УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
	
	ЗаполнитьТаблицуОбщиеЗатраты();
	
	СписаниеРасходовНУЗаполнитьДобавленныеКолонки();
	ОбщиеЗатратыЗаполнитьДобавленныеКолонки();
	РаспределениеОбщихЗатратЗаполнитьДобавленныеКолонки();
	РасчетСебестоимостиПродукцииЗаполнитьДобавленныеКолонки();
	КорректировкаСписанияПродукцииЗаполнитьДобавленныеКолонки();
	КорректировкаРаспределенияЗатратЗаполнитьДобавленныеКолонки();
	КорректировкаСписанияЗатратЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);

КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеВДокументе()
	
	Возврат (Объект.РаспределениеОбщихЗатрат.Количество() > 0)
		ИЛИ (Объект.СписаниеРасходовНУ.Количество() > 0)
		ИЛИ (Объект.РасчетСебестоимостиПродукции.Количество() > 0)
		ИЛИ (Объект.ФактическаяСтоимостьПродукции.Количество() > 0)
		ИЛИ (Объект.КорректировкаСписанияПродукции.Количество() > 0)
		ИЛИ (Объект.КорректировкаРаспределенияЗатрат.Количество() > 0)
		ИЛИ (Объект.КорректировкаСписанияЗатрат.Количество() > 0);
	
КонецФункции

&НаКлиенте
Процедура ВопросОчиститьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда // Очищаем документ.
		
		ОбщиеЗатраты.Очистить();
		Объект.РаспределениеОбщихЗатрат.Очистить();
		Объект.СписаниеРасходовНУ.Очистить();
		Объект.РасчетСебестоимостиПродукции.Очистить();
		Объект.ФактическаяСтоимостьПродукции.Очистить();
		Объект.КорректировкаСписанияПродукции.Очистить();
		Объект.КорректировкаРаспределенияЗатрат.Очистить();
		Объект.КорректировкаСписанияЗатрат.Очистить();
		
	Иначе // Восстанавливаем предыдущее значение реквизита.
		
		Если ДополнительныеПараметры.Реквизит = "ИФО" Тогда
			Объект.ИФО = ТекущийИФО;
		ИначеЕсли ДополнительныеПараметры.Реквизит = "КФО" Тогда
			Объект.КФО = ТекущийКФО;
		ИначеЕсли ДополнительныеПараметры.Реквизит = "ОтражатьВБухгалтерскомУчете" Тогда
			Объект.ОтражатьВБухгалтерскомУчете = НЕ Объект.ОтражатьВБухгалтерскомУчете;
		ИначеЕсли ДополнительныеПараметры.Реквизит = "ОтражатьВНалоговомУчете" Тогда
			Объект.ОтражатьВНалоговомУчете = НЕ Объект.ОтражатьВНалоговомУчете;
		КонецЕсли;
		
		УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоляРасходовНеучитываемыхНУ(НачалоПериода, КонецПериода, Организация)
	
	// В соответствии со статьей 252 НК РФ в целях исчисления налога на прибыль организаций
	// расходами признаются экономически оправданные и документально подтвержденные расходы при условии,
	// что они произведены для осуществления деятельности, направленной на получение дохода.
	Возврат 1 - НалоговыйУчет.ДоляПриносящейДоходДеятельности(НачалоПериода, КонецПериода, Организация);
	
КонецФункции

