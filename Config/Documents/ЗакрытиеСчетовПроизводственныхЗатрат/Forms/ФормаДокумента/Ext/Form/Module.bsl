&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьПараметрыУчетнойПолитикиНаСервере();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(СтруктураПериода, ДополнительныеПараметры) Экспорт
	
	Если СтруктураПериода <> Неопределено Тогда // Установим выбранный период.
		
		Объект.Дата = КонецМесяца(СтруктураПериода.КонецПериода);
		
		// Представление выбранного периода запомним в кэше в локальных параметрах.
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ПредставлениеПериода", СтруктураПериода.Период);
		
		ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
		// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
		// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	// Установим представление выбранного периода в реквизите формы документа.
	ПредставлениеПериодаРегистрации = ЭтотОбъект.КэшПараметров.Локальные.ПредставлениеПериода;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		ЗаполнитьПараметрыУчетнойПолитикиНаСервере();
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоляРасходовНеУчитываетсяНУПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументВФонеНаКлиенте();
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоляРасходовНеУчитываетсяНУ", Объект.ДоляРасходовНеУчитываетсяНУ);
	Иначе
		Объект.ДоляРасходовНеУчитываетсяНУ   = ЭтотОбъект.КэшПараметров.Локальные.ДоляРасходовНеУчитываетсяНУ; // Восстанавливаем прежнее значение.
		УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииТекущейСтраницыФормы(Форма)
	
	ТекущаяСтраница = Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница;
	ТекущаяСтраницаСписка = Форма.СтраницыФормы.НайтиПоЗначению(ТекущаяСтраница.Имя);
	ИндексТекущейСтраницыСписка = Форма.СтраницыФормы.Индекс(ТекущаяСтраницаСписка);
	
	ЭтоПерваяСтраница    = (ИндексТекущейСтраницыСписка = 0);
	ЭтоПоследняяСтраница = (ИндексТекущейСтраницыСписка = Форма.СтраницыФормы.Количество() - 1);
	
	Форма.СтраницаФормыПредыдущая = ?(ЭтоПерваяСтраница, "",
		Форма.СтраницыФормы.Получить(ИндексТекущейСтраницыСписка - 1).Представление);
	
	Форма.СтраницаФормыТекущая    = Форма.СтраницыФормы.Получить(ИндексТекущейСтраницыСписка).Представление;
	
	Форма.СтраницаФормыСледующая  = ?(ЭтоПоследняяСтраница, "",
		Форма.СтраницыФормы.Получить(ИндексТекущейСтраницыСписка + 1).Представление);
	
	Форма.Элементы.КнопкаПредыдущаяСтраница.Доступность = НЕ ЭтоПерваяСтраница;
	Форма.Элементы.КнопкаСледующаяСтраница.Доступность  = НЕ ЭтоПоследняяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументВФонеНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДолюРасходовНеучитываемыхНУЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Объект.ДоляРасходовНеУчитываетсяНУ = ДоляРасходовНеучитываемыхНУ(НачалоМесяца(Объект.Дата), КонецМесяца(Объект.Дата), Объект.Организация);
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоляРасходовНеУчитываетсяНУ", Объект.ДоляРасходовНеУчитываетсяНУ);
		УстановитьДоляРасходовУчитываетсяНУ(ЭтотОбъект);
		
		Если ДополнительныеПараметры.ЕстьДанныеВДокументе Тогда
			ЗаполнитьДокументВФонеНаКлиенте(); // Перезаполняем документ, если он был заполнен.
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Общие затраты

&НаСервере
Процедура ЗаполнитьТаблицуОбщиеЗатраты()

	ОбщиеЗатраты.Очистить();
	
	ТаблицаОбщихЗатрат = Объект.РаспределениеОбщихЗатрат.Выгрузить();
	ТаблицаОбщихЗатрат.Свернуть(
		"ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,НаправлениеДеятельности,Подразделение,БазаРаспределения",
		"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ");
	ТаблицаОбщихЗатрат.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбщихЗатрат Цикл
		
		Если СтрокаТаблицы.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСчетаТекущейСтроки = ДанныеСчетов.Получить(СтрокаТаблицы.СчетУчета);
		Если ДанныеСчетаТекущейСтроки = Неопределено Тогда
			ЕстьНД				= Ложь;
			ЕстьПодразделение	= Ложь;
		Иначе
			ЕстьНД 				= ДанныеСчетаТекущейСтроки.ЕстьНаправлениеДеятельности = Истина;
			ЕстьПодразделение	= ДанныеСчетаТекущейСтроки.ЕстьПодразделение = Истина;
		КонецЕсли;
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,БазаРаспределения");
		Если ЕстьНД Тогда
			Отбор.Вставить("НаправлениеДеятельности");
		КонецЕсли;
		Если ЕстьПодразделение Тогда
			Отбор.Вставить("Подразделение");
		КонецЕсли;
		
		ИдСтроки = Новый УникальныйИдентификатор;
		СтрокаОбщиеЗатраты = ОбщиеЗатраты.Добавить();
		СтрокаОбщиеЗатраты.ИдСтроки = ИдСтроки;
		ЗаполнитьЗначенияСвойств(СтрокаОбщиеЗатраты, СтрокаТаблицы,
			"ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,НаправлениеДеятельности,Подразделение,БазаРаспределения");
		ЗаполнитьЗначенияСвойств(СтрокаОбщиеЗатраты, СтрокаТаблицы,
			"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ");
		
		ЗаполнитьПоясненияКСуммамВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты, СтрокаОбщиеЗатраты.СчетУчета);
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаОбщиеЗатраты);
		
		НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
		Для каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
			СтрокаРаспределениеОбщихЗатрат.ИдСтроки = ИдСтроки;
			ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаТаблицы);
		КонецЦикла;
		
		ОбработанныеСтроки = ТаблицаОбщихЗатрат.НайтиСтроки(Отбор);
		Для каждого ОбработаннаяСтрока Из ОбработанныеСтроки Цикл
			ОбработаннаяСтрока.Обработано = Истина;
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты)
	
	СтрокаОбщиеЗатраты.Сумма                    = 0;
	СтрокаОбщиеЗатраты.СуммаЕНВД                = 0;
	СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ     = 0;
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		
		СтрокаОбщиеЗатраты.Сумма = СтрокаОбщиеЗатраты.Сумма
			+ СтрокаРаспределениеОбщихЗатрат.Сумма;
		СтрокаОбщиеЗатраты.СуммаЕНВД = СтрокаОбщиеЗатраты.СуммаЕНВД
			+ СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД;
		СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ = СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ
			+ СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыБазыВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты)
	
	СтрокаОбщиеЗатраты.СуммаБазы                = 0;
	СтрокаОбщиеЗатраты.СуммаБазыЕНВД            = 0;
	СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ = 0;
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		
		СтрокаОбщиеЗатраты.СуммаБазы = СтрокаОбщиеЗатраты.СуммаБазы
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазы;
		СтрокаОбщиеЗатраты.СуммаБазыЕНВД = СтрокаОбщиеЗатраты.СуммаБазыЕНВД
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазыЕНВД;
		СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ = СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбщиеЗатратыПоляАналитикиСчетаУчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, КЭК, Подразделение",
		"ОбщиеЗатраты.СчетУчета",
		"ОбщиеЗатраты.КПС",
		"ОбщиеЗатраты.КЭК",
		"ОбщиеЗатраты.Подразделение");

КонецФункции

&НаСервере
Процедура ОбщиеЗатратыЗаполнитьДобавленныеКолонки()
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
		ОбщиеЗатраты, "СчетУчета",
		ОбщиеЗатратыПоляАналитикиСчетаУчета());
	ЗаполнитьПоясненияКСуммамОбщиеЗатраты();
	УстановитьПризнакНаправленияДеятельностиПодразделенияВТаблице(ОбщиеЗатраты);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоясненияКСуммамОбщиеЗатраты()
	СчетаУчетаОбщихЗатрат = ОбщиеЗатраты.Выгрузить(, "СчетУчета");
	СчетаУчетаОбщихЗатрат.Свернуть("СчетУчета");
	ДанныеСчетовОбщихЗатрат = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из СчетаУчетаОбщихЗатрат Цикл
		ТипСчетаТаблицы = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета).ТипСчета;
		ДанныеСчетовОбщихЗатрат.Вставить(СтрокаТаблицы.СчетУчета,
			ТипСчетаТаблицы = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый"));
	КонецЦикла;
	ЗаголовкиКолонокБУ = ЗаголовкиКолонокПояснение();
	ЗаголовкиКолонокНУ = ЗаголовкиКолонокПояснение(Истина);
	Для Каждого СтрокаТаблицы Из ОбщиеЗатраты Цикл
		Если ДанныеСчетовОбщихЗатрат[СтрокаТаблицы.СчетУчета] = Истина Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокНУ);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокБУ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоясненияКСуммамВСтрокеОбщиеЗатраты(СтрокаТаблицы, СчетУчета)
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	ЭтоСчетНУ = ЗначениеЗаполнено(СвойстваСчета)
		И СвойстваСчета.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый");
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокПояснение(ЭтоСчетНУ));
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОбщиеЗатратыВДокумент(ТекущийОбъект)

	Если НЕ ТекущийОбъект.Модифицированность() Тогда
		Возврат;
	КонецЕсли;
	
	ОбработанныеСтроки = Новый Массив;
	Для Каждого СтрокаОбщиеЗатраты Из ОбщиеЗатраты Цикл
	
		Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
		НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			// Добавили строку общих затрат, но нет ни одной строки прямых затрат.
			// Добавим новую строку прямых затрат и сохраним всю информацию из строки общих затрат.
			НоваяСтрока = Объект.РаспределениеОбщихЗатрат.Добавить();
			
			Если Счета10960.Количество() = 1 Тогда
				НоваяСтрока.СчетУчета = Счета10960[0].Значение;
				УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(НоваяСтрока, ДанныеСчетов);
			КонецЕсли;
			
			ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(НоваяСтрока, СтрокаОбщиеЗатраты);
			ОбработанныеСтроки.Добавить(НоваяСтрока);
			
		Иначе
			Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
				ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты);
				ОбработанныеСтроки.Добавить(СтрокаРаспределениеОбщихЗатрат);
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
	
	// Удаляем строки прямых затрат, для которых нет соответствующей строки общих затрат.
	СтрокиКУдалению = Новый Массив;
	Для Каждого ТекСтрока Из Объект.РаспределениеОбщихЗатрат Цикл
		Если ОбработанныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
			СтрокиКУдалению.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиКУдалению.Количество() > 0 Тогда
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			Объект.РаспределениеОбщихЗатрат.Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	ТекущийОбъект.РаспределениеОбщихЗатрат.Загрузить(Объект.РаспределениеОбщихЗатрат.Выгрузить());
	
КонецПроцедуры

// Распределение общих затрат

&НаКлиенте
Процедура УстановитьОтборВТаблицеРаспределениеОбщихЗатрат()

	ТекущиеДанные = Элементы.ОбщиеЗатраты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки",
			ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.РаспределениеОбщихЗатрат.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.ИдСтроки <> НовОтборСтрок.ИдСтроки Тогда
		Элементы.РаспределениеОбщихЗатрат.ОтборСтрок = НовОтборСтрок;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РаспределениеОбщихЗатратПоляАналитикиКорСчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение",
		"Объект.РаспределениеОбщихЗатрат.КорСчет",
		"Объект.РаспределениеОбщихЗатрат.КорКПС",
		"Объект.РаспределениеОбщихЗатрат.КорПодразделение");

КонецФункции

&НаСервере
Процедура РаспределениеОбщихЗатратЗаполнитьДобавленныеКолонки()
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
		Объект.РаспределениеОбщихЗатрат, "КорСчет",
		РаспределениеОбщихЗатратПоляАналитикиКорСчета());
	УстановитьПризнакНаправленияДеятельностиПодразделенияВТаблице(Объект.РаспределениеОбщихЗатрат);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты)

	ЗаполнитьЗначенияСвойств(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты,
		"КФО,ИФО,КПС,СчетУчета,КЭК,ВидЗатрат,БазаРаспределения");
	
	Если СтрокаОбщиеЗатраты.ЕстьНаправлениеДеятельности Тогда
		СтрокаРаспределениеОбщихЗатрат.НаправлениеДеятельности = СтрокаОбщиеЗатраты.НаправлениеДеятельности;
	КонецЕсли;
	
	Если СтрокаОбщиеЗатраты.ЕстьПодразделение Тогда
		СтрокаРаспределениеОбщихЗатрат.Подразделение = СтрокаОбщиеЗатраты.Подразделение;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты)
	
	Коэффициент = ?(СтрокаОбщиеЗатраты.Сумма = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.Сумма / СтрокаОбщиеЗатраты.Сумма);
	КоэффициентЕНВД = ?(СтрокаОбщиеЗатраты.СуммаЕНВД = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД / СтрокаОбщиеЗатраты.СуммаЕНВД);
	КоэффициентНеУчитываетсяНУ = ?(СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ / СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ);
	
	СтрокаРаспределениеОбщихЗатрат.Коэффициент                = Формат(Коэффициент*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаРаспределениеОбщихЗатрат.КоэффициентЕНВД            = Формат(КоэффициентЕНВД*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаРаспределениеОбщихЗатрат.КоэффициентНеУчитываетсяНУ = Формат(КоэффициентНеУчитываетсяНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыПриИзмененииБазыРаспределения(СтрокаОбщиеЗатраты)
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивКоэффициентов = Новый Массив;
	МассивКоэффициентовЕНВД = Новый Массив;
	МассивКоэффициентовНеУчитываетсяНУ = Новый Массив;
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		МассивКоэффициентов.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазы);
		МассивКоэффициентовЕНВД.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазыЕНВД);
		МассивКоэффициентовНеУчитываетсяНУ.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ);
	КонецЦикла;
	
	МассивСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.Сумма, МассивКоэффициентов);
	МассивСуммЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.СуммаЕНВД, МассивКоэффициентовЕНВД);
	МассивСуммНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ, МассивКоэффициентовНеУчитываетсяНУ);
	
	Для Инд = 0 По НайденныеСтроки.Количество() - 1 Цикл
		
		СтрокаРаспределениеОбщихЗатрат = НайденныеСтроки[Инд];
		
		СтрокаРаспределениеОбщихЗатрат.Сумма =
			?(МассивСумм = Неопределено, 0, МассивСумм[Инд]);
		СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД =
			?(МассивСуммЕНВД = Неопределено, 0, МассивСуммЕНВД[Инд]);
		СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ =
			?(МассивСуммНеУчитываетсяНУ = Неопределено, 0, МассивСуммНеУчитываетсяНУ[Инд]);
		
		ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьРучноеРаспределениеЗатратЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры.СтрокаОбщиеЗатраты.БазаРаспределения =
			ПредопределенноеЗначение("Перечисление.БазыРаспределенияКосвенныхЗатрат.РучноеРаспределение");
		
		Если ДополнительныеПараметры.Действие = "ИзменитьСтроку" Тогда
			Элементы[ДополнительныеПараметры.ИмяТаблицы].ИзменитьСтроку();
		ИначеЕсли ДополнительныеПараметры.Действие = "ДобавитьСтроку" Тогда
			Элементы[ДополнительныеПараметры.ИмяТаблицы].ДобавитьСтроку();
		ИначеЕсли ДополнительныеПараметры.Действие = "СкопироватьСтроку" Тогда
			Элементы[ДополнительныеПараметры.ИмяТаблицы].СкопироватьСтроку();
		ИначеЕсли ДополнительныеПараметры.Действие = "УдалитьСтроку" Тогда
			Объект.РаспределениеОбщихЗатрат.Удалить(
				Объект.РаспределениеОбщихЗатрат.Индекс(Элементы[ДополнительныеПараметры.ИмяТаблицы].ТекущиеДанные));
		КонецЕсли;
		
		Если ДополнительныеПараметры.Действие <> "ИзменитьСтроку" Тогда
			РассчитатьСуммыБазыВСтрокеОбщиеЗатраты(ДополнительныеПараметры.СтрокаОбщиеЗатраты);
			РассчитатьСуммыПриИзмененииБазыРаспределения(ДополнительныеПараметры.СтрокаОбщиеЗатраты);
			РассчитатьСуммыВСтрокеОбщиеЗатраты(ДополнительныеПараметры.СтрокаОбщиеЗатраты);
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

