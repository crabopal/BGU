Функция ПолучитьТаблицуОстатковИОборотов105(ДокументОбъект, ИФО, КФО, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат)
	
	ТаблицаОстатковИОборотов105 = Новый ТаблицаЗначений;
	ТаблицаОстатковИОборотов105.Колонки.Добавить("Счет",         Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаОстатковИОборотов105.Колонки.Добавить("КПС",          Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОстатковИОборотов105.Колонки.Добавить("Подразделение",Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаОстатковИОборотов105.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОстатковИОборотов105.Колонки.Добавить("Количество",   Новый ОписаниеТипов("Число"));
	ТаблицаОстатковИОборотов105.Колонки.Добавить("Сумма",        Новый ОписаниеТипов("Число"));
	
	Отбор = Новый Структура("КФО", КФО);
	Если ПараметрыУчетаЗатрат.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", ИФО);
	КонецЕсли;
	
	РасчетСебестоимостиПродукции = ДокументОбъект.РасчетСебестоимостиПродукции.Выгрузить(Отбор);
	Для Каждого СтрокаРасчетСебестоимости Из РасчетСебестоимостиПродукции Цикл
		
		НоваяСтрока = ТаблицаОстатковИОборотов105.Добавить();
		НоваяСтрока.Счет         = СтрокаРасчетСебестоимости.СчетГотовойПродукции;
		НоваяСтрока.КПС          = СтрокаРасчетСебестоимости.КПСГотовойПродукции;
		НоваяСтрока.Подразделение= СтрокаРасчетСебестоимости.ПодразделениеГотовойПродукции;
		НоваяСтрока.Номенклатура = СтрокаРасчетСебестоимости.Номенклатура;
		
		НоваяСтрока.Количество = СтрокаРасчетСебестоимости.Количество;
		
		// Добавим обороты по фактической стоимости.
		ФактическаяСтоимостьПродукции = ДокументОбъект.ФактическаяСтоимостьПродукции.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", СтрокаРасчетСебестоимости.ИдентификаторСтроки));
		Для Каждого СтрокаФактическаяСтоимость Из ФактическаяСтоимостьПродукции Цикл
			НоваяСтрока.Сумма = НоваяСтрока.Сумма + СтрокаФактическаяСтоимость.ФактическаяСтоимость;
		КонецЦикла;
		
	КонецЦикла;
	ТаблицаОстатковИОборотов105.Свернуть("Счет, КПС, Подразделение, Номенклатура", "Количество, Сумма");
	
	// Добавим остатки.
	Если СтрокаНачальныеОстатки <> Неопределено Тогда
		СтрокаСчета105 = СтрокаНачальныеОстатки.Строки.Найти("105", "НаименованиеСчета", Ложь);
		Если СтрокаСчета105 <> Неопределено Тогда
			
			Для Каждого СтрокаТаблицы Из ТаблицаОстатковИОборотов105 Цикл
				Отбор = Новый Структура("Счет, КПС, Подразделение, Номенклатура",
					СтрокаТаблицы.Счет, СтрокаТаблицы.КПС, СтрокаТаблицы.Подразделение, СтрокаТаблицы.Номенклатура);
				СтрокиОстатков = СтрокаСчета105.Строки.НайтиСтроки(Отбор);
				Для Каждого СтрокаОстатков Из СтрокиОстатков Цикл
					СтрокаТаблицы.Количество = СтрокаТаблицы.Количество
						+ ?(СтрокаОстатков.Количество = Null, 0, СтрокаОстатков.Количество);
					СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма
						+ ?(СтрокаОстатков.Сумма = Null, 0, СтрокаОстатков.Сумма);
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаОстатковИОборотов105;
	
КонецФункции

// Корректировка распределения и списания общих расходов в БУ и НУ.
//
Процедура СкорректироватьРаспределениеИСписаниеОбщихЗатрат(ДокументОбъект, ТаблицаСписание109_105, СтрокаОбороты109Косвенные, ВидУчета, ПараметрыУчетаЗатрат)
	
	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСписание = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабСписание109_105 = ТаблицаСписание109_105.Скопировать();
	ТабСписание109_105.Свернуть("ОПЗ_ОХЗ, Счет, КПС, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности", "Сумма");
	ТабСписание109_105.Сортировать("ОПЗ_ОХЗ, Счет, КПС, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности");
	
	Параметры = Новый Структура;
	Параметры.Вставить("ПараметрыУчетаЗатрат",         ПараметрыУчетаЗатрат);
	Параметры.Вставить("ВидУчета",                     ВидУчета);
	Параметры.Вставить("ИФО",                          СтрокаОбороты109Косвенные.ИФО);
	Параметры.Вставить("КФО",                          СтрокаОбороты109Косвенные.КФО);
	Параметры.Вставить("ТабСписание109_105",           ТабСписание109_105);
	
	МассивТиповКЗ = Новый Массив;
	МассивТиповКЗ.Добавить("ОПЗ");
	МассивТиповКЗ.Добавить("ОХЗ");
	
	Для каждого ТипКЗ из МассивТиповКЗ Цикл
		
		СтрокаОПЗ_ОХЗ = СтрокаСписание.Строки.Найти(ТипКЗ, "ОПЗ_ОХЗ", Ложь);
		Если СтрокаОПЗ_ОХЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПЗ = СтрокаОПЗ_ОХЗ.Строки.Найти("ПЗ", "ОткудаКуда", Ложь);
		Если СтрокаПЗ <> Неопределено Тогда
			
			СкорректироватьРаспределениеОбщихЗатратНаСебестоимость(ДокументОбъект, Параметры,
				ТипКЗ, СтрокаПЗ);
			
		КонецЕсли;
		
		СкорректироватьПрочееСписаниеОбщихЗатрат(ДокументОбъект, Параметры,
			ТипКЗ, СтрокаОПЗ_ОХЗ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьРаспределениеОбщихЗатратНаСебестоимость(ДокументОбъект, Параметры, ТипКЗ, СтрокаПЗ)
	
	ТабСписание109_105   = Параметры.ТабСписание109_105;
	ПараметрыУчетаЗатрат = Параметры.ПараметрыУчетаЗатрат;
	ИФО                  = Параметры.ИФО;
	КФО                  = Параметры.КФО;
	
	ТаблицаКорректировокСебестоимость = Новый ТаблицаЗначений;
	Колонки = ТаблицаКорректировокСебестоимость.Колонки;
	Колонки.Добавить("СчетДт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭКДт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСДт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("НоменклатурнаяГруппаДт",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Колонки.Добавить("ВидЗатратДт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратДт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	Колонки.Добавить("ПодразделениеДт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиДт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("СчетКт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭККт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСКт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("ВидЗатратКт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратКт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	Колонки.Добавить("ПодразделениеКт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиКт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Колонки.Добавить("Альфа",                     Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаВидЗатрат Из СтрокаПЗ.Строки Цикл
		Для Каждого СтрокаПодразделение Из СтрокаВидЗатрат.Строки Цикл
			Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделение.Строки Цикл
				Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
					НоваяСтрока = ТаблицаКорректировокСебестоимость.Добавить();
					НоваяСтрока.СчетДт                    = СтрокаДетальная.КорСчет;
					НоваяСтрока.КЭКДт                     = СтрокаДетальная.КорКЭК;
					НоваяСтрока.КПСДт                     = СтрокаДетальная.КорКПС;
					НоваяСтрока.НоменклатурнаяГруппаДт    = СтрокаДетальная.КорСубконто1;
					НоваяСтрока.ВидЗатратДт               = СтрокаДетальная.КорСубконто2;
					НоваяСтрока.КлючЗатратДт              = СтрокаДетальная.КлючЗатратКор;
					НоваяСтрока.НаправлениеДеятельностиДт = СтрокаДетальная.КорСубконто3;
					НоваяСтрока.ПодразделениеДт           = СтрокаДетальная.КорПодразделение;
					НоваяСтрока.СчетКт                    = СтрокаДетальная.Счет;
					НоваяСтрока.КЭККт                     = СтрокаДетальная.КЭК;
					НоваяСтрока.КПСКт                     = СтрокаДетальная.КПС;
					НоваяСтрока.ВидЗатратКт               = СтрокаДетальная.ВидЗатрат;
					НоваяСтрока.КлючЗатратКт              = СтрокаДетальная.КлючЗатрат;
					НоваяСтрока.НаправлениеДеятельностиКт = СтрокаДетальная.НаправлениеДеятельности;
					НоваяСтрока.ПодразделениеКт           = СтрокаДетальная.Подразделение;
					НоваяСтрока.Сумма                     = СтрокаДетальная.СуммаОборотКт;
					НоваяСтрока.Альфа                     = СтрокаДетальная["Альфа" + ТипКЗ];
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	НайденныеСтрокиСписание109 = ТабСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", ТипКЗ));
	Для Каждого СтрокаСписание109 Из НайденныеСтрокиСписание109 Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючЗатратКт",              СтрокаСписание109.КлючЗатрат);
		Отбор.Вставить("ПодразделениеКт",           СтрокаСписание109.Подразделение);
		Отбор.Вставить("НаправлениеДеятельностиКт", СтрокаСписание109.НаправлениеДеятельности);
		Отбор.Вставить("СчетКт",                    СтрокаСписание109.Счет);
		Отбор.Вставить("КПСКт",                     СтрокаСписание109.КПС);
		НайденныеСтрокиКорректировок = ТаблицаКорректировокСебестоимость.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтрокиКорректировок Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки["Альфа"]);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаСписание109.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтрокиКорректировок[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Заполним информацию о корректировке распределения общих затрат.
			Если СуммаСписания <> 0 Тогда
				
				НоваяСтрока = ДокументОбъект.КорректировкаРаспределенияЗатрат.Добавить();
				НоваяСтрока.ИФО = ИФО;
				НоваяСтрока.КФО = КФО;
				
				НоваяСтрока.КорСчет = СтрокаКорректировки.СчетДт;
				НоваяСтрока.КорКПС  = СтрокаКорректировки.КПСКт;
				НоваяСтрока.КорКЭК  = СтрокаКорректировки.КЭКДт;
				НоваяСтрока.КорНоменклатурнаяГруппа = СтрокаКорректировки.НоменклатурнаяГруппаДт;
				Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
					НоваяСтрока.КорНаправлениеДеятельности = СтрокаКорректировки.НаправлениеДеятельностиДт;
				КонецЕсли;
				Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
					НоваяСтрока.КорПодразделение = СтрокаКорректировки.ПодразделениеДт;
				КонецЕсли;
				
				НоваяСтрока.СчетУчета = СтрокаКорректировки.СчетКт;
				НоваяСтрока.КПС       = СтрокаКорректировки.КПСКт;
				НоваяСтрока.КЭК       = СтрокаКорректировки.КЭККт;
				НоваяСтрока.ВидЗатрат = СтрокаКорректировки.ВидЗатратКт;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы) Тогда
					НоваяСтрока.НаправлениеДеятельности = СтрокаКорректировки.НаправлениеДеятельностиКт;
				КонецЕсли;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы) Тогда
					НоваяСтрока.Подразделение = СтрокаКорректировки.ПодразделениеКт;
				КонецЕсли;
				
				НоваяСтрока.Сумма = СуммаСписания;
				
			КонецЕсли;
			
			СтрокаСписание109.Сумма = СтрокаСписание109.Сумма - СуммаСписания;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьПрочееСписаниеОбщихЗатрат(ДокументОбъект, Параметры, ТипКЗ, СтрокаОПЗ_ОХЗ)
	
	ТабСписание109_105   = Параметры.ТабСписание109_105;
	ПараметрыУчетаЗатрат = Параметры.ПараметрыУчетаЗатрат;
	ИФО                  = Параметры.ИФО;
	КФО                  = Параметры.КФО;
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаКорректировокПрочее = Новый ТаблицаЗначений;
	Колонки = ТаблицаКорректировокПрочее.Колонки;
	Колонки.Добавить("СчетДт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭКДт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСДт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("СубконтоКор1",              ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоКор2",              ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоКор3",              ОписаниеТиповСубконто);
	Колонки.Добавить("ПодразделениеДт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("СчетКт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭККт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСКт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("ВидЗатратКт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратКт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	Колонки.Добавить("ПодразделениеКт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиКт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаОткудаКуда Из СтрокаОПЗ_ОХЗ.Строки Цикл
		
		Если СтрокаОткудаКуда.ОткудаКуда = "ПЗ" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаВидЗатрат Из СтрокаОткудаКуда.Строки Цикл
			Для Каждого СтрокаПодразделение Из СтрокаВидЗатрат.Строки Цикл
				Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделение.Строки Цикл
					Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
						НоваяСтрока = ТаблицаКорректировокПрочее.Добавить();
						НоваяСтрока.СчетДт                    = СтрокаДетальная.КорСчет;
						НоваяСтрока.КЭКДт                     = СтрокаДетальная.КорКЭК;
						НоваяСтрока.КПСДт                     = СтрокаДетальная.КорКПС;
						НоваяСтрока.СубконтоКор1              = СтрокаДетальная.КорСубконто1;
						НоваяСтрока.СубконтоКор2              = СтрокаДетальная.КорСубконто2;
						НоваяСтрока.СубконтоКор3              = СтрокаДетальная.КорСубконто3;
						НоваяСтрока.ПодразделениеДт           = СтрокаДетальная.КорПодразделение;
						НоваяСтрока.СчетКт                    = СтрокаДетальная.Счет;
						НоваяСтрока.КЭККт                     = СтрокаДетальная.КЭК;
						НоваяСтрока.КПСКт                     = СтрокаДетальная.КПС;
						НоваяСтрока.ВидЗатратКт               = СтрокаДетальная.ВидЗатрат;
						НоваяСтрока.КлючЗатратКт              = СтрокаДетальная.КлючЗатрат;
						НоваяСтрока.НаправлениеДеятельностиКт = СтрокаДетальная.НаправлениеДеятельности;
						НоваяСтрока.ПодразделениеКт           = СтрокаДетальная.Подразделение;
						НоваяСтрока.Сумма                     = СтрокаДетальная.СуммаОборотКт;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	НайденныеСтрокиСписание109 = ТабСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", ТипКЗ));
	Для Каждого СтрокаСписание109 Из НайденныеСтрокиСписание109 Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючЗатратКт",              СтрокаСписание109.КлючЗатрат);
		Отбор.Вставить("ПодразделениеКт",           СтрокаСписание109.Подразделение);
		Отбор.Вставить("НаправлениеДеятельностиКт", СтрокаСписание109.НаправлениеДеятельности);
		Отбор.Вставить("СчетКт",                    СтрокаСписание109.Счет);
		Отбор.Вставить("КПСКт",                     СтрокаСписание109.КПС);
		НайденныеСтрокиКорректировок = ТаблицаКорректировокПрочее.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтрокиКорректировок Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки["Сумма"]);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаСписание109.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтрокиКорректировок[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Заполним информацию о корректировке списания общих затрат.
			Если СуммаСписания <> 0 Тогда
				
				НоваяСтрока = ДокументОбъект.КорректировкаСписанияЗатрат.Добавить();
				НоваяСтрока.ИФО = ИФО;
				НоваяСтрока.КФО = КФО;
				
				НоваяСтрока.КорСчет = СтрокаКорректировки.СчетДт;
				НоваяСтрока.КорКПС  = СтрокаКорректировки.КПСКт;
				НоваяСтрока.КорКЭК  = СтрокаКорректировки.КЭКДт;
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаКорректировки.СчетДт);
				Для к = 1 по СвойстваСчетаДт.КоличествоСубконто Цикл
					НоваяСтрока["КорСубконто" + к] = СтрокаКорректировки["СубконтоКор" + к];
				КонецЦикла;
				Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
					НоваяСтрока.КорПодразделение = СтрокаКорректировки.ПодразделениеДт;
				КонецЕсли;
				
				НоваяСтрока.СчетУчета = СтрокаКорректировки.СчетКт;
				НоваяСтрока.КПС       = СтрокаКорректировки.КПСКт;
				НоваяСтрока.КЭК       = СтрокаКорректировки.КЭККт;
				НоваяСтрока.ВидЗатрат = СтрокаКорректировки.ВидЗатратКт;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы) Тогда
					НоваяСтрока.НаправлениеДеятельности = СтрокаКорректировки.НаправлениеДеятельностиКт;
				КонецЕсли;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы) Тогда
					НоваяСтрока.Подразделение = СтрокаКорректировки.ПодразделениеКт;
				КонецЕсли;
				
				НоваяСтрока.Сумма = СуммаСписания;
				
			КонецЕсли;
			
			СтрокаСписание109.Сумма = СтрокаСписание109.Сумма - СуммаСписания;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Корректировка списания косвенных расходов НУ.
//
Процедура СкорректироватьСписаниеКосвенныхРасходовНУ(ДокументОбъект, ИФО, КФО, ТаблицаСписание109_105, ПараметрыУчетаЗатрат)
	
	СтрокиСписанияНаКосвенныеРасходы  = ТаблицаСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", "КосвенныеРасходыПроизводства"));
	СтрокиСписанияНаКосвенныеРасходы2 = ТаблицаСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", "КосвенныеОПЗ"));
	СтрокиСписанияНаКосвенныеРасходы3 = ТаблицаСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", "КосвенныеОХЗ"));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиСписанияНаКосвенныеРасходы, СтрокиСписанияНаКосвенныеРасходы2);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиСписанияНаКосвенныеРасходы, СтрокиСписанияНаКосвенныеРасходы3);
	
	Для Каждого СтрокаСписания Из СтрокиСписанияНаКосвенныеРасходы Цикл
		
		Отбор = Новый Структура("ИФО, КФО, КПС, СчетУчета",
			ИФО, КФО, СтрокаСписания.КПС, СтрокаСписания.Счет);
		Если СтрокаСписания.ОПЗ_ОХЗ = "КосвенныеРасходыПроизводства" Тогда
			Отбор.Вставить("Субконто1", СтрокаСписания.НоменклатурнаяГруппа);
			Отбор.Вставить("Субконто2", СтрокаСписания.ВидЗатрат);
			Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
				Отбор.Вставить("Субконто3", СтрокаСписания.НаправлениеДеятельности);
			КонецЕсли;
			Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
				Отбор.Вставить("Подразделение", СтрокаСписания.Подразделение);
			КонецЕсли;
		Иначе
			Отбор.Вставить("Субконто1", СтрокаСписания.ВидЗатрат);
			Если СтрокаСписания.ОПЗ_ОХЗ = "КосвенныеОПЗ" Тогда
				Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы Тогда
					Отбор.Вставить("Субконто3", СтрокаСписания.НаправлениеДеятельности);
				КонецЕсли;
				Если ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы Тогда
					Отбор.Вставить("Подразделение", СтрокаСписания.Подразделение);
				КонецЕсли;
			ИначеЕсли СтрокаСписания.ОПЗ_ОХЗ = "КосвенныеОХЗ" Тогда
				Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы Тогда
					Отбор.Вставить("Субконто3", СтрокаСписания.НаправлениеДеятельности);
				КонецЕсли;
				Если ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы Тогда
					Отбор.Вставить("Подразделение", СтрокаСписания.Подразделение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		НайденныеСтроки = ДокументОбъект.СписаниеРасходовНУ.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтроки Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки.СписатьСумма);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаСписания.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтроки[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Корректируем списание косвенных расходов.
			Если СуммаСписания <> 0 Тогда
			
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКорректировки,
					"ИФО, КФО, КПС, Подразделение, СчетУчета, Субконто1, Субконто2, Субконто3");
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаСписания.Счет, СтрокаСписания.ВидЗатрат);
				
				НоваяСтрока.СписатьСумма = СуммаСписания;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Переводит дерево значений в таблицу значений.
// Можно передать ДеревоЗначений или Строку дерева значений.
// Состав колонок новой таблицы значений полностью соответствует колонкам дерева. 
// Если передана таблица в параметре НоваяТаблица, то заполняется переданная таблица и возвращается она же
// 
// Параметры:
//  Дерево - СтрокаДереваЗначений
//  НоваяТаблица - ТаблицаЗначений
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ДеревоЗначенийВТаблицу(Дерево, Знач НоваяТаблица = Неопределено)
	Если НоваяТаблица = Неопределено Тогда
		Родитель = Дерево;
		Пока Родитель <> Неопределено И ТипЗнч(Родитель) <> Тип("ДеревоЗначений") Цикл
			Родитель = Родитель.Владелец();
		КонецЦикла;
		
		НоваяТаблица = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Родитель.Колонки Цикл
			НоваяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
	КонецЕсли;
	
	Если Дерево <> Неопределено Тогда
		ДобавитьСтрокуВТаблицуИерархически(Дерево, НоваяТаблица);
	КонецЕсли;
	Возврат НоваяТаблица;
КонецФункции

Процедура ДобавитьСтрокуВТаблицуИерархически(Дерево, Таблица)
	Если Дерево.Строки.Количество() > 0 Тогда
		Для Каждого Строка Из Дерево.Строки Цикл
			ДобавитьСтрокуВТаблицуИерархически(Строка, Таблица);
		КонецЦикла;
	Иначе
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Дерево);
	КонецЕсли;
КонецПроцедуры

// В таблицу значений добавляет колонку "ИндексОбъекта" и заполняет ее от 0 до КоличествоСтрок - 1.
// 
// Параметры:
//  Таблица - ТаблицаЗначений
Процедура ДобавитьИндексОбъекта(Таблица)
	Таблица.Колонки.Добавить("ИндексОбъекта", Новый ОписаниеТипов("Число"));
	ИндексКолонки = Таблица.Колонки.Количество() - 1;
	Индекс = 0;
	Для Каждого Строка Из Таблица Цикл
		Строка[ИндексКолонки] = Индекс;
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

Процедура ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, КоличествоДанных, ОписаниеШага, Комментарий = "")
	Если ЗначениеЗаполнено(ЗамерВремениЗаполнения) Тогда
		ОценкаПроизводительности.ЗафиксироватьЗамерДлительнойОперации(ЗамерВремениЗаполнения,
			КоличествоДанных, ОписаниеШага, Комментарий);
	КонецЕсли;
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьЗакрытиеСчетовПроизводственныхЗатратВФоне", Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
