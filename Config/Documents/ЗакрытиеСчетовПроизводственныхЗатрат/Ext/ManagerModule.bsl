	ТаблицаВлияющихНомГрупп = Результат[НомераТаблиц.ТаблицаВлияющихНомГрупп].Выгрузить(ОбходРезультатаЗапроса.Прямой);
	ВлияющиеНомГруппы = Новый Соответствие;
	Для каждого ТекНомГр Из ТаблицаВлияющихНомГрупп Цикл
	
		ВлияющиеНомГруппы.Вставить(ТекНомГр.НоменклатурнаяГруппа, ТекНомГр.НоменклатурнаяГруппа);
	
	КонецЦикла;
	ДанныеДляУравнений.Вставить("ВлияющиеНомГруппы", ВлияющиеНомГруппы);
	
	Возврат ДанныеДляУравнений;
	
КонецФункции

Функция СтрокаДереваПоКФОиИФО(Дерево, ИФО, КФО)
	
	СтрокаИФО = Дерево.Строки.Найти(ИФО, "ИФО", Ложь);
	СтрокаКФО = ?(СтрокаИФО <> Неопределено, СтрокаИФО.Строки.Найти(КФО, "КФО", Ложь), Неопределено);
	
	Возврат СтрокаКФО;
	
КонецФункции

// Распределяет сумму НЗП по КПС в дереве "СтрокаКонечныеОстатки"
// на основании остатков и оборотов по счету 109.6Х и данных документа "ИнвентаризацияНЗП".
//
// Параметры:
//  СтрокаКонечныеОстатки - СтрокаДереваЗначений - остатки и обороты по счету 109.6Х в разрезе КПС.
//  СтрокаКонечныеОстаткиБезКПС - СтрокаДереваЗначений - данные документа "ИнвентаризацияНЗП" без КПС.
//  ВидУчета - Строка - "БУ" (бухгалтерский учет) или "НУ" (налоговый учет по налогу на прибыль).
//
Процедура РаспределитьСуммыНЗПпоКПС(СтрокаКонечныеОстатки, СтрокаКонечныеОстаткиБезКПС, ВидУчета)
	
	Если СтрокаКонечныеОстаткиБезКПС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидУчета = "НУ" Тогда
		// В НУ не ведется учет затрат по КЭК.
		СтруктураПоиска = Новый Структура("НаправлениеДеятельности, НоменклатурнаяГруппа, ВидЗатрат");
	Иначе
		// Бух. учет.
		СтруктураПоиска = Новый Структура("НаправлениеДеятельности, НоменклатурнаяГруппа, ВидЗатрат, КЭК");
	КонецЕсли;
	
	Для Каждого ОстаткиНЗПпоПодразделениям Из СтрокаКонечныеОстаткиБезКПС.Строки Цикл
		
		СтрокаКонечныеОстаткиПоПодразделению = СтрокаКонечныеОстатки.Строки.Найти(
			ОстаткиНЗПпоПодразделениям.Подразделение, "Подразделение");
		
		Если СтрокаКонечныеОстаткиПоПодразделению = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ОстаткиНЗПбезКПС Из ОстаткиНЗПпоПодразделениям.Строки Цикл
			
			// Найдем остатки затрат, которые относятся к данному остатку НЗП.
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, ОстаткиНЗПбезКПС);
			МассивСтрокОстатковЗатрат = СтрокаКонечныеОстаткиПоПодразделению.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			Если МассивСтрокОстатковЗатрат.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			БазаРаспределенияНЗП = Новый Массив;
			Для Каждого СтрокаЗатрат из МассивСтрокОстатковЗатрат Цикл
				БазаРаспределенияНЗП.Добавить(СтрокаЗатрат.СуммаЗатрат);
			КонецЦикла;
			
			// Распределим остаток НЗП пропорционально накопленным в течение месяца затратам в разрезе КПС.
			МассивСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ОстаткиНЗПбезКПС.Сумма, БазаРаспределенияНЗП);
			Если МассивСумм = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Индекс = 0 По МассивСтрокОстатковЗатрат.Количество() - 1 Цикл
				
				СтрокаЗатрат = МассивСтрокОстатковЗатрат[Индекс];
				
				// Заполним в дереве конечный остаток затрат (НЗП), распределенный по КПС.
				СтрокаЗатрат.Сумма = МассивСумм[Индекс];
				
				// Рассчитаем итоги по группировкам в дереве.
				СтрокаЗатрат.Родитель.Сумма =
					СтрокаЗатрат.Родитель.Сумма + СтрокаЗатрат.Сумма;
				СтрокаЗатрат.Родитель.Родитель.Сумма =
					СтрокаЗатрат.Родитель.Родитель.Сумма + СтрокаЗатрат.Сумма;
				СтрокаЗатрат.Родитель.Родитель.Родитель.Сумма =
					СтрокаЗатрат.Родитель.Родитель.Родитель.Сумма + СтрокаЗатрат.Сумма;
				СтрокаЗатрат.Родитель.Родитель.Родитель.Родитель.Сумма =
					СтрокаЗатрат.Родитель.Родитель.Родитель.Родитель.Сумма + СтрокаЗатрат.Сумма;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Тау - Коэффициент распределения стоимости производства внутри номенклатурной группы на единицу продукции.
//
Процедура РассчитатьКоэффициентыТау(СтрокаДляРасчетаТау, ДеревоДляРасчетаТауДоп)
	
	Если СтрокаДляРасчетаТау = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаНоменклатурнойГруппы Из СтрокаДляРасчетаТау.Строки Цикл
		
		Если СтрокаНоменклатурнойГруппы.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа Тогда
			
			СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа",
				СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства,
				СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
			МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			
			Если МассивСтрок.Количество() <> 0 Тогда
				Если СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства = Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПоПлановойСтоимостиПродукции Тогда
					ИмяПоказателя       = "ПлановаяСтоимость";
					СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
				Иначе
					ИмяПоказателя		= "Коэффициент";
					СуммарныйПоказатель = МассивСтрок[0].Коэффициент;
				КонецЕсли;
			Иначе	
				СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа",
					Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПустаяСсылка(),
					СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
				МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);
				ИмяПоказателя       = "ПлановаяСтоимость";
				СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
			КонецЕсли;
			
			МассивКоэффициентов = Новый Массив;
			Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурнойГруппы.Строки Цикл	
				Если СуммарныйПоказатель <> 0 Тогда
					СтрокаПоказателя = МассивСтрок[0].Строки.Найти(СтрокаНоменклатуры.Номенклатура, "Номенклатура", Ложь);
					Если СтрокаПоказателя = Неопределено Тогда
						ТекстОшибки = НСтр("ru = 'Затраты на выпуск ""%1"" ошибочно отнесены на номенклатурную группу ""%2"".
						|Продукция не входит в выбранную номенклатурную группу.'");
						ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							ТекстОшибки, СтрокаНоменклатуры.Номенклатура, СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа));
						// дальнейший расчет не имеет смысла, т.к. себестоимость уже будет не правильной
						ВызватьИсключение НСтр("ru = 'Документ не заполнен'");
					Иначе
						МассивКоэффициентов.Добавить(СтрокаПоказателя[ИмяПоказателя]);
					КонецЕсли;
				Иначе
					МассивКоэффициентов.Добавить(1); // равномерно по всем строкам
				КонецЕсли;
			КонецЦикла;
			
			// Для расчета коэффициентов Тау распределим единицу (100%) пропорционально полученным коэффициентам.
			МассивКоэффициентовТау = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(1, МассивКоэффициентов, 10);
			СтрокаНоменклатурнойГруппы.Строки.ЗагрузитьКолонку(МассивКоэффициентовТау, "Тау");
			
		Иначе
			Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурнойГруппы.Строки Цикл
				СтрокаНоменклатуры.Тау = 1;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Тэтта - Коэффициент распределения стоимости производства в рамках подразделения, направления деятельности,
// внутри номенклатурной группы, на субсчете 105 на единицу продукции.
//
Функция РассчитатьКоэффициентыТэтта(СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта)
	
	ТаблицаТэтта = Новый ТаблицаЗначений;
	ТаблицаТэтта.Колонки.Добавить("Подразделение",	         Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаТэтта.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаТэтта.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТэтта.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТэтта.Колонки.Добавить("Счет105",                 Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаТэтта.Колонки.Добавить("КПС105",                  Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаТэтта.Колонки.Добавить("Тэтта",                   Новый ОписаниеТипов("Число"));
	
	Если СтрокаДляРасчетаТау = Неопределено Тогда
		Возврат ТаблицаТэтта;
	КонецЕсли;
	
	Для Каждого СтрокаПодразделения Из СтрокаДляРасчетаТэтта.Строки Цикл
		Для Каждого СтрокаНаправленияДеятельности Из СтрокаПодразделения.Строки Цикл
			Для Каждого СтрокаНоменклатурнойГруппы Из СтрокаНаправленияДеятельности.Строки Цикл
				
				МассивКоэффициентов = Новый Массив;
				Для Каждого СтрокаСчета Из СтрокаНоменклатурнойГруппы.Строки Цикл
					Для Каждого СтрокаКПС Из СтрокаСчета.Строки Цикл
						Для Каждого СтрокаНоменклатуры Из СтрокаКПС.Строки Цикл
							
							СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, Номенклатура",
								СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа, СтрокаНоменклатуры.Номенклатура);
							МассивСтрок = СтрокаДляРасчетаТау.Строки.НайтиСтроки(СтруктураПоиска, Истина);
							
							МассивКоэффициентов.Добавить(СтрокаНоменклатуры.Количество * МассивСтрок[0].Тау);
							
							НоваяСтрокаТэтта = ТаблицаТэтта.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаТэтта, СтрокаНоменклатуры);
							
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
				
				// Для расчета коэффициентов Тэтта распределим единицу (100%) пропорционально полученным коэффициентам.
				МассивКоэффициентовТэтта = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(1, МассивКоэффициентов, 10);
				Если МассивКоэффициентовТэтта = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				КоличествоЭлементовМассива = МассивКоэффициентовТэтта.Количество();
				КоличествоСтрокТаблицы = ТаблицаТэтта.Количество();
				Для Ном = 1 По КоличествоЭлементовМассива Цикл
					// Устанавливаем значения коэффициентов в таблице в колонке Тэтта, начиная с последней строки.
					ТаблицаТэтта[КоличествоСтрокТаблицы - Ном].Тэтта = МассивКоэффициентовТэтта[КоличествоЭлементовМассива - Ном];
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаТэтта.Индексы.Добавить("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет105, КПС105");
	
	Возврат ТаблицаТэтта;
	
КонецФункции

Функция ОпределитьКоэффициентТэтта(ТаблицаТэтта, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет, КПС)
	
	Отбор = Новый Структура("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет105, КПС105",
							Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет, КПС);
	СтрокиТэтта = ТаблицаТэтта.НайтиСтроки(Отбор);
	
	Если СтрокиТэтта.Количество() <> 0 Тогда
		Возврат СтрокиТэтта[0].Тэтта;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

// Альфа - коэффициент распределения косвенных затрат
//
Процедура РассчитатьКоэффициентыАльфа(СтрокаОбъектов, СтрокаОбороты109Косвенные, ПараметрыУчетаЗатрат)

	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
		Возврат;
	КонецЕсли;
	
	СтрокаСписания = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	
	Если СтрокаСписания = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
	Иначе	
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОПЗ", ПараметрыУчетаЗатрат);
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОХЗ", ПараметрыУчетаЗатрат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗанулитьАльфаКолонки(СтрокаДерева, АльфаОПЗ = Ложь, АльфаОХЗ = Ложь)
	
	Для каждого СтрокаДетальная из СтрокаДерева.Строки Цикл
		Если АльфаОПЗ Тогда
			СтрокаДетальная.АльфаОПЗ = 0;
		КонецЕсли;
		Если АльфаОХЗ Тогда
			СтрокаДетальная.АльфаОХЗ = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьАльфаКолонки(СтрокаОбъектовКФО, СтрокаСписания, ИмяКолонки, ПараметрыУчетаЗатрат)
	
	Если ИмяКолонки = "АльфаОХЗ" Тогда
		ОбнулитьОХЗ = Истина;
		ОбнулитьОПЗ = Ложь;
		ИмяСекции   = "ОХЗ";
		ЕстьНаправлениеДеятельности = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
		ЕстьПодразделение           = ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	Иначе
		ОбнулитьОХЗ = Ложь;
		ОбнулитьОПЗ = Истина;
		ИмяСекции   = "ОПЗ";
		ЕстьНаправлениеДеятельности = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
		ЕстьПодразделение           = ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы;
	КонецЕсли;
	
	СтрокаКЗ = СтрокаСписания.Строки.Найти(ИмяСекции, "ОПЗ_ОХЗ");
	Если СтрокаКЗ = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектовКФО, ОбнулитьОПЗ, ОбнулитьОХЗ);
		Возврат;
	КонецЕсли;
	
	СтрокаОткудаКудаПЗ = СтрокаКЗ.Строки.Найти("ПЗ", "ОткудаКуда");
	Если СтрокаОткудаКудаПЗ = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектовКФО, ОбнулитьОПЗ, ОбнулитьОХЗ);
		Возврат;
	КонецЕсли;
	
	ТаблицаСписаниеОбщихЗатрат = Новый ТаблицаЗначений;
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("НоменклатурнаяГруппа",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("НаправлениеДеятельности",   Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("Подразделение",             Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("КлючЗатрат",                Новый ОписаниеТипов("Строка"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Для каждого СтрокаОткудаКуда из СтрокаКЗ.Строки Цикл
		Для каждого СтрокаВидЗатрат из СтрокаОткудаКуда.Строки Цикл
			Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
				Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
					Для каждого СтрокаДетальные из СтрокаНаправлениеДеятельности.Строки Цикл
						
						НоваяСтрока1 = ТаблицаСписаниеОбщихЗатрат.Добавить();
						НоваяСтрока1.НоменклатурнаяГруппа    = СтрокаДетальные.КорСубконто1;
						НоваяСтрока1.НаправлениеДеятельности = СтрокаДетальные.НаправлениеДеятельности;
						НоваяСтрока1.Подразделение           = СтрокаДетальные.Подразделение;
						НоваяСтрока1.КлючЗатрат              = СтрокаДетальные.КлючЗатрат;
						НоваяСтрока1.Сумма                   = СтрокаДетальные.СуммаОборотКт;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаСписаниеОбщихЗатрат.Свернуть("НоменклатурнаяГруппа, НаправлениеДеятельности, Подразделение, КлючЗатрат", "Сумма");
	
	ТаблицаСписаниеОбщихЗатратНаПрямые = Новый ТаблицаЗначений;
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НоменклатурнаяГруппа",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НаправлениеДеятельности",   Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НаправлениеДеятельностиПЗ", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("Подразделение",             Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("ПодразделениеПЗ",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("КлючЗатрат",                Новый ОписаниеТипов("Строка"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Для каждого СтрокаВидЗатрат из СтрокаОткудаКудаПЗ.Строки Цикл
		Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
			Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
				Для каждого СтрокаДетальные из СтрокаНаправлениеДеятельности.Строки Цикл
					
					НоваяСтрока = ТаблицаСписаниеОбщихЗатратНаПрямые.Добавить();
					НоваяСтрока.НоменклатурнаяГруппа      = СтрокаДетальные.КорСубконто1;
					НоваяСтрока.НаправлениеДеятельности   = СтрокаДетальные.НаправлениеДеятельности;
					НоваяСтрока.НаправлениеДеятельностиПЗ = СтрокаДетальные.КорСубконто3;
					НоваяСтрока.Подразделение             = СтрокаДетальные.Подразделение;
					НоваяСтрока.ПодразделениеПЗ           = СтрокаДетальные.КорПодразделение;
					НоваяСтрока.КлючЗатрат                = СтрокаДетальные.КлючЗатрат;
					НоваяСтрока.Сумма                     = СтрокаДетальные.СуммаОборотКт;
				
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаСписаниеОбщихЗатратНаПрямые.Свернуть("НоменклатурнаяГруппа, НаправлениеДеятельности, НаправлениеДеятельностиПЗ, Подразделение, ПодразделениеПЗ, КлючЗатрат", "Сумма");
	
	ТаблицаИтогов = ТаблицаСписаниеОбщихЗатратНаПрямые.Скопировать();
	ТаблицаИтогов.Свернуть("Подразделение, НаправлениеДеятельности, КлючЗатрат", "Сумма");
	Для каждого СтрокаИтогов из ТаблицаИтогов Цикл
		
		СтруктураПоиска = Новый Структура("Подразделение, НаправлениеДеятельности, КлючЗатрат",
			СтрокаИтогов.Подразделение, СтрокаИтогов.НаправлениеДеятельности, СтрокаИтогов.КлючЗатрат);
		
		// Рассчитаем общую сумму списания общих затрат.
		СуммаЗатратВсего = 0;
		СтрокиЗатратВсего = ТаблицаСписаниеОбщихЗатрат.НайтиСтроки(СтруктураПоиска);
		Для Каждого Строка из СтрокиЗатратВсего Цикл
			СуммаЗатратВсего = СуммаЗатратВсего + Строка.Сумма;
		КонецЦикла;
		Если СуммаЗатратВсего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Рассчитаем сумму списания общих затрат только на прямые.
		СуммаЗатратНаПрямые = 0;
		СтрокиЗатратНаПрямые = ТаблицаСписаниеОбщихЗатратНаПрямые.НайтиСтроки(СтруктураПоиска);
		Для Каждого Строка из СтрокиЗатратНаПрямые Цикл
			СуммаЗатратНаПрямые = СуммаЗатратНаПрямые + Строка.Сумма;
		КонецЦикла;
		Если СуммаЗатратНаПрямые = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаАльф  = 0;
		МаксИндекс = СтрокиЗатратНаПрямые.ВГраница();
		Для к = 0 по МаксИндекс Цикл
			
			Если (к = МаксИндекс) И (СуммаЗатратНаПрямые = СуммаЗатратВсего) Тогда
				КоэффициентАльфа = 1 - СуммаАльф;
			Иначе
				КоэффициентАльфа = СтрокиЗатратНаПрямые[к].Сумма / СуммаЗатратВсего;
			КонецЕсли;	
			СуммаАльф = СуммаАльф + КоэффициентАльфа;
			
			СтруктураПоиска = Новый Структура("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, КлючЗатрат", 
				СтрокиЗатратНаПрямые[к].ПодразделениеПЗ,
				СтрокиЗатратНаПрямые[к].НаправлениеДеятельностиПЗ,
				СтрокиЗатратНаПрямые[к].НоменклатурнаяГруппа,
				СтрокиЗатратНаПрямые[к].КлючЗатрат);
			МассивСтрок = СтрокаОбъектовКФО.Строки.НайтиСтроки(СтруктураПоиска);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = КоэффициентАльфа;
			КонецЦикла;
			
			СтруктураПоиска = Новый Структура("КорПодразделение, КорСубконто3, КорСубконто1, КлючЗатрат", 
				СтрокиЗатратНаПрямые[к].ПодразделениеПЗ,
				СтрокиЗатратНаПрямые[к].НаправлениеДеятельностиПЗ,
				СтрокиЗатратНаПрямые[к].НоменклатурнаяГруппа,
				СтрокиЗатратНаПрямые[к].КлючЗатрат);
			Если ЕстьНаправлениеДеятельности Тогда
				СтруктураПоиска.Вставить("НаправлениеДеятельности", СтрокиЗатратНаПрямые[к].НаправлениеДеятельности);
			КонецЕсли;
			Если ЕстьПодразделение Тогда
				СтруктураПоиска.Вставить("Подразделение", СтрокиЗатратНаПрямые[к].Подразделение);
			КонецЕсли;
			МассивСтрок = СтрокаКЗ.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = КоэффициентАльфа;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаНачальныеОстаткиДляРасчетаКоэффициентовГамма(СтрокаНачальныеОстатки)
	Остатки = Новый ТаблицаЗначений;
	Остатки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Остатки.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Остатки.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Остатки.Колонки.Добавить("НаименованиеСчета", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));
	Остатки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Остатки = ДеревоЗначенийВТаблицу(СтрокаНачальныеОстатки, Остатки);
	Возврат Остатки;
КонецФункции

Функция ТаблицаОбъектовДляРасчетаКоэффициентовГамма(СтрокаОбъектов)
	ТЗСтрокаОбъектов = ДеревоЗначенийВТаблицу(СтрокаОбъектов);
	ТЗСтрокаОбъектов = ТЗСтрокаОбъектов.Скопировать(,
		"НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности");
	ДобавитьИндексОбъекта(ТЗСтрокаОбъектов);
	Возврат ТЗСтрокаОбъектов;
КонецФункции

Функция ТекстЗапросаДляРасчетаКоэффициентовГамма(ПараметрыУчетаЗатрат)
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СтрокаОбороты105.Направление,
	|	СтрокаОбороты105.ОткудаКуда,                    
	|	СтрокаОбороты105.Номенклатура,
	|	СтрокаОбороты105.КПС,
	|	СтрокаОбороты105.Счет,
	|	СтрокаОбороты105.КорСубконто1,
	|	СтрокаОбороты105.КорСубконто2,
	|	СтрокаОбороты105.КорСубконто3,
	|	СтрокаОбороты105.КлючЗатрат,
	|	СтрокаОбороты105.КорПодразделение,
	|	СтрокаОбороты105.КоличествоОборотКт,
	|	СтрокаОбороты105.КоличествоОборотДт
	|ПОМЕСТИТЬ ВТСтрокаОбороты105
	|ИЗ
	|	&СтрокаОбороты105 КАК СтрокаОбороты105
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	КПС,
	|	Счет,
	|	Направление
	|;
	|ВЫБРАТЬ
	|	СтрокаНачальныеОстатки.Количество,
	|	СтрокаНачальныеОстатки.Номенклатура,
	|	СтрокаНачальныеОстатки.Счет,
	|	СтрокаНачальныеОстатки.КПС,
	|	СтрокаНачальныеОстатки.НаименованиеСчета
	|ПОМЕСТИТЬ ВТСтрокаНачальныеОстатки
	|ИЗ
	|	&СтрокаНачальныеОстатки КАК СтрокаНачальныеОстатки
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Счет,
	|	КПС,
	|	НаименованиеСчета
	|;
	|ВЫБРАТЬ
	|	СтрокаОбъектов.ИндексОбъекта,
	|	СтрокаОбъектов.НоменклатурнаяГруппа,
	|	СтрокаОбъектов.КлючЗатрат,
	|	СтрокаОбъектов.Подразделение,
	|	СтрокаОбъектов.НаправлениеДеятельности                    
	|ПОМЕСТИТЬ ВТСтрокаОбъектов
	|ИЗ
	|	&СтрокаОбъектов КАК СтрокаОбъектов
	|ИНДЕКСИРОВАТЬ ПО
	|	НоменклатурнаяГруппа,
	|	КлючЗатрат,
	|	Подразделение
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.КПС,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КоличествоОборотДт
	|ПОМЕСТИТЬ ТаблицаПоступление105
	|ИЗ 
	|	ВТСтрокаОбороты105 КАК ВТСтрокаОбороты105
	|ГДЕ
	|	ВТСтрокаОбороты105.Направление <> ""Списание""
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	КПС,
	|	Счет
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.КПС,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КорСубконто1,
	|	ВТСтрокаОбороты105.КлючЗатрат,
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.КорСубконто3,
	|	ВТСтрокаОбороты105.КоличествоОборотКт
	|ПОМЕСТИТЬ ТаблицаСписание105ПЗ
	|ИЗ 
	|	ВТСтрокаОбороты105 КАК ВТСтрокаОбороты105
	|ГДЕ
	|	ВТСтрокаОбороты105.Направление = ""Списание""
	|	И ВТСтрокаОбороты105.ОткудаКуда = ""ПЗ""
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.КПС,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КлючЗатрат,
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.КорСубконто2,
	|	ВТСтрокаОбороты105.КоличествоОборотКт
	|ПОМЕСТИТЬ ТаблицаСписание105ОПЗ
	|ИЗ 
	|	ВТСтрокаОбороты105 КАК ВТСтрокаОбороты105
	|ГДЕ
	|	ВТСтрокаОбороты105.Направление = ""Списание""
	|	И ВТСтрокаОбороты105.ОткудаКуда = ""ОПЗ""
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	КПС,
	|	Счет,
	|	КлючЗатрат,
	|	КорПодразделение,
	|	КорСубконто2
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.КПС,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КлючЗатрат,
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.КорСубконто2,
	|	ВТСтрокаОбороты105.КоличествоОборотКт
	|ПОМЕСТИТЬ ТаблицаСписание105ОХЗ
	|ИЗ 
	|	ВТСтрокаОбороты105 КАК ВТСтрокаОбороты105
	|ГДЕ
	|	ВТСтрокаОбороты105.Направление = ""Списание""
	|	И ВТСтрокаОбороты105.ОткудаКуда = ""ОХЗ""
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	КПС,
	|	Счет,
	|	КлючЗатрат,
	|	КорПодразделение,
	|	КорСубконто2
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС
	|ПОМЕСТИТЬ РазличныеКИсх
	|ИЗ
	|	ВТСтрокаОбороты105 КАК ВТСтрокаОбороты105
	|ГДЕ
	|	ВТСтрокаОбороты105.Направление = ""Списание""
	|	И ВТСтрокаОбороты105.ОткудаКуда <> ""Прочее""
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Счет,
	|	КПС
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС,
	|	СУММА(ЕСТЬNULL(ВТСтрокаНачальныеОстатки.Количество, 0)) + СУММА(ЕСТЬNULL(ТаблицаПоступление105.КоличествоОборотДт, 0)) КАК К_Исх
	|ПОМЕСТИТЬ ПредварительнаяСКИсх
	|ИЗ
	|	РазличныеКИсх КАК ВТСтрокаОбороты105
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТСтрокаНачальныеОстатки КАК ВТСтрокаНачальныеОстатки
	|	ПО ВТСтрокаОбороты105.Номенклатура = ВТСтрокаНачальныеОстатки.Номенклатура 
	|		И ВТСтрокаОбороты105.Счет = ВТСтрокаНачальныеОстатки.Счет 
	|		И ВТСтрокаОбороты105.КПС = ВТСтрокаНачальныеОстатки.КПС 
	|		И ВТСтрокаНачальныеОстатки.НаименованиеСчета = ""105""
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПоступление105 КАК ТаблицаПоступление105
	|	ПО ВТСтрокаОбороты105.Номенклатура = ТаблицаПоступление105.Номенклатура 
	|		И ВТСтрокаОбороты105.Счет = ТаблицаПоступление105.Счет 
	|		И ВТСтрокаОбороты105.КПС = ТаблицаПоступление105.КПС 
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС
	|ИМЕЮЩИЕ
	|	(СУММА(ЕСТЬNULL(ВТСтрокаНачальныеОстатки.Количество, 0)) + СУММА(ЕСТЬNULL(ТаблицаПоступление105.КоличествоОборотДт, 0))) <> 0	
	|;
	|ВЫБРАТЬ
	|	ВТСтрокаОбъектов.ИндексОбъекта,
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС,
	|	СУММА(ВТСтрокаОбороты105.К_Исх) КАК К_Исх,
	|	СУММА(ЕСТЬNULL(ТаблицаСписание105ПЗ.КоличествоОборотКт, 0)) КАК К_гп_пз,
	|	СУММА(ЕСТЬNULL(ТаблицаСписание105ОПЗ.КоличествоОборотКт, 0)) КАК К_гп_опз,
	|	СУММА(ЕСТЬNULL(ТаблицаСписание105ОХЗ.КоличествоОборотКт, 0)) КАК К_гп_охз
	|ИЗ
	|	ПредварительнаяСКИсх КАК ВТСтрокаОбороты105
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТСтрокаОбъектов КАК ВТСтрокаОбъектов
	|	ПО ИСТИНА
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСписание105ПЗ КАК ТаблицаСписание105ПЗ
	|	ПО ВТСтрокаОбороты105.Номенклатура = ТаблицаСписание105ПЗ.Номенклатура
	|		И ВТСтрокаОбороты105.КПС = ТаблицаСписание105ПЗ.КПС
	|		И ВТСтрокаОбороты105.Счет = ТаблицаСписание105ПЗ.Счет
	|		И ВТСтрокаОбъектов.НоменклатурнаяГруппа = ТаблицаСписание105ПЗ.КорСубконто1
	|		И ВТСтрокаОбъектов.КлючЗатрат = ТаблицаСписание105ПЗ.КлючЗатрат
	|		И ВТСтрокаОбъектов.Подразделение = ТаблицаСписание105ПЗ.КорПодразделение
	|		И &СоединениеНД_ПЗ
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСписание105ОПЗ КАК ТаблицаСписание105ОПЗ
	|	ПО ВТСтрокаОбороты105.Номенклатура = ТаблицаСписание105ОПЗ.Номенклатура
	|		И ВТСтрокаОбороты105.КПС = ТаблицаСписание105ОПЗ.КПС
	|		И ВТСтрокаОбороты105.Счет = ТаблицаСписание105ОПЗ.Счет
	|		И ВТСтрокаОбъектов.КлючЗатрат = ТаблицаСписание105ОПЗ.КлючЗатрат
	|		И ВТСтрокаОбъектов.Подразделение = ТаблицаСписание105ОПЗ.КорПодразделение
	|		И &СоединениеНД_ОПЗ
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСписание105ОХЗ КАК ТаблицаСписание105ОХЗ
	|	ПО ВТСтрокаОбороты105.Номенклатура = ТаблицаСписание105ОХЗ.Номенклатура
	|		И ВТСтрокаОбороты105.КПС = ТаблицаСписание105ОХЗ.КПС
	|		И ВТСтрокаОбороты105.Счет = ТаблицаСписание105ОХЗ.Счет
	|		И ВТСтрокаОбъектов.КлючЗатрат = ТаблицаСписание105ОХЗ.КлючЗатрат
	|		И ВТСтрокаОбъектов.Подразделение = ТаблицаСписание105ОХЗ.КорПодразделение
	|		И &СоединениеНД_ОХЗ
	|СГРУППИРОВАТЬ ПО
	|	ВТСтрокаОбъектов.ИндексОбъекта,
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС
	|УПОРЯДОЧИТЬ ПО
	|	ВТСтрокаОбороты105.КорПодразделение,
	|	ВТСтрокаОбороты105.Номенклатура,
	|	ВТСтрокаОбороты105.Счет,
	|	ВТСтрокаОбороты105.КПС";

	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ПЗ",
			"ВТСтрокаОбъектов.НаправлениеДеятельности = ТаблицаСписание105ПЗ.КорСубконто3");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ПЗ", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ОПЗ",
			"ВТСтрокаОбъектов.НаправлениеДеятельности = ТаблицаСписание105ОПЗ.КорСубконто2");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ОПЗ", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ОХЗ",
			"ВТСтрокаОбъектов.НаправлениеДеятельности = ТаблицаСписание105ОХЗ.КорСубконто2");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СоединениеНД_ОХЗ", "ИСТИНА");
	КонецЕсли;
	Возврат ТекстЗапроса;
КонецФункции

// Гамма - доля по количеству продукции, списанной на себестоимость
//
Функция РассчитатьКоэффициентыГамма(СтрокаОбороты105, СтрокаНачальныеОстатки, СтрокаОбъектов, ПараметрыУчетаЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаОбороты105", ДеревоЗначенийВТаблицу(СтрокаОбороты105));
	Запрос.УстановитьПараметр("СтрокаНачальныеОстатки",
		ТаблицаНачальныеОстаткиДляРасчетаКоэффициентовГамма(СтрокаНачальныеОстатки));
	Запрос.УстановитьПараметр("СтрокаОбъектов", ТаблицаОбъектовДляРасчетаКоэффициентовГамма(СтрокаОбъектов));
	Запрос.Текст = ТекстЗапросаДляРасчетаКоэффициентовГамма(ПараметрыУчетаЗатрат);

	Выборка = Запрос.Выполнить().Выбрать();

	ТаблицаКоэффициентовГамма = Новый ТаблицаЗначений;
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КорПодразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КоличествоКолонокГамма = ТаблицаКоэффициентовГамма.Колонки.Количество();
	
	МаксИндекс    = СтрокаОбъектов.Строки.Количество() - 1;
	Для ТекущийИндекс = 0 По МаксИндекс Цикл
		ИмяКолонки = "k" + Формат(ТекущийИндекс, "ЧГ=");
		ТаблицаКоэффициентовГамма.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
	КонецЦикла;
	
	КорПодразделение = Неопределено;
	Номенклатура = Неопределено;
	Счет = Неопределено;
	КПС = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Выборка.КорПодразделение <> КорПодразделение
				Или Выборка.Номенклатура <> Номенклатура
				Или Выборка.Счет <> Счет
				Или Выборка.КПС <> КПС Тогда
			ЗаполняемаяСтрока = ТаблицаКоэффициентовГамма.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, Выборка, "КорПодразделение, Номенклатура, Счет, КПС");
			КорПодразделение = ЗаполняемаяСтрока.КорПодразделение;
			Номенклатура = ЗаполняемаяСтрока.Номенклатура;
			Счет = ЗаполняемаяСтрока.Счет;
			КПС = ЗаполняемаяСтрока.КПС;
		КонецЕсли;
		Если Выборка.К_исх <> 0 Тогда
			ЗаполняемаяСтрока[КоличествоКолонокГамма + Выборка.ИндексОбъекта] = 
				(Выборка.К_гп_пз 
						+ Выборка.К_гп_опз * СтрокаОбъектов.Строки[Выборка.ИндексОбъекта].АльфаОПЗ 
						+ Выборка.К_гп_охз * СтрокаОбъектов.Строки[Выборка.ИндексОбъекта].АльфаОХЗ) / Выборка.К_исх;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ТаблицаКоэффициентовГамма;
	
КонецФункции

Функция ТаблицаОбъектовДляФормированияМатрицыСистемыУравнений(Параметры)
	МатрицаОбъектов = Новый ТаблицаЗначений;
	МатрицаОбъектов.Колонки.Добавить("Подразделение",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	МатрицаОбъектов.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	МатрицаОбъектов.Колонки.Добавить("ТипНоменклатуры",         Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	МатрицаОбъектов.Колонки.Добавить("ВидЗатрат",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("КЭК",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	МатрицаОбъектов.Колонки.Добавить("КПС",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	МатрицаОбъектов.Колонки.Добавить("КлючЗатрат",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	МатрицаОбъектов.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	МатрицаОбъектов.Колонки.Добавить("ВидДеятельностиНУ",       Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("ИндексОбъектаРасчета", Новый ОписаниеТипов("Число"));
	
	ИндексНовойСтроки = 0;
	Для Каждого СтрокаДетальная Из Параметры.СтрокаОбъектов.Строки Цикл
		НоваяСтрока = МатрицаОбъектов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДетальная);
		НоваяСтрока.ИндексОбъектаРасчета = ИндексНовойСтроки;
		ИндексНовойСтроки = ИндексНовойСтроки + 1;
	КонецЦикла;
	
	Возврат МатрицаОбъектов;
КонецФункции

Функция ТаблицаКоэффициентовГаммаДляФормированияМатрицыСистемыУравнений(Параметры)
	ТаблицаКоэффициентовГамма = Новый ТаблицаЗначений;
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КорПодразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Счет",             Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КПС",              Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("ИндексКолонки",    Новый ОписаниеТипов("Число"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Гамма",    Новый ОписаниеТипов("Число"));
	
	МаксИндексГамма = Параметры.ТаблицаКоэффициентовГамма.Колонки.Количество() - 1;
	НачИндексГамма = 4;
	Для Каждого СтрокаГамма Из Параметры.ТаблицаКоэффициентовГамма Цикл
		Для ИндексГамма = НачИндексГамма По МаксИндексГамма Цикл
			Если СтрокаГамма[ИндексГамма] <> 0 Тогда
				НоваяСтрокаГамма = ТаблицаКоэффициентовГамма.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаГамма, СтрокаГамма,
					"КорПодразделение,Номенклатура,Счет,КПС");
				НоваяСтрокаГамма.ИндексКолонки = ИндексГамма - НачИндексГамма;
				НоваяСтрокаГамма.Гамма = СтрокаГамма[ИндексГамма];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ТаблицаКоэффициентовГамма;
КонецФункции

Функция ТаблицаКонечныеОстаткиДляФормированияМатрицыСистемыУравнений(Параметры)
	Если Параметры.СтрокаКонечныеОстатки <> Неопределено Тогда
		ТаблицаКонечныеОстатки = ДеревоЗначенийВТаблицу(Параметры.СтрокаКонечныеОстатки);
		ТаблицаКонечныеОстатки.Свернуть("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа", "Сумма");
		НулевыеСтроки = ТаблицаКонечныеОстатки.НайтиСтроки(Новый Структура("Сумма", 0));
		Для Каждого НулеваяСтрока Из НулевыеСтроки Цикл
			ТаблицаКонечныеОстатки.Удалить(НулеваяСтрока);
		КонецЦикла;
		ТаблицаКонечныеОстатки.Индексы.Добавить("Подразделение, НаправлениеДеятельности");
	Иначе
		ТаблицаКонечныеОстатки = Новый ТаблицаЗначений;
		ТаблицаКонечныеОстатки.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ТаблицаКонечныеОстатки.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
		ТаблицаКонечныеОстатки.Колонки.Добавить("НоменклатурнаяГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаКонечныеОстатки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	Возврат ТаблицаКонечныеОстатки;
КонецФункции

Функция ТаблицаОстатковДляФормированияМатрицыСистемыУравнений(Параметры, НаименованиеСчета)
	ТаблицаОстатков = Неопределено;
	Если Параметры.СтрокаНачальныеОстатки <> Неопределено Тогда
		СтрокаНачОстатков = Параметры.СтрокаНачальныеОстатки.Строки.Найти(НаименованиеСчета, "НаименованиеСчета");
		Если СтрокаНачОстатков <> Неопределено Тогда
			ТаблицаОстатков = ДеревоЗначенийВТаблицу(СтрокаНачОстатков);
		КонецЕсли;
	КонецЕсли;
	Если ТаблицаОстатков = Неопределено Тогда
		ТаблицаОстатков = Новый ТаблицаЗначений;
		ТаблицаОстатков.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаОстатков.Колонки.Добавить("КлючЗатрат", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
		ТаблицаОстатков.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
		ТаблицаОстатков.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ТаблицаОстатков.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ТаблицаОстатков.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ТаблицаОстатков.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	Возврат ТаблицаОстатков;
КонецФункции

Функция ТекстЗапросаДляФормированияМатрицыСистемыУравнений()
	Возврат
	"ВЫБРАТЬ
	|	Т1.Подразделение КАК Подразделение,
	|	Т1.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Т1.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	Т1.Номенклатура КАК Номенклатура,
	|	Т1.Счет105 КАК Счет105,
	|	Т1.КПС105 КАК КПС105,
	|	Т1.Тэтта КАК Тэтта
	|ПОМЕСТИТЬ КоэффициентыТэтта
	|ИЗ
	|	&КоэффициентыТэтта КАК Т1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	НоменклатурнаяГруппа,
	|	Номенклатура,
	|	Счет105,
	|	КПС105
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т2.КорПодразделение КАК КорПодразделение,
	|	Т2.Номенклатура КАК Номенклатура,
	|	Т2.Счет КАК Счет,
	|	Т2.КПС КАК КПС,
	|	Т2.ИндексКолонки КАК ИндексКолонки,
	|	Т2.Гамма КАК Гамма
	|ПОМЕСТИТЬ КоэффициентыГамма
	|ИЗ
	|	&КоэффициентыГамма КАК Т2
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИндексКолонки,
	|	Счет,
	|	КПС,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т3.ИндексОбъектаРасчета КАК ИндексОбъектаРасчета,
	|	Т3.Подразделение КАК Подразделение,
	|	Т3.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	Т3.ТипНоменклатуры КАК ТипНоменклатуры,
	|	Т3.ВидЗатрат КАК ВидЗатрат,
	|	Т3.КЭК КАК КЭК,
	|	Т3.КПС КАК КПС,
	|	Т3.КлючЗатрат КАК КлючЗатрат,
	|	Т3.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Т3.ВидДеятельностиНУ КАК ВидДеятельностиНУ
	|ПОМЕСТИТЬ ОбъектыРасчета
	|ИЗ
	|	&ОбъектыРасчета КАК Т3
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИндексОбъектаРасчета,
	|	НоменклатурнаяГруппа,
	|	НаправлениеДеятельности,
	|	КлючЗатрат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т4.Подразделение КАК Подразделение,
	|	Т4.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Т4.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	Т4.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТаблицаКонечныеОстатки
	|ИЗ
	|	&ТаблицаКонечныеОстатки КАК Т4
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	НоменклатурнаяГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т5.Номенклатура КАК Номенклатура,
	|	Т5.Счет КАК Счет,
	|	Т5.КПС КАК КПС,
	|	Т5.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТаблицаОстатков105
	|ИЗ
	|	&ТаблицаОстатков105 КАК Т5
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КПС,
	|	Счет,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т6.Номенклатура КАК Номенклатура,
	|	Т6.КлючЗатрат КАК КлючЗатрат,
	|	Т6.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Т6.Подразделение КАК Подразделение,
	|	Т6.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТаблицаОстатков109
	|ИЗ
	|	&ТаблицаОстатков109 КАК Т6
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	Номенклатура,
	|	КлючЗатрат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбъектРасчета.ИндексОбъектаРасчета КАК ИндексОбъектаРасчета,
	|	-СУММА(ЕСТЬNULL(ГаммаСтрокиРасчета.Гамма, 0) * ЕСТЬNULL(КоэффициентыТэтта.Тэтта, 0)) КАК Коэффициент,
	|	КолонкаРасчета.ИндексОбъектаРасчета КАК ИндексКолонкиРасчета
	|ПОМЕСТИТЬ КоэффициентыПоОбъектам
	|ИЗ
	|	ОбъектыРасчета КАК ОбъектРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбъектыРасчета КАК КолонкаРасчета
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыГамма КАК ГаммаСтрокиРасчета
	|		ПО ОбъектРасчета.ИндексОбъектаРасчета = ГаммаСтрокиРасчета.ИндексКолонки
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыТэтта КАК КоэффициентыТэтта
	|		ПО (КолонкаРасчета.Подразделение = КоэффициентыТэтта.Подразделение)
	|			И (КолонкаРасчета.НаправлениеДеятельности = КоэффициентыТэтта.НаправлениеДеятельности)
	|			И (КолонкаРасчета.НоменклатурнаяГруппа = КоэффициентыТэтта.НоменклатурнаяГруппа)
