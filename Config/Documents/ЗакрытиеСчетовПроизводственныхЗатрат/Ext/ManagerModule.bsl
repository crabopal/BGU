#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьЗакрытиеСчетовПроизводственныхЗатратВФоне(Параметры, АдресРезультата) Экспорт

	ДанныеШапки = Параметры.ДанныеШапки;
	
	ВременныйОбъект = СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ВременныйОбъект, ДанныеШапки);
	ВременныйОбъект.ЗаполнитьДокумент();
	
	РезультатЗаполнения = Новый Структура;
	МетаданныеДокумента = ВременныйОбъект.Метаданные();
	ДанныеШапки = Новый Структура;
	Для каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		ДанныеШапки.Вставить(Реквизит.Имя, ВременныйОбъект[Реквизит.Имя]);
	КонецЦикла;
	РезультатЗаполнения.Вставить("ДанныеШапки", ДанныеШапки);
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		ДанныеТабличнойЧасти = ВременныйОбъект[ТабличнаяЧасть.Имя].Выгрузить();
		РезультатЗаполнения.Вставить(ТабличнаяЧасть.Имя, ДанныеТабличнойЧасти);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(РезультатЗаполнения, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("РаспределениеОбщихЗатрат", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КорректировкаРаспределенияЗатрат", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РаспределениеОбщихЗатрат.Ссылка.Дата КАК ПериодРасчета,
	|	РаспределениеОбщихЗатрат.Ссылка.Организация,
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	ВЫБОР
	|		КОГДА РаспределениеОбщихЗатрат.СчетУчета В (&СчетаОбщепроизводственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты)
	|		КОГДА РаспределениеОбщихЗатрат.СчетУчета В (&СчетаОбщехозяйственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ПустаяСсылка)
	|	КОНЕЦ КАК ВидОбщихЗатрат,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.Сумма,
	|	РаспределениеОбщихЗатрат.СуммаЕНВД,
	|	РаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.СуммаБазы,
	|	РаспределениеОбщихЗатрат.СуммаБазыЕНВД,
	|	РаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.БазаРаспределения
	|ИЗ
	|	Документ.ЗакрытиеСчетовПроизводственныхЗатрат.РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|ГДЕ
	|	РаспределениеОбщихЗатрат.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РаспределениеОбщихЗатрат.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаРаспределенияЗатрат.Ссылка.Дата КАК ПериодРасчета,
	|	КорректировкаРаспределенияЗатрат.Ссылка.Организация,
	|	КорректировкаРаспределенияЗатрат.ИФО,
	|	КорректировкаРаспределенияЗатрат.КФО,
	|	КорректировкаРаспределенияЗатрат.Подразделение,
	|	ВЫБОР
	|		КОГДА КорректировкаРаспределенияЗатрат.СчетУчета В (&СчетаОбщепроизводственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты)
	|		КОГДА КорректировкаРаспределенияЗатрат.СчетУчета В (&СчетаОбщехозяйственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ПустаяСсылка)
	|	КОНЕЦ КАК ВидОбщихЗатрат,
	|	КорректировкаРаспределенияЗатрат.ВидЗатрат,
	|	КорректировкаРаспределенияЗатрат.КЭК,
	|	КорректировкаРаспределенияЗатрат.СчетУчета,
	|	КорректировкаРаспределенияЗатрат.КПС,
	|	КорректировкаРаспределенияЗатрат.НаправлениеДеятельности,
	|	КорректировкаРаспределенияЗатрат.КорСчет,
	|	КорректировкаРаспределенияЗатрат.КорКПС,
	|	КорректировкаРаспределенияЗатрат.КорНоменклатурнаяГруппа,
	|	КорректировкаРаспределенияЗатрат.КорПодразделение,
	|	КорректировкаРаспределенияЗатрат.КорНаправлениеДеятельности,
	|	КорректировкаРаспределенияЗатрат.Сумма,
	|	0 КАК СуммаБазы,
	|	ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхЗатрат.ПустаяСсылка) КАК БазаРаспределения
	|ИЗ
	|	Документ.ЗакрытиеСчетовПроизводственныхЗатрат.КорректировкаРаспределенияЗатрат КАК КорректировкаРаспределенияЗатрат
	|ГДЕ
	|	КорректировкаРаспределенияЗатрат.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаРаспределенияЗатрат.НомерСтроки";
	
	Запрос.УстановитьПараметр("СчетаОбщепроизводственныхЗатрат",
		БухгалтерскийУчет.СписокСчетов("109.70,Н25.01"));
	Запрос.УстановитьПараметр("СчетаОбщехозяйственныхЗатрат",
		БухгалтерскийУчет.СписокСчетов("109.80,Н26.01"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	РаспределениеОбщихЗатрат         = Результат[НомераТаблиц["РаспределениеОбщихЗатрат"]].Выгрузить();
	КорректировкаРаспределенияЗатрат = Результат[НомераТаблиц["КорректировкаРаспределенияЗатрат"]].Выгрузить();
	
	// При корректировке распределения затрат применяется та же база распределения,
	// что и при первоначальном распределении общих затрат.
	Для Каждого СтрокаКорректировкиЗатрат Из КорректировкаРаспределенияЗатрат Цикл
		
		Отбор = Новый Структура("ИФО,КФО,Подразделение,ВидОбщихЗатрат,ВидЗатрат,КЭК,СчетУчета,КПС,НаправлениеДеятельности,
			|КорСчет,КорКПС,КорНоменклатурнаяГруппа,КорПодразделение,КорНаправлениеДеятельности");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаКорректировкиЗатрат);
		НайденныеСтроки = РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Сумма = НайденныеСтроки[0].Сумма + СтрокаКорректировкиЗатрат.Сумма;
		Иначе
			НоваяСтрокаРаспределения = РаспределениеОбщихЗатрат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, СтрокаКорректировкиЗатрат);
		КонецЕсли;
		
	КонецЦикла;
	
	РаспределениеОбщихЗатрат.Свернуть("ПериодРасчета,Организация,ИФО,КФО,Подразделение,
		|ВидОбщихЗатрат,ВидЗатрат,КЭК,СчетУчета,КПС,НаправлениеДеятельности,
		|КорСчет,КорКПС,КорНоменклатурнаяГруппа,КорПодразделение,КорНаправлениеДеятельности,БазаРаспределения",
		"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ");
	
	ТаблицыДляДвижений.Вставить("РасчетРаспределенияОбщихЗатрат", РаспределениеОбщихЗатрат);
	
КонецПроцедуры

// Структура таблицы источника данных "Фактическая стоимость выпущенной продукции".
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица фактическая стоимость продукции:
// * ИмяСписка - Строка
// * СинонимСписка - Строка
// * НомерСтроки - Число
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * СчетСебестоимости - ПланСчетовСсылка.ЕПСБУ - 
// * КПССебестоимости - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * ПодразделениеСебестоимости - СправочникСсылка.Подразделения - 
// * НоменклатурнаяГруппа - СправочникСсылка.Номенклатура - 
// * НаправлениеДеятельности - СправочникСсылка.НаправленияДеятельности - 
// * ВидЗатрат - СправочникСсылка.ВидыЗатрат - 
// * КЭК - СправочникСсылка.КОСГУ - 
// * СчетГотовойПродукции - ПланСчетовСсылка.ЕПСБУ - 
// * КПСГотовойПродукции - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * КЭКГотовойПродукции - СправочникСсылка.КОСГУ - 
// * ПодразделениеГотовойПродукции - СправочникСсылка.Подразделения - 
// * Номенклатура - СправочникСсылка.Номенклатура - 
// * Количество - Число 
// * ФактическаяСтоимость - Число 
Функция ПустаяТаблицаФактическаяСтоимостьПродукции() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Счет и аналитика учета себестоимости готовой продукции (затраты).
	ПустаяТаблица.Колонки.Добавить("СчетСебестоимости",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПССебестоимости",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеСебестоимости", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("НоменклатурнаяГруппа",       Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("НаправлениеДеятельности",    Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",                  Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("КЭК",                        Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	// Счет и аналитика учета готовой продукции (материальные запасы).
	ПустаяТаблица.Колонки.Добавить("СчетГотовойПродукции",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСГотовойПродукции",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКГотовойПродукции",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеГотовойПродукции", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",                  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",           ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("ФактическаяСтоимость", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Фактическая стоимость выпущенной продукции".
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.ЗакрытиеСчетовПроизводственныхЗатрат
// Возвращаемое значение:
// 	см. ПустаяТаблицаФактическаяСтоимостьПродукции 
Функция ТаблицаФактическаяСтоимостьПродукции(ДокументСсылка) Экспорт
	
	ТаблицаФактическаяСтоимостьПродукции = ПустаяТаблицаФактическаяСтоимостьПродукции();
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаФактическаяСтоимостьПродукции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетСебестоимостиПродукции.Ссылка,
	|	""РасчетСебестоимостиПродукции"" КАК ИмяСписка,
	|	""Расчет себестоимости продукции"" КАК СинонимСписка,
	|	РасчетСебестоимостиПродукции.НомерСтроки,
	|	РасчетСебестоимостиПродукции.ИФО,
	|	РасчетСебестоимостиПродукции.КФО,
	|	РасчетСебестоимостиПродукции.СчетСебестоимости,
	|	ФактическаяСтоимостьПродукции.КПС КАК КПССебестоимости,
	|	РасчетСебестоимостиПродукции.ПодразделениеСебестоимости,
	|	РасчетСебестоимостиПродукции.НоменклатурнаяГруппа,
	|	РасчетСебестоимостиПродукции.НаправлениеДеятельности,
	|	ФактическаяСтоимостьПродукции.ВидЗатрат,
	|	ФактическаяСтоимостьПродукции.КЭК,
	|	РасчетСебестоимостиПродукции.СчетГотовойПродукции,
	|	РасчетСебестоимостиПродукции.КПСГотовойПродукции,
	|	РасчетСебестоимостиПродукции.КЭКГотовойПродукции,
	|	РасчетСебестоимостиПродукции.ПодразделениеГотовойПродукции,
	|	РасчетСебестоимостиПродукции.Номенклатура,
	|	РасчетСебестоимостиПродукции.Количество,
	|	РасчетСебестоимостиПродукции.ПлановаяСтоимость,
	|	ФактическаяСтоимостьПродукции.ФактическаяСтоимость
	|ИЗ
	|	Документ.ЗакрытиеСчетовПроизводственныхЗатрат.РасчетСебестоимостиПродукции КАК РасчетСебестоимостиПродукции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеСчетовПроизводственныхЗатрат.ФактическаяСтоимостьПродукции КАК ФактическаяСтоимостьПродукции
	|		ПО РасчетСебестоимостиПродукции.ИдентификаторСтроки = ФактическаяСтоимостьПродукции.ИдентификаторСтроки
	|ГДЕ
	|	РасчетСебестоимостиПродукции.Ссылка = &Ссылка
	|	И ФактическаяСтоимостьПродукции.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РасчетСебестоимостиПродукции.НомерСтроки,
	|	ФактическаяСтоимостьПродукции.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		НоваяСтрока = ТаблицаФактическаяСтоимостьПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТаблицаФактическаяСтоимостьПродукции;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	
КонецПроцедуры

#КонецОбласти

#Область РаспределениеОбщихЗатрат

// Возвращает структуру параметров учета затрат отдельно для БУ и НУ
// 
// Параметры:
//  Дата - Дата - Дата
//  Организация - СправочникСсылка.Организации - Организация
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - ИФО
//  КФО - ПеречислениеСсылка.КВД - КФО
//  ВидУчета - Строка - Вид учета
// 
// Возвращаемое значение:
//  Структура - Параметры учета затрат:
// * Дата - Дата - 
// * Организация - СправочникСсылка.Организации - 
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * ИспользоватьУчетПоИФО - Булево - 
// * ИспользоватьУчетПоПодразделениям - Булево - 
// * РаспределятьОХЗ - Булево - 
// * РаспределятьОПЗ - Булево - 
// * МетодыРаспределенияКосвенныхЗатрат - ТаблицаЗначений - :
// ** ВидОбщихЗатрат - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство - 
// ** КФО - ПеречислениеСсылка.КВД - 
// ** ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// ** БазаРаспределения - ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат - 
// ** ОсновнаяБаза - Булево - 
// ** ВключатьВБазуОплатаТрудаКЭК212 - Булево - 
// ** ВключатьВБазуОплатаТрудаКЭК213 - Булево - 
// ** ВключатьВБазуОплатаТрудаКЭК214 - Булево - 
// * РассчитыватьСебестоимостьВКонцеГода - Булево - 
// * НачалоПериода - Дата - 
// * КонецПериода - Дата - 
// * СчетСебестоимость - ПланСчетовСсылка, ПланСчетовСсылка.ЕПСБУ - 
// * СчетНакладныеРасходы - ПланСчетовСсылка, ПланСчетовСсылка.ЕПСБУ - 
// * СчетОбщехозяйственныеРасходы - ПланСчетовСсылка, ПланСчетовСсылка.ЕПСБУ - 
// * ЕстьПодразделениеСебестоимость - Булево - 
// * ЕстьПодразделениеНакладныеРасходы - Булево - 
// * ЕстьПодразделениеОбщехозяйственныеРасходы - Булево - 
// * ЕстьНаправлениеДеятельностиСебестоимость - Булево - 
// * ЕстьНаправлениеДеятельностиНакладныеРасходы - Булево - 
// * ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы - Булево - 
Функция ПараметрыУчетаЗатрат(Дата, Организация, ИФО, КФО, ВидУчета = "БУ") Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Дата",        Дата);
	Параметры.Вставить("Организация", Организация);
	Параметры.Вставить("ИФО",         ИФО);
	Параметры.Вставить("КФО",         КФО);
	
	Параметры.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Параметры.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ПараметрыРаспределенияОбщихЗатрат = УчетПроизводства.ПараметрыРаспределенияОбщихЗатрат(Организация, Дата);
	Параметры.Вставить("РаспределятьОХЗ", ПараметрыРаспределенияОбщихЗатрат.РаспределятьОХЗ);
	Параметры.Вставить("РаспределятьОПЗ", ПараметрыРаспределенияОбщихЗатрат.РаспределятьОПЗ);
	Параметры.Вставить("МетодыРаспределенияКосвенныхЗатрат",
		ПараметрыРаспределенияОбщихЗатрат.МетодыРаспределенияКосвенныхЗатрат);
	РассчитыватьСебестоимостьВКонцеГода = ПараметрыРаспределенияОбщихЗатрат.РассчитыватьСебестоимостьВКонцеГода;
	Параметры.Вставить("РассчитыватьСебестоимостьВКонцеГода", РассчитыватьСебестоимостьВКонцеГода);
	Если РассчитыватьСебестоимостьВКонцеГода Тогда
		Параметры.Вставить("НачалоПериода", НачалоГода(Дата));
	Иначе
		Параметры.Вставить("НачалоПериода", НачалоМесяца(Дата));
	КонецЕсли;
	Параметры.Вставить("КонецПериода", КонецМесяца(Дата));
	
	Если ВидУчета = "БУ" Тогда
		
		Параметры.Вставить("СчетСебестоимость", БухгалтерскийУчет.СчетПоКоду("109.60"));
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетСебестоимость).ЭлементГруппа Тогда
			Параметры.СчетСебестоимость = БухгалтерскийУчет.СчетПоКоду("109.61");
		КонецЕсли;
		
		Параметры.Вставить("СчетНакладныеРасходы", БухгалтерскийУчет.СчетПоКоду("109.70"));
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетНакладныеРасходы).ЭлементГруппа Тогда
			Параметры.СчетНакладныеРасходы = БухгалтерскийУчет.СчетПоКоду("109.71");
		КонецЕсли;
		
		Параметры.Вставить("СчетОбщехозяйственныеРасходы", БухгалтерскийУчет.СчетПоКоду("109.80"));
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетОбщехозяйственныеРасходы).ЭлементГруппа Тогда
			Параметры.СчетОбщехозяйственныеРасходы = БухгалтерскийУчет.СчетПоКоду("109.81");
		КонецЕсли;
		
	Иначе // НУ
		
		Параметры.Вставить("СчетСебестоимость",            БухгалтерскийУчет.СчетПоКоду("Н20.01"));
		Параметры.Вставить("СчетНакладныеРасходы",         БухгалтерскийУчет.СчетПоКоду("Н25.01"));
		Параметры.Вставить("СчетОбщехозяйственныеРасходы", БухгалтерскийУчет.СчетПоКоду("Н26.01"));
		
	КонецЕсли;
	
	Если Параметры.ИспользоватьУчетПоПодразделениям Тогда
		Параметры.Вставить("ЕстьПодразделениеСебестоимость",            БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетСебестоимость).УчетПоПодразделениям);
		Параметры.Вставить("ЕстьПодразделениеНакладныеРасходы",         БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетНакладныеРасходы).УчетПоПодразделениям);
		Параметры.Вставить("ЕстьПодразделениеОбщехозяйственныеРасходы", БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетОбщехозяйственныеРасходы).УчетПоПодразделениям);
	Иначе
		Параметры.Вставить("ЕстьПодразделениеСебестоимость",            Ложь);
		Параметры.Вставить("ЕстьПодразделениеНакладныеРасходы",         Ложь);
		Параметры.Вставить("ЕстьПодразделениеОбщехозяйственныеРасходы", Ложь);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНаправлениеДеятельностиСебестоимость
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка = &СчетСебестоимость
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНаправлениеДеятельностиНакладныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка = &СчетНакладныеРасходы
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка = &СчетОбщехозяйственныеРасходы
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)";
	Запрос.УстановитьПараметр("СчетСебестоимость",            Параметры.СчетСебестоимость);
	Запрос.УстановитьПараметр("СчетНакладныеРасходы",         Параметры.СчетНакладныеРасходы);
	Запрос.УстановитьПараметр("СчетОбщехозяйственныеРасходы", Параметры.СчетОбщехозяйственныеРасходы);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Параметры.Вставить("ЕстьНаправлениеДеятельностиСебестоимость",            НЕ РезультатЗапроса[0].Пустой());
	Параметры.Вставить("ЕстьНаправлениеДеятельностиНакладныеРасходы",         НЕ РезультатЗапроса[1].Пустой());
	Параметры.Вставить("ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы", НЕ РезультатЗапроса[2].Пустой());
	
	Возврат Параметры;
	
КонецФункции

// Выполняет распределение общих расходов (накладных и общехозяйственных) в БУ и НУ
// на счета учета себестоимости производства.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗакрытиеСчетовПроизводственныхЗатрат
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//	ВидУчета                     - Строка - "БУ" или "НУ"
//
Процедура РаспределитьОбщиеЗатраты(ДокументОбъект, ПараметрыРаспределенияЗатрат, ВидУчета = "БУ")
	
	Если НЕ (ПараметрыРаспределенияЗатрат.РаспределятьОПЗ ИЛИ ПараметрыРаспределенияЗатрат.РаспределятьОХЗ) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаБазРаспределения = Новый ТаблицаЗначений;
	ТаблицаБазРаспределения.Колонки.Добавить("ВидОбщихЗатрат",           Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство"));
	ТаблицаБазРаспределения.Колонки.Добавить("БазаРаспределения",        Новый ОписаниеТипов("ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат"));
	ТаблицаБазРаспределения.Колонки.Добавить("ТаблицаБазаРаспределения", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ДеревоОстатков = ПолучитьДеревоОстатковОбщихЗатрат(ПараметрыРаспределенияЗатрат);
	
	Для Каждого СтрокаИтогПоВидуОбщихЗатрат из ДеревоОстатков.Строки Цикл
		
		ВидОбщихЗатрат = СтрокаИтогПоВидуОбщихЗатрат.ВидОбщихЗатрат;
		Если ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты
		   И НЕ ПараметрыРаспределенияЗатрат.РаспределятьОПЗ Тогда
			Продолжить;
		ИначеЕсли ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты
		   И НЕ ПараметрыРаспределенияЗатрат.РаспределятьОХЗ Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаИтогПоИФО из СтрокаИтогПоВидуОбщихЗатрат.Строки Цикл
			Для Каждого СтрокаИтогПоКФО из СтрокаИтогПоИФО.Строки Цикл
		
				ПараметрыРаспределенияТекущейСтроки = УчетПроизводстваКлиентСервер.ПараметрыБазыРаспределенияОбщихЗатрат(
					ПараметрыРаспределенияЗатрат.МетодыРаспределенияКосвенныхЗатрат,
					ВидОбщихЗатрат, СтрокаИтогПоКФО.ИФО, СтрокаИтогПоКФО.КФО);
				Если ПараметрыРаспределенияТекущейСтроки <> Неопределено Тогда
					БазаРаспределения = ПараметрыРаспределенияТекущейСтроки.БазаРаспределения;
				Иначе
					БазаРаспределения = Неопределено;
				КонецЕсли;
				
				НайденныеСтроки = ТаблицаБазРаспределения.НайтиСтроки(
					Новый Структура("ВидОбщихЗатрат, БазаРаспределения", ВидОбщихЗатрат, БазаРаспределения));
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					ТаблицаБазаРаспределения = НайденныеСтроки[0].ТаблицаБазаРаспределения;
					
				Иначе
					
					Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты
					 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда
					 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ПрямыеЗатраты Тогда
						
						//@skip-check query-in-loop
						ТаблицаБазаРаспределения = СформироватьБазуРаспределенияПоЗатратам(
							ВидОбщихЗатрат, ПараметрыРаспределенияТекущейСтроки, ПараметрыРаспределенияЗатрат, ВидУчета);
						
					ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.Выручка Тогда
						
						//@skip-check query-in-loop
						ТаблицаБазаРаспределения = СформироватьБазуРаспределенияПоВыручке(
							ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат, ВидУчета);
						
					ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.РегистрируетсяВручную Тогда
						
						//@skip-check query-in-loop
						ТаблицаБазаРаспределения = СформироватьФиксированнуюБазуРаспределения(
							ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат, ВидУчета);
						
					Иначе
						ТаблицаБазаРаспределения = Неопределено;
					КонецЕсли;
					
					НоваяСтрока = ТаблицаБазРаспределения.Добавить();
					НоваяСтрока.ВидОбщихЗатрат          = ВидОбщихЗатрат;
					НоваяСтрока.БазаРаспределения       = БазаРаспределения;
					НоваяСтрока.ТаблицаБазаРаспределения = ТаблицаБазаРаспределения;
					
				КонецЕсли;
				
				РаспределитьОбщиеЗатратыПоБазе(ДокументОбъект, ВидУчета, ВидОбщихЗатрат, СтрокаИтогПоКФО,
					ПараметрыРаспределенияЗатрат, ТаблицаБазаРаспределения, БазаРаспределения);
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Возвращает дерево остатков общих затрат для распределения
//
// Параметры:
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//
// Возвращаемое значение - ДеревоЗначений - дерево остатков общих затрат к распределению
//
Функция ПолучитьДеревоОстатковОбщихЗатрат(ПараметрыРаспределенияЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОстатки.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Счет В (&СчетНакладныеРасходы)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты)
	|	КОНЕЦ КАК ВидОбщихЗатрат,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ВЫБОР
	|		КОГДА &ЕстьНаправлениеДеятельностиНакладныеРасходы
	|				И ЕПСБУОстатки.Счет = &СчетНакладныеРасходы
	|			ТОГДА ВЫБОР
	|					КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.НаправленияДеятельности
	|						ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.НаправленияДеятельности)
	|					КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.НаправленияДеятельности
	|						ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто3 КАК Справочник.НаправленияДеятельности)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|				КОНЕЦ
	|		КОГДА &ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы
	|				И ЕПСБУОстатки.Счет = &СчетОбщехозяйственныеРасходы
	|			ТОГДА ВЫБОР
	|					КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.НаправленияДеятельности
	|						ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.НаправленияДеятельности)
	|					КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.НаправленияДеятельности
	|						ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто3 КАК Справочник.НаправленияДеятельности)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	КОНЕЦ КАК НаправлениеДеятельности,
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2,
	|	ЕПСБУОстатки.Субконто3,
	|	СУММА(ЕПСБУОстатки.СуммаОстатокДт) КАК Сумма,
	|	СУММА(ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт) КАК СуммаНеУчитываетсяНУ,
	|	СУММА(ЕПСБУОстатки.СуммаЕНВДОстатокДт) КАК СуммаЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодЗапроса,
	|			Счет В (&СчетаОбщихЗатрат),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО) КАК ЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет,
	|	ЕПСБУОстатки.ИФО,
	|	ЕПСБУОстатки.КФО,
	|	ЕПСБУОстатки.Подразделение,
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2,
	|	ЕПСБУОстатки.Субконто3,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЕСТЬNULL(ЕПСБУОстатки.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидОбщихЗатрат,
	|	ИФО,
	|	КФО,
	|	Счет,
	|	Подразделение,
	|	КПС,
	|	НаправлениеДеятельности
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНеУчитываетсяНУ),
	|	СУММА(СуммаЕНВД)
	|ПО
	|	ВидОбщихЗатрат,
	|	ИФО,
	|	КФО,
	|	Счет,
	|	Подразделение,
	|	КПС,
	|	НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("ПериодЗапроса",  Новый Граница(ПараметрыРаспределенияЗатрат.КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",    ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ИФО",            ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",            ПараметрыРаспределенияЗатрат.КФО);
	
	Запрос.УстановитьПараметр("СчетНакладныеРасходы",                                ПараметрыРаспределенияЗатрат.СчетНакладныеРасходы);
	Запрос.УстановитьПараметр("СчетОбщехозяйственныеРасходы",                        ПараметрыРаспределенияЗатрат.СчетОбщехозяйственныеРасходы);
	Запрос.УстановитьПараметр("ЕстьНаправлениеДеятельностиНакладныеРасходы",         ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы);
	Запрос.УстановитьПараметр("ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы", ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы);
	Запрос.УстановитьПараметр("ЕстьПодразделениеНакладныеРасходы",                   ПараметрыРаспределенияЗатрат.ЕстьПодразделениеНакладныеРасходы);
	Запрос.УстановитьПараметр("ЕстьПодразделениеОбщехозяйственныеРасходы",           ПараметрыРаспределенияЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы);
	
	СчетаОбщихЗатрат = Новый Массив;
	Если ПараметрыРаспределенияЗатрат.РаспределятьОПЗ Тогда
		СчетаОбщихЗатрат.Добавить(ПараметрыРаспределенияЗатрат.СчетНакладныеРасходы);
	КонецЕсли;
	Если ПараметрыРаспределенияЗатрат.РаспределятьОХЗ Тогда
		СчетаОбщихЗатрат.Добавить(ПараметрыРаспределенияЗатрат.СчетОбщехозяйственныеРасходы);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаОбщихЗатрат", СчетаОбщихЗатрат);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.Подразделение",
			"ВЫБОР
			|	КОГДА &ЕстьПодразделениеНакладныеРасходы
			|			И ЕПСБУОстатки.Счет = &СчетНакладныеРасходы
			|		ТОГДА ЕстьNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
			|	КОГДА &ЕстьПодразделениеОбщехозяйственныеРасходы
			|			И ЕПСБУОстатки.Счет = &СчетОбщехозяйственныеРасходы
			|		ТОГДА ЕстьNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
			|	ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
			|КОНЕЦ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ДеревоОстатков = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат ДеревоОстатков;
	
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по затратам
//
// Параметры:
//	ВидОбщихЗатрат               - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство -
//	                                 ОбщепроизводственныеЗатраты или ОбщехозяйственныеЗатраты
//  ПараметрыРаспределенияТекущейСтроки - СтрокаТаблицыЗначений:
//   * БазаРаспределения - ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат - прямые, материальные или оплата труда
//   
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см.ПараметрыУчетаЗатрат()
//	ВидУчета                     - Строка - "БУ" или "НУ"
//
// Возвращаемое значение:
//	ТаблицаЗначений - таблица базы распределения
//
Функция СформироватьБазуРаспределенияПоЗатратам(ВидОбщихЗатрат, ПараметрыРаспределенияТекущейСтроки, ПараметрыРаспределенияЗатрат, ВидУчета) Экспорт
	
	БазаРаспределения = ПараметрыРаспределенияТекущейСтроки.БазаРаспределения;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВложенныйЗапрос.Счет КАК Счет,
	|	ВложенныйЗапрос.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаОборотДт
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаЕНВДОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаЕНВДОборотДт
	|		КОНЕЦ) КАК СуммаЕНВД,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаНеУчитываетсяНУОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаНеУчитываетсяНУОборотДт
	|		КОНЕЦ) КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОбороты.ИФО КАК ИФО,
	|		ЕПСБУОбороты.КФО КАК КФО,
	|		ЕПСБУОбороты.Подразделение КАК Подразделение,
	|		ЕПСБУОбороты.Счет КАК Счет,
	|		ЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
	|		ЕПСБУОбороты.Субконто3 КАК НаправлениеДеятельности,
	|		СУММА(ЕПСБУОбороты.СуммаОборотДт) КАК СуммаОборотДт,
	|		СУММА(ЕПСБУОбороты.СуммаЕНВДОборотДт) КАК СуммаЕНВДОборотДт,
	|		СУММА(ЕПСБУОбороты.СуммаНеУчитываетсяНУОборотДт) КАК СуммаНеУчитываетсяНУОборотДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Период,
	|				Счет = &СчетСебестоимость,
	|				,
	|				Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И &УсловиеКЭК
	|					И &УсловиеВидЗатрат,
	|				&УсловиеКорСчет,
	|				) КАК ЕПСБУОбороты
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЕПСБУОбороты.ИФО,
	|		ЕПСБУОбороты.КФО,
	|		ЕПСБУОбороты.Подразделение,
	|		ЕПСБУОбороты.Счет,
	|		ЕПСБУОбороты.Субконто1,
	|		ЕПСБУОбороты.Субконто3) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.Подразделение,
	|	ВложенныйЗапрос.НаправлениеДеятельности,
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.НоменклатурнаяГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	НоменклатурнаяГруппа,
	|	НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРаспределенияЗатрат.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  ПараметрыРаспределенияЗатрат.КонецПериода);
	Запрос.УстановитьПараметр("Организация",   ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ИФО",           ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",           ПараметрыРаспределенияЗатрат.КФО);
	
	Запрос.УстановитьПараметр("СчетСебестоимость", ПараметрыРаспределенияЗатрат.СчетСебестоимость);
	
	ИсключенияКорСчетов = Новый Массив;
	КорСчета = Новый Массив;
	КЭКОборотов = Новый Массив;
	ВидыРасходовНУ = Новый Массив;
	Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты Тогда
		
		Если ВидУчета = "НУ" Тогда
			КорСчета = БухгалтерскийУчет.СписокСчетов("Н10,Н41,Н43");
		Иначе
			КорСчета = БухгалтерскийУчет.СписокСчетов("105.00");
		КонецЕсли;
		
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда Тогда
		
		Если ВидУчета = "НУ" Тогда
			ВидыРасходовНУ = ВидыРасходовНУОтраженияЗП(ПараметрыРаспределенияТекущейСтроки);
		Иначе
			КЭКОборотов = КЭКОтраженияЗП(ПараметрыРаспределенияТекущейСтроки);
		КонецЕсли;
		ИсключенияКорСчетов.Добавить(ПараметрыРаспределенияЗатрат.СчетСебестоимость);
		ИсключенияКорСчетов.Добавить(ПараметрыРаспределенияЗатрат.СчетНакладныеРасходы);
		ИсключенияКорСчетов.Добавить(ПараметрыРаспределенияЗатрат.СчетОбщехозяйственныеРасходы);
		
	КонецЕсли;
	Если КорСчета.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчет", "КорСчет В (&КорСчета)");
		Запрос.УстановитьПараметр("КорСчета", КорСчета);
	ИначеЕсли ИсключенияКорСчетов.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчет", "КорСчет НЕ В (&КорСчета)");
		Запрос.УстановитьПараметр("КорСчета", ИсключенияКорСчетов);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчет", "");
	КонецЕсли;
	Если КЭКОборотов.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКЭК", "КЭК В (&КЭКОборотов)");
		Запрос.УстановитьПараметр("КЭКОборотов", КЭКОборотов);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКЭК", "ИСТИНА");
	КонецЕсли;
	Если ВидыРасходовНУ.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидЗатрат",
			"Выразить(Субконто2 КАК Справочник.ВидыЗатрат).ВидРасходовНУ В (&ВидыРасходовНУ)");
		Запрос.УстановитьПараметр("ВидыРасходовНУ", ВидыРасходовНУ);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидЗатрат", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто3 КАК Справочник.НаправленияДеятельности)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВидыРасходовНУОтраженияЗП(ПараметрыРаспределенияЗатрат)
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыРасходовНУ.ОплатаТруда);
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК213 Тогда
		Результат.Добавить(Перечисления.ВидыРасходовНУ.СтраховыеВзносы);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// КЭК, включаемые в базу распределения "Оплата труда".
// 
// Параметры:
//  ПараметрыРаспределенияЗатрат - СтрокаТаблицыЗначений - Параметры распределения затрат:
//   * ВключатьВБазуОплатаТрудаКЭК212 - Булево
//   * ВключатьВБазуОплатаТрудаКЭК213 - Булево
//   * ВключатьВБазуОплатаТрудаКЭК214 - Булево
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КОСГУ
Функция КЭКОтраженияЗП(ПараметрыРаспределенияЗатрат)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	НЕ КОСГУ.ПометкаУдаления
	|	И КОСГУ.Код В (&КодыКОСГУ)";
	КодыКОСГУ = Новый Массив;
	КодыКОСГУ.Добавить("211");
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК212 Тогда
		КодыКОСГУ.Добавить("212");
	КонецЕсли;
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК213 Тогда
		КодыКОСГУ.Добавить("213");
	КонецЕсли;
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК214 Тогда
		КодыКОСГУ.Добавить("214");
	КонецЕсли;
	Запрос.УстановитьПараметр("КодыКОСГУ", КодыКОСГУ);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по выручке
//
// Параметры:
//	ВидОбщихЗатрат               - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство -
//	                                 ОбщепроизводственныеЗатраты или ОбщехозяйственныеЗатраты
//	БазаРаспределения            - ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат - выручка
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//	ВидУчета                     - Строка - "БУ" или "НУ"
//
// Возвращаемое значение:
//	ТаблицаЗначений - таблица базы распределения
//
Функция СформироватьБазуРаспределенияПоВыручке(ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат, ВидУчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.ИФО КАК ИФО,
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.Счет,
	|	ЕПСБУОбороты.Подразделение КАК Подразделение,
	|	ЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
	|	ЕПСБУОбороты.Субконто3 КАК НаправлениеДеятельности,
	|	СУММА(ЕПСБУОбороты.СуммаОборотДт) КАК Сумма,
	|	СУММА(ЕПСБУОбороты.СуммаЕНВДОборотДт) КАК СуммаЕНВД,
	|	СУММА(ЕПСБУОбороты.СуммаНеУчитываетсяНУОборотДт) КАК СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ ТабПрямыхЗатрат
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			Счет = &СчетСебестоимость,
	|			,
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО,
	|			,
	|			) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.Счет,
	|	ЕПСБУОбороты.Подразделение,
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.Субконто3
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	НоменклатурнаяГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	СоставНоменклатурныхГрупп.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ СоставНоменклатурныхГрупп
	|ИЗ
	|	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|ГДЕ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа В
	|			(ВЫБРАТЬ
	|				Таб.НоменклатурнаяГруппа
	|			ИЗ
	|				ТабПрямыхЗатрат КАК Таб)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыручкаБезНДС.ИФО КАК ИФО,
	|	ВыручкаБезНДС.КФО КАК КФО,
	|	ВыручкаБезНДС.СчетВыручки КАК СчетВыручки,
	|	ВыручкаБезНДС.ЕстьПодразделение КАК ЕстьПодразделение,
	|	ВыручкаБезНДС.Подразделение КАК Подразделение,
	|	ВыручкаБезНДС.ЕстьНаправлениеДеятельности КАК ЕстьНаправлениеДеятельности,
	|	ВыручкаБезНДС.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВыручкаБезНДС.Номенклатура КАК Номенклатура,
	|	СУММА(ВыручкаБезНДС.Сумма) КАК Сумма,
	|	СУММА(ВыручкаБезНДС.СуммаЕНВД) КАК СуммаЕНВД,
	|	СУММА(ВыручкаБезНДС.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ Выручка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВыручкаСНДС.ИФО КАК ИФО,
	|		ВыручкаСНДС.КФО КАК КФО,
	|		ВыручкаСНДС.СчетКт КАК СчетВыручки,
	|		ВыручкаСНДС.СчетКт.УчетПоПодразделениям КАК ЕстьПодразделение,
	|		ЕСТЬNULL(ВыручкаСНДС.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|		ВЫБОР
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	|		ВЫБОР
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт1 КАК Справочник.НаправленияДеятельности)
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт2 КАК Справочник.НаправленияДеятельности)
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт3 КАК Справочник.НаправленияДеятельности)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ КАК НаправлениеДеятельности,
	|		ВЫРАЗИТЬ(ВыручкаСНДС.ХарактеристикаДвиженияКт КАК Справочник.Номенклатура) КАК Номенклатура,
	|		ВыручкаСНДС.Сумма КАК Сумма,
	|		ВыручкаСНДС.СуммаЕНВД КАК СуммаЕНВД,
	|		ВыручкаСНДС.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Активность
	|					И Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И СчетКт В (&СчетаВыручки)
	|					И ВЫРАЗИТЬ(ХарактеристикаДвиженияКт КАК Справочник.Номенклатура) ЕСТЬ НЕ NULL 
	|					И (ВЫРАЗИТЬ(ХарактеристикаДвиженияКт КАК Справочник.Номенклатура)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|				,
	|				) КАК ВыручкаСНДС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСПоДаннымСчетовФактур.ИФО,
	|		НДСПоДаннымСчетовФактур.КФО,
	|		НДСПоДаннымСчетовФактур.СчетДт,
	|		НДСПоДаннымСчетовФактур.СчетДт.УчетПоПодразделениям,
	|		ЕСТЬNULL(НДСПоДаннымСчетовФактур.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|		ВЫБОР
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт1 КАК Справочник.НаправленияДеятельности)
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт2 КАК Справочник.НаправленияДеятельности)
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт3 КАК Справочник.НаправленияДеятельности)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ,
	|		ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.ХарактеристикаДвиженияДт КАК Справочник.Номенклатура),
	|		-НДСПоДаннымСчетовФактур.Сумма,
	|		-НДСПоДаннымСчетовФактур.СуммаЕНВД,
	|		-НДСПоДаннымСчетовФактур.СуммаНеУчитываетсяНУ
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Активность
	|					И Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И СчетДт В (&СчетаВыручки)
	|					И ВЫРАЗИТЬ(ХарактеристикаДвиженияДт КАК Справочник.Номенклатура) ЕСТЬ НЕ NULL 
	|					И (ВЫРАЗИТЬ(ХарактеристикаДвиженияДт КАК Справочник.Номенклатура)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					И Регистратор ССЫЛКА Документ.СчетФактураВыданный,
	|				,
	|				) КАК НДСПоДаннымСчетовФактур) КАК ВыручкаБезНДС
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаБезНДС.ИФО,
	|	ВыручкаБезНДС.КФО,
	|	ВыручкаБезНДС.СчетВыручки,
	|	ВыручкаБезНДС.ЕстьПодразделение,
	|	ВыручкаБезНДС.Подразделение,
	|	ВыручкаБезНДС.ЕстьНаправлениеДеятельности,
	|	ВыручкаБезНДС.НаправлениеДеятельности,
	|	ВыручкаБезНДС.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВыручки.ИФО КАК ИФО,
	|	ТаблицаВыручки.КФО КАК КФО,
	|	ТаблицаВыручки.СчетВыручки,
	|	ТаблицаВыручки.ЕстьПодразделение,
	|	ТаблицаВыручки.Подразделение КАК Подразделение,
	|	ТаблицаВыручки.ЕстьНаправлениеДеятельности,
	|	ТаблицаВыручки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаВыручки.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ТаблицаВыручки.Сумма КАК СуммаВыручки,
	|	ТаблицаВыручки.СуммаЕНВД КАК СуммаВыручкиЕНВД,
	|	ТаблицаВыручки.СуммаНеУчитываетсяНУ КАК СуммаВыручкиНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		Выручка.ИФО КАК ИФО,
	|		Выручка.КФО КАК КФО,
	|		Выручка.СчетВыручки КАК СчетВыручки,
	|		Выручка.ЕстьПодразделение КАК ЕстьПодразделение,
	|		Выручка.Подразделение КАК Подразделение,
	|		Выручка.ЕстьНаправлениеДеятельности КАК ЕстьНаправлениеДеятельности,
	|		Выручка.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		ЕСТЬNULL(СоставНоменклатурныхГрупп.НоменклатурнаяГруппа, Выручка.Номенклатура) КАК НоменклатурнаяГруппа,
	|		СУММА(Выручка.Сумма) КАК Сумма,
	|		СУММА(Выручка.СуммаЕНВД) КАК СуммаЕНВД,
	|		СУММА(Выручка.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
	|	ИЗ
	|		Выручка КАК Выручка
	|			ЛЕВОЕ СОЕДИНЕНИЕ СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|			ПО Выручка.Номенклатура = СоставНоменклатурныхГрупп.Номенклатура
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Выручка.ИФО,
	|		Выручка.КФО,
	|		Выручка.СчетВыручки,
	|		Выручка.ЕстьПодразделение,
	|		Выручка.Подразделение,
	|		Выручка.ЕстьНаправлениеДеятельности,
	|		Выручка.НаправлениеДеятельности,
	|		ЕСТЬNULL(СоставНоменклатурныхГрупп.НоменклатурнаяГруппа, Выручка.Номенклатура)) КАК ТаблицаВыручки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИФО,
	|	КФО,
	|	НоменклатурнаяГруппа,
	|	Подразделение,
	|	НаправлениеДеятельности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабПрямыхЗатрат.ИФО,
	|	ТабПрямыхЗатрат.КФО,
	|	ТабПрямыхЗатрат.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ТабПрямыхЗатрат.Подразделение КАК Подразделение,
	|	ТабПрямыхЗатрат.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТабПрямыхЗатрат.Счет,
	|	ТабПрямыхЗатрат.Сумма КАК СуммаЗатрат,
	|	ТабПрямыхЗатрат.СуммаЕНВД КАК СуммаЗатратЕНВД,
	|	ТабПрямыхЗатрат.СуммаНеУчитываетсяНУ КАК СуммаЗатратНеУчитываетсяНУ
	|ИЗ
	|	ТабПрямыхЗатрат КАК ТабПрямыхЗатрат
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабПрямыхЗатрат.ИФО,
	|	ТабПрямыхЗатрат.КФО,
	|	ТабПрямыхЗатрат.НоменклатурнаяГруппа,
	|	ТабПрямыхЗатрат.Подразделение,
	|	ТабПрямыхЗатрат.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРаспределенияЗатрат.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  ПараметрыРаспределенияЗатрат.КонецПериода);
	Запрос.УстановитьПараметр("Организация",   ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ИФО",           ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",           ПараметрыРаспределенияЗатрат.КФО);
	
	Запрос.УстановитьПараметр("СчетСебестоимость", ПараметрыРаспределенияЗатрат.СчетСебестоимость);
	
	Если ВидУчета = "НУ" Тогда
		Запрос.УстановитьПараметр("СчетаВыручки", БухгалтерскийУчет.СписокСчетов("Н90.01,Н90.02"));
	Иначе
		Запрос.УстановитьПараметр("СчетаВыручки", БухгалтерскийУчет.СписокСчетов("401.10"));
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.ИФО",
			"ЕСТЬNULL(ЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУДвиженияССубконто.ИФО",
			"ЕСТЬNULL(ЕПСБУДвиженияССубконто.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУДвиженияССубконто.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто3 КАК Справочник.НаправленияДеятельности)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)");
	КонецЕсли;
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаВыручки = МассивРезультатов[3].Выгрузить();
	
	ТаблицаБазаРаспределения = МассивРезультатов[4].Выгрузить();
	// Суммы выручки, по которым будут распределены общие затраты.
	ТаблицаБазаРаспределения.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаБазаРаспределения.Колонки.Добавить("СуммаЕНВД", Новый ОписаниеТипов("Число"));
	ТаблицаБазаРаспределения.Колонки.Добавить("СуммаНеУчитываетсяНУ", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаВыручки Из ТаблицаВыручки Цикл
		
		Отбор = Новый Структура("ИФО, КФО, НоменклатурнаяГруппа",
			СтрокаВыручки.ИФО, СтрокаВыручки.КФО, СтрокаВыручки.НоменклатурнаяГруппа);
		Если СтрокаВыручки.ЕстьПодразделение // есть в выручке
		   И ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость // есть в затратах
		Тогда
			Отбор.Вставить("Подразделение", СтрокаВыручки.Подразделение);
		КонецЕсли;
		Если СтрокаВыручки.ЕстьНаправлениеДеятельности // есть в выручке
		   И ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость // есть в затратах
		Тогда
			Отбор.Вставить("НаправлениеДеятельности", СтрокаВыручки.НаправлениеДеятельности);
		КонецЕсли;
		МассивСтрокЗатрат = ТаблицаБазаРаспределения.НайтиСтроки(Отбор);
		БазаРаспределенияЗатрат = ТаблицаБазаРаспределения.Скопировать(МассивСтрокЗатрат);
		
		// Распределим сумму выручки по аналитике прямых затрат пропорционально сумме затрат.
		МассивСуммВыручки = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручки, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатрат"));
		МассивСуммВыручкиЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручкиЕНВД, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатратЕНВД"));
		МассивСуммВыручкиНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручкиНеУчитываетсяНУ, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатратНеУчитываетсяНУ"));
		Если МассивСуммВыручки = Неопределено
		   И МассивСуммВыручкиЕНВД = Неопределено
		   И МассивСуммВыручкиНеУчитываетсяНУ = Неопределено Тогда
			Продолжить; // Для данной суммы выручки нет прямых затрат, исключим ее из базы.
		КонецЕсли;
		
		Для Инд = 0 По МассивСтрокЗатрат.Количество() - 1 Цикл
			
			Сумма                = ?(МассивСуммВыручки     = Неопределено,            0, МассивСуммВыручки[Инд]);
			СуммаЕНВД            = ?(МассивСуммВыручкиЕНВД = Неопределено,            0, МассивСуммВыручкиЕНВД[Инд]);
			СуммаНеУчитываетсяНУ = ?(МассивСуммВыручкиНеУчитываетсяНУ = Неопределено, 0, МассивСуммВыручкиНеУчитываетсяНУ[Инд]);
			
			// На одну строку прямых затрат может быть распределена сумма из разных строк таблицы выручки.
			// Таким образом, в колонке "Сумма" получим всю сумму выручки, раcпределенную по строкам прямых затрат.
			// На некоторые строки прямых затрат может быть не распределено выручки вообще. Это нормально.
			// Общие расходы будут распределены только на те прямые затраты, на которые распределилась выручка.
			МассивСтрокЗатрат[Инд].Сумма                = МассивСтрокЗатрат[Инд].Сумма                + Сумма;
			МассивСтрокЗатрат[Инд].СуммаЕНВД            = МассивСтрокЗатрат[Инд].СуммаЕНВД            + СуммаЕНВД;
			МассивСтрокЗатрат[Инд].СуммаНеУчитываетсяНУ = МассивСтрокЗатрат[Инд].СуммаНеУчитываетсяНУ + СуммаНеУчитываетсяНУ;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаБазаРаспределения;
	
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по фиксированным коэффициентам,
// установленным вручную документом "Установка фиксированной базы распределения".
//
// Параметры:
//	ВидОбщихЗатрат               - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство -
//	                                 ОбщепроизводственныеЗатраты или ОбщехозяйственныеЗатраты
//	БазаРаспределения            - ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат - прямые, материальные или оплата труда
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//	ВидУчета                     - Строка - "БУ" или "НУ"
//
// Возвращаемое значение:
//	ТаблицаЗначений - таблица базы распределения
//
Функция СформироватьФиксированнуюБазуРаспределения(ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат, ВидУчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ПериодДвижений.ИФО КАК ИФО,
	|	ПериодДвижений.КФО КАК КФО
	|ПОМЕСТИТЬ СрезПоследних
	|ИЗ
	|	РегистрСведений.ФиксированнаяБазаРаспределенияОбщихЗатрат.СрезПоследних(
	|			&КонецМесяца,
	|			Организация = &Организация
	|				И ВидОбщихЗатрат = &ВидОбщихЗатрат
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Активность = ИСТИНА) КАК ПериодДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ПериодДвижений.ИФО КАК ИФО,
	|	ПериодДвижений.КФО КАК КФО
	|ПОМЕСТИТЬ ПериодДвижений
	|ИЗ
	|	СрезПоследних КАК ПериодДвижений
	|ГДЕ
	|	ПериодДвижений.Период В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				Т.Период
	|			ИЗ
	|				СрезПоследних КАК Т
	|			ГДЕ
	|				Т.ВидОбщихЗатрат = ПериодДвижений.ВидОбщихЗатрат
	|				И Т.ИФО = ПериодДвижений.ИФО
	|				И Т.КФО = ПериодДвижений.КФО
	|			УПОРЯДОЧИТЬ ПО
	|				Т.Период УБЫВ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФиксированнаяБазаРаспределения.Период КАК Период,
	|	ФиксированнаяБазаРаспределения.Организация КАК Организация,
	|	ФиксированнаяБазаРаспределения.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ФиксированнаяБазаРаспределения.ИФО КАК ИФО,
	|	ФиксированнаяБазаРаспределения.КФО КАК КФО,
	|	ФиксированнаяБазаРаспределения.СчетСебестоимости КАК Счет,
	|	ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение,
	|	ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ФиксированнаяБазаРаспределения.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентНУ
	|		ИНАЧЕ ФиксированнаяБазаРаспределения.Коэффициент
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентЕНВД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВД,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентНеУчитываетсяНУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	ПериодДвижений КАК ПериодДвижений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФиксированнаяБазаРаспределенияОбщихЗатрат КАК ФиксированнаяБазаРаспределения
	|		ПО ПериодДвижений.Период = ФиксированнаяБазаРаспределения.Период
	|			И ПериодДвижений.Организация = ФиксированнаяБазаРаспределения.Организация
	|			И ПериодДвижений.ВидОбщихЗатрат = ФиксированнаяБазаРаспределения.ВидОбщихЗатрат
	|			И ПериодДвижений.ИФО = ФиксированнаяБазаРаспределения.ИФО
	|			И ПериодДвижений.КФО = ФиксированнаяБазаРаспределения.КФО
	|ГДЕ
	|	ФиксированнаяБазаРаспределения.Активность = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФиксированнаяБазаРаспределения.ИФО,
	|	ФиксированнаяБазаРаспределения.КФО,
	|	ФиксированнаяБазаРаспределения.СчетСебестоимости,
	|	ФиксированнаяБазаРаспределения.Подразделение,
	|	ФиксированнаяБазаРаспределения.НоменклатурнаяГруппа,
	|	ФиксированнаяБазаРаспределения.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("КонецМесяца",    КонецМесяца(ПараметрыРаспределенияЗатрат.КонецПериода));
	Запрос.УстановитьПараметр("Организация",    ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ВидОбщихЗатрат", ВидОбщихЗатрат);
	Запрос.УстановитьПараметр("ИФО",            ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",            ПараметрыРаспределенияЗатрат.КФО);
	
	Запрос.УстановитьПараметр("ЭтоНалоговыйУчет", ВидУчета = "НУ");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.ИФО КАК ИФО",
			"ЕСТЬNULL(ФиксированнаяБазаРаспределения.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.ИФО КАК ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение",
			"ЕСТЬNULL(ФиксированнаяБазаРаспределения.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности",
			"ВЫРАЗИТЬ(ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК Справочник.НаправленияДеятельности) КАК НаправлениеДеятельности");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности",
			"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности");
	КонецЕсли;
	
	ТаблицаБазаРаспределения = Запрос.Выполнить().Выгрузить();
	Если ВидУчета = "НУ" Тогда
		СчетПрямыеРасходыПроизводстваНУ = БухгалтерскийУчет.СчетПоКоду("Н20.01",
			ПараметрыРаспределенияЗатрат.КонецПериода, ПараметрыРаспределенияЗатрат.Организация);
		ТаблицаБазаРаспределения.ЗаполнитьЗначения(СчетПрямыеРасходыПроизводстваНУ, "Счет");
	КонецЕсли;
	
	Возврат ТаблицаБазаРаспределения;
	
КонецФункции

// Распредеяет остатки затрат по указанной базе распределения, заполняет таблицу распределения затрат (таблицу движений)
//
Процедура РаспределитьОбщиеЗатратыПоБазе(ДокументОбъект, ВидУчета, ВидОбщихЗатрат, ОстаткиЗатрат,
	ПараметрыРаспределенияЗатрат, СводнаяТаблицаБазаРаспределения, БазаРаспределения)

	Если СводнаяТаблицаБазаРаспределения = Неопределено
	 ИЛИ СводнаяТаблицаБазаРаспределения.Количество() = 0 Тогда
		Возврат; // нет базы распределения
	КонецЕсли;
	
	Если ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда 
		ЕстьНаправлениеДеятельности = ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
		ЕстьПодразделение           = ПараметрыРаспределенияЗатрат.ЕстьПодразделениеНакладныеРасходы;
	ИначеЕсли ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты Тогда 
		ЕстьНаправлениеДеятельности = ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
		ЕстьПодразделение           = ПараметрыРаспределенияЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	КонецЕсли;
	
	
	Для Каждого ОстаткиСчет Из ОстаткиЗатрат.Строки Цикл
		Для Каждого ОстаткиКПС Из ОстаткиСчет.Строки Цикл
			Для Каждого ОстаткиПодразделение Из ОстаткиКПС.Строки Цикл
				
				Для Каждого ОстаткиНаправлениеДеятельности Из ОстаткиПодразделение.Строки Цикл
				
					СтруктураОтбора = Новый Структура("ИФО, КФО", ОстаткиЗатрат.ИФО, ОстаткиЗатрат.КФО);
					Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость // есть в базе распределения
					   И ЕстьПодразделение И ЗначениеЗаполнено(ОстаткиПодразделение.Подразделение) // есть в остатках
					Тогда
						СтруктураОтбора.Вставить("Подразделение", ОстаткиПодразделение.Подразделение);
					КонецЕсли;
					Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость // есть в базе распределения
					   И ЕстьНаправлениеДеятельности И ЗначениеЗаполнено(ОстаткиНаправлениеДеятельности.НаправлениеДеятельности) // есть в остатках
					Тогда
						СтруктураОтбора.Вставить("НаправлениеДеятельности", ОстаткиНаправлениеДеятельности.НаправлениеДеятельности);
					КонецЕсли;
					
					ТаблицаБазаРаспределения = СводнаяТаблицаБазаРаспределения.Скопировать(СводнаяТаблицаБазаРаспределения.НайтиСтроки(СтруктураОтбора));
					Если ВидУчета = "НУ" Тогда
						
						// База распределения затрат по деятельности с основной системой налогообложения включает:
						// 1) суммы затрат (выручки), включаемые в налоговую базу;
						// 2) суммы затрат (выручки), относящиеся к деятельности с ОСН, но не учитываемые в целях налогообложения.
						БазаРаспределенияОСН = ТаблицаБазаРаспределения.ВыгрузитьКолонку("Сумма");
						Для Инд = 0 По ТаблицаБазаРаспределения.Количество() - 1 Цикл
							БазаРаспределенияОСН[Инд] = БазаРаспределенияОСН[Инд] + ТаблицаБазаРаспределения[Инд]["СуммаНеУчитываетсяНУ"];
						КонецЦикла;
						
						// База распределения затрат по деятельности с особым порядком налогообложения (ЕНВД и пр.)
						// включает суммы затрат (выручки), относящиеся к деятельности на ЕНВД.
						БазаРаспределенияЕНВД = ТаблицаБазаРаспределения.ВыгрузитьКолонку("СуммаЕНВД");
						
					Иначе // ВидУчета = "БУ"
						БазаРаспределенияБУ = ТаблицаБазаРаспределения.ВыгрузитьКолонку("Сумма");
					КонецЕсли;
					
					Для Каждого ОстаткиДетальные Из ОстаткиНаправлениеДеятельности.Строки Цикл
						
						Если ВидУчета = "НУ" Тогда
							
							МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
								ОстаткиДетальные.Сумма, БазаРаспределенияОСН);
							МассивСуммСписанияНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
								ОстаткиДетальные.СуммаНеУчитываетсяНУ, БазаРаспределенияОСН);
							МассивСуммСписанияЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
								ОстаткиДетальные.СуммаЕНВД, БазаРаспределенияЕНВД);
							
						Иначе // ВидУчета = "БУ"
							
							МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
								ОстаткиДетальные.Сумма, БазаРаспределенияБУ);
							МассивСуммСписанияНеУчитываетсяНУ = Неопределено;
							МассивСуммСписанияЕНВД = Неопределено;
							
						КонецЕсли;
						
						Для Инд = 0 По ТаблицаБазаРаспределения.Количество() - 1 Цикл
							
							СтрокаБазыРаспределения = ТаблицаБазаРаспределения[Инд];
							
							Сумма                = ?(МассивСуммСписания                = Неопределено, 0, МассивСуммСписания[Инд]);
							СуммаНеУчитываетсяНУ = ?(МассивСуммСписанияНеУчитываетсяНУ = Неопределено, 0, МассивСуммСписанияНеУчитываетсяНУ[Инд]);
							СуммаЕНВД            = ?(МассивСуммСписанияЕНВД            = Неопределено, 0, МассивСуммСписанияЕНВД[Инд]);
							Если Сумма = 0 И СуммаНеУчитываетсяНУ = 0 И СуммаЕНВД = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = ДокументОбъект.РаспределениеОбщихЗатрат.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиДетальные, "ИФО,КФО");
							
							НоваяСтрока.ВидЗатрат = ОстаткиДетальные.ВидЗатрат;
							НоваяСтрока.КЭК       = ОстаткиДетальные.КЭК;
							
							НоваяСтрока.СчетУчета = ОстаткиДетальные.Счет;
							НоваяСтрока.КПС       = ОстаткиДетальные.КПС;
							Если ЕстьНаправлениеДеятельности Тогда
								НоваяСтрока.НаправлениеДеятельности = ОстаткиДетальные.НаправлениеДеятельности;
							КонецЕсли;
							Если ЕстьПодразделение Тогда
								НоваяСтрока.Подразделение = ОстаткиДетальные.Подразделение;
							КонецЕсли;
							
							НоваяСтрока.КорСчет                 = СтрокаБазыРаспределения.Счет;
							НоваяСтрока.КорКПС                  = ОстаткиДетальные.КПС;
							НоваяСтрока.КорНоменклатурнаяГруппа = СтрокаБазыРаспределения.НоменклатурнаяГруппа;
							Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
								НоваяСтрока.КорНаправлениеДеятельности = СтрокаБазыРаспределения.НаправлениеДеятельности;
							КонецЕсли;
							Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
								НоваяСтрока.КорПодразделение = СтрокаБазыРаспределения.Подразделение;
							КонецЕсли;
							
							НоваяСтрока.Сумма                = Сумма;
							НоваяСтрока.СуммаНеУчитываетсяНУ = СуммаНеУчитываетсяНУ;
							НоваяСтрока.СуммаЕНВД            = СуммаЕНВД;
						
							НоваяСтрока.БазаРаспределения = БазаРаспределения;
							Если ВидУчета = "НУ" Тогда
								НоваяСтрока.СуммаБазы                = ?(Сумма                = 0, 0, БазаРаспределенияОСН[Инд]);
								НоваяСтрока.СуммаБазыНеУчитываетсяНУ = ?(СуммаНеУчитываетсяНУ = 0, 0, БазаРаспределенияОСН[Инд]);
								НоваяСтрока.СуммаБазыЕНВД            = ?(СуммаЕНВД            = 0, 0, БазаРаспределенияЕНВД[Инд]);
							Иначе // ВидУчета = "БУ"
								НоваяСтрока.СуммаБазы                = ?(Сумма                = 0, 0, БазаРаспределенияБУ[Инд]);
								НоваяСтрока.СуммаБазыНеУчитываетсяНУ = 0;
								НоваяСтрока.СуммаБазыЕНВД            = 0;
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗакрытиеСчетовПроизводственныхЗатрат

Функция КоличествоЭтаповРасчета(ДеревоОбъектовРасчета)

	КоличествоИФОКФО = 0;
	Для Каждого СтрокаОбъектовИФО Из ДеревоОбъектовРасчета.Строки Цикл
		КоличествоИФОКФО = КоличествоИФОКФО + СтрокаОбъектовИФО.Строки.Количество();
	КонецЦикла;
	
	Возврат КоличествоИФОКФО * КоличествоЭтаповРасчетаПоКаждомуИФОКФО();

КонецФункции

Функция КоличествоЭтаповРасчетаПоКаждомуИФОКФО()
	Возврат 7;
КонецФункции

Функция ТекстПрогрессаТекущегоЭтапа(ТекстСообщения, НомерЭтапа, Параметры)

	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить("Этап %1 из %2. " + ТекстСообщения + " (%3)");
	ЧастиТекста.Добавить("КФО=%4");
	Если ЗначениеЗаполнено(Параметры.ИФО) Тогда
		ЧастиТекста.Добавить("ИФО=%5");
	КонецЕсли;
	
	Текст = СтрСоединить(ЧастиТекста, ", ");
	НомерТекущегоЭтапа = НомерЭтапа + (Параметры.НомерСочетанияИФОКФО - 1) * КоличествоЭтаповРасчетаПоКаждомуИФОКФО();
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
		НомерТекущегоЭтапа, Параметры.КоличествоЭтаповРасчета,
		Параметры.ВидУчета, Параметры.КФО, Параметры.ИФО);

КонецФункции

Функция ПараметрыЗаполненияТекстПрогресса()

	Результат = Новый Структура;
	Результат.Вставить("КоличествоЭтаповРасчета", 0);
	Результат.Вставить("НомерСочетанияИФОКФО", 0);
	Результат.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Результат.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	Результат.Вставить("ВидУчета", "");
	Возврат Результат;

КонецФункции

// Заполняет документ
// 
// Параметры:
// 	ДокументОбъект - ДокументОбъект.ЗакрытиеСчетовПроизводственныхЗатрат - 
// 	ВидУчета - Строка - "БУ" или "НУ"
Процедура ЗаполнитьЗакрытиеСчетовПроизводственныхЗатрат(ДокументОбъект, ВидУчета = "БУ") Экспорт

	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.ЗакрытиеСчетовПроизводственныхЗатрат") Тогда
		Возврат; // неверный тип документа
	КонецЕсли;
	ЗамерВремениЗаполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства,
		"ЗамерВремениЗаполнения");
	
	// Общие параметры учета затрат.
	ПараметрыУчетаЗатрат = ПараметрыУчетаЗатрат(
		ДокументОбъект.Дата, ДокументОбъект.Организация, ДокументОбъект.ИФО, ДокументОбъект.КФО, ВидУчета);
	
	Если ВидУчета = "НУ" Тогда
		
		// Расчет долей списания косвенных расходов, в т.ч. нормируемых.
		ДолиСписанияНормируемыхРасходов = НалоговыйУчет.РассчитатьДолиСписанияКосвенныхРасходов(
			ДокументОбъект.Дата, ДокументОбъект.Организация, ДокументОбъект);
		ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 1, "Рассчитать доли списания косвенных расходов",
			ВидУчета);
		
	КонецЕсли;
	
	// Распределение общих расходов со счетов 109.71, 109.81 на счет 109.61,
	// в налоговом учете - прямых расходов со счетов Н25.01, Н26.01 на счет Н20.01.
	РаспределитьОбщиеЗатраты(ДокументОбъект, ПараметрыУчетаЗатрат, ВидУчета);
	ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, ДокументОбъект.РаспределениеОбщихЗатрат.Количество(),
		"Распределить общие затраты", ВидУчета);
	
	Если ВидУчета = "НУ" Тогда
		
		// Списание косвенных расходов со счетов Н20.02, Н25.02, Н26.02 и Н44.
		СписатьКосвенныеРасходыНУ(ДокументОбъект, ДолиСписанияНормируемыхРасходов, ПараметрыУчетаЗатрат);
		ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, ДокументОбъект.СписаниеРасходовНУ.Количество(),
			"Списать косвенные расходы НУ", ВидУчета);
		
		// Списание прямых расходов со счета Н20.01, не учитываемых для целей налогообложения,
		// а также относящихся к видам деятельности с особым порядком налогообложения (ЕНВД).
		СписатьНеучитываемыеРасходыНУиЕНВД(ДокументОбъект, ПараметрыУчетаЗатрат);
		ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, ДокументОбъект.СписаниеРасходовНУ.Количество(),
			"Списать неучитываемые расходы НУ и ЕНВД", ВидУчета);
		
	КонецЕсли;
	
	// Расчет себестоимости производства и корректировка оборотов.
	ДлительныеОперации.СообщитьПрогресс(Неопределено, СтрШаблон(НСтр("ru = 'Расчет оборотов затрат (%1)'"), ВидУчета));
	ДанныеДляУравнений = СобратьДанныеДляУравнений(ПараметрыУчетаЗатрат, ДокументОбъект, ВидУчета);
	ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Собрать данные для уравнений", ВидУчета);
	
	ДанныеДляУравнений.ДеревоДляРасчетаТау.Колонки.Добавить("Тау", Новый ОписаниеТипов("Число"));
	
	ДанныеДляУравнений.ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДанныеДляУравнений.ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	ДанныеДляУравнений.ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДанныеДляУравнений.ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	ПараметрыЗаполненияПрогресса = ПараметрыЗаполненияТекстПрогресса();
	ПараметрыЗаполненияПрогресса.ВидУчета = ВидУчета;
	ПараметрыЗаполненияПрогресса.КоличествоЭтаповРасчета = КоличествоЭтаповРасчета(ДанныеДляУравнений.ДеревоОбъектовРасчета);
	
	Для Каждого СтрокаОбъектовИФО Из ДанныеДляУравнений.ДеревоОбъектовРасчета.Строки Цикл
		Для Каждого СтрокаОбъектов Из СтрокаОбъектовИФО.Строки Цикл
			
			ИФО = СтрокаОбъектовИФО.ИФО;
			КФО = СтрокаОбъектов.КФО;
			
			ПараметрыЗаполненияПрогресса.НомерСочетанияИФОКФО = ПараметрыЗаполненияПрогресса.НомерСочетанияИФОКФО + 1;
			ПараметрыЗаполненияПрогресса.ИФО = ИФО;
			ПараметрыЗаполненияПрогресса.КФО = КФО;
			
			ТекстПрогресса = ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Предварительный расчет'"), 1, ПараметрыЗаполненияПрогресса);
			ДлительныеОперации.СообщитьПрогресс(Неопределено, ТекстПрогресса);
			
			СтрокаОбороты109ПР          = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты109ПР,			ИФО, КФО);
			СтрокаОбороты109Косвенные   = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты109Косвенные,	ИФО, КФО);
			СтрокаОбороты105            = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты105, 			ИФО, КФО);
			СтрокаНачальныеОстатки      = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоНачальныеОстатки, 		ИФО, КФО);
			СтрокаКонечныеОстаткиБезКПС = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоКонечныеОстатки, 		ИФО, КФО);
			СтрокаКонечныеОстатки       = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоКонечныеОстаткиПоКПС,	ИФО, КФО);
			СтрокаДляРасчетаТэтта       = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоДляРасчетаТэтта,		ИФО, КФО);
			СтрокаДляРасчетаТау         = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоДляРасчетаТау, 		ИФО, КФО);
			
			Если СтрокаОбороты109ПР = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			РаспределитьСуммыНЗПпоКПС(СтрокаКонечныеОстатки, СтрокаКонечныеОстаткиБезКПС, ВидУчета);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Распределить суммы НЗП по КПС", ВидУчета);
			
			// Расчет коэффициентов распределения.
			РассчитатьКоэффициентыТау(
				СтрокаДляРасчетаТау, ДанныеДляУравнений.ДеревоДляРасчетаТауДоп);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Рассчитать коэффициенты Тау", ВидУчета);
			
			ТаблицаКоэффициентовТэтта = РассчитатьКоэффициентыТэтта(
				СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, ТаблицаКоэффициентовТэтта.Количество(),
				"Таблица коэффициентов Тэтта", ВидУчета);
			
			РассчитатьКоэффициентыАльфа(
				СтрокаОбъектов, СтрокаОбороты109Косвенные, ПараметрыУчетаЗатрат);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Рассчитать коэффициенты Альфа", ВидУчета);
			
			//@skip-check query-in-loop
			ТаблицаКоэффициентовГамма = РассчитатьКоэффициентыГамма(
				СтрокаОбороты105, СтрокаНачальныеОстатки, СтрокаОбъектов,
				ПараметрыУчетаЗатрат);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, ТаблицаКоэффициентовГамма.Количество(),
				"Таблица коэффициентов Гамма", ВидУчета);
			
			// Расчет матрицы корректируемых оборотов.
			ПараметрыФормированияСистемыУравнений = Новый Структура;
			ПараметрыФормированияСистемыУравнений.Вставить("ЗамерВремениЗаполнения",       ЗамерВремениЗаполнения);
			ПараметрыФормированияСистемыУравнений.Вставить("ДокументОбъект",               ДокументОбъект);
			ПараметрыФормированияСистемыУравнений.Вставить("ВидУчета",                     ВидУчета);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбъектов",               СтрокаОбъектов);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаКоэффициентовГамма",    ТаблицаКоэффициентовГамма);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаКоэффициентовТэтта",    ТаблицаКоэффициентовТэтта);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109ПР",           СтрокаОбороты109ПР);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109Косвенные",    СтрокаОбороты109Косвенные);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаНачальныеОстатки",       СтрокаНачальныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаКонечныеОстатки",        СтрокаКонечныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаВыпущеннойПродукции",   ДанныеДляУравнений.ТаблицаВыпущеннойПродукции);
			ПараметрыФормированияСистемыУравнений.Вставить("ВлияющиеНомГруппы",            ДанныеДляУравнений.ВлияющиеНомГруппы);
			ПараметрыФормированияСистемыУравнений.Вставить("ПараметрыУчетаЗатрат",         ПараметрыУчетаЗатрат);
			
			ПараметрыФормированияСистемыУравнений.Вставить("ТекстСообщенияФормированиеМатрицы",
				ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Расчет себестоимости'"), 2, ПараметрыЗаполненияПрогресса));
			ПараметрыФормированияСистемыУравнений.Вставить("ТекстСообщенияРешениеУравнения",
				ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Расчет себестоимости'"), 3, ПараметрыЗаполненияПрогресса));
			
			//@skip-check query-in-loop
			МатрицаОбъектов = СформироватьМатрицуСистемыУравнений(ПараметрыФормированияСистемыУравнений);
			РешитьСистемуЛинейныхУравнений(МатрицаОбъектов, ПараметрыФормированияСистемыУравнений);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, МатрицаОбъектов.Количество(),
				"Решить систему линейных уравнений", ВидУчета);
			ТекстПрогресса = ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Расчет себестоимостиРасчет себестоимости'"), 4, ПараметрыЗаполненияПрогресса);
			ДлительныеОперации.СообщитьПрогресс(Неопределено, ТекстПрогресса);
			РасчитатьФактическиеОбороты(МатрицаОбъектов, СтрокаКонечныеОстатки, ВидУчета);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, МатрицаОбъектов.Количество(),
				"Расчитать фактические обороты", ВидУчета);
			
			// Сторно плановой стоимости и расчет фактической стоимости выпуска продукции
			// (БУ: 105 - 109.6х, НУ: Н43 - Н20.01).
			ТекстПрогресса = ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Формирование проводок себестоимости'"), 5, ПараметрыЗаполненияПрогресса);
			ДлительныеОперации.СообщитьПрогресс(Неопределено, ТекстПрогресса);
			РассчитатьСебестоимостьПродукции(ДокументОбъект,
				МатрицаОбъектов, СтрокаОбороты109ПР, ТаблицаКоэффициентовТэтта, ПараметрыУчетаЗатрат);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения,
				ДокументОбъект.РасчетСебестоимостиПродукции.Количество(),
				"Рассчитать себестоимость продукции", ВидУчета);
			РассчитатьФактическуюСтоимостьПродукции(ДокументОбъект, МатрицаОбъектов, ТаблицаКоэффициентовТэтта);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения,
				ДокументОбъект.ФактическаяСтоимостьПродукции.Количество(),
				"Рассчитать фактическую стоимость продукции", ВидУчета);
			
			// Корректировка стоимости списания готовой продукции (БУ: ХХХ - 105, НУ: ХХХ - Н43).
			ТекстПрогресса = ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Формирование проводок корректировки стоимости списания'"), 6, ПараметрыЗаполненияПрогресса);
			ДлительныеОперации.СообщитьПрогресс(Неопределено, ТекстПрогресса);
			//@skip-check query-in-loop
			ТаблицаСписание109_105 = СкорректироватьСтоимостьСписанияПродукции(ДокументОбъект,
				СтрокаОбороты105, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0,
				"Скорректировать стоимость списания продукции", ВидУчета);
			
			// Корректировка распределения общих расходов в БУ (109.6х - 109.7х, 109.8х) и НУ (Н20.01 - Н25.01, Н26.01).
			// Корректировка списания общих расходов в БУ (401.хх - 109.7х, 109.8х) и НУ (Н90.хх - Н25.01, Н26.01).
			ТекстПрогресса = ТекстПрогрессаТекущегоЭтапа(НСтр("ru = 'Корректировка общих затрат'"), 7, ПараметрыЗаполненияПрогресса);
			ДлительныеОперации.СообщитьПрогресс(Неопределено, ТекстПрогресса);
			СкорректироватьРаспределениеИСписаниеОбщихЗатрат(ДокументОбъект,
				ТаблицаСписание109_105, СтрокаОбороты109Косвенные, ВидУчета, ПараметрыУчетаЗатрат);
			ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения,
				ДокументОбъект.КорректировкаРаспределенияЗатрат.Количество()
					+ ДокументОбъект.КорректировкаСписанияЗатрат.Количество(),
				"Скорректировать распределение и списание общих затрат", ВидУчета);
			
			Если ВидУчета = "НУ" Тогда
				
				// Корректировка списания косвенных расходов НУ (Н90.хх - Н20.02, Н25.02, Н26.02, Н44).
				СкорректироватьСписаниеКосвенныхРасходовНУ(ДокументОбъект, ИФО, КФО,
					ТаблицаСписание109_105, ПараметрыУчетаЗатрат);
				ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения,
					ДокументОбъект.СписаниеРасходовНУ.Количество(),
					"Скорректировать списание косвенных расходов НУ", ВидУчета);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	УдалитьСтрокиПродукцииБезЗатрат(ДокументОбъект);
	
КонецПроцедуры

Процедура УдалитьСтрокиПродукцииБезЗатрат(ДокументОбъект)

	Идентификаторы = Новый Соответствие;
	Для каждого СтрокаСтроимости Из ДокументОбъект.ФактическаяСтоимостьПродукции Цикл
		Идентификаторы.Вставить(СтрокаСтроимости.ИдентификаторСтроки, Истина);
	КонецЦикла;
	
	НулевыеСтроки = Новый Массив;
	Для каждого Строка Из ДокументОбъект.РасчетСебестоимостиПродукции Цикл
		Если Идентификаторы.Получить(Строка.ИдентификаторСтроки) = Неопределено Тогда
			НулевыеСтроки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого УдаляемаяСтрока Из НулевыеСтроки Цикл
	
		ДокументОбъект.РасчетСебестоимостиПродукции.Удалить(УдаляемаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

// Проверяет корректность остатков затрат
//
Функция ОстаткиЗатратКорректны(ОстатокЗатрат, ТекстОшибки="")
	
	Если ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
		
		Если ОстатокЗатрат.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения
		   И (ОстатокЗатрат.Сумма <> 0 ИЛИ ОстатокЗатрат.СуммаЕНВД <> 0) Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (не учитываемые в целях налогообложения).'");
			Если ОстатокЗатрат.Сумма <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с основной системой налогообложения: %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаЕНВД <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с особым порядком налогообложения (ЕНВД): %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетУчета,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.Сумма),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаЕНВД));
				
		КонецЕсли;
		
	ИначеЕсли ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
		
		Если ОстатокЗатрат.Сумма <> 0 ИЛИ ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (особый порядок налогообложения).'");
			Если ОстатокЗатрат.Сумма <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с основной системой налогообложения: %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов, не учитываемых для целей налогообложения прибыли: %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетУчета,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.Сумма),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаНеУчитываетсяНУ));
			
		КонецЕсли;
		
	ИначеЕсли ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
		
		Если ОстатокЗатрат.СуммаЕНВД <> 0 ИЛИ ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (распределяемые затраты).'");
			Если ОстатокЗатрат.СуммаЕНВД <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с особым порядком налогообложения (ЕНВД): %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов, не учитываемых для целей налогообложения прибыли: %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетУчета,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаЕНВД),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаНеУчитываетсяНУ));
			
		КонецЕсли;
		
	Иначе
		
		ТекстОшибки = ТекстОшибки + НСтр("ru='Для вида затрат %1 не установлен вид деятельности для целей налогового учета по налогу на прибыль.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОстатокЗатрат.ВидЗатрат);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Списывает косвенные расходы НУ
//
Процедура СписатьКосвенныеРасходыНУ(ДокументОбъект, ДолиСписанияНормируемыхРасходов, ПараметрыУчетаЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОстатков",  Новый Граница(ПараметрыУчетаЗатрат.КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаРасходов", БухгалтерскийУчет.СписокСчетов("Н20.02,Н25.02,Н26.02,Н44"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.КПС КАК КПС,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.Счет КАК СчетУчета,
	|	ВложенныйЗапрос.Субконто1 КАК Субконто1,
	|	ВложенныйЗапрос.Субконто2 КАК Субконто2,
	|	ВложенныйЗапрос.Субконто3 КАК Субконто3,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ВложенныйЗапрос.ВидЗатрат.Наименование КАК ВидЗатратНаименование,
	|	ВложенныйЗапрос.ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ВложенныйЗапрос.ВидЗатрат.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ВложенныйЗапрос.СуммаОстаток КАК Сумма,
	|	ВложенныйЗапрос.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ,
	|	ВложенныйЗапрос.СуммаЕНВДОстатокДт КАК СуммаЕНВД
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|		ЕПСБУОстатки.Подразделение КАК Подразделение,
	|		ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|		ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|		ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
	|			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
	|			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЗатрат)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|		КОНЕЦ КАК ВидЗатрат,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&ДатаОстатков,
	|				Счет В (&СчетаРасходов),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО) КАК ЕПСБУОстатки) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	СчетУчета,
	|	ВидЗатратНаименование";
	
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ПараметрыУчетаЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если НЕ ПараметрыУчетаЗатрат.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	КосвенныеРасходы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаКосвенных Из КосвенныеРасходы Цикл
		
		// Проверяем корректность остатков затрат
		ТекстОшибки = "";
		Отказ = НЕ ОстаткиЗатратКорректны(СтрокаКосвенных, ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
		КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		// Формируем таблицу списания затрат
		Если СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
			
			Если СтрокаКосвенных.Сумма <> 0
			 ИЛИ СтрокаКосвенных.СуммаНеУчитываетсяНУ <> 0
			 ИЛИ СтрокаКосвенных.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм расходов на счета расходов по обычным видам деятельности.
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных,
					"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
				
				Если СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы Тогда
					Коэффициент = ДокументОбъект.ДоляТранспортныхРасходов;
				ИначеЕсли ДолиСписанияНормируемыхРасходов[СтрокаКосвенных.ВидРасходовНУ] <> Неопределено Тогда
					Коэффициент = ДолиСписанияНормируемыхРасходов[СтрокаКосвенных.ВидРасходовНУ];
				Иначе
					Коэффициент = 1;
				КонецЕсли;
				
				НоваяСтрока.ОстатокСумма           = СтрокаКосвенных.Сумма;
				НоваяСтрока.ОстатокНеУчитываетсяНУ = СтрокаКосвенных.СуммаНеУчитываетсяНУ;
				НоваяСтрока.ОстатокЕНВД            = СтрокаКосвенных.СуммаЕНВД;
				НоваяСтрока.КоэффициентСписания    = Коэффициент;
				НоваяСтрока.СписатьСумма           = Коэффициент * СтрокаКосвенных.Сумма;
				НоваяСтрока.СписатьНеУчитываетсяНУ = Коэффициент * СтрокаКосвенных.СуммаНеУчитываетсяНУ;
				НоваяСтрока.СписатьЕНВД            = Коэффициент * СтрокаКосвенных.СуммаЕНВД;
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаКосвенных.СчетУчета, СтрокаКосвенных.ВидРасходовНУ);
				
			КонецЕсли;
			
		ИначеЕсли СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
			
			Если СтрокаКосвенных.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм расходов по ЕНВД на счета расходов по обычным видам деятельности.
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных,
					"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
				
				НоваяСтрока.ОстатокЕНВД         = СтрокаКосвенных.СуммаЕНВД;
				НоваяСтрока.КоэффициентСписания = 1;
				НоваяСтрока.СписатьЕНВД         = СтрокаКосвенных.СуммаЕНВД;
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаКосвенных.СчетУчета, СтрокаКосвенных.ВидРасходовНУ);
				
			КонецЕсли;
			
		ИначеЕсли СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
			
			Если СтрокаКосвенных.Сумма <> 0 Тогда
				
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных,
					"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
				
				НоваяСтрока.ОстатокСумма           = СтрокаКосвенных.Сумма;
				НоваяСтрока.КоэффициентСписания    = 1;
				НоваяСтрока.СписатьСумма           = СтрокаКосвенных.Сумма * (1 - ДокументОбъект.ДоляЕНВД - ДокументОбъект.ДоляРасходовНеУчитываетсяНУ);
				НоваяСтрока.СписатьНеУчитываетсяНУ = СтрокаКосвенных.Сумма * ДокументОбъект.ДоляРасходовНеУчитываетсяНУ;
				НоваяСтрока.СписатьЕНВД            = СтрокаКосвенных.Сумма * ДокументОбъект.ДоляЕНВД;
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаКосвенных.СчетУчета, СтрокаКосвенных.ВидРасходовНУ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Списывает расходы НУ, не учитываемые при налогообложении, а также относящиеся к ЕНВД
//
Процедура СписатьНеучитываемыеРасходыНУиЕНВД(ДокументОбъект, ПараметрыУчетаЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОстатков",  Новый Граница(ПараметрыУчетаЗатрат.КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаРасходов", БухгалтерскийУчет.СписокСчетов("Н20.01"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.КПС КАК КПС,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.Счет КАК СчетУчета,
	|	ВложенныйЗапрос.Субконто1 КАК Субконто1,
	|	ВложенныйЗапрос.Субконто2 КАК Субконто2,
	|	ВложенныйЗапрос.Субконто3 КАК Субконто3,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ВложенныйЗапрос.ВидЗатрат.Наименование КАК ВидЗатратНаименование,
	|	ВложенныйЗапрос.ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ВложенныйЗапрос.ВидЗатрат.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ВложенныйЗапрос.СуммаОстаток КАК Сумма,
	|	ВложенныйЗапрос.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ,
	|	ВложенныйЗапрос.СуммаЕНВДОстатокДт КАК СуммаЕНВД
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|		ЕПСБУОстатки.Подразделение КАК Подразделение,
	|		ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|		ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|		ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&ДатаОстатков,
	|				Счет В (&СчетаРасходов),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО) КАК ЕПСБУОстатки) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	СчетУчета,
	|	ВидЗатратНаименование";
	
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
	КонецЕсли;		
	
	Если ПараметрыУчетаЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если НЕ ПараметрыУчетаЗатрат.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ПрямыеРасходыПроизводства = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаПрямых Из ПрямыеРасходыПроизводства Цикл
		
		Если СтрокаПрямых.СуммаНеУчитываетсяНУ = 0 И СтрокаПрямых.СуммаЕНВД = 0
		   И СтрокаПрямых.Сумма <> 0
		   И СтрокаПрямых.ВидДеятельностиНУ <> Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты
		Тогда
			Продолжить; // Пропускаем расходы, которые не имеют отношения к ЕНВД и не учитываемым.
		КонецЕсли;
		
		// Проверяем корректность остатков затрат
		ТекстОшибки = "";
		Отказ = НЕ ОстаткиЗатратКорректны(СтрокаПрямых, ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
		КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		// Формируем таблицу списания затрат
		Если СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
			
			Если СтрокаПрямых.Сумма <> 0 Тогда
				// Эти расходы не списываем. Они будут участвовать в расчете себестоимости производства.
			КонецЕсли;
			
			Если СтрокаПрямых.СуммаНеУчитываетсяНУ <> 0 ИЛИ СтрокаПрямых.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм не учитываемых расходов.
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых,
					"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
				
				НоваяСтрока.ОстатокНеУчитываетсяНУ = СтрокаПрямых.СуммаНеУчитываетсяНУ;
				НоваяСтрока.ОстатокЕНВД            = СтрокаПрямых.СуммаЕНВД;
				НоваяСтрока.КоэффициентСписания    = 1;
				НоваяСтрока.СписатьНеУчитываетсяНУ = СтрокаПрямых.СуммаНеУчитываетсяНУ;
				НоваяСтрока.СписатьЕНВД            = СтрокаПрямых.СуммаЕНВД;
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаПрямых.СчетУчета, СтрокаПрямых.ВидРасходовНУ);
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
			
			Если СтрокаПрямых.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм расходов по ЕНВД на счета расходов по обычным видам деятельности.
				НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых,
					"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
				
				НоваяСтрока.ОстатокЕНВД         = СтрокаПрямых.СуммаЕНВД;
				НоваяСтрока.КоэффициентСписания = 1;
				НоваяСтрока.СписатьЕНВД         = СтрокаПрямых.СуммаЕНВД;
				
				НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаПрямых.СчетУчета, СтрокаПрямых.ВидРасходовНУ);
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
			
			Если СтрокаПрямых.Сумма <> 0 Тогда
				
				// 1. В части, относящейся к деятельности с основной системой налогообложения.
				Если (1 - ДокументОбъект.ДоляЕНВД - ДокументОбъект.ДоляРасходовНеУчитываетсяНУ) <> 0 Тогда
					// Эти расходы не списываем. Они будут участвовать в расчете себестоимости производства.
				КонецЕсли;
				
				// 2. В части, относящейся к деятельности с особым порядком налогообложения,
				// а также к уставной бюджетной деятельности, не направленной на получение дохода.
				Если ДокументОбъект.ДоляЕНВД <> 0 ИЛИ ДокументОбъект.ДоляРасходовНеУчитываетсяНУ <> 0 Тогда
					
					// Списание сумм ЕНВД и неучитываемых расходов на счета расходов по обычным видам деятельности.
					НоваяСтрока = ДокументОбъект.СписаниеРасходовНУ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых,
						"ИФО,КФО,КПС,Подразделение,СчетУчета,Субконто1,Субконто2,Субконто3");
					
					НоваяСтрока.ОстатокСумма           = СтрокаПрямых.Сумма;
					НоваяСтрока.КоэффициентСписания    = ДокументОбъект.ДоляЕНВД + ДокументОбъект.ДоляРасходовНеУчитываетсяНУ;
					НоваяСтрока.СписатьНеУчитываетсяНУ = СтрокаПрямых.Сумма * ДокументОбъект.ДоляРасходовНеУчитываетсяНУ;
					НоваяСтрока.СписатьЕНВД            = СтрокаПрямых.Сумма * ДокументОбъект.ДоляЕНВД;
					
					НоваяСтрока.СчетСписания = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
						СтрокаПрямых.СчетУчета, СтрокаПрямых.ВидРасходовНУ);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает таблицу КПС со строковым уникальным идентификатором каждого элемента КПС.
// Используется для формирования КлючаЗатрат в основном запросе.
// Возвращаемое значение:
// ТаблицаЗначений - таблица с колонками "КПС" типа "СправочникСсылка.КлассификационныеПризнакиСчетов"
//	и КлючКПС типа "Строка(36)"
Функция ТаблицаКлючейКПС()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлассификационныеПризнакиСчетов.Ссылка
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов";
	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКлючей.Колонки.Добавить("КлючКПС", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(36 ,ДопустимаяДлина.Фиксированная)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовКлюч = ТаблицаКлючей.Добавить();
		НовКлюч.КПС = Выборка.Ссылка;
		НовКлюч.КлючКПС = Строка(Выборка.Ссылка.УникальныйИдентификатор());
	КонецЦикла;
	
	Возврат ТаблицаКлючей;

КонецФункции // ТаблицаКлючейКПС()

// Формирует данные для уравнений.
//
Функция СобратьДанныеДляУравнений(ПараметрыУчетаЗатрат, ДокументОбъект, ВидУчета = "БУ")
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаКлючейКПС", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКлючей.КПС КАК КПС,
	|	ТаблицаКлючей.КлючКПС
	|ПОМЕСТИТЬ ТаблицаКлючей
	|ИЗ
	|	&ТаблицаКлючей КАК ТаблицаКлючей
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КПС";
	Запрос.УстановитьПараметр("ТаблицаКлючей", ТаблицаКлючейКПС());
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаСчетов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	""105"" КАК ОткудаКуда,
	|	ИСТИНА КАК Счет105,
	|	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение,
	|	ЛОЖЬ КАК ЕстьНаправлениеДеятельности
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУ.Ссылка В(&СчетаУчетаМЗ)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ
	|				ИСТИНА КАК ЕстьСубконтоНоменклатура
	|			ИЗ
	|				ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|			ГДЕ
	|				ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|				И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""Прочее"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеСебестоимость,
	|	&ЕстьНаправлениеДеятельностиСебестоимость
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетСебестоимость
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""ОПЗ"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеНакладныеРасходы,
	|	&ЕстьНаправлениеДеятельностиНакладныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетНакладныеРасходы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""ОХЗ"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеОбщехозяйственныеРасходы,
	|	&ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетОбщехозяйственныеРасходы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Счет105";
	Если ВидУчета = "БУ" Тогда
		Запрос.УстановитьПараметр("СчетаУчетаМЗ", БухгалтерскийУчет.СписокСчетов("105.00"));
	Иначе // НУ
		Запрос.УстановитьПараметр("СчетаУчетаМЗ", БухгалтерскийУчет.СписокСчетов("Н10,Н41.01,Н43"));
	КонецЕсли;
	
	НомераТаблиц.Вставить("РаспределениеОбщихЗатрат", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.Сумма
	|ПОМЕСТИТЬ РаспределениеОбщихЗатрат
	|ИЗ
	|	&РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат";
	Запрос.УстановитьПараметр("РаспределениеОбщихЗатрат", ДокументОбъект.РаспределениеОбщихЗатрат.Выгрузить());
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаВсеОборотыПервая", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаВсеОбороты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УничтожитьВсеОборотыПервая", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЖурналПроводок.ИФО КАК ИФО,
	|	ЖурналПроводок.КФО,
	|	ЖурналПроводок.СчетДт КАК СчетДт,
	|	ЖурналПроводок.КПСДт,
	|	ЖурналПроводок.КЭКДт,
	|	ЖурналПроводок.ВидСубконтоДт1,
	|	ЖурналПроводок.СубконтоДт1,
	|	ЖурналПроводок.ВидСубконтоДт2,
	|	ЖурналПроводок.СубконтоДт2,
	|	ЖурналПроводок.ВидСубконтоДт3,
	|	ЖурналПроводок.СубконтоДт3,
	|	ЕСТЬNULL(ЖурналПроводок.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеДт,
	|	ЖурналПроводок.СчетКт КАК СчетКт,
	|	ЖурналПроводок.КПСКт,
	|	ЖурналПроводок.КЭККт,
	|	ЖурналПроводок.ВидСубконтоКт1,
	|	ЖурналПроводок.СубконтоКт1,
	|	ЖурналПроводок.ВидСубконтоКт2,
	|	ЖурналПроводок.СубконтоКт2,
	|	ЖурналПроводок.ВидСубконтоКт3,
	|	ЖурналПроводок.СубконтоКт3,
	|	ЕСТЬNULL(ЖурналПроводок.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеКт,
	|	ЖурналПроводок.Сумма,
	|	ЖурналПроводок.КоличествоДт,
	|	ЖурналПроводок.КоличествоКт,
	|	ЖурналПроводок.Регистратор
	|ПОМЕСТИТЬ ВсеОборотыПервая
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Активность
	|				И Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Регистратор <> &ДокументСсылка
	|				И (СчетДт В
	|						(ВЫБРАТЬ
	|							ТаблицаСчетов.Ссылка
	|						ИЗ
	|							ТаблицаСчетов КАК ТаблицаСчетов)
	|					ИЛИ СчетКт В
	|						(ВЫБРАТЬ
	|							ТаблицаСчетов.Ссылка
	|						ИЗ
	|							ТаблицаСчетов КАК ТаблицаСчетов)),
	|			,
	|			) КАК ЖурналПроводок
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат),
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	ЕПСБУВидыСубконтоДт3.ВидСубконто,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконтоДт3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|			ТОГДА РаспределениеОбщихЗатрат.КорНаправлениеДеятельности
	|	КОНЕЦ,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат),
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
