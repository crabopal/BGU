	|ПО
	|	ОбъектРасчета.ИндексОбъектаРасчета";
КонецФункции

// Формирует матрицу системы линейных уравнений
//
Функция СформироватьМатрицуСистемыУравнений(Параметры)
	ВидУчета = Параметры.ВидУчета;
	ЗамерВремениЗаполнения = Параметры.ЗамерВремениЗаполнения;
	ДлительныеОперации.СообщитьПрогресс(1, "Подготовка матрицы для расчета");
	Запрос = Новый Запрос;

	// Подготовка параметров
	
	ОбъектыРасчета = ТаблицаОбъектовДляФормированияМатрицыСистемыУравнений(Параметры);
	Запрос.УстановитьПараметр("ОбъектыРасчета", ОбъектыРасчета);
	КоэффициентыГамма = ТаблицаКоэффициентовГаммаДляФормированияМатрицыСистемыУравнений(Параметры);
	Запрос.УстановитьПараметр("КоэффициентыГамма", КоэффициентыГамма);
	Запрос.УстановитьПараметр("КоэффициентыТэтта", Параметры.ТаблицаКоэффициентовТэтта);
	Запрос.УстановитьПараметр("ТаблицаКонечныеОстатки",
		ТаблицаКонечныеОстаткиДляФормированияМатрицыСистемыУравнений(Параметры));
	Запрос.УстановитьПараметр("ТаблицаОстатков105",
		ТаблицаОстатковДляФормированияМатрицыСистемыУравнений(Параметры, "105"));
	Запрос.УстановитьПараметр("ТаблицаОстатков109",
		ТаблицаОстатковДляФормированияМатрицыСистемыУравнений(Параметры, "109"));
	ВлияющиеНомГруппы = Новый Массив;
	Для Каждого КлючИЗначение Из Параметры.ВлияющиеНомГруппы Цикл
		ВлияющиеНомГруппы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Запрос.УстановитьПараметр("ВлияющиеНомГруппы", ВлияющиеНомГруппы);
	
	Запрос.Текст = ТекстЗапросаДляФормированияМатрицыСистемыУравнений();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоЗапросов = РезультатЗапроса.ВГраница();
	
	// Коэффициенты по объектам
	КоэффициентыПоОбъектам = РезультатЗапроса[КоличествоЗапросов - 1].Выгрузить();
	КоэффициентыПоОбъектам.Колонки.Добавить("Коэффициент", Новый ОписаниеТипов("Число"));
	КоэффициентыГамма.Индексы.Добавить("Номенклатура,Счет,КПС,ИндексКолонки");
	ОтборГамма = Новый Структура("Номенклатура,Счет,КПС,ИндексКолонки");
	Для Каждого СтрокаКоэффицента Из КоэффициентыПоОбъектам Цикл
		ЗаполнитьЗначенияСвойств(ОтборГамма, СтрокаКоэффицента);
		ОтборГамма.ИндексКолонки = СтрокаКоэффицента.ИндексОбъектаРасчета;
		СтрокиГамма = КоэффициентыГамма.НайтиСтроки(ОтборГамма);
		Если СтрокиГамма.Количество() <> 0 Тогда
			СтрокаКоэффицента.Коэффициент = - СтрокаКоэффицента.Тэтта * СтрокиГамма[0].Гамма;
		КонецЕсли;
	КонецЦикла;
	КоэффициентыПоОбъектам.Свернуть("ИндексОбъектаРасчета,ИндексКолонки", "Коэффициент");
	КоэффициентыПоОбъектам.Колонки.ИндексКолонки.Имя = "ИндексКолонкиРасчета";
	КоэффициентыПоОбъектам.Индексы.Добавить("ИндексОбъектаРасчета,ИндексКолонкиРасчета");
	
	// Начальные остатки готовой продукции по объектам расчета
	НачальныеОстатки105ПоОбъектамРасчета = РезультатЗапроса[КоличествоЗапросов - 2].Выгрузить();
	НачальныеОстатки105ПоОбъектамРасчета.Колонки.Добавить("НОогп", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаНачОстатковГП Из НачальныеОстатки105ПоОбъектамРасчета Цикл
		ЗаполнитьЗначенияСвойств(ОтборГамма, СтрокаНачОстатковГП);
		ОтборГамма.ИндексКолонки = СтрокаНачОстатковГП.ИндексОбъектаРасчета;
		СтрокиГамма = КоэффициентыГамма.НайтиСтроки(ОтборГамма);
		Если СтрокиГамма.Количество() <> 0 Тогда
			СтрокаНачОстатковГП.НОогп = СтрокаНачОстатковГП.Сумма * СтрокиГамма[0].Гамма;
		КонецЕсли;
	КонецЦикла;
	НачальныеОстатки105ПоОбъектамРасчета.Свернуть("ИндексОбъектаРасчета,ИндексКолонкиРасчета", "НОогп");
	НачальныеОстатки105ПоОбъектамРасчета.Индексы.Добавить("ИндексОбъектаРасчета,ИндексКолонкиРасчета");
	
	// Заполнение матрицы объектов
	ВыборкаОбъект = РезультатЗапроса[КоличествоЗапросов].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Выполнение запроса для матрицы системы уравнений",
		ВидУчета);
		
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
	МатрицаОбъектов = Новый ТаблицаЗначений;
	МатрицаОбъектов.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	МатрицаОбъектов.Колонки.Добавить("НоменклатурнаяГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	МатрицаОбъектов.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	МатрицаОбъектов.Колонки.Добавить("ВидЗатрат", Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	МатрицаОбъектов.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	МатрицаОбъектов.Колонки.Добавить("КлючЗатрат", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	МатрицаОбъектов.Колонки.Добавить("НаправлениеДеятельности",
		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	МатрицаОбъектов.Колонки.Добавить("ВидДеятельностиНУ",
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("Сумма", ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("АльфаОПЗ", ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("АльфаОХЗ", ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("q", ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("X", ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("ЗначенияСтроки", Новый ОписаниеТипов("Соответствие"));
	
	КоличествоОбъектов = Параметры.СтрокаОбъектов.Строки.Количество();
	МаксИндекс = КоличествоОбъектов - 1;

	// Массив будет содержать номера строк, используемых в колонке с таким же индексом
	МассивИндексовКолонок = Новый Массив(КоличествоОбъектов);
	Для Инд = 0 По МаксИндекс Цикл
		МассивИндексовКолонок[Инд] = Новый Массив;
	КонецЦикла;

	// Добавим строки матрицы.
	ИндексНовойСтроки = 0;
	Для Каждого СтрокаДетальная Из Параметры.СтрокаОбъектов.Строки Цикл
		ЗаполнитьЗначенияСвойств(МатрицаОбъектов.Добавить(), СтрокаДетальная);
		ИндексНовойСтроки = ИндексНовойСтроки + 1;
	КонецЦикла;
	
	ОтборКоэффициент = Новый Структура("ИндексОбъектаРасчета,ИндексКолонкиРасчета");
	Пока ВыборкаОбъект.Следующий() Цикл
		Индекс = ВыборкаОбъект.ИндексОбъектаРасчета;
		СтрокаОбъекта = МатрицаОбъектов[ВыборкаОбъект.ИндексОбъектаРасчета];
		
		Если Индекс % 100 = 0 Тогда
			НомерОбъекта = Индекс + 1;
			Процент = Окр(НомерОбъекта / КоличествоОбъектов * 100, 2);
			ДлительныеОперации.СообщитьПрогресс(Процент, Параметры.ТекстСообщенияФормированиеМатрицы);
		КонецЕсли;
		
		НОогп = 0;
		Выборка = ВыборкаОбъект.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			ЗначенияСтроки = СтрокаОбъекта.ЗначенияСтроки;
			п = Выборка.ИндексКолонкиРасчета;
			
			Если Параметры.ВидУчета = "НУ" И СтрокаОбъекта.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
				КоэффициентРаспределения =
					1 - Параметры.ДокументОбъект.ДоляЕНВД - Параметры.ДокументОбъект.ДоляРасходовНеУчитываетсяНУ;
			Иначе
				КоэффициентРаспределения = 1;
			КонецЕсли;
			
			Коэффициент = Выборка.Коэффициент;
			ЗаполнитьЗначенияСвойств(ОтборКоэффициент, Выборка);
			СтрокиКоэффициента = КоэффициентыПоОбъектам.НайтиСтроки(ОтборКоэффициент);
			Если СтрокиКоэффициента.Количество() > 0 Тогда
				Коэффициент = СтрокиКоэффициента[0].Коэффициент;
			КонецЕсли;
			
			СтрокиОстатковГП105 = НачальныеОстатки105ПоОбъектамРасчета.НайтиСтроки(ОтборКоэффициент);
			Для Каждого СтрокаОстатков Из СтрокиОстатковГП105 Цикл
				НОогп = НОогп + СтрокаОстатков.НОогп;
			КонецЦикла;
			Если п = Выборка.ИндексОбъектаРасчета Тогда
				ЗначенияСтроки.Вставить(п, 1 + КоэффициентРаспределения * Коэффициент);
				Если МассивИндексовКолонок[п] = Неопределено Тогда
					МассивИндексовКолонок[п] = Новый Массив;
					МассивИндексовКолонок[п].Добавить(Индекс);
				ИначеЕсли МассивИндексовКолонок[п].Найти(Индекс) = Неопределено Тогда
					МассивИндексовКолонок[п].Добавить(Индекс);
				КонецЕсли;
			Иначе
				ЗначениеТекущейСтроки = КоэффициентРаспределения * Коэффициент;
				Если ЗначениеТекущейСтроки <> 0 Тогда
					ЗначенияСтроки.Вставить(п, ЗначениеТекущейСтроки);
					Если МассивИндексовКолонок[п] = Неопределено Тогда
						МассивИндексовКолонок[п] = Новый Массив;
						МассивИндексовКолонок[п].Добавить(Индекс);
					ИначеЕсли МассивИндексовКолонок[п].Найти(Индекс) = Неопределено Тогда
						МассивИндексовКолонок[п].Добавить(Индекс);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		НоменклатурнаяГруппа    = СтрокаОбъекта.НоменклатурнаяГруппа;
		КлючЗатрат              = СтрокаОбъекта.КлючЗатрат;
		НаправлениеДеятельности = СтрокаОбъекта.НаправлениеДеятельности;
		Подразделение           = СтрокаОбъекта.Подразделение;
		АльфаОПЗ                = СтрокаОбъекта.АльфаОПЗ;
		АльфаОХЗ                = СтрокаОбъекта.АльфаОХЗ;

		// Вычисление свободного члена
		
		Опз = 0; // прямые затраты
		Если Параметры.СтрокаОбороты109ПР <> Неопределено Тогда
			СтрокаПоступления = Параметры.СтрокаОбороты109ПР.Строки.Найти("Поступление", "Направление", Ложь);
			Если СтрокаПоступления <> Неопределено Тогда
				Опз = Опз + РассчитатьПрямыеЗатраты(СтрокаПоступления, "Прочее",
					НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
				Опз = Опз + РассчитатьПрямыеЗатраты(СтрокаПоступления, "105",
					НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			КонецЕсли;
		КонецЕсли;
	
		// Рассчитаем некорректируемые обороты.
		Оопз = 0; // общепроизводственные затраты
		Оохз = 0; // общехозяйственные затраты
		Если Параметры.СтрокаОбороты109Косвенные <> Неопределено Тогда
			СтрокаПоступления = Параметры.СтрокаОбороты109Косвенные.Строки.Найти("Поступление", "Направление", Ложь);
			Если СтрокаПоступления <> Неопределено Тогда
				
				Оопз = Оопз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОПЗ", "Прочее",
					КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
				Оопз = Оопз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОПЗ", "105",
					КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
				
				Оохз = Оохз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОХЗ", "Прочее",
					КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
				Оохз = Оохз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОХЗ", "105",
					КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
				
			КонецЕсли;
		КонецЕсли;
		
		НОонп = ВыборкаОбъект.НОонп;
		КОонп = ВыборкаОбъект.КОонп;

		СтрокаОбъекта["q"] = НОонп
			+ КоэффициентРаспределения * (Опз + АльфаОПЗ * Оопз + АльфаОХЗ * Оохз + НОогп - КОонп);

	КонецЦикла;

	// Сохраним полученный массив для использования при решении уравнений
	Параметры.Вставить("МассивИндексовКолонок", МассивИндексовКолонок);
	
	ЗаписатьЗамерВремениВыполненияШага(ЗамерВремениЗаполнения, 0, "Составление матрицы системы уравнений",
		ВидУчета);
	
	Возврат МатрицаОбъектов;

КонецФункции

Функция РассчитатьПрямыеЗатраты(ИсходнаяСтрока, ТипЗатрат, НоменклатурнаяГруппа, КлючЗатрат, Знач НаправлениеДеятельности, Знач Подразделение, Параметры)
	
	ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость;
	ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость;
	НаправлениеДеятельности     = ?(ЕстьНаправлениеДеятельности, НаправлениеДеятельности, Справочники.НаправленияДеятельности.ПустаяСсылка());
	Подразделение               = ?(ЕстьПодразделение,           Подразделение,           Справочники.Подразделения.ПустаяСсылка());
	
	Отбор = Новый Структура("ОткудаКуда, НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности",
							ТипЗатрат, НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности);
	ДетальныеСтроки = ИсходнаяСтрока.Строки.НайтиСтроки(Отбор, Истина);
	
	Результат = 0;
	Для Каждого СтрокаДетальная из ДетальныеСтроки Цикл
		
		Если СтрокаДетальная.Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗатрат = "105" И Параметры.ТаблицаВыпущеннойПродукции.Найти(СтрокаДетальная.КорСубконто1, "Номенклатура") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РасчитатьКосвенныеЗатраты(ИсходнаяСтрока, ВидКЗ, ТипЗатрат, КлючЗатрат, Знач НаправлениеДеятельности, Знач Подразделение, Параметры)
	
	Если ВидКЗ = "ОПЗ" Тогда
		ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
		ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы;
	Иначе // ВидКЗ = "ОХЗ"
		ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
		ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	КонецЕсли;
	НаправлениеДеятельности = ?(ЕстьНаправлениеДеятельности, НаправлениеДеятельности, Справочники.НаправленияДеятельности.ПустаяСсылка());
	Подразделение           = ?(ЕстьПодразделение,           Подразделение,           Справочники.Подразделения.ПустаяСсылка());
	
	Отбор = Новый Структура("ОПЗ_ОХЗ, ОткудаКуда, КлючЗатрат, Подразделение, НаправлениеДеятельности",
							ВидКЗ, ТипЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности);
	ДетальныеСтроки = ИсходнаяСтрока.Строки.НайтиСтроки(Отбор, Истина);
	
	Результат = 0;
	Для каждого СтрокаДетальная из ДетальныеСтроки Цикл
		
		Если СтрокаДетальная.Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗатрат = "105" И Параметры.ТаблицаВыпущеннойПродукции.Найти(СтрокаДетальная.КорСубконто1, "Номенклатура") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Решение системы линейных уравнений
//
Процедура РешитьСистемуЛинейныхУравнений(МатрицаОбъектов, Параметры)
	
	МассивИндексовКолонок = Параметры.МассивИндексовКолонок;
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	КоличествоОбъектов = МатрицаОбъектов.Количество();
	МаксИндекс = КоличествоОбъектов - 1;
	
	// Прямой ход
	Для п = 0 по МаксИндекс Цикл
		Если п % 100 = 0 Тогда
			НомерОбъекта = п + 1;
			Процент = Окр(НомерОбъекта / КоличествоОбъектов * 50, 2);
			ДлительныеОперации.СообщитьПрогресс(Процент, Параметры.ТекстСообщенияРешениеУравнения);
		КонецЕсли;
		УстановитьГлавныйЭлементПоКолонке(МатрицаОбъектов, п, МаксИндекс, МассивИндексовКолонок);
		Делитель = ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[п]["ЗначенияСтроки"].Получить(п));
		СтрокиКолонки = Новый СписокЗначений;
		СтрокиКолонки.ЗагрузитьЗначения(МассивИндексовКолонок[п]);
		СтрокиКолонки.СортироватьПоЗначению();
		Для Каждого ТекИндексСтроки ИЗ СтрокиКолонки Цикл
			Если ТекИндексСтроки.Значение <= п Тогда
				Продолжить;
			КонецЕсли;
			р = ТекИндексСтроки.Значение;
			
			Множитель = (- ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[р]["ЗначенияСтроки"].Получить(п))) / Делитель;
			Для Каждого ЗначенияКорректируемойСтроки Из МатрицаОбъектов[р].ЗначенияСтроки Цикл
				Если ЗначенияКорректируемойСтроки.Ключ < п Тогда
					Продолжить;
				КонецЕсли;
				т = ЗначенияКорректируемойСтроки.Ключ;
				СохраненноеЗначение = ЗначенияКорректируемойСтроки.Значение;
				НовоеЗначение = СохраненноеЗначение
					+ ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[п]["ЗначенияСтроки"].Получить(т)) * Множитель;
				Если НовоеЗначение <> СохраненноеЗначение Тогда
					МатрицаОбъектов[р]["ЗначенияСтроки"].Вставить(т, НовоеЗначение);
				КонецЕсли;
				// Актуализируем МассивИндексовКолонок, чтобы в нем были актуальные индексы строк.
				Если НовоеЗначение = 0 Тогда
					Если МассивИндексовКолонок[т].Найти(р) <> Неопределено Тогда
						МассивИндексовКолонок[т].Удалить(МассивИндексовКолонок[т].Найти(р));
					КонецЕсли;
				Иначе
					Если МассивИндексовКолонок[т].Найти(р) = Неопределено Тогда
						МассивИндексовКолонок[т].Добавить(р);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			МатрицаОбъектов[р]["q"] = МатрицаОбъектов[р]["q"] +  МатрицаОбъектов[п]["q"] * Множитель;
		КонецЦикла;
	КонецЦикла;
	
	// Обратный ход
	п = МаксИндекс;
	Пока п >= 0 Цикл
		Если п % 100 = 0 Тогда
			НомерОбъекта = п + 1;
			Процент = 100 - Окр(НомерОбъекта / КоличествоОбъектов * 50, 2);
			ДлительныеОперации.СообщитьПрогресс(Процент, Параметры.ТекстСообщенияРешениеУравнения);
		КонецЕсли;
		СтрокиКолонки = Новый СписокЗначений;
		СтрокиКолонки.ЗагрузитьЗначения(МассивИндексовКолонок[п]);
		СтрокиКолонки.СортироватьПоЗначению();
		
		Результат = МатрицаОбъектов[п]["q"];
		Для Каждого ТекЗначениеСтроки Из МатрицаОбъектов[п].ЗначенияСтроки Цикл
			Если ТекЗначениеСтроки.Ключ <= п Тогда
				Продолжить;
			КонецЕсли;
			р = ТекЗначениеСтроки.Ключ;
			СохраненноеЗначение = ТекЗначениеСтроки.Значение;
			Если СохраненноеЗначение <> 0 Тогда
				Результат = Результат - СохраненноеЗначение * МатрицаОбъектов[р]["X"];
			КонецЕсли;
		КонецЦикла;
		СохраненноеЗначение = ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[п]["ЗначенияСтроки"].Получить(п));
		МатрицаОбъектов[п]["X"] = ?(СохраненноеЗначение = 0, 0,Результат / СохраненноеЗначение);
		п = п - 1;
	КонецЦикла;
	
	Для п = 0 по МаксИндекс Цикл
		МатрицаОбъектов[п]["X"] = Окр(МатрицаОбъектов[п]["X"], 2);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьГлавныйЭлементПоКолонке(МатрицаОбъектов, п, МаксИндекс, МассивИндексовКолонок)
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	СписокСтрок = Новый СписокЗначений;
	СписокСтрок.ЗагрузитьЗначения(МассивИндексовКолонок[п]);
	СписокСтрок.СортироватьПоЗначению();
	
	ТекущееЗначение = МодульЧисла(ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[п]["ЗначенияСтроки"].Получить(п)));
	Для Каждого ИндексСтроки Из СписокСтрок Цикл
		р = ИндексСтроки.Значение;
		Если р < (п + 1) Тогда
			Продолжить;
		КонецЕсли;
		Если МодульЧисла(ОписаниеТипаЧисло.ПривестиЗначение(МатрицаОбъектов[р]["ЗначенияСтроки"].Получить(п))) > ТекущееЗначение Тогда 
			МатрицаОбъектов.Сдвинуть(р, (п - р));
			
			Для каждого СтрокиПоКолонке Из МассивИндексовКолонок Цикл
				
				Для Инд = 0 По СтрокиПоКолонке.ВГраница() Цикл
				
					Если СтрокиПоКолонке[Инд] > р Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрокиПоКолонке[Инд] = р Тогда
						СтрокиПоКолонке[Инд] = п;
					ИначеЕсли СтрокиПоКолонке[Инд] >= п Тогда
						СтрокиПоКолонке[Инд] = СтрокиПоКолонке[Инд] + 1;
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция МодульЧисла(Число) Экспорт

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

Процедура РасчитатьФактическиеОбороты(МатрицаОбъектов, СтрокаКонечныеОстатки, ВидУчета)

	Если СтрокаКонечныеОстатки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидУчета = "НУ" Тогда
		// В НУ не ведется учет затрат по КЭК, поэтому нет смысла использовать комплексное поле КлючЗатрат.
		СтрокаРеквизитов = "ВидЗатрат, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа";
	Иначе
		// Бух. учет.
		СтрокаРеквизитов = "КлючЗатрат, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа";
	КонецЕсли;
	СтруктураПоиска = Новый Структура(СтрокаРеквизитов);
	
	Для каждого СтрокаОбъекта из МатрицаОбъектов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОбъекта, СтрокаРеквизитов);
		МассивСтрок = СтрокаКонечныеОстатки.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Вычитаем остаток НЗП.
		СтрокаОбъекта.X = СтрокаОбъекта.X - МассивСтрок[0].Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИменаКолонокСебестоимостиПродукции()
	Возврат "НоменклатурнаяГруппа,ПодразделениеСебестоимости,НаправлениеДеятельности,СчетГотовойПродукции,КПСГотовойПродукции,Номенклатура";
КонецФункции

// Расчет плановой и фактической стоимости выпуска готовой продукции.
//
Процедура РассчитатьСебестоимостьПродукции(ДокументОбъект, МатрицаОбъектов, СтрокаОбороты109ПР, ТаблицаКоэффициентовТэтта, ПараметрыУчетаЗатрат)
	
	СтрокаСписания105_109ПР = СтрокаОбороты109ПР.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания105_109ПР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОткудаКуда105 = СтрокаСписания105_109ПР.Строки.Найти("105", "ОткудаКуда", Ложь);
	Если СтрокаОткудаКуда105 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИФО = СтрокаОбороты109ПР.ИФО;
	КФО = СтрокаОбороты109ПР.КФО;
	
	Для Каждого СтрокаНоменклатурнойГруппы Из СтрокаОткудаКуда105.Строки Цикл
		Для Каждого СтрокаВидЗатрат Из СтрокаНоменклатурнойГруппы.Строки Цикл
			Для Каждого СтрокаПодразделения Из СтрокаВидЗатрат.Строки Цикл
				Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделения.Строки Цикл
					Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
						
						НоваяСтрока = ДокументОбъект.РасчетСебестоимостиПродукции.Добавить();
						НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
						НоваяСтрока.ИФО = ИФО;
						НоваяСтрока.КФО = КФО;
						
						НоваяСтрока.СчетГотовойПродукции          = СтрокаДетальная.КорСчет;
						НоваяСтрока.КПСГотовойПродукции           = СтрокаДетальная.КорКПС;
						НоваяСтрока.КЭКГотовойПродукции           = СтрокаДетальная.КорКЭК;
						НоваяСтрока.ПодразделениеГотовойПродукции = СтрокаДетальная.КорПодразделение;
						НоваяСтрока.Номенклатура                  = СтрокаДетальная.КорСубконто1;
						
						НоваяСтрока.СчетСебестоимости    = СтрокаДетальная.Счет;
						НоваяСтрока.КПССебестоимости     = СтрокаДетальная.КПС;
						НоваяСтрока.НоменклатурнаяГруппа = СтрокаДетальная.НоменклатурнаяГруппа;
						Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
							НоваяСтрока.НаправлениеДеятельности = СтрокаДетальная.НаправлениеДеятельности;
						КонецЕсли;
						Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
							НоваяСтрока.ПодразделениеСебестоимости = СтрокаДетальная.Подразделение;
						КонецЕсли;
						
						НоваяСтрока.Количество        = СтрокаДетальная.КоличествоКорОборотКт;
						НоваяСтрока.ПлановаяСтоимость = СтрокаДетальная.СуммаОборотКт;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	СписокКолонок = ИменаКолонокСебестоимостиПродукции();
	ДокументОбъект.РасчетСебестоимостиПродукции.Сортировать(СписокКолонок);
	
КонецПроцедуры

Процедура РассчитатьФактическуюСтоимостьПродукции(ДокументОбъект, МатрицаОбъектов, ТаблицаКоэффициентовТэтта)

	Если ДокументОбъект.РасчетСебестоимостиПродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	СписокКолонок = ИменаКолонокСебестоимостиПродукции();
	
	ТаблицаРаспределения = ДокументОбъект.РасчетСебестоимостиПродукции.Выгрузить( ,СписокКолонок);
	ТаблицаРаспределения.Колонки.Добавить("Тэтта", Новый ОписаниеТипов("Число"));
	ТаблицаРаспределения.Свернуть(СписокКолонок + ", Тэтта");
	
	СписокКолонокИтогов = "НоменклатурнаяГруппа,ПодразделениеСебестоимости,НаправлениеДеятельности";
	ТаблицаРаспределения.Индексы.Добавить(СписокКолонокИтогов);
	ТаблицаИтогов = ТаблицаРаспределения.Скопировать( ,СписокКолонокИтогов);
	ТаблицаИтогов.Свернуть(СписокКолонокИтогов);
	Для Каждого СтрокаИтогов из ТаблицаИтогов Цикл // по номенклатурным группам, подразделениям и направлениям деятельности
		
		МассивСтрокРешений = МатрицаОбъектов.НайтиСтроки(
			Новый Структура("НоменклатурнаяГруппа, Подразделение, НаправлениеДеятельности",
				СтрокаИтогов.НоменклатурнаяГруппа, СтрокаИтогов.ПодразделениеСебестоимости, СтрокаИтогов.НаправлениеДеятельности));
		Если МассивСтрокРешений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокРаспределения = ТаблицаРаспределения.НайтиСтроки(
			Новый Структура(СписокКолонокИтогов,
				СтрокаИтогов.НоменклатурнаяГруппа, СтрокаИтогов.ПодразделениеСебестоимости, СтрокаИтогов.НаправлениеДеятельности));
		
		Для Каждого СтрокаРешения Из МассивСтрокРешений Цикл
			
			МассивКоэффициентовТэтта = Новый Массив;
			Для Каждого Строка Из МассивСтрокРаспределения Цикл
				
				Строка.Тэтта = ОпределитьКоэффициентТэтта(ТаблицаКоэффициентовТэтта,
					Строка.ПодразделениеСебестоимости, Строка.НаправлениеДеятельности, Строка.НоменклатурнаяГруппа,
					Строка.Номенклатура, Строка.СчетГотовойПродукции, Строка.КПСГотовойПродукции);
					
				МассивКоэффициентовТэтта.Добавить(Строка.Тэтта);
				
			КонецЦикла;
			
			// Распределим сумму оборотов пропорционально коэффициентам Тэтта.
			МассивОборотовПоНоменклатуре = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				СтрокаРешения.X, МассивКоэффициентовТэтта);
			Если МассивОборотовПоНоменклатуре = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Индекс = 0 По МассивОборотовПоНоменклатуре.Количество() - 1 Цикл
				
				СуммаОборотовПоНоменклатуре = МассивОборотовПоНоменклатуре[Индекс];
				СтрокаРаспределения         = МассивСтрокРаспределения[Индекс];
				
				Отбор = Новый Структура(СписокКолонок);
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаРаспределения);
				
				МассивСтрокКорректировок = ДокументОбъект.РасчетСебестоимостиПродукции.НайтиСтроки(Отбор);
				МассивКоэффициентовПоКоличеству = Новый Массив;
				Для Каждого СтрокаКорректировки Из МассивСтрокКорректировок Цикл
					МассивКоэффициентовПоКоличеству.Добавить(СтрокаКорректировки.Количество);
				КонецЦикла;
				
				// Распределим сумму корректировки пропорционально количеству.
				МассивОборотов = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СуммаОборотовПоНоменклатуре, МассивКоэффициентовПоКоличеству);
					
				Если МассивОборотов = Неопределено Тогда
					Продолжить;
				КонецЕсли;
					
				// Заполним информацию о фактических затратах на изготовление.
				Для ИндексОборотов = 0 По МассивОборотов.Количество() - 1 Цикл
					
					СтрокаКорректировки = МассивСтрокКорректировок[ИндексОборотов];
					СуммаОборота        = МассивОборотов[ИндексОборотов];
					
					Если СуммаОборота = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ДокументОбъект.ФактическаяСтоимостьПродукции.Добавить();
					НоваяСтрока.ИдентификаторСтроки  = СтрокаКорректировки.ИдентификаторСтроки;
					НоваяСтрока.ВидЗатрат            = СтрокаРешения.ВидЗатрат;
					НоваяСтрока.КЭК                  = СтрокаРешения.КЭК;
					НоваяСтрока.ФактическаяСтоимость = СуммаОборота;
					НоваяСтрока.КПС                  = СтрокаРешения.КПС;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Корректировка стоимости списания готовой продукции (БУ: ХХХ - 105, НУ: ХХХ - Н43).
//
Функция СкорректироватьСтоимостьСписанияПродукции(ДокументОбъект, СтрокаОбороты105, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат)

	ТаблицаСписание109_105 = Новый ТаблицаЗначений;
	ТаблицаСписание109_105.Колонки.Добавить("ОПЗ_ОХЗ",                 Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
	ТаблицаСписание109_105.Колонки.Добавить("Счет",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаСписание109_105.Колонки.Добавить("КПС",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаСписание109_105.Колонки.Добавить("Подразделение",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписание109_105.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписание109_105.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписание109_105.Колонки.Добавить("ВидЗатрат",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ТаблицаСписание109_105.Колонки.Добавить("КЭКЗатрат",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаСписание109_105.Колонки.Добавить("КлючЗатрат",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(48)));
	ТаблицаСписание109_105.Колонки.Добавить("Сумма",                   Новый ОписаниеТипов("Число"));
	
	Если СтрокаОбороты105 = Неопределено Тогда
		Возврат ТаблицаСписание109_105;
	КонецЕсли;
	
	СтрокаСписания = СтрокаОбороты105.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания = Неопределено Тогда
		Возврат ТаблицаСписание109_105;
	КонецЕсли;
	
	ИФО = СтрокаОбороты105.ИФО;
	КФО = СтрокаОбороты105.КФО;
	
	ДеревоПроводокХХХ_105        = СформироватьДеревоПроводокХХХ_105(СтрокаСписания);
	ТаблицаОстатковИОборотов105  = ПолучитьТаблицуОстатковИОборотов105(ДокументОбъект, ИФО, КФО, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат);
	
	// Сначала нужно проверить и добавить корректировки перемещения между подразделениями и только потом
	// проверять корректировки списания.
	ДанныеКорректировки = Новый Структура;
	ДанныеКорректировки.Вставить("ДокументОбъект", ДокументОбъект);
	ДанныеКорректировки.Вставить("ПараметрыУчетаЗатрат", ПараметрыУчетаЗатрат);
	ДанныеКорректировки.Вставить("ТаблицаСписание109_105", ТаблицаСписание109_105);
	ДанныеКорректировки.Вставить("СтрокаОбороты105", СтрокаОбороты105);
	ДанныеКорректировки.Вставить("ДеревоПроводокХХХ_105", ДеревоПроводокХХХ_105);
	ДанныеКорректировки.Вставить("ТаблицаОстатковИОборотов105", ТаблицаОстатковИОборотов105);
	ПропущенныеПеремещения = ТаблицаОстатковИОборотов105.СкопироватьКолонки("Счет, КПС, Подразделение, Номенклатура");
	ДанныеКорректировки.Вставить("ПропущенныеПеремещения", ПропущенныеПеремещения);
	ДанныеКорректировки.Вставить("ОбрабатываемоеПеремещение");
	ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукции(ДанныеКорректировки, Истина);
	ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукцииПропущенныеПеремещения(ДанныеКорректировки);
	ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукции(ДанныеКорректировки, Ложь);
	
	ТаблицаСписание109_105.Свернуть("ОПЗ_ОХЗ, Счет, КПС, НоменклатурнаяГруппа, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности", "Сумма");
	ТаблицаСписание109_105.Сортировать("ОПЗ_ОХЗ, Счет, КПС, НоменклатурнаяГруппа, ВидЗатрат, КЭКЗатрат, Подразделение, НаправлениеДеятельности");
	
	Возврат ТаблицаСписание109_105;
	
КонецФункции

Процедура ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукцииПропущенныеПеремещения(ДанныеКорректировки)
	КоличествоПропущенных = ДанныеКорректировки.ПропущенныеПеремещения.Количество();
	Если КоличествоПропущенных = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Пока КоличествоПропущенных > 0 Цикл
	
		Для Каждого Перемещение Из ДанныеКорректировки.ПропущенныеПеремещения Цикл
			ДанныеКорректировки.Вставить("ОбрабатываемоеПеремещение", Новый Структура);
			ДанныеКорректировки.ОбрабатываемоеПеремещение.Вставить("Счет", Перемещение.Счет);
			ДанныеКорректировки.ОбрабатываемоеПеремещение.Вставить("КПС", Перемещение.КПС);
			ДанныеКорректировки.ОбрабатываемоеПеремещение.Вставить("Подразделение", Перемещение.Подразделение);
			ДанныеКорректировки.ОбрабатываемоеПеремещение.Вставить("Номенклатура", Перемещение.Номенклатура);
			
			ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукции(ДанныеКорректировки, Истина);
		КонецЦикла;
		
		КоличествоПослеОбработки = ДанныеКорректировки.ПропущенныеПеремещения.Количество();
		Если КоличествоПропущенных = КоличествоПослеОбработки Тогда
			// Не обработано ни одной строки. Обработка закончена
			Прервать;
		КонецЕсли;
		
		КоличествоПропущенных = КоличествоПослеОбработки;
	
	КонецЦикла;
	
	ДанныеКорректировки.Вставить("ОбрабатываемоеПеремещение", Неопределено);
	
КонецПроцедуры

Процедура ДобавитьСтрокиКорректировкиСтоимостиСписанияПродукции(ДанныеКорректировки, УчитыватьОбороты105)

	ДокументОбъект = ДанныеКорректировки.ДокументОбъект;
	ПараметрыУчетаЗатрат = ДанныеКорректировки.ПараметрыУчетаЗатрат;
	ТаблицаСписание109_105 = ДанныеКорректировки.ТаблицаСписание109_105;
	СтрокаОбороты105 = ДанныеКорректировки.СтрокаОбороты105;
	ДеревоПроводокХХХ_105 = ДанныеКорректировки.ДеревоПроводокХХХ_105;
	ТаблицаОстатковИОборотов105 = ДанныеКорректировки.ТаблицаОстатковИОборотов105;
	ПропущенныеПеремещения = ДанныеКорректировки.ПропущенныеПеремещения;
	ОбрабатываемоеПеремещение = ДанныеКорректировки.ОбрабатываемоеПеремещение;
	
	ИФО = СтрокаОбороты105.ИФО;
	КФО = СтрокаОбороты105.КФО;

	Для каждого СтрокаСчета из ДеревоПроводокХХХ_105.Строки Цикл
		Для каждого СтрокаКПС из СтрокаСчета.Строки Цикл
			Для Каждого СтрокаПодразделения Из СтрокаКПС.Строки Цикл
				Для каждого СтрокаНоменклатуры из СтрокаПодразделения.Строки Цикл
					
					ВсегоКоличество = СтрокаНоменклатуры.Количество;
					Если ВсегоКоличество = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("Счет", СтрокаНоменклатуры.СчетКт);
					СтруктураПоиска.Вставить("КПС", СтрокаНоменклатуры.КПСКт);
					СтруктураПоиска.Вставить("Подразделение", СтрокаНоменклатуры.ПодразделениеКт);
					СтруктураПоиска.Вставить("Номенклатура", СтрокаНоменклатуры.СубконтоКт1);
					// Если это обработка пропущенных перемещений, то обрабатывается только 1 перемещение
					ОбрабатываетсяПропущенноеПеремещение = Ложь;
					Если ОбрабатываемоеПеремещение <> Неопределено Тогда
						Если ОбрабатываемоеПеремещение.Счет <> СтруктураПоиска.Счет
							Или ОбрабатываемоеПеремещение.КПС <> СтруктураПоиска.КПС
							Или ОбрабатываемоеПеремещение.Подразделение <> СтруктураПоиска.Подразделение
							Или ОбрабатываемоеПеремещение.Номенклатура <> СтруктураПоиска.Номенклатура Тогда
							Продолжить;
						КонецЕсли;
						ОбрабатываетсяПропущенноеПеремещение = Истина;
					КонецЕсли;

					МассивСтрок = ТаблицаОстатковИОборотов105.НайтиСтроки(СтруктураПоиска);
					Если МассивСтрок.Количество() = 0 Тогда
						Если УчитыватьОбороты105 И ОбрабатываемоеПеремещение = Неопределено Тогда
							ЗаполнитьЗначенияСвойств(ПропущенныеПеремещения.Добавить(), СтруктураПоиска);
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					
					Если ОбрабатываетсяПропущенноеПеремещение Тогда
						// Отметить обработку пропущенного перемещения
						СтрокиПеремещения = ПропущенныеПеремещения.НайтиСтроки(СтруктураПоиска);
						Для каждого Перемещение Из СтрокиПеремещения Цикл
							ПропущенныеПеремещения.Удалить(Перемещение);
						КонецЦикла;
					КонецЕсли;
					
					КоличествоНаВходе = МассивСтрок[0].Количество;
					СуммаНаВходе      = МассивСтрок[0].Сумма;
					ЦенаЕдиницы = ?(КоличествоНаВходе = 0, 0, СуммаНаВходе / КоличествоНаВходе);
					
					ВсегоКоличествоСписано = 0;
					ВсегоСуммаСписано      = 0;
					Для каждого СтрокаДетальная из СтрокаНоменклатуры.Строки Цикл
						
						ЭтоСчетУчетаМатериальныхЗапасов = СтрНайти("105;Н10;Н41;Н43", СтрокаДетальная.СчетДтКод3) <> 0;
						
						Если (УчитыватьОбороты105 И Не ЭтоСчетУчетаМатериальныхЗапасов)
							Или (НЕ УчитыватьОбороты105 И ЭтоСчетУчетаМатериальныхЗапасов) Тогда
							Продолжить;
						КонецЕсли;
						
						КоличествоСписания     = СтрокаДетальная.Количество;
						СуммаСписанияСтарая    = СтрокаДетальная.Сумма;
						ВсегоКоличествоСписано = ВсегоКоличествоСписано + КоличествоСписания;
						Если ВсегоКоличествоСписано >= КоличествоНаВходе Тогда
							СуммаСписания = СуммаНаВходе - ВсегоСуммаСписано - СуммаСписанияСтарая;
						Иначе
							СуммаСписания = Окр(КоличествоСписания * ЦенаЕдиницы, 2) - СуммаСписанияСтарая;
							ВсегоСуммаСписано = ВсегоСуммаСписано + Окр(КоличествоСписания * ЦенаЕдиницы, 2);
						КонецЕсли;
						
						СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетальная.СчетДт);
						
						НоваяСтрока = ДокументОбъект.КорректировкаСписанияПродукции.Добавить();
						НоваяСтрока.ИФО = ИФО;
						НоваяСтрока.КФО = КФО;
						
						НоваяСтрока.КорСчет = СтрокаДетальная.СчетДт;
						НоваяСтрока.КорКПС  = СтрокаДетальная.КПСДт;
						НоваяСтрока.КорКЭК  = СтрокаДетальная.КЭКДт;
						Для Индекс = 1 По СвойстваСчетаДт.КоличествоСубконто Цикл
							НоваяСтрока["КорСубконто" + Индекс] = СтрокаДетальная["СубконтоДт" + Индекс];
						КонецЦикла; 
						НоваяСтрока.КорПодразделение = СтрокаДетальная.ПодразделениеДт;
						
						НоваяСтрока.СчетГотовойПродукции          = СтрокаДетальная.СчетКт;
						НоваяСтрока.КПСГотовойПродукции           = СтрокаДетальная.КПСКт;
						НоваяСтрока.КЭКГотовойПродукции           = СтрокаДетальная.КЭККт;
						НоваяСтрока.ПодразделениеГотовойПродукции = СтрокаДетальная.ПодразделениеКт;
						НоваяСтрока.Номенклатура                  = СтрокаДетальная.СубконтоКт1;
						
						НоваяСтрока.Сумма = СуммаСписания;
						
						// Запомним списания Дт 109 Кт 105 в таблице для дальнейшей корректировки.
						ЕстьКорректировка = Ложь;
						Если СтрокаДетальная.СчетДт = ПараметрыУчетаЗатрат.СчетНакладныеРасходы Тогда
							ОПЗ_ОХЗ = "ОПЗ";
							ЕстьКорректировка = Истина;
						ИначеЕсли СтрокаДетальная.СчетДт = ПараметрыУчетаЗатрат.СчетОбщехозяйственныеРасходы Тогда
							ОПЗ_ОХЗ = "ОХЗ";
							ЕстьКорректировка = Истина;
						ИначеЕсли СтрокаДетальная.СчетДт = БухгалтерскийУчет.СчетПоКоду("Н20.02") Тогда
							ОПЗ_ОХЗ = "КосвенныеРасходыПроизводства";
							ЕстьКорректировка = Истина;
						ИначеЕсли СтрокаДетальная.СчетДт = БухгалтерскийУчет.СчетПоКоду("Н25.02") Тогда
							ОПЗ_ОХЗ = "КосвенныеОПЗ";
							ЕстьКорректировка = Истина;
						ИначеЕсли СтрокаДетальная.СчетДт = БухгалтерскийУчет.СчетПоКоду("Н26.02") Тогда
							ОПЗ_ОХЗ = "КосвенныеОХЗ";
							ЕстьКорректировка = Истина;
						КонецЕсли;
						Если ЕстьКорректировка = Истина Тогда
							НоваяСтрока = ТаблицаСписание109_105.Добавить();
							НоваяСтрока.ОПЗ_ОХЗ                 = ОПЗ_ОХЗ;
							НоваяСтрока.Счет                    = СтрокаДетальная.СчетДт;
							НоваяСтрока.КПС                     = СтрокаДетальная.КПСДт;
							НоваяСтрока.КЭКЗатрат               = СтрокаДетальная.КЭКДт;
							НоваяСтрока.КлючЗатрат              = СтрокаДетальная.КлючЗатрат;
							НоваяСтрока.Подразделение           = СтрокаДетальная.ПодразделениеДт;
							Для Сч = 1 По 3 Цикл
								Если СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
									НоваяСтрока.НоменклатурнаяГруппа    = СтрокаДетальная["СубконтоДт"+Сч];
								ИначеЕсли СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
									НоваяСтрока.ВидЗатрат               = СтрокаДетальная["СубконтоДт"+Сч];
								ИначеЕсли СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности Тогда
									НоваяСтрока.НаправлениеДеятельности = СтрокаДетальная["СубконтоДт"+Сч];
								КонецЕсли;
							КонецЦикла;
							НоваяСтрока.Сумма = СуммаСписания;
						КонецЕсли;
					
						// Учтем в таблице остатков и оборотов 105.
						Если ЭтоСчетУчетаМатериальныхЗапасов Тогда
							
							Отбор = Новый Структура;
							Отбор.Вставить("Счет", СтрокаДетальная.СчетДт);
							Отбор.Вставить("КПС", СтрокаДетальная.КПСДт);
							Отбор.Вставить("Подразделение", СтрокаДетальная.ПодразделениеДт);
							Отбор.Вставить("Номенклатура", СтрокаДетальная.СубконтоДт1);
							НайденныеСтроки = ТаблицаОстатковИОборотов105.НайтиСтроки(Отбор);
							Если НайденныеСтроки.Количество() = 0 Тогда
								НоваяСтрока = ТаблицаОстатковИОборотов105.Добавить();
								НоваяСтрока.Счет         = СтрокаДетальная.СчетДт;
								НоваяСтрока.КПС          = СтрокаДетальная.КПСДт;
								НоваяСтрока.Подразделение= СтрокаДетальная.ПодразделениеДт;
								НоваяСтрока.Номенклатура = СтрокаДетальная.СубконтоДт1;
								НоваяСтрока.Количество   = КоличествоСписания;
								НоваяСтрока.Сумма        = СуммаСписанияСтарая + СуммаСписания;
							Иначе	
								НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество + КоличествоСписания;
								НайденныеСтроки[0].Сумма      = НайденныеСтроки[0].Сумма + СуммаСписанияСтарая + СуммаСписания;
							КонецЕсли;
							
						КонецЕсли;
					
					КонецЦикла;
					
					Если ОбрабатываетсяПропущенноеПеремещение Тогда
						Возврат;
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция СформироватьДеревоПроводокХХХ_105(СтрокаСписания)

	ТипыСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаПроводокХХХ_105 = Новый ТаблицаЗначений;
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СчетДт",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СчетДтКод3",      Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
