#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);

	Если Не УчетПроизводства.ПроверитьВозможностьЗакрытияСчетовЗатратПоУчетнойПолитике(УчетнаяПолитика, Дата, Отказ) Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если УчетнаяПолитика.РаспределятьОПЗ ИЛИ УчетнаяПолитика.РаспределятьОХЗ Тогда
		
		РеквизитыКорСчета = Новый Структура("Счет, КПС, Подразделение",
			"КорСчет", "КорКПС", "КорПодразделение");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыКорСчета,
			ЭтотОбъект, "РаспределениеОбщихЗатрат", Отказ);
		
	КонецЕсли;
	
	ПроверитьРеквизитыНУ = НЕ ЗначениеЗаполнено(КФО) И УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		ИЛИ ЗначениеЗаполнено(КФО) И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	Если ПроверитьРеквизитыНУ Тогда
		
		РеквизитыСчетаУчета = Новый Структура("Счет, Подразделение, Субконто1, Субконто2, Субконто3",
			"СчетУчета", "Подразделение", "Субконто1", "Субконто2", "Субконто3");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчета,
			ЭтотОбъект, "СписаниеРасходовНУ", Отказ);
		
	КонецЕсли;
	
	РеквизитыСчетаСебестоимости = Новый Структура("Счет, КПС, Подразделение",
		"СчетСебестоимости", "КПССебестоимости", "ПодразделениеСебестоимости");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаСебестоимости,
		ЭтотОбъект, "РасчетСебестоимостиПродукции", Отказ);
	
	РеквизитыСчетаГотовойПродукции = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"СчетГотовойПродукции", "КПСГотовойПродукции", "КЭКГотовойПродукции", "ПодразделениеГотовойПродукции");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаГотовойПродукции,
		ЭтотОбъект, "РасчетСебестоимостиПродукции", Отказ);
	
	РеквизитыСчетаГотовойПродукции = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"СчетГотовойПродукции", "КПСГотовойПродукции", "КЭКГотовойПродукции", "ПодразделениеГотовойПродукции");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаГотовойПродукции,
		ЭтотОбъект, "КорректировкаСписанияПродукции", Отказ);
	
	РеквизитыКорСчета = Новый Структура("Счет, КПС, КЭК, Подразделение, Субконто1, Субконто2, Субконто3",
		"КорСчет", "КорКПС", "КорКЭК", "КорПодразделение", "КорСубконто1", "КорСубконто2", "КорСубконто3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыКорСчета,
		ЭтотОбъект, "КорректировкаСписанияПродукции", Отказ);
	
	РеквизитыСчетаУчета = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"СчетУчета", "КПС", "КЭК", "Подразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчета,
		ЭтотОбъект, "КорректировкаРаспределенияЗатрат", Отказ);
	
	РеквизитыКорСчета = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"КорСчет", "КорКПС", "КорКЭК", "КорПодразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыКорСчета,
		ЭтотОбъект, "КорректировкаРаспределенияЗатрат", Отказ);
	
	РеквизитыСчетаУчета = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"СчетУчета", "КПС", "КЭК", "Подразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчета,
		ЭтотОбъект, "КорректировкаСписанияЗатрат", Отказ);
	
	РеквизитыКорСчета = Новый Структура("Счет, КПС, КЭК, Подразделение, Субконто1, Субконто2, Субконто3",
		"КорСчет", "КорКПС", "КорКЭК", "КорПодразделение", "КорСубконто1", "КорСубконто2", "КорСубконто3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыКорСчета,
		ЭтотОбъект, "КорректировкаСписанияЗатрат", Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Движения по регистрам
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетРаспределенияОбщихЗатрат");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить("РаспределениеОбщихЗатрат");
	ТабличныеЧасти.Добавить("СписаниеРасходовНУ");
	ТабличныеЧасти.Добавить("РасчетСебестоимостиПродукции");
	ТабличныеЧасти.Добавить("КорректировкаСписанияПродукции");
	ТабличныеЧасти.Добавить("КорректировкаРаспределенияЗатрат");
	ТабличныеЧасти.Добавить("КорректировкаСписанияЗатрат");
	
	// Если ИФО и/или КФО указаны в шапке, проставим их в табличных частях.
	Для Каждого ТабЧасть Из ТабличныеЧасти Цикл
		Для Каждого СтрокаТаблицы Из ЭтотОбъект[ТабЧасть] Цикл
			
			Если ЗначениеЗаполнено(ИФО) Тогда
				СтрокаТаблицы.ИФО = ИФО;
			КонецЕсли;
			Если ЗначениеЗаполнено(КФО) Тогда
				СтрокаТаблицы.КФО = КФО;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	Если РаспределениеОбщихЗатрат.Количество() > 0 Тогда
		РаспределениеОбщихЗатрат.Очистить();
	КонецЕсли;
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата);
	
	ЗамерВремениЗаполнения = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
		"ЗаполнениеДокументаЗакрытиеСчетовПроизводственныхЗатрат");
	Если ЗначениеЗаполнено(ЗамерВремениЗаполнения) Тогда
		ДополнительныеСвойства.Вставить("ЗамерВремениЗаполнения", ЗамерВремениЗаполнения);
	КонецЕсли;
	
	// Бухгалтерский учет
	ВыполнитьЗакрытиеСчетовБУ = ОтражатьВБухгалтерскомУчете
		ИЛИ НЕ ПлательщикНалогаНаПрибыль;
	Если ВыполнитьЗакрытиеСчетовБУ Тогда
		
		Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ЗаполнитьЗакрытиеСчетовПроизводственныхЗатрат(ЭтотОбъект, "БУ");
		
	КонецЕсли;
	
	// Налоговый учет
	Если ЗначениеЗаполнено(КФО) Тогда
		ВыполнитьЗакрытиеСчетовНУ = ОтражатьВНалоговомУчете
			И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	Иначе
		ВыполнитьЗакрытиеСчетовНУ = ОтражатьВНалоговомУчете
			И ПлательщикНалогаНаПрибыль;
	КонецЕсли;
	Если ВыполнитьЗакрытиеСчетовНУ Тогда
		
		Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ЗаполнитьЗакрытиеСчетовПроизводственныхЗатрат(ЭтотОбъект, "НУ");
		
	КонецЕсли;
	
	УдалитьСтрокиПродукцииБезЗатрат();
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ЗамерВремениЗаполнения,
		РасчетСебестоимостиПродукции.Количество());
	
КонецПроцедуры

Процедура УдалитьСтрокиПродукцииБезЗатрат()

	Идентификаторы = Новый Соответствие;
	Для каждого СтрокаСтроимости Из ФактическаяСтоимостьПродукции Цикл
		Идентификаторы.Вставить(СтрокаСтроимости.ИдентификаторСтроки, Истина);
	КонецЦикла;
	
	НулевыеСтроки = Новый Массив;
	Для каждого Строка Из РасчетСебестоимостиПродукции Цикл
		Если Идентификаторы.Получить(Строка.ИдентификаторСтроки) = Неопределено Тогда
			НулевыеСтроки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого УдаляемаяСтрока Из НулевыеСтроки Цикл
	
		РасчетСебестоимостиПродукции.Удалить(УдаляемаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
