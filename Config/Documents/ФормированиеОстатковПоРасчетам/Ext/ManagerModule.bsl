#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ОчиститьДвиженияВТЧ(ОбъектСсылка, ПометкаУдаления = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗакрытиеГодаТехнологическоеГрупповоеДокументы.ДокСсылка КАК ДокСсылка
	|ИЗ
	|	Документ.ФормированиеОстатковПоРасчетам.СписокДокументов КАК ЗакрытиеГодаТехнологическоеГрупповоеДокументы
	|ГДЕ
	|	ЗакрытиеГодаТехнологическоеГрупповоеДокументы.Ссылка = &Ссылка
	|	И ЗакрытиеГодаТехнологическоеГрупповоеДокументы.ДокСсылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Ссылка",ОбъектСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ДокСсылка.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = ПометкаУдаления;
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросПоОборотнымКЭК(ДокументОбъект) Экспорт
	
	КЭК000 = БухгалтерскийУчетПовтИсп.КЭК0();
    	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВсеСчета", 		БухгалтерскийУчет.СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ()));
	Запрос.УстановитьПараметр("Период", 		Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(ДокументОбъект.ФинансовыйГод), 8), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",	ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("КЭК000",			КЭК000);
		
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.КОСГУДт КАК КОСГУДт,
	|	ЕПСБУ.КОСГУКт КАК КОСГУКт,
	|	ПОДСТРОКА(ЕПСБУ.КОСГУКт.Код, 3, 1) КАК КлючКИСЕ,
	|	ЕПСБУ.Вид КАК Вид,
	|	ЕПСБУ.БезДетализацииКОСГУ КАК БезДетализацииКОСГУ,
	|	ЕПСБУВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	|	ЕПСБУВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	|	ЕПСБУВидыСубконто3.ВидСубконто КАК ВидСубконто3
	|ПОМЕСТИТЬ ВсеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто1.Ссылка
	|			И (ЕПСБУВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто2.Ссылка
	|			И (ЕПСБУВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто3.Ссылка
	|			И (ЕПСБУВидыСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&ВсеСчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК НовыйКОСГУ,
	|	ПОДСТРОКА(КОСГУ.Код, 3, 1) КАК КлючКОСГУ
	|ПОМЕСТИТЬ КОСГУОстатки
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код В (""000"", ""001"", ""002"", ""003"", ""004"", ""005"", ""006"", ""007"", ""008"", ""009"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт КАК КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0) <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт, 0) <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт,
	|	ВЫБОР
	|		КОГДА ВсеСчета.БезДетализацииКОСГУ
	|			ТОГДА &КЭК000
	|		ИНАЧЕ ЕСТЬNULL(КОСГУОстатки.НовыйКОСГУ, &КЭК000)
	|	КОНЕЦ КАК НовыйКОСГУ
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВсеСчета.Ссылка
	|				ИЗ
	|					ВсеСчета),
	|			,
	|			Организация = &Организация
	|				И НЕ КЭК = &КЭК000) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВсеСчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ КОСГУОстатки КАК КОСГУОстатки
	|		ПО (ВЫБОР
	|				КОГДА НЕ ВсеСчета.КлючКИСЕ = ""0""
	|					ТОГДА ВсеСчета.КлючКИСЕ
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Контрагенты
	|						И НЕ ПОДСТРОКА(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты).ТипКонтрагента.Код, 3, 1) = ""0""
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Контрагенты
	|						И НЕ ПОДСТРОКА(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты).ТипКонтрагента.Код, 3, 1) = ""0""
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Контрагенты
	|						И НЕ ПОДСТРОКА(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Контрагенты).ТипКонтрагента.Код, 3, 1) = ""0""
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				ИНАЧЕ ПОДСТРОКА(ЖурналПроводокЕПСБУОстатки.КЭК.Код, 3, 1)
	|			КОНЕЦ = КОСГУОстатки.КлючКОСГУ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт КАК КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0) <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт, 0) <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт,
	|	ВЫБОР
	|		КОГДА ВсеСчета.БезДетализацииКОСГУ
	|			ТОГДА &КЭК000
	|		ИНАЧЕ ЕСТЬNULL(КОСГУОстатки.НовыйКОСГУ, &КЭК000)
	|	КОНЕЦ КАК НовыйКОСГУ
	|ПОМЕСТИТЬ Остатки000
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВсеСчета.Ссылка
	|				ИЗ
	|					ВсеСчета),
	|			,
	|			Организация = &Организация
	|				И КЭК = &КЭК000) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВсеСчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ КОСГУОстатки КАК КОСГУОстатки
	|		ПО (ВЫБОР
	|				КОГДА НЕ ВсеСчета.КлючКИСЕ = ""0""
	|					ТОГДА ВсеСчета.КлючКИСЕ
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Контрагенты).ТипКонтрагента.Код
	|				ИНАЧЕ ""0""
	|			КОНЕЦ = КОСГУОстатки.КлючКОСГУ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Счет.Код КАК СчетКод,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.НовыйКОСГУ КАК НовыйКОСГУ,
	|	Остатки.Валюта КАК Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА -Остатки.СуммаОстатокКт
	|			ИНАЧЕ Остатки.СуммаОстатокДт
	|		КОНЕЦ) КАК СуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА -Остатки.СуммаОстатокДт
	|			ИНАЧЕ Остатки.СуммаОстатокКт
	|		КОНЕЦ) КАК СуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокДт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокКт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА -Остатки.КоличествоОстатокКт
	|			ИНАЧЕ Остатки.КоличествоОстатокДт
	|		КОНЕЦ) КАК КоличествоОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА -Остатки.КоличествоОстатокДт
	|			ИНАЧЕ Остатки.КоличествоОстатокКт
	|		КОНЕЦ) КАК КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
