
#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаКлиенте
Перем МинимальноеКоличествоПроводокВДокументе;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ФинансовыйГод = ?(ЗначениеЗаполнено(Объект.Дата), НачалоГода(Объект.Дата) - 1 , НачалоГода(ТекущаяДатаСеанса()) - 1);
		Если Объект.ФинансовыйГод < Дата(2020, 12, 31, 23, 59, 59) Тогда
			Объект.ФинансовыйГод = Дата(2020, 12, 31, 23, 59, 59);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ФинансовыйГод.Видимость = Объект.ИзменениеТипаУчреждения;
	Элементы.ТекстФинансовыйГод.Видимость = НЕ Объект.ИзменениеТипаУчреждения;
	
	ОбновитьВидимуюТаблицу();
	
	НастроитьФорму();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстФинансовыйГод = Год(Объект.ФинансовыйГод);
	ОграничитьКоличествоПроводокВДокументе = Объект.МаксимальноеКоличествоПроводокВДокументе <> 0;
	УправлениеВидимостьюЭлементов();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьВидимуюТаблицу();
	
	НастроитьФорму();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТекстФинансовыйГодПриИзменении(Элемент)
	
	Если ТекстФинансовыйГод < 2000 Тогда
		ТекстФинансовыйГод = 2000;
	КонецЕсли;
	
	Объект.ФинансовыйГод = Дата(ТекстФинансовыйГод, 12, 31, 23, 59, 59);
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьКоличествоПроводокВДокументеПриИзменении(Элемент)
	Объект.МаксимальноеКоличествоПроводокВДокументе = ?(ОграничитьКоличествоПроводокВДокументе,МинимальноеКоличествоПроводокВДокументе,0);
	УправлениеВидимостьюЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура МаксимальноеКоличествоСтрокВДокументеПриИзменении(Элемент)
	Если Объект.МаксимальноеКоличествоПроводокВДокументе > 0 И Объект.МаксимальноеКоличествоПроводокВДокументе < МинимальноеКоличествоПроводокВДокументе Тогда
		Объект.МаксимальноеКоличествоПроводокВДокументе = МинимальноеКоличествоПроводокВДокументе;
	КонецЕсли;
	ОграничитьКоличествоПроводокВДокументе = Объект.МаксимальноеКоличествоПроводокВДокументе <> 0;
	УправлениеВидимостьюЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеТипаУчрежденияПриИзменении(Элемент)
	Элементы.ФинансовыйГод.Видимость = Объект.ИзменениеТипаУчреждения;
	Элементы.ТекстФинансовыйГод.Видимость = НЕ Объект.ИзменениеТипаУчреждения;
	
	Если НЕ Объект.ИзменениеТипаУчреждения Тогда
		Объект.ФинансовыйГод = НачалоГода(Объект.Дата) - 1;
		ТекстФинансовыйГод = Год(Объект.ФинансовыйГод);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыйГодПриИзменении(Элемент)
	Если НЕ Объект.ФинансовыйГод = КонецДня(Объект.ФинансовыйГод) Тогда
		Объект.ФинансовыйГод = КонецДня(Объект.ФинансовыйГод);
	КонецЕсли; 
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

