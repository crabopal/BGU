#Область ФоновоеПроведение  

&НаКлиенте
Процедура ПровестиДокумент()
	
	ОчиститьСообщения();
	
	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Помеченный на удаление документ не может быть проведен.'"));
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = РезультатПроведенияВДлительнойОперации();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.РежимОткрытияОкнаОжидания = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("РезультатПроведенияВДлительнойОперацииЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры 

&НаСервере
Функция РезультатПроведенияВДлительнойОперации() 
	
	ДокументОбъект = Неопределено; 
	ДополнительныеСвойства = Неопределено;
	
	// Преобразовываем данные формы в объект, чтобы записать его.
	Если Модифицированность Или Объект.Проведен Тогда
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		Если НачалоДня(ДокументОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда 
			ДокументОбъект.УстановитьВремя();
		КонецЕсли;	
		ДокументОбъект.ДополнительныеСвойства.Вставить("Проведен", ДокументОбъект.Проведен); 
		
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъект, 
		ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыТиповаяОперация()],
		Новый Структура, Истина); 
		ДокументОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ВызовИзФормы = Истина;  
		ДокументОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ОтветственныйИсполнитель = 
			ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель()];
		
		ДополнительныеСвойства = ДокументОбъект.ДополнительныеСвойства;
		ДанныеДокумента = ОбщегоНазначенияБГУ.СериализоватьОбъектВДвоичныеДанные(ДокументОбъект);
	КонецЕсли;  
	
	ПараметрыПроведения = Новый Структура;
	ПараметрыПроведения.Вставить("ДокументСсылка", Объект.Ссылка);
	ПараметрыПроведения.Вставить("ДанныеДокумента", ДанныеДокумента);
	ПараметрыПроведения.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Проведение документа ""Формирование остатков по счетам расчетов""'");
		
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
	"Документы.ЗакрытиеГодаТехнологическоеГрупповое.ВыполнитьПроведениеВФоне",
	ПараметрыПроведения);
    	
КонецФункции

&НаКлиенте
Процедура РезультатПроведенияВДлительнойОперацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке); 
	ИначеЕсли Результат.Статус = "Выполнено" Тогда  
		ОбработатьФоновоеПроведение(Результат); 
		ОповеститьОбИзменении(Объект.Ссылка); 
		Если ЗакрыватьПослеЗаписи Тогда 
			Закрыть();		
		КонецЕсли; 	
	КонецЕсли;  
	
	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Сообщение.Сообщить();
	КонецЦикла;	
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьФоновоеПроведение(Результат)
	Модифицированность = Ложь;
	
	Если Не ЗакрыватьПослеЗаписи Тогда 
		ДокументОбъект = ОбщегоНазначенияБГУ.ДесериализоватьОбъектИзДвоичныхДанных(ПолучитьИзВременногоХранилища(Результат.АдресРезультата));
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
		ОбновитьВидимуюТаблицу();
		НастроитьФорму();  
	КонецЕсли; 
	
КонецПроцедуры

