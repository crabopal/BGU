#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Функция проверяет существование листа кассовой книги на дату
// текущего объекта.
// 
// Возвращаемое значение: 
// Булево.
// Истина - существует другой лист кассовой книги за этот день,
// Ложь - не существует.
// 
Функция СуществуетДокументЗаЭтотДень() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЛистКассовойКнигиФондовый.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКнигиФондовый КАК ЛистКассовойКнигиФондовый
	|ГДЕ
	|	ЛистКассовойКнигиФондовый.Организация = &Организация
	|	И НАЧАЛОПЕРИОДА(ЛистКассовойКнигиФондовый.Дата, ДЕНЬ) = &Дата
	|	И ЛистКассовойКнигиФондовый.Ссылка <> &Ссылка
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛистКассовойКнигиФондовый.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКнигиФондовый_52н КАК ЛистКассовойКнигиФондовый
	|ГДЕ
	|	ЛистКассовойКнигиФондовый.Организация = &Организация
	|	И НАЧАЛОПЕРИОДА(ЛистКассовойКнигиФондовый.Дата, ДЕНЬ) = &Дата
	|	И ЛистКассовойКнигиФондовый.Ссылка <> &Ссылка
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛистКассовойКнигиФондовый.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКнигиФондовый_52н КАК ЛистКассовойКнигиФондовый
	|ГДЕ
	|	ЛистКассовойКнигиФондовый.Организация = &Организация
	|	И НАЧАЛОПЕРИОДА(ЛистКассовойКнигиФондовый.Дата, ДЕНЬ) < &Дата
	|	И ЛистКассовойКнигиФондовый.Ссылка <> &Ссылка
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))";
				 
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Дата",				НачалоДня(Дата));
	Запрос.УстановитьПараметр("Ссылка",				Ссылка);
	Запрос.УстановитьПараметр("Подразделение",		Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(Подразделение));    

	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции //СуществуетДокументЗаЭтотДень()

// Процедура заполняет строки документа. 
// 
// Параметры: 
// Объект - Документ объект - документ для заполнения
// 
Процедура ЗаполнитьДокумент() Экспорт
	
	КассаОрганизации.ЗаполнитьОтчетКассираФондовый(ЭтотОбъект);

	Записать();
	
КонецПроцедуры //ЗаполнитьДокумент()

#КонецОбласти

#Область ОбработчикиСобытий


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если СуществуетДокументЗаЭтотДень() Тогда
		
		ТекстСообщения = НСтр("ru = 'Отчет кассира (Фондовый) за "+Формат(ЭтотОбъект.Дата,"ДФ=dd.MM.yyyy")+" уже создан,
		|или существует отчет кассира по инстр. 52н, созданный более ранней датой.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.Дата",, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры //ПередЗаписью()

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ТаблицаДокумента = КассовыеОрдера.Выгрузить(,"НомерСтроки, КассовыйДокумент");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаДокумента.НомерСтроки,
	|	ТаблицаДокумента.КассовыйДокумент
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.КассовыйДокумент,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|				ТОГДА ПриходныйОрдерФондовый.Проведен
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|				ТОГДА РасходныйОрдерФондовый.Проведен
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Проведен,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|				ТОГДА ПриходныйОрдерФондовый.Оплачено
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|				ТОГДА РасходныйОрдерФондовый.Оплачено
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Оплачено,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйОрдерФондовый.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйОрдерФондовый.Ссылка)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Представление
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерФондовый КАК ПриходныйОрдерФондовый
	|		ПО ТаблицаДокумента.КассовыйДокумент = ПриходныйОрдерФондовый.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерФондовый КАК РасходныйОрдерФондовый
	|		ПО ТаблицаДокумента.КассовыйДокумент = РасходныйОрдерФондовый.Ссылка
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|					ТОГДА ПриходныйОрдерФондовый.Проведен
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|					ТОГДА РасходныйОрдерФондовый.Проведен
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ = ЛОЖЬ
	|			ИЛИ ВЫБОР
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|					ТОГДА ПриходныйОрдерФондовый.Оплачено
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|					ТОГДА РасходныйОрдерФондовый.Оплачено
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ = ЛОЖЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.КассовыйДокумент,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйОрдерФондовый.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйОрдерФондовый.Ссылка)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ";
	
	// запрос не получает никаких данных - можно отключить RLS
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Отказ = Выборка.Количество() > 0 ;
	
	Если Отказ Тогда
		// очистим проверяемые реквизиты, чтобы не было лишних сообщений об ошибках
		
		ОшибкаПроведен = НСтр("ru = 'Документ %1 не проведен'");
		ОшибкаОплачено = НСтр("ru = 'Документ %1 не оплачен'");
		Пока Выборка.Следующий() Цикл
			
			Если НЕ Выборка.Оплачено Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаОплачено, Выборка.Представление);
			Иначе
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаПроведен, Выборка.Представление);
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Выборка.КассовыйДокумент);
			
		КонецЦикла;
		
		ПроверяемыеРеквизиты.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	КассовыеОрдера.Очистить();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли