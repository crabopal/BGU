	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	// Конец КонтрольИсполненияДоговоров
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСвязиПараметровВыбора()
	
	МассивОтборовДокументОснование = Новый Массив;
	МассивОтборовДокументОснование.Добавить(Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация", РежимИзмененияСвязанногоЗначения.Очищать));
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		МассивОтборовДокументОснование.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Объект.Контрагент", РежимИзмененияСвязанногоЗначения.НеИзменять));
	КонецЕсли;
	СвязиПараметровДокументОснование = Новый ФиксированныйМассив(МассивОтборовДокументОснование);
	Элементы.ДокументОснование.СвязиПараметровВыбора = СвязиПараметровДокументОснование;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")
	
	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища); 
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		ОтборОбновитьТекстГиперссылки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ПраваПользованияЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОтменитьПроведениеПередЗаполнениемДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ЭтотОбъект.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПересчитатьПриИзмененииВсегоЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	ПересчитатьСуммыПриИзмененииВсего(ТекущиеДанные, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПересчитатьПриИзмененииДоходовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
