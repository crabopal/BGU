&НаКлиенте
Процедура ПраваПользованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ПраваПользованияОтражениеДоходовВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияДоходовВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Поле.Имя = "ПраваПользованияОтражениеРасходовВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияРасходовВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияПриАктивизацииЯчейки(Элемент)

	Если Элементы.ПраваПользования.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ПраваПользования.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ПраваПользованияОтражениеДоходовВУчете"
			И НЕ Элементы.ПраваПользования.ТекущиеДанные.ОтражениеДоходовВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.ПраваПользования.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияДоходовВУчете(ВыбраннаяСтрока);
		ИначеЕсли ТекущаяКолонкаТаблицы.Имя = "ПраваПользованияОтражениеРасходовВУчете"
			И НЕ Элементы.ПраваПользования.ТекущиеДанные.ОтражениеРасходовВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.ПраваПользования.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияРасходовВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

