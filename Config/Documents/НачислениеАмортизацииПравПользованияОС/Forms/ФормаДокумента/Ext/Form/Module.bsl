	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияВсегоСправедливаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	ПересчитатьСуммыПриИзмененииВсегоСправедливая(ТекущиеДанные);
	
	// Сумма к списанию изменена вручную, сбросим параметры авторасчета.
	ТекущиеДанные.КоэффициентЧислитель   = 0;
	ТекущиеДанные.КоэффициентЗнаменатель = 0;
	
	// Коэффициент списания определим по фактически указанной сумме списания.
	ТекущиеДанные.Коэффициент = ?(ТекущиеДанные.ОстаточнаяСтоимость = 0, 0,
		ТекущиеДанные.ВсегоСправедливая / ТекущиеДанные.ОстаточнаяСтоимость);
	
	ПраваПользованияРассчитатьКоэффициентСписанияВСтрокеТаблицы(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияВсегоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях") Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПересчитатьПриИзмененииВсегоЗавершение", ЭтотОбъект);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ВсегоСправедливая", НСтр("ru='Справедливую стоимость'"));
		Кнопки.Добавить("СуммаДоходов", НСтр("ru='Полученные доходы'"));
		
		ПоказатьВопрос(Оповещение,
			НСтр("ru='Пересчитать справедливую стиомость или полученные доходы?'"),
			Кнопки, , "ВсегоСправедливая",
			НСтр("ru='Выберите способ пересчета'"));
		
	Иначе
		
		ПересчитатьСуммыПриИзмененииВсего(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияСуммаДоходовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях") Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПересчитатьПриИзмененииДоходовЗавершение", ЭтотОбъект);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ВсегоСправедливая", НСтр("ru='Справедливую стоимость'"));
		Кнопки.Добавить("Всего", НСтр("ru='Сумму по договору'"));
		
		ПоказатьВопрос(Оповещение, НСтр("ru='Пересчитать справедливую стиомость или сумму по договору?'"),
			Кнопки, , "ВсегоСправедливая",
			НСтр("ru='Выберите способ пересчета'"));
		
	Иначе
		
		ПересчитатьСуммыПриИзмененииДоходов(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияСуммаРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = ТекущиеДанные.ВалютаРегламентированногоУчета Тогда
		ТекущиеДанные.СуммаРасчетовВВалюте = ТекущиеДанные.СуммаРасчетов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияСтавкаНДСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДССправедливая = ТекущиеДанные.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Всего * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияНДСКРаспределениюПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.НДСКРаспределению Тогда
		ТекущиеДанные.СчетУчетаНДС = БухгалтерскийУчетКлиентСервер.СчетПоКоду("210.Н2", Объект.Дата, Объект.Организация);
	Иначе
		ТекущиеДанные.СчетУчетаНДС = БухгалтерскийУчетКлиентСервер.СчетПоКоду("210.Р2", Объект.Дата, Объект.Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияОтражениеРасходовВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияРасходовВУчете(Элементы.ПраваПользования.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияОтражениеДоходовВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияДоходовВУчете(Элементы.ПраваПользования.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ПраваПользованияЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ПраваПользования Цикл
		
		ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		ПраваПользованияРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПраваПользованияРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы)
	
	Если СтрокаТаблицы.КоэффициентЧислитель = 0
	   И СтрокаТаблицы.КоэффициентЗнаменатель = 0 Тогда
		Если СтрокаТаблицы.Коэффициент <> 0 Тогда
			СтрокаТаблицы.РасчетКоэффициентаСписания =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2 %)'"),
					СтрокаТаблицы.Коэффициент,
					Формат(СтрокаТаблицы.Коэффициент * 100, "ЧЦ=5;ЧДЦ=2"));
		Иначе
			СтрокаТаблицы.РасчетКоэффициентаСписания = "";
		КонецЕсли;
	Иначе
		СтрокаТаблицы.РасчетКоэффициентаСписания =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 / %2 = %3'"),
				СтрокаТаблицы.КоэффициентЧислитель,
				СтрокаТаблицы.КоэффициентЗнаменатель,
				СтрокаТаблицы.Коэффициент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСправедливая  = НСтр("ru = 'Справедливая стоимость:'");
	СтрокаТаблицы.ЗаголовокПоДоговору    = НСтр("ru = 'Сумма по договору:'");
	СтрокаТаблицы.ЗаголовокДоходы        = НСтр("ru = 'Полученные доходы:'");
	
	СтрокаТаблицы.ЗаголовокНеЗаполняется = НСтр("ru = '-'");
	СтрокаТаблицы.ПустойКЭК = НСтр("ru = '-'");
	СтрокаТаблицы.ВалютаРегламентированногоУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы);
	ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(СтрокаТаблицы);
	
КонецПроцедуры

