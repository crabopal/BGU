&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ПраваПользования.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДокументЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеСчетамиФактурамиИПечать(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ не записан. Сначала следует записать документ!'"));
		
	ИначеЕсли ЭтаФорма.Модифицированность Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ был изменен. Сначала следует записать документ!'"));
		
	ИначеЕсли Объект.ПометкаУдаления Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Счет-фактуры нельзя вводить на основании документа, помеченного на удаление!'"));
		
	Иначе
		
		ДокументСсылка = Объект.Ссылка;
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Документ",			ДокументСсылка);
		ПараметрыФормы.Вставить("ТиповаяОперация",	Неопределено);
		
		ПараметрыФормы.Вставить("Организация",		Объект.Организация);
		ПараметрыФормы.Вставить("ИФО",				Объект.ИФО);
		ПараметрыФормы.Вставить("Дата",				Объект.Дата);
		
		ПараметрыФормы.Вставить("КФО",				ПредопределенноеЗначение("Перечисление.КВД.Внебюджет")); 
		
		ОткрытьФорму("ОбщаяФорма.ФормаУправлениеСчетФактурамиПечати", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

