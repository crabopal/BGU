&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииВсегоСправедливая(СтрокаТаблицы)
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование") Тогда
		СтрокаТаблицы.СуммаДоходов = СтрокаТаблицы.ВсегоСправедливая;
		СтрокаТаблицы.Всего = 0;
	ИначеЕсли СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях") Тогда
		// Рассчитаем через пропорцию остатка на 401.40 и на 111.00.
		СоотношениеДБПиОстаточнойСтоимости = ?(СтрокаТаблицы.ОстаточнаяСтоимость = 0, 0, СтрокаТаблицы.ОстатокДБП / СтрокаТаблицы.ОстаточнаяСтоимость);
		СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая * (1 - СоотношениеДБПиОстаточнойСтоимости);
		СтрокаТаблицы.СуммаДоходов = Мин(СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.Всего, СтрокаТаблицы.ОстатокДБП);
	Иначе // Аренда по справедливой стоимости.
		СтрокаТаблицы.СуммаДоходов = 0;
		СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая;
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииВсего(СтрокаТаблицы, Пересчитать = "ВсегоСправедливая")
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях") Тогда
		
		Если Пересчитать = "ВсегоСправедливая" Тогда
		
			// Рассчитаем через пропорцию остатка на 401.40 и на 111.00.
			СоотношениеДБПиОстаточнойСтоимости = ?(СтрокаТаблицы.ОстаточнаяСтоимость = 0, 0, СтрокаТаблицы.ОстатокДБП / СтрокаТаблицы.ОстаточнаяСтоимость);
			Если СоотношениеДБПиОстаточнойСтоимости = 1 Тогда // Соответствует безвозмездной передаче.
				СтрокаТаблицы.СуммаДоходов = СтрокаТаблицы.ВсегоСправедливая;
				СтрокаТаблицы.Всего = 0;
			Иначе
				СтрокаТаблицы.СуммаДоходов = СоотношениеДБПиОстаточнойСтоимости/(1-СоотношениеДБПиОстаточнойСтоимости) * СтрокаТаблицы.Всего;
				СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего + СтрокаТаблицы.СуммаДоходов;
			КонецЕсли;
			
		Иначе
			
			// Справедливую стоимость не меняем, пересчитываем сумму доходов.
			СтрокаТаблицы.СуммаДоходов = СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.Всего;
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего;
		СтрокаТаблицы.СуммаДоходов = 0;
		
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииДоходов(СтрокаТаблицы, Пересчитать = "ВсегоСправедливая")
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях") Тогда
		
		Если Пересчитать = "ВсегоСправедливая" Тогда
		
			// Рассчитаем через пропорцию остатка на 401.40 и на 111.00.
			СоотношениеДБПиОстаточнойСтоимости = ?(СтрокаТаблицы.ОстаточнаяСтоимость = 0, 0, СтрокаТаблицы.ОстатокДБП / СтрокаТаблицы.ОстаточнаяСтоимость);
			Если СоотношениеДБПиОстаточнойСтоимости = 0 Тогда // Соответствует обычной аренде.
				СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая;
				СтрокаТаблицы.СуммаДоходов = 0;
			Иначе
				СтрокаТаблицы.Всего = (1-СоотношениеДБПиОстаточнойСтоимости)/СоотношениеДБПиОстаточнойСтоимости * СтрокаТаблицы.СуммаДоходов;
				СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего + СтрокаТаблицы.СуммаДоходов;
			КонецЕсли;
			
		Иначе
			
			// Справедливую стоимость не меняем, пересчитываем стоимость по договору.
			СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.СуммаДоходов;
			
		КонецЕсли;
			
	ИначеЕсли СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование") Тогда
		
		СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.СуммаДоходов;
		СтрокаТаблицы.Всего = 0;
		
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияДоходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ПраваПользования.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("РежимДоходы", Истина);
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетДоходов");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	
	// Бухгалтерский учет.
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДоходов);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДоходов1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДоходов2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДоходов3);
	
	// Налоговый учет.
	ПараметрыФормы.Вставить("ВидДеятельностиНУ",      ДанныеСтроки.ВидДеятельностиНУ);
	ПараметрыФормы.Вставить("СчетНУ",                 ДанныеСтроки.СчетДоходовНУ);
	ПараметрыФормы.Вставить("СтатьяПрочихДоходовНУ",  ДанныеСтроки.СтатьяПрочихДоходовНУ);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете доходов от предоставления прав пользования активами'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет доходов'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("401.10", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ПараметрыСчетаНУ = Новый Структура;
	ПараметрыСчетаНУ.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("Н91.01", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчетаНУ.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияРасходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ПраваПользования.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетРасходов");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",           Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",           Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК",           Истина);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество",    Ложь);
	
	// Бухгалтерский учет.
	ПараметрыФормы.Вставить("Счет",          ДанныеСтроки.СчетРасходов);
	ПараметрыФормы.Вставить("КПС",           ДанныеСтроки.КПСРасходов);
	ПараметрыФормы.Вставить("КЭК",           ДанныеСтроки.КЭКРасходов);
	ПараметрыФормы.Вставить("Подразделение", ДанныеСтроки.ПодразделениеРасходов);
	ПараметрыФормы.Вставить("Субконто1",     ДанныеСтроки.СубконтоРасходов1);
	ПараметрыФормы.Вставить("Субконто2",     ДанныеСтроки.СубконтоРасходов2);
	ПараметрыФормы.Вставить("Субконто3",     ДанныеСтроки.СубконтоРасходов3);
	
	// НДС.
	Если ДанныеСтроки.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование") Тогда
		СуммаНДС = ДанныеСтроки.СуммаНДССправедливая;
	Иначе
		СуммаНДС = ДанныеСтроки.СуммаНДС;
	КонецЕсли;
	ПараметрыФормы.Вставить("ЕстьНДС",              СуммаНДС > 0);
	ПараметрыФормы.Вставить("НДСКРаспределению",    ДанныеСтроки.НДСКРаспределению);
	ПараметрыФормы.Вставить("СчетУчетаНДС",         ДанныеСтроки.СчетУчетаНДС);
	ПараметрыФормы.Вставить("КПСУчетаНДС",          ДанныеСтроки.КПСУчетаНДС);
	ПараметрыФормы.Вставить("ВидимостьКПСУчетаНДС", Истина);
	
	// Налоговый учет.
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетРасходовНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоРасходовНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоРасходовНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоРасходовНУ3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете текущих расходов в сумме начисленной амортизации'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет расходов'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("109.00,110.00,401.20", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ПричинаНалогообложения", ПолучитьПричинуНалогообложения(ДанныеСтроки.Договор));
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияДоходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	// Бухгалтерский учет.
	ТекущиеДанные.СчетДоходов      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДоходов1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДоходов2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДоходов3 = СтруктураОтражениеВУчете.Субконто3;
	
	// Налоговый учет.
	ТекущиеДанные.ВидДеятельностиНУ     = СтруктураОтражениеВУчете.ВидДеятельностиНУ;
	ТекущиеДанные.СчетДоходовНУ         = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СтатьяПрочихДоходовНУ = СтруктураОтражениеВУчете.СтатьяПрочихДоходовНУ;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(ЭтотОбъект, ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияРасходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	// Бухгалтерский учет.
	ТекущиеДанные.СчетРасходов          = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.КПСРасходов           = СтруктураОтражениеВУчете.КПС;
	ТекущиеДанные.КЭКРасходов           = СтруктураОтражениеВУчете.КЭК;
	ТекущиеДанные.ПодразделениеРасходов = СтруктураОтражениеВУчете.Подразделение;
	ТекущиеДанные.СубконтоРасходов1     = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоРасходов2     = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоРасходов3     = СтруктураОтражениеВУчете.Субконто3;
	
	// НДС.
	ТекущиеДанные.НДСКРаспределению = СтруктураОтражениеВУчете.НДСКРаспределению;
	ТекущиеДанные.СчетУчетаНДС      = СтруктураОтражениеВУчете.СчетУчетаНДС;
	ТекущиеДанные.КПСУчетаНДС       = СтруктураОтражениеВУчете.КПСУчетаНДС;
	
	// Налоговый учет.
	ТекущиеДанные.СчетРасходовНУ      = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СубконтоРасходовНУ1 = СтруктураОтражениеВУчете.СубконтоНУ1;
	ТекущиеДанные.СубконтоРасходовНУ2 = СтруктураОтражениеВУчете.СубконтоНУ2;
	ТекущиеДанные.СубконтоРасходовНУ3 = СтруктураОтражениеВУчете.СубконтоНУ3;
	
	ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы)
	
	Параметры = Новый Структура;
	Параметры.Вставить("РежимДоходы", Истина);
	Параметры.Вставить("ОтражатьВНалоговомУчете", Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО));
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,СчетНУ,ВидДеятельностиНУ,СтатьяПрочихДоходовНУ,ОтражениеВУчете",
		"СчетДоходов",
		"СубконтоДоходов1",
		"СубконтоДоходов2",
		"СубконтоДоходов3",
		"СчетДоходовНУ",
		"ВидДеятельностиНУ",
		"СтатьяПрочихДоходовНУ",
		"ОтражениеДоходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, Параметры, ПоляФормы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(СтрокаТаблицы)
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,СчетНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,ОтражениеВУчете",
		"СчетРасходов",
		"СубконтоРасходов1",
		"СубконтоРасходов2",
		"СубконтоРасходов3",
		"СчетРасходовНУ",
		"СубконтоРасходовНУ1",
		"СубконтоРасходовНУ2",
		"СубконтоРасходовНУ3",
		"ОтражениеРасходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, , ПоляФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПричинуНалогообложения(Договор)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка();
	Иначе
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ТипДоговораНДС");
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И РеквизитыДоговора.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор Тогда
			Возврат Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И РеквизитыДоговора.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент Тогда
			Возврат Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент;
		Иначе
			Возврат Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДоговораНалоговогоАгентаАренда(ДокументСсылка)
	
	Возврат Документы.НачислениеАмортизацииПравПользованияОС.ЕстьДоговораНалоговогоАгентаАренда(ДокументСсылка);
	
КонецФункции

