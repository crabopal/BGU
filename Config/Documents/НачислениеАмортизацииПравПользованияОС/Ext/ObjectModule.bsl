	|						ПраваПользованияБУ)) КАК ЕПСБУОстатки";
	
	// 401.60 Резерв предстоящих расходов по арендной плате (льготная и обычная аренда).
	НомераТаблиц.Вставить("РезервыПредстоящихРасходовПоАренднойПлате", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Счет КАК СчетРезервов,
	|	ЕПСБУОстатки.КПС КАК КПСРезервов,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Резервы) КАК Резерв,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокРезервов,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ОстатокРезервовВВалюте,
	|	ЕПСБУОстатки.Валюта КАК Валюта
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериодаГраница,
	|			Счет В (&Счета40160),
	|			&ВидыСубконтоРезервы,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК ЕПСБУОстатки";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Если Отбор.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
			"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В(&Договоры)");
		Запрос.УстановитьПараметр("Договоры", Отбор.ВыгрузитьКолонку("Договор"));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаПравПользования = Результат[НомераТаблиц.ПраваПользования].Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ВедетсяУчетПравПользованияПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	
	// Распределим остатки ДБП (401.40) по аналитике прав пользования.
	ДоходыОтПредоставленияПравПользования = Результат[НомераТаблиц.ДоходыОтПредоставленияПравПользования].Выгрузить();
	ТаблицаПравПользования.Колонки.Добавить("СчетДБП",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПравПользования.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПравПользования.Колонки.Добавить("КПСДоходов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаПравПользования.Колонки.Добавить("КЭКДоходов",   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПравПользования.Колонки.Добавить("ОстатокДБП",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	Для Каждого ОстатокДБП Из ДоходыОтПредоставленияПравПользования Цикл
		
		СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокДБП.СчетДБП);
		
		ОтборПравПользования = ?(ВедетсяУчетПравПользованияПоПодразделениям И СвойстваСчетаДБП.УчетПоПодразделениям,
			Новый Структура("ИФО,КФО,Договор,Подразделение"),
			Новый Структура("ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокДБП);
		НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокДБП.ОстатокДБП,
			НайденныеСтрокиПравПользования, "ОстатокДБП", "ОстаточнаяСтоимость", Ложь);
		
		Для Каждого СтрокаПравоПользования Из НайденныеСтрокиПравПользования Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПравоПользования, ОстатокДБП,
				"СчетДБП,Номенклатура,КПСДоходов,КЭКДоходов");
		КонецЦикла;
		
	КонецЦикла;
	
	// Распределим остатки резервов (401.60) по аналитике прав пользования.
	РезервыПредстоящихРасходовПоАренднойПлате = Результат[НомераТаблиц.РезервыПредстоящихРасходовПоАренднойПлате].Выгрузить();
	ТаблицаПравПользования.Колонки.Добавить("ОстатокРезервов",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("ОстатокРезервовВВалюте",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Для Каждого ОстатокРезервов Из РезервыПредстоящихРасходовПоАренднойПлате Цикл
		
		СвойстваСчетаРезервов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокРезервов.СчетРезервов);
		
		ОтборПравПользования = ?(ВедетсяУчетПравПользованияПоПодразделениям И СвойстваСчетаРезервов.УчетПоПодразделениям,
			Новый Структура("СчетРезервов,КПСРезервов,Резерв,ИФО,КФО,Договор,Подразделение"),
			Новый Структура("СчетРезервов,КПСРезервов,Резерв,ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокРезервов);
		НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокРезервов.ОстатокРезервов,
			НайденныеСтрокиПравПользования, "ОстатокРезервов", "ОстаточнаяСтоимость", Ложь);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокРезервов.ОстатокРезервовВВалюте,
			НайденныеСтрокиПравПользования, "ОстатокРезервовВВалюте", "ОстаточнаяСтоимость", Ложь);
		
		Для Каждого СтрокаПравоПользования Из НайденныеСтрокиПравПользования Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПравоПользования, ОстатокРезервов, "Валюта");
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЭтоНачислениеАмортизацииПриПрекращенииПравПользования Тогда
		РеквизитыДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "ВидОперации,Дата,Номер");
	КонецЕсли;
	
	// Получим данные графиков оплат для договоров с признанием расходов по графику.
	ПризнаниеРасходовПоГрафику = Новый Структура("СпособПризнанияРасходов", Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ПризнаниеРасходовПоГрафику.Вставить("ЕстьГрафикАмортизацииОбъекта", Ложь); // Если есть график амортизации объекта, используется он, а не график исполнения по договору.
	СтрокиСПризнаниемПоГрафику = ТаблицаПравПользования.НайтиСтроки(ПризнаниеРасходовПоГрафику);
	Если СтрокиСПризнаниемПоГрафику.Количество() > 0 Тогда
		
		ТаблицаПравПользования.Колонки.Добавить("ОстатокСуммаПоДоговору",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		ТаблицаПравПользования.Колонки.Добавить("СуммаПоГрафику",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		ТаблицаПравПользования.Колонки.Добавить("СправедливаяПоГрафику",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		
		ДоговорыСПризнаниемПоГрафику = Новый Массив;
		Для Каждого Строка Из СтрокиСПризнаниемПоГрафику Цикл
			ДоговорыСПризнаниемПоГрафику.Добавить(Строка.Договор);
			// Для каждой строки таблицы прав пользования рассчитаем остаток оплаты за весь оставшийся срок договора.
			Строка.ОстатокСуммаПоДоговору = Строка.ОстаточнаяСтоимость - Строка.ОстатокДБП;
		КонецЦикла;
		
		ГрафикНачисления = КонтрольИсполненияДоговоров.ГрафикИсполненияПоДоговору(
			Организация,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ДоговорыСПризнаниемПоГрафику),
			"Месяц",
			НачалоМесяца(Дата));
		
		ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
		
		// Распределим справедливую стоимость по всем периодам графика по договору.
		ГрафикНачисления.Колонки.Добавить("СправедливаяСтоимость",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		ГрафикНачисления.Колонки.Добавить("БазаРаспределения", Новый ОписаниеТипов("Число"));
		Для Каждого СтрокаТаблицы Из СтрокиСПризнаниемПоГрафику Цикл
			
			ОтборСтрок = Новый Структура("ИФО,КФО,Контрагент,Договор,СчетРасчетов");
			ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
			ОтборСтрок.Вставить("КПС", СтрокаТаблицы.КПСРасчетов);
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				ОтборСтрок.Вставить("КЭК", СтрокаТаблицы.КЭКРасходов);
			КонецЕсли;
			НайденныеСтрокиГрафика = ГрафикНачисления.НайтиСтроки(ОтборСтрок);
			
			ГрафикНачисления.ЗаполнитьЗначения(0, "БазаРаспределения");
			Для Каждого СтрокаГрафика Из НайденныеСтрокиГрафика Цикл
				Если СтрокаТаблицы.ОстатокДБП = 0 Тогда
					// Для обычных договоров (без льгот) справедливая стоимость распределена так же, как сумма реализации по графику.
					СтрокаГрафика.БазаРаспределения = СтрокаГрафика.Сумма;
				Иначе
					// При льготной аренде распределим справедливую стоимость равномерно по всем периодам графика по договору.
					СтрокаГрафика.БазаРаспределения = 1;
				КонецЕсли;
			КонецЦикла;
			
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаТаблицы.ОстаточнаяСтоимость,
				НайденныеСтрокиГрафика, "СправедливаяСтоимость", "БазаРаспределения", Ложь);
			
		КонецЦикла;
		
		// Распределим сумму по графику по строкам прав пользования пропорционально остатку оплаты.
		Для Каждого СтрокаПоГрафику Из ГрафикНачисления Цикл
			
			Если СтрокаПоГрафику.Период < НачалоМесяца(Дата)
			 ИЛИ СтрокаПоГрафику.Период > КонецМесяца(Дата) Тогда
				Продолжить; // Пропускаем строки графика из других периодов.
			КонецЕсли;
			
			ОтборСтрок = Новый Структура("ИФО,КФО,Контрагент,Договор,СчетРасчетов");
			ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаПоГрафику);
			ОтборСтрок.Вставить("КПСРасчетов", СтрокаПоГрафику.КПС);
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				ОтборСтрок.Вставить("КЭКРасходов", СтрокаПоГрафику.КЭК);
			КонецЕсли;
			НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборСтрок);
			
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаПоГрафику.Сумма,
				НайденныеСтрокиПравПользования, "СуммаПоГрафику", "ОстатокСуммаПоДоговору", Ложь);
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаПоГрафику.СправедливаяСтоимость,
				НайденныеСтрокиПравПользования, "СправедливаяПоГрафику", "ОстаточнаяСтоимость", Ложь);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Расчет сумм начисления амортизации прав пользования.
	Для Каждого СтрокаТаблицы Из ТаблицаПравПользования Цикл
		
		Если ТипПериода = 1 И НЕ СтрокаТаблицы.ЕстьГрафикАмортизацииОбъекта Тогда
			Продолжить; // Начисление амортизации в режиме "На дату" поддерживается только по графику амортизации объекта (регистр ГрафикАмортизацииПравПользованияОС).
		КонецЕсли;
		Если СтрокаТаблицы.ЕстьГрафикАмортизацииОбъекта И СтрокаТаблицы.АмортизацияПоГрафику = 0 И СтрокаТаблицы.АренднаяПлатаПоГрафику = 0 Тогда
			Продолжить; // Нулевая сумма по графику на заданную дату / в выбранном периоде.
		КонецЕсли;
		
		Доля = 0;
		ПротоколРасчета = Новый Структура("Числитель, Знаменатель", 0, 0);
		Если (СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
		 ИЛИ СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням)
		 И НЕ СтрокаТаблицы.ЕстьГрафикАмортизацииОбъекта Тогда
			
			Доля = БухгалтерскийУчет.ДоляОчередногоМесяцаПриРавномерномПризнанииДоходовРасходов(
				СтрокаТаблицы.СпособПризнанияРасходов,
				Дата,
				СтрокаТаблицы.ДатаНачалаАмортизации,
				СтрокаТаблицы.ДатаОкончанияАмортизации,
				ПротоколРасчета);
				
			Если Доля = 0
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации)
				И КонецМесяца(Дата) < КонецМесяца(СтрокаТаблицы.ДатаНачалаАмортизации) Тогда
				Продолжить; // Срок начисления амортизации еще не начался.
			КонецЕсли;
			
			Если ЭтоНачислениеАмортизацииПриПрекращенииПравПользования Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					Продолжить; // Нет параметров учета в регистре. Возможно, объект принят к учету ручной операцией.
				КонецЕсли;
				Если РеквизитыДокументаОснования.ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования
					И (КонецДня(РеквизитыДокументаОснования.Дата) < КонецДня(СтрокаТаблицы.ДатаОкончанияАмортизации)) Тогда
					Продолжить;
				ИначеЕсли РеквизитыДокументаОснования.ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение
					И (КонецДня(РеквизитыДокументаОснования.Дата) >= КонецДня(СтрокаТаблицы.ДатаОкончанияАмортизации)) Тогда
					Продолжить;
				КонецЕсли;
				
				// При прекращении прав пользования ранее завершения срока аренды скорректируем долю очередного месяца.
				// Начисление амортизации производится за период с начала месяца до даты документа.
				Если КонецДня(Дата) < КонецДня(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					КоэффициентКорректировки = День(Дата) / День(КонецМесяца(Дата));
					ПротоколРасчета.Числитель = ПротоколРасчета.Числитель * КоэффициентКорректировки;
					Доля = Доля * КоэффициентКорректировки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = ПраваПользования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(НоваяСтрока.Валюта) И НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
			КурсПересчета = ?(СтрокаТаблицы.ОстатокРезервовВВалюте = 0, 1, СтрокаТаблицы.ОстатокРезервов / СтрокаТаблицы.ОстатокРезервовВВалюте);
		Иначе
			КурсПересчета = 1;
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если СтрокаТаблицы.ЕстьГрафикАмортизацииОбъекта Тогда
			
			// Для объектов прав пользования, по которым ведется Карточка учета права пользования 0509214,
			// амортизация всегда начисляется по графику амортизации, указанному в разделе 2 Карточки.
			НоваяСтрока.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику;
			НоваяСтрока.ДатаНачалаАмортизации = Дата(1, 1, 1, 0, 0, 0);
			НоваяСтрока.ДатаОкончанияАмортизации = Дата(1, 1, 1, 0, 0, 0);
			
			// Ставка НДС по умолчанию установлена в карточке права пользования.
			СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			// Заполним справедливую стоимость.
			НоваяСтрока.ВсегоСправедливая = СтрокаТаблицы.АмортизацияПоГрафику * КурсПересчета;
			НоваяСтрока.СуммаНДССправедливая = НоваяСтрока.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
			
			// Заполним сумму и НДС по договору.
			НоваяСтрока.Всего = СтрокаТаблицы.АренднаяПлатаПоГрафику * КурсПересчета;
			НоваяСтрока.СуммаНДС = НоваяСтрока.Всего * СтавкаНДС / (100 + СтавкаНДС);
			
			// Коэффициент списания рассчитываем по фактической стоимости списания, как если бы указали ее вручную.
			НоваяСтрока.Коэффициент = ?(НоваяСтрока.ОстаточнаяСтоимость = 0, 0,
				НоваяСтрока.ВсегоСправедливая / НоваяСтрока.ОстаточнаяСтоимость);
			НоваяСтрока.КоэффициентЧислитель	= 0;
			НоваяСтрока.КоэффициентЗнаменатель	= 0;
			
			// Сумма расчетов (резервов) - сумма начисленной кредиторской задолженности по арендной плате.
			НоваяСтрока.СуммаРасчетов = НоваяСтрока.Всего;
			НоваяСтрока.СуммаРасчетовВВалюте = НоваяСтрока.СуммаРасчетов / КурсПересчета;
			
			НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
			
		ИначеЕсли СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
		 ИЛИ СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
			
			НоваяСтрока.Коэффициент				= Доля;
			НоваяСтрока.КоэффициентЧислитель	= ПротоколРасчета.Числитель;
			НоваяСтрока.КоэффициентЗнаменатель	= ПротоколРасчета.Знаменатель;
			
			НоваяСтрока.ВсегоСправедливая = Доля * НоваяСтрока.ОстаточнаяСтоимость;
			
			// Ставка НДС по умолчанию установлена в карточке права пользования.
			СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			НоваяСтрока.СуммаНДССправедливая = НоваяСтрока.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
			
			// Заполним сумму и НДС по договору.
			Если НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				НоваяСтрока.Всего = 0;
				НоваяСтрока.СуммаНДС = 0;
			ИначеЕсли НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях Тогда
				// Рассчитаем через пропорцию остатка на 401.40 и на 111.00.
				СоотношениеДБПиОстаточнойСтоимости = ?(НоваяСтрока.ОстаточнаяСтоимость = 0, 0, НоваяСтрока.ОстатокДБП / НоваяСтрока.ОстаточнаяСтоимость);
				НоваяСтрока.Всего = НоваяСтрока.ВсегоСправедливая * (1 - СоотношениеДБПиОстаточнойСтоимости);
				НоваяСтрока.СуммаНДС = НоваяСтрока.СуммаНДССправедливая * (1 - СоотношениеДБПиОстаточнойСтоимости);
			Иначе // Аренда по справедливой стоимости.
				НоваяСтрока.Всего = НоваяСтрока.ВсегоСправедливая;
				НоваяСтрока.СуммаНДС = НоваяСтрока.СуммаНДССправедливая;
			КонецЕсли;
			
			// Сумма расчетов (резервов) - сумма начисленной кредиторской задолженности по арендной плате.
			НоваяСтрока.СуммаРасчетов = НоваяСтрока.Всего;
			НоваяСтрока.СуммаРасчетовВВалюте = НоваяСтрока.СуммаРасчетов / КурсПересчета;
			
		ИначеЕсли СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
			
			// Ставка НДС по умолчанию установлена в карточке права пользования.
			СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			// Заполним справедливую стоимость.
			НоваяСтрока.ВсегоСправедливая = МИН(СтрокаТаблицы.СправедливаяПоГрафику, НоваяСтрока.ОстаточнаяСтоимость);
			НоваяСтрока.СуммаНДССправедливая = НоваяСтрока.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
			
			// Заполним сумму и НДС по договору.
			НоваяСтрока.Всего = МИН(СтрокаТаблицы.СуммаПоГрафику, СтрокаТаблицы.ОстатокСуммаПоДоговору);
			НоваяСтрока.СуммаНДС = НоваяСтрока.Всего * СтавкаНДС / (100 + СтавкаНДС);
			
			// Коэффициент списания рассчитываем по фактической стоимости списания, как если бы указали ее вручную.
			НоваяСтрока.Коэффициент = ?(НоваяСтрока.ОстаточнаяСтоимость = 0, 0,
				НоваяСтрока.ВсегоСправедливая / НоваяСтрока.ОстаточнаяСтоимость);
			НоваяСтрока.КоэффициентЧислитель	= 0;
			НоваяСтрока.КоэффициентЗнаменатель	= 0;
			
			// Сумма расчетов (резервов) - сумма начисленной кредиторской задолженности по арендной плате.
			НоваяСтрока.СуммаРасчетов = НоваяСтрока.Всего;
			НоваяСтрока.СуммаРасчетовВВалюте = НоваяСтрока.СуммаРасчетов / КурсПересчета;
			
			НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
			
		КонецЕсли;
		
		НоваяСтрока.НДСКРаспределению = Ложь;
		НоваяСтрока.СчетУчетаНДС = БухгалтерскийУчет.СчетПоКоду("210.Р2", Дата, Организация);
		НоваяСтрока.КПСУчетаНДС = СтрокаТаблицы.КПСРасчетов; // По умолчанию для проводки по 210.Р2 используется КПС расчетов (к счету 302.ХХ).
		
		ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, НоваяСтрока.КФО);
		
		// Доходы от предоставления прав пользования.
		Если НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование
			ИЛИ НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях Тогда
			
			НоваяСтрока.СуммаДоходов = МИН(НоваяСтрока.ВсегоСправедливая - НоваяСтрока.Всего, НоваяСтрока.ОстатокДБП);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,
				"СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3");
			
			Если ОтражатьВНалоговомУчете Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,
					"ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ");
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидДеятельностиНУ) Тогда
					// По умолчанию - основная система налогообложения.
					НоваяСтрока.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходовНУ) Тогда
					// По умолчанию - доходы от обычных видов деятельности.
					НоваяСтрока.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Дата);
				КонецЕсли;
				
				Если НЕ БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетДоходовНУ, "Н91.01") Тогда
					НоваяСтрока.СтатьяПрочихДоходовНУ = Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Счет и аналитика расходов по амортизации прав пользования.
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,
			"СчетРасходов,КПСРасходов,КЭКРасходов,ПодразделениеРасходов,СубконтоРасходов1,СубконтоРасходов2,СубконтоРасходов3");
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КПСРасходов) Тогда // Если не заполнен, совпадает с КПС учета.
			НоваяСтрока.КПСРасходов = СтрокаТаблицы.КПС;
		КонецЕсли;
		
		Если ОтражатьВНалоговомУчете Тогда
			
			НоваяСтрока.СчетРасходовНУ = НалоговыйУчетКлиентСервер.СчетРасходовНУ(
				НоваяСтрока.СчетРасходов,
				НоваяСтрока.СубконтоРасходов1,
				НоваяСтрока.СубконтоРасходов2,
				НоваяСтрока.СубконтоРасходов3,
				УправлениеОсновнымиСредствамиПовтИсп.СчетАмортизацииОС(НоваяСтрока.СчетУчета),
				Организация, НоваяСтрока.ИФО, НоваяСтрока.ПодразделениеРасходов, Дата);
			
			СвойстваСчетаРасходов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетРасходов);
			Для НомерСубконто = 1 По 3 Цикл
				НоваяСтрока["СубконтоРасходовНУ" + НомерСубконто] =
					БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетРасходовНУ, НомерСубконто,
						СвойстваСчетаРасходов.ВидСубконто1, СтрокаТаблицы.СубконтоРасходов1,
						СвойстваСчетаРасходов.ВидСубконто2, СтрокаТаблицы.СубконтоРасходов2,
						СвойстваСчетаРасходов.ВидСубконто3, СтрокаТаблицы.СубконтоРасходов3,
						"ПрочиеДоходыИРасходы", СтрокаТаблицы.СтатьяПрочихРасходовНУ,
						"РеализуемыеАктивы", СтрокаТаблицы.ОсновноеСредство);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения)
	
	Дата = КонецМесяца(ДобавитьМесяц(ДанныеЗаполнения.Дата, -1));
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения,
		"Организация,Контрагент,Ответственный");
	НоваяСтрока = Отбор.Добавить();
	НоваяСтрока.Договор = ДанныеЗаполнения.Договор;
	
	ДокументОснование = ДанныеЗаполнения;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
