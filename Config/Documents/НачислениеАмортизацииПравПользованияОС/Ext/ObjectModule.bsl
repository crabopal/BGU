#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование);
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения,
				"Дата,Организация,ИФО,КФО,Контрагент,Ответственный");
			Отбор.Загрузить(ДанныеЗаполнения.Отбор.Выгрузить());
			
			ЗаполнитьДокумент();
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ТипПериода = 0 Тогда // За месяц.
		Дата = КонецМесяца(Дата);
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
		
		Если СтрокаТаблицы.СуммаРасчетов = 0 Или Не ЗначениеЗаполнено(СтрокаТаблицы.Валюта) Тогда
			// Для совместимости с документами, введенными до 2.0.97.
			// При перепроведении документа заполняется реквизит СуммаРасчетов, который используется при формировании бух.записей.
			СтрокаТаблицы.Валюта = ВалютаРегламентированногоУчета;
			СтрокаТаблицы.СуммаРасчетов = СтрокаТаблицы.Всего;
			СтрокаТаблицы.СуммаРасчетовВВалюте = СтрокаТаблицы.СуммаРасчетов;
		КонецЕсли;
		
	КонецЦикла;
	
	СуммаДокумента = ПраваПользования.Итог("ВсегоСправедливая");
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ПраваПользования.Очистить();
	
	ЭтоНачислениеАмортизацииПриПрекращенииПравПользования = ЗначениеЗаполнено(ДокументОснование) 
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПрекращениеПравПользованияОС");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Организация);
	
	Если ТипПериода = 0 Тогда // За месяц.
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("КонецПериода",  КонецМесяца(Дата));
		Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	ИначеЕсли ТипПериода = 1 Тогда // На дату.
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
		Запрос.УстановитьПараметр("КонецПериода",  КонецДня(Дата));
		Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СчетаУчетаПравПользования",
		БухгалтерскийУчет.СписокСчетов("111.40", Дата));
	Запрос.УстановитьПараметр("СчетаАмортизацииПравПользования" ,
		БухгалтерскийУчет.СписокСчетов("104.40", Дата));
	Запрос.УстановитьПараметр("Счета40140",
		БухгалтерскийУчет.СписокСчетов("401.40"));
	Запрос.УстановитьПараметр("Счета40160",
		БухгалтерскийУчет.СписокСчетов("401.60"));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоДБП", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Резервы);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоРезервы", ВидыСубконто);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПраваПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияТекущегоМесяца", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПраваПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ПраваПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ПраваПользованияОстатки.КФО КАК КФО,
	|	ПраваПользованияОстатки.КПС КАК КПС,
	|	ПраваПользованияОстатки.Счет КАК СчетУчета,
	|	ПраваПользованияОстатки.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ПраваПользованияОстатки.СуммаОстатокДт КАК Сумма
	|ПОМЕСТИТЬ ПраваПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериодаГраница,
	|			Счет В (&СчетаУчетаПравПользования),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор) КАК ПраваПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияПравПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(АмортизацияПравПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	АмортизацияПравПользованияОстатки.КФО КАК КФО,
	|	АмортизацияПравПользованияОстатки.КПС КАК КПС,
	|	АмортизацияПравПользованияОстатки.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	АмортизацияПравПользованияОстатки.СуммаОстатокКт КАК СуммаАмортизации
	|ПОМЕСТИТЬ АмортизацияПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериодаГраница,
	|			Счет В (&СчетаАмортизацииПравПользования),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК АмортизацияПравПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияПравПользованияОбороты.Организация КАК Организация,
	|	ЕСТЬNULL(АмортизацияПравПользованияОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	АмортизацияПравПользованияОбороты.КФО КАК КФО,
	|	АмортизацияПравПользованияОбороты.КПС КАК КПС,
	|	АмортизацияПравПользованияОбороты.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОбороты.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	АмортизацияПравПользованияОбороты.СуммаОборотКт КАК НачисленоВТекущемМесяце
	|ПОМЕСТИТЬ АмортизацияТекущегоМесяца
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаАмортизацииПравПользования),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ),
	|			НЕ КорСчет В (&СчетаАмортизацииПравПользования),
	|			) КАК АмортизацияПравПользованияОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС";
	
	НомераТаблиц.Вставить("ЕстьГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрафикАмортизацииПравПользованияОС.Организация КАК Организация,
	|	ГрафикАмортизацииПравПользованияОС.Договор КАК Договор,
	|	ГрафикАмортизацииПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ЕстьГрафикАмортизацииПравПользованияОС
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС КАК ГрафикАмортизацииПравПользованияОС
	|ГДЕ
	|	ГрафикАмортизацииПравПользованияОС.Организация = &Организация
	|	И ГрафикАмортизацииПравПользованияОС.Договор В
	|			(ВЫБРАТЬ
	|				ПраваПользованияБУ.Договор КАК Договор
	|			ИЗ
	|				ПраваПользованияБУ КАК ПраваПользованияБУ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикАмортизацииПравПользованияОСОбороты.Организация КАК Организация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.Договор КАК Договор,
	|	ГрафикАмортизацииПравПользованияОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АмортизацияОборот КАК Амортизация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АренднаяПлатаОборот КАК АренднаяПлата
	|ПОМЕСТИТЬ ГрафикАмортизацииПравПользованияОС
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС.Обороты(
	|			,
	|			,
	|			,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.Договор КАК Договор
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И ДатаНачисленияАмортизации >= &НачалоПериода
	|				И ДатаНачисленияАмортизации <= &КонецПериода) КАК ГрафикАмортизацииПравПользованияОСОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииПоДоговоруВЦелом", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ПараметрыАмортизацииПравПользования.Организация КАК Организация,
	|	ПараметрыАмортизацииПравПользования.Договор КАК Договор,
	|	ПараметрыАмортизацииПравПользования.ВидОперации КАК ВидОперации,
	|	ПараметрыАмортизацииПравПользования.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	ПараметрыАмортизацииПравПользования.ДатаНачалаАмортизации КАК ДатаНачалаАмортизации,
	|	ПараметрыАмортизацииПравПользования.ДатаОкончанияАмортизации КАК ДатаОкончанияАмортизации,
	|	ПараметрыАмортизацииПравПользования.СчетРасходов КАК СчетРасходов,
	|	ПараметрыАмортизацииПравПользования.КПСРасходов КАК КПСРасходов,
	|	ПараметрыАмортизацииПравПользования.КЭКРасходов КАК КЭКРасходов,
	|	ПараметрыАмортизацииПравПользования.ПодразделениеРасходов КАК ПодразделениеРасходов,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов1 КАК СубконтоРасходов1,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов2 КАК СубконтоРасходов2,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов3 КАК СубконтоРасходов3,
	|	ПараметрыАмортизацииПравПользования.СтатьяПрочихРасходовНУ КАК СтатьяПрочихРасходовНУ,
	|	ПараметрыАмортизацииПравПользования.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
	|	ПараметрыАмортизацииПравПользования.СчетРасчетов КАК СчетРасчетов,
	|	ПараметрыАмортизацииПравПользования.КПСРасчетов КАК КПСРасчетов
	|ПОМЕСТИТЬ ПараметрыАмортизацииПоДоговоруВЦелом
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииПравПользованияОС.СрезПоследних(
	|			&КонецПериодаГраница,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.Договор КАК Договор
