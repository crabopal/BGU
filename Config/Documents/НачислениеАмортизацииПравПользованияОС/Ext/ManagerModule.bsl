Функция ЕстьДоговораНалоговогоАгентаАренда(ДокументСсылка) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Количество строк с агентскими договорами
	|//
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС.ПраваПользования
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|;";
	
	КоличествоСтрок = 0;
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КоличествоСтрок = Выборка.КоличествоСтрок;
	КонецЦикла;
	
	Возврат (КоличествоСтрок > 0);
	
КонецФункции

Процедура СформироватьСчетаФактуры(ДокументОснованиеСсылка, ФормаУправленияСчетамиФактурами) Экспорт
	
	Перем ДокументОбъект;
	
	ДатаСчетовФактур = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка, "Дата");
	
	СтруктураСвойств = Новый Структура();
	СтруктураСвойств.Вставить("ПричинаНалогообложения",	Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент);
	СтруктураСвойств.Вставить("КФО",					Перечисления.КВД.Внебюджет);
	СтруктураСвойств.Вставить("Дата",					ДатаСчетовФактур);
	
	ПрименяемаяИнструкция = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(СтруктураСвойств);
	
	СчетВычетКтКРаспределению	= ПрименяемаяИнструкция["СчетВычетКтКРаспределениюПоУмолчанию"];
	СчетВычетКтБезРаспределения	= ПрименяемаяИнструкция["СчетВычетКтБезРаспределенияПоУмолчанию"];
	
	РуководительСсылка = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		ФормаУправленияСчетамиФактурами.Организация,
		ДатаСчетовФактур).ОтветственноеЛицоСсылка;
	
	ГлавныйБухгалтерСсылка = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		ФормаУправленияСчетамиФактурами.Организация,
		ДатаСчетовФактур).ОтветственноеЛицоСсылка;
	
	ТЗ = ФормаУправленияСчетамиФактурами["Список"].Выгрузить(Новый Структура("Отметка", Истина));
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	НаДату = Неопределено;
	
	Счет30224 = БухгалтерскийУчетКлиентСервер.СчетПоКоду("302.24", НаДату);
	
	КЭК831 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("831");
	
	ЗапросДанные = Новый Запрос();
	ЗапросДанные.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументОснованиеСсылка);
	ЗапросДанные.УстановитьПараметр("ТЗ",						ТЗ);
	ЗапросДанные.УстановитьПараметр("ДействиеСоздать",			1);
	ЗапросДанные.УстановитьПараметр("ДействиеИзменить",			2);
	ЗапросДанные.УстановитьПараметр("ДействиеУдалить",			3);
	ЗапросДанные.УстановитьПараметр("ЕдИзмШт",					ЕдИзмШт);
	ЗапросДанные.УстановитьПараметр("Счет30304",				ФормаУправленияСчетамиФактурами["Счет30304"]);
	ЗапросДанные.УстановитьПараметр("КПС30304",					ФормаУправленияСчетамиФактурами["КПС30304"]);
	ЗапросДанные.УстановитьПараметр("КПС30304Полученный",		ФормаУправленияСчетамиФактурами["КПС30304Полученный"]);
	ЗапросДанные.УстановитьПараметр("Счет30224",				Счет30224);
	ЗапросДанные.УстановитьПараметр("КЭК831",					КЭК831);
	ЗапросДанные.УстановитьПараметр("СчетВычетКтКРаспределению",	СчетВычетКтКРаспределению);
	ЗапросДанные.УстановитьПараметр("СчетВычетКтБезРаспределения",	СчетВычетКтБезРаспределения);
	ЗапросДанные.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица из формы Управление счетами-фактурами и печать
	|//
	|ВЫБРАТЬ
	|	ТЗ.СчетФактура				КАК СчетФактура,
	|	ТЗ.НомерСтрокиНачисления	КАК НомерСтрокиНачисления,
	|	ТЗ.Действие					КАК Действие,
	|	ТЗ.ЭтоСчетФактураПолученный	КАК ЭтоСчетФактураПолученный
	|ПОМЕСТИТЬ
	|	ТаблицаДействий
	|ИЗ
	|	&ТЗ	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица всех начислений из документа-основания
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация					КАК Организация,
	|	Ссылка								КАК Ссылка,
	|	ПраваПользования.НомерСтроки		КАК НомерСтроки,
	|	ПраваПользования.ВидОперации		КАК ВидОперации,
	|	ПраваПользования.ИФО				КАК ИФО,
	|	ПраваПользования.Подразделение		КАК Подразделение,
	|	ПраваПользования.Контрагент			КАК Контрагент,
	|	ПраваПользования.Договор			КАК Договор,
	|	ПраваПользования.КФО				КАК КФО,
	|	ПраваПользования.ОсновноеСредство	КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПраваПользования.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование) ТОГДА
	|			ПраваПользования.ВсегоСправедливая
	|		ИНАЧЕ
	|			ПраваПользования.Всего
	|	КОНЕЦ								КАК Всего,
	|	ПраваПользования.СтавкаНДС			КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ПраваПользования.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование) ТОГДА
	|			ПраваПользования.СуммаНДССправедливая
	|		ИНАЧЕ
	|			ПраваПользования.СуммаНДС
	|	КОНЕЦ								КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ПраваПользования.КПСУчетаНДС <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) ТОГДА
	|			ПраваПользования.КПСУчетаНДС
	|		ИНАЧЕ
	|			ПраваПользования.КПС
	|	КОНЕЦ 								КАК КПСРасходов,
	|	ПраваПользования.ПринятьНДСКВычету	КАК ПринятьНДСКВычету,
	|	ПраваПользования.НДСКРаспределению	КАК НДСКРаспределению
	|ПОМЕСТИТЬ
	|	Начисления
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС.ПраваПользования	КАК ПраваПользования
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
