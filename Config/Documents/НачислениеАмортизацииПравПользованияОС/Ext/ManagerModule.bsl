Процедура УстановитьТекстОшибки(СтрокаТаблицы)
	
	ОшибкаКонтрольныхПолей = СтрокаТаблицы["ОшибкаКонтрольныхПолей"];
	
	КоличествоСчетовФактур = СтрокаТаблицы["КоличествоСчетовФактур"];
	
	НесколькоСчетовФактур = (КоличествоСчетовФактур >= 2);
	
	ОтсутствуетНачисление = СтрокаТаблицы["ОтсутствуетНачисление"];
	
	СчетФактураНеПроведен = (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И НЕ СтрокаТаблицы["СчетФактураПроведен"]);
	
	СчетФактураПомеченНаУдаление = (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И СтрокаТаблицы["СчетФактураПометкаУдаления"]);
	
	ЕстьОшибка = (ОшибкаКонтрольныхПолей > 0
		ИЛИ НесколькоСчетовФактур
		ИЛИ ОтсутствуетНачисление
		ИЛИ СчетФактураНеПроведен
		ИЛИ СчетФактураПомеченНаУдаление);
	
	Если НЕ ЕстьОшибка Тогда
		Возврат;
	КонецЕсли;
	
	КонтрольныеПоля = Новый Массив();
	
	КоличествоКонтрольныхПолей = 9;
	
	Для КонтрольноеПоле = 1 По КоличествоКонтрольныхПолей Цикл
		
		ЕстьОшибка = ((ОшибкаКонтрольныхПолей%2) = 1);
		
		ОшибкаКонтрольныхПолей = Цел(ОшибкаКонтрольныхПолей / 2);
		
		Если НЕ ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		
		Если КонтрольноеПоле = 1 Тогда
			КонтрольныеПоля.Добавить("Организация");
			
		ИначеЕсли КонтрольноеПоле = 2 Тогда
			КонтрольныеПоля.Добавить("Подразделение");
			
		ИначеЕсли КонтрольноеПоле = 3 Тогда
			КонтрольныеПоля.Добавить("Контрагент");
			
		ИначеЕсли КонтрольноеПоле = 4 Тогда
			КонтрольныеПоля.Добавить("Договор");
			
		ИначеЕсли КонтрольноеПоле = 5 Тогда
			КонтрольныеПоля.Добавить("Номенклатура");
			
		ИначеЕсли КонтрольноеПоле = 6 Тогда
			КонтрольныеПоля.Добавить("ИФО");
			
		ИначеЕсли КонтрольноеПоле = 7 Тогда
			КонтрольныеПоля.Добавить("КФО");
			
		ИначеЕсли КонтрольноеПоле = 8 Тогда
			КонтрольныеПоля.Добавить("Всего");
			
		ИначеЕсли КонтрольноеПоле = 9 Тогда
			КонтрольныеПоля.Добавить("Сумма НДС");
		
		КонецЕсли;
		
	КонецЦикла;
	
	Ошибка = "";
	
	КоличествоОшибок = 0;
	
	Если СчетФактураПомеченНаУдаление Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Сч.-ф. помечен на удаление";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	ИначеЕсли СчетФактураНеПроведен Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Сч.-ф. не проведен";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	КонецЕсли;
	
	Если ОтсутствуетНачисление Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Отсутствует начисление";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	Иначе
		
		Если НесколькоСчетовФактур Тогда
			Ошибка = Ошибка
				+ ?(Ошибка = "", "", "; ")
				+ "Обнаружено несколько сч.-ф." + "(" + Формат(КоличествоСчетовФактур, "ЧГ=0") + ")";
			
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
		КонтрольныеПоляКоличество = КонтрольныеПоля.Количество();
		
		Если КонтрольныеПоляКоличество > 0 Тогда
			Ошибка = Ошибка
				+ ?(Ошибка = "", "", "; ")
				+ "Различаются поля: " + СтрСоединить(КонтрольныеПоля, ",");
			
			КоличествоОшибок = КоличествоОшибок + КонтрольныеПоляКоличество;
				
		КонецЕсли;
	КонецЕсли;
	
	КоличествоОшибокПредставление = ?(КоличествоОшибок > 1, "(" + Формат(КоличествоОшибок, "ЧГ=0") + ") ", "");
	
	Ошибка = КоличествоОшибокПредставление + Ошибка;
	
	СтрокаТаблицы["Ошибка"] = Ошибка;
	
	// Если единственной ошибкой является наличие нескольких сч.-ф.
	// (но при этом сам текущий сч.-ф. ошибок не имеет),
	// то такой сч.-ф. не выделяем оформлением в списке
	ВыделитьСчетФактуру = ОтсутствуетНачисление
		ИЛИ СчетФактураНеПроведен
		ИЛИ КонтрольныеПоляКоличество > 0;
	
	СтрокаТаблицы["ВыделитьСчетФактуру"] = ВыделитьСчетФактуру;
	
КонецПроцедуры

Процедура УстановитьДействие(СтрокаТаблицы, МодифицироватьСуществующиеСФ, НомерПредыдущийСтрокиНачисления)
	
	КоличествоСчетовФактур			= СтрокаТаблицы["КоличествоСчетовФактур"];
	ОтсутствуетНачисление			= СтрокаТаблицы["ОтсутствуетНачисление"];
	СчетФактураПомеченНаУдаление	= ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И СтрокаТаблицы["СчетФактураПометкаУдаления"];
	
	Если КоличествоСчетовФактур = 0 И НЕ ОтсутствуетНачисление Тогда
		// Создать счет-фактуру
		Действие = 1;
		
	Иначе
		// Ничего не делать со счетом-фактурой
		Действие = 0;
		
	КонецЕсли;
	
	//	КАК ДопустимоИзменитьСчетФактуру
	
	Если ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И МодифицироватьСуществующиеСФ И НЕ СчетФактураПомеченНаУдаление Тогда
		
		ОшибкаКонтрольныхПолей				= (СтрокаТаблицы["ОшибкаКонтрольныхПолей"] > 0);
		СчетФактураНеПроведен				= (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И НЕ СтрокаТаблицы["СчетФактураПроведен"]);
		
		ЭтоПерваяСтрокаНачисления = (НЕ ОтсутствуетНачисление И НомерПредыдущийСтрокиНачисления <> СтрокаТаблицы["НомерСтрокиНачисления"]);
		
		Если ЭтоПерваяСтрокаНачисления Тогда
			// Создание или изменение сч.-ф. предполагается лишь в первой строке начисления
			
			Если ОшибкаКонтрольныхПолей ИЛИ СчетФактураНеПроведен Тогда
				// Изменить (обновить) счет-фактуру
				Действие = 2;
				
			Иначе
				// Ничего не делать со счетом-фактурой
				Действие = 0;
				
			КонецЕсли;
			
		Иначе
			// Удалить счет-фактуру
			Действие = 3;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаТаблицы["Действие"] = Действие;
	
КонецПроцедуры	

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение нового реквизита ТипПериода значением 1 ("На дату") в документах с заполненным документом-основанием
	// (тип ДокументСсылка.ПрекращениеПравПользованияОС), которые были введены ранее.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачислениеАмортизацииПравПользованияОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС КАК НачислениеАмортизацииПравПользованияОС
	|ГДЕ
	|	НачислениеАмортизацииПравПользованияОС.ДокументОснование ССЫЛКА Документ.ПрекращениеПравПользованияОС
	|	И НачислениеАмортизацииПравПользованияОС.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ПрекращениеПравПользованияОС.ПустаяСсылка)
	|	И НачислениеАмортизацииПравПользованияОС.ТипПериода = 0";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.НачислениеАмортизацииПравПользованияОС";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ТипПериода = 1; // На дату.
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
