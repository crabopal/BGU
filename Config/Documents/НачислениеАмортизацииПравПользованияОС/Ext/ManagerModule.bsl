	|			&СчетВычетКтКРаспределению
	|		КОГДА Начисления.ПринятьНДСКВычету ТОГДА
	|			&СчетВычетКтБезРаспределения
	|	КОНЕЦ									КАК СчетВычетКт,
	|	Начисления.КПСРасходов					КАК КПСВычетКт,
	|	
	|	&Счет30304								КАК Счет30304,
	|	&КПС30304								КАК КПС30304,
	|	
	|	&Счет30224								КАК СчетРасчетов,
	|	Начисления.КПСРасходов					КАК КПССчетРасчетов,
	|	
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)	КАК ПричинаНалогообложения,
	|	""06""									КАК КодВидаОперации
	|ИЗ
	|	Начисления
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаДействий
	|		ПО	Начисления.НомерСтроки = ТаблицаДействий.НомерСтрокиНачисления
	|ГДЕ
	|	НЕ ТаблицаДействий.ЭтоСчетФактураПолученный
	|	И (ТаблицаДействий.Действие = &ДействиеСоздать
	|		ИЛИ ТаблицаДействий.Действие = &ДействиеИзменить)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для заполнения счетов-фактур ПОЛУЧЕННЫХ. Как создаваемых, так и изменяемых
	|//
	|ВЫБРАТЬ
	|	ТаблицаДействий.СчетФактура									КАК СчетФактураСсылка,
	|	
	|	Начисления.Организация										КАК Организация,
	|	Начисления.Ссылка											КАК ДокументОснование,
	|	Начисления.ИФО												КАК ИФО,
	|	Начисления.Подразделение									КАК Подразделение,
	|	Начисления.Контрагент										КАК Контрагент,
	|	Начисления.Договор											КАК Договор,
	|	Начисления.КФО												КАК КФО,
	|	Начисления.ОсновноеСредство									КАК НФА,
	|	1															КАК Количество,
	|	&ЕдИзмШт													КАК ЕдиницаИзмерения,
	|	Начисления.СтавкаНДС										КАК СтавкаНДС,
	|	Начисления.Всего - Начисления.СуммаНДС						КАК Цена,
	|	Начисления.Всего - Начисления.СуммаНДС						КАК Сумма,
	|	Начисления.Всего											КАК Всего,
	|	Начисления.СуммаНДС 										КАК СуммаНДС,
	|	Начисления.ПринятьНДСКВычету								КАК НДСКВычету,
	|	Начисления.НДСКРаспределению								КАК НДСКРаспределению,
	|	
	|	ВЫБОР
	|		КОГДА Начисления.ПринятьНДСКВычету И Начисления.НДСКРаспределению ТОГДА
	|			&СчетВычетКтКРаспределению
	|		КОГДА Начисления.ПринятьНДСКВычету ТОГДА
	|			&СчетВычетКтБезРаспределения
	|	КОНЕЦ														КАК СчетВычетКт,
	|	Начисления.КПСРасходов										КАК КПСВычетКт,
	|	
	|	&Счет30224													КАК СчетРасчетов,
	|	
	|	&Счет30304													КАК Счет30304,
	|	&КПС30304Полученный											КАК КПС30304,
	|	
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)	КАК ПричинаНалогообложения,
	|	""01""														КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)				КАК ВидЦенности
	|ИЗ
	|	Начисления
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаДействий
	|		ПО	Начисления.НомерСтроки = ТаблицаДействий.НомерСтрокиНачисления
	|ГДЕ
	|	ТаблицаДействий.ЭтоСчетФактураПолученный
	|	И (ТаблицаДействий.Действие = &ДействиеСоздать
	|		ИЛИ ТаблицаДействий.Действие = &ДействиеИзменить)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Удаляемые счета-фактуры
	|//
	|ВЫБРАТЬ
	|	СчетФактура	КАК СчетФактураСсылка
	|ИЗ
	|	ТаблицаДействий
	|ГДЕ
	|	Действие = &ДействиеУдалить
	|	И НЕ СчетФактура В (
	|		ВЫБРАТЬ
	|			СчетФактура
	|		ИЗ
	|			ТаблицаДействий
	|		ГДЕ
	|			ТаблицаДействий.Действие = &ДействиеСоздать
	|			ИЛИ ТаблицаДействий.Действие = &ДействиеИзменить
	|	)
	|;";
	
	РеквизитыТиповойОперацииВыданный = Новый Структура();
	РеквизитыТиповойОперацииВыданный.Вставить("Курс",		1);
	РеквизитыТиповойОперацииВыданный.Вставить("Кратность",	1);
	
	РеквизитыТиповойОперацииПолученный = Новый Структура();
	РеквизитыТиповойОперацииПолученный.Вставить("Курс",			1);
	РеквизитыТиповойОперацииПолученный.Вставить("Кратность",	1);
	РеквизитыТиповойОперацииПолученный.Вставить("КПС_30304",	ФормаУправленияСчетамиФактурами["КПС30304Полученный"]);
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатыЗапроса = ЗапросДанные.ВыполнитьПакет();
		
		// [2]. Данные для заполнения счетов-фактур ВЫДАННЫХ. Как создаваемых, так и изменяемых
		Выборка = РезультатыЗапроса[2].Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка["СчетФактураСсылка"]) Тогда
				ДокументОбъект = Выборка["СчетФактураСсылка"].ПолучитьОбъект();
				
				ДокументОбъект.СоставНФА.Очистить();
			Иначе
				ДокументОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
			КонецЕсли;
			
			// Шапка
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("Руководитель",		РуководительСсылка);
			ЗначенияПараметров.Вставить("ГлавныйБухгалтер",	ГлавныйБухгалтерСсылка);
			ЗначенияПараметров.Вставить("Дата",				ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("ДатаВыставления",	ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("Выставлен",		Истина);
			ЗначенияПараметров.Вставить("ВалютаДокумента",	ВалютаРУ);
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияПараметров);
			
			// Табличная часть
			НоваяСтрока = ДокументОбъект.СоставНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			// Типовая операция
			БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
				ДокументОбъект,
				ФормаУправленияСчетамиФактурами["ТиповаяОперацияСФ"],
				РеквизитыТиповойОперацииВыданный);
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
		КонецЦикла;
		
		// [3]. Данные для заполнения счетов-фактур ПОЛУЧЕННЫХ. Как создаваемых, так и изменяемых
		Выборка = РезультатыЗапроса[3].Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка["СчетФактураСсылка"]) Тогда
				ДокументОбъект = Выборка["СчетФактураСсылка"].ПолучитьОбъект();
				
				ДокументОбъект.СоставНФА.Очистить();
				ДокументОбъект.ДокументыОснования.Очистить();
			Иначе
				ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
			КонецЕсли;
			
			// Шапка
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("Дата",						ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("ДатаПервичногоДокумента",	ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("ВалютаДокумента",			ВалютаРУ);
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияПараметров);
			
			// Табличные части
			НоваяСтрока = ДокументОбъект.СоставНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			НоваяСтрока = ДокументОбъект.ДокументыОснования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			// Типовая операция
			
			БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
				ДокументОбъект,
				ФормаУправленияСчетамиФактурами["ТиповаяОперацияСФПолученный"],
				РеквизитыТиповойОперацииПолученный);
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
		КонецЦикла;
		
		// [4]. Удаляемые счета-фактуры
		Выборка = РезультатыЗапроса[4].Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка["СчетФактураСсылка"].ПолучитьОбъект();
			
			ДокументОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = НСтр("ru = 'Не удалось создать/обновить счет-фактуру по причине: '");
		ТекстОшибкиКраткий = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибкиПолный = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиКраткий);
		
		ОбъектМетаданных = ?(ДокументОбъект <> Неопределено, ДокументОбъект.Метаданные(), Неопределено);
		
		ЗаписьЖурналаРегистрации("Данные.Изменение",
			УровеньЖурналаРегистрации.Ошибка,
			ОбъектМетаданных,
			Неопределено,
			ТекстОшибкиПолный);
			
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТаблицуУправлениеСчетамиФактурамиИПечать(ДокументСсылка, МодифицироватьСуществующиеСФ, НастройкиОтбораСтрокДокументаОснования) Экспорт
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("ДокументОснованиеСсылка",				ДокументСсылка);
	ЗапросТаблица.УстановитьПараметр("ДокументОснованиеОрганизация",		Организация);
	ЗапросТаблица.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросТаблица.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросТаблица.УстановитьПараметр("ВидОтбораСтрок",						НастройкиОтбораСтрокДокументаОснования.ВидОтбораСтрок);
	ЗапросТаблица.УстановитьПараметр("СтавкиНДС",							НастройкиОтбораСтрокДокументаОснования.ОтмеченныеСтавкиНДС);
	
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица всех начислений из документа-основания
	|//
	|ВЫБРАТЬ
	|	&ДокументОснованиеОрганизация	КАК Организация,
	|	НомерСтроки						КАК НомерСтроки,
	|	Подразделение					КАК Подразделение,
	|	Контрагент						КАК Контрагент,
	|	ОсновноеСредство				КАК Номенклатура,
	|	Договор							КАК Договор,
	|	ИФО								КАК ИФО,
	|	КФО								КАК КФО,
	|	ВЫБОР
	|		КОГДА ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование) ТОГДА
	|			ВсегоСправедливая
	|		ИНАЧЕ
	|			Всего
	|	КОНЕЦ							КАК Всего,
	|	ВЫБОР
	|		КОГДА ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование) ТОГДА
	|			СуммаНДССправедливая
	|		ИНАЧЕ
	|			СуммаНДС
	|	КОНЕЦ							КАК СуммаНДС,
	|	(Договор.ТипДоговораНДС <> ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор))	КАК ОжидаетсяСчетФактураПолученный
	|ПОМЕСТИТЬ
	|	Начисления
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС.ПраваПользования
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|	И ВЫБОР
	|		КОГДА &ВидОтбораСтрок = 0 ТОГДА // 0 - без отбора
	|			ИСТИНА
	|		КОГДА &ВидОтбораСтрок = 1 ТОГДА // 1 - выделен налог
	|			ВЫБОР
	|				КОГДА ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование) ТОГДА
	|					СуммаНДССправедливая <> 0
	|				ИНАЧЕ
	|					СуммаНДС <> 0
	|			КОНЕЦ
	|		КОГДА &ВидОтбораСтрок = 2 ТОГДА // 2 - указана ставка
	|			(СтавкаНДС В (&СтавкиНДС))
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже существующие документы счетов-фактур
	|//
	|ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка								КАК Ссылка,
	|	СчетФактураВыданный.Проведен							КАК Проведен,
	|	СчетФактураВыданный.ПометкаУдаления						КАК ПометкаУдаления,
	|	СчетФактураВыданный.СуммаДокумента						КАК СуммаДокумента,
	|	СчетФактураВыданный.СуммаНДС							КАК СуммаНДС,
	|	СчетФактураВыданный.Организация							КАК Организация,
	|	СчетФактураВыданный.Подразделение						КАК Подразделение,
	|	СчетФактураВыданный.ИФО									КАК ИФО,
	|	СчетФактураВыданный.КФО									КАК КФО,
	|	СчетФактураВыданный.Контрагент							КАК Контрагент,
	|	СчетФактураВыданный.Договор								КАК Договор,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ТабличнаяЧасть.Ссылка), 0)			КАК КоличествоСтрокНФА,
	|	ВЫБОР
