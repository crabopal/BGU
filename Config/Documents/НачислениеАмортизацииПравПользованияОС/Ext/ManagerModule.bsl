Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Акт об оказании услуг / УПД");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);

	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

// Подготовить таблицу расчетов по документу для источника данных ТаблицаРасчетовСЗачетомАвансов.
// 
// Параметры:
//  Документ - ДокументОбъект.НачислениеАмортизацииПравПользованияОС
//  Параметры - Структура - Параметры 
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	ТаблицаРасчетов.Колонки.Добавить("СуммаРуб", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ПраваПользования",
		"ВидОперации,ИФО,КФО,КПС,Подразделение,ОсновноеСредство,СчетУчета,КЭКРасходов,
		|Контрагент,Договор,СчетРасчетов,КПСРасчетов,
		|Валюта,СуммаРасчетов,СуммаРасчетовВВалюте,СуммаНДС",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ПраваПользования.ВидОперации КАК ВидОперации,
	|	ПраваПользования.ИФО КАК ИФО,
	|	ПраваПользования.КФО КАК КФО,
	|	ПраваПользования.КПС КАК КПС,
	|	ПраваПользования.Подразделение КАК Подразделение,
	|	ПраваПользования.ОсновноеСредство КАК ОсновноеСредство,
	|	ПраваПользования.СчетУчета КАК СчетУчета,
	|	ПраваПользования.Контрагент КАК Контрагент,
	|	ПраваПользования.Договор КАК Договор,
	|	ПраваПользования.СчетРасчетов КАК СчетРасчетов,
	|	ПраваПользования.КПСРасчетов КАК КПСРасчетов,
	|	ПраваПользования.КЭКРасходов КАК КЭК,
	|	ПраваПользования.Валюта КАК Валюта,
	|	ПраваПользования.СуммаРасчетовВВалюте КАК СуммаРасчетовВВалюте,
	|	ПраваПользования.СуммаРасчетов КАК СуммаРасчетов,
	|	ПраваПользования.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ТаблицаПраваПользования КАК ПраваПользования
	|ГДЕ
	|	ПраваПользования.СуммаРасчетов <> 0
	|	И ПраваПользования.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование)";
	Запрос.УстановитьПараметр("ГраницаСреза", КонецМесяца(Документ.Дата));
	Запрос.УстановитьПараметр("Организация",  Документ.Организация);
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПраваПользования.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	Если Параметры.ПоВсемКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПраваПользования.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПараметрыАмортизацииПравПользованияСрезПоследних.КПСРасчетов",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РасчетыПоАренднойПлате = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДокумента Из РасчетыПоАренднойПлате Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		НоваяСтрока.ЭтоПоступление = Истина;
		
		НоваяСтрока.КПС = ?(ЗначениеЗаполнено(СтрокаДокумента.КПСРасчетов),
			СтрокаДокумента.КПСРасчетов, СтрокаДокумента.КПС);
		
		Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(НоваяСтрока.Валюта) И НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
			НоваяСтрока.СуммаРасчетов = СтрокаДокумента.СуммаРасчетовВВалюте;
			НоваяСтрока.СуммаРуб      = СтрокаДокумента.СуммаРасчетов;
		Иначе // В валюте регламентированного учета (RUB).
			НоваяСтрока.СуммаРасчетов = СтрокаДокумента.СуммаРасчетов;
			НоваяСтрока.СуммаРуб      = СтрокаДокумента.СуммаРасчетов;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

