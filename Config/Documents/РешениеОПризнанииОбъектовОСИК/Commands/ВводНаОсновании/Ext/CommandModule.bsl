
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	//ПараметрыФормы = Новый Структура("РежимВводНаОсновании, ДокументОснование, ВидСоздаваемогоДокумента", 
	//	Истина, ПараметрКоманды, ВидДокумента());
		
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.РеконструкцияИК") Тогда
		ПараметрыФормы = Новый Структура("Основание", ПараметрКоманды);
		ОткрытьФорму("Документ.РешениеОПризнанииОбъектовОСИК.ФормаОбъекта", ПараметрыФормы);
	Иначе	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВводНаОсновании", Истина);
		ПараметрыФормы.Вставить("ДокументОснование", ПараметрКоманды);
		ПараметрыФормы.Вставить("ВидСоздаваемогоДокумента", ВидДокумента());
		ПараметрыФормы.Вставить("НеСоздаватьДокументы", Ложь);
		ПараметрыФормы.Вставить("ИмуществоКазны", Истина);
		ПараметрыФормы.Вставить("ВидИмущества",);
		ПараметрыФормы.Вставить("ВидНФА",);
	
		ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ГрупповойВвод", 
			ПараметрыФормы,, ПараметрыВыполненияКоманды.Источник.УникальныйИдентификатор);
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВидДокумента()
	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК"));
КонецФункции	

#КонецОбласти