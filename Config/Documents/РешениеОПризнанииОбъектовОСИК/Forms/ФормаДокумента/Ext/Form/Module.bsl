	ИндикаторКворумаПрисутствияКлиентСервер.ОбновитьИндикатор(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииОтсутствуетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	Если Не ТекущиеДанные.Отсутствует Тогда
		ТекущиеДанные.ПричинаОтсутствия = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииПричинаОтсутствияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	ТекущиеДанные.Отсутствует = Не ПустаяСтрока(ТекущиеДанные.ПричинаОтсутствия);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииПричинаОтсутствияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ОткрытьФорму("Справочник.ПричиныОтсутствияСотрудников.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборОС(Команда)
	
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборВложений(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтаФорма, Объект, ПараметрыПодбораКапвложения());
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВложений(Команда)
	
	Перем Ошибки;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма, Ошибки) Тогда
		РассчитатьСуммуВложенийНаСервере();
		ПересчитатьСтрокиТЧ_ОсновныеСредства(ЭтотОбъект);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповойВвод(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВызовИзДокумента"				, Истина);
	ПараметрыФормы.Вставить("Организация"					, Объект.Организация);
	ПараметрыФормы.Вставить("ПервоначальнаяСтоимость"		, ПервоначальнаяСтоимостьЕдиницы);
	ПараметрыФормы.Вставить("КоличествоСоздаваемыхОбъектов"	, Объект.КоличествоВложений);
	ПараметрыФормы.Вставить("СчетУчета"						, Объект.СчетУчета);
	ПараметрыФормы.Вставить("КФО"							, Объект.КФО);
	ПараметрыФормы.Вставить("КПС"							, Неопределено);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ГрупповойВвод", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписокДМДляОбъекта(Команда)
	
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект НФА!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе
		Если Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Количество() = 1 Тогда
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМ(ЭтаФорма, Объект,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ОсновноеСредство,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ИнвентарныйНомер,
			Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Количество, "Изделия");
			
			ЭтаФорма.ВариантВводаДанныхДМ = 1;
		Иначе
			МассивВыделенныеСтроки = Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки;
			
			АдресТаблицыОбъектовНФА = ПоместитьТаблицуОбъектовНФАДляДМВХранилище(МассивВыделенныеСтроки);
			
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМДляПеречняОбъектов(ЭтаФорма, Объект,
				АдресТаблицыОбъектовНФА, "Изделия");
			
			ЭтаФорма.ВариантВводаДанныхДМ = 2;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

