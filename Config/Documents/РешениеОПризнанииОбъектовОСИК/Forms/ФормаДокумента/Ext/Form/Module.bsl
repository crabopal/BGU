Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтотОбъект, Команда);

КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперации()
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0)И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе	
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);
	
	ТаблицаНФА = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок,
		"ОсновноеСредство, ИнвентарныйНомер, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЕдИзм");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНФА);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОсновноеСредство", ПараметрыПодбора.ОбъектНФА);
	ПараметрыОтбора.Вставить("ИнвентарныйНомер", ПараметрыПодбора.ИнвНомер);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеСтроки;
	
КонецФункции

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение, ВариантВводаДанныхДМ = 1)
	
	Если ВариантВводаДанныхДМ = 2 Тогда
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъектов(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, "ОсновноеСредство", "ОсновноеСредство,ИнвентарныйНомер,ВидДрагМатериала");
	Иначе
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, "ОсновноеСредство", "ОсновноеСредство,ИнвентарныйНомер,ВидДрагМатериала");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	
	Для Каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство, ИнвентарныйНомер, Количество");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		НоваяСтрока = ТаблицаОбъектовОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер);
	КонецЦикла;
	
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаОбъектовОС, "ОС");
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = ЭтаФорма.ОбъектыНФАСДрагМатериалами.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.ОсновноеСредство;
		НоваяСтрока.ИнвНомер = СтрокаТЧ.ИнвентарныйНомер;
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);
	
КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДрагМатериалыОбъектаПоТехДокументации(ВыбранныйОбъектНФА, ОбъектНФА, ИнвНомер, Количество)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.МассаДМ * &Количество) КАК МассаДМ,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.КоличествоДМ * &Количество) КАК КоличествоДМ,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм КАК ЕдИзм
	               |ИЗ
	               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.ДрагМатериалы КАК ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы
	               |ГДЕ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм";

	Запрос.УстановитьПараметр("Ссылка", ВыбранныйОбъектНФА);
	Запрос.УстановитьПараметр("Количество", Количество);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ОсновноеСредство = ОбъектНФА;
		НоваяСтрока.ИнвентарныйНомер = ИнвНомер;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДрагМатериалыПоТехДокументацииНаСервере()
	ТаблицаНФА = ОбъектыНФАСДрагМатериалами.Выгрузить();
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументации(ТаблицаНФА, "ОС");
	Объект.ДрагоценныеМатериалы.Загрузить(ТаблицаНФА);
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуСведенийОСодержанииДрагМатериаловПоТехДокументации(ОбъектНФА, ТехДокументация)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(ТехДокументация) Тогда
		ПараметрыФормы.Вставить("Ключ", ТехДокументация);
	Иначе
		ПараметрыФормы.Вставить("ОбъектНФА", ОбъектНФА);
	КонецЕсли;	
	ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПроверитьКоличествоПринятихКУчетуДрагМатериаловКапвложения(Отказ)
	
	ПринимаемыеДрагМатериалы = Объект.ДрагоценныеМатериалы.Выгрузить(,"ВидДрагМатериала,МассаДМ,КоличествоДМ");
	ПринимаемыеДрагМатериалы.Свернуть("ВидДрагМатериала","МассаДМ,КоличествоДМ");
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ДрагМатериалыКапвложения = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Объект.КапитальноеВложение, ТаблицаСписанияОбъектов, ПериодОстатков);		
	  
	Для Каждого Строка Из ПринимаемыеДрагМатериалы Цикл
			
		НайденнаяСтрока = ДрагМатериалыКапвложения.Найти(Строка.ВидДрагМатериала,"ВидДрагМатериала");
		
		Если НайденнаяСтрока = Неопределено ИЛИ НайденнаяСтрока.МассаДМ <> Строка.МассаДМ 
					ИЛИ Строка.КоличествоДМ <> НайденнаяСтрока.КоличествоДМ Тогда
					
			ТекстОшибки = СтрШаблон(Нстр("ru='Количество принимаемого к учету ""%1"" не совпадает с количеством ""%1"" в материальных ценностях капитального вложения.'"),
				Строка.ВидДрагМатериала);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ДрагоценныеМатериалы");		
					
			Если Не Отказ Тогда		
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМЦКапвложенияСДрагМатериалами(ПерезаполнитьТЧ = Ложь)
	
	Если ПерезаполнитьТЧ Тогда
		Объект.МЦСДрагоценнымиМатериалами.Очистить();	
	КонецЕсли;
	
	Если Объект.МЦСДрагоценнымиМатериалами.Количество() = 0
						И ВедетсяУчетДрагМатериаловВКапвожениях Тогда
		
		ТаблицаОбъектовОС = УчетДрагМатериалов.ПолучитьСписокОстатковМЦ(Объект.Дата, Объект.Организация, Объект.КапитальноеВложение);
		ТаблицаОбъектовОС.Колонки.КоличествоОстаток.Имя = "Количество";
		ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
		
		Для Каждого ТекСтрока Из ТаблицаОбъектовОС Цикл
			ТекСтрока.КоличествоВсего = ТекСтрока.Количество;
		КонецЦикла;

		Объект.МЦСДрагоценнымиМатериалами.Загрузить(ТаблицаОбъектовОС);
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере(ВыбранныйОбъектНФА)
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Капвложение = Объект.КапитальноеВложение;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА)
	
	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Капвложение, ТаблицаСписанияОбъектов, ПериодОстатков);		
	
	ОсновноеСредство = ВыбранныйОбъектНФА.ОсновноеСредство;
	ИнвентарныйНомер = ВыбранныйОбъектНФА.ИнвентарныйНомер;
	
	Если ОстаткиДМ.Количество() > 0 Тогда
		Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
		Для Каждого Строка Из Объект.ДрагоценныеМатериалы Цикл  
			Строка.ОсновноеСредство = ОсновноеСредство;
			Строка.ИнвентарныйНомер = ИнвентарныйНомер; 
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтаФорма);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете()
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = "ПорядокПогашенияСтоимости"
		+ ",СпособНачисленияАмортизации"
		+ ",СрокПолезногоИспользования"
		//+ ",ПринятиеКУчетуОдновременноСВводомВЭксплуатацию"
		+ ",СчетУчетаЗатрат"
		+ ",КЭКЗатрат"
		+ ",КПСЗатрат"
		+ ",ПодразделениеЗатрат"
		+ ",СубконтоЗатрат1"
		+ ",СубконтоЗатрат2"
		+ ",СубконтоЗатрат3"
		+ ",КоэффициентУскорения"
		+ ",ПараметрВыработки"
		+ ",ПредполагаемыйОбъемВыработки";
	
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ДанныеТекущейСтроки.Вставить("СчетУчетаОС", Объект.СчетУчета);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыТекущейСтроки = Новый Структура;
	ПараметрыТекущейСтроки.Вставить("СписокРеквизитовСтрокиДокумента"		, ИменаРеквизитов);
	ПараметрыТекущейСтроки.Вставить("ОсновноеСредство"						, ТекущиеДанные.ОсновноеСредство);
	ПараметрыТекущейСтроки.Вставить("ИнвентарныйНомер"						, ТекущиеДанные.ИнвентарныйНомер);
	ПараметрыТекущейСтроки.Вставить("ПараметрыСтроки"						, ДанныеТекущейСтроки);
	ПараметрыТекущейСтроки.Вставить("ИспользоватьУчетПоПодразделениям"		, ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям);
	ПараметрыТекущейСтроки.Вставить("Дата"									, Объект.Дата);
	ПараметрыТекущейСтроки.Вставить("Организация"							, Объект.Организация);
	ПараметрыТекущейСтроки.Вставить("ИФО"									, Объект.ИФО);
	ПараметрыТекущейСтроки.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат"	, Истина);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВНалоговомУчете", Ложь);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыТекущейСтроки.Вставить("ИмуществоКазны", Истина);
	
	ОткрытьФорму("Документ.ПринятиеКУчетуОбъектовОС.Форма.ФормаНастройкаОтраженияВУчете",
		ПараметрыТекущейСтроки,
		ЭтотОбъект,,,,Новый ОписаниеОповещения("ОкончаниеНастройкиОтраженияВУчете", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеНастройкиОтраженияВУчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТолькоПросмотр = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Для Каждого ИдентификаторСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если ТекущиеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
				УстановитьОставшийсяСрокИспользования(ТекущиеДанные);
			КонецЕсли;
			
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
			
			УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные);
			
		КонецЦикла;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущаяСтрока, Форма);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущаяСтрока, Форма)
	
	Если ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Стоимость не погашается'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Списание при вводе в эксплуатацию'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Если ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации линейным методом'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление 100% амортизации при вводе в эксплуатацию'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации методом уменьшаемого остатка'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации пропорционально объему продукции (работ)'");
		Иначе
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации'");
		КонецЕсли;
	Иначе
		ПогашениеСтоимостиБУ = НСтр("ru = '<...>'");
	КонецЕсли;
	
	ШаблонСтроки = НСтр("ru = '%1'");
	
	ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСтроки, ПогашениеСтоимостиБУ);
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКапитальногоВложенияСервер()
	
	ДанныеОбъектаВложений = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.КапитальноеВложение, Объект.Ссылка);
	Объект.СчетВложений = ДанныеОбъектаВложений.СчетВложений;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма) Тогда
		РассчитатьСуммуВложенийНаСервере();
	КонецЕсли;
	УстановитьЕстьПрослеживаемыеТовары();
	Для каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
	
	СтрокаДокумента.ПрослеживаемыйТовар = ЕстьПрослеживаемыеТовары;
	
	КонецЦикла;
	ЗаполнитьМЦКапвложенияСДрагМатериалами(Истина);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьНаличиеДоговораУСчетаУчета()

	ЕстьДоговорУСчетаУчета = ?(ЗначениеЗаполнено(Объект.СчетУчета),
		БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.Договоры),
		Ложь);

КонецПроцедуры

&НаСервере
Процедура ОпределитьНаличиеДоговораВложения()
	
	Элементы.КапитальныеВложенияДоговор.Видимость = ?(ЗначениеЗаполнено(Объект.СчетВложений),
		БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетВложений, ПланыВидовХарактеристик.ВидыСубконто.Договоры),
		Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьЦенуЕдиницыВложений(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ПервоначальнаяСтоимостьЕдиницы = Объект.СуммаВложений /
		?(Объект.КоличествоВложений = 0, 1, Объект.КоличествоВложений);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыТекущейСтроки(ТекущиеДанные, Форма)
	Объект = Форма.Объект;
	
	Если Объект.КоличествоВложений <> 0 И ТекущиеДанные.Количество = Объект.КоличествоВложений Тогда
		ТекущиеДанные.Сумма            = Объект.СуммаВложений;
		ТекущиеДанные.СуммаАмортизации = Объект.СуммаАмортизацииВложений;
		ТекущиеДанные.СуммаОбесценения = Объект.СуммаОбесцененияВложений;
	ИначеЕсли Объект.КоличествоВложений <> 0 Тогда
		ТекущиеДанные.Сумма            = ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницы;
		ТекущиеДанные.СуммаАмортизации = ТекущиеДанные.Количество * Объект.СуммаАмортизацииВложений / Объект.КоличествоВложений;
		ТекущиеДанные.СуммаОбесценения = ТекущиеДанные.Количество * Объект.СуммаОбесцененияВложений / Объект.КоличествоВложений;
	Иначе
		Если Объект.ОсновныеСредства.Количество() = 1 Тогда
			ТекущиеДанные.Сумма = Объект.СуммаВложений;
		КонецЕсли;	
		ТекущиеДанные.СуммаАмортизации = 0;
		ТекущиеДанные.СуммаОбесценения = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьСуммыВложений()
	
	Объект.СуммаВложений				= 0;
	Объект.КоличествоВложений			= 0;
	
	ПервоначальнаяСтоимостьЕдиницы		= 0;
	
	Объект.КапитальныеВложения.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки, ДанныеОС = Неопределено)
	
	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокПолезногоИспользования) Тогда
		УстановитьСрокПолезногоИспользования(ТекущаяСтрока);
	КонецЕсли;
	
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущаяСтрока);
	
	Если ДанныеОС <> Неопределено Тогда
		СтрокаОС = ДанныеОС.Найти(ТекущаяСтрока.ОсновноеСредство, "ОсновноеСредство");
		ДанныеОбъектаОС = СтрокаОС;
	Иначе	
		ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекущаяСтрока.ОсновноеСредство, Объект.Ссылка);
	КонецЕсли;	

	ТекущаяСтрока.ПрослеживаемыйТовар = ЕстьПрослеживаемыеТовары;
	ТекущаяСтрока.СтранаПроисхождения = ДанныеОбъектаОС.СтранаПроисхождения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	ПрослеживаемостьБГУ.УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)

	ВидимостьПрослеживаемыйТовар = Ложь;
	ВидимостьСтранаПроисхождения = Ложь;
	ВидимостьРНПТ = Ложь;
	Если Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ПоДокументуВозможенУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары Тогда
		ВидимостьПрослеживаемыйТовар = Истина;
		ВидимостьСтранаПроисхождения = Истина;
		ВидимостьРНПТ = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПрослеживаемыйТовар",
		"Видимость", ВидимостьПрослеживаемыйТовар);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваПрослеживаемыйТовар",
		"Видимость", ВидимостьПрослеживаемыйТовар);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваСтранаПроисхождения",
		"Видимость", ВидимостьСтранаПроисхождения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваРНПТ",
		"Видимость", ВидимостьРНПТ);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПоДокументуВозможенУчетПрослеживаемыхТоваров(Форма)

	Форма.ПоДокументуВозможенУчетПрослеживаемыхТоваров = Истина;

КонецПроцедуры

&НаСервере
Функция УстановитьЕстьПрослеживаемыеТовары()

	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.КапитальноеВложение, Объект);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(Форма, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("КапитальноеВложение", "Объект вложений");
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыДляПроверки, Объект, Ложь, Ошибки);
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура УстановитьСрокПолезногоИспользования(ТекущаяСтрока)
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "АмортизационнаяГруппа"));
	
	Если Не ЗначениеЗаполнено(СрокПолезногоИспользования) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация") Тогда
		ТекущаяСтрока.ОставшийсяСрокПолезногоИспользования = ТекущаяСтрока.СрокПолезногоИспользования;
		ТекущаяСтрока.ФактическийСрокЭксплуатации = 0;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРекомедуемыеОтражениеВУчетеВСтроке(Форма, ТекущаяСтрока)
	
	Если ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0 И ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
	
		ДанныеРасчета = Новый Структура;
		ДанныеРасчета.Вставить("Дата", Форма.Объект.Дата);
		ДанныеРасчета.Вставить("СчетУчета", Форма.Объект.СчетУчета);
		ДанныеРасчета.Вставить("ОсновноеСредство", ТекущаяСтрока.ОсновноеСредство);
		ДанныеРасчета.Вставить("Сумма", ТекущаяСтрока.Сумма);
		ДанныеРасчета.Вставить("Количество", ТекущаяСтрока.Количество);
		ДанныеРасчета.Вставить("СрокПолезногоИспользования", ТекущаяСтрока.СрокПолезногоИспользования);
		ДанныеРасчета.Вставить("УчетнаяПолитика", Форма.КэшПараметров.УчетнаяПолитика);
		ДанныеРасчета.Вставить("ТипНФА", ТекущаяСтрока.ТипНФА);
		ДанныеРасчета.Вставить("ВидНФА", ТекущаяСтрока.ВидНФА);
		
		РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета);
		
		Если РекомендуемыйПорядок = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		
		ТекущаяСтрока.ПорядокПогашенияСтоимости = РекомендуемыйПорядок.ПорядокПогашенияСтоимости;
		ТекущаяСтрока.СпособНачисленияАмортизации = РекомендуемыйПорядок.СпособНачисленияАмортизации;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета)
	
	ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ДанныеРасчета.СчетУчета);
	НачислятьАмортизациюИмуществаКазны = ДанныеРасчета.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
	
	Результат = Неопределено;
	Если НЕ (ВидИмущества = Перечисления.ВидыИмущества.Казна И НЕ НачислятьАмортизациюИмуществаКазны) Тогда
		Результат = УправлениеОсновнымиСредствамиКлиентСервер.РекомендуемыйПорядокПогашенияСтоимости(
			ДанныеРасчета.ВидНФА, ДанныеРасчета.ТипНФА,
			?(ДанныеРасчета.Количество = 0, 0, ДанныеРасчета.Сумма / ДанныеРасчета.Количество),
			ДанныеРасчета.Дата, ВидИмущества, ДанныеРасчета.СрокПолезногоИспользования);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	ДанныеРасчета = Новый Структура;
	ДанныеРасчета.Вставить("Дата", Форма.Объект.Дата);
	ДанныеРасчета.Вставить("СчетУчета", Форма.Объект.СчетУчета);
	ДанныеРасчета.Вставить("ОсновноеСредство", ТекущаяСтрока.ОсновноеСредство);
	ДанныеРасчета.Вставить("Сумма", ТекущаяСтрока.Сумма);
	ДанныеРасчета.Вставить("Количество", ТекущаяСтрока.Количество);
	ДанныеРасчета.Вставить("СрокПолезногоИспользования", ТекущаяСтрока.СрокПолезногоИспользования);
	ДанныеРасчета.Вставить("УчетнаяПолитика", Форма.КэшПараметров.УчетнаяПолитика);
	ДанныеРасчета.Вставить("ТипНФА", ТекущаяСтрока.ТипНФА);
	ДанныеРасчета.Вставить("ВидНФА", ТекущаяСтрока.ВидНФА);
	
	РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета);
	
	Если РекомендуемыйПорядок = Неопределено Тогда
		Возврат;
	ИначеЕсли РекомендуемыйПорядок.ПорядокПогашенияСтоимости = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости <> ТекущаяСтрока.ПорядокПогашенияСтоимости
		Или РекомендуемыйПорядок.ДопустимыеСпособыНачисленияАмортизации.Найти(
		ТекущаяСтрока.СпособНачисленияАмортизации) = Неопределено Тогда
		
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0;
		
		ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1].ОтражениеВУчетеЕстьОшибка",
			РекомендуемыйПорядок.ПояснениеУказанногоПорядка,"Объект.ОсновныеСредства",
			ИндексСтроки, РекомендуемыйПорядок.ПояснениеУказанногоПорядка);
	Иначе
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаГрупповогоВводаОССервер(ВыбранноеЗначение)
	
	ТаблицаСозданныхОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	ДобавленныеОС = ТаблицаСозданныхОС.ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеПрослеживаемостиОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДобавленныеОС, "ПрослеживаемыйТовар, СтранаПроисхождения");
	ПерваяДобавленнаяСтрока = Неопределено;
	Для Каждого Строка Из ТаблицаСозданныхОС Цикл
		Для каждого НовыйИнвНомер из Строка.ИнвентарныйНомер Цикл
			НоваяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "ИнвентарныйНомер");
			НоваяСтрока.ИнвентарныйНомер = НовыйИнвНомер;
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки
			НоваяСтрока.Сумма = Строка.ПервоначальнаяСтоимость;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.РезолюцияКомиссии = 
				УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовОС");
			
			ДанныеПрослеживаемости = ДанныеПрослеживаемостиОС.Получить(Строка.ОсновноеСредство);
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеПрослеживаемости);
			КонецЕсли;
			
			Если ПерваяДобавленнаяСтрока = Неопределено Тогда
				ПерваяДобавленнаяСтрока = НоваяСтрока;
			КонецЕсли;
			
			УстановитьСрокПолезногоИспользования(НоваяСтрока);
			УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, НоваяСтрока);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(НоваяСтрока);
		КонецЦикла;	
	КонецЦикла;
	
	УстановитьЕстьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОперацияСКапвложением(Форма)
	ТекОперация = Форма.Объект.ВидОперации;
	ТекФормироватьДвиженияПоМодернизации = Форма.Объект.ФормироватьДвиженияПоМодернизации;

	МассивОперацийКапвложений = Новый Массив;
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Изготовление"));
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Приобретение"));
	Возврат МассивОперацийКапвложений.Найти(ТекОперация) <> Неопределено
		ИЛИ ТекОперация = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация")
		И ТекФормироватьДвиженияПоМодернизации;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма)
	ВидимостьГруппы = ЭтоОперацияСКапвложением(Форма); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКарточкаКапвложений",
		"Видимость", ВидимостьГруппы);

	Если ВидимостьГруппы Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КарточкаКапвложений",
			"Видимость", Форма.Объект.ОтразитьВКарточкеКапвложений);
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные)
	
	ИндексТекСтроки = Объект.ОсновныеСредства.Индекс(ТекущиеДанные);
	УстановитьПараметрыСтрокиВоВсеСвязанныеСтрокиНаСервере(ИндексТекСтроки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтрокиНаСервере(ИндексТекСтроки)
	
	ТекущиеДанные = Объект.ОсновныеСредства.Получить(ИндексТекСтроки);
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл           
		Если ТекСтрока <> ТекущиеДанные
			И ТекСтрока.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство И ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
			
			ЗаполнитьСтрокуИзДругойСтроки(ТекСтрока, ТекущиеДанные);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуИзДругойСтроки(Получатель, Источник)
	
	ЗаполнитьЗначенияСвойств(Получатель, Источник, РеквизитыСтрокиТЧ());
		
КонецПроцедуры

// Формирует строку реквизитов, данные которых копируются в связанные строки
//
// Параметры:
//  Режим - Строка - определяет состав реквизитов. Возможные значения: БУ, НУ, УСН. 
//      Если не указан формирует строку для всех режимов
//
// Возвращаемое значение:
//  - Строка - строка имен реквизитов
&НаКлиентеНаСервереБезКонтекста    
Функция РеквизитыСтрокиТЧ()
	Результат = "Сумма," 
		+ "КПС,СрокПолезногоИспользования,ПорядокПогашенияСтоимости," 
		+ "СпособНачисленияАмортизации,СчетУчетаЗатрат," 
		+ "КПСЗатрат,КЭКЗатрат,ПодразделениеЗатрат,СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3," 
		+ "ОтражениеВУчете,НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку,"
		+ "НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ";
	
	Возврат Результат;
КонецФункции	

// Формирует строку реквизитов, данные которых копируются в связанные строки
//
// Параметры:
//  Режим - Строка - определяет состав реквизитов. Возможные значения: БУ, НУ, УСН. 
//      Если не указан формирует строку для всех режимов
//
// Возвращаемое значение:
//  - Структура - в качестве ключенй содержит имена реквизитов строки
&НаКлиентеНаСервереБезКонтекста    
Функция СтруктураРеквизитовСтрокиТЧ()
	Возврат(Новый Структура(РеквизитыСтрокиТЧ()));         
КонецФункции	     

// Проверяет равенство значений элементов структуры.
// По ключам структуры должны быть идентичны
//
// Параметры:
//  Структура1 - Структура
//  Структура2 - Структура
//
// Возвращаемое значение:
//  - Булево - Истна, если данные структур равны
&НаКлиентеНаСервереБезКонтекста    
Функция ДанныеСтруктурРавны(Структура1, Структура2)
	Результат = Истина;
	Для каждого Элемент1 из Структура1 Цикл
		Если Элемент1.Значение <> Структура2[Элемент1.Ключ] Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
		
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДаты()
	
	ЗаданаДатаВводаВЭксплуатацию = Ложь;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаВводаВЭксплуатацию) Тогда
			ЗаданаДатаВводаВЭксплуатацию = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗаданаДатаВводаВЭксплуатацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'В некоторых строках документа указана ""Дата ввода в эксплуатацию"".
                         |После изменения даты рекомендуется пересчитать оставшийся срок полезного использования
                         |в строках документа.
                         |Пересчитать оставшийся срок полезного использования?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение(РезультатВопроса,
	ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			УстановитьОставшийсяСрокИспользования(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОставшийсяСрокИспользования(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			ТекущиеДанные.ДатаВводаВЭксплуатацию,
			ТекущиеДанные.СрокПолезногоИспользования,
			Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении_Завершение(Результат, Параметры) Экспорт
	ВвестиНаОснованииПоступленияОС(Результат);
	ЗаполнитьСчетаУчетаНаименование(ЭтотОбъект);
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	Для каждого ТекущиеДанные из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные);
	КонецЦикла;	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(ЭтотОбъект);
	УстановитьДоступностьРедактированияСтрок(ЭтотОбъект);
КонецПроцедуры	 

&НаСервереБезКонтекста
Функция ВидДокумента()
	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК"));
КонецФункции	

&НаСервере
Процедура ВвестиНаОснованииПоступленияОС(ДанныеОснования)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РешениеОПризнанииОбъектовОСИК"));
	ТекОбъект.Заполнить(ДанныеОснования);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры	

&НаСервере
Процедура РассчитатьСтоимостиТЧ()
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков();
	ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;

	Модернизация = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация"));
	ПараметрыПолученияОстатков.ПолучатьАмортизацию = Модернизация;
	ПараметрыПолученияОстатков.ПолучатьОбесценение = Модернизация;
		
	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыПолученияОстатков.Период = КонецДня(Объект.Дата);
	Иначе
		ПараметрыПолученияОстатков.Ссылка = Объект.Ссылка;
		ПараметрыПолученияОстатков.Период = Объект.Дата;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "Организация, ИФО, КФО, Подразделение, ЦМО");
	
	ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТабОС = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабОС, СтрокаТаблицы, "ОсновноеСредство, ИнвентарныйНомер");
	КонецЦикла;	
	ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков);

	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		Если СтрокиОстатков.Количество() > 0 Тогда
			СтрокаТаблицы.СтоимостьБалансовая = СтрокиОстатков[0].БалансоваяСтоимость;
			СтрокаТаблицы.КПС = СтрокиОстатков[0].КПСОстатков;
			СтрокаТаблицы.СтоимостьПоОкончанииРабот = СтрокаТаблицы.СтоимостьБалансовая + СтрокаТаблицы.Сумма;
			СтрокаТаблицы.ОстаточнаяСтоимость = СтрокаТаблицы.СтоимостьБалансовая 
				- СтрокиОстатков[0].Амортизация - СтрокиОстатков[0].СуммаОбесценения;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеконструкцияИК") Тогда 
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.Заполнить(ДокументОснование);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
		УстановитьОтразитьВКарточкеКапвложений(ЭтотОбъект);
		ПересчитатьСтрокиТЧ_ОсновныеСредства(ЭтотОбъект);
		РассчитатьСтоимостиТЧ();
		ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	КонецЕсли;
КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтразитьВКарточкеКапвложений(Форма)
	Объект = Форма.Объект;
	
	ЭтоКапвложение = ЭтоОперацияСКапвложением(Форма);
	Если НЕ ЭтоКапвложение И Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Ложь;
	ИначеЕсли ЭтоКапвложение И НЕ Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	
КонецПроцедуры	                                  

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСтрокиТЧ_ОсновныеСредства(Форма)
	
	РассчитатьЦенуЕдиницыВложений(Форма);
	
	Для Каждого СтрокаТабЧасти Из Форма.Объект.ОсновныеСредства Цикл
		ПересчитатьСуммыТекущейСтроки(СтрокаТабЧасти, Форма);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидОперацииПриИзмененииОснования(Форма)
	Объект = Форма.Объект;
	ВидОперацииМодернизация = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация");
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеконструкцияИК")
		И ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ТолькоРегистрацияАкта") Тогда
			
		Объект.ФормироватьДвиженияПоМодернизации = Истина;
		Если Объект.ВидОперации <> ВидОперацииМодернизация Тогда
			Объект.ВидОперации = ВидОперацииМодернизация;
		КонецЕсли;
	Иначе				 
		Объект.ФормироватьДвиженияПоМодернизации = Ложь;
	КонецЕсли;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(ТекОбъект, ИмяРеквизита)
	Возврат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекОбъект, ИмяРеквизита));
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьОставшийсяСрокПолезногоИспользования(СрокПолезногоИспользованияПослеМодернизации, СрокЭксплуатацииФакт)
	
	ОставшийсяСрокПолезногоИспользования = СрокПолезногоИспользованияПослеМодернизации - СрокЭксплуатацииФакт;
	Возврат ?(ОставшийсяСрокПолезногоИспользования < 0, 0, ОставшийсяСрокПолезногоИспользования);
	
КонецФункции

