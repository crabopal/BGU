&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Свойства

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваПоляЦМО(Форма)
	Объект = Форма.Объект;
	
	ЕстьУчетПоЦМО = ЕстьСубконтоНаСчете(Объект.СчетУчета, "ЦМО");
	Форма.Элементы.ЦМО.АвтоОтметкаНезаполненного = ЕстьУчетПоЦМО;
	Форма.Элементы.ЦМО.ОтметкаНезаполненного = (ЕстьУчетПоЦМО И НЕ ЗначениеЗаполнено(Объект.ЦМО));
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЕстьСубконтоНаСчете(Счет, ИмяСубконто)  
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;	                     
	
	Возврат(БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
		Счет, ПланыВидовХарактеристик.ВидыСубконто[ИмяСубконто]));
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСчетаУчетаНаименование(Форма)
	Объект = Форма.Объект;
	Если ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		Текст = НаименованиеСчета(Объект.СчетУчета);
	Иначе	
		Текст = "";
	КонецЕсли;	
	Форма.СчетУчетаНаименование = Текст;
КонецПроцедуры	

&НаСервереБезКонтекста
Функция НаименованиеСчета(Счет)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Наименование");
КонецФункции	

&НаСервереБезКонтекста
Функция КодыСчетовКапвложений()
	Возврат ПланыСчетов.ЕПСБУ.КодыСчетовПоМаскеИСубконто("ОсновныеСредства", "106.5%");
КонецФункции	

&НаСервере
Процедура ЗаполнитьТипИВидНФАвТЧ()
	МассивОС = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
	РеквизитыОС = "ВидНФА, ТипНФА";
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОС, РеквизитыОС);
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		СтрокаОС = ДанныеОбъектовОС.Получить(СтрокаТЧ.ОсновноеСредство);
		Если СтрокаОС = Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаОС, РеквизитыОС); 
	КонецЦикла;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ВозможныГарантийныеОбязательства(ВидОперации)
	Возврат Документы.РешениеОПризнанииОбъектовОСИК.ВозможныГарантийныеОбязательства(ВидОперации);
КонецФункции	

