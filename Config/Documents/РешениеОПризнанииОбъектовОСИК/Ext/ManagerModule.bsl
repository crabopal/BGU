Процедура ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, ДокументСсылка, Параметры) Экспорт
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
	|	ТЧОсновныеСредства.Ссылка.ИФО КАК ИФО,
	|	ТЧОсновныеСредства.Ссылка.КФО КАК КФО,
	|	ТЧОсновныеСредства.КПС КАК КПС,
	|	ТЧОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТЧОсновныеСредства.Ссылка.СчетВложений КАК СчетКредита,
	|	ТЧОсновныеСредства.Ссылка.КапитальноеВложение КАК ВнеоборотныйАктив,
	|	&ВидЗатрат КАК ВидЗатрат,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТЧОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОсновныеСредства.Ссылка.СчетУчета КАК СчетУчета,
	|	ТЧОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ЕСТЬNULL(ТЧСведенияОВидахРабот.СуммаДемонтажа, 0) КАК СуммаДемонтажа,
	|	ЕСТЬNULL(ТЧСведенияОВидахРабот.СуммаТранспортировки, 0) КАК СуммаТранспортировки,
	|	ЕСТЬNULL(ТЧСведенияОВидахРабот.СуммаМодернизации, ТЧОсновныеСредства.Сумма) КАК СуммаМодернизации,
	|	&ПустойСчет КАК СчетУчетаЗатратПоАмортизационнойПремии,
	|	&ПустойВидСубконто КАК СубконтоПоАмортизационнойПремии1,
	|	&ПустойВидСубконто КАК СубконтоПоАмортизационнойПремии2,
	|	&ПустойВидСубконто КАК СубконтоПоАмортизационнойПремии3,
	|	0 КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
	|	0 КАК СуммаМодернизацииНУ,
	|	0 КАК СуммаМодернизацииНеУчитываетсяНУ,
	|	0 КАК СуммаМодернизацииЕНВД
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.ОсновныеСредства КАК ТЧОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РешениеОПризнанииОбъектовОСИК.СведенияОВидахРабот КАК ТЧСведенияОВидахРабот
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = ТЧСведенияОВидахРабот.ОсновноеСредство
	|		И ТЧОсновныеСредства.ИнвентарныйНомер = ТЧСведенияОВидахРабот.ИнвентарныйНомер
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|	И ТЧСведенияОВидахРабот.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидЗатрат", 
		?(Параметры.Свойство("ВидЗатрат"), Параметры.ВидЗатрат, Справочники.ВидыЗатрат.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ПустойСчет", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	Запрос.УстановитьПараметр("ПустойВидСубконто", 
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка"));
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов();
КонецПроцедуры	

