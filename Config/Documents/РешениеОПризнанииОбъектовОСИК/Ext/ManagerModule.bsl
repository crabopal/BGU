#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
		"Организация, Дата, Номер, КапитальноеВложение, КФО, ВидОперации, ФормироватьДвиженияПоМодернизации");
	ЗначенияРеквизитов.Вставить("ИмяДокумента", НСтр("ru = 'Решение о признании объектов нефинансовых активов'"));
	
	Модернизация = (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Модернизация);
	Если Модернизация Тогда 
		Если ЗначенияРеквизитов.ФормироватьДвиженияПоМодернизации Тогда
			ИнициализироватьДанныеДокумента_Модернизация(
				ДокументСсылка, СтруктураДополнительныеСвойства, ЗначенияРеквизитов);
		Иначе
			Возврат;
		КонецЕсли;		
	Иначе		
		ИнициализироватьДанныеДокумента_НеМодернизация(
			ДокументСсылка, СтруктураДополнительныеСвойства, ЗначенияРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

#Область Инициализация_НеМодернизация

Процедура ИнициализироватьДанныеДокумента_НеМодернизация(
	ДокументСсылка, СтруктураДополнительныеСвойства, ЗначенияРеквизитов)
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Модернизация Тогда
		Возврат;
	КонецЕсли;
	
	МассивСчетовМЦ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Основные средства");
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Номенклатура");
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата);
	УчетНаСчете21ВУсловнойОценке = УчетнаяПолитика.УчетНаСчете21ВУсловнойОценке;
	НачислятьАмортизацию = УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"               , ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"         , НСтр("ru = 'Решение о признании объектов нефинансовых активов'"));
	Запрос.УстановитьПараметр("УчетПоПодразделениям" , ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("НомерДокумента"       , ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер));
	Запрос.УстановитьПараметр("Учет21Условно"        , УчетНаСчете21ВУсловнойОценке);
	Запрос.УстановитьПараметр("ГраницаДокумента"     , Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"          , ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ВнеоборотныйАктив"    , ЗначенияРеквизитов.КапитальноеВложение);
	Запрос.УстановитьПараметр("Одобренные"           , ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументСсылка));
	Запрос.УстановитьПараметр("НачислятьАмортизацию" , НачислятьАмортизацию);
	Запрос.УстановитьПараметр("ВозможныГарантийныеОбязательства", 
		ВозможныГарантийныеОбязательства(ЗначенияРеквизитов.ВидОперации));
	Запрос.УстановитьПараметр("Период"           	, ЗначенияРеквизитов.Дата);	
	Запрос.УстановитьПараметр("МассивСчетовМЦ"		, МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ"	, МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ"	, МассивСубконтоМЗ);
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("ТаблицаОсновныеСредства");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.СчетУчета КАК СчетУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Договор КАК Договор,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ТаблицаОсновныеСредства.Ссылка.СчетУчета.УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ЛОЖЬ КАК ПринятиеСВводом,
	|	ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ТаблицаОсновныеСредства.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ТаблицаОсновныеСредства.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	ТаблицаОсновныеСредства.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	ТаблицаОсновныеСредства.СоздатьИнвентарнуюКарточку КАК СоздатьИнвентарнуюКарточку,
	|	&ИмяДокумента КАК ИмяДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НаименованиеГТ КАК НаименованиеГТ,
	|	ТаблицаОсновныеСредства.ДатаГТ КАК ДатаГТ,
	|	ТаблицаОсновныеСредства.НомерГТ КАК НомерГТ,
	|	ТаблицаОсновныеСредства.СрокДействияГТ КАК СрокДействияГТ,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|	И ТаблицаОсновныеСредства.ИдентификаторСтроки В(&Одобренные)";
	
	// Бухгалтерский учет
	ИнициализироватьЗапросыБУ(Запрос, ТаблицыЗапроса, ЗначенияРеквизитов, СтруктураДополнительныеСвойства);
	
	// Учет драг. материалов
	ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса);
	
	//// Учет прослеживаемости
	//ИнициализироватьЗапросыПрослеживаемости(Запрос, ТаблицыЗапроса, ЗначенияРеквизитов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыБУ(Запрос, ТаблицыЗапроса, ЗначенияРеквизитов, СтруктураДополнительныеСвойства)
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
