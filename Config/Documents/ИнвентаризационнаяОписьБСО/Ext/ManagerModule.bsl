	|					КОГДА ТЧ.ДенежныйДокумент <> ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка) ТОГДА
	|						ЕСТЬNULL(СправочникДенежныеДокументы.Код, """")
	|					ИНАЧЕ
	|						ЕСТЬNULL(СправочникВидыДенежныхДокументов.Код, """")
	|				КОНЕЦ
	|			ИНАЧЕ
	|				""""
	|		КОНЕЦ													КАК КодДокумента,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ЕСТЬNULL(СправочникСерииБСО.Наименование, """")
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ЕСТЬNULL(СправочникДенежныеДокументы.Серия, """")
	|			ИНАЧЕ
	|				""""
	|		КОНЕЦ													КАК Серия,
	|		ЕСТЬNULL(СправочникБСО.ДлинаНомера, 0)					КАК ДлинаНомераБСО,
	|		ЕСТЬNULL(СправочникДенежныеДокументы.НомСтоимость, 0)	КАК НомСтоимостьДД,
	|		ЕСТЬNULL(СправочникДенежныеДокументы.Номер, """")			КАК НомерДД
	|	ИЗ
	|		Документ.ИнвентаризационнаяОписьБСО КАК Шапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьБСО.Раздел1 КАК ТЧ
	|			ПО	Шапка.Ссылка В(&МассивСсылок)
	|			И	Шапка.Ссылка = ТЧ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БСО КАК СправочникБСО
	|			ПО	ТЧ.БСО = СправочникБСО.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииБСО КАК СправочникСерииБСО
	|			ПО	ТЧ.Серия = СправочникСерииБСО.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыДенежныхДокументов КАК СправочникВидыДенежныхДокументов
	|			ПО	ТЧ.ВидДенежногоДокумента = СправочникВидыДенежныхДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДенежныеДокументы КАК СправочникДенежныеДокументы
	|			ПО	ТЧ.ДенежныйДокумент = СправочникДенежныеДокументы.Ссылка
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|			
	|	ВЫБРАТЬ
	|		Шапка.ВидДокумента										КАК ВидДокумента,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ТЧ.БСО
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ТЧ.ВидДенежногоДокумента
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ													КАК ДокументВладелец,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ТЧ.Серия
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ТЧ.ДенежныйДокумент
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ													КАК ДокументПодчиненный,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ЕСТЬNULL(СправочникБСО.Наименование, """")
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ВЫБОР
	|					КОГДА ТЧ.ДенежныйДокумент <> ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка) ТОГДА
	|						ЕСТЬNULL(СправочникДенежныеДокументы.Наименование, """")
	|					ИНАЧЕ
	|						ЕСТЬNULL(СправочникВидыДенежныхДокументов.Наименование, """")
	|				КОНЕЦ
	|			ИНАЧЕ
	|				""""
	|		КОНЕЦ													КАК НаименованиеДокумента,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				СправочникБСО.Код
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ВЫБОР
	|					КОГДА ТЧ.ДенежныйДокумент <> ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка) ТОГДА
	|						ЕСТЬNULL(СправочникДенежныеДокументы.Код, """")
	|					ИНАЧЕ
	|						ЕСТЬNULL(СправочникВидыДенежныхДокументов.Код, """")
	|				КОНЕЦ
	|			ИНАЧЕ
	|				""""
