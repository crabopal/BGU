Функция ПолучитьОписаниеТиповДокументПодчиненный()
	
	МассивТипов = Новый Массив();
	МассивТипов.Добавить(Тип("СправочникСсылка.СерииБСО"));
	МассивТипов.Добавить(Тип("СправочникСсылка.ДенежныеДокументы"));
	
