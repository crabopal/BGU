	СведенияЕдИзм							= ДополнительныеПараметры.СведенияЕдИзм;
	ПостфиксыИменКолонокНомеровВРазделах	= ДополнительныеПараметры.ПостфиксыИменКолонокНомеровВРазделах;
	
