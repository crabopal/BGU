	ЗаполнитьСериюЦенуПриНаличииКоличества(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры, СтрокаСвойств, "НедостачаНеПодтверждено");
	
	ЗаполнитьДиапазонНомеровБланков(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры, СтрокаСвойств, "ИзлишкиНеПодтверждено");
	ЗаполнитьДиапазонНомеровБланков(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры, СтрокаСвойств, "НедостачаНеПодтверждено");
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел4_НаборКолонок2");
	
КонецПроцедуры


Функция ПолучитьСтруктурыДляЗаполненияСерииЦены()
	
	ПостфиксыИмен = СтрРазделить("НеСоответствует,Излишки,ИзлишкиПодтверждено,ИзлишкиНеПодтверждено,Недостача,НедостачаПодтверждено,НедостачаНеПодтверждено", ",");
	
	ЗаполняющиеСтруктуры = Новый Структура();
	ОчищающиеСтруктуры = Новый Структура();
	
	Для Каждого ПостфиксИмени Из ПостфиксыИмен Цикл
		ЗаполняющаяСтруктура = Новый Структура();
		ЗаполняющаяСтруктура.Вставить("Серия" + ПостфиксИмени, "");
		ЗаполняющаяСтруктура.Вставить("Цена" + ПостфиксИмени, 0);
		
		ОчищающаяСтруктура = Новый ФиксированнаяСтруктура(ЗаполняющаяСтруктура);
		
		ЗаполняющиеСтруктуры.Вставить("Постфикс" + ПостфиксИмени, ЗаполняющаяСтруктура);
		ОчищающиеСтруктуры.Вставить("Постфикс" + ПостфиксИмени, ОчищающаяСтруктура);
	КонецЦикла;
	
	Структуры = Новый Структура();
	Структуры.Вставить("Заполняющие",	ЗаполняющиеСтруктуры);
	Структуры.Вставить("Очищающие",		ОчищающиеСтруктуры);
	
	Возврат Структуры;
	
КонецФункции

Функция ПолучитьСтруктурыДляЗаполненияНомеров()
	
	ПостфиксыИмен = СтрРазделить("НеСоответствует,Излишки,ИзлишкиПодтверждено,ИзлишкиНеПодтверждено,Недостача,НедостачаПодтверждено,НедостачаНеПодтверждено", ",");
	ПостфиксыИмен.Добавить("");
	
	ЗаполняющиеСтруктуры = Новый Структура();
	ОчищающиеСтруктуры = Новый Структура();
	
	Для Каждого ПостфиксИмени Из ПостфиксыИмен Цикл
		ЗаполняющаяСтруктура = Новый Структура();
		
		// Для пустых Серии и Номеров применяем не прочерк, а число 0.
		ЗаполняющаяСтруктура.Вставить("Номера" + ПостфиксИмени, "0");
		
		ОчищающаяСтруктура = Новый ФиксированнаяСтруктура(ЗаполняющаяСтруктура);
		
		ЗаполняющиеСтруктуры.Вставить("Постфикс" + ПостфиксИмени, ЗаполняющаяСтруктура);
		ОчищающиеСтруктуры.Вставить("Постфикс" + ПостфиксИмени, ОчищающаяСтруктура);
	КонецЦикла;
	
	Структуры = Новый Структура();
	Структуры.Вставить("Заполняющие",	ЗаполняющиеСтруктуры);
	Структуры.Вставить("Очищающие",		ОчищающиеСтруктуры);
	
	Возврат Структуры;
	
КонецФункции

Процедура ЗаполнитьСериюЦенуПриНаличииКоличества(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры, СтрокаСвойств, ПостфиксИмени)
	
	ЗаполняющаяСтруктура = ДополнительныеПараметры.СтруктурыДляЗаполненияСерииЦены.Заполняющие["Постфикс" + ПостфиксИмени];
	
	Если ЗначениеЗаполнено(Выборка["Количество" + ПостфиксИмени]) Или ЗначениеЗаполнено(Выборка["Сумма" + ПостфиксИмени]) Тогда
		ЗаполняющаяСтруктура["Серия" + ПостфиксИмени] = СтрокаСвойств.Серия;
		
		ЗаполняющаяСтруктура["Цена" + ПостфиксИмени] = Выборка.Цена;
	Иначе
		ЗаполнитьЗначенияСвойств(ЗаполняющаяСтруктура, ДополнительныеПараметры.СтруктурыДляЗаполненияСерииЦены.Очищающие["Постфикс" + ПостфиксИмени]);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ЗаполняющаяСтруктура);
	
КонецПроцедуры

Функция ПолучитьСтрокуСвойствБСОиДД(Выборка, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.СтрокаШапки.ВидДокумента = ДополнительныеПараметры.ВидДокументаБСО Тогда
		ДополнительныеПараметры.ПоискСвойствБСОиДД.ДокументВладелец		= Выборка.БСО;
		ДополнительныеПараметры.ПоискСвойствБСОиДД.ДокументПодчиненный	= Выборка.Серия;
		
	ИначеЕсли ДополнительныеПараметры.СтрокаШапки.ВидДокумента = ДополнительныеПараметры.ВидДокументаДенежныйДокумент Тогда
		ДополнительныеПараметры.ПоискСвойствБСОиДД.ДокументВладелец		= Выборка.ВидДенежногоДокумента;
		ДополнительныеПараметры.ПоискСвойствБСОиДД.ДокументПодчиненный	= Выборка.ДенежныйДокумент;
		
	Иначе
		Возврат ДополнительныеПараметры.ПустаяСтрокаСвойствБСОиДД;
	КонецЕсли;
	
	МассивСтрок = ДополнительныеПараметры.ТаблицаСвойствБСОиДД.НайтиСтроки(ДополнительныеПараметры.ПоискСвойствБСОиДД);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат ДополнительныеПараметры.ПустаяСтрокаСвойствБСОиДД;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

Процедура ЗаполнитьДиапазонНомеровБланков(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры, СтрокаСвойств, ПостфиксИмени)
	
	ЗаполняющаяСтруктура = ДополнительныеПараметры.СтруктурыДляЗаполненияНомеров.Заполняющие["Постфикс" + ПостфиксИмени];
	
	НачальныйНомер	= Выборка["НачальныйНомер" + ПостфиксИмени];
	КонечныйНомер	= Выборка["КонечныйНомер" + ПостфиксИмени];
	Количество		= Выборка["Количество" + ПостфиксИмени];
	
	ИмяСвойства = "Номера" + ПостфиксИмени;
	
	Если ДополнительныеПараметры.СтрокаШапки.ВидДокумента = ДополнительныеПараметры.ВидДокументаБСО Тогда
		
		Если ДополнительныеПараметры.ИспользоватьПредставленияНомеровБСО Тогда
			НачальныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НачальныйНомер, СтрокаСвойств.ДлинаНомераБСО);
			КонечныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(КонечныйНомер, СтрокаСвойств.ДлинаНомераБСО);
		Иначе
			НачальныйНомерПредставление = Формат(НачальныйНомер, "ЧГ=0");
			КонечныйНомерПредставление = Формат(КонечныйНомер, "ЧГ=0");
		КонецЕсли;
		
		Если Количество = 1 Тогда
			ЗаполняющаяСтруктура[ИмяСвойства] = СтрШаблон(ДополнительныеПараметры.ШаблонДиапазонаНомеров, НачальныйНомерПредставление, "-");
			
		ИначеЕсли Количество > 1 Тогда
			ЗаполняющаяСтруктура[ИмяСвойства] = СтрШаблон(ДополнительныеПараметры.ШаблонДиапазонаНомеров, НачальныйНомерПредставление, КонечныйНомерПредставление);
			
		Иначе
			// Количество = 0.
			ЗаполнитьЗначенияСвойств(ЗаполняющаяСтруктура, ДополнительныеПараметры.СтруктурыДляЗаполненияНомеров.Очищающие["Постфикс" + ПостфиксИмени]);
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.СтрокаШапки.ВидДокумента = ДополнительныеПараметры.ВидДокументаДенежныйДокумент Тогда
		ВыводитьНомераБланковТолькоПриЗаполненныхПоказателях = ЗначениеЗаполнено(ПостфиксИмени);
		
		ОтказПриПустыхПоказателях = ВыводитьНомераБланковТолькоПриЗаполненныхПоказателях
				И Не ЗначениеЗаполнено(Выборка["Количество" + ПостфиксИмени]) И Не ЗначениеЗаполнено(Выборка["Сумма" + ПостфиксИмени]);
				
		Если ЗначениеЗаполнено(СтрокаСвойств.НомерДД) И Не ОтказПриПустыхПоказателях Тогда
			ЗаполняющаяСтруктура[ИмяСвойства] = СтрШаблон(ДополнительныеПараметры.ШаблонДиапазонаНомеров, СтрокаСвойств.НомерДД, "-");
		Иначе
			ЗаполнитьЗначенияСвойств(ЗаполняющаяСтруктура, ДополнительныеПараметры.СтруктурыДляЗаполненияНомеров.Очищающие["Постфикс" + ПостфиксИмени]);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ЗаполняющаяСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьНулямиСтрокуРаздела4(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры)
	
