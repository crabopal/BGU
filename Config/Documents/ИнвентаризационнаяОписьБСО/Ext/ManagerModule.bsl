Процедура УстановитьЦветКолонокНомераБланковБСО(Форма) Экспорт
	
	МассивЧастей = СтрРазделить(Форма.ИмяФормы, ".");
	
	ИмяФормы = МассивЧастей[МассивЧастей.ВГраница()];
	
	КолонкиНомеров = Новый Массив();
	
	Если ИмяФормы = "ФормаДокумента" Тогда
		КолонкиНомеров.Добавить("Раздел1КонечныйНомер");
		КолонкиНомеров.Добавить("Раздел1НачальныйНомер");

		КолонкиНомеров.Добавить("Раздел21НачальныйНомер");
		КолонкиНомеров.Добавить("Раздел21КонечныйНомер");
		КолонкиНомеров.Добавить("Раздел21НачальныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("Раздел21КонечныйНомерНеСоответствует");

		КолонкиНомеров.Добавить("Раздел22НачальныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("Раздел22КонечныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("Раздел22НачальныйНомерИзлишки");
		КолонкиНомеров.Добавить("Раздел22КонечныйНомерИзлишки");
		КолонкиНомеров.Добавить("Раздел22НачальныйНомерНедостача");
		КолонкиНомеров.Добавить("Раздел22КонечныйНомерНедостача");

		КолонкиНомеров.Добавить("Раздел3НачальныйНомерИзлишки");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерИзлишки");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерНедостача");
		КолонкиНомеров.Добавить("Раздел3НачальныйНомерНедостача");
		КолонкиНомеров.Добавить("Раздел3НачальныйНомерИзлишкиПодтверждено");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерИзлишкиПодтверждено");
		КолонкиНомеров.Добавить("Раздел3НачальныйНомерНедостачаПодтверждено");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерНедостачаПодтверждено");
		КолонкиНомеров.Добавить("Раздел3НачальныйНомерИзлишкиНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерИзлишкиНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел3НачальныйНомерНедостачаНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел3КонечныйНомерНедостачаНеПодтверждено");
		
		КолонкиНомеров.Добавить("Раздел4НачальныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("Раздел4КонечныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("Раздел4НачальныйНомерИзлишкиНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел4КонечныйНомерИзлишкиНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел4НачальныйНомерНедостачаНеПодтверждено");
		КолонкиНомеров.Добавить("Раздел4КонечныйНомерНедостачаНеПодтверждено");
		
	ИначеЕсли ИмяФормы = "РазбивкаСтрокиРаздела21" Тогда
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаНачальныйНомер");
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаКонечныйНомер");

		КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНачальныйНомер");
		КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиКонечныйНомер");
		КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНачальныйНомерНеСоответствует");
		КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиКонечныйНомерНеСоответствует");
		
	ИначеЕсли ИмяФормы = "РазбивкаСтрокиРаздела3" Тогда
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаНачальныйНомерИзлишки");
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаКонечныйНомерИзлишки");
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаНачальныйНомерНедостача");
		КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаКонечныйНомерНедостача");

		КолонкиНомеров.Добавить("ТаблицаИзлишкиНачальныйНомер");
		КолонкиНомеров.Добавить("ТаблицаИзлишкиКонечныйНомер");

		КолонкиНомеров.Добавить("ТаблицаНедостачаНачальныйНомер");
		КолонкиНомеров.Добавить("ТаблицаНедостачаКонечныйНомер");
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		КолонкиНомеров, "ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
	КонецЕсли;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов(ДокументОбъект);
	
	ПроверитьРаздел21(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры);
	
	ПроверитьРаздел3(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры);
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел2", НСтр("ru='Подписание раздела 2'"));
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел4", НСтр("ru='Подписание раздела 4'"));
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("МОЛ");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("МестоИнвентаризации");
	ИменаРеквизитов.Добавить("ВидДокумента");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьКорректностьЗаполненияПередЗаполнениемРаздела22(ДокументОбъект, ЕстьОшибки, ВестиКоличественныйУчетДенежныхДокументов) Экспорт
	
	ЕстьОшибки = Ложь;
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
	КонецЕсли;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов(ДокументОбъект, ВестиКоличественныйУчетДенежныхДокументов);
	
	ПроверитьРаздел21(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры);
	
КонецПроцедуры

Процедура ПроверитьДублиСтрокДенежныхДокументовРазбивкаСтрокиРаздела21(ТаблицаФрагментыСтроки, Отказ) Экспорт
	
	ПараметрыВыводаСообщений = ПолучитьПараметрыВыводаСообщенийПроверкиДублейСтрокДенежныхДокументов();
	ПараметрыВыводаСообщений.ИмяТабличнойЧасти = "ТаблицаФрагментыСтроки";
	ПараметрыВыводаСообщений.СинонимТабличнойЧасти = НСтр("ru='Фрагменты строки после разбивки'");
	
	ПроверяемаяТаблица = ТаблицаФрагментыСтроки.Выгрузить();
	ПроверяемаяТаблица.Колонки.Удалить("НомерСтроки");
	ПроверяемаяТаблица.Колонки.НПП.Имя = "НомерСтроки";
	
	ПроверитьДублиСтрокДенежныхДокументов(ПроверяемаяТаблица, ПараметрыВыводаСообщений, Отказ);
	
КонецПроцедуры

Процедура ПроверитьНеСоответствуетУсловиямАктиваРазбивкаСтрокиРаздела21(ВидДокумента, ТаблицаФрагментыСтроки, Отказ, ВестиКоличественныйУчетДенежныхДокументов) Экспорт
	
	СтруктураДокумента = Новый Структура();
	СтруктураДокумента.Вставить("ВидДокумента", ВидДокумента);
	СтруктураДокумента.Вставить("Ссылка",		Неопределено);
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов(СтруктураДокумента, ВестиКоличественныйУчетДенежныхДокументов);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыПроверкиРаздела21(ОбщиеПараметры);
	ДополнительныеПараметры.ИмяТабличнойЧасти			= "ТаблицаФрагментыСтроки";
	ДополнительныеПараметры.ПредставлениеТабличнойЧасти	= НСтр("ru='Фрагменты строки'");
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментыСтроки Цикл
		ПроверитьРаздел21_ЗаполнениеНеСоответствуетУсловиямАктиваВСтрокеТаблицы(
			СтруктураДокумента,
			СтрокаТаблицы,
			ДополнительныеПараметры,
			Отказ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДиагностироватьПорокиДиапазоновБСОРазбивкаСтрокиРаздела21(ТаблицаФрагментыСтроки, НачальныйНомерИсходногоДиапазона, КонечныйНомерИсходногоДиапазона, Отказ) Экспорт
	
	ТаблицаГраниц = ПолучитьТаблицуГраниц(ТаблицаФрагментыСтроки);
	
	ПорокиДиапазонов = ДиагностироватьПорокиДиапазонов(ТаблицаГраниц, НачальныйНомерИсходногоДиапазона, КонечныйНомерИсходногоДиапазона);
	
	ВывестиСообщенияОПорокахДиапазонов(ПорокиДиапазонов, ТаблицаФрагментыСтроки, Отказ);
	
КонецПроцедуры

Процедура ПроверитьКорректностьЗаполненияПередЗаполнениемРаздела4(ДокументОбъект, ЕстьОшибки, ВестиКоличественныйУчетДенежныхДокументов) Экспорт
	
	ЕстьОшибки = Ложь;
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
	КонецЕсли;
	
	ПроверитьЗаполнениеКолонокТабличнойЧасти(ДокументОбъект, "Раздел3", "ОбъяснениеПричинРасхождений", ЕстьОшибки, Метаданные.Документы.ИнвентаризационнаяОписьБСО);
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов(ДокументОбъект, ВестиКоличественныйУчетДенежныхДокументов);
	
	ПроверитьРаздел3(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры);
	
КонецПроцедуры

