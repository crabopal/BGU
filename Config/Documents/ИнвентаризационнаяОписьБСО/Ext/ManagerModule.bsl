#Область РеестрДокументовКПроводимойИнвентаризации

Функция ПрочитатьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДокументСсылка) Экспорт
	
	ДанныеОписи = Отчеты.РеестрДокументовКПроводимойИнвентаризации.НовыйОбщиеДанныеОписи();
	
	ДанныеОписи.Вставить("МОЛ");
	ДанныеОписи.Вставить("КФО");
	ДанныеОписи.Вставить("Счет");
	ДанныеОписи.Вставить("МестоИнвентаризации");
	ДанныеОписи.Вставить("ВидДокумента");
	
	ДанныеОписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ДанныеОписи);
	
	Возврат ДанныеОписи;
	
КонецФункции

Процедура ПроверитьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(Знач ДанныеОписи, Отказ) Экспорт
	
	Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПроверитьОбщиеДанныеОписи(ДанныеОписи, Отказ);
	
	ШаблонСообщения = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьШаблонСообщенияПроверкиПередФормированиемРеестра();
	
	Если Не ЗначениеЗаполнено(ДанныеОписи.МОЛ) Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru='Ответственное лицо'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "МОЛ", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеОписи.Счет) Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru='Счет'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "ПредставлениеСчета",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументыДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, ПериодФормирования) Экспорт
	
	ЭтоБСО				= (ДанныеОписи.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (ДанныеОписи.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	Если ЭтоБСО Тогда
		Возврат НайтиДокументыДвиженияБСО(ДанныеОписи, ПериодФормирования);
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		Возврат НайтиДокументыДвиженияДД(ДанныеОписи, ПериодФормирования);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

