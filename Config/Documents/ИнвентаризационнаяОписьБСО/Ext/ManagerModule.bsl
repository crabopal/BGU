Функция ПолучитьОписаниеТиповДокументВладелец()
	
	МассивТипов = Новый Массив();
	МассивТипов.Добавить(Тип("СправочникСсылка.БСО"));
	МассивТипов.Добавить(Тип("СправочникСсылка.ВидыДенежныхДокументов"));
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
