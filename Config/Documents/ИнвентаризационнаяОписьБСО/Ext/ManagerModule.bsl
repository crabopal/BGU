Функция ПолучитьДанныеДляПечати0510465(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.УстановитьПараметр("ВидДокументаБСО", Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЗапросПоиск.УстановитьПараметр("ВидДокументаДД", Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510465();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [0]. Все различные денежные документы и БСО с необходимыми далее свойствами.
	ТаблицаСвойствБСОиДД = РезультатыЗапроса[0].Выгрузить();
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	Данные.Вставить("ДополнительныеПараметры", ПолучитьДополнительныеПараметрыПечати0510465(ТаблицаСвойствБСОиДД));
	Данные.Выборки.Вставить("Шапки",				РезультатыЗапроса[1].Выбрать());
	Данные.Выборки.Вставить("Раздел1",				РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел21",				РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел22",				РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел3",				РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел4",				РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("СоставКомиссииРаздел2", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел2"));
	Данные.Вставить("СоставКомиссииРаздел4", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел4"));
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьТекстЗапросаПечать0510465()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все различные денежные документы и БСО с необходимыми далее свойствами.
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидДокумента			КАК ВидДокумента,
	|	ДокументВладелец		КАК ДокументВладелец,
	|	ДокументПодчиненный		КАК ДокументПодчиненный,
	|	НаименованиеДокумента	КАК НаименованиеДокумента,
	|	КодДокумента			КАК КодДокумента,
	|	Серия					КАК Серия,
	|	ДлинаНомераБСО			КАК ДлинаНомераБСО,
	|	НомСтоимостьДД			КАК НомСтоимостьДД,
	|	НомерДД					КАК НомерДД
	|ИЗ
	|	(ВЫБРАТЬ
	|		Шапка.ВидДокумента										КАК ВидДокумента,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ТЧ.БСО
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ТЧ.ВидДенежногоДокумента
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ													КАК ДокументВладелец,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ТЧ.Серия
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ТЧ.ДенежныйДокумент
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ													КАК ДокументПодчиненный,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				ЕСТЬNULL(СправочникБСО.Наименование, """")
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
	|				ВЫБОР
	|					КОГДА ТЧ.ДенежныйДокумент <> ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка) ТОГДА
	|						ЕСТЬNULL(СправочникДенежныеДокументы.Наименование, """")
	|					ИНАЧЕ
	|						ЕСТЬNULL(СправочникВидыДенежныхДокументов.Наименование, """")
	|				КОНЕЦ
	|			ИНАЧЕ
	|				""""
	|		КОНЕЦ													КАК НаименованиеДокумента,
	|		ВЫБОР
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаБСО ТОГДА
	|				СправочникБСО.Код
	|			КОГДА Шапка.ВидДокумента = &ВидДокументаДД ТОГДА
