#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСлужебныеКолонкиТабличнойЧасти(ВидДокумента, ТабличнаяЧасть, ПостфиксыИмен, ИмяТЧ, РезультатыДиагностики = Неопределено, СведенияБСОиДД = Неопределено)
	
	НомераСтрокРаздела1СОшибкамиУчета = Новый Массив();
	
	ИспользоватьПредставленияНомеровБСО = ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО();
	
	ПредставленияНомеров = Новый Структура();
	
	Для Каждого ПостфиксИмени Из ПостфиксыИмен Цикл
		ПредставленияНомеров.Вставить("НачальныйНомер" + ПостфиксИмени + "Представление", "");
		ПредставленияНомеров.Вставить("КонечныйНомер" + ПостфиксИмени + "Представление", "");
	КонецЦикла;
	
	ПустыеНомера = Новый ФиксированнаяСтруктура(ПредставленияНомеров);
	
	Если СведенияБСОиДД = Неопределено Тогда
		СведенияБСОиДД = ПрочитатьСведенияБСОиДДДляТаблицы(ТабличнаяЧасть);
	КонецЕсли;
	
	ЕстьОшибкиУчета = Ложь;
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		
		Если ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.БСО;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.Серия;
			
			Если ИспользоватьПредставленияНомеровБСО Тогда
				ДлинаНомера = СведенияБСОиДД.ДлиныНомеровБСО.Получить(СтрокаТаблицы.БСО);
				
				СтрокаТаблицы.ДлинаНомера = ДлинаНомера;
				
				Для Каждого ПостфиксИмени Из ПостфиксыИмен Цикл
					ПредставленияНомеров["НачальныйНомер" + ПостфиксИмени + "Представление"] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["НачальныйНомер" + ПостфиксИмени], ДлинаНомера);
					ПредставленияНомеров["КонечныйНомер" + ПостфиксИмени + "Представление"] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["КонечныйНомер" + ПостфиксИмени], ДлинаНомера);
				КонецЦикла;
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПредставленияНомеров);
				
				ЗаполнитьЗначенияСвойств(ПредставленияНомеров, ПустыеНомера);
			КонецЕсли;
			
		ИначеЕсли ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.ВидДенежногоДокумента;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.ДенежныйДокумент;
			
			СведенияДД = СведенияБСОиДД.СведенияДенежныхДокументов.Получить(СтрокаТаблицы.ДенежныйДокумент);
			
			Если СведенияДД <> Неопределено Тогда
				НомерДенежногоДокумента = СведенияДД.Номер;
				НомСтоимость = СведенияДД.НомСтоимость;
			Иначе
				НомерДенежногоДокумента = "";
				НомСтоимость = 0;
			КонецЕсли;
			
			СтрокаТаблицы.НомерДенежногоДокумента = НомерДенежногоДокумента;
			СтрокаТаблицы.НомСтоимость = НомСтоимость;
		КонецЕсли;
		
		Если ИмяТЧ = "Раздел1" Тогда
			СтрокаТаблицы.ОшибкаУчета = (СтрокаТаблицы.МножительКоличества > 1 Или СтрокаТаблицы.МножительКоличества < 0
				Или СтрокаТаблицы.Количество < 0 Или СтрокаТаблицы.Сумма < 0);
				
			Если СтрокаТаблицы.ОшибкаУчета Тогда
				ЕстьОшибкиУчета = Истина;
				
				НомераСтрокРаздела1СОшибкамиУчета.Добавить(СтрокаТаблицы.НомерСтроки);
			КонецЕсли;
			
		ИначеЕсли ИмяТЧ = "Раздел21" Или ИмяТЧ = "Раздел3" Тогда
			СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИмяТЧ = "Раздел1" И РезультатыДиагностики <> Неопределено Тогда
		РезультатыДиагностики.Раздел1.Вставить("ЕстьОшибкиУчета", ЕстьОшибкиУчета);
		РезультатыДиагностики.Раздел1.Вставить("НомераСтрокРаздела1СОшибкамиУчета", НомераСтрокРаздела1СОшибкамиУчета);
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьСведенияБСОиДДДляВсегоДокумента(ДокументОбъект)
	
	СписокБСО = Новый Массив();
	СписокДД = Новый Массив();
	
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Раздел1");
	ИменаТЧ.Добавить("Раздел21");
	ИменаТЧ.Добавить("Раздел22");
	ИменаТЧ.Добавить("Раздел3");
	ИменаТЧ.Добавить("Раздел4");
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		ВремТаблица = ДокументОбъект[ИмяТЧ].Выгрузить(, "БСО,ДенежныйДокумент");
		
		ТаблицаБСО = ВремТаблица.Скопировать(, "БСО");
		ТаблицаБСО.Свернуть("БСО");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокБСО, ТаблицаБСО.ВыгрузитьКолонку("БСО"));
		
		ТаблицаДД = ВремТаблица.Скопировать(, "ДенежныйДокумент");
		ТаблицаДД.Свернуть("ДенежныйДокумент");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокДД, ТаблицаДД.ВыгрузитьКолонку("ДенежныйДокумент"));
	КонецЦикла;
	
	Возврат ПрочитатьСведенияБСОиДД(СписокБСО, СписокДД);
	
КонецФункции

Функция ПрочитатьСведенияБСОиДДДляТаблицы(ТабЧасть)
	
	ВремТаблица = ТабЧасть.Скопировать(, "БСО,ДенежныйДокумент");
	
	ТаблицаБСО = ВремТаблица.Скопировать(, "БСО");
	ТаблицаБСО.Свернуть("БСО");
	
	СписокБСО = ТаблицаБСО.ВыгрузитьКолонку("БСО");
	
	ТаблицаДД = ВремТаблица.Скопировать(, "ДенежныйДокумент");
	ТаблицаДД.Свернуть("ДенежныйДокумент");
	
	СписокДД = ТаблицаДД.ВыгрузитьКолонку("ДенежныйДокумент");
	
	Возврат ПрочитатьСведенияБСОиДД(СписокБСО, СписокДД);
	
КонецФункции

Функция ПрочитатьСведенияБСОиДД(СписокБСО, СписокДД)
	
	Результат = Новый Структура();
	
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(СписокБСО, Неопределено);
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(СписокДД, Неопределено);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат.Вставить("ДлиныНомеровБСО",				ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокБСО, "ДлинаНомера"));
	Результат.Вставить("СведенияДенежныхДокументов",	ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокДД, "Номер,НомСтоимость,Серия"));
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

#Область ПроверкаЗаполнения

Процедура ПроверитьРаздел21(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры)
	
	ЭтоБСО				= ОбщиеПараметры.ЭтоБСО;
	ЭтоДенежныйДокумент	= ОбщиеПараметры.ЭтоДенежныйДокумент;
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыПроверкиРаздела21(ОбщиеПараметры);
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел21 Цикл
		Если (ЭтоБСО И Не ЗначениеЗаполнено(СтрокаТаблицы.БСО))
			Или (ЭтоДенежныйДокумент И Не ЗначениеЗаполнено(СтрокаТаблицы.ВидДенежногоДокумента)) Тогда
			ЕстьОшибки = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				"Документ", СтрокаТаблицы.НомерСтроки, НСтр("ru='Раздел 2.1'"));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел21", СтрокаТаблицы.НомерСтроки, "ДокументВладелец"),
				"Объект", ЕстьОшибки);
		КонецЕсли;
		
		Если ДокументОбъект.ВидДокумента = ДополнительныеПараметры.ВидДокументаБСО Тогда
			ПроверитьРаздел21_ЗаполнениеПолейБСОВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ДополнительныеПараметры, ЕстьОшибки);
		КонецЕсли;
		
		Если СтрокаТаблицы.ДобавленоВручную Тогда
			ПроверитьРаздел21_ЗаполнениеДобавленнойВручнуюСтрокиТаблицы(ДокументОбъект, СтрокаТаблицы, ОбщиеПараметры, ДополнительныеПараметры, ЕстьОшибки);
		КонецЕсли;
		
		ПроверитьРаздел21_ЗаполнениеНеСоответствуетУсловиямАктиваВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ДополнительныеПараметры, ЕстьОшибки);
	КонецЦикла;
	
	Если ЭтоБСО Тогда
		ПроверитьПересеченияИнтерваловНомеров(ДокументОбъект.Ссылка, ДокументОбъект.Раздел21, "Раздел21",,, ЕстьОшибки);
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		Если Не ЕстьОшибки Тогда
			ПроверитьДублиСтрокДенежныхДокументовРаздела21(ДокументОбъект, ЕстьОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРаздел21_ЗаполнениеПолейБСОВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ДополнительныеПараметры, ЕстьОшибки)
	
	// Допустимым является либо заполнение либо незаполнение всех полей одновременно.
	
	ВсеПустые = Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер)
		И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер)
		И Не ЗначениеЗаполнено(СтрокаТаблицы.Количество)
		И Не ЗначениеЗаполнено(СтрокаТаблицы.Сумма);
		
	ВсеЗаполнены = ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер)
		И ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер)
		И ЗначениеЗаполнено(СтрокаТаблицы.Количество)
		И ЗначениеЗаполнено(СтрокаТаблицы.Сумма);
		
	Если ВсеПустые Или ВсеЗаполнены Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ДополнительныеПараметры.ИменаПолейФактическогоНаличия Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибки = Истина;
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			ДополнительныеПараметры.МетаданныеРеквизитовТЧ[ИмяПоля].Синоним,
			СтрокаТаблицы.НомерСтроки,
			НСтр("ru='Раздел 2.1'"));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел21", СтрокаТаблицы.НомерСтроки, ИмяПоля),
			"Объект", ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел21_ЗаполнениеНеСоответствуетУсловиямАктиваВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ДополнительныеПараметры, ЕстьОшибки) Экспорт
	
	// Допустимым является либо заполнение либо незаполнение всех полей одновременно.
	
	Если ДокументОбъект.ВидДокумента = ДополнительныеПараметры.ВидДокументаБСО Тогда
		СписокИмен = ДополнительныеПараметры.ИменаПолейНеСоответствуетБСО;
		
	ИначеЕсли ДокументОбъект.ВидДокумента = ДополнительныеПараметры.ВидДокументаДенежныеДокументы Тогда
		СписокИмен = ДополнительныеПараметры.ИменаПолейНеСоответствуетДенежныйДокумент;
	Иначе
		Возврат;
	КонецЕсли;
	
	ЕстьЗаполненные = Ложь;
	ЕстьПустые = Ложь;
	
	Для Каждого ИмяПоля Из СписокИмен Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			ЕстьЗаполненные = Истина;
		Иначе
			ЕстьПустые = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не (ЕстьЗаполненные И ЕстьПустые) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКДанным = ?(ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО"), "Объект", "");
	
	Для Каждого ИмяПоля Из СписокИмен Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибки = Истина;
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			ДополнительныеПараметры.МетаданныеРеквизитовТЧ[ИмяПоля].Синоним,
			СтрокаТаблицы.НомерСтроки,
			ДополнительныеПараметры.ПредставлениеТабличнойЧасти);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ДополнительныеПараметры.ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, ИмяПоля),
			ПутьКДанным, ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел21_ЗаполнениеДобавленнойВручнуюСтрокиТаблицы(ДокументОбъект, СтрокаТаблицы, ОбщиеПараметры, ДополнительныеПараметры, ЕстьОшибки)
	
	ЕстьЗаполненныйПоказатель = ЗначениеЗаполнено(СтрокаТаблицы.Сумма);
	
	Если ОбщиеПараметры.РедактируетсяКоличество Тогда
		ЕстьЗаполненныйПоказатель = ЕстьЗаполненныйПоказатель Или ЗначениеЗаполнено(СтрокаТаблицы.Количество);
	КонецЕсли;
	
	Если ЕстьЗаполненныйПоказатель Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Истина;
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("Сумма");
	
	Если ОбщиеПараметры.РедактируетсяКоличество Тогда
		ИменаПолей.Добавить("Количество");
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			ДополнительныеПараметры.МетаданныеРеквизитовТЧ[ИмяПоля].Синоним,
			СтрокаТаблицы.НомерСтроки,
			НСтр("ru='Раздел 2.1'"));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел21", СтрокаТаблицы.НомерСтроки, ИмяПоля),
			"Объект", ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел3(ДокументОбъект, ЕстьОшибки, ОбщиеПараметры)
	
	ПредставлениеТЧ = НСтр("ru='Раздел 3'");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел3 Цикл
		ПроверитьРаздел3_ПервичныйУчетныйДокументВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ПредставлениеТЧ, ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел3_ПервичныйУчетныйДокументВСтрокеТаблицы(ДокументОбъект, СтрокаТаблицы, ПредставлениеТЧ, Отказ)
	
	ОбязательноУказаниеДокумента = ЗначениеЗаполнено(СтрокаТаблицы.КоличествоИзлишкиПодтверждено)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаИзлишкиПодтверждено)
		Или ЗначениеЗаполнено(СтрокаТаблицы.КоличествоНедостачаПодтверждено)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаНедостачаПодтверждено);
		
	Если Не ОбязательноУказаниеДокумента Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеДокумента) Тогда
		Отказ = Истина;
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			НСтр("ru='Наименование документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.Раздел3", СтрокаТаблицы.НомерСтроки, "НаименованиеДокумента"));
	КонецЕсли;
	
	Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.НомерДокумента) Тогда
		Отказ = Истина;
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			НСтр("ru='Номер документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.Раздел3", СтрокаТаблицы.НомерСтроки, "НомерДокумента"));
	КонецЕсли;
	
	Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаДокумента) Тогда
		Отказ = Истина;
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			НСтр("ru='Дата документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.Раздел3", СтрокаТаблицы.НомерСтроки, "ДатаДокумента"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПересеченияИнтерваловНомеров(ДокументСсылка, ПроверяемаяТаблица, ИмяТабличнойЧасти, ИмяКолонкиНачальныйНомер = "НачальныйНомер", ИмяКолонкиКонечныйНомер = "КонечныйНомер", Отказ)
	
	МетаданныеТабличнойЧасти = Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти[ИмяТабличнойЧасти];
	
	СинонимТабличнойЧасти			= МетаданныеТабличнойЧасти.Синоним;
	СинонимКолонкиНачальногоНомера	= МетаданныеТабличнойЧасти.Реквизиты[ИмяКолонкиНачальныйНомер].Синоним;
	
	ТекстШаблонОднаСтрока		= НСтр("ru='Обнаружены пересекающиеся диапазоны номеров БСО одной и той же серии (таблица ""%1"", строка %2 со строкой %3)'");
	ТекстШаблонНесколькоСтрок	= НСтр("ru='Обнаружены пересекающиеся диапазоны номеров БСО одной и той же серии (таблица ""%1"", строка %2 со строками %3)'");
	
	ПересеченияИнтервалов = ПолучитьПересеченияИнтерваловНомеров(ПроверяемаяТаблица, ИмяКолонкиНачальныйНомер, ИмяКолонкиКонечныйНомер);
	
	Для Каждого СтрокаТаблицы Из ПересеченияИнтервалов Цикл
		ТекстПересечениеСоСтроками = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения("%1", СтрокаТаблицы.ПересечениеСНомерамиСтрок, 20, "%1");
		
		ТекстШаблон = ?(СтрокаТаблицы.ПересечениеСНомерамиСтрок.Количество() = 1, ТекстШаблонОднаСтрока, ТекстШаблонНесколькоСтрок);
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, СинонимТабличнойЧасти, СтрокаТаблицы.НомерСтроки, ТекстПересечениеСоСтроками);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, ИмяКолонкиНачальныйНомер),
			"Объект", Отказ);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПересеченияИнтерваловНомеров(ПроверяемаяТаблица, ИмяКолонкиНачальныйНомер = "НачальныйНомер", ИмяКолонкиКонечныйНомер = "КонечныйНомер")
	
	// Проверяем только те строки, где заполнены оба номера БСО.
	
	ТаблицаСообщений = Новый ТаблицаЗначений();
	ТаблицаСообщений.Колонки.Добавить("НомерСтроки",				ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаСообщений.Колонки.Добавить("ПересечениеСНомерамиСтрок",	Новый ОписаниеТипов("Массив"));
	
	Поиск = Неопределено; // Новый Структура("ВидДокумента", Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	
	ВыгружаемыеКолонки = "НомерСтроки,БСО,Серия," + ИмяКолонкиНачальныйНомер + "," + ИмяКолонкиКонечныйНомер;
	
	Если ТипЗнч(ПроверяемаяТаблица) = Тип("ТаблицаЗначений") Тогда
		ТаблицаНомеров = ПроверяемаяТаблица.Скопировать(Поиск, ВыгружаемыеКолонки);
	Иначе
		ТаблицаНомеров = ПроверяемаяТаблица.Выгрузить(Поиск, ВыгружаемыеКолонки);
	КонецЕсли;
	
	ТаблицаНомеров.Колонки.Найти(ИмяКолонкиНачальныйНомер).Имя = "НачальныйНомер";
	ТаблицаНомеров.Колонки.Найти(ИмяКолонкиКонечныйНомер).Имя = "КонечныйНомер";
	ТаблицаНомеров.Сортировать("БСО,Серия,НачальныйНомер", Новый СравнениеЗначений);
	ТаблицаНомеров.Индексы.Добавить("БСО,Серия");
	ТаблицаНомеров.Индексы.Добавить("БСО,Серия,НачальныйНомер");
	
	ОписанияТипов = ПолучитьОписанияТиповДляТаблицРасчета();
	
	ТаблицаГраниц = Новый ТаблицаЗначений();
	ТаблицаГраниц.Колонки.Добавить("БСО",					Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ТаблицаГраниц.Колонки.Добавить("Серия",					Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаГраниц.Колонки.Добавить("Граница",				ОписанияТипов.НомерБСО);
	ТаблицаГраниц.Колонки.Добавить("ДельтаКоличество",		ОбщегоНазначения.ОписаниеТипаЧисло(1,0,ДопустимыйЗнак.Любой));
	ТаблицаГраниц.Колонки.Добавить("МножительКоличества",	ОбщегоНазначения.ОписаниеТипаЧисло(2,0,ДопустимыйЗнак.Любой));
	
	Для Каждого СтрокаТаблицы Из ТаблицаНомеров Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) Или Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "БСО,Серия");
		
		НоваяСтрока.Граница = СтрокаТаблицы.НачальныйНомер;
		НоваяСтрока.ДельтаКоличество = 1;
		
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "БСО,Серия");
		
		НоваяСтрока.Граница = СтрокаТаблицы.КонечныйНомер + 1;
		НоваяСтрока.ДельтаКоличество = -1;
	КонецЦикла;
	
	ТаблицаГраниц.Свернуть("БСО,Серия,Граница,МножительКоличества", "ДельтаКоличество");
	ТаблицаГраниц.Сортировать("БСО,Серия,Граница", Новый СравнениеЗначений);
	
	ТаблицаГраниц.Колонки.Добавить("ЕстьПересечение", Новый ОписаниеТипов("Булево"));
	
	МножительКоличества = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаГраниц Цикл
		МножительКоличества = МножительКоличества + СтрокаТаблицы.ДельтаКоличество;
		
		СтрокаТаблицы.МножительКоличества = МножительКоличества;
		
		Если МножительКоличества >= 2 Тогда
			СтрокаТаблицы.ЕстьПересечение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПересечений = ТаблицаГраниц.Скопировать(Новый Структура("ЕстьПересечение", Истина));
	
	ПоискНачальногоНомера = Новый Структура("БСО,Серия,НачальныйНомер");
	ПоискСерии = Новый Структура("БСО,Серия");
	
	Для Каждого СтрокаПересечения Из ТаблицаПересечений Цикл
		ЗаполнитьЗначенияСвойств(ПоискНачальногоНомера, СтрокаПересечения);
		ПоискНачальногоНомера.НачальныйНомер = СтрокаПересечения.Граница;
		
		МассивСтрокНомеров = ТаблицаНомеров.НайтиСтроки(ПоискНачальногоНомера);
		
		Если МассивСтрокНомеров.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаНомеров Из МассивСтрокНомеров Цикл
			НоваяСтрока = ТаблицаСообщений.Добавить();
			НоваяСтрока.НомерСтроки = СтрокаНомеров.НомерСтроки;
			НоваяСтрока.ПересечениеСНомерамиСтрок = Новый Массив();
			
			ЗаполнитьЗначенияСвойств(ПоискСерии, СтрокаПересечения);
			
			МассивСтрок = ТаблицаНомеров.НайтиСтроки(ПоискСерии);
			
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				Если СтрокаТаблицы.НачальныйНомер <= СтрокаНомеров.КонечныйНомер И СтрокаТаблицы.КонечныйНомер >= СтрокаНомеров.НачальныйНомер Тогда
					Если СтрокаНомеров = СтрокаТаблицы Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока.ПересечениеСНомерамиСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаСообщений.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСообщений Цикл
		ВремСписок = Новый СписокЗначений();
		ВремСписок.ЗагрузитьЗначения(СтрокаТаблицы.ПересечениеСНомерамиСтрок);
		ВремСписок.СортироватьПоЗначению();
		
		СтрокаТаблицы.ПересечениеСНомерамиСтрок = ВремСписок.ВыгрузитьЗначения();
	КонецЦикла;
	
	Возврат ТаблицаСообщений;
	
КонецФункции

Функция ПолучитьПараметрыВыводаСообщенийПроверкиДублейСтрокДенежныхДокументов()
	
	Возврат Новый Структура("
		|ДокументСсылка,
		|ИмяТабличнойЧасти,
		|СинонимТабличнойЧасти");
	
КонецФункции

Процедура ПроверитьДублиСтрокДенежныхДокументовРаздела21(ДокументОбъект, ЕстьОшибки)
	
	ПараметрыВыводаСообщений = ПолучитьПараметрыВыводаСообщенийПроверкиДублейСтрокДенежныхДокументов();
	ПараметрыВыводаСообщений.ДокументСсылка = ДокументОбъект.Ссылка;
	ПараметрыВыводаСообщений.ИмяТабличнойЧасти = "Раздел21";
	
	ПроверитьДублиСтрокДенежныхДокументов(ДокументОбъект.Раздел21, ПараметрыВыводаСообщений, ЕстьОшибки);
	
КонецПроцедуры

Процедура ПроверитьДублиСтрокДенежныхДокументов(ПроверяемаяТаблица, ПараметрыВыводаСообщений, Отказ)
	
	// Проверяет наличие дублей строк по денежному документу и статусу и выводит сообщения с отказом.
	
	Если ЗначениеЗаполнено(ПараметрыВыводаСообщений.СинонимТабличнойЧасти) Тогда
		СинонимТабличнойЧасти = ПараметрыВыводаСообщений.СинонимТабличнойЧасти;
	Иначе
		МетаданныеТабличнойЧасти = Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти[ПараметрыВыводаСообщений.ИмяТабличнойЧасти];
		
		СинонимТабличнойЧасти = МетаданныеТабличнойЧасти.Синоним;
	КонецЕсли;
	
	ТекстШаблон = НСтр("ru='Обнаружены дубли строк денежных документов и статуса (Таблица ""%1"", строки %2)'");
	
	ДублиСтрок = ПолучитьДублиСтрокДенежныхДокументов(ПроверяемаяТаблица);
	
	Для Каждого СтрокаТаблицы Из ДублиСтрок Цикл
		ТекстДублиСтрок = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения("%1", СтрокаТаблицы.ДублиСтрок, 20, "%1");
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, СинонимТабличнойЧасти, ТекстДублиСтрок);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПараметрыВыводаСообщений.ДокументСсылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ПараметрыВыводаСообщений.ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "НомерСтроки"),
			?(ЗначениеЗаполнено(ПараметрыВыводаСообщений.ДокументСсылка), "Объект", Неопределено),
			Отказ);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДублиСтрокДенежныхДокументов(ПроверяемаяТаблица)
	
	ТаблицаСообщений = Новый ТаблицаЗначений();
	ТаблицаСообщений.Колонки.Добавить("НомерСтроки",	ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаСообщений.Колонки.Добавить("ДублиСтрок",		Новый ОписаниеТипов("Массив"));
	
	ПоискВидДокумента = Неопределено; // Новый Структура("ВидДокумента", Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	КолонкиГруппировок = "ВидДенежногоДокумента,ДенежныйДокумент,Цена,Статус";
	
	ВыгружаемыеКолонки = "НомерСтроки," + КолонкиГруппировок;
	
	Если ТипЗнч(ПроверяемаяТаблица) = Тип("ТаблицаЗначений") Тогда
		СвернутаяТаблица = ПроверяемаяТаблица.Скопировать(ПоискВидДокумента, ВыгружаемыеКолонки);
	Иначе
		СвернутаяТаблица = ПроверяемаяТаблица.Выгрузить(ПоискВидДокумента, ВыгружаемыеКолонки);
	КонецЕсли;
	
	СвернутаяТаблица.Колонки.Найти("НомерСтроки").Имя = "КоличествоСтрок";
	СвернутаяТаблица.ЗаполнитьЗначения(1, "КоличествоСтрок");
	СвернутаяТаблица.Свернуть(КолонкиГруппировок, "КоличествоСтрок");
	
	Поиск = Новый Структура("КоличествоСтрок", 1);
	
	МассивСтрок = СвернутаяТаблица.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СвернутаяТаблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Поиск = Новый Структура(КолонкиГруппировок);
	
	Для Каждого СтрокаСвернутойТаблицы Из СвернутаяТаблица Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТаблицы);
		
		МассивСтрок = ПроверяемаяТаблица.НайтиСтроки(Поиск);
		
		НоваяСтрока = ТаблицаСообщений.Добавить();
		НоваяСтрока.НомерСтроки = МассивСтрок[МассивСтрок.Количество() - 1].НомерСтроки;
		НоваяСтрока.ДублиСтрок = Новый Массив();
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НоваяСтрока.ДублиСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаСообщений;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыПроверкиРаздела21(ОбщиеПараметры)
	
	ИменаПолейФактическогоНаличия = Новый Массив();
	ИменаПолейФактическогоНаличия.Добавить("НачальныйНомер");
	ИменаПолейФактическогоНаличия.Добавить("КонечныйНомер");
	ИменаПолейФактическогоНаличия.Добавить("Количество");
	ИменаПолейФактическогоНаличия.Добавить("Сумма");
	
	ИменаПолейНеСоответствуетБСО = Новый Массив();
	ИменаПолейНеСоответствуетБСО.Добавить("НачальныйНомерНеСоответствует");
	ИменаПолейНеСоответствуетБСО.Добавить("КонечныйНомерНеСоответствует");
	ИменаПолейНеСоответствуетБСО.Добавить("КоличествоНеСоответствует");
	ИменаПолейНеСоответствуетБСО.Добавить("СуммаНеСоответствует");
	ИменаПолейНеСоответствуетБСО.Добавить("Статус");
	
	ИменаПолейНеСоответствуетДенежныйДокумент = Новый Массив();
	ИменаПолейНеСоответствуетДенежныйДокумент.Добавить("СуммаНеСоответствует");
	ИменаПолейНеСоответствуетДенежныйДокумент.Добавить("Статус");
	Если ОбщиеПараметры.ВестиКоличественныйУчетДенежныхДокументов Тогда
		ИменаПолейНеСоответствуетДенежныйДокумент.Добавить("КоличествоНеСоответствует");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("МетаданныеРеквизитовТЧ",						Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти.Раздел21.Реквизиты);
	ДополнительныеПараметры.Вставить("ВидДокументаБСО",								Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ДополнительныеПараметры.Вставить("ВидДокументаДенежныеДокументы",				Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	ДополнительныеПараметры.Вставить("ИменаПолейФактическогоНаличия",				ИменаПолейФактическогоНаличия);
	ДополнительныеПараметры.Вставить("ИменаПолейНеСоответствуетБСО",				ИменаПолейНеСоответствуетБСО);
	ДополнительныеПараметры.Вставить("ИменаПолейНеСоответствуетДенежныйДокумент",	ИменаПолейНеСоответствуетДенежныйДокумент);
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти",							"Раздел21");
	ДополнительныеПараметры.Вставить("ПредставлениеТабличнойЧасти",					"Раздел 2.1");
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьОбщиеПараметрыПроверкиВсехРазделов(ДокументОбъект, ВестиКоличественныйУчетДенежныхДокументов = Неопределено)
	
	ЭтоБСО				= (ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	Если ВестиКоличественныйУчетДенежныхДокументов = Неопределено Тогда
		ВестиКоличественныйУчетДенежныхДокументов = ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов");
	КонецЕсли;
	
	РедактируетсяКоличество = ЭтоБСО Или (ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов);
	
	ОбщиеПараметры = Новый Структура();
	ОбщиеПараметры.Вставить("ЭтоБСО",										ЭтоБСО);
	ОбщиеПараметры.Вставить("ЭтоДенежныйДокумент",							ЭтоДенежныйДокумент);
	ОбщиеПараметры.Вставить("ВестиКоличественныйУчетДенежныхДокументов",	ВестиКоличественныйУчетДенежныхДокументов);
	ОбщиеПараметры.Вставить("РедактируетсяКоличество",						РедактируетсяКоличество);
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Функция ПолучитьТаблицуГраниц(ТаблицаФрагментов)
	
	ТаблицаГраниц = Новый ТаблицаЗначений();
	ТаблицаГраниц.Колонки.Добавить("Граница",			ОбщегоНазначения.ОписаниеТипаЧисло(20,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаГраниц.Колонки.Добавить("ДельтаКоличество",	ОбщегоНазначения.ОписаниеТипаЧисло(1,0,ДопустимыйЗнак.Любой));
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментов Цикл
		НоваяСтрока = ТаблицаГраниц.Добавить();
		НоваяСтрока.Граница = СтрокаТаблицы.НачальныйНомер;
		НоваяСтрока.ДельтаКоличество = 1;
		
		НоваяСтрока = ТаблицаГраниц.Добавить();
		НоваяСтрока.Граница = СтрокаТаблицы.КонечныйНомер + 1;
		НоваяСтрока.ДельтаКоличество = -1;
	КонецЦикла;
	
	ТаблицаГраниц.Свернуть("Граница", "ДельтаКоличество");
	ТаблицаГраниц.Сортировать("Граница");
	
	ТаблицаГраниц.Колонки.Добавить("МножительКоличества", ОбщегоНазначения.ОписаниеТипаЧисло(1,0,ДопустимыйЗнак.Любой));
	
	МножительКоличества = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаГраниц Цикл
		МножительКоличества = МножительКоличества + СтрокаТаблицы.ДельтаКоличество;
		
		СтрокаТаблицы.МножительКоличества = МножительКоличества;
	КонецЦикла;
	
	Возврат ТаблицаГраниц;
	
КонецФункции

Функция ДиагностироватьПорокиДиапазонов(ТаблицаГраниц, НачальныйНомерИсходногоДиапазона, КонечныйНомерИсходногоДиапазона)
	
	Пересечения	= Новый Массив();
	Окна		= Новый Массив();
	
	НомерСтроки = 0;
	КоличествоСтрок = ТаблицаГраниц.Количество();
	
	// Проверим непрерывность диапазонов номеров во фрагментах строк.
	Для Каждого СтрокаТаблицы Из ТаблицаГраниц Цикл
		НомерСтроки = НомерСтроки + 1;
		
		МножительКоличества = СтрокаТаблицы.МножительКоличества;
		
		ЭтоПоследняяСтрока = (НомерСтроки = КоличествоСтрок);
		
		Если МножительКоличества = 1 Или ЭтоПоследняяСтрока Тогда
			Продолжить;
		КонецЕсли;
		
		СледующаяСтрока = ТаблицаГраниц[НомерСтроки];
		
		ОписаниеДиапазона = ПолучитьПустоеОписаниеДиапазонаНомеровБСО();
		ОписаниеДиапазона.НачальныйНомер	= СтрокаТаблицы.Граница;
		ОписаниеДиапазона.КонечныйНомер		= СледующаяСтрока.Граница - 1;
		
		Если МножительКоличества = 0 Тогда
			Окна.Добавить(ОписаниеДиапазона);
			
		ИначеЕсли МножительКоличества >= 2 Тогда
			Пересечения.Добавить(ОписаниеДиапазона);
		КонецЕсли;
	КонецЦикла;
	
	ПорокиДиапазонов = Новый Структура("
		|Пересечения,
		|Окна,
		|Лишние,
		|Отсутствующие");
	
	ПорокиДиапазонов.Пересечения	= Пересечения;
	ПорокиДиапазонов.Окна			= Окна;
	ПорокиДиапазонов.Лишние			= Новый Массив();
	ПорокиДиапазонов.Отсутствующие	= Новый Массив();
	
	Если Окна.Количество() = 0 И Пересечения.Количество() = 0 Тогда
		// Проверим взаимное совпадение диапазонов исходной строки и объединенного диапазона фрагментов строк.
		
		ЗаполнитьЛишниеИОтсутствующиеДиапазоныНомеровБСО(ПорокиДиапазонов, ТаблицаГраниц, НачальныйНомерИсходногоДиапазона, КонечныйНомерИсходногоДиапазона);
	КонецЕсли;
	
	Возврат ПорокиДиапазонов;
	
КонецФункции

Процедура ЗаполнитьЛишниеИОтсутствующиеДиапазоныНомеровБСО(ПорокиДиапазонов, ТаблицаГраниц, НачальныйНомерИсходногоДиапазона, КонечныйНомерИсходногоДиапазона)
	
	Лишние			= Новый Массив();
	Отсутствующие	= Новый Массив();
	
	НачальныйНомерФрагментовСтрок	= ТаблицаГраниц[0].Граница;
	КонечныйНомерФрагментовСтрок	= ТаблицаГраниц[ТаблицаГраниц.Количество() - 1].Граница - 1;
	
	Если НачальныйНомерФрагментовСтрок = НачальныйНомерИсходногоДиапазона
		И КонечныйНомерФрагментовСтрок = КонечныйНомерИсходногоДиапазона Тогда
		// Диапазоны полностью совпадают. Ничего не делаем.
		
	ИначеЕсли НачальныйНомерФрагментовСтрок = НачальныйНомерИсходногоДиапазона Тогда
		
		Если КонечныйНомерФрагментовСтрок < КонечныйНомерИсходногоДиапазона Тогда
			// Случай 7
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				КонечныйНомерФрагментовСтрок + 1,
				КонечныйНомерИсходногоДиапазона);
		Иначе
			// Случай 8
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				КонечныйНомерИсходногоДиапазона + 1,
				КонечныйНомерФрагментовСтрок);
		КонецЕсли;
		
	ИначеЕсли КонечныйНомерФрагментовСтрок = КонечныйНомерИсходногоДиапазона Тогда
		
		Если НачальныйНомерФрагментовСтрок < НачальныйНомерИсходногоДиапазона Тогда
			// Случай 9
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				НачальныйНомерФрагментовСтрок,
				НачальныйНомерИсходногоДиапазона - 1);
		Иначе
			// Случай 10
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				НачальныйНомерИсходногоДиапазона,
				НачальныйНомерФрагментовСтрок - 1);
		КонецЕсли;
		
	ИначеЕсли НачальныйНомерФрагментовСтрок < НачальныйНомерИсходногоДиапазона Тогда
		
		Если КонечныйНомерФрагментовСтрок < НачальныйНомерИсходногоДиапазона Тогда
			// Случай 1
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				НачальныйНомерФрагментовСтрок,
				КонечныйНомерФрагментовСтрок);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				НачальныйНомерИсходногоДиапазона,
				КонечныйНомерИсходногоДиапазона);
			
		ИначеЕсли КонечныйНомерФрагментовСтрок < КонечныйНомерИсходногоДиапазона Тогда
			// Случай 2
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				НачальныйНомерФрагментовСтрок,
				НачальныйНомерИсходногоДиапазона - 1);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				КонечныйНомерФрагментовСтрок + 1,
				КонечныйНомерИсходногоДиапазона);
				
		Иначе
			// Случай 6
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				НачальныйНомерФрагментовСтрок,
				НачальныйНомерИсходногоДиапазона - 1);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				КонечныйНомерИсходногоДиапазона + 1,
				КонечныйНомерФрагментовСтрок);
		КонецЕсли;
		
	ИначеЕсли НачальныйНомерФрагментовСтрок > НачальныйНомерИсходногоДиапазона Тогда
		
		Если КонечныйНомерФрагментовСтрок < КонечныйНомерИсходногоДиапазона Тогда
			// Случай 3
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				НачальныйНомерИсходногоДиапазона,
				НачальныйНомерФрагментовСтрок - 1);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				КонечныйНомерФрагментовСтрок + 1,
				КонечныйНомерИсходногоДиапазона);
		
		ИначеЕсли НачальныйНомерФрагментовСтрок < КонечныйНомерИсходногоДиапазона Тогда
			// Случай 4
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				НачальныйНомерИсходногоДиапазона,
				НачальныйНомерФрагментовСтрок - 1);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				КонечныйНомерИсходногоДиапазона + 1,
				КонечныйНомерФрагментовСтрок);
		Иначе
			// Случай 5
			ДобавитьОписаниеДиапазонаНомеровБСО(Отсутствующие,
				НачальныйНомерИсходногоДиапазона,
				КонечныйНомерИсходногоДиапазона);
			
			ДобавитьОписаниеДиапазонаНомеровБСО(Лишние,
				НачальныйНомерФрагментовСтрок,
				КонечныйНомерФрагментовСтрок);
		КонецЕсли;
	КонецЕсли;
	
	ПорокиДиапазонов.Лишние			= Лишние;
	ПорокиДиапазонов.Отсутствующие	= Отсутствующие;
	
КонецПроцедуры

Процедура ДобавитьОписаниеДиапазонаНомеровБСО(Коллекция, НачальныйНомер, КонечныйНомер)
	
	ОписаниеДиапазона = ПолучитьПустоеОписаниеДиапазонаНомеровБСО();
	
	ОписаниеДиапазона.НачальныйНомер	= НачальныйНомер;
	ОписаниеДиапазона.КонечныйНомер		= КонечныйНомер;
	
	Коллекция.Добавить(ОписаниеДиапазона);
	
КонецПроцедуры

Функция ПолучитьПустоеОписаниеДиапазонаНомеровБСО()
	
	Возврат Новый Структура("НачальныйНомер, КонечныйНомер", 0, 0);
	
КонецФункции

Процедура ВывестиСообщенияОПорокахДиапазонов(ПорокиДиапазонов, ТаблицаФрагментов, Отказ)
	
	Пересечения		= ПорокиДиапазонов.Пересечения;
	Окна			= ПорокиДиапазонов.Окна;
	Лишние			= ПорокиДиапазонов.Лишние;
	Отсутствующие	= ПорокиДиапазонов.Отсутствующие;
	
	Если Пересечения.Количество() = 0 И Окна.Количество() = 0 И Лишние.Количество() = 0 И Отсутствующие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Для Каждого ОписаниеДиапазона Из Пересечения Цикл
		ВывестиСообщениеОДиапазонеНомеров(ОписаниеДиапазона, ТаблицаФрагментов, НСтр("ru='Дубли номеров с %1 по %2 (строка %3)'"));
	КонецЦикла;
	
	Для Каждого ОписаниеДиапазона Из Окна Цикл
		ВывестиСообщениеОДиапазонеНомеров(ОписаниеДиапазона, ТаблицаФрагментов, НСтр("ru='Отсутствуют номера с %1 по %2'"));
	КонецЦикла;
	
	Для Каждого ОписаниеДиапазона Из Лишние Цикл
		ВывестиСообщениеОДиапазонеНомеров(ОписаниеДиапазона, ТаблицаФрагментов, НСтр("ru='Лишние номера с %1 по %2 по сравнению с разбиваемым диапазоном (строка %3)'"));
	КонецЦикла;
	
	Для Каждого ОписаниеДиапазона Из Отсутствующие Цикл
		ВывестиСообщениеОДиапазонеНомеров(ОписаниеДиапазона, ТаблицаФрагментов, НСтр("ru='Отсутствуют номера с %1 по %2 по сравнению с разбиваемым диапазоном'"));
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСообщениеОДиапазонеНомеров(ОписаниеДиапазона, ТаблицаФрагментов, ШаблонСообщения)
	
	ИмяРеквизитаТаблицы = "ТаблицаФрагментыСтроки";
	
	ПоискНачальныйНомер = Новый Структура("НачальныйНомер", ОписаниеДиапазона.НачальныйНомер);
	
	МассивСтрок = ТаблицаФрагментов.НайтиСтроки(ПоискНачальныйНомер);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ИмяПоляДляВыводаСообщения = "НачальныйНомер";
		
		СтрокаТаблицы = МассивСтрок[МассивСтрок.ВГраница()];
		
		НомерСтроки = ТаблицаФрагментов.Индекс(СтрокаТаблицы) + 1;
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			Формат(ОписаниеДиапазона.НачальныйНомер, "ЧГ=0"),
			Формат(ОписаниеДиапазона.КонечныйНомер, "ЧГ=0"),
			НомерСтроки);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяРеквизитаТаблицы, НомерСтроки, ИмяПоляДляВыводаСообщения));
			
		Возврат;
	КонецЕсли;
	
	ПоискКонечныйНомер = Новый Структура("КонечныйНомер", ОписаниеДиапазона.КонечныйНомер);
	
	МассивСтрок = ТаблицаФрагментов.НайтиСтроки(ПоискКонечныйНомер);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ИмяПоляДляВыводаСообщения = "КонечныйНомер";
		
		СтрокаТаблицы = МассивСтрок[МассивСтрок.ВГраница()];
		
		НомерСтроки = ТаблицаФрагментов.Индекс(СтрокаТаблицы) + 1;
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			Формат(ОписаниеДиапазона.НачальныйНомер, "ЧГ=0"),
			Формат(ОписаниеДиапазона.КонечныйНомер, "ЧГ=0"),
			НомерСтроки);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяРеквизитаТаблицы, НомерСтроки, ИмяПоляДляВыводаСообщения));
			
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(ШаблонСообщения,
		Формат(ОписаниеДиапазона.НачальныйНомер, "ЧГ=0"),
		Формат(ОписаниеДиапазона.КонечныйНомер, "ЧГ=0"));
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
		ИмяРеквизитаТаблицы);
		
КонецПроцедуры

Процедура ПроверитьЗаполнениеКолонокТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти, ИменаКолонокСтрокой, Отказ, МетаданныеДокумента, СинонимыКолонок = Неопределено, ПеренаправлениеВыводаСообщений = Неопределено, МаксимальноеКоличествоСообщений = 100)
	
	СинонимТабличнойЧасти = МетаданныеДокумента.ТабличныеЧасти[ИмяТабличнойЧасти].Синоним;
	
	МетаданныеРеквизитов = МетаданныеДокумента.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
	
	ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧасти];
	
	ИменаКолонок = СтрРазделить(ИменаКолонокСтрокой, ", ", Ложь);
	
	Если СинонимыКолонок = Неопределено Тогда
		СинонимыКолонок = Новый Структура();
	КонецЕсли;
	
	Если ПеренаправлениеВыводаСообщений = Неопределено Тогда
		ПеренаправлениеВыводаСообщений = Новый Структура();
	КонецЕсли;
	
	КоличествоСообщений = 0;
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонки]) Тогда
				Отказ = Истина;
				
				КоличествоСообщений = КоличествоСообщений + 1;
				
				Если КоличествоСообщений > МаксимальноеКоличествоСообщений Тогда
					Возврат;
				КонецЕсли;
				
				СинонимКолонки = ?(СинонимыКолонок.Свойство(ИмяКолонки), СинонимыКолонок[ИмяКолонки], МетаданныеРеквизитов[ИмяКолонки].Синоним);
				
				ИмяПоляДляВывода = ?(ПеренаправлениеВыводаСообщений.Свойство(ИмяКолонки), ПеренаправлениеВыводаСообщений[ИмяКолонки], ИмяКолонки);
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					СинонимКолонки, СтрокаТаблицы.НомерСтроки, СинонимТабличнойЧасти);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, ИмяПоляДляВывода),
					"Объект");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

