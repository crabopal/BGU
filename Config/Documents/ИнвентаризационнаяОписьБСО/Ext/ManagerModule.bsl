Функция ПолучитьДополнительныеПараметрыПечати0510465(ТаблицаСвойствБСОиДД)
	
	КолонкиПоиска = "ДокументВладелец,ДокументПодчиненный";
	
	ТаблицаСвойствБСОиДД.Индексы.Добавить(КолонкиПоиска);
	
	ВремТаблица = ТаблицаСвойствБСОиДД.СкопироватьКолонки();
	ПустаяСтрока = ВремТаблица.Добавить();
	
	ПустаяСтрокаСвойствБСОиДД = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ПустаяСтрока);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТаблицаСвойствБСОиДД",		ТаблицаСвойствБСОиДД);
	ДополнительныеПараметры.Вставить("ПоискСвойствБСОиДД",			Новый Структура(КолонкиПоиска));
	ДополнительныеПараметры.Вставить("ПустаяСтрокаСвойствБСОиДД",	ПустаяСтрокаСвойствБСОиДД);
	ДополнительныеПараметры.Вставить("СтрокаШапки",					Неопределено);
	
	ДополнительныеПараметры.Вставить("ВидДокументаБСО",					Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ДополнительныеПараметры.Вставить("ВидДокументаДенежныйДокумент",	Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	ДополнительныеПараметры.Вставить("ШаблонДиапазонаНомеров",			"%1//%2");
	
	ДополнительныеПараметры.Вставить("ИспользоватьПредставленияНомеровБСО",	ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО());
	
	ДополнительныеПараметры.Вставить("РазмерыРазделов",	Новый Структура());
	
	ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	
	ДополнительныеПараметры.Вставить("СтруктурыДляЗаполненияСерииЦены", ПолучитьСтруктурыДляЗаполненияСерииЦены());
	
	ДополнительныеПараметры.Вставить("СтруктурыДляЗаполненияНомеров", ПолучитьСтруктурыДляЗаполненияНомеров());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	// Для пустых Серии и Номеров применяем не прочерк, а число 0.
	
	Разделитель = ", ";
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Раздел1", "НаименованиеЕдИзм,КодЕдИзм");
	ИменаПолей.Вставить("Раздел21_НаборКолонок1", "НаименованиеЕдИзм,КодЕдИзм");
	ИменаПолей.Вставить("Раздел21_НаборКолонок2", "КодСтатуса,НаименованиеСтатуса");
	ИменаПолей.Вставить("Раздел22_НаборКолонок1", "НаименованиеЕдИзм,КодЕдИзм,КодСтатуса,НаименованиеСтатуса");
	ИменаПолей.Вставить("Раздел3_НаборКолонок1", "НаименованиеЕдИзм,КодЕдИзм");
	ИменаПолей.Вставить("Раздел3_НаборКолонок2", "НаименованиеДокумента,НомерДокумента,ДатаДокумента");
	ИменаПолей.Вставить("Раздел3_НаборКолонок3", "НедостачаНеПодтверждено,ОбъяснениеПричинРасхождений");
	ИменаПолей.Вставить("Раздел4_НаборКолонок1", "НаименованиеЕдИзм,КодЕдИзм,КодСтатуса,НаименованиеСтатуса");
	ИменаПолей.Вставить("Раздел4_НаборКолонок2", "СтатусОбъяснения,ЗаключениеКомиссии");
	
	ДополнительныеСимволыПустыхПолей = Новый Структура();
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("Серия", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел1", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("Серия", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел21_НаборКолонок1", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияНеСоответствует", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел21_НаборКолонок2", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияНеСоответствует", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел22_НаборКолонок1", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияИзлишки,СерияНедостача", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел22_НаборКолонок2", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияИзлишки,СерияНедостача", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел3_НаборКолонок1", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияИзлишкиПодтверждено,СерияНедостачаПодтверждено", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел3_НаборКолонок2", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияИзлишкиНеПодтверждено,СерияНедостачаНеПодтверждено", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел3_НаборКолонок3", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияНеСоответствует", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел4_НаборКолонок1", СимволыПустыхПолей);
	
	СимволыПустыхПолей = Новый Соответствие();
	СимволыПустыхПолей.Вставить("СерияИзлишкиНеПодтверждено,СерияНедостачаНеПодтверждено", "0");
	ДополнительныеСимволыПустыхПолей.Вставить("Раздел4_НаборКолонок2", СимволыПустыхПолей);
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей, ДополнительныеСимволыПустыхПолей);
	
КонецФункции

Функция СформироватьПечатнуюФорму0510465(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	Перем ОписаниеСерииДокументов, СтрокаШапкиДокументаСРаспиской;
	
	КлючПараметровПечати = "ПечатьФормы0510465";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ИнвентаризацияСервер.ЗаполнитьРазмерыРазделов(Данные, "Раздел1,Раздел21,Раздел22,Раздел3,Раздел4", СтрокаШапки.Ссылка);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	СведенияМОЛ = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.МОЛ, СтрокаШапки.Дата);
	
	ЗначенияПараметров.Вставить("ОтветственноеЛицо",	СтрШаблон("%1 %2", СведенияМОЛ.ДолжностьНаименование, СведенияМОЛ.ФИОПолное));
	ЗначенияПараметров.Вставить("УчетныйНомер",			СведенияМОЛ.Код);
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерДокументаДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.РешениеОПроведенииИнвентаризации,
		СтрокаШапки.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("Дата",				СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер",			НомерДокументаДляПечати);
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапки.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапки.НомерКомиссии, СтрокаШапки.НомерРабочейКомиссии, Истина));
	
	КодСчета = СтрШаблон("%1.%2",
		?(ЗначениеЗаполнено(СтрокаШапки.КФО), Строка(СтрокаШапки.КФО), "0"),
		?(ЗначениеЗаполнено(СтрокаШапки.Счет), Строка(СтрокаШапки.Счет), "000.00"));
	
	ЗначенияПараметров.Вставить("КодСчета", КодСчета);
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	Область.Параметры.Заполнить(СведенияМОЛ);
	
	ТабДокумент.Вывести(Область);
	
	Данные.ДополнительныеПараметры.СтрокаШапки = СтрокаШапки;
	
	// РАЗДЕЛ 1

	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 2
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии:'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапки.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел2, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 3
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// ЗАГОЛОВОК
	
	КоличествоСтрок = Данные.ДополнительныеПараметры.РазмерыРазделов.Раздел21.КодСтроки;
	
	НачальныйНомер	= ?(КоличествоСтрок = 0, 0, 1);
	КонечныйНомер	= КоличествоСтрок;
	
	ФорматнаяСтрокаНомеров = "ЧН=-;ЧГ=-";
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НачальныйНомер", Формат(НачальныйНомер, ФорматнаяСтрокаНомеров));
	ЗначенияПараметров.Вставить("КонечныйНомер", Формат(КонечныйНомер, ФорматнаяСтрокаНомеров));
	
	Область = ОбластиМакета.Раздел3Заголовок;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// В случае отсутствия расхождений (излишков и (или) недостачи) табличная часть Раздела 3 и перечень приложений
	// к нему не формируются, и в копии электронной Инвентаризационной описи (ф. 0510465) на бумажном носителе
	// не отображается.
	Если Данные.ДополнительныеПараметры.РазмерыРазделов.Раздел3.НомерСтроки > 0 Тогда
		// ТАБЛИЦА
		ВывестиРаздел3(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		// ПРИЛОЖЕНИЯ
		УправлениеПечатьюБГУ.ВывестиПриложенияПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.Приложение);
	КонецЕсли;
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	СведенияМОЛ.Вставить("Заголовок", НСтр("ru='Ответственное лицо (ответственное лицо группы лиц)'"));
	Область.Параметры.Заполнить(СведенияМОЛ);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 4
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел4(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 4
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии:'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапки.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел4, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции


