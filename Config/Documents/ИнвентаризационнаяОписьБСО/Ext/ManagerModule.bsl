Процедура ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела21(ПараметрыФункции)
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ
	|	*,
	|	НомерСтроки	КАК КодСтроки
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидДокумента	КАК ВидДокумента
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросЗаполнение.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
