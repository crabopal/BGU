Функция ПолучитьДанныеУчета(ПараметрыПроцедуры) Экспорт
	
	// БСО
	ОстаткиБСО = ПолучитьОстаткиБСО(ПараметрыПроцедуры);
	
	// Денежные документы
	ОстаткиДенежныхДокументов = ПолучитьОстаткиДенежныхДокументов(ПараметрыПроцедуры);
	
	// Общая таблица
	ТаблицаДляРаздела1 = ОстаткиБСО.ОстаткиДляРаздела1;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ОстаткиДенежныхДокументов.ОстаткиДляРаздела1, ТаблицаДляРаздела1);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаДляРаздела1",		ТаблицаДляРаздела1);
	Результат.Вставить("ОстаткиБСО",				ОстаткиБСО.ОстаткиДляСписанияНедостач);
	Результат.Вставить("ОстаткиДенежныхДокументов",	ОстаткиДенежныхДокументов.ОстаткиДляСписанияНедостач);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела21(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела21(ПараметрыФункции);
	
	ТаблицаРаздела21 = ПараметрыФункции.ТаблицаРаздела1;
	
	Если ПараметрыФункции.СКоличеством Тогда
		ПрименитьМножительКоличества1(ТаблицаРаздела21, ПараметрыФункции);
	Иначе
		ТаблицаРаздела21.ЗаполнитьЗначения(0, "НачальныйНомер");
		ТаблицаРаздела21.ЗаполнитьЗначения(0, "КонечныйНомер");
		ТаблицаРаздела21.ЗаполнитьЗначения(0, "Количество");
		ТаблицаРаздела21.ЗаполнитьЗначения(0, "Сумма");
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела21", ТаблицаРаздела21);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела21(ФормаДокумента, ТекДанные) Экспорт
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		ФрагментыСтроки = ПолучитьФрагментыРазбитойСтрокиРаздела21(ДокументОбъект.Раздел21, ТекДанные);
		
		ИсходнаяСтрока = СобратьИсходнуюСтрокуРаздела21ПоФрагментам(ФрагментыСтроки);
		
		ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(ФрагментыСтроки);
	Иначе
		ФрагментыСтроки = Неопределено;
		
		ИсходнаяСтрока = ПолучитьПустуюСтруктуруСтрокиРаздела21();
		
		ЗаполнитьЗначенияСвойств(ИсходнаяСтрока, ТекДанные);
	КонецЕсли;
	
	ПараметрыФормыРазбивки = Новый Структура();
	ПараметрыФормыРазбивки.Вставить("ИсходнаяСтрока",	ИсходнаяСтрока);
	ПараметрыФормыРазбивки.Вставить("ФрагментыСтроки",	ФрагментыСтроки);
	ПараметрыФормыРазбивки.Вставить("ВидДокумента",		ДокументОбъект.ВидДокумента);
	ПараметрыФормыРазбивки.Вставить("ВестиКоличественныйУчетДенежныхДокументов");
	ПараметрыФормыРазбивки.Вставить("РедактируетсяКоличество");
	ПараметрыФормыРазбивки.Вставить("РедактируетсяСумма");
	ПараметрыФормыРазбивки.Вставить("РазрешеноРедактироватьСуммы");
	ПараметрыФормыРазбивки.Вставить("ЭтоБСО");
	ПараметрыФормыРазбивки.Вставить("ЭтоДенежныйДокумент");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФормыРазбивки, ФормаДокумента,
		"ВестиКоличественныйУчетДенежныхДокументов,РедактируетсяКоличество,РедактируетсяСумма,РазрешеноРедактироватьСуммы,ЭтоБСО,ЭтоДенежныйДокумент");
	
	Возврат ПараметрыФормыРазбивки;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела22(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела22(ПараметрыФункции);
	
