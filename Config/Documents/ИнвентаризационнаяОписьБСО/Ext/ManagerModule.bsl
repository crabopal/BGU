Функция СобратьИсходнуюСтрокуРаздела3ПоФрагментам(ФрагментыСтроки)
	
	СтруктураИсходнойСтроки = ПолучитьПустуюСтруктуруСтрокиРаздела3();
	
	МинимальныйНачальныйНомерИзлишки = Неопределено;
	МинимальныйНачальныйНомерНедостача = Неопределено;
	
	МаксимальныйКонечныйНомерИзлишки = Неопределено;
	МаксимальныйКонечныйНомерНедостача = Неопределено;
	
	НачальныйНомерИзлишкиПредставление = "";
	КонечныйНомерИзлишкиПредставление = "";
	НачальныйНомерНедостачаПредставление = "";
	КонечныйНомерНедостачаПредставление = "";
	
	Для Каждого ФрагментСтроки Из ФрагментыСтроки Цикл
		Если ЗначениеЗаполнено(ФрагментСтроки.НачальныйНомерИзлишки)
			И (МинимальныйНачальныйНомерИзлишки = Неопределено Или ФрагментСтроки.НачальныйНомерИзлишки < МинимальныйНачальныйНомерИзлишки) Тогда
			МинимальныйНачальныйНомерИзлишки = ФрагментСтроки.НачальныйНомерИзлишки;
			НачальныйНомерИзлишкиПредставление = ФрагментСтроки.НачальныйНомерИзлишкиПредставление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФрагментСтроки.КонечныйНомерИзлишки)
			И (МаксимальныйКонечныйНомерИзлишки = Неопределено Или ФрагментСтроки.КонечныйНомерИзлишки > МаксимальныйКонечныйНомерИзлишки) Тогда
			МаксимальныйКонечныйНомерИзлишки = ФрагментСтроки.КонечныйНомерИзлишки;
			КонечныйНомерИзлишкиПредставление = ФрагментСтроки.КонечныйНомерИзлишкиПредставление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФрагментСтроки.НачальныйНомерНедостача)
			И (МинимальныйНачальныйНомерНедостача = Неопределено Или ФрагментСтроки.НачальныйНомерНедостача < МинимальныйНачальныйНомерНедостача) Тогда
			МинимальныйНачальныйНомерНедостача = ФрагментСтроки.НачальныйНомерНедостача;
			НачальныйНомерНедостачаПредставление = ФрагментСтроки.НачальныйНомерНедостачаПредставление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФрагментСтроки.КонечныйНомерНедостача)
			И (МаксимальныйКонечныйНомерНедостача = Неопределено Или ФрагментСтроки.КонечныйНомерНедостача > МаксимальныйКонечныйНомерНедостача) Тогда
			МаксимальныйКонечныйНомерНедостача = ФрагментСтроки.КонечныйНомерНедостача;
			КонечныйНомерНедостачаПредставление = ФрагментСтроки.КонечныйНомерНедостачаПредставление;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураИсходнойСтроки, ФрагментыСтроки[0]);
	
	СтруктураИсходнойСтроки.НачальныйНомерИзлишки				= МинимальныйНачальныйНомерИзлишки;
	СтруктураИсходнойСтроки.КонечныйНомерИзлишки				= МаксимальныйКонечныйНомерИзлишки;
	СтруктураИсходнойСтроки.НачальныйНомерИзлишкиПредставление	= НачальныйНомерИзлишкиПредставление;
	СтруктураИсходнойСтроки.КонечныйНомерИзлишкиПредставление	= КонечныйНомерИзлишкиПредставление;
	
	СтруктураИсходнойСтроки.НачальныйНомерНедостача				= МинимальныйНачальныйНомерНедостача;
	СтруктураИсходнойСтроки.КонечныйНомерНедостача				= МаксимальныйКонечныйНомерНедостача;
	СтруктураИсходнойСтроки.НачальныйНомерНедостачаПредставление= НачальныйНомерНедостачаПредставление;
	СтруктураИсходнойСтроки.КонечныйНомерНедостачаПредставление	= КонечныйНомерНедостачаПредставление;
	
	СтруктураИсходнойСтроки.КоличествоИзлишки	= ФрагментыСтроки.Итог("КоличествоИзлишки");
	СтруктураИсходнойСтроки.СуммаИзлишки		= ФрагментыСтроки.Итог("СуммаИзлишки");
	
	СтруктураИсходнойСтроки.КоличествоНедостача	= ФрагментыСтроки.Итог("КоличествоНедостача");
	СтруктураИсходнойСтроки.СуммаНедостача		= ФрагментыСтроки.Итог("СуммаНедостача");
	
	Возврат СтруктураИсходнойСтроки;
	
КонецФункции

