КонецФункции

Функция ПолучитьДанныеДляРаздела4(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела4(ПараметрыФункции);
	
	ТаблицаРаздела4 = ПараметрыФункции.ТаблицаРаздела4;
	
	ИнвентаризацияСервер.ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(ТаблицаРаздела4,
		Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти.Раздел4);
	
	ИнвентаризацияСервер.ЗаполнитьСтатусОбъясненияНеТребуется(ТаблицаРаздела4, ПараметрыФункции.ДокументСсылка);
	
	ВыявленыОтклонения = (ТаблицаРаздела4.Количество() > 0);
	
	Если Не ВыявленыОтклонения Тогда
		// В случае если по итогам инвентаризации не выявлены недостача (излишки) объектов инвентаризации,
		// а также инвентаризационной комиссией не установлены объекты инвентаризации, имеющие признаки
		// несоответствия условиям актива, общий результат инвентаризации бланков строгой отчетности,
		// денежных документов отражается в Разделе 4 в одной строке, в которой по графам 1 - 23 отражаются нули,
		// в графе 24 отражается заключение инвентаризационной комиссии - "Отклонения не выявлены".
		
		ТаблицаРаздела4.Очистить();
		
		НоваяСтрока = ТаблицаРаздела4.Добавить();
		
		НоваяСтрока.ЗаключениеКомиссии = ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ПараметрыФункции.ДокументСсылка);
		НоваяСтрока.СтатусОбъяснения = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела4",		ТаблицаРаздела4);
	Результат.Вставить("ВыявленыОтклонения",	ВыявленыОтклонения);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// Заменить пустой статус объяснения на значение "0" в подходящих строках раздела 4.
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.Раздел4 КАК ТЧРаздел4
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьБСО КАК Док
	|		ПО ТЧРаздел4.Ссылка = Док.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И ТЧРаздел4.СтатусОбъяснения = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъясненияОтветственногоЛица.ПустаяСсылка)
	|	// Текущие условия применения статуса ""0"" из релиза на момент обновления.
	|	// Отличаются от условий в обновлении.
	|	И ТЧРаздел4.КоличествоНедостачаНеПодтверждено = 0 И ТЧРаздел4.КоличествоИзлишкиНеПодтверждено = 0";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления
	
	// Действия обработчика обновления:
	// Заменить пустой статус объяснения на значение "0" в подходящих строках раздела 4.
	
	МетаданныеОбъекта = Метаданные.Документы.ИнвентаризационнаяОписьБСО;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку объектов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	СтатусОбъяснениеНеТребуется = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ДокументСсылка = Выборка.Ссылка;
			
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			
			Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел4 Цикл
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтатусОбъяснения)
					// Текущие условия применения статуса "0" из релиза на момент обновления.
					// Отличаются от условий в обновлении.
					И СтрокаТаблицы.КоличествоНедостачаНеПодтверждено = 0 И СтрокаТаблицы.КоличествоИзлишкиНеПодтверждено = 0 Тогда
					
					СтрокаТаблицы.СтатусОбъяснения = СтатусОбъяснениеНеТребуется;
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить наименование объекта %1 по причине %2'"),
				ПолноеИмяОбъекта,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеОбъекта,
				ДокументСсылка,
				ТекстСообщения);
		КонецПопытки;
	
	КонецЦикла;
	
	Для Каждого НеобработанныйОбъект Из ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработана очередная порция объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ОбъектовОбработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеУчетныхДокументовПоОтклонениям

// Выполняет запрос для формирования временных таблиц, используемых при заполнении учетных документов
// на основании инвентаризационной описи.
// Запрос выполняется в привилегированном режиме, чтобы не возникало ошибки, если документы вводит пользователь
// у которого нет прав на чтение некоторых видов документов, вводимых на основании инвентаризации. 
// 
// Параметры:
//  Запрос - Запрос
//  Инвентаризация - ДокументСсылка.ИнвентаризационнаяОписьБСО, Массив из ДокументСсылка.ИнвентаризационнаяОписьБСО -
//  УчетныйДокументСсылка - ДокументСсылка, Неопределено - Учетный документ, в котором выполняется заполнение
Процедура ЗапросДанныхДокументаИнвентаризации(Запрос, Инвентаризация, УчетныйДокументСсылка = Неопределено) Экспорт
	
	ИменаУчетныхДокументов = Новый Массив;
	ИменаУчетныхДокументов.Добавить("ПоступлениеБСО");
	ИменаУчетныхДокументов.Добавить("СписаниеБСО");
	ИменаУчетныхДокументов.Добавить("ПриходныйОрдерФондовый");
	ИменаУчетныхДокументов.Добавить("РасходныйОрдерФондовый");
	УправлениеНФА.ДобавитьВПараметрыЗапросаИнвентаризацииУчетныеДокументы(
		Запрос, ИменаУчетныхДокументов, УчетныйДокументСсылка);
	
	Запрос.Текст = УправлениеНФА.ТекстЗапросаУчетныеДокументыВводОтклоненийПоИнвентаризации(ИменаУчетныхДокументов)
	+ ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	НФАУчетныхДокументов1.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	НФАУчетныхДокументов1.НФА КАК НФА,
	|	НФАУчетныхДокументов1.СерияБСО КАК СерияБСО,
	|	НФАУчетныхДокументов1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	НФАУчетныхДокументов1.ВидОтклонения КАК ВидОтклонения,
	|	НФАУчетныхДокументов1.МестоИнвентаризации КАК МестоИнвентаризации,
	|	СУММА(НФАУчетныхДокументов1.Количество) КАК Количество
	|ПОМЕСТИТЬ НФАУчетныхДокументов
	|ИЗ
	|	НФАУчетныхДокументов1 КАК НФАУчетныхДокументов1
	|
	|СГРУППИРОВАТЬ ПО
	|	НФАУчетныхДокументов1.ДокументИнвентаризации,
	|	НФАУчетныхДокументов1.НФА,
	|	НФАУчетныхДокументов1.СерияБСО,
	|	НФАУчетныхДокументов1.ИнвентарныйНомер,
	|	НФАУчетныхДокументов1.ВидОтклонения,
	|	НФАУчетныхДокументов1.МестоИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризационнаяОписьБСООстаткиБСО.БСО КАК БСО,
	|	ИнвентаризационнаяОписьБСООстаткиБСО.СерияБСО КАК СерияБСО,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвентаризационнаяОписьБСООстаткиБСО.СчетУчета) КАК КоличествоСчетУчета,
	|	МАКСИМУМ(ИнвентаризационнаяОписьБСООстаткиБСО.КФО) КАК КФО,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвентаризационнаяОписьБСООстаткиБСО.КФО) КАК КоличествоКФО,
	|	МАКСИМУМ(ИнвентаризационнаяОписьБСООстаткиБСО.СчетУчета) КАК СчетУчета
	|ПОМЕСТИТЬ ОстаткиБСО
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.ОстаткиБСО КАК ИнвентаризационнаяОписьБСООстаткиБСО
	|ГДЕ
	|	ИнвентаризационнаяОписьБСООстаткиБСО.Ссылка В(&ДокументыИнвентаризации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИнвентаризационнаяОписьБСООстаткиБСО.БСО,
	|	ИнвентаризационнаяОписьБСООстаткиБСО.СерияБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.ДенежныйДокумент КАК ДенежныйДокумент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.КФО) КАК КоличествоКФО,
	|	МАКСИМУМ(ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.КФО) КАК КФО,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.КФО) КАК КоличествоКПС,
	|	МАКСИМУМ(ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.КПС) КАК КПС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.Счет) КАК КоличествоСчет,
	|	МАКСИМУМ(ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.Счет) КАК Счет
	|ПОМЕСТИТЬ ОстаткиДенежныхДокументов
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.ОстаткиДенежныхДокументов КАК ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов
	|ГДЕ
	|	ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.Ссылка В(&ДокументыИнвентаризации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.ВидДенежногоДокумента,
	|	ИнвентаризационнаяОписьБСООстаткиДенежныхДокументов.ДенежныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Раздел1.Ссылка КАК Ссылка,
	|	Раздел1.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	Раздел1.ДенежныйДокумент КАК ДенежныйДокумент,
	|	Раздел1.БСО КАК БСО,
	|	Раздел1.Серия КАК Серия,
	|	Раздел1.ЕдИзм КАК ЕдИзм,
	|	Раздел1.НачальныйНомер КАК НачальныйНомер,
	|	Раздел1.КонечныйНомер КАК КонечныйНомер,
	|	Раздел1.Цена КАК Цена,
	|	Раздел1.Количество КАК Количество,
	|	Раздел1.Сумма КАК Сумма,
	|	Раздел1.МножительКоличества КАК МножительКоличества
	|ПОМЕСТИТЬ Раздел1
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.Раздел1 КАК Раздел1
	|ГДЕ
	|	Раздел1.Ссылка В(&ДокументыИнвентаризации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Раздел21.Ссылка КАК Ссылка,
	|	Раздел21.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	Раздел21.ДенежныйДокумент КАК ДенежныйДокумент,
	|	Раздел21.БСО КАК БСО,
	|	Раздел21.Серия КАК Серия,
	|	Раздел21.НачальныйНомер КАК НачальныйНомер,
	|	Раздел21.КонечныйНомер КАК КонечныйНомер,
	|	Раздел21.Цена КАК Цена,
	|	Раздел21.Количество КАК Количество,
	|	Раздел21.Сумма КАК Сумма
	|ПОМЕСТИТЬ Раздел21
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьБСО.Раздел21 КАК Раздел21
	|ГДЕ
	|	Раздел21.Ссылка В(&ДокументыИнвентаризации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Раздел4.Ссылка КАК Ссылка,
	|	Раздел4.НомерСтроки КАК НомерСтроки,
	|	Раздел4.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	Раздел4.ДенежныйДокумент КАК ДенежныйДокумент,
	|	Раздел4.БСО КАК БСО,
	|	Раздел4.Серия КАК Серия,
	|	Раздел4.ЕдИзм КАК ЕдИзм,
	|	Раздел4.Ссылка.МОЛ КАК МОЛШапки,
	|	Раздел4.Ссылка.МестоИнвентаризации КАК МестоИнвентаризации,
	|	Раздел4.СтатусОбъяснения КАК СтатусОбъяснения,
	|	Раздел4.НачальныйНомерНеСоответствует КАК НачальныйНомерНеСоответствует,
	|	Раздел4.КонечныйНомерНеСоответствует КАК КонечныйНомерНеСоответствует,
	|	Раздел4.КоличествоНеСоответствует КАК КоличествоНеСоответствует,
	|	Раздел4.СуммаНеСоответствует КАК СуммаНеСоответствует,
	|	Раздел4.НачальныйНомерИзлишкиНеПодтверждено КАК НачальныйНомерИзлишкиНеПодтверждено,
	|	Раздел4.КонечныйНомерИзлишкиНеПодтверждено КАК КонечныйНомерИзлишкиНеПодтверждено,
	|	Раздел4.КоличествоИзлишкиНеПодтверждено КАК КоличествоИзлишкиНеПодтверждено,
	|	Раздел4.СуммаИзлишкиНеПодтверждено КАК СуммаИзлишкиНеПодтверждено,
