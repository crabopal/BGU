	ДобавитьУсловноеОформление_СкрытьКоличествоДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	ДобавитьУсловноеОформление_СкрытьКоличествоДД(УсловноеОформление, "ТаблицаИзлишки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	ДобавитьУсловноеОформление_СкрытьКоличествоДД(УсловноеОформление, "ТаблицаНедостача", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_СкрытьСериюДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьНомеровБланковДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
