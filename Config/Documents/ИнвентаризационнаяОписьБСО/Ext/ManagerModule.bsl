	ОчищающаяСтруктура.Вставить("КодСтроки",							"0");
	ОчищающаяСтруктура.Вставить("НаименованиеДокумента",				"0");
	ОчищающаяСтруктура.Вставить("КодДокумента",							"0");
	ОчищающаяСтруктура.Вставить("НаименованиеЕдИзм",					"0");
	ОчищающаяСтруктура.Вставить("КодЕдИзм",								"0");
	
	ОчищающаяСтруктура.Вставить("СерияНеСоответствует",					"0");
	ОчищающаяСтруктура.Вставить("НомераНеСоответствует",				"0");
	ОчищающаяСтруктура.Вставить("ЦенаНеСоответствует",					"0");
	ОчищающаяСтруктура.Вставить("КоличествоНеСоответствует",			"0");
	ОчищающаяСтруктура.Вставить("СуммаНеСоответствует",					"0");
	ОчищающаяСтруктура.Вставить("СтатусОбъяснения",						"0");
	
	ОчищающаяСтруктура.Вставить("СерияИзлишкиНеПодтверждено",			"0");
	ОчищающаяСтруктура.Вставить("НомераИзлишкиНеПодтверждено",			"0");
	ОчищающаяСтруктура.Вставить("ЦенаИзлишкиНеПодтверждено",			"0");
	ОчищающаяСтруктура.Вставить("КоличествоИзлишкиНеПодтверждено",		"0");
	ОчищающаяСтруктура.Вставить("СуммаИзлишкиНеПодтверждено",			"0");
	
	ОчищающаяСтруктура.Вставить("СерияНедостачаНеПодтверждено",			"0");
	ОчищающаяСтруктура.Вставить("НомераНедостачаНеПодтверждено",		"0");
	ОчищающаяСтруктура.Вставить("ЦенаНедостачаНеПодтверждено",			"0");
	ОчищающаяСтруктура.Вставить("КоличествоНедостачаНеПодтверждено",	"0");
	ОчищающаяСтруктура.Вставить("СуммаНедостачаНеПодтверждено",			"0");
	
	ОчищающаяСтруктура.Вставить("КодСтатуса",							"0");
	ОчищающаяСтруктура.Вставить("НаименованиеСтатуса",					"0");
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ОчищающаяСтруктура);
	
КонецПроцедуры

#КонецОбласти

#Область РеестрДокументовКПроводимойИнвентаризации

Функция НайтиДокументыДвиженияБСО(ДанныеОписи, ПериодФормирования)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаБСО(ДанныеОписи);
	
	ЗапросДокументы = Новый Запрос();
	ЗапросДокументы.УстановитьПараметр("ДатаНачала",							НачалоДня(ПериодФормирования.Дата1));
	ЗапросДокументы.УстановитьПараметр("ДатаОкончания",							КонецДня(ПериодФормирования.Дата2));
	ЗапросДокументы.УстановитьПараметр("Организация",							ПараметрыПоиска.Организация);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоЦМО",				ПараметрыПоиска.ИспользоватьОтборПоЦМО);
	ЗапросДокументы.УстановитьПараметр("СписокЦМО",								ПараметрыПоиска.СписокЦМО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоСчетам",				ПараметрыПоиска.ИспользоватьОтборПоСчетам);
	ЗапросДокументы.УстановитьПараметр("Счета",									ПараметрыПоиска.Счета);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКФО",				ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросДокументы.УстановитьПараметр("КФО",									ПараметрыПоиска.КФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоИФО",				ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИФО",									ПараметрыПоиска.ИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",		ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросДокументы.УстановитьПараметр("Подразделение",							ПараметрыПоиска.Подразделение);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",ПараметрыПоиска.ИспользоватьОтборПоОдномуПодразделению);
	
	ЗапросДокументы.Текст = ПолучитьТекстЗапросаДокументыДвиженияБСО();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов = ЗапросДокументы.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция ПолучитьТекстЗапросаДокументыДвиженияБСО()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список регистраторов
	|//
	|ВЫБРАТЬ
	|	Регистратор					КАК ДокументСсылка,
	|	Период						КАК Период,
	|	КФО							КАК КФО,
	|	СчетДт						КАК СчетДт,
	|	СчетКт						КАК СчетКт,
	|	Сумма						КАК Сумма,
	|	ЕСТЬNULL(КоличествоДт, 0)	КАК КоличествоДт,
	|	ЕСТЬNULL(КоличествоКт, 0)	КАК КоличествоКт,
	|	ВидПервичногоДокумента		КАК НаименованиеДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента,
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	// Признаки.
	|	(СчетДт В(&Счета)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоДт1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоДт2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоДт3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетДт.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеДт = &Подразделение
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетДт.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеДт НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаДтСоответствуетОтбору,
	|	(СчетКт В(&Счета)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоКт1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоКт2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоКт3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетКт.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеКт = &Подразделение
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетКт.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеКт НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаКтСоответствуетОтбору
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,
	|		&ДатаОкончания,
	|		Активность
	|		И Счет В(&Счета)
	|		И Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА Субконто2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА Субконто3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ,
	|		Регистратор
	|	)";
	
КонецФункции

Функция НайтиДокументыДвиженияДД(ДанныеОписи, ПериодФормирования)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаДенежныхДокументов(ДанныеОписи);
	
	ЗапросДокументы = Новый Запрос();
	ЗапросДокументы.УстановитьПараметр("ДатаНачала",								НачалоДня(ПериодФормирования.Дата1));
	ЗапросДокументы.УстановитьПараметр("ДатаОкончания",								КонецДня(ПериодФормирования.Дата2));
	ЗапросДокументы.УстановитьПараметр("Организация",								ПараметрыПоиска.Организация);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоЦМО",					ПараметрыПоиска.ИспользоватьОтборПоЦМО);
	ЗапросДокументы.УстановитьПараметр("СписокЦМО",									ПараметрыПоиска.СписокЦМО);
	ЗапросДокументы.УстановитьПараметр("Счета",										ПараметрыПоиска.Счета);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКФО",					ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросДокументы.УстановитьПараметр("КФО",										ПараметрыПоиска.КФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоИФО",					ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИФО",										ПараметрыПоиска.ИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросДокументы.УстановитьПараметр("Подразделение",								ПараметрыПоиска.Подразделение);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоОдномуПодразделению);
	ЗапросДокументы.УстановитьПараметр("ВестиКоличественныйУчетДенежныхДокументов",	ПараметрыПоиска.ВестиКоличественныйУчетДенежныхДокументов);
	
	ЗапросДокументы.Текст = ПолучитьТекстЗапросаДокументыДвиженияДД();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов = ЗапросДокументы.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция ПолучитьТекстЗапросаДокументыДвиженияДД()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список регистраторов
	|//
	|ВЫБРАТЬ
	|	Регистратор					КАК ДокументСсылка,
	|	Период						КАК Период,
	|	КФО							КАК КФО,
	|	СчетДт						КАК СчетДт,
	|	СчетКт						КАК СчетКт,
	|	Сумма						КАК Сумма,
	|	ЕСТЬNULL(КоличествоДт, 0)	КАК КоличествоДт,
	|	ЕСТЬNULL(КоличествоКт, 0)	КАК КоличествоКт,
	|	ВидПервичногоДокумента		КАК НаименованиеДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента,
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	// Признаки.
	|	(СчетДт В(&Счета)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоДт1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоДт2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоДт3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ИСТИНА
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетДт.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеДт = &Подразделение
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетДт.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеДт НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаДтСоответствуетОтбору,
	|	(СчетКт В(&Счета)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоКт1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоКт2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА СубконтоКт3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ИСТИНА
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетКт.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеКт = &Подразделение
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетКт.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				ПодразделениеКт НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаКтСоответствуетОтбору
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,
	|		&ДатаОкончания,
	|		Активность
	|		И Счет В(&Счета)
	|		И Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ВЫБОР
	|					КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА Субконто2 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					КОГДА Субконто3 ССЫЛКА Справочник.ЦМО ТОГДА
	|						ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|					ИНАЧЕ
	|						ИСТИНА
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Обязательно наличие субконто ВидыДенежныхДокументов
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			КОГДА Субконто2 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			КОГДА Субконто3 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				ЛОЖЬ
	|		КОНЕЦ,
	|		Регистратор
	|	)";
	
