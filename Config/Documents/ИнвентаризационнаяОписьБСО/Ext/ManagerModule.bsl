Функция СобратьИсходнуюСтрокуРаздела21ПоФрагментам(ФрагментыСтроки)
	
	СтруктураИсходнойСтроки = ПолучитьПустуюСтруктуруСтрокиРаздела21();
	
	МинимальныйНачальныйНомер = Неопределено;
	МаксимальныйКонечныйНомер = Неопределено;
	
	НачальныйНомерПредставление = "";
	КонечныйНомерПредставление = "";
	
	Для Каждого ФрагментСтроки Из ФрагментыСтроки Цикл
		Если ЗначениеЗаполнено(ФрагментСтроки.НачальныйНомер)
			И (МинимальныйНачальныйНомер = Неопределено Или ФрагментСтроки.НачальныйНомер < МинимальныйНачальныйНомер) Тогда
			МинимальныйНачальныйНомер = ФрагментСтроки.НачальныйНомер;
			НачальныйНомерПредставление = ФрагментСтроки.НачальныйНомерПредставление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФрагментСтроки.КонечныйНомер)
			И (МаксимальныйКонечныйНомер = Неопределено Или ФрагментСтроки.КонечныйНомер > МаксимальныйКонечныйНомер) Тогда
			МаксимальныйКонечныйНомер = ФрагментСтроки.КонечныйНомер;
			КонечныйНомерПредставление = ФрагментСтроки.КонечныйНомерПредставление;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураИсходнойСтроки, ФрагментыСтроки[0]);
	
	СтруктураИсходнойСтроки.НачальныйНомер				= МинимальныйНачальныйНомер;
	СтруктураИсходнойСтроки.КонечныйНомер				= МаксимальныйКонечныйНомер;
	СтруктураИсходнойСтроки.НачальныйНомерПредставление	= НачальныйНомерПредставление;
	СтруктураИсходнойСтроки.КонечныйНомерПредставление	= КонечныйНомерПредставление;
	
	СтруктураИсходнойСтроки.Количество	= ФрагментыСтроки.Итог("Количество");
	СтруктураИсходнойСтроки.Сумма		= ФрагментыСтроки.Итог("Сумма");
	
	Возврат СтруктураИсходнойСтроки;
	
КонецФункции

