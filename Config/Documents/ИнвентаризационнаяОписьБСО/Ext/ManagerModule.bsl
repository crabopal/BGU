		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_ИтогСуммыРасходитсяСИсходнойСтрокой_Раздел3(УсловноеОформление)
	
	// При равенстве количества должны совпадать и суммы.
	// Но итог сумм по фрагментам строки может отличаться от исходной разбиваемой суммы.
	
	ШрифтЖирный = Новый Шрифт(,,Истина);
	
	ИменаПолейСумм = Новый Массив();
	ИменаПолейСумм.Добавить("СуммаИзлишки");
	ИменаПолейСумм.Добавить("СуммаНедостача");
	
	Для Каждого ИмяПоляСуммы Из ИменаПолейСумм Цикл
		ИмяПоляКоличество = ?(ИмяПоляСуммы = "СуммаИзлишки", "КоличествоИзлишки", "КоличествоНедостача");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Итог по сумме в таблице фрагментов отличается от показателя исходной строки при совпадающем количестве(%1)'"), ИмяПоляСуммы);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РедактируетсяКоличество");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляКоличество);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоляКоличество);
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляКоличество);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляСуммы);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоляСуммы);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоляСуммы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРазделов

#Область ЗаполнениеРаздела1

Функция ПолучитьОстаткиБСО(ПараметрыПроцедуры)
	
	ТаблицаОстатков = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти.Раздел1);
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаБСО(ПараметрыПроцедуры);
	
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаОстатков",							ПараметрыПоиска.ДатаОстатков);
	ЗапросОстатки.УстановитьПараметр("ДатаСреза",								ПараметрыПоиска.ДатаСреза);
	ЗапросОстатки.УстановитьПараметр("Организация",								ПараметрыПоиска.Организация);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоЦМО",					ПараметрыПоиска.ИспользоватьОтборПоЦМО);
	ЗапросОстатки.УстановитьПараметр("СписокЦМО",								ПараметрыПоиска.СписокЦМО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоСчетам",				ПараметрыПоиска.ИспользоватьОтборПоСчетам);
	ЗапросОстатки.УстановитьПараметр("Счета",									ПараметрыПоиска.Счета);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоКФО",					ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросОстатки.УстановитьПараметр("КФО",										ПараметрыПоиска.КФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоИФО",					ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИФО",										ПараметрыПоиска.ИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",		ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросОстатки.УстановитьПараметр("Подразделение",							ПараметрыПоиска.Подразделение);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоОдномуПодразделению);
	
	ЗапросОстатки.Текст = ПолучитьТекстЗапросаОстаткиБСО();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросОстатки.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [4]. Уникальные границы диапазонов номеров для дальнейшей обработки
	ВыборкаГраницыДиапазонов = РезультатыЗапроса[4].Выбрать();
	
	// [5]. Остатки бланков для дальнейшей обработки
	ВыборкаОстаткиБланков = РезультатыЗапроса[5].Выбрать();
	
	Пока ВыборкаОстаткиБланков.Следующий() Цикл
		
		ПоискТекущегоБланка = Новый Структура("БСО,СерияБСО");
		
		ЗаполнитьЗначенияСвойств(ПоискТекущегоБланка, ВыборкаОстаткиБланков);
		
		ПредыдущаяВыборка = Новый Структура("БСО,СерияБСО,Граница,ДельтаКоличество");
		
		МножительКоличества = 0;
		
		ВыборкаГраницыДиапазонов.Сбросить();
		
		Пока ВыборкаГраницыДиапазонов.НайтиСледующий(ПоискТекущегоБланка) Цикл
			
			Если МножительКоличества = 0 Тогда
				// В завершение текущей итерации
				МножительКоличества = МножительКоличества + ВыборкаГраницыДиапазонов["ДельтаКоличество"];
				ЗаполнитьЗначенияСвойств(ПредыдущаяВыборка, ВыборкаГраницыДиапазонов);
				
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОстатков.Добавить();
			
			НоваяСтрока["БСО"]				= ПредыдущаяВыборка.БСО;
			НоваяСтрока["Серия"]			= ПредыдущаяВыборка.СерияБСО;
			НоваяСтрока["НачальныйНомер"]	= ПредыдущаяВыборка.Граница;
			
			КонечныйНомер = ВыборкаГраницыДиапазонов["Граница"] - 1;
			
			НоваяСтрока["КонечныйНомер"] = КонечныйНомер;
			
			Количество = КонечныйНомер - НоваяСтрока["НачальныйНомер"] + 1;
			
			НоваяСтрока["Количество"] = Количество * МножительКоличества; // Количество
			НоваяСтрока["МножительКоличества"] = МножительКоличества;
			
			НоваяСтрока["Цена"] = 1;
			НоваяСтрока["Сумма"] = НоваяСтрока["Количество"] * НоваяСтрока["Цена"];
			
			// В завершение текущей итерации
			МножительКоличества = МножительКоличества + ВыборкаГраницыДиапазонов["ДельтаКоличество"];
			ЗаполнитьЗначенияСвойств(ПредыдущаяВыборка, ВыборкаГраницыДиапазонов);
			
		КонецЦикла;
		
	КонецЦикла;
	
	// [6]. Детальные остатки бланков для списания недостач
	ДетальныеОстатки = РезультатыЗапроса[6].Выгрузить();
	
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО;
	
	//ТаблицаОстатков.ЗаполнитьЗначения(ВидДокумента, "ВидДокумента"); 
	
	ЗаполнитьЕдИзм(ТаблицаОстатков, ВидДокумента);
	
	ОстаткиБСО = Новый Структура();
	ОстаткиБСО.Вставить("ОстаткиДляРаздела1",			ТаблицаОстатков);
	ОстаткиБСО.Вставить("ОстаткиДляСписанияНедостач",	ДетальныеОстатки);

	Возврат ОстаткиБСО;
	
КонецФункции

Функция ПолучитьПараметрыПоискаБСО(ПараметрыПроцедуры)
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ДатаСреза = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	Если ЗначениеЗаполнено(ПараметрыПроцедуры.МестоИнвентаризации) Тогда
		МассивМестИнвентаризации = Новый Массив();
		МассивМестИнвентаризации.Добавить(ПараметрыПроцедуры.МестоИнвентаризации);
		
		СпискиМОЛ = ИнвентаризацияСервер.ПолучитьСпискиМОЛДляСпискаМестИнвентаризации(ПараметрыПроцедуры.МОЛ, МассивМестИнвентаризации);
		
		СписокЦМО = СпискиМОЛ.СписокЦМО;
	Иначе
		СписокЦМО = ИнвентаризацияСервер.ПолучитьВсеЦМОСотрудникаДляОтбора(ПараметрыПроцедуры.МОЛ, ПараметрыПроцедуры.Организация);
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",							ДатаОстатков);
	ПараметрыПоиска.Вставить("ДатаСреза",								ДатаСреза);
	ПараметрыПоиска.Вставить("Организация",								ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоЦМО",					ЗначениеЗаполнено(ПараметрыПроцедуры.МОЛ));
	ПараметрыПоиска.Вставить("СписокЦМО",								СписокЦМО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоСчетам",				ЗначениеЗаполнено(ПараметрыПроцедуры.Счет));
	ПараметрыПоиска.Вставить("Счета",									БухгалтерскийУчет.СписокСчетов(ПараметрыПроцедуры.Счет, ДатаОстатков));
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",					ЗначениеЗаполнено(ПараметрыПроцедуры.КФО));
	ПараметрыПоиска.Вставить("КФО",										ПараметрыПроцедуры.КФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",					ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",										ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ПараметрыПоиска.Вставить("Подразделение",							ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));

	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиБСО()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Детальные остатки бланков
	|//
	|ВЫБРАТЬ
	|	Организация			КАК Организация,
	|	КФО					КАК КФО,
	|	ЦМО					КАК ЦМО,
	|	ИФО					КАК ИФО,
	|	Подразделение		КАК Подразделение,
	|	БСО					КАК БСО,
	|	СерияБСО			КАК СерияБСО,
	|	СчетУчета			КАК СчетУчета,
	|	КоличествоОстаток	КАК Количество
	|ПОМЕСТИТЬ
	|	ДетальныеОстаткиБланков
	|ИЗ
	|	РегистрНакопления.ДвиженияБСО.Остатки(
	|		&ДатаОстатков,
	|		// Одинаковый отбор с поиском движений
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетУчета.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				Подразделение = &Подразделение
	|			КОГДА &ИспользоватьУчетПоПодразделениям И СчетУчета.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|				Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|				ЦМО В(&СписокЦМО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоСчетам ТОГДА
	|				СчетУчета В(&Счета)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)
	|ИНДЕКСИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Свернутые остатки бланков
	|//
	|ВЫБРАТЬ
	|	БСО					КАК БСО,
	|	СерияБСО			КАК СерияБСО,
	|	СУММА(Количество)	КАК Количество
	|ПОМЕСТИТЬ
	|	СвернутыеОстаткиБланков
	|ИЗ
	|	ДетальныеОстаткиБланков
	|СГРУППИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО
	|ИМЕЮЩИЕ
	|	СУММА(Количество) <> 0
	|ИНДЕКСИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Движения бланков
	|//
	|ВЫБРАТЬ
	|	БСО											КАК БСО,
	|	СерияБСО									КАК СерияБСО,
	|	НомерНачальный								КАК НомерНачальный,
	|	ВЫБОР
	|		КОГДА НомерКонечный > 0 ТОГДА
	|			НомерКонечный
	|		КОГДА Количество > 0 ТОГДА
	|			НомерНачальный + Количество - 1
	|		ИНАЧЕ
	|			НомерНачальный - Количество - 1
	|	КОНЕЦ										КАК НомерКонечный,
	|	ВЫБОР
	|		КОГДА (ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И Количество > 0)
	|			ИЛИ (ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) И Количество < 0) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ										КАК ДельтаКоличество
	|ПОМЕСТИТЬ
	|	ДвиженияБланков
	|ИЗ
	|	РегистрНакопления.ДвиженияБСО
	|ГДЕ
	|	// Одинаковый отбор с поиском остатков
	|	Организация = &Организация
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|			КФО = &КФО
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|			ИФО = &ИФО
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И СчетУчета.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И СчетУчета.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоЦМО ТОГДА
	|			ЦМО В(&СписокЦМО)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоСчетам ТОГДА
	|			СчетУчета В(&Счета)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	// Уникальный отбор для поиска движений
	|	И Активность
	|	И Период <= &ДатаСреза
	|	И (БСО, СерияБСО) В (ВЫБРАТЬ БСО, СерияБСО ИЗ СвернутыеОстаткиБланков)
	|	И НомерНачальный > 0
	|	И Количество <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Уникальные границы диапазонов номеров для дальнейшей обработки
	|//
	|ВЫБРАТЬ
	|	БСО						КАК БСО,
	|	СерияБСО				КАК СерияБСО,
	|	Граница					КАК Граница,
	|	СУММА(ДельтаКоличество)	КАК ДельтаКоличество
	|ИЗ
	|	(ВЫБРАТЬ
	|		БСО					КАК БСО,
	|		СерияБСО			КАК СерияБСО,
	|		НомерНачальный		КАК Граница,
	|		ДельтаКоличество	КАК ДельтаКоличество
	|	ИЗ
	|		ДвиженияБланков
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		БСО					КАК БСО,
	|		СерияБСО			КАК СерияБСО,
	|		НомерКонечный + 1	КАК Граница,
	|		-ДельтаКоличество	КАК ДельтаКоличество
	|	ИЗ
	|		ДвиженияБланков
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|ИМЕЮЩИЕ
	|	СУММА(ДельтаКоличество) <> 0
	|УПОРЯДОЧИТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Остатки бланков для дальнейшей обработки
	|//
	|ВЫБРАТЬ
	|	БСО										КАК БСО,
	|	СерияБСО								КАК СерияБСО,
	|	ЕСТЬNULL(СправочникБСО.ДлинаНомера, 0)	КАК ДлинаНомера
	|ИЗ
	|	СвернутыеОстаткиБланков
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БСО КАК СправочникБСО
	|		ПО	СвернутыеОстаткиБланков.БСО = СправочникБСО.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииБСО КАК СправочникСерииБСО
	|		ПО	СвернутыеОстаткиБланков.СерияБСО = СправочникСерииБСО.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	СправочникБСО.Наименование,
	|	СправочникСерииБСО.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Детальные остатки бланков для списания недостач
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ДетальныеОстаткиБланков
	|;";
	
КонецФункции


Функция ПолучитьОстаткиДенежныхДокументов(ПараметрыПроцедуры)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаДенежныхДокументов(ПараметрыПроцедуры);
	
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаОстатков",								ПараметрыПоиска.ДатаОстатков);
	ЗапросОстатки.УстановитьПараметр("Организация",									ПараметрыПоиска.Организация);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоЦМО",						ПараметрыПоиска.ИспользоватьОтборПоЦМО);
	ЗапросОстатки.УстановитьПараметр("СписокЦМО",									ПараметрыПоиска.СписокЦМО);
	ЗапросОстатки.УстановитьПараметр("Счета",										ПараметрыПоиска.Счета);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоКФО",						ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросОстатки.УстановитьПараметр("КФО",											ПараметрыПоиска.КФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоИФО",						ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИФО",											ПараметрыПоиска.ИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросОстатки.УстановитьПараметр("Подразделение",								ПараметрыПоиска.Подразделение);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",		ПараметрыПоиска.ИспользоватьОтборПоОдномуПодразделению);
	ЗапросОстатки.УстановитьПараметр("ВестиКоличественныйУчетДенежныхДокументов",	ПараметрыПоиска.ВестиКоличественныйУчетДенежныхДокументов);
	
	ЗапросОстатки.Текст = ПолучитьТекстЗапросаОстаткиДенежныхДокументов();
	
	УстановитьПривилегированныйРежим(Истина);
	ДетальныеОстатки = ЗапросОстатки.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ДетальныеОстатки.Сортировать("ВидДенежногоДокумента,ДенежныйДокумент", Новый СравнениеЗначений);
	
	ТаблицаОстатков = ДетальныеОстатки.Скопировать();
	ТаблицаОстатков.Свернуть("ВидДенежногоДокумента,ДенежныйДокумент", "Сумма,Количество");
	
	ТаблицаОстатков.Колонки.Добавить("Цена",			ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой)); // Допускаем отрицательную цену, если суммовой остаток отрицательный.
	ТаблицаОстатков.Колонки.Добавить("ЕдИзм",			Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаОстатков.Колонки.Добавить("ВидДокумента",	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДокументовСтрогойОтчетности"));
	
	Поиск = Новый Структура("Сумма,Количество", 0, 0);
	
	МассивСтрок = ТаблицаОстатков.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ТаблицаОстатков.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОстатков Цикл
		Если ПараметрыПоиска.ВестиКоличественныйУчетДенежныхДокументов Тогда
			// Понятие Цены определено лишь при наличии понятия Количества.
			СтрокаТаблицы.Цена = ?(ЗначениеЗаполнено(СтрокаТаблицы.Количество), СтрокаТаблицы.Сумма/СтрокаТаблицы.Количество, 0);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаОстатков.Сортировать("ВидДенежногоДокумента,ДенежныйДокумент", Новый СравнениеЗначений);
	
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы;
	
	//ТаблицаОстатков.ЗаполнитьЗначения(ВидДокумента, "ВидДокумента"); 
	
	ЗаполнитьЕдИзм(ТаблицаОстатков, ВидДокумента);
	
	ОстаткиДенежныхДокументов = Новый Структура();
	ОстаткиДенежныхДокументов.Вставить("ОстаткиДляРаздела1",			ТаблицаОстатков);
	ОстаткиДенежныхДокументов.Вставить("ОстаткиДляСписанияНедостач",	ДетальныеОстатки);
	
	Возврат ОстаткиДенежныхДокументов;
	
КонецФункции

Функция ПолучитьПараметрыПоискаДенежныхДокументов(ПараметрыПроцедуры)
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",								ДатаОстатков);
	ПараметрыПоиска.Вставить("Организация",									ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоЦМО",						ЗначениеЗаполнено(ПараметрыПроцедуры.МОЛ));
	ПараметрыПоиска.Вставить("СписокЦМО",									ИнвентаризацияСервер.ПолучитьСписокОтбораПоМОЛ(ПараметрыПроцедуры));
	ПараметрыПоиска.Вставить("Счета",										БухгалтерскийУчет.СписокСчетов(ПараметрыПроцедуры.Счет, ДатаОстатков));
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",						ЗначениеЗаполнено(ПараметрыПроцедуры.КФО));
	ПараметрыПоиска.Вставить("КФО",											ПараметрыПроцедуры.КФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",						ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",						ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",											ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ПараметрыПоиска.Вставить("Подразделение",								ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоОдномуПодразделению",		ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("ВестиКоличественныйУчетДенежныхДокументов",	ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов"));
	
	Возврат ПараметрыПоиска;

КонецФункции

Функция	ПолучитьТекстЗапросаОстаткиДенежныхДокументов()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Детальные остатки денежных документов
	|//
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Остатки.Субконто1 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ВидыДенежныхДокументов)
	|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ВидыДенежныхДокументов)
	|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ВидыДенежныхДокументов)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ВидыДенежныхДокументов.ПустаяСсылка)
	|	КОНЕЦ												КАК ВидДенежногоДокумента,
	|	ВЫБОР
	|		КОГДА Остатки.Субконто1 ССЫЛКА Справочник.ДенежныеДокументы ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДенежныеДокументы)
	|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.ДенежныеДокументы ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДенежныеДокументы)
	|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.ДенежныеДокументы ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДенежныеДокументы)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка)
	|	КОНЕЦ												КАК ДенежныйДокумент,
	|	Остатки.СуммаОстаток								КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ВестиКоличественныйУчетДенежныхДокументов ТОГДА
	|			Остатки.КоличествоОстаток
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ												КАК Количество,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			Остатки.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ												КАК ИФО,
	|	Остатки.КФО											КАК КФО,
	|	Остатки.КПС											КАК КПС,
	|	Остатки.Счет										КАК Счет,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ												КАК Подразделение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков, // 1
	|		Счет В (&Счета), // 2
	|		, // 3
	|		Организация = &Организация // 4
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Отбор по ИФО
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Отбор по сотруднику
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО) В (&СписокЦМО)
	|			КОГДА Субконто2 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО) В (&СписокЦМО)
	|			КОГДА Субконто3 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО) В (&СписокЦМО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Обязательно наличие субконто ВидыДенежныхДокументов
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			КОГДА Субконто2 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			КОГДА Субконто3 ССЫЛКА Справочник.ВидыДенежныхДокументов ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				ЛОЖЬ
	|		КОНЕЦ
	|	) КАК Остатки
	|ГДЕ
	|	// Отбор по подразделению
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
КонецФункции

Процедура ПрименитьМножительКоличества1(ТаблицаРаздела21, ПараметрыФункции)
	
	ЭтоБСО				= (ПараметрыФункции.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (ПараметрыФункции.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	ОчищающаяСтруктура = Новый Структура("Количество,Сумма", 0, 0);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела21 Цикл
		
		Если ЭтоДенежныйДокумент И (СтрокаТаблицы.Количество < 0 Или СтрокаТаблицы.Сумма < 0) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
			
		ИначеЕсли ЭтоБСО И СтрокаТаблицы.МножительКоличества <> 1 Тогда
			СтрокаТаблицы.Количество = СтрокаТаблицы.КонечныйНомер - СтрокаТаблицы.НачальныйНомер + 1;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Цена * СтрокаТаблицы.Количество;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

