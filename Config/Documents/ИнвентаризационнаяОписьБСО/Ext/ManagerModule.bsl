#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента, ИменаРазделов, РезультатыДиагностики = Неопределено) Экспорт
	
	ПостфиксыИменКолонокНомеровВРазделах = ПолучитьПостфиксыИменКолонокНомеровВРазделах();
	
	СведенияБСОиДД = ПрочитатьСведенияБСОиДДДляВсегоДокумента(ФормаДокумента.Объект);
	
	МассивИмен = СтрРазделить(ИменаРазделов, ", ", Ложь);
	
	РезультатыДиагностики = Новый Структура();
	
	Для Каждого ИмяТЧ Из МассивИмен Цикл
		РезультатыДиагностики.Вставить(ИмяТЧ, Новый Структура());
		
		ЗаполнитьСлужебныеКолонкиТабличнойЧасти(
			ФормаДокумента.Объект.ВидДокумента,
			ФормаДокумента.Объект[ИмяТЧ],
			ПостфиксыИменКолонокНомеровВРазделах[ИмяТЧ],
			ИмяТЧ,
			РезультатыДиагностики,
			СведенияБСОиДД);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПостфиксыИменКолонокНомеровВРазделах() Экспорт
	
	Раздел1 = Новый Массив();
	Раздел1.Добавить("");
	
	Раздел21 = Новый Массив();
	Раздел21.Добавить("");
	Раздел21.Добавить("НеСоответствует");
	
	Раздел22 = Новый Массив();
	Раздел22.Добавить("НеСоответствует");
	Раздел22.Добавить("Излишки");
	Раздел22.Добавить("Недостача");
	
	Раздел3 = Новый Массив();
	Раздел3.Добавить("Излишки");
	Раздел3.Добавить("Недостача");
	Раздел3.Добавить("ИзлишкиПодтверждено");
	Раздел3.Добавить("НедостачаПодтверждено");
	Раздел3.Добавить("ИзлишкиНеПодтверждено");
	Раздел3.Добавить("НедостачаНеПодтверждено");
	
	Раздел4 = Новый Массив();
	Раздел4.Добавить("НеСоответствует");
	Раздел4.Добавить("ИзлишкиНеПодтверждено");
	Раздел4.Добавить("НедостачаНеПодтверждено");
	
	ПостфиксыИменКолонок = Новый Структура();
	ПостфиксыИменКолонок.Вставить("Раздел1", Раздел1);
	ПостфиксыИменКолонок.Вставить("Раздел21", Раздел21);
	ПостфиксыИменКолонок.Вставить("Раздел22", Раздел22);
	ПостфиксыИменКолонок.Вставить("Раздел3", Раздел3);
	ПостфиксыИменКолонок.Вставить("Раздел4", Раздел4);
	
	Возврат ПостфиксыИменКолонок;
	
КонецФункции

Функция ПолучитьЕдиницуИзмеренияПоУмолчанию() Экспорт
	
	ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	Сведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, "Код,Наименование,НаименованиеПолное");
	Сведения.Вставить("Ссылка", ЕдИзм);
	
	Возврат Сведения;
	
КонецФункции

Процедура ДобавитьКолонкиДляДобавленныхРеквизитовФормы_Раздел3(Таблица) Экспорт // Вызывается из формы РазбивкаСтрокиРаздела3
	
	ДобавитьКолонкиДляДобавленныхРеквизитовФормы_Общие(Таблица);
	
	ДобавитьКолонкиДляДобавленныхРеквизитовФормы_РазбивкаСтроки(Таблица);
	
	ДобавитьКолонкиДляДобавленныхРеквизитовФормы_ПредставленияНомеровБСО(Таблица, "Раздел3");
	
КонецПроцедуры

#Область УсловноеОформление

Процедура УстановитьУсловноеОформление(ФормаДокумента) Экспорт
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	НаличиеСубконто = БухгалтерскийУчет.ЕстьСубконтоСписокСчетов(ФормаДокумента.Объект.Счет, "ДенежныеДокументы");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СведенияЕдИзм",							ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ДополнительныеПараметры.Вставить("ПостфиксыИменКолонокНомеровВРазделах",	ПолучитьПостфиксыИменКолонокНомеровВРазделах());
	ДополнительныеПараметры.Вставить("ЕстьСубконтоДенежныеДокументы",			НаличиеСубконто.ДенежныеДокументы.ЕстьСубконто);
	
	ДобавитьУсловноеОформление_Раздел1(УсловноеОформление, ДополнительныеПараметры);
	ДобавитьУсловноеОформление_Раздел21(УсловноеОформление, ДополнительныеПараметры);
	ДобавитьУсловноеОформление_Раздел22(УсловноеОформление, ДополнительныеПараметры);
	ДобавитьУсловноеОформление_Раздел3(УсловноеОформление, ДополнительныеПараметры);
	ДобавитьУсловноеОформление_Раздел4(ФормаДокумента, УсловноеОформление, ДополнительныеПараметры);
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента, "СоставКомиссииРаздел2");
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента, "СоставКомиссииРаздел4");
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление_ФормаРазбивкиСтрокиРаздела21(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	
	УсловноеОформление.Элементы.Очистить();
	
	ПостфиксыИменКолонокНомеровВРазделах = ПолучитьПостфиксыИменКолонокНомеровВРазделах();
	
	ПостфиксыИменКолонокНомеровВРазделах.Вставить("ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах.Раздел1); // Одинаковый состав колонок и одинаковые постфиксы
	ПостфиксыИменКолонокНомеровВРазделах.Вставить("ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах.Раздел21); // Одинаковый состав колонок и одинаковые постфиксы
	
	Если ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО() Тогда
		ДобавитьУсловноеОформление_ПредставленияНомеровБСО(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
		ДобавитьУсловноеОформление_ПредставленияНомеровБСО(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	КонецЕсли;
	
	ДобавитьУсловноеОформление_ПредставлениеНомеровДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	ДобавитьУсловноеОформление_ПредставлениеНомеровДД(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_СкрытьКоличествоДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	ДобавитьУсловноеОформление_СкрытьКоличествоДД(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_СкрытьСериюДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьНомеровБланковДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	ДобавитьУсловноеОформление_НедоступностьНомеровБланковДД(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_ОчиститьНомераБланковПриОтсутствииРасхожденийДД(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхНомеровБланковДД(УсловноеОформление, "ТаблицаФрагментыСтроки", ПостфиксыИменКолонокНомеровВРазделах, Истина);
	
	ДобавитьУсловноеОформление_НадписиНомеровБСО(УсловноеОформление, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НадписиНомеровБСО(УсловноеОформление, "ТаблицаФрагментыСтроки", Истина);
	ДобавитьУсловноеОформление_НадписиНомеровДД(УсловноеОформление, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НадписиНомеровДД(УсловноеОформление, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхПолей_Раздел21(УсловноеОформление, Истина);
	
	ДобавитьУсловноеОформление_ИтогиРасходятсяСИсходнойСтрокой_Раздел21(УсловноеОформление);
	
КонецПроцедуры

