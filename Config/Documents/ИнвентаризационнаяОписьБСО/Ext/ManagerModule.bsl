	|				И НФАУчетныхДокументовДД.ВидОтклонения = ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача)
	|				И ДанныеДокументаИнвентаризации1.ВидОбъекта = 12)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НФАУчетныхДокументов КАК НФАУчетныхДокументовБСО
	|		ПО (ДанныеДокументаИнвентаризации1.ДокументИнвентаризации = НФАУчетныхДокументовБСО.ДокументИнвентаризации
	|				И ДанныеДокументаИнвентаризации1.БСО = НФАУчетныхДокументовБСО.НФА
	|				И ДанныеДокументаИнвентаризации1.Серия = НФАУчетныхДокументовБСО.СерияБСО
	|				И НФАУчетныхДокументовБСО.ВидОтклонения = ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача)
	|				И ДанныеДокументаИнвентаризации1.ВидОбъекта = 11)
	|ГДЕ
	|	ДанныеДокументаИнвентаризации1.КоличествоНедостачаНеПодтверждено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокументаИнвентаризации1.ДокументИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.ВидДенежногоДокумента,
	|	ДанныеДокументаИнвентаризации1.ДенежныйДокумент,
	|	ДанныеДокументаИнвентаризации1.БСО,
	|	ДанныеДокументаИнвентаризации1.Серия,
	|	ДанныеДокументаИнвентаризации1.ЕдИзм,
	|	ДанныеДокументаИнвентаризации1.МОЛШапки,
	|	ДанныеДокументаИнвентаризации1.МестоИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.СчетУчета,
	|	ДанныеДокументаИнвентаризации1.КФО,
	|	ДанныеДокументаИнвентаризации1.КПС,
	|	ДанныеДокументаИнвентаризации1.Количество,
	|	ДанныеДокументаИнвентаризации1.Сумма,
	|	ДанныеДокументаИнвентаризации1.ВидОбъекта
	|ИМЕЮЩИЕ
	|	СУММА(ДанныеДокументаИнвентаризации1.КоличествоНедостачаНеПодтверждено - ЕСТЬNULL(НФАУчетныхДокументовДД.Количество, 0) - ЕСТЬNULL(НФАУчетныхДокументовБСО.Количество, 0)) > 0
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокументаИнвентаризации1.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ДанныеДокументаИнвентаризации1.ДенежныйДокумент КАК ДенежныйДокумент,
	|	ДанныеДокументаИнвентаризации1.БСО КАК БСО,
	|	ДанныеДокументаИнвентаризации1.Серия КАК Серия,
	|	ДанныеДокументаИнвентаризации1.ЕдИзм КАК ЕдИзм,
	|	ДанныеДокументаИнвентаризации1.МОЛШапки КАК МОЛШапки,
	|	ДанныеДокументаИнвентаризации1.МестоИнвентаризации КАК МестоИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.СчетУчета КАК СчетУчета,
	|	ДанныеДокументаИнвентаризации1.СчетУчета КАК Счет,
	|	ДанныеДокументаИнвентаризации1.КФО КАК КФО,
	|	ДанныеДокументаИнвентаризации1.КПС КАК КПС,
	|	ДанныеДокументаИнвентаризации1.Количество КАК Количество,
	|	ДанныеДокументаИнвентаризации1.Сумма КАК Сумма,
	|	0 КАК КоличествоНеСоответствует,
	|	0 КАК СуммаНеСоответствует,
	|	СУММА(ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено
	|		- ЕСТЬNULL(НФАУчетныхДокументовДД.Количество, 0)
	|		- ЕСТЬNULL(НФАУчетныхДокументовБСО.Количество, 0)
	|	) КАК КоличествоИзлишкиНеПодтверждено,
	|	СУММА(ВЫБОР
	|			КОГДА ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено = 0
	|				ИЛИ (ДанныеДокументаИнвентаризации1.ВидОбъекта = 12 И ЕСТЬNULL(НФАУчетныхДокументовДД.Количество, 0) = 0)
	|				ИЛИ (ДанныеДокументаИнвентаризации1.ВидОбъекта = 11 И ЕСТЬNULL(НФАУчетныхДокументовБСО.Количество, 0) = 0)
	|				ТОГДА ДанныеДокументаИнвентаризации1.СуммаИзлишкиНеПодтверждено
	|			ИНАЧЕ ВЫРАЗИТЬ((ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено
	|				- ЕСТЬNULL(НФАУчетныхДокументовДД.Количество, 0)
	|				- ЕСТЬNULL(НФАУчетныхДокументовБСО.Количество, 0)
	|			) * ДанныеДокументаИнвентаризации1.СуммаИзлишкиНеПодтверждено / ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено КАК ЧИСЛО(18,2))
	|		КОНЕЦ) КАК СуммаИзлишкиНеПодтверждено,
	|	0 КАК КоличествоНедостачаНеПодтверждено,
	|	0 КАК СуммаНедостачаНеПодтверждено,
	|	0 КАК КоличествоОбесценение,
	|	0 КАК СуммаОбесценение,
	|	ДанныеДокументаИнвентаризации1.ВидОбъекта КАК ВидОбъекта
	|ИЗ
	|	ДанныеДокументаИнвентаризации1 КАК ДанныеДокументаИнвентаризации1
	|		ЛЕВОЕ СОЕДИНЕНИЕ НФАУчетныхДокументов КАК НФАУчетныхДокументовДД
	|		ПО (ДанныеДокументаИнвентаризации1.ДокументИнвентаризации = НФАУчетныхДокументовДД.ДокументИнвентаризации
	|				И ДанныеДокументаИнвентаризации1.ДенежныйДокумент = НФАУчетныхДокументовДД.НФА
	|				И НФАУчетныхДокументовДД.ВидОтклонения = ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки)
	|				И ДанныеДокументаИнвентаризации1.ВидОбъекта = 12)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НФАУчетныхДокументов КАК НФАУчетныхДокументовБСО
	|		ПО (ДанныеДокументаИнвентаризации1.ДокументИнвентаризации = НФАУчетныхДокументовБСО.ДокументИнвентаризации
	|				И ДанныеДокументаИнвентаризации1.БСО = НФАУчетныхДокументовБСО.НФА
	|				И ДанныеДокументаИнвентаризации1.Серия = НФАУчетныхДокументовБСО.СерияБСО
	|				И НФАУчетныхДокументовБСО.ВидОтклонения = ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки)
	|				И ДанныеДокументаИнвентаризации1.ВидОбъекта = 11)
	|ГДЕ
	|	ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокументаИнвентаризации1.ДокументИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.ВидДенежногоДокумента,
	|	ДанныеДокументаИнвентаризации1.ДенежныйДокумент,
	|	ДанныеДокументаИнвентаризации1.БСО,
	|	ДанныеДокументаИнвентаризации1.Серия,
	|	ДанныеДокументаИнвентаризации1.ЕдИзм,
	|	ДанныеДокументаИнвентаризации1.МОЛШапки,
	|	ДанныеДокументаИнвентаризации1.МестоИнвентаризации,
	|	ДанныеДокументаИнвентаризации1.СчетУчета,
	|	ДанныеДокументаИнвентаризации1.КФО,
	|	ДанныеДокументаИнвентаризации1.КПС,
	|	ДанныеДокументаИнвентаризации1.Количество,
	|	ДанныеДокументаИнвентаризации1.Сумма,
	|	ДанныеДокументаИнвентаризации1.ВидОбъекта
	|	
	|ИМЕЮЩИЕ
	|	СУММА(ДанныеДокументаИнвентаризации1.КоличествоИзлишкиНеПодтверждено - ЕСТЬNULL(НФАУчетныхДокументовДД.Количество, 0) - ЕСТЬNULL(НФАУчетныхДокументовБСО.Количество, 0)) > 0";
	Запрос.УстановитьПараметр("ДокументыИнвентаризации", Инвентаризация);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьПривилегированныйРежим(Истина);
	Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

