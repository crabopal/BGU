Процедура ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхПолей_Раздел21(УсловноеОформление, ДляФормыРазбивкиСтрокиРаздела = Ложь)
	
	Если ДляФормыРазбивкиСтрокиРаздела Тогда
		ИмяТЧ = "ТаблицаФрагментыСтроки";
	Иначе
		ИмяТЧ = "Раздел21";
	КонецЕсли;
	
	Если Не ДляФормыРазбивкиСтрокиРаздела Тогда
		// Сброс отметки незаполненного полей Фактическое наличие.
		ИменаПолей = Новый Массив();
		ИменаПолей.Добавить("НачальныйНомер");
		ИменаПолей.Добавить("КонечныйНомер");
		ИменаПолей.Добавить("Количество");
		ИменаПолей.Добавить("Сумма");
		
		ТолькоДляАвтоСтрок = Истина;
		
		ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхПолей_ЕслиВсеПоляПустые(УсловноеОформление, ИмяТЧ , ИменаПолей, ТолькоДляАвтоСтрок, ДляФормыРазбивкиСтрокиРаздела);
	КонецЕсли;
	
	// Сброс отметки незаполненного полей Не соответствует условиям актива.
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("НачальныйНомерНеСоответствует");
	ИменаПолей.Добавить("КонечныйНомерНеСоответствует");
	ИменаПолей.Добавить("КоличествоНеСоответствует");
	ИменаПолей.Добавить("СуммаНеСоответствует");
	ИменаПолей.Добавить("Статус");
	
	ТолькоДляАвтоСтрок = Ложь;
	
	ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхПолей_ЕслиВсеПоляПустые(УсловноеОформление, ИмяТЧ, ИменаПолей, ТолькоДляАвтоСтрок, ДляФормыРазбивкиСтрокиРаздела);
	
	
	ДобавитьУсловноеОформление_НедоступностьПолейНеСоответствуетУсловиямАктиваПриПустомФакте(УсловноеОформление, ИмяТЧ, ИменаПолей, ДляФормыРазбивкиСтрокиРаздела);
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_СбросОтметкиНезаполненныхПолей_ЕслиВсеПоляПустые(УсловноеОформление, ИмяТЧ, ИменаПолей, ТолькоДляАвтоСтрок, ДляФормыРазбивкиСтрокиРаздела = Ложь)
	
	// Для БСО номера бланков указываются вручную, и поэтому входят в общий список указанных полей.
	// Для денежных документов номера бланков заполняются автоматически и не редактируются,
	// поэтому исключаются из общего списка указанных полей.
	
	//---
	// БСО
	//---
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО;
	
	ПредставлениеШаблон = НСтр("ru='Сброс отметки незаполненных полей, если все поля пустые (%1, для %2)'");
	
	ПредставлениеПолей = СтрШаблон(НСтр("ru='таблица %1, поля %2'"), ИмяТЧ, СтрСоединить(ИменаПолей, ","));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ПредставлениеПолей, ВидДокумента);
	
	// Условия
	ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + "ВидДокумента";
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = ВидДокумента;
	
	Если ТолькоДляАвтоСтрок Тогда
		ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + ИмяТЧ + ".ДобавленоВручную";
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + ИмяТЧ + "." + ИмяПоля;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	КонецЦикла;
		
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
	//---
	// Денежные документы
	//---
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы;
	
	ПредставлениеШаблон = НСтр("ru='Сброс отметки незаполненных полей, если все поля пустые (%1, для %2)'");
	
	ПредставлениеПолей = СтрШаблон(НСтр("ru='таблица %1, поля %2'"), ИмяТЧ, СтрСоединить(ИменаПолей, ","));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ПредставлениеПолей, ВидДокумента);
	
	// Условия
	ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + "ВидДокумента";
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = ВидДокумента;
	
	Если ТолькоДляАвтоСтрок Тогда
		ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + ИмяТЧ + ".ДобавленоВручную";
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если СтрНачинаетсяС(ИмяПоля, "НачальныйНомер") Или СтрНачинаетсяС(ИмяПоля, "КонечныйНомер") Тогда
			// Для денежных документов не оформляем поля номеров бланков.
			Продолжить;
		КонецЕсли;
		
		ПолеУсловия = ?(ДляФормыРазбивкиСтрокиРаздела, "", "Объект.") + ИмяТЧ + "." + ИмяПоля;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУсловия);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	КонецЦикла;
		
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если СтрНачинаетсяС(ИмяПоля, "НачальныйНомер") Или СтрНачинаетсяС(ИмяПоля, "КонечныйНомер") Тогда
			// Для денежных документов не оформляем поля номеров бланков.
			Продолжить;
		КонецЕсли;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьПолейНеСоответствуетУсловиямАктиваПриПустомФакте(УсловноеОформление, ИмяТЧ, ИменаПолей, ДляФормыРазбивкиСтрокиРаздела = Ложь)
	
