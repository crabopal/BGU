#Область ЗаполнениеРаздела22

Функция ПолучитьТаблицуРаздела22(ВидДокумента, ТаблицаРаздела1, ТаблицаРаздела21)
	
	ПараметрыПоискаКлючейСтрок = ПолучитьПараметрыПоискаКлючейСтрок(ТаблицаРаздела21);
	
	ЗаполнитьУсловныйНомерСтрокиВРазделе21(ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок);
	
	ТаблицыРасхожденийБСО = ПолучитьТаблицыРасхожденийБСО(ТаблицаРаздела1, ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок);
	
	ТаблицаРасхожденийДенежныхДокументов = ПолучитьТаблицуРасхожденийДенежныхДокументов(ТаблицаРаздела1, ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок);
	
	ТаблицаНеАктива = ПолучитьТаблицуНеАктива(ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок);
	
	ДополнительныеТаблицы = Новый Структура();
	ДополнительныеТаблицы.Вставить("ТаблицаРаздела21",						ТаблицаРаздела21);
	ДополнительныеТаблицы.Вставить("ТаблицыРасхожденийБСО",					ТаблицыРасхожденийБСО);
	ДополнительныеТаблицы.Вставить("ТаблицаНеАктива",						ТаблицаНеАктива);
	ДополнительныеТаблицы.Вставить("ТаблицаРасхожденийДенежныхДокументов",	ТаблицаРасхожденийДенежныхДокументов);
	
	ТаблицаРаздела22 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти.Раздел22);
	
	ДобавитьТаблицыВРаздел22(ТаблицаРаздела22, ДополнительныеТаблицы, ПараметрыПоискаКлючейСтрок);
	
	Возврат ТаблицаРаздела22;
	
КонецФункции

Функция ПолучитьПустуюТаблицуРасчетаРаздела22()
	
	Таблица = Новый ТаблицаЗначений();
	
	ДобавитьКолонкуУсловныйНомерСтроки(Таблица);
	
	ОписанияТипов = ПолучитьОписанияТиповДляТаблицРасчета();
	
	Таблица.Колонки.Добавить("КодСтроки",			ОписанияТипов.КодСтроки);
	Таблица.Колонки.Добавить("НачальныйНомер",		ОписанияТипов.НомерБСО);
	Таблица.Колонки.Добавить("КонечныйНомер",		ОписанияТипов.НомерБСО);
	Таблица.Колонки.Добавить("Цена",				ОписанияТипов.Сумма);
	Таблица.Колонки.Добавить("Количество",			ОписанияТипов.Количество);
	Таблица.Колонки.Добавить("МножительКоличества", ОбщегоНазначения.ОписаниеТипаЧисло(2,0,ДопустимыйЗнак.Неотрицательный));
	Таблица.Колонки.Добавить("Сумма",				ОписанияТипов.Сумма);
	Таблица.Колонки.Добавить("Статус",				Новый ОписаниеТипов("СправочникСсылка.СтатусыБланковБСОИДенежныхДокументов"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьОбщийМассивКодовСтрокТаблиц(ДополнительныеТаблицы, ПоискУсловногоНомераСтроки)
	
	ОбщийМассив = Новый Массив();
	
	ДополнитьОбщийМассивКодовСтрок(ОбщийМассив, ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Излишки,		ПоискУсловногоНомераСтроки);
	ДополнитьОбщийМассивКодовСтрок(ОбщийМассив, ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Недостача,		ПоискУсловногоНомераСтроки);
	ДополнитьОбщийМассивКодовСтрок(ОбщийМассив, ДополнительныеТаблицы.ТаблицаНеАктива,						ПоискУсловногоНомераСтроки);
	ДополнитьОбщийМассивКодовСтрок(ОбщийМассив, ДополнительныеТаблицы.ТаблицаРасхожденийДенежныхДокументов,	ПоискУсловногоНомераСтроки);
	
	Возврат ОбщийМассив;
	
КонецФункции

Процедура ДополнитьОбщийМассивКодовСтрок(ОбщийМассив, Таблица, ПоискУсловногоНомераСтроки)
	
	ВремТаблица = Таблица.Скопировать(ПоискУсловногоНомераСтроки, "КодСтроки");
	
	Если ВремТаблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремТаблица.Свернуть("КодСтроки");
	МассивКодовСтрок = ВремТаблица.ВыгрузитьКолонку("КодСтроки");
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОбщийМассив, МассивКодовСтрок, Истина);
	
КонецПроцедуры
	
Процедура ДобавитьТаблицыВРаздел22(ТаблицаРаздела22, ДополнительныеТаблицы, ПараметрыПоискаКлючейСтрок)
	
	ПолеПоискаУсловныйНомер				= "УсловныйНомерСтроки";
	ПоляПоискаУсловныйНомерИКодСтроки	= "УсловныйНомерСтроки,КодСтроки";
	
	ПоискУсловногоНомераСтроки				= Новый Структура(ПолеПоискаУсловныйНомер);
	ПоискУсловногоНомераСтрокиИКодаСтроки	= Новый Структура(ПоляПоискаУсловныйНомерИКодСтроки);
	
	ДополнительныеТаблицы.ТаблицаРаздела21.Индексы.Добавить(ПоляПоискаУсловныйНомерИКодСтроки);
	
	ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Излишки.Индексы.Добавить(ПолеПоискаУсловныйНомер);
	ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Недостача.Индексы.Добавить(ПолеПоискаУсловныйНомер);
	ДополнительныеТаблицы.ТаблицаНеАктива.Индексы.Добавить(ПолеПоискаУсловныйНомер);
	ДополнительныеТаблицы.ТаблицаРасхожденийДенежныхДокументов.Индексы.Добавить(ПолеПоискаУсловныйНомер);
	
	ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Излишки.Индексы.Добавить(ПоляПоискаУсловныйНомерИКодСтроки);
	ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Недостача.Индексы.Добавить(ПоляПоискаУсловныйНомерИКодСтроки);
	ДополнительныеТаблицы.ТаблицаНеАктива.Индексы.Добавить(ПоляПоискаУсловныйНомерИКодСтроки);
	ДополнительныеТаблицы.ТаблицаРасхожденийДенежныхДокументов.Индексы.Добавить(ПоляПоискаУсловныйНомерИКодСтроки);
	
	ДобавитьКолонкуУсловныйНомерСтроки(ТаблицаРаздела22);
	
	ПрочиеРеквизиты = ПолучитьПустуюСтруктуруПрочихРеквизитов();
	
	Для Каждого СтрокаТаблицыКлючей Из ПараметрыПоискаКлючейСтрок.ТаблицаКлючей Цикл
		ЗаполнитьЗначенияСвойств(ПоискУсловногоНомераСтроки, СтрокаТаблицыКлючей);
		
		ОбщийМассивКодовСтрок = ПолучитьОбщийМассивКодовСтрокТаблиц(ДополнительныеТаблицы, ПоискУсловногоНомераСтроки);
		
		ЗаполнитьЗначенияСвойств(ПоискУсловногоНомераСтрокиИКодаСтроки, ПоискУсловногоНомераСтроки);
		
		ЭтоКлючПоискаБСО = ЗначениеЗаполнено(СтрокаТаблицыКлючей.БСО);
		
		Для Каждого КодСтроки Из ОбщийМассивКодовСтрок Цикл
			ПоискУсловногоНомераСтрокиИКодаСтроки.КодСтроки = КодСтроки;
			
			ЗаполнитьПрочиеРеквизитыИзСтрокиРаздела21(ПрочиеРеквизиты, ДополнительныеТаблицы.ТаблицаРаздела21, ПоискУсловногоНомераСтрокиИКодаСтроки);
			
			МассивСтрокИзлишкиБСО						= ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Излишки.НайтиСтроки(ПоискУсловногоНомераСтрокиИКодаСтроки);
			МассивСтрокНедостачаБСО						= ДополнительныеТаблицы.ТаблицыРасхожденийБСО.Недостача.НайтиСтроки(ПоискУсловногоНомераСтрокиИКодаСтроки);
			МассивСтрокНеАктив							= ДополнительныеТаблицы.ТаблицаНеАктива.НайтиСтроки(ПоискУсловногоНомераСтрокиИКодаСтроки);
			МассивСтрокРасхожденияДенежныхДокументов	= ДополнительныеТаблицы.ТаблицаРасхожденийДенежныхДокументов.НайтиСтроки(ПоискУсловногоНомераСтрокиИКодаСтроки);
			
			КоличествоСтрокИзлишкиБСО						= МассивСтрокИзлишкиБСО.Количество();
			КоличествоСтрокНедостачаБСО						= МассивСтрокНедостачаБСО.Количество();
			КоличествоСтрокНеАктив							= МассивСтрокНеАктив.Количество();
			КоличествоСтрокРасхожденияДенежныхДокументов	= МассивСтрокРасхожденияДенежныхДокументов.Количество();
			
			КоличествоСтрокРасхождений = Макс(
				КоличествоСтрокИзлишкиБСО,
				КоличествоСтрокНедостачаБСО,
				КоличествоСтрокНеАктив,
				КоличествоСтрокРасхожденияДенежныхДокументов);
			
			Для СчетчикСтрок = 1 По КоличествоСтрокРасхождений Цикл
				НоваяСтрока = ТаблицаРаздела22.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыКлючей);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПрочиеРеквизиты);
				
				Если СчетчикСтрок <= КоличествоСтрокНеАктив Тогда
					СтрокаТаблицы = МассивСтрокНеАктив[СчетчикСтрок - 1];
					
					НоваяСтрока.НачальныйНомерНеСоответствует	= СтрокаТаблицы.НачальныйНомер;
					НоваяСтрока.КонечныйНомерНеСоответствует	= СтрокаТаблицы.КонечныйНомер;
					НоваяСтрока.КоличествоНеСоответствует		= СтрокаТаблицы.Количество;
					
 					Если ЭтоКлючПоискаБСО Тогда
						НоваяСтрока.СуммаНеСоответствует		= ПрочиеРеквизиты.Цена * СтрокаТаблицы.Количество;
					Иначе
						НоваяСтрока.СуммаНеСоответствует		= СтрокаТаблицы.Сумма;
					КонецЕсли;
					
					НоваяСтрока.Статус							= СтрокаТаблицы.Статус;
					НоваяСтрока.КодСтроки						= СтрокаТаблицы.КодСтроки;
				КонецЕсли;
				
				Если СчетчикСтрок <= КоличествоСтрокИзлишкиБСО Тогда
					СтрокаТаблицы = МассивСтрокИзлишкиБСО[СчетчикСтрок - 1];
					
					НоваяСтрока.НачальныйНомерИзлишки	= СтрокаТаблицы.НачальныйНомер;
					НоваяСтрока.КонечныйНомерИзлишки	= СтрокаТаблицы.КонечныйНомер;
					НоваяСтрока.КоличествоИзлишки		= СтрокаТаблицы.Количество;
					НоваяСтрока.СуммаИзлишки			= ПрочиеРеквизиты.Цена * СтрокаТаблицы.Количество;
					НоваяСтрока.КодСтроки				= СтрокаТаблицы.КодСтроки;
				КонецЕсли;
				
				Если СчетчикСтрок <= КоличествоСтрокНедостачаБСО Тогда
					СтрокаТаблицы = МассивСтрокНедостачаБСО[СчетчикСтрок - 1];
					
					НоваяСтрока.НачальныйНомерНедостача	= СтрокаТаблицы.НачальныйНомер;
					НоваяСтрока.КонечныйНомерНедостача	= СтрокаТаблицы.КонечныйНомер;
					НоваяСтрока.КоличествоНедостача		= СтрокаТаблицы.Количество;
					НоваяСтрока.СуммаНедостача			= ПрочиеРеквизиты.Цена * СтрокаТаблицы.Количество;
					НоваяСтрока.КодСтроки				= СтрокаТаблицы.КодСтроки;
				КонецЕсли;
				
				Если СчетчикСтрок <= КоличествоСтрокРасхожденияДенежныхДокументов Тогда
					СтрокаТаблицы = МассивСтрокРасхожденияДенежныхДокументов[СчетчикСтрок - 1];
					
					НоваяСтрока.КоличествоИзлишки	= СтрокаТаблицы.КоличествоИзлишки;
					НоваяСтрока.КоличествоНедостача	= СтрокаТаблицы.КоличествоНедостача;
					
					НоваяСтрока.СуммаИзлишки		= СтрокаТаблицы.СуммаИзлишки;
					НоваяСтрока.СуммаНедостача		= СтрокаТаблицы.СуммаНедостача;
					НоваяСтрока.КодСтроки			= СтрокаТаблицы.КодСтроки;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаРаздела22.Сортировать("КодСтроки");
	
КонецПроцедуры

Процедура ЗаполнитьУсловныйНомерСтрокиВРазделе21(ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок)
	
	ДобавитьКолонкуУсловныйНомерСтроки(ТаблицаРаздела21);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела21 Цикл
		СтрокаТаблицы.УсловныйНомерСтроки = ПолучитьУсловныйНомерСтроки(СтрокаТаблицы, ПараметрыПоискаКлючейСтрок.ТаблицаКлючей, ПараметрыПоискаКлючейСтрок.ПоискКлючаОбщий);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьУсловныйНомерСтроки(СтрокаСКлючом, ТаблицаКлючей, ПоискКлюча)
	
	ЗаполнитьЗначенияСвойств(ПоискКлюча, СтрокаСКлючом);
	
	МассивСтрок = ТаблицаКлючей.НайтиСтроки(ПоискКлюча);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0].УсловныйНомерСтроки;
	
КонецФункции

Функция ПолучитьПустуюСтруктуруПрочихРеквизитов()
	
	Возврат Новый Структура("ЕдИзм,Цена");
	
КонецФункции

Функция ОчиститьСтруктуруПрочихРеквизитов(ПрочиеРеквизиты)
	
	ПрочиеРеквизиты.ЕдИзм = Неопределено;
	ПрочиеРеквизиты.Цена = 0;
	
КонецФункции

Процедура ЗаполнитьПрочиеРеквизитыИзСтрокиРаздела21(ПрочиеРеквизиты, ТаблицаРаздела21, ПоискУсловногоНомераСтрокиИКодаСтроки)
	
	МассивСтрок = ТаблицаРаздела21.НайтиСтроки(ПоискУсловногоНомераСтрокиИКодаСтроки);
	
	Если МассивСтрок.Количество() = 0 Тогда
		ОчиститьСтруктуруПрочихРеквизитов(ПрочиеРеквизиты);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПрочиеРеквизиты, МассивСтрок[0]);
	
КонецПроцедуры

Процедура ДобавитьКолонкуУсловныйНомерСтроки(Таблица)
	
	Таблица.Колонки.Добавить("УсловныйНомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	
КонецПроцедуры

Функция ПолучитьПараметрыПоискаКлючейСтрок(ТаблицаРаздела21)
	
	ИменаКолонокКлючаСтрокой = "ВидДенежногоДокумента,ДенежныйДокумент,БСО,Серия";
	
    ТаблицаКлючей = ПолучитьТаблицуКлючейРаздела21(ТаблицаРаздела21, ИменаКолонокКлючаСтрокой);
	
	ПоискКлючаОбщий = Новый Структура(ИменаКолонокКлючаСтрокой);
	
	ПоискКлючаБСО = Новый Структура(ИменаКолонокКлючаСтрокой);
	ПоискКлючаБСО.ВидДенежногоДокумента	= Справочники.ВидыДенежныхДокументов.ПустаяСсылка();
	ПоискКлючаБСО.ДенежныйДокумент		= Справочники.ДенежныеДокументы.ПустаяСсылка();
	
	ПоискКлючаДенежногоДокумента = Новый Структура(ИменаКолонокКлючаСтрокой);
	ПоискКлючаДенежногоДокумента.БСО	= Справочники.БСО.ПустаяСсылка();
	ПоискКлючаДенежногоДокумента.Серия	= Справочники.СерииБСО.ПустаяСсылка();
	
	ПараметрыПоискаКлючейСтрок = Новый Структура();
	ПараметрыПоискаКлючейСтрок.Вставить("ИменаКолонокКлючаСтрокой",		ИменаКолонокКлючаСтрокой);
	ПараметрыПоискаКлючейСтрок.Вставить("ТаблицаКлючей",				ТаблицаКлючей);
	ПараметрыПоискаКлючейСтрок.Вставить("ПоискКлючаОбщий",				ПоискКлючаОбщий);
	ПараметрыПоискаКлючейСтрок.Вставить("ПоискКлючаБСО",				ПоискКлючаБСО);
	ПараметрыПоискаКлючейСтрок.Вставить("ПоискКлючаДенежногоДокумента",	ПоискКлючаДенежногоДокумента);
	
	Возврат ПараметрыПоискаКлючейСтрок;
	
КонецФункции

Функция ПолучитьТаблицуКлючейРаздела21(Знач ТаблицаРаздела21, Знач ИменаКолонокКлючаСтрокой)
	
	ПоляВыбораТЗ = Новый Массив();
	ПоляВыбораВТ = Новый Массив();
	ПоляГруппировкиВТ = Новый Массив();
	
	МассивИмен = СтрРазделить(ИменаКолонокКлючаСтрокой, ", ", Ложь);
	
	Для Каждого ИмяПоля Из МассивИмен Цикл
		ПоляВыбораТЗ.Добавить(СтрШаблон("ТЗ.%1	КАК %1", ИмяПоля));
		ПоляВыбораВТ.Добавить(СтрШаблон("%1	КАК %1", ИмяПоля));
		ПоляГруппировкиВТ.Добавить(СтрШаблон("%1", ИмяПоля));
	КонецЦикла;
	
	ЗапросКлючей = Новый Запрос();
	ЗапросКлючей.УстановитьПараметр("ТЗ", ТаблицаРаздела21);
	ЗапросКлючей.Текст = "
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	&ПоляВыбораТЗ
	|ПОМЕСТИТЬ
	|	ВТ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(НомерСтроки) КАК УсловныйНомерСтроки,
	|	&ПоляВыбораВТ
	|ИЗ
	|	ВТ
	|СГРУППИРОВАТЬ ПО
	|	&ПоляГруппировкиВТ
	|УПОРЯДОЧИТЬ ПО
	|	МИНИМУМ(НомерСтроки)";
	
	ЗапросКлючей.Текст = СтрЗаменить(ЗапросКлючей.Текст, "&ПоляВыбораТЗ", СтрСоединить(ПоляВыбораТЗ, ",
	|	"));
	
	ЗапросКлючей.Текст = СтрЗаменить(ЗапросКлючей.Текст, "&ПоляВыбораВТ", СтрСоединить(ПоляВыбораВТ, ",
	|	"));
	
	ЗапросКлючей.Текст = СтрЗаменить(ЗапросКлючей.Текст, "&ПоляГруппировкиВТ", СтрСоединить(ПоляГруппировкиВТ, ",
	|	"));
	
	ТаблицаКлючей = ЗапросКлючей.Выполнить().Выгрузить();
	
	ТаблицаКлючей.Индексы.Добавить(ИменаКолонокКлючаСтрокой);
	
	Возврат ТаблицаКлючей;
	
КонецФункции

Функция ПолучитьТаблицуНеАктива(ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок)
	
	ТаблицаНеАктива = ПолучитьПустуюТаблицуРасчетаРаздела22();
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела21 Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КоличествоНеСоответствует) И Не ЗначениеЗаполнено(СтрокаТаблицы.СуммаНеСоответствует) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНеАктива.Добавить();
		
		НоваяСтрока.УсловныйНомерСтроки	= СтрокаТаблицы.УсловныйНомерСтроки;
		НоваяСтрока.НачальныйНомер		= СтрокаТаблицы.НачальныйНомерНеСоответствует;
		НоваяСтрока.КонечныйНомер		= СтрокаТаблицы.КонечныйНомерНеСоответствует;
		НоваяСтрока.Цена				= СтрокаТаблицы.Цена;
		НоваяСтрока.Количество			= СтрокаТаблицы.КоличествоНеСоответствует;
		НоваяСтрока.Сумма				= СтрокаТаблицы.СуммаНеСоответствует;
		НоваяСтрока.Статус				= СтрокаТаблицы.Статус;
		НоваяСтрока.КодСтроки			= СтрокаТаблицы.КодСтроки;
	КонецЦикла;
	
	ТаблицаНеАктива.Сортировать("УсловныйНомерСтроки");
	
	Возврат ТаблицаНеАктива;
	
КонецФункции

// БСО

Функция ПолучитьТаблицыРасхожденийБСО(ТаблицаРаздела1, ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок)
	
	Перем ПараметрыКодовСтрок;
	
	ПоискБСО = Новый Структура();
	ПоискБСО.Вставить("ВидДенежногоДокумента",	Справочники.ВидыДенежныхДокументов.ПустаяСсылка());
	ПоискБСО.Вставить("ДенежныйДокумент",		Справочники.ДенежныеДокументы.ПустаяСсылка());
	
	ТаблицаРаздела21БСО = ТаблицаРаздела21.Скопировать(ПоискБСО);
	
	ТаблицаГраниц = ПолучитьТаблицуГраницДляРасчетаРасхожденийБСО(ТаблицаРаздела1, ТаблицаРаздела21БСО, ПараметрыКодовСтрок);
	
	МножительКоличества = 0;
	МножительКоличестваУчет = 0;
	МножительКоличестваФакт = 0;
	
	СчетчикСтрок = 0;
	КоличествоСтрок = ТаблицаГраниц.Количество();
	
	ТаблицаНедостача = ПолучитьПустуюТаблицуРасчетаРаздела22();
	ТаблицаИзлишки = ПолучитьПустуюТаблицуРасчетаРаздела22();
	
	СледующаяСтрокаТаблицы = Неопределено;
	
	КодыСтрок = Новый Массив();
	
	// ТаблицаГраниц уже отсортирована по колонкам БСО, Серия, Граница.
	
	Для Каждого СтрокаТаблицы Из ТаблицаГраниц Цикл
		СчетчикСтрок = СчетчикСтрок + 1;
		
		МножительКоличестваУчет = МножительКоличестваУчет + СтрокаТаблицы.ДельтаКоличествоУчет;
		МножительКоличестваФакт = МножительКоличестваФакт + СтрокаТаблицы.ДельтаКоличествоФакт;
		
		Если СчетчикСтрок < КоличествоСтрок Тогда
			СледующаяСтрокаТаблицы = ТаблицаГраниц[СчетчикСтрок];
		КонецЕсли;
		
		ЭтоПоследняяСтрокаТекущегоБланка = (СчетчикСтрок = КоличествоСтрок
			Или СтрокаТаблицы.БСО <> СледующаяСтрокаТаблицы.БСО 
			Или СтрокаТаблицы.Серия <> СледующаяСтрокаТаблицы.Серия);
		
		Если ЭтоПоследняяСтрокаТекущегоБланка Тогда
			МножительКоличестваУчет = 0;
			МножительКоличестваФакт = 0;
			
			КодыСтрок = Новый Массив();
			
			Продолжить;
		КонецЕсли;
		
		ОбновитьКодыСтрок(КодыСтрок, СтрокаТаблицы, ПараметрыКодовСтрок);
		
		РазностьМножителей = МножительКоличестваФакт - МножительКоличестваУчет;
		
		МножительКоличества = Макс(РазностьМножителей, -РазностьМножителей);
		
		НомерНачальный	= СтрокаТаблицы.Граница;
		НомерКонечный	= СледующаяСтрокаТаблицы.Граница - 1;
		Количество		= ?(НомерНачальный = 0 И НомерКонечный = 0, 0, НомерКонечный - НомерНачальный + 1);
		
		КоличествоУчет = Количество * МножительКоличестваУчет;
		КоличествоФакт = Количество * МножительКоличестваФакт;
		
		КоличествоРасхождение = КоличествоУчет - КоличествоФакт;
		
		ЕстьДанныеНедостача	= (КоличествоРасхождение > 0);
		ЕстьДанныеИзлишек	= (КоличествоРасхождение < 0);
		
		Если ЕстьДанныеНедостача Тогда
			ТаблицаРасхождений = ТаблицаНедостача;
			
		ИначеЕсли ЕстьДанныеИзлишек Тогда
			ТаблицаРасхождений = ТаблицаИзлишки;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуВТаблицуРасхожденийБСО(ТаблицаРасхождений, СтрокаТаблицы, МножительКоличества, СледующаяСтрокаТаблицы, ПараметрыПоискаКлючейСтрок, КодыСтрок[0]);
	КонецЦикла;
	
	ТаблицаИзлишки.Сортировать("УсловныйНомерСтроки");
	ТаблицаНедостача.Сортировать("УсловныйНомерСтроки");
	
	Результат = Новый Структура();
	Результат.Вставить("Излишки",	ТаблицаИзлишки);
	Результат.Вставить("Недостача",	ТаблицаНедостача);
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьКодыСтрок(КодыСтрок, СтрокаТаблицыГраниц, ПараметрыКодовСтрок)
	
	ЗаполнитьЗначенияСвойств(ПараметрыКодовСтрок.Поиск, СтрокаТаблицыГраниц);
	
	// Ищем завершение диапазона
	
	ПараметрыКодовСтрок.Поиск.ЭтоЛеваяГраница	= Ложь;
	ПараметрыКодовСтрок.Поиск.ЭтоПраваяГраница	= Истина;
	
	МассивСтрок = ПараметрыКодовСтрок.ТаблицаГраницСКодамиСтрок.НайтиСтроки(ПараметрыКодовСтрок.Поиск);
	
	Для Каждого СтрокаТаблицыГраницСКодамиСтрок Из МассивСтрок Цикл
		// Удаляем первый найденный с начала массива.
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(КодыСтрок, СтрокаТаблицыГраницСКодамиСтрок.КодСтроки);
	КонецЦикла;
	
	// Ищем начало диапазона
	
	ПараметрыКодовСтрок.Поиск.ЭтоЛеваяГраница	= Истина;
	ПараметрыКодовСтрок.Поиск.ЭтоПраваяГраница	= Ложь;
	
	МассивСтрок = ПараметрыКодовСтрок.ТаблицаГраницСКодамиСтрок.НайтиСтроки(ПараметрыКодовСтрок.Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицыГраницСКодамиСтрок Из МассивСтрок Цикл
			КодыСтрок.Вставить(0, СтрокаТаблицыГраницСКодамиСтрок.КодСтроки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОписанияТиповДляТаблицРасчета()
	
	ОписанияТипов = Новый Структура();
	ОписанияТипов.Вставить("Количество",		ОбщегоНазначения.ОписаниеТипаЧисло(20,0,ДопустимыйЗнак.Неотрицательный));
	ОписанияТипов.Вставить("ДельтаКоличество",	ОбщегоНазначения.ОписаниеТипаЧисло(20,0,ДопустимыйЗнак.Любой));
	ОписанияТипов.Вставить("Сумма",				ОбщегоНазначения.ОписаниеТипаЧисло(18,2,ДопустимыйЗнак.Неотрицательный));
	ОписанияТипов.Вставить("Цена",				ОбщегоНазначения.ОписаниеТипаЧисло(18,2,ДопустимыйЗнак.Неотрицательный));
	ОписанияТипов.Вставить("НомерБСО",			ОбщегоНазначения.ОписаниеТипаЧисло(20,0,ДопустимыйЗнак.Неотрицательный));
	ОписанияТипов.Вставить("КодСтроки",			ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	
	Возврат ОписанияТипов;
	
КонецФункции

Функция ПолучитьТаблицуГраницДляРасчетаРасхожденийБСО(Знач ТаблицаРаздела1, Знач ТаблицаРаздела21, ПараметрыКодовСтрок)
	
	ОписанияТипов = ПолучитьОписанияТиповДляТаблицРасчета();
	
	ТаблицаГраниц = Новый ТаблицаЗначений();
	ТаблицаГраниц.Колонки.Добавить("БСО",					Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ТаблицаГраниц.Колонки.Добавить("Серия",					Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаГраниц.Колонки.Добавить("Граница",				ОписанияТипов.НомерБСО);
	ТаблицаГраниц.Колонки.Добавить("ДельтаКоличествоУчет",	ОписанияТипов.ДельтаКоличество);
	ТаблицаГраниц.Колонки.Добавить("ДельтаКоличествоФакт",	ОписанияТипов.ДельтаКоличество);
	
	ТаблицаГраниц.Колонки.Добавить("КодСтроки",				ОписанияТипов.КодСтроки);
	ТаблицаГраниц.Колонки.Добавить("ЭтоЛеваяГраница",		Новый ОписаниеТипов("Булево"));
	ТаблицаГраниц.Колонки.Добавить("ЭтоПраваяГраница",		Новый ОписаниеТипов("Булево"));
	
	// Добавляем данные учета
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела1 Цикл
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		НоваяСтрока.БСО						= СтрокаТаблицы.БСО;
		НоваяСтрока.Серия					= СтрокаТаблицы.Серия;
		НоваяСтрока.Граница					= СтрокаТаблицы.НачальныйНомер;
		НоваяСтрока.ДельтаКоличествоУчет	= СтрокаТаблицы.МножительКоличества; // 1
		НоваяСтрока.КодСтроки				= СтрокаТаблицы.НомерСтроки;
		НоваяСтрока.ЭтоЛеваяГраница			= Истина;
		
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		НоваяСтрока.БСО						= СтрокаТаблицы.БСО;
		НоваяСтрока.Серия					= СтрокаТаблицы.Серия;
		НоваяСтрока.Граница					= СтрокаТаблицы.КонечныйНомер + 1;
		НоваяСтрока.ДельтаКоличествоУчет	= -СтрокаТаблицы.МножительКоличества; // -1
		НоваяСтрока.КодСтроки				= СтрокаТаблицы.НомерСтроки;
		НоваяСтрока.ЭтоПраваяГраница		= Истина;
	КонецЦикла;
	
	// Добавляем фактическое наличие
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела21 Цикл
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		НоваяСтрока.БСО						= СтрокаТаблицы.БСО;
		НоваяСтрока.Серия					= СтрокаТаблицы.Серия;
		НоваяСтрока.Граница					= СтрокаТаблицы.НачальныйНомер;
		НоваяСтрока.ДельтаКоличествоФакт	= 1;
		НоваяСтрока.КодСтроки				= СтрокаТаблицы.КодСтроки;
		НоваяСтрока.ЭтоЛеваяГраница			= Истина;
		
		НоваяСтрока = ТаблицаГраниц.Добавить();
		
		НоваяСтрока.БСО						= СтрокаТаблицы.БСО;
		НоваяСтрока.Серия					= СтрокаТаблицы.Серия;
		НоваяСтрока.Граница					= СтрокаТаблицы.КонечныйНомер + 1;
		НоваяСтрока.ДельтаКоличествоФакт	= -1;
		НоваяСтрока.КодСтроки				= СтрокаТаблицы.КодСтроки;
		НоваяСтрока.ЭтоПраваяГраница		= Истина;
	КонецЦикла;
	
	ПараметрыКодовСтрок = ПолучитьПараметрыКодовСтрок(ТаблицаГраниц.Скопировать());
	
	ТаблицаГраниц.Свернуть("БСО,Серия,Граница", "ДельтаКоличествоУчет,ДельтаКоличествоФакт");
	
	ТаблицаГраниц.Сортировать("БСО,Серия,Граница", Новый СравнениеЗначений);
	
	Возврат ТаблицаГраниц;
	
КонецФункции
	
Процедура ДобавитьСтрокуВТаблицуРасхожденийБСО(ТаблицаРасхождений, СтрокаТаблицыГраниц, МножительКоличества, СледующаяСтрокаТаблицы, ПараметрыПоискаКлючейСтрок, КодСтроки)
	
	НоваяСтрока = ТаблицаРасхождений.Добавить();
	
	НоваяСтрока.УсловныйНомерСтроки	= ПолучитьУсловныйНомерСтроки(СтрокаТаблицыГраниц, ПараметрыПоискаКлючейСтрок.ТаблицаКлючей, ПараметрыПоискаКлючейСтрок.ПоискКлючаБСО);
	НоваяСтрока.НачальныйНомер		= СтрокаТаблицыГраниц.Граница;
	НоваяСтрока.КонечныйНомер		= СледующаяСтрокаТаблицы.Граница - 1;
	
	Количество = ?(НоваяСтрока.НачальныйНомер = 0 И НоваяСтрока.КонечныйНомер = 0,
		0,
		НоваяСтрока.КонечныйНомер - НоваяСтрока.НачальныйНомер + 1);
		
	НоваяСтрока.Количество			= Количество * МножительКоличества;
	НоваяСтрока.МножительКоличества	= МножительКоличества;
	
	НоваяСтрока.КодСтроки = КодСтроки;
	
КонецПроцедуры

Функция ПолучитьПараметрыКодовСтрок(ТаблицаГраницСКодамиСтрок)
	
	ТаблицаГраницСКодамиСтрок.Колонки.Удалить("ДельтаКоличествоУчет");
	ТаблицаГраницСКодамиСтрок.Колонки.Удалить("ДельтаКоличествоФакт");
	
	ПоляПоиска = "БСО,Серия,Граница,ЭтоЛеваяГраница,ЭтоПраваяГраница";
	
	ТаблицаГраницСКодамиСтрок.Индексы.Добавить(ПоляПоиска);
	
	ПараметрыКодовСтрок = Новый Структура();
	ПараметрыКодовСтрок.Вставить("ТаблицаГраницСКодамиСтрок",	ТаблицаГраницСКодамиСтрок);
	ПараметрыКодовСтрок.Вставить("Поиск",						Новый Структура(ПоляПоиска));
	
	Возврат ПараметрыКодовСтрок;
	
КонецФункции

// Денежные документы

Функция ПолучитьТаблицуРасхожденийДенежныхДокументов(ТаблицаРаздела1, ТаблицаРаздела21, ПараметрыПоискаКлючейСтрок)
	
	ОписанияТипов = ПолучитьОписанияТиповДляТаблицРасчета();
	
	ТаблицаРасхождений = Новый ТаблицаЗначений();
	ТаблицаРасхождений.Колонки.Добавить("ВидДенежногоДокумента",	Новый ОписаниеТипов("СправочникСсылка.ВидыДенежныхДокументов"));
	ТаблицаРасхождений.Колонки.Добавить("ДенежныйДокумент",			Новый ОписаниеТипов("СправочникСсылка.ДенежныеДокументы"));
	ТаблицаРасхождений.Колонки.Добавить("Цена",						ОписанияТипов.Цена);
	ТаблицаРасхождений.Колонки.Добавить("КоличествоИзлишки",		ОписанияТипов.Количество);
	ТаблицаРасхождений.Колонки.Добавить("КоличествоНедостача",		ОписанияТипов.Количество);
	ТаблицаРасхождений.Колонки.Добавить("СуммаИзлишки",				ОписанияТипов.Сумма);
	ТаблицаРасхождений.Колонки.Добавить("СуммаНедостача",			ОписанияТипов.Сумма);
	ТаблицаРасхождений.Колонки.Добавить("КодСтроки",				ОписанияТипов.КодСтроки);
	
	ПараметрыРасчета = ИнвентаризацияСервер.ПолучитьПараметрыРасчетаИзлишковНедостачи();
	ПараметрыРасчета.ЭтоОпись0510465 = Истина;
	
	ПоискДенежныхДокументов = Новый Структура();
	ПоискДенежныхДокументов.Вставить("БСО",		Справочники.БСО.ПустаяСсылка());
	ПоискДенежныхДокументов.Вставить("Серия",	Справочники.СерииБСО.ПустаяСсылка());
	
	ТаблицаРаздела1ДенежныеДокументы = ТаблицаРаздела1.Скопировать(ПоискДенежныхДокументов);
	ТаблицаРаздела21ДенежныеДокументы = ТаблицаРаздела21.Скопировать(ПоискДенежныхДокументов);
	
	СвернутьТаблицуДенежныхДокументовИЗаполнитьКодыСтрок(ТаблицаРаздела21ДенежныеДокументы);
	
	ИнвентаризацияСервер.РассчитатьИзлишкиНедостачу(
		ТаблицаРаздела1ДенежныеДокументы,
		ТаблицаРаздела21ДенежныеДокументы,
		ТаблицаРасхождений,
		"ВидДенежногоДокумента,ДенежныйДокумент",
		"Количество,Сумма",
		ПараметрыРасчета);
		
	ЗаполнитьУсловныйНомерСтрокиВТаблицеРасхожденийДенежныхДокументов(ТаблицаРасхождений, ПараметрыПоискаКлючейСтрок);
	
	ТаблицаРасхождений.Сортировать("УсловныйНомерСтроки");
	
	Возврат ТаблицаРасхождений;
	
КонецФункции

Процедура СвернутьТаблицуДенежныхДокументовИЗаполнитьКодыСтрок(Таблица)
	
	// Исключаем дубли строк по колонкам связи, в связи с возможностью добавления строк вручную.
	
	ЗапросСвертка = Новый Запрос();
	ЗапросСвертка.УстановитьПараметр("Таблица", Таблица);
	ЗапросСвертка.Текст = "
	|ВЫБРАТЬ
	|	ТЗ.ВидДенежногоДокумента	КАК ВидДенежногоДокумента,
	|	ТЗ.ДенежныйДокумент			КАК ДенежныйДокумент,
	|	ТЗ.Цена						КАК Цена,
	|	ТЗ.Количество				КАК Количество,
	|	ТЗ.Сумма					КАК Сумма,
	|	ТЗ.КодСтроки				КАК КодСтроки
	|ПОМЕСТИТЬ
	|	ВТ
	|ИЗ
	|	&Таблица КАК ТЗ
	|;
	|
	|ВЫБРАТЬ
	|	ВидДенежногоДокумента	КАК ВидДенежногоДокумента,
	|	ДенежныйДокумент		КАК ДенежныйДокумент,
	|	Цена					КАК Цена,
	|	СУММА(Количество)		КАК Количество,
	|	СУММА(Сумма)			КАК Сумма,
	|	МИНИМУМ(КодСтроки)		КАК КодСтроки
	|ИЗ
	|	ВТ
	|СГРУППИРОВАТЬ ПО
	|	ВидДенежногоДокумента,
	|	ДенежныйДокумент,
	|	Цена";
	
	Таблица = ЗапросСвертка.Выполнить().Выгрузить();
	
КонецПроцедуры

Процедура ЗаполнитьУсловныйНомерСтрокиВТаблицеРасхожденийДенежныхДокументов(ТаблицаРасхождений, ПараметрыПоискаКлючейСтрок)
	
	ДобавитьКолонкуУсловныйНомерСтроки(ТаблицаРасхождений);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРасхождений Цикл
		СтрокаТаблицы.УсловныйНомерСтроки = ПолучитьУсловныйНомерСтроки(СтрокаТаблицы, ПараметрыПоискаКлючейСтрок.ТаблицаКлючей, ПараметрыПоискаКлючейСтрок.ПоискКлючаДенежногоДокумента);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьЕдИзм(ТаблицаОстатков, ВидДокумента)
	
	Если ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО Тогда
		ИмяКолонки = "БСО";
		
	ИначеЕсли ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы Тогда
		ИмяКолонки = "ДенежныйДокумент";
	Иначе
		Возврат;
	КонецЕсли;
	
	ВремТаблица = ТаблицаОстатков.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	
	МассивСсылок = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	ЕдиницыИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСсылок, "ЕдиницаИзмерения");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОстатков Цикл
		СтрокаТаблицы.ЕдИзм = ЕдиницыИзмерения.Получить(СтрокаТаблицы[ИмяКолонки]);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКолонкиДляДобавленныхРеквизитовФормы_Общие(Таблица)
	
	Таблица.Колонки.Добавить("ДокументВладелец",			ПолучитьОписаниеТиповДокументВладелец());
	Таблица.Колонки.Добавить("ДокументПодчиненный",			ПолучитьОписаниеТиповДокументПодчиненный());
	Таблица.Колонки.Добавить("ДлинаНомера",					ОбщегоНазначения.ОписаниеТипаЧисло(2,0,ДопустимыйЗнак.Неотрицательный));
	Таблица.Колонки.Добавить("НомерДенежногоДокумента",		Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("НомСтоимость",				ОбщегоНазначения.ОписаниеТипаЧисло(15,2,ДопустимыйЗнак.Любой));
	
КонецПроцедуры

Процедура ДобавитьКолонкиДляДобавленныхРеквизитовФормы_ПредставленияНомеровБСО(Таблица, ИмяТЧ)
	
	ТипПредставлениеНомера = ОбщегоНазначения.ОписаниеТипаСтрока(20);
	
	ПостфиксыИменКолонокНомеровВРазделах = ПолучитьПостфиксыИменКолонокНомеровВРазделах();
	
	Для Каждого ПостфиксИмени Из ПостфиксыИменКолонокНомеровВРазделах[ИмяТЧ] Цикл
		Таблица.Колонки.Добавить("НачальныйНомер" + ПостфиксИмени + "Представление",	ТипПредставлениеНомера);
		Таблица.Колонки.Добавить("КонечныйНомер" + ПостфиксИмени + "Представление",		ТипПредставлениеНомера);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКолонкиДляДобавленныхРеквизитовФормы_РазбивкаСтроки(Таблица)
	
	Таблица.Колонки.Добавить("ПризнакФрагментаСтроки", Новый ОписаниеТипов("Булево"));
	
