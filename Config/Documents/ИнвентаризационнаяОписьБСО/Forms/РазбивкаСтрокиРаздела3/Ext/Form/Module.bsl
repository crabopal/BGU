&НаКлиенте
Перем ИсключитьПересчетТаблицыИзлишки, ИсключитьПересчетТаблицыНедостача;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьПредставленияНомеровБСО = ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО();
	
	ЗагрузитьПереданныеСведения();
	
	СостояниеНастройки = Неопределено;
	
	ПрименитьНастройкуРедактированияСумм(ЭтотОбъект, СостояниеНастройки);
	
	НастроитьВидимостьНастройкиРедактированияСумм(СостояниеНастройки);
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Пометка = РазрешеноРедактироватьСуммы;
	
	НастроитьНедоступностьИзмененияКолонокСумм();
	
	НастроитьФормуСерверПоВидуДокумента();
	
	УстановитьУсловноеОформление(); // Важно размещение в конец процедуры, после полного выполнения инициализации.
	
	Документы.ИнвентаризационнаяОписьБСО.УстановитьЦветКолонокНомераБланковБСО(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСлужебныеКолонкиТаблицы("Излишки");
	ЗаполнитьСлужебныеКолонкиТаблицы("Недостача");
	
	ОбновитьИтогиТаблицы("Излишки");
	ОбновитьИтогиТаблицы("Недостача");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	Если ЭтоДенежныйДокумент Тогда
		НепроверяемыеРеквизиты.Добавить("ТаблицаИзлишки.НачальныйНомер");
		НепроверяемыеРеквизиты.Добавить("ТаблицаИзлишки.КонечныйНомер");
		НепроверяемыеРеквизиты.Добавить("ТаблицаНедостача.НачальныйНомер");
		НепроверяемыеРеквизиты.Добавить("ТаблицаНедостача.КонечныйНомер");
		
		Если Не ВестиКоличественныйУчетДенежныхДокументов Тогда
			НепроверяемыеРеквизиты.Добавить("ТаблицаИзлишки.Количество");
			НепроверяемыеРеквизиты.Добавить("ТаблицаНедостача.Количество");
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаИзлишки

&НаКлиенте
Процедура ТаблицаИзлишкиПриИзменении(Элемент)
	
	ВидРасхождения = "Излишки";
	
	ЗаполнитьСлужебныеКолонкиТаблицы(ВидРасхождения);
	
	ОбновитьИтогиТаблицы(ВидРасхождения);
	
	Если ИсключитьПересчетТаблицыИзлишки = Истина Тогда
		ИсключитьПересчетТаблицыИзлишки = Неопределено;
		
		ПроверитьИВключитьНастройкуРедактированияСумм();
		
		Возврат;
	КонецЕсли;
	
	ПересчитатьТаблицу(ВидРасхождения);
	
	ПроверитьИВключитьНастройкуРедактированияСумм();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзлишкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ВидРасхождения = "Излишки";
		
		ЗаполнитьДобавленнуюСтроку(Элементы.ТаблицаИзлишки.ТекущиеДанные, Копирование);
		
		Если ТаблицаИзлишки.Количество() = 1 Тогда
			ЗаполнитьЕдинственнуюДобавленнуюСтроку(ВидРасхождения);
		КонецЕсли;
		
		ОбновитьИтогиТаблицы(ВидРасхождения);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаИзлишкиНачальныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Излишки");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзлишкиКонечныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Излишки");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзлишкиКоличествоПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Излишки");
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаИзлишкиСуммаПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Излишки");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзлишкиНаименованиеДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыИзлишки = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаИзлишкиНомерДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыИзлишки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзлишкиДатаДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыИзлишки = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаНедостача

&НаКлиенте
Процедура ТаблицаНедостачаПриИзменении(Элемент)
	
	ВидРасхождения = "Недостача";
	
	ЗаполнитьСлужебныеКолонкиТаблицы(ВидРасхождения);
	
	ОбновитьИтогиТаблицы(ВидРасхождения);
	
	Если ИсключитьПересчетТаблицыНедостача = Истина Тогда
		ИсключитьПересчетТаблицыНедостача = Неопределено;
		
		ПроверитьИВключитьНастройкуРедактированияСумм();
		
		Возврат;
	КонецЕсли;
	
	ПересчитатьТаблицу(ВидРасхождения);
	
	ПроверитьИВключитьНастройкуРедактированияСумм();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНедостачаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ВидРасхождения = "Недостача";
		
		ЗаполнитьДобавленнуюСтроку(Элементы.ТаблицаНедостача.ТекущиеДанные, Копирование);
		
		Если ТаблицаНедостача.Количество() = 1 Тогда
			ЗаполнитьЕдинственнуюДобавленнуюСтроку(ВидРасхождения);
		КонецЕсли;
		
		ОбновитьИтогиТаблицы(ВидРасхождения);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаНедостачаКонечныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Недостача");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНедостачаКоличествоПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Недостача");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНедостачаНачальныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Недостача");
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаНедостачаСуммаПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент, "Недостача");
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаНедостачаНаименованиеДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыНедостача = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНедостачаНомерДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыНедостача = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНедостачаДатаДокументаПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицыНедостача = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешеноРедактироватьСуммы(Команда)
	
	ИзменитьЗначениеНастройкиИНастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПроверитьИПеренестиВДокумент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ИнвентаризационнаяОписьБСО.УстановитьУсловноеОформление_ФормаРазбивкиСтрокиРаздела3(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"ВидДокумента,ВестиКоличественныйУчетДенежныхДокументов,РедактируетсяКоличество,РедактируетсяСумма,РазрешеноРедактироватьСуммы,ЭтоБСО,ЭтоДенежныйДокумент");
	
	ЭтоБСО				= (ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	ИдентификаторСтроки = Параметры.ИсходнаяСтрока.ИдентификаторСтроки;
	
	ТаблицаИсходнаяСтрока.Очистить();
	
	НоваяСтрока = ТаблицаИсходнаяСтрока.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
	
	Цена = Параметры.ИсходнаяСтрока.Цена;
	
	КоличествоНедостача		= Параметры.ИсходнаяСтрока.КоличествоНедостача;
	СуммаНедостача			= Параметры.ИсходнаяСтрока.СуммаНедостача;
	НачальныйНомерНедостача	= Параметры.ИсходнаяСтрока.НачальныйНомерНедостача;
	КонечныйНомерНедостача	= Параметры.ИсходнаяСтрока.КонечныйНомерНедостача;
	
	КоличествоИзлишки		= Параметры.ИсходнаяСтрока.КоличествоИзлишки;
	СуммаИзлишки			= Параметры.ИсходнаяСтрока.СуммаИзлишки;
	НачальныйНомерИзлишки	= Параметры.ИсходнаяСтрока.НачальныйНомерИзлишки;
	КонечныйНомерИзлишки	= Параметры.ИсходнаяСтрока.КонечныйНомерИзлишки;
	
	СписокНомеров = Новый СписокЗначений();
	
	ЗаполнитьФрагментыСтрок(СписокНомеров);
	
	СтруктураЗаполненияНовойСтроки = Новый Структура("
		|НомерДенежногоДокумента,
		|НомСтоимость,
		|ДлинаНомера,
		// Для вывода надписи номеров условным оформлением НомерСтроки должен быть заполнен; сам по себе НомерСтроки не используется.
		|НомерСтроки");
		
	ЗаполнитьЗначенияСвойств(СтруктураЗаполненияНовойСтроки, Параметры.ИсходнаяСтрока);
	
	СтруктураЗаполненияНовойСтроки = Новый ФиксированнаяСтруктура(СтруктураЗаполненияНовойСтроки);
	
	НомераСтрокФрагментов = Новый ФиксированныйМассив(СписокНомеров.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверПоВидуДокумента()
	
	КолонкиНомеров = Новый Массив();
	
	КолонкиНомеров.Добавить("ТаблицаИзлишкиКонечныйНомер");
	КолонкиНомеров.Добавить("ТаблицаИзлишкиНачальныйНомер");
	
	КолонкиНомеров.Добавить("ТаблицаНедостачаНачальныйНомер");
	КолонкиНомеров.Добавить("ТаблицаНедостачаКонечныйНомер");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкиНомеров, "Видимость", ЭтоБСО);
	
	Элементы.ДекорацияОписаниеБСО.Видимость							= ЭтоБСО;
	Элементы.ДекорацияОписаниеДДСКоличественнымУчетом.Видимость		= ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов;
	Элементы.ДекорацияОписаниеДДБезКоличественногоУчета.Видимость	= ЭтоДенежныйДокумент И Не ВестиКоличественныйУчетДенежныхДокументов;
	
	ИтогиКоличества = Новый Массив();
	ИтогиКоличества.Добавить("ИтогКоличествоИзлишки");
	ИтогиКоличества.Добавить("ИтогКоличествоНедостача");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИтогиКоличества, "Видимость", РедактируетсяКоличество);
	
	НедостачаОтсутствует = Не ЗначениеЗаполнено(СуммаНедостача);
	ИзлишкиОтсутствуют = Не ЗначениеЗаполнено(СуммаИзлишки);
	
	Если РедактируетсяКоличество Тогда
		НедостачаОтсутствует = НедостачаОтсутствует И Не ЗначениеЗаполнено(КоличествоНедостача);
		ИзлишкиОтсутствуют = ИзлишкиОтсутствуют И Не ЗначениеЗаполнено(КоличествоИзлишки);
	КонецЕсли;
	
	Если НедостачаОтсутствует Тогда
		Элементы.ТаблицаНедостача.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если ИзлишкиОтсутствуют Тогда
		Элементы.ТаблицаИзлишки.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонокСумм()
	
	ИменаКолонок = Новый Массив();
	
	ИменаКолонок.Добавить("ТаблицаИзлишкиСумма");
	ИменаКолонок.Добавить("ТаблицаНедостачаСумма");
	
	Если РедактируетсяСумма Тогда
		ИнвентаризацияСервер.ОтключитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, ИменаКолонок);
	Иначе
		ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, ИменаКолонок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСлужебныеКолонкиТаблицы(ВидРасхождения)
	
	Таблица = ЭтотОбъект["Таблица" + ВидРасхождения];
	
	НПП = 0;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НПП = НПП + 1;
		
		СтрокаТаблицы.НПП = НПП;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиТаблицы(ВидРасхождения)
	
	Таблица = ЭтотОбъект["Таблица" + ВидРасхождения];
	
	ЭтотОбъект["КоличествоСтрокТаблица" + ВидРасхождения] = Таблица.Количество();
	
	ЭтотОбъект["ИтогКоличество" + ВидРасхождения]	= Таблица.Итог("Количество");
	ЭтотОбъект["ИтогСумма" + ВидРасхождения]		= Таблица.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяРаздела(Элемент, ВидРасхождения)
	
	ТекДанные = Элементы["Таблица" + ВидРасхождения].ТекущиеДанные;
	
	ОписаниеИзмененногоПоказателя = ПолучитьОписаниеИзмененногоПоказателя(Элемент, ВидРасхождения);
	
	Если ЭтоБСО Тогда
		ОбновитьПоказателиВСтрокеРасхожденияБСО(ТекДанные, ВидРасхождения, ОписаниеИзмененногоПоказателя);
		
		Если ИспользоватьПредставленияНомеровБСО Тогда
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, "НачальныйНомер", "КонечныйНомер");
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		ОбновитьПоказателиВСтрокеРасхожденияДенежныйДокумент(ТекДанные, ВидРасхождения, ОписаниеИзмененногоПоказателя);
	КонецЕсли;
	
	ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(ТекДанные);
	
	ПересчитатьТаблицу(ВидРасхождения, ТекДанные, Элемент);
	
	Если ВидРасхождения = "Излишки" Тогда
		ИсключитьПересчетТаблицыИзлишки = Истина;
	Иначе
		ИсключитьПересчетТаблицыНедостача = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДобавленнуюСтроку(ТекДанные, Копирование)
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураЗаполненияНовойСтроки);
	
	Если Копирование Тогда
		ОчищающаяСтруктура = Новый Структура("
			|Количество,
			|Сумма,
			|НачальныйНомер,
			|КонечныйНомер,
			|НачальныйНомерПредставление,
			|КонечныйНомерПредставление,
			|НомерДокумента,
			|ДатаДокумента,
			|НаименованиеДокумента");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЕдинственнуюДобавленнуюСтроку(ВидРасхождения)
	
	ТекДанные = Элементы["Таблица" + ВидРасхождения].ТекущиеДанные;
	
	ТекДанные.НачальныйНомер	= ЭтотОбъект["НачальныйНомер" + ВидРасхождения];
	ТекДанные.КонечныйНомер		= ЭтотОбъект["КонечныйНомер" + ВидРасхождения];
	ТекДанные.Количество		= ЭтотОбъект["Количество" + ВидРасхождения];
	ТекДанные.Сумма				= ЭтотОбъект["Сумма" + ВидРасхождения];
	
	ТекДанные.НачальныйНомерПредставление	= Параметры.ИсходнаяСтрока["НачальныйНомер" + ВидРасхождения + "Представление"];
	ТекДанные.КонечныйНомерПредставление	= Параметры.ИсходнаяСтрока["КонечныйНомер" + ВидРасхождения + "Представление"];
	
	ТекДанные.НаименованиеДокумента	= Параметры.ИсходнаяСтрока.НаименованиеДокумента;
	ТекДанные.НомерДокумента		= Параметры.ИсходнаяСтрока.НомерДокумента;
	ТекДанные.ДатаДокумента			= Параметры.ИсходнаяСтрока.ДатаДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНомераБланковБСОВТаблицеПриИзмененииНомераВСтрокеРаздела3(ТекДанные, ВидРасхождения)
	
	Если ТекДанные.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = ЭтотОбъект["Таблица" + ВидРасхождения];
	
	СортироватьФрагментыБСО(ВидРасхождения);
	
	// Диапазоны слева
	НомерТекущейСтроки = Таблица.Индекс(ТекДанные) + 1;
	ТекущаяЛеваяГраница = ТекДанные.НачальныйНомер;
	
	Для Счетчик = 1 По НомерТекущейСтроки - 1 Цикл
		НомерСтроки = НомерТекущейСтроки - Счетчик;
		
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			// Пропускаем строки с пустыми номерами.
			Продолжить;
		КонецЕсли;
		
		НоваяПраваяГраница = ТекущаяЛеваяГраница - 1;
		
		Если НоваяПраваяГраница < СтрокаТаблицы.НачальныйНомер Тогда
			СтрокаТаблицы.НачальныйНомер = 0;
			СтрокаТаблицы.КонечныйНомер = 0;
			СтрокаТаблицы.Количество = 0;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
			
		ИначеЕсли СтрокаТаблицы.НачальныйНомер <= НоваяПраваяГраница И НоваяПраваяГраница <= СтрокаТаблицы.КонечныйНомер Тогда
			СтрокаТаблицы.КонечныйНомер = НоваяПраваяГраница;
			СтрокаТаблицы.Количество = СтрокаТаблицы.КонечныйНомер - СтрокаТаблицы.НачальныйНомер + 1;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
			
			ТекущаяЛеваяГраница = СтрокаТаблицы.НачальныйНомер;
		КонецЕсли;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		Если ИспользоватьПредставленияНомеровБСО Тогда
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(СтрокаТаблицы, "НачальныйНомер", "КонечныйНомер");
		КонецЕсли;

	КонецЦикла;
	
	// Диапазоны справа
	КоличествоСтрок = Таблица.Количество();
	ТекущаяПраваяГраница = ТекДанные.КонечныйНомер;
	
	Для НомерСтроки = НомерТекущейСтроки + 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			// Пропускаем строки с пустыми номерами.
			Продолжить;
		КонецЕсли;
		
		НоваяЛеваяГраница = ТекущаяПраваяГраница + 1;
		
		Если НоваяЛеваяГраница > СтрокаТаблицы.КонечныйНомер Тогда
			СтрокаТаблицы.НачальныйНомер = 0;
			СтрокаТаблицы.КонечныйНомер = 0;
			СтрокаТаблицы.Количество = 0;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
			
		ИначеЕсли СтрокаТаблицы.НачальныйНомер <= НоваяЛеваяГраница И НоваяЛеваяГраница <= СтрокаТаблицы.КонечныйНомер Тогда
			СтрокаТаблицы.НачальныйНомер = НоваяЛеваяГраница;
			СтрокаТаблицы.Количество = СтрокаТаблицы.КонечныйНомер - СтрокаТаблицы.НачальныйНомер + 1;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
			
			ТекущаяПраваяГраница = СтрокаТаблицы.КонечныйНомер;
		КонецЕсли;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		Если ИспользоватьПредставленияНомеровБСО Тогда
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(СтрокаТаблицы, "НачальныйНомер", "КонечныйНомер");
		КонецЕсли;
	КонецЦикла;
	
	СортироватьФрагментыБСО(ВидРасхождения);
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьФрагментыБСО(ВидРасхождения)
	
	ЭтотОбъект["Таблица" + ВидРасхождения].Сортировать("ЗаполненоКоличество УБЫВ,НачальныйНомер ВОЗР");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьКоличествоДенежныхДокументовВТаблицеПриИзмененииКоличестваВСтрокеРаздела3(ТекДанные, ВидРасхождения)
	
	Если ВидРасхождения = "Излишки" Тогда
		РазбиваемоеКоличество	= КоличествоИзлишки;
		ИтогКоличество			= ИтогКоличествоИзлишки;
		
	ИначеЕсли ВидРасхождения = "Недостача" Тогда
		РазбиваемоеКоличество	= КоличествоНедостача;
		ИтогКоличество			= ИтогКоличествоНедостача;
	КонецЕсли;
	
	ДельтаКоличество = РазбиваемоеКоличество - ИтогКоличество;
	
	Если ДельтаКоличество >= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = ЭтотОбъект["Таблица" + ВидРасхождения];
	
	КоличествоСтрок = Таблица.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НомерСтроки = КоличествоСтрок - Счетчик + 1;
		
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		Если СтрокаТаблицы = ТекДанные Или Не ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			// Пропускаем текущую строку и строки с пустым количеством.
			Продолжить;
		КонецЕсли;
		
		НовоеКоличество = СтрокаТаблицы.Количество + ДельтаКоличество;
		
		Если НовоеКоличество < 0 Тогда
			НовоеКоличество = 0;
		КонецЕсли;
		
		ДельтаКоличество = ДельтаКоличество - (НовоеКоличество - СтрокаТаблицы.Количество);
		
		СтрокаТаблицы.Количество = НовоеКоличество;
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		Если ДельтаКоличество = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДельтаКоличество <> 0 Тогда
		СтрокаТаблицы.Количество = СтрокаТаблицы.Количество + ДельтаКоличество;
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * Цена;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыДенежныхДокументовВТаблицеПриИзмененииСуммыВСтрокеРаздела3(ТекДанные, ВидРасхождения)
	
	Если ВидРасхождения = "Излишки" Тогда
		МаксимальнаяСумма	= СуммаИзлишки;
		ИтогСумма			= ИтогСуммаИзлишки;
		
	ИначеЕсли ВидРасхождения = "Недостача" Тогда
		МаксимальнаяСумма	= СуммаНедостача;
		ИтогСумма			= ИтогСуммаНедостача;
	КонецЕсли;
	
	ДельтаСумма = МаксимальнаяСумма - ИтогСумма;
	
	Если ДельтаСумма >= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = ЭтотОбъект["Таблица" + ВидРасхождения];
	
	КоличествоСтрок = Таблица.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НомерСтроки = КоличествоСтрок - Счетчик + 1;
		
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		Если СтрокаТаблицы = ТекДанные Или Не ЗначениеЗаполнено(СтрокаТаблицы.Сумма) Тогда
			// Пропускаем текущую строку и строки с пустой суммой.
			Продолжить;
		КонецЕсли;
		
		НоваяСумма = СтрокаТаблицы.Сумма + ДельтаСумма;
		
		Если НоваяСумма < 0 Тогда
			НоваяСумма = 0;
		КонецЕсли;
		
		ДельтаСумма = ДельтаСумма - (НоваяСумма - СтрокаТаблицы.Сумма);
		
		СтрокаТаблицы.Сумма = НоваяСумма;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		Если ДельтаСумма = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДельтаСумма <> 0 Тогда
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + ДельтаСумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаполненоКоличество = (СтрокаТаблицы.Количество > 0);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеИзмененногоПоказателя(Элемент, ВидРасхождения)
	
	Перем ОбозначениеИзмененногоПоля;
	
	ИмяЭлемента = Элемент.Имя;
	
	ИмяПоля = СтрЗаменить(ИмяЭлемента, "Таблица" + ВидРасхождения, "");
	
	// Излишки, подтверждено
	Если ИмяПоля = "НачальныйНомер" Тогда
		ОбозначениеИзмененногоПоля = "НомерНач";
		
	ИначеЕсли ИмяПоля = "КонечныйНомер" Тогда
		ОбозначениеИзмененногоПоля = "НомерКон";
		
	ИначеЕсли ИмяПоля = "Количество" Тогда
		ОбозначениеИзмененногоПоля = "Количество";
	КонецЕсли;
	
	ОписаниеИзмененногоПоказателя = Новый Структура();
	ОписаниеИзмененногоПоказателя.Вставить("ОбозначениеИзмененногоПоля", ОбозначениеИзмененногоПоля);
	
	Возврат ОписаниеИзмененногоПоказателя;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПоказателиВСтрокеРасхожденияБСО(ТекДанные, ВидРасхождения, ОписаниеИзмененногоПоказателя)
	
	ОбозначениеИзмененногоПоля = ОписаниеИзмененногоПоказателя.ОбозначениеИзмененногоПоля;
	
	МинимальныйНомер	= ЭтотОбъект["НачальныйНомер" + ВидРасхождения];
	МаксимальныйНомер	= ЭтотОбъект["КонечныйНомер" + ВидРасхождения];
	ИтоговоеКоличество	= ЭтотОбъект["Количество" + ВидРасхождения];
	ИтоговаяСумма		= ЭтотОбъект["Сумма" + ВидРасхождения];
	
	НомерНач	= ТекДанные.НачальныйНомер;
	НомерКон	= ТекДанные.КонечныйНомер;
	Количество	= ТекДанные.Количество;
	Сумма		= ТекДанные.Сумма;
	
	РассчитатьСумму = Ложь;
	
	Если ОбозначениеИзмененногоПоля = "НомерНач" Тогда
		Если НомерНач = 0 Или ИтоговоеКоличество = 0 Тогда
			// Очищаем все показатели.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
		Иначе
			Если НомерНач < МинимальныйНомер Тогда
				НомерНач = МинимальныйНомер;
			ИначеЕсли НомерНач > МаксимальныйНомер Тогда
				НомерНач = МаксимальныйНомер;
			КонецЕсли;
			
			Если НомерКон = 0 Тогда
				// Создаем новый диапазон номеров.
				НомерКон = ?(Количество = 0, НомерНач, НомерНач + Количество - 1);
				
			ИначеЕсли НомерНач > НомерКон И ЗначениеЗаполнено(НомерКон) Тогда
				НомерНач = НомерКон;
			КонецЕсли;
			
			Количество = НомерКон - НомерНач + 1;
			РассчитатьСумму = Истина;
		КонецЕсли;
			
	ИначеЕсли ОбозначениеИзмененногоПоля = "НомерКон" Тогда
		Если НомерКон = 0 Или ИтоговоеКоличество = 0  Тогда
			// Очищаем все показатели.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
		Иначе
			Если НомерКон < МинимальныйНомер Тогда
				НомерКон = МинимальныйНомер;
			ИначеЕсли НомерКон > МаксимальныйНомер Тогда
				НомерКон = МаксимальныйНомер;
			КонецЕсли;
			
			Если НомерНач = 0 Тогда
				// Создаем новый диапазон номеров.
				НомерНач = ?(Количество = 0, НомерКон, НомерКон - Количество + 1);
				
			ИначеЕсли НомерКон < НомерНач Тогда
				НомерКон = НомерНач;
			КонецЕсли;
			
			Количество = НомерКон - НомерНач + 1;
			РассчитатьСумму = Истина;
		КонецЕсли;
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "Количество" Тогда
		Если Количество > ИтоговоеКоличество Тогда
			Количество = ИтоговоеКоличество;
		КонецЕсли;
		
		Если Количество = 0 Или ИтоговоеКоличество = 0  Тогда
			// Очищаем все показатели.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
		Иначе
			// Количество указано
			
			Если НомерНач = 0 И НомерКон = 0 Тогда
				Количество = 0;
				
			Иначе
				// Сдвигаем правую границу.
				НомерКон = НомерНач + Количество - 1;
				
				Если НомерКон < МинимальныйНомер Тогда
					НомерКон = МинимальныйНомер;
				ИначеЕсли НомерКон > МаксимальныйНомер Тогда
					НомерКон = МаксимальныйНомер;
				КонецЕсли;
				
				Количество = НомерКон - НомерНач + 1;
			КонецЕсли;
			
			РассчитатьСумму = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если РассчитатьСумму Тогда
		Если Количество = ИтоговоеКоличество Тогда
			Сумма = ИтоговаяСумма;
		Иначе
			Сумма = Количество * Цена;
		КонецЕсли;
	КонецЕсли;
	
	ТекДанные.НачальныйНомер	= НомерНач;
	ТекДанные.КонечныйНомер		= НомерКон;
	ТекДанные.Количество		= Количество;
	ТекДанные.Сумма				= Сумма;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоказателиВСтрокеРасхожденияДенежныйДокумент(ТекДанные, ВидРасхождения, ОписаниеИзмененногоПоказателя)
	
	МаксимальноеКоличество	= ЭтотОбъект["Количество" + ВидРасхождения];
	МаксимальнаяСумма		= ЭтотОбъект["Сумма" + ВидРасхождения];
	
	Количество	= ТекДанные.Количество;
	Сумма		= ТекДанные.Сумма;
	
	ОбозначениеИзмененногоПоля = ОписаниеИзмененногоПоказателя.ОбозначениеИзмененногоПоля;
	
	Если ОбозначениеИзмененногоПоля = "Количество" Тогда
		Если Количество > МаксимальноеКоличество Тогда
			Количество = МаксимальноеКоличество;
		КонецЕсли;
		
		Если Количество = МаксимальноеКоличество Тогда
			Сумма = МаксимальнаяСумма;
		Иначе
			Сумма = Количество * Цена;
		КонецЕсли;
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "Сумма" Тогда
		Если Сумма > МаксимальнаяСумма Тогда
			Сумма = МаксимальнаяСумма;
		КонецЕсли;
	КонецЕсли;
	
	ТекДанные.Количество	= Количество;
	ТекДанные.Сумма			= Сумма;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФрагментыСтрок(СписокНомеров)
	
	ТаблицаИзлишки.Очистить();
	ТаблицаНедостача.Очистить();
	
	Если Параметры.ФрагментыСтроки <> Неопределено Тогда
		КоллекцияСтрок = Параметры.ФрагментыСтроки;
	Иначе
		КоллекцияСтрок = Новый Массив();
		КоллекцияСтрок.Добавить(Параметры.ИсходнаяСтрока);
	КонецЕсли;
	
	Для Каждого СтруктураСтроки Из КоллекцияСтрок Цикл
		СписокНомеров.Добавить(СтруктураСтроки.НомерСтроки);
		
		Если ЗначениеЗаполнено(СтруктураСтроки.КоличествоИзлишкиПодтверждено)
			Или ЗначениеЗаполнено(СтруктураСтроки.СуммаИзлишкиПодтверждено) Тогда
			ДобавитьСтрокуФрагмента(СтруктураСтроки, "Излишки");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураСтроки.КоличествоНедостачаПодтверждено)
			Или ЗначениеЗаполнено(СтруктураСтроки.СуммаНедостачаПодтверждено) Тогда
			ДобавитьСтрокуФрагмента(СтруктураСтроки, "Недостача");
		КонецЕсли;
	КонецЦикла;
	
	СписокНомеров.СортироватьПоЗначению();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуФрагмента(СтруктураСтроки, ВидРасхождения)
	
	НоваяСтрока = ЭтотОбъект["Таблица" + ВидРасхождения].Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
	
	НоваяСтрока.НачальныйНомер				= СтруктураСтроки["НачальныйНомер" + ВидРасхождения + "Подтверждено"];
	НоваяСтрока.КонечныйНомер				= СтруктураСтроки["КонечныйНомер" + ВидРасхождения + "Подтверждено"];
	НоваяСтрока.Количество					= СтруктураСтроки["Количество" + ВидРасхождения + "Подтверждено"];
	НоваяСтрока.Сумма						= СтруктураСтроки["Сумма" + ВидРасхождения + "Подтверждено"];
	НоваяСтрока.НачальныйНомерПредставление	= СтруктураСтроки["НачальныйНомер" + ВидРасхождения + "ПодтвержденоПредставление"];
	НоваяСтрока.КонечныйНомерПредставление	= СтруктураСтроки["КонечныйНомер" + ВидРасхождения + "ПодтвержденоПредставление"];
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки, "НомСтоимость,НомерДенежногоДокумента");
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки, "НаименованиеДокумента,НомерДокумента,ДатаДокумента");
	
	НоваяСтрока.ДлинаНомера = СтруктураСтроки.ДлинаНомера;
	
КонецПроцедуры

// Настройка редактирования сумм

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьНастройкуРедактированияСумм(Форма, СостояниеНастройки = Неопределено)
	
	Если СостояниеНастройки = Неопределено Тогда
		СостояниеНастройки = ПолучитьСостояниеНастройкиРедактированияСумм(Форма);
	КонецЕсли;
	
	Форма.РедактируетсяСумма = СостояниеНастройки.Значение;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьНастройкиРедактированияСумм(СостояниеНастройки)
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Видимость = СостояниеНастройки.Доступность;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСостояниеНастройкиРедактированияСумм(Форма)
	
	// См. копию функции в формах разбивки строк.
	
	СостояниеНастройки = Новый Структура("Доступность,Значение");
	
	ЗначениеДоступности = Форма.ЭтоБСО Или (Форма.ЭтоДенежныйДокумент И Форма.ВестиКоличественныйУчетДенежныхДокументов);
	
	Если ЗначениеДоступности Тогда
		ЗначениеНастройки = Форма.РазрешеноРедактироватьСуммы;
	Иначе
		ЗначениеНастройки = (Форма.ЭтоДенежныйДокумент И Не Форма.ВестиКоличественныйУчетДенежныхДокументов);
	КонецЕсли;
	
	СостояниеНастройки.Доступность	= ЗначениеДоступности;
	СостояниеНастройки.Значение		= ЗначениеНастройки;
	
	Возврат СостояниеНастройки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИВключитьНастройкуРедактированияСумм()
	
	Если Не РедактируетсяКоличество Тогда
		Возврат;
	КонецЕсли;
	
	Если РедактируетсяСумма Или РазрешеноРедактироватьСуммы Тогда
		Возврат;
	КонецЕсли;
	
	Если (ИтогКоличествоИзлишки = КоличествоИзлишки И ИтогСуммаИзлишки <> СуммаИзлишки)
		Или (ИтогКоличествоНедостача = КоличествоНедостача И ИтогСуммаНедостача <> СуммаНедостача) Тогда
		
		СостояниеНастройки = ПолучитьСостояниеНастройкиРедактированияСумм(ЭтотОбъект);
		
		Если Не СостояниеНастройки.Доступность Тогда
			Возврат;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("Подключаемый_ВключитьНастройкуРедактированияСумм", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВключитьНастройкуРедактированияСумм()
	
	ОтключитьОбработчикОжидания("Подключаемый_ВключитьНастройкуРедактированияСумм");
	
	ИзменитьЗначениеНастройкиИНастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗначениеНастройкиИНастроитьФорму()
	
	РазрешеноРедактироватьСуммы = Не РазрешеноРедактироватьСуммы;
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Пометка = РазрешеноРедактироватьСуммы;
	
	ПрименитьНастройкуРедактированияСумм(ЭтотОбъект);
	
	НастроитьНедоступностьИзмененияКолонокСумм();
	
КонецПроцедуры

// Возвращаемое значение

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		
		Закрыть();
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИПеренестиВДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИПеренестиВДокумент()
	
	Если Не ПроверитьПередЗакрытием() Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Закрыть(ПолучитьВозвращаемоеЗначениеКлиент());
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередЗакрытием()
	
	Отказ = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не РедактируетсяКоличество Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоИзлишки) И ИтогКоличествоИзлишки = КоличествоИзлишки И ИтогСуммаИзлишки <> СуммаИзлишки Тогда
		ТекстШаблон = НСтр("ru='Итог по колонке ""Сумма излишков"" (%1) не совпадает с исходной разбиваемой суммой %2 при совпадающих количествах.
			|Исправьте сумму в одной из строк табличной части.'");
		
		ФорматнаяСтрока = "ЧДЦ=2";
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Формат(ИтогСуммаИзлишки, ФорматнаяСтрока), Формат(СуммаИзлишки, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаИзлишки");
		
		Отказ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоНедостача) И ИтогКоличествоНедостача = КоличествоНедостача И ИтогСуммаНедостача <> СуммаНедостача Тогда
		ТекстШаблон = НСтр("ru='Итог по колонке ""Сумма недостачи"" (%1) не совпадает с исходной разбиваемой суммой %2 при совпадающих количествах.
			|Исправьте сумму в одной из строк табличной части.'");
		
		ФорматнаяСтрока = "ЧДЦ=2";
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Формат(ИтогСуммаНедостача, ФорматнаяСтрока), Формат(СуммаНедостача, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаНедостача");
		
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначениеКлиент()
	
	Возврат ПолучитьВозвращаемоеЗначениеСервер();
	
КонецФункции

&НаСервере
Функция ПолучитьВозвращаемоеЗначениеСервер()
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Таблица = СоставитьТаблицуФрагментовСтроки();
	
	ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	
	Для Каждого СтруктураСтроки Из ФрагментыСтроки Цикл
		СтруктураСтроки.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		СтруктураСтроки.Вставить("ПризнакФрагментаСтроки", Истина);
		
		СтруктураСтроки.Удалить("НомерСтроки");
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ФрагментыСтроки",		ФрагментыСтроки);
	Результат.Вставить("НомераСтрокФрагментов",	НомераСтрокФрагментов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СоставитьТаблицуФрагментовСтроки()
	
	ТаблицаИзлишкиПодтверждено = ТаблицаИзлишки.Выгрузить();
	ТаблицаНедостачаПодтверждено = ТаблицаНедостача.Выгрузить();
	
	Если ЭтоБСО Тогда
		ТаблицаИзлишкиПодтверждено.Сортировать("НачальныйНомер");
		ТаблицаНедостачаПодтверждено.Сортировать("НачальныйНомер");
		
		ТаблицаИзлишкиНеПодтверждено	= СоставитьТаблицуНеПодтвержденоБСО(ТаблицаИзлишкиПодтверждено, НачальныйНомерИзлишки, КонечныйНомерИзлишки);
		ТаблицаНедостачаНеПодтверждено	= СоставитьТаблицуНеПодтвержденоБСО(ТаблицаНедостачаПодтверждено, НачальныйНомерНедостача, КонечныйНомерНедостача);
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		ТаблицаИзлишкиНеПодтверждено	= СоставитьТаблицуНеПодтвержденоДенежныеДокументы(ТаблицаИзлишкиПодтверждено, КоличествоИзлишки, СуммаИзлишки);
		ТаблицаНедостачаНеПодтверждено	= СоставитьТаблицуНеПодтвержденоДенежныеДокументы(ТаблицаНедостачаПодтверждено, КоличествоНедостача, СуммаНедостача);
	КонецЕсли;
	
	ТаблицаФрагментов = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьБСО.ТабличныеЧасти.Раздел3);
	
	Документы.ИнвентаризационнаяОписьБСО.ДобавитьКолонкиДляДобавленныхРеквизитовФормы_Раздел3(ТаблицаФрагментов);
	
	ФрагментыИзлишки	= ТаблицаФрагментов.СкопироватьКолонки();
	ФрагментыНедостача	= ТаблицаФрагментов.СкопироватьКолонки();
	
	ДобавитьФрагментыРасхождений(ФрагментыИзлишки, ТаблицаИзлишкиПодтверждено, ТаблицаИзлишкиНеПодтверждено, "Излишки");
	ДобавитьФрагментыРасхождений(ФрагментыНедостача, ТаблицаНедостачаПодтверждено, ТаблицаНедостачаНеПодтверждено, "Недостача");
	
	СоставитьОбщуюТаблицу(ТаблицаФрагментов, ФрагментыИзлишки, ФрагментыНедостача);
	
	Возврат ТаблицаФрагментов;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОбщиеПоля(СтрокаТаблицы)
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Параметры.ИсходнаяСтрока,
		"ДокументВладелец,ДокументПодчиненный,НомерДенежногоДокумента,НомСтоимость,ДлинаНомера,"
		+ "ВидДенежногоДокумента,ДенежныйДокумент,БСО,Серия,Цена");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьФрагментыРасхождений(ТаблицаФрагментов, ТаблицаПодтверждено, ТаблицаНеПодтверждено, ВидРасхождения)
	
	КолонкиПервичногоДокумента = "НаименованиеДокумента,НомерДокумента,ДатаДокумента";
	
	КоличествоСтрокПодтверждено		= ТаблицаПодтверждено.Количество();
	КоличествоСтрокНеПодтверждено	= ТаблицаНеПодтверждено.Количество();
	
	КоличествоСтрок = Макс(КоличествоСтрокПодтверждено, КоличествоСтрокНеПодтверждено);
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НоваяСтрока = ТаблицаФрагментов.Добавить();
		
		ЗаполнитьОбщиеПоля(НоваяСтрока);
		
		ЛеваяГраница	= 0;
		ПраваяГраница	= 0;
		
		Если Счетчик <= КоличествоСтрокПодтверждено Тогда
			СтрокаТаблицы = ТаблицаПодтверждено[Счетчик - 1];
			
			Если ЭтоБСО Тогда
				НоваяСтрока["НачальныйНомер" + ВидРасхождения + "Подтверждено"]	= СтрокаТаблицы.НачальныйНомер;
				НоваяСтрока["КонечныйНомер" + ВидРасхождения + "Подтверждено"]	= СтрокаТаблицы.КонечныйНомер;
				
				ОбновитьГраницы(ЛеваяГраница, ПраваяГраница, СтрокаТаблицы);
			КонецЕсли;
			
			НоваяСтрока["Количество" + ВидРасхождения + "Подтверждено"]		= СтрокаТаблицы.Количество;
			НоваяСтрока["Сумма" + ВидРасхождения + "Подтверждено"]			= СтрокаТаблицы.Сумма;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, КолонкиПервичногоДокумента);
		КонецЕсли;
		
		Если Счетчик <= КоличествоСтрокНеПодтверждено Тогда
			СтрокаТаблицы = ТаблицаНеПодтверждено[Счетчик - 1];
			
			Если ЭтоБСО Тогда
				НоваяСтрока["НачальныйНомер" + ВидРасхождения + "НеПодтверждено"]	= СтрокаТаблицы.НачальныйНомер;
				НоваяСтрока["КонечныйНомер" + ВидРасхождения + "НеПодтверждено"]	= СтрокаТаблицы.КонечныйНомер;
				
				ОбновитьГраницы(ЛеваяГраница, ПраваяГраница, СтрокаТаблицы);
			КонецЕсли;
			
			НоваяСтрока["Количество" + ВидРасхождения + "НеПодтверждено"]		= СтрокаТаблицы.Количество;
			НоваяСтрока["Сумма" + ВидРасхождения + "НеПодтверждено"]			= СтрокаТаблицы.Сумма;
		КонецЕсли;
		
		Если ЭтоБСО Тогда
			Количество = ?(ЛеваяГраница = 0 И ПраваяГраница = 0, 0, ПраваяГраница - ЛеваяГраница + 1);
			
		ИначеЕсли ЭтоДенежныйДокумент Тогда
			Количество = НоваяСтрока["Количество" + ВидРасхождения + "Подтверждено"] + НоваяСтрока["Количество" + ВидРасхождения + "НеПодтверждено"];
		КонецЕсли;
		
		НоваяСтрока["НачальныйНомер" + ВидРасхождения]	= ЛеваяГраница;
		НоваяСтрока["КонечныйНомер" + ВидРасхождения] 	= ПраваяГраница;
		НоваяСтрока["Количество" + ВидРасхождения] 		= Количество;
		НоваяСтрока["Сумма" + ВидРасхождения] 			= НоваяСтрока["Сумма" + ВидРасхождения + "Подтверждено"] + НоваяСтрока["Сумма" + ВидРасхождения + "НеПодтверждено"];
		
		Если ЭтоБСО И ИспользоватьПредставленияНомеровБСО Тогда
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(НоваяСтрока, "НачальныйНомер" + ВидРасхождения,						"КонечныйНомер" + ВидРасхождения);
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(НоваяСтрока, "НачальныйНомер" + ВидРасхождения + "Подтверждено",		"КонечныйНомер" + ВидРасхождения + "Подтверждено");
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(НоваяСтрока, "НачальныйНомер" + ВидРасхождения + "НеПодтверждено",	"КонечныйНомер" + ВидРасхождения + "НеПодтверждено");
			
		ИначеЕсли ЭтоДенежныйДокумент Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "НомСтоимость,НомерДенежногоДокумента");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоставитьОбщуюТаблицу(ТаблицаФрагментов, ФрагментыИзлишки, ФрагментыНедостача)
	
	// В таблицу излишков добавляем строки недостачи.
	
	ТаблицаФрагментов = ФрагментыИзлишки;
	
	КопируемыеСвойства = ""
		+ "НачальныйНомерНедостача,КонечныйНомерНедостача,КоличествоНедостача,СуммаНедостача,"
		+ "НачальныйНомерНедостачаПредставление,КонечныйНомерНедостачаПредставление,"
		
		+ "НачальныйНомерНедостачаПодтверждено,КонечныйНомерНедостачаПодтверждено,КоличествоНедостачаПодтверждено,СуммаНедостачаПодтверждено,"
		+ "НачальныйНомерНедостачаПодтвержденоПредставление,КонечныйНомерНедостачаПодтвержденоПредставление,"
		
		+ "НачальныйНомерНедостачаНеПодтверждено,КонечныйНомерНедостачаНеПодтверждено,КоличествоНедостачаНеПодтверждено,СуммаНедостачаНеПодтверждено,"
		+ "НачальныйНомерНедостачаНеПодтвержденоПредставление,КонечныйНомерНедостачаНеПодтвержденоПредставление";
	
	КолонкиПервичногоДокумента = "НаименованиеДокумента,НомерДокумента,ДатаДокумента";
	
	Поиск = Новый Структура(КолонкиПервичногоДокумента);
	
	Для Каждого СтрокаТаблицыНедостача Из ФрагментыНедостача Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыНедостача);
		
		МассивСтрок = ТаблицаФрагментов.НайтиСтроки(Поиск);
		
		НайденаСтрокаСПустымКоличеством = Ложь;
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			Если СтрокаТаблицы.КоличествоНедостачаПодтверждено = 0 И СтрокаТаблицы.КоличествоНедостачаНеПодтверждено = 0 Тогда
				НайденаСтрокаСПустымКоличеством = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не НайденаСтрокаСПустымКоличеством Тогда
			СтрокаТаблицы = ТаблицаФрагментов.Добавить();
			
			ЗаполнитьОбщиеПоля(СтрокаТаблицы);
		КонецЕсли;
		
		УказанПервичныйДокументНедостача = ЗначениеЗаполнено(СтрокаТаблицыНедостача.НаименованиеДокумента)
			Или ЗначениеЗаполнено(СтрокаТаблицыНедостача.НомерДокумента)
			Или ЗначениеЗаполнено(СтрокаТаблицыНедостача.ДатаДокумента);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТаблицыНедостача, ?(УказанПервичныйДокументНедостача,
			КопируемыеСвойства + "," + КолонкиПервичногоДокумента,
			КопируемыеСвойства));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГраницы(ЛеваяГраница, ПраваяГраница, СтрокаТаблицы)
	
	Если ЛеваяГраница > СтрокаТаблицы.НачальныйНомер Или ЛеваяГраница = 0 Тогда
		ЛеваяГраница = СтрокаТаблицы.НачальныйНомер;
	КонецЕсли;
	
	Если ПраваяГраница < СтрокаТаблицы.КонечныйНомер Или ПраваяГраница = 0 Тогда
		ПраваяГраница = СтрокаТаблицы.КонечныйНомер;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу(ВидРасхождения, ИзмененнаяСтрока = Неопределено, ИзмененныйЭлемент = Неопределено)
	
	ОбновитьИтогиТаблицы(ВидРасхождения);
	
	Если ЭтоБСО Тогда
		ПересчитатьНомераБланковБСОВТаблицеПриИзмененииНомераВСтрокеРаздела3(ИзмененнаяСтрока, ВидРасхождения);
		
	ИначеЕсли ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов Тогда
		ПересчитатьКоличествоДенежныхДокументовВТаблицеПриИзмененииКоличестваВСтрокеРаздела3(ИзмененнаяСтрока, ВидРасхождения);
		
	ИначеЕсли ЭтоДенежныйДокумент И Не ВестиКоличественныйУчетДенежныхДокументов Тогда
		ПересчитатьСуммыДенежныхДокументовВТаблицеПриИзмененииСуммыВСтрокеРаздела3(ИзмененнаяСтрока, ВидРасхождения);
	КонецЕсли;
	
	ЗаполнитьСлужебныеКолонкиТаблицы(ВидРасхождения);
	
	ОбновитьИтогиТаблицы(ВидРасхождения);
	
КонецПроцедуры

&НаСервере
Функция СоставитьТаблицуНеПодтвержденоБСО(ТаблицаПодтверждено, МинимальныйНомерБСО, МаксимальныйНомерБСО)
	
	ТаблицаНеПодтверждено = ТаблицаПодтверждено.СкопироватьКолонки();
	
	ТекущаяПраваяГраница = МинимальныйНомерБСО - 1;
	
	Для Каждого СтрокаТаблицы Из ТаблицаПодтверждено Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.НачальныйНомер > ТекущаяПраваяГраница + 1 Тогда
			НоваяСтрока = ТаблицаНеПодтверждено.Добавить();
			НоваяСтрока.НачальныйНомер = ТекущаяПраваяГраница + 1;
			НоваяСтрока.КонечныйНомер = СтрокаТаблицы.НачальныйНомер - 1;
			НоваяСтрока.Количество = НоваяСтрока.КонечныйНомер - НоваяСтрока.НачальныйНомер + 1;
			НоваяСтрока.Сумма = НоваяСтрока.Количество * Цена;
		КонецЕсли;
		
		ТекущаяПраваяГраница = СтрокаТаблицы.КонечныйНомер;
	КонецЦикла;
	
	Если ТекущаяПраваяГраница < МаксимальныйНомерБСО И ЗначениеЗаполнено(МаксимальныйНомерБСО) Тогда
		НоваяСтрока = ТаблицаНеПодтверждено.Добавить();
		НоваяСтрока.НачальныйНомер = ТекущаяПраваяГраница + 1;
		НоваяСтрока.КонечныйНомер = МаксимальныйНомерБСО;
		НоваяСтрока.Количество = НоваяСтрока.КонечныйНомер - НоваяСтрока.НачальныйНомер + 1;
		НоваяСтрока.Сумма = НоваяСтрока.Количество * Цена;
	КонецЕсли;
	
	ТаблицаНеПодтверждено.Сортировать("НачальныйНомер");
	
	Возврат ТаблицаНеПодтверждено;
	
КонецФункции

&НаСервере
Функция СоставитьТаблицуНеПодтвержденоДенежныеДокументы(ТаблицаПодтверждено, РазбиваемоеКоличество, РазбиваемаяСумма)
	
	ТаблицаНеПодтверждено = ТаблицаПодтверждено.СкопироватьКолонки();
	
	КоличествоКонтр	= РазбиваемоеКоличество - ТаблицаПодтверждено.Итог("Количество");
	СуммаКонтр		= РазбиваемаяСумма - ТаблицаПодтверждено.Итог("Сумма");
	
	ОтклонениеКонтрОтсутствует = Не ЗначениеЗаполнено(СуммаКонтр);
	
	Если РедактируетсяКоличество Тогда
		ОтклонениеКонтрОтсутствует = ОтклонениеКонтрОтсутствует И Не ЗначениеЗаполнено(КоличествоКонтр);
	КонецЕсли;
	
	Если ОтклонениеКонтрОтсутствует Тогда
		Возврат ТаблицаНеПодтверждено;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаНеПодтверждено.Добавить();
	
	НоваяСтрока.Количество = КоличествоКонтр;
	НоваяСтрока.Сумма = СуммаКонтр;
	
	Возврат ТаблицаНеПодтверждено;
	
КонецФункции

#КонецОбласти
