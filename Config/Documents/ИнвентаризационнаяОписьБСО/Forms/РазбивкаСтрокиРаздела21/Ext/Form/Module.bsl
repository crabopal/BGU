&НаКлиенте
Перем ИсключитьПересчетТаблицы;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеСведения();
	
	СостояниеНастройки = Неопределено;
	
	ПрименитьНастройкуРедактированияСумм(ЭтотОбъект, СостояниеНастройки);
	
	НастроитьВидимостьНастройкиРедактированияСумм(СостояниеНастройки);
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Пометка = РазрешеноРедактироватьСуммы;
	
	НастроитьНедоступностьИзмененияКолонокСумм();
	
	НастроитьФормуСерверПоВидуДокумента();
	
	УстановитьУсловноеОформление(); // Важно размещение в конец процедуры, после полного выполнения инициализации.
	
	Документы.ИнвентаризационнаяОписьБСО.УстановитьЦветКолонокНомераБланковБСО(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСлужебныеКолонкиТаблицы();
	
	ОбновитьИтогиТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	НепроверяемыеРеквизиты.Добавить("ТаблицаФрагментыСтроки.КоличествоНеСоответствует");
	НепроверяемыеРеквизиты.Добавить("ТаблицаФрагментыСтроки.СуммаНеСоответствует");
	НепроверяемыеРеквизиты.Добавить("ТаблицаФрагментыСтроки.Статус");
	
	Если ЭтоДенежныйДокумент И Не ВестиКоличественныйУчетДенежныхДокументов Тогда
		НепроверяемыеРеквизиты.Добавить("ТаблицаФрагментыСтроки.Количество");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаФрагментыСтроки

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПриИзменении(Элемент)
	
	ЗаполнитьСлужебныеКолонкиТаблицы();
	
	ОбновитьИтогиТаблицы();
	
	Если ИсключитьПересчетТаблицы = Истина Тогда
		ИсключитьПересчетТаблицы = Неопределено;
		
		ПроверитьИВключитьНастройкуРедактированияСумм();
		
		Возврат;
	КонецЕсли;
	
	ПересчитатьТаблицу();
	
	ПроверитьИВключитьНастройкуРедактированияСумм();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПередУдалением(Элемент, Отказ)
	
	Если ТаблицаФрагментыСтроки.Количество() = Элементы.ТаблицаФрагментыСтроки.ВыделенныеСтроки.Количество() Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='Не предусмотрена полная очистка таблицы фрагментов строк.
			|Должна присутствовать хотя бы одна строка.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураЗаполненияНовойСтроки);
		
		Если Копирование Тогда
			ОчищающаяСтруктура = Новый Структура("
				|Количество,
				|Сумма,
				|КоличествоНеСоответствует,
				|СуммаНеСоответствует,
				|Статус,
				|НачальныйНомерНеСоответствует,
				|КонечныйНомерНеСоответствует,
				|НачальныйНомерНеСоответствуетПредставление,
				|КонечныйНомерНеСоответствуетПредставление");
			
			ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиНачальныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиКонечныйНомерПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиКоличествоПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаФрагментыСтрокиНачальныйНомерНеСоответствуетПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиКонечныйНомерНеСоответствуетПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиКоличествоНеСоответствуетПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаНеСоответствуетПриИзменении(Элемент)
	
	ПриИзмененииПоказателяРаздела(Элемент);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСтатусПриИзменении(Элемент)
	
	ИсключитьПересчетТаблицы = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешеноРедактироватьСуммы(Команда)
	
	ИзменитьЗначениеНастройкиИНастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПроверитьИПеренестиВДокумент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ИнвентаризационнаяОписьБСО.УстановитьУсловноеОформление_ФормаРазбивкиСтрокиРаздела21(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"ВидДокумента,ВестиКоличественныйУчетДенежныхДокументов,РедактируетсяКоличество,РедактируетсяСумма,РазрешеноРедактироватьСуммы,ЭтоБСО,ЭтоДенежныйДокумент");
	
	ЭтоБСО				= (ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	ИдентификаторСтроки = Параметры.ИсходнаяСтрока.ИдентификаторСтроки;
	
	ТаблицаИсходнаяСтрока.Очистить();
	
	НоваяСтрока = ТаблицаИсходнаяСтрока.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
	
	Количество		= Параметры.ИсходнаяСтрока.Количество;
	Сумма			= Параметры.ИсходнаяСтрока.Сумма;
	НачальныйНомер	= Параметры.ИсходнаяСтрока.НачальныйНомер;
	КонечныйНомер	= Параметры.ИсходнаяСтрока.КонечныйНомер;
	
	ТаблицаФрагментыСтроки.Очистить();
	
	СписокНомеров = Новый СписокЗначений();
	
	Если Параметры.ФрагментыСтроки = Неопределено Тогда
		НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
		
		СписокНомеров.Добавить(Параметры.ИсходнаяСтрока.НомерСтроки);
	Иначе
		Для Каждого СтруктураСтроки Из Параметры.ФрагментыСтроки Цикл
			НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			
			СписокНомеров.Добавить(СтруктураСтроки.НомерСтроки);
		КонецЦикла;
	КонецЕсли;
	
	СтруктураЗаполненияНовойСтроки = Новый Структура("
		|НомерДенежногоДокумента,
		|НомСтоимость,
		|ДлинаНомера,
		|ВидДенежногоДокумента,
		|ДенежныйДокумент,
		|БСО,
		|Серия,
		|ЕдИзм,
		|Цена,
		|ДокументВладелец,
		|ДокументПодчиненный,
		// Для вывода надписи номеров условным оформлением НомерСтроки должен быть заполнен; сам по себе НомерСтроки не используется.
		|НомерСтроки");
	
	ЗаполнитьЗначенияСвойств(СтруктураЗаполненияНовойСтроки, Параметры.ИсходнаяСтрока);
	
	Если ЭтоДенежныйДокумент Тогда
		СтруктураЗаполненияНовойСтроки.Вставить("НачальныйНомер",	Параметры.ИсходнаяСтрока.НачальныйНомер);
		СтруктураЗаполненияНовойСтроки.Вставить("КонечныйНомер",	Параметры.ИсходнаяСтрока.КонечныйНомер);
		СтруктураЗаполненияНовойСтроки.Вставить("НачальныйНомерПредставление",	Параметры.ИсходнаяСтрока.НачальныйНомерПредставление);
		СтруктураЗаполненияНовойСтроки.Вставить("КонечныйНомерПредставление",	Параметры.ИсходнаяСтрока.КонечныйНомерПредставление);
		СтруктураЗаполненияНовойСтроки.Вставить("НачальныйНомерНеСоответствуетПредставление",	Параметры.ИсходнаяСтрока.НачальныйНомерНеСоответствуетПредставление);
		СтруктураЗаполненияНовойСтроки.Вставить("КонечныйНомерНеСоответствуетПредставление",	Параметры.ИсходнаяСтрока.КонечныйНомерНеСоответствуетПредставление);
	КонецЕсли;
	
	СтруктураЗаполненияНовойСтроки = Новый ФиксированнаяСтруктура(СтруктураЗаполненияНовойСтроки);
	
	СписокНомеров.СортироватьПоЗначению();
	
	НомераСтрокФрагментов = Новый ФиксированныйМассив(СписокНомеров.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверПоВидуДокумента()
	
	КолонкиНомеров = Новый Массив();
	
	КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаНадписьНачальныйНомер");
	КолонкиНомеров.Добавить("ТаблицаИсходнаяСтрокаНадписьКонечныйНомер");
	
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНадписьНачальныйНомер");
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНадписьКонечныйНомер");
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНачальныйНомер");
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиКонечныйНомер");
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиНачальныйНомерНеСоответствует");
	КолонкиНомеров.Добавить("ТаблицаФрагментыСтрокиКонечныйНомерНеСоответствует");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкиНомеров, "Видимость", ЭтоБСО);
	
	Элементы.ДекорацияОписаниеБСО.Видимость							= ЭтоБСО;
	Элементы.ДекорацияОписаниеДДСКоличественнымУчетом.Видимость		= ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов;
	Элементы.ДекорацияОписаниеДДБезКоличественногоУчета.Видимость	= ЭтоДенежныйДокумент И Не ВестиКоличественныйУчетДенежныхДокументов;
	
	ИтогиКоличества = Новый Массив();
	ИтогиКоличества.Добавить("ИтогКоличество");
	ИтогиКоличества.Добавить("ИтогКоличествоНеСоответствует");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИтогиКоличества, "Видимость", РедактируетсяКоличество);
	
	Элементы.ТаблицаФрагментыСтрокиСуммаНеСоответствует.АвтоОтметкаНезаполненного = РедактируетсяСумма;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонокСумм()
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("ТаблицаФрагментыСтрокиСумма");
	ИменаКолонок.Добавить("ТаблицаФрагментыСтрокиСуммаНеСоответствует");
	
	Если РедактируетсяСумма Тогда
		ИнвентаризацияСервер.ОтключитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, ИменаКолонок);
	Иначе
		ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, ИменаКолонок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСлужебныеКолонкиТаблицы()
	
	КоличествоФрагментовСтроки = ТаблицаФрагментыСтроки.Количество();
	
	НПП = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментыСтроки Цикл
		НПП = НПП + 1;
		
		СтрокаТаблицы.НПП = НПП;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиТаблицы()
	
	КоличествоФрагментовСтроки = ТаблицаФрагментыСтроки.Количество();
	
	ИтогКоличество					= ТаблицаФрагментыСтроки.Итог("Количество");
	ИтогСумма						= ТаблицаФрагментыСтроки.Итог("Сумма");
	ИтогКоличествоНеСоответствует	= ТаблицаФрагментыСтроки.Итог("КоличествоНеСоответствует");
	ИтогСуммаНеСоответствует		= ТаблицаФрагментыСтроки.Итог("СуммаНеСоответствует");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяРаздела(Элемент, ТекДанные = Неопределено)
	
	Если ТекДанные = Неопределено Тогда
		ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
	КонецЕсли;
	
	ПриИзмененииПоказателяВИнвОписи0510465(ТекДанные, Элемент);
	
	ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(ТекДанные);
	
	ПересчитатьТаблицу(ТекДанные, Элемент);
	
	ИсключитьПересчетТаблицы = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу(ИзмененнаяСтрока = Неопределено, ИзмененныйЭлемент = Неопределено)
	
	ОбновитьИтогиТаблицы();
	
	Если ЭтоБСО Тогда
		ПересчитатьНомераБланковБСОВТаблицеПриИзмененииНомераВСтроке(ИзмененнаяСтрока);
		
	ИначеЕсли ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов Тогда
		ПересчитатьКоличествоДенежныхДокументовВТаблицеПриИзмененииКоличестваВСтроке(ИзмененнаяСтрока);
		
	ИначеЕсли ЭтоДенежныйДокумент И Не ВестиКоличественныйУчетДенежныхДокументов Тогда
		ПересчитатьСуммыДенежныхДокументовВТаблицеПриИзмененииСуммыВСтроке(ИзмененнаяСтрока);
	КонецЕсли;
	
	ЗаполнитьСлужебныеКолонкиТаблицы();
	
	ОбновитьИтогиТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаполненоКоличество = (СтрокаТаблицы.Количество > 0);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыРазбивкиСтроки()
	
	ПараметрыРазбивкиСтроки = Новый Структура("
		|МинимальныйНомерБСО,
		|МаксимальныйНомерБСО,
		|Количество,
		|Сумма,
		|РедактируетсяКоличество,
		|РедактируетсяСумма");
	
	ЗаполнитьЗначенияСвойств(ПараметрыРазбивкиСтроки, ЭтотОбъект);
	
	ПараметрыРазбивкиСтроки.МинимальныйНомерБСО		= НачальныйНомер;
	ПараметрыРазбивкиСтроки.МаксимальныйНомерБСО	= КонечныйНомер;
	
	Возврат ПараметрыРазбивкиСтроки;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьНомераБланковБСОВТаблицеПриИзмененииНомераВСтроке(ТекДанные = Неопределено)
	
	СортироватьФрагментыБСО();
	
	Если ТекДанные = Неопределено Тогда
		Если ТаблицаФрагментыСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекДанные = ТаблицаФрагментыСтроки[0];
	КонецЕсли;
	
	// Диапазоны слева
	НомерТекущейСтроки = ТаблицаФрагментыСтроки.Индекс(ТекДанные) + 1;
	СтрокаКорректировкиЛевойГраницы = ТекДанные;
	ТекущаяЛеваяГраница = СтрокаКорректировкиЛевойГраницы.НачальныйНомер;
	
	Для Счетчик = 1 По НомерТекущейСтроки - 1 Цикл
		НомерСтроки = НомерТекущейСтроки - Счетчик;
		
		СтрокаТаблицы = ТаблицаФрагментыСтроки[НомерСтроки - 1];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			// Пропускаем строки с пустыми номерами.
			Продолжить;
		КонецЕсли;
		
		НоваяПраваяГраница = ТекущаяЛеваяГраница - 1;
		
		Если НоваяПраваяГраница < СтрокаТаблицы.НачальныйНомер Тогда
			СтрокаТаблицы.НачальныйНомер = 0;
			СтрокаТаблицы.КонечныйНомер = 0;
			СтрокаТаблицы.Количество = 0;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
		Иначе
			СтрокаТаблицы.КонечныйНомер = НоваяПраваяГраница;
			СтрокаТаблицы.Количество = СтрокаТаблицы.КонечныйНомер - СтрокаТаблицы.НачальныйНомер + 1;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
			
			ТекущаяЛеваяГраница = СтрокаТаблицы.НачальныйНомер;
			СтрокаКорректировкиЛевойГраницы = СтрокаТаблицы;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекущаяЛеваяГраница) И ТекущаяЛеваяГраница > НачальныйНомер Тогда
		СтрокаКорректировкиЛевойГраницы = ?(СтрокаТаблицы <> Неопределено, СтрокаТаблицы, ТекДанные);
	КонецЕсли;
	
	// Диапазоны справа
	КоличествоСтрок = ТаблицаФрагментыСтроки.Количество();
	СтрокаКорректировкиПравойГраницы = ТекДанные;
	ТекущаяПраваяГраница = СтрокаКорректировкиПравойГраницы.КонечныйНомер;
	
	Для НомерСтроки = НомерТекущейСтроки + 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаФрагментыСтроки[НомерСтроки - 1];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НачальныйНомер) И Не ЗначениеЗаполнено(СтрокаТаблицы.КонечныйНомер) Тогда
			// Пропускаем строки с пустыми номерами.
			Продолжить;
		КонецЕсли;
		
		НоваяЛеваяГраница = ТекущаяПраваяГраница + 1;
		
		Если НоваяЛеваяГраница > СтрокаТаблицы.КонечныйНомер Тогда
			СтрокаТаблицы.НачальныйНомер = 0;
			СтрокаТаблицы.КонечныйНомер = 0;
			СтрокаТаблицы.Количество = 0;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
		Иначе
			СтрокаТаблицы.НачальныйНомер = НоваяЛеваяГраница;
			СтрокаТаблицы.Количество = СтрокаТаблицы.КонечныйНомер - СтрокаТаблицы.НачальныйНомер + 1;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
			
			ТекущаяПраваяГраница = СтрокаТаблицы.КонечныйНомер;
			СтрокаКорректировкиПравойГраницы = СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекущаяЛеваяГраница) И Не ЗначениеЗаполнено(ТекущаяПраваяГраница) Тогда
		СтрокаКорректировки = ТекДанные;
		
		СтрокаКорректировки.НачальныйНомер = НачальныйНомер;
		СтрокаКорректировки.КонечныйНомер = КонечныйНомер;
		СтрокаКорректировки.Количество = СтрокаКорректировки.КонечныйНомер - СтрокаКорректировки.НачальныйНомер + 1;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаКорректировки);
		
		ПриИзмененииПоказателяВИнвОписи0510465(СтрокаКорректировки, Элементы.ТаблицаФрагментыСтрокиКоличество);
	Иначе
		Если СтрокаКорректировкиЛевойГраницы <> Неопределено Тогда
			СтрокаКорректировки = СтрокаКорректировкиЛевойГраницы;
			
			СтрокаКорректировки.НачальныйНомер = НачальныйНомер;
			СтрокаКорректировки.Количество = СтрокаКорректировки.КонечныйНомер - СтрокаКорректировки.НачальныйНомер + 1;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаКорректировки);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаКорректировки, Элементы.ТаблицаФрагментыСтрокиКоличество);
		КонецЕсли;
		
		Если СтрокаКорректировкиПравойГраницы <> Неопределено Тогда
			СтрокаКорректировки = СтрокаКорректировкиПравойГраницы;
			
			СтрокаКорректировки.КонечныйНомер = КонечныйНомер;
			СтрокаКорректировки.Количество = СтрокаКорректировки.КонечныйНомер - СтрокаКорректировки.НачальныйНомер + 1;
			
			ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаКорректировки);
			
			ПриИзмененииПоказателяВИнвОписи0510465(СтрокаКорректировки, Элементы.ТаблицаФрагментыСтрокиКоличество);
		КонецЕсли;
	КонецЕсли;
	
	СортироватьФрагментыБСО();
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьФрагментыБСО()
	
	ТаблицаФрагментыСтроки.Сортировать("ЗаполненоКоличество УБЫВ,НачальныйНомер ВОЗР");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьКоличествоДенежныхДокументовВТаблицеПриИзмененииКоличестваВСтроке(ТекДанные = Неопределено)
	
	ДельтаКоличество = Количество - ИтогКоличество;
	
	Если ДельтаКоличество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные = Неопределено Тогда
		Если ТаблицаФрагментыСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекДанные = ТаблицаФрагментыСтроки[0];
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаФрагментыСтроки.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НомерСтроки = КоличествоСтрок - Счетчик + 1;
		
		СтрокаТаблицы = ТаблицаФрагментыСтроки[НомерСтроки - 1];
		
		Если СтрокаТаблицы = ТекДанные Или Не ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			// Пропускаем текущую строку и строки с пустым количеством.
			Продолжить;
		КонецЕсли;
		
		НовоеКоличество = СтрокаТаблицы.Количество + ДельтаКоличество;
		
		Если НовоеКоличество < 0 Тогда
			НовоеКоличество = 0;
		КонецЕсли;
		
		ДельтаКоличество = ДельтаКоличество - (НовоеКоличество - СтрокаТаблицы.Количество);
		
		СтрокаТаблицы.Количество = НовоеКоличество;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
		
		Если ДельтаКоличество = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДельтаКоличество <> 0 Тогда
		СтрокаТаблицы.Количество = СтрокаТаблицы.Количество + ДельтаКоличество;
		
		ОбновитьПризнакЗаполненоКоличествоВСтрокеТаблицы(СтрокаТаблицы);
		
		ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиКоличество);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыДенежныхДокументовВТаблицеПриИзмененииСуммыВСтроке(ТекДанные = Неопределено)
	
	ДельтаСумма = Сумма - ИтогСумма;
	
	Если ДельтаСумма = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные = Неопределено Тогда
		Если ТаблицаФрагментыСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекДанные = ТаблицаФрагментыСтроки[0];
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаФрагментыСтроки.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НомерСтроки = КоличествоСтрок - Счетчик + 1;
		
		СтрокаТаблицы = ТаблицаФрагментыСтроки[НомерСтроки - 1];
		
		Если СтрокаТаблицы = ТекДанные Или Не ЗначениеЗаполнено(СтрокаТаблицы.Сумма) Тогда
			// Пропускаем текущую строку и строки с пустой суммой.
			Продолжить;
		КонецЕсли;
		
		НоваяСумма = СтрокаТаблицы.Сумма + ДельтаСумма;
		
		Если НоваяСумма < 0 Тогда
			НоваяСумма = 0;
		КонецЕсли;
		
		ДельтаСумма = ДельтаСумма - (НоваяСумма - СтрокаТаблицы.Сумма);
		
		СтрокаТаблицы.Сумма = НоваяСумма;
		
		ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиСумма);
		
		Если ДельтаСумма = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДельтаСумма <> 0 Тогда
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + ДельтаСумма;
		
		ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицы, Элементы.ТаблицаФрагментыСтрокиСумма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяВИнвОписи0510465(СтрокаТаблицыФрагментов, Элемент)
	
	ИнвентаризацияКлиент.ПриИзмененииПоказателяВИнвОписи0510465(
		ВидДокумента,
		СтрокаТаблицыФрагментов,
		"ТаблицаФрагментыСтроки",
		Элемент.Имя,
		ПолучитьПараметрыРазбивкиСтроки());
	
КонецПроцедуры

// Настройка редактирования сумм

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьНастройкуРедактированияСумм(Форма, СостояниеНастройки = Неопределено)
	
	Если СостояниеНастройки = Неопределено Тогда
		СостояниеНастройки = ПолучитьСостояниеНастройкиРедактированияСумм(Форма);
	КонецЕсли;
	
	Форма.РедактируетсяСумма = СостояниеНастройки.Значение;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьНастройкиРедактированияСумм(СостояниеНастройки)
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Видимость = СостояниеНастройки.Доступность;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСостояниеНастройкиРедактированияСумм(Форма)
	
	// См. копию функции в формах разбивки строк.
	
	СостояниеНастройки = Новый Структура("Доступность,Значение");
	
	ЗначениеДоступности = Форма.ЭтоБСО Или (Форма.ЭтоДенежныйДокумент И Форма.ВестиКоличественныйУчетДенежныхДокументов);
	
	Если ЗначениеДоступности Тогда
		ЗначениеНастройки = Форма.РазрешеноРедактироватьСуммы;
	Иначе
		ЗначениеНастройки = (Форма.ЭтоДенежныйДокумент И Не Форма.ВестиКоличественныйУчетДенежныхДокументов);
	КонецЕсли;
	
	СостояниеНастройки.Доступность	= ЗначениеДоступности;
	СостояниеНастройки.Значение		= ЗначениеНастройки;
	
	Возврат СостояниеНастройки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИВключитьНастройкуРедактированияСумм()
	
	Если Не РедактируетсяКоличество Тогда
		Возврат;
	КонецЕсли;
	
	Если РедактируетсяСумма Или РазрешеноРедактироватьСуммы Тогда
		Возврат;
	КонецЕсли;
	
	Если ИтогКоличество = Количество И ИтогСумма <> Сумма Тогда
		СостояниеНастройки = ПолучитьСостояниеНастройкиРедактированияСумм(ЭтотОбъект);
		
		Если Не СостояниеНастройки.Доступность Тогда
			Возврат;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("Подключаемый_ВключитьНастройкуРедактированияСумм", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВключитьНастройкуРедактированияСумм()
	
	ОтключитьОбработчикОжидания("Подключаемый_ВключитьНастройкуРедактированияСумм");
	
	ИзменитьЗначениеНастройкиИНастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗначениеНастройкиИНастроитьФорму()
	
	РазрешеноРедактироватьСуммы = Не РазрешеноРедактироватьСуммы;
	
	Элементы.ФормаРазрешеноРедактироватьСуммы.Пометка = РазрешеноРедактироватьСуммы;
	
	ПрименитьНастройкуРедактированияСумм(ЭтотОбъект);
	
	НастроитьНедоступностьИзмененияКолонокСумм();
	
КонецПроцедуры

// Возвращаемое значение

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		
		Закрыть();
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИПеренестиВДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИПеренестиВДокумент()
	
	Если Не ПроверитьПередЗакрытием() Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Закрыть(ПолучитьВозвращаемоеЗначениеКлиент());
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначениеКлиент()
	
	Возврат ПолучитьВозвращаемоеЗначениеСервер();
	
КонецФункции

&НаСервере
Функция ПолучитьВозвращаемоеЗначениеСервер()
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Таблица = ТаблицаФрагментыСтроки.Выгрузить();
	
	ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	
	Для Каждого СтруктураСтроки Из ФрагментыСтроки Цикл
		СтруктураСтроки.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		СтруктураСтроки.Вставить("ПризнакФрагментаСтроки", Истина);
		
		СтруктураСтроки.Удалить("НомерСтроки");
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ФрагментыСтроки",		ФрагментыСтроки);
	Результат.Вставить("НомераСтрокФрагментов",	НомераСтрокФрагментов);
	
	Возврат Результат;
	
КонецФункции

// Проверка заполнения

&НаКлиенте
Функция ПроверитьПередЗакрытием()
	
	Отказ = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РедактируетсяКоличество И ИтогКоличество <> Количество Тогда
		ТекстШаблон = НСтр("ru='Итог по колонке ""Количество"" (%1) не совпадает с исходным разбиваемым количеством %2.
			|Исправьте количество в одной из строк табличной части.'");
		
		ФорматнаяСтрока = "ЧДЦ=0";
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Формат(ИтогКоличество, ФорматнаяСтрока), Формат(Количество, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаФрагментыСтроки");
		
		Отказ = Истина;
	КонецЕсли;
	
	Если ИтогСумма <> Сумма Тогда
		ТекстШаблон = НСтр("ru='Итог по колонке ""Сумма"" (%1) не совпадает с исходной разбиваемой суммой %2.
			|Исправьте сумму в одной из строк табличной части.'");
		
		ФорматнаяСтрока = "ЧДЦ=2";
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Формат(ИтогСумма, ФорматнаяСтрока), Формат(Сумма, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаФрагментыСтроки");
		
		Отказ = Истина;
	КонецЕсли;
	
	ПроверитьТаблицуНаСервере(Отказ);
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ПроверитьТаблицуНаСервере(Отказ)
	
	Документы.ИнвентаризационнаяОписьБСО.ПроверитьНеСоответствуетУсловиямАктиваРазбивкаСтрокиРаздела21(ВидДокумента, ТаблицаФрагментыСтроки, Отказ, ВестиКоличественныйУчетДенежныхДокументов);
	
	Если ЭтоБСО Тогда
		Если Не Отказ Тогда
			Документы.ИнвентаризационнаяОписьБСО.ДиагностироватьПорокиДиапазоновБСОРазбивкаСтрокиРаздела21(
				ТаблицаФрагментыСтроки,	НачальныйНомер,	КонечныйНомер, Отказ);
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		Если Не Отказ Тогда
			Документы.ИнвентаризационнаяОписьБСО.ПроверитьДублиСтрокДенежныхДокументовРазбивкаСтрокиРаздела21(ТаблицаФрагментыСтроки, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
