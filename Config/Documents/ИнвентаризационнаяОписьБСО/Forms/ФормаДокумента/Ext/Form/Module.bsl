&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСостояниеНастройкиРедактированияСумм(Форма)
	
	// См. копию функции в формах разбивки строк.
	
	СостояниеНастройки = Новый Структура("Доступность,Значение");
	
	ЗначениеДоступности = Форма.ЭтоБСО Или (Форма.ЭтоДенежныйДокумент И Форма.ВестиКоличественныйУчетДенежныхДокументов);
	
	Если ЗначениеДоступности Тогда
		ЗначениеНастройки = Форма.РазрешеноРедактироватьСуммы;
	Иначе
		ЗначениеНастройки = (Форма.ЭтоДенежныйДокумент И Не Форма.ВестиКоличественныйУчетДенежныхДокументов);
	КонецЕсли;
	
	СостояниеНастройки.Доступность	= ЗначениеДоступности;
	СостояниеНастройки.Значение		= ЗначениеНастройки;
	
	Возврат СостояниеНастройки;
	
КонецФункции

