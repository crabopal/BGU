#Область ОбработчикиСобытийЭлементовТаблицыФормы_Раздел21

&НаКлиенте
Процедура Раздел21Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ПризнакФрагментаСтроки Тогда
		СтандартнаяОбработка = Ложь;
		
		ОткрытьФормуРазбивкиСтрокиРаздела21();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ОтменитьДобавлениеСтрокиРаздела21(Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьУдалениеАвтоСтрокРаздела21(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗапретитьУдалениеФрагментаСтроки(Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ПредзаполнитьДобавленнуюСтрокуРаздела21(ТекДанные, Копирование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПослеУдаления(Элемент)
	
	ЗаполнитьКодыДобавленныхСтрокРаздела21();
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьКодыДобавленныхСтрокРаздела21()
	
	// Добавленные строки всегда располагаются в конце табличной части единым блоком.
	// В этом блоке исключено чередование строк, добавленных вручную, и перенесенных автоматически из раздела 1.
	
	КоличествоСтрокРаздела21 = Объект.Раздел21.Количество();
	
	НомерПервойДобавленнойСтрокиРаздела21 = 1;
	
	Для Счетчик = 1 По КоличествоСтрокРаздела21 Цикл
		ИндексСтроки = КоличествоСтрокРаздела21 - Счетчик;
		
		СтрокаТаблицы = Объект.Раздел21[ИндексСтроки];
		
		Если Не СтрокаТаблицы.ДобавленоВручную Тогда
			// Текущая строка является последней строкой, перенесенной из раздела 1.
			НомерПервойДобавленнойСтрокиРаздела21 = ИндексСтроки + 2;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	МаксимальныйКодСтрокиРаздела1 = Объект.Раздел1.Количество();
	
	ПредыдущаяСтрокаТаблицы = Неопределено;
	
	Для НомерСтроки = НомерПервойДобавленнойСтрокиРаздела21 По КоличествоСтрокРаздела21 Цикл
		ТекущаяСтрокаТаблицы = Объект.Раздел21[НомерСтроки - 1];
		
		Если ПредыдущаяСтрокаТаблицы = Неопределено Тогда
			КодСтроки = МаксимальныйКодСтрокиРаздела1 + 1;
		Иначе
			// Во фрагментах разбитой строки код строки оставляем неизменным.
			Если ТекущаяСтрокаТаблицы.ИдентификаторСтроки <> ПредыдущаяСтрокаТаблицы.ИдентификаторСтроки
				Или ТекущаяСтрокаТаблицы.ИдентификаторСтроки = "" Тогда
				КодСтроки = КодСтроки + 1;
			КонецЕсли;
		КонецЕсли;
		
		ТекущаяСтрокаТаблицы.КодСтроки = КодСтроки;
		
		ПредыдущаяСтрокаТаблицы = ТекущаяСтрокаТаблицы;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодДобавленнойСтрокиРаздела21(ТекДанные)
	
	// Режим ввода строк установлен в значение "В конце списка".
	// Выше расположенные строки имеют заполненный КодСтроки.
	
	КоличествоСтрокРаздела21 = Объект.Раздел21.Количество();
	
	Если КоличествоСтрокРаздела21 <= 1 Тогда
		КодСтроки = 1;
	Иначе
		ПредыдущаяСтрока = Объект.Раздел21[КоличествоСтрокРаздела21 - 2];
		
		КодСтроки = ПредыдущаяСтрока.КодСтроки + 1;
	КонецЕсли;
	
	ТекДанные.КодСтроки = КодСтроки;
	
КонецПроцедуры


