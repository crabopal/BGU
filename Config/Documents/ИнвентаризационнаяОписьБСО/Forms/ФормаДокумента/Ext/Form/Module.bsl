&НаСервере
Процедура ИнициализироватьФорму()
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект,, "СоставКомиссииРаздел2,СоставКомиссииРаздел4");
	// Конец ЗамещениеЧленаКомиссии
	
	ВестиКоличественныйУчетДенежныхДокументов = ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов");
	
	Документы.ИнвентаризационнаяОписьБСО.УстановитьЦветКолонокНомераБланковБСО(ЭтотОбъект);
	
	ИнвентаризацияСервер.ЗаполнитьСписокВыбораЭлементаСтатусОбъяснения(Элементы.Раздел4СтатусОбъяснения);
	
	УстановитьУсловноеОформление();
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	ЭтоБСО				= (Объект.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО);
	ЭтоДенежныйДокумент	= (Объект.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы);
	
	РедактируетсяКоличество = ЭтоБСО Или (ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов);
	
	СостояниеНастройки = Неопределено;
	
	ПрименитьНастройкуРедактированияСумм(ЭтотОбъект, СостояниеНастройки);
	
	НастроитьВидимостьНастройкиРедактированияСумм(СостояниеНастройки);
	
	НастроитьВидимостьИтоговКоличества();
	
	НастроитьНедоступностьИзмененияКолонок();
	
	ЗаполнитьСлужебныеКолонки();
	
	НастроитьКнопкуСообщитьОНаличииОшибокУчета();
	
	УстановитьПредставлениеСчета();
	
	УстановитьПредставлениеНомераКомиссии();
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

