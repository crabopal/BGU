	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел21.Загрузить(Результат.ТаблицаРаздела21);
	
	ЗаполнитьСлужебныеКолонки("Раздел21,Раздел22,Раздел3,Раздел4",, Истина);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьДобавлениеСтрокиРаздела21(Отказ)
	
	Если Объект.Раздел1.Количество() > 0 И Объект.Раздел21.Количество() = 0 Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='Добавление строки в раздел 2.1 отменено.
			|Необходимо предварительно заполнить раздел 2.1 по данным раздела 1.'"));
	КонецЕсли;
	
КонецПроцедуры

