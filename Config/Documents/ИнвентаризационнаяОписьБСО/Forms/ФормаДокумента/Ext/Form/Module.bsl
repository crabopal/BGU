Функция ЗаполнитьРаздел22Сервер()
	
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции = Новый Структура("ДокументСсылка", Объект.Ссылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 2.2 инвентаризационной описи 0510465'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьБСО.ПолучитьДанныеДляЗаполненияРаздела22",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел22Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел22Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел22.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 2.2 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 2.2 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

