	Если Объект.Раздел22.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличная часть документа будет очищена.
			|
			|Продолжить и заполнить раздел 2.2?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел22КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел22КорректностьЗаполненияПредыдущихРазделовКлиент();
	КонецЕсли;
	
КонецПроцедуры

