&НаКлиенте
Процедура ДокументВладелецПриИзменении(Элемент)
	
	ТекДанные = ПолучитьТекущиеДанныеТаблицыФормы(Элемент);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ДокументПодчиненный = Неопределено;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументВладелецНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = ПолучитьТекущиеДанныеТаблицыФормы(Элемент);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.БСО") Тогда
		ИмяОткрываемойФормы = "Справочник.БСО.ФормаВыбора";
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы") Тогда
		ИмяОткрываемойФормы = "Справочник.ВидыДенежныхДокументов.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(ИмяОткрываемойФормы,, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ДокументПодчиненныйПриИзменении(Элемент)
	
	ТекДанные = ПолучитьТекущиеДанныеТаблицыФормы(Элемент);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументПодчиненныйНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = ПолучитьТекущиеДанныеТаблицыФормы(Элемент);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.БСО") Тогда
		ИмяОткрываемойФормы = "Справочник.СерииБСО.ФормаВыбора";
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы") Тогда
		ИмяОткрываемойФормы = "Справочник.ДенежныеДокументы.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура());
	ПараметрыФормы.Отбор.Вставить("Владелец", ТекДанные.ДокументВладелец);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьПоляБСОиДДВСтроке(ТекДанные)
	
	ЗначенияПараметров = Новый Структура("
		|ВидДенежногоДокумента,
		|ДенежныйДокумент,
		|БСО,
		|Серия,
		|ДлинаНомера,
		|НомерДенежногоДокумента,
		|НомСтоимость,
		|ЕдИзм,
		|НачальныйНомер,
		|КонечныйНомер,
		|НачальныйНомерПредставление,
		|КонечныйНомерПредставление,
		|Цена,
		|Количество,
		|Сумма,
		|МножительКоличества,
		|ОшибкаУчета");
	
	ЗначенияПараметров.НачальныйНомер = 0;
	ЗначенияПараметров.КонечныйНомер = 0;
	ЗначенияПараметров.Цена = ?(РедактируетсяКоличество, 1, 0);
	ЗначенияПараметров.Количество = 0;
	ЗначенияПараметров.Сумма = 0;
	ЗначенияПараметров.МножительКоличества = 1;
	
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.БСО") Тогда
		БСО = ТекДанные.ДокументВладелец;
		
		ЗначенияПараметров.БСО = БСО;
		ЗначенияПараметров.Серия = ТекДанные.ДокументПодчиненный;
		
		Если ЗначениеЗаполнено(БСО) Тогда
			Сведения = ПолучитьСведенияБСО(БСО);
			
			ДлинаНомера = Сведения.ДлинаНомера;
			ЕдиницаИзмерения = Сведения.ЕдиницаИзмерения;
		Иначе
			ДлинаНомера = 0;
			ЕдиницаИзмерения = Неопределено;
		КонецЕсли;
		
		ЗначенияПараметров.ДлинаНомера = ДлинаНомера;
		ЗначенияПараметров.ЕдИзм = ЕдиницаИзмерения;
		
		ЗначенияПараметров.НачальныйНомерПредставление = "";
		ЗначенияПараметров.КонечныйНомерПредставление = "";
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы") Тогда
		ДенежныйДокумент = ТекДанные.ДокументПодчиненный;
		
		ЗначенияПараметров.ВидДенежногоДокумента = ТекДанные.ДокументВладелец;
		ЗначенияПараметров.ДенежныйДокумент = ДенежныйДокумент;
		
		Если ЗначениеЗаполнено(ДенежныйДокумент) Тогда
			Сведения = ПолучитьСведенияДенежногоДокумента(ДенежныйДокумент);
			
			НомерДенежногоДокумента = Сведения.Номер;
			НомСтоимость = Сведения.НомСтоимость;
			ЕдиницаИзмерения = Сведения.ЕдиницаИзмерения;
		Иначе
			НомерДенежногоДокумента = "";
			НомСтоимость = 0;
			ЕдиницаИзмерения = Неопределено;
		КонецЕсли;
		
		ЗначенияПараметров.НомерДенежногоДокумента = НомерДенежногоДокумента;
		ЗначенияПараметров.НомСтоимость = НомСтоимость;
		ЗначенияПараметров.ЕдИзм = ЕдиницаИзмерения;
		
		ЗначенияПараметров.НачальныйНомерПредставление = НомерДенежногоДокумента;
		ЗначенияПараметров.КонечныйНомерПредставление = НомерДенежногоДокумента;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияБСО(БСО)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БСО, "ДлинаНомера,ЕдиницаИзмерения");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДенежныйДокумент, "Номер,НомСтоимость,ЕдиницаИзмерения");
	
КонецФункции


&НаСервере
Процедура УстановитьВидДокумента()
	
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Счет, "Код");
		
		Если КодСчета = "201.35" Тогда
			ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы;
		Иначе
			ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО;
		КонецЕсли;
	КонецЕсли;
	
	Объект.ВидДокумента = ВидДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьУдалениеФрагментаСтроки(Отказ)
	
	Для Каждого ИдСтроки Из Элементы.Раздел21.ВыделенныеСтроки Цикл
		
		ТекДанные = Объект.Раздел21.НайтиПоИдентификатору(ИдСтроки);
		
		Если ТекДанные.ПризнакФрагментаСтроки Тогда
			Отказ = Истина;
			
			ТекстШаблон = НСтр("ru = 'Среди выбранных строк есть фрагмент разбитой строки (N %1).
				|Удаление и редактирование всех фрагментов разбитой строки выполняется сообща в форме разбивки строки.
				|
				|Воспользуйтесь формой разбивки строки для редактирования фрагментов разбитой строки.'");
			ПоказатьПредупреждение(, СтрШаблон(ТекстШаблон, ТекДанные.НомерСтроки), 20);
			
			Возврат;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьДействиеДляАвтоСтрокиРаздела21(СтандартнаяОбработка)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекДанные.ДобавленоВручную Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СообщитьОбОшибкеУчетаВСтрокеРаздела1(ТекДанные)
	
	Если ИнвентаризацияКлиент.ЕстьОшибкаМножителяКоличества(ТекДанные) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Выявлена ошибка учета БСО.
				|Остаток количества каждого номера из указанного диапазона равен %1 вместо 1.'"),
			ТекДанные.МножительКоличества);
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.Количество < 0 И ТекДанные.Сумма < 0 Тогда
		ТекстУточнения = НСтр("ru='Отрицательные количество и сумма.'");
	ИначеЕсли ТекДанные.Количество < 0 Тогда
		ТекстУточнения = НСтр("ru='Отрицательное количество.'");
	ИначеЕсли ТекДанные.Сумма < 0 Тогда
		ТекстУточнения = НСтр("ru='Отрицательная сумма.'");
	Иначе
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Выявлена ошибка учета денежных документов.
			|%1'"), ТекстУточнения);
	
	ПоказатьПредупреждение(, ТекстСообщения, 20);
	
КонецПроцедуры

#Область КнопкиПоказать

&НаСервере
Процедура ОбновитьКнопкиПоказать(ИменаРазделов, РезультатыДиагностики, ПринудительноСброситьОтбор)
	
	МассивИмен = СтрРазделить(ИменаРазделов, ", ");
	
	Для Каждого НаименованиеРаздела Из МассивИмен Цикл
		СброситьНеактуальныйОтборСтрокРаздела(НаименованиеРаздела, РезультатыДиагностики, ПринудительноСброситьОтбор);
		
		НастроитьВидимостьКнопокПоказатьРаздела(НаименованиеРаздела, РезультатыДиагностики);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СброситьНеактуальныйОтборСтрокРаздела(НаименованиеРаздела, РезультатыДиагностики, ПринудительноСброситьОтбор)
	
	НастройкиКнопок = ПолучитьНастройкиКнопокПоказать(НаименованиеРаздела);
	
	Если НастройкиКнопок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из НастройкиКнопок Цикл
		ИмяТекущейКнопки = Элемент.Ключ;
		НастройкаТекущейКолонки = Элемент.Значение;
		
		Если РезультатыДиагностики.Свойство(НаименованиеРаздела) Тогда
			РезультатДиагностики = РезультатыДиагностики[НаименованиеРаздела][НастройкаТекущейКолонки.КлючРезультатаДиагностики];
		Иначе
			// Отсутствие диагностики по разделу считаем полным отсутствием установленных признаков
			РезультатДиагностики = Ложь;
		КонецЕсли;
		
		Если ПринудительноСброситьОтбор Или (Не РезультатДиагностики И Элементы[ИмяТекущейКнопки].Пометка) Тогда
			Элементы[ИмяТекущейКнопки].Пометка = Ложь;
			
			Элементы[НаименованиеРаздела].ОтборСтрок = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКнопокПоказатьРаздела(НаименованиеРаздела, РезультатыДиагностики)
	
	НастройкиКнопок = ПолучитьНастройкиКнопокПоказать(НаименованиеРаздела);
	
	Если НастройкиКнопок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из НастройкиКнопок Цикл
		ИмяТекущейКнопки = Элемент.Ключ;
		НастройкаТекущейКолонки = Элемент.Значение;
		
		Если РезультатыДиагностики.Свойство(НаименованиеРаздела) Тогда
			РезультатДиагностики = РезультатыДиагностики[НаименованиеРаздела][НастройкаТекущейКолонки.КлючРезультатаДиагностики];
		Иначе
			// Отсутствие диагностики по разделу считаем полным отсутствием установленных признаков
			РезультатДиагностики = Ложь;
		КонецЕсли;
		
		Элементы[ИмяТекущейКнопки].Видимость = РезультатДиагностики;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокРаздел(НаименованиеКнопки, НаименованиеРаздела)
	
	Элементы[НаименованиеКнопки].Пометка = Не Элементы[НаименованиеКнопки].Пометка;
	
	НастройкиКнопок = ПолучитьНастройкиКнопокПоказать(НаименованиеРаздела);
	
	Если Элементы[НаименованиеКнопки].Пометка Тогда
		НовыйОтборСтрок = НастройкиКнопок[НаименованиеКнопки].ОтборСтрок;
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	Элементы[НаименованиеРаздела].ОтборСтрок = НовыйОтборСтрок;
	
	// Сбрасываем пометки у всех остальных кнопок
	
	Для Каждого Элемент Из НастройкиКнопок Цикл
		ИмяТекущейКнопки = Элемент.Ключ;
		
		Если ИмяТекущейКнопки = НаименованиеКнопки Тогда
			Продолжить;
		КонецЕсли;
		
		Элементы[ИмяТекущейКнопки].Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНастройкиКнопокПоказать(НаименованиеРаздела)
	
	Если НаименованиеРаздела = "Раздел1" Тогда
		Возврат ПолучитьНастройкиКнопокПоказатьРаздела1();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьОписаниеКнопкиПоказатьРаздела(НастройкиКнопок, ИмяКнопки, ОтборСтрок, КлючРезультатаДиагностики)
	
	Настройки = Новый Структура("ОтборСтрок,КлючРезультатаДиагностики");
	
	Настройки.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	Настройки.КлючРезультатаДиагностики = КлючРезультатаДиагностики;
	
	НастройкиКнопок.Вставить(ИмяКнопки, Настройки);
	
КонецПроцедуры

// Настройки разделов

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНастройкиКнопокПоказатьРаздела1()
	
	НастройкиКнопок = Новый Структура();
	
	ДобавитьОписаниеКнопкиПоказатьРаздела(НастройкиКнопок,
		"Раздел1ПоказатьТолькоОшибкиУчета",
		Новый Структура("ОшибкаУчета", Истина),
		"ЕстьОшибкиУчета");
		
	Возврат НастройкиКнопок;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПриИзмененииПоказателяРаздела(Элемент)
	
	Перем ИмяТЧ;
	
	ТекДанные = ПолучитьТекущиеДанныеТаблицыФормы(Элемент, ИмяТЧ);
	
	РассчитыватьЦену = (ИмяТЧ = "Раздел21" И (ЭтоБСО Или (ЭтоДенежныйДокумент И ВестиКоличественныйУчетДенежныхДокументов)));
	
	ИнвентаризацияКлиент.ПриИзмененииПоказателяВИнвОписи0510465(Объект.ВидДокумента, ТекДанные, ИмяТЧ, Элемент.Имя,, РассчитыватьЦену);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредзаполнитьДобавленнуюСтрокуРаздела21(ТекДанные, Копирование)
	
	ЗаполнитьКодДобавленнойСтрокиРаздела21(ТекДанные);
	
	Если Копирование Тогда
		ОчищающаяСтруктура = Новый Структура("
			|НачальныйНомер,
			|КонечныйНомер,
			|Количество,
			|Сумма,
			|НачальныйНомерНеСоответствует,
			|КонечныйНомерНеСоответствует,
			|КоличествоНеСоответствует,
			|СуммаНеСоответствует,
			|Статус,
			|КонечныйНомерПредставление,
			|НачальныйНомерПредставление,
			|НачальныйНомерНеСоответствуетПредставление,
			|КонечныйНомерНеСоответствуетПредставление,
			|ДобавленоВручную,
			|ИдентификаторСтроки,
			|ПризнакФрагментаСтроки");
		
		ОчищающаяСтруктура.ДобавленоВручную = Истина;
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		
		Возврат;
	КонецЕсли;
	
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("ДобавленоВручную",		Истина);
	СтруктураЗаполнения.Вставить("ИдентификаторСтроки",		"");
	СтруктураЗаполнения.Вставить("ПризнакФрагментаСтроки",	Ложь);
	СтруктураЗаполнения.Вставить("Цена",					?(РедактируетсяКоличество, 1, 0));
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураЗаполнения);
	
КонецПроцедуры


&НаСервере
Процедура УстановитьПредставлениеСчета()
	
	ПредставлениеСчета = "";
	
	Если ЗначениеЗаполнено(Объект.КФО) Или ЗначениеЗаполнено(Объект.Счет) Тогда
		ПредставлениеСчета = СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(Объект.КФО), Строка(Объект.КФО), "0"),
			?(ЗначениеЗаполнено(Объект.Счет), Строка(Объект.Счет), "000"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНомераКомиссии()
	
	ПредставлениеНомераКомиссии = "";
	
	Если ЗначениеЗаполнено(Объект.НомерКомиссии) Или ЗначениеЗаполнено(Объект.НомерРабочейКомиссии) Тогда
		ПредставлениеНомераКомиссии = ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(Объект.НомерКомиссии, Объект.НомерРабочейКомиссии);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Функция ОпределитьИмяТабличнойЧасти(Элемент)
	
	ПроверяемыйЭлемент = Элемент;
	
	Пока ТипЗнч(ПроверяемыйЭлемент) <> Тип("ФормаКлиентскогоПриложения") Цикл
		Если ТипЗнч(ПроверяемыйЭлемент) = Тип("ТаблицаФормы") Тогда
			Возврат ПроверяемыйЭлемент.Имя;
		КонецЕсли;
		
		ПроверяемыйЭлемент = ПроверяемыйЭлемент.Родитель;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекущиеДанныеТаблицыФормы(Элемент, ИмяТЧ = Неопределено)
	
	ИмяТЧ = ОпределитьИмяТабличнойЧасти(Элемент);
	
	Возврат Элементы[ИмяТЧ].ТекущиеДанные;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьУдалениеАвтоСтрокРаздела21(Отказ)
	
	Для Каждого ИдСтроки Из Элементы.Раздел21.ВыделенныеСтроки Цикл
		
		ТекДанные = Объект.Раздел21.НайтиПоИдентификатору(ИдСтроки);
		
		Если Не ТекДанные.ДобавленоВручную Тогда
			Отказ = Истина;
			
			ПоказатьПредупреждение(, НСтр("ru='Не предусмотрено удаление строк, полученных заполнением по данным из раздела 1'"));
			
			Возврат;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонки(Знач ИменаРазделов = Неопределено, РезультатыДиагностики = Неопределено, Знач ПринудительноСброситьОтбор = Ложь)
	
	Если ИменаРазделов = Неопределено Тогда
		ИменаРазделов = "Раздел1,Раздел21,Раздел22,Раздел3,Раздел4";
	КонецЕсли;
	
	Документы.ИнвентаризационнаяОписьБСО.ЗаполнитьСлужебныеКолонки(ЭтаФорма, ИменаРазделов, РезультатыДиагностики);
	
	Если РезультатыДиагностики.Свойство("Раздел1") Тогда
		НомераСтрокРаздела1СОшибкамиУчета = Новый ФиксированныйМассив(РезультатыДиагностики.Раздел1.НомераСтрокРаздела1СОшибкамиУчета);
	КонецЕсли;
	
	ОбновитьКнопкиПоказать(ИменаРазделов, РезультатыДиагностики, ПринудительноСброситьОтбор);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьКнопкуСообщитьОНаличииОшибокУчета()
	
	Элементы.Раздел1СообщитьОбОшибкахУчета.Видимость = Объект.ВыявленыОшибкиУчета;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьИтоговКоличества()
	
	ПоляКоличества = Новый Массив();
	ПоляКоличества.Добавить("Раздел1ИтогКоличество");
	
	ПоляКоличества.Добавить("Раздел21ИтогКоличествоНеСоответствует");
	ПоляКоличества.Добавить("Раздел21ИтогКоличество");
	ПоляКоличества.Добавить("Раздел22ИтогКоличествоНедостача");
	ПоляКоличества.Добавить("Раздел22ИтогКоличествоИзлишки");
	ПоляКоличества.Добавить("Раздел22ИтогКоличествоНеСоответствует");
	ПоляКоличества.Добавить("ДекорацияРаздел22ИтогиКоличество");
	
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоНедостачаНеПодтверждено");
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоИзлишкиНеПодтверждено");
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоНедостачаПодтверждено");
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоИзлишкиПодтверждено");
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоНедостача");
	ПоляКоличества.Добавить("Раздел3ИтогКоличествоИзлишки");
	ПоляКоличества.Добавить("ДекорацияРаздел3ИтогиКоличество");
	
	ПоляКоличества.Добавить("Раздел4ИтогКоличествоНедостачаНеПодтверждено");
	ПоляКоличества.Добавить("Раздел4ИтогКоличествоИзлишкиНеПодтверждено");
	ПоляКоличества.Добавить("Раздел4ИтогКоличествоНеСоответствует");
	ПоляКоличества.Добавить("ДекорацияРаздел4ИтогиКоличество");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ПоляКоличества, "Видимость", РедактируетсяКоличество);
	
КонецПроцедуры

// Редактирование показателей раздела 3

&НаКлиенте
Процедура ПриИзмененииПоказателяРаздела3(Элемент)
	
	ТекДанные = Элементы.Раздел3.ТекущиеДанные;
	
	ОписаниеИзмененногоПоказателя = ПолучитьОписаниеИзмененногоПоказателяРаздела3(Элемент);
	
	Если ЭтоБСО Тогда
		ОбновитьПоказателиВСтрокеРаздела3_БСО(ТекДанные, ОписаниеИзмененногоПоказателя);
		
		Если ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО() Тогда
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, "НачальныйНомерИзлишкиПодтверждено",		"КонечныйНомерИзлишкиПодтверждено");
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, "НачальныйНомерНедостачаПодтверждено",	"КонечныйНомерНедостачаПодтверждено");
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, "НачальныйНомерИзлишкиНеПодтверждено",	"КонечныйНомерИзлишкиНеПодтверждено");
			ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, "НачальныйНомерНедостачаНеПодтверждено",	"КонечныйНомерНедостачаНеПодтверждено");
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		ОбновитьПоказателиВСтрокеРаздела3_ДенежныйДокумент(ТекДанные, ОписаниеИзмененногоПоказателя);
	КонецЕсли;
	
	ОчиститьПервичныйУчетныйДокумент(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеИзмененногоПоказателяРаздела3(Элемент)
	
	Перем ОбозначениеИзмененногоПоля;
	
	ИмяЭлемента = Элемент.Имя;
	
	ИмяПоля = СтрЗаменить(ИмяЭлемента, "Раздел3", "");
	
	// Излишки, подтверждено
	Если ИмяПоля = "НачальныйНомерИзлишкиПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "НомерНач";
		
	ИначеЕсли ИмяПоля = "КонечныйНомерИзлишкиПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "НомерКон";
		
	ИначеЕсли ИмяПоля = "КоличествоИзлишкиПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "Количество";
		
	ИначеЕсли ИмяПоля = "СуммаИзлишкиПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "Сумма";
		
		
	// Недостача, подтверждено
	ИначеЕсли ИмяПоля = "НачальныйНомерНедостачаПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "НомерНач";
		
	ИначеЕсли ИмяПоля = "КонечныйНомерНедостачаПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "НомерКон";
		
	ИначеЕсли ИмяПоля = "КоличествоНедостачаПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "Количество";
		
	ИначеЕсли ИмяПоля = "СуммаНедостачаПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "Подтверждено";
		ОбозначениеИзмененногоПоля = "Сумма";


	// Излишки, не подтверждено
	ИначеЕсли ИмяПоля = "НачальныйНомерИзлишкиНеПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "НомерНач";
		
	ИначеЕсли ИмяПоля = "КонечныйНомерИзлишкиНеПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "НомерКон";
		
	ИначеЕсли ИмяПоля = "КоличествоИзлишкиНеПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "Количество";
		
	ИначеЕсли ИмяПоля = "СуммаИзлишкиНеПодтверждено" Тогда
		ВидРасхождения = "Излишки";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "Сумма";
		
		
	// Недостача, не подтверждено
	ИначеЕсли ИмяПоля = "НачальныйНомерНедостачаНеПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "НомерНач";
		
	ИначеЕсли ИмяПоля = "КонечныйНомерНедостачаНеПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "НомерКон";
		
	ИначеЕсли ИмяПоля = "КоличествоНедостачаНеПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "Количество";
		
	ИначеЕсли ИмяПоля = "СуммаНедостачаНеПодтверждено" Тогда
		ВидРасхождения = "Недостача";
		ВидПодтверждения = "НеПодтверждено";
		ОбозначениеИзмененногоПоля = "Сумма";
	КонецЕсли;
	
	Если ВидПодтверждения = "Подтверждено" Тогда
		ВидПодтвержденияКонтр = "НеПодтверждено";
	Иначе
		ВидПодтвержденияКонтр = "Подтверждено";
	КонецЕсли;
	
	ОписаниеИзмененногоПоказателя = Новый Структура();
	ОписаниеИзмененногоПоказателя.Вставить("ОбозначениеИзмененногоПоля",	ОбозначениеИзмененногоПоля);
	ОписаниеИзмененногоПоказателя.Вставить("ВидРасхождения",				ВидРасхождения);
	ОписаниеИзмененногоПоказателя.Вставить("ВидПодтверждения",				ВидПодтверждения);
	ОписаниеИзмененногоПоказателя.Вставить("ВидПодтвержденияКонтр",			ВидПодтвержденияКонтр);
	
	Возврат ОписаниеИзмененногоПоказателя;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПоказателиВСтрокеРаздела3_БСО(ТекДанные, ОписаниеИзмененногоПоказателя)
	
	ОбозначениеИзмененногоПоля	= ОписаниеИзмененногоПоказателя.ОбозначениеИзмененногоПоля;
	ВидРасхождения				= ОписаниеИзмененногоПоказателя.ВидРасхождения;
	ВидПодтверждения			= ОписаниеИзмененногоПоказателя.ВидПодтверждения;
	ВидПодтвержденияКонтр		= ОписаниеИзмененногоПоказателя.ВидПодтвержденияКонтр;
	
	МинимальныйНомер	= ТекДанные["НачальныйНомер" + ВидРасхождения];
	МаксимальныйНомер	= ТекДанные["КонечныйНомер" + ВидРасхождения];
	ИтоговоеКоличество	= ТекДанные["Количество" + ВидРасхождения];
	ИтоговаяСумма		= ТекДанные["Сумма" + ВидРасхождения];
	
	ИмяПоляНачальныйНомер	= "НачальныйНомер" + ВидРасхождения + ВидПодтверждения;
	ИмяПоляКонечныйНомер	= "КонечныйНомер" + ВидРасхождения + ВидПодтверждения;
	ИмяПоляКоличество		= "Количество" + ВидРасхождения + ВидПодтверждения;
	ИмяПоляСумма			= "Сумма" + ВидРасхождения + ВидПодтверждения;
	
	ИмяПоляНачальныйНомерКонтр	= "НачальныйНомер" + ВидРасхождения + ВидПодтвержденияКонтр;
	ИмяПоляКонечныйНомерКонтр	= "КонечныйНомер" + ВидРасхождения + ВидПодтвержденияКонтр;
	ИмяПоляКоличествоКонтр		= "Количество" + ВидРасхождения + ВидПодтвержденияКонтр;
	ИмяПоляСуммаКонтр			= "Сумма" + ВидРасхождения + ВидПодтвержденияКонтр;
	
	НомерНач	= ТекДанные[ИмяПоляНачальныйНомер];
	НомерКон	= ТекДанные[ИмяПоляКонечныйНомер];
	Количество	= ТекДанные[ИмяПоляКоличество];
	Сумма		= ТекДанные[ИмяПоляСумма];
	
	НомерНачКонтр	= ТекДанные[ИмяПоляНачальныйНомерКонтр];
	НомерКонКонтр	= ТекДанные[ИмяПоляКонечныйНомерКонтр];
	КоличествоКонтр	= ТекДанные[ИмяПоляКоличествоКонтр];
	СуммаКонтр		= ТекДанные[ИмяПоляСуммаКонтр];
	
	Цена = ТекДанные.Цена;
	
	Если ОбозначениеИзмененногоПоля = "НомерНач" Тогда
		Если НомерНач = 0 Тогда
			// Очищаем текущий блок.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
			
			// Контр-блок заполняем полностью.
			НомерНачКонтр	= МинимальныйНомер;
			НомерКонКонтр	= МаксимальныйНомер;
			КоличествоКонтр	= ИтоговоеКоличество;
		Иначе
			Если НомерНач < МинимальныйНомер Тогда
				НомерНач = МинимальныйНомер;
			ИначеЕсли НомерНач > МаксимальныйНомер Тогда
				НомерНач = МаксимальныйНомер;
			КонецЕсли;
			
			// В текущем блоке устанавливаем номера с введенного до максимального.
			НомерКон = МаксимальныйНомер;
			Количество = НомерКон - НомерНач + 1;
			Сумма = Количество * Цена;
			
			Если Количество = ИтоговоеКоличество Тогда
				// Очищаем контр блок.
				НомерНачКонтр = 0;
				НомерКонКонтр = 0;
				КоличествоКонтр = 0;
			Иначе
				// В контр-блоке устанавливаем номера с минимального до введенного.
				НомерНачКонтр = МинимальныйНомер;
				НомерКонКонтр = НомерНач - 1;
				КоличествоКонтр = НомерКонКонтр - НомерНачКонтр + 1;
			КонецЕсли;
		КонецЕсли;
			
	ИначеЕсли ОбозначениеИзмененногоПоля = "НомерКон" Тогда
		Если НомерКон = 0 Тогда
			// Очищаем текущий блок.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
			
			// Контр-блок заполняем полностью.
			НомерНачКонтр	= МинимальныйНомер;
			НомерКонКонтр	= МаксимальныйНомер;
			КоличествоКонтр	= ИтоговоеКоличество;
		Иначе
			Если НомерКон < МинимальныйНомер Тогда
				НомерКон = МинимальныйНомер;
			ИначеЕсли НомерКон > МаксимальныйНомер Тогда
				НомерКон = МаксимальныйНомер;
			КонецЕсли;
			
			// В текущем блоке устанавливаем номера с минимального до введенного.
			НомерНач = МинимальныйНомер;
			Количество = НомерКон - НомерНач + 1;
			Сумма = Количество * Цена;
			
			Если Количество = ИтоговоеКоличество Тогда
				// Очищаем контр блок.
				НомерНачКонтр = 0;
				НомерКонКонтр = 0;
				КоличествоКонтр = 0;
			Иначе
				// В контр-блоке устанавливаем номера с введенного до максимального.
				НомерНачКонтр = НомерКон + 1;
				НомерКонКонтр = МаксимальныйНомер;
				КоличествоКонтр = НомерКонКонтр - НомерНачКонтр + 1;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "Количество" Тогда
		Если Количество > ИтоговоеКоличество Тогда
			Количество = ИтоговоеКоличество;
		КонецЕсли;
		
		Если Количество = 0 Тогда
			// Очищаем текущий блок.
			НомерНач = 0;
			НомерКон = 0;
			Количество = 0;
			Сумма = 0;
			
			// Контр-блок заполняем полностью.
			НомерНачКонтр	= МинимальныйНомер;
			НомерКонКонтр	= МаксимальныйНомер;
			КоличествоКонтр	= ИтоговоеКоличество;
			
		ИначеЕсли Количество = ИтоговоеКоличество Тогда
			// Текущий блок заполняем полностью.
			НомерНач = МинимальныйНомер;
			НомерКон = МаксимальныйНомер;
			Количество = ИтоговоеКоличество;
			Сумма = ИтоговаяСумма;
			
			// Очищаем контр-блок.
			НомерНачКонтр	= 0;
			НомерКонКонтр	= 0;
			КоличествоКонтр	= 0;
			
		Иначе
			Если НомерНач = МинимальныйНомер Или НомерНач = 0 Тогда
				// Зафиксирована левая граница текущего блока. Сдвигаем правую границу текущего блока.
				НомерНач = МинимальныйНомер;
				НомерКон = НомерНач + Количество - 1;
				Сумма = Количество * Цена;
				
				// Контр-блок примыкает справа.
				НомерНачКонтр = НомерКон + 1;
				НомерКонКонтр = МаксимальныйНомер;
				КоличествоКонтр = НомерКонКонтр - НомерНачКонтр + 1;
			Иначе
				// Зафиксирована правая граница текущего блока. Сдвигаем левую границу текущего блока.
				НомерНач = НомерКон - Количество + 1;
				Сумма = Количество * Цена;
				
				// Контр-блок примыкает слева.
				НомерНачКонтр = МинимальныйНомер;;
				НомерКонКонтр = НомерНач - 1;
				КоличествоКонтр = НомерКонКонтр - НомерНачКонтр + 1;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "Сумма" Тогда
		Если Сумма > ИтоговаяСумма Тогда
			Сумма = ИтоговаяСумма;
		КонецЕсли;
	КонецЕсли;
	
	СуммаКонтр = ИтоговаяСумма - Сумма;
	
	ТекДанные[ИмяПоляНачальныйНомер]	= НомерНач;
	ТекДанные[ИмяПоляКонечныйНомер]		= НомерКон;
	ТекДанные[ИмяПоляКоличество]		= Количество;
	ТекДанные[ИмяПоляСумма]				= Сумма;
	
	ТекДанные[ИмяПоляНачальныйНомерКонтр]	= НомерНачКонтр;
	ТекДанные[ИмяПоляКонечныйНомерКонтр]	= НомерКонКонтр;
	ТекДанные[ИмяПоляКоличествоКонтр]		= КоличествоКонтр;
	ТекДанные[ИмяПоляСуммаКонтр]			= СуммаКонтр;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоказателиВСтрокеРаздела3_ДенежныйДокумент(ТекДанные, ОписаниеИзмененногоПоказателя)
	
	ВидРасхождения				= ОписаниеИзмененногоПоказателя.ВидРасхождения;
	ВидПодтверждения			= ОписаниеИзмененногоПоказателя.ВидПодтверждения;
	ВидПодтвержденияКонтр		= ОписаниеИзмененногоПоказателя.ВидПодтвержденияКонтр;
	ОбозначениеИзмененногоПоля	= ОписаниеИзмененногоПоказателя.ОбозначениеИзмененногоПоля;
	
	ИтоговоеКоличество	= ТекДанные["Количество" + ВидРасхождения];
	ИтоговаяСумма		= ТекДанные["Сумма" + ВидРасхождения];
	
	ИмяПоляКоличество		= "Количество" + ВидРасхождения + ВидПодтверждения;
	ИмяПоляСумма			= "Сумма" + ВидРасхождения + ВидПодтверждения;
	
	ИмяПоляКоличествоКонтр	= "Количество" + ВидРасхождения + ВидПодтвержденияКонтр;
	ИмяПоляСуммаКонтр		= "Сумма" + ВидРасхождения + ВидПодтвержденияКонтр;
	
	Количество	= ТекДанные[ИмяПоляКоличество];
	Сумма		= ТекДанные[ИмяПоляСумма];
	
	КоличествоКонтр	= ТекДанные[ИмяПоляКоличествоКонтр];
	СуммаКонтр		= ТекДанные[ИмяПоляСуммаКонтр];
	
	Цена = ТекДанные.Цена;
	
	Если Количество > ИтоговоеКоличество Тогда
		Количество = ИтоговоеКоличество;
	КонецЕсли;
	
	КоличествоКонтр = ИтоговоеКоличество - Количество;
	
	Если ОбозначениеИзмененногоПоля = "Сумма" Тогда
		Если Сумма > ИтоговаяСумма Тогда
			Сумма = ИтоговаяСумма;
		КонецЕсли;
	Иначе
		Если РедактируетсяКоличество И Количество = ИтоговоеКоличество Тогда
			// Повторяем общую сумму отклонения.
			// Рассчитывать сумму по цене и количеству не нужно,
			// т.к. возможно получение значения, отличного от общей суммы отклонения.
			Сумма = ИтоговаяСумма;
		Иначе
			Сумма = Количество * Цена;
		КонецЕсли;
	КонецЕсли;
	
	СуммаКонтр = ИтоговаяСумма - Сумма;
	
	ТекДанные[ИмяПоляКоличество]	= Количество;
	ТекДанные[ИмяПоляСумма]			= Сумма;
	
	ТекДанные[ИмяПоляКоличествоКонтр]	= КоличествоКонтр;
	ТекДанные[ИмяПоляСуммаКонтр]		= СуммаКонтр;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПервичныйУчетныйДокумент(ТекДанные)
	
	Если ЗначениеЗаполнено(ТекДанные.СуммаНедостачаПодтверждено)
		Или ЗначениеЗаполнено(ТекДанные.КоличествоНедостачаПодтверждено)
		Или ЗначениеЗаполнено(ТекДанные.КоличествоИзлишкиПодтверждено)
		Или ЗначениеЗаполнено(ТекДанные.СуммаИзлишкиПодтверждено) Тогда
		
		Возврат;
	КонецЕсли;
	
	ТекДанные.НаименованиеДокумента = "";
	ТекДанные.НомерДокумента = "";
	ТекДанные.ДатаДокумента = Неопределено;
	
КонецПроцедуры

