#Область РазбивкаСтрокиРаздела21

&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтрокиРаздела21()
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если Не ПроверитьПередОткрытиемФормыРазбивкиСтрокиРаздела21(ТекДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыРазбивки = ПолучитьПараметрыФормыРазбивкиСтрокиРаздела21(ТекДанные.ПолучитьИдентификатор());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИсходнаяСтрока", ПараметрыФормыРазбивки.ИсходнаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтрокиРаздела21", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьБСО.Форма.РазбивкаСтрокиРаздела21", ПараметрыФормыРазбивки,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередОткрытиемФормыРазбивкиСтрокиРаздела21(ТекДанные)
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ДокументВладелец) Тогда
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке не заполнен Документ'"));
		Возврат Ложь;
	КонецЕсли;
	
	ПоказателиОтсутствуют = Не ЗначениеЗаполнено(ТекДанные.Сумма);
	
	Если РедактируетсяКоличество Тогда
		ПоказателиОтсутствуют = ПоказателиОтсутствуют И Не ЗначениеЗаполнено(ТекДанные.Количество);
	КонецЕсли;
	
	Если ПоказателиОтсутствуют Тогда
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке отсутствует фактическое наличие'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если РедактируетсяКоличество И ТекДанные.Количество < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru='В разбиваемой строке количество бланков должно быть
			|не менее 2'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела21(ИдСтроки)
	
	ТекДанные = Объект.Раздел21.НайтиПоИдентификатору(ИдСтроки);
	
	Возврат Документы.ИнвентаризационнаяОписьБСО.ПолучитьПараметрыФормыРазбивкиСтрокиРаздела21(ЭтотОбъект, ТекДанные);
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтрокиРаздела21(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// НомераСтрокФрагментов упорядочены по возрастанию.
	НомераСтрокФрагментов	= РезультатВыбора.НомераСтрокФрагментов;
	ФрагментыСтроки			= РезультатВыбора.ФрагментыСтроки;
	
	КоличествоПрежнихФрагментов = НомераСтрокФрагментов.Количество();
	КоличествоНовыхФрагментов = ФрагментыСтроки.Количество();
	
	// Удаляем прежние фрагменты, начиная с последнего.
	Для Счетчик = 1 По КоличествоПрежнихФрагментов Цикл
		Индекс = КоличествоПрежнихФрагментов - Счетчик;
		
		Объект.Раздел21.Удалить(НомераСтрокФрагментов[Индекс] - 1);
	КонецЦикла;
	
	// Вставляем новые фрагменты на место первой строки прежних фрагментов, начиная с последнего.
	ИндексВставки = НомераСтрокФрагментов[0] - 1;
	
	ОбщиеПоля = "ДокументВладелец,ДокументПодчиненный,НомерДенежногоДокумента,НомСтоимость,ДлинаНомера,"
		+ "ВидДенежногоДокумента,ДенежныйДокумент,БСО,Серия,Цена,"
		+ "ДобавленоВручную,КодСтроки";
		
	Для Счетчик = 1 По КоличествоНовыхФрагментов Цикл
		Индекс = КоличествоНовыхФрагментов - Счетчик;
		
		СтруктураСтроки = ФрагментыСтроки[Индекс];
		
		НоваяСтрока = Объект.Раздел21.Вставить(ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры.ИсходнаяСтрока, ОбщиеПоля);
	КонецЦикла;
	
	Если КоличествоНовыхФрагментов = 1 Тогда
		НоваяСтрока.ИдентификаторСтроки = Неопределено;
		НоваяСтрока.ПризнакФрагментаСтроки = Ложь;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Если НоваяСтрока.ДобавленоВручную Тогда
		ЗаполнитьКодыДобавленныхСтрокРаздела21();
	КонецЕсли;
	
	Элементы.Раздел21.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтрокиРаздела3

&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтрокиРаздела3()
	
	ТекДанные = Элементы.Раздел3.ТекущиеДанные;
	
	Если Не ПроверитьПередОткрытиемФормыРазбивкиСтрокиРаздела3(ТекДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыРазбивки = ПолучитьПараметрыФормыРазбивкиСтрокиРаздела3(ТекДанные.ПолучитьИдентификатор());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИсходнаяСтрока", ПараметрыФормыРазбивки.ИсходнаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтрокиРаздела3", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьБСО.Форма.РазбивкаСтрокиРаздела3", ПараметрыФормыРазбивки,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередОткрытиемФормыРазбивкиСтрокиРаздела3(ТекДанные)
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОтклоненияОтсутствуют = Не ЗначениеЗаполнено(ТекДанные.СуммаИзлишки) И Не ЗначениеЗаполнено(ТекДанные.СуммаНедостача);
	
	Если РедактируетсяКоличество Тогда
		ОтклоненияОтсутствуют = ОтклоненияОтсутствуют И Не ЗначениеЗаполнено(ТекДанные.КоличествоИзлишки) И Не ЗначениеЗаполнено(ТекДанные.КоличествоНедостача);
	КонецЕсли;
	
	Если ОтклоненияОтсутствуют Тогда
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке отсутствуют излишки и недостача'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если РедактируетсяКоличество И ТекДанные.КоличествоИзлишки < 2 И ТекДанные.КоличествоНедостача < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru='В разбиваемой строке количество расхождений бланков должно быть не менее 2'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела3(ИдСтроки)
	
	ТекДанные = Объект.Раздел3.НайтиПоИдентификатору(ИдСтроки);
	
	Возврат Документы.ИнвентаризационнаяОписьБСО.ПолучитьПараметрыФормыРазбивкиСтрокиРаздела3(ЭтотОбъект, ТекДанные);
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтрокиРаздела3(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// НомераСтрокФрагментов упорядочены по возрастанию.
	НомераСтрокФрагментов	= РезультатВыбора.НомераСтрокФрагментов;
	ФрагментыСтроки			= РезультатВыбора.ФрагментыСтроки;
	
	КоличествоПрежнихФрагментов = НомераСтрокФрагментов.Количество();
	КоличествоНовыхФрагментов = ФрагментыСтроки.Количество();
	
	// Запоминаем объяснения причин расхождений, указанные в прежних строках.
	// Для того, чтобы повторить их в новых строках.
	ОбъясненияПричинРасхождений = Новый Массив();
	
	// Удаляем прежние фрагменты, начиная с последнего.
	Для Счетчик = 1 По КоличествоПрежнихФрагментов Цикл
		Индекс = КоличествоПрежнихФрагментов - Счетчик;
		
		ИндексСтроки = НомераСтрокФрагментов[Индекс] - 1;
		
		ОбъясненияПричинРасхождений.Вставить(0, Объект.Раздел3[ИндексСтроки].ОбъяснениеПричинРасхождений);
		
		Объект.Раздел3.Удалить(ИндексСтроки);
	КонецЦикла;
	
	// Вставляем новые фрагменты на место первой строки прежних фрагментов, по порядку следования.
	ИндексВставки = НомераСтрокФрагментов[0] - 1;
	
	ОбщиеПоля = "ДокументВладелец,ДокументПодчиненный,НомерДенежногоДокумента,НомСтоимость,ДлинаНомера,"
		+ "ВидДенежногоДокумента,ДенежныйДокумент,БСО,Серия,Цена,"
		+ "КодСтроки";
	
	Для Счетчик = 1 По КоличествоНовыхФрагментов Цикл
		СтруктураСтроки = ФрагментыСтроки[Счетчик - 1];
		
		НоваяСтрока = Объект.Раздел3.Вставить(ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры.ИсходнаяСтрока, ОбщиеПоля);
		
		Если Счетчик <= КоличествоПрежнихФрагментов Тогда
			НоваяСтрока.ОбъяснениеПричинРасхождений = ОбъясненияПричинРасхождений[Счетчик - 1];
		КонецЕсли;
		
		ИндексВставки = ИндексВставки + 1;
	КонецЦикла;
	
	Если КоличествоНовыхФрагментов = 1 Тогда
		НоваяСтрока.ИдентификаторСтроки = Неопределено;
		НоваяСтрока.ПризнакФрагментаСтроки = Ложь;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Элементы.Раздел3.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

#КонецОбласти

#Область РешениеОПроведенииИнвентаризации

&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтаФорма, РезультатВыбора);
	
	УстановитьПредставлениеСчета();
	УстановитьПредставлениеНомераКомиссии();
	
	УстановитьВидДокумента();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

#Область ПанельРасписки

&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	
	НастроитьДоступностьРазделов();
	
	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРазделов()
	
	ДоступностьРазделов = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;
	
	Элементы.ГруппаРаздел1Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел21Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел22Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел3Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел4Заголовок.Доступность = ДоступностьРазделов;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРазделов

#Область Раздел1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент()
	
	Если Объект.Раздел1.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением по данным учета все табличные части документа будут очищены.
			|
			|Продолжить и заполнить по данным учета?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьПередЗаполнениемРаздела1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьПередЗаполнениемРаздела1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПередЗаполнениемРаздела1Клиент()
	
	Отказ = Ложь;
	
	ПроверитьПередЗаполнениемРаздела1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьБСО.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	Объект.Раздел1.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	Объект.ВыявленыОшибкиУчета = Ложь;
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер()
	
	ПараметрыФункции = Новый Структура("
		|ДатаИнвентаризации,
		|Организация,
		|Подразделение,
		|МОЛ,
		|КФО,
		|ИФО,
		|Счет,
		|МестоИнвентаризации,
		|ВидДокумента");
		
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510465'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьБСО.ПолучитьДанныеУчета",
		ПараметрыФункции);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Перем РезультатыДиагностики;
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ТекстСообщения = Неопределено;
		
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата, РезультатыДиагностики);
		
		Если Объект.Раздел1.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
		
		Если РезультатыДиагностики.Раздел1.ЕстьОшибкиУчета Тогда
			СообщитьОНаличииОшибокУчетаКлиент();
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении по данным учета возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата, РезультатыДиагностики)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел1.Загрузить(Результат.ТаблицаДляРаздела1);
	
	Объект.ОстаткиБСО.Загрузить(Результат.ОстаткиБСО);
	
	Объект.ОстаткиДенежныхДокументов.Загрузить(Результат.ОстаткиДенежныхДокументов);
	
	ЗаполнитьСлужебныеКолонки(, РезультатыДиагностики, Истина);
	
	Объект.ВыявленыОшибкиУчета = РезультатыДиагностики.Раздел1.ЕстьОшибкиУчета;
	
	НастроитьКнопкуСообщитьОНаличииОшибокУчета();
	
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура СообщитьОНаличииОшибокУчетаКлиент()
	
	КоличествоСтрок = НомераСтрокРаздела1СОшибкамиУчета.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	ИначеЕсли КоличествоСтрок = 1 Тогда
		ШаблонСтроки = НСтр("ru='строку %1'");
	Иначе
		ШаблонСтроки = НСтр("ru='строки %1'");
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Обнаружены ошибки учета бланков (см. %1)
		|Например:
		| - отрицательный остаток
		| - остаток больше единицы (несколько поступлений по одному номеру бланка)'"),
		ШаблонСтроки);
	
	ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстСообщения, НомераСтрокРаздела1СОшибкамиУчета, 200, "%1");
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел1", НомераСтрокРаздела1СОшибкамиУчета[0], "НомерСтроки"),
		"Объект");
	
КонецПроцедуры

#КонецОбласти

#Область Раздел21

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21Клиент(Команда, СКоличеством)
	
	ДополнительныеПараметры = Новый Структура("СКоличеством", СКоличеством);
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтаФорма,
		НСтр("ru = 'Заполнить по данным раздела 1'"),
		"ПроверитьИЗаполнитьРаздел21ПослеПроверкиЗаписиДокумента",
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел21.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличная часть документа будет очищена.
			|
			|Продолжить и заполнить раздел 2.1?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел21КлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРаздел21Клиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21КлиентЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРаздел21Клиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел21Клиент(ДополнительныеПараметры)
	
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	РезультатЗадания = ЗаполнитьРаздел21Сервер(ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел21Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел21Сервер(ДополнительныеПараметры)
	
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции.Вставить("ДокументСсылка",	Объект.Ссылка);
	ПараметрыФункции.Вставить("СКоличеством",	ДополнительныеПараметры.СКоличеством);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 2.1 инвентаризационной описи 0510465'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьБСО.ПолучитьДанныеДляЗаполненияРаздела21",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел21Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел21Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел21.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 2.1 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 2.1 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
