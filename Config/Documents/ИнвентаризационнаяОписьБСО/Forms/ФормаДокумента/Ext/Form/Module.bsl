#Область ОбработчикиСобытийЭлементовТаблицыФормы_Раздел1

&НаКлиенте
Процедура Раздел1Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Раздел1.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ОшибкаУчета И Поле.Имя = "Раздел1НомерСтроки" Тогда
		СообщитьОбОшибкеУчетаВСтрокеРаздела1(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Раздел1.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		Если Копирование Тогда
			ОчищающаяСтруктура = Новый Структура("
				|НачальныйНомер,
				|КонечныйНомер,
				|Количество,
				|Сумма,
				|КонечныйНомерПредставление,
				|НачальныйНомерПредставление,
				|МножительКоличества,
				|ОшибкаУчета");
			
			ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ДокументВладелецПриИзменении(Элемент)
	
	ДокументВладелецПриИзменении(Элемент);
	
КонецПроцедуры

