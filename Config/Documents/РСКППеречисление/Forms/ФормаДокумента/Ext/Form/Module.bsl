&НаКлиенте
Процедура ЗаполнитьСуммуПлатежа(Команда) 
		
	ИтогТаблицы = 0;
	ИтогТаблицыВал = 0;
	Если Объект.НесколькоКодовБК = 1 Тогда
		ИтогТаблицыВал = Объект.РасшифровкаПлатежа.Итог("СуммаВал");
		ИтогТаблицы = Объект.РасшифровкаПлатежа.Итог("Сумма");
	ИначеЕсли Объект.НесколькоПолучателей = 1 Тогда 
		ИтогТаблицыВал = Объект.Контрагенты.Итог("СуммаВал");
		ИтогТаблицы = Объект.Контрагенты.Итог("Сумма");
	Иначе
		ИтогТаблицыВал = Объект.ДетализацияПлатежа.Итог("СуммаВал");
		ИтогТаблицы = Объект.ДетализацияПлатежа.Итог("Сумма");
	КонецЕсли;
	Объект.СуммаДокумента 			= ИтогТаблицы;
	Объект.СуммаДокументаВВалюте 	= ИтогТаблицыВал;  
	СуммаДокументаВВалютеПриИзмененииНаКлиенте();
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткамЗадолженности(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Контрагенты[0].Контрагент) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Контрагенты[0].Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Договор)
		И Не Объект.КорСчет = ЭтотОбъект.КэшПараметров.Локальные.Счет20800 Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Договор'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Договор");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ДетализацияПлатежа.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьПоОстаткамЗадолженностиЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоОстаткамЗадолженностиНаСервере(); 
		СуммаДокументаВВалютеПриИзмененииНаКлиенте();  
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
		УстановитьВидимостьДоступностьТаблицФормы(); 
		СформироватьТекстНазначенияПлатежа();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПоОстаткамЗадолженностиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоОстаткамЗадолженностиНаСервере();
	КонецЕсли;
	
	СуммаДокументаВВалютеПриИзмененииНаКлиенте();  
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	УстановитьВидимостьДоступностьТаблицФормы(); 
	СформироватьТекстНазначенияПлатежа();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольДокументаПоОбязательствам(Команда)
