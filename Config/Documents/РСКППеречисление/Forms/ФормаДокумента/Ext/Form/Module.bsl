&НаКлиенте
Процедура СпроситьОВозможностиЗаписи(Отказ, ПараметрыЗаписи) 
	
	Если УстановленныеРеквизитыИсполнения.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен") Тогда 
		ОчиститьСообщения();
		Если НЕ ПроверитьКонтроли() Тогда   
			Если ВопросОЗаписиЗадан Тогда 
				Возврат;
			КонецЕсли;   
			Отказ = Истина;
			ВопросОЗаписиЗадан = Истина;
			Обработчик = Новый ОписаниеОповещения("ПослеВопросаОВозможностиЗаписи", ЭтотОбъект, ПараметрыЗаписи);
			ТекстВопроса = НСтр("ru='Обнаружены ошибки заполнения реквизитов. Возможен отказ ЕБП в приемке документа!
			|Все равно записать?'");
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	  

&НаКлиенте
Процедура ПослеВопросаОВозможностиЗаписи(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ВопросОЗаписиЗадан = Ложь; 
	Иначе
		Записать(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеВопросаОВозможностиИзмененияСтатуса(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтотОбъект); 
	
КонецПроцедуры   

&НаКлиенте
Процедура ИзменитьСтатусДокумента()  
	ОчиститьСообщения();
	Если УстановленныеРеквизитыИсполнения.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ВРаботе") Тогда
		Если ПроверитьКонтроли() Тогда
			ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтотОбъект); 
		Иначе  
			Обработчик = Новый ОписаниеОповещения("ПослеВопросаОВозможностиИзмененияСтатуса", ЭтотОбъект);
			ТекстВопроса = НСтр("ru='Обнаружены ошибки заполнения реквизитов. Возможен отказ ЕБП в приемке документа!
			|Все равно изменить статус?'");
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
		КонецЕсли;
	Иначе
		ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтотОбъект); 
	КонецЕсли;	
КонецПроцедуры	 

&НаСервере
Функция ПроверитьКонтроли() 
	
	ЕстьОшибки = Ложь;  
	
	ТекстСообщения = "";    
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ" Тогда
		ПроверитьКонтролиАУБУ(ЕстьОшибки, ТекстСообщения);
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура ПроверитьКонтролиАУБУ(ЕстьОшибки, ТекстСообщения)	
	
	// Только закупочные КВР: 240, 241, 243, 244, 245, 246, 247, 323, 406, 407
	//
	МассивЗакупочныхКВР = СтрРазделить("240,241,243,244,245,246,247,248,323,406,407,408", ",");
	МассивКБК = Объект.РасшифровкаПлатежа.Выгрузить().ВыгрузитьКолонку("КБКНазначениеПлатежа"); 
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 15, 3) КАК КВР
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	|ГДЕ
	|	КлассификационныеПризнакиСчетов.Ссылка В(&Ссылка)");
	Запрос.УстановитьПараметр("Ссылка", МассивКБК);
	УстановленныеКБК = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КВР");
	
	ЕстьЗакупочные = Ложь;
	ЕстьПрочие = Ложь;
	
	Для Каждого УстановленныйКБК Из УстановленныеКБК Цикл
		Если МассивЗакупочныхКВР.Найти(УстановленныйКБК) = Неопределено Тогда
			ЕстьПрочие = Истина;
		Иначе
			ЕстьЗакупочные = Истина;
		КонецЕсли;
	КонецЦикла; 
	
	Если ЕстьПрочие И ЕстьЗакупочные Тогда
		ЕстьОшибки = Истина; 
		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") +
		НСтр("ru='РСКП составляется или только по основанию закупки (КВР: 240, 241, 243, 244, 245, 246, 247, 248, 323, 406, 407, 408), или только по прочим основаниям.'");
	КонецЕсли;	 
   	// Конец "Только закупочные"
	
	// Заполнение поля "Тип закупки"
	//
	Если ЕстьЗакупочные И НЕ ЕстьПрочие Тогда
		// Заполнение обязательно
		Если НЕ ЗначениеЗаполнено(Объект.ТипЗакупки) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") +
			НСтр("ru='Для РСКП, составленного по основанию закупки (КВР: 240, 241, 243, 244, 245, 246, 247, 248, 323, 406, 407, 408) обязательно заполнение поля ""Тип закупки"".'");
		КонецЕсли;
	КонецЕсли;    
	Если НЕ ЕстьЗакупочные И ЕстьПрочие Тогда
		// Не заполняется
		Если ЗначениеЗаполнено(Объект.ТипЗакупки) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") +
			НСтр("ru='Поле ""Тип закупки"" заполняется только для РСКП, составленного по основанию закупки (КВР: 240, 241, 243, 244, 245, 246, 247, 248, 323, 406, 407, 408).'");
		КонецЕсли;
	КонецЕсли;
	// Конец Заполнение поля "Тип закупки"	
	
	// Заполнение поля "Ставка НДС" и "Сумма НДС"
	//
	Если ЕстьЗакупочные И НЕ ЕстьПрочие Тогда
		// Заполнение обязательно
		Если НЕ ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") +
			НСтр("ru='Для РСКП, составленного по основанию закупки (КВР: 240, 241, 243, 244, 245, 246, 247, 248, 323, 406, 407, 408) обязательно заполнение поля ""Ставка НДС"".'");
		КонецЕсли;
	КонецЕсли;    
	Если НЕ ЕстьЗакупочные И ЕстьПрочие Тогда
		// Не заполняется
		Если ЗначениеЗаполнено(Объект.ТипЗакупки) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") +
			НСтр("ru='Поле ""Ставка НДС"" заполняется только для РСКП, составленной по основанию закупки (КВР: 240, 241, 243, 244, 245, 246, 247, 248, 323, 406, 407, 408).'");
		КонецЕсли;
	КонецЕсли; 
	РазницаНДС = Объект.СуммаНДС - Объект.РасшифровкаПлатежа.Итог("СуммаНДС");
	Если НЕ РазницаНДС = 0 Тогда
		ЕстьОшибки = Истина; 
		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сумма НДС по докупенту %1 не равна сумме НДС расшифровки платежа %2. Разница: %3.'"),
		Формат(Объект.СуммаНДС, "ЧДЦ=2; ЧН=0"), Формат(Объект.РасшифровкаПлатежа.Итог("СуммаНДС"), "ЧДЦ=2; ЧН=0"), Формат(РазницаНДС, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;
	// Конец Заполнение поля "Ставка НДС" и "Сумма НДС"	
	
	Для Каждого СтрРасшифровка Из Объект.РасшифровкаПлатежа Цикл    
		
		// Заполнение поля "Код поступления
		//
		Если НЕ ЗначениеЗаполнено(СтрРасшифровка.КодПоступленияЕБП) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Раздел л/с"" обязательно для заполнения.'"),
			СтрРасшифровка.НомерСтроки);
		КонецЕсли;  
		
		// Использование кода ОБ. Для формата версии 2.1 код БУ и АУ не применяется
		//
		Если СтрРасшифровка.КодПоступленияЕБП = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ОБ") Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Код поступления ""ОБ"" не применяется бюджетными и автономными учреждениями.'"),
			СтрРасшифровка.НомерСтроки);
		КонецЕсли; 
		
		// Использование кода ЦС.
		//   
		Если СтрРасшифровка.КодПоступленияЕБП = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ЦС") 
			И ЗначениеЗаполнено(Объект.ТипЗакупки)
			И НЕ (Объект.ТипЗакупки = ПредопределенноеЗначение("Перечисление.ТипЗакупкиЕБП.ФЗ44до600") 
			ИЛИ Объект.ТипЗакупки = ПредопределенноеЗначение("Перечисление.ТипЗакупкиЕБП.ФЗ44НеПодлежитВключениюРК")) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Код поступления ""ЦС"" не применяется с типом закупки ""%2"".'"),
			СтрРасшифровка.НомерСтроки, Объект.ТипЗакупки);
		КонецЕсли; 
                                                        
		// Заполнение поля "Код цели" 
		//
		Если СтрРасшифровка.КодПоступленияЕБП = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ЦС") И
			НЕ ЗначениеЗаполнено(СтрРасшифровка.КодЦели) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Код цели"" обязательно для заполнения по коду поступления ""ЦС"".'"),
			СтрРасшифровка.НомерСтроки);
		КонецЕсли;
		Если НЕ СтрРасшифровка.КодПоступленияЕБП = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ЦС") И
			ЗначениеЗаполнено(СтрРасшифровка.КодЦели) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Код цели"" не заполняется для кода поступления ""%2"".'"),
			СтрРасшифровка.НомерСтроки, СтрРасшифровка.КодПоступленияЕБП);
		КонецЕсли;  
		// Конец Заполнение поля "Код цели"  
		
		// Заполнение поля "Направление платежа" 
		//
		Если НЕ ЗначениеЗаполнено(СтрРасшифровка.НаправлениеПлатежа) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Направление платежа"" обязательно для заполнения.'"),
			СтрРасшифровка.НомерСтроки);
		КонецЕсли;
        // Конец Заполнение поля "Направление платежа"  
		
		// Заполнение КБК назначения платежа
		КодБК = БиблиотекаФункцийОбмена.КодБКПоНастройке(СтрРасшифровка.КБКНазначениеПлатежа, Объект.ЛицевойСчет);
		Если НЕ СтрПодобнаПоРегулярномуВыражению(КодБК, "[0]{17}[0-9]{3}") Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Представление КПС для выгрузки ""%2"" не соответствует маске ""00000000000000000ХХХ"". Проверьте настройки лицевого счета.'"),
			СтрРасшифровка.НомерСтроки, КодБК);
        КонецЕсли;
		
	КонецЦикла; 
	
	СчетаЦелевых = СтрРазделить("03224,03234,03244", ",");
	Для Каждого СтрКонтрагент Из Объект.Контрагенты Цикл  
		// Заполнение реквизита "Код поступления получателя"
		Если ЗначениеЗаполнено(СтрКонтрагент.КонтрагентЛицевойСчет) И
			(Лев(СтрКонтрагент.КонтрагентЛицевойСчет, 2) = "80" ИЛИ
			Лев(СтрКонтрагент.КонтрагентЛицевойСчет, 2) = "90") Тогда
			Если НЕ ЗначениеЗаполнено(СтрКонтрагент.КодПоступленияЕБП) Тогда 
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Код поступления"" должно быть заполнено для лицевого счета ""%2"".'"),
				СтрКонтрагент.НомерСтроки, СтрКонтрагент.КонтрагентЛицевойСчет); 
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(СтрКонтрагент.КодПоступленияЕБП) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Код поступления"" не заполняется для лицевого счета ""%2"".'"),
				СтрКонтрагент.НомерСтроки, СтрКонтрагент.КонтрагентЛицевойСчет); 		
			КонецЕсли; 
		КонецЕсли; 
		// Заполнение лицевого счета Контрагента
		Если НЕ Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 1) = "0" 
			ИЛИ Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5) = "03100" Тогда
			Если ЗначениеЗаполнено(СтрКонтрагент.КонтрагентЛицевойСчет) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Номер лицевого счета"" не заполняется для счета ""%2"".'"),
				СтрКонтрагент.НомерСтроки, СтрКонтрагент.КонтрагентБанковскийСчет); 
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(СтрКонтрагент.КонтрагентЛицевойСчет) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Номер лицевого счета"" должно быть заполнено для счета ""%2"".'"),
				СтрКонтрагент.НомерСтроки, СтрКонтрагент.КонтрагентБанковскийСчет); 		
			КонецЕсли; 
		КонецЕсли; 
		//Код целевой субсидии получателя   
		Если СчетаЦелевых.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено Тогда 
			Если ЗначениеЗаполнено(СтрКонтрагент.КодЦелиПолучателя) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1. Поле ""Код цели"" не заполняется для счета получателя ""%2"".'"),
				СтрКонтрагент.НомерСтроки, СтрКонтрагент.КонтрагентБанковскийСчет); 
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;    
	
	// Информация, необходимая для осуществления платежей в бюджетную систему РФ
	// Заполняется при наличии, если в элементе "Номер счета получателя средств" указан счет контрагента, 
	// соответствующий казначейскому счету № 03100, 03212, 03222; 03232, 03242,03252; 03262, 03272, 03214; 03224, 03234; 03254
	// или соответствует балансовому счету "40503", "40603" и "40703" с признаком "4" в 14-м разряде.
	// Заполняется только, если указан один получатель платежа
	//
	ЕстьЗаполненныеНалоговыеРеквизиты = 
	ЗначениеЗаполнено(Объект.КодБКНалога) ИЛИ
	ЗначениеЗаполнено(Объект.КодОКАТО) ИЛИ
	ЗначениеЗаполнено(Объект.ПоказательДаты) ИЛИ  
	ЗначениеЗаполнено(Объект.ПоказательНомера) ИЛИ 
	ЗначениеЗаполнено(Объект.ПоказательОснования) ИЛИ 
	ЗначениеЗаполнено(Объект.ПоказательПериода) ИЛИ  
	ЗначениеЗаполнено(Объект.ПоказательТипа) ИЛИ 
	ЗначениеЗаполнено(Объект.УИН) ИЛИ 
	ЗначениеЗаполнено(Объект.СтатусСоставителя);
	Если Объект.Контрагенты.Количество() > 1 Тогда
		Если ЕстьЗаполненныеНалоговыеРеквизиты Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			НСтр("ru='Реквизиты платежа в бюджет заполняются только при указаннии одного получателя платежа. При указании нескольких получателей не заполняются.'"); 		
		КонецЕсли;  
	ИначеЕсли Объект.Контрагенты.Количество() = 1 Тогда 
		СтрКонтрагент = Объект.Контрагенты[0];
		СчетаБюджета = СтрРазделить("03100,03212,03222,03232,03242,03252,03262,03272,03214,03224,03234,03254", ","); 
		СчетаНалогов = СтрРазделить("40503,40603,40703", ",");  
		СчетаКБК0 = СтрРазделить("03215,03225,03235,03216,03226,03236,03212,03222,03232", ","); 
		СчетаАУБУ = СтрРазделить("03214,03224,03234,03254", ",");  
		СчетаУИН = СтрРазделить("03100,03212,03222,03232,03242,03252,03262,03272,03214,03224,03234,03254,03244", ",");
		Если НЕ СчетаБюджета.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
			ИЛИ (НЕ СчетаНалогов.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
					И Сред(СтрКонтрагент.КонтрагентБанковскийСчет, 14, 1) = 4) Тогда 
			// Должны Быть заполнены реквизиты платежа в бюджет
			Если НЕ ЕстьЗаполненныеНалоговыеРеквизиты Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизиты платежа в бюджет должны быть заполнены для выбранного получателя платежа.'"); 		
			КонецЕсли; 
			// КБК
			Если НЕ ЗначениеЗаполнено(Объект.КодБКНалога) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Код БК (104)"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;
			Если НЕ СтрДлина(Объект.КодБКНалога) = 20 И НЕ Объект.КодБКНалога = "0" Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Код БК (104)"" должен состоять из 20 знаков или принимать значение ""0"".'"); 		
			КонецЕсли;   
			Если НЕ СчетаКБК0.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
				И НЕ Объект.КодБКНалога = "0" Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Код БК (104)"" должен принимать значение ""0"" для выбранного получателя платежа.'"); 		
			КонецЕсли; 
			Если Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5) = "03100" 
				И НЕ СтрДлина(Объект.КодБКНалога) = 20 Тогда 
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Код БК (104)"" должен состоять из 20 знаков для выбранного получателя платежа.'"); 		
			КонецЕсли; 
			// Если КС получателя начинается с маски счета 03214/03224/03234 и 03254, 
			// то КБК заполняется по маске 00000000000000000 ХХХ.
			Если НЕ СчетаАУБУ.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
				И НЕ СтрПодобнаПоРегулярномуВыражению(Объект.КодБКНалога, "[0]{17}[0-9]{3}") Тогда  
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Код БК (104)"" не соответствует маске ""00000000000000000ХХХ"".'"); 
			КонецЕсли;	
			// Статус плательщика
			Если НЕ ЗначениеЗаполнено(Объект.СтатусСоставителя) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Статус налогоплательщика (101)"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;   
			
			Если Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5) = "03100" Тогда 
				// Код по ОКТМО получателя
				Если НЕ ЗначениеЗаполнено(Объект.КодОКАТО) Тогда
					ЕстьОшибки = Истина; 
					ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
					НСтр("ru='Реквизит ""Код ОКТМО (ОКАТО) (105)"" должен быть заполнен для выбранного получателя платежа.'"); 		
				КонецЕсли;  
				Если ЗначениеЗаполнено(Объект.КодОКАТО) Тогда
					Если НЕ СтрДлина(Объект.КодОКАТО) = 1 И НЕ СтрДлина(Объект.КодОКАТО) = 8 Тогда
						ЕстьОшибки = Истина; 
						ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
						НСтр("ru='Реквизит ""Код ОКТМО (ОКАТО) (105)"" может принимать значение ""0"" или состоять из 8 знаков.'"); 		
					КонецЕсли;   
					Если Лев(Объект.КодБКНалога, 3) = "153" И НЕ СтрДлина(Объект.КодОКАТО) = 8 Тогда
						ЕстьОшибки = Истина; 
						ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
						НСтр("ru='Реквизит ""Код ОКТМО (ОКАТО) (105)"" должен состоять из 8 знаков.'"); 
					КонецЕсли; 
					Если СтрДлина(Объект.КодОКАТО) = 8 Тогда   
						Если Лев(Объект.КодОКАТО, 3) = "000" Тогда
							ЕстьОшибки = Истина; 
							ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
							НСтр("ru='Первые 3 знака реквизита ""Код ОКТМО (ОКАТО) (105)"" не могут принимать значение ""000"".'"); 
						КонецЕсли; 
						Если Объект.КодОКАТО = "00000000" Тогда
							ЕстьОшибки = Истина; 
							ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
							НСтр("ru='Реквизит ""Код ОКТМО (ОКАТО) (105)"" не может принимать значение ""00000000"".'"); 
						КонецЕсли; 
					КонецЕсли;
				КонецЕсли;  
				// Основание платежа
				Если Лев(Объект.КодБКНалога, 3) = "182" И НЕ ЗначениеЗаполнено(Объект.ПоказательОснования) Тогда
					ЕстьОшибки = Истина; 
					ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
					НСтр("ru='Реквизит ""Основание платежа (106)"" должен быть заполнен.'"); 
				КонецЕсли;
			КонецЕсли;   
			
			// Налоговый период     
			Если ЗначениеЗаполнено(Объект.СтатусСоставителя) И НЕ ЗначениеЗаполнено(Объект.ПоказательПериода) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Налоговый период (107)"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;  
			
			// Номер документа-основания     
			Если ЗначениеЗаполнено(Объект.СтатусСоставителя) И НЕ ЗначениеЗаполнено(Объект.ПоказательНомера) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Номер документа-основания (108)"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;  
			
			// Дата документа-основания     
			Если ЗначениеЗаполнено(Объект.СтатусСоставителя) И НЕ ЗначениеЗаполнено(Объект.ПоказательДаты) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""Дата документа-основания (109)"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;  
			
		КонецЕсли;   
		
		// УИН
		Если НЕ СчетаУИН.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
			ИЛИ (НЕ СчетаНалогов.Найти(Лев(СтрКонтрагент.КонтрагентБанковскийСчет, 5)) = Неопределено
			И Сред(СтрКонтрагент.КонтрагентБанковскийСчет, 14, 1) = 4) Тогда 
			Если НЕ ЗначениеЗаполнено(Объект.УИН) Тогда
				ЕстьОшибки = Истина; 
				ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
				НСтр("ru='Реквизит ""УИН"" должен быть заполнен для выбранного получателя платежа.'"); 		
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;	
	
	// Заполнение реквилитов документов-оснований
	//
	Для Каждого СтрДокумент Из Объект.РеквизитыДокументаОснования Цикл  
		Если НЕ ЗначениеЗаполнено(СтрДокумент.ДокументОснованиеВид) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Таблица Документы-основания. Строка %1. Поле ""Вид документа"" обязательно для заполнения.'"),
			СтрДокумент.НомерСтроки);
		КонецЕсли;
	    Если НЕ ЗначениеЗаполнено(СтрДокумент.ДокументОснованиеНомер) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Таблица Документы-основания. Строка %1. Поле ""Номер"" обязательно для заполнения.'"),
			СтрДокумент.НомерСтроки);
		КонецЕсли;
        Если НЕ ЗначениеЗаполнено(СтрДокумент.ДокументОснованиеДата) Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Таблица Документы-основания. Строка %1. Поле ""Дата"" обязательно для заполнения.'"),
			СтрДокумент.НомерСтроки);
		КонецЕсли;
	КонецЦикла; 
	
	// Удаленны файлы
	//
	Для Каждого СтрФайл Из Объект.ФайлыПриложения Цикл  
		Если СтрФайл.ПрисоединенныйФайл.ПометкаУдаления Тогда
			ЕстьОшибки = Истина; 
			ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Таблица Приложенные файлы. Строка %1. В приложенные файлы включен помеченный на удаление элемент.'"),
			СтрФайл.НомерСтроки);
		КонецЕсли;
	КонецЦикла;  
	
	// Допустимые символы     
	
	// Назначение платежа
	НедопустимыеСимволы = ПлатежноРасчетныеДокументыКлиентСервер.ПроверитьДопустимыеСимволыВСтроке(Объект.НазначениеПлатежа);
	Если НедопустимыеСимволы.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + НСтр("ru='Недопустимые символы в поле ""Назначение платежа"":'")
		+ Символы.ПС + СтрСоединить(НедопустимыеСимволы, Символы.ПС);
	КонецЕсли;
    // Дополнительная информация
	НедопустимыеСимволы = ПлатежноРасчетныеДокументыКлиентСервер.ПроверитьДопустимыеСимволыВСтроке(Объект.ДополнительнаяИнформация);
	Если НедопустимыеСимволы.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + НСтр("ru='Недопустимые символы в поле ""Дополнительная информация"":'")
		+ Символы.ПС + СтрСоединить(НедопустимыеСимволы, Символы.ПС);
	КонецЕсли;
    // Расшифровка платежа
	Для Каждого СтрРасшифровка Из Объект.РасшифровкаПлатежа Цикл 
		НедопустимыеСимволы = ПлатежноРасчетныеДокументыКлиентСервер.ПроверитьДопустимыеСимволыВСтроке(СтрРасшифровка.СтрокаНазначениеПлатежа);
		Если НедопустимыеСимволы.Количество() > 0 Тогда 
			ЕстьОшибки = Истина;
       		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1 таблицы ""Расшифровка платежа"" содержит недопустимые символы:'"),
			СтрРасшифровка.НомерСтроки) + Символы.ПС + СтрСоединить(НедопустимыеСимволы, Символы.ПС); 
		КонецЕсли;
	КонецЦикла;	
	// Контрагенты
	Для Каждого СтрРасшифровка Из Объект.Контрагенты Цикл 
		НедопустимыеСимволы = ПлатежноРасчетныеДокументыКлиентСервер.ПроверитьДопустимыеСимволыВСтроке(СтрРасшифровка.СтрокаНазначениеПлатежа);
		Если НедопустимыеСимволы.Количество() > 0 Тогда 
			ЕстьОшибки = Истина;
       		ТекстСообщения = ТекстСообщения + ?(СтрДлина(ТекстСообщения) > 0, Символы.ПС, "") + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Строка %1 таблицы ""Контрагенты"" содержит недопустимые символы:'"),
			СтрРасшифровка.НомерСтроки) + Символы.ПС + СтрСоединить(НедопустимыеСимволы, Символы.ПС); 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаНаСервере(ОбновитьФорму = Ложь)
	
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета);
	
	УстановленнаяМаксимальнаяДлинаНазначенияПлатежа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет, "МаксДлинаНазначенияПлатежа"); 
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", Неопределено);
	Если Лев(Объект.ЛицевойСчет.Код, 2) = "80" Или Лев(Объект.ЛицевойСчет.Код, 2) = "90" Тогда
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", "АУБУ");
	ИначеЕсли Лев(Объект.ЛицевойСчет.Код, 2) = "05"	Тогда
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", "ВРПБС");
	КонецЕсли; 
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС" Тогда 
		
		Если Объект.ПризнакАвансовогоПлатежа = Истина Тогда
			Объект.ПризнакАвансовогоПлатежа = Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ДополнительнаяИнформация) Тогда
			Объект.ДополнительнаяИнформация = "";
		КонецЕсли;	
		
		Если НЕ Объект.НесколькоКодовБК = 0 Тогда  
			Объект.НесколькоКодовБК = 0;
			ОчиститьРасшифровкуПлатежаНаСервере(Ложь);
			РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
		КонецЕсли; 
		
		Если НЕ Объект.НесколькоПолучателей = 0 Тогда  
			Объект.НесколькоПолучателей = 0;
			ОчиститьСписокКонтрагентовНаСервере();
			РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
		КонецЕсли; 
     	
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
		|ГДЕ
		|	РазделыЛицевыхСчетов.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", Объект.ЛицевойСчет);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Объект.РасшифровкаПлатежа[0].РазделЛС = Выборка.Ссылка;
		КонецЕсли; 
		
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка,
		|	РазделыЛицевыхСчетов.КодПоступленияЕБП КАК КодПоступленияЕБП
		|ИЗ
		|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
		|ГДЕ
		|	РазделыЛицевыхСчетов.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", Объект.ЛицевойСчет);
		ТаблицаРазделов = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрРасшифровки Из Объект.РасшифровкаПлатежа Цикл 
			Если НЕ ЗначениеЗаполнено(СтрРасшифровки.РазделЛС) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрРасшифровки.КодПоступленияЕБП) Тогда
				СтрРасшифровки.КодПоступленияЕБП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрРасшифровки.РазделЛС, "КодПоступленияЕБП");
			КонецЕсли;	
			НовЛС = ТаблицаРазделов.НайтиСтроки(Новый Структура("КодПоступленияЕБП", СтрРасшифровки.КодПоступленияЕБП));
			Если НовЛС.Количество() > 0 Тогда
				СтрРасшифровки.РазделЛС = НовЛС[0].Ссылка;
			Иначе
				СтрРасшифровки.РазделЛС = ПредопределенноеЗначение("Справочник.РазделыЛицевыхСчетов.ПустаяСсылка"); 
				СтрРасшифровки.КодПоступленияЕБП = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ПустаяСсылка");
			КонецЕсли;  
			СтрокиДетализации = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрРасшифровки.ИдентификаторСтроки));
			Для Каждого СтрДет Из СтрокиДетализации Цикл
				СтрДет.РазделЛС = СтрРасшифровки.РазделЛС; 
			КонецЦикла;
		КонецЦикла;	 

	КонецЕсли;	
	
	Если ОбновитьФорму Тогда
		УстановитьВидимостьЭлементовФормы();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.РСКППеречисление", 
	Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский,,, Неопределено);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры	
 
#Область ОснованиеИДокументыОснования

&НаСервере
Процедура РеквизитыДокументаОснованияПриНачалеРедактированияНаСервере(ВидРеестра, НомерРеестровойЗаписи);
	ВидРеестра = Сред(БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "КодВидаРеестра"), 1, 2);
    НомерРеестровойЗаписи = БиблиотекаФункцийОбмена.ПолучитьХарактеристикиОбязательства(Объект.Договор, "НомерРеестровойЗаписиВРеестреКонтрактов");
КонецПроцедуры	

&НаСервереБезКонтекста 
Функция ПолучитьПризнакВключенияВНазначение(ДокументВид)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументВид, "НазначениеПлатежа");
КонецФункции

#КонецОбласти

#Область НастройкаТаблицФормы

&НаКлиенте
Процедура УстановитьВидимостьДоступностьТаблицФормы()
	
	Элементы.НесколькоКодовБК.Доступность = Объект.НесколькоПолучателей = 0 И НЕ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС";
	Элементы.НесколькоПолучателей.Доступность = Объект.НесколькоКодовБК = 0 И НЕ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС";  
	
   	Элементы.ГруппаПолучательПлатежа.Видимость = Объект.НесколькоПолучателей = 0;
	Элементы.ГруппаКонтрагенты.Видимость = Объект.НесколькоПолучателей = 1;
	Элементы.ГруппаОдинКодБК.Видимость = Объект.НесколькоКодовБК = 0; 
	Элементы.ГруппаНесколькоКодовБК.Видимость = Объект.НесколькоКодовБК = 1; 
	Элементы.ГруппаДетализацияРасшифровка.Видимость = Объект.НесколькоПолучателей = 0;
	Элементы.ГруппаДетализацияРасшифровка.ОтображатьЗаголовок = Объект.НесколькоКодовБК = 1;  
	Элементы.РазницаДетализацииРасшифровки.Видимость = Объект.НесколькоКодовБК = 1;
	
	Если Объект.НесколькоКодовБК = 0 И Объект.НесколькоПолучателей = 0 Тогда  
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаРасшифровка", "Заголовок", "Детализация платежа");
	Иначе	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаРасшифровка", "Заголовок", "Расшифровка платежа");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРасшифровкуПлатежа(Результат, ЭтоСписокКонтрагентов) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ОчиститьРасшифровкуПлатежаНаСервере(ЭтоСписокКонтрагентов);
	ИначеЕсли НЕ ЭтоСписокКонтрагентов Тогда
		Объект.НесколькоКодовБК = 1; 
	Иначе
		Объект.НесколькоПолучателей = 0;
	КонецЕсли;  
	ЗаполнитьСуммыТабличныхЧастей(); 
	ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
	УстановитьВидимостьДоступностьТаблицФормы();	
	УстановитьСвязиПараметровВыбораДоговора(); 
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСписокКонтрагентов(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ОчиститьСписокКонтрагентовНаСервере();
	Иначе
		Объект.НесколькоПолучателей = 1;
	КонецЕсли; 
	ЗаполнитьСуммыТабличныхЧастей();
	ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
	УстановитьВидимостьДоступностьТаблицФормы();
	УстановитьСвязиПараметровВыбораДоговора(); 
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);  
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры  

&НаСервере  
Процедура ОчиститьРасшифровкуПлатежаНаСервере(ЭтоСписокКонтрагентов)
	
	Заполнять = Ложь;
	Если Объект.РасшифровкаПлатежа.Количество() > 0 Тогда
		СтрокаРасшифровки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Объект.РасшифровкаПлатежа.Выгрузить()[0]); 
		Заполнять = Истина;
	КонецЕсли;	
	Объект.РасшифровкаПлатежа.Очистить();
	НовРасшифровка = Объект.РасшифровкаПлатежа.Добавить(); 
	Если Заполнять Тогда
		ЗаполнитьЗначенияСвойств(НовРасшифровка, СтрокаРасшифровки); 
	Иначе // Нет строк, надо заполнить Идньтификатор
		НовРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор;	
	КонецЕсли;
	
	ДанныеДетализации = Новый Массив;
	Если Заполнять Тогда
		Детализация = Объект.ДетализацияПлатежа.Выгрузить().НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки)); 
		Для Каждого ЭлементДетализации Из Детализация Цикл 
			ДанныеДетализации.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ЭлементДетализации));
		КонецЦикла;	
	КонецЕсли;
	Объект.ДетализацияПлатежа.Очистить(); 
	Если ЭтоСписокКонтрагентов И ДанныеДетализации.Количество() > 1 Тогда
		Пока ДанныеДетализации.Количество() > 1 Цикл 
			ДанныеДетализации.Удалить(1);
		КонецЦикла;	
	КонецЕсли;
	Для Каждого СтрокаДетализации Из ДанныеДетализации Цикл
		НовДетализация = Объект.ДетализацияПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НовДетализация, СтрокаДетализации); 
	КонецЦикла;	
	
	Если НЕ Объект.ДетализацияПлатежа.Итог("СуммаВал") = НовРасшифровка.СуммаВал Тогда
		НовРасшифровка.СуммаВал = Объект.ДетализацияПлатежа.Итог("СуммаВал");
		НовРасшифровка.Сумма = Объект.ДетализацияПлатежа.Итог("Сумма");
	КонецЕсли;  
	
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры	

&НаСервере  
Процедура ОчиститьСписокКонтрагентовНаСервере()  
	
	Заполнять = Ложь;
	Если Объект.Контрагенты.Количество() > 0 Тогда
		СтрокаКонтрагента = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Объект.Контрагенты.Выгрузить()[0]); 
		Заполнять = Истина;
	КонецЕсли;
	Объект.Контрагенты.Очистить();    
	НовКонтрагент = Объект.Контрагенты.Добавить();
	Если Заполнять Тогда
		ЗаполнитьЗначенияСвойств(НовКонтрагент, СтрокаКонтрагента,, "СуммаВал,Сумма,СтрокаНазначениеПлатежа,ДополнительнаяИнформация"); 
	Иначе
		НовКонтрагент.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Объект.ДетализацияПлатежа.Очистить(); 
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры	

&НаСервере  
Процедура ЗаполнитьДобавленныеКолонкиТаблиц() 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка,
	|	РазделыЛицевыхСчетов.КодПоступленияЕБП КАК КодПоступленияЕБП
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Ссылка В(&Ссылка)");  
	Запрос.УстановитьПараметр("Ссылка", Объект.РасшифровкаПлатежа.Выгрузить(, "РазделЛС").ВыгрузитьКолонку("РазделЛС")); 
	ТабКодовПоступлений = Запрос.Выполнить().Выбрать(); 
	Пока ТабКодовПоступлений.Следующий() Цикл
		ВыбранныеСтроки = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("РазделЛС", ТабКодовПоступлений.Ссылка));	
		Для Каждого Строка Из ВыбранныеСтроки Цикл
			Строка.КодПоступленияЕБП = ТабКодовПоступлений.КодПоступленияЕБП;
		КонецЦикла;
	КонецЦикла;  
	
	ПлатежноРасчетныеДокументы.ЗаполнитьПризнакНазначенияПлатежаВСпискеОснований(Объект.РеквизитыДокументаОснования);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуРедактированияТекста(Элемент);
    ПараметрыФормы = Новый Структура("ТекстДляРедактирования, ЗаголовокФормы");
    ПараметрыФормы.Вставить("ТекстДляРедактирования", Элемент.ТекстРедактирования);
	ПараметрыФормы.Вставить("ЗаголовокФормы", "Дополнительная информация");
	ОткрытьФорму("ОбщаяФорма.РедактированиеТекста", ПараметрыФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры  

#КонецОбласти     

#Область ТаблицаДетализацияПлатежа

&НаКлиенте
Процедура ДетализацияПлатежаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ИмяПоля = "";
	Если РодительскаяСтрокаДетализации(ИмяПоля) = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбраны детализируемые данные!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , ИмяПоля, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда 
		ДетализацияПлатежаТекущиеДанные = Элемент.ТекущиеДанные;
		РодительскаяСтрока = РодительскаяСтрокаДетализации();
		Если Объект.НесколькоПолучателей = 1 Тогда
			ДопРодительскаяСтрока = Объект.РасшифровкаПлатежа[0]; 
			КодПоступленияЕБП = ДопРодительскаяСтрока.КодПоступленияЕБП;
		Иначе
			ДопРодительскаяСтрока = Объект.Контрагенты[0];  
			КодПоступленияЕБП = РодительскаяСтрока.КодПоступленияЕБП;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДетализацияПлатежаТекущиеДанные, РодительскаяСтрока,, "Сумма,СуммаВал"); 
		ЗаполнитьЗначенияСвойств(ДетализацияПлатежаТекущиеДанные, ДопРодительскаяСтрока,, "Сумма,СуммаВал,ИдентификаторСтроки"); 
		ВведеноРанее = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", РодительскаяСтрока.ИдентификаторСтроки)); 
		СуммаРанее = 0;
		СуммаВалРанее = 0;
		Для Каждого Стр Из ВведеноРанее Цикл 
			Если НЕ ДетализацияПлатежаТекущиеДанные = Стр Тогда 
				СуммаРанее = СуммаРанее + Стр.Сумма;
				СуммаВалРанее = СуммаВалРанее + Стр.СуммаВал;
			КонецЕсли;
		КонецЦикла;	
		ДетализацияПлатежаТекущиеДанные.Сумма = РодительскаяСтрока.Сумма - СуммаРанее;
		ДетализацияПлатежаТекущиеДанные.СуммаВал = РодительскаяСтрока.СуммаВал - СуммаВалРанее;
		
		Если НЕ Копирование Тогда
			ДетализацияПлатежаТекущиеДанные.СпособПогашенияЗадолженности =
			ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");  
			ДетализацияПлатежаТекущиеДанные.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступленияЕБП);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры     

&НаКлиенте
Процедура ДетализацияПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РодительскаяСтрока = РодительскаяСтрокаДетализации();
	Если Не РодительскаяСтрока = Неопределено Тогда
		ОтклонениеДетализации(РодительскаяСтрока);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаПослеУдаления(Элемент) 
	РодительскаяСтрока = РодительскаяСтрокаДетализации();
	Если Не РодительскаяСтрока = Неопределено Тогда
		ОтклонениеДетализации(РодительскаяСтрока);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаСуммаВалПриИзменении(Элемент, ИмяТаблицы)
	
	СтрокаТаблицы = Элементы[ИмяТаблицы].ТекущиеДанные;  
	РодительскаяСтрока = РодительскаяСтрокаДетализацииПоИдентификатору(СтрокаТаблицы.ИдентификаторСтроки);
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки)); 
	СуммаВал = 0;
	СуммаРуб = 0;
	Для Каждого Стр Из Детализация Цикл   
		СуммаВал = СуммаВал + Стр.СуммаВал;
		СуммаРуб = СуммаРуб + Стр.Сумма;
	КонецЦикла;	  
	Если ЗначениеЗаполнено(РодительскаяСтрока[0].Сумма) И СуммаВал = РодительскаяСтрока[0].СуммаВал Тогда
		// Надо списать весь остаток рублевого покрытия
		СтрокаТаблицы.Сумма = РодительскаяСтрока[0].Сумма - (СуммаРуб - СтрокаТаблицы.Сумма)
	Иначе		
		СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВал * ?(Объект.Курс=0, 1, Объект.Курс) / ?(Объект.Кратность=0, 1, Объект.Кратность); 
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаКОСГУНазначениеПлатежаПриИзменении(Элемент, ИмяТаблицы)
	
	Если ЗначениеЗаполнено(Объект.КорСчет) Тогда
		ДетализацияПлатежаКОСГУНазначениеПлатежаПриИзмененииНаСервере(ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДетализацияПлатежаКОСГУНазначениеПлатежаПриИзмененииНаСервере(ИмяТаблицы)
	
	ДанныеСтроки = Объект.ДетализацияПлатежа.НайтиПоИдентификатору(Элементы[ИмяТаблицы].ТекущаяСтрока);
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
			ДанныеСтроки.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаКодМероприятияПриИзменении(Элемент)
	УстановитьДопСубконтоРасчетов(Элементы.ДетализацияПлатежаРасшифровка.ТекущиеДанные, "КодМероприятия");
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаДопКлассификацияПриИзменении(Элемент)
	УстановитьДопСубконтоРасчетов(Элементы.ДетализацияПлатежаРасшифровка.ТекущиеДанные, "ДопКлассификация");
КонецПроцедуры  

&НаКлиенте
Процедура КБКНазначениеПлатежаПриИзмененииНаКлиенте(СтрокаРасшифровки)
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
	Для Каждого Стр Из Детализация Цикл 
		Стр.КБКНазначениеПлатежа = СтрокаРасшифровки.КБКНазначениеПлатежа; 
		БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(Стр.КБКНазначениеПлатежа, Стр.КОСГУНазначениеПлатежа); 
	КонецЦикла;	
КонецПроцедуры  

&НаКлиенте
Процедура КодЦелиПриИзмененииНаКлиенте(СтрокаРасшифровки);
	УстановитьДопСубконтоРасчетов(СтрокаРасшифровки, "КодЦели"); 
КонецПроцедуры   

&НаКлиенте
Процедура РазделЛСПриИзмененииНаКлиенте(СтрокаРасшифровки) 
	
	СтрокаРасшифровки.КодПоступленияЕБП = ПолучитьКодПоступленияЕБП(СтрокаРасшифровки.РазделЛС); 
			
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
	Для Каждого Стр Из Детализация Цикл 
		Стр.РазделЛС = СтрокаРасшифровки.РазделЛС;
	КонецЦикла;		
	
КонецПроцедуры  

&НаСервереБезКонтекста 
Функция ПолучитьКодПоступленияЕБП(РазделЛС)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛС, "КодПоступленияЕБП");
КонецФункции

&НаКлиенте
Функция РодительскаяСтрокаДетализации(ИмяПоля = "")
	Если Объект.НесколькоКодовБК = 1 Тогда
		РодительскаяСтрока = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
		ИмяПоля = "РасшифровкаПлатежа";
	ИначеЕсли Объект.НесколькоПолучателей = 1 Тогда
		РодительскаяСтрока = Элементы.Контрагенты.ТекущиеДанные;
		ИмяПоля = "Контрагенты";
	ИначеЕсли Объект.РасшифровкаПлатежа.Количество() > 0 Тогда
		РодительскаяСтрока = Объект.РасшифровкаПлатежа[0];
	Иначе
		РодительскаяСтрока = Неопределено;
		ИмяПоля = "РасшифровкаПлатежа";
	КонецЕсли;
	Возврат РодительскаяСтрока; 
КонецФункции	

&НаКлиенте
Функция РодительскаяСтрокаДетализацииПоИдентификатору(ИдентификаторСтроки)
	Если Объект.НесколькоКодовБК = 1 Тогда
		РодительскаяСтрока = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ИначеЕсли Объект.НесколькоПолучателей = 1 Тогда   
		РодительскаяСтрока = Объект.Контрагенты.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ИначеЕсли Объект.РасшифровкаПлатежа.Количество() > 0 Тогда
		РодительскаяСтрока = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Иначе
		РодительскаяСтрока = Новый Массив;
	КонецЕсли;
	Возврат РодительскаяСтрока; 
КонецФункции	

&НаКлиенте
Процедура ОтборДляДетализацииПлатежа(ИдентификаторСтроки, ИмяПоля)
	ОтборСтрок = Элементы[ИмяПоля].ОтборСтрок;
	Если ОтборСтрок = Неопределено
		ИЛИ НЕ (ОтборСтрок.Свойство("ИдентификаторСтроки")
				И ОтборСтрок.ИдентификаторСтроки = ИдентификаторСтроки) Тогда
		Элементы[ИмяПоля].ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ОтклонениеДетализации(РодительТекущиеДанные) 
	Если РодительТекущиеДанные = Неопределено Тогда
		РазницаДетализацииРасшифровки = 0; 
		Возврат;
	КонецЕсли;
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", РодительТекущиеДанные.ИдентификаторСтроки)); 
	РазницаДетализацииРасшифровки = - РодительТекущиеДанные.СуммаВал;
	Для Каждого Стр Из Детализация Цикл 
		РазницаДетализацииРасшифровки = РазницаДетализацииРасшифровки + Стр.СуммаВал;	
	КонецЦикла;	  
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьСтрокиДетализаци(ВыделенныеСтроки, ОбъектВладелец)
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		Строка = ОбъектВладелец.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если Строка <> Неопределено Тогда
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.ДетализацияПлатежа.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.ДетализацияПлатежа.Удалить(СтрокаКУдалению);
			КонецЦикла;
		КонецЕсли
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка, РодительскаяСтрока);
	 
	СтандартнаяОбработка = Ложь;
	
	ОтборКБК = Новый Структура;
	
	ЗаполнитьОтборКБК(РодительскаяСтрока.КБКНазначениеПлатежа, ОтборКБК);   
	
	ОтборКБК.Вставить("НаДату", Объект.Дата);
	ОтборКБК.Вставить("Организация", Объект.Организация);
    ОтборКБК.Вставить("ИФО", Объект.ИФО);
	
	ПараметрыКБК = Новый Структура("Отбор", ОтборКБК);
	
	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыКБК, Элемент); 
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьОтборКБК(КБКИсходный, ОтборКБК)  
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЛС =  "ВРПБС" Тогда 
		ОтборКБК.Вставить("ВидПоказателя", ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));
		ОтборКБК.Вставить("КодАналитическойГруппы", "610");
	Иначе	
		РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КБКИсходный, "ВидПоказателя,УточнениеПоказателя,Код"); 
		ОтборКБК.Вставить("ВидПоказателя", РеквизитыКБК.ВидПоказателя);
		ОтборКБК.Вставить("УточнениеПоказателя", РеквизитыКБК.УточнениеПоказателя);
		ОтборКБК.Вставить("КодАналитическойГруппы", ПРАВ(РеквизитыКБК.Код, 3)); 
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ДетализацияПлатежаКФОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка, РодительскаяСтрока)
	Элемент.СписокВыбора.Очистить();
	СоотвествиеКодов = ПлатежноРасчетныеДокументыКлиентСервер.СоответствиеКФОКодамПоступленийЕБП(Объект.Дата);
	Для Каждого КлючИЗначение Из СоотвествиеКодов Цикл 
		Если КлючИЗначение.Значение = РодительскаяСтрока.КодПоступленияЕБП Тогда
			Элемент.СписокВыбора.Добавить(КлючИЗначение.Ключ);	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

