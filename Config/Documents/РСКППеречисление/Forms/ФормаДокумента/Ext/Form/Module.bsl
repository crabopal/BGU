#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыДокументаОснования

&НаКлиенте
Процедура РеквизитыДокументаОснованияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)   
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;	
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат;
	КонецЕсли;
    РеквизитыДокументаОснованияПриНачалеРедактированияНаСервере(Элемент.ТекущиеДанные.ВидРеестра, Элемент.ТекущиеДанные.НомерРеестровойЗаписи);
КонецПроцедуры 

&НаКлиенте
Процедура РеквизитыДокументаОснованияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаОснованияПослеУдаления(Элемент)
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаОснованияДокументОснованиеВидПриИзменении(Элемент)   
	ТекДанные = Элементы.РеквизитыДокументаОснования.ТекущиеДанные; 
	Если ТипЗнч(ТекДанные.ДокументОснованиеВид) = Тип("СправочникСсылка.ВидыДокументовОснованийЕБП") Тогда 
		ТекДанные.НазначениеПлатежа = ПолучитьПризнакВключенияВНазначение(ТекДанные.ДокументОснованиеВид);
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура РеквизитыДокументаОснованияДокументОснованиеВидНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ" Тогда 
		СтандартнаяОбработка = Ложь; 
		МассивКБК = Новый Массив;
		Для Каждого СтрКБК Из Объект.РасшифровкаПлатежа Цикл 
			МассивКБК.Добавить(СтрКБК.КБКНазначениеПлатежа);
		КонецЦикла;
		ПараметрыОтбора = Новый Структура("КБК", МассивКБК);
		ОткрытьФорму("Справочник.ВидыДокументовОснованийЕБП.ФормаВыбора", ПараметрыОтбора, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежа

&НаКлиенте
Процедура РасшифровкаПлатежаПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОтборДляДетализацииПлатежа(Элемент.ТекущиеДанные.ИдентификаторСтроки, "ДетализацияПлатежаРасшифровка");
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
		ОтклонениеДетализации(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)  
	
	Если (Объект.НесколькоПолучателей = 1 Или Объект.НесколькоКодовБК = 0) И Объект.РасшифровкаПлатежа.Количество() > 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование) 
	
	Если НоваяСтрока Тогда
		Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.ДетализацияПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			//РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		КонецЕсли;
		
		ОтборДляДетализацииПлатежа(Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки, "ДетализацияПлатежаРасшифровка");
		
	КонецЕсли;
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокументаВВалюте) Тогда
		ТекущиеДанные.СуммаВал = Объект.СуммаДокументаВВалюте - (Объект.РасшифровкаПлатежа.Итог("СуммаВал") - ТекущиеДанные.СуммаВал);
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность);  
		Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС, Объект.РасшифровкаПлатежа);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	ОтклонениеДетализации(Элемент.ТекущиеДанные);
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПередУдалением(Элемент, Отказ)
	УдалитьСтрокиДетализаци(Элемент.ВыделенныеСтроки, Объект.РасшифровкаПлатежа);
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПослеУдаления(Элемент)
	ОтклонениеДетализации(Элемент.ТекущиеДанные);
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКБКНазначениеПлатежаПриИзменении(Элемент)
	КБКНазначениеПлатежаПриИзмененииНаКлиенте(Элементы.РасшифровкаПлатежа.ТекущиеДанные);
КонецПроцедуры  

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаВалПриИзменении(Элемент)
		
	СтрокаТаблицы = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) И Объект.РасшифровкаПлатежа.Итог("СуммаВал") = Объект.СуммаДокументаВВалюте Тогда
		// Надо списать весь остаток рублевого покрытия
		СтрокаТаблицы.Сумма = Объект.СуммаДокумента - (Объект.РасшифровкаПлатежа.Итог("Сумма") - СтрокаТаблицы.Сумма)
	Иначе		
		СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность); 
	КонецЕсли;	 
	
	Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС, Объект.РасшифровкаПлатежа);
	
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаРазделЛСПриИзменении(Элемент)
	РазделЛСПриИзмененииНаКлиенте(Элементы.РасшифровкаПлатежа.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКонтрагенты    

&НаКлиенте
Процедура КонтрагентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)   
	Если Поле.Имя = "КонтрагентыКонтрагентНаименование"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентБанковскийСчет"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентБИКБанка"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентНаименованиеБанка"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентКорСчетБанка"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентЛицевойСчет"  
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентИНН"
		ИЛИ Поле.Имя = "КонтрагентыКонтрагентКПП"
		Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиРеквизитовПолучателя(ВыбраннаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОтборДляДетализацииПлатежа(Элемент.ТекущиеДанные.ИдентификаторСтроки, "ДетализацияПлатежаКонтрагенты");
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
		ОтклонениеДетализации(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Объект.НесколькоПолучателей = 0 И Объект.Контрагенты.Количество() > 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура КонтрагентыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элементы.Контрагенты.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.Контрагенты.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.ДетализацияПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки, Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.Контрагенты.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			//РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		КонецЕсли;
		
		ОтборДляДетализацииПлатежа(Элементы.Контрагенты.ТекущиеДанные.ИдентификаторСтроки, "ДетализацияПлатежаКонтрагенты");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования) 
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	ОтклонениеДетализации(Элемент.ТекущиеДанные);
	СформироватьТекстНазначенияПлатежа(); 
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПередУдалением(Элемент, Отказ)
	УдалитьСтрокиДетализаци(Элемент.ВыделенныеСтроки, Объект.Контрагенты);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПослеУдаления(Элемент)
	ОтклонениеДетализации(Элемент.ТекущиеДанные);
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект); 
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыКонтрагентПриИзменении(Элемент)
	Элементы.Контрагенты.ТекущиеДанные.СчетКонтрагента = СчетКонтрагетаПоУмолчанию(Элементы.Контрагенты.ТекущиеДанные.Контрагент); 
	ЗаполнитьРеквизитыПолучателяНаКлиенте(Элементы.Контрагенты.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыСчетКонтрагентаПриИзменении(Элемент)
	ЗаполнитьРеквизитыПолучателяНаКлиенте(Элементы.Контрагенты.ТекущиеДанные);
КонецПроцедуры  

&НаКлиенте
Процедура КонтрагентыКодПоступленияЕБПНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	КодПоступленияЕБПНачалоВыбораНаКлиенте(Элементы.Контрагенты.ТекущиеДанные, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыСуммаВалПриИзменении(Элемент)   
	
	СтрокаТаблицы = Элементы.Контрагенты.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) И Объект.Контрагенты.Итог("СуммаВал") = Объект.СуммаДокументаВВалюте Тогда
		// Надо списать весь остаток рублевого покрытия
		СтрокаТаблицы.Сумма = Объект.СуммаДокумента - (Объект.Контрагенты.Итог("Сумма") - СтрокаТаблицы.Сумма)
	Иначе		
		СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность); 
	КонецЕсли;	
	
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыДополнительнаяИнформацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФормуРедактированияТекста(Элемент);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДетализацияПлатежаРасшифровка

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ДетализацияПлатежаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ДетализацияПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ДетализацияПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования);   
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаПослеУдаления(Элемент)
	ДетализацияПлатежаПослеУдаления(Элемент);
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
КонецПроцедуры 

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаСуммаВалПриИзменении(Элемент)
	ДетализацияПлатежаСуммаВалПриИзменении(Элемент, "ДетализацияПлатежаРасшифровка");
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаРасшифровкаКОСГУНазначениеПлатежаПриИзменении(Элемент)
