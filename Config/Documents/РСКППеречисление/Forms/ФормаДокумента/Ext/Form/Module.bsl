#Область ФискальныеОперации

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.СистемаНалогообложенияЧекаККМ = ПодключаемоеОборудованиеБГУ.ВидСистемыНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
		Объект.СистемаНалогообложенияЧекаККМ = НастройкиОборудования.ФискальныйРегистратор.СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ПараметрыДоговораПлатежногоАгента) Тогда
		Объект.ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Если Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
			ИспользоватьПодключаемоеОборудование = Ложь;
		Иначе
			ИспользоватьПодключаемоеОборудование = Истина;
		КонецЕсли;
		
		ПризнакСпособаРасчетаПоУмолчанию = Объект.КассаККМ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		Иначе
			ПризнакСпособаРасчетаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ");
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭлектроннойПочты = РезультатОткрытияФормы.Email;
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонSMS = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			ТелефонSMS = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, ТелефонSMS, ТелефонСтрокой);
			АбонентскийНомерТелефона = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭлектроннойПочты = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ТелефонSMS = 0;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнить(ОповещениеПриЗавершении)
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если НомерКассовогоЧека <> 0 Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
		
		Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Документ не проведен!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ);  
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.КассаККМ];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		
		Если ИспользоватьБезПримененияККТ Тогда
			ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи);
			
			НомерДокументаКассыККМ[Объект.КассаККМ] = ПорядковыйНомерПродажи +	1;
				
			Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
			
			ЭтотОбъект.Доступность = Истина;
			НомерКассовогоЧека = НомерЧекаДляДокумента();
			ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
			УстановитьВидимостьЭлементовФормы();
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
			
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		ЭтотОбъект.Доступность = Ложь;

		// Готовим данные
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
										
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается при нажатии кнопки "НапечататьЧек" командной панели.
//
&НаКлиенте
Процедура ПробитьЧекНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ПробитьЧекСПроверкойСтавокНДС();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если ЧекПробит Тогда
		ТолькоПросмотр = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовФормы();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКнопокПроведенияКлиент()
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Функция ЕстьЧекНепримененияККТ()
	Результат = Ложь;
	
	ЧекНепримененияККТ = ПодключаемоеОборудованиеБГУ.ИсправительныйЧекККМОперацииНепримененияККТ(Объект.Ссылка);
	Если ЗначениеЗаполнено(ЧекНепримененияККТ) Тогда
		ТекстСообщения = НСтр("ru = 'Кассовый чек не может быть напечатан. Для документа %1 
		|введен документ ""Исправительный чек ККМ"" с видом операции ""Неприменение ККТ""!
		|Документ %2 можно открыть через ""Связанные документы"" меню навигации.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.Ссылка, ЧекНепримененияККТ);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , );
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены(ПросмотрЧека = Ложь)
	Результат = Истина;
	
	Если НЕ ПросмотрЧека Тогда
		ЕстьЧекНепримененияККТ = ЕстьЧекНепримененияККТ();
		Если ЕстьЧекНепримененияККТ Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат Ложь;	
	КонецЕсли;
	
	//Если НЕ ПодключаемоеОборудованиеБГУВызовСервера.ПлатежноРасчетныйДокументИсполнен(Объект.Ссылка) Тогда
	//	ТекстСообщения = НСтр("ru = 'Документ не исполнен!'");
	//	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СтатусЭтогоДокумента");
	//	
	//	Результат = Ложь;
	//КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" у реквизита ""Ответственный""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СистемаНалогообложенияЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета""!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ТипРасчета");
		
		Результат = Ложь;	
	КонецЕсли;
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	СуммаВсего = СтавкаДокумента.Всего;
	Если СуммаВсего <> Объект.СуммаДокумента Тогда
		ЕстьЧастичнаяОплата = Ложь;
		Для каждого ТекОплата Из Объект.ДокументыЧекаККМ Цикл
			Если ТекОплата.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаЧастичная Тогда
				ЕстьЧастичнаяОплата = Истина;
		        Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьЧастичнаяОплата Тогда
			ТекстСообщения = НСтр("ru = 'Сумма документа не равна итоговой сумме товаров/услуг документов-оснований чека ККМ! Следует использовать команду ""Заполнить сумму документа""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
	Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
		Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
			ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Результат = Ложь;
		ИначеЕсли Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
			ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
			Если ЗначениеЗаполнено(ВозвратНоменклатурыПрейскуранта) Тогда
				Если НЕ(Объект.СистемаНалогообложенияЧекаККМ = ВозвратНоменклатурыПрейскуранта.СистемаНалогообложенияЧекаККМ) Тогда
					ТекстСообщения = НСтр("ru = 'Система налогообложения в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствует системе налогообложения на закладке ""Чек ККМ""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
				Если НЕ(Объект.ПараметрыДоговораПлатежногоАгента = ВозвратНоменклатурыПрейскуранта.ПараметрыДоговораПлатежногоАгента) Тогда
					ТекстСообщения = НСтр("ru = 'Параметры договора платежного агента в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствуют параметрам на закладке ""Чек ККМ""!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru = 'Не заполнен документ-основание ""Перечень номенклатуры прейскуранта для возврата""!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка);
	ЕстьПустыеНаименованияТоваровУслуг = Ложь;
	ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
	НомераСтрокПустыхНаименований = "";
	НомераСтрокПустыхПредметовРасчета = "";
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Наименование) Тогда
			ЕстьПустыеНаименованияТоваровУслуг = Истина;
			НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета) Тогда
			ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
			НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
	КонецЦикла;	
	
	Если ЕстьПустыеНаименованияТоваровУслуг Тогда
		НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
		Если НомераСтрокПустыхНаименований = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека пустое наименование номенклатуры! 
			|Следует в документе-основании заполнить номенклатуру и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека пустые наименования номенклатуры!
			|Следует в документах-основаниях для этих строк заполнить номенклатуру и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
		НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
		Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета! 
			|Следует в документе-основании заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета!
			|Следует в документах-основаниях для этих строк заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	ПолучательЧекаККМ = Объект.Контрагенты[0].Контрагент;
	Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
		ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.НомерТелефонаДляЭлектронногоЧекаКорректен(АбонентскийНомерТелефона) Тогда
			ТекстСообщения = НСтр("ru = 'Номер телефона для электронного чека указан некорректно!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.АбонентскийНомерТелефона");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес электронной почты для электронного чека указан некорректно!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.АдресЭлектроннойПочты");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			Попытка
				СохраненныйТелефон = Число(АбонентскийНомерТелефона);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,"АбонентскийНомерТелефона");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонSMS = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, ТелефонSMS, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма, НомерЧекаККМ = 0)
	ТекстЗаголовкаДанныхЧека = "";
	
	Объект = Форма.Объект;
	
	ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
	
	НомерЧекаККМ = ?(НомерЧекаККМ<>0, НомерЧекаККМ, Объект.НомерЧекаККМ);
	
	Если ИспользуетсяККТСПередачейДанных Тогда
		ТекстНомераЧека = НСтр("ru='ФД № '")+Формат(НомерЧекаККМ,"ЧГ=");
	Иначе	
		ТекстНомераЧека = НСтр("ru='№ '")+Формат(НомерЧекаККМ,"ЧГ=");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Форма.ЗаключительныйЧекИсправительный) Тогда
		ТекстНомераЧека = ТекстНомераЧека + " отменен";
	КонецЕсли;	
	
	Если НомерЧекаККМ<>0 Тогда
		ТекстЗаголовкаДанныхЧека = ТекстНомераЧека;
	КонецЕсли;	
	
	Форма.ДанныеЗаголовкаСтраницыЧекаККМ = ТекстЗаголовкаДанныхЧека;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуПоЧекуНаКлиенте(Результат, ДопПараметры) Экспорт   
	Если Результат = КодВозвратаДиалога.Отмена Тогда
        Возврат;
	КонецЕсли;
	Если Записать() Тогда
		КомандаЗаполнитьСуммуДокументаНаСервере();
	КонецЕсли;
    СуммаДокументаВВалютеПриИзмененииНаКлиенте();  
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	УстановитьВидимостьДоступностьТаблицФормы(); 
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьСуммуДокументаНаСервере()
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	Объект.СуммаДокументаВВалюте = СтавкаДокумента.Всего;
	
	ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
	Для Каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
		Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
			ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;	
		Если Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
			ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
			Если ЗначениеЗаполнено(ВозвратНоменклатурыПрейскуранта) Тогда
				Объект.Договор = ВозвратНоменклатурыПрейскуранта.Договор; 
				
				СуммыКЗаполнению = РасшифровкаПоВозвратуНоменклатурыПрейскуранта(ВозвратНоменклатурыПрейскуранта);
				Если СуммыКЗаполнению.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				СуммыКЗаполнению.Свернуть("КБКНазначениеПлатежа, КОСГУНазначениеПлатежа, КодЦели, КодМероприятия, ДопКлассификация", "СуммаВал");
				СуммыПоБК = СуммыКЗаполнению.Скопировать(); 
				СуммыПоБК.Свернуть("КБКНазначениеПлатежа, КодЦели", "СуммаВал"); 
				
				Объект.ДетализацияПлатежа.Очистить();
				
				// Первая строка
				ЗаполнитьЗначенияСвойств(Объект.РасшифровкаПлатежа[0], СуммыПоБК[0]);
				СтрокиДетализации = СуммыКЗаполнению.НайтиСтроки(Новый Структура("КБКНазначениеПлатежа, КодЦели", 
				СуммыПоБК[0].КБКНазначениеПлатежа, СуммыПоБК[0].КодЦели));
				Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл 
					НовСтр = Объект.ДетализацияПлатежа.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, Объект.РасшифровкаПлатежа[0]);
					ЗаполнитьЗначенияСвойств(НовСтр, СтрокаДетализации);
				КонецЦикла;	
				
				// Со второй строки
				Если СуммыПоБК.Количество() > 1 Тогда
					Для Инд = 1 По СуммыПоБК.Количество() - 1 Цикл 
						СтрРасшифровка = Объект.РасшифровкаПлатежа.Добавить();
						ЗаполнитьЗначенияСвойств(СтрРасшифровка, Объект.РасшифровкаПлатежа[0]);
						ЗаполнитьЗначенияСвойств(СтрРасшифровка, СуммыПоБК[Инд]);
						СтрРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
						СтрокиДетализации = СуммыКЗаполнению.НайтиСтроки(Новый Структура("КБКНазначениеПлатежа, КодЦели", 
						СуммыПоБК[Инд].КБКНазначениеПлатежа, СуммыПоБК[Инд].КодЦели));
						Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл 
							НовСтр = Объект.ДетализацияПлатежа.Добавить();
							ЗаполнитьЗначенияСвойств(НовСтр, СтрРасшифровка);
							ЗаполнитьЗначенияСвойств(НовСтр, СтрокаДетализации);
						КонецЦикла;
					КонецЦикла;
					Объект.НесколькоКодовБК = 1;
					Объект.СуммаДокументаВВалюте = Объект.РасшифровкаПлатежа.Итог("СуммаВал");
				КонецЕсли; 
				Объект.СуммаДокументаВВалюте = Объект.РасшифровкаПлатежа.Итог("СуммаВал");
				Объект.КорСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("205.00"); 
				КорСчетПриИзмененииНаСервере();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РасшифровкаПоВозвратуНоменклатурыПрейскуранта(ДокСсылка)
	Результат = Неопределено;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка); 
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.Номенклатура КАК Номенклатура,
	|	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.Всего КАК Всего
	|ПОМЕСТИТЬ ТоварыРаботыУслуги
	|ИЗ
	|	Документ.ЗаявлениеНаВозвратПоЧекуККМ.ТоварыРаботыУслуги КАК ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги
	|ГДЕ
	|	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КПС КАК КБКНазначениеПлатежа,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КЭК КАК КОСГУНазначениеПлатежа,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КодЦели КАК КодЦели,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КодМероприятия КАК КодМероприятия,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.ДопКлассификация КАК ДопКлассификация,
	|	СУММА(ТоварыРаботыУслуги.Всего) КАК СуммаВал
	|ИЗ
	|	ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КПС,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КЭК,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КодЦели,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.КодМероприятия,
	|	ТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты.ДопКлассификация";
	
	Результат = Запрос.Выполнить().Выгрузить();			   
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ЗаполнениеДанныхДляЧекаККМ()

	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека); 
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека)
	
	Если Не ЗначениеЗаполнено(НомерКассовогоЧека) Тогда  
		Если ЗначениеЗаполнено(Объект.КассаККМ) И ЗаполнятьПочтуИТелефонДляОтправкиЧека() Тогда 	
			АдресПочты 		= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйАдресЭлектроннойПочтыПокупателя(Объект.Контрагенты[0].Контрагент);
			НомерТелефона 	= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйНомерТелефонаПокупателя(Объект.Контрагенты[0].Контрагент);
			Если ЗначениеЗаполнено(АдресПочты) Тогда 
				АдресЭлектроннойПочты = АдресПочты;
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
				ОтказПокупателяОтСохраненияДанных = Истина;
			ИначеЕсли ЗначениеЗаполнено(НомерТелефона) Тогда 
				ТелефонSMS = 0;
				ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(НомерТелефона, ТелефонSMS, ТелефонСтрокой);
				АбонентскийНомерТелефона = "7" + Формат(НомерТелефона, "ЧЦ=10; ЧДЦ=; ЧГ=0");
				АдресЭлектроннойПочты = "";
				ДанныеSMSИлиEmail = ТелефонСтрокой;
				ОтказПокупателяОтСохраненияДанных = Истина;  
			Иначе
				АдресЭлектроннойПочты = "";
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = "";
			КонецЕсли;  
			ЗаписатьДополнительныеДанныеЧековККМ();  
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = "";	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнятьПочтуИТелефонДляОтправкиЧека()
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ЗаполнятьПочтуИТелефонДляОтправкиЧека");
	
КонецФункции

&НаСервере
Процедура ДействияСКонтактнымиДаннымиДляЧекаККМ()
	
	Если Объект.НесколькоПолучателей = 0 И Объект.Контрагенты.Количество() = 1 Тогда
		ЗаписатьДополнительныеДанныеЧековККМ();
		Если НЕ ОтказПокупателяОтСохраненияДанных Тогда
			Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
				ПодключаемоеОборудованиеБГУ.ЗаписатьТелефонКонтрагента(Объект.Контрагент, АбонентскийНомерТелефона);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
				ПодключаемоеОборудованиеБГУ.ЗаписатьEmailКонтрагента(Объект.Контрагент, АдресЭлектроннойПочты);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ", "");
		СтруктураРеквизитов.Вставить("ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ", "");
		
		РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, СтруктураРеквизитов);
		
		Объект.СистемаНалогообложенияЧекаККМ = РеквизитыККТ.СистемаНалогообложенияЧекаККМ;
		ПризнакСпособаРасчетаПоУмолчанию = РеквизитыККТ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		КонецЕсли;	
	КонецЕсли;	
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры	

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДокументовОснованийЧекаККМ(ПараметрыПодбора) Экспорт
	ПараметрыПодбора.Вставить("АдресДокументыОснованияВХранилище", "");
КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияДокументовОснованийДляЧекаНаСервере(Знач ВыбранноеЗначение)
	
	МассивДокументовОснований = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДокументыОснованияВХранилище);
	Для каждого ТекСтрока Из МассивДокументовОснований Цикл
		Если НЕ ЕстьВСпискеДокументовЧекаККМ(ТекСтрока.ДокументОснованиеЧекаККМ) Тогда
			НоваяСтрока = Объект.ДокументыЧекаККМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			Если ТипЗнч(НоваяСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
				НоваяСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
			Иначе
				Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
					НоваяСтрока.ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
				Иначе			
					НоваяСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			ТекстСообщения = НСтр("ru = 'Документ %1 не добавлен, т.к. уже содержится в списке!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.ДокументОснованиеЧекаККМ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , );
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ЕстьВСпискеДокументовЧекаККМ(ДокСсылка)
	Результат = Истина;
	ПараметрыПоиска = Новый Структура("ДокументОснованиеЧекаККМ", ДокСсылка);
	РезультатПоиска = Объект.ДокументыЧекаККМ.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() = 0 Тогда
		Результат = Ложь;
	КонецЕсли;
		
	Возврат Результат;	
КонецФункции	

&НаСервере
Процедура ЗаполнитьДанныеПоПеречнюНоменклатурыПрейскуранта(ДокументВозвратаРозницы) 
	ЗаполняемыеДанные = "СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументВозвратаРозницы, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
КонецПроцедуры

&НаСервере
Функция ПризнакСпособаРасчетаЧекаККМ(ДокументВозвратаРозницы)
	Если ТипЗнч(ДокументВозвратаРозницы) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
		ЧекПродажи = ДокументВозвратаРозницы.ДокументОснование;
		Если ЗначениеЗаполнено(ЧекПродажи) Тогда
			Результат = ЧекПродажи.ПризнакСпособаРасчетаЧекаККМ;
		Иначе
			Результат = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		КонецЕсли;
	Иначе	
		Результат = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПараметрыДоговораПлатежногоАгентаПриИзмененииНаСервере()
	ПодразделениеПлатежногоАгента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПараметрыДоговораПлатежногоАгента, "Подразделение");
	Если ЗначениеЗаполнено(ПодразделениеПлатежногоАгента) Тогда
		Объект.Подразделение = ПодразделениеПлатежногоАгента;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЭтоФизЛицо(ПроверяемыйКонтрагент)
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ПроверяемыйКонтрагент) Тогда
		СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроверяемыйКонтрагент, "ВидКонтрагента");
		Если СтруктураРезультат.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;

	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ВывестиПредставлениеЧека()
	ЕстьОшибки = Ложь;
	ЧекСформирован = Ложь;
	
	КассаККМЧека = Объект.КассаККМ;
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены(Истина) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ДанныеЧекаДляДокумента = ДанныеЧекаДляДокумента();
		
		НомерКассовогоЧека = ДанныеЧекаДляДокумента.НомерЧекаККМ;		
		
		Если (НомерКассовогоЧека = 0) ИЛИ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда      
			НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерДокКассыККМ = ?(НомерДокументаКассыККМ[Объект.КассаККМ]=Неопределено, 0, НомерДокументаКассыККМ[Объект.КассаККМ]);
			НомерЧека = НомерДокКассыККМ+1;
		Иначе
			НомерЧека = НомерКассовогоЧека;	
			ЧекСформирован = Истина;
		КонецЕсли;	
		
		ОбщиеПараметры = ПодготовитьДанныеДляПросмотраЧека(НомерЧека);
		
		Если ОбщиеПараметры = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Недостаточно данных для просмотра кассового чека.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли;	
		
		Если ЧекСформирован Тогда
			ОбщиеПараметры.ДатаВремя = ДанныеЧекаДляДокумента.ДатаЧекаККМ;	
		КонецЕсли;	
		
		ВерсияФФД = ВерсияФФД(КассаККМЧека);
		
		ТекстЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 34, ВерсияФФД);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстЧека);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("ИдентификаторЗаписи", ДанныеЧекаДляДокумента.ИдентификаторЗаписи);

		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраЧекаККМ", ПараметрыФормы, , Объект,,,, Режим);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияФФД(КассаККМЧека) Экспорт
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
КонецФункции

&НаСервере
Функция НомерЧекаДляДокумента()
	Если Объект.НомерЧекаККМ<>0 Тогда
		Возврат Объект.НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Функция ДанныеЧекаДляДокумента()
	Результат = Новый Структура;
	Результат.Вставить("НомерЧекаККМ", 0);
	Результат.Вставить("ДатаЧекаККМ", Дата(1,1,1));
	Результат.Вставить("ФискальныйПризнак", "");
	Результат.Вставить("ИдентификаторЗаписи", "");
	
	Если Объект.НомерЧекаККМ<>0 Тогда
		Результат.НомерЧекаККМ = Объект.НомерЧекаККМ;
		Результат.ДатаЧекаККМ = Объект.ДатаЧекаККМ;
		
		Возврат Результат;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента(НомерЧека)
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека", ТекущаяДатаСеанса());
	ПараметрыФискализации.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыФискализации.Вставить("Организация", Объект.Организация);
	ПараметрыФискализации.Вставить("ТипРасчета", Объект.ТипРасчета);
	ПараметрыФискализации.Вставить("НомерСменыККТ", 1);
	ПараметрыФискализации.Вставить("НомерЧекаККТ", НомерЧека);
	ПараметрыФискализации.Вставить("ФискальныйПризнак", Строка(НомерЧека));
	ПараметрыФискализации.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки", "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН", "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит", "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML", Неопределено);
	
	ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	СуммаЧека = 0;
	ОплатаНаличные = 0;
	ОплатаЭлектронно = 0;
	ОплатаПостоплата = 0;
	ОплатаПредоплата = 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека", СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные", ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно", ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата", ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата", ОплатаПостоплата);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьФискальнуюОперацию(ПараметрыФискализации);

КонецПроцедуры

&НаСервере
Функция ЗаключительныйЧекИсправительный()
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);

КонецФункции

&НаКлиенте
Функция ПодготовитьДанныеДляПросмотраЧека(НомерЧека)
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
		
		Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Возврат Результат;
	КонецЕсли;	
	
	ДанныеЧека = ДанныеЧекаДляДокумента();
	Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) И ЗначениеЗаполнено(ДанныеЧека.ТекстовыеДанныеXML) Тогда
		Результат = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ДанныеЧека.ТекстовыеДанныеXML);
		
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПробитьЧекСПроверкойСтавокНДС()
	ЕстьУстаревшиеСтавкиНДС = Ложь;
	ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(Объект.Ссылка, ЕстьУстаревшиеСтавкиНДС);
	
	Если ЕстьУстаревшиеСтавкиНДС Тогда
		ТекстСообщения = НСтр("ru='При формировании кассового чека используется устаревшая ставка НДС. Прервать печать чека?'");
		Оповещение = Новый ОписаниеОповещения("ПрерватьПечатьКассовогоЧекаПриЗамечаниях", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ЭтотОбъект.Доступность = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;	
КонецПроцедуры		

&НаКлиенте
Процедура ПрерватьПечатьКассовогоЧекаПриЗамечаниях(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ЭтотОбъект.Доступность = Ложь;
			
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(ДокументПечатиЧека, ЕстьУстаревшиеСтавкиНДС)
	
	УстаревшиеСтавкиНДС = ПодключаемоеОборудованиеБГУ.УстаревшиеСтавкиНДС();
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(ДокументПечатиЧека);
	ТаблицаНоменклатуры.Свернуть("СтавкаНДС");
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если НЕ УстаревшиеСтавкиНДС.Найти(ТекСтрока.СтавкаНДС) = Неопределено Тогда
			ЕстьУстаревшиеСтавкиНДС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	ДополнительныеДанныеЧекаККМ = Новый Структура;
	ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", Объект.Ссылка);
	ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", Объект.Контрагенты[0].Контрагент);
	ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", АбонентскийНомерТелефона);
	ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ);	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(Объект.Ссылка);
	АбонентскийНомерТелефона = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭлектроннойПочты = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	ОтказПокупателяОтСохраненияДанных = ДополнительныеСведенияКассовогоЧека.ОтказПокупателяОтСохраненияДанных;
	Если Объект.ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		ОтказПокупателяОтСохраненияДанных = Объект.ОтказКлиентаОтСохраненияТелефонаEmail;
	КонецЕсли;	
	
КонецПроцедуры

