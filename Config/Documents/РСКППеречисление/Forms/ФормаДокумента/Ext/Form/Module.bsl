#Область СлужебныеПроцедурыИФункции 

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);  
	
	ДокументОснованиеЗаголовок = ?(ЗначениеЗаполнено(Объект.ДокументОснование), Объект.ДокументОснование, "<не указан>");
	
	СведенияОВалютеОбязательства = РаботаСОбязательствами.СведенияОВалютеОбязательства(Объект.Договор);
	ОплатаВРублях = СведенияОВалютеОбязательства.ОплатаВРублях;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет20800",
		БухгалтерскийУчет.СчетПоКоду("208.00", Объект.Дата, Неопределено));  
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет30401",
		БухгалтерскийУчет.СчетПоКоду("304.01", Объект.Дата, Неопределено)); 	
		
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", Неопределено);
	Если Лев(Объект.ЛицевойСчет.Код, 2) = "80" Или Лев(Объект.ЛицевойСчет.Код, 2) = "90" Тогда
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", "АУБУ"); 
		Элементы.РеквизитыДокументаОснованияДокументОснованиеВид.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ВидыДокументовОснованийЕБП");
		Элементы.РеквизитыДокументаОснованияДокументОснованиеВид.КнопкаВыбора = Истина;
	ИначеЕсли Лев(Объект.ЛицевойСчет.Код, 2) = "05"	Тогда
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ТипЛС", "ВРПБС");
		Элементы.РеквизитыДокументаОснованияДокументОснованиеВид.ОграничениеТипа = Новый ОписаниеТипов("Строка");
		Элементы.РеквизитыДокументаОснованияДокументОснованиеВид.КнопкаВыбора = Ложь;
    КонецЕсли;
	
	ДетализацияПлатежаЗаполнитьДобавленныеКолонки();  
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	УстановитьВидимостьЭлементовФормы();
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	УстановитьВидимостьВалютныхРеквизитов(ЭтотОбъект);  
	
	УстановитьСвязиПараметровВыбораДоговора();    
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы(ВыбранныйКонтрагент = Неопределено)
	
	Если Объект.НесколькоПолучателей = 0 И ВыбранныйКонтрагент = Неопределено Тогда   
		ВыбранныйКонтрагент = Объект.Контрагенты[0].Контрагент;
	КонецЕсли;   
	
	// Видимость и доступность по типу ЛС  
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НесколькоКодовБК", "Доступность", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ" И Объект.НесколькоПолучателей = 0); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НесколькоПолучателей", "Доступность", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ" И Объект.НесколькоКодовБК = 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОплатаЖКХ", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОдинКодБКПравая", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НаправлениеПлатежа", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтрокаНазначениеПлатежа", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНомераОбязательств", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НазначениеПлатежа", "ТолькоПросмотр", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДопИнформация", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");  
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаКФО", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаКОСГУНазначениеПлатежа", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаКодЦели", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");   
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаВидОбязательства", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РеквизитыДокументаОснованияРеестр", "Видимость", НЕ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС"); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РеквизитыДокументаОснованияGUIDПоступления", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС"); 
	
	
	Если Объект.НесколькоПолучателей = 0 И ЭтоФизЛицо(ВыбранныйКонтрагент) Тогда
		
		ВидимостьВозможностиПечатиЧекаККМ = Истина;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПосмотретьПредставлениеЧека", 		"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеЧекаККМ", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
		
		НомерКассовогоЧека = НомерЧекаДляДокумента();
		СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
		
		ВидимостьКнопкиПечатьЧекаККМ = Истина;
		ЕстьЗаключительныйЧекИсправительный = Ложь;
		
		Если СтатусЧекаККМПробит Тогда
			ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);
			Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
				ВидимостьКнопкиПечатьЧекаККМ = Истина;
				ЕстьЗаключительныйЧекИсправительный = Истина;
			Иначе
				ВидимостьКнопкиПечатьЧекаККМ = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 		"Видимость", ВидимостьКнопкиПечатьЧекаККМ);
		
		ВидимостьКомандККТ = ПодключаемоеОборудованиеБГУ.ВидимостьКомандККТПоТипуКассыККМ(Объект.КассаККМ);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаEmail", 											"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаSMS", 											"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтказКлиентаОтСохраненияТелефонаEmail", 		"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДанныеSMSИлиEmail", 									"Видимость", ВидимостьКомандККТ);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОчиститьEmailИSMS",								"Видимость", ВидимостьКомандККТ);
	Иначе
		ВидимостьВозможностиПечатиЧекаККМ = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПосмотретьПредставлениеЧека", 		"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеЧекаККМ", 					"Видимость", ВидимостьВозможностиПечатиЧекаККМ);  
	
	// Ограничения доступности по статусу документа
	ДоступныКлючевыеРеквизиты = УстановленныеРеквизитыИсполнения = Неопределено
	ИЛИ УстановленныеРеквизитыИсполнения.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ВРаботе")
	ИЛИ УстановленныеРеквизитыИсполнения.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкиФормы", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЛицевойСчет", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаПлатежа", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);   
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаполнитьСумму", "Доступность", ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПолучательЛевая", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПолучательПравая", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РедактироватьРеквизитыПолучателя", "Доступность", ДоступныКлючевыеРеквизиты); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОдинКодБК", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты И ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНомераОбязательств", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДопИнформация", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПризнакиПлатежа", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Примечание", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);  
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РеквизитыДокументаОснования", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОплатаЖКХ", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОсновнаяНП", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНазначениеПлатежа", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагенты", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);   
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежа", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФайлыПриложения", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НазначениеПлатежа", "ТолькоПросмотр", НЕ ДоступныКлючевыеРеквизиты ИЛИ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "АУБУ");
	
	// Открываем возможность изменения Контрагента для загруженных из ЕБП документов
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаКонтрагент", "Видимость", Объект.Внешнее ИЛИ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС = "ВРПБС");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаКонтрагентыКонтрагент", "Видимость", Объект.Внешнее); 
	
	Если НЕ ДоступныКлючевыеРеквизиты Тогда
		ДоступностьКонтрагента = УстановленныеРеквизитыИсполнения.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")
		И Объект.Внешнее 
		И Объект.НесколькоПолучателей = 0;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПолучательЛевая", "ТолькоПросмотр", НЕ ДоступностьКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовОрганизации()

	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	
	Элементы.ЛицевойСчет.Доступность 	= ДоступностьРеквизитов;
	//Элементы.Подразделение.Доступность 	= ДоступностьРеквизитов;
	Элементы.Руководитель.Доступность 	= ДоступностьРеквизитов;
	Элементы.ГлавныйБухгалтер.Доступность 	= ДоступностьРеквизитов;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()
	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация);	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаВВалютеПриИзмененииНаКлиенте()
	ЗаполнитьСуммыТабличныхЧастей();
	ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
	Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС, Объект.РасшифровкаПлатежа);
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);  
	СформироватьТекстНазначенияПлатежа();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммыТабличныхЧастей()
	Если Объект.НесколькоКодовБК = 0 ИЛИ Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
		Объект.РасшифровкаПлатежа[0].СуммаВал =  Объект.СуммаДокументаВВалюте;
	КонецЕсли;
	Если Объект.НесколькоПолучателей = 0 Тогда
		Объект.Контрагенты[0].СуммаВал =  Объект.СуммаДокументаВВалюте;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Функция СчетКонтрагетаПоУмолчанию(ВыбранныйКонтрагент) 
	
	УстановитьВидимостьЭлементовГрафикПлатежей();

	Возврат Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ВыбранныйКонтрагент, "Документ.РСКППеречисление.Контрагенты");
		
КонецФункции

