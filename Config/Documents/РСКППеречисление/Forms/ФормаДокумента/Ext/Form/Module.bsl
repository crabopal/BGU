		Отбор = Новый Структура("Организация, Контрагент", Объект.Организация, Объект.Контрагенты[0].Контрагент);
		ПараметрыФормы = Новый Структура("Отбор", Отбор); 
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.Договор);
		ОткрытьФорму("Справочник.Договоры.ФормаВыбора", ПараметрыФормы, Элемент); 
	КонецЕсли;
КонецПроцедуры

