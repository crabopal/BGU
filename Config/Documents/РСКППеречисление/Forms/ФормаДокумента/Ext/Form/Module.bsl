
#Область ОписаниеПеременных

// СтандартныеПодсистемы.РаботаСКонтрагентами
&НаКлиенте
Перем ПроверкаКонтрагентовПараметрыОбработчикаОжидания Экспорт;
&НаКлиенте
Перем ФормаДлительнойОперации Экспорт;
// Конец СтандартныеПодсистемы.РаботаСКонтрагентами 

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);   
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.Свойство("ДополнительныеПараметры") Тогда
			Если НЕ ЗначениеЗаполнено(Объект.МодульИнтеграции) И Параметры.ДополнительныеПараметры.Свойство("МодульИнтеграции") Тогда
				Объект.МодульИнтеграции = Параметры.ДополнительныеПараметры.МодульИнтеграции;
			КонецЕсли;  
			Если Параметры.ДополнительныеПараметры.Свойство("Организация") И ЗначениеЗаполнено(Параметры.ДополнительныеПараметры.Организация) Тогда
				Объект.Организация = Параметры.ДополнительныеПараметры.Организация;
			КонецЕсли;
			Если Параметры.ДополнительныеПараметры.Свойство("ЛицевойСчет") И ЗначениеЗаполнено(Параметры.ДополнительныеПараметры.ЛицевойСчет) Тогда
				Объект.ЛицевойСчет = Параметры.ДополнительныеПараметры.ЛицевойСчет;
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.НесколькоПолучателей = 0 И Объект.Контрагенты.Количество() = 0 Тогда
			СтрКонтрагент = Объект.Контрагенты.Добавить();  
			СтрКонтрагент.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		Если Объект.НесколькоКодовБК = 0 И Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
			СтрРасшифровка = Объект.РасшифровкаПлатежа.Добавить();  
			СтрРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
			ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
		Иначе
			ПриИзмененииЛицевогоСчетаНаСервере();
		КонецЕсли; 
						
		Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда 
			Объект.ВалютаДокумента = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
			Объект.Курс 			= 1;
			Объект.Кратность 		= 1;
		Иначе
			КурсКратность 			= ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
			Объект.Курс 			= КурсКратность.Курс;
			Объект.Кратность 		= КурсКратность.Кратность;
			ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
			Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС, Объект.РасшифровкаПлатежа);
		КонецЕсли; 
	 
		Объект.НомерЧекаККМ = 0;
		Объект.НомерСменыККМ = 0;
		Объект.СтатусЧекаККМ = "";
		Объект.ДокументыЧекаККМ.Очистить();
		Объект.ИсправительныйЧекККМ = "";
	    		
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	УстановитьДанныеДляПечатиЧековККМ();
	ПрочитатьДополнительныеДанныеЧековККМ();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
		
	ПлатежноРасчетныеДокументы.КорСчетЗаполнитьСписокВыбора(ЭтотОбъект);
	УчетРасчетов.УстановитьУсловноеОформлениеТаблицыРасшифровкаПлатежа(УсловноеОформление, "ДетализацияПлатежаРасшифровка", "ДетализацияПлатежа");
	
	Если ЗначениеЗаполнено(Объект.НалогСборПлатеж) Тогда
		НалоговыеНастройки = БухгалтерскийУчет.ПолучитьНастройкиВидаНалоговогоПлатежа(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.НалогСборПлатеж, "ВидНалогаИлиПлатежа"), 
			Объект.Дата, 
			Объект.Организация);
		ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем = НалоговыеНастройки.ЗаполнятьНезаполненныеНулем;
		ТаможенныйПлатеж = НалоговыеНастройки.ТаможенныйПлатеж;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(Объект));
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);
	
	УстановленнаяМаксимальнаяДлинаНазначенияПлатежа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет, "МаксДлинаНазначенияПлатежа");
	ПлатежноРасчетныеДокументы.ПриСозданииНаСервереФормыДокумента(ЭтотОбъект);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьСписокВыбораКодовДохода(Элементы.КодВидаДохода);
	
	ИнформацияОКурсеПлатежа = ИнформационнаяСтрокаОКурсеПлатежа(УстановленныеРеквизитыИсполнения); 
	
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	УстановитьВидимостьЭлементовФормы();
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереДокумент(ЭтотОбъект, Параметры);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом  
	
	НомерКартинкиМаршрут = ?(Объект.Внешнее, 2, 1);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом 
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьДоступностьРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	УстановленнаяДлинаНазначенияПлатежаКлиент();  
	УстановитьВидимостьДоступностьТаблицФормы();
	
	БухгалтерскиеОперацииКлиент.ПриОткрытии(ЭтотОбъект);
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ПриОткрытииДокумент(ЭтотОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)   
	
	СпроситьОВозможностиЗаписи(Отказ, ПараметрыЗаписи);
		
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);
	
КонецПроцедуры  

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
	
	ПлатежноРасчетныеДокументы.ПередЗаписьюНаСервереДокумента(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПередЗаписьюНаСервереДокумент(ЭтотОбъект, ТекущийОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();

	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ДетализацияПлатежаЗаполнитьДобавленныеКолонки();  
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	УстановитьВидимостьЭлементовФормы(); 
	
	ДействияСКонтактнымиДаннымиДляЧекаККМ();
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, ТекущийОбъект);
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.РасшифровкаПлатежа.Итог("СуммаВал") <> Объект.СуммаДокументаВВалюте тогда
		ТекстСообщения = НСтр("ru = 'Сумма документа не совпадает с суммой расшифровки по источникам средств'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "РасшифровкаПлатежа",, Отказ);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ПлатежноРасчетныеДокументыКлиент.ОбработатьОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "ИзмененСтатус_ПлатежноРасчетныйДокумент" И Объект.Ссылка = Источник Тогда
		ИнформацияОКурсеПлатежа = ИнформационнаяСтрокаОКурсеПлатежа(УстановленныеРеквизитыИсполнения);
	КонецЕсли;
	
	Если ИмяСобытия = "ФискальныеОперацииБГУИзменение" Тогда
		УстановитьВидимостьЭлементовФормы();
		НомерКассовогоЧека  = НомерЧекаДляДокумента();
		ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтотОбъект, НомерКассовогоЧека);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборДокументаОснованияЧекаККМ.Форма.Форма" Тогда
		ОбработкаДобавленияДокументовОснованийДляЧекаНаСервере(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ПодборПлатежейПоГрафику" Тогда
		ОбработатьПодборПоГрафикуПлатежейНаСервере(ВыбранноеЗначение);
		СуммаДокументаВВалютеПриИзмененииНаКлиенте();  
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
		УстановитьВидимостьДоступностьТаблицФормы(); 
		СформироватьТекстНазначенияПлатежа();
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииТиповойОперации(Элемент)
	
	ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

    БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКурсВалюты(Команда)

	БухгалтерскиеОперацииКлиент.ОбновитьКурсВалюты(ЭтотОбъект, Объект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииРеквизитаДополнительнойТабличнойЧасти(Элемент)

	БухгалтерскиеОперацииКлиент.ПриИзмененииРеквизитаДополнительнойТабличнойЧасти(Элемент, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтотОбъект, Команда);	

КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперации()
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НесколькоПолучателейПриИзменении(Элемент)
	
	Если Объект.НесколькоПолучателей = 1 Тогда
		Если (Объект.РасшифровкаПлатежа.Количество() > 1 ИЛИ Объект.ДетализацияПлатежа.Количество() > 1) Тогда
			Оповещение = Новый ОписаниеОповещения("ОчиститьРасшифровкуПлатежа", ЭтотОбъект, Истина);
			ПоказатьВопрос(Оповещение,
			НСтр("ru='Платеж нескольким контрагетам может быть только по одному набру реквизитов, табличная часть ""Расшифровка платежа/Детализация платежа"" будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет);
		Иначе
			ОчиститьРасшифровкуПлатежа(КодВозвратаДиалога.Да, Ложь);
		КонецЕсли;
	ИначеЕсли Объект.НесколькоПолучателей = 0 Тогда 
		Если Объект.Контрагенты.Количество() > 1 Тогда
			Оповещение = Новый ОписаниеОповещения("ОчиститьСписокКонтрагентов", ЭтотОбъект);
			ПоказатьВопрос(Оповещение,
			НСтр("ru='Табличная часть ""Получатели платежа"" будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет); 
		Иначе
			ОчиститьСписокКонтрагентов(КодВозвратаДиалога.Да, Неопределено);	
		КонецЕсли;
	КонецЕсли;   
		
КонецПроцедуры 

&НаКлиенте
Процедура НесколькоКодовБКПриИзменении(Элемент)
	Если Объект.НесколькоКодовБК = 0 Тогда
		Если (Объект.РасшифровкаПлатежа.Количество() > 1) Тогда
			Оповещение = Новый ОписаниеОповещения("ОчиститьРасшифровкуПлатежа", ЭтотОбъект, Ложь);
			ПоказатьВопрос(Оповещение,
			НСтр("ru='В табличнай части ""Расшифровка платежа"" более одной строки, таблица будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет); 
		Иначе
			ОчиститьРасшифровкуПлатежа(КодВозвратаДиалога.Да, Ложь);
		КонецЕсли;
		ОтборДляДетализацииПлатежа(Объект.РасшифровкаПлатежа[0].ИдентификаторСтроки, "ДетализацияПлатежаРасшифровка");
	ИначеЕсли Объект.НесколькоКодовБК = 1 Тогда	 
		Если Объект.Контрагенты.Количество() > 1 Тогда
			Оповещение = Новый ОписаниеОповещения("ОчиститьСписокКонтрагентов", ЭтотОбъект);
			ПоказатьВопрос(Оповещение,
			НСтр("ru='Табличная часть ""Получатели платежа"" будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет); 
		Иначе
			// Контрагент в списке один, просто установим переключатель
			Объект.НесколькоПолучателей = 0;
			ЗаполнитьСуммыТабличныхЧастей();
			ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
			УстановитьВидимостьДоступностьТаблицФормы();
			УстановитьСвязиПараметровВыбораДоговора(); 
			РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);  
			СформироватьТекстНазначенияПлатежа();
		КонецЕсли; 
		ОтборДляДетализацииПлатежа(Объект.РасшифровкаПлатежа[0].ИдентификаторСтроки, "ДетализацияПлатежаРасшифровка");
	КонецЕсли;   
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
		Если Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			
			ОбновитьКурсВалюты();
			
			Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокументаВВалюте, Объект.СтавкаНДС, Объект.РасшифровкаПлатежа);
			
			БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(Истина, Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	КонецЕсли; 
	
	Если ЭтотОбъект.КэшПараметров.ИзменилсяГодДаты Тогда
		ПлатежноРасчетныеДокументы.КорСчетЗаполнитьСписокВыбора(ЭтотОбъект);
	КонецЕсли;	
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		ДетализацияПлатежаЗаполнитьДобавленныеКолонки();
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановленнаяДлинаНазначенияПлатежаКлиент();
	УстановитьДоступностьРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
	
	ДетализацияПлатежаЗаполнитьДобавленныеКолонки();
	
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КорСчетПриИзменении(Элемент)
	
	КорСчетПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура КорСчетПриИзмененииНаСервере()
	
	Объект.ПризнакАвансовогоПлатежа = БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "206.00");
	
	Для Каждого СтрокаДокумента Из Объект.ДетализацияПлатежа Цикл
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(СтрокаДокумента,
			СтрокаДокумента.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЦикла;
	
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	ПриИзмененииЛицевогоСчетаНаСервере(Истина);
	УстановленнаяДлинаНазначенияПлатежаКлиент(); 
	УстановитьВидимостьДоступностьТаблицФормы();
