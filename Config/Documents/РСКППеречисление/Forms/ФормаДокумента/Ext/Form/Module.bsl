&НаКлиенте
Процедура ЗаполнитьРеквизитыПолучателяНаКлиенте(СтрокаТаблицы)
	
	РеквизитыПолучателя = Новый Структура;
	РеквизитыПолучателя.Вставить("СчетКонтрагента", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентНаименование", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентБанковскийСчет", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентНаименованиеБанка", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентБИКБанка", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентКорСчетБанка", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентЛицевойСчет", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентИНН", ""); 
	РеквизитыПолучателя.Вставить("КонтрагентКПП", "");
	ЗаполнитьЗначенияСвойств(РеквизитыПолучателя, СтрокаТаблицы);
	ЗаполнитьРеквизитыПолучателя(РеквизитыПолучателя); 
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РеквизитыПолучателя); 
	
	Если НЕ (ЗначениеЗаполнено(СтрокаТаблицы.КонтрагентЛицевойСчет)
			И (Лев(СтрокаТаблицы.КонтрагентЛицевойСчет, 2) = "80"
				ИЛИ Лев(СтрокаТаблицы.КонтрагентЛицевойСчет, 2) = "90")) Тогда
		СтрокаТаблицы.КодПоступленияЕБП = "";
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьРеквизитыПолучателя(РеквизитыПолучателя) 
	Документы.РСКППеречисление.ЗаполнитьРеквизитыПолучателя(РеквизитыПолучателя);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиРеквизитовПолучателя(ВыбраннаяСтрокаТаблицы)
	
	Если ВыбраннаяСтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.Контрагенты.НайтиПоИдентификатору(ВыбраннаяСтрокаТаблицы);
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежныеРеквизиты = Новый Структура;
	ПлатежныеРеквизиты.Вставить("БанковскийСчет", 	ДанныеСтроки.КонтрагентБанковскийСчет);
	ПлатежныеРеквизиты.Вставить("БИКБанка", 		ДанныеСтроки.КонтрагентБИКБанка);
	ПлатежныеРеквизиты.Вставить("КорСчетБанка", 	ДанныеСтроки.КонтрагентКорСчетБанка);
	ПлатежныеРеквизиты.Вставить("НаименованиеБанка",ДанныеСтроки.КонтрагентНаименованиеБанка);
	ПлатежныеРеквизиты.Вставить("Наименование", 	ДанныеСтроки.КонтрагентНаименование); 
	ПлатежныеРеквизиты.Вставить("ЛицевойСчет", 		ДанныеСтроки.КонтрагентЛицевойСчет); 
	ПлатежныеРеквизиты.Вставить("ИНН", 				ДанныеСтроки.КонтрагентИНН); 
	ПлатежныеРеквизиты.Вставить("КПП", 				ДанныеСтроки.КонтрагентКПП);
	Если Элементы.Контрагенты.ТолькоПросмотр Тогда
		ПлатежныеРеквизиты.Вставить("ТолькоПросмотр", Истина);
	КонецЕсли;	

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаголовокФормы", 	"Реквизиты получателя платежа"); 
	ПараметрыФормы.Вставить("КлючДанных", "Получатель");
	ПараметрыФормы.Вставить("ПлатежныеРеквизиты", 	ПлатежныеРеквизиты); 
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьРеквизитыПлательщика", ЭтотОбъект, ДанныеСтроки);
    		
	ОткрытьФорму("ОбщаяФорма.РедактированиеПлатежныхРеквизитов", ПараметрыФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьРеквизитыПлательщика(Результат, ВыбраннаяСтрока) Экспорт 
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ВыбраннаяСтрока.КонтрагентБанковскийСчет = Результат.БанковскийСчет; 
		ВыбраннаяСтрока.КонтрагентБИКБанка = Результат.БИКБанка;   
		ВыбраннаяСтрока.КонтрагентКорСчетБанка = Результат.КорСчетБанка; 
		ВыбраннаяСтрока.КонтрагентНаименованиеБанка = Результат.НаименованиеБанка; 
		ВыбраннаяСтрока.КонтрагентНаименование = Результат.Наименование;  
		ВыбраннаяСтрока.КонтрагентЛицевойСчет = Результат.ЛицевойСчет;  
		ВыбраннаяСтрока.КонтрагентИНН = Результат.ИНН; 
		ВыбраннаяСтрока.КонтрагентКПП = Результат.КПП; 
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура КодПоступленияЕБПНачалоВыбораНаКлиенте(СтрокаТаблицы, СтандартнаяОбработка)
	Если НЕ (ЗначениеЗаполнено(СтрокаТаблицы.КонтрагентЛицевойСчет)
			И (Лев(СтрокаТаблицы.КонтрагентЛицевойСчет, 2) = "80"
				ИЛИ Лев(СтрокаТаблицы.КонтрагентЛицевойСчет, 2) = "90")) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СуммаДокумента

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСуммуНДС(СуммаДокумента, СтавкаНДС, ТаблицаРасшифровка)
	
	ПроцентНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
	СуммаНДС   = Окр(СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);  
	
	Если ТаблицаРасшифровка.Количество() > 1 Тогда
		Для Каждого СтрРасшифровки Из ТаблицаРасшифровка Цикл
			СтрРасшифровки.СуммаНДС = Окр(СтрРасшифровки.Сумма * ПроцентНДС / (100 + ПроцентНДС), 2); 
		КонецЦикла;  
		Если ТаблицаРасшифровка.Итог("Сумма") = СуммаДокумента Тогда
			ТаблицаРасшифровка[0].СуммаНДС = ТаблицаРасшифровка[0].СуммаНДС + (СуммаНДС - ТаблицаРасшифровка.Итог("СуммаНДС")); 
		КонецЕсли;	
	ИначеЕсли ТаблицаРасшифровка.Количество() = 1 Тогда	
		ТаблицаРасшифровка[0].СуммаНДС = СуммаНДС;
	КонецЕсли;	
		
	Возврат СуммаНДС;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРублевоеПокрытие(Форма, Объект)
	
	Объект.СуммаДокумента 	= Объект.СуммаДокументаВВалюте*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	
	Для Каждого ДанныеСтроки Из Объект.РасшифровкаПлатежа Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	КонецЦикла; 
	Для Каждого ДанныеСтроки Из Объект.ДетализацияПлатежа Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	КонецЦикла; 
    Для Каждого ДанныеСтроки Из Объект.Контрагенты Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
	КонецЦикла; 
    	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКурсВалюты()
	
	КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
	Объект.Курс = КурсКратность.Курс;
	Объект.Кратность = КурсКратность.Кратность;
	
	ПересчитатьРублевоеПокрытие(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьВалютныхРеквизитов(Форма)
	
	Видимость = ЗначениеЗаполнено(Форма.Объект.ВалютаДокумента) 
		И НЕ Форма.Объект.ВалютаДокумента = Форма.КэшПараметров.ВалютаРегламентированногоУчета
		И Форма.ОплатаВРублях;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Курс", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Кратность", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуммаДокумента", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "РасшифровкаПлатежаСумма", "Видимость", Видимость); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДетализацияПлатежаРасшифровкаСумма", "Видимость", Видимость); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДетализацияПлатежаКонтрагентыСумма", "Видимость", Видимость);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "КонтрагентыСумма", "Видимость", Видимость);		
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ИнформацияОКурсеПлатежа", "Видимость",
		ЗначениеЗаполнено(Форма.Объект.ВалютаДокумента)
		И НЕ Форма.Объект.ВалютаДокумента = Форма.КэшПараметров.ВалютаРегламентированногоУчета
		И НЕ Форма.ОплатаВРублях);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИнформационнаяСтрокаОКурсеПлатежа(РеквизитыИсполнения)
	
	Если ЗначениеЗаполнено(РеквизитыИсполнения.ДатаПроведения) Тогда
		ТекстСообщения = НСтр("ru = 'Курс иностранной валюты: %1 (установлен при исполнении документа)'");
		ИнформацияОКурсеПлатежа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, РеквизитыИсполнения.Курс);
	Иначе
		ИнформацияОКурсеПлатежа = НСтр("ru = 'Курс иностранной валюты устанавливается при исполнении документа'");
	КонецЕсли;
	
	Возврат ИнформацияОКурсеПлатежа;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуИтогаТЧ(Форма, Объект)
	
	ИтогТаблицы = 0;
	Если Объект.НесколькоКодовБК = 1 Тогда
		ИтогТаблицы = Объект.РасшифровкаПлатежа.Итог("СуммаВал");
	ИначеЕсли Объект.НесколькоПолучателей = 1 Тогда 
		ИтогТаблицы = Объект.Контрагенты.Итог("СуммаВал");
	Иначе
		ИтогТаблицы = Объект.ДетализацияПлатежа.Итог("СуммаВал"); 
	КонецЕсли;
	
	Форма.РазницаИтогаТЧ = ИтогТаблицы - Объект.СуммаДокументаВВалюте;
	
	Форма.Элементы.РаспределеннаяСумма.Доступность = НЕ Форма.РазницаИтогаТЧ = 0;
	
КонецПроцедуры  

#КонецОбласти  

#Область НазначениеПлатежа

&НаКлиенте
Процедура УстановленнаяДлинаНазначенияПлатежаКлиент()
	ДлинаПоля = СтрДлина(СокрП(Объект.НазначениеПлатежа));
	УстановленнаяДлинаНазначенияПлатежа = " " +  Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")+ " симв., макс. " + Формат(УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧН=0; ЧГ=0") + " симв."
	+ ?(ДлинаПоля > УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, ", превышение " + Формат(ДлинаПоля - УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧГ=0") + " симв.", "");
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТекстНазначенияПлатежа() 
	
	Если НЕ ЭтотОбъект.КэшПараметров.Локальные.ТипЛС =  "ВРПБС" Тогда 
		ПлатежноРасчетныеДокументыКлиентСервер.СформироватьТекстНазначенияПлатежаРСКППеречисление(Объект, 
		Объект.РасшифровкаПлатежа, 
		Объект.Контрагенты,
		Объект.РеквизитыДокументаОснования,
		УстановленнаяМаксимальнаяДлинаНазначенияПлатежа); 
	КонецЕсли;
	
	УстановленнаяДлинаНазначенияПлатежаКлиент();
КонецПроцедуры

#КонецОбласти

#Область НалоговыеРеквизиты

&НаСервере
Процедура НалогСборПлатежПриИзмененииНаСервере()
	
	НалоговыеНастройки =  БухгалтерскийУчет.ПолучитьНастройкиНалоговогоПлатежа(Объект.НалогСборПлатеж, Истина, Объект.Дата, Объект.Организация);
	
	ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем 	= НалоговыеНастройки.ЗаполнятьНезаполненныеНулем;
	ТаможенныйПлатеж 								= НалоговыеНастройки.ТаможенныйПлатеж;
	ПолеВводаСтатусСоставителя 						= НалоговыеНастройки.СтатусСоставителя;
	ПолеВводаПоказательОснования 					= НалоговыеНастройки.ПоказательОснования;
	ПолеВводаПоказательПериода 						= НалоговыеНастройки.ПоказательПериода;
	ПолеВводаПоказательТипа 						= НалоговыеНастройки.ПоказательТипа;

	Объект.ОчередностьПлатежа						= НалоговыеНастройки.ОчередностьПлатежа;
    Объект.КодБКНалога								= НалоговыеНастройки.КодБКНалога;
	Объект.КодОКАТО 								= БухгалтерскийУчетКлиентСервер.ОКАТООКТМОПоДате(Объект.Дата, НалоговыеНастройки.КодОКАТО, НалоговыеНастройки.КодОКТМО);

	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(НалоговыеНастройки)); 

    ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода"); 
	ЗначенияРеквизитов.Вставить("ПолеВводаКодТаможенногоОргана", НалоговыеНастройки.КодТаможенногоОргана);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);

    БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);
	Если ЗначениеЗаполнено(Объект.НалогСборПлатеж) Тогда    	
		БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, ,ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);
	КонецЕсли;
	
	// Контрагент и договор
	Если ЗначениеЗаполнено(НалоговыеНастройки.Контрагент) Тогда
		Если Объект.НесколькоПолучателей = 0 Тогда
			Объект.Контрагенты.Очистить();
			СтрКонтрагент = Объект.Контрагенты.Добавить();  
			СтрКонтрагент.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			СтрКонтрагент.Контрагент = НалоговыеНастройки.Контрагент; 
			СтрКонтрагент.СчетКонтрагента = НалоговыеНастройки.СчетКонтрагента;
			Документы.РСКППеречисление.ЗаполнитьРеквизитыПолучателя(СтрКонтрагент);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
	
	Если ЗначениеЗаполнено(Объект.НалогСборПлатеж) Тогда
		БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте(ПересчитатьНомерПериода = Ложь)
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов, ПересчитатьНомерПериода);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);  
	Если ЗначениеЗаполнено(Объект.НалогСборПлатеж) Тогда
		БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, Объект[ИмяПоказателя]);
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));

	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область КонтрольИсполненияДоговоров   

&НаСервере
Функция КонтрольДокументаПоОбязательствамСервер(Адрес)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Ложь, ТекущийОбъект, Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись), ЭтотОбъект);
	
	КонтрольРасходов.Контроль(ТекущийОбъект, Ложь,, Истина, Адрес);
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОстаткамЗадолженностиНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоОстаткамЗадолженности();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ДетализацияПлатежаЗаполнитьДобавленныеКолонки();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор)
	
	Возврат КонтрольИсполненияДоговоров.СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьПодборПоГрафикуПлатежей(ОтменитьПроведениеДокумента)
	
	Если ОтменитьПроведениеДокумента Тогда
		ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
		ЭтотОбъект.Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура("Организация,ИФО,Контрагент,Договор");
	ЗаполнитьЗначенияСвойств(ПараметрыПодбора, Объект);
	ПараметрыПодбора.Контрагент = Объект.Контрагенты[0].Контрагент;
	ПараметрыПодбора.Вставить("СчетРасчетов", Объект.КорСчет);
	ПараметрыПодбора.Вставить("ЭтоПоступление", Ложь);
	
	ПараметрыФормы = Новый Структура("ПараметрыПодбора, ТолькоПросмотр",
		ПараметрыПодбора, ТолькоПросмотр);
	ОткрытьФорму("ОбщаяФорма.ПодборПлатежейПоГрафику", ПараметрыФормы, ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборПоГрафикуПлатежейНаСервере(АдресВыбранныхПлатежейВХранилище)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	КонтрольИсполненияДоговоров.ОбработатьПодборПлатежейПоГрафику(ДокументОбъект, АдресВыбранныхПлатежейВХранилище);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ДетализацияПлатежаЗаполнитьДобавленныеКолонки();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	РассчитатьРазницуИтогаТЧ(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовГрафикПлатежей()   
	
	Если Объект.НесколькоПолучателей = 1 ИЛИ Объект.Внешнее Тогда 
		ВидимостьЭлементовГрафикаПлатежей = Ложь;
	Иначе  
		ВидимостьЭлементовГрафикаПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И КонтрольИсполненияДоговоров.ВедетсяГрафикПлатежейПоДоговору(Объект.Договор)
		И КонтрольИсполненияДоговоров.ВедетсяГрафикПлатежейПоСчетуРасчетов(Объект.КорСчет, Ложь);
	КонецЕсли;
	ВидимостьВидРасчетовБезГрафикаПлатежей = НЕ ВидимостьЭлементовГрафикаПлатежей И БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "301.00");
    	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("ДетализацияПлатежаРасшифровкаВидРасчетов");
	ЭлементыГрафикПлатежей.Добавить("ДетализацияПлатежаРасшифровкаОплатитьДо");
	ЭлементыГрафикПлатежей.Добавить("ДетализацияПлатежаРасшифровкаПодборПоГрафикуПлатежей");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГрафикПлатежей, "Видимость", ВидимостьЭлементовГрафикаПлатежей);
	
	// По кредитным договорам без графика платежей показываем только вид расчетов в отдельной колонке.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДетализацияПлатежаРасшифровкаВидРасчетовБезГрафикаПлатежей", "Видимость", ВидимостьВидРасчетовБезГрафикаПлатежей);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));  
	
	//Заплатка
	Если Объект.НесколькоПолучателей = 1 Тогда 
		Элементы.ГруппаКонтрольИсполнения.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовРасчеты() 
	
	Если Объект.НесколькоПолучателей = 1 Или Объект.Внешнее Тогда 
		ИспользуетсяНастройкаПогашенияЗадолженности = Ложь;
		ВидимостьКомандыЗаполнитьПоОстаткамЗадолженности = Ложь;
	Иначе  
		ИспользуетсяНастройкаПогашенияЗадолженности = УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет);
		ВидимостьКомандыЗаполнитьПоОстаткамЗадолженности = ИспользуетсяНастройкаПогашенияЗадолженности
		ИЛИ БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "208.00")
		ИЛИ БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "301.00");
	КонецЕсли;	
	
	НастройкаПогашенияЗадолженности = Новый Массив;
	НастройкаПогашенияЗадолженности.Добавить("ДетализацияПлатежаРасшифровкаСчетРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("ДетализацияПлатежаРасшифровкаСпособПогашенияЗадолженности");
	НастройкаПогашенияЗадолженности.Добавить("ДетализацияПлатежаРасшифровкаДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		НастройкаПогашенияЗадолженности, "Видимость", ИспользуетсяНастройкаПогашенияЗадолженности);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаРасшифровкаКомандаЗаполнитьПоОстаткамЗадолженности", 
		"Видимость", ВидимостьКомандыЗаполнитьПоОстаткамЗадолженности);
	
КонецПроцедуры

#КонецОбласти

