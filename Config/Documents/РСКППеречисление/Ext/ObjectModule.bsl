#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)  
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		Документы.РСКППеречисление.ЗаполнитьНаОснованииВедомостиКомпенсацииРодительскойПлатыКВыплате(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда  
		Документы.РСКППеречисление.ЗаполнитьНаОснованииВедомостиНаВыплатуВБанк(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);	
				
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СведенияОДенежномОбязательстве") Тогда
		
		ДокументТМЦ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ПодтверждающийДокумент");
		
		Если НЕ Метаданные.Документы.РСКППеречисление.ВводитсяНаОсновании.Содержит(ДокументТМЦ.Метаданные()) Тогда
			ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='Ввод на основании денежного обязательства, принятого по документу %1 невозможен!'"),
									ДокументТМЦ.Метаданные().Синоним);
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		Документы.РСКППеречисление.ЗаполнитьПоДенежномуОбязательству(ЭтотОбъект, ДанныеЗаполнения, ДокументТМЦ);
		
		ДокументОснование = ДанныеЗаполнения;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") ИЛИ
		ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗВПути") ИЛИ
		ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеОС") ИЛИ
		ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеОСВПути") ИЛИ
		ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеУслугРабот") ИЛИ
		ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		
		ДокументДО = Документы.СведенияОДенежномОбязательстве.ДенежноеОбязательствоПоДокументуТМЦ(ДанныеЗаполнения);
		
		Документы.РСКППеречисление.ЗаполнитьПоДенежномуОбязательству(ЭтотОбъект, ДокументДО, ДанныеЗаполнения); 
		
		ДокументОснование = ДанныеЗаполнения;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявлениеНаВыдачуАванса") Тогда
		
		Документы.РСКППеречисление.ЗаполнитьНаОснованииЗаявленияНаВыдачуАванса(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОКомандировании") Тогда
		
		Документы.РСКППеречисление.ЗаполнитьНаОснованииРешенияОКомандировании(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
		
		Документы.РСКППеречисление.ЗаполнитьНаОснованииРешенияОКомпенсации(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		
		Документы.РСКППеречисление.ЗаполнитьНаОснованииЗаявкиОбоснования(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
		
		Документы.РСКППеречисление.ЗаполнитьНаОснованииОтчетаОРасходахПодотчетногоЛица(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Отказ = ПлатежноРасчетныеДокументы.ВыполнитьДвиженияПлатежноРасчетногоДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	// Очистка табличной части ДетализацияПлатежа от строк, не имеющих "родителя" в ТЧ 
	// РасшифровкаПлатежа или Контрагенты
	// Синхронизация общих реквизитов табличных частей
	// 
	ИсключитьКПС = "";
	ИсключитьКПСДоп = "";
	Если НесколькоКодовБК = 1 Тогда
		РодительскаяТаблица = РасшифровкаПлатежа;
		ДопРодительскаяТаблица = Контрагенты;
		ИсключитьКПС = ",КБКНазначениеПлатежа,КодЦели";
	ИначеЕсли НесколькоПолучателей = 1 Тогда
		РодительскаяТаблица = Контрагенты; 
		ДопРодительскаяТаблица = РасшифровкаПлатежа; 
		ИсключитьКПСДоп = ",КБКНазначениеПлатежа,КодЦели";
	ИначеЕсли РасшифровкаПлатежа.Количество() > 0 Тогда
		РодительскаяТаблица = РасшифровкаПлатежа;
		ДопРодительскаяТаблица = Контрагенты; 
		ИсключитьКПС = ",КБКНазначениеПлатежа,КодЦели";
	КонецЕсли;  
	
	ЛишниеСтроки = Новый Массив;
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаСостава = РодительскаяТаблица.Найти(СтрокаРасшифровки.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаСостава,, "Сумма,СуммаВал" + ИсключитьКПС);
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, ДопРодительскаяТаблица[0],, "Сумма,СуммаВал,ИдентификаторСтроки" + ИсключитьКПСДоп);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ДетализацияПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;	 
	
	Если Контрагенты.Количество() = 1 Тогда
		КонтрагентДокумента = Контрагенты[0].Контрагент;  
	Иначе
		КонтрагентДокумента = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;	 
		
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда   
		
		ТекстСообщения = НСтр("ru='Проведение невозможно.'"); 
		НельзяПровести = Ложь;
		
		Для Каждого СтрокаРасшифровки Из РодительскаяТаблица Цикл
			Состав = ДетализацияПлатежа.Выгрузить(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
			Если НЕ Состав.Итог("СуммаВал") = СтрокаРасшифровки.СуммаВал Тогда  
				НельзяПровести = Истина;
				ТекстСообщения = ТекстСообщения + "
				|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В строке %1 сумма расшифровки не равна сумме детализации платежа. Не распределена сумма: %2'"),
				СтрокаРасшифровки.НомерСтроки, Формат((СтрокаРасшифровки.СуммаВал - Состав.Итог("СуммаВал")),"ЧДЦ=2"));
			КонецЕсли;  
		КонецЦикла;
		Если НЕ СуммаДокументаВВалюте = РодительскаяТаблица.Итог("СуммаВал") Тогда
			НельзяПровести = Истина;
			ТекстСообщения = ТекстСообщения + "
			|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: %1'"),
			Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2"));
		КонецЕсли;	
		
		Если НельзяПровести Тогда  
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = Неопределено;   
	ДатаРСКП = "";
	НомерРСКП = "";
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла;  
	
	// Очистим таблицу вложенных файлов
	ФайлыПриложения.Очистить(); 
	
	// Может копироваться некорректный документ, надо очистить таблицы документа
	Для Каждого Стр Из РасшифровкаПлатежа Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ИдентификаторСтроки) Тогда
			РасшифровкаПлатежа.Очистить();
			ДетализацияПлатежа.Очистить();
			Контрагенты.Очистить();
			НесколькоКодовБК = 0;
			НесколькоПолучателей = 0;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Внешнее = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента  

// Заполняет документ остатками задолженности к погашению.
//
Процедура ЗаполнитьПоОстаткамЗадолженности() Экспорт
	
	Если Внешнее ИЛИ НесколькоПолучателей = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	ДетализацияПлатежа.Очистить();  
	
	ТаблицаДетализации = ДетализацияПлатежа.Выгрузить();
	ТаблицаДетализации.Колонки.Удалить("ИдентификаторСтроки"); 
	ТаблицаДетализации.Колонки.Удалить("РазделЛС");
	
	ПлатежноРасчетныеДокументы.ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(
		ТаблицаДетализации, ЭтотОбъект, Контрагенты[0].Контрагент); 
	
	ПлатежиПоКБК = ТаблицаДетализации.Скопировать();
	ПлатежиПоКБК.Свернуть("КФО,КБКНазначениеПлатежа,КодЦели", "Сумма,СуммаВал");
			
	Для Каждого ПлатежПоБК Из ПлатежиПоКБК Цикл
			
			СтрРасшифровка = РасшифровкаПлатежа.Добавить(); 
			СтрРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
			СтрРасшифровка.РазделЛС = ПлатежноРасчетныеДокументы.РазделЛСПоКодуПоступленияИлиКФО(ЛицевойСчет, Дата,, ПлатежПоБК.КФО);
			ЗаполнитьЗначенияСвойств(СтрРасшифровка, ПлатежПоБК); 
						
			СтрокиДетализации = ТаблицаДетализации.НайтиСтроки(Новый Структура("КФО, КБКНазначениеПлатежа, КодЦели", 
				ПлатежПоБК.КФО, ПлатежПоБК.КБКНазначениеПлатежа, ПлатежПоБК.КодЦели)); 
			
			Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
				НовСтр = ДетализацияПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СтрРасшифровка); 
				ЗаполнитьЗначенияСвойств(НовСтр, СтрокаДетализации); 
			КонецЦикла;	      
	КонецЦикла;		
	
	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		СтрРасшифровка = РасшифровкаПлатежа.Добавить(); 
		СтрРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
	КонецЕсли;		
	
	НесколькоКодовБК = ?(РасшифровкаПлатежа.Количество() > 1, 1, 0); 
	СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал");
	СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
