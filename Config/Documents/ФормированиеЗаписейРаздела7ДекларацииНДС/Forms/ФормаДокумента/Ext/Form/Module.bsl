Процедура ПриИзмененииДатыСервер()
	
	ИнициализироватьСтруктуруУчетнойПолитики();
	
	УстановитьФункциональныеОпцииФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		РассчитатьГрафы3и4Клиент(Ложь);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		РассчитаныГрафы3и4Прямой = Истина;
		РассчитанаГрафа4Распределенный = Истина;
		НастроитьИндикаторТребуетсяПересчет(ЭтаФорма);
		
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстКоличествоСтрокДляПереноса(Текст, КоличествоСтрокДляПереноса)
	Массив = ПолучитьСклоненияСтрокиПоЧислу(Текст,КоличествоСтрокДляПереноса,,,"ПД=Винительный");
	Возврат Массив[0];
КонецФункции

&НаКлиенте
Процедура ВопросПеренестиЛишниеСтрокиТЧВДругойДокумент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиЛишниеСтрокиТЧВДругойДокумент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПеренестиЛишниеСтрокиТЧВДругойДокумент(ДополнительныеПараметры)
	
	Если ПеренестиЛишниеСтрокиТЧВДругойДокументНаСервере(ДополнительныеПараметры) Тогда
		
		ПоказатьОповещениеПользователя(НСтр("ru = 'Создание:'"),,
			ТекстКоличествоСтрокДляПереноса("последняя строка",ДополнительныеПараметры.КоличествоСтрокДляПереноса)+
			НСтр("ru = ' табличных частей перенесли успешно.'"),
			БиблиотекаКартинок.Информация32,
			СтатусОповещенияПользователя.Информация);
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = ' Не удалось создать новый документ для переноса строк табличных частей.'");
		Сообщение.Сообщить();
		
	КонецЕсли;

	
КонецПроцедуры

&НаСервере
Функция ПеренестиЛишниеСтрокиТЧВДругойДокументНаСервере(ДополнительныеПараметры)
	
	РежимЗаписи = ДополнительныеПараметры.РежимЗаписи;
	
	ИндексПоследнийСтроки = Объект.НеоблагаемыеНДСОперации.Количество()-1;
	МаксимальноеКоличествоСтрок = ДополнительныеПараметры.МаксимальноеКоличествоСтрок;
	КоличествоСтрокДляПереноса = ДополнительныеПараметры.КоличествоСтрокДляПереноса;
	
	ИндексСтроки = 0;
	СтрокиДляУдаленияНеоблагаемыеНДСОперации = Новый Массив;
	СтрокиДляУдаленияПодтверждающиеДокументы = Новый Массив;
	
	НачатьТранзакцию();
	
	Попытка
		
		КоличествоСтрокТЧ = 0;
		
		Пока ИндексСтроки < КоличествоСтрокДляПереноса Цикл
			
			Если КоличествоСтрокТЧ = 0 Тогда
				НовыйДокументОбъект = Документы.ФормированиеЗаписейРаздела7ДекларацииНДС.СоздатьДокумент();
				НовыйДокументОбъект.Дата = Объект.Дата;
				НовыйДокументОбъект.Организация = Объект.Организация;
				НовыйДокументОбъект.Ответственный = Объект.Ответственный;
			КонецЕсли;
			
			СтрокаНеоблагаемыеНДСОперацииНовогоДокумента = НовыйДокументОбъект.НеоблагаемыеНДСОперации.Добавить();
			СтрокаНеоблагаемыеНДСОперацииТекущегоДокумента = Объект.НеоблагаемыеНДСОперации[ИндексПоследнийСтроки - ИндексСтроки];
			СтрокиДляУдаленияНеоблагаемыеНДСОперации.Добавить(СтрокаНеоблагаемыеНДСОперацииТекущегоДокумента);
			ЗаполнитьЗначенияСвойств(СтрокаНеоблагаемыеНДСОперацииНовогоДокумента,СтрокаНеоблагаемыеНДСОперацииТекущегоДокумента);
			
			КлючПоиска = Новый Структура("КлючСтроки", СтрокаНеоблагаемыеНДСОперацииТекущегоДокумента.КлючСтроки);
			МассивСтрокТовары = Объект.ПодтверждающиеДокументы.НайтиСтроки(КлючПоиска);
			
			Для каждого СтрокаТЧ Из МассивСтрокТовары Цикл
				СтрокаПодтверждающиеДокументыНовогоДокумента = НовыйДокументОбъект.ПодтверждающиеДокументы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПодтверждающиеДокументыНовогоДокумента,СтрокаТЧ);
				СтрокиДляУдаленияПодтверждающиеДокументы.Добавить(СтрокаТЧ);
			КонецЦикла;
			
			КоличествоСтрокТЧ = КоличествоСтрокТЧ + 1;
			
			ИндексСтроки = ИндексСтроки + 1;
			
			Если КоличествоСтрокТЧ = МаксимальноеКоличествоСтрок
				ИЛИ ИндексСтроки = КоличествоСтрокДляПереноса Тогда
				НовыйДокументОбъект.Записать(РежимЗаписи);
				КоличествоСтрокТЧ = 0;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаНеоблагаемыеНДСОперации Из СтрокиДляУдаленияНеоблагаемыеНДСОперации Цикл
			Объект.НеоблагаемыеНДСОперации.Удалить(СтрокаНеоблагаемыеНДСОперации);
		КонецЦикла;
			
		Для каждого СтрокаПодтверждающиеДокументы Из СтрокиДляУдаленияПодтверждающиеДокументы Цикл
			Объект.ПодтверждающиеДокументы.Удалить(СтрокаПодтверждающиеДокументы);
		КонецЦикла;
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.Записать(РежимЗаписи);
		
	Исключение
		
		ОтменитьТранзакцию();
		Возврат Ложь;
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	ЭтаФорма.Прочитать();
	
	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьИндикаторТребуетсяПересчет(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ГруппаТребуетсяПересчет.ТекущаяСтраница = ?(Форма.РассчитаныГрафы3и4Прямой И Форма.РассчитанаГрафа4Распределенный,
		Элементы.ГруппаТребуетсяПересчетСкрыто,
		Элементы.ГруппаТребуетсяПересчетПоказано);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОНеуказанииПодтверждающихДокументов()
	
	ПоказатьПредупреждение(,
		НСтр("ru='Указанный в текущей строке код операции не включается в реестр подтверждающих документов, поэтому список документов не редактируется.'"));
	
КонецПроцедуры

// Расчет граф 3 и 4

&НаКлиенте
Процедура ПроверитьПередРасчетомГраф3и4(Отказ)
	
	Если ПрименяетсяУСНбезЗаполненияГраф3И4(НастройкиУчетаНДС) Тогда
		Отказ = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Учреждение применяет УСН и налоговую ставку НДС %1.
			|В таком случае графы 3 и 4 не заполняются.'"),
			НастройкиУчетаНДС.СтавкаНДСПоУмолчаниюПриУСН);
		
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТребуетсяЗаполнениеГраф3И4(КодОперации, ЭтоКодСт149НКРФ, ЭтоПравилаЗаполненияДекларацииС4кв2020,
		КодыРеализацийНеНаТерриторииРФ, НастройкиУчетаНДС)
	
	Если Не ЗначениеЗаполнено(КодОперации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПрименяетсяУСНбезЗаполненияГраф3И4(НастройкиУчетаНДС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоРеализацияНаТерриторииРФ = (КодыРеализацийНеНаТерриторииРФ.Найти(КодОперации) = Неопределено);
	
	Возврат ЭтоРеализацияНаТерриторииРФ
		Или (ЭтоКодСт149НКРФ И Не ЭтоПравилаЗаполненияДекларацииС4кв2020);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрименяетсяУСНбезЗаполненияГраф3И4(НастройкиУчетаНДС)
	
	УчетнаяПолитика = НастройкиУчетаНДС.УчетнаяПолитика;
	
	Возврат УчетнаяПолитика.ПрименяетсяУСН
		И (УчетнаяПолитика.СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ПониженнаяУСН")
			Или УчетнаяПолитика.СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ОбщаяУСН"));
	
КонецФункции

&НаСервере
Процедура ОчиститьНеиспользуемыеПоказателиСтроки(ИдСтроки)
	
	ТекДанные = Объект.НеоблагаемыеНДСОперации.НайтиПоИдентификатору(ИдСтроки);
	
	Если Не ТекДанные.ТребуетсяЗаполнениеГраф3И4 Тогда
		ОчищающаяСтруктура = Новый Структура("
			|СуммаПриобретения,
			|НДСПрямой,
			|НДСРаспределенный");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		
		ОбновитьИтогиВПодвале(ЭтотОбъект);
	КонецЕсли;
	
	Если Не ТекДанные.ВключаетсяВРеестр Тогда
		Поиск = Новый Структура("КлючСтроки", ТекДанные.КлючСтроки);
		
		МассивСтрок = Объект.ПодтверждающиеДокументы.НайтиСтроки(Поиск);
		
		Для Каждого УдаляемаяСтрока Из МассивСтрок Цикл
			Объект.ПодтверждающиеДокументы.Удалить(УдаляемаяСтрока);
		КонецЦикла;
		
		ТекДанные.ПодтверждающиеДокументыПредставление = "<...>";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСуммРеализацииДляЗаполненияГраф3и4()
	
	Поиск = Новый Структура("ТребуетсяЗаполнениеГраф3И4", Истина);
	
	МассивСуммРеализации = Объект.НеоблагаемыеНДСОперации.Выгрузить(Поиск, "СуммаРеализации").ВыгрузитьКолонку("СуммаРеализации");
	
	Для Индекс = 0 По МассивСуммРеализации.ВГраница() Цикл
		Если МассивСуммРеализации[Индекс] < 0 Тогда
			МассивСуммРеализации[Индекс] = -МассивСуммРеализации[Индекс];
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивСуммРеализации;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьГрафы3и4Клиент(ЗадатьВопрос = Истина)
	
	Если Объект.НеоблагаемыеНДСОперации.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("РассчитатьГрафы3и4_Завершение", ЭтотОбъект);
	
	Если ЗадатьВопрос Тогда
		ПоказатьВопрос(Оповещение, НСтр("ru='Рассчитать графы 3 и 4 пропорционально суммам реализации?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьГрафы3и4_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РезультатЗадания = ПолучитьЗаполнениеГраф3и4Сервер();
	
	Если РезультатЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияГраф3и4Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗаполнениеГраф3и4Сервер()
	
	ШапкаДокумента = Новый Структура("Дата,Организация,Ссылка");
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	
	МассивКоэффициентов = ПолучитьМассивСуммРеализацииДляЗаполненияГраф3и4();
	
	Если МассивКоэффициентов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение граф 3 и 4'");
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента", ШапкаДокумента);
	ПараметрыПроцедуры.Вставить("МассивКоэффициентов", МассивКоэффициентов);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.ФормированиеЗаписейРаздела7ДекларацииНДС.СформироватьГрафы3и4",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияГраф3и4Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		РассчитатьГрафы3и4Сервер(Результат.АдресРезультата);
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При расчете граф 3 и 4 возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьГрафы3и4Сервер(АдресРезультата)
	
	Документы.ФормированиеЗаписейРаздела7ДекларацииНДС.РассчитатьГрафы3и4(Объект, АдресРезультата);
	
	РассчитаныГрафы3и4Прямой = Истина;
	РассчитанаГрафа4Распределенный = Истина;
	НастроитьИндикаторТребуетсяПересчет(ЭтаФорма);
	
	ОбновитьИтогиВПодвале(ЭтаФорма);
	
КонецПроцедуры

