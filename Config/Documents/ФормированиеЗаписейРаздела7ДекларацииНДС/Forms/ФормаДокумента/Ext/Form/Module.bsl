Функция ПолучитьЗаполнениеГрафы4РаспределенныйСервер()
	
	ШапкаДокумента = Новый Структура("Дата,Организация,Ссылка");
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	
	МассивКоэффициентов = ПолучитьМассивСуммРеализацииДляЗаполненияГраф3и4();
	
	Если МассивКоэффициентов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение графы 4-распределенный'");
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента", ШапкаДокумента);
	ПараметрыПроцедуры.Вставить("МассивКоэффициентов", МассивКоэффициентов);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Документы.ФормированиеЗаписейРаздела7ДекларацииНДС.СформироватьГрафу4Распределенный",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияГрафы4РаспределенныйКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		РассчитатьГрафу4РаспределенныйСервер(Результат.АдресРезультата);
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При расчете графы 4-распределенный возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьГрафу4РаспределенныйСервер(АдресРезультата)
	
	Документы.ФормированиеЗаписейРаздела7ДекларацииНДС.РассчитатьГрафу4Распределенный(Объект, АдресРезультата);
	
	РассчитанаГрафа4Распределенный = Истина;
	НастроитьИндикаторТребуетсяПересчет(ЭтаФорма);
	
	ОбновитьИтогиВПодвале(ЭтаФорма);
	
КонецПроцедуры

// Расшифровка граф 3 и 4-прямой

&НаКлиенте
Процедура РасшифроватьГрафы3и4ПрямойКлиент()
	
	РезультатЗадания = ПолучитьРасшифровкуГрафы3и4ПрямойСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеПолученияРасшифровкиГрафы3и4ПрямойКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРасшифровкуГрафы3и4ПрямойСервер()
	
	ШапкаДокумента = Новый Структура("Дата,Организация");
