// Заполнение графы 4-распределенный

Процедура РассчитатьГрафу4Распределенный(ДокументОбъект, АдресХранилища) Экспорт
	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	МассивГрафа4Распределенный = Результат.МассивГрафа4Распределенный;
	
	ТабличнаяЧасть = ДокументОбъект.НеоблагаемыеНДСОперации;
	
	КоличествоСтрок = ТабличнаяЧасть.Количество();
	
	Если МассивГрафа4Распределенный.Количество() > КоличествоСтрок Тогда
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("НДСРаспределенный", 0);
	
	ИндексМассива = -1;
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТабличнаяЧасть[НомерСтроки - 1];
		
		Если Не СтрокаТаблицы.ТребуетсяЗаполнениеГраф3И4 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
			
			Продолжить;
		КонецЕсли;
		
		ИндексМассива = ИндексМассива + 1;
		
		СтрокаТаблицы.НДСРаспределенный = МассивГрафа4Распределенный[ИндексМассива];
	КонецЦикла;
	
КонецПроцедуры

