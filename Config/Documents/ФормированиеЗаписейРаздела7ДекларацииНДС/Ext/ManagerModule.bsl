	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыПоступления
	|		ПО ЖурналПроводокЕПСБУ.Регистратор = ДокументыПоступления.Ссылка
	|		И ЖурналПроводокЕПСБУ.СчетКт В(&СчетаРезерва)
	|		И ЖурналПроводокЕПСБУ.Сумма > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Искомые документы поступления
	|//
	|ВЫБРАТЬ
	|	Ссылка			КАК Ссылка,
	|	СуммаБезНДС		КАК	СуммаБезНДС,
	|	СуммаНДС		КАК СуммаНДС
	|ИЗ
	|	ДокументыПоступления
	|ГДЕ
	|	НЕ Ссылка В(ВЫБРАТЬ Ссылка ИЗ ИсключаемыеДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;";
	
	ТаблицаДокументовПоступления = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ПересчитатьВРубли(ТаблицаДокументовПоступления);
	КонецЕсли;
	
    Возврат ТаблицаДокументовПоступления;
	
КонецФункции

Процедура ПересчитатьВРубли(ТаблицаДокументовПоступления)
	
	ВремТаблица = ТаблицаДокументовПоступления.Скопировать(, "Ссылка");
	ВремТаблица.Свернуть("Ссылка");
	МассивСсылок = ВремТаблица.ВыгрузитьКолонку("Ссылка");
	
	ТаблицаКурсКратность = УчетНДСРаздельный.ПолучитьТаблицуКурсКратностьДокументов(МассивСсылок);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументовПоступления Цикл
		КурсКратность = УчетНДСРаздельный.ПолучитьКурсКратностьДокумента(ТаблицаКурсКратность, СтрокаТаблицы.Ссылка);
		
		Если КурсКратность.Курс = 1 И КурсКратность.Кратность = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.СуммаБезНДС	= Окр(СтрокаТаблицы.СуммаБезНДС * КурсКратность.Курс / КурсКратность.Кратность, 2);
		СтрокаТаблицы.СуммаНДС		= Окр(СтрокаТаблицы.СуммаНДС * КурсКратность.Курс / КурсКратность.Кратность, 2);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИтогиДокументовПоступления(ШапкаДокумента)
	
	ТаблицаДокументов = ПолучитьТаблицуДокументовПоступления(ШапкаДокумента);
	
	Итоги = Новый Структура();
	Итоги.Вставить("СуммаБезНДС",	ТаблицаДокументов.Итог("СуммаБезНДС"));
	Итоги.Вставить("СуммаНДС",		ТаблицаДокументов.Итог("СуммаНДС"));
	
	Возврат Итоги;
	
КонецФункции

// Заполнение графы 4-распределенный

Функция ПолучитьТаблицуДокументовВключенияВСтоимость(ШапкаДокумента)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",	ШапкаДокумента.Организация);
	ЗапросПоиск.УстановитьПараметр("МоментВремени",	Новый МоментВремени(ШапкаДокумента.Дата, ШапкаДокумента.Ссылка));
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	СуммаНДСНеПодлежащаяВычетуОстаток	КАК СуммаНДС
	|ИЗ
	|	РегистрНакопления.НДСНеоблагаемыеОперации.Остатки(
	|		&МоментВремени,
	|		Организация = &Организация
	|		И КодОперации = ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)
	|	)
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьИтогиДокументовВключенияВСтоимость(ШапкаДокумента)
	
	ТаблицаДокументов = ПолучитьТаблицуДокументовВключенияВСтоимость(ШапкаДокумента);
	
	Итоги = Новый Структура();
	Итоги.Вставить("СуммаНДС", ТаблицаДокументов.Итог("СуммаНДС"));
	
	Возврат Итоги;
	
КонецФункции

// Расшифровка граф 3 и 4-прямой

Функция ПолучитьТабличныйДокументРасшифровкиГрафы3и4Прямой(ТаблицаДокументов)
	
	ТабДокумент = Новый ТабличныйДокумент();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПараметрыПечати_ФормированиеЗаписейРаздела7ДекларацииНДС_РасшифровкаГраф3и4";
	
	Макет = ПолучитьМакет("РасшифровкаГраф3и4");
	
	Области = Новый Структура();
	
	Области.Вставить("ЗаголовокВсего",	Макет.ПолучитьОбласть("ЗаголовокВсего"));
	Области.Вставить("ШапкаТаблицы",	Макет.ПолучитьОбласть("ШапкаТаблицы"));
	Области.Вставить("СтрокаТаблицы",	Макет.ПолучитьОбласть("СтрокаТаблицы"));
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Сумма3", ТаблицаДокументов.Итог("СуммаБезНДС"));
	ЗначенияПараметров.Вставить("Сумма4", ТаблицаДокументов.Итог("СуммаНДС"));
	
	Области.ЗаголовокВсего.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ЗаголовокВсего);
	
	ТабДокумент.Вывести(Области.ШапкаТаблицы);
	
	НПП = 0;
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		
		НПП = НПП + 1;
		
		ЗначенияПараметров.Вставить("НПП",		НПП);
		ЗначенияПараметров.Вставить("Ссылка",	СтрокаТаблицы["Ссылка"]);
		ЗначенияПараметров.Вставить("Сумма3",	СтрокаТаблицы["СуммаБезНДС"]);
		ЗначенияПараметров.Вставить("Сумма4",	СтрокаТаблицы["СуммаНДС"]);
		
		Области.СтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(Области.СтрокаТаблицы);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

// Расшифровка графы 4-распределенный

Функция ПолучитьТабличныйДокументРасшифровкиГрафы4Распределенный(ТаблицаДокументов)
	
	ТабДокумент = Новый ТабличныйДокумент();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПараметрыПечати_ФормированиеЗаписейРаздела7ДекларацииНДС_РасшифровкаГрафы4Распределенный";
	
	Макет = ПолучитьМакет("РасшифровкаГрафы4Распределенный");
	
	Области = Новый Структура();
	
	Области.Вставить("ЗаголовокВсего", Макет.ПолучитьОбласть("ЗаголовокВсего"));
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Сумма4", ТаблицаДокументов.Итог("СуммаНДС"));
	
	Области.ЗаголовокВсего.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ЗаголовокВсего);
	
	Возврат ТабДокумент;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("СформироватьГрафу4Распределенный", Истина);
	Методы.Вставить("СформироватьГрафы3и4", Истина);
	Методы.Вставить("СформироватьГрафы3и4Прямой", Истина);
	Методы.Вставить("СформироватьТабличныйДокументРасшифровкиГрафы3и4Прямой", Истина);
	Методы.Вставить("СформироватьТабличныйДокументРасшифровкиГрафы4Распределенный", Истина);
КонецПроцедуры

