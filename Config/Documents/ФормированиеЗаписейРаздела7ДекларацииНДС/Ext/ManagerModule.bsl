	СтавкиДляГрафы3 = Новый Массив();
	СтавкиДляГрафы3.Добавить(Перечисления.СтавкиНДС.БезНДС);
	
	СтавкиДляГрафы4 = Новый Массив();
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС22);
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС20);
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС18);
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС10);
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС7);
	СтавкиДляГрафы4.Добавить(Перечисления.СтавкиНДС.НДС5);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",		ШапкаДокумента.Организация);
	ЗапросПоиск.УстановитьПараметр("НачалоПериода",		НачалоКвартала(ШапкаДокумента.Дата));
	ЗапросПоиск.УстановитьПараметр("КонецПериода",		КонецДня(ШапкаДокумента.Дата));
	ЗапросПоиск.УстановитьПараметр("СтавкиДляГрафы3",	СтавкиДляГрафы3);
	ЗапросПоиск.УстановитьПараметр("СтавкиДляГрафы4",	СтавкиДляГрафы4);
	ЗапросПоиск.УстановитьПараметр("СчетаРезерва",		БухгалтерскийУчет.СписокСчетов("401.60", ШапкаДокумента.Дата));
