#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если Не УчетПоПодразделениям Или Не БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.00").УчетПоПодразделениям Тогда
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
	КонецЕсли;
	
	Если Не УчетПоПодразделениям Или Не БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").УчетПоПодразделениям Тогда
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	Если ОсновныеСредстваУжеПринятыКУчету() Тогда
		ПроверяемыеРеквизиты.Очистить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		НеПроверяемыеРеквизиты.Добавить("СпособНачисленияАмортизации");
		НеПроверяемыеРеквизиты.Добавить("СчетУчетаЗатрат");
		НеПроверяемыеРеквизиты.Добавить("КЭКЗатрат");
		НеПроверяемыеРеквизиты.Добавить("КПСЗатрат");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеЗатрат");
		НеПроверяемыеРеквизиты.Добавить("СубконтоЗатрат1");
		НеПроверяемыеРеквизиты.Добавить("СубконтоЗатрат2");
		НеПроверяемыеРеквизиты.Добавить("СубконтоЗатрат3");
	Иначе
		Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
			НеПроверяемыеРеквизиты.Добавить("СпособНачисленияАмортизации");
		КонецЕсли;
		Если ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
			Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				НеПроверяемыеРеквизиты.Добавить("ПодразделениеЗатрат");
			ИначеЕсли НЕ СчетУчетаЗатрат.УчетПоПодразделениям Тогда
				НеПроверяемыеРеквизиты.Добавить("ПодразделениеЗатрат");
			КонецЕсли;
			КоличествоСубконто = СчетУчетаЗатрат.ВидыСубконто.Количество();
			Для Счетчик = КоличествоСубконто по 2 Цикл 
				НеПроверяемыеРеквизиты.Добавить("СубконтоЗатрат"+(Счетчик+1));
			КонецЦикла;
		Иначе
			НеПроверяемыеРеквизиты.Добавить("ПодразделениеЗатрат");
			Для Счетчик = 0 по 2 Цикл 
				НеПроверяемыеРеквизиты.Добавить("СубконтоЗатрат"+(Счетчик+1));
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	// Налоговый учет по налогу на прибыль
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	
	Если НЕ ОтражатьВНалоговомУчете Тогда
		НеПроверяемыеРеквизиты.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ");
		НеПроверяемыеРеквизиты.Добавить("СрокПолезногоИспользованияНУ");
		НеПроверяемыеРеквизиты.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
		НеПроверяемыеРеквизиты.Добавить("СтатьяПрочихРасходов");
	КонецЕсли;
	
	ВыбранСчетПрочихРасходов = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчетаЗатрат, "401.20");
	Если НЕ ВыбранСчетПрочихРасходов
	 ИЛИ ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы Тогда
		НеПроверяемыеРеквизиты.Добавить("СтатьяПрочихРасходов");
	КонецЕсли;
	
	Если НЕ ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		НеПроверяемыеРеквизиты.Добавить("СрокПолезногоИспользованияНУ");
	КонецЕсли;
	
	Если НЕ НачислятьАмортизациюНУ Тогда
		НеПроверяемыеРеквизиты.Добавить("СрокПолезногоИспользованияНУ");
	КонецЕсли;
	
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ <> Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации
			ИЛИ ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0 Тогда
		НеПроверяемыеРеквизиты.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	Если Не Отказ Тогда
		РегистрыСведений.НомераИнвентарныхКарточек.ПроверитьУникальность(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Для каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		СтрокаТаблицы.Сумма                = 0;
		СтрокаТаблицы.СуммаНУ              = 0;
		СтрокаТаблицы.СуммаНеУчитываетсяНУ = 0;
		СтрокаТаблицы.СуммаЕНВД            = 0;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОсновныеСредстваУжеПринятыКУчету()
	
	Перем Ошибки;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Новый Граница(?(ЭтоНовый(), КонецДня(Дата), МоментВремени()), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство"));	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновноеСредство)
	|				И ОсновноеСредство.ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)";
	
	ПринятыеКУчетуОС = Запрос.Выполнить().Выгрузить();
	
	ШаблонОшибкиОСУжеПринятКУчету = НСтр("ru='Выбранное основное средство ""%1"" уже принято к учету документом ""%2""'");

	Для Каждого ТекущаяСтрока Из ЭтотОбъект.ОсновныеСредства Цикл
		
		СтрокаОС = ПринятыеКУчетуОС.Найти(ТекущаяСтрока.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаОС <> Неопределено Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиОСУжеПринятКУчету,
			СтрокаОС.ОсновноеСредство, СтрокаОС.Регистратор);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Объект.ОсновныеСредства[%1].ОсновноеСредство",
			ТекстОшибки, "Объект.ОсновныеСредства", ТекущаяСтрока.НомерСтроки, ТекстОшибки, ТекущаяСтрока.НомерСтроки - 1);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	
	Возврат (Ошибки <> Неопределено);
	
КонецФункции

#КонецОбласти

#КонецЕсли