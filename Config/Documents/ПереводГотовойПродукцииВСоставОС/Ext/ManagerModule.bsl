// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная0510450") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0510450",
			"Накладная на внутреннее перемещение НФА (ф.0510450)",
			УправлениеПечатьюБГУ.Напечатать0510450(МассивОбъектов, ОбъектыПечати, "МЗ"));
		
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ТребованиеНакладнаяМ11") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ТребованиеНакладнаяМ11",
			"Требование-накладная М-11", ПечатьМ11(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"Накладная0504204",
			"Требование-накладная (ф. 0504204)",ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204"));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"Накладная0504204_103н",
			"Требование-накладная (ф. 0504204)",ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204_103н"));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьМ11(МассивОбъектов, ОбъектыПечати)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереводГотовойПродукцииВСоставОС.Дата КАК Дата,
	|	ПереводГотовойПродукцииВСоставОС.Номер,
	|	ПереводГотовойПродукцииВСоставОС.Проведен,
	|	ПереводГотовойПродукцииВСоставОС.Организация,
	|	ПереводГотовойПродукцииВСоставОС.ИФО,
	|	ПереводГотовойПродукцииВСоставОС.СчетОС.Код КАК пКоррСчет,
	|	ПереводГотовойПродукцииВСоставОС.ЦМОПолучатель КАК ЦМО,
