		ТаблицыЗапроса.Добавить("ПервоначальныеСведенияОСНалоговыйУчет");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
