Функция ТекстЗапросаШапкиДляПечатиТребованияНакладной0510451() Экспорт
	
	Возврат
	"ВЫБРАТЬ
	|	ПереводГотовойПродукцииВСоставОС.Ссылка КАК Ссылка,
	|	ПереводГотовойПродукцииВСоставОС.Номер КАК Номер,
	|	ПереводГотовойПродукцииВСоставОС.Дата КАК Дата,
	|	ПереводГотовойПродукцииВСоставОС.Организация КАК Организация,
	|	ПереводГотовойПродукцииВСоставОС.ПодразделениеОтправитель.Наименование КАК НаименованиеОтправитель,
	|	ПереводГотовойПродукцииВСоставОС.ЦМООтправитель.Сотрудник КАК СотрудникОтправитель,
	|	ПереводГотовойПродукцииВСоставОС.ЦМООтправитель.МестоХранения КАК МестоХраненияОтправитель,
	|	ПереводГотовойПродукцииВСоставОС.ПодразделениеПолучатель.Наименование КАК НаименованиеПолучатель,
	|	ПереводГотовойПродукцииВСоставОС.ЦМОПолучатель.Сотрудник КАК СотрудникПолучатель,
	|	ПереводГотовойПродукцииВСоставОС.ЦМОПолучатель.МестоХранения КАК МестоХраненияПолучатель,
	|	ПереводГотовойПродукцииВСоставОС.ДокументОснованиеВид КАК ДокументОснование,
	|	ПереводГотовойПродукцииВСоставОС.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ПереводГотовойПродукцииВСоставОС.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ПереводГотовойПродукцииВСоставОС.Затребовал КАК Затребовал,
	|	ПереводГотовойПродукцииВСоставОС.ОтпускРазрешил КАК ОтпускРазрешил,
	|	ПереводГотовойПродукцииВСоставОС.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ПереводГотовойПродукцииВСоставОС.ИФО КАК ИФО,
	|	ПереводГотовойПродукцииВСоставОС.Руководитель КАК УполномоченноеЛицо,
	|	ИСТИНА КАК СуммаУказанаВДокументе
	|ИЗ
	|	Документ.ПереводГотовойПродукцииВСоставОС КАК ПереводГотовойПродукцииВСоставОС
	|ГДЕ
	|	ПереводГотовойПродукцииВСоставОС.Ссылка В (&МассивОбъектов)";
	
КонецФункции

Функция ТекстЗапросаТаблицДляПечатиТребованияНакладной0510451() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.Номенклатура.Наименование
	|		ИНАЧЕ ОсновныеСредства.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НФАНаименование,
	|	ОсновныеСредства.Номенклатура КАК Номенклатура,
	|	ОсновныеСредства.Номенклатура.НаименованиеДополнительное КАК НФАДопНаименование,
	|	ОсновныеСредства.Номенклатура.НоменклатурныйНомер КАК НомерНоменклатурный,
	|	ОсновныеСредства.Номенклатура.Код КАК НомерПаспорта,
	|	ОсновныеСредства.Номенклатура.ЕдиницаИзмерения.Код КАК ЕдИзмКод,
	|	ОсновныеСредства.Номенклатура.ЕдиницаИзмерения.НаименованиеПолное КАК ЕдИзмНаименование,
	|	ОсновныеСредства.Количество КАК Затребовано,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство.Код КАК НФАКод,
	|	ОсновныеСредства.Ссылка.КФО КАК КФО
	|ИЗ
	|	Документ.ПереводГотовойПродукцииВСоставОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&МассивОбъектов)";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата,Номер,КФО,
		|СчетУчетаЗатрат,ПорядокВключенияСтоимостиВСоставРасходовНУ,СтатьяПрочихРасходов");
	
	// Параметры налогового учета
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата, ЗначенияРеквизитов.КФО);
	СубконтоНУ = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
	Если ОтражатьВНалоговомУчете Тогда
		Если НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ЗначенияРеквизитов.СчетУчетаЗатрат)
			И ЗначенияРеквизитов.ПорядокВключенияСтоимостиВСоставРасходовНУ <> Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы Тогда
			СубконтоНУ = ЗначенияРеквизитов.СтатьяПрочихРасходов;
		КонецЕсли;
	КонецЕсли;
	
	УчетНаСчете21ВУсловнойОценке = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата).УчетНаСчете21ВУсловнойОценке;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("НомерДокумента"		, ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	Запрос.УстановитьПараметр("СубконтоНУ"			, СубконтоНУ);
	Запрос.УстановитьПараметр("Учет21Условно"		, УчетНаСчете21ВУсловнойОценке);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("ТаблицаОсновныеСредства");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&НомерДокумента КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента КАК ИмяДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.ПодразделениеПолучатель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ТаблицаОсновныеСредства.Ссылка.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ТаблицаОсновныеСредства.Ссылка.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ТаблицаОсновныеСредства.Ссылка.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию КАК ПринятиеКУчетуСВводом,
	|	ТаблицаОсновныеСредства.Ссылка.НачислятьАмортизацию КАК НачислятьАмортизацию,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	ТаблицаОсновныеСредства.СоздатьИнвентарнуюКарточку КАК СоздатьИнвентарнуюКарточку,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	ТаблицаОсновныеСредства.ОсновноеСредство.ТипНФА КАК ТипНФА,
	|	ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ТаблицаОсновныеСредства.Ссылка.ПоступлениеБиблиотечногоФонда КАК ПоступлениеБиблиотечногоФонда
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ПереводГотовойПродукцииВСоставОС.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка";
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету) КАК Событие,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.ИмяДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.Номер КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаДокумента,
	|	МИНИМУМ(ТаблицаОсновныеСредства.НомерСтроки) КАК Порядок1,
	|	1 КАК Порядок2
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.ИмяДокумента,
	|	ТаблицаОсновныеСредства.Номер,
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию),
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.ИмяДокумента,
	|	ТаблицаОсновныеСредства.Номер,
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.НомерСтроки,
	|	2
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И ТаблицаОсновныеСредства.ПринятиеКУчетуСВводом
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание),
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.ИмяДокумента,
	|	ТаблицаОсновныеСредства.Номер,
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.НомерСтроки,
	|	3
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
	|	И ТаблицаОсновныеСредства.ПринятиеКУчетуСВводом
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок1,
	|	Порядок2";
	
	ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.НачислятьАмортизацию КАК НачислятьАмортизацию
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И ТаблицаОсновныеСредства.СпособНачисленияАмортизации <> ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию)
	|	И НЕ ТаблицаОсновныеСредства.НачислятьАмортизацию";
	
	ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства";
	
	ТаблицыЗапроса.Добавить("АмортизацияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
