		Объект, Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС <> Истина Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено И ВыбранноеЗначение <> ТекущиеДанные.ОсновноеСредство Тогда
			ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	Перем Ошибки;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере(Элементы.ОсновныеСредства.ТекущиеДанные.ПолучитьИдентификатор(),
		ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) ИЛИ Не ТекущиеДанные.ГрупповойУчет Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект);
		
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	УстановитьСрокПолезногоИспользованияВГодах(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки,
	Знач ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС)

	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	УстановитьИнвентарныйНомер(ЭтаФорма, Объект, ИдентификаторСтроки, Истина);
	
	ДанныеЗаполнены = Ложь;

	Если ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина Тогда

		Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			
			Если ТекСтрока.ОсновноеСредство = ТекущаяСтрока.ОсновноеСредство
				И ТекСтрока.ПолучитьИдентификатор() <> ИдентификаторСтроки Тогда
				
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекСтрока, "ГрупповойУчет,НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку");				
				ДанныеЗаполнены = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ДанныеЗаполнены Тогда
			
			ТекущаяСтрока.ГрупповойУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "ГрупповойУчет");
			
			ТекущаяСтрока.НомерИнвентарнойКарточки	 = "";
			ТекущаяСтрока.СоздатьИнвентарнуюКарточку = Ложь;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	УстановитьСрокПолезногоИспользования(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭтоПервый = Истина;
	
	Для Каждого ИнвентарныйНомер Из ВыбранноеЗначение Цикл
		Если ЭтоПервый Тогда
			ЗаполняемаяСтрока = ТекущиеДанные;
			ЭтоПервый = Ложь;
		Иначе
			ЗаполняемаяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, ТекущиеДанные);
		КонецЕсли;
		ЗаполняемаяСтрока.ИнвентарныйНомер	= ИнвентарныйНомер;
		ЗаполняемаяСтрока.Количество		= 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) ИЛИ Не ТекущиеДанные.ГрупповойУчет Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект);
	
КонецПроцедуры

