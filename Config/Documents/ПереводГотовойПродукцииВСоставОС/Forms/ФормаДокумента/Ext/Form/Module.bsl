&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	СчетДляПроверки = ?(ЗначениеЗаполнено(Объект.СчетОС), Объект.СчетОС, Форма.Счет101);
	СвойстваСчетаОС = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетДляПроверки);
	
	ОбязательностьКПС = СвойстваСчетаОС.УчетПоКПС;
	
	Если Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		ОбязательностьПодразделения101 = СвойстваСчетаОС.УчетПоПодразделениям;
		ОбязательностьПодразделения105 = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("105.00").УчетПоПодразделениям;
	Иначе
		ОбязательностьПодразделения101 = Ложь;
		ОбязательностьПодразделения105 = Ложь;
	КонецЕсли;
	
	Элементы.КПС.АвтоотметкаНезаполненного = ОбязательностьКПС;
	Элементы.КПС.ОтметкаНезаполненного = ОбязательностьКПС И Не ЗначениеЗаполнено(Объект.КПС);
	
	Элементы.ПодразделениеОтправитель.АвтоотметкаНезаполненного = ОбязательностьПодразделения105;
	Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного = ОбязательностьПодразделения105
		И Не ЗначениеЗаполнено(Объект.ПодразделениеОтправитель);
	
	Элементы.Подразделение.АвтоотметкаНезаполненного = ОбязательностьПодразделения101;
	Элементы.Подразделение.ОтметкаНезаполненного = ОбязательностьПодразделения101
		И Не ЗначениеЗаполнено(Объект.ПодразделениеПолучатель);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект)
	Перем МассивПолей;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КПС", "КПСЗатрат", "", Ложь, "КПСЗатрат", Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КЭК", "КЭКЗатрат", "", Ложь, "КЭКЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "", Ложь, "ПодразделениеЗатрат", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "СубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "СубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "СубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьИнвентарныйНомер(Форма, Объект, ИдентификаторСтроки, ОчищатьПередУстановкой = Ложь)

	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ОчищатьПередУстановкой Тогда
		ТекущиеДанные.ИнвентарныйНомер = ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ТекущиеДанные.ИнвентарныйНомер = УправлениеОсновнымиСредствами.ПолучитьИнвентарныйНомерНеВЭкплуатации(
			ТекущиеДанные.ОсновноеСредство, Объект.Организация, ПериодПолученияОстатков(Объект),
			Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ИнвентарныйНомер"));
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьСрокПолезногоИспользования(ТекущаяСтрока)

	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;

	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "АмортизационнаяГруппа"));
	
	Если Объект.СрокПолезногоИспользования = 0 ИЛИ СрокПолезногоИспользования <> 0 Тогда
		Объект.СрокПолезногоИспользования = СрокПолезногоИспользования;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Отказ = Ложь;
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(
		ДокументОбъект,, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Рассчитаем таблицу списания материальных запасов.
	Реквизиты = Новый Структура();
	Реквизиты.Вставить("Организация", ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",        ДокументОбъект.Дата);
	Реквизиты.Вставить("Ссылка",      ДокументОбъект.Ссылка);
	ТаблицаСписания = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
		ТаблицаДокумента, Реквизиты, Отказ);
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		НайденныеСтроки = ТаблицаСписания.НайтиСтроки(Новый Структура("НомерСтроки, ИмяСписка, ВидУчета", СтрокаТаблицы.НомерСтроки, "ОсновныеСредства", "БУ"));
		Если НайденныеСтроки.Количество()=1 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
		ИначеЕсли НайденныеСтроки.Количество()>1 Тогда // списано несколькими строками
			СтрокиТаблицыСписания = ТаблицаСписания.Скопировать(НайденныеСтроки);
			СтрокиТаблицыСписания.Свернуть("ИФО,КФО,КПС,Подразделение,СчетУчета,Номенклатура,ДопИзмерение,ДопАналитика",
				"Стоимость,СтоимостьНеУчитываетсяНУ,СтоимостьЕНВД");
			НайденнаяСтрока = СтрокиТаблицыСписания[0];
		Иначе
			НайденнаяСтрока = Неопределено;
		КонецЕсли;
		
		СтрокаТаблицы.Сумма = ?(НайденнаяСтрока = Неопределено, 0, НайденнаяСтрока.Стоимость);
		
		Если ОтражатьВНалоговомУчете Тогда
			
			НайденныеСтроки = ТаблицаСписания.НайтиСтроки(Новый Структура("НомерСтроки, ИмяСписка, ВидУчета", СтрокаТаблицы.НомерСтроки, "ОсновныеСредства", "НУ"));
			Если НайденныеСтроки.Количество()=1 Тогда
				НайденнаяСтрока = НайденныеСтроки[0];
			ИначеЕсли НайденныеСтроки.Количество()>1 Тогда // списано несколькими строками
				СтрокиТаблицыСписания = ТаблицаСписания.Скопировать(НайденныеСтроки);
				СтрокиТаблицыСписания.Свернуть("ИФО,КФО,КПС,Подразделение,СчетУчета,Номенклатура,ДопИзмерение,ДопАналитика",
					"Стоимость,СтоимостьНеУчитываетсяНУ,СтоимостьЕНВД");
				НайденнаяСтрока = СтрокиТаблицыСписания[0];
			Иначе
				НайденнаяСтрока = Неопределено;
			КонецЕсли;
			
			СтрокаТаблицы.СуммаНУ              = ?(НайденнаяСтрока = Неопределено, 0, НайденнаяСтрока.Стоимость);
			СтрокаТаблицы.СуммаНеУчитываетсяНУ = ?(НайденнаяСтрока = Неопределено, 0, НайденнаяСтрока.СтоимостьНеУчитываетсяНУ);
			СтрокаТаблицы.СуммаЕНВД            = ?(НайденнаяСтрока = Неопределено, 0, НайденнаяСтрока.СтоимостьЕНВД);
			
		КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуТекущейСтроки(ТекущиеДанные, Объект, СуммаВПодборе = 0)

	ТекущиеДанные.Сумма = 0;
	ТекущиеДанные.СуммаНУ = 0;
	ТекущиеДанные.СуммаНеУчитываетсяНУ = 0;
	ТекущиеДанные.СуммаЕНВД = 0;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеДанныеВТабличнойЧасти()

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
											Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство")
										 							.ВыгрузитьКолонку("ОсновноеСредство"), 
											"ГрупповойУчет");
	Для каждого ТекущиеДанные Из Объект.ОсновныеСредства Цикл
		
		ТекОС = ЗначенияРеквизитов[ТекущиеДанные.ОсновноеСредство];
		Если ТекОс<>Неопределено Тогда
			ТекущиеДанные.ГрупповойУчет =  ТекОС.ГрупповойУчет;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч.:'");
	ТекущаяСтрока.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД:'");
	
	ТекущаяСтрока.НадписьСоздатьИнвКарточку = НСтр("ru =' создать'");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрок()

	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные)

	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		
		Если ТекСтрока <> ТекущиеДанные
			И ТекСтрока.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство И ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
			
			ЗаполнитьЗначенияСвойств(ТекСтрока, ТекущиеДанные, "НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку");
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры


#Область НалоговыйУчет

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Знач Объект)

	Если Объект.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(Форма)

	Если НЕ Форма.ОтражатьВНалоговомУчете Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
			И Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда

		Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы");
		Форма.ЗаблокироватьДанныеФормыДляРедактирования();
		Форма.Модифицированность = Истина;

		ШаблонСообщения = НСтр("ru = 'В поле ""Порядок включения стоимости в состав расходов"" на закладке ""Налоговый учет"" установлено значение ""%1""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);

		УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма);

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Объект)
	
	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеПоАмортизационнойПремии", "ПодразделениеПоАмортизационнойПремии", Ложь, "ПодразделениеПоАмортизационнойПремии", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоПоАмортизационнойПремии1", "СубконтоПоАмортизационнойПремии1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоПоАмортизационнойПремии2", "СубконтоПоАмортизационнойПремии2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоПоАмортизационнойПремии3", "СубконтоПоАмортизационнойПремии3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатратПоАмортизационнойПремии, Форма, Объект, МассивПолей);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма, Объект)

	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете;
	
	Форма.Элементы.ГруппаНалоговыйУчет.Видимость                = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ОсновныеСредстваГруппаСуммаНУ.Видимость      = ВидимостьЭлементовНалоговогоУчета;
	
	Форма.Элементы.СтатьяПрочихРасходов.Видимость = ВидимостьЭлементовНалоговогоУчета
		И Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы")
		И НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетУчетаЗатрат);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)

	Форма.Элементы.ГруппаСтраницыПараметрыАмортизационнойПремии.ТекущаяСтраница =
		?(Форма.ВключитьАмортизационнуюПремиюВСоставРасходов,
			Форма.Элементы.ГруппаПараметрыАмортизационнойПремии,
			Форма.Элементы.ГруппаАмортизационнаяПремияНеИспользуется);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма)

	СтарыйТекущийЭлемент = Форма.ТекущийЭлемент;
	ПорядокПогашенияСтоимости = Форма.Объект.ПорядокПогашенияСтоимости;
	Форма.Элементы.ГруппаСтраницыПорядокВключенияСтоимостиВСоставРасходовНУ.ТекущаяСтраница =
		?(ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается"),
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУТолькоПросмотр,
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ);
	Форма.ТекущийЭлемент = СтарыйТекущийЭлемент;

	ПорядокВключенияСтоимостиВСоставРасходовНУ = Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУНачислениеАмортизации;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУВключениеВРасходыПриПринятииКУчету;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУСтоимостьНеВключаетсяВРасходы;
	Иначе
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУПорядокВключенияСтоимостиВСоставРасходовНеУказан;
	КонецЕсли;

КонецПроцедуры

