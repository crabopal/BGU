&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = НоваяСтрока;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если НоваяСтрока Тогда
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные);
		
		Если Копирование Тогда
			ТекущиеДанные.ИнвентарныйНомер = "";
			Если Не ТекущиеДанные.ГрупповойУчет Тогда
				ТекущиеДанные.ОсновноеСредство = "";
			Иначе
				ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),
					ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
