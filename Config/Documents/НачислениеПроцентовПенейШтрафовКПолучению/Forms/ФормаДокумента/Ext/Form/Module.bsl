	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда 
		Элементы.Начисления.ТекущиеДанные.СчетРасчетов = ВыбранноеЗначение.Счет;
		Элементы.Начисления.ТекущиеДанные.КПС = ВыбранноеЗначение.КПС;
		Элементы.Начисления.ТекущиеДанные.КФО = ВыбранноеЗначение.КФО;
