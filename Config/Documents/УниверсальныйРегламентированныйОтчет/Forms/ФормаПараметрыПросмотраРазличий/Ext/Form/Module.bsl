&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЦветТекстаВоВтором = Параметры.ЦветТекстаВоВтором;
	ЦветТекстаВПервом = Параметры.ЦветТекстаВПервом;
	ЦветТекстаИзмененные = Параметры.ЦветТекстаИзмененные;
	ЦветФонаВоВтором = Параметры.ЦветФонаВоВтором;
	ЦветФонаВПервом = Параметры.ЦветФонаВПервом;
	ЦветФонаИзмененные = Параметры.ЦветФонаИзмененные;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзменения(Команда)
	ПараметрыЗакрытия = Новый Структура();
	ПараметрыЗакрытия.Вставить("ЦветТекстаВоВтором", ЦветТекстаВоВтором);
	ПараметрыЗакрытия.Вставить("ЦветТекстаВПервом", ЦветТекстаВПервом);
	ПараметрыЗакрытия.Вставить("ЦветТекстаИзмененные", ЦветТекстаИзмененные);
	ПараметрыЗакрытия.Вставить("ЦветФонаВоВтором", ЦветФонаВоВтором);
	ПараметрыЗакрытия.Вставить("ЦветФонаВПервом", ЦветФонаВПервом);
	ПараметрыЗакрытия.Вставить("ЦветФонаИзмененные", ЦветФонаИзмененные);
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура ЦветаПоУмолчанию(Команда)
	ЦветФонаИзмененные =  Новый Цвет(224, 255, 255);
	ЦветТекстаИзмененные = Новый Цвет(255, 0, 0);
	
	ЦветФонаВПервом = Новый Цвет(255, 228, 196);
	ЦветТекстаВПервом = Новый Цвет(0, 0, 255);
	
	ЦветФонаВоВтором = Новый Цвет(192, 220, 192);
	ЦветТекстаВоВтором = Новый Цвет(0, 128, 0);
КонецПроцедуры

