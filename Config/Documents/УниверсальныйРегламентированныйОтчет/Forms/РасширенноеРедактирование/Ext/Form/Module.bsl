&НаКлиенте
Перем ВыполняетсяЗакрытие;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Параметры,"ТекущееЗначение,ТекущееИмя");
	//Замена отображаемого символа перевода строки на реальный перевод строки
	ТекущееЗначение = СтрЗаменить(Параметры.ТекущееЗначение,Символ(182),Символы.ПС);
	
	Если Параметры.Свойство("Заголовок") Тогда
		ЭтотОбъект.Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	ДоступныПредопределенные = Параметры.Свойство("ПредопределенныеЗначения");
	Элементы.ПредопределенныеЗначения.Видимость = ДоступныПредопределенные;
	Если ДоступныПредопределенные Тогда
		Для Каждого ПредопределененныйЭлемент Из Параметры.ПредопределенныеЗначения Цикл
			ПараметрыЭлемента = ПредопределененныйЭлемент.Значение;
			
			ЗначениеЭлемента = ПараметрыЭлемента.Значение;
			ПредставлениеЭлемента = "<...>";
			Если ЗначениеЗаполнено(ПараметрыЭлемента.Представление) Тогда
				ПредставлениеЭлемента = ПараметрыЭлемента.Представление;
			ИначеЕсли ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
				ПредставлениеЭлемента = ЗначениеЭлемента;
			КонецЕсли;
			КартинкаЭлемента = ?(ПараметрыЭлемента.ДоступноРедактирование, БиблиотекаКартинок.Изменить, Неопределено);
			
			ПредопределенныеЗначения.Добавить(ЗначениеЭлемента, ПредставлениеЭлемента,ПараметрыЭлемента.ДоступноРедактирование,КартинкаЭлемента);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Параметры.ТекущееЗначение) Тогда
			НайденноеЗначение = ПредопределенныеЗначения.НайтиПоЗначению(Параметры.ТекущееЗначение);
			Если НайденноеЗначение <> Неопределено Тогда
				Элементы.ПредопределенныеЗначения.ТекущаяСтрока = НайденноеЗначение.ПолучитьИдентификатор();
				ТекущееЗначение = "";
			ИначеЕсли СтрНайти(Параметры.ТекущееЗначение,":")>0
				И СтрНайти(Параметры.ТекущееЗначение,Символы.ПС)>0 Тогда
				//ищем заполненное значение причины
				Для Каждого ПредопределененныйЭлемент Из ПредопределенныеЗначения Цикл
					ПодстрокаПоиска = СтрШаблон("%1:%2", ПредопределененныйЭлемент.Значение, Символы.ПС);
					Если СтрНайти(Параметры.ТекущееЗначение, ПодстрокаПоиска) = 1 Тогда
						Элементы.ПредопределенныеЗначения.ТекущаяСтрока = ПредопределененныйЭлемент.ПолучитьИдентификатор();
						ТекущееЗначение = Сред(ТекущееЗначение, СтрДлина(ПодстрокаПоиска)+1);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			Иначе
				//ищем причину, где значение пустое и есть пометка
				Для Каждого ПредопределененныйЭлемент Из ПредопределенныеЗначения Цикл
					Если НЕ ЗначениеЗаполнено(ПредопределененныйЭлемент.Значение)
						И ПредопределененныйЭлемент.Пометка Тогда
						Элементы.ПредопределенныеЗначения.ТекущаяСтрока = ПредопределененныйЭлемент.ПолучитьИдентификатор();
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы Тогда
		Если Модифицированность Тогда
			Отказ = Истина;
			ТекстПредупреждения = НСтр("ru='Данные были изменены.
				|Перед завершением работы рекомендуется сохранить изменения, иначе иначе измененные данные будут утеряны.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Если НЕ ВыполняетсяЗакрытие Тогда
			
			Отказ = Истина;		
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение",ЭтотОбъект),Нстр("ru='При закрытии формы все сделанные изменения будут потеряны. Закрыть форму?'"),РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ТекущееЗначениеПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПредопределенныеЗначенияПриАктивизацииСтроки(Элемент)
	ТекущиеДанныеСписка = Элементы.ПредопределенныеЗначения.ТекущиеДанные;
	Элементы.ТекущееЗначение.Видимость = ТекущиеДанныеСписка.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура ПредопределенныеЗначенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанныеСписка = Элементы.ПредопределенныеЗначения.ТекущиеДанные;
	Если ТекущиеДанныеСписка.Пометка = Ложь Тогда
		ПрименитьИзменения();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	Если Модифицированность = Ложь Тогда
		ВыполняетсяЗакрытие = Истина;
	КонецЕсли;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ПрименитьИзменения();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьИзменения()
	ВыполняетсяЗакрытие = Истина;
	
	Если ПредопределенныеЗначения.Количество() Тогда
		ТекущиеДанныеСписка = Элементы.ПредопределенныеЗначения.ТекущиеДанные;
		Если ТекущиеДанныеСписка.Пометка = Ложь Тогда
			Закрыть(Новый Структура("ТекущееЗначение,ТекущееИмя",ТекущиеДанныеСписка.Значение,ТекущееИмя));
		Иначе
			ДополненныйТекст = СокрЛП(ТекущееЗначение);
			Если ЗначениеЗаполнено(ТекущиеДанныеСписка.Значение) Тогда
				ДополненныйТекст = СтрШаблон("%1:%2%3", ТекущиеДанныеСписка.Значение, Символы.ПС, ДополненныйТекст);
			КонецЕсли;
			Закрыть(Новый Структура("ТекущееЗначение,ТекущееИмя",ДополненныйТекст,ТекущееИмя));
		КонецЕсли;
	Иначе
		Закрыть(Новый Структура("ТекущееЗначение,ТекущееИмя",СокрЛП(ТекущееЗначение),ТекущееИмя));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполняетсяЗакрытие = Истина;
		Закрыть();		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

ВыполняетсяЗакрытие = Ложь;