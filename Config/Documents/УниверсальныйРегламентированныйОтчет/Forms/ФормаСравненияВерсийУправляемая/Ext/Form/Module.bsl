&НаКлиенте
Перем ПараметрыОбработчикаОжидания;
&НаКлиенте
Перем ФормаДлительнойОперации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантСравнения = "ДанныеОтчета";
	
	Элементы.ТабличныйДокументВерсия1.Заголовок = Параметры.Наименование1;
	Элементы.ТабличныйДокументВерсия2.Заголовок = Параметры.Наименование2;
	ЭтаФорма.Заголовок = "Сравнение версий отчета: " + Параметры.ТекстЗаголовка;
	
	Версия1 = Параметры.Версия1;
	Версия2 = Параметры.Версия2;
	
	ОтчетСсылка = Параметры.ОтчетСсылка;
	
	Если Параметры.ВариантСравнения = "ВсеДанные" Тогда
		ВариантСравнения = Параметры.ВариантСравнения;
	КонецЕсли;
	
	// Заполнение дерева страниц отчета
	АдресДереваБланка = Документы.УниверсальныйРегламентированныйОтчет.ПолучитьАдресДереваБланкаПоСсылке(ОтчетСсылка);	
	Если ЭтоАдресВременногоХранилища(АдресДереваБланка) Тогда
		ОтобразитьЗагруженныйБланк(АдресДереваБланка, Параметры.СтруктураБланков);
		ТабличныйДокумент1Заполнен = Истина;
		ТабличныйДокумент2Заполнен = Истина;
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("ХранимыйФайл", ХранимыйФайл) Тогда
		ХранимыйФайл = Неопределено;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Пользователь",Пользователи.АвторизованныйПользователь());
	СтруктураНастроек.Вставить("ИмяОбъекта","УниверсальныйРегламентированныйОтчет.ФормаСравненияВерсийУправляемая");
	СтруктураНастроек.Вставить("НаименованиеНастройки", "ПараметрыСравненияПоказателей");
	
	ЦветаСравнения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("УниверсальныйРегламентированныйОтчет.ФормаСравненияВерсийУправляемая","ПараметрыСравненияПоказателей");
	Если НЕ ЦветаСравнения = Неопределено Тогда
		ЦветФонаИзмененные 	= ЦветаСравнения.ЦветФонаИзмененные;
		ЦветТекстаИзмененные= ЦветаСравнения.ЦветТекстаИзмененные;
		ЦветФонаВПервом		= ЦветаСравнения.ЦветФонаВПервом;
		ЦветТекстаВПервом	= ЦветаСравнения.ЦветТекстаВПервом;
		ЦветФонаВоВтором	= ЦветаСравнения.ЦветФонаВоВтором;
		ЦветТекстаВоВтором	= ЦветаСравнения.ЦветТекстаВоВтором;
	КонецЕсли;
	ЦветФонаПустой = ЦветаСтиля.ЦветФонаПоля;
		
	Если ЦветаСравнения = Неопределено Тогда
		ЗаполнитьЦветаПоУмолчанию();
	КонецЕсли;	
	УстановитьЦветаОтличий();
	
	Документ1Активный = Истина;
	ТабличныеДокументыЗаполнены = Ложь;
	ТекущийВариантОтображения = 1;// Каждый табличный документ в отдельном поле.
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПоВариантуОтображения();
	ПолноеСравнение = Истина;
	ВыполнитьСравнение();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантСравненияПриИзменении(Элемент)
	ПолноеСравнение = Истина;
	ВыполнитьСравнение();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтраницПриАктивизацииСтроки(Элемент)
	ТекСтраница = Элементы.ДеревоСтраниц.ТекущиеДанные;
	Если ТекСтраница = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСтраница.АдресБланка1 = АдресТекущейСтраницы Тогда
		//Пользователь выбрал текущую страницу.
		//Ничего не делаем.
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиДереваСтраниц",0.2,Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиДереваСтраниц() Экспорт
	
	ТекДанные = Элементы.ДеревоСтраниц.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.АдресБланка1 = АдресТекущейСтраницы Тогда
		//Пользователь выбрал текущую страницу.
		//Ничего не делаем.
		Возврат;
	КонецЕсли;
	
	АдресТекущейСтраницы = ТекДанные.АдресБланка1;
	
	ТекущееИмяСтраницы = ТекДанные.ИмяСтраницы;
	
	ВыбратьСтраницуНаСервере();
	
	ПолноеСравнение = Ложь;
	Если ТекДанные.СравнениеВыполнено = Ложь Тогда	
		ВыполнитьСравнение();
	Иначе
		ОповеститьОРезультатахСравнения();
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СледующееРазличие(Команда)
	
	ИзмененныеОбласти.Сортировать("ОбластьВерх,ОбластьЛево");
	Если ТекущийВариантОтображения = 1 Тогда
		ПерейтиПоРазличиямВариантСтандартный(Истина);
	Иначе
		ПерейтиПоРазличиямВариантВариантВОдномПоле(Истина);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущееРазличие(Команда)
	
	ИзмененныеОбласти.Сортировать("ОбластьВерх УБЫВ,ОбластьЛево УБЫВ");
	Если ТекущийВариантОтображения = 1 Тогда
		ПерейтиПоРазличиямВариантСтандартный(Ложь);
	Иначе
		ПерейтиПоРазличиямВариантВариантВОдномПоле(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВариантОтображения1(Команда)
	
	ТекущийВариантОтображения = 1;
	УстановитьВидимостьПоВариантуОтображения();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтображения2(Команда)
	
	ТекущийВариантОтображения = 2;
	УстановитьВидимостьПоВариантуОтображения();
	УстановитьЗаголовокСравнения();
	ОбъединитьДанныеДокументовНаСервере();
	
	Если ПоказыватьТолькоОтличия Тогда
		УправлениеВидимостьюСтрок(ТабличныйДокументСравнения);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтображения3(Команда)
	
	ТекущийВариантОтображения = 3;
	УстановитьВидимостьПоВариантуОтображения();
	УстановитьЗаголовокСравнения();
	ОбъединитьДанныеДокументовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПараметровСравнения(Команда)
	
	ЦветаДоИзменения = Новый Структура;
	ЦветаДоИзменения.Вставить("ЦветТекстаВоВтором", ЦветТекстаВоВтором);
	ЦветаДоИзменения.Вставить("ЦветТекстаВПервом", ЦветТекстаВПервом);
	ЦветаДоИзменения.Вставить("ЦветТекстаИзмененные", ЦветТекстаИзмененные);
	ЦветаДоИзменения.Вставить("ЦветФонаВоВтором", ЦветФонаВоВтором);
	ЦветаДоИзменения.Вставить("ЦветФонаВПервом", ЦветФонаВПервом);
	ЦветаДоИзменения.Вставить("ЦветФонаИзмененные", ЦветФонаИзмененные);
			
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаПараметрыПросмотраРазличий",ЦветаДоИзменения,ЭтаФорма,,,,
				Новый ОписаниеОповещения("НастройкаПараметровСравненияЗавершение", ЭтотОбъект, ЦветаДоИзменения));
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПараметровСравненияЗавершение(НовыеЦвета, ЦветаДоИзменения) Экспорт
	
	Если НЕ НовыеЦвета = Неопределено Тогда
		// Если цвета в форме настройки изменились, заново проводим сравнение.
		Если НовыеЦвета.ЦветТекстаВоВтором <> ЦветаДоИзменения.ЦветТекстаВоВтором 
			ИЛИ НовыеЦвета.ЦветТекстаВПервом <> ЦветаДоИзменения.ЦветТекстаВПервом 
			ИЛИ НовыеЦвета.ЦветТекстаИзмененные <> ЦветаДоИзменения.ЦветТекстаИзмененные 
			ИЛИ НовыеЦвета.ЦветФонаВоВтором <> ЦветаДоИзменения.ЦветФонаВоВтором 
			ИЛИ НовыеЦвета.ЦветФонаВПервом <> ЦветаДоИзменения.ЦветФонаВПервом 
			ИЛИ НовыеЦвета.ЦветФонаИзмененные <> ЦветаДоИзменения.ЦветФонаИзмененные Тогда
			
			ЦветТекстаВоВтором		= НовыеЦвета.ЦветТекстаВоВтором;
			ЦветТекстаВПервом		= НовыеЦвета.ЦветТекстаВПервом;
			ЦветТекстаИзмененные	= НовыеЦвета.ЦветТекстаИзмененные;
			ЦветФонаВоВтором		= НовыеЦвета.ЦветФонаВоВтором;
			ЦветФонаВПервом			= НовыеЦвета.ЦветФонаВПервом;
			ЦветФонаИзмененные		= НовыеЦвета.ЦветФонаИзмененные;
			
			УстановитьЦветаОтличий();
			ПолноеСравнение = Истина;
			ВыполнитьСравнение();			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьТолькоОтличия(Команда)
	
	ПоказыватьТолькоОтличия = НЕ ПоказыватьТолькоОтличия;
	Элементы.ФормаПоказыватьТолькоОтличия.Пометка = ПоказыватьТолькоОтличия;
	
	ПоказыватьТолькоОтличияНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНастройкиЦветов()
	
	ЦветаСравнения = Новый Структура;
	ЦветаСравнения.Вставить("ЦветТекстаВоВтором", ЦветТекстаВоВтором);
	ЦветаСравнения.Вставить("ЦветТекстаВПервом", ЦветТекстаВПервом);
	ЦветаСравнения.Вставить("ЦветТекстаИзмененные", ЦветТекстаИзмененные);
	ЦветаСравнения.Вставить("ЦветФонаВоВтором", ЦветФонаВоВтором);
	ЦветаСравнения.Вставить("ЦветФонаВПервом", ЦветФонаВПервом);
	ЦветаСравнения.Вставить("ЦветФонаИзмененные", ЦветФонаИзмененные);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("УниверсальныйРегламентированныйОтчет.ФормаСравненияВерсийУправляемая","ПараметрыСравненияПоказателей",ЦветаСравнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоСтраницРекурсивно(ИсходнаяСтрока, СтрокиДереваСтраниц, БланкиЗаполнения)
	
	ТекИмяСтраницы = ИсходнаяСтрока.ИмяСтраницы;
	
	НоваяСтрокаСтраница = СтрокиДереваСтраниц.Добавить();
	НоваяСтрокаСтраница.Наименование = ИсходнаяСтрока.Наименование;
	НоваяСтрокаСтраница.ИмяСтраницы = ТекИмяСтраницы;
	НоваяСтрокаСтраница.АдресБланка1 = ИсходнаяСтрока.АдресБланка;
	
	Если БланкиЗаполнения.Свойство(ТекИмяСтраницы) Тогда
		НоваяСтрокаСтраница.АдресБланка2 = ПоместитьВоВременноеХранилище(БланкиЗаполнения[ТекИмяСтраницы], Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Для Каждого ПодчиненнаяСтрока Из ИсходнаяСтрока.Строки Цикл
		ЗаполнитьДеревоСтраницРекурсивно(ПодчиненнаяСтрока, НоваяСтрокаСтраница.ПолучитьЭлементы(), БланкиЗаполнения);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьЗагруженныйБланк(АдресДереваБланка, БланкиЗаполнения)

	ДеревоБланка = ПолучитьИзВременногоХранилища(АдресДереваБланка);
		
	Для Каждого СтрокаДереваБланка Из ДеревоБланка.Строки Цикл
		ЗаполнитьДеревоСтраницРекурсивно(СтрокаДереваБланка, ДеревоСтраниц.ПолучитьЭлементы(), БланкиЗаполнения);
	КонецЦикла;
	
	ОпеределитьВидимостьСтраниц();

	ВыбратьСтраницуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОпеределитьВидимостьСтраниц()
	
	//если всего 1 страница в бланке, то не отображаем панель со страницами
	КоличествоСтраниц = 0;
	Для Каждого ТекСтр Из ДеревоСтраниц.ПолучитьЭлементы() Цикл
		КоличествоСтраниц = КоличествоСтраниц + 1 + ТекСтр.ПолучитьЭлементы().Количество();
		Если КоличествоСтраниц>1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоСтраниц=1 Тогда
		Элементы.ГруппаСтраницы.Видимость = Ложь;
	Иначе
		Элементы.ГруппаСтраницы.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыбратьСтраницуНаСервере()
	
	ЭтотОбъект["ТабличныйДокументВерсия1"].Очистить();
	ЭтотОбъект["ТабличныйДокументВерсия2"].Очистить();
	
	Если ЗначениеЗаполнено(ТекущееИмяСтраницы) Тогда
		ДеревоЗначенийДляОбработки = РеквизитФормыВЗначение("ДеревоСтраниц");
		
		ТекСтраница = ДеревоЗначенийДляОбработки.Строки.Найти(ТекущееИмяСтраницы,"ИмяСтраницы",Истина);
		Если ЗначениеЗаполнено(ТекСтраница) Тогда
			Если ЭтоАдресВременногоХранилища(ТекСтраница.АдресБланка1) Тогда
				ТаблДок = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка1);
				ЭтотОбъект["ТабличныйДокументВерсия1"].Вывести(ТаблДок);
			КонецЕсли;
			Если ЭтоАдресВременногоХранилища(ТекСтраница.АдресБланка2) Тогда
				ТаблДок = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка2);
				ЭтотОбъект["ТабличныйДокументВерсия2"].Вывести(ТаблДок);
			КонецЕсли;
			Если ЭтоАдресВременногоХранилища(ТекСтраница.АдресИзмененныеОбласти) Тогда
				ИзмененныеОбласти.Загрузить(ПолучитьИзВременногоХранилища(ТекСтраница.АдресИзмененныеОбласти));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьСравнение()
	
	Результат = ВыполнитьСравнениеНаСервере();
	Если НЕ Результат.ЗаданиеВыполнено Тогда
		// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
		ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
		Если ПодключатьОбработчикОжидания Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
		КонецЕсли;
		
	Иначе
		ОповеститьОРезультатахСравнения();
	КонецЕсли;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаКлиенте
Процедура ОповеститьОРезультатахСравнения()
	
	Если ПолноеСравнение Тогда
		Если ОбщееКоличествоОтличий = 0 Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Версии отчета идентичны'"));
		КонецЕсли;
	Иначе
		Если ИзмененныеОбласти.Количество() = 0 Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Версии выбранной страницы идентичны'"));
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимостьПоВариантуОтображения();
	УстановитьЗаголовокСравнения();
	ОбъединитьДанныеДокументовНаСервере();
		
	Если ТекущийВариантОтображения И ПоказыватьТолькоОтличия Тогда
		УправлениеВидимостьюСтрок(ТабличныйДокументСравнения);
	КонецЕсли;
	
	СохранитьНастройкиЦветов();
	
КонецПроцедуры	
	
&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			ЗагрузитьПодготовленныеДанные();
			ОповеститьОРезультатахСравнения();
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_ПроверитьВыполнениеЗадания", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные()
	
	РезультатПроверки = ПолучитьИзВременногоХранилища(АдресХранилища);
	РезультатПоОтчету = РезультатПроверки.Получить(1);
	
	ДеревоЗначенийСтраниц = РеквизитФормыВЗначение("ДеревоСтраниц");
	ОбщееКоличествоОтличий = 0;
	
	СтраницаВыведена = Ложь;
	Для Каждого РезультатПоСтроке Из РезультатПоОтчету Цикл
		
		СтруктураДанных = РезультатПоСтроке.Значение;
		
		СтрокаДляУстановки = ДеревоЗначенийСтраниц.Строки.Найти(РезультатПоСтроке.Ключ, "ИмяСтраницы", Истина);
		Если СтрокаДляУстановки <> Неопределено Тогда
			СтрокаДляУстановки.КоличествоОтличий = СтруктураДанных.ИзмененныеОбласти.Количество();
			ОбщееКоличествоОтличий = ОбщееКоличествоОтличий+СтрокаДляУстановки.КоличествоОтличий;
			СтрокаДляУстановки.АдресБланка1 = ПоместитьВоВременноеХранилище(СтруктураДанных.ТабличныйДокументВерсия1,УникальныйИдентификатор);
			СтрокаДляУстановки.АдресБланка2 = ПоместитьВоВременноеХранилище(СтруктураДанных.ТабличныйДокументВерсия2,УникальныйИдентификатор);
			СтрокаДляУстановки.АдресИзмененныеОбласти = ПоместитьВоВременноеХранилище(СтруктураДанных.ИзмененныеОбласти,УникальныйИдентификатор);
			СтрокаДляустановки.СравнениеВыполнено = Истина;
		КонецЕсли;
		
		Если Не СтраницаВыведена Тогда
			ИзмененныеОбласти.Загрузить(СтруктураДанных.ИзмененныеОбласти);
			ТабличныйДокументВерсия1.Очистить();
			ТабличныйДокументВерсия2.Очистить();
			ТабличныйДокументВерсия1.Вывести(СтруктураДанных.ТабличныйДокументВерсия1);
			ТабличныйДокументВерсия2.Вывести(СтруктураДанных.ТабличныйДокументВерсия2);
			ТабличныеДокументыЗаполнены = СтруктураДанных.ТабличныеДокументыЗаполнены;
			
			Если СтрокаДляУстановки<>Неопределено Тогда
				АдресТекущейСтраницы = СтрокаДляУстановки.АдресБланка1;
			КонецЕсли;
			ТекущееИмяСтраницы = РезультатПоСтроке.Ключ;
				
			СтраницаВыведена = Истина;
		КонецЕсли;		
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначенийСтраниц,"ДеревоСтраниц");
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЭлементНабораПараметров(Тдок1,Тдок2)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ТабличныеДокументыЗаполнены", ТабличныеДокументыЗаполнены);
	
	ТаблДок1 = Новый ТабличныйДокумент;
	ТаблДок1.Вывести(Тдок1);
	СтруктураПараметров.Вставить("ТабличныйДокументВерсия1", ТаблДок1);
	
	ТаблДок2 = Новый ТабличныйДокумент;
	ТаблДок2.Вывести(Тдок2);
	СтруктураПараметров.Вставить("ТабличныйДокументВерсия2", ТаблДок2);
	
	СтруктураПараметров.Вставить("Версия1", Версия1);
	СтруктураПараметров.Вставить("Версия2", Версия2);
	СтруктураПараметров.Вставить("Версия1ДанныеЗаполнения", Параметры.Версия1ДанныеЗаполнения);
	СтруктураПараметров.Вставить("Версия2ДанныеЗаполнения", Параметры.Версия2ДанныеЗаполнения);
	СтруктураПараметров.Вставить("ТабличныйДокумент1Заполнен", ТабличныйДокумент1Заполнен);
	СтруктураПараметров.Вставить("ТабличныйДокумент2Заполнен", ТабличныйДокумент2Заполнен);
	СтруктураПараметров.Вставить("НастройкаИсключений", Параметры.НастройкаИсключений);
	
	СтруктураПараметров.Вставить("ХранимыйФайл", ХранимыйФайл);
	СтруктураПараметров.Вставить("ОтчетСсылка", ОтчетСсылка);
	СтруктураПараметров.Вставить("ИзмененныеОбласти", ИзмененныеОбласти.Выгрузить());
	
	СтруктураПараметров.Вставить("ВариантСравнения", ВариантСравнения);
	
	ЦветаИзменений = Новый Структура;
	ЦветаИзменений.Вставить("ЦветТекстаВПервом",ЦветТекстаВПервом);
	ЦветаИзменений.Вставить("ЦветТекстаВоВтором",ЦветТекстаВоВтором);
	ЦветаИзменений.Вставить("ЦветФонаВПервом",ЦветФонаВПервом);
	ЦветаИзменений.Вставить("ЦветФонаВоВтором",ЦветФонаВоВтором);
	ЦветаИзменений.Вставить("ЦветФонаИзмененные",ЦветФонаИзмененные);
	ЦветаИзменений.Вставить("ЦветТекстаИзмененные",ЦветТекстаИзмененные);
	СтруктураПараметров.Вставить("ЦветаИзменений", ЦветаИзменений);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Функция ВыполнитьСравнениеНаСервере()
	
	ПараметрыПоОтчету = Новый Соответствие;
	
	Если ПолноеСравнение Тогда 
		
		ДеревоЗначенийСтраниц = РеквизитФормыВЗначение("ДеревоСтраниц");
		МассивСтраниц = Новый Массив;
		БюджетнаяОтчетностьСервер.ЗаполнитьСтраницыБланкаПоИерархии(ДеревоЗначенийСтраниц.Строки, МассивСтраниц);
		
		ПерваяСтраницаВыведена = Ложь;
		
		ТабличныйДокументВерсия1.Очистить();
		ТабличныйДокументВерсия2.Очистить();
		
		Для Каждого СтраницаБланка Из МассивСтраниц Цикл
			
			ТаблДок1 = Новый ТабличныйДокумент;
			Если ЗначениеЗаполнено(СтраницаБланка.АдресБланка1) Тогда
				ТаблДок1 = ПолучитьИзВременногоХранилища(СтраницаБланка.АдресБланка1);				
			КонецЕсли;
			
			ТаблДок2 = Новый ТабличныйДокумент;
			Если ЗначениеЗаполнено(СтраницаБланка.АдресБланка2) Тогда
				ТаблДок2 = ПолучитьИзВременногоХранилища(СтраницаБланка.АдресБланка2);				
			КонецЕсли;
			
			Если НЕ ПерваяСтраницаВыведена Тогда
				ТабличныйДокументВерсия1.Вывести(ТаблДок1);
				ТабличныйДокументВерсия2.Вывести(ТаблДок2);
				АдресТекущейСтраницы = СтраницаБланка.АдресБланка1;
				ПерваяСтраницаВыведена = Истина;
			КонецЕсли;
			
			ПараметрыПоОтчету.Вставить(СтраницаБланка.ИмяСтраницы, ЗаполнитьЭлементНабораПараметров(ТаблДок1,ТаблДок2));
			
		КонецЦикла
		
	Иначе
		
		ПараметрыПоОтчету.Вставить(ТекущееИмяСтраницы, ЗаполнитьЭлементНабораПараметров(ТабличныйДокументВерсия1,ТабличныйДокументВерсия2));
		
	КонецЕсли;		
	
	НаборПараметров = Новый Соответствие;
	НаборПараметров.Вставить(1, ПараметрыПоОтчету);
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Сравнение версий отчета'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор, 
		"Документы.УниверсальныйРегламентированныйОтчет.СравнитьВерсииПакетно",
		НаборПараметров, 
		НаименованиеФоновогоЗадания);
		
	АдресХранилища       = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ЗагрузитьПодготовленныеДанные();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЦветФонаПоляНаСервере()
	Возврат ЦветаСтиля.ЦветФонаПоля;
КонецФункции

&НаСервере
Процедура ЗаполнитьЦветаПоУмолчанию()
	ЦветФонаИзмененные =  Новый Цвет(224, 255, 255);
	ЦветТекстаИзмененные = Новый Цвет(255, 0, 0);
	
	ЦветФонаВПервом = Новый Цвет(255, 228, 196);
	ЦветТекстаВПервом = Новый Цвет(0, 0, 255);
	
	ЦветФонаВоВтором = Новый Цвет(192, 220, 192);
	ЦветТекстаВоВтором = Новый Цвет(0, 128, 0);
КонецПроцедуры

&НаСервере
Процедура УстановитьЦветаОтличий()
	
	ОбразецИзмененные = "текст";
	Элементы.ОбразецИзмененные.ЦветФона = ЦветФонаИзмененные;
	Элементы.ОбразецИзмененные.ЦветТекста = ЦветТекстаИзмененные;
	
	ОбразецВПервом = "текст";
	Элементы.ОбразецВПервом.ЦветФона = ЦветФонаВПервом;
	Элементы.ОбразецВПервом.ЦветТекста = ЦветТекстаВПервом;
	
	ОбразецВоВтором = "текст";
	Элементы.ОбразецВоВтором.ЦветФона = ЦветФонаВоВтором;
	Элементы.ОбразецВоВтором.ЦветТекста = ЦветТекстаВоВтором;
	
КонецПроцедуры

&НаСервере
Процедура ОбъединитьДанныеДокументовНаСервере()
	
	Элементы.ОшибкаСравнения.Видимость = Ложь;
	ТабличныйДокументСравнения.Очистить();
	
	Если ТекущийВариантОтображения = 2 Тогда
		// Вывод горизонтально, с вертикальным разделителем.
		ШиринаИсходныхТаблиц = ТабличныйДокументВерсия1.ШиринаТаблицы+3;
		НомерКолонкиРазделителя = ШиринаИсходныхТаблиц-1;
		ВысотаИсходныхТаблиц = Макс(ТабличныйДокументВерсия1.ВысотаТаблицы,ТабличныйДокументВерсия2.ВысотаТаблицы);
		
		ЧастьДляВывода1 = ТабличныйДокументВерсия1.ПолучитьОбласть(1,1,ВысотаИсходныхТаблиц,ШиринаИсходныхТаблиц);
		ТабличныйДокументСравнения.Вывести(ЧастьДляВывода1);
		
		СтруктураНовыхИмен = Новый Структура();
		Для Каждого ИменованнаяОбласть Из ТабличныйДокументСравнения.Области Цикл
			СтруктураНовыхИмен.Вставить(ИменованнаяОбласть.Имя, ИменованнаяОбласть.Имя+"_Версия1");
		КонецЦикла;
		
		Для Каждого ЗаменаИмени Из СтруктураНовыхИмен Цикл
			ОбластьДляИзменения = ТабличныйДокументСравнения.Области[ЗаменаИмени.Ключ];
			ОбластьДляИзменения.Имя = ЗаменаИмени.Значение;
		КонецЦикла;
				
		ЧастьДляВывода2 = ТабличныйДокументВерсия2.ПолучитьОбласть(1,1,ВысотаИсходныхТаблиц,ШиринаИсходныхТаблиц);
		ТабличныйДокументСравнения.Присоединить(ЧастьДляВывода2);
		
		ТабличныйДокументСравнения.Область(1,ШиринаИсходныхТаблиц-2,ВысотаИсходныхТаблиц,ШиринаИсходныхТаблиц).ШиринаКолонки = 1;
		ТабличныйДокументСравнения.Область(1,НомерКолонкиРазделителя,ВысотаИсходныхТаблиц).ЦветФона = WebЦвета.Черный;
		
		//Проверка корректности вывода документа.
		Для Сч = 1 По ВысотаИсходныхТаблиц Цикл
			Если НЕ ТабличныйДокументСравнения.Область(Сч,НомерКолонкиРазделителя).ЦветФона = WebЦвета.Черный Тогда
				Элементы.ОшибкаСравнения.Видимость = Истина;
				Элементы.ОшибкаСравнения.Заголовок = НСтр("ru='В исходном документе для разных групп строк задан разный формат колонок. 
				|В текущем варианте отображения бланк отчета выведен не полностью.'");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТекущийВариантОтображения = 3 Тогда
		// Вывод вертикально, с горизонтальным разделителем.
		ШиринаИсходныхТаблиц = Макс(ТабличныйДокументВерсия1.ШиринаТаблицы,ТабличныйДокументВерсия2.ШиринаТаблицы);
		ВысотаИсходныхТаблиц = ТабличныйДокументВерсия1.ВысотаТаблицы+3;
		
		ТабличныйДокументСравнения.Вывести(ТабличныйДокументВерсия1);
		
		СтруктураНовыхИмен = Новый Структура();
		Для Каждого ИменованнаяОбласть Из ТабличныйДокументСравнения.Области Цикл
			СтруктураНовыхИмен.Вставить(ИменованнаяОбласть.Имя, ИменованнаяОбласть.Имя+"_Версия1");
		КонецЦикла;
		
		Для Каждого ЗаменаИмени Из СтруктураНовыхИмен Цикл
			ОбластьДляИзменения = ТабличныйДокументСравнения.Области[ЗаменаИмени.Ключ];
			ОбластьДляИзменения.Имя = ЗаменаИмени.Значение;
		КонецЦикла;
		
		ТабличныйДокументСравнения.Область(ВысотаИсходныхТаблиц-2,1,ВысотаИсходныхТаблиц).ВысотаСтроки = 4;
		ТабличныйДокументСравнения.Область(ВысотаИсходныхТаблиц-1,1,ВысотаИсходныхТаблиц-1,ШиринаИсходныхТаблиц).ЦветФона = WebЦвета.Черный;
		ТабличныйДокументСравнения.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокументСравнения.Вывести(ТабличныйДокументВерсия2);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПоВариантуОтображения()
	
	Если ТекущийВариантОтображения = 1 Тогда
		Элементы.ТабличныеДокументыСтраницы.ТекущаяСтраница = Элементы.СтраницаВерсии;
	Иначе	
		Элементы.ТабличныеДокументыСтраницы.ТекущаяСтраница = Элементы.СтраницаСравнение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокСравнения()
	
	ШаблонДокументСравнения = НСтр("ru='Отличия между ""%1"" и ""%2""'");
	ЗаголовокДокументСравнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДокументСравнения, Строка(Элементы.ТабличныйДокументВерсия1.Заголовок),Строка(Элементы.ТабличныйДокументВерсия2.Заголовок));
	Элементы.ТабличныйДокументСравнения.Заголовок = ЗаголовокДокументСравнения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоРазличиямВариантСтандартный(ПрямойОбход)
	
	ТекущаяОбласть = ?(Документ1Активный, ТабличныйДокументВерсия1.ТекущаяОбласть,ТабличныйДокументВерсия2.ТекущаяОбласть);
	
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("ИмяОбласти1", "");
	ПараметрыОбласти.Вставить("ИмяОбласти2", "");
	ПараметрыОбласти.Вставить("ВсяСтрока", Ложь);
		
	Для Каждого СтрокаИзменений Из ИзмененныеОбласти Цикл
		Если ПрямойОбход Тогда
			Если СтрокаИзменений.ОбластьВерх >= ТекущаяОбласть.Верх Тогда
				Если СтрокаИзменений.ОбластьВерх > ТекущаяОбласть.Верх Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ОбластьСоответствия;
						Документ1Активный = Истина;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 2 Тогда
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Документ1Активный = Ложь;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 3 Тогда	
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Документ1Активный = Истина;
						Прервать;
					КонецЕсли;
				ИначеЕсли СтрокаИзменений.ОбластьЛево > ТекущаяОбласть.Лево Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ОбластьСоответствия;
						Документ1Активный = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		Иначе
			Если СтрокаИзменений.ОбластьВерх <= ТекущаяОбласть.Верх Тогда
				Если СтрокаИзменений.ОбластьВерх < ТекущаяОбласть.Верх Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ОбластьСоответствия;
						Документ1Активный = Истина;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 2 Тогда
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Документ1Активный = Ложь;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 3 Тогда	
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Документ1Активный = Истина;
						Прервать;
					КонецЕсли;
				ИначеЕсли СтрокаИзменений.ОбластьЛево < ТекущаяОбласть.Лево Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ИмяОбласти2 = СтрокаИзменений.ОбластьСоответствия;
						Документ1Активный = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ПараметрыОбласти.ИмяОбласти1) Тогда
		ОбластьВыделения = ТабличныйДокументВерсия1.Область(ПараметрыОбласти.ИмяОбласти1);
		Если ПараметрыОбласти.ВсяСтрока Тогда
			ОбластьВсяСтрока = ТабличныйДокументВерсия1.Область(ОбластьВыделения.Верх,1,ОбластьВыделения.Низ,ТабличныйДокументВерсия1.ШиринаТаблицы);
			Элементы.ТабличныйДокументВерсия1.ТекущаяОбласть = ОбластьВсяСтрока;
		Иначе
			Элементы.ТабличныйДокументВерсия1.ТекущаяОбласть = ОбластьВыделения;
		КонецЕсли;
	КонецЕсли;	
	Если Не ПустаяСтрока(ПараметрыОбласти.ИмяОбласти2) Тогда
		ОбластьВыделения = ТабличныйДокументВерсия2.Область(ПараметрыОбласти.ИмяОбласти2);
		Если ПараметрыОбласти.ВсяСтрока Тогда
			ОбластьВсяСтрока = ТабличныйДокументВерсия2.Область(ОбластьВыделения.Верх,1,ОбластьВыделения.Низ,ТабличныйДокументВерсия2.ШиринаТаблицы);
			Элементы.ТабличныйДокументВерсия2.ТекущаяОбласть = ОбластьВсяСтрока;
		Иначе
			Элементы.ТабличныйДокументВерсия2.ТекущаяОбласть = ОбластьВыделения;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоРазличиямВариантВариантВОдномПоле(ПрямойОбход)
	
	ТекущаяОбласть = ТабличныйДокументСравнения.ТекущаяОбласть;
	
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("ИмяОбласти1", "");
	ПараметрыОбласти.Вставить("ВсяСтрока", Ложь);
		
	Для Каждого СтрокаИзменений Из ИзмененныеОбласти Цикл
		Если ПрямойОбход Тогда
			Если СтрокаИзменений.ОбластьВерх >= ТекущаяОбласть.Верх Тогда
				Если СтрокаИзменений.ОбластьВерх > ТекущаяОбласть.Верх Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 3 Тогда	
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Прервать;
					КонецЕсли;
				ИначеЕсли СтрокаИзменений.ОбластьЛево > ТекущаяОбласть.Лево Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		Иначе
			Если СтрокаИзменений.ОбластьВерх <= ТекущаяОбласть.Верх Тогда
				Если СтрокаИзменений.ОбластьВерх < ТекущаяОбласть.Верх Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						Прервать;
					ИначеЕсли СтрокаИзменений.ВидРасхождений = 3 Тогда	
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						ПараметрыОбласти.ВсяСтрока = Истина;
						Прервать;
					КонецЕсли;
				ИначеЕсли СтрокаИзменений.ОбластьЛево < ТекущаяОбласть.Лево Тогда
					Если СтрокаИзменений.ВидРасхождений = 1 Тогда
						ПараметрыОбласти.ИмяОбласти1 = СтрокаИзменений.ИмяОбласти;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ПараметрыОбласти.ИмяОбласти1) Тогда
		Если НЕ ТабличныйДокументСравнения.Области.Найти(ПараметрыОбласти.ИмяОбласти1+"_Версия1") = Неопределено Тогда
			ОбластьВыделения = ТабличныйДокументСравнения.Область(ПараметрыОбласти.ИмяОбласти1+"_Версия1");
			Если ПараметрыОбласти.ВсяСтрока Тогда
				ОбластьВсяСтрока = ТабличныйДокументСравнения.Область(ОбластьВыделения.Верх,1,ОбластьВыделения.Низ,ТабличныйДокументВерсия1.ШиринаТаблицы);
				Элементы.ТабличныйДокументСравнения.ТекущаяОбласть = ОбластьВсяСтрока;
			Иначе
				Элементы.ТабличныйДокументСравнения.ТекущаяОбласть = ОбластьВыделения;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПоказыватьТолькоОтличияНаСервере()
	
	//Управление отображением строк
	УправлениеВидимостьюСтрок(ТабличныйДокументВерсия1);
	УправлениеВидимостьюСтрок(ТабличныйДокументВерсия2);
	
	Если ТекущийВариантОтображения <> 1 Тогда
		УправлениеВидимостьюСтрок(ТабличныйДокументСравнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюСтрок(ТаблДокВидимость)
	
	СоответствиеСкрытыхСтрок = Новый Соответствие;
	
	КоллекцияОбластей = ТаблДокВидимость.Области;
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если Найти(ТекОбл.Имя, "Колонка_") = 0 Тогда
			Для СчСтрок = ТекОбл.Верх По ТекОбл.Низ Цикл
				СоответствиеСкрытыхСтрок.Вставить(СчСтрок,Истина);
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
	Для НомСтроки = 1 По ТаблДокВидимость.ВысотаТаблицы Цикл
		ВидимостьСтроки = НЕ ПоказыватьТолькоОтличия ИЛИ СоответствиеСкрытыхСтрок[НомСтроки]=Неопределено;
		
		Если ВидимостьСтроки = Ложь  Тогда
			Для НомКолонки = 1 По ТаблДокВидимость.ШиринаТаблицы Цикл
				ОбластьПроверки = ТаблДокВидимость.Область(НомСтроки, НомКолонки, НомСтроки, НомКолонки);
				
				Если ОбластьПроверки.ЦветФона <> ЦветФонаПустой 
					И ОбластьПроверки.ЦветФона <> WebЦвета.Черный Тогда
					
					ВидимостьСтроки = Истина;
					Прервать;
				КонецЕсли;	
					
			КонецЦикла;
		КонецЕсли;	
		
		ТаблДокВидимость.Область(НомСтроки,,НомСтроки).Видимость = ВидимостьСтроки;
		
	КонецЦикла;

КонецПроцедуры

