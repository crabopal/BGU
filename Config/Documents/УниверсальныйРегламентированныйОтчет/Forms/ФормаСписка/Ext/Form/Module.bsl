&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДополнительныеПараметры = Новый Структура;                      
	ДополнительныеПараметры.Вставить("РежимРаботы",РежимДиалогаВыбораФайла.ВыборКаталога);
	ДополнительныеПараметры.Вставить("Каталог",ОбработкаВыгрузки.ПутьВыгрузки);
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтаФорма, ДополнительныеПараметры));
	
	ДополнительныеПараметры.Вставить("ОбработкаВыгрузки",ОбработкаВыгрузки);
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

