#Область ОбменССервисом

&НаКлиенте
Процедура ОбновитьРабочиеПериоды(Команда)
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = Нстр("ru='Не выбрана учетная запись обмена со Сводом отчетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	ОбновитьРПНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.РабочиеПериодыПредоставленияОтчетности"));
КонецПроцедуры

&НаСервере
Процедура ОбновитьРПНаСервере()
	
	WSПрокси = ПолучитьWSПроксиОбмена(30);
	
	Таб = Неопределено;
	Таб = WSПрокси.GetReportPeriod();
	
	ПолученныеПериоды = Таб.Получить();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеПериодыПредоставленияОтчетности.Ссылка,
		|	РабочиеПериодыПредоставленияОтчетности.КодСценария,
		|	РабочиеПериодыПредоставленияОтчетности.НаименованиеСценария,
		|	РабочиеПериодыПредоставленияОтчетности.Период.ДатаНачала КАК ДатаНачала,
		|	РабочиеПериодыПредоставленияОтчетности.Период.Периодичность КАК Периодичность,
		|	РабочиеПериодыПредоставленияОтчетности.ПериодОткрыт
		|ИЗ
		|	Справочник.РабочиеПериодыПредоставленияОтчетности КАК РабочиеПериодыПредоставленияОтчетности";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаТекущих = РезультатЗапроса.Выгрузить();
	ТаблицаТекущих.Колонки.Добавить("Обработан",Новый ОписаниеТипов("Булево"));
	
	СтруктураПоиска = Новый Структура("КодСценария,ДатаНачала,Периодичность");
	
	МенеджерПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
	
	Для Каждого СтрТЧ Из ПолученныеПериоды Цикл
		
		СтруктураПоиска.КодСценария = СтрТЧ.СценарийКод;
		СтруктураПоиска.ДатаНачала = СтрТЧ.ДатаНачала;
		СтруктураПоиска.Периодичность = МенеджерПериодичность[СтрТЧ.ПериодичностьИмя];
		
		МассивСтрок = ТаблицаТекущих.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() = 0 Тогда
			//Создадим новые рабочие периоды
			ТекОбъект = Справочники.РабочиеПериодыПредоставленияОтчетности.СоздатьЭлемент();
			ТекОбъект.ПериодОткрыт = СтрТЧ.ПериодОткрыт;
			ТекОбъект.НаименованиеСценария = СтрТЧ.СценарийНаименование;
			ТекОбъект.КодСценария = СтрТЧ.СценарийКод;
			ТекОбъект.Период = Справочники.Периоды.НайтиСоздатьПериод(СтруктураПоиска.Периодичность, СтруктураПоиска.ДатаНачала);
			ТекОбъект.Записать();
		Иначе
			МассивСтрок[0].Обработан = Истина;
			//Обновим наименование у имеющихся
			Если МассивСтрок[0].ПериодОткрыт <> СтрТЧ.ПериодОткрыт
				ИЛИ МассивСтрок[0].НаименованиеСценария <> СтрТЧ.СценарийНаименование Тогда
				ТекОбъект = МассивСтрок[0].Ссылка.ПолучитьОбъект();
				ТекОбъект.ПериодОткрыт = СтрТЧ.ПериодОткрыт;
				ТекОбъект.НаименованиеСценария = СтрТЧ.СценарийНаименование;
				ТекОбъект.Записать();
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	//Для всех остальных закроем период
	МассивСтрок = ТаблицаТекущих.НайтиСтроки(Новый Структура("Обработан,ПериодОткрыт",Ложь,Истина));
	Для Каждого ЗакрытыйПериод Из МассивСтрок Цикл
		ТекОбъект = ЗакрытыйПериод.Ссылка.ПолучитьОбъект();
		ТекОбъект.ПериодОткрыт = Ложь;
		ТекОбъект.Записать();		
	КонецЦикла;

КонецПроцедуры


&НаСервере
Функция ПолучитьWSПроксиОбмена(Таймаут)
	
	Возврат Справочники.УчетныеЗаписиОбменаСводаОтчетов.ПолучитьWSПроксиОбмена(УчетнаяЗапись,Истина,Таймаут);
		
КонецФункции


&НаКлиенте
Процедура РабочийПериодПриИзменении(Элемент)
	УстановитьОтборы();
КонецПроцедуры


&НаСервере
Процедура УчетнаяЗаписьПриИзмененииНаСервере()
	Если РежимРаботы = 1 
		И ИспользоватьОбменСоСводомОтчетов Тогда
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			Элементы.ВыборУчетнойЗаписи.Заголовок = "Учетная запись: """+Строка(УчетнаяЗапись)+"""";
			ОбработкаВыгрузки.ФорматВыгрузки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись,"ФорматОбмена");
			ОбработкаВыгрузки.СпособВыгрузки = ОбменЧерезВебСервис;
			ВидимостьЭП = ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ПоказыватьСтраницуЭЦП(ОбработкаВыгрузки.СпособВыгрузки);

			Элементы.ГруппаЭППакета.Видимость = ВидимостьЭП;
			ИзменитьВидимостьСтраницыЭП(ВидимостьЭП);
		Иначе
			Элементы.ВыборУчетнойЗаписи.Заголовок = "Выбрать учетную запись";
			ОбработкаВыгрузки.ФорматВыгрузки = Неопределено;
			ОбработкаВыгрузки.СпособВыгрузки = Неопределено;
		КонецЕсли;
		ФорматВыгрузкиПриИзмененииНаСервере();
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиТаблицаПодготовленныхПакетов

&НаКлиенте
Процедура ТаблицаПодготовленныхПакетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя <> "ТаблицаПодготовленныхПакетовОтметка" Тогда
		ТекСтрока = ТаблицаПодготовленныхПакетов.НайтиПоИдентификатору(ВыбраннаяСтрока);
		ПоказатьЗначение(,ТекСтрока.ПакетВыгрузки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПодготовленныхПакетов()
	
	
	ТаблицаПодготовленныхПакетов.Очистить();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетВыгрузкиОтчетности.Ссылка КАК ПакетВыгрузки,
		|	ПакетВыгрузкиОтчетности.Номер,
		|	ПакетВыгрузкиОтчетности.Дата КАК Дата,
		|	ПакетВыгрузкиОтчетности.Организация,
		|	ПакетВыгрузкиОтчетности.Период,
		|	ПакетВыгрузкиОтчетности.ФорматВыгрузки,
		|	ИсторияСостоянийПакетаОтчетовСрезПоследних.Состояние
		|ИЗ
		|	РегистрСведений.ИсторияСостоянийПакетаОтчетов.СрезПоследних КАК ИсторияСостоянийПакетаОтчетовСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
		|		ПО ИсторияСостоянийПакетаОтчетовСрезПоследних.ПакетОтчетов = ПакетВыгрузкиОтчетности.Ссылка
		|			И (ИсторияСостоянийПакетаОтчетовСрезПоследних.Состояние = &Подготовлен)
		|			И (ПакетВыгрузкиОтчетности.СпособВыгрузки = &ВебСервис)
		|ГДЕ
		|	(ПакетВыгрузкиОтчетности.Организация В (&Организации)
		|			ИЛИ &БезОтбораПоОрганизации)
		|	И ПакетВыгрузкиОтчетности.Период = &Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
	Запрос.УстановитьПараметр("ВебСервис", ОбменЧерезВебСервис);
	Запрос.УстановитьПараметр("Подготовлен", Перечисления.СостоянияПакетаОтчетов.Сформирован);
	Запрос.УстановитьПараметр("Организации", ОтборОрганизация.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Период", РабочийПериод);
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации", Не ИспользоватьОтборОрганизаций);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ТаблицаПодготовленныхПакетов.Загрузить(РезультатЗапроса.Выгрузить());
	
	КоличествоПодготовленныхПакетов = ТаблицаПодготовленныхПакетов.Количество();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодготовленныеПакеты(Команда)
	ЗаполнитьТаблицуПодготовленныхПакетов();
КонецПроцедуры

&НаСервере
Процедура ОтправитьПакетыНаСервере(МассивОтчетов = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.ДанныеФайлов КАК ДанныеФайлов,
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка.Организация КАК Организация,
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка КАК Ссылка,
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка.Дата КАК Дата,
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка.Номер КАК Номер
		|ИЗ
		|	Документ.ПакетВыгрузкиОтчетности.ФайлыОтчетов КАК ПакетВыгрузкиОтчетностиФайлыОтчетов
		|ГДЕ
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка В(&Ссылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетВыгрузкиОтчетностиФайлыОтчетов.НомерСтроки";
		
	Если МассивОтчетов = Неопределено Тогда	
		
		МассивСтрок = ТаблицаПодготовленныхПакетов.НайтиСтроки(Новый Структура("Отметка",Истина));
		МассивПакетов = Новый Массив;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			МассивПакетов.Добавить(ЭлМас.ПакетВыгрузки);	
		КонецЦикла;
	Иначе
		МассивПакетов = МассивОтчетов;
	КонецЕсли;
	Если МассивПакетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечен ни один пакет отчетов для отправки.'"));
		Возврат;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", МассивПакетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	WSПрокси = ПолучитьWSПроксиОбмена(Неопределено);
	
	ТаблицаПакетовОбмена = Новый ТаблицаЗначений;
	ТаблицаПакетовОбмена.Колонки.Добавить("ПакетОтчетов");
	ТаблицаПакетовОбмена.Колонки.Добавить("Состояние");
	ТаблицаПакетовОбмена.Колонки.Добавить("ИндексКартинкиСостояния");
	ТаблицаПакетовОбмена.Колонки.Добавить("Период");
	
	СоответствиеКартинок = Новый Соответствие;
	СоответствиеКартинок.Вставить(Перечисления.СостоянияПакетаОтчетов.Отправлен,3);
	СоответствиеКартинок.Вставить(Перечисления.СостоянияПакетаОтчетов.ОтклоненАдресатом,5);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекДанные = ВыборкаДетальныеЗаписи.ДанныеФайлов.Получить();	
		
		ДатаОбмена = ТекущаяДатаСеанса();
		
		Результат = WSПрокси.ImportReport(ТекДанные);
		СтруктураРезультата = Результат.Получить();
		
		ПротоколЗагрузки = Неопределено;
		ПротоколОбработки = Неопределено;
		ПротоколПроверки = Неопределено;
		Комментарий = Неопределено;
		
		СтруктураРезультата.Свойство("ПротоколЗагрузкиФайлов",ПротоколЗагрузки);
		СтруктураРезультата.Свойство("ПротоколОбработкиОтчетов",ПротоколОбработки);
		СтруктураРезультата.Свойство("ПротоколПроверки",ПротоколПроверки);
		СтруктураРезультата.Свойство("Комментарий",Комментарий);
		
		
		
		ЗаписьРегистраИстории = РегистрыСведений.ИсторияСостоянийПакетаОтчетов.СоздатьМенеджерЗаписи();
		ЗаписьРегистраИстории.ПакетОтчетов = ВыборкаДетальныеЗаписи.Ссылка;
		ЗаписьРегистраИстории.Период = ТекущаяДатаСеанса();
		
		ЗаписьРегистраИстории.Состояние = ?(СтруктураРезультата.ЗагрузкаВыполнялась = Истина,Перечисления.СостоянияПакетаОтчетов.Отправлен,Перечисления.СостоянияПакетаОтчетов.ОтклоненАдресатом);
		
		ЗаписьРегистраИстории.ПротоколИмпорта = Новый ХранилищеЗначения(ПротоколЗагрузки);
		ЗаписьРегистраИстории.ПротоколОбработки = Новый ХранилищеЗначения(ПротоколОбработки);
		ЗаписьРегистраИстории.ПротоколПроверки = Новый ХранилищеЗначения(ПротоколПроверки);
		ЗаписьРегистраИстории.Комментарий = Комментарий;
		
		НовСтр = ТаблицаПакетовОбмена.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,ЗаписьРегистраИстории);
		НовСтр.ИндексКартинкиСостояния = СоответствиеКартинок[НовСтр.Состояние];
		
		ЗаписьРегистраИстории.Записать(Истина);
		
		ЕстьТаблицаДанныхОтчетов = Ложь;
		Если СтруктураРезультата.Свойство("ТаблицаДанныхОтчетов") Тогда
			ЕстьТаблицаДанныхОтчетов = Истина;
			Для Каждого СтрТЧ Из СтруктураРезультата.ТаблицаДанныхОтчетов Цикл
				ЗаписьРегистра = РегистрыСведений.СостоянияОтправленныхОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.Период = СтрТЧ.Период;
				ЗаписьРегистра.Организация = ВыборкаДетальныеЗаписи.Организация;
				ЗаписьРегистра.ДокументОтчет = ВернутьСсылку(СтрТЧ.GUIDИсходногоДокумента);
				ЗаписьРегистра.Состояние = Перечисления.СостоянияОтчетов[СтрТЧ.Состояние];
				ЗаписьРегистра.Комментарий = СтрТЧ.Комментарий;
				ЗаписьРегистра.ПричинаИзмененияСостояния = СтрТЧ.ПричинаИзмененияСостояния;
				ЗаписьРегистра.Записать(Истина);
			КонецЦикла;
		КонецЕсли;
		
		Если СтруктураРезультата.Свойство("ТаблицаРезультатовЗагрузки") Тогда
			
			Если ЕстьТаблицаДанныхОтчетов Тогда
				СтруктураРезультата.ТаблицаДанныхОтчетов.Индексы.Добавить("GUIDИсходногоДокумента");
			КонецЕсли;		
			
			Для Каждого СтрТЧ Из СтруктураРезультата.ТаблицаРезультатовЗагрузки Цикл
				
				
				ТекДатаОбмена = ДатаОбмена; //если никуда не загрузился, дата обмена по умолчанию
				НужнаяСтрока = Неопределено;
				Если ЕстьТаблицаДанныхОтчетов Тогда
					НужнаяСтрока = СтруктураРезультата.ТаблицаДанныхОтчетов.Найти(СтрТЧ.GUIDИсходногоДокумента,"GUIDИсходногоДокумента");
				КонецЕсли;	
				Если НужнаяСтрока <> Неопределено Тогда
					ТекДатаОбмена = НужнаяСтрока.Период;// если загрузился в отчет	
				ИначеЕсли ЗначениеЗаполнено(СтрТЧ.ДатаИзмененияФайла) Тогда
					ТекДатаОбмена = СтрТЧ.ДатаИзмененияФайла;// если загрузился в хранимые файлы	
				КонецЕсли;
				
				ЗаписьРегистра = РегистрыСведений.ИсторияОбменаСоСводомОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.Период = ТекДатаОбмена;
				ЗаписьРегистра.Организация = ВыборкаДетальныеЗаписи.Организация;
				ЗаписьРегистра.ЭкземплярОтчета = ВернутьСсылку(СтрТЧ.GUIDИсходногоДокумента);
								
				ЗаписьРегистра.ВходнойКонтроль = (СтрТЧ.Ошибка = Ложь);
				Если ЗначениеЗаполнено(СтрТЧ.Состояние) Тогда
					ЗаписьРегистра.Состояние = Перечисления.СостоянияОтчетов[СтрТЧ.Состояние];
				КонецЕсли;
				ЗаписьРегистра.ЗагруженВВерсииХранимыхФайлов = СтрТЧ.ЗагруженВВерсииХранимыхФайлов;//1 - все ок, 2 - ошибка, 0 - не выполнялось
				ЗаписьРегистра.ЗагруженВОтчет = СтрТЧ.ЗагруженВОтчет;							   //1 - все ок, 2 - ошибка, 0 - не выполнялось
				ЗаписьРегистра.СообщениеОбОшибке = СтрТЧ.Сообщения;
				ЗаписьРегистра.КСОшибки = СтрТЧ.КСОшибки;
				ЗаписьРегистра.КСПредупреждения = СтрТЧ.КСПредупреждения;
				ЗаписьРегистра.КСПроверкаВыполнена = СтрТЧ.КСПроверкаВыполнена;
				
				ЗаписьРегистра.ДатаДокументаПакета = ВыборкаДетальныеЗаписи.Дата;
				ЗаписьРегистра.НомерДокументаПакета = ВыборкаДетальныеЗаписи.Номер;
				
				ЗаписьРегистра.Записать(Истина);
			КонецЦикла;	
		КонецЕсли;
		
	КонецЦикла;
	АдресТаблицыПакетовОбмена = ПоместитьВоВременноеХранилище(ТаблицаПакетовОбмена,УникальныйИдентификатор);
	
	ЗаполнитьТаблицуПодготовленныхПакетов();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьСсылку(ГУИД)
	Возврат Документы.УниверсальныйРегламентированныйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));	
КонецФункции

&НаКлиенте
Процедура ОтправитьПакеты(Команда)
	ОтправитьВыбранныеПакеты();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыбранныеПакеты(ВыбранныеПакеты = Неопределено)
	ОтправитьПакетыНаСервере(ВыбранныеПакеты);
	ПараметрыФормы = Новый Структура("АдресТаблицыПакетовОбмена",АдресТаблицыПакетовОбмена);
	ОткрытьФорму("РегистрСведений.ИсторияСостоянийПакетаОтчетов.Форма.ФормаРезультатаОбмена",ПараметрыФормы,ЭтотОбъект,Истина);	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзмененияСостояний(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ТекДанные.Свойство("Ссылка") Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("ДокументОтчет",ТекДанные.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор",Отбор);
	ОткрытьФорму("РегистрСведений.СостоянияОтправленныхОтчетов.ФормаСписка",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПодготовленныхПакетовПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.ТаблицаПодготовленныхПакетов.ТекущиеДанные;
	ОтборПоПакету = Неопределено;
	Если ТекСтрока <> Неопределено Тогда
		ОтборПоПакету = ТекСтрока.ПакетВыгрузки;
	КонецЕсли;
	ОтчетыПакета.Параметры.УстановитьЗначениеПараметра("Ссылка",ОтборПоПакету);
	ЭППакета.Параметры.УстановитьЗначениеПараметра("Ссылка",ОтборПоПакету);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНовыеПодписиПакета(Результат ,СтруктураДанных) Экспорт
	Если СтруктураДанных.Отказ Тогда 
		Возврат;  
	КонецЕсли;
	
	ЗаписатьНовыеПодписиПакетаСервере(СтруктураДанных);
	ОповеститьОбИзменении(СтруктураДанных.ОписаниеПодписываемогоОбъекта);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНовыеПодписиПакетаСервере(СтруктураДанных)
	Если СтруктураДанных.Отказ Тогда 
		Возврат;  
	КонецЕсли;
	
	ТекущийОбъект = СтруктураДанных.ОписаниеПодписываемогоОбъекта.ПолучитьОбъект();
	ТекущийОбъект.ДобавитьНовыеПодписи(СтруктураДанных);
	ТекущийОбъект.Записать();
	Элементы.ЭППакета.Обновить();
	
КонецПроцедуры


&НаКлиенте
Процедура ПодписатьПакет(Команда)
	ТекПакет = ЭППакета.Параметры.Элементы[0].Значение;
	
	Если ЗначениеЗаполнено(ТекПакет) Тогда
		СтруктураДанных = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СформироватьСтруктуруДанныхДляУстановкиПодписей();
		СтруктураДанных.ОписаниеПодписываемогоОбъекта = ТекПакет; 
		СтруктураДанных.УидФормы = УникальныйИдентификатор;

		СтруктураДанных.РежимПредварительногоВыбораСертификатов = Ложь;

	
		ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.ВыбратьСертификатыДляПодписи(СтруктураДанных);
	
		ЗаполнитьОписаниеФайловДляФормированияПодписейНаКлиенте(СтруктураДанных);
	
		ОбработкаЗаписи = Новый ОписаниеОповещения("ЗаписатьНовыеПодписиПакета", ЭтотОбъект, СтруктураДанных);	
		ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СоздатьПодписи(СтруктураДанных, ОбработкаЗаписи);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОписаниеФайловДляФормированияПодписейНаКлиенте(СтруктураДанных)
	Если СтруктураДанных.Отказ Тогда 
		Возврат;  
	КонецЕсли;	
	
	ЗаполнитьОписаниеФайловДляФормированияПодписейНаСервере(СтруктураДанных);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьОписаниеФайловДляФормированияПодписейНаСервере(СтруктураДанных)
	
	ТекущийОбъект = СтруктураДанных.ОписаниеПодписываемогоОбъекта.ПолучитьОбъект();
	
	ТекущийОбъект.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьАктуальностьКомплектовНаСервере()
	WSПрокси = ПолучитьWSПроксиОбмена(30);
	Таб = WSПрокси.GetReportVersion();
	Результат = Таб.Получить();
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабУстановленныеКомплекты",Результат);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановленныеКомплекты.ИдентификаторКомплекта,
		|	УстановленныеКомплекты.Версия
		|ПОМЕСТИТЬ ТаблицаУстановленныхКомплектовСвода
		|ИЗ
		|	&ТабУстановленныеКомплекты КАК УстановленныеКомплекты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УстановленныеКомплектыОтчетности.ИдентификаторКомплекта,
		|	УстановленныеКомплектыОтчетности.Наименование,
		|	УстановленныеКомплектыОтчетности.Версия,
		|	ТаблицаУстановленныхКомплектовСвода.Версия КАК ВерсияСвод
		|ИЗ
		|	ТаблицаУстановленныхКомплектовСвода КАК ТаблицаУстановленныхКомплектовСвода
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеКомплектыОтчетности КАК УстановленныеКомплектыОтчетности
		|		ПО ТаблицаУстановленныхКомплектовСвода.ИдентификаторКомплекта = УстановленныеКомплектыОтчетности.ИдентификаторКомплекта";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ТекстСообщения = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекВерсия = СокрЛП(ВыборкаДетальныеЗаписи.Версия);
		ТекВерсия = СтрЗаменить(ТекВерсия," ","");
		Если ТекВерсия< ВыборкаДетальныеЗаписи.ВерсияСвод Тогда
			ТекстСообщения = ?(ТекстСообщения<>"",ТекстСообщения + Символы.ПС,"Необходимо обновить:"+ Символы.ПС)+"- комплект """+ВыборкаДетальныеЗаписи.Наименование+""" до версии " + ВыборкаДетальныеЗаписи.ВерсияСвод + " или выше.";	
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Установленные комплекты актуальны.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАктуальностьКомплектов(Команда)
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = Нстр("ru='Не выбрана учетная запись обмена со Сводом отчетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ПроверитьАктуальностьКомплектовНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьСформированныеПротоколыНаСервере()
	
	НовыхПротоколов = Справочники.УчетныеЗаписиОбменаСводаОтчетов.ПолучитьСформированныеПротоколы(УчетнаяЗапись);
	
	Элементы.СписокПротоколов.Обновить();
	
	Возврат НовыхПротоколов;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСформированныеПротоколы(Команда)
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = Нстр("ru='Не выбрана учетная запись обмена со Сводом отчетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ОбновленоПротоколов = ПолучитьСформированныеПротоколыНаСервере();
	Если ОбновленоПротоколов>0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Загружены протоколы.'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Новых протоколов нет.'"));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОбновитьСостоянияОтчетовНаСервере()
	
	НовыхСостояний = Справочники.УчетныеЗаписиОбменаСводаОтчетов.ОбновитьСостоянияОтчетов(УчетнаяЗапись);
	
	Элементы.Список.Обновить();
	
	Возврат НовыхСостояний;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСостоянияОтчетов(Команда)
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = Нстр("ru='Не выбрана учетная запись обмена со Сводом отчетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ОбновленоСостояний = ОбновитьСостоянияОтчетовНаСервере();
	Если ОбновленоСостояний>0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Обновлены состояния отчетов.'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Обновление состояния отчетов отсутствует.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаКомплектов(Команда)
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = Нстр("ru='Не выбрана учетная запись обмена со Сводом отчетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("УчетнаяЗапись",УчетнаяЗапись);
	ОткрытьФорму("Обработка.ИмпортКейса.Форма.ФормаЗагрузкиКомплектовИзСервиса",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыборУчетнойЗаписи(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораУчетнойЗаписи",ЭтотОбъект);
	ПоказатьВводЗначения(ОписаниеОповещения,УчетнаяЗапись,"Выберите учетную запись для обмена с 1С:Свод отчетов",Тип("СправочникСсылка.УчетныеЗаписиОбменаСводаОтчетов"));
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораУчетнойЗаписи(Результат, ДопПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		УчетнаяЗапись = Результат;
	КонецЕсли;
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбычныйРежим(Команда)
	РежимРаботы = 0;
	ПереключитьВидимостьЭлеменовОбменаСоСводомОтчетов();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимОбменаСоСводом(Команда)
	РежимРаботы = 1;
	ПереключитьВидимостьЭлеменовОбменаСоСводомОтчетов();
КонецПроцедуры

#КонецОбласти

#Область ВыводБланкаВExcel

&НаКлиенте
Процедура ОткрытьВExcel(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивОтчетов = Новый Массив;
	ТипОтчета = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет");
	Для Каждого ТекСтр Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(ТекСтр) = ТипОтчета Тогда
			МассивОтчетов.Добавить(ТекСтр);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выделены строки отчетов, которые необходимо сохранить в Excel.'"));
		Возврат;
	КонецЕсли;
	СохранятьВАрхив = МассивОтчетов.Количество()>1;
	
	Если СохранятьВАрхив Тогда
		Результат = ПолучитьАрхивОтчетов(МассивОтчетов);
		Если НЕ Результат.ЗаданиеВыполнено Тогда
			// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
			ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
			Если ПодключатьОбработчикОжидания Тогда
				ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания("Подключаемый_ПроверитьФормированиеАрхива", 1, Истина);
				ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
			КонецЕсли;
			
		Иначе
			СохранитьФайлАрхива();
		КонецЕсли;
	Иначе
		
		Результат = ПолучитьФайлExcelНаСервере(МассивОтчетов[0]);
		Если НЕ Результат.ЗаданиеВыполнено Тогда
			// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
			ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
			Если ПодключатьОбработчикОжидания Тогда
				ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания("Подключаемый_ПроверитьФормированиеExcel", 1, Истина);
				ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
			КонецЕсли;
			
		Иначе
			ВывестиФайлExcel();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьФормированиеExcel()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			ВывестиФайлExcel();
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_ПроверитьФормированиеExcel", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервере
Функция ПолучитьФайлExcelНаСервере(ОтчетСсылка)
	
	СтруктураПараметров = Новый Структура();	
	СтруктураПараметров.Вставить("ОтчетСсылка", ОтчетСсылка);
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Вывод регламентированного отчета в Excel'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор, 
		"Документы.УниверсальныйРегламентированныйОтчет.СформироватьФайлДляExcelПакетомОтчетов",
		СтруктураПараметров, 
		НаименованиеФоновогоЗадания);
		
	АдресФайлаExcel      = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВывестиФайлExcel()
	
	#Если ВебКлиент Тогда
		ПолучитьФайл(АдресФайлаExcel, "Report.xlsx", Истина);
	#Иначе
		ИмяФайлаExcel = ПолучитьИмяВременногоФайла("xlsx");
		ПолучитьФайл(АдресФайлаExcel, ИмяФайлаExcel, Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ЗапускПриложения", ЭтотОбъект);
		НачатьЗапускПриложения(Оповещение, ИмяФайлаExcel);
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапускПриложения(Результат, ДополнительныйПараметр) Экспорт
	Возврат;
КонецПроцедуры

&НаСервере
Функция ПолучитьАрхивОтчетов(Знач МассивОтчетов)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("МассивОтчетов", МассивОтчетов);
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Сохранение регламентированных отчетов в Excel'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор, 
		"Документы.УниверсальныйРегламентированныйОтчет.СформироватьФайлыДляExcelВАрхиве",
		СтруктураПараметров, 
		НаименованиеФоновогоЗадания);
		
	АдресФайлаExcel      = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьФормированиеАрхива()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			СохранитьФайлАрхива();
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_ПроверитьФормированиеАрхива", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлАрхива()
	
	ТекДата = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	ПолучитьФайл(АдресФайлаExcel, "Reports "+ТекДата+".zip", Истина);	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиСписок

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ ЗагрузкаАктивна Тогда
		ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаНаСервере();
		ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
	КонецЕсли;
	
	Если ЗагрузкаАктивна Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если НЕ ЗагрузкаАктивна Тогда
		ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаНаСервере();
		ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
	КонецЕсли;
	
	Если ЗагрузкаАктивна Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПроверкиЗагрузкиКомплектаОтчетности

&НаСервере 
Функция АктивнаЗагрузкаКомплектаНаСервере()
	
	ЗагрузкаАктивна = БюджетнаяОтчетность.ВыполняетсяЗагрузкаКомплекта();
	
	ЭтаФорма.ТолькоПросмотр = ЗагрузкаАктивна;
	Элементы.ПредупреждениеАктивнаяЗагрузкаКомлекта.Видимость = ЗагрузкаАктивна;
	
	Возврат ЗагрузкаАктивна;
	
КонецФункции

&НаКлиенте
Процедура ПодключитьОбработчикОжиданияЗагрузкаКомплекта()
	
	Если ЗагрузкаАктивна Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта",30);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта()
	
	ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаНаСервере();
	
	Если НЕ ЗагрузкаАктивна Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Загрузка комплекта отчетности завершена. Работа с регламентированной отчетностью доступна в полном объеме.'"));
		ОтключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта");
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом


&НаКлиенте
Процедура Подключаемый_ВыполнитьНазначаемуюКоманду(Команда)
	
	Если Команда.Имя = "НоваяВерсияКомплектаДекорацияНадписьЗакрыть" Тогда
		
		ЭлементЗакрыть = Элементы.Найти("НоваяВерсияКомплектаДекорацияНадписьЗакрыть");
		Если ЭлементЗакрыть <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,ЭлементЗакрыть.Родитель.Имя,"Видимость", Ложь);
		КонецЕсли;
		
	ИначеЕсли Команда.Имя = "НоваяВерсияКомплектаДекорацияНадписьЗагрузитьЛокально" Тогда
		
		ОткрытьФорму("Обработка.ИмпортКейса.Форма.ФормаЗагрузкиКомплектовСоСтраницыПоддержки",,ЭтотОбъект);	
		
	ИначеЕсли Команда.Имя = "НоваяВерсияКомплектаДекорацияНадписьЗагрузитьОблако" Тогда
		
		ОткрытьФорму("Обработка.ИмпортКейса.Форма.ФормаЗагрузкиКомплектовИзПоставляемыхДанных",,ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры


		
#КонецОбласти
