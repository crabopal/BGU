&НаКлиенте
Перем ПараметрыОбработчикаОжидания;
&НаКлиенте
Перем ФормаДлительнойОперации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаНаСервере();
	
	//Обмен со Сводом
	ИспользоватьОбменСоСводомОтчетов = БюджетнаяОтчетностьСервер.ИспользоватьОбменСоСводомОтчетов();
	
	Элементы.ГруппаКолонокСостояниеСвод.Видимость = ИспользоватьОбменСоСводомОтчетов;
	Элементы.ГруппаПротоколы.Видимость = ИспользоватьОбменСоСводомОтчетов;
	Элементы.ГруппаДанныеСвода.Видимость = ИспользоватьОбменСоСводомОтчетов;
	Элементы.ТаблицаВыгрузокГруппаСостояниеСвод.Видимость = ИспользоватьОбменСоСводомОтчетов;
	Элементы.ФормаПодменюОбмена.Видимость = ИспользоватьОбменСоСводомОтчетов;
	
	Если ИспользоватьОбменСоСводомОтчетов Тогда
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьОбменаСоСводомОтчетов.Получить();
		
		Элементы.Состояние.Заголовок = "Состояние (БГУ)";
		Элементы.ТаблицаВыгрузокСостояние.Заголовок = "Состояние (БГУ)";
		

		ОбменЧерезВебСервис = Перечисления.СпособыВыгрузкиФайлов.WebСервис;

		Список.ТекстЗапроса = "ВЫБРАТЬ
		|	ДокументУниверсальныйРегламентированныйОтчет.ПометкаУдаления,
		|	ДокументУниверсальныйРегламентированныйОтчет.Номер,
		|	ДокументУниверсальныйРегламентированныйОтчет.Дата,
		|	ДокументУниверсальныйРегламентированныйОтчет.Проведен,
		|	ДокументУниверсальныйРегламентированныйОтчет.ВидОтчета,
		|	ДокументУниверсальныйРегламентированныйОтчет.Организация,
		|	ДокументУниверсальныйРегламентированныйОтчет.ПериодОтчета КАК ПериодОтчета,
		|	ДокументУниверсальныйРегламентированныйОтчет.ЕдиницаИзмерения,
		|	ДокументУниверсальныйРегламентированныйОтчет.Состояние,
		|	ДокументУниверсальныйРегламентированныйОтчет.ИФО,
		|	ДокументУниверсальныйРегламентированныйОтчет.УровеньТочности,
		|	ДокументУниверсальныйРегламентированныйОтчет.ДатаИзменения,
		|	ДокументУниверсальныйРегламентированныйОтчет.ПоследнийРедактировавший,
		|	ДокументУниверсальныйРегламентированныйОтчет.ПравилоОбработки,
		|	ДокументУниверсальныйРегламентированныйОтчет.ПравилоПроверки,
		|	ДокументУниверсальныйРегламентированныйОтчет.Редакция,
		|	ДокументУниверсальныйРегламентированныйОтчет.ШаблонОтчета,
		|	ДокументУниверсальныйРегламентированныйОтчет.ОписаниеАналитики,
		|	ДокументУниверсальныйРегламентированныйОтчет.Комментарий,
		|	ДокументУниверсальныйРегламентированныйОтчет.МоментВремени,
		|	ДокументУниверсальныйРегламентированныйОтчет.Ссылка,
		|	ВЫБОР
		|		КОГДА ДокументУниверсальныйРегламентированныйОтчет.ДатаЗаполнения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьДанныеЗаполнения,
		|	ДокументУниверсальныйРегламентированныйОтчет.Состояние.Порядок КАК ИндексКартинкиСостояния,
		|	СостоянияОтправленныхОтчетовСрезПоследних.Состояние КАК СостояниеСвод,
		|	ЕСТЬNULL(СостоянияОтправленныхОтчетовСрезПоследних.Состояние.Порядок, -1) КАК ИндексКартинкиСостоянияСвод,
		|	СостоянияОтправленныхОтчетовСрезПоследних.Период КАК ПериодСвод,
		|	СостоянияОтправленныхОтчетовСрезПоследних.Комментарий КАК КомментарийСвод,
		|	СостоянияОтправленныхОтчетовСрезПоследних.ПричинаИзмененияСостояния КАК ПричинаСвод,
		|	ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет КАК ДокументУниверсальныйРегламентированныйОтчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОтправленныхОтчетов.СрезПоследних КАК СостоянияОтправленныхОтчетовСрезПоследних
		|		ПО (СостоянияОтправленныхОтчетовСрезПоследних.ДокументОтчет = ДокументУниверсальныйРегламентированныйОтчет.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
        |		ПО ДокументУниверсальныйРегламентированныйОтчет.Ссылка = НаличиеФайлов.ОбъектСФайлами";
		
	КонецЕсли;
	//
	
	СоздатьДеревоВидовОтчетов();
	УстановитьЗапросСпискаВыгрузок();
	
	Если Не ПравоДоступа("Добавление", Метаданные.Документы.УниверсальныйРегламентированныйОтчет) Тогда
		Элементы.ДеревоВидовОтчетов.УстановитьДействие("Выбор","Подключаемый_ДеревоВидовОтчетовВыбор");
	КонецЕсли;
	
	УчетПоИФО = БюджетнаяОтчетностьСервер.ИспользоватьУчетПоИФО();
	Элементы.ГруппаОтборовПоИФО.Видимость = УчетПоИФО;
	Элементы.ИФО.Видимость = УчетПоИФО;
	Элементы.ТаблицаВыгрузокИФО.Видимость = УчетПоИФО;
	
	// Заполнение группы информационных ссылок
	БюджетнаяОтчетностьСерверПереопределяемый.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	
	//Выгрузка 
	ИницализацияСтраницыВыгрузка();
	

	// Форма открывается из формы 1С Отчетность
	СпособОткрытия = Неопределено;
	Если Параметры.Свойство("СпособОткрытия", СпособОткрытия) Тогда
		Если СпособОткрытия = "1CОтчетностьГрупповаяВыгрузка" ИЛИ СпособОткрытия = "1CОтчетностьОбменСводОтчетовСервис" Тогда
			
			Элементы.ЖурналыДокументов.ТекущаяСтраница = Элементы["ГруппаСтраницаВыгрузка"];
			
			Если ЗначениеЗаполнено(Параметры.ОтборОрганизация) Тогда
				ОтборОрганизация.Добавить(Параметры.ОтборОрганизация);
				ИспользоватьОтборОрганизаций = Истина;
			КонецЕсли;
			
			ПериодОтчетностиОтбор = ИнтеграцияОтчетностиГУИФормы1СОтчетность.ПолучитьПериодПоДатеНачалаОкончания(Параметры.НачалоПериода, Параметры.КонецПериода);
			Если ЗначениеЗаполнено(ПериодОтчетностиОтбор) Тогда
				ОтборПериодов.Добавить(ПериодОтчетностиОтбор);
				ИспользоватьОтборПериодов = Истина;
			КонецЕсли;
			
			Если СпособОткрытия = "1CОтчетностьОбменСводОтчетовСервис" Тогда
				РежимРаботы = 1;
				ПереключитьВидимостьЭлеменовОбменаСоСводомОтчетов(Истина);
			Иначе
				УстановитьОтборы();
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	РазворачиватьТаблицуФайлов = Истина;
	РазворачиватьТаблицуБезФайлов = Ложь;
	
	//добавить панель о новых версиях комплектов
	БюджетнаяОтчетность.ДобавитьИнформационнуюПанельНаФорму(Элементы);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ФормаПодменюОбмена);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом  
	ПараметрыРазмещения = ОбменСАрхивом.ПараметрыРазмещенияЭлементов();
	ПараметрыРазмещения.ИмяСписка = "Список";
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если ИспользоватьОбменСоСводомОтчетов Тогда
		ПереключитьВидимостьЭлеменовОбменаСоСводомОтчетов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Обработка.ИмпортКейса/ОкончаниеЗагрузки" Тогда
		СоздатьДеревоВидовОтчетов();
		БюджетнаяОтчетностьКлиент.ОбработатьОповещениеОЗагрузкеКомплекта(ИмяСобытия, Параметр, Источник, ЭтотОбъект);
		
	ИначеЕсли ИмяСобытия = "Запись_УниверсальныйРегламентированныйОтчет" Тогда	
				
		Если Элементы.ЖурналыДокументов.ТекущаяСтраница = Элементы.ГруппаСтраницаВыгрузка Тогда
			
			Если Элементы.ТаблицаВыгрузок.ТекущиеДанные <> Неопределено Тогда 
				ТекущийОтчет = Элементы.ТаблицаВыгрузок.ТекущиеДанные.Отчет;
			Иначе 
				ТекущийОтчет = Неопределено;
			КонецЕсли;
			
			ЗаполнитьТаблицуВыгрузокПоОтборам();
 
			УстановитьСтрокуВыгрузокНаОтчет(ТекущийОтчет);
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования") Тогда 
		СтруктураДанных = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СформироватьСтруктуруДанныхДляУстановкиПодписей();
		
		ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.ДобавитьподписьВСтруктуру(СтруктураДанных,ВыбранноеЗначение);
		
		ДобавитьСертификаты(СтруктураДанных);
		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Обработка = РеквизитФормыВЗначение("ОбработкаВыгрузки");
	
	Если Не Обработка.ПроверитьЗаполнение() Тогда 
		Отказ = Истина;
	КонецЕсли;	
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЖурналыДокументовПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УстановитьОтборы();
	
	Если ТекущаяСтраница = Элементы.ГруппаСтраницаОтчеты Тогда	
		
		ТекущиеДанные = Элементы.ТаблицаВыгрузок.ТекущиеДанные;
		Если ТекущиеДанные<> Неопределено Тогда 
			
			Элементы.Список.ТекущаяСтрока = Элементы.ТаблицаВыгрузок.ТекущиеДанные.Отчет;
			
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСтраницаВыгрузка Тогда 
		
		ТекущиеДанные = Элементы.Список.ТекущаяСтрока;
		Если ТекущиеДанные <> Неопределено Тогда 
			
			УстановитьСтрокуВыгрузокНаОтчет(ТекущиеДанные);
			
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

//организация

&НаКлиенте
Процедура ИспользоватьОтборОрганизацийПриИзменении(Элемент)
	
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииПриИзменении(Элемент)
	
	ИспользоватьОтборОрганизаций = ОтборОрганизация.Количество() > 0;
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииОткрытие(Элемент, СтандартнаяОбработка)
		
	Если ОтборОрганизация.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;	
	
	ПоказатьЗначение(,ОтборОрганизация[0].Значение);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		                                                               
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Выберите организации");
	ПараметрыФормы.Вставить("ИсходныйСписок", ОтборОрганизация);
	ПараметрыФормы.Вставить("ТипИсточника", "Запрос");
	ПараметрыФормы.Вставить("ТипВыбираемогоЗначения", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ПараметрыФормы.Вставить("СписокДопПолейДляОтображения", Новый СписокЗначений);
	ПараметрыФормы.СписокДопПолейДляОтображения.Добавить("ИНН", "ИНН");
	
		
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораЗначенийВСписок", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивОрганизаций());
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборОрганизация.Очистить();
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда 
		ОтборОрганизация.ЗагрузитьЗначения(ВыбранноеЗначение.ВыгрузитьЗначения());
		
	Иначе 
		ОтборОрганизация.Добавить(ВыбранноеЗначение);
		
	КонецЕсли;
	
	
	ИспользоватьОтборОрганизаций = ОтборОрганизация.Количество() > 0;
	УстановитьОтборы();

	
КонецПроцедуры

// ИФО

&НаКлиенте
Процедура ИспользоватьОтборИФОПриИзменении(Элемент)
	УстановитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура ОтборИФОПриИзменении(Элемент)
	ИспользоватьОтборИФО = ОтборИФО.Количество() > 0;
	УстановитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура ОтборИФОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		                                                               
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Выберите ИФО");
	ПараметрыФормы.Вставить("ИсходныйСписок", ОтборИФО);
	ПараметрыФормы.Вставить("ТипИсточника", "Запрос");
	ПараметрыФормы.Вставить("ТипВыбираемогоЗначения", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));	
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораЗначенийВСписок", ПараметрыФормы, Элемент); 
	
КонецПроцедуры

// Период

&НаКлиенте
Процедура ИспользоватьОтборПериодовПриИзменении(Элемент)
	
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПериодовПриИзменении(Элемент)
	
	ИспользоватьОтборПериодов = ОтборПериодов.Количество() > 0;
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВключатьПодчиненныеПериодыПриИзменении(Элемент)
	УстановитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПериодовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		                                                               
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Выберите периоды");
	ПараметрыФормы.Вставить("ИсходныйСписок", ОтборПериодов);
	ПараметрыФормы.Вставить("ТипИсточника", "Запрос");
	ПараметрыФормы.Вставить("ТипВыбираемогоЗначения", Новый ОписаниеТипов("СправочникСсылка.Периоды"));
		
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораЗначенийВСписок", ПараметрыФормы, Элемент);

КонецПроцедуры

//вид отчета

&НаКлиенте
Процедура ИспользоватьОтборВидовОтчетаПриИзменении(Элемент)
	
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВидовОтчетовИспользоватьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоВидовОтчетов.ТекущиеДанные;
	
	Если ТекущиеДанные.Использовать = 2 Тогда
		ТекущиеДанные.Использовать = 0;
	КонецЕсли;
	
	УстановитьИспользованиеВДереве(ТекущиеДанные, ТекущиеДанные.Использовать);
	ОбновитьОтборВидОтчетов();
	
	ИспользоватьОтборВидовОтчета = ОтборВидОтчетов.Количество() > 0;
	
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВидовОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗагрузкаАктивна Тогда
		ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаНаСервере();
		ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
	КонецЕсли;
	
	Если ЗагрузкаАктивна Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДеревоВидовОтчетов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не ДанныеСтроки.ЭтоГруппа Тогда
		
		ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения",ПолучитьТекущиеЗначенияРеквизитовОтбора());
		
		ПараметрыОткрытия.ЗначенияЗаполнения.Вставить("ВидОтчета", ДанныеСтроки.Значение);
		
		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаОбъекта", ПараметрыОткрытия,,Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДеревоВидовОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Возврат;
	
КонецПроцедуры

