#Область ВыводБланкаВExcel

&НаКлиенте
Процедура ОткрытьВExcel(Команда)
	
	Результат = ПолучитьФайлExcelНаСервере(мСоответствиеПоиска, Истина);
	Если НЕ Результат.ЗаданиеВыполнено Тогда
		// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
		ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
		Если ПодключатьОбработчикОжидания Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьФормированиеExcel", 1, Истина);
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
		КонецЕсли;
		
	Иначе
		ВывестиФайлExcel();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущуюСтраницуВExcel(Команда)
	
	Результат = ПолучитьФайлExcelНаСервере(мСоответствиеПоиска, Ложь);
	Если НЕ Результат.ЗаданиеВыполнено Тогда
		// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
		ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
		Если ПодключатьОбработчикОжидания Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьФормированиеExcel", 1, Истина);
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
		КонецЕсли;
		
	Иначе
		ВывестиФайлExcel();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьФормированиеExcel()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			ВывестиФайлExcel();
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_ПроверитьФормированиеExcel", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьФайлExcelНаСервере(мСоответствиеПоиска, ВыводитьПолныйОтчет)
		
	СтруктураПараметров = Новый Структура();
	
	СинхронизироватьКонтекстСервер(Ложь);
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ОтображатьВВидеТаблицыФормы = Ложь;
				
		ВывестиДанныеОтчета();
		
		
		ОтображатьВВидеТаблицыФормы = Истина;
		ВыводитьПолныйОтчет = Истина;
		
	КонецЕсли;
	
	Если ВыводитьПолныйОтчет Тогда
		
		ВремДеревоСтраниц = ДанныеФормыВЗначение(ДеревоСтраниц, Тип("ДеревоЗначений"));
		СтрокиДерева = ВремДеревоСтраниц.Строки;
		
		ТабДокПакет = Новый ПакетОтображаемыхДокументов;
		
		Документы.УниверсальныйРегламентированныйОтчет.СформироватьПакетТабличныхДокументовПоОтчету(ТабДокПакет,ОтчетОбъект,СтрокиДерева);
		
		ИмяПакетногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		ТабДокПакет.Записать(ИмяПакетногоФайла,ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		
		ФайлДанных = Новый ДвоичныеДанные(ИмяПакетногоФайла);
		АдресФайлаExcel = ПоместитьВоВременноеХранилище(ФайлДанных, УникальныйИдентификатор);
		
		Если ОтображатьВВидеТаблицыФормы Тогда
			ОбновитьКэшируемыеНастройкиОтчета();
		КонецЕсли;
		
		ПоместитьОбъектОтчета();
		
		Результат = Новый Структура("ЗаданиеВыполнено",Истина);
		
		Возврат Результат;
			
		
	Иначе
		СтруктураПараметров.Вставить("ТабличныйДокументОтчета", ТабличныйДокументОтчета);
		СтруктураПараметров.Вставить("мСоответствиеПоиска", мСоответствиеПоиска);
	КонецЕсли;
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Вывод регламентированного отчета в Excel'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор, 
		"Документы.УниверсальныйРегламентированныйОтчет.СформироватьФайлДляExcel",
		СтруктураПараметров, 
		НаименованиеФоновогоЗадания);
		
	Если ОтображатьВВидеТаблицыФормы Тогда
		ОбновитьКэшируемыеНастройкиОтчета();
		ТабличныйДокументОтчета.Очистить();
	КонецЕсли;
	
	ПоместитьОбъектОтчета();
	
	АдресФайлаExcel       = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВывестиФайлExcel()
	
	#Если ВебКлиент Тогда
		ПолучитьФайл(АдресФайлаExcel, "Report.xlsx", Истина);
	#Иначе
		ИмяФайлаExcel = ПолучитьИмяВременногоФайла("xlsx");
		ПолучитьФайл(АдресФайлаExcel, ИмяФайлаExcel, Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ЗапускПриложения", ЭтотОбъект);
		НачатьЗапускПриложения(Оповещение, ИмяФайлаExcel);
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапускПриложения(Результат, ДополнительныйПараметр) Экспорт
	Возврат;
КонецПроцедуры

#КонецОбласти

#Область ДинамическиеОтборыБланка

&НаСервере
Процедура ИнициализацияНастроекБланка()
	
	ВосстановитьОбъектОтчета();
	
	//Инициализация отборов
	НастройкаОтборов = ОтчетОбъект.мНастройкиБланка.Найти("<НастройкаОтборов>","ИмяЯчейки");
	
	МассивИменДопРеквизитов = Новый Массив;
	ДобавляемыеРеквизиты = Новый Массив;
	
	ТекСоответствиеНастройкиБланкаПоиска = Новый Соответствие;
	
	МожноИзменитьВидимостьОтбора = Ложь;	
	Если НастройкаОтборов <> Неопределено Тогда
		МожноИзменитьВидимостьОтбора = Истина;
		
		ГруппаОтборов = НастройкаОтборов.СтруктураНастроек.ГруппыОтборов;
		
		ТипЗначенияЭлемента = Новый ОписаниеТипов("Строка");		
		
		НомерГруппы = 1;
		Для Каждого ОтдельнаяГруппа Из ГруппаОтборов Цикл
		    НомерПоля = 1;
			Для Каждого ТекущаяНастройкаОтбора Из ОтдельнаяГруппа.ТаблицаПолейОтборов Цикл
				Если Не ЗначениеЗаполнено(ТекущаяНастройкаОтбора.ЯчейкиПоиска) Тогда
					Продолжить;
				КонецЕсли;
				// Реквизит отбора
				ИмяРеквизита = "ПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
				МассивИскомыхЯчеек = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяНастройкаОтбора.ЯчейкиПоиска,",",Истина,Истина);
				ТекСоответствиеНастройкиБланкаПоиска.Вставить(ИмяРеквизита,МассивИскомыхЯчеек);
							
				МассивИменДопРеквизитов.Добавить(ИмяРеквизита);
				ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита,
															  ТипЗначенияЭлемента,
															  "",
															  ТекущаяНастройкаОтбора.НаименованиеПоля,
															  Ложь));
															  
				//Способ отбора
				
				ИмяРеквизита = "СпособОтбора_ПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
							
				МассивИменДопРеквизитов.Добавить(ИмяРеквизита);
				ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита,
															  ТипЗначенияЭлемента,
															  "",
															  ИмяРеквизита,
															  Ложь));
															  
				НомерПоля = НомерПоля + 1;											  
			КонецЦикла;
			НомерГруппы = НомерГруппы+1;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ОтображатьВВидеТаблицыФормы Тогда
		//Скрываем видимость панели, только если режим отображения - в бланке
		Элементы.ФормаГруппаОтборыБланка.Видимость = МожноИзменитьВидимостьОтбора;
	КонецЕсли;
	
	Элементы.ГруппаПанельОтборов.Видимость = МожноИзменитьВидимостьОтбора;

	СоответствиеНастройкиБланкаПоиска = Новый ФиксированноеСоответствие(ТекСоответствиеНастройкиБланкаПоиска);
	
	//Удаление ранее созданных реквизитов и элементов
	МассивУдаляемыхРеквизитов = Новый Массив;
	
	Если ТипЗнч(ДобавленныеЭлементы) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлМас Из ДобавленныеРеквизиты Цикл
			МассивУдаляемыхРеквизитов.Добавить(ЭлМас);
		КонецЦикла;
		Для Каждого ЭлМас Из ДобавленныеЭлементы Цикл
			ТекЭлемент = Элементы.Найти(ЭлМас);
			Если ТекЭлемент<>Неопределено Тогда
				Элементы.Удалить(ТекЭлемент);
			КонецЕсли;
		КонецЦикла;	    
	КонецЕсли;
		
	Для Инд = 1 По 20 Цикл
		Элементы["Подкл_СвГр"+Инд].Видимость = Ложь;
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты,МассивУдаляемыхРеквизитов);
	
	ДобавленныеРеквизиты = Новый ФиксированныйМассив(МассивИменДопРеквизитов);
	
	МассивЭлементов = Новый Массив;
	
	Если НастройкаОтборов <> Неопределено Тогда	
		
		ДоступныйНомерСвернутойГруппы = 1;
		НомерГруппы = 1;
		Для Каждого ОтдельнаяГруппа Из ГруппаОтборов Цикл
		    
			ИмяГруппы = "ГруппаПоиска_Гр"+НомерГруппы;
			Если ОтдельнаяГруппа.ОтображатьНаименование Тогда
				//Элементы отбора будут выводиться в отдельной группе
				Если ОтдельнаяГруппа.Свернутая = Ложь ИЛИ ДоступныйНомерСвернутойГруппы>20 Тогда
					Если ДоступныйНомерСвернутойГруппы >20 Тогда
						//Т.к. программно нельзя управлять свернутостью группы, на форму добавлено 20 свернутых групп,
						//которые будут использоваться по мере необходимости.
						
						РодительскаяГруппа = Элементы.Вставить(ИмяГруппы,Тип("ГруппаФормы"),Элементы.ГруппаОтборы);
					Иначе
						РодительскаяГруппа = Элементы.Вставить(ИмяГруппы,Тип("ГруппаФормы"),Элементы.ГруппаОтборы,Элементы["Подкл_СвГр"+ДоступныйНомерСвернутойГруппы]);
					КонецЕсли;
					
					РодительскаяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
					РодительскаяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
					РодительскаяГруппа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
					РодительскаяГруппа.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
					РодительскаяГруппа.РастягиватьПоГоризонтали = Истина;
					
					РодительскаяГруппа.Заголовок = ОтдельнаяГруппа.НаименованиеГруппы;
					МассивЭлементов.Добавить(РодительскаяГруппа.Имя);
					
				Иначе
					РодительскаяГруппа = Элементы["Подкл_СвГр"+ДоступныйНомерСвернутойГруппы];
					РодительскаяГруппа.Заголовок = ОтдельнаяГруппа.НаименованиеГруппы;
					РодительскаяГруппа.Видимость = Истина;
					ДоступныйНомерСвернутойГруппы = ДоступныйНомерСвернутойГруппы+1
				КонецЕсли;
			Иначе
			    РодительскаяГруппа = Элементы.ГруппаОтборы;
			КонецЕсли;
			НомерПоля = 1;
			Для Каждого ТекущаяНастройкаОтбора Из ОтдельнаяГруппа.ТаблицаПолейОтборов Цикл
				Если Не ЗначениеЗаполнено(ТекущаяНастройкаОтбора.ЯчейкиПоиска) Тогда
					Продолжить;
				КонецЕсли;
				//Создаем горизонтальную группу, в которой будет наименование отбора, способ отбора и поле отбора
				Если ОтдельнаяГруппа.ОтображатьНаименование = Ложь Тогда
					Если ДоступныйНомерСвернутойГруппы >20 Тогда
						ГоризонтальнаяГруппа = Элементы.Добавить("ГоризонтальнаяГруппа_Гр"+НомерГруппы+"_Поле"+НомерПоля,Тип("ГруппаФормы"),РодительскаяГруппа);
					Иначе
						ГоризонтальнаяГруппа = Элементы.Вставить("ГоризонтальнаяГруппа_Гр"+НомерГруппы+"_Поле"+НомерПоля,Тип("ГруппаФормы"),РодительскаяГруппа,Элементы["Подкл_СвГр"+ДоступныйНомерСвернутойГруппы]);
					КонецЕсли;
				Иначе					
					ГоризонтальнаяГруппа = Элементы.Добавить("ГоризонтальнаяГруппа_Гр"+НомерГруппы+"_Поле"+НомерПоля,Тип("ГруппаФормы"),РодительскаяГруппа);
				КонецЕсли;
				ГоризонтальнаяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
				ГоризонтальнаяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
				ГоризонтальнаяГруппа.ОтображатьЗаголовок = Ложь;
				ГоризонтальнаяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
				
				МассивЭлементов.Добавить(ГоризонтальнаяГруппа.Имя);
				
				//Наименование отбора
				ИмяНадписи = "НадписьПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
				
				НовЭлемент  = Элементы.Добавить(ИмяНадписи,Тип("ДекорацияФормы"),ГоризонтальнаяГруппа);
				НовЭлемент.Ширина 	= 10;
				НовЭлемент.РастягиватьПоГоризонтали = Ложь;
				НовЭлемент.Заголовок = ТекущаяНастройкаОтбора.НаименованиеПоля;
				
				МассивЭлементов.Добавить(НовЭлемент.Имя);
				
				//Способ отбора
				ИмяКнопки = "КнопкаПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
				НовЭлемент  = Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"),ГоризонтальнаяГруппа);
				НовЭлемент.Отображение = ОтображениеКнопки.Текст;
				НовЭлемент.Заголовок = "_А_";  //Содержит
				НовЭлемент.Ширина = 5;
				НовЭлемент.ИмяКоманды = "ИзменитьСпособОтбора";
				
				МассивЭлементов.Добавить(НовЭлемент.Имя);
				
				//Установим способ отбора для текущего поля
				ЭтотОбъект["СпособОтбора_ПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля] = "Содержит";
				
				//Поле отбора
				ИмяРеквизита = "ПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
				
				НовЭлемент  = Элементы.Добавить(ИмяРеквизита,Тип("ПолеФормы"),ГоризонтальнаяГруппа);
				НовЭлемент.ПутьКДанным = ИмяРеквизита;
				НовЭлемент.Вид		 = ВидПоляФормы.ПолеВвода;
				НовЭлемент.Ширина 	= 10;
				//Поля не растягиваются, 
				//чтобы при большом количестве полей и появлении полосы прокрутки,
				//поля полностью были видны на форме.
				НовЭлемент.РастягиватьПоГоризонтали = Ложь;
				НовЭлемент.КнопкаОчистки = Истина;
				НовЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				
				МассивЭлементов.Добавить(НовЭлемент.Имя);
				
				НовЭлемент.УстановитьДействие("ПриИзменении","ПриИзмененииРеквизитаПоиска_Подключаемый");
				
				НомерПоля = НомерПоля + 1;											  
			КонецЦикла;
			НомерГруппы = НомерГруппы+1;
		КонецЦикла;
	КонецЕсли;	
	ДобавленныеЭлементы = Новый ФиксированныйМассив(МассивЭлементов);
	
	//Инициализация настроек компактного отображения длинных строк
	ИменаЯчеекДлинныхСтрок = Неопределено;
	НастройкаОтображенияДлСтр = ОтчетОбъект.мНастройкиБланка.Найти("<ОтображениеЯчеек>","ИмяЯчейки");
	Если НастройкаОтображенияДлСтр <> Неопределено Тогда
		ИменаЯчеекДлинныхСтрок = Новый ФиксированныйМассив(СтрРазделить(НастройкаОтображенияДлСтр.СтруктураНастроек.ЯчейкиДляКомпактногоОтображения,",",Ложь));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСпособаОтбора(ВыбранныйЭлемент,ИмяПоляОтбора) Экспорт
	Если ТипЗнч(ВыбранныйЭлемент) <> Тип("ЭлементСпискаЗначений") Тогда
		Возврат;		
	КонецЕсли;
	
	СпособОтбора = ВыбранныйЭлемент.Значение;
	
	Если СпособОтбора = "Содержит" Тогда
		ЗаголовокКнопки = "_А_";
	ИначеЕсли СпособОтбора = "НачинаетсяНа" Тогда
		ЗаголовокКнопки = "А__";
	ИначеЕсли СпособОтбора = "ОканчиваетсяНа" Тогда
		ЗаголовокКнопки = "__А";
	ИначеЕсли СпособОтбора = "НеСодержит" Тогда
		ЗаголовокКнопки = Символ(8371);
	ИначеЕсли СпособОтбора = "Равно" Тогда
		ЗаголовокКнопки = "=";
	ИначеЕсли СпособОтбора = "НеРавно" Тогда
		ЗаголовокКнопки = Символ(8800);
	ИначеЕсли СпособОтбора = "Больше" Тогда
		ЗаголовокКнопки = ">";
	ИначеЕсли СпособОтбора = "БольшеРавно" Тогда
		ЗаголовокКнопки = Символ(8805);
	ИначеЕсли СпособОтбора = "Меньше" Тогда
		ЗаголовокКнопки = "<";
	ИначеЕсли СпособОтбора = "МеньшеРавно" Тогда
		ЗаголовокКнопки = Символ(8804);
	КонецЕсли;
				
	ЭтотОбъект["СпособОтбора_"+ИмяПоляОтбора] = ВыбранныйЭлемент.Значение;
		
	#Если ВебКлиент Тогда
	ИзменениеЗаголовкаСпособаОтбора(ИмяПоляОтбора,ЗаголовокКнопки,мСоответствиеПоиска,мИмяОбластиДокумента);
	#Иначе
	Элементы["Кнопка"+ИмяПоляОтбора].Заголовок = ЗаголовокКнопки;	
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяПоляОтбора]) Тогда
		//Если заполнено значение отбора, переустановим отбор.
		ПрименитьИзменениеОтбораПоИмени(ИмяПоляОтбора);
	КонецЕсли;
	#КонецЕсли
	ПодключитьОбработчикОжидания("УстановитьТекущуюОбластьТабличногоДокумента",0.001,Истина);
КонецПроцедуры

&НаСервере
Процедура ИзменениеЗаголовкаСпособаОтбора(ИмяПоляОтбора,ЗаголовокКнопки,мСоответствиеПоиска,мИмяОбластиДокумента)
	//В веб-клиенте без обращения к серверу не выполняется изменение заголовка способа отбора
	Элементы["Кнопка"+ИмяПоляОтбора].Заголовок = ЗаголовокКнопки;
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяПоляОтбора]) Тогда
		ПрименитьИзменениеОтбораПоИмениНаСервере(ИмяПоляОтбора,мСоответствиеПоиска,мИмяОбластиДокумента);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаПоиска_Подключаемый(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	#Если ВебКлиент Тогда
	ПрименитьИзменениеОтбораПоИмениНаСервере(ИмяЭлемента,мСоответствиеПоиска,мИмяОбластиДокумента);
	#Иначе
	ПрименитьИзменениеОтбораПоИмени(ИмяЭлемента);
	#КонецЕсли
	
	мИмяТекущейОбласти = ИмяЭлемента;
	ПодключитьОбработчикОжидания("УстановитьТекущуюОбластьТабличногоДокумента",0.001,Истина);
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент",0.001,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзменениеОтбораПоИмени(ИмяРеквизита)
	
	ПрименитьИзменениеОтбораПоИмениОбщая(ЭтотОбъект,ИмяРеквизита,СоответствиеНастройкиБланкаПоиска,мСоответствиеПоиска,ТабличныйДокументОтчета,мИмяОбластиДокумента);
		
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзменениеОтбораПоИмениНаСервере(ИмяРеквизита,мСоответствиеПоиска,мИмяОбластиДокумента)
	
	ПрименитьИзменениеОтбораПоИмениОбщая(ЭтотОбъект,ИмяРеквизита,СоответствиеНастройкиБланкаПоиска,мСоответствиеПоиска,ТабличныйДокументОтчета,мИмяОбластиДокумента);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьИзменениеОтбораПоИмениОбщая(ТекОбъект,ИмяРеквизита,СоответствиеНастройкиБланкаПоиска,мСоответствиеПоиска,ТабличныйДокументОтчета,мИмяОбластиДокумента)
	
	ЗначениеОтбора = ВРег(ТекОбъект[ИмяРеквизита]);
	
	КолонкиПоиска = СоответствиеНастройкиБланкаПоиска[ИмяРеквизита];
		
	//В переменной мСоответствиеПоиска будет каждому имени поиска соответствовать массив областей, 
	//не подходящих под поиск по этому полю.
	//При выполнении поиска, если область не подходит под отбор, она добавляется в массив скрытых текущего поиска.
	//Если область подходит, то ей устанавливается видимость Истина, если она не скрыта другими отборами.
	
	//Т.к. при наличии в отчете групп раскрытия координаты областей сдвигаются, то при скрытии области будем в массиве запоминать имя
	//ячейки, которое не подошло под отбор.
	//А при получении Соответствия чужих скрытых областей будем искать координаты области на данный момент по имени запомненной ячейки,
	//и проверять видимость строки по данной ячейке
	
	МассивСкрытыхСтрок = Новый Массив;
	
	Если мСоответствиеПоиска = Неопределено Тогда
		мСоответствиеПоиска = Новый Соответствие;
		СоответствиеЧужихСкрытыхСтрок = Новый Соответствие;
	Иначе
		
		СоответствиеЧужихСкрытыхСтрок = Новый Соответствие;
		Для Каждого КлючИЗначение Из мСоответствиеПоиска Цикл
			Если КлючИЗначение.Ключ <> ИмяРеквизита Тогда
				Для Каждого ЭлМас Из КлючИЗначение.Значение Цикл
					ТекущаяСкрытаяОбласть = ТабличныйДокументОтчета.Область(ЭлМас);
					СоответствиеЧужихСкрытыхСтрок.Вставить(ТекущаяСкрытаяОбласть.Верх,ТекущаяСкрытаяОбласть.Низ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
	СпособОтбора = ТекОбъект["СпособОтбора_"+ИмяРеквизита];	
	
	СтруктураНастроекКолонокПоиска = Новый Структура;
	ПолеКолонки = "Колонка_";
	Для Каждого ИмяКолонкиПоиска Из КолонкиПоиска Цикл 
		
		ПозицияКолонки = Найти(ИмяКолонкиПоиска,ПолеКолонки);
		ЭтоПоискПоКолонке = Ложь;
		ТекИмяКолонкиПоиска = ИмяКолонкиПоиска;
		Если ПозицияКолонки>0 Тогда
			ТекИмяКолонкиПоиска = Сред(ИмяКолонкиПоиска,ПозицияКолонки+СтрДлина(ПолеКолонки));
			ЭтоПоискПоКолонке = Истина;
		КонецЕсли;
		ДлинаИмени = СтрДлина(ТекИмяКолонкиПоиска);	
		
		СтруктураНастроекКолонокПоиска.Вставить(ИмяКолонкиПоиска,Новый Структура("ТекИмяКолонкиПоиска,ДлинаИмени,ЭтоПоискПоКолонке",ТекИмяКолонкиПоиска,ДлинаИмени,ЭтоПоискПоКолонке));
	КонецЦикла;
	МаксСкрытаяСтрока = ТабличныйДокументОтчета.ФиксацияСверху - 5;
	ЕстьФиксированнаяОбласть = МаксСкрытаяСтрока>0;
	МинимальныйНомерСтроки = 1000000;
	КоллекцияОбластей = ТабличныйДокументОтчета.Области;
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьФиксированнаяОбласть Тогда
			Если ТекОбл.Низ <= МаксСкрытаяСтрока Тогда
				//Если номер этой строки меньше чем номер скрытой строки фиксацией табличного документа,
				//то в такой области не ищем.
				Продолжить;	
			КонецЕсли;
		КонецЕсли;
		Для Каждого ИмяКолонкиПоиска Из КолонкиПоиска Цикл
			ТекущаяСтркутураНастроек = СтруктураНастроекКолонокПоиска[ИмяКолонкиПоиска];
			ТекИмяКолонкиПоиска = ТекущаяСтркутураНастроек.ТекИмяКолонкиПоиска;
			ДлинаИмени = ТекущаяСтркутураНастроек.ДлинаИмени;
			
			Если ТекущаяСтркутураНастроек.ЭтоПоискПоКолонке Тогда
				ПозицияВСтроке = Найти(ТекОбл.Имя,"_"+ТекИмяКолонкиПоиска+"_");
				Если ПозицияВСтроке>0 Тогда
					Если Найти("0123456789",Сред(ТекОбл.Имя,ПозицияВСтроке + ДлинаИмени+2,1)) = 0 Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли Прав(ТекОбл.Имя,ДлинаИмени+1) <> "_"+ТекИмяКолонкиПоиска Тогда
					Продолжить;
				КонецЕсли;
				
			Иначе
				Если Найти(ТекОбл.Имя,ТекИмяКолонкиПоиска) <> 1 Тогда
					Продолжить;
				КонецЕсли; 
					
				Если Найти("0123456789",Сред(ТекОбл.Имя,ДлинаИмени+2,1)) = 0 Тогда
					Продолжить;
				КонецЕсли;
				 
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
				ПроверяемыйТекстОбласти = ВРег(СтрЗаменить(ТекОбл.Текст,Символы.НПП,""));
				
				ЗначениеНайдено = ПроверитьОтборПоНастройке(ПроверяемыйТекстОбласти,ЗначениеОтбора,СпособОтбора);
				
				Если ЗначениеНайдено = Ложь Тогда
					СкрываемаяСтрока = ТабличныйДокументОтчета.Область(ТекОбл.Верх,,ТекОбл.Низ);
					СкрываемаяСтрока.Видимость = Ложь;
					МассивСкрытыхСтрок.Добавить(ТекОбл.Имя);
				Иначе
					ДопустимаяСтрока = ТабличныйДокументОтчета.Область(ТекОбл.Верх,,ТекОбл.Низ);
					
					Если МинимальныйНомерСтроки>ТекОбл.Верх Тогда
						мИмяОбластиДокумента = ТекОбл.Имя;
						МинимальныйНомерСтроки = ТекОбл.Верх;
					КонецЕсли;
					Если ДопустимаяСтрока.Видимость <> Истина Тогда
						Если СоответствиеЧужихСкрытыхСтрок[ТекОбл.Верх] <> ТекОбл.Низ Тогда
							ДопустимаяСтрока.Видимость = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ДопустимаяСтрока = ТабличныйДокументОтчета.Область(ТекОбл.Верх,,ТекОбл.Низ);
				
				Если МинимальныйНомерСтроки>ТекОбл.Верх Тогда
					мИмяОбластиДокумента = ТекОбл.Имя;
					МинимальныйНомерСтроки = ТекОбл.Верх;
				КонецЕсли;
				
				Если ДопустимаяСтрока.Видимость <> Истина Тогда
					Если СоответствиеЧужихСкрытыхСтрок[ТекОбл.Верх] <> ТекОбл.Низ Тогда
						ДопустимаяСтрока.Видимость = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;				
		КонецЦикла;
	КонецЦикла;
	
	Если МассивСкрытыхСтрок.Количество() >0 Тогда
		мСоответствиеПоиска.Вставить(ИмяРеквизита,МассивСкрытыхСтрок);
	Иначе
		Если мСоответствиеПоиска[ИмяРеквизита]<> Неопределено Тогда
			мСоответствиеПоиска.Удалить(ИмяРеквизита);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюОбластьТабличногоДокумента()
	Если ЗначениеЗаполнено(мИмяОбластиДокумента) Тогда 
		Элементы.ТабличныйДокументОтчета.ТекущаяОбласть = ТабличныйДокументОтчета.Область(мИмяОбластиДокумента);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУстановленныеОтборы()
	Если ТипЗнч(ДобавленныеЭлементы) <> Тип("ФиксированныйМассив") Тогда
		Возврат;
	КонецЕсли;
	
	Если мСоответствиеПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	#Если ВебКлиент Тогда
	ОбновитьУстановленныеОтборыНаСервере(мСоответствиеПоиска,мИмяОбластиДокумента);
	Возврат;
	#КонецЕсли

	КопиямСоответствиеПоиска = мСоответствиеПоиска;
	мСоответствиеПоиска = Неопределено;
	Для Каждого ТекИмяРеквизита Из ДобавленныеРеквизиты Цикл
		Если Лев(ТекИмяРеквизита,13) = "СпособОтбора_" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭтотОбъект[ТекИмяРеквизита]) Тогда
			ПрименитьИзменениеОтбораПоИмени(ТекИмяРеквизита);
		Иначе
			ТекМассивСкрытыхОбластей = КопиямСоответствиеПоиска[ТекИмяРеквизита];
			Если ТипЗнч(ТекМассивСкрытыхОбластей) = Тип("Массив")
				И ТекМассивСкрытыхОбластей.Количество()>0 Тогда
				ПрименитьИзменениеОтбораПоИмени(ТекИмяРеквизита);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьУстановленныеОтборыНаСервере(мСоответствиеПоиска,мИмяОбластиДокумента)
	КопиямСоответствиеПоиска = мСоответствиеПоиска;
	мСоответствиеПоиска = Неопределено;
	Для Каждого ТекИмяРеквизита Из ДобавленныеРеквизиты Цикл
		Если Лев(ТекИмяРеквизита,13) = "СпособОтбора_" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭтотОбъект[ТекИмяРеквизита]) Тогда
			ПрименитьИзменениеОтбораПоИмениНаСервере(ТекИмяРеквизита,мСоответствиеПоиска,мИмяОбластиДокумента);
		Иначе
			ТекМассивСкрытыхОбластей = КопиямСоответствиеПоиска[ТекИмяРеквизита];
			Если ТипЗнч(ТекМассивСкрытыхОбластей) = Тип("Массив")
				И ТекМассивСкрытыхОбластей.Количество()>0 Тогда
				ПрименитьИзменениеОтбораПоИмениНаСервере(ТекИмяРеквизита,мСоответствиеПоиска,мИмяОбластиДокумента);
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОтчетаПриИзменении(Элемент)
	//Это событие вызывается в том числе при сворачивании/разворачивании группировок в отчете.
	//При разворачивании группировки, сбрасываются отборы и не подходящие под отбор строки становятся видимыми.
	//Требуется проверить, что для всех скрытых строк строки остались скрытыми.
	
	Если мСоответствиеПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из мСоответствиеПоиска Цикл
		Для Каждого ИмяСкрытойОбласти Из КлючИЗначение.Значение Цикл
			ОбластьСкрытойЯчейки = ТабличныйДокументОтчета.Область(ИмяСкрытойОбласти);
			ТекущаяСкрытаяОбласть = ТабличныйДокументОтчета.Область(ОбластьСкрытойЯчейки.Верх,,ОбластьСкрытойЯчейки.Низ);
			Если ТекущаяСкрытаяОбласть.Видимость <> Ложь Тогда //Видимость бывает Неопределено
				ТекущаяСкрытаяОбласть.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборы(Команда)
	ОчиститьУстановленныеОтборы();	
КонецПроцедуры

&НаСервере
Процедура ОчиститьУстановленныеОтборыНаСервере(мСоответствиеПоиска)
	ОчиститьУстановленныеОтборыОбщая(мСоответствиеПоиска,ТабличныйДокументОтчета,ДобавленныеРеквизиты,ЭтотОбъект);	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьУстановленныеОтборыОбщая(мСоответствиеПоиска,ТабличныйДокументОтчета,ДобавленныеРеквизиты,ТекОбъект)
	
	Для Каждого КлючИЗначение Из мСоответствиеПоиска Цикл
		Для Каждого ИмяСкрытойОбласти Из КлючИЗначение.Значение Цикл
			ОбластьСкрытойЯчейки = ТабличныйДокументОтчета.Область(ИмяСкрытойОбласти);
			ТекущаяСкрытаяОбласть = ТабличныйДокументОтчета.Область(ОбластьСкрытойЯчейки.Верх,,ОбластьСкрытойЯчейки.Низ);
			Если ТекущаяСкрытаяОбласть.Видимость <> Истина Тогда //Видимость бывает Неопределено
				ТекущаяСкрытаяОбласть.Видимость = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ТекИмяРеквизита Из ДобавленныеРеквизиты Цикл
		Если Лев(ТекИмяРеквизита,13) = "СпособОтбора_" Тогда			
			Продолжить;
		КонецЕсли;
		ТекОбъект[ТекИмяРеквизита]="";
	КонецЦикла;	
	
	мСоответствиеПоиска = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьУстановленныеОтборы(Команда)
	ОбновитьУстановленныеОтборы();
КонецПроцедуры


#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДИНАМИЧЕСКИХ ОТБОРОВ - ОБЩИЕ МЕТОДЫ 


#Область ДинамическиеОтборыОбщиеМетоды

&НаКлиенте
Процедура ОчиститьУстановленныеОтборы()
	
	Если ОтображатьВВидеТаблицыФормы = Ложь Тогда
		Если мСоответствиеПоиска = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		#Если ВебКлиент Тогда
		ОчиститьУстановленныеОтборыНаСервере(мСоответствиеПоиска);
		#Иначе
		ОчиститьУстановленныеОтборыОбщая(мСоответствиеПоиска,ТабличныйДокументОтчета,ДобавленныеРеквизиты,ЭтотОбъект);
		#КонецЕсли
	Иначе
		ОчиститьОтборыВсехРазделов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСпособОтбора(Команда)
	
	Если ТипЗнч(ЭтаФорма.ТекущийЭлемент) = Тип("ПолеФормы") Тогда
		Возврат;
	КонецЕсли;
	
	КнопкаОтбора = ЭтаФорма.ТекущийЭлемент.Имя;
		
	СписокОтборов = Новый СписокЗначений;
	СписокОтборов.Добавить("Содержит","_А_ Содержит");
	СписокОтборов.Добавить("НачинаетсяНа","А__ Начинается");
	СписокОтборов.Добавить("ОканчиваетсяНа","__А Оканчивается");
	СписокОтборов.Добавить("НеСодержит",Символ(8371) + " Не содержит");
	СписокОтборов.Добавить("Равно","=  Равно");
	СписокОтборов.Добавить("НеРавно",Символ(8800) + " Не равно");
	СписокОтборов.Добавить("Больше",">  Больше");
	СписокОтборов.Добавить("Меньше","<  Меньше");
	СписокОтборов.Добавить("БольшеРавно",Символ(8805) + " Больше, равно");
	СписокОтборов.Добавить("МеньшеРавно",Символ(8804) + " Меньше, равно");
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ИмяРаздела = СтрЗаменить(Элементы.РазделыМакета.ТекущаяСтраница.Имя,"Страница","");
		ИмяПоляИзмененияОтбора = СтрЗаменить(КнопкаОтбора,ИмяРаздела+"_Способ_Поиск_","");;
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораСпособаОтбораРМО",ЭтотОбъект,ИмяПоляИзмененияОтбора),СписокОтборов,ЭтаФорма.ТекущийЭлемент);
	Иначе
		ИмяПоляИзмененияОтбора = Сред(КнопкаОтбора,7);
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораСпособаОтбора",ЭтотОбъект,ИмяПоляИзмененияОтбора),СписокОтборов,ЭтаФорма.ТекущийЭлемент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВидимостьОтборов(Команда)
	Элементы.ФормаИзменитьВидимостьОтборов.Пометка = НЕ Элементы.ФормаИзменитьВидимостьОтборов.Пометка;
	ВидимостьОтборов = Элементы.ФормаИзменитьВидимостьОтборов.Пометка;
	
	Элементы.ГруппаОтборы.Видимость = ВидимостьОтборов;
	
	Если ВидимостьОтборов Тогда
		Элементы.ДеревоСтраниц.Ширина = 30;
	Иначе
		Элементы.ДеревоСтраниц.Ширина = 15;
	КонецЕсли;
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ВсегоЭлементов = Элементы.РазделыМакета.ПодчиненныеЭлементы.Количество();
		Для Сч = 0 По ВсегоЭлементов-1 Цикл
			ЭлементПоиска = Элементы["ГР_Поиск_СтраницыРаздел"+Сч];
			ЭлементПоиска.Видимость = ВидимостьОтборов;
		КонецЦикла; 
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьОтборПоНастройке(ПроверяемыйТекстОбласти,ЗначениеОтбора,СпособОтбора)
	
	ЗначениеНайдено = Ложь;
	Если СпособОтбора = "Содержит" Тогда
		ЗначениеНайдено = СтрНайти(ПроверяемыйТекстОбласти,ЗначениеОтбора) <> 0;
	ИначеЕсли СпособОтбора = "НеСодержит" Тогда
		ЗначениеНайдено = СтрНайти(ПроверяемыйТекстОбласти,ЗначениеОтбора) = 0;
	ИначеЕсли СпособОтбора = "НачинаетсяНа" Тогда
		ЗначениеНайдено = СтрНачинаетсяС(ПроверяемыйТекстОбласти,ЗначениеОтбора);
	ИначеЕсли СпособОтбора = "ОканчиваетсяНа" Тогда
		ЗначениеНайдено = СтрЗаканчиваетсяНа(ПроверяемыйТекстОбласти,ЗначениеОтбора);
	ИначеЕсли СпособОтбора = "Равно" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти = ЗначениеОтбора;
	ИначеЕсли СпособОтбора = "НеРавно" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти <> ЗначениеОтбора;
	ИначеЕсли СпособОтбора = "Больше" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти > ЗначениеОтбора;
	ИначеЕсли СпособОтбора = "БольшеРавно" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти >= ЗначениеОтбора;
	ИначеЕсли СпособОтбора = "Меньше" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти < ЗначениеОтбора;
	ИначеЕсли СпособОтбора = "МеньшеРавно" Тогда
		ЗначениеНайдено = ПроверяемыйТекстОбласти <= ЗначениеОтбора;
	КонецЕсли;
	
	Возврат ЗначениеНайдено;
	
КонецФункции

&НаКлиенте
Процедура УстановитьТекущийЭлемент()
	ЭтаФорма.ТекущийЭлемент = Элементы[мИмяТекущейОбласти];
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДИНАМИЧЕСКИХ ОТБОРОВ В РЕЖИМЕ ТАБЛИЦЫ 

#Область ДинамическиеОтборыТаблицы

&НаКлиенте
Процедура ПриИзмененииРеквизитаПоискаРМО_Подключаемый(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	ПозицияПоиска = Найти(ИмяЭлемента,"_Поиск_");
	
	ИмяРаздела = Лев(ИмяЭлемента,ПозицияПоиска -1);
	
	ИмяПоля = Сред(ИмяЭлемента,ПозицияПоиска+7);
	ПриИзмененииРеквизитаПоискаРМО_НаСервере(ИмяЭлемента,ИмяРаздела,ИмяПоля);
	
	Элементы[ИмяРаздела].Шапка = Истина;
	
	мИмяТекущейОбласти = ИмяЭлемента;
	ПодключитьОбработчикОжидания("УстановитьТекущийЭлемент",0.001,Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииРеквизитаПоискаРМО_НаСервере(ИмяЭлемента,ИмяРаздела,ИмяПоля)
			
	СпособОтбора = ЭтотОбъект[ИмяРаздела+"_Способ_Поиск_"+ИмяПоля];
	
	ЗначениеОтбора = ВРег(ЭтотОбъект[ИмяЭлемента]);
	
	ПолеОтбораПустое = Не ЗначениеЗаполнено(ЗначениеОтбора);
	
	ИмяПоляФлагаСкрытности = "Поиск_"+ИмяПоля+"__Скрыта";

	ПредставлениеПустого = "";
	
	Если Элементы[ИмяРаздела].ОтборСтрок <> Неопределено Тогда
		ТекущаяСтруктураОтбора = Новый Структура(Элементы[ИмяРаздела].ОтборСтрок);
	Иначе
		ТекущаяСтруктураОтбора = Новый Структура;
	КонецЕсли;
	
	СоответствиеАналитикиПоКоду = Новый Соответствие;
	
	Если ПолеОтбораПустое Тогда
		Если ТекущаяСтруктураОтбора.Свойство(ИмяПоляФлагаСкрытности) Тогда
			ТекущаяСтруктураОтбора.Удалить(ИмяПоляФлагаСкрытности);
		КонецЕсли;
		
		Для Каждого СтрТаблицы Из ЭтотОбъект[ИмяРаздела] Цикл
		
			Если ПолеОтбораПустое Тогда
				СтрТаблицы[ИмяПоляФлагаСкрытности] = Ложь;
				Продолжить;
			КонецЕсли;
		
		КонецЦикла;
	Иначе
		ТекущаяСтруктураОтбора.Вставить(ИмяПоляФлагаСкрытности,Ложь);
							
		Раздел = ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице).Разделы[Число(СтрЗаменить(ИмяРаздела,"Раздел",""))];
		
		ЭтоОтборАналитики = Ложь;
		ПозицияРеквизита = Найти(ИмяПоля,"__");
		КодЭлемента = ИмяПоля;
		РеквизитЭлемента = "";
		Если ПозицияРеквизита>0 Тогда
			КодЭлемента = Лев(ИмяПоля,ПозицияРеквизита-1);
			РеквизитЭлемента = Сред(ИмяПоля,ПозицияРеквизита+2);		
		КонецЕсли;
		ИмяАналитики = КодЭлемента;
		Если Найти(КодЭлемента,"Аналитика") = 1 Тогда
			ЭтоОтборАналитики = Истина;
			ИмяАналитики = Сред(КодЭлемента,10);
		КонецЕсли;
				
		НастройкаШапки = Раздел.ШапкаРаздела.НайтиСтроки(Новый Структура("КодЭлемента,РеквизитЭлемента",КодЭлемента,РеквизитЭлемента));
		ПредставлениеПустого = "";
		Если НастройкаШапки.Количество()>0 Тогда
			ПредставлениеПустого = НастройкаШапки[0].ПредставлениеПустого;
		КонецЕсли;
		
		СоответствиеЗначений = Новый Соответствие;
		
		ЭтоОтборПоРеквизиту = ЗначениеЗаполнено(РеквизитЭлемента);
		Если ЭтоОтборПоРеквизиту Тогда
			//Данное поле - реквизит аналитики или свойства.
			//Требуется выполнить отбор значению реквизита, а если он не заполнен,
			//или не заполнена аналитика - то по значению представлению пустого значения.
			//Для этого выгрузим из таблицы колонку со значениями свойства/аналитики и выполним запрос для получения значения реквизита.
			
			ТекущаяТаблица = РеквизитФормыВЗначение(ИмяРаздела);
			МассивЗначений = Новый Массив;
			Для Каждого СтрТаб Из ТекущаяТаблица Цикл
				Если ЗначениеЗаполнено(СтрТаб[КодЭлемента])
					И МассивЗначений.Найти(СтрТаб[КодЭлемента]) = Неопределено Тогда
					МассивЗначений.Добавить(СтрТаб[КодЭлемента]) ;
				КонецЕсли;
			КонецЦикла;
			Если МассивЗначений.Количество()>0 Тогда
				СоответствиеЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивЗначений,РеквизитЭлемента);
			КонецЕсли;
		КонецЕсли;
		
		//Поиск в таблице
		Для Каждого СтрТаблицы Из ЭтотОбъект[ИмяРаздела] Цикл
					
			Если СтрТаблицы.ВидЗаписи = "Итог" Тогда 
				Продолжить;
			Иначе
				
				Если ЭтоОтборАналитики Тогда
					
					Если СтрТаблицы.ВидЗаписи = "" Тогда
						Продолжить;
					КонецЕсли;
					
					//Отбор строк групп раскрытия.
					//Для отбора по аналитике нужно проверить, что аналитика есть в этой строке.
					КодСтроки = СтрТаблицы.КодСтроки;
					
					Если СоответствиеАналитикиПоКоду[КодСтроки] = Неопределено Тогда
						НастройкаТекущейСтроки = Раздел.СтрокиРаздела.Найти(КодСтроки,"Код");
						
						Если НастройкаТекущейСтроки = Неопределено Тогда
							СоответствиеАналитикиПоКоду.Вставить(КодСтроки,Ложь);
							Продолжить;
						КонецЕсли;
					
						Если НастройкаТекущейСтроки.ЕстьАналитика = Ложь Тогда
							СоответствиеАналитикиПоКоду.Вставить(КодСтроки,Ложь);
							Продолжить;//Если аналитики нет, то отбор не выполняется
						КонецЕсли;
					
						Если НастройкаТекущейСтроки.ОписаниеАналитики.Найти(ИмяАналитики,"Код") = Неопределено Тогда
							СоответствиеАналитикиПоКоду.Вставить(КодСтроки,Ложь);
							Продолжить;
						КонецЕсли;
						СоответствиеАналитикиПоКоду.Вставить(КодСтроки,Истина);
					ИначеЕсли СоответствиеАналитикиПоКоду[КодСтроки] = Ложь Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				
				Если ЗначениеЗаполнено(СтрТаблицы[КодЭлемента]) Тогда
					Если ЭтоОтборПоРеквизиту Тогда
						ЗначениеРеквизита = СоответствиеЗначений[СтрТаблицы[КодЭлемента]];
						Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
							ЗначениеСтроки = Строка(ЗначениеРеквизита);
						Иначе
							ЗначениеСтроки = ПредставлениеПустого;
						КонецЕсли;					
					Иначе
						ЗначениеСтроки = Строка(СтрТаблицы[КодЭлемента]);
					КонецЕсли;
				Иначе
					ЗначениеСтроки = ПредставлениеПустого;
				КонецЕсли;
				
				ПроверяемыйТекстОбласти = ВРег(СтрЗаменить(ЗначениеСтроки,Символы.НПП,""));
			
				ЗначениеНайдено = ПроверитьОтборПоНастройке(ПроверяемыйТекстОбласти,ЗначениеОтбора,СпособОтбора);
				СтрТаблицы[ИмяПоляФлагаСкрытности] = НЕ ЗначениеНайдено;			
				
													
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
	Элементы[ИмяРаздела].ОтборСтрок = Новый ФиксированнаяСтруктура(ТекущаяСтруктураОтбора);
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборыРаздела(Команда)
		
	ИмяРаздела = СтрЗаменить(Элементы.РазделыМакета.ТекущаяСтраница.Имя,"Страница","");	
	ОчиститьОтборыРазделаНаСервере(ИмяРаздела);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОтборыРазделаНаСервере(ИмяРаздела)
	
	ТаблицаДанныхРаздела = РеквизитФормыВЗначение(ИмяРаздела);
	Для Каждого КолонкаТаблицы Из ТаблицаДанныхРаздела.Колонки Цикл
		ИмяКолонки = КолонкаТаблицы.Имя;
		ДлинаПоля = СтрДлина(ИмяКолонки);
		ИмяПоля = "";
		Если Лев(ИмяКолонки,6) = "Поиск_" 
			И Прав(ИмяКолонки,8) = "__Скрыта" Тогда
			ИмяПоля = Сред(ИмяКолонки,7,ДлинаПоля-6-8);
			
			ИмяЭлемента = ИмяРаздела+"_Поиск_"+ИмяПоля;
			Если ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлемента]) Тогда
								 
				ЭтотОбъект[ИмяЭлемента] = "";
						
				ПриИзмененииРеквизитаПоискаРМО_НаСервере(ИмяЭлемента,ИмяРаздела,ИмяПоля);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУстановленныеОтборыРаздела(Команда)
		
	ИмяРаздела = СтрЗаменить(Элементы.РазделыМакета.ТекущаяСтраница.Имя,"Страница","");	
	ОбновитьУстановленныеОтборыРазделаНаСервере(ИмяРаздела);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьУстановленныеОтборыРазделаНаСервере(ИмяРаздела)
	
	ТаблицаДанныхРаздела = РеквизитФормыВЗначение(ИмяРаздела);
	Для Каждого КолонкаТаблицы Из ТаблицаДанныхРаздела.Колонки Цикл
		ИмяКолонки = КолонкаТаблицы.Имя;
		ДлинаПоля = СтрДлина(ИмяКолонки);
		ИмяПоля = "";
		Если Лев(ИмяКолонки,6) = "Поиск_" 
			И Прав(ИмяКолонки,8) = "__Скрыта" Тогда
			ИмяПоля = Сред(ИмяКолонки,7,ДлинаПоля-6-8);
			
			ИмяЭлемента = ИмяРаздела+"_Поиск_"+ИмяПоля;
			Если ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлемента]) Тогда
								 						
				ПриИзмененииРеквизитаПоискаРМО_НаСервере(ИмяЭлемента,ИмяРаздела,ИмяПоля);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОтборыВсехРазделов()
	Для Каждого ТекСтраница Из Элементы.РазделыМакета.ПодчиненныеЭлементы Цикл
		ИмяРаздела = СтрЗаменить(ТекСтраница.Имя,"Страница","");
		ОчиститьОтборыРазделаНаСервере(ИмяРаздела);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборыВсехРазделов()
	Для Каждого ТекСтраница Из Элементы.РазделыМакета.ПодчиненныеЭлементы Цикл
		ИмяРаздела = СтрЗаменить(ТекСтраница.Имя,"Страница","");
		ОбновитьУстановленныеОтборыРазделаНаСервере(ИмяРаздела);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСпособаОтбораРМО(ВыбранныйЭлемент,ИмяПоляОтбора) Экспорт
	Если ТипЗнч(ВыбранныйЭлемент) <> Тип("ЭлементСпискаЗначений") Тогда
		Возврат;		
	КонецЕсли;
	
	СпособОтбора = ВыбранныйЭлемент.Значение;
	
	Если СпособОтбора = "Содержит" Тогда
		ЗаголовокКнопки = "_А_";
	ИначеЕсли СпособОтбора = "НачинаетсяНа" Тогда
		ЗаголовокКнопки = "А__";
	ИначеЕсли СпособОтбора = "ОканчиваетсяНа" Тогда
		ЗаголовокКнопки = "__А";
	ИначеЕсли СпособОтбора = "НеСодержит" Тогда
		ЗаголовокКнопки = Символ(8371);
	ИначеЕсли СпособОтбора = "Равно" Тогда
		ЗаголовокКнопки = "=";
	ИначеЕсли СпособОтбора = "НеРавно" Тогда
		ЗаголовокКнопки = Символ(8800);
	ИначеЕсли СпособОтбора = "Больше" Тогда
		ЗаголовокКнопки = ">";
	ИначеЕсли СпособОтбора = "БольшеРавно" Тогда
		ЗаголовокКнопки = Символ(8805);
	ИначеЕсли СпособОтбора = "Меньше" Тогда
		ЗаголовокКнопки = "<";
	ИначеЕсли СпособОтбора = "МеньшеРавно" Тогда
		ЗаголовокКнопки = Символ(8804);
	КонецЕсли;
		
	ИмяРаздела = СтрЗаменить(Элементы.РазделыМакета.ТекущаяСтраница.Имя,"Страница","");			
		
	ЭтотОбъект[ИмяРаздела+"_Способ_Поиск_"+ИмяПоляОтбора] = ВыбранныйЭлемент.Значение;
	#Если ВебКлиент Тогда		
		УстановитьЗаголовокСпособуОтбора(ИмяРаздела+"_Способ_Поиск_"+ИмяПоляОтбора,ЗаголовокКнопки);		
	#Иначе
		Элементы[ИмяРаздела+"_Способ_Поиск_"+ИмяПоляОтбора].Заголовок = ЗаголовокКнопки;
	#КонецЕсли

	ИмяЭлемента = ИмяРаздела+"_Поиск_"+ИмяПоляОтбора;
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлемента]) Тогда
		ПриИзмененииРеквизитаПоискаРМО_НаСервере(ИмяЭлемента,ИмяРаздела,ИмяПоляОтбора);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокСпособуОтбора(ИмяСпособаОтбора,ЗаголовокКнопки)
	Элементы[ИмяСпособаОтбора].Заголовок = ЗаголовокКнопки;	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ В РЕЖИМЕ ТАБЛИЦЫ 

#Область РаботаВРежимеТаблицы

&НаСервере
Процедура ВывестиОтчетВТаблице()
	ВосстановитьОбъектОтчета();
	МакетОтображения = ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице);
	
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		ВывестиДанныеРазделаВТаблицу(Раздел);
	КонецЦикла;
	
КонецПроцедуры // ВывестиОтчетВТаблице()

&НаСервере
Процедура ВывестиДанныеРазделаВТаблицу(Знач Раздел)
	
	//Вывод в таблицу
	ТекИмяТаблицыРаздела = ИмяТаблицыРаздела(Раздел);
	ТаблицаРаздела = ЭтотОбъект[ТекИмяТаблицыРаздела];
	ТаблицаРаздела.Очистить();
	
	ТаблицаСвойств = ПолучитьТаблицуСвойств(Раздел.СтрокиРаздела.ВыгрузитьКолонку("Объект"),Раздел.ШапкаРаздела);
	
	Для Каждого СтрокаРаздела Из Раздел.СтрокиРаздела Цикл
		
		СтрДанных = ТаблицаРаздела.Добавить();
		СтрДанных.Боковик   = ?(ПустаяСтрока(СтрокаРаздела.РегламентированныйКод),""," (" + СтрокаРаздела.РегламентированныйКод + ") ") + СтрокаРаздела.Заголовок;
		СтрДанных.КодСтроки = СтрокаРаздела.Код;
		
		Для Каждого Графа Из Раздел.ГрафыРаздела Цикл
			
			СтрЗначение = ОтчетОбъект.мПоказатели.Найти(СтрокаРаздела.Код+"_"+Графа.Код,"Код");
			Если СтрЗначение <> Неопределено Тогда
				СтрДанных[Графа.Код] = СтрЗначение.Значение;
				
				Если СтрЗначение.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число
					 и Не СтрЗначение.НеМасштабируется
					 и ОтчетОбъект.ВернутьЗначениеДелителя() <> 1 Тогда
					СтрДанных[Графа.Код] = СтрДанных[Графа.Код] / ОтчетОбъект.ВернутьЗначениеДелителя();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаСвойств = Неопределено;
		Если ТаблицаСвойств<> Неопределено Тогда
			СтрокаСвойств = ТаблицаСвойств.Найти(СтрокаРаздела.Объект,"Ссылка");
			Если СтрокаСвойств	<> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрДанных,СтрокаСвойств);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаРаздела.ЕстьАналитика и СтрокаРаздела.СпособРедактирования = "ВЭтомОкне" Тогда
			СтрДанных.ВидЗаписи = "Итог";
			ВывестиРаскрытиеВТаблицуРедактирования(СтрокаРаздела, ТекИмяТаблицыРаздела, Раздел.ГрафыРаздела,СтрДанных);//ВывестиРаскрытиеВТаблицуРедактирования(Строка, СтрДанных, Раздел.ГрафыРаздела);
		Иначе
			СтрДанных.ВидЗаписи = "";
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры // ВывестиДанныеРазделаВТаблицу()

&НаСервере
Функция ПолучитьТаблицуСвойств(СтрокиОтчета,ШапкаРаздела)
	
	Если ШапкаРаздела.Количество() =  0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Шапка = 
		"ВЫБРАТЬ
		|	СтрокиОтчетов.Ссылка";
	ШаблонТела = "
		|,ЗначенияСвойствОбъектов%.Значение КАК ";
	ИсточникЗапроса = "	
		|ИЗ
		|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов ";
	ШаблонСоединения =	"
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов%
		|		ПО (ЗначенияСвойствОбъектов%.Объект = СтрокиОтчетов.Ссылка
		|				И ЗначенияСвойствОбъектов%.Свойство = &Свойство%)";
	УсловиеЗапроса = "
		|ГДЕ
		|	СтрокиОтчетов.Ссылка В(&СтрокиОтчета)";
	Запрос.УстановитьПараметр("СтрокиОтчета", СтрокиОтчета);
	
	ТелоЗапроса = "";
	СоединениеЗапроса = "";
	Инд = 1;
	ОбработанныеСвойства = Новый Массив;
	Для Каждого СтрокаШапки Из ШапкаРаздела Цикл
		Если ТипЗнч(СтрокаШапки.ЭлементОтчета) = Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") Тогда
			
			Если ОбработанныеСвойства.Найти(СтрокаШапки.ЭлементОтчета)<> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТелоЗапроса = ТелоЗапроса + СтрЗаменить(ШаблонТела,"%",Инд) + СтрокаШапки.КодЭлемента;
			СоединениеЗапроса = СоединениеЗапроса + ШаблонСоединения;
			СоединениеЗапроса = СтрЗаменить(СоединениеЗапроса,"%",Инд);
			Запрос.УстановитьПараметр("Свойство"+Инд, СтрокаШапки.ЭлементОтчета);
			ОбработанныеСвойства.Добавить(СтрокаШапки.ЭлементОтчета);
			
			Инд = Инд+1;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбработанныеСвойства.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = Шапка + ТелоЗапроса + ИсточникЗапроса + СоединениеЗапроса + УсловиеЗапроса;
		
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("Ссылка");
	Возврат РезультатЗапроса;	
КонецФункции

&НаСервере
Процедура ВывестиРаскрытиеВТаблицуРедактирования(Знач СтрокаМакета, Знач ТекИмяТаблицыРаздела, Знач Графы, Знач СтрокаДанных)
	
	//Вывод в таблицу
	СтруктураПоиска = Новый Структура("КодСтрока",СтрокаМакета.Код);	
	СтрокиРаскрытия = ОтчетОбъект.мПоказатели.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрРаскрытия ИЗ СтрокиРаскрытия Цикл 
		Если ЗначениеЗаполнено(СтрРаскрытия.ГруппаРаскрытия) Тогда
			ГруппаРаскрытия=СтрРаскрытия.ГруппаРаскрытия;
			Прервать;			
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		Возврат;
	КонецЕсли;
	
	КэшНастроекГруппыРаскрытия = ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	СтрРаскрытия               = ОтчетОбъект.ТабОбластиРаскрытия.Найти(СтрокаМакета.Код, "КодСтроки");
	
	Если СтрРаскрытия = Неопределено Тогда
		СтрРаскрытия                  = ОтчетОбъект.ТабОбластиРаскрытия.Добавить();
		СтрРаскрытия.КодСтроки        = СтрокаМакета.Код;
		СтрРаскрытия.ГруппаРаскрытия  = ГруппаРаскрытия;
	КонецЕсли;
	
	СтрРаскрытия.ТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(КэшНастроекГруппыРаскрытия, СтрокаМакета.Код);
	
	ПеренестиТаблицуРаскрытияВДанныеФормы(СтрРаскрытия, ТекИмяТаблицыРаздела, СтрокаМакета, Графы, СтрокаДанных);
	
КонецПроцедуры // ВывестиРаскрытиеВТаблицуРедактирования()

&НаСервере
Процедура ПеренестиТаблицуРаскрытияВДанныеФормы(Знач СтрРаскрытия, Знач ТекИмяТаблицыРаздела, Знач СтрокаМакета, Знач Графы, Знач СтрокаДанных)
	
	// Вывод в таблицу
	
	СоответствиеИменКолонок = Новый Соответствие;
	
	Для Каждого Графа Из Графы Цикл
		КодКолонкиОбъект = СтрокаМакета.Код+"_"+Графа.Код+"_Отображение";
		Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти(КодКолонкиОбъект) <> Неопределено Тогда
			СоответствиеИменКолонок.Вставить(Графа.Код, КодКолонкиОбъект);
		КонецЕсли;
	КонецЦикла;
	
	АналитикиГруппы = БюджетнаяОтчетностьСервер.КоллекцияАналитикГруппыРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	
	Если СтрРаскрытия.ОтборПоРаскрытию = Неопределено Тогда
		ТаблицаИсточник = СтрРаскрытия.ТаблицаРаскрытия;
	Иначе
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(СтрРаскрытия.ТаблицаРаскрытия);
		
		Для Каждого КлючИЗначение Из СтрРаскрытия.ОтборПоРаскрытию Цикл
			Отбор = ПостроительЗапроса.Отбор.Добавить(КлючИЗначение.Ключ);
			Отбор.ВидСравнения  = КлючИЗначение.Значение.ВидСравнения;
			Если ТипЗнч(КлючИЗначение.Значение.Значение) = Тип("СписокЗначений") Тогда
				Отбор.Значение      = КлючИЗначение.Значение.Значение;
			Иначе
				Отбор.Значение      = Отбор.ТипЗначения.ПривестиЗначение(КлючИЗначение.Значение.Значение);
			КонецЕсли;
			Отбор.Использование = Истина;
		КонецЦикла;
		
		ТаблицаИсточник = ПостроительЗапроса.Результат.Выгрузить();
		
	КонецЕсли;
	
	Инд = 1;
	
	ТаблицаРаздела = ЭтотОбъект[ТекИмяТаблицыРаздела];
	ИндексСтроки = ТаблицаРаздела.Индекс(СтрокаДанных)+1;
	
	СтрокаСвойств = СписокСвойствРаздела[ТекИмяТаблицыРаздела];
	Для Каждого СтрокаДанныхРаскрытия Из ТаблицаИсточник Цикл
		
		СтрокаРедактирования = ТаблицаРаздела.Вставить(ИндексСтроки);
		СтрокаРедактирования.КодСтроки = СтрокаМакета.Код;
		СтрокаРедактирования.ВидЗаписи = "Раскрытие";
		
		Для Каждого СтрАналитика Из АналитикиГруппы Цикл
			
			АналитикаСтроки = СтрокаМакета.ОписаниеАналитики.Найти(СтрАналитика.ВидАналитики,"ВидАналитики");
			Если АналитикаСтроки <> Неопределено Тогда
				СтрокаРедактирования["Аналитика"+АналитикаСтроки.Код] = СтрокаДанныхРаскрытия[СтрАналитика.ИмяОбъектаАналитики];
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Графа Из Графы Цикл
			ИмяКолонки = СоответствиеИменКолонок[Графа.Код];
			Если ИмяКолонки <> Неопределено Тогда
				СтрокаРедактирования[Графа.Код] = СтрокаДанныхРаскрытия[ИмяКолонки];
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРедактирования.Индекс  = СтрокаДанныхРаскрытия.Индекс;
		СтрокаРедактирования.Порядок = Инд; 
		СтрокаРедактирования.ПромежуточныеИтоги = СтрокаДанныхРаскрытия.ПромежуточныеИтоги;
		
		Если ЗначениеЗаполнено(СтрокаСвойств) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаРедактирования,СтрокаДанных,СтрокаСвойств);
		КонецЕсли;
		Инд = Инд + 1;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры // ПеренестиТаблицуРаскрытияВДанныеФормы()

&НаСервере
Процедура УстановитьФильтрВТаблицеФормы(Знач СтрРаскрытия, Знач ИмяТаблицы)

	ТаблицаРаздела = ЭтаФорма[ИмяТаблицы];
	
	СтрокаДанных = Неопределено;
	МассивСтрокКУдаленю = Новый Массив;
	Для Каждого СтрВерхнегоУровня Из ТаблицаРаздела Цикл
		Если СтрВерхнегоУровня.КодСтроки = СтрРаскрытия.КодСтроки Тогда
			Если СтрВерхнегоУровня.ВидЗаписи = "Итог" Тогда
				СтрокаДанных = СтрВерхнегоУровня;
			Иначе
				МассивСтрокКУдаленю.Добавить(СтрВерхнегоУровня);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаДанных = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка установки фильтра. В таблице %1 не обнаружена строка с кодом %2'"),
					ИмяТаблицы,
					СтрРаскрытия.КодСтроки);
	КонецЕсли;
	
	Раздел        = НайтиРазделПоИмени(ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице), ИмяТаблицы);
	СтрокаРаздела = Раздел.СтрокиРаздела.Найти(СтрРаскрытия.КодСтроки, "Код");
	
	Для Каждого ЭлМас Из МассивСтрокКУдаленю Цикл
		ТаблицаРаздела.Удалить(ЭлМас);
	КонецЦикла;
	
	ПеренестиТаблицуРаскрытияВДанныеФормы(СтрРаскрытия, ИмяТаблицы, СтрокаРаздела, Раздел.ГрафыРаздела,СтрокаДанных);

КонецПроцедуры // УстановитьФильтрВТаблицеФормы()

&НаСервере
Процедура СоздатьТаблицуРедактированияОтчета(Знач МакетОтображения)
	
	СоздаваемыеРеквизиты = Новый ТаблицаЗначений;
	СоздаваемыеРеквизиты.Колонки.Добавить("Раздел");
	СоздаваемыеРеквизиты.Колонки.Добавить("Имя");
	СоздаваемыеРеквизиты.Колонки.Добавить("Заголовок");
	СоздаваемыеРеквизиты.Колонки.Добавить("Роль");
	СоздаваемыеРеквизиты.Колонки.Добавить("ТипЗначения");
	СоздаваемыеРеквизиты.Колонки.Добавить("ИмяРодителя");
	СоздаваемыеРеквизиты.Колонки.Добавить("ОбъектОписания");
	СоздаваемыеРеквизиты.Колонки.Добавить("СвойстваЭлемента");
	СоздаваемыеРеквизиты.Колонки.Добавить("СвойстваРеквизита");
	
	ТаблицаРедактированияЗаполнитьПереченьРеквизитовФормы(МакетОтображения, СоздаваемыеРеквизиты);
	ТаблицаРедактированияСоздатьРеквизитыФормы(МакетОтображения, СоздаваемыеРеквизиты);
	ТаблицаРедактированияСоздатьЭлементыФормы(МакетОтображения, СоздаваемыеРеквизиты);
	ТаблицаРедактированияНастроитьУсловноеОформление(МакетОтображения);
	
	Если МакетОтображения.Разделы.Количество() = 1 Тогда
		Элементы.РазделыМакета.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице)

	Если мМакетОтображенияВТаблице = Неопределено Тогда
		
		мМакетОтображенияВТаблице = ПолучитьИзВременногоХранилища(АдресНастроекОтчета).МакетОтображения;
		
	КонецЕсли;
		
	Возврат мМакетОтображенияВТаблице;

КонецФункции // ПолучитьМакетОтображения()

&НаСервере
Процедура ТаблицаРедактированияЗаполнитьПереченьРеквизитовФормы(Знач МакетОтображения, Знач СоздаваемыеРеквизиты)
	
	СписокСвойствРаздела = Неопределено;
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		ЗаполнитьПереченьРеквизитовТаблицыРаздела(Раздел, СоздаваемыеРеквизиты);
	КонецЦикла;

КонецПроцедуры // ТаблицаРедактированияЗаполнитьПереченьРеквизитовФормы()

&НаСервере
Процедура ТаблицаРедактированияСоздатьРеквизитыФормы(Знач МакетОтображения, Знач СоздаваемыеРеквизиты)

	МассивРеквизитов = Новый Массив;
	ТаблицыРедактирования = Новый Массив;
	РеквизитыТаблиц = СоздаваемыеРеквизиты.НайтиСтроки(Новый Структура("Роль", "Таблица"));
	Для Каждого ПрототипРеквизита Из РеквизитыТаблиц Цикл
		РеквизитФормы = Новый РеквизитФормы(ПрототипРеквизита.Имя, ПрототипРеквизита.ТипЗначения, , , Истина);
		МассивРеквизитов.Добавить(РеквизитФормы);
		ТаблицыРедактирования.Добавить(ПрототипРеквизита.Имя);
	КонецЦикла;
	
	Для Каждого ПрототипРеквизита Из СоздаваемыеРеквизиты Цикл
		
		Если ПрототипРеквизита.Роль = "Таблица" Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитФормы = Новый РеквизитФормы(ПрототипРеквизита.Имя, ПрототипРеквизита.ТипЗначения, ПрототипРеквизита.ИмяРодителя, ПрототипРеквизита.Заголовок);
		Если ПрототипРеквизита.СвойстваРеквизита <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(РеквизитФормы, ПрототипРеквизита.СвойстваРеквизита);
		КонецЕсли;
		
		МассивРеквизитов.Добавить(РеквизитФормы);
		
	КонецЦикла;

	ИзменитьРеквизиты(МассивРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаРедактированияСоздатьЭлементыФормы(Знач МакетОтображения, Знач СоздаваемыеРеквизиты)
 
	УсловиеПоиска      = Новый Структура("Роль","Таблица");
	СоздаваемыеТаблицы = СоздаваемыеРеквизиты.НайтиСтроки(УсловиеПоиска);
	
	ОбщийЕстьЭлементыОтбора = Ложь;
	Для Каждого ОписаниеТаблицы Из СоздаваемыеТаблицы Цикл
		
		// Создание таблицы формы
		
		Раздел      = ОписаниеТаблицы.Раздел;
		ТекСтраницаРаздела = СоздатьСтраницуРаздела(Раздел);
		
		//Группа горизонтальная всего раздела
		ГруппаСтраницыРаздела = Элементы.Добавить("ГРСтрРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), ТекСтраницаРаздела);
		ГруппаСтраницыРаздела.Вид       = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаСтраницыРаздела.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаСтраницыРаздела.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаСтраницыРаздела.ОтображатьЗаголовок  = Ложь;
		
		//Группа поиска
		
		ГруппаПоискаСтраницыРаздела_Стр = Элементы.Добавить("ГР_Поиск_СтраницыРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), ГруппаСтраницыРаздела);
		ГруппаПоискаСтраницыРаздела_Стр.Вид       = ВидГруппыФормы.Страницы;
		ГруппаПоискаСтраницыРаздела_Стр.РастягиватьПоВертикали = Истина;
		ГруппаПоискаСтраницыРаздела_Стр.РастягиватьПоГоризонтали = Ложь;
		ГруппаПоискаСтраницыРаздела_Стр.Видимость = Элементы.ФормаИзменитьВидимостьОтборов.Пометка;
		
		ГруппаПоискаСтраницыРаздела = Элементы.Добавить("ГР_Поиск_СтрРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), ГруппаПоискаСтраницыРаздела_Стр);
		ГруппаПоискаСтраницыРаздела.Вид       = ВидГруппыФормы.Страница;
		ГруппаПоискаСтраницыРаздела.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаПоискаСтраницыРаздела.Заголовок = "Отборы";
		ГруппаПоискаСтраницыРаздела.РастягиватьПоВертикали = Истина;
		ГруппаПоискаСтраницыРаздела.РастягиватьПоГоризонтали = Ложь;
		
		ГруппаПанельОтборов = Элементы.Добавить("ГР_Поиск_ПанельОтборов_СтрРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), ГруппаПоискаСтраницыРаздела);
		ГруппаПанельОтборов.Вид       = ВидГруппыФормы.КоманднаяПанель;
		ГруппаПанельОтборов.РастягиватьПоГоризонтали = Ложь;
		ГруппаПанельОтборов.Ширина = 29;
		
		// Кнопки командной панели отборов
		КнопкаНастройкаОтборов = Элементы.Добавить(ОписаниеТаблицы.Имя+"ИзменитьВидимостьОтборов", Тип("КнопкаФормы"), ГруппаПанельОтборов);
		КнопкаНастройкаОтборов.ИмяКоманды = "ИзменитьВидимостьОтборов";
		КнопкаНастройкаОтборов.Заголовок = "Скрыть отборы";
		КнопкаНастройкаОтборов.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
		КнопкаНастройкаОтборов = Элементы.Добавить(ОписаниеТаблицы.Имя+"ОбновитьУстановленныеОтборы", Тип("КнопкаФормы"), ГруппаПанельОтборов);
		КнопкаНастройкаОтборов.ИмяКоманды = "ОбновитьУстановленныеОтборыРаздела";

		КнопкаНастройкаОтборов = Элементы.Добавить(ОписаниеТаблицы.Имя+"ОчиститьОтборы", Тип("КнопкаФормы"), ГруппаПанельОтборов);
		КнопкаНастройкаОтборов.ИмяКоманды = "ОчиститьОтборыРаздела";
		КнопкаНастройкаОтборов.Заголовок = "Очистить";
		КнопкаНастройкаОтборов.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
		//Группа самого раздела
		ГруппаТекРазделаСтраницыРаздела = Элементы.Добавить("ГР_Данные_СтрРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), ГруппаСтраницыРаздела);
		ГруппаТекРазделаСтраницыРаздела.Вид       = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаТекРазделаСтраницыРаздела.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаТекРазделаСтраницыРаздела.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаТекРазделаСтраницыРаздела.ОтображатьЗаголовок  = Ложь;
		
		ЭлементТаблица = Элементы.Добавить(ОписаниеТаблицы.Имя, Тип("ТаблицаФормы"), ГруппаТекРазделаСтраницыРаздела);
		ЭлементТаблица.ПутьКДанным = ОписаниеТаблицы.Имя;
		ЭлементТаблица.ИзменятьПорядокСтрок = Ложь;
		ЭлементТаблица.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВерхнийУровень;
		ЭлементТаблица.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
		
		ЭлементТаблица.УстановитьДействие("ПередНачаломДобавления" , "Подключаемый_ТаблицаРедактированияПередНачаломДобавления");
		ЭлементТаблица.УстановитьДействие("ПередУдалением"         , "Подключаемый_ТаблицаРедактированияПередУдалением");
		ЭлементТаблица.УстановитьДействие("ПослеУдаления"          , "Подключаемый_ТаблицаРедактированияПослеУдаления");
		ЭлементТаблица.УстановитьДействие("ПриНачалеРедактирования", "Подключаемый_ТаблицаРедактированияПриНачалеРедактирования");
		ЭлементТаблица.УстановитьДействие("Выбор"				   , "Подключаемый_ТаблицаРедактированияВыбор");
		
		// Кнопки командной панели таблицы
		КнопкаНастройкаСписка = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаНастройкаСписка", Тип("КнопкаФормы"), ЭлементТаблица.КоманднаяПанель);
		КнопкаНастройкаСписка.ИмяКоманды = "НастройкаСпискаРаскрытия";
		
		КнопкаНастройкаСписка = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаОчиститьНастройкуСписка", Тип("КнопкаФормы"), ЭлементТаблица.КоманднаяПанель);
		КнопкаНастройкаСписка.ИмяКоманды = "ОчиститьНастройкуСпискаРаскрытия";
		
		КнопкаНастройкаСписка = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаПереместитьСтокуРаскрытияВверх", Тип("КнопкаФормы"), ЭлементТаблица.КоманднаяПанель);
		КнопкаНастройкаСписка.ИмяКоманды = "ПереместитьСтокуРаскрытияВверх";

		КнопкаНастройкаСписка = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаПереместитьСтокуРаскрытияВниз", Тип("КнопкаФормы"), ЭлементТаблица.КоманднаяПанель);
		КнопкаНастройкаСписка.ИмяКоманды = "ПереместитьСтокуРаскрытияВниз";

		// Кнопки контекстного меню
		КнопкаРасшифровать = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаРасшифровать", Тип("КнопкаФормы"), ЭлементТаблица.КонтекстноеМеню);
		КнопкаРасшифровать.ИмяКоманды = "РасшифроватьАвтозаполнение";
					
		КнопкаПромежуточныйИтог = Элементы.Добавить(ОписаниеТаблицы.Имя+"КомандаПромежуточныйИтог", Тип("КнопкаФормы"), ЭлементТаблица.КонтекстноеМеню);
		КнопкаПромежуточныйИтог.ИмяКоманды = "ПромежуточныйИтог";
		
		ЕстьАналитика = Раздел.СтрокиРаздела.Найти(Истина, "ЕстьАналитика") <> Неопределено;
		
		СоответствиеГруппКолонок = Новый Соответствие;
		
		ЭлементыРаздела = СоздаваемыеРеквизиты.НайтиСтроки(Новый Структура("Раздел", Раздел));
		
		ТекИмяТаблицыРаздела = ИмяТаблицыРаздела(Раздел);
		
		СозданаШапкаРаздела = Ложь;
		
		ЕстьЭлементыПоиска = Ложь;
		
		//элемент-картинка - признак, что это итоговая строка группы раскрытия
		НовыйЭлемент = Элементы.Добавить(ТекИмяТаблицыРаздела+"_КартинкаГР",Тип("ПолеФормы"), ЭлементТаблица);
		//НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПо;
		НовыйЭлемент.ТолькоПросмотр = Истина;
		НовыйЭлемент.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
		НовыйЭлемент.Ширина = 2;
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеКартинки;
		НовыйЭлемент.ПутьКДанным = ТекИмяТаблицыРаздела+".Индекс";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.КартинкаЗначений = БиблиотекаКартинок.СоздатьЭлементСписка;
		НовыйЭлемент.Подсказка = Нстр("ru='В строке может быть добавлена подстрока'");
		
		//Картинка отображается только для строк раскрытия
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
				
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ТекИмяТаблицыРаздела+".ВидЗаписи");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = "";
		ЭлементОтбора.Использование  = Истина;
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(НовыйЭлемент.Имя);
		
		ЭлементОформления.Использование = Истина;
		ИмяАвтодобавленногоОформления = "-оформление-редактирования-";
		
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
		
		ВысотаШапки = 1;
		Для Каждого ПрототипРеквизита Из ЭлементыРаздела Цикл
		
			Если ПрототипРеквизита.Роль = "Таблица" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПрототипРеквизита.Роль = "Боковик" Тогда
				Если ПрототипРеквизита.Имя = "Боковик" Тогда
					Если Раздел.ШапкаРаздела.Количество() <> 0 Тогда
						Продолжить;//Поле будет добавлено потом, из настроек шапки.
					КонецЕсли;
					НовыйЭлемент = Элементы.Добавить(ТекИмяТаблицыРаздела+ПрототипРеквизита.Имя,Тип("ПолеФормы"), ЭлементТаблица);
					НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
					НовыйЭлемент.ТолькоПросмотр = Истина;
					НовыйЭлемент.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
					НовыйЭлемент.АвтовысотаЯчейки = Истина;
				Иначе
					НовыйЭлемент = Элементы.Добавить(ТекИмяТаблицыРаздела+ПрототипРеквизита.Имя,Тип("ПолеФормы"), ЭлементТаблица);
					НовыйЭлемент.ТолькоПросмотр = Истина;
					НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
				КонецЕсли;
			ИначеЕсли ПрототипРеквизита.Роль <> "Служебный" Тогда
				
				Если СозданаШапкаРаздела Тогда
					Продолжить;
				КонецЕсли;
				
				ТекГруппаКолонок = ЭлементТаблица;
				
				СоответствиеСтрокИГрупп = Новый Соответствие;
				СоответствиеСтрокИКоличества = Новый Соответствие;
				ТекКоличество = 1;
				
				НомерПоля = 1;
				НомерГруппы = 1;
				
				УровеньГруппы = 1;
				Для Каждого СтрокаШапки Из Раздел.ШапкаРаздела Цикл
					
					СозданаШапкаРаздела = Истина;
					
					Если ЗначениеЗаполнено(СтрокаШапки.ПолноеИмяГруппы) Тогда
						РодительскаяГруппа = СоответствиеСтрокИГрупп[СтрокаШапки.ПолноеИмяГруппы];
					Иначе
						РодительскаяГруппа = ЭлементТаблица;
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(СтрокаШапки.ЭлементОтчета) Тогда
						//это новая группа
						ТекГруппаКолонок = Элементы.Добавить(ТекИмяТаблицыРаздела+"_ГР_"+ТекКоличество,Тип("ГруппаФормы"),РодительскаяГруппа);
						
						Если ЗначениеЗаполнено(СтрокаШапки.ВидГруппировки) Тогда
							Если СтрокаШапки.ВидГруппировки = "ВЯчейке" Тогда
								ТекГруппаКолонок.Группировка = ГруппировкаКолонок.ВЯчейке;
							ИначеЕсли СтрокаШапки.ВидГруппировки = "Вертикальная" Тогда
								ТекГруппаКолонок.Группировка = ГруппировкаКолонок.Вертикальная;
							Иначе
								ТекГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
							КонецЕсли;
						Иначе
							ТекГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрокаШапки.ЗаголовокЭлемента) Тогда
							ТекГруппаКолонок.Заголовок = СтрокаШапки.ЗаголовокЭлемента;
						Иначе
							ТекГруппаКолонок.Заголовок = СтрокаШапки.ИмяГруппы;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаШапки.ШиринаЭлемента) Тогда
							ТекГруппаКолонок.Ширина = СтрокаШапки.ШиринаЭлемента;
							ТекГруппаКолонок.РастягиватьПоГоризонтали = Ложь;
						КонецЕсли;
													
						Если СтрокаШапки.БезЗаголовка Тогда
							ТекГруппаКолонок.ОтображатьВШапке = Ложь;
						Иначе
							ТекГруппаКолонок.ОтображатьВШапке = Истина;
						КонецЕсли;
						ТекГруппаКолонок.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
						
						Если СтрокаШапки.Зафиксирована Тогда
							ТекГруппаКолонок.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
						КонецЕсли;
						
						ТекПолноеИмяГруппы = СтрокаШапки.ПолноеИмяГруппы +?(ЗначениеЗаполнено(СтрокаШапки.ПолноеИмяГруппы),".","")+"ГР_"+ТекКоличество; 
						СоответствиеСтрокИГрупп.Вставить(ТекПолноеИмяГруппы,ТекГруппаКолонок);
						УровеньГруппы = УровеньГруппы + 1;
						
					Иначе
						
						УровеньГруппы = 0;
						
						ИскомыеСтрокиРеквизита = СоздаваемыеРеквизиты.НайтиСтроки(Новый Структура("Раздел,Имя", Раздел,СтрокаШапки.КодЭлемента));
						Если ИскомыеСтрокиРеквизита.Количество()>0 Тогда
							ТекПрототипРеквзиита = ИскомыеСтрокиРеквизита[0];
							ТекИмяРеквизита = "";
							Если ЗначениеЗаполнено(СтрокаШапки.РеквизитЭлемента) Тогда
								ТекИмяРеквизита = "__"+СтрокаШапки.РеквизитЭлемента;
							КонецЕсли;
							НовыйЭлемент = Элементы.Добавить(ТекИмяТаблицыРаздела+ТекПрототипРеквзиита.Имя+ТекИмяРеквизита,Тип("ПолеФормы"), РодительскаяГруппа);
							
							НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;

							НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
							НовыйЭлемент.Формат = СтрокаШапки.ФорматКолонки;
							НовыйЭлемент.ФорматРедактирования = СтрокаШапки.ФорматКолонки;
							НовыйЭлемент.АвтоОтметкаНезаполненного = Ложь;
							
							Если ТекПрототипРеквзиита.Имя = "Боковик" Тогда
								НовыйЭлемент.АвтовысотаЯчейки = Истина;
								НовыйЭлемент.ТолькоПросмотр = Истина;
							КонецЕсли;
							
							Если СтрокаШапки.Зафиксирована Тогда
								НовыйЭлемент.ФиксацияВТаблице = ФиксацияВТаблице.Лево;								
								НовыйЭлемент.Ширина = 5;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтрокаШапки.ЗаголовокЭлемента) Тогда
								НовыйЭлемент.Заголовок = СтрокаШапки.ЗаголовокЭлемента;
							Иначе
								НовыйЭлемент.Заголовок = ТекПрототипРеквзиита.Заголовок;
								Если ЗначениеЗаполнено(СтрокаШапки.РеквизитЭлемента) Тогда
									НовыйЭлемент.Заголовок = НовыйЭлемент.Заголовок + " ["+СтрокаШапки.РеквизитЭлемента+"]";
								КонецЕсли;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтрокаШапки.ШиринаЭлемента) Тогда
								НовыйЭлемент.Ширина = СтрокаШапки.ШиринаЭлемента;
								НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
							КонецЕсли;
							
							Если СтрокаШапки.БезЗаголовка Тогда
								НовыйЭлемент.ОтображатьВШапке = Ложь;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтрокаШапки.РеквизитЭлемента) Тогда								
								НовыйЭлемент.ПутьКДанным = ЭлементТаблица.Имя + "." + ТекПрототипРеквзиита.Имя+"."+СтрокаШапки.РеквизитЭлемента;
							Иначе
								НовыйЭлемент.ПутьКДанным = ЭлементТаблица.Имя + "." + ТекПрототипРеквзиита.Имя;
							КонецЕсли;
							
							НовыйЭлемент.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
																				
							Если ТекПрототипРеквзиита.СвойстваЭлемента <> Неопределено Тогда
								ЗаполнитьЗначенияСвойств(НовыйЭлемент, ТекПрототипРеквзиита.СвойстваЭлемента);
							КонецЕсли;
							
							НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПолеТаблицыРедактированияПриИзменении");
							
							Если ТекПрототипРеквзиита.Роль = "Аналитика" Тогда
								
								НовыйЭлемент.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
								НовыйЭлемент.КнопкаОткрытия = Ложь;
								НовыйЭлемент.КнопкаВыбора = Истина;
								НовыйЭлемент.КнопкаВыпадающегоСписка = Ложь;
								НовыйЭлемент.КнопкаСоздания = Ложь;
								НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
								НовыйЭлемент.БыстрыйВыбор = Ложь;
								
								Если ТекПрототипРеквзиита.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
								
									ПараметрыВыбораАналитики = Новый Массив;
									
									ПараметрыВыбораАналитики.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ТекПрототипРеквзиита.ОбъектОписания.ВидАналитики));
									
									НовыйЭлемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораАналитики);
									
								КонецЕсли;
								
								ДобавитьСвязиПараметровВыбораАналитики(НовыйЭлемент, ТекПрототипРеквзиита.ОбъектОписания);
								НовыйЭлемент.УстановитьДействие("НачалоВыбора"   , "Подключаемый_ПолеТаблицыРедактированияНачалоВыбораАналитики");
								НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "Подключаемый_ПолеТаблицыРедактированияОбработкаВыбораАналитики");
								
							ИначеЕсли ТекПрототипРеквзиита.Роль = "РеквизитТаблицы" Тогда
								
								НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
								
								ОписаниеГрафы = ТекПрототипРеквзиита.ОбъектОписания;
								//Колонки всегда цвета заполняемого показателя, по умолчанию доступные.
								//Только просмотр будет устанавливаться непосредственно для каждого вычисляемого показателя.
								НовыйЭлемент.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
									
								Если ОписаниеГрафы.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
									НовыйЭлемент.КнопкаВыбора = Истина;
									НовыйЭлемент.УстановитьДействие("НачалоВыбора", "Подключаемый_ПолеТаблицыРедактированияНачалоВыбора");
								КонецЕсли;
																	
							ИначеЕсли ТекПрототипРеквзиита.Роль = "Свойство" Тогда	
								НовыйЭлемент.ТолькоПросмотр = Истина;
								
							КонецЕсли;
													
						КонецЕсли;
						
						Если СтрокаШапки.НуженОтбор Тогда
							ЕстьЭлементыПоиска = Истина;
							
							ГоризонтальнаяГруппа = Элементы.Добавить(ТекИмяТаблицыРаздела+"ГоризонтальнаяГруппа_Гр"+НомерГруппы+"_Поле"+НомерПоля,Тип("ГруппаФормы"),ГруппаПоискаСтраницыРаздела);
							
							ГоризонтальнаяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
							ГоризонтальнаяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
							ГоризонтальнаяГруппа.ОтображатьЗаголовок = Ложь;
							ГоризонтальнаяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
														
							//Наименование отбора
							ИмяНадписи = ТекИмяТаблицыРаздела+"НадписьПолеПоиска_Гр"+НомерГруппы+"_Поле"+НомерПоля;
							
							НовЭлемент  = Элементы.Добавить(ИмяНадписи,Тип("ДекорацияФормы"),ГоризонтальнаяГруппа);
							НовЭлемент.Ширина 	= 10;
							НовЭлемент.РастягиватьПоГоризонтали = Ложь;
							НовЭлемент.Заголовок = НовыйЭлемент.Заголовок;
														
							//Способ отбора
							//Установим способ отбора для текущего поля
							
							ТекКодЭлемента = СтрокаШапки.КодЭлемента;
							Если ЗначениеЗаполнено(СтрокаШапки.РеквизитЭлемента) Тогда
								ТекКодЭлемента = ТекКодЭлемента + "__" + СтрокаШапки.РеквизитЭлемента;			
							КонецЕсли;
							
							ИмяСпособаОтбора = ТекИмяТаблицыРаздела+"_Способ_Поиск_"+ТекКодЭлемента;
							НовЭлемент  = Элементы.Добавить(ИмяСпособаОтбора,Тип("КнопкаФормы"),ГоризонтальнаяГруппа);
							НовЭлемент.Отображение = ОтображениеКнопки.Текст;
							НовЭлемент.Заголовок = "_А_";  //Содержит
							НовЭлемент.Ширина = 5;
							НовЭлемент.ИмяКоманды = "ИзменитьСпособОтбора";
														
							ЭтотОбъект[ИмяСпособаОтбора] = "Содержит";
							
							//Поле отбора
							ИмяРеквизита = ТекИмяТаблицыРаздела+"_Поиск_"+ТекКодЭлемента;
							
							НовЭлемент  = Элементы.Добавить(ИмяРеквизита,Тип("ПолеФормы"),ГоризонтальнаяГруппа);
							НовЭлемент.ПутьКДанным = ИмяРеквизита;
							НовЭлемент.Вид		 = ВидПоляФормы.ПолеВвода;
							НовЭлемент.Ширина 	= 10;
							//Поля не растягиваются, 
							//чтобы при большом количестве полей и появлении полосы прокрутки,
							//поля полностью были видны на форме.
							НовЭлемент.РастягиватьПоГоризонтали = Ложь;
							НовЭлемент.КнопкаОчистки = Истина;
							НовЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
														
							НовЭлемент.УстановитьДействие("ПриИзменении","ПриИзмененииРеквизитаПоискаРМО_Подключаемый");
							
							НомерПоля = НомерПоля+1;
						КонецЕсли;
					КонецЕсли;
										
					ТекКоличество = ТекКоличество + 1;
					
					ВысотаШапки = Макс(ВысотаШапки,УровеньГруппы);
				КонецЦикла;
				
				Если СозданаШапкаРаздела Тогда
					Продолжить;
				КонецЕсли;
				
				НовыйЭлемент = Элементы.Добавить(ТекИмяТаблицыРаздела+ПрототипРеквизита.Имя,Тип("ПолеФормы"), ТекГруппаКолонок);
				НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
			Иначе
				Продолжить;
			КонецЕсли;
			//
			ГруппаПоискаСтраницыРаздела.Видимость = ЕстьЭлементыПоиска;
			
			ОбщийЕстьЭлементыОтбора = ОбщийЕстьЭлементыОтбора ИЛИ ЕстьЭлементыПоиска;
			
			//
			
			НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = ЭлементТаблица.Имя + "." + ПрототипРеквизита.Имя;
			
			НовыйЭлемент.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
			
			Если ПрототипРеквизита.СвойстваЭлемента <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, ПрототипРеквизита.СвойстваЭлемента);
			КонецЕсли;
			
			НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПолеТаблицыРедактированияПриИзменении");
			
			Если ПрототипРеквизита.Роль = "Аналитика" Тогда
				
				НовыйЭлемент.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
				НовыйЭлемент.КнопкаОткрытия = Ложь;
				НовыйЭлемент.КнопкаВыбора = Истина;
				НовыйЭлемент.КнопкаВыпадающегоСписка = Ложь;
								
				Если ПрототипРеквизита.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
				
					МассивПараметровВыбора = Новый Массив;
					
					МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ПрототипРеквизита.ОбъектОписания.ВидАналитики));
					
					НовыйЭлемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
					
				КонецЕсли;
				
				ДобавитьСвязиПараметровВыбораАналитики(НовыйЭлемент, ПрототипРеквизита.ОбъектОписания);
				НовыйЭлемент.УстановитьДействие("НачалоВыбора"   , "Подключаемый_ПолеТаблицыРедактированияНачалоВыбораАналитики");
				НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "Подключаемый_ПолеТаблицыРедактированияОбработкаВыбораАналитики");
				
			ИначеЕсли ПрототипРеквизита.Роль = "РеквизитТаблицы" Тогда
				
				НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
				
				ОписаниеГрафы = ПрототипРеквизита.ОбъектОписания;
				//Колонки всегда цвета заполняемого показателя, по умолчанию доступные.
				//Только просмотр будет устанавливаться непосредственно для каждого вычисляемого показателя.
				НовыйЭлемент.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
				
				Если ОписаниеГрафы.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
					НовыйЭлемент.КнопкаВыбора = Истина;
					НовыйЭлемент.УстановитьДействие("НачалоВыбора", "Подключаемый_ПолеТаблицыРедактированияНачалоВыбора");
				КонецЕсли;
				
			ИначеЕсли ПрототипРеквизита.Роль = "Свойство" Тогда	
				НовыйЭлемент.ТолькоПросмотр = Истина;	
			ИначеЕсли ПрототипРеквизита.Роль = "Боковик" Тогда
				Если ПрототипРеквизита.Имя = "ПравоеПоле" Тогда
					НовыйЭлемент.Ширина = 2;
					НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ЭлементТаблица.ВысотаШапки = ВысотаШапки +1;
	КонецЦикла;
	
	Элементы.ФормаГруппаОтборыБланка.Видимость = ОбщийЕстьЭлементыОтбора;
КонецПроцедуры

&НаСервере
Процедура ТаблицаРедактированияНастроитьУсловноеОформление(Знач МакетОтображения)
	
	НедоступныеЯчейки = Новый ТаблицаЗначений;
	НедоступныеЯчейки.Колонки.Добавить("ИмяПоляФормы");
	НедоступныеЯчейки.Колонки.Добавить("КодСтроки");
	НедоступныеЯчейки.Колонки.Добавить("ВидДоступности");
	НедоступныеЯчейки.Колонки.Добавить("Раздел");
	НедоступныеЯчейки.Колонки.Добавить("ПредставлениеПустого");
	
	ЗаполнитьКартуДоступностиЯчеек(МакетОтображения, НедоступныеЯчейки);
	
	// Необходимо исключить оформления, которые перекрывают друг-друга
	// в зависимости от их приоритета
	
	ВариантыОформленияГраф = НедоступныеЯчейки.Скопировать();
	ВариантыОформленияГраф.Свернуть("ВидДоступности,ИмяПоляФормы,Раздел,ПредставлениеПустого");
	ВариантыОформленияГраф.Колонки.Добавить("СписокКодовСтрок");
	
	Для Каждого ВариантОформленияГрафы Из ВариантыОформленияГраф Цикл
		
		СписокКодовСтрок = Новый СписокЗначений;
		УсловиеПоиска = Новый Структура("ВидДоступности,ИмяПоляФормы");
		ЗаполнитьЗначенияСвойств(УсловиеПоиска, ВариантОформленияГрафы);
		
		Для Каждого ОписательЯчейки Из НедоступныеЯчейки.НайтиСтроки(УсловиеПоиска) Цикл
			СписокКодовСтрок.Добавить(ОписательЯчейки.КодСтроки);
		КонецЦикла;
		
		ВариантОформленияГрафы.СписокКодовСтрок = СписокКодовСтрок;
		
	КонецЦикла;
	
	ОформленныеПоля = ВариантыОформленияГраф.СкопироватьКолонки("ИмяПоляФормы,СписокКодовСтрок");
	
	ИмяАвтодобавленногоОформления = "-оформление-редактирования-";
	
	// 1. Оформление несуществующих ячеек
	
	НедоступныеПоля = ВариантыОформленияГраф.НайтиСтроки(Новый Структура("ВидДоступности","Х"));
	
	МассивОбработанныхГрупп = Новый Массив;
	Для Каждого СтрВидаДоступности Из НедоступныеПоля Цикл
		
		Если Элементы.Найти(СтрВидаДоступности.ИмяПоляФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекРодитель = Элементы[СтрВидаДоступности.ИмяПоляФормы].Родитель;
		
		ГруппаВЯчейке = Ложь;
		Если ТипЗнч(ТекРодитель) = Тип("ГруппаФормы") Тогда
			Если ТекРодитель.Группировка = ГруппировкаКолонок.ВЯчейке Тогда
				ГруппаВЯчейке = Истина;
				Если МассивОбработанныхГрупп.Найти(ТекРодитель) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПоля);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "х");
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Центр);		
				
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(СтрВидаДоступности.ИмяПоляФормы);
				
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".КодСтроки");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СтрВидаДоступности.СписокКодовСтрок;
		ЭлементОтбора.Использование  = Истина;
		
		Если ГруппаВЯчейке Тогда
			//Группа ячеек используется для вывода разных аналитик в одном поле.
			//У записей строк без раскрытия нет аналитики, поэтому для них выводится представление запрещенного поля "Х" только 1 раз на всю группу.
			МассивОбработанныхГрупп.Добавить(ТекРодитель);
			ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".ВидЗаписи");
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = "";
			ЭлементОтбора.Использование  = Истина;
		КонецЕсли;
		
		ЭлементОформления.Использование = Истина;
		
		СтрОформлено = ОформленныеПоля.Добавить();
		ЗаполнитьЗначенияСвойств(СтрОформлено, СтрВидаДоступности);
		
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
			
	КонецЦикла;
	
	//1.1 Представление пустого значения колонок по настройке шапки
	НедоступныеПоля = ВариантыОформленияГраф.НайтиСтроки(Новый Структура("ВидДоступности","ПредставлениеПустого"));
	Для Каждого СтрВидаДоступности Из НедоступныеПоля Цикл
		
		Если Элементы.Найти(СтрВидаДоступности.ИмяПоляФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеОформлено = ОформленныеПоля.Найти(СтрВидаДоступности.ИмяПоляФормы,"ИмяПоляФормы");
		Если УжеОформлено <> Неопределено Тогда
			Для Каждого ЭлементСпискаКодСтроки Из УжеОформлено.СписокКодовСтрок Цикл
				КодСтрокиТекущегоОформления = СтрВидаДоступности.СписокКодовСтрок.НайтиПоЗначению(ЭлементСпискаКодСтроки.Значение);
				Если КодСтрокиТекущегоОформления <> Неопределено Тогда
					СтрВидаДоступности.СписокКодовСтрок.Удалить(КодСтрокиТекущегоОформления);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ИмяТаблицыРаздела = ИмяТаблицыРаздела(СтрВидаДоступности.Раздел);
		ТекИмяПоля = СтрЗаменить(СтрВидаДоступности.ИмяПоляФормы,ИмяТаблицыРаздела,"");
		ПозицияРеквизита = Найти(ТекИмяПоля,"__");
		Если ПозицияРеквизита>0 Тогда
			ТекИмяПоля = Лев(ТекИмяПоля,ПозицияРеквизита-1);
		КонецЕсли;
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", СтрВидаДоступности.ПредставлениеПустого);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(СтрВидаДоступности.ИмяПоляФормы);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела+".КодСтроки");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СтрВидаДоступности.СписокКодовСтрок;
		ЭлементОтбора.Использование  = Истина;
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела+"."+ТекИмяПоля);
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		ЭлементОтбора.Использование  = Истина;
		
		Если Найти(ТекИмяПоля,"Аналитика") = 1 Тогда
			//Если это аналитика, то оформление устанавливаем только в строках раскрытия
			ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".ВидЗаписи");
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = "Раскрытие";
			ЭлементОтбора.Использование  = Истина;
		КонецЕсли;
		
		ЭлементОформления.Использование = Истина;
		
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
		
	КонецЦикла;
	
	//1.2 Обязательная аналитика
	НедоступныеПоля = ВариантыОформленияГраф.НайтиСтроки(Новый Структура("ВидДоступности","Обязательная"));
	Для Каждого СтрВидаДоступности Из НедоступныеПоля Цикл
		
		Если Элементы.Найти(СтрВидаДоступности.ИмяПоляФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
				
		ИмяТаблицыРаздела = ИмяТаблицыРаздела(СтрВидаДоступности.Раздел);
		ТекИмяПоля = СтрЗаменить(СтрВидаДоступности.ИмяПоляФормы,ИмяТаблицыРаздела,"");
		ПозицияРеквизита = Найти(ТекИмяПоля,"__");
		Если ПозицияРеквизита>0 Тогда
			ТекИмяПоля = Лев(ТекИмяПоля,ПозицияРеквизита-1);
		КонецЕсли;
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(СтрВидаДоступности.ИмяПоляФормы);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела+".КодСтроки");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СтрВидаДоступности.СписокКодовСтрок;
		ЭлементОтбора.Использование  = Истина;
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".ВидЗаписи");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = "Раскрытие";
		ЭлементОтбора.Использование  = Истина;
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела+"."+ТекИмяПоля);
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		ЭлементОтбора.Использование  = Истина;
		
		ЭлементОформления.Использование = Истина;
				
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
		
	КонецЦикла;
	
	// 2. Оформление локально недоступных ячеек
	НедоступныеПоля = ВариантыОформленияГраф.НайтиСтроки(Новый Структура("ВидДоступности","ВычисляемыйПоказатель"));
	Для Каждого СтрВидаДоступности Из НедоступныеПоля Цикл
		
		Если Элементы.Найти(СтрВидаДоступности.ИмяПоляФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеОформлено = ОформленныеПоля.Найти(СтрВидаДоступности.ИмяПоляФормы,"ИмяПоляФормы");
		Если УжеОформлено <> Неопределено Тогда
			Для Каждого ЭлементСпискаКодСтроки Из УжеОформлено.СписокКодовСтрок Цикл
				КодСтрокиТекущегоОформления = СтрВидаДоступности.СписокКодовСтрок.НайтиПоЗначению(ЭлементСпискаКодСтроки.Значение);
				Если КодСтрокиТекущегоОформления <> Неопределено Тогда
					СтрВидаДоступности.СписокКодовСтрок.Удалить(КодСтрокиТекущегоОформления);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если СтрВидаДоступности.СписокКодовСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрОформлено = ОформленныеПоля.Добавить();
		ЗаполнитьЗначенияСвойств(СтрОформлено, СтрВидаДоступности);
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветВычисляемогоПоказателя);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(СтрВидаДоступности.ИмяПоляФормы);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".КодСтроки");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СтрВидаДоступности.СписокКодовСтрок;
		ЭлементОтбора.Использование  = Истина;
		
		ЭлементОформления.Использование = Истина;
		
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
		
	КонецЦикла;
	
	// 3. Оформление итогов по раскрытию
	ОформлениеРазделовСИтогами = ВариантыОформленияГраф.НайтиСтроки(Новый Структура("ВидДоступности","ИтогПоРаскрытию"));
	Для Каждого СтрВидаДоступности Из ОформлениеРазделовСИтогами Цикл
		
		Если Элементы.Найти(СтрВидаДоступности.ИмяПоляФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветВычисляемогоПоказателя);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(СтрВидаДоступности.ИмяПоляФормы);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(СтрВидаДоступности.Раздел)+".ВидЗаписи");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = "Итог";
		ЭлементОтбора.Использование  = Истина;
			
		ЭлементОформления.Использование = Истина;
		
		ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
		
	КонецЦикла;
	
	// 4. Оформление ячеек, содержащих промежуточные итоги
	// 4.1 Оформление ТолькоПросмотр у ячеек, расположенных в группе
	ЦветПромежуточногоИтога = Новый Цвет(255,253,253);
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		ИмяТабРаздела = ИмяТаблицыРаздела(Раздел);
		Для Каждого Строка Из Раздел.СтрокиРаздела.НайтиСтроки(Новый Структура("ЕстьАналитика",Истина)) Цикл
			Для Каждого Графа Из Раздел.ГрафыРаздела Цикл
					
				КодПоказателя = Строка.Код+"_"+Графа.Код;
				
				ОписаниеПоказателя = ОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
				Если ОписаниеПоказателя <> Неопределено 
					И ОписаниеПоказателя.РазрешитьПромежуточныеИтоги Тогда
					ИмяПоляФормы = ИмяТабРаздела+Графа.Код;
					
					Если Элементы.Найти(ИмяПоляФормы) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
		
					ЭлементОформления = УсловноеОформление.Элементы.Добавить();
					ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветПромежуточногоИтога);
					
					ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
					ОформляемоеПоле.Использование = Истина;
					ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(ИмяТабРаздела+Графа.Код);
					
					ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТабРаздела+".ВидЗаписи");
					ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
					ЭлементОтбора.ПравоеЗначение = "Раскрытие";
					ЭлементОтбора.Использование  = Истина;
					
					ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТабРаздела+".ПромежуточныеИтоги");
					ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
					ЭлементОтбора.ПравоеЗначение = ","+ КодПоказателя +",";
					ЭлементОтбора.Использование  = Истина;
					
					ЭлементОформления.Использование = Истина;
					ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		ОформляемыеГруппы = Новый Массив;
		ОпределитьПодчиненныеГруппыВЯчейке(Элементы[ИмяТабРаздела],ОформляемыеГруппы);

		Для Каждого ТекЭлемент Из ОформляемыеГруппы Цикл
			
			ЭлементОформления = УсловноеОформление.Элементы.Добавить();
			ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
			Для Каждого ПолеВГруппе Из ТекЭлемент.ПодчиненныеЭлементы Цикл
				
				ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
				ОформляемоеПоле.Использование = Истина;
				ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(ПолеВГруппе.Имя);
				
				
			КонецЦикла;
			ЭлементОформления.Использование = Истина;

			ЭлементОформления.Представление = ИмяАвтодобавленногоОформления;	
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОпределитьПодчиненныеГруппыВЯчейке(ПроверяемыйЭлемент,МассивГрупп)
	
	Для Каждого ТекЭлемент Из ПроверяемыйЭлемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
			Если ТекЭлемент.Группировка = ГруппировкаКолонок.ВЯчейке Тогда
				МассивГрупп.Добавить(ТекЭлемент);
			Иначе
				ОпределитьПодчиненныеГруппыВЯчейке(ТекЭлемент,МассивГрупп);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСвязиПараметровВыбораАналитики(Знач Элемент, Знач ТекущаяАналитика)

	ТаблицаАналитик = ТекущаяАналитика.Владелец();
	
	Если мПараметрыВыбораСогласованныхАналитик = Неопределено Тогда
		мПараметрыВыбораСогласованныхАналитик = БюджетнаяОтчетность.ПараметрыВыбораСогласованныхАналитик(ТаблицаАналитик);
	КонецЕсли;
	
	СценарийВыбора = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(ТаблицаАналитик, ТекущаяАналитика.ВидАналитики, мПараметрыВыбораСогласованныхАналитик);
	
	ТекРодитель = Элемент.Родитель;
	Пока ТипЗнч(ТекРодитель) <> Тип("ТаблицаФормы") Цикл
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если СценарийВыбора <> Неопределено Тогда
		
		НомерТекущейАналитики = ТаблицаАналитик.Индекс(ТекущаяАналитика);
		СвязиПараметровЭлемента = Новый Массив;
		Для Каждого СвязьОтбора Из СценарийВыбора.СвязиОтбора Цикл
			
			НомерИскомойАналитики = НомерТекущейАналитики + СвязьОтбора.Смещение;
			Если НомерИскомойАналитики >= 0 И НомерИскомойАналитики < ТаблицаАналитик.Количество()-1 Тогда
				
				ИмяПоляСвязи = "Аналитика" + ТаблицаАналитик[НомерИскомойАналитики].Код;
				СвязьПараметраВыбора = Новый СвязьПараметраВыбора("Отбор."+СвязьОтбора.ПолеОтбора, "Элементы."+ТекРодитель.ПутьКДанным+".ТекущиеДанные."+ИмяПоляСвязи);
				СвязиПараметровЭлемента.Добавить(СвязьПараметраВыбора);
			КонецЕсли;
			
		КонецЦикла;
		
		Если СвязиПараметровЭлемента.Количество() Тогда
			Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровЭлемента);
		КонецЕсли;
		
		// Добавление фиксированных параметров отбора
		Если СценарийВыбора.Отбор.Количество() Тогда
			
			МассивПараметровВыбора = Новый Массив;
			
			Для Каждого КлючИЗначение Из СценарийВыбора.Отбор Цикл
				ПараметрВыбора = Новый ПараметрВыбора("ДополнительныйОтбор."+КлючИЗначение.Ключ, КлючИЗначение.Значение);
				МассивПараметровВыбора.Добавить(ПараметрВыбора);
			КонецЦикла;
			
			Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ДобавитьСвязиПараметровВыбораАналитики()

&НаСервере
Процедура ЗаполнитьКартуДоступностиЯчеек(Знач МакетОтображения, НедоступныеЯчейки)
	
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		
		ИмяТаблицыРаздела = ИмяТаблицыРаздела(Раздел);
		// Проверка существования ячеек и их доступности
		Для Каждого Строка Из Раздел.СтрокиРаздела Цикл
			Для Каждого Графа Из Раздел.ГрафыРаздела Цикл
				
				КодПоказателя = Строка.Код+"_"+Графа.Код;
				
				ОписаниеПоказателя = ОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
				Если ОписаниеПоказателя <> Неопределено 
					И Не ОписаниеПоказателя.Отключен Тогда
					Если ОписаниеПоказателя.СпособОбработки = Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление Тогда
						
						НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
						НедоступнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+Графа.Код;
						НедоступнаяЯчейка.КодСтроки = Строка.Код;
						НедоступнаяЯчейка.ВидДоступности = "ВычисляемыйПоказатель";
						НедоступнаяЯчейка.Раздел = Раздел;
						
					КонецЕсли;
				Иначе
					
					НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
					НедоступнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+Графа.Код;
					НедоступнаяЯчейка.КодСтроки = Строка.Код;
					НедоступнаяЯчейка.ВидДоступности = "Х";
					НедоступнаяЯчейка.Раздел = Раздел;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		// определение отсутствия аналитики
		ВсеАналитикиОтчета     = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ОтчетОбъект.ВидОтчета);
		ВсеВидыАналитикРаздела = Новый Массив;
		ЕстьСтрокиИтогов = Ложь;
		Для Каждого Строка Из Раздел.СтрокиРаздела Цикл
			
			Если Строка.ЕстьАналитика Тогда
				ЕстьСтрокиИтогов = Истина;
				
				Для Каждого СтрАналитика Из Строка.ОписаниеАналитики Цикл
					Если ВсеВидыАналитикРаздела.Найти(СтрАналитика.Код) = Неопределено Тогда
						ВсеВидыАналитикРаздела.Добавить(СтрАналитика.Код);
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьСтрокиИтогов Тогда
			НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
			НедоступнаяЯчейка.ИмяПоляФормы   = ИмяТаблицыРаздела;
			НедоступнаяЯчейка.КодСтроки      = "";
			НедоступнаяЯчейка.ВидДоступности = "ИтогПоРаскрытию";
			НедоступнаяЯчейка.Раздел         = Раздел;
		КонецЕсли;
		
		Для Каждого Строка Из Раздел.СтрокиРаздела Цикл
			
			Для Каждого КодВидаАналитики Из ВсеВидыАналитикРаздела Цикл
				Если НЕ Строка.ЕстьАналитика 
					ИЛИ Строка.ОписаниеАналитики.Найти(КодВидаАналитики,"Код") = Неопределено Тогда
					НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
					НедоступнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+"Аналитика"+КодВидаАналитики;
					НедоступнаяЯчейка.КодСтроки = Строка.Код;
					НедоступнаяЯчейка.ВидДоступности = "Х";
					НедоступнаяЯчейка.Раздел = Раздел;
					
					УстановитьНедоступнуюЯчейкуДляРеквизитов(НедоступныеЯчейки,Элементы[ИмяТаблицыРаздела],НедоступнаяЯчейка.ИмяПоляФормы,Раздел,Строка.Код);
					
				КонецЕсли;
				
				Если Строка.ЕстьАналитика Тогда
					СтрокаОА = Строка.ОписаниеАналитики.Найти(КодВидаАналитики,"Код");
					Если СтрокаОА <> Неопределено Тогда
					
						НастройкиАналитики = Раздел.ШапкаРаздела.НайтиСтроки(Новый Структура("КодЭлемента","Аналитика"+КодВидаАналитики));
						
						Для Каждого ТекНастройка Из НастройкиАналитики Цикл
							Если ЗначениеЗаполнено(ТекНастройка.ПредставлениеПустого) Тогда
								НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
								НедоступнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+"Аналитика"+КодВидаАналитики+?(ЗначениеЗаполнено(ТекНастройка.РеквизитЭлемента),"__"+ТекНастройка.РеквизитЭлемента,"");
								НедоступнаяЯчейка.КодСтроки = Строка.Код;
								НедоступнаяЯчейка.ВидДоступности = "ПредставлениеПустого";
								НедоступнаяЯчейка.ПредставлениеПустого = ТекНастройка.ПредставлениеПустого;
								НедоступнаяЯчейка.Раздел = Раздел;
							КонецЕсли;
							Если СтрокаОА.Обязательный Тогда
								ОбязательнаяЯчейка = НедоступныеЯчейки.Добавить();
								ОбязательнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+"Аналитика"+КодВидаАналитики+?(ЗначениеЗаполнено(ТекНастройка.РеквизитЭлемента),"__"+ТекНастройка.РеквизитЭлемента,"");
								ОбязательнаяЯчейка.КодСтроки = Строка.Код;
								ОбязательнаяЯчейка.ВидДоступности = "Обязательная";
								ОбязательнаяЯчейка.Раздел = Раздел;
							КонецЕсли;
						КонецЦикла;
						Если Раздел.ШапкаРаздела.Количество() = 0 Тогда
							Если СтрокаОА.Обязательный Тогда
								ОбязательнаяЯчейка = НедоступныеЯчейки.Добавить();
								ОбязательнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+"Аналитика"+КодВидаАналитики;
								ОбязательнаяЯчейка.КодСтроки = Строка.Код;
								ОбязательнаяЯчейка.ВидДоступности = "Обязательная";
								ОбязательнаяЯчейка.Раздел = Раздел;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
						
			Для Каждого ТекНастройка Из Раздел.ШапкаРаздела Цикл
				Если ЗначениеЗаполнено(ТекНастройка.ПредставлениеПустого)
					И Найти(ТекНастройка.КодЭлемента,"Аналитика")<>1 Тогда
					НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
					НедоступнаяЯчейка.ИмяПоляФормы = ИмяТаблицыРаздела+ТекНастройка.КодЭлемента+?(ЗначениеЗаполнено(ТекНастройка.РеквизитЭлемента),"__"+ТекНастройка.РеквизитЭлемента,"");
					НедоступнаяЯчейка.КодСтроки = Строка.Код;
					НедоступнаяЯчейка.ВидДоступности = "ПредставлениеПустого";
					НедоступнаяЯчейка.ПредставлениеПустого = ТекНастройка.ПредставлениеПустого;
					НедоступнаяЯчейка.Раздел = Раздел;
				КонецЕсли;
			КонецЦикла;
				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры // СоздатьКартуДоступностиЯчеек()

&НаСервере
Процедура УстановитьНедоступнуюЯчейкуДляРеквизитов(НедоступныеЯчейки, ЭлементТаблица, ИмяНедоступнойЯчейки,Раздел,КодСтроки)
	
	Для Каждого ПолеТаблицы Из ЭлементТаблица.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПолеТаблицы) = Тип("ПолеФормы") Тогда
			Если Найти(ПолеТаблицы.Имя, ИмяНедоступнойЯчейки + "__") = 1 Тогда
				НедоступнаяЯчейка = НедоступныеЯчейки.Добавить();
				НедоступнаяЯчейка.ИмяПоляФормы = ПолеТаблицы.Имя;
				НедоступнаяЯчейка.КодСтроки = КодСтроки;
				НедоступнаяЯчейка.ВидДоступности = "Х";
				НедоступнаяЯчейка.Раздел = Раздел;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ПолеТаблицы) = Тип("ГруппаФормы") Тогда
			УстановитьНедоступнуюЯчейкуДляРеквизитов(НедоступныеЯчейки, ПолеТаблицы, ИмяНедоступнойЯчейки,Раздел,КодСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // УстановитьНедоступнуюЯчейкуДляРеквизитов()

&НаКлиенте
Процедура ПослеВыбораАналитикиВФормеВыбора(РезультатЗакрытия,ДополнительныеПараметры)Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанныеЭлемента = ТекущиеДанныеПоЭлементуТаблицы(ДополнительныеПараметры.Поле);
	ПараметрыВыбораАналитики   = ПолучитьПараметрыНачалаВыбораАналитики(ДополнительныеПараметры.Поле);
	
	Если Не ПараметрыВыбораАналитики.СтандартнаяОбработка Тогда
		
		НовыеЗначенияАналитикСтроки = ПолучитьИзмененныеАналитикиПриОбработкеВыбора(ТекДанныеЭлемента.ИмяТаблицыФормы, 
												ТекДанныеЭлемента.РеквизитДанных,
												ТекДанныеЭлемента.ТекущиеДанные.КодСтроки,
												ТекДанныеЭлемента.ЗначениеЭлемента,
												РезультатЗакрытия,
												АдресНастроекОтчета);
												
		Если НовыеЗначенияАналитикСтроки <> Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			Для Каждого КлючИЗначение Из НовыеЗначенияАналитикСтроки Цикл
				ТекДанныеЭлемента.ТекущиеДанные[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				ЗарегистрироватьИзменениеТаблицы(ТекДанныеЭлемента.ИмяТаблицыФормы+КлючИЗначение.Ключ, Элементы[ТекДанныеЭлемента.ИмяТаблицыФормы].ТекущаяСтрока);
			КонецЦикла;
		КонецЕсли;
	Иначе
		
		ВыбранноеЗначение = РезультатЗакрытия;
		
		Если ПараметрыВыбораАналитики.Свойство("ПараметрыВыбора")
			И ПараметрыВыбораАналитики.ПараметрыВыбора.Свойство("ЭтоКБКСтрокой") Тогда
			
			ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(ВыбранноеЗначение,ПараметрыВыбораАналитики.ПараметрыВыбора.ЭтоКБКСтрокой);
			
		КонецЕсли;
		
		ТекДанныеЭлемента.ТекущиеДанные[ПараметрыВыбораАналитики.ИмяПоля] = ВыбранноеЗначение;
		ЗарегистрироватьИзменениеТаблицы(ТекДанныеЭлемента.ИмяТаблицыФормы+ПараметрыВыбораАналитики.ИмяПоля, Элементы[ТекДанныеЭлемента.ИмяТаблицыФормы].ТекущаяСтрока);
	КонецЕсли;
	
	ЭтотОбъект.Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция СоздатьСтраницуРаздела(Раздел)

	СтраницаРаздела = Элементы.Добавить("СтраницаРаздел"+Раздел.Индекс, Тип("ГруппаФормы"), Элементы.РазделыМакета);
	СтраницаРаздела.Вид       = ВидГруппыФормы.Страница;
	СтраницаРаздела.Заголовок = Раздел.Заголовок;
	
	Возврат СтраницаРаздела;

КонецФункции // СоздатьСтраницуРаздела()

&НаСервереБезКонтекста
Функция ИмяТаблицыРаздела(Знач Раздел)

	Возврат "Раздел"+Раздел.Индекс;

КонецФункции // ИмяТаблицыРаздела()

&НаСервереБезКонтекста
Функция НайтиРазделПоИмени(Знач МакетОтображения, Знач ИмяРаздела)

	ТекущийРаздел = Неопределено;
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		Если ИмяТаблицыРаздела(Раздел) = ИмяРаздела Тогда
			ТекущийРаздел = Раздел;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ТекущийРаздел;
	
КонецФункции // НайтиРазделПоИмени()

&НаСервере
Процедура ЗаполнитьПереченьРеквизитовТаблицыРаздела(Знач Раздел, Знач СоздаваемыеРеквизиты)
	
	ИмяТаблицыРаздела = ИмяТаблицыРаздела(Раздел);
	ЧислоРеквизитов   = СоздаваемыеРеквизиты.Количество();
	
	РеквизитТаблица                = СоздаваемыеРеквизиты.Добавить();
	РеквизитТаблица.Имя            = ИмяТаблицыРаздела;
	РеквизитТаблица.ТипЗначения    = Новый ОписаниеТипов("ТаблицаЗначений");//Новый ОписаниеТипов("ДеревоЗначений");//
	РеквизитТаблица.Роль           = "Таблица";
	РеквизитТаблица.ОбъектОписания = Раздел;
	
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "КодСтроки", Новый ОписаниеТипов("Строка"));
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "ВидЗаписи", Новый ОписаниеТипов("Строка"));
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "Порядок"  , Новый ОписаниеТипов("Число"));
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "Индекс"   , Новый ОписаниеТипов("Число"));
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "ПромежуточныеИтоги", Новый ОписаниеТипов("Строка"));
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "Боковик"  , Новый ОписаниеТипов("Строка"), НСтр("ru = 'Строка отчета'"), "Боковик");
		
	//Поиск, Свойства
	ТекСписокСвойствРаздела = "";
	Для Каждого СтрШапки Из Раздел.ШапкаРаздела Цикл
		
		Если СтрШапки.НуженОтбор Тогда
			
			ТекИмя = СтрШапки.КодЭлемента;
			Если ЗначениеЗаполнено(СтрШапки.РеквизитЭлемента) Тогда
				ТекИмя = ТекИмя + "__" + СтрШапки.РеквизитЭлемента; 
			КонецЕсли;
			
			РеквизитПоиска                = СоздаваемыеРеквизиты.Добавить();
			РеквизитПоиска.Имя            = ИмяТаблицыРаздела+"_Поиск_"+ТекИмя;
			РеквизитПоиска.ТипЗначения    = Новый ОписаниеТипов("Строка");
			РеквизитПоиска.Роль           = "Поиск";
			РеквизитПоиска.ОбъектОписания = СтрШапки;
			
			РеквизитПоиска                = СоздаваемыеРеквизиты.Добавить();
			РеквизитПоиска.Имя            = ИмяТаблицыРаздела+"_Способ_Поиск_"+ТекИмя;
			РеквизитПоиска.ТипЗначения    = Новый ОписаниеТипов("Строка");
			РеквизитПоиска.Роль           = "Поиск";
					
			РеквизитВидимости             	 = СоздаваемыеРеквизиты.Добавить();
			РеквизитВидимости.ИмяРодителя  	 = ИмяТаблицыРаздела;
			РеквизитВидимости.Имя            = "Поиск_"+ТекИмя+"__Скрыта";
			РеквизитВидимости.ТипЗначения    = Новый ОписаниеТипов("Булево");
			РеквизитВидимости.Роль           = "Поиск";
			РеквизитВидимости.ОбъектОписания = СтрШапки;
		КонецЕсли;
		
		Если ТипЗнч(СтрШапки.ЭлементОтчета) = Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") Тогда
			РеквизитСвойства             	= СоздаваемыеРеквизиты.Добавить();
			РеквизитСвойства.ИмяРодителя  	= ИмяТаблицыРаздела;
			РеквизитСвойства.Имя            = СтрШапки.КодЭлемента;
			РеквизитСвойства.ТипЗначения    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрШапки.ЭлементОтчета,"ТипЗначения");
			РеквизитСвойства.Роль           = "Свойство";
			РеквизитСвойства.ОбъектОписания = СтрШапки;
			Если ЗначениеЗаполнено(СтрШапки.ЗаголовокЭлемента) Тогда
				РеквизитСвойства.Заголовок = СтрШапки.ЗаголовокЭлемента;
			КонецЕсли;
			ТекСписокСвойствРаздела = ТекСписокСвойствРаздела + "," + РеквизитСвойства.Имя;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекСписокСвойствРаздела = Сред(ТекСписокСвойствРаздела,2);
	
	Если ТипЗнч(СписокСвойствРаздела) = Тип("ФиксированнаяСтруктура") Тогда
		СтруктураСпискаСвойств = Новый Структура(СписокСвойствРаздела);
	Иначе
		СтруктураСпискаСвойств = Новый Структура;
	КонецЕсли;
	
	СтруктураСпискаСвойств.Вставить(ИмяТаблицыРаздела,ТекСписокСвойствРаздела);
	
	СписокСвойствРаздела = Новый ФиксированнаяСтруктура(СтруктураСпискаСвойств);
	
	//Аналитика раздела
	КолонкиАналитики = Новый Соответствие;
	
	Для Каждого Строка Из Раздел.СтрокиРаздела Цикл
		Если Строка.ЕстьАналитика Тогда
			
			Строка.ОписаниеАналитики.Колонки.Наименование.Имя = "Заголовок";
			
			Для Каждого Аналитика Из Строка.ОписаниеАналитики Цикл
				Если КолонкиАналитики[Аналитика.Код] = Неопределено Тогда
					
					Реквизит           = ДобавитьПрототипРеквизита(РеквизитТаблица, Аналитика, "Аналитика");
					Реквизит.Заголовок = Аналитика.Код;
					Реквизит.СвойстваЭлемента.Вставить("Подсказка", Аналитика.Заголовок);
					
					КолонкиАналитики[Аналитика.Код] = Истина;
					
				КонецЕсли;
			КонецЦикла;
			
			Строка.ОписаниеАналитики.Колонки.Заголовок.Имя = "Наименование";
			
		КонецЕсли;
	КонецЦикла;
	
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - ОтчетОбъект.УровеньТочности);
	Квалификатор       = Новый КвалификаторыЧисла(РазрядностьЧисла, ОтчетОбъект.УровеньТочности);
	
	МассивСтрок = Раздел.СтрокиРаздела.ВыгрузитьКолонку("Объект");
	
	Для Каждого Графа Из Раздел.ГрафыРаздела Цикл
		
		ИмяКолонкиГрафа = Графа.Код;
		
		МассивТиповПоказателей = ПолучитьМассивТиповПоказателейДляСтрок(МассивСтрок, Графа.Объект);
		Если МассивТиповПоказателей.Количество()>1 Тогда
			//в одной колонке показатели с разными типами
			МассивТипов = Новый Массив;
			Для Каждого ТекТип Из МассивТиповПоказателей Цикл
				Если ТекТип = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
					МассивТипов.Добавить(Тип("Число"));
				ИначеЕсли ТекТип = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
					МассивТипов.Добавить(Тип("Строка"));
				ИначеЕсли ТекТип = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
					МассивТипов.Добавить(Тип("Дата"));
				ИначеЕсли ТекТип = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
					МассивТипов.Добавить(Тип("Булево"));
				КонецЕсли;			
			КонецЦикла;
			Графа.ТипЗначения = Новый ОписаниеТипов(МассивТипов,Квалификатор);
		Иначе
			Если Графа.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				Графа.ТипЗначения = Новый ОписаниеТипов("Число",Квалификатор);
			КонецЕсли;
		КонецЕсли;
		
		ДобавитьПрототипРеквизита(РеквизитТаблица, Графа);
		
	КонецЦикла;
	
	ДобавитьСлужебныйРеквизитТаблицыРаздела(РеквизитТаблица, "ПравоеПоле", Новый ОписаниеТипов("Строка"), Символы.НПП, "Боковик");
	
	// Установка раздела-родителя
	Если СоздаваемыеРеквизиты.Количество() > ЧислоРеквизитов Тогда
		
		Для Сч = ЧислоРеквизитов По СоздаваемыеРеквизиты.Количество()-1 Цикл
			СоздаваемыеРеквизиты[Сч].Раздел = Раздел;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивТиповПоказателейДляСтрок(МассивСтрок, Колонка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ПоказателиОтчетов.ТипЗначения = &ПустоЗначение
		|			ТОГДА &ТипЧисло
		|		ИНАЧЕ ПоказателиОтчетов.ТипЗначения
		|	КОНЕЦ КАК ТипПоказателя
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Строка В(&МассивСтрок)
		|	И ПоказателиОтчетов.Колонка = &Колонка";
	
	Запрос.УстановитьПараметр("Колонка", Колонка);
	Запрос.УстановитьПараметр("МассивСтрок", МассивСтрок);
	Запрос.УстановитьПараметр("ПустоЗначение", Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТипЧисло", Перечисления.ТипыЗначенийПоказателейОтчетов.Число);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивТиповПоказателей = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивТиповПоказателей.Добавить(ВыборкаДетальныеЗаписи.ТипПоказателя);
	КонецЦикла;
	
	Возврат МассивТиповПоказателей; 
	
КонецФункции

&НаСервере
Функция ДобавитьСлужебныйРеквизитТаблицыРаздела(Знач СтрТаблицаРаздела, Знач Имя, Знач ТипЗначения, Знач Заголовок = "", Знач Роль = "Служебный")

	ОписаниеСлужебногоРеквизита             = Новый Структура("Код,ТипЗначения,Заголовок");
	ОписаниеСлужебногоРеквизита.Код         = Имя;
	ОписаниеСлужебногоРеквизита.ТипЗначения = ТипЗначения;
	ОписаниеСлужебногоРеквизита.Заголовок   = Заголовок;
	
	Возврат ДобавитьПрототипРеквизита(СтрТаблицаРаздела, ОписаниеСлужебногоРеквизита, Роль);

КонецФункции // ДобавитьСлужебныйРеквизитТаблицыРаздела()

&НаСервере
Функция ДобавитьПрототипРеквизита(Знач СтрТаблицаРаздела, Знач ОбъектОписания, Знач Роль = "РеквизитТаблицы")

	ОсновнаяТаблица = СтрТаблицаРаздела.Владелец();
	
	СтрРеквизит = ОсновнаяТаблица.Добавить();
	СтрРеквизит.Имя          = ?(Роль = "Аналитика","Аналитика"+ОбъектОписания.Код,ОбъектОписания.Код);
	СтрРеквизит.ТипЗначения  = ОбъектОписания.ТипЗначения;
	СтрРеквизит.Заголовок    = ОбъектОписания.Заголовок;
	СтрРеквизит.Роль         = Роль;
	СтрРеквизит.ИмяРодителя  = СтрТаблицаРаздела.Имя;
	СтрРеквизит.СвойстваРеквизита = Новый Структура;
	СтрРеквизит.СвойстваЭлемента  = Новый Структура;
	
	Если Роль <> "Служебный" Тогда
		СтрРеквизит.ОбъектОписания = ОбъектОписания;
	КонецЕсли;
	
	Возврат СтрРеквизит;

КонецФункции // ДобавитьПрототипРеквизита()

&НаСервереБезКонтекста
Функция ПараметрыНачалаВыбораДляОднойАналитики(Знач ТекущаяАналитика, Знач АналитикиГруппы)

	СценарийВыбора = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(АналитикиГруппы, ТекущаяАналитика.ВидАналитики);
	Результат = Новый Структура;
	Результат.Вставить("ВидАналитики", ТекущаяАналитика.ВидАналитики);
	Результат.Вставить("ИмяОбъектаАналитики", ТекущаяАналитика.ИмяОбъектаАналитики);
		
	Если СценарийВыбора <> Неопределено Тогда
		ТекущаяФорма       = СценарийВыбора.ФормаВыбора;
		СтрокаТекущейФормы = СценарийВыбора;
		
		Пока ТекущаяФорма = Неопределено Цикл
			СтрокаТекущейФормы = СтрокаТекущейФормы.Родитель;
			ТекущаяФорма = СтрокаТекущейФормы.ФормаВыбора;
		КонецЦикла;
		
		ИмяТипа     = Метаданные.НайтиПоТипу(СтрокаТекущейФормы.ТипДанных).ПолноеИмя();		
		
		Если Не ПустаяСтрока(ТекущаяФорма) Тогда
			ФормаВыбора = ИмяТипа + ".Форма." + ТекущаяФорма;
			Результат.Вставить("СтандартнаяОбработка", Ложь);
		Иначе
			ФормаВыбора = ИмяТипа + ".ФормаВыбора";
			Результат.Вставить("СтандартнаяОбработка", Истина);
		КонецЕсли;
		
		Результат.Вставить("ЭтоКБКСтрокой", Ложь);
		
	Иначе
		Результат.Вставить("СтандартнаяОбработка", Истина);
		
		Если НЕ ЗначениеЗаполнено(ТекущаяАналитика.ВидКлассификатораБК) Тогда
			Результат.Вставить("ЭтоКБКСтрокой", Ложь);
			ИмяТипа     = Метаданные.НайтиПоТипу(ТекущаяАналитика.ТипЗначения.Типы()[0]).ПолноеИмя();
			ФормаВыбора = ИмяТипа + ".ФормаВыбора";
		Иначе
			Результат.Вставить("ЭтоКБКСтрокой", Истина);
			ФормаВыбора = БюджетнаяОтчетностьКлиентСервер.ПолучитьИмяФормыВыбораБК(ТекущаяАналитика.ВидКлассификатораБК);
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("ФормаВыбора", ФормаВыбора);
	
	Возврат Результат;

КонецФункции // ПараметрыНачалаВыбораДляОднойАналитики()

&НаСервереБезКонтекста
Функция ПолучитьПараметрыНачалаВыбораАналитикиСервер(Знач КодГруппыРаскрытия, Знач ВидОтчета)
 
	ПереченьАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
	АналитикиГруппы  = ПереченьАналитик.Скопировать(Новый Структура("КодГруппыРаскрытия",КодГруппыРаскрытия));
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрАналитикаГруппы Из АналитикиГруппы Цикл
		
		ПараметрВыбора = ПараметрыНачалаВыбораДляОднойАналитики(СтрАналитикаГруппы, АналитикиГруппы);
		Результат.Вставить(СтрАналитикаГруппы.КодВидаАналитики, ПараметрВыбора);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьПараметрыНачалаВыбораАналитикиСервер()

&НаСервереБезКонтекста
Функция ПолучитьИзмененныеАналитикиПриОбработкеВыбора(Знач ИмяТаблицы, Знач РеквизитФормы, Знач КодСтроки, Знач ПредыдущееЗначение, Знач ВыбранноеЗначение, Знач АдресНастроекОтчета)

	ХранимыеНастройки = ПолучитьИзВременногоХранилища(АдресНастроекОтчета);
	МакетОтображения = ХранимыеНастройки.МакетОтображения;
	
	ТекущийРаздел = НайтиРазделПоИмени(МакетОтображения, ИмяТаблицы);
	Если ТекущийРаздел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаРаздела = ТекущийРаздел.СтрокиРаздела.Найти(КодСтроки, "Код");
	Если СтрокаРаздела = Неопределено или СтрокаРаздела.ЕстьАналитика = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаРаздела.ОписаниеАналитики.Колонки.Код.Имя = "КодВидаАналитики";
	СтрАналитика = СтрокаРаздела.ОписаниеАналитики.Найти(Сред(РеквизитФормы,10), "КодВидаАналитики");
	Если СтрАналитика = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыеЗначенияАналитики = БюджетнаяОтчетностьСервер.ЗначенияОбработкиВыбораПоСценариюВвода(СтрокаРаздела.ОписаниеАналитики, СтрАналитика.ВидАналитики, ВыбранноеЗначение,Ложь);
	
	СтрокаРаздела.ОписаниеАналитики.Колонки.КодВидаАналитики.Имя = "Код";
	
	Если НовыеЗначенияАналитики = Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	НовыеЗначенияФорма = Новый Структура;
	Для Каждого КлючИЗначение Из НовыеЗначенияАналитики Цикл
		НовыеЗначенияФорма.Вставить("Аналитика"+КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат НовыеЗначенияФорма;
	
КонецФункции // ПолучитьИзмененныеАналитикиПриОбработкеВыбора()

&НаКлиенте
Функция ТекущиеДанныеПоЭлементуТаблицы(Знач Элемент)
	
	Реквизиты = Новый Структура;
	
	ТекРодитель = Элемент.Родитель;
	Пока ТипЗнч(ТекРодитель) <> Тип("ТаблицаФормы") Цикл
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	ИмяЭлемента = Элемент.Имя;
	//В имени элемента может встретиться "__" - это означает, что в данном элементе выводится реквизит аналитики/свойтсва
	ПозРеквизита = Найти(ИмяЭлемента,"__");
	Если ПозРеквизита>0 Тогда
		ИмяЭлемента = Лев(ИмяЭлемента,ПозРеквизита-1);
	КонецЕсли;
	
	Реквизиты.Вставить("ИмяТаблицыФормы", ТекРодитель.Имя);
	Реквизиты.Вставить("ИмяЭлемента"    , ИмяЭлемента);
	Реквизиты.Вставить("ТекущиеДанные"  , Элементы[Реквизиты.ИмяТаблицыФормы].ТекущиеДанные);
		
	Реквизиты.Вставить("РеквизитДанных" , Сред(Реквизиты.ИмяЭлемента,СтрДлина(Реквизиты.ИмяТаблицыФормы)+1));
	Реквизиты.Вставить("ЗначениеЭлемента", Реквизиты.ТекущиеДанные[Реквизиты.РеквизитДанных]);
	
	Возврат Реквизиты;
	
КонецФункции // ТекущиеДанныеПоЭлементуТаблицы()

&НаКлиенте
Функция ПолучитьПараметрыНачалаВыбораАналитики(Знач Элемент)

	Если СоответствиеВидовОбластей = Неопределено Тогда
		СоответствиеВидовОбластей = Новый Соответствие;
	КонецЕсли;
	
	СвойстваЭлемента = ТекущиеДанныеПоЭлементуТаблицы(Элемент);
	КлючПараметров   = СвойстваЭлемента.ИмяЭлемента+"/"+СвойстваЭлемента.ТекущиеДанные.КодСтроки;
	ПараметрыВыбораАналитики  = СоответствиеВидовОбластей[КлючПараметров];
	
//Заполняем отбор по настройкам бланка (в режиме простой таблицы они тоже считываются)
	ТекущийКодСтроки = СвойстваЭлемента.ТекущиеДанные.КодСтроки;
	СтрГруппРаскрытия  = ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки",ТекущийКодСтроки));
	
	ИмяЯчейкиОтбора = Неопределено;
	НаборПараметровВыбораЗаполнен = Ложь;
	
	Если СтрГруппРаскрытия.Количество()>0 Тогда
					
		КодГруппыРаскрытия = СтрГруппРаскрытия[0].КодГруппыРаскрытия;
		
		НаборПараметровВыбора = ПолучитьПараметрыНачалаВыбораАналитикиСервер(КодГруппыРаскрытия, Объект.ВидОтчета);
		НаборПараметровВыбораЗаполнен = Истина;
		
		ИмяПоляАналитики = СтрЗаменить(СвойстваЭлемента.РеквизитДанных,"Аналитика","");
		ТекущаяСтруктураАналитики = НаборПараметровВыбора[ИмяПоляАналитики];
		Если ТекущаяСтруктураАналитики <> Неопределено Тогда
			КодАналитики = ТекущаяСтруктураАналитики.ИмяОбъектаАналитики;
			ПолеДляПоиска = КодГруппыРаскрытия + "_" + ТекущийКодСтроки +"_"+ КодАналитики;
			
			Для Каждого СтрокаФильтра Из ТаблицаФильтровПоЗначению Цикл
				Если СтрНачинаетсяС(СтрокаФильтра.ИмяЯчейки, ПолеДляПоиска) Тогда
					ИмяЯчейкиОтбора = СтрокаФильтра.ИмяЯчейки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ПараметрыВыбораАналитики = Неопределено И НаборПараметровВыбораЗаполнен Тогда
		
		ШаблонКлюча = СвойстваЭлемента.ИмяТаблицыФормы;
		
		Для Каждого КлючИЗначение Из НаборПараметровВыбора Цикл
			
			КлючАналитики        = "Аналитика" + КлючИЗначение.Ключ;
			ПараметрВыбораСервер = КлючИЗначение.Значение;
			
			Если ПараметрВыбораСервер = Неопределено Тогда
				ПараметрВыбораСервер = 0;
			КонецЕсли;
			
			СоответствиеВидовОбластей.Вставить(ШаблонКлюча+КлючАналитики+"/"+СвойстваЭлемента.ТекущиеДанные.КодСтроки, ПараметрВыбораСервер);
			
			Если КлючАналитики = СвойстваЭлемента.РеквизитДанных Тогда
				ПараметрыВыбораАналитики = ПараметрВыбораСервер;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПараметрыВыбораАналитики = Неопределено Тогда
		СоответствиеВидовОбластей.Вставить(КлючПараметров, 0);
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТекущиеДанные"  , СвойстваЭлемента.ТекущиеДанные);
	Результат.Вставить("ИмяПоля"        , СвойстваЭлемента.РеквизитДанных);
	Результат.Вставить("ИмяТаблицы"     , СвойстваЭлемента.ИмяТаблицыФормы);
	Результат.Вставить("ИмяЯчейкиОтбора", ИмяЯчейкиОтбора);
	
	Если ПараметрыВыбораАналитики <> 0 
		И ПараметрыВыбораАналитики<>Неопределено Тогда
		Результат.Вставить("ПараметрыВыбора", ПараметрыВыбораАналитики);
		Результат.Вставить("СтандартнаяОбработка", ПараметрыВыбораАналитики.СтандартнаяОбработка);
	Иначе
		Результат.Вставить("СтандартнаяОбработка", Истина);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьПараметрыНачалаВыбораАналитики()

