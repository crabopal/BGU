// Процедуры печати

&НаСервере
Процедура ОбновитьКнопкиПечати()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ПечатьРегламентированныхОтчетов") Тогда 
		Возврат;
	КонецЕсли;	
	
	МодульПечатиСервер = ОбщегоНазначения.ОбщийМодуль("ПечатьРегламентированныхФорм");
	МодульПечатиСервер.ОбновитьКнопкиПечатиУФ(ЭтаФорма, Объект, ЭтаФорма.Элементы.ПодменюПечать);
	
КонецПроцедуры	

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ПечатьРегламентированныхОтчетов") Тогда 
		Возврат;
	КонецЕсли;	
	
	МодульПечатиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПечатьРегламентированныхФормКлиент");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
	ДополнительныеПараметры.Вставить("КомандаИмя", Команда.Имя);
	ДополнительныеПараметры.Вставить("КомандыПечати", КомандыПечати);
	ДополнительныеПараметры.Вставить("АдресОбъекта", АдресОбъектаОтчет);
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	ОбработкаРезультата = Новый ОписаниеОповещения("ПечатьОтчетаАсинхрон", МодульПечатиКлиент, ДополнительныеПараметры);
	
	МодульПечатиКлиент.ПроверитьДокументЗаписан(ОбработкаРезультата,ЭтаФорма);

	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ РАБОТЫ С ПРАВИЛАМИ ЗАПОЛНЕНИЯ
//

&НаКлиенте
Процедура РасшифроватьАвтозаполнение(Команда)
	
	Если БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().ПравилаЗаполнения = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Если НЕ ПересчитыватьПоказателиПриИзменении Тогда
		СинхронизироватьКонтекстНовыйВариант();
	КонецЕсли;
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		АдресТаблицыПоказателей = ПолучитьТаблицуВыделенныхПоказателейВФорме(ТекущийЭлемент.Имя,Истина);
	Иначе
		ВыделенныеОбласти = СписокВыделенныхОбластейПоказателей();
		АдресТаблицыПоказателей = ПолучитьТаблицуВыделенныхПоказателейВТабличномДокументе(ВыделенныеОбласти,,Истина);
	КонецЕсли;

	БюджетнаяОтчетностьКлиентПереопределяемый.РасшифроватьАвтозаполнение(ЭтаФорма,АдресТаблицыПоказателей);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьДействиеКоманды(Команда)
	
	Если БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().ПравилаЗаполнения = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Если АктивнаЗагрузкаКомплекта(ЭтотОбъект) Тогда
		ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
		Возврат;
	КонецЕсли;
	
	ЗаданиеВыполнено = Ложь;
	ОчиститьСообщения();
	ОчиститьУстановленныеОтборы();
	
	СинхронизироватьКонтекстНовыйВариант();
	
	ОбработатьРедактированиеФормы();
	БюджетнаяОтчетностьКлиентПереопределяемый.ВыполнитьДействиеКоманды(Команда,ЭтаФорма);
	
	
КонецПроцедуры	

&НаКлиенте
Процедура Подключаемый_ВвестиПараметрыИВыполнитьДействиеКоманды(Команда)
	Если БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().ПравилаЗаполнения = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаданиеВыполнено = Ложь;
	ОчиститьСообщения();
	ОчиститьУстановленныеОтборы();
	
	СинхронизироватьКонтекстНовыйВариант();//всегда синхронизируем контекст
	
	ОбработатьРедактированиеФормы();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ВвестиПараметрыИВыполнитьДействиеКоманды");
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПроизвольногоОповещения", ЭтаФорма, ДополнительныеПараметры);
	
	БюджетнаяОтчетностьКлиентПереопределяемый.ВвестиПараметрыИВыполнитьДействиеКоманды(Команда,ЭтаФорма,ОписаниеОповещения);
	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВывестиРазделСправки(Команда)
	Если БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().ПравилаЗаполнения = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	БюджетнаяОтчетностьКлиентПереопределяемый.ВывестиРазделСправки(Команда,ЭтаФорма);
	
	ВывестиДанныеОтчета();
	
КонецПроцедуры	

&НаКлиенте
Процедура ПересчитыватьПоказателиПриИзменении(Команда)
	ПересчитыватьПоказателиПриИзменении = НЕ ПересчитыватьПоказателиПриИзменении;
	Элементы.ФормаПересчитыватьПоказателиПриИзменении.Пометка = ПересчитыватьПоказателиПриИзменении;
КонецПроцедуры

