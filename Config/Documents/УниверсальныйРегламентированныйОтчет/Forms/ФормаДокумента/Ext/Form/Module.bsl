&НаКлиенте
Процедура СортироватьПоВозрастанию(Команда)
	Область = Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
	
	ИмяОбласти = Область.Имя;
	
	Если Найти(ИмяОбласти,"_")=0 Тогда
		Возврат;
	КонецЕсли;
	
	Направление = " Возр";
	
	ВыполнитьСортировкуПоНаправлению(ИмяОбласти, Направление);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСортировкуПоНаправлению(Знач ИмяОбласти, Знач Направление)
	
	Перем ВходящиеПараметры;
	
	ВходящиеПараметры = Новый Структура;
	ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
	ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
	СортироватьТаблицуПоТекущейЯчейкеБезКонтекста(Объект,АдресОбъектаОтчет,ТабличныйДокументОтчета,ИзмененныеОбласти,Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка,Направление,ИмяОбласти,ВходящиеПараметры);
	
	ОбновитьУстановленныеОтборы();
	
	Если НЕ ЭтаФорма.ТолькоПросмотр Тогда
		//установим модифицированность только если включено редактирование отчета
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СортироватьПоУбыванию(Команда)
	Область = Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
	
	ИмяОбласти = Область.Имя;
	
	Если Найти(ИмяОбласти,"_")=0 Тогда
		Возврат;
	КонецЕсли;
	
	Направление = " Убыв";
	
	ВыполнитьСортировкуПоНаправлению(ИмяОбласти, Направление);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СортироватьТаблицуПоТекущейЯчейкеБезКонтекста(Знач ТекОбъект,АдресОбъектаОтчет,ТабличныйДокументОтчета,ИзмененныеОбласти,ВыводитьРаскрытиеВТелеБланка,Напр,ИмяОбласти,ВходящиеПараметры)
				
	МассивКодов = СтрРазделить(ИмяОбласти,"_",Ложь);
	ОтчетОбъект = Неопределено;	
	Если МассивКодов.Количество()>1 Тогда
		
		КодСтроки=МассивКодов[1];
		
		ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
		
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
		
		Если СтрРаскрытия = Неопределено Тогда
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ТекИнд = НомерТекущейСтрокиТаблицыРаскрытий(ИмяОбласти);
	Если ТекИнд <> -1 Тогда
		ТекСтр = СтрРаскрытия.ТаблицаРаскрытия.Получить(ТекИнд);
	КонецЕсли;
	
	
	ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
	Окончание = "";
	НачальныйПрефикс = СокрЛП(СтрРаскрытия.ГруппаРаскрытия.Код) +"_"+КодСтроки+ "_Аналитика";
	Для НомерАналитики = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
		Префикс = НачальныйПрефикс + НомерАналитики;
		Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено 
			И Лев(ИмяОбласти, СтрДлина(Префикс)+1) = Префикс+"_" Тогда // это область реквизита одной из аналитик
			ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
			Окончание = Сред(ИмяОбласти, СтрДлина(Префикс) + 2);
			Вхождение_ = Найти(Окончание, "_");
			Если Вхождение_ = 0 Тогда
				Окончание = "";
			Иначе
				Окончание = Лев(Окончание, Вхождение_ - 1);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтоОбластьРеквизитаОднойИзАналитик Тогда
		
		СтрРаскрытия.ТаблицаРаскрытия.Колонки.Добавить("ЗначениеРеквизита");
		Для Каждого Стр Из СтрРаскрытия.ТаблицаРаскрытия Цикл
			Попытка
				Стр.ЗначениеРеквизита = ?(Окончание = "", Стр["Аналитика" + НомерАналитики], Стр["Аналитика" + НомерАналитики][Окончание]);
			Исключение
			КонецПопытки;
		КонецЦикла;
		СтрРаскрытия.ТаблицаРаскрытия.Сортировать("ЗначениеРеквизита" + Напр);
		СтрРаскрытия.ТаблицаРаскрытия.Колонки.Удалить(СтрРаскрытия.ТаблицаРаскрытия.Колонки.ЗначениеРеквизита);
		
		ПеренумероватьСтрокиРаскрытия(СтрРаскрытия);
		ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия, СтрРаскрытия.ТаблицаРаскрытия, Ложь);
		
		СтрРаскрытия.ТабДокРаскрытие=ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия
										,СтрРаскрытия.ТаблицаРаскрытия
										,СтрРаскрытия.ОтборПоРаскрытию
										,СтрРаскрытия.КодСтроки
										,СтрРаскрытия.МакетыРаскрытия);
										
		ПрименитьНастройкуВыводаДлинныхСтрок(СтрРаскрытия.ТабДокРаскрытие,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);								
		
		СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
		
		ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрРаскрытия);
		
		ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
		СтрРаскрытия.ТабДокРаскрытие.Очистить();
				
		ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	Иначе
		
		Префикс = СокрЛП(СтрРаскрытия.ГруппаРаскрытия.Код) +"_"+КодСтроки+ "_Показатель_";
		КолонкиПоказатели=ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("КодСтрока",КодСтроки));
		
		Для Каждого Пок Из КолонкиПоказатели Цикл
			ПрефиксПоказателя = Префикс + СокрЛП(Пок.Код);
			Если Лев(СокрЛП(ИмяОбласти), СтрДлина(ПрефиксПоказателя)+1) = ПрефиксПоказателя+"_" Тогда
				СтрРаскрытия.ТаблицаРаскрытия.Сортировать(СокрЛП(Пок.Код) + Напр);
				
				ПеренумероватьСтрокиРаскрытия(СтрРаскрытия);
				ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия, СтрРаскрытия.ТаблицаРаскрытия, Ложь);			
				
				СтрРаскрытия.ТабДокРаскрытие=ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия
												,СтрРаскрытия.ТаблицаРаскрытия
												,СтрРаскрытия.ОтборПоРаскрытию
												,СтрРаскрытия.КодСтроки,СтрРаскрытия.МакетыРаскрытия);
												
				ПрименитьНастройкуВыводаДлинныхСтрок(СтрРаскрытия.ТабДокРаскрытие,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);
				
				СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
				
				ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрРаскрытия);
				
				ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
				СтрРаскрытия.ТабДокРаскрытие.Очистить();

				ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
				
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПеренумероватьСтрокиРаскрытия(СтрРаскрытия)
	
	Индекс = 0;
	ТабРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	Для Каждого СтрокаТаблицы Из ТабРаскрытия Цикл
		
		СтрокаТаблицы.ID 	 = Индекс;
		СтрокаТаблицы.Индекс = Индекс + 1;
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерТекущейСтрокиТаблицыРаскрытий(ИмяОбласти)
	
	МассивПодСтрок = СтрРазделить(ИмяОбласти, "_",Ложь);
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(МассивПодСтрок[МассивПодСтрок.ВГраница()]) Тогда
		Возврат Число(МассивПодСтрок[МассивПодСтрок.ВГраница()]);
	Иначе
		Возврат -1;
	КонецЕсли;
		
КонецФункции // НомерТекущейСтрокиТаблицыРаскрытий()

//
&НаКлиенте
Процедура ВключитьРедактирование(Команда)
	УстановитьРежимРедактированияФормыСервер(Не Элементы.ФормаВключитьРедактирование.Пометка,Истина);
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","Очистить");	
	
	
	ТекстВопроса = НСтр("ru = 'Будут очищены все показатели отчета. Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
