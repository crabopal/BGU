&НаКлиенте
Процедура НастройкаСпискаРаскрытияТаблицаФормы(ОчищатьНастройки = Ложь)

	Если Не ВозможнаНастройкаПорядкаРаскрытия() Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	
	Если ОчищатьНастройки = Истина Тогда
		ПрименитьНастройкуСписка(ТекущиеДанные.КодСтроки, Неопределено, ТекущийЭлемент.Имя);
		ОбновитьУстановленныеОтборыРаздела(Неопределено);
	Иначе		
		ПараметрыФормы   = Новый Структура;
		ТекущиеНастройки = Новый Структура("КодСтроки,АдресОтчета",ТекущиеДанные.КодСтроки,АдресОбъектаОтчет);
		ПараметрыФормы.Вставить("ТекущиеНастройки",ТекущиеНастройки);
		ПараметрыФормы.Вставить("ВидОтчета"       ,Объект.ВидОтчета);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяФормы","Документ.УниверсальныйРегламентированныйОтчет.Форма.НастройкаСписка"); 
		ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
		ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
		ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
		
		СтруктураДляОбработкиРезультата = Новый Структура;
			
		СтруктураДляОбработкиРезультата.Вставить("Источник","НастройкаСпискаРаскрытияТаблицаФормы");
		СтруктураДляОбработкиРезультата.Вставить("ТекущиеДанные",ТекущиеДанные);
		СтруктураДляОбработкиРезультата.Вставить("ТекущийЭлемент",ТекущийЭлемент);
		
		ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураДляОбработкиРезультата));
		
		БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьСтокуРаскрытияТаблицаФормы(Смещение)
	
	Если Не ВозможнаНастройкаПорядкаРаскрытия() Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидЗаписи = "Итог" Тогда 
		ПоказатьПредупреждение(,НСтр("ru = 'Нельзя переместить строку итога.'"));
		Возврат;
	КонецЕсли;	
	
	ТекущаяТаблица = ЭтотОбъект[ТекущийЭлемент.Имя];
	ТекущийИндексСтроки = ТекущаяТаблица.Индекс(ТекущиеДанные);
		
	КоличествоЗаписей = ЭтотОбъект[ТекущийЭлемент.Имя].Количество();
	
	Мин = Неопределено;
	Макс = -1;
	Для Инд = 0 По КоличествоЗаписей-1 Цикл
		Если ТекущаяТаблица[Инд].КодСтроки = ТекущиеДанные.КодСтроки
			И ТекущаяТаблица[Инд].ВидЗаписи = ТекущиеДанные.ВидЗаписи Тогда
			Если Мин = Неопределено Тогда
				Мин = Инд;
			КонецЕсли;
			Макс = Инд;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекущийИндексСтроки = Мин И Смещение<0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТекущийИндексСтроки = Макс И Смещение > 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущаяТаблица.Сдвинуть(ТекущийИндексСтроки,Смещение);
	
	Счетчик = 0;
	Для Инд = 0 По КоличествоЗаписей-1 Цикл
		Если ТекущаяТаблица[Инд].КодСтроки = ТекущиеДанные.КодСтроки
			И ТекущаяТаблица[Инд].ВидЗаписи = ТекущиеДанные.ВидЗаписи Тогда
			
			Счетчик = Счетчик + 1;
		
			Если ТекущаяТаблица[Инд].Индекс = -1 Тогда 
				Продолжить; //индекс будет присвоен при создании строки в таблице
			КонецЕсли;	
		
			ТекущаяТаблица[Инд].Индекс = Счетчик;
		КонецЕсли;
	КонецЦикла;	
	
	ЗарегистрироватьИзмененияДляВсехПолейТаблицы(ТекущийЭлемент.Имя, ТекущиеДанные.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ВозможнаНастройкаПорядкаРаскрытия()
		
	Если ТипЗнч(ТекущийЭлемент) <> Тип("ТаблицаФормы")
		или Лев(ТекущийЭлемент.Имя,6) <> "Раздел"
		или ТекущийЭлемент.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Выберите строку раскрытия, в которой необходимо настроить список'"));
		Возврат Ложь;
	КонецЕсли;
	
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	Если Не (ТекущиеДанные.ВидЗаписи = "Итог" или ТекущиеДанные.ВидЗаписи = "Раскрытие") Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Настройка отбора и сортировки возможна только для строк, раскрывающихся по аналитике'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

//События таблицы редактирования

&НаКлиенте
Процедура Подключаемый_ТаблицаРедактированияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Поле.Родитель) = Тип("ГруппаФормы") Тогда
		ТекГруппа = Поле.Родитель;
		Если ТекГруппа.Группировка = ГруппировкаКолонок.ВЯчейке Тогда
			
			ПараметрыНачалаВыбора = ПолучитьПараметрыНачалаВыбораАналитики(Поле);
			ТекДанные = ПараметрыНачалаВыбора.ТекущиеДанные;
			Если ТекДанные.ВидЗаписи = "Раскрытие"
				ИЛИ ТекДанные.ВидЗаписи = "" Тогда
				СтандартнаяОбработка = Ложь;
				
				НастройкаРеквизитов = Новый Массив;
				
				МассивОбработанныхИмен = Новый Массив;
				Для Каждого ТекЭлемент Из ТекГруппа.ПодчиненныеЭлементы Цикл
					ИмяЭлемента = СтрЗаменить(ТекЭлемент.Имя,ПараметрыНачалаВыбора.ИмяТаблицы,"");
					ПозРеквизита = Найти(ИмяЭлемента,"__");
					Если ПозРеквизита>0 Тогда
						ИмяЭлемента = Лев(ИмяЭлемента,ПозРеквизита-1);
					КонецЕсли;
					
					Если МассивОбработанныхИмен.Найти(ИмяЭлемента) <> Неопределено Тогда//может быть несколько элементов - реквизитов одного объекта
						Продолжить;
					КонецЕсли;
					СтрукутураНастройки = Новый Структура("Имя,Заголовок,Значение",ИмяЭлемента,ТекЭлемент.Заголовок,ТекДанные[ИмяЭлемента]);
					НастройкаРеквизитов.Добавить(СтрукутураНастройки);
					
					МассивОбработанныхИмен.Добавить(ИмяЭлемента);	
				КонецЦикла;
				
				Если НастройкаРеквизитов.Количество() = 0 Тогда
					//реквизитов нет, ничего не делаем
					Возврат;
				КонецЕсли;
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("АдресДокументаОбъект"	, АдресОбъектаОтчет);
				ПараметрыФормы.Вставить("ИмяОбласти"			, "");
				ПараметрыФормы.Вставить("ИдентификаторОбласти"	, ТекДанные.Индекс);
				ПараметрыФормы.Вставить("ВидОтчета"				, Объект.ВидОтчета);
				ПараметрыФормы.Вставить("НастройкаРеквизитов"	, НастройкаРеквизитов);
				ПараметрыФормы.Вставить("УровеньТочности"	, Объект.УровеньТочности);
				ПараметрыФормы.Вставить("Ссылка"	, 	Объект.Ссылка);
				ПараметрыФормы.Вставить("Организация"	, Объект.Организация);
				ПараметрыФормы.Вставить("ДатаДокумента"	, Объект.Дата);
				ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
				
				ТекГруппаРаскрытия = Неопределено;
				СтрГруппРаскрытия  = ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки",ТекДанные.КодСтроки));
				Если СтрГруппРаскрытия.Количество() >0 Тогда
					ТекГруппаРаскрытия = СтрГруппРаскрытия[0].ГруппаРаскрытия;
				КонецЕсли;
								
				Если ТекГруппаРаскрытия <> Неопределено Тогда
					ПараметрыФормы.Вставить("ГруппаРаскрытия",ТекГруппаРаскрытия);
				КонецЕсли;
								
				СтруктураРеквизитов = Новый Структура("ИмяТаблицы,ИдСтроки",ПараметрыНачалаВыбора.ИмяТаблицы,ТекДанные.ПолучитьИдентификатор());
				ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ПослеВыбораСоставныхРеквизитовТаблица",ЭтотОбъект,СтруктураРеквизитов);
				
				ТекКлючСохраненияРазмераОкна = Строка(Объект.ВидОтчета.УникальныйИдентификатор())+"/" +ТекГруппа.Имя;
				
				ПараметрыФормы.Вставить("КлючСохраненияПоложенияОкна",ТекКлючСохраненияРазмераОкна);
				
				ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСоставныхРеквизитов",ПараметрыФормы,Элемент,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
				
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Найти(Поле.Имя,"Аналитика") > 0 Тогда
	    //это реквизит аналитики, обрабатываем как выбор аналитики.
	
		ПараметрыНачалаВыбора = ПолучитьПараметрыНачалаВыбораАналитики(Поле);
		
		Если  ПараметрыНачалаВыбора.Свойство("ПараметрыВыбора") Тогда
			Если ПараметрыНачалаВыбора.ТекущиеДанные.Индекс = 0 Тогда
				Возврат;
			КонецЕсли;
			//СтандартнаяОбработка = Ложь;
			ТекущееЗначениеПоля = ПараметрыНачалаВыбора.ТекущиеДанные[ПараметрыНачалаВыбора.ИмяПоля];
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущееЗначениеПоля);
			ПараметрыФормы.Вставить("РежимВыбора", Истина);
			ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
			ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
			
			ОтборПоПараметрам = Новый Структура;
			
			ВидАналитики = ПараметрыНачалаВыбора.ПараметрыВыбора.ВидАналитики;
			Если ТипЗнч(ТекущееЗначениеПоля) = Тип("СправочникСсылка.Субконто") 
				И ВидАналитики <> Неопределено Тогда
				ОтборПоПараметрам.Вставить("Владелец",ВидАналитики);
				ПараметрыФормы.Вставить("Отбор", ОтборПоПараметрам);
			КонецЕсли;
			
			Если ТипЗнч(ТекущееЗначениеПоля) = Тип("СправочникСсылка.КОСГУ") Тогда
				ПараметрыФормы.Вставить("Отбор", ОтборПоПараметрам);
				ПараметрыФормы.Вставить("ОтборПоПараметруБланка",Истина);
			КонецЕсли;
			
			Если ПараметрыНачалаВыбора.ИмяЯчейкиОтбора <> Неопределено Тогда
				ЗаполнитьПараметрыОтбораПоФильтру(ОтборПоПараметрам,  ПараметрыНачалаВыбора.ИмяЯчейкиОтбора);	
				Если ОтборПоПараметрам.Свойство("Код") Тогда
					Если ТипЗнч(ТекущееЗначениеПоля) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
						ПараметрыФормы.Вставить("ОтборПоПараметруБланка", ОтборПоПараметрам.Код);
					Иначе
						ПараметрыФормы.Вставить("Отбор", ОтборПоПараметрам);
						ПараметрыФормы.Вставить("ОтборПоПараметруБланка",Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",Истина);
			
			ДопПараметры = Новый Структура("Поле",Поле);
			ТекОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораАналитикиВФормеВыбора",ЭтотОбъект,ДопПараметры);
			
			ОткрытьФорму(ПараметрыНачалаВыбора.ПараметрыВыбора.ФормаВыбора, ПараметрыФормы, Поле,,,,ТекОписаниеОповещения);
		КонецЕсли;
		
	ИначеЕсли Найти(Поле.Имя,"_КартинкаГР") > 0 Тогда
		//это ячейка с картинкой + строки группы раскрытия, добавляем строку.
		
		ТекущаяТаблица = ЭтотОбъект[Элемент.Имя];
		ТекущиеДанные = Элемент.ТекущиеДанные;
		
		Если ТекущиеДанные.ВидЗаписи = "Итог" Тогда
			ИсходнаяСтрока = ТекущиеДанные;
		Иначе
			Возврат;
		КонецЕсли;
			
		НовСтр = ТекущаяТаблица.Добавить();
		ТекСписокСвойств = "";
		Если ТипЗнч(СписокСвойствРаздела) = Тип("ФиксированнаяСтруктура") Тогда
			ТекСписокСвойств = СписокСвойствРаздела[Элемент.Имя];
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(НовСтр,ИсходнаяСтрока,"КодСтроки"+?(ЗначениеЗаполнено(ТекСписокСвойств),","+ТекСписокСвойств,""));
		НовСтр.ВидЗаписи = "Раскрытие";
		
		//Переставим новую строку в конец раздела
		ТекущийИндексСтроки = ТекущаяТаблица.Индекс(НовСтр);

		КоличествоЗаписей = ТекущаяТаблица.Количество();
		Макс = -1;
		ИндексРодительскойСтроки = -1;
		Для Инд = 0 По КоличествоЗаписей-1 Цикл
			Если Инд = ТекущийИндексСтроки Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяТаблица[Инд].КодСтроки = НовСтр.КодСтроки Тогда
				Если ТекущаяТаблица[Инд].ВидЗаписи = НовСтр.ВидЗаписи Тогда
					Макс = Инд;
				Иначе
					ИндексРодительскойСтроки = Инд;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		НовСтр.Индекс    = -1;
		Если Макс = -1 Тогда
			//Еще нет строк раскрытия в данной группе
			Макс = ИндексРодительскойСтроки;			
		КонецЕсли;
		
		Смещение = Макс - ТекущийИндексСтроки+1;
		ТекущаяТаблица.Сдвинуть(ТекущийИндексСтроки,Смещение);
		
	Иначе
		
		ПараметрыНачалаВыбора = ПолучитьПараметрыНачалаВыбораАналитики(Поле);
		Если ПараметрыНачалаВыбора.Свойство("ПараметрыВыбора") Тогда
			Если ПараметрыНачалаВыбора.ПараметрыВыбора.Свойство("ЭтоКБКСтрокой") Тогда
				Если ПараметрыНачалаВыбора.ПараметрыВыбора.ЭтоКБКСтрокой Тогда
					СтандартнаяОбработка = Ложь;
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
					
					ДопПараметры = Новый Структура("Поле",Поле);
					ТекОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораАналитикиВФормеВыбора",ЭтотОбъект,ДопПараметры);
					
					ОткрытьФорму(ПараметрыНачалаВыбора.ПараметрыВыбора.ФормаВыбора, ПараметрыФормы, Поле,,,,ТекОписаниеОповещения);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ПараметрыНачалаВыбора.ТекущиеДанные[ПараметрыНачалаВыбора.ИмяПоля]) = Тип("Булево") Тогда
			//изменение значения типа булево двойным кликом, без захода в поле
			ПараметрыНачалаВыбора.ТекущиеДанные[ПараметрыНачалаВыбора.ИмяПоля] = НЕ ПараметрыНачалаВыбора.ТекущиеДанные[ПараметрыНачалаВыбора.ИмяПоля];
			ЭтотОбъект.Модифицированность = Истина;
			
			Подключаемый_ПолеТаблицыРедактированияПриИзменении(Поле);
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПослеВыбораСоставныхРеквизитовТаблица(Результат,ДопПараметры) Экспорт
	Если Результат<> Неопределено Тогда
		ОтразитьВыборСвязанныхРеквизитовОбъединеннойГруппы(Результат, ДопПараметры.ИмяТаблицы, ДопПараметры.ИдСтроки);
		Модифицированность = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОтразитьВыборСвязанныхРеквизитовОбъединеннойГруппы(РезультатВыбора, ИмяТаблицы, ИдентификаторСтроки)

	ТаблицаДанных = ПолучитьИзВременногоХранилища(РезультатВыбора);
	
	СтрокаДанных = ЭтотОбъект[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);
	Для Каждого СтрРеквизит Из ТаблицаДанных Цикл
		
		ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(СтрРеквизит.ВидКлассификатораБК);
		ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(СтрРеквизит.Значение,ЭтоСтроковыйКлассификатор);

		СтрокаДанных[СтрРеквизит.ИмяРеквизита] = ВыбранноеЗначение;
		
		ЗарегистрироватьИзменениеТаблицыКлиентСервер(ИзмененныеОбласти, ИмяТаблицы+СтрРеквизит.ИмяРеквизита, ИдентификаторСтроки);

	КонецЦикла;
	
	ОбновитьУстановленныеОтборыРазделаНаСервере(ИмяТаблицы);
	
КонецПроцедуры // ОтразитьВыборСвязанныхРеквизитовОбъединеннойГруппы()

&НаКлиенте
Процедура Подключаемый_ТаблицаРедактированияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)

	ТекущиеДанные      = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ВидЗаписи = ""
		ИЛИ (ТекущиеДанные.ВидЗаписи = "Итог" 
			И Копирование) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	мИдентификаторТекущейСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	
КонецПроцедуры // Подключаемый_ТаблицаРедактированияПередНачаломДобавления()

&НаКлиенте
Процедура Подключаемый_ТаблицаРедактированияПередУдалением(Элемент, Отказ)

	Если Элемент.ТекущиеДанные.ВидЗаписи <> "Раскрытие" Тогда
		Отказ = Истина;
	Иначе
		ЗарегистрироватьИзменениеТаблицы(Элемент.Имя, Элемент.ТекущиеДанные.КодСтроки);
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_ТаблицаРедактированияПередУдалением()

&НаКлиенте
Процедура Подключаемый_ТаблицаРедактированияПослеУдаления(Элемент)

	Если ПересчитыватьПоказателиПриИзменении Тогда
		СинхронизироватьКонтекстНовыйВариант();
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_ТаблицаРедактированияПослеУдаления()

&НаКлиенте
Процедура Подключаемый_ТаблицаРедактированияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		
		ТекущаяТаблица = ЭтотОбъект[Элемент.Имя];
		ТекущиеДанные = Элемент.ТекущиеДанные;//уже новая строка
		
		Если НЕ Копирование Тогда
			//найдем строку, на которой было инициализировано добавление новой строки
			ИсходнаяСтрока = ТекущаяТаблица.НайтиПоИдентификатору(мИдентификаторТекущейСтроки);
			ТекСписокСвойств = "";
			Если ТипЗнч(СписокСвойствРаздела) = Тип("ФиксированнаяСтруктура") Тогда
				ТекСписокСвойств = СписокСвойствРаздела[Элемент.Имя];
			КонецЕсли;
			//заполним в новой строке КодСтроки, свойства строки и ВидЗаписи
		    ЗаполнитьЗначенияСвойств(ТекущиеДанные,ИсходнаяСтрока,"КодСтроки"+?(ЗначениеЗаполнено(ТекСписокСвойств),","+ТекСписокСвойств,""));
			ТекущиеДанные.ВидЗаписи = "Раскрытие";
		КонецЕсли;
		
		//Переставим новую строку в конец раздела
		ТекущийИндексСтроки = ТекущаяТаблица.Индекс(ТекущиеДанные);

		КоличествоЗаписей = ТекущаяТаблица.Количество();
		Макс = -1;
		ИндексРодительскойСтроки = -1;
		Для Инд = 0 По КоличествоЗаписей-1 Цикл
			Если Инд = ТекущийИндексСтроки Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяТаблица[Инд].КодСтроки = ТекущиеДанные.КодСтроки Тогда
				Если ТекущаяТаблица[Инд].ВидЗаписи = ТекущиеДанные.ВидЗаписи Тогда
					Макс = Инд;
				Иначе
					ИндексРодительскойСтроки = Инд;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ТекущиеДанные.Индекс    = -1;
		Если Макс = -1 Тогда
			//Еще нет строк раскрытия в данной группе
			Макс = ИндексРодительскойСтроки;			
		КонецЕсли;
		
		Смещение = Макс - ТекущийИндексСтроки+1;
		ТекущаяТаблица.Сдвинуть(ТекущийИндексСтроки,Смещение);
			
		Если Копирование Тогда		
			ЗарегистрироватьИзмененияДляВсехПолейТаблицы(Элемент.Имя, Элемент.ТекущаяСтрока);
			Если ПересчитыватьПоказателиПриИзменении Тогда
				ТекСтрока = ТекущиеДанные.ПолучитьИдентификатор();
				ПриИзмененииТаблицыРедактирования(Элемент.Имя,ТекСтрока);
				Элемент.ТекущаяСтрока = ТекСтрока;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_ТаблицаРедактированияПриНачалеРедактирования()

&НаКлиенте
Процедура Подключаемый_ПолеТаблицыРедактированияНачалоВыбораАналитики(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыНачалаВыбора = ПолучитьПараметрыНачалаВыбораАналитики(Элемент);
	
	Если ПараметрыНачалаВыбора.СтандартнаяОбработка = Ложь Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущаяСтрока", ПараметрыНачалаВыбора.ТекущиеДанные[ПараметрыНачалаВыбора.ИмяПоля]);
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
		ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
		ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",Истина);
		
		ОткрытьФорму(ПараметрыНачалаВыбора.ПараметрыВыбора.ФормаВыбора, ПараметрыФормы, Элемент);
	Иначе
		Если ПараметрыНачалаВыбора.ИмяЯчейкиОтбора <> Неопределено Тогда
			
			СтандартнаяОбработка = Ложь;

			ПараметрыОтбораСубконто = Новый Структура;
			ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто,  ПараметрыНачалаВыбора.ИмяЯчейкиОтбора);	
			ПараметрыФормы = Новый Структура;
			
			Если ПараметрыОтбораСубконто.Количество() Тогда
				ПараметрыФормы.Вставить("Отбор",ПараметрыОтбораСубконто);
				ПараметрыФормы.Вставить("ОтборПоПараметруБланка",Истина);
			КонецЕсли;
			
			ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",Истина);
			
			ОткрытьФорму(ПараметрыНачалаВыбора.ПараметрыВыбора.ФормаВыбора, ПараметрыФормы, Элемент);
		ИначеЕсли ПараметрыНачалаВыбора.Свойство("ПараметрыВыбора") Тогда
			Если ПараметрыНачалаВыбора.ПараметрыВыбора.Свойство("ЭтоКБКСтрокой") Тогда
				Если ПараметрыНачалаВыбора.ПараметрыВыбора.ЭтоКБКСтрокой Тогда
					СтандартнаяОбработка = Ложь;
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
					
					ДопПараметры = Новый Структура("Поле",Элемент);
					ТекОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораАналитикиВФормеВыбора",ЭтотОбъект,ДопПараметры);
					
					ОткрытьФорму(ПараметрыНачалаВыбора.ПараметрыВыбора.ФормаВыбора, ПараметрыФормы, Элемент,,,,ТекОписаниеОповещения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_ПолеТаблицыРедактированияНачалоВыбораАналитики()

&НаКлиенте
Процедура Подключаемый_ПолеТаблицыРедактированияОбработкаВыбораАналитики(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекДанныеЭлемента = ТекущиеДанныеПоЭлементуТаблицы(Элемент);
	ПараметрыВыбораАналитики   = ПолучитьПараметрыНачалаВыбораАналитики(Элемент);
	
	Если Не ПараметрыВыбораАналитики.СтандартнаяОбработка Тогда
		
		НовыеЗначенияАналитикСтроки = ПолучитьИзмененныеАналитикиПриОбработкеВыбора(ТекДанныеЭлемента.ИмяТаблицыФормы, 
												ТекДанныеЭлемента.РеквизитДанных,
												ТекДанныеЭлемента.ТекущиеДанные.КодСтроки,
												ТекДанныеЭлемента.ЗначениеЭлемента,
												ВыбранноеЗначение,
												АдресНастроекОтчета);
												
		Если НовыеЗначенияАналитикСтроки <> Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			Для Каждого КлючИЗначение Из НовыеЗначенияАналитикСтроки Цикл
				ТекДанныеЭлемента.ТекущиеДанные[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				ЗарегистрироватьИзменениеТаблицы(ТекДанныеЭлемента.ИмяТаблицыФормы+КлючИЗначение.Ключ, Элементы[ТекДанныеЭлемента.ИмяТаблицыФормы].ТекущаяСтрока);
			КонецЦикла;
		КонецЕсли;
	Иначе
		ТекДанныеЭлемента.ТекущиеДанные[ПараметрыВыбораАналитики.ИмяПоля] = ВыбранноеЗначение;
		ЗарегистрироватьИзменениеТаблицы(ТекДанныеЭлемента.ИмяТаблицыФормы+ПараметрыВыбораАналитики.ИмяПоля, Элементы[ТекДанныеЭлемента.ИмяТаблицыФормы].ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры // Подключаемый_ПолеТаблицыРедактированияНачалоВыбораАналитики()

&НаКлиенте
Процедура Подключаемый_ПолеТаблицыРедактированияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОписаниеДанных    = ТекущиеДанныеПоЭлементуТаблицы(Элемент);
	ВыбранноеЗначение = ОписаниеДанных.ЗначениеЭлемента;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеДанных",ОписаниеДанных);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолеТаблицыРедактированияНачалоВыбораЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура("ТекущееЗначение,ТекущееИмя",ВыбранноеЗначение,Элемент.Имя);
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,Элемент,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеТаблицыРедактированияНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ОписаниеДанных = ДополнительныеПараметры.ОписаниеДанных;
	
	ОписаниеДанных.ТекущиеДанные[ОписаниеДанных.РеквизитДанных] = Результат.ТекущееЗначение;
	ЗарегистрироватьИзменениеТаблицы(ОписаниеДанных.ИмяЭлемента, ОписаниеДанных.ТекущиеДанные.ПолучитьИдентификатор());
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолеТаблицыРедактированияПриИзменении(Элемент)

	ТекРодитель = Элемент.Родитель;
	Пока ТипЗнч(ТекРодитель) <> Тип("ТаблицаФормы") Цикл
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	ТекСтрока = ТекРодитель.ТекущаяСтрока;
	ЗарегистрироватьИзменениеТаблицы(Элемент.Имя, ТекРодитель.ТекущаяСтрока);
	
	Если ПересчитыватьПоказателиПриИзменении Тогда
		ПриИзмененииТаблицыРедактирования(ТекРодитель.Имя,ТекСтрока);
		ТекРодитель.ТекущаяСтрока = ТекСтрока;
	КонецЕсли;
		
КонецПроцедуры // Подключаемый_ПолеТаблицыРедактированияПриИзменении()

&НаСервере
Процедура ПриИзмененииТаблицыРедактирования(ИмяТаблицы,ИдСтроки)
	ДанныеТекущейСтроки = ЭтотОбъект[ИмяТаблицы].НайтиПоИдентификатору(ИдСтроки);
	
	СтруктураДанныхСтроки = Новый Структура("КодСтроки,ВидЗаписи,Индекс");
	ЗаполнитьЗначенияСвойств(СтруктураДанныхСтроки,ДанныеТекущейСтроки);
	
	СинхронизироватьКонтекстСервер();
	
	ПоМаксимальномуИндексу = Ложь;
	Если СтруктураДанныхСтроки.Индекс = -1 Тогда
		СтруктураДанныхСтроки.Удалить("Индекс");
		ПоМаксимальномуИндексу = Истина;
	КонецЕсли;
	МассивНайденныхСтрок = ЭтотОбъект[ИмяТаблицы].НайтиСтроки(СтруктураДанныхСтроки);
	Если МассивНайденныхСтрок.Количество()>0 Тогда
		Если ПоМаксимальномуИндексу = Ложь Тогда
			ИдСтроки = МассивНайденныхСтрок[0].ПолучитьИдентификатор();
		Иначе
			ПроверяемыйИндекс = -10;
			Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
				Если НайденнаяСтрока.Индекс>ПроверяемыйИндекс Тогда
					ПроверяемыйИндекс = НайденнаяСтрока.Индекс;
					ИдСтроки = НайденнаяСтрока.ПолучитьИдентификатор();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьУстановленныеОтборыРазделаНаСервере(ИмяТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИзменениеТаблицы(Знач Поле, Знач Значение)
 
	ЗарегистрироватьИзменениеТаблицыКлиентСервер(ИзмененныеОбласти, Поле, Значение);
	ОбработатьРедактированиеФормы();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗарегистрироватьИзменениеТаблицыКлиентСервер(Знач ИзмененныеОбласти, Знач Поле, Знач КлючСтроки)

	ТекущееЗначение = Неопределено;
	Если Не ИзмененныеОбласти.Свойство(Поле,ТекущееЗначение) Тогда
		ТекущееЗначение = Новый Соответствие;
		ИзмененныеОбласти.Вставить(Поле, ТекущееЗначение);
	КонецЕсли;
	
	ТекущееЗначение.Вставить(КлючСтроки, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОтображениеДлинныхПолей

&НаКлиенте
Процедура ВыводитьДлинныеПоляВОднуСтроку(Команда)
	
	ВыводитьДлинныеПоляВОднуСтроку = НЕ ВыводитьДлинныеПоляВОднуСтроку;
	Элементы.ФормаВыводитьДлинныеПоляВОднуСтроку.Пометка = ВыводитьДлинныеПоляВОднуСтроку;
	
	ПрименитьНастройкуВыводаДлинныхСтрок(ТабличныйДокументОтчета,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьНастройкуВыводаДлинныхСтрок(ТабДок,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку)
	
	Если ИменаЯчеекДлинныхСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроекОтображения = Новый Структура;
	
	МинимальнаяДлинаАнализируемойОбласти = 1000;
	Для Каждого ИмяЯчейкиДлСтр Из ИменаЯчеекДлинныхСтрок Цикл 
		
		ДлинаИмени = СтрДлина(ИмяЯчейкиДлСтр);	
		
		СтруктураНастроекОтображения.Вставить(ИмяЯчейкиДлСтр,ДлинаИмени);
		
		МинимальнаяДлинаАнализируемойОбласти = Мин(МинимальнаяДлинаАнализируемойОбласти,ДлинаИмени);
	КонецЦикла;
	
	КоллекцияОбластей = ТабДок.Области;
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		
		ДлинаИмениОбласти = СтрДлина(ТекОбл.Имя);
		
		Если ДлинаИмениОбласти < МинимальнаяДлинаАнализируемойОбласти Тогда
			//длина имени области меньше чем длина самого короткого имени из перечня нужных областей,
			//нет смысла проверять подробнее
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяЯчейкиДлСтр Из ИменаЯчеекДлинныхСтрок Цикл
			ДлинаИмени = СтруктураНастроекОтображения[ИмяЯчейкиДлСтр];
			
			Если Найти(ТекОбл.Имя,ИмяЯчейкиДлСтр) <> 1 Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ДлинаИмениОбласти > ДлинаИмени 
				И Найти("0123456789",Сред(ТекОбл.Имя,ДлинаИмени+2,1)) = 0 Тогда
				Продолжить;
			КонецЕсли;
				 			
			Если ВыводитьДлинныеПоляВОднуСтроку Тогда				
				ТекОбл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
			Иначе
				ТекОбл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			КонецЕсли;
			СтрокаОбласти = ТабДок.Область(ТекОбл.Верх,,ТекОбл.Низ);
			Если СтрокаОбласти.АвтоВысотаСтроки = Ложь Тогда
				СтрокаОбласти.АвтоВысотаСтроки = Истина;
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОбменаСоСводомВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ИсторияОбменаСоСводом.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ПакетВыгрузки) Тогда
		ОткрытьФорму("РегистрСведений.ИсторияСостоянийПакетаОтчетов.Форма.ФормаРезультатаОбмена",Новый Структура("ПакетВыгрузки",ТекДанные.ПакетВыгрузки),ЭтотОбъект,ТекДанные.ПакетВыгрузки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
