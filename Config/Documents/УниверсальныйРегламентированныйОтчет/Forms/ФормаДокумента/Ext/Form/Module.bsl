&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

// Обработчики событий табличного документа

&НаКлиенте
Процедура ПослеВыбораСпособаЗаполненияСвойства(Результат,ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат.Значение = 1 Тогда
		
		Если ДополнительныеПараметры.ВидОбласти = 2 Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
			ПараметрыФормы.Вставить("ЗначенияПараметровПоДатам", ДополнительныеПараметры.ЗначенияПараметровПоДатам);
			ПараметрыФормы.Вставить("ТекущееЗначение", ДополнительныеПараметры.ТекущееЗначение);
			Если ДополнительныеПараметры.Свойство("ДоступныеЗначения") Тогда
				ПараметрыФормы.Вставить("ДоступныеЗначения", ДополнительныеПараметры.ДоступныеЗначения);
			КонецЕсли;
			
			ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСохраненныхПараметров", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе	

			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
			ПоказатьВводЗначения(ОписаниеОповещения,ДополнительныеПараметры.ТекущееЗначение,Нстр("ru='Введите значение реквизита'"));
			
		КонецЕсли;
		
	ИначеЕсли Результат.Значение = 2 Тогда
					
		ОбновитьВычисляемыеПараметрыОтчетаКлиент(ДополнительныеПараметры.Область.Имя);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСоставныхРеквизитовБланка(РезультатВыбора, РеквизитыИмениОбласти) Экспорт
	Если РезультатВыбора <> Неопределено Тогда
		ИзмененныеРеквизитыОтчета = Новый Структура;
		ИзмененныеДопРеквизиты = Новый Структура;
		
		ОтразитьВыборСвязанныхРеквизитов(РезультатВыбора, РеквизитыИмениОбласти,ИзмененныеОбласти,ИзмененныеДопРеквизиты,ИзмененныеРеквизитыОтчета);
		
		Для Каждого КлючИЗначение Из ИзмененныеРеквизитыОтчета Цикл
			Объект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЦикла;
		
		Если ИзмененныеДопРеквизиты.Количество() Тогда
			Для Каждого СтрДопРеквизита Из ТаблицаДополнительныхРеквизитов Цикл
				Если ИзмененныеДопРеквизиты.Свойство(СтрДопРеквизита.Код) Тогда
					СтрДопРеквизита.Значение = ИзмененныеДопРеквизиты[СтрДопРеквизита.Код];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		СинхронизироватьКонтекстНовыйВариант();
		Модифицированность = Истина;
	КонецЕсли;		
КонецПроцедуры

// Выполняет отражение данных, выбранных в форме связанных реквизитов.
//

&НаСервереБезКонтекста
Процедура ОтразитьВыборСвязанныхРеквизитов(РезультатВыбора, РеквизитыИмениОбласти,ИзмененныеОбласти,ИзмененныеДопРеквизиты,ИзмененныеРеквизитыОтчета)

	ТаблицаДанных = ПолучитьИзВременногоХранилища(РезультатВыбора);
	КодГруппы = "";
	КодСтроки = "";
	
	ЭлементыКода   = СтрРазделить(РеквизитыИмениОбласти.ИмяИсходнойОбласти,"_",Ложь);
	Если ЭлементыКода.Количество()>=2 Тогда		
		КодГруппы = ЭлементыКода[0];
		КодСтроки = ЭлементыКода[1];
	КонецЕсли;
	
	Для Каждого СтрРеквизит Из ТаблицаДанных Цикл
		
		Если СтрРеквизит.ВидИсточника = 4 Тогда
							
			Префикс = КодГруппы+"_"+КодСтроки+"_";

			ИмяОбласти = Префикс + СтрРеквизит.ИмяРеквизита + "_" + Формат(РеквизитыИмениОбласти.Идентификатор,"ЧН=0; ЧГ=0");

			ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(СтрРеквизит.ВидКлассификатораБК);
			ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(СтрРеквизит.Значение,ЭтоСтроковыйКлассификатор);
			
			ИзмененныеОбласти.Вставить(ИмяОбласти,ВыбранноеЗначение);
			
		ИначеЕсли СтрРеквизит.ВидИсточника = 5 Тогда
						
			Префикс = КодГруппы+"_"+КодСтроки+"_Показатель_";
			
			ИмяОбласти = Префикс + СтрРеквизит.ИмяРеквизита + "_" + Формат(РеквизитыИмениОбласти.Идентификатор,"ЧН=0; ЧГ=0");
			
			ИзмененныеОбласти.Вставить(ИмяОбласти,СтрРеквизит.Значение);
			
		Иначе
			
			Если СтрРеквизит.ВидИсточника = 1 Тогда
				ИзмененныеРеквизитыОтчета.Вставить(СтрРеквизит.ИмяРеквизита,СтрРеквизит.Значение);
			ИначеЕсли СтрРеквизит.ВидИсточника = 3 Тогда
				ИзмененныеДопРеквизиты.Вставить(СтрРеквизит.ИмяРеквизита,СтрРеквизит.Значение);
			КонецЕсли;
			
			ИзмененныеОбласти.Вставить(СтрРеквизит.ИмяРеквизита,СтрРеквизит.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОтразитьВыборСвязанныхРеквизитов()

&НаКлиенте
Процедура ПослеВыбораРеквизитовИзКПС(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
		
	ОбработатьРедактированиеФормы();
	
	ГруппаРаскрытия = ДополнительныеПараметры.ГруппаРаскрытия;
	ВидАналитики = ДополнительныеПараметры.ВидАналитики;
	Идентификатор = ДополнительныеПараметры.Идентификатор;
	
	ПрефиксИмениОбласти = "";
	Для Каждого СтрГруппы Из ПараметрыГруппРаскрытия Цикл
		Если СтрГруппы.ГруппаРаскрытия = ГруппаРаскрытия Тогда
			ПрефиксИмениОбласти = СтрГруппы.КодГруппыРаскрытия+"_"+СтрГруппы.КодСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ОтразитьВыборИзКПС(ГруппаРаскрытия, ВидАналитики, ПрефиксИмениОбласти, Идентификатор, Результат, ИзмененныеОбласти);
	
	СинхронизироватьКонтекстНовыйВариант();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтразитьВыборИзКПС(ГруппаРаскрытия,ПредыдущийВидАналитики,ПрефиксИмениОбласти,ИдентификаторСтроки,ИзмененныеЗначенияАналитик,ИзмененныеОбласти)

	Если НЕ ЗначениеЗаполнено(ИзмененныеЗначенияАналитик) Тогда
		Возврат;
	КонецЕсли;
		
	КоллекцияАналитик   = БюджетнаяОтчетностьСервер.КоллекцияАналитикГруппыРаскрытия(ГруппаРаскрытия);
	СтрИдентификатор    = Формат(ИдентификаторСтроки,"ЧН=0; ЧГ=0");
	
	Для Каждого ИзмененнаяАналитика Из ИзмененныеЗначенияАналитик Цикл
		
		СтрокаАналитики = КоллекцияАналитик.Найти(ИзмененнаяАналитика.Ключ, "КодВидаАналитики");
		Если СтрокаАналитики <> Неопределено Тогда
			ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(СтрокаАналитики.ВидКлассификатораБК);
			ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(ИзмененнаяАналитика.Значение,ЭтоСтроковыйКлассификатор);
			ИзмененныеОбласти.Вставить(ПрефиксИмениОбласти+"_"+СтрокаАналитики.ИмяОбъектаАналитики+"_"+СтрИдентификатор, ВыбранноеЗначение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораЗначенияПоСценариюВвода(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
		
	ОбработатьРедактированиеФормы();
	
	ГруппаРаскрытия = ДополнительныеПараметры.ГруппаРаскрытия;
	ВидАналитики = ДополнительныеПараметры.ВидАналитики;
	Идентификатор = ДополнительныеПараметры.Идентификатор;
	
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		ПрефиксИмениОбласти = "";
		Для Каждого СтрГруппы Из ПараметрыГруппРаскрытия Цикл
			Если СтрГруппы.ГруппаРаскрытия = ГруппаРаскрытия Тогда
				ПрефиксИмениОбласти = СтрГруппы.КодГруппыРаскрытия+"_"+СтрГруппы.КодСтроки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		ОтразитьВыборПоСценариюВводаГруппыРаскрытия(ГруппаРаскрытия, ПрефиксИмениОбласти, ИзмененныеОбласти, ВидАналитики, Идентификатор, Результат);
		
	Иначе
		ИзмененныеДопРеквизиты = Новый Структура;
		ОтразитьВыборПоСценариюВводаДопРеквизитов(Объект.ВидОтчета,ИзмененныеОбласти,ВидАналитики,ИзмененныеДопРеквизиты,Результат);
		
		Если ИзмененныеДопРеквизиты.Количество() Тогда
			Для Каждого СтрДопРеквизита Из ТаблицаДополнительныхРеквизитов Цикл
				Если ИзмененныеДопРеквизиты.Свойство(СтрДопРеквизита.Код) Тогда
					СтрДопРеквизита.Значение = ИзмененныеДопРеквизиты[СтрДопРеквизита.Код];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
			
	СинхронизироватьКонтекстНовыйВариант();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОбычногоЗначения(Результат,ДополнительныеПараметры)Экспорт
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		Результат = Результат.Значение;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			// Выбор значения с возможностью редактирования.
			Если Результат.Свойство("ДоступноРедактирование") 
				И Результат.ДоступноРедактирование = Истина Тогда
				
				ТекущееЗначениеЯчейки = ДополнительныеПараметры.Область.Значение;
				
				Если ТипЗнч(Результат.Значение) = Тип("Булево") Тогда
					Результат = Результат.Значение;
				Иначе
					ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
					
					ЗначениеПоУмолчанию = ?(ЗначениеЗаполнено(ТекущееЗначениеЯчейки), ТекущееЗначениеЯчейки, Результат.Значение);
					
					ПоказатьВводЗначения(ОписаниеОповещения,
						ЗначениеПоУмолчанию,
						СтрШаблон(НСтр("ru = 'Ввод значения: %1'"), Результат.Представление),
						ТипЗнч(Результат.Значение));
					КонецЕсли;
				Возврат;
			Иначе
				Результат = Результат.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьРедактированиеФормы();	
	
	Если ДополнительныеПараметры.ВидОбласти = 1 Тогда
		Объект[ДополнительныеПараметры.Область.Имя] = Результат;
		
		Если ДополнительныеПараметры.Область.Имя = "Организация"
			ИЛИ ДополнительныеПараметры.Область.Имя = "Дата" Тогда
			ОбновитьФиксированныеПараметрыОрганизацииНаКлиенте();
		КонецЕсли;
		
		Если ДополнительныеПараметры.Область.Имя = "ПериодОтчета" или ДополнительныеПараметры.Область.Имя = "Организация" Тогда 
			
			ПредложитьОбновитьНастройкиИзРедакции(Неопределено,Новый Структура("Этап","Начало"));
			
		КонецЕсли;	
		
	ИначеЕсли ДополнительныеПараметры.ВидОбласти = 2 Тогда
		СтрПараметр = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ДополнительныеПараметры.Область.Имя));
		Если СтрПараметр.Количество() Тогда
			СтрПараметр[0].Значение = Результат;
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.ВидОбласти = 3 Тогда
		СтрПараметр = ТаблицаДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Код",ДополнительныеПараметры.Область.Имя));
		Если СтрПараметр.Количество() Тогда
			СтрПараметр[0].Значение = Результат;
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.ВидОбласти = 4 Тогда //аналитика отчета
		
		ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(ДополнительныеПараметры.ВидКлассификатораБК);
		Результат = ПреобразоватьВыбранноеЗначениеАналитики(Результат,ЭтоСтроковыйКлассификатор);
		
	КонецЕсли;
	
	ДополнительныеПараметры.Область.Значение    = Результат;
	ДополнительныеПараметры.Область.Расшифровка = Результат;
	
	ИзмененныеОбласти.Вставить(ДополнительныеПараметры.Область.Имя,Результат);

	Модифицированность = Истина;
		
	СинхронизироватьКонтекстНовыйВариант();
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, Знач ИмяЯчейки)
	
	ЗначенияОтбораПоКоду = ТаблицаФильтровПоЗначению.НайтиСтроки(Новый Структура("ИмяЯчейки", ИмяЯчейки));
	Если ЗначенияОтбораПоКоду.Количество() > 0 Тогда
		ПараметрыОтбораСубконто.Вставить("Код",ЗначенияОтбораПоКоду[0].ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру параметров, имеющих формулы расчета
//
&НаСервереБезКонтекста
Функция ПолучитьВычисляемыеПараметры(ВидОтчета,Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыОтчетовПараметрыОтчета.Код,
	|	ЗначенияПараметровОтчета.Значение
	|ИЗ
	|	Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код КАК Код,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Наименование КАК Наименование,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК Значение,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета КАК ВидОтчета
	|		ИЗ
	|			Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|		ГДЕ
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка = &Ссылка) КАК ЗначенияПараметровОтчета
	|		ПО ВидыОтчетовПараметрыОтчета.Ссылка = ЗначенияПараметровОтчета.ВидОтчета
	|ГДЕ
	|	ВидыОтчетовПараметрыОтчета.ЭтоВыражение = ИСТИНА
	|	И ВидыОтчетовПараметрыОтчета.Ссылка = &ВидОтчета";
	
	СтруктураПараметров = Новый Структура;
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("Ссылка"	 , Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураПараметров.Вставить(Выборка.Код,Выборка.Значение);
	КонецЦикла;
	
	Возврат СтруктураПараметров;

КонецФункции // ПолучитьВычисляемыеПараметры()

&НаСервереБезКонтекста
Функция ПолучитьВычисляемыйПараметрОтчета(Знач ТекОбъект,АдресОбъектаОтчет, ИмяПараметра)
	
	ОтчетОбъект = Неопределено;
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ОтчетОбъект.ОбновитьВычисляемыеПараметры(ИмяПараметра);
	ОтчетОбъект.СформироватьСтруктуруПараметров();
	ЗначениеЯчейки = Неопределено;
	ОтчетОбъект.Параметры.Свойство(ИмяПараметра,ЗначениеЯчейки);
			
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат ЗначениеЯчейки;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаголовокФормы(Знач ВидОтчета,Знач Организация,Знач Номер,Знач Дата)
	
	ШаблонЗаголовка = "%1%2 №%3 от %4";
	
	ВидОтчетаКратко = СокрЛП(ВидОтчета);
	ПозицияРазделителя = СтрНайти(ВидОтчетаКратко,",");
	Если ПозицияРазделителя > 0 Тогда
		ВидОтчетаКратко = Лев(ВидОтчетаКратко,ПозицияРазделителя-1);
	КонецЕсли;
							
	ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗаголовка,
						ВидОтчетаКратко,
						?(ЗначениеЗаполнено(Организация), ", "+СокрЛП(Организация),""),
						?(ЗначениеЗаполнено(Номер),СокрЛП(Номер),"<...>"),
						Формат(Дата,"ДЛФ=D; ДП=<...>"));
						
	Возврат ТекстЗаголовка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСохраненныеЗначенияПараметра(ВидОтчета,Ссылка,Организация,ПараметрКод)
	
	ЗначенияПараметровПоДатам = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК ПараметрЗначение,
		|	МАКСИМУМ(УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Дата) КАК ДатаИспользования
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
		|ГДЕ
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета = &ВидОтчета
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Организация = &Организация
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код = &ПараметрКод
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка <> &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаИспользования";
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПараметрКод", ПараметрКод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущееЗначение = ВыборкаДетальныеЗаписи.ПараметрЗначение;
		Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
			ЗначенияПараметровПоДатам.Вставить(ВыборкаДетальныеЗаписи.ДатаИспользования, ТекущееЗначение);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ЗначенияПараметровПоДатам;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуОкончанияПериода(ПериодОтчета)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПериодОтчета,"ДатаОкончания");	
КонецФункции


&НаКлиенте
Процедура ПредложитьОбновитьНастройкиИзРедакции(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		НовыеНастройки = БюджетнаяОтчетность.ПолучитьНастройкиОтчета(Объект.ВидОтчета, Объект.ПериодОтчета, Объект.Организация);
		
		Если НовыеНастройки = Неопределено Тогда 
			Возврат;
		КонецЕсли;	
		
		МожноПоменятьНастройки = Ложь;
		
		
		ТекстСпискаИзменений = "";
		
		Если Объект.ШаблонОтчета <> НовыеНастройки.БланкДляОтображения Тогда 
			МожноПоменятьНастройки = Истина;
			
			Шаблон =  НСтр(
			"ru = '
			|Бланк ""%1"" -> ""%2""'");
			ТекстСпискаИзменений = ТекстСпискаИзменений + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Объект.ШаблонОтчета, НовыеНастройки.БланкДляОтображения);
			
		КонецЕсли;
		
		Если Объект.ОсновнойПечатныйБланк <> НовыеНастройки.БланкДляПечати Тогда 
			МожноПоменятьНастройки = Истина;
			
			Шаблон =  НСтр(
			"ru = '
			|Печатный бланк ""%1"" -> ""%2""'");
			ТекстСпискаИзменений = ТекстСпискаИзменений + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Объект.ОсновнойПечатныйБланк, НовыеНастройки.БланкДляПечати);
			
		КонецЕсли;
		
		Если Объект.ПравилоОбработки <> НовыеНастройки.ПравилоОбработки Тогда 
			МожноПоменятьНастройки = Истина;
			
			Шаблон =  НСтр(
			"ru = '
			|Правило обработки ""%1"" -> ""%2""'");
			ТекстСпискаИзменений = ТекстСпискаИзменений + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Объект.ПравилоОбработки, НовыеНастройки.ПравилоОбработки);
			
		КонецЕсли;
		
		Если Объект.ПравилоПроверки <> НовыеНастройки.ПравилоПроверки Тогда 
			МожноПоменятьНастройки = Истина;
			
			Шаблон =  НСтр(
			"ru = '
			|Правило проверки ""%1"" -> ""%2""'");
			ТекстСпискаИзменений = ТекстСпискаИзменений + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Объект.ПравилоПроверки, НовыеНастройки.ПравилоПроверки);
			
		КонецЕсли;
		
		
		Если МожноПоменятьНастройки = Ложь Тогда 
			Возврат;
		КонецЕсли;	
		
		
		
		ШаблонВопроса = НСтр(
		"ru = 'Для выбранного периода применятся другая редакция отчета.
         |Привести настройки отчета в соответствие с редакцией выбранного периода?
         |
         |Список планируемых изменений:%1'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ТекстСпискаИзменений);
				
		
		ДополнительныеПараметры.Этап = "РезультатВопроса";
		ДополнительныеПараметры.Вставить("НовыеНастройки",НовыеНастройки);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПредложитьОбновитьНастройкиИзРедакции",ЭтаФорма,ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
		
	////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатВопроса" Тогда	
		
		Если Результат <> КодВозвратаДиалога.Да Тогда 
			Возврат;
		КонецЕсли;
		
		ИзмененБланк = (Объект.ШаблонОтчета <> ДополнительныеПараметры.НовыеНастройки.БланкДляОтображения);
		
		Объект.ШаблонОтчета = ДополнительныеПараметры.НовыеНастройки.БланкДляОтображения;
		Объект.ПравилоОбработки = ДополнительныеПараметры.НовыеНастройки.ПравилоОбработки;
		Объект.ПравилоПроверки = ДополнительныеПараметры.НовыеНастройки.ПравилоПроверки;
		Объект.ОсновнойПечатныйБланк = ДополнительныеПараметры.НовыеНастройки.БланкДляПечати;
		
		СинхронизироватьИВывестиБланк(Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка, ИзмененБланк);
		ОбновитьКнопкиПечати();
		
	КонецЕсли;	
	
	
	
КонецПроцедуры	


&НаКлиенте
Функция НеобходимаСверткаПоАналитикеРучнойРежим(Адрес, ИменаГруппы)
	
	СинхронизироватьКонтекстНовыйВариант();
	Возврат НеобходимаСверткаПоАналитикеРучнойРежимБезКонтекста(Объект, АдресОбъектаОтчет, Адрес, ИменаГруппы);
	
КонецФункции

&НаСервереБезКонтекста
Функция НеобходимаСверткаПоАналитикеРучнойРежимБезКонтекста(Знач ТекОбъект, АдресОбъектаОтчет, Адрес, ИменаГруппы)
	
	ОтчетОбъект = Неопределено;
	НеобходимаСвертка = Ложь;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
		
	ИменаГруппы = Новый Структура("КодСтроки,ИмяГруппы");
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(Адрес.КодСтроки,"КодСтроки");
	Если Не СтрРаскрытия = Неопределено Тогда
		
		Если ОтчетОбъект.ЕстьСтрокиПодлежащиеСвертке(СтрРаскрытия,Истина) Тогда
			
			НеобходимаСвертка = Истина;
			ИменаГруппы.КодСтроки = Адрес.КодСтроки;
			ИменаГруппы.ИмяГруппы = Строка(СтрРаскрытия.ГруппаРаскрытия);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат НеобходимаСвертка;
	
КонецФункции

&НаСервере
Функция НеобходимаСверткаПоАналитикеПередЗаписью()
	
	ГруппыТребующиеСвертки = Новый Массив;
	СтрИменаГрупп = "";
	Для Каждого СтрРаскрытие Из ОтчетОбъект.ТабОбластиРаскрытия Цикл
		Если ОтчетОбъект.ЕстьСтрокиПодлежащиеСвертке(СтрРаскрытие) Тогда
			ГруппыТребующиеСвертки.Добавить(СтрРаскрытие.ГруппаРаскрытия);
			СтрИменаГрупп = СтрИменаГрупп + ", «" + Строка(СтрРаскрытие.ГруппаРаскрытия) + "»";
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппыТребующиеСвертки.Количество() Тогда
		
		Если Элементы.Найти("ПанельИнформацииОСвертке") = Неопределено Тогда
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Группа строк %1 содержит одинаковые комбинации значений аналитики. Объединить одинаковые строки?'"),
				Сред(СтрИменаГрупп,3));
			
			Если ОтображатьВВидеТаблицыФормы Тогда
				ГруппаРодитель = Элементы.РедактированиеВТаблицеФормы;
				ЭлементЗамещения = Элементы.РазделыМакета;
			Иначе
				ГруппаРодитель = Элементы.ГруппаТабДок;
				ЭлементЗамещения = Элементы.ТабличныйДокументОтчета;
			КонецЕсли;
				
			ПанельСообщения = Элементы.Вставить("ПанельИнформацииОСвертке", 
				Тип("ГруппаФормы"), 
				ГруппаРодитель,
				ЭлементЗамещения);
				
			ПанельСообщения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ПанельСообщения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			ПанельСообщения.ОтображатьЗаголовок = Ложь;
			ПанельСообщения.Отображение = ОтображениеОбычнойГруппы.Нет;
			ПанельСообщения.РастягиватьПоГоризонтали = Истина;
			ПанельСообщения.ЦветФона = ЦветаСтиля.ФонУправляющегоПоля;
			ПанельСообщения.РастягиватьПоВертикали = Ложь;			
			
			КнопкаСвертки = Элементы.Добавить("КнопкаСверткаАналитикиПриЗаписи", Тип("КнопкаФормы"), ПанельСообщения);
			КнопкаСвертки.ИмяКоманды = "СвернутьАналитикуПриЗаписи";
			КомандаЗакрыть = Команды.Добавить("ЗакрытьПанельИнформацииОСвертке");
			КомандаЗакрыть.Картинка = БиблиотекаКартинок.Закрыть;
			КомандаЗакрыть.Отображение = ОтображениеКнопки.Картинка;
			КомандаЗакрыть.Действие = "Подключаемый_ЗакрытьПанельИнформацииОСвертке";
			
			КнопкаЗакрыть = Элементы.Добавить("КнопкаЗакрытьПанельИнформацииОСвертке", Тип("КнопкаФормы"), ПанельСообщения);
			КнопкаЗакрыть.ИмяКоманды = "ЗакрытьПанельИнформацииОСвертке";
			КнопкаЗакрыть.Ширина = 3;
			
			Декорация = Элементы.Добавить("ДекорацияСообщенияОСвертке", Тип("ДекорацияФормы"), ПанельСообщения);
			Декорация.Вид = ВидДекорацииФормы.Надпись;
			Декорация.Заголовок = Сообщение;
			Декорация.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
			Декорация.РастягиватьПоВертикали = Ложь;
			Декорация.РастягиватьПоГоризонтали = Истина;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ЗакрытьПанельИнформацииОСвертке(Кнопка)

	ЗакрытьПанельИнформацииОСвертке();

КонецПроцедуры // Подключаемый_ЗакрытьПанельИнформацииОСвертке()

&НаСервере
Процедура ЗакрытьПанельИнформацииОСвертке()

	Панель = Элементы.Найти("ПанельИнформацииОСвертке");
	Если Панель <> Неопределено Тогда 
		Элементы.Удалить(Панель);
		Команды.Удалить(Команды.Найти("ЗакрытьПанельИнформацииОСвертке"));
	КонецЕсли;

КонецПроцедуры // ЗакрытьПанельПодсказкиОСвертке()

&НаСервере
Процедура РучнаяСверткаПоАналитикеСервер(Знач КодСтроки) 

	ВосстановитьОбъектОтчета();
	
	КопияРаскрытия = ОтчетОбъект.ПолучитьКопиюРаскрытия();
	АдресКопииРаскрытия = ПоместитьВоВременноеХранилище(КопияРаскрытия, УникальныйИдентификатор);
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки ,"КодСтроки");
	ОтчетОбъект.ИнтеллектуальнаяСверткаПоАналитике(СтрРаскрытия.ТаблицаРаскрытия, СтрРаскрытия.ГруппаРаскрытия);
	// Пересчет.
	ВсеКолонки 		 = Новый Массив;
	ПоказателиГруппы = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия));
	Для Каждого Пок Из ПоказателиГруппы Цикл
		ВсеКолонки.Добавить(Пок.Код);
	КонецЦикла;
	
	ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,ВсеКолонки);
	
	ПараметрыГруппы = ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);	
	МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	СтрРаскрытия.ТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(ПараметрыГруппы);
	СтрРаскрытия.ТабДокРаскрытие  = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,
																					  СтрРаскрытия.ТаблицаРаскрытия,,
																					  СтрРаскрытия.КодСтроки,
																					  МакетыРаскрытия);
																					  
	ПрименитьНастройкуВыводаДлинныхСтрок(СтрРаскрытия.ТабДокРаскрытие,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);																			  
																				  
	СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
		
	ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрРаскрытия);
	ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
	СтрРаскрытия.ТабДокРаскрытие.Очистить();
		
	ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета);
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
		
	ПоместитьОбъектОтчета();
	
	ДобавитьКнопкуОтменыСвертки();

КонецПроцедуры // РучнаяСверткаПоАналитикеСервер()

&НаКлиенте
Процедура ПараметрыОтчетаЗначениеПриИзменении(Элемент)
	
	ТД = Элементы.ПараметрыОтчета.ТекущиеДанные;
	ИзмененныеОбласти.Вставить(ТД.Код,ТД.Значение);
	СинхронизироватьКонтекстНовыйВариант();

КонецПроцедуры
	
&НаКлиенте
Процедура ПараметрыОтчетаЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТД = Элементы.ПараметрыОтчета.ТекущиеДанные;
	
	ЗначенияПараметровПоДатам = ПолучитьСохраненныеЗначенияПараметра(Объект.ВидОтчета,Объект.Ссылка,Объект.Организация,ТД.Код);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТД);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметраВФорме",ЭтотОбъект,ДополнительныеПараметры);
				
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("ЗначенияПараметровПоДатам", ЗначенияПараметровПоДатам);
	ПараметрыФормы.Вставить("ТекущееЗначение", ТД.Значение);
	ПараметрыФормы.Вставить("НаименованиеПараметра", ТД.Наименование);
	
	ПараметрыОбласти = ПолучитьПараметрыОбласти(ТД.Код);
	Если ПараметрыОбласти <> Неопределено Тогда
		Если ПараметрыОбласти.НастройкиЯчейки <> Неопределено Тогда
			Если ПараметрыОбласти.НастройкиЯчейки.ЕстьСписокДоступныхЗначений = Истина Тогда
				ПараметрыФормы.Вставить("ДоступныеЗначения", ПараметрыОбласти.ДоступныеЗначения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСохраненныхПараметров", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПараметраВФорме(Результат,ДополнительныеПараметры)Экспорт
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ДополнительныеПараметры.ТекущиеДанные.Значение = Результат;
	ИзмененныеОбласти.Вставить(ДополнительныеПараметры.ТекущиеДанные.Код,ДополнительныеПараметры.ТекущиеДанные.Значение);
	Модифицированность = Истина;
	СинхронизироватьКонтекстНовыйВариант();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОбщуюИнициализациюФормы(Знач ПарамОтчетОбъект)
	
	БюджетнаяОтчетностьСерверПереопределяемый.ВосстановитьДанныеРасшифровки(ПарамОтчетОбъект,ЭтаФорма); 
	
	ИнициализироватьОтчет(ПарамОтчетОбъект);
		
	БюджетнаяОтчетностьСерверПереопределяемый.ИнициализироватьАвтозаполнение(ПарамОтчетОбъект,ЭтаФорма)
	
КонецПроцедуры // ВыполнитьОбщуюИнициализациюФормы()

&НаСервереБезКонтекста
Функция ПриИзмененииДатыИзмениласьНумерация(Знач НачальнаяДатаДокумента, Знач НоваяДатаДокумента) Экспорт

	// Определяем назначенную для данного вида документов периодичность смены номера
	ПериодСменыНомера = Метаданные.Документы.УниверсальныйРегламентированныйОтчет.ПериодичностьНомера;

	//В зависимости от установленной периодичности смены номеров,
	//определяем разность старой и новой датами документа.
	Если ПериодСменыНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Год Тогда
		РазностьДат = НачалоГода(НачальнаяДатаДокумента) - НачалоГода(НоваяДатаДокумента);

	ИначеЕсли ПериодСменыНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Квартал Тогда
		РазностьДат = НачалоКвартала(НачальнаяДатаДокумента) - НачалоКвартала(НоваяДатаДокумента);

	ИначеЕсли ПериодСменыНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Месяц Тогда
		РазностьДат = НачалоМесяца(НачальнаяДатаДокумента) - НачалоМесяца(НоваяДатаДокумента);

	ИначеЕсли ПериодСменыНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.День Тогда
		РазностьДат = НачальнаяДатаДокумента - НоваяДатаДокумента;

	Иначе
		Возврат Ложь;
	КонецЕсли;

	Если РазностьДат <> 0 Тогда
		Возврат Истина;
	КонецЕсли;

КонецФункции // ПроверитьНомерДокумента()

&НаСервере
Процедура ОтменитьСверткуПоАналитикеСервер()
	
	КопияРаскрытия = ПолучитьИзВременногоХранилища(АдресКопииРаскрытия);
	СинхронизироватьКонтекстСервер(Ложь);
	ОтчетОбъект.мПоказателиРаскрытия = КопияРаскрытия;
	ОтчетОбъект.ТабОбластиРаскрытия.Очистить();
	УдалитьИзВременногоХранилища(АдресКопииРаскрытия);
	АдресКопииРаскрытия = "";
	ВывестиДанныеОтчета();
	ПоместитьОбъектОтчета();
	
	ОтменитьВозможностьОткатаСвертки();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопкуОтменыСвертки()

	КнопкаОтмены = Элементы.Добавить("КнопкаОтменитьСверткуПоАналитике", Тип("КнопкаФормы"), Элементы.ПанельУправленияРаскрытием);
	КнопкаОтмены.ИмяКоманды = "ОтменитьСверткуПоАналитике";

КонецПроцедуры // ДобавитьКнопкуОтменыСвертки()


&НаСервере
Процедура СвернутьАналитикуПриЗаписиНаСервере()
	
	ВосстановитьОбъектОтчета();
	
	КопияРаскрытия = ОтчетОбъект.ПолучитьКопиюРаскрытия();
	АдресКопииРаскрытия = ПоместитьВоВременноеХранилище(КопияРаскрытия, УникальныйИдентификатор);
	Для Каждого СтрРаскрытие Из ОтчетОбъект.ТабОбластиРаскрытия Цикл
		Если ОтчетОбъект.ЕстьСтрокиПодлежащиеСвертке(СтрРаскрытие) Тогда
			ОтчетОбъект.ИнтеллектуальнаяСверткаПоАналитике(СтрРаскрытие.ТаблицаРаскрытия, СтрРаскрытие.ГруппаРаскрытия);
			ОтчетОбъект.РассчитатьВычисляемыеПоказатели();
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьКнопкуОтменыСвертки();
	ЗакрытьПанельИнформацииОСвертке();
	ВывестиДанныеОтчета();
	ПоместитьОбъектОтчета();
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ЗаполнитьПоРанееСохраненнымБезКонтекста(ИзмененияДляТабДока,МассивПараметров,АдресТекущейСтраницы,Знач ТекОбъект,АдресОбъектаОтчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код КАК ПараметрКод,
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК ПараметрЗначение,
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Дата КАК ДатаОтчета,
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
		|ГДЕ
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета = &ВидОтчета
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Организация = &Организация
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Дата <= &НаДату
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка <> &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОтчета УБЫВ
		|ИТОГИ ПО
		|	Ссылка";
		
	КоличествоПараметров = ТекОбъект.ПараметрыОтчета.Количество();
	Если КоличествоПараметров>0 Тогда
		КолДок = 25;//Смотрим последние 25 отчетов 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПЕРВЫЕ 1","ПЕРВЫЕ "+Формат(КоличествоПараметров*КолДок,"ЧГ="));	
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ТекОбъект.Дата) Тогда
		ТекДата = КонецДня(ТекОбъект.Дата);
	Иначе
		ТекДата = КонецДня(ТекущаяДата());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидОтчета", ТекОбъект.ВидОтчета);
	Запрос.УстановитьПараметр("Организация", ТекОбъект.Организация);
	Запрос.УстановитьПараметр("Ссылка", ТекОбъект.Ссылка);
	Запрос.УстановитьПараметр("НаДату", ТекДата);
	
	РанееВыбранныеПараметры = Новый Структура();
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
		ЕстьЗаполненные = Ложь;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекущееЗначение = ВыборкаДетальныеЗаписи.ПараметрЗначение;
			Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
				РанееВыбранныеПараметры.Вставить(ВыборкаДетальныеЗаписи.ПараметрКод, ТекущееЗначение);
				ЕстьЗаполненные = Истина;
			КонецЕсли;	
		КонецЦикла;
		Если ЕстьЗаполненные Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если РанееВыбранныеПараметры.Количество() Тогда
		ОтчетОбъект = Неопределено;	
		ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
		
		Для Каждого СтрокаПараметра Из ОтчетОбъект.ПараметрыОтчета Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение) Тогда
				ПараметрКод = СтрокаПараметра.Код;
				Если РанееВыбранныеПараметры.Свойство(ПараметрКод) Тогда
					СтрокаПараметра.Значение = РанееВыбранныеПараметры[ПараметрКод];
					СтруктураПараметра = Новый Структура("Код,Наименование,Значение");
					ЗаполнитьЗначенияСвойств(СтруктураПараметра,СтрокаПараметра);
					МассивПараметров.Добавить(СтруктураПараметра);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		ОтчетОбъект.СформироватьСтруктуруПараметров();//формируется по таблице ПараметрыОтчета, поэтому надо формировать после изменения этой таблицы
	
		ТекМакет = ПолучитьИзВременногоХранилища(АдресТекущейСтраницы);
		
		ОтчетОбъект.ЗаполнитьРеквизитыБезМакета(ТекМакет,ИзмененияДляТабДока);
		
		ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "Очистить" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ПодготовитьЗаполнениеОтчета();
			ОчиститьОтчет();
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "РучнаяСверткаПоАналитике" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			РучнаяСверткаПоАналитикеСервер(ДополнительныеПараметры.КодСтроки);
			Модифицированность = Истина;
			ОбновитьУстановленныеОтборы();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "ПриОткрытии" Тогда 
		
		ДополнительныеПараметры.ПараметрыОтчета.ЗначенияЗаполнения.Вставить("ВидОтчета",Результат);
		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаОбъекта", ДополнительныеПараметры.ПараметрыОтчета, 
			ВладелецФормы, Новый УникальныйИдентификатор, Окно, НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкна);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "НастройкаСпискаРаскрытияТаблицаФормы" Тогда 
		
		ПрименитьНастройкуСписка(ДополнительныеПараметры.ТекущиеДанные.КодСтроки, Результат, ДополнительныеПараметры.ТекущийЭлемент.Имя);
		ОбновитьУстановленныеОтборыРаздела(Неопределено);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "НастройкаСпискаРаскрытияТабличныйДокумент" Тогда 
		
		ПрименитьНастройкуСписка(ДополнительныеПараметры.КодСтрокиСтрокиРаскрытия, Результат);		
		ОбновитьУстановленныеОтборы();
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ОбработкаПромежуточногоИтогаТабличныйДокумент" Тогда 
		
		ДополнительныеПараметры.ДанныеДляУточнения.ЗначениеПромежуточногоИтога = Результат;
		ОбработатьПользовательскийВыборПромежуточногоИтога(ДополнительныеПараметры.ДанныеДляУточнения);
		ОбновитьУстановленныеОтборы();
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ОбработкаПромежуточногоИтогаТаблицаФормы" Тогда
		
		УстановитьПромежуточныеИтогиВТаблицеФормы(ДополнительныеПараметры.ТекущийЭлемент.Имя, ДополнительныеПараметры.ИдентификаторыСтрок, Результат);	
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаПроизвольногоОповещения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Источник = "ВвестиПараметрыИВыполнитьДействиеКоманды" Тогда 
		
		ВывестиДанныеОтчета();
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция АктивнаЗагрузкаКомплектаБезКонтекста()
	
	ЗагрузкаАктивна = БюджетнаяОтчетность.ВыполняетсяЗагрузкаКомплекта();
		
	Возврат ЗагрузкаАктивна;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Функция АктивнаЗагрузкаКомплекта(ФормаДок)
	
	ЗагрузкаАктивна = АктивнаЗагрузкаКомплектаБезКонтекста();
		
	Если ЗагрузкаАктивна
		И ФормаДок.ПроисходилаЗагрузкаКомплекта = Ложь Тогда
		
		//Загрузка только началась
		РедактированиеЗапрещено = Истина;
		
		Если ФормаДок.мДоступностьРедактирования = Неопределено Тогда
			ФормаДок.мДоступностьРедактирования = ФормаДок.Элементы.ФормаВключитьРедактирование.Доступность;
		КонецЕсли;
		
		ФормаДок.ТолькоПросмотр = РедактированиеЗапрещено;
		ФормаДок.Элементы.ФормаВключитьРедактирование.Доступность = НЕ РедактированиеЗапрещено;
		УстановитьДоступностьМенюЗаполнения(ФормаДок, НЕ РедактированиеЗапрещено);
		ФормаДок.Элементы.ПредупреждениеАктивнаяЗагрузкаКомлекта.Видимость = Истина;
		
		ФормаДок.ПроисходилаЗагрузкаКомплекта = Истина;
		
	ИначеЕсли ЗагрузкаАктивна = Ложь 
		И ФормаДок.ПроисходилаЗагрузкаКомплекта Тогда
		//Загрузка завершилась Тогда
		
		Если ФормаДок.мДоступностьРедактирования <> Неопределено Тогда
			ФормаДок.Элементы.ФормаВключитьРедактирование.Доступность = ФормаДок.мДоступностьРедактирования;
			ФормаДок.мДоступностьРедактирования = Неопределено;
		КонецЕсли;
		
		//если был включен режим редактирования, значит можно было редактировать, вернем как было
		РедактированиеБылоРазрешено = ФормаДок.Элементы.ФормаВключитьРедактирование.Пометка; 
		
		ФормаДок.Элементы.ПредупреждениеАктивнаяЗагрузкаКомлекта.Видимость = Ложь;
		
		ФормаДок.ТолькоПросмотр = Не РедактированиеБылоРазрешено;
		ФормаДок.Элементы.ФормаВключитьРедактирование.Пометка = РедактированиеБылоРазрешено;
		ФормаДок.Элементы.ТабличныйДокументОтчетаКонтекстноеМенюВставитьИзБуфераОбмена.Доступность = РедактированиеБылоРазрешено;
		
		УстановитьДоступностьМенюЗаполнения(ФормаДок, РедактированиеБылоРазрешено);
		
		Если ФормаДок.ОтображатьВВидеТаблицыФормы Тогда
			
			МакетОтображения = ПолучитьМакетОтображения(ФормаДок.АдресНастроекОтчета,Неопределено);
		
			Для Каждого Раздел Из МакетОтображения.Разделы Цикл
				ФормаДок.Элементы[ИмяТаблицыРаздела(Раздел)].ТолькоПросмотр = Не РедактированиеБылоРазрешено;		
			КонецЦикла;
		КонецЕсли;
									
		ФормаДок.ПроисходилаЗагрузкаКомплекта = Ложь;
				
	ИначеЕсли ЗагрузкаАктивна = Ложь
		И ФормаДок.ПроисходилаЗагрузкаКомплекта = Ложь Тогда
		
		ФормаДок.Элементы.ПредупреждениеАктивнаяЗагрузкаКомлекта.Видимость = Ложь;
		
	КонецЕсли;
		
		
	Возврат ЗагрузкаАктивна;
	
КонецФункции

&НаКлиенте
Процедура ПодключитьОбработчикОжиданияЗагрузкаКомплекта()
	ПодключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта",30);
КонецПроцедуры	

&НаКлиенте
Процедура Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта()
	
	ЗагрузкаАктивна = АктивнаЗагрузкаКомплекта(ЭтотОбъект);
	
	Если НЕ ЗагрузкаАктивна Тогда
		ОтключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузкаКомплекта");
	КонецЕсли;	
	
КонецПроцедуры

