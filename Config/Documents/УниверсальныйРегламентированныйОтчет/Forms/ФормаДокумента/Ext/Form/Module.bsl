#Область УдалениеСтрокРаскрытия

&НаКлиенте
Процедура УдалитьСтрокуРаскрытия(Команда)
	
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	#Если ВебКлиент Тогда
					
		МассивОбл = Новый Массив;
		Для Каждого Обл Из ТекВыделенныеОбласти Цикл
			ТекВерх = ?(Обл.Верх = 0,1,Обл.Верх);
			ТекНиз = ?(Обл.Низ = 0,ТабличныйДокументОтчета.ВысотаТаблицы,Обл.Низ);
			ТекЛево = ?(Обл.Лево = 0,1,Обл.Лево);
			ТекПраво = ?(Обл.Право = 0,ТабличныйДокументОтчета.ШиринаТаблицы,Обл.Право);
			
			СтруктураОбл = Новый Структура("ТекВерх,ТекНиз,ТекЛево,ТекПраво",ТекВерх,ТекНиз,ТекЛево,ТекПраво);
			МассивОбл.Добавить(СтруктураОбл);
		КонецЦикла;
		
		УдалитьСтрокуРаскрытияНаСервере(ТабличныйДокументОтчета,МассивОбл,мУдаляемыеСтроки,мСоответствиеЦветовОбластей,ПараметрыГруппРаскрытия);
		
	#Иначе
				
		Если мУдаляемыеСтроки = Неопределено Тогда
			СтруктураОбластейРаскрытия = Новый Структура;
		Иначе
			СтруктураОбластейРаскрытия = Новый Структура(мУдаляемыеСтроки);
		КонецЕсли;
	
		// Удаление может производится для нескольких строк.
		Для Каждого Обл Из ТекВыделенныеОбласти Цикл
			
			ТекВерх = ?(Обл.Верх = 0,1,Обл.Верх);
			ТекНиз = ?(Обл.Низ = 0,ТабличныйДокументОтчета.ВысотаТаблицы,Обл.Низ);
			ТекЛево = ?(Обл.Лево = 0,1,Обл.Лево);
			ТекПраво = ?(Обл.Право = 0,ТабличныйДокументОтчета.ШиринаТаблицы,Обл.Право);
			
			Для СчСтрок = ТекВерх По ТекНиз Цикл
				Для СчКолонок = ТекЛево По ТекПраво Цикл
					
					ТекОбласть 	 = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
					АдресОбласти = ПолучитьАдресСтрокиРаскрытия(ТекОбласть.Имя);
					
					Если АдресОбласти <> Неопределено 
						И АдресОбласти.Идентификатор <> Неопределено Тогда
						ИскомыйИД = Формат(АдресОбласти.Идентификатор,"ЧН=0; ЧГ=0");
						КлючИмени = АдресОбласти.КодГруппыРаскрытия+"_"+АдресОбласти.КодСтроки+"_";
						МассивИД = Неопределено;
						СтруктураОбластейРаскрытия.Свойство(КлючИмени,МассивИД);
						Если МассивИД = Неопределено Тогда
							МассивИД = Новый Массив;
							МассивИД.Добавить(ИскомыйИД);
						ИначеЕсли МассивИД.Найти(ИскомыйИД) = Неопределено Тогда
							МассивИД.Добавить(ИскомыйИД);
						КонецЕсли;
						СтруктураОбластейРаскрытия.Вставить(КлючИмени, МассивИД);
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
		мУдаляемыеСтроки = Новый ФиксированнаяСтруктура(СтруктураОбластейРаскрытия);
		Если мУдаляемыеСтроки.Количество()>0 Тогда
			ВыделитьУдаляемыеСтрокиРаскрытия();
		КонецЕсли;
		
	#КонецЕсли

	Если мУдаляемыеСтроки.Количество()>0 Тогда		
		Элементы.ГруппаУдалениеРаскрытия.Доступность = Истина;
	Иначе
		мУдаляемыеСтроки = Неопределено;
		Элементы.ГруппаУдалениеРаскрытия.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьСтрокуРаскрытияНаСервере(ТабличныйДокументОтчета,МассивОбл,мУдаляемыеСтроки,мСоответствиеЦветовОбластей,Знач ПараметрыГруппРаскрытия)
	
	Если мУдаляемыеСтроки = Неопределено Тогда
		СтруктураОбластейРаскрытия = Новый Структура;
	Иначе
		СтруктураОбластейРаскрытия = Новый Структура(мУдаляемыеСтроки);
	КонецЕсли;
	
	// Удаление может производится для нескольких строк.
	
	Для Каждого ТекСтруктураОбл Из МассивОбл Цикл
		
		ТекВерх = ТекСтруктураОбл.ТекВерх;
		ТекНиз = ТекСтруктураОбл.ТекНиз;
		ТекЛево = ТекСтруктураОбл.ТекЛево;
		ТекПраво = ТекСтруктураОбл.ТекПраво;
		
		Для СчСтрок = ТекВерх По ТекНиз Цикл
			Для СчКолонок = ТекЛево По ТекПраво Цикл
				
				ТекОбласть 	 = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
				АдресОбласти = АдресСтрокиРаскрытияБезКонтекста(ТекОбласть.Имя,ПараметрыГруппРаскрытия);
				
				Если АдресОбласти <> Неопределено 
					И АдресОбласти.Идентификатор <> Неопределено Тогда
										
					ИскомыйИД = Формат(АдресОбласти.Идентификатор,"ЧН=0; ЧГ=0");
					КлючИмени = АдресОбласти.КодГруппыРаскрытия+"_"+АдресОбласти.КодСтроки+"_";
					МассивИД = Неопределено;
					СтруктураОбластейРаскрытия.Свойство(КлючИмени,МассивИД);
					Если МассивИД = Неопределено Тогда
						МассивИД = Новый Массив;
						МассивИД.Добавить(ИскомыйИД);
					ИначеЕсли МассивИД.Найти(ИскомыйИД) = Неопределено Тогда
						МассивИД.Добавить(ИскомыйИД);
					КонецЕсли;
					СтруктураОбластейРаскрытия.Вставить(КлючИмени, МассивИД);
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	мУдаляемыеСтроки = Новый ФиксированнаяСтруктура(СтруктураОбластейРаскрытия);
	
	Если мУдаляемыеСтроки.Количество()>0 Тогда
		
		ВыделитьУдаляемыеСтрокиРаскрытияНаСервере(мСоответствиеЦветовОбластей,ТабличныйДокументОтчета,мУдаляемыеСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьУдалениеСтрокРаскрытия(Команда)
		
	Если мУдаляемыеСтроки <> Неопределено Тогда
		МассивОбластейРаскрытия = Новый Массив();
		Для Каждого КлючИЗначение Из мУдаляемыеСтроки Цикл
			МассивИД = КлючИЗначение.Значение;
			Если МассивИД.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			МассивЧастейИмени = СтрРазделить(КлючИЗначение.Ключ,"_",Ложь);
			ТекКодСтроки = МассивЧастейИмени[1];
			СтруктураНастройки = Новый Структура("КодСтроки,МассивИД",ТекКодСтроки,МассивИД);
			МассивОбластейРаскрытия.Добавить(СтруктураНастройки);
		КонецЦикла;
		Если МассивОбластейРаскрытия.Количество() > 0 Тогда
			ОбработатьРедактированиеФормы();
			
			ВходящиеПараметры = Новый Структура;
			ВходящиеПараметры.Вставить("АдресОбъектаОтчет",АдресОбъектаОтчет);
			ВходящиеПараметры.Вставить("ВыводитьРаскрытиеВТелеБланка",Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
			ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
			ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
			
			УдалитьСтрокиРаскрытияБезКонтекста(Объект,ТабличныйДокументОтчета,ИзмененныеОбласти,МассивОбластейРаскрытия,ВходящиеПараметры);
			
			ОбновитьУстановленныеОтборы();
		КонецЕсли;
	КонецЕсли;
	
	мУдаляемыеСтроки = Неопределено;
	мСоответствиеЦветовОбластей = Неопределено;
	Элементы.ГруппаУдалениеРаскрытия.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУдалениеВыделенных(Команда)
	
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	#Если ВебКлиент Тогда
				
		МассивОбл = Новый Массив;
		Для Каждого Обл Из ТекВыделенныеОбласти Цикл
			ТекВерх = ?(Обл.Верх = 0,1,Обл.Верх);
			ТекНиз = ?(Обл.Низ = 0,ТабличныйДокументОтчета.ВысотаТаблицы,Обл.Низ);
			ТекЛево = ?(Обл.Лево = 0,1,Обл.Лево);
			ТекПраво = ?(Обл.Право = 0,ТабличныйДокументОтчета.ШиринаТаблицы,Обл.Право);
			
			СтруктураОбл = Новый Структура("ТекВерх,ТекНиз,ТекЛево,ТекПраво",ТекВерх,ТекНиз,ТекЛево,ТекПраво);
			МассивОбл.Добавить(СтруктураОбл);
		КонецЦикла;
		
		ОтменитьУдалениеВыделенныхНаСервере(мУдаляемыеСтроки,ТабличныйДокументОтчета,МассивОбл,мСоответствиеЦветовОбластей, ПараметрыГруппРаскрытия);
		
	#Иначе
		
		Если мУдаляемыеСтроки = Неопределено Тогда
			СтруктураОбластейРаскрытия = Новый Структура;
		Иначе
			СтруктураОбластейРаскрытия = Новый Структура(мУдаляемыеСтроки);
		КонецЕсли;
		
		// Удаление может производится для нескольких строк.
		ЦветФонаУдаляемойСтроки = Новый Цвет(178,178,178);
			
		СтруктураОбластейОтмены = Новый Структура;//для отмены удаления
		Для Каждого Обл Из ТекВыделенныеОбласти Цикл
			
			ТекВерх = ?(Обл.Верх = 0,1,Обл.Верх);
			ТекНиз = ?(Обл.Низ = 0,ТабличныйДокументОтчета.ВысотаТаблицы,Обл.Низ);
			ТекЛево = ?(Обл.Лево = 0,1,Обл.Лево);
			ТекПраво = ?(Обл.Право = 0,ТабличныйДокументОтчета.ШиринаТаблицы,Обл.Право);
			
			Для СчСтрок = ТекВерх По ТекНиз Цикл
				Для СчКолонок = ТекЛево По ТекПраво Цикл
					
					ТекОбласть 	 = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
					АдресОбласти = ПолучитьАдресСтрокиРаскрытия(ТекОбласть.Имя);
					 
					Если Не АдресОбласти = Неопределено 
						И Не АдресОбласти.Идентификатор = Неопределено Тогда
												
						КлючИмени = АдресОбласти.КодГруппыРаскрытия+"_"+АдресОбласти.КодСтроки+"_";
						ИскомыйИД = Формат(АдресОбласти.Идентификатор,"ЧН=0; ЧГ=0");
						
						МассивИДОтмены = Неопределено;
						СтруктураОбластейОтмены.Свойство(КлючИмени,МассивИДОтмены);
						Если МассивИДОтмены = Неопределено Тогда
							МассивИДОтмены = Новый Массив;
							МассивИДОтмены.Добавить(ИскомыйИД);
						ИначеЕсли МассивИДОтмены.Найти(ИскомыйИД) = Неопределено Тогда
							МассивИДОтмены.Добавить(ИскомыйИД);
						КонецЕсли;
						СтруктураОбластейОтмены.Вставить(КлючИмени, МассивИДОтмены);
												
						МассивИД = Неопределено;
						Если СтруктураОбластейРаскрытия.Свойство(КлючИмени,МассивИД) Тогда
							ИДЗначения = МассивИД.Найти(ИскомыйИД);
							Если ИДЗначения<> Неопределено Тогда
								МассивИД.Удалить(ИДЗначения);
								Если МассивИД.Количество() = 0 Тогда
									СтруктураОбластейРаскрытия.Удалить(КлючИмени);
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
					
		Если СтруктураОбластейОтмены.Количество()>0 Тогда			
			ОтменитьВыделениеУдаляемыхСтрок(СтруктураОбластейОтмены);
		КонецЕсли;
		
		мУдаляемыеСтроки = Новый ФиксированнаяСтруктура(СтруктураОбластейРаскрытия);
	
	#КонецЕсли
		
	Если мУдаляемыеСтроки.Количество() = 0 Тогда
		мУдаляемыеСтроки = Неопределено;
		мСоответствиеЦветовОбластей = Неопределено;
		Элементы.ГруппаУдалениеРаскрытия.Доступность = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

