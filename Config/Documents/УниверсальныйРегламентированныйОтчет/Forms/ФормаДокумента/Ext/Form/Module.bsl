#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСтраниц

&НаКлиенте
Процедура ДеревоСтраницПриАктивизацииСтроки(Элемент)
	ТекСтраница = Элементы.ДеревоСтраниц.ТекущиеДанные;
	Если ТекСтраница = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСтраница.АдресБланка = АдресТекущейСтраницы Тогда
		//Пользователь выбрал текущую страницу.
		//Ничего не делаем.
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиДереваСтраниц",0.2,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиДереваСтраниц() Экспорт
	
	ТекСтраница = Элементы.ДеревоСтраниц.ТекущиеДанные;
	Если ТекСтраница = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСтраница.АдресБланка = АдресТекущейСтраницы Тогда
		//Пользователь выбрал текущую страницу.
		//Ничего не делаем.
		Возврат;
	КонецЕсли;
	
	//Если была свертка, отменим возможность отката
	Если Не ПустаяСтрока(АдресКопииРаскрытия) Тогда
		ОтменитьВозможностьОткатаСвертки();
	КонецЕсли;
	
	//если были выделены удаляемые строки, отменим.
	Если мУдаляемыеСтроки <> Неопределено Тогда
		ОтменитьУдаление(Неопределено);
	КонецЕсли;
		
	РежимРаскрытия = Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка;
	
	ИдСтраницы = ТекСтраница.ПолучитьИдентификатор();
	ВыбратьСтраницуНаСервере(ИдСтраницы,РежимРаскрытия,мСоответствиеПоиска,Истина);
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьСтраницуНаСервере(ИдСтраницы,РежимРаскрытия,СоответствиеПоиска,ПомещатьОтчет)
	
	Если ЗначениеЗаполнено(АдресТекущейСтраницы) Тогда
		//Отключение отбора
		Если СоответствиеПоиска <> Неопределено Тогда
			ОчиститьУстановленныеОтборыНаСервере(СоответствиеПоиска);
		КонецЕсли;		
		
		СинхронизироватьКонтекстСервер(Ложь,Ложь);//если есть измененные области, то до смены страницы нужно синхронизировать контекст
		
		мИмяОбластиДокумента = "";//очистка имени области поиска от прошлой страницы
		
		ТабличныйДокументОтчета.ФиксацияСверху = 0;
		ТабличныйДокументОтчета.ФиксацияСлева = 0;
		
		//Сохранение текущего табличного документа
		
	    ТаблДок = Новый ТабличныйДокумент;
		ТаблДок.Вывести(ТабличныйДокументОтчета);
		ТаблДок.ОриентацияСтраницы = ТабличныйДокументОтчета.ОриентацияСтраницы;
		ТаблДок.АвтоМасштаб = ТабличныйДокументОтчета.АвтоМасштаб;
		ТаблДок.МасштабПечати = ТабличныйДокументОтчета.МасштабПечати;
		ПоместитьВоВременноеХранилище(ТаблДок,АдресТекущейСтраницы);
	КонецЕсли;
	
	Если ИдСтраницы = Неопределено Тогда
		//Автоматическое опеределение
		Если ЗначениеЗаполнено(АдресТекущейСтраницы) Тогда
			ДеревоС = РеквизитФормыВЗначение("ДеревоСтраниц");
			ТекСтраница = ДеревоС.Строки.Найти(АдресТекущейСтраницы,"АдресБланка",Истина)
		Иначе
			//Первую страницу
			ТекСтраница = ДеревоСтраниц.ПолучитьЭлементы()[0];
		КонецЕсли;
	Иначе	
		ТекСтраница = ДеревоСтраниц.НайтиПоИдентификатору(ИдСтраницы);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ТекСтраница.АдресБланка) Тогда
		
		СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(Объект.ШаблонОтчета,ТекСтраница.ИмяСтраницы);
		
		ТабДок = СтруктураСтраницы.Макет;
		ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		
		Если ТабДок=Неопределено Тогда	
			ТабДок = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
		
		ТекСтраница.АдресБланка = ПоместитьВоВременноеХранилище(ТабДок,ЭтотОбъект.УникальныйИдентификатор);
		ТекСтраница.АдресНастроек = ПоместитьВоВременноеХранилище(ТекНастройки,ЭтотОбъект.УникальныйИдентификатор);
		
	КонецЕсли;
	
	
	АдресТекущейСтраницы = ТекСтраница.АдресБланка;
	
	ВосстановитьОбъектОтчета();
			 
	ОтчетОбъект.мНастройкиБланка = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
		
	ЗаполнитьФильтрыПоЗначению();
	ЗаполнитьСвязиАналитикиКПС();
	
	ИнициализацияНастроекБланка();
	мИмяТекущейСтраницы = ТекСтраница.ИмяСтраницы;
	
	ВывестиСтраницуОтчета(ТекСтраница.АдресБланка,РежимРаскрытия);	
	
	ОбновитьКэшируемыеНастройкиОтчета();
	
	Если ПомещатьОтчет Тогда
		ПоместитьОбъектОтчета();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтраницуОтчета(Знач АдресБланка,Знач ВыводитьРаскрытиеВТеле = Неопределено)

	ВосстановитьОбъектОтчета();
	
	ТабличныйДокументОтчета.Очистить();
	ТабличныйДокументОтчета.КлючПараметровПечати = "";
	
	ТабДокумент = ПолучитьИзВременногоХранилища(АдресБланка);
	
	МассивПоказателейСтраницы = ПолучитьМассивПоказателейСтраницы(ОтчетОбъект);
	
	ОтчетОбъект.ЗаполнитьМакет(ТабДокумент,МассивПоказателейСтраницы);
	
	Если ВыводитьРаскрытиеВТеле = Неопределено Тогда // Авто
		РежимРаскрытия 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ШаблонОтчета,"РаскрытиеВМакете");
		ВыводитьРаскрытиеВТеле  = (РежимРаскрытия = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета);
	КонецЕсли;
		
	Если ВыводитьРаскрытиеВТеле Тогда
			
		Элементы.ПанельУправленияРаскрытием.Видимость 	  = Истина;
		Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка = Истина;
			
		Если ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабДокумент) Тогда
			
			Для Каждого СтрРаскрытия Из ОтчетОбъект.ТабОбластиРаскрытия Цикл
				
				//СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
				ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабДокумент);
				СтрРаскрытия.ТабДокРаскрытие.Очистить();
			КонецЦикла;
			
		Иначе
			
			Элементы.ПанельУправленияРаскрытием.Видимость 	  = Ложь;
			Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка = Ложь;
			
		КонецЕсли;
			
	Иначе
		
		Элементы.ПанельУправленияРаскрытием.Видимость 	  = Ложь;
		Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка = Ложь;
		
	КонецЕсли;
	
	ПрименитьНастройкуВыводаДлинныхСтрок(ТабДокумент,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);
	
	ТабличныйДокументОтчета.Вывести(ТабДокумент);	
	ПечатьРегламентированныхФорм.ПрименитьПользовательскиеНастройкиПечати(ОтчетОбъект.БланкОтчета, ТабличныйДокументОтчета, ТабДокумент, , мИмяТекущейСтраницы);
	ТабДокумент = Неопределено;
	
	Элементы.ТабличныйДокументОтчета.ТекущаяОбласть = ТабличныйДокументОтчета.Область(1,1);
КонецПроцедуры // ВывестиСтраницуОтчета()

&НаКлиенте
Функция НайтиТекущуюСтраницу(ЭлементыДерева)
	Для Каждого ТекЭлемент Из ЭлементыДерева Цикл
		Если ТекЭлемент.АдресБланка = АдресТекущейСтраницы Тогда
			Возврат ТекЭлемент;
		КонецЕсли;
		НайденнаяСтрока = НайтиТекущуюСтраницу(ТекЭлемент.ПолучитьЭлементы());
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ОпределитьСтраницуБланкаДляРасшифровки(КоллекцияСтрок,СтрПоказатель)
		
	Для Каждого ТекСтраница Из КоллекцияСтрок Цикл
		Если Не ЗначениеЗаполнено(ТекСтраница.АдресБланка) Тогда
		
			СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(Объект.ШаблонОтчета,ТекСтраница.ИмяСтраницы);
			
			ТабДок = СтруктураСтраницы.Макет;
			ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		Иначе
			ТабДок = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка);
			ТекНастройки = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
		КонецЕсли;
		
		Если ТабДок=Неопределено Тогда	
			ТабДок = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
			
		МассивПоказателей = Документы.УниверсальныйРегламентированныйОтчет.ПолучитьМассивПоказателейСтраницыПоНастройкам(ТекНастройки);
					
		ТекСтраница.АдресБланка = ПоместитьВоВременноеХранилище(ТабДок,ЭтотОбъект.УникальныйИдентификатор);
		ТекСтраница.АдресНастроек = ПоместитьВоВременноеХранилище(ТекНастройки,ЭтотОбъект.УникальныйИдентификатор);
		мИмяТекущейСтраницы = ТекСтраница.ИмяСтраницы;
		
		Если МассивПоказателей = Неопределено
			ИЛИ (ТипЗнч(МассивПоказателей) = Тип("Массив")
				И МассивПоказателей.Найти(СтрПоказатель.Код) <> Неопределено) Тогда
			АдресТекущейСтраницы = ТекСтраница.АдресБланка;
			ОтчетОбъект.мНастройкиБланка = ТекНастройки;
			//Нашли	страницу бланка в которой выводится искомый показатель
							
			Прервать;
		КонецЕсли;
					
		ОпределитьСтраницуБланкаДляРасшифровки(ТекСтраница.ПолучитьЭлементы(),СтрПоказатель);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(АдресТекущейСтраницы) Тогда
		
		ЗаполнитьФильтрыПоЗначению();
		ЗаполнитьСвязиАналитикиКПС();
		
		ИнициализацияНастроекБланка();
		
		ВывестиСтраницуОтчета(АдресТекущейСтраницы,Неопределено);
						
		ОбновитьКэшируемыеНастройкиОтчета();

	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(АдресТекущейСтраницы);
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаДополнительныхРеквизитов

&НаКлиенте
Процедура ТаблицаДополнительныхРеквизитовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = ТаблицаДополнительныхРеквизитов.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
	
	МассивПараметровВыбора = Новый Массив;
	
	Если ТекущаяСтрока.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
		
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ТекущаяСтрока.ВидАналитики));
		
		ПараметрыОтбораСубконто = Новый Структура;
		ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, ТекущаяСтрока.Код);
		
		Если ПараметрыОтбораСубконто.Свойство("Код") Тогда
			МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Код",ПараметрыОтбораСубконто.Код));
		КонецЕсли;

	ИначеЕсли ТекущаяСтрока.ТипЗначения.СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ")) Тогда
		
		ПараметрыОтбораСубконто = Новый Структура;
		ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, ТекущаяСтрока.Код);
		
		Если ПараметрыОтбораСубконто.Свойство("Код") Тогда
			МассивПараметровВыбора = Новый Массив;
			МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОтборПоПараметруБланка", ПараметрыОтбораСубконто.Код));
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтрока.ТипЗначения.СодержитТип(Тип("СправочникСсылка.КОСГУ")) Тогда	
		
		ПараметрыОтбораСубконто = Новый Структура;
		ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, ТекущаяСтрока.Код);
		
		Если ПараметрыОтбораСубконто.Свойство("Код") Тогда
			МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Код",ПараметрыОтбораСубконто.Код));
			МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОтборПоПараметруБланка", Истина));	
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ТаблицаДополнительныхРеквизитовЗначениеРеквизита.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	ОбработатьРедактированиеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДополнительныхРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТД = Элементы.ТаблицаДополнительныхРеквизитов.ТекущиеДанные;
		
	ПараметрыОбласти = ПолучитьПараметрыОбласти(ТД.Код);
	Если ПараметрыОбласти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбласти = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыОбласти);
	ИмяИсходнойОбласти = ТД.Код;
	ТекущееЗначение = ТД.Значение;
	Если ПараметрыОбласти.СценарийВвода <> Неопределено Тогда
		//т.к. в доп.реквизитах могут быть аналитики, которые используют сценарии ввода, например, ЦС и программа ЦС,
		//то используем открытие по сценарию, аналогично выбору аналитики в группе раскрытия
		Область = Новый Структура("Имя,Значение,Расшифровка",ТД.Код);
		ГруппаРаскрытия = Неопределено;
		ИдентификаторСтроки = Неопределено;
	
		ОткрытьФормуВыбораПоСценарию(ИмяИсходнойОбласти, ПараметрыОбласти, ТекущееЗначение, Область, ГруппаРаскрытия, ИдентификаторСтроки, СтандартнаяОбработка);

	ИначеЕсли ТД.ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.КВД")) Тогда 
		
		
		ПараметрыФормы = Новый Структура;
		ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, ТД.Код);
		Если ПараметрыФормы.Свойство("ОтборПоПараметруБланка") Тогда
			
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы.Вставить("ОповещатьОВыборе",Истина);
						
			ОткрытьФорму("ОбщаяФорма.ВыборКФО", ПараметрыФормы, Элемент, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ТД.ВидКлассификатораБК) Тогда
			Возврат;
		Иначе
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
		ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",Истина);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекущиеДанные", ТД);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметраВФорме",ЭтотОбъект,ДополнительныеПараметры);
		
		ОткрытьФорму(БюджетнаяОтчетностьКлиентСервер.ПолучитьИмяФормыВыбораБК(ТД.ВидКлассификатораБК), ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораПоСценарию(Знач ИмяИсходнойОбласти, Знач ПараметрыОбласти, Знач ТекущееЗначение, Область, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки, СтандартнаяОбработка = Истина)
	
	Перем ВидАналитики, ВозможноЭтоДоходы, ВозможноЭтоКИФ, ВозможноЭтоЦС, ДополнительныеПараметры, ИмяПроцедурыОбработкиВыбора, ИмяФормыВыбора, ОписаниеОповещения, ПараметрыФормы, СценарийВводаВидаДохода, СценарийВводаКИФ, СценарийВводаПП, СценарийВводаЦС, ТекОтбор, ЭКЛДоходов, ЭлКлассификацииРасходов, ЭлКлКИФ, ЭтоПЦСР;

	
	ВидАналитики = ПараметрыОбласти.ВидАналитики;
	
	ЭтоПЦСР = Ложь;
	// для устаревшей классификации расходов до 2014 года
	Если ЗначениеЗаполнено(ТекущееЗначение)
		И ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ") Тогда
		ЭтоПЦСР = Истина;
	КонецЕсли;
	
	ВозможноЭтоДоходы = Ложь;
	ЭКЛДоходов = 0;//элемент классификации - 1 - вид дохода, 2 - подвид, 3 - ан. група/КЭК
	Если ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.КОСГУ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ") Тогда
		ВозможноЭтоДоходы = Истина;
		ЭКЛДоходов = 3;
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.ГруппыПодвидовКДБ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ") Тогда
		ВозможноЭтоДоходы = Истина;
		ЭКЛДоходов = 2;
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.ВидыДоходовКДБ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ") Тогда
		ВозможноЭтоДоходы = Истина;
		ЭКЛДоходов = 1;
	КонецЕсли;
	
	ВозможноЭтоКИФ = Ложь;
	ЭлКлКИФ = 0;//элемент классификации - 1 - Группа , 2 - Статья, 3 - Подвид, 4 - ан. група/КЭК
	Если ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.КОСГУ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ") Тогда
		ВозможноЭтоКИФ = Истина;
		ЭлКлКИФ = 4;
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.ВидыКИФ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыКИФ") Тогда
		ВозможноЭтоКИФ = Истина;
		ЭлКлКИФ = 3;
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.СтатьиКИФ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.СтатьиКИФ") Тогда
		ВозможноЭтоКИФ = Истина;
		ЭлКлКИФ = 2;
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ")
		ИЛИ ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ") Тогда
		ВозможноЭтоКИФ = Истина;
		ЭлКлКИФ = 1;
	КонецЕсли;
	
	ВозможноЭтоЦС = Ложь;
	ЭлКлассификацииРасходов = 0;
	//элемент классификации - 1 - ЦС, 2 - Программа
	//только если строковая аналитика - будем искать строку по коду
	Если ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ") Тогда
		ВозможноЭтоЦС = Истина;
		ЭлКлассификацииРасходов = 1;
	ИначеЕсли ПараметрыОбласти.ВидКлассификатораБК = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ") Тогда
		ВозможноЭтоЦС = Истина;
		ЭлКлассификацииРасходов = 2;
	КонецЕсли;	
	
	СценарийВводаПП = Неопределено;
	СценарийВводаВидаДохода = Неопределено;
	СценарийВводаЦС = Неопределено;
	СценарийВводаКИФ = Неопределено;
	
	Если ЭтоПЦСР Тогда
		СценарийВводаПП = ПодготовитьВыборПрограммыЦС(ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки); 
	ИначеЕсли ВозможноЭтоДоходы Тогда
		СценарийВводаВидаДохода = ПодготовитьВыборВидаДохода(ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭКЛДоходов);			
	ИначеЕсли ВозможноЭтоЦС Тогда
		СценарийВводаЦС = ПодготовитьВыборПоЦС(ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭлКлассификацииРасходов);			
	КонецЕсли;			
	
	Если СценарийВводаВидаДохода = Неопределено
		И ВозможноЭтоКИФ Тогда
		СценарийВводаКИФ = ПодготовитьВыборКИФ(ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭлКлКИФ);
	КонецЕсли;
	
	Если СценарийВводаПП <> Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДополнительныйОтбор",СценарийВводаПП.СценарийВвода.ФиксированныйОтбор);
		ПараметрыФормы.Вставить("ТекущаяСтрока"		 ,СценарийВводаПП.ТекущееЗначение);
		ПараметрыФормы.Вставить("РежимВыбора"		 ,Истина);
		
		ИмяФормыВыбора = СценарийВводаПП.СценарийВвода.ФормаВыбора;
		
	ИначеЕсли СценарийВводаЦС <> Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДополнительныйОтбор",СценарийВводаЦС.СценарийВвода.ФиксированныйОтбор);
		ПараметрыФормы.Вставить("ТекущаяСтрока"		 ,СценарийВводаЦС.ТекущееЗначение);
		ПараметрыФормы.Вставить("РежимВыбора"		 ,Истина);
		
		ИмяФормыВыбора = СценарийВводаЦС.СценарийВвода.ФормаВыбора;
		
	ИначеЕсли СценарийВводаВидаДохода <> Неопределено Тогда
		
		ПараметрыОбласти.СценарийВвода = СценарийВводаВидаДохода.СценарийВвода;
		
		ПараметрыФормы = Новый Структура;
		ТекОтбор = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СценарийВводаВидаДохода.СценарийВвода.ФиксированныйОтбор);
		ТекОтбор.Вставить("ВидДохода",СценарийВводаВидаДохода.ТекущееЗначение);
		
		ПараметрыФормы.Вставить("ТекущаяСтрока",СценарийВводаВидаДохода.ТекущееЗначение);
		
		ПараметрыФормы.Вставить("ДополнительныйОтбор",ТекОтбор);
		
		ПараметрыФормы.Вставить("РежимВыбора"		 ,Истина);	 
		
		ИмяФормыВыбора = СценарийВводаВидаДохода.СценарийВвода.ФормаВыбора;
		
		Если ИмяФормыВыбора = "Справочник.КОСГУ.ФормаВыбора" Тогда
			ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, ИмяИсходнойОбласти);
		КонецЕсли;					
		
	ИначеЕсли СценарийВводаКИФ <> Неопределено Тогда
		
		ПараметрыОбласти.СценарийВвода = СценарийВводаКИФ.СценарийВвода;
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("ТекущаяСтрока",СценарийВводаКИФ.ТекущееЗначение);
		
		ПараметрыФормы.Вставить("РежимВыбора"		 ,Истина);	 
		
		ИмяФормыВыбора = СценарийВводаКИФ.СценарийВвода.ФормаВыбора;
		
		Если ИмяФормыВыбора = "Справочник.КОСГУ.ФормаВыбора" Тогда
			ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, ИмяИсходнойОбласти);
		КонецЕсли;
		
	Иначе 
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекущееЗначение",ТекущееЗначение);
		ДополнительныеПараметры.Вставить("ВидАналитики",ПараметрыОбласти.ВидАналитики);
		ДополнительныеПараметры.Вставить("ИдентификаторСтроки",ИдентификаторСтроки);
		ДополнительныеПараметры.Вставить("СценарийВвода",ПараметрыОбласти.СценарийВвода);
		
		
		ПараметрыФормы = БюджетнаяОтчетностьКлиент.СформироватьПараметрыВыбораПоСценарию(ДополнительныеПараметры, ТабличныйДокументОтчета, ГруппаРаскрытия, ЭтаФорма);
		
		ИмяФормыВыбора = ПараметрыОбласти.СценарийВвода.ФормаВыбора;
		
	КонецЕсли;
	
	Если ПараметрыОбласти.СценарийВвода.Свойство("ВидАналитикиСценария") Тогда
		ПараметрыОбласти.ВидАналитики = ПараметрыОбласти.СценарийВвода.ВидАналитикиСценария;
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура;


	
	Если ПараметрыОбласти.СценарийВвода.ЕстьСвязиВыбора Тогда
		ИмяПроцедурыОбработкиВыбора = "ПослеВыбораЗначенияПоСценариюВвода";
		
		ДополнительныеПараметры.Вставить("ГруппаРаскрытия",ПараметрыОбласти.ГруппаРаскрытия);
		ДополнительныеПараметры.Вставить("ВидАналитики",ПараметрыОбласти.ВидАналитики);
		ДополнительныеПараметры.Вставить("Идентификатор",ИдентификаторСтроки);
	Иначе 
		ИмяПроцедурыОбработкиВыбора = "ПослеВыбораОбычногоЗначения";
		
		ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
		
		ДополнительныеПараметры.Вставить("Область",Область);
		ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
	КонецЕсли; 
	
	Если ТипЗнч(ТекущееЗначение) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыФормы.Вставить("ОтборПоВидуКонтрагента",ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо"));
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
	ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
	
	ОписаниеОповещения = Новый ОписаниеОповещения(ИмяПроцедурыОбработкиВыбора,ЭтотОбъект,ДополнительныеПараметры);
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДополнительныхРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТД = Элементы.ТаблицаДополнительныхРеквизитов.ТекущиеДанные;
	ИзмененныеОбласти.Вставить(ТД.Код, ?(ЗначениеЗаполнено(ТД.ВидКлассификатораБК), СокрЛП(ТД.Значение), ТД.Значение));
	СинхронизироватьКонтекстНовыйВариант();
КонецПроцедуры


#КонецОбласти

