// Инициализирует новый объект по виду отчета
//
&НаСервере
Функция ИнициализироватьПоВидуОтчета(ВидОтчета)

	ОтчетОбъект 			= РеквизитФормыВЗначение("Объект");
	ОтчетОбъект.ВидОтчета 	= ВидОтчета;
	Объект.ВидОтчета		= ВидОтчета;
	
	Если Параметры.Свойство("ЗначениеКопирования") и ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОтчетОбъект.мДокументОснование = Параметры.ЗначениеКопирования;
		ОтчетОбъект.мКопирование       = Истина;
	КонецЕсли;
	
	Если Не ОтчетОбъект.ЗаполнитьНастройкиОтчета() Тогда
		
		ШаблонСообщения = НСтр("ru = 'Для отчета %1
                                |не удается определить бланк и набор используемых правил!
                                |Проверьте настройки отчета.'");
		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,ОтчетОбъект.ВернутьПредставлениеЭкземпляраОтчета());
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтчетОбъект.ОсновнойПечатныйБланк) И НЕ ЗначениеЗаполнено(Объект.ОсновнойПечатныйБланк) Тогда
		Объект.ОсновнойПечатныйБланк = ОтчетОбъект.ОсновнойПечатныйБланк;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтчетОбъект.ШаблонОтчета) Тогда
		УстановитьРеквизитыИзШаблонаОтчета();
		ВыполнитьОбщуюИнициализациюФормы(ОтчетОбъект);
	Иначе
		ВыполнитьОбщуюИнициализациюФормы(ОтчетОбъект);
		Возврат Ложь;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
		ОбновитьФиксированныеПараметрыОрганизации();
	КонецЕсли;
	
	ОбновитьПараметрИсполнитель();
	
	// Установка начального состояния.
	ОтчетОбъект.Состояние = Перечисления.СостоянияОтчетов.Запланирован;
	
	УстановитьРежимРедактированияФормыСервер(Истина,Ложь);
	ВывестиДанныеОтчета();
	
	// Первичное помещение объекта в хранилище.
	АдресОбъектаОтчет = ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,УникальныйИдентификатор);
	
	ЗначениеВРеквизитФормы(ОтчетОбъект,"Объект");
	
	Возврат Истина;

КонецФункции // ИнициализироватьПоВидуОтчета()

&НаСервере
Процедура ЗаполнитьФильтрыПоЗначению()
	
	ОтборФильтрПоЗначению = Новый Структура("ЕстьФильтрПоЗначению",Истина);
	СтрокиФильтр = ОтчетОбъект.мНастройкиБланка.НайтиСтроки(ОтборФильтрПоЗначению);
	Для Каждого СтрФильтр Из СтрокиФильтр Цикл
		НайденныеСтроки = ТаблицаФильтровПоЗначению.НайтиСтроки(Новый Структура("ИмяЯчейки",СтрФильтр.ИмяЯчейки));
		Если НайденныеСтроки.Количество()>0 Тогда
			СтрТаблицы = НайденныеСтроки[0];	
		Иначе
			СтрТаблицы = ТаблицаФильтровПоЗначению.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТаблицы,СтрФильтр,"ИмяЯчейки");
		КонецЕсли;
		
		СтрТаблицы.ТаблицаКодов.ЗагрузитьЗначения(СтрФильтр.СтруктураНастроек.ФильтрПоЗначению.ВыгрузитьКолонку("КодЭлемента"));
	КонецЦикла;
	АдресПараметрыОтборПоКоду = ПоместитьВоВременноеХранилище(ТаблицаФильтровПоЗначению.Выгрузить(),УникальныйИдентификатор);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСвязиАналитикиКПС()
	
	ОтборВыборИзКПС = Новый Структура("ЕстьВыборИзКПС",Истина);
	СтрокиВыборИзКПС = ОтчетОбъект.мНастройкиБланка.НайтиСтроки(ОтборВыборИзКПС);
	
	ЕстьВыборИзКПС = СтрокиВыборИзКПС.Количество() > 0;
	
	Элементы.ВыборИзКПС.Видимость = ЕстьВыборИзКПС;
	Если ЕстьВыборИзКПС Тогда
		
		Для Каждого СтрВыборИзКПС Из СтрокиВыборИзКПС Цикл
			ПараметрыВыбораИзКПС = СтрВыборИзКПС.СтруктураНастроек.ВыборИзКПС;
			
			СтрТаблицы = ТаблицаВыборИзКПС.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТаблицы,ПараметрыВыбораИзКПС,"ВидПоказателя");
			СтрТаблицы.ИмяРеквизитаКПС	= ПараметрыВыбораИзКПС.ВыборИзКПС;
			
			ИмяЯчейки = СокрЛП(СтрВыборИзКПС.ИмяЯчейки);
			СтрТаблицы.ИмяЯчейки = ИмяЯчейки;
			ПозицияАналитики = Найти(ИмяЯчейки, "_Аналитика");
			Если ПозицияАналитики > 0 Тогда
				СтрТаблицы.ИмяСтрокиОтчета = Лев(ИмяЯчейки, ПозицияАналитики-1);
				ИмяОбъектаАналитики = Сред(ИмяЯчейки, ПозицияАналитики+1);
				ПозицияДополнения = Найти(ИмяОбъектаАналитики, "_");
				СтрТаблицы.ИмяОбъектаАналитики = ?(ПозицияДополнения = 0, ИмяОбъектаАналитики, Лев(ИмяОбъектаАналитики, ПозицияДополнения-1));
			КонецЕсли;	
			
		КонецЦикла;
		АдресПараметрыВыборИзКПС = ПоместитьВоВременноеХранилище(ТаблицаВыборИзКПС.Выгрузить(),УникальныйИдентификатор);
	КонецЕсли;	
	
	ТаблицаВыборИзКПС.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОтчет(ОтчетОбъект)

	ОтчетОбъект.РежимДиалога = Истина;
	ОтчетОбъект.ПроверитьКонтекстИнициализирован();
	
	Элементы.ДеревоСтраниц.Отображение = СпособОтображенияПоУровням(ОтчетОбъект.мДеревоСтраниц);
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мДеревоСтраниц,"ДеревоСтраниц");
	
	//если всего 1 страница в бланке, то не отображаем панель со страницами
	КоличествоСтраниц = 0;
	Для Каждого ТекСтр Из ОтчетОбъект.мДеревоСтраниц.Строки Цикл
		КоличествоСтраниц = КоличествоСтраниц + 1 + ТекСтр.Строки.Количество();
		Если КоличествоСтраниц>1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоСтраниц=1 Тогда
		Элементы.ГруппаСтраницы.Видимость = Ложь;
	Иначе
		Элементы.ГруппаСтраницы.Видимость = Истина;
	КонецЕсли;
	
	ЗаполнитьФильтрыПоЗначению();
	ЗаполнитьСвязиАналитикиКПС();
	
	Элементы.ТаблицаДополнительныхРеквизитов.Видимость = ОтчетОбъект.мДополнительныеРеквизиты.Количество() > 0;
	Для Каждого СтрДопРеквизит Из ОтчетОбъект.мДополнительныеРеквизиты Цикл
		СтрТаблицы = ТаблицаДополнительныхРеквизитов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТаблицы,СтрДопРеквизит);
	КонецЦикла;
	
	Элементы.ПараметрыОтчета.Видимость = ОтчетОбъект.ПараметрыОтчета.Количество()> 0;
	
	УстановитьЗаголовокФормы();
	
	ОбновитьКнопкиПечати();
	
	ЗаписанноеСостояниеОтчета = ОтчетОбъект.Состояние;
	
	Если БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().МакетыОтображения Тогда 	
		ИспользоватьМакет = ОбщегоНазначения.ОбщийМодуль("МакетыОтображенияПовтИсп").ИспользоватьМакетОтображения() И Параметры.ОткрытьБланк = Ложь;
		УстановитьРежимОтображенияДанных(ИспользоватьМакет);
		
	Иначе 
		Элементы.ФормаПереключитьРежимОтображения.Видимость = Ложь;
		УстановитьРежимОтображенияДанных(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры // СохранитьВоВременномХранилищеНастройкиОтчета()

// Подгототавливает объект к сериализации, помещает таблицы во временное хранилище.
//
&НаСервереБезКонтекста
Функция ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,АдресОбъекта = Неопределено)

	СтруктураТаблиц = ОтчетОбъект.ПолучитьВнутренниеСвойства();
	Если АдресОбъекта = Неопределено Тогда
		АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц);
	Иначе
		АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц,АдресОбъекта);
	КонецЕсли;

	Возврат АдресХранилища;
	
КонецФункции // ПоместитьВнутренниеТаблицыВоВременноеХранилище()

// Устанавливает реквизиты ЕдиницаИзмерения и УровеньТочности
//
&НаСервере
Процедура УстановитьРеквизитыИзШаблонаОтчета()

	РеквизитыШаблона             = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетОбъект.ШаблонОтчета,"ЕдиницаИзмеренияПоУмолчанию,УровеньТочностиПоУмолчанию");
	ОтчетОбъект.ЕдиницаИзмерения = РеквизитыШаблона.ЕдиницаИзмеренияПоУмолчанию;
	ОтчетОбъект.УровеньТочности  = РеквизитыШаблона.УровеньТочностиПоУмолчанию;

КонецПроцедуры // УстановитьРеквизитыИзШаблонаОтчета()

&НаСервере
Процедура ОбновитьКэшируемыеНастройкиОтчета()

	КэшируемыеНастройкиОтчета = Новый Структура;
	Если ОтображатьВВидеТаблицыФормы Тогда
		МакетОтображения = МакетыОтображения.СоздатьМакетОтображения(ОтчетОбъект.ВидОтчета);
		КэшируемыеНастройкиОтчета.Вставить("МакетОтображения", МакетОтображения);
		мМакетОтображенияВТаблице = МакетОтображения;
	Иначе
		КэшируемыеНастройкиОтчета.Вставить("БланкОтчета"	,ОтчетОбъект.БланкОтчета);
	КонецЕсли;
	КэшируемыеНастройкиОтчета.Вставить("НастройкиБланка",ОтчетОбъект.мНастройкиБланка);
	
	Если ЭтоАдресВременногоХранилища(АдресНастроекОтчета) Тогда
		УдалитьИзВременногоХранилища(АдресНастроекОтчета);
	КонецЕсли;
	
	АдресНастроекОтчета = ПоместитьВоВременноеХранилище(КэшируемыеНастройкиОтчета,УникальныйИдентификатор);

КонецПроцедуры

// Полная очистка отчета.
//
&НаСервере
Процедура ОчиститьОтчет(УстанавливатьНачальноеСостояниеОтчета = Истина)

	ВосстановитьОбъектОтчета();	
	
	ОтчетОбъект.ОчиститьВсе();
	Если УстанавливатьНачальноеСостояниеОтчета Тогда
		ОтчетОбъект.УстановитьСостояниеОтчета(Перечисления.СостоянияОтчетов.Запланирован);	
		Объект.Состояние = ОтчетОбъект.Состояние;
	КонецЕсли;
	
	АдресТаблицыРасшифровки = Неопределено;
	АдресРезультатаЗаполнения = Неопределено;
	Элементы.ФормаСравнитьСДаннымиЗаполнения.Доступность = Ложь;
	
	ВывестиДанныеОтчета();
	ПоместитьОбъектОтчета();

КонецПроцедуры // ОчиститьОтчет()

// Полный пересчет и обновление показателей.
//
&НаСервере
Процедура ПересчитатьВсеДанныеСервер()

	СинхронизироватьКонтекстСервер(Ложь);
	ОтчетОбъект.РассчитатьВычисляемыеПоказатели();
	ВывестиДанныеОтчета(Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
	ПоместитьОбъектОтчета();

КонецПроцедуры // ПересчитатьВсеДанныеСервер()

&НаСервере
Процедура ПрименитьНастройкуСписка(Знач КодСтроки, Знач АдресВременногоХранилищаНастройки, Знач ИмяТаблицыФормы = Неопределено)

	СинхронизироватьКонтекстСервер(Ложь, Ложь);
		
	СтрокаРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
	
	Если АдресВременногоХранилищаНастройки = Неопределено Тогда
		СтрокаРаскрытия.ОтборПоРаскрытию = Новый Структура;
	Иначе
		Результат = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаНастройки);
		СтрокаРаскрытия.РучнаяСортировка = Результат.РучнаяСортировка;
		СтрокаРаскрытия.ПоляСортировки = Результат.Сортировка.Скопировать();
		
		СтруктураОтбора = Новый Структура;
		Для Каждого ПолеОтбора Из Результат.Отбор Цикл
			СтруктураЗначения = Новый Структура;
			СтруктураЗначения.Вставить("ВидСравнения",ПолеОтбора.ВидСравнения);
			СтруктураЗначения.Вставить("Значение"	 ,ПолеОтбора.Значение);
			
			СтруктураОтбора.Вставить(ПолеОтбора.ИмяПоля, СтруктураЗначения);
			
		КонецЦикла;
		
		СтрокаРаскрытия.ОтборПоРаскрытию = СтруктураОтбора;
	КонецЕсли;
	
	Если СтрокаРаскрытия.ПоляСортировки <> Неопределено
		И СтрокаРаскрытия.ПоляСортировки.Количество() 
		И СтрокаРаскрытия.РучнаяСортировка <> Истина Тогда
		СортироватьТаблицуРаскрытия(СтрокаРаскрытия);
		ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрокаРаскрытия.ГруппаРаскрытия, СтрокаРаскрытия.ТаблицаРаскрытия, Ложь);		
	КонецЕсли;
			
	Если ОтображатьВВидеТаблицыФормы Тогда
		ВывестиОтчетВТаблице();
		УстановитьФильтрВТаблицеФормы(СтрокаРаскрытия, Элементы[ИмяТаблицыФормы].ПутьКДанным);
	Иначе
		УстановитьФильтрВТабличномДокументе(СтрокаРаскрытия);
	КонецЕсли;
	
	ПоместитьОбъектОтчета();
	
	//Если форма в режиме только просмотр, то и изменения порядка записывать не будем
	Если НЕ ЭтаФорма.ТолькоПросмотр Тогда		
		Модифицированность = Истина; 
	КонецЕсли;
	
КонецПроцедуры // ПрименитьНастройкуСписка()

//////////////////////////////////////////////////////////////////////
// Передача изменений в контекст отчета при синхронизации


// При отображении в табличном документе

&НаСервере
Процедура ПрименитьИзмененияТабличногоДокументаНаСервере()
 
	ИзмененыПараметры 		= Ложь;
	ИзмененыДопРеквизиты	= Ложь;
	
	ИзмененныеТаблицыРаскрытия = Новый Соответствие;
	ИзмененныеПоказатели	   = Новый Соответствие;
	
	// Синхронизация значений областей.
	Для Каждого ИзмененнаяОбласть Из ИзмененныеОбласти Цикл
		
		ИмяОбласти      = ИзмененнаяОбласть.Ключ;
		НовоеЗначение   = ИзмененнаяОбласть.Значение;
		
		ВидОбласти = ПолучитьВидИсточникаДанныхОбластиБезКонтекста(ИмяОбласти,ОтчетОбъект);
		
		Если ВидОбласти = 0 Тогда
			
			ПоказательОбласти = ОтчетОбъект.мПоказатели.Найти(ИмяОбласти,"Код");
			
			Если НовоеЗначение = Неопределено Тогда
				НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(ПоказательОбласти.ТипЗначения).ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ВведенноеЗначение = НовоеЗначение;
			
			Если ПоказательОбласти.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				
				Если НЕ ПоказательОбласти.НеМасштабируется Тогда
					ВведенноеЗначение = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				КонецЕсли;
				
				ПоказательОбласти.Значение = ВведенноеЗначение;
				
			Иначе
				ПоказательОбласти.Значение = НовоеЗначение;
			КонецЕсли;
			
			ПоказательОбласти.ДанныеРасчета 			 = Неопределено;
			ПоказательОбласти.СохраненныеДанныеАктуальны = Ложь;
	
			ОтчетОбъект.Показатели[ПоказательОбласти.Код] 			= ВведенноеЗначение;
			ОтчетОбъект.ИзмененныеПоказатели[ПоказательОбласти.Код]	= Истина;
			
			ИзмененныеПоказатели.Вставить(ПоказательОбласти.Код,Истина);
			
		ИначеЕсли ВидОбласти = 1 Тогда
			
			ОтчетОбъект[ИмяОбласти] = НовоеЗначение;
			ИзмененыПараметры		= Истина;
			
		ИначеЕсли ВидОбласти = 2 Тогда
			
			СтрПараметр = ОтчетОбъект.ПараметрыОтчета.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = НовоеЗначение;
			КонецЕсли;
			
			ИзмененыПараметры = Истина;
			
		ИначеЕсли ВидОбласти = 3 Тогда
			
			СтрПараметр = ОтчетОбъект.мДополнительныеРеквизиты.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = СтрПараметр.ТипЗначения.ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ИзмененыДопРеквизиты = Истина;
			
		ИначеЕсли ВидОбласти = 4 ИЛИ ВидОбласти = 5 Тогда
			
			РеквизитыИмени = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
			ЭлементыКода   = СтрРазделить(РеквизитыИмени.ИмяИсходнойОбласти,"_",Ложь);
			
			КодГруппы = ЭлементыКода[0];
			КодСтроки = ЭлементыКода[1];
			
			СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
			Если СтрРаскрытия = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока = СтрРаскрытия.ТаблицаРаскрытия.Найти(РеквизитыИмени.Идентификатор,"ID");
			Если ТекСтрока = Неопределено Тогда
				Продолжить; // Строка отсутствует в данных, возможно, она удалена.
			КонецЕсли;
			
			// Разбор составляющих имени области.
			ПрефиксИмениОбласти = КодГруппы + "_" + КодСтроки + "_";
			ПотенциальныйКодПоказателя = Сред(РеквизитыИмени.ИмяИсходнойОбласти, СтрДлина(ПрефиксИмениОбласти + "Показатель_") + 1);
			
			ЭтоОбластьПоказателя = ЭлементыКода.Количество() > 4 И ЭлементыКода[2] = "Показатель"
								   И СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти(ПотенциальныйКодПоказателя) <> Неопределено;
								   
			ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
			
			Если Не ЭтоОбластьПоказателя Тогда
				
				Для НомерАналитики = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
					Префикс = ПрефиксИмениОбласти + "Аналитика" + НомерАналитики + "_";
					Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено И Лев(ИмяОбласти, СтрДлина(Префикс)) = Префикс Тогда // это область реквизита одной из аналитик
						ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			ИмяКолонки = ?(ЭтоОбластьПоказателя,ПотенциальныйКодПоказателя,"Аналитика" + НомерАналитики);
			Если ЭтоОбластьПоказателя Тогда
				
				СтрПок = ОтчетОбъект.мПоказатели.Найти(ИмяКолонки,"Код");
				
				Если НовоеЗначение = Неопределено Тогда
					НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрПок.ТипЗначения).ПривестиЗначение(НовоеЗначение);
				КонецЕсли;
				
				Если СтрПок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число и Не СтрПок.НеМасштабируется Тогда
					ЗначениеКолонки = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				Иначе
					ЗначениеКолонки = НовоеЗначение;
				КонецЕсли;
				
				ТекСтрока[ИмяКолонки]                = ЗначениеКолонки;
				ТекСтрока[ИмяКолонки+"_Отображение"] = НовоеЗначение;
			Иначе
				ТекСтрока[ИмяКолонки] = НовоеЗначение;
			КонецЕсли;
			
			ИнформацияИзмененнойТаблицы = ИзмененныеТаблицыРаскрытия[СтрРаскрытия];
			Если ИнформацияИзмененнойТаблицы = Неопределено Тогда
				ИнформацияИзмененнойТаблицы = Новый Структура;
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеКолонки",Новый Массив);
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеСтроки"	,Новый Массив);
				
				ИзмененныеТаблицыРаскрытия[СтрРаскрытия] = ИнформацияИзмененнойТаблицы;
				
			КонецЕсли;
			
			ИнформацияИзмененнойТаблицы.ИзмененныеКолонки.Добавить(ИмяКолонки);
			Если ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
				ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Добавить(ТекСтрока);
			КонецЕсли;
			
			ИзмененныеПоказатели.Вставить(ИмяКолонки,Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Перенос изменений параметров и доп. реквизитов.
	Если ИзмененыПараметры или ИзмененыДопРеквизиты Тогда
		
		ОтчетОбъект.СформироватьСтруктуруПараметров(); // Синхронизация структуры параметров и реквизитов объекта.
		ОтчетОбъект.СформироватьСтруктуруДополнительныхРеквизитов();
		
	КонецЕсли;
	
	Если ИзмененныеПоказатели.Количество() > 0 Тогда
		
		МассивПоказателей = Новый Массив;
		Для Каждого Запись Из ИзмененныеПоказатели Цикл
			МассивПоказателей.Добавить(Запись.Ключ);
		КонецЦикла;
		
		ЗависимыеПоказатели  = ПолучитьЗависимыеПоказателиБезКонтекста(МассивПоказателей,ОтчетОбъект);
		ИзмененныеПоказатели = Неопределено;
		
		// Перенос изменений раскрытия в данные отчета.
		Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
			
			СтрРаскрытия = Запись.Ключ;
			Информация   = Запись.Значение;
			
			ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,Информация.ИзмененныеСтроки,Информация.ИзмененныеКолонки);
			Если ЗависимыеПоказатели.Количество() = 0 Тогда
				ОтчетОбъект.УстановитьИтогиПоПоказателям(Информация.ИзмененныеКолонки);
				ОтразитьИзмененныеСтрокиВМакетеРаскрытия(СтрРаскрытия,Информация.ИзмененныеСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		// Отрисовка изменений в бланке отчета.
		Если ЗависимыеПоказатели.Количество() > 0 Тогда	
			
			// Выполнение пересчета.
			ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,МассивПоказателей,ЗависимыеПоказатели);
			
			Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
				
				СтрРаскрытия = Запись.Ключ;
				Информация   = Запись.Значение;
				
				НоваяТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
				МассивСтрок           = Новый Массив;
				
				Для Каждого ИзмСтрока Из Информация.ИзмененныеСтроки Цикл
					НомерСтроки = СтрРаскрытия.ТаблицаРаскрытия.Индекс(ИзмСтрока);
					МассивСтрок.Добавить(НоваяТаблицаРаскрытия[НомерСтроки]);
				КонецЦикла;
				
				СтрРаскрытия.ТаблицаРаскрытия = НоваяТаблицаРаскрытия;
				
				ОтразитьИзмененныеСтрокиВМакетеРаскрытия(СтрРаскрытия,МассивСтрок);
				
			КонецЦикла;
			
		КонецЕсли;
		
		МассивПоказателейСтраницы = ПолучитьМассивПоказателейСтраницы(ОтчетОбъект);
		
		ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета,МассивПоказателейСтраницы);
		
	КонецЕсли;
	
	//Пересчет ячеек с представлением
	ОтчетОбъект.ЗаполнитьРеквизитыВМакете(ТабличныйДокументОтчета);
	
	ИзмененныеОбласти.Очистить();
	
КонецПроцедуры // ПрименитьИзмененияОбъектаНаСервере()

&НаСервере
Процедура ОтразитьИзмененныеСтрокиВМакетеРаскрытия(СтрРаскрытия, Знач ИзмененныеСтроки)

	Обл = ТабличныйДокументОтчета.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыГруппы 	= ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	КодГруппыРаскрытия 	= СокрП(ПараметрыГруппы.КодГруппыРаскрытия);
	МакетыРаскрытия 	= ОтчетОбъект.ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	Если МакетыРаскрытия = Неопределено или МакетыРаскрытия.Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИзмененныеСтроки) = Тип("СтрокаТаблицыЗначений") Тогда
		Стр = ИзмененныеСтроки;
		ИзмененныеСтроки = Новый Массив;
		ИзмененныеСтроки.Добавить(Стр);
	КонецЕсли;
	
	ВысотаШапки = ?(МакетыРаскрытия.Шапка = Неопределено, 0, МакетыРаскрытия.Шапка.ВысотаТаблицы);
	МакетыРаскрытия.Шапка  = Неопределено; // Запрет генерации макета шапки;
	
	ВысотаМакетаСтроки     = МакетыРаскрытия.Строка.ВысотаТаблицы;
	НачалоОбластиРаскрытия = Обл.Низ + 1;
	
	// Запись данных раскрытия после пересчета.
	ПолнаяТаблицаРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	// Генерация измененных макетов.
	ТаблицаИзмененныхСтрок = СтрРаскрытия.ТаблицаРаскрытия.Скопировать(ИзмененныеСтроки);
	ТаблицаИзмененныхСтрок.Сортировать("ID");
	МакетИзмененныхСтрок   = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,ТаблицаИзмененныхСтрок,,СтрРаскрытия.КодСтроки,МакетыРаскрытия);
	
	ПрименитьНастройкуВыводаДлинныхСтрок(МакетИзмененныхСтрок,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);
	
	//Если в форме задан отбор для строк раскрытия (интерактивно или при расшифровке),
	//то в форме выводятся не все строки раскрытия.
	//Чтобы определить, какую строку таб.дока надо заменить, нужно найти область, 
	//у которой Идентификатор = ID, и вот эта строка - это нужная для актуализации строка.
	
	НомерСтрокиИскомойОбласти = НачалоОбластиРаскрытия;
	
	ИскомаяСтрока = "_" + СтрРаскрытия.КодСтроки;
		
	НомерКолонки = Обл.Лево;
	
	Для Кол = Обл.Лево По ТабличныйДокументОтчета.ШиринаТаблицы Цикл

		ИмяОбласти = ТабличныйДокументОтчета.Область(НомерСтрокиИскомойОбласти,Кол).Имя;

		Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")>0
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")>0  Тогда
			НомерКолонки = Кол;
			Прервать;
		КонецЕсли;
				
	КонецЦикла;
	
	НомерСтрокиИскомойОбластиЭталон = НомерСтрокиИскомойОбласти;
	
	СчетчикСтрок = 1;
	Для Каждого СтрТаблицы Из ТаблицаИзмененныхСтрок Цикл
		СтрокаID = "_"+Формат(СтрТаблицы.ID,"ЧН=0; ЧГ=0");
		Пока НомерСтрокиИскомойОбласти<=СтрРаскрытия.ВысотаТабДокРаскрытия+НомерСтрокиИскомойОбласти Цикл
		
			ИмяОбласти = ТабличныйДокументОтчета.Область(НомерСтрокиИскомойОбласти,НомерКолонки).Имя;
			
			Если СтрЗаканчиваетсяНа(ИмяОбласти, СтрокаID) Тогда
				
				Прервать;
						
			Иначе
				НомерСтрокиИскомойОбласти=НомерСтрокиИскомойОбласти+1;				
				
			КонецЕсли;
			
		КонецЦикла;		
		
		КоординатаВерх = НомерСтрокиИскомойОбласти;//НачалоОбластиРаскрытия + ВысотаШапки + СтрТаблицы.Индекс * ВысотаМакетаСтроки - ВысотаМакетаСтроки;
		КоординатаНиз  = КоординатаВерх + ВысотаМакетаСтроки-1;
		
		КоординатаВерхНов = 1 + СчетчикСтрок * ВысотаМакетаСтроки - ВысотаМакетаСтроки;
		КоординатаНизНов = КоординатаВерхНов + ВысотаМакетаСтроки-1;
		
		ОбластьНовыхДанных  = МакетИзмененныхСтрок.Область(КоординатаВерхНов,,КоординатаНизНов);
		ОбластьСтарыхДанных = ТабличныйДокументОтчета.Область(КоординатаВерх,,КоординатаНиз);
		
		ТабличныйДокументОтчета.ВставитьОбласть(ОбластьНовыхДанных,ОбластьСтарыхДанных);
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
	КонецЦикла;
	
	// Запомним макет раскрытия.
	СтрРаскрытия.ТабДокРаскрытие = ТабличныйДокументОтчета.ПолучитьОбласть(НачалоОбластиРаскрытия,,НачалоОбластиРаскрытия+СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы-1);
	//тут не запоминаем высоту СтрРаскрытия.ВысотаТабДокРаскрытия, т.к. в таблице раскрытия только измененные строки
	
КонецПроцедуры // ОтразитьИзмененныеСтрокиВМакетеРаскрытия()

&НаСервере
Процедура ОтобразитьИзмененияТаблицыРаскрытия(КоординатыТаблицыРаскрытия)

	ВосстановитьОбъектОтчета();
	
	Данные = ПолучитьИзВременногоХранилища(КоординатыТаблицыРаскрытия.АдресДанныхРаскрытия);
	
	СтрРаскрытия 				  = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КоординатыТаблицыРаскрытия.КодСтроки,"КодСтроки");
	СтрРаскрытия.ТаблицаРаскрытия = Данные.ТаблицаРаскрытия;
	
	ПараметрыГруппы = ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки",СтрРаскрытия.КодСтроки))[0];	
	КодГруппыРаскрытия = ПараметрыГруппы.КодГруппыРаскрытия;
	
	ВходящиеПараметры = Новый Структура;
	ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
	ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);

	ПересчитатьИОтобразитьСтрокуРаскрытия(ОтчетОбъект,ТабличныйДокументОтчета,СтрРаскрытия,КодГруппыРаскрытия,ВходящиеПараметры);
	
	ПоместитьОбъектОтчета();

КонецПроцедуры // ОтобразитьИзмененияТаблицыРаскрытия()

&НаСервереБезКонтекста
Процедура ПересчитатьИОтобразитьСтрокуРаскрытия(ОтчетОбъект,ТабличныйДокументОтчета,СтрРаскрытия,КодГруппыРаскрытия,ВходящиеПараметры)

	ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,Ложь);
	
	ПоказателиГруппы = ОтчетОбъект.мПоказатели.Скопировать(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия),"Код");
	
	ПоказателиВычисления = ПоказателиГруппы.ВыгрузитьКолонку("Код");
	ЗависимыеПоказатели  = Неопределено;
	ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,ПоказателиВычисления,ЗависимыеПоказатели);
	
	МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	СтрРаскрытия.ТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	СтрРаскрытия.ТабДокРаскрытие  = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,,СтрРаскрытия.КодСтроки,МакетыРаскрытия);
	
	ПрименитьНастройкуВыводаДлинныхСтрок(СтрРаскрытия.ТабДокРаскрытие,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);
	
	СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
	
	ОтчетОбъект.СнятьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
	ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрРаскрытия);
	ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
	
	СтрРаскрытия.ТабДокРаскрытие.Очистить();
	
	Если Не ЗависимыеПоказатели = Неопределено Тогда
		Для Каждого ЗависимыйПоказатель Из ЗависимыеПоказатели Цикл
			ПоказателиВычисления.Добавить(ЗависимыйПоказатель);
		КонецЦикла;
	КонецЕсли;
	
	ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета,ПоказателиВычисления);

КонецПроцедуры // ПересчитатьИОтобразитьСтрокуРаскрытия()

// При отображении в таблице формы

&НаСервере
Процедура ПрименитьИзмененияТаблицыРедактированияНаСервере()

	НаборИзменений = ОпределитьИзмененияВТаблицахРедактирования();
	
	ИзмененныеПоказателиДляПересчета = Новый Соответствие;
	СоответствияПолейПоСтрокамОтчета = Новый Соответствие;
	
	Для Каждого КлючТаблицыФормы Из НаборИзменений.ИзмененияВТаблицах Цикл
		
		ИмяТаблицыФормы    = КлючТаблицыФормы.Ключ;
		ДанныеОбИзменениях = КлючТаблицыФормы.Значение;
		
		НазначитьПолныеОбновленияТаблицРаскрытия(ИмяТаблицыФормы, ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета);
		НазначитьЧастичныеОбновленияТаблицРаскрытия(ИмяТаблицыФормы, ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета);
		НазначитьОбновлениеПоказателейБезРаскрытия(ИмяТаблицыФормы, ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета);
		
	КонецЦикла;
	
	// Таблица дополнительных реквизитов и свойства объекта
	Для Каждого КлючПрочие Из НаборИзменений.ПрочиеИзменения Цикл
		СтрДопРеквизит = ОтчетОбъект.мДополнительныеРеквизиты.Найти(КлючПрочие.Ключ,"Код");
		Если Не СтрДопРеквизит = Неопределено Тогда
			СтрДопРеквизит.Значение = КлючПрочие.Значение;
			ОтчетОбъект.ДополнительныеРеквизиты.Вставить(КлючПрочие.Ключ,КлючПрочие.Значение);
		КонецЕсли;
		СтрПараметр = ОтчетОбъект.ПараметрыОтчета.Найти(КлючПрочие.Ключ,"Код");
		Если Не СтрПараметр = Неопределено Тогда
			СтрПараметр.Значение = КлючПрочие.Значение;
			ОтчетОбъект.Параметры.Вставить(КлючПрочие.Ключ,КлючПрочие.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Пересчет показателей
	МассивПоказателей = Новый Массив;
	Для Каждого Запись Из ИзмененныеПоказателиДляПересчета Цикл
		МассивПоказателей.Добавить(Запись.Ключ);
	КонецЦикла;
	
	ЗависимыеПоказатели = ПолучитьЗависимыеПоказателиБезКонтекста(МассивПоказателей,ОтчетОбъект);
	Если ЗависимыеПоказатели.Количество() > 0 Тогда	
		ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,МассивПоказателей,ЗависимыеПоказатели);
	Иначе
		ОтчетОбъект.УстановитьИтогиПоПоказателям(МассивПоказателей);
	КонецЕсли;
	
	ИзмененныеОбласти.Очистить();
	
КонецПроцедуры // ПрименитьИзмененияТаблицыРедактированияНаСервере()

&НаСервере
Функция ОпределитьИзмененияВТаблицахРедактирования()

	ИзмененияПоТаблицамФормы = Новый Соответствие;
	ИзмененияПрочихДанных    = Новый Соответствие;
	ОбработанныеПоля         = Новый Соответствие;
	
	Для Каждого ИзмененноеПоле Из ИзмененныеОбласти Цикл
		
		ИмяПоля = ИзмененноеПоле.Ключ;
		Если ОбработанныеПоля[ИмяПоля] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ИзмененноеПоле.Значение) = Тип("Соответствие") Тогда
			
			Для Каждого ЗначениеИзменения Из ИзмененноеПоле.Значение Цикл
				
				КлючЗначения       = ЗначениеИзменения.Ключ;
				ИзмененаВсяТаблица = ТипЗнч(КлючЗначения) = Тип("Строка");
				
				Если ИзмененаВсяТаблица Тогда
					ИмяТаблицы = ИмяПоля;
					ОбработанныеПоля[ИмяПоля] = Истина;
				Иначе
					Элемент = Элементы.Найти(ИмяПоля);
					Если Элемент <> Неопределено Тогда
					
						Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
							// Изменены все поля таблицы (скопирована строка)
							ИменаРеквизитовТаблицы = ВсеИменаПолейТаблицыФормы(Элемент);
							Таблица    = Элемент;
							ИмяТаблицы = Элемент.Имя;
						Иначе
							ИменаРеквизитовТаблицы = Новый Массив;
							ТекРодитель = Элементы[ИмяПоля].Родитель;
							Пока ТипЗнч(ТекРодитель) <> Тип("ТаблицаФормы") Цикл
								ТекРодитель = ТекРодитель.Родитель;
							КонецЦикла;

							Таблица = ТекРодитель;
							ИмяТаблицы = Таблица.ПутьКДанным;
							ИмяРеквизитаВТаблице = Сред(Элемент.ПутьКДанным,СтрДлина(ИмяТаблицы)+2); // Аналитика+Номер или код колонки отчета.
							ПозТочки = Найти(ИмяРеквизитаВТаблице,".");
							Если ПозТочки >0 Тогда
								ИмяРеквизитаВТаблице = Лев(ИмяРеквизитаВТаблице,ПозТочки-1);
							КонецЕсли;
							Если ИменаРеквизитовТаблицы.Найти(ИмяРеквизитаВТаблице) = Неопределено Тогда
								ИменаРеквизитовТаблицы.Добавить(ИмяРеквизитаВТаблице);
							КонецЕсли;
						КонецЕсли;
					Иначе
						//На форму может быть выведен элемент - реквизит аналитики, без самой аналитики.
						//Если он находится в объединенной ячейке, или выбирается по сценарию ввода,
						//то может зарегистрироваться к изменению сама аналитика.
						Инд = 7;
						Для Инд = 7 По СтрДлина(ИмяПоля) Цикл
							ТекСимвол = Сред(ИмяПоля,Инд,1);
							Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекСимвол) Тогда
								 Прервать;
							КонецЕсли;
						КонецЦикла;
						ИменаРеквизитовТаблицы = Новый Массив;
						ИмяТаблицы = Сред(ИмяПоля,1,Инд-1);
						ИмяРеквизитаВТаблице = Сред(ИмяПоля,Инд);
						Если ИменаРеквизитовТаблицы.Найти(ИмяРеквизитаВТаблице) = Неопределено Тогда
							ИменаРеквизитовТаблицы.Добавить(ИмяРеквизитаВТаблице);
						КонецЕсли;					
					КонецЕсли;
				КонецЕсли;
				
				ИзмененияВТаблице = ИзмененияПоТаблицамФормы[ИмяТаблицы];
				Если ИзмененияВТаблице = Неопределено Тогда
					
					ИзмененияВТаблице = Новый Структура;
					ИзмененияВТаблице.Вставить("ИзмененныеТаблицыРаскрытия", Новый Соответствие);
					ИзмененияВТаблице.Вставить("ИзмененныеПоказатели"      , Новый ТаблицаЗначений);
					ИзмененияВТаблице.Вставить("ТаблицыСПолнымПересчетом"  , Новый Массив);
					
					ИзмененияВТаблице.ИзмененныеПоказатели.Колонки.Добавить("КодСтроки");
					ИзмененияВТаблице.ИзмененныеПоказатели.Колонки.Добавить("ИмяРеквизитаВТаблице");
					
					ИзмененияПоТаблицамФормы.Вставить(ИмяТаблицы, ИзмененияВТаблице);
					
				КонецЕсли;
				
				Если ИзмененаВсяТаблица Тогда
					Если ИзмененияВТаблице.ТаблицыСПолнымПересчетом.Найти(КлючЗначения) = Неопределено Тогда
						ИзмененияВТаблице.ТаблицыСПолнымПересчетом.Добавить(КлючЗначения);
					КонецЕсли;
				Иначе
					ДанныеСтроки = ЭтотОбъект[ИмяТаблицы].НайтиПоИдентификатору(КлючЗначения);
					
					Если ДанныеСтроки = Неопределено Тогда // Строка была удалена
						Продолжить;
					КонецЕсли;
					
					Если ДанныеСтроки.ВидЗаписи = "Раскрытие" Тогда
						
						Если ИзмененияВТаблице.ТаблицыСПолнымПересчетом.Найти(ДанныеСтроки.КодСтроки) = Неопределено Тогда
							ИндексСтрокиРаскрытия = -1;
							Для Каждого СтрТЧ Из ЭтотОбъект[ИмяТаблицы] Цикл
								Если СтрТЧ.КодСтроки = ДанныеСтроки.КодСтроки
									И СтрТЧ.ВидЗаписи = "Итог" Тогда
									ИндексСтрокиРаскрытия = ЭтотОбъект[ИмяТаблицы].Индекс(СтрТЧ);
									Прервать;
								КонецЕсли;
							КонецЦикла;
							
							Если ДанныеСтроки.Порядок <> ЭтотОбъект[ИмяТаблицы].Индекс(ДанныеСтроки)-ИндексСтрокиРаскрытия Тогда
								// Изменен порядок строк или удалены строки. Требуется полный пересчет.
								ИзмененияВТаблице.ТаблицыСПолнымПересчетом.Добавить(ДанныеСтроки.КодСтроки);
								Продолжить;
							КонецЕсли;
							
							ИнформацияобИзмененияхРаскрытия = ИзмененияВТаблице.ИзмененныеТаблицыРаскрытия[ДанныеСтроки.КодСтроки];
							Если ИнформацияобИзмененияхРаскрытия = Неопределено Тогда
								ИнформацияобИзмененияхРаскрытия = Новый Структура;
								ТаблицаИзменений = Новый ТаблицаЗначений;
								ТаблицаИзменений.Колонки.Добавить("ИдентификаторСтроки");
								ТаблицаИзменений.Колонки.Добавить("ИмяРеквизитаВТаблице");
								ИнформацияобИзмененияхРаскрытия.Вставить("ИзмененныеСтроки", ТаблицаИзменений);
								ИзмененияВТаблице.ИзмененныеТаблицыРаскрытия.Вставить(ДанныеСтроки.КодСтроки, ИнформацияобИзмененияхРаскрытия);
							КонецЕсли;
							
							Для Каждого ИмяРеквизитаВТаблице Из ИменаРеквизитовТаблицы Цикл
								СтрИзменение = ИнформацияобИзмененияхРаскрытия.ИзмененныеСтроки.Добавить();
								СтрИзменение.ИдентификаторСтроки  = КлючЗначения;
								СтрИзменение.ИмяРеквизитаВТаблице = ИмяРеквизитаВТаблице;
								
								СтрИзменениеПоказатель = ИзмененияВТаблице.ИзмененныеПоказатели.Добавить();
								СтрИзменениеПоказатель.КодСтроки = ДанныеСтроки.КодСтроки;
								СтрИзменениеПоказатель.ИмяРеквизитаВТаблице = ИмяРеквизитаВТаблице;
							КонецЦикла;
							
						КонецЕсли;
						
					Иначе
						
						Для Каждого ИмяРеквизитаВТаблице Из ИменаРеквизитовТаблицы Цикл
							СтрИзменениеПоказатель = ИзмененияВТаблице.ИзмененныеПоказатели.Добавить();
							СтрИзменениеПоказатель.КодСтроки = ДанныеСтроки.КодСтроки;
							СтрИзменениеПоказатель.ИмяРеквизитаВТаблице = ИмяРеквизитаВТаблице;
						КонецЦикла;
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ИзмененияПрочихДанных.Вставить(ИзмененноеПоле.Ключ, ИзмененноеПоле.Значение);
		КонецЕсли
		
	КонецЦикла;
	
	Возврат Новый Структура("ИзмененияВТаблицах, ПрочиеИзменения", ИзмененияПоТаблицамФормы, ИзмененияПрочихДанных);
	
КонецФункции // ОпределитьИзмененияВТаблицахРедактирования()

&НаСервере
Функция ВсеИменаПолейТаблицыФормы(Знач ЭлементТаблица, Знач МассивИмен = Неопределено)

	Если МассивИмен = Неопределено Тогда
		МассивИмен = Новый Массив;
	КонецЕсли;
	
	Для Каждого ПолеТаблицы Из ЭлементТаблица.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПолеТаблицы) = Тип("ПолеФормы") Тогда
			ИмяРеквизита = Сред(ПолеТаблицы.ПутьКДанным,СтрДлина(ЭлементТаблица.Имя)+2);
			ПозицияТочки = Найти(ИмяРеквизита,".");
			Если ПозицияТочки>0 Тогда
				ИмяРеквизита = Лев(ИмяРеквизита,ПозицияТочки-1);// это может быть реквизит	
			КонецЕсли;
			
			Если Найти(ИмяРеквизита,"Свойство") = 1 Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ИмяРеквизита,"Поиск_") = 1 Тогда
				Продолжить;
			КонецЕсли;
			Если МассивИмен.Найти(ИмяРеквизита)<>Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивИмен.Добавить(ИмяРеквизита);
		ИначеЕсли ТипЗнч(ПолеТаблицы) = Тип("ГруппаФормы") Тогда
			ВсеИменаПолейТаблицыФормы(ПолеТаблицы, МассивИмен);
		КонецЕсли;
	КонецЦикла;

	Возврат МассивИмен;
	
КонецФункции // ИменаПолейТаблицыФормы()

&НаСервере
Процедура НазначитьПолныеОбновленияТаблицРаскрытия(Знач ИмяТаблицыФормы, Знач ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета)

	Для Каждого КодСтрокиПолныйПересчет Из ДанныеОбИзменениях.ТаблицыСПолнымПересчетом Цикл
		
		ПоискПоКодуСтроки = Новый Структура("КодСтроки", КодСтрокиПолныйПересчет);
		
		// Удалить частичные обновления, которые перекрываются полными
		ДанныеОбИзменениях.ИзмененныеТаблицыРаскрытия.Удалить(КодСтрокиПолныйПересчет);
		// Удалить изменения показателей по данной строке
		ПоказателиДляУдаления = ДанныеОбИзменениях.ИзмененныеПоказатели.НайтиСтроки(ПоискПоКодуСтроки);
		Для Каждого СтрПок Из ПоказателиДляУдаления Цикл
			ДанныеОбИзменениях.ИзмененныеПоказатели.Удалить(СтрПок);
		КонецЦикла;
		
		ПоискПоКодуСтрокиОтчет = Новый Структура("КодСтрока", КодСтрокиПолныйПересчет);
		ПоказателиСтроки = ОтчетОбъект.мПоказатели.НайтиСтроки(ПоискПоКодуСтрокиОтчет);
		Для Каждого СтрПоказатель Из ПоказателиСтроки Цикл
			ИзмененныеПоказателиДляПересчета.Вставить(СтрПоказатель.Код, Истина);
		КонецЦикла;
		
		СоответствиеПолей = ПолучитьСоответствиеПолейРаскрытияИДанныхФормы(КодСтрокиПолныйПересчет);
		
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтрокиПолныйПересчет, "КодСтроки");
		Если СтрРаскрытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрРаскрытия.ТаблицаРаскрытия.Очистить();
		Инд = 1;
		Для Каждого СтрокаРаскрытияДанныеФормы Из ЭтаФорма[ИмяТаблицыФормы] Цикл
			Если СтрокаРаскрытияДанныеФормы.КодСтроки = КодСтрокиПолныйПересчет
				И СтрокаРаскрытияДанныеФормы.ВидЗаписи = "Раскрытие" Тогда
				
				СтрокаПриемник = СтрРаскрытия.ТаблицаРаскрытия.Добавить();
				ЗаполнитьОдиночнуюСтрокуРаскрытияПоДаннымФормы(СтрокаПриемник, СтрокаРаскрытияДанныеФормы, СоответствиеПолей);
				СтрокаПриемник.Индекс = Инд;
				Инд = Инд + 1;
			КонецЕсли;
		КонецЦикла;
		ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия, СтрРаскрытия.ТаблицаРаскрытия, Ложь);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НазначитьЧастичныеОбновленияТаблицРаскрытия(Знач ИмяТаблицыФормы, Знач ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета)

	Для Каждого КлючИзмененнойТаблицы Из ДанныеОбИзменениях.ИзмененныеТаблицыРаскрытия Цикл
		
		КодСтроки         = КлючИзмененнойТаблицы.Ключ;
		ИзмененияВТаблице = КлючИзмененнойТаблицы.Значение;
		СтрРаскрытия      = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки, "КодСтроки");
		СоответствиеПолей = ПолучитьСоответствиеПолейРаскрытияИДанныхФормы(КодСтроки);
		
		ИзмененныеСтрокиРаскрытия  = Новый Массив;
		ИзмененныеКолонкиРаскрытия = Новый Массив;
		
		ИзмененияВТаблице.ИзмененныеСтроки.Свернуть("ИдентификаторСтроки,ИмяРеквизитаВТаблице");
		ИзмененияВТаблице.ИзмененныеСтроки.Сортировать("ИдентификаторСтроки");
		ТекИдентификатор = Неопределено;
		ДанныеСтроки     = Неопределено;
		СтрокаТаблицыРаскрытия = Неопределено;
		МожноЗаполнятьКонтекст = Ложь;
		
		Для Каждого ИзмененнаяЯчейка Из ИзмененияВТаблице.ИзмененныеСтроки Цикл
			
			Если ИзмененнаяЯчейка.ИдентификаторСтроки <> ТекИдентификатор Тогда
				ТекИдентификатор = ИзмененнаяЯчейка.ИдентификаторСтроки;
				ДанныеСтроки     = ЭтаФорма[ИмяТаблицыФормы].НайтиПоИдентификатору(ИзмененнаяЯчейка.ИдентификаторСтроки);
				
				МожноЗаполнятьКонтекст = Ложь;
				
				Если ДанныеСтроки <> Неопределено Тогда
					
					Если ДанныеСтроки.Индекс = -1 Тогда // Это новая строка
						СтрокаТаблицыРаскрытия = СтрРаскрытия.ТаблицаРаскрытия.Добавить();
						СтрокаТаблицыРаскрытия.Индекс = СтрРаскрытия.ТаблицаРаскрытия.Количество();
					Иначе
						СтрокаТаблицыРаскрытия = СтрРаскрытия.ТаблицаРаскрытия.Найти(ДанныеСтроки.Индекс, "Индекс");
						Если СтрокаТаблицыРаскрытия = Неопределено Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					ИзмененныеСтрокиРаскрытия.Добавить(СтрокаТаблицыРаскрытия);
					МожноЗаполнятьКонтекст = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Если МожноЗаполнятьКонтекст Тогда
				
				ЗаполнитьОдиночнуюСтрокуРаскрытияПоДаннымФормы(СтрокаТаблицыРаскрытия, ДанныеСтроки, СоответствиеПолей, ИзмененнаяЯчейка.ИмяРеквизитаВТаблице);
				
				СтрСоответствие = СоответствиеПолей.Найти(ИзмененнаяЯчейка.ИмяРеквизитаВТаблице,"ДанныеФормы");
				Если Не СтрСоответствие = Неопределено Тогда
					ИзмененныеКолонкиРаскрытия.Добавить(СтрСоответствие.Отчет);
					ИзмененныеПоказателиДляПересчета.Вставить(СтрСоответствие.Отчет, Истина);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИзмененныеСтрокиРаскрытия.Количество() Тогда
			ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,ИзмененныеСтрокиРаскрытия,ИзмененныеКолонкиРаскрытия);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НазначитьОбновлениеПоказателейБезРаскрытия(Знач ИмяТаблицыФормы, Знач ДанныеОбИзменениях, ИзмененныеПоказателиДляПересчета)
	
	ТаблицаРаздела  = ЭтаФорма[ИмяТаблицыФормы];
	Для Каждого СтрокаИтога Из ТаблицаРаздела Цикл
		
		Если СтрокаИтога.ВидЗаписи <> "" Тогда
			Продолжить;
		КонецЕсли;
		
		УсловиеПоиска = Новый Структура("КодСтроки", СтрокаИтога.КодСтроки);
		ИзмененияПоказателейСтроки = ДанныеОбИзменениях.ИзмененныеПоказатели.НайтиСтроки(УсловиеПоиска);
		
		СоответствиеПолей = ПолучитьСоответствиеПолейРаскрытияИДанныхФормы(СтрокаИтога.КодСтроки);
		
		Для Каждого ИзмененныйПоказатель Из ИзмененияПоказателейСтроки Цикл
			
			СтрСоответствия = СоответствиеПолей.Найти(ИзмененныйПоказатель.ИмяРеквизитаВТаблице, "ДанныеФормы");
			Если СтрСоответствия <> Неопределено Тогда
				
				ИзмененныеПоказателиДляПересчета.Вставить(СтрСоответствия.Отчет, Истина);
				
				СтрСоответствия.Описание.Значение = СтрокаИтога[ИзмененныйПоказатель.ИмяРеквизитаВТаблице];
				
				Если СтрСоответствия.Роль = "Показатель"
					И ЗначениеЗаполнено(СтрСоответствия.Описание.ТипЗначения)
					И СтрСоответствия.Описание.Значение = Неопределено Тогда
					//приведем к нужному значению
					СтрСоответствия.Описание.Значение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрСоответствия.Описание.ТипЗначения).ПривестиЗначение(Неопределено);
				КонецЕсли;
				
				Если СтрСоответствия.Роль = "Показатель"
					И СтрСоответствия.Описание.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число
					И СтрСоответствия.Описание.НеМасштабируется = Ложь
					И СтрСоответствия.Описание.Нефинансовый = Ложь Тогда
					
					СтрСоответствия.Описание.Значение = СтрСоответствия.Описание.Значение * ОтчетОбъект.ВернутьЗначениеДелителя();
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствиеПолейРаскрытияИДанныхФормы(Знач КодСтроки)

	Если мСоответствияПолейПоСтрокамОтчета = Неопределено Тогда
		мСоответствияПолейПоСтрокамОтчета = Новый Соответствие;
	КонецЕсли;
	
	Результат = мСоответствияПолейПоСтрокамОтчета[КодСтроки];
	
	Если Результат = Неопределено Тогда
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("Отчет");
		Результат.Колонки.Добавить("ДанныеФормы");
		Результат.Колонки.Добавить("Роль");
		Результат.Колонки.Добавить("Описание");
		
		ПоказателиСтроки   = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("КодСтрока", КодСтроки));
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки, "КодСтроки");
		
		Если Не СтрРаскрытия = Неопределено Тогда
			ВсеАналитикиОтчета = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ОтчетОбъект.ВидОтчета);
			
			Для Каждого СтрАналитика Из ВсеАналитикиОтчета.НайтиСтроки(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия)) Цикл
				Стр = Результат.Добавить();
				Стр.ДанныеФормы = "Аналитика"+СтрАналитика.КодВидаАналитики;
				Стр.Отчет       = СтрАналитика.ИмяОбъектаАналитики;
				Стр.Роль        = "Аналитика";
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого СтрПоказатель Из ПоказателиСтроки Цикл
			Стр = Результат.Добавить();
			Стр.ДанныеФормы = СтрПоказатель.КодКолонки;
			Стр.Отчет       = СтрПоказатель.Код;
			Стр.Роль        = "Показатель";
			Стр.Описание    = СтрПоказатель;
		КонецЦикла;
		
		Стр = Результат.Добавить();
		Стр.ДанныеФормы = "Индекс";
		Стр.Отчет       = "Индекс";
		
		мСоответствияПолейПоСтрокамОтчета[КодСтроки] = Результат;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьСоответствиеПолейРаскрытияИДанныхФормы()

&НаСервере
Процедура ЗаполнитьОдиночнуюСтрокуРаскрытияПоДаннымФормы(Знач СтрокаПриемник, Знач СтрокаИсточник , Знач СоответствиеПолей, Знач СписокПолей = Неопределено)

	Если Не СписокПолей = Неопределено Тогда
		СписокПолей = "," + СписокПолей + ",";
	КонецЕсли;
	
	Для Каждого СтрСоответствие Из СоответствиеПолей Цикл
		
		Если (Не СписокПолей = Неопределено и Найти(СписокПолей,","+СтрСоответствие.ДанныеФормы+",") = 0)
			 или СтрокаИсточник.Свойство(СтрСоответствие.ДанныеФормы) = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПриемник[СтрСоответствие.Отчет] = СтрокаИсточник[СтрСоответствие.ДанныеФормы];
		
		Если СтрСоответствие.Роль = "Показатель"
			И ЗначениеЗаполнено(СтрСоответствие.Описание.ТипЗначения)
			И СтрокаПриемник[СтрСоответствие.Отчет] = Неопределено Тогда
			//приведем к нужному значению
			СтрокаПриемник[СтрСоответствие.Отчет] = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрСоответствие.Описание.ТипЗначения).ПривестиЗначение(Неопределено);
		КонецЕсли;
		
		Если СтрСоответствие.Роль = "Показатель" 
			И СтрСоответствие.Описание.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число
			И СтрСоответствие.Описание.НеМасштабируется = Ложь
			И СтрСоответствие.Описание.Нефинансовый = Ложь Тогда
			
			СтрокаПриемник[СтрСоответствие.Отчет] = СтрокаПриемник[СтрСоответствие.Отчет] * ОтчетОбъект.ВернутьЗначениеДелителя();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокаИсточник.Индекс = -1 Тогда
		СтрокаПриемник.Индекс = СтрокаПриемник.Владелец().Количество();
	Иначе
		СтрокаПриемник.Индекс = СтрокаИсточник.Индекс;
		СтрокаПриемник.ПромежуточныеИтоги = СтрокаИсточник.ПромежуточныеИтоги;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьОдиночнуюСтрокуРаскрытияПоДаннымФормы()

&НаКлиенте
Процедура ПослеРасширенногоРедактированияЯчейкиБланка(Результат,ДополнительныеПараметры) Экспорт
	Если Результат=Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ТекущееИмя")
			И Результат.Свойство("ТекущееЗначение") Тогда
			Модифицированность = Истина;
			ИскомаяОбласть = ТабличныйДокументОтчета.Область(Результат.ТекущееИмя);
			Если ИскомаяОбласть.СодержитЗначение Тогда
				ИскомаяОбласть.Значение = Результат.ТекущееЗначение;
			Иначе
				ИскомаяОбласть.Текст = Результат.ТекущееЗначение;
			КонецЕсли;
			ТабличныйДокументОтчетаПриИзмененииСодержимогоОбласти(Элементы.ТабличныйДокументОтчета, ИскомаяОбласть);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


// Устанавливает необходимые признаки при начале ручного редактирования отчета.
//
&НаКлиенте
Процедура ОбработатьРедактированиеФормы() Экспорт

	Если мФормаПодготовленаКИзменению = Неопределено Тогда
		
		Попытка
			ЗаблокироватьДанныеФормыДляРедактирования();
			ОбработатьРедактированиеФормыБезКонтекста(Объект,АдресОбъектаОтчет,Объект.Состояние);
		Исключение
			ЭтаФорма.ТолькоПросмотр = Истина;
			ОбработкаОшибок.ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке());
		КонецПопытки;
		
		мФормаПодготовленаКИзменению = Истина;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресКопииРаскрытия) Тогда
		ОтменитьВозможностьОткатаСвертки();
	КонецЕсли;
	
	Если мУдаляемыеСтроки <> Неопределено Тогда
		ОтменитьУдаление(Неопределено);
	КонецЕсли;
	
КонецПроцедуры // ОбработатьРедактированиеФормы()

&НаСервере
Процедура ОтменитьВозможностьОткатаСвертки()

	Если ЭтоАдресВременногоХранилища(АдресКопииРаскрытия) Тогда
		УдалитьИзВременногоХранилища(АдресКопииРаскрытия);
		АдресКопииРаскрытия = "";
	КонецЕсли;
	
	КнопкаОтменыСвертки = Элементы.Найти("КнопкаОтменитьСверткуПоАналитике");
	Если КнопкаОтменыСвертки <> Неопределено Тогда
		Элементы.Удалить(КнопкаОтменыСвертки);
	КонецЕсли;
	
	ЗакрытьПанельИнформацииОСвертке();

КонецПроцедуры // ОтменитьВозможностьОткатаСвертки()

// Обработка редактирования формы на сервере.
//
&НаСервере
Процедура ОбработатьРедактированиеФормыСервер()

	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ОбработатьРедактированиеФормыБезКонтекста(Объект,АдресОбъектаОтчет,Объект.Состояние);

КонецПроцедуры // ОбработатьРедактированиеФормыСервер()

&НаСервереБезКонтекста
Процедура ОбработатьРедактированиеФормыБезКонтекста(Знач ТекОбъект,АдресОбъектаОтчет,ТекСостояние)

	ОтчетОбъект = Неопределено;
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	Состояние = ОтчетОбъект.ТекущееСостояниеОтчета();
	
	Если Состояние = Перечисления.СостоянияОтчетов.Запланирован
		ИЛИ Состояние = Перечисления.СостоянияОтчетов.ПоказателиОтсутствуют Тогда
		ТекСостояние = Перечисления.СостоянияОтчетов.Выполняется;
		ОтчетОбъект.УстановитьСостояниеОтчета(Перечисления.СостоянияОтчетов.Выполняется);
	КонецЕсли;
			
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);

КонецПроцедуры


// Включает/выключает возможность редактирования формы.
//
&НаСервере
Процедура УстановитьРежимРедактированияФормыСервер(Редактирование,СообщатьОПроблеме = Истина)
	
	Если Редактирование Тогда
		
		Если ОбъектБылИзмененВДругомСеансе Тогда
			Редактирование = Ложь;
			
			Если СообщатьОПроблеме Тогда
				ТекстСообщенияТолькоПросмотр = НСтр("ru = 'Документ был изменен в другом сеансе. Возможен только просмотр документа.
				|Для редактирования рег.отчета необходимо переоткрыть форму документа.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияТолькоПросмотр);
			КонецЕсли;
			
		Иначе		
		
			//Если можно редактировать, то устанавливается признак редактирования.
			//Проверим, что данный экземпляр отчета можно редактировать, и он не заблокирован ранее. 
			Попытка
				ЗаблокироватьДанныеФормыДляРедактирования();
			Исключение
				Если СообщатьОПроблеме Тогда
					ТекстСообщенияТолькоПросмотр = НСтр("ru = 'Возможен только просмотр документа'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияТолькоПросмотр);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецЕсли;
				Редактирование = Ложь;
			КонецПопытки;
		
		КонецЕсли;
	Иначе
		Попытка
			РазблокироватьДанныеФормыДляРедактирования();
		Исключение
			//не должно быть ошибки, 
		КонецПопытки;
	КонецЕсли;
	
	ЭтаФорма.ТолькоПросмотр = Не Редактирование;
	Элементы.ФормаВключитьРедактирование.Пометка = Редактирование;
	Элементы.ТабличныйДокументОтчетаКонтекстноеМенюВставитьИзБуфераОбмена.Доступность = Редактирование;
	
	УстановитьДоступностьМенюЗаполнения(ЭтотОбъект, Редактирование);
	
	Если Не ОтображатьВВидеТаблицыФормы Тогда
		Возврат;
	КонецЕсли;
		
	МакетОтображения = ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице);
	
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		Элементы[ИмяТаблицыРаздела(Раздел)].ТолькоПросмотр = Не Редактирование;		
	КонецЦикла;	
	
КонецПроцедуры // УстановитьРежимРедактированияФормы()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьМенюЗаполнения(ФормаДок,Редактирование) 
	
	МассивИменИсключений = Новый Массив;
	МассивИменИсключений.Добавить("СправочнаяИнформация");
	
	// Изменение доступности команд меню "Заполнить"
	Для каждого ЭлементФормы Из ФормаДок.Элементы.ПодменюЗаполнить.ПодчиненныеЭлементы Цикл
		
		Если МассивИменИсключений.Найти(ЭлементФормы.Имя) = Неопределено Тогда
			
			ЭлементФормы.Доступность = Редактирование;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовОтображения()

	Если ОтображатьВВидеТаблицыФормы Тогда
		Элементы.РедактированиеВТабличномДокументе.Видимость = Ложь;
		Элементы.РедактированиеВТаблицеФормы.Видимость = Истина;
		Элементы.ЗнакСигма.Видимость = Ложь;
		Элементы.АвтоСумма.Видимость = Ложь;
		
		Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Видимость = Ложь;
		Элементы.РедактированиеТекстаВОтдельномОкне.Видимость  = Ложь;
		Элементы.ФормаОткрытьТекущуюСтраницуВExcel.Видимость = Ложь;
		
		Элементы.ФормаЗафиксироватьТаблицу.Видимость = Ложь;
		Элементы.ФормаВыводитьДлинныеПоляВОднуСтроку.Видимость = Ложь;
	Иначе
		Если ТипЗнч(ДобавленныеРеквизиты) = Тип("ФиксированныйМассив") Тогда
			Элементы.ФормаГруппаОтборыБланка.Видимость = ДобавленныеРеквизиты.Количество()>0;
		Иначе
			Элементы.ФормаГруппаОтборыБланка.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.РедактированиеВТабличномДокументе.Видимость = Истина;
		Элементы.РедактированиеВТаблицеФормы.Видимость = Ложь;
		Элементы.ЗнакСигма.Видимость = Истина;
		Элементы.АвтоСумма.Видимость = Истина;
		
		Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Видимость = Истина;
		Элементы.РедактированиеТекстаВОтдельномОкне.Видимость  = Истина;
		Элементы.ФормаОткрытьТекущуюСтраницуВExcel.Видимость = Истина;
		
		Элементы.ФормаЗафиксироватьТаблицу.Видимость = Истина;
		Элементы.ФормаВыводитьДлинныеПоляВОднуСтроку.Видимость = Истина;
	КонецЕсли;	

	Элементы.ТабличныйДокументОтчетаКонтекстноеМенюРасшифроватьАвтозаполнение.Видимость = БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности().ПравилаЗаполнения;

КонецПроцедуры // УстановитьВидимостьЭлементовОтображения()

&НаСервере
Процедура ОтобразитьОтчетДляРедактирования(Отказ)
 
	Если Не Объект.Ссылка.Пустая() Тогда
		
		ПриСозданииФормыСуществующегоОтчета(Отказ);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		
		ПриСозданииФормыНовогоОтчета(Отказ);
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		УстановитьВидимостьЭлементовОтображения();
		
		// Видимость кнопки "Расчет группировочных итогов"
		Если Не ПользовательскиеАлгоритмы.ОбработчикСобытияОпределен(Объект.ПравилоОбработки,"РасчетПромежуточныхИтогов") Тогда
			Элементы.ГруппаКнопокДополнительныеКомандыРасчета.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ОтобразитьОтчетДляРедактирования()


///////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ФОРМОЙ ДОКУМЕНТА
//


&НаСервере
Процедура ПриСозданииФормыСуществующегоОтчета(Отказ)

	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	ВыполнитьОбщуюИнициализациюФормы(ОтчетОбъект);
	
	
	ВывестиДанныеОтчета();
	
	ВозможноРедактирование = Не ЭтаФорма.ТолькоПросмотр;
	Редактирование         = ВозможноРедактирование 
		И ОтчетОбъект.Состояние<>Перечисления.СостоянияОтчетов.Подготовлен
		И ОтчетОбъект.Состояние<>Перечисления.СостоянияОтчетов.Утвержден;
	
	УстановитьРежимРедактированияФормыСервер(Редактирование,Ложь);
	
	Если Не ВозможноРедактирование Тогда
		Элементы.ФормаВключитьРедактирование.Доступность = Ложь;
	КонецЕсли;
	
	// Первичное помещение объекта в хранилище.
	АдресОбъектаОтчет = ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,УникальныйИдентификатор);
	ЗначениеВРеквизитФормы(ОтчетОбъект,"Объект");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииФормыНовогоОтчета(Отказ)

	Отказ = Не ИнициализироватьПоВидуОтчета(Объект.ВидОтчета);

КонецПроцедуры // ПриСозданииФормыНовогоОтчета()

&НаСервере
Процедура ЗаполнитьПараметрыГруппРаскрытия()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтрокиОтчетов.Код КАК КодСтроки,
	|	СтрокиОтчетов.ГруппаРаскрытия.Код КАК КодГруппыРаскрытия,
	|	СтрокиОтчетов.ГруппаРаскрытия
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.Владелец = &Владелец
	|	И СтрокиОтчетов.ГруппаРаскрытия <> ЗНАЧЕНИЕ(Справочник.ГруппыРаскрытия.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Владелец",?(ЗначениеЗаполнено(Объект.ВидОтчета),Объект.ВидОтчета,?(ОтчетОбъект = Неопределено,Неопределено,ОтчетОбъект.ВидОтчета)));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ЗначениеВРеквизитФормы(РезультатЗапроса.Выгрузить(),"ПараметрыГруппРаскрытия");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиДанныеОтчета(Знач ВыводитьРаскрытиеВТелеБланка = Неопределено,Знач ИдСтраницы = Неопределено) 
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ВывестиОтчетВТаблице();
	Иначе
		ВыбратьСтраницуНаСервере(ИдСтраницы,ВыводитьРаскрытиеВТелеБланка,Неопределено,Ложь);
	КонецЕсли;

КонецПроцедуры // ВывестиДанныеОтчета()

&НаСервере
Процедура УстановитьРежимОтображенияДанных(Знач ИспользоватьМакет)
 
	ОтображатьВВидеТаблицыФормы = ИспользоватьМакет;
	
	ОбновитьКэшируемыеНастройкиОтчета();
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		
		ТабличныйДокументОтчета.Очистить();
		
		АдресТекущейСтраницы = "";//очищаем адрес текущей страницы, чтобы пустой табличный документ не сохранился
		Элементы.ГруппаСтраницы.Видимость = Ложь;
				
		Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка = Ложь;
		СоздатьТаблицуРедактированияОтчета(ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице));
		
	Иначе
		
		КоличествоСтр = 0;
		Для Каждого ТекСтр Из ДеревоСтраниц.ПолучитьЭлементы() Цикл
			КоличествоСтр = КоличествоСтр + 1;
			КоличествоСтр = КоличествоСтр + ТекСтр.ПолучитьЭлементы().Количество();
			Если КоличествоСтр>1 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Элементы.ГруппаСтраницы.Видимость = КоличествоСтр>1;

		ДобавленныеТаблицы = Новый Массив;
		ЗаполнитьДобавленныеРеквизиты(Элементы.РазделыМакета,ДобавленныеТаблицы);
		
		ИзменитьРеквизиты(,ДобавленныеТаблицы);
		
		ВсегоЭлементов = Элементы.РазделыМакета.ПодчиненныеЭлементы.Количество();
		Для Сч = 1 По ВсегоЭлементов Цикл
			Элемент = Элементы.РазделыМакета.ПодчиненныеЭлементы[ВсегоЭлементов-Сч];
			Элементы.Удалить(Элемент);
		КонецЦикла;
		
		КоличествоЭлементовОформления = УсловноеОформление.Элементы.Количество();
		Для Сч = 1 По КоличествоЭлементовОформления Цикл
			
			ЭлементОформления = УсловноеОформление.Элементы[КоличествоЭлементовОформления-Сч];
			Если ЭлементОформления.Представление = "-оформление-редактирования-" Тогда
				УсловноеОформление.Элементы.Удалить(ЭлементОформления);
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Элементы.ФормаПереключитьРежимОтображения.Пометка = ОтображатьВВидеТаблицыФормы;
	
КонецПроцедуры // УстановитьРежимОтображенияДанных()

&НаСервере
Процедура ЗаполнитьДобавленныеРеквизиты(ТекЭлемент,ДобавленныеТаблицы)
	Для Каждого ЭлементФормы Из ТекЭлемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда
			ДобавленныеТаблицы.Добавить(ЭлементФормы.ПутьКДанным);
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("ГруппаФормы") Тогда
			ЗаполнитьДобавленныеРеквизиты(ЭлементФормы,ДобавленныеТаблицы)
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			Если Найти(ЭлементФормы.Имя,"_Поиск_")>0 Тогда
				ИмяРеквизитаСоСпособомОтбора = СтрЗаменить(ЭлементФормы.Имя,"_Поиск_","_Способ_Поиск_");
				ДобавленныеТаблицы.Добавить(ИмяРеквизитаСоСпособомОтбора);
			КонецЕсли;
			ДобавленныеТаблицы.Добавить(ЭлементФормы.ПутьКДанным);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ТекстЗаголовка = ПолучитьЗаголовокФормы(Объект.ВидОтчета,Объект.Организация,Объект.Номер,Объект.Дата);

	ЭтаФорма.Заголовок = ТекстЗаголовка;
		
КонецПроцедуры // УстановитьЗаголовокФормы()


&НаСервере
Процедура ОбновитьПараметрыСвязанныхОтчетов()
	
	Если ТаблицаДополнительныхРеквизитов.Количество() > 0 Тогда
		
		Элементы.СвязанныеОтчеты.Видимость = Истина;
		
		СвязанныеОтчеты.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
		СвязанныеОтчеты.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Организация);
		СвязанныеОтчеты.Параметры.УстановитьЗначениеПараметра("ВидОтчета", Объект.ВидОтчета);
		СвязанныеОтчеты.Параметры.УстановитьЗначениеПараметра("ПериодОтчета", Объект.ПериодОтчета);
		СвязанныеОтчеты.Параметры.УстановитьЗначениеПараметра("ИФО", Объект.ИФО);
		
	Иначе
		
		Элементы.СвязанныеОтчеты.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// Процедуры работы с отображением отчета в табличном документе
//

&НаСервере
Функция СпособОтображенияПоУровням(ДеревоДляПроверки)
	
	СпособОтображения = ОтображениеТаблицы.Список;
	Для Каждого СтрокаДерева Из ДеревоДляПроверки.Строки Цикл
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СпособОтображения = ОтображениеТаблицы.Дерево;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СпособОтображения;
	
КонецФункции

&НаСервере
Процедура СинхронизироватьИВывестиБланк(РежимРаскрытия,ИзмененБланк = Ложь)
	
	Если ИзмененБланк <> Ложь Тогда
		ТаблицаФильтровПоЗначению.Очистить();
	КонецЕсли;
	
	СинхронизироватьКонтекстСервер(Ложь);
	ОтчетОбъект.ЗаполнитьДеревоСтраниц(УникальныйИдентификатор);
	
	Элементы.ДеревоСтраниц.Отображение = СпособОтображенияПоУровням(ОтчетОбъект.мДеревоСтраниц);
	
	ЗначениеВРеквизитФормы(ОтчетОбъект.мДеревоСтраниц,"ДеревоСтраниц");
	
	//если всего 1 страница в бланке, то не отображаем панель со страницами
	КоличествоСтраниц = 0;
	Для Каждого ТекСтр Из ОтчетОбъект.мДеревоСтраниц.Строки Цикл
		КоличествоСтраниц = КоличествоСтраниц + 1 + ТекСтр.Строки.Количество();
		Если КоличествоСтраниц>1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоСтраниц=1 Тогда
		Элементы.ГруппаСтраницы.Видимость = Ложь;
	Иначе
		Элементы.ГруппаСтраницы.Видимость = Истина;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресТекущейСтраницы) Тогда
		УдалитьИзВременногоХранилища(АдресТекущейСтраницы);
	КонецЕсли;
	
	АдресТекущейСтраницы = "";
			
	ВыбратьСтраницуНаСервере(Неопределено,РежимРаскрытия,Неопределено,Ложь);
	
	ПоместитьОбъектОтчета();

КонецПроцедуры // СинхронизироватьИВывестиБланк()

// Запрашивает тип области для открытия нужной формы выбора.
//
&НаКлиенте
Функция ПолучитьПараметрыОбласти(ИмяОбласти)

	Если СоответствиеВидовОбластей = Неопределено Тогда
		СоответствиеВидовОбластей = Новый Соответствие;
	КонецЕсли;
	
	Результат = СоответствиеВидовОбластей[ИмяОбласти];
	Если Результат = Неопределено Тогда
		Результат = БюджетнаяОтчетность.ПолучитьПараметрыОбласти(Объект.ВидОтчета, АдресНастроекОтчета, ИмяОбласти);
		
		Если Результат = Неопределено Тогда
			Результат = 0;
		КонецЕсли;
		
		СоответствиеВидовОбластей.Вставить(ИмяОбласти,Результат);
		
	КонецЕсли;

	Возврат ?(Результат = 0,Неопределено,Результат);
	
КонецФункции // ПолучитьПараметрыОбласти()

// Добавляет/копирует строку раскрытия без контекста.
//
&НаСервереБезКонтекста
Функция ДобавитьСтрокуБезКонтекста(Знач ТекОбъект, ТабличныйДокументОтчета, ИзмененныеОбласти, ВходящиеПараметры, КодСтроки, ИмяИсходнойОбласти, ОбъектКопирования = Неопределено)
	
	Перем АдресОбъектаОтчет;
	
	АдресОбъектаОтчет = ВходящиеПараметры.АдресОбъектаОтчет;
				
	ОтчетОбъект = СинхронизироватьКонтекстБезКонтекста(Истина,ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры);
		
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
	Если СтрРаскрытия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	Если СтрНайти(ИмяИсходнойОбласти,"_РазметкаПустойСтроки")>0 Тогда
		ПервоначальноеКоличествоСтрок = 0;
	Иначе
		ПервоначальноеКоличествоСтрок = ТаблицаРаскрытия.Количество();
	КонецЕсли;
	
	НоваяСтрокаРаскрытия 		= ТаблицаРаскрытия.Добавить();
	НоваяСтрокаРаскрытия.ID 	= ТаблицаРаскрытия.Индекс(НоваяСтрокаРаскрытия);
	НоваяСтрокаРаскрытия.Индекс = НоваяСтрокаРаскрытия.ID + 1;
	
	Если Не ОбъектКопирования = Неопределено Тогда
		
		ИсходнаяСтрока = ТаблицаРаскрытия.Найти(ОбъектКопирования,"ID");
		Если ИсходнаяСтрока = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаскрытия,ИсходнаяСтрока,,"ID,Индекс");
		
	ИначеЕсли ЗначениеЗаполнено(СтрРаскрытия.ОтборПоРаскрытию) Тогда
		
		Для Каждого КлючИзначение Из СтрРаскрытия.ОтборПоРаскрытию Цикл
			Если КлючИЗначение.Значение.ВидСравнения = ВидСравнения.Равно Тогда
				НоваяСтрокаРаскрытия[КлючИЗначение.Ключ] = КлючИЗначение.Значение.Значение;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ВсеКолонки 		 = Новый Массив;
	ПоказателиГруппы = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия));
	Для Каждого Пок Из ПоказателиГруппы Цикл
		ВсеКолонки.Добавить(Пок.Код);
	КонецЦикла;
	
	ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,НоваяСтрокаРаскрытия);
	ПересчитатьПоказателиБезКонтекста(ОтчетОбъект, ВсеКолонки);
		
	// Отражение изменений
	Обл = ТабличныйДокументОтчета.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыГруппы = ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	ВысотаШапки = ?(МакетыРаскрытия.Шапка = Неопределено, 0, МакетыРаскрытия.Шапка.ВысотаТаблицы); 
	
	ТекущаяШапкаМакета    = МакетыРаскрытия.Шапка;
	МакетыРаскрытия.Шапка = Неопределено; // Запрет отрисовки шапки
	
	МассивОднойСтроки = Новый Массив;
	МассивОднойСтроки.Добавить(НоваяСтрокаРаскрытия);
	ТаблицаОднойСтроки = СтрРаскрытия.ТаблицаРаскрытия.Скопировать(МассивОднойСтроки);
	МакетОднойСтроки   = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,ТаблицаОднойСтроки,,СтрРаскрытия.КодСтроки,МакетыРаскрытия);
	
	ПрименитьНастройкуВыводаДлинныхСтрок(МакетОднойСтроки,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);
	
	ВысотаОднойСтроки = МакетОднойСтроки.ВысотаТаблицы;
	
	ОтчетОбъект.СнятьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
	
	ТипСдвига = ТипСмещенияТабличногоДокумента.ПоВертикали;
	
	//
	КоличествоСтрок = Цел((СтрРаскрытия.ВысотаТабДокРаскрытия - ВысотаШапки)/ВысотаОднойСтроки);


	Если ПервоначальноеКоличествоСтрок = 0 Тогда // эта строка - единственная в таблице.
		
		НачалоМакетаРаскрытия = Обл.Низ + 1 + ВысотаШапки;
		КонецМакетаРаскрытия  = НачалоМакетаРаскрытия + ВысотаОднойСтроки - 1;
		
		ОбластьПриемник = ТабличныйДокументОтчета.Область(НачалоМакетаРаскрытия,,КонецМакетаРаскрытия);
		ТабличныйДокументОтчета.УдалитьОбласть(ОбластьПриемник,ТипСдвига);
		
		СтрРаскрытия.ТабДокРаскрытие.Очистить();
		
		Если ТекущаяШапкаМакета <> Неопределено Тогда
			СтрРаскрытия.ТабДокРаскрытие.Вывести(ТекущаяШапкаМакета);
		КонецЕсли;
		
		СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
	Иначе
		
		НачалоМакетаРаскрытия = Обл.Низ + 1 + ВысотаШапки;
		КонецМакетаРаскрытия  = НачалоМакетаРаскрытия + ВысотаОднойСтроки*КоличествоСтрок;//(СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы - ВысотаШапки);
		
		ОбластьПриемник = ТабличныйДокументОтчета.Область(КонецМакетаРаскрытия,,КонецМакетаРаскрытия);
	КонецЕсли;
	
	СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ВысотаТабДокРаскрытия + ВысотаОднойСтроки;
	
	СтрРаскрытия.ТабДокРаскрытие.Вывести(МакетОднойСтроки);
	
	ОбластьИсточник = МакетОднойСтроки.Область(1,,МакетОднойСтроки.ВысотаТаблицы);
	
		
	ТабличныйДокументОтчета.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСдвига,Ложь);
	
	ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
		
	СтрРаскрытия.ТабДокРаскрытие.Очистить();
	
	ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета);
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	// Нужно определить координаты ячейки, которую бдуем активизировать (первая значимая ячейка в новой строке)
	КоординатаАктивнойЯчейки = Новый Структура("Лево,Верх",1,0);
	КоординатаОпределена     = Ложь;
	Для НомерСтроки = 1 По МакетОднойСтроки.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По МакетОднойСтроки.ШиринаТаблицы Цикл
			ТекущаяОбластьМакета = МакетОднойСтроки.Область(НомерСтроки,НомерКолонки);
			Если ТекущаяОбластьМакета.СодержитЗначение Тогда
				КоординатаАктивнойЯчейки.Лево = ТекущаяОбластьМакета.Лево;
				КоординатаАктивнойЯчейки.Верх = ТекущаяОбластьМакета.Верх-1;
				КоординатаОпределена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если КоординатаОпределена Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	КоординатаАктивнойЯчейки.Верх = ОбластьПриемник.Верх + КоординатаАктивнойЯчейки.Верх;
	
	Возврат КоординатаАктивнойЯчейки;
	
КонецФункции

// Удаляет строку раскрытия из отчета.
//
&НаСервереБезКонтекста
Процедура УдалитьСтрокиРаскрытияБезКонтекста(Знач ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,МассивОбластей,ВходящиеПараметры)
	
	Перем АдресОбъектаОтчет;
	
	АдресОбъектаОтчет = ВходящиеПараметры.АдресОбъектаОтчет;

	МассивКодовСтрок = Новый Массив;
	ТаблицаСтрок 	 = Новый ТаблицаЗначений;
	ТаблицаСтрок.Колонки.Добавить("КодСтроки");
	ТаблицаСтрок.Колонки.Добавить("Идентификатор");
	
	Для Каждого СтруктураНастройки Из МассивОбластей Цикл
		МассивКодовСтрок.Добавить(СтруктураНастройки.КодСтроки);
		Для Каждого ТекИД Из СтруктураНастройки.МассивИД Цикл
			СтрокаТС = ТаблицаСтрок.Добавить();
			СтрокаТС.КодСтроки = СтруктураНастройки.КодСтроки;
			СтрокаТС.Идентификатор = Число(ТекИД);
		КонецЦикла;
	КонецЦикла;

	ТаблицаСтрок.Свернуть("КодСтроки,Идентификатор");
		
	ОтчетОбъект = СинхронизироватьКонтекстБезКонтекста(Истина,ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры);
		
	Для Каждого КодСтроки Из МассивКодовСтрок Цикл
		
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
		Если СтрРаскрытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеСтроки = ТаблицаСтрок.НайтиСтроки(Новый Структура("КодСтроки",КодСтроки));
		Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
			СтрТаблицы = СтрРаскрытия.ТаблицаРаскрытия.Найти(УдаляемаяСтрока.Идентификатор,"ID");
			Если Не СтрТаблицы = Неопределено Тогда
				СтрРаскрытия.ТаблицаРаскрытия.Удалить(СтрТаблицы);
			КонецЕсли;
		КонецЦикла;
		
		ПеренумероватьТаблицуРаскрытия(СтрРаскрытия.ТаблицаРаскрытия);	
		ОтчетОбъект.ПрименитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,Ложь);
		
		// Пересчет.
		ВсеКолонки 		 = Новый Массив;
		ПоказателиГруппы = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия));
		Для Каждого Пок Из ПоказателиГруппы Цикл
			ВсеКолонки.Добавить(Пок.Код);
		КонецЦикла;
		
		ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,ВсеКолонки);
		
		ПараметрыГруппы = ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
		МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
		
		СтрРаскрытия.ТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(ПараметрыГруппы);
		СтрРаскрытия.ТабДокРаскрытие  = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,
																					  СтрРаскрытия.ТаблицаРаскрытия,,
																					  СтрРаскрытия.КодСтроки,
																					  МакетыРаскрытия);
																					  
		ПрименитьНастройкуВыводаДлинныхСтрок(СтрРаскрытия.ТабДокРаскрытие,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);
		
		СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
		
		ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрРаскрытия);
		
		ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
		
		СтрРаскрытия.ТабДокРаскрытие.Очистить();
		
		ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета);
		
	КонецЦикла;
	
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
КонецПроцедуры // УдалитьСтрокуРаскрытияСервер()

&НаСервереБезКонтекста
Процедура ПеренумероватьТаблицуРаскрытия(ТаблицаРаскрытия)

	Счетчик = 0;
	Для Каждого Стр Из ТаблицаРаскрытия Цикл
		
		Стр.ID 		= Счетчик;
		Стр.Индекс  = Счетчик + 1;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;

КонецПроцедуры // ПеренумероватьТаблицуРаскрытия()

&НаСервере
Процедура СортироватьТаблицуРаскрытия(СтрокаРаскрытия)
	
	Если СтрокаРаскрытия.РучнаяСортировка Тогда 
		Возврат;
	КонецЕсли;	
	
	ТаблицаРаскрытия 	= СтрокаРаскрытия.ТаблицаРаскрытия;
	НастройкаСортировки = СтрокаРаскрытия.ПоляСортировки;
	
	РазрешенныеПоля = НастройкаСортировки.СкопироватьКолонки();
	//РазрешенныеПоля.Колонки.Добавить("ПолеВладелец");
	//РазрешенныеПоля.Колонки.Добавить("ПолеРеквизит");
	
	СоответствиеСтроковыхПолей = Новый Соответствие;
	ТипСтрока = Тип("Строка");
	
	Для Каждого Поле Из НастройкаСортировки Цикл
		
		ИмяПоля		= Поле.ИмяПоля;
		Направление = Поле.НаправлениеСортировки;
		
		//ПозицияТочки	 = Найти(ИмяПоля,".");
		//ИмяОсновногоПоля = ?(ПозицияТочки > 0,Лев(ИмяПоля,ПозицияТочки-1),ИмяПоля);
		
		Если Не ТаблицаРаскрытия.Колонки.Найти(ИмяПоля) = Неопределено Тогда
			
			Стр = РазрешенныеПоля.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Поле);
			
			Если ТаблицаРаскрытия.Колонки[ИмяПоля].ТипЗначения.СодержитТип(ТипСтрока) Тогда
				СоответствиеСтроковыхПолей.Вставить(ИмяПоля,Истина);	
			КонецЕсли;
			
		ИначеЕсли Лев(ИмяПоля,9) = "Аналитика" Тогда
			
			Расширение = Найти(ИмяПоля,".");
			Если Расширение <> 0 Тогда
								
				ИдентификаторПоля = Лев(ИмяПоля,Расширение - 1);
				
			Иначе
				
				ИдентификаторПоля = ИмяПоля;
				
			КонецЕсли;
			
			Если ТаблицаРаскрытия.Колонки.Найти(ИдентификаторПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
				
			Стр = РазрешенныеПоля.Добавить();
			Стр.ИмяПоля 	 = ИмяПоля;
			//Стр.ПолеВладелец = ИдентификаторПоля;
			//Стр.ПолеРеквизит = Окончание;
			Стр.НаправлениеСортировки = Направление;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РазрешенныеПоля.Количество() > 0 Тогда
		
		ТекстПоля = "";
		Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			Если Не (Колонка.Имя = "ID" или Колонка.Имя = "Индекс") Тогда
			    ТекстПоля = ТекстПоля + ",
				|	ТаблицаРаскрытия." + Колонка.Имя;
			КонецЕсли;
		КонецЦикла;
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ"
		+ Сред(ТекстПоля,2) + "
		|ПОМЕСТИТЬ ТаблицаРаскрытия
		|ИЗ
		|	&ТаблицаРаскрытия КАК ТаблицаРаскрытия
		|;
		|ВЫБРАТЬ"
		+ Сред(ТекстПоля,2) + "
		|ИЗ
		|	ТаблицаРаскрытия КАК ТаблицаРаскрытия";
		
		ТекстСортировка = "";
		МассивСортировка = Новый Массив;
		//у таблицы раскрытия для строковых полей не задана длина, поэтому сортировка без приведения к ограниченной строке не работает
		Для Каждого Поле Из РазрешенныеПоля Цикл			
			Если СоответствиеСтроковыхПолей[Поле.ИмяПоля] = Неопределено Тогда			
				МассивСортировка.Добавить(Поле.ИмяПоля + ?(Поле.НаправлениеСортировки = НаправлениеСортировкиКомпоновкиДанных.Убыв," УБЫВ"," ВОЗР"));
			Иначе
				МассивСортировка.Добавить("Выразить("+Поле.ИмяПоля +" КАК Строка(1000))" + ?(Поле.НаправлениеСортировки = НаправлениеСортировкиКомпоновкиДанных.Убыв," УБЫВ"," ВОЗР"));	
			КонецЕсли;
		КонецЦикла;
		
		ТекстСортировка = СтрСоединить(МассивСортировка,","+Символы.ПС);
		
		ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО
		|"+ ТекстСортировка+"
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаРаскрытия);
		
		Попытка
			ВремТаблица = Запрос.Выполнить().Выгрузить();
		Исключение
			Сообщить("Ошибка в настройке сортировки. " + ИнформацияОбОшибке().Описание);
			Возврат;
		КонецПопытки;
		
		СтрокаРаскрытия.ТаблицаРаскрытия.Очистить();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ВремТаблица,СтрокаРаскрытия.ТаблицаРаскрытия);
		ПеренумероватьТаблицуРаскрытия(СтрокаРаскрытия.ТаблицаРаскрытия);
		
	КонецЕсли;

КонецПроцедуры // СортироватьТаблицуРаскрытия()

&НаСервере
Процедура УстановитьФильтрВТабличномДокументе(СтрокаРаскрытия,ЭтоРасшифровка = Ложь,СтрПоказатель=Неопределено,МакетРаскрытия=Неопределено)

	ОтчетОбъект.СнятьГруппировкуСтроки(СтрокаРаскрытия,ТабличныйДокументОтчета);
	
	ПараметрыГруппы = ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки",СтрокаРаскрытия.КодСтроки))[0];
	МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрокаРаскрытия.КодСтроки);	
	
	СтрокаРаскрытия.ТабДокРаскрытие = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрокаРаскрытия.ГруппаРаскрытия
											,СтрокаРаскрытия.ТаблицаРаскрытия
											,СтрокаРаскрытия.ОтборПоРаскрытию
											,СтрокаРаскрытия.КодСтроки,МакетыРаскрытия);

	СтрокаРаскрытия.ВысотаТабДокРаскрытия = СтрокаРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;										
	
	ПрименитьНастройкуВыводаДлинныхСтрок(СтрокаРаскрытия.ТабДокРаскрытие,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);
	
	Если ЭтоРасшифровка = Истина Тогда
		ТабДок = СтрокаРаскрытия.ТабДокРаскрытие;
		Линия  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,2);
		
		// Выделение показателей расшифровки.
		ИмяОбластиПоказателя = СтрПоказатель.КодГруппыРаскрытия+"_"+СтрокаРаскрытия.КодСтроки+"_Показатель_" + СтрПоказатель.Код;
		Область = МакетРаскрытия.Области.Найти(ИмяОбластиПоказателя);
		Если Не Область = Неопределено Тогда
			ОбластьДокумента = ТабДок.Область(1,Область.Лево,ТабДок.ВысотаТаблицы,Область.Право);
			ОбластьДокумента.Обвести(Линия,Линия,Линия,Линия);
			ОбластьДокумента.ЦветРамки = WebЦвета.Красный;
			ОбластьДокумента.ЦветФона = WebЦвета.Розовый;
		КонецЕсли;
								
	КонецЕсли;
	
	ОтчетОбъект.ОбновитьРаскрытиеСтроки(ТабличныйДокументОтчета,СтрокаРаскрытия);
	
	Если ЭтоРасшифровка <> Истина Тогда
		//снова группируем только в случае установки
		ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрокаРаскрытия,ТабличныйДокументОтчета);
	КонецЕсли;
	
	СтрокаРаскрытия.ТабДокРаскрытие.Очистить();

КонецПроцедуры // УстановитьФильтрВТабличномДокументе()

&НаКлиентеНаСервереБезКонтекста
Функция АдресСтрокиРаскрытияБезКонтекста(ИмяОбласти, ПараметрыГруппРаскрытия)

	Если Найти(ИмяОбласти,"_")=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивКодов = СтрРазделить(ИмяОбласти,"_",Ложь);
	
	Если МассивКодов.Количество() > 1 
		И МассивКодов[0] <> "Строка" Тогда
		
		КодСтроки 		= МассивКодов[1];
		КодГруппы		= МассивКодов[0];
		СтруктураПоиска = Новый Структура("КодСтроки,КодГруппыРаскрытия",КодСтроки,КодГруппы);
		ПараметрыГруппы = ПараметрыГруппРаскрытия.НайтиСтроки(СтруктураПоиска);
		Если ПараметрыГруппы.Количество() = 1 Тогда
			
			РеквизитыОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
			
			АдресСтроки = Новый Структура;
			АдресСтроки.Вставить("КодСтроки"			,КодСтроки);
			АдресСтроки.Вставить("КодГруппыРаскрытия"	,КодГруппы);
			АдресСтроки.Вставить("Идентификатор"		,РеквизитыОбласти.Идентификатор);
			АдресСтроки.Вставить("ИмяИсходнойОбласти"	,РеквизитыОбласти.ИмяИсходнойОбласти);
			
			Возврат АдресСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // АдресСтрокиРаскрытияБезКонтекста()

&НаКлиенте
Функция ПолучитьАдресСтрокиРаскрытия(ИмяОбласти)

	Возврат АдресСтрокиРаскрытияБезКонтекста(ИмяОбласти, ПараметрыГруппРаскрытия);

КонецФункции // ПолучитьАдресСтрокиРаскрытия()

&НаСервере
Функция ПодготовитьДанныеОтображенияРаскрытия(КодСтроки)

	СинхронизироватьКонтекстСервер(Ложь);
	
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
	Если СтрРаскрытия = Неопределено Тогда
		СтрРаскрытия = ОтчетОбъект.РаскрытьСтрокуПоАналитике(КодСтроки);
		Если СтрРаскрытия = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	АдресДанныхРаскрытия = ПоместитьВоВременноеХранилище(ПолучитьДанныеОтображенияРаскрытияВОтдельномОкне(СтрРаскрытия));
	ГруппаРаскрытия		 = СтрРаскрытия.ГруппаРаскрытия;
	
	ПоместитьОбъектОтчета();
	
	Возврат Новый Структура("АдресДанныхРаскрытия,ГруппаРаскрытия", АдресДанныхРаскрытия, ГруппаРаскрытия);
	
КонецФункции // ПодготовитьДанныеОтображенияРаскрытия()


&НаКлиенте
Функция ПодготовитьВыборВидаДохода(Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки, ЭлКлДоходов)
	
	СинхронизироватьКонтекстНовыйВариант();
	Возврат ПодготовитьВыборВидаДоходаСервер(Объект, АдресОбъектаОтчет, ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭлКлДоходов);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьВыборВидаДоходаСервер(Знач ТекОбъект,АдресОбъектаОтчет,Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки, ЭлКлДоходов)
	
	ОтчетОбъект = Неопределено;
	Ответ = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ПереченьАналитик = Неопределено;
    ТекСтрокаДанных = Неопределено;
    ЗаполнитьПереченьАналитикИСтрокуДанных(ГруппаРаскрытия, ИдентификаторСтроки, ОтчетОбъект, ТекОбъект, ПереченьАналитик, ТекСтрокаДанных);
	
	ПолныйКод = "";//ВидДохода + Подвид + АнГруппа
	
	ЗначениеВида = Неопределено;
	ЗначениеПодвида = Неопределено;	
	ЗначениеАнГруппы = Неопределено;
	
	ПозицияВида = 0;
	ПозицияПодвида = 0;
	ПозицияАнГруппы = 0;
	
	СтрВидаАналитики = ПереченьАналитик.Найти(ВидАналитики, "ВидАналитики");
	Если СтрВидаАналитики <> Неопределено Тогда
		Позиция = ПереченьАналитик.Индекс(СтрВидаАналитики);
		
		Если ЭлКлДоходов = 1 Тогда			
			ПозицияВида = Позиция;
			ПозицияПодвида = Позиция + 1;					
			ПозицияАнГруппы = Позиция + 2;
		КонецЕсли;	
		
		Если ЭлКлДоходов = 2 Тогда			
			ПозицияВида = Позиция - 1;
			ПозицияПодвида = Позиция;
			ПозицияАнГруппы = Позиция + 1;
		КонецЕсли;
		
		Если ЭлКлДоходов = 3 Тогда			
			ПозицияВида = Позиция - 2;
			ПозицияПодвида = Позиция - 1;
			ПозицияАнГруппы = Позиция;
		КонецЕсли;
						
		Если ПозицияАнГруппы <= ПереченьАналитик.Количество()-1 
			И ПозицияАнГруппы >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияАнГруппы];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.КОСГУ")) Тогда
				ЗначениеАнГруппы = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияПодвида <= ПереченьАналитик.Количество()-1 
			И ПозицияПодвида >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияПодвида];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ГруппыПодвидовКДБ")) Тогда
				ЗначениеПодвида = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияВида <= ПереченьАналитик.Количество()-1 
			И ПозицияВида >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияВида];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ВидыДоходовКДБ")) Тогда
				ЗначениеВида = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
				
				КодВидаДоходов = ПолучитьКодЭлементаКлассификатора(ЗначениеВида,"0000000000");
				КодПодвида = ПолучитьКодЭлементаКлассификатора(ЗначениеПодвида,"0000");
				КодАнГруппы = ПолучитьКодЭлементаКлассификатора(ЗначениеАнГруппы,"000");
				
				ПолныйКод = КодВидаДоходов + КодПодвида + КодАнГруппы;//Сред(КодВидаДоходов,1,1) +" "+Сред(КодВидаДоходов,2,2) +" "+Сред(КодВидаДоходов,4,5) +" "+Сред(КодВидаДоходов,9,2) +" "+ КодПодвида +" "+ КодАнГруппы;//;
				
				Если ЗначениеЗаполнено(ЗначениеВида) ИЛИ ЭлКлДоходов <> 3 Тогда
					
					ИспользуемыйВидАналитики = Неопределено;
					СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(ПереченьАналитик, СтрокаПП.ВидАналитики,,ИспользуемыйВидАналитики);
					Если СценарийВвода <> Неопределено Тогда
						КлиентскийСценарий = БюджетнаяОтчетностьСервер.КлиентскийСценарийВвода(СценарийВвода);
						
						МассивСвязейОтбора = Новый Массив;
						
						Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
							Индекс = Позиция+1+СтрСвязь.Смещение;
							СтрокаАналитики = ПереченьАналитик[Индекс];
							Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
								КлиентскийСценарий.ФиксированныйОтбор.Вставить(СтрСвязь.ПолеОтбора, ТекСтрокаДанных[СтрокаАналитики.ИмяОбъектаАналитики]);
							КонецЕсли;
						КонецЦикла;
						
						КлиентскийСценарий.Вставить("ТребуетсяВызовСервера",Ложь);
						КлиентскийСценарий.Вставить("СвязиОтбора"          ,Новый Массив);
						Если ЗначениеЗаполнено(ИспользуемыйВидАналитики) Тогда
							КлиентскийСценарий.Вставить("ВидАналитикиСценария" ,ИспользуемыйВидАналитики);
						КонецЕсли;
						
						ТекущееЗначениеКода = ПолныйКод;
						//Возврат Ответ;
						
					КонецЕсли;
				ИначеЕсли ЭлКлДоходов = 3 Тогда
					
					КлиентскийСценарий = Новый Структура;
					КлиентскийСценарий.Вставить("ФормаВыбора"			,"Справочник.КОСГУ.ФормаВыбора");
					КлиентскийСценарий.Вставить("ЕстьКонтекстныйОтбор"	,Ложь);
					КлиентскийСценарий.Вставить("ЕстьСвязиВыбора"		,Ложь);
					КлиентскийСценарий.Вставить("ФиксированныйОтбор"	,Новый Структура);

					КлиентскийСценарий.Вставить("ТребуетсяВызовСервера",Ложь);
					КлиентскийСценарий.Вставить("СвязиОтбора"          ,Новый Массив);
						
					ТекущееЗначениеКода = ТекущееЗначение;
					//Возврат Ответ;
				КонецЕсли;
				
				Ответ = Новый Структура;
				Ответ.Вставить("СценарийВвода", КлиентскийСценарий);
				Ответ.Вставить("ТекущееЗначение", ТекущееЗначениеКода);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
		
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьВыборКИФ(Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки,Знач ЭлКлассификации)
	
	СинхронизироватьКонтекстНовыйВариант();
	Возврат ПодготовитьВыборКИФСервер(Объект, АдресОбъектаОтчет, ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭлКлассификации);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьВыборКИФСервер(Знач ТекОбъект,АдресОбъектаОтчет,Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки, ЭлКлКИФ)
	
	ОтчетОбъект = Неопределено;
	Ответ = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ПереченьАналитик = Неопределено;
    ТекСтрокаДанных = Неопределено;
    ЗаполнитьПереченьАналитикИСтрокуДанных(ГруппаРаскрытия, ИдентификаторСтроки, ОтчетОбъект, ТекОбъект, ПереченьАналитик, ТекСтрокаДанных);
	
	ПолныйКод = "";//Группа(4) + Статья(6) + Подвид(4) + АнГруппа(3)
	
	ЗначениеГруппы = Неопределено;
	ЗначениеСтатьи = Неопределено;
	ЗначениеПодвида = Неопределено;	
	ЗначениеАнГруппы = Неопределено;
	
	ПозицияГруппы = 0;
	ПозицияСтатьи = 0;
	ПозицияПодвида = 0;
	ПозицияАнГруппы = 0;
	
	СтрВидаАналитики = ПереченьАналитик.Найти(ВидАналитики, "ВидАналитики");
	Если СтрВидаАналитики <> Неопределено Тогда
		Позиция = ПереченьАналитик.Индекс(СтрВидаАналитики);
		
		Если ЭлКлКИФ = 1 Тогда			
			ПозицияГруппы = Позиция;
			ПозицияСтатьи = Позиция + 1;
			ПозицияПодвида = Позиция + 2;					
			ПозицияАнГруппы = Позиция + 3;
		КонецЕсли;	
		
		Если ЭлКлКИФ = 2 Тогда			
			ПозицияГруппы = Позиция - 1;
			ПозицияСтатьи = Позиция;
			ПозицияПодвида = Позиция + 1;
			ПозицияАнГруппы = Позиция + 2;
		КонецЕсли;
		
		Если ЭлКлКИФ = 3 Тогда			
			ПозицияГруппы = Позиция - 2;
			ПозицияСтатьи = Позиция - 1;
			ПозицияПодвида = Позиция;
			ПозицияАнГруппы = Позиция + 1;
		КонецЕсли;
		
		Если ЭлКлКИФ = 4 Тогда			
			ПозицияГруппы = Позиция - 3;
			ПозицияСтатьи = Позиция - 2;
			ПозицияПодвида = Позиция - 1;
			ПозицияАнГруппы = Позиция;
		КонецЕсли;
						
		Если ПозицияАнГруппы <= ПереченьАналитик.Количество()-1 
			И ПозицияАнГруппы >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияАнГруппы];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.КОСГУ")) Тогда
				ЗначениеАнГруппы = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияПодвида <= ПереченьАналитик.Количество()-1 
			И ПозицияПодвида >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияПодвида];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ВидыКИФ")) Тогда
				ЗначениеПодвида = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияСтатьи <= ПереченьАналитик.Количество()-1 
			И ПозицияСтатьи >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияСтатьи];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.СтатьиКИФ")) Тогда
				ЗначениеСтатьи = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияГруппы <= ПереченьАналитик.Количество()-1 
			И ПозицияГруппы >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияГруппы];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ГруппыПодгруппыКИФ")) Тогда
				ЗначениеГруппы = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
				
				КодГруппы = ПолучитьКодЭлементаКлассификатора(ЗначениеГруппы,"0000");
				КодСтатьи = ПолучитьКодЭлементаКлассификатора(ЗначениеСтатьи,"000000");
				КодПодвида = ПолучитьКодЭлементаКлассификатора(ЗначениеПодвида,"0000");
				КодАнГруппы = ПолучитьКодЭлементаКлассификатора(ЗначениеАнГруппы,"000");
				
				ПолныйКод = КодГруппы + КодСтатьи + КодПодвида + КодАнГруппы;
				
				ИспользуемыйВидАналитики = Неопределено;
				СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(ПереченьАналитик, СтрокаПП.ВидАналитики,,ИспользуемыйВидАналитики);
				КлиентскийСценарий = Неопределено;
				Если СценарийВвода <> Неопределено Тогда
					КлиентскийСценарий = БюджетнаяОтчетностьСервер.КлиентскийСценарийВвода(СценарийВвода);					
					МассивСвязейОтбора = Новый Массив;
					
					Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
						Индекс = Позиция+1+СтрСвязь.Смещение;
						СтрокаАналитики = ПереченьАналитик[Индекс];
						Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
							КлиентскийСценарий.ФиксированныйОтбор.Вставить(СтрСвязь.ПолеОтбора, ТекСтрокаДанных[СтрокаАналитики.ИмяОбъектаАналитики]);
						КонецЕсли;
					КонецЦикла;
					
					КлиентскийСценарий.Вставить("ТребуетсяВызовСервера",Ложь);
					КлиентскийСценарий.Вставить("СвязиОтбора"          ,Новый Массив);
					Если ЗначениеЗаполнено(ИспользуемыйВидАналитики) Тогда
						КлиентскийСценарий.Вставить("ВидАналитикиСценария" ,ИспользуемыйВидАналитики);
					КонецЕсли;
										
				КонецЕсли;
				
				Ответ = Новый Структура;
				Ответ.Вставить("СценарийВвода", КлиентскийСценарий);
				Ответ.Вставить("ТекущееЗначение", ПолныйКод);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат Ответ;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПереченьАналитикИСтрокуДанных(ГруппаРаскрытия, ИдентификаторСтроки, Знач ОтчетОбъект, Знач ТекОбъект, ПереченьАналитик, ТекСтрокаДанных)
	
	Перем СтрРаскрытия, УсловияПоиска;
	
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
		ТекСтрокаДанных = СтрРаскрытия.ТаблицаРаскрытия.Найти(ИдентификаторСтроки,"ID");
		
		ПереченьАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ОтчетОбъект.ВидОтчета);
		УсловияПоиска    = Новый Структура("ГруппаРаскрытия", ГруппаРаскрытия);
		ПереченьАналитик = ПереченьАналитик.Скопировать(УсловияПоиска);
	Иначе
		ПереченьАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ТекОбъект.ВидОтчета);
		ТекСтрокаДанных = ОтчетОбъект.ДополнительныеРеквизиты;
	КонецЕсли;
	
	ПереченьАналитик.Сортировать("ПорядковыйНомер");

КонецПроцедуры

&НаКлиенте
Функция ПодготовитьВыборПоЦС(Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки,Знач ЭлКлассификации)
	
	СинхронизироватьКонтекстНовыйВариант();
	Возврат ПодготовитьВыборПоЦССервер(Объект, АдресОбъектаОтчет, ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки, ЭлКлассификации);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьВыборПоЦССервер(Знач ТекОбъект,АдресОбъектаОтчет,Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки,ЭлКлассификации)

	ОтчетОбъект = Неопределено;
	Ответ = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ПереченьАналитик = Неопределено;
    ТекСтрокаДанных = Неопределено;
    ЗаполнитьПереченьАналитикИСтрокуДанных(ГруппаРаскрытия, ИдентификаторСтроки, ОтчетОбъект, ТекОбъект, ПереченьАналитик, ТекСтрокаДанных);
	
	ПолныйКод = "";//ЦС + Программа
	
	ЗначениеЦС = Неопределено;
	ЗначениеПрограммы = Неопределено;	
	
	ПозицияЦС = 0;
	ПозицияПрограммы = 0;
	
	СтрВидаАналитики = ПереченьАналитик.Найти(ВидАналитики, "ВидАналитики");
	Если СтрВидаАналитики <> Неопределено Тогда
		Позиция = ПереченьАналитик.Индекс(СтрВидаАналитики);
		
		Если ЭлКлассификации = 1 Тогда			
			ПозицияЦС = Позиция;
			ПозицияПрограммы = Позиция + 1;					
		КонецЕсли;	
		
		Если ЭлКлассификации = 2 Тогда			
			ПозицияЦС = Позиция - 1;
			ПозицияПрограммы = Позиция;
		КонецЕсли;
								
		Если ПозицияЦС <= ПереченьАналитик.Количество()-1 
			И ПозицияЦС >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияЦС];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ЦелевыеСтатьиКРБ")) Тогда
				ЗначениеЦС = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		Если ПозицияПрограммы <= ПереченьАналитик.Количество()-1 
			И ПозицияПрограммы >= 0 Тогда
			СтрокаПП = ПереченьАналитик[ПозицияПрограммы];
			ОписаниеТиповТекСтр = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаПП.ВидАналитики);
			Если ОписаниеТиповТекСтр.СодержитТип(Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ")) Тогда
				ЗначениеПрограммы = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
			КонецЕсли;
		КонецЕсли;
		
		КодЦС = ПолучитьКодЭлементаКлассификатора(ЗначениеЦС,"00000");
		КодПрограммы = ПолучитьКодЭлементаКлассификатора(ЗначениеПрограммы,"00000");
				
		ПолныйКод = КодЦС + КодПрограммы;
		
		СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(ПереченьАналитик, СтрокаПП.ВидАналитики);
		Если СценарийВвода <> Неопределено Тогда
			КлиентскийСценарий = БюджетнаяОтчетностьСервер.КлиентскийСценарийВвода(СценарийВвода);
			
			МассивСвязейОтбора = Новый Массив;
			
			Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
				Индекс = Позиция+1+СтрСвязь.Смещение;
				СтрокаАналитики = ПереченьАналитик[Индекс];
				Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
					КлиентскийСценарий.ФиксированныйОтбор.Вставить(СтрСвязь.ПолеОтбора, ТекСтрокаДанных[СтрокаАналитики.ИмяОбъектаАналитики]);
				КонецЕсли;
			КонецЦикла;
			
			КлиентскийСценарий.Вставить("ТребуетсяВызовСервера",Ложь);
			КлиентскийСценарий.Вставить("СвязиОтбора"          ,Новый Массив);
			
			Ответ = Новый Структура;
			Ответ.Вставить("СценарийВвода", КлиентскийСценарий);
			Ответ.Вставить("ТекущееЗначение", ПолныйКод);
						
		КонецЕсли;
		
	КонецЕсли;
		
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат Ответ;

КонецФункции

&НаКлиенте
Функция ПодготовитьВыборПрограммыЦС(Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки)
	
	СинхронизироватьКонтекстНовыйВариант();
	Возврат ПодготовитьВыборПрограммыЦССервер(Объект, АдресОбъектаОтчет, ВидАналитики, ТекущееЗначение, ГруппаРаскрытия, ИдентификаторСтроки);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьВыборПрограммыЦССервер(Знач ТекОбъект, АдресОбъектаОтчет, Знач ВидАналитики, Знач ТекущееЗначение, Знач ГруппаРаскрытия, Знач ИдентификаторСтроки)

	ОтчетОбъект = Неопределено;
	Ответ = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ПереченьАналитик = Неопределено;
    ТекСтрокаДанных = Неопределено;
    ЗаполнитьПереченьАналитикИСтрокуДанных(ГруппаРаскрытия, ИдентификаторСтроки, ОтчетОбъект, ТекОбъект, ПереченьАналитик, ТекСтрокаДанных);
		
	СтрВидаАналитики = ПереченьАналитик.Найти(ВидАналитики, "ВидАналитики");
	Если СтрВидаАналитики <> Неопределено Тогда
		Позиция = ПереченьАналитик.Индекс(СтрВидаАналитики);		
		
		//поиск подпрограммы, для классификации расходов ранее 2014 года
		Если Позиция+1 <= ПереченьАналитик.Количество()-1 Тогда
			СтрокаПП = ПереченьАналитик[Позиция+1];
			Если СтрокаПП.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ПодпрограммыЦелевыхСтатейКРБ")) Тогда
				ЗначениеПП = ТекСтрокаДанных[СтрокаПП.ИмяОбъектаАналитики];
				Если ЗначениеЗаполнено(ЗначениеПП) Тогда
					
					СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(ПереченьАналитик, СтрокаПП.ВидАналитики);
					Если СценарийВвода <> Неопределено Тогда
						КлиентскийСценарий = БюджетнаяОтчетностьСервер.КлиентскийСценарийВвода(СценарийВвода);
						
						МассивСвязейОтбора = Новый Массив;
						
						Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
							Индекс = Позиция+1+СтрСвязь.Смещение;
							СтрокаАналитики = ПереченьАналитик[Индекс];
							Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
								КлиентскийСценарий.ФиксированныйОтбор.Вставить(СтрСвязь.ПолеОтбора, ТекСтрокаДанных[СтрокаАналитики.ИмяОбъектаАналитики]);
							КонецЕсли;
						КонецЦикла;
						
						КлиентскийСценарий.Вставить("ТребуетсяВызовСервера",Ложь);
						КлиентскийСценарий.Вставить("СвязиОтбора"          ,Новый Массив);
						
						Ответ = Новый Структура;
						Ответ.Вставить("СценарийВвода", КлиентскийСценарий);
						Ответ.Вставить("ТекущееЗначение", ЗначениеПП);
												
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
	Возврат Ответ;
	
КонецФункции // ПодготовитьВыборПрограммыЦССервер() 


&НаСервереБезКонтекста
Функция ПолучитьКодЭлементаКлассификатора(ЗначениеЭлемента,ПустоеЗначение)
	Если ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
		Если ТипЗнч(ЗначениеЭлемента) = Тип("Строка") Тогда
			КодЭлемента = ЗначениеЭлемента;
		Иначе
			КодЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеЭлемента,"Код");
		КонецЕсли;
	Иначе
		КодЭлемента = ПустоеЗначение;
	КонецЕсли;
	
	Возврат КодЭлемента;
КонецФункции

// Получает значения окружающих аналитик из контекста отчета.
//
&НаСервере
Функция ПолучитьОтборИзКонтекстаОтчета(Знач ГруппаРаскрытия, Знач ИдентификаторСтроки, Знач СвязиОтбора) Экспорт 

	СинхронизироватьКонтекстСервер(Ложь);
	
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
	
	ТекСтрокаДанных = СтрРаскрытия.ТаблицаРаскрытия.Найти(ИдентификаторСтроки,"ID");
	
	КонтекстныйОтбор = Новый Структура;
	
	Для Каждого Связь Из СвязиОтбора Цикл
		Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти(Связь.ИмяОбласти) <> Неопределено Тогда
			КонтекстныйОтбор.Вставить(Связь.ИмяПоля,ТекСтрокаДанных[Связь.ИмяОбласти]);
		КонецЕсли;
	КонецЦикла;

	ПоместитьОбъектОтчета();
	
	Возврат КонтекстныйОтбор;
	
КонецФункции 

// Выполняет суммирование значений в выделенных ячейках.
//
&НаКлиенте
Функция ПолучитьАвтосуммуПоказателей(ТабличныйДокумент)
 
	СуммаЗначений = 0;
	ОбработанныеОбласти = Новый Соответствие;
	
	Если мСоответствиеПоиска = Неопределено Тогда
		СоответствиеЧужихСкрытыхСтрок = Новый Соответствие;
	Иначе
		СоответствиеЧужихСкрытыхСтрок = Новый Соответствие;
		Попытка
			Для Каждого КлючИЗначение Из мСоответствиеПоиска Цикл
				Для Каждого ЭлМас Из КлючИЗначение.Значение Цикл
					ТекущаяСкрытаяОбласть = ТабличныйДокументОтчета.Область(ЭлМас);
					СоответствиеЧужихСкрытыхСтрок.Вставить(ТекущаяСкрытаяОбласть.Верх,ТекущаяСкрытаяОбласть.Низ);
				КонецЦикла;
			КонецЦикла;
		Исключение
			СоответствиеЧужихСкрытыхСтрок = Новый Соответствие;	
		КонецПопытки;
		
	КонецЕсли;
	
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	Для Каждого Область Из ТекВыделенныеОбласти Цикл
		
		Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") или Область.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Продолжить;
		КонецЕсли;
		
		Для СчСтрок = Область.Верх По Область.Низ Цикл
			Для СчКолонок = Область.Лево По Область.Право Цикл
				
				ТекущаяОбласть = ТабличныйДокумент.Область(СчСтрок,СчКолонок);
				Если Не (ТекущаяОбласть.СодержитЗначение И ТипЗнч(ТекущаяОбласть.Значение) = Тип("Число")) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТабличныйДокумент.Область(ТекущаяОбласть.Верх,,ТекущаяОбласть.Низ).Видимость = Неопределено Тогда
					Если СоответствиеЧужихСкрытыхСтрок[ТекущаяОбласть.Верх] = ТекущаяОбласть.Низ Тогда
						Продолжить;	
					КонецЕсли;
				КонецЕсли;
				
				ИмяОбласти = ТекущаяОбласть.Имя;
				
				// ТабличныйДокумент может добавлять в ВыделенныеОбласти одни и те же ячейки.
				// Обработаем данную ситуацию.
				Если ОбработанныеОбласти[ИмяОбласти] = Неопределено Тогда
					ОбработанныеОбласти.Вставить(ИмяОбласти,Истина);
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ТекущаяОбласть.Видимость = Истина Тогда
					СуммаЗначений = СуммаЗначений + ТекущаяОбласть.Значение;
				КонецЕсли;	
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;

	Возврат СуммаЗначений;
	
КонецФункции // ПолучитьАвтосуммуПоказателей()

&НаКлиенте
Процедура НастройкаСпискаРаскрытияТабличныйДокумент(ОчищатьНастроки = Ложь)

	АдресСтрокиРаскрытия = ПолучитьАдресСтрокиРаскрытия(Элементы.ТабличныйДокументОтчета.ТекущаяОбласть.Имя);
	Если Не АдресСтрокиРаскрытия = Неопределено Тогда
		
		Если ОчищатьНастроки = Истина Тогда
			
			ПрименитьНастройкуСписка(АдресСтрокиРаскрытия.КодСтроки,Неопределено);
			ОбновитьУстановленныеОтборы();
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы   = Новый Структура;
		ТекущиеНастройки = Новый Структура("КодСтроки,АдресОтчета",АдресСтрокиРаскрытия.КодСтроки,АдресОбъектаОтчет);
		ПараметрыФормы.Вставить("ТекущиеНастройки"	,ТекущиеНастройки);
		ПараметрыФормы.Вставить("ВидОтчета"			,Объект.ВидОтчета);
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяФормы","Документ.УниверсальныйРегламентированныйОтчет.Форма.НастройкаСписка"); 
		ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
		ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
		ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
		
		СтруктураДляОбработкиРезультата = Новый Структура;
		
		СтруктураДляОбработкиРезультата.Вставить("Источник","НастройкаСпискаРаскрытияТабличныйДокумент");
		СтруктураДляОбработкиРезультата.Вставить("КодСтрокиСтрокиРаскрытия",АдресСтрокиРаскрытия.КодСтроки);
		
		ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураДляОбработкиРезультата)); 
		
		БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ПереместитьСтокуРаскрытияТабличныйДокумент(Смещение)
	
	АдресСтрокиРаскрытия = ПолучитьАдресСтрокиРаскрытия(Элементы.ТабличныйДокументОтчета.ТекущаяОбласть.Имя);
	
	Если АдресСтрокиРаскрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если СтрЗаканчиваетсяНа(АдресСтрокиРаскрытия.ИмяИсходнойОбласти,"РазметкаПустойСтроки") Тогда
		Возврат;
	КонецЕсли;
	
	ВходящиеПараметры = Новый Структура;
	ВходящиеПараметры.Вставить("АдресОбъектаОтчет",АдресОбъектаОтчет);
	ВходящиеПараметры.Вставить("ВыводитьРаскрытиеВТелеБланка",Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
	ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
	ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
	
	ПереместитьСтрокуРаскрытияТабличныйДокументБезКонтекста(Объект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры,АдресСтрокиРаскрытия.КодГруппыРаскрытия,АдресСтрокиРаскрытия.КодСтроки, АдресСтрокиРаскрытия.Идентификатор, Смещение);

	Модифицированность = Истина;
	
	ОжидаемоеИмяНовойОбласти = АдресСтрокиРаскрытия.ИмяИсходнойОбласти +"_"+ (АдресСтрокиРаскрытия.Идентификатор + Смещение);
	НайденаяОбласть = ТабличныйДокументОтчета.Области.Найти(ОжидаемоеИмяНовойОбласти);
	Если НайденаяОбласть = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Элементы.ТабличныйДокументОтчета.УстановитьВыделенныеОбласти(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НайденаяОбласть));	
	
	ОбновитьУстановленныеОтборы();
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ПереместитьСтрокуРаскрытияТабличныйДокументБезКонтекста(Знач ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры,КодГруппыРаскрытия, КодСтроки, ИДСтроки, Смещение)
	
	АдресОбъектаОтчет = ВходящиеПараметры.АдресОбъектаОтчет;
	
	ОтчетОбъект = СинхронизироватьКонтекстБезКонтекста(Истина,ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры);

	СтрокаРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
	ТаблицаРаскрытия = СтрокаРаскрытия.ТаблицаРаскрытия; 
	ПеремещаемаяСтрока = ТаблицаРаскрытия.Найти(ИДСтроки,"ID");
	Если ПеремещаемаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ТаблицаРаскрытия.Индекс(ПеремещаемаяСтрока) = 0 и Смещение < 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТаблицаРаскрытия.Индекс(ПеремещаемаяСтрока) = ТаблицаРаскрытия.Количество() - 1 и Смещение > 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	СтрокаРаскрытия.РучнаяСортировка = Истина;
	
	ТаблицаРаскрытия.Сдвинуть(ПеремещаемаяСтрока, Смещение);
	
	ПеренумероватьТаблицуРаскрытия(СтрокаРаскрытия.ТаблицаРаскрытия);
	
	ПересчитатьИОтобразитьСтрокуРаскрытия(ОтчетОбъект,ТабличныйДокументОтчета,СтрокаРаскрытия,КодГруппыРаскрытия,ВходящиеПараметры);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
		
КонецПроцедуры

&НаСервере
Функция ОбработатьПризнакПромежуточногоИтогаСервер(Знач ВыделенныеОбласти, ДанныеДляУточнения = Неопределено)

	ВосстановитьОбъектОтчета();
	
	ТаблицаПоказателей = ПолучитьТаблицуВыделенныхПоказателейВТабличномДокументе(ВыделенныеОбласти,2);
	
	СчетчикиЗначений 		= Новый Структура("Истина,Ложь",0,0);
	НеразрешенныеПоказатели = Ложь;
	
	ТаблицаДанныхРаскрытия = Новый ТаблицаЗначений;
	
	ТаблицаДанныхРаскрытия.Колонки.Добавить("СтрокаТаблицыРаскрытия");
	ТаблицаДанныхРаскрытия.Колонки.Добавить("ДанныеРаскрытия");
	ТаблицаДанныхРаскрытия.Колонки.Добавить("ДанныеПоказателя");
	ТаблицаДанныхРаскрытия.Колонки.Добавить("ТекПромежуточныйИтог");
	
	Если ТаблицаПоказателей.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать несколько показателей, либо группу строк/колонок таблицы.'"));
		Возврат Ложь;
	Иначе
	
		Для Каждого Стр Из ТаблицаПоказателей Цикл
			
			Если Стр.ДанныеПоказателя.РазрешитьПромежуточныеИтоги Тогда
				
				СтрДанных = ТаблицаДанныхРаскрытия.Добавить();
				СтрДанных.СтрокаТаблицыРаскрытия = Стр.СтрокаТаблицыРаскрытия;
				СтрДанных.ДанныеРаскрытия	 	 = Стр.ИнформацияОРаскрытии;
				СтрДанных.ДанныеПоказателя		 = Стр.ДанныеПоказателя;
				
				Если Найти(Стр.СтрокаТаблицыРаскрытия.ПромежуточныеИтоги,","+Стр.КодПоказателя+",") > 0 Тогда
					// Сейчас у этого показателя установлен признак П.И.
					СчетчикиЗначений.Истина = СчетчикиЗначений.Истина + 1;
					СтрДанных.ТекПромежуточныйИтог = Истина;
				Иначе
					// Признак П.И. у показателя не установлен.
					СчетчикиЗначений.Ложь   = СчетчикиЗначений.Ложь + 1;
					СтрДанных.ТекПромежуточныйИтог = Ложь;
				КонецЕсли;
				
			Иначе
				НеразрешенныеПоказатели = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Обработка строк.
	Если ТаблицаДанныхРаскрытия.Количество() > 0 Тогда
		
		Если СчетчикиЗначений.Истина > СчетчикиЗначений.Ложь Тогда
			НовоеЗначениеПромежуточногоИтога = Ложь;
		Иначе
			НовоеЗначениеПромежуточногоИтога = Истина;
		КонецЕсли;
		
		// Запрос пользователя на установку промежуточного итога
		Если НовоеЗначениеПромежуточногоИтога = Истина И СчетчикиЗначений.Истина > 0
			 или НовоеЗначениеПромежуточногоИтога = Ложь И СчетчикиЗначений.Ложь > 0 Тогда
		
			// Требуется уточнение от пользователя.
			ДанныеДляУточнения = Новый Структура;
			ДанныеДляУточнения.Вставить("ЗначениеПромежуточногоИтога",НовоеЗначениеПромежуточногоИтога);
			ДанныеДляУточнения.Вставить("АдресТаблицыРаскрытия"		 ,ПоместитьВоВременноеХранилище(ТаблицаДанныхРаскрытия,УникальныйИдентификатор));
			
			Возврат Ложь;
			
		Иначе
			
			УстановитьЗначениеПромежуточногоИтога(ТаблицаДанныхРаскрытия,НовоеЗначениеПромежуточногоИтога);
			Возврат Истина;
			
		КонецЕсли;
		
	ИначеЕсли НеразрешенныеПоказатели Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ПоместитьОбъектОтчета();

КонецФункции // ОбработатьПризнакПромежуточногоИтогаСервер()

&НаСервере
Процедура УстановитьЗначениеПромежуточногоИтога(ТаблицаДанныхРаскрытия,НовоеЗначениеПромежуточногоИтога)

	// Установка новых значений промежуточного итога.
	Для Каждого СтрДанных Из ТаблицаДанныхРаскрытия Цикл
		
		КодПоказателя 			= СтрДанных.ДанныеПоказателя.Код;
		СтрокаТаблицыРаскрытия  = СтрДанных.СтрокаТаблицыРаскрытия;
		
		Если НовоеЗначениеПромежуточногоИтога <> СтрДанных.ТекПромежуточныйИтог Тогда
			Если НовоеЗначениеПромежуточногоИтога = Истина Тогда
				СтрокаТаблицыРаскрытия.ПромежуточныеИтоги = СтрокаТаблицыРаскрытия.ПромежуточныеИтоги + "," + КодПоказателя + ",";
			Иначе
				СтрокаТаблицыРаскрытия.ПромежуточныеИтоги = СтрЗаменить(СтрокаТаблицыРаскрытия.ПромежуточныеИтоги,"," + КодПоказателя + ",","");
			КонецЕсли;
		КонецЕсли;
		
		ИмяИзмененнойОбласти = СокрП(СтрДанных.ДанныеПоказателя.КодГруппыРаскрытия) 
								+ "_" 
								+ СтрДанных.ДанныеРаскрытия.КодСтроки 
								+ "_Показатель_" 
								+ КодПоказателя + "_"
								+ Формат(СтрДанных.СтрокаТаблицыРаскрытия.ID,"ЧН=0; ЧГ=0");
								
		Если Не ИзмененныеОбласти.Свойство(ИмяИзмененнойОбласти) Тогда
			ИзмененныеОбласти.Вставить(ИмяИзмененнойОбласти,СтрДанных.СтрокаТаблицыРаскрытия[КодПоказателя+"_Отображение"]);
		КонецЕсли;
		
	КонецЦикла;
	
	СинхронизироватьКонтекстСервер();

КонецПроцедуры // УстановитьЗначениеПромежуточногоИтога()

&НаСервере
Процедура ОбработатьПользовательскийВыборПромежуточногоИтога(РезультатВыбора) 

	ТаблицаДанных = ПолучитьИзВременногоХранилища(РезультатВыбора.АдресТаблицыРаскрытия);
	НовоеЗначение = РезультатВыбора.ЗначениеПромежуточногоИтога;
	
	УстановитьЗначениеПромежуточногоИтога(ТаблицаДанных,НовоеЗначение);
	УдалитьИзВременногоХранилища(РезультатВыбора.АдресТаблицыРаскрытия);

КонецПроцедуры // ОбработатьПользовательскийВыборПромежуточногоИтога()

// расшифровка контрольных соотношений

// Отображает отчет в режиме расшифровки показателей.
&НаСервере
Процедура ОтобразитьОтчетВРежимеРасшифровки(Отказ)

	Перем ДанныеДляОтображения;
	
	ИнформацияОРасшифровке = Параметры.ДанныеРасшифровки;
	ВыводитьДлинныеПоляВОднуСтроку = Истина;
	
	Если ТипЗнч(ИнформацияОРасшифровке) <> Тип("Структура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеРасшифровки   = ПолучитьИзВременногоХранилища(ИнформацияОРасшифровке.АдресХранилища);
	ЗначениеРасшифровки = ДанныеРасшифровки[ИнформацияОРасшифровке.Идентификатор];
	
	Если ТипЗнч(ЗначениеРасшифровки) = Тип("Структура") Тогда
		Если ЗначениеРасшифровки.Свойство("Операнд") Тогда
			РежимРасшифровки = "Операнд";
			Операнд 		 = ЗначениеРасшифровки.Операнд;
		Иначе
			РежимРасшифровки = "Показатель";
		КонецЕсли;
		
		Если ЗначениеРасшифровки.Свойство("ДокументСсылка") Тогда
			ОтчетСсылка = ЗначениеРасшифровки.ДокументСсылка;
		ИначеЕсли ЗначениеРасшифровки.Свойство("Регистратор") Тогда
			ОтчетСсылка = ЗначениеРасшифровки.Регистратор;
		КонецЕсли;
		
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
	Если РежимРасшифровки = "Операнд" Тогда
		
		СтруктураОтбораРасшифровки  = Новый Структура;
		
		Если ЗначениеРасшифровки.Свойство("ОтборПоАналитике") Тогда
			Если Не ЗначениеРасшифровки.ОтборПоАналитике = Неопределено Тогда
				Для Каждого ЭлементОтбора Из ЗначениеРасшифровки.ОтборПоАналитике Цикл
					Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
						СтруктураОтбораРасшифровки.Вставить(ЭлементОтбора.Ключ,Новый Структура("ВидСравнения,Значение",ВидСравнения.ВСписке,ЭлементОтбора.Значение));
					Иначе
						СтруктураОтбораРасшифровки.Вставить(ЭлементОтбора.Ключ,Новый Структура("ВидСравнения,Значение",ВидСравнения.Равно,ЭлементОтбора.Значение));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ИнформацияОРасшифровке.Свойство("ОбъектИсточник") Тогда
			// Возможно, есть инициализированный отчет.
			Если ИнформацияОРасшифровке.ОбъектИсточник = Объект.Ссылка Тогда
				ИсточникРасшифровки = РеквизитФормыВЗначение("Объект");
			Иначе
				ИсточникРасшифровки = ОтчетСсылка.ПолучитьОбъект();
			КонецЕсли;
		Иначе
			ИсточникРасшифровки	 = ОтчетСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		ИсточникРасшифровки.ПроверитьКонтекстИнициализирован();
		ДанныеДляОтображения = ИсточникРасшифровки.СобратьДанныеДляРасшифровки(Операнд,СтруктураОтбораРасшифровки);
		
	ИначеЕсли РежимРасшифровки = "Показатель" Тогда
		// Расшифровка показателя, заполненного автоматически.
		
		Показатель = Неопределено;
		Регистратор = Неопределено;
		
		ЗначениеРасшифровки.Свойство("Показатель", Показатель);
		ЗначениеРасшифровки.Свойство("Регистратор",Регистратор);
		
		Если Показатель = Неопределено ИЛИ Регистратор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(Показатель) = Тип("Массив") Тогда
			Массив = Показатель;
		Иначе
			Массив = Новый Массив;
			Если ТипЗнч(Показатель) = Тип("Строка") Тогда
				Массив.Добавить(Показатель);
			Иначе
				Массив.Добавить(Показатель.Код);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(Регистратор) = Тип("Массив") Тогда
			РегистраторМассивом		= Регистратор;
		Иначе	
			РегистраторМассивом 	= Новый Массив(1);
			РегистраторМассивом[0]  = Регистратор;
		КонецЕсли;
		
		ДанныеДляОтображения = Новый Структура;
		ДанныеДляОтображения.Вставить("МассивПоказателей"	,Массив);
		ДанныеДляОтображения.Вставить("МассивОтчетов" 		,РегистраторМассивом);
		
		Если ЗначениеРасшифровки.Свойство("ОтборПоАналитике") Тогда
			ДанныеДляОтображения.Вставить("СтруктураАналитикОтбора" ,ЗначениеРасшифровки.ОтборПоАналитике);
		Иначе
			ДанныеДляОтображения.Вставить("СтруктураАналитикОтбора",Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеДляОтображения <> Неопределено Тогда
		ВывестиРасшифровкуЗначенийПоказателей(ДанныеДляОтображения, Отказ);
	КонецЕсли;
		
КонецПроцедуры // ОтобразитьОтчетВРежимеРасшифровки()

// Формирует структуру, необходимую для передачи в форму РедактированиеРаскрытия
//
&НаСервере
Функция ПолучитьДанныеОтображенияРаскрытияВОтдельномОкне(СтрРаскрытия)

	ДанныеРаскрытия = Новый Структура;
	ДанныеРаскрытия.Вставить("ТаблицаРаскрытия",СтрРаскрытия.ТаблицаРаскрытия);
	ДанныеРаскрытия.Вставить("ОтборПоРаскрытию",СтрРаскрытия.ОтборПоРаскрытию);
	ДанныеРаскрытия.Вставить("ПоляСортировки"  ,СтрРаскрытия.ПоляСортировки);
	ДанныеРаскрытия.Вставить("РучнаяСортировка",СтрРаскрытия.РучнаяСортировка);
	
	КодГруппыРаскрытия = ПараметрыГруппРаскрытия.НайтиСтроки(
							Новый Структура("ГруппаРаскрытия", СтрРаскрытия.ГруппаРаскрытия))[0].КодГруппыРаскрытия;
	
	ДанныеРаскрытия.Вставить("МакетыРаскрытия" ,ОтчетОбъект.ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия));
	
	Возврат ДанныеРаскрытия;

КонецФункции // ПолучитьДанныеОтображенияРаскрытияВОтдельномОкне()

// Заполняет отчет, устанавливает отборы, выделяет расшифровываемые показатели.
//
&НаСервере
Процедура ВывестиРасшифровкуЗначенийПоказателей(Знач ДанныеДляОтображения, Отказ)
 
	Если ДанныеДляОтображения.МассивОтчетов.Количество() = 0 Тогда 
		
		Отказ = Истина;
		Возврат;
		
	ИначеЕсли ДанныеДляОтображения.МассивОтчетов.Количество() = 1 Тогда
		
		ПараметрыДополнительныхРасшифровок = ВывестиРасшифровкуДляОдногоОтчетаИсточника(ДанныеДляОтображения);
		Если ПараметрыДополнительныхРасшифровок = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ПараметрыДополнительныхРасшифровок = Новый Структура;
		
		ОтчетОбъект 		 = ДанныеДляОтображения.МассивОтчетов[0].ПолучитьОбъект();
		СтруктураРасшифровки = ОтчетОбъект.ТабличныйДокументРасшифровкиСпискаОтчетов(ДанныеДляОтображения.МассивОтчетов,ДанныеДляОтображения.МассивПоказателей,ДанныеДляОтображения.СтруктураАналитикОтбора);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресДанныхОтображения",ПоместитьВоВременноеХранилище(СтруктураРасшифровки));
		ПараметрыДополнительныхРасшифровок.Вставить("РасшифровкаПоказателей",ПараметрыФормы);
		
	КонецЕсли;

	ДанныеДляОтображенияРасшифровки = ПараметрыДополнительныхРасшифровок;
	
КонецПроцедуры // ВывестиРасшифровкуЗначенийПоказателей()

&НаСервере
Функция ВывестиРасшифровкуДляОдногоОтчетаИсточника(Знач ДанныеДляОтображения)

	ПараметрыДополнительныхРасшифровок = Новый Структура;
	
	ОтчетОбъект = ДанныеДляОтображения.МассивОтчетов[0].ПолучитьОбъект();
	
	ЗначениеВРеквизитФормы(ОтчетОбъект,"Объект");
	ИнициализироватьОтчет(ОтчетОбъект);
	УстановитьВидимостьЭлементовОтображения();
	
	Если ДанныеДляОтображения.МассивПоказателей.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаполнитьПараметрыГруппРаскрытия();
	
	СтрПоказатель = ОтчетОбъект.мПоказатели.Найти(ДанныеДляОтображения.МассивПоказателей[0],"Код");
	Если ОтчетОбъект.мЧислоДопАналитик > 0 
		 И НЕ (ДанныеДляОтображения.СтруктураАналитикОтбора = Неопределено 
		 	ИЛИ ДанныеДляОтображения.СтруктураАналитикОтбора.Количество() = 0) Тогда
		
		СтруктураОтбора = ДанныеДляОтображения.СтруктураАналитикОтбора;
		
	Иначе
		
		СтруктураОтбора = Неопределено;
		
	КонецЕсли;
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ЗаполнитьТаблицуРедактированияВРежимеРасшифровки(СтрПоказатель, СтруктураОтбора, ПараметрыДополнительныхРасшифровок);
	Иначе
		ЗаполнитьБланкОтчетаВРежимеРасшифровки(СтрПоказатель, СтруктураОтбора, ПараметрыДополнительныхРасшифровок);
	КонецЕсли;
	
	// Помещение объекта в хранилище.
	АдресОбъектаОтчет = ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,УникальныйИдентификатор);
	
	Возврат ПараметрыДополнительныхРасшифровок;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ РЕЖИМА РАСШИФРОВКИ
//

&НаСервере
Процедура ЗаполнитьТаблицуРедактированияВРежимеРасшифровки(Знач СтрПоказатель, Знач СтруктураОтбора, ПараметрыДополнительныхРасшифровок)

	МакетОтображения = ПолучитьМакетОтображения(АдресНастроекОтчета,мМакетОтображенияВТаблице);
	СтрокаРаздела = Неопределено;
	РазделСтроки  = Неопределено;
	
	Для Каждого Раздел Из МакетОтображения.Разделы Цикл
		СтрокаРаздела = Раздел.СтрокиРаздела.Найти(СтрПоказатель.КодСтрока,"Код");
		Если СтрокаРаздела <> Неопределено Тогда
			РазделСтроки = Раздел;
			Прервать;
		КонецЕсли;
	КонецЦикла;
 
	Если РазделСтроки = Неопределено Тогда
		ПараметрыДополнительныхРасшифровок = Неопределено;
		Возврат;
	КонецЕсли;
	
	ЕстьОтборПоСтрокамРаскрытия = СтруктураОтбора <> Неопределено;
	Если ЕстьОтборПоСтрокамРаскрытия Тогда
		
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(СтрПоказатель.КодСтрока,"КодСтроки");
		
		Если СтрРаскрытия = Неопределено Тогда
			СтрРаскрытия = ОтчетОбъект.РаскрытьСтрокуПоАналитике(СтрПоказатель.КодСтрока);
			Если СтрРаскрытия = Неопределено Тогда
				ПараметрыДополнительныхРасшифровок = Неопределено;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СтрРаскрытия.ОтборПоРаскрытию = СтруктураОтбора;
		
		ВывестиДанныеОтчета();
		
	Иначе 
		
		ВывестиДанныеОтчета();
		
	КонецЕсли;
	
	// Оформление и позиционирование в форме
	ТекИмяРаздела = ИмяТаблицыРаздела(РазделСтроки);
	Элементы.РазделыМакета.ТекущаяСтраница = Элементы["Страница"+ТекИмяРаздела];
	
	ЭлементТаблица = Элементы[ТекИмяРаздела];
	
	ДанныеФормыТаблица = ЭтаФорма[ЭлементТаблица.ПутьКДанным];
	ТекущаяСтрокаТаблицы = Неопределено;
	Для Каждого СтрТаблицы Из ДанныеФормыТаблица Цикл
		Если СтрТаблицы.КодСтроки = СтрПоказатель.КодСтрока Тогда
			ТекущаяСтрокаТаблицы = СтрТаблицы.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ТекущаяСтрокаТаблицы = Неопределено Тогда
		ЭлементТаблица.ТекущаяСтрока = ТекущаяСтрокаТаблицы;
	КонецЕсли;
	
	ИмяЭлементаПоказателя = ТекИмяРаздела+СтрПоказатель.КодКолонки;
	Если Элементы.Найти(ИмяЭлементаПоказателя) <> Неопределено Тогда
		
		ЭтаФорма.ТекущийЭлемент = Элементы[ИмяЭлементаПоказателя];
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт"   , Новый Шрифт(,,Истина));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",  WebЦвета.Розовый);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле          = Новый ПолеКомпоновкиДанных(ИмяЭлементаПоказателя);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицыРаздела(РазделСтроки)+".КодСтроки");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = СтрПоказатель.КодСтрока;
		ЭлементОтбора.Использование  = Истина;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьТаблицуРедактированияВРежимеРасшифровки()

&НаСервере
Процедура ЗаполнитьБланкОтчетаВРежимеРасшифровки(Знач СтрПоказатель, Знач СтруктураОтбора, ПараметрыДополнительныхРасшифровок)

	ЕстьОтборПоСтрокамРаскрытия = СтруктураОтбора <> Неопределено;
	
	Найдено = ОпределитьСтраницуБланкаДляРасшифровки(ДеревоСтраниц.ПолучитьЭлементы(),СтрПоказатель);
	Если НЕ Найдено Тогда
		//Не найдена страница с показателем, выведем первую
		ТекСтраница = ДеревоСтраниц.ПолучитьЭлементы()[0];
		мИмяТекущейСтраницы = ТекСтраница.ИмяСтраницы;
		АдресТекущейСтраницы = ТекСтраница.АдресБланка;
				 
		ОтчетОбъект.мНастройкиБланка = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
			
		ВывестиСтраницуОтчета(ТекСтраница.АдресБланка,Неопределено);

	КонецЕсли;
	
	Если ЕстьОтборПоСтрокамРаскрытия Тогда
		
	    КодСтроки = СтрПоказатель.КодСтрока;
		СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
		
		Если СтрРаскрытия = Неопределено Тогда
			СтрРаскрытия = ОтчетОбъект.РаскрытьСтрокуПоАналитике(КодСтроки);
			Если СтрРаскрытия = Неопределено Тогда
				ПараметрыДополнительныхРасшифровок = Неопределено;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СтрРаскрытия.ОтборПоРаскрытию = СтруктураОтбора;
		
		ПараметрыГруппы = ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки",СтрРаскрытия.КодСтроки))[0];
		МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
		МакетРаскрытия  = МакетыРаскрытия.Строка;
		
		Если МакетРаскрытия = Неопределено Тогда
			
			ДанныеРаскрытия = ПолучитьДанныеОтображенияРаскрытияВОтдельномОкне(СтрРаскрытия);
			Возврат;
		КонецЕсли;
		
		УстановитьФильтрВТабличномДокументе(СтрРаскрытия,Истина,СтрПоказатель,МакетРаскрытия);
		
		ОбластьПоказателя = ТабличныйДокументОтчета.Области.Найти(СтрПоказатель.Код);
		Если ОбластьПоказателя = Неопределено Тогда
			ОбластьПоказателя = ТабличныйДокументОтчета.Области.Найти("Строка_" + СтрПоказатель.КодСтрока);
		КонецЕсли;	
				
		Если НЕ ОбластьПоказателя = Неопределено Тогда
			Элементы.ТабличныйДокументОтчета.ТекущаяОбласть = ТабличныйДокументОтчета.Область(ОбластьПоказателя.Верх,ОбластьПоказателя.Лево);
		КонецЕсли;
			
	Иначе
		
		ОбластьПоказателя = ТабличныйДокументОтчета.Области.Найти(СтрПоказатель.Код);
		Если ОбластьПоказателя = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,2);
		ОбластьПоказателя.Обвести(Линия,Линия,Линия,Линия);
		ОбластьПоказателя.ЦветРамки = WebЦвета.Красный;
		ОбластьПоказателя.ЦветФона = WebЦвета.Розовый;
		Элементы.ТабличныйДокументОтчета.ТекущаяОбласть = ТабличныйДокументОтчета.Область(ОбластьПоказателя.Верх,ОбластьПоказателя.Лево);
				
	КонецЕсли;

КонецПроцедуры // ЗаполнитьБланкОтчетаВРежимеРасшифровки()

// Формирует список областей показателей, выделенных в документе.
//
&НаКлиенте
Функция СписокВыделенныхОбластейПоказателей()

	СписокОбластей = Новый Массив;
		
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	ТабДокумент	   = ТабличныйДокументОтчета;
	
	Для Каждого ВыделеннаяОбласть Из ТекВыделенныеОбласти Цикл
		
		Если ВыделеннаяОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			ТекущаяОбласть = ВыделеннаяОбласть;
		ИначеЕсли ВыделеннаяОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
			ТекущаяОбласть = ТабДокумент.Область(1,ВыделеннаяОбласть.Лево,ТабДокумент.ВысотаТаблицы,ВыделеннаяОбласть.Право);
		ИначеЕсли ВыделеннаяОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Колонки Тогда
			ТекущаяОбласть = ТабДокумент.Область(ВыделеннаяОбласть.Верх,1,ВыделеннаяОбласть.Низ,ТабДокумент.ШиринаТаблицы);
		Иначе
			Возврат Новый Массив; // Дальнейший перебор областей не выполняем.
		КонецЕсли;
		
		Для СчСтрок = ТекущаяОбласть.Верх По ТекущаяОбласть.Низ Цикл
			Для СчКолонок = ТекущаяОбласть.Лево По ТекущаяОбласть.Право Цикл
				
				Ячейка = ТабДокумент.Область(СчСтрок,СчКолонок);
				
				Если Найти(Ячейка.Имя,"_") <> 0 
					И СписокОбластей.Найти(Ячейка.Имя) = Неопределено Тогда
					СписокОбластей.Добавить(Ячейка.Имя);
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат СписокОбластей;
	
КонецФункции // СписокВыделенныхОбластейПоказателей()

&НаСервере
Функция НоваяТаблицаВыделенныхПоказателей()

	ТаблицаВыделенныхПоказателей = Новый ТаблицаЗначений;
	ТаблицаВыделенныхПоказателей.Колонки.Добавить("Показатель");
	ТаблицаВыделенныхПоказателей.Колонки.Добавить("СтрокаТаблицыРаскрытия");
	ТаблицаВыделенныхПоказателей.Колонки.Добавить("ИнформацияОРаскрытии");
	ТаблицаВыделенныхПоказателей.Колонки.Добавить("ДанныеПоказателя");
	ТаблицаВыделенныхПоказателей.Колонки.Добавить("КодПоказателя");
	
	Возврат ТаблицаВыделенныхПоказателей;

КонецФункции // ТаблицаВыделенныхПоказателей()

// Разбор имен выделенных ячеек, определение выделенных показателей.
//
// Параметры:
//	ВидыОбластей - Число. 0 - все области
//						  1 - области итоговых показателей
//						  2 - области показателей раскрытия.
&НаСервере
Функция ПолучитьТаблицуВыделенныхПоказателейВТабличномДокументе(Знач ВыделенныеОбласти, Знач ВидыОбластей = 0, ВернутьАдресВХранилище = Ложь)

	СинхронизироватьКонтекстСервер(Ложь,Ложь);
	ТаблицаВыделенныхПоказателей = НоваяТаблицаВыделенныхПоказателей();
	
	Для Каждого ИмяОбласти Из ВыделенныеОбласти Цикл
		
		ПозПоказатель = Найти(ИмяОбласти,"_Показатель_");
		
		Если ВидыОбластей <> 1 И ПозПоказатель > 0 Тогда
			
			АдресСтрокиРаскрытия = АдресСтрокиРаскрытияБезКонтекста(ИмяОбласти, ПараметрыГруппРаскрытия);
			
			Если АдресСтрокиРаскрытия = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КодПоказателя   = Сред(АдресСтрокиРаскрытия.ИмяИсходнойОбласти,ПозПоказатель+12);
			ДанныеРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(АдресСтрокиРаскрытия.КодСтроки,"КодСтроки");
			СтрПоказатель	= ОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
			
			Если СтрПоказатель = Неопределено 
				ИЛИ ДанныеРаскрытия = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока = ДанныеРаскрытия.ТаблицаРаскрытия.Найти(АдресСтрокиРаскрытия.Идентификатор,"ID");
			Если ТекСтрока <> Неопределено Тогда
				
				СтрВыделенныхПоказателей = ТаблицаВыделенныхПоказателей.Добавить();
				СтрВыделенныхПоказателей.Показатель 	 		= СтрПоказатель.Ссылка;
				СтрВыделенныхПоказателей.ИнформацияОРаскрытии	= ДанныеРаскрытия;
				СтрВыделенныхПоказателей.СтрокаТаблицыРаскрытия = ТекСтрока;
				СтрВыделенныхПоказателей.ДанныеПоказателя		= СтрПоказатель;
				СтрВыделенныхПоказателей.КодПоказателя			= СтрПоказатель.Код;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВидыОбластей <> 2 Тогда
			
			СтрПоказатель = ОтчетОбъект.мПоказатели.Найти(СокрЛП(ИмяОбласти),"Код");
			Если СтрПоказатель <> Неопределено Тогда
				СтрВыделенныхПоказателей 					= ТаблицаВыделенныхПоказателей.Добавить();
				СтрВыделенныхПоказателей.Показатель 		= СтрПоказатель.Ссылка;
				СтрВыделенныхПоказателей.ДанныеПоказателя	= СтрПоказатель;
				СтрВыделенныхПоказателей.КодПоказателя		= СтрПоказатель.Код;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Если ВернутьАдресВХранилище Тогда 
		Возврат ПоместитьВоВременноеХранилище(ТаблицаВыделенныхПоказателей,ЭтаФорма.УникальныйИдентификатор);
	Иначе 
		Возврат ТаблицаВыделенныхПоказателей;
	КонецЕсли;
	
КонецФункции // ПолучитьТаблицуВыделенныхПоказателейВТабличномДокументе()

&НаСервере
Функция ПолучитьТаблицуВыделенныхПоказателейВФорме(Знач ИмяТаблицы, ВернутьАдресВХранилище = Ложь)

	СинхронизироватьКонтекстСервер(Ложь,Ложь);
	
	ТаблицаВыделенныхПоказателей = НоваяТаблицаВыделенныхПоказателей();
	
	ИмяРаздела = Элементы[ИмяТаблицы].ПутьКДанным;
	
	ДанныеФормы = ЭтаФорма[ИмяРаздела];
	
	ДанныеПоСтрокам = Новый Соответствие;
	
	ИмяТекущейКолонки = Элементы[ИмяТаблицы].ТекущийЭлемент.Имя;
	
	Для Каждого ИдентификаторСтроки Из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		
		ДанныеСтроки = ДанныеФормы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеПоСтроке = ДанныеПоСтрокам[ДанныеСтроки.КодСтроки];
		Если ДанныеПоСтроке = Неопределено Тогда
			ДанныеПоСтроке = Новый Массив;
			ДанныеПоСтрокам.Вставить(ДанныеСтроки.КодСтроки,ДанныеПоСтроке);
		КонецЕсли;
		
		ДанныеПоСтроке.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если ДанныеПоСтрокам.Количество() Тогда
		
		Для Каждого ИнформацияПоСтроке Из ДанныеПоСтрокам Цикл
			
			КодСтроки       = ИнформацияПоСтроке.Ключ;
			ВыбранныеСтроки = ИнформацияПоСтроке.Значение;
			
			ПоказателиСтроки = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("КодСтрока", КодСтроки));
			
			Если ПараметрыГруппРаскрытия.НайтиСтроки(Новый Структура("КодСтроки", КодСтроки)).Количество() Тогда
				СтрРаскрытия     = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
				Если СтрРаскрытия = Неопределено Тогда
					СтрРаскрытия = ОтчетОбъект.РаскрытьСтрокуПоАналитике(КодСтроки);
				КонецЕсли;
			Иначе
				СтрРаскрытия = Неопределено;
			КонецЕсли;
			
			Для Каждого СтрокаДанных Из ВыбранныеСтроки Цикл
				
				Если СтрРаскрытия <> Неопределено Тогда
					ТекСтрока = СтрРаскрытия.ТаблицаРаскрытия.Найти(СтрокаДанных.Индекс,"Индекс");
					Если ТекСтрока = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					ТекСтрока = Неопределено;
				КонецЕсли;
				
				Для Каждого СтрПоказатель Из ПоказателиСтроки Цикл
					Если ИмяРаздела+СтрПоказатель.КодКолонки = ИмяТекущейКолонки Тогда
						СтрВыделенныхПоказателей = ТаблицаВыделенныхПоказателей.Добавить();
						СтрВыделенныхПоказателей.Показатель 	 		= СтрПоказатель.Ссылка;
						СтрВыделенныхПоказателей.ДанныеПоказателя		= СтрПоказатель;
						СтрВыделенныхПоказателей.КодПоказателя			= СтрПоказатель.Код;
						СтрВыделенныхПоказателей.ИнформацияОРаскрытии	= СтрРаскрытия;
						СтрВыделенныхПоказателей.СтрокаТаблицыРаскрытия = ТекСтрока;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВернутьАдресВХранилище Тогда 
		Возврат ПоместитьВоВременноеХранилище(ТаблицаВыделенныхПоказателей,ЭтаФорма.УникальныйИдентификатор);
	Иначе 
		Возврат ТаблицаВыделенныхПоказателей;
	КонецЕсли;	
	
КонецФункции // ПолучитьТаблицуВыделенныхПоказателейВТаблицеФормы()

