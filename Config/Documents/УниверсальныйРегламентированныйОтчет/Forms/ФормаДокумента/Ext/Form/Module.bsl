&НаКлиенте
Процедура ПересчитатьВсеДанные(Команда)
	ПересчитатьВсеДанныеСервер();
	Если НЕ ОтображатьВВидеТаблицыФормы Тогда
		ОбновитьУстановленныеОтборы();
	Иначе
		ОбновитьОтборыВсехРазделов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьРаскрытиеВОтдельномОкне(Команда)
	
	ТекущаяОбласть = Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
	Если ТекущаяОбласть = Неопределено ИЛИ Найти(ТекущаяОбласть.Имя,"_") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ТекущаяОбласть.Имя);
	ПараметрыОбласти 	  = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);
	
	Если ПараметрыОбласти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОбласти.ВидОбласти = 0 ИЛИ ПараметрыОбласти.ВидОбласти = 5 ИЛИ ПараметрыОбласти.ВидОбласти = 4 Тогда
		
		Если ПараметрыОбласти.ВидОбласти = 5 или ПараметрыОбласти.ВидОбласти = 4 Тогда
			РеквизитыСтроки = ПолучитьАдресСтрокиРаскрытия(ТекущаяОбласть.Имя);
			КодСтроки		= РеквизитыСтроки.КодСтроки;
		Иначе
			ПозРазделитель  = Найти(ТекущаяОбласть.Имя,"_");
			КодСтроки	    = Лев(ТекущаяОбласть.Имя,ПозРазделитель-1);
		КонецЕсли;
		
		ПараметрыРаскрытия = ПодготовитьДанныеОтображенияРаскрытия(КодСтроки);
		Если Не ПараметрыРаскрытия = Неопределено Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ВидОтчета"				,Объект.ВидОтчета);
			ПараметрыФормы.Вставить("ПериодОтчета"			,Объект.ПериодОтчета);
			ПараметрыФормы.Вставить("ГруппаРаскрытия"		,ПараметрыРаскрытия.ГруппаРаскрытия);
			ПараметрыФормы.Вставить("КодСтроки"				,КодСтроки);
			ПараметрыФормы.Вставить("ЕдиницаИзмерения"		,Объект.ЕдиницаИзмерения);
			ПараметрыФормы.Вставить("Точность"				,Объект.УровеньТочности);
			ПараметрыФормы.Вставить("АдресДанныхРаскрытия"  ,ПараметрыРаскрытия.АдресДанныхРаскрытия);
			ПараметрыФормы.Вставить("ТолькоПросмотр"		,ЭтаФорма.ТолькоПросмотр);
			ПараметрыФормы.Вставить("АдресКонтекстаОтчета"  ,АдресОбъектаОтчет);
			ПараметрыФормы.Вставить("АдресПараметрыОтборПоКоду",АдресПараметрыОтборПоКоду);
			ПараметрыФормы.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
			ПараметрыФормы.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
			
			ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РедактированиеРаскрытия",ПараметрыФормы,ЭтаФорма);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПризнакПромежуточногоИтога(Команда)
	
	ОбработатьРедактированиеФормы();
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ОбработкаПромежуточногоИтогаТаблицаФормы();
	Иначе
		ОбработкаПромежуточногоИтогаТабличныйДокумент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежимОтображения(Команда)
	
	ОчиститьУстановленныеОтборы();
	ПереключитьРежимОтображенияСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВыделенныеЯчейки(Команда)
	
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	Для Каждого Обл Из ТекВыделенныеОбласти Цикл
		
		Для СчСтрок = Обл.Верх По Обл.Низ Цикл
			Для СчКолонок = Обл.Лево По Обл.Право Цикл
				
				ТекОбласть = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
				Если ТекОбласть.СодержитЗначение Тогда
					ИзмененныеОбласти.Вставить(ТекОбласть.Имя,Неопределено);
					ТекОбласть.Значение = Неопределено;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Если ПересчитыватьПоказателиПриИзменении Тогда
		СинхронизироватьКонтекстНовыйВариант();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСверткуПоАналитике(Команда)
	ОтменитьСверткуПоАналитикеСервер();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура РучнаяСверткаПоАналитике(Команда)
	
	Перем ИменаГруппы;
	
	ТекОбласть = Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
	
	Если ТекОбласть = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Адрес = АдресСтрокиРаскрытияБезКонтекста(ТекОбласть.Имя, ПараметрыГруппРаскрытия);
	Если Адрес = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если НеобходимаСверткаПоАналитикеРучнойРежим(Адрес, ИменаГруппы) = Ложь Тогда 
		Возврат;
	КонецЕсли;		
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","РучнаяСверткаПоАналитике");	
	
	ДополнительныеПараметры.Вставить("КодСтроки",ИменаГруппы.КодСтроки);
	
	ШаблонВопроса = НСтр("ru = 'Группа строк «%1» содержит одинаковые комбинации значений аналитики. Выполнить объединение одинаковых строк?'");
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ИменаГруппы.ИмяГруппы);
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьАналитикуПриЗаписи(Команда)
	СвернутьАналитикуПриЗаписиНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СменитьРежимРедактированияТекста(Команда)
	
	РедактированиеТекстаВОтдельномОкне = Не РедактированиеТекстаВОтдельномОкне;
	
	Элементы.РедактированиеТекстаВОтдельномОкне.Пометка = РедактированиеТекстаВОтдельномОкне;
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьВыделенныеВБуферОбмена(Команда)
		
	ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
	
	МассивДанныхБуфера = Новый Массив;
	Для Каждого Обл Из ТекВыделенныеОбласти Цикл
		ДанныеБуфераОбмена = Новый Структура;
		ДанныеБуфераПерваяЯчейка = "";
	
		Для СчСтрок = Обл.Верх По Обл.Низ Цикл
			Для СчКолонок = Обл.Лево По Обл.Право Цикл
				
				ТекОбласть = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
				
				Если ТекОбласть.СодержитЗначение Тогда
					
					ИменованнаяОбласть = ТабличныйДокументОтчета.Области.Найти(ТекОбласть.Имя) <> Неопределено;
					Если Не ИменованнаяОбласть Тогда 
						Продолжить;
					КонецЕсли;
					
					ИмяОбласти = ТекОбласть.Имя;
					РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
					ПараметрыОбласти = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);
					
					Если ПараметрыОбласти = Неопределено Тогда
						ТекущееЗначение = ТекОбласть.Значение;
					ИначеЕсли ПараметрыОбласти.ВидОбласти = 0 ИЛИ ПараметрыОбласти.ВидОбласти = 5 Тогда  // показатель отчета,показатель раскрытия
						ТекущееЗначение = ТекОбласть.Значение; 
					ИначеЕсли ПараметрыОбласти.ВидОбласти = 3  или ПараметрыОбласти.ВидОбласти = 4 Тогда	//доп реквизит,аналитика раскрытия
						ТекущееЗначение = ТекОбласть.Расшифровка;
					КонецЕсли;
					
					ИмяЯчейкиБуфера = "стр_"+Формат(СчСтрок,"ЧН=0; ЧГ=0")+"гр_"+Формат(СчКолонок,"ЧН=0; ЧГ=0");
					ДанныеБуфераОбмена.Вставить(ИмяЯчейкиБуфера, ТекущееЗначение);
					
					Если ДанныеБуфераОбмена.Количество() = 1 Тогда
						ДанныеБуфераПерваяЯчейка = ИмяЯчейкиБуфера;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеБуфераПерваяЯчейка) Тогда
			СтруктураДляБуфера = Новый Структура("ДанныеБуфераОбмена,ДанныеБуфераПерваяЯчейка",ДанныеБуфераОбмена,ДанныеБуфераПерваяЯчейка);
			МассивДанныхБуфера.Добавить(СтруктураДляБуфера);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДанныхБуфера.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю();
	    Сообщение.Текст = НСтр("ru = 'Выделенная область не содержит значений показателей и аналитики, доступных для копирования в другие ячейки.'");
	    Сообщение.Сообщить();
	Иначе
		СкопироватьМассивДанныхБуфераВБуферОбмена(МассивДанныхБуфера);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СкопироватьМассивДанныхБуфераВБуферОбмена(МассивДанныхБуфера)
	
	ОбщегоНазначения.СкопироватьВБуферОбмена(МассивДанныхБуфера);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивДанныхБуфераИзБуфераОбмена()
		
	МассивДанныхБуфера = ОбщегоНазначения.СтрокиИзБуфераОбмена().Данные;
	 	
	Если ТипЗнч(МассивДанныхБуфера) = Тип("Массив") Тогда
		Возврат МассивДанныхБуфера; 
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПолучитьВыделенныеОбласти()
	
	МассивПроверяемыхОбластей = Элементы.ТабличныйДокументОтчета.ПолучитьВыделенныеОбласти();
		
	Возврат МассивПроверяемыхОбластей;
	
КонецФункции

&НаКлиенте
Процедура ВставитьИзБуфераОбмена(Команда)
	
	МассивДанныхБуфера = ПолучитьМассивДанныхБуфераИзБуфераОбмена();
	Если МассивДанныхБуфера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстанавливатьВыделенныеОбласти = Ложь;
	
	КоличествоДобавленных = 0;
	Для Каждого СтруктураДляБуфера Из МассивДанныхБуфера Цикл
		ДанныеБуфераОбмена = Неопределено;
		ДанныеБуфераПерваяЯчейка = Неопределено;
	    КоличествоСтрок = 0;
		КоличествоКолонок = 0;
		
		СтруктураДляБуфера.Свойство("ДанныеБуфераОбмена",ДанныеБуфераОбмена);
		СтруктураДляБуфера.Свойство("ДанныеБуфераПерваяЯчейка",ДанныеБуфераПерваяЯчейка);
		СоответствиеСтрок = Новый Соответствие;
		СоответствиеКолонок = Новый Соответствие;
		Если ТипЗнч(ДанныеБуфераОбмена) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из ДанныеБуфераОбмена Цикл
				ТекИмя = КлючИЗначение.Ключ;
				ПозицияГр = СтрНайти(ТекИмя,"гр_");
				ТекСтр = Лев(ТекИмя,ПозицияГр-1);
				ТекГр = Сред(ТекИмя,ПозицияГр);
				СоответствиеСтрок.Вставить(ТекСтр);
				СоответствиеКолонок.Вставить(ТекГр);
			КонецЦикла;
		КонецЕсли;
		КоличествоСтрок = СоответствиеСтрок.Количество();
		КоличествоКолонок = СоответствиеКолонок.Количество();
	
	
		Если ЗначениеЗаполнено(ДанныеБуфераОбмена) 
			И ЗначениеЗаполнено(ДанныеБуфераПерваяЯчейка) Тогда
			
			ПерваяСтрокаБуфер	= Число(Сред(ДанныеБуфераПерваяЯчейка, 5, Найти(ДанныеБуфераПерваяЯчейка, "гр_")-5));
			ПерваяГрафаБуфер	= Число(Сред(ДанныеБуфераПерваяЯчейка,Найти(ДанныеБуфераПерваяЯчейка, "гр_")+3));
			
			ПоследняяСтрокаВыделенные = Неопределено;
			ПоследняяГрафаВыделенные = Неопределено;
			ТекВыделенныеОбласти = ПолучитьВыделенныеОбласти();
			
			ПерваяСтрокаВыделенные	= ТекВыделенныеОбласти[0].Верх;
			ПерваяГрафаВыделенные	= ТекВыделенныеОбласти[0].Лево;
			
			РазницаСтрок = ПерваяСтрокаВыделенные - ПерваяСтрокаБуфер;
			РазницаГраф	 = ПерваяГрафаВыделенные - ПерваяГрафаБуфер;
			
			ИмяВыделеннойОбл = ТекВыделенныеОбласти[0].Имя;
			РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяВыделеннойОбл);
			ПараметрыОбласти = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);
			
			 
			Если ПараметрыОбласти <> Неопределено Тогда//значит выделена одна область
				
				Если РеквизитыИмениОбласти.Идентификатор<>Неопределено Тогда
					//это детальные строки группы раскрытия
					//нужно проверить, что в группе раскрытия достаточное количество строк для вставки из буфера обмена
					ИмяКонечнойСтроки = РеквизитыИмениОбласти.ИмяИсходнойОбласти+"_"+Формат(РеквизитыИмениОбласти.Идентификатор + КоличествоСтрок + КоличествоДобавленных-1,"ЧН=0; ЧГ=0");
					Если ТабличныйДокументОтчета.Области.Найти(ИмяКонечнойСтроки) = Неопределено Тогда
						// не хватило строк, нужно добавить
						
						АдресСтрокиРаскрытия = ПолучитьАдресСтрокиРаскрытия(ИмяВыделеннойОбл);
											
						ВходящиеПараметры = Новый Структура;
						ВходящиеПараметры.Вставить("АдресОбъектаОтчет",АдресОбъектаОтчет);
						ВходящиеПараметры.Вставить("ВыводитьРаскрытиеВТелеБланка",Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
						ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
						ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
						
						ДобавитьСтрокиВТаблицуРаскрытия(Объект, ТабличныйДокументОтчета, ИзмененныеОбласти, ВходящиеПараметры, АдресСтрокиРаскрытия.КодСтроки, АдресСтрокиРаскрытия.ИмяИсходнойОбласти, КоличествоСтрок + КоличествоДобавленных, АдресСтрокиРаскрытия.Идентификатор);
						Модифицированность = Истина;
					КонецЕсли;
				КонецЕсли;
										
				//если для вставки выделена одна ячейка, то остальные надо самим найти
				Для НомСтр = 0 По КоличествоСтрок-1 Цикл
					Для НомКол = 0 По КоличествоКолонок-1 Цикл
						
						СчСтрок = ПерваяСтрокаВыделенные+НомСтр;
						СчКолонок = ПерваяГрафаВыделенные+НомКол;
						ТекОбласть = ТабличныйДокументОтчета.Область(СчСтрок+КоличествоДобавленных,СчКолонок);
						
						Если НЕ ТекОбласть.СодержитЗначение Тогда
							Продолжить;
						КонецЕсли;
						
						Если ТекОбласть.Защита = Ложь Тогда
							
							НовоеЗначениеЯчейки = Неопределено;
							КлючПоиска = "стр_"+Формат((СчСтрок-РазницаСтрок),"ЧН=0; ЧГ=0")+"гр_"+Формат((СчКолонок-РазницаГраф),"ЧН=0; ЧГ=0");
							Если ДанныеБуфераОбмена.Свойство(КлючПоиска, НовоеЗначениеЯчейки) 
								И ТипЗнч(ТекОбласть.Значение) = ТипЗнч(НовоеЗначениеЯчейки) Тогда
								ТекОбласть.Значение = НовоеЗначениеЯчейки;
								ИзмененныеОбласти.Вставить(ТекОбласть.Имя, НовоеЗначениеЯчейки);
							КонецЕсли;
							
						ИначеЕсли ТекОбласть.Защита = Истина Тогда
							
							ИменованнаяОбласть = ТабличныйДокументОтчета.Области.Найти(ТекОбласть.Имя) <> Неопределено;
							Если Не ИменованнаяОбласть Тогда 
								Продолжить;
							КонецЕсли;
						
							ИмяОбласти = ТекОбласть.Имя;
							РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
							ПараметрыОбласти = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);
							
							Если ПараметрыОбласти = Неопределено Тогда
								 Продолжить;
							ИначеЕсли ПараметрыОбласти.ВидОбласти = 3  или ПараметрыОбласти.ВидОбласти = 4 Тогда	//доп реквизит,аналитика раскрытия
								НовоеЗначениеЯчейки = Неопределено;
								КлючПоиска = "стр_"+Формат((СчСтрок-РазницаСтрок),"ЧН=0; ЧГ=0")+"гр_"+Формат((СчКолонок-РазницаГраф),"ЧН=0; ЧГ=0");
								Если ДанныеБуфераОбмена.Свойство(КлючПоиска, НовоеЗначениеЯчейки) 
									И ТипЗнч(ТекОбласть.Расшифровка) = ТипЗнч(НовоеЗначениеЯчейки) Тогда
									ТекОбласть.Значение = НовоеЗначениеЯчейки;
									ИзмененныеОбласти.Вставить(ТекОбласть.Имя, НовоеЗначениеЯчейки);
								КонецЕсли;	
							КонецЕсли;
						КонецЕсли;
						
						ПоследняяСтрокаВыделенные = СчСтрок;
						ПоследняяГрафаВыделенные = СчКолонок;
					КонецЦикла;
				КонецЦикла;
				УстанавливатьВыделенныеОбласти = Истина;
			Иначе
						
			    //если для вставки выделен диапазон ячеек, то вставляем в этот диапазон
				Для Каждого Обл Из ТекВыделенныеОбласти Цикл
					
					Для СчСтрок = Обл.Верх По Обл.Низ Цикл
						Для СчКолонок = Обл.Лево По Обл.Право Цикл
							
							ТекОбласть = ТабличныйДокументОтчета.Область(СчСтрок,СчКолонок);
							
							Если НЕ ТекОбласть.СодержитЗначение Тогда
								Продолжить;
							КонецЕсли;
							
							ИмяОбласти = ТекОбласть.Имя;
							РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
							ПараметрыОбласти = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);						
							
							Если ТекОбласть.Защита = Ложь Тогда
								
								НовоеЗначениеЯчейки = Неопределено;
								КлючПоиска = "стр_"+Формат((СчСтрок-РазницаСтрок),"ЧН=0; ЧГ=0")+"гр_"+Формат((СчКолонок-РазницаГраф),"ЧН=0; ЧГ=0");
								Если ДанныеБуфераОбмена.Свойство(КлючПоиска, НовоеЗначениеЯчейки) 
									И ТипЗнч(ТекОбласть.Значение) = ТипЗнч(НовоеЗначениеЯчейки) Тогда
									ТекОбласть.Значение = НовоеЗначениеЯчейки;
									ИзмененныеОбласти.Вставить(ТекОбласть.Имя, НовоеЗначениеЯчейки);
								КонецЕсли;
								
							ИначеЕсли ТекОбласть.Защита = Истина Тогда
								
								ИменованнаяОбласть = ТабличныйДокументОтчета.Области.Найти(ТекОбласть.Имя) <> Неопределено;
								Если Не ИменованнаяОбласть Тогда 
									Продолжить;
								КонецЕсли;
														
								Если ПараметрыОбласти = Неопределено Тогда
									 Продолжить;
								ИначеЕсли ПараметрыОбласти.ВидОбласти = 3  или ПараметрыОбласти.ВидОбласти = 4 Тогда	//доп реквизит,аналитика раскрытия
									НовоеЗначениеЯчейки = Неопределено;
									КлючПоиска = "стр_"+Формат((СчСтрок-РазницаСтрок),"ЧН=0; ЧГ=0")+"гр_"+Формат((СчКолонок-РазницаГраф),"ЧН=0; ЧГ=0");
									Если ДанныеБуфераОбмена.Свойство(КлючПоиска, НовоеЗначениеЯчейки) 
										И ТипЗнч(ТекОбласть.Расшифровка) = ТипЗнч(НовоеЗначениеЯчейки) Тогда
										ТекОбласть.Значение = НовоеЗначениеЯчейки;
										ИзмененныеОбласти.Вставить(ТекОбласть.Имя, НовоеЗначениеЯчейки);
									КонецЕсли;	
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
					
				КонецЦикла;
			КонецЕсли;
					
		КонецЕсли;
		
		КоличествоДобавленных = КоличествоДобавленных + КоличествоСтрок;
	КонецЦикла;
	
	Если ПересчитыватьПоказателиПриИзменении Тогда
		СинхронизироватьКонтекстНовыйВариант();
	КонецЕсли;
	Если УстанавливатьВыделенныеОбласти Тогда
		//если были добавления строк, то сразу выделенные области не устанавливаются, поэтому через обработчик ожидания
		ПодключитьОбработчикОжидания("ВыделитьДиапазонЯчеек",0.1,Истина);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьДиапазонЯчеек() Экспорт
	МассивОбластей = Новый Массив;
	МассивОбластей.Добавить(ТабличныйДокументОтчета.Область(ПерваяСтрокаВыделенные,ПерваяГрафаВыделенные,ПоследняяСтрокаВыделенные,ПоследняяГрафаВыделенные));
	Элементы.ТабличныйДокументОтчета.УстановитьВыделенныеОбласти(МассивОбластей);	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокиВТаблицуРаскрытия(Знач ТекОбъект, ТабличныйДокументОтчета, ИзмененныеОбласти, ВходящиеПараметры, КодСтроки, ИмяИсходнойОбласти, КоличествоСтрокКДобавлению, НачальныйИдентификатор=Неопределено)
	
	Перем АдресОбъектаОтчет;
	
	АдресОбъектаОтчет = ВходящиеПараметры.АдресОбъектаОтчет;
				
	ОтчетОбъект = СинхронизироватьКонтекстБезКонтекста(Истина,ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры);
	
	СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
	Если СтрРаскрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	Если СтрНайти(ИмяИсходнойОбласти,"_РазметкаПустойСтроки")>0 Тогда
		ПервоначальноеКоличествоСтрок = 0;
	Иначе
		ПервоначальноеКоличествоСтрок = ТаблицаРаскрытия.Количество();
	КонецЕсли;
	
	Если НачальныйИдентификатор = Неопределено Тогда
		//просто добавить определенное количество строк в таблицу раскрытия
		КоличествоСтрокДляДобавления = ПервоначальноеКоличествоСтрок + КоличествоСтрокКДобавлению-1;
	Иначе
	
		КоличествоСтрокДляДобавления = НачальныйИдентификатор + КоличествоСтрокКДобавлению -1;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	
	Для КолСтр = ПервоначальноеКоличествоСтрок По КоличествоСтрокДляДобавления Цикл 
		
		
		НоваяСтрокаРаскрытия 		= ТаблицаРаскрытия.Добавить();
		НоваяСтрокаРаскрытия.ID 	= ТаблицаРаскрытия.Индекс(НоваяСтрокаРаскрытия);
		НоваяСтрокаРаскрытия.Индекс = НоваяСтрокаРаскрытия.ID + 1;
		
		МассивСтрок.Добавить(НоваяСтрокаРаскрытия);	
	
	КонецЦикла;
		
	ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,МассивСтрок);
	
	ВсеКолонки 		 = Новый Массив;
	ПоказателиГруппы = ОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",СтрРаскрытия.ГруппаРаскрытия));
	Для Каждого Пок Из ПоказателиГруппы Цикл
		ВсеКолонки.Добавить(Пок.Код);
	КонецЦикла;
	ПересчитатьПоказателиБезКонтекста(ОтчетОбъект, ВсеКолонки);
		
	// Отражение изменений
	Обл = ТабличныйДокументОтчета.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыГруппы = ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	МакетыРаскрытия = ОтчетОбъект.ВернутьМассивМакетовРаскрытия(ПараметрыГруппы.КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	ВысотаШапки = ?(МакетыРаскрытия.Шапка = Неопределено, 0, МакетыРаскрытия.Шапка.ВысотаТаблицы); 
	
	ТекущаяШапкаМакета    = МакетыРаскрытия.Шапка;
	МакетыРаскрытия.Шапка = Неопределено; // Запрет отрисовки шапки
	
	ТаблицаНовыхСтрок = СтрРаскрытия.ТаблицаРаскрытия.Скопировать(МассивСтрок);
	МакетНовыхСтрок   = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,ТаблицаНовыхСтрок,,СтрРаскрытия.КодСтроки,МакетыРаскрытия);	
	
	ПрименитьНастройкуВыводаДлинныхСтрок(МакетНовыхСтрок,ВходящиеПараметры.ИменаЯчеекДлинныхСтрок,ВходящиеПараметры.ВыводитьДлинныеПоляВОднуСтроку);
	
	ВысотаОднойСтроки = МакетНовыхСтрок.ВысотаТаблицы/МассивСтрок.Количество();
	
	ОтчетОбъект.СнятьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
	
	ТипСдвига = ТипСмещенияТабличногоДокумента.ПоВертикали;
	
	КоличествоНовыхСтрок = МассивСтрок.Количество();
	
	//
	НачалоМакетаРаскрытия = Обл.Низ + 1 + ВысотаШапки;
	КонецМакетаРаскрытия  = НачалоМакетаРаскрытия + ВысотаОднойСтроки*ПервоначальноеКоличествоСтрок;
		
	ОбластьПриемник = ТабличныйДокументОтчета.Область(КонецМакетаРаскрытия,,КонецМакетаРаскрытия);
	//
	
	СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ВысотаТабДокРаскрытия + ВысотаОднойСтроки*КоличествоНовыхСтрок;
	
	СтрРаскрытия.ТабДокРаскрытие.Вывести(МакетНовыхСтрок);
	
	ОбластьИсточник = МакетНовыхСтрок.Область(1,,МакетНовыхСтрок.ВысотаТаблицы);
		
	ТабличныйДокументОтчета.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСдвига,Ложь);
		
	ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
		
	СтрРаскрытия.ТабДокРаскрытие.Очистить();
	
	ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета);
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзмененияСостояний(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("ДокументОтчет",Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор",Отбор);
	ОткрытьФорму("РегистрСведений.СостоянияОтправленныхОтчетов.ФормаСписка",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыборИзКПС(Команда)
	
	ИспользоватьВыборИзКПС = НЕ ИспользоватьВыборИзКПС;
	Элементы.ВыборИзКПС.Пометка = ИспользоватьВыборИзКПС;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВычисляемыеЗначенияПараметров(Команда)
	
	ИзмененияДляТабДока = Новый Структура;
	МассивПараметров = Новый Массив;
	
	ОбновитьВычисляемыеЗначенияПараметровБезКонтекста(ИзмененияДляТабДока,МассивПараметров,АдресТекущейСтраницы,Объект,АдресОбъектаОтчет);
	
	Объект.ПараметрыОтчета.Очистить();
	Для Каждого ТекПараметр Из МассивПараметров Цикл
		СтрПараметров = Объект.ПараметрыОтчета.Добавить();
		ЗаполнитьЗначенияСвойств(СтрПараметров,ТекПараметр);
	КонецЦикла;
	
	Для Каждого КлючиИЗначение Из ИзмененияДляТабДока Цикл
		ТекОбл = ТабличныйДокументОтчета.Области.Найти(КлючиИЗначение.Ключ);
		Если ТекОбл <> Неопределено Тогда
			УстанавливаемыеСвойства = КлючиИЗначение.Значение;
			Для Каждого КлючИЗначениеСвойств Из УстанавливаемыеСвойства Цикл
				ТекОбл[КлючИЗначениеСвойств.Ключ] = КлючИЗначениеСвойств.Значение;	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыЦБ(Команда)
	
	ОбновитьФиксированныеПараметрыОрганизацииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура РанееСохраненные(Команда)
	
	ИзмененияДляТабДока = Новый Структура;
	МассивПараметров = Новый Массив;
	
	ЗаполнитьПоРанееСохраненнымБезКонтекста(ИзмененияДляТабДока,МассивПараметров,АдресТекущейСтраницы,Объект,АдресОбъектаОтчет);
	//не очищаем параметры, только заполняем измененные
	Для Каждого ТекПараметр Из МассивПараметров Цикл
		СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ТекПараметр.Код));
		Если СтрокиПараметров.Количество() Тогда
			ЗаполнитьЗначенияСвойств(СтрокиПараметров[0],ТекПараметр);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючиИЗначение Из ИзмененияДляТабДока Цикл
		ТекОбл = ТабличныйДокументОтчета.Области.Найти(КлючиИЗначение.Ключ);
		Если ТекОбл <> Неопределено Тогда
			УстанавливаемыеСвойства = КлючиИЗначение.Значение;
			Для Каждого КлючИЗначениеСвойств Из УстанавливаемыеСвойства Цикл
				ТекОбл[КлючИЗначениеСвойств.Ключ] = КлючИЗначениеСвойств.Значение;	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	
КонецПроцедуры

