#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверкаПоказателиОтсутствуютЗавершение(ОтветНаВопрос,ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.ОК Тогда
		ПодготовитьЗаполнениеОтчета();
		ОчиститьОтчет(Ложь);
		ДополнительныеПараметры.Вставить("ПроверкаПоказателиОтсутствуютВыполнена");
		Записать(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьОчистки()
	
	СинхронизироватьКонтекстСервер(Ложь);
	
	НужнаОчистка = Ложь;
	Для Каждого СтрТЧ Из ОтчетОбъект.мПоказатели Цикл
		Если ЗначениеЗаполнено(СтрТЧ.Значение) Тогда
			НужнаОчистка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НужнаОчистка = Ложь Тогда
		Если ОтчетОбъект.мПоказателиРаскрытия.Количество()>0 Тогда
			НужнаОчистка = Истина;
		КонецЕсли; 
	КонецЕсли;
	
	ПоместитьОбъектОтчета();
	Возврат НужнаОчистка;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтразитьВыборПоСценариюВводаГруппыРаскрытия(ГруппаРаскрытия,ПрефиксИмениОбласти, ИзмененныеОбласти, ПредыдущийВидАналитики, ИдентификаторСтроки,ВыбранноеЗначение)

	ИзмененныеЗначенияАналитик = БюджетнаяОтчетностьСервер.ЗначенияОбработкиВыбораПоСценариюВвода(ГруппаРаскрытия, ПредыдущийВидАналитики, ВыбранноеЗначение);
	Если ИзмененныеЗначенияАналитик = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияАналитик   = БюджетнаяОтчетностьСервер.КоллекцияАналитикГруппыРаскрытия(ГруппаРаскрытия);
	СтрИдентификатор    = Формат(ИдентификаторСтроки,"ЧН=0; ЧГ=0");
	
	Для Каждого ИзмененнаяАналитика Из ИзмененныеЗначенияАналитик Цикл
		
		СтрокаАналитики = КоллекцияАналитик.Найти(ИзмененнаяАналитика.Ключ, "КодВидаАналитики");
		Если СтрокаАналитики <> Неопределено Тогда
			
			ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(СтрокаАналитики.ВидКлассификатораБК);
			ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(ИзмененнаяАналитика.Значение,ЭтоСтроковыйКлассификатор);
			
			ИзмененныеОбласти.Вставить(ПрефиксИмениОбласти+"_"+СтрокаАналитики.ИмяОбъектаАналитики+"_"+СтрИдентификатор, ВыбранноеЗначение);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтразитьВыборПоСценариюВводаДопРеквизитов(ВидОтчета, ИзмененныеОбласти, ПредыдущийВидАналитики, ИзмененныеДопРеквизиты, ВыбранноеЗначение)

	ИзмененныеЗначенияАналитик = БюджетнаяОтчетностьСервер.ЗначенияОбработкиВыбораПоСценариюВвода(ВидОтчета, ПредыдущийВидАналитики, ВыбранноеЗначение);
	Если ИзмененныеЗначенияАналитик = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияАналитик   = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ВидОтчета);
	
	Для Каждого ИзмененнаяАналитика Из ИзмененныеЗначенияАналитик Цикл
		
		СтрокаАналитики = КоллекцияАналитик.Найти(ИзмененнаяАналитика.Ключ, "КодВидаАналитики");
		Если СтрокаАналитики <> Неопределено Тогда
			
			ЭтоСтроковыйКлассификатор = ЗначениеЗаполнено(СтрокаАналитики.ВидКлассификатораБК);
			ВыбранноеЗначение = ПреобразоватьВыбранноеЗначениеАналитики(ИзмененнаяАналитика.Значение,ЭтоСтроковыйКлассификатор);
			ИзмененныеДопРеквизиты.Вставить(СтрокаАналитики.ИмяОбъектаАналитики, ВыбранноеЗначение);			
			ИзмененныеОбласти.Вставить(СтрокаАналитики.ИмяОбъектаАналитики, ВыбранноеЗначение);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьВыбранноеЗначениеАналитики(Знач ВыбранноеЗначениеАналитики,ЭтоСтроковыйКлассификатор = Ложь)
	
	Если ЭтоСтроковыйКлассификатор = Истина Тогда
		//уберем граничные пробелы
		ВыбранноеЗначение = СокрЛП(ВыбранноеЗначениеАналитики);
		//если код состоит из всех нулей, то присвоим пустую строку, чтобы в отчете не было дублей с пустой аналитикой, 
		//где в разных строках значения "" и "000", т.к. представление у пустой аналитики БК - нули
		Если СтрЗаменить(ВыбранноеЗначение,"0","") = "" Тогда
			ВыбранноеЗначение = "";
		КонецЕсли;
	Иначе
		ВыбранноеЗначение = ВыбранноеЗначениеАналитики;
	КонецЕсли;
	
	Возврат ВыбранноеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьФиксированныеПараметрыОрганизацииНаКлиенте()
	
	ЗаголовокФормы = "";
	СтруктураПараметров = Новый Структура;
	
	ОбновитьФиксированныеПараметрыОрганизацииБезКонтекста(Объект,ИзмененныеОбласти,ЗаголовокФормы,СтруктураПараметров);
	
	Для Каждого СтрТЧ Из Объект.ПараметрыОтчета Цикл
		Если СтруктураПараметров.Свойство(СтрТЧ.Код) Тогда
			СтрТЧ.Значение = СтруктураПараметров[СтрТЧ.Код];
		КонецЕсли;
	КонецЦикла;
	
	ЭтотОбъект.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьФиксированныеПараметрыОрганизацииБезКонтекста(Знач Объект,ИзмененныеОбласти,ЗаголовокФормы,СтруктураПараметров)
	
	ЗаголовокФормы = ПолучитьЗаголовокФормы(Объект.ВидОтчета,Объект.Организация,Объект.Номер,Объект.Дата);
	
	//ОКВЭД
	
	СтрокаОКВЭД = Неопределено;
	
	СтрокиОКВЭД = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ОКВЭД"));
	Если СтрокиОКВЭД.Количество()>0 Тогда
		СтрокаОКВЭД = СтрокиОКВЭД[0];
	КонецЕсли;
	
	Если СтрокаОКВЭД <> Неопределено Тогда
					
		СтруктураПараметров.Вставить("ОКВЭД","");
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			СтруктураПараметров.ОКВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,"КодОКВЭД2");
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаОКВЭД.Код,СтруктураПараметров.ОКВЭД);
		
	КонецЕсли;

	// данные ЦБ
	
	СтрокаЦБ = Неопределено;
	
	СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБ"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБ = СтрокиПараметров[0];
	КонецЕсли;
	
	ТекДата = ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДатаСеанса());
	
	Если СтрокаЦБ <> Неопределено Тогда
		СтруктураПараметров.Вставить("ЦБ","");
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			
			//Наименование, ОГРН, ИНН, КПП, Местонахождение
			
			МассивРеквизитовЦБ = Новый Массив;
			МассивРеквизитовЦБ.Добавить("Наименование");
			
			Если Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБОГРН")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("ОГРН");
			КонецЕсли;
			
			Если Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБИНН")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("ИНН");
			КонецЕсли;
			
			Если Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБКПП")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("КПП");
			КонецЕсли;
			
			МассивРеквизитовЦБ.Добавить("Местонахождение");
				
			РеквизитыЦБ = СтрСоединить(МассивРеквизитовЦБ,",");
			СтруктураПараметров.ЦБ = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеЦБ(Объект.Организация,ТекДата,РеквизитыЦБ);
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБ.Код,СтруктураПараметров.ЦБ);
	КонецЕсли;
	
	СтрокаЦБРук = Неопределено;
	
	СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБРук"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБРук = СтрокиПараметров[0];
	КонецЕсли;
	
	Если СтрокаЦБРук <> Неопределено Тогда
		СтруктураПараметров.Вставить("ЦБРук","");
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			СтруктураПараметров.ЦБРук = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеОтветственногоЛицаЦБ(Объект.Организация,"Руководитель",ТекДата);
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБРук.Код,СтруктураПараметров.ЦБРук);
	КонецЕсли;
	
	СтрокаЦБРукДолжность = Неопределено;
	
	СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБРукДолжность"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБРукДолжность = СтрокиПараметров[0];
	КонецЕсли;
	
	Если СтрокаЦБРукДолжность <> Неопределено Тогда
		СтруктураПараметров.Вставить("ЦБРукДолжность","");
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			СтруктураПараметров.ЦБРукДолжность = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДолжностьОтветственногоЛицаЦБ(Объект.Организация,"Руководитель",ТекДата);
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБРукДолжность.Код,СтруктураПараметров.ЦБРукДолжность);
	КонецЕсли;
	
	РеквизитыЦБСтруктурой = Неопределено;
	
	МассивРеквизитовЦБ = Новый Массив;
	МассивРеквизитовЦБ.Добавить("ОГРН");
	МассивРеквизитовЦБ.Добавить("ИНН");
	МассивРеквизитовЦБ.Добавить("КПП");
	
	Для Каждого ТекРеквЦБ Из МассивРеквизитовЦБ Цикл
		СтрокаПараметраЦБ = Неопределено;
		ИмяРеквизитаЦБ = "ЦБ"+ТекРеквЦБ;
		СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ИмяРеквизитаЦБ));
		Если СтрокиПараметров.Количество()>0 Тогда
			СтрокаПараметраЦБ = СтрокиПараметров[0];
		КонецЕсли;
		
		Если СтрокаПараметраЦБ <> Неопределено Тогда
			СтруктураПараметров.Вставить(ИмяРеквизитаЦБ,"");
			Если ЗначениеЗаполнено(Объект.Организация) Тогда
				
				Если РеквизитыЦБСтруктурой = Неопределено Тогда
					РеквизитыЦБСтруктурой = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеЦБСтруктурой(Объект.Организация,ТекДата,"ОГРН,ИНН,КПП");
				КонецЕсли;
				
				СтруктураПараметров.Вставить(ИмяРеквизитаЦБ, РеквизитыЦБСтруктурой[ТекРеквЦБ]);
			КонецЕсли;
			ИзмененныеОбласти.Вставить(ИмяРеквизитаЦБ,СтруктураПараметров[ИмяРеквизитаЦБ]);
		КонецЕсли;
	КонецЦикла;
	
	//для подписантов - Руководитель, ГлБухгалтер, Руководитель финансово- экономической службы (РуководительПФС)
	
	ИмяРуководитель = "Руководитель";
	ИмяГлБухгалтер = "ГлБухгалтер";
	ИмяРуководительПФС = "РуководительПФС";
	
	МассивПараметровПодписантов = Новый Массив;
	
	МассивПараметровПодписантов.Добавить(ИмяРуководитель);
	МассивПараметровПодписантов.Добавить(ИмяГлБухгалтер);
	МассивПараметровПодписантов.Добавить(ИмяРуководительПФС);
	
	Для Каждого ТекЭлемент Из МассивПараметровПодписантов Цикл
		
		СтрокаТекПараметра = Неопределено;
	
		СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ТекЭлемент));
		Если СтрокиПараметров.Количество()>0 Тогда
			СтрокаТекПараметра = СтрокиПараметров[0];
		КонецЕсли;
		
		Если СтрокаТекПараметра <> Неопределено Тогда
			ТекЗначение = "";
			
			Если ЗначениеЗаполнено(Объект.Организация) Тогда
				Если ТекЭлемент = ИмяРуководитель Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителя(Объект.Организация,ТекДата);
				ИначеЕсли ТекЭлемент = ИмяГлБухгалтер Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОГлавногоБухгалтера(Объект.Организация,ТекДата);
				ИначеЕсли ТекЭлемент = ИмяРуководительПФС Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителяПФС(Объект.Организация,ТекДата);	
				КонецЕсли;
				
			КонецЕсли;
			СтруктураПараметров.Вставить(ТекЭлемент,ТекЗначение);
			
			ИзмененныеОбласти.Вставить(ТекЭлемент,ТекЗначение);
		КонецЕсли;
	
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрИсполнитель()
	//Исполнитель
	
	СтрокаИсполнитель = Неопределено;
	
	СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","Исполнитель"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаИсполнитель = СтрокиПараметров[0];
	КонецЕсли;
		
	Если СтрокаИсполнитель <> Неопределено Тогда
		ТекущийПользователь = Неопределено;
		Попытка
			ТекущийПользователь = Пользователи.ТекущийПользователь();
		Исключение
			//нет пользователя, оставляем как есть
			Возврат;
		КонецПопытки;
		
		ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийПользователь,"ФизическоеЛицо");
		
		ФиоИсполнителя = "";
		Если ЗначениеЗаполнено(ФизЛицо) Тогда
			ФиоИсполнителя = СтрЗаменить(Корреспонденты.ФИОПоОбъекту(ФизЛицо,Истина,ТекущаяДатаСеанса(),Истина),Символы.НПП," ");
		КонецЕсли;	
		
		СтрокаИсполнитель.Значение = ФиоИсполнителя;
		
		ИзмененныеОбласти.Вставить(СтрокаИсполнитель.Код,СтрокаИсполнитель.Значение);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФиксированныеПараметрыОрганизации()
	
	УстановитьЗаголовокФормы();
	
	//ОКВЭД
	
	СтрокаОКВЭД = Неопределено;
	
	СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ОКВЭД"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаОКВЭД = СтрокиПараметров[0];
	КонецЕсли;
		
	Если СтрокаОКВЭД <> Неопределено Тогда	
		Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
			СтрокаОКВЭД.Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.Организация,"КодОКВЭД2");
		Иначе
			СтрокаОКВЭД.Значение = "";
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаОКВЭД.Код,СтрокаОКВЭД.Значение);
	КонецЕсли;
	
	// данные ЦБ
	
	ТекДата = ?(ЗначениеЗаполнено(ОтчетОбъект.Дата),ОтчетОбъект.Дата,ТекущаяДатаСеанса());
	
	СтрокаЦБ = Неопределено;
	
	СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБ"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБ = СтрокиПараметров[0];
	КонецЕсли;
	
	Если СтрокаЦБ <> Неопределено Тогда	
		Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
			//Наименование, ОГРН, ИНН, КПП, Местонахождение
			
			МассивРеквизитовЦБ = Новый Массив;
			МассивРеквизитовЦБ.Добавить("Наименование");
			
			Если ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБОГРН")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("ОГРН");
			КонецЕсли;
			
			Если ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБИНН")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("ИНН");
			КонецЕсли;
			
			Если ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБКПП")).Количество() = 0 Тогда
				МассивРеквизитовЦБ.Добавить("КПП");
			КонецЕсли;
			
			МассивРеквизитовЦБ.Добавить("Местонахождение");
				
			РеквизитыЦБ = СтрСоединить(МассивРеквизитовЦБ,",");
			
			СтрокаЦБ.Значение = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеЦБ(ОтчетОбъект.Организация,ТекДата,РеквизитыЦБ);
		Иначе
			СтрокаЦБ.Значение = "";
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБ.Код,СтрокаЦБ.Значение);
	КонецЕсли;
	
	СтрокаЦБРук = Неопределено;
	
	СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБРук"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБРук = СтрокиПараметров[0];
	КонецЕсли;
	
	Если СтрокаЦБРук <> Неопределено Тогда	
		Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
			СтрокаЦБРук.Значение = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеОтветственногоЛицаЦБ(ОтчетОбъект.Организация,"Руководитель",ТекДата);
		Иначе
			СтрокаЦБРук.Значение = "";
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБРук.Код,СтрокаЦБРук.Значение);
	КонецЕсли;
	
	СтрокаЦБРукДолжность = Неопределено;
	
	СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код","ЦБРукДолжность"));
	Если СтрокиПараметров.Количество()>0 Тогда
		СтрокаЦБРукДолжность = СтрокиПараметров[0];
	КонецЕсли;
	
	Если СтрокаЦБРукДолжность <> Неопределено Тогда	
		Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
			
			СтрокаЦБРукДолжность.Значение = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДолжностьОтветственногоЛицаЦБ(ОтчетОбъект.Организация,"Руководитель",ТекДата);
		Иначе
			СтрокаЦБРукДолжность.Значение = "";
		КонецЕсли;
		
		ИзмененныеОбласти.Вставить(СтрокаЦБРукДолжность.Код,СтрокаЦБРукДолжность.Значение);
	КонецЕсли;
	
	РеквизитыЦБСтруктурой = Неопределено;
	
	МассивРеквизитовЦБ = Новый Массив;
	МассивРеквизитовЦБ.Добавить("ОГРН");
	МассивРеквизитовЦБ.Добавить("ИНН");
	МассивРеквизитовЦБ.Добавить("КПП");
	
	Для Каждого ТекРеквЦБ Из МассивРеквизитовЦБ Цикл
		СтрокаПараметраЦБ = Неопределено;
		ИмяРеквизитаЦБ = "ЦБ"+ТекРеквЦБ;
		СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ИмяРеквизитаЦБ));
		Если СтрокиПараметров.Количество()>0 Тогда
			СтрокаПараметраЦБ = СтрокиПараметров[0];
		КонецЕсли;
		
		Если СтрокаПараметраЦБ <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
				Если РеквизитыЦБСтруктурой = Неопределено Тогда
					РеквизитыЦБСтруктурой = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДанныеЦБСтруктурой(ОтчетОбъект.Организация,ТекДата,"ОГРН,ИНН,КПП");
				КонецЕсли;
				
				СтрокаПараметраЦБ.Значение = РеквизитыЦБСтруктурой[ТекРеквЦБ];
			Иначе
				СтрокаПараметраЦБ.Значение = "";
			КонецЕсли;
			ИзмененныеОбласти.Вставить(ИмяРеквизитаЦБ,СтрокаПараметраЦБ.Значение);
		КонецЕсли;
	КонецЦикла;
	
	//для подписантов - Руководитель, ГлБухгалтер, Руководитель финансово- экономической службы (РуководительПФС)
	
	ИмяРуководитель = "Руководитель";
	ИмяГлБухгалтер = "ГлБухгалтер";
	ИмяРуководительПФС = "РуководительПФС";
	
	МассивПараметровПодписантов = Новый Массив;
	
	МассивПараметровПодписантов.Добавить(ИмяРуководитель);
	МассивПараметровПодписантов.Добавить(ИмяГлБухгалтер);
	МассивПараметровПодписантов.Добавить(ИмяРуководительПФС);
	
	Для Каждого ТекЭлемент Из МассивПараметровПодписантов Цикл
		
		СтрокаТекПараметра = Неопределено;
	
		СтрокиПараметров = ОтчетОбъект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ТекЭлемент));
		Если СтрокиПараметров.Количество()>0 Тогда
			СтрокаТекПараметра = СтрокиПараметров[0];
		КонецЕсли;
		
		Если СтрокаТекПараметра <> Неопределено Тогда
			ТекЗначение = "";
			
			Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
				Если ТекЭлемент = ИмяРуководитель Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителя(ОтчетОбъект.Организация,ТекДата);
				ИначеЕсли ТекЭлемент = ИмяГлБухгалтер Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОГлавногоБухгалтера(ОтчетОбъект.Организация,ТекДата);
				ИначеЕсли ТекЭлемент = ИмяРуководительПФС Тогда
					ТекЗначение = БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителяПФС(ОтчетОбъект.Организация,ТекДата);	
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаТекПараметра.Значение = ТекЗначение;
			
			ИзмененныеОбласти.Вставить(ТекЭлемент,СтрокаТекПараметра.Значение);
		КонецЕсли;
	
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВычисляемыеЗначенияПараметровБезКонтекста(ИзмененияДляТабДока,МассивПараметров,АдресТекущейСтраницы,Знач ТекОбъект,АдресОбъектаОтчет)
	
	ОтчетОбъект = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ОтчетОбъект.ОбновитьВычисляемыеПараметры(,Истина);
	ОтчетОбъект.СформироватьСтруктуруПараметров();		
	
	Для Каждого СтрТЧ Из ОтчетОбъект.ПараметрыОтчета Цикл
		СтруктураПараметра = Новый Структура("Код,Наименование,Значение");
		ЗаполнитьЗначенияСвойств(СтруктураПараметра,СтрТЧ);
		МассивПараметров.Добавить(СтруктураПараметра);
		ИзмененияДляТабДока.Вставить(СтрТЧ.Код,СтрТЧ.Значение);
	КонецЦикла;
	
	ТекМакет = ПолучитьИзВременногоХранилища(АдресТекущейСтраницы);
	
	ОтчетОбъект.ЗаполнитьРеквизитыБезМакета(ТекМакет,ИзмененияДляТабДока);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВычисляемыеПараметрыОтчетаКлиент(ИмяПараметра)
	
	ЗначениеПараметра = ПолучитьВычисляемыйПараметрОтчета(Объект,АдресОбъектаОтчет,ИмяПараметра);
		
	СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код",ИмяПараметра));
	Если СтрокиПараметров.Количество() Тогда
		СтрокиПараметров[0].Значение = ЗначениеПараметра;
	КонецЕсли;
	
	ТекОбл = ТабличныйДокументОтчета.Области.Найти(ИмяПараметра);
	Если ТекОбл <> Неопределено Тогда
		Если ТекОбл.СодержитЗначение Тогда
			ТекОбл.Значение = ЗначениеПараметра;
		Иначе
			ТекОбл.Текст = ЗначениеПараметра;
		КонецЕсли;
		
		Если ЗначениеПараметра <> Неопределено Тогда
			ТекОбл.Расшифровка = ЗначениеПараметра;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////
// РАБОТА С ЭКЗЕМПЛЯРОМ ОБЪЕКТА ДОКУМЕНТА
//

// Восстанавливает ОтчетОбъект из временного хранилища.
//
&НаСервере
Процедура ВосстановитьОбъектОтчета()

	Если ОтчетОбъект = Неопределено Тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка,"ВерсияДанных",Истина) <> Объект.ВерсияДанных Тогда
				ЭтотОбъект.Прочитать();
				ОбъектБылИзмененВДругомСеансе = Истина;//если объект был изменен в другом сеансе, не даем включать редактирование
			КонецЕсли;
		КонецЕсли;
		ОтчетОбъект 	 = РеквизитФормыВЗначение("Объект");
		СтруктураСвойств = ПолучитьИзВременногоХранилища(АдресОбъектаОтчет);
		ОтчетОбъект.ЗагрузитьВнутренниеСвойства(СтруктураСвойств);
		
		ОтчетОбъект.БланкОтчета = ОтчетОбъект.ШаблонОтчета;
	КонецЕсли;
	
КонецПроцедуры // ВосстановитьОбъектОтчета()

// Помещает ОтчетОбъект во временное хранилище
//
&НаСервере
Процедура ПоместитьОбъектОтчета()

	Если ОтчетОбъект <> Неопределено Тогда
		ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,АдресОбъектаОтчет);
		ОтчетОбъект = Неопределено; // Во избежание модификации объекта после помещения в хранилище.
	КонецЕсли;

КонецПроцедуры // ПоместитьОбъектОтчета()

&НаКлиенте
Процедура СинхронизироватьКонтекстНовыйВариант()
	
	ТребуетсяСинхронизация = ИзмененныеОбласти.Количество() > 0;
	
	//в данной процедуре не выполняется изменение формата, поэтому разрядность не учитываем
	Если ТребуетсяСинхронизация Тогда
		
		Если ОтображатьВВидеТаблицыФормы = Ложь Тогда
			//для бланков оптимизированная процедура, без контекста
						
			ИзмененияДляТабДока = Новый Структура;
			
			ВходящиеДопПараметры = Новый Структура;
			ВходящиеДопПараметры.Вставить("АдресТекущейСтраницы",АдресТекущейСтраницы);
			ВходящиеДопПараметры.Вставить("АдресОбъектаОтчет",АдресОбъектаОтчет);
			ВходящиеДопПараметры.Вставить("ВыводитьРаскрытиеВТелеБланка",Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
			
			ТребуетсяПерерисовкаТаблицИтогов = Ложь;
								
			СинхронизироватьКонтекстНовыйВариантБезКонтекста(ИзмененияДляТабДока, Объект, ВходящиеДопПараметры, ИзмененныеОбласти, ТребуетсяПерерисовкаТаблицИтогов);
			
			//установим значения измененных областей - Значение/Текст и для некоторых Расшифровка
			Для Каждого КлючиИЗначение Из ИзмененияДляТабДока Цикл
				ТекОбл = ТабличныйДокументОтчета.Области.Найти(КлючиИЗначение.Ключ);
				Если ТекОбл <> Неопределено Тогда
					УстанавливаемыеСвойства = КлючиИЗначение.Значение;
					Для Каждого КлючИЗначениеСвойств Из УстанавливаемыеСвойства Цикл
						ТекОбл[КлючИЗначениеСвойств.Ключ] = КлючИЗначениеСвойств.Значение;	
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			Если ТребуетсяПерерисовкаТаблицИтогов Тогда
				//изменилась высота областей программных итогов, нужно идти на сервер
				ОбновитьОбластиРаскрытияИтогов(Объект,АдресОбъектаОтчет,ТабличныйДокументОтчета);
			КонецЕсли;			
			
		Иначе
			СинхронизироватьКонтекстСервер();
		КонецЕсли;
		
		
	КонецЕсли;

КонецПроцедуры // СинхронизироватьКонтекстНовыйВариант()

&НаСервереБезКонтекста
Процедура СинхронизироватьКонтекстНовыйВариантБезКонтекста(ИзмененияДляТабДока, Знач ТекОбъект, ВходящиеДопПараметры, ИзмененныеОбласти, ТребуетсяПерерисовкаТаблицИтогов)
	
	Перем АдресТекущейСтраницы, АдресОбъектаОтчет, ВыводитьРаскрытиеВТелеБланка;
	
	АдресТекущейСтраницы = ВходящиеДопПараметры.АдресТекущейСтраницы;
	АдресОбъектаОтчет = ВходящиеДопПараметры.АдресОбъектаОтчет;
	ВыводитьРаскрытиеВТелеБланка = ВходящиеДопПараметры.ВыводитьРаскрытиеВТелеБланка;
			
	ОтчетОбъект = Неопределено;
	
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
								  
	ТекМакет = ПолучитьИзВременногоХранилища(АдресТекущейСтраницы);//макет нужен для поиска в нем областей с именами параметров, показателей, реквизитов и др.
	
	ИзмененияДляТабДока = ПолучитьИзмененияТабличногоДокументаБезКонтекста(ОтчетОбъект, ТекМакет, ИзмененныеОбласти);
			
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтоговВСтруктуре(ТекМакет,ИзмененияДляТабДока,ТребуетсяПерерисовкаТаблицИтогов);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИзмененияТабличногоДокументаБезКонтекста(ОтчетОбъект,ТекМакет,ИзмененныеОбласти)
	
	ИзмененияПоказателей = Новый Структура;
	
	ИзмененыПараметры 		= Ложь;
	ИзмененыДопРеквизиты	= Ложь;
	
	ИзмененныеТаблицыРаскрытия = Новый Соответствие;
	ИзмененныеПоказатели	   = Новый Соответствие;
	
	// Синхронизация значений областей.
	Для Каждого ИзмененнаяОбласть Из ИзмененныеОбласти Цикл
		
		ИмяОбласти      = ИзмененнаяОбласть.Ключ;
		НовоеЗначение   = ИзмененнаяОбласть.Значение;
			
		ВидОбласти = ПолучитьВидИсточникаДанныхОбластиБезКонтекста(ИмяОбласти,ОтчетОбъект);
		
		Если ВидОбласти = 0 Тогда
			
			ПоказательОбласти = ОтчетОбъект.мПоказатели.Найти(ИмяОбласти,"Код");
			
			Если НовоеЗначение = Неопределено Тогда
				НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(ПоказательОбласти.ТипЗначения).ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ВведенноеЗначение = НовоеЗначение;
			
			Если ПоказательОбласти.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				
				Если НЕ ПоказательОбласти.НеМасштабируется Тогда
					ВведенноеЗначение = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				КонецЕсли;
				
				ПоказательОбласти.Значение = ВведенноеЗначение;
				
			Иначе
				ПоказательОбласти.Значение = НовоеЗначение;
			КонецЕсли;
			
			ПоказательОбласти.ДанныеРасчета 			 = Неопределено;
			ПоказательОбласти.СохраненныеДанныеАктуальны = Ложь;
	
			ОтчетОбъект.Показатели[ПоказательОбласти.Код] 			= ВведенноеЗначение;
			ОтчетОбъект.ИзмененныеПоказатели[ПоказательОбласти.Код]	= Истина;
						
			ИзмененныеПоказатели.Вставить(ПоказательОбласти.Код,Истина);
			
		ИначеЕсли ВидОбласти = 1 Тогда
			
			ОтчетОбъект[ИмяОбласти] = НовоеЗначение;
			ИзмененыПараметры		= Истина;
			
		ИначеЕсли ВидОбласти = 2 Тогда
			
			СтрПараметр = ОтчетОбъект.ПараметрыОтчета.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = НовоеЗначение;
			КонецЕсли;
			
			ИзмененыПараметры = Истина;
			
		ИначеЕсли ВидОбласти = 3 Тогда
			
			СтрПараметр = ОтчетОбъект.мДополнительныеРеквизиты.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = СтрПараметр.ТипЗначения.ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ИзмененыДопРеквизиты = Истина;
			
		ИначеЕсли ВидОбласти = 4 ИЛИ ВидОбласти = 5 Тогда
			
			РеквизитыИмени = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
			ЭлементыКода   = СтрРазделить(РеквизитыИмени.ИмяИсходнойОбласти,"_",Ложь);
			
			КодГруппы = ЭлементыКода[0];
			КодСтроки = ЭлементыКода[1];
			
			СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
			Если СтрРаскрытия = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока = СтрРаскрытия.ТаблицаРаскрытия.Найти(РеквизитыИмени.Идентификатор,"ID");
			Если ТекСтрока = Неопределено Тогда
				Продолжить; // Строка отсутствует в данных, возможно, она удалена.
			КонецЕсли;
			
			// Разбор составляющих имени области.
			ПрефиксИмениОбласти = КодГруппы + "_" + КодСтроки + "_";
			ПотенциальныйКодПоказателя = Сред(РеквизитыИмени.ИмяИсходнойОбласти, СтрДлина(ПрефиксИмениОбласти + "Показатель_") + 1);
			
			ЭтоОбластьПоказателя = ЭлементыКода.Количество() > 4 И ЭлементыКода[2] = "Показатель"
								   И СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти(ПотенциальныйКодПоказателя) <> Неопределено;
								   
			ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
			
			Если Не ЭтоОбластьПоказателя Тогда
				
				Для НомерАналитики = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
					Префикс = ПрефиксИмениОбласти + "Аналитика" + НомерАналитики + "_";
					Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено И Лев(ИмяОбласти, СтрДлина(Префикс)) = Префикс Тогда // это область реквизита одной из аналитик
						ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			ИмяКолонки = ?(ЭтоОбластьПоказателя,ПотенциальныйКодПоказателя,"Аналитика" + НомерАналитики);
			Если ЭтоОбластьПоказателя Тогда
				
				СтрПок = ОтчетОбъект.мПоказатели.Найти(ИмяКолонки,"Код");
				
				Если НовоеЗначение = Неопределено Тогда
					НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрПок.ТипЗначения).ПривестиЗначение(НовоеЗначение);
				КонецЕсли;
				
				Если СтрПок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число и Не СтрПок.НеМасштабируется Тогда
					ЗначениеКолонки = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				Иначе
					ЗначениеКолонки = НовоеЗначение;
				КонецЕсли;
				
				ТекСтрока[ИмяКолонки]                = ЗначениеКолонки;
				ТекСтрока[ИмяКолонки+"_Отображение"] = НовоеЗначение;
			Иначе
				ТекСтрока[ИмяКолонки] = НовоеЗначение;
			КонецЕсли;
			
			ИнформацияИзмененнойТаблицы = ИзмененныеТаблицыРаскрытия[СтрРаскрытия];
			Если ИнформацияИзмененнойТаблицы = Неопределено Тогда
				ИнформацияИзмененнойТаблицы = Новый Структура;
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеКолонки",Новый Массив);
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеСтроки"	,Новый Массив);
				
				ИзмененныеТаблицыРаскрытия[СтрРаскрытия] = ИнформацияИзмененнойТаблицы;
				
			КонецЕсли;
			
			Если ИнформацияИзмененнойТаблицы.ИзмененныеКолонки.Найти(ИмяКолонки) = Неопределено Тогда						
				ИнформацияИзмененнойТаблицы.ИзмененныеКолонки.Добавить(ИмяКолонки);
			КонецЕсли;
			Если ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
				ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Добавить(ТекСтрока);
			КонецЕсли;
			
			ИзмененныеПоказатели.Вставить(ИмяКолонки,Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Перенос изменений параметров и доп. реквизитов.
	Если ИзмененыПараметры или ИзмененыДопРеквизиты Тогда
		
		ОтчетОбъект.СформироватьСтруктуруПараметров(); // Синхронизация структуры параметров и реквизитов объекта.
		ОтчетОбъект.СформироватьСтруктуруДополнительныхРеквизитов();
				
	КонецЕсли;
	
	
	Если ИзмененныеПоказатели.Количество() > 0 Тогда
		
		МассивПоказателей = Новый Массив;
		Для Каждого Запись Из ИзмененныеПоказатели Цикл
			МассивПоказателей.Добавить(Запись.Ключ);
		КонецЦикла;
		
		ЗависимыеПоказатели  = ПолучитьЗависимыеПоказателиБезКонтекста(МассивПоказателей,ОтчетОбъект);
		ИзмененныеПоказатели = Неопределено;
		
		// Перенос изменений раскрытия в данные отчета.
		Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
			
			СтрРаскрытия = Запись.Ключ;
			Информация   = Запись.Значение;
			
			ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,Информация.ИзмененныеСтроки,Информация.ИзмененныеКолонки);
			Если ЗависимыеПоказатели.Количество() = 0 Тогда
				ОтчетОбъект.УстановитьИтогиПоПоказателям(Информация.ИзмененныеКолонки);
				ОтразитьИзмененныеСтрокиВМакетеРаскрытияНовыйВариантБезКонтекста(ТекМакет, ИзмененияПоказателей, ОтчетОбъект, СтрРаскрытия,Информация.ИзмененныеСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		// Отрисовка изменений в бланке отчета.
		Если ЗависимыеПоказатели.Количество() > 0 Тогда	
			
			// Выполнение пересчета.
			ПересчитатьПоказателиБезКонтекста(ОтчетОбъект, МассивПоказателей, ЗависимыеПоказатели);
			
			Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
				
				СтрРаскрытия = Запись.Ключ;
				Информация   = Запись.Значение;
				
				НоваяТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
				МассивСтрок           = Новый Массив;
				
				Для Каждого ИзмСтрока Из Информация.ИзмененныеСтроки Цикл
					НомерСтроки = СтрРаскрытия.ТаблицаРаскрытия.Индекс(ИзмСтрока);
					МассивСтрок.Добавить(НоваяТаблицаРаскрытия[НомерСтроки]);
				КонецЦикла;
				
				СтрРаскрытия.ТаблицаРаскрытия = НоваяТаблицаРаскрытия;
				
				ОтразитьИзмененныеСтрокиВМакетеРаскрытияНовыйВариантБезКонтекста(ТекМакет, ИзмененияПоказателей, ОтчетОбъект, СтрРаскрытия,МассивСтрок);
				
			КонецЦикла;
			
		КонецЕсли;
		
		МассивПоказателейСтраницы = ПолучитьМассивПоказателейСтраницы(ОтчетОбъект);
		
		ОтчетОбъект.ЗаполнитьПоказателиБезМакета(ТекМакет,ИзмененияПоказателей,МассивПоказателейСтраницы);
		
	КонецЕсли;
	
	//Пересчет ячеек с представлением
	ОтчетОбъект.ЗаполнитьРеквизитыБезМакета(ТекМакет,ИзмененияПоказателей);

	ИзмененныеОбласти.Очистить();
	
	Возврат ИзмененияПоказателей;
	
КонецФункции // ПрименитьИзмененияОбъектаНаСервере()

&НаСервереБезКонтекста
Процедура ОбновитьОбластиРаскрытияИтогов(Знач ТекОбъект, АдресОбъектаОтчет, ТабличныйДокументОтчета)
	ОтчетОбъект = Неопределено;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
	
	ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
	
	ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтразитьИзмененныеСтрокиВМакетеРаскрытияНовыйВариантБезКонтекста(ТекМакет, ИзмененияПоказателей, ОтчетОбъект, СтрРаскрытия, Знач ИзмененныеСтроки)

	Обл = ТекМакет.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыГруппы 	= ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	КодГруппыРаскрытия 	= СокрП(ПараметрыГруппы.КодГруппыРаскрытия);
	МакетыРаскрытия 	= ОтчетОбъект.ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	Если МакетыРаскрытия = Неопределено или МакетыРаскрытия.Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИзмененныеСтроки) = Тип("СтрокаТаблицыЗначений") Тогда
		Стр = ИзмененныеСтроки;
		ИзмененныеСтроки = Новый Массив;
		ИзмененныеСтроки.Добавить(Стр);
	КонецЕсли;
	
	ВысотаШапки = ?(МакетыРаскрытия.Шапка = Неопределено, 0, МакетыРаскрытия.Шапка.ВысотаТаблицы);
	МакетыРаскрытия.Шапка  = Неопределено; // Запрет генерации макета шапки;
	
	ВысотаМакетаСтроки     = МакетыРаскрытия.Строка.ВысотаТаблицы;
	НачалоОбластиРаскрытия = Обл.Низ + 1;
	
	// Запись данных раскрытия после пересчета.
	ПолнаяТаблицаРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	// Генерация измененных макетов.
	ТаблицаИзмененныхСтрок = СтрРаскрытия.ТаблицаРаскрытия.Скопировать(ИзмененныеСтроки);
	ТаблицаИзмененныхСтрок.Сортировать("ID");
	СтруктураИменОбластейСОформлением = Новый Структура;
	МакетИзмененныхСтрок   = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,ТаблицаИзмененныхСтрок,,СтрРаскрытия.КодСтроки,МакетыРаскрытия,СтруктураИменОбластейСОформлением);
	
	Для Каждого ТекОбл Из МакетИзмененныхСтрок.Области Цикл
		Если ТекОбл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			ИЛИ (ТекОбл.СодержитЗначение <> Истина 
				И ТекОбл.АвтоотметкаНезаполненного = Ложь) Тогда
			Продолжить;
		КонецЕсли;
						
		СтруктураЗначений = Новый Структура;
		Если ТекОбл.СодержитЗначение Тогда
			СтруктураЗначений.Вставить("Значение",ТекОбл.Значение);
		Иначе
			СтруктураЗначений.Вставить("Текст",ТекОбл.Текст);
		КонецЕсли;
		СтруктураЗначений.Вставить("Расшифровка",ТекОбл.Расшифровка);
		
		МассивПолей = Новый Массив;
		Если СтруктураИменОбластейСОформлением.Свойство(ТекОбл.Имя,МассивПолей) Тогда
			Для Каждого ТекПолеОбласти Из МассивПолей Цикл
				СтруктураЗначений.Вставить(ТекПолеОбласти,ТекОбл[ТекПолеОбласти]);	
			КонецЦикла;
		КонецЕсли;
		ИзмененияПоказателей.Вставить(ТекОбл.Имя,СтруктураЗначений);
	КонецЦикла;
	
КонецПроцедуры // ОтразитьИзмененныеСтрокиВМакетеРаскрытия()

&НаСервере
Процедура СинхронизироватьКонтекстСервер(Знач Поместить = Истина, Знач СразуОтобразитьИзменения = Истина)

	ВосстановитьОбъектОтчета();
	
	ТребуетсяПолныйПересчет = (ОтчетОбъект.УровеньТочности <> Объект.УровеньТочности)
							  ИЛИ (ОтчетОбъект.ЕдиницаИзмерения <> Объект.ЕдиницаИзмерения);
	
	ИспользуетсяМакет = ОтображатьВВидеТаблицыФормы;
	Если ИспользуетсяМакет Тогда

		ПрименитьИзмененияТаблицыРедактированияНаСервере();
		
		Если СразуОтобразитьИзменения Тогда
			ВывестиДанныеОтчета();
		КонецЕсли;
		
	Иначе
		
		ПрименитьИзмененияТабличногоДокументаНаСервере();
		
		Если ТребуетсяПолныйПересчет и СразуОтобразитьИзменения Тогда
			ВывестиДанныеОтчета();
		КонецЕсли;
		
	КонецЕсли;
	
	Если Поместить Тогда
		Если НЕ ИспользуетсяМакет Тогда
			ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);
		КонецЕсли;
		ПоместитьОбъектОтчета();
	КонецЕсли;

КонецПроцедуры // СинхронизироватьКонтекстСервер()

//////////////////////////////////////////////////////////////////////////////////////////

&НаСервереБезКонтекста
Функция СинхронизироватьКонтекстБезКонтекста(ВернутьОтчетОбъект, Знач ТекОбъект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры)
	
	ОтчетОбъект = Неопределено;
	
	Поместить = (ВернутьОтчетОбъект = Ложь);
	
	АдресОбъектаОтчет = ВходящиеПараметры.АдресОбъектаОтчет;
	ВыводитьРаскрытиеВТелеБланка = ВходящиеПараметры.ВыводитьРаскрытиеВТелеБланка;
	
	ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет);
				
	ПрименитьИзмененияТабличногоДокументаБезКонтекста(ОтчетОбъект,ИзмененныеОбласти,ТабличныйДокументОтчета);
				
	Если Поместить Тогда		
		ОтчетОбъект.ЗаполнитьТаблицыРаскрытияИтогов(ТабличныйДокументОтчета);	
		ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет);
	КонецЕсли;
	
	Если ВернутьОтчетОбъект = Истина Тогда
		Возврат ОтчетОбъект;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции


&НаСервереБезКонтекста
Процедура ОбновитьДанныеОтчетаБезКонтекста(ОтчетОбъект,ТабличныйДокументОтчета,Знач ВыводитьРаскрытиеВТелеБланка = Неопределено) 

	ОбновитьСтраницуБезКонтекста(ОтчетОбъект,ТабличныйДокументОтчета,ВыводитьРаскрытиеВТелеБланка);

КонецПроцедуры // ВывестиДанныеОтчета()


&НаСервереБезКонтекста
Процедура ОбновитьСтраницуБезКонтекста(ОтчетОбъект,ТабличныйДокументОтчета,РежимРаскрытия)
		
	ОбновитьСтраницуОтчетаБезКонтекста(ТабличныйДокументОтчета,ОтчетОбъект,РежимРаскрытия);
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьСтраницуОтчетаБезКонтекста(ТабличныйДокументОтчета,ОтчетОбъект, Знач ВыводитьРаскрытиеВТеле = Неопределено)
	
	МассивПоказателейСтраницы = ПолучитьМассивПоказателейСтраницы(ОтчетОбъект);
	
	ОтчетОбъект.ЗаполнитьМакет(ТабличныйДокументОтчета,МассивПоказателейСтраницы);//ТабДокумент
	
	Если ВыводитьРаскрытиеВТеле = Неопределено Тогда // Авто
		РежимРаскрытия 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ШаблонОтчета,"РаскрытиеВМакете");
		ВыводитьРаскрытиеВТеле  = (РежимРаскрытия = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета);
	КонецЕсли;
		
	Если ВыводитьРаскрытиеВТеле Тогда
						
		Если ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабличныйДокументОтчета) Тогда
			
			Для Каждого СтрРаскрытия Из ОтчетОбъект.ТабОбластиРаскрытия Цикл
				ОтчетОбъект.ВыполнитьГруппировкуСтроки(СтрРаскрытия,ТабличныйДокументОтчета);
				СтрРаскрытия.ТабДокРаскрытие.Очистить();
			КонецЦикла;
						
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСтраницуОтчетаБезКонтекста()

&НаСервереБезКонтекста
Процедура ПрименитьИзмененияТабличногоДокументаБезКонтекста(ОтчетОбъект,ИзмененныеОбласти,ТабличныйДокументОтчета)
 
	ИзмененыПараметры 		= Ложь;
	ИзмененыДопРеквизиты	= Ложь;
	
	ИзмененныеТаблицыРаскрытия = Новый Соответствие;
	ИзмененныеПоказатели	   = Новый Соответствие;
	
	// Синхронизация значений областей.
	Для Каждого ИзмененнаяОбласть Из ИзмененныеОбласти Цикл
		
		ИмяОбласти      = ИзмененнаяОбласть.Ключ;
		НовоеЗначение   = ИзмененнаяОбласть.Значение;
				
		ВидОбласти = ПолучитьВидИсточникаДанныхОбластиБезКонтекста(ИмяОбласти,ОтчетОбъект);
		
		Если ВидОбласти = 0 Тогда
			
			ПоказательОбласти = ОтчетОбъект.мПоказатели.Найти(ИмяОбласти,"Код");
			
			Если НовоеЗначение = Неопределено Тогда
				НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(ПоказательОбласти.ТипЗначения).ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ВведенноеЗначение = НовоеЗначение;
			
			Если ПоказательОбласти.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				
				Если НЕ ПоказательОбласти.НеМасштабируется Тогда
					ВведенноеЗначение = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				КонецЕсли;
				
				ПоказательОбласти.Значение = ВведенноеЗначение;
				
			Иначе
				ПоказательОбласти.Значение = НовоеЗначение;
			КонецЕсли;
			
			ПоказательОбласти.ДанныеРасчета 			 = Неопределено;
			ПоказательОбласти.СохраненныеДанныеАктуальны = Ложь;
	
			ОтчетОбъект.Показатели[ПоказательОбласти.Код] 			= ВведенноеЗначение;
			ОтчетОбъект.ИзмененныеПоказатели[ПоказательОбласти.Код]	= Истина;
						
			ИзмененныеПоказатели.Вставить(ПоказательОбласти.Код,Истина);
			
		ИначеЕсли ВидОбласти = 1 Тогда
			
			ОтчетОбъект[ИмяОбласти] = НовоеЗначение;
			ИзмененыПараметры		= Истина;
			
		ИначеЕсли ВидОбласти = 2 Тогда
			
			СтрПараметр = ОтчетОбъект.ПараметрыОтчета.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = НовоеЗначение;
			КонецЕсли;
			
			ИзмененыПараметры = Истина;
			
		ИначеЕсли ВидОбласти = 3 Тогда
			
			СтрПараметр = ОтчетОбъект.мДополнительныеРеквизиты.Найти(ИмяОбласти,"Код");
			Если Не СтрПараметр = Неопределено Тогда
				СтрПараметр.Значение = СтрПараметр.ТипЗначения.ПривестиЗначение(НовоеЗначение);
			КонецЕсли;
			
			ИзмененыДопРеквизиты = Истина;
			
		ИначеЕсли ВидОбласти = 4 ИЛИ ВидОбласти = 5 Тогда
			
			РеквизитыИмени = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
			ЭлементыКода   = СтрРазделить(РеквизитыИмени.ИмяИсходнойОбласти,"_",Ложь);
			
			КодГруппы = ЭлементыКода[0];
			КодСтроки = ЭлементыКода[1];
			
			СтрРаскрытия = ОтчетОбъект.ТабОбластиРаскрытия.Найти(КодСтроки,"КодСтроки");
			Если СтрРаскрытия = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока = СтрРаскрытия.ТаблицаРаскрытия.Найти(РеквизитыИмени.Идентификатор,"ID");
			Если ТекСтрока = Неопределено Тогда
				Продолжить; // Строка отсутствует в данных, возможно, она удалена.
			КонецЕсли;
			
			// Разбор составляющих имени области.
			ПрефиксИмениОбласти = КодГруппы + "_" + КодСтроки + "_";
			ПотенциальныйКодПоказателя = Сред(РеквизитыИмени.ИмяИсходнойОбласти, СтрДлина(ПрефиксИмениОбласти + "Показатель_") + 1);
			
			ЭтоОбластьПоказателя = ЭлементыКода.Количество() > 4 И ЭлементыКода[2] = "Показатель"
								   И СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти(ПотенциальныйКодПоказателя) <> Неопределено;
								   
			ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
			
			Если Не ЭтоОбластьПоказателя Тогда
				
				Для НомерАналитики = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
					Префикс = ПрефиксИмениОбласти + "Аналитика" + НомерАналитики + "_";
					Если СтрРаскрытия.ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено И Лев(ИмяОбласти, СтрДлина(Префикс)) = Префикс Тогда // это область реквизита одной из аналитик
						ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			ИмяКолонки = ?(ЭтоОбластьПоказателя,ПотенциальныйКодПоказателя,"Аналитика" + НомерАналитики);
			Если ЭтоОбластьПоказателя Тогда
				
				СтрПок = ОтчетОбъект.мПоказатели.Найти(ИмяКолонки,"Код");
				
				Если НовоеЗначение = Неопределено Тогда
					НовоеЗначение = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрПок.ТипЗначения).ПривестиЗначение(НовоеЗначение);
				КонецЕсли;
				
				Если СтрПок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число и Не СтрПок.НеМасштабируется Тогда
					ЗначениеКолонки = НовоеЗначение * ОтчетОбъект.ВернутьЗначениеДелителя();
				Иначе
					ЗначениеКолонки = НовоеЗначение;
				КонецЕсли;
				
				ТекСтрока[ИмяКолонки]                = ЗначениеКолонки;
				ТекСтрока[ИмяКолонки+"_Отображение"] = НовоеЗначение;
			Иначе
				ТекСтрока[ИмяКолонки] = НовоеЗначение;
			КонецЕсли;
			
			ИнформацияИзмененнойТаблицы = ИзмененныеТаблицыРаскрытия[СтрРаскрытия];
			Если ИнформацияИзмененнойТаблицы = Неопределено Тогда
				ИнформацияИзмененнойТаблицы = Новый Структура;
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеКолонки",Новый Массив);
				ИнформацияИзмененнойТаблицы.Вставить("ИзмененныеСтроки"	,Новый Массив);
				
				ИзмененныеТаблицыРаскрытия[СтрРаскрытия] = ИнформацияИзмененнойТаблицы;
				
			КонецЕсли;
			
			Если ИнформацияИзмененнойТаблицы.ИзмененныеКолонки.Найти(ИмяКолонки) = Неопределено Тогда						
				ИнформацияИзмененнойТаблицы.ИзмененныеКолонки.Добавить(ИмяКолонки);
			КонецЕсли;
			Если ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
				ИнформацияИзмененнойТаблицы.ИзмененныеСтроки.Добавить(ТекСтрока);
			КонецЕсли;
			
			ИзмененныеПоказатели.Вставить(ИмяКолонки,Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Перенос изменений параметров и доп. реквизитов.
	Если ИзмененыПараметры или ИзмененыДопРеквизиты Тогда
		
		ОтчетОбъект.СформироватьСтруктуруПараметров(); // Синхронизация структуры параметров и реквизитов объекта.
		ОтчетОбъект.СформироватьСтруктуруДополнительныхРеквизитов();
				
	КонецЕсли;
		
	Если ИзмененныеПоказатели.Количество() > 0 Тогда
		
		МассивПоказателей = Новый Массив;
		Для Каждого Запись Из ИзмененныеПоказатели Цикл
			МассивПоказателей.Добавить(Запись.Ключ);
		КонецЦикла;
		
		ЗависимыеПоказатели  = ПолучитьЗависимыеПоказателиБезКонтекста(МассивПоказателей,ОтчетОбъект);
		ИзмененныеПоказатели = Неопределено;
		
		// Перенос изменений раскрытия в данные отчета.
		Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
			
			СтрРаскрытия = Запись.Ключ;
			Информация   = Запись.Значение;
			
			ОтчетОбъект.ПрименитьИзмененияТаблицыРаскрытия(СтрРаскрытия.ГруппаРаскрытия,СтрРаскрытия.ТаблицаРаскрытия,Информация.ИзмененныеСтроки,Информация.ИзмененныеКолонки);
			Если ЗависимыеПоказатели.Количество() = 0 Тогда
				ОтчетОбъект.УстановитьИтогиПоПоказателям(Информация.ИзмененныеКолонки);
				ОтразитьИзмененныеСтрокиВМакетеРаскрытияБезКонтекста(ТабличныйДокументОтчета, ОтчетОбъект, СтрРаскрытия,Информация.ИзмененныеСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		// Отрисовка изменений в бланке отчета.
		Если ЗависимыеПоказатели.Количество() > 0 Тогда	
			
			// Выполнение пересчета.
			ПересчитатьПоказателиБезКонтекста(ОтчетОбъект, МассивПоказателей, ЗависимыеПоказатели);
			
			Для Каждого Запись Из ИзмененныеТаблицыРаскрытия Цикл
				
				СтрРаскрытия = Запись.Ключ;
				Информация   = Запись.Значение;
				
				НоваяТаблицаРаскрытия = ОтчетОбъект.ПолучитьТаблицуРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
				МассивСтрок           = Новый Массив;
				
				Для Каждого ИзмСтрока Из Информация.ИзмененныеСтроки Цикл
					НомерСтроки = СтрРаскрытия.ТаблицаРаскрытия.Индекс(ИзмСтрока);
					МассивСтрок.Добавить(НоваяТаблицаРаскрытия[НомерСтроки]);
				КонецЦикла;
				
				СтрРаскрытия.ТаблицаРаскрытия = НоваяТаблицаРаскрытия;
				
				ОтразитьИзмененныеСтрокиВМакетеРаскрытияБезКонтекста(ТабличныйДокументОтчета, ОтчетОбъект, СтрРаскрытия,МассивСтрок);
				
			КонецЦикла;
			
		КонецЕсли;
		
		МассивПоказателейСтраницы = ПолучитьМассивПоказателейСтраницы(ОтчетОбъект);
		
		ОтчетОбъект.ЗаполнитьПоказателиВМакете(ТабличныйДокументОтчета,МассивПоказателейСтраницы);
		
	КонецЕсли;
	
	//Пересчет ячеек с представлением
	ОтчетОбъект.ЗаполнитьРеквизитыВМакете(ТабличныйДокументОтчета);

	ИзмененныеОбласти.Очистить();
	
КонецПроцедуры // ПрименитьИзмененияОбъектаНаСервере()

&НаСервереБезКонтекста
Процедура ОтразитьИзмененныеСтрокиВМакетеРаскрытияБезКонтекста(ТабличныйДокументОтчета, ОтчетОбъект, СтрРаскрытия, Знач ИзмененныеСтроки)

	Обл = ТабличныйДокументОтчета.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыГруппы 	= ОтчетОбъект.ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	КодГруппыРаскрытия 	= СокрП(ПараметрыГруппы.КодГруппыРаскрытия);
	МакетыРаскрытия 	= ОтчетОбъект.ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия+"_"+СтрРаскрытия.КодСтроки);
	
	Если МакетыРаскрытия = Неопределено или МакетыРаскрытия.Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИзмененныеСтроки) = Тип("СтрокаТаблицыЗначений") Тогда
		Стр = ИзмененныеСтроки;
		ИзмененныеСтроки = Новый Массив;
		ИзмененныеСтроки.Добавить(Стр);
	КонецЕсли;
	
	ВысотаШапки = ?(МакетыРаскрытия.Шапка = Неопределено, 0, МакетыРаскрытия.Шапка.ВысотаТаблицы);
	МакетыРаскрытия.Шапка  = Неопределено; // Запрет генерации макета шапки;
	
	ВысотаМакетаСтроки     = МакетыРаскрытия.Строка.ВысотаТаблицы;
	НачалоОбластиРаскрытия = Обл.Низ + 1;
	
	// Запись данных раскрытия после пересчета.
	ПолнаяТаблицаРаскрытия = СтрРаскрытия.ТаблицаРаскрытия;
	
	// Генерация измененных макетов.
	ТаблицаИзмененныхСтрок = СтрРаскрытия.ТаблицаРаскрытия.Скопировать(ИзмененныеСтроки);
	ТаблицаИзмененныхСтрок.Сортировать("ID");
	МакетИзмененныхСтрок   = ОтчетОбъект.СгенерироватьМакетРаскрытияСтрока(СтрРаскрытия.ГруппаРаскрытия,ТаблицаИзмененныхСтрок,,СтрРаскрытия.КодСтроки,МакетыРаскрытия);
	
	//Если в форме задан отбор для строк раскрытия (интерактивно или при расшифровке),
	//то в форме выводятся не все строки раскрытия.
	//Чтобы определить, какую строку таб.дока надо заменить, нужно найти область, 
	//у которой Идентификатор = ID, и вот эта строка - это нужная для актуализации строка.
	
	НомерСтрокиИскомойОбласти = НачалоОбластиРаскрытия;
	
	ИскомаяСтрока = "_" + СтрРаскрытия.КодСтроки;
		
	НомерКолонки = Обл.Лево;
	
	Для Кол = Обл.Лево По ТабличныйДокументОтчета.ШиринаТаблицы Цикл

		ИмяОбласти = ТабличныйДокументОтчета.Область(НомерСтрокиИскомойОбласти,Кол).Имя;

		Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")>0
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")>0  Тогда
			НомерКолонки = Кол;
			Прервать;
		КонецЕсли;
				
	КонецЦикла;
	
	НомерСтрокиИскомойОбластиЭталон = НомерСтрокиИскомойОбласти;
	
	СчетчикСтрок = 1;
	Для Каждого СтрТаблицы Из ТаблицаИзмененныхСтрок Цикл
		СтрокаID = "_"+Формат(СтрТаблицы.ID,"ЧН=0; ЧГ=0");
		Пока НомерСтрокиИскомойОбласти<=СтрРаскрытия.ВысотаТабДокРаскрытия+НомерСтрокиИскомойОбласти Цикл
		
			ИмяОбласти = ТабличныйДокументОтчета.Область(НомерСтрокиИскомойОбласти,НомерКолонки).Имя;
			
			Если СтрЗаканчиваетсяНа(ИмяОбласти, СтрокаID) Тогда
				
				Прервать;
						
			Иначе
				НомерСтрокиИскомойОбласти=НомерСтрокиИскомойОбласти+1;				
				
			КонецЕсли;
			
		КонецЦикла;
		
		КоординатаВерх = НомерСтрокиИскомойОбласти; // НачалоОбластиРаскрытия + ВысотаШапки + СтрТаблицы.Индекс * ВысотаМакетаСтроки - ВысотаМакетаСтроки;
		КоординатаНиз  = КоординатаВерх + ВысотаМакетаСтроки-1;
		
		КоординатаВерхНов = 1 + СчетчикСтрок * ВысотаМакетаСтроки - ВысотаМакетаСтроки;
		КоординатаНизНов = КоординатаВерхНов + ВысотаМакетаСтроки-1;
		
		ОбластьНовыхДанных  = МакетИзмененныхСтрок.Область(КоординатаВерхНов,,КоординатаНизНов);
		ОбластьСтарыхДанных = ТабличныйДокументОтчета.Область(КоординатаВерх,,КоординатаНиз);
		
		ТабличныйДокументОтчета.ВставитьОбласть(ОбластьНовыхДанных,ОбластьСтарыхДанных);
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
	КонецЦикла;
	
	// Запомним макет раскрытия.
	СтрРаскрытия.ТабДокРаскрытие = ТабличныйДокументОтчета.ПолучитьОбласть(НачалоОбластиРаскрытия,,НачалоОбластиРаскрытия+СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы-1);
	//тут не запоминаем высоту СтрРаскрытия.ВысотаТабДокРаскрытия, т.к. в таблице раскрытия только измененные строки
	
КонецПроцедуры // ОтразитьИзмененныеСтрокиВМакетеРаскрытия()

&НаСервереБезКонтекста
Функция ПолучитьВидИсточникаДанныхОбластиБезКонтекста(ИмяЯчейки,ОтчетОбъект)
    
	Если ВРег(ИмяЯчейки) = ВРег("Дата") Или ВРег(ИмяЯчейки) = ВРег("Номер")
	 Или Метаданные.Документы.УниверсальныйРегламентированныйОтчет.Реквизиты.Найти(ИмяЯчейки) <> Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	
	Если Найти(ИмяЯчейки,"_Аналитика") > 0 Тогда
		Возврат 4;
	КонецЕсли;
	
	Если Найти(ИмяЯчейки,"_Показатель") > 0 Тогда
		Возврат 5;
	КонецЕсли;
	
	Если ОтчетОбъект.Параметры.Свойство(ИмяЯчейки) Тогда
		Возврат 2;
	КонецЕсли;
	
	Если ОтчетОбъект.мДополнительныеРеквизиты.Найти(ИмяЯчейки,"Код") <> Неопределено Тогда
		Возврат 3;
	КонецЕсли;
	
	Если ОтчетОбъект.мПоказатели.Найти(ИмяЯчейки,"Код") <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗависимыеПоказателиБезКонтекста(ИзмененныеПоказатели,ОтчетОбъект)

	МассивПоказателей = ИзмененныеПоказатели;
	
	МассивЗависимыхПоказателей = Новый Массив;
	
	Для Каждого СтрПоказатель ИЗ МассивПоказателей Цикл
		
		ПутьВычисления = ОтчетОбъект.ПолучитьПутьВычисления(СтрПоказатель);
		Если ПутьВычисления <> Неопределено Тогда
			Для Каждого ТекПоказатель Из ПутьВычисления Цикл
				Если МассивЗависимыхПоказателей.Найти(ТекПоказатель) = Неопределено Тогда
					МассивЗависимыхПоказателей.Добавить(ТекПоказатель);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	МассивДопПоказателейДляВычисления = ОтчетОбъект.мМассивДополнительныхПоказателейДляВычисления;
	Если МассивДопПоказателейДляВычисления <> Неопределено Тогда
		Для Каждого ТекПоказатель Из МассивДопПоказателейДляВычисления Цикл
			Если МассивЗависимыхПоказателей.Найти(ТекПоказатель) = Неопределено Тогда
				МассивЗависимыхПоказателей.Добавить(ТекПоказатель);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
	Возврат МассивЗависимыхПоказателей;

КонецФункции

&НаСервереБезКонтекста
Процедура ПересчитатьПоказателиБезКонтекста(ОтчетОбъект,ИзмененныеКолонки, ЗависимыеПоказатели = Неопределено)

	Если ЗависимыеПоказатели = Неопределено Тогда
		ЗависимыеПоказатели = ПолучитьЗависимыеПоказателиБезКонтекста(ИзмененныеКолонки,ОтчетОбъект);
	КонецЕсли;
	
	// запустим модуль вычисления.
	ОтчетОбъект.СформироватьСтруктуруПараметров(Ложь);
	
	// инициализируем структуру "Показатели"
	ОтчетОбъект.СформироватьСтруктуруПоказателей();
	
	ОтчетОбъект.УстановитьИтогиПоПоказателям(ИзмененныеКолонки);
	
	ЗависимыеПоказатели = ?(ЗависимыеПоказатели.Количество() = 0,Неопределено,ЗависимыеПоказатели);
	
	// запускаем код заполнения
	Если НЕ ОтчетОбъект.ЗапуститьМодульВычисления(ЗависимыеПоказатели) Тогда
		Возврат;
	КонецЕсли;
	
	// переносим значения в глобальную таблицу показателей
	ОтчетОбъект.ПеренестиЗначенияИзПоказателиВмПоказатели();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПоказателейСтраницы(ОтчетОбъект)
	
	Возврат ОтчетОбъект.ПолучитьМассивПоказателейСтраницы();
	
КонецФункции

&НаСервереБезКонтекста
Процедура ВосстановитьОбъектОтчетаБезКонтекста(ОтчетОбъект,ТекОбъект,АдресОбъектаОтчет)

	Если ОтчетОбъект = Неопределено Тогда
		//Функция РеквизитФормыВЗначение вызывает запрос к базе с RLS.
		//Т.к. отчет уже открыт, повторная проверка на RLS не требуется.
		УстановитьПривилегированныйРежим(Истина);
		ОтчетОбъект 	 = ДанныеФормыВЗначение(ТекОбъект,Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет"));
		УстановитьПривилегированныйРежим(Ложь);
		СтруктураСвойств = ПолучитьИзВременногоХранилища(АдресОбъектаОтчет);
		ОтчетОбъект.ЗагрузитьВнутренниеСвойства(СтруктураСвойств);
		
		ОтчетОбъект.БланкОтчета = ОтчетОбъект.ШаблонОтчета;
		
	КонецЕсли;
	
КонецПроцедуры // ВосстановитьОбъектОтчета()

&НаСервереБезКонтекста
Процедура ПоместитьОбъектОтчетаБезКонтекста(ОтчетОбъект,АдресОбъектаОтчет)

	Если ОтчетОбъект <> Неопределено Тогда
		ПоместитьВнутренниеТаблицыВоВременноеХранилище(ОтчетОбъект,АдресОбъектаОтчет);
		ОтчетОбъект = Неопределено; // Во избежание модификации объекта после помещения в хранилище.
	КонецЕсли;

КонецПроцедуры // ПоместитьОбъектОтчета()

