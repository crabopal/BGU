&НаКлиенте
Процедура ОтменитьУдаленияРаскрытия()
	Если мУдаляемыеСтроки <> Неопределено Тогда
		мУдаляемыеСтроки = Неопределено;
	КонецЕсли;
	
	Если мСоответствиеЦветовОбластей <> Неопределено Тогда
		КоллекцияОбластей = ТабличныйДокументОтчета.Области;
		Для Каждого КлючИЗначение Из мСоответствиеЦветовОбластей Цикл
			ТекОбл = КоллекцияОбластей.Найти(КлючИЗначение.Ключ);
			Если ТекОбл <> Неопределено Тогда
				ТекОбл.ЦветФона = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		
		мСоответствиеЦветовОбластей = Неопределено
		
	КонецЕсли;
	
	Элементы.ГруппаУдалениеРаскрытия.Доступность = Ложь;	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыделениеУдаляемыхСтрок(СтруктураОбластейОтмены)
	
	КоллекцияОбластей = ТабличныйДокументОтчета.Области;
	ЦветФонаУдаляемойСтроки = Новый Цвет(178,178,178);
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИЗначение Из СтруктураОбластейОтмены Цикл
			Если СтрНачинаетсяС(ТекОбл.Имя,КлючИЗначение.Ключ) Тогда
				МассивИД = КлючИЗначение.Значение;
				МассивЧастейИмени = СтрРазделить(ТекОбл.Имя,"_",Ложь);
				Если МассивИД.Найти(МассивЧастейИмени[МассивЧастейИмени.ВГраница()])<> Неопределено Тогда
					//указываем полное имя, т.к. возможны промежуточные итоги, и цвет ячейки каждой строки может отличаться
					ИмяОбласти = ТекОбл.Имя;//Сред(ТекОбл.Имя,1,СтрДлина(ТекОбл.Имя)-(СтрДлина(ТекСтруктура.Идентификатор)+1));
					СохраненныйЦвет = мСоответствиеЦветовОбластей.Получить(ИмяОбласти);
					Если СохраненныйЦвет<> Неопределено Тогда
						ТекОбл.ЦветФона = СохраненныйЦвет;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыделениеУдаляемыхСтрокНаСервере(ТабличныйДокументОтчета,СтруктураОбластейОтмены,мСоответствиеЦветовОбластей)
	КоллекцияОбластей = ТабличныйДокументОтчета.Области;
	ЦветФонаУдаляемойСтроки = Новый Цвет(178,178,178);
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИЗначение Из СтруктураОбластейОтмены Цикл
			Если СтрНачинаетсяС(ТекОбл.Имя,КлючИЗначение.Ключ) Тогда
				МассивИД = КлючИЗначение.Значение;
				МассивЧастейИмени = СтрРазделить(ТекОбл.Имя,"_",Ложь);
				Если МассивИД.Найти(МассивЧастейИмени[МассивЧастейИмени.ВГраница()])<> Неопределено Тогда
					//указываем полное имя, т.к. возможны промежуточные итоги, и цвет ячейки каждой строки может отличаться
					ИмяОбласти = ТекОбл.Имя;
					СохраненныйЦвет = мСоответствиеЦветовОбластей.Получить(ИмяОбласти);
					Если СохраненныйЦвет<> Неопределено Тогда
						ТекОбл.ЦветФона = СохраненныйЦвет;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьУдаляемыеСтрокиРаскрытия()
	
	Если мСоответствиеЦветовОбластей = Неопределено Тогда
		СоответствиеЦветов = Новый Соответствие;
	Иначе
		СоответствиеЦветов = Новый Соответствие(мСоответствиеЦветовОбластей);
	КонецЕсли;
	
	КоллекцияОбластей = ТабличныйДокументОтчета.Области;
	ЦветФонаУдаляемойСтроки = Новый Цвет(178,178,178);
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИЗначение Из мУдаляемыеСтроки Цикл
			МассивИД = КлючИЗначение.Значение;
			Если СтрНачинаетсяС(ТекОбл.Имя,КлючИЗначение.Ключ) Тогда
				МассивЧастейИмени = СтрРазделить(ТекОбл.Имя,"_",Ложь);
				Если МассивИД.Найти(МассивЧастейИмени[МассивЧастейИмени.ВГраница()])<> Неопределено Тогда
					Если ТекОбл.ЦветФона <> ЦветФонаУдаляемойСтроки Тогда 
						//указываем полное имя, т.к. возможны промежуточные итоги, и цвет ячейки каждой строки может отличаться
						ИмяОбласти = ТекОбл.Имя;

						СоответствиеЦветов.Вставить(ИмяОбласти,ТекОбл.ЦветФона);
						
						ТекОбл.ЦветФона = ЦветФонаУдаляемойСтроки;
					КонецЕсли;
				КонецЕсли;							
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	мСоответствиеЦветовОбластей = Новый ФиксированноеСоответствие(СоответствиеЦветов);
	
КонецПроцедуры

