	Если Не АдресСтрокиРаскрытия = Неопределено Тогда
		ОбработатьРедактированиеФормы();
		
		ВходящиеПараметры = Новый Структура;
		ВходящиеПараметры.Вставить("АдресОбъектаОтчет",АдресОбъектаОтчет);
		ВходящиеПараметры.Вставить("ВыводитьРаскрытиеВТелеБланка",Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка);
		ВходящиеПараметры.Вставить("ВыводитьДлинныеПоляВОднуСтроку",ВыводитьДлинныеПоляВОднуСтроку);
		ВходящиеПараметры.Вставить("ИменаЯчеекДлинныхСтрок",ИменаЯчеекДлинныхСтрок);
		
		КоординатаАктивнойЯчейки = ДобавитьСтрокуБезКонтекста(Объект,ТабличныйДокументОтчета,ИзмененныеОбласти,ВходящиеПараметры,АдресСтрокиРаскрытия.КодСтроки,АдресСтрокиРаскрытия.ИмяИсходнойОбласти,АдресСтрокиРаскрытия.Идентификатор);

		Если КоординатаАктивнойЯчейки <> Неопределено Тогда
			Элементы.ТабличныйДокументОтчета.ТекущаяОбласть = ТабличныйДокументОтчета.Область(
						КоординатаАктивнойЯчейки.Верх,
						КоординатаАктивнойЯчейки.Лево);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

