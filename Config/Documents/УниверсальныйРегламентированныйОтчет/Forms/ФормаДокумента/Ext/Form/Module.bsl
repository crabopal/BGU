						МассивИДОтмены = Новый Массив;
						МассивИДОтмены.Добавить(ИскомыйИД);
					ИначеЕсли МассивИДОтмены.Найти(ИскомыйИД) = Неопределено Тогда
						МассивИДОтмены.Добавить(ИскомыйИД);
