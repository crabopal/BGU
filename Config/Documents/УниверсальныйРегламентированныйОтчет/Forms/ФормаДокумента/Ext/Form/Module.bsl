&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ТекДанныеЗаполнения = ТекущийОбъект.РезультатЗаполнения.Получить();
	Если ТекДанныеЗаполнения<> Неопределено Тогда
		АдресРезультатаЗаполнения = ПоместитьВоВременноеХранилище(ТекДанныеЗаполнения,УникальныйИдентификатор);
		Элементы.ФормаСравнитьСДаннымиЗаполнения.Доступность = Истина;
	КонецЕсли;
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если АктивнаЗагрузкаКомплектаБезКонтекста() Тогда
		БюджетнаяОтчетность.СообщениеПриЗагрузкеКомплекта();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() и Объект.ВидОтчета.Пустая() Тогда
		                 
		ПолныеПараметры = Новый Структура("ЗакрыватьПриВыборе,ЗакрыватьПриЗакрытииВладельца,КлючНазначенияИспользования,
			|ПараметрыФункциональныхОпций,ТолькоПросмотр,ДополнительныеПараметры,ЗначениеКопирования,ЗначенияЗаполнения,
			|Ключ,Основание,РежимВыбора,ТекстЗаполнения");
		ЗаполнитьЗначенияСвойств(ПолныеПараметры,Параметры);
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		//Во всех вариантах открытия отчета, вид отчета тут будет уже заполнен.
		//При создании отчета для расшифровки - вызывается отдельно.
		ЗаполнитьПараметрыГруппРаскрытия();
	КонецЕсли;
	
	ИзмененныеОбласти = Новый Структура;
	
	Если Не Параметры.РежимРасшифровки Тогда
		
		ОтобразитьОтчетДляРедактирования(Отказ);
		
	Иначе
		
		УстановитьРежимРедактированияФормыСервер(Ложь,Ложь);
		Элементы.ФормаВключитьРедактирование.Доступность = Ложь;
		ОтобразитьОтчетВРежимеРасшифровки(Отказ);
			
	КонецЕсли;
	
	//Элементы.ИФО.Видимость = БюджетнаяОтчетностьСервер.ИспользоватьУчетПоИФО();//Контролируется ФО
	
	РедактированиеТекстаВОтдельномОкне = Элементы.РедактированиеТекстаВОтдельномОкне.Пометка;
	ИспользоватьВыборИзКПС = Элементы.ВыборИзКПС.Пометка;
	
	// Заполнение группы информационных ссылок
	БюджетнаяОтчетностьСерверПереопределяемый.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ПересчитыватьПоказателиПриИзменении = Истина;
	Элементы.ФормаПересчитыватьПоказателиПриИзменении.Пометка = ПересчитыватьПоказателиПриИзменении;
	
	ИспользоватьОбменСоСводомОтчетов = БюджетнаяОтчетностьСервер.ИспользоватьОбменСоСводомОтчетов();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаСостоянийСвод","Видимость",ИспользоватьОбменСоСводомОтчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ИсторияОбменаСоСводомОтчетов","Видимость",ИспользоватьОбменСоСводомОтчетов);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаСоСводом,"ЭкземплярОтчета",Объект.Ссылка,Истина);
	Если ИспользоватьОбменСоСводомОтчетов Тогда
		Элементы.Состояние.Заголовок = "Состояние (БГУ)";
		Если ЗначениеЗаполнено(Объект.Ссылка) 
			И ЗначениеЗаполнено(БюджетнаяОтчетностьСервер.ПолучитьСостояниеОтчетаВСводеОтчетов(Объект.Ссылка)) Тогда
			ОсновнаяУчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьОбменаСоСводомОтчетов.Получить();
			
			Если ЗначениеЗаполнено(ОсновнаяУчетнаяЗапись) Тогда
				Попытка
					Справочники.УчетныеЗаписиОбменаСводаОтчетов.ОбновитьСостоянияОтчетов(ОсновнаяУчетнаяЗапись,Объект.Ссылка);
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не удалось обновить состояние отчета в Своде отчетов.'"));
				КонецПопытки;
			КонецЕсли;
			
			СостояниеСвод = БюджетнаяОтчетностьСервер.ПолучитьСостояниеОтчетаВСводеОтчетов(Объект.Ссылка);
			Если СостояниеСвод = Перечисления.СостоянияОтчетов.Утвержден
				ИЛИ СостояниеСвод = Перечисления.СостоянияОтчетов.УтвержденСОшибкой
				ИЛИ СостояниеСвод = Перечисления.СостоянияОтчетов.ПоказателиОтсутствуют Тогда
				//показатели отсутствуют - аналог утверждения без показателей
				ЗапрещеноРедактированиеОтчета = Истина;
				Элементы.ФормаВключитьРедактирование.Доступность = НЕ ЗапрещеноРедактированиеОтчета;
				УстановитьРежимРедактированияФормыСервер(Ложь,Ложь);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Текущий отчет уже утвержден в Своде отчетов.
					|Редактирование отчета запрещено.'"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//ВидимостьОтборов = Истина;//Первоначальная настройка
	Элементы.ФормаИзменитьВидимостьОтборов.Пометка = ?(Объект.Ссылка.Пустая(),Ложь,ВидимостьОтборов);
	Элементы.ГруппаОтборы.Видимость = ?(Объект.Ссылка.Пустая(),Ложь,ВидимостьОтборов);
	
	Элементы.ПараметрыОтчетаЗаполнитьПараметрыЦБ.Видимость = ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьЦентрализованнуюБухгалтерию");
	
	ЗаполнитьКартинкиСпискаСостояний();
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ВсегоЭлементов = Элементы.РазделыМакета.ПодчиненныеЭлементы.Количество();
		Для Сч = 0 По ВсегоЭлементов-1 Цикл
			ЭлементПоиска = Элементы["ГР_Поиск_СтраницыРаздел"+Сч];
			ЭлементПоиска.Видимость = Элементы.ФормаИзменитьВидимостьОтборов.Пометка;
		КонецЦикла; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		ИнициализацияНастроекБланка();
	КонецЕсли;
	
	ОбновитьПараметрыСвязанныхОтчетов();
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(ДанныеДляОтображенияРасшифровки) = Тип("Структура") Тогда
		// Открывается отчет в режиме расшифровки.
		// Потребуется открыть дополнительные формы.
		Если Объект.Ссылка.Пустая() Тогда
			Отказ = Истина; // Расшифровка не может быть выполнена, отчет не единственный.
		КонецЕсли;
		
		Для Каждого КлючОткрытияФормы Из ДанныеДляОтображенияРасшифровки Цикл
			
			ПараметрыФормы = КлючОткрытияФормы.Значение;
			ПараметрыФормы.Вставить("ТолькоПросмотр",Истина);
			
			ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма." + КлючОткрытияФормы.Ключ,ПараметрыФормы,?(Отказ,Неопределено,ЭтаФорма));
			
		КонецЦикла;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
		
		Если Элементы.РазделыМакета.ПодчиненныеЭлементы.Количество() Тогда
			Элементы.РазделыМакета.ТекущаяСтраница = Элементы.РазделыМакета.ПодчиненныеЭлементы[0];
		КонецЕсли;
		
	КонецЕсли;
	
	// Обработка открытия нового отчета.
	Если Объект.Ссылка.Пустая() Тогда
		
		Модифицированность = Истина;
		
		Если Не ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
			
			Отказ = Истина;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ВидыОтчетов.ФормаВыбора"); 
			ДополнительныеПараметры.Вставить("ПараметрыФормы",Неопределено);
			ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма.ВладелецФормы);
			ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
			
			СтруктураДляОбработкиРезультата = Новый Структура;
		
			СтруктураДляОбработкиРезультата.Вставить("Источник","ПриОткрытии");
			СтруктураДляОбработкиРезультата.Вставить("ПараметрыОтчета",ПолныеПараметры);
			
			ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураДляОбработкиРезультата)); 
			
			БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);

			Возврат;
					
		КонецЕсли;	
	КонецЕсли;
	
	мИзмененаРазрядность 	= Ложь;
	мНачальнаяДатаДокумента = Объект.Дата;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОтменитьУдаленияРаскрытия();
	
	// Проверка заполненности обязательных реквизитов
	Для Каждого СтрРеквизит Из ТаблицаДополнительныхРеквизитов Цикл
		Если СтрРеквизит.Обязательный и Не ЗначениеЗаполнено(СтрРеквизит.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не указано значение обязательного реквизита «%1»'"),
				СтрРеквизит.Наименование),
				,
				"ТаблицаДополнительныхРеквизитов[" + ТаблицаДополнительныхРеквизитов.Индекс(СтрРеквизит) + "].Значение");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если АктивнаЗагрузкаКомплекта(ЭтотОбъект) Тогда
		ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.ПоказателиОтсутствуют") Тогда
		Если НЕ ПараметрыЗаписи.Свойство("ПроверкаПоказателиОтсутствуютВыполнена") Тогда			
			Если ПроверитьНеобходимостьОчистки() Тогда
				Отказ = Истина;		
				ПоказатьВопрос(Новый ОписаниеОповещения("ПроверкаПоказателиОтсутствуютЗавершение",ЭтотОбъект,ПараметрыЗаписи),Нстр("ru='Для установки статуса ""Показатели отсутствуют"" отчет будет очищен. Продолжить?'"),РежимДиалогаВопрос.ОКОтмена);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// В процессе записи объект может выдать сообщения об ошибках,
	// которые должны препятствовать интерактивной записи объекта.
	//
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ОбнаруженыОшибкиПриЗаписи")
		 И ТекущийОбъект.ДополнительныеСвойства.ОбнаруженыОшибкиПриЗаписи = Истина Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СинхронизироватьКонтекстСервер(Ложь);
	
	Если НеобходимаСверткаПоАналитикеПередЗаписью() Тогда
		Отказ = Истина;
		ПоместитьОбъектОтчета();
		Возврат;
	КонецЕсли;
	
	Если ОтчетОбъект.ВнутренниеДанныеРасчетаИзменены() = Истина И ЭтоАдресВременногоХранилища(АдресДанныеРасчета) Тогда
		ОтчетОбъект.ВосстановитьДанныеРасчетовИзХранилища(АдресДанныеРасчета);
	КонецЕсли;
	
	ОтчетОбъект.СинхронизироватьВнутренниеДанныеОбъектов(ТекущийОбъект);
	
	Если ОтчетОбъект.Состояние = Перечисления.СостоянияОтчетов.Подготовлен ИЛИ ОтчетОбъект.Состояние = Перечисления.СостоянияОтчетов.Утвержден Тогда
		РезультатПроверки = ОтчетОбъект.ПолучитьРезультатПроверки();
		Если РезультатПроверки.БезОшибок = Ложь Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.КлючДанных  = Объект.Ссылка;
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Поле  = "Состояние";
			Сообщение.Текст = "Проверка КС не пройдена! Отчет не может быть переведен в состояние """ + Строка(ОтчетОбъект.Состояние) + """";
			Сообщение.Сообщить();
			
			Отказ = Истина;
			Возврат;
		ИначеЕсли РезультатПроверки.БезПредупреждений = Ложь Тогда
			ТекстСообщения = НСтр("ru='Проверка КС пройдена, но есть предупреждения!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,Объект.Ссылка,,"Объект");	
		КонецЕсли;
	КонецЕсли;
	
	ТекущийОбъект.СформироватьСтруктуруПараметров();
	ТекущийОбъект.СформироватьСтруктуруДополнительныхРеквизитов();
	ТекущийОбъект.ИзмененияВДиалоге = Модифицированность;
	//
	ТекДанныеЗаполнения = Неопределено;
	Если ЭтоАдресВременногоХранилища(АдресРезультатаЗаполнения) Тогда
		ТекДанныеЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультатаЗаполнения);
	КонецЕсли;
	Если ТекДанныеЗаполнения = Неопределено Тогда
		ТекущийОбъект.ДатаЗаполнения = Неопределено;
	КонецЕсли;
	ТекущийОбъект.РезультатЗаполнения = Новый ХранилищеЗначения(ТекДанныеЗаполнения,Новый СжатиеДанных(9));
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаписанноеСостояниеОтчета = ТекущийОбъект.Состояние;
	ОтчетОбъект 			  = ТекущийОбъект;
	
	УстановитьЗаголовокФормы();
	ПоместитьОбъектОтчета();
	ОтменитьВозможностьОткатаСвертки();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	ОбновитьПараметрыСвязанныхОтчетов();
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаСоСводом,"ЭкземплярОтчета",Объект.Ссылка,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_УниверсальныйРегламентированныйОтчет", ПараметрыЗаписи, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
	Если ИсточникВыбора.ИмяФормы = "Документ.УниверсальныйРегламентированныйОтчет.Форма.РедактированиеРаскрытия" Тогда
		
		ОтобразитьИзмененияТаблицыРаскрытия(ВыбранноеЗначение);
		Модифицированность = Истина;
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекущаяВидимостьОтборов = Ложь;
	Иначе
		Если Элементы.ГруппаПанельОтборов.Видимость Тогда
			//Отборы в принципе есть в отчете
			ТекущаяВидимостьОтборов = ВидимостьОтборов И НЕ Параметры.РежимРасшифровки;
		Иначе
			ТекущаяВидимостьОтборов = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.РежимРасшифровки Тогда
		ВыводитьДлинныеПоляВОднуСтроку = Истина;
	КонецЕсли;	
	
	Элементы.ФормаПересчитыватьПоказателиПриИзменении.Пометка = ПересчитыватьПоказателиПриИзменении;
	Элементы.ФормаИзменитьВидимостьОтборов.Пометка = ТекущаяВидимостьОтборов;
	Элементы.ГруппаОтборы.Видимость = ТекущаяВидимостьОтборов;
	Элементы.РедактированиеТекстаВОтдельномОкне.Пометка = РедактированиеТекстаВОтдельномОкне;
	
	Если ТекущаяВидимостьОтборов Тогда
		Элементы.ДеревоСтраниц.Ширина = 30;
	Иначе
		Элементы.ДеревоСтраниц.Ширина = 15;
	КонецЕсли;
	
	Элементы.ФормаВыводитьДлинныеПоляВОднуСтроку.Пометка = ВыводитьДлинныеПоляВОднуСтроку;
	
	Если ОтображатьВВидеТаблицыФормы Тогда
		ВсегоЭлементов = Элементы.РазделыМакета.ПодчиненныеЭлементы.Количество();
		Для Сч = 0 По ВсегоЭлементов-1 Цикл
			ЭлементПоиска = Элементы["ГР_Поиск_СтраницыРаздел"+Сч];
			ЭлементПоиска.Видимость = ТекущаяВидимостьОтборов;
		КонецЦикла;
	Иначе
		ПрименитьНастройкуВыводаДлинныхСтрок(ТабличныйДокументОтчета,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку);
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы


&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	мИзмененаРазрядность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УровеньТочностиПриИзменении(Элемент)
	мИзмененаРазрядность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ИзмененныеОбласти.Вставить("Организация",Объект.Организация);
	ОбновитьФиксированныеПараметрыОрганизацииНаКлиенте();
	ПредложитьОбновитьНастройкиИзРедакции(Неопределено,Новый Структура("Этап","Начало"));
	СинхронизироватьКонтекстНовыйВариант();
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	ИзмененныеОбласти.Вставить("ПериодОтчета",Объект.ПериодОтчета);
	ПредложитьОбновитьНастройкиИзРедакции(Неопределено,Новый Структура("Этап","Начало"));
	СинхронизироватьКонтекстНовыйВариант();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ИзмененныеОбласти.Вставить("Дата",Объект.Дата);
	
	Если ПриИзмененииДатыИзмениласьНумерация(мНачальнаяДатаДокумента, Объект.Дата) Тогда
		Объект.Номер = "";
	КонецЕсли;
	
	мНачальнаяДатаДокумента = Объект.Дата;
	
	ОбновитьФиксированныеПараметрыОрганизацииНаКлиенте();
	
	СинхронизироватьКонтекстНовыйВариант();
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОтчетаПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	Модифицированность = Истина;
	
	ИмяОбласти = Область.Имя;
	Если Найти(ИмяОбласти,"_") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Область.СодержитЗначение Тогда
		ЗначениеОбласти = Область.Значение;
		Если ТипЗнч(ЗначениеОбласти) = Тип("Строка") Тогда
			//Заменим отображаемый символ перевода строки на реальный символ перевода строки
			ЗначениеОбласти = СтрЗаменить(ЗначениеОбласти,Символ(182),Символы.ПС);
			Область.Значение = ЗначениеОбласти;
		КонецЕсли;
		ИзмененныеОбласти.Вставить(ИмяОбласти,ЗначениеОбласти);
	Иначе
		ИзмененныеОбласти.Вставить(ИмяОбласти,Область.Текст);
	КонецЕсли;
	
	ОбработатьРедактированиеФормы();
	
	Если ПересчитыватьПоказателиПриИзменении Тогда
		Если АктивнаЗагрузкаКомплекта(ЭтотОбъект) Тогда
			ПодключитьОбработчикОжиданияЗагрузкаКомплекта();
			Возврат;//иначе может возникнуть конфликт блокировок
		КонецЕсли;
		СинхронизироватьКонтекстНовыйВариант();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОтчетаПриАктивизации(Элемент)
	АвтоСумма = Формат(ПолучитьАвтосуммуПоказателей(ТабличныйДокументОтчета),"ЧДЦ="+Объект.УровеньТочности);
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОтчетаВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента")
		 или Область.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Лев(Область.Имя,15) = "РасчетныеИтоги_" Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	ИменованаяОбласть = ТабличныйДокументОтчета.Области.Найти(Область.Имя) <> Неопределено;
	Если Не ИменованаяОбласть Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(Область.Расшифровка)= Тип("Булево") И Область.Расшифровка = Ложь Тогда //Это пустая область
		ДобавитьСтрокуРаскрытия(Неопределено);
		Возврат;
	КонецЕсли;  
	
	ОбработатьРедактированиеФормы();
	
	// Область имеет расшифровку, значит она может выбираться из справочника.
	ИмяОбласти = Область.Имя;
	НаименованиеПараметра = "";
	
	РеквизитыИмениОбласти = БюджетнаяОтчетностьКлиентСервер.РазобратьИмяОбласти(ИмяОбласти);
	
	ПараметрыОбласти = ПолучитьПараметрыОбласти(РеквизитыИмениОбласти.ИмяИсходнойОбласти);
	Если ПараметрыОбласти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбласти = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыОбласти);
	
	Если ПараметрыОбласти.ВидОбласти = 0 
		ИЛИ ПараметрыОбласти.ВидОбласти = 5 Тогда  // показатель отчета,показатель раскрытия
		
		Если ЗначениеЗаполнено(ПараметрыОбласти.НастройкиЯчейки) 
			И (ПараметрыОбласти.НастройкиЯчейки.ЕстьСвязанныеРеквизиты
				ИЛИ ПараметрыОбласти.НастройкиЯчейки.ЕстьВыборЗначенийИзСписка) Тогда
			
			//продолжаем работу процедуры полностью, т.к. теперь ячейки с ВидОбласти = 5 (показатели раскрытия)
			//могут быть со связанными реквизитами
		Иначе
				
			Если (Область.СодержитЗначение 
					И Область.ТипЗначения.СодержитТип(Тип("Строка"))) 
				ИЛИ Область.СодержитЗначение = Ложь  Тогда //это строка
				
				Если РедактированиеТекстаВОтдельномОкне = Ложь Тогда
					СтандартнаяОбработка = Истина;
					Возврат;
				КонецЕсли;
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеРасширенногоРедактированияЯчейкиБланка",ЭтотОбъект);
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ТекущееЗначение", ?(Область.СодержитЗначение, Область.Значение, Область.Текст)); 
				ПараметрыФормы.Вставить("ТекущееИмя", ИмяОбласти);
				ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения);
				
				СтандартнаяОбработка = Ложь;
				Возврат;
				
			ИначеЕсли Область.СодержитЗначение 
				И ТипЗнч(Область.Значение) = Тип("Булево") Тогда
				
				//сразу изменим булевое значение, без отображения списка
				
				Область.Значение = НЕ Область.Значение;
				
				ЭтотОбъект.Модифицированность = Истина;
				
				ТабличныйДокументОтчетаПриИзмененииСодержимогоОбласти(Элемент,Область);
				
				СтандартнаяОбработка = Ложь;
				Возврат;
	
			КонецЕсли;
			
			СтандартнаяОбработка = Истина;
			Возврат;
			
		КонецЕсли;
		
	ИначеЕсли ПараметрыОбласти.ВидОбласти = 1 Тогда  //реквизит отчета
		ТекущееЗначение = Объект[РеквизитыИмениОбласти.ИмяИсходнойОбласти];
	ИначеЕсли ПараметрыОбласти.ВидОбласти = 2 Тогда //параметр отчета 
		СтрокиПараметров = Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код", РеквизитыИмениОбласти.ИмяИсходнойОбласти));
		Если СтрокиПараметров.Количество() Тогда
			ТекущееЗначение = СтрокиПараметров[0].Значение;
			НаименованиеПараметра = СтрокиПараметров[0].Наименование;
		Иначе
			Возврат;
		КонецЕсли;
	ИначеЕсли ПараметрыОбласти.ВидОбласти = 3 
		ИЛИ ПараметрыОбласти.ВидОбласти = 4 Тогда	//доп реквезит,аналитика раскрытия
		ТекущееЗначение = Область.Расшифровка;
	Иначе 
		ВызватьИсключение НСтр("ru = 'Неизвестный тип области.'"); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбласти.НастройкиЯчейки) 
		И ПараметрыОбласти.НастройкиЯчейки.ЕстьСвязанныеРеквизиты Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресДокументаОбъект"	, АдресОбъектаОтчет);
		ПараметрыФормы.Вставить("ИмяОбласти"			, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
		ПараметрыФормы.Вставить("ИдентификаторОбласти"	, РеквизитыИмениОбласти.Идентификатор);
		ПараметрыФормы.Вставить("ВидОтчета"				, Объект.ВидОтчета);
		ПараметрыФормы.Вставить("АдресПараметрыОтборПоКоду", АдресПараметрыОтборПоКоду);
		ПараметрыФормы.Вставить("УровеньТочности"	, Объект.УровеньТочности);
		ПараметрыФормы.Вставить("Ссылка"	, Объект.Ссылка);
		ПараметрыФормы.Вставить("Организация"	, Объект.Организация);
		ПараметрыФормы.Вставить("ДатаДокумента"	, Объект.Дата);
		ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
		
		Если ПараметрыОбласти.ГруппаРаскрытия <> Неопределено Тогда
			ПараметрыФормы.Вставить("ГруппаРаскрытия",ПараметрыОбласти.ГруппаРаскрытия);
		КонецЕсли;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСоставныхРеквизитовБланка",ЭтотОбъект,РеквизитыИмениОбласти);
		
		ТекКлючСохраненияРазмераОкна = Строка(Объект.ВидОтчета.УникальныйИдентификатор())+"/" +РеквизитыИмениОбласти.ИмяИсходнойОбласти;
		
		ПараметрыФормы.Вставить("КлючСохраненияПоложенияОкна",ТекКлючСохраненияРазмераОкна);
		
		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСоставныхРеквизитов",
			ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	ИначеЕсли ЗначениеЗаполнено(ПараметрыОбласти.НастройкиЯчейки) 
		И ПараметрыОбласти.НастройкиЯчейки.ЕстьВыборЗначенийИзСписка
		И ПараметрыОбласти.НастройкиЯчейки.Свойство("МассивСтруктурДляВыбора") Тогда		
		
		ДоступноРедактированиеЗначений = Ложь;
		
		СписокДляВыбора = Новый СписокЗначений;
		Для Каждого ЭлМас Из ПараметрыОбласти.НастройкиЯчейки.МассивСтруктурДляВыбора Цикл
			ПредставлениеЭлемента = "<...>";
			Если ЗначениеЗаполнено(ЭлМас.Представление) Тогда
				ПредставлениеЭлемента = ЭлМас.Представление;
			ИначеЕсли ЗначениеЗаполнено(ЭлМас.Значение) Тогда
				ПредставлениеЭлемента = ЭлМас.Значение;
			КонецЕсли;
			ТекКартинка = Неопределено;
			Если ЭлМас.ДоступноРедактирование = Истина Тогда
				ТекКартинка = БиблиотекаКартинок.Изменить;
				ДоступноРедактированиеЗначений = Истина;
			КонецЕсли;
			СписокДляВыбора.Добавить(ЭлМас, ПредставлениеЭлемента,,ТекКартинка);
		КонецЦикла;
		
		Если ТипЗнч(Область.Значение) = Тип("Строка") И ДоступноРедактированиеЗначений Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеРасширенногоРедактированияЯчейкиБланка",ЭтотОбъект);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекущееИмя", Область.Имя);
			ПараметрыФормы.Вставить("ПредопределенныеЗначения", СписокДляВыбора);
			ПараметрыФормы.Вставить("ТекущееЗначение", Область.Значение);
			
			ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения);
		Иначе
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
			ДополнительныеПараметры.Вставить("Область",Область);
			ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
			ПоказатьВыборИзМеню(ОписаниеОповещения,СписокДляВыбора,Элемент);
		КонецЕсли;
		
	ИначеЕсли ИспользоватьВыборИзКПС 
		И ЗначениеЗаполнено(ПараметрыОбласти.НастройкиЯчейки) 
		И ПараметрыОбласти.НастройкиЯчейки.ЕстьВыборИзКПС
		И ПараметрыОбласти.ВидКлассификатораБК <> ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГлавыПоБюджетнойКлассификации") Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВидОтчета"					, Объект.ВидОтчета);
		ПараметрыФормы.Вставить("ГруппаРаскрытия"			, ПараметрыОбласти.ГруппаРаскрытия);
		ПараметрыФормы.Вставить("ИмяОбласти"				, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
		ПараметрыФормы.Вставить("ТекущаяСтрока"				, ТекущееЗначение);
		ПараметрыФормы.Вставить("ИдентификаторОбласти"		, РеквизитыИмениОбласти.Идентификатор);
		ПараметрыФормы.Вставить("АдресПараметрыВыборИзКПС"	, АдресПараметрыВыборИзКПС);
		ПараметрыФормы.Вставить("АдресДокументаОбъект"		, АдресОбъектаОтчет);
		 				
		Если ЗначениеЗаполнено(Объект.ПериодОтчета) Тогда
			ДатаОтбораКПС = КонецДня(ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
		Иначе
			ДатаОтбораКПС = ТекущаяДата();
		КонецЕсли;
		
		ДопОтборФормы = Новый Структура;
		ДопОтборФормы.Вставить("НаДату", ДатаОтбораКПС);
		
		ОграниченияУчетнойПолитики = Новый Структура;
		ОграниченияУчетнойПолитики.Вставить("НаДату", ДатаОтбораКПС);
		ОграниченияУчетнойПолитики.Вставить("Организация", Объект.Организация);
		ОграниченияУчетнойПолитики.Вставить("ИФО", Объект.ИФО);
		
		ДопОтборФормы.Вставить("ОграниченияУчетнойПолитики", ОграниченияУчетнойПолитики);
		ПараметрыФормы.Вставить("ДополнительныйОтбор", ДопОтборФормы);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ГруппаРаскрытия",ПараметрыОбласти.ГруппаРаскрытия);
		ДополнительныеПараметры.Вставить("ВидАналитики",ПараметрыОбласти.ВидАналитики);
		ДополнительныеПараметры.Вставить("Идентификатор",РеквизитыИмениОбласти.Идентификатор);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораРеквизитовИзКПС",ЭтотОбъект,ДополнительныеПараметры);
		
		ИмяФормыВыбора = "Справочник.КлассификационныеПризнакиСчетов.Форма.ВыборКПСИзОтчета";
		ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ПараметрыОбласти.СценарийВвода <> Неопределено Тогда
		
		ВидАналитики = ПараметрыОбласти.ВидАналитики;
		
		ГруппаРаскрытия = ПараметрыОбласти.ГруппаРаскрытия;
		ИдентификаторСтроки = РеквизитыИмениОбласти.Идентификатор;
		
		ОткрытьФормуВыбораПоСценарию(РеквизитыИмениОбласти.ИмяИсходнойОбласти, ПараметрыОбласти, ТекущееЗначение, Область, ГруппаРаскрытия, ИдентификаторСтроки, СтандартнаяОбработка);
		
	ИначеЕсли ПараметрыОбласти.ИмяТипа = "Справочник.КОСГУ_ВидыРасходовКРБ" Тогда
			
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущееЗначение);
		
		ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
		ДополнительныеПараметры.Вставить("Область",Область);
		ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
		
		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаВыбораРеквизитовКОСГУ_КРБ", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ПараметрыОбласти.ИмяТипа = "Перечисление.КВД" Тогда
			
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущаяСтрока",ТекущееЗначение);
		
		ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
		ДополнительныеПараметры.Вставить("Область",Область);
		ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);	
	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
	
		ОткрытьФорму("ОбщаяФорма.ВыборКФО", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
 		
	Иначе
		
		ИмяТипа = ПараметрыОбласти.ИмяТипа; 
		ВидАналитики = ПараметрыОбласти.ВидАналитики;
		
		Если ТекущееЗначение = Неопределено Тогда
			ПоказатьПредупреждение(,
				НСтр("ru = 'Невозможно выбрать значение для неопределенного типа. 
					|Не установлен тип по умолчанию для данного реквизита.'"));
			Возврат;
		КонецЕсли;
		
		ЗначенияПараметровПоДатам = Новый Соответствие;
		Если ПараметрыОбласти.ВидОбласти = 2 Тогда
			ВычисляемыеПараметры = ПолучитьВычисляемыеПараметры(Объект.ВидОтчета,Объект.Ссылка);
			ЗначенияПараметровПоДатам = ПолучитьСохраненныеЗначенияПараметра(Объект.ВидОтчета,Объект.Ссылка,Объект.Организация,ИмяОбласти);
			
			Если ВычисляемыеПараметры.Свойство(ИмяОбласти) Тогда
					
				МенюВыбора = Новый СписокЗначений;
				МенюВыбора.Добавить(1,Нстр("ru='Изменить значение'"));
				МенюВыбора.Добавить(2,Нстр("ru='Вычислить по формуле'"));
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
				ДополнительныеПараметры.Вставить("Область",Область);
				ДополнительныеПараметры.Вставить("ТекущееЗначение",ТекущееЗначение);
				ДополнительныеПараметры.Вставить("ЗначенияПараметровПоДатам", ЗначенияПараметровПоДатам);
				ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
				Если ПараметрыОбласти.НастройкиЯчейки <> Неопределено Тогда
					Если ПараметрыОбласти.НастройкиЯчейки.ЕстьСписокДоступныхЗначений = Истина Тогда
						ДополнительныеПараметры.Вставить("ДоступныеЗначения", ПараметрыОбласти.ДоступныеЗначения);
					КонецЕсли;
				КонецЕсли;
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСпособаЗаполненияСвойства",ЭтотОбъект,ДополнительныеПараметры);
				ПоказатьВыборИзМеню(ОписаниеОповещения,МенюВыбора,Элементы.ТабличныйДокументОтчета);
				
				Возврат;
				
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
			ДополнительныеПараметры.Вставить("Область",Область);
		    ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
			
			//Проверяем, есть ли сохраненное значение для этого параметра:
			Если ПараметрыОбласти.ВидОбласти = 2 Тогда
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
				ПараметрыФормы.Вставить("ЗначенияПараметровПоДатам", ЗначенияПараметровПоДатам);
				ПараметрыФормы.Вставить("ТекущееЗначение", ТекущееЗначение);
				ПараметрыФормы.Вставить("НаименованиеПараметра", НаименованиеПараметра);
				Если ПараметрыОбласти.НастройкиЯчейки <> Неопределено Тогда
					Если ПараметрыОбласти.НастройкиЯчейки.ЕстьСписокДоступныхЗначений = Истина Тогда
						ПараметрыФормы.Вставить("ДоступныеЗначения", ПараметрыОбласти.ДоступныеЗначения);
					КонецЕсли;
				КонецЕсли;
				ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСохраненныхПараметров", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе	
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
				ПоказатьВводЗначения(ОписаниеОповещения,ТекущееЗначение,Нстр("ru='Введите значение реквизита'"));
			КонецЕсли;	
			
		Иначе 
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекущаяСтрока",ТекущееЗначение);
			ПараметрыФормы.Вставить("НаДату", ПолучитьДатуОкончанияПериода(Объект.ПериодОтчета));
			
			ТекТип = ТипЗнч(ТекущееЗначение);
			Если ТекТип = Тип("СправочникСсылка.Субконто") 
				И ВидАналитики <> Неопределено  Тогда
								
				ПараметрыОтбораСубконто = Новый Структура;
				ПараметрыОтбораСубконто.Вставить("Владелец",ВидАналитики);
				ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
				
				ПараметрыФормы.Вставить("Отбор",ПараметрыОтбораСубконто);
				
			ИначеЕсли ТекТип = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				
				ПараметрыОтбораСубконто = Новый Структура;
				ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
				Если ПараметрыОтбораСубконто.Свойство("Код") Тогда
					ПараметрыФормы.Вставить("ОтборПоПараметруБланка",ПараметрыОтбораСубконто.Код);
				КонецЕсли;	
				
			ИначеЕсли ПараметрыОбласти.ИмяТипа = "Справочник.ЛицевыеСчета" Тогда
				
				Если ЗначениеЗаполнено(Объект.Организация) Тогда
					ПараметрыФормы.Вставить("Отбор",Новый Структура("Владелец",Объект.Организация));
				КонецЕсли;
				
			ИначеЕсли ТекТип = Тип("СправочникСсылка.КОСГУ")
				ИЛИ (ТекТип = Тип("Строка") 
					И ПараметрыОбласти.ИмяТипа = "Справочник.КОСГУ") Тогда
				
				ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, РеквизитыИмениОбласти.ИмяИсходнойОбласти);
				
				ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",Истина);
				
			ИначеЕсли ТекТип = Тип("СправочникСсылка.Контрагенты") Тогда
				
				ПараметрыФормы.Вставить("ОтборПоВидуКонтрагента",ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо"));
				
			ИначеЕсли ИмяТипа = "Справочник.СтраныМира" Тогда	
				ПараметрыФормы.Вставить("РежимВыбора", Истина);	
			КонецЕсли;


			ИмяФормыВыбора = ИмяТипа+".ФормаВыбора";
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ВидОбласти",ПараметрыОбласти.ВидОбласти);
			ДополнительныеПараметры.Вставить("Область",Область);
		    ДополнительныеПараметры.Вставить("ВидКлассификатораБК",ПараметрыОбласти.ВидКлассификатораБК);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбычногоЗначения",ЭтотОбъект,ДополнительныеПараметры);
		
			ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыОтбораПоКоду(ПараметрыФормы, ИмяИсходнойОбласти)
	
	ПараметрыОтбораСубконто = Новый Структура;
	ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, ИмяИсходнойОбласти);
	Если ПараметрыОтбораСубконто.Свойство("Код") Тогда
		
		ПараметрыОтбораСубконто = Новый Структура;
		ЗаполнитьПараметрыОтбораПоФильтру(ПараметрыОтбораСубконто, ИмяИсходнойОбласти);
		
		ПараметрыФормы.Вставить("Отбор",ПараметрыОтбораСубконто);
		ПараметрыФормы.Вставить("ОтборПоПараметруБланка",Истина);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонОтчетаПриИзменении(Элемент)
	мСоответствиеПоиска = Неопределено;
	СинхронизироватьИВывестиБланк(Элементы.ФормаВывестиРаскрытиеВТелеОтчета.Пометка,Истина);
	СоответствиеВидовОбластей = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ОсновнойПечатныйБланкПриИзменении(Элемент)
	ОбновитьКнопкиПечати();
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

