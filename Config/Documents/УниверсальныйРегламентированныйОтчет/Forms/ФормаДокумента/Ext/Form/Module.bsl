// ПРОЦЕДУРЫ ДЛЯ ФОНОВОГО ЗАПОЛНЕНИЯ ОТЧЕТА
//

&НаКлиенте
Процедура Подключаемый_ОбработатьРезультатВыполненияКоманды() Экспорт
	
	Если НЕ ЗаданиеВыполнено Тогда
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	Иначе
		
		//Обработка при успешном завершении задания без ожидания.
		РезультатВыполненияКоманды = ОбработатьДанныеЗаполненияНаСервере();
		
		
		
		ВывестиСообщенияОЗаполненииПользователю(РезультатВыполненияКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			
			//Обработка при успешном завершении задания:
			РезультатВыполненияКоманды = ОбработатьДанныеЗаполненияНаСервере();
						
			ВывестиСообщенияОЗаполненииПользователю(РезультатВыполненияКоманды);
				
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_ПроверитьВыполнениеЗадания", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ПоказатьПредупреждение(, НСтр("ru='Заполнение отчета было прервано'"), 30, НСтр("ru='Состояние заполнения отчета'"));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщенияОЗаполненииПользователю(Знач РезультатВыполненияКоманды)
	
	// Выводим сообщения об ошибках, сформированные при выполнении фонового задания,
	// но не записанные в ТекстСообщения и СтруктураОповещения.
	Если Не РезультатВыполненияКоманды.СообщенияФоновогоЗадания = Неопределено Тогда
		Для Каждого СообщениеИзЗадания Из РезультатВыполненияКоманды.СообщенияФоновогоЗадания Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеИзЗадания.Текст);
		КонецЦикла;
	КонецЕсли;
		
	ТекстСообщения = РезультатВыполненияКоманды.ТекстСообщения;
	СтруктураОповещения = РезультатВыполненияКоманды.СтруктураОповещения;
	ИмяМетода = РезультатВыполненияКоманды.ИмяМетода;
	
	Если РезультатВыполненияКоманды.КомандаВыполнена Тогда
			
		Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
		Если ТипЗнч(СтруктураОповещения) = Тип("Структура") Тогда
			
			Текст = "";
			Значение = Неопределено;
			Если СтруктураОповещения.Свойство("Текст", Значение) Тогда
				Текст = Значение;
			КонецЕсли;
			
			НавигационнаяСсылкаСообщения = Неопределено;
			
			НавигационнаяСсылкаСообщения = ПолучитьНавигационнуюСсылку(ЭтаФорма.Объект.Ссылка);
			
			Значение = Неопределено;
			Если СтруктураОповещения.Свойство("НавигационнаяСсылкаСообщения", Значение) Тогда
				
				Если ТипЗнч(Значение) = Тип("Строка") Тогда
					
					НавигационнаяСсылкаСообщения = Значение;
					
				ИначеЕсли Значение <> Неопределено Тогда
					
					НавигационнаяСсылкаСообщения = ПолучитьНавигационнуюСсылку(Значение);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Пояснение = "";
			Значение = Неопределено;
			Если СтруктураОповещения.Свойство("Пояснение", Значение) Тогда
				Пояснение = Значение;
			КонецЕсли;
			
			Картинка = Неопределено;
			Значение = Неопределено;
			Если СтруктураОповещения.Свойство("Картинка", Значение) И ТипЗнч(Картинка) = Тип("Картинка") Тогда
				Картинка = Значение;
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(Текст) Тогда
				
				ПоказатьОповещениеПользователя(Текст, НавигационнаяСсылкаСообщения, Пояснение, Картинка);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ТекстСообщенияПользователю = НСтр("ru = 'В процессе выполнения команды ""%1"" произошли ошибки: %2'");
		
		ТекстСообщенияПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияПользователю, ИмяМетода, ТекстСообщения);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьДанныеЗаполненияНаСервере()
	
	ДанныеЗаполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
		
	КомандаВыполнена = ОбработатьОтчетОбъектПослеФоновогоЗаполнения();
	
	СообщенияФоновогоЗадания = Неопределено;
	ФоновоеЗаданияЗаполнение = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если НЕ ФоновоеЗаданияЗаполнение = Неопределено Тогда
		СообщенияФоновогоЗадания = ФоновоеЗаданияЗаполнение.ПолучитьСообщенияПользователю();
	КонецЕсли;
	
	Если КомандаВыполнена Тогда
		ЭтаФорма.Модифицированность = Истина;
		АдресТекущейСтраницы = "";
		ИдСтроки = Элементы.ДеревоСтраниц.ТекущаяСтрока;
		ВывестиДанныеОтчета(Неопределено,ИдСтроки);				
	КонецЕсли;
		
	РезультатВыполненияКоманды = Новый Структура;
	РезультатВыполненияКоманды.Вставить("КомандаВыполнена", КомандаВыполнена);
	РезультатВыполненияКоманды.Вставить("ТекстСообщения", ДанныеЗаполнения.ТекстСообщения);
	РезультатВыполненияКоманды.Вставить("СтруктураОповещения", ДанныеЗаполнения.СтруктураОповещения);
	РезультатВыполненияКоманды.Вставить("ИмяМетода", ДанныеЗаполнения.ИмяМетода);
	РезультатВыполненияКоманды.Вставить("СообщенияФоновогоЗадания", СообщенияФоновогоЗадания);
	
	Возврат РезультатВыполненияКоманды;
	
КонецФункции

&НаКлиенте
Процедура СохранитьДанныеБланковДоВыполненияКоманды() Экспорт
	//Если выполняется расчет группировочных итогов, то следует проверить:
	//если до расчета итогов данные отчета соответствовали данным автозаполнения, 
	//то сохранить результат расчета итогов как результат автозаполнения.
	//Это позволит сверять данные 127 и 128 форм, если в них позднее был выполнен расчет группировочных итогов.
	//На данном этапе, если есть результат автозаполнения, 
	//то сохраняются данные ДО выполнения расчета итогов, чтобы позднее сравнить с данными автозаполнения.
	АдресСтруктурыБланковДоВыполненияКоманды = "";
	Если ЭтоАдресВременногоХранилища(АдресРезультатаЗаполнения) Тогда
		СохранитьДанныеБланковДоВыполненияКомандыНаСервере();	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеБланковДоВыполненияКомандыНаСервере() Экспорт
	ВосстановитьОбъектОтчета();
	СтруктураБланковДоЗаполнения = Новый Структура;
	ТекДерево = РеквизитФормыВЗначение("ДеревоСтраниц");
	СформироватьБланкиДляКоллекцииСтраниц(ОтчетОбъект, ТекДерево.Строки, СтруктураБланковДоЗаполнения);
	АдресСтруктурыБланковДоВыполненияКоманды = ПоместитьВоВременноеХранилище(СтруктураБланковДоЗаполнения,УникальныйИдентификатор);
КонецПроцедуры


&НаСервере
Функция ОбработатьОтчетОбъектПослеФоновогоЗаполнения()
	
	ВосстановитьОбъектОтчета();
	ДанныеЗаполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	ОтчетОбъект.СформироватьСтруктуруИзмененныхПоказателей();
	
	Если ДанныеЗаполнения.ОтчетЗаполнен Тогда
		
		НужноСохранитьДанныеАвтозаполнения = Ложь;
		Если СтрНачинаетсяС(ДанныеЗаполнения.ИмяМетода,"РассчитатьГруппировочныеИтогиПоГруппам")
			И ЭтоАдресВременногоХранилища(АдресРезультатаЗаполнения)
			И ЭтоАдресВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды) Тогда
			//Если выполняется расчет группировочных итогов, то следует проверить:
			//если до расчета итогов данные отчета соответствовали данным автозаполнения, 
			//то сохранить результат расчета итогов как результат автозаполнения.
			//Это позволит сверять данные 127 и 128 форм, если в них позднее был выполнен расчет группировочных итогов.
			СтруктураБланковДоЗаполнения = ПолучитьИзВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды);
			
			ДанныеРезультатаЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультатаЗаполнения);
			Если ТипЗнч(ДанныеРезультатаЗаполнения) = Тип("Структура")
				И ДанныеРезультатаЗаполнения.Свойство("СтруктураБланков") Тогда
				
				СтруктураБланковПрошлогоЗаполнения = ДанныеРезультатаЗаполнения.СтруктураБланков;
				ТекДерево = РеквизитФормыВЗначение("ДеревоСтраниц");
				ДанныеОтличаются = Ложь;
				ПроверитьОтличияКоллекцииСтраницЗаполнения(ОтчетОбъект.Ссылка, ТекДерево.Строки, СтруктураБланковПрошлогоЗаполнения, СтруктураБланковДоЗаполнения, ДанныеОтличаются);
				
				Если ДанныеОтличаются = Ложь Тогда
					НужноСохранитьДанныеАвтозаполнения = Истина;
				КонецЕсли;
			КонецЕсли;		
		КонецЕсли;
		
		ДанныеЗаполненияОтчетОбъект = ДанныеЗаполнения.СтруктураОтчетОбъект.Объект;
	
		ЗаполнитьЗначенияСвойств(ОтчетОбъект, ДанныеЗаполненияОтчетОбъект);
		
		Если ДанныеЗаполнения.ИмяМетода = "Заполнить"
			ИЛИ ДанныеЗаполнения.ИмяМетода = "НастройкаЗаполнения"
			ИЛИ ДанныеЗаполнения.ИмяМетода = "ЗаполнитьНаОсновании" Тогда
			//данные расчетов для расшифровки автозаполнения записываем только если было заполнение,
			//иначе расшифровка при следующем открытии отчета перестанет работать
			ОтчетОбъект.ЗаписатьДанныеРасчетов(ДанныеЗаполненияОтчетОбъект.мВнутренниеДанныеРасчетов);
			ЗаполнениеОтчетностиФормаОтчетаСервер.ВосстановитьДанныеРасшифровки(ОтчетОбъект, ЭтаФорма);
			
		КонецЕсли;
		
		// Сохранение отчета.
		ЗначениеВРеквизитФормы(ОтчетОбъект,"Объект");
	
		СтруктураТаблиц = ОтчетОбъект.ПолучитьВнутренниеСвойства();
		Если АдресОбъектаОтчет = Неопределено Тогда
			АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц);
		Иначе
			АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц,АдресОбъектаОтчет);
		КонецЕсли;
		
		//
		
		Если ДанныеЗаполнения.ИмяМетода = "Заполнить"
			ИЛИ ДанныеЗаполнения.ИмяМетода = "НастройкаЗаполнения"
			ИЛИ ДанныеЗаполнения.ИмяМетода = "ЗаполнитьНаОсновании"
			ИЛИ НужноСохранитьДанныеАвтозаполнения Тогда
			
			СтруктураБланков = Новый Структура;
			ТекДерево = РеквизитФормыВЗначение("ДеревоСтраниц");
			СформироватьБланкиДляКоллекцииСтраниц(ОтчетОбъект, ТекДерево.Строки, СтруктураБланков);
			
			Объект.ДатаЗаполнения = ТекущаяДатаСеанса();
			
			СтруктураДанныхЗаполнения = Новый Структура;
			СтруктураДанныхЗаполнения.Вставить("ДатаЗаполнения",Объект.ДатаЗаполнения);
			СтруктураДанныхЗаполнения.Вставить("СтруктураБланков",СтруктураБланков);
		
			АдресРезультатаЗаполнения = ПоместитьВоВременноеХранилище(СтруктураДанныхЗаполнения,УникальныйИдентификатор);
			Элементы.ФормаСравнитьСДаннымиЗаполнения.Доступность = Истина;
			
			
		КонецЕсли;
		
		ОтчетОбъект = Неопределено;
		
		Если ЭтоАдресВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды) Тогда
			УдалитьИзВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды);
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		ОтчетОбъект = Неопределено;
		АдресРезультатаЗаполнения = Неопределено;
		
		Если ЭтоАдресВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды) Тогда
			УдалитьИзВременногоХранилища(АдресСтруктурыБланковДоВыполненияКоманды);
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура ПроверитьОтличияКоллекцииСтраницЗаполнения(Знач ОтчетСсылка, Знач КоллекцияСтрок, Знач СтруктураБланковПервая, Знач СтруктураБланковВторая, ДанныеОтличаются)
		
	Для Каждого СтраницаДерева Из КоллекцияСтрок Цикл
					
		Если СтруктураБланковПервая.Свойство(СтраницаДерева.ИмяСтраницы) Тогда
			СохраненныйБланк = СтруктураБланковПервая[СтраницаДерева.ИмяСтраницы];
		Иначе
			СохраненныйБланк = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если СтруктураБланковВторая.Свойство(СтраницаДерева.ИмяСтраницы) Тогда
			ВыводимыйБланк = СтруктураБланковВторая[СтраницаДерева.ИмяСтраницы];
		Иначе
			ВыводимыйБланк = Новый ТабличныйДокумент;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ТабличныеДокументыЗаполнены", Истина);
		СтруктураПараметров.Вставить("ТабличныйДокументВерсия1", ВыводимыйБланк);
		СтруктураПараметров.Вставить("ТабличныйДокументВерсия2", СохраненныйБланк);
		
		СтруктураПараметров.Вставить("ВариантСравнения","ДанныеОтчета");
		
		СтруктураПараметров.Вставить("ОтчетСсылка", ОтчетСсылка);
		СтруктураПараметров.Вставить("ИзмененныеОбласти", Новый Массив);
		
		ДанныеОтличаются = НЕ Документы.УниверсальныйРегламентированныйОтчет.ВерсииОтчетаИдентичны(СтруктураПараметров);
		
		Если ДанныеОтличаются Тогда
			Прервать;
		КонецЕсли;
		
		Если СтраницаДерева.Строки.Количество()>0 Тогда
			ПроверитьОтличияКоллекцииСтраницЗаполнения(ОтчетСсылка, СтраницаДерева.Строки, СтруктураБланковПервая, СтруктураБланковВторая, ДанныеОтличаются);
			Если ДанныеОтличаются Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СформироватьБланкиДляКоллекцииСтраниц(ОтчетОбъект, СтрокиДерева, СтруктураБланков)
	
	Для Инд = 0 По СтрокиДерева.Количество()-1 Цикл
		ТекСтраница = СтрокиДерева[Инд];
		ТабличныйДокумент = ПечатьРегламентированныхФорм.ПолучитьСтраницуПечатнойФормыТекущегоБланка(ОтчетОбъект, ТекСтраница);
		
		СтруктураБланков.Вставить(ТекСтраница.ИмяСтраницы,ТабличныйДокумент);
		
		Если ТекСтраница.Строки.Количество()>0 Тогда
			СформироватьБланкиДляКоллекцииСтраниц(ОтчетОбъект,ТекСтраница.Строки, СтруктураБланков);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаКлиенте
Процедура СравнитьСДаннымиЗаполнения(Команда)
	Если НЕ ЭтоАдресВременногоХранилища(АдресРезультатаЗаполнения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='В отчете отсутствуют данные автозаполнения по данным учета.'"));
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		ОбеспечитьЗаписанностьДанныхАсинхрон(Новый ОписаниеОповещения("СравнитьСУчетнымиДаннымиЗавершение",ЭтотОбъект));
	Иначе
		СравнитьСУчетнымиДаннымиЗавершение(КодВозвратаДиалога.ОК);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СравнитьСУчетнымиДаннымиЗавершение(Результат, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	БюджетнаяОтчетностьКлиент.СравнитьСДаннымиАвтозаполнения(ЭтотОбъект,Объект.Ссылка,УникальныйИдентификатор,АдресРезультатаЗаполнения);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечитьЗаписанностьДанныхАсинхрон(Знач Оповещение)
	
	ТекстВопроса = НСтр("ru = 'Для выполнения данной операции документ необходимо записать.'");
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбеспечитьЗаписанностьДанныхЗавершение",ЭтотОбъект, Оповещение), ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ОбеспечитьЗаписанностьДанныхЗавершение(РезультатВопроса, ОповещениеПоРезультату) Экспорт
	
	ФормаЗаписана = Ложь;
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ФормаЗаписана = ЭтотОбъект.Записать();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ФормаЗаписана = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеПоРезультату,КодВозвратаДиалога.ОК);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинкиСпискаСостояний()

	Для Каждого ЭлементСпискаВыбора Из Элементы.Состояние.СписокВыбора Цикл
		ИмяЗначенияСостояния = XMLСтрока(ЭлементСпискаВыбора.Значение);
		ЭлементСпискаВыбора.Картинка = БиблиотекаКартинок["Отчет"+ИмяЗначенияСостояния];
	КонецЦикла;
	
	Для Каждого ЭлементСпискаВыбораСвод Из Элементы.СостояниеСвод.СписокВыбора Цикл
		ИмяЗначенияСостояния = XMLСтрока(ЭлементСпискаВыбораСвод.Значение);
		ЭлементСпискаВыбораСвод.Картинка = БиблиотекаКартинок["Отчет"+ИмяЗначенияСостояния];
	КонецЦикла;

КонецПроцедуры

