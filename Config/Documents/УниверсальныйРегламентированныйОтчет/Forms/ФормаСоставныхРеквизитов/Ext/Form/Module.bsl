
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НаДату = Параметры.НаДату;
	ДатаДокумента = Параметры.ДатаДокумента;
	
	Если ЗначениеЗаполнено(Параметры.КлючСохраненияПоложенияОкна) Тогда
		ЭтотОбъект.КлючСохраненияПоложенияОкна = Параметры.КлючСохраненияПоложенияОкна;
	КонецЕсли;
	
	СтруктураНастроек = Неопределено;
	
	ТаблицаРаскрытия = Неопределено;
	
	ДокСсылка = Параметры.Ссылка;
	Организация = Параметры.Организация;		
	ВидОтчета = Параметры.ВидОтчета;
	ГруппаРаскрытия = Параметры.ГруппаРаскрытия;
		
	// Считывание настроек и текущих значений реквизитов.
	Если Параметры.НастройкаРеквизитов = Неопределено Тогда
		
		КонтекстОтчета 	= ПолучитьИзВременногоХранилища(Параметры.АдресДокументаОбъект);
		ТаблицаНастроек = КонтекстОтчета.мНастройкиБланка;
		
		Если ЗначениеЗаполнено(Параметры.ГруппаРаскрытия) Тогда
			
			ТаблицаАналитик  = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(Параметры.ВидОтчета);
			ТаблицаАналитик  = ТаблицаАналитик.Скопировать(Новый Структура("ГруппаРаскрытия",Параметры.ГруппаРаскрытия));
			
			Если ЭтоАдресВременногоХранилища(Параметры.АдресТаблицыРаскрытия) Тогда
				//это выбор связанных реквизитов из формы РедактированиеРаскрытия
				ТаблицаРаскрытия = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыРаскрытия);
			Иначе
				
				ТаблицаРаскрытия = КонтекстОтчета.ТабОбластиРаскрытия.Найти(Параметры.ГруппаРаскрытия,"ГруппаРаскрытия").ТаблицаРаскрытия;
			КонецЕсли;
			
			СтрокаРаскрытия	 = ТаблицаРаскрытия.Найти(Параметры.ИдентификаторОбласти,"ID");
			
			Если СтрокаРаскрытия = Неопределено Тогда
				Отказ = Истина; // В отчете нет строки с таким идентификатором.
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураНастроек = ТаблицаНастроек.Найти(Параметры.ИмяОбласти,"ИмяЯчейки").СтруктураНастроек;
		ТаблицаСвязанныхРеквизитов = СтруктураНастроек.СвязанныеРеквизиты;
		
		МетаданныеОтчета		   = Метаданные.Документы.УниверсальныйРегламентированныйОтчет;
		
		Если ТаблицаСвязанныхРеквизитов.Колонки.Найти("Наименование") = Неопределено Тогда
			ТаблицаСвязанныхРеквизитов.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
		КонецЕсли;
		Если ТаблицаСвязанныхРеквизитов.Колонки.Найти("ИсторияВвода") = Неопределено Тогда 
			ТаблицаСвязанныхРеквизитов.Колонки.Добавить("ИсторияВвода",Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		Если ТаблицаСвязанныхРеквизитов.Колонки.Найти("ПредопределенныеЗначения") = Неопределено Тогда
			ТаблицаСвязанныхРеквизитов.Колонки.Добавить("ПредопределенныеЗначения",Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		
		Для Каждого ОписаниеРеквизита Из ТаблицаСвязанныхРеквизитов Цикл
			
			ЗначениеРеквизита = Неопределено;
			Наименование	  = Неопределено;
			ВидАналитики	  = Неопределено;
			ВидКлассификатораБК = Неопределено;
			
			Если ЗначениеЗаполнено(ОписаниеРеквизита.Наименование) Тогда
				Наименование = ОписаниеРеквизита.Наименование;
			КонецЕсли;
			
			Если ОписаниеРеквизита.ИсточникДанных = 1 Тогда // Реквизит объекта
				ЗначениеКонтекста = КонтекстОтчета.Параметры[ОписаниеРеквизита.Имя];
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Реквизит = МетаданныеОтчета.Реквизиты.Найти(ОписаниеРеквизита.Имя);
					Если Реквизит <> Неопределено Тогда
						Наименование = Реквизит.Синоним;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ОписаниеРеквизита.ИсточникДанных = 3 Тогда // Дополнительный реквизит
				СтрДопРеквизит 	  = КонтекстОтчета.мДополнительныеРеквизиты.Найти(ОписаниеРеквизита.Имя,"Код");
				ЗначениеКонтекста = СтрДопРеквизит.Значение;
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Наименование	  = СтрДопРеквизит.Наименование;
				КонецЕсли;
				
				ВидАналитики	  = СтрДопРеквизит.ВидАналитики;
				ВидКлассификатораБК = СтрДопРеквизит.ВидКлассификатораБК;
			ИначеЕсли ОписаниеРеквизита.ИсточникДанных = 4 Тогда // Строка раскрытия
				ЗначениеКонтекста = СтрокаРаскрытия[ОписаниеРеквизита.Имя];
				СтрАналитики	  = ТаблицаАналитик.Найти(ОписаниеРеквизита.Имя,"ИмяОбъектаАналитики");
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Наименование	  = СтрАналитики.Наименование;
				КонецЕсли;
				
				ВидАналитики	  = СтрАналитики.ВидАналитики;
				ВидКлассификатораБК = СтрАналитики.ВидКлассификатораБК;
			ИначеЕсли ОписаниеРеквизита.ИсточникДанных = 5 Тогда // показатель строки раскрытия
				ЗначениеКонтекста = СтрокаРаскрытия[ОписаниеРеквизита.Имя];
			Иначе
				Продолжить;
			КонецЕсли;
			
			СтрРеквизит = СвязанныеРеквизиты.Добавить();
			СтрРеквизит.ИмяРеквизита = ОписаниеРеквизита.Имя;
			СтрРеквизит.ВидИсточника = ОписаниеРеквизита.ИсточникДанных;
			СтрРеквизит.ИсторияВвода = ОписаниеРеквизита.ИсторияВвода;
			СтрРеквизит.ПредопределенныеЗначения = ОписаниеРеквизита.ПредопределенныеЗначения;
			СтрРеквизит.Наименование = Наименование;
			СтрРеквизит.ВидАналитики = ВидАналитики;
			СтрРеквизит.Значение	 = ЗначениеКонтекста;
			СтрРеквизит.ВидКлассификатораБК = ВидКлассификатораБК;
			
		КонецЦикла;
	Иначе
		ТаблицаАналитик  = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(Параметры.ВидОтчета);
		ТаблицаАналитик  = ТаблицаАналитик.Скопировать(Новый Структура("ГруппаРаскрытия",Параметры.ГруппаРаскрытия));

		Для Каждого СтруктураНастройки Из Параметры.НастройкаРеквизитов Цикл
			
			СтрРеквизит = СвязанныеРеквизиты.Добавить();
			СтрРеквизит.ИмяРеквизита = СтруктураНастройки.Имя;
			СтрРеквизит.Наименование = СтруктураНастройки.Заголовок;
			СтрРеквизит.Значение	 = СтруктураНастройки.Значение;
			
			Если Лев(СтрРеквизит.ИмяРеквизита,9) = "Аналитика" Тогда
				СтрокаАналитики = ТаблицаАналитик.Найти(Сред(СтрРеквизит.ИмяРеквизита,10),"КодВидаАналитики");
				Если СтрокаАналитики <> Неопределено Тогда
					СтрРеквизит.ВидАналитики = СтрокаАналитики.ВидАналитики;
					СтрРеквизит.ВидКлассификатораБК = СтрокаАналитики.ВидКлассификатораБК;
				Иначе
					СвязанныеРеквизиты.Удалить(СтрРеквизит);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СвязанныеРеквизиты.Количество() = 0 Тогда
			Отказ = Истина; // Нет реквизитов, доступных для редактирования
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СоздатьРеквизитыФормы();
	
	Если СтруктураНастроек <> Неопределено Тогда
		Если СтруктураНастроек.Свойство("ТаблицаПредопределенныеЗначения")
			И ТипЗнч(СтруктураНастроек.ТаблицаПредопределенныеЗначения) = Тип("ТаблицаЗначений") Тогда
			
			СоответствиеКолонокАналитики = Новый Соответствие;
			ПодготовитьТаблицуПредопределенныхЗначенийНаСервере(СоответствиеКолонокАналитики);
			
			Для Каждого СтрТЧ Из СтруктураНастроек.ТаблицаПредопределенныеЗначения Цикл
				НовСтр = ТаблицаПредопределенныеЗначения.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
				
				Для Каждого КлючИЗначение Из СоответствиеКолонокАналитики Цикл
					ИмяКолонки = КлючИЗначение.Ключ;
					ВидАналитики = КлючИЗначение.Значение;
					Если ЗначениеЗаполнено(СтрТЧ[ИмяКолонки+"_Код"]) Тогда
						НовСтр[ИмяКолонки] = Справочники.Субконто.НайтиПоКоду(СтрТЧ[ИмяКолонки+"_Код"],,,ВидАналитики);
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	ПодготовитьТаблицуИстории(ТаблицаРаскрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ТипЗнч(ИменаКолонокТабПред) = Тип("ФиксированныйМассив") Тогда
		Если ИменаКолонокТабПред.Количество() Тогда
			СтруктураПоиска = Новый Структура(ИменаКолонокТабПред[0],ЭтотОбъект["_"+ИменаКолонокТабПред[0]]);
			НайденныеСтроки = ТаблицаПредопределенныеЗначения.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() Тогда
				Элементы.ТаблицаПредопределенныеЗначения.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВидДохода	= ?(ЗначениеЗаполнено(ИмяКДВидДоходов),ЭтаФорма[ИмяКДВидДоходов],Неопределено);
	ГруппаПодвидаКДБ = ?(ЗначениеЗаполнено(ИмяКДГруппаПодвида),ЭтаФорма[ИмяКДГруппаПодвида],Неопределено);
	АналитическаяГруппаКДБ = ?(ЗначениеЗаполнено(ИмяКДАналитическаяГруппа),ЭтаФорма[ИмяКДАналитическаяГруппа],Неопределено);
	
	Если Элемент.Имя = ИмяКДАналитическаяГруппа И НЕ ЗначениеЗаполнено(ВидДохода) И ТипЗнч(ВидДохода)<>Тип("Строка") Тогда
		СтандартнаяОбработка = Истина;
	Иначе
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("НаДату", НаДату);
		ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
		
		Если ЗначениеЗаполнено(АналитическаяГруппаКДБ) Тогда
			ПараметрыФормы.Вставить("ТекущаяСтрока", АналитическаяГруппаКДБ);
			ПараметрыФормы.ДополнительныйОтбор.Вставить("ВидДохода", ВидДохода); 
		Иначе
			ПараметрыФормы.Вставить("ТекущаяСтрока", ВидДохода);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГруппаПодвидаКДБ) Тогда
			ПараметрыФормы.Вставить("ГруппаПодвида", ГруппаПодвидаКДБ);
		КонецЕсли;
		
		ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
		
		БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ВДБ", ПараметрыФормы, Элемент);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьВыборВидаДоходов(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		ЗаполнитьЗначенияКДБ(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияКДБ(СтруктураКДБ)
	
	ВидДоходов = Неопределено;
	ГруппаПодвида = Неопределено;
	АналитическаяГруппа = Неопределено;
	
	СтруктураКДБ.Свойство("Ссылка", ВидДоходов);
	СтруктураКДБ.Свойство("ГруппаПодвида", ГруппаПодвида);
	СтруктураКДБ.Свойство("АналитическаяГруппа", АналитическаяГруппа);
	
	ЭтаФорма[ИмяКДВидДоходов] = ВидДоходов;
	ЭтаФорма[ИмяКДГруппаПодвида] = ГруппаПодвида;
	ЭтаФорма[ИмяКДАналитическаяГруппа] = АналитическаяГруппа;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуВыбораЦелевойСтатьиКРБ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЦСР = ?(ЗначениеЗаполнено(ИмяКРБЦелевыеСтатьи),ЭтаФорма[ИмяКРБЦелевыеСтатьи], Неопределено);
	ПрограммаЦСР = ?(ЗначениеЗаполнено(ИмяКРБПрограммыЦелевыхСтатей),ЭтаФорма[ИмяКРБПрограммыЦелевыхСтатей],Неопределено);
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора"		,Истина);
	ПараметрыФормы.Вставить("ОтветСтруктурой"	,Истина);
	ПараметрыФормы.Вставить("НаДату"			,НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор",Новый Структура);
	
	Если ЗначениеЗаполнено(ПрограммаЦСР) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", ПрограммаЦСР);
		ПараметрыФормы.ДополнительныйОтбор.Вставить("ЦелеваяСтатья", ЦСР); 
	Иначе
		ПараметрыФормы.Вставить("ТекущаяСтрока", ЦСР);
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ЦСР", ПараметрыФормы, Элемент);
	
КонецПроцедуры	

&НаКлиенте
Процедура Подключаемый_ОбработатьВыборЦелевойСтатьиКРБ(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		ЗаполнитьЗначенияКРБ(ВыбранноеЗначение);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияКРБ(СтруктураКРБ)
	
	КРБЦелеваяСтатья = Неопределено;
	ПрограммаЦелевойСтатьиКРБ = Неопределено;
	
	СтруктураКРБ.Свойство("ЦелеваяСтатья", КРБЦелеваяСтатья);
	СтруктураКРБ.Свойство("Ссылка", ПрограммаЦелевойСтатьиКРБ);
	
	ЭтаФорма[ИмяКРБЦелевыеСтатьи] = КРБЦелеваяСтатья;
	ЭтаФорма[ИмяКРБПрограммыЦелевыхСтатей] = ПрограммаЦелевойСтатьиКРБ;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуВыбораКИФ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ГруппаПодгруппаКИФ = ?(ЗначениеЗаполнено(ИмяКИФГруппыПодгруппы), ЭтаФорма[ИмяКИФГруппыПодгруппы], Неопределено);
	СтатьяКИФ = ?(ЗначениеЗаполнено(ИмяКИФСтатьи), ЭтаФорма[ИмяКИФСтатьи], Неопределено);
	ВидКИФ = ?(ЗначениеЗаполнено(ИмяКИФВиды), ЭтаФорма[ИмяКИФВиды], Неопределено);
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ОтветСтруктурой"	,Истина);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ?(ЗначениеЗаполнено(ВидКИФ), ВидКИФ, ?(ЗначениеЗаполнено(СтатьяКИФ), СтатьяКИФ, ГруппаПодгруппаКИФ))); 
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("КИФ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьВыборКИФ(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗаполнитьЗначенияКИФ(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияКИФ(ЗначениеДляЗаполнения)
	
	Если ТипЗнч(ЗначениеДляЗаполнения) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
		ЭтаФорма[ИмяКИФГруппыПодгруппы] = ЗначениеДляЗаполнения;
	ИначеЕсли ТипЗнч(ЗначениеДляЗаполнения) = Тип("СправочникСсылка.СтатьиКИФ") Тогда
		ЭтаФорма[ИмяКИФСтатьи] = ЗначениеДляЗаполнения;
		ЭтаФорма[ИмяКИФГруппыПодгруппы] = ЗначениеДляЗаполнения.Владелец;
	ИначеЕсли ТипЗнч(ЗначениеДляЗаполнения) = Тип("СправочникСсылка.ВидыКИФ")	Тогда
		ЭтаФорма[ИмяКИФВиды] = ЗначениеДляЗаполнения;
		ЗначениеКИФСтатья = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеДляЗаполнения,"Владелец");
		ЭтаФорма[ИмяКИФСтатьи] = ЗначениеКИФСтатья;
		ЗначениеКИФГруппыПодгруппы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеКИФСтатья,"Владелец");
		ЭтаФорма[ИмяКИФГруппыПодгруппы] = ЗначениеКИФГруппыПодгруппы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуВыбораБК(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИмяРеквизита", Сред(Элемент.Имя, 2));
	СтрРекизит = СвязанныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
	Если СтрРекизит.Количество() > 0 Тогда
		ИмяФормыБК = БюджетнаяОтчетностьКлиентСервер.ПолучитьИмяФормыВыбораБК(СтрРекизит[0].ВидКлассификатораБК);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("НаДату", НаДату));
		ПараметрыФормы.Вставить("ТекущаяСтрока", ЭтотОбъект[Элемент.Имя]);
		ОткрытьФорму(ИмяФормыБК, ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуВыбораКВД(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокДляОтбора = Неопределено;
	Для Каждого ТекПараметр Из Элемент.ПараметрыВыбора Цикл
		Если ВРег(ТекПараметр.Имя) = ВРег("Отбор.Код") Тогда
			СписокДляОтбора = ТекПараметр.Значение;
		КонецЕсли;
	КонецЦикла;
	Если СписокДляОтбора <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Код",СписокДляОтбора));
		ПараметрыФормы.Вставить("ОповещатьОВыборе",Истина);
		ПараметрыФормы.Вставить("ОтборПоПараметруБланка",Истина);
		ОткрытьФорму("ОбщаяФорма.ВыборКФО",ПараметрыФормы,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧасти_ТаблицаПредопределенныеЗначения

&НаКлиенте
Процедура ТаблицаПредопределенныеЗначенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаПредопределенныеЗначения.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВсеЗаполнены = Истина;
	Если ИменаКолонокТабПред.Количество() <> СвязанныеРеквизиты.Количество() Тогда
		ВсеЗаполнены = Ложь;//если не для всех связанных реквизитов настроен выбор из фиксированных значений
	КонецЕсли;
	
	Для Каждого ТекИмя Из ИменаКолонокТабПред Цикл
		ЭтотОбъект["_"+ТекИмя] = ТекДанные[ТекИмя];
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["_"+ТекИмя]) Тогда
			ВсеЗаполнены = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеЗаполнены Тогда
		ОповеститьОВыборе(ПоместитьЗначенияРеквизитов());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧасти_ТаблицаИстория

&НаКлиенте
Процедура ТаблицаИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаИстория.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Только переносим в шапку, т.к. может быть случай, что в истории есть наиболее похожее значение,
	//но требуется изменить значение какого-нибудь одного поля.
	//Тогда при выборе из истории данные перенесутся в поля шапки, 
	//но форма не закроется и можно будет изменить значения.
	Для Каждого ТекИмя Из ИменаКолонокТабИст Цикл
		ЭтотОбъект["_"+ТекИмя] = ТекДанные[ТекИмя];
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьЗначения(Команда)
	ЭтаФорма.Закрыть(ПоместитьЗначенияРеквизитов());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьРеквизитыФормы()
	
	ПараметрыОтборПоКоду = Неопределено;
	Если ЭтоАдресВременногоХранилища(Параметры.АдресПараметрыОтборПоКоду) Тогда
		ПараметрыОтборПоКоду = ПолучитьИзВременногоХранилища(Параметры.АдресПараметрыОтборПоКоду);
	КонецЕсли;
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Параметры.УровеньТочности);
	Квалификатор       = Новый КвалификаторыЧисла(РазрядностьЧисла, Параметры.УровеньТочности);
	
	ТипыЗначенийРеквизитов = Новый Соответствие;
	Для Каждого СтрРеквизит Из СвязанныеРеквизиты Цикл
		
		Если ЗначениеЗаполнено(СтрРеквизит.ВидАналитики) Тогда
			ТипЗначенияРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрРеквизит.ВидАналитики,"ТипЗначения");
		Иначе
			МассивТипов = Новый Массив;
			ТекущийТипЗначения = ТипЗнч(СтрРеквизит.Значение);
			МассивТипов.Добавить(ТекущийТипЗначения);
			ТипЗначенияРеквизита = Новый ОписаниеТипов(МассивТипов,,,Квалификатор);
		КонецЕсли;
		ТипыЗначенийРеквизитов.Вставить(СтрРеквизит.ИмяРеквизита,ТипЗначенияРеквизита);
		
		РеквизитФормы = Новый РеквизитФормы("_"+СтрРеквизит.ИмяРеквизита,ТипЗначенияРеквизита,,СтрРеквизит.Наименование);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
				
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	//Типы КДБ:
	ТипВидыДоходовКДБ = Тип("СправочникСсылка.ВидыДоходовКДБ");
	ТипГруппыПодвидовКДБ = Тип("СправочникСсылка.ГруппыПодвидовКДБ");
	ТипКОСГУ = Тип("СправочникСсылка.КОСГУ");
	
	КодыКЭКДоходов = Новый Массив;
	КодыКЭКДоходов.Добавить("100");
	КодыКЭКДоходов.Добавить("110");
	КодыКЭКДоходов.Добавить("120");
	КодыКЭКДоходов.Добавить("130");
	КодыКЭКДоходов.Добавить("140");
	КодыКЭКДоходов.Добавить("150");
	КодыКЭКДоходов.Добавить("151");
	КодыКЭКДоходов.Добавить("152");
	КодыКЭКДоходов.Добавить("153");
	КодыКЭКДоходов.Добавить("160");
	КодыКЭКДоходов.Добавить("180");
	КодыКЭКДоходов.Добавить("190");
	КодыКЭКДоходов.Добавить("191");
	КодыКЭКДоходов.Добавить("192");
	КодыКЭКДоходов.Добавить("193");
	КодыКЭКДоходов.Добавить("194");
	КодыКЭКДоходов.Добавить("195");
	КодыКЭКДоходов.Добавить("196");
	КодыКЭКДоходов.Добавить("197");
	КодыКЭКДоходов.Добавить("198");
	КодыКЭКДоходов.Добавить("199");	
	КодыКЭКДоходов.Добавить("400");
	КодыКЭКДоходов.Добавить("410");
	КодыКЭКДоходов.Добавить("420");
	КодыКЭКДоходов.Добавить("430");
	КодыКЭКДоходов.Добавить("440");
	КодыКЭКДоходов.Добавить("460");
	
	//Типы КРБ:
	ТипЦелевыеСтатьиКРБ = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ");
	ТипПрограммыЦелевыхСтатейКРБ = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
	
	//Типы КИФ:
	ТипГруппыПодгруппыКИФ = Тип("СправочникСсылка.ГруппыПодгруппыКИФ");
	ТипСтатьиКИФ = Тип("СправочникСсылка.СтатьиКИФ");
	ТипВидыКИФ = Тип("СправочникСсылка.ВидыКИФ");
	
	ГруппаДляЭлементов = Элементы.ГруппаСвязанныеРеквизиты;
	
	ТипСубконто = Тип("СправочникСсылка.Субконто");
	
	НужноДопПоле = Ложь;
	Для Каждого СтрРеквизит Из СвязанныеРеквизиты Цикл
		
		ЗначенияОтбораПоКоду = Неопределено;
		
		Если ТипыЗначенийРеквизитов[СтрРеквизит.ИмяРеквизита].СодержитТип(ТипСубконто) Тогда
			
			ДопГруппа = Элементы.Добавить("Группа_"+СтрРеквизит.ИмяРеквизита,Тип("ГруппаФормы"),ГруппаДляЭлементов);
			ДопГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ДопГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			ДопГруппа.ОтображатьЗаголовок = Ложь;
			ТекГруппаДляЭлементов = ДопГруппа;
			НужноДопПоле = Истина;
		Иначе
			НужноДопПоле = Ложь;
			ТекГруппаДляЭлементов = ГруппаДляЭлементов;
		КонецЕсли;
		
		ЭлементФормы  = Элементы.Добавить("_"+СтрРеквизит.ИмяРеквизита,Тип("ПолеФормы"),ТекГруппаДляЭлементов);
		ЭлементФормы.ПутьКДанным = "_"+СтрРеквизит.ИмяРеквизита;
		ЭлементФормы.Вид		 = ВидПоляФормы.ПолеВвода;
		
		ЭлементФормы.КнопкаОчистки = Истина;
		ЭлементФормы.КнопкаВыпадающегоСписка = Ложь;
		ЭлементФормы.КнопкаВыбора = Истина;
		ЭлементФормы.КнопкаОткрытия = Ложь;
		ЭлементФормы.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		ЭлементФормы.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
		ЭлементФормы.КнопкаСоздания = Ложь;
		
		ЭтаФорма["_"+СтрРеквизит.ИмяРеквизита] = СтрРеквизит.Значение;
		
		Если НЕ ЗначениеЗаполнено(СтрРеквизит.ВидАналитики)
			И ТипЗнч(СтрРеквизит.Значение) = Тип("Строка") Тогда
			ЭлементФормы.РасширенноеРедактирование = Истина;
			ЭлементФормы.МногострочныйРежим = Истина;
			ЭлементФормы.РастягиватьПоГоризонтали = Истина;
			ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрРеквизит.ВидАналитики) Тогда
			МассивПараметров = Новый Массив;
			
			ВладелецСубконто = БюджетнаяОтчетностьСервер.ПолучитьВладельцаСубконтоДляАналитики(СтрРеквизит.ВидАналитики);
			МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец",ВладелецСубконто));
			МассивПараметров.Добавить(Новый ПараметрВыбора("НаДату", НаДату));
			МассивПараметров.Добавить(Новый ПараметрВыбора("ПоказатьСкрытыеКоды", Истина));
			
			Если (Найти(Параметры.ИмяОбласти,СтрРеквизит.ИмяРеквизита) > 0 ИЛИ СтрРеквизит.ВидИсточника = 3)
				И ЗначениеЗаполнено(ПараметрыОтборПоКоду) Тогда
				// Для этого реквизита может быть задан фильтр по коду.
				Если СтрРеквизит.ВидИсточника = 3 Тогда
					ЗначенияОтбораПоКоду = ПараметрыОтборПоКоду.НайтиСтроки(Новый Структура("ИмяЯчейки", СтрРеквизит.ИмяРеквизита));
				Иначе
					ЗначенияОтбораПоКоду = ПараметрыОтборПоКоду.НайтиСтроки(Новый Структура("ИмяЯчейки", Параметры.ИмяОбласти));
				КонецЕсли;	
				Если ЗначенияОтбораПоКоду.Количество() > 0 Тогда

					Если ТипЗнч(СтрРеквизит.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
						Если ЗначенияОтбораПоКоду[0].ТаблицаКодов.Количество() > 0 Тогда
							МассивПараметров.Добавить(Новый ПараметрВыбора("ОтборПоПараметруБланка", ЗначенияОтбораПоКоду[0].ТаблицаКодов));
						КонецЕсли;
					ИначеЕсли ТипЗнч(СтрРеквизит.Значение) = ТипКОСГУ И ЗначенияОтбораПоКоду[0].ТаблицаКодов.Количество() > 0 Тогда
						МассивПараметров.Добавить(Новый ПараметрВыбора("ОтборПоПараметруБланка", Истина));
						МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Код",ЗначенияОтбораПоКоду[0].ТаблицаКодов));	
					Иначе	
						МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Код",ЗначенияОтбораПоКоду[0].ТаблицаКодов));
					КонецЕсли;	

				КонецЕсли;
			КонецЕсли;
			
			ЭлементФормы.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрРеквизит.ВидАналитики) Тогда
			СценарийВвода = Неопределено;
			Если ЗначениеЗаполнено(Параметры.ГруппаРаскрытия) Тогда
				СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(Параметры.ГруппаРаскрытия, СтрРеквизит.ВидАналитики);
			Иначе
				СценарийВвода = БюджетнаяОтчетностьСервер.ПодобратьСценарийВводаАналитики(Параметры.ВидОтчета, СтрРеквизит.ВидАналитики);
			КонецЕсли;	
			ТипыРеквизита = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрРеквизит.ВидАналитики).Типы();
			Если ЗначениеЗаполнено(СценарийВвода) Тогда
				ЭлементФормы.КнопкаВыбора = Истина;
				Если ТипыРеквизита.Найти(ТипВидыДоходовКДБ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКДВидДоходов) Тогда
					ИмяКДВидДоходов = ЭлементФормы.Имя;
				 	УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораВидаДоходов", "Подключаемый_ОбработатьВыборВидаДоходов");
						
				ИначеЕсли ТипыРеквизита.Найти(ТипГруппыПодвидовКДБ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКДГруппаПодвида) Тогда
					Если СценарийВвода.СвязиВыбора.Найти(ТипГруппыПодвидовКДБ, "ТребуемыйТип") <> Неопределено Тогда	
						ИмяКДГруппаПодвида = ЭлементФормы.Имя;	
						УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораВидаДоходов", "Подключаемый_ОбработатьВыборВидаДоходов");
					КонецЕсли;	
					
				ИначеЕсли ТипыРеквизита.Найти(ТипКОСГУ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКДАналитическаяГруппа) Тогда
					Если СценарийВвода.СвязиВыбора.Найти(ТипКОСГУ, "ТребуемыйТип") <> Неопределено Тогда 
						ИмяКДАналитическаяГруппа = ЭлементФормы.Имя;
						УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораВидаДоходов", "Подключаемый_ОбработатьВыборВидаДоходов");
						
						МассивПараметров = Новый Массив;
						МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Код",КодыКЭКДоходов));
						ЭлементФормы.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
					КонецЕсли;	
					
				ИначеЕсли ТипыРеквизита.Найти(ТипЦелевыеСтатьиКРБ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКРБЦелевыеСтатьи) Тогда
					ИмяКРБЦелевыеСтатьи = ЭлементФормы.Имя;
					УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораЦелевойСтатьиКРБ", "Подключаемый_ОбработатьВыборЦелевойСтатьиКРБ");
							
				ИначеЕсли ТипыРеквизита.Найти(ТипПрограммыЦелевыхСтатейКРБ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКРБПрограммыЦелевыхСтатей) Тогда
					ИмяКРБПрограммыЦелевыхСтатей = ЭлементФормы.Имя;
					УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораЦелевойСтатьиКРБ", "Подключаемый_ОбработатьВыборЦелевойСтатьиКРБ");
					
				ИначеЕсли ТипыРеквизита.Найти(ТипГруппыПодгруппыКИФ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКИФГруппыПодгруппы) Тогда
					ИмяКИФГруппыПодгруппы = ЭлементФормы.Имя;
					УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораКИФ", "Подключаемый_ОбработатьВыборКИФ");
					
				ИначеЕсли ТипыРеквизита.Найти(ТипСтатьиКИФ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКИФСтатьи) Тогда
					ИмяКИФСтатьи = ЭлементФормы.Имя;
					УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораКИФ", "Подключаемый_ОбработатьВыборКИФ");
				
				ИначеЕсли ТипыРеквизита.Найти(ТипВидыКИФ) <> Неопределено И НЕ ЗначениеЗаполнено(ИмяКИФВиды) Тогда
					ИмяКИФВиды = ЭлементФормы.Имя;
					УстановитьДействияЭлементов(ЭлементФормы, "Подключаемый_ОткрытьФормуВыбораКИФ", "Подключаемый_ОбработатьВыборКИФ");
					
				КонецЕсли;		
				
			ИначеЕсли ЗначениеЗаполнено(СтрРеквизит.ВидКлассификатораБК) Тогда
				ЭлементФормы.КнопкаВыбора = Истина;
				ЭлементФормы.УстановитьДействие("НачалоВыбора", "Подключаемый_ОткрытьФормуВыбораБК");
			ИначеЕсли ЗначениеЗаполнено(СтрРеквизит.ВидАналитики)
				И СтрРеквизит.ВидАналитики.ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.КВД"))
				И ЗначенияОтбораПоКоду <> Неопределено
				И ЗначенияОтбораПоКоду.Количество() >0 Тогда
				
				ЭлементФормы.КнопкаВыбора = Истина;
				ЭлементФормы.УстановитьДействие("НачалоВыбора", "Подключаемый_ОткрытьФормуВыбораКВД");
			КонецЕсли;
					
		КонецЕсли;	
		
		Если НужноДопПоле Тогда
			ЭлементФормы.РастягиватьПоГоризонтали = Истина;
			ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
			
			//добавим поле Код
			ЭлементФормыКод  = Элементы.Добавить("_"+СтрРеквизит.ИмяРеквизита+"__Код",Тип("ПолеФормы"),ТекГруппаДляЭлементов);
			ЭлементФормыКод.ПутьКДанным = "_"+СтрРеквизит.ИмяРеквизита+".Код";
			ЭлементФормыКод.Вид		 = ВидПоляФормы.ПолеВвода;
			ЭлементФормыКод.ТолькоПросмотр = Истина;
			ЭлементФормыКод.Заголовок = "Код";
			ЭлементФормыКод.АвтоМаксимальнаяШирина = Ложь;
			ЭлементФормыКод.Ширина = 8;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // СоздатьРеквизитыФормы()

&НаСервере
Процедура УстановитьДействияЭлементов(ЭлементФормы, ИмяОткрыть, ИмяОбработать)
	
	ЭлементФормы.УстановитьДействие("НачалоВыбора", ИмяОткрыть);
	ЭлементФормы.УстановитьДействие("ОбработкаВыбора", ИмяОбработать);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьТаблицуПредопределенныхЗначенийНаСервере(СоответствиеКолонокАналитики)
	
	ИмяТаблицы = "ТаблицаПредопределенныеЗначения";
		
	ДобавляемыеРеквизиты = Новый Массив;
	
	СоответствиеРеквизитов = Новый Соответствие;
			
	ТипРеквизитаСтрока = Новый ОписаниеТипов("Строка");
	ТипЗначенияСубконто = Новый ОписаниеТипов("СправочникСсылка.Субконто");
		
	МассивИменКолонок = Новый Массив;
	
	Для Каждого СтрСвязанного Из СвязанныеРеквизиты Цикл
		
		Если СтрСвязанного.ПредопределенныеЗначения
			И ЗначениеЗаполнено(СтрСвязанного.ИмяРеквизита) Тогда
			СоответствиеРеквизитов.Вставить(СокрЛП(СтрСвязанного.ИмяРеквизита),СтрСвязанного);
		Иначе
			Продолжить;
		КонецЕсли;
				
		//для показателей раскрытия
		Если СтрСвязанного.ВидИсточника = 5 Тогда //"Показатель раскрытия" Тогда
			
			ТипПоказателя = ПолучитьТипПоказателя(СокрЛП(СтрСвязанного.ИмяРеквизита));
			Если ТипПоказателя = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		
			ТипЗначенияПоказателя = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(ТипПоказателя);
			ТекРеквизит = Новый РеквизитФормы(СокрЛП(СтрСвязанного.ИмяРеквизита), ТипЗначенияПоказателя, ИмяТаблицы, СокрЛП(СтрСвязанного.Наименование));
			
			ДобавляемыеРеквизиты.Добавить(ТекРеквизит);
						
			МассивИменКолонок.Добавить(ТекРеквизит.Имя);
			
		//для произвольных классификаторов, не разделяемых по организациям	
		ИначеЕсли СтрСвязанного.ВидИсточника = 3 //"Дополнительный реквизит"
			ИЛИ СтрСвязанного.ВидИсточника = 4 Тогда //"Аналитика группы раскрытия" Тогда
			
			ТекРеквизит = Новый РеквизитФормы(СокрЛП(СтрСвязанного.ИмяРеквизита), ТипЗначенияСубконто, ИмяТаблицы, СокрЛП(СтрСвязанного.Наименование));
			ДобавляемыеРеквизиты.Добавить(ТекРеквизит);
						
			МассивИменКолонок.Добавить(ТекРеквизит.Имя);
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ДобавляемыеРеквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ИменаКолонокТабПред = Новый ФиксированныйМассив(МассивИменКолонок);
		
	Для Каждого ТекЭлемент Из МассивИменКолонок Цикл
		ДобавитьЭлементТаблицыПредопределенныеЗначения(ТекЭлемент,СоответствиеРеквизитов,СоответствиеКолонокАналитики);
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Функция ПолучитьТипПоказателя(КодПоказателя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПоказателиОтчетов.ТипЗначения КАК ТипЗначения
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Код = &Код
		|	И ПоказателиОтчетов.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	Запрос.УстановитьПараметр("Код", КодПоказателя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ТипЗначения;
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции

&НаСервере
Процедура ДобавитьЭлементТаблицыПредопределенныеЗначения(Знач ИмяРеквизита, СоответствиеРеквизитов,мСоответствиеКолонокАналитики)
		
	ИмяРеквизитаДанныеФормыКоллекция = "ТаблицаПредопределенныеЗначения";
		
	ТекРодитель = Элементы.ТаблицаПредопределенныеЗначения;
	
	СтрСвязанногоРеквизита = СоответствиеРеквизитов[ИмяРеквизита];
	
	ЭтоАналитика = Ложь;
	Если СтрСвязанногоРеквизита.ВидИсточника = 4 //"Аналитика группы раскрытия"
		ИЛИ СтрСвязанногоРеквизита.ВидИсточника = 3 Тогда//"Дополнительный реквизит" Тогда
		
		ТекРодитель = Элементы.Добавить("ТаблицаПредопределенныеЗначения" + ИмяРеквизита+"_Группа", Тип("ГруппаФормы"),Элементы.ТаблицаПредопределенныеЗначения);
		ТекРодитель.Группировка = ГруппировкаКолонок.ВЯчейке;
		ТекРодитель.ОтображатьВШапке = Истина;
		ТекРодитель.Заголовок = ?(ЗначениеЗаполнено(СтрСвязанногоРеквизита.Наименование),СтрСвязанногоРеквизита.Наименование,ИмяРеквизита);
				
		ЭтоАналитика = Истина;
				
		//т.к. представление справочник субконто - наименование, то добавим код
		ЭлементРеквизита					= Элементы.Добавить(ИмяРеквизитаДанныеФормыКоллекция + ИмяРеквизита+"_Код", Тип("ПолеФормы"),ТекРодитель);
		ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ИмяРеквизита+".Код";
		ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
		ЭлементРеквизита.Заголовок			= ?(ЗначениеЗаполнено(СтрСвязанногоРеквизита.Наименование),СтрСвязанногоРеквизита.Наименование,ИмяРеквизита)+ "(Код)"; 
	    ЭлементРеквизита.ОтображатьВШапке   = Ложь;
		
	КонецЕсли;
	
	ЭлементРеквизита					= Элементы.Добавить(ИмяРеквизитаДанныеФормыКоллекция + ИмяРеквизита, Тип("ПолеФормы"),ТекРодитель);
	ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ИмяРеквизита;
	ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
	ЭлементРеквизита.КнопкаСоздания		= Ложь;
	ЭлементРеквизита.ОтображатьВШапке 	= (ЭтоАналитика = Ложь);
				
	Если ЭтоАналитика Тогда
		
		мСоответствиеКолонокАналитики.Вставить(ИмяРеквизита,СтрСвязанногоРеквизита.ВидАналитики);
		
	Иначе
		ЭлементРеквизита.РасширенноеРедактирование = Истина;
		ЭлементРеквизита.МногострочныйРежим = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьТаблицуИстории(ТаблицаРаскрытия)
	ИмяТаблицы = "ТаблицаИстория";
		
	ДобавляемыеРеквизиты = Новый Массив;
	
	МассивЭлементов = Новый Массив;
	
	СоответствиеРеквизитов = Новый Соответствие;
			
	ТипРеквизитаСтрока = Новый ОписаниеТипов("Строка");
	ТипЗначенияСубконто = Новый ОписаниеТипов("СправочникСсылка.Субконто");
	
	МассивЭлементов = Новый Массив;
	
	МассивИменКолонокИстории = Новый Массив;
	
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Параметры.УровеньТочности);
	Квалификатор       = Новый КвалификаторыЧисла(РазрядностьЧисла, Параметры.УровеньТочности);
	
	ВидыАналитики = Новый Массив;
	ВидыАналитикиДопРеквизитов = Новый Массив;
	КодыПоказателей = Новый Массив;
	
	КолонкиАналитики = Новый Массив;
	КолонкиДопРеквизитов= Новый Массив;
	
	Для Каждого СтрСвязанного Из СвязанныеРеквизиты Цикл
		
		Если СтрСвязанного.ИсторияВвода
			И ЗначениеЗаполнено(СтрСвязанного.ИмяРеквизита) Тогда
			СоответствиеРеквизитов.Вставить(СокрЛП(СтрСвязанного.ИмяРеквизита),СтрСвязанного);
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтрСвязанного.ВидИсточника = 3 Тогда //доп.реквизит
			ВидыАналитикиДопРеквизитов.Добавить(СтрСвязанного.ВидАналитики);
			КолонкиДопРеквизитов.Добавить(СтрСвязанного.ИмяРеквизита);
		ИначеЕсли СтрСвязанного.ВидИсточника = 4 Тогда //аналитика раскрытия
			ВидыАналитики.Добавить(СтрСвязанного.ВидАналитики);
			КолонкиАналитики.Добавить(СтрСвязанного.ИмяРеквизита);
		ИначеЕсли СтрСвязанного.ВидИсточника = 5 Тогда //показатель
			КодыПоказателей.Добавить(СтрСвязанного.ИмяРеквизита);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СтрСвязанного.ВидАналитики) Тогда
			ТипЗначенияРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрСвязанного.ВидАналитики,"ТипЗначения");
			
		Иначе
			МассивТипов = Новый Массив;
			ТекущийТипЗначения = ТипЗнч(СтрСвязанного.Значение);
			МассивТипов.Добавить(ТекущийТипЗначения);
			ТипЗначенияРеквизита = Новый ОписаниеТипов(МассивТипов,,,Квалификатор);
		КонецЕсли;
		
		ТекРеквизит = Новый РеквизитФормы(СокрЛП(СтрСвязанного.ИмяРеквизита), ТипЗначенияРеквизита, ИмяТаблицы, СокрЛП(СтрСвязанного.Наименование));
			
		ДобавляемыеРеквизиты.Добавить(ТекРеквизит);
			
		МассивИменКолонокИстории.Добавить(ТекРеквизит.Имя);		
			
	КонецЦикла;
	
	Если ДобавляемыеРеквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	СоответствиеКолонок = Новый Соответствие;
	Для Каждого ТекЭлемент Из МассивИменКолонокИстории Цикл
		ДобавитьЭлементТаблицыИстории(ТекЭлемент,СоответствиеРеквизитов,СоответствиеКолонок);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("КодыПоказателей",КодыПоказателей);
	Запрос.УстановитьПараметр("ВидыАналитики", ВидыАналитики);
	Запрос.УстановитьПараметр("ВидыАналитикиДопРеквизитов", ВидыАналитикиДопРеквизитов);
	Запрос.УстановитьПараметр("Дата", ДатаДокумента);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
       |	УниверсальныйРегламентированныйОтчет.Ссылка КАК ДокументОтчет
       |ПОМЕСТИТЬ ТаблицаДокументов
       |ИЗ
       |	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
       |ГДЕ
       |	УниверсальныйРегламентированныйОтчет.ВидОтчета = &ВидОтчета
       |	И УниверсальныйРегламентированныйОтчет.Организация = &Организация
       |	И УниверсальныйРегламентированныйОтчет.Ссылка <> &Ссылка
       |	И УниверсальныйРегламентированныйОтчет.Дата <= &Дата
       |	И УниверсальныйРегламентированныйОтчет.ПометкаУдаления = ЛОЖЬ
       |
       |ИНДЕКСИРОВАТЬ ПО
       |	ДокументОтчет";

	Запрос.Выполнить();
	
	ТабДляОбработки = РеквизитФормыВЗначение("ТаблицаИстория");
	ТабДляОбработки.Колонки.Добавить("Индекс");
	ТабДляОбработки.Колонки.Добавить("ДокСсылка");
	
	ТабДляОбработки.Индексы.Добавить("ДокСсылка,Индекс");
	ТабДляОбработки.Индексы.Добавить("ДокСсылка");
	
	Если КодыПоказателей.Количество() Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПоказателиОтчетов.Ссылка КАК Показатель,
			|	ПоказателиОтчетов.Код КАК Код,
			|	ПоказателиОтчетов.НеограниченнаяДлина КАК НеограниченнаяДлина
			|ПОМЕСТИТЬ ТабПоказатели
			|ИЗ
			|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|ГДЕ
			|	ПоказателиОтчетов.Владелец = &ВидОтчета
			|	И ПоказателиОтчетов.Код В(&КодыПоказателей)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаДокументов.ДокументОтчет КАК ДокСсылка,
			|	ЗначенияПоказателейОтчетов.Показатель КАК Показатель,
			|	ЗначенияПоказателейОтчетов.Индекс КАК Индекс,
			|	ЗначенияПоказателейОтчетов.Значение КАК Значение,
			|	ТабПоказатели.Код КАК КодПоказателя,
			|	ТабПоказатели.НеограниченнаяДлина КАК НеограниченнаяДлина,
			|	ЗначенияПоказателейОтчетов.ЗначениеНеограниченнаяСтрока КАК ЗначениеНеограниченнаяСтрока
			|ИЗ
			|	ТаблицаДокументов КАК ТаблицаДокументов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабПоказатели КАК ТабПоказатели
			|			ПО ЗначенияПоказателейОтчетов.Показатель = ТабПоказатели.Показатель
			|		ПО ТаблицаДокументов.ДокументОтчет = ЗначенияПоказателейОтчетов.ЭкземплярОтчета
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДокСсылка,
			|	Индекс
			|ИТОГИ ПО
			|	ДокСсылка,
			|	Индекс";
		
		
		Результат = Запрос.Выполнить();
		ВыборкаДок = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДок.Следующий() Цикл
			
			ВыборкаСтрока = ВыборкаДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСтрока.Следующий() Цикл
				СтруктураПоиска = Новый Структура("ДокСсылка,Индекс",ВыборкаСтрока.ДокСсылка,ВыборкаСтрока.Индекс);
		        НайденныеСтроки = ТабДляОбработки.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() Тогда
					ТекСтрока = НайденныеСтроки[0];
				Иначе
					ТекСтрока = ТабДляОбработки.Добавить();
					ЗаполнитьЗначенияСвойств(ТекСтрока,СтруктураПоиска);
				КонецЕсли;
				
				ДетальнаяВыборка = ВыборкаСтрока.Выбрать();
				Пока ДетальнаяВыборка.Следующий() Цикл
					
					Если ДетальнаяВыборка.НеограниченнаяДлина Тогда
						ТекСтрока[СокрЛП(ДетальнаяВыборка.КодПоказателя)] = ДетальнаяВыборка.ЗначениеНеограниченнаяСтрока;
					Иначе
						ТекСтрока[СокрЛП(ДетальнаяВыборка.КодПоказателя)] = ДетальнаяВыборка.Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ВидыАналитики.Количество() Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДокументов.ДокументОтчет КАК ДокСсылка,
		|	ТаблицаАналитики.ВидАналитики КАК ВидАналитики,
		|	ТаблицаАналитики.Индекс КАК Индекс,
		|	ТаблицаАналитики.Значение КАК Значение
		|ИЗ
		|	ТаблицаДокументов КАК ТаблицаДокументов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПоказателей КАК ТаблицаАналитики
		|		ПО ТаблицаДокументов.ДокументОтчет = ТаблицаАналитики.ЭкземплярОтчета
		|ГДЕ
		|	ТаблицаАналитики.ГруппаРаскрытия = &ГруппаРаскрытия
		|	И ТаблицаАналитики.ВидАналитики В(&ВидыАналитики)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокСсылка,
		|	Индекс
		|ИТОГИ ПО
		|	ДокСсылка,
		|	Индекс";
			
		Результат = Запрос.Выполнить();
		ВыборкаДок = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДок.Следующий() Цикл
			
			ВыборкаСтрока = ВыборкаДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСтрока.Следующий() Цикл
				СтруктураПоиска = Новый Структура("ДокСсылка,Индекс",ВыборкаСтрока.ДокСсылка,ВыборкаСтрока.Индекс);
		        НайденныеСтроки = ТабДляОбработки.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() Тогда
					ТекСтрока = НайденныеСтроки[0];
				Иначе
					ТекСтрока = ТабДляОбработки.Добавить();
					ЗаполнитьЗначенияСвойств(ТекСтрока,СтруктураПоиска);
				КонецЕсли;
				
				ДетальнаяВыборка = ВыборкаСтрока.Выбрать();
				Пока ДетальнаяВыборка.Следующий() Цикл
					ИмяРеквизита = СоответствиеКолонок[ДетальнаяВыборка.ВидАналитики];
					ТекСтрока[ИмяРеквизита] = ДетальнаяВыборка.Значение;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ВидыАналитикиДопРеквизитов.Количество() Тогда
			
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДокументов.ДокументОтчет КАК ДокументОтчет,
			|	ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики КАК ВидАналитики,
			|	ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета КАК ДополнительныйРеквизитОтчета,
			|	ЗначенияДополнительныхРеквизитовОтчета.Значение КАК Значение
			|ИЗ
			|	ТаблицаДокументов КАК ТаблицаДокументов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
			|		ПО ТаблицаДокументов.ДокументОтчет = ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета
			|ГДЕ
			|	ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики В(&ВидыАналитикиДопРеквизитов)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДокументОтчет
			|ИТОГИ ПО
			|	ДокументОтчет";
		
		Результат = Запрос.Выполнить();
		ВыборкаДок = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДок.Следующий() Цикл
			
			СтруктураПоиска = Новый Структура("ДокСсылка",ВыборкаСтрока.ДокСсылка);
		    НайденныеСтроки = ТабДляОбработки.НайтиСтроки(СтруктураПоиска);
							
			Если НайденныеСтроки.Количество() Тогда
				
				Для Каждого ТекСтрока Из НайденныеСтроки Цикл
						
					ДетальнаяВыборка = ВыборкаДок.Выбрать();
					Пока ДетальнаяВыборка.Следующий() Цикл
						ИмяРеквизита = СоответствиеКолонок[ДетальнаяВыборка.ВидАналитики];
					   	ТекСтрока[ИмяРеквизита] = ДетальнаяВыборка.Значение;
					КонецЦикла;
				    ДетальнаяВыборка.Сбросить();
				КонецЦикла;
			Иначе
				
				ТекСтрока = ТабДляОбработки.Добавить();
				ЗаполнитьЗначенияСвойств(ТекСтрока,СтруктураПоиска);
					
				ДетальнаяВыборка = ВыборкаДок.Выбрать();
				Пока ДетальнаяВыборка.Следующий() Цикл
					ИмяРеквизита = СоответствиеКолонок[ДетальнаяВыборка.ВидАналитики];
					ТекСтрока[ИмяРеквизита] = ДетальнаяВыборка.Значение;
				КонецЦикла;
					
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
	//Данные текущего документа
	СтрокаДопРеквизитов = СтрСоединить(КолонкиДопРеквизитов,",");
			
	СтруктураДопРеквизитов = Новый Структура;
	Для Каждого ТекДопРеквизит Из КолонкиДопРеквизитов Цикл
		СтруктураДопРеквизитов.Вставить(ТекДопРеквизит,ЭтотОбъект["_"+ТекДопРеквизит]);
	КонецЦикла;
	
	Если КодыПоказателей.Количество()
		ИЛИ КолонкиАналитики.Количество() Тогда
		Если ТаблицаРаскрытия <> Неопределено Тогда
			СтрокаПоказателей = СтрСоединить(КодыПоказателей,",");
			СтрокаАналитики = СтрСоединить(КолонкиАналитики,",");
			
			Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
				НовСтр = ТабДляОбработки.Добавить();
				
				Если ЗначениеЗаполнено(СтрокаПоказателей) Тогда
					ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ,СтрокаПоказателей);
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаАналитики) Тогда
					ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ,СтрокаАналитики);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаДопРеквизитов) Тогда
					ЗаполнитьЗначенияСвойств(НовСтр,СтруктураДопРеквизитов,СтрокаДопРеквизитов);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СтрокаДопРеквизитов) Тогда
			НовСтр = ТабДляОбработки.Добавить();
		    ЗаполнитьЗначенияСвойств(НовСтр,СтруктураДопРеквизитов,СтрокаДопРеквизитов);
		КонецЕсли;
	КонецЕсли;
	
	
	ТекИменаКолонок = СтрСоединить(МассивИменКолонокИстории,",");
	ТабДляОбработки.Индексы.Очистить();
	ТабДляОбработки.Колонки.Удалить("ДокСсылка");
	ТабДляОбработки.Колонки.Удалить("Индекс");
		
	ТабДляОбработки.Свернуть(ТекИменаКолонок);
	
	ТабДляОбработки.Сортировать(ТекИменаКолонок);
	
	//могут быть пустые строки (одна)
	МассивСтрокПустых = Новый Массив;
	Для Каждого СтрТЧ Из ТабДляОбработки Цикл
		СтрокаПустая = Истина;
		Для Каждого ТекКол Из ТабДляОбработки.Колонки Цикл
			Если ЗначениеЗаполнено(СтрТЧ[ТекКол.Имя]) Тогда
				СтрокаПустая = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПустая Тогда
			МассивСтрокПустых.Добавить(СтрТЧ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивСтрокПустых Цикл
		ТабДляОбработки.Удалить(ЭлМас);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТабДляОбработки,"ТаблицаИстория");

	ИменаКолонокТабИст = Новый ФиксированныйМассив(МассивИменКолонокИстории);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементТаблицыИстории(Знач ИмяРеквизита, СоответствиеРеквизитов,мСоответствиеКолонокАналитики)
		
	ИмяРеквизитаДанныеФормыКоллекция = "ТаблицаИстория";
		
	ТекРодитель = Элементы.ТаблицаИстория;
	
	СтрСвязанногоРеквизита = СоответствиеРеквизитов[ИмяРеквизита];
	
	ЭтоАналитика = Ложь;
	ГруппироватьВЯчейке = Ложь;//для аналитики с типом Субконто выводится код и ссылка (наименование)
			
	Если СтрСвязанногоРеквизита.ВидИсточника = 4 //"Аналитика группы раскрытия"
		ИЛИ СтрСвязанногоРеквизита.ВидИсточника = 3 Тогда//"Дополнительный реквизит" Тогда
		
		ЭтоАналитика = Истина;
		
		Если ТипЗнч(СтрСвязанногоРеквизита.Значение) = Тип("СправочникСсылка.Субконто") Тогда
			ГруппироватьВЯчейке = Истина;
		КонецЕсли;
		
		Если ГруппироватьВЯчейке Тогда
			ТекРодитель = Элементы.Добавить(ИмяРеквизитаДанныеФормыКоллекция + ИмяРеквизита+"_Группа", Тип("ГруппаФормы"),Элементы.ТаблицаИстория);
			ТекРодитель.Группировка = ГруппировкаКолонок.ВЯчейке;
			ТекРодитель.ОтображатьВШапке = Истина;
			ТекРодитель.Заголовок = ?(ЗначениеЗаполнено(СтрСвязанногоРеквизита.Наименование),СтрСвязанногоРеквизита.Наименование,ИмяРеквизита);
		
			//т.к. представление справочник субконто - наименование, то добавим код
			ЭлементРеквизита					= Элементы.Добавить(ИмяРеквизитаДанныеФормыКоллекция + ИмяРеквизита+"_Код", Тип("ПолеФормы"),ТекРодитель);
			ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ИмяРеквизита+".Код";
			ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
			ЭлементРеквизита.Заголовок			= ?(ЗначениеЗаполнено(СтрСвязанногоРеквизита.Наименование),СтрСвязанногоРеквизита.Наименование,ИмяРеквизита)+ "(Код)"; 
		    ЭлементРеквизита.ОтображатьВШапке   = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементРеквизита					= Элементы.Добавить(ИмяРеквизитаДанныеФормыКоллекция + ИмяРеквизита, Тип("ПолеФормы"),ТекРодитель);
	ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ИмяРеквизита;
	ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
	ЭлементРеквизита.КнопкаСоздания		= Ложь;
	ЭлементРеквизита.ОтображатьВШапке 	= (ГруппироватьВЯчейке = Ложь);
					
	Если ЭтоАналитика Тогда
		
		мСоответствиеКолонокАналитики.Вставить(СтрСвязанногоРеквизита.ВидАналитики,ИмяРеквизита);
		
	Иначе
		ЭлементРеквизита.РасширенноеРедактирование = Истина;
		ЭлементРеквизита.МногострочныйРежим = Истина;
		
	КонецЕсли;
		
КонецПроцедуры



&НаСервере
Функция ПоместитьЗначенияРеквизитов()

	ТаблицаРеквизитов = РеквизитФормыВЗначение("СвязанныеРеквизиты").Скопировать(,"ИмяРеквизита,ВидИсточника,Значение,ВидКлассификатораБК");
	Для Каждого Стр Из ТаблицаРеквизитов Цикл
		Стр.Значение = ЭтаФорма["_"+Стр.ИмяРеквизита];
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаРеквизитов);

КонецФункции // ПоместитьЗначенияРеквизитов()


#КонецОбласти






