&НаКлиенте
Процедура ВыбранныеПоляОтбораВидСравненияПриИзменении(Элемент)
	УстановитьТипЗначенияОтбора(Элементы.ВыбранныеПоляОтбора.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляОтбораВидСравненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные 	  = Элементы.ВыбранныеПоляОтбора.ТекущиеДанные;
	НайденныеПоля = ВсеПоля.НайтиСтроки(Новый Структура("ИмяПоля",ТекДанные.ИмяПоля));
	
	Если НайденныеПоля.Количество() = 0 Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ОписаниеПоля = НайденныеПоля[0];
	
	ДоступныеВидыСравнения = Новый СписокЗначений;
	ДоступныеВидыСравнения.Добавить(ВидСравнения.Равно);
	ДоступныеВидыСравнения.Добавить(ВидСравнения.ВСписке);
	ДоступныеВидыСравнения.Добавить(ВидСравнения.НеРавно);
	ДоступныеВидыСравнения.Добавить(ВидСравнения.НеВСписке);
	
	Если ОписаниеПоля.ТипДанных.СодержитТип(Тип("Строка")) Тогда
		ДоступныеВидыСравнения.Добавить(ВидСравнения.Содержит);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.НеСодержит);
	ИначеЕсли ОписаниеПоля.ТипДанных.СодержитТип(Тип("Число")) или ОписаниеПоля.ТипДанных.СодержитТип(Тип("Дата")) Тогда
		ДоступныеВидыСравнения.Добавить(ВидСравнения.Больше);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.БольшеИлиРавно);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.Меньше);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.МеньшеИлиРавно);
	ИначеЕсли ЗначениеЗаполнено(ОписаниеПоля.ВидАналитики) Тогда
		ДоступныеВидыСравнения.Добавить(ВидСравнения.ВИерархии);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.ВСпискеПоИерархии);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.НеВИерархии);
		ДоступныеВидыСравнения.Добавить(ВидСравнения.НеВСпискеПоИерархии);
	КонецЕсли;
	
	ДанныеВыбора = ДоступныеВидыСравнения;
	
КонецПроцедуры


