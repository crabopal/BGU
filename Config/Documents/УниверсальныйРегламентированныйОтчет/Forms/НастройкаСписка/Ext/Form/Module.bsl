	ДанныеВыбора = Новый СписокЗначений;
	
	Для Каждого СтрДоступных Из ДоступныеПоляОтбора Цикл
		Если ВРЕГ(Лев(СтрДоступных.ПредставлениеПоля,ДлинаТекста)) = ВРЕГ(Текст) Тогда
			ДанныеВыбора.Добавить(СтрДоступных.ИмяПоля,СтрДоступных.ПредставлениеПоля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляОтбораПредставлениеПоляОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные 		 = Элементы.ВыбранныеПоляОтбора.ТекущиеДанные;
	
	Стр 							= ДоступныеПоляОтбора.НайтиСтроки(Новый Структура("ИмяПоля",ВыбранноеЗначение))[0];
	ТекущиеДанные.ИмяПоля 			= Стр.ИмяПоля;
	ТекущиеДанные.ПредставлениеПоля = Стр.ПредставлениеПоля;
	
	УстановитьТипЗначенияОтбора(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляОтбораПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если Не (НоваяСтрока и ОтменаРедактирования) и Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.ИмяПоля) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(,НСтр("ru = 'Не указано имя поля!'"));
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

