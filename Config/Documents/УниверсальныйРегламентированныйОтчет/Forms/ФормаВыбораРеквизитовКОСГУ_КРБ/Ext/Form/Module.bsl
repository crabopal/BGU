&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ОтборПоПараметруБланка = Истина Тогда
		ДобавитьКнопкуОтборПоПараметруБланка();
		Если ЗначениеЗаполнено(Параметры.Отбор.Код) Тогда
			УстановитьОтборПоКоду(Параметры.Отбор.Код);
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Параметры.НаДату) Тогда
		НаДату = ЭтаФорма.Параметры.НаДату;
	КонецЕсли;
	
	УстановитьОтборНаДату();
	
КонецПроцедуры

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	УстановитьОтборНаДату();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборНаДату()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокКРБ.Отбор, "ДатаНачалаДействия", НаДату, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, , ЗначениеЗаполнено(НаДату));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокКРБ.Отбор, "ДатаОкончанияДействия", НаДату, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(НаДату));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоКоду(КодОтбор)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокКОСГУ.Отбор, "Код", КодОтбор, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокКРБ.Отбор, "Код", КодОтбор, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	Элементы.СписокКРБ.Отображение = ОтображениеТаблицы.Список;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначение(Команда)
	
	ОбработатьВыбор();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКОСГУВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработатьВыбор();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКРБВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработатьВыбор();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыбор()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.КОСГУ Тогда
		ВыбЗнач = ЭтаФорма.Элементы.СписокКОСГУ.ТекущаяСтрока;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ВидРасходовКРБ Тогда	
		ВыбЗнач = ЭтаФорма.Элементы.СписокКРБ.ТекущаяСтрока;
	КонецЕсли;
	ОповеститьОВыборе(ВыбЗнач);
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКнопкуОтборПоПараметруБланка()
	
	КомандаОтборПоПараметруБланка = ЭтаФорма.Команды.Добавить("ОтборПоПараметруБланка");
	КомандаОтборПоПараметруБланка.Действие = "ОтборПоПараметруБланка_Подключаемый";
	КомандаОтборПоПараметруБланка.Подсказка = "Отбор по параметру бланка";
	
	КнопкаОтборПоПараметруБланка = Элементы.Добавить("КнопкаОтборПоПараметруБланка",Тип("КнопкаФормы"),ЭтаФорма.КоманднаяПанель);
	КнопкаОтборПоПараметруБланка.Заголовок = "Отбор по параметру бланка";
	КнопкаОтборПоПараметруБланка.Картинка = БиблиотекаКартинок.ОтборКомпоновкиДанных;
	КнопкаОтборПоПараметруБланка.Отображение = ОтображениеКнопки.Картинка;
	КнопкаОтборПоПараметруБланка.ИмяКоманды = "ОтборПоПараметруБланка";
	КнопкаОтборПоПараметруБланка.Пометка = Истина;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтборПоПараметруБланка_Подключаемый()
	
	КнопкаОтборПоПараметруБланка = Элементы.Найти("КнопкаОтборПоПараметруБланка");
	Если НЕ КнопкаОтборПоПараметруБланка = Неопределено Тогда
		КнопкаОтборПоПараметруБланка.Пометка = НЕ КнопкаОтборПоПараметруБланка.Пометка;
		Для каждого ЭлементОтбора Из СписокКОСГУ.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
		Если КнопкаОтборПоПараметруБланка.Пометка Тогда
			Элементы.СписокКРБ.Отображение = ОтображениеТаблицы.Список;
		Иначе	
			Элементы.СписокКРБ.Отображение = ОтображениеТаблицы.Дерево;
		КонецЕсли;
		Для каждого ЭлементОтбора Из СписокКРБ.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти