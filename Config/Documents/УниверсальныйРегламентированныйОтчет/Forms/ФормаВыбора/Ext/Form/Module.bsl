////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ОтборОрганизация;
	
	Элементы.ГруппаВыбранныеОтчеты.Видимость = Параметры.МножественныйВыборДокументов;
	
	Если НЕ Параметры.Отбор.Свойство("ПериодОтчета") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПериодОтчета", Неопределено, ВидСравненияКомпоновкиДанных.Равно,,Ложь,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"ПериодОтчета");	
	КонецЕсли;	

	Если НЕ Параметры.Отбор.Свойство("Организация") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию(), ВидСравненияКомпоновкиДанных.Равно,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"Организация");
	КонецЕсли;	

	
	Если ЗначениеЗаполнено(Параметры.КодВидаОтчета) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВидыОтчетов.Ссылка
			|ИЗ
			|	Справочник.ВидыОтчетов КАК ВидыОтчетов
			|ГДЕ
			|	ВидыОтчетов.ЭтоГруппа = ЛОЖЬ
			|	И ВидыОтчетов.Код В(&Код)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДополнительныеРеквизитыОтчетов.ВидАналитики КАК ВидАналитики
			|ИЗ
			|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
			|ГДЕ
			|	ДополнительныеРеквизитыОтчетов.Владелец.Код В(&Код)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВидАналитики";
			
		Запрос.УстановитьПараметр("Код", Параметры.КодВидаОтчета);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		ВидыОтчетов = РезультатыЗапроса[0].Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		Если ВидыОтчетов.Количество() = 1 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ВидОтчета", ВидыОтчетов[0], ВидСравненияКомпоновкиДанных.Равно,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"ВидОтчета");
		ИначеЕсли ВидыОтчетов.Количество()>1 Тогда
			СписокВидов = Новый СписокЗначений;
			СписокВидов.ЗагрузитьЗначения(ВидыОтчетов);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ВидОтчета", СписокВидов, ВидСравненияКомпоновкиДанных.ВСписке,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"ВидОтчета");
		КонецЕсли;
		
		ТаблицаДопРеквизитов.Очистить();
		ВыборкаАналитики = РезультатыЗапроса[1].Выбрать();
		Пока ВыборкаАналитики.Следующий() Цикл
			НовСтр = ТаблицаДопРеквизитов.Добавить();
			НовСтр.ВидАналитики = ВыборкаАналитики.ВидАналитики;
		КонецЦикла;
	КонецЕсли;
	
	ПравилоЗаполнения = Неопределено;
	Если Параметры.Свойство("ПравилоЗаполнения",ПравилоЗаполнения) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПравилаЗаполненияОбщиеПараметры.ИмяПараметра,
			|	ПравилаЗаполненияОбщиеПараметры.ВидАналитики
			|ИЗ
			|	Справочник.ПравилаЗаполнения.ОбщиеПараметры КАК ПравилаЗаполненияОбщиеПараметры
			|ГДЕ
			|	ПравилаЗаполненияОбщиеПараметры.Ссылка = &Ссылка
			|	И ПравилаЗаполненияОбщиеПараметры.ПользовательскаяДоступность = ИСТИНА";
		
		Запрос.УстановитьПараметр("Ссылка", ПравилоЗаполнения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		СтруктураПараметровПравила = Новый Структура;
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.ВидАналитики) Тогда
				Продолжить;
			КонецЕсли;
			СтруктураПараметровПравила.Вставить(Выборка.ИмяПараметра,Выборка.ВидАналитики);
		КонецЦикла;
	
		Для Каждого КлючИЗначение Из Параметры.СтруктураПараметров Цикл
			ТекВидАналитики = Неопределено;
			Если КлючИЗначение.Ключ = "Организация" Тогда
				ОтборОрг = КлючИЗначение.Значение;
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", ОтборОрг, ВидСравненияКомпоновкиДанных.Равно,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"Организация");
			КонецЕсли;
			Если СтруктураПараметровПравила.Свойство(КлючИЗначение.Ключ,ТекВидАналитики) Тогда
				МассивСтрок = ТаблицаДопРеквизитов.НайтиСтроки(Новый Структура("ВидАналитики",ТекВидАналитики));
				Если МассивСтрок.Количество()>0 Тогда
					МассивСтрок[0].Значение = КлючИЗначение.Значение;
					МассивСтрок[0].Использовать = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
	
	УстановитьОтборПоДопРеквизитам();
	
	Если Параметры.ВыбранныеОтчеты <> Неопределено Тогда
		Для Каждого ТекОтчет Из Параметры.ВыбранныеОтчеты Цикл
			ДобавитьОтчет(ТекОтчет.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Параметры.МножественныйВыборДокументов = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ДобавитьОтчет(ВыбраннаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	Если НЕ Параметры.МножественныйВыборДокументов Тогда
		Возврат;		
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	МассивОтчетов = Новый Массив;
	ЗаполнитьМассивОтчетов(МассивОтчетов);
	ОповеститьОВыборе(МассивОтчетов);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхОтчетовРегОтчетОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхОтчетовРегОтчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#Область ОтборДополнительныеРеквизиты


&НаКлиенте
Процедура ТаблицаДопРеквизитовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДопРеквизиты",Истина);
	ОткрытьФорму("ПланВидовХарактеристик.АналитикаОтчетов.Форма.ФормаВыбора",ПараметрыФормы,Элемент);	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДопРеквизитовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаДопРеквизитов.НайтиСтроки(Новый Структура("ВидАналитики",ВыбранноеЗначение)).Количество() = 0 Тогда
		НовСтр = ТаблицаДопРеквизитов.Добавить();
		НовСтр.ВидАналитики = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДопРеквизитовЗначениеПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаДопРеквизитов.ТекущиеДанные;
	ТекДанные.Использовать = Истина;
	УстановитьОтборПоДопРеквизитам();	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоДопРеквизитам()
	
	МассивПодходящих = Неопределено;
	СписокПодходящих = Новый СписокЗначений;
	Инд = 1;	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыОтчетов.Ссылка КАК ВидОтчета
		|ПОМЕСТИТЬ НужныеВидыОтчетов
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	%1%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТабДок.ЭкземплярОтчета КАК ЭкземплярОтчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТДок.Ссылка КАК ЭкземплярОтчета
		|	ИЗ
		|		Документ.УниверсальныйРегламентированныйОтчет КАК ТДок
		|	ГДЕ
		|		ТДок.ВидОтчета В
		|				(ВЫБРАТЬ
		|					ТТ.ВидОтчета
		|				ИЗ
		|					НужныеВидыОтчетов КАК ТТ)) КАК ТабДок
		|ГДЕ
		|	%2%";
		
	ТекстОтборВО = "";
	ТекстОтбор = "";
	
	ЕстьОтборДопреквизитов = ТаблицаДопРеквизитов.НайтиСтроки(Новый Структура("Использовать",Истина)).Количество()>0;
	Для Каждого СтрТЧ Из ТаблицаДопРеквизитов Цикл
		Если СтрТЧ.Использовать = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОтбор=ТекстОтбор+"И Истина 
			|	В (Выбрать Первые 1 Истина
			|		ИЗ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК Т1
			|		Где Т1.ЭкземплярОтчета = ТабДок.ЭкземплярОтчета
			|			И Т1.ВидАналитики = &ВидАналитики"+Инд+"
			|			И Т1.Значение = &Значение"+Инд+")
			|";
			
		ТекстОтборВО=ТекстОтборВО+"И Истина 
			|	В (Выбрать Первые 1 Истина
			|		ИЗ Справочник.ДополнительныеРеквизитыОтчетов КАК ТД
			|		Где ТД.Владелец = ВидыОтчетов.Ссылка
			|			И ТД.ВидАналитики = &ВидАналитики"+Инд+")
			|";
			
			
		Запрос.УстановитьПараметр("ВидАналитики"+Инд,СтрТЧ.ВидАналитики);
		Запрос.УстановитьПараметр("Значение"+Инд,СтрТЧ.Значение);
		Инд = Инд + 1;
	КонецЦикла;
	Если ЕстьОтборДопреквизитов Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%1%",Сред(ТекстОтборВО,3));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%2%",Сред(ТекстОтбор,3));

		Запрос.Текст = ТекстЗапроса;
		Результат = Запрос.Выполнить();
		МассивПодходящих = Результат.Выгрузить().ВыгрузитьКолонку("ЭкземплярОтчета");
		
		СписокПодходящих.ЗагрузитьЗначения(МассивПодходящих);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Ссылка",СписокПодходящих,ВидСравненияКомпоновкиДанных.ВСписке,"ОтборДопРеквизитов",МассивПодходящих <> Неопределено,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДопРеквизитовИспользоватьПриИзменении(Элемент)
	УстановитьОтборПоДопРеквизитам();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДопРеквизитовПослеУдаления(Элемент)
	УстановитьОтборПоДопРеквизитам();
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервере
Процедура ДобавитьОтчет(ВыбранныйОтчет)
	Если ТаблицаВыбранныхОтчетов.НайтиСтроки(Новый Структура("РегОтчет",ВыбранныйОтчет)).Количество() = 0 Тогда
		НовСтр = ТаблицаВыбранныхОтчетов.Добавить();
		НовСтр.РегОтчет = ВыбранныйОтчет;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМассивОтчетов(МассивОтчетов)
	МассивОтчетов = ТаблицаВыбранныхОтчетов.Выгрузить().ВыгрузитьКолонку("РегОтчет");	
КонецПроцедуры

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти
