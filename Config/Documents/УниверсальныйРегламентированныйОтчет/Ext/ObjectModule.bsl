Функция ТабличныйДокументРасшифровкиСпискаОтчетов(МассивОтчетов,МассивПоказателей,СтруктураАналитикОтбора = Неопределено) Экспорт
	
	// Подготовка макета
	ТабДокРасшифровки = Новый ТабличныйДокумент;
	
	ДанныеРасшифровки = Новый Массив;
	
	Макет = ПолучитьМакет("МакетРасшифровки");
	
	ТабДокРасшифровки.Вывести(Макет.ПолучитьОбласть("ЗаголовокРасшифровкиЭкземпляров"));
	
	ОбластьШапкиТаблицы 	= Макет.ПолучитьОбласть("ШапкаТаблицыЭкземпляров|ОбластьБоковик");
	ОбластьШапкиПоказатель  = Макет.ПолучитьОбласть("ШапкаТаблицыЭкземпляров|КолонкаПоказатель");
	
	ТабДокРасшифровки.Вывести(ОбластьШапкиТаблицы);
	
	// Запрос по структуре показателей
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоказателиОтчетов.Наименование,
	|	ПоказателиОтчетов.Код
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Владелец В
	|			(ВЫБРАТЬ
	|				УниверсальныйРегламентированныйОтчет.ВидОтчета
	|			ИЗ
	|				Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|			ГДЕ
	|				УниверсальныйРегламентированныйОтчет.Ссылка = &Ссылка)
	|	И ПоказателиОтчетов.Код В(&КодыПоказателей)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоказателиОтчетов.Колонка.ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("Ссылка"			,МассивОтчетов[0]);
	Запрос.УстановитьПараметр("КодыПоказателей" ,МассивПоказателей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивПоказателей.Очистить(); // Порядок показателей будет изменен
	
	Пока Выборка.Следующий() Цикл
		МассивПоказателей.Добавить(СокрП(Выборка.Код));
		
		ОбластьШапкиПоказатель.Параметры.ИмяПоказателя = Выборка.Наименование;
		ТабДокРасшифровки.Присоединить(ОбластьШапкиПоказатель);
		
	КонецЦикла;
	
	ОбластьСтрокаТаблицы    = Макет.ПолучитьОбласть("СтрокаТаблицыЭкземпляров|ОбластьБоковик");
	ОбластьСтрокаПоказатель = Макет.ПолучитьОбласть("СтрокаТаблицыЭкземпляров|КолонкаПоказатель");
	
	Для Каждого Отчет ИЗ МассивОтчетов Цикл
		
		Если Не Отчет = Ссылка Тогда
			ОтчетОбъект = Отчет.ПолучитьОбъект();
			ОтчетОбъект.ИнициализироватьКонтекст();
		Иначе
			ОтчетОбъект = ЭтотОбъект;
			ОтчетОбъект.ПроверитьКонтекстИнициализирован();
		КонецЕсли;
		
		ОбластьСтрокаТаблицы.Параметры.ЭкземплярОтчетаОписание =ОтчетОбъект.ВернутьПредставлениеЭкземпляраОтчета();
		
		РасшифровкаВсехЗначений = Новый Структура;
		РасшифровкаВсехЗначений.Вставить("Регистратор"		,Отчет);
		РасшифровкаВсехЗначений.Вставить("Показатель" 		,МассивПоказателей);
		РасшифровкаВсехЗначений.Вставить("ОтборПоАналитике" ,СтруктураАналитикОтбора);
		
		ОбластьСтрокаТаблицы.Параметры.РасшифровкаВсехЗначений = РасшифровкаВсехЗначений;
		ТабДокРасшифровки.Вывести(ОбластьСтрокаТаблицы);
		
		// Присоединение колонок
		
		Если Не СтруктураАналитикОтбора = Неопределено Тогда
			СтруктураОтбораИзКонтекста = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(СтруктураАналитикОтбора);
		КонецЕсли;
		
		Для Каждого КодПоказателя Из МассивПоказателей Цикл
			
			Если СтруктураАналитикОтбора = Неопределено Тогда
				Значение = Неопределено;
				ОтчетОбъект.Показатели.Свойство(КодПоказателя,Значение);
			Иначе
				
				СуммаПоказателя = 0;
				СтрПоказатель = ОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
				Если СтрПоказатель = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если не ЗначениеЗаполнено(СтрПоказатель.Ссылка.ГруппаРаскрытия) Тогда 
					
					Значение = Неопределено;
					ОтчетОбъект.Показатели.Свойство(КодПоказателя,Значение);
					
				Иначе 	
					
					СтруктураОтбораИзКонтекста.Вставить("Показатель",СтрПоказатель.Ссылка);
					Результат  = РезультатЗапросаПоТаблицеЗначений(ОтчетОбъект.мПоказателиРаскрытия,СтруктураОтбораИзКонтекста,"Значение");
					ВыборкаПок = Результат.Выбрать();
					
					Пока ВыборкаПок.Следующий() Цикл
						СуммаПоказателя = СуммаПоказателя + ВыборкаПок.Значение;
					КонецЦикла;
					
					Значение = СуммаПоказателя;
					
				КонецЕсли;
			КонецЕсли;
			
			ТекУровень = ЭтотОбъект.УровеньТочности;
			СтрПоказатель = ОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
			Если СтрПоказатель <> Неопределено Тогда			
				Если СтрПоказатель.ИндивидуальнаяТочность
					И СтрПоказатель.УровеньТочностиПоказателя <> ЭтотОбъект.УровеньТочности Тогда
					ТекУровень = СтрПоказатель.УровеньТочностиПоказателя;
				КонецЕсли;
			КонецЕсли;
			
			РасшифровкаЗначения = Новый Структура;
			РасшифровкаЗначения.Вставить("Регистратор"		,Отчет);
			РасшифровкаЗначения.Вставить("Показатель" 		,КодПоказателя);
			РасшифровкаЗначения.Вставить("ОтборПоАналитике" ,СтруктураАналитикОтбора);
			
			Индекс = ДанныеРасшифровки.Количество();
			ОбластьСтрокаПоказатель.Параметры.РасшифровкаЗначения = Индекс;
			ДанныеРасшифровки.Добавить(РасшифровкаЗначения);
			ОбластьСтрокаПоказатель.Параметры.Значение			  = Значение;
			ОбластьСтрокаПоказатель.Область(1,1).Формат			  = "ЧДЦ=" + ТекУровень;
			
			ТабДокРасшифровки.Присоединить(ОбластьСтрокаПоказатель);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ТабличныйДокумент",ТабДокРасшифровки);
	Результат.Вставить("ДанныеРасшифровки",ДанныеРасшифровки);
	
	Возврат Результат;

КонецФункции // ТабличныйДокументРасшифровкиСпискаОтчетов()

Функция СобратьДанныеДляРасшифровки(СтрОперанд, СтруктураАналитикОтбора = Неопределено, Регистратор = Неопределено) Экспорт

	ПостроительРасшифровка=Новый ПостроительЗапроса;
	
	ИспользуетсяОперанд = ТипЗнч(СтрОперанд) =  Тип("СправочникСсылка.ОперандыПоказателей");
	
	Если Не ИспользуетсяОперанд и СтрОперанд.ФлагОшибки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Регистратор = Неопределено Тогда // Режим первичной расшифровки по операнду
		Список=Новый СписокЗначений;
		Список.Добавить(СтрОперанд);
		СтруктураОперанд=Новый Структура;
		СтруктураОперанд.Вставить("СписокОперандов",Список);
					
		Если ИспользуетсяОперанд Тогда
				
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчетаОтбор,
				|	ОперандыПоказателей.ВключатьПромежуточныеИтоги,
				|	ОперандыПоказателей.ПравилаИспользованияПолейЗапроса.(
				|		Поле,
				|		АналитикаОперанда,
				|		КодАналитики
				|	)
				|ИЗ
				|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
				|ГДЕ
				|	ОперандыПоказателей.Ссылка = &Операнд
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра,
				|	ОперандыПоказателейПравилаВычисленияПараметров.ПредставлениеПараметра,
				|	ОперандыПоказателейПравилаВычисленияПараметров.СпособВычисленияПараметра,
				|	ОперандыПоказателейПравилаВычисленияПараметров.УточнениеСпособаОпределения,
				|	ОперандыПоказателейПравилаВычисленияПараметров.ЗначениеДляПроверки,
				|	ОперандыПоказателейПравилаВычисленияПараметров.ТипРасчета,
				|	ОперандыПоказателейПравилаВычисленияПараметров.ВидАналитикиОтбор,
				|	ОперандыПоказателейПравилаВычисленияПараметров.РеквизитАналитики
				|ИЗ
				|	РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
				|ГДЕ
				|	ОперандыПоказателейПравилаВычисленияПараметров.Операнд = &Операнд";

			Запрос.УстановитьПараметр("Операнд", СтрОперанд);

			РезультатыЗапроса = Запрос.ВыполнитьПакет();

			ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();

			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				СтруктураОперанд.Вставить("ВидОтчетаОтбор",ВыборкаДетальныеЗаписи.ВидОтчетаОтбор);
				СтруктураОперанд.Вставить("ЕстьРаскрытиеПоАналитике",Ложь);
				СтруктураОперанд.Вставить("ВключатьПромежуточныеИтоги",ВыборкаДетальныеЗаписи.ВключатьПромежуточныеИтоги);
				ПравилаИспользованияПолей = ВыборкаДетальныеЗаписи.ПравилаИспользованияПолейЗапроса.Выгрузить();
			КонецЕсли;
			
			ПравилаВычисленияПараметровЗапроса = РезультатыЗапроса[1].Выгрузить();
			ТекТаблПравилВычисления = ПравилаВычисленияПараметровЗапроса.СкопироватьКолонки();
							
			Для Каждого Строка Из ПравилаВычисленияПараметровЗапроса Цикл
				ЗаполнитьЗначенияСвойств(ТекТаблПравилВычисления.Добавить(), Строка);
			КонецЦикла;
						
			Если СтруктураАналитикОтбора <> Неопределено Тогда
				 
				УдаляемыеЭлементы = Новый Массив;
				Для Каждого ЭлементОтбора Из СтруктураАналитикОтбора Цикл
					
					СтрПоле = ПравилаИспользованияПолей.Найти(ЭлементОтбора.Ключ,"КодАналитики");
					Если СтрПоле = Неопределено Тогда
						УдаляемыеЭлементы.Добавить(ЭлементОтбора.Ключ);
					Иначе
						СтруктураАналитикОтбора.Вставить(СтрПоле.Поле,ЭлементОтбора.Значение);
						УдаляемыеЭлементы.Добавить(ЭлементОтбора.Ключ);
					КонецЕсли;
					
				КонецЦикла;
				
				Для Каждого Имя Из УдаляемыеЭлементы Цикл
					СтруктураАналитикОтбора.Удалить(Имя);
				КонецЦикла;
				
			КонецЕсли;
			
			СтруктураОперанд.Вставить("ПравилаВычисленияПараметров",ТекТаблПравилВычисления);
			СтруктураОперанд.Вставить("ПравилаИспользованияПолей"  ,ПравилаИспользованияПолей);
		Иначе
			СтруктураОперанд.Вставить("ВидОтчетаОтбор",СтрОперанд.ВидОтчетаОтбор);
			СтруктураОперанд.Вставить("ЕстьРаскрытиеПоАналитике",Ложь);
			СтруктураОперанд.Вставить("ВключатьПромежуточныеИтоги",СтрОперанд.ВключатьПромежуточныеИтоги);
			СтруктураОперанд.Вставить("ПравилаВычисленияПараметров"	,СтрОперанд.ПравилаВычисленияПараметровЗапроса);
			СтруктураОперанд.Вставить("ПравилаИспользованияПолей"	,СтрОперанд.ПравилаИспользованияПолейЗапроса);
		КонецЕсли;
		
		Запрос = ПодготовитьЗапросВнутрПоказатель(СтруктураОперанд);
		Если Запрос = Неопределено Тогда
			Сообщить("Расшифровка невозможна. Ошибка в настройке операндов показателей",СтатусСообщения.Внимание);
			Возврат Неопределено;
		КонецЕсли;
		
		МассивОтчетов=Запрос.Параметры.СписокЭкземпляров;
	Иначе
		МассивОтчетов = Новый Массив;
		МассивОтчетов.Добавить(Регистратор);
	КонецЕсли;
	
	МассивПоказателей=Новый Массив;
	
	Если ИспользуетсяОперанд Тогда
		МассивПоказателей.Добавить(СокрЛП(СтрОперанд.ПоказательОтбор.Код));
	Иначе
		МассивПоказателей.Добавить(СокрЛП(СтрОперанд.ПоказательОтборКод));
	КонецЕсли;
	
	Показатель = СтрОперанд.ПоказательОтбор.Ссылка;
	ГруппаРаскрытия = Показатель.ГруппаРаскрытия;
	
	Для Каждого СтрПараметр ИЗ СтруктураОперанд.ПравилаВычисленияПараметров Цикл
		
		Если Лев(СтрПараметр.ИмяПараметра,9)="Аналитика" И ЗначениеЗаполнено(СтрПараметр.ВидСравнения) Тогда
			
			Если СтруктураАналитикОтбора = Неопределено Тогда
				СтруктураАналитикОтбора = Новый Структура;
			КонецЕсли;
			
			Если Не СтруктураАналитикОтбора.Свойство(СтрПараметр.ИмяПараметра) Тогда
				СтруктураАналитикОтбора.Вставить(СтрПараметр.ИмяПараметра, Новый Структура("ВидСравнения, Значение", СтрПараметр.ВидСравнения, СтрПараметр.ЗначениеИзКонтекста));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("МассивОтчетов,МассивПоказателей,СтруктураАналитикОтбора",МассивОтчетов,МассивПоказателей,СтруктураАналитикОтбора);

КонецФункции // СобратьДанныеДляРасшифровки()

///////////////////////////////////////////////////////////////////////////////////////
// РАБОТА С ВНУТРЕННИМИ ДАННЫМИ КОНТЕКСТА ОТЧЕТА
//

Процедура СинхронизироватьВнутренниеДанныеОбъектов(ОбъектПриемник) Экспорт

	СписокСвойств = ПолучитьВнутренниеСвойства();
	ОбъектПриемник.ЗагрузитьВнутренниеСвойства(СписокСвойств);
	
КонецПроцедуры

Процедура ЗагрузитьВнутренниеСвойства(СтруктураСвойств) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект,СтруктураСвойств);
	
	Если СтруктураСвойств.мВнутренниеДанныеРасчетовИзменены <> Неопределено Тогда
		ЗаписатьДанныеРасчетов(СтруктураСвойств.мВнутренниеДанныеРасчетов);
		УстановитьПризнакИзмененияДанныхРасчета(СтруктураСвойств.мВнутренниеДанныеРасчетовИзменены);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьВнутренниеСвойства() Экспорт

	СписокСвойств = Новый Структура;
	СписокСвойств.Вставить("мПоказатели");
	СписокСвойств.Вставить("мПоказателиРаскрытия");
	СписокСвойств.Вставить("мДополнительныеРеквизиты");
	СписокСвойств.Вставить("мТабРасшифровкиПоказателей");
	СписокСвойств.Вставить("мПоказателиСтар");
	СписокСвойств.Вставить("мЧислоДопАналитик");
	СписокСвойств.Вставить("РежимДиалога");
	СписокСвойств.Вставить("СписокСообщений");
	СписокСвойств.Вставить("ЛогСообщений");
	СписокСвойств.Вставить("ТабОбластиРаскрытия");
	СписокСвойств.Вставить("мНастройкиБланка");
	СписокСвойств.Вставить("Показатели");
	СписокСвойств.Вставить("Параметры");
	СписокСвойств.Вставить("ДополнительныеРеквизиты");
	СписокСвойств.Вставить("ИзмененныеПоказатели");
	
	СписокСвойств.Вставить("СтруктураДанныхВТаблицахИтогов");
	
	//для пересчета показателей
	СписокСвойств.Вставить("мПоказателиДляОбработки");
	СписокСвойств.Вставить("мДеревоПересчета");
	СписокСвойств.Вставить("мМассивДополнительныхПоказателейДляВычисления");
	СписокСвойств.Вставить("ДанныеПараметрикиАктуальны");
		
	ЗаполнитьЗначенияСвойств(СписокСвойств,ЭтотОбъект); // Экспортные свойства
	
	// не экспортные свойства
	Если Не ВнутренниеДанныеРасчетаИзменены() = Неопределено Тогда
		СписокСвойств.Вставить("мВнутренниеДанныеРасчетовИзменены",Вычислить("мВнутренниеДанныеРасчетовИзменены"));
		СписокСвойств.Вставить("мВнутренниеДанныеРасчетов"        ,Вычислить("мВнутренниеДанныеРасчетов"));
	Иначе
		СписокСвойств.Вставить("мВнутренниеДанныеРасчетовИзменены",Неопределено);
		СписокСвойств.Вставить("мВнутренниеДанныеРасчетов"        ,Неопределено);
	КонецЕсли;
	
	Возврат СписокСвойств;

КонецФункции // ПолучитьВнутренниеСвойства()


// Функция определяет абсолютное значение числа (Значение по модулю). 
//
Функция Abs(Значение) Экспорт

	Возврат ?(Значение >= 0, Значение, Значение * (-1));

КонецФункции // Abs()

// Заполняет настройки отчета из регламента.
//
Функция ЗаполнитьНастройкиОтчета() Экспорт

	СтруктураНастроек = БюджетнаяОтчетность.ПолучитьНастройкиОтчета(ВидОтчета,ПериодОтчета,Организация);
	Если Не СтруктураНастроек = Неопределено Тогда
		
		ШаблонОтчета     = СтруктураНастроек.БланкДляОтображения;
		ПравилоОбработки = СтруктураНастроек.ПравилоОбработки;
		ПравилоПроверки  = СтруктураНастроек.ПравилоПроверки;
		ОсновнойПечатныйБланк = СтруктураНастроек.БланкДляПечати;
		БланкОтчета		 = ШаблонОтчета;
		
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЗаполнитьНастройкиОтчета()

Функция ВнутренниеДанныеРасчетаИзменены() Экспорт

	Возврат мВнутренниеДанныеРасчетовИзменены;

КонецФункции // ВнутренниеДанныеРасчетаИзменены()

Функция УстановитьПризнакИзмененияДанныхРасчета(Знач Признак)

	мВнутренниеДанныеРасчетовИзменены = Признак;

КонецФункции // УстановитьПризнакИзмененияДанныхРасчета()


// Считывает данные, хранимые в регистре ДанныеРасчетовПоказателей
//
Функция ПолучитьДанныеРасчетов() Экспорт

	Если ВнутренниеДанныеРасчетаИзменены() = Неопределено Тогда	
		
		Если мКопирование = Истина И ЗначениеЗаполнено(мДокументОснование) Тогда 
			мВнутренниеДанныеРасчетов = ПрочитатьДанныеРасчетов(мДокументОснование);
			Если ТипЗнч(мВнутренниеДанныеРасчетов) = Тип("Структура") Тогда
				//удалим сохраненные настройки заполнения
				Для Каждого КлючИЗначение Из мВнутренниеДанныеРасчетов Цикл
					Если КлючИЗначение.Ключ = "ТаблицаРасшифровки" Тогда
						Продолжить;
					Иначе
						мВнутренниеДанныеРасчетов.Удалить(КлючИЗначение.Ключ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			УстановитьПризнакИзмененияДанныхРасчета(Истина);
			
		Иначе 	
			мВнутренниеДанныеРасчетов = ПрочитатьДанныеРасчетов(Ссылка);
			УстановитьПризнакИзмененияДанныхРасчета(Ложь);

		КонецЕсли;
		
	КонецЕсли;

	Возврат мВнутренниеДанныеРасчетов;
	
КонецФункции // ПолучитьДанныеРасчетов()

Функция ПрочитатьДанныеРасчетов(СсылкаОтчетаДляЧтения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеРасчетовПоказателей.ДанныеРасчетов
	|ИЗ
	|	РегистрСведений.ДанныеРасчетовПоказателей КАК ДанныеРасчетовПоказателей
	|ГДЕ
	|	ДанныеРасчетовПоказателей.ЭкземплярОтчета = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",СсылкаОтчетаДляЧтения);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	Возврат РезультатЗапроса.Выгрузить()[0].ДанныеРасчетов.Получить();   	
	
КонецФункции

Процедура СохранитьДанныеРасчетовМеждуВызовамиСервера(Знач АдресХранилища) Экспорт

	Если Не ВнутренниеДанныеРасчетаИзменены() = Неопределено Тогда
		ПоместитьВоВременноеХранилище(ПолучитьДанныеРасчетов(), АдресХранилища);
	КонецЕсли;

КонецПроцедуры // СохранитьДанныеРасчетовМеждуВызовамиСервера()

Процедура ВосстановитьДанныеРасчетовИзХранилища(Знач АдресХранилища) Экспорт

	Если Не ВнутренниеДанныеРасчетаИзменены() = Неопределено Тогда
		ДанныеРасчетов = ПолучитьИзВременногоХранилища(АдресХранилища);
		ЗаписатьДанныеРасчетов(ДанныеРасчетов);
	КонецЕсли;

КонецПроцедуры

// Переносит значения из структуры ДополнительныеРеквизиты в таблицу мДополнительныеРеквизиты.
//
Процедура ПеренестиЗначенияИзДополнительныеРеквизиты() Экспорт
	
	Для Каждого СтрРеквизит Из мДополнительныеРеквизиты Цикл
		
		Значение = Неопределено;
		Если ДополнительныеРеквизиты.Свойство(СокрП(СтрРеквизит.Код),Значение) Тогда
			СтрРеквизит.Значение = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Вспомогательная функция
//
Функция ПолучитьТаблицуДанныхРасшифровки() Экспорт
	Возврат Документы.УниверсальныйРегламентированныйОтчет.СоздатьТаблицуДанныхРасшифровки();
КонецФункции // ПолучитьТаблицуДанныхРасшифровки()

// Вспомогательная функция
//
Функция ПолучитьОпцииРасшифровкиДляСтандартногоОтчета(ИмяОтчета) Экспорт
