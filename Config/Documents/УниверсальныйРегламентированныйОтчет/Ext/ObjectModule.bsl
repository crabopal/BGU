Функция ЕстьГруппаРаскрытия(ТекВидОтчета)
	
	Если мСоответствиеВидовОтчетов[ТекВидОтчета] = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГруппыРаскрытия.Ссылка
			|ИЗ
			|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
			|ГДЕ
			|	ГруппыРаскрытия.Владелец = &ТекВидОтчета";
		
		Запрос.УстановитьПараметр("ТекВидОтчета", ТекВидОтчета);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		мСоответствиеВидовОтчетов.Вставить(ТекВидОтчета, НЕ РезультатЗапроса.Пустой());
		
	КонецЕсли;
	
	Возврат мСоответствиеВидовОтчетов[ТекВидОтчета];
КонецФункции

Функция СравнитьТаблицыВычисленияПараметровОперандов(Знач ТаблицаВычисления1, Знач ТаблицаВычисления2) Экспорт
	
	//Таблицы уже отсортированы, в них нет не используемых отборов, количество записей одинаковое
	
	СравнениеСписков = Новый СравнениеЗначений;
	ТипСтруктура = Тип("Структура");
	ТипСписокЗначений = Тип("СписокЗначений");
	
	МассивПроверяемыхСтрокПоЗначению = Новый Массив;
	//Проверим сначала простые колонки - имя параметра и способ сравнения
	Для Индекс=0 По ТаблицаВычисления1.Количество()-1 Цикл
		Стр1 = ТаблицаВычисления1[Индекс];
		Стр2 = ТаблицаВычисления2[Индекс];
		Если Стр1.ИмяПараметра <> Стр2.ИмяПараметра Тогда
			Возврат Ложь;
		ИначеЕсли Стр1.СпособВычисленияПараметра <> Стр2.СпособВычисленияПараметра Тогда
			Возврат Ложь;
		ИначеЕсли МассивСравненийБезПроверки.Найти(Стр1.СпособВычисленияПараметра) = Неопределено Тогда
			МассивПроверяемыхСтрокПоЗначению.Добавить(Индекс);				
		КонецЕсли;	
	КонецЦикла;
	
	//И только если имя параметра и способ сравнения одинаковые - сравним по УточнениеСпособаОпределения
	Для Каждого ЭлМас Из МассивПроверяемыхСтрокПоЗначению Цикл
		Стр1 = ТаблицаВычисления1[ЭлМас];
		Стр2 = ТаблицаВычисления2[ЭлМас];
		ЗначениеДляПроверки1=Стр1.УточнениеСпособаОпределения.Получить();
		ЗначениеДляПроверки2=Стр2.УточнениеСпособаОпределения.Получить();
		
		ТипЗначенияДляПроверки = ТипЗнч(ЗначениеДляПроверки1);
		
		Если ТипЗначенияДляПроверки = ТипСтруктура Тогда			
			Если Не СравнитьСтруктурыЗначений(ЗначениеДляПроверки1,ЗначениеДляПроверки2) Тогда				
				Возврат Ложь;				
			КонецЕсли;			
		ИначеЕсли ТипЗначенияДляПроверки = ТипСписокЗначений Тогда			
			Если СравнениеСписков.Сравнить(ЗначениеДляПроверки1,ЗначениеДляПроверки2)<>0 Тогда				
				Возврат Ложь;				
			КонецЕсли;			
		ИначеЕсли ЗначениеДляПроверки1<>ЗначениеДляПроверки2 Тогда			
			Возврат Ложь;		
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // СравнитьТаблицыВычисленияПараметров()

// Сравнивает две структуры, возвращает Истина, если значения структур равны.
//
Функция СравнитьСтруктурыЗначений(Структура1, Структура2)
	
	Если НЕ ТипЗнч(Структура1)=ТипЗнч(Структура2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Структура1.Количество()=Структура1.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Элемент ИЗ Структура1 Цикл
		
		Если Не Структура2.Свойство(Элемент.Ключ) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ ТипЗнч(Элемент.Значение)=ТипЗнч(Структура2[Элемент.Ключ]) Тогда
			Возврат Ложь;
		ИначеЕсли ТипЗнч(Элемент.Значение)=Тип("Структура") И (НЕ СравнитьСтруктурыЗначений(Элемент.Значение,Структура2[Элемент.Ключ])) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ Элемент.Значение=Структура2[Элемент.Ключ] Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //  СравнитьСтруктурыЗначений() 

Процедура ЗаполнитьПереченьСтроковыхАналитикПриНеобходимости()
	Если мСоответствиеСтроковыхБК = Неопределено Тогда
		мСоответствиеСтроковыхБК = БюджетнаяОтчетность.ПолучитьВидыАналитикиСТипомСтрока();
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьФормулуКС(Формула,ТекстОшибки) Экспорт
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Попытка
		ТекРезультат = Неопределено;
		РезультатПроверки = Вычислить("ТекРезультат = "+Формула);	
	Исключение
		ТекстОшибки = НСтр("ru='В формуле контрольного соотношения ошибка: %1'");
		
		ТекстОписания = ОписаниеОшибки();
		//обрежем лишнее
		ПозицияНачалаПодробнойИнформации = СтрНайти(ТекстОписания,"}:");
		Если ПозицияНачалаПодробнойИнформации > 0 Тогда
			ТекстОписания = Сред(ТекстОписания,ПозицияНачалаПодробнойИнформации+2);
		КонецЕсли;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекстОписания);
	КонецПопытки;

КонецПроцедуры


