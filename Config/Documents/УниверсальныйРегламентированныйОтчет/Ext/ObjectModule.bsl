			Выполнить(СтрокаПараметр.УточнениеСпособаОпределения.Получить());
			
			СвойстваПараметра.ВидСравнения = ?(ТипЗнч(ЗначениеПараметра) = Тип("СписокЗначений") Или ТипЗнч(ЗначениеПараметра) = Тип("Массив"),
				ВидСравнения.ВСписке, ВидСравнения.Равно);
