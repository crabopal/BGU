// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ВИЗУАЛЬНЫМ ПРЕДСТАВЛЕНИЕМ ОТЧЕТА


// Заполняет области, связанные с показателями и параметрами отчета, их значениями.
//
Процедура ЗаполнитьМакет(Макет, ТаблицаПоказателей = Неопределено) Экспорт
	
	// заполняем показатели в макете
	ЗаполнитьПоказателиВМакете(Макет, ТаблицаПоказателей, (ТаблицаПоказателей <> Неопределено));
	
	// формируем структуру параметров
	СформироватьСтруктуруПараметров();
	
	// заполняем дополнительные реквизиты в макете
	ЗаполнитьРеквизитыВМакете(Макет);
	
	//Итоги по группам раскрытия
	ЗаполнитьТаблицыРаскрытияИтогов(Макет);	
КонецПроцедуры

// Заполняет области макета, связанные с показателями, значениями соответствующих показателей из
// таблицы показателей отчета.
//
Процедура ЗаполнитьПоказателиВМакете(Макет, Знач ПоказателиОтчета = Неопределено, Знач ЗаполнитьВсеПринудительно = Ложь) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если ПоказателиОтчета = Неопределено Тогда
		ПоказателиОтчета = мПоказатели;
	ИначеЕсли ТипЗнч(ПоказателиОтчета) = Тип("Массив") 
		И ПоказателиОтчета.Количество() > 0 
		И ТипЗнч(ПоказателиОтчета[0]) = Тип("Строка") Тогда
		
		Строки = Новый Массив;
		Для Каждого КодПоказателя Из ПоказателиОтчета Цикл
			СтрПок = мПоказатели.Найти(КодПоказателя,"Код");
			Если Не СтрПок = Неопределено Тогда
				Строки.Добавить(СтрПок);
			КонецЕсли;
		КонецЦикла;
		
		ПоказателиОтчета =мПоказатели.Скопировать(Строки);
		ПоказателиОтчета.Индексы.Добавить("Код");
		
	КонецЕсли;
	
	КвалификаторЧисла = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	
	Корректировка 	= КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности;
	ДлинаЦелойЧасти = КвалификаторЧисла.Разрядность - Корректировка;
	
	ОписаниеТиповОбщее = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(ДлинаЦелойЧасти, УровеньТочности));
	
	Области = Макет.Области;
	Делитель=ВернутьЗначениеДелителя();
	СоответствиеФорматСтрока = Новый Соответствие;
	СоответствиеФорматСписок = Новый Соответствие;
	СоответствиеФорматСтрокаНеМ = Новый Соответствие;
		
	Если ЗаполнитьВсеПринудительно Тогда
		Для Каждого Стр Из ПоказателиОтчета Цикл
			ЗаполнитьПоказательВМакете(Области, Стр, СоответствиеФорматСтрока,СоответствиеФорматСписок,СоответствиеФорматСтрокаНеМ,Делитель,ОписаниеТиповОбщее,КвалификаторЧисла);
		КонецЦикла;
		
	Иначе

		Если ИзмененныеПоказатели.Количество()>ПоказателиОтчета.Количество() Тогда
			//При постраничном выводе количество показателей на странице меньше, чем всего показателей,
			//поэтому обойдем все показатели отчета
			Для Каждого Стр Из ПоказателиОтчета Цикл			
				Если ИзмененныеПоказатели[Стр.Код] = Ложь Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьПоказательВМакете(Области, Стр, СоответствиеФорматСтрока,СоответствиеФорматСписок,СоответствиеФорматСтрокаНеМ,Делитель,ОписаниеТиповОбщее,КвалификаторЧисла);
			КонецЦикла;
		Иначе
		
			Для Каждого КлючИЗначение Из ИзмененныеПоказатели Цикл
				Если КлючИЗначение.Значение = Ложь Тогда
					Продолжить;
				КонецЕсли;
				Стр = ПоказателиОтчета.Найти(КлючИЗначение.Ключ,"Код");
				Если Стр<> Неопределено Тогда
					ЗаполнитьПоказательВМакете(Области, Стр, СоответствиеФорматСтрока,СоответствиеФорматСписок,СоответствиеФорматСтрокаНеМ,Делитель,ОписаниеТиповОбщее,КвалификаторЧисла);
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПоказателиБезМакета(ТекМакет, ИзмененияПоказателей, Знач ПоказателиОтчета = Неопределено, Знач ЗаполнитьВсеПринудительно = Ложь) Экспорт
		
	//Данная процедура - для пересчета показателей, например, при редактировании бланка.
	//По макету страницы находятся области, значения в которых нужно будет изменить в отображаемом бланке.
	//Имена областей и их значения - возвращаются назад, на клиент, и уже на клиенте заполняются данные бланка.
	//То есть это упрощенная процедура, для уменьшения трафика и времени.
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если ПоказателиОтчета = Неопределено Тогда
		ПоказателиОтчета = мПоказатели;
	ИначеЕсли ТипЗнч(ПоказателиОтчета) = Тип("Массив") 
		И ПоказателиОтчета.Количество() > 0 
		И ТипЗнч(ПоказателиОтчета[0]) = Тип("Строка") Тогда
		
		Строки = Новый Массив;
		Для Каждого КодПоказателя Из ПоказателиОтчета Цикл
			СтрПок = мПоказатели.Найти(КодПоказателя,"Код");
			Если Не СтрПок = Неопределено Тогда
				Строки.Добавить(СтрПок);
			КонецЕсли;
		КонецЦикла;
		
		//ПоказателиОтчета = Строки;
		ПоказателиОтчета =мПоказатели.Скопировать(Строки);
		ПоказателиОтчета.Индексы.Добавить("Код");
		
	КонецЕсли;
			
	Области = ТекМакет.Области;
	Делитель = ВернутьЗначениеДелителя();
	
	МассивОбработанных = Новый Массив;
	
	Если ЗаполнитьВсеПринудительно Тогда
		Для Каждого Стр Из ПоказателиОтчета Цикл
			ЗаполнитьПоказательБезМакета(ИзмененияПоказателей, Области, Стр, Делитель);
		КонецЦикла;
		
	Иначе
		СоответствиеИзмененныхКодов = Новый Соответствие;//содержит перечень показателей, которые изменились
		Если ИзмененныеПоказатели.Количество()>ПоказателиОтчета.Количество() Тогда
			//При постраничном выводе количество показателей на странице меньше, чем всего показателей,
			//поэтому обойдем все показатели отчета
			Для Каждого Стр Из ПоказателиОтчета Цикл			
				Если ИзмененныеПоказатели[Стр.Код] = Ложь Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьПоказательБезМакета(ИзмененияПоказателей, Области, Стр, Делитель);
				СоответствиеИзмененныхКодов.Вставить(ВРег(Стр.Код),Истина);
			КонецЦикла;
		Иначе
		
			Для Каждого КлючИЗначение Из ИзмененныеПоказатели Цикл
				Если КлючИЗначение.Значение = Ложь Тогда
					Продолжить;
				КонецЕсли;
				Стр = ПоказателиОтчета.Найти(КлючИЗначение.Ключ,"Код");
				Если Стр<> Неопределено Тогда
					ЗаполнитьПоказательБезМакета(ИзмененияПоказателей, Области, Стр, Делитель);
					СоответствиеИзмененныхКодов.Вставить(ВРег(Стр.Код),Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//тут изменяется оформление показателей без раскрытия - для тех, значение которых не изменялось, то которые зависят от измененных
		СтрокиНастроекОформления = мНастройкиБланка.НайтиСтроки(Новый Структура("ЕстьУсловноеОформлениеБланка,ЕстьИспользуемыеНастройкиУОБланка,ЕстьДругиеПоказателиВУсловииУО",Истина,Истина,Истина));
		Для Каждого СтрОформления Из СтрокиНастроекОформления Цикл
			Если СоответствиеИзмененныхКодов[СтрОформления.ИмяЯчейки] = Истина Тогда
				//показатель обработан, оформление применилось
				Продолжить;
			КонецЕсли;
			
			ПараметрыУсловногоОформления = СтрОформления.СтруктураНастроек.ПараметрыУсловногоОформления;
			
			СтрокаПоказателя = мПоказатели.Найти(СтрОформления.ИмяЯчейки,"Код");
			Если СтрокаПоказателя = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Обл = Области.Найти(СтрокаПоказателя.Код);
				
			Если Обл <> Неопределено 
				И Обл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		       			
				НужноПрименитьОформление = Ложь;
				//проверим, что в строке данного оформления используется показатель из перечня измененных
							
				Для Каждого КлючИЗначение Из СоответствиеИзмененныхКодов Цикл
					Если ПараметрыУсловногоОформления.СоответствиеИспользуемыхИмен[КлючИЗначение.Ключ] = Истина Тогда					
						НужноПрименитьОформление = Истина;
						//СоответствиеИзмененныхКодов.Вставить(СтрОформления.ИмяЯчейки,Истина);
						Прервать;
					КонецЕсли;
				КонецЦикла;				
				
				Если НужноПрименитьОформление Тогда
														
		            ТекНастройкаУО = РассчитатьУсловноеОформлениеЯчейки(СтрокаПоказателя.Значение, Неопределено,ПараметрыУсловногоОформления);
					
					СтруктураЗначенийПоказателя = Новый Структура;
					Если ТекНастройкаУО.МеняетсяЦветФона Тогда
						СтруктураЗначенийПоказателя.Вставить("ЦветФона",ТекНастройкаУО.ТекЦветФона);
					КонецЕсли;
					
					Если ТекНастройкаУО.МеняетсяЦветТекста Тогда
						СтруктураЗначенийПоказателя.Вставить("ЦветТекста",ТекНастройкаУО.ТекЦветТекста);
					КонецЕсли;
					
					Если ТекНастройкаУО.МеняетсяШрифт Тогда
						СтруктураЗначенийПоказателя.Вставить("Шрифт",Новый Шрифт(Обл.Шрифт,,,ТекНастройкаУО.ТекПолужирный,ТекНастройкаУО.ТекНаклонный,,ТекНастройкаУО.ТекЗачеркивание));
					КонецЕсли;
					Если СтруктураЗначенийПоказателя.Количество() Тогда
						ИзмененияПоказателей.Вставить(СтрокаПоказателя.Код,СтруктураЗначенийПоказателя);	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПоказательБезМакета(ИзмененияПоказателей,Области, Стр, Делитель)
	
	//Данная процедура - для пересчета показателей, например, при редактировании бланка.
	//По макету страницы находятся области, значения в которых нужно будет изменить в отображаемом бланке.
	//Имена областей и их значения - возвращаются назад, на клиент, и уже на клиенте заполняются данные бланка.
	//То есть это упрощенная процедура, для уменьшения трафика и времени.
	
	Обл = Области.Найти(Стр.Код);
	
	СтруктураЗначенийПоказателя = Новый Структура;
	
	Если Обл <> Неопределено 
		И Обл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		
		НастройкаОбласти = мНастройкиБланка.Найти(Обл.Имя,"ИмяЯчейки");
		
		Значение = Стр.Значение;
		Если ЗначениеЗаполнено(НастройкаОбласти) Тогда
			Если НастройкаОбласти.ЕстьУсловноеОформлениеБланка
				И НастройкаОбласти.ЕстьИспользуемыеНастройкиУОБланка Тогда
								
				ПараметрыУсловногоОформления = НастройкаОбласти.СтруктураНастроек.ПараметрыУсловногоОформления;
				
	            ТекНастройкаУО = РассчитатьУсловноеОформлениеЯчейки(Значение, Неопределено,ПараметрыУсловногоОформления);

				Если ТекНастройкаУО.МеняетсяЦветФона Тогда
					СтруктураЗначенийПоказателя.Вставить("ЦветФона",ТекНастройкаУО.ТекЦветФона);
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяЦветТекста Тогда
					СтруктураЗначенийПоказателя.Вставить("ЦветТекста",ТекНастройкаУО.ТекЦветТекста);
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяШрифт Тогда
					СтруктураЗначенийПоказателя.Вставить("Шрифт",Новый Шрифт(Обл.Шрифт,,,ТекНастройкаУО.ТекПолужирный,ТекНастройкаУО.ТекНаклонный,,ТекНастройкаУО.ТекЗачеркивание));
				КонецЕсли;
				
			КонецЕсли;
					 
			Если НастройкаОбласти.ЕстьПредставление Тогда
				Попытка
					Значение = Вычислить(НастройкаОбласти.СтруктураНастроек.Представление);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если Стр.Отключен Тогда
			
			//Ничего не делаем
			
		ИначеЕсли Стр.ТипЗначения = ТипЗначенияЧисло 
			И Не Стр.НеФинансовый Тогда
			
			Если Стр.Значение = Неопределено Тогда
				Стр.Значение = 0; //Приведение типа в таблице мПоказатели
			КонецЕсли;
			
			Если НЕ Стр.НеМасштабируется И Делитель<>1 Тогда
				
				СтруктураЗначенийПоказателя.Вставить("Значение",Стр.Значение / Делитель);
				
			Иначе
				СтруктураЗначенийПоказателя.Вставить("Значение",Стр.Значение);
				
			КонецЕсли;
			
		ИначеЕсли Обл.СодержитЗначение Тогда
			
			СтруктураЗначенийПоказателя.Вставить("Значение",Значение);
			
		Иначе
			СтруктураЗначенийПоказателя.Вставить("Текст",Значение);
		КонецЕсли;
						
		ИзмененныеПоказатели[Стр.Код]=Ложь;
		
	КонецЕсли;
	
	ИзмененияПоказателей.Вставить(Стр.Код,СтруктураЗначенийПоказателя);
			
КонецПроцедуры

Процедура ЗаполнитьРеквизитыБезМакета(Макет,ИзмененияПоказателей) Экспорт
	
	//Данная процедура - для пересчета показателей, например, при редактировании бланка.
	//По макету страницы находятся области, значения в которых нужно будет изменить в отображаемом бланке.
	//Имена областей и их значения - возвращаются назад, на клиент, и уже на клиенте заполняются данные бланка.
	//То есть это упрощенная процедура, для уменьшения трафика (между клиеном и сервером) и времени.
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	// заполнение реквизитов в макете
	Для Каждого Стр Из ДополнительныеРеквизиты Цикл
		ТекОбл = Макет.Области.Найти(Стр.Ключ);
		Если ТекОбл <> Неопределено 
			И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			И ТекОбл.СодержитЗначение = Истина Тогда
			
			СтруктураЗначений = Новый Структура;
			СтруктураЗначений.Вставить("Значение",Стр.Значение);
			СтруктураЗначений.Вставить("Расшифровка",Стр.Значение);
			
			ИзмененияПоказателей.Вставить(Стр.Ключ,СтруктураЗначений);
			
		КонецЕсли;
	КонецЦикла;
	
	// заполнение параметров в макете
	Для Каждого Стр Из Параметры Цикл
		ТекОбл = Макет.Области.Найти(Стр.Ключ);
		Если ТекОбл <> Неопределено 
			И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			И ТекОбл.СодержитЗначение = Истина Тогда
			
			СтруктураЗначений = Новый Структура;
			СтруктураЗначений.Вставить("Значение",Стр.Значение);
			Если Стр.Значение <> Неопределено Тогда
				СтруктураЗначений.Вставить("Расшифровка",Стр.Значение);
			Иначе
				СтруктураЗначений.Вставить("Расшифровка",Истина);//если расшифровка будет Неопределено, то курсор на бланке не будет спец.значком
			КонецЕсли;
						
			ИзмененияПоказателей.Вставить(Стр.Ключ,СтруктураЗначений);		
			
		КонецЕсли;
	КонецЦикла;
	
	// Заполнение вычисляемых ячеек
	СтрокиПредставлений = мНастройкиБланка.НайтиСтроки(Новый Структура("ЕстьПредставление",Истина));
	Для Каждого Стр Из СтрокиПредставлений Цикл
		
		ТекОбл = Макет.Области.Найти(Стр.ИмяЯчейки);
		
		Если ТекОбл = Неопределено Тогда
			Попытка // Это может быть стандартное имя
				ТекОбл = Макет.Область(Стр.ИмяЯчейки);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Если ТекОбл <> Неопределено 
			И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			И ТекОбл.СодержитЗначение = Истина Тогда
			
			СтруктураЗначений = Новый Структура;
			
			Формула = Стр.СтруктураНастроек.Представление;
			Попытка
				ТекЗначение = Вычислить(Формула);				
				СтруктураЗначений.Вставить("Значение",ТекЗначение);
			Исключение
				// ошибка в формуле специальным образом не обрабатывается.
			КонецПопытки;
			
			Если Стр.ЕстьСвязанныеРеквизиты Тогда
				СтруктураЗначений.Вставить("Расшифровка",Истина);
			КонецЕсли;
			
			Если СтруктураЗначений.Количество() Тогда
				ИзмененияПоказателей.Вставить(Стр.ИмяЯчейки,СтруктураЗначений);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоказательВМакете(Области, Стр, СоответствиеФорматСтрока,СоответствиеФорматСписок,СоответствиеФорматСтрокаНеМ,Делитель,ОписаниеТиповОбщее,КвалификаторЧисла)
	
	Обл = Области.Найти(Стр.Код);
	
	Если Обл <> Неопределено 
		И Обл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		
		НастройкаОбласти = мНастройкиБланка.Найти(Обл.Имя,"ИмяЯчейки");
		
		Значение = Стр.Значение;
		
		Если ЗначениеЗаполнено(НастройкаОбласти) Тогда
			
			Если НастройкаОбласти.ЕстьУсловноеОформлениеБланка
				И НастройкаОбласти.ЕстьИспользуемыеНастройкиУОБланка Тогда
				
				ПараметрыУсловногоОформления = НастройкаОбласти.СтруктураНастроек.ПараметрыУсловногоОформления;
				
                ТекНастройкаУО = РассчитатьУсловноеОформлениеЯчейки(Значение, Неопределено,ПараметрыУсловногоОформления);

				Если ТекНастройкаУО.МеняетсяЦветФона Тогда
					Обл.ЦветФона = ТекНастройкаУО.ТекЦветФона;
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяЦветТекста Тогда
					Обл.ЦветТекста = ТекНастройкаУО.ТекЦветТекста;
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяШрифт Тогда
					Обл.Шрифт = Новый Шрифт(Обл.Шрифт,,,ТекНастройкаУО.ТекПолужирный,ТекНастройкаУО.ТекНаклонный,,ТекНастройкаУО.ТекЗачеркивание);
				КонецЕсли;
				
			КонецЕсли;
			
			Если НастройкаОбласти.ЕстьПредставление Тогда
				Попытка
					Значение = Вычислить(НастройкаОбласти.СтруктураНастроек.Представление);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если Стр.Отключен Тогда
			
			Обл.Защита = Истина;
			
		ИначеЕсли Стр.ТипЗначения = ТипЗначенияЧисло Тогда
			
			Если Стр.Значение = Неопределено Тогда
				Стр.Значение = 0; //Приведение типа в таблице мПоказатели
			КонецЕсли;
			
			Если Стр.ИндивидуальнаяТочность Тогда
				//индивидуальная точность устанавливается для всех, а общая только для финансовых
				Если УровеньТочности <> Стр.УровеньТочностиПоказателя Тогда
					КорректировкаП 	= КвалификаторЧисла.РазрядностьДробнойЧасти - Стр.УровеньТочностиПоказателя;
					ДлинаЦелойЧастиП = КвалификаторЧисла.Разрядность - КорректировкаП;

					ОписаниеТиповП = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(ДлинаЦелойЧастиП, Стр.УровеньТочностиПоказателя));
					
					Обл.ТипЗначения = ОписаниеТиповП;
					
					ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
					Если ПолученныйРанееСписок = Неопределено Тогда
						ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
						ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
						СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
					КонецЕсли;
					СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
					СписокФорматов.Вставить("ЧДЦ", Строка(Стр.УровеньТочностиПоказателя));
					
					Если НЕ Стр.НеМасштабируется Тогда
						СписокФорматов.Вставить("ЧС", 0);
						Обл.Значение = Стр.Значение / Делитель;
					Иначе
						Обл.Значение = Стр.Значение;
					КонецЕсли;
					
					Обл.Формат     = ПреобразоватьВСтрокуФормата(СписокФорматов);
					
				Иначе
					Обл.ТипЗначения = ОписаниеТиповОбщее;
					
					Если НЕ Стр.НеМасштабируется Тогда
						УстанавливаемыйФормат = СоответствиеФорматСтрока[Обл.Формат];
					Иначе
						УстанавливаемыйФормат = СоответствиеФорматСтрокаНеМ[Обл.Формат];
					КонецЕсли;
					
					Если УстанавливаемыйФормат = Неопределено Тогда
						ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
						Если ПолученныйРанееСписок = Неопределено Тогда
							ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
							ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
							СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
						КонецЕсли;
						
						СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
						
						Если НЕ Стр.НеМасштабируется Тогда
							СписокФорматов.Вставить("ЧС", 0);
							УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
							СоответствиеФорматСтрока.Вставить(Обл.Формат,УстанавливаемыйФормат);
						Иначе
							УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
							СоответствиеФорматСтрокаНеМ.Вставить(Обл.Формат,УстанавливаемыйФормат);
						КонецЕсли;				
					КонецЕсли;
					
					Если НЕ Стр.НеМасштабируется И Делитель<>1 Тогда
						Обл.Значение = Стр.Значение / Делитель;
					Иначе
						Обл.Значение = Стр.Значение;
					КонецЕсли;
					
					Обл.Формат		= УстанавливаемыйФормат;
				КонецЕсли;
			Иначе
				Если Не Стр.НеФинансовый Тогда
					Обл.ТипЗначения = ОписаниеТиповОбщее;
					
					Если НЕ Стр.НеМасштабируется Тогда
						УстанавливаемыйФормат = СоответствиеФорматСтрока[Обл.Формат];
					Иначе
						УстанавливаемыйФормат = СоответствиеФорматСтрокаНеМ[Обл.Формат];
					КонецЕсли;
					
					Если УстанавливаемыйФормат = Неопределено Тогда
						ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
						Если ПолученныйРанееСписок = Неопределено Тогда
							ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
							ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
							СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
						КонецЕсли;
						
						СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
						
						Если НЕ Стр.НеМасштабируется Тогда
							СписокФорматов.Вставить("ЧС", 0);
							УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
							СоответствиеФорматСтрока.Вставить(Обл.Формат,УстанавливаемыйФормат);
						Иначе
							УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
							СоответствиеФорматСтрокаНеМ.Вставить(Обл.Формат,УстанавливаемыйФормат);
						КонецЕсли;				
					КонецЕсли;
					
					Если НЕ Стр.НеМасштабируется И Делитель<>1 Тогда
						Обл.Значение = Стр.Значение / Делитель;
					Иначе
						Обл.Значение = Стр.Значение;
					КонецЕсли;
					
					Обл.Формат		= УстанавливаемыйФормат;
				Иначе
					Обл.Значение = Значение;	
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Обл.СодержитЗначение Тогда
			Если Стр.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка 
				И НЕ Стр.НеограниченнаяДлина Тогда
				Обл.ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150);
			КонецЕсли;
			Обл.Значение = Значение;
		Иначе
			Обл.Текст	 = Значение;
		КонецЕсли;
						
		ИзмененныеПоказатели[Стр.Код]=Ложь;
	КонецЕсли;
			
КонецПроцедуры

Функция РассчитатьУсловноеОформлениеЯчейки(Знач Значение, Знач Стр, Знач ПараметрыУсловногоОформления)
	
	Перем ВыполнениеУсловия, ИзмененЦветТекста, ИзмененЦветФона, ИзмененШрифт, Инд, СтрокаНастройкиПоУмолчанию, ТекСтрокаОформаления;	
	
	ТаблицаОформления = ПараметрыУсловногоОформления.ТаблицаУсловноеОформление;
	
	СтрокаНастройкиПоУмолчанию = Неопределено;
	МеняетсяЦветФона = Ложь;
	МеняетсяЦветТекста = Ложь;
	МеняетсяШрифт = Ложь;
	
	ТекЦветФона = Неопределено;
	ТекЦветТекста = Неопределено;
	ТекПолужирный = Ложь;
	ТекНаклонный = Ложь;
	ТекЗачеркивание = Ложь;
	
	ИзмененЦветФона = Ложь;
	ИзмененЦветТекста = Ложь;
	ИзмененШрифт = Ложь;
	
	Для Инд = 0 По ТаблицаОформления.Количество()-1 Цикл
		
		ТекСтрокаОформаления = ТаблицаОформления[Инд];				
		
		Если ТекСтрокаОформаления.Отключить Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрокаОформаления.НастройкаПоУмолчанию Тогда
			СтрокаНастройкиПоУмолчанию = ТекСтрокаОформаления;
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрокаОформаления.ИзменятьЦветФона Тогда
			МеняетсяЦветФона = Истина;
		КонецЕсли;
		
		Если ТекСтрокаОформаления.ИзменятьЦветТекста Тогда
			МеняетсяЦветТекста = Истина;
		КонецЕсли;
		
		Если ТекСтрокаОформаления.ИзменятьШрифт Тогда
			МеняетсяШрифт = Истина;
		КонецЕсли;
		
		ВыполнениеУсловия = Ложь;
		Попытка
			ТекущаяСтрока = Стр;
			ВыполнениеУсловия = Вычислить(ТекСтрокаОформаления.Условие);
		Исключение
			ВыполнениеУсловия = Ложь;
		КонецПопытки;
		
		Если ВыполнениеУсловия = Истина Тогда
			
			Если ТекСтрокаОформаления.ИзменятьЦветФона Тогда
				ТекЦветФона = ТекСтрокаОформаления.ЦветФона;
				ИзмененЦветФона = Истина;
			КонецЕсли;
			
			Если ТекСтрокаОформаления.ИзменятьЦветТекста Тогда
				ТекЦветТекста = ТекСтрокаОформаления.ЦветТекста;
				ИзмененЦветТекста = Истина;
			КонецЕсли;
			
			Если ТекСтрокаОформаления.ИзменятьШрифт Тогда
				ТекПолужирный = ТекСтрокаОформаления.ШрифтПолужирный;
				ТекНаклонный = ТекСтрокаОформаления.ШрифтНаклонный;
				ТекЗачеркивание = ТекСтрокаОформаления.ШрифтЗачеркивание;
				ИзмененШрифт = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокаНастройкиПоУмолчанию<>Неопределено Тогда
		//если в настройках оформления задается, что цвет фона(цвет текста/шрифт) может меняться, 
		//но при расчете он не был изменен, то берем значение из настройки по умолчанию
		Если МеняетсяЦветФона
			И ИзмененЦветФона = Ложь Тогда
			ТекЦветФона = СтрокаНастройкиПоУмолчанию.ЦветФона;
		КонецЕсли;
		Если МеняетсяЦветТекста
			И ИзмененЦветТекста = Ложь Тогда
			ТекЦветТекста = СтрокаНастройкиПоУмолчанию.ЦветТекста;
		КонецЕсли;
		Если МеняетсяШрифт
			И ИзмененШрифт = Ложь Тогда
			ТекПолужирный = СтрокаНастройкиПоУмолчанию.ШрифтПолужирный;
			ТекНаклонный = СтрокаНастройкиПоУмолчанию.ШрифтНаклонный;
			ТекЗачеркивание = СтрокаНастройкиПоУмолчанию.ШрифтЗачеркивание;
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяНастройкаУО = Новый Структура("МеняетсяЦветТекста, МеняетсяЦветФона, МеняетсяШрифт, ТекЗачеркивание, ТекНаклонный, ТекПолужирный, ТекЦветТекста, ТекЦветФона",
										МеняетсяЦветТекста, МеняетсяЦветФона, МеняетсяШрифт, ТекЗачеркивание, ТекНаклонный, ТекПолужирный, ТекЦветТекста, ТекЦветФона);
	Возврат ТекущаяНастройкаУО;
	
КонецФункции

Процедура ЗаполнитьРеквизитыВМакете(Макет) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	// заполнение реквизитов в макете
	Для Каждого Стр Из ДополнительныеРеквизиты Цикл
		ТекОбл = Макет.Области.Найти(Стр.Ключ);
		Если ТекОбл <> Неопределено И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник И ТекОбл.СодержитЗначение = Истина Тогда
			ТекОбл.Значение 	= Стр.Значение;
			ТекОбл.Расшифровка 	= Стр.Значение;
		КонецЕсли;
	КонецЦикла;
	
	// заполнение параметров в макете
	Для Каждого Стр Из Параметры Цикл
		ТекОбл = Макет.Области.Найти(Стр.Ключ);
		Если ТекОбл <> Неопределено И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник И ТекОбл.СодержитЗначение = Истина Тогда
			ТекОбл.Значение 	= Стр.Значение;
			Если Стр.Значение <> Неопределено Тогда
				ТекОбл.Расшифровка = Стр.Значение;
			Иначе
				ТекОбл.Расшифровка = ТекОбл.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Заполнение вычисляемых ячеек
	СтрокиПредставлений = мНастройкиБланка.НайтиСтроки(Новый Структура("ЕстьПредставление",Истина));
	Для Каждого Стр Из СтрокиПредставлений Цикл
		
		ТекОбл = Макет.Области.Найти(Стр.ИмяЯчейки);
		
		Если ТекОбл = Неопределено Тогда
			Попытка // Это может быть стандартное имя
				ТекОбл = Макет.Область(Стр.ИмяЯчейки);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Если ТекОбл <> Неопределено И ТекОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник И ТекОбл.СодержитЗначение = Истина Тогда
			Формула = Стр.СтруктураНастроек.Представление;
			Попытка
				ТекОбл.Значение = Вычислить(Формула);
			Исключение
				// ошибка в формуле специальным образом не обрабатывается.
			КонецПопытки;
			
			Если Стр.ЕстьСвязанныеРеквизиты Тогда
				ТекОбл.Расшифровка = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьЗначенияРеквизитов() Экспорт
	
	//Параметры отчета
	Для Каждого СтрокаТЧ Из ПараметрыОтчета Цикл		
		Если Параметры.Свойство(СтрокаТЧ.Код) Тогда
			СтрокаТЧ.Значение = Параметры[СтрокаТЧ.Код];
		КонецЕсли;
	КонецЦикла;
	// Дополнительные реквизиты
	Для Каждого СтрокаДопРеквизита Из мДополнительныеРеквизиты Цикл
		Если ДополнительныеРеквизиты.Свойство(СтрокаДопРеквизита.Код) Тогда
			СтрокаДопРеквизита.Значение = ДополнительныеРеквизиты[СтрокаДопРеквизита.Код];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновляет вычисляемые параметры вида отчета.
//
// Параметры:
//  ОбновитьВсе - булево. Если установлен, то обновляются все параметры
//
Процедура ОбновитьВычисляемыеПараметры(КодПараметра = "",ОбновитьВсе = Ложь) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыОтчетовПараметрыОтчета.Код,
	|	ВидыОтчетовПараметрыОтчета.Наименование,
	|	ВидыОтчетовПараметрыОтчета.ЭтоВыражение,
	|	ВидыОтчетовПараметрыОтчета.Формула,
	|	ВидыОтчетовПараметрыОтчета.ТипЗначения
	|ИЗ
	|	Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	|ГДЕ
	|	ВидыОтчетовПараметрыОтчета.Ссылка = &Ссылка"
	+ ?(ОбновитьВсе,"","
	|	И ВидыОтчетовПараметрыОтчета.ЭтоВыражение = ИСТИНА");
	Если Не ПустаяСтрока(КодПараметра) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ВидыОтчетовПараметрыОтчета.Код = &КодПараметра";
		
		Запрос.УстановитьПараметр("КодПараметра",КодПараметра);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка",ВидОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Стр = ПараметрыОтчета.Найти(СокрП(Выборка.Код),"Код");
		
		Если Стр = Неопределено Тогда
			Стр = ПараметрыОтчета.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Выборка);
			
		КонецЕсли;
		
		Если Выборка.ЭтоВыражение Тогда
			Попытка
				Стр.Значение = Вычислить(Выборка.Формула);
			Исключение			
				Сообщить("Ошибка при вычислении параметра "+СокрП(Выборка.Код),СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
		
		ОписаниеТипов = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Выборка.ТипЗначения);
		Стр.Значение  = ОписаниеТипов.ПривестиЗначение(Стр.Значение);
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСписокПараметровФормата(Знач СтрокаФормата)
	
	СписокПараметров = Новый Соответствие;
	
	ПарыИмяЗначение = СтрРазделить(СтрокаФормата,";",Ложь);
	
	Если НЕ ПустаяСтрока(СтрокаФормата) Тогда
		ПарыИмяЗначение.Добавить(СтрокаФормата);
	КонецЕсли;
	
	Для Каждого ПараИмяЗначение Из ПарыИмяЗначение Цикл
		ВхождениеРавно = Найти(ПараИмяЗначение, "=");
		Если ВхождениеРавно <> 0 Тогда
			СписокПараметров.Вставить(СокрЛП(Лев(ПараИмяЗначение, ВхождениеРавно - 1)), СокрЛП(Сред(ПараИмяЗначение, ВхождениеРавно + 1)));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПараметров;
	
КонецФункции

Функция ПреобразоватьВСтрокуФормата(СписокПараметров)
	
	МассивФормата = Новый Массив;
	Для Каждого Параметр Из СписокПараметров Цикл
		МассивФормата.Добавить(Параметр.Ключ);
		МассивФормата.Добавить(" = ");
		МассивФормата.Добавить(Параметр.Значение);
		МассивФормата.Добавить(";");
	КонецЦикла;
	Возврат СтрСоединить(МассивФормата);
	
КонецФункции

// Для областей табличного документа, связанных с показателями отчета,
// процедура устанавливает формат вывода - уровень точности и порядок округления,
// заданные пользователем для текущего отчета.
//
Процедура ПрименитьПараметрыОтображения(ТаблДок) Экспорт
	
	ДлинаПоказатель = СтрДлина("_Показатель_");
	СоответствиеФорматСтрока = Новый Соответствие;
	СоответствиеФорматСписок = Новый Соответствие;
	Для Каждого Обл Из ТаблДок.Области Цикл
		
		Если Обл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник ИЛИ Обл.СодержитЗначение <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОбласти = Обл.Имя;
		Если Прав(ИмяОбласти, 6) <> "_СУММА" Тогда
			
			КоординатаПоследнего_ = СтрНайти(ИмяОбласти, "_",НаправлениеПоиска.СКонца);
			
			Если КоординатаПоследнего_ > 0 Тогда
				
				Окончание = Сред(ИмяОбласти, КоординатаПоследнего_ + 1);
				
				Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Окончание) 
					И НЕ ПустаяСтрока(Окончание) Тогда
					КодПоказателя = Лев(ИмяОбласти, КоординатаПоследнего_ - 1);
					Вхождение_Показатель_ = Найти(КодПоказателя, "_Показатель_");
					Если Вхождение_Показатель_ <>0 Тогда
						КодПоказателя = Сред(КодПоказателя, Вхождение_Показатель_ + ДлинаПоказатель);
					КонецЕсли;
				ИначеЕсли Найти(ИмяОбласти, "_Показатель_") <> 0 И НЕ ПустаяСтрока(Окончание) Тогда
					КодПоказателя = ИмяОбласти;
					Вхождение_Показатель_ = Найти(КодПоказателя, "_Показатель_");
					Если Вхождение_Показатель_ <>0 Тогда
						КодПоказателя = Сред(КодПоказателя, Вхождение_Показатель_ + ДлинаПоказатель);
					КонецЕсли;
				Иначе
					КодПоказателя = ИмяОбласти;
				КонецЕсли;
			Иначе
				КодПоказателя = ИмяОбласти;
			КонецЕсли;
			
			СтрПок = мПоказатели.Найти(КодПоказателя, "Код");
			Если СтрПок = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрПок.ТипЗначения = ТипЗначенияЧисло Тогда
				Если СтрПок.ИндивидуальнаяТочность Тогда
					//индивидуальная точность устанавливается для всех, а общая только для финансовых
					Если УровеньТочности <> СтрПок.УровеньТочностиПоказателя Тогда
					
						ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
						Если ПолученныйРанееСписок = Неопределено Тогда
							ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
							ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
							СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
						КонецЕсли;
						
						СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
						СписокФорматов.Вставить("ЧДЦ", Строка(СтрПок.УровеньТочностиПоказателя));
						
						Обл.Формат = ПреобразоватьВСтрокуФормата(СписокФорматов);
					Иначе
						УстанавливаемыйФормат = СоответствиеФорматСтрока[Обл.Формат];
						
						Если УстанавливаемыйФормат = Неопределено Тогда
							ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
							Если ПолученныйРанееСписок = Неопределено Тогда
								ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
								ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
								СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
							КонецЕсли;
							СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
							
							УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
							СоответствиеФорматСтрока.Вставить(Обл.Формат,УстанавливаемыйФормат);
												
						КонецЕсли;
						
						Обл.Формат = УстанавливаемыйФормат;
					КонецЕсли;
				ИначеЕсли Не СтрПок.НеФинансовый Тогда
					УстанавливаемыйФормат = СоответствиеФорматСтрока[Обл.Формат];
					
					Если УстанавливаемыйФормат = Неопределено Тогда
						ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
						Если ПолученныйРанееСписок = Неопределено Тогда
							ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
							ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
							СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
						КонецЕсли;
						СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
						
						УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
						СоответствиеФорматСтрока.Вставить(Обл.Формат,УстанавливаемыйФормат);
											
					КонецЕсли;
					
					Обл.Формат = УстанавливаемыйФормат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// При интерактивном выборе бланка может возникнуть ситуация, когда выбирается 
// неактуальный бланк, с устаревшими данными.
//
Процедура АктуализироватьКонтекстОтчетаПоВыбранномуБланку() Экспорт

	Если Не ВыбранныйБланкАктуален() Тогда
		ВключитьНеактуальныеПоказатели();
	КонецЕсли;

КонецПроцедуры

Функция ВыбранныйБланкАктуален()

	Возврат БюджетнаяОтчетность.РедакцияБланкаАктуальна(ЭтотОбъект.ВидОтчета, ЭтотОбъект.ШаблонОтчета);

КонецФункции

Процедура ВключитьНеактуальныеПоказатели()

	мПоказатели.ЗаполнитьЗначения(Ложь, "Отключен");

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ГЕНЕРАЦИИ МАКЕТОВ РАСКРЫТИЙ
// И ФОРМИРОВАНИЯ ГРУППОВОГО МАКЕТА

Функция ПолучитьМассивПоказателейСтраницы() Экспорт
		
	Возврат Документы.УниверсальныйРегламентированныйОтчет.ПолучитьМассивПоказателейСтраницыПоНастройкам(мНастройкиБланка);
	
КонецФункции

// Определяет вид аналитики по порядковому номеру аналитики.
//
// Параметры:
//	СтрПоказатель  - Группа раскрытия или строка таблицы мПоказатели
//  НомерАналитики - Порядковый номер аналитики в группе раскрытия
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.АналитикаОтчетов - вид аналитики
//
Функция ВидАналитикиПоказателяПоНомеру(СтрПоказатель,НомерАналитики) Экспорт
	
	Если ТипЗнч(СтрПоказатель) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		ГруппаРаскрытия = СтрПоказатель;
	ИначеЕсли ЗначениеЗаполнено(СтрПоказатель.ГруппаРаскрытия) Тогда
		ГруппаРаскрытия = СтрПоказатель.ГруппаРаскрытия;
	Иначе
	    Возврат мПустойВидАналитики;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		НастройкиГруппы = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
		Если НастройкиГруппы = Неопределено Тогда
			Возврат мПустойВидАналитики;
		Иначе
			Попытка
				Возврат НастройкиГруппы["ВидАналитики"+НомерАналитики];
			Исключение
				Возврат мПустойВидАналитики;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Возврат мПустойВидАналитики;
	КонецЕсли;
	
КонецФункции

// Функция возвращает строку с макетами раскрытия для указанной группы раскрытия.
//
Функция ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия) Экспорт
	
	// Макеты раскрытия не прочитаны из таблицы.
	ТекСтрока = мМакетыРаскрытий.Найти(КодГруппыРаскрытия, "Имя");
	Результат = Новый Структура("Шапка,Строка,Подвал");
	
	Если ТекСтрока = Неопределено и мМакетыРаскрытий.Количество() = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БланкиОтчетовМакетРаскрытий.КодГруппыРаскрытия,
		|	БланкиОтчетовМакетРаскрытий.Макет
		|ИЗ
		|	Справочник.БланкиОтчетов.МакетРаскрытий КАК БланкиОтчетовМакетРаскрытий
		|ГДЕ
		|	БланкиОтчетовМакетРаскрытий.Ссылка = &БланкОтчета
		|	И БланкиОтчетовМакетРаскрытий.ОсновнаяЧасть = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("БланкОтчета",БланкОтчета);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка          = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураРаскрытий = Выборка.Макет.Получить();
			Если ТипЗнч(СтруктураРаскрытий) = Тип("Структура") Тогда
				НоваяСтрока     =  мМакетыРаскрытий.Добавить();
				НоваяСтрока.Имя =  СокрП(Выборка.КодГруппыРаскрытия);
				СтруктураРаскрытий.Свойство("Шапка"     , НоваяСтрока.Шапка);
				СтруктураРаскрытий.Свойство("Содержимое", НоваяСтрока.Строка);
				СтруктураРаскрытий.Свойство("Подвал"    , НоваяСтрока.Подвал);
				
				Если НоваяСтрока.Имя = КодГруппыРаскрытия Тогда
					ТекСтрока = НоваяСтрока;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ТекСтрока = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ТекСтрока);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выводит табличный документ (Секция) в основной табличный документ (Макет), если Секция определена.
//
Процедура ВывестиСекциюВМакет(Макет, Секция, Присоединить = Ложь) Экспорт
	
	Если Секция <> Неопределено Тогда
		Если Присоединить Тогда
			Макет.Присоединить(Секция);
		Иначе
			Макет.Вывести(Секция);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СгенерироватьМакетРаскрытия(Знач БланкОтчета, Знач СтрокаГруппыРаскрытия, Знач ТаблицаРаскрытия, Знач МакетыРаскрытия = Неопределено) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если ТипЗнч(СтрокаГруппыРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		ГруппаРаскрытия = СтрокаГруппыРаскрытия;
		КодГруппыРаскрытия = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаРаскрытия,"Код"));
	Иначе
		ГруппаРаскрытия = СтрокаГруппыРаскрытия.ГруппаРаскрытия;
		КодГруппыРаскрытия = СокрЛП(СтрокаГруппыРаскрытия.Код);
	КонецЕсли;
	
	Макет = Новый ТабличныйДокумент;
	
	Если МакетыРаскрытия = Неопределено Тогда
		МакетыРаскрытия = ВернутьМассивМакетовРаскрытия(КодГруппыРаскрытия);
	КонецЕсли;
	
	МакетРаскрытияШапка		= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Шапка = Неопределено	, Неопределено, МакетыРаскрытия.Шапка.ПолучитьОбласть() );
	МакетРаскрытияСтрока	= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Строка = Неопределено, Неопределено, МакетыРаскрытия.Строка.ПолучитьОбласть());
	МакетРаскрытияПодвал	= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Подвал = Неопределено, Неопределено, МакетыРаскрытия.Подвал.ПолучитьОбласть());
	
	Если Не МакетРаскрытияСтрока = Неопределено Тогда
		ОбластьМакета = МакетРаскрытияСтрока.Области.Найти(КодГруппыРаскрытия);
	Иначе
		Сообщить("Бланк отчета не содержит макета для группы раскрытия "+КодГруппыРаскрытия,СтатусСообщения.Внимание);
		Возврат Макет;
	КонецЕсли;
	
	Если ОбластьМакета <> Неопределено И ОбластьМакета.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Колонки Тогда
		ВертикальныйРежим = Истина;
	Иначе
		ВертикальныйРежим = Ложь;
	КонецЕсли;
	
	Если ТаблицаРаскрытия.Количество() = 0 Тогда
		ВывестиСекциюВМакет(Макет, МакетРаскрытияШапка,  ВертикальныйРежим);
		
		Если ТекущийРежимЗапуска() = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
			ВывестиСекциюВМакет(Макет, МакетРаскрытияСтрока, ВертикальныйРежим);
		КонецЕсли;
		
		ВывестиСекциюВМакет(Макет, МакетРаскрытияПодвал, ВертикальныйРежим);
		
		Возврат Макет;
		
	КонецЕсли;
		
	Если МакетРаскрытияСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получение модифицированного квалификатора числа
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, УровеньТочности));
	
	// Получение модифицированного квалификатора строки
	КвалификаторСтроки           = БюджетнаяОтчетность.ПолучитьОписаниеТиповРесурсаЗначениеПоказателя().КвалификаторыСтроки;
	КвалификаторПеременнойСтроки = Новый КвалификаторыСтроки(КвалификаторСтроки.Длина,ДопустимаяДлина.Переменная);
	
	МакетТаблЧасти = Новый ТабличныйДокумент;
	СуммыПоПоказателям = Новый Структура;
	
	//КолонкиПоказатели = мПоказатели.Скопировать(Новый Структура("КодСтрока", КодСтроки));
	
	ФормулыЯчеек = Новый Соответствие;
	НастройкиУОЯчеек = Новый Соответствие;
	Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
		
		НастройкиЯчейки = мНастройкиБланка.Найти(Обл.Имя,"ИмяЯчейки");
		Если НастройкиЯчейки <> Неопределено Тогда
			Если НастройкиЯчейки.ЕстьПредставление Тогда
				ФормулыЯчеек.Вставить(Обл.Имя,НастройкиЯчейки.СтруктураНастроек.Представление);
			КонецЕсли;
			Если НастройкиЯчейки.ЕстьУсловноеОформлениеБланка
				И НастройкиЯчейки.ЕстьИспользуемыеНастройкиУОБланка Тогда
				
				НастройкиУОЯчеек.Вставить(Обл.Имя,НастройкиЯчейки.СтруктураНастроек.ПараметрыУсловногоОформления);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	НастройкиГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	
	// Определение полей макета
	ОпределениеПолейМакета = Новый ТаблицаЗначений;
	ОпределениеПолейМакета.Колонки.Добавить("ИмяОбласти");
	ОпределениеПолейМакета.Колонки.Добавить("Ресурс");
	ОпределениеПолейМакета.Колонки.Добавить("ИмяРеквизита");
	ОпределениеПолейМакета.Колонки.Добавить("ЭтоАналитика");
	ОпределениеПолейМакета.Колонки.Добавить("СпособЗаполнения");
	
	НовСтр = ОпределениеПолейМакета.Добавить();
	НовСтр.ИмяОбласти = КодГруппыРаскрытия +"_НомерСтроки";
	НовСтр.ИмяРеквизита = "";
	НовСтр.Ресурс = "НомерСтроки";
	НовСтр.ЭтоАналитика = "Ложь";
	
	ДлинаПрефикса = СтрДлина(КодГруппыРаскрытия + "_Показатель_");
	
	СтруктураПокИндТочн = Новый Структура;
	
	Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
		
		Если Обл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			ИЛИ (Обл.СодержитЗначение <> Истина И Обл.АвтоотметкаНезаполненного = Ложь) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОбласти 		 = СокрЛП(Обл.Имя);
		КодыИмениОбласти = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяОбласти,"_");
		
		Если Не (КодыИмениОбласти[0] = КодГруппыРаскрытия и КодыИмениОбласти.Количество() > 1) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
		Если СтрНачинаетсяС(КодыИмениОбласти[1],"Аналитика") Тогда
			Для НомерАналитики = 1 По мЧислоДопАналитик Цикл
				Если КодыИмениОбласти[1] = ("Аналитика" + НомерАналитики) 
					И ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено Тогда
					ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
				
		Если ЭтоОбластьРеквизитаОднойИзАналитик Тогда
			
			ИмяРеквизита = ?(КодыИмениОбласти.Количество() > 2,КодыИмениОбласти[2],"");
			
			СтрОписание = ОпределениеПолейМакета.Добавить();
			СтрОписание.ИмяОбласти 	 = ИмяОбласти;
			СтрОписание.Ресурс		 = "Аналитика" + НомерАналитики;
			СтрОписание.ИмяРеквизита = ИмяРеквизита;
			СтрОписание.ЭтоАналитика = Истина;
			
			Обл.АвтоОтметкаНезаполненного = НастройкиГруппыРаскрытия["Обязательная" + СтрОписание.Ресурс];
			
		Иначе		
			
			КодПоказателя = Сред(ИмяОбласти, ДлинаПрефикса + 1);
			
			Если ТаблицаРаскрытия.Колонки.Найти(КодПоказателя) <> Неопределено Тогда	
				
				СтрОписание = ОпределениеПолейМакета.Добавить();
				СтрОписание.ИмяОбласти 	 = ИмяОбласти;
				СтрОписание.Ресурс		 = КодПоказателя;
				СтрОписание.ЭтоАналитика = Ложь;
				
				Пок = мПоказатели.Найти(СтрОписание.Ресурс,"Код");
				Если Пок = Неопределено Тогда
					Продолжить;
				ИначеЕсли Пок.Отключен Тогда
					Обл.Защита = Истина;
				ИначеЕсли Обл.СодержитЗначение Тогда
					
					СтрОписание.СпособЗаполнения = 1;
					
					Если Пок.ТипЗначения = ТипЗначенияЧисло Тогда
						Если Пок.ИндивидуальнаяТочность Тогда
							//индивидуальная точность устанавливается для всех, а общая только для финансовых
							Если Пок.УровеньТочностиПоказателя <> УровеньТочности Тогда
							
								РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Пок.УровеньТочностиПоказателя);
								Обл.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, Пок.УровеньТочностиПоказателя));
								
								СтруктураПокИндТочн.Вставить(Пок.Код,Пок.УровеньТочностиПоказателя);
								
							Иначе			
								Обл.ТипЗначения = ОписаниеТиповЧисло;
							КонецЕсли;
						ИначеЕсли Пок.НеФинансовый = Ложь Тогда
							Обл.ТипЗначения = ОписаниеТиповЧисло;	
						КонецЕсли;
					Иначе
						ТекТипЗначения = Обл.ТипЗначения;
						НужныйТип = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения);
						
						Если Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка и Не Пок.НеограниченнаяДлина Тогда
							НужныйТип = Новый ОписаниеТипов(НужныйТип,,,,КвалификаторПеременнойСтроки);
						КонецЕсли;
						
						Если ТекТипЗначения.Типы()[0] <> НужныйТип.Типы()[0] 
							или ТекТипЗначения.КвалификаторыСтроки.Длина <> НужныйТип.КвалификаторыСтроки.Длина Тогда
							// В ячейке установлен тип, который не соответствует типу показателя
							Обл.ТипЗначения = НужныйТип;
						КонецЕсли;
						
						Обл.Расшифровка = Истина;
						
					КонецЕсли;
				ИначеЕсли Обл.АвтоОтметкаНезаполненного Тогда
					СтрОписание.СпособЗаполнения = 2;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
			
	// Сбор дополнительных данных.
	ТаблицаРаскрытия = ПолучитьДополнительныеДанныеДляТаблицыРаскрытия(ОпределениеПолейМакета,ТаблицаРаскрытия);
	
	ПрименитьПараметрыОтображения(МакетРаскрытияСтрока);
	
	ПоказателиРаскрытия = Новый Структура;
	
	ОпределениеПолейМакета.Индексы.Добавить("ИмяОбласти");
	
	Для Каждого Стр Из ТаблицаРаскрытия Цикл // для каждой строки таблицы раскрытий
		
		КопияМакетаРаскрытия = МакетРаскрытияСтрока.ПолучитьОбласть(); // создаем копию макета раскрытия
		МассивОбластей = Новый Массив;
		
		ИндексСтроки = Формат(Стр.ID,"ЧН=0; ЧГ=0");
		
		Для Каждого Обл Из КопияМакетаРаскрытия.Области Цикл // Первоначальный набор областей необходимо сохранить
			МассивОбластей.Добавить(Обл);
		КонецЦикла;
		
		Для Каждого Обл Из МассивОбластей Цикл // обходим по областям
			
			ИмяОбласти = Обл.Имя;
			
			ПараметрыУсловногоОформления = НастройкиУОЯчеек[ИмяОбласти];
			Если ПараметрыУсловногоОформления <> Неопределено Тогда
												
                ТекНастройкаУО = РассчитатьУсловноеОформлениеЯчейки(Неопределено,Стр,ПараметрыУсловногоОформления);

				Если ТекНастройкаУО.МеняетсяЦветФона Тогда
					Обл.ЦветФона = ТекНастройкаУО.ТекЦветФона;
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяЦветТекста Тогда
					Обл.ЦветТекста = ТекНастройкаУО.ТекЦветТекста;
				КонецЕсли;
				
				Если ТекНастройкаУО.МеняетсяШрифт Тогда
					Обл.Шрифт = Новый Шрифт(Обл.Шрифт,,,ТекНастройкаУО.ТекПолужирный,ТекНастройкаУО.ТекНаклонный,,ТекНастройкаУО.ТекЗачеркивание);
				КонецЕсли;
				
			КонецЕсли;
			
			ОписаниеОбласти = ОпределениеПолейМакета.Найти(ИмяОбласти,"ИмяОбласти");
			
			Если ОписаниеОбласти <> Неопределено Тогда
			
				Если ОписаниеОбласти.ЭтоАналитика Тогда
					ЗначениеАналитики = Стр[ОписаниеОбласти.Ресурс];
					ИмяРеквизита	  = ОписаниеОбласти.ИмяРеквизита;
					
					Формула = ФормулыЯчеек[ИмяОбласти];
					
					Значение = Неопределено;
					Если ЗначениеЗаполнено(Формула) Тогда
						Попытка
							ТекущаяСтрока = Стр;
							Значение = Вычислить(Формула);
						Исключение
						КонецПопытки;
					КонецЕсли;
					
					Попытка // возможно несоответствие типов
						Если Значение = Неопределено Тогда
							Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеАналитики)) Тогда
								Если ИмяРеквизита = "Идентификатор" Тогда
									Значение = ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеАналитики)
								Иначе
									Значение = Стр[ОписаниеОбласти.Ресурс+"_Представление"];
								КонецЕсли;							
							Иначе
								Значение = ?(ПустаяСтрока(ИмяРеквизита), Стр[ОписаниеОбласти.Ресурс+"_Представление"], СокрП(Стр[ОписаниеОбласти.Ресурс+"_"+ИмяРеквизита]));
							КонецЕсли;					
						КонецЕсли;
						
						Обл.Значение 	= Значение;
						Обл.Расшифровка = Стр[ОписаниеОбласти.Ресурс];
						
					Исключение		
						Если ТипЗнч(ЗначениеАналитики) = Тип("Строка") Тогда //Вывод "сырых" значений
							Значение = ЗначениеАналитики;
						КонецЕсли;					
					КонецПопытки;
										
					Обл.Значение = Значение;
					Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
					
				ИначеЕсли ОписаниеОбласти.Ресурс = "НомерСтроки" Тогда
							
					Формула = ФормулыЯчеек[ИмяОбласти];
				
					НомерСтроки = Стр["ID"]+1;
					Если ЗначениеЗаполнено(Формула) Тогда
						Попытка
							ТекущаяСтрока = Стр;
							НомерСтроки = Вычислить(Формула);
						Исключение
						КонецПопытки;
					КонецЕсли;
					
					Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
					Если Обл.СодержитЗначение Тогда
				    	Обл.Значение = НомерСтроки;
					Иначе
						Обл.Текст = НомерСтроки;
					КонецЕсли;
				Иначе
						
					ЗначениеПоказателя  = Стр[ОписаниеОбласти.Ресурс + "_Отображение"];
					Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
					Если ОписаниеОбласти.СпособЗаполнения = 1 Тогда							
												
						Попытка // возможно несоответствие типов
							Обл.Значение = ЗначениеПоказателя;
						Исключение
						КонецПопытки;
						
					ИначеЕсли ОписаниеОбласти.СпособЗаполнения = 2 Тогда
						
						Обл.Текст = ЗначениеПоказателя;
						
					КонецЕсли;
					
					// отрисовка признака промежуточного итога.
					Если Найти(Стр.ПромежуточныеИтоги,","+ОписаниеОбласти.Ресурс+",") > 0 Тогда
						Обл.ЦветФона = ЦветаСтиля.ЦветПромежуточногоИтога;
					КонецЕсли;
						
					Если МакетРаскрытияПодвал <> Неопределено и ТипЗнч(ЗначениеПоказателя) = Тип("Число") Тогда
						СуммПок = 0;
						Если СуммыПоПоказателям.Свойство(ОписаниеОбласти.Ресурс, СуммПок) Тогда
							
							Пок = Неопределено;
							Если Не ПоказателиРаскрытия.Свойство(ОписаниеОбласти.Ресурс, Пок) Тогда
								Пок = мПоказатели.Найти(ОписаниеОбласти.Ресурс, "Код");
								ПоказателиРаскрытия.Вставить(ОписаниеОбласти.Ресурс, Пок);
							КонецЕсли;
							
							Если Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Сумма
								 ИЛИ НЕ ЗначениеЗаполнено(Пок.ВидИтога)
								 ИЛИ Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Среднее Тогда
								СуммыПоПоказателям[Пок.Код] = СуммПок + ?(ТипЗнч(ЗначениеПоказателя) = Тип("Число"), ЗначениеПоказателя, 0);
							ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Максимум И СуммПок < ЗначениеПоказателя Тогда
								СуммыПоПоказателям[Пок.Код] = ЗначениеПоказателя;
							ИначеЕсли Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Минимум И СуммПок > ЗначениеПоказателя Тогда
								СуммыПоПоказателям[Пок.Код] = ЗначениеПоказателя;
							КонецЕсли;
						Иначе
							СуммыПоПоказателям.Вставить(ОписаниеОбласти.Ресурс, ?(ТипЗнч(ЗначениеПоказателя) = Тип("Число"), ЗначениеПоказателя, 0));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				//вывод параметров в строке раскрытия
				Формула = ФормулыЯчеек[ИмяОбласти];
				Если Формула = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Значение = Неопределено;
				Если ЗначениеЗаполнено(Формула) Тогда
					Попытка
						ТекущаяСтрока = Стр;
						Значение = Вычислить(Формула);
					Исключение
					КонецПопытки;
				КонецЕсли;
				
				Если Обл.СодержитЗначение Тогда
					Обл.Значение = Значение;
				Иначе
					Обл.Текст = Значение;
				КонецЕсли;
				Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
					
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВертикальныйРежим Тогда // выводим строку - макет раскрытия со значениями в основной макет раскрытий
			МакетТаблЧасти.Присоединить(КопияМакетаРаскрытия); 
		Иначе
			МакетТаблЧасти.Вывести(КопияМакетаРаскрытия);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючПок Из ПоказателиРаскрытия Цикл
		Пок = КлючПок.Значение;
		Если Пок.ВидИтога = Перечисления.ВидыИтоговПоказателя.Среднее Тогда
			СуммыПоПоказателям[Пок.Код] = СуммыПоПоказателям[Пок.Код] / ТаблицаРаскрытия.Количество();
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Эл Из СуммыПоПоказателям Цикл
		ИмяПок = Эл.Ключ;
		
		Если МакетРаскрытияПодвал <> Неопределено Тогда
			СоотвОбл = МакетРаскрытияПодвал.Области.Найти(КодГруппыРаскрытия + "_" + ИмяПок + "_СУММА");
			Если СоотвОбл <> Неопределено 
				И СоотвОбл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
				И СоотвОбл.СодержитЗначение = Истина Тогда
				Попытка
					ТекУровеньТочности = УровеньТочности;
					Если СтруктураПокИндТочн.Свойство(ИмяПок,ТекУровеньТочности) = Ложь Тогда
						ТекУровеньТочности = УровеньТочности;
					КонецЕсли;
					СписокФорматов    = ПолучитьСписокПараметровФормата(СоотвОбл.Формат);
					СписокФорматов.Вставить("ЧДЦ", Строка(ТекУровеньТочности));
					СоотвОбл.Значение = Эл.Значение;
					СоотвОбл.Формат   = ПреобразоватьВСтрокуФормата(СписокФорматов);
				Исключение КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ВывестиСекциюВМакет(Макет, МакетРаскрытияШапка	,ВертикальныйРежим);
	ВывестиСекциюВМакет(Макет, МакетТаблЧасти		,ВертикальныйРежим);

	ОбластьТабличнаяЧасть = Макет.Области.Найти(КодГруппыРаскрытия);
	Если ОбластьТабличнаяЧасть <> Неопределено Тогда
		ОбластьТабличнаяЧасть.Имя = "";
	КонецЕсли;
	
	Если Не ВертикальныйРежим Тогда
		Макет.Область(?(МакетРаскрытияШапка = Неопределено, 1, МакетРаскрытияШапка.ВысотаТаблицы + 1), 0, Макет.ВысотаТаблицы, 0).Имя = КодГруппыРаскрытия;
	Иначе
		ШиринаШапки = ?(МакетРаскрытияШапка = Неопределено, 0, МакетРаскрытияШапка.ШиринаТаблицы);
		Макет.Область(0,?(ШиринаШапки = 0, 1, МакетРаскрытияШапка.ШиринаТаблицы + 1), 0, МакетТаблЧасти.ШиринаТаблицы + ШиринаШапки).Имя = КодГруппыРаскрытия;
	КонецЕсли;
	
	ВывестиСекциюВМакет(Макет, МакетРаскрытияПодвал);
		
	Макет.Область(1, 0, Макет.ВысотаТаблицы, 0).Видимость = Истина;
	
	Возврат Макет;
	
КонецФункции

// Формирует табличный документ - визуальное представление группы раскрытия по заданным 
// группе раскрытия и таблице раскрытия для данной группы.
//
Функция СгенерироватьМакетРаскрытияСтрока(ГруппаРаскрытия,ИсходнаяТаблицаРаскрытия, ОтборПоРаскрытию, КодСтроки, МакетыРаскрытия, СтруктураИменОбластейСОформлением = Неопределено) Экспорт
	
	КодГруппыРаскрытия = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаРаскрытия,"Код"));
	Макет = Новый ТабличныйДокумент;
	
	МакетРаскрытияШапка		= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Шапка = Неопределено	, Неопределено, МакетыРаскрытия.Шапка.ПолучитьОбласть());
	МакетРаскрытияСтрока	= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Строка = Неопределено, Неопределено, МакетыРаскрытия.Строка.ПолучитьОбласть());
	
	Инд=1;
	
	Если НЕ ЗначениеЗаполнено(ОтборПоРаскрытию) Тогда
		
		ТаблицаРаскрытия = ИсходнаяТаблицаРаскрытия.Скопировать();
		
	Иначе
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ИсходнаяТаблицаРаскрытия);
		
		Для Каждого КлючИЗначение Из ОтборПоРаскрытию Цикл
			Отбор = ПостроительЗапроса.Отбор.Добавить(КлючИЗначение.Ключ);
			Отбор.ВидСравнения  = КлючИЗначение.Значение.ВидСравнения;
			Если ТипЗнч(Отбор.Значение) = ТипЗнч(КлючИЗначение.Значение.Значение) Тогда
				Отбор.Значение = КлючИЗначение.Значение.Значение;
			Иначе
				Отбор.Значение = БюджетнаяОтчетность.ПустоеЗначениеТипа(ТипЗнч(Отбор.Значение));
			КонецЕсли;	
			Отбор.Использование = Истина;
		КонецЦикла;
		
		ТаблицаРаскрытия = ПостроительЗапроса.Результат.Выгрузить();
		
	КонецЕсли;
	
	ЕстьШапка=НЕ МакетРаскрытияШапка=Неопределено;
	
	Если МакетРаскрытияСтрока = Неопределено Тогда
		Возврат Новый ТабличныйДокумент;
	КонецЕсли;
	
	// Получение модифицированного квалификатора числа
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, УровеньТочности));
	
	// Получение модифицированного квалификатора строки
	КвалификаторСтроки           = БюджетнаяОтчетность.ПолучитьОписаниеТиповРесурсаЗначениеПоказателя().КвалификаторыСтроки;
	КвалификаторПеременнойСтроки = Новый КвалификаторыСтроки(КвалификаторСтроки.Длина,ДопустимаяДлина.Переменная);
	
	Если ТаблицаРаскрытия.Количество() = 0 Тогда
		
		Если ЕстьШапка Тогда
			ВывестиСекциюВМакет(Макет, МакетРаскрытияШапка);
		КонецЕсли;
		
		НачалоМакета = 0;
		
		Для Стр = 1 По МакетРаскрытияСтрока.ВысотаТаблицы Цикл
			Для Кол = 1 по МакетРаскрытияСтрока.ШиринаТаблицы Цикл
				Если Найти(МакетРаскрытияСтрока.Область(Стр,Кол).Имя,КодСтроки)>0 Тогда
					НачалоМакета = Кол;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НачалоМакета > 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НачалоМакета > 0 Тогда //Удалось найти начало макета
			МногострочнаяОбласть = МакетРаскрытияСтрока.Область(1,НачалоМакета,МакетРаскрытияСтрока.ВысотаТаблицы,МакетРаскрытияСтрока.ШиринаТаблицы);
			МногострочнаяОбласть.Объединить();
			Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,2);
			
			МногострочнаяОбласть.Обвести(Граница,Граница,Граница,Граница);
			МногострочнаяОбласть.Защита = Истина;
			МногострочнаяОбласть.СодержитЗначение = Ложь;
			МногострочнаяОбласть.Имя = КодГруппыРаскрытия+"_"+КодСтроки+"_РазметкаПустойСтроки";
			МногострочнаяОбласть.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			МногострочнаяОбласть.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			МногострочнаяОбласть.Текст = "< Для добавления строк выделите данную область и нажмите кнопку «Добавить строку». >";
			МногострочнаяОбласть.Расшифровка = Ложь;
		КонецЕсли;
		
		ТаблицаРаскрытия.Добавить();
		ВывестиСекциюВМакет(Макет, МакетРаскрытияСтрока);
		
	Иначе
		МакетТаблЧасти = Новый ТабличныйДокумент;
		СуммыПоПоказателям = Новый Структура;
		
		//КолонкиПоказатели = мПоказатели.Скопировать(Новый Структура("КодСтрока", КодСтроки));
		
		ФормулыЯчеек = Новый Соответствие;
		НастройкиУОЯчеек = Новый Соответствие;
		Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
			
			НастройкиЯчейки = мНастройкиБланка.Найти(Обл.Имя,"ИмяЯчейки");
			Если НастройкиЯчейки <> Неопределено Тогда
				Если НастройкиЯчейки.ЕстьПредставление Тогда
					ФормулыЯчеек.Вставить(Обл.Имя,НастройкиЯчейки.СтруктураНастроек.Представление);
				КонецЕсли;
				Если НастройкиЯчейки.ЕстьУсловноеОформлениеБланка
					И НастройкиЯчейки.ЕстьИспользуемыеНастройкиУОБланка Тогда
					
					НастройкиУОЯчеек.Вставить(Обл.Имя,НастройкиЯчейки.СтруктураНастроек.ПараметрыУсловногоОформления);
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		НастройкиГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
		
		// Определение полей макета
		ОпределениеПолейМакета = Новый ТаблицаЗначений;
		ОпределениеПолейМакета.Колонки.Добавить("ИмяОбласти");
		ОпределениеПолейМакета.Колонки.Добавить("Ресурс");
		ОпределениеПолейМакета.Колонки.Добавить("ИмяРеквизита");
		ОпределениеПолейМакета.Колонки.Добавить("ЭтоАналитика");
		ОпределениеПолейМакета.Колонки.Добавить("СпособЗаполнения");
		
		ДлинаПрефикса = СтрДлина(КодГруппыРаскрытия +"_"+КодСтроки+ "_Показатель_");
		
		НовСтр = ОпределениеПолейМакета.Добавить();
		НовСтр.ИмяОбласти = КодГруппыРаскрытия +"_"+КодСтроки+"_НомерСтроки";
		НовСтр.ИмяРеквизита = "";
		НовСтр.Ресурс = "НомерСтроки";
		НовСтр.ЭтоАналитика = "Ложь";
		
		Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
			
			Если Обл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
				ИЛИ (Обл.СодержитЗначение <> Истина И Обл.АвтоотметкаНезаполненного = Ложь) Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяОбласти 		 = СокрЛП(Обл.Имя);
			КодыИмениОбласти = СтрРазделить(ИмяОбласти,"_",Ложь);
			
			Если Не (КодыИмениОбласти[0] = КодГруппыРаскрытия 
				И КодыИмениОбласти[1] = КодСтроки 
				И КодыИмениОбласти.Количество() > 2) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
			Для НомерАналитики = 1 По мЧислоДопАналитик Цикл
				Если КодыИмениОбласти[2] = ("Аналитика" + НомерАналитики) 
					И ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено Тогда
					ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭтоОбластьРеквизитаОднойИзАналитик Тогда
				
				ИмяРеквизита = ?(КодыИмениОбласти.Количество() > 3,КодыИмениОбласти[3],"");
				
				СтрОписание = ОпределениеПолейМакета.Добавить();
				СтрОписание.ИмяОбласти 	 = ИмяОбласти;
				СтрОписание.Ресурс		 = "Аналитика" + НомерАналитики;
				СтрОписание.ИмяРеквизита = ИмяРеквизита;
				СтрОписание.ЭтоАналитика = Истина;
				
				Обл.АвтоОтметкаНезаполненного = НастройкиГруппыРаскрытия["Обязательная" + СтрОписание.Ресурс];
				
			Иначе
								
				КодПоказателя = Сред(ИмяОбласти, ДлинаПрефикса + 1);
				
				Если Не ТаблицаРаскрытия.Колонки.Найти(КодПоказателя) = Неопределено Тогда
					
					СтрОписание = ОпределениеПолейМакета.Добавить();
					СтрОписание.ИмяОбласти 	 = ИмяОбласти;
					СтрОписание.Ресурс		 = КодПоказателя;
					СтрОписание.ЭтоАналитика = Ложь;
					
					Пок = мПоказатели.Найти(СтрОписание.Ресурс,"Код");
					Если Пок = Неопределено Тогда
						Продолжить;
					ИначеЕсли Пок.Отключен Тогда
						Обл.Защита = Истина;
					ИначеЕсли Обл.СодержитЗначение Тогда
						
						СтрОписание.СпособЗаполнения = 1;
						
						Если Пок.ТипЗначения = ТипЗначенияЧисло Тогда
							Если Пок.ИндивидуальнаяТочность Тогда
								//индивидуальная точность устанавливается для всех, а общая только для финансовых
								Если Пок.УровеньТочностиПоказателя <> УровеньТочности Тогда
									РазрядностьЧисла= КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Пок.УровеньТочностиПоказателя);
									Обл.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, Пок.УровеньТочностиПоказателя));
								Иначе						
									Обл.ТипЗначения = ОписаниеТиповЧисло;
								КонецЕсли;
							ИначеЕсли Пок.НеФинансовый = Ложь Тогда						
								Обл.ТипЗначения = ОписаниеТиповЧисло;
							КонецЕсли;
						Иначе
							ТекТипЗначения = Обл.ТипЗначения;
							НужныйТип = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения);
							
							Если Пок.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка 
								И Не Пок.НеограниченнаяДлина Тогда
								НужныйТип = Новый ОписаниеТипов(НужныйТип,,,,КвалификаторПеременнойСтроки);
							КонецЕсли;
							
							Если ТекТипЗначения.Типы()[0] <> НужныйТип.Типы()[0] 
								ИЛИ ТекТипЗначения.КвалификаторыСтроки.Длина <> НужныйТип.КвалификаторыСтроки.Длина Тогда
								// В ячейке установлен тип, который не соответствует типу показателя
								Обл.ТипЗначения = НужныйТип;
							КонецЕсли;
							
							Обл.Расшифровка = Истина;
							
						КонецЕсли;
					ИначеЕсли Обл.АвтоОтметкаНезаполненного Тогда
						СтрОписание.СпособЗаполнения = 2;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Сбор дополнительных данных.
		ТаблицаРаскрытия = ПолучитьДополнительныеДанныеДляТаблицыРаскрытия(ОпределениеПолейМакета,ТаблицаРаскрытия);
		
		ПрименитьПараметрыОтображения(МакетРаскрытияСтрока);
		
		ОпределениеПолейМакета.Индексы.Добавить("ИмяОбласти");
		
		УстановитьБезопасныйРежим(Истина);
	
		Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
		Иначе
			МассивРазделителей = Новый Массив;
		КонецЕсли;
		
		Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
			УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
		КонецЦикла;
		
		Для Каждого Стр Из ТаблицаРаскрытия Цикл // для каждой строки таблицы раскрытий
			
			КопияМакетаРаскрытия = МакетРаскрытияСтрока.ПолучитьОбласть(); // создаем копию макета раскрытия
			МассивОбластей = Новый Массив;
			
			ИндексСтроки = Формат(Стр.ID,"ЧН=0; ЧГ=0");
			
			Для Каждого Обл Из КопияМакетаРаскрытия.Области Цикл // Первоначальный набор областей необходимо сохранить
				МассивОбластей.Добавить(Обл);
			КонецЦикла;
			
			Для Каждого Обл Из МассивОбластей Цикл // обходим по областям
				
				ИмяОбласти = Обл.Имя;
				
				ПараметрыУсловногоОформления = НастройкиУОЯчеек[ИмяОбласти];
				МассивПолейСОформлением = Новый Массив;
				Если ПараметрыУсловногоОформления <> Неопределено Тогда
														
	                ТекНастройкаУО = РассчитатьУсловноеОформлениеЯчейки(Неопределено,Стр,ПараметрыУсловногоОформления);

					Если ТекНастройкаУО.МеняетсяЦветФона Тогда
						Обл.ЦветФона = ТекНастройкаУО.ТекЦветФона;
						МассивПолейСОформлением.Добавить("ЦветФона");
					КонецЕсли;
					
					Если ТекНастройкаУО.МеняетсяЦветТекста Тогда
						Обл.ЦветТекста = ТекНастройкаУО.ТекЦветТекста;
						МассивПолейСОформлением.Добавить("ЦветТекста");
					КонецЕсли;
					
					Если ТекНастройкаУО.МеняетсяШрифт Тогда
						Обл.Шрифт = Новый Шрифт(Обл.Шрифт,,,ТекНастройкаУО.ТекПолужирный,ТекНастройкаУО.ТекНаклонный,,ТекНастройкаУО.ТекЗачеркивание);
						МассивПолейСОформлением.Добавить("Шрифт");
					КонецЕсли;
					
				КонецЕсли;
				
				ОписаниеОбласти = ОпределениеПолейМакета.Найти(ИмяОбласти,"ИмяОбласти");
				
				Если ОписаниеОбласти <> Неопределено Тогда
				
					Если ОписаниеОбласти.ЭтоАналитика Тогда
						ЗначениеАналитики = Стр[ОписаниеОбласти.Ресурс];
						ИмяРеквизита	  = ОписаниеОбласти.ИмяРеквизита;
						
						Формула = ФормулыЯчеек[ИмяОбласти];
						
						Значение = Неопределено;
						Если ЗначениеЗаполнено(Формула) Тогда
							Попытка
								ТекущаяСтрока = Стр;
								Значение = Вычислить(Формула);
							Исключение
							КонецПопытки;
						КонецЕсли;
						
						Попытка // возможно несоответствие типов
							Если Значение = Неопределено Тогда
								Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеАналитики)) Тогда
									Если ИмяРеквизита = "Идентификатор" Тогда
										Значение = ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеАналитики);
									Иначе
										Значение = Стр[ОписаниеОбласти.Ресурс+"_Представление"];
									КонецЕсли;							
								Иначе
									Значение = ?(ПустаяСтрока(ИмяРеквизита), Стр[ОписаниеОбласти.Ресурс+"_Представление"], СокрП(Стр[ОписаниеОбласти.Ресурс+"_"+ИмяРеквизита]));
								КонецЕсли;					
							КонецЕсли;
							
							Обл.Значение 	= Значение;
							Обл.Расшифровка = Стр[ОписаниеОбласти.Ресурс];
							
						Исключение		
							Если ТипЗнч(ЗначениеАналитики) = Тип("Строка") Тогда //Вывод "сырых" значений
								Значение = ЗначениеАналитики;
							КонецЕсли;					
						КонецПопытки;
											
						Обл.Значение = Значение;
						Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
						
					ИначеЕсли ОписаниеОбласти.Ресурс = "НомерСтроки" Тогда
							
						Формула = ФормулыЯчеек[ИмяОбласти];
					
						НомерСтроки = Стр["ID"]+1;
						Если ЗначениеЗаполнено(Формула) Тогда
							Попытка
								ТекущаяСтрока = Стр;
								НомерСтроки = Вычислить(Формула);
							Исключение
							КонецПопытки;
						КонецЕсли;
						
						Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
						Если Обл.СодержитЗначение Тогда
					    	Обл.Значение = НомерСтроки;
						Иначе
							Обл.Текст = НомерСтроки;
						КонецЕсли;
					Иначе
						ЗначениеПоказателя  = Стр[ОписаниеОбласти.Ресурс + "_Отображение"];
						Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
						Если ОписаниеОбласти.СпособЗаполнения = 1 Тогда							
													
							Попытка // возможно несоответствие типов
								Обл.Значение = ЗначениеПоказателя;
							Исключение
							КонецПопытки;
							
						ИначеЕсли ОписаниеОбласти.СпособЗаполнения = 2 Тогда
							
							Обл.Текст = ЗначениеПоказателя;
							
						КонецЕсли;
						
						// отрисовка признака промежуточного итога.
						Если Найти(Стр.ПромежуточныеИтоги,","+ОписаниеОбласти.Ресурс+",") > 0 Тогда
							Обл.ЦветФона = ЦветаСтиля.ЦветПромежуточногоИтога;
						КонецЕсли;
					КонецЕсли;
					
				Иначе
					//вывод параметров в строке раскрытия
					Формула = ФормулыЯчеек[ИмяОбласти];
					Если Формула = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Значение = Неопределено;
					Если ЗначениеЗаполнено(Формула) Тогда
						Попытка
							ТекущаяСтрока = Стр;
							Значение = Вычислить(Формула);
						Исключение
						КонецПопытки;
					КонецЕсли;
					
					Если Обл.СодержитЗначение Тогда
						Обл.Значение = Значение;
					Иначе
						Обл.Текст = Значение;
					КонецЕсли;
					Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
						
				КонецЕсли;
				
				Если СтруктураИменОбластейСОформлением<>Неопределено
					И МассивПолейСОформлением.Количество() Тогда
					СтруктураИменОбластейСОформлением.Вставить(Обл.Имя,МассивПолейСОформлением);
				КонецЕсли;
			КонецЦикла;
			МакетТаблЧасти.Вывести(КопияМакетаРаскрытия); // выводим строку - макет раскрытия со значениями в основной макет раскрытий
		КонецЦикла;
		
		Если ЕстьШапка Тогда
			ВывестиСекциюВМакет(Макет, МакетРаскрытияШапка);
		КонецЕсли;
		
		ВывестиСекциюВМакет(Макет, МакетТаблЧасти);
		
	КонецЕсли;
	Макет.Область(1, 0, Макет.ВысотаТаблицы, 0).Видимость = Истина;
	
	Возврат Макет;
	
КонецФункции

// Функция подготавливает кэш данных по группам раскрытия и возвращает настройки группы.
//
// Параметры:
//  ГруппаРаскрытия - Справочник.ГруппыРаскрытия или Массив групп раскрытия
//
// Возвращаемое значение:
//  Строка кэша групп раскрытия
//
Функция ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия = Неопределено, ОбновитьПолностью = Ложь) Экспорт
		
	Если ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда 
		Если ГруппаРаскрытия = Неопределено и Не ОбновитьПолностью Тогда
			Возврат КэшНастроекГруппРаскрытия;
		ИначеЕсли ГруппаРаскрытия = Неопределено Тогда
			ИскатьГруппуРаскрытия = Истина;
		Иначе
			Если ТипЗнч(ГруппаРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
				ИскомаяСтрока = КэшНастроекГруппРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
			Иначе
				ИскомаяСтрока = Новый Массив;
				Для Каждого ТекГруппа Из ГруппаРаскрытия Цикл
					Если КэшНастроекГруппРаскрытия.Найти(ТекГруппа,"ГруппаРаскрытия") = Неопределено Тогда
						ИскомаяСтрока.Добавить(ТекГруппа);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ИскомаяСтрока = Неопределено или (ТипЗнч(ИскомаяСтрока) = Тип("Массив") и ИскомаяСтрока.Количество() > 0) Тогда
				ИскатьГруппуРаскрытия = Истина;
			Иначе
				ИскатьГруппуРаскрытия = Ложь
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИскатьГруппуРаскрытия = Истина;
	КонецЕсли;
	
	Если ИскатьГруппуРаскрытия Тогда
		Запрос = Новый Запрос;
		
		Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
			КэшНастроекГруппРаскрытия = Новый ТаблицаЗначений;
		КонецЕсли;
		
		Для Инд = 1 По мЧислоДопАналитик Цикл
			
			СтроковыйИндекс = Формат(Инд, "ЧДЦ=0; ЧН=0");
			Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ВидАналитики" + СтроковыйИндекс,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ТипЗначенияАналитики" + СтроковыйИндекс);
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ОбязательнаяАналитика" + СтроковыйИндекс,Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ГруппаРаскрытия" 	,Новый ОписаниеТипов("СправочникСсылка.ГруппыРаскрытия"));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("КодГруппыРаскрытия"	,БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("РазрешитьСовпаденияИзмерений",Новый ОписаниеТипов("Булево"));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ЧислоАналитик"		,БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
		КонецЕсли;
		
		Если ИскомаяСтрока <> Неопределено Тогда
			ТекстУсловия = "
			|ГДЕ
			|	ГруппыРаскрытия.Ссылка В(&Ссылка)";
			Запрос.УстановитьПараметр("Ссылка", ИскомаяСтрока);
		Иначе
			ТекстУсловия = "
			| ГДЕ ГруппыРаскрытия.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", ВидОтчета);
			
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыРаскрытия.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытия.Код КАК КодГруппыРаскрытия,
		|	ГруппыРаскрытия.РазрешитьСовпаденияИзмерений,
		|	ЕСТЬNULL(ГруппыРаскрытияАналитика.НомерСтроки,0) КАК НомерАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики,
		|	ГруппыРаскрытияАналитика.Обязательный КАК ОбязательнаяАналитика,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипЗначенияАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
		|ИЗ
		|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ПО ГруппыРаскрытия.Ссылка = ГруппыРаскрытияАналитика.Ссылка"
		+ ТекстУсловия + "		
		|ИТОГИ ПО
		|	ГруппаРаскрытия";
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			
			ИскомаяСтрока = КэшНастроекГруппРаскрытия.Найти(Выборка.ГруппаРаскрытия,"ГруппаРаскрытия");
			Если ИскомаяСтрока = Неопределено Тогда
				ИскомаяСтрока = КэшНастроекГруппРаскрытия.Добавить();
				ИскомаяСтрока.ГруппаРаскрытия = Выборка.ГруппаРаскрытия;
			КонецЕсли;
			
			ИскомаяСтрока.КодГруппыРаскрытия = СокрЛП(Выборка.КодГруппыРаскрытия);
			ИскомаяСтрока.РазрешитьСовпаденияИзмерений = Выборка.РазрешитьСовпаденияИзмерений;
			Аналитики = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ИскомаяСтрока.ЧислоАналитик = Аналитики.Количество();
			Пока Аналитики.Следующий() Цикл
				
				Если Аналитики.НомерАналитики = 0 Тогда
					Если ИскомаяСтрока.ЧислоАналитик = 1 Тогда
						ИскомаяСтрока.ЧислоАналитик = 0;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				
				ИскомаяСтрока["ВидАналитики"+Аналитики.НомерАналитики] 			= Аналитики.ВидАналитики;
				Если НЕ ЗначениеЗаполнено(Аналитики.ВидКлассификатораБК) Тогда
					ИскомаяСтрока["ТипЗначенияАналитики"+Аналитики.НомерАналитики] 	= Аналитики.ТипЗначенияАналитики;
				Иначе
					ИскомаяСтрока["ТипЗначенияАналитики"+Аналитики.НомерАналитики] 	= БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(200);
				КонецЕсли;
				ИскомаяСтрока["ОбязательнаяАналитика"+Аналитики.НомерАналитики] = Аналитики.ОбязательнаяАналитика;				
				
			КонецЦикла;
		КонецЦикла;
		
		КэшНастроекГруппРаскрытия.Индексы.Добавить("ГруппаРаскрытия");		
	
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		
		Если ТипЗнч(ГруппаРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
			Если ТипЗнч(ИскомаяСтрока) = Тип("СтрокаТаблицыЗначений") и Не ИскатьГруппуРаскрытия Тогда
				Возврат ИскомаяСтрока;
			Иначе
				Возврат КэшНастроекГруппРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
			КонецЕсли;
		Иначе
			Строки		= Новый Массив;
			Для Каждого ТекГруппа Из ГруппаРаскрытия Цикл				
				Строки.Добавить(КэшНастроекГруппРаскрытия.Найти(ТекГруппа,"ГруппаРаскрытия"));				
			КонецЦикла;
			
			Возврат КэшНастроекГруппРаскрытия.Скопировать(Строки);
			
		КонецЕсли;		
	Иначе
		Возврат КэшНастроекГруппРаскрытия;
	КонецЕсли;
	
КонецФункции

// Формирует макеты и внутренние таблицы раскрытия в теле отчета.
//
Функция РаскрытьСтрокуПоАналитике(КодСтроки) Экспорт
	
	ЗаполненаОднаИзАналитик=Ложь;
	
	СтруктураПоиска=Новый Структура("КодСтрока",КодСтроки);	
	СтрокиРаскрытия = мПоказатели.НайтиСтроки(СтруктураПоиска);
	
	КодГруппыРаскрытия = "";
	Для Каждого СтрРаскрытия ИЗ СтрокиРаскрытия Цикл 
		
		Если ЗначениеЗаполнено(СтрРаскрытия.ГруппаРаскрытия) Тогда
			КодГруппыРаскрытия = СтрРаскрытия.КодГруппыРаскрытия;
			ГруппаРаскрытия=СтрРаскрытия.ГруппаРаскрытия;		
			Прервать;			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СтрРаскрытия=ТабОбластиРаскрытия.Добавить();
	СтрРаскрытия.КодСтроки=КодСтроки;
	КэшНастроекГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(КэшНастроекГруппыРаскрытия, КодСтроки);
	
	СтрРаскрытия.ТаблицаРаскрытия=ТаблицаРаскрытия;
	СтрРаскрытия.ГруппаРаскрытия=ГруппаРаскрытия;
	
	// определяем макет раскрытия
	МакетыРаскрытия = ВернутьМассивМакетовРаскрытия(СокрЛП(КодГруппыРаскрытия)+"_"+КодСтроки);
	
	СтрРаскрытия.МакетыРаскрытия = МакетыРаскрытия;
	
	СтруктураОтбора = СтрРаскрытия.ОтборПоРаскрытию;
	ТабДокРаскрытие = СгенерироватьМакетРаскрытияСтрока(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтбора, КодСтроки, МакетыРаскрытия);
	
	Если ТабДокРаскрытие = Неопределено Тогда
		ТабДокРаскрытие = Новый ТабличныйДокумент;
	КонецЕсли;
	
	СтрРаскрытия.ТабДокРаскрытие = ТабДокРаскрытие;
	СтрРаскрытия.ВысотаТабДокРаскрытия = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
	
	Возврат СтрРаскрытия;
	
КонецФункции // РаскрытьСтрокуПоАналитике

// Обновление таблицы раскрытия в основном бланке.
//
Процедура ОбновитьРаскрытиеСтроки(ТабДокумент, СтрРаскрытия) Экспорт
	
	Обл = ТабДокумент.Области.Найти("Строка_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Удаляем предыдущие строки раскрытия
	Верх = Обл.Верх;
	
	НачБлокаУдаления = Обл.Верх+1;
	КонБлокаУдаления = Обл.Верх;
	
	ИскомаяСтрока = "_" + СтрРаскрытия.КодСтроки;
	
	СтрМетаданныхОтчета = мПоказатели.Найти(СтрРаскрытия.КодСтроки,"КодСтрока");
	
	ОбластьШапки = ТабДокумент.Области.Найти(СтрМетаданныхОтчета.КодГруппыРаскрытия + ИскомаяСтрока + "_Шапка");
	Если ОбластьШапки <> Неопределено Тогда
		КонБлокаУдаления = ОбластьШапки.Низ;
	КонецЕсли;
	
	НомерКолонки = Обл.Лево;
	
	Для Кол = Обл.Лево По ТабДокумент.ШиринаТаблицы Цикл

		ИмяОбласти = ТабДокумент.Область(КонБлокаУдаления+1,Кол).Имя;

		Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")>0
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")>0 
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_РазметкаПустойСтроки")>0 Тогда
			НомерКолонки = Кол;
			Прервать;
		КонецЕсли;
				
	КонецЦикла;
	
	//в детальных строках раскрытия всегда есть область с именем КодГруппыРаскрытия_КодСтроки
	ВысотаСтрокиРаскрытия = 1;
	ОбластьСтроки = ТабДокумент.Области.Найти(СтрМетаданныхОтчета.КодГруппыРаскрытия + ИскомаяСтрока);
	Если ОбластьСтроки <> Неопределено Тогда
		ВысотаСтрокиРаскрытия = ОбластьСтроки.Низ - ОбластьСтроки.Верх + 1;
	КонецЕсли;
	
	//т.к. в строке раскрытия высота может быть больше 1 строки, а в первой ячейке будет заполнена не на всю высоту,
	//то это надо учитывать при определении областей раскрытия, которые надо удалить
	Пока Истина Цикл
		
		ИмяОбласти = ТабДокумент.Область(КонБлокаУдаления+1,НомерКолонки).Имя; //КонБлокаУдаления+1 - следующая строка, после текущей строки раскрытия
		
		Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")>0
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")>0 
			ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_РазметкаПустойСтроки")>0 Тогда
			КонБлокаУдаления=КонБлокаУдаления+ВысотаСтрокиРаскрытия;  //учитываем эту строку раскрытия
			
		Иначе
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбластьУдаления=ТабДокумент.Область(НачБлокаУдаления,,КонБлокаУдаления,);
	
	Если КонБлокаУдаления>=НачБлокаУдаления Тогда
		ТабДокумент.УдалитьОбласть(ОбластьУдаления,ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	ОбластьИсточник = СтрРаскрытия.ТабДокРаскрытие.Область(1,,СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы);
	ОбластьВставки  = ТабДокумент.Область(НачБлокаУдаления,,НачБлокаУдаления);
	ТабДокумент.ВставитьОбласть(ОбластьИсточник,ОбластьВставки,ТипСмещенияТабличногоДокумента.ПоВертикали);
		
КонецПроцедуры // ОбновитьРаскрытиеСтроки()

// Вывод всех областей раскрытия в теле отчета.
//
Функция ВывестиРаскрытиеВТелеОтчета(ТабДокумент) Экспорт
	
	ТабОбластиРаскрытия.Очистить();
	
	СтрокиОтчета = мПоказатели.Скопировать(,"КодСтрока,ГруппаРаскрытия,КодГруппыРаскрытия");
	СтрокиОтчета.Свернуть("КодСтрока,ГруппаРаскрытия,КодГруппыРаскрытия");
	
	мСоответствиеКодовГруппРаскрытия = Новый Соответствие;
	
	// Формирование таблиц раскрытия для каждой из строк, где есть раскрываемые показатели.
	Для Каждого Стр Из СтрокиОтчета Цикл
		Если ЗначениеЗаполнено(Стр.ГруппаРаскрытия) Тогда
			РаскрытьСтрокуПоАналитике(Стр.КодСтрока);
		КонецЕсли;
		
		//Добавим в соответствие код группы раскрытия и коды строк, использующих эту группу раскрытия.
		//Обычно это одна строка, но на всякий случай сделаем массив.
		Если ЗначениеЗаполнено(Стр.КодГруппыРаскрытия) Тогда
			ТекМассивСтрок = мСоответствиеКодовГруппРаскрытия[Стр.КодГруппыРаскрытия];
			Если ТекМассивСтрок = Неопределено Тогда
				ТекМассивСтрок = Новый Массив;
				ТекМассивСтрок.Добавить(Стр.КодСтрока);
			Иначе
				ТекМассивСтрок.Добавить(Стр.КодСтрока);
			КонецЕсли;
			мСоответствиеКодовГруппРаскрытия.Вставить(Стр.КодГруппыРаскрытия,ТекМассивСтрок);
		КонецЕсли;
	КонецЦикла;
		
	Если ТабОбластиРаскрытия.Количество() > 0 Тогда
		
		ЗаполнитьТаблицыРаскрытияИтогов(ТабДокумент);
		
		// Вывод макетов раскрытия в основной табличный документ.
		Для Каждого СтрРаскрытия ИЗ ТабОбластиРаскрытия Цикл
			
			ОбновитьРаскрытиеСтроки(ТабДокумент, СтрРаскрытия);
			
		КонецЦикла;
				
		Возврат Истина;
		
	Иначе
		
		Сообщить("В отчете отсутствуют строки, раскрываемые по аналитике.",СтатусСообщения.Важное);
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции // ВывестиРаскрытиеВТелеОтчета()

Процедура ЗаполнитьТаблицыРаскрытияИтогов(ТабДокумент) Экспорт
	
	Если ТабОбластиРаскрытия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьТаблицыРаскрытияИтогов();
		
	Если ТабОбластиРаскрытия.Количество() > 0 Тогда			
		Для Каждого СтрРаскрытиеИтогов Из ТабОбластиРасчетИтогов Цикл
			ОбновитьРаскрытиеСтрокиИтогов(ТабДокумент,СтрРаскрытиеИтогов);	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьТаблицыРаскрытияИтоговВСтруктуре(ТабДокумент,ДанныеОбластей,ТребуетсяПерерисовкаТаблицИтогов) Экспорт
	Если ТабОбластиРаскрытия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьТаблицыРаскрытияИтогов();
	
	Если ТабОбластиРаскрытия.Количество() > 0 Тогда			
		Для Каждого СтрРаскрытиеИтогов Из ТабОбластиРасчетИтогов Цикл
			ЗаполнитьДанныеОбластиРаскрытияСтрокиИтоговВСтруктуре(ТабДокумент,СтрРаскрытиеИтогов,ДанныеОбластей,ТребуетсяПерерисовкаТаблицИтогов);	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодготовитьТаблицыРаскрытияИтогов()
	
	Если ТабОбластиРаскрытия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабОбластиРасчетИтогов.Очистить();
	МассивНастроек = мНастройкиБланка.НайтиСтроки(Новый Структура("ЕстьРасчетныеИтоги",Истина));
	Если МассивНастроек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если мСоответствиеКодовГруппРаскрытия = Неопределено Тогда
		СтрокиОтчета = мПоказатели.Скопировать(,"КодСтрока,КодГруппыРаскрытия");
		СтрокиОтчета.Свернуть("КодСтрока,КодГруппыРаскрытия");
		
		мСоответствиеКодовГруппРаскрытия = Новый Соответствие;
	
		// Формирование таблиц раскрытия для каждой из строк, где есть раскрываемые показатели.
		Для Каждого Стр Из СтрокиОтчета Цикл			
			//Добавим в соответствие код группы раскрытия и коды строк, использующих эту группу раскрытия.
			//Обычно это одна строка, но на всякий случай сделаем массив.
			Если ЗначениеЗаполнено(Стр.КодГруппыРаскрытия) Тогда
				ТекМассивСтрок = мСоответствиеКодовГруппРаскрытия[Стр.КодГруппыРаскрытия];
				Если ТекМассивСтрок = Неопределено Тогда
					ТекМассивСтрок = Новый Массив;
					ТекМассивСтрок.Добавить(Стр.КодСтрока);
				Иначе
					ТекМассивСтрок.Добавить(Стр.КодСтрока);
				КонецЕсли;
				мСоответствиеКодовГруппРаскрытия.Вставить(Стр.КодГруппыРаскрытия,ТекМассивСтрок);
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	//тут нужно по мНастройкиБланка, где ЕстьРасчетныеИтоги построить таблицу, 
	//расчитать и вывести в бланк
	
	ТипЧисло = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя();
	КвалификаторЧисла  = ТипЧисло.КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, УровеньТочности));
	
	МассивСлужебныхКолонок = Новый Массив;
	МассивСлужебныхКолонок.Добавить("Аналитика");
	МассивСлужебныхКолонок.Добавить("_Отображение");
	МассивСлужебныхКолонок.Добавить("ID");
	МассивСлужебныхКолонок.Добавить("Индекс");
	МассивСлужебныхКолонок.Добавить("ПромежуточныеИтоги");
	
	Делитель = ВернутьЗначениеДелителя();
	СтрокаСлужебныхСимволов = СтрСоединить(БюджетнаяОтчетность.ПолучитьМассивСлужебныхСимволов());
	ДлинаИскомойСтроки = СтрДлина("ТекущаяСтрока.");
	//Данные для заполнения таблицы будем брать из ТабОбластиРаскрытия
	Для Каждого ТекСтрокаНастройки Из МассивНастроек Цикл
		
		РасчетныеКолонки = "";
		КолонкиСвертки = "";
		
		НоваяСтрокаРасчетаИтогов = ТабОбластиРасчетИтогов.Добавить();
		
		ТаблицаНастройкиРасчета = Новый ТаблицаЗначений;
		ТаблицаНастройкиРасчета.Колонки.Добавить("ИмяАналитики");
		ТаблицаНастройкиРасчета.Колонки.Добавить("КодГруппыРаскрытия");
		ТаблицаНастройкиРасчета.Колонки.Добавить("ФормулаРасчетаАналитики");
		
		ТекНастройка = ТекСтрокаНастройки.СтруктураНастроек.РасчетныеИтоги;
		ТаблицаРаскрытияИтогов = Новый ТаблицаЗначений;
		Инд = 1;
		
		МассивГруппРаскрытия = Новый Массив;
		Для Каждого СтрТЧ Из ТекНастройка.АналитикаИтогов Цикл
			ТаблицаРаскрытияИтогов.Колонки.Добавить("Аналитика" + Инд);
			РасчетныеКолонки = РасчетныеКолонки+ ","+ "Аналитика" + Инд;
			
			Для Каждого СтрСоответствия Из СтрТЧ.ТаблицаСоответствия Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрСоответствия.ГруппаРаскрытия) Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаНастройкиРасчета = ТаблицаНастройкиРасчета.Добавить();
				СтрокаНастройкиРасчета.ИмяАналитики = "Аналитика" + Инд;
				СтрокаНастройкиРасчета.КодГруппыРаскрытия = СтрСоответствия.ГруппаРаскрытия;
				СтрокаНастройкиРасчета.ФормулаРасчетаАналитики = СтрСоответствия.ФормулаАналитикиИтогов;
				
				Если МассивГруппРаскрытия.Найти(СтрСоответствия.ГруппаРаскрытия) = Неопределено Тогда
					МассивГруппРаскрытия.Добавить(СтрСоответствия.ГруппаРаскрытия);
				КонецЕсли;
			КонецЦикла;
			Инд = Инд + 1;
		КонецЦикла;
		
		НоваяСтрокаРасчетаИтогов.ТаблицаНастройкиРасчета = ТаблицаНастройкиРасчета;
		Если ТекНастройка.ПоказателиИтогов.Колонки.Найти("ЕстьОшибка") = Неопределено Тогда 
			ТекНастройка.ПоказателиИтогов.Колонки.Добавить("ЕстьОшибка",Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		Если ТекНастройка.ПоказателиИтогов.Колонки.Найти("СпособРасчета") = Неопределено Тогда 
			ТекНастройка.ПоказателиИтогов.Колонки.Добавить("СпособРасчета",Новый ОписаниеТипов("Строка"));
		КонецЕсли;
		Если ТекНастройка.ПоказателиИтогов.Колонки.Найти("ИндивидуальнаяТочность") = Неопределено Тогда 
			ТекНастройка.ПоказателиИтогов.Колонки.Добавить("ИндивидуальнаяТочность",Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		Если ТекНастройка.ПоказателиИтогов.Колонки.Найти("УровеньТочностиПоказателя") = Неопределено Тогда 
			ТекНастройка.ПоказателиИтогов.Колонки.Добавить("УровеньТочностиПоказателя",Новый ОписаниеТипов("Число"));
		КонецЕсли;
		
		Для Каждого СтрТЧ Из ТекНастройка.ПоказателиИтогов Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИмяПоказателя) Тогда
				СтрТЧ.ЕстьОшибка = Истина;
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрТЧ.СпособРасчета) Тогда
				СтрТЧ.СпособРасчета = "Сумма";//по умолчанию
			КонецЕсли;
			
			ТекУровеньТочностиПоказателя = Неопределено;
			ТекИндивидуальнаяТочность = Ложь;
			
			//Определим уровень точности (количество знаков после запятой) для показателя расчетных итогов.
			//Уровень точности определяется как максимальный уровень точности используемых в формуле показателей.
			//Если в формуле несколько показателей, и у одного показателя задан индивидуальный уровень точности 0,
			//а у другого показателя уровень точности авто - из настроек отчета, например, 2, то будет уровень точности 2.
			ТекФормула = СтрТЧ.Формула;
			МассивЧастейСтрокФормулы = СтрРазделить(ТекФормула,СтрокаСлужебныхСимволов,Ложь);
			Для Каждого ТекЧастьФормулы Из МассивЧастейСтрокФормулы Цикл
				ПозицияНачалаПоказателя = СтрНайти(ТекЧастьФормулы,"ТекущаяСтрока.");
				Если ПозицияНачалаПоказателя>0 Тогда
					КодНайденногоПоказателя = СокрЛП(Сред(ТекЧастьФормулы,ПозицияНачалаПоказателя+ДлинаИскомойСтроки));
					СтрокаНайденногоПоказателя =  мПоказатели.Найти(КодНайденногоПоказателя,"Код");
					Если СтрокаНайденногоПоказателя <> Неопределено Тогда
						Если СтрокаНайденногоПоказателя.ИндивидуальнаяТочность Тогда
							ТекИндивидуальнаяТочность = Истина;
							
							ТекЗначениеТочности = СтрокаНайденногоПоказателя.УровеньТочностиПоказателя
						Иначе
							 
							ТекЗначениеТочности = УровеньТочности;
						КонецЕсли;
						
						Если ТекУровеньТочностиПоказателя = Неопределено Тогда
							ТекУровеньТочностиПоказателя = ТекЗначениеТочности;
						Иначе
							ТекУровеньТочностиПоказателя = Макс(ТекУровеньТочностиПоказателя,ТекЗначениеТочности);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если ТекИндивидуальнаяТочность = Истина
				И ТекУровеньТочностиПоказателя <> Неопределено Тогда
				СтрТЧ.ИндивидуальнаяТочность = ТекИндивидуальнаяТочность;
				СтрТЧ.УровеньТочностиПоказателя = ТекУровеньТочностиПоказателя;
			КонецЕсли;
			
			
			Попытка	
				ТаблицаРаскрытияИтогов.Колонки.Добавить(СтрТЧ.ИмяПоказателя,ТипЧисло);
				ТаблицаРаскрытияИтогов.Колонки.Добавить(СтрТЧ.ИмяПоказателя + "_Отображение",ОписаниеТиповЧисло);
				КолонкиСвертки = КолонкиСвертки + ","+СтрТЧ.ИмяПоказателя+","+СтрТЧ.ИмяПоказателя + "_Отображение";
			Исключение
				ТекстСообщения = НСтр("ru='В группе расчета итогов ""%1"" имя показателя ""%2"" не может использоваться.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекСтрокаНастройки.ИмяЯчейки,СтрТЧ.ИмяПоказателя);
				ДобавитьСообщениевЛог(ТекстСообщения, СтатусСообщения.Внимание, БланкОтчета, "Отображения группы расчета итогов", Истина);
				СтрТЧ.ЕстьОшибка = Истина;
			КонецПопытки;
		КонецЦикла;
				
		//Пока добавим все показатели группы раскрытия в таблицу.
		//Потом добавим парсер, если потребуется.
		
		Для Каждого ТекГр Из МассивГруппРаскрытия Цикл
			МассивСтрок = мСоответствиеКодовГруппРаскрытия[ТекГр];
			Для Каждого ТекКодСтроки Из МассивСтрок Цикл
				ТекущаяСтрокаРаскрытия = ТабОбластиРаскрытия.Найти(ТекКодСтроки,"КодСтроки");
				Если ТекущаяСтрокаРаскрытия <> Неопределено Тогда 
					Для Каждого ТекКолонка Из ТекущаяСтрокаРаскрытия.ТаблицаРаскрытия.Колонки Цикл
						Если ЭтоСлужебноеИмяКолонки(ТекКолонка.Имя,МассивСлужебныхКолонок) Тогда
							Продолжить;
						КонецЕсли;
						
						Если Не ТекКолонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
							Продолжить;
						КонецЕсли;
						
						ТаблицаРаскрытияИтогов.Колонки.Добавить(ТекКолонка.Имя,ТекКолонка.ТипЗначения);
						
						КолонкиСвертки = КолонкиСвертки + ","+ТекКолонка.Имя;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		РасчетныеКолонки = Сред(РасчетныеКолонки,2);
		КолонкиСвертки = Сред(КолонкиСвертки,2);
		
		//заполним данные из групп раскрытия
		Для Каждого ТекГр Из МассивГруппРаскрытия Цикл
			МассивСтрок = мСоответствиеКодовГруппРаскрытия[ТекГр];
			МассивСтрокРасчетаТекущейГР = ТаблицаНастройкиРасчета.НайтиСтроки(Новый Структура("КодГруппыРаскрытия",ТекГР));
			
			Для Каждого ТекКодСтроки Из МассивСтрок Цикл
				ТекущаяСтрокаРаскрытия = ТабОбластиРаскрытия.Найти(ТекКодСтроки,"КодСтроки");
				Если ТекущаяСтрокаРаскрытия <> Неопределено Тогда 
					Для Каждого ТекущаяСтрока Из ТекущаяСтрокаРаскрытия.ТаблицаРаскрытия Цикл
						НоваяСтрока = ТаблицаРаскрытияИтогов.Добавить();
											
						Для Каждого СтрокаФормулы Из МассивСтрокРасчетаТекущейГР Цикл
							Значение = Неопределено;
							Если ЗначениеЗаполнено(СтрокаФормулы.ФормулаРасчетаАналитики) Тогда
								Попытка
									Значение = Вычислить(СтрокаФормулы.ФормулаРасчетаАналитики);
								Исключение
								КонецПопытки;
							КонецЕсли;
							НоваяСтрока[СтрокаФормулы.ИмяАналитики] = Значение;
						КонецЦикла;
						
						//В графе ПромежуточныеИтоги содержатся коды показателей, которые в текущей строке являются промежуточными.
						//Такие данные не загружаем.
						ТекРасчетныеИтоги = РасчетныеКолонки + ?(ЗначениеЗаполнено(ТекущаяСтрока.ПромежуточныеИтоги),",","")+ТекущаяСтрока.ПромежуточныеИтоги;
						
						ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекущаяСтрока,,РасчетныеКолонки);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ТаблицаДоСвертки = ТаблицаРаскрытияИтогов.Скопировать();
		ТаблицаДоСвертки.Индексы.Добавить(РасчетныеКолонки);
		
		//Свернем строки по аналитике
		ТаблицаРаскрытияИтогов.Свернуть(РасчетныеКолонки,КолонкиСвертки);
				
		//Расчитаем вычисляемые показатели
		Для Каждого ТекущаяСтрокаТаблицы Из ТаблицаРаскрытияИтогов Цикл
			
			СтруктураПоиска = Новый Структура(РасчетныеКолонки);
			ЗаполнитьЗначенияСвойств(СтруктураПоиска,ТекущаяСтрокаТаблицы);
			
			Для Каждого СтрТЧ Из ТекНастройка.ПоказателиИтогов Цикл
				Если СтрТЧ.ЕстьОшибка Тогда//Ошибка в имени показателя
					Продолжить;
				КонецЕсли;
				
				Если СтрТЧ.СпособРасчета = "Сумма" Тогда
					
					ТекущаяСтрока = ТекущаяСтрокаТаблицы;//для вычисления по формуле
					
					Значение = 0;
					Если ЗначениеЗаполнено(СтрТЧ.Формула) Тогда
						Попытка
							Значение = Вычислить(СтрТЧ.Формула);
						Исключение
							Значение = 0;
						КонецПопытки;
					КонецЕсли;
					
				ИначеЕсли СтрТЧ.СпособРасчета = "Минимум"
					ИЛИ СтрТЧ.СпособРасчета = "Максимум" Тогда
					
					СтрокиТаблицы = ТаблицаДоСвертки.НайтиСтроки(СтруктураПоиска);
					Значение = 0;
					
					Первый = Истина;
					Для Каждого НайденнаяСтрока Из СтрокиТаблицы Цикл
						
						ТекущаяСтрока = НайденнаяСтрока;//для вычисления по формуле
						
						ТекЗначение = 0;
						Если ЗначениеЗаполнено(СтрТЧ.Формула) Тогда
							Попытка
								ТекЗначение = Вычислить(СтрТЧ.Формула);
							Исключение
								ТекЗначение = 0;
							КонецПопытки;
						КонецЕсли;
						
						Если Первый Тогда
							Значение = ТекЗначение;
							Первый = Ложь;
						Иначе
							Если СтрТЧ.СпособРасчета = "Минимум" Тогда
								Значение = Мин(Значение,ТекЗначение);
							ИначеЕсли СтрТЧ.СпособРасчета = "Максимум" Тогда
								Значение = Макс(Значение,ТекЗначение);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
				ИначеЕсли СтрТЧ.СпособРасчета = "Среднее" Тогда
					
					ТекущаяСтрока = ТекущаяСтрокаТаблицы;//для вычисления по формуле
					
					Значение = 0;
					Если ЗначениеЗаполнено(СтрТЧ.Формула) Тогда
						Попытка
							Значение = Вычислить(СтрТЧ.Формула);
						Исключение
							Значение = 0;
						КонецПопытки;
					КонецЕсли;
					
					СтрокиТаблицы = ТаблицаДоСвертки.НайтиСтроки(СтруктураПоиска);
					КолСтрок = СтрокиТаблицы.Количество();
					Если КолСтрок>0 Тогда
						Значение = Значение/КолСтрок;
					КонецЕсли;
				КонецЕсли;
				
				ТекущаяСтрокаТаблицы[СтрТЧ.ИмяПоказателя] = Значение;
				Если СтрТЧ.НеМасштабируется = Ложь Тогда
					ТекущаяСтрокаТаблицы[СтрТЧ.ИмяПоказателя+"_Отображение"] = ТекущаяСтрокаТаблицы[СтрТЧ.ИмяПоказателя] / Делитель;
				Иначе
					ТекущаяСтрокаТаблицы[СтрТЧ.ИмяПоказателя+"_Отображение"] = ТекущаяСтрокаТаблицы[СтрТЧ.ИмяПоказателя];
				КонецЕсли;
			КонецЦикла;		
		КонецЦикла;
		
		ТаблицаДоСвертки = Неопределено;
		
		ТаблицаРаскрытияИтогов.Сортировать(РасчетныеКолонки);
		
		ТаблицаРаскрытияИтогов.Колонки.Добавить("Индекс", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
		ТаблицаРаскрытияИтогов.Колонки.Добавить("ID", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
	
		Индекс = 0;
		Для Каждого Строка Из ТаблицаРаскрытияИтогов Цикл // Восстановим нумерацию строк.		
			Строка.ID       = Индекс;
			Строка.Индекс	= Индекс + 1;
			Индекс = Индекс + 1;
		КонецЦикла;
		
		ИмяГруппыИтогов = Сред(ТекСтрокаНастройки.ИмяЯчейки,16);
		
		НоваяСтрокаРасчетаИтогов.КодСтроки = ИмяГруппыИтогов;
		НоваяСтрокаРасчетаИтогов.ТаблицаРаскрытия = ТаблицаРаскрытияИтогов;
		
		// определяем макет раскрытия
		МакетыРаскрытия = ВернутьМассивМакетовРаскрытия("РасчетныеИтоги_"+ИмяГруппыИтогов);
		
		НоваяСтрокаРасчетаИтогов.МакетыРаскрытия = МакетыРаскрытия;
	
		ТабДокРаскрытие = СгенерироватьМакетРаскрытияИтоговСтрока(ИмяГруппыИтогов, ТаблицаРаскрытияИтогов, ТекНастройка.АналитикаИтогов.Количество(), МакетыРаскрытия, ТекНастройка.ПоказателиИтогов);
	
		Если ТабДокРаскрытие = Неопределено Тогда
			ТабДокРаскрытие = Новый ТабличныйДокумент;
		КонецЕсли;
		
		НоваяСтрокаРасчетаИтогов.ТабДокРаскрытие = ТабДокРаскрытие;
	КонецЦикла;
	

КонецПроцедуры

Процедура ЗаполнитьДанныеОбластиРаскрытияСтрокиИтоговВСтруктуре(ТабДокумент, СтрРаскрытия, ДанныеОбластей,ТребуетсяПерерисовкаТаблицИтогов)
	
	Обл = ТабДокумент.Области.Найти("СтрокаИтогов_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСтрокиИтогов = "РасчетныеИтоги_" + СтрРаскрытия.КодСтроки;
	ВысотаСтрокиИтогов = СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы;
		
	НужнаПерерисовка = Ложь;
	Если СтруктураДанныхВТаблицахИтогов.Свойство(ИмяСтрокиИтогов) Тогда
		Если СтруктураДанныхВТаблицахИтогов[ИмяСтрокиИтогов] <> ВысотаСтрокиИтогов Тогда
			НужнаПерерисовка = Истина;
		КонецЕсли;
	Иначе
		НужнаПерерисовка = Истина;
	КонецЕсли;
	
	ТребуетсяПерерисовкаТаблицИтогов = ТребуетсяПерерисовкаТаблицИтогов ИЛИ НужнаПерерисовка;
	
	Если ТребуетсяПерерисовкаТаблицИтогов Тогда
		//Если изменилась высота таблицы итого, необходимо идти на сервер и заменить область итогов,
		//поэтому передавать отдельно изменения данных области в структуре нет смысла.
		Возврат;
	КонецЕсли;
		
	Для Каждого ТекОбл Из СтрРаскрытия.ТабДокРаскрытие.Области Цикл
		Если ТекОбл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЗначенийОбласти = Новый Структура;
		Если ТекОбл.СодержитЗначение Тогда
			СтруктураЗначенийОбласти.Вставить("Значение",ТекОбл.Значение);
		Иначе
			СтруктураЗначенийОбласти.Вставить("Текст",ТекОбл.Текст);
		КонецЕсли;
		
		ДанныеОбластей.Вставить(ТекОбл.Имя,СтруктураЗначенийОбласти);
				
	КонецЦикла;
	
КонецПроцедуры // ОбновитьРаскрытиеСтроки()

Функция ЭтоСлужебноеИмяКолонки(ИмяКолонки,МассивСлужебныхИмен)
	
	Для Каждого ЭлМас Из МассивСлужебныхИмен Цикл
		Если Найти(ИмяКолонки,ЭлМас)>0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции


Функция СгенерироватьМакетРаскрытияИтоговСтрока(ИмяОбластиРасчетныхИтогов,ИсходнаяТаблицаРаскрытия, КоличествоАналитик, МакетыРаскрытия, ПоказателиИтогов) Экспорт
	
	КодГруппыРаскрытия = "РасчетныеИтоги";
	КодСтроки = ИмяОбластиРасчетныхИтогов;
	
	Макет = Новый ТабличныйДокумент;
	
	МакетРаскрытияШапка		= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Шапка = Неопределено	, Неопределено, МакетыРаскрытия.Шапка.ПолучитьОбласть());
	МакетРаскрытияСтрока	= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Строка = Неопределено, Неопределено, МакетыРаскрытия.Строка.ПолучитьОбласть());
	МакетРаскрытияПодвал	= ?(МакетыРаскрытия = Неопределено ИЛИ МакетыРаскрытия.Подвал = Неопределено, Неопределено, МакетыРаскрытия.Подвал.ПолучитьОбласть());
	
	Инд=1;
	
	ТаблицаРаскрытия = ИсходнаяТаблицаРаскрытия.Скопировать();
			
	ЕстьШапка=НЕ МакетРаскрытияШапка=Неопределено;
	ЕстьПодвал = НЕ МакетРаскрытияПодвал = Неопределено;
	
	Если МакетРаскрытияСтрока = Неопределено Тогда
		Возврат Макет;
	КонецЕсли;
	
	// Получение модифицированного квалификатора числа
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, УровеньТочности));
	
	// Получение модифицированного квалификатора строки
	КвалификаторСтроки           = БюджетнаяОтчетность.ПолучитьОписаниеТиповРесурсаЗначениеПоказателя().КвалификаторыСтроки;
	КвалификаторПеременнойСтроки = Новый КвалификаторыСтроки(КвалификаторСтроки.Длина,ДопустимаяДлина.Переменная);
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если ТаблицаРаскрытия.Количество() > 0 Тогда
		
		МакетТаблЧасти = Новый ТабличныйДокумент;
		СуммыПоПоказателям = Новый Структура;
				
		ФормулыЯчеек = Новый Соответствие;
		Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
			
			НастройкиЯчейки = мНастройкиБланка.Найти(Обл.Имя,"ИмяЯчейки");
			Если НастройкиЯчейки <> Неопределено И НастройкиЯчейки.ЕстьПредставление Тогда
				ФормулыЯчеек.Вставить(Обл.Имя,НастройкиЯчейки.СтруктураНастроек.Представление);
			КонецЕсли;
			
		КонецЦикла;
				
		// Определение полей макета
		ОпределениеПолейМакета = Новый ТаблицаЗначений;
		ОпределениеПолейМакета.Колонки.Добавить("ИмяОбласти");
		ОпределениеПолейМакета.Колонки.Добавить("Ресурс");
		ОпределениеПолейМакета.Колонки.Добавить("ИмяРеквизита");
		ОпределениеПолейМакета.Колонки.Добавить("ЭтоАналитика");
		ОпределениеПолейМакета.Колонки.Добавить("СпособЗаполнения");
		
		НовСтр = ОпределениеПолейМакета.Добавить();
		НовСтр.ИмяОбласти = КодГруппыРаскрытия +"_"+КодСтроки+"_НомерСтроки";
		НовСтр.ИмяРеквизита = "";
		НовСтр.Ресурс = "НомерСтроки";
		НовСтр.ЭтоАналитика = "Ложь";
		
		ДлинаПрефиксаПоказателя = СтрДлина(СокрЛП(КодГруппыРаскрытия)+"_"+СокрЛП(КодСтроки) + "_Показатель_");
		
		Для Каждого Обл Из МакетРаскрытияСтрока.Области Цикл
			
			Если Обл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник ИЛИ (Обл.СодержитЗначение <> Истина И Обл.АвтоотметкаНезаполненного = Ложь) Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяОбласти 		 = СокрЛП(Обл.Имя);
			КодыИмениОбласти = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяОбласти,"_");
			
			Если Не (КодыИмениОбласти[0] = КодГруппыРаскрытия 
				И КодыИмениОбласти[1] = КодСтроки 
				И КодыИмениОбласти.Количество() > 2) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоОбластьРеквизитаОднойИзАналитик = Ложь;
			Для НомерАналитики = 1 По КоличествоАналитик Цикл
				Если КодыИмениОбласти[2] = ("Аналитика" + НомерАналитики) 
					И ТаблицаРаскрытия.Колонки.Найти("Аналитика" + НомерАналитики) <> Неопределено Тогда
					ЭтоОбластьРеквизитаОднойИзАналитик = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭтоОбластьРеквизитаОднойИзАналитик Тогда
				
				ИмяРеквизита = ?(КодыИмениОбласти.Количество() > 3,КодыИмениОбласти[3],"");
				
				СтрОписание = ОпределениеПолейМакета.Добавить();
				СтрОписание.ИмяОбласти 	 = ИмяОбласти;
				СтрОписание.Ресурс		 = "Аналитика" + НомерАналитики;
				СтрОписание.ИмяРеквизита = ИмяРеквизита;
				СтрОписание.ЭтоАналитика = Истина;
								
			Иначе
							
				КодПоказателя = Сред(ИмяОбласти, ДлинаПрефиксаПоказателя + 1);
				
				Если ТаблицаРаскрытия.Колонки.Найти(КодПоказателя) <> Неопределено Тогда
					
					СтрОписание = ОпределениеПолейМакета.Добавить();
					СтрОписание.ИмяОбласти 	 = ИмяОбласти;
					СтрОписание.Ресурс		 = КодПоказателя;
					СтрОписание.ЭтоАналитика = Ложь;
					
					Если Обл.СодержитЗначение Тогда
						
						СтрОписание.СпособЗаполнения = 1;
						
						ТекПоказательИтогов = ПоказателиИтогов.Найти(КодПоказателя,"ИмяПоказателя");
						
						Если ТекПоказательИтогов <> Неопределено Тогда
							Если ТекПоказательИтогов.ИндивидуальнаяТочность 
								И ТекПоказательИтогов.УровеньТочностиПоказателя <> УровеньТочности Тогда
								РазрядностьЧисла= КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - ТекПоказательИтогов.УровеньТочностиПоказателя);
								Обл.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, ТекПоказательИтогов.УровеньТочностиПоказателя));
							Иначе						
								Обл.ТипЗначения = ОписаниеТиповЧисло;
							КонецЕсли;
						Иначе
							Обл.ТипЗначения = ОписаниеТиповЧисло;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		//ЦветПоляПромежуточногоИтога = Новый Цвет(255,253,253);
		
		// Сбор дополнительных данных не применяем. Все что нужно, можно задать в формуле.
		
		ПрименитьПараметрыОтображенияИтогов(МакетРаскрытияСтрока,ТаблицаРаскрытия, ПоказателиИтогов);
		
		ОпределениеПолейМакета.Индексы.Добавить("ИмяОбласти");
		
		Для Каждого Стр Из ТаблицаРаскрытия Цикл // для каждой строки таблицы раскрытий
			
			КопияМакетаРаскрытия = МакетРаскрытияСтрока.ПолучитьОбласть(); // создаем копию макета раскрытия
			МассивОбластей = Новый Массив;
			
			ИндексСтроки = Формат(Стр.ID,"ЧН=0; ЧГ=0");
			
			Для Каждого Обл Из КопияМакетаРаскрытия.Области Цикл // Первоначальный набор областей необходимо сохранить
				МассивОбластей.Добавить(Обл);
			КонецЦикла;
			
			Для Каждого Обл Из МассивОбластей Цикл // обходим по областям
				
				ИмяОбласти = Обл.Имя;
				ОписаниеОбласти = ОпределениеПолейМакета.Найти(ИмяОбласти,"ИмяОбласти");
				
				Если ОписаниеОбласти <> Неопределено Тогда
				
					Если ОписаниеОбласти.ЭтоАналитика Тогда
						ЗначениеАналитики = Стр[ОписаниеОбласти.Ресурс];
						ИмяРеквизита	  = ОписаниеОбласти.ИмяРеквизита;
						
						Формула = ФормулыЯчеек[ИмяОбласти];
						
						Значение = Неопределено;
						Если ЗначениеЗаполнено(Формула) Тогда
							Попытка
								ТекущаяСтрока = Стр;
								Значение = Вычислить(Формула);
							Исключение
							КонецПопытки;
						КонецЕсли;
						
						//На данный момент не поддерживается формирование значению по реквизиту аналитики,
						//заданному в имени ячейки.
						//Т.к. явного типа у аналитики нет (а в разных конфигурациях, тип может быть разный).
						//Часто это будет строка.
						//Поэтому стоит задавать нужное представление в формуле аналитики или представлении ячейки.					
						
						Попытка // возможно несоответствие типов
							Если Значение = Неопределено Тогда
								Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеАналитики)) Тогда
									Если ИмяРеквизита = "Идентификатор" Тогда
										Значение = ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеАналитики);
									Иначе
										Значение = Стр[Строка(ОписаниеОбласти.Ресурс)];
									КонецЕсли;							
								Иначе
									Значение = Стр[Строка(ОписаниеОбласти.Ресурс)];//
								КонецЕсли;					
							КонецЕсли;
							
							Обл.Значение 	= Значение;
							Обл.Расшифровка = Стр[ОписаниеОбласти.Ресурс];
							
						Исключение		
							Если ТипЗнч(ЗначениеАналитики) = Тип("Строка") Тогда //Вывод "сырых" значений
								Значение = ЗначениеАналитики;
							КонецЕсли;					
						КонецПопытки;
											
						Обл.Значение = Значение;
						Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
						
					Иначе
						Если ОписаниеОбласти.Ресурс = "НомерСтроки" Тогда
							
							Формула = ФормулыЯчеек[ИмяОбласти];
						
							НомерСтроки = Стр["ID"]+1;
							Если ЗначениеЗаполнено(Формула) Тогда
								Попытка
									ТекущаяСтрока = Стр;
									НомерСтроки = Вычислить(Формула);
								Исключение
								КонецПопытки;
							КонецЕсли;
							
							Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
							Если Обл.СодержитЗначение Тогда
						    	Обл.Значение = НомерСтроки;
							Иначе
								Обл.Текст = НомерСтроки;
							КонецЕсли;
						Иначе
							ЗначениеПоказателя  = Стр[ОписаниеОбласти.Ресурс + "_Отображение"];
							Обл.Имя = ОписаниеОбласти.ИмяОбласти + "_" + ИндексСтроки;
							Если ОписаниеОбласти.СпособЗаполнения = 1 Тогда							
														
								Попытка // возможно несоответствие типов
									Обл.Значение = ЗначениеПоказателя;
								Исключение
								КонецПопытки;
								
							ИначеЕсли ОписаниеОбласти.СпособЗаполнения = 2 Тогда
								
								Обл.Текст = ЗначениеПоказателя;
								
							КонецЕсли;
						КонецЕсли;						
					КонецЕсли;
					
				Иначе
					//вывод параметров в строке раскрытия
					Формула = ФормулыЯчеек[ИмяОбласти];
					Если Формула = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Значение = Неопределено;
					Если ЗначениеЗаполнено(Формула) Тогда
						Попытка
							ТекущаяСтрока = Стр;
							Значение = Вычислить(Формула);
						Исключение
						КонецПопытки;
					КонецЕсли;
					
					Если Обл.СодержитЗначение Тогда
						Обл.Значение = Значение;
					Иначе
						Обл.Текст = Значение;
					КонецЕсли;
					Обл.Имя = Обл.Имя + "_" + ИндексСтроки;
						
				КонецЕсли;
				
			КонецЦикла;
			МакетТаблЧасти.Вывести(КопияМакетаРаскрытия); // выводим строку - макет раскрытия со значениями в основной макет раскрытий
		КонецЦикла;
		
		Если ЕстьШапка Тогда
			ВывестиСекциюВМакет(Макет, МакетРаскрытияШапка);
		КонецЕсли;
		
		ВывестиСекциюВМакет(Макет, МакетТаблЧасти);
		
		Если ЕстьПодвал Тогда
			ВывестиСекциюВМакет(Макет, МакетРаскрытияПодвал);
		КонецЕсли;
	КонецЕсли;
	Макет.Область(1, 0, Макет.ВысотаТаблицы, 0).Видимость = Истина;
	
	Возврат Макет;
	
КонецФункции

Процедура ПрименитьПараметрыОтображенияИтогов(ТаблДок,ТаблицаРаскрытияИтогов,ПоказателиИтогов) Экспорт
	
	ДлинаПоказатель = СтрДлина("_Показатель_");
	СоответствиеФорматСписок = Новый Соответствие;
	СоответствиеФорматСтрока = Новый Соответствие;
	Для Каждого Обл Из ТаблДок.Области Цикл
		
		Если Обл.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник ИЛИ Обл.СодержитЗначение <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОбласти = Обл.Имя;
		Если Прав(ИмяОбласти, 6) <> "_СУММА" Тогда
			
			КоординатаПоследнего_ = Найти(ИмяОбласти, "_");
			
			Если КоординатаПоследнего_ > 0 Тогда
				Длина = СтрДлина(ИмяОбласти);
				КодПодчеркивания = КодСимвола("_");
				Для Инд = 0 По Длина - КоординатаПоследнего_ Цикл
					Если КодСимвола(ИмяОбласти, Длина - Инд) = КодПодчеркивания Тогда						
						КоординатаПоследнего_ = Длина - Инд;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Окончание = Сред(ИмяОбласти, КоординатаПоследнего_ + 1);
				
				Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Окончание) И НЕ ПустаяСтрока(Окончание) Тогда
					КодПоказателя = Лев(ИмяОбласти, КоординатаПоследнего_ - 1);
					Вхождение_Показатель_ = Найти(КодПоказателя, "_Показатель_");
					Если Вхождение_Показатель_ <>0 Тогда
						КодПоказателя = Сред(КодПоказателя, Вхождение_Показатель_ + ДлинаПоказатель);
					КонецЕсли;
				ИначеЕсли Найти(ИмяОбласти, "_Показатель_") <> 0 И НЕ ПустаяСтрока(Окончание) Тогда
					КодПоказателя = ИмяОбласти;
					Вхождение_Показатель_ = Найти(КодПоказателя, "_Показатель_");
					Если Вхождение_Показатель_ <>0 Тогда
						КодПоказателя = Сред(КодПоказателя, Вхождение_Показатель_ + ДлинаПоказатель);
					КонецЕсли;
				ИначеЕсли Найти(ИмяОбласти, "_Аналитика")>0 Тогда
					Продолжить;
				Иначе
					КодПоказателя = ИмяОбласти;
				КонецЕсли;
			Иначе
				КодПоказателя = ИмяОбласти;
			КонецЕсли;
			
			Если ТаблицаРаскрытияИтогов.Колонки.Найти(КодПоказателя) <> Неопределено Тогда
				
				СтрокаПИ = ПоказателиИтогов.Найти(КодПоказателя,"ИмяПоказателя");
				
				Если СтрокаПИ<>Неопределено
					И СтрокаПИ.ИндивидуальнаяТочность
					И УровеньТочности <> СтрокаПИ.УровеньТочностиПоказателя Тогда
					
					ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
					Если ПолученныйРанееСписок = Неопределено Тогда
						ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
						ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
						СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
					КонецЕсли;
					
					СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
					СписокФорматов.Вставить("ЧДЦ", Строка(СтрокаПИ.УровеньТочностиПоказателя));
					
					Обл.Формат = ПреобразоватьВСтрокуФормата(СписокФорматов);
					
				Иначе
					
					УстанавливаемыйФормат = СоответствиеФорматСтрока[Обл.Формат];
						
					Если УстанавливаемыйФормат = Неопределено Тогда
						ПолученныйРанееСписок = СоответствиеФорматСписок.Получить(Обл.Формат);
						Если ПолученныйРанееСписок = Неопределено Тогда
							ПолученныйРанееСписок = ПолучитьСписокПараметровФормата(Обл.Формат);
							ПолученныйРанееСписок.Вставить("ЧДЦ", Строка(УровеньТочности));
							СоответствиеФорматСписок.Вставить(Обл.Формат,ПолученныйРанееСписок);						
						КонецЕсли;
						СписокФорматов = Новый Соответствие(Новый ФиксированноеСоответствие(ПолученныйРанееСписок));
						
						УстанавливаемыйФормат = ПреобразоватьВСтрокуФормата(СписокФорматов);
						СоответствиеФорматСтрока.Вставить(Обл.Формат,УстанавливаемыйФормат);
											
					КонецЕсли;
					
					Обл.Формат = УстанавливаемыйФормат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Обновление таблицы раскрытия в основном бланке.
//
Процедура ОбновитьРаскрытиеСтрокиИтогов(ТабДокумент, СтрРаскрытия) Экспорт
	
	Обл = ТабДокумент.Области.Найти("СтрокаИтогов_"+СтрРаскрытия.КодСтроки);
	Если Обл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИскомаяСтрока = "РасчетныеИтоги_" + СтрРаскрытия.КодСтроки;
	
	//сохраним значение высоты таблицы раскрытия, чтобы потом можно было оптимизированной процедурой обновить данные в бланке
	СтруктураДанныхВТаблицахИтогов.Вставить(ИскомаяСтрока,СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы);

	// Удаляем предыдущие строки раскрытия
	Верх = Обл.Верх;
	
	НачБлокаУдаления = Обл.Верх+1;
	КонБлокаУдаления = Обл.Верх;
		
	ОбластьШапки = ТабДокумент.Области.Найти(ИскомаяСтрока + "_Шапка");
	Если ОбластьШапки <> Неопределено Тогда
		КонБлокаУдаления = ОбластьШапки.Низ;
	КонецЕсли;
	
	ОбластьПодвал = ТабДокумент.Области.Найти(ИскомаяСтрока + "_Подвал");
	Если ОбластьПодвал <> Неопределено Тогда
		КонБлокаУдаления = ОбластьПодвал.Низ;
	Иначе
		НомерКолонки = Обл.Лево;
		
		Для Кол = Обл.Лево По ТабДокумент.ШиринаТаблицы Цикл

			ИмяОбласти = ТабДокумент.Область(КонБлокаУдаления+1,Кол).Имя;

			Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")=1
				ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")=1
				ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_РазметкаПустойСтроки")=1 Тогда
				НомерКолонки = Кол;
				Прервать;
			КонецЕсли;
					
		КонецЦикла;
		
		//в детальных строках раскрытия всегда есть область с именем КодГруппыРаскрытия_КодСтроки
		ВысотаСтрокиРаскрытия = 1;
		ОбластьСтроки = ТабДокумент.Области.Найти(ИскомаяСтрока);
		Если ОбластьСтроки <> Неопределено Тогда
			ВысотаСтрокиРаскрытия = ОбластьСтроки.Низ - ОбластьСтроки.Верх + 1;
		КонецЕсли;
		
		//т.к. в строке раскрытия высота может быть больше 1 строки, а в первой ячейке будет заполнена не на всю высоту,
		//то это надо учитывать при определении областей раскрытия, которые надо удалить
		
		Пока Истина Цикл
			
			ИмяОбласти = ТабДокумент.Область(КонБлокаУдаления+1,НомерКолонки).Имя; //КонБлокаУдаления+1 - следующая строка, после текущей строки раскрытия
			
			Если Найти(ИмяОбласти, ИскомаяСтрока + "_Аналитика")=1
				ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_Показатель")=1 
				ИЛИ Найти(ИмяОбласти, ИскомаяСтрока + "_РазметкаПустойСтроки")=1 Тогда
				КонБлокаУдаления=КонБлокаУдаления+ВысотаСтрокиРаскрытия;  //учитываем эту строку раскрытия
				
			Иначе
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	ОбластьУдаления=ТабДокумент.Область(НачБлокаУдаления,,КонБлокаУдаления,);
	
	Если КонБлокаУдаления>=НачБлокаУдаления Тогда
		ТабДокумент.УдалитьОбласть(ОбластьУдаления,ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Если СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы>0 Тогда
		ОбластьИсточник = СтрРаскрытия.ТабДокРаскрытие.Область(1,,СтрРаскрытия.ТабДокРаскрытие.ВысотаТаблицы);
		ОбластьВставки  = ТабДокумент.Область(НачБлокаУдаления,,НачБлокаУдаления);
		ТабДокумент.ВставитьОбласть(ОбластьИсточник,ОбластьВставки,ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;	
КонецПроцедуры // ОбновитьРаскрытиеСтрокиИтогов()



// Определяет все обязательные к заполнению аналитики группы раскрытия.
//
Функция ВернутьМассивОбязательныхАналитик(СтрокаГруппыРаскрытия) Экспорт
	
	МассивОбязательныхАналитик = Новый Массив;
	
	Для Инд = 1 По СтрокаГруппыРаскрытия.ЧислоАналитик Цикл
		Если СтрокаГруппыРаскрытия["ОбязательнаяАналитика" + Инд] Тогда
			МассивОбязательныхАналитик.Добавить("Аналитика" + Инд);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОбязательныхАналитик;
	
КонецФункции

// Определяет, будут ли свернуты строки по одинаковым аналитикам.
//
Функция ЕстьСтрокиПодлежащиеСвертке(СтрРаскрытия,РучнаяСвертка = Ложь) Экспорт
	
	СтрГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрРаскрытия.ГруппаРаскрытия);
	
	Если СтрГруппыРаскрытия.РазрешитьСовпаденияИзмерений И НЕ РучнаяСвертка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЧислоАналитикГруппы = СтрГруппыРаскрытия.ЧислоАналитик;
	СтрСвертки = "";
	Для Сч = 1 По ЧислоАналитикГруппы Цикл
		
		СтрСвертки = СтрСвертки + ",Аналитика"+Сч;
		
	КонецЦикла;
	
	ВремТаб = СтрРаскрытия.ТаблицаРаскрытия.Скопировать();	
	ВремТаб.Свернуть(Сред(СтрСвертки,2));
	
	Возврат (ВремТаб.Количество() <> СтрРаскрытия.ТаблицаРаскрытия.Количество());
	
КонецФункции

// Сворачивает строки по одинаковым значениям измерений без потери значений нечисловых показателей.
//
// Параметры:
//  СтрокиПоказателей - Массив строк таблицы мПоказатели для которых выполнить свертку.
//
Процедура ИнтеллектуальнаяСверткаПоАналитике(Знач ТаблицаРаскрытия, Знач ГруппаРаскрытия) Экспорт

	ПараметрыГруппы = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	
	СтрАналитик     = "";
	СтруктураПоиска = Новый Структура;
	
	Для Сч = 1 По ПараметрыГруппы.ЧислоАналитик Цикл
		СтрАналитик = СтрАналитик + ",Аналитика" + Сч;
		СтруктураПоиска.Вставить("Аналитика" + Сч, Неопределено);
	КонецЦикла;
	
	СтрАналитик = Сред(СтрАналитик,2);
	ТаблицаРаскрытия.Сортировать(СтрАналитик, Новый СравнениеЗначений);
	
	ДублиСтроковыхПоказателей = Новый Соответствие;
	ПоказателиГруппы          = мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	СвернутаяТаблица          = ТаблицаРаскрытия.СкопироватьКолонки();
	СвернутаяТаблица.Индексы.Добавить(СтрАналитик);
	
	Пока ТаблицаРаскрытия.Количество() > 0 Цикл
		
		СтрокаОбработки = ТаблицаРаскрытия[0];
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОбработки);
		
		СтрокиИтогов = СвернутаяТаблица.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИтогов.Количество() Тогда
			
			СтрокаИтогов = СтрокиИтогов[0];
			Для Каждого Показатель Из ПоказателиГруппы Цикл
				
				ЗначениеПоказателя = СтрокаОбработки[Показатель.Код];
				ЗначениеИтога      = СтрокаИтогов[Показатель.Код];
				
				Если Показатель.ТипЗначения = ТипЗначенияЧисло Тогда
					
					// Числовые показатели суммируются.
					СтрокаИтогов[Показатель.Код] = ЗначениеИтога + ЗначениеПоказателя;
					
				ИначеЕсли Показатель.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
					
					// Даты устанавливаются в зависимости от типа итога показателя - Максимум или Минимум
					// Если итог не установлен берется максимальное значение.
					
					Если Не ЗначениеЗаполнено(ЗначениеИтога) Тогда
						СтрокаИтогов[Показатель.Код] = ЗначениеПоказателя;
						Продолжить;
					КонецЕсли;
					
					Если Показатель.ВидИтога = Перечисления.ВидыИтоговПоказателя.Минимум Тогда
						СтрокаИтогов[Показатель.Код] = Мин(ЗначениеПоказателя,ЗначениеИтога);
					Иначе
						СтрокаИтогов[Показатель.Код] = Макс(ЗначениеПоказателя,ЗначениеИтога);
					КонецЕсли;
					
				ИначеЕсли Показатель.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
					// Булевы переменные объединяются по ИЛИ
					СтрокаИтогов[Показатель.Код] = ЗначениеИтога ИЛИ ЗначениеПоказателя;
					
				ИначеЕсли Показатель.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
					// Строковые показатели объединяются, причем одинаковые строки добавляются в единственном экземпляре
					
					ЗначенияСтрок = ДублиСтроковыхПоказателей[СтрокаИтогов];
					Если ЗначенияСтрок = Неопределено Тогда
						ЗначенияСтрок = Новый Массив;
						ЗначенияСтрок.Добавить(ЗначениеПоказателя);
						ДублиСтроковыхПоказателей[СтрокаИтогов] = ЗначенияСтрок;
					КонецЕсли;
					
					Если ЗначенияСтрок.Найти(ЗначениеПоказателя) = Неопределено Тогда
						ЗначенияСтрок.Добавить(ЗначениеПоказателя);
						СтрокаИтогов[Показатель.Код] = ЗначениеИтога + " " + ЗначениеПоказателя;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			СтрИтог = СвернутаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрИтог, СтрокаОбработки);
			
			Для Каждого Показатель Из ПоказателиГруппы Цикл
				Если Показатель.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
					// Строковые показатели объединяются, причем одинаковые строки добавляются в единственном экземпляре
					
					ЗначениеПоказателя = СтрокаОбработки[Показатель.Код];
					
					ЗначенияСтрок = ДублиСтроковыхПоказателей[СтрИтог];
					Если ЗначенияСтрок = Неопределено Тогда
						ЗначенияСтрок = Новый Массив;
						ЗначенияСтрок.Добавить(ЗначениеПоказателя);
						ДублиСтроковыхПоказателей[СтрИтог] = ЗначенияСтрок;
					КонецЕсли;
					
					Если ЗначенияСтрок.Найти(ЗначениеПоказателя) = Неопределено Тогда
						ЗначенияСтрок.Добавить(ЗначениеПоказателя);
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТаблицаРаскрытия.Удалить(0);
		
	КонецЦикла;
	
	СвернутаяТаблица.Колонки.Удалить("Индекс"); // Для перенумерации
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, СвернутаяТаблица, Ложь);

КонецПроцедуры // ИнтеллектуальнаяСверткаПоАналитике()

// Формирует таблицу значений, соответствующую раскрытию, в которой в каждой строке
// содержутся значения показателей группы раскрытия по уникальной комбинации значений аналитик.
//
Функция ПолучитьТаблицуРаскрытия(Знач СтрокаГруппыРаскрытия, КодСтроки="") Экспорт
	
	// создаем таблицу описания раскрываемых показателей
	ПоказателиКолонки = Новый ТаблицаЗначений;
	ПоказателиКолонки.Колонки.Добавить("Ссылка");
	ПоказателиКолонки.Колонки.Добавить("Код");
	ПоказателиКолонки.Колонки.Добавить("Наименование");
	ПоказателиКолонки.Колонки.Добавить("ТипЗначения");
	
	ПоказателиКолонки.Индексы.Добавить("Ссылка");
	
	СтруктураПоиска=Новый Структура;
	
	РежимСовместимости = ТипЗнч(СтрокаГруппыРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия");
	
	Если КодСтроки="" Тогда
		
		Если РежимСовместимости Тогда
			СтруктураПоиска.Вставить("ГруппаРаскрытия", СтрокаГруппыРаскрытия); // Обеспечение совместимости с WEB-приложением.
		Иначе
			СтруктураПоиска.Вставить("ГруппаРаскрытия", СтрокаГруппыРаскрытия.ГруппаРаскрытия);
		КонецЕсли;
		
	Иначе
		СтруктураПоиска.Вставить("КодСтрока", КодСтроки);
	КонецЕсли;
	
	Если РежимСовместимости Тогда
		СтрокаГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтрокаГруппыРаскрытия);
	КонецЕсли;
	
	ПоказателиКолонки = мПоказатели.Скопировать(СтруктураПоиска);
	//ПоказателиКолонки.Сортировать("ПорядковыйНомерКолонки");
	
	СтрСверткиАналитики="";
	СтрСверткиПоказатели="";
	
	// создаем таблицу, со строками - комбинациями значений аналитик и колонками - показателями
	
	ТаблицаРаскрытия = Новый ТаблицаЗначений;
	Для Инд = 1 По мЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(СтрокаГруппыРаскрытия["ВидАналитики" + Инд]) Тогда
			
			ТипКолонки = СтрокаГруппыРаскрытия["ТипЗначенияАналитики" + Инд];				
			ТаблицаРаскрытия.Колонки.Добавить("Аналитика" + Инд, ТипКолонки, СтрокаГруппыРаскрытия["ВидАналитики" + Инд]);
			
		КонецЕсли;
	КонецЦикла;
	
	ЧислоАналитик = ТаблицаРаскрытия.Колонки.Количество();
	
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, УровеньТочности));
	
	ДанныеПоказателей = Новый Соответствие;
	
	Для Каждого Пок Из ПоказателиКолонки Цикл
		
		ДанныеПоказателей.Вставить(Пок.Ссылка,Пок);
		
		Если ТаблицаРаскрытия.Колонки.Найти(Пок.Код) = Неопределено Тогда
			
			ТаблицаРаскрытия.Колонки.Добавить(Пок.Код, БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения), Пок.НаименованиеКолонки);
			ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения);
			
			Если Пок.ИндивидуальнаяТочность 
				И Пок.УровеньТочностиПоказателя <> УровеньТочности Тогда
				РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Пок.УровеньТочностиПоказателя);
				ТекОписаниетипов = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, Пок.УровеньТочностиПоказателя));
			Иначе
				ТекОписаниетипов = ОписаниеТиповЧисло;
			КонецЕсли;
			
			ТаблицаРаскрытия.Колонки.Добавить(Пок.Код + "_Отображение", 
				?(ТипЗначения.СодержитТип(Тип("Число"))
					, ТекОписаниетипов
					, ТипЗначения),
				Пок.Наименование + "_Отображение");
			
		КонецЕсли;
		
	КонецЦикла;
		
	ТаблицаРаскрытия.Колонки.Добавить("Индекс", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
	ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	
	Если ПоказателиКолонки.Количество()>0 Тогда
		НовИндекс = мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
		
		РабТаблица = мПоказателиРаскрытия.Скопировать(Новый Структура("ГруппаРаскрытия",ПоказателиКолонки[0].ГруппаРаскрытия));
		
		мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
	Иначе
		РабТаблица = мПоказателиРаскрытия.СкопироватьКолонки();		
	КонецЕсли;
	
	РабТаблица.Сортировать("Индекс");
	
	ПризнакОшибки = Ложь;
		
	ТекущийИндекс 			= -1;
	СтрРаскрытие 			= Неопределено;
	Делитель = ВернутьЗначениеДелителя();	
	Для Каждого Стр Из РабТаблица Цикл
		
		РезультатПоискаПоказателя = ДанныеПоказателей[Стр.Показатель];
		
		Если РезультатПоискаПоказателя.ТипЗначения = ТипЗначенияЧисло Тогда
			
			ТекЗначение = ?(Стр.Значение=Неопределено,0,Стр.Значение);
			
			Если НЕ РезультатПоискаПоказателя.НеМасштабируется
				И Делитель <> 1 Тогда
				ТекЗначение = ТекЗначение / Делитель;
			КонецЕсли;
		Иначе
			ТекЗначение = Стр.Значение;			
		КонецЕсли;
			
		Если Стр.Индекс <> ТекущийИндекс Тогда
			НовСтр = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр); //Аналитика 1-N, Индекс
			ТекущийИндекс = Стр.Индекс;
			НовСтр[РезультатПоискаПоказателя.Код] = Стр.Значение;
			НовСтр[РезультатПоискаПоказателя.Код + "_Отображение"] = ТекЗначение;
			
			Если Стр.ПромежуточныйИтог Тогда
				НовСтр.ПромежуточныеИтоги = НовСтр.ПромежуточныеИтоги + "," + РезультатПоискаПоказателя.Код + ",";
			КонецЕсли;
			
			СтрРаскрытие = НовСтр;
			
		Иначе
			СтрРаскрытие[РезультатПоискаПоказателя.Код] = Стр.Значение;
			СтрРаскрытие[РезультатПоискаПоказателя.Код + "_Отображение"] = ТекЗначение;
			
			Если Стр.ПромежуточныйИтог Тогда
				НовСтр.ПромежуточныеИтоги = НовСтр.ПромежуточныеИтоги + "," + РезультатПоискаПоказателя.Код + ",";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРаскрытия.Колонки.Добавить("ID", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
	
	Индекс = 0;
	Для Каждого Строка Из ТаблицаРаскрытия Цикл // Восстановим нумерацию строк.		
		Строка.ID       = Индекс;
		Строка.Индекс	= Индекс + 1;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат ТаблицаРаскрытия;
	
КонецФункции

// Формирует отфильтрованную таблицу раскрытия на основании неотфильтрованной по заданным
// значениям отборов по аналитикам.
//
Функция НаложитьОтборНаТаблицуРаскрытия(ТаблицаРаскрытия, Аналитики) Экспорт
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаРаскрытия);
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Для Каждого Строка Из ПостроительЗапроса.ДоступныеПоля Цикл
		ПостроительЗапроса.ВыбранныеПоля.Добавить(Строка.Имя);
	КонецЦикла;
	
	Для Каждого Аналитика Из Аналитики Цикл
		Если ЗначениеЗаполнено(Аналитика.Значение) Тогда
			ИмяАналитики = Аналитика.Ключ;
			
			// Отбор осуществляется только по аналитикам показателя.
			Если Метаданные().Реквизиты.Найти(ИмяАналитики) <> Неопределено И ЗначениеЗаполнено(ЭтотОбъект[ИмяАналитики]) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТаблицаРаскрытия.Колонки.Найти(ИмяАналитики) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Отбор = ПостроительЗапроса.Отбор.Добавить(ИмяАналитики);
			Отбор.Значение      = Аналитика.Значение;
			Отбор.Использование = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	ПостроительЗапроса.Выполнить();
	Возврат ПостроительЗапроса.Результат.Выгрузить();
	
КонецФункции

// Возвращает строку из основных измерений отчета
//
Функция ВернутьПредставлениеЭкземпляраОтчета() Экспорт
	
	локОписаниеАналитики = "";
	
	Если ТипЗнч(мДополнительныеРеквизиты) = Тип("ТаблицаЗначений") И мДополнительныеРеквизиты.Количество() > 0 Тогда
		
		мДополнительныеРеквизиты.Сортировать("ПорядковыйНомер");
		
		КодыВидовАналитики = БюджетнаяОтчетность.КодыВидовАналитики(мДополнительныеРеквизиты.ВыгрузитьКолонку("ВидАналитики"));
		
		СтрокаРеквизиты = "";
		
		Для Каждого СтрРеквизит Из мДополнительныеРеквизиты Цикл
			СтрокаРеквизиты = СтрокаРеквизиты + ", " + КодыВидовАналитики[СтрРеквизит.ВидАналитики] + ":" + Строка(СтрРеквизит.Значение);
		КонецЦикла;
		
		локОписаниеАналитики = Сред(СтрокаРеквизиты,3);
		
	КонецЕсли;
	
	Возврат ""  + ВидОтчета 
				+ ?(ПустаяСтрока(локОписаниеАналитики),""," " + локОписаниеАналитики) 
				+ " № " + Номер 
				+ ", по орг. единице '" + Организация 
				+ "'. Период: '" + ПериодОтчета + "'";
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТИРУЕМЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ, ПРЕДНАЗНАЧЕННЫЕ ДЛЯ ИСПОЛЬЗОВАНИЯ В ТОМ 
// ЧИСЛЕ И ИЗ ДРУГИХ ОБЪЕКТОВ

// Получает текущее состояние объекта отчета.
// Т.е. функция определяет значение состояния установленное отчету, а не записанное в регистр.
// При первом обращении считывает данные последние данные из регистра ИсторияСостоянийОтчетов.
//
Функция ТекущееСостояниеОтчета() Экспорт

	Возврат Состояние;

КонецФункции // СостояниеОтчета()

// Функция возвращает текущее состояние отчета, хранимое в регистре сведений.
//
Функция ЗаписанноеСостояниеОтчета() Экспорт

	Если ЭтоНовый() Тогда
		Возврат Перечисления.СостоянияОтчетов.ПустаяСсылка();
	Иначе
		Возврат Ссылка.Состояние;
	КонецЕсли;

КонецФункции // ЗаписанноеСостояниеОтчета()

// Процедура устанавливает новое значение состояния для записи его вместе с отчетом.
//
// Параметры:
//  НовоеСостояние 				- состояние, устанавливаемое для отчета.
//
//	ПричинаИзмененияСостояния 	- причина изменения состояния.
//
//  Комментарий	   				- комментарий к устанавливаемому состоянию
//
Процедура УстановитьСостояниеОтчета(НовоеСостояние) Экспорт

	Если Не УстановитьБлокировку() Тогда
		Возврат;
	КонецЕсли;
	
	// установка состояния.
	Состояние = НовоеСостояние;
	
КонецПроцедуры // УстановитьСостояниеОтчета()

// При вызове процедуры отменяется запись истории состояния, если до этого состояние отчета изменялось.
// В результате, состояние отчета изменено не будет.
// Повторная установка состояния отчета снова создаст запись в истории и будет сохранена при записи объекта.
//
Процедура ОтменитьИзменениеСостоянияОтчета() Экспорт

	СтруктураЗаписиИсторииСостояний = Неопределено;
	Состояние 						= ЗаписанноеСостояниеОтчета();

КонецПроцедуры // УдалитьЗаписьИсторииСостояния()

//	Проверяет, был ли инициализирован контекст, и если нет - инициализирует
Процедура ПроверитьКонтекстИнициализирован() Экспорт
	Если ТипЗнч(мПоказатели) <> Тип("ТаблицаЗначений") Тогда
		ИнициализироватьКонтекст();
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЗаполненностьОбязательныхАналитик() Экспорт
	
	Если НЕ ЗначениеЗаполнено(мПоказателиРаскрытия) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПоляАналитики    = "";
	КолонкиАналитики = "";
	
	Для Сч = 1 По мЧислоДопАналитик Цикл
		
		ПоляАналитики = ПоляАналитики + ",
		|	ТаблицаРаскрытия.Аналитика"+Сч;
		
		КолонкиАналитики = КолонкиАналитики + ",Аналитика" + Сч;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерОбязательнойАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики.Наименование КАК НазваниеАналитики
	|ПОМЕСТИТЬ Группы
	|ИЗ
	|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|ГДЕ
	|	ГруппыРаскрытияАналитика.Ссылка.Владелец = &ВидОтчета
	|	И ГруппыРаскрытияАналитика.Обязательный = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаРаскрытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРаскрытия.ГруппаРаскрытия,
	|	ТаблицаРаскрытия.Индекс"
	+ ПоляАналитики + "
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ
	|	&ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаРаскрытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаРаскрытия.Индекс,
	|	ТаблицаРаскрытия.ГруппаРаскрытия"
	+ ПоляАналитики + "
	|ИЗ
	|	ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|///////////////////////////////////////////////////////////////////////////////
	|;
	|ВЫБРАТЬ
	|	Группы.ГруппаРаскрытия,
	|	Группы.ГруппаРаскрытия.Наименование КАК НаименованиеГруппы,
	|	Группы.НомерОбязательнойАналитики,
	|	Группы.НазваниеАналитики
	|ИЗ
	|	Группы
	|ИТОГИ ПО
	|	ГруппаРаскрытия";
	
	Запрос.УстановитьПараметр("ВидОтчета"		,ВидОтчета);
	ТаблицаВЗапрос = мПоказателиРаскрытия.Скопировать(,"ГруппаРаскрытия,Индекс" + КолонкиАналитики);
	ТаблицаВЗапрос.Свернуть("ГруппаРаскрытия,Индекс" + КолонкиАналитики);
	
	Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаВЗапрос);
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	ДанныеПоАналитике = РезультатыЗапросов[2].Выгрузить();
	ГруппыРаскрытия   = РезультатыЗапросов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	ЕстьОшибки = Ложь;
	
	Пока ГруппыРаскрытия.Следующий() Цикл
		
		СтрокиГруппыРаскрытия 	= ДанныеПоАналитике.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппыРаскрытия.ГруппаРаскрытия));
		ВыборкаНомеров 			= ГруппыРаскрытия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// Обход строк отчета
		Для Каждого СтрАналитики Из СтрокиГруппыРаскрытия Цикл
			
			ВыборкаНомеров.Сбросить();
			
			СообщениеОбОшибке = "";
			
			Пока ВыборкаНомеров.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(СтрАналитики["Аналитика" + ВыборкаНомеров.НомерОбязательнойАналитики]) Тогда
					СообщениеОбОшибке = СообщениеОбОшибке + ", " + ВыборкаНомеров.НазваниеАналитики;
					ЕстьОшибки = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ПустаяСтрока(СообщениеОбОшибке) Тогда
				
				СообщениеОбОшибке = "В строке №" + СтрАналитики.Индекс + " группы раскрытия """ + ГруппыРаскрытия.НаименованиеГруппы + """
				|не заполнены значения аналитики:" + Сред(СообщениеОбОшибке,2);
				
				ДобавитьСообщениевЛог(СообщениеОбОшибке,СтатусСообщения.Важное,,"Ошибка записи",Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

// Функция проверяет заполненность обязательных дополнительных реквизитов.
//
Функция ОбязательныеРеквизитыЗаполнены()

	Если ОбменДанными.Загрузка Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроверкаПройдена = Истина;
	
	Для Каждого Реквизит ИЗ мДополнительныеРеквизиты Цикл						
		
		Если Реквизит.Обязательный И (Не ЗначениеЗаполнено(Реквизит.Значение)) Тогда
			
			ТекстСообщенияОбОшибке = "Не указано значение доп. реквизита "+Реквизит.ДополнительныйРеквизит+", отмеченное как обязательное к заполнению.";
			ДобавитьСообщениевЛог(ТекстСообщенияОбОшибке,СтатусСообщения.Важное,,"Ошибка записи",Истина);			
			
			ПроверкаПройдена = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПроверкаПройдена;

КонецФункции // ОбязательныеРеквизитыЗаполнены()


// Заполняет из ИБ таблицы показателей отчета и раскрытий отчета.
//
Процедура ИнициализироватьКонтекст() Экспорт
	
	#Если Клиент Тогда
		Состояние("Заполнение списка показателей...");
	#КонецЕсли
	// Восстановим данные для расшифровок
	
	СохраненныеДанныеАктуальны				= Истина;
	ТребуетсяОбновлениеТаблицыРегистраторов = Ложь;
	
	РеквизитыОтчета = СтруктураРеквизитовОтчета("Ссылка,ВидОтчета,ШаблонОтчета,мДокументОснование,мДополнительныеРеквизиты");
	
	// Инициализация контекста на сервере.
	Контекст = БюджетнаяОтчетностьСервер.ИнициализироватьКонтекстОтчета(РеквизитыОтчета);
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Контекст);
	
	УИД = Новый УникальныйИдентификатор;
	ЗаполнитьДеревоСтраниц(УИД);
	
	БланкОтчета = ШаблонОтчета;
		
	СформироватьСтруктуруПоказателей();
	СформироватьСтруктуруИзмененныхПоказателей();
	СформироватьСтруктуруДополнительныхРеквизитов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОтчетовПараметрыОтчета.Код,
	|	ВидыОтчетовПараметрыОтчета.Наименование,
	|	ВЫБОР
	|		КОГДА (ЕстьNull(УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение,Неопределено) <> Неопределено )
	|			ТОГДА УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВидыОтчетовПараметрыОтчета.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
	|					ТОГДА 0
	|				КОГДА ВидыОтчетовПараметрыОтчета.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Строка)
	|					ТОГДА """"
	|				КОГДА ВидыОтчетовПараметрыОтчета.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Дата)
	|					ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|				КОГДА ВидыОтчетовПараметрыОтчета.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Булево)
	|					ТОГДА ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК Значение
	|ИЗ
	|	Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|		ПО ВидыОтчетовПараметрыОтчета.Код = УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код
	|			И (УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка = &Ссылка)
	|ГДЕ
	|	ВидыОтчетовПараметрыОтчета.Ссылка = &ВидОтчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыОтчетовПараметрыОтчета.НомерСтроки";
	
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	Запрос.УстановитьПараметр("Ссылка"   ,?(ЗначениеЗаполнено(мДокументОснование), мДокументОснование, Ссылка));
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПараметрыОтчета.Очистить();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтчета.Добавить(),Выборка);
	КонецЦикла;
	
	СформироватьСтруктуруПараметров();
	
	мДокументОснование = Неопределено;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоСтраниц(УИД) Экспорт 
	
	мДеревоСтраниц = Новый ДеревоЗначений;
	мДеревоСтраниц.Колонки.Добавить("Наименование");
	мДеревоСтраниц.Колонки.Добавить("ИмяСтраницы");
	мДеревоСтраниц.Колонки.Добавить("АдресБланка");
	мДеревоСтраниц.Колонки.Добавить("АдресНастроек");	
	
	мНастройкиБланка = Неопределено;
	
	БюджетнаяОтчетностьТолькоСервер.ИнициализироватьБланкОтчетаПриНеобходимости(ШаблонОтчета);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БланкиОтчетовСтраницыБланка.ИмяСтраницы КАК ИмяСтраницы,
		|	БланкиОтчетовСтраницыБланка.РодительскаяСтраница КАК РодительскаяСтраница,
		|	БланкиОтчетовСтраницыБланка.ПользовательскоеНаименование КАК ПользовательскоеНаименование,
		|	БланкиОтчетовСтраницыБланка.Макет КАК Макет,
		|	БланкиОтчетовСтраницыБланка.ПараметрыНастройкиБланка КАК ПараметрыНастройкиБланка,
		|	БланкиОтчетовСтраницыБланка.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.БланкиОтчетов.СтраницыБланка КАК БланкиОтчетовСтраницыБланка
		|ГДЕ
		|	БланкиОтчетовСтраницыБланка.Ссылка = &Бланк
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Бланк", ШаблонОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Инд = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РодительскаяСтраница) Тогда
			СтрокаРодительская = мДеревоСтраниц.Строки.Найти(ВыборкаДетальныеЗаписи.РодительскаяСтраница,"ИмяСтраницы",Истина);
			Если СтрокаРодительская = Неопределено Тогда
				СтрокаРодительская = мДеревоСтраниц;
			КонецЕсли;
		Иначе
			СтрокаРодительская = мДеревоСтраниц;
		КонецЕсли;
		ТекСтраница = СтрокаРодительская.Строки.Добавить();
		ТекСтраница.ИмяСтраницы = ВыборкаДетальныеЗаписи.ИмяСтраницы;
		ТекСтраница.Наименование = ВыборкаДетальныеЗаписи.ПользовательскоеНаименование;
		
		Если Инд = 0 Тогда //Заполним только 1 страницу, остальные будут получены при первом обращении
			ТекНастройки = ВыборкаДетальныеЗаписи.ПараметрыНастройкиБланка.Получить();
			
			Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
				ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
			Иначе
				Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
			КонецЕсли;
			
			ЗаписиМР = ШаблонОтчета.МакетРаскрытий.НайтиСтроки(Новый Структура("ИмяСтраницы,ОсновнаяЧасть",ТекСтраница.ИмяСтраницы,Истина));
			Если ЗаписиМР.Количество() Тогда	
				ТабДок = ЗаписиМР[0].Макет.Получить();
			Иначе
				ТабДок = Новый ТабличныйДокумент;
			КонецЕсли;
			
			ТекСтраница.АдресБланка = ПоместитьВоВременноеХранилище(ТабДок,УИД);
			
			Если мНастройкиБланка = Неопределено Тогда
				//для первой страницы настройки
				мНастройкиБланка = ТекНастройки;
			КонецЕсли;
			
			ТекСтраница.АдресНастроек = ПоместитьВоВременноеХранилище(ТекНастройки,УИД);		
		КонецЕсли;
		
		Инд = Инд + 1;
	КонецЦикла;
		
КонецПроцедуры

// Проверяет данные отчета по алгоритму запрограммированному в модуле проверки.
// Возвращает Истина, если проверка пройдена и Ложь в противном случае.
//
Функция Проверить(ВидКС = "") Экспорт
	
	РезультатПроверки = ПолучитьРезультатПроверки(ВидКС);
	
	СтатусПроверки = РезультатПроверки.БезОшибок;
	
	Возврат СтатусПроверки;
	
КонецФункции

// Проверяет данные отчета по алгоритму запрограммированному в модуле проверки.
// Возвращает Структуру с ключами "БезОшибок" и "БезПредупреждений", имеющими булевое значение.
//
Функция ПолучитьРезультатПроверки(ВидКС = "") Экспорт
	
	СписокКонтрольныхСоотношений = ПолучитьСписокКонтрольныхСоотношений(ВидКС);
	
	ПроверитьКонтекстИнициализирован();
	СформироватьСтруктуруПоказателей();
	
	мСписокСообщенийПроцедурыПроверки = Новый ТаблицаЗначений;
	мСписокСообщенийПроцедурыПроверки.Колонки.Добавить("ИмяГруппы");
	мСписокСообщенийПроцедурыПроверки.Колонки.Добавить("ПредставлениеГруппы");
	мСписокСообщенийПроцедурыПроверки.Колонки.Добавить("ЕстьОшибки",Новый ОписаниеТипов("Булево"));
	мСписокСообщенийПроцедурыПроверки.Колонки.Добавить("СообщенияГруппы");
		
	Попытка
		
		РезультатПроверки = РассчитатьКонтрольныеСоотношения(СписокКонтрольныхСоотношений);
		
		//Контроль БК
		//
		МодульПроверкиКонтрольБК = Обработки.ПроверкаОтчетаКонтрольБК.Создать();
		РезультатКонтрольБК = МодульПроверкиКонтрольБК.ПроверитьПоОтчету(ЭтотОбъект,СписокКонтрольныхСоотношений);

		РезультатПроверки.БезОшибок = РезультатКонтрольБК.БезОшибок И РезультатПроверки.БезОшибок;	
		РезультатПроверки.БезПредупреждений = РезультатКонтрольБК.БезПредупреждений И РезультатПроверки.БезПредупреждений;
		РезультатПроверки.БезОшибокРасчета = РезультатКонтрольБК.БезОшибокРасчета И РезультатПроверки.БезОшибокРасчета;

		РезультатПроверки.ВФКонтроль		= РезультатПроверки.ВФКонтроль ИЛИ РезультатКонтрольБК.ВФКонтроль;
		РезультатПроверки.ВФОшибки			= РезультатПроверки.ВФОшибки + РезультатКонтрольБК.ВФОшибки;
		РезультатПроверки.ВФПредупреждения	= РезультатПроверки.ВФПредупреждения + РезультатКонтрольБК.ВФПредупреждения;
		
		//Проверка по ФЛК
		//
		МодульПроверкиФЛК = Обработки.ПроверкаОтчетаНаФорматноЛогическийКонтроль.Создать();
		РезультатФЛК = МодульПроверкиФЛК.ПроверитьПоОтчету(ЭтотОбъект,СписокКонтрольныхСоотношений);
		
		РезультатПроверки.БезОшибок = РезультатФЛК.БезОшибок И РезультатПроверки.БезОшибок;
		РезультатПроверки.БезПредупреждений = РезультатФЛК.БезПредупреждений И РезультатПроверки.БезПредупреждений;
		РезультатПроверки.БезОшибокРасчета = РезультатФЛК.БезОшибокРасчета И РезультатПроверки.БезОшибокРасчета;

		РезультатПроверки.ВФКонтроль		= РезультатПроверки.ВФКонтроль ИЛИ РезультатФЛК.ВФКонтроль;
		РезультатПроверки.ВФОшибки			= РезультатПроверки.ВФОшибки + РезультатФЛК.ВФОшибки;
		РезультатПроверки.ВФПредупреждения	= РезультатПроверки.ВФПредупреждения + РезультатФЛК.ВФПредупреждения;
				
	Исключение
		
		ТекстСообщения = ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
		ДобавитьСообщениевЛог(ТекстСообщения,СтатусСообщения.Важное,,"Проверка отчета");
		
		РезультатПроверки = Новый Структура;
		РезультатПроверки.Вставить("БезОшибок", 	Ложь);
		РезультатПроверки.Вставить("БезПредупреждений", Истина);
		РезультатПроверки.Вставить("БезОшибокРасчета", 	Ложь);
		
		РезультатПроверки.Вставить("ВФКонтроль",		Истина);
		РезультатПроверки.Вставить("ВФОшибки",			1);
		РезультатПроверки.Вставить("ВФПредупреждения",	0);
		
		РезультатПроверки.Вставить("МФКонтроль",		Ложь);
		РезультатПроверки.Вставить("МФОшибки",			0);
		РезультатПроверки.Вставить("МФПредупреждения",	0);
		
	КонецПопытки;
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция ПроверитьМодуль(Знач ТекстМодуля, ОписаниеОшибки, РежимВычисления = Ложь) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если РежимВычисления Тогда
		ТекстМодуля = "?(Ложь,"+ТекстМодуля+",1)";
	Иначе
		ТекстМодуля = "Если Истина Тогда ВызватьИсключение ""__Формула__корректна__""; Иначе
		|" + ТекстМодуля + "
		|КонецЕсли;";
	КонецЕсли;
	
	Попытка
		Если РежимВычисления Тогда
			Результат = Вычислить(ТекстМодуля);
		Иначе
			Выполнить(ТекстМодуля);
		КонецЕсли;
		Возврат Истина;
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Если СтрНайти(ОписаниеОшибки,"__Формула__корректна__")>0 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецПопытки;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Функция устанавливает блокировку на объект.
Функция УстановитьБлокировку(ФормаДокумента = Неопределено) Экспорт
	
	Перем РезультатБлокировки;
	
	ТекстСообщенияТолькоПросмотр = НСтр("ru = 'Возможен только просмотр документа'");
	
	Если ТекущийРежимЗапуска() = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
		Если НЕ Заблокирован() Тогда
			Попытка 
				Заблокировать();
				РезультатБлокировки = Истина;
			Исключение
				Сообщить(ТекстСообщенияТолькоПросмотр, СтатусСообщения.Информация);
				РезультатБлокировки = Ложь;
			КонецПопытки;
		Иначе
			РезультатБлокировки = Истина;
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если ФормаДокумента <> Неопределено Тогда
				ФормаДокумента.ЭлементыФормы.ОсновныеДействияФормы.Кнопки.ОсновныеДействияФормыОК.Доступность        = РезультатБлокировки;
				ФормаДокумента.ЭлементыФормы.ОсновныеДействияФормы.Кнопки.ОсновныеДействияФормыСохранить.Доступность = РезультатБлокировки;
			КонецЕсли;
		#КонецЕсли
		
	Иначе
		Если РежимДиалога Тогда
			Возврат Истина;
		ИначеЕсли Не Заблокирован() Тогда
			Попытка 
				Заблокировать();
				РезультатБлокировки = Истина;
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияТолькоПросмотр);
				РезультатБлокировки = Ложь;
			КонецПопытки;
		Иначе
			РезультатБлокировки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатБлокировки;
	
КонецФункции

// Выводит сообщение с заданным текстом и статусом в окно сообщений.
//
Процедура ноСообщить(ТекстСообщения, Статус = Неопределено, Заголовок = "", Событие = "") Экспорт
	
	Если Не ПустаяСтрока(Заголовок) Тогда
		#Если ВнешнееСоединение Тогда
			ДобавитьСообщениевЛог(Заголовок,Статус,Ссылка,Событие);
		#Иначе
			Если Не ТихийРежим Тогда
				ДобавитьСообщениевЛог(Заголовок,Статус,Ссылка,Событие);
			КонецЕсли;
		#КонецЕсли
		Заголовок = "";
	КонецЕсли;
	ДобавитьСообщениевЛог(ТекстСообщения,Статус,Ссылка,Событие);
	
КонецПроцедуры

// В том случае, если процедура вызывается с клиента - дублирует поведение процедуры 
// ноСообщить, иначе заполняет переменную мТекстПредупреждения.(используется в WEB)
Процедура ноПредупреждение(ТекстСообщения, Статус = Неопределено) Экспорт
	
	#Если Не ВнешнееСоединение Тогда
		ноСообщить(ТекстСообщения, ?(Статус = Неопределено, СтатусСообщения.Важное, Статус));
	#Иначе
		мТекстПредупреждения = ТекстСообщения;
	#КонецЕсли
	
КонецПроцедуры

// Очищает значения показателей, примечания к показателям, раскрытия.
//
Процедура ОчиститьПередЗаполнением() Экспорт
	
	ПоказателиЭтоСтруктура = (ТипЗнч(Показатели) = Тип("Структура"));
	Для Каждого Стр Из мПоказатели Цикл
		Стр.Значение = ПустоеЗначениеПоТипу[Стр.ТипЗначения];
		Если ПоказателиЭтоСтруктура Тогда
			Показатели.Вставить(Стр.Код, Стр.Значение);
			ИзмененныеПоказатели.Вставить(Стр.Код, Истина);
		КонецЕсли;
	КонецЦикла;
	мПоказателиРаскрытия.Очистить();
	
КонецПроцедуры 

// Процедура переносит данные таблицы раскрытия в таблицу значений мПоказателиРаскрытия.
//
// Параметры:
//  ГруппаРаскрытия   - группа раскрытия, по которой составлена таблица раскрытия.
//
//  ТаблицаРаскрытия  - таблица раскрытия показателей, принадлежащих группе.
//	КолонкиПоказатели - в этом параметре возвращаются строки таблицы мПоказатели, 
//						которые принадлежат группе раскрытия.
//
Процедура ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, Знач ТаблицаРаскрытия, ВыполнятьПересчет = Истина) Экспорт
	
	КолонкиПоказатели = мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
		
	ТаблицаРаскрытия = ТаблицаРаскрытия.Скопировать();
	// добавление обяз. колонки.
	Если ТаблицаРаскрытия.Колонки.Найти("Индекс") = Неопределено Тогда
		ТаблицаРаскрытия.Колонки.Добавить("Индекс");
		// Перенумерация строк
		Инд = 1;
		Для Каждого СтрТаблицы Из ТаблицаРаскрытия Цикл
			СтрТаблицы.Индекс 	= Инд;
			Инд = Инд + 1;
		КонецЦикла;
	КонецЕсли;
	// добавление обяз. колонки.
	Если ТаблицаРаскрытия.Колонки.Найти("ПромежуточныеИтоги") = Неопределено Тогда
		ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	ОписаниеГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	Если ЗначениеЗаполнено(ОписаниеГруппыРаскрытия) Тогда
		ЧислоАналитик = ОписаниеГруппыРаскрытия.ЧислоАналитик;
	Иначе
		ЧислоАналитик = 0;
	КонецЕсли;
		
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Показатель");
	ИменаКолонок = Новый Массив;
				
	ПараметрыГруппы = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	СтрАналитика = "";
	Для Сч = 1 По ПараметрыГруппы.ЧислоАналитик Цикл
		СтрАналитика = СтрАналитика + ",Аналитика" + Сч;
	КонецЦикла;
	СтрАналитика = Сред(СтрАналитика,2);
	
	мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
	МассивСтрок = мПоказателиРаскрытия.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	
	мПоказателиРаскрытия.Индексы.Очистить();
	
	//При большом количестве строк в таблице ТаблицаРаскрытия, 
	//удаление индекса и его добавление в мПоказателиРаскрытия будет быстрее,
	//чем добавление строк в таблицу с индексами.

	Для Каждого СтрРаскрытия Из МассивСтрок Цикл		
		мПоказателиРаскрытия.Удалить(СтрРаскрытия);
	КонецЦикла;
		
	Для Каждого Пок Из КолонкиПоказатели Цикл
				
		Для Каждого Стр Из ТаблицаРаскрытия Цикл
			
			СтрРаскрытия = мПоказателиРаскрытия.Добавить();
			СтрРаскрытия.ГруппаРаскрытия = ГруппаРаскрытия;
			СтрРаскрытия.Показатель = Пок.Ссылка;
			СтрРаскрытия.Индекс		= Стр.Индекс;
			ЗаполнитьЗначенияСвойств(СтрРаскрытия,Стр,СтрАналитика);
			
			СтрРаскрытия.Значение		   = Стр[Пок.Код];
			СтрРаскрытия.ПромежуточныйИтог = (Найти(Стр.ПромежуточныеИтоги,","+Пок.Код+",") > 0);
						
		КонецЦикла;
				
	КонецЦикла;
	
	мПоказателиРаскрытия.Индексы.Добавить("Показатель");
	
	Если ВыполнятьПересчет Тогда
		// запустим модуль вычисления
		РассчитатьВычисляемыеПоказатели();
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает коэффициент масштабирования показателей.
//
Функция ВернутьЗначениеДелителя() Экспорт
	
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		Возврат 1000000;
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		Возврат 1000;
	Иначе
		Возврат 1;
	КонецЕсли;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ НУЖД WEB-ИНТЕРФЕЙСА

Функция ИзменитьЗначениеПоказателя(Знач КодПоказателя, ЗначениеПоказателя) Экспорт
	
	Если ТипЗнч(КодПоказателя) <> Тип("Строка") Тогда
		КодПоказателя = СокрЛП(КодПоказателя.Код);
	КонецЕсли;
	СтрокаПоказателя = мПоказатели.Найти(СокрЛП(КодПоказателя), "Код");
	Если СтрокаПоказателя = Неопределено Тогда
		Возврат Ложь;
	Иначе
		СтрокаПоказателя.Значение = ЗначениеПоказателя;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Инициализирует структуры Показатели и Параметры, запускает модуль вычисления,
// помещает показатели, полученные в результате вычисления, в таблицу мПоказатели.
//
Функция РассчитатьВычисляемыеПоказатели() Экспорт
	
	// заполняем параметры
	СформироватьСтруктуруПараметров(Ложь);
	
	// инициализируем структуру "Показатели"
	СформироватьСтруктуруПоказателей();
	
	УстановитьИтогиПоПоказателям();
	// запускаем код заполнения
	Если НЕ ЗапуститьМодульВычисления() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// переносим значения в глобальную таблицу показателей
	ПеренестиЗначенияИзПоказателиВмПоказатели();
	
	Возврат Истина;
	
КонецФункции

// Формирует пустую таблицу значений, соответствующую группе раскрытия.
//
Функция ПолучитьПустуюТаблицуРаскрытия(ГруппаРаскрытия) Экспорт
	
	// создаем таблицу описания раскрываемых показателей
	ПоказателиКолонки = Новый ТаблицаЗначений;
	ПоказателиКолонки.Колонки.Добавить("Ссылка");
	ПоказателиКолонки.Колонки.Добавить("Код");
	ПоказателиКолонки.Колонки.Добавить("НаименованиеКолонки");
	ПоказателиКолонки.Колонки.Добавить("ТипЗначения");
	НайденныеПоказатели = мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия", ГруппаРаскрытия));
	
	Для Каждого НайденныйПоказатель Из НайденныеПоказатели Цикл
		НовСтр = ПоказателиКолонки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, НайденныйПоказатель);
	КонецЦикла;
	
	// создаем таблицу, со строками - комбинациями значений аналитик и колонками - показателями
	ТаблицаРаскрытия = Новый ТаблицаЗначений;
	ОписаниеГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(ГруппаРаскрытия);
	
	Для Инд = 1 По мЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(ОписаниеГруппыРаскрытия["ВидАналитики" + Инд]) Тогда
			ТаблицаРаскрытия.Колонки.Добавить("Аналитика" + Инд, ОписаниеГруппыРаскрытия["ТипЗначенияАналитики" + Инд], Строка(ОписаниеГруппыРаскрытия["ВидАналитики" + Инд]));
		КонецЕсли;
	КонецЦикла;
	
	ЧислоАналитик = ТаблицаРаскрытия.Колонки.Количество();
	Для Каждого Пок Из ПоказателиКолонки Цикл
		ИмяКолонки = Пок.НаименованиеКолонки;
		ТаблицаРаскрытия.Колонки.Добавить(Пок.Код, БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения), ИмяКолонки);
	КонецЦикла;
	
	// имена показателей с промежуточными итогами
	//ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаРаскрытия;
	
КонецФункции

Функция ПолучитьТабличныйДокументШаблона() Экспорт
	
	Возврат БланкОтчета.Макет.Получить();
	
КонецФункции

// Функция предоставляет описание аналитики уровня вида отчета.
//
Функция ПолучитьАналитикиВидаОтчета() Экспорт
	
	ТаблицаАналитик=Новый ТаблицаЗначений;
	ТаблицаАналитик.Колонки.Добавить("КодРеквизита");
	ТаблицаАналитик.Колонки.Добавить("НаименованиеРеквизита");
	ТаблицаАналитик.Колонки.Добавить("НаименованиеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ЗначениеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ПредставлениеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ТипЗначенияАналитики");
	ТаблицаАналитик.Колонки.Добавить("ВидСубконтоАналитики");
	
	Для Каждого СтрРеквизит Из мДополнительныеРеквизиты Цикл		
			
		НоваяСтрока=ТаблицаАналитик.Добавить();
		НоваяСтрока.КодРеквизита			= СокрП(СтрРеквизит.Код);
		НоваяСтрока.НаименованиеРеквизита	= СтрРеквизит.Наименование;
		НоваяСтрока.НаименованиеАналитики	= Строка(СтрРеквизит.ВидАналитики);
		НоваяСтрока.ЗначениеАналитики		= СтрРеквизит.Значение;
		НоваяСтрока.ТипЗначенияАналитики	= СтрРеквизит.ВидАналитики.ТипЗначения;
		НоваяСтрока.ВидСубконтоАналитики	= СтрРеквизит.ВидАналитики;
		
		Если ЗначениеЗаполнено(НоваяСтрока.ЗначениеАналитики) Тогда
			НоваяСтрока.ПредставлениеАналитики=Строка(НоваяСтрока.ЗначениеАналитики);
		Иначе
			НоваяСтрока.ПредставлениеАналитики="";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаАналитик;
		
КонецФункции // ПолучитьАналитикиВидаОтчета()

// Процедура заполняет значения доп. реквизитов.
//
// Параметры:
//  СтруктураАналитик - Структура. Ключ - Код доп. реквизита
//						Значение - значение реквизита
//
Процедура ЗаполнитьАналитикиВидаОтчета(СтруктураАналитик) Экспорт
	
	ЗаполнитьЗначенияСвойств(ДополнительныеРеквизиты,СтруктураАналитик);
	
	Для Каждого СтрокаДопРеквизита Из мДополнительныеРеквизиты Цикл
		Если ДополнительныеРеквизиты.Свойство(СтрокаДопРеквизита.Код) Тогда
			СтрокаДопРеквизита.Значение = ДополнительныеРеквизиты[СтрокаДопРеквизита.Код];
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры // ЗаполнитьАналитикиВидаОтчета


/////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ЗАПОЛНЕНИЯ ТАБЛИЦ ОТЧЕТА В СООТВЕТСТВИИ С
// ПАРАМЕТРИЧЕСКИМИ НАСТРОЙКАМИ ПРАВИЛ ЗАПОЛНЕНИЯ И ВЫЧИСЛЕНИЯ

Процедура ПодготовитьДанныеПараметрическойНастройки(Показатель = Неопределено) Экспорт
	
	Если ПравилоОбработки.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БюджетнаяОтчетность.ДанныеПараметрическойНастройкиАктуальны(ПравилоОбработки) Тогда
		
		// Создать актуальный кэш параметрической настройки
		ПравилоОбработкиОбъект = ПравилоОбработки.ПолучитьОбъект();		
		ПравилоОбработкиОбъект.СформироватьДанныеПараметрическойНастройки();
		
		СохраненныеДанные = БюджетнаяОтчетность.ПолучитьДанныеПараметрическойНастройки(ПравилоОбработки);
		
		ПравилоОбработкиОбъект = Неопределено;
		мМассивДополнительныхПоказателейДляВычисления = Неопределено;
		
	Иначе
		СохраненныеДанные = БюджетнаяОтчетность.ПолучитьДанныеПараметрическойНастройки(ПравилоОбработки);
	КонецЕсли;
	
	Если СохраненныеДанные=Неопределено Тогда
		
		мПоказателиДляОбработки=БюджетнаяОтчетность.ПолучитьПорядокВычисленияПоказателей(ПравилоОбработки,ВидОтчета);
		
		Если мПоказателиДляОбработки=Неопределено Тогда
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось определить порядок вычисления показателей'"));
			
			Возврат;
			
		КонецЕсли;
		
		мДеревоПересчета=БюджетнаяОтчетность.ПолучитьДеревоПересчетаПоказателей(мПоказателиДляОбработки);
		
	Иначе
		
		// Получаем данные, сохраненные на этапе настройки правила обработки.
		мПоказателиДляОбработки=СохраненныеДанные.мПоказателиДляОбработки;
		мДеревоПересчета=СохраненныеДанные.мДеревоПересчета;
		
	КонецЕсли;
	
	мПоказателиДляОбработки.Индексы.Добавить("Код");
		
	Если Показатель = Неопределено Тогда
		ДанныеПараметрикиАктуальны=Истина;
	КонецЕсли;
	
КонецПроцедуры // ПодготовитьДанныеПараметрическойНастройки()

/////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБРАБОТКИ КОНТРОЛЬНЫХ СООТНОШЕНИЙ.
//

// Процедура подготавливает данные для правила проверки
//
Процедура ПодготовитьДанныеКонтрольныхСоотношений(Знач СписокКонтрольныхСоотношений) Экспорт
	
	//Отредактируем список КС по условиям отбора
	ИспользуемыйСписокКонтрольныхСоотношений = ОтобратьКонтрольныеСоотношенияПоУсловию(СписокКонтрольныхСоотношений);

	// Подготовим таблицу для записи значений операндов
	
	мЗначенияОперандовКонтр=Новый ТаблицаЗначений;
	мЗначенияОперандовКонтр.Колонки.Добавить("КодОперанда");
	мЗначенияОперандовКонтр.Колонки.Добавить("КонтрольноеСоотношение");
	мЗначенияОперандовКонтр.Колонки.Добавить("Значение",БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя());
	мЗначенияОперандовКонтр.Колонки.Добавить("ИтогПоПоказателю",Новый ОписаниеТипов("Булево"));
	
	мЗначенияОперандовКонтр.Индексы.Добавить("КодОперанда");
	мЗначенияОперандовКонтр.Индексы.Добавить("КодОперанда,КонтрольноеСоотношение");
	мЗначенияОперандовКонтр.Индексы.Добавить("КодОперанда,КонтрольноеСоотношение,ИтогПоПоказателю");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокКонтрольныхСоотношений",ИспользуемыйСписокКонтрольныхСоотношений);	
	Запрос.УстановитьПараметр("НеИспользуется",Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КонтрольныеСоотношения.Ссылка КАК КонтрольноеСоотношение,
	|	КонтрольныеСоотношения.Процедура КАК Процедура,
	|	ЛОЖЬ КАК ПроизвольныйКод,
	|	КонтрольныеСоотношения.Описание КАК Описание,
	|	КонтрольныеСоотношения.Дополнительное КАК Дополнительное,
	|	КонтрольныеСоотношения.ТекстПояснения КАК ТекстПояснения,
	|	КонтрольныеСоотношения.Код КАК КодСоотношения,
	|	КонтрольныеСоотношения.НомерСоотношения КАК НомерСоотношения,
	|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения КАК ВидКонтрольногоСоотношения
	|ПОМЕСТИТЬ СписокКонтрольныхСоотношений
	|ИЗ
	|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	|ГДЕ
	|	КонтрольныеСоотношения.Ссылка В(&СписокКонтрольныхСоотношений)
	|	И КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.Межформенное), ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.Внутриформенное))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонтрольноеСоотношение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокКонтрольныхСоотношений.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	|	СписокКонтрольныхСоотношений.Процедура КАК Процедура,
	|	СписокКонтрольныхСоотношений.Описание КАК Описание,
	|	СписокКонтрольныхСоотношений.Дополнительное КАК Дополнительное,
	|	СписокКонтрольныхСоотношений.ТекстПояснения КАК ТекстПояснения,
	|	СписокКонтрольныхСоотношений.ПроизвольныйКод КАК ПроизвольныйКод,
	|	СписокКонтрольныхСоотношений.КодСоотношения КАК КодСоотношения,
	|	СписокКонтрольныхСоотношений.НомерСоотношения КАК НомерСоотношения,
	|	СписокКонтрольныхСоотношений.ВидКонтрольногоСоотношения КАК ВидКонтрольногоСоотношения
	|ИЗ
	|	СписокКонтрольныхСоотношений КАК СписокКонтрольныхСоотношений
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписокКонтрольныхСоотношений.КодСоотношения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперандыПоказателей.Код КАК Код,
	|	ОперандыПоказателей.Ссылка КАК Ссылка,
	|	ОперандыПоказателей.Наименование КАК Наименование,
	|	ОперандыПоказателей.СпособПолучения КАК СпособПолучения,
	|	ОперандыПоказателей.ТекстЗапросаМодуля КАК ТекстЗапросаМодуля,
	|	ОперандыПоказателей.НастройкиОперандаРасчет КАК НастройкиОперанда,
	|	ОперандыПоказателей.ПоказательОтбор КАК ПоказательОтбор,
	|	ОперандыПоказателей.Владелец КАК КонтрольноеСоотношение,
	|	ЛОЖЬ КАК ТребуетАнализа,
	|	ОперандыПоказателей.ВключатьПромежуточныеИтоги КАК ВключатьПромежуточныеИтоги
	|ПОМЕСТИТЬ ТабОперандов
	|ИЗ
	|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	|ГДЕ
	|	ОперандыПоказателей.Владелец В
	|			(ВЫБРАТЬ
	|				Соотношения.КонтрольноеСоотношение
	|			ИЗ
	|				СписокКонтрольныхСоотношений КАК Соотношения)
	|	И НЕ ОперандыПоказателей.НеИспользуется
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СписокКонтрольныхСоотношений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперандыПоказателейПравилаВычисленияПараметров.Операнд КАК Операнд,
	|	ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра КАК ИмяПараметра,
	|	ОперандыПоказателейПравилаВычисленияПараметров.ПредставлениеПараметра КАК ПредставлениеПараметра,
	|	ОперандыПоказателейПравилаВычисленияПараметров.СпособВычисленияПараметра КАК СпособВычисленияПараметра,
	|	ОперандыПоказателейПравилаВычисленияПараметров.УточнениеСпособаОпределения КАК УточнениеСпособаОпределения,
	|	ОперандыПоказателейПравилаВычисленияПараметров.ЗначениеДляПроверки КАК ЗначениеДляПроверки,
	|	ОперандыПоказателейПравилаВычисленияПараметров.ТипРасчета КАК ТипРасчета,
	|	ОперандыПоказателейПравилаВычисленияПараметров.ВидАналитикиОтбор КАК ВидАналитикиОтбор,
	|	ОперандыПоказателейПравилаВычисленияПараметров.РеквизитАналитики КАК РеквизитАналитики
	|ПОМЕСТИТЬ ПВОперандов
	|ИЗ
	|	ТабОперандов КАК ТабОперандов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
	|		ПО ТабОперандов.Ссылка = ОперандыПоказателейПравилаВычисленияПараметров.Операнд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.Ссылка КАК Операнд,
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.Поле КАК Поле,
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.КодАналитики КАК КодАналитики,
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.РеквизитАналитики КАК РеквизитАналитики,
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.АналитикаОперанда КАК АналитикаОперанда,
	|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.СопоставляемаяАналитика КАК СопоставляемаяАналитика
	|ИЗ
	|	ТабОперандов КАК ТабОперандов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОперандыПоказателей.ПравилаИспользованияПолейЗапроса КАК ОперандыПоказателейПравилаИспользованияПолейЗапроса
	|		ПО ТабОперандов.Ссылка = ОперандыПоказателейПравилаИспользованияПолейЗапроса.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОперандов.Код КАК Код,
	|	ТабОперандов.Ссылка КАК Ссылка,
	|	ТабОперандов.Наименование КАК Наименование,
	|	ТабОперандов.СпособПолучения КАК СпособПолучения,
	|	ТабОперандов.ТекстЗапросаМодуля КАК ТекстЗапросаМодуля,
	|	ТабОперандов.НастройкиОперанда КАК НастройкиОперанда,
	|	ТабОперандов.ПоказательОтбор КАК ПоказательОтбор,
	|	ТабОперандов.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	|	ТабОперандов.ТребуетАнализа КАК ТребуетАнализа,
	|	ТабОперандов.ВключатьПромежуточныеИтоги КАК ВключатьПромежуточныеИтоги,
	|	ПоказателиОтчетов.Код КАК ПоказательОтборКод,
	|	ПоказателиОтчетов.Владелец КАК ВидОтчетаОтбор,
	|	ПоказателиОтчетов.ГруппаРаскрытия КАК ГруппаРаскрытия
	|ИЗ
	|	ТабОперандов КАК ТабОперандов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ПО ТабОперандов.ПоказательОтбор = ПоказателиОтчетов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПВОперандов.Операнд КАК Операнд,
	|	ПВОперандов.ИмяПараметра КАК ИмяПараметра,
	|	ПВОперандов.ПредставлениеПараметра КАК ПредставлениеПараметра,
	|	ПВОперандов.СпособВычисленияПараметра КАК СпособВычисленияПараметра,
	|	ПВОперандов.УточнениеСпособаОпределения КАК УточнениеСпособаОпределения,
	|	ПВОперандов.ЗначениеДляПроверки КАК ЗначениеДляПроверки,
	|	ПВОперандов.ТипРасчета КАК ТипРасчета,
	|	ПВОперандов.ВидАналитикиОтбор КАК ВидАналитикиОтбор,
	|	ПВОперандов.РеквизитАналитики КАК РеквизитАналитики
	|ИЗ
	|	ПВОперандов КАК ПВОперандов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операнд,
	|	ИмяПараметра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПВОперандов.Операнд КАК Операнд,
	|	ПВОперандов.ИмяПараметра КАК ИмяПараметра,
	|	ПВОперандов.ПредставлениеПараметра КАК ПредставлениеПараметра,
	|	ПВОперандов.СпособВычисленияПараметра КАК СпособВычисленияПараметра,
	|	ПВОперандов.УточнениеСпособаОпределения КАК УточнениеСпособаОпределения,
	|	ПВОперандов.ЗначениеДляПроверки КАК ЗначениеДляПроверки,
	|	ПВОперандов.ТипРасчета КАК ТипРасчета,
	|	ПВОперандов.ВидАналитикиОтбор КАК ВидАналитикиОтбор,
	|	ПВОперандов.РеквизитАналитики КАК РеквизитАналитики
	|ИЗ
	|	ПВОперандов КАК ПВОперандов
	|ГДЕ
	|	ПВОперандов.СпособВычисленияПараметра <> &НеИспользуется
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операнд,
	|	ИмяПараметра";
	
	Запрос.Текст = ТекстЗапроса;
	
	Результаты 				= Запрос.ВыполнитьПакет();
	
	мКонтрольныеСоотношения = Результаты[1].Выгрузить();
	мДетализацияОперандов	= Результаты[5].Выгрузить();
	мОперандыКонтр 			= Результаты[6].Выгрузить();
	мОтборыОперандов		= Результаты[7].Выгрузить();
	мОтборыОперандовДляСравнения = Результаты[8].Выгрузить();
	
	
	Запрос 		= Неопределено; // Освобождение памяти.
	Результаты 	= Неопределено;
	
	// обрезаем коды
	мОперандыКонтр.Колонки.Код.Имя = "Имя";
	мОперандыКонтр.Колонки.Добавить("Код");
	
	мОперандыКонтр.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	мОперандыКонтр.Колонки.Добавить("ПравилаИспользованияПолейЗапроса");
	
	мОперандыКонтр.Колонки.Добавить("ЕстьВыбраннаяСопоставляемаяАналитика",Новый ОписаниеТипов("Булево"));
	
	мОперандыКонтр.Колонки.Добавить("ПВДляСравнения");
	мОперандыКонтр.Колонки.Добавить("ПоказательТекущегоОтчета");
	
	ПереченьКолонокОтборов = "ИмяПараметра,ПредставлениеПараметра,СпособВычисленияПараметра,УточнениеСпособаОпределения,ЗначениеДляПроверки,ТипРасчета,ВидАналитикиОтбор,РеквизитАналитики";
	мОтборыОперандов.Индексы.Добавить("Операнд");
	
	мОтборыОперандовДляСравнения.Индексы.Добавить("Операнд");

	ПереченьКолонокДетализации = "Поле,КодАналитики,РеквизитАналитики,АналитикаОперанда,СопоставляемаяАналитика";
	мДетализацияОперандов.Индексы.Добавить("Операнд");
	
	ЭталонПИ = мДетализацияОперандов.СкопироватьКолонки(ПереченьКолонокДетализации);
	
	Для Каждого Стр Из мОперандыКонтр Цикл
		Стр.Код = СокрЛП(Стр.Имя);
		СтруктураОтбора = Новый Структура("Операнд",Стр.Ссылка);
		
		//Правила вычисления (отборы операндов)
		МассивСтрок = мОтборыОперандов.НайтиСтроки(СтруктураОтбора);
		Стр.ПравилаВычисленияПараметровЗапроса = мОтборыОперандов.Скопировать(МассивСтрок,ПереченьКолонокОтборов);		
		ПоказательТекущегоОтчета = Истина;
		Для Каждого СтрТЧ Из Стр.ПравилаВычисленияПараметровЗапроса Цикл			
			Если СтрТЧ.ИмяПараметра="Организация" Тогда 
				ПоказательТекущегоОтчета = ПоказательТекущегоОтчета И СтрТЧ.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета;
			ИначеЕсли СтрТЧ.ИмяПараметра="ПериодОтчета" Тогда
				ПоказательТекущегоОтчета = ПоказательТекущегоОтчета И СтрТЧ.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета;
			ИначеЕсли СтрНачинаетсяС(СтрТЧ.ИмяПараметра,"Реквизит_") Тогда
				ПоказательТекущегоОтчета = ПоказательТекущегоОтчета И СтрТЧ.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит;
			КонецЕсли;			
		КонецЦикла;
		Стр.ПоказательТекущегоОтчета = ПоказательТекущегоОтчета;
		
		//Правила вычисления для сравнения (отборы операндов)
		МассивСтрок = мОтборыОперандовДляСравнения.НайтиСтроки(СтруктураОтбора);
		Стр.ПВДляСравнения = мОтборыОперандовДляСравнения.Скопировать(МассивСтрок,ПереченьКолонокОтборов);
		
		//Правила использования (детализация по аналитике)
		Если НЕ ЗначениеЗаполнено(Стр.ГруппаРаскрытия) Тогда
			Стр.ПравилаИспользованияПолейЗапроса = ЭталонПИ.СкопироватьКолонки();
		Иначе
			МассивСтрок = мДетализацияОперандов.НайтиСтроки(СтруктураОтбора);
			Стр.ПравилаИспользованияПолейЗапроса = мДетализацияОперандов.Скопировать(МассивСтрок,ПереченьКолонокДетализации);
			
			Для Каждого ТекСтр Из МассивСтрок Цикл
				Если ЗначениеЗаполнено(ТекСтр.СопоставляемаяАналитика) Тогда
					Стр.ЕстьВыбраннаяСопоставляемаяАналитика = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	мОтборыОперандовДляСравнения = Неопределено;
	мОтборыОперандов = Неопределено;
	мДетализацияОперандов = Неопределено;
	
	мОперандыКонтр.Колонки.Удалить(мОперандыКонтр.Колонки.Имя);	
	мОперандыКонтр.Индексы.Добавить("Код");
	мОперандыКонтр.Индексы.Добавить("Код,КонтрольноеСоотношение");
	
	мОперандыКонтр.Колонки.Добавить("АналитикВидаОтчета",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1,0));
	мОперандыКонтр.Колонки.Добавить("ФлагОшибки",Новый ОписаниеТипов("Булево"));
	мОперандыКонтр.Колонки.Добавить("ПростойРежим",Новый ОписаниеТипов("Булево"));
	
	мТабПоказателиЗапросыКонтр=Новый ТаблицаЗначений;
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("СписокОперандов");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ПравилаВычисленияПараметров");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ПВДляСравнения");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ПравилаИспользованияПолей");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ВключатьПромежуточныеИтоги");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ТекстЗапроса");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("СпособПолучения");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("РеквизитАналитики");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ПоказательТекущегоОтчета");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ВидОтчетаОтбор");
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ПростойРежим",Новый ОписаниеТипов("Булево"));
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("ЕстьРаскрытиеПоАналитике", Новый ОписаниеТипов("Булево"));
	//Для отбора
	ТипЧислаДляОтбора = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(2,0);
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("КоличествоСтрокПВ",ТипЧислаДляОтбора);
	мТабПоказателиЗапросыКонтр.Колонки.Добавить("КоличествоСтрокПИ",ТипЧислаДляОтбора);
	
	мТабПоказателиЗапросыКонтр.Индексы.Добавить("СпособПолучения,ВидОтчетаОтбор,ВключатьПромежуточныеИтоги,КоличествоСтрокПВ,КоличествоСтрокПИ");
	мСоответствиеОперандовИПоказателейОтбораКонтр=Новый Соответствие;
	
	СтрокаДляПростыхОперандов = Неопределено;
	
	Для Каждого Операнд Из мОперандыКонтр Цикл
		
		ЕстьАналогичныйОтбор=Ложь;
		
		ТабПараметры = Операнд.ПравилаВычисленияПараметровЗапроса;
		ТабПараметрыДляСравнения = Операнд.ПВДляСравнения;
		ТабПоля 	 = Операнд.ПравилаИспользованияПолейЗапроса;
		КоличествоСтрокПВ = ТабПараметрыДляСравнения.Количество();
		КоличествоСтрокПИ = ТабПоля.Количество();
		
		мСоответствиеОперандовИПоказателейОтбораКонтр.Вставить(Операнд.Ссылка, Операнд.ПоказательОтбор);
		
		Если Операнд.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета Тогда
			
			// Определим, предназначен ли данный операнд для использования в текущем контексте отчета.
			Операнд.ПоказательТекущегоОтчета = Операнд.ПоказательТекущегоОтчета И (Операнд.ВидОтчетаОтбор = ВидОтчета);
			
			Если Операнд.ПоказательТекущегоОтчета 
				И НЕ ЗначениеЗаполнено(Операнд.ГруппаРаскрытия)
				И СтрокаДляПростыхОперандов <> Неопределено Тогда
				//Если это показатель текущего отчета, то есть нет специального отбора по организации, сценарию, периоду, доп. реквизитам, 
				//и у показателя нет группы раскрытия, не требуется сравнение таблиц ПВ и ПИ - ПВ одинаковые, ПИ - пустая.
				ЕстьАналогичныйОтбор=Истина;
				СтрокаДляПростыхОперандов.СписокОперандов.Добавить(Операнд);
				Операнд.ПростойРежим = Истина;
			Иначе
				СтруктураОтбора = Новый Структура("СпособПолучения,ВидОтчетаОтбор,ВключатьПромежуточныеИтоги,КоличествоСтрокПВ,КоличествоСтрокПИ",
					Операнд.СпособПолучения,Операнд.ВидОтчетаОтбор,Операнд.ВключатьПромежуточныеИтоги,КоличествоСтрокПВ,КоличествоСтрокПИ);
				МассивИскомыхСтрок = мТабПоказателиЗапросыКонтр.НайтиСтроки(СтруктураОтбора);
				
				Для Каждого СтрокаОтбор ИЗ МассивИскомыхСтрок Цикл
					ТаблицыВычисленияОдинаковые = СравнитьТаблицыВычисленияПараметровОперандов(ТабПараметрыДляСравнения,СтрокаОтбор.ПВДляСравнения);
					Если ТаблицыВычисленияОдинаковые 
						И Справочники.ОперандыПоказателей.СравнитьТаблицыПолейЗапроса(ТабПоля,СтрокаОтбор.ПравилаИспользованияПолей) Тогда
						
						ЕстьАналогичныйОтбор=Истина;
						Операнд.ПростойРежим = СтрокаОтбор.ПростойРежим;
						СтрокаОтбор.СписокОперандов.Добавить(Операнд);
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли Операнд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПараметрическаяНастройка Тогда
			
			ТекПоказатель = Операнд.ПоказательОтбор;
			СтруктураПоиска = Новый Структура("СпособПолучения,ВидОтчетаОтбор,ВключатьПромежуточныеИтоги,КоличествоСтрокПВ,КоличествоСтрокПИ",
				Операнд.СпособПолучения,Операнд.ВидОтчетаОтбор,Операнд.ВключатьПромежуточныеИтоги,КоличествоСтрокПВ,КоличествоСтрокПИ);
			
			СтрокиТаблицы = мТабПоказателиЗапросыКонтр.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаОтборов Из СтрокиТаблицы Цикл
				
				Для Каждого СтрОперанд Из СтрокаОтборов.СписокОперандов Цикл
					
					Если СтрОперанд.Значение.ПоказательОтбор = ТекПоказатель 
						 И СравнитьТаблицыВычисленияПараметровОперандов(ТабПараметрыДляСравнения,СтрокаОтбор.ПВДляСравнения) 
						 И Справочники.ОперандыПоказателей.СравнитьТаблицыПолейЗапроса(ТабПоля,СтрокаОтборов.ПравилаИспользованияПолей) Тогда
						 
						СтрокаОтборов.СписокОперандов.Добавить(Операнд);
						ЕстьАналогичныйОтбор = Истина;
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЕстьАналогичныйОтбор Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ ЕстьАналогичныйОтбор Тогда
			
			НовыйОтбор=мТабПоказателиЗапросыКонтр.Добавить();
			
			СписокОперандов=Новый СписокЗначений;
			СписокОперандов.Добавить(Операнд);
			
			НовыйОтбор.СписокОперандов			   = СписокОперандов;
			НовыйОтбор.ПравилаВычисленияПараметров = ТабПараметры;
			НовыйОтбор.ПВДляСравнения = ТабПараметрыДляСравнения;
			НовыйОтбор.ПравилаИспользованияПолей   = ТабПоля;
			НовыйОтбор.СпособПолучения			   = Операнд.СпособПолучения;
			НовыйОтбор.ЕстьРаскрытиеПоАналитике    = КоличествоСтрокПИ > 0;
			НовыйОтбор.ВключатьПромежуточныеИтоги  = Операнд.ВключатьПромежуточныеИтоги;
			Если Операнд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПараметрическаяНастройка Тогда
				НовыйОтбор.ТекстЗапроса = БюджетнаяОтчетность.СоздатьЗапросПараметрическойНастройки(Операнд.ПоказательОтбор,НовыйОтбор.ЕстьРаскрытиеПоАналитике);
			Иначе
				НовыйОтбор.ТекстЗапроса=Операнд.ТекстЗапросаМодуля;
			КонецЕсли;
			НовыйОтбор.ПоказательТекущегоОтчета = Операнд.ПоказательТекущегоОтчета;
			НовыйОтбор.ВидОтчетаОтбор			= Операнд.ВидОтчетаОтбор;			
			
			НовыйОтбор.КоличествоСтрокПВ = КоличествоСтрокПВ;//для отбора
			НовыйОтбор.КоличествоСтрокПИ = КоличествоСтрокПИ;//для отбора
			
			Если Операнд.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета
				И Операнд.ПоказательТекущегоОтчета Тогда
				// Если это показатель текущего отчета, возможна оптимизация расчета
				Если НЕ ЗначениеЗаполнено(Операнд.ГруппаРаскрытия) Тогда
					//Если это показатель без группы раскрытия, то устанавливаем признак Простого режима расчета
					НовыйОтбор.ПростойРежим = Истина;
					Операнд.ПростойРежим = НовыйОтбор.ПростойРежим;
					Если СтрокаДляПростыхОперандов = Неопределено Тогда
						//Если строка для простых операндов не задана, то выберем текущую строку таблицы для операндов
						//текущего отчета без дополнительных отборов
						СтрокаДляПростыхОперандов = НовыйОтбор;
					КонецЕсли;
				Иначе
					Если НовыйОтбор.ЕстьРаскрытиеПоАналитике = Ложь Тогда
						//Если это показатель группы раскрытия, то если у него нет детализации по аналитике,
						//а также нет отбора по аналитике, то тоже может быть использован простой режим
						ЕстьОтборПоАналитике = Ложь;
						Для Каждого СтрПВ Из ТабПараметрыДляСравнения Цикл
							Если СтрНачинаетсяС(СтрПВ.ИмяПараметра,"Аналитика") Тогда
								ЕстьОтборПоАналитике = Истина;
								Прервать;
							КонецЕсли;							
						КонецЦикла;
						Если ЕстьОтборПоАналитике = Ложь Тогда						
							НовыйОтбор.ПростойРежим = Истина;
							Операнд.ПростойРежим = НовыйОтбор.ПростойРежим;
							Если СтрокаДляПростыхОперандов = Неопределено Тогда
								//Если строка для простых операндов не задана, то выберем текущую строку таблицы для операндов
								//текущего отчета без дополнительных отборов
								СтрокаДляПростыхОперандов = НовыйОтбор;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;					
				КонецЕсли;
			КонецЕсли;
						
		КонецЕсли;	
		
	КонецЦикла;
		
	мТабПоказателиЗапросыКонтр.Колонки.Удалить("ПВДляСравнения");	
	мОперандыКонтр.Колонки.Удалить("ПВДляСравнения");
	// Подготовим таблицу контрольных соотношений
		
	мКонтрольныеСоотношения.Колонки.Добавить("ВыражениеЛев");
	мКонтрольныеСоотношения.Колонки.Добавить("ВыражениеПрав");
	мКонтрольныеСоотношения.Колонки.Добавить("Условие");
	мКонтрольныеСоотношения.Колонки.Добавить("СписокИспользуемыхЛев");
	мКонтрольныеСоотношения.Колонки.Добавить("СписокИспользуемыхПрав");
	мКонтрольныеСоотношения.Колонки.Добавить("ЗначениеЛев");
	мКонтрольныеСоотношения.Колонки.Добавить("ЗначениеПрав");
	мКонтрольныеСоотношения.Колонки.Добавить("ДанныеРасчета");
	мКонтрольныеСоотношения.Колонки.Добавить("РезультатРасчета",Новый ОписаниеТипов("Булево"));
	мКонтрольныеСоотношения.Колонки.Добавить("РасчетВыполнен",Новый ОписаниеТипов("Булево"));
	мКонтрольныеСоотношения.Колонки.Добавить("Использование",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1));
	мКонтрольныеСоотношения.Колонки.Добавить("ТекстОшибкиРасчета",Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрСоотношение ИЗ мКонтрольныеСоотношения Цикл
		
		БюджетнаяОтчетность.РазобратьКС(СтрСоотношение);
		
	КонецЦикла;
	мКонтрольныеСоотношения.Индексы.Добавить("КонтрольноеСоотношение");	
КонецПроцедуры

// Возвращает отредактированный список контрольных соотношений  
//
// Параметры:
//  СписокКонтрольныхСоотношений - СписокЗначений - список контрольных соотношений для проверки по условию
// 
// Возвращаемое значение:
//  Массив - отредактированный список контрольных соотношений, прошедшую проверку по условию 
//
Функция ОтобратьКонтрольныеСоотношенияПоУсловию(Знач СписокКонтрольныхСоотношений) Экспорт
	
	РеквизитыПериода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодОтчета,"ДатаОкончания,Периодичность");
	ДатаОкончания = РеквизитыПериода.ДатаОкончания;
	ПериодичностьОтчетногоПериода = РеквизитыПериода.Периодичность;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокКонтрольныхСоотношений",СписокКонтрольныхСоотношений);	
	Запрос.УстановитьПараметр("ПустоеКС",Справочники.КонтрольныеСоотношения.ПустаяСсылка());	
	Запрос.УстановитьПараметр("ДатаДействияКС",ДатаОкончания);
	
	Запрос.Текст = ЗапросУсловийКонтрольныхСоотношений();
	
	Результаты	= Запрос.ВыполнитьПакет();	
	ВыборкаКС	= Результаты[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НовыйСписокКонтрольныхСоотношений	= Результаты[3].Выгрузить().ВыгрузитьКолонку("КонтрольноеСоотношение");	//Контрольные соотношения без условий	
	
	Если ВыборкаКС.Количество() Тогда
		РеквизитыПроверкиКС = Новый Структура;
		
		ОтчетнаяДатаДокумента = КонецДня(ДатаОкончания)+1;
		ОтчетнаяДатаДокумента = Дата(4,Месяц(ОтчетнаяДатаДокумента),День(ОтчетнаяДатаДокумента));
		
		ГлаваПоБКОрганизации = Строка(БюджетнаяОтчетностьПолучениеНСИ.ГлаваПоБКПолучательОтчета(Организация,ИФО));
		ЭБОрганизации = БюджетнаяОтчетностьПолучениеНСИ.ЭлементБюджета(Организация,ИФО);
		
		ДопЗначения = Новый Структура;
		ДопЗначения.Вставить("ТипОрганизации",Перечисления.ТипыОрганизаций.Обычная); //В БГУ всегда обычные организации
		ДопЗначения.Вставить("ТипКонсолидирующейОрганизации",Перечисления.ТипыКонсолидирующихОрганизаций.ПустаяСсылка()); //в БГУ всегда не заполнено
		ДопЗначения.Вставить("ГлаваПоБК",ГлаваПоБКОрганизации);
		ДопЗначения.Вставить("ЭлементБюджета",ЭБОрганизации);
		ДопЗначения.Вставить("ПрочиеУсловия",Истина); //сравниваем результат вычисления в формуле с Истина
		ДопЗначения.Вставить("Периодичность",ПериодичностьОтчетногоПериода);
		
		ПоказателиЗапросыКонтр = ЗаполнитьПоказателиЗапроса(ВыборкаКС, РеквизитыПроверкиКС);
		
		Если ПоказателиЗапросыКонтр.Количество() Тогда 
			
			СписокКСУсловий = КонтрольныеСоотношенияПоУсловию(ОтчетнаяДатаДокумента, ДопЗначения, ПоказателиЗапросыКонтр, РеквизитыПроверкиКС);	
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НовыйСписокКонтрольныхСоотношений, СписокКСУсловий);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат НовыйСписокКонтрольныхСоотношений;
	
КонецФункции

// Возвращает контрольные соотношения отобранные по условию
//
// Параметры:
//  ОтчетнаяДатаДокумента	 - Дата - отчетная дата документа
//  ПоказателиЗапросыКонтр	 - ТаблицаЗначений - таблица КС с условиями проверки
//  РеквизитыПроверкиКС		 - Структура - список реквизитов участвующих в проверки
// 
// Возвращаемое значение:
//  Массив - контрольные соотношения удовлетворяющему условий отбора
//
Функция КонтрольныеСоотношенияПоУсловию(Знач ОтчетнаяДатаДокумента, Знач ДопЗначения, Знач ПоказателиЗапросыКонтр, Знач РеквизитыПроверкиКС)
	
	СписокКонтрольныхСоотношений = Новый Массив;
	
	Запрос =Новый Запрос; 
	
	ТекстЗапросаВнутр = "ВЫБРАТЬ ";
	
	//Создание таблицы в запросе с данными отчета
	Для Каждого РеквизитПроверки из РеквизитыПроверкиКС Цикл
		Ключ = РеквизитПроверки.Ключ;
		ЗначениеРекв = "";
		
		Если Ключ = "ОтчетнаяДата" Тогда
			ЗначениеРекв =  ОтчетнаяДатаДокумента;
		ИначеЕсли ДопЗначения.Свойство(Ключ) Тогда
			ЗначениеРекв =  ДопЗначения[Ключ]; //ГлаваПоБК, ЭлементБюджета, Периодичность, ТипОрганизации, ТипКонсолидирующейОрганизации, ПрочиеУсловия
		ИначеЕсли Лев(Ключ,9) = "Реквизит_" Тогда
			ДополнительныеРеквизиты.Свойство(Сред(Ключ,10),ЗначениеРекв);
		Иначе
			ЗначениеРекв = ЭтотОбъект[Ключ];
		КонецЕсли;
		ТекстЗапросаВнутр = ТекстЗапросаВнутр + Символы.ПС + "&" + Ключ + " КАК "+ Ключ +",";
		Запрос.Параметры.Вставить(Ключ,ЗначениеРекв);
	КонецЦикла;
	ТекстЗапросаВнутр = Лев(ТекстЗапросаВнутр,СтрДлина(ТекстЗапросаВнутр)-1);
	ТекстЗапросаВнутр = ТекстЗапросаВнутр + Символы.ПС + "ПОМЕСТИТЬ ДанныеОтчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	//Создание в запросе таблиц для проверки
	ТекстПоказателей = "";
	Для Каждого ПоказателяЗапроса из ПоказателиЗапросыКонтр Цикл
		
		НомерПроверки = Формат(ПоказателиЗапросыКонтр.Индекс(ПоказателяЗапроса)+1,"ЧГ=0");
		ТекстПоказателей = ТекстПоказателей + "ОБЪЕДИНИТЬ ВСЕ " + Символы.ПС + "ВЫБРАТЬ";
		ТекстПоказателей = ТекстПоказателей + "
		| "+НомерПроверки + " КАК НомерСтроки
		|ИЗ
		|	ДанныеОтчета КАК ДанныеОтчета
		|ГДЕ";
		УсловияТекст = "";
		Для Каждого ПравилаВычисления из ПоказателяЗапроса.ПравилаВычисленияПараметров Цикл
			
			УсловияТекст = УсловияТекст + " И ДанныеОтчета." + ПравилаВычисления.ИмяПараметра
				+ БюджетнаяОтчетность.ПолучитьМетодОтбора(ПравилаВычисления.ВидСравнения,ПравилаВычисления.ИмяПараметра+НомерПроверки) + Символы.ПС;
			
			Запрос.Параметры.Вставить(ПравилаВычисления.ИмяПараметра+НомерПроверки,ПравилаВычисления.ЗначениеИзКонтекста);
		КонецЦикла;
		ТекстПоказателей = ТекстПоказателей + Символы.ПС + Сред(УсловияТекст,4);
	КонецЦикла;
	ТекстЗапросаВнутр = ТекстЗапросаВнутр + Сред(ТекстПоказателей,15);
	
	Запрос.Текст =ТекстЗапросаВнутр;
			
	Результат = Запрос.Выполнить();
	
	ВыборкаСтрок = Результат.Выбрать();
	Пока ВыборкаСтрок.Следующий() Цикл
		
		СписокКС = ПоказателиЗапросыКонтр[ВыборкаСтрок.НомерСтроки-1].СписокКонтрольныхСоотношений;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокКонтрольныхСоотношений,СписокКС.ВыгрузитьЗначения());
		
	КонецЦикла;

	Возврат СписокКонтрольныхСоотношений;
КонецФункции

// Функция - Запрос условий контрольных соотношений
// 
// Возвращаемое значение:
// Строка  - текст запроса к контрольным соотношениям
//
Функция ЗапросУсловийКонтрольныхСоотношений()
	
	Перем ТекстЗапроса;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтрольныеСоотношения.Ссылка КАК КонтрольноеСоотношение
	|ПОМЕСТИТЬ СписокКонтрольныхСоотношений
	|ИЗ
	|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	|ГДЕ
	|	КонтрольныеСоотношения.Ссылка В(&СписокКонтрольныхСоотношений)
	|	И КонтрольныеСоотношения.ДатаНачалаДействия <= &ДатаДействияКС
	|	И КонтрольныеСоотношения.ДатаОкончанияДействия >= &ДатаДействияКС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонтрольноеСоотношение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УсловияКонтрольныхСоотношений.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	|	УсловияКонтрольныхСоотношений.ИмяПараметра,
	|	УсловияКонтрольныхСоотношений.СпособВычисленияПараметра,
	|	УсловияКонтрольныхСоотношений.УточнениеСпособаОпределения,
	|	УсловияКонтрольныхСоотношений.ВидАналитикиОтбор,
	|	УсловияКонтрольныхСоотношений.РеквизитАналитики,
	|	СписокКонтрольныхСоотношений.КонтрольноеСоотношение КАК КС
	|ПОМЕСТИТЬ УсловияКС
	|ИЗ
	|	СписокКонтрольныхСоотношений КАК СписокКонтрольныхСоотношений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКонтрольныхСоотношений КАК УсловияКонтрольныхСоотношений
	|		ПО СписокКонтрольныхСоотношений.КонтрольноеСоотношение = УсловияКонтрольныхСоотношений.КонтрольноеСоотношение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонтрольноеСоотношение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УсловияКС.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	|	УсловияКС.ИмяПараметра КАК ИмяПараметра,
	|	УсловияКС.СпособВычисленияПараметра,
	|	УсловияКС.УточнениеСпособаОпределения,
	|	УсловияКС.ВидАналитикиОтбор,
	|	УсловияКС.РеквизитАналитики
	|ИЗ
	|	УсловияКС КАК УсловияКС
	|ГДЕ
	|	НЕ УсловияКС.КонтрольноеСоотношение ЕСТЬ NULL 
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтрольноеСоотношение,
	|	ИмяПараметра
	|ИТОГИ ПО
	|	КонтрольноеСоотношение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УсловияКС.КС КАК КонтрольноеСоотношение
	|ИЗ
	|	УсловияКС КАК УсловияКС
	|ГДЕ
	|	УсловияКС.КонтрольноеСоотношение ЕСТЬ NULL ";
	Возврат ТекстЗапроса;

КонецФункции


// Возвращает таблицу с контрольными соотношениями, сгруппированными по условиям
//
// Параметры:
//  ВыборкаКС			 - РезультатЗапроса	 - 
//  ГодОтчета			 - Число - год отчетной даты
//  РеквизитыПроверкиКС	 - Структура - список реквизитов участвующих в проверки
// 
// Возвращаемое значение:
//  ТаблицаЗНачений - таблица с контрольными соотношениями, сгруппированными по условиям
//
Функция ЗаполнитьПоказателиЗапроса(Знач ВыборкаКС,РеквизитыПроверкиКС)
	
	ПравилаВычисленияПараметров=Новый ТаблицаЗначений;
	ПравилаВычисленияПараметров.Колонки.Добавить("ИмяПараметра");
	ПравилаВычисленияПараметров.Колонки.Добавить("ПредставлениеПараметра");
	ПравилаВычисленияПараметров.Колонки.Добавить("СпособВычисленияПараметра");
	ПравилаВычисленияПараметров.Колонки.Добавить("УточнениеСпособаОпределения");
	ПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеДляПроверки");
	ПравилаВычисленияПараметров.Колонки.Добавить("ВидАналитикиОтбор");
	ПравилаВычисленияПараметров.Колонки.Добавить("РеквизитАналитики");
	ПравилаВычисленияПараметров.Колонки.Добавить("ИзКонтекста",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
	ПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста");
	ПравилаВычисленияПараметров.Колонки.Добавить("ВидСравнения");
	
	ПоказателиЗапросыКонтр=Новый ТаблицаЗначений;
	ПоказателиЗапросыКонтр.Колонки.Добавить("СписокКонтрольныхСоотношений");
	ПоказателиЗапросыКонтр.Колонки.Добавить("ПравилаВычисленияПараметров");
	ПоказателиЗапросыКонтр.Колонки.Добавить("КоличествоПараметров");
	ПоказателиЗапросыКонтр.Колонки.Добавить("ИменаПараметров");
	ПоказателиЗапросыКонтр.Индексы.Добавить("КоличествоПараметров,ИменаПараметров");
	
	СоответствиеОтборов = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьСоответствиеОтборовОперандов();
	Пока ВыборкаКС.Следующий() Цикл
		ВыборкаУсловие = ВыборкаКС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		КопияПравилаВычисления = ПравилаВычисленияПараметров.СкопироватьКолонки();
		ЕстьАналогичныйОтбор=Ложь;
		
		Пока ВыборкаУсловие.Следующий() Цикл
			
			СтрокаПравила = КопияПравилаВычисления.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПравила,ВыборкаУсловие,,"УточнениеСпособаОпределения");
			СтрокаПравила.УточнениеСпособаОпределения = ВыборкаУсловие.УточнениеСпособаОпределения;
			
			Если ВыборкаУсловие.ИмяПараметра = "ОтчетнаяДата" Тогда
				СписокОтчетныхДат = ВыборкаУсловие.УточнениеСпособаОпределения.Получить();
				СтрокаПравила.ЗначениеИзКонтекста = СписокОтчетныхДат;
				СтрокаПравила.ИзКонтекста = Истина;
				СтрокаПравила.ВидСравнения = СоответствиеОтборов[СтрокаПравила.СпособВычисленияПараметра]; 
			Иначе
				СвойстваПараметра = ПолучитьСвойстваПараметра(СтрокаПравила);
				Если Не ЗначениеЗаполнено(СвойстваПараметра.ВидСравнения) Тогда
					//ошибка в расчете формулы на встроенном языке
					КопияПравилаВычисления.Удалить(СтрокаПравила);//удалим не корректное условие
					Продолжить;
				Иначе
					СтрокаПравила.ЗначениеИзКонтекста = СвойстваПараметра.Значение;
					СтрокаПравила.ИзКонтекста = Истина;
					СтрокаПравила.ВидСравнения = СвойстваПараметра.ВидСравнения;
				КонецЕсли; 
			КонецЕсли;
			
			РеквизитыПроверкиКС.Вставить(ВыборкаУсловие.ИмяПараметра);
		КонецЦикла;
		КоличествоПВ = КопияПравилаВычисления.Количество();
		
		ИменаПараметров = СтрСоединить(КопияПравилаВычисления.ВыгрузитьКолонку("ИмяПараметра"));
		СтруктураПоиска = Новый Структура("КоличествоПараметров,ИменаПараметров",КоличествоПВ,ИменаПараметров);
		
		МассивИскомыхСтрок = ПоказателиЗапросыКонтр.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого СтрокаОтбор ИЗ МассивИскомыхСтрок Цикл
			
			Если СравнитьТаблицыВычисленияПараметровОперандов(КопияПравилаВычисления,СтрокаОтбор.ПравилаВычисленияПараметров) Тогда
				
				ЕстьАналогичныйОтбор=Истина;
				
				СтрокаОтбор.СписокКонтрольныхСоотношений.Добавить(ВыборкаКС.КонтрольноеСоотношение);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьАналогичныйОтбор Тогда
			
			НовыйОтбор=ПоказателиЗапросыКонтр.Добавить();
			
			СписокКонтрольныхСоотношений=Новый СписокЗначений;
			СписокКонтрольныхСоотношений.Добавить(ВыборкаКС.КонтрольноеСоотношение);
			
			НовыйОтбор.СписокКонтрольныхСоотношений	= СписокКонтрольныхСоотношений;
			НовыйОтбор.ПравилаВычисленияПараметров	= КопияПравилаВычисления;
			НовыйОтбор.КоличествоПараметров			= КоличествоПВ;
			НовыйОтбор.ИменаПараметров				= ИменаПараметров;
			
		КонецЕсли;		
	КонецЦикла;

	Возврат ПоказателиЗапросыКонтр;
КонецФункции

//ВидКС:
//- "МФ" - только межформенные КС
//- "ВФ" - только внутриформенные КС
//- "" и любые другие значения - все КС, без отбора
Функция ПолучитьСписокКонтрольныхСоотношений(ВидКС = "") Экспорт
	
	МассивПравилДляПроверки = БюджетнаяОтчетность.ПолучитьМассивНаследуемыхПравил(ВидОтчета,ПравилоПроверки);
	МассивПравилДляПроверки.Добавить(ПравилоПроверки);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПравилоПроверки",МассивПравилДляПроверки);
	Запрос.УстановитьПараметр("ТолькоЭтотОтчет",Истина);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение
	|ИЗ
	|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	|		ПО ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение = КонтрольныеСоотношения.Ссылка
	|ГДЕ
	|	ПравилаПроверкиКонтрольныеСоотношения.Ссылка В(&ПравилоПроверки)
	|	И КонтрольныеСоотношения.НеИспользуется = ЛОЖЬ";
	Если ВидКС = "ВФ" Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И (КонтрольныеСоотношения.ПоказателиТекущегоОтчета = ИСТИНА
		|		ИЛИ КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК)))";
	ИначеЕсли ВидКС = "МФ" Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И КонтрольныеСоотношения.ПоказателиТекущегоОтчета = ЛОЖЬ
		|	И НЕ КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтрольноеСоотношение";
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	Иначе
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("КонтрольноеСоотношение");
	КонецЕсли;
	
КонецФункции // ПолучитьСписокКонтрольныхСоотношений()

// Процедура отрабатывает при расчете контрольных соотношений
//
Функция РассчитатьКонтрольныеСоотношения(Знач СписокКонтрольныхСоотношений)
	
	ДанныеВидовАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.ПолучитьДанныеВидовАналитики();
	
	// Готовим исходные данные для расчета контрольных соотношений
	
	ПодготовитьДанныеКонтрольныхСоотношений(СписокКонтрольныхСоотношений);
	
	// Готовим таблицы данных по параметрически настроенным операндам	
	
	мСоответствиеПроблемныхКС = Новый Соответствие;//перечень кс, при подготовке таблицы операндов которых возникли ошибки

	ПодготовитьТаблицуЗначенийОперандовКонтр(мСоответствиеПроблемныхКС);
	
	// Удалим контрольные соотношения, которые не должны рассчитываться в данном отчете.
	УсловияПоиска = Новый Структура;
	УсловияПоиска.Вставить("ВидОтчетаОтбор",ВидОтчета);
	УсловияПоиска.Вставить("ТребуетАнализа",Истина);
	
	СоотношенияДляПроверки  = Новый Соответствие;
	ОперандыДляАнализа = мОперандыКонтр.НайтиСтроки(УсловияПоиска);
	
	УсловияПоиска.Очистить();
	Для Каждого СтрОперанд Из ОперандыДляАнализа Цикл
		//Если во всех операндах КС текущего вида отчета установлен отбор на доп. реквизиты/организацию/период/сценарий,
		//не совпадающие с текущим отчетом, то это КС не должно выполняться для данного отчета.
		//Такие КС исключаются в этом цикле.
		Если СоотношенияДляПроверки[СтрОперанд.КонтрольноеСоотношение] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСоотношение = мКонтрольныеСоотношения.Найти(СтрОперанд.КонтрольноеСоотношение,"КонтрольноеСоотношение");
		
		УсловияПоиска.Вставить("КонтрольноеСоотношение",СтрОперанд.КонтрольноеСоотношение);
		ОперандыСоотношения = мОперандыКонтр.НайтиСтроки(УсловияПоиска);
		
		ОтключитьСоотношение = Истина;
		
		Для Каждого ОперандСоотношения Из ОперандыСоотношения Цикл
			Если ОперандСоотношения.ВидОтчетаОтбор = ВидОтчета И Не ОперандСоотношения.ТребуетАнализа Тогда
				// В соотношении есть операнд, который должен быть получен из текущего контекста.
				// Остальные операнды запросят значения из ИБ.
				
				ОтключитьСоотношение = Ложь;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ОтключитьСоотношение Тогда
			мКонтрольныеСоотношения.Удалить(СтрСоотношение);
		КонецЕсли;
		
		СоотношенияДляПроверки[СтрОперанд.КонтрольноеСоотношение] = Истина; // Соотношение обработано.
		
	КонецЦикла;
	
	
	// Рассчитаем показатели
	
	ПроверкаПройденаБезОшибок = Истина;
	ПроверкаПройденаБезПредупреждений = Истина;
	ПроверкаПройденаБезОшибокРасчета = Истина;
	
	ВФОшибки = 0;
	ВФПредупреждения = 0;
	МФОшибки = 0;
	МФПредупреждения = 0;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Для Каждого КонтрСоотношение ИЗ мКонтрольныеСоотношения Цикл
		
		Если ПустаяСтрока(КонтрСоотношение.Процедура) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		КонтрСоотношение.РасчетВыполнен = Истина; // Устанавливаем начальное значение флага.
		
		Если мСоответствиеПроблемныхКС[КонтрСоотношение.КонтрольноеСоотношение] = Истина Тогда
			//это КС с проблемными операндами
			
			КонтрСоотношение.РасчетВыполнен = Ложь;//ошибка в расчете КС
			КонтрСоотношение.РезультатРасчета = Истина;//чтобы не считалось, что это ошибка по КС
			ПроверкаПройденаБезОшибокРасчета = Ложь;
			
			Продолжить;
		КонецЕсли;
		
		РассчитатьСоотношение(КонтрСоотношение);
		
		Если КонтрСоотношение.РасчетВыполнен = Ложь Тогда
			ПроверкаПройденаБезОшибокРасчета = Ложь;
			КонтрСоотношение.РезультатРасчета = Истина;//Если не установилось при расчете, установим сейчас, т.к. не считаем ошибкой
			Продолжить;
		КонецЕсли;
		
		Если КонтрСоотношение.Дополнительное Тогда
			ПроверкаПройденаБезПредупреждений = ПроверкаПройденаБезПредупреждений И КонтрСоотношение.РезультатРасчета;		
		Иначе
			ПроверкаПройденаБезОшибок = ПроверкаПройденаБезОшибок И КонтрСоотношение.РезультатРасчета;
		КонецЕсли;		
		
		Если КонтрСоотношение.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.Межформенное Тогда
			
			Если КонтрСоотношение.РезультатРасчета = Ложь И НЕ КонтрСоотношение.Дополнительное Тогда
				МФОшибки = МФОшибки + 1;
			КонецЕсли;	
			Если КонтрСоотношение.РезультатРасчета = Ложь И КонтрСоотношение.Дополнительное Тогда
				МФПредупреждения = МФПредупреждения + 1;
			КонецЕсли;
			
		Иначе
			
			Если КонтрСоотношение.РезультатРасчета = Ложь И НЕ КонтрСоотношение.Дополнительное Тогда
				ВФОшибки = ВФОшибки + 1;
			КонецЕсли;
			Если КонтрСоотношение.РезультатРасчета = Ложь И КонтрСоотношение.Дополнительное Тогда
				ВФПредупреждения = ВФПредупреждения + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("БезОшибок",			ПроверкаПройденаБезОшибок);
	РезультатПроверки.Вставить("БезПредупреждений",	ПроверкаПройденаБезПредупреждений);
	РезультатПроверки.Вставить("БезОшибокРасчета", 	ПроверкаПройденаБезОшибокРасчета);

	РезультатПроверки.Вставить("ВФКонтроль", 		Истина);
	РезультатПроверки.Вставить("ВФОшибки",			ВФОшибки);
	РезультатПроверки.Вставить("ВФПредупреждения",	ВФПредупреждения);
	
	РезультатПроверки.Вставить("МФКонтроль", 		Истина);
	РезультатПроверки.Вставить("МФОшибки",			МФОшибки);
	РезультатПроверки.Вставить("МФПредупреждения",	МФПредупреждения);
	
	Возврат РезультатПроверки;
	
КонецФункции // РассчитатьКонтрольныеСоотношения()

Процедура РассчитатьСоотношение(КонтрСоотношение)

	РабочаяТаблица = Новый ТаблицаЗначений;
	РабочаяТаблица.Колонки.Добавить("Значение");
	РабочаяТаблица.Колонки.Добавить("ИтогПоПоказателю",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
	
	ТекстСверткиОперанды="";
	ТекстСверткиИзмерения="";
	СтруктураРасчета = Новый Структура;
	
	ОперандыБезАналитики = Новый Структура; 	// Структура, в которой хранятся значения операндов, не раскрывающихся
												// по аналитикам. Эти значения будут использоваться для всех комбинаций
												// аналитических раскрытий.
	СтруктураАналитик = Новый Структура;
	
	ОбщийСписокОперандов = Новый Массив;
	
	ЧастиКС = Новый Массив(2);
	ЧастиКС[0] = "Лев";
	ЧастиКС[1] = "Прав";
	ТипСтрока = Тип("Строка");
	
	ТекстСверткиИзмеренияКод = "";
	Для Каждого Часть Из ЧастиКС Цикл
		Для Каждого Операнд Из КонтрСоотношение["СписокИспользуемых"+Часть] Цикл
			
			КодОперанда				= Операнд.Значение;
			КонтрольноеСоотношение  = КонтрСоотношение.КонтрольноеСоотношение;
			
			РабочийКод = "_"+КодОперанда;
			
			ОбщийСписокОперандов.Добавить(КодОперанда);
			
			ОперандыКС = мОперандыКонтр.НайтиСтроки(Новый Структура("Код,КонтрольноеСоотношение",КодОперанда,КонтрольноеСоотношение));
			
			Если ОперандыКС.Количество() = 0 Тогда // в формуле неизвестный операнд
				Продолжить;
			Иначе
				СтрОперанд = ОперандыКС[0];
			КонецЕсли;
			
			ТекстСверткиОперанды = ТекстСверткиОперанды + "," + РабочийКод;
			
			// Добавление колонок аналитики
			Для Каждого ИспользуемаяАналитика Из СтрОперанд.ПравилаИспользованияПолейЗапроса Цикл
				
				ИмяКолонкиАналитикиДляТаблицы = ИспользуемаяАналитика.КодАналитики;
				Если ЗначениеЗаполнено(ИспользуемаяАналитика.СопоставляемаяАналитика) Тогда
					ТекДанныеВидаАналитики = ДанныеВидовАналитики[ИспользуемаяАналитика.СопоставляемаяАналитика];
					ИмяКолонкиАналитикиДляТаблицы = ТекДанныеВидаАналитики.АналитикаКод;
				КонецЕсли;
				
				КодАналитики = ИмяКолонкиАналитикиДляТаблицы;
				Если РабочаяТаблица.Колонки.Найти(КодАналитики) = Неопределено Тогда
					Заголовок = "";
					Если КодАналитики = "АналитикаКОСГУ" ИЛИ КодАналитики = "АналитикаКВФ" Тогда
						Заголовок = Сред(КодАналитики,10);
					Иначе
						Заголовок = Строка(ИспользуемаяАналитика.АналитикаОперанда);
					КонецЕсли;
					РабочаяТаблица.Колонки.Добавить(КодАналитики,,Заголовок);
					ТекстСверткиИзмерения = ТекстСверткиИзмерения + "," + КодАналитики;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИспользуемаяАналитика.РеквизитАналитики)
					И мЗначенияОперандовКонтр.Колонки.Найти(КодАналитики+"_Код")<>Неопределено Тогда
					Если РабочаяТаблица.Колонки.Найти(КодАналитики+"_Код") = Неопределено Тогда
						РабочаяТаблица.Колонки.Добавить(КодАналитики+"_Код");
						ТекстСверткиИзмеренияКод = ТекстСверткиИзмеренияКод + "," + КодАналитики+"_Код";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			// Добавление колонок значений
			Если РабочаяТаблица.Колонки.Найти(РабочийКод) = Неопределено Тогда
				РабочаяТаблица.Колонки.Добавить(РабочийКод);
			Иначе
				// Операнд уже используется при расчете, его значение внесено в рабочую таблицу.
				Продолжить;
			КонецЕсли;
			
			Если СтрОперанд.ПростойРежим Тогда
				
				ИтогСумма = Неопределено;
				Показатели.Свойство(СтрОперанд.ПоказательОтборКод,ИтогСумма);
				Если ИтогСумма = Неопределено Тогда
					ИтогСумма = 0;
				ИначеЕсли ТипЗнч(ИтогСумма)= ТипСтрока Тогда
					Попытка
						ИтогСумма = Число(ИтогСумма);
					Исключение
						ИтогСумма = 0;
					КонецПопытки;
				КонецЕсли;
				
				НовСтр = РабочаяТаблица.Добавить();
				
				НовСтр["_"+КодОперанда] = ИтогСумма;
	
				НовСтр.ИтогПоПоказателю = Истина;
				ОперандыБезАналитики.Вставить("_"+КодОперанда,ИтогСумма);
				
			Иначе
				ДобавленныеСтроки = ПолучитьЗначенияОперандаИзТаблицы(мЗначенияОперандовКонтр, КодОперанда, СтрОперанд, РабочаяТаблица,
												  СтруктураАналитик, ОперандыБезАналитики, КонтрольноеСоотношение);
												  
				// Удаление всех неитоговых строк, по которым нет раскрытия.								  
				Если ОперандыБезАналитики.Свойство(РабочийКод) Тогда
					Для Каждого Стр Из ДобавленныеСтроки Цикл
						Если Не Стр.ИтогПоПоказателю Тогда
							РабочаяТаблица.Удалить(Стр);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ДополнитьРабочуюТаблицуДляРасчетаКС(РабочаяТаблица);
	
	РабочаяТаблица.Свернуть("ИтогПоПоказателю" + ТекстСверткиИзмерения+ТекстСверткиИзмеренияКод,Сред(ТекстСверткиОперанды,2));	
	
	Если ЗначениеЗаполнено(ТекстСверткиИзмеренияКод) Тогда
		//Если задана детализация по коду Аналитики,
		//свернем строки с одинаковыми кодами, но разными ссылками.
		//Разные ссылки аналитик перенесем в список значений.
		СтруктураПоиска = Новый Структура("ИтогПоПоказателю"+ТекстСверткиИзмеренияКод);
		РабочаяТаблица.Индексы.Добавить("ИтогПоПоказателю"+ТекстСверткиИзмеренияКод);
		
		МассивОбработанныхСтрок = Новый Массив;
		Для Каждого СтрТЧ Из РабочаяТаблица Цикл
			Если МассивОбработанныхСтрок.Найти(СтрТЧ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрТЧ);
			МассивСтрок = РабочаяТаблица.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() = 1 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого КлючИЗначение Из СтруктураПоиска Цикл
				Если КлючИЗначение.Ключ = "ИтогПоПоказателю" Тогда
					Продолжить;
				КонецЕсли;
				СписокЗначенийАналитики = Новый СписокЗначений;
				ТекИмяАналитики = Лев(КлючИЗначение.Ключ,СтрДлина(КлючИЗначение.Ключ)-4);
				Для Каждого СтрМас Из МассивСтрок Цикл
					Если СписокЗначенийАналитики.НайтиПоЗначению(СтрМас[ТекИмяАналитики])=Неопределено Тогда
						СписокЗначенийАналитики.Добавить(СтрМас[ТекИмяАналитики]);
					КонецЕсли;
				КонецЦикла;
				
				ЗаменятьНаСписок = СписокЗначенийАналитики.Количество()>1;
				Для Каждого СтрМас Из МассивСтрок Цикл
					Если ЗаменятьНаСписок Тогда
						СтрМас[ТекИмяАналитики] = СписокЗначенийАналитики;
					КонецЕсли;
					МассивОбработанныхСтрок.Добавить(СтрМас);
				КонецЦикла;
			КонецЦикла;			
		КонецЦикла;
		//После всех действий свернем таблицу по аналитике, с заданными списками значеий.
		РабочаяТаблица.Свернуть("ИтогПоПоказателю" + ТекстСверткиИзмерения,Сред(ТекстСверткиОперанды,2));	
	КонецЕсли;
	
	ОписаниеТиповЧисло = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя();
	
	РабочаяТаблица.Колонки.Добавить("ЗначениеЛев" , ОписаниеТиповЧисло);
	РабочаяТаблица.Колонки.Добавить("ЗначениеПрав", ОписаниеТиповЧисло);
	
	// Вносим значения операндов, которые используются для каждой строки.
	Если Не ПустаяСтрока(ТекстСверткиИзмерения) Тогда
		Для Каждого ОбщееЗначение ИЗ ОперандыБезАналитики Цикл
			РабочаяТаблица.ЗаполнитьЗначения(ОбщееЗначение.Значение,ОбщееЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;
	
	РассчитатьЧастьКонтрольногоСоотношения(КонтрСоотношение,"Лев",РабочаяТаблица);
	РассчитатьЧастьКонтрольногоСоотношения(КонтрСоотношение,"Прав",РабочаяТаблица);
	
	// Построчное сравнение и расчет результата К.С.
	ДанныеРасчета = РабочаяТаблица.СкопироватьКолонки();
	ДанныеРасчета.Колонки.Добавить("РезультатРасчета",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
	
	ПроверкаПройдена = Истина;
	
	Для Каждого Стр Из РабочаяТаблица Цикл
		
		СтрДанныхРасчета = ДанныеРасчета.Добавить();
		ЗаполнитьЗначенияСвойств(СтрДанныхРасчета,Стр);
		
		Попытка
			СтрДанныхРасчета.РезультатРасчета = Вычислить("Стр.ЗначениеЛев" + КонтрСоотношение.Условие + "Стр.ЗначениеПрав");
			Если Не СтрДанныхРасчета.РезультатРасчета Тогда
				ПроверкаПройдена = Ложь;
			КонецЕсли;
		Исключение
			КонтрСоотношение.РасчетВыполнен = Ложь;
			ПроверкаПройдена = Истина;//не считаем ошибкой проверки ошибку вычисления формулы КС
			
			Если НЕ ЗначениеЗаполнено(КонтрСоотношение.ТекстОшибкиРасчета) Тогда
				ТекстОписания = ОписаниеОшибки();
				//обрежем лишнее
				ПозицияНачалаПодробнойИнформации = Найти(ТекстОписания,"}:");
				Если ПозицияНачалаПодробнойИнформации > 0 Тогда
					ТекстОписания = Сред(ТекстОписания,ПозицияНачалаПодробнойИнформации+2);
				КонецЕсли;
						
				ТекстОшибкиДляПротокола = Нстр("ru='Ошибка вычисления контрольного соотношения. Не удалось выполнить проверку по причине: %1'");
				ТекстОшибкиДляПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляПротокола,ТекстОписания);
						
				КонтрСоотношение.ТекстОшибкиРасчета = ТекстОшибкиДляПротокола;
			КонецЕсли;
			
			Прервать;
		КонецПопытки;
		
		// Необходимо продублировать итог в шапке К.С.
		Если Стр.ИтогПоПоказателю Тогда
			КонтрСоотношение.ЗначениеЛев  = Стр.ЗначениеЛев;
			КонтрСоотношение.ЗначениеПрав = Стр.ЗначениеПрав;
		КонецЕсли;
		
	КонецЦикла;
		
	КонтрСоотношение.РезультатРасчета = ПроверкаПройдена;
	КонтрСоотношение.ДанныеРасчета	  = ДанныеРасчета;
	
	Если Не КонтрСоотношение.РасчетВыполнен Тогда
		ноСообщить("Ошибка вычисления контрольного соотношения "+КонтрСоотношение.КонтрольноеСоотношение+":
					|"+ИнформацияОбОшибке().Описание,СтатусСообщения.Важное,,"Проверка отчета");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьРабочуюТаблицуДляРасчетаКС(РабочаяТаблица)
	
	Если РабочаяТаблица.Колонки.Найти("АналитикаСтрАнГруппа") <> Неопределено
		И РабочаяТаблица.Колонки.Найти("АналитикаСтрАнГруппаКВР") <> Неопределено Тогда
		ДополнитьЗначенияАналитикТаблицы(РабочаяТаблица,"АналитикаСтрАнГруппа","АналитикаСтрАнГруппаКВР");
	КонецЕсли;
	
	Если РабочаяТаблица.Колонки.Найти("АналитикаСтрКРБВид") <> Неопределено
		И РабочаяТаблица.Колонки.Найти("АналитикаСтрАнГруппаКВР") <> Неопределено Тогда
		ДополнитьЗначенияАналитикТаблицы(РабочаяТаблица,"АналитикаСтрКРБВид","АналитикаСтрАнГруппаКВР");
	КонецЕсли;
	
	СоответствиеАналитик = Новый Соответствие;
	СоответствиеАналитик.Вставить("КДБВид2016","СтрКДБВид");
	СоответствиеАналитик.Вставить("КДБГруппаПодвида2016","СтрКДБГруппаПодвида");
	СоответствиеАналитик.Вставить("АнГруппа","СтрАнГруппа");
	
	СоответствиеАналитик.Вставить("КОСГУ","СтрКОСГУ");
	СоответствиеАналитик.Вставить("КорКОСГУ","СтрКорКОСГУ");
	
	СоответствиеАналитик.Вставить("КРБРаздел","СтрКРБРаздел");
	СоответствиеАналитик.Вставить("КРБЦелеваяСтатья","СтрКРБЦелеваяСтатья");
	СоответствиеАналитик.Вставить("КРБПрограмма","СтрКРБПрограмма");
	СоответствиеАналитик.Вставить("КРБВид","СтрКРБВид");
	
	СоответствиеАналитик.Вставить("КИФГруппа","СтрКИФГруппа");
	СоответствиеАналитик.Вставить("КИФСтатья","СтрКИФСтатья");
	СоответствиеАналитик.Вставить("КИФВид","СтрКИФПодвид");
	
	Для Каждого КлючИЗначение Из СоответствиеАналитик Цикл
		
		Если РабочаяТаблица.Колонки.Найти("Аналитика"+КлючИЗначение.Ключ+"_Код") <> Неопределено
			И РабочаяТаблица.Колонки.Найти("Аналитика"+КлючИЗначение.Значение) <> Неопределено Тогда
			
			ДополнитьЗначенияАналитикТаблицыПоКоду(РабочаяТаблица,"Аналитика"+КлючИЗначение.Ключ+"_Код","Аналитика"+КлючИЗначение.Значение,"Аналитика"+КлючИЗначение.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьЗначенияАналитикТаблицы(РабочаяТаблица,ИмяПоля1,ИмяПоля2)
	Для Каждого СтрТЧ Из РабочаяТаблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ[ИмяПоля1])
			И НЕ ЗначениеЗаполнено(СтрТЧ[ИмяПоля2]) Тогда
			СтрТЧ[ИмяПоля2] = СтрТЧ[ИмяПоля1];
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрТЧ[ИмяПоля1])
			И ЗначениеЗаполнено(СтрТЧ[ИмяПоля2]) Тогда
            СтрТЧ[ИмяПоля1] = СтрТЧ[ИмяПоля2];
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ДополнитьЗначенияАналитикТаблицыПоКоду(РабочаяТаблица,ИмяСсылочногоПоляСКодом,ИмяПоляАналитики,ИмяСсылочногоПоля)
	СоответствиеЗначений = Новый Соответствие;
	
	Для Каждого СтрТЧ Из РабочаяТаблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ[ИмяСсылочногоПоляСКодом]) Тогда			
			СоответствиеЗначений.Вставить(СтрТЧ[ИмяСсылочногоПоляСКодом],СтрТЧ[ИмяСсылочногоПоля]);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого СтрТЧ Из РабочаяТаблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ[ИмяСсылочногоПоляСКодом])
			И НЕ ЗначениеЗаполнено(СтрТЧ[ИмяПоляАналитики]) Тогда		
			СтрТЧ[ИмяПоляАналитики] = СтрТЧ[ИмяСсылочногоПоляСКодом];
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрТЧ[ИмяСсылочногоПоляСКодом])
			И ЗначениеЗаполнено(СтрТЧ[ИмяПоляАналитики]) Тогда
			
			//заполняем ссылочными значениями только те строки с аналитикой, значения которых (по коду) присутствует в таблице.
			Если СоответствиеЗначений[СтрТЧ[ИмяПоляАналитики]] <> Неопределено Тогда			
            	СтрТЧ[ИмяСсылочногоПоляСКодом] = СтрТЧ[ИмяПоляАналитики];
				СтрТЧ[ИмяСсылочногоПоля] = СоответствиеЗначений[СтрТЧ[ИмяПоляАналитики]];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Процедура РассчитатьЧастьКонтрольногоСоотношения(КонтрСоотношение, Часть, Знач РабочаяТаблица)
		
	// Преобразуем процедуру для расчета
	РабочееВыражение=СтрЗаменить(КонтрСоотношение["Выражение"+Часть],"[","СтрокаРасчет._");
	РабочееВыражение=СтрЗаменить(РабочееВыражение,"]","");
	
	РасчетВыполнен = Истина;
	
	Для Каждого СтрокаРасчет ИЗ РабочаяТаблица Цикл
		
		Попытка
			
			СтрокаРасчет["Значение"+Часть] = Вычислить(РабочееВыражение);
			
		Исключение
			
			ТекстОписания = ОписаниеОшибки();
			//обрежем лишнее
			ПозицияНачалаПодробнойИнформации = Найти(ТекстОписания,"}:");
			Если ПозицияНачалаПодробнойИнформации > 0 Тогда
				ТекстОписания = Сред(ТекстОписания,ПозицияНачалаПодробнойИнформации+2);
			КонецЕсли;
					
			ТекстОшибкиДляПротокола = Нстр("ru='Ошибка расчета контрольного соотношения. Не удалось выполнить проверку по причине: %1'");
			ТекстОшибкиДляПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляПротокола,ТекстОписания);
					
			КонтрСоотношение.ТекстОшибкиРасчета = ТекстОшибкиДляПротокола;
			КонтрСоотношение.РасчетВыполнен = Ложь;
			
			//Сообщение об ошибке вычисления выводится одно, позднее.
			//ноСообщить("Ошибка расчета контрольного соотношения " + КонтрСоотношение.КонтрольноеСоотношение,СтатусСообщения.Важное,,"Проверка отчета");			
			
			Прервать;
			
		КонецПопытки
		
	КонецЦикла;
		
КонецПроцедуры // РассчитатьЧастьКонтрольногоСоотношения()

// Заполняет таблицу значений операндов формул заполнения показателей
//
Процедура ПодготовитьТаблицуЗначенийОперандовКонтр(мСоответствиеПроблемныхКС)
	
	ПостроительЗапросаВнутр=Новый ПостроительЗапроса; // Построитель запроса к регистру "ЗначенияПоказателей";
	ПостроительЗапросаВнутр.ДобавлениеПредставлений=ТипДобавленияПредставлений.НеДобавлять;
	
	ПостроительЗапросаТек=Новый ПостроительЗапроса; // Построитель запроса к регистру "ЗначенияПоказателей";
	ПостроительЗапросаТек.ДобавлениеПредставлений=ТипДобавленияПредставлений.НеДобавлять;
	
	мЗначенияОперандовКонтр.Очистить();
		
	Для Каждого СтрЗапрос ИЗ мТабПоказателиЗапросыКонтр Цикл
		
		Если ТипЗнч(СтрЗапрос.СписокОперандов)=Тип("СписокЗначений") Тогда // Формируем построитель запроса для списка показателей
			
			Если СтрЗапрос.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета Тогда
				
				Если СтрЗапрос.ПростойРежим Тогда
					//Это значения итоговых показателей.
					//Получение таких показателей будет выполнено непосредственно перед расчетом КС
					Продолжить; 
				ИначеЕсли СтрЗапрос.ПоказательТекущегоОтчета Тогда
					//Это значения показателей текущего отчета с отбором или детализацией по аналиитке. 		
					НастроитьПостроительВнутрТекущийКонтр(ПостроительЗапросаТек,СтрЗапрос);
					ПолучитьДанныеВнутрТекущийКонтр(ПостроительЗапросаТек,СтрЗапрос);
					
				Иначе
					//Это значения показателей других отчетов.
					ПолучитьДанныеВнутрКонтр(СтрЗапрос,мСоответствиеПроблемныхКС);
					
				КонецЕсли;
				
			ИначеЕсли СтрЗапрос.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПараметрическаяНастройка Тогда	
				
				ПолучитьДанныеВнутрПараметрическийКонтр(ПостроительЗапросаВнутр,СтрЗапрос);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПодготовитьТаблицуЗначенийОперандовКонтр()

Процедура ПолучитьДанныеВнутрКонтр(СтрЗапрос,мСоответствиеПроблемныхКС)
	
	Запрос = ПодготовитьЗапросВнутрПоказатель(СтрЗапрос);
	Если Запрос = Неопределено Тогда
		//если есть ошибки в настройке операндов, то отметим проблемное КС и выведем потом их в протокол
		Для Каждого СтрокаОперандов Из СтрЗапрос.СписокОперандов Цикл
			ПроверяемоеКС = СтрокаОперандов.Значение.КонтрольноеСоотношение;
			
			мСоответствиеПроблемныхКС.Вставить(ПроверяемоеКС,Истина);
			
			СтрокаКС = мКонтрольныеСоотношения.Найти(ПроверяемоеКС,"КонтрольноеСоотношение");
			
			ТекстОшибки = Нстр("ru='Ошибка в настройке операнда ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрокаОперандов.Значение.Ссылка);
		
			СтрокаКС.ТекстОшибкиРасчета = ""+СтрокаКС.ТекстОшибкиРасчета + ?(ЗначениеЗаполнено(СтрокаКС.ТекстОшибкиРасчета),Символы.ПС,"")+ТекстОшибки;  
		КонецЦикла;
		
		Возврат;
	КонецЕсли;
	// Получим данные и запишем в таблицу операндов
	
	ТабРезультат=Запрос.Выполнить().Выгрузить();
	ТабРезультат.Индексы.Добавить("Показатель");
		
	Для Каждого Операнд ИЗ СтрЗапрос.СписокОперандов Цикл
		
		// Выделим из общей таблицы данные, относящиеся к операнду
		
		СтрСвертки = "КодОперанда,КонтрольноеСоотношение,ИтогПоПоказателю";
		СтруктураПолей			  = Новый Структура;
		ПравилаИспользованияПолей = Операнд.Значение.ПравилаИспользованияПолейЗапроса; //правила использования берем из операнда, т.к. в операнде может быть задан группировочный вид аналитики в СопоставляемаяАналитика 
		
		//Определим правила использования колонок и коды используемых аналитик
		Для Каждого СтрокаПравило ИЗ ПравилаИспользованияПолей Цикл
			
			ИмяКолонкиАналитикиДляТаблицы = СтрокаПравило.КодАналитики;
			Если ЗначениеЗаполнено(СтрокаПравило.СопоставляемаяАналитика) Тогда
				ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.СопоставляемаяАналитика];
				ИмяКолонкиАналитикиДляТаблицы = ТекДанныеВидаАналитики.АналитикаКод;
			КонецЕсли;
			
			СтруктураПолей.Вставить(ИмяКолонкиАналитикиДляТаблицы,СтрокаПравило.Поле);
			СтрСвертки=СтрСвертки+","+ИмяКолонкиАналитикиДляТаблицы;
			
			Если мЗначенияОперандовКонтр.Колонки.Найти(ИмяКолонкиАналитикиДляТаблицы) = Неопределено Тогда
				мЗначенияОперандовКонтр.Колонки.Добавить(ИмяКолонкиАналитикиДляТаблицы);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаПравило.РеквизитАналитики) Тогда
				
				ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.АналитикаОперанда];
				Если ТекДанныеВидаАналитики = Неопределено Тогда
					Продолжить; //не должно быть, если только вид аналитики не заполнен, а это ошибка
				КонецЕсли;
				
				ИмяИскомогоРеквизита = ТекДанныеВидаАналитики.ИмяРеквизитаДетализации;
				Если НЕ ЗначениеЗаполнено(ИмяИскомогоРеквизита) Тогда
					Продолжить;
				КонецЕсли;	
			
				СтруктураПолей.Вставить(ИмяКолонкиАналитикиДляТаблицы+"_Код",СтрокаПравило.Поле+"_Код");
				СтрСвертки=СтрСвертки+","+ИмяКолонкиАналитикиДляТаблицы+"_Код";
				
				Если мЗначенияОперандовКонтр.Колонки.Найти(ИмяКолонкиАналитикиДляТаблицы+"_Код") = Неопределено Тогда
					мЗначенияОперандовКонтр.Колонки.Добавить(ИмяКолонкиАналитикиДляТаблицы+"_Код");
				КонецЕсли;
														
				ТекИмяПоля = СтрокаПравило.Поле+"_Код";
				Если ТабРезультат.Колонки.Найти(ТекИмяПоля) = Неопределено Тогда
					ТабРезультат.Колонки.Добавить(ТекИмяПоля, БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(50));
					ЗначенияКолонки = Новый Массив;
					Для Каждого СтрТаб Из ТабРезультат Цикл
						Если СтрТаб.ИтогПоПоказателю = Истина Тогда
							Продолжить;
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрТаб[СтрокаПравило.Поле]) Тогда
							ЗначенияКолонки.Добавить(СтрТаб[СтрокаПравило.Поле]);
						КонецЕсли;
					КонецЦикла;
					Если ЗначенияКолонки.Количество() Тогда
				
						СоответствиеЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ЗначенияКолонки,ИмяИскомогоРеквизита);
						Для Каждого СтрТЧ Из ТабРезультат Цикл
							СтрТЧ[ТекИмяПоля] = СоответствиеЗначений[СтрТЧ[СтрокаПравило.Поле]];
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
	    	КонецЕсли;
		КонецЦикла;
		
		ПоказательОтбор=мСоответствиеОперандовИПоказателейОтбораКонтр.Получить(Операнд.Значение.Ссылка);
		СтруктураОтбора=Новый Структура("Показатель",ПоказательОтбор);
		
		СтрокиОперанда=ТабРезультат.НайтиСтроки(СтруктураОтбора);
		
		ЕстьИтог  = Ложь;
		ИтогСумма = 0;
		
		ПромТаблицаОперанда = мЗначенияОперандовКонтр.СкопироватьКолонки();
		
		Для Каждого Строка ИЗ СтрокиОперанда Цикл
			
			СтрДанные							= ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение					= Строка.Значение;
			СтрДанные.КодОперанда				= Операнд.Значение.Код;
			СтрДанные.КонтрольноеСоотношение 	= Операнд.Значение.КонтрольноеСоотношение;
			
			Для Каждого Поле ИЗ СтруктураПолей Цикл
				
				СтрДанные[Поле.Ключ]=Строка[Поле.Значение];
								
			КонецЦикла;
			
			ИтогСумма = ИтогСумма + СтрДанные.Значение;
			
			СтрДанные.ИтогПоПоказателю=Строка.ИтогПоПоказателю;
			
			Если НЕ ЕстьИтог Тогда
				ЕстьИтог = СтрДанные.ИтогПоПоказателю;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьИтог И СтрокиОперанда.Количество() > 0 Тогда
			
			СтрДанные             = ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение    = ИтогСумма;
			СтрДанные.КодОперанда = Операнд.Значение.Код;
			СтрДанные.КонтрольноеСоотношение = Операнд.Значение.КонтрольноеСоотношение;
			
			СтрДанные.ИтогПоПоказателю = Истина;
			
		КонецЕсли;
		
		ПромТаблицаОперанда.Свернуть(СтрСвертки,"Значение");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПромТаблицаОперанда,мЗначенияОперандовКонтр);
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьДанныеВнутр()

// Формирует построитель запроса к регистру "Значения показателей" для операнда с параметрически настроеннным отбором 
//
//
Процедура ПолучитьДанныеВнутрПараметрическийКонтр(ПостроительЗапросаВнутр,СтрЗапрос) Экспорт
	
	//////////// Настраиваем построитель запроса ////////////////////
	
	Запрос = СтрЗапрос.ТекстЗапроса;
	
	ПостроительЗапросаВнутр.Текст = Запрос.Текст;
	
	Для Каждого Параметр Из Запрос.Параметры Цикл
		ПостроительЗапросаВнутр.Параметры.Вставить(Параметр.Ключ,Параметр.Значение);
	КонецЦикла;
	
	ПостроительЗапросаВнутр.ЗаполнитьНастройки();
		
	
	КоличествоОперандов = СтрЗапрос.СписокОперандов.Количество();
	Для Сч = 0 По КоличествоОперандов - 1 Цикл
		
		СтрокаОперанда = СтрЗапрос.СписокОперандов[Сч].Значение;
		
		// Очистим отбор
		ОтборКоличество = ПостроительЗапросаВнутр.Отбор.Количество();
		Для Н = 1 По ОтборКоличество Цикл
			ПостроительЗапросаВнутр.Отбор.Удалить(ОтборКоличество - Н);
		КонецЦикла;
		
		НастройкиОперанда=СтрокаОперанда.НастройкиОперанда.Получить();
		
		Если ТипЗнч(НастройкиОперанда)=Тип("Структура") И НастройкиОперанда.Свойство("ОтборПостроителя") Тогда
			
			Для Каждого ЭлементОтбора ИЗ НастройкиОперанда.ОтборПостроителя Цикл
				
				НовыйОтбор=ПостроительЗапросаВнутр.Отбор.Добавить(ЭлементОтбора.ПутьКДанным,ЭлементОтбора.Имя,ЭлементОтбора.Представление);
				НовыйОтбор.ВидСравнения=ЭлементОтбора.ВидСравнения;
				НовыйОтбор.Значение=ЭлементОтбора.Значение;
				Если ЭлементОтбора.ВидСравнения = ВидСравнения.Интервал
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравнения.ИнтервалВключаяГраницы
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравнения.ИнтервалВключаяНачало
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравнения.ИнтервалВключаяОкончание Тогда
					НовыйОтбор.ЗначениеС=ЭлементОтбора.ЗначениеС;
					НовыйОтбор.ЗначениеПо=ЭлементОтбора.ЗначениеПо;
				КонецЕсли;
				НовыйОтбор.Использование=ЭлементОтбора.Использование;	
				
			КонецЦикла
			
		КонецЕсли;
		
		ТекПравилаВычисленияПараметров=СтрЗапрос.ПравилаВычисленияПараметров.Скопировать();
		ТекПравилаВычисленияПараметров.Колонки.Добавить("ИзКонтекста",Новый ОписаниеТипов("Булево"));
		ТекПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста");
		
		ОперандОбработан = Ложь;
		
		Для Каждого Параметр ИЗ ТекПравилаВычисленияПараметров Цикл
			
			Если Параметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется 
				ИЛИ ПроверитьНаличиеОтбора(ПостроительЗапросаВнутр,Параметр.ИмяПараметра) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если Параметр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит Тогда
				ИмяОтбора = Сред(Параметр.ИмяПараметра,10);
			Иначе
				ИмяОтбора = Параметр.ИмяПараметра;
			КонецЕсли;
			
			ОтборПараметр=ПостроительЗапросаВнутр.Отбор.Добавить(ИмяОтбора);
			
			ОтборПараметр.Использование=Истина;
			
			СвойстваОтбора=ПолучитьСвойстваПараметра(Параметр);
			
			ЗначениеОтбора = СвойстваОтбора.Значение;
			Если (ТипЗнч(ЗначениеОтбора) = Тип("Строка") 
					ИЛИ (ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") 
				 		И ЗначениеОтбора.Количество() > 0 
						И ТипЗнч(ЗначениеОтбора[0].Значение) = Тип("Строка")))
				 И мСоответствиеСтроковыхБК[Параметр.ВидАналитикиОтбор] = Неопределено Тогда
				 
				 // Не найдены ссылки настроек операнда
				 СтрДанные=мЗначенияОперандовКонтр.Добавить();
				 СтрДанные.Значение      			= 0;
				 СтрДанные.КонтрольноеСоотношение 	= СтрокаОперанда.КонтрольноеСоотношение;
				 СтрДанные.КодОперанда   			= СтрокаОперанда.Код;
				 
				 СтрокаОперанда.ФлагОшибки = Истина;
				 
				 ОперандОбработан = Истина;
				 
			КонецЕсли;
			
			Если Не ОперандОбработан Тогда
				Если СвойстваОтбора.Значение = Неопределено 
					 И Параметр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит
					 И СтрокаОперанда.ВидОтчетаОтбор <> ВидОтчета Тогда
					 
					 СтрДанные=мЗначенияОперандовКонтр.Добавить();
					 СтрДанные.Значение      			= 0;
					 СтрДанные.КонтрольноеСоотношение 	= СтрокаОперанда.КонтрольноеСоотношение;
					 СтрДанные.КодОперанда   			= СтрокаОперанда.Код;
					 
					 ОперандОбработан = Истина;
				Иначе
					ОтборПараметр.ВидСравнения=СвойстваОтбора.ВидСравнения;
					ОтборПараметр.Значение = СвойстваОтбора.Значение;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОперандОбработан Тогда
			Продолжить;
		КонецЕсли;
		
		// Подготовка построителя к выборке.
		
		ПостроительЗапросаВнутр.ВыбранныеПоля.Очистить();
		
		ПостроительЗапросаВнутр.ВыбранныеПоля.Добавить("Значение"		 ,"Значение");
		ПостроительЗапросаВнутр.ВыбранныеПоля.Добавить("ИтогПоПоказателю","ИтогПоПоказателю");
		ПостроительЗапросаВнутр.ВыбранныеПоля.Добавить("ПромежуточныйИтог","ПромежуточныйИтог");
		
		ПравилаИспользованияПолей=СтрокаОперанда.ПравилаИспользованияПолейЗапроса;
		
		//Определим правила использования колонок и коды используемых аналитик
		
		СтруктураПолей	= Новый Структура;
		СтрСвертки 		= "КодОперанда,КонтрольноеСоотношение,ИтогПоПоказателю";
		
		Для Каждого СтрокаПравило ИЗ ПравилаИспользованияПолей Цикл
			
			СтруктураПолей.Вставить(СтрокаПравило.КодАналитики,СтрокаПравило.Поле);
			СтрСвертки=СтрСвертки+","+СтрокаПравило.КодАналитики;
			
			Если мЗначенияОперандовКонтр.Колонки.Найти(СтрокаПравило.КодАналитики) = Неопределено Тогда
				мЗначенияОперандовКонтр.Колонки.Добавить(СтрокаПравило.КодАналитики);
			КонецЕсли;
			
			ПостроительЗапросаВнутр.ВыбранныеПоля.Добавить(СтрокаПравило.Поле,СтрокаПравило.Поле);
			
		КонецЦикла;
		////////////////////////////////////////////////////
		ЧислоОтборовПоАналитике = 0;
		Для Каждого ЭлементОтбора Из ПостроительЗапросаВнутр.Отбор Цикл
			Если Лев(ЭлементОтбора.Имя,9) = "Аналитика" и ЭлементОтбора.Использование Тогда
				ЧислоОтборовПоАналитике = ЧислоОтборовПоАналитике + 1;
			КонецЕсли;
		КонецЦикла;
		
		ВремЗапрос = ПостроительЗапросаВнутр.ПолучитьЗапрос();
		Если ЧислоОтборовПоАналитике > 0 Тогда
			ТД = Новый ТекстовыйДокумент;
			ТД.УстановитьТекст(ВремЗапрос.Текст);
			Для Сч2 = 1 По ЧислоОтборовПоАналитике Цикл
				ТекСтрока = ТД.ПолучитьСтроку(ТД.КоличествоСтрок());
				Если СокрЛП(Лев(ТекСтрока,13)) = "НЕОПРЕДЕЛЕНО" Тогда
					ТД.УдалитьСтроку(ТД.КоличествоСтрок());
				КонецЕсли;
			КонецЦикла;
			ТекСтрока = ТД.ПолучитьСтроку(ТД.КоличествоСтрок());
			Если СокрЛП(Лев(ТекСтрока,3)) = "ГДЕ" Тогда
				ТД.УдалитьСтроку(ТД.КоличествоСтрок());
			КонецЕсли;
			
			ВремЗапрос.Текст = ТД.ПолучитьТекст();
		КонецЕсли;
		
		РезультатЗапроса = ВремЗапрос.Выполнить();
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.*
		|ПОМЕСТИТЬ ТаблицаДанных
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных";
		
		Запрос.УстановитьПараметр("ТаблицаДанных",РезультатЗапроса);
		Запрос.Выполнить();
				
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СУММА(ТаблицаДанных.Значение) КАК Значение,
		|	ТаблицаДанных.ИтогПоПоказателю";
		
		ТекстАналитик = "";
		
		Для Каждого ПолеАналитики Из СтруктураПолей Цикл
			ТекстАналитик = ТекстАналитик + ",
			|	ТаблицаДанных."+ПолеАналитики.Значение;
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса 
		+ ТекстАналитик + "
		|ИЗ
		|	ТаблицаДанных";
		
		Если Не СтрЗапрос.ВключатьПромежуточныеИтоги Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	ТаблицаДанных.ПромежуточныйИтог = ЛОЖЬ";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|СГРУППИРОВАТЬ ПО
		|	ИтогПоПоказателю"
		+ ТекстАналитик;
		////////////////////////////////////////////////////
		
		// Таблица значений операнда
		Запрос.Текст = ТекстЗапроса;
		ТабРезультат = Запрос.Выполнить().Выгрузить();
		
		Если ТабРезультат.Количество() = 1 И ТабРезультат[0].Значение = Null И СтрокаОперанда.ВидОтчетаОтбор = ВидОтчета Тогда
			
			ПостроительЗапросаВнутр.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1"+Сред(ПостроительЗапросаВнутр.Текст,8);
			
			Для Каждого ЭлементОтбора Из ПостроительЗапросаВнутр.Отбор Цикл
				Если Лев(ЭлементОтбора.ПутьКДанным,9) = "Аналитика" Тогда
					ЭлементОтбора.Использование = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			ПостроительЗапросаВнутр.Выполнить();
			ВремТаб = ПостроительЗапросаВнутр.Результат.Выгрузить();
			
			ПостроительЗапросаВнутр.Текст = Запрос.Текст;
			
			Если ВремТаб.Количество() = 1 И ВремТаб[0].Значение = Null Тогда
				СтрокаОперанда.ТребуетАнализа = Истина;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;		
		
		Для Каждого СтрокаПравило ИЗ ПравилаИспользованияПолей Цикл
			Если ЗначениеЗаполнено(СтрокаПравило.РеквизитАналитики) Тогда
				ИмяКолонкиАналитикиДляТаблицы = СтрокаПравило.КодАналитики;
				Если ЗначениеЗаполнено(СтрокаПравило.СопоставляемаяАналитика) Тогда
					ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.СопоставляемаяАналитика];
					ИмяКолонкиАналитикиДляТаблицы = ТекДанныеВидаАналитики.АналитикаКод;
				КонецЕсли;
				
				ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.АналитикаОперанда];
				Если ТекДанныеВидаАналитики = Неопределено Тогда
					Продолжить; //не должно быть, если только вид аналитики не заполнен, а это ошибка
				КонецЕсли;
				
				ИмяИскомогоРеквизита = ТекДанныеВидаАналитики.ИмяРеквизитаДетализации;
				Если НЕ ЗначениеЗаполнено(ИмяИскомогоРеквизита) Тогда
					Продолжить;
				КонецЕсли;
			
				СтруктураПолей.Вставить(ИмяКолонкиАналитикиДляТаблицы+"_Код",СтрокаПравило.Поле+"_Код");
				СтрСвертки=СтрСвертки+","+ИмяКолонкиАналитикиДляТаблицы+"_Код";
				
				Если мЗначенияОперандовКонтр.Колонки.Найти(ИмяКолонкиАналитикиДляТаблицы+"_Код") = Неопределено Тогда
					мЗначенияОперандовКонтр.Колонки.Добавить(ИмяКолонкиАналитикиДляТаблицы+"_Код");
				КонецЕсли;
										
				ТекИмяПоля = СтрокаПравило.Поле+"_Код";
				Если ТабРезультат.Колонки.Найти(ТекИмяПоля) = Неопределено Тогда
					ТабРезультат.Колонки.Добавить(ТекИмяПоля, БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(50));
					
					ЗначенияКолонки = Новый Массив;
					Для Каждого СтрТаб Из ТабРезультат Цикл
						Если СтрТаб.ИтогПоПоказателю = Истина Тогда
							Продолжить;
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрТаб[СтрокаПравило.Поле]) Тогда
							ЗначенияКолонки.Добавить(СтрТаб[СтрокаПравило.Поле]);
						КонецЕсли;
					КонецЦикла;
					Если ЗначенияКолонки.Количество() Тогда
				
						СоответствиеЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ЗначенияКолонки,ИмяИскомогоРеквизита);
						Для Каждого СтрТЧ Из ТабРезультат Цикл
							СтрТЧ[ТекИмяПоля] = СоответствиеЗначений[СтрТЧ[СтрокаПравило.Поле]];
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		КодОперанда   = СтрокаОперанда.Код;
		ОперандСсылка = СтрокаОперанда.Ссылка;	
		КонтрольноеСоотношение = СтрокаОперанда.КонтрольноеСоотношение;
		
		ЕстьИтог  = Ложь;
		ИтогСумма = 0;
		
		ПромТаблицаОперанда = мЗначенияОперандовКонтр.СкопироватьКолонки();
		
		Для Каждого Строка ИЗ ТабРезультат Цикл
			
			СтрДанные							= ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение					= Строка.Значение;
			СтрДанные.КодОперанда				= КодОперанда;
			СтрДанные.КонтрольноеСоотношение 	= КонтрольноеСоотношение;
			
			Для Каждого Поле ИЗ СтруктураПолей Цикл
				
				СтрДанные[Поле.Ключ]=Строка[Поле.Значение];
								
			КонецЦикла;
			
			ИтогСумма = ИтогСумма + СтрДанные.Значение;
			
			СтрДанные.ИтогПоПоказателю=Строка.ИтогПоПоказателю;
			
			Если НЕ ЕстьИтог Тогда
				ЕстьИтог = СтрДанные.ИтогПоПоказателю;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьИтог И ТабРезультат.Количество() > 0 Тогда
			
			СтрДанные             			 = ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение    			 = ИтогСумма;
			СтрДанные.КодОперанда 			 = КодОперанда;
			СтрДанные.КонтрольноеСоотношение = КонтрольноеСоотношение;
			СтрДанные.ИтогПоПоказателю 		 = Истина;
			
		КонецЕсли;
		
		ПромТаблицаОперанда.Свернуть(СтрСвертки,"Значение");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПромТаблицаОперанда,мЗначенияОперандовКонтр);
		
	КонецЦикла;	
	
КонецПроцедуры // ПолучитьДанныеВнутрПараметрическийКонтр()

Процедура НастроитьПостроительВнутрТекущийКонтр(ПостроительЗапросаВнутр,СтрЗапрос)
	
	Если ПостроительЗапросаВнутр.ИсточникДанных = Неопределено Тогда
		//Инициализация источника данных для построителя.
		//Т.к. для текущего отчета источник данных всегда один, инициализируем один раз.
		ТекПоказателиРаскрытия = ПолучитьКопиюРаскрытия();
		ТекПоказателиРаскрытия.Колонки.Добавить("ИтогПоПоказателю", Новый ОписаниеТипов("Булево"));
		
		Для Каждого СтрПоказатель ИЗ мПоказатели Цикл
			
			НоваяСтрока			   		 = ТекПоказателиРаскрытия.Добавить();
			НоваяСтрока.Показатель 		 = СтрПоказатель.Ссылка;
			НоваяСтрока.Значение   		 = СтрПоказатель.Значение;
			НоваяСтрока.ИтогПоПоказателю = Истина;
			
		КонецЦикла;
				
		ПостроительЗапросаВнутр.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТекПоказателиРаскрытия);
	КонецЕсли;
	
	// Очистим отбор
	ОтборКоличество = ПостроительЗапросаВнутр.Отбор.Количество();
	
	Для Н = 1 По ОтборКоличество Цикл
		ПостроительЗапросаВнутр.Отбор.Удалить(ОтборКоличество - Н);
	КонецЦикла;
	
	ПоказателиОтбор=Новый СписокЗначений;
	
	СоответствиеПоказателей = Новый Соответствие;
	Для Каждого Операнд ИЗ СтрЗапрос.СписокОперандов Цикл
		Если СоответствиеПоказателей[Операнд.Значение.ПоказательОтбор] = Неопределено Тогда
			СоответствиеПоказателей.Вставить(Операнд.Значение.ПоказательОтбор,Истина);
			ПоказателиОтбор.Добавить(Операнд.Значение.ПоказательОтбор);		
		КонецЕсли;		
	КонецЦикла;	
	
	// Добавляем отборы
	ОтборПоказатель=ПостроительЗапросаВнутр.Отбор.Добавить("Показатель");
	ОтборПоказатель.ВидСравнения=ВидСравнения.ВСписке;
	ОтборПоказатель.Значение=ПоказателиОтбор;
	ОтборПоказатель.Использование=Истина;
	
	Если Не СтрЗапрос.ВключатьПромежуточныеИтоги Тогда
		Отбор = ПостроительЗапросаВнутр.Отбор.Добавить("ПромежуточныйИтог");
		Отбор.ВидСравнения  = ВидСравнения.Равно;
		Отбор.Значение      = Ложь;
		Отбор.Использование = Истина;
	КонецЕсли;
	
	ТекПравилаВычисленияПараметров=СтрЗапрос.ПравилаВычисленияПараметров.Скопировать();
	ТекПравилаВычисленияПараметров.Колонки.Добавить("ИзКонтекста",Новый ОписаниеТипов("Булево"));
	ТекПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста");
	
	НуженОтборПоАналитике = Ложь;
	Для Каждого Параметр ИЗ ТекПравилаВычисленияПараметров Цикл
		
		Если СтрНачинаетсяС(Параметр.ИмяПараметра,"Аналитика") = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если Параметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			Продолжить;
		КонецЕсли;
				
		НуженОтборПоАналитике = Истина;
		
		ОтборПараметр=ПостроительЗапросаВнутр.Отбор.Добавить(Параметр.ИмяПараметра);
		
		ОтборПараметр.Использование=Истина;
		
		СвойстваОтбора = ПолучитьСвойстваПараметра(Параметр);
		ЗначениеОтбора = СвойстваОтбора.Значение;
		
		Если (ТипЗнч(ЗначениеОтбора) = Тип("Строка") 
			ИЛИ (ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") 
			 	И ЗначениеОтбора.Количество() > 0 
				И ТипЗнч(ЗначениеОтбора[0].Значение) = Тип("Строка")))
			И мСоответствиеСтроковыхБК[Параметр.ВидАналитикиОтбор] = Неопределено Тогда
			 
			 Для Каждого Операнд Из СтрЗапрос.СписокОперандов Цикл
				
				Операнд.Значение.ФлагОшибки = Истина;
				СтрокаКС = мКонтрольныеСоотношения.Найти(Операнд.Значение.КонтрольноеСоотношение,"КонтрольноеСоотношение");
				СтрокаКС.Использование = 2; // Не использовать при проверке, показывать при просмотре всех КС
				
				СтрДанные=мЗначенияОперандовКонтр.Добавить();
				СтрДанные.Значение      			= 0;
				СтрДанные.КонтрольноеСоотношение 	= Операнд.Значение.КонтрольноеСоотношение;
				СтрДанные.КодОперанда   			= Операнд.Значение.Код;
				
			КонецЦикла;
			
			ОтборПараметр.ВидСравнения = ВидСравнения.ВСписке;
			ОтборПараметр.Значение	   = Новый СписокЗначений;
			 
		Иначе
			
			ОтборПараметр.ВидСравнения=СвойстваОтбора.ВидСравнения;
			Попытка
				ОтборПараметр.Значение=СвойстваОтбора.Значение;
			Исключение
				ТекстСообщения = "Ошибка установки значения отбора в одном из операндов. Проверьте настройку отбора указанных операндов:";
				Для Каждого Операнд Из СтрЗапрос.СписокОперандов Цикл
					ТекстСообщения = ТекстСообщения + "
					|Контрольное соотношение, код '"+Операнд.Значение.КонтрольноеСоотношение+"', операнд "+Операнд.Значение.Код+"'";
				КонецЦикла;
				
				Сообщить(ТекстСообщения,СтатусСообщения.ОченьВажное);
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НуженОтборПоАналитике Тогда
		//Если есть отбор по аналитике, значит нужны детальные значения, где ИтогПоПоказателю = Ложь
		ОтборИтогПоПоказателю=ПостроительЗапросаВнутр.Отбор.Добавить("ИтогПоПоказателю");
	
		ОтборИтогПоПоказателю.Использование=Истина;
		ОтборИтогПоПоказателю.ВидСравнения = ВидСравнения.Равно;
		ОтборИтогПоПоказателю.Значение	   = Ложь;
		
	КонецЕсли;
		
КонецПроцедуры // НастроитьПостроительВнутрТекущийКонтр()

Процедура ПолучитьДанныеВнутрТекущийКонтр(ПостроительЗапросаВнутр,СтрЗапрос)
	
	/////////// Получаем и обрабатываем результаты ////////////////////// 
	
	ПостроительЗапросаВнутр.Выполнить();
	ТабРезультат = ПостроительЗапросаВнутр.Результат.Выгрузить();
	
	ТабРезультат.Индексы.Добавить("Показатель");
	
	ЕстьИтог  = Ложь;
	ИтогСумма = 0;
		
	Для Каждого Операнд ИЗ СтрЗапрос.СписокОперандов Цикл
		
		СтрокаКС = мКонтрольныеСоотношения.Найти(Операнд.Значение.КонтрольноеСоотношение,"КонтрольноеСоотношение");
		Если СтрокаКС.Использование = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		// Выделим из общей таблицы данные, относящиеся к операнду
		
		СтрСвертки 		= "КодОперанда,КонтрольноеСоотношение,ИтогПоПоказателю";
		СтруктураПолей	= Новый Структура;
		ПравилаИспользованияПолей = Операнд.Значение.ПравилаИспользованияПолейЗапроса;
		
		//Определим правила использования колонок и коды используемых аналитик
		Для Каждого СтрокаПравило ИЗ ПравилаИспользованияПолей Цикл
			
			ИмяКолонкиАналитикиДляТаблицы = СтрокаПравило.КодАналитики;
			Если ЗначениеЗаполнено(СтрокаПравило.СопоставляемаяАналитика) Тогда
				ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.СопоставляемаяАналитика];
				ИмяКолонкиАналитикиДляТаблицы = ТекДанныеВидаАналитики.АналитикаКод;
			КонецЕсли;
			
			СтруктураПолей.Вставить(ИмяКолонкиАналитикиДляТаблицы,СтрокаПравило.Поле);
			СтрСвертки=СтрСвертки+","+ИмяКолонкиАналитикиДляТаблицы;
			
			Если мЗначенияОперандовКонтр.Колонки.Найти(ИмяКолонкиАналитикиДляТаблицы) = Неопределено Тогда
				мЗначенияОперандовКонтр.Колонки.Добавить(ИмяКолонкиАналитикиДляТаблицы);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаПравило.РеквизитАналитики) Тогда
				ТекДанныеВидаАналитики = ДанныеВидовАналитики[СтрокаПравило.АналитикаОперанда];
				Если ТекДанныеВидаАналитики = Неопределено Тогда
					Продолжить; //не должно быть, если только вид аналитики не заполнен, а это ошибка
				КонецЕсли;
				
				ИмяИскомогоРеквизита = ТекДанныеВидаАналитики.ИмяРеквизитаДетализации;
				Если НЕ ЗначениеЗаполнено(ИмяИскомогоРеквизита) Тогда
					Продолжить;
				КонецЕсли;	
				
				СтруктураПолей.Вставить(ИмяКолонкиАналитикиДляТаблицы+"_Код",СтрокаПравило.Поле+"_Код");
				СтрСвертки=СтрСвертки+","+ИмяКолонкиАналитикиДляТаблицы+"_Код";
				
				Если мЗначенияОперандовКонтр.Колонки.Найти(ИмяКолонкиАналитикиДляТаблицы+"_Код") = Неопределено Тогда
					мЗначенияОперандовКонтр.Колонки.Добавить(ИмяКолонкиАналитикиДляТаблицы+"_Код");
				КонецЕсли;
										
				ТекИмяПоля = СтрокаПравило.Поле+"_Код";
				Если ТабРезультат.Колонки.Найти(ТекИмяПоля) = Неопределено Тогда
					ТабРезультат.Колонки.Добавить(ТекИмяПоля, БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(50));
					
					ЗначенияКолонки = Новый Массив;
					Для Каждого СтрТаб Из ТабРезультат Цикл
						Если СтрТаб.ИтогПоПоказателю = Истина Тогда
							Продолжить;
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрТаб[СтрокаПравило.Поле]) Тогда
							ЗначенияКолонки.Добавить(СтрТаб[СтрокаПравило.Поле]);
						КонецЕсли;
					КонецЦикла;
					
					Если ЗначенияКолонки.Количество() Тогда
						
						СоответствиеЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ЗначенияКолонки,ИмяИскомогоРеквизита);
						Для Каждого СтрТЧ Из ТабРезультат Цикл
							СтрТЧ[ТекИмяПоля] = СоответствиеЗначений[СтрТЧ[СтрокаПравило.Поле]];
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
	    	КонецЕсли;
		КонецЦикла;
		
		ПоказательОтбор=мСоответствиеОперандовИПоказателейОтбораКонтр.Получить(Операнд.Значение.Ссылка);
		СтруктураОтбора=Новый Структура("Показатель",ПоказательОтбор);
		
		СтрокиОперанда=ТабРезультат.НайтиСтроки(СтруктураОтбора);
		
		ЕстьИтог  = Ложь;
		ИтогСумма = 0;
		
		ПромТаблицаОперанда = мЗначенияОперандовКонтр.СкопироватьКолонки();
		
		Для Каждого Строка ИЗ СтрокиОперанда Цикл
			
			СтрДанные							= ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение					= Строка.Значение;
			СтрДанные.КодОперанда				= Операнд.Значение.Код;
			СтрДанные.КонтрольноеСоотношение 	= Операнд.Значение.КонтрольноеСоотношение;
			
			Для Каждого Поле ИЗ СтруктураПолей Цикл
				
				СтрДанные[Поле.Ключ]=Строка[Поле.Значение];
								
			КонецЦикла;
			
			ИтогСумма = ИтогСумма + СтрДанные.Значение;
			
			СтрДанные.ИтогПоПоказателю=Строка.ИтогПоПоказателю;
			
			Если НЕ ЕстьИтог Тогда
				ЕстьИтог = СтрДанные.ИтогПоПоказателю;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьИтог И СтрокиОперанда.Количество() > 0 Тогда
			
			СтрДанные             = ПромТаблицаОперанда.Добавить();
			СтрДанные.Значение    = ИтогСумма;
			СтрДанные.КодОперанда = Операнд.Значение.Код;
			СтрДанные.КонтрольноеСоотношение = Операнд.Значение.КонтрольноеСоотношение;
			
			СтрДанные.ИтогПоПоказателю = Истина;
			
		КонецЕсли;
		
		ПромТаблицаОперанда.Свернуть(СтрСвертки,"Значение");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПромТаблицаОперанда,мЗначенияОперандовКонтр);
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьДанныеВнутрТекущий()

Функция ПроверитьНаличиеОтбора(Построитель,ПутьКДанным)
	
	ЕстьОтбор=Ложь;
	
	Для Каждого Элемент ИЗ Построитель.Отбор Цикл
		
		Если Элемент.ПутьКДанным=ПутьКДанным Тогда
			
			ЕстьОтбор=Истина;
			Элемент.Использование=Истина;
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьОтбор;
	
КонецФункции // ПроверитьНаличиеОтбора() 

Функция ПодготовитьЗапросВнутрПоказатель(СтрЗапрос)
	
	МассивОтборАналитики=Новый Массив;
	МассивОтборРеквизиты=Новый Массив;
	МассивОтборПараметры=Новый Массив;
	
	ТабПравилаВычисленияПараметров=СтрЗапрос.ПравилаВычисленияПараметров.Скопировать();
	ТабПравилаВычисленияПараметров.Колонки.Добавить("ИзКонтекста",Новый ОписаниеТипов("Булево"));
	ТабПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста");
	ТабПравилаВычисленияПараметров.Колонки.Добавить("ВидСравнения");
	
	Запрос=Новый Запрос;
	
	Для Каждого Параметр ИЗ ТабПравилаВычисленияПараметров Цикл
		
		Если Параметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СвойстваОтбора = ПолучитьСвойстваПараметра(Параметр);
		ЗначениеОтбора = СвойстваОтбора.Значение;
		
		// Если ссылки для настроек параметров не найдены, то запрос не может быть выполнен.
		Если (ТипЗнч(ЗначениеОтбора) = Тип("Строка") 
			ИЛИ (ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") 
			 	И ЗначениеОтбора.Количество() > 0 
				И ТипЗнч(ЗначениеОтбора[0].Значение) = Тип("Строка")))
			И мСоответствиеСтроковыхБК[Параметр.ВидАналитикиОтбор] = Неопределено Тогда
			
			Для Каждого ОперандСоотношения Из СтрЗапрос.СписокОперандов Цикл
				
				СтрОперанд = ОперандСоотношения.Значение;
				СтрОперанд.ФлагОшибки = Истина;
				СтрокаКС = мКонтрольныеСоотношения.Найти(СтрОперанд.КонтрольноеСоотношение,"КонтрольноеСоотношение");
				СтрокаКС.Использование = 2; // Не использовать при проверке, показывать при просмотре всех КС
				
				СтрДанные=мЗначенияОперандовКонтр.Добавить();
				СтрДанные.Значение      			= 0;
				СтрДанные.КонтрольноеСоотношение 	= СтрОперанд.КонтрольноеСоотношение;
				СтрДанные.КодОперанда   			= СтрОперанд.Код;

			КонецЦикла;
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		Параметр.ВидСравнения=СвойстваОтбора.ВидСравнения;
		Запрос.УстановитьПараметр(Параметр.ИмяПараметра,Параметр.ЗначениеИзКонтекста);
		
	КонецЦикла;
	
	ЗапросТребуетАнализа = Ложь;
	Если ТипЗнч(СтрЗапрос) = Тип("СтрокаТаблицыЗначений") Тогда
		ЗапросДляКонтрольныхСоотношений = (СтрЗапрос.Владелец() = мТабПоказателиЗапросыКонтр);
	Иначе
		ЗапросДляКонтрольныхСоотношений = Ложь;
	КонецЕсли;
	
	// Добавим принудительный фильтр по ИФО
	СтрокаОтбора = ДобавитьФильтрПоИФО(ТабПравилаВычисленияПараметров);
	Если Не СтрокаОтбора = Неопределено Тогда
		СтрокаОтбора.ЗначениеИзКонтекста = ЭтотОбъект.ИФО;
		Запрос.УстановитьПараметр(СтрокаОтбора.ИмяПараметра,СтрокаОтбора.ЗначениеИзКонтекста); // установка параметра в запрос
	КонецЕсли;
	
	Для Каждого Правило ИЗ ТабПравилаВычисленияПараметров Цикл
		
		Если Правило.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(Правило.ИмяПараметра,9)="Аналитика" Тогда
			
			МассивОтборАналитики.Добавить(Правило);
			
		Иначе
			
			ЗначениеИзКонтекста = Ложь;
			
			Если СтрНачинаетсяС(Правило.ИмяПараметра,"Реквизит_") Тогда
				
				МассивОтборРеквизиты.Добавить(Правило);
				ЗначениеИзКонтекста = Истина;
				
			ИначеЕсли Правило.ИмяПараметра="Организация" ИЛИ Правило.ИмяПараметра="ПериодОтчета" ИЛИ Правило.ИмяПараметра = "ИФО" Тогда
				
				МассивОтборПараметры.Добавить(Правило);
				ЗначениеИзКонтекста = Истина;
				
			КонецЕсли;
			
			// Проверим соответствие отборов текущему контексту отчета.
			Если ЗапросДляКонтрольныхСоотношений
				И СтрЗапрос.ВидОтчетаОтбор = ВидОтчета 
				И ЗначениеИзКонтекста				 
				И МассивПроверяемыхСпособов.Найти(Правило.СпособВычисленияПараметра)<>Неопределено Тогда
				 
				Значение = Неопределено;
				
				Если СтрНачинаетсяС(Правило.ИмяПараметра,"Реквизит_") 
					И ДополнительныеРеквизиты.Свойство(Сред(Правило.ИмяПараметра,10),Значение) Тогда
					Значение = ДополнительныеРеквизиты[Сред(Правило.ИмяПараметра,10)];
				Иначе
					Значение = ЭтотОбъект[Правило.ИмяПараметра];
				КонецЕсли;
				
				// В операнде задан отбор по тек. виду отчета, и данный отчет не попадает в этот отбор.
				Если НЕ ЗначениеЗаполнено(Правило.РеквизитАналитики) Тогда
					Если Правило.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение 
						И Запрос.Параметры[Правило.ИмяПараметра] <> Значение Тогда
						ЗапросТребуетАнализа = Истина;
					ИначеЕсли Правило.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение
						И Запрос.Параметры[Правило.ИмяПараметра] = Значение Тогда
						ЗапросТребуетАнализа = Истина;
					ИначеЕсли Правило.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений Тогда
						Если ТипЗнч(Запрос.Параметры[Правило.ИмяПараметра]) = Тип("СписокЗначений") Тогда
							ЗапросТребуетАнализа = Запрос.Параметры[Правило.ИмяПараметра].НайтиПоЗначению(Значение) = Неопределено;
						КонецЕсли;
					ИначеЕсли Правило.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений Тогда
						Если ТипЗнч(Запрос.Параметры[Правило.ИмяПараметра]) = Тип("СписокЗначений") Тогда
							ЗапросТребуетАнализа = Запрос.Параметры[Правило.ИмяПараметра].НайтиПоЗначению(Значение) <> Неопределено;
						КонецЕсли;
					КонецЕсли;
				Иначе
					//если это отбор по реквизиту аналитики, 
					//то способы фиксированное значение/не фиксированное значение заменяются в запросе на В Списке и Не в списке
					//Подобно и Не подобно заменяются в запросе на В Списке и Не в списке
					Если Правило.ВидСравнения = ВидСравнения.ВСписке Тогда
						Если ТипЗнч(Запрос.Параметры[Правило.ИмяПараметра]) = Тип("СписокЗначений") Тогда
							ЗапросТребуетАнализа = Запрос.Параметры[Правило.ИмяПараметра].НайтиПоЗначению(Значение) = Неопределено;
						КонецЕсли;
					ИначеЕсли Правило.ВидСравнения = ВидСравнения.НеВСписке Тогда
						Если ТипЗнч(Запрос.Параметры[Правило.ИмяПараметра]) = Тип("СписокЗначений") Тогда
							ЗапросТребуетАнализа = Запрос.Параметры[Правило.ИмяПараметра].НайтиПоЗначению(Значение) <> Неопределено;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
				
			КонецЕсли;
						
		КонецЕсли;
		
	КонецЦикла;
	
	// Установка признака расширенного анализа.
	Если ЗапросТребуетАнализа Тогда
		Для Каждого СтрОперанд Из СтрЗапрос.СписокОперандов Цикл
			СтрОперанд.Значение.ТребуетАнализа = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрРеквизит ИЗ МассивОтборРеквизиты Цикл
		Запрос.УстановитьПараметр(СтрРеквизит.ИмяПараметра+"_ВидАналитики",СтрРеквизит.ВидАналитикиОтбор);
	КонецЦикла;
	
	// Отберем экземпляры отчетов, по которым будем получать данные
	
	//ПараметрПометкаУдаления = Новый Структура;
	//ПараметрПометкаУдаления.Вставить("ИмяПараметра", "ПометкаУдаления");
	//ПараметрПометкаУдаления.Вставить("ВидСравнения", ВидСравнения.Равно);
	//МассивОтборПараметры.Добавить(ПараметрПометкаУдаления);
	//Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
	
	Запрос.Текст=БюджетнаяОтчетность.СформироватьТекстОтбораЭкземпляры(МассивОтборРеквизиты,МассивОтборПараметры);
	Запрос.УстановитьПараметр("ВидОтчета",СтрЗапрос.ВидОтчетаОтбор);
	
	МассивОтчетов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭкземплярОтчета");
	
	ТабФормированияЗапроса = ТабПравилаВычисленияПараметров.СкопироватьКолонки("ИмяПараметра,ВидСравнения,ЗначениеИзКонтекста");
	ТабФормированияЗапроса.Колонки.Добавить("ЭтоКонстанта"	  ,Новый ОписаниеТипов("Булево"));
	ТабФормированияЗапроса.Колонки.Добавить("ВключитьВВыборку",Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрРеквизит Из МассивОтборАналитики Цикл
		СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗапроса,СтрРеквизит);
	КонецЦикла;
	
	ПравилаИспользованияПолейЗапроса = СтрЗапрос.ПравилаИспользованияПолей;
		
	Для Каждого Раскрытие Из ПравилаИспользованияПолейЗапроса Цикл
		
		Если Лев(Раскрытие.Поле,9) = "Реквизит_" Тогда
			СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
			СтрокаЗапроса.ИмяПараметра 		= Раскрытие.Поле;
			СтрокаЗапроса.ЭтоКонстанта 		= Истина;
			СтрокаЗапроса.ВключитьВВыборку 	= Истина;
		Иначе
			
			СтрокаЗапроса = ТабФормированияЗапроса.Найти(Раскрытие.Поле,"ИмяПараметра");
			
			Если СтрокаЗапроса = Неопределено Тогда
				СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
				СтрокаЗапроса.ИмяПараметра 		= Раскрытие.Поле;
			КонецЕсли;
			
			СтрокаЗапроса.ВключитьВВыборку 	= Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТабФормированияЗапроса.Сортировать("ИмяПараметра");
	
	ПоляВыборки = ТабФормированияЗапроса.НайтиСтроки(Новый Структура("ВключитьВВыборку",Истина));
	
	// Сформируем текст запроса к регистру "ЗначенияПоказателейОтчетов"
	
	ТекстЗапросаСинтетика = 
	"ВЫБРАТЬ
	|	ЗначенияПоказателейОтчетов.Показатель,";
	
	Если СтрЗапрос.ЕстьРаскрытиеПоАналитике Тогда
		Для Каждого ПолеЗапроса ИЗ ПоляВыборки Цикл
			
			ТекстЗапросаСинтетика=ТекстЗапросаСинтетика+"
			|НЕОПРЕДЕЛЕНО КАК "+ПолеЗапроса.ИмяПараметра+",";
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗапросаСинтетика=ТекстЗапросаСинтетика+"
	|	ИСТИНА КАК ИтогПоПоказателю,
	|	ЗначенияПоказателейОтчетов.ЗначениеЧисло
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.Показатель В(&ПоказательОтбор)
	|	И ЗначенияПоказателейОтчетов.ЭкземплярОтчета В(&СписокЭкземпляров)
	|	И ЗначенияПоказателейОтчетов.Индекс = 0";
	
	// Сформируем текст запроса по аналитическому раскрытию показателей.
	Сч = 1;
	
	ТекстСоединения 	= "";		
	УсловиеСоединения 	= "";
	ТекстТаблица		= "";
	ТекстПоля			= "";
	
	Для Каждого СтрРеквизит ИЗ ТабФормированияЗапроса Цикл
		
		Если СтрРеквизит.ЭтоКонстанта Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТаблица = "Таб"+СтрРеквизит.ИмяПараметра;
		
		ТекстПоля = ТекстПоля + "
		|	"+ТекТаблица+".Значение КАК "+СтрРеквизит.ИмяПараметра+",";
		
		Если Сч = 1 Тогда
			ТекстТаблица = "
			|	"+ТекТаблица+".ЭкземплярОтчета КАК ЭкземплярОтчета,
			|	"+ТекТаблица+".ГруппаРаскрытия КАК ГруппаРаскрытия,
			|	"+ТекТаблица+".Индекс КАК Индекс
			|ИЗ
			|	РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица;
			
			ПерваяТаблица = ТекТаблица;
			
		Иначе 
			
			ТекстСоединения = ТекстСоединения + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица+"
			|		ПО "+ПерваяТаблица+".ЭкземплярОтчета = "+ТекТаблица+".ЭкземплярОтчета
			|			И "+ПерваяТаблица+".ГруппаРаскрытия = "+ТекТаблица+".ГруппаРаскрытия
			|			И "+ПерваяТаблица+".Индекс = "+ТекТаблица+".Индекс";
			
		КонецЕсли;
		
		УсловиеСоединения = УсловиеСоединения + "
		|	И "+ТекТаблица+".ВидАналитики = &ВидАналитики"+СтрРеквизит.ИмяПараметра + "
		|	И "+ТекТаблица+".ЭкземплярОтчета В(&СписокЭкземпляров)";
		
		Если ЗначениеЗаполнено(СтрРеквизит.ЗначениеИзКонтекста) 
			ИЛИ ТипЗнч(СтрРеквизит.ЗначениеИзКонтекста) = Тип("СписокЗначений") Тогда
			
			//Пустой список значений может появиться при отборе по классификатору БК по условиям Подобно, В иерархии и тд.
			//по которым сначала формируется запрос к данным справочника, а результат запроса к справочнику передается в ЗначениеИзКонтекста.

			МетодОтбора = БюджетнаяОтчетность.ПолучитьМетодОтбора(СтрРеквизит.ВидСравнения,СтрРеквизит.ИмяПараметра);
			
			ПараметрОтбора = ТабПравилаВычисленияПараметров.Найти(СтрРеквизит.ИмяПараметра,"ИмяПараметра");
			Если ПараметрОтбора = Неопределено Тогда
				Сообщить("Не определена аналитика """+СтрРеквизит.ИмяПараметра+""". Отбор невозможен",СтатусСообщения.Внимание);
				Возврат Неопределено;
			КонецЕсли;
			
			УсловиеСоединения = УсловиеСоединения + "
			|	И "+ТекТаблица+".Значение"+МетодОтбора;		
			
		Иначе
			
			ПараметрОтбора = ТабПравилаВычисленияПараметров.Найти(СтрРеквизит.ИмяПараметра,"ИмяПараметра");
			Если ПараметрОтбора = Неопределено Тогда
				Сообщить("Не определена аналитика """+СтрРеквизит.ИмяПараметра+""". Отбор невозможен",СтатусСообщения.Внимание);
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
			
		Запрос.УстановитьПараметр("ВидАналитики"+СтрРеквизит.ИмяПараметра, ПараметрОтбора.ВидАналитикиОтбор);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	ТекстСоединения = "
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ "
	+ ТекстПоля
	+ ТекстТаблица
	+ ТекстСоединения + "
	|ГДЕ" + Сред(СокрЛ(УсловиеСоединения),2)+") КАК ЗначенияАналитики
	|	ПО ЗначенияПоказателейОтчетов.ЭкземплярОтчета  = ЗначенияАналитики.ЭкземплярОтчета
	|		И ЗначенияПоказателейОтчетов.Показатель.ГруппаРаскрытия = ЗначенияАналитики.ГруппаРаскрытия
	|		И ЗначенияПоказателейОтчетов.Индекс = ЗначенияАналитики.Индекс";
	
	ТекстЗапросаАналитика = 
	"ВЫБРАТЬ
	|	ЗначенияПоказателейОтчетов.Показатель,";
	
	Если СтрЗапрос.ЕстьРаскрытиеПоАналитике Тогда
		Для Каждого ПолеЗапроса ИЗ ПоляВыборки Цикл
			
			ТекстЗапросаАналитика=ТекстЗапросаАналитика+"
			|" + ?(ПолеЗапроса.ЭтоКонстанта,"&","ЗначенияАналитики.")
			+ ПолеЗапроса.ИмяПараметра + " КАК " + ПолеЗапроса.ИмяПараметра+",";
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗапросаАналитика=ТекстЗапросаАналитика+"	
	|	ЛОЖЬ КАК ИтогПоПоказателю,
	|	ЗначенияПоказателейОтчетов.ЗначениеЧисло
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов"
	+ ТекстСоединения + "
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета В(&СписокЭкземпляров)
	|	И ЗначенияПоказателейОтчетов.Показатель В(&ПоказательОтбор)";
	
	// Признак включения промежуточных итогов.
	Если Не СтрЗапрос.ВключатьПромежуточныеИтоги Тогда
		ТекстЗапросаАналитика = ТекстЗапросаАналитика + "
		|	И ЗначенияПоказателейОтчетов.ПромежуточныйИтог = ЛОЖЬ";
	КонецЕсли;
	
	ТекстПостроителя = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеОтчетов.Показатель,
	|	ДанныеОтчетов.ИтогПоПоказателю,";
	
	Если СтрЗапрос.ЕстьРаскрытиеПоАналитике Тогда
		Для Каждого ПолеЗапроса ИЗ ПоляВыборки Цикл
			
			ТекстПостроителя=ТекстПостроителя+"
			|	ДанныеОтчетов."+ПолеЗапроса.ИмяПараметра+" КАК "+ПолеЗапроса.ИмяПараметра+",";
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстПостроителя = ТекстПостроителя + "
	|	СУММА(ДанныеОтчетов.ЗначениеЧисло) КАК Значение
	|ИЗ(";
	
	Если МассивОтборАналитики.Количество()=0 И ПравилаИспользованияПолейЗапроса.Количество()>0 Тогда
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаСинтетика+"
		|ОБЪЕДИНИТЬ ВСЕ
		|"+ТекстЗапросаАналитика;
		
	ИначеЕсли МассивОтборАналитики.Количество() > 0 Тогда
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаАналитика;
		
	Иначе
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаСинтетика;
		
	КонецЕсли;
	
	ТекстПостроителя=ТекстПостроителя+") КАК ДанныеОтчетов
	|СГРУППИРОВАТЬ ПО
	|ДанныеОтчетов.Показатель,";
	
	Если СтрЗапрос.ЕстьРаскрытиеПоАналитике Тогда
		Для Каждого ПолеЗапроса ИЗ ПоляВыборки Цикл
			
			ТекстПостроителя=ТекстПостроителя+"
			|ДанныеОтчетов."+ПолеЗапроса.ИмяПараметра+",";
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстПостроителя=ТекстПостроителя+"
	|ДанныеОтчетов.ИтогПоПоказателю";
	
	Запрос.Текст = ТекстПостроителя;
	
	ПоказателиОтбор=Новый СписокЗначений;
	
	Для Каждого Операнд ИЗ СтрЗапрос.СписокОперандов Цикл
		
		Если ПоказателиОтбор.НайтиПоЗначению(Операнд.Значение.ПоказательОтбор)=Неопределено Тогда
			
			ПоказателиОтбор.Добавить(Операнд.Значение.ПоказательОтбор);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Параметры.Вставить("СписокЭкземпляров",МассивОтчетов);
	Запрос.Параметры.Вставить("ПоказательОтбор"	 ,ПоказателиОтбор);
	
	Если ТипЗнч(СтрЗапрос)=Тип("Структура") Тогда  // Вызван из процедуры расшифровки показателя
		СтрЗапрос.Вставить("ПравилаВычисленияПараметров",ТабПравилаВычисленияПараметров);
	КонецЕсли;

	Возврат Запрос;
	
КонецФункции // ПодготовитьЗапросВнутрПоказатель() 

// Процедура отрабатывает при вызове методов заполнения или вычисления показателей отчета
//
Процедура ОбработатьПоПараметрическойНастройке(РежимОбработки,МассивКодовПоказателей=Неопределено) Экспорт
	
	Если НЕ ДанныеПараметрикиАктуальны Тогда
		ПодготовитьДанныеПараметрическойНастройки();
	КонецЕсли;
	
	//Поготовим макет таблицы для расчета
	
	РабочаяТаблица = Новый ТаблицаЗначений;
	
	Для Каждого Кол Из мПоказателиРаскрытия.Колонки Цикл
		
		Если НЕ Кол.Имя="Показатель" и Не Кол.Имя = "ПромежуточныйИтог" Тогда // Показатель один.
			
			РабочаяТаблица.Колонки.Добавить(Кол.Имя, Кол.ТипЗначения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	РабочаяТаблица.Колонки.Добавить("ИтогПоПоказателю",Новый ОписаниеТипов("Булево"));
	
	// Рассчитаем показатели
	
	Если мПоказателиДляОбработки = Неопределено Тогда
		
		Если ПравилоОбработки.Пустая() Тогда
			ноСообщить("Не удалось определить порядок обработки показателей; не задано правило обработки.", СтатусСообщения.Важное);
		Иначе
			ноСообщить("Не удалось определить порядок обработки показателей. Проверьте формулы расчета.", СтатусСообщения.Внимание);
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если МассивКодовПоказателей = Неопределено Тогда
		
		Для Каждого ПоказательОбработки ИЗ мПоказателиДляОбработки Цикл
			
			РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица);
			
		КонецЦикла;
		
	Иначе
		
		//в массиве МассивКодовПоказателей могут быть показатели без учета порядка расчета,
		//поэтому упорядочим их
		ТабУпорядочивания	   = мПоказателиДляОбработки.СкопироватьКолонки("Код,Порядок");
		Для Каждого КодПок Из МассивКодовПоказателей Цикл
			СтрПоказательОбработки = мПоказателиДляОбработки.Найти(КодПок,"Код");
			Если Не СтрПоказательОбработки = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТабУпорядочивания.Добавить(),СтрПоказательОбработки);
			КонецЕсли;
		КонецЦикла;
		
		ТабУпорядочивания.Сортировать("Порядок");
		МассивКодовПоказателей = ТабУпорядочивания.ВыгрузитьКолонку("Код");
		
		Для Каждого Код ИЗ МассивКодовПоказателей Цикл
			
			ПоказательОбработки=мПоказателиДляОбработки.Найти(Код,"Код");
			
			Если Не ПоказательОбработки=Неопределено Тогда
				
				РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПоПараметрическойНастройке()

Процедура РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица)
	
	Если ПустаяСтрока(ПоказательОбработки.Процедура) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрПоказательИтог=мПоказатели.Найти(ПоказательОбработки.Код,"Код");
		
	РассчитатьПараметрическиНастроенныйПоказатель(ПоказательОбработки,РабочаяТаблица.СкопироватьКолонки(),СтрПоказательИтог);
	
КонецПроцедуры // 

Процедура РассчитатьПараметрическиНастроенныйПоказатель(ПоказательОбработки,РабочаяТаблица,СтрПоказательИтог)
	
	Перем СтрИтог; // Строка, в которую будет помещено итоговое значение показателя
	
	ТекстСверткиОперанды="";
	ТекстСверткиИзмерения="";
	
	// Добавим колонки, в которых будут содержаться значения каждого операнда
	
	СтруктураРасчета=Новый Структура;
	
	СтруктураАналитик=Новый Структура; // Структура, в которую будет записываться код аналитики 
	// и количество операндов формулы, которые имеют по ней раскрытие.
	// Рабочая таблица будет развернута только по тем аналитикам,
	// которые имеют раскрытие по всем операндам формулы.
	
	ОперандыБезАналитики=Новый Структура; 	// Структура, в которой хранятся значения операндов, не раскрывающихся
	// по аналитикам. Эти значения будут использоваться для всех комбинаций
	// аналитических раскрытий.
	
	РабочаяТаблица.Колонки.Добавить("РабочийКод"); // Вспомогательная колонка для определения
	// имени показателя, который заполнялся при итерации алгоритма.
	
	ОписаниеТиповЧисловогоПоказателя = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя();
	
	ЭтоВычисление = Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление;
	
	Для Каждого Операнд ИЗ ПоказательОбработки.СписокИспользуемых Цикл
		
		РабочийКод = ?(ПоказательОбработки.ПоказателиТекущегоОтчета,Операнд.Представление,Операнд.Значение);
		
		Если Не Лев(РабочийКод,9) = "Аналитика" Тогда
			РабочаяТаблица.Колонки.Добавить("_"+РабочийКод, ОписаниеТиповЧисловогоПоказателя);
			ТекстСверткиОперанды=ТекстСверткиОперанды+",_"+РабочийКод;
			СтруктураРасчета.Вставить("_"+РабочийКод,0);
			ИспользоватьАналитику = Ложь;
		Иначе
			ИспользоватьАналитику = Истина;
		КонецЕсли;
		
		Если ПоказательОбработки.СпособОбработки = ЭтоВычисление Тогда
			
			Если ИспользоватьАналитику Тогда
				СтрПоказательОперанд = СтрПоказательИтог;
			Иначе
				СтрПоказательОперанд = мПоказатели.Найти(РабочийКод,"Код");
			КонецЕсли;
			
			Если Не СтрПоказательОперанд=Неопределено Тогда
				
				ПолучитьЗначенияОперандаИзОтчета(РабочийКод,
												 СтрПоказательОперанд.Ссылка,
												 СтрПоказательОперанд,
												 СтрПоказательИтог,
												 РабочаяТаблица,
												 СтруктураАналитик,ОперандыБезАналитики);
				
			КонецЕсли;
			
		Иначе
			
			ПолучитьЗначенияОперандаИзОтчета(РабочийКод,СтрПоказательИтог.Ссылка,СтрПоказательИтог,СтрПоказательИтог,РабочаяТаблица,СтруктураАналитик,ОперандыБезАналитики);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Определим промежуточные итоги для участвующих в формуле операндов.
	ИндексыПромежуточныхИтогов = Новый Соответствие;
	Для Каждого СтрЗначений Из РабочаяТаблица.НайтиСтроки(Новый Структура("ИтогПоПоказателю",Истина)) Цикл
		
		Если СтрЗначений.Индекс <> 0 Тогда
			
			ПромежуточныеИтоги = ИндексыПромежуточныхИтогов[СтрЗначений.Индекс];
			Если ПромежуточныеИтоги = Неопределено Тогда
				ПромежуточныеИтоги = "," + СтрЗначений.РабочийКод + ",";
			Иначе
				ПромежуточныеИтоги = ПромежуточныеИтоги + "," + СтрЗначений.РабочийКод + ",";
			КонецЕсли;
			
			СтрЗначений.ИтогПоПоказателю = Ложь; // Сброс признака итога для промежуточной строки.
			
			// поместим новое значение.
			ИндексыПромежуточныхИтогов[СтрЗначений.Индекс] = ПромежуточныеИтоги;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Отметим использование в аналитиках для тех операндов, которые используются для всех аналитик
	Для Каждого КлючИЗначение ИЗ ОперандыБезАналитики Цикл
		
		Для Каждого СтрАналитика ИЗ СтруктураАналитик Цикл
			
			СтруктураАналитик[СтрАналитика.Ключ]=СтруктураАналитик[СтрАналитика.Ключ]+1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Индекс=1 По мЧислоДопАналитик Цикл
		
		Если (НЕ ВидАналитикиПоказателяПоНомеру(СтрПоказательИтог,Индекс)=мПустойВидАналитики)
			И СтруктураАналитик.Свойство("Аналитика"+Индекс)
			И СтруктураАналитик["Аналитика"+Индекс]=ПоказательОбработки.СписокИспользуемых.Количество() Тогда
			
			ТекстСверткиИзмерения=ТекстСверткиИзмерения+",Аналитика"+Индекс;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСверткиИзмерения=Сред(ТекстСверткиИзмерения,2)+",ИтогПоПоказателю,Индекс";
	ТекстСверткиОперанды=Сред(ТекстСверткиОперанды,2)+",Значение";
	
	//////////////////////////////////////////////////////////////////////////
	// Соединение всех строк по аналитике показателей.
	РабочаяТаблица.Свернуть(ТекстСверткиИзмерения,ТекстСверткиОперанды);
	
	РабочаяТаблица.Колонки.Добавить("РасчетВыполнен",Новый ОписаниеТипов("Булево"));
	РабочаяТаблица.Колонки.Добавить("Показатель");
	РабочаяТаблица.Колонки.Добавить("ДанныеРасчета");
	
	Если Не ПустаяСтрока(ТекстСверткиИзмерения) Тогда
		
		Для Каждого ОбщееЗначение ИЗ ОперандыБезАналитики Цикл
			
			РабочаяТаблица.ЗаполнитьЗначения(ОбщееЗначение.Значение,ОбщееЗначение.Ключ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////
	// Удаление существующих значений раскрытия и обработка промежуточного итога.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Показатель",ПоказательОбработки.Показатель);
	ТекИндексыПромежуточногоИтога = Новый Соответствие;
	
	МассивРаскрытия = мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрРаскрытия ИЗ МассивРаскрытия Цикл
		
		Если ПоказательОбработки.СпособОбработки=Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление и СтрРаскрытия.ПромежуточныйИтог Тогда
			ТекИндексыПромежуточногоИтога.Вставить(СтрРаскрытия.Индекс,Истина);
		КонецЕсли;
		//Т.к. может быть итог по показателю по строке для вычисляемого показателя,
		//где не заполнены показатели для его расчета, такую строку удалять не будем.
		Если РабочаяТаблица.Найти(СтрРаскрытия.Индекс,"Индекс") <> Неопределено Тогда
			мПоказателиРаскрытия.Удалить(СтрРаскрытия);
		КонецЕсли;
		
	КонецЦикла;
		
	// Преобразование формулы для расчета.
	РабочееВыражение = ПоказательОбработки.Процедура;
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"ЭтоПромежуточныйИтог(","ЭтоПромежуточныйИтог(СтрокаРасчет,ИндексыПромежуточныхИтогов,");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"[Аналитика","СтрокаРасчет.Аналитика");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"[","СтрокаРасчет._");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"]","");
	
	Для Каждого СтрокаРасчет ИЗ РабочаяТаблица Цикл
		
		СтрокаРасчет.РасчетВыполнен=Истина;
		СтрокаРасчет.Показатель=ПоказательОбработки.Показатель;
		
		ТекСтруктураДанных = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(СтруктураРасчета);
		ЗаполнитьЗначенияСвойств(ТекСтруктураДанных,СтрокаРасчет);
		
		СтрокаРасчет.ДанныеРасчета=ТекСтруктураДанных;
		
		Попытка
			
			СтрокаРасчет.Значение=Вычислить(РабочееВыражение);
			
		Исключение
			
			ноСообщить("Расчет по показателю "+ПоказательОбработки.Код+": "+ОписаниеОшибки());
			СтрокаРасчет.Значение=0;
			СтрокаРасчет.РасчетВыполнен=Ложь;
			
		КонецПопытки
		
	КонецЦикла;	
	
	// Сохраним полученные результаты
	ЕстьРаскрытие=Ложь;
	РабочаяТаблица.Колонки.Добавить("ПромежуточныйИтог",Новый ОписаниеТипов("Булево"));
	
	ГруппаРаскрытия = Неопределено;
	ТекСтр = мПоказатели.Найти(ПоказательОбработки.Показатель,"Ссылка");
	Если ТекСтр <> Неопределено Тогда
		ГруппаРаскрытия = ТекСтр.ГруппаРаскрытия;	
	КонецЕсли;
	
	Для Каждого СтрокаРасчет ИЗ РабочаяТаблица Цикл
		
		Если СтрокаРасчет.ИтогПоПоказателю Тогда
			
			СтрИтог = СтрокаРасчет;
			
		Иначе
			
			СтрРаскрытие=мПоказателиРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрРаскрытие,СтрокаРасчет);
			СтрРаскрытие.ГруппаРаскрытия = ГруппаРаскрытия;
			
			Если ТекИндексыПромежуточногоИтога[СтрокаРасчет.Индекс] = Истина Тогда
				СтрРаскрытие.ПромежуточныйИтог = Истина;
				СтрокаРасчет.ПромежуточныйИтог = Истина;
			КонецЕсли;
			
			ЕстьРаскрытие=Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СтрИтог = Неопределено Тогда
		
		ЗначениеИтог  = СтрИтог.Значение;
		ДанныеРасчета = СтрИтог.ДанныеРасчета;
		
		Если СтрПоказательИтог.ВидИтога=Перечисления.ВидыИтоговПоказателя.НеРассчитывается ИЛИ СтрПоказательИтог.НеФинансовый ИЛИ (НЕ ЕстьРаскрытие) Тогда
			
			Показатели[ПоказательОбработки.Код]=СтрИтог.Значение;
			
			СтрПоказательИтог.ДанныеРасчета=СтрИтог.ДанныеРасчета;
			СтрПоказательИтог.Значение=СтрИтог.Значение;
			
		Иначе
			
			// Считаем итоги по раскрытию.
			
			РабочаяТаблица.Удалить(СтрИтог);
			ИтогРаскрытия = ТЗИтог(РабочаяТаблица, ТекстСверткиИзмерения, "Значение", СтрПоказательИтог.ВидИтога,СтрПоказательИтог.ТипЗначения);
			
			Показатели[ПоказательОбработки.Код] = ИтогРаскрытия;
			СтрПоказательИтог.ДанныеРасчета		= ДанныеРасчета;
			СтрПоказательИтог.Значение			= ИтогРаскрытия;
			
		КонецЕсли;
		
	Иначе
		
		СтрПоказательИтог.ДанныеРасчета = Неопределено;
		
		Если Не (СтрПоказательИтог.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается
			 ИЛИ СтрПоказательИтог.НеФинансовый) Тогда
			
			Показатели[ПоказательОбработки.Код] = ТЗИтог(РабочаяТаблица, ТекстСверткиИзмерения, "Значение", СтрПоказательИтог.ВидИтога,СтрПоказательИтог.ТипЗначения);
			
			СтрПоказательИтог.Значение = Показатели[ПоказательОбработки.Код];
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрПоказательИтог.СохраненныеДанныеАктуальны=Ложь;
	
КонецПроцедуры // РассчитатьПараметрическиНастроенныйПоказатель()

// Получает значения операнда, ссылающегося на показатель текущего отчета
//
Процедура ПолучитьЗначенияОперандаИзОтчета(КодПоказательОперанд,ПоказательОперанд,СтрПоказательОперанд,СтрПоказательИтог,РабочаяТаблица,СтруктураАналитик,ОперандыБезАналитики)
	
	Перем СтрОперандИтог;
	
	СтруктураПоиска=Новый Структура;
	СтруктураПоиска.Вставить("Показатель",ПоказательОперанд);
	
	ЕстьПоказатель = Показатели.Свойство(КодПоказательОперанд, СтрОперандИтог);
	Если (ЕстьПоказатель и СтрОперандИтог = Неопределено) или СтрПоказательОперанд.Отключен Тогда
		ОписаниеТипов  = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрПоказательОперанд.ТипЗначения);
		СтрОперандИтог = ОписаниеТипов.ПривестиЗначение(СтрОперандИтог);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрПоказательОперанд.ГруппаРаскрытия) И ЗначениеЗаполнено(СтрПоказательИтог.ГруппаРаскрытия) Тогда
		
		МассивДанных=мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
		
		// Определим структуру для разворота аналитики показателя - операнда по аналитике 
		// вычисляемого показателя.
		
		СтруктураСвязи=Новый Структура;
		
		Для ИндексОп=1 По мЧислоДопАналитик Цикл
			
			ВидАналитикиОперанд=ВидАналитикиПоказателяПоНомеру(СтрПоказательОперанд,ИндексОп);
			
			Если НЕ ВидАналитикиОперанд=мПустойВидАналитики Тогда
				
				Для ИндексИт=1 По мЧислоДопАналитик Цикл
					
					ВидАналитикиИтог=ВидАналитикиПоказателяПоНомеру(СтрПоказательИтог,ИндексИт);
					
					Если ВидАналитикиОперанд=ВидАналитикиИтог Тогда
						
						СтруктураСвязи.Вставить("Аналитика"+ИндексОп,"Аналитика"+ИндексИт);
						
						// Отметим заполнение аналитики показателя по данным операнда
						Если СтруктураАналитик.Свойство("Аналитика"+ИндексИт) Тогда
							СтруктураАналитик["Аналитика"+ИндексИт]=СтруктураАналитик["Аналитика"+ИндексИт]+1;	
						Иначе
							СтруктураАналитик.Вставить("Аналитика"+ИндексИт,1);
						КонецЕсли;
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаДанные ИЗ МассивДанных Цикл
			
			НоваяСтрока=РабочаяТаблица.Добавить();
			
			Для Каждого Связь ИЗ СтруктураСвязи Цикл
				
				НоваяСтрока[Связь.Значение]=СтрокаДанные[Связь.Ключ];
				
			КонецЦикла;
			
			Если ЕстьПоказатель Тогда
				Если Не СтрПоказательОперанд.Отключен Тогда
					НоваяСтрока["_"+КодПоказательОперанд]=СтрокаДанные.Значение;
				Иначе
					НоваяСтрока["_"+КодПоказательОперанд]=ОписаниеТипов.ПривестиЗначение(Неопределено);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Индекс 		= СтрокаДанные.Индекс;
			НоваяСтрока.РабочийКод  = КодПоказательОперанд;
			НоваяСтрока.ИтогПоПоказателю = СтрокаДанные.ПромежуточныйИтог;
			
		КонецЦикла;
	Иначе
		
		Если Не СтрПоказательОперанд.Отключен Тогда
			ОперандыБезАналитики.Вставить("_"+КодПоказательОперанд,Показатели[КодПоказательОперанд]);
		КонецЕсли;
		// ОперандыБезАналитики.Вставить(СтрПоказательОперанд);
	КонецЕсли;
	
	// Добавим итоговое значение
	Если ЕстьПоказатель Тогда
		НоваяСтрока=РабочаяТаблица.Добавить();
		
		Если Не СтрПоказательОперанд.Отключен Тогда
			НоваяСтрока["_"+КодПоказательОперанд]=СтрОперандИтог;
		Иначе
			НоваяСтрока["_"+КодПоказательОперанд]=ОписаниеТипов.ПривестиЗначение(Неопределено);
		КонецЕсли;
		
		НоваяСтрока.ИтогПоПоказателю=Истина;
	КонецЕсли;
	
КонецПроцедуры // ПолучитьЗначенияОперандаИзОтчета()

Функция ПолучитьЗначенияОперандаИзТаблицы(ТаблицаЗначенийОперандов,КодОперанда,Операнд,РабочаяТаблица,СтруктураАналитик,ОперандыБезАналитики,КонтрольноеСоотношение = Неопределено)
	
	ТаблицаОперандов = Операнд.Владелец();
	СтруктураПоиска=Новый Структура;
		
	ПроверяемыйПоказатель = Операнд.ПоказательОтбор;
	
	СтруктураПоиска.Вставить("КодОперанда",КодОперанда);
	Если Не КонтрольноеСоотношение = Неопределено Тогда
		СтруктураПоиска.Вставить("КонтрольноеСоотношение",КонтрольноеСоотношение);
	КонецЕсли;
	Если ТаблицаОперандов.Колонки.Найти("ГруппаРаскрытия")<>Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Операнд.ГруппаРаскрытия) Тогда
			СтруктураПоиска.Вставить("ИтогПоПоказателю",Истина);	
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ПроверяемыйПоказатель) Тогда 
			Если НЕ ЕстьГруппаРаскрытия(Операнд.ВидОтчетаОтбор) Тогда 
				СтруктураПоиска.Вставить("ИтогПоПоказателю",Истина);
			ИначеЕсли НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроверяемыйПоказатель,"ГруппаРаскрытия")) Тогда 
				СтруктураПоиска.Вставить("ИтогПоПоказателю",Истина); 			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьАналитики=Ложь;
	Если НЕ СтруктураПоиска.Свойство("ИтогПоПоказателю") Тогда
		ТабАналитики=Операнд.ПравилаИспользованияПолейЗапроса.Скопировать();
		ТабАналитики.Свернуть("КодАналитики");
		
		Для Каждого Аналитика ИЗ ТабАналитики Цикл
			
			Если ПустаяСтрока(Аналитика.КодАналитики) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ЕстьАналитики=Истина;
			
			Если СтруктураАналитик.Свойство(Аналитика.КодАналитики) Тогда
				СтруктураАналитик[Аналитика.КодАналитики]=СтруктураАналитик[Аналитика.КодАналитики]+1;
			Иначе
				СтруктураАналитик.Вставить(Аналитика.КодАналитики,1);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	МассивДанных	  = ТаблицаЗначенийОперандов.НайтиСтроки(СтруктураПоиска);
	ДобавленныеСтроки = Новый Массив;
	
	Для Каждого СтрокаДанные ИЗ МассивДанных Цикл
		
		НоваяСтрока = РабочаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаДанные,,"Значение");
		НоваяСтрока["_"+КодОперанда]=СтрокаДанные.Значение;
		
		Если НЕ ЕстьАналитики Тогда
			
			ОперандыБезАналитики.Вставить("_"+КодОперанда,СтрокаДанные.Значение);
			
		КонецЕсли;
		
		ДобавленныеСтроки.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат ДобавленныеСтроки;
	
КонецФункции // ПолучитьЗначенияОперандаИзТаблицы()

// Вычисляет значение параметра операнда в зависимости от способа его вычисления
//
Функция ПолучитьСвойстваПараметра(СтрокаПараметр) Экспорт
	
	Перем ЗначениеПараметра;
	
	СвойстваПараметра=Новый Структура("ВидСравнения,Значение");
	
	СоответствиеОтборов = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьСоответствиеОтборовОперандов();
	
	СоответствиеОтборовПоРеквизиту = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьСоответствиеОтборовОперандовПоРеквизиту();
	ЗаполнитьПереченьСтроковыхАналитикПриНеобходимости();
	
	Если СоответствиеОтборов[СтрокаПараметр.СпособВычисленияПараметра] <> Неопределено 
		И НЕ ЗначениеЗаполнено(СтрокаПараметр.РеквизитАналитики) Тогда
		
		СвойстваПараметра.ВидСравнения = СоответствиеОтборов[СтрокаПараметр.СпособВычисленияПараметра];
		НастройкаПараметра = СтрокаПараметр.УточнениеСпособаОпределения.Получить();
		
		Если мСоответствиеСтроковыхБК[СтрокаПараметр.ВидАналитикиОтбор] = Истина Тогда
			Если СвойстваПараметра.ВидСравнения = ВидСравнения.ВИерархии
				 ИЛИ СвойстваПараметра.ВидСравнения = ВидСравнения.ВСпискеПоИерархии Тогда
				ТекВидСравнения = "В ИЕРАРХИИ";
				СвойстваПараметра.ВидСравнения = ВидСравнения.ВСписке;
			ИначеЕсли СвойстваПараметра.ВидСравнения = ВидСравнения.НеВИерархии
				 ИЛИ СвойстваПараметра.ВидСравнения = ВидСравнения.НеВСпискеПоИерархии Тогда
				ТекВидСравнения = "В ИЕРАРХИИ";
				СвойстваПараметра.ВидСравнения = ВидСравнения.НеВСписке;
			ИначеЕсли СвойстваПараметра.ВидСравнения = ВидСравнения.Равно 
				 ИЛИ СвойстваПараметра.ВидСравнения = ВидСравнения.ВСписке Тогда
				ТекВидСравнения = "В";
				СвойстваПараметра.ВидСравнения = ВидСравнения.ВСписке;
			ИначеЕсли СвойстваПараметра.ВидСравнения = ВидСравнения.НеРавно
				 ИЛИ СвойстваПараметра.ВидСравнения = ВидСравнения.НеВСписке Тогда
				ТекВидСравнения = "В";
				СвойстваПараметра.ВидСравнения = ВидСравнения.НеВСписке;
			КонецЕсли;
			СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораБК(НастройкаПараметра, ТекВидСравнения, СтрокаПараметр.ВидАналитикиОтбор);
		Иначе
			СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбора(НастройкаПараметра);
		КонецЕсли;
		
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СоответствиеОтборов[СтрокаПараметр.СпособВычисленияПараметра] <> Неопределено 
		И ЗначениеЗаполнено(СтрокаПараметр.РеквизитАналитики) Тогда	
		
		//В отборе по реквизиту аналитики значением отбора всегда будет список значений 
		СвойстваПараметра.ВидСравнения = СоответствиеОтборовПоРеквизиту[СтрокаПараметр.СпособВычисленияПараметра];
			
		НастройкаПараметра = СтрокаПараметр.УточнениеСпособаОпределения.Получить();
				
		СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораПоРеквизиту(НастройкаПараметра," В ",СтрокаПараметр.РеквизитАналитики,СтрокаПараметр.ВидАналитикиОтбор);

		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=Организация;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ПериодОтчета;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПоДатеКонцаПериодаОтчета Тогда
		
		СвойстваПараметра.ВидСравнения = ВидСравнения.ВСписке;
		
		СписокПериодов 	= Новый СписокЗначений;
		СписокПериодов.ЗагрузитьЗначения(ПериодПоДатеОкончания(ПериодОтчета.ДатаОкончания));
		
		СвойстваПараметра.Значение = СписокПериодов;
		СтрокаПараметр.ИзКонтекста = Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПоДатеНачалаПериодаОтчета Тогда
		
		СвойстваПараметра.ВидСравнения = ВидСравнения.ВСписке;
		
		СписокПериодов 	= Новый СписокЗначений;
		СписокПериодов.ЗагрузитьЗначения(ПериодПоДатеНачала(ПериодОтчета.ДатаНачала));
		
		СвойстваПараметра.Значение = СписокПериодов;
		СтрокаПараметр.ИзКонтекста = Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчетаСоСдвигом Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтносительныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом Тогда
		
		ОтнПериод=ОтносительныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=КонецДня(ОтнПериод.ДатаОкончания);
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом Тогда
		
		ОтнПериод=ОтносительныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод.ДатаНачала;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=НачалоГода(ПериодОтчета.ДатаНачала);
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=КонецГода(ПериодОтчета.ДатаОкончания);
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодПредыдущегоГода Тогда
		
		ОтнПериод=АналогичныйПериод(, -1);
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодГодаСоСдвигом Тогда
		
		ОтнПериод=АналогичныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ГодСоСдвигом Тогда
		
		ОтнПериод=ГодСоСдвигом(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;	
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ГодПредыдущий Тогда
		
		ОтнПериод=ГодСоСдвигом(, -1);
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;			
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом Тогда
		
		ОтнПериод=АналогичныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=НачалоГода(ОтнПериод.ДатаНачала);
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом Тогда
		
		ОтнПериод=АналогичныйПериод(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=КонецГода(ОтнПериод.ДатаНачала);
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПоследнийМесяцПериодаОтчетаСоСдвигом Тогда
		
		ОтнПериод=ПоследнийМесяцПериодаОтчетаСоСдвигом(, СтрокаПараметр.УточнениеСпособаОпределения.Получить());
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=ОтнПериод;
		СтрокаПараметр.ЗначениеДляПроверки=СвойстваПараметра.Значение;
		
		СтрокаПараметр.ИзКонтекста=Истина;
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Булево
		ИЛИ СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Дата
		ИЛИ СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Строка
		ИЛИ СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Число Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		СвойстваПараметра.Значение=СтрокаПараметр.УточнениеСпособаОпределения.Получить();
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;	

	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке Тогда
		
		УстановитьБезопасныйРежим(Истина);
	
		Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
		Иначе
			МассивРазделителей = Новый Массив;
		КонецЕсли;
		
		Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
			УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
		КонецЦикла;
		
