// Функция получает хранимый макет, описаный в правилах или печ. формах.
//
// Параметры
//  ОбъектВладелец - объект, для которого создан макет.
//                 Правило обработки, правило проверки или произвольная
//				   печатная форма.
//  ИмяМакета	   - Строка, имя макета
//
// Возвращаемое значение:
//   Хранимый макет. Тип значения зависит от типа макета
//
Функция ПолучитьХранимыйМакет(ОбъектВладелец,ИмяМакета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХранимыеМакетыНастроекОтчетов.Макет
	|ИЗ
	|	РегистрСведений.ХранимыеМакетыНастроекОтчетов КАК ХранимыеМакетыНастроекОтчетов
	|ГДЕ
	|	ХранимыеМакетыНастроекОтчетов.Владелец = &Владелец
	|	И ХранимыеМакетыНастроекОтчетов.ИмяМакета = &ИмяМакета";
	
	Запрос.УстановитьПараметр("Владелец"	,ОбъектВладелец);
	Запрос.УстановитьПараметр("ИмяМакета"	,ИмяМакета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Макет.Получить();
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьХранимыйМакет()

