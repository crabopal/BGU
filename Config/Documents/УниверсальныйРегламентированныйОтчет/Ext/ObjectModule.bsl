// ПРОЦЕДУРЫ РАБОТЫ С ХРАНИМЫМИ МАКЕТАМИ
//

// Функция заполняет параметры схемы компоновки данных значениями
// из контекста текущего документа.
//
// Параметры
//  СхемаКомпоновки - схема компоновки данных
//
//  ИсточникДанных  - источник, описаный в хранимом макета
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных. обработанная схема компоновки
//
Функция ПодготовитьСхемуКомпоновкиДанныхОтчета(СхемаКомпоновки,ИсточникДанных,ТаблицаИсточник = Неопределено, ДопДанныеСхемы = Неопределено) Экспорт

	Если ИсточникДанных.Свойство("ТипИсточника") Тогда 
		ТипИсточника = ИсточникДанных.ТипИсточника;
	Иначе 
		Если ИсточникДанных.ТипИсточникаЗапрос Тогда 
			ТипИсточника = "ВсеОтчеты";
		Иначе 
			ТипИсточника = "ЭтотОтчет";
		КонецЕсли;
	КонецЕсли;	
	
	Если ТипИсточника = "ВсеОтчеты" Тогда
		
		БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки,"ВидОтчета",ВидОтчета);
		
		Если ИсточникДанных.ПараметрыДанных.Свойство("Показатель") Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("КодыПоказателейВыбранные", ИсточникДанных.ПараметрыДанных.Показатель);
			Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ГруппыРаскрытияАналитика.НомерСтроки,
			|	ГруппыРаскрытияАналитика.ВидАналитики
			|ИЗ
			|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
			|ГДЕ
			|	ГруппыРаскрытияАналитика.Ссылка В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				ПоказателиОтчетов.ГруппаРаскрытия КАК ГруппаРаскрытия
			|			ИЗ
			|				Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|			ГДЕ
			|				ПоказателиОтчетов.Владелец = &ВидОтчета
			|				И ПоказателиОтчетов.Код В (&КодыПоказателейВыбранные))";
			
			ВидыАналитик = Запрос.Выполнить().Выгрузить();
			Для Каждого ВидАналитики Из ВидыАналитик Цикл
				БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки,"ВидАналитикиАналитика"+ВидАналитики.НомерСтроки,ВидАналитики.ВидАналитики);			
			КонецЦикла;
			
		КонецЕсли;
		
		ПоляОтбора = ИсточникДанных.ВыбранныеПоля.НайтиСтроки(Новый Структура("ОтборПоКонтексту",Истина));
		Если ПоляОтбора.Количество() > 0 Тогда
			ТекстЗапроса = СхемаКомпоновки.НаборыДанных[0].Запрос;
			
			ТекстУсловий = "";
			
			Для Каждого Поле Из ПоляОтбора Цикл
				
				ТекстУсловий = ТекстУсловий + "
				|И ЗначенияПоказателейОтчетов." + Поле.Имя + " = &" + Поле.Имя;
				
				Если Параметры.Свойство(Поле.Имя) Тогда
					ЗначениеОтбора = Параметры[Поле.Имя];
				ИначеЕсли ДополнительныеРеквизиты.Свойство(Поле.Имя) Тогда
					ЗначениеОтбора = ДополнительныеРеквизиты[Поле.Имя];
				ИначеЕсли Поле.Имя = "ЭкземплярОтчета" Тогда
					ЗначениеОтбора = Ссылка;
				Иначе
					ЗначениеОтбора = ЭтотОбъект[Поле.Имя];
				КонецЕсли;
				
				БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки,Поле.Имя,ЗначениеОтбора);
				
			КонецЦикла;
			
			ТекстУсловий = "ГДЕ
			|" + Сред(ТекстУсловий,3);
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"//%УСЛОВИЕ ОТБОРА ПО КОНТЕКСТУ%",ТекстУсловий);
			
			СхемаКомпоновки.НаборыДанных[0].Запрос = ТекстЗапроса;
			
		КонецЕсли;
		
		
	////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ТипИсточника = "ЭтотОтчет" Тогда  
		
		КвалификаторЧисла = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
		ВыражениеТипаЧисло = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Число(%1, %2)",
										КвалификаторЧисла.Разрядность,
										КвалификаторЧисла.РазрядностьДробнойЧасти);
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	мПоказателиРаскрытия.Показатель,";
		
		Для Сч = 1 По мЧислоДопАналитик Цикл
			Запрос.Текст = Запрос.Текст + "
			|	мПоказателиРаскрытия.Аналитика" + Сч + ",";
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Значение,
		|	ВЫРАЗИТЬ(мПоказателиРаскрытия.Значение КАК Число(25,5)) КАК ЗначениеЧисло
		|ПОМЕСТИТЬ мПоказателиРаскрытия
		|ИЗ
		|	&мПоказателиРаскрытия КАК мПоказателиРаскрытия";
		
		Запрос.УстановитьПараметр("мПоказателиРаскрытия",мПоказателиРаскрытия);
		Запрос.Выполнить();
		
		ПоляЗапроса = "";
		
		Для Каждого ОписаниеПоля Из ИсточникДанных.ВыбранныеПоля Цикл
			ПоляЗапроса = ПоляЗапроса + ",
			|	"+ОписаниеПоля.ПутьКДанным;
		КонецЦикла;
		
		Запрос.Текст = 
		"ВЫБРАТЬ" + Сред(ПоляЗапроса,2) + "
		|ИЗ
		|	мПоказателиРаскрытия";
		
		ТаблицаИсточник = Запрос.Выполнить().Выгрузить();
		
		БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(СхемаКомпоновки,ТаблицаИсточник,"мПоказателиРаскрытия",Истина);
		
	////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ТипИсточника = "ПроизольнаяСхема" Тогда 
		
		// выполняем как есть
		
	КонецЕсли;
	
	Если ДопДанныеСхемы <> Неопределено и ДопДанныеСхемы.Свойство("Параметры") Тогда 
		Для Каждого ПарметрСКД из ДопДанныеСхемы.Параметры Цикл 
			
			БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки,ПарметрСКД.Ключ,ПарметрСКД.Значение);
			
		КонецЦикла;
	КонецЕсли;	
	
	Возврат СхемаКомпоновки;

КонецФункции // ПодготовитьСхемуКомпоновкиДанныхОтчета()

// Функция выполняет компоновку данных и выводит результат.
//
// Параметры
//  ХранимыйМакет 			- хранимый макет с типом макета "СхемаКомпоновкиДанныхОтчета".
//
//  ИмяНастроекКомпоновки   - строка, имя настроек, описанных в макете
//
//	ОжидаемыйТипЗначения	- Строка, ожидается ДеревоЗначений,ТаблицаЗначений,ТабличныйДокумент 
//
// Возвращаемое значение:
//   ТаблицаЗначений/ДеревоЗначений - результат компоновки данных
//
Функция ВыполнитьХранимыйМакетТипаСКД(ХранимыйМакет,ИмяНастроекКомпоновки = "",ОжидаемыйТипЗначения = "ТаблицаЗначений",ДопДанныеСхемы = Неопределено) Экспорт
	
	СхемаКомпоновки = ХранимыйМакет.ИсточникДанных.СхемаКомпоновки;
	
	Если ПустаяСтрока(ИмяНастроекКомпоновки) Тогда 
		Если ЗначениеЗаполнено(ХранимыйМакет.НастройкиКомпоновки) Тогда 
			Настройки = ХранимыйМакет.НастройкиКомпоновки[0];
		Иначе 
			Настройки = Неопределено;
		КонецЕсли;	
	Иначе 	
		Настройки = ХранимыйМакет.НастройкиКомпоновки.Найти(ИмяНастроекКомпоновки,"ИмяНастройки");
	КонецЕсли;
		
	Если Настройки = Неопределено Тогда
		ноСообщить("Не обнаружено настроек компоновки с именем "+ИмяНастроекКомпоновки,СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкаКомпоновки = Настройки.Настройки;
	
	ТаблицаИсточник = Неопределено;
	
	СхемаКомпоновки = ПодготовитьСхемуКомпоновкиДанныхОтчета(СхемаКомпоновки,ХранимыйМакет.ИсточникДанных,ТаблицаИсточник,ДопДанныеСхемы);
	
	ВнешниеНаборы = Новый Структура("мПоказателиРаскрытия",ТаблицаИсточник);
	
	Если ДопДанныеСхемы <> Неопределено и  ДопДанныеСхемы.Свойство("ВнешниеНаборыДанных") Тогда
		
		Для Каждого ВнешниеДанные из ДопДанныеСхемы.ВнешниеНаборыДанных Цикл 
			
			ВнешниеНаборы.Вставить(ВнешниеДанные.Ключ, ВнешниеДанные.Значение);
			
		КонецЦикла;
		
	КонецЕсли;	
	
	// Инициализация системы компоновки данных.
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Неопределено;
	Если ОжидаемыйТипЗначения = "ДеревоЗначений" или ОжидаемыйТипЗначения = "ТаблицаЗначений" Тогда 
		ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Иначе 
	    ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанных");	
	КонецЕсли;
	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкаКомпоновки,ДанныеРасшифровки,,ТипГенератора);
	
	// Запуск вывода в коллекцию
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,ВнешниеНаборы);
	
	Если ОжидаемыйТипЗначения = "ДеревоЗначений" или ОжидаемыйТипЗначения = "ТаблицаЗначений" Тогда 
		
		Результат = ?(ОжидаемыйТипЗначения = "ДеревоЗначений", Новый ДеревоЗначений, Новый ТаблицаЗначений);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
	Иначе 
		
		Результат = Новый Структура("ТабличныйДокумент,ДанныеРасшифровки");
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		Результат.ТабличныйДокумент = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		Результат.ДанныеРасшифровки = ДанныеРасшифровки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ВывестиРезультатКомпоновкиВКоллекциюЗначений()

// устарела следует применять ВыполнитьХранимыйМакетТипаСКД 
Функция ВывестиМакетКомпоновкиОтчетаВКоллекциюЗначений(ХранимыйМакет,ИмяНастроекКомпоновки,ТипЗначенияДерево = Истина) Экспорт

	СхемаКомпоновки = ХранимыйМакет.ИсточникДанных.СхемаКомпоновки;
	
	Настройки = ХранимыйМакет.НастройкиКомпоновки.Найти(ИмяНастроекКомпоновки,"ИмяНастройки");
	
	Если Настройки = Неопределено Тогда
		ноСообщить("Не обнаружено настроек компоновки с именем "+ИмяНастроекКомпоновки,СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкаКомпоновки = Настройки.Настройки;
	
	ТаблицаИсточник = Неопределено;
	
	СхемаКомпоновки = ПодготовитьСхемуКомпоновкиДанныхОтчета(СхемаКомпоновки,ХранимыйМакет.ИсточникДанных,ТаблицаИсточник);
	
	ВнешниеНаборы = Новый Структура("мПоказателиРаскрытия",ТаблицаИсточник);
	
	// Инициализация системы компоновки данных.
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");					
	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкаКомпоновки,,,ТипГенератора);
	
	// Запуск вывода в коллекцию
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,ВнешниеНаборы);
	
	КоллекцияЗначений = ?(ТипЗначенияДерево,Новый ДеревоЗначений,Новый ТаблицаЗначений);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(КоллекцияЗначений);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат КоллекцияЗначений;

КонецФункции // ВывестиРезультатКомпоновкиВКоллекциюЗначений()

// вспомогательные функции для API процедур пользователя

// Получает значение из контекста для параметров функций, имеющих значения по-умолчанию
//
// Параметры
//  ИсходноеЗначение - значение параметра функции
//
//  ПоУмолчанию		 - значение, возвращаемое, если исходное значение не определено
//
// Возвращаемое значение:
//   Одно из значений, переданных в параметрах
//
Функция ПолучитьПараметрПоУмолчанию(ИсходноеЗначение, ПоУмолчанию = Неопределено)

	Возврат ?(ИсходноеЗначение = Неопределено,ПоУмолчанию,ИсходноеЗначение);

КонецФункции // ПолучитьПараметрПоУмолчанию()

// Получает одним запросом данные при использовании в отображаемом макете 
// реквизитов аналитики "через точку".
//
Функция ПолучитьДополнительныеДанныеДляТаблицыРаскрытия(ОписаниеОбластей,ТаблицаРаскрытия)

	ЗапрашиваемыеРеквизиты = Новый ТаблицаЗначений;
	ЗапрашиваемыеРеквизиты.Колонки.Добавить("ПолеЗапроса");
	ЗапрашиваемыеРеквизиты.Колонки.Добавить("Псевдоним");
	ЗапрашиваемыеРеквизиты.Колонки.Добавить("ДобавитьПредставление",Новый ОписаниеТипов("Булево"));
	
	СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
	СтрРеквизит.ПолеЗапроса	  = "ID";
	СтрРеквизит.Псевдоним 	  = "ID";
	
	СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
	СтрРеквизит.ПолеЗапроса	  = "ПромежуточныеИтоги";
	СтрРеквизит.Псевдоним 	  = "ПромежуточныеИтоги";
	
	ВсеАналитики = Новый Массив;
	Для Сч = 1 По мЧислоДопАналитик Цикл
		КодАналитики = "Аналитика" + Сч;
		Если ТаблицаРаскрытия.Колонки.Найти(КодАналитики) <> Неопределено Тогда
			ВсеАналитики.Добавить(КодАналитики);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Настройка Из ОписаниеОбластей Цикл
		
		КолонкаРесурса = ТаблицаРаскрытия.Колонки.Найти(Настройка.Ресурс);
		Если КолонкаРесурса = Неопределено Тогда
			СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
			СтрРеквизит.ПолеЗапроса = "Неопределено";
			СтрРеквизит.Псевдоним = Настройка.Ресурс;
			Продолжить;
		КонецЕсли;
		
		Если Настройка.ЭтоАналитика Тогда
			
			ТипыКолонкиРесурса = КолонкаРесурса.ТипЗначения.Типы();
			
			Если ТипыКолонкиРесурса.Количество() = 0
				 ИЛИ КолонкаРесурса.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
				 Продолжить;
				// Это вывод хранимого файла, только строки, никаких действий выполнять не надо.
				Возврат ТаблицаРаскрытия;
			КонецЕсли;
			
			СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
			СтрРеквизит.ПолеЗапроса	= Настройка.Ресурс;
			СтрРеквизит.Псевдоним 	= Настройка.Ресурс;
			СтрРеквизит.ДобавитьПредставление = Истина;
			
			Если Не ПустаяСтрока(Настройка.ИмяРеквизита) Тогда
				СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
				
				ТипКолонки = Неопределено;
				Для Сч = 0 По ТипыКолонкиРесурса.Количество()-1 Цикл
					Если ТипыКолонкиРесурса[Сч] <> Тип("Null") Тогда
						ТипКолонки = ТипыКолонкиРесурса[Сч];
					КонецЕсли;
				КонецЦикла;
				
				ПутьКДанным = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьПутьКДаннымДляПоляАналитики(
								ТипКолонки,
								Настройка.Ресурс,
								Настройка.ИмяРеквизита);
								
				Если Не ПутьКДанным = Неопределено Тогда
					СтрРеквизит.ПолеЗапроса = "ПРЕДСТАВЛЕНИЕ(" + ПутьКДанным + ")";
				Иначе
					СтрРеквизит.ПолеЗапроса = "НЕОПРЕДЕЛЕНО";
				КонецЕсли;
				
				СтрРеквизит.Псевдоним = Настройка.Ресурс + "_" + Настройка.ИмяРеквизита;
				
			КонецЕсли;
			
			ПозРесурса = ВсеАналитики.Найти(Настройка.Ресурс);
			Если ПозРесурса <> Неопределено Тогда
				ВсеАналитики.Удалить(ПозРесурса);
			КонецЕсли;
			
		Иначе
			СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
			СтрРеквизит.ПолеЗапроса = Настройка.Ресурс;
			СтрРеквизит.Псевдоним   = Настройка.Ресурс;
			
			СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
			СтрРеквизит.ПолеЗапроса = Настройка.Ресурс + "_Отображение";
			СтрРеквизит.Псевдоним   = Настройка.Ресурс + "_Отображение";
		КонецЕсли;
	КонецЦикла;

	// Добавление "невидимых аналитик".
	Для Каждого КодАналитики Из ВсеАналитики Цикл
		СтрРеквизит = ЗапрашиваемыеРеквизиты.Добавить();
		СтрРеквизит.ПолеЗапроса = КодАналитики;
		СтрРеквизит.Псевдоним   = КодАналитики;
		СтрРеквизит.ДобавитьПредставление = Истина;
	КонецЦикла;
	
	СтрПоляЗапроса = "";
	ЗапрашиваемыеРеквизиты.Свернуть("ПолеЗапроса,Псевдоним,ДобавитьПредставление");
	
	Для Каждого СтрРеквизит Из ЗапрашиваемыеРеквизиты Цикл
		
		СтрПоляЗапроса = СтрПоляЗапроса + ",
		|	" + СтрРеквизит.ПолеЗапроса + " КАК " + СтрРеквизит.Псевдоним;
		
		Если СтрРеквизит.ДобавитьПредставление Тогда
			
			СтрПоляЗапроса = СтрПоляЗапроса + ",
			|	ПРЕДСТАВЛЕНИЕ(" + СтрРеквизит.ПолеЗапроса + ") КАК " + СтрРеквизит.Псевдоним + "_Представление";
			
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	|	ТаблицаРаскрытия.*
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ 
	|	&ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ "
	+ Сред(СтрПоляЗапроса,2) + "
	|ИЗ
	|	ТаблицаРаскрытия";
	
	Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаРаскрытия);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	//если сортировать в запросе, то в серверной базе падает при большом количестве колонок в таблице раскрытия
	ТаблицаРезультата.Сортировать("ID"); 
	
	Возврат ТаблицаРезультата;
	
КонецФункции // ПолучитьДополнительныеДанныеДляТаблицыРаскрытия()

Функция СформироватьСтруктуруКонтекста(РеквизитыОтчета = "")

	Контекст = СтруктураРеквизитовОтчета(РеквизитыОтчета);
	
	Контекст.Вставить("мПоказатели"				,мПоказатели);
	Контекст.Вставить("мПоказателиРаскрытия"	,мПоказателиРаскрытия);
	Контекст.Вставить("мДополнительныеРеквизиты",мДополнительныеРеквизиты);
	Контекст.Вставить("мЧислоДопАналитик"		,мЧислоДопАналитик);
	
	Возврат Контекст;

КонецФункции // ПоместитьКонтекстВСтруктуру()

Функция СтруктураРеквизитовОтчета(РеквизитыОтчета = "")
	
	Контекст = Новый Структура;
	
	Если РеквизитыОтчета = Неопределено Тогда
		// Добавим все реквизиты
		Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
			Если Лев(Реквизит.Имя,7) <> "Удалить" Тогда
				Контекст.Вставить(Реквизит.Имя, ЭтотОбъект[Реквизит.Имя]);
			КонецЕсли;
		КонецЦикла;
		
		Контекст.Вставить("Дата" ,Дата);
		Контекст.Вставить("Номер",Номер);
		
	ИначеЕсли Не ПустаяСтрока(РеквизитыОтчета) Тогда
		
		МассивИмен = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(РеквизитыОтчета);
		Для Каждого Имя Из МассивИмен Цикл
			ТекИмя = СокрЛП(Имя);
			Контекст.Вставить(ТекИмя,ЭтотОбъект[ТекИмя]);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Контекст;
	
КонецФункции // СтруктураРеквизитовОтчета()

// Отражает частичные изменения в таблицах отчета.
//
Процедура ПрименитьИзмененияТаблицыРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, ИзмененныеСтроки, ИзмененныеКолонки = Неопределено) Экспорт

	Перем СтрокиРаскрытия;
	
	// Подготовка параметров.
	
	Если ТипЗнч(ИзмененныеСтроки) = Тип("СтрокаТаблицыЗначений") Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(ИзмененныеСтроки);
		СтрокиРаскрытия = ТаблицаРаскрытия.Скопировать(МассивСтрок);
	Иначе
		СтрокиРаскрытия = ТаблицаРаскрытия.Скопировать(ИзмененныеСтроки);
	КонецЕсли;
	
	Если СтрокиРаскрытия.Колонки.Найти("ПромежуточныеИтоги") = Неопределено Тогда
		СтрокиРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	ПоказателиГруппы = мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	
	Если ИзмененныеКолонки = Неопределено Тогда
		ИзмененныеКолонки = Новый Массив;
		
		Для Сч = 1 По мЧислоДопАналитик Цикл
			Если Не ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ИзмененныеКолонки.Добавить("Аналитика"+Сч);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрПоказатель Из ПоказателиГруппы Цикл
			Если Не ТаблицаРаскрытия.Колонки.Найти(СтрПоказатель.Код) = Неопределено Тогда
				ИзмененныеКолонки.Добавить(СтрПоказатель.Код);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ИзмененныеАналитики = Новый Массив;
	Для Сч = 1 По мЧислоДопАналитик Цикл
		Если ИзмененныеКолонки.Найти("Аналитика" + Сч) <> Неопределено Тогда
			ИзмененныеАналитики.Добавить("Аналитика" + Сч);
		КонецЕсли;
	КонецЦикла;
	
	// Обработка данных.
	Для Каждого СтрПоказатель Из ПоказателиГруппы Цикл
		
		ЕстьИзмененияПоказателя = ИзмененныеКолонки.Найти(СтрПоказатель.Код) <> Неопределено;
		
		Если ИзмененныеАналитики.Количество() > 0 или ЕстьИзмененияПоказателя Тогда
			
			Для Каждого СтрРаскрытия Из СтрокиРаскрытия Цикл
				РаскрытиеПоказателя = мПоказателиРаскрытия.НайтиСтроки(Новый Структура("Показатель,Индекс",СтрПоказатель.Ссылка,СтрРаскрытия.Индекс));
				
				Если РаскрытиеПоказателя.Количество() = 0 Тогда
					СтрДанныхРаскрытия = мПоказателиРаскрытия.Добавить();
					СтрДанныхРаскрытия.Показатель = СтрПоказатель.Ссылка;
					СтрДанныхРаскрытия.ГруппаРаскрытия = ГруппаРаскрытия;
					
					Для Сч = 1 По мЧислоДопАналитик Цикл
						ИмяАналитики = "Аналитика" + Сч;
						Если ТаблицаРаскрытия.Колонки.Найти(ИмяАналитики) <> Неопределено Тогда
							СтрДанныхРаскрытия[ИмяАналитики] = СтрРаскрытия[ИмяАналитики];
						КонецЕсли;
					КонецЦикла;
					
					СтрДанныхРаскрытия.Индекс = СтрРаскрытия.Индекс;
				Иначе
					
					СтрДанныхРаскрытия = РаскрытиеПоказателя[0];
					
					Для Каждого ИмяАналитики Из ИзмененныеАналитики Цикл
						СтрДанныхРаскрытия[ИмяАналитики] = СтрРаскрытия[ИмяАналитики];
					КонецЦикла;
					
				КонецЕсли;
				
				СтрДанныхРаскрытия.Значение 		 = СтрРаскрытия[СтрПоказатель.Код];
				СтрДанныхРаскрытия.ПромежуточныйИтог = (Найти(СтрРаскрытия.ПромежуточныеИтоги,","+СтрПоказатель.Код+",") > 0);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры // ПрименитьИзмененияТаблицыРаскрытия()

