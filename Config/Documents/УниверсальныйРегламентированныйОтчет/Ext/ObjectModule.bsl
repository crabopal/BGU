			СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
			
		Исключение
			ноСообщить("Во время исполнения процедуры вычисления параметра "+СокрЛП(СтрокаПараметр.ПредставлениеПараметра)+"
			|произошла следующая критическая ошибка:" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит Тогда
		
		СтрРеквизит=мДополнительныеРеквизиты.Найти(СтрокаПараметр.ВидАналитикиОтбор,"ВидАналитики");
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.Равно;
		
		Если СтрРеквизит<>Неопределено Тогда 
			
