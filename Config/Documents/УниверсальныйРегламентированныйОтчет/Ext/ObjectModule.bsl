// ОБРАБОТЧИКИ СОБЫТИЙ ОБЪЕКТА

// Процедура - обработчик события объекта "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если БюджетнаяОтчетность.ВыполняетсяЗагрузкаКомплекта() Тогда
		БюджетнаяОтчетность.СообщениеПриЗагрузкеКомплекта();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	мУдалятьДвижения = НЕ ЭтоНовый();	
	
	// Если состояние не устанавливалось, значит оно и не изменялось
	Если Состояние = Перечисления.СостоянияОтчетов.ПустаяСсылка() Тогда
		Состояние = Перечисления.СостоянияОтчетов.Запланирован;
	КонецЕсли;
	
	ПоследнийРедактировавший = Пользователи.АвторизованныйПользователь();
	
	Если Не ПроверкаПриЗаписи Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(мПоказатели) <> Тип("ТаблицаЗначений") Тогда
		ФормированиеДвиженийПриЗаписи = Ложь;
		// Это запись неинициализированного объекта.
		// Скорее всего, это снятие пометки удаления в списке документов,
		// либо программная запись не требующая изменения регистров.
	Иначе
		// Установка строкового описания реквизитов отчета.
		СформироватьОписаниеАналитики();
		
		Если Не ЗначениеЗаполнено(ИзмененияВДиалоге) или ИзмененияВДиалоге = Истина Тогда
			Если Состояние <> Перечисления.СостоянияОтчетов.Запланирован и 
				 Состояние <> Перечисления.СостоянияОтчетов.Выполняется Тогда
			
				ЕстьОшибки = Ложь;
				
				ТекстСообщения = "";
				Если НЕ ПроверитьЗаполненностьОбязательныхАналитик() Тогда
					ЕстьОшибки = Истина;
				КонецЕсли;
				
				ТекстСообщения = "";		
				Если НЕ ОбязательныеРеквизитыЗаполнены() Тогда
					ЕстьОшибки = Истина;
				КонецЕсли;
				
				Если ЕстьОшибки Тогда
					ДополнительныеСвойства.Вставить("ОбнаруженыОшибкиПриЗаписи",Истина);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИзмененияВДиалоге) и Не ИзмененияВДиалоге Тогда
		Возврат; // Не было изменений.
	КонецЕсли;
	
	Если Не Отказ Тогда
		ДатаИзменения = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

// Обновляет значение реквизита ОписаниеАналитики.
//
Процедура СформироватьОписаниеАналитики() Экспорт

	ПроверитьКонтекстИнициализирован();
	
	Если мДополнительныеРеквизиты.Количество() > 0 Тогда
		мДополнительныеРеквизиты.Сортировать("ПорядковыйНомер");
		
		КодыВидовАналитики = БюджетнаяОтчетность.КодыВидовАналитики(мДополнительныеРеквизиты.ВыгрузитьКолонку("ВидАналитики"));
		
		СтрокаРеквизиты = "";
		
		Для Каждого СтрРеквизит Из мДополнительныеРеквизиты Цикл
			СтрокаРеквизиты = СтрокаРеквизиты + ", " + КодыВидовАналитики[СтрРеквизит.ВидАналитики] + ":" + Строка(СтрРеквизит.Значение);
		КонецЦикла;
		
		ОписаниеАналитики = Сред(СтрокаРеквизиты,3);
		
	КонецЕсли;

КонецПроцедуры // СформироватьОписаниеАналитики()

Функция ПроверитьУникальностьОтчета()
	
	Если Константы.КонтролироватьУникальностьРегБухОтчетов.Получить() <> Истина Тогда
	
		Возврат Истина;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
		Запрос.УстановитьПараметр("ЗначенияИзКонтекста", мДополнительныеРеквизиты);
		Запрос.УстановитьПараметр("ВидОтчета"   ,ВидОтчета);
		Запрос.УстановитьПараметр("Организация" ,Организация);
		Запрос.УстановитьПараметр("ПериодОтчета",ПериодОтчета);
		Запрос.УстановитьПараметр("ИФО",ИФО);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияИзКонтекста.ВидАналитики КАК ВидАналитики,
		|	ЗначенияИзКонтекста.Значение КАК Значение,
		|	&Ссылка КАК ЭкземплярОтчета
		|ПОМЕСТИТЬ ЗначенияИзКонтекста
		|ИЗ
		|	&ЗначенияИзКонтекста КАК ЗначенияИзКонтекста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УниверсальныйРегламентированныйОтчет.Ссылка КАК Ссылка,
		|	УниверсальныйРегламентированныйОтчет.ВидОтчета КАК ВидОтчета
		|ПОМЕСТИТЬ ПотенциальныеДубликаты
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
		|ГДЕ
		|	УниверсальныйРегламентированныйОтчет.Организация = &Организация
		|	И УниверсальныйРегламентированныйОтчет.ПериодОтчета = &ПериодОтчета
		|	И УниверсальныйРегламентированныйОтчет.ВидОтчета = &ВидОтчета
		|	И УниверсальныйРегламентированныйОтчет.ПометкаУдаления = Ложь
		|	И &УсловиеИФО
		|	И УниверсальныйРегламентированныйОтчет.Ссылка <> &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК Поле1
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ПотенциальныеДубликаты.Ссылка КАК Ссылка,
		|		МИНИМУМ(ВЫБОР
		|				КОГДА ЗначенияРеквизитов.ВидАналитики = ЗначенияТекущихРеквизитов.ВидАналитики
		|						И ЗначенияРеквизитов.Значение = ЗначенияТекущихРеквизитов.Значение
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК Совпадение
		|	ИЗ
		|		ПотенциальныеДубликаты КАК ПотенциальныеДубликаты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияРеквизитов
		|			ПО ПотенциальныеДубликаты.Ссылка = ЗначенияРеквизитов.ЭкземплярОтчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗначенияИзКонтекста КАК ЗначенияТекущихРеквизитов
		|			ПО (ЗначенияТекущихРеквизитов.ЭкземплярОтчета = &Ссылка)
		|				И (ЗначенияТекущихРеквизитов.ВидАналитики = ЗначенияРеквизитов.ВидАналитики)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ПотенциальныеДубликаты.Ссылка
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		Совпадение УБЫВ) КАК Запрос
		|ГДЕ
		|	Запрос.Совпадение = 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	ПотенциальныеДубликаты КАК ПотенциальныеДубликаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеРеквизитыОтчетов КАК ДопРеквизиты
		|		ПО ПотенциальныеДубликаты.ВидОтчета = ДопРеквизиты.Владелец
		|ГДЕ
		|	ДопРеквизиты.Ссылка ЕСТЬ NULL";
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ТекстУсловиеИФО = "УниверсальныйРегламентированныйОтчет.ИФО = &ИФО";
		Иначе
			ТекстУсловиеИФО = "ИСТИНА";
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеИФО",ТекстУсловиеИФО);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		НайденыДублиОтчета = Не РезультатЗапроса.Пустой();
		Если НайденыДублиОтчета Тогда
			ОбщегоНазначения.СообщитьПользователю("- Отчет с такими параметрами уже существует в информационной базе. Запись невозможна.");
		КонецЕсли;
		
		Возврат (НЕ НайденыДублиОтчета);
	
	КонецЕсли;
	
КонецФункции

Процедура УстановитьБлокировкуДвиженийДокумента()

	БюджетнаяОтчетностьСервер.УстановитьБлокировкуДвиженийДокумента(Ссылка);
	
КонецПроцедуры

// Записать данные в регистр сведений ДанныеРасчетовПоказателей
//
Процедура ЗаписатьДанныеРасчетов(ДанныеДляЗаписи) Экспорт

	мВнутренниеДанныеРасчетов = ДанныеДляЗаписи;
	УстановитьПризнакИзмененияДанныхРасчета(Истина);

КонецПроцедуры

Процедура ЗаписатьДанныеРасчетовВБазуДанных()

	Если ВнутренниеДанныеРасчетаИзменены() = Истина Тогда
		
		НаборЗаписейРасчеты = РегистрыСведений.ДанныеРасчетовПоказателей.СоздатьНаборЗаписей();
		НаборЗаписейРасчеты.Отбор.ЭкземплярОтчета.Установить(Ссылка);
		
		Если Не мВнутренниеДанныеРасчетов = Неопределено Тогда
			Запись = НаборЗаписейРасчеты.Добавить();
			Запись.ЭкземплярОтчета = Ссылка;
			Запись.ДанныеРасчетов  = Новый ХранилищеЗначения(мВнутренниеДанныеРасчетов,Новый СжатиеДанных(9));
		КонецЕсли;
		
		НаборЗаписейРасчеты.Записать();
		
	КонецЕсли;

КонецПроцедуры

// Процедура - обработчик события объекта "ПриЗаписи".
//
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда // Проверки и запись движений в регистр не осуществляется.
		Возврат;
	КонецЕсли;
	
	мУдалятьДвижения = НЕ ЭтоНовый();
	
	// Запись движений документа
	Если ЗначениеЗаполнено(ИзмененияВДиалоге) Тогда
		Если НЕ ИзмененияВДиалоге Тогда //Документ был открыт и не изменен
			// отменяем проверки и движения.			
			ФормированиеДвиженийПриЗаписи = Ложь;
		Иначе
			ФормированиеДвиженийПриЗаписи = Истина;
		КонецЕсли;
	Иначе
		
		// Записывается не из формы		
		Если ПометкаУдаления Тогда // только меняем активность
			Возврат;			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ФормированиеДвиженийПриЗаписи Тогда
		
		УстановитьБлокировкуДвиженийДокумента();
		
		Если Не ПроверитьУникальностьОтчета() Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Контекст = СформироватьСтруктуруКонтекста("ВидОтчета");
		
		БюджетнаяОтчетностьСервер.ЗаписатьДвиженияУниверсальногоОтчета(Ссылка,Контекст,мУдалятьДвижения);
		ЗаписатьДанныеРасчетовВБазуДанных();
		
	КонецЕсли;	
	
КонецПроцедуры

