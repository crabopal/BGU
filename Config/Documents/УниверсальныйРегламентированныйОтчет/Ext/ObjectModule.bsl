	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.Подобно Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.ВСписке;
		НастройкаПараметра = СтрокаПараметр.УточнениеСпособаОпределения.Получить();
		
		Если мСоответствиеСтроковыхБК[СтрокаПараметр.ВидАналитикиОтбор] = Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаПараметр.РеквизитАналитики) И ЗначениеЗаполнено(СтрокаПараметр.ВидАналитикиОтбор) Тогда
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбора(НастройкаПараметра);
			Иначе
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораПоРеквизиту(НастройкаПараметра," Подобно ",СтрокаПараметр.РеквизитАналитики,СтрокаПараметр.ВидАналитикиОтбор);
			КонецЕсли;
		Иначе
			СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораБК(СокрЛП(НастройкаПараметра), "ПОДОБНО", СтрокаПараметр.ВидАналитикиОтбор);
		КонецЕсли;
		
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеПодобно Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.НеВСписке;
		НастройкаПараметра = СтрокаПараметр.УточнениеСпособаОпределения.Получить();
		
		Если мСоответствиеСтроковыхБК[СтрокаПараметр.ВидАналитикиОтбор] = Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаПараметр.РеквизитАналитики) И ЗначениеЗаполнено(СтрокаПараметр.ВидАналитикиОтбор) Тогда
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбора(НастройкаПараметра);
			Иначе
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораПоРеквизиту(НастройкаПараметра," Подобно ",СтрокаПараметр.РеквизитАналитики,СтрокаПараметр.ВидАналитикиОтбор);
			КонецЕсли;
		Иначе
			СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораБК(СокрЛП(НастройкаПараметра), "ПОДОБНО", СтрокаПараметр.ВидАналитикиОтбор);
		КонецЕсли;
		
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПодобноСписку Тогда
		
		СвойстваПараметра.ВидСравнения=ВидСравнения.ВСписке;
		НастройкаПараметра = СтрокаПараметр.УточнениеСпособаОпределения.Получить();
		
		Если мСоответствиеСтроковыхБК[СтрокаПараметр.ВидАналитикиОтбор] = Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаПараметр.РеквизитАналитики) И ЗначениеЗаполнено(СтрокаПараметр.ВидАналитикиОтбор) Тогда
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбора(НастройкаПараметра);
			Иначе
				СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораПоРеквизиту(НастройкаПараметра," Подобно ",СтрокаПараметр.РеквизитАналитики,СтрокаПараметр.ВидАналитикиОтбор);
			КонецЕсли;
		Иначе
			СвойстваПараметра.Значение = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбораБКПодобноСписку(НастройкаПараметра, СтрокаПараметр.ВидАналитикиОтбор);
		КонецЕсли;
		
		СтрокаПараметр.ЗначениеИзКонтекста=СвойстваПараметра.Значение;
		
