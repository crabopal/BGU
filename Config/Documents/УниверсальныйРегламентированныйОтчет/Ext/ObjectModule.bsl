// ФУНКЦИИ ПОЛУЧЕНИЯ ФИНАНСОВЫХ ДАННЫХ
//

// Функция устанавливает значение показателя раскрытия.
//
// Параметры:
//	КодПоказателя - код изменяемого показателя;
//	Значение - устанавливаемое значение;
//	АналитикаN - значения аналитик.
//
// Возвращаемое значение - булево:
//			Истина	- удалось установить значение;
//			Ложь	- не удалось установить значение (не удалось найти показатель с таким кодом).
//
Функция УстановитьЗначениеПоказателя(КодПоказателя, Значение, Аналитики = Неопределено) Экспорт
	
	Если Аналитики = Неопределено Тогда
		Аналитики = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(КодПоказателя) = Тип("Строка") Тогда							 
		СтрокаОписанияПоказателя = мПоказатели.Найти(КодПоказателя, "Код");
		Если СтрокаОписанияПоказателя = Неопределено Тогда
			ноСообщить("Ошибка установки значения показателя: показатель с кодом """ + КодПоказателя + """ не найден!", СтатусСообщения.Важное);
			Возврат Ложь;
		КонецЕсли;
		Показатель = СтрокаОписанияПоказателя.Ссылка;
	Иначе
		Показатель = КодПоказателя;
		СтрокаОписанияПоказателя = мПоказатели.Найти(КодПоказателя, "Ссылка");
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаОписанияПоказателя.КодГруппыРаскрытия) Тогда
		ноСообщить("Ошибка установки значения показателя: для показателя с кодом """ + КодПоказателя + """ не определена группа раскрытия!", СтатусСообщения.Важное);
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	КолонкиСвертки = "";
	
	Для Сч = 1 По мЧислоДопАналитик Цикл
		
		ТекЗначениеАналитики = Неопределено;
		Если Аналитики.Свойство("Аналитика"+Сч,ТекЗначениеАналитики) Тогда
			СтруктураПоиска.Вставить("Аналитика"+Сч,Аналитики["Аналитика"+Сч]);
		КонецЕсли;
		
		КолонкиСвертки = КолонкиСвертки + "," + "Аналитика"+Сч;
		
	КонецЦикла;
	
	СтрокиРаскрытия = мПоказателиРаскрытия.Скопировать(СтруктураПоиска);
	
	СтрокаЭтогоПоказателя = СтрокиРаскрытия.Найти(Показатель,"Показатель");
	Если СтрокаЭтогоПоказателя = Неопределено Тогда
		
		Если СтрокиРаскрытия.Количество() = 0 Тогда
			КопияРаскрытия = ВыбратьРаскрытиеПоГруппе(СтрокаОписанияПоказателя.ГруппаРаскрытия);
			КопияРаскрытия.Свернуть(КолонкиСвертки);
			Индекс = КопияРаскрытия.Количество() + 1;
		Иначе // Такое раскрытие уже есть в таблице, нужно взять его индекс
			Индекс = СтрокиРаскрытия[0].Индекс;
		КонецЕсли;
		
		СтрокаЭтогоПоказателя = мПоказателиРаскрытия.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЭтогоПоказателя,СтруктураПоиска);
		
		СтрокаЭтогоПоказателя.Индекс 	 = Индекс;
		СтрокаЭтогоПоказателя.Значение   = Значение;
		СтрокаЭтогоПоказателя.Показатель = Показатель;
		СтрокаЭтогоПоказателя.ГруппаРаскрытия = СтрокаОписанияПоказателя.ГруппаРаскрытия;
		
	Иначе
		
		СтруктураПоиска.Вставить("Показатель",Показатель);
		СтрокиЭтогоПоказателя = мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
		СтрокаЭтогоПоказателя = СтрокиЭтогоПоказателя[0];
		СтрокаЭтогоПоказателя.Значение = Значение;
		
	КонецЕсли;
		
	
	МассивКодов=Новый Массив;
	МассивКодов.Добавить(КодПоказателя);
	УстановитьИтогиПоПоказателям(МассивКодов);
	
	Возврат Истина;
	
КонецФункции

// Функция устанавливает значение показателя раскрытия без вычисления номера строки.
//
// Параметры:
//	КодПоказателя - код изменяемого показателя;
//	Значение - устанавливаемое значение;
//	АналитикаN - значения аналитик.
//
// Возвращаемое значение - добавленая строка раскрытия
//
Функция ДобавитьСтрокуРаскрытияПоказателя(КодПоказателя, Значение, Аналитики = Неопределено) Экспорт
	
	Если Аналитики = Неопределено Тогда
		Аналитики = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(КодПоказателя) = Тип("Строка") Тогда							 
		СтрокаОписанияПоказателя = мПоказатели.Найти(КодПоказателя, "Код");
		Если СтрокаОписанияПоказателя = Неопределено Тогда
			ноСообщить("Ошибка установки значения показателя: показатель с кодом """ + КодПоказателя + """ не найден!", СтатусСообщения.Важное);
			Возврат Неопределено;
		КонецЕсли;
		Показатель = СтрокаОписанияПоказателя.Ссылка;
	Иначе
		Показатель = КодПоказателя;
		СтрокаОписанияПоказателя = мПоказатели.Найти(КодПоказателя, "Ссылка");
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаОписанияПоказателя.КодГруппыРаскрытия) Тогда
		ноСообщить("Ошибка установки значения показателя: для показателя с кодом """ + КодПоказателя + """ не определена группа раскрытия!", СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаРаскрытия = мПоказателиРаскрытия.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРаскрытия,Аналитики);
	
	СтрокаРаскрытия.Показатель = Показатель;
	СтрокаРаскрытия.Значение   = Значение;	
	СтрокаРаскрытия.ГруппаРаскрытия  = СтрокаОписанияПоказателя.ГруппаРаскрытия;
	
	Возврат СтрокаРаскрытия;
	
КонецФункции

// Очищает значения показателей и примечания к ним, раскрытия, а также реквизиты объекта, хранящие
// значения ссылки на импортируемый файл и его версию.
//
Процедура ОчиститьВсе(ВнешнееОбращение = Ложь) Экспорт
	
	Если Не УстановитьБлокировку() Тогда
		Возврат;
	КонецЕсли;
	
	ПоказателиЭтоСтруктура = (ТипЗнч(Показатели) = Тип("Структура"));
	
	ПроверитьКонтекстИнициализирован();
	Если ПоказателиЭтоСтруктура Тогда
		СформироватьСтруктуруИзмененныхПоказателей();
	КонецЕсли;
		
	Для Каждого Стр Из мПоказатели Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Стр.Значение = ПустоеЗначениеПоТипу[Стр.ТипЗначения];
		Если ПоказателиЭтоСтруктура Тогда
			Показатели.Вставить(Стр.Код, Стр.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВнешнееОбращение Тогда
		мПоказатели.ЗаполнитьЗначения(Истина,"СохраненныеДанныеАктуальны");
	КонецЕсли;
	
	мПоказателиРаскрытия.Очистить();
	
	ЗаписатьДанныеРасчетов(Неопределено);
	
	ФайлИмпорта 		= Неопределено;
	ДатаИзменения 		= ТекущаяДатаСеанса();
	мДокументОснование 	= Неопределено;
	
КонецПроцедуры 

// Возвращает итоговое значение из переданной таблицы значений,
// свернутой по необходимым аналитикам
// Параметры:
//	ТаблицаЗначений - исходная таблица значений;
//  СтрАналитики - строка с именами колонок аналитики для свертки
//  КолонкаИтог - имя колонки, по которой ищется итоговое значение
//  ВидИтога - значение перечисления ВидыИтоговПоказателя
//
Функция ТЗИтог(ТаблицаЗначений, СтрАналитики, КолонкаИтог, ВидИтога, ТипЗначения=Неопределено)
	
	// Удаление промежуточных итогов.
	Если ТаблицаЗначений.Колонки.Найти("ПромежуточныйИтог") <> Неопределено Тогда
		РабочаяТаблица = ТаблицаЗначений.Скопировать(Новый Структура("ПромежуточныйИтог",Ложь));
	Иначе
		РабочаяТаблица=ТаблицаЗначений.Скопировать();
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрАналитики) Тогда
		РабочаяТаблица.Свернуть(СтрАналитики,КолонкаИтог);
	КонецЕсли;
	
	
	Если РабочаяТаблица.Количество()=0 Тогда
		
		Возврат 0;
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Минимум Тогда 
		
		РабочаяТаблица.Сортировать(КолонкаИтог+" Возр");
		Возврат РабочаяТаблица[0][КолонкаИтог];
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Максимум Тогда
		
		РабочаяТаблица.Сортировать(КолонкаИтог+" Убыв");
		Возврат РабочаяТаблица[0][КолонкаИтог];
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Среднее Тогда
		
		Возврат РабочаяТаблица.Итог(КолонкаИтог)/РабочаяТаблица.Количество();
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Сумма ИЛИ ВидИтога=Перечисления.ВидыИтоговПоказателя.ПустаяСсылка() Тогда // По умолчанию также возвращаем сумму
		
		Если ТипЗначения=Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
			
			Если РабочаяТаблица.Количество()=0 Тогда
				Возврат Ложь;
			Иначе
				
				ТекЗначение=РабочаяТаблица[0][КолонкаИтог];
				
				Для Индекс=1 по РабочаяТаблица.Количество()-1 Цикл
					
					ТекЗначение=ТекЗначение И РабочаяТаблица[Индекс][КолонкаИтог];
					
				КонецЦикла;
				
				Возврат ТекЗначение;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗначения=Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
			
			ТекЗначение=""+РабочаяТаблица[0][КолонкаИтог];
			
			Для Индекс=1 по РабочаяТаблица.Количество()-1 Цикл
				
				ТекЗначение=ТекЗначение+РабочаяТаблица[Индекс][КолонкаИтог];
				
			КонецЦикла;
			
			Возврат ТекЗначение;
			
		Иначе
			
			Возврат РабочаяТаблица.Итог(КолонкаИтог);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ТЗМинимум()

Процедура УстановитьИтогиПоПоказателям(МассивПоказатели = Неопределено) Экспорт
	
	//Установить итоги можно только в случае, если у вида отчета есть хотя бы 1 группа раскрытия.
	//Если групп раскрытия нет, выполнять не требуется.
	Если НЕ ЕстьГруппаРаскрытия(ВидОтчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьПолностьюТаблицу = МассивПоказатели = Неопределено;
	
	Если ОбработатьПолностьюТаблицу Тогда
		МассивПоказатели = мПоказатели;
	КонецЕсли;
	
	СохранитьЗначенияПоказателей();
	
	// Заполним итоговые значения
	Для Каждого КодПоказатель ИЗ МассивПоказатели Цикл
		
		Если НЕ ОбработатьПолностьюТаблицу Тогда
			Если ТипЗнч(КодПоказатель) = Тип("Строка") Тогда
				
				ПоказательОтчета=мПоказатели.Найти(КодПоказатель,"Код");
				
			Иначе
				
				ПоказательОтчета=мПоказатели.Найти(КодПоказатель,"Ссылка");
				
			КонецЕсли;
			
			Если ПоказательОтчета=Неопределено ИЛИ ПоказательОтчета.ВидИтога=Перечисления.ВидыИтоговПоказателя.НеРассчитывается Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			ПоказательОтчета = КодПоказатель;
		КонецЕсли;
		
		Если ПустаяСтрока(ПоказательОтчета.КодГруппыРаскрытия) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ПоказательОтчета.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается Тогда
			Продолжить;
		КонецЕсли;
				
		МассивПоказатель=мПоказателиРаскрытия.НайтиСтроки(Новый Структура("Показатель",ПоказательОтчета.Ссылка));
		ТекТабПоказатели=мПоказателиРаскрытия.СкопироватьКолонки("Значение,ПромежуточныйИтог");
		
		Если МассивПоказатель.Количество()=0 Тогда
			
			ТекТабПоказатели.Добавить();
			
		КонецЕсли;		
		
		Для Каждого Строка ИЗ МассивПоказатель Цикл
			
			НоваяСтрока=ТекТабПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
		ПоказательОтчета.Значение		 = ТЗИтог(ТекТабПоказатели, , "Значение", ПоказательОтчета.ВидИтога,ПоказательОтчета.ТипЗначения);
		Показатели[ПоказательОтчета.Код] = ПоказательОтчета.Значение;
		
		ПоказательОтчета.СохраненныеДанныеАктуальны = Ложь;
		ПоказательОтчета.ДанныеРасчета = Неопределено;
		
		ТекТабПоказатели = Неопределено;
		
	КонецЦикла;
	
	ПроверитьИзменениеПоказателей();
	
КонецПроцедуры // 

// Вспомогательная функция для определения промежуточных итогов в формулах.
//
// Возвращаемое значение:
//   Истина, если значение показателя представляет собой промежуточный итог.
//
Функция ЭтоПромежуточныйИтог(СтрокаРасчета, ИндексыПромежуточныхИтогов = Неопределено, КодПоказателя = Неопределено)

	ПромежуточныеИтоги = ИндексыПромежуточныхИтогов[СтрокаРасчета.Индекс];
	
	Если ПромежуточныеИтоги <> Неопределено
		И Найти(ПромежуточныеИтоги,","+КодПоказателя+",") > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЭтоПромежуточныйИтог()

Функция ПолучитьПутьВычисления(КодПоказателя) Экспорт
	
	Если мДеревоПересчета=Неопределено Тогда
		ПодготовитьДанныеПараметрическойНастройки();
		Если мДеревоПересчета = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПоиска=Новый Структура;
	СтруктураПоиска.Вставить("КодПоказателя",КодПоказателя);
	
	МассивСтрок=мДеревоПересчета.Строки.НайтиСтроки(СтруктураПоиска,Истина);
	
	Если МассивСтрок.Количество()=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивКодовПоказателей = Новый Массив;
	ТабУпорядочивания	   = мПоказателиДляОбработки.СкопироватьКолонки("Код,Порядок");
	
	Для Каждого НачСтрока ИЗ МассивСтрок Цикл
		
		ПолучитьСписокРодителей(НачСтрока,МассивКодовПоказателей);
		
	КонецЦикла;
	
	Для Каждого КодПок Из МассивКодовПоказателей Цикл
		СтрПоказательОбработки = мПоказателиДляОбработки.Найти(КодПок,"Код");
		Если Не СтрПоказательОбработки = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТабУпорядочивания.Добавить(),СтрПоказательОбработки);
		КонецЕсли;
	КонецЦикла;
	
	ТабУпорядочивания.Сортировать("Порядок");
	МассивКодовПоказателей = ТабУпорядочивания.ВыгрузитьКолонку("Код");
	
	Если мМассивДополнительныхПоказателейДляВычисления = Неопределено Тогда
		
		мМассивДополнительныхПоказателейДляВычисления = Новый Массив;
		// показатели, рассчитывающиеся на основании показателей текущего отчета
		// и имеющие в формуле абсолютные значения
	
		СтруктураПоиска=Новый Структура;
		СтруктураПоиска.Вставить("ПоказателиТекущегоОтчета",Истина);
		СтруктураПоиска.Вставить("ЕстьАбсолютныеЗначения",Истина);
		
		МассивСтрок=мПоказателиДляОбработки.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого СтрПоказатель ИЗ МассивСтрок Цикл
			
			Если мМассивДополнительныхПоказателейДляВычисления.Найти(СтрПоказатель.Код)=Неопределено Тогда 
				
				мМассивДополнительныхПоказателейДляВычисления.Добавить(СтрПоказатель.Код);
				
				СтруктураПоиска=Новый Структура;
				СтруктураПоиска.Вставить("КодПоказателя",СтрПоказатель.Код);
				
				МассивИсходных=мДеревоПересчета.Строки.НайтиСтроки(СтруктураПоиска,Истина);
				
				Если МассивИсходных.Количество()=0 Тогда
					Продолжить;
					
				Иначе
					
					Для Каждого НачСтрока ИЗ МассивИсходных Цикл
						
						ПолучитьСписокРодителей(НачСтрока,мМассивДополнительныхПоказателейДляВычисления);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	
		// Добавим вычисляемые показатели, имеющие в формуле абсолютные значения.
			
		СтруктураПоиска=Новый Структура;
		СтруктураПоиска.Вставить("СпособОбработки",Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление);
		СтруктураПоиска.Вставить("ЕстьАбсолютныеЗначения",Истина);
		
		МассивСтрок=мПоказателиДляОбработки.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого СтрПоказатель ИЗ МассивСтрок Цикл
		
			Если мМассивДополнительныхПоказателейДляВычисления.Найти(СтрПоказатель.Код)=Неопределено Тогда 
				
				мМассивДополнительныхПоказателейДляВычисления.Добавить(СтрПоказатель.Код);
				
				СтруктураПоиска=Новый Структура;
				СтруктураПоиска.Вставить("КодПоказателя",СтрПоказатель.Код);
				
				МассивИсходных=мДеревоПересчета.Строки.НайтиСтроки(СтруктураПоиска,Истина);
				
				Если МассивИсходных.Количество()=0 Тогда
					Продолжить;
					
				Иначе
					
					Для Каждого НачСтрока ИЗ МассивИсходных Цикл
						
						ПолучитьСписокРодителей(НачСтрока,мМассивДополнительныхПоказателейДляВычисления);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;			
	
	Возврат МассивКодовПоказателей;
	
КонецФункции // ПолучитьПутьВычисления()

Процедура ПолучитьСписокРодителей(Строка,МассивКодовПоказателей);
	
	Если НЕ Строка.Родитель=Неопределено Тогда
		
		Если МассивКодовПоказателей.Найти(Строка.Родитель.КодПоказателя)=Неопределено Тогда 
			
			МассивКодовПоказателей.Добавить(Строка.Родитель.КодПоказателя);
			
		КонецЕсли;
		
		ПолучитьСписокРодителей(Строка.Родитель,МассивКодовПоказателей);
		
	КонецЕсли;
	
КонецПроцедуры // ПолучитьСписокРодителей()

Функция СтрокаКДате(ПредставлениеДаты) Экспорт
	
	Возврат ПривестиКДате(ПредставлениеДаты, Новый ОписаниеТипов("Дата"));
	
КонецФункции

// Определяет период по указанной дате и периодичности
//
// Параметры
//  Дата		  - Дата - Искомая дата
//
//	ИмяРеквизитаДаты - Строка. Имя реквизита справочника Периоды
//
// Возвращаемое значение:
//   СправочникСсылка.Периоды - найденная или пустая ссылка.
//
Функция ПериодПоДате(Дата,ИмяРеквизитаДаты)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Периоды.Ссылка
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды." + ИмяРеквизитаДаты + " = &Дата";	
	Запрос.УстановитьПараметр("Дата",НачалоДня(Дата));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ПериодПоДате()

/////////////////////////////////////////////////////
// ФУНКЦИИ ПРОТОКОЛИРОВАНИЯ ОШИБОК ПРОВЕРКИ
//

// Функция предназначена для добавления группы сообщений в протокол проверки.
//
// Параметры
//  ИмяГруппы  			- Строка. Идентификатор по которому можно обращаться к группе
//
//  ПредставлениеГруппы - Строка. Пользовательское представление группы сообщений.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений. Строка таблицы, характеризующая группу сообщений.
//  						в дальнейшем, для вывода сообщений в группу 
//							можно использовать это значение.
//
Функция СоздатьГруппуСообщений(ИмяГруппы,ПредставлениеГруппы = "") Экспорт

	СтрГруппа = мСписокСообщенийПроцедурыПроверки.Найти(ИмяГруппы,"ИмяГруппы");
	Если СтрГруппа = Неопределено Тогда
		
		СтрГруппа = мСписокСообщенийПроцедурыПроверки.Добавить();
		СтрГруппа.ИмяГруппы 		  = ИмяГруппы;
		СтрГруппа.ПредставлениеГруппы = ?(ПустаяСтрока(ПредставлениеГруппы),ИмяГруппы,ПредставлениеГруппы);
		
		ТаблицаСообщений = Новый ТаблицаЗначений;
		ТаблицаСообщений.Колонки.Добавить("Текст");
		ТаблицаСообщений.Колонки.Добавить("ЯвляетсяОшибкой",Новый ОписаниеТипов("Булево"));
		ТаблицаСообщений.Колонки.Добавить("ЗначенияРасшифровки");
		
		ТаблицаСообщений.Индексы.Добавить("ЯвляетсяОшибкой");
		
		СтрГруппа.СообщенияГруппы = ТаблицаСообщений;
		
	КонецЕсли;
	
	Возврат СтрГруппа;
	
КонецФункции // СоздатьГруппуСообщений()

// Функция предназначена для добавления сообщения в группу сообщений.
//
// Параметры:
//  ТекстСообщения 	- Текст, который выводится в протокол проверки.
//
//  ЯвляетсяОшибкой - Булево. Признак того, что сообщение является ошибкой проверки отчета.
//                 	  Влияет на отображение сообщения в протоколе.
//
//	ГруппаСообщений - Группа сообщений, в которую помещается данное сообщение.
//
// Возвращаемое значение:
//   Объект сообщения. В дальнейшем может быть дополнен значениями расшифровки.
//		Тип: 	  СтрокаТаблицыЗначений
//		Свойства: Текст 			  - текст сообщения
//				  Является ошибкой    - признак того, что сообщение является ошибкой
//				  ЗначенияРасшифровки - Массив значений расшифровки
//
Функция ДобавитьСообщениеВПротоколПроверки(ТекстСообщения, ЯвляетсяОшибкой = Истина, ГруппаСообщений = Неопределено) Экспорт

	// Если группа не указана, то выполняется вывод в группу по-умолчанию
	Если ГруппаСообщений = Неопределено Тогда
		ГруппаСообщений = мСписокСообщенийПроцедурыПроверки.Найти("","ИмяГруппы");
		Если ГруппаСообщений = Неопределено Тогда
			ГруппаСообщений = СоздатьГруппуСообщений("","Проверка правильности заполнения отчета");
		КонецЕсли;
	КонецЕсли;
	
	Сообщение = ГруппаСообщений.СообщенияГруппы.Добавить();
	Сообщение.Текст 			  = ТекстСообщения;
	Сообщение.ЯвляетсяОшибкой     = ЯвляетсяОшибкой;
	Сообщение.ЗначенияРасшифровки = Новый Массив;
	
	Если Не ГруппаСообщений.СообщенияГруппы.Найти(Истина,"ЯвляетсяОшибкой") = Неопределено Тогда
		ГруппаСообщений.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат Сообщение;

КонецФункции // ДобавитьСообщениеВПротоколПроверки()

// Функция предназначена для формирования именованного расшифровываемого
// значения, которое может выводиться в сообщение протокола проверки отчета.
//
// Параметры:
//  ИмяЗначения  		 - Строка - Описание значения
//
//  Значение  	 		 - Значение, выводимое в протокол проверки.
//
//  ПараметрыРасшифровки - Параметры расшифровки значения (см. Функцию СоздатьПараметрыРасшифровки())
//
// Возвращаемое значение:
//   Структура расшифровываемого значения. 
//	 Ключи структуры совпадают с именами параметров данной функции.
//
Функция РасшифровываемоеЗначение(ИмяЗначения, Значение, ПараметрыРасшифровки = Неопределено) Экспорт

	Возврат Новый Структура("ИмяЗначения,Значение,ПараметрыРасшифровки",ИмяЗначения, Значение, ПараметрыРасшифровки);

КонецФункции // РасшифровываемоеЗначение()

// Функция предназначена для получения структуры параметров расшифровки
//
// Параметры
//  ЭкземплярыОтчетов - Массив или ссылка на документ УниверсальныйРегламентированныйОтчет
//                 		используется для определения источников данных расшифровки.
//  Показатель		  - Строка. Код показателя для расшифровки.
//
//	ОтборПоАналитике  - Структура с ключом АналитикаN - отбор аналитик расшифровки
//						Значением структуры является структура с ключами ВидСравнения и Значение
//						данную структуру проще всего получить функцией ЭлементОтбораРасшифровки()
//
// Возвращаемое значение:
//   Структура, описывающая расшифровку по данным отчетов ИБ.
//
Функция СоздатьПараметрыРасшифровки(ЭкземплярыОтчетов,Показатель,ОтборПоАналитике = Неопределено) Экспорт

	СтруктураРасшифровки = Новый Структура;
	
	МассивЭкземпляров = Новый Массив;
	Если ТипЗнч(ЭкземплярыОтчетов) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
		МассивЭкземпляров.Добавить(ЭкземплярыОтчетов);
	Иначе
		Для Каждого Экземпляр Из ЭкземплярыОтчетов Цикл
			МассивЭкземпляров.Добавить(Экземпляр);
		КонецЦикла;
	КонецЕсли;
	
	СтруктураРасшифровки.Вставить("ЭкземплярыОтчетов",МассивЭкземпляров);
	СтруктураРасшифровки.Вставить("Показатель"		 ,Показатель);
	СтруктураРасшифровки.Вставить("ОтборПоАналитике" ,ОтборПоАналитике);
	
	Возврат СтруктураРасшифровки;

КонецФункции // СоздатьПараметрыРасшифровки()

// Функция предназначена для создания структуры, необходимой для отбора в расшифровке.
//
Функция ЭлементОтбораРасшифровки(ВидСравнения, Значение) Экспорт
	
	Возврат Новый Структура("ВидСравнения,Значение",ВидСравнения,Значение);
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ЛОГОМ СООБЩЕНИЙ
//

// Проверка использования режима логирования.
//
Функция ЛогИнициализирован()

	Возврат Не ЛогСообщений = Неопределено;

КонецФункции // ЛогИнициализирован()

// Формирует описание источника ошибки для записи в лог.
//
Функция ОписаниеЭтогоОбъекта()

	Если Не ЭтоНовый() Тогда
		Возврат Ссылка;
	Иначе
		ТекстИсточника = "ДокументОбъект.УниверсальныйРегламентированныйОтчет
		|Контекст:
		|	Организация:	= " + Организация + "
		|	Период отчета:	= " + ПериодОтчета + "
		|	Вид отчета:		= " + ВидОтчета;
		Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") Тогда
			Для Каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
				ТекстИсточника = ТекстИсточника + "
				|	" + ДопРеквизит.Ключ + "	= " + ДопРеквизит.Значение;
			КонецЦикла;
		КонецЕсли;
		
		Возврат ТекстИсточника;
		
	КонецЕсли;

КонецФункции // ПолучитьИсточникОшибки()

// Добавление сообщения в лог.
//
Процедура ДобавитьСообщениевЛог(ТекстСообщения,Знач УровеньОшибки = Неопределено, Знач Источник = Неопределено, Событие = Неопределено, Публикуется = Ложь)
	
	Если ЛогИнициализирован() Тогда
		
		Сообщение = ЛогСообщений.СписокСообщений.Добавить();
		Сообщение.МоментВремени = ТекущаяДата();
		Сообщение.Уровень		= УровеньОшибки;
		Сообщение.Текст			= ТекстСообщения;
		Сообщение.Публикуется	= Публикуется;
		Если Источник = Неопределено Тогда
			Источник = Ссылка;
		КонецЕсли;
		Сообщение.Источник		= Источник;
		
		ПрефиксСобытия = "Универсальный регламентированный отчет";
		
		Если ЗначениеЗаполнено(Событие) Тогда
			Сообщение.Событие = ПрефиксСобытия + ". "+Строка(Событие);
		Иначе
			Сообщение.Событие = ПрефиксСобытия;
		КонецЕсли;
		
	Иначе
		#Если ВнешнееСоединение Тогда
			СписокСообщений.Добавить(ТекстСообщения); // web-клиент
		#Иначе
			Сообщить(ТекстСообщения,УровеньОшибки);
		#КонецЕсли
	КонецЕсли;
	
	
КонецПроцедуры // ДобавитьСообщениевЛог()

// Выполняет создание лога сообщений.
//
Процедура ИнициализироватьЛогСообщений() Экспорт

	СписокСообщенийОтчета = Новый ТаблицаЗначений;
	СписокСообщенийОтчета.Колонки.Добавить("МоментВремени",Новый ОписаниеТипов("Дата"));
	СписокСообщенийОтчета.Колонки.Добавить("Уровень");
	СписокСообщенийОтчета.Колонки.Добавить("Текст"		,Новый ОписаниеТипов("Строка"));
	СписокСообщенийОтчета.Колонки.Добавить("Источник");
	СписокСообщенийОтчета.Колонки.Добавить("Событие"		,Новый ОписаниеТипов("Строка"));
	СписокСообщенийОтчета.Колонки.Добавить("Публикуется"	,Новый ОписаниеТипов("Булево"));
	
	ЛогСообщений = Новый Структура;
	ЛогСообщений.Вставить("Владелец"		,ОписаниеЭтогоОбъекта());
	ЛогСообщений.Вставить("СписокСообщений"	,СписокСообщенийОтчета);
	
КонецПроцедуры // ИнициализироватьЛогСообщений()


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С МОДУЛЯМИ ШАБЛОНА
//

// Запускает модуль вычисления отчета на исполнение.
// Возвращает Истина, если модуль исполнился без ошибок и Ложь в противном случае.
//
Функция ЗапуститьМодульВычисления(МассивКодовПоказателей=Неопределено) Экспорт
	
	ВычислениеВыполнено = Истина;
	
	СохранитьЗначенияПоказателей();
	ОбработатьПоПараметрическойНастройке(Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление,МассивКодовПоказателей);
	
	Если ВычислениеВыполнено Тогда
		ПроверитьИзменениеПоказателей();
	КонецЕсли;
	
	Возврат ВычислениеВыполнено;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ АВТОМАТИЧЕСКОГО ЗАПОЛНЕНИЯ ОТЧЕТОВ
//

// Выполняет перенумерацию индекса строк раскрытия.
//
Процедура ВосстановитьНумерациюСтрокПоказателя(Знач ГруппаРаскрытия = Неопределено) Экспорт

	Если ГруппаРаскрытия = Неопределено Тогда
		КэшГрупп = ПодготовитьКэшДанныхПоГруппамРаскрытия(,Истина);
		
		Для Каждого ЗаписьКэша Из КэшГрупп Цикл
			ВосстановитьНумерациюСтрокПоказателя(ЗаписьКэша.ГруппаРаскрытия);
		КонецЦикла;
		
		Возврат;
	ИначеЕсли ТипЗнч(ГруппаРаскрытия) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
		СтрПоказателя = мПоказатели.Найти(ГруппаРаскрытия,"Ссылка");
		ГруппаРаскрытия = СтрПоказателя.ГруппаРаскрытия;
	КонецЕсли;
	
	НовИндекс = мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
	СтрокиРаскрытия = мПоказателиРаскрытия.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
	
	СчетчикиПоказателей = Новый Соответствие;
	
	Для Каждого СтрокаРаскрытия Из СтрокиРаскрытия Цикл
		
		Счетчик = СчетчикиПоказателей[СтрокаРаскрытия.Показатель];
		Счетчик = ?(Счетчик = Неопределено,1,Счетчик);
		
		СтрокаРаскрытия.Индекс = Счетчик;
		
		СчетчикиПоказателей[СтрокаРаскрытия.Показатель] = Счетчик + 1;
			
	КонецЦикла;
		
КонецПроцедуры // ВосстановитьНумерациюСтрокПоказателя()

// Формирует структуру параметров (Параметры), которая будет доступна из модулей отчета.
// Ключи структуры - имена параметров, значения - значения параметров.
//
Процедура СформироватьСтруктуруПараметров(ОбновитьПолностью = Истина) Экспорт
	
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Структура;
	ИначеЕсли Параметры.Количество() > 0 и Не ОбновитьПолностью Тогда
		Возврат; //Считаем, что параметры актуальны
	КонецЕсли;
	
	Параметры.Вставить("Номер", Номер);
	Параметры.Вставить("Дата", Дата);
	
	Для Каждого Реквизит Из Метаданные.Документы.УниверсальныйРегламентированныйОтчет.Реквизиты Цикл
		Параметры.Вставить(Реквизит.Имя, ЭтотОбъект[Реквизит.Имя]);
	КонецЦикла;
	
	Для Каждого Парам Из ПараметрыОтчета Цикл
		Параметры.Вставить(Парам.Код, Парам.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Функция вычисляет параметры, заданные в бланке в виде формул.
//
Функция ПолучитьВычисляемыеПоляБланка() Экспорт
	
	Формулы = Новый Структура;
	СтрокиФормул = мНастройкиБланка.НайтиСтроки(Новый Структура("ЕстьПредставление",Истина));
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаНастройки Из СтрокиФормул Цикл
		
		Формулы.Вставить(СтрокаНастройки.ИмяЯчейки);
		
		Попытка
			
			Значение = Вычислить(СтрокаНастройки.СтруктураНастроек.Представление);
			Формулы[СтрокаНастройки.ИмяЯчейки] = Значение;
			
		Исключение
			// Ошибочные формулы добавляются как Неопределено
			Формулы.Вставить(СтрокаНастройки.ИмяЯчейки,Неопределено);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Формулы;
	
КонецФункции

// Возвращает структуру параметров, имеющих формулы расчета
//
Функция ПолучитьВычисляемыеПараметры() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыОтчетовПараметрыОтчета.Код,
	|	ЗначенияПараметровОтчета.Значение
	|ИЗ
	|	Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код КАК Код,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Наименование КАК Наименование,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК Значение,
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета КАК ВидОтчета
	|		ИЗ
	|			Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|		ГДЕ
	|			УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка = &Ссылка) КАК ЗначенияПараметровОтчета
	|		ПО ВидыОтчетовПараметрыОтчета.Ссылка = ЗначенияПараметровОтчета.ВидОтчета
	|ГДЕ
	|	ВидыОтчетовПараметрыОтчета.ЭтоВыражение = ИСТИНА
	|	И ВидыОтчетовПараметрыОтчета.Ссылка = &ВидОтчета";
	
	СтруктураПараметров = Новый Структура;
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	Запрос.УстановитьПараметр("Ссылка"	 ,Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураПараметров.Вставить(Выборка.Код,Выборка.Значение);
	КонецЦикла;
	
	Возврат СтруктураПараметров;

КонецФункции // ПолучитьВычисляемыеПараметры()

// Функция для выполнения автоматизированных тестов
//
Функция ВычислитьВКонтекстеОтчета(Знач Выражение) Экспорт
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Вычислить(Выражение);
	КонецЕсли;

КонецФункции // ВычислитьВКонтекстеОтчета()


// Формирует структуру показателей (Показатели), которая будет доступна из модулей отчета.
// Ключи структуры - коды показателей, значения - значения показателей.
//
Процедура СформироватьСтруктуруИзмененныхПоказателей() Экспорт
	
	МассивЗначений = Новый Массив;
	Для Инд = 1 По мПоказатели.Количество() Цикл
		МассивЗначений.Добавить(Истина);	
	КонецЦикла;
	МассивЗначений.Вставить(0,СтрСоединить(мПоказатели.ВыгрузитьКолонку("Код"),","));	
	ИзмененныеПоказатели=Новый (Тип("Структура"),МассивЗначений);
	
КонецПроцедуры

Процедура ПроверитьИзменениеПоказателей(ТаблицаПоказателей=Неопределено) Экспорт
	
	Если ТаблицаПоказателей=Неопределено Тогда
		
		Для Каждого Элемент ИЗ ПоказателиДоПересчета Цикл
			
			Если Показатели[Элемент.Ключ]<>Элемент.Значение Тогда
				
				ИзмененныеПоказатели[Элемент.Ключ]=Истина;
				
			КонецЕсли;
			
		КонецЦикла;	
		
	Иначе
		
		Для Каждого СтрПоказатель Из ТаблицаПоказателей Цикл
			
			Если Показатели[СтрПоказатель.Код]<>СтрПоказатель.Значение Тогда
				
				ИзмененныеПоказатели[СтрПоказатель.Код]=Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьИзменениеПоказателей() 

Процедура СохранитьЗначенияПоказателей(ТаблицаПоказателей=Неопределено) Экспорт
	
	Если ТаблицаПоказателей=Неопределено Тогда
		
		ПоказателиДоПересчета = Новый Структура(Новый ФиксированнаяСтруктура(Показатели));
		
	Иначе
		
		МассивЗначений = ТаблицаПоказателей.ВыгрузитьКолонку("Значение");
		МассивЗначений.Вставить(0,СтрСоединить(ТаблицаПоказателей.ВыгрузитьКолонку("Код"),","));
		ПоказателиДоПересчета=Новый (Тип("Структура"),МассивЗначений);
				
	КонецЕсли;
	
КонецПроцедуры // СохранитьЗначенияПоказателей()

// Формирует структуру показателей (Показатели), которая будет доступна из модулей отчета.
// Ключи структуры - коды показателей, значения - значения показателей.
//
Процедура СформироватьСтруктуруПоказателей() Экспорт
	
	МассивЗначений = мПоказатели.ВыгрузитьКолонку("Значение");
	МассивЗначений.Вставить(0,СтрСоединить(мПоказатели.ВыгрузитьКолонку("Код"),","));
	Показатели=Новый (Тип("Структура"),МассивЗначений);
	
КонецПроцедуры

Процедура СформироватьСтруктуруДополнительныхРеквизитов() Экспорт
	
	ДополнительныеРеквизиты = Новый Структура;
	
	Для Каждого Реквизит из мДополнительныеРеквизиты Цикл
		ДополнительныеРеквизиты.Вставить(СокрП(Реквизит.Код), Реквизит.ТипЗначения.ПривестиЗначение(Реквизит.Значение));
	КонецЦикла;
	
КонецПроцедуры

// Переносит значения показателей из структуры Показатели в глобальную таблицу показателей - 
// мПоказатели.
//
Процедура ПеренестиЗначенияИзПоказателиВмПоказатели(ТаблицаПоказателей = Неопределено) Экспорт
	
	Если ТаблицаПоказателей = Неопределено Тогда
		ТаблицаПоказателей = мПоказатели;
	КонецЕсли;
	
	Для Каждого Кл Из ИзмененныеПоказатели Цикл
		Если Кл.Значение = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Пок = ТаблицаПоказателей.Найти(Кл.Ключ, "Код");
		Если Пок <> Неопределено
			И Пок.Значение <> Показатели[Кл.Ключ] Тогда
			Пок.Значение = Показатели[Кл.Ключ];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет колонку отображения таблицы раскрытия.
//
Процедура ПересчитатьЗначенияОтображения(КолонкиПоказатели, ТаблицаРаскрытия) Экспорт
	
	ШапкаОшибки = "";
	Делитель = ВернутьЗначениеДелителя();
	Для Каждого Пок Из КолонкиПоказатели Цикл
		
		МассивЗначений = ТаблицаРаскрытия.ВыгрузитьКолонку(СокрЛП(Пок.Код));
		Если Делитель <> 1 Тогда
			Для Инд = 0 По МассивЗначений.Количество() - 1 Цикл
				ПризнакОшибки = Ложь;
				Если Пок.ТипЗначения = ТипЗначенияЧисло 
					И НЕ Пок.НеМасштабируется Тогда
					МассивЗначений[Инд] = МассивЗначений[Инд] / Делитель;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ТаблицаРаскрытия.ЗагрузитьКолонку(МассивЗначений, СокрЛП(Пок.Код) + "_Отображение");
		
	КонецЦикла;
	
КонецПроцедуры

// Функция приводит строковое представление даты к его значению
//
// Параметры:
//  Представление - Представление числа
//  ОписаниеТипов - Допустимое описание типов значения типа дата
//
// Возвращаемое значение:
//  Значение типа дата
//
Функция ПривестиКДате(Представление, ТипРеквизита)
	
	Результат = ТипРеквизита.ПривестиЗначение(Представление);
	Если Результат = '00010101' Тогда
		
		МассивЧастей = ПолучитьЧастиПредставленияДаты(Представление);
		Если ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Время Тогда
			
			Попытка
				
				Если МассивЧастей.Количество() = 3 Тогда
					Результат = Дата(1,1,1, МассивЧастей[0],МассивЧастей[1],МассивЧастей[2]);
				ИначеЕсли МассивЧастей.Количество() = 6 Тогда
					Результат = Дата(1,1,1, МассивЧастей[3],МассивЧастей[4],МассивЧастей[5]);
				КонецЕсли;
				
			Исключение
				
			КонецПопытки;
			
		ИначеЕсли МассивЧастей.Количество() = 3 или МассивЧастей.Количество() = 6 Тогда
			
			Если МассивЧастей[0] >= 1000 Тогда
				Временно = МассивЧастей[0];
				МассивЧастей[0] = МассивЧастей[2];
				МассивЧастей[2] = Временно;
			КонецЕсли;
			
			Если МассивЧастей[2] < 100 Тогда
				МассивЧастей[2] = МассивЧастей[2] + ?(МассивЧастей[2] < 30, 2000,1900);
			КонецЕсли;
			
			Попытка
				Если МассивЧастей.Количество() = 3 или ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Дата Тогда
					Результат = Дата(МассивЧастей[2],МассивЧастей[1],МассивЧастей[0]);
				Иначе
					Результат = Дата(МассивЧастей[2],МассивЧастей[1],МассивЧастей[0],МассивЧастей[3],МассивЧастей[4],МассивЧастей[5]);
				КонецЕсли;
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция возвращает части представления даты
//
// Параметры:
//  Представление - Представление даты
//
// Возвращаемое значение:
//  массив частей даты
//
Функция ПолучитьЧастиПредставленияДаты(ЗНАЧ Представление)
	
	МассивЧастей = Новый Массив;
	НачалоЦифры = 0;
	Для к = 1 По СтрДлина(Представление) Цикл
		
		Символ = Сред(Представление, к ,1);
		ЭтоЦифра = Символ >= "0" и Символ <= "9";
		
		Если ЭтоЦифра Тогда
			
			Если НачалоЦифры = 0 Тогда
				НачалоЦифры = к;
			КонецЕсли;
			
		Иначе
			
			Если Не НачалоЦифры = 0 Тогда
				МассивЧастей.Добавить(Число(Сред(Представление,НачалоЦифры, к - НачалоЦифры)));
			КонецЕсли;
			
			НачалоЦифры = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не НачалоЦифры = 0 Тогда
		МассивЧастей.Добавить(Число(Сред(Представление,НачалоЦифры)));
	КонецЕсли;
	
	Возврат МассивЧастей;
КонецФункции // ()


