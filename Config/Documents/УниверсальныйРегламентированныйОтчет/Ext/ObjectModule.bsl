// Проверяет заполнение аналитик в переданной строке таблицы раскрытия
//
Функция ПроверитьЗаполнениеАналитик(СтрокаРаскрытия,ТабРаскрытия,Запись=Ложь,НачальнаяПозиция=0) Экспорт
	
	ЕстьАналитики=Ложь;
	
	НачальныйИндекс=?(НачальнаяПозиция=0,1,НачальнаяПозиция+1);
	
	Для Индекс=НачальныйИндекс ПО мЧислоДопАналитик Цикл
		
		Если НЕ (ТабРаскрытия.Колонки.Найти("Аналитика"+Индекс)=Неопределено)
			И (НЕ Запись) И НЕ СтрокаРаскрытия["Аналитика"+Индекс]=Неопределено Тогда
			
			ЕстьАналитики=Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьАналитики;
	
КонецФункции // ПроверитьЗаполнениеАналитик

Функция ПолучитьКопиюРаскрытия(ВосстанавливатьИндекс=Истина) Экспорт
	
	мПоказателиРаскрытия.Индексы.Очистить();
	КопияРаскрытия=мПоказателиРаскрытия.Скопировать();
	
	Если ВосстанавливатьИндекс Тогда
		мПоказателиРаскрытия.Индексы.Добавить("Показатель");
	КонецЕсли;
	
	Возврат КопияРаскрытия;
	
КонецФункции

// Выполняет отбор по группе раскрытия в таблице мПоказателиРаскрытия
//
Функция ВыбратьРаскрытиеПоГруппе(ГруппаРаскрытия) Экспорт

	НовИндекс = мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
	РаскрытиеПоГруппе = мПоказателиРаскрытия.Скопировать(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
	
	Возврат РаскрытиеПоГруппе;

КонецФункции // ВыбратьРаскрытиеПоГруппе()

// Выполняет запрос по таблице значений, средствами построителя запроса.
//
// Параметры:
//  СтруктураОтбора - ключ     - имя колонки
