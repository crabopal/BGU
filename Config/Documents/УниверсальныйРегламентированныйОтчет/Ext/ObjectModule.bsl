//
//  ИменаКолонок	- массив имен колонок, добавляемых в результат запроса.
//
// Возвращаемое значение:
//   РезультатЗапроса
//
Функция РезультатЗапросаПоТаблицеЗначений(Таблица, СтруктураОтбора = Неопределено, Знач ИменаКолонок = Неопределено) Экспорт

	Возврат БюджетнаяОтчетность.РезультатЗапросаПоТаблицеЗначений(Таблица,СтруктураОтбора,ИменаКолонок);

КонецФункции // РезультатЗапросаПоТаблицеЗначений()


// Функция формирует табличный документ протокола отчета.
//
// Параметры:
//  РезультатПроверки  - Булево - результат метода Проверить()
//                
//  РежимВывода		   - Строка "ТолькоОшибочные", ""
//
// Возвращаемое значение:
//   ТабличныйДокумент - Результирующий документ.
//
Функция ПолучитьПротоколПроверки(ТолькоОшибочные = Истина, СчетчикРасшифровок = 0) Экспорт

	ОтчетПоКС = Отчеты.ПроверкаКонтрольныхСоотношенийГУ.Создать();
	
	Возврат ОтчетПоКС.ПолучитьПротоколПроверки(ЭтотОбъект, ТолькоОшибочные, СчетчикРасшифровок);
	
КонецФункции // ПолучитьПротоколПроверки()


