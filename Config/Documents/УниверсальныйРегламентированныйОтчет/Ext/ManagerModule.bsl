//

Функция ПолучитьМассивПоказателейСтраницыПоНастройкам(ТекНастройки) Экспорт
	
	СтрокаПоказателейСтраницы = ТекНастройки.Найти("<ПоказателиСтраницы>","ИмяЯчейки");
	МассивПоказателейСтраницы = Неопределено;
	Если СтрокаПоказателейСтраницы <> Неопределено Тогда
		МассивПоказателейСтраницы = СтрокаПоказателейСтраницы.СтруктураНастроек.ПоказателиСтраницы;
	КонецЕсли;	
	Возврат МассивПоказателейСтраницы;
	
КонецФункции

//Функция возвращает табличный документ - страницу бланка на которой находится переданный код показателя,
//или показатели переданного кода строки, а также устанавливает отчету настройки бланка по возвращаемой странице.
//
Функция ОпределитьСтраницуБланкаПоПоказателям(ОтчетОбъект,КодПоказателя=Неопределено,КодСтроки) Экспорт
	
	Если ОтчетОбъект.мДеревоСтраниц = Неопределено Тогда
		ОтчетОбъект.ЗаполнитьДеревоСтраниц(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	МассивИскомыхПоказателей = Новый Массив;
	Если ЗначениеЗаполнено(КодПоказателя) Тогда
		МассивИскомыхПоказателей.Добавить(КодПоказателя);
	ИначеЕсли ЗначениеЗаполнено(КодСтроки) Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПоказателиОтчетов.Код КАК Код
			|ИЗ
			|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|ГДЕ
			|	ПоказателиОтчетов.Строка.Код = &КодСтроки
			|	И ПоказателиОтчетов.Владелец = &ВидОтчета";
		
		Запрос.УстановитьПараметр("ВидОтчета", ОтчетОбъект.ВидОтчета);
		Запрос.УстановитьПараметр("КодСтроки", КодСтроки);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивИскомыхПоказателей.Добавить(СокрЛП(ВыборкаДетальныеЗаписи.Код));
		КонецЦикла;
			
	КонецЕсли;
	
	ТабДок = Неопределено;
	Если МассивИскомыхПоказателей.Количество()>0 Тогда	
		ТабДок = ОпределитьСтраницуБланкаПоМассивуПоказателей(ОтчетОбъект, ОтчетОбъект.мДеревоСтраниц.Строки, МассивИскомыхПоказателей);
	КонецЕсли;
	
	Если ТабДок <> Неопределено Тогда
		Возврат ТабДок;
	Иначе
		ТекСтраница = ОтчетОбъект.мДеревоСтраниц.Строки[0];
		ТабДок = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка);
		ТекНастройки = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
		
		ОтчетОбъект.мНастройкиБланка = ТекНастройки;
		Возврат ТабДок;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьСтраницуБланкаПоМассивуПоказателей(ОтчетОбъект, КоллекцияСтрок,МассивИскомыхПоказателей)
	Для Каждого ТекСтраница Из КоллекцияСтрок Цикл
		Если Не ЗначениеЗаполнено(ТекСтраница.АдресБланка) Тогда
		
			СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(ОтчетОбъект.ШаблонОтчета,ТекСтраница.ИмяСтраницы);
			
			ТабДок = СтруктураСтраницы.Макет;
			ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		Иначе
			ТабДок = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка);
			ТекНастройки = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
		КонецЕсли;
					
		Если ТабДок=Неопределено Тогда	
			ТабДок = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
						
		МассивПоказателей = Документы.УниверсальныйРегламентированныйОтчет.ПолучитьМассивПоказателейСтраницыПоНастройкам(ТекНастройки);
		
		Если МассивПоказателей = Неопределено Тогда
			//это одностраничный бланк без настроек показателей
			ОтчетОбъект.мНастройкиБланка = ТекНастройки;
			Возврат ТабДок;
		Иначе					
			Для Каждого ТекИскомыйКод Из МассивИскомыхПоказателей Цикл
			
				Если МассивПоказателей.Найти(ТекИскомыйКод) <> Неопределено Тогда
					
					//Нашли	страницу бланка в которой выводится искомый показатель 
					ОтчетОбъект.мНастройкиБланка = ТекНастройки;
					Возврат ТабДок;			
									
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		ТабДок = ОпределитьСтраницуБланкаПоМассивуПоказателей(ОтчетОбъект, ТекСтраница.Строки, МассивИскомыхПоказателей);
		Если ТабДок <> Неопределено Тогда
			Возврат ТабДок;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции


