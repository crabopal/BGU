Функция ВерсииОтчетаИдентичны(ПараметрыСравнения) Экспорт
	
	СтруктураРезультата = ОпределитьОтличия(ПараметрыСравнения);
	
	ВерсииОтчетаИдентичны = Ложь;
	
	Если СтруктураРезультата.ДанныеРасхождений1.Количество() = 0 
		И СтруктураРезультата.ДанныеРасхождений2.Количество() = 0 Тогда
		ВерсииОтчетаИдентичны = Истина;
	КонецЕсли;
	
	Возврат ВерсииОтчетаИдентичны;
	
КонецФункции

Процедура СравнитьВерсииПакетно(НаборПараметров, АдресХранилища) Экспорт
	
	РезультатПакетногоСравнения = Новый Соответствие;
	Для Каждого ЭлементНабора Из НаборПараметров Цикл
		РезультатСравненияПоОтчету = Новый Соответствие;
		Для Каждого ЭлементОтчета Из ЭлементНабора.Значение Цикл
			ДанныеДляЗаполнения = АнализОтличийПоИменованнымОбластям(ЭлементОтчета.Значение);
			
			РезультатСравненияПоОтчету.Вставить(ЭлементОтчета.Ключ, ДанныеДляЗаполнения);
		КонецЦикла;	
		РезультатПакетногоСравнения.Вставить(ЭлементНабора.Ключ, РезультатСравненияПоОтчету);
	КонецЦикла;	
	ПоместитьВоВременноеХранилище(РезультатПакетногоСравнения, АдресХранилища);
	
КонецПроцедуры

Процедура ПреобразоватьВерсииВТабличныеДокументы(ПараметрыСравнения)
	
	ПараметрыСравнения.ТабличныеДокументыЗаполнены = Истина;
	
КонецПроцедуры // ПреобразоватьВерсииВТабличныеДокументы()

Функция ПропустьДанныйКлюч(ТекКлюч,АнализироватьТолькоДанныеОтчета,ИменаПараметров,ИменаДопРеквизитов)
	
	Если СтрНайти(ТекКлюч,"ДляПоиска_")=1 Тогда
		//Это имя служебного поля, по которому выполняется отбор в бланке.
		//Такие элементы сравнивать не нужно.			
		Возврат Истина;
	КонецЕсли;		
	
	Если АнализироватьТолькоДанныеОтчета Тогда
		//При анализе данных отчета не анализируем параметры
		Если ИменаПараметров.Найти(ТекКлюч) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ИменаДопРеквизитов.Найти(ТекКлюч) = Неопределено Тогда
			//Если это не доп.реквизит, значит это может быть данные отчета (в имени есть символ "_") или произвольная ячейчка,
			//например, с данными шапки - наименованием организации, датой и проч.
			
			Если СтрНайти(ТекКлюч,"_") = 0 Тогда
				//Это не данные отчета, 
			    Возврат Истина;
		    КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ОпределитьОтличия(ПараметрыСравнения)
	
	Если НЕ ПараметрыСравнения.ТабличныеДокументыЗаполнены Тогда
		ПреобразоватьВерсииВТабличныеДокументы(ПараметрыСравнения);
	КонецЕсли;
	
	Если НЕ ПараметрыСравнения.Свойство("ВариантСравнения") Тогда
		ПараметрыСравнения.Вставить("ВариантСравнения","ДанныеОтчета");	
	КонецЕсли;
	
	ИменаДопРеквизитов = Новый Массив;
	
	ИменаПараметров = Новый Массив;
	
	АнализироватьТолькоДанныеОтчета = ПараметрыСравнения.ВариантСравнения = "ДанныеОтчета";
	
	Если АнализироватьТолькоДанныеОтчета Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ДополнительныеРеквизитыОтчетов.Код
		               |ИЗ
		               |	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		               |		ПО УниверсальныйРегламентированныйОтчет.ВидОтчета = ДополнительныеРеквизитыОтчетов.Владелец
		               |ГДЕ
		               |	УниверсальныйРегламентированныйОтчет.Ссылка = &Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ВидыОтчетовПараметрыОтчета.Код
		               |ИЗ
		               |	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
		               |		ПО УниверсальныйРегламентированныйОтчет.ВидОтчета = ВидыОтчетовПараметрыОтчета.Ссылка
		               |ГДЕ
		               |	УниверсальныйРегламентированныйОтчет.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",ПараметрыСравнения.ОтчетСсылка);
		Результаты = Запрос.ВыполнитьПакет();
		
		Выборка = Результаты[0].Выбрать();
		Пока Выборка.Следующий() Цикл
			ИменаДопРеквизитов.Добавить(СокрП(Выборка.Код));	
		КонецЦикла;
		
		Выборка = Результаты[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			ИменаПараметров.Добавить(СокрП(Выборка.Код));	
		КонецЦикла;
		
	КонецЕсли;
	
	ТипСтрока = Тип("Строка");
	
	ДанныеРасхождений1 = Новый Структура;
	ДанныеРасхождений2 = Новый Структура;
	СоответсвиеОбластейВ1_В2 = Новый Структура;
	СоответсвиеОбластейВ2_В1 = Новый Структура;
	ПараметрыСравнения.ИзмененныеОбласти.Очистить();
	
	ДанныеВерсия1 = ПолучитьИменаОбласти(ПараметрыСравнения.ТабличныйДокументВерсия1);
	ДанныеВерсия2 = ПолучитьИменаОбласти(ПараметрыСравнения.ТабличныйДокументВерсия2);
	
	// Шаг 1. Сравнение показателей.
	// Сопоставляем данные показателей версии 1 и версии 2. 
	// В процессе сравнения заполнением список расхождений для версии 1.
	ДанныеПоказателейВерсия1 = ДанныеВерсия1.ДанныеПоказателей;
	ДанныеПоказателейВерсия2 = ДанныеВерсия2.ДанныеПоказателей;
	Для Каждого ЭлементСИменемВерсия1 Из ДанныеПоказателейВерсия1 Цикл
		
		ТекКлюч = ЭлементСИменемВерсия1.Ключ;
		
		Пропускаем = ПропустьДанныйКлюч(ТекКлюч,АнализироватьТолькоДанныеОтчета,ИменаПараметров,ИменаДопРеквизитов);
		
		Если Пропускаем Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеВерсия1 = ЭлементСИменемВерсия1.Значение;
		КлючВерсия1 = ЭлементСИменемВерсия1.Ключ;
		ЗначениеВерсия2 = "";
		Если ДанныеПоказателейВерсия2.Свойство(КлючВерсия1, ЗначениеВерсия2) Тогда
			// Данные в версии 2 есть, сверяем.
			Если ТипЗнч(ЗначениеВерсия1) = ТипСтрока Тогда
				ЗначениеВерсия1 = СокрЛП(ЗначениеВерсия1);	
			КонецЕсли;
			Если ТипЗнч(ЗначениеВерсия2) = ТипСтрока Тогда
				ЗначениеВерсия2 = СокрЛП(ЗначениеВерсия2);	
			КонецЕсли;
			Если НЕ ЗначениеВерсия1 = ЗначениеВерсия2 Тогда
				ДанныеРасхождений1.Вставить(КлючВерсия1, 1);
				ДанныеРасхождений2.Вставить(КлючВерсия1, 1);
				СоответсвиеОбластейВ1_В2.Вставить(КлючВерсия1,КлючВерсия1);
				СоответсвиеОбластейВ2_В1.Вставить(КлючВерсия1,КлючВерсия1);
			КонецЕсли;	
		Иначе 
			// Данных в версии 2 нет. Отмечаем как удаленный показатель.
			ДанныеРасхождений1.Вставить(КлючВерсия1, 3);
		КонецЕсли;	
	КонецЦикла;
	
	// Сопоставляем данные показателей версии 2 и версии 1 (пропуская уже сопоставленные).
	// В процессе сравнения заполнением список расхождений для версии 1.
	Для Каждого ЭлементСИменемВерсия2 Из ДанныеПоказателейВерсия2 Цикл
		
		ТекКлюч = ЭлементСИменемВерсия2.Ключ;
		
		Пропускаем = ПропустьДанныйКлюч(ТекКлюч,АнализироватьТолькоДанныеОтчета,ИменаПараметров,ИменаДопРеквизитов);
		
		Если Пропускаем Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеВерсия2 = ЭлементСИменемВерсия2.Значение;
		КлючВерсия2 = ЭлементСИменемВерсия2.Ключ;
		
		Если НЕ ДанныеПоказателейВерсия1.Свойство(КлючВерсия2, ЗначениеВерсия2) Тогда
			// Данных в версии 1 нет. Отмечаем как добавленный показатель.
			ДанныеРасхождений2.Вставить(КлючВерсия2, 2);
		КонецЕсли;	
	КонецЦикла;
	
	// Шаг 2. Сравнение данных групп раскрытия. Нужно учитывать возможность изменения порядка строк в группе.
	ДанныеГруппВерсия1 = ДанныеВерсия1.ДанныеГруппРаскрытия;
	ДанныеГруппВерсия2 = ДанныеВерсия2.ДанныеГруппРаскрытия;
	
	ИменаСтрокГруппРаскрытия = ДанныеВерсия1.ИменаСтрокГруппРаскрытия;// Имена строк для версий одинаковы, но в разных версиях могут быть разные наборы строк.
	Для Каждого ИмяСтрокиГруппы2 Из ДанныеВерсия2.ИменаСтрокГруппРаскрытия Цикл
		Если ИменаСтрокГруппРаскрытия.Найти(ИмяСтрокиГруппы2) = Неопределено Тогда
			ИменаСтрокГруппРаскрытия.Добавить(ИмяСтрокиГруппы2);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ИмяСтрокиРаскрытия Из ИменаСтрокГруппРаскрытия Цикл
		
		Если СтрНайти(ИмяСтрокиРаскрытия,"XLS_Граница_")=1
			ИЛИ СтрНайти(ИмяСтрокиРаскрытия,"XLS_Раздел_")=1
			ИЛИ СтрНайти(ИмяСтрокиРаскрытия,"XLS_Шапка_")=1 Тогда
			//Это имена строк для разделения бланка на страницы, при сохранении его в Excel.
			//Такие строки не анализируются.
			Продолжить;
		КонецЕсли;
		
		ВсеКолонкиТаблицы = Новый Массив;
		КолонкиАналитик = Новый Массив;
		КолонкиПоказателей = Новый Массив;
		ТаблицаРаскрытия1 = Новый ТаблицаЗначений();
		ТаблицаРаскрытия1.Колонки.Добавить("НомерСтрокиВГруппе", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла()));
		
		ИмяПоказателяНомераСтроки = ИмяСтрокиРаскрытия + "_НомерСтроки";
		
		Для Каждого ЗначениеПоказателяРаскрытия Из ДанныеГруппВерсия1 Цикл
			
			Если СтрНачинаетсяС(ЗначениеПоказателяРаскрытия.Ключ,ИмяСтрокиРаскрытия) Тогда
				СтруктураИмениПоказателяРаскрытия = СтрукрураИмениПоказателяРаскрытия(ЗначениеПоказателяРаскрытия.Ключ);
				Если СтруктураИмениПоказателяРаскрытия = Неопределено Тогда
					Продолжить;
				КонецЕсли;				
				
				Если СтруктураИмениПоказателяРаскрытия.ИмяПоказателя = ИмяПоказателяНомераСтроки Тогда
					Продолжить;//Если в бланке есть колонка с номером строки группы раскрытия, пропускаем ее.
							   //Изменение порядка строк в отчете не является отличием.
				КонецЕсли;

				ИмяКолонкиДляДобавления = СтруктураИмениПоказателяРаскрытия.ИмяПоказателя;
				Если ТаблицаРаскрытия1.Колонки.Найти(ИмяКолонкиДляДобавления) = Неопределено Тогда
					ТаблицаРаскрытия1.Колонки.Добавить(ИмяКолонкиДляДобавления);
					ВсеКолонкиТаблицы.Добавить(ИмяКолонкиДляДобавления);
					
					Если СтрНачинаетсяС(ИмяКолонкиДляДобавления,ИмяСтрокиРаскрытия+"_Аналитика") Тогда
						КолонкиАналитик.Добавить(ИмяКолонкиДляДобавления);
					Иначе
						КолонкиПоказателей.Добавить(ИмяКолонкиДляДобавления);
					КонецЕсли;
				КонецЕсли;
				
				СтрокаРаскрытия = ТаблицаРаскрытия1.Найти(СтруктураИмениПоказателяРаскрытия.НомерСтрокиВГруппе, "НомерСтрокиВГруппе");
				Если СтрокаРаскрытия = Неопределено Тогда
					СтрокаРаскрытия = ТаблицаРаскрытия1.Добавить();
					СтрокаРаскрытия.НомерСтрокиВГруппе = СтруктураИмениПоказателяРаскрытия.НомерСтрокиВГруппе;
				КонецЕсли;	
				
				ТекЗначение = ЗначениеПоказателяРаскрытия.Значение;
				Если ТипЗнч(ТекЗначение) = ТипСтрока Тогда
					ТекЗначение = СокрЛП(ТекЗначение);
				КонецЕсли;
				СтрокаРаскрытия[СтруктураИмениПоказателяРаскрытия.ИмяПоказателя] = ТекЗначение;			
			КонецЕсли;
		КонецЦикла;
				
		ТаблицаРаскрытия2 = ТаблицаРаскрытия1.СкопироватьКолонки();
		ДобавитьКолонкиПоТаблице2 = ВсеКолонкиТаблицы.Количество() = 0;
		
		Для Каждого ЗначениеПоказателяРаскрытия Из ДанныеГруппВерсия2 Цикл
			Если СтрНачинаетсяС(ЗначениеПоказателяРаскрытия.Ключ,ИмяСтрокиРаскрытия) Тогда
				СтруктураИмениПоказателяРаскрытия = СтрукрураИмениПоказателяРаскрытия(ЗначениеПоказателяРаскрытия.Ключ);
				Если СтруктураИмениПоказателяРаскрытия = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				Если СтруктураИмениПоказателяРаскрытия.ИмяПоказателя = ИмяПоказателяНомераСтроки Тогда
					Продолжить;//Если в бланке есть колонка с номером строки группы раскрытия, пропускаем ее.
							   //Изменение порядка строк в отчете не является отличием.
				КонецЕсли;
				
				Если ДобавитьКолонкиПоТаблице2 Тогда
					ИмяКолонкиДляДобавления = СтруктураИмениПоказателяРаскрытия.ИмяПоказателя;
					Если ТаблицаРаскрытия2.Колонки.Найти(ИмяКолонкиДляДобавления) = Неопределено Тогда
						ТаблицаРаскрытия2.Колонки.Добавить(ИмяКолонкиДляДобавления);
						ВсеКолонкиТаблицы.Добавить(ИмяКолонкиДляДобавления);
						
						Если СтрНачинаетсяС(ИмяКолонкиДляДобавления,ИмяСтрокиРаскрытия+"_Аналитика") Тогда
							КолонкиАналитик.Добавить(ИмяКолонкиДляДобавления);
						Иначе
							КолонкиПоказателей.Добавить(ИмяКолонкиДляДобавления);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
								
				СтрокаРаскрытия = ТаблицаРаскрытия2.Найти(СтруктураИмениПоказателяРаскрытия.НомерСтрокиВГруппе, "НомерСтрокиВГруппе");
				Если ТаблицаРаскрытия2.Колонки.Найти(СтруктураИмениПоказателяРаскрытия.ИмяПоказателя) = Неопределено Тогда
					ТаблицаРаскрытия2.Колонки.Добавить(СтруктураИмениПоказателяРаскрытия.ИмяПоказателя);
				КонецЕсли;
				Если СтрокаРаскрытия = Неопределено Тогда
					СтрокаРаскрытия = ТаблицаРаскрытия2.Добавить();
					СтрокаРаскрытия.НомерСтрокиВГруппе = СтруктураИмениПоказателяРаскрытия.НомерСтрокиВГруппе;
				КонецЕсли;	
				
				ТекЗначение = ЗначениеПоказателяРаскрытия.Значение;
				Если ТипЗнч(ТекЗначение) = ТипСтрока Тогда
					ТекЗначение = СокрЛП(ТекЗначение);
				КонецЕсли;
				СтрокаРаскрытия[СтруктураИмениПоказателяРаскрытия.ИмяПоказателя] = ТекЗначение;
			КонецЕсли;
		КонецЦикла;
		
		СтрокиДляУдаления1 = Новый Массив;
		ИменаВсехКолонок = СтрСоединить(ВсеКолонкиТаблицы,",");
		// Шаг 2.1. Удаляем из таблиц поиска строки с полностью одинаковыми значениями
		// (без учета номера строки), в них искать изменения не нужно.
		Для Каждого СтрокаПоиска Из ТаблицаРаскрытия1 Цикл
			ОтборПоиска = Новый Структура(ИменаВсехКолонок);
			ЗаполнитьЗначенияСвойств(ОтборПоиска,СтрокаПоиска);
			//Для Каждого КолонкаПоиска Из ВсеКолонкиТаблицы Цикл
			//	ОтборПоиска.Вставить(КолонкаПоиска,СтрокаПоиска[КолонкаПоиска]);
			//КонецЦикла;
			СовпадающиеСтроки = ТаблицаРаскрытия2.НайтиСтроки(ОтборПоиска);
			Если СовпадающиеСтроки.Количество() > 0 Тогда
				СтрокиДляУдаления1.Добавить(СтрокаПоиска);
				ТаблицаРаскрытия2.Удалить(СовпадающиеСтроки[0]);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаУдалить Из СтрокиДляУдаления1 Цикл
			ТаблицаРаскрытия1.Удалить(СтрокаУдалить);
		КонецЦикла;
				
		// Шаг 2.2. Находим расхождения в показателях.
		
		КолонкиСтрокой = СтрСоединить(КолонкиАналитик,",");
		
		СтрокиДляУдаления1.Очистить();
		Для Каждого СтрокаПоиска Из ТаблицаРаскрытия1 Цикл
			
			ОтборПоиска = Новый Структура(КолонкиСтрокой);
			ЗаполнитьЗначенияСвойств(ОтборПоиска,СтрокаПоиска);
			
			СовпадающиеСтроки = ТаблицаРаскрытия2.НайтиСтроки(ОтборПоиска);
			Если СовпадающиеСтроки.Количество() > 0 Тогда
				НайденнаяСтрока = СовпадающиеСтроки[0];
				// Строки совпали по аналитикам, нужно найти отличающиеся показатели.
				Для Каждого ИмяКолонки Из КолонкиПоказателей Цикл
					Если СтрокаПоиска[ИмяКолонки] <> НайденнаяСтрока[ИмяКолонки] Тогда
						ИмяПоказателя1 = ИмяКолонки+"_"+XMLСтрока(СтрокаПоиска.НомерСтрокиВГруппе);
						ДанныеРасхождений1.Вставить(ИмяПоказателя1, 1);
						ИмяПоказателя2 = ИмяКолонки+"_"+XMLСтрока(НайденнаяСтрока.НомерСтрокиВГруппе);
						ДанныеРасхождений2.Вставить(ИмяПоказателя2, 1);
						СоответсвиеОбластейВ1_В2.Вставить(ИмяПоказателя1,ИмяПоказателя2);
						СоответсвиеОбластейВ2_В1.Вставить(ИмяПоказателя2,ИмяПоказателя1);
					КонецЕсли;
				КонецЦикла;
				
				СтрокиДляУдаления1.Добавить(СтрокаПоиска);
				ТаблицаРаскрытия2.Удалить(НайденнаяСтрока);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаУдалить Из СтрокиДляУдаления1 Цикл
			ТаблицаРаскрытия1.Удалить(СтрокаУдалить);
		КонецЦикла;
		
