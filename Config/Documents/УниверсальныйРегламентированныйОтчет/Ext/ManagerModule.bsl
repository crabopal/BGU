//Печать	

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Устанавливаем признак доступности печати покомплектно.
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Ложь;
	
	// Проверяем, нужно ли для макета СчетЗаказа формировать табличный документ.
	Если ПечатьРегламентированныхФормСерверПереопределяемый.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьБланка") Тогда
		
		ИмяМакета = "ПечатьБланка";
		
		Если ПараметрыПечати.ОписаниеКоманды.Тип = "ТекущийБланк" Тогда
			//очищаем, т.к. при многостраничном бланке выводим комплект, который ранее не был запланирован 
			КоллекцияПечатныхФорм.Очистить();
		КонецЕсли;
			
		
		Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда
			
			Для Каждого ОтчетСсылка Из МассивОбъектов Цикл
				Объект = ОтчетСсылка.ПолучитьОбъект();
				ПодготовитьВыводВКоллекцию(Объект, КоллекцияПечатныхФорм, ИмяМакета, "ПечатьПоУмолчанию",ОбъектыПечати);
				
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(ПараметрыПечати.АдресОбъекта) Тогда 
			
				Объект = ПараметрыПечати.Ссылка.ПолучитьОбъект();
				Объект.ЗагрузитьВнутренниеСвойства(ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресОбъекта));
				Объект.БланкОтчета = Объект.ШаблонОтчета;
				
			Иначе 
				
				Объект = ПараметрыПечати.Ссылка.ПолучитьОбъект();

				
			КонецЕсли;	
			
			ПодготовитьВыводВКоллекцию(Объект, КоллекцияПечатныхФорм, ИмяМакета, ПараметрыПечати.ОписаниеКоманды,ОбъектыПечати);
		КонецЕсли;	
	КонецЕсли;
		
	
КонецПроцедуры

Процедура ПодготовитьВыводВКоллекцию(Объект, КоллекцияПечатныхФорм, Знач ИмяМакета, ОписаниеКоманды,ОбъектыПечати)
	
	Объект.ПроверитьКонтекстИнициализирован();
	Объект.СформироватьСтруктуруИзмененныхПоказателей();
	
	СинонимМакета = БюджетнаяОтчетностьСерверПовтИсп.ПредставлениеВидаОтчета(Объект.ВидОтчета);
	
	Если (ТипЗнч(ОписаниеКоманды) = Тип("Строка") 
			И ОписаниеКоманды = "ПечатьПоУмолчанию") 
		ИЛИ (ТипЗнч(ОписаниеКоманды)= Тип("Структура") 
			И ОписаниеКоманды.Тип = "ТекущийБланк") Тогда
			
		ИмяМакета = ИмяМакета + "_" + Объект.Ссылка.УникальныйИдентификатор();	
		Объект.ЗаполнитьДеревоСтраниц(Новый УникальныйИдентификатор);
		
		СформироватьПечатнуюФормуДляКоллекцииСтраниц(Объект, Объект.мДеревоСтраниц.Строки, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати);
		
	Иначе	
				
		ТабличныйДокумент = ПечатьРегламентированныхФорм.ПолучитьПечатнуюФорму(Объект, ОписаниеКоманды);
		
		ПечатьРегламентированныхФормСерверПереопределяемый.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 1, ОбъектыПечати, Объект.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПечатнуюФормуДляКоллекцииСтраниц(ДокОбъект, СтрокиДерева, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати)
	Для Инд = 0 По СтрокиДерева.Количество()-1 Цикл
		ТекСтраница = СтрокиДерева[Инд];
		ТабличныйДокумент = ПечатьРегламентированныхФорм.ПолучитьСтраницуПечатнойФормыТекущегоБланка(ДокОбъект, ТекСтраница);
		
		ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета+"_"+ТекСтраница.ИмяСтраницы, ТекСтраница.Наименование, ТабличныйДокумент);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 1, ОбъектыПечати, ДокОбъект.Ссылка);
		
		Если ТекСтраница.Строки.Количество()>0 Тогда
			СформироватьПечатнуюФормуДляКоллекцииСтраниц(ДокОбъект,ТекСтраница.Строки, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати);	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент, Картинка = Неопределено, ПолныйПутьКМакету = "")
	//Всегда добавляем табличный документ в коллекцию, т.к. это добавление страниц/разделов бланка.
	ОписаниеПечатнойФормы = КоллекцияПечатныхФорм.Добавить();
	ОписаниеПечатнойФормы.ИмяМакета = ИмяМакета;
	ОписаниеПечатнойФормы.ИмяВРЕГ = ВРег(ИмяМакета);	
	ОписаниеПечатнойФормы.ТабличныйДокумент = ТабличныйДокумент;
	ОписаниеПечатнойФормы.СинонимМакета = СинонимМакета;
	ОписаниеПечатнойФормы.Картинка = Картинка;
	ОписаниеПечатнойФормы.ПолныйПутьКМакету = ПолныйПутьКМакету;
	ОписаниеПечатнойФормы.ИмяФайлаПечатнойФормы = "";
	ОписаниеПечатнойФормы.Экземпляров = 1;
КонецПроцедуры

