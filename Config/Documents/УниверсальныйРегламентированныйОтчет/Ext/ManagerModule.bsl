Функция АнализОтличийПоИменованнымОбластям(ПараметрыСравнения)
		
	СтруктураРезультата = ОпределитьОтличия(ПараметрыСравнения);
	
	СброситьЦветаБланка(ПараметрыСравнения.ТабличныйДокументВерсия1);
	СброситьЦветаБланка(ПараметрыСравнения.ТабличныйДокументВерсия2);
		
	Если НЕ (СтруктураРезультата.ДанныеРасхождений1.Количество() = 0 И СтруктураРезультата.ДанныеРасхождений2.Количество() = 0) Тогда
		ДанныеРасхождений = Новый Структура("РасхожденияВерсия1,РасхожденияВерсия2",СтруктураРезультата.ДанныеРасхождений1,СтруктураРезультата.ДанныеРасхождений2);
		УстановитьЦветаПоИзменениям(ПараметрыСравнения.ТабличныйДокументВерсия1, ПараметрыСравнения, ДанныеРасхождений, СтруктураРезультата.СоответсвиеОбластейВ1_В2, 1);
		УстановитьЦветаПоИзменениям(ПараметрыСравнения.ТабличныйДокументВерсия2, ПараметрыСравнения, ДанныеРасхождений, СтруктураРезультата.СоответсвиеОбластейВ2_В1, 2);
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ИзмененныеОбласти", ПараметрыСравнения.ИзмененныеОбласти);
	ДанныеЗаполнения.Вставить("ТабличныеДокументыЗаполнены", ПараметрыСравнения.ТабличныеДокументыЗаполнены);
	ДанныеЗаполнения.Вставить("ТабличныйДокументВерсия1", ПараметрыСравнения.ТабличныйДокументВерсия1);
	ДанныеЗаполнения.Вставить("ТабличныйДокументВерсия2", ПараметрыСравнения.ТабличныйДокументВерсия2);
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

Процедура ЗаполнитьДанныеРасхожденийПоСтроке(ДанныеРасхождений, Знач СтрокаРасхождений, Знач ИменаКолонок, Знач ВидРасхождений)
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ДанныеРасхождений.Вставить(ИмяКолонки+"_"+XMLСтрока(СтрокаРасхождений.НомерСтрокиВГруппе), ВидРасхождений);
	КонецЦикла;
КонецПроцедуры

Функция СтрукрураИмениПоказателяРаскрытия(Знач ИмяПоказателяССуффиксом)
	
	ИмяПоказателяБезСуффикса = ИмяПоказателяССуффиксом;
	Пока КодСимвола(Прав(ИмяПоказателяБезСуффикса,1)) <> 95 Цикл // Символ "_".
		ИмяПоказателяБезСуффикса = Лев(ИмяПоказателяБезСуффикса,СтрДлина(ИмяПоказателяБезСуффикса)-1);
	КонецЦикла;
	ИмяПоказателяБезСуффикса = Лев(ИмяПоказателяБезСуффикса,СтрДлина(ИмяПоказателяБезСуффикса)-1);
	
	Попытка
		НомерСтрокиВГруппе = Число(Прав(ИмяПоказателяССуффиксом,СтрДлина(ИмяПоказателяССуффиксом)-СтрДлина(ИмяПоказателяБезСуффикса)-1));
		
		СтруктураИмениПоказателя = Новый Структура;
		СтруктураИмениПоказателя.Вставить("ИмяПоказателя", ИмяПоказателяБезСуффикса); 
		СтруктураИмениПоказателя.Вставить("НомерСтрокиВГруппе", НомерСтрокиВГруппе);
		
		Возврат СтруктураИмениПоказателя;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получает структуру с именами ячеек с показателями и их значениями,
// а также перечень строк, по которым может быть изменена сортировка.
//
// Параметры:
// ТабличныйДокументДляСравнения - Табличный документ, который нужно анализировать.
//
// Возвращаемое значение:
// РезультатРазбораДокумента	- Структура со значениями:
//     * ДанныеПоказателей			- Структура - содережит перечень имен областей 
//									с данными показателей для анализа значений
//     * ДанныеГруппРаскрытия		- Структура - содережит перечень имен областей 
//									с данными показателей групп раскрытия для анализа значений
//     * ИменаСтрокГруппРаскрытия	- Массив - содережит перечень имен строк групп раскрытия
Функция ПолучитьИменаОбласти(Знач ТабличныйДокументДляСравнения)
	
	ДанныеПоказателей = Новый Структура;
	ДанныеГруппРаскрытия = Новый Структура;
	
	ИменованныеОбластиДокумента = ТабличныйДокументДляСравнения.Области;
	ИменаСтрокГруппРаскрытия = Новый Массив;
	// Для обработки нужно два цикла - в первом нужно выбрать строки (для получения списка имен групп раскрытия),
	// во втором - выбрать показатели в зависимости от их типа.
	Для Каждого ИменованнаяОбластьДляСравнения Из ИменованныеОбластиДокумента Цикл
		Если ИменованнаяОбластьДляСравнения.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
			Если СтрНачинаетсяС(ИменованнаяОбластьДляСравнения.Имя,"XLS_Граница_")
				ИЛИ СтрНачинаетсяС(ИменованнаяОбластьДляСравнения.Имя,"XLS_Раздел_")
				ИЛИ СтрНачинаетсяС(ИменованнаяОбластьДляСравнения.Имя,"XLS_Шапка_") Тогда
				//Это имена строк для разделения бланка на страницы, при сохранении его в Excel.
				//Такие строки не анализируются.
				Продолжить;
			КонецЕсли;
			ИменаСтрокГруппРаскрытия.Добавить(ИменованнаяОбластьДляСравнения.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИменованнаяОбластьДляСравнения Из ИменованныеОбластиДокумента Цикл
		Если ИменованнаяОбластьДляСравнения.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			// Сравнение строк и колонок нельзя провести, т.к. если есть группа раскрытия, строка создается одна на всю группу.
			Если Лев(ИменованнаяОбластьДляСравнения.Имя,8) = "Колонка_"
					ИЛИ Лев(ИменованнаяОбластьДляСравнения.Имя,7) = "Строка_" Тогда
				Продолжить;// Для сравнения нужны только показатели.
			КонецЕсли;
			
			ЭтоПоказательГруппыРаскрытия = Ложь;
			Для Каждого ИмяСтрокиРаскрытия Из ИменаСтрокГруппРаскрытия Цикл
				Если СтрНачинаетсяС(ИменованнаяОбластьДляСравнения.Имя,ИмяСтрокиРаскрытия) Тогда
					ЭтоПоказательГруппыРаскрытия = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ИменованнаяОбластьДляСравнения.СодержитЗначение = Истина Тогда
				ЗначениеДляАнализа = ИменованнаяОбластьДляСравнения.Значение;
			Иначе
				ЗначениеДляАнализа = ИменованнаяОбластьДляСравнения.Текст;
			КонецЕсли;
			
			Если ЭтоПоказательГруппыРаскрытия Тогда
				Если СтрЗаканчиваетсяНа(ИменованнаяОбластьДляСравнения.Имя,"_РазметкаПустойСтроки")=Ложь Тогда
					ДанныеГруппРаскрытия.Вставить(ИменованнаяОбластьДляСравнения.Имя, ЗначениеДляАнализа);
				КонецЕсли;
			Иначе
				ДанныеПоказателей.Вставить(ИменованнаяОбластьДляСравнения.Имя, ЗначениеДляАнализа);
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	РезультатРазбораДокумента = Новый Структура;
	РезультатРазбораДокумента.Вставить("ДанныеПоказателей",ДанныеПоказателей);
	РезультатРазбораДокумента.Вставить("ДанныеГруппРаскрытия",ДанныеГруппРаскрытия);
	РезультатРазбораДокумента.Вставить("ИменаСтрокГруппРаскрытия",ИменаСтрокГруппРаскрытия);
	
	Возврат РезультатРазбораДокумента;
	
КонецФункции

// Устанавливает цвета и примечания по измененным показателям табличного документа.
// Формирует список изменных показателей для последовательного перехода по показателям.
//
// Параметры:
//	ТабличныйДокументВерсия	- Табличный документ, в котором нужно установить цвета.
//	ДанныеРасхождений		- Структура - содержит структуры со свойствами:
//		* РасхожденияВерсия1 - Структура с ключами - именами областей по первому документу.
//			В зависимости от варианта расхождений, значения структуры могут быть следующими:
// 			- Число - 1 - показатель изменен (длина - 1).
// 			- Число - 2 - показатель добавлен (длина - 1).
//			- Число - 3 - показатель удален (длина - 1).
//		* РасхожденияВерсия2 - Структура с ключами - аналогично РасхожденияВерсия1, с именами областей по второму документу.
Процедура УстановитьЦветаПоИзменениям(ТабличныйДокументВерсия, ПараметрыСравнения, Знач ДанныеРасхождений, Знач СоответсвиеОбластей, Знач Версия)
	
	ДанныеРасхожденийПоТекущемуДокументу = ?(Версия = 1, ДанныеРасхождений.РасхожденияВерсия1,ДанныеРасхождений.РасхожденияВерсия2);
	
	ДопустимыеСимволы = "1234567890,.-"+Символы.НПП;
	
	Для Каждого ЭлементРасхождений Из ДанныеРасхожденийПоТекущемуДокументу Цикл
		
		ВидРасхождений = ЭлементРасхождений.Значение;
		ИмяОбластиРасхождений = ЭлементРасхождений.Ключ;
		Попытка
			ОбластьДляОбработки = ТабличныйДокументВерсия.Область(ИмяОбластиРасхождений);
		Исключение
			//Нет такой области группы раскрытия. Не критично.
			Продолжить;
		КонецПопытки;
		
		Если ВидРасхождений = 1 Тогда
			ОбластьДляОбработки.ЦветФона = ПараметрыСравнения.ЦветаИзменений.ЦветФонаИзмененные;
			ОбластьДляОбработки.ЦветТекста = ПараметрыСравнения.ЦветаИзменений.ЦветТекстаИзмененные;
			
			ИмяОбластиСоответствия = "";
			СоответсвиеОбластей.Свойство(ИмяОбластиРасхождений,ИмяОбластиСоответствия);
			
			ТекстПримечания = "";
			ТекстШаблонаОсновной = НСтр("ru = 'Отличие: %1 - %2 = %3'");
			ТекстШаблонаОтрицательные = НСтр("ru = 'Отличие: %1 - (%2) = %3'");
			
			Если Версия = 1 Тогда
				
				СтрокаИзменений = ПараметрыСравнения.ИзмененныеОбласти.Добавить();
				СтрокаИзменений.ИмяОбласти = ИмяОбластиРасхождений;
				СтрокаИзменений.ВидРасхождений = ВидРасхождений;
				СтрокаИзменений.ОбластьВерх = ОбластьДляОбработки.Верх;
				СтрокаИзменений.ОбластьЛево = ОбластьДляОбработки.Лево;
				СтрокаИзменений.ОбластьСоответствия = ИмяОбластиСоответствия;
				
				Если ЗначениеЗаполнено(ИмяОбластиСоответствия) Тогда
					ОбластьДокумента2 = ПараметрыСравнения.ТабличныйДокументВерсия2.Области.Найти(ИмяОбластиСоответствия);
					Если ОбластьДокумента2 <> Неопределено Тогда
						ТекстПримечания = ОбластьДокумента2.Текст;
						// Пробуем преобразовать текстовое значение ячейки к числу.
					// При успешном преобразовании выводим более подробную информацию о сравнении.
						Если СтрРазделить(ТекстПримечания, ДопустимыеСимволы, Ложь).Количество() = 0 Тогда
							Попытка 
								ЗначениеЧисло1 = Число(ПараметрыСравнения.ТабличныйДокументВерсия1.Область(ИмяОбластиСоответствия).Текст);
								ЗначениеЧисло2 = Число(ТекстПримечания);
								ОтличиеЧисло = ЗначениеЧисло1 - ЗначениеЧисло2;
								ТекстПримечания = СтрШаблон(?(ЗначениеЧисло2 < 0, ТекстШаблонаОтрицательные, ТекстШаблонаОсновной), ЗначениеЧисло1, ЗначениеЧисло2, ОтличиеЧисло);
							Исключение
								
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(ИмяОбластиСоответствия) Тогда
					ОбластьДокумента1 = ПараметрыСравнения.ТабличныйДокументВерсия1.Области.Найти(ИмяОбластиСоответствия);
					Если ОбластьДокумента1 <> Неопределено Тогда
						ТекстПримечания = ОбластьДокумента1.Текст;
						// Пробуем преобразовать текстовое значение ячейки к числу.
						// При успешном преобразовании выводим более подробную информацию о сравнении.
						Если СтрРазделить(ТекстПримечания, ДопустимыеСимволы, Ложь).Количество() = 0 Тогда
							Попытка 
								ЗначениеЧисло1 = Число(ТекстПримечания);
								ЗначениеЧисло2 = Число(ПараметрыСравнения.ТабличныйДокументВерсия2.Область(ИмяОбластиСоответствия).Текст);
								ОтличиеЧисло = ЗначениеЧисло1 - ЗначениеЧисло2;
								ТекстПримечания = СтрШаблон(?(ЗначениеЧисло2 < 0, ТекстШаблонаОтрицательные, ТекстШаблонаОсновной), ЗначениеЧисло1, ЗначениеЧисло2, ОтличиеЧисло);
							Исключение
								
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			ОбластьДляОбработки.Примечание.Текст = ТекстПримечания;
			
		ИначеЕсли ВидРасхождений = 2 Тогда 
			
			ОбластьДляОбработки.ЦветФона = ПараметрыСравнения.ЦветаИзменений.ЦветФонаВоВтором;
			ОбластьДляОбработки.ЦветТекста = ПараметрыСравнения.ЦветаИзменений.ЦветТекстаВоВтором;
			
			СтрокаИзменений = ПараметрыСравнения.ИзмененныеОбласти.Добавить();
			СтрокаИзменений.ИмяОбласти = ИмяОбластиРасхождений;
			СтрокаИзменений.ВидРасхождений = ВидРасхождений;
			СтрокаИзменений.ОбластьВерх = ОбластьДляОбработки.Верх;
			СтрокаИзменений.ОбластьЛево = ОбластьДляОбработки.Лево;
			
		ИначеЕсли ВидРасхождений = 3 Тогда 
			ОбластьДляОбработки.ЦветФона = ПараметрыСравнения.ЦветаИзменений.ЦветФонаВПервом;
			ОбластьДляОбработки.ЦветТекста = ПараметрыСравнения.ЦветаИзменений.ЦветТекстаВПервом;
			
			СтрокаИзменений = ПараметрыСравнения.ИзмененныеОбласти.Добавить();
			СтрокаИзменений.ИмяОбласти = ИмяОбластиРасхождений;
			СтрокаИзменений.ВидРасхождений = ВидРасхождений;
			СтрокаИзменений.ОбластьВерх = ОбластьДляОбработки.Верх;
			СтрокаИзменений.ОбластьЛево = ОбластьДляОбработки.Лево;
		Иначе	
			ОбластьДляОбработки.ЦветФона = WebЦвета.Красный;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СброситьЦветаБланка(ТабличныйДокументДляЗаполнения)
	ОбластьВесьДокумент = ТабличныйДокументДляЗаполнения.Область();
	ОбластьВесьДокумент.ЦветФона = ЦветаСтиля.ЦветФонаПоля;
	ОбластьВесьДокумент.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
КонецПроцедуры

Функция ПолучитьАдресДереваБланкаПоСсылке(ОтчетСсылка) Экспорт
	
	ОтчетОбъект = ОтчетСсылка.ПолучитьОбъект();
	ОтчетОбъект.ПроверитьКонтекстИнициализирован();
	
	РежимРаскрытия 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ШаблонОтчета,"РаскрытиеВМакете");
	ВыводитьРаскрытиеВТеле  = (РежимРаскрытия = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета);
	
	ДеревоВыводимогоБланка = ОтчетОбъект.мДеревоСтраниц.Скопировать();
		
	СтрокиДерева = ДеревоВыводимогоБланка.Строки;

	МассивСтраниц = Новый Массив;
	БюджетнаяОтчетностьСервер.ЗаполнитьСтраницыБланкаПоИерархии(СтрокиДерева, МассивСтраниц);
	
	Для Каждого ТекСтраница Из МассивСтраниц Цикл
		
		Если ЗначениеЗаполнено(ТекСтраница.АдресБланка) Тогда
			ТабДокумент = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка);
			ТекНастройки = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
			
		Иначе
			СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(ОтчетОбъект.ШаблонОтчета,ТекСтраница.ИмяСтраницы);
			
			ТабДокумент = СтруктураСтраницы.Макет;
			ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		КонецЕсли;
		
		Если ТабДокумент=Неопределено Тогда	
			ТабДокумент = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
			
		ОтчетОбъект.мНастройкиБланка = ТекНастройки;
		
		МассивПоказателейСтраницы = ОтчетОбъект.ПолучитьМассивПоказателейСтраницы();
		ОтчетОбъект.ЗаполнитьМакет(ТабДокумент,МассивПоказателейСтраницы);

		Если ВыводитьРаскрытиеВТеле Тогда			
			ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабДокумент);
		КонецЕсли;
		
		ТекСтраница.АдресБланка = ПоместитьВоВременноеХранилище(ТабДокумент, Новый УникальныйИдентификатор);
	КонецЦикла;
	
	КолонкаАдресНастроек = ДеревоВыводимогоБланка.Колонки.Найти("АдресНастроек");
	ДеревоВыводимогоБланка.Колонки.Удалить(КолонкаАдресНастроек);
	
	АдресДереваБланка = ПоместитьВоВременноеХранилище(ДеревоВыводимогоБланка,Новый УникальныйИдентификатор);
	
	Возврат АдресДереваБланка;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ВЫВОДА БЛАНКА В EXCEL
//

//Используется для вывода текущей страницы бланка отчета в EXCEL с учетом быстрых отборов бланка
//
Процедура СформироватьФайлДляExcel(СтруктураПараметров, АдресХранилища) Экспорт
	
	ИсходныйТабДокумент = Новый ТабличныйДокумент;
	ИсходныйТабДокумент.Вывести(СтруктураПараметров.ТабличныйДокументОтчета);
	
	мСоответствиеПоиска = Неопределено;
	СтруктураПараметров.Свойство("мСоответствиеПоиска", мСоответствиеПоиска);
	
	УдалитьЛишниеСтрокиТабличногоДокумента(ИсходныйТабДокумент, мСоответствиеПоиска);
	
	ДанныеЧастейФайла = ОбработатьТабДокумент(ИсходныйТабДокумент);
	
	// Создаем многостраничный документ - с учетом разбивки по разделам.
	ТабДокПакет = Новый ПакетОтображаемыхДокументов;
	
	ЭлементПакета = ТабДокПакет.Состав.Добавить();
	ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ИсходныйТабДокумент);
	ЭлементПакета.Наименование = "Общий";
	
	Для Каждого ДанныеЧасти Из ДанныеЧастейФайла Цикл
		ЭлементПакета = ТабДокПакет.Состав.Добавить();
		ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ДанныеЧасти.ТабДокЛиста);
		ЭлементПакета.Наименование = ДанныеЧасти.ИмяЛиста;
	КонецЦикла;
	
	ИмяПакетногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ТабДокПакет.Записать(ИмяПакетногоФайла,ТипФайлаПакетаОтображаемыхДокументов.XLSX);
	
	ФайлДанных = Новый ДвоичныеДанные(ИмяПакетногоФайла);
	ПоместитьВоВременноеХранилище(ФайлДанных, АдресХранилища);
	
	УдалитьФайлы(ИмяПакетногоФайла);
	
КонецПроцедуры

//Используется для вывода в EXCEL всех страниц отчета
//
Процедура СформироватьФайлДляExcelПакетомОтчетов(СтруктураПараметров, АдресХранилища) Экспорт
	
	ОтчетСсылка = СтруктураПараметров.ОтчетСсылка;
	
	// Создаем многостраничный документ - с учетом разбивки по разделам.
	ТабДокПакет = Новый ПакетОтображаемыхДокументов;
	
	ОтчетОбъект = ОтчетСсылка.ПолучитьОбъект();
	ОтчетОбъект.ПроверитьКонтекстИнициализирован();
	СтрокиДерева = ОтчетОбъект.мДеревоСтраниц.Строки;
	
	СформироватьПакетТабличныхДокументовПоОтчету(ТабДокПакет, ОтчетОбъект, СтрокиДерева);
	
	ИтоговыйФайл = ПолучитьИмяВременногоФайла("xlsx");
	ТабДокПакет.Записать(ИтоговыйФайл,ТипФайлаПакетаОтображаемыхДокументов.XLSX);
	
	ТабДокПакет = Неопределено;
	
	ФайлДанных = Новый ДвоичныеДанные(ИтоговыйФайл);
	ПоместитьВоВременноеХранилище(ФайлДанных, АдресХранилища);
	
	УдалитьФайлы(ИтоговыйФайл);
	
КонецПроцедуры

Процедура СформироватьПакетТабличныхДокументовПоОтчету(ТабДокПакет, ОтчетОбъект, СтрокиДерева) Экспорт
	
	РежимРаскрытия 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ШаблонОтчета,"РаскрытиеВМакете");
	ВыводитьРаскрытиеВТеле  = (РежимРаскрытия = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета);
		
	// В зависимости от того, есть ли в бланке несколько страниц, выбираем способ вывода в Excel:
	// Если страница одна, то используем старый способ, с областями - разделителями;
	// Если несколько, то каждая страница бланка - это лист Excel, а общий лист - это объединение этих страниц, 
	// Общий лист нужен для сохранения файла в платформе до 8.3.12, затем от него можно отказаться.
	ИменаСтраниц = Новый Соответствие;
	
	МассивСтраниц = Новый Массив;
	БюджетнаяОтчетностьСервер.ЗаполнитьСтраницыБланкаПоИерархии(СтрокиДерева, МассивСтраниц);
	
	ТолькоОднаСтраница = МассивСтраниц.Количество() = 1;
	
	Для Инд = 0 По МассивСтраниц.Количество()-1 Цикл
		ТекСтраница = МассивСтраниц[Инд];
		
		Если ЗначениеЗаполнено(ТекСтраница.АдресБланка) Тогда
			ТабДокумент = ПолучитьИзВременногоХранилища(ТекСтраница.АдресБланка);
			ТекНастройки = ПолучитьИзВременногоХранилища(ТекСтраница.АдресНастроек);
			
		Иначе
			СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(ОтчетОбъект.ШаблонОтчета,ТекСтраница.ИмяСтраницы);
			
			ТабДокумент = СтруктураСтраницы.Макет;
			ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		КонецЕсли;
		
		Если ТабДокумент=Неопределено Тогда	
			ТабДокумент = Новый ТабличныйДокумент;
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
	
		ОтчетОбъект.мНастройкиБланка = ТекНастройки;
		
		Если ТолькоОднаСтраница Тогда
			ОтчетОбъект.ЗаполнитьМакет(ТабДокумент);
			
			Если ВыводитьРаскрытиеВТеле Тогда			
				ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабДокумент);
			КонецЕсли;
			
			ЭлементПакета = ТабДокПакет.Состав.Добавить();
			ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабДокумент);
			ЭлементПакета.Наименование = "Общий";
			
			УдалитьЛишниеСтрокиТабличногоДокумента(ТабДокумент, Неопределено);
			
			ДанныеЧастейФайла = ОбработатьТабДокумент(ТабДокумент);
			
			Для Каждого ДанныеЧасти Из ДанныеЧастейФайла Цикл
				ЭлементПакета = ТабДокПакет.Состав.Добавить();
				ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ДанныеЧасти.ТабДокЛиста);
				ЭлементПакета.Наименование = ДанныеЧасти.ИмяЛиста;
			КонецЦикла;

		Иначе
			МассивПоказателейСтраницы = ОтчетОбъект.ПолучитьМассивПоказателейСтраницы();
			
			ОтчетОбъект.ЗаполнитьМакет(ТабДокумент,МассивПоказателейСтраницы);
			
			Если ВыводитьРаскрытиеВТеле Тогда			
				ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабДокумент);
			КонецЕсли;
			
			УдалитьЛишниеСтрокиТабличногоДокумента(ТабДокумент, Неопределено);
			
			ИмяСтраницы = "XLS_"+ТекСтраница.ИмяСтраницы;
			ИменаСтраниц.Вставить(ИмяСтраницы, ТекСтраница.Наименование);
			
			ПерваяСтрокаЛиста = ТабДокумент.Область(1,,1,);
			ПерваяСтрокаЛиста.Имя = ИмяСтраницы;
			
			ЭлементПакета = ТабДокПакет.Состав.Добавить();
			ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабДокумент);
			ЭлементПакета.Наименование = ТекСтраница.Наименование;
		КонецЕсли;			
				
	КонецЦикла;	
		
КонецПроцедуры

Процедура СформироватьФайлыДляExcelВАрхиве(СтруктураПараметров, АдресХранилища) Экспорт
	
	ШаблонЗаголовка = НСтр("ru = '%1, Аналитика: %2, %3, %4.'");
	
	ТекИмяАрхива     = ПолучитьИмяВременногоФайла("zip");
	ТекКаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
	СоздатьКаталог(ТекКаталогАрхива);
	ТекАрхиватор = Новый ЗаписьZipФайла(ТекИмяАрхива);
		
	МассивОтчетов = СтруктураПараметров.МассивОтчетов;
	
	МассивИмен = Новый Массив;
	Для Каждого ОтчетСсылка Из МассивОтчетов Цикл	
		
		// Создаем многостраничный документ - с учетом разбивки по разделам.
		ТабДокПакет = Новый ПакетОтображаемыхДокументов;
		
		ОтчетОбъект = ОтчетСсылка.ПолучитьОбъект();
		ОтчетОбъект.ПроверитьКонтекстИнициализирован();
		СтрокиДерева = ОтчетОбъект.мДеревоСтраниц.Строки;
		
		СформироватьПакетТабличныхДокументовПоОтчету(ТабДокПакет, ОтчетОбъект, СтрокиДерева);
		
		ИтоговыйФайл = ПолучитьИмяВременногоФайла("xlsx");
		ТабДокПакет.Записать(ИтоговыйФайл,ТипФайлаПакетаОтображаемыхДокументов.XLSX);
				
		ВидОтчетаКратко = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ВидОтчета,"Наименование"));
		ПозицияРазделителя = СтрНайти(ВидОтчетаКратко,",");
		Если ПозицияРазделителя > 0 Тогда
			ВидОтчетаКратко = Лев(ВидОтчетаКратко,ПозицияРазделителя-1);
		КонецЕсли;
		
		Период = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ПериодОтчета,"Наименование");
		
		ИмяТекФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗаголовка,
					ВидОтчетаКратко,
					Строка(ОтчетОбъект.ОписаниеАналитики),
					Период,
					СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.Организация,"Наименование")));
					
		ИмяТекФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяТекФайла);
		
		Если СтрДлина(ИмяТекФайла)>130 Тогда
			//из-за слишком длинного имени может возникать ошибка сохранения файла
			ИмяТекФайла = Лев(ИмяТекФайла,130);
		КонецЕсли;
		
		ИмяТекФайла = ПолучитьУникальноеИмя(МассивИмен,ИмяТекФайла)+".xlsx";
				
		ПереместитьФайл(ИтоговыйФайл, ТекКаталогАрхива + ИмяТекФайла);
		ТекАрхиватор.Добавить(ТекКаталогАрхива + ИмяТекФайла);
					
	КонецЦикла;
	
	ТекАрхиватор.Записать();
	
	ФайлДанных = Новый ДвоичныеДанные(ТекИмяАрхива);
	ПоместитьВоВременноеХранилище(ФайлДанных, АдресХранилища);
	
	УдалитьФайлы(ТекИмяАрхива);
	
КонецПроцедуры

Функция ПолучитьУникальноеИмя(МассивИмен,ИмяТекФайла)
	Инд = 1;
	ПроверяемоеИмя = ИмяТекФайла;
	Пока МассивИмен.Найти(ПроверяемоеИмя) <> Неопределено Цикл
		ПроверяемоеИмя = ИмяТекФайла + "("+Инд+")";
		Инд = Инд + 1;
	КонецЦикла;
	МассивИмен.Добавить(ПроверяемоеИмя);
	
	Возврат ПроверяемоеИмя;
КонецФункции

Процедура УдалитьЛишниеСтрокиТабличногоДокумента(ИсходныйТабДокумент, мСоответствиеПоиска)
	
	НомераСтрокДляУдаления = Новый ТаблицаЗначений;
	НомераСтрокДляУдаления.Колонки.Добавить("НомСтр",Новый ОписаниеТипов("Число"));
	
	//Находим пустые строки в группах раскрытия (по тексту ячейки):
	ТекстПустойСтроки = "< Для добавления строк выделите данную область и нажмите кнопку «Добавить строку». >";
	НайденнаяПустаяЯчейка = ИсходныйТабДокумент.НайтиТекст(ТекстПустойСтроки);
	Пока НайденнаяПустаяЯчейка <> Неопределено Цикл
		НовСтр = НомераСтрокДляУдаления.Добавить();
		НовСтр.НомСтр = НайденнаяПустаяЯчейка.Верх;
		
		НайденнаяПустаяЯчейка = ИсходныйТабДокумент.НайтиТекст(ТекстПустойСтроки, НайденнаяПустаяЯчейка);
	КонецЦикла;
	
	//Находим скрытые строки:
	Если мСоответствиеПоиска <> Неопределено Тогда
		Для Каждого КлючИЗначение Из мСоответствиеПоиска Цикл
			Для Каждого ИмяСкрытойОбласти Из КлючИЗначение.Значение Цикл
				ОбластьСкрытойЯчейки = ИсходныйТабДокумент.Область(ИмяСкрытойОбласти);
				Для НомСтрДляУдаления = ОбластьСкрытойЯчейки.Верх По ОбластьСкрытойЯчейки.Низ Цикл
					НовСтр = НомераСтрокДляУдаления.Добавить();
					НовСтр.НомСтр = НомСтрДляУдаления;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	НомераСтрокДляУдаления.Сортировать("НомСтр Убыв");
	
	Верх = Неопределено;
	Низ = Неопределено;
	ТекЗначение = Неопределено;
	ПредЗначение = Неопределено;
	Для Инд = 0 По НомераСтрокДляУдаления.Количество()-1 Цикл
		
		ТекЗначение = НомераСтрокДляУдаления[Инд].НомСтр;
		Если ТекЗначение = ПредЗначение Тогда
			Продолжить;
		КонецЕсли;
		
		Если Низ = Неопределено Тогда
			Низ = ТекЗначение;//запомнили нижнее значение
		КонецЕсли;
		
		Если ПредЗначение<> Неопределено Тогда
			Если ПредЗначение -1 <> ТекЗначение Тогда 
				//если текущее значение отличается больше чем на 1 от предыдущего, 
				//значит диапазон прервался, удалим законченный диапазон
				СтрокаТабДок = ИсходныйТабДокумент.Область(ПредЗначение,,Низ,);
				ИсходныйТабДокумент.УдалитьОбласть(СтрокаТабДок, ТипСмещенияТабличногоДокумента.ПоВертикали);				
				Низ = ТекЗначение;//запомнили новое нижнее значение
			КонецЕсли;
		КонецЕсли;
		
		ПредЗначение = ТекЗначение;
		
	КонецЦикла;
	
	Если Низ <> Неопределено Тогда
		//последний диапазон строк для удаления
		СтрокаТабДок = ИсходныйТабДокумент.Область(ПредЗначение,,Низ,);
		ИсходныйТабДокумент.УдалитьОбласть(СтрокаТабДок, ТипСмещенияТабличногоДокумента.ПоВертикали);					
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьТабДокумент(ИсходныйТабДокумент)
		
	//Получаем предопределенные области - границы разделов:
	ТаблицаВыводимыхОбластей = Новый ТаблицаЗначений;
	ТаблицаВыводимыхОбластей.Колонки.Добавить("Имя");
	ТаблицаВыводимыхОбластей.Колонки.Добавить("Вид");
	ТаблицаВыводимыхОбластей.Колонки.Добавить("Верх");
	ТаблицаВыводимыхОбластей.Колонки.Добавить("Низ");

	Для Каждого ИменованнаяОбласть Из ИсходныйТабДокумент.Области Цикл
		ИмяОбласти = ИменованнаяОбласть.Имя;
		
		Если Найти(ИмяОбласти,"XLS_Раздел_")>0 Тогда
			СтрокаРаздела = ТаблицаВыводимыхОбластей.Добавить();
			СтрокаРаздела.Имя = ИмяОбласти;
			СтрокаРаздела.Вид = "Раздел";
			СтрокаРаздела.Верх = ИменованнаяОбласть.Верх;
			СтрокаРаздела.Низ = ИменованнаяОбласть.Низ;
		ИначеЕсли Найти(ИмяОбласти,"XLS_Шапка_")>0 Тогда
			//ИменаШапок.Добавить(ИмяОбласти);
			СтрокаРаздела = ТаблицаВыводимыхОбластей.Добавить();
			СтрокаРаздела.Имя = ИмяОбласти;
			СтрокаРаздела.Вид = "Шапка";
			СтрокаРаздела.Верх = ИменованнаяОбласть.Верх;
			СтрокаРаздела.Низ = ИменованнаяОбласть.Низ;
		ИначеЕсли Найти(ИмяОбласти,"XLS_Граница_") Тогда
			СтрокаРаздела = ТаблицаВыводимыхОбластей.Добавить();
			СтрокаРаздела.Имя = ИмяОбласти;
			СтрокаРаздела.Вид = "Граница";
			СтрокаРаздела.Верх = ИменованнаяОбласть.Верх;
			СтрокаРаздела.Низ = ИменованнаяОбласть.Низ;
		КонецЕсли;
	КонецЦикла;
	ТаблицаВыводимыхОбластей.Сортировать("Верх");
	
	//Данные областей: номера, имена листов и табличные документы для каждого листа:
	ДанныеЧастейФайла = Новый ТаблицаЗначений;
	ДанныеЧастейФайла.Колонки.Добавить("Номер");
	ДанныеЧастейФайла.Колонки.Добавить("ИмяЛиста");
	ДанныеЧастейФайла.Колонки.Добавить("ТабДокЛиста");
	
	ТекущаяШапка = Неопределено;
	НомерРаздела = 1;
	
	КоличествоСтрок = ТаблицаВыводимыхОбластей.Количество()-1;
	Для Инд = 0 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаВыводимыхОбластей[Инд];
		
		Если СтрокаТаблицы.Вид = "Шапка" Тогда
			ТекущаяШапка = СтрокаТаблицы;
			
		ИначеЕсли СтрокаТаблицы.Вид = "Раздел" Тогда	
			ИмяРаздела = СтрокаТаблицы.Имя;
			ОбластьНачалоРаздела = ИсходныйТабДокумент.Область(ИмяРаздела);
			
			//Шаблон имен областей:
			//XLS_Раздел_Имя_области, XLS_Шапка_M, XLS_Граница_M, где:
			// XLS_Раздел_,XLS_Шапка_,XLS_Граница_ - предопределенные имена;
			// M - Произвольные символы, для возомжности задания нескольких шапок
			// Имя_области - имя, которое выводится в заголовке листа, символ _ заменяется пробелом.
			
			СтрокаДляАнализа = СтрЗаменить(ИмяРаздела, "XLS_Раздел_", "");
			ИмяЛиста = СтрЗаменить(СтрокаДляАнализа, "_", " ");
			
			//Заполняем данные частей:
			СтрокаЧастьФайла = ДанныеЧастейФайла.Добавить();
			СтрокаЧастьФайла.Номер = Строка(100+НомерРаздела);//100 добаляется для корректной сортировки
			СтрокаЧастьФайла.ИмяЛиста = ИмяЛиста;
			
			//Значения по умолчанию:
			//Строки до начала шапки/текущего раздела 
			НачалоДиапазона1 = 1;	//Значение фиксировано
			КонецДиапазона1 = ОбластьНачалоРаздела.Верх-1;
			//Строки между шапкой и началом текущего раздела
			НачалоДиапазона2 = 0;
			КонецДиапазона2 = 0;
			//Строки после раздела
			НачалоДиапазона3 = ОбластьНачалоРаздела.Низ+1;
			КонецДиапазона3 = 0;//По умолчанию выводится весь документ
			
			//Опеределяем, где начинается область для вывода:
			Если ТекущаяШапка <> Неопределено Тогда
				//Вывод раздела с шапкой
				КонецДиапазона1 = ТекущаяШапка.Верх - 1;
				
				//Получаем номера строк между шапкой и началом раздела:
				НачалоДиапазона2 = ТекущаяШапка.Низ+1;
				КонецДиапазона2 = ОбластьНачалоРаздела.Верх-1;
			КонецЕсли;
			
			//Раздел заканчивается с началом любой другой области (граница, новый раздел, шапка).
			Если Инд<КоличествоСтрок Тогда
				СтрокаДляНижнейГраницы = ТаблицаВыводимыхОбластей[Инд+1];
				ГраницаПоРазделу = СтрокаДляНижнейГраницы.Верх;
				Если ГраницаПоРазделу >= НачалоДиапазона3 Тогда
					НачалоДиапазона3 = ГраницаПоРазделу;
					КонецДиапазона3 = ИсходныйТабДокумент.ВысотаТаблицы;
				КонецЕсли;	
			КонецЕсли;	
			
			//Удаляем диапазоны, не использующиеся в разделе:
			ТабДокЛиста = Новый ТабличныйДокумент;
			ТабДокЛиста.Вывести(ИсходныйТабДокумент);
			
			Диапазон3 = ТабДокЛиста.Область(НачалоДиапазона3,,КонецДиапазона3);
			ТабДокЛиста.УдалитьОбласть(Диапазон3, ТипСмещенияТабличногоДокумента.ПоВертикали);
			
			Диапазон2 = ТабДокЛиста.Область(НачалоДиапазона2,,КонецДиапазона2);
			ТабДокЛиста.УдалитьОбласть(Диапазон2, ТипСмещенияТабличногоДокумента.ПоВертикали);
			
			Диапазон1 = ТабДокЛиста.Область(НачалоДиапазона1,,КонецДиапазона1);
			ТабДокЛиста.УдалитьОбласть(Диапазон1, ТипСмещенияТабличногоДокумента.ПоВертикали);
			
			СтрокаЧастьФайла.ТабДокЛиста = ТабДокЛиста;
			
			НомерРаздела = НомерРаздела + 1;
		КонецЕсли;	
	КонецЦикла;
	
	ДанныеЧастейФайла.Сортировать("Номер");
	
	Возврат ДанныеЧастейФайла;
	
КонецФункции

Функция НовыйНомерСтрокиВФайле(НомСтр, ТекущиеДиапазоныУдаления, СмещенияДиапазона) 
	
	НовыйНомСтр = НомСтр;
	
	Если НомСтр >= ТекущиеДиапазоныУдаления.НачалоДиапазона1 И 
		НомСтр <= ТекущиеДиапазоныУдаления.КонецДиапазона1 Тогда
		//Удаляем объединенные ячейки до раздела
		НовыйНомСтр = Неопределено;
	
	ИначеЕсли СмещенияДиапазона.ПослеШапки > 0 И 
		НомСтр >= ТекущиеДиапазоныУдаления.НачалоДиапазона2 И 
		НомСтр <= ТекущиеДиапазоныУдаления.КонецДиапазона2 Тогда
		//Удаляем объединенные ячейки между шапкой и началом раздела
		НовыйНомСтр = Неопределено;
		
	ИначеЕсли НомСтр >= ТекущиеДиапазоныУдаления.НачалоДиапазона3 И 
		НомСтр <= ТекущиеДиапазоныУдаления.КонецДиапазона3 Тогда
		//Удаляем объединенные ячейки после раздела
		НовыйНомСтр = Неопределено;
	
	Иначе	
		
		Если СмещенияДиапазона.ПослеШапки = 0 И
			НомСтр > ТекущиеДиапазоныУдаления.КонецДиапазона1 И
			НомСтр < ТекущиеДиапазоныУдаления.НачалоДиапазона3 Тогда
			
			//Строки между 1 и 3 диапазоном перенумеровываем с учетом одного смещения
			НовыйНомСтр = НомСтр-СмещенияДиапазона.ДоРаздела;
			
		ИначеЕсли СмещенияДиапазона.ПослеШапки > 0 И
			НомСтр > ТекущиеДиапазоныУдаления.КонецДиапазона1 И
			НомСтр < ТекущиеДиапазоныУдаления.НачалоДиапазона2 Тогда
			
			//Строки между 1 и 2 диапазоном перенумеровываем с учетом одного смещения
			НовыйНомСтр = НомСтр-СмещенияДиапазона.ДоРаздела;
			
		ИначеЕсли СмещенияДиапазона.ПослеШапки > 0 И
			НомСтр > ТекущиеДиапазоныУдаления.КонецДиапазона2 И
			НомСтр < ТекущиеДиапазоныУдаления.НачалоДиапазона3 Тогда
			
			//Строки между 2 и 3 диапазоном перенумеровываем с учетом двух смещений
			НовыйНомСтр = НомСтр-СмещенияДиапазона.ДоРаздела-СмещенияДиапазона.ПослеШапки;	
		Иначе
			//Строки после 3 диапазона перенумеровываем с учетом трех смещений
			НовыйНомСтр = НомСтр-СмещенияДиапазона.ДоРаздела-СмещенияДиапазона.ПослеШапки-СмещенияДиапазона.ПослеРаздела;
			
		КонецЕсли;	
		
		НовыйНомСтр = Формат(НовыйНомСтр, "ЧГ=0");
			
	КонецЕсли;
	
	Возврат НовыйНомСтр;
	
КонецФункции

Функция ПолучитьКоординатыЯчейки(АдресЯчейки)
	
	ДанныеЯчейки = Новый Структура;
		
	ЯчейкаНомСтр = 1;
	ЯчейкаНомКол = "A";
	
	Для СчСимволов=1 По СтрДлина(АдресЯчейки) Цикл
		КодТекущегоСимвола = КодСимвола(Сред(АдресЯчейки,СчСимволов,1));
		Если КодТекущегоСимвола >= 48 И КодТекущегоСимвола <= 57 Тогда
			ЯчейкаНомСтр = Число(Сред(АдресЯчейки,СчСимволов));
			ЯчейкаНомКол = Лев(АдресЯчейки,СчСимволов-1);
			Прервать;
		КонецЕсли;
	КонецЦикла;				
	
	ДанныеЯчейки.Вставить("НомСтр", ЯчейкаНомСтр);
	ДанныеЯчейки.Вставить("НомКол", ЯчейкаНомКол);
		
	Возврат ДанныеЯчейки;
	
КонецФункции					

