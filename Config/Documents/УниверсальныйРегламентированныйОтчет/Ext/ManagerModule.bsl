// Функция создания таблицы значений, предназначеной для формирования расшифровки автозаполнения.
//
Функция СоздатьТаблицуДанныхРасшифровки() Экспорт

	ТаблицаРасшифровки = Новый ТаблицаЗначений;
	ТаблицаРасшифровки.Колонки.Добавить("Наименование");
	ТаблицаРасшифровки.Колонки.Добавить("Значение");
	ТаблицаРасшифровки.Колонки.Добавить("ОпцииРасшифровки", Новый ОписаниеТипов("СписокЗначений"));
	ТаблицаРасшифровки.Колонки.Добавить("ОбластьЗаполнения");
	
	Возврат ТаблицаРасшифровки;

КонецФункции // ПолучитьТаблицуДанныхРасшифровки()

// Функция конструирования опций расшифровки стандартного отчета.
//
Функция СоздатьОпцииРасшифровкиДляСтандартногоОтчета(ИмяОтчета) Экспорт

	ОпцииРасшифровки = Новый Структура("Отчет",ИмяОтчета);
	
	ОпцииРасшифровки.Вставить("РеквизитыФормы",Новый Структура);
	ОпцииРасшифровки.Вставить("Показатели"    ,Новый Структура);
	
	Отбор = Новый ДеревоЗначений;
	Отбор.Колонки.Добавить("ЛевоеЗначение");
	Отбор.Колонки.Добавить("ВидСравнения");
	Отбор.Колонки.Добавить("ПравоеЗначение");
	Отбор.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Отбор.Колонки.Добавить("ТипГруппы");
	
	Группировка = Новый ТаблицаЗначений;
	Группировка.Колонки.Добавить("Поле");
	Группировка.Колонки.Добавить("Представление");
	Группировка.Колонки.Добавить("ТипГруппировки"); // Перечисления.ТипыДетализацииСтандартныхОтчетов
		
	ОпцииРасшифровки.Вставить("Отбор"		,Отбор);
	ОпцииРасшифровки.Вставить("Группировка" ,Группировка);
	
	Возврат ОпцииРасшифровки;

КонецФункции // ПолучитьОпцииРасшифровкиДляСтандартногоОтчета()

// Подключаемые обработчики в командах формы.

// Создание коллекции подключаемых обработчиков.
//  В данной коллекции размещаются описания команд, которые отображаются в форме
//  документа УниверсальныйРегламентированныйОтчет и вызывают подключаемые алгоритмы.
//
Функция СоздатьПодключаемыеОбработчики() Экспорт

	ТаблицаОбработчиков = Новый ТаблицаЗначений;
	ТаблицаОбработчиков.Колонки.Добавить("Класс"    , Новый ОписаниеТипов("Строка"));
	ТаблицаОбработчиков.Колонки.Добавить("Имя"      , Новый ОписаниеТипов("Строка"));
	ТаблицаОбработчиков.Колонки.Добавить("Синоним"  , Новый ОписаниеТипов("Строка"));
	ТаблицаОбработчиков.Колонки.Добавить("Параметры", Новый ОписаниеТипов("Структура"));
	ТаблицаОбработчиков.Колонки.Добавить("ПрограммныйИнтерфейс", Новый ОписаниеТипов("ПеречислениеСсылка.ПрограммныеИнтерфейсы"));
	
	Возврат ТаблицаОбработчиков;
	
КонецФункции // СоздатьПодключаемыеОбработчики()

// Добавляет команду действия для подключаемых обработчиков событий формы
//
// Параметры:
//
//  Обработчики - Коллекция обработчиков
//
//  Команда     - Идентификатор действия
//
//  Синоним     - Пользовательское представление действия
//
Процедура ДобавитьДействие(Обработчики, Знач Команда, Знач Синоним) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Класс   = "Действие";
	Обработчик.Имя     = Команда;
	Обработчик.Синоним = Синоним;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("Действие", Команда);
	
	Обработчик.Параметры = ПараметрыОбработчика;

КонецПроцедуры // ДобавитьДействие()

// Добавляет команду открытия формы для подключаемых обработчиков событий формы
//
// Параметры:
//
//  Обработчики - Коллекция обработчиков
//
//  ИмяФормы    - Имя открываемой формы. Механизм позволяет открыть форму внешней обработки
//                либо, любую другую форму конфигурации.
//                Если имя формы не содержит полного пути вида Справочник.ИмяСправочника.ФормаОбъекта
//                то будет открыта форма подключенной обработки с заданным именем.
//
//  Синоним     - Пользовательское представление действия
//
//  Параметры   - структура параметров открываемой формы.
//
Процедура ДобавитьОткрытиеФормы(Обработчики, Знач ИмяФормы, Знач Синоним, Знач Параметры = Неопределено) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Класс     = "ОткрытиеФормы";
	Обработчик.Имя       = СтрЗаменить(ИмяФормы,".","");
	Обработчик.Синоним   = Синоним;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ИмяФормы"      , ИмяФормы);
	ПараметрыОбработчика.Вставить("ПараметрыФормы", Параметры);
	
	Обработчик.Параметры = ПараметрыОбработчика;

КонецПроцедуры // ДобавитьОткрытиеФормы()

// Добавляет команду открытия формы для подключаемых обработчиков событий формы.
//  после закрытия формы будет выполнено указанное действие.
//
// Параметры:
//
//  Обработчики - Коллекция обработчиков
//
//  ИмяФормы    - Имя открываемой формы. Механизм позволяет открыть форму внешней обработки
//                либо, любую другую форму конфигурации.
//                Если имя формы не содержит полного пути вида Справочник.ИмяСправочника.ФормаОбъекта
//                то будет открыта форма подключенной обработки с заданным именем.
//
//  Действие    - Имя действия, которое будет выполнено после закрытия формы.
//
//  Синоним     - Пользовательское представление действия
//
//  Параметры   - структура параметров открываемой формы.
//
Процедура ДобавитьОткрытиеФормыИДействие(Обработчики, Знач ИмяФормы, Знач Действие, Знач Синоним, Знач Параметры = Неопределено) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Класс     = "ОткрытиеФормыИДействие";
	Обработчик.Имя       = СтрЗаменить(ИмяФормы,".","");
	Обработчик.Синоним   = Синоним;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ИмяФормы"      , ИмяФормы);
	ПараметрыОбработчика.Вставить("Действие"      , Действие);
	ПараметрыОбработчика.Вставить("ПараметрыФормы", Параметры);
	
	Обработчик.Параметры = ПараметрыОбработчика;

КонецПроцедуры // ДобавитьОткрытиеФормыИДействие()


