&НаКлиенте
Функция ДополнитьСтруктуруПодбора()

	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",	Объект.СчетУчета);
	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект) Тогда
		ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	КонецЕсли;

	ПараметрыПодбора.Вставить("Подразделение",				Объект.Подразделение);
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",			ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ЕстьЦена",					Истина);
	ПараметрыПодбора.Вставить("ВыводитьНулевуюНоменклатуру",Истина);
	ПараметрыПодбора.Вставить("ИмяТаблицы",					"Материалы");
	ПараметрыПодбора.Вставить("ПоказыватьЦены",				Истина);

	Если ЭтоВозвратИзПользования(Объект.ВидПоступления) Тогда
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",				Истина);
		ПараметрыПодбора.Вставить("ПроверятьОстаткиВПользовании",	Истина);
		ПараметрыПодбора.Вставить("КонтрагентОстатковВПользовании",	Объект.Контрагент);
		Если ЗначениеЗаполнено(Объект.ЦМОПриВозврате) Тогда
			ПараметрыПодбора.Вставить("ЦМО", Объект.ЦМОПриВозврате);
			ПараметрыПодбора.Вставить("Подразделение", Объект.ПодразделениеПриВозврате);
		Иначе
			ПараметрыПодбора.Вставить("ЦМО", Объект.ЦМО);
			ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);
		КонецЕсли;
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗИК.ВозвратИзАренды") Тогда
			ПараметрыПодбора.Вставить("СчетОстатковВПользовании", ЭтотОбъект.КэшПараметров.Локальные.Счет25);
		ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение(
			"Перечисление.ВидыПоступленийМЗИК.ВозвратИзБезвПользования") Тогда
			ПараметрыПодбора.Вставить("СчетОстатковВПользовании", ЭтотОбъект.КэшПараметров.Локальные.Счет26);
			ПараметрыПодбора.Вставить("ВидБезвозмездногоПользования", Объект.ВидБезвозмездногоПользования);
			ПараметрыПодбора.Вставить("ИспользоватьВидБезвозмездногоПользования", Истина);
		КонецЕсли;
	КонецЕсли;
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	ПоступлениеНаСчет106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	УстановитьСчетУчетаИзШапки = НЕ УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
		И Не ПоступлениеНаСчет106;
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);			
		Если УстановитьСчетУчетаИзШапки Тогда
			НоваяСтрока.СчетУчета = Объект.СчетУчета;
		ИначеЕсли ПоступлениеНаСчет106
			Или ВсеСчета108.НайтиПоЗначению(НоваяСтрока.СчетУчета) = Неопределено Тогда
			// Из подбора возвращаеся счет 108.хх. Его нужно заменить на 106.хх
			НоваяСтрока.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчета));
        НоваяСтрока.КоличествоМест = 1;
		НоваяСтрока.Коэффициент    = 1;
	КонецЦикла;	
КонецПроцедуры

