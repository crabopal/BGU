Процедура СчетУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// Старые значения (до изменения) запомним в кэше в локальных параметрах.
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетУчета", Объект.СчетУчета);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	
	Если ЭтотОбъект.КэшПараметров.Локальные.СчетУчета <> Объект.СчетУчета Тогда
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.КэшПараметров.Локальные.СчетУчета)
				Или Объект.Материалы.Количество() = 0 Тогда
			// Если счет учета был пустой или в таблице нет материалов,
			// то дополнительный вопрос не требуется.
			СчетУчетаПриИзмененииНаКлиенте();
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru = 'При изменении счета учета документа будет изменен счет учета в таблице ""Материалы"".
			|Изменить счет учета?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить счет учета'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять счет учета'"));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОбИзмененииСчетаУчета", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);
		Возврат;
		
	КонецЕсли;
	
	СчетУчетаПриИзмененииНаКлиенте();
	
КонецПроцедуры

