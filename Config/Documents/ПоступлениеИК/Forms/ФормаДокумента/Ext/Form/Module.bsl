&НаКлиенте
Процедура ПослеВопросаОтменитьПроведениеПередЗаполнениемДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеТаблицыАвансыЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьАвансыНаСервере();	
	КонецЕсли;	
	
КонецПроцедуры	
 
&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПериодЗаполнения = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗаполнения = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Документы.ПоступлениеИК.ЗаполнитьПоОстаткамАвансов(Объект, ПериодЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбязательныеПоляДляЗаполненияЗаполнены()
	
	Результат = Истина;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Объект.Организация");
		Результат = Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Контрагент""'"),, "Объект.Контрагент");
		Результат = Ложь;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьФлагОтразитьВМежотчетномПериодеПриИзмененииДаты()
	ВидМежотчетногоПериодаДоИзменения = Объект.ВидМежотчетногоПериода;
	БухгалтерскийУчетКлиент.ОчиститьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	Если Объект.ВидМежотчетногоПериода <> ВидМежотчетногоПериодаДоИзменения Тогда
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	ОчиститьФлагОтразитьВМежотчетномПериодеПриИзмененииДаты();

	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или ((УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
				Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект)) 
			И УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
				ЭтотОбъект.КэшПараметров.Дата,
				ЭтотОбъект.КэшПараметров.Организация,
				Объект.Дата,
				Объект.Организация));
		
	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	КонецЕсли;

	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект) Тогда
			
		УправлениеМатериальнымиЗапасами.ОбработатьИзменениеПримененияДетальногоКЭК340и440(ЭтотОбъект,
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация);
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		ЗаполнитьОтветственныеЛица();
		ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьОтветственного();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяПерезаполнитьСписокСчетовУчетаВШапке()
	ДоИзмененияТолько108 = ВидПоступленияТолькоСчета108(ВидПоступленияДоИзменения);
	ПослеИзмененияТолько108 = ВидПоступленияТолькоСчета108(Объект.ВидПоступления);
	Возврат ДоИзмененияТолько108 <> ПослеИзмененияТолько108;
КонецФункции

&НаСервере
Процедура ОбновитьДанныеСчетовВФорме()
	ЗаполнитьДанныеСчетовВФорме();
	Если Элементы.СчетУчета.СписокВыбора.НайтиПоЗначению(Объект.СчетУчета) = Неопределено Тогда
		Объект.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме = Неопределено)
	
	Элементы.СчетУчета.СписокВыбора.Очистить();
	
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать105 = Ложь;
	ПараметрыЗаполненияСчета.Включать108 = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовые = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовыеИК = ВидПоступленияТолькоСчета108(Объект.ВидПоступления);
	ПараметрыЗаполненияСчета.Включать106ИК = Не ВидПоступленияТолькоСчета108(Объект.ВидПоступления);
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);
	
	ДополнительныеСубконтоСчетов = Новый ФиксированноеСоответствие(ПараметрыЗаполненияСчета.ВидыСубконтоСчетов);
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКЭШПараметровФормыЛокальныеСчета()
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ИспользуемыеСчета = Новый Соответствие;
	ИспользуемыеСчета.Вставить("108.00", "Счет108");
	ИспользуемыеСчета.Вставить("108.56", "Счет10856");
	ИспользуемыеСчета.Вставить("106.50", "Счет106");
	ИспользуемыеСчета.Вставить("106.56", "Счет10656");
	ИспользуемыеСчета.Вставить("25", "Счет25");
	ИспользуемыеСчета.Вставить("26", "Счет26");
	
	КодыСчетов = Новый Массив;
	Для Каждого ИспользуемыйСчет Из ИспользуемыеСчета Цикл
		КодыСчетов.Добавить(ИспользуемыйСчет.Ключ);
	КонецЦикла;
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(СтрСоединить(КодыСчетов, ","), ДатаСчетов, Истина,
		Объект.Организация);
		
	Для Каждого ПолученныйСчет Из СписокСчетов Цикл
		КлючСчета = ИспользуемыеСчета.Получить(Строка(ПолученныйСчет));
		Если КлючСчета <> Неопределено Тогда
			ЭтотОбъект.КэшПараметров.Локальные.Вставить(КлючСчета, ПолученныйСчет);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидПоступленияТолькоСчета108(ВидПоступления)
	
	Возврат ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗИК.ВозвратИзАренды")
		Или ВидПоступления =ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗИК.ВозвратИзБезвПользования");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОтветственныеЛица()
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, ДатаДокумента, Объект.Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииСчетаУчета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Объект.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.СчетУчета;
		Возврат;
	КонецЕсли;
	
	СчетУчетаПриИзмененииНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзмененииНаКлиенте()

	СчетУчетаПриИзмененииНаСервере();
	УстановитьВидимостьВидаПользования(ЭтотОбъект);
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СчетУчетаПриИзмененииНаСервере()
	
	УстановитьСчетУчетаВТаблицеМатериалы();
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетУчетаВШапке()
	
	УстановитьСчет108 = ВидПоступленияТолькоСчета108(Объект.ВидПоступления)
		И Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
		И Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	
	Если УстановитьСчет108 Тогда
		Объект.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет108;
		УстановитьСчетУчетаВТаблицеМатериалы();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьСчетУчетаВТаблицеМатериалы()

	СчетУчета = СчетУчетаДляЗаполненияВСтроке();
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.Материалы Цикл
		Строка.СчетУчета = СчетУчета;
	КонецЦикла;
	
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы();
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);

КонецПроцедуры // УстановитьСчетУчетаВТаблицеМатериалы()

&НаСервере
Функция СчетУчетаДляЗаполненияВСтроке()
	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект) Тогда
		Возврат ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "Счет10656");
	ИначеЕсли УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект) Тогда
		Возврат ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "Счет10856");
	Иначе
		Возврат Объект.СчетУчета;
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокЗакладкиВозвратИзАренды(Форма)
	Если ЭтоВозвратИзПользования(Форма.Объект.ВидПоступления) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаВозвратИзАренды",
			"Заголовок", Форма.Объект.ВидПоступления);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	УстановитьВидимостьЭлементовФормы_ОснованиеДляАкта(Форма);
	УстановитьВидимостьЭлементовФормы_Комиссия(Форма);
	УстановитьВидимостьВидаПользования(Форма);
	УстановитьВидимостьЭлементовФормы_ДокументПоставщика(Форма);
	УстановитьВидимостьЭлементовФормы_ЦМОПриВозврате(Форма);
	УстановитьВидимостьЭлементов_ПоступлениеОтПоставщика(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ОснованиеДляАкта(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ОснованиеДляАкта");
	ИменаЭлементов.Добавить("НомерОснованияДляАкта");
	ИменаЭлементов.Добавить("ДатаОснованияДляАкта");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ЭтоАктОПриемеПередаче0510448(Форма));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Комиссия(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Комиссия");
	ИменаЭлементов.Добавить("СоставКомиссии");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ЭтоАктОПриемеПередаче0510448(Форма));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ДокументПоставщика(Форма)

	Видимость = Не ЭтоАктОПриемеПередаче0510448(Форма)
		Или Форма.Объект.НФАПереданыЭлектроннымАктом;

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ВидПервичногоДокумента");
	ИменаЭлементов.Добавить("НомерПервичногоДокумента");
	ИменаЭлементов.Добавить("ДатаПервичногоДокумента");
	ИменаЭлементов.Добавить("ДатаПодписанияПервичногоДокумента");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов, "Видимость", Видимость);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ЦМОПриВозврате(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ЦМОПриВозврате");
	ИменаЭлементов.Добавить("ПодразделениеПриВозврате");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ЭтоВозвратИзПользования(Форма.Объект.ВидПоступления));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов_ПоступлениеОтПоставщика(Форма)
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("СчетРасчетов");
	ИменаЭлементов.Добавить("КПСРасчетов");
	ИменаЭлементов.Добавить("СпособЗачетаАванса");
	ИменаЭлементов.Добавить("ЗачетАванса");
	ИменаЭлементов.Добавить("СтраницаДенежныеОбязательства");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов, "Видимость",
		Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗИК.ПоступлениеОтПоставщика"));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьВидаПользования(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВидБезвозмездногоПользования",
		"Видимость",
		Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗИК.ВозвратИзБезвПользования"));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоАктОПриемеПередаче0510448(Форма)
	Возврат ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(Форма.Объект.ПервичныйДокумент,
		"АктПриемаПередачи0510448");
КонецФункции

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ДанныеСчетовВФорме = Неопределено)
	ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
		ЭтотОбъект, Объект);
	ПараметрыЗаполненияКолонок.Включать106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
	УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНоменклатурыВСтроке(ИмяТаблицы, ИдентификаторСтроки, Знач ЗаполнятьСчет)
	
	Если ЗабалансовыеСчетаМЗ.НайтиПоЗначению(Объект.СчетУчета) <> Неопределено Тогда
		ЗаполнятьСчет = Ложь;
	КонецЕсли;
	
	ТекущиеДанные = Объект[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущиеДанные.Номенклатура,
		"ЕдиницаИзмерения");
	ТекущиеДанные.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
	
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, ЗаполнятьСчет);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.ЗаполнятьСчет = ЗаполнятьСчет;
	ПараметрыОбработки.ДтКт          = "Дт";
	ПараметрыОбработки.Включать105   = Ложь;
	ПараметрыОбработки.Включать108   = Истина;
	ПараметрыОбработки.Включать106ИК   = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(Форма);
	ПараметрыОбработки.ТолькоБалансовыеИК = Ложь;
	ПараметрыОбработки.ВШапке106 = ПараметрыОбработки.Включать106ИК;
	ПараметрыОбработки.ВШапке108 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(Форма);
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьИзмененияСчетовУчета(Форма, Объект)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СчетУчета",
		"Доступность", НЕ ВидПоступленияТолькоСчета108(Объект.ВидПоступления));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперации()
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры


&НаСервере
Процедура УстановитьУсловноеОформление()

	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.Материалы.КПС", ,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.Материалы.УчетПоКПС", Истина,
		ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Задано в типовой операции'"));
