&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
		ТекущиеДанные.Коэффициент = 1;
		
		ПоступлениеНаСчет108_106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен108(ЭтотОбъект)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);

		Если НЕ ПоступлениеНаСчет108_106 Тогда
			ТекущиеДанные.СчетУчета = Объект.СчетУчета;
		КонецЕсли;
		КоличествоСтрок = Объект.Материалы.Количество();
		Если КоличествоСтрок > 1 Тогда
			ПредыдущаяСтрока = Объект.Материалы[КоличествоСтрок-2];
			ТекущиеДанные.КПС = ПредыдущаяСтрока.КПС;
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(
			Объект, Элементы.Материалы.ТекущиеДанные, Истина);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета)
			И ПоступлениеНаСчет108_106 Тогда
			ТекущиеДанные.УчетПоКПС = Истина;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

