&НаКлиенте
Процедура ДобавитьЛомОтходыДМДляОбъекта(Команда)
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект НФА!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе	
		УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМ(ЭтотОбъект, Объект,
			Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Номенклатура,
			ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка"), 
		Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Количество, "Лом");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписокДМДляОбъекта(Команда)
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект НФА!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе	
		Если Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Количество() = 1 Тогда
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМ(ЭтотОбъект, Объект,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Номенклатура,
				ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка"), 
			Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Количество, "Изделия");
			
			ВариантВводаДанныхДМ = 1;
		Иначе
			МассивВыделенныеСтроки = Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки;
			
			АдресТаблицыОбъектовНФА = ПоместитьТаблицуОбъектовНФАДляДМВХранилище(МассивВыделенныеСтроки);
			
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМДляПеречняОбъектов(ЭтотОбъект, Объект,
				АдресТаблицыОбъектовНФА, "Изделия"); 
			
			ВариантВводаДанныхДМ = 2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимОтбораДМПоОбъекту(Команда)
	
	ИспользоватьОтборДрагМатериаловПоОбъектуНФА = НЕ ИспользоватьОтборДрагМатериаловПоОбъектуНФА;
	УстановитьВидимостьДанныхДрагМатериалов();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуЭДО(Команда)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ЭлектронноеВзаимодействиеКлиент.ВыполнитьПодключаемуюКомандуЭДО(Команда, ЭтотОбъект, Объект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если Не ОбязательныеПоляДляЗаполненияЗаполнены() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = "";
	ЧастиВопроса = Новый Массив;	
	Если Объект.ЗачетАвансов.Количество() > 0 Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Табличная часть будет очищена.'"));
	КонецЕсли;
	Если Объект.Проведен Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Проведение документа будет отменено.'"));
	КонецЕсли;
	
	Если ЧастиВопроса.Количество() > 0 Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Продолжить?'"));
		ТекстВопроса = СтрСоединить(ЧастиВопроса, Символы.ПС);
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнениеТаблицыАвансыЗавершение", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;	 

	ЗаполнитьАвансыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДО(Команда)
	
	Если Не ОбязательныеПоляДляЗаполненияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед заполнением денежных обязательств проведение документа будет отменено.
			|Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОтменитьПроведениеПередЗаполнениемДО", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();
	
КонецПроцедуры

