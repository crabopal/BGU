// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.ПоступлениеИК -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение,
	|	ДанныеИнвентаризации.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ДанныеИнвентаризации.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|			
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение,
	|	ДанныеИнвентаризации.Счет.УчетПоПодразделениям,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ДанныеИнвентаризации.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить();
	Если Не ИспользоватьУчетПоИФО Тогда
		ТаблицаРазделителей.Колонки.Удалить("ИФО");
	КонецЕсли;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			Или ТаблицаРазделителей.Найти(Истина, "УчетПоПодразделениям") = Неопределено Тогда
		ТаблицаРазделителей.Колонки.Удалить("Подразделение");
	КонецЕсли;
	ТаблицаРазделителей.Колонки.Удалить("УчетПоПодразделениям");
	
	Возврат ТаблицаРазделителей;
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат 
	"ВЫБРАТЬ
	|	АктСписания.Ссылка КАК ДокументОтклонения,
	|	АктСписания.ДокументОснование КАК ДокументИнвентаризации,
	|	ТабМатериалы.Номенклатура КАК НФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения,
	|	АктСписания.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ТабМатериалы.Количество КАК Количество
	|ИЗ
	|	Документ.ПоступлениеИК КАК АктСписания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИК.Материалы КАК ТабМатериалы
	|		ПО АктСписания.Ссылка = ТабМатериалы.Ссылка
	|ГДЕ
	|	АктСписания.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ АктСписания.ПометкаУдаления
	|	И АктСписания.Ссылка <> &ПоступлениеИКСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Приходный ордер'"), "0504207", "52н", "103н"),
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Приходный ордер'"), "0504207", "52н"),
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207"));
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдерМ4") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдерМ4",
			"Поступление имущества казны",
			ПечатьМ4(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОСодержанииДрагМатериалов") Тогда
	
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов","Справка о содержании драг. материалов", ТабличныйДокумент);
			
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктПриемаПередачи0510448") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктПриемаПередачи0510448",
			"Акт о приеме-передаче НФА (ф.0510448)",
			УправлениеПечатьюБГУ.Напечатать0510448(МассивОбъектов, ОбъектыПечати, Ложь));
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеМЗ";
	КомандаПечати.Идентификатор		= "ОтветныйАктПриемаПередачи0510448";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ответный Акт о приеме-передаче НФА'"), "0510448", "61н", "100н");
	КомандаПечати.Порядок			= 1;
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "НФАПереданыЭлектроннымАктом",
		Истина, ВидСравнения.Равно);

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеИК";
	КомандаПечати.Идентификатор		= "АктПриемаПередачи0510448";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приеме-передаче НФА'"), "0510448", "61н", "100н");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "НФАПереданыЭлектроннымАктом",
		Ложь, ВидСравнения.Равно);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеИК";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Приходный ордер'"), "0504207", "52н", "103н");
	КомандаПечати.Порядок			= 3;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати, Истина, Истина);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеИК";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Приходный ордер'"), "0504207", "52н");
	КомандаПечати.Порядок			= 4;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати, Истина, Истина);
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 5);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеИК";
	КомандаПечати.Идентификатор		= "ПриходныйОрдерМ4";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Приходный ордер (М-4)'");
	КомандаПечати.Порядок			= 99;
	
КонецПроцедуры

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать105 - Булево - счета 105 не учитываются, при заполнении
//   * Включать106 - Булево - счета 108 учитываются
//   * Включать108 - Булево - счета 108 учитываются
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Дт");
	Результат.Вставить("Включать105", Ложь);
	Результат.Вставить("Включать106", Истина);
	Результат.Вставить("Включать108", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
