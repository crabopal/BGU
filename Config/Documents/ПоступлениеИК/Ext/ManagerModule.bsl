	|ГДЕ
	|	СоставКомиссииДокумента.Ссылка В (&МассивОбъектов)
	|	И ПоступлениеИК.Ссылка В (&МассивОбъектов)";
	
	ТекстыЗапросов.Председатели =
	"ВЫБРАТЬ
	|	ПоступлениеИК.Ссылка КАК Документ,
	|	СоставВыбраннойКомиссии.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ Председатели
	|ИЗ
	|	Документ.ПоступлениеИК КАК ПоступлениеИК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставВыбраннойКомиссии
	|		ПО ПоступлениеИК.Комиссия = СоставВыбраннойКомиссии.Ссылка
	|ГДЕ
	|	СоставВыбраннойКомиссии.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель)
	|	И ПоступлениеИК.Ссылка В (&МассивОбъектов)";
	
	ТекстыЗапросов.СоставКомиссии =
	"ВЫБРАТЬ
	|	СоставКомиссии.Ссылка КАК Ссылка,
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	ВЫБОР
	|		КОГДА Председатели.Сотрудник ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Председатель,
	|	ПолныеДанныеСотрудников.Должность.Наименование КАК НаименованиеДолжности,
	|	ПолныеДанныеСотрудников.Фамилия КАК Фамилия,
	|	ПолныеДанныеСотрудников.Имя КАК Имя,
	|	ПолныеДанныеСотрудников.Отчество КАК Отчество,
	|	СоставКомиссии.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ПоступлениеИК.СоставКомиссии КАК СоставКомиссии
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПолныеДанныеСотрудников КАК ПолныеДанныеСотрудников
	|		ПО СоставКомиссии.Ссылка = ПолныеДанныеСотрудников.Документ
	|		И СоставКомиссии.Сотрудник = ПолныеДанныеСотрудников.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ Председатели КАК Председатели
	|		ПО СоставКомиссии.Ссылка = Председатели.Документ
	|		И СоставКомиссии.Сотрудник = Председатели.Сотрудник
	|ГДЕ
	|	НЕ СоставКомиссии.Отсутствует
	|	И СоставКомиссии.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	ТекстыЗапросов.ДополнительныеРеквизиты =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|	НоменклатураДополнительныеРеквизиты.НомерСтроки КАК НомерСтроки,
	|	НоменклатураДополнительныеРеквизиты.Свойство.Заголовок КАК Свойство,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	|ИЗ
	|	Документ.ПоступлениеИК.Материалы КАК ПоступлениеМЗМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|		ПО ПоступлениеМЗМатериалы.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	Возврат ТекстыЗапросов;

КонецФункции

// Функция формирует табличный документ Приходный ордер (ф.М-4)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьМ4(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_ПРИХОДНЫЙОРДЕР_М4";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеИКМатериалы.Ссылка,
	               |	1 КАК Порядок,
	               |	ПоступлениеИКМатериалы.НомерСтроки,
	               |	ПоступлениеИКМатериалы.Номенклатура,
	               |	ПоступлениеИКМатериалы.Номенклатура.НоменклатурныйНомер КАК НоменклатурныйНомер,
	               |	ПоступлениеИКМатериалы.Сумма КАК Всего,
	               |	0 КАК СуммаНДС,
	               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	               |	ПоступлениеИКМатериалы.Сумма,
	               |	ПоступлениеИКМатериалы.Количество,
	               |	ПоступлениеИКМатериалы.ЕдиницаИзмерения
	               |ПОМЕСТИТЬ СоставыДокументов
	               |ИЗ
	               |	Документ.ПоступлениеИК.Материалы КАК ПоступлениеИКМатериалы
	               |ГДЕ
	               |	ПоступлениеИКМатериалы.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт) КАК КорСчет,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Ссылка,
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт) КАК КорСчетБК,
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт) КАК КорСчетКОСГУ
	               |ПОМЕСТИТЬ КорСчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор В (&МассивОбъектов), , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеИК.Ссылка КАК Ссылка,
	               |	ПоступлениеИК.Номер КАК Номер,
	               |	ПоступлениеИК.Дата КАК Дата,
	               |	ПоступлениеИК.ВидПервичногоДокумента,
	               |	ПоступлениеИК.ДатаПервичногоДокумента,
	               |	ПоступлениеИК.НомерПервичногоДокумента,
	               |	"""" КАК КодАналитики,
	               |	ПоступлениеИК.Организация,
	               |	ПоступлениеИК.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ПоступлениеИК.Организация.КодОКПО КАК КодОКПО,
	               |	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК СотрудникСсылка,
	               |	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХраненияСсылка,
	               |	"""" КАК МестоХранения,
	               |	ПоступлениеИК.Контрагент.Код КАК КодПоставщика,
	               |	ПоступлениеИК.Контрагент,
	               |	ВалютаРегламентированногоУчета.Значение КАК ВалютаДокумента,
	               |	1 КАК Курс,
	               |	1 КАК Кратность,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.Номенклатура.НаименованиеПолное = """"
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(СоставыДокументов.Номенклатура)
	               |		ИНАЧЕ СоставыДокументов.Номенклатура.НаименованиеПолное
	               |	КОНЕЦ КАК Номенклатура,
	               |	СоставыДокументов.НоменклатурныйНомер,
	               |	СоставыДокументов.Всего КАК Всего,
	               |	СоставыДокументов.СуммаНДС КАК НДС,
	               |	СоставыДокументов.СтавкаНДС,
	               |	СоставыДокументов.Всего - СоставыДокументов.СуммаНДС КАК Сумма,
	               |	СоставыДокументов.Количество КАК Количество,
	               |	СоставыДокументов.ЕдиницаИзмерения.Код КАК КодЕдИзм,
	               |	СоставыДокументов.ЕдиницаИзмерения.Представление КАК ЕдИзм,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.Количество <> 0
	               |			ТОГДА (СоставыДокументов.Всего - СоставыДокументов.СуммаНДС) / СоставыДокументов.Количество
	               |		ИНАЧЕ СоставыДокументов.Всего - СоставыДокументов.СуммаНДС
	               |	КОНЕЦ КАК Цена,
	               |	КорСчета.КорСчет КАК КорСчет,
	               |	КорСчета.КорСчетБК КАК КорСчетБК,
	               |	КорСчета.КорСчетКОСГУ КАК КорСчетКОСГУ,
	               |	СоставыДокументов.Порядок КАК Порядок
	               |ИЗ
	               |	Документ.ПоступлениеИК КАК ПоступлениеИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СоставыДокументов КАК СоставыДокументов
	               |		ПО ПоступлениеИК.Ссылка = СоставыДокументов.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КорСчета КАК КорСчета
	               |		ПО ПоступлениеИК.Ссылка = КорСчета.Ссылка,
	               |	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	               |ГДЕ
	               |	ПоступлениеИК.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	Номер,
	               |	Порядок,
	               |	СоставыДокументов.НомерСтроки
	               |ИТОГИ
	               |	СУММА(Всего),
	               |	СУММА(НДС),
	               |	СУММА(Сумма),
	               |	СУММА(Количество),
	               |	МАКСИМУМ(КорСчет),
	               |	МАКСИМУМ(КорСчетБК),
	               |	МАКСИМУМ(КорСчетКОСГУ)
	               |ПО
	               |	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Штуки", 			Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ПриходныйОрдерМ4");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		СтруктураОбластьШапка = Новый Структура("НомерСопроводительногоДокумента,Номер,Поставщик");
		СтруктураОбластьШапка.НомерСопроводительногоДокумента 	= ВыборкаШапка.ВидПервичногоДокумента 
																+ ?(ПустаяСтрока(ВыборкаШапка.НомерПервичногоДокумента), "", " №"+ВыборкаШапка.НомерПервичногоДокумента)
																+ ?(ЗначениеЗаполнено(ВыборкаШапка.ДатаПервичногоДокумента), " от "+ВыборкаШапка.ДатаПервичногоДокумента, "");
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное", ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		СтруктураОбластьШапка.Поставщик	= ДанныеКонтрагента.НаименованиеПолное;
		СтруктураОбластьШапка.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер);
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
		
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтроки);
			Если НЕ ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		КонецЦикла;
		СтруктураОбластьИтог = Новый Структура("КоличествоИтог,СуммаИтог,НДСИтог,ВсегоИтог");
		СтруктураОбластьИтог.КоличествоИтог	= ВыборкаШапка.Количество;
		СтруктураОбластьИтог.СуммаИтог		= ВыборкаШапка.Сумма;
		СтруктураОбластьИтог.НДСИтог		= ВыборкаШапка.НДС;
		СтруктураОбластьИтог.ВсегоИтог		= ВыборкаШапка.Всего;
		ОбластьИтог.Параметры.Заполнить(СтруктураОбластьИтог);
		ТабличныйДокумент.Вывести(ОбластьИтог);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
											ВыборкаШапка.СотрудникСсылка, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьПодвал = Новый Структура("ДолжностьМОЛ,ФИОМол");
		СтруктураОбластьПодвал.ДолжностьМОЛ	= ДанныеСотрудника.Должность;
		СтруктураОбластьПодвал.ФИОМол		= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
													   НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
		
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Функция формирует табличный документ Приходный ордер (ф.0504207)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0504207(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПоступлениеИК) КАК Ссылка,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт) КАК СчетДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт) КАК КПСДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт) КАК КПСКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт) КАК СчетКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт) КАК КЭКДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт) КАК КЭККт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КФО) КАК КФО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
