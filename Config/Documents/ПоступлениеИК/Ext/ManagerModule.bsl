	УправлениеМатериальнымиЗапасами.ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивОбъектов,
		ТекстыЗапросовДляПечати0510448(), МЗПоСебестоимости);
	
КонецПроцедуры

#Область ПроведениеДокумента

// Инициализировать данные документа.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПоступлениеИК
//  СтруктураДополнительныеСвойства - Структура
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Приходный ордер / Требование-накладная");
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер")));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

#КонецОбласти

