//	|ГДЕ
//	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
//	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
//	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

// Заполнить по инвентаризации0510466.
// 
// Параметры:
//  ДокументыИнвентаризации - Массив из ДокументСсылка.ИнвентаризационнаяОписьНФА - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.ПоступлениеИК, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510466(ДокументыИнвентаризации, ЗаполняемыйДокумент) Экспорт 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументыИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризации.НФА КАК НФА,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок
	|ПОМЕСТИТЬ СгруппированныеСтроки
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И (&УсловиеМестоХранения)
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации В(&Документы466)
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И СправочникЦМО.Ссылка = &ЦМО
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И (НЕ &УчетПоПодразделениям
	|			ИЛИ НЕ ЕСТЬNULL(ДанныеИнвентаризации.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ИЛИ ДанныеИнвентаризации.Подразделение = &Подразделение)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|	И ДанныеИнвентаризации.Счет В(&ДопустимыеСчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки,
	|	ДанныеИнвентаризации.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСтрок = 1
	|				И ДанныеИнвентаризации.Количество <> 0
	|			ТОГДА ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено * ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СгруппированныеСтроки КАК СгруппированныеСтроки
	|		ПО ДанныеИнвентаризации.ДокументИнвентаризации = СгруппированныеСтроки.ДокументИнвентаризации
	|			И ДанныеИнвентаризации.НомерСтроки = СгруппированныеСтроки.НомерСтроки
	|			И ДанныеИнвентаризации.НФА = СгруппированныеСтроки.НФА";
	Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаполняемыйДокумент.ЦМО, "МестоХранения")) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения",
			"ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения",
			"ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(Строка)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Документы466", ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("ЦМО", ЗаполняемыйДокумент.ЦМО);
	Запрос.УстановитьПараметр("ИФО", ЗаполняемыйДокумент.ИФО);
	Запрос.УстановитьПараметр("Подразделение", ЗаполняемыйДокумент.Подразделение);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("ДопустимыеСчета", БухгалтерскийУчет.СписокСчетов(ЗаполняемыйДокумент.СчетУчета));
	
	Выборка = Запрос.Выполнить().Выбрать();

	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЗаполняемыйДокумент);
	ПараметрыОбработки.Организация = ЗаполняемыйДокумент.Организация;
	ПараметрыОбработки.ИФО = ЗаполняемыйДокумент.ИФО;
	ПараметрыОбработки.Дата = ЗаполняемыйДокумент.Дата;
	ПараметрыОбработки.ЗаполнятьСчет = Истина;
	ПараметрыОбработки.ДтКт          = "Дт";
	ПараметрыОбработки.Включать105   = Ложь;
	ПараметрыОбработки.Включать108   = Истина;
	ПараметрыОбработки.ТолькоБалансовыеИК = Ложь;
	ПараметрыОбработки.ВШапке108 = Истина;

	ЗаполняемыйДокумент.СуммаДокумента = 0;
	Пока Выборка.Следующий() Цикл
		СтрокаМатериалы = ЗаполняемыйДокумент.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Выборка);
		СтрокаМатериалы.КоличествоМест = СтрокаМатериалы.Количество;
		СтрокаМатериалы.Коэффициент = 1;
		СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		
		ПараметрыОбработки.Номенклатура = СтрокаМатериалы.Номенклатура;
		ПараметрыОбработки.Счет         = СтрокаМатериалы.СчетУчета;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(СтрокаМатериалы, ПараметрыОбработки);
		
		ЗаполняемыйДокумент.СуммаДокумента = ЗаполняемыйДокумент.СуммаДокумента + СтрокаМатериалы.Сумма;
	КонецЦикла;

КонецПроцедуры

// Подготовить таблицу расчетов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеИК
//  Параметры - Структура - Параметры
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	
	СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Документ.Дата, Документ.Организация);
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить(); 
	
	Для Каждого СтрокаТовара Из Документ.Материалы Цикл
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		СтрокаРасчетов.ЭтоПоступление = Истина;
		СтрокаРасчетов.ИФО = Документ.ИФО;
		СтрокаРасчетов.КФО = Перечисления.КВД.Бюджет;
		СтрокаРасчетов.КПС = СтрокаТовара.КПС;
		СтрокаРасчетов.Подразделение = Документ.Подразделение;
		СтрокаРасчетов.КЭК = СтрокаТовара.КЭК;
		СтрокаРасчетов.СчетРасчетов = СчетРасчетов;
		СтрокаРасчетов.Контрагент = Документ.Контрагент;
		СтрокаРасчетов.Договор = Документ.Договор;
		СтрокаРасчетов.Валюта = Валюта;
		СтрокаРасчетов.СуммаРасчетов = СтрокаТовара.Сумма;
		
	КонецЦикла;
	
	ТаблицаРасчетов.Свернуть("ЭтоПоступление, ИФО, КФО, КПС, Подразделение, КЭК, СчетРасчетов, Контрагент,
		|Договор, Валюта",
		"СуммаНДС, СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета поступления материальных запасов.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеИК
//  Параметры - Структура
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу 
Функция ПодготовитьТаблицуПоступлениеМатериальныхЗапасовПоДокументу(Документ, Параметры, Отказ) Экспорт
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу();
	
	МетаданныеСписка = Документ.Метаданные().ТабличныеЧасти.Материалы;
	ИмяСписка = МетаданныеСписка.Имя;
	СинонимСписка = МетаданныеСписка.Синоним;
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	СчетаУчета = Новый Соответствие;
	ВсяНоменклатура = Новый Соответствие;
	
	СубконтоСчетаУчета = БухгалтерскийУчет.ЕстьСубконтоСписокСчетов(Документ.СчетУчета, "ЦМО, Контрагенты");
	
	Если СубконтоСчетаУчета.ЦМО.ЕстьСубконто Тогда
		ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		ДопИзменение = Документ.ЦМО;
	ИначеЕсли СубконтоСчетаУчета.Контрагенты.ЕстьСубконто Тогда
		ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
		ДопИзменение = Документ.Контрагент;
	Иначе
		ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
		ДопИзменение = Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаДокумента Из Документ.Материалы Цикл
		СтрокаТаблицы = ТаблицаДокумента.Добавить();
		СтрокаТаблицы.ИмяСписка = ИмяСписка;
		СтрокаТаблицы.СинонимСписка = СинонимСписка;
		СтрокаТаблицы.НомерСтроки = СтрокаДокумента.НомерСтроки;
		СтрокаТаблицы.ИФО = Документ.ИФО;
		СтрокаТаблицы.КФО = Перечисления.КВД.Бюджет;
		СтрокаТаблицы.КПС = СтрокаДокумента.КПС;
		СтрокаТаблицы.КЭК = СтрокаДокумента.КЭК;
		СтрокаТаблицы.Подразделение = Документ.Подразделение;
		СтрокаТаблицы.СчетУчета = СтрокаДокумента.СчетУчета;
		СтрокаТаблицы.Номенклатура = СтрокаДокумента.Номенклатура;
		СтрокаТаблицы.ДопИзмерениеВидСубконто = ДопИзмерениеВидСубконто;
		СтрокаТаблицы.ДопИзмерение = ДопИзменение;
		СтрокаТаблицы.Контрагент = Документ.Контрагент;
		СтрокаТаблицы.Договор = Документ.Договор;
		СтрокаТаблицы.Валюта = Валюта;
		СтрокаТаблицы.Количество = СтрокаДокумента.Количество;
		СтрокаТаблицы.Сумма = СтрокаДокумента.Сумма;
		СчетаУчета.Вставить(СтрокаТаблицы.СчетУчета);
		ВсяНоменклатура.Вставить(СтрокаТаблицы.Номенклатура);
	КонецЦикла;
	
	ДанныеСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(КлючиСоответствияВМассив(СчетаУчета),
		"УчетПоПодразделениям, РазрешитьНеУказыватьПодразделение");
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(КлючиСоответствияВМассив(ВсяНоменклатура),
		"ТипНоменклатуры");
	
	ДобавитьКолонкуЕслиНет(ТаблицаДокумента, "УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	ДобавитьКолонкуЕслиНет(ТаблицаДокумента, "РазрешитьНеУказыватьПодразделение", Новый ОписаниеТипов("Булево"));
	ДобавитьКолонкуЕслиНет(ТаблицаДокумента, "ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
		
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		ДанныеСчета = ДанныеСчетов.Получить(СтрокаТаблицы.СчетУчета);
		Если ДанныеСчета <> Неопределено Тогда
			СтрокаТаблицы.УчетПоПодразделениям = ДанныеСчета.УчетПоПодразделениям;
			СтрокаТаблицы.РазрешитьНеУказыватьПодразделение = ДанныеСчета.РазрешитьНеУказыватьПодразделение;
		КонецЕсли;
		Данные = ДанныеНоменклатуры.Получить(СтрокаТаблицы.Номенклатура);
		Если Данные <> Неопределено Тогда
			СтрокаТаблицы.ТипНоменклатуры = Данные.ТипНоменклатуры;
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция КлючиСоответствияВМассив(ИсходныеДанные)
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ИсходныеДанные Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьКолонкуЕслиНет(Таблица, ИмяКолонки, ТипЗначения)
	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяКолонки, ТипЗначения);
	КонецЕсли;
КонецПроцедуры

// Заполняет таблицу "Зачет авансов"
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеИК, ДанныеФормыСтруктураСКоллекцией - заполняемый документ.
// 	ПериодОстатков - Граница - граница расчета остатков авансов.
Процедура ЗаполнитьПоОстаткамАвансов(Документ, ПериодОстатков, Отказ) Экспорт
	
	ПараметрыЗаполнения = БухгалтерскийУчет.ПараметрыЗаполненияТаблицыДокументаЗачетАвансов(Документ);
	
	ПараметрыЗаполнения.ПериодОстатков = ПериодОстатков;
//	ПараметрыЗаполнения.СчетРасчетов = Документ.СчетРасчетов;
	ПараметрыЗаполнения.ПоВсемКПС = Истина;
	
	Если ТипЗнч(Документ) <> Тип("ДокументОбъект.ПоступлениеИК") Тогда
		ДокументОбъект = ДанныеФормыВЗначение(Документ, Тип("ДокументОбъект.ПоступлениеИК"));
	Иначе
		ДокументОбъект = Документ;
	КонецЕсли;
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ДокументОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		
		Документ.ЗачетАвансов.Очистить();
		
		АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
			Новый Структура("ЭтоЗачетАванса", Истина));
		
		Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
			
			Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Документ.ЗачетАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету, "КФО,КПС");
			
			НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
			НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(АвансКЗачету.СчетАвансов);
			НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Параллельный многопоточный обработчик обновления. Версия 2.0.94
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параметры выборки данных для многопоточного обновления.
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = "Документ.ПоступлениеИК";
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Дата");
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Дата");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	АктуальныеДанные = Параметры.АктуальныеДанные;
	АктуальныеДанные.ПолеОтбора = "Дата";
	АктуальныеДанные.ВидСравнения = ВидСравнения.Больше;
	АктуальныеДанные.Значение = Дата("20221231");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеИК.Ссылка
	|ИЗ
	|	Документ.ПоступлениеИК КАК ПоступлениеИК
	|ГДЕ
	|	ПоступлениеИК.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	ИЛИ ПоступлениеИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗИК.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПоступлениеИКМатериалы.Ссылка
	|ИЗ
	|	Документ.ПоступлениеИК.Материалы КАК ПоступлениеИКМатериалы
	|ГДЕ
	|	ПоступлениеИКМатериалы.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	ИЛИ ПоступлениеИКМатериалы.КЭК = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	ИЛИ ПоступлениеИКМатериалы.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)";
	
	ДокументыКОбработке = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		ДокументыКОбработке.Добавить(Выборка.Ссылка);
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
			ДокументыКОбработке.Очистить();
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
	КонецЕсли;
	
КонецПроцедуры

// Обработать данные для перехода на новую версию.
// 
// Параметры:
//  Параметры - Структура:
//   * ОбработкаЗавершена - Булево
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Выборка данных для многопоточного обновления.
	ОбрабатываемыеДокументы = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);

	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип("ДокументСсылка.ПоступлениеИК"));
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Для каждого ОбрабатываемыйДокумент Из ДокументыДляОбработкиДополненныеКПС(ОбрабатываемыеДокументы) Цикл
		ПредставлениеСсылки = Строка(ОбрабатываемыйДокумент.Ссылка);
		Попытка
			//@skip-check query-in-loop
			ОбработатьДокументПриОбновлении(ОбрабатываемыйДокумент);
			ОбъектовОбработано = ОбъектовОбработано + 1;
		Исключение
			// Если не удалось обработать какой-либо документ, повторяем попытку снова.
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеСсылки);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ОбъектМетаданных,
				ОбрабатываемыйДокумент.Ссылка,
				ТекстСообщения);
		КонецПопытки;
		
	КонецЦИкла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось обработать некоторые ""%2"" (пропущены): %1'"), 
			ПроблемныхОбъектов,
			ПолноеИмяОбъекта);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация,
			ОбъектМетаданных,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Обработана очередная порция ""%2"": %1'"),
				ОбъектовОбработано,
				ПолноеИмяОбъекта));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументПриОбновлении(ОбрабатываемыйДокумент)
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ПоступлениеИК");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбрабатываемыйДокумент.Ссылка);
		Блокировка.Заблокировать();
		
		ДокументОбъект = ОбрабатываемыйДокумент.Ссылка.ПолучитьОбъект(); // ДокументОбъект.ПоступлениеИК
		ДокументОбъект.Заблокировать();
		
		Счет10856 = БухгалтерскийУчет.СчетПоКоду("108.56", ДокументОбъект.Дата, ДокументОбъект.Организация);
		Счет10800 = БухгалтерскийУчет.СчетПоКоду("108.00", ДокументОбъект.Дата, ДокументОбъект.Организация);
		КЭК346 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("346");
		КПСДт = ОбрабатываемыйДокумент.КПСДт;
		
		Если ДокументОбъект.ВерсияДанных <> ОбрабатываемыйДокумент.ВерсияДанных Тогда
			// Версия данных изменилась. Нужно перечитать КПС из движений.
			
			ОбновленныеДвижения = ПрочитатьКПСДокументов(ОбрабатываемыйДокумент.Ссылка, Счет10856);
			Если ОбновленныеДвижения.Количество() > 0 Тогда
				КПСДт = ОбновленныеДвижения[0].КПСДт;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.СчетУчета) Тогда
			 ДокументОбъект.СчетУчета = Счет10800;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВидПоступления) Тогда
			 ДокументОбъект.ВидПоступления = Перечисления.ВидыПоступленийМЗИК.Поступление;
		КонецЕсли;
		
		Для Каждого Строка Из ДокументОбъект.Материалы Цикл
			Если Не ЗначениеЗаполнено(Строка.СчетУчета) Тогда
				Строка.СчетУчета = Счет10856;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
				Строка.КЭК = КЭК346;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КПС) И ЗначениеЗаполнено(КПСДт) Тогда
				Строка.КПС = КПСДт;
			КонецЕсли;
		КонецЦикла;
		
		Если ДокументОбъект.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		Иначе
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбрабатываемыйДокумент.Ссылка);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Документы для обработки дополненные КПС.
// 
// Параметры:
//  ОбрабатываемыеДокументы - ТаблицаЗначений
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ДокументыДляОбработкиДополненныеКПС(ОбрабатываемыеДокументы)
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ПоступлениеИК");
		ЭлементБлокировки.ИсточникДанных = ОбрабатываемыеДокументы;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		Блокировка.Заблокировать();
		
		Счет = БухгалтерскийУчет.СписокСчетов("108.56");
		ДокументыСКПС = ПрочитатьКПСДокументов(ОбрабатываемыеДокументы.Выгрузить("Ссылка"), Счет);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ДокументыСКПС = ОбрабатываемыеДокументы.Скопировать();
		ДокументыСКПС.Колонки.Добавить("КПСДт");
		ДокументыСКПС.Колонки.Добавить("ВерсияДанных");
	КонецПопытки;
	
	Возврат ДокументыСКПС;
	
КонецФункции

Функция ПрочитатьКПСДокументов(Документ, Счет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеИК.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУ.КПСДт) КАК КПСДт,
	|	ПоступлениеИК.ВерсияДанных,
	|	ПоступлениеИК.Дата КАК Дата
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеИК КАК ПоступлениеИК
	|		ПО ЖурналПроводокЕПСБУ.Регистратор = ПоступлениеИК.Ссылка
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор В (&Регистраторы)
	|	И ЖурналПроводокЕПСБУ.СчетДт В (&СчетаДт)
	|	И ПоступлениеИК.Ссылка В (&Регистраторы)
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеИК.Ссылка,
	|	ПоступлениеИК.ВерсияДанных,
	|	ПоступлениеИК.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Регистраторы", Документ);
	Запрос.УстановитьПараметр("СчетаДт", Счет);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Многопоточный обработчик обновления. Версия 2.0.97.
// Предыдущий обработчик выполняется на версии 2.0.94. Маловероятно, что он еще не отработал.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2(Параметры) Экспорт

