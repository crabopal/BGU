#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	НепроверяемыеРеквизиты = Новый Массив;
	УчетРасчетов.ЗачетАвансовВыданныхОбработкаПроверкиЗаполнения(ЭтотОбъект, НепроверяемыеРеквизиты, Отказ);
	ПроверитьЗаполнениеОтсутствияЧленовКомиссии(НепроверяемыеРеквизиты, Отказ);
	
	Если ВидПоступления <> Перечисления.ВидыПоступленийМЗИК.ПоступлениеОтПоставщика Тогда
		НепроверяемыеРеквизиты.Добавить("СчетРасчетов");
		НепроверяемыеРеквизиты.Добавить("СпособЗачетаАванса");
	КонецЕсли;
	Если ВидПоступления <> Перечисления.ВидыПоступленийМЗИК.ПоступлениеОтПоставщика
		Или СпособЗачетаАванса <> Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		НепроверяемыеРеквизиты.Добавить("ЗачетАвансов.КФО");
		НепроверяемыеРеквизиты.Добавить("ЗачетАвансов.СуммаЗачета");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	ОбщегоНазначенияБГУ.ОчиститьВидМежотчетногоПериода(ЭтотОбъект);
	
	СуммаДокумента = Материалы.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияИК.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		ИначеЕсли ЭтоЗаполнениеНаОснованииИнвентаризации0510466(ДанныеЗаполнения) Тогда
			ЗаполнитьПоИнвентаризации0510466(ДанныеЗаполнения);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			
			Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Основание.Организация) Тогда
				РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Основание);
				Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
					ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(Основание, РазличающаясяНоменклатураКонтрагентаИОрганизации);
					ВызватьИсключение ТекстСообщения;
				КонецЕсли;
			КонецЕсли;	
			
			ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание, ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить());
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			СтандартнаяОбработка = Ложь;
			Организация = Основание.Организация;
			ДанныеЗаполнения.Вставить("Организация", Организация);
			ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения.Основание);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	

		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения);

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		
		ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	Если УправлениеМатериальнымиЗапасами.СчетУчетаРавен108(ЭтотОбъект) Тогда
		ИзменилсяПорядокУчетаКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ОбъектКопирования.Дата,
			ОбъектКопирования.Организация,
			ДатаНовогоДокумента,
			Организация);
		Если ИзменилсяПорядокУчетаКЭК Тогда
			УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект,
				ДатаНовогоДокумента, Истина);
		КонецЕсли;
	КонецЕсли;
	
	ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ПустаяСсылка();
	НФАПереданыЭлектроннымАктом = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеОтсутствияЧленовКомиссии(НепроверяемыеРеквизиты, Отказ)
	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
		Если СтрокаКомиссии.Отсутствует И Не ЗначениеЗаполнено(СтрокаКомиссии.ПричинаОтсутствия) Тогда
			ПутьКРеквизиту = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаКомиссии.НомерСтроки, "ПричинаОтсутствия");
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , НСтр("ru = 'Причина отсутствия'"), СтрокаКомиссии.НомерСтроки, НСтр("ru = 'Состав комиссии'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Объект", ПутьКРеквизиту, Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Материалы.Выгрузить(,"Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеИК;

	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	ДатаПодписанияПервичногоДокумента = Дата;
	
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	ДокументОснование = ДанныеЗаполнения;
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ПринятьНДСКВычету = Истина;
	
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование);
	КонецЕсли;	
		
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 1  
			ИЛИ СтрокаТЧ.КодВидаНоменклатуры = 5 Тогда 
			НоваяСтрока = Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.Сумма = СтрокаТЧ.Всего;
			НоваяСтрока.КоличествоМест = 1;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЦикла;
		
	СуммаДокумента = Материалы.Итог("Сумма");
	
КонецПроцедуры	

Процедура ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		Если ДанныеЗаполнения.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Для ответного акта нельзя ввести документ данного типа.'");

			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;	
	КонецЕсли;
	
	КодВидаИмущества = ДанныеЗаполнения.КодВидаИмуществаУОтправителя;

	Организация = ДанныеЗаполнения.Организация;
	ДокументОснование = ДанныеЗаполнения;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ОснованиеДляАкта = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаОснованияДляАкта = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерОснованияДляАкта = ДанныеЗаполнения.НомерПервичногоДокумента;

	ПервичныйДокумент = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");

	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	КФО = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("КВД", ДанныеЗаполнения.КФОУОтправителя, Истина);
	
	ВидПоступления = Перечисления.ВидыПоступленийМЗИК.Поступление;
	
	СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Дата, Организация);
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("108.00", Дата, Организация);
	Если КодВидаИмущества = НСтр("ru='ВложенияВНФА'") Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.50", Дата, Организация);
	КонецЕсли;	
	
	ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(ДанныеЗаполнения.КодВалюты);
	Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;

	НФАПереданыЭлектроннымАктом = Истина;
	ИспользуемыеИдентификаторы = Новый Массив;
	ПереданнаяНоменклатура = Новый ТаблицаЗначений;
	ПереданнаяНоменклатура.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПереданнаяНоменклатура.Колонки.Добавить("GUIDНоменклатуры", Новый ОписаниеТипов("Строка"));
	
	Материалы.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаполнения.ПереданныеНФА Цикл
		НовСтрока = ПереданнаяНоменклатура.Добавить();
		НовСтрока.ОбъектНФА = ТекСтрока.НФА;
		НовСтрока.GUIDНоменклатуры = ТекСтрока.GUIDНоменклатурыУОтправителя;
		
		НоваяСтрока = Материалы.Добавить();
		НоваяСтрока.Номенклатура = ТекСтрока.НФА;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.БалансоваяСтоимость;
		НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
		НоваяСтрока.КоличествоМест = ТекСтрока.Количество;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекСтрока.ЕдИзмКод);
		
		НоваяСтрока.КПС = БухгалтерскиеОперации.КПСПоКоду(ТекСтрока.КодКПСУОтправителя, Дата);
		НоваяСтрока.СчетУчета = БухгалтерскиеОперации.СчетПоКоду(ТекСтрока.КодСчетаУчетаУОтправителя, Дата);
		
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.НФА, "ТипНоменклатуры");
		
		НоваяСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Организация,
			ИФО,
			Перечисления.КВД.ПустаяСсылка(),
			ОбщегоНазначения.ТекущаяДатаПользователя(),
			НоваяСтрока.СчетУчета,
			ДанныеНоменклатуры.ТипНоменклатуры,
			"Дт");
		
		Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеЗаполнения.СведенияПрослеживаемости.Количество() > 0 Тогда
		ТекстСообщения  = НСтр("ru='Документ не поддерживает загрузку сведений о прослеживаемости, которые переданы в составе электронного акта ф.0510448.'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЕсли;
	
	ДрагоценныеМатериалы.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаполнения.СведенияОСодержанииДрагМатериалов Цикл
		НоваяСтрока = ДрагоценныеМатериалы.Добавить();
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("GUIDНоменклатуры", ТекСтрока.GUIDНоменклатурыУОтправителя);
		НайденныеСтроки = ПереданнаяНоменклатура.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ОбъектНФА = НайденныеСтроки[0].ОбъектНФА;
			НоваяСтрока.ОбъектНФА = ОбъектНФА;
		КонецЕсли;
		НоваяСтрока.ВидДрагМатериала = Справочники.ДрагМеталлы.НайтиПоКоду(ТекСтрока.КодВидаДрагоценногоМатериала);
		НоваяСтрока.ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекСтрока.ЕдИзмКод);
		НоваяСтрока.КоличествоДМ = ТекСтрока.КоличествоДМ;
		НоваяСтрока.МассаДМ = ТекСтрока.МассаДМ;
	КонецЦикла;
	
	СуммаДокумента = Материалы.Итог("Сумма");
	
КонецПроцедуры

// Заполнить по входящему извещению.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.ИзвещениеВходящее -
//
Процедура ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения)
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, Поставщик, Договор, ИФО");
	
	Дата               = ОбщегоНазначения.ТекущаяДатаПользователя();
	ДокументОснование  = ДанныеЗаполнения;
	Организация        = ДанныеОснования.Организация;
	ИФО                = ДанныеОснования.ИФО;
	Контрагент         = ДанныеОснования.Поставщик;
	Договор            = ДанныеОснования.Договор;
	ВидПоступления     = Перечисления.ВидыПоступленийМЗИК.Поступление;
	СчетУчета          = БухгалтерскийУчет.СчетПоКоду("108.00", Дата, Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Материалы.Количество КАК Количество,
	|	Материалы.Сумма КАК Сумма
	|ИЗ
	|	Документ.ИзвещениеВходящее.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ПараметрыУстановкиСчетаУчетаВСтроке = ПараметрыУстановкиСчетаУчетаВСтроке();
	
	Материалы.Очистить();
	ВыборкаМатериалы = Запрос.Выполнить().Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы);
		НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
		НоваяСтрока.Коэффициент    = 1;
		ПараметрыУстановкиСчетаУчетаВСтроке.Номенклатура = НоваяСтрока.Номенклатура;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока,
			ПараметрыУстановкиСчетаУчетаВСтроке);
		НоваяСтрока.КПС = БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, 
			Перечисления.КВД.Бюджет, Дата, НоваяСтрока.СчетУчета);	
	КонецЦикла;
	
КонецПроцедуры

// Подготавливает прараметры для передачи в процедуру 
// УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке
//
// Возвращаемое значение:
//   Структура   - см. УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтрокеПоУмолчанию 
//
Функция ПараметрыУстановкиСчетаУчетаВСтроке()
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработки.ЗаполнятьСчет 	= Истина;
	ПараметрыОбработки.ДтКт 			= "Дт";
	ПараметрыОбработки.Включать105 		= Ложь;
	ПараметрыОбработки.Включать108 		= Истина;
	ПараметрыОбработки.Включать106ИК 	= Ложь;
	ПараметрыОбработки.ТолькоБалансовыеИК = Истина;
	ПараметрыОбработки.ВШапке106 		= Ложь;
	ПараметрыОбработки.ВШапке108 		= Истина;
	
	Возврат ПараметрыОбработки; 
КонецФункции

Функция ЭтоЗаполнениеНаОснованииИнвентаризации0510466(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		И ДанныеЗаполнения.Свойство("Разделитель");
КонецФункции

// Заполнить по инвентаризации 0510466.
// 
// Параметры:
//  ДанныеЗаполнения - Структура:
//   * Разделитель - Структура
//   * ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА
Процедура ЗаполнитьПоИнвентаризации0510466(ДанныеЗаполнения)
	Материалы.Очистить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация, Дата, Номер");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование, "Организация");
	ВидПоступления = Перечисления.ВидыПоступленийМЗИК.Поступление;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("108.00", Дата, Организация);
	КонецЕсли;
	ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору("АктПриемаПередачи0510448");

	ИдентификаторИнвОписи = "Форма0510466";
	ОснованиеДляАкта = ПервичныеДокументыБГУ
		.ПредставленияПервичныхДокументов(ИдентификаторИнвОписи)[ИдентификаторИнвОписи].ПредставлениеФормы;
	НомерОснованияДляАкта = ОбщегоНазначенияБГУ
		.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование, ДанныеДокОснование.Номер);
	ДатаОснованияДляАкта = ДанныеДокОснование.Дата;
	
	Документы.ПоступлениеИК.ЗаполнитьПоИнвентаризации0510466(
		ДанныеЗаполнения.ДокументОснование,
		ЭтотОбъект)
КонецПроцедуры

#КонецОбласти

#КонецЕсли