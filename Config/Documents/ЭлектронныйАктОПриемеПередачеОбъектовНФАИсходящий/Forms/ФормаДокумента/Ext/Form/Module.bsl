&НаСервере
Функция ПриложенныеДокументыДляЭДО(ДокументАкта) Экспорт
	
	ТаблицаФайлов = ДанныеФайловПрисоединенныхКДокументу(ДокументАкта);
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаФайлов);
	
КонецФункции

&НаСервере
Функция ДанныеФайловПрисоединенныхКДокументу(СсылкаНаДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД КАК ДокументЭД,
	|	ПриложенныеФайлыДляЭДОБГУ.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК НаименованиеДокументаФайла,
	|	ПриложенныеФайлыДляЭДОБГУ.ВидСведений КАК ВидСведений
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭДОБГУ КАК ПриложенныеФайлыДляЭДОБГУ
	|ГДЕ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД = &ДокументЭД";
		
	Запрос.УстановитьПараметр("ДокументЭД", СсылкаНаДокумент);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Возврат Выборка;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОтветныйДокумент(ДокументОтветногоАкта, Форма, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ДокументОтветногоАкта) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтветногоАкта = Новый Структура("Ключ", ДокументОтветногоАкта);
	
	ОткрытьФорму("Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ФормаОбъекта", ПараметрыОтветногоАкта, Форма);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьРеквизитыЭДО()
	
	ВидимостьОтветногоАкта = Ложь;
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	Если ВидимостьЭлементовЭДО Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ВходящийАктОПриемеПередачеОбъектовНФА) Тогда
			ОтветныйАкт = ЭлектронныеДокументыБГУ.ОтветныйАктПоИсходящемуАкту(Объект.Ссылка);
			Если ЗначениеЗаполнено(ОтветныйАкт) Тогда
				ВидимостьОтветногоАкта = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтветныйАкт", "Видимость", ВидимостьОтветногоАкта);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОСостоянииЭлектронногоАктаОПриемеПередачеНФА(Форма, ТекущийОбъект)

	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ВходящийАктОПриемеПередачеОбъектовНФА) Тогда
		//Получение НФА
		ДокументПоступленияНФА = ТекущийОбъект.ДокументОснование;
		
		Если ЗначениеЗаполнено(ДокументПоступленияНФА) Тогда
			СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПустаяСсылка();
			Если ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
				Если НЕ ТекущийОбъект.Ссылка.ПометкаУдаления Тогда
					СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленОтветныйАкт;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(ТекущийОбъект.ВходящийАктОПриемеПередачеОбъектовНФА) Тогда
				Если НЕ ТекущийОбъект.ВходящийАктОПриемеПередачеОбъектовНФА.ПометкаУдаления Тогда
					СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученВходящийАкт;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СостояниеЭДОАкта) Тогда
				НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПоступленияНФА);
				Запись = НаборЗаписей.Добавить();
				Запись.СсылкаНаОбъект = ДокументПоступленияНФА;
				Запись.СостояниеЭДО = СостояниеЭДОАкта;
				НаборЗаписей.Записать(Истина);
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		ДокументПередачиНФА = ТекущийОбъект.ДокументОснование;
		СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленИсходящийАкт;
		Если ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
			Если ТекущийОбъект.Ссылка.ПометкаУдаления Тогда
				СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПустаяСсылка();
				УАктаЕстьПометкаУдаления = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СостояниеЭДОАкта) ИЛИ УАктаЕстьПометкаУдаления Тогда
			НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПередачиНФА);
			НаборЗаписей.Записывать = Истина;
			Запись = НаборЗаписей.Добавить();
			Запись.СсылкаНаОбъект = ДокументПередачиНФА;
			Запись.СостояниеЭДО = СостояниеЭДОАкта;
			НаборЗаписей.Записать(Истина);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти


