#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПросмотретьПредставлениеВнутреннегоЭД(Команда)
	ЭтоПервоначальныйАкт = Истина;
	ДокументУчета = Объект.ДокументОснование;
	Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеИК")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
		ЭтоПервоначальныйАкт = Ложь;
	КонецЕсли;	
	
	Заголовок = "Акт о приеме-передаче НФА (ф.0510448) (61н, ред. 100н)";
	Если ИспользуетсяПОД Тогда
		Если ЭтоПервоначальныйАкт Тогда
			ИдентификаторПечати = "АктПриемаПередачи0510448";
			Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
				ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
				ИдентификаторПечати = "АктПриемаПередачи0510448ПоСебестоимости";
			КонецЕсли;	
		Иначе
			ИдентификаторПечати = "ОтветныйАктПриемаПередачи0510448";
		КонецЕсли;	
		
		АдресТабличногоДокумента = АдресТабличногоДокументаПредставленияЭДПОД(ДокументУчета, ИдентификаторПечати);
		
	Иначе
		АдресТабличногоДокумента = АдресТабличногоДокументаПредставленияЭД(ВнутреннийЭД, Объект.Организация); 	
	КонецЕсли;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("Заголовок", Заголовок);
	ПараметрыОбработчика.Вставить("АдресДокумента", АдресТабличногоДокумента);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраТабличногоДокумента", ПараметрыОбработчика, ЭтаФорма,
		,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция АдресТабличногоДокументаПредставленияЭДПОД(ДокументУчета, ИдентификаторПечати)
	Результат = ЭлектронныеДокументыБГУ.АдресТабличногоДокументаПредставленияЭДПОД(ДокументУчета, ИдентификаторПечати);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция АдресТабличногоДокументаПредставленияЭД(ВнутреннийЭД, Организация)
	Результат = ЭлектронныеДокументыБГУ.АдресТабличногоДокументаПредставленияЭД(ВнутреннийЭД, Организация);
	
	Возврат Результат;
КонецФункции

