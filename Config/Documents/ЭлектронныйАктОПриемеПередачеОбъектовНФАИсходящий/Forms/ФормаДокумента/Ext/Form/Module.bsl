Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоОтветныйАкт = ?(ЗначениеЗаполнено(Объект.ВходящийАктОПриемеПередачеОбъектовНФА), Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВходящийАкт", "Видимость", ЭтоОтветныйАкт);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВнутреннийЭД", "Видимость", НЕ Форма.ИспользуетсяПОД);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументУчета", "Видимость", ЭтоОтветныйАкт);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументОснование", "Видимость", НЕ ЭтоОтветныйАкт);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПередачаСведенийОбАдресахНФА", "Видимость", НЕ ЭтоОтветныйАкт);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПриложенныеДокументыДобавитьИзПрисоединенныхФайловДокументаОснования", "Видимость", НЕ ЭтоОтветныйАкт);
	
	Если ЭтоОтветныйАкт Тогда
		Элементы.ГруппаПолучатель.Заголовок = НСтр("ru='Получатель ответного акта'");
		Элементы.ГруппаПояснение.Заголовок = НСтр("ru='Пояснение к ответному акту'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЭтоВозвратНФА", "Видимость", НЕ ЭтоОтветныйАкт);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДоговорПолучатель", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры
	
