#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// СтандартныеПодсистемы.Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий";
	КомандаПечати.Идентификатор = "АктОПриемеПередачеОбъектовНФАЭлектронный";
	КомандаПечати.Представление = НСтр("ru = 'Акт о приеме-передаче объектов НФА (ф.0510448)'");
	КомандаПечати.Порядок		= 1;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктОПриемеПередачеОбъектовНФАЭлектронный") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктОПриемеПередачеОбъектовНФАЭлектронный",
			"Акт о приеме-передаче объектов НФА (ф.0510448)",
			ПечатьЭлектронногоАкта0510448(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПечатьЭлектронногоАкта0510448(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПарметрыПечатиАкта0510448";
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Акт0510448");

	ОбластьРуководитель	= Макет.ПолучитьОбласть("Руководитель");
	ОбластьШапка1		= Макет.ПолучитьОбласть("Шапка1");
	ОбластьОтправитель	= Макет.ПолучитьОбласть("Отправитель");
	ОбластьПолучатель	= Макет.ПолучитьОбласть("Получатель");
	ОбластьШапка2		= Макет.ПолучитьОбласть("Шапка2");
	ОбластьР1Шапка		= Макет.ПолучитьОбласть("Раздел1_Шапка");
	ОбластьР1Строка		= Макет.ПолучитьОбласть("Раздел1_Строка");
	ОбластьР1Подвал		= Макет.ПолучитьОбласть("Раздел1_Подвал");
	ОбластьР2Шапка		= Макет.ПолучитьОбласть("Раздел2_Шапка");
	ОбластьР2Строка		= Макет.ПолучитьОбласть("Раздел2_Строка");
	ОбластьР3Шапка		= Макет.ПолучитьОбласть("Раздел3_Шапка");
	ОбластьР3Строка		= Макет.ПолучитьОбласть("Раздел3_Строка");
	ОбластьР4Шапка		= Макет.ПолучитьОбласть("Раздел4_Шапка");
	ОбластьР4Строка		= Макет.ПолучитьОбласть("Раздел4_Строка");
	ОбластьПустаяСтрока	= Макет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьПриложение	= Макет.ПолучитьОбласть("Приложение");
	ОбластьЦМО			= Макет.ПолучитьОбласть("ЦМО");
	ОбластьКомиссияП	= Макет.ПолучитьОбласть("Комиссия_Председатель");
	ОбластьКомиссияС	= Макет.ПолучитьОбласть("Комиссия_Строка");
	ОбластьИсполнитель1	= Макет.ПолучитьОбласть("Исполнитель");
	ОбластьИсполнитель2	= Макет.ПолучитьОбласть("Исполнитель");
	
	ПервыйДокумент = Истина;
	Для Каждого ТекДок Из МассивОбъектов Цикл
		Если ТекДок.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОтправленныйАкт = ТекДок.ВходящийАктОПриемеПередачеОбъектовНФА;
			ОтветныйАкт = ТекДок.Ссылка;
		Иначе
			ОтправленныйАкт = ТекДок.Ссылка;
			ОтветныйАкт = ЭлектронныеДокументыБГУ.ОтветныйАктПоИсходящемуАкту(ТекДок.Ссылка);
		КонецЕсли;
		
		ДанныеЭДОтправленногоАкта = ЭлектронныеДокументыБГУ.СведенияЭДАктаПередачиНФАПоДокументу(ОтправленныйАкт);
		ДанныеЭДОтветногоАкта = ЭлектронныеДокументыБГУ.СведенияЭДАктаПередачиНФАПоДокументу(ОтветныйАкт);
		
		Если ДанныеЭДОтправленногоАкта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеЭДОтветногоАкта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипАкта = ДанныеЭДОтправленногоАкта.ОбщиеРеквизитыДокумента.ТипАкта;
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		//Руководители
		ФИООтправителя = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтправленногоАкта.РуководительОтправителя);
		ФИОПолучателя = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтветногоАкта.РуководительПолучателя);
		
		ДанныеРуководителей = Новый Структура;
		ДанныеРуководителей.Вставить("ФИООтправителя", ФИООтправителя);
		ДанныеРуководителей.Вставить("ФИОПолучателя", ФИОПолучателя);
		
		ОбластьРуководитель.Параметры.Заполнить(ДанныеРуководителей);
		ТабличныйДокумент.Вывести(ОбластьРуководитель);
		
		//Шапка
		ДатаАкта = ДанныеЭДОтправленногоАкта.ОбщиеРеквизитыДокумента.Дата;
		НомерАкта = ДанныеЭДОтветногоАкта.ОбщиеРеквизитыДокумента.Номер;
		
		ДанныеШапки = Новый Структура;
		ДанныеШапки.Вставить("ДатаАкта", ДатаАкта);
		ДанныеШапки.Вставить("НомерАкта", НомерАкта);
		
		ОбластьШапка1.Параметры.Заполнить(ДанныеШапки);
		ТабличныйДокумент.Вывести(ОбластьШапка1);
		
		//Отправитель
		НаименованиеКонтрагента = ДанныеЭДОтправленногоАкта.ДанныеОтправителя.Наим;
		НаименованиеОбособленногоПодразделения = ДанныеЭДОтправленногоАкта.ОбособленноеПодразделениеОтправителя.Наим;
		НаименованиеСтруктурногоПодразделения = ДанныеЭДОтправленногоАкта.СтруктурноеПодразделениеОтправителя.Наим;
		Учредитель = ДанныеЭДОтправленногоАкта.УчредительОтправителя.Наим;
		БюджетНаименование = ДанныеЭДОтправленногоАкта.БюджетОтправителя.Наим;
		КодРПБС = ДанныеЭДОтправленногоАкта.ДанныеОтправителя.ЮЛ.КодПоРПБС;
		КодРПБСПодр = ДанныеЭДОтправленногоАкта.ОбособленноеПодразделениеОтправителя.КодПоРПБС;
		ГлаваБК = ДанныеЭДОтправленногоАкта.УчредительОтправителя.КодГлаваПоБК;
		ОКТМО = ДанныеЭДОтправленногоАкта.БюджетОтправителя.КодОКТМО;
		
		ДанныеОтправителя = Новый Структура;
		ДанныеОтправителя.Вставить("НаименованиеКонтрагента", НаименованиеКонтрагента);
		ДанныеОтправителя.Вставить("НаименованиеОбособленногоПодразделения", НаименованиеОбособленногоПодразделения);
		ДанныеОтправителя.Вставить("НаименованиеСтруктурногоПодразделения", НаименованиеСтруктурногоПодразделения);
		ДанныеОтправителя.Вставить("Учредитель", Учредитель);
		ДанныеОтправителя.Вставить("БюджетНаименование", БюджетНаименование);
		ДанныеОтправителя.Вставить("КодРПБС", КодРПБС);
		ДанныеОтправителя.Вставить("КодРПБСПодр", КодРПБСПодр);
		ДанныеОтправителя.Вставить("ГлаваБК", ГлаваБК);
		ДанныеОтправителя.Вставить("ОКТМО", ОКТМО);
		
		ОбластьОтправитель.Параметры.Заполнить(ДанныеОтправителя);
		ТабличныйДокумент.Вывести(ОбластьОтправитель);
		
		//Получатель

		НаименованиеКонтрагента = ДанныеЭДОтветногоАкта.ДанныеПолучателя.Наим;
		НаименованиеОбособленногоПодразделения = ДанныеЭДОтветногоАкта.ОбособленноеПодразделениеПолучателя.Наим;
		НаименованиеСтруктурногоПодразделения = ДанныеЭДОтветногоАкта.СтруктурноеПодразделениеПолучателя.Наим;
		Учредитель = ДанныеЭДОтветногоАкта.УчредительПолучателя.Наим;
		БюджетНаименование = ДанныеЭДОтветногоАкта.БюджетПолучателя.Наим;
		КодРПБС = ДанныеЭДОтветногоАкта.ДанныеПолучателя.ЮЛ.КодПоРПБС;
		КодРПБСПодр = ДанныеЭДОтветногоАкта.ОбособленноеПодразделениеПолучателя.КодПоРПБС;
		ГлаваБК = ДанныеЭДОтветногоАкта.УчредительПолучателя.КодГлаваПоБК;
		ОКТМО = ДанныеЭДОтветногоАкта.БюджетПолучателя.КодОКТМО;
		
		ДанныеПолучателя = Новый Структура;
		ДанныеПолучателя.Вставить("НаименованиеКонтрагента", НаименованиеКонтрагента);
		ДанныеПолучателя.Вставить("НаименованиеОбособленногоПодразделения", НаименованиеОбособленногоПодразделения);
		ДанныеПолучателя.Вставить("НаименованиеСтруктурногоПодразделения", НаименованиеСтруктурногоПодразделения);
		ДанныеПолучателя.Вставить("Учредитель", Учредитель);
		ДанныеПолучателя.Вставить("БюджетНаименование", БюджетНаименование);
		ДанныеПолучателя.Вставить("КодРПБС", КодРПБС);
		ДанныеПолучателя.Вставить("КодРПБСПодр", КодРПБСПодр);
		ДанныеПолучателя.Вставить("ГлаваБК", ГлаваБК);
		ДанныеПолучателя.Вставить("ОКТМО", ОКТМО);
		
		ОбластьПолучатель.Параметры.Заполнить(ДанныеПолучателя);
		ТабличныйДокумент.Вывести(ОбластьПолучатель);
		
		//Шапка2
		ВидИмущества = ДанныеЭДОтправленногоАкта.ОбщиеРеквизитыДокумента.ВидИмущества;
		АналитическаяГруппа = ДанныеЭДОтправленногоАкта.ОбщиеРеквизитыДокумента.АналитическаяГруппа;

		НаименованиеОснования = ДанныеЭДОтправленногоАкта.ДокументОснование.Наим;
		НомерОснования = ДанныеЭДОтправленногоАкта.ДокументОснование.Номер;
		ДатаОснования = ДанныеЭДОтправленногоАкта.ДокументОснование.Дата;
		
		НаименованиеПриказа = ДанныеЭДОтветногоАкта.ДокументОснованиеОСозданииКомиссии.Наим;
		НомерПриказа = ДанныеЭДОтветногоАкта.ДокументОснованиеОСозданииКомиссии.Номер;
		ДатаПриказа = ДанныеЭДОтветногоАкта.ДокументОснованиеОСозданииКомиссии.Дата;
		
		ДанныеШапки2 = Новый Структура;
		ДанныеШапки2.Вставить("ВидИмущества", ВидИмущества);
		ДанныеШапки2.Вставить("АналитическаяГруппа", АналитическаяГруппа);

		ДанныеШапки2.Вставить("НаименованиеОснования", НаименованиеОснования);
		ДанныеШапки2.Вставить("НомерОснования", НомерОснования);
		ДанныеШапки2.Вставить("ДатаОснования", ДатаОснования);

		ДанныеШапки2.Вставить("НаименованиеПриказа", НаименованиеПриказа);
		ДанныеШапки2.Вставить("НомерПриказа", НомерПриказа);
		ДанныеШапки2.Вставить("ДатаПриказа", ДатаПриказа);

		ОбластьШапка2.Параметры.Заполнить(ДанныеШапки2);
		ТабличныйДокумент.Вывести(ОбластьШапка2);
		
		//Раздел1_Шапка
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент.Вывести(ОбластьР1Шапка);

		Количество			= 0;
		Сумма				= 0;
		СуммаВложений		= 0;
		СуммаАмортизации	= 0;
		СуммаОбесценения	= 0;
		
		МетодыНачисления = УправлениеОсновнымиСредствамиПовтИсп.СпособыНачисленияАмортизации_Соответствие();
		
		Для Каждого ТекСтрока Из ДанныеЭДОтправленногоАкта.СведенияОПередаваемыхОбъектахНФА Цикл
			ОбластьР1Строка.Параметры.Заполнить(ТекСтрока);
			
			ДанныеСтрокиРаздела1 = Новый Структура;
			ДанныеСтрокиРаздела1.Вставить("НомерСтроки", ТекСтрока.КодСтроки);
			ДанныеСтрокиРаздела1.Вставить("КодОбъекта", ТекСтрока.ИдентификационныйНомерОбъекта);
			ДанныеСтрокиРаздела1.Вставить("КодГруппы", ТекСтрока.ИдентификационныйНомерГруппы);
			ДанныеСтрокиРаздела1.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			ДанныеСтрокиРаздела1.Вставить("СуммаВложений", ТекСтрока.СуммаФактКапВложений);
			ДанныеСтрокиРаздела1.Вставить("Цена", ТекСтрока.ЦенаЗаЕдиницу);
			ДанныеСтрокиРаздела1.Вставить("Сумма", ТекСтрока.БалансоваяСтоимость);
			ДанныеСтрокиРаздела1.Вставить("СрокЭксплуатации", ТекСтрока.ФактическийСрокЭксплуатации);
			ДанныеСтрокиРаздела1.Вставить("АмортизационнаяГруппа", ТекСтрока.КодАмортизационнойГруппы);
			
			МетодАмортизации = "";
			Если ЗначениеЗаполнено(ТекСтрока.МетодНачисленияАмортизации) Тогда
				МетодАмортизации = МетодыНачисления[ТекСтрока.МетодНачисленияАмортизации];
			КонецЕсли;
			
			ДанныеСтрокиРаздела1.Вставить("МетодАмортизации", МетодАмортизации);
			ДанныеСтрокиРаздела1.Вставить("ДатаОкончанияАмортизации", ТекСтрока.ДатаОкончанияНачисленияАмортизации);
			ДанныеСтрокиРаздела1.Вставить("СуммаАмортизации", ТекСтрока.СуммаНачисленнойАмортизации);
			ДанныеСтрокиРаздела1.Вставить("СуммаОбесценения", ТекСтрока.СуммаНачисленногоОбесценения);

			ОбластьР1Строка.Параметры.Заполнить(ДанныеСтрокиРаздела1);
			
			ТабличныйДокумент.Вывести(ОбластьР1Строка);
			
			Количество			= Количество		+ ТекСтрока.Количество;
			Сумма				= Сумма				+ ТекСтрока.БалансоваяСтоимость;
			СуммаВложений		= СуммаВложений		+ ТекСтрока.СуммаФактКапВложений;
			СуммаАмортизации	= СуммаАмортизации	+ ТекСтрока.СуммаНачисленнойАмортизации;
			СуммаОбесценения	= СуммаОбесценения	+ ТекСтрока.СуммаНачисленногоОбесценения;
		КонецЦикла;
		
		ОбластьР1Подвал.Параметры.Заполнить(Новый Структура("Количество,Сумма,СуммаВложений,СуммаАмортизации,СуммаОбесценения",
			Количество, Сумма, СуммаВложений, СуммаАмортизации, СуммаОбесценения));
		ТабличныйДокумент.Вывести(ОбластьР1Подвал);
		
		//Раздел2_Шапка
		ТабличныйДокумент.Вывести(ОбластьР2Шапка);
		
 		Для Каждого ТекСтрока Из ДанныеЭДОтправленногоАкта.ИндивидуальныеХарактеристикиОбъектовНФА Цикл
			ДанныеСтрокиРаздела2 = Новый Структура;
			ДанныеСтрокиРаздела2.Вставить("НомерСтроки", ТекСтрока.КодСтроки);
			ДанныеСтрокиРаздела2.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			ДанныеСтрокиРаздела2.Вставить("Адрес", ТекСтрока.АдресМестоположениеОбъекта);
			ДанныеСтрокиРаздела2.Вставить("Назначение", ТекСтрока.НазначениеОбъекта);
			ДанныеСтрокиРаздела2.Вставить("Характеристика", ТекСтрока.ПризнакХарактеристикаНаименование);
			ДанныеСтрокиРаздела2.Вставить("ЗначениеХарактеристики", ТекСтрока.ПризнакХарактеристикаЗначение);
			ДанныеСтрокиРаздела2.Вставить("Деталь", ТекСтрока.Деталь);
			ДанныеСтрокиРаздела2.Вставить("Драгметалл", ТекСтрока.ДрагоценныйМатериал);
			ДанныеСтрокиРаздела2.Вставить("НаименованиеЕИ", ТекСтрока.ЕдИзмНаим);
			ДанныеСтрокиРаздела2.Вставить("КодЕИ", ТекСтрока.ЕдИзмКод);
			ДанныеСтрокиРаздела2.Вставить("Количество", ТекСтрока.Количество);
			
			Если НЕ ЗначениеЗаполнено(ДанныеСтрокиРаздела2.НаименованиеНФА) Тогда
				ДанныеСтрокиРаздела2.НомерСтроки = "";
			КонецЕсли;	

			ОбластьР2Строка.Параметры.Заполнить(ДанныеСтрокиРаздела2);
			
			ТабличныйДокумент.Вывести(ОбластьР2Строка);
			
		КонецЦикла;

		//Раздел3_Шапка
		ТабличныйДокумент.Вывести(ОбластьР3Шапка);
		
		СвязанныеКонтрагенты = ДанныеЭДОтправленногоАкта.СвязанныеКонтрагенты;
		
		Для Каждого ТекСтрока Из ДанныеЭДОтправленногоАкта.СведенияОбОграниченияхОбременениях Цикл
			ДанныеСтрокиРаздела3 = Новый Структура;
			ДанныеСтрокиРаздела3.Вставить("НомерСтроки", ТекСтрока.КодСтроки);
			ДанныеСтрокиРаздела3.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			ДанныеСтрокиРаздела3.Вставить("ЕдИзмОграничения", ТекСтрока.ЕдИзмОграничения);
			ДанныеСтрокиРаздела3.Вставить("ЗначениеОграничения", ТекСтрока.ЗначениеОграничения);
			ДанныеСтрокиРаздела3.Вставить("РегистрацияНомер", ТекСтрока.НомерДокументаОснованияРегистрации);
			ДанныеСтрокиРаздела3.Вставить("РегистрацияДата", ТекСтрока.ДатаДокументаОснованияРегистрации);
			ДанныеСтрокиРаздела3.Вставить("ВидОграничения", ТекСтрока.ВидОграничения);
			ДанныеСтрокиРаздела3.Вставить("НачалоОграничения", ТекСтрока.ДатаНачалаОграничения);
			ДанныеСтрокиРаздела3.Вставить("ОкончаниеОграничения", ТекСтрока.ДатаОкончанияОграничения);
			ДанныеСтрокиРаздела3.Вставить("СрокОграничения", ТекСтрока.СрокОграничения);
			ДанныеСтрокиРаздела3.Вставить("ПлатаЗаЕдОграничения", ТекСтрока.ЦенаПлатыЗаЕдиницу);
			ДанныеСтрокиРаздела3.Вставить("СуммаПлатыЗаОграничение", ТекСтрока.СуммаПлатыЗаВесьСрок);
			ДанныеСтрокиРаздела3.Вставить("СуммаПлатыЗаОграничениеЗаМесяц", ТекСтрока.СуммаПлатыЗаМесяц);
			ДанныеСтрокиРаздела3.Вставить("ВидДокументаОграничения", ТекСтрока.ВидДокументаОснования);
			ДанныеСтрокиРаздела3.Вставить("НомерДокументаОграничения", ТекСтрока.НомерДокументаОснования);
			ДанныеСтрокиРаздела3.Вставить("ДатаДокументаОграничения", ТекСтрока.ДатаДокументаОснования);
			
			GUIDКонтрагента = ТекСтрока.GUIDКонтрагента;
			
			СведенияСвязанногоКонтрагента = СведенияСвязанногоКонтрагентаОтправленногоАктаПередачиНФА(СвязанныеКонтрагенты, GUIDКонтрагента);
			ДанныеСтрокиРаздела3.Вставить("НаименованиеКонтрагентаОграничения", СведенияСвязанногоКонтрагента.НаименованиеКонтрагента);
			Если ЗначениеЗаполнено(СведенияСвязанногоКонтрагента.ОГРН) Тогда
				ДанныеСтрокиРаздела3.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРН);
			Иначе
				ДанныеСтрокиРаздела3.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРНИП);
			КонецЕсли;
			ДанныеСтрокиРаздела3.Вставить("ИННКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ИНН);
			ДанныеСтрокиРаздела3.Вставить("КППКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КПП);
			ДанныеСтрокиРаздела3.Вставить("ОКОПФКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоОКОПФ);
			ДанныеСтрокиРаздела3.Вставить("КИСЭКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоКИСЭ);
			
			ДанныеСтрокиРаздела3.Вставить("НомерКартыОграничения", ТекСтрока.НомерКарты);
			
			ОбластьР3Строка.Параметры.Заполнить(ДанныеСтрокиРаздела3);
			
			ТабличныйДокумент.Вывести(ОбластьР3Строка);
		КонецЦикла;
		
		//СведенияИсполнителя
		СведенияИсполнителя = Новый Структура;
		СведенияИсполнителя.Вставить("ДолжностьНаименование", ДанныеЭДОтправленногоАкта.ИсполнительОтправителя.Должность);
		СведенияИсполнителя.Вставить("ФИО", ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтправленногоАкта.ИсполнительОтправителя));
		СведенияИсполнителя.Вставить("НомерТелефона", ДанныеЭДОтправленногоАкта.ИсполнительОтправителя.Телефон);
		СведенияИсполнителя.Вставить("ЭлектроннаяПочта", ДанныеЭДОтправленногоАкта.ИсполнительОтправителя.ЭлектронныйАдрес);
		ОбластьИсполнитель1.Параметры.Заполнить(СведенияИсполнителя);
		
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель1);
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		
		//Раздел4_Шапка
		ТабличныйДокумент.Вывести(ОбластьР4Шапка);
		
		//ОбластьР4Строка
		Для Каждого ТекСтрока Из ДанныеЭДОтветногоАкта.СведенияОПринятыхОбъектахНФА Цикл
			ДанныеСтрокиРаздела4 = Новый Структура;
			ДанныеСтрокиРаздела4.Вставить("НомерСтроки", ТекСтрока.КодСтроки);
			ДанныеСтрокиРаздела4.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			ДанныеСтрокиРаздела4.Вставить("ВидИмущества", ТекСтрока.ВидИмущества);
			ДанныеСтрокиРаздела4.Вставить("СуммаВложений", ТекСтрока.СуммаФактКапВложений);
			ДанныеСтрокиРаздела4.Вставить("Сумма", ТекСтрока.БалансоваяСтоимость);
			Если Нрег(СокрЛП(ТекСтрока.ВидИмущества)) = Нрег("вложения в нефинансовые активы") Тогда
				Если (ТекСтрока.СуммаФактКапВложений = 0) И (ТекСтрока.БалансоваяСтоимость > 0) Тогда
					ДанныеСтрокиРаздела4.СуммаВложений = ТекСтрока.БалансоваяСтоимость;
					ДанныеСтрокиРаздела4.Сумма = ТекСтрока.СуммаФактКапВложений;
				КонецЕсли;	
			КонецЕсли;	
			ДанныеСтрокиРаздела4.Вставить("АмортизационнаяГруппа", ТекСтрока.АмортизационнаяГруппа);
			
			МетодАмортизации = "";
			Если ЗначениеЗаполнено(ТекСтрока.МетодНачисленияАмортизации) Тогда
				МетодАмортизации = МетодыНачисления[ТекСтрока.МетодНачисленияАмортизации];
			КонецЕсли;
			
			ДанныеСтрокиРаздела4.Вставить("МетодАмортизации", МетодАмортизации);
			ДанныеСтрокиРаздела4.Вставить("ДатаОкончанияАмортизации", ТекСтрока.ДатаОкончанияНачисленияАмортизации);
			ДанныеСтрокиРаздела4.Вставить("СрокПолезногоИспользования", ТекСтрока.СрокПолезногоИспользования);
			ДанныеСтрокиРаздела4.Вставить("Количество", ТекСтрока.Количество);
			ДанныеСтрокиРаздела4.Вставить("АналитическаяГруппа", ТекСтрока.АналитическаяГруппа);
			ДанныеСтрокиРаздела4.Вставить("НормаАмортизации", ТекСтрока.СуммаНормыАмортизации);
			
			ОбластьР4Строка.Параметры.Заполнить(ДанныеСтрокиРаздела4);
			
			ТабличныйДокумент.Вывести(ОбластьР4Строка);
		КонецЦикла;
		
		// Приложения
		Сч = 0;
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		Если ДанныеЭДОтправленногоАкта.ФайлыПриложений.Количество() > 0 Тогда
			Для Каждого ТекФайл Из ДанныеЭДОтправленногоАкта.ФайлыПриложений Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				Сч = Сч + 1;
				
				ДанныеОПриложенномФайле = Новый Структура;
				ДанныеОПриложенномФайле.Вставить("Номер", Сч);
				ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.НаименованиеДокументаФайла),
					ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
				ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
				
				ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
				ТабличныйДокумент.Вывести(ОбластьПриложение);
			КонецЦикла;
		КонецЕсли;
		
		// Приложения Отправителя
		Если ДанныеЭДОтветногоАкта.ФайлыПриложений.Количество() > 0 Тогда
			Для Каждого ТекФайл Из ДанныеЭДОтветногоАкта.ФайлыПриложений Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТекФайл.ИмяФайла) Тогда
					Сч = Сч + 1;
					
					ДанныеОПриложенномФайле = Новый Структура;
					ДанныеОПриложенномФайле.Вставить("Номер", Сч);
					ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.НаименованиеДокументаФайла),
						ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
					ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
					
					ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
					ТабличныйДокумент.Вывести(ОбластьПриложение);
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		
		// ЦМО
		ПараметрыЦМО			= Новый Структура;
		
		ПараметрыЦМО.Вставить("НаименованиеДолжностиСдал"	, ДанныеЭДОтправленногоАкта.СдалОбъектыСоСтороныОтправителя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьСдал"				, "");
		ПараметрыЦМО.Вставить("ФИОСдал"						, ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтправленногоАкта.СдалОбъектыСоСтороныОтправителя));
		ПараметрыЦМО.Вставить("Сдал"						, "");
		ПараметрыЦМО.Вставить("НаименованиеДолжностиПринял"	, ДанныеЭДОтветногоАкта.ПринялСоСтороныПолучателя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьПринял"				, "");
		ПараметрыЦМО.Вставить("ФИОПринял"					, ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтветногоАкта.ПринялСоСтороныПолучателя));
		ПараметрыЦМО.Вставить("Принял"						, "");
		
		ОбластьЦМО.Параметры.Заполнить(ПараметрыЦМО);
		ТабличныйДокумент.Вывести(ОбластьЦМО);
		
		// Комиссия
		
		// Председатель
		ДанныеПредседателя = Новый Структура("НаименованиеДолжности, ФИО");
		ДанныеПредседателя.НаименованиеДолжности = ДанныеЭДОтветногоАкта.ПредседательКомиссииПолучателя.Должность;
		ДанныеПредседателя.ФИО = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтветногоАкта.ПредседательКомиссииПолучателя);
		
		ОбластьКомиссияП.Параметры.Заполнить(ДанныеПредседателя);
		ТабличныйДокумент.Вывести(ОбластьКомиссияП);
		
		// Члены комиссии
		ПерваяСтрока = Истина;
		Для Каждого ЧленКомиссии Из ДанныеЭДОтветногоАкта.ЧленыКомиссииПолучателя Цикл
			ДанныеЧК = Новый Структура("НаименованиеДолжности, ФИО, Заголовок");
			ДанныеЧК.НаименованиеДолжности = ЧленКомиссии.Должность;
			ДанныеЧК.ФИО = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ЧленКомиссии);;
			ДанныеЧК.Заголовок = ?(ПерваяСтрока, НСтр("ru = 'Члены комиссии:'"), "");
			ОбластьКомиссияС.Параметры.Заполнить(ДанныеЧК);
			ТабличныйДокумент.Вывести(ОбластьКомиссияС);
			ПерваяСтрока = Ложь;
		КонецЦикла;
		
		// Исполнитель получателя
		СведенияИсполнителяПолучателя = Новый Структура;
		СведенияИсполнителяПолучателя.Вставить("ДолжностьНаименование", ДанныеЭДОтветногоАкта.ИсполнительПолучателя.Должность);
		СведенияИсполнителяПолучателя.Вставить("ФИО", ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(ДанныеЭДОтветногоАкта.ИсполнительПолучателя));
		СведенияИсполнителяПолучателя.Вставить("НомерТелефона", ДанныеЭДОтветногоАкта.ИсполнительПолучателя.Телефон);
		СведенияИсполнителяПолучателя.Вставить("ЭлектроннаяПочта", ДанныеЭДОтветногоАкта.ИсполнительПолучателя.ЭлектронныйАдрес);
		
		ОбластьИсполнитель2.Параметры.Заполнить(СведенияИсполнителяПолучателя);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель2);
		
		//Штампы ЭП
		ПараметрыПечатиЭД = Новый Структура;
		ПараметрыПечатиЭД.Вставить("Организация", ТекДок.Организация);
		
		Если ДанныеЭДОтправленногоАкта.СведенияОПодписантах.Количество() = 0 Тогда
			Если ОтправленныйАкт = ТекДок.Ссылка Тогда
				ДокУчета = ОтправленныйАкт.ДокументОснование;
				ИдентификаторПечати = "АктПриемаПередачи0510448";
				Если ТипЗнч(ДокУчета) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
					ИЛИ ТипЗнч(ДокУчета) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
					ИдентификаторПечати = "АктПриемаПередачи0510448ПоСебестоимости";
				КонецЕсли;	
				
				СведенияОбЭлектронныхПодписях = ЭлектронныеДокументыБГУ.СведенияОбЭлектронныхПодписях(ДокУчета, ИдентификаторПечати);
				Для Каждого ТекСтрокаЭП Из СведенияОбЭлектронныхПодписях Цикл
					НовыеДанныеЭП = ДанныеЭДОтправленногоАкта.СведенияОПодписантах.Добавить();
					ЗаполнитьЗначенияСвойств(НовыеДанныеЭП, ТекСтрокаЭП);
					НовыеДанныеЭП.НаименованиеПользователяПодписанта = ТекСтрокаЭП.Пользователь;
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;	
		
		ДобавитьШтампыЭлектронныхПодписейДляПредставленияАктаПриемаПередачиНФА(ТабличныйДокумент,
			ДанныеЭДОтправленногоАкта.СведенияОПодписантах,
			ДанныеЭДОтветногоАкта.СведенияОПодписантах,
			ПараметрыПечатиЭД);

		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ТекДок.Ссылка);
	КонецЦикла;
		
	Возврат ТабличныйДокумент;

КонецФункции

// Конец СтандартныеПодсистемы.Печать

#КонецОбласти

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	Результат = Новый Структура;
	ЕдиницаИзмеренияШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(796);
	Реквизиты = "ТипЭлектронногоАкта, Организация, Контрагент, Договор, Номер, Дата, ДокументОснование, ВходящийАктОПриемеПередачеОбъектовНФА, СуммаДокумента, Пояснение";
	ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
	
	Если ЗначенияРеквизитовДокумента.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаПередающейСтороны() Тогда

		ДокументОснование = ЗначенияРеквизитовДокумента.ДокументОснование;
		ИнвентарныеНомера = Новый Массив;
		ОбъектыНФА = Новый Массив;
		ОбъектыМЦ = Новый Массив;

		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
			ИнвентарныеНомера = ДокументОснование.ОсновныеСредства.Выгрузить(, "ИнвентарныйНомер");
			ОбъектыНФА = ДокументОснование.ОсновныеСредства.Выгрузить(, "ОсновноеСредство");
			ОбъектыНФА.Свернуть("ОсновноеСредство");
			ОбъектыМЦ = ДокументОснование.ДрагоценныеМатериалы.Выгрузить(, "ОбъектМЦ");
			ОбъектыМЦ.Свернуть("ОбъектМЦ"); 
		КонецЕсли;
		
		ДатаСведений = ЗначенияРеквизитовДокумента.Дата;
		ПередаватьДополнительныеРеквизитыОбъектовНФА = ЭлектронныеДокументыБГУ.ПередаватьДополнительныеРеквизитыОбъектовНФА(ЗначенияРеквизитовДокумента.Организация); 
		ПередаватьДополнительныеСведенияОбъектовНФА  = ЭлектронныеДокументыБГУ.ПередаватьДополнительныеСведенияОбъектовНФА(ЗначенияРеквизитовДокумента.Организация);
		ПередаватьДополнительныеСведенияИРеквизитыНФА = ПередаватьДополнительныеРеквизитыОбъектовНФА ИЛИ ПередаватьДополнительныеСведенияОбъектовНФА;		
		
		Запрос = Новый Запрос;
		Запрос.Текст = ЗапросДанныхДляЭД(); 
		Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитовДокумента.Организация);
		Запрос.УстановитьПараметр("ДокументЭД", ДокументСсылка);
		Запрос.УстановитьПараметр("ДокументОснованиеЭД", ДокументОснование);
		Запрос.УстановитьПараметр("ИнвентарныеНомера", ИнвентарныеНомера);
		Запрос.УстановитьПараметр("ОбъектыНФА", ОбъектыНФА); 
		Запрос.УстановитьПараметр("ОбъектыМЦ", ОбъектыМЦ);
		Запрос.УстановитьПараметр("Штуки", ЕдиницаИзмеренияШт);
		Запрос.УстановитьПараметр("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
		Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
		Запрос.УстановитьПараметр("ТипАдрес", Перечисления.ТипыКонтактнойИнформации.Адрес);
		Запрос.УстановитьПараметр("ВидАдрес", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Адрес",,Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Контактная информация справочника ""Основные средства""")));
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ТаблицаШапкаАкта = РезультатЗапроса[0].Выгрузить();
		ТаблицаНФА = РезультатЗапроса[2].Выгрузить();
		ТаблицаПаспортныеДанные = РезультатЗапроса[3].Выгрузить();
		ТаблицаПаспортныеДанныеДрагМатериалы = РезультатЗапроса[4].Выгрузить();
		АдресаОбъектовНФА = РезультатЗапроса[5].Выгрузить();
		ТаблицаДанныеДрагМатериалы = РезультатЗапроса[6].Выгрузить();
		СведенияОПрослеживаемости = РезультатЗапроса[7].Выгрузить();
		СведенияКадастровогоУчета = РезультатЗапроса[8].Выгрузить();
		ОграниченияПоИнвентарнымОбъектам = РезультатЗапроса[9].Выгрузить();
        МЦОбъектовНФАСДрагМатериалами = РезультатЗапроса[10].Выгрузить();
		
		Если ПередаватьДополнительныеСведенияИРеквизитыНФА Тогда 
			
			Если ОбъектыНФА.Количество() = 0  
									И ТаблицаНФА.Количество() > 0 Тогда
				ОбъектыНФА = ТаблицаНФА.Скопировать(,"Номенклатура");
				ОбъектыНФА.Свернуть("Номенклатура");
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст = ЗапросДопСведенийНФАДляЭД();
			Запрос.УстановитьПараметр("ОбъектыНФА", ОбъектыНФА);
			ДополнительныеСведенияИРеквизитыОбъектовНФА = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
			ИдентификаторКомандыПечати = "АктПриемаПередачи0510448ПоСебестоимости";
		Иначе	
			ИдентификаторКомандыПечати = "АктПриемаПередачи0510448";
		КонецЕсли;	
		ВнутрениийЭД = ВнутреннийЭДО.АктуальныйЭлектронныйДокумент(ДокументОснование, ИдентификаторКомандыПечати);
		
		СведенияВнутреннегоЭДО = ВнутрениийЭД;
		
		Если ТаблицаШапкаАкта.Количество() > 0 Тогда
			ШапкаАкта = ТаблицаШапкаАкта[0];
		КонецЕсли;	
		ФайлыАкта = РезультатЗапроса[1].Выгрузить();
	
		//Первоначальный акт
		Реквизиты = "Организация, Дата, Подразделение, ОтветственныйИсполнитель";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаАкта.ДокументОснование, Реквизиты);
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ШапкаАкта.ДокументОснование);
		
		Если ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
			ИЛИ ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
			ТаблицаДанныеАкта = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
			МЗПоСебестоимости = Истина;
			Для Каждого Документ Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
				МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
				МенеджерДокумента.ДобавитьДанныеДляПечати0510448(ТаблицаДанныеАкта, Документ.Значение, МЗПоСебестоимости);
			КонецЦикла;
		ИначеЕсли ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") 
			ИЛИ ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда 
			ТаблицаДанныеАкта = Документы.ПринятиеКУчетуОбъектовОС.ДанныеДляПечати0510448(МассивОбъектов);
		КонецЕсли;
		Если ТаблицаДанныеАкта.Количество() > 0 Тогда
			ДанныеАкта = ТаблицаДанныеАкта[0];
		КонецЕсли;	

		Руководитель = ДанныеАкта.Руководитель;
		ОтветственныйИсполнитель = ЗначенияРеквизитов.ОтветственныйИсполнитель;
		СдалОбъектыСоСтороныОтправителя = Справочники.Сотрудники.ПустаяСсылка();
		
		//Должностные лица
		Если ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			Реквизиты = "Организация, Дата, Подразделение, Руководитель, ОтветственныйПередалТРУ, ЦМО";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаАкта.ДокументОснование, Реквизиты);
			
			Руководитель = ЗначенияРеквизитов.Руководитель;
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМО) Тогда
				Реквизиты = "Сотрудник";
				ЗначенияРеквизитовЦМО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ЦМО, Реквизиты);
				СдалОбъектыСоСтороныОтправителя = ЗначенияРеквизитовЦМО.Сотрудник;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
			Реквизиты = "Организация, Дата, Подразделение, Руководитель, ЦМО";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаАкта.ДокументОснование, Реквизиты);
			Руководитель = ЗначенияРеквизитов.Руководитель;
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМО) Тогда
				Реквизиты = "Сотрудник";
				ЗначенияРеквизитовЦМО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ЦМО, Реквизиты);
				СдалОбъектыСоСтороныОтправителя = ЗначенияРеквизитовЦМО.Сотрудник;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
			Реквизиты = "ОтветственныйПередалТРУ, ЦМО";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаАкта.ДокументОснование, Реквизиты);
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМО) Тогда
				Реквизиты = "Сотрудник";
				ЗначенияРеквизитовЦМО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ЦМО, Реквизиты);
				СдалОбъектыСоСтороныОтправителя = ЗначенияРеквизитовЦМО.Сотрудник;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(ШапкаАкта.ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
			Реквизиты = "ОтветственныйПередалТРУ, ЦМО";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаАкта.ДокументОснование, Реквизиты);
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМО) Тогда
				Реквизиты = "Сотрудник";
				ЗначенияРеквизитовЦМО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ЦМО, Реквизиты);
				СдалОбъектыСоСтороныОтправителя = ЗначенияРеквизитовЦМО.Сотрудник;
			КонецЕсли;	
		КонецЕсли;
		
		ДолжностныеЛица = Новый Структура;
		ДолжностныеЛица.Вставить("Руководитель", Руководитель);
		ДолжностныеЛица.Вставить("ОтветственныйИсполнитель", ОтветственныйИсполнитель);
		ДолжностныеЛица.Вставить("СдалОбъектыСоСтороныОтправителя", СдалОбъектыСоСтороныОтправителя);
		
		ДвиженияДокументовМЗ = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
		
		Для Каждого ТекСтрока Из ТаблицаНФА Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				ОтборСтрокиДокумента = Новый Структура("Номенклатура, СчетКт, КПСКт, Количество",
					ТекСтрока.Номенклатура, ТекСтрока.СчетУчета, ТекСтрока.КПС, ТекСтрока.Количество);
				СтрокиДвижений = ДвиженияДокументовМЗ.НайтиСтроки(ОтборСтрокиДокумента);
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					ТекСтрока.СтоимостьЕдиницы = Окр(СтрокаСебестоимости.Цена, 2);
					ТекСтрока.Сумма = СтрокаСебестоимости.Сумма;
					ТекСтрока.Всего = СтрокаСебестоимости.Сумма;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		Результат.Вставить("ТипАкта", ЗначенияРеквизитовДокумента.ТипЭлектронногоАкта);
		Результат.Вставить("ДанныеАкта", ДанныеАкта);
		Результат.Вставить("ШапкаАкта", ШапкаАкта);
		Результат.Вставить("ТаблицаНФА", ТаблицаНФА);
		Результат.Вставить("ТаблицаПаспортныеДанные", ТаблицаПаспортныеДанные);
		Результат.Вставить("ТаблицаПаспортныеДанныеДрагМатериалы", ТаблицаПаспортныеДанныеДрагМатериалы);
		Результат.Вставить("АдресаОбъектовНФА", АдресаОбъектовНФА);
		Результат.Вставить("ТаблицаДанныеДрагМатериалы", ТаблицаДанныеДрагМатериалы);
		Результат.Вставить("СведенияОПрослеживаемости", СведенияОПрослеживаемости);
		Результат.Вставить("СведенияКадастровогоУчета", СведенияКадастровогоУчета);
		Результат.Вставить("ОграниченияПоИнвентарнымОбъектам", ОграниченияПоИнвентарнымОбъектам);
		Результат.Вставить("МЦОбъектовНФАСДрагМатериалами", МЦОбъектовНФАСДрагМатериалами);
		
		Если ПередаватьДополнительныеСведенияИРеквизитыНФА Тогда
			Результат.Вставить("ДополнительныеСведенияИРеквизитыОбъектовНФА", ДополнительныеСведенияИРеквизитыОбъектовНФА);
		КонецЕсли;

		Результат.Вставить("ДолжностныеЛица", ДолжностныеЛица);
		Результат.Вставить("ФайлыАкта", ФайлыАкта);
		
		Результат.Вставить("СведенияВнутреннегоЭДО", СведенияВнутреннегоЭДО);
	Иначе
		//Ответный акт
		ДокументПринятияКУчету = ЗначенияРеквизитовДокумента.ДокументОснование;
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ДокументПринятияКУчету);
		
		ДанныеДляПечати = ДанныеДляПечати0510448(ДокументПринятияКУчету);
		
		Если НЕ ЗначениеЗаполнено(ДанныеДляПечати) Тогда
			Возврат Результат;
		КонецЕсли;	
		
		ДанныеПечатиОбщие = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
		
		СведенияАктаПередачиНФА = Неопределено;
		
		ДанныеПечатиОбщиеДокумента = ДанныеПечатиОбщие.Получить(ДокументПринятияКУчету);
			
		Для Каждого ВыборкаДокументов Из ДанныеДляПечати Цикл
			СведенияАктаПередачиНФА = ЭлектронныеДокументыБГУ.СведенияЭДАктаПередачиНФАПоДокументу(ЗначенияРеквизитовДокумента.ВходящийАктОПриемеПередачеОбъектовНФА);
			ЭлектронныеДокументыБГУ.ДополнитьСведенияАктаПередачиНФАСведенияПолучателя(СведенияАктаПередачиНФА, ДанныеПечатиОбщиеДокумента, ДокументПринятияКУчету, ВыборкаДокументов);
		КонецЦикла;
		
		ФайлыАкта = ЭлектронныеДокументыБГУ.ДанныеФайловПрисоединенныхКДокументуАктаПередачиНФА(ДокументПринятияКУчету);
		
		ИдентификаторКомандыПечати = "ОтветныйАктПриемаПередачи0510448";
		ВнутрениийЭД = ВнутреннийЭДО.АктуальныйЭлектронныйДокумент(ДокументПринятияКУчету, ИдентификаторКомандыПечати);
		
		СведенияВнутреннегоЭДО = ВнутрениийЭД;
		
		Результат.Вставить("ТипАкта", ЗначенияРеквизитовДокумента.ТипЭлектронногоАкта);
		Результат.Вставить("Номер", ЗначенияРеквизитовДокумента.Номер);
		Результат.Вставить("Дата", ЗначенияРеквизитовДокумента.Дата);
		Результат.Вставить("Пояснение", ЗначенияРеквизитовДокумента.Пояснение);
		Результат.Вставить("Организация", ЗначенияРеквизитовДокумента.Организация);
		Результат.Вставить("Контрагент", ЗначенияРеквизитовДокумента.Контрагент);
		Результат.Вставить("Договор", ЗначенияРеквизитовДокумента.Договор);
		Результат.Вставить("СуммаДокумента", ЗначенияРеквизитовДокумента.СуммаДокумента);
		Результат.Вставить("СведенияАктаПередачиНФА", СведенияАктаПередачиНФА);
		Результат.Вставить("ДокументПринятияКУчету", ДокументПринятияКУчету);
		Результат.Вставить("ВходящийАкт", ЗначенияРеквизитовДокумента.ВходящийАктОПриемеПередачеОбъектовНФА);
		Результат.Вставить("СведенияВнутреннегоЭДО", СведенияВнутреннегоЭДО);
		Результат.Вставить("ФайлыАкта", ФайлыАкта);
		
		Если НЕ ЗначениеЗаполнено(СведенияАктаПередачиНФА) Тогда
			Результат.ТипАкта = 0;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляПечати0510448(ДокументПринятияКУчету)
	Результат = Неопределено;

	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ДокументПринятияКУчету);
	Если ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		Результат = Документы.ПринятиеКУчетуОбъектовОС.ДанныеДляПечати0510448(МассивДокументов);
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		Результат = Документы.ПринятиеКУчетуОбъектовОС.ДанныеДляПечати0510448(МассивДокументов);
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОС") 
		ИЛИ ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
		Результат = Документы.ПоступлениеОС.ДанныеДляПечатиОтветного0510448(МассивДокументов);
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете") Тогда
		ДанныеДляПечати = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		МЗПоСебестоимости = Ложь;                                         	
		Документы.ПрочееОтражениеЭлектронногоДокументаВУчете.ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивДокументов, МЗПоСебестоимости);
		
		Результат = ДанныеДляПечати;
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеМЗ") 
		ИЛИ ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
		ДанныеДляПечати = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		ДокументЗначение = Новый Массив;
		ДокументЗначение.Добавить(ДокументПринятияКУчету);
		МЗПоСебестоимости = Ложь;                                         	
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументПринятияКУчету);
		МенеджерДокумента.ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, ДокументЗначение, МЗПоСебестоимости);
		
		Для Каждого СведенияАктаПередачиНФА Из ДанныеДляПечати Цикл
			ЭтоУчетМЗКазны = Ложь;
			ВидИмуществаИК = НСтр("ru = 'казна'");
			ВидИмуществаДляВложений = "";
			
			Если ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
				Реквизиты = "СчетУчета";
				ЗначенияРеквизитовУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, Реквизиты);
				Если ЗначениеЗаполнено(ЗначенияРеквизитовУчета.СчетУчета) Тогда
					РеквизитыКода = "Код";
					ЗначенияРеквизитовСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитовУчета.СчетУчета, РеквизитыКода);
					Если ЗначенияРеквизитовСчета.Код = "106.50" Тогда
						ВидИмуществаИК = НСтр("ru = 'вложения в нефинансовые активы казны'");;
					КонецЕсли;	
				КонецЕсли;
				СведенияАктаПередачиНФА.ВидИмущества = ВидИмуществаИК;
				ЭтоУчетМЗКазны = Истина;
			ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
				Реквизиты = "СчетУчета";
				ЗначенияРеквизитовУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, Реквизиты);
				Если ЗначениеЗаполнено(ЗначенияРеквизитовУчета.СчетУчета) Тогда
					РеквизитыКода = "Код";
					ЗначенияРеквизитовСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитовУчета.СчетУчета, РеквизитыКода);
					Если ЗначенияРеквизитовСчета.Код = "106.00" Тогда
						ВидИмуществаДляВложений = НСтр("ru = 'вложения в нефинансовые активы'");
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого СтрокаПринимаемыйОбъект Из СведенияАктаПередачиНФА.ПринятыеОбъектыНФА Цикл
				Если ЭтоУчетМЗКазны Тогда
					СтрокаПринимаемыйОбъект.АналитическаяГруппа = "50";
					СтрокаПринимаемыйОбъект.ВидИмущества = ВидИмуществаИК;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВидИмуществаДляВложений) Тогда
					СтрокаПринимаемыйОбъект.ВидИмущества = ВидИмуществаДляВложений;
					Если (СтрокаПринимаемыйОбъект.СуммаВложений = 0) И (СтрокаПринимаемыйОбъект.Сумма > 0) Тогда
						СтрокаПринимаемыйОбъект.СуммаВложений = СтрокаПринимаемыйОбъект.Сумма;
						СтрокаПринимаемыйОбъект.Сумма = 0;
					КонецЕсли;	
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЦикла;	
		
		Результат = ДанныеДляПечати;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	
	Результат = Истина;

	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Документ-основание"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		
		Результат = Ложь;
	КонецЕсли;	

	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		Если ДокументСсылка.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаПередающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен получатель.'"); 
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнен отправитель.'"); 
		КонецЕсли;	
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес получателя.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо получателя.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		Участник = Контрагент;
		СведенияОбУчастнике = Неопределено; 
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике);
		
		Если Участник.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			КодОКПО = СведенияОбУчастнике.КодОКПО;
			Если ЗначениеЗаполнено(КодОКПО) Тогда
				Если СтрДлина(КодОКПО)<>8 Тогда
					ОписаниеОшибки = НСтр("ru='Код ОКПО для контрагента-получателя должен иметь длину 8 знаков.'");
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросДанныхДляЭД()
	
	Результат = "ВЫБРАТЬ
	            |	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Организация КАК Организация,
	            |	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Контрагент КАК Контрагент,
	            |	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Договор КАК Договор,
	            |	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ЭтоВозвратНФА КАК ЭтоВозвратНФА,
	            |	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПередачаСведенийОбАдресахНФА КАК ПередачаСведенийОбАдресахНФА,
	            |	ПРЕДСТАВЛЕНИЕ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Договор) КАК ДоговорНаименование,
	            |	ВЫРАЗИТЬ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Договор КАК Справочник.Договоры).НомерДоговора КАК ДоговорНомер,
	            |	ВЫРАЗИТЬ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДоговорДата,
	            |	ВЫРАЗИТЬ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Договор КАК Справочник.Договоры).ВидОбязательства КАК ВидДоговораНаименование,
	            |	ВЫБОР
	            |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование) = ТИП(Документ.ПередачаОбъектовОС)
	            |			ТОГДА ВЫРАЗИТЬ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование КАК Документ.ПередачаОбъектовОС).ВидИмущества
	            |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование) = ТИП(Документ.ПередачаОбъектовИК)
	            |			ТОГДА ВЫРАЗИТЬ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование КАК Документ.ПередачаОбъектовИК).ВидИмущества
	            |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование) = ТИП(Документ.НакладнаяНаОтпускМ15)
	            |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка)
	            |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование) = ТИП(Документ.НакладнаяНаОтпускИК)
	            |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка)
	            |	КОНЕЦ КАК ВидИмущества,
	            |	ВЫБОР
