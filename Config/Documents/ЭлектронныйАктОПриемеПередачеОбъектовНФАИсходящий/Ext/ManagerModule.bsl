#КонецОбласти

Функция СведенияСвязанногоКонтрагентаОтправленногоАктаПередачиНФА(СвязанныеКонтрагенты, GUIDКонтрагента) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("ОГРН", "");
	Результат.Вставить("ОГРНИП", "");
	Результат.Вставить("КодПоКИСЭ", "");
	Результат.Вставить("КодПоОКОПФ", "");
	Результат.Вставить("НаименованиеКонтрагента", "");
	
	ПараметрыОтбораКонтрагента = Новый Структура;
	ПараметрыОтбораКонтрагента.Вставить("GUIDКонтрагента", GUIDКонтрагента);
	НайденныеСтрокиКонтрагента = СвязанныеКонтрагенты.НайтиСтроки(ПараметрыОтбораКонтрагента);
	Если НайденныеСтрокиКонтрагента.Количество()>0 Тогда
		ЗаполнитьЗначенияСвойств(Результат, НайденныеСтрокиКонтрагента[0]); 
	КонецЕсли;
	
	Возврат Результат; 
КонецФункции	

Процедура ДобавитьШтампыЭлектронныхПодписейДляПредставленияАктаПриемаПередачиНФА(ТабличныйДокумент, ПодписиОтправителя, ПодписиПолучателя, ПараметрыПечати) Экспорт
	
	ОтображатьДатуПодписанияВШтампеВизуализацииПЭП = Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить();
	Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП И ПараметрыПечати.Свойство("Организация") Тогда
		ОтображатьДатуПодписанияВШтампеВизуализацииПЭП = ЭлектронныеДокументыБГУ.ОтображатьДатуПодписанияПоОрганизации(ПараметрыПечати.Организация);
	КонецЕсли;
	
	КоличествоПодписантов = 0;
	Если ЗначениеЗаполнено(ПодписиОтправителя) Тогда
		КоличествоПодписантов = ПодписиОтправителя.Количество();
	КонецЕсли;
	
	КоличествоПодписантовОтветногоАкта = 0;
	Если ЗначениеЗаполнено(ПодписиПолучателя) Тогда
		КоличествоПодписантовОтветногоАкта = ПодписиПолучателя.Количество();
	КонецЕсли;
	
	ВсегоПодписей = КоличествоПодписантов;
	
	Если КоличествоПодписантовОтветногоАкта > ВсегоПодписей Тогда
		ВсегоПодписей = КоличествоПодписантовОтветногоАкта;
	КонецЕсли;
	
	МакетЭПБГУ = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ШтампыПредставленияЭДБГУ");
	
	Штамп = Новый ТабличныйДокумент;
	
	Подписи = Новый ТаблицаЗначений;
	
	Подписи.Колонки.Добавить("ПростаяПодпись", Новый ОписаниеТипов("Булево"));
	Подписи.Колонки.Добавить("ДатаПодписи", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Подписи.Колонки.Добавить("ВремяПодписи", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
	Подписи.Колонки.Добавить("КомуВыданСертификат", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("НаименованиеОрганизации", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("Должность", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("ПодписьВерна", Новый ОписаниеТипов("Булево"));
	Подписи.Колонки.Добавить("Владелец", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("СерийныйНомерСертификата", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("ДатаНачалаСертификата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Подписи.Колонки.Добавить("ДатаОкончанияСертификата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Подписи.Колонки.Добавить("НаименованиеПользователяПодписанта", Новый ОписаниеТипов("Строка"));
	
	Подписи.Колонки.Добавить("НомерМЧД", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("ПредставлениеМЧД", Новый ОписаниеТипов("Строка"));
	Подписи.Колонки.Добавить("ДатаВыдачиМЧД", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Подписи.Колонки.Добавить("ДатаОкончанияМЧД", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	
	Для н = 0 По ВсегоПодписей-1 Цикл
		Счетчик = 0;
		Подписи.Очистить();
		
		Если н < ПодписиОтправителя.Количество() Тогда
			НовПодпись = Подписи.Добавить();
			ЗаполнитьЗначенияСвойств(НовПодпись, ПодписиОтправителя[н]);
		Иначе
			НовПодпись = Подписи.Добавить();
		КонецЕсли;	
		
		Если н < ПодписиПолучателя.Количество() Тогда
			НовПодпись = Подписи.Добавить();
			ЗаполнитьЗначенияСвойств(НовПодпись, ПодписиПолучателя[н]);
		Иначе
			НовПодпись = Подписи.Добавить();
		КонецЕсли;	
		
		Для Каждого Подпись Из Подписи Цикл
			Счетчик = Счетчик + 1;
			
			Если Подпись.ПростаяПодпись Тогда
				Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП Тогда
					ОбластьШтамп = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПСДатойОдинарныйСтрока|ШтампОдинарный");
					ОбластьШтампПустой = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПСДатойОдинарныйСтрока|ШтампОдинарныйРазделитель");
				Иначе	
					ОбластьШтамп = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПОдинарныйСтрока|ШтампОдинарный");
					ОбластьШтампПустой = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПОдинарныйСтрока|ШтампОдинарныйРазделитель");
				КонецЕсли;
			Иначе
				Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП Тогда
					ОбластьШтамп = МакетЭПБГУ.ПолучитьОбласть("ШтампЭПСДатойОдинарныйСтрока|ШтампОдинарный");
					ОбластьШтампПустой = МакетЭПБГУ.ПолучитьОбласть("ШтампЭПСДатойОдинарныйСтрока|ШтампОдинарныйРазделитель");
				Иначе	
					ОбластьШтамп = МакетЭПБГУ.ПолучитьОбласть("ШтампЭПОдинарныйСтрока|ШтампОдинарный");
					ОбластьШтампПустой = МакетЭПБГУ.ПолучитьОбласть("ШтампЭПОдинарныйСтрока|ШтампОдинарныйРазделитель");
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Подпись.Владелец) И Подпись.ПростаяПодпись Тогда
				Если ЗначениеЗаполнено(Подпись.НаименованиеПользователяПодписанта) Тогда
					Подпись.Владелец = Подпись.НаименованиеПользователяПодписанта;
				КонецЕсли;	
			КонецЕсли;	

			Если ЗначениеЗаполнено(Подпись.Владелец) Тогда
				ЗаполнитьОбластьШтампа(ОбластьШтамп, Подпись);
				
				Если Счетчик = 1 Тогда
					ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
				Иначе
					
					Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП Тогда
						Разделитель = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПСДатойОдинарныйСтрока|ШтампОдинарныйРазделитель");
					Иначе	
						Разделитель = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПОдинарныйСтрока|ШтампОдинарныйРазделитель");
					КонецЕсли;
					ОбщегоНазначенияБЭД.ПрисоединитьОбластьКТабличномуДокументу(Штамп, Разделитель, "Разделитель");
				
					ОбщегоНазначенияБЭД.ПрисоединитьОбластьКТабличномуДокументу(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
					
				КонецЕсли;
				
			Иначе
				Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП Тогда
					ОбластьШтампПустойБГУ = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПСДатойОдинарныйПустойСтрока|ШтампОдинарный");
				Иначе
					ОбластьШтампПустойБГУ = МакетЭПБГУ.ПолучитьОбласть("ШтампПЭПОдинарныйПустойСтрока|ШтампОдинарный");
				КонецЕсли;
				ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(Штамп, ОбластьШтампПустойБГУ, "ШтампЭП" + Счетчик);
			КонецЕсли;	
		
		КонецЦикла;
	
		Штамп.Область().СоздатьФорматСтрок();
		ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(ТабличныйДокумент, Штамп, "ШтампЭП");
		Штамп.Очистить();
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьОбластьШтампа(ОбластьЭП, Подпись) Экспорт
	Если ЗначениеЗаполнено(Подпись.Владелец) Тогда
		ОтметкаВерна   = НСтр("ru='Подпись верна'");
		ОтметкаНеВерна = НСтр("ru='Подпись не верна'");
		ТекстОтметки = ?(Подпись.ПодписьВерна, ОтметкаВерна, ОтметкаНеВерна);
		
		ЗначенияПараметров = Новый Структура;
		ДатаПодписи = "";
		Если ЗначениеЗаполнено(Подпись.ДатаПодписи) Тогда
			Если НачалоДня(Подпись.ДатаПодписи) = Подпись.ДатаПодписи Тогда
				ДатаПодписи = Формат(Подпись.ДатаПодписи, "ДФ=dd.MM.yyyy");
			Иначе
				ДатаПодписи = Формат(Подпись.ДатаПодписи, "ДФ='dd.MM.yyyy HH:mm:ss'");
			КонецЕсли;	
			Если ЗначениеЗаполнено(Подпись.ВремяПодписи) Тогда
				ДатаПодписи = СтрШаблон("%1 %2", Формат(Подпись.ДатаПодписи, "ДФ=dd.MM.yyyy"), Формат(Подпись.ВремяПодписи, "ДФ=HH:mm:ss"));
			КонецЕсли;	
		КонецЕсли;	
		Если Подпись.ПростаяПодпись Тогда
			ЗначенияПараметров.Вставить("Организация",			Подпись.НаименованиеОрганизации);
			ЗначенияПараметров.Вставить("Должность", 			Подпись.Должность);
			ЗначенияПараметров.Вставить("ВладелецПодписи",		Подпись.Владелец);
			ЗначенияПараметров.Вставить("УстановившийПодпись",	Подпись.НаименованиеПользователяПодписанта);
			ЗначенияПараметров.Вставить("ДатаПодписи",          ДатаПодписи);
			ЗначенияПараметров.Вставить("ТекстОтметки",        ТекстОтметки);
		Иначе	
			Шаблон = НСтр("ru='с %1 по %2'");
			СрокДействия = СтрШаблон(Шаблон, Подпись.ДатаНачалаСертификата, Подпись.ДатаОкончанияСертификата);
			
			ВладелецСертификата = Подпись.КомуВыданСертификат;
			Если ЗначениеЗаполнено(Подпись.НомерМЧД) Тогда
				ОтметкаМЧД = СтрШаблон(НСтр("ru='по доверенности %1, %2, действует: с %3 по %4'"), Подпись.НомерМЧД, Подпись.ПредставлениеМЧД,
					Формат(Подпись.ДатаВыдачиМЧД, "ДФ=dd.MM.yyyy"), Формат(Подпись.ДатаОкончанияМЧД, "ДФ=dd.MM.yyyy"));
				ВладелецИСведенияМЧД = СтрШаблон(НСтр("ru='%1, %2'"), ВладелецСертификата, ОтметкаМЧД);
				ВладелецСертификата = ВладелецИСведенияМЧД;
			КонецЕсли;
				
			ЗначенияПараметров.Вставить("Организация",			Подпись.НаименованиеОрганизации);
			ЗначенияПараметров.Вставить("НомерСертификата",		Подпись.СерийныйНомерСертификата);
			ЗначенияПараметров.Вставить("ВладелецСертификата",	ВладелецСертификата);
			ЗначенияПараметров.Вставить("СрокДействия",			СрокДействия);
			ЗначенияПараметров.Вставить("ДатаПодписи",          ДатаПодписи);
			ЗначенияПараметров.Вставить("ТекстОтметки",         ТекстОтметки);
		КонецЕсли;
		ОбластьЭП.Параметры.Заполнить(ЗначенияПараметров);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
