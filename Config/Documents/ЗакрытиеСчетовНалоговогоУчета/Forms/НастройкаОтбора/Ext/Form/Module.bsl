
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Отбор", АдресОтбора);
	
	ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресОтбора);
	Отбор.Загрузить(ТаблицаОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьОтбор(Команда)
	
	ЗаписатьИЗакрытьЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	Отбор.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ТаблицаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		ПомеситьОтборВХранилище();
		ОповеститьОВыборе(АдресОтбора);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТаблицаЗаполнена()
	
	Отказ = Ложь;
	
	Сч = 0;
	Для Каждого Строка Из Отбор Цикл
		Если Не ЗначениеЗаполнено(Строка.Счет) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", "Счет", Сч+1, "Отбор");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Отбор["+Сч+"].Счет",,Отказ);
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;	
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ПомеситьОтборВХранилище()
	
	ПоместитьВоВременноеХранилище(Отбор.Выгрузить(), АдресОтбора);
	
КонецПроцедуры

#КонецОбласти
