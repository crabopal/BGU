&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Если Объект.ВидОперации =
			ПредопределенноеЗначение("Перечисление.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ЗакрытиеГода") Тогда
		// В конце года закрываются счета доходов и расходов (по субсчетам),
		// и прочие счета, по которым остатки не переходят на следующий год.
		Элементы.НадписьСчетаУчета.Заголовок = НСтр("ru = 'Н90.01-Н90.06, Н91.01-Н91.02, Н25, Н26, Н44, Н69, Н70, НПВ'");
		Элементы.НадписьСчетаУчета.Гиперссылка = Ложь;
	ИначеЕсли Объект.ВидОперации =
			ПредопределенноеЗначение("Перечисление.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ПереходНаДругуюСистемуНалогообложения") Тогда
		// При переходе на другую систему налогообложения списываем остатки по всем счетам налогового учета.
		Элементы.НадписьСчетаУчета.Заголовок = НСтр("ru = 'Н01-Н99, НКВ, НПВ'");
		Элементы.НадписьСчетаУчета.Гиперссылка = Ложь;
	Иначе
		Элементы.НадписьСчетаУчета.Заголовок = ПолучитьЗаголовокКнопкиОтбора(Объект.Отбор);
		Элементы.НадписьСчетаУчета.Гиперссылка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПолейВЗависимостиОтСчета(ТекущиеДанные, Счет)
	
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	// Скорректируем признаки доступности оборотных субконто, установленные процедурой
	// БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета().
	// Документ заполняется по остаткам. Если субконто оборотное, остатков по нему нет и заполнять его не нужно.
	Для Индекс = 1 По 3 Цикл
		Если Индекс <= ДанныеСчета.КоличествоСубконто Тогда
			Если ДанныеСчета["ВидСубконто" + Индекс + "ТолькоОбороты"] Тогда
				ТекущиеДанные["Субконто" + Индекс + "Доступность"] = 2; // Необязательное субконто.
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Установим признаки доступности ресурсов регистра бухгалтерии в зависимости от свойств счета.
	ТекущиеДанные.НалоговыйУчетНеУчитываемых = ДанныеСчета.НалоговыйУчетНеУчитываемых;
	ТекущиеДанные.НалоговыйУчетЕНВД = ДанныеСчета.НалоговыйУчетЕНВД;
	ТекущиеДанные.НалоговыйУчетНДС = ДанныеСчета.НалоговыйУчетНДС;
	ТекущиеДанные.СчетКоличественный = ДанныеСчета.Количественный;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// СуммаНеУчитываетсяНУ.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаНадписьСуммаНеУчитываетсяНУ");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокДтСуммаНеУчитываетсяНУ");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокКтСуммаНеУчитываетсяНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СчетаНалоговогоУчета.НалоговыйУчетНеУчитываемых",
			ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// СуммаЕНВД.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаНадписьСуммаЕНВД");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокДтСуммаЕНВД");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокКтСуммаЕНВД");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СчетаНалоговогоУчета.НалоговыйУчетЕНВД",
			ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// СуммаНДС.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаНадписьСуммаНДС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокДтСуммаНДС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокКтСуммаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СчетаНалоговогоУчета.НалоговыйУчетНДС",
			ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Количество.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаНадписьКоличество");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокДтКоличество");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СчетаНалоговогоУчетаОстатокКтКоличество");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СчетаНалоговогоУчета.СчетКоличественный",
			ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")

	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища); 
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		Элементы.НадписьСчетаУчета.Заголовок = ПолучитьЗаголовокКнопкиОтбора(Объект.Отбор);
		Результат = Истина;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаголовокКнопкиОтбора(Знач Отбор)
	
	// Список счетов настраивается пользователем вручную.
	Если Отбор.Количество() > 0 Тогда
		СписокСчетов = "";
		Для Каждого ЭлементОтбора Из Отбор Цикл
			СписокСчетов = СписокСчетов + Строка(ЭлементОтбора.Счет.Код) + ", ";
		КонецЦикла;
		Возврат Сред(СписокСчетов, 1, СтрДлина(СписокСчетов)-2);
	Иначе
		Возврат НСтр("ru = 'Настроить отбор'");
	КонецЕсли;
	
КонецФункции

