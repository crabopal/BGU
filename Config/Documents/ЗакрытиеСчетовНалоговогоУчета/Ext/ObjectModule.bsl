#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий 

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ВидОперации <> Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.Прочее Тогда
		Отбор.Очистить();
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ЗакрытиеГода Тогда
		ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ТехнологическиеОперации");
	Иначе
		ВидМежотчетногоПериода = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ по остаткам на счетах налогового учета.
//
Процедура ЗаполнитьДокументПоДаннымУчета() Экспорт

	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ДатаОстатков = ?(ВидОперации = Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ЗакрытиеГода,
		Новый Граница(КонецГода(Дата), ВидГраницы.Включая),
		Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	
	Если ВидОперации = Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ЗакрытиеГода Тогда
		
		// Счета Н90.01-Н90.06 закрываются на Н90.09, счета Н91.01-Н91.02 закрываются на Н91.09.
		Запрос.УстановитьПараметр("СчетаНУ", БухгалтерскийУчет.СписокСчетов(
			"Н90.01,Н90.02,Н90.03,Н90.04,Н90.05,Н90.06,Н91.01,Н91.02"));
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.Организация КАК Организация,
		|	ЕПСБУОстатки.ИФО КАК ИФО,
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ЕПСБУОстатки.КПС КАК КПС,
		|	ЕПСБУОстатки.Подразделение КАК Подразделение,
		|	ЕПСБУОстатки.Счет КАК Счет,
		|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК ОстатокДтСуммаНУ,
		|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокКтСуммаНУ,
		|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК ОстатокДтСуммаНеУчитываетсяНУ,
		|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокКт КАК ОстатокКтСуммаНеУчитываетсяНУ,
		|	ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК ОстатокДтСуммаЕНВД,
		|	ЕПСБУОстатки.СуммаЕНВДОстатокКт КАК ОстатокКтСуммаЕНВД,
		|	ЕПСБУОстатки.СуммаНДСОстатокДт КАК ОстатокДтСуммаНДС,
		|	ЕПСБУОстатки.СуммаНДСОстатокКт КАК ОстатокКтСуммаНДС,
		|	ЕПСБУОстатки.КоличествоОстатокДт КАК ОстатокДтКоличество,
		|	ЕПСБУОстатки.КоличествоОстатокКт КАК ОстатокКтКоличество
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаОстатков, Счет В (&СчетаНУ), , Организация = &Организация) КАК ЕПСБУОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕПСБУОстатки.Счет.Код,
		|	ИФО,
		|	КФО,
		|	Подразделение,
		|	Субконто1";
		
		ОстаткиНУ = Запрос.Выполнить().Выгрузить();
		Для Каждого ОстатокНУ Из ОстаткиНУ Цикл
			НоваяСтрока = СчетаНалоговогоУчета.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокНУ);
		КонецЦикла;
		
	КонецЕсли;
	
	// Остатки по прочим счетам налогового учета списываются без корреспонденции.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК ОстатокДтСуммаНУ,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокКтСуммаНУ,
	|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК ОстатокДтСуммаНеУчитываетсяНУ,
	|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокКт КАК ОстатокКтСуммаНеУчитываетсяНУ,
	|	ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК ОстатокДтСуммаЕНВД,
	|	ЕПСБУОстатки.СуммаЕНВДОстатокКт КАК ОстатокКтСуммаЕНВД,
	|	ЕПСБУОстатки.СуммаНДСОстатокДт КАК ОстатокДтСуммаНДС,
	|	ЕПСБУОстатки.СуммаНДСОстатокКт КАК ОстатокКтСуммаНДС,
	|	ЕПСБУОстатки.КоличествоОстатокДт КАК ОстатокДтКоличество,
	|	ЕПСБУОстатки.КоличествоОстатокКт КАК ОстатокКтКоличество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаОстатков, Счет В (&СчетаНУ), , Организация = &Организация) КАК ЕПСБУОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУОстатки.Счет.Код,
	|	ИФО,
	|	КФО,
	|	Подразделение,
	|	Субконто1";
	
	Если ВидОперации = Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ЗакрытиеГода Тогда
		// Остатки по этим счетам не переходят на следующий год.
		Запрос.УстановитьПараметр("СчетаНУ", БухгалтерскийУчет.СписокСчетов(
			"Н25,Н26,Н44,Н69,Н70,НПВ"));
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ПереходНаДругуюСистемуНалогообложения Тогда
		// При переходе на другую систему налогообложения списываем остатки по всем счетам налогового учета.
		Запрос.УстановитьПараметр("СчетаНУ", БухгалтерскийУчет.СписокСчетов(
			"Н01,Н02,Н04,Н05,Н08,Н10,Н15,Н20,Н25,Н26,Н41,Н42,Н43,Н44,Н69,Н70,Н90,Н91,Н96,Н97,Н99,НКВ,НПВ"));
	Иначе
		// Список счетов настравивается пользователем вручную.
		СписокСчетов = "";
		Для Каждого ОтборПоСчету Из Отбор Цикл
			СписокСчетов = СписокСчетов + ?(ПустаяСтрока(СписокСчетов), "", ",") + Строка(ОтборПоСчету.Счет);
		КонецЦикла;
		Запрос.УстановитьПараметр("СчетаНУ", БухгалтерскийУчет.СписокСчетов(СписокСчетов));
	КонецЕсли;
	
	ОстаткиНУ = Запрос.Выполнить().Выгрузить();
	Для Каждого ОстатокНУ Из ОстаткиНУ Цикл
		НоваяСтрока = СчетаНалоговогоУчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокНУ);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
