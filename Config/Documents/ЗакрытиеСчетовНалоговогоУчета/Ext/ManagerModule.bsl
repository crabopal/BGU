КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата,ВидОперации");
	
	Если РеквизитыДокумента.ВидОперации =
			Перечисления.ВидыОперацийЗакрытияСчетовНалоговогоУчета.ПереходНаДругуюСистемуНалогообложения Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка",      ДокументСсылка);
		Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
		Запрос.УстановитьПараметр("Период",      КонецДня(РеквизитыДокумента.Дата));
		Запрос.УстановитьПараметр("СчетаОСиНМА", БухгалтерскийУчет.СписокСчетов("Н01,Н04"));
		
		ТаблицыЗапроса = Новый Массив;
		
		// Для ОС и НМА на счетах Н01,Н04 обнулим значения в регистре ПервоначальныеСведенияОСНалоговыйУчет,
		// чтобы впоследствии для них можно было снова ввести начальные остатки по НУ.
		ТаблицыЗапроса.Добавить("ОСиНМА");
		ТаблицыЗапроса.Добавить("ПервоначальныеСведенияОСНалоговыйУчет");
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СчетаНалоговогоУчета.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
		|ПОМЕСТИТЬ ОСиНМА
		|ИЗ
		|	Документ.ЗакрытиеСчетовНалоговогоУчета.СчетаНалоговогоУчета КАК СчетаНалоговогоУчета
		|ГДЕ
		|	СчетаНалоговогоУчета.Ссылка = &Ссылка
		|	И СчетаНалоговогоУчета.Счет В(&СчетаОСиНМА)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	ОСиНМА.ОсновноеСредство.Ссылка КАК ОсновноеСредство
		|ИЗ
		|	ОСиНМА КАК ОСиНМА
		|ГДЕ
		|	ОСиНМА.ОсновноеСредство <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)";
		
		Результат = Запрос.ВыполнитьПакет();
		
		ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
		ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
		
	КонецЕсли;
	
КонецПроцедуры

