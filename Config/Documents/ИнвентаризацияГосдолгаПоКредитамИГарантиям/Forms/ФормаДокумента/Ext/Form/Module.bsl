&НаСервере
Процедура НастроитьФормуСервер()
	
	СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("301.00"));
	СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("11"));
	
	ОбновитьДанныеВсехСтрокТаблицыЗадолженность(ЭтаФорма);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияГосдолгаПоКредитамИГарантиям.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеВсехСтрокТаблицыЗадолженность(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.Задолженность Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыЗадолженность(ТекущаяСтрока);
		РассчитатьСуммыИтогоВСтрокеТаблицыЗадолженность(ТекущаяСтрока);
		РассчитатьСуммыИтогоВалВСтрокеТаблицыЗадолженность(ТекущаяСтрока);
	КонецЦикла;
	
	РассчитатьСуммыИтогоПоДокументу(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыЗадолженность(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокПоДаннымБухучета = НСтр("ru = 'По данным бух. учета:'");
	ТекущаяСтрока.ЗаголовокПодтвержденная 	= НСтр("ru = 'Подтвержденная:'");
	ТекущаяСтрока.ЗаголовокНеподтвержденная = НСтр("ru = 'Неподтвержденная:'");
	ТекущаяСтрока.ЗаголовокПросроченная 	= НСтр("ru = 'Просроченная:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыИтогоВСтрокеТаблицыЗадолженность(ТекущаяСтрока)
	
	ТекущаяСтрока.ИтогоПоДаннымБухучета =
		ТекущаяСтрока.СуммаОД + ТекущаяСтрока.СуммаПроцентов;
	
	ТекущаяСтрока.ИтогоПодтвержденная =
		ТекущаяСтрока.СуммаОДПодтвержденная + ТекущаяСтрока.СуммаПроцентовПодтвержденная;
	
	ТекущаяСтрока.ИтогоНеподтвержденная =
		ТекущаяСтрока.СуммаОДНеподтвержденная + ТекущаяСтрока.СуммаПроцентовНеподтвержденная;
	
	ТекущаяСтрока.ИтогоПросроченная =
		ТекущаяСтрока.СуммаОДПросроченная + ТекущаяСтрока.СуммаПроцентовПросроченная;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыИтогоВалВСтрокеТаблицыЗадолженность(ТекущаяСтрока)
	
	ТекущаяСтрока.ИтогоПоДаннымБухучетаВал =
		ТекущаяСтрока.СуммаОДВалютная + ТекущаяСтрока.СуммаПроцентовВалютная;
	
	ТекущаяСтрока.ИтогоПодтвержденнаяВал =
		ТекущаяСтрока.СуммаОДПодтвержденнаяВалютная + ТекущаяСтрока.СуммаПроцентовПодтвержденнаяВалютная;
	
	ТекущаяСтрока.ИтогоНеподтвержденнаяВал =
		ТекущаяСтрока.СуммаОДНеподтвержденнаяВалютная + ТекущаяСтрока.СуммаПроцентовНеподтвержденнаяВалютная;
	
	ТекущаяСтрока.ИтогоПросроченнаяВал =
		ТекущаяСтрока.СуммаОДПросроченнаяВалютная + ТекущаяСтрока.СуммаПроцентовПросроченнаяВалютная;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыИтогоПоДокументу(Форма)
	
	Форма.ИтогоПоДаннымБухучета 	= Форма.Объект.Задолженность.Итог("ИтогоПоДаннымБухучета");
	Форма.ИтогоПодтвержденная 		= Форма.Объект.Задолженность.Итог("ИтогоПодтвержденная");
	Форма.ИтогоНеподтвержденная 	= Форма.Объект.Задолженность.Итог("ИтогоНеподтвержденная");
	Форма.ИтогоПросроченная 		= Форма.Объект.Задолженность.Итог("ИтогоПросроченная");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	ЕстьДанные = (Объект["Задолженность"].Количество() > 0);
	Если ЕстьДанные Тогда
		
		ТекстВопроса = НСтр("ru='При изменении периода рекомендуется очистить табличную часть.
			|
			|Продолжить и очистить табличную часть?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПериода_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Очищаем таблицы:
		Объект["Задолженность"].Очистить();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПросроченныеПоДаннымДоговоровНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабЧасть.НомерСтроки,
	|	ТабЧасть.Договор
	|ПОМЕСТИТЬ Табчасть
	|ИЗ
	|	&ТабЧасть КАК ТабЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СрокИсполнения
	|ПОМЕСТИТЬ Сроки
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
	|			&ДатаЗапроса,
	|			Обязательство В
	|				(ВЫБРАТЬ
	|					Таб.Договор
	|				ИЗ
	|					ТабЧасть КАК Таб)) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Табчасть.НомерСтроки,
	|	Табчасть.Договор,
	|	Сроки.СрокИсполнения
	|ИЗ
	|	Табчасть КАК Табчасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Сроки КАК Сроки
	|		ПО Табчасть.Договор = Сроки.Обязательство
	|ГДЕ
	|	Сроки.СрокИсполнения <= &ДатаЗапроса";
	
	Запрос.УстановитьПараметр("ДатаЗапроса", ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(Объект.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("ТабЧасть", Объект.Задолженность.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НайденнаяСтрока = Объект.Задолженность[Выборка.НомерСтроки-1];
		
		НайденнаяСтрока.СуммаОДПросроченная        = НайденнаяСтрока.СуммаОД;
		НайденнаяСтрока.СуммаПроцентовПросроченная = НайденнаяСтрока.СуммаПроцентов;
		
		НайденнаяСтрока.СуммаОДПросроченнаяВалютная        = НайденнаяСтрока.СуммаОДВалютная;
		НайденнаяСтрока.СуммаПроцентовПросроченнаяВалютная = НайденнаяСтрока.СуммаПроцентовВалютная;
		
		РассчитатьСуммыИтогоВСтрокеТаблицыЗадолженность(НайденнаяСтрока);
		РассчитатьСуммыИтогоВалВСтрокеТаблицыЗадолженность(НайденнаяСтрока);
		
	КонецЦикла;
	
	РассчитатьСуммыИтогоПоДокументу(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

