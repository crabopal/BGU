КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымУчета(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указан вид задолженности'"), , "ВидЗадолженности", "Объект");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнен счет учета'"), , "СчетУчета", "Объект");
		Возврат;
	КонецЕсли;
	
	Если Объект["Задолженность"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
		|табличная часть ""Задолженность""
		|
		|Продолжить и очистить?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчета_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);		
	Иначе
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент()
	
	ЗаполнитьПоДаннымУчетаНаСервере();
	
	Если Объект["Задолженность"].Количество() = 0 Тогда
		Текст = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
		ПоказатьПредупреждение(, Текст, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
	ОбновитьДанныеВсехСтрокТаблицыЗадолженность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымУчетаНаСервере()
	
	Документы.ИнвентаризацияГосдолгаПоКредитамИГарантиям.ЗаполнитьПоДаннымУчета(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодтвержденныеПоДаннымБУ(Команда)
	
	Для Каждого ТекСтрока Из Объект.Задолженность Цикл
		
		ТекСтрока.СуммаОДПодтвержденная = ТекСтрока.СуммаОД;
		ТекСтрока.СуммаОДНеподтвержденная = 0;
		ТекСтрока.СуммаПроцентовПодтвержденная = ТекСтрока.СуммаПроцентов;
		ТекСтрока.СуммаПроцентовНеподтвержденная = 0;
		
		ТекСтрока.СуммаОДПодтвержденнаяВалютная = ТекСтрока.СуммаОДВалютная;
		ТекСтрока.СуммаОДНеподтвержденнаяВалютная = 0;
		ТекСтрока.СуммаПроцентовПодтвержденнаяВалютная = ТекСтрока.СуммаПроцентовВалютная;
		ТекСтрока.СуммаПроцентовНеподтвержденнаяВалютная = 0;
		
		РассчитатьСуммыИтогоВСтрокеТаблицыЗадолженность(ТекСтрока);
		РассчитатьСуммыИтогоВалВСтрокеТаблицыЗадолженность(ТекСтрока);
		
	КонецЦикла;
	
	РассчитатьСуммыИтогоПоДокументу(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

