// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыЗапроса = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", ДокументСсылка.МоментВремени());
	
	//Изменение учетных данных
	
	ТаблицыЗапроса.Добавить("ВТ_УчетныеДанные");
	ТаблицыЗапроса.Добавить("ВТ_ИФО");
	ТаблицыЗапроса.Добавить("УчетныеДанныеОбъектаОС");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Дата КАК Период,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Организация КАК Организация,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.СчетУчетаНовый КАК СчетУчета,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ВидУчетаНовый КАК ВидУчета,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ВидИмуществаНовый КАК ВидИмущества,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.КФОНовый КАК КФО,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.КБКНовый КАК КПС,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.КЭКНовый КАК КЭК
	|ПОМЕСТИТЬ ВТ_УчетныеДанные
	|ИЗ
	|	Документ.ИзменениеДанныхОС.ИзмененияУчетныхДанных КАК ИзменениеДанныхОСИзмененияУчетныхДанных
	|ГДЕ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка = &Ссылка
	|	И ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.ИзменитьУчетныеДанные
	|	И (ИзменениеДанныхОСИзмененияУчетныхДанных.СчетУчетаНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.СчетУчета
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ВидУчетаНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.ВидУчета
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ВидИмуществаНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.ВидИмущества
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.КФОНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.КФО
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.КБКНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.КБК
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.КЭКНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.КЭК)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.ИФО КАК ИФО
	|ПОМЕСТИТЬ ВТ_ИФО
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			(Организация, ОсновноеСредство) В
	|				(ВЫБРАТЬ
	|					ВТ_УчетныеДанные.Организация КАК Организация,
	|					ВТ_УчетныеДанные.ОсновноеСредство КАК ОсновноеСредство
	|				ИЗ
	|					ВТ_УчетныеДанные КАК ВТ_УчетныеДанные)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_УчетныеДанные.Период КАК Период,
	|	ВТ_УчетныеДанные.Организация КАК Организация,
	|	ВТ_УчетныеДанные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_УчетныеДанные.СчетУчета КАК СчетУчета,
	|	ВТ_УчетныеДанные.ВидУчета КАК ВидУчета,
	|	ВТ_УчетныеДанные.ВидИмущества КАК ВидИмущества,
	|	ВТ_УчетныеДанные.КФО КАК КФО,
	|	ВТ_УчетныеДанные.КПС КАК КПС,
	|	ВТ_УчетныеДанные.КЭК КАК КЭК,
	|	ВТ_ИФО.ИФО КАК ИФО
	|ИЗ
	|	ВТ_УчетныеДанные КАК ВТ_УчетныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИФО КАК ВТ_ИФО
	|		ПО ВТ_УчетныеДанные.ОсновноеСредство = ВТ_ИФО.ОсновноеСредство";
	
	
	//Изменение первоначальных сведений
	
	ТаблицыЗапроса.Добавить("ПервоначальныеСведенияОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Дата КАК Период,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Организация КАК Организация,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимостьНовая КАК ПервоначальнаяСтоимость,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаАмортизацииНовая КАК ПервоначальнаяСуммаАмортизации,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаОбесцененияНовая КАК ПервоначальнаяСуммаОбесценения,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимостьВВалютеНовая КАК ПервоначальнаяСтоимостьВВалюте,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ВалютаПоступленияНовая КАК ВалютаПоступления,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.КоличествоНовое КАК Количество,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Курс КАК Курс,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Кратность КАК Кратность
	|ИЗ
	|	Документ.ИзменениеДанныхОС.ИзмененияУчетныхДанных КАК ИзменениеДанныхОСИзмененияУчетныхДанных
	|ГДЕ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка = &Ссылка
	|	И ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.ИзменитьПервоначальныеСведения
	|	И (ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимостьНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимость
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаАмортизацииНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаАмортизации
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаОбесцененияНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСуммаОбесценения
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимостьВВалютеНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ПервоначальнаяСтоимостьВВалюте
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ВалютаПоступленияНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ВалютаПоступления
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.КоличествоНовое <> ИзменениеДанныхОСИзмененияУчетныхДанных.Количество)";
	
	
	//Изменение данных инвентарной карточки
	
	ТаблицыЗапроса.Добавить("НомераИнвентарныхКарточек");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Дата КАК Период,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.Организация КАК Организация,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.НомерИнвентарнойКарточкиНовый КАК НомерИнвентарнойКарточки,
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.ДатаИнвентарнойКарточкиНовая КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	Документ.ИзменениеДанныхОС.ИзмененияУчетныхДанных КАК ИзменениеДанныхОСИзмененияУчетныхДанных
	|ГДЕ
	|	ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка = &Ссылка
	|	И ИзменениеДанныхОСИзмененияУчетныхДанных.Ссылка.ИзменитьИнвентарнаяКарточка
	|	И (ИзменениеДанныхОСИзмененияУчетныхДанных.НомерИнвентарнойКарточкиНовый <> ИзменениеДанныхОСИзмененияУчетныхДанных.НомерИнвентарнойКарточки
	|			ИЛИ ИзменениеДанныхОСИзмененияУчетныхДанных.ДатаИнвентарнойКарточкиНовая <> ИзменениеДанныхОСИзмененияУчетныхДанных.ДатаИнвентарнойКарточки)";	
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

