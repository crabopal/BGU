&НаСервереБезКонтекста
Функция ДанныеПоСчету(СчетУчета)
	
	Результат = Новый Структура;
	Результат.Вставить("ВидУчета"		, УправлениеОсновнымиСредствамиПовтИсп.ВидУчетаПоСчетуУчета(СчетУчета));
	Результат.Вставить("ВидИмущества"	, УправлениеОсновнымиСредствамиПовтИсп.ВидИмуществаПоСчетуУчета(СчетУчета));
	
	Возврат Результат;
	
КонецФункции

