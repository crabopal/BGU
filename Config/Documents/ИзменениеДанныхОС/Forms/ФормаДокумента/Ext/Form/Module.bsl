#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьМассивОграниченийСчета(ЗначенияРеквизитовОС)
	
	ОграниченияСписокСчетов = Новый Массив;
	
	Если ЗначенияРеквизитовОС.ИмуществоКазны И ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны") Тогда
		Если ЗначенияРеквизитовОС.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			ОграниченияСписокСчетов.Добавить("108.54");
		ИначеЕсли ЗначенияРеквизитовОС.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
			ОграниченияСписокСчетов.Добавить("108.55");
		Иначе
			ОграниченияСписокСчетов.Добавить("108.51");
			ОграниченияСписокСчетов.Добавить("108.52");
		КонецЕсли;
	Иначе
		Если ЗначенияРеквизитовОС.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			ОграниченияСписокСчетов.Добавить("102.00");
		ИначеЕсли ЗначенияРеквизитовОС.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
			ОграниченияСписокСчетов.Добавить("103.00");
		ИначеЕсли ЗначенияРеквизитовОС.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
			ОграниченияСписокСчетов.Добавить("106.00");
		Иначе
			ОграниченияСписокСчетов.Добавить("101.00");
			ОграниченияСписокСчетов.Добавить("106.00");
			ОграниченияСписокСчетов.Добавить("107.00");
			ОграниченияСписокСчетов.Добавить("01");
			ОграниченияСписокСчетов.Добавить("02");
		КонецЕсли;
	КонецЕсли;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", Новый ФиксированныйМассив(ОграниченияСписокСчетов)));
	
	Возврат МассивПараметровВыбора;
	
КонецФункции

&НаСервере
Функция ПолучитьОграниченияСчета(ОсновноеСредство)
	ЗначенияРеквизитовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство,"ВидНФА,ИмуществоКазны");
	Возврат Новый ФиксированныйМассив(ПолучитьМассивОграниченийСчета(ЗначенияРеквизитовОС));
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущиеДанныеОС(ОсновноеСредство, Организация, Дата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("Период"			, Новый Граница(Дата, ВидГраницы.Исключая));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС,
	|	УчетныеДанныеОбъектаОССрезПоследних.КЭК КАК КЭК,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ УчетныеДанныеОбъектаОС
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновноеСредство)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСуммаАмортизации КАК ПервоначальнаяСуммаАмортизации,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСуммаОбесценения КАК ПервоначальнаяСуммаОбесценения,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимостьВВалюте КАК ПервоначальнаяСтоимостьВВалюте,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ВалютаПоступления КАК ВалютаПоступления,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Количество КАК Количество,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ПервоначальныеСведенияОСБухгалтерскийУчет
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновноеСредство)) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	НомераИнвентарныхКарточекСрезПоследних.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки,
	|	НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ НомераИнвентарныхКарточек
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновноеСредство)) КАК НомераИнвентарныхКарточекСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс,
	|	КурсыВалютСрезПоследних.Кратность КАК Кратность,
	|	КурсыВалютСрезПоследних.Валюта КАК Валюта
	|ПОМЕСТИТЬ КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(
	|			&Период,
	|			Валюта В
	|				(ВЫБРАТЬ
	|					ВТ.ВалютаПоступления
	|				ИЗ
	|					ПервоначальныеСведенияОСБухгалтерскийУчет КАК ВТ)) КАК КурсыВалютСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОС.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОС.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОС.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОС.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОС.КПС КАК КБК,
	|	УчетныеДанныеОбъектаОС.КЭК КАК КЭК,
	|	НомераИнвентарныхКарточек.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	НомераИнвентарныхКарточек.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСуммаАмортизации КАК ПервоначальнаяСуммаАмортизации,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСуммаОбесценения КАК ПервоначальнаяСуммаОбесценения,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСтоимостьВВалюте КАК ПервоначальнаяСтоимостьВВалюте,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.Количество КАК Количество,
	|	ПервоначальныеСведенияОСБухгалтерскийУчет.ВалютаПоступления КАК ВалютаПоступления,
	|	КурсыВалют.Курс КАК Курс,
	|	КурсыВалют.Кратность КАК Кратность,
	|	ВложенныйЗапрос.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	(ВЫБРАТЬ
	|		УчетныеДанныеОбъектаОС.ОсновноеСредство КАК ОсновноеСредство
	|	ИЗ
	|		УчетныеДанныеОбъектаОС КАК УчетныеДанныеОбъектаОС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПервоначальныеСведенияОСБухгалтерскийУчет.ОсновноеСредство
	|	ИЗ
	|		ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведенияОСБухгалтерскийУчет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НомераИнвентарныхКарточек.ОсновноеСредство
	|	ИЗ
	|		НомераИнвентарныхКарточек КАК НомераИнвентарныхКарточек) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеОбъектаОС КАК УчетныеДанныеОбъектаОС
	|		ПО ВложенныйЗапрос.ОсновноеСредство = УчетныеДанныеОбъектаОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераИнвентарныхКарточек КАК НомераИнвентарныхКарточек
	|		ПО ВложенныйЗапрос.ОсновноеСредство = НомераИнвентарныхКарточек.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведенияОСБухгалтерскийУчет
	|			ЛЕВОЕ СОЕДИНЕНИЕ КурсыВалют КАК КурсыВалют
	|			ПО ПервоначальныеСведенияОСБухгалтерскийУчет.ВалютаПоступления = КурсыВалют.Валюта
	|		ПО ВложенныйЗапрос.ОсновноеСредство = ПервоначальныеСведенияОСБухгалтерскийУчет.ОсновноеСредство";
	
	ДанныеОС = Запрос.Выполнить().Выгрузить();
	
	Если ТипЗнч(ОсновноеСредство) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Если ДанныеОС.Количество() > 0 Тогда
			Результат = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеОС[0]);
		Иначе
			Результат = ПустаяСтруктураДанныхОС();
		КонецЕсли;
	Иначе
		Результат = Новый Соответствие;
		Для Каждого ТекСтрока Из ДанныеОС Цикл
			Результат.Вставить(ТекСтрока.ОсновноеСредство, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТекСтрока));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Оформление представления номера инвентарной карточки
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ИзмененияУчетныхДанныхНомерИнвентарнойКарточкиНовый");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ИзмененияУчетныхДанных.НомерИнвентарнойКарточкиНовый");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ИзмененияУчетныхДанных.НомерИнвентарнойКарточки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ИзмененияУчетныхДанных.ОсновноеСредство");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Исключить>");
	
	
	// Оформление представления даты номера инвентарной карточки
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ИзмененияУчетныхДанныхДатаИнвентарнойКарточкиНовая");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ИзмененияУчетныхДанных.НомерИнвентарнойКарточкиНовый");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоясненияВСтроке(ТекущаяСтрока)
	
	ТекущаяСтрока.НадписьЗначениеДоИзменения	= НСтр("ru = 'до изменения:'");
	ТекущаяСтрока.НадписьЗначениеПослеИзменения	= НСтр("ru = 'после изменения:'");
	
	ТекущаяСтрока.НадписьНомерИнвКарточки		= НСтр("ru = '№:'");
	ТекущаяСтрока.НадписьДатаИнвКарточки		= НСтр("ru = 'от:'");
	
	ТекущаяСтрока.КурсНадпись					= НСтр("ru = 'курс:'");
	ТекущаяСтрока.КратностьНадпись				= НСтр("ru = 'кратность:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстовыеПоляВсехСтрок(Форма)
	
	Для Каждого ТекущаяСтрока Из Форма.Объект.ИзмененияУчетныхДанных Цикл
		ЗаполнитьПоясненияВСтроке(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата) 
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов()
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация"	, "Организация");
	СтруктураРеквизитов.Вставить("Дата"			, "Дата");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(СписокОС)
	
	ДанныеОС = ПолучитьТекущиеДанныеОС(СписокОС, Объект.Организация, Объект.Дата);
	
	Для Каждого ОсновноеСредство Из СписокОС Цикл
		ЭлементКоллекции = Объект.ИзмененияУчетныхДанных.Добавить();
		ЭлементКоллекции.ОсновноеСредство = ОсновноеСредство;
		ДанныеТекОС = ДанныеОС[ОсновноеСредство];
		Если ДанныеТекОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, ДанныеТекОС);
		КонецЕсли;
		ЗаполнитьНовыеДанныеИзСтарых(ЭлементКоллекции);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ПустыеДанныеОС = ПустаяСтруктураДанныхОС();
	ОбъектыОС = Объект.ИзмененияУчетныхДанных.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОС = ПолучитьТекущиеДанныеОС(ОбъектыОС, Объект.Организация, Объект.Дата);
	
	Для Каждого ТекущаяСтрока Из Объект.ИзмененияУчетныхДанных Цикл
		
		ТекущиеДанныеОС = ДанныеОС.Получить(ТекущаяСтрока.ОсновноеСредство);
		
		Если ТекущиеДанныеОС = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПустыеДанныеОС);
		Иначе
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекущиеДанныеОС);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПустаяСтруктураДанныхОС()
	
	Возврат Новый Структура("СчетУчета,ВидУчета,ВидИмущества,КФО,КБК,НомерИнвентарнойКарточки,ДатаИнвентарнойКарточки,
		|ПервоначальнаяСтоимость,ПервоначальнаяСуммаАмортизации,ПервоначальнаяСуммаОбесценения,ПервоначальнаяСтоимостьВВалюте,Количество,ВалютаПоступления");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНовыеДанныеИзСтарых(ТекущаяСтрока)
	
	ТекущаяСтрока.СчетУчетаНовый                      = ТекущаяСтрока.СчетУчета;
	ТекущаяСтрока.ВидУчетаНовый                       = ТекущаяСтрока.ВидУчета;
	ТекущаяСтрока.ВидИмуществаНовый                   = ТекущаяСтрока.ВидИмущества;
	ТекущаяСтрока.КФОНовый                            = ТекущаяСтрока.КФО;
	ТекущаяСтрока.КБКНовый                            = ТекущаяСтрока.КБК;
	ТекущаяСтрока.КЭКНовый                            = ТекущаяСтрока.КЭК;
	ТекущаяСтрока.НомерИнвентарнойКарточкиНовый       = ТекущаяСтрока.НомерИнвентарнойКарточки;
	ТекущаяСтрока.ДатаИнвентарнойКарточкиНовая        = ТекущаяСтрока.ДатаИнвентарнойКарточки;
	ТекущаяСтрока.ПервоначальнаяСтоимостьНовая        = ТекущаяСтрока.ПервоначальнаяСтоимость;
	ТекущаяСтрока.ПервоначальнаяСуммаАмортизацииНовая = ТекущаяСтрока.ПервоначальнаяСуммаАмортизации;
	ТекущаяСтрока.ПервоначальнаяСуммаОбесцененияНовая = ТекущаяСтрока.ПервоначальнаяСуммаОбесценения;
	ТекущаяСтрока.ПервоначальнаяСтоимостьВВалютеНовая = ТекущаяСтрока.ПервоначальнаяСтоимостьВВалюте;
	ТекущаяСтрока.ВалютаПоступленияНовая              = ТекущаяСтрока.ВалютаПоступления;
	ТекущаяСтрока.КоличествоНовое                     = ТекущаяСтрока.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКолонок()
	
	ВсеКолонки = Не Объект.ИзменитьУчетныеДанные
		И Не Объект.ИзменитьИнвентарнаяКарточка
		И Не Объект.ИзменитьПервоначальныеСведения;
	
	Элементы.ИзмененияУчетныхДанныхГруппаСчетУчета.Видимость						= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	Элементы.ИзмененияУчетныхДанныхГруппаВидУчета.Видимость							= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	Элементы.ИзмененияУчетныхДанныхГруппаВидИмущества.Видимость						= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	Элементы.ИзмененияУчетныхДанныхГруппаКФО.Видимость								= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	Элементы.ИзмененияУчетныхДанныхГруппаКПС.Видимость								= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	Элементы.ИзмененияУчетныхДанныхГруппаКЭК.Видимость								= ВсеКолонки Или Объект.ИзменитьУчетныеДанные;
	
	Элементы.КолонкиИнвентарнаяКарточка.Видимость 									= ВсеКолонки Или Объект.ИзменитьИнвентарнаяКарточка;
	
	Элементы.ИзмененияУчетныхДанныхГруппаКоличество.Видимость						= ВсеКолонки Или Объект.ИзменитьПервоначальныеСведения;
	Элементы.ИзмененияУчетныхДанныхГруппаПервоначальнаяСтоимость.Видимость			= ВсеКолонки Или Объект.ИзменитьПервоначальныеСведения;
	Элементы.ИзмененияУчетныхДанныхГруппаПервоначальнаяСтоимостьВВалюте.Видимость	= ВсеКолонки Или Объект.ИзменитьПервоначальныеСведения;
	Элементы.ИзмененияУчетныхДанныхГруппаПервоначальнаяАмортизация.Видимость		= ВсеКолонки Или Объект.ИзменитьПервоначальныеСведения;
	Элементы.ИзмененияУчетныхДанныхГруппаПервоначальноеОбесценение.Видимость		= ВсеКолонки Или Объект.ИзменитьПервоначальныеСведения;
	
КонецПроцедуры

