#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьТаблицуАмортизации", Истина);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	Таблица.Ссылка.Дата КАК Период,
	|	Таблица.Ссылка.Организация КАК Организация,
	|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Таблица.СуммаАмортизации КАК СуммаАмортизации
	|ИЗ
	|	Документ.НачислениеАмортизацииИК.ОсновныеСредства КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|	И Таблица.СуммаАмортизации <> 0";
	
	АмортизацияОбъектовОС = Запрос.Выполнить().Выгрузить();
	ТаблицыДляДвижений.Вставить("АмортизацияОбъектовОС", АмортизацияОбъектовОС);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НачислениеАмортизацииОС";
	КомандаПечати.Идентификатор		= "ВедомостьАмортизации";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость начисленной амортизации'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьТаблицуАмортизации(ТаблицаОтбора, Реквизиты) Экспорт
	
	ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(
		ТаблицаОтбора, Реквизиты, Ложь, Истина, Истина);
	
	ТаблицаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ;
	ТаблицаАмортизации.Сортировать("ОсновноеСредство");
	ТаблицаАмортизации.Колонки.СтоимостьНаКонецПериода.Имя		= "Сумма";
	ТаблицаАмортизации.Колонки.АмортизацияНаКонецПериода.Имя	= "СуммаАмортизацииНачисленная";
	ТаблицаАмортизации.Колонки.ОбесценениеНаКонецПериода.Имя	= "СуммаОбесцененияНачисленная";
	ТаблицаАмортизации.Колонки.СуммаАмортизацииБУ.Имя			= "СуммаАмортизации";
	
	Возврат ТаблицаАмортизации;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
