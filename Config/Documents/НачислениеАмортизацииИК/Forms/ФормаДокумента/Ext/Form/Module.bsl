Процедура УстановитьПредставлениеПериода()
	
	ПредставлениеПериодаРегистрации = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"),
		НачалоМесяца(Объект.Дата), КонецМесяца(Объект.Дата));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументНаКлиенте()
	
	ДлительнаяОперация = ЗаполнитьДокументНаСервере();
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьПоЗавершениюЗаполнения", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение документа начисления амортизации'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ТаблицаОтбора = Объект.Отбор.Выгрузить();
	Реквизиты = Новый Структура("Организация,ИФО,КФО,Подразделение,Дата,Ссылка");
	ЗаполнитьЗначенияСвойств(Реквизиты, Объект);
	
	СведенияЗадания = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Документы.НачислениеАмортизацииИК.ЗаполнитьТаблицуАмортизации", ТаблицаОтбора, Реквизиты);
	
	Возврат СведенияЗадания;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюЗаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьПоЗавершениюЗаполненияСервер(Результат);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПоЗавершениюЗаполненияСервер(Результат)
	
	Данные = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Объект.ОсновныеСредства.Загрузить(Данные);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")
	
	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища);
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПредставлениеКнопкиОтбора()
	
	Если Объект.Отбор.Количество() = 0 Тогда
		пЗаголовок = НСтр("ru = 'Без отбора по счету и КФО'");
	Иначе
		СтрокиОтбора = Новый Массив;
		Для Каждого СтрокаОтбора Из Объект.Отбор Цикл
			СтрокиОтбора.Добавить(Строка(СтрокаОтбора.СчетУчета) + ", " + Строка(СтрокаОтбора.КФО));
		КонецЦикла;
		пЗаголовок = СтрСоединить(СтрокиОтбора, "; ");
	КонецЕсли;
	
	Элементы.ОсновныеСредстваНастроитьОтбор.Заголовок = пЗаголовок;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(Форма)
	
	Для Каждого ТекущаяСтрока Из Форма.Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСрокИспользованияДляВычисленияАмортизации =
		НСтр("ru = 'срок пол. исп.:'");
	ТекущаяСтрока.ЗаголовокСтоимостьДляВычисленияАмортизации =
		НСтр("ru = 'стоимость:'");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДатуОбъекта(ТекДата)                             
	ТекДата = ?(ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюПервымЧислом, НачалоМесяца(ТекДата), КонецМесяца(ТекДата));
	
	Если ТекДата <> Объект.Дата Тогда
		Объект.Дата = ТекДата;
	КонецЕсли;	
КонецПроцедуры	

