
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПараметрыОтбора", ПараметрыОтбора);
	Параметры.Свойство("Отбор", АдресОтбора);
	
	ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресОтбора);
	Отбор.Загрузить(ТаблицаОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьОтбор(Команда)
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвто(Команда)
	
	Если Отбор.Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект),
			НСтр("ru='Таблица будет очищена, продолжить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, НСтр("ru='Начисление амортизации'"));
		
	Иначе
		
		ЗаполнитьТабличнуюЧасть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	Отбор.Очистить();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ТаблицаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		ПомеситьОтборВХранилище();
		ОповеститьОВыборе(АдресОтбора);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТаблицаЗаполнена()
	
	Отказ = Ложь;
	
	Сч = 0;
	Для Каждого Строка Из Отбор Цикл
		Если Не ЗначениеЗаполнено(Строка.СчетУчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", "СчетУчета", Сч+1, "Отбор");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Отбор["+Сч+"].СчетУчета",,Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", "КФО", Сч+1, "Отбор");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Отбор["+Сч+"].КФО",,Отказ);
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ПомеситьОтборВХранилище()
	
	ПоместитьВоВременноеХранилище(Отбор.Выгрузить(), АдресОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧасть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет10850", БухгалтерскийУчет.СписокСчетов("108.00"));
	Запрос.УстановитьПараметр("Счет10450", БухгалтерскийУчет.СписокСчетов("104.50"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ИСТИНА КАК СчетУчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.НомерСтроки = 1)
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет10850)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.НомерСтроки = 1)
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет10450)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
	
	Счета = Запрос.Выполнить().Выгрузить();
	
	СчетаУчета			= Счета.Скопировать(Новый Структура("СчетУчета", Истина), "Ссылка").ВыгрузитьКолонку("Ссылка");
	СчетаАмортизации	= Счета.Скопировать(Новый Структура("СчетУчета", Ложь), "Ссылка").ВыгрузитьКолонку("Ссылка");
	
	Запрос.УстановитьПараметр("СчетаУчета"			, СчетаУчета);
	Запрос.УстановитьПараметр("СчетаАмортизации"	, СчетаАмортизации);
	Запрос.УстановитьПараметр("НачалоПериода"		, НачалоМесяца(ПараметрыОтбора.Дата));
	Запрос.УстановитьПараметр("КонецПериода"		, КонецМесяца(ПараметрыОтбора.Дата));
	Запрос.УстановитьПараметр("Период"				, КонецМесяца(ПараметрыОтбора.Дата)+1);
	Запрос.УстановитьПараметр("Организация"			, ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("ИФО"					, ПараметрыОтбора.ИФО);
	Запрос.УстановитьПараметр("Подразделение"		, ПараметрыОтбора.Подразделение);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаНачальныйОстатокДт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК БалансоваяСтоимостьНач,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаАмортизации)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаНачальныйОстатокКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НачисленнаяАмортизацияНач,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Счет
	|		ИНАЧЕ СоответствиеСчетовОС.СчетОС
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаКонечныйОстатокДт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК БалансоваяСтоимостьКон,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаАмортизации)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаКонечныйОстатокКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НачисленнаяАмортизацияКон
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			ДвиженияИГраницыПериода,
	|			Счет В (&СчетаУчета, &СчетаАмортизации),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеПодразделение) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = СоответствиеСчетовОС.СчетАмортизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.СчетУчета КАК СчетУчета,
	|	Остатки.КФО КАК КФО,
	|	Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(Остатки.БалансоваяСтоимостьНач) КАК БалансоваяСтоимостьНач,
	|	СУММА(Остатки.НачисленнаяАмортизацияНач) КАК НачисленнаяАмортизацияНач,
	|	СУММА(Остатки.БалансоваяСтоимостьКон) КАК БалансоваяСтоимостьКон,
	|	СУММА(Остатки.НачисленнаяАмортизацияКон) КАК НачисленнаяАмортизацияКон
	|ПОМЕСТИТЬ ПодлежатАмортизации
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОсновноеСредство
	|						ИЗ
	|							Остатки КАК Остатки)) КАК НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО Остатки.ОсновноеСредство = НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОсновноеСредство
	|						ИЗ
	|							Остатки КАК Остатки)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО Остатки.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ЕСТЬNULL(НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних.НачислятьАмортизацию, ИСТИНА)
	|	И ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.КФО,
	|	Остатки.ОсновноеСредство,
	|	Остатки.СчетУчета,
	|	НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних.НачислятьАмортизацию
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.БалансоваяСтоимостьНач) <> 0 И
	|	СУММА(Остатки.БалансоваяСтоимостьКон) > СУММА(Остатки.НачисленнаяАмортизацияКон)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодлежатАмортизации.КФО КАК КФО,
	|	ПодлежатАмортизации.СчетУчета КАК СчетУчета
	|ИЗ
	|	ПодлежатАмортизации КАК ПодлежатАмортизации
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодлежатАмортизации.СчетУчета.Порядок,
	|	КФО";
	
	// Отборы по ИФО и Подразделению
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
		И ЗначениеЗаполнено(ПараметрыОтбора.ИФО);
	ИспользоватьУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям()
		И ЗначениеЗаполнено(ПараметрыОтбора.Подразделение);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение",
		?(ИспользоватьУчетПоПодразделениям, "Подразделение = &Подразделение", "ИСТИНА"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Отбор.Загрузить(Результат);
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти
