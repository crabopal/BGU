#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ВидПередачи");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Передача групп объектов ИК (Акт приема-передачи ОС-1б)");
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка КАК Ссылка,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.ДатаСписанияСБухУчета КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ТаблицаОсновныеСредства.Ссылка.ВидПередачи КАК ВидПередачи,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	"""" КАК ПричинаСписания
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ПередачаГруппОбъектовИК.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	НомераТаблиц.Вставить("МестонахождениеОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета) КАК Состояние,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.Ссылка КАК Регистратор,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Передача)";
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Передача)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|		КОГДА ТаблицаОсновныеСредства.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование)
	|		КОГДА ТаблицаОсновныеСредства.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПередачаАренда)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.СдачаВАренду)
	|	КОНЕЦ КАК Событие,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.Ссылка КАК Регистратор,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства";
	
	// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
	// По объектам ОС, списываемым этим документом, амортизация линейным способом не начисляется.
	ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления(РеквизитыДокумента.ВидПередачи);
	ПараметрыСписания.ПереместитьСтоимостьПоЦМО = Ложь;
	УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц,
		ДокументСсылка, ПараметрыСписания);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПередачаГруппОбъектовИК";
	КомандаПечати.Идентификатор		= "ОС1б";
	КомандаПечати.Представление		= НСтр("ru = 'Акт приема-передачи групп объектов ОС (ОС-1б)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Перем ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3, ТабличныйДокумент4;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОС1б") Тогда
		
		ПодготовитьОС1(МассивОбъектов, ОбъектыПечати, ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3, ТабличныйДокумент4);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1б","ОС-1б", ТабличныйДокумент1);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1б_2","ОС-1б (стр. 2)", ТабличныйДокумент2);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1б_3","ОС-1б (стр. 3)", ТабличныйДокумент3);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1б_4","ОС-1б (стр. 4)", ТабличныйДокумент4);
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьОС1(МассивОбъектов, ОбъектыПечати, ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3, ТабличныйДокумент4)
    ТабличныйДокумент1 = Новый ТабличныйДокумент;
	ТабличныйДокумент2 = Новый ТабличныйДокумент;
	ТабличныйДокумент3 = Новый ТабличныйДокумент;
	ТабличныйДокумент4 = Новый ТабличныйДокумент;
	
	ТабличныйДокумент1.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОС1б";
	ТабличныйДокумент2.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОС1б";
	ТабличныйДокумент3.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОС1б";
	ТабличныйДокумент4.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОС1б";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПередачаГруппОбъектовИК.Ссылка КАК Ссылка,
	               |	ПередачаГруппОбъектовИК.Номер КАК пНомер,
	               |	ПередачаГруппОбъектовИК.Дата КАК пДата,
	               |	ПередачаГруппОбъектовИК.Организация КАК Организация,
	               |	ПередачаГруппОбъектовИК.Организация.НаименованиеПолное КАК НаимСдатчика,
	               |	ПередачаГруппОбъектовИК.Организация.КодОКПО КАК КодОКПОСдатчика,
	               |	ПередачаГруппОбъектовИК.ОснованиеДляАкта КАК ОснованиеДляАкта,
	               |	ПередачаГруппОбъектовИК.НомерОснованияДляАкта КАК НомерОснованияДляАкта,
	               |	ПередачаГруппОбъектовИК.ДатаОснованияДляАкта КАК ДатаОснованияДляАкта,
	               |	ПередачаГруппОбъектовИК.ДатаСписанияСБухУчета КАК ДатаПередачи,
	               |	ПередачаГруппОбъектовИК.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	               |	ПередачаГруппОбъектовИК.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	               |	ПередачаГруппОбъектовИК.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	               |	ПередачаГруппОбъектовИК.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	               |	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК МОЛ,
	               |	ПередачаГруппОбъектовИК.Приложение КАК ТекстПриложения,
	               |	"""" КАК ТабНомМОЛСдал,
	               |	ПередачаГруппОбъектовИК.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	ПередачаГруппОбъектовИК.Подразделение КАК ПодрСдатчика,
	               |	ПередачаГруппОбъектовИК.РеквизитыЛицевогоСчета.Владелец КАК ЛицевойСчет,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.НомерСтроки КАК НомСтр,
	               |	ВЫБОР
	               |		КОГДА ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	               |			ТОГДА ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.Наименование
	               |		ИНАЧЕ ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	               |	КОНЕЦ КАК НаимОС,
	               |	ВЫБОР
	               |		КОГДА ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПустаяСсылка)
	               |			ТОГДА """"
	               |		ИНАЧЕ ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1
	               |	КОНЕЦ КАК НомерАмортГруппы,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.ИнвентарныйНомер.ЗаводскойНомер КАК пЗавНомер,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ПередачаГруппОбъектовИКОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА """"
	               |		ИНАЧЕ ГОД(ПередачаГруппОбъектовИКОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска)
	               |	КОНЕЦ КАК ДатаВыпуска,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	               |	0 КАК Всего,
	               |	ЕСТЬNULL(ПередачаГруппОбъектовИКОсновныеСредства.СуммаАмортизации, 0) КАК НачАмортизация,
	               |	ЕСТЬNULL(ПередачаГруппОбъектовИКОсновныеСредства.Сумма - ПередачаГруппОбъектовИКОсновныеСредства.СуммаАмортизации, 0) КАК ОстСтоимость,
	               |	ПРЕДСТАВЛЕНИЕ(ПередачаГруппОбъектовИК.КФО) КАК КФО,
	               |	ПРЕДСТАВЛЕНИЕ(ПередачаГруппОбъектовИК.КПС) КАК КПС,
	               |	ВЫБОР
	               |		КОГДА ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.ИзготовительПоставщик.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.ИзготовительПоставщик.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
	               |		ИНАЧЕ ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство.ИзготовительПоставщик.Наименование
	               |	КОНЕЦ КАК Изготовитель,
	               |	ПередачаГруппОбъектовИКОсновныеСредства.Цена КАК пЦенаЕдиницы,
	               |	ЕСТЬNULL(ПередачаГруппОбъектовИКОсновныеСредства.Сумма, 0) КАК пЦенаПродажи,
	               |	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезнИспПриПост,
	               |	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособАморт
	               |ИЗ
	               |	Документ.ПередачаГруппОбъектовИК КАК ПередачаГруппОбъектовИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаГруппОбъектовИК.ОсновныеСредства КАК ПередачаГруппОбъектовИКОсновныеСредства
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	               |					,
	               |					ОсновноеСредство В
	               |						(ВЫБРАТЬ
	               |							ПередачаГруппОбъектовОС.ОсновноеСредство
	               |						ИЗ
	               |							Документ.ПередачаГруппОбъектовОС.ОсновныеСредства КАК ПередачаГруппОбъектовОС
	               |						ГДЕ
	               |							ПередачаГруппОбъектовОС.Ссылка В (&МассивОбъектов))) КАК РасчетАмортизацииОССрезПоследних
	               |			ПО ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство = РасчетАмортизацииОССрезПоследних.ОсновноеСредство
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	               |					,
	               |					ОсновноеСредство В
	               |						(ВЫБРАТЬ
	               |							ПередачаГруппОбъектовОС.ОсновноеСредство
	               |						ИЗ
	               |							Документ.ПередачаГруппОбъектовОС.ОсновныеСредства КАК ПередачаГруппОбъектовОС
	               |						ГДЕ
	               |							ПередачаГруппОбъектовОС.Ссылка В (&МассивОбъектов))) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	               |			ПО ПередачаГруппОбъектовИКОсновныеСредства.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	               |		ПО ПередачаГруппОбъектовИК.Ссылка = ПередачаГруппОбъектовИКОсновныеСредства.Ссылка
	               |ГДЕ
	               |	ПередачаГруппОбъектовИК.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	пДата,
	               |	пНомер,
	               |	НомСтр
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПередачаГруппОбъектовИКСоставКомиссии.Ссылка КАК Ссылка,
	               |	ПередачаГруппОбъектовИКСоставКомиссии.НомерСтроки КАК НомерСтроки,
	               |	ПередачаГруппОбъектовИКСоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	               |	ПередачаГруппОбъектовИКСоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	               |	ПередачаГруппОбъектовИКСоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	               |	ПередачаГруппОбъектовИКСоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	               |ИЗ
	               |	Документ.ПередачаГруппОбъектовИК.СоставКомиссии КАК ПередачаГруппОбъектовИКСоставКомиссии
	               |ГДЕ
	               |	ПередачаГруппОбъектовИКСоставКомиссии.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка		= Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссияД	= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_1б");
	ОбластьШапка1 		= Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2		= Макет.ПолучитьОбласть("Шапка2");
	ОбластьСтрока2 		= Макет.ПолучитьОбласть("Строка2");
	ОбластьСтрока2П 	= Макет.ПолучитьОбласть("Строка2П");
	ОбластьПодвал2_1 	= Макет.ПолучитьОбласть("Подвал2_1");
	ОбластьКомиссия 	= Макет.ПолучитьОбласть("Комиссия");
	ОбластьПодвал2_2	= Макет.ПолучитьОбласть("Подвал2_2");
	ОбластьШапка3 		= Макет.ПолучитьОбласть("Шапка3");
	ОбластьСтрока3 		= Макет.ПолучитьОбласть("Строка3");
	ОбластьСтрока3П 	= Макет.ПолучитьОбласть("Строка3П");
	ОбластьПодвал3 		= Макет.ПолучитьОбласть("Подвал3");
	ОбластьШапка4 		= Макет.ПолучитьОбласть("Шапка4");
	ОбластьСтрока4 		= Макет.ПолучитьОбласть("Строка4");
	ОбластьПодвал4 		= Макет.ПолучитьОбласть("Подвал4");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент1.ВывестиГоризонтальныйРазделительСтраниц();
			ТабличныйДокумент2 = Новый ТабличныйДокумент;
			ТабличныйДокумент3 = Новый ТабличныйДокумент;
			ТабличныйДокумент4 = Новый ТабличныйДокумент;
			//ТабличныйДокумент2.ВывестиГоризонтальныйРазделительСтраниц();
			//ТабличныйДокумент3.ВывестиГоризонтальныйРазделительСтраниц();
			//ТабличныйДокумент4.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало1 = ТабличныйДокумент1.ВысотаТаблицы + 1;
		//НомерСтрокиНачало2 = ТабличныйДокумент2.ВысотаТаблицы + 1;
		//НомерСтрокиНачало3 = ТабличныйДокумент3.ВысотаТаблицы + 1;
		//НомерСтрокиНачало4 = ТабличныйДокумент4.ВысотаТаблицы + 1;
		
		// подготовим нижнюю часть второй страницы. чтобы проверять что она полностью умещается
		МассивСтр2 = Новый Массив;
		
		МассивСтр2.Добавить(ОбластьПодвал2_1);	
		СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии");
		СтруктураОбластьКомиссия.пСтатусЧленаКомиссии		= "Председатель комиссии";
		СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии	= ВыборкаШапка.ДолжностьПредседателяКомиссии;
		Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии) Тогда
			СтруктураОбластьКомиссия.пЧленКомиссии				= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																											ВыборкаШапка.ФамилияПредседателяКомиссии,
																											ВыборкаШапка.ИмяПредседателяКомиссии,
																											ВыборкаШапка.ОтчествоПредседателяКомиссии));
		Иначе																											
			СтруктураОбластьКомиссия.пЧленКомиссии				= "";
		КонецЕсли;
		ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
		МассивСтр2.Добавить(ОбластьКомиссия);	
		пСтатусЧленаКомиссии = "Члены комиссии";
		ВыборкаКомиссияД.Сбросить();
		ВывелиСтрок = 0;
		Если ВыборкаКомиссияД.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			ВыборкаКомиссия = ВыборкаКомиссияД.Выбрать();
			Пока ВыборкаКомиссия.Следующий() Цикл
				ОбластьКомиссия 	= Макет.ПолучитьОбласть("Комиссия");
				СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии");
				СтруктураОбластьКомиссия.пСтатусЧленаКомиссии		= пСтатусЧленаКомиссии;
				СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии	= ВыборкаКомиссия.ДолжностьЧленаКомиссии;
				СтруктураОбластьКомиссия.пЧленКомиссии				= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																												ВыборкаКомиссия.ФамилияЧленаКомиссии,
																												ВыборкаКомиссия.ИмяЧленаКомиссии,
																												ВыборкаКомиссия.ОтчествоЧленаКомиссии));
				ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
				МассивСтр2.Добавить(ОбластьКомиссия);
				пСтатусЧленаКомиссии = "";
			КонецЦикла;
		КонецЕсли;
		Для Счетчик=ВывелиСтрок По 2 Цикл
			ОбластьКомиссия 	= Макет.ПолучитьОбласть("Комиссия");
			СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии");
			СтруктураОбластьКомиссия.пСтатусЧленаКомиссии		= пСтатусЧленаКомиссии;
			СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии	= "";
			СтруктураОбластьКомиссия.пЧленКомиссии				= "";
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
			МассивСтр2.Добавить(ОбластьКомиссия);
			пСтатусЧленаКомиссии = "";
		КонецЦикла;
		
		ОбластьПодвал2_2.Параметры.Заполнить(ВыборкаШапка);
		МассивСтр2.Добавить(ОбластьПодвал2_2);
		
		
		
		// --------------- 1 страница------------------
		
		ОбластьШапка1.Параметры.Заполнить(ВыборкаШапка);
		СтруктураОбластьШапка1 = Новый Структура("РукДолжнСдатчика,РукСдатчика,АдресСдатчика,РеквСдатчика,СчетОС_Печ,Изготовитель,пНомер");
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.пДата);
		РуководительФИО = Справочники.Сотрудники.ФамилияИО(Руководитель.ОтветственноеЛицоСсылка, Истина, ВыборкаШапка.пДата);											
		СтруктураОбластьШапка1.РукДолжнСдатчика 	= Руководитель.ДолжностьПредставление;
		СтруктураОбластьШапка1.РукСдатчика			= РуководительФИО;
																						
		АдресСдатчика	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонСдатчика	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		СтруктураОбластьШапка1.АдресСдатчика = АдресСдатчика + " тел.: " + ТелефонСдатчика;
		
		РеквСдатчика = "";
		Если ЗначениеЗаполнено(ВыборкаШапка.РеквизитыЛицевогоСчета) Тогда
			РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика",
													"СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ВыборкаШапка.ЛицевойСчет,
																					ВыборкаШапка.РеквизитыЛицевогоСчета,	
																					РеквизитыПлательщика);
			ПлательщикБанковскийСчет 	= РеквизитыПлательщика.НомерСчетаПлательщика;
			ПлательщикНаименованиеБанка = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
			ПлательщикБИКБанка 			= РеквизитыПлательщика.БикБанкаПлательщика;
			ПлательщикКорСчетБанка 		= РеквизитыПлательщика.СчетБанкаПлательщика;
			
			РеквСдатчика = "счет № " + ПлательщикБанковскийСчет + " в " + ПлательщикНаименованиеБанка 
							+ ", БИК " + ПлательщикБИКБанка + ", кор.счет " + ПлательщикКорСчетБанка;
		КонецЕсли;
		СтруктураОбластьШапка1.РеквСдатчика = РеквСдатчика;
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		СчетОС_Печ		= "";
		Изготовитель	= "";
		Если ВыборкаСтроки.Следующий() Тогда
			СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(ВыборкаСтроки.ОсновноеСредство, ВыборкаСтроки.Ссылка);
			КЭК = СчетУчета.КОСГУКт;
			
			СчетОС_Печ		= ВыборкаШапка.КПС + "." + ВыборкаШапка.КФО + "." + СчетУчета + "." + КЭК;
			Изготовитель	= ВыборкаСтроки.Изготовитель;
		КонецЕсли;
		СтруктураОбластьШапка1.СчетОС_Печ		= СчетОС_Печ;			
		СтруктураОбластьШапка1.Изготовитель	= Изготовитель;
		СтруктураОбластьШапка1.пНомер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.пНомер);
		ОбластьШапка1.Параметры.Заполнить(СтруктураОбластьШапка1);
		ТабличныйДокумент1.Вывести(ОбластьШапка1);
		
		// --------------- 2,3,4 страница------------------
		ТабличныйДокумент2.Вывести(ОбластьШапка2);
		ТабличныйДокумент3.Вывести(ОбластьШапка3);
		ТабличныйДокумент4.Вывести(ОбластьШапка4);
		
		
		ВыборкаСтроки.Сбросить();// = ВыборкаШапка.Выбрать();
		КоличествоСтрок = ВыборкаСтроки.Количество();
		
		ИтогЦенаПродажи		= 0;
		ИтогНачСтоимость	= 0;
		
		Пока ВыборкаСтроки.Следующий() Цикл
			
			ОбластьСтрока2.Параметры.Заполнить(ВыборкаСтроки);

			ДокРегистратор		= Неопределено;
			ДатаДокРегистратора	= Дата('00010101');
			УправлениеОсновнымиСредствами.ПолучитьДокументСобытияОС(ВыборкаСтроки.ОсновноеСредство,
																	ВыборкаСтроки.ИнвНомер,
																	ВыборкаШапка.Организация, 
																	Перечисления.ВидыСобытийОС.ВводВЭксплуатацию,
																	ДокРегистратор,
																	ДатаДокРегистратора);
			ОбластьСтрока2.Параметры.Заполнить(Новый Структура("ДатаВвода", ДатаДокРегистратора));
			ОбластьСтрока3.Параметры.Заполнить(ВыборкаСтроки);
			СрокЭкспл = УправлениеОсновнымиСредствами.РассчитатьСрокЭксплуатации(ВыборкаСтроки.ОсновноеСредство,
																				ВыборкаСтроки.ИнвНомер,
																				ВыборкаШапка.Организация, 
																				ВыборкаШапка.пДата);
			ОбластьСтрока3.Параметры.Заполнить(Новый Структура("СрокЭкспл", СрокЭкспл.СрокЭкспл));																				
			ОбластьСтрока4.Параметры.Заполнить(ВыборкаСтроки);
			Если ВыборкаСтроки.НомСтр = КоличествоСтрок Тогда
				// проверим вывод строки и полного подвала
				МассивСтр2.Добавить(ОбластьСтрока2);
				Если Не ТабличныйДокумент2.ПроверитьВывод(МассивСтр2) Тогда
					
					ТабличныйДокумент2.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент3.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент4.ВывестиГоризонтальныйРазделительСтраниц();
					
					ТабличныйДокумент2.Вывести(ОбластьШапка2);
					ТабличныйДокумент3.Вывести(ОбластьШапка3);
					ТабличныйДокумент4.Вывести(ОбластьШапка4);
					
				КонецЕсли;
				МассивСтр2.Удалить(МассивСтр2.ВГраница());
			
			ИначеЕсли НЕ ТабличныйДокумент2.ПроверитьВывод(ОбластьСтрока2) Тогда
				ТабличныйДокумент2.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент3.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент4.ВывестиГоризонтальныйРазделительСтраниц();
				
				ТабличныйДокумент2.Вывести(ОбластьШапка2);
