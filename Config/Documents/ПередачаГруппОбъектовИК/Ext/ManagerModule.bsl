				ТабличныйДокумент4.Вывести(ОбластьШапка4);
				
			КонецЕсли;
			ТабличныйДокумент2.Вывести(ОбластьСтрока2);
			ТабличныйДокумент3.Вывести(ОбластьСтрока3);
			ТабличныйДокумент4.Вывести(ОбластьСтрока4);
			
			ИтогЦенаПродажи = ИтогЦенаПродажи + ВыборкаСтроки.пЦенаПродажи;
		КонецЦикла;
		
		Для каждого ТекСтрМассива Из МассивСтр2 Цикл
		
			ТабличныйДокумент2.Вывести(ТекСтрМассива);	
		
		КонецЦикла; 
		
		МОЛ = ВыборкаШапка.МОЛ;
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", МОЛ, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьПодвал3 = Новый Структура("ИтогЦенаПрдажи,ДолжностьМОЛСдал,ФИОМОЛСдал,ТабНомМОЛСдал,ГлавБухСдатчика");
		СтруктураОбластьПодвал3.ИтогЦенаПрдажи	= ИтогЦенаПродажи;
		СтруктураОбластьПодвал3.ДолжностьМОЛСдал	= ДанныеСотрудника.Должность;
		СтруктураОбластьПодвал3.ФИОМОЛСдал			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника);
		СтруктураОбластьПодвал3.ТабНомМОЛСдал		= ВыборкаШапка.ТабНомМОЛСдал;
		
		ГлБухгалтер = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация,
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.пДата);
		ГлБухгалтерФИО = Справочники.Сотрудники.ФамилияИО(ГлБухгалтер.ОтветственноеЛицоСсылка, Истина, ВыборкаШапка.пДата);											
		СтруктураОбластьПодвал3.ГлавБухСдатчика	= ГлБухгалтерФИО;																			
		ОбластьПодвал3.Параметры.Заполнить(СтруктураОбластьПодвал3);
		ТабличныйДокумент3.Вывести(ОбластьПодвал3);
		
		ТабличныйДокумент4.Вывести(ОбластьПодвал4);
		
		ТабличныйДокумент1.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент1.Вывести(ТабличныйДокумент2);
		ТабличныйДокумент1.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент1.Вывести(ТабличныйДокумент3);
		ТабличныйДокумент1.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент1.Вывести(ТабличныйДокумент4);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент1, 
		                                               НомерСтрокиНачало1, ОбъектыПечати, ВыборкаШапка.Ссылка);
		//УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент2, 
