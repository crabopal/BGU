#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт

	ПараметрыПодбора.Вставить("Казна", 					Истина);
	ПараметрыПодбора.Вставить("ТребуемыеДанные",		"ГрупповойУчет,СчетУчета,Цена");
	
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер",
		ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны);
	ПараметрыПодбора.Отбор.Вставить("КФО",				Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("КПС",				Объект.КПС);
	ПараметрыПодбора.Отбор.Вставить("ИФО",				Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение",	Объект.Подразделение);
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт

	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПередачи", НСтр("ru='Вид передачи'"));
	СтруктураРеквизитов.Вставить("Организация");
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если УчитываетсяПодразделение(Объект.ВидПередачи) Тогда
		СтруктураРеквизитов.Вставить("Подразделение");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("КПС");
	
    Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтруктуруПроверяемыхРеквизитов(ВключатьПодразделение=Ложь)
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПередачи", НСтр("ru='Вид передачи'"));
	СтруктураРеквизитов.Вставить("Организация");
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если ВключатьПодразделение Тогда
		СтруктураРеквизитов.Вставить("Подразделение");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("КПС");
	
    Возврат СтруктураРеквизитов;
КонецФункции

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(Объект.ОсновныеСредства,ВыбранноеЗначение,,"ОсновноеСредство,ИнвентарныйНомер");
	
	Для каждого ЭлементКоллекции Из Объект.ОсновныеСредства Цикл
		
		Элементы.ОсновныеСредстваКоличество.ТолькоПросмотр = НЕ ЭлементКоллекции.ГрупповойУчет И НЕ ЭлементКоллекции.ВидНФА = Перечисления.ВидыНФА.КапВложения;
		Если НЕ ЭлементКоллекции.ГрупповойУчет И НЕ ЭлементКоллекции.ВидНФА = Перечисления.ВидыНФА.КапВложения И ЭлементКоллекции.Количество<>1 Тогда
			ЭлементКоллекции.Количество = 1;
		КонецЕсли;

		//РассчитатьБалансовуюСтоимостьИАмортизацию(ЭлементКоллекции.ОсновноеСредство, ЭлементКоллекции.ИнвентарныйНомер,  ЭлементКоллекции.Сумма, ЭлементКоллекции.СуммаАмортизации, ЭлементКоллекции.Количество, ЭлементКоллекции.Цена);
		//		
	КонецЦикла;
	
	РассчитатьСтоимостьОС();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	ТолькоПросмотр = Форма.ТолькоПросмотр = ИСТИНА;
	
	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.РеквизитыЛицевогоСчета.Доступность				= ДоступностьРеквизитов;
	Элементы.Подразделение.Доступность						= ДоступностьРеквизитов;
	Элементы.ОсновныеСредстваПодборОС.Доступность			= ДоступностьРеквизитов И НЕ ТолькоПросмотр;
	Элементы.ВыбратьКомиссию.Доступность					= ДоступностьРеквизитов И НЕ ТолькоПросмотр;
	Элементы.ВыбратьПредседателяКомиссии.Доступность		= ДоступностьРеквизитов И НЕ ТолькоПросмотр;
	Элементы.СоставКомиссииПодобратьСотрудников.Доступность	= ДоступностьРеквизитов И НЕ ТолькоПросмотр;
	
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовВидПередачи(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	ЭтоПередача = Объект.ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Передача");
	Если ЭтоПередача Тогда
		Элементы.Контрагент.АвтоОтметкаНезаполненного	= Ложь;
		Элементы.Контрагент.ОтметкаНезаполненного		= Ложь;
	Иначе
		Элементы.Контрагент.АвтоОтметкаНезаполненного	= Истина;
		Элементы.Контрагент.ОтметкаНезаполненного		= Не ЗначениеЗаполнено(Объект.Контрагент);
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовВидПередачи()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьДоговора()

&НаКлиенте
Процедура ОбнулитьСуммы()

	Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
	
		ТекСтр.Цена = 0;
		ТекСтр.Сумма = 0;
	
	КонецЦикла; 

КонецПроцедуры // ОбнулитьСуммы()

&НаКлиенте
Процедура РассчитатьСуммы(ТекущиеДанные, СообщатьОбОшибках = Ложь)
	Если ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(СформироватьСтруктуруПроверяемыхРеквизитов(УчитываетсяПодразделение(Объект.ВидПередачи)),Объект,СообщатьОбОшибках) Тогда
		Возврат;
	КонецЕсли;
	РассчитатьСтоимостьОС(ТекущиеДанные.ПолучитьИдентификатор());
КонецПроцедуры // РассчитатьСуммы()
 
&НаСервере
Процедура РассчитатьСтоимостьОС(Знач ТекущиеДанные = Неопределено)
	
	ПараметрыЗапроса = Новый Структура("Организация, ИФО, КПС, КФО, Подразделение");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	Если Объект.ВидПередачи = Перечисления.ВидыОперацийИК.Передача Тогда
		ПараметрыЗапроса.Вставить("Период", УправлениеОсновнымиСредствамиКлиентСервер.ПериодПолученияОстатковДляДокумента(Объект, Объект.ДатаСписанияСБухУчета));
	Иначе
		ПараметрыЗапроса.Вставить("Период", УправлениеОсновнымиСредствамиКлиентСервер.ПериодПолученияОстатковДляДокумента(Объект));
	КонецЕсли;
	ТаблицаОстатков = УправлениеОсновнымиСредствами.ОстаткиИмуществаКазны(ПараметрыЗапроса, Объект.ОсновныеСредства.Выгрузить(,"НомерСтроки, ОсновноеСредство, ИнвентарныйНомер"));
	
	Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
	
		СтрокаОстатков = ТаблицаОстатков.Найти(ТекСтр.НомерСтроки, "НомерСтроки");
		ТекСтр.Цена = СтрокаОстатков.СтоимостьЕдиницы;
		Если ЗначениеЗаполнено(ТекСтр.ИнвентарныйНомер) Тогда
			ТекСтр.Количество = 1;
		ИначеЕсли Не ЗНачениеЗаполнено(ТекСтр.Количество) Тогда
			ТекСтр.Количество = СтрокаОстатков.КоличествоВсего;
		КонецЕсли;
		Если ТекСтр.Количество = СтрокаОстатков.КоличествоВсего Тогда
			ТекСтр.Сумма			= СтрокаОстатков.СуммаВсего;
			ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияВсего;
		Иначе
			ТекСтр.Сумма			= СтрокаОстатков.СтоимостьЕдиницы	* ТекСтр.Количество;
			ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияЕдиницы	* ТекСтр.Количество;
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры // РассчитатьСтоимостьОС()

&НаСервереБезКонтекста
Функция ПолучитьИнвентарныйНомер(ОсновноеСредство, Период, ГрупповойУчет)
    ГрупповойУчет =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "ГрупповойУчет");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	МестонахождениеОССрезПоследних.ИнвНомер
	               |ИЗ
	               |	РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |			&Период,
	               |			ОсновноеСредство = &ОсновноеСредство
	               |				И Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)) КАК МестонахождениеОССрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |		ПО МестонахождениеОССрезПоследних.ИнвНомер = ИнвентарныеНомераОС.Ссылка
	               |			И МестонахождениеОССрезПоследних.ОсновноеСредство = ИнвентарныеНомераОС.ОС
	               |			И МестонахождениеОССрезПоследних.Организация = ИнвентарныеНомераОС.Владелец
	               |ГДЕ
	               |	НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	Запрос.УстановитьПараметр("ОсновноеСредство", 	ОсновноеСредство);
	Запрос.УстановитьПараметр("Период",				Период);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Иначе
		Выборка = Результат.Выбрать();
		Если выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Возврат Выборка.ИнвНомер;
		Иначе
			Возврат Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;		

КонецФункции // ПолучитьИнвентарныйНомер()

