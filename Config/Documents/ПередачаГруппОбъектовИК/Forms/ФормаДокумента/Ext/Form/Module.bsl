&НаСервере
Процедура УстановитьГрупповойУчет()

	СведенияОбОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"), "ГрупповойУчет");
	
	Для каждого ТекСтрОС Из Объект.ОсновныеСредства Цикл
		ТекОС = СведенияОбОС[ТекСтрОС.ОсновноеСредство];
		Если ТекОС <> Неопределено Тогда
			ТекСтрОС.ГрупповойУчет 	= ТекОС.ГрупповойУчет;
		КонецЕсли;
	КонецЦикла; 

