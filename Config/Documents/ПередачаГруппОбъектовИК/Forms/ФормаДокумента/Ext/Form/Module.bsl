&НаСервереБезКонтекста
Функция ДоступныйКФО(Организация, ИФО, Знач Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
	#Если Сервер Тогда		
	Дата = ТекущаяДатаСеанса();
	#Иначе
	Дата = ТекущаяДата();
	#КонецЕсли
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;
	
	КФОПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(
		Организация, ИФО, БухгалтерскийУчет.ДатаУстановкиУчетнойПолитики(Организация, Дата));
	
	Если КФОПоУчетнойПолитике.Найти(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"))<>Неопределено Тогда
		Возврат ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;

КонецФункции // ДоступныйКФО()

&НаКлиентеНаСервереБезКонтекста
Функция УчитываетсяПодразделение(ВидПередачи)

	ИспользоватьПодразделение = Ложь;
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям") Тогда
		Если ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Передача") Тогда
			ИспользоватьПодразделение = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям;
		ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаАренда") Тогда
			ИспользоватьПодразделение = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("25").УчетПоПодразделениям;
		ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование") Тогда
			ИспользоватьПодразделение = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("26").УчетПоПодразделениям;
		КонецЕсли;
	КонецЕсли;
	Возврат ИспользоватьПодразделение;

КонецФункции // УчитываетсяПодразделение()
	
