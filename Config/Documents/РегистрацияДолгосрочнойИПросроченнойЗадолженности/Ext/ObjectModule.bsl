#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПроверитьВозможностьЗаписиДокумента(Отказ, РежимЗаписи, РежимПроведения);
	
	Если ЭтотОбъект.РежимЗаполнения = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("Договор");
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект.ДебиторскаяЗадолженность Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект.КредиторскаяЗадолженность Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ЗаполнитьСписокСчетовПоУмолчанию(ЭтотОбъект);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ЭтотОбъект, НастройкиМеханизма, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризацияРасчетовСКонтрагентами") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		
		Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ЗаполнитьНаОснованииИнвентаризацииРасчетовСКонтрагентами(
			ЭтотОбъект, ДокументОснование);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризацияРасчетовПоПоступлениям") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		
		Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ЗаполнитьНаОснованииИнвентаризацииРасчетовПоПоступлениям(
			ЭтотОбъект, ДокументОснование);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		
		Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовПоПоступлениям(
			ЭтотОбъект, ДокументОснование);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		
		Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовСКонтрагентами(
			ЭтотОбъект, ДокументОснование);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("ДебиторскаяЗадолженность.Договор");
	НепроверяемыеРеквизиты.Добавить("КредиторскаяЗадолженность.Договор");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВозможностьЗаписиДокумента(Отказ, РежимЗаписи, РежимПроведения)

	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;		
	КонецЕсли;
	
	Если Год(ДатаИнвентаризации) >=2026
		И НачалоДня(ДатаИнвентаризации) = НачалоГода(ДатаИнвентаризации)
		И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ДанныеДокумента = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.ПолучитьДанныеДействующегоДокумента(Организация,ДатаИнвентаризации);
		
		Если ЗначениеЗаполнено(ДанныеДокумента.ДействующийДокумент) Тогда
				
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор
				|ИЗ
				|	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
				|ГДЕ
				|	ДолгосрочнаяПросроченнаяЗадолженность.Период = &Период
				|	И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация
				|	И ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &ДатаИнвентаризации
				|	И ДолгосрочнаяПросроченнаяЗадолженность.Регистратор <> &Регистратор";
			
			Запрос.УстановитьПараметр("ДатаИнвентаризации", ДатаИнвентаризации);
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("Период", Дата);
			Запрос.УстановитьПараметр("Регистратор", Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
			
				ТекстОшибки = НСтр("ru='Внимание! По организации " + Организация + " на дату " + Дата + " существует действующий документ регистрации долгосрочной и просроченной задоленности на "+Формат(ДатаИнвентаризации,"ДФ=dd.MM.yyyy")+". 
					|Проведение невозможно.'");	
				
			    ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,,Отказ);
				
			Иначе
			
			
				Если ДанныеДокумента.ДействующийДокумент <> Ссылка
					И ДанныеДокумента.Период > Дата Тогда
			
					ТекстОшибки = НСтр("ru='Внимание! По организации " + Организация + " существует действующий документ регистрации долгосрочной и просроченной задоленности на "+Формат(ДатаИнвентаризации,"ДФ=dd.MM.yyyy")+" с более поздней датой. 
						|Данные документа не будут учтены в отчетности.'");
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,,);

				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
