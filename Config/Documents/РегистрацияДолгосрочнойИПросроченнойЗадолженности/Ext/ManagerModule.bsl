#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	
КонецПроцедуры

Функция ПолучитьСписокСчетовПоУмолчанию(ДатаИнвентаризации) Экспорт
	
	БезУчетаИерархии = Истина;
	
	Возврат БухгалтерскийУчет.СписокСчетов("
		|205.00,
		|206.00,
		|207.00,
		|208.00,
		|209.00,
		|210.05,
		|04,
		|301.00,
		|302.00,
		|303.00,
		|304.01,
		|304.02,
		|304.03,
		|304.04,
		|20",
		ДатаИнвентаризации,
		БезУчетаИерархии);
	
КонецФункции

Процедура ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ШапкаДокумента = ПараметрыПроцедуры.ШапкаДокумента;
	
	ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет = // Режим "С учетом исправления ошибок прошлых лет".
		(НачалоГода(ШапкаДокумента.ДатаИнвентаризации) = НачалоДня(ШапкаДокумента.ДатаИнвентаризации)) // Только при заполнении на начало года.
		И ШапкаДокумента.СУчетомИсправленияОшибокПрошлыхЛет;
	
	Если ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет Тогда
		// В режиме "С учетом исправления ошибок прошлых лет" остатки по счетам расчетов определяем на начало дня (начало года).
		НаДату = НачалоДня(ШапкаДокумента.ДатаИнвентаризации);
	Иначе // В противном случае остатки по объектам учета определяются на конец дня, указанного в поле "Сведения от".
		НаДату = КонецДня(ШапкаДокумента.ДатаИнвентаризации);
	КонецЕсли;
	
	СчетаДЗ = БухгалтерскийУчет.СписокСчетов("04");
	СчетаКЗ = БухгалтерскийУчет.СписокСчетов("20");
	
	СписокКонтрагентов = ПараметрыПроцедуры.СписокКонтрагентов.ВыгрузитьКолонку("Контрагент");
	ИспользоватьОтборПоКонтрагенту = (СписокКонтрагентов.Количество() > 0);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьОтборПоИФО = ИспользоватьУчетПоИФО И НЕ ШапкаДокумента["БезУчетаИФО"];
	ИспользоватьОтборПоКФО = ЗначениеЗаполнено(ШапкаДокумента["КФО"]);
	ИспользоватьОтборПоПодразделению = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И (ЗначениеЗаполнено(ШапкаДокумента["Подразделение"]));
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДатаЗапроса",						Новый Граница(НаДату, ВидГраницы.Включая));
	ЗапросЗаполнение.УстановитьПараметр("Организация",						ШапкаДокумента["Организация"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",								ШапкаДокумента["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",								ШапкаДокумента["ИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоИФО",			ИспользоватьОтборПоИФО);
	ЗапросЗаполнение.УстановитьПараметр("СписокСчетов",						ПолучитьСписокНепустыхСчетов(ПараметрыПроцедуры.СписокСчетов));
	ЗапросЗаполнение.УстановитьПараметр("СписокКонтрагентов",				СписокКонтрагентов);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ИспользоватьОтборПоКонтрагенту);
	ЗапросЗаполнение.УстановитьПараметр("СчетаДЗ",							СчетаДЗ);
	ЗапросЗаполнение.УстановитьПараметр("СчетаКЗ",							СчетаКЗ);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	ЗапросЗаполнение.УстановитьПараметр("Подразделение",					ШапкаДокумента["Подразделение"]);
	ЗапросЗаполнение.УстановитьПараметр("КЭК000",							БухгалтерскийУчетПовтИсп.КЭК0());
	
	ЗапросЗаполнение.УстановитьПараметр("МассивСчетовОшибок", БухгалтерскийУчет.СписокСчетов(
		"304.84, 304.94, 304.66, 304.76, 304.86, 304.96, 
		|401.16, 401.17, 401.18, 401.19, 
		|401.26, 401.27, 401.28, 401.29"));
	ЗапросЗаполнение.УстановитьПараметр("НачалоПериода", НачалоГода(НаДату));
	ЗапросЗаполнение.УстановитьПараметр("КонецПериода", КонецДня(ШапкаДокумента.КонецПериодаИсправленияОшибокПрошлыхЛет));
	
	ЗапросЗаполнение.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ОтборКонтрагентов
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка В ИЕРАРХИИ(&СписокКонтрагентов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Забалансовый
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КЭК
	|		ИНАЧЕ &КЭК000
	|	КОНЕЦ КАК КЭК,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.Счет.Наименование
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаОстаток
	|ПОМЕСТИТЬ ОстаткиФактические
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаЗапроса,
	|			Счет В ИЕРАРХИИ (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И &ОтборПоИФО
	|				И &ОтборПоКФО
	|				И &ОтборПоКонтрагенту) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	&ОтборПоПодразделениюОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Забалансовый
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КЭК
	|		ИНАЧЕ &КЭК000
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Контрагенты)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Договоры)
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.Счет.Наименование
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Договоры)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ";
	
	Если ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет Тогда
		ЗапросЗаполнение.Текст = ЗапросЗаполнение.Текст + "
		|
		| ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		ЗапросЗаполнение.Текст = ЗапросЗаполнение.Текст +
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО,
		|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Счет.Забалансовый
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.КЭК
		|		ИНАЧЕ &КЭК000
		|	КОНЕЦ КАК КЭК,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто1) = ТИП(Справочник.Контрагенты)
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто2) = ТИП(Справочник.Контрагенты)
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто2
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто3) = ТИП(Справочник.Контрагенты)
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто3
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто1) = ТИП(Справочник.Договоры)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто2) = ТИП(Справочник.Договоры)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Субконто3) = ТИП(Справочник.Договоры)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|		ИНАЧЕ ЖурналПроводокЕПСБУОбороты.Счет.Наименование
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто2 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто2
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто3
