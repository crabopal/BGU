			Объект.ДатаИнвентаризации = Шапка.ДатаИнвентаризации;
		КонецЕсли;
		
	КонецЕсли;
	
	// Дебиторская задолженность.
	ДебиторскаяЗадолженность = Результат[НомераТаблиц.ДебиторскаяЗадолженность].Выбрать();
	Пока ДебиторскаяЗадолженность.Следующий() Цикл
		
		НоваяСтрока = Объект.ДебиторскаяЗадолженность.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДебиторскаяЗадолженность);
		
	КонецЦикла;
	
	// Кредиторская задолженность.
	КредиторскаяЗадолженность = Результат[НомераТаблиц.КредиторскаяЗадолженность].Выбрать();
