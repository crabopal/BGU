Процедура ЗаполнитьСписокСчетовПоУмолчанию(ДокументОбъект) Экспорт
	
	МассивСчетов = ПолучитьСписокСчетовПоУмолчанию(ДокументОбъект.Дата);
	
	ДокументОбъект["СписокСчетов"].Очистить();
	
	Для Каждого Счет Из МассивСчетов Цикл
		НоваяСтрока = ДокументОбъект["СписокСчетов"].Добавить();
		НоваяСтрока["Счет"] = Счет;
	КонецЦикла;
	
КонецПроцедуры

// Флажок <без ограничения>
Функция ФлажокБезОграничения_ПолучитьНастройкиМеханизма() Экспорт
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяРеквизитаСсылка",	"ИФО");
	НастройкиМеханизма.Вставить("ИмяРеквизитаФлажок",	"БезУчетаИФО");
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ЕстьОшибки_ПроверитьПередЗаполнениемПоДаннымУчета(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект["Организация"]) Тогда
		ЕстьОшибки = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Поле ""Организация"" не заполнено'"),
			ДокументОбъект["Ссылка"],
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект["ДатаИнвентаризации"]) Тогда
		ЕстьОшибки = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Не указана дата документа для заполнения остатков'"),
			ДокументОбъект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Если НЕ СчетаУчетаУказаны(ДокументОбъект) Тогда
		ЕстьОшибки = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Не указаны счета учета расчетов'"),
			ДокументОбъект["Ссылка"],
			"Объект.СписокСчетов");
	КонецЕсли;
	
	ИндексСтроки = ПолучитьИндексСтрокиСПустымСчетом(ДокументОбъект);
	Если ИндексСтроки >= 0 Тогда
		ЕстьОшибки = Истина;
		ШаблонСообщения = НСтр("ru='Поле ""Счет"" не заполнено (таблица ""Счета учета расчетов"", строка %1)'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, (ИндексСтроки + 1));
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокументОбъект["Ссылка"],
			"Объект.СписокСчетов[" + ИндексСтрокиТекст + "].Счет");
	КонецЕсли;
	
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ДокументОбъект["СписокСчетов"], "Счет");
	ШаблонСтроки = НСтр("ru='Дубли строк по полю ""Счет"" (таблица ""Счета учета расчетов"", строки [НомераСтрок])'");
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",					"СписокСчетов");
		ПараметрыВывода.Вставить("ШаблонСтроки",				ШаблонСтроки);
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"Счет");
		ПараметрыВывода.Вставить("ОбъектСсылка",				ДокументОбъект["Ссылка"]);
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ДокументОбъект["СписокКонтрагентов"], "Контрагент");
	ШаблонСтроки = НСтр("ru='Дубли строк по полю ""Контрагент"" (таблица ""Контрагенты"", строки [НомераСтрок])'");
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",					"СписокКонтрагентов");
		ПараметрыВывода.Вставить("ШаблонСтроки",				ШаблонСтроки);
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"Контрагент");
		ПараметрыВывода.Вставить("ОбъектСсылка",				ДокументОбъект["Ссылка"]);
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

Функция СчетаУчетаУказаны(ДокументОбъект)
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["СписокСчетов"] Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы["Счет"]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСписокНепустыхСчетов(СписокСчетов)
	
	ПустойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	СписокСчетов = СписокСчетов.ВыгрузитьКолонку("Счет");
	
	Индекс = СписокСчетов.Найти(ПустойСчет);
	Пока НЕ Индекс = Неопределено Цикл
		СписокСчетов.Удалить(Индекс);
		Индекс = СписокСчетов.Найти(ПустойСчет);
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

Функция ПолучитьИндексСтрокиСПустымСчетом(ДокументОбъект)
	
	Для ИндексСтроки = 0 По ДокументОбъект["СписокСчетов"].Количество() - 1 Цикл
		СтрокаТаблицы = ДокументОбъект["СписокСчетов"][ИндексСтроки];
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["Счет"]) Тогда
			Возврат ИндексСтроки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

Функция СчетаРасчетовССубконтоДоговоры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&СчетаРасчетов)
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Договоры)";
	Запрос.УстановитьПараметр("СчетаРасчетов",
		БухгалтерскийУчет.СписокСчетов("205.00,206.00,207.00,209.00,301.00,302.00,304.01"));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

