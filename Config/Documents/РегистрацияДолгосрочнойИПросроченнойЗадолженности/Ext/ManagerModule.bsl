		|	И ДебиторскаяЗадолженность.Просроченная > 0";
		
		НомераТаблиц.Вставить("ИсполнениеДоговоровСПокупателями", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	КредиторскаяЗадолженность.Ссылка КАК Регистратор,
