	// Реквизиты шапки.
	Шапка = Результат[НомераТаблиц.Шапка].Выбрать();
	Если Шапка.Следующий() Тогда
		
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Шапка.Организация;
		
		Если Шапка.ДатаИнвентаризации >= ИнвентаризацияКлиентСервер.ПолучитьДатуНачалаОпределенияОстатковНаКонецПредыдущегоДня52н() Тогда
