Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,ДатаИнвентаризации,РежимЗаполнения,Дата");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ДатаИнвентаризации"	, НачалоДня(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Период"				, ЗначенияРеквизитов.Дата);//отражаем датой документа, чтобы потом найти последний
	Запрос.УстановитьПараметр("ДатаНачалоГода"		, НачалоГода(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Дебиторская"			, Перечисления.ВидыЗадолженности.Дебиторская);
	Запрос.УстановитьПараметр("Кредиторская"		, Перечисления.ВидыЗадолженности.Кредиторская);
	Запрос.УстановитьПараметр("ДетализацияПоДоговорам", ЗначенияРеквизитов.РежимЗаполнения = 1);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	НомераТаблиц = Новый Структура;   
	НомераТаблиц.Вставить("ДанныеЗадолженности", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДолгосрочнаяПросроченнаяЗадолженность", НомераТаблиц.Количество());
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Служебная таблица данных задолженности
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Период КАК Период,
	|	&ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	&Организация КАК Организация,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Счет КАК СчетРасчетов,
	|	&Дебиторская КАК ВидЗадолженности,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ИФО КАК ИФО,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.КФО КАК КФО,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.КПС КАК КПС,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.КЭК КАК КЭК,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА &ДетализацияПоДоговорам
	|			ТОГДА РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Долгосрочная КАК Долгосрочная,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Просроченная КАК Просроченная,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ДатаИсполнения КАК ДатаИсполнения,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ПричинаОбразованияКод КАК ПричинаОбразованияКод,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ПричинаОбразованияПояснение КАК ПричинаОбразованияПояснение,
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.ПричинаОбразованияДополнительно КАК ПричинаОбразованияДополнительно
	|ПОМЕСТИТЬ ДанныеЗадолженности
	|ИЗ
	|	Документ.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ДебиторскаяЗадолженность КАК РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность
	|ГДЕ
	|	РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Ссылка = &Ссылка
	|	И (&ДатаИнвентаризации = &ДатаНачалоГода
	|			ИЛИ (РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Долгосрочная <> 0
	|				ИЛИ РегистрацияДолгосрочнойИПросроченнойДебиторскаяЗадолженность.Просроченная <> 0))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&ДатаИнвентаризации,
	|	&Организация,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Счет,
	|	&Кредиторская,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ИФО,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.КФО,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.КПС,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.КЭК,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Контрагент,
	|	ВЫБОР
	|		КОГДА &ДетализацияПоДоговорам
	|			ТОГДА РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Долгосрочная,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Просроченная,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ДатаВозникновения,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ДатаИсполнения,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ПричинаОбразованияКод,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ПричинаОбразованияПояснение,
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.ПричинаОбразованияДополнительно
	|ИЗ
	|	Документ.РегистрацияДолгосрочнойИПросроченнойЗадолженности.КредиторскаяЗадолженность КАК РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность
	|ГДЕ
	|	РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Ссылка = &Ссылка
	|	И (&ДатаИнвентаризации = &ДатаНачалоГода
	|			ИЛИ (РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Долгосрочная <> 0
	|				ИЛИ РегистрацияДолгосрочнойИПросроченнойКредиторскаяЗадолженность.Просроченная <> 0))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Движения по регистру сведений ДолгосрочнаяПросроченнаяЗадолженность
	|//
	|ВЫБРАТЬ
	|	ДанныеЗадолженности.Период КАК Период,
	|	ДанныеЗадолженности.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	ДанныеЗадолженности.Организация КАК Организация,
	|	ДанныеЗадолженности.СчетРасчетов КАК СчетРасчетов,
	|	ДанныеЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
	|	ДанныеЗадолженности.ИФО КАК ИФО,
	|	ДанныеЗадолженности.КФО КАК КФО,
	|	ДанныеЗадолженности.КПС КАК КПС,
	|	ДанныеЗадолженности.КЭК КАК КЭК,
	|	ДанныеЗадолженности.Контрагент КАК Контрагент,
	|	ДанныеЗадолженности.Договор КАК Договор,
	|	ДанныеЗадолженности.Долгосрочная КАК Долгосрочная,
	|	ДанныеЗадолженности.Просроченная КАК Просроченная,
	|	ДанныеЗадолженности.ДатаВозникновения КАК ДатаВозникновения,
	|	ДанныеЗадолженности.ДатаИсполнения КАК ДатаИсполнения,
	|	ДанныеЗадолженности.ПричинаОбразованияКод КАК ПричинаОбразованияКод,
	|	ДанныеЗадолженности.ПричинаОбразованияПояснение КАК ПричинаОбразованияПояснение,
	|	ДанныеЗадолженности.ПричинаОбразованияДополнительно КАК ПричинаОбразованияДополнительно
	|ИЗ
	|	ДанныеЗадолженности КАК ДанныеЗадолженности";
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров И (ЗначенияРеквизитов.РежимЗаполнения <> 0) Тогда
		
		Запрос.УстановитьПараметр("Счета2050020900", БухгалтерскийУчет.СписокСчетов("205.00,209.00"));
		Запрос.УстановитьПараметр("Счета2060030200", БухгалтерскийУчет.СписокСчетов("206.00,302.00"));
		Запрос.УстановитьПараметр("Счета2070030100", БухгалтерскийУчет.СписокСчетов("207.00,301.00"));
		
		НомераТаблиц.Вставить("ОплатаОтПокупателейДебиторов", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	ДебиторскаяЗадолженность.Ссылка КАК Регистратор,
		|	ДебиторскаяЗадолженность.ДатаИсполнения КАК Период,
		|	ДебиторскаяЗадолженность.Ссылка.Организация КАК Организация,
		|	ДебиторскаяЗадолженность.ИФО КАК ИФО,
		|	ДебиторскаяЗадолженность.Контрагент КАК Контрагент,
		|	ДебиторскаяЗадолженность.Договор КАК Договор,
		|	ДебиторскаяЗадолженность.ДатаИсполнения КАК ОплатитьДо,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг) КАК ВидРасчетов,
		|	ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка) КАК ДопКлассификация,
		|	ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка) КАК КодМероприятия,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка) КАК КодЦели,
		|	ДебиторскаяЗадолженность.Счет КАК СчетРасчетов,
		|	ДебиторскаяЗадолженность.КФО КАК КФО,
		|	ДебиторскаяЗадолженность.КПС КАК КПС,
		|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
		|	&ВалютаРеглУчета КАК Валюта,
		|	ДебиторскаяЗадолженность.Просроченная КАК Сумма
		|ИЗ
		|	Документ.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность
		|ГДЕ
		|	ДебиторскаяЗадолженность.Ссылка = &Ссылка
		|	И (ДебиторскаяЗадолженность.Счет В (&Счета2050020900)
		|			ИЛИ ДебиторскаяЗадолженность.Счет В (&Счета2070030100))
		|	И ДебиторскаяЗадолженность.Договор.ВестиГрафикПлатежей
		|	И ДебиторскаяЗадолженность.Просроченная > 0";
		
		НомераТаблиц.Вставить("ОплатаПоставщикамКредиторам", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	КредиторскаяЗадолженность.Ссылка КАК Регистратор,
		|	КредиторскаяЗадолженность.ДатаИсполнения КАК Период,
		|	КредиторскаяЗадолженность.Ссылка.Организация КАК Организация,
		|	КредиторскаяЗадолженность.ИФО КАК ИФО,
		|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
