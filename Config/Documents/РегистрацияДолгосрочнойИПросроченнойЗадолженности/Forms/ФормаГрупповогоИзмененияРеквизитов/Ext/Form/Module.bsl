#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НачальныеЗначения = Параметры.НачальныеЗначения;
	ЗаполнитьСтрокиТаблицы(НачальныеЗначения);
	
	ЗначениеСвойства = Неопределено;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если НачальныеЗначения.Свойство(СтрокаТаблицы.ИмяРеквизита, ЗначениеСвойства) Тогда
			СтрокаТаблицы.ЗначениеРеквизита = ЗначениеСвойства;
		КонецЕсли;
	
	КонецЦикла;
	
	ДоступныеПричиныОбразования = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Параметры.ВидЗадолженности);
	ПричиныОбразования.ЗагрузитьЗначения(ДоступныеПричиныОбразования);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаРеквизитов

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ТекущиеДанные.ИзменятьРеквизит = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "ПричинаОбразованияКод" Тогда
		СтандартнаяОбработка = Ложь;
		Оповещение = Новый ОписаниеОповещения("ЗначениеРеквизитаПослеВыбора", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, ПричиныОбразования, Элемент, );
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ИзменятьРеквизит = Истина;
		
		Если Результат <> Неопределено Тогда
			Если ТекущиеДанные.ИмяРеквизита = "ПричинаОбразованияКод" Тогда
				ПолныйТекстПричины = СокрЛП(Результат.Значение);
				
				ТекущиеДанные.ЗначениеРеквизита = Лев(ПолныйТекстПричины,2);
				
				// При выборе кода причины заполняем текст пояснения.
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ИмяРеквизита", "ПричинаОбразованияПояснение");
				СтрокиПояснение = ТаблицаРеквизитов.НайтиСтроки(ПараметрыОтбора);
				Для Каждого СтрокаТаблицы Из СтрокиПояснение Цикл
					СтрокаТаблицы.ЗначениеРеквизита = Сред(ПолныйТекстПричины, 6);
					СтрокаТаблицы.ИзменятьРеквизит = Истина;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВозвращаемоеЗначение = Новый Структура;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если СтрокаТаблицы.ИзменятьРеквизит Тогда
			ВозвращаемоеЗначение.Вставить(СтрокаТаблицы.ИмяРеквизита, СтрокаТаблицы.ЗначениеРеквизита);
		КонецЕсли;
	
	КонецЦикла;
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтрокиТаблицы(НачальныеЗначения)

	Если НачальныеЗначения.Свойство("ПричинаОбразованияКод") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ПричинаОбразованияКод";
		НоваяСтрока.ПредставлениеРеквизита = "Причина образования, код";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;

	Если НачальныеЗначения.Свойство("ПричинаОбразованияПояснение") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ПричинаОбразованияПояснение";
		НоваяСтрока.ПредставлениеРеквизита = "Причина образования, пояснение";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;

	Если НачальныеЗначения.Свойство("ПричинаОбразованияДополнительно") Тогда
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = "ПричинаОбразованияДополнительно";
		НоваяСтрока.ПредставлениеРеквизита = "Причина образования, дополнительно";
		НоваяСтрока.ТипРеквизита = Новый ОписаниеТипов("Строка");
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

