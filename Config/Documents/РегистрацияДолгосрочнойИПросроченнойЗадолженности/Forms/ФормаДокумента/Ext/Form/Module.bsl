&НаКлиенте
Процедура КредиторскаяЗадолженностьПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.КредиторскаяЗадолженность.ТекущиеДанные;
	
	ДоступностьРасшифровки = ТекущиеДанные <> Неопределено
		И СчетаРасчетовССубконтоДоговоры.НайтиПоЗначению(ТекущиеДанные.Счет) <> Неопределено;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КредиторыРасшифроватьПоДаннымУчета", "Доступность", ДоступностьРасшифровки);
	
КонецПроцедуры

&НаКлиенте
Процедура КредиторскаяЗадолженностьПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы["КредиторскаяЗадолженность"].ТекущиеДанные;
	
	// Для новой строки инициализируем поле Контрагент ссылочным типом:
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные["Контрагент"] = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	РедактируемаяСтрока = Новый Структура("Контрагент, Счет, Всего, КПС, КФО, ИФО");
	ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура КредиторскаяЗадолженностьПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы["КредиторскаяЗадолженность"].ТекущиеДанные;
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
		
	ИначеЕсли ОтменаРедактирования Тогда
		
		// Восстанавливаем значение всех полей строки,
		// которые были запомнены в момент начала ее редактирования:
		ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КредиторскаяЗадолженностьСчетПриИзменении(Элемент)
	
	ТекДанные = Элементы["КредиторскаяЗадолженность"].ТекущиеДанные;
	
	ИнициализироватьКонтрагентаПриВыбореСчетаСервер(ТекДанные["Контрагент"], ТекДанные["Счет"]);
	
КонецПроцедуры

&НаКлиенте
Процедура КредиторскаяЗадолженностьСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["КредиторскаяЗадолженность"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
															СтандартнаяОбработка,
															Новый Структура("Счет, КПС, КФО",
																			ТекущиеДанные.Счет,
																			ТекущиеДанные.КПС,
																			ТекущиеДанные.КФО),
															Объект.Организация,
															ТекущиеДанные.ИФО,
															, // ОграниченияСчета
															ТекущиеДанные.КФО,
															, // ОграниченияКПС
															Объект.Дата);
КонецПроцедуры

