// Содержит значения полей строки на момент начала редактирования.
// Используется для отмены редактирования.
&НаКлиенте
Перем РедактируемаяСтрока;

&НаКлиенте
Перем ТекстЗаголовкаСообщений;

// СтандартныеПодсистемы.РаботаСКонтрагентами
&НаКлиенте
Перем ПроверкаКонтрагентовПараметрыОбработчикаОжидания Экспорт;
&НаКлиенте
Перем ФормаДлительнойОперации Экспорт;
// Конец СтандартныеПодсистемы.РаботаСКонтрагентами

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ПодготовитьФормуНаСервере();
		УстановитьРуководителя(Объект.Организация, Объект.Дата, Объект.Руководитель);
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект,Объект);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтаФорма, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.Подвал);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереДокумент(ЭтотОбъект, Параметры);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом
	
	ВидимостьПлашекРедакцииДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекстЗаголовкаСообщений = НСтр("ru='Инвентаризация расчетов с контрагентами'");
	
	ОтображениеИнформацииДатаИнвентаризации();
	
	ОпределитьКоличествоКонтрагентов();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
    
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьКолонкуВидСчета();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	ВидимостьПлашекРедакцииДокумента();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура РежимЗаполненияПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьРуководителя(Объект.Организация, Объект.Дата, Объект.Руководитель);
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	//---
	// Флажок <без ограничения>
	//---
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_РеквизитСсылка_ПриИзменении(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура БезУчетаИФОПриИзменении(Элемент)
	
	//---
	// Флажок <без ограничения>
	//---
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_РеквизитФлажок_ПриИзменении(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении(Элемент)
	
	ОтображениеИнформацииДатаИнвентаризации();
	
	ДатаИнвентаризацииПриИзмененииНаСервере();
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаСервере
Процедура ДатаИнвентаризацииПриИзмененииНаСервере()
	
	ЭтоНачалоГода = (Объект.ДатаИнвентаризации = НачалоГода(Объект.ДатаИнвентаризации));
	Если ЭтоНачалоГода Тогда
		// Отборы недоступны при заполнении на начало года, список счетов - по умолчанию.
		Объект.ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
		Объект.БезУчетаИФО = Истина;
		Объект.КФО = Перечисления.КВД.ПустаяСсылка();
		Объект.Подразделение = Справочники.Подразделения.ПустаяСсылка();
		Объект.СписокСчетов.Очистить();
		Объект.СписокКонтрагентов.Очистить();
		ЗаполнитьСписокСчетовПоУмолчаниюСервер();
	Иначе
		Объект.СУчетомИсправленияОшибокПрошлыхЛет = Ложь; // Настройка доступна только при заполнении на начало года.
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	ВидимостьПлашекРедакцииДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура СУчетомИсправленияОшибокПрошлыхЛетПриИзменении(Элемент)
	
	Если Объект.СУчетомИсправленияОшибокПрошлыхЛет И Не ЗначениеЗаполнено(Объект.КонецПериодаИсправленияОшибокПрошлыхЛет) Тогда
		Объект.КонецПериодаИсправленияОшибокПрошлыхЛет = Объект.Дата;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеИнформацииДатаИнвентаризации()
	
	ВидимостьГруппыИнформацияДата = Ложь;
	ТекстПодсказки = "";
	
	Если ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
	
		Если НачалоДня(Объект.ДатаИнвентаризации) = НачалоГода(Объект.ДатаИнвентаризации) Тогда
			ВидимостьГруппыИнформацияДата = Истина;
			ТекстПодсказки =  НСтр("ru = 'Сведения по состоянию на 1 января составляются 
								|только при наличии изменений долгосрочной/просроченной задолженности в межотчетный период'");
			
		ИначеЕсли КонецДня(Объект.ДатаИнвентаризации) <> КонецМесяца(Объект.ДатаИнвентаризации) Тогда
			ВидимостьГруппыИнформацияДата = Истина;
			ТекстПодсказки =  НСтр("ru = 'Для отражения сведений о долгосрочной/просроченной задолженности в отчетности 
								|документ необходимо заполнить по состоянию на дату окончания отчетного периода'");
		КонецЕсли;
		
	КонецЕсли;	

	Элементы.ГруппаИнформацияДата.Видимость = ВидимостьГруппыИнформацияДата;
	Элементы.ИнформацияДата.РасширеннаяПодсказка.Заголовок = ТекстПодсказки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДебиторскаяЗадолженность

&НаКлиенте
Процедура ДебиторскаяЗадолженностьПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДебиторскаяЗадолженность.ТекущиеДанные;
	
	ДоступностьРасшифровки = ТекущиеДанные <> Неопределено
		И СчетаРасчетовССубконтоДоговоры.НайтиПоЗначению(ТекущиеДанные.Счет) <> Неопределено;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДебиторыРасшифроватьПоДаннымУчета", "Доступность", ДоступностьРасшифровки);
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы["ДебиторскаяЗадолженность"].ТекущиеДанные;
	
	// Для новой строки инициализируем поле Контрагент ссылочным типом:
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные["Контрагент"] = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	РедактируемаяСтрока = Новый Структура("Контрагент, Счет, Всего, КПС, КФО, ИФО");
	ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы["ДебиторскаяЗадолженность"].ТекущиеДанные;
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
		
	ИначеЕсли ОтменаРедактирования Тогда
		
		// Восстанавливаем значение всех полей строки,
		// которые были запомнены в момент начала ее редактирования:
		ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьСчетПриИзменении(Элемент)
	
	ТекДанные = Элементы["ДебиторскаяЗадолженность"].ТекущиеДанные;
	
	ИнициализироватьКонтрагентаПриВыбореСчетаСервер(ТекДанные["Контрагент"], ТекДанные["Счет"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ДебиторскаяЗадолженность"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
															СтандартнаяОбработка,
															Новый Структура("Счет, КПС, КФО",
																			ТекущиеДанные.Счет,
																			ТекущиеДанные.КПС,
																			ТекущиеДанные.КФО),
															Объект.Организация,
															ТекущиеДанные.ИФО,
															, // ОграниченияСчета
															ТекущиеДанные.КФО,
															, // ОграниченияКПС
															Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ДебиторскаяЗадолженность"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекущиеДанные.КПС,
															ТекущиеДанные.КФО);
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИнвентаризацияКлиент.ОткрытьФормуВыбораКЭККИЕ(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДебиторскаяЗадолженностьПричинаОбразованияКодОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ТекущиеДанные = Элементы.ДебиторскаяЗадолженность.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда 
			
			ТекКФО = ТекущиеДанные.КФО;
			КодПричины = Лев(ВыбранноеЗначение, 2);
			ТекстПричиныПоСписку = Сред(ВыбранноеЗначение, 6);
			
			ТекстПричины = БухгалтерскийУчетКлиент.СоответсвиеПричиныЗадолженностиПоКодуКФО(ТекстПричиныПоСписку, КодПричины, ТекКФО);
			
			ТекущиеДанные.ПричинаОбразованияКод = КодПричины;
			ТекущиеДанные.ПричинаОбразованияПояснение = ТекстПричины;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

