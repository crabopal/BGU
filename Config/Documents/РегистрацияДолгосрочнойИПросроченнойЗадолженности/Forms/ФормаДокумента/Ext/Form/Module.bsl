		ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокДЗ(Команда)
	
	ТекущиеДанные = Элементы.ДебиторскаяЗадолженность.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачальныеЗначения = Новый Структура("ПричинаОбразованияКод,ПричинаОбразованияПояснение,ПричинаОбразованияДополнительно");
	ЗаполнитьЗначенияСвойств(НачальныеЗначения, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	ПараметрыФормы.Вставить("ВидЗадолженности", ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокДебиторыЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.РегистрацияДолгосрочнойИПросроченнойЗадолженности.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,,,,,
		ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокДебиторыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.ДебиторскаяЗадолженность.ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Объект.ДебиторскаяЗадолженность.НайтиПоИдентификатору(ИдентификаторСтроки);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
		
		// Пояснение причины задолженности для одного кода может отличаться в зависимости от КФО. Перезаполним причину по КФО.
		ТекстПричины = БухгалтерскийУчетКлиент.СоответсвиеПричиныЗадолженностиПоКодуКФО(ТекущиеДанные.ПричинаОбразованияПояснение, ТекущиеДанные.ПричинаОбразованияКод, ТекущиеДанные.КФО);
		ТекущиеДанные.ПричинаОбразованияПояснение = ТекстПричины;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокКЗ(Команда)
	
	ТекущиеДанные = Элементы.КредиторскаяЗадолженность.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачальныеЗначения = Новый Структура("ПричинаОбразованияКод,ПричинаОбразованияПояснение,ПричинаОбразованияДополнительно");
	ЗаполнитьЗначенияСвойств(НачальныеЗначения, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	ПараметрыФормы.Вставить("ВидЗадолженности", ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокКредиторыЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.РегистрацияДолгосрочнойИПросроченнойЗадолженности.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,,,,,
		ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокКредиторыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.КредиторскаяЗадолженность.ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Объект.КредиторскаяЗадолженность.НайтиПоИдентификатору(ИдентификаторСтроки);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
		
		// Пояснение причины задолженности для одного кода может отличаться в зависимости от КФО. Перезаполним причину по КФО.
		ТекстПричины = БухгалтерскийУчетКлиент.СоответсвиеПричиныЗадолженностиПоКодуКФО(ТекущиеДанные.ПричинаОбразованияПояснение, ТекущиеДанные.ПричинаОбразованияКод, ТекущиеДанные.КФО);
		ТекущиеДанные.ПричинаОбразованияПояснение = ТекстПричины;
	КонецЦикла;
	
КонецПроцедуры

