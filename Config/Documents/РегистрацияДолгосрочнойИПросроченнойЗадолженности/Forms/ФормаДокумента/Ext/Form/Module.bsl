&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	СчетаРасчетовССубконтоДоговоры.ЗагрузитьЗначения(Документы.РегистрацияДолгосрочнойИПросроченнойЗадолженности.СчетаРасчетовССубконтоДоговоры());
	Счета04.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("04"));
	Счета20.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("20"));
	
	ЗаполнитьКолонкуВидСчета();
	
	ПричиныОбразованияДт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Дебиторская);
	Элементы.ДебиторскаяЗадолженностьПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияДт);
	
	ПричиныОбразованияКт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Кредиторская);
	Элементы.КредиторскаяЗадолженностьПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияКт);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	КолонкаДоговор = Новый Массив;
	КолонкаДоговор.Добавить("ДебиторскаяЗадолженностьДоговор");
	КолонкаДоговор.Добавить("КредиторскаяЗадолженностьДоговор");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкаДоговор, "Видимость", Объект.РежимЗаполнения <> 0);
	
	ЭтоНачалоГода = (Объект.ДатаИнвентаризации = НачалоГода(Объект.ДатаИнвентаризации));
	
	ЭлементыИсправлениеОшибокПрошлыхЛет = Новый Массив;
	ЭлементыИсправлениеОшибокПрошлыхЛет.Добавить("СУчетомИсправленияОшибокПрошлыхЛет");
	ЭлементыИсправлениеОшибокПрошлыхЛет.Добавить("КонецПериодаИсправленияОшибокПрошлыхЛет");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИсправлениеОшибокПрошлыхЛет, "Видимость", ЭтоНачалоГода);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КонецПериодаИсправленияОшибокПрошлыхЛет", "Доступность", Объект.СУчетомИсправленияОшибокПрошлыхЛет);
	
	ЭлементыНастройкиЗаполнения = Новый Массив;
	ЭлементыНастройкиЗаполнения.Добавить("ИФО");
	ЭлементыНастройкиЗаполнения.Добавить("БезУчетаИФО");
	ЭлементыНастройкиЗаполнения.Добавить("КФО");
	ЭлементыНастройкиЗаполнения.Добавить("Подразделение");
	ЭлементыНастройкиЗаполнения.Добавить("СписокСчетов");
	ЭлементыНастройкиЗаполнения.Добавить("СписокКонтрагентов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыНастройкиЗаполнения, "Доступность", Не ЭтоНачалоГода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	ЕстьДанныеДЗ = (Объект["ДебиторскаяЗадолженность"].Количество() > 0);
	ЕстьДанныеКЗ = (Объект["КредиторскаяЗадолженность"].Количество() > 0);
	Если ЕстьДанныеДЗ ИЛИ ЕстьДанныеКЗ Тогда
		
		ТекстВопроса = НСтр("ru='При изменении даты сведений рекомендуется перезаполнить документ.
			|
			|Перезаполнить документ?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПериода_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПриИзмененииПериода_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Очищаем таблицы:
		ЗаполнитьПоДаннымУчетаДЗКлиент();
		ЗаполнитьПоДаннымУчетаКЗКлиент();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьКоличествоКонтрагентов()
	
	КоличествоКонтрагентов			= Объект["СписокКонтрагентов"].Количество();
	
	НадписьКоличествоКонтрагентов	= Формат(КоличествоКонтрагентов, "ЧН='без ограничения'");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИнициализироватьКонтрагентаПриВыбореСчетаСервер(Контрагент, Счет)
	
	СейчасУказанКонтрагент	= (ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты"));
	ЕстьСубконтоКонтрагенты	= БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.Контрагенты)
		ИЛИ НЕ ЗначениеЗаполнено(Счет);
	
	Если ЕстьСубконтоКонтрагенты И НЕ СейчасУказанКонтрагент Тогда
		// Заменяем строку на пустую ссылку контрагента.
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		
	ИначеЕсли НЕ ЕстьСубконтоКонтрагенты Тогда
		// Заменяем ссылку контрагента на наименование выбранного счета.
		Контрагент = Счет.Наименование;
		
	КонецЕсли;
	
КонецПроцедуры

//--------------------------------------------------------------------------------
// Преобразование табличных частей при открытии/закрытии формы.

&НаСервере
Процедура ЗаполнитьКолонкуВидСчета(ИдТекущейСтроки = Неопределено)
	
	Если ИдТекущейСтроки = Неопределено Тогда
		СтрокиТЧ		= Объект["СписокСчетов"];
		МассивСчетов	= Объект["СписокСчетов"].Выгрузить(,"Счет").ВыгрузитьКолонку("Счет");
	Иначе
		СтрокаТЧ		= Объект["СписокСчетов"].НайтиПоИдентификатору(ИдТекущейСтроки);
		СтрокиТЧ		= Новый Массив();
		СтрокиТЧ.Добавить(СтрокаТЧ);
		МассивСчетов	= Новый Массив();
		МассивСчетов.Добавить(СтрокаТЧ["Счет"]);
	КонецЕсли;
	
	ВидыСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСчетов, "Вид");
	
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		Вид = ВидыСчетов.Получить(СтрокаТЧ["Счет"]);
		Если Вид = ВидСчета.Активный Тогда
			ВидСтрока = "А";
		ИначеЕсли Вид = ВидСчета.Пассивный Тогда
			ВидСтрока = "П";
		ИначеЕсли Вид = ВидСчета.АктивноПассивный Тогда
			ВидСтрока = "АП";
		Иначе
			ВидСтрока = "";
		КонецЕсли;
		
		СтрокаТЧ["ВидСчета"] = ВидСтрока;
	КонецЦикла;
	
КонецПроцедуры

