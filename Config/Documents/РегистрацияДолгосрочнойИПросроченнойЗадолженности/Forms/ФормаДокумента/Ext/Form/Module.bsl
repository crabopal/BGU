&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		УстановитьРуководителя(Объект.Организация, Объект.Дата, Объект.Руководитель);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Знач Организация, Знач Дата, Руководитель)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", Организация, Дата);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВидимостьПлашекРедакцииДокумента()
	
	ПояснениеУчитываетсяВОтчетности = "";
	
	Если ЗначениеЗаполнено(Объект.ДатаИнвентаризации)
		И Год(Объект.ДатаИнвентаризации) >= 2026
		И НачалоДня(Объект.ДатаИнвентаризации) = НачалоГода(Объект.ДатаИнвентаризации) Тогда
		
		ДанныеДействующегоДокумента = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.ПолучитьДанныеДействующегоДокумента(Объект.Организация,Объект.ДатаИнвентаризации);
		
		ДействующийДокумент = ДанныеДействующегоДокумента.ДействующийДокумент;
		
		ПояснениеУчитываетсяВОтчетности = "";
		
		Если ЗначениеЗаполнено(ДействующийДокумент) Тогда
			Если ДействующийДокумент = Объект.Ссылка Тогда
				ДанныеПредыдущегоДокумента = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.ПолучитьДанныеПредыдущегоДокумента(Объект.Организация,Объект.ДатаИнвентаризации,ДействующийДокумент);
				ПредыдущийДокумент = ДанныеПредыдущегоДокумента.ПредыдущийДокумент;
				
				ПояснениеУчитываетсяВОтчетности = "Данные документа будут учтены с отчетности на "+Формат(КонецДня(Объект.Дата)+1,"ДФ=dd.MM.yyyy")+"."; 
				
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаДействующийДокумент","Видимость",Истина);
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаПереходаКДействующемуДокументу","Видимость",Ложь);
			Иначе
				
				Если Объект.Проведен Тогда
					ДанныеСледующегоДокумента = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.ПолучитьДанныеСледующегоДокумента(Объект.Организация,Объект.ДатаИнвентаризации,Объект.Ссылка);
					
					Если ЗначениеЗаполнено(ДанныеСледующегоДокумента.Период)
						И День(ДанныеСледующегоДокумента.Период) <> День(Объект.Дата) Тогда 
						ПояснениеУчитываетсяВОтчетности = "Данные документа будут учтены с отчетности на "+Формат(КонецДня(Объект.Дата)+1,"ДФ=dd.MM.yyyy")+" по "+Формат(КонецДня(ДанныеСледующегоДокумента.Период+1),"ДФ=dd.MM.yyyy");
					Иначе
						ПояснениеУчитываетсяВОтчетности = "Данные документа в отчетности не учитываются";
					КонецЕсли;
				Иначе
					ПояснениеУчитываетсяВОтчетности = "Данные документа в отчетности не учитываются";	
				КонецЕсли;
				
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаДействующийДокумент","Видимость",Ложь);
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаПереходаКДействующемуДокументу","Видимость",Истина);
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ПояснениеУчитываетсяВОтчетности","Видимость",Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ПояснениеУчитываетсяВОтчетности","Заголовок",ПояснениеУчитываетсяВОтчетности);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаДействующийДокумент","Видимость",Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаПереходаКДействующемуДокументу","Видимость",Ложь);	
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ПояснениеУчитываетсяВОтчетности","Видимость",Ложь);		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаДействующийДокумент","Видимость",Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаПереходаКДействующемуДокументу","Видимость",Ложь);
	КонецЕсли;
КонецПроцедуры

