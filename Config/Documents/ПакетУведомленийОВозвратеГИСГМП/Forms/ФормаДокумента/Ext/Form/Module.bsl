Процедура ВозвратыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.Возвраты.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.ВозвратСсылка);
	КонецЕсли;
КонецПроцедуры

