#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Копирование документов ""Пакет уведомлений о возврате ГИС ГМП"" не предусмотрено.'"));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Интерактивное создание документов ""Пакет уведомлений о возврате ГИС ГМП"" не предусмотрено.
		|Для создания пакета уведомлений воспользуйтесь обработкой ""Обмен с ГИСГМП 2.0""'"));
	КонецЕсли;

	
	Для Каждого СтрТЧ Из Объект.Возвраты Цикл
		Если ЗначениеЗаполнено(СтрТЧ.РезультатИмпортаКод) Тогда
			Если СтрТЧ.РезультатИмпортаКод = "0" Тогда
				СтрТЧ.РезультатКартинкой = 3;
			ИначеЕсли СтрТЧ.РезультатИмпортаКод = "5" Тогда
				//данные уже были загружены ранее - если новое начисление/возврат повторно загружают
				СтрТЧ.РезультатКартинкой = 2;
			Иначе
				СтрТЧ.РезультатКартинкой = 6;
			КонецЕсли;
			СтрТЧ.ОписаниеРезультата = "Код = "+СтрТЧ.РезультатИмпортаКод+", "+ СтрТЧ.РезультатИмпортаОписание;
		КонецЕсли;
	КонецЦикла;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДвоичныеДанныеСертификата = ТекущийОбъект.ДанныеСертификата.Получить();
	Если ДвоичныеДанныеСертификата <> Неопределено Тогда 
		АдресСертификата = ПоместитьВоВременноеХранилище(ДвоичныеДанныеСертификата, УникальныйИдентификатор);
	КонецЕсли;
	ДанныеДокумента = ТекущийОбъект.ДанныеДокумента.Получить();
	ДанныеПодписи = ТекущийОбъект.ДанныеПодписи.Получить();
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

