#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ЗаполнитьДанныеТЧПоДокументам(МассивДокументов) Экспорт
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Док.Дата КАК ДатаУведомленияОВозврате,
		|	Док.Номер КАК НомерУведомленияОВозврате,
		|	Док.Ссылка КАК ВозвратСсылка,
		|	Док.ИсточникСредств.Код КАК ИсточникСредствКод,
		|	Док.УИВ КАК УИВ,
		|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
		|	Док.СуммаДокумента КАК СуммаДокумента,
		|	Док.ВозвращаемыйПлатеж КАК ПлатежСсылка,
		|	Док.ДокументОснованиеВид КАК ДокументОснованиеВид,
		|	Док.ДокументОснованиеДата КАК ДокументОснованиеДата,
		|	Док.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
		|	Док.Контрагент КАК Контрагент,
		|	Док.КонтрагентНаименование КАК КонтрагентНаименование,
		|	Док.КодБКПолучателя КАК КодБКПолучателя,
		|	Док.КодОКТМОПолучателя КАК КодОКТМОПолучателя,
		|	Док.КонтрагентБанковскийСчет КАК КонтрагентБанковскийСчет,
		|	Док.КонтрагентЛицевойСчет КАК КонтрагентЛицевойСчет,
		|	Док.КодОКАТО КАК КодОКАТО,
		|	Док.КодБКНазначениеПлатежа КАК КодБКНазначениеПлатежа,
		|	Док.ДатаЗаявки КАК ДатаЗаявки,
		|	ВЫБОР
		|		КОГДА Док.ЛицевойСчет.ИспользоватьДляСчетаУчетныйНомер
		|			ТОГДА Док.ЛицевойСчет.КодПоРПБС
		|		ИНАЧЕ Док.ЛицевойСчет.Владелец.КодПоРПБС
		|	КОНЕЦ КАК КодУБППлательщика,
		|	Док.НомерЗаявки КАК НомерЗаявки,
		|	Док.ЗаявкаНаВозврат КАК ЗаявкаСсылка,
		|	Док.ИдентификаторПлательщика КАК ИдентификаторПолучателя,
		|	Док.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
		|	Док.ВидУведомления КАК ВидУведомления,
		|	Док.ОснованиеИзменения КАК ОснованиеИзменения,
		|	Док.КонтрагентБИКБанка КАК КонтрагентБИКБанка,
		|	Док.КонтрагентКорСчетБанка КАК КонтрагентКорСчетБанка,
		|	Док.КонтрагентНаименованиеБанка КАК КонтрагентНаименованиеБанка,
		|	Док.Комментарий КАК КомментарийВозврата,
		|	Док.Организация.ИНН КАК ИННПлательщика,
		|	Док.Организация.КПП КАК КПППлательщика,
		|	Док.Организация.НаименованиеСокращенное КАК ПлательщикНаименование,
		|	Док.ДатаИзменения КАК ДатаИзменения
		|ИЗ
		|	Документ.УведомлениеОВозвратеГИСГМП КАК Док
		|ГДЕ
		|	Док.Ссылка В(&МассивДокументов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаУведомленияОВозврате,
		|	НомерУведомленияОВозврате";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЧДанных = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрДанных Из ТЧДанных Цикл
		
		СтрТЧ = Возвраты.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрТЧ,СтрДанных);
		СтрТЧ.ИД_Возврата = "N_"+Строка(СтрТЧ.ВозвратСсылка.УникальныйИдентификатор());
		СтрТЧ.УровеньБюджета = БиблиотекаФункцийОбмена.УровеньБюджета(СтрТЧ.ВозвратСсылка);
		СтрТЧ.ВидСредств = БиблиотекаФункцийОбмена.СтрокаВЧисло(СтрДанных.ИсточникСредствКод);
					
	КонецЦикла;
	
	ТЧДанных = Неопределено;
	
	СуммаВозвратов = Возвраты.Итог("СуммаДокумента");
	КоличествоВозвратов = Возвраты.Количество();
			
КонецПроцедуры
		
#КонецЕсли