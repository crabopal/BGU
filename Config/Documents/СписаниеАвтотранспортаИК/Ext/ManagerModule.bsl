КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Перем ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОС4а") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС4а","ОС-4а", ПодготовитьОС4б(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПодготовитьОС4б(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СписаниеИнвентарногоОбъектаОС_ОС4";

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписаниеАвтотранспортаИК.Ссылка КАК Ссылка,
	               |	СписаниеАвтотранспортаИК.Дата КАК пДата,
	               |	СписаниеАвтотранспортаИК.Номер КАК НомерАкта,
	               |	СписаниеАвтотранспортаИК.Организация КАК Организация,
	               |	СписаниеАвтотранспортаИК.Организация.НаименованиеПолное КАК ОргНазв,
	               |	СписаниеАвтотранспортаИК.Организация.КодОКПО КАК КодОКПО,
	               |	ПРЕДСТАВЛЕНИЕ(СписаниеАвтотранспортаИК.Подразделение) КАК Подразделение,
	               |	СписаниеАвтотранспортаИК.ОснованиеДляАкта КАК ОснованиеДляАкта,
	               |	СписаниеАвтотранспортаИК.НомерОснованияДляАкта КАК НомерОснованияДляАкта,
	               |	СписаниеАвтотранспортаИК.ДатаОснованияДляАкта КАК ДатаОснованияДляАкта,
	               |	СписаниеАвтотранспортаИК.ДатаСписанияСБухУчета КАК ДатаСписания,
	               |	ПРЕДСТАВЛЕНИЕ(СписаниеАвтотранспортаИК.КФО) КАК КФО,
	               |	ПРЕДСТАВЛЕНИЕ(СписаниеАвтотранспортаИК.КПС) КАК КПС,
	               |	СписаниеАвтотранспортаИК.ОсновноеСредство.КодОКОФ.Код КАК пКодПоОКОФ,
	               |	ВЫБОР
	               |		КОГДА СписаниеАвтотранспортаИК.ОсновноеСредство.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПустаяСсылка)
	               |			ТОГДА """"
	               |		ИНАЧЕ СписаниеАвтотранспортаИК.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1
	               |	КОНЕЦ КАК НомерАмортГруппы,
	               |	СписаниеАвтотранспортаИК.ИнвентарныйНомер КАК ИнвНомер,
	               |	СписаниеАвтотранспортаИК.ИнвентарныйНомер.НомерПаспорта КАК ТехПаспорт,
	               |	СписаниеАвтотранспортаИК.ОсновноеСредство.ИзготовительОС.НаименованиеПолное КАК Изготовитель,
	               |	СобытияОС_ВводВЭксплуатацию.ДатаСобытия КАК ДатаВводаВЭксплуатацию,
	               |	ГОД(СписаниеАвтотранспортаИК.ИнвентарныйНомер.ДатаВыпуска) КАК ГодВыпуска,
	               |	СписаниеАвтотранспортаИК.СуммаАмортизации + ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма, 0) КАК НачАмортизация,
	               |	СписаниеАвтотранспортаИК.Сумма - СписаниеАвтотранспортаИК.СуммаАмортизации - ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма, 0) КАК ОстСтоимость,
	               |	ПаспортаТранспортныхСредств.НомерШасси КАК Шасси,
	               |	ПаспортаТранспортныхСредств.ДвигательНомер КАК Двигатель,
	               |	ПаспортаТранспортныхСредств.Грузоподъемность КАК Грузоподъемность,
	               |	ПаспортаТранспортныхСредств.Масса КАК Масса,
	               |	ПаспортаТранспортныхСредств.ДатаСнятияСУчета КАК ДатаИзГИБДД,
	               |	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК МОЛ,
	               |	СписаниеАвтотранспортаИК.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	               |	СписаниеАвтотранспортаИК.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	               |	СписаниеАвтотранспортаИК.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	               |	СписаниеАвтотранспортаИК.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	               |	"""" КАК ТабНомМОЛ,
	               |	СписаниеАвтотранспортаИК.Приложение КАК ТекстПриложения,
	               |	СписаниеАвтотранспортаИК.ОсновноеСредство КАК ОсновноеСредство,
	               |	ВЫБОР
	               |		КОГДА СписаниеАвтотранспортаИК.ОсновноеСредство.НаименованиеПолное = """"
	               |			ТОГДА СписаниеАвтотранспортаИК.ОсновноеСредство.Наименование
	               |		ИНАЧЕ СписаниеАвтотранспортаИК.ОсновноеСредство.НаименованиеПолное
	               |	КОНЕЦ КАК НаимОС,
	               |	СписаниеАвтотранспортаИК.ИнвентарныйНомер.ЗаводскойНомер КАК пЗавНомер,
	               |	СписаниеАвтотранспортаИК.ПричинаСписания КАК ТекстПричинаСписания,
	               |	СобытияОС_ПринятиеКУчету.ДатаСобытия КАК ДатаПринятияКУчету,
	               |	СписаниеАвтотранспортаИК.Сумма КАК НачСтоимость
	               |ИЗ
	               |	Документ.СписаниеАвтотранспортаИК КАК СписаниеАвтотранспортаИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС_ВводВЭксплуатацию
	               |		ПО СписаниеАвтотранспортаИК.ОсновноеСредство = СобытияОС_ВводВЭксплуатацию.ОсновноеСредство
	               |			И (СобытияОС_ВводВЭксплуатацию.Событие = &ВводВЭксплуатацию)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(
	               |				,
	               |				(Организация, ОсновноеСредство, ИнвентарныйНомер) В
	               |					(ВЫБРАТЬ
	               |						Док.Организация,
	               |						Док.ОсновноеСредство,
	               |						Док.ИнвентарныйНомер
	               |					ИЗ
	               |						Документ.СписаниеАвтотранспортаИК КАК Док
	               |					ГДЕ
	               |						Док.Ссылка В (&МассивОбъектов))) КАК ПаспортаТранспортныхСредств
	               |		ПО СписаниеАвтотранспортаИК.ОсновноеСредство = ПаспортаТранспортныхСредств.ОсновноеСредство
	               |			И СписаниеАвтотранспортаИК.ИнвентарныйНомер = ПаспортаТранспортныхСредств.ИнвентарныйНомер
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |				,
	               |				,
	               |				Регистратор В (&МассивОбъектов)
	               |					И СчетКт В (&Счет104),
	               |				,
	               |				) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |		ПО СписаниеАвтотранспортаИК.Ссылка = ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС_ПринятиеКУчету
	               |		ПО СписаниеАвтотранспортаИК.ОсновноеСредство = СобытияОС_ПринятиеКУчету.ОсновноеСредство
	               |			И (СобытияОС_ПринятиеКУчету.Событие = &ПринятиеКУчету)
	               |ГДЕ
	               |	СписаниеАвтотранспортаИК.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	пДата,
	               |	НомерАкта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОсновноеСредство,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК Справочник.ОсновныеСредства).НаименованиеПолное + "" / "" + ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК Справочник.ИнвентарныеНомераОС).Код КАК НазвДетали,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Наименование КАК Драгметалл,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Код КАК КодДрагМеталла,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК НазвЕИ,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток, 0) КАК ВесДраг
	               |ИЗ
	               |	Документ.СписаниеАвтотранспортаИК КАК СписаниеАвтотранспортаИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	               |		ПО СписаниеАвтотранспортаИК.ОсновноеСредство = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
	               |			И СписаниеАвтотранспортаИК.ИнвентарныйНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
	               |ГДЕ
	               |	СписаниеАвтотранспортаИК.Ссылка В(&МассивОбъектов)
	               |ИТОГИ ПО
	               |	ОсновноеСредство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СписаниеАвтотранспортаИКСоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	               |	СписаниеАвтотранспортаИКСоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	               |	СписаниеАвтотранспортаИКСоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	               |	СписаниеАвтотранспортаИКСоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии,
	               |	СписаниеАвтотранспортаИКСоставКомиссии.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СписаниеАвтотранспорта.СоставКомиссии КАК СписаниеАвтотранспортаИКСоставКомиссии
	               |ГДЕ
	               |	СписаниеАвтотранспортаИКСоставКомиссии.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СписаниеАвтотранспортаИКСоставКомиссии.НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект КАК ОсновноеСредство,
	               |	ДополнительныеСведения.Свойство КАК ВидХарактеристики,
	               |	ДополнительныеСведения.Значение КАК НазваниеХарактеристики
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В
	               |			(ВЫБРАТЬ
	               |				СписаниеАвтотранспорта.ОсновноеСредство
	               |			ИЗ
	               |				Документ.СписаниеАвтотранспорта КАК СписаниеАвтотранспорта
	               |			ГДЕ
	               |				СписаниеАвтотранспорта.Ссылка В (&МассивОбъектов))
	               |ИТОГИ ПО
	               |	ОсновноеСредство";
				   
	Запрос.УстановитьПараметр("МассивОбъектов"		, МассивОбъектов);
	Запрос.УстановитьПараметр("ПринятиеКУчету"		, Перечисления.ВидыСобытийОС.ПринятиеКУчету);
	Запрос.УстановитьПараметр("ВводВЭксплуатацию"	, Перечисления.ВидыСобытийОС.ВводВЭксплуатацию);
	Запрос.УстановитьПараметр("Счет104"				, БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("104.00"));
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка 			= Результат[0].Выбрать();
	ВыборкаДрагМеталлы 		= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия 		= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаХарактеристики	= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_4а");
	ОбластьАкт 				= Макет.ПолучитьОбласть("Акт");
	ОбластьАкт_2 			= Макет.ПолучитьОбласть("Акт_2");
	ОбластьДрагметалл 		= Макет.ПолучитьОбласть("Драгметалл");
	ОбластьДрагметалл_2 	= Макет.ПолучитьОбласть("Драгметалл_2");
	ОбластьАкт_2_1 			= Макет.ПолучитьОбласть("Акт_2_1");
	ОбластьХарактеристики	= Макет.ПолучитьОбласть("Характеристики");
	ОбластьАкт_2_2 			= Макет.ПолучитьОбласть("Акт_2_2");
	ОбластьКомиссия 		= Макет.ПолучитьОбласть("Комиссия");
	ОбластьАкт_3 			= Макет.ПолучитьОбласть("Акт_3");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОтветственныеЛица = ОрганизационнаяСтруктураПовтИсп.ОтветственныеЛицаОрганизации(ВыборкаШапка.Организация, ВыборкаШапка.пДата);
		
	    ОбластьАкт.Параметры.Заполнить(ВыборкаШапка);
		ОбластьАкт.Параметры.Заполнить(Новый Структура("ИнвНомер", СокрЛП(ВыборкаШапка.ИнвНомер)));
		СтруктураОбластьАкт = Новый Структура("РукДолжн,ОргДиректор,СчетОС_Печ,ДолжностьМОЛ,МОЛ,НомерАкта");
		СтрРуководитель = ОтветственныеЛица.Найти(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
		Если СтрРуководитель<>Неопределено Тогда
			СтруктураОбластьАкт.РукДолжн	= СтрРуководитель.ДолжностьПредставление;
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтрРуководитель.ОтветственноеЛицоСсылка, ВыборкаШапка.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураОбластьАкт.ОргДиректор		= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		КонецЕсли;
		
		СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(ВыборкаШапка.ОсновноеСредство, ВыборкаШапка.Ссылка);
		КЭК = СчетУчета.КОСГУКт;
		
		СтруктураОбластьАкт.СчетОС_Печ	= ВыборкаШапка.КПС + "." + ВыборкаШапка.КФО + "."+СчетУчета 
											+ ?(ПустаяСтрока(КЭК), "", "."+КЭК);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", ВыборкаШапка.МОЛ, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьАкт.ДолжностьМОЛ	= ДанныеСотрудника.Должность;
	    СтруктураОбластьАкт.МОЛ			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		СтруктураОбластьАкт.НомерАкта 	= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.НомерАкта);
		ОбластьАкт.Параметры.Заполнить(СтруктураОбластьАкт);
		
		ТабличныйДокумент.Вывести(ОбластьАкт);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	    ТабличныйДокумент.Вывести(ОбластьАкт_2);
		
		ОбластьДрагметалл.Параметры.Заполнить(ВыборкаШапка);
		СтруктураОбластьДрагметалл = Новый Структура("Драгметалл,КодДрагМеталла,НазвЕИ,КоличествоДраг,ВесДраг","","","","","");
		
		ОбластьДрагметалл.Параметры.Заполнить(СтруктураОбластьДрагметалл);

	    // драгметаллы
		ВыборкаДрагМеталлы.Сбросить();
		ВывелиСтрок = 0;
		Если ВыборкаДрагМеталлы.НайтиСледующий(ВыборкаШапка.ОсновноеСредство, "ОсновноеСредство") Тогда
			
			ДрагМеталлы = ВыборкаДрагМеталлы.Выбрать();
			Пока ДрагМеталлы.Следующий() Цикл
				
				ВывелиСтрок = ВывелиСтрок + 1;
				ОбластьДрагметалл.Параметры.Заполнить(ДрагМеталлы);
				ОбластьДрагМеталл.Параметры.Заполнить(Новый Структура("НПП", ВывелиСтрок));
				ТабличныйДокумент.Вывести(ОбластьДрагметалл);
				
				Если ВывелиСтрок = 1 Тогда
					СтруктураОбластьДрагметалл = Новый Структура("ТехПаспорт,Двигатель,Шасси,Грузоподъемность,Масса","","","","","");
					ОбластьДрагметалл.Параметры.Заполнить(СтруктураОбластьДрагметалл);		
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			ТабличныйДокумент.Вывести(ОбластьДрагметалл);	
			
		КонецЕсли;
		ОбластьДрагметалл_2 	= Макет.ПолучитьОбласть("Драгметалл_2");
		Для Счетчик = ВывелиСтрок По 3 Цикл
			ТабличныйДокумент.Вывести(ОбластьДрагметалл_2);
		КонецЦикла;
		
	    ТабличныйДокумент.Вывести(ОбластьАкт_2_1);
		
		ВыборкаХарактеристики.Сбросить();
		ВывелиСтрок = 0;
		Если ВыборкаХарактеристики.НайтиСледующий(ВыборкаШапка.ОсновноеСредство, "ОсновноеСредство") Тогда
			Характеристики = ВыборкаХарактеристики.Выбрать();
			Пока Характеристики.Следующий() Цикл
				ОбластьХарактеристики.Параметры.Заполнить(Характеристики);
				ТабличныйДокумент.Вывести(ОбластьХарактеристики);
				ВывелиСтрок = ВывелиСтрок + 1;
			КонецЦикла;
		КонецЕсли;
		ОбластьХарактеристики 	= Макет.ПолучитьОбласть("Характеристики");
		Для Счетчик = ВывелиСтрок По 3 Цикл
			ТабличныйДокумент.Вывести(ОбластьХарактеристики);
		КонецЦикла;
		
		ОбластьАкт_2_2.Параметры.Заполнить(ВыборкаШапка);
		ТабличныйДокумент.Вывести(ОбластьАкт_2_2);
		
		// Комиссия
		пСтатусЧленаКомиссии	= "Председатель комиссии";
		пДолжностьЧленаКомиссии = ВыборкаШапка.ДолжностьПредседателяКомиссии;
		Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии) Тогда
			пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
	               																ВыборкаШапка.ФамилияПредседателяКомиссии,
	               																ВыборкаШапка.ИмяПредседателяКомиссии,
	               																ВыборкаШапка.ОтчествоПредседателяКомиссии));
		Иначе
			пЧленКомиссии			= "";
		КонецЕсли;
		СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
													пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);
		ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		
		пСтатусЧленаКомиссии = "Члены комиссии:";
		ВыборкаКомиссия.Сбросить();
		ВывелиСтрок = 0;
		Если ВыборкаКомиссия.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			
			Комиссия = ВыборкаКомиссия.Выбрать();
			Пока Комиссия.Следующий() Цикл
				ВывелиСтрок = ВывелиСтрок + 1;
				пДолжностьЧленаКомиссии = Комиссия.ДолжностьЧленаКомиссии;
				пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
			               																Комиссия.ФамилияЧленаКомиссии,
			               																Комиссия.ИмяЧленаКомиссии,
			               																Комиссия.ОтчествоЧленаКомиссии));
				СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
															пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);
				ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
				ТабличныйДокумент.Вывести(ОбластьКомиссия);
				
				пСтатусЧленаКомиссии = "";
				
			КонецЦикла;
			
		КонецЕсли;
		
		Для Счетчик = ВывелиСтрок По 2 Цикл
			
			СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
														пСтатусЧленаКомиссии,"","");
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
			ТабличныйДокумент.Вывести(ОбластьКомиссия);
				
			пСтатусЧленаКомиссии = "";
			
		КонецЦикла;
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		СтруктураОбластьАкт_3 = Новый Структура("ОргБухгалтер");
		СтрГлБухгалтер = ОтветственныеЛица.Найти(Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер);
		Если СтрГлБухгалтер<>Неопределено Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтрГлБухгалтер.ОтветственноеЛицоСсылка, ВыборкаШапка.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураОбластьАкт_3.ОргБухгалтер = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		Иначе
			СтруктураОбластьАкт_3.ОргБухгалтер = "";
		КонецЕсли;
		ОбластьАкт_3.Параметры.Заполнить(СтруктураОбластьАкт_3);
	    ТабличныйДокумент.Вывести(ОбластьАкт_3);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
