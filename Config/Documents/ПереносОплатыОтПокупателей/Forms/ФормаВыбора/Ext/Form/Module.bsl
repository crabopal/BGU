#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заменяем отбор по шапке на отбор по табличной части
	
	ЗаменитьОтбор("Контрагент");
	
	ЗаменитьОтбор("Договор");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаменитьОтбор(ИмяПоля)
	
	Перем Ссылка;
	
	Отбор = ЭтаФорма.Параметры.Отбор;
	
	Если Отбор.Свойство(ИмяПоля, Ссылка) Тогда
		Отбор.Удалить(ИмяПоля);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"Расчеты." + ИмяПоля,
			Ссылка,
			ВидСравненияКомпоновкиДанных.Равно,
			"",
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
