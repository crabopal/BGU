#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Расчеты

&НаКлиенте
Процедура РасчетыПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
	
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.Счет, РасчетыПоляАналитикиСчета());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетРасчетов, РасчетыПоляАналитикиСчетаРасчетов());
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
		РасчетыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыСчетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.Счет, РасчетыПоляАналитикиСчета());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.Счет, РасчетыПоляАналитикиСчета());
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
	
	Отбор = Новый Структура("ВидРасчетов,КФО,КодЦели,КодМероприятия,ДопКлассификация");
	ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
	Отбор.Вставить("ИФО", Объект.ИФО);
	Отбор.Вставить("Контрагент", ТекущиеДанные.КонтрагентРасчетов);
	Отбор.Вставить("Договор", ТекущиеДанные.ДоговорРасчетов);
	Отбор.Вставить("Валюта", БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета());
	Отбор.Вставить("КПС", ТекущиеДанные.КПС);
	Отбор.Вставить("КЭК", БухгалтерскийУчетВызовСервераПовтИсп.АналитическийКЭКпоСчету(ТекущиеДанные.СчетРасчетов));
	Отбор.Вставить("ЭтоПоступление", Истина);
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Объект.Организация, ТекущиеДанные.Договор, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыСчетРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
	ТекущиеДанные.ДопСубконтоРасчетов = Неопределено;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетРасчетов, РасчетыПоляАналитикиСчетаРасчетов());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетРасчетов, РасчетыПоляАналитикиСчетаРасчетов());
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Расчеты.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = ТекущиеДанные.ВалютаРеглУчета Тогда
		ТекущиеДанные.СуммаВал = ТекущиеДанные.Сумма;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РасчетыЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.Расчеты Цикл
		РасчетыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РасчетыПоляАналитикиСчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение, Субконто3",
		"Объект.Расчеты.Счет",
		"Объект.Расчеты.КПС",
		"Объект.Расчеты.Подразделение",
		"Объект.Расчеты.ДопСубконто");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РасчетыПоляАналитикиСчетаРасчетов()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Субконто3",
		"Объект.Расчеты.СчетРасчетов",
		"Объект.Расчеты.ДопСубконтоРасчетов");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		СтрокаТаблицы, СтрокаТаблицы.Счет, РасчетыПоляАналитикиСчета());
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		СтрокаТаблицы, СтрокаТаблицы.СчетРасчетов, РасчетыПоляАналитикиСчетаРасчетов());
	
КонецПроцедуры

