&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаРубли = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	РасчетыЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПереносОплатыМеждуДоговорамиКонтрагента = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыМеждуДоговорамиКонтрагента"));
	ЭтоПереносОплатыМеждуКонтрагентами = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыМеждуКонтрагентами"));
	ЭтоПереносОплатыПрочихКредиторов = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыПрочихКредиторов"));
	
	Если ЭтоПереносОплатыМеждуДоговорамиКонтрагента ИЛИ ЭтоПереносОплатыМеждуКонтрагентами Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаОтбор", "Заголовок", НСтр("ru = 'Отбор по остаткам расчетов'"));
	ИначеЕсли ЭтоПереносОплатыПрочихКредиторов Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаОтбор", "Заголовок", НСтр("ru = 'Отбор поступлений денежных средств'"));
	КонецЕсли;
	
	// Перенос оплаты прочих кредиторов.
	ОтборПоПериоду = Новый Массив;
	ОтборПоПериоду.Добавить("НачалоПериода");
	ОтборПоПериоду.Добавить("КонецПериода");
	ОтборПоПериоду.Добавить("УстановитьОтборПоПериоду");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОтборПоПериоду, "Видимость", ЭтоПереносОплатыПрочихКредиторов);
	
	КолонкиОплачено = Новый Массив;
	КолонкиОплачено.Добавить("РасчетыОплаченоСумма");
	КолонкиОплачено.Добавить("РасчетыОплаченоСуммаВал");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкиОплачено, "Видимость", ЭтоПереносОплатыПрочихКредиторов);
	
	// Перенос оплаты между договорами контрагента, между контрагентами.
	КолонкиОстаток = Новый Массив;
	КолонкиОстаток.Добавить("РасчетыОстатокСумма");
	КолонкиОстаток.Добавить("РасчетыОстатокСуммаВал");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкиОстаток, "Видимость", ЭтоПереносОплатыМеждуДоговорамиКонтрагента ИЛИ ЭтоПереносОплатыМеждуКонтрагентами);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Валютные суммы.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасчетыВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасчетыОплаченоСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасчетыОстатокСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасчетыСуммаВал");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Расчеты.Валюта", ВидСравненияКомпоновкиДанных.Равно,
			ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, РасчетыПоляАналитикиСчета());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, РасчетыПоляАналитикиСчетаРасчетов());
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьДокументПараметрыВопроса()
	
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ЗадатьВопрос", Ложь);
	ПараметрыВопроса.Вставить("ТекстВопроса",
		НСтр("ru = 'Заполнить документ по остаткам на счетах бухгалтерского учета?'") );
	
	ЕстьДанныеВДокументе = (Объект.Расчеты.Количество() > 0);
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат ПараметрыВопроса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДокументОбработкаОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыМеждуДоговорамиКонтрагента
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыМеждуКонтрагентами Тогда
		Отказ = Документы.ПереносОплатыОтПокупателей.ЗаполнитьПоОстаткамРасчетов(Объект);
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПереносОплатыОтПокупателей.ПереносОплатыПрочихКредиторов Тогда
		Отказ = Документы.ПереносОплатыОтПокупателей.ЗаполнитьПоПоступлениямОплаты(Объект);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РасчетыЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

