	|	СУММА(КоличествоУчетное)			КАК КоличествоУчетноеОтклонение,
	|	СУММА(КоличествоПрослеживаемости)	КАК КоличествоПрослеживаемостиОтклонение,
	|	СУММА(СуммаБезНДС)					КАК СуммаБезНДСОтклонение
	|ПОМЕСТИТЬ
	|	ПоказателиПослеИзменения
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДокументыКорректировки.Ссылка					КАК Ссылка,
	|		ПрослеживаемыеТовары.Номенклатура				КАК Номенклатура,
	|		ПрослеживаемыеТовары.РНПТ						КАК РНПТ,
	|		ПрослеживаемыеТовары.Количество					КАК КоличествоУчетное,
	|		ПрослеживаемыеТовары.КоличествоПрослеживаемости	КАК КоличествоПрослеживаемости,
	|		ПрослеживаемыеТовары.СуммаБезНДС				КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА ПрослеживаемыеТовары.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ПрослеживаемыеТовары.Комплектующее.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			ИНАЧЕ
	|				ЕСТЬNULL(ПрослеживаемыеТовары.Номенклатура.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|		КОНЕЦ											КАК ЕдиницаИзмерения
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыКорректировки
	|			ПО	ПрослеживаемыеТовары.Регистратор = ДокументыКорректировки.ДокументКорректировки
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДокументыКорректировки.Ссылка				КАК Ссылка,
	|		ПрослеживаемыеОС.ОсновноеСредство			КАК Номенклатура,
	|		ПрослеживаемыеОС.РНПТ						КАК РНПТ,
	|		ПрослеживаемыеОС.Количество					КАК КоличествоУчетное,
	|		ПрослеживаемыеОС.КоличествоПрослеживаемости	КАК КоличествоПрослеживаемости,
	|		ПрослеживаемыеОС.СуммаБезНДС				КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА ПрослеживаемыеОС.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|				И ПрослеживаемыеОС.Комплектующее <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ВЫРАЗИТЬ(ПрослеживаемыеОС.Комплектующее КАК Справочник.ОсновныеСредства).КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			КОГДА ПрослеживаемыеОС.Комплектующее ССЫЛКА Справочник.Номенклатура
	|				И ПрослеживаемыеОС.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ВЫРАЗИТЬ(ПрослеживаемыеОС.Комплектующее КАК Справочник.Номенклатура).КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			ИНАЧЕ
	|				ЕСТЬNULL(ПрослеживаемыеОС.ОсновноеСредство.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|		КОНЕЦ										КАК ЕдиницаИзмерения
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеОС КАК ПрослеживаемыеОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыКорректировки
	|			ПО	ПрослеживаемыеОС.Регистратор = ДокументыКорректировки.ДокументКорректировки) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Номенклатура,
	|	РНПТ,
	|	ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Показатели прослеживаемости до и после изменения
	|//
	|ВЫБРАТЬ
	|	Ссылка															КАК Ссылка,
	|	Номенклатура													КАК Номенклатура,
	|	РНПТ															КАК РНПТ,
	|	ЕдиницаИзмерения												КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(СУММА(КоличествоУчетноеДоИзменения), 0)				КАК КоличествоУчетноеДоИзменения,
	|	ЕСТЬNULL(СУММА(КоличествоУчетноеПослеИзменения), 0)				КАК КоличествоУчетноеПослеИзменения,
	|	ЕСТЬNULL(СУММА(КоличествоПрослеживаемостиДоИзменения), 0)		КАК КоличествоПрослеживаемостиДоИзменения,
	|	ЕСТЬNULL(СУММА(КоличествоПрослеживаемостиПослеИзменения), 0)	КАК КоличествоПрослеживаемостиПослеИзменения,
	|	ЕСТЬNULL(СУММА(СуммаБезНДСДоИзменения), 0)						КАК СуммаБезНДСДоИзменения,
	|	ЕСТЬNULL(СУММА(СуммаБезНДСПослеИзменения), 0)					КАК СуммаБезНДСПослеИзменения
	|ПОМЕСТИТЬ
	|	Показатели
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка						КАК Ссылка,
	|		Номенклатура				КАК Номенклатура,
	|		РНПТ						КАК РНПТ,
	|		ЕдиницаИзмерения			КАК ЕдиницаИзмерения,
	|		КоличествоУчетное			КАК КоличествоУчетноеДоИзменения,
	|		0							КАК КоличествоУчетноеПослеИзменения,
	|		КоличествоПрослеживаемости	КАК КоличествоПрослеживаемостиДоИзменения,
	|		0							КАК КоличествоПрослеживаемостиПослеИзменения,
	|		СуммаБезНДС					КАК СуммаБезНДСДоИзменения,
	|		0							КАК СуммаБезНДСПослеИзменения
	|	ИЗ
	|		ПоказателиДоИзменения
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПоказателиПослеИзменения.Ссылка										КАК Ссылка,
	|		ПоказателиПослеИзменения.Номенклатура								КАК Номенклатура,
	|		ПоказателиПослеИзменения.РНПТ										КАК РНПТ,
	|		ПоказателиПослеИзменения.ЕдиницаИзмерения							КАК ЕдиницаИзмерения,
	|		0																	КАК КоличествоУчетноеДоИзменения,
	|		ПоказателиПослеИзменения.КоличествоУчетноеОтклонение
	|			+ ЕСТЬNULL(ПоказателиДоИзменения.КоличествоУчетное, 0)			КАК КоличествоУчетноеПослеИзменения,
	|		0																	КАК КоличествоПрослеживаемостиДоИзменения,
	|		ПоказателиПослеИзменения.КоличествоПрослеживаемостиОтклонение
	|			+ ЕСТЬNULL(ПоказателиДоИзменения.КоличествоПрослеживаемости, 0)	КАК КоличествоПрослеживаемостиПослеИзменения,
	|		0																	КАК СуммаБезНДСДоИзменения,
	|		ПоказателиПослеИзменения.СуммаБезНДСОтклонение
	|			+ ЕСТЬNULL(ПоказателиДоИзменения.СуммаБезНДС, 0)				КАК СуммаБезНДСПослеИзменения
	|	ИЗ
	|		ПоказателиПослеИзменения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоказателиДоИзменения
	|			ПО	ПоказателиПослеИзменения.Ссылка = ПоказателиДоИзменения.Ссылка
	|			И	ПоказателиПослеИзменения.Номенклатура = ПоказателиДоИзменения.Номенклатура
	|			И	ПоказателиПослеИзменения.РНПТ = ПоказателиДоИзменения.РНПТ
	|		) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Номенклатура,
	|	РНПТ,
	|	ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Искомые показатели прослеживаемости
	|//
	|ВЫБРАТЬ
	|	СоставНФА.Ссылка												КАК Ссылка,
	|	СоставНФА.НомерСтроки											КАК НомерСтроки,
	|	
	|	// Ссылки
	|	Показатели.РНПТ													КАК РНПТ,
	|	Показатели.ЕдиницаИзмерения										КАК ЕдиницаПрослеживаемости,
	|	
	|	// Представления для печати
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТДДо,
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТДПосле,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКодДо,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКодПосле,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослежДо,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослежПосле,
	|	Показатели.КоличествоУчетноеДоИзменения							КАК КоличествоУчетноеДо,
	|	Показатели.КоличествоУчетноеПослеИзменения						КАК КоличествоУчетноеПосле,
	|	Показатели.КоличествоПрослеживаемостиДоИзменения				КАК КоличествоПрослежДо,
	|	Показатели.КоличествоПрослеживаемостиПослеИзменения				КАК КоличествоПрослежПосле,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДСДоИзменения <> 0 ТОГДА
	|			Показатели.СуммаБезНДСДоИзменения
	|		КОГДА СоставНФА.КоличествоДоИзменения <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.СуммаДоИзменения / СоставНФА.КоличествоДоИзменения) * Показатели.КоличествоПрослеживаемостиДоИзменения КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.ЦенаДоИзменения * Показатели.КоличествоПрослеживаемостиДоИзменения КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослежДо,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДСПослеИзменения <> 0 ТОГДА
	|			Показатели.СуммаБезНДСПослеИзменения
	|		КОГДА СоставНФА.Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.Сумма / СоставНФА.Количество) * Показатели.КоличествоПрослеживаемостиПослеИзменения КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.Цена * Показатели.КоличествоПрослеживаемостиПослеИзменения КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослежПосле
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Показатели
	|		ПО	СоставНФА.Ссылка	= Показатели.Ссылка
	|		И	СоставНФА.НФА		= Показатели.Номенклатура
	|ГДЕ
	|	СоставНФА.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставНФА.Ссылка												КАК Ссылка,
	|	СоставНФА.НомерСтроки											КАК НомерСтроки,
	|	
	|	// Ссылки
	|	Показатели.РНПТ													КАК РНПТ,
	|	Показатели.ЕдиницаИзмерения										КАК ЕдиницаПрослеживаемости,
	|	
	|	// Представления для печати
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТДДо,
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТДПосле,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКодДо,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКодПосле,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослежДо,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослежПосле,
	|	Показатели.КоличествоУчетноеДоИзменения							КАК КоличествоУчетноеДо,
	|	Показатели.КоличествоУчетноеПослеИзменения						КАК КоличествоУчетноеПосле,
	|	Показатели.КоличествоПрослеживаемостиДоИзменения				КАК КоличествоПрослежДо,
	|	Показатели.КоличествоПрослеживаемостиПослеИзменения				КАК КоличествоПрослежПосле,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДСДоИзменения <> 0 ТОГДА
	|			Показатели.СуммаБезНДСДоИзменения
	|		КОГДА СоставНФА.КоличествоДоКорректировки <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.СуммаДоКорректировки / СоставНФА.КоличествоДоКорректировки) * Показатели.КоличествоПрослеживаемостиДоИзменения КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.ЦенаДоКорректировки * Показатели.КоличествоПрослеживаемостиДоИзменения КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослежДо,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДСПослеИзменения <> 0 ТОГДА
	|			Показатели.СуммаБезНДСПослеИзменения
	|		КОГДА СоставНФА.Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.Сумма / СоставНФА.Количество) * Показатели.КоличествоПрослеживаемостиПослеИзменения КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.Цена * Показатели.КоличествоПрослеживаемостиПослеИзменения КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослежПосле
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Показатели
	|		ПО	СоставНФА.Ссылка	= Показатели.Ссылка
	|		И	СоставНФА.НФА		= Показатели.Номенклатура
	|ГДЕ
	|	СоставНФА.Ссылка В(&МассивСсылок)
	|	И ТИПЗНАЧЕНИЯ(СоставНФА.Ссылка.ИсправляемыйДокумент) = ТИП(Документ.КорректировочныйСчетФактураВыданный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.Ссылка,
	|	СоставНФА.НомерСтроки";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

