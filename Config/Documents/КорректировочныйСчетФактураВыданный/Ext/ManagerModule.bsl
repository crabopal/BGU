	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.РеализацияЛомаШкур) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.РеализацияЛом)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15	КАК НакладнаяНаОтпускМ15
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	
	|	// До корректировки
	|	СтавкаНДС										КАК СтавкаНДСДоИзменения,
	|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И СуммаДоКорректировки <> 0 ТОГДА
	|			ЦенаДоКорректировки - ВЫРАЗИТЬ(СуммаНДСДоКорректировки * (Цена/СуммаДоКорректировки) КАК Число(15,2)) 
	|		ИНАЧЕ
	|			ЦенаДоКорректировки
	|	КОНЕЦ											КАК ЦенаДоИзменения,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаДоКорректировки - СуммаНДСДоКорректировки
	|		ИНАЧЕ
	|			СуммаДоКорректировки
	|	КОНЕЦ											КАК СуммаДоИзменения,
	|	СуммаНДСДоКорректировки							КАК СуммаНДСДоИзменения,
	|	ВсегоДоКорректировки							КАК ВсегоДоИзменения,
	|	
	|	// После корректировки
	|	СтавкаНДС										КАК СтавкаНДС,
	|	Количество										КАК Количество,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И Сумма <> 0 ТОГДА
	|			Цена - ВЫРАЗИТЬ(СуммаНДС * (Цена/Сумма) КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ											КАК Цена,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Сумма,
	|	СуммаНДС										КАК СуммаНДС,
	|	Всего											КАК Всего
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.Материалы	КАК Материалы
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	
	|	// До корректировки
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДСДоИзменения,
	|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА КоличествоДоКорректировки <> 0 ТОГДА
	|			ВЫРАЗИТЬ(СуммаДоКорректировки / КоличествоДоКорректировки КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			СуммаДоКорректировки
	|	КОНЕЦ											КАК ЦенаДоИзменения,
	|	СуммаДоКорректировки							КАК СуммаДоИзменения,
	|	0												КАК СуммаНДСДоИзменения,
	|	СуммаДоКорректировки							КАК ВсегоДоИзменения,
	|	
	|	// После корректировки
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДС,
	|	Количество										КАК Количество,
	|	ВЫБОР
	|		КОГДА Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ(Сумма / Количество КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Цена,
	|	Сумма											КАК Сумма,
	|	0												КАК СуммаНДС,
	|	Сумма											КАК Всего
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.ВозвратнаяТара
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка	
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Данные шапки
	Шапка = РезультатыЗапроса[0].Выгрузить()[0];
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	РезультатыПоиска = УчетНДС.НайтиПредыдущийСчетФактуруРеализации(ДокументОснования);
	
	Если РезультатыПоиска <> Неопределено Тогда
		ДозаполнитьПоСчетуФактуре(Объект, РезультатыПоиска.Ссылка);
	КонецЕсли;
	
	// [1]. Данные табличной части СоставНФА
	Объект.СоставНФА.Загрузить(РезультатыЗапроса[1].Выгрузить());
	
	Для Каждого СтрокаТаблицы Из Объект.СоставНФА Цикл
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Сумма");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "СуммаНДС");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Всего");
	КонецЦикла;
	
	// Ответственные лица
	УстановитьОтветственныхЛиц(Объект);
	
КонецПроцедуры

Функция ЗаполнитьНаОснованииНакладнаяНаОтпускМ15_ТиповаяОперация(Знач ДокументОснования) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснования, "КФО");
	
	// Основание
	ТиповаяОперацияОснования		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументОснования);
	СтруктураРеквизитовОснования	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(ТиповаяОперацияОснования);
	РеквизитыОперацииОснования		= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснования, СтруктураРеквизитовОснования);
	
	// Заполняемый документ
	ТиповаяОперацияСсылка = Справочники.ТиповыеОперации.КорректировочныйСчетФактураВыданный_КорректировкаНДС;
	
	РеквизитыТиповойОперации = Новый Структура();
	РеквизитыТиповойОперации.Вставить("КФО",	ЗначенияРеквизитов.КФО);
	РеквизитыТиповойОперации.Вставить("КПС",	РеквизитыОперацииОснования.КДБ);
	РеквизитыТиповойОперации.Вставить("Счет",	РеквизитыОперацииОснования.СчетДоходов);
	РеквизитыТиповойОперации.Вставить("КЭК",	РеквизитыОперацииОснования.КЭКДоходов);
	
	ТиповаяОперация = Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",		ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("Реквизиты",	РеквизитыТиповойОперации);
	
	Возврат ТиповаяОперация;
	
КонецФункции


Процедура ДозаполнитьПоСчетуФактуре(ДокументОбъект, СчетФактура)
	
	Если НЕ ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат;
	КонецЕсли;
	
	// Реквизиты шапки
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|Номер,
		 	|Дата,
			|ПричинаНалогообложения,
		 	|КодВидаОперации,
			|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов,,"Номер,Дата");
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		ДокументОбъект.ИсправляемыйДокумент = СчетФактура;
		ДокументОбъект.НомерПервичногоДокумента = ЗначенияРеквизитов.Номер;
		ДокументОбъект.ДатаПервичногоДокумента = ЗначенияРеквизитов.Дата;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииИсправительныйСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|ПричинаНалогообложения,
			|ИсправляемыйДокумент,
			|КодВидаОперации,
			|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииКорректировочныйСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|ПричинаНалогообложения,
			|ИсправляемыйДокумент,
			|КодВидаОперации,
			|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// Табличные части
	
	УчетНДС.ЗаполнитьПлатежноРасчетныеДокументы(ДокументОбъект, СчетФактура);
	
КонецПроцедуры


Процедура ЗаполнитьРеквизитыСторонСделки(ДокументОбъект) Экспорт
	
	ШапкаДокумента = Новый Структура("
		|Дата,
		|Контрагент,
		|Организация,
		|Подразделение,
		|ПричинаНалогообложения");
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Если НЕ УчетНДС.ЗаполненыОбязательныеРеквизитыДляОпределенияСторонСделки(ШапкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = УчетНДС.РасширитьШапкуДокументаДляОпределенияПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокумента);
	
	ОбщаяКонтактнаяИнформация = УчетНДС.ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["СписокОбъектовДляОпределенияАдресов"]);
	
	СтороныСделки = УчетНДС.ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["ШапкаДокументаРасширенная"],
		ОбщаяКонтактнаяИнформация);
	
	Параметры = Новый Структура();
	
	//Для корректировочного перевыставленного счета-фактуры от комиссионера данные продавца уже заполнены
	Если ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку Тогда
		Параметры.Вставить("НаименованиеПокупателя",	СтороныСделки.Покупатель.Наименование);
		Параметры.Вставить("АдресПокупателя",			СтороныСделки.Покупатель.Адрес.Представление);
		Параметры.Вставить("ИННПокупателя",				СтороныСделки.Покупатель.ИНН);
		Параметры.Вставить("КПППокупателя",				СтороныСделки.Покупатель.КПП);
	Иначе
		Параметры.Вставить("НаименованиеПродавца",	СтороныСделки.Продавец.Наименование);
		Параметры.Вставить("АдресПродавца",			СтороныСделки.Продавец.Адрес.Представление);
		Параметры.Вставить("ИННПродавца",			СтороныСделки.Продавец.ИНН);
		Параметры.Вставить("КПППродавца",			СтороныСделки.Продавец.КПП);
		
		Параметры.Вставить("НаименованиеПокупателя",	СтороныСделки.Покупатель.Наименование);
		Параметры.Вставить("АдресПокупателя",			СтороныСделки.Покупатель.Адрес.Представление);
		Параметры.Вставить("ИННПокупателя",				СтороныСделки.Покупатель.ИНН);
		Параметры.Вставить("КПППокупателя",				СтороныСделки.Покупатель.КПП);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Параметры);
	
КонецПроцедуры


Процедура УстановитьОтветственныхЛиц(ДокументОбъект) Экспорт
	
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(ДокументОбъект);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОтветственныеЛица);
	
КонецПроцедуры

Функция ПолучитьОтветственныхЛиц(Шапка)
	
	Лицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	СтруктураФИО = Новый Структура();
	СтруктураФИО.Вставить("Фамилия",	Лицо.ОтветственноеЛицоФамилия);
	СтруктураФИО.Вставить("Имя",		Лицо.ОтветственноеЛицоИмя);
	СтруктураФИО.Вставить("Отчество",	Лицо.ОтветственноеЛицоОтчество);
	
	ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
	
	Лицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	СтруктураФИО = Новый Структура();
	СтруктураФИО.Вставить("Фамилия",	Лицо.ОтветственноеЛицоФамилия);
	СтруктураФИО.Вставить("Имя",		Лицо.ОтветственноеЛицоИмя);
	СтруктураФИО.Вставить("Отчество",	Лицо.ОтветственноеЛицоОтчество);
	
	ФИОГлавногоБухгалтера = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
	
	ОтветственныеЛица = Новый Структура();
	ОтветственныеЛица.Вставить("ФИОРуководителя",		ФИОРуководителя);
	ОтветственныеЛица.Вставить("ФИОГлавногоБухгалтера",	ФИОГлавногоБухгалтера);
	
	Возврат ОтветственныеЛица;
	
КонецФункции


Функция ПолучитьКодыУпаковокИзСФ(СсылкаКСФ) Экспорт
	
	
	ВыбираемыеПоляСФ = Новый Структура();
	//						  Псевдоним					Путь относительно табличной части в запросе
	ВыбираемыеПоляСФ.Вставить("ИдентификаторСтроки",	"ИдентификаторСтроки");
	
	ВыбираемыеПоля = Новый Структура();
	ВыбираемыеПоля.Вставить("СФ", ВыбираемыеПоляСФ);
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(СсылкаКСФ);
	
	КорректируемыеПозиции = Документы.КорректировочныйСчетФактураВыданный.ДополнитьТабличныеЧастиКСФКорректируемымиПозициямиОбычныхСФ(МассивСсылок, ВыбираемыеПоля);
	
	ДополненнаяТЧ = КорректируемыеПозиции["ДополненныеТабличныеЧастиКСФ"];
	
	// Во всех строках указан один и тот же счет-фактура
	
	СсылкаСФ = Неопределено;
	
	МассивИдентификаторов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ДополненнаяТЧ Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СсылкаСФ) И НЕ ЗначениеЗаполнено(СсылкаСФ) Тогда
			СсылкаСФ = СтрокаТаблицы.СсылкаСФ;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			МассивИдентификаторов.Добавить(СтрокаТаблицы.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СсылкаСФ", СсылкаСФ);
	ЗапросПоиск.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ИдентификаторСтроки	КАК ИдентификаторСтроки,
	|	НомерУпаковки		КАК НомерУпаковки,
	|	ТипУпаковки			КАК ТипУпаковки
	|ИЗ
	|	Документ.СчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаСФ
	|	И ИдентификаторСтроки В (&МассивИдентификаторов)";
	
	ОбщаяТаблицаМаркировкиИзСФ = ЗапросПоиск.Выполнить().Выгрузить();
	
	ДополненнаяТЧ.Колонки.Добавить("ТаблицаМаркировкиИзСФ", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Для Каждого СтрокаТаблицы Из ДополненнаяТЧ Цикл
		ТаблицаМаркировки = Новый ТаблицаЗначений();
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			Поиск = Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
			
			ТаблицаМаркировки = ОбщаяТаблицаМаркировкиИзСФ.Скопировать(Поиск);
		КонецЕсли;
		
		СтрокаТаблицы.ТаблицаМаркировкиИзСФ = ТаблицаМаркировки;
	КонецЦикла;
	
	ОставляемыеКолонки = Новый Массив();
	ОставляемыеКолонки.Добавить("НомерСтроки");
	ОставляемыеКолонки.Добавить("ТаблицаМаркировкиИзСФ");
	
	УдаляемыеКолонки = Новый Массив();
	
	Для Каждого Колонка Из ДополненнаяТЧ.Колонки Цикл
		Если ОставляемыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			УдаляемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКолонки Из УдаляемыеКолонки Цикл
		ДополненнаяТЧ.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
	Возврат ДополненнаяТЧ;
	
КонецФункции


