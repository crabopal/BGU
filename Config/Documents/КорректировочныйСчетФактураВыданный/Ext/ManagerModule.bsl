	|	ЕдиницаИзмерения.Представление						КАК ЕдиницаИзмеренияПредставлениеДоИзменения,
	|	КоличествоДоИзменения								КАК КоличествоДоИзменения,
	|	ЦенаДоИзменения										КАК ЦенаДоИзменения,
	|	СуммаДоИзменения									КАК СуммаДоИзменения,
	|	ПРЕДСТАВЛЕНИЕ(СтавкаНДСДоИзменения)					КАК СтавкаНДСДоИзменения,
	|	СуммаНДСДоИзменения									КАК СуммаНДСДоИзменения,
	|	ВсегоДоИзменения									КАК ВсегоДоИзменения,
	|	СуммаАкцизаДоИзменения								КАК АкцизДоИзменения,
	|	
	|	// После изменения
	|	ЕдиницаИзмерения									КАК ЕдиницаИзмеренияПослеИзменения,
	|	ЕдиницаИзмерения.Код								КАК ЕдиницаИзмеренияКодПослеИзменения,
	|	ЕдиницаИзмерения.Представление						КАК ЕдиницаИзмеренияПредставлениеПослеИзменения,
	|	Количество											КАК КоличествоПослеИзменения,
	|	Цена												КАК ЦенаПослеИзменения,
	|	Сумма												КАК СуммаПослеИзменения,
	|	ПРЕДСТАВЛЕНИЕ(СтавкаНДС)							КАК СтавкаНДСПослеИзменения,
	|	СуммаНДС											КАК СуммаНДСПослеИзменения,
	|	Всего												КАК ВсегоПослеИзменения,
	|	СуммаАкциза											КАК АкцизПослеИзменения,
	|	
	|	// Увеличение
	|	СуммаУвеличение										КАК СуммаУвеличение,
	|	СуммаНДСУвеличение									КАК СуммаНДСУвеличение,
	|	ВсегоУвеличение										КАК ВсегоУвеличение,
	|	СуммаАкцизаУвеличение								КАК АкцизУвеличение,
	|	
	|	// Уменьшение
	|	СуммаУменьшение										КАК СуммаУменьшение,
	|	СуммаНДСУменьшение									КАК СуммаНДСУменьшение,
	|	ВсегоУменьшение										КАК ВсегоУменьшение,
	|	СуммаАкцизаУменьшение								КАК АкцизУменьшение
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА	КАК СоставНФА
	|ГДЕ
	|	Ссылка В (&СсылкиНаДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(СуммаУменьшение)		КАК СуммаУменьшение,
	|	СУММА(СуммаУвеличение)		КАК СуммаУвеличение,
	|	СУММА(СуммаНДСУменьшение)	КАК СуммаНДСУменьшение,
	|	СУММА(СуммаНДСУвеличение)	КАК СуммаНДСУвеличение,
	|	СУММА(ВсегоУменьшение)		КАК ВсегоУменьшение,
	|	СУММА(ВсегоУвеличение)		КАК ВсегоУвеличение
	|ПО
	|	// Обязательно первые итоги по ссылке на документ
	|	Ссылка";
	
	МассивРезультатов = ЗапросПечать.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [0]. Данные шапки документа
	Результат.Вставить("ВыборкаШапка",			МассивРезультатов[0].Выбрать());
	
	// [1]. Данные таблицы ""Состав НФА""
	Результат.Вставить("ВыборкаДокСоставНФА",	МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Результат.Вставить("НомераСтрокСчетовФактур", ДополнитьТабличныеЧастиКСФКорректируемымиПозициямиОбычныхСФ(МассивОбъектов));
	
	// Прослеживаемость
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Результат.Вставить("ПоказателиПрослеживаемости", ПолучитьПоказателиПрослеживаемости(МассивОбъектов));
	КонецЕсли;
	// Конец Прослеживаемость
	
	Результат.Вставить("ПризнакиСчетовФактур", УчетНДС.ПолучитьПризнакиСчетовФактур(МассивОбъектов));
	
	Возврат Результат;
	
КонецФункции

//---
// Корректируемые позиции
//---

Функция ДополнитьТабличныеЧастиКСФКорректируемымиПозициямиОбычныхСФ(КСФ, Знач ВыбираемыеПоля = Неопределено) Экспорт
	
	Перем	ВыбираемыеПоляСФ,
			ВыбираемыеПоляКСФ;
			
	ПереданыТабличныеЧастиКСФ = (ТипЗнч(КСФ) = Тип("ТаблицаЗначений"));
	
	ПереданМассивСсылокКСФ = (ТипЗнч(КСФ) = Тип("Массив"));
	
	Если НЕ ПереданыТабличныеЧастиКСФ И НЕ ПереданМассивСсылокКСФ Тогда
		
		ВызватьИсключение НСтр("ru='Недопустимый тип параметра ""КСФ"". Ожидается Массив (ссылки на документы) или ТаблицаЗначений (табличные части документов)'");
		
	КонецЕсли;
	
	КлючиПоиска = ПолучитьТаблицуКлючиПоискаКорректируемыхПозиций();
	
	Если ВыбираемыеПоля = Неопределено Тогда
		ВыбираемыеПоля = Новый Структура("СФ, КСФ");
	КонецЕсли;
	
	ВыбираемыеПоля.Свойство("СФ", ВыбираемыеПоляСФ);
	ВыбираемыеПоля.Свойство("КСФ", ВыбираемыеПоляКСФ);
	
	// Поля КСФ
	//
	// Следующие поля автоматически включаются в список выбираемых полей:
	//	- Ссылка		КАК Ссылка
	//	- НомерСтроки	КАК НомерСтроки
	//
	// Явно указывать эти поля не требуется.
	
	Если ПереданыТабличныеЧастиКСФ Тогда
		
		// Проверим наличие ожидаемых колонок в переданной таблице
		
		ОбязательныеКолонки = Новый Массив();
		ОбязательныеКолонки.Добавить("Ссылка");
		ОбязательныеКолонки.Добавить("НомерСтроки");
		
		Для Каждого СтрокаТаблицы Из КлючиПоиска Цикл
			ИмяКолонки = СтрЗаменить(СтрокаТаблицы["ПутьКСФ"], ".", "");
			
			ОбязательныеКолонки.Добавить(ИмяКолонки);
		КонецЦикла;
		
		Если ТипЗнч(ВыбираемыеПоляКСФ) = Тип("Структура") Тогда
			
			Для Каждого Элемент Из ВыбираемыеПоляКСФ Цикл
				ИмяКолонки = Элемент.Ключ;
				
				ОбязательныеКолонки.Добавить(ИмяКолонки);
			КонецЦикла;
		
		КонецЕсли;
		
		Для Каждого ИмяКолонки Из ОбязательныеКолонки Цикл
			
			ОтсутствуетКолонка = (КСФ.Колонки.Найти(ИмяКолонки) = Неопределено);
			
			Если ОтсутствуетКолонка Тогда
				
				ВызватьИсключение СтрШаблон(НСтр("ru='Отсутствует колонка ""%1"" в переданной таблице'"), ИмяКолонки);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВыбираемыеПоляКСФ = Неопределено Тогда
			
			ВыбираемыеПоляКСФ = Новый Структура();
			
			Для Каждого Колонка Из КСФ.Колонки Цикл
				ИмяКолонки = Колонка.Имя;
				
				ЭтоОбязательнаяКолонка = (ОбязательныеКолонки.Найти(ИмяКолонки) <> Неопределено);
				
				Если ЭтоОбязательнаяКолонка Тогда
					Продолжить;
				КонецЕсли;
				
				ВыбираемыеПоляКСФ.Вставить(ИмяКолонки, ИмяКолонки);
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ПереданМассивСсылокКСФ Тогда
		
		Если ВыбираемыеПоляКСФ = Неопределено Тогда
			ВыбираемыеПоляКСФ = Новый Структура();
		КонецЕсли;
		
	КонецЕсли;
	
	// Поля СФ
	//
	// Следующие поля автоматически включаются в список выбираемых полей:
	//	- Ссылка		КАК СсылкаСФ
	//	- НомерСтроки	КАК НомерСтрокиСФ
	//
	// Явно указывать эти поля не требуется.
	
	Если ВыбираемыеПоляСФ = Неопределено Тогда
		ВыбираемыеПоляСФ = Новый Структура();
	КонецЕсли;
	
	ПсевдонимКлючаПоискаШаблон = "ПолеКлючаПоиска_%1";
	
	ПсевдонимКлючаПоискаСФ = СтрШаблон(ПсевдонимКлючаПоискаШаблон, "1");
	
	
	Текст0_Выбрать_КлючиПоиска = "";
	Текст1_Выбрать_КлючиПоиска = "";
	Текст2_Выбрать_КлючиПоиска = "";
	Текст2_Сгруппировать_КлючиПоиска = "";
	Текст3_Выбрать_КлючиПоиска = "";
	Текст4_ЛевоеСоединение = "";
	
	НомерПоля = 0;
	
	// Ключи поиска корректируемых позиций
	
	Для Каждого СтрокаТаблицы Из КлючиПоиска Цикл
		ПутьКСФ		= СтрокаТаблицы["ПутьКСФ"];
		ПутьСФ		= СтрокаТаблицы["ПутьСФ"];
		
		Если ПереданыТабличныеЧастиКСФ Тогда
			
			ПутьКСФ = СтрЗаменить(ПутьКСФ, ".", "");
			
		КонецЕсли;
		
		НомерПоля = НомерПоля + 1;
		
		Псевдоним = СтрШаблон(ПсевдонимКлючаПоискаШаблон, Формат(НомерПоля, "ЧГ=0"));
		
		Текст0_Выбрать_КлючиПоиска = Текст0_Выбрать_КлючиПоиска +
			?(Текст0_Выбрать_КлючиПоиска = "", "", ",
				|	")
			+ "ТЗ." + ПутьКСФ + " КАК " + Псевдоним;
			
		Текст1_Выбрать_КлючиПоиска = Текст1_Выбрать_КлючиПоиска +
			?(Текст1_Выбрать_КлючиПоиска = "", "", ",
				|	")
			+ ПутьСФ + " КАК " + Псевдоним;
			
		Текст2_Выбрать_КлючиПоиска = Текст2_Выбрать_КлючиПоиска +
			?(Текст2_Выбрать_КлючиПоиска = "", "", ",
				|	")
			+ Псевдоним + " КАК " + Псевдоним;
			
		Текст2_Сгруппировать_КлючиПоиска = Текст2_Сгруппировать_КлючиПоиска +
			?(Текст2_Сгруппировать_КлючиПоиска = "", "", ",
				|	")
			+ Псевдоним;
			
		Текст3_Выбрать_КлючиПоиска = Текст3_Выбрать_КлючиПоиска +
			?(Текст3_Выбрать_КлючиПоиска = "", "", ",
				|	")
			+ "ВсеПозицииСФ." + Псевдоним + " КАК " + Псевдоним;
			
		Текст4_ЛевоеСоединение = Текст4_ЛевоеСоединение +
			?(Текст4_ЛевоеСоединение = "", "", "
				|		И ")
			+ "ДетальныеПозицииКСФ." + Псевдоним + " = СвернутыеПозицииСФ." + Псевдоним;
	КонецЦикла;
	
	
	// Выбираемые поля КСФ
	
	Текст0_Выбрать_ПоляКСФ = "";
	Текст4_Выбрать_ПоляКСФ = "";
	
	Для Каждого Элемент Из ВыбираемыеПоляКСФ Цикл
		ПутьКДанным = Элемент.Значение;
		Псевдоним = Элемент.Ключ;
		
		Если ПереданыТабличныеЧастиКСФ Тогда
			
			ПутьКДанным = Псевдоним;
			
		КонецЕсли;
	
		Текст0_Выбрать_ПоляКСФ = Текст0_Выбрать_ПоляКСФ +
			?(Текст0_Выбрать_ПоляКСФ = "", "", ",
				|	")
			+ "ТЗ." + ПутьКДанным + " КАК " + Псевдоним;
			
		Текст4_Выбрать_ПоляКСФ = Текст4_Выбрать_ПоляКСФ +
			?(Текст4_Выбрать_ПоляКСФ = "", "", ",
				|	")
			+ Псевдоним + " КАК " + Псевдоним;
	КонецЦикла;
	
	// Запрошенные поля КСФ (могут отсутствовать)
	Если ВыбираемыеПоляКСФ.Количество() > 0 Тогда
		Текст0_Выбрать_ПоляКСФ = Текст0_Выбрать_ПоляКСФ + ",";
		Текст4_Выбрать_ПоляКСФ = Текст4_Выбрать_ПоляКСФ + ",";
	КонецЕсли;

	
	// Выбираемые поля СФ
	
	Текст1_Выбрать_ПоляКорректируемыхПозиций = "";
	Текст3_Выбрать_ПоляКорректируемыхПозиций = "";
	Текст4_Выбрать_ПоляКорректируемыхПозиций = "";
	
	Для Каждого Элемент Из ВыбираемыеПоляСФ Цикл
		ПутьКДанным = Элемент.Значение;
		Псевдоним = Элемент.Ключ;
		
		Текст1_Выбрать_ПоляКорректируемыхПозиций = Текст1_Выбрать_ПоляКорректируемыхПозиций +
			?(Текст1_Выбрать_ПоляКорректируемыхПозиций = "", "", ",
				|	")
			+ ПутьКДанным + " КАК " + Псевдоним;
			
			
		Текст3_Выбрать_ПоляКорректируемыхПозиций = Текст3_Выбрать_ПоляКорректируемыхПозиций +
			?(Текст3_Выбрать_ПоляКорректируемыхПозиций = "", "", ",
				|	")
			+ "ВсеПозицииСФ." + Псевдоним + " КАК " + Псевдоним;
			
		Текст4_Выбрать_ПоляКорректируемыхПозиций = Текст4_Выбрать_ПоляКорректируемыхПозиций +
			?(Текст4_Выбрать_ПоляКорректируемыхПозиций = "", "", ",
				|	")
			+ "СвернутыеПозицииСФ." + Псевдоним + " КАК " + Псевдоним;
	КонецЦикла;
	
	// Запрошенные поля корректируемых позиций (могут отсутствовать)
	Если ВыбираемыеПоляСФ.Количество() > 0 Тогда
		Текст1_Выбрать_ПоляКорректируемыхПозиций = Текст1_Выбрать_ПоляКорректируемыхПозиций + ",";
		Текст3_Выбрать_ПоляКорректируемыхПозиций = Текст3_Выбрать_ПоляКорректируемыхПозиций + ",";
		Текст4_Выбрать_ПоляКорректируемыхПозиций = Текст4_Выбрать_ПоляКорректируемыхПозиций + ",";
	КонецЕсли;
	
	Если ПереданыТабличныеЧастиКСФ Тогда
		
		Текст0_Из = "&КСФ КАК ТЗ";
		
	ИначеЕсли ПереданМассивСсылокКСФ Тогда
		
		Текст0_Из = "Документ.КорректировочныйСчетФактураВыданный.СоставНФА	КАК ТЗ
			|ГДЕ
			|	Ссылка В(&КСФ)";
		
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("КСФ", КСФ);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Детальные позиции корректировочных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	ТЗ.Ссылка						КАК Ссылка,
	|	ТЗ.НомерСтроки					КАК НомерСтроки,
	|	
	|	// Запрошенные поля КСФ (могут отсутствовать)
	|	" + Текст0_Выбрать_ПоляКСФ + "
	|	
	|	// Ключи поиска корректируемых позиций
	|	" + Текст0_Выбрать_КлючиПоиска + "
	|ПОМЕСТИТЬ
	|	ДетальныеПозицииКСФ
	|ИЗ
	|	" + Текст0_Из + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все позиции обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	// Ключи поиска корректируемых позиций
	|	" + Текст1_Выбрать_КлючиПоиска + ",
	|	
	|	// Запрошенные поля корректируемых позиций (могут отсутствовать)
	|	" + Текст1_Выбрать_ПоляКорректируемыхПозиций + "
	|	НомерСтроки		КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ВсеПозицииСФ
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В(ВЫБРАТЬ " + ПсевдонимКлючаПоискаСФ + " ИЗ ДетальныеПозицииКСФ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Ключи для свертки позиций обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	// Ключи поиска корректируемых позиций
	|	" + Текст2_Выбрать_КлючиПоиска + ",
	|	
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	КлючиДляСверткиПозиций
	|ИЗ
	|	ВсеПозицииСФ
	|СГРУППИРОВАТЬ ПО
	|	// Ключи поиска корректируемых позиций
	|	" + Текст2_Сгруппировать_КлючиПоиска + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Свернутые позиции обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	// Ключи поиска корректируемых позиций
	|	" + Текст3_Выбрать_КлючиПоиска + ",
	|	
	|	// Запрошенные поля корректируемых позиций (могут отсутствовать)
	|	" + Текст3_Выбрать_ПоляКорректируемыхПозиций + "
	|	ВсеПозицииСФ.НомерСтроки		КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	СвернутыеПозицииСФ
	|ИЗ
	|	ВсеПозицииСФ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	КлючиДляСверткиПозиций
	|		ПО	ВсеПозицииСФ." + ПсевдонимКлючаПоискаСФ + " = КлючиДляСверткиПозиций." + ПсевдонимКлючаПоискаСФ + "
	|		И	ВсеПозицииСФ.НомерСтроки	= КлючиДляСверткиПозиций.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Корректируемые позиции обычных счетов-фактур
	|//		(Подготовка)
	|//
	|ВЫБРАТЬ
	|	ДетальныеПозицииКСФ.Ссылка			КАК Ссылка,
	|	ДетальныеПозицииКСФ.НомерСтроки		КАК НомерСтроки,
	|	
	|	// Запрошенные поля КСФ (могут отсутствовать)
	|	" + Текст4_Выбрать_ПоляКСФ + "
	|	
	|	// Запрошенные поля корректируемых позиций (могут отсутствовать)
	|	" + Текст4_Выбрать_ПоляКорректируемыхПозиций + "
	|	ДетальныеПозицииКСФ." + ПсевдонимКлючаПоискаСФ + "	КАК СсылкаСФ,
	|	СвернутыеПозицииСФ.НомерСтроки		КАК НомерСтрокиСФ
	|ПОМЕСТИТЬ
	|	КорректируемыеПозиции
	|ИЗ
	|	ДетальныеПозицииКСФ
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СвернутыеПозицииСФ
	|		// Ключи поиска корректируемых позиций
	|		ПО " + Текст4_ЛевоеСоединение + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Корректируемые позиции обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	КорректируемыеПозиции
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Номера строк КСФ, для которых не удалось определить
	|//		корректируемые позиции обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	Ссылка		КАК Ссылка,
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	КорректируемыеПозиции
	|ГДЕ
	|	НомерСтрокиСФ ЕСТЬ NULL
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [5]. Корректируемые позиции обычных счетов-фактур
	Таблица = РезультатыЗапроса[5].Выгрузить();
	
	// [6]. Номера строк КСФ, для которых не удалось определить
	//		корректируемые позиции обычных счетов-фактур
	ВыборкаОшибкиОпределенияКорректируемыхПозиций = РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КорректируемыеПозиции = Новый Структура();
	КорректируемыеПозиции.Вставить("ДополненныеТабличныеЧастиКСФ", Таблица);
	КорректируемыеПозиции.Вставить("ОшибкиОпределенияКорректируемыхПозиций", ВыборкаОшибкиОпределенияКорректируемыхПозиций);
	
	Возврат КорректируемыеПозиции;
	
КонецФункции

