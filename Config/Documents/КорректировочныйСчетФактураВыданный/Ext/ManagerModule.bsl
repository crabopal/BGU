Функция ПолучитьДанныеДокументовДляПечати(МассивОбъектов) 
	
	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("СсылкиНаДокументы",		МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросПечать.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросПечать.УстановитьПараметр("ПричиныНалогообложенияКодВидаТовара", УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияКодВидаТовара());
	ЗапросПечать.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные шапки документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка											КАК ДокСсылка,
	|	ДокументОснование.ДокументОснование				КАК ДокументРеализации,
	|	Номер											КАК Номер,
	|	Дата											КАК Дата,
	|	0												КАК НомерИсправления,
	|	НЕОПРЕДЕЛЕНО									КАК ДатаИсправления,
	|	ИсправляемыйДокумент							КАК ИсправляемыйДокумент,
	|	НомерПервичногоДокумента						КАК НомерСчетаФактуры,
	|	ДатаПервичногоДокумента							КАК ДатаСчетаФактуры,
	|	ВЫБОР
	|		КОГДА Док.ДокументОснование Ссылка Документ.ИсправительныйСчетФактураВыданный ТОГДА
	|			ВЫРАЗИТЬ(Док.ДокументОснование КАК Документ.ИсправительныйСчетФактураВыданный).НомерИсправления
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ											КАК НомерИсправленияСчетаФактуры,
	|	ВЫБОР
	|		КОГДА Док.ДокументОснование ССЫЛКА Документ.ИсправительныйСчетФактураВыданный ТОГДА
	|			ВЫРАЗИТЬ(Док.ДокументОснование КАК Документ.ИсправительныйСчетФактураВыданный).ДатаИсправления
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ											КАК ДатаИсправленияСчетаФактуры,
	|	ПричинаНалогообложения							КАК ПричинаНалогообложения,
	|	ВидЦенности										КАК ВидЦенности,
	|	ИдентификаторГосКонтракта						КАК ИдентификаторГосКонтракта,
	|	
	|	""КорректировочныйСчетФактураВыданный""					КАК ИмяДокумента,
	|	""""														КАК ИмяИсправляемогоДокумента,
	|	
	|	// Организация
	|	Док.Организация											КАК Организация,
	|	ВЫБОР
	|		КОГДА Док.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ТОГДА
	|			""""
	|		КОГДА НЕ Док.Организация.НаименованиеПолное ПОДОБНО """" ТОГДА
	|			Док.Организация.НаименованиеПолное
	|		КОГДА НЕ Док.Организация.НаименованиеСокращенное ПОДОБНО """" ТОГДА
	|			Док.Организация.НаименованиеСокращенное
	|		ИНАЧЕ
	|			Док.Организация.Представление
	|	КОНЕЦ													КАК ОрганизацияПредставление,
	|	Док.Организация.ИНН										КАК ОрганизацияИНН,
	|	Док.Организация.КПП										КАК ОрганизацияКПП,
	|	
	|	// Головная организация
	|	Док.Организация.ГоловнаяОрганизация						КАК ГоловнаяОрганизация,
	|	ВЫБОР
	|		КОГДА Док.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ТОГДА
	|			""""
	|		КОГДА НЕ Док.Организация.ГоловнаяОрганизация.НаименованиеПолное ПОДОБНО """" ТОГДА
	|			Док.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|		КОГДА НЕ Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенное ПОДОБНО """" ТОГДА
	|			Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенное
	|		ИНАЧЕ
	|			Док.Организация.ГоловнаяОрганизация.Представление
	|	КОНЕЦ													КАК ГоловнаяОрганизацияПредставление,
	|	Док.Организация.ГоловнаяОрганизация.ИНН					КАК ГоловнаяОрганизацияИНН,
	|	Док.Организация.ГоловнаяОрганизация.КПП					КАК ГоловнаяОрганизацияКПП,
	|	
	|	// Подразделение
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			Док.Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ													КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И НЕ Док.Подразделение.НаименованиеПолное ПОДОБНО """" ТОГДА
	|			Док.Подразделение.НаименованиеПолное
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА	
	|			Док.Подразделение.Представление
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ													КАК ПодразделениеПредставление,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям  ТОГДА
	|			Док.Подразделение.РегистрацияВНалоговомОргане.КПП
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ													КАК ПодразделениеКПП,
	|	
	|	// Признаки обособленного подразделения организации
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Подразделение.ОбособленноеПодразделение ТОГДА
	|			// Не выделенное на отдельный баланс
	|			2
	|		КОГДА Док.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ТОГДА
	|			// Выделенное на отдельный баланс
	|			1	
	|		ИНАЧЕ
	|			// Не является обособленным подразделением
	|			0
	|	КОНЕЦ													КАК ВидОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Подразделение.ОбособленноеПодразделение ТОГДА
	|			// Не выделенное на отдельный баланс
	|			Подразделение.ЦифровойИндекс
	|		КОГДА Док.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ТОГДА
	|			// Выделенное на отдельный баланс
	|			ЕСТЬNULL(УчетнаяПолитикаОрганизаций.НДСИндексПодразделения, 0)
	|		ИНАЧЕ
	|			// Не является обособленным подразделением
	|			0
	|	КОНЕЦ													КАК НДСИндексПодразделения,
	|	
	|	// Продавец
	|	НаименованиеПродавца							КАК Продавец,
	|	АдресПродавца									КАК АдресПродавца,
	|	ИННПродавца										КАК ИННПродавца,
	|	КПППродавца										КАК КПППродавца,
	|	
	|	// Покупатель
	|	НаименованиеПокупателя							КАК Покупатель,
	|	АдресПокупателя									КАК АдресПокупателя,
	|	ИННПокупателя									КАК ИННПокупателя,
	|	КПППокупателя									КАК КПППокупателя,
	|	
	|	// Валюта
