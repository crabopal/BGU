Функция СформироватьДвижения(СтруктураШапкиДокумента, ТабОснования, Движения, ОперацияДокумента)
	
	Если СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация0 Тогда 
		Если НЕ СформироватьДвиженияПоРН_ИсходящийНДС(СтруктураШапкиДокумента, ТабОснования, Движения) Тогда
			Возврат Ложь;
		КонецЕсли;	
	Иначе	
		Если СтруктураШапкиДокумента.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок Тогда
			Если НЕ СформироватьДвиженияПоРН_ДопЛист(СтруктураШапкиДокумента, ТабОснования, Движения) Тогда
				Возврат Ложь;
			КонецЕсли;	
		Иначе
			Если НЕ СформироватьДвиженияПоРН_КнигаПродажПокупок(СтруктураШапкиДокумента, ТабОснования, Движения) Тогда
				Возврат Ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
		СформироватьДвиженияПоРН_ВходящийНДС(СтруктураШапкиДокумента, ТабОснования, Движения, ОперацияДокумента);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвиженияПоРН_ИсходящийНДС(СтруктураШапкиДокумента, ТабОснования, Движения)
	ДвиженияИсходящийНДС = Движения.ИсходящийНДС;
	
	Для каждого ТекСтрока из ТабОснования Цикл
		Движение = ДвиженияИсходящийНДС.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, КПССчетРасчетов, СтавкаНДС, СчетРасчетов, СчетДебета, КОСГУСчетДебета,СуммаБезНДС");
		
		Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
		Движение.Период                 = СтруктураШапкиДокумента.Дата;
		Движение.ОбъектНалогообложения  = СтруктураШапкиДокумента.ДокументОснование;
		Движение.СчетФактура            = СтруктураШапкиДокумента.Ссылка;
		Движение.ДокументКорректировки  = СтруктураШапкиДокумента.ДокументКорректировки;
		Движение.СуммаНДС               = ТекСтрока.СуммаНДС;
		Движение.СуммаНДСВалютная       = ТекСтрока.СуммаНДСВалютная;
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

Функция СформироватьДвиженияПоРН_ДопЛист(СтруктураШапкиДокумента, ТабОснования, Движения)
	
	Для каждого ТекСтрока из ТабОснования Цикл
		
		Если ТекСтрока.МестоРегистрации = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			Регистр = Движения.ДополнительныеЛистыКнигиПокупок;
			ПоляСтроки = "СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная, ВидЦенности";
		Иначе
			Регистр = Движения.ДополнительныеЛистыКнигиПродаж;
			ПоляСтроки = "СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная";
		КонецЕсли;
		
		Движение = Регистр.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, КорректируемыйПериод, ПричинаНалогообложения, КФО");
		
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, ПоляСтроки);
		
		Движение.Период     	 	= СтруктураШапкиДокумента.Дата;
		Движение.СчетФактура		= СтруктураШапкиДокумента.Ссылка;
		Движение.КодВидаОперации	= СтруктураШапкиДокумента.КодВидаОперации;
		Движение.Активность			= Истина;
		
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

Функция СформироватьДвиженияПоРН_КнигаПродажПокупок(СтруктураШапкиДокумента, ТабОснования, Движения)
	
	Для каждого ТекСтрока из ТабОснования Цикл
		
		Если ТекСтрока.КомиссионнаяТорговля Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрока.МестоРегистрации = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			Регистр = Движения.КнигаПокупок;
			ПоляСтроки = "СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная, ВидЦенности";
		Иначе	
			Регистр = Движения.КнигаПродаж;
			ПоляСтроки = "СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная";
		КонецЕсли;
		
		Движение = Регистр.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КФО");
		
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, ПоляСтроки);
		
		Движение.Период				= СтруктураШапкиДокумента.Дата;
		Движение.СчетФактура	 	= СтруктураШапкиДокумента.Ссылка;
		Движение.КодВидаОперации	= СтруктураШапкиДокумента.КодВидаОперации;
		Движение.Активность			= Истина;
		
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

Процедура СформироватьДвиженияПоРН_ВходящийНДС_ПриИнициализацииДокументаДоплаты(ДокОбъект, МассивСтрок)
	
	ОперацияДокумента = ПолучитьРеквизитыТиповойОперации(ДокОбъект);
	
	СформироватьДвиженияПоРН_ВходящийНДС(ДокОбъект, ДокОбъект.СоставНФА, ДокОбъект.Движения, ОперацияДокумента, МассивСтрок);
	
КонецПроцедуры

Процедура СформироватьДвиженияПоРН_ВходящийНДС(СтруктураШапкиДокумента, ТабличнаяЧасть, Движения, ОперацияДокумента, ДополненнаяТабличнаяЧасть = Неопределено)
	
	Если ДополненнаяТабличнаяЧасть = Неопределено Тогда
	
		ДобавитьКолонкиДляПоискаДокументовДоплаты(ТабличнаяЧасть, СтруктураШапкиДокумента);
		
		ВыбираемыеПоля = ВыбираемыеПоляДляОпределенияДокументаДоплаты();
		
		ВыбираемыеПоля["КСФ"] = Неопределено;
		
		КорректируемыеПозиции = ДополнитьТабличныеЧастиКСФКорректируемымиПозициямиОбычныхСФ(ТабличнаяЧасть, ВыбираемыеПоля);
		
		ДополненнаяТабличнаяЧасть = КорректируемыеПозиции["ДополненныеТабличныеЧастиКСФ"];
		
	КонецЕсли;
	
	СледуетЗаполнитьВалютныеСуммы = УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	Курс		= ОперацияДокумента["Курс"];
	Кратность	= ОперацияДокумента["Кратность"];
	
	Для Счетчик = 1 По ТабличнаяЧасть.Количество() Цикл
		
		СтрокаТабличнойЧасти = ТабличнаяЧасть[Счетчик - 1];
		
		СтрокаКорректируемойПозиции = ДополненнаяТабличнаяЧасть[Счетчик - 1];
		
		
		НовоеДвижение = Движения.ВходящийНДС.Добавить();
		
		НовоеДвижение.Организация				= СтруктураШапкиДокумента.Организация;
		НовоеДвижение.СчетФактура				= СтрокаКорректируемойПозиции.СсылкаСФ;
		НовоеДвижение.ПричинаНалогообложения	= СтруктураШапкиДокумента.ПричинаНалогообложения;
		НовоеДвижение.ВидЦенности				= Перечисления.ВидыЦенностейНДС.Аванс;
		НовоеДвижение.КФО						= ОперацияДокумента.КФО;
		НовоеДвижение.СчетРасчетов				= СтрокаКорректируемойПозиции.СчетРасчетов;
		НовоеДвижение.КПССчетРасчетов			= СтрокаКорректируемойПозиции.КПССчетРасчетов;
		НовоеДвижение.СчетКредита				= ОперацияДокумента.Счет;
		НовоеДвижение.ОбъектНалогообложения		= СтруктураШапкиДокумента.ДокументДоплаты;
		НовоеДвижение.СтавкаНДС					= СтрокаТабличнойЧасти.СтавкаНДС;
		НовоеДвижение.ДокументКорректировки		= СтруктураШапкиДокумента.Ссылка;
		
		НовоеДвижение.СуммаБезНДС	= Окр(СтрокаТабличнойЧасти.СуммаУвеличение * Курс / Кратность, 2);
		НовоеДвижение.СуммаНДС		= Окр(СтрокаТабличнойЧасти.СуммаНДСУвеличение * Курс / Кратность, 2);
		
		Если СледуетЗаполнитьВалютныеСуммы Тогда
			НовоеДвижение.СуммаБезНДСВалютная	= СтрокаТабличнойЧасти.СуммаУвеличение;
			НовоеДвижение.СуммаНДСВалютная		= СтрокаТабличнойЧасти.СуммаНДСУвеличение;
		КонецЕсли;
		
		НовоеДвижение.Период		= СтруктураШапкиДокумента.Дата;
		НовоеДвижение.ВидДвижения	= ВидДвиженияНакопления.Приход;
		НовоеДвижение.Активность	= Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеДляИсходящегоНДСпоДокументу(СтруктураШапкиДокумента)
	
	ДокументСсылка	= СтруктураШапкиДокумента.Ссылка;
	Курс			= СтруктураШапкиДокумента.Курс;
	Кратность		= СтруктураШапкиДокумента.Кратность;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка",			ДокументСсылка);
	Запрос.УстановитьПараметр("Курс",					?(ЗначениеЗаполнено(Курс), Курс, 1));
	Запрос.УстановитьПараметр("Кратность",				?(ЗначениеЗаполнено(Кратность), Кратность, 1));
	Запрос.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки																		КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СоставНФА.ВсегоУвеличение < СоставНФА.ВсегоУменьшение ТОГДА
	|			// Данная выданная корректировка на уменьшение,
	|			// и поэтому должна быть зарегистрирована в книге покупок
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|	КОНЕЦ																			КАК МестоРегистрации,
	|	СоставНФА.СтавкаНДС																КАК СтавкаНДС,
	|	СоставНФА.Ссылка.НДСКВычету														КАК НДСКВычету,
	|	ВЫБОР
	|		КОГДА СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение > СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение ТОГДА
	|			(СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение) - (СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение)
	|		ИНАЧЕ
	|			(СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение) - (СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение)
	|	КОНЕЦ * &Курс / &Кратность														КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА СоставНФА.СуммаНДСУвеличение > СоставНФА.СуммаНДСУменьшение ТОГДА
	|			СоставНФА.СуммаНДСУвеличение - СоставНФА.СуммаНДСУменьшение
	|		ИНАЧЕ
	|			СоставНФА.СуммаНДСУменьшение - СоставНФА.СуммаНДСУвеличение
	|	КОНЕЦ * &Курс / &Кратность														КАК СуммаНДС,
	|	
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВЫБОР
	|				КОГДА СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение > СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение ТОГДА
	|					(СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение) - (СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение)
	|				ИНАЧЕ
	|					(СоставНФА.ВсегоУменьшение - СоставНФА.СуммаНДСУменьшение) - (СоставНФА.ВсегоУвеличение - СоставНФА.СуммаНДСУвеличение)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ																			КАК СуммаБезНДСВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВЫБОР
	|				КОГДА СоставНФА.СуммаНДСУвеличение > СоставНФА.СуммаНДСУменьшение ТОГДА
	|					СоставНФА.СуммаНДСУвеличение - СоставНФА.СуммаНДСУменьшение
	|				ИНАЧЕ
	|					СоставНФА.СуммаНДСУменьшение - СоставНФА.СуммаНДСУвеличение
	|			КОНЕЦ		
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ																			КАК СуммаНДСВалютная,
	|	
	|	// Для движений по ВходящийНДС
	|	НФА																				КАК НФА,
	|	СтавкаНДСДоИзменения															КАК СтавкаНДСДоИзменения,
	|	СуммаНДСДоИзменения																КАК СуммаНДСДоИзменения,
	|	СуммаНДСУвеличение																КАК СуммаНДСУвеличение,
	|	КомиссионнаяТорговля															КАК КомиссионнаяТорговля,
	|	СуммаУвеличение																	КАК СуммаУвеличение
	|ПОМЕСТИТЬ
	|	СоставНФА
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК СоставНФА
	|ГДЕ
	|	СоставНФА.Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Общая таблица для движений по всем регистрам
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	СоставНФА
	|ГДЕ
	|	(МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок) И НДСКВычету)
	|	ИЛИ
	|	МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	ТаблицаСоставНФА = Запрос.Выполнить().Выгрузить();
	
	УчетНДС.ЗаполнитьВидЦенности(ТаблицаСоставНФА, СтруктураШапкиДокумента.ПричинаНалогообложения);
	
	Возврат ТаблицаСоставНФА;
	
КонецФункции	

Процедура ЗаполнитьНаОснованииСчетФактураВыданный(Знач ДокументОснования,Объект)
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИСТИНА КАК НДСКВычету,
	|	СчетФактураВыданный.Организация,
	|	СчетФактураВыданный.Организация.ИНН КАК ИННПродавца,
	|	СчетФактураВыданный.Организация.КПП КАК КПППродавца,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация <> &ПустоеУчреждение
	|			ТОГДА ВЫБОР
	|					КОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	|						ТОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация.Представление
	|					ИНАЧЕ СчетФактураВыданный.Организация.ГоловнаяОрганизация.НаименованиеСокращенное
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СчетФактураВыданный.Организация.НаименованиеСокращенное = """"
	|					ТОГДА СчетФактураВыданный.Организация.Представление
	|				ИНАЧЕ СчетФактураВыданный.Организация.НаименованиеСокращенное
	|			КОНЕЦ
	|	КОНЕЦ КАК НаименованиеПродавца,
	|	ОрганизацияАдрес.Адрес КАК АдресПродавца,	
	|	СчетФактураВыданный.ИФО,
	|	СчетФактураВыданный.Подразделение,
	|	СчетФактураВыданный.Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|			""""
	|		// Если задано наименование для печати - используем его:
	|		КОГДА НЕ СчетФактураВыданный.Контрагент.НаименованиеСокращенное = """" ТОГДА
	|			СчетФактураВыданный.Контрагент.НаименованиеСокращенное
	|			
	|		// Для юридических лиц есть реквизит НаименованиеПолное:
	|		КОГДА СчетФактураВыданный.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			И НЕ СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|			ВЫРАЗИТЬ(СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное	КАК СТРОКА(1000))
	|			
	|		ИНАЧЕ
	|			СчетФактураВыданный.Контрагент.Наименование
	|	КОНЕЦ КАК НаименованиеПокупателя,
	|	СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.ИНН	КАК ИННПокупателя,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица) ТОГДА
	|			СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППокупателя,
	|	СчетФактураВыданный.Номер КАК НомерПервичногоДокумента,
	|	СчетФактураВыданный.Дата КАК ДатаПервичногоДокумента,
	|	КонтрагентАдрес.Адрес КАК АдресПокупателя,
	|	СчетФактураВыданный.Ссылка КАК ИсправляемыйДокумент,
	|	СчетФактураВыданный.Договор,
	|	СчетФактураВыданный.СуммаДокумента,
	|	СчетФактураВыданный.СуммаНДС,
	|	СчетФактураВыданный.ПричинаНалогообложения,
	|	СчетФактураВыданный.Руководитель,
	|	СчетФактураВыданный.ГлавныйБухгалтер,
	|	СчетФактураВыданный.ВалютаДокумента,
	|	СчетФактураВыданный.КодВидаОперации,
	|	СчетФактураВыданный.СведенияОВыбытииМаркированныхТоваров,
	|	СчетФактураВыданный.Комитент,
	|	СчетФактураВыданный.СоставНФА.(
	|		НФА,
	|		СодержаниеУслуги,
	|		ЕдиницаИзмерения,
    |		КодВидаТовара,
	|		Количество,
	|		Цена,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		Всего,
    |		СуммаАкциза КАК СуммаАкциза,
	|		СтавкаНДС КАК СтавкаНДСДоИзменения,
	|		Количество КАК КоличествоДоИзменения,
    |		Цена КАК ЦенаДоИзменения,
    |		Сумма КАК СуммаДоИзменения,
    |		СуммаНДС КАК СуммаНДСДоИзменения,
    |		Всего КАК ВсегоДоИзменения,
    |		СуммаАкциза КАК СуммаАкцизаДоИзменения,
    |		ИдентификаторСтроки,
    |		СведенияОбъемноСортовогоУчетаМаркированныхТоваров,
	|		КомиссионнаяТорговля КАК КомиссионнаяТорговля,
    |		СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаДоИзменения
	|	)  Как ОснованиеСоставНФА,
	|	СчетФактураВыданный.ПлатежноРасчетныеДокументы.(
    |		ДатаДокумента	КАК ДатаДокумента,
    |		НомерДокумента	КАК НомерДокумента
	|	) КАК ОснованиеПлатежноРасчетныеДокументы,
	|	СчетФактураВыданный.СчетаФактурыОтКомиссионера.(
	|		ПокупательСФ		КАК ПокупательСФ,
	|		Грузополучатель		КАК Грузополучатель,
	|		ДатаСФ				КАК ДатаСФ,
	|		НомерСФ				КАК НомерСФ,
	|		ВЫБОР
	|			КОГДА ПокупательСФ = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|				""""
	|			КОГДА НЕ ПокупательСФ.НаименованиеСокращенное = """" ТОГДА
	|				ПокупательСФ.НаименованиеСокращенное
	|			КОГДА ПокупательСФ.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|				И НЕ ПокупательСФ.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|				ВЫРАЗИТЬ(ПокупательСФ.ЮридическоеФизическоеЛицо.НаименованиеПолное	КАК СТРОКА(1000))
	|			ИНАЧЕ
	|				ПокупательСФ.Наименование
	|		КОНЕЦ КАК ПродавецКомиссионераНаименование,
	|		ПокупательСФ.ЮридическоеФизическоеЛицо.ИНН	КАК ИННПокупателяКомиссионера,
	|		ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(ПокупательСФ.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица) ТОГДА
	|				ПокупательСФ.ЮридическоеФизическоеЛицо.КПП
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК КПППокупателяКомиссионера
	|	) КАК ОснованиеСчетаФактурыОтКомиссионера,
    |	СчетФактураВыданный.КодыУпаковокМаркируемойПродукции.(
    |		НомерУпаковки КАК НомерУпаковки,
    |		ИдентификаторСтроки КАК ИдентификаторСтроки,
    |		ТипУпаковки КАК ТипУпаковки
	|	) КАК ОснованиеКодыУпаковокМаркируемойПродукции
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЮридическиеЛицаКонтактнаяИнформация.Представление КАК Адрес,
	|			ЮридическиеЛица.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица.КонтактнаяИнформация КАК ЮридическиеЛицаКонтактнаяИнформация
	|				ПО (ЮридическиеЛицаКонтактнаяИнформация.Ссылка = ЮридическиеЛица.Ссылка)
	|		ГДЕ
	|			ЮридическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты)) КАК КонтрагентАдрес
	|		ПО СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.Ссылка = КонтрагентАдрес.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОрганизацииКонтактнаяИнформация.Ссылка КАК Ссылка,
	|			ОрганизацииКонтактнаяИнформация.Представление КАК Адрес
	|		ИЗ
	|			Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	|		ГДЕ
	|			ОрганизацииКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты)) КАК ОрганизацияАдрес
	|		ПО СчетФактураВыданный.Организация.Ссылка = ОрганизацияАдрес.Ссылка
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ДокументОснования);
	Запрос.УстановитьПараметр("Дата",ДокументОснования.Дата);
	Запрос.УстановитьПараметр("ПустоеУчреждение", Справочники.Организации.ПустаяСсылка());
	
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	
	Объект.СоставНФА.Очистить();
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Объект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	
	Если Основание.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку Тогда
		СчетаФактурыОтКомиссионера = Основание.ОснованиеСчетаФактурыОтКомиссионера.Выбрать();
		Если СчетаФактурыОтКомиссионера.Следующий() Тогда
			ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			
			Объект.АдресПродавца = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				СчетаФактурыОтКомиссионера.ПокупательСФ, ВидКИАдрес, ДокументОснования.Дата);
			Объект.НаименованиеПродавца = СчетаФактурыОтКомиссионера.ПродавецКомиссионераНаименование;
			Объект.ИННПродавца = СчетаФактурыОтКомиссионера.ИННПокупателяКомиссионера;
			Объект.КПППродавца = СчетаФактурыОтКомиссионера.КПППокупателяКомиссионера;
			Объект.Продавец = СчетаФактурыОтКомиссионера.ПокупательСФ;
		КонецЕсли;
	КонецЕсли;
	
	// Ответственные лица
	УстановитьОтветственныхЛиц(Объект);
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт.
	НФА = Основание.ОснованиеСоставНФА.Выбрать();
	Пока НФА.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, НФА);
		
		Если НЕ ЗначениеЗаполнено(СтрокаНФА["ЕдиницаИзмерения"]) Тогда
			Если ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = СтрокаНФА.НФА.ЕдиницаИзмерения;
			ИначеЕсли ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = ЕдИзмШт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Объект.Дата = ТекущаяДатаСеанса();
	
	Если Объект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
		
		ДокументыДоплаты = Документы.КорректировочныйСчетФактураВыданный.ПодобратьДокументыДоплаты(Объект);
		
		Если ДокументыДоплаты.Количество() = 1 Тогда
			
			Объект["ДокументДоплаты"] = ДокументыДоплаты[0].Значение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Объект["КодВидаОперацииКомиссия"] = "18";
	
	Выборка = Основание.ОснованиеПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПлатежноРасчетныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Выборка = Основание.ОснованиеКодыУпаковокМаркируемойПродукции.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПРоцедуры

Процедура ЗаполнитьНаОснованииКорректировочныйСчетФактураВыданный(Знач ДокументОснования, Объект)
	
	ОбъектОснования = ДокументОснования.ПолучитьОбъект();
	
	Объект.СоставНФА.Очистить();
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Объект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ЗаполнитьЗначенияСвойств(Объект, ОбъектОснования,,"Номер,Проведен,ПометкаУдаления,СоставНФА,ПлатежноРасчетныеДокументы,КодыУпаковокМаркируемойПродукции");
	
	Объект.ДатаПервичногоДокумента	= ОбъектОснования.Дата;
	Объект.НомерПервичногоДокумента	= ОбъектОснования.Номер;
	Объект.ДокументОснование		= ОбъектОснования.Ссылка;
	Объект.ДокументКорректировки	= Неопределено;
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("СуммаУвеличение", 0);
	ОчищающаяСтруктура.Вставить("СуммаУменьшение", 0);
	ОчищающаяСтруктура.Вставить("СуммаНДСУвеличение", 0);
	ОчищающаяСтруктура.Вставить("СуммаНДСУменьшение", 0);
	ОчищающаяСтруктура.Вставить("ВсегоУвеличение", 0);
	ОчищающаяСтруктура.Вставить("ВсегоУменьшение", 0);
	ОчищающаяСтруктура.Вставить("СуммаАкцизаУвеличение", 0);
	ОчищающаяСтруктура.Вставить("СуммаАкцизаУменьшение", 0);

	Для Каждого СтрокаТаблицы Из ОбъектОснования.СоставНФА Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаНФА, СтрокаТаблицы);
		
		ЗаполнитьЗначенияСвойств(СтрокаНФА, ОчищающаяСтруктура);
		
		СтрокаНФА.КоличествоДоИзменения = СтрокаНФА.Количество;
		СтрокаНФА.ЦенаДоИзменения		= СтрокаНФА.Цена;
		СтрокаНФА.СуммаДоИзменения		= СтрокаНФА.Сумма;
		СтрокаНФА.СтавкаНДСДоИзменения	= СтрокаНФА.СтавкаНДС;
		СтрокаНФА.СуммаНДСДоИзменения	= СтрокаНФА.СуммаНДС;
		СтрокаНФА.ВсегоДоИзменения		= СтрокаНФА.Всего;
		СтрокаНФА.СуммаАкцизаДоИзменения= СтрокаНФА.СуммаАкциза;
	КонецЦикла;
	
	Объект.ПлатежноРасчетныеДокументы.Загрузить(ОбъектОснования.ПлатежноРасчетныеДокументы.Выгрузить());
	
	Объект.КодыУпаковокМаркируемойПродукции.Загрузить(ОбъектОснования.КодыУпаковокМаркируемойПродукции.Выгрузить());
	
КонецПРоцедуры

Процедура ЗаполнитьНаОснованииИсправительныйСчетФактураВыданный(Знач ДокументОснования,Объект)
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ИСТИНА КАК НДСКВычету,
	               |	СчетФактураВыданный.Организация,
	               |	СчетФактураВыданный.ИФО,
	               |	СчетФактураВыданный.Подразделение,
	               |	СчетФактураВыданный.Контрагент,
	               |	СчетФактураВыданный.Договор,
	               |	СчетФактураВыданный.СуммаДокумента,
	               |	СчетФактураВыданный.СуммаНДС,
	               |	СчетФактураВыданный.ПричинаНалогообложения,
	               |	СчетФактураВыданный.АдресПродавца,
	               |	СчетФактураВыданный.ИННПродавца,
	               |	СчетФактураВыданный.КПППродавца,
	               |	СчетФактураВыданный.НаименованиеПокупателя,
	               |	СчетФактураВыданный.АдресПокупателя,
	               |	СчетФактураВыданный.ИННПокупателя,
	               |	СчетФактураВыданный.КПППокупателя,
	               |	СчетФактураВыданный.ФИОРуководителя,
	               |	СчетФактураВыданный.ФИОГлавногоБухгалтера,
	               |	СчетФактураВыданный.ИсправляемыйДокумент КАК ИсправляемыйДокумент,
	               |	СчетФактураВыданный.НаименованиеГрузоотправителя,
	               |	СчетФактураВыданный.АдресГрузоотправителя,
	               |	СчетФактураВыданный.НаименованиеГрузополучателя,
	               |	СчетФактураВыданный.АдресГрузополучателя,
	               |	СчетФактураВыданный.ВалютаДокумента,
					|	КодВидаОперации,
	               |	СчетФактураВыданный.СведенияОВыбытииМаркированныхТоваров,
	               |	СчетФактураВыданный.СоставНФА.(
	               |		НФА,
	               |		СодержаниеУслуги,
	               |		ЕдиницаИзмерения,
	               |		КодВидаТовара,
	               |		КоличествоДоКорректировки,
	               |		Количество,
	               |		Количество КАК КоличествоДоИзменения,
	               |		ЦенаДоКорректировки,
	               |		Цена,
	               |		Цена КАК ЦенаДоИзменения,
	               |		СуммаДоКорректировки,
	               |		Сумма,
	               |		Сумма КАК СуммаДоИзменения,
	               |		СтавкаНДСДоКорректировки,
	               |		СтавкаНДС,
	               |		СтавкаНДС КАК СтавкаНДСДоИзменения,
	               |		СуммаНДСДоКорректировки,
	               |		СуммаНДС,
	               |		СуммаНДС КАК СуммаНДСДоИзменения,
	               |		ВсегоДоКорректировки,
	               |		Всего,
	               |		Всего КАК ВсегоДоИзменения,
	               |		ИдентификаторСтроки,
	               |		СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |	) КАК ОснованиеСоставНФА,
					|	СчетФактураВыданный.ПлатежноРасчетныеДокументы.(
				    |		ДатаДокумента	КАК ДатаДокумента,
				    |		НомерДокумента	КАК НомерДокумента
					|	) КАК ОснованиеПлатежноРасчетныеДокументы,
				    |	СчетФактураВыданный.КодыУпаковокМаркируемойПродукции.(
				    |		НомерУпаковки КАК НомерУпаковки,
				    |		ИдентификаторСтроки КАК ИдентификаторСтроки,
				    |		ТипУпаковки КАК ТипУпаковки
					|	) КАК ОснованиеКодыУпаковокМаркируемойПродукции
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ДокументОснования);
	
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	Объект.СоставНФА.Очистить();
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт.
	НФА = Основание.ОснованиеСоставНФА.Выбрать();
	Пока НФА.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, НФА);
		
		Если НЕ ЗначениеЗаполнено(СтрокаНФА["ЕдиницаИзмерения"]) Тогда
			Если ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = СтрокаНФА.НФА.ЕдиницаИзмерения;
			ИначеЕсли ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = ЕдИзмШт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Выборка = Основание.ОснованиеПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПлатежноРасчетныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Выборка = Основание.ОснованиеКодыУпаковокМаркируемойПродукции.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПРоцедуры

// НакладнаяНаРеализациюТорг12

Процедура ЗаполнитьНаОснованииНакладнаяНаРеализациюТорг12(Знач ДокументОснования, Объект, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры = "ТолькоДозаполнитьПоСчетуФактуре" Тогда
		ДозаполнитьПоСчетуФактуре(Объект, Объект.ДокументОснование);
		
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка", ДокументОснования);
	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка							КАК ДокументКорректировки,
	|	Дата												КАК Дата,
	|	Организация											КАК Организация,
	|	ИФО													КАК ИФО,
	|	Подразделение										КАК Подразделение,
	|	Контрагент											КАК Контрагент,
	|	Договор												КАК Договор,
	|	ВалютаДокумента										КАК ВалютаДокумента,
	|	КФО													КАК КФО,
	|	СведенияОВыбытииМаркированныхТоваров				КАК СведенияОВыбытииМаркированныхТоваров,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.РеализацияЛомаШкур) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.РеализацияЛом)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИдентификаторСтроки								КАК ИдентификаторСтроки,
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	
	|	// До корректировки
	|	СтавкаНДС										КАК СтавкаНДСДоИзменения,
	|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И СуммаДоКорректировки <> 0 ТОГДА
	|			ЦенаДоКорректировки - ВЫРАЗИТЬ(СуммаНДСДоКорректировки * (Цена/СуммаДоКорректировки) КАК Число(15,2)) 
	|		ИНАЧЕ
	|			ЦенаДоКорректировки
	|	КОНЕЦ											КАК ЦенаДоИзменения,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаДоКорректировки - СуммаНДСДоКорректировки
	|		ИНАЧЕ
	|			СуммаДоКорректировки
	|	КОНЕЦ											КАК СуммаДоИзменения,
	|	СуммаНДСДоКорректировки							КАК СуммаНДСДоИзменения,
	|	ВсегоДоКорректировки							КАК ВсегоДоИзменения,
	|	
	|	// После корректировки
	|	СтавкаНДС										КАК СтавкаНДС,
	|	Количество										КАК Количество,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И Сумма <> 0 ТОГДА
	|			Цена - ВЫРАЗИТЬ(СуммаНДС * (Цена/Сумма) КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ											КАК Цена,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Сумма,
	|	СуммаНДС										КАК СуммаНДС,
	|	Всего											КАК Всего,
	|	СведенияОбъемноСортовогоУчетаМаркированныхТоваров											КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""""												КАК ИдентификаторСтроки,
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	
	|	// До корректировки
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДСДоИзменения,
	|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА КоличествоДоКорректировки <> 0 ТОГДА
	|			ВЫРАЗИТЬ(СуммаДоКорректировки / КоличествоДоКорректировки КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			СуммаДоКорректировки
	|	КОНЕЦ											КАК ЦенаДоИзменения,
	|	СуммаДоКорректировки							КАК СуммаДоИзменения,
	|	0												КАК СуммаНДСДоИзменения,
	|	СуммаДоКорректировки							КАК ВсегоДоИзменения,
	|	
	|	// После корректировки
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДС,
	|	Количество										КАК Количество,
	|	ВЫБОР
	|		КОГДА Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ(Сумма / Количество КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Цена,
	|	Сумма											КАК Сумма,
	|	0												КАК СуммаНДС,
	|	Сумма											КАК Всего,
	|	""""											КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.ВозвратнаяТара
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные табличной части КодыУпаковокМаркируемойПродукции
	|//
	|ВЫБРАТЬ
	|	ИдентификаторСтроки	КАК ИдентификаторСтроки,
	|	НомерУпаковки		КАК НомерУпаковки,
	|	ТипУпаковки			КАК ТипУпаковки
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.КодыУпаковокМаркируемойПродукции
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Данные шапки
	Шапка = РезультатыЗапроса[0].Выгрузить()[0];
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	РезультатыПоиска = УчетНДС.НайтиПредыдущийСчетФактуруРеализации(ДокументОснования);
	
	Если РезультатыПоиска <> Неопределено Тогда
		ДозаполнитьПоСчетуФактуре(Объект, РезультатыПоиска.Ссылка);
	КонецЕсли;
	
	// [1]. Данные табличной части СоставНФА
	Объект.СоставНФА.Загрузить(РезультатыЗапроса[1].Выгрузить());
	
	Для Каждого СтрокаТаблицы Из Объект.СоставНФА Цикл
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Сумма");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "СуммаНДС");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Всего");
	КонецЦикла;
	
	// [2]. Данные табличной части КодыУпаковокМаркируемойПродукции
	Таблица = РезультатыЗапроса[2].Выгрузить();
	Объект.КодыУпаковокМаркируемойПродукции.Очистить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	// Ответственные лица
	УстановитьОтветственныхЛиц(Объект);
	
КонецПроцедуры

Функция ЗаполнитьНаОснованииНакладнаяНаРеализациюТорг12_ТиповаяОперация(Знач ДокументОснования) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснования, "КФО");
	
	// Основание
	ТиповаяОперацияОснования		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументОснования);
	СтруктураРеквизитовОснования	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(ТиповаяОперацияОснования);
	РеквизитыОперацииОснования		= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснования, СтруктураРеквизитовОснования);
	
	// Заполняемый документ
	ТиповаяОперацияСсылка = Справочники.ТиповыеОперации.КорректировочныйСчетФактураВыданный_КорректировкаНДС;
	
	РеквизитыТиповойОперации = Новый Структура();
	РеквизитыТиповойОперации.Вставить("КФО",	ЗначенияРеквизитов.КФО);
	РеквизитыТиповойОперации.Вставить("КПС",	РеквизитыОперацииОснования.КДБ);
	РеквизитыТиповойОперации.Вставить("Счет",	РеквизитыОперацииОснования.СчетДоходов);
	РеквизитыТиповойОперации.Вставить("КЭК",	РеквизитыОперацииОснования.КЭКДоходов);
	
	ТиповаяОперация = Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",		ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("Реквизиты",	РеквизитыТиповойОперации);
	
	Возврат ТиповаяОперация;
	
КонецФункции

// НакладнаяНаОтпускМ15

Процедура ЗаполнитьНаОснованииНакладнаяНаОтпускМ15(Знач ДокументОснования, Объект, ДополнительныеПараметры)
	
