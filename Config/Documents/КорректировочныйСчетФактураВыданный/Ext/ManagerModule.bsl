Функция ВыбираемыеПоляДляОпределенияДокументаДоплаты() Экспорт
	
	ВыбираемыеПоляСФ = Новый Структура();
	
	//						  Псевдоним				Путь относительно табличной части в запросе
	ВыбираемыеПоляСФ.Вставить("СчетРасчетов",		"СчетРасчетов");
	ВыбираемыеПоляСФ.Вставить("КПССчетРасчетов",	"КПССчетРасчетов");
	ВыбираемыеПоляСФ.Вставить("СчетВычетКт",		"СчетВычетКт");
	ВыбираемыеПоляСФ.Вставить("КФО",				"Ссылка.КФО"); // из шапки
	ВыбираемыеПоляСФ.Вставить("ДатаСФ",				"Ссылка.Дата"); // из шапки
	
	
	ВыбираемыеПоляКСФ = Новый Структура();
	
	//						  Псевдоним					Путь относительно табличной части в запросе
	ВыбираемыеПоляКСФ.Вставить("Контрагент",			"Ссылка.Контрагент"); // из шапки
	ВыбираемыеПоляКСФ.Вставить("Договор",				"Ссылка.Договор"); // из шапки
	ВыбираемыеПоляКСФ.Вставить("СуммаНДСУвеличение",	"СуммаНДСУвеличение");
	
	
	ВыбираемыеПоля = Новый Структура();
	ВыбираемыеПоля.Вставить("СФ",	ВыбираемыеПоляСФ);
	ВыбираемыеПоля.Вставить("КСФ",	ВыбираемыеПоляКСФ);
	
	Возврат ВыбираемыеПоля;
	
КонецФункции

Функция ПолучитьВыборкиДокументовДоплатыИОшибок(Параметр) Экспорт
	
	Перем ВыбираемыеПоляКСФ;
	
	ПереданыТабличныеЧастиКСФ = (ТипЗнч(Параметр) = Тип("ТаблицаЗначений"));
	
	ПереданМассивСсылокКСФ = (ТипЗнч(Параметр) = Тип("Массив"));
	
	Если НЕ ПереданыТабличныеЧастиКСФ И НЕ ПереданМассивСсылокКСФ Тогда
		
		ВызватьИсключение НСтр("ru='Недопустимый тип параметра ""Параметр"". Ожидается Массив (ссылки на документы) или ТаблицаЗначений (табличные части документов)'");
		
	КонецЕсли;
	
	ВыбираемыеПоля = ВыбираемыеПоляДляОпределенияДокументаДоплаты();
	
	Если ПереданыТабличныеЧастиКСФ Тогда
		ВыбираемыеПоля["КСФ"] = Неопределено;
	КонецЕсли;
	
	КорректируемыеПозиции = ДополнитьТабличныеЧастиКСФКорректируемымиПозициямиОбычныхСФ(Параметр, ВыбираемыеПоля);
		
	ДополненныеТабличныеЧастиКСФ = КорректируемыеПозиции["ДополненныеТабличныеЧастиКСФ"];
	
	//
	// При наличии устаревших счетов расчетов в корректируемых позициях
	// заменяем их на действующие счета расчетов
	//
	
	ЗаменитьУстаревшиеСчетаРасчетовНаНовые64н(ДополненныеТабличныеЧастиКСФ);
	
	//
	// Ищем документы доплаты
	//
	
	ВыборкаДокументыДоплаты = ПолучитьВыборкуДокументовДоплаты(ДополненныеТабличныеЧастиКСФ);
	
	Выборки = Новый Структура();
	
	// Группировки: Ссылка, НомерСтроки
	Выборки.Вставить("ДокументыДоплаты", ВыборкаДокументыДоплаты);
	
	// Группировки: Ссылка
	Выборки.Вставить("ОшибкиОпределенияКорректируемыхПозиций", КорректируемыеПозиции["ОшибкиОпределенияКорректируемыхПозиций"]);
	
	Выборки.Вставить("ДополненныеТабличныеЧастиКСФ", ДополненныеТабличныеЧастиКСФ);
	
	Возврат Выборки;
	
КонецФункции

Функция ПолучитьТаблицуКлючиПоискаКорректируемыхПозиций()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	// Пути к данным относительно табличных частей документов при поиске из запроса.
	КлючиПоиска = Новый ТаблицаЗначений();
	КлючиПоиска.Колонки.Добавить("ПутьКСФ",	ТипСтрока);
	КлючиПоиска.Колонки.Добавить("ПутьСФ",	ТипСтрока);
	
	// Самым первым полем (обязательно) указываем ссылку на обычный счет-фактуру
	
	НоваяСтрока = КлючиПоиска.Добавить();
	НоваяСтрока["ПутьКСФ"]	= "Ссылка.ДокументОснование";
	НоваяСтрока["ПутьСФ"]	= "Ссылка";
	
	// Остальные поля указываем в произвольном порядке
	
	НоваяСтрока = КлючиПоиска.Добавить();
	НоваяСтрока["ПутьКСФ"]	= "НФА";
	НоваяСтрока["ПутьСФ"]	= "НФА";
	
	НоваяСтрока = КлючиПоиска.Добавить();
	НоваяСтрока["ПутьКСФ"]	= "СтавкаНДСДоИзменения";
	НоваяСтрока["ПутьСФ"]	= "СтавкаНДС";
	
	НоваяСтрока = КлючиПоиска.Добавить();
	НоваяСтрока["ПутьКСФ"]	= "СуммаНДСДоИзменения";
	НоваяСтрока["ПутьСФ"]	= "СуммаНДС";
	
	Возврат КлючиПоиска;
	
КонецФункции

Функция ПолучитьВыборкуДокументовДоплаты(ДополненныеТабличныеЧастиКСФ)
	
	МассивКонтрагенты			= ДополненныеТабличныеЧастиКСФ.ВыгрузитьКолонку("Контрагент");
	МассивДоговоры				= ДополненныеТабличныеЧастиКСФ.ВыгрузитьКолонку("Договор");
	СписокДокументовСФВыданный	= ДополненныеТабличныеЧастиКСФ.ВыгрузитьКолонку("СсылкаСФ");
	
	НаДату = Неопределено;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СчетАП",						БухгалтерскийУчет.СчетПоКоду("АП", НаДату));
	ЗапросПоиск.УстановитьПараметр("Счет20500",						БухгалтерскийУчет.СчетПоКоду("205.00", НаДату));
	ЗапросПоиск.УстановитьПараметр("ТипыДокументовДоплаты", 		ПолучитьТипыДокументовДоплаты());
	ЗапросПоиск.УстановитьПараметр("МассивКонтрагенты", 			МассивКонтрагенты);
	ЗапросПоиск.УстановитьПараметр("МассивДоговоры", 				МассивДоговоры);
	ЗапросПоиск.УстановитьПараметр("СписокДокументовСФВыданный",	СписокДокументовСФВыданный);
	ЗапросПоиск.УстановитьПараметр("ТабличныеЧастиКСФ", 			ДополненныеТабличныеЧастиКСФ);
	ЗапросПоиск.УстановитьПараметр("ТребоватьСовпаденияКПСДоплаты", Истина);
	ЗапросПоиск.УстановитьПараметр("ПроверятьВеличинуСуммыДоплаты", Истина);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличные части КСФ, дополненные корректируемыми позициями обычных счетов-фактур
	|//
	|ВЫБРАТЬ
	|	ТЗ.Ссылка				КАК Ссылка,
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.Контрагент			КАК Контрагент,
	|	ТЗ.Договор				КАК Договор,
	|	ТЗ.СчетРасчетов			КАК СчетРасчетов,
	|	ТЗ.КПССчетРасчетов		КАК КПССчетРасчетов,
	|	ТЗ.КФО					КАК КФО,
	|	ТЗ.СуммаНДСУвеличение	КАК СуммаНДСУвеличение,
	|	ТЗ.ДатаСФ				КАК ДатаСФ
	|ПОМЕСТИТЬ
	|	ТабличныеЧастиКСФ
	|ИЗ
	|	&ТабличныеЧастиКСФ	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже используемые документы оплаты, по которым выставлены счета-фактуры
	|//
	|ВЫБРАТЬ
	|	ДокументОснование	КАК ДокументОплаты,
	|	Ссылка				КАК СчетФактура
	|ПОМЕСТИТЬ
	|	ОтфактуренныеАвансыПолученные
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	Ссылка В(&СписокДокументовСФВыданный)
	|	И ТИПЗНАЧЕНИЯ(ДокументОснование) В(&ТипыДокументовДоплаты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Авансы полученные из движений документов оплаты (КЭК)
	|//
	|ВЫБРАТЬ
	|	Период												КАК Период,
	|	Регистратор											КАК Регистратор,
	|	КФО													КАК КФО,
	|	ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты)	КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры)		КАК Договор,
	|	КПСКт												КАК КПС,
	|	КЭККт												КАК КЭК,
	|	ВЫБОР
	|		КОГДА ВалютаКт = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ИЛИ ВалютаКт ЕСТЬ NULL 
	|			ИЛИ ВалютаКт = НЕОПРЕДЕЛЕНО ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|			ВалютнаяСуммаКт
	|	КОНЕЦ												КАК Сумма
	|ПОМЕСТИТЬ
	|	АвансыПолученныеКЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		СчетКт В (&СчетАП)
	|		И (ВЫРАЗИТЬ(СубконтоКт1	КАК Справочник.Контрагенты)) В(&МассивКонтрагенты)
	|		И (ВЫРАЗИТЬ(СубконтоКт2	КАК Справочник.Договоры)) В(&МассивДоговоры)
	|		И ТИПЗНАЧЕНИЯ(Регистратор) В(&ТипыДокументовДоплаты)
	|		И Регистратор НЕ В(ВЫБРАТЬ ДокументОплаты Из ОтфактуренныеАвансыПолученные)
	|	)
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Таблица КЭК
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Период	КАК Период,
	|	КЭК		КАК КЭК
	|ПОМЕСТИТЬ
	|	ТаблицаКЭК
	|ИЗ
	|	АвансыПолученныеКЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Все счета расчетов, соответствующие обнаруженным КЭК
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаКЭК.Период												КАК Период,
	|	СоответствияАналитическихСчетовКЭК.КЭК							КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет							КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия	КАК ДатаОкончанияДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетов
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаКЭК
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = ТаблицаКЭК.КЭК
	|ГДЕ
	|	СоответствияАналитическихСчетовКЭК.Счет В ИЕРАРХИИ(&Счет20500)
	|	И	СоответствияАналитическихСчетовКЭК.КЭК В (ВЫБРАТЬ КЭК ИЗ ТаблицаКЭК)
	|	И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ТаблицаКЭК.Период
	|	И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ТаблицаКЭК.Период <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Выбираемые даты счетов расчетов
	|//
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетов
	|ИЗ
	|	ВсеСчетаРасчетов
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|;
	|
	|/////////////////////////////////////////////////////////////////////////////////
	|// [6]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетов.Период				КАК Период,
	|	ВсеСчетаРасчетов.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетов.Счет)		КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетов
	|ИЗ
	|	ВсеСчетаРасчетов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетов
	|		ПО	ВсеСчетаРасчетов.КЭК = ВыбираемыеДатыСчетовРасчетов.КЭК
	|		И	ВсеСчетаРасчетов.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетов.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетов.Период,
	|	ВсеСчетаРасчетов.КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Авансы полученные из движений документов оплаты (КЭК преобразован в счет расчетов)
	|//
	|ВЫБРАТЬ
	|	АвансыПолученныеКЭК.*,
	|	СчетаРасчетов.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	АвансыПолученныеСчет
	|ИЗ
	|	АвансыПолученныеКЭК
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетов
	|		ПО	АвансыПолученныеКЭК.Период	= СчетаРасчетов.Период
	|		И	АвансыПолученныеКЭК.КЭК		= СчетаРасчетов.КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. Найденные документы доплаты для каждой строки табличных частей КСФ
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличныеЧастиКСФ.Ссылка			КАК Ссылка,
	|	ТабличныеЧастиКСФ.НомерСтроки		КАК НомерСтроки,
	|	АвансыПолученныеСчет.Регистратор	КАК ДокументДоплаты,
	|	0									КАК КоличествоРазличныхДокументовДоплаты // Поле имеет смысл только для итогов
	|ИЗ
	|	ТабличныеЧастиКСФ
	|	ЛЕВОЕ СОЕДИНЕНИЕ	АвансыПолученныеСчет
	|		ПО	ТабличныеЧастиКСФ.Контрагент	= АвансыПолученныеСчет.Контрагент
	|		И	ТабличныеЧастиКСФ.Договор		= АвансыПолученныеСчет.Договор
	|		И	ТабличныеЧастиКСФ.СчетРасчетов	= АвансыПолученныеСчет.Счет
	|		И	ТабличныеЧастиКСФ.КФО			= АвансыПолученныеСчет.КФО
	|		И	ТабличныеЧастиКСФ.ДатаСФ	   <= АвансыПолученныеСчет.Период
	|		И ВЫБОР
	|			КОГДА &ТребоватьСовпаденияКПСДоплаты ТОГДА
	|				ТабличныеЧастиКСФ.КПССчетРасчетов	= АвансыПолученныеСчет.КПС
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПроверятьВеличинуСуммыДоплаты ТОГДА
	|				ТабличныеЧастиКСФ.СуммаНДСУвеличение <= АвансыПолученныеСчет.Сумма
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|ИТОГИ
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументДоплаты) = 1 ТОГДА
	|			МИНИМУМ(ДокументДоплаты)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК ДокументДоплаты,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументДоплаты)	КАК КоличествоРазличныхДокументовДоплаты
	|ПО
	|	Ссылка,
	|	НомерСтроки
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ПолучитьТипыДокументовДоплаты()
	
	ОписаниеТипов = Метаданные.Документы.КорректировочныйСчетФактураВыданный.Реквизиты.ДокументДоплаты.Тип;
	
	Возврат ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОписаниеТипов.Типы());
	
КонецФункции

Процедура ЗаменитьУстаревшиеСчетаРасчетовНаНовые64н(ДополненныеТабличныеЧастиКСФ)
	
	// Выполняем замену счетов, аналогичную замене при переходе на 64н
	//
	// (Устаревший счет 205.00 + КФО) --> (Действующий счет 205.00)
	
	НаДату = '20190101';
	
	СчетаРасчетов = ДополненныеТабличныеЧастиКСФ.ВыгрузитьКолонку("СчетРасчетов");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СчетаРасчетов",	СчетаРасчетов);
	ЗапросПоиск.УстановитьПараметр("НаДату",		НаДату);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В(&СчетаРасчетов)
	|	И ДатаОкончанияДействия <> ДАТАВРЕМЯ(1,1,1) И ДатаОкончанияДействия < &НаДату";
	
	УстаревшиеСчета = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если УстаревшиеСчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонЗаменыСчетов = ПолучитьШаблонЗаменыСчетов64н(УстаревшиеСчета.ВыгрузитьКолонку("Ссылка"));
	
	Если ШаблонЗаменыСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("КФО, СчетРасчетов");
	
	Для Каждого СтрокаТаблицы Из ДополненныеТабличныеЧастиКСФ Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрокШаблона = ШаблонЗаменыСчетов.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаШаблона Из МассивСтрокШаблона Цикл
			// В шаблоне найдется максимум одна строка
			
			СтрокаТаблицы["СчетРасчетов"] = СтрокаШаблона["СчетПриемник"];
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьШаблонЗаменыСчетов64н(СчетаИсточники)
	
	// Берем типовой шаблон замены устаревших счетов 205.00
	// из документа ПереносОстатков64нРасчеты
	//
	// Оставляем в шаблоне лишь правила замены указанных счетов
	
	ТаблицаШаблон = Документы.ПереносОстатков64нРасчеты.ШаблонЗаменыСчетовиКОСГУ();
	
	ИменаКолонок = "КФО,СчетИсточник,СчетПриемник";
	
	ТаблицаШаблон = ТаблицаШаблон.Скопировать(, ИменаКолонок);
	
	КоличествоСтрок = ТаблицаШаблон.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		ИндексСтроки = КоличествоСтрок - НомерСтроки;
		
		СтрокаТаблицы = ТаблицаШаблон[ИндексСтроки];
		
		СтрокаШаблонаПригодится = (СчетаИсточники.Найти(СтрокаТаблицы["СчетИсточник"]) <> Неопределено);
		
		Если НЕ СтрокаШаблонаПригодится Тогда
			ТаблицаШаблон.Удалить(ИндексСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаШаблон.Свернуть(ИменаКолонок);
	
	ТаблицаШаблон.Колонки["СчетИсточник"].Имя = "СчетРасчетов";
	
	Возврат ТаблицаШаблон;
	
КонецФункции

Функция ПодобратьДокументыДоплаты(ДокументОбъект) Экспорт
	
	ТабличнаяЧастьКСФ = ДокументОбъект["СоставНФА"].Выгрузить(, "НомерСтроки, НФА, СтавкаНДСДоИзменения, СуммаНДСДоИзменения, СуммаНДСУвеличение");
	
	ДобавитьКолонкиДляПоискаДокументовДоплаты(ТабличнаяЧастьКСФ, ДокументОбъект);
	
	ВыборкиДокументовДоплатыИОшибок = Документы.КорректировочныйСчетФактураВыданный.ПолучитьВыборкиДокументовДоплатыИОшибок(ТабличнаяЧастьКСФ);
	
	ВыборкаДокументыДоплаты = ВыборкиДокументовДоплатыИОшибок["ДокументыДоплаты"];
	
	МассивДокументов = Новый Массив();
	
	// Всего одна строка
	Пока ВыборкаДокументыДоплаты.Следующий() Цикл
		
		ВыборкаГруппировкаНомерСтроки = ВыборкаДокументыДоплаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппировкаНомерСтроки.Следующий() Цикл
			
			Выборка = ВыборкаГруппировкаНомерСтроки.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ДокументДоплаты = Выборка["ДокументДоплаты"];
				
				Если НЕ ЗначениеЗаполнено(ДокументДоплаты) Тогда
					Продолжить;
				КонецЕсли;
				
				УжеДобавлен = (МассивДокументов.Найти(ДокументДоплаты) <> Неопределено);
				
				Если УжеДобавлен Тогда
					Продолжить;
				КонецЕсли;
				
				МассивДокументов.Добавить(ДокументДоплаты);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СписокДокументов = Новый СписокЗначений();
	
	СписокДокументов.ЗагрузитьЗначения(МассивДокументов);
	
	Возврат СписокДокументов;
	
КонецФункции

Процедура ДобавитьКолонкиДляПоискаДокументовДоплаты(ТабличнаяЧастьКСФ, ДокументОбъект)
	
	ТабличнаяЧастьКСФ.Колонки.Добавить("Ссылка",					Новый ОписаниеТипов("ДокументСсылка.КорректировочныйСчетФактураВыданный"));
	ТабличнаяЧастьКСФ.Колонки.Добавить("СсылкаДокументОснование",	Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	ТабличнаяЧастьКСФ.Колонки.Добавить("Контрагент",				Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТабличнаяЧастьКСФ.Колонки.Добавить("Договор",					Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТабличнаяЧастьКСФ.ЗаполнитьЗначения(ДокументОбъект.Ссылка,				"Ссылка");
	ТабличнаяЧастьКСФ.ЗаполнитьЗначения(ДокументОбъект.ДокументОснование,	"СсылкаДокументОснование");
	ТабличнаяЧастьКСФ.ЗаполнитьЗначения(ДокументОбъект.Контрагент,			"Контрагент");
	ТабличнаяЧастьКСФ.ЗаполнитьЗначения(ДокументОбъект.Договор,				"Договор");
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Док.Ссылка КАК Ссылка,
				   |	Док.ПричинаНалогообложения КАК ПричинаНалогообложения,
	               |	Док.НомерПервичногоДокумента КАК НомерСчетаФактуры,
	               |	Док.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	               |	Док.ДатаПервичногоДокумента КАК ДатаСчетаФактуры,
	               |	НЕОПРЕДЕЛЕНО КАК НомерИсправленияКорректировки,
	               |	НЕОПРЕДЕЛЕНО КАК ДатаИсправленияКорректировки,
	               |	Док.Номер КАК Номер,
	               |	Док.Дата КАК Дата,
	               |	ВЫБОР
	               |		КОГДА Док.ДокументОснование ССЫЛКА Документ.ИсправительныйСчетФактураВыданный
	               |			ТОГДА Док.ДокументОснование.НомерИсправления
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК НомерИсправления,
	               |	ВЫБОР
	               |		КОГДА Док.ДокументОснование ССЫЛКА Документ.ИсправительныйСчетФактураВыданный
	               |			ТОГДА Док.ДокументОснование.ДатаИсправления
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ДатаИсправления,
	               |	Док.ДокументОснование КАК ДокументОснование,
	               |	Док.НаименованиеПродавца КАК НаименованиеПродавца,
	               |	Док.АдресПродавца КАК АдресПродавца,
	               |	Док.ИННПродавца + "" / "" + Док.КПППродавца КАК ИННКПППродавца,
	               |	Док.НаименованиеПокупателя КАК НаименованиеПокупателя,
	               |	Док.АдресПокупателя КАК АдресПокупателя,
	               |	Док.ИННПокупателя + "" / "" + Док.КПППокупателя КАК ИННКПППокупателя,
	               |	ВЫРАЗИТЬ(Док.ВалютаДокумента КАК Справочник.Валюты).Код КАК ВалютаКод,
	               |	ВЫРАЗИТЬ(Док.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное КАК ВалютаПредставление,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	Док.ВидЦенности КАК ВидЦенности,
	               |	Док.ФИОРуководителя КАК ФИОРуководителя,
	               |	Док.ФИОГлавногоБухгалтера КАК ФИОГлавногоБухгалтера,
	               |	Док.Контрагент КАК Контрагент,
	               |	Док.Договор КАК Договор,
	               |	Док.Организация КАК Организация,
	               |	Док.Организация.ИНН КАК ОрганизацияИНН,
	               |	Док.Подразделение КАК Подразделение,
	               |	Док.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	               |	Док.КодыВидовТоваров КАК КодыВидовТоваров,
	               |	Док.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураВыданный КАК Док
	               |ГДЕ
	               |	Док.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Док.СоставНФА.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставНФА.НомерСтроки КАК НомерСтроки,
	               |	СоставНФА.НФА КАК НФА,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код, """") КАК ЕдиницаИзмеренияКод,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
	               |	СоставНФА.КоличествоДоИзменения КАК КоличествоДоИзменения,
	               |	СоставНФА.Количество КАК Количество,
	               |	СоставНФА.ЦенаДоИзменения КАК ЦенаДоИзменения,
	               |	СоставНФА.Цена КАК Цена,
	               |	СоставНФА.СуммаДоИзменения КАК СуммаДоИзменения,
	               |	СоставНФА.Сумма КАК Сумма,
	               |	СоставНФА.СуммаУменьшение КАК СуммаУменьшение,
	               |	СоставНФА.СуммаУвеличение КАК СуммаУвеличение,
	               |	СоставНФА.СтавкаНДСДоИзменения КАК СтавкаНДСДоИзменения,
	               |	СоставНФА.СтавкаНДС КАК СтавкаНДС,
	               |	СоставНФА.СуммаНДСДоИзменения КАК СуммаНДСДоИзменения,
	               |	СоставНФА.СуммаНДС КАК СуммаНДС,
	               |	СоставНФА.СуммаНДСУменьшение КАК СуммаНДСУменьшение,
	               |	СоставНФА.СуммаНДСУвеличение КАК СуммаНДСУвеличение,
	               |	СоставНФА.ВсегоДоИзменения КАК ВсегоДоИзменения,
	               |	СоставНФА.Всего КАК Всего,
	               |	СоставНФА.ВсегоУменьшение КАК ВсегоУменьшение,
	               |	СоставНФА.ВсегоУвеличение КАК ВсегоУвеличение,
	               |	СоставНФА.СуммаАкцизаДоИзменения КАК СуммаАкцизаДоИзменения,
	               |	СоставНФА.СуммаАкциза КАК СуммаАкциза,
	               |	СоставНФА.СуммаАкцизаУвеличение КАК СуммаАкцизаУвеличение,
	               |	СоставНФА.СуммаАкцизаУменьшение КАК СуммаАкцизаУменьшение,
	               |	СоставНФА.КодВидаТовара КАК КодВидаТовара,
				   |	СоставНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
				   |	СоставНФА.СведенияОбъемноСортовогоУчетаДоИзменения КАК СведенияОбъемноСортовогоУчетаДоИзменения,
				   |	СоставНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК СоставНФА
	               |ГДЕ
	               |	СоставНФА.Ссылка = &Ссылка;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
				   |	СчетФактураКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
				   |	СчетФактураКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
				   |	СчетФактураКодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
				   |ИЗ
				   |	Документ.КорректировочныйСчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК СчетФактураКодыУпаковокМаркируемойПродукции
				   |ГДЕ
				   |	СчетФактураКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаШапка = МассивРезультатов[0].Выгрузить();
	
	Структура = Новый Структура();
	Структура.Вставить("Шапка",						ТаблицаШапка);
	Структура.Вставить("ТабЧастьНФА",				МассивРезультатов[1].Выгрузить());
	Структура.Вставить("ТабЧастьМаркировкаТоваров",	МассивРезультатов[2].Выгрузить());
	
	СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка);
	Структура.Вставить("СтороныСделки", СтороныСделки);
	
	НомерДокумента = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(ТаблицаШапка[0]);
	Структура.Вставить("НомерДокумента", НомерДокумента);
	
	Структура.Вставить("КодыУпаковокИзСФ", ПолучитьКодыУпаковокИзСФ(ДокументСсылка));
	
	// Прослеживаемость
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		ДобавитьПоказателиПрослеживаемости(ДокументСсылка, Структура.ТабЧастьНФА);
	КонецЕсли;
	// Конец Прослеживаемость
	
	Возврат Структура;
	
КонецФункции

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ПричинаНалогообложения) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнена причина налогообложения.'");
		Сообщить(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Договор) Тогда
		СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
		
		Если НЕ ЗначениеЗаполнено(СвойстваДоговора.ВидОбязательства) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен вид обязательства в договоре'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СвойстваДоговора.ДатаДоговора) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата договора'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления
	// (каждый порядковый номер имеет соответствующее Условие)
	//	№	Релиз	Описание
	//	1	58.45	Инициализация колонки СтавкаНДСДоИзменения
	//	2	61.28	Инициализация реквизита шапки ДокументДоплаты
	//	3	61.28	Формирование движений по регистру накопления ВходящийНДС
	
	ПричиныШкурыЛом = Новый Массив();
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	
	ДокументыНеудовлУсл3 = ПолучитьДокументыНеудовлУсл3ДляПереходаНаНовуюВерсию();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПричиныШкурыЛом",		ПричиныШкурыЛом);
	Запрос.УстановитьПараметр("ДокументыНеудовлУсл3",	ДокументыНеудовлУсл3);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы, подлежащие обработке
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА
	|ГДЕ
	|	// Условие 1
	|	(СтавкаНДСДоИзменения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)И НЕ Ссылка.ПричинаНалогообложения В(&ПричиныШкурыЛом))
	|	ИЛИ
	|	// Условие 2
	|	(Ссылка.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный) И Ссылка.ДокументДоплаты = НЕОПРЕДЕЛЕНО)
	|	ИЛИ
	|	// Условие 3
	|	(Ссылка.Проведен И Ссылка.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный) И НЕ Ссылка В(&ДокументыНеудовлУсл3))
	|;";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления
	// (каждый порядковый номер имеет соответствующее Условие)
	//	№	Релиз	Описание
	//	1	58.45	Инициализация колонки СтавкаНДСДоИзменения
	//	2	61.28	Инициализация реквизита шапки ДокументДоплаты
	//	3	61.28	Формирование движений по регистру накопления ВходящийНДС
	
	ПолноеИмяОбъекта = "Документ.КорректировочныйСчетФактураВыданный";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	ПричиныШкурыЛом = Новый Массив();
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	
	ДокументыНеудовлУсл3 = ПолучитьДокументыНеудовлУсл3ДляПереходаНаНовуюВерсию();
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПричиныШкурыЛом",		ПричиныШкурыЛом);
	Запрос.УстановитьПараметр("ДокументыНеудовлУсл3",	ДокументыНеудовлУсл3);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (подготовка) Документы, подлежащие обработке
	|//
	|ВЫБРАТЬ
	|	Ссылка																			КАК Ссылка,
	|
	|	// Условие 1
	|	МАКСИМУМ((СтавкаНДСДоИзменения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|		И НЕ Ссылка.ПричинаНалогообложения В(&ПричиныШкурыЛом)))					КАК ИнициализироватьСтавкаНДСДоИзменения,
	|		
	|	// Условие 2
	|	МАКСИМУМ(Ссылка.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|		И Ссылка.ДокументДоплаты = НЕОПРЕДЕЛЕНО)									КАК ИнициализироватьДокументДоплаты,
	|	
	|	// Условие 3
	|	МАКСИМУМ(Ссылка.Проведен И Ссылка.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|		 И НЕ Ссылка В(&ДокументыНеудовлУсл3))										КАК СоздатьДвиженияВходящийНДС
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы, подлежащие обработке
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ВсеДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Документы, подлежащие обработке по условию 2 или 3
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ВсеДокументы
	|ГДЕ
	|	ИнициализироватьДокументДоплаты
	|	ИЛИ СоздатьДвиженияВходящийНДС
	|;";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	// [1]. Документы, подлежащие обработке
	Если РезультатыЗапроса[1].Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта", ПолноеИмяОбъекта);
	
	
	// [2]. Документы, подлежащие обработке по условию 2 или 3
	МассивСсылок = РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ПолучитьВыборкиДокументовДоплатыИОшибокДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры);
	
	ПроверитьНаличиеОшибокОпределенияКорректируемыхПозицийДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры);
	
	ПроверитьНаличиеОшибокОпределенияДокументовДоплатыДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры);
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	
	КоличествоОшибок = 0;
	Обработано       = 0;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Ссылка;
		
		Попытка
			
			ОбработатьДокументДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры);
			
			Обработано = Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось обработать документ %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			КоличествоОшибок = КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если Обработано = 0 Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			КоличествоОшибок);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru='Успешно завершена обработка очередной порции объектов %1: %2 шт.'"),
		ПолноеИмяОбъекта,
		Обработано);
	
	ЗаписьЖурналаРегистрации(
		ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

Процедура ОбработатьДокументДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		ДокументСсылка = Выборка.Ссылка;
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если Выборка["ИнициализироватьСтавкаНДСДоИзменения"] Тогда
			
			Для Каждого СтрокаТаблицы Из ДокОбъект.СоставНФА Цикл
				СтрокаТаблицы["СтавкаНДСДоИзменения"] = СтрокаТаблицы["СтавкаНДС"];
			КонецЦикла;
			
		КонецЕсли;
		
		Если Выборка["ИнициализироватьДокументДоплаты"] Тогда
			
			ДокументДоплаты = ПолучитьЕдинственныйДокументДоплатыДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры);
			
			Если ЗначениеЗаполнено(ДокументДоплаты) Тогда
				
				ДокОбъект["ДокументДоплаты"] = ДокументДоплаты;
				
			Иначе
				ТекстСообщения = НСтр("ru='Реквизит ДокументДоплаты не был установлен. Не удалось определить единственный документ доплаты'");
				
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Предупреждение,
					ДокументСсылка.Метаданные(),
					ДокументСсылка,
					ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка["СоздатьДвиженияВходящийНДС"] Тогда
			
			ДокументДоплаты = ДокОбъект.ДокументДоплаты;
			
			Если НЕ ЗначениеЗаполнено(ДокументДоплаты) Тогда
				ДокументДоплаты = ПолучитьЕдинственныйДокументДоплатыДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументДоплаты) Тогда
				
				ДополненныеТабличныеЧастиКСФ = ДополнительныеПараметры["ВыборкиДокументовДоплатыИОшибок"]["ДополненныеТабличныеЧастиКСФ"];
				
				Поиск = Новый Структура("Ссылка", ДокументСсылка);
				
				МассивСтрок = ДополненныеТабличныеЧастиКСФ.НайтиСтроки(Поиск);
				
				ДокОбъект.Движения.ВходящийНДС.Очистить();
				
				СформироватьДвиженияПоРН_ВходящийНДС_ПриИнициализацииДокументаДоплаты(ДокОбъект, МассивСтрок);
				
				ДокОбъект.Движения.ВходящийНДС.Записать();
				
			Иначе
				ТекстСообщения = НСтр("ru='Движения по ВходящийНДС не были сформированы. Не удалось определить единственный документ доплаты'");
				
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Предупреждение,
					ДокументСсылка.Метаданные(),
					ДокументСсылка,
					ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьДокументыНеудовлУсл3ДляПереходаНаНовуюВерсию()
	
	//	Обработчик обновления КСФВыданный 2.0.61
	//
	//	Условие 3 (Формирование движений по регистру накопления ВходящийНДС)
	//	
	//	Выбираются документы, неудовлетворяющие условию 3.
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы, потенциально удовлетворяющие условию 3
	|//
	|ВЫБРАТЬ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыПотенциальноУсловие3
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный
	|ГДЕ
	|	// (частично) Условие 3
	|	Ссылка.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы, неудовлетворяющие условию 3
	|//
	|ВЫБРАТЬ // (различные)
	|	Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДокументКорректировки	КАК Ссылка
	|	ИЗ
	|		РегистрНакопления.ВходящийНДС.Обороты(
	|			,
	|			,
	|			,
	|			ДокументКорректировки В(ВЫБРАТЬ Ссылка ИЗ ДокументыПотенциальноУсловие3)
	|		)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		СчетФактура	КАК Ссылка
	|	ИЗ
	|		РегистрНакопления.КнигаПокупок.Обороты(
	|			,
	|			,
	|			,
	|			СчетФактура В(ВЫБРАТЬ Ссылка ИЗ ДокументыПотенциальноУсловие3)
	|		)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		СчетФактура	КАК Ссылка
	|	ИЗ
	|		РегистрНакопления.ДополнительныеЛистыКнигиПокупок.Обороты(
	|			,
	|			,
	|			,
	|			СчетФактура В(ВЫБРАТЬ Ссылка ИЗ ДокументыПотенциальноУсловие3)
	|		)
	|	)	КАК ЗарегистрированныеДокументы
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ПолучитьВыборкиДокументовДоплатыИОшибокДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры)
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ВыборкиДокументовДоплатыИОшибок = ПолучитьВыборкиДокументовДоплатыИОшибок(МассивСсылок);
		
	Исключение
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Возникла ошибка при определении документов доплаты для объектов %1 (%2 шт.) по причине %3'"),
			ДополнительныеПараметры["ПолноеИмяОбъекта"],
			МассивСсылок.Количество(),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСообщения);
			
	КонецПопытки;
	
	ДополнительныеПараметры.Вставить("ВыборкиДокументовДоплатыИОшибок", ВыборкиДокументовДоплатыИОшибок);
	
КонецПроцедуры

Процедура ПроверитьНаличиеОшибокОпределенияКорректируемыхПозицийДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры)
	
	Перем ВыборкиДокументовДоплатыИОшибок;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеПараметры.Свойство("ВыборкиДокументовДоплатыИОшибок", ВыборкиДокументовДоплатыИОшибок) Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаОшибки = ВыборкиДокументовДоплатыИОшибок["ОшибкиОпределенияКорректируемыхПозиций"];
	
	Для Каждого ДокументСсылка Из МассивСсылок Цикл
		
		ЕстьОшибка = ВыборкаОшибки.НайтиСледующий(ДокументСсылка, "Ссылка");
		
		Если ЕстьОшибка Тогда
			
			НомераСтрок = Новый Массив();
			
			ВыборкаНомерСтроки = ВыборкаОшибки.Выбрать();
			
			Пока ВыборкаНомерСтроки.Следующий() Цикл
				НомераСтрок.Добавить(Формат(ВыборкаНомерСтроки["НомерСтроки"], "ЧГ=0"));
			КонецЦикла;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось определить корректируемые позиции обычного счета-фактуры для следующих строк табличной части: %1'"),
				СтрСоединить(НомераСтрок, ", "));
			
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			ВыборкаОшибки.Сбросить();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеОшибокОпределенияДокументовДоплатыДляПереходаНаНовуюВерсию(МассивСсылок, ДополнительныеПараметры)
	
	Перем ВыборкиДокументовДоплатыИОшибок;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеПараметры.Свойство("ВыборкиДокументовДоплатыИОшибок", ВыборкиДокументовДоплатыИОшибок) Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДокументыДоплаты = ВыборкиДокументовДоплатыИОшибок["ДокументыДоплаты"];
	
	Для Каждого ДокументСсылка Из МассивСсылок Цикл
		
		ВыборкаДокументыДоплаты.НайтиСледующий(ДокументСсылка, "Ссылка");
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДокументыДоплаты["ДокументДоплаты"]) Тогда
			
			ТекстСообщения = НСтр("ru='Не удалось определить единственный документ доплаты'");
			
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			ВыборкаДокументыДоплаты.Сбросить();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЕдинственныйДокументДоплатыДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры)
	
	Перем ВыборкиДокументовДоплатыИОшибок;
	
	Если НЕ ДополнительныеПараметры.Свойство("ВыборкиДокументовДоплатыИОшибок", ВыборкиДокументовДоплатыИОшибок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДокументыДоплаты = ВыборкиДокументовДоплатыИОшибок["ДокументыДоплаты"];
	
	ВыборкаДокументыДоплаты.НайтиСледующий(ДокументСсылка, "Ссылка");
	
	ДокументДоплаты = ВыборкаДокументыДоплаты["ДокументДоплаты"];
			
	ВыборкаДокументыДоплаты.Сбросить();
	
	Возврат ДокументДоплаты;
	
КонецФункции

#КонецОбласти


#Область Прослеживаемость

Процедура ДобавитьПоказателиПрослеживаемости(ДокументСсылка, ТаблицаНФА) Экспорт
	
	ПоказателиПрослеживаемости = ПолучитьПоказателиПрослеживаемости(ДокументСсылка);
	
	ТаблицаНФА.Колонки.Добавить("СведенияОПрослеживаемости", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыНФА Из ТаблицаНФА Цикл
		СтрокаТаблицыНФА.СведенияОПрослеживаемости = УчетНДС.ПолучитьПустуюТаблицуСведенияОПрослеживаемостиУКД();
		
		Поиск.Вставить("Ссылка", ДокументСсылка);
		Поиск.Вставить("НомерСтроки", СтрокаТаблицыНФА.НомерСтроки);
		
		МассивСтрок = ПоказателиПрослеживаемости.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицыПрослеживаемости Из МассивСтрок Цикл
			НоваяСтрока = СтрокаТаблицыНФА.СведенияОПрослеживаемости.Добавить();
			
			КоличествоУчетноеИзменение = СтрокаТаблицыПрослеживаемости.КоличествоУчетноеПосле - СтрокаТаблицыПрослеживаемости.КоличествоУчетноеДо;
			
			КоличествоПрослежИзменение = СтрокаТаблицыПрослеживаемости.КоличествоПрослежПосле - СтрокаТаблицыПрослеживаемости.КоличествоПрослежДо;
			
			НоваяСтрока["НомерСтроки"]			= СтрокаТаблицыНФА.СведенияОПрослеживаемости.Количество();
			НоваяСтрока["НомерТовара"]			= СокрЛП(СтрокаТаблицыПрослеживаемости.ПредставлениеГТДПосле);
			НоваяСтрока["ЕдиницаИзмеренияКод"]	= СтрокаТаблицыПрослеживаемости.ЕдиницаИзмеренияПрослежКодПосле;
			
			НоваяСтрока["КоличествоТовараДоИзменения"]		= СтрокаТаблицыПрослеживаемости.КоличествоПрослежДо;
			НоваяСтрока["КоличествоТовараПослеИзменения"]	= СтрокаТаблицыПрослеживаемости.КоличествоПрослежПосле;
			НоваяСтрока["КоличествоТовараУвеличение"]		= ?(КоличествоПрослежИзменение > 0, КоличествоПрослежИзменение, 0);
			НоваяСтрока["КоличествоТовараУменьшение"]		= ?(КоличествоПрослежИзменение > 0, 0, -КоличествоПрослежИзменение);
			
			НоваяСтрока["КоличествоТовараУчетноеДоИзменения"]		= СтрокаТаблицыПрослеживаемости.КоличествоУчетноеДо;
			НоваяСтрока["КоличествоТовараУчетноеПослеИзменения"]	= СтрокаТаблицыПрослеживаемости.КоличествоУчетноеПосле;
			НоваяСтрока["КоличествоТовараУчетноеУвеличение"]		= ?(КоличествоУчетноеИзменение > 0, КоличествоУчетноеИзменение, 0);
			НоваяСтрока["КоличествоТовараУчетноеУменьшение"]		= ?(КоличествоУчетноеИзменение > 0, 0, -КоличествоУчетноеИзменение);
			
			СтоимПрослежИзменение = СтрокаТаблицыПрослеживаемости.СтоимПрослежПосле - СтрокаТаблицыПрослеживаемости.СтоимПрослежДо;
			
			НоваяСтрока["СтоимостьБезНДСДоИзменения"]		= СтрокаТаблицыПрослеживаемости.СтоимПрослежДо;
			НоваяСтрока["СтоимостьБезНДСПослеИзменения"]	= СтрокаТаблицыПрослеживаемости.СтоимПрослежПосле;
			НоваяСтрока["СтоимостьБезНДСУвеличение"]		= ?(СтоимПрослежИзменение > 0, СтоимПрослежИзменение, 0);
			НоваяСтрока["СтоимостьБезНДСУменьшение"]		= ?(СтоимПрослежИзменение > 0, 0, -СтоимПрослежИзменение);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

