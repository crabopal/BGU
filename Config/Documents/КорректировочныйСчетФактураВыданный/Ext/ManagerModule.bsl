Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактураАвто") Тогда
		
		ИдентификаторПостановления = Неопределено;
		
		ИмяМакета = "СчетФактураАвто";
		
		СинонимМакета = "Счет-фактура";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура1096") Тогда
		
		ИдентификаторПостановления = "1096";
		
		ИмяМакета = "СчетФактура1096";
		
		СинонимМакета = "Счет-фактура (1096)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура2023Кв4Прослеж") Тогда
		
		ИдентификаторПостановления = "2023Кв4Прослеж";
		
		ИмяМакета = "СчетФактура2023Кв4Прослеж";
		
		СинонимМакета = "Счет-фактура (534 от 02.04.2021, 389-ФЗ)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура534") Тогда
		
		ИдентификаторПостановления = "534";
		
		ИмяМакета = "СчетФактура534";
		
		СинонимМакета = "Счет-фактура (534 от 02.04.2021)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура981") Тогда
		
		ИдентификаторПостановления = "981";
		
		ИмяМакета = "СчетФактура981";
		
		СинонимМакета = "Счет-фактура (981 от 19.08.2017)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура625") Тогда
		
		ИдентификаторПостановления = "625";
		
		ИмяМакета = "СчетФактура625";
		
		СинонимМакета = "Счет-фактура (625 от 25.05.2017)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура1137") Тогда
		
		ИдентификаторПостановления = "1137";
		
		ИмяМакета = "СчетФактура1137";
		
		СинонимМакета = "Счет-фактура (1137 от 26.12.2011)";
		
	КонецЕсли;
	
	СтруктураПараметровОбработчика = Новый Структура();
	СтруктураПараметровОбработчика.Вставить("МассивОбъектов",	МассивОбъектов);
	СтруктураПараметровОбработчика.Вставить("ПараметрыПечати",	ПараметрыПечати);
	СтруктураПараметровОбработчика.Вставить("ОбъектыПечати",	ОбъектыПечати);
	СтруктураПараметровОбработчика.Вставить("ПараметрыВывода",	ПараметрыВывода);
	
	ДанныеДокументов = ПолучитьДанныеДокументовДляПечати(СтруктураПараметровОбработчика["МассивОбъектов"]);
	
	ТабДокумент = УчетНДС.ПечатьКорректировочногоСчетаФактуры(
		ДанныеДокументов,
		СтруктураПараметровОбработчика,
		ИдентификаторПостановления);
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СинонимМакета,
		ТабДокумент);
	
КонецПроцедуры

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	Перем ТиповаяОперация;
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;	
	
	// Корректировка аванса разрешена
	//Если  Основание.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный тогда
	//	ОписаниеОшибки = НСтр("ru='Аванс корректировать нет смысла, нужно вводить новый счет фактура выданный.'");
	//	Возврат Ложь;
	//КонецЕсли;	
	
	ТипДокументаОснования = ТипЗнч(Основание);
	
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗаполнитьНаОснованииСчетФактураВыданный(Основание,Объект);
		Объект.ДокументОснование = Основание;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ЗаполнитьНаОснованииКорректировочныйСчетФактураВыданный(Основание,Объект);
		Объект.ДокументОснование = Основание;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЗаполнитьНаОснованииИсправительныйСчетФактураВыданный(Основание,Объект);
		Объект.ДокументОснование = Основание;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		Если НЕ УчетНДС.ДопустимВводКСФНаОснованииРеализации(Основание, ОписаниеОшибки) Тогда
			ОписаниеОшибки = НСтр("ru='Ввод корректировочного счета-фактуры на основании отменен.
				|'") + ОписаниеОшибки;
			
			Возврат Ложь;
		КонецЕсли;
		
		ЗаполнитьНаОснованииНакладнаяНаРеализациюТорг12(Основание, Объект, ДополнительныеПараметры);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		Если НЕ УчетНДС.ДопустимВводКСФНаОснованииРеализации(Основание, ОписаниеОшибки) Тогда
			ОписаниеОшибки = НСтр("ru='Ввод корректировочного счета-фактуры на основании отменен.
				|'") + ОписаниеОшибки;
			
			Возврат Ложь;
		КонецЕсли;
		
		ЗаполнитьНаОснованииНакладнаяНаОтпускМ15(Основание, Объект, ДополнительныеПараметры);
		
	КонецЕсли;
	
	ЗаполнитьРеквизитыСторонСделки(Объект);
	
	Если не ЗначениеЗаполнено(Объект.ВалютаДокумента) тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДополнительныеДанные() экспорт
	Возврат "";
КонецФункции	

Процедура СформироватьДвиженияПоРегистрам(ДокументОбъект, Отказ) Экспорт
	
	Движения = ДокументОбъект.Движения;
	
	Для каждого РегистрДвижения из Движения цикл
		Если ТипЗнч(РегистрДвижения) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
			И ТипЗнч(РегистрДвижения) <> Тип("РегистрСведенийНаборЗаписей.ОперацииСПрослеживаемымиТоварами") Тогда
			РегистрДвижения.Записывать = Истина;
			РегистрДвижения.Очистить();
		КонецЕсли;	
	КонецЦикла;
	
	ОперацияДокумента = ПолучитьРеквизитыТиповойОперации(ДокументОбъект);
	
	КорректировкаСФПоКомиссииАванс = Ложь;
	КорректировкаСФПоКомиссииРеализация = Ложь;
	Если ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйКомиссионером Тогда
		КорректировкаСФПоКомиссииАванс = Истина;
	КонецЕсли;
	
	Если (ДокументОбъект.ВсегоУвеличениеПоКомиссии <> 0 ИЛИ ДокументОбъект.ВсегоУменьшениеПоКомиссии <> 0) Тогда
		КорректировкаСФПоКомиссииРеализация = Истина
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияДокумента.Операция) ИЛИ КорректировкаСФПоКомиссииАванс ИЛИ КорректировкаСФПоКомиссииРеализация Тогда
		СтруктураШапкиДокумента = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОбъект.Ссылка);
		
		СтруктураШапкиДокумента.Вставить("Ссылка",					ДокументОбъект.Ссылка);
		СтруктураШапкиДокумента.Вставить("КФО",						ОперацияДокумента.КФО);
		СтруктураШапкиДокумента.Вставить("Дата",					ДокументОбъект.Дата);
		СтруктураШапкиДокумента.Вставить("ДокументКорректировки",	ДокументОбъект.Ссылка);
		
		СтруктураШапкиДокумента.Вставить("Курс",		ОперацияДокумента.Курс);
		СтруктураШапкиДокумента.Вставить("Кратность",	ОперацияДокумента.Кратность);
		
		Если Не КорректировкаСФПоКомиссииАванс Тогда
			ТабОснования = ПолучитьДанныеДляИсходящегоНДСпоДокументу(СтруктураШапкиДокумента);
			
			Отказ = не СформироватьДвижения(СтруктураШапкиДокумента, ТабОснования, Движения, ОперацияДокумента);
		КонецЕсли;
		
		Если не Отказ тогда
			УчетНДС.ЗарегестрироватьСчетФактуру(ДокументОбъект.Ссылка,Движения);
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьРеквизитыТиповойОперации(ДокументОбъект)
	
	ОперацияДокумента = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(
		ДокументОбъект.Ссылка,
		Новый Структура("КФО,Операция,Курс,Кратность,Счет"));
	
	Если НЕ ЗначениеЗаполнено(ОперацияДокумента.КФО) Тогда
		ОперацияДокумента.КФО = Перечисления.КВД.Бюджет;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОперацияДокумента.Курс) Тогда
		ОперацияДокумента.Курс = 1;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОперацияДокумента.Кратность) Тогда
		ОперацияДокумента.Кратность = 1;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОперацияДокумента.Счет) Тогда
		ОперацияДокумента.Счет = УчетНДС.АвтоСчетНачислениеДтДляКСФ(
			ДокументОбъект.Дата,
			ДокументОбъект.ПричинаНалогообложения,
			ОперацияДокумента.КФО);
	КонецЕсли;
	
	Возврат ОперацияДокумента;
	
КонецФункции

