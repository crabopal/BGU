&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СписокДокументовОснования = Новый СписокЗначений;
	СписокДокументовОснования.Добавить("СчетФактураВыданный","Счет-фактура выданный");
	СписокДокументовОснования.Добавить("КорректировочныйСчетФактураВыданный","Корректировочный счет-фактура выданный");
	СписокДокументовОснования.Добавить("ИсправительныйСчетФактураВыданный","Исправительный счет-фактура выданный");
	
	ДополнительныеПараметры = Новый Структура("Элемент", Элемент);
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ДокументОснованиеВыбранТипДокумента", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВыборИзСписка(ОписаниеОповещенияВыбор, СписокДокументовОснования, Элемент)
	
КонецПроцедуры
&НаКлиенте
Процедура ДокументОснованиеВыбранТипДокумента(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидДокументаСтрокой = РезультатВыбора.Значение;
	
	ЭлементВладелец = ОписаниеОповещения["Элемент"];
	
	Отбор = Новый Структура("Организация", Объект.Организация);
	Если ЗначениеЗаполнено(Объект.Контрагент) тогда
		Отбор.Вставить("Контрагент",Объект.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Договор) тогда
		Отбор.Вставить("Договор",Объект.Договор);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ПараметрыФормы.Вставить("ТекущаяСтрока",Объект.ДокументОснование);
	
	ДобавитьПредустановленныйОтборСИсключениемСсылки(ПараметрыФормы, Объект.Ссылка);
	
	ОткрытьФорму("Документ." + ВидДокументаСтрокой + ".ФормаВыбора", ПараметрыФормы, ЭлементВладелец);
	
КонецПроцедуры

