&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	Перем ИмяИзмененногоПоля;
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяЭлемента = Элемент.Имя;
	
	// Колонки, не относящиеся к НДС:
	Если ИмяЭлемента = "СоставНФАКоличество" ИЛИ ИмяЭлемента = "СоставНФАЦена" Тогда
		ТекДанные["Сумма"]	= ТекДанные["Количество"] * ТекДанные["Цена"];
		ИмяИзмененногоПоля	= "Сумма";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАКоличествоДоИзменения" ИЛИ ИмяЭлемента = "СоставНФАЦенаДоИзменения" Тогда
		ТекДанные["СуммаДоИзменения"]	= ТекДанные["КоличествоДоИзменения"] * ТекДанные["ЦенаДоИзменения"];
		ИмяИзмененногоПоля	= "СуммаДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	// Колонки, относящиеся к НДС:
	ИначеЕсли ИмяЭлемента = "СоставНФАСумма" Тогда
		ИмяИзмененногоПоля	= "Сумма";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СуммаДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДС" Тогда
		ИмяИзмененногоПоля	= "СуммаНДС";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДСДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СуммаНДСДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсего" ИЛИ ИмяЭлемента = "СоставНФАВсегоАванс" Тогда
		ИмяИзмененногоПоля	= "Всего";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсегоДоИзменения" ИЛИ ИмяЭлемента = "СоставНФАВсегоДоИзмененияАванс" Тогда
		ИмяИзмененногоПоля	= "ВсегоДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДС" Тогда
		ИмяИзмененногоПоля	= "СтавкаНДС";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДСДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СтавкаНДСДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДСДоИзменения";
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",		ИмяПоляСумма);
	СтруктураИменПолей.Вставить("СуммаНДС",		ИмяПоляСуммаНДС);
	СтруктураИменПолей.Вставить("Всего",		ИмяПоляВсего);
	СтруктураИменПолей.Вставить("СтавкаНДС",	ИмяПоляСтавкаНДС);
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс, ЭтоНалоговыйАгент);
	
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Сумма");
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "СуммаНДС");
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Всего");
	
	Если ТекДанные.КомиссионнаяТорговля Тогда
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "СуммаНДС", "СуммаНДСПоКомиссии");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Всего", "ВсегоПоКомиссии");
	КонецЕсли;
	
КонецПроцедуры	

