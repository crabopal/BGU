&НаСервере
Процедура ОбновитьНомерДляПечатиСервер()
	
	НомерСФ = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(Объект);
	
	НомерДляПечати = НомерСФ["НомерКСФ"];
	
	НовВидимость = НЕ (НомерДляПечати = Объект.Номер);
	
	Элементы["НомерДляПечати"].Видимость = НовВидимость;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКолонкиСодержаниеУслуги()
	
	// Настройка видимости выполняется аналогично форме документа СчетФактураВыданный
	
	НовВидимость = Ложь;
	
	ПервоначальныйСчетФактура = УчетНДС.ПолучитьПервоначальныйСчетФактуруВыданный(Объект.ИсправляемыйДокумент);
	
	Если ЗначениеЗаполнено(ПервоначальныйСчетФактура) Тогда
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервоначальныйСчетФактура, "ДокументОснование");
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			ТипОснования = ТипЗнч(ДокументОснование);
			
			НовВидимость = (ТипОснования = Тип("ДокументСсылка.АктОбОказанииУслуг")
				Или ТипОснования = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС")
				Или ТипОснования = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"));
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СоставНФАСодержаниеУслуги.Видимость = НовВидимость;
	
КонецПроцедуры

