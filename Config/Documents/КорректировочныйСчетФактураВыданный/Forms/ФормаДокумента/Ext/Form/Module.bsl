&НаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма)
	
	Объект = Форма.Объект;
	
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	
	ВидимостьЭлементовМаркировки = ЭлектронныеДокументыБГУ.ОпределитьВидимостьЭлементовМаркировки(Объект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СоставНФАМаркируемыеУпаковки,СтраницаМаркируемыеУпаковки,ГруппаДополнительныеСведенияОМаркированныхТоварах", "Видимость", ВидимостьЭлементовМаркировки);
	
	ВидимостьЭлементовМаркировкиОбъемноСортовогоУчета = ЭлектронныеДокументыБГУ.ИспользованиеОбъемноСортовойУчетМаркированныхТоваров(Объект.Организация);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СоставНФАГруппаСведенияОбъемноСортовогоУчета", "Видимость", ВидимостьЭлементовМаркировкиОбъемноСортовогоУчета);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеКомиссия(Элемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.КомиссионнаяТорговля Тогда
		ТекДанные.СуммаНДСПоКомиссииУвеличение = ТекДанные.СуммаНДСУвеличение;
		ТекДанные.СуммаНДСПоКомиссииУменьшение = ТекДанные.СуммаНДСУменьшение;
		ТекДанные.ВсегоПоКомиссииУвеличение = ТекДанные.ВсегоУвеличение;
		ТекДанные.ВсегоПоКомиссииУменьшение = ТекДанные.ВсегоУменьшение;
	Иначе
		ТекДанные.СуммаНДСПоКомиссииУвеличение = 0;
		ТекДанные.СуммаНДСПоКомиссииУменьшение = 0;
		ТекДанные.ВсегоПоКомиссииУвеличение = 0;
		ТекДанные.ВсегоПоКомиссииУменьшение = 0;
	КонецЕсли;
	
КонецПроцедуры

