&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		"ВыставленныеСчетаФактуры",
		Объект["Дата"]);
		
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперацииКомиссия"].СписокВыбора,
		"ВыставленныеСчетаФактуры",
		Объект["Дата"]);
	
	ДопЛист = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок;
	
	КодВидаТовараИспользуется = УчетНДСПовтИсп.КодВидаТовараИспользуется(Объект["ПричинаНалогообложения"]);
	Элементы["СоставНФАКодВидаТовара"].Видимость = КодВидаТовараИспользуется;
	
	НастроитьФормуСервер_ПоПричинеНалогообложения();
	
	ОбновитьНомерДляПечатиСервер();
	
	ЗаполнитьТиповуюОперациюПриВводеНаОсновании();
	
	НастроитьВидимостьКолонкиСодержаниеУслуги();
	
	//---
	// Документы остатков НДС
	//---
	ДокументыОстатковНДС_НастроитьФормуСервер();
	
	УстановитьУсловноеОформление();
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ДиагностироватьЦепочкуДокументовСчетовФактур();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТиповуюОперациюПриВводеНаОсновании()
	
	Перем Основание;
	
	Если Константы.ФормированиеПроводокОбособленноОтДокумента.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("Основание", Основание);
	
	Если Объект.Ссылка.Пустая() И ТипЗнч(Основание) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		НоваяТиповаяОперация = Документы.КорректировочныйСчетФактураВыданный.ЗаполнитьНаОснованииНакладнаяНаРеализациюТорг12_ТиповаяОперация(Основание);
		
		УчетНДС.ЗаполнитьТиповуюОперациюПриВводеНаОсновании(ЭтаФорма, НоваяТиповаяОперация);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Надпись А (до изменения)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись А (до изменения)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='А (до изменения)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьА");


	//---
	// 2. Надпись Б (после изменения)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись Б (после изменения)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Б (после изменения)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьБ");

	
	//---
	// 3. Надпись В (увеличение)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись В (увеличение)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='В (увеличение)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьВ");


	//---
	// 4. Надпись Г (уменьшение)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись Г (уменьшение)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Г (уменьшение)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьГ");
	
	//---
	// 5.Заполненный реквизит "Документ основание" устанавливает реквизиты табличной части "Комиссионная торговля" в значение только просмотр
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Заполненный реквизит ""Документ основание"" устанавливает реквизиты табличной части ""Комиссионная торговля"" в значение только просмотр");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДокументОснование");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАКомиссионнаяТорговля");
	
КонецПроцедуры

