	ДокументИсправительныйСчетФактураПолученный.Дата,
	ДокументИсправительныйСчетФактураПолученный.Проведен,
	ДокументИсправительныйСчетФактураПолученный.Организация,
	ДокументИсправительныйСчетФактураПолученный.ИФО,
	ДокументИсправительныйСчетФактураПолученный.Подразделение,
	ДокументИсправительныйСчетФактураПолученный.Комментарий,
	ДокументИсправительныйСчетФактураПолученный.Контрагент,
	ДокументИсправительныйСчетФактураПолученный.Договор,
	ДокументИсправительныйСчетФактураПолученный.СуммаВключаетНДС,
	ДокументИсправительныйСчетФактураПолученный.ПричинаНалогообложения,
	ДокументИсправительныйСчетФактураПолученный.ДокументОснование,
	ДокументИсправительныйСчетФактураПолученный.КорректируемыйПериод,
	ДокументИсправительныйСчетФактураПолученный.ВариантРегистрации,
	ДокументИсправительныйСчетФактураПолученный.ВалютаДокумента,
	ДокументИсправительныйСчетФактураПолученный.НаименованиеПродавца,
	ДокументИсправительныйСчетФактураПолученный.АдресПродавца,
	ДокументИсправительныйСчетФактураПолученный.ИННПродавца,
	ДокументИсправительныйСчетФактураПолученный.КПППродавца,
	ДокументИсправительныйСчетФактураПолученный.ФИОРуководителя,
	ДокументИсправительныйСчетФактураПолученный.ФИОГлавногоБухгалтера,
	ДокументИсправительныйСчетФактураПолученный.ИсправляемыйДокумент,
	ДокументИсправительныйСчетФактураПолученный.КодСпособаВыставления,
	ДокументИсправительныйСчетФактураПолученный.КодВидаОперации,
	ДокументИсправительныйСчетФактураПолученный.НомерИсправления,
	ДокументИсправительныйСчетФактураПолученный.ДатаИсправления,
	ДокументИсправительныйСчетФактураПолученный.НомерСчетаФактуры,
	ДокументИсправительныйСчетФактураПолученный.ДатаСчетаФактуры,
	ДокументИсправительныйСчетФактураПолученный.ВсегоУвеличение,
	ДокументИсправительныйСчетФактураПолученный.ВсегоУменьшение,
	ДокументИсправительныйСчетФактураПолученный.СуммаДокумента,
	ДокументИсправительныйСчетФактураПолученный.СуммаНДС,
	ДокументИсправительныйСчетФактураПолученный.Ответственный,
	ДокументИсправительныйСчетФактураПолученный.МоментВремени,
	ВЫБОР
		КОГДА ДокументыСОшибкамиПроверкиКонтрагентов.Документ ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК СодержитНекорректныхКонтрагентов,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
