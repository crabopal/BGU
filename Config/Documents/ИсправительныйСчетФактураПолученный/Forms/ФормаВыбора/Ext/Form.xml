			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументИсправительныйСчетФактураПолученный.Ссылка,
	ДокументИсправительныйСчетФактураПолученный.ВерсияДанных,
