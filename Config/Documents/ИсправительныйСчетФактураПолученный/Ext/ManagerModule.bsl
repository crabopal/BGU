					// поставка оплачена
					Если БухгалтерскийУчет.СчетВИерархии(ТекСтрока.СчетРасчетов, "208.00") Тогда
						Если НЕ СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
							Возврат Ложь;
						КонецЕсли;	
					Иначе
						Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДС, СтруктураШапкиДокумента, ТекСтрока) Тогда
							Возврат Ложь;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

Функция СформироватьДвижениеПоРН_ВходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	// Прежние движения уже отсторнированы, поэтому здесь сторно не формируем
	
	СуммыДвижения = Новый Структура();
	СуммыДвижения.Вставить("СуммаБезНДС",			ТекСтрока.Сумма);
	СуммыДвижения.Вставить("СуммаБезНДСВалютная",	ТекСтрока.СуммаВалютная);
	СуммыДвижения.Вставить("СуммаНДС",				ТекСтрока.СуммаНДС);
	СуммыДвижения.Вставить("СуммаНДСВалютная",		ТекСтрока.СуммаНДСВалютная);
	
	Если СуммыДвижения.СуммаБезНДС = 0
		И СуммыДвижения.СуммаБезНДСВалютная = 0
		И СуммыДвижения.СуммаНДС = 0
		И СуммыДвижения.СуммаНДСВалютная = 0
		Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Движение = Движения.Добавить();
	
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
	
	ЗаполнитьЗначенияСвойств(Движение, СуммыДвижения);
	
	Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
	Движение.Период                 = СтруктураШапкиДокумента.Дата;
	Движение.Организация            = СтруктураШапкиДокумента.Организация;
	Движение.СчетФактура            = СтруктураШапкиДокумента.ИсправляемыйДокумент;
	Движение.ДокументКорректировки  = СтруктураШапкиДокумента.Ссылка;
	Движение.ОбъектНалогообложения  = ?(ТекСтрока.ОбъектНалогообложения = Неопределено,СтруктураШапкиДокумента.Ссылка,ТекСтрока.ОбъектНалогообложения);
	Движение.ПричинаНалогообложения = СтруктураШапкиДокумента.ПричинаНалогообложения;
	
	Возврат Истина;
КонецФункции	

Функция СформироватьДвиженияПоРН_ИсходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока)
	Результат = Истина;
	
	Движение = Движения.ИсходящийНДС.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная");
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("СчетРасчетов",		СтруктураШапкиДокумента.СчетРасчетовАванс);
	ЗначенияПараметров.Вставить("КПССчетРасчетов",	ТекСтрока.КПСВычетКт);
	
	ЗаполнитьЗначенияСвойств(Движение, ЗначенияПараметров);
	
	Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
	Движение.Период                 = СтруктураШапкиДокумента.Дата;
	
	Движение.СчетФактура            = СтруктураШапкиДокумента.Ссылка;
	Движение.ОбъектНалогообложения  = ?(ТекСтрока.ОбъектНалогообложения = Неопределено,СтруктураШапкиДокумента.Ссылка,ТекСтрока.ОбъектНалогообложения);
	
	Движение.СчетДебета             = ТекСтрока.СчетКредита;
	Движение.КОСГУСчетДебета        = БухгалтерскийУчет.КЭКСчета(СтруктураШапкиДокумента.Организация, СтруктураШапкиДокумента.ИФО, ТекСтрока.КФО, СтруктураШапкиДокумента.Дата, Движение.СчетДебета, "Дт");
	
	Возврат Результат;
КонецФункции	

Функция СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	СуммыСторно = ПолучитьСуммыСторно(ТекСтрока);
	
	Если СуммыСторно <> Неопределено Тогда
		
		Если ТекСтрока.МестоРегистрацииСторно = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			ДвижениеСторно = Движения.КнигаПокупок.Добавить();
		Иначе
			ДвижениеСторно = Движения.КнигаПродаж.Добавить();
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, ТекСтрока);
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
		ДвижениеСторно.Период      = СтруктураШапкиДокумента.Дата;
		ДвижениеСторно.СчетФактура = СтруктураШапкиДокумента.ДокументОснование;
		ДвижениеСторно.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
		ДвижениеСторно.СтавкаНДС = ТекСтрока.СтавкаНДСДоИзменения;
		
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, СуммыСторно);
		
	КонецЕсли;
	
	СуммыДвижения = ПолучитьСуммыДвижения(ТекСтрока, СтруктураШапкиДокумента);
	
	Если СуммыДвижения <> Неопределено Тогда
		
		Если ТекСтрока.МестоРегистрацииДвижения = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			Движение = Движения.КнигаПокупок.Добавить();
		Иначе
			Движение = Движения.КнигаПродаж.Добавить();
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
		ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
		Движение.Период      = СтруктураШапкиДокумента.Дата;
		Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
		Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
		
		ЗаполнитьЗначенияСвойств(Движение, СуммыДвижения);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	СуммыСторно = ПолучитьСуммыСторно(ТекСтрока);
	
	Если СуммыСторно <> Неопределено Тогда
		
		Если ТекСтрока.МестоРегистрацииСторно = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			ДвижениеСторно = Движения.ДополнительныеЛистыКнигиПокупок.Добавить();
		Иначе
			ДвижениеСторно = Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, ТекСтрока);
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод");
		ДвижениеСторно.Период      = СтруктураШапкиДокумента.Дата;
		ДвижениеСторно.СчетФактура = СтруктураШапкиДокумента.ДокументОснование;
		ДвижениеСторно.СтавкаНДС = ТекСтрока.СтавкаНДСДоИзменения;
		
		ЗаполнитьЗначенияСвойств(ДвижениеСторно, СуммыСторно);
		
	КонецЕсли;
	
	СуммыДвижения = ПолучитьСуммыДвижения(ТекСтрока, СтруктураШапкиДокумента);
	
	Если СуммыДвижения <> Неопределено Тогда
		
		Если ТекСтрока.МестоРегистрацииДвижения = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
			Движение	= Движения.ДополнительныеЛистыКнигиПокупок.Добавить();
		Иначе
			Движение	= Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
		ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод");
		Движение.Период      = СтруктураШапкиДокумента.Дата;
		Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
		Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
		
		ЗаполнитьЗначенияСвойств(Движение, СуммыДвижения);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

Функция ПолучитьДанныеДляВходящегоНДСпоДокументу(СтруктураШапкиДокумента)
	
	ДокументСсылка		= СтруктураШапкиДокумента.Ссылка;
	Курс				= СтруктураШапкиДокумента.Курс;
	Кратность			= СтруктураШапкиДокумента.Кратность;
	ЭтоКорректировка	= СтруктураШапкиДокумента.ЭтоКорректировка;
	
	СчетаНДСКРаспределению = Новый Массив();
	Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н1");
	Если ЗначениеЗаполнено(Счет) Тогда
		СчетаНДСКРаспределению.Добавить(Счет);
	КонецЕсли;
	Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н2");
	Если ЗначениеЗаполнено(Счет) Тогда
		СчетаНДСКРаспределению.Добавить(Счет);
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка",					ДокументСсылка);
	Запрос.УстановитьПараметр("Курс",							?(ЗначениеЗаполнено(Курс), Курс, 1));
	Запрос.УстановитьПараметр("Кратность",						?(ЗначениеЗаполнено(Кратность), Кратность, 1));
	Запрос.УстановитьПараметр("ЗаполнитьВалютныеСуммы",			УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	Запрос.УстановитьПараметр("ЭтоКорректировка",				ЭтоКорректировка);
	Запрос.УстановитьПараметр("СчетаНДСКРаспределению",			СчетаНДСКРаспределению);
	Запрос.УстановитьПараметр("ПричиныНалогообложенияАванс",	УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияАванс());
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Общая таблица для движений по всем регистрам
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &ЭтоКорректировка И ВсегоДоКорректировки > ВсегоДоИзменения ТОГДА
	|			// Исправляемая полученная корректировка была на уменьшение,
	|			// и поэтому была зарегистрирована в книге продаж
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|	КОНЕЦ										КАК МестоРегистрацииСторно,
	|	ВЫБОР
	|		КОГДА &ЭтоКорректировка И ВсегоДоИзменения > Всего ТОГДА
	|			// Данное исправление полученной корректировки на уменьшение,
	|			// и поэтому должно быть зарегистрировано в книге продаж
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|	КОНЕЦ										КАК МестоРегистрацииДвижения,
	|
	|	НомерСтроки									КАК НомерСтроки,
	|	НДСКВычету									КАК НДСКВычету,
	|	НФА											КАК НФА,
	|
	|		ВЫБОР
	|			КОГДА Ссылка.ПричинаНалогообложения В(&ПричиныНалогообложенияАванс) ТОГДА
	|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|				
	|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) И НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом) ТОГДА
	|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|				
	|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС)
	|				
	|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|				ВЫБОР
	|					КОГДА НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ИЛИ НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) ТОГДА
	|						ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|					ИНАЧЕ
