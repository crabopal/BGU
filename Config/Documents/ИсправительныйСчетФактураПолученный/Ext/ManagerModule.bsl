Процедура ЗаполнитьНаОснованииСчетФактураПолученный(Знач ДокументОснования, Объект, ЗаполнятьШапкуПоОснованию)
	
	ПричинаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснования, "ПричинаНалогообложения");
	
	ЭтоАванс = УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка",		ДокументОснования);
	Запрос.УстановитьПараметр("ЭтоАванс",	ЭтоАванс);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1														КАК НомерИсправления,
	|	СчетФактураПолученный.Организация,
	|	СчетФактураПолученный.ИФО,
	|	СчетФактураПолученный.Подразделение,
	|	СчетФактураПолученный.Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактураПолученный.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|			""""
	|		// Если задано наименование для печати - используем его:
	|		КОГДА НЕ СчетФактураПолученный.Контрагент.НаименованиеСокращенное = """" ТОГДА
	|			СчетФактураПолученный.Контрагент.НаименованиеСокращенное
	|			
	|		// Для юридических лиц есть реквизит НаименованиеПолное:
	|		КОГДА СчетФактураПолученный.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			И НЕ СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|			ВЫРАЗИТЬ(СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное	КАК СТРОКА(1000))
	|			
	|		ИНАЧЕ
	|			СчетФактураПолученный.Контрагент.Наименование
	|	КОНЕЦ													КАК НаименованиеПродавца,
	|	СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.ИНН	КАК ИННПродавца,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица) ТОГДА
	|			СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ													КАК КПППродавца,
	|	СчетФактураПолученный.НомерПервичногоДокумента			КАК НомерСчетаФактуры,
	|	СчетФактураПолученный.ДатаПервичногоДокумента			КАК ДатаСчетаФактуры,
	|	СчетФактураПолученный.Ссылка							КАК ИсправляемыйДокумент,
	|	СчетФактураПолученный.Договор,
	|	СчетФактураПолученный.СуммаДокумента,
	|	СчетФактураПолученный.СуммаНДС,
	|	СчетФактураПолученный.ПричинаНалогообложения,
	|	СчетФактураПолученный.ВидЦенности,
	|	СчетФактураПолученный.ВалютаДокумента,
	|	СчетФактураПолученный.КодВидаОперации,
	|	СчетФактураПолученный.СоставНФА.(
	|		НомерСтроки,
	|		НФА,
	|		ЕдиницаИзмерения,
	|		Количество,
	|		Количество											КАК КоличествоДоИзменения,
	|		СтавкаНДС,
	|		СтавкаНДС											КАК СтавкаНДСДоИзменения,
	|		СуммаНДС,
    |		СуммаНДС											КАК СуммаНДСДоИзменения,
	|		Сумма,
    |		Сумма												КАК СуммаДоИзменения,
	|		Всего,
    |		Всего 												КАК ВсегоДоИзменения,
    |		СуммаАкциза,
    |		СуммаАкциза											КАК СуммаАкцизаДоИзменения,
	|		НДСКВычету,
	|		КПСВычетКт,
	|       КФО,
	|       СчетВычетКт,
	|		Счет30304,
	|       ВЫБОР
	|			КОГДА ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|				Ссылка
	|			ИНАЧЕ
	|				ДокументОснование
	|		КОНЕЦ	КАК ДокументОснование,
	|
	|		Ссылка.ВидЦенности	КАК ВидЦенности
	// Пока в документе применяется реквизит шапки
	//|		ВЫБОР
	//|			КОГДА &ЭтоАванс ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) И НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом) ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	//|				ВЫБОР
	//|					КОГДА НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ИЛИ НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) ТОГДА
	//|						ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	//|					ИНАЧЕ
	//|						ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Материалы)
	//|				КОНЕЦ
	//|				
	//|			ИНАЧЕ
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Прочее)
	//|				
	//|		КОНЕЦ										КАК ВидЦенности
	|	)  Как ОснованиеСоставНФА,
	|	СчетФактураПолученный.ПлатежноРасчетныеДокументы.(
    |		ДатаДокумента	КАК ДатаДокумента,
    |		НомерДокумента	КАК НомерДокумента
	|	) КАК ОснованиеПлатежноРасчетныеДокументы
	|ИЗ
	|	Документ.СчетФактураПолученный 							КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.Ссылка = &Ссылка";
	
	ДанныеЗаполнения = Запрос.Выполнить().Выгрузить();
	
	Шапка		= ДанныеЗаполнения[0];
	СоставНФА	= ДанныеЗаполнения[0]["ОснованиеСоставНФА"];
	ОснованиеПлатежноРасчетныеДокументы	= ДанныеЗаполнения[0]["ОснованиеПлатежноРасчетныеДокументы"];
	
	Объект.ПлатежноРасчетныеДокументы.Загрузить(ОснованиеПлатежноРасчетныеДокументы);
	
	//
	// Аналитика затрат
	//
	Переименование = Новый Структура();
	Переименование.Вставить("ДокументОснование", "ОбъектНалогообложения");
	
	УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "вперед");
	
	УчетНДС.ЗаполнитьАналитикуЗатрат(СоставНФА);
	
	УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "назад");
	
	СоставНФА.Колонки.Добавить("ПроцентНДСкВычетуДоИзменения", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(6,2,ДопустимыйЗнак.Неотрицательный)));
	Колонка = СоставНФА.ВыгрузитьКолонку("ПроцентНДСкВычету");
	СоставНФА.ЗагрузитьКолонку(Колонка, "ПроцентНДСкВычетуДоИзменения");
	
	//
	// Счет расчетов
	//
	УчетНДС.ЗаполнитьСчетРасчетов(СоставНФА);
	
	
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	Объект.СоставНФА.Загрузить(СоставНФА);
	
КонецПРоцедуры

Процедура ЗаполнитьНаОснованииКорректировочныйСчетФактураПолученный(Знач ДокументОснования, Объект, ЗаполнятьШапкуПоОснованию)
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1														КАК НомерИсправления,
	|	Организация				КАК Организация,
	|	ИФО						КАК ИФО,
