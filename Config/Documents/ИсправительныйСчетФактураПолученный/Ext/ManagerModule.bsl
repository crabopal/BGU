// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "", ЗаполнятьШапкуПоОснованию = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;	
	
	ТипДокументаОснования = ТипЗнч(Основание);
	
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		Если НЕ ЭлектронныеДокументыБГУ.ДляДокументаСуществуетЭД(Объект.Ссылка) Тогда
			ЗаполнитьНаОснованииСчетФактураПолученный(Основание,Объект,ЗаполнятьШапкуПоОснованию);
			Объект.ДокументОснование = Основание;
		КонецЕсли;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		Если НЕ ЭлектронныеДокументыБГУ.ДляДокументаСуществуетЭД(Объект.Ссылка) Тогда
			ЗаполнитьНаОснованииКорректировочныйСчетФактураПолученный(Основание,Объект,ЗаполнятьШапкуПоОснованию);
			Объект.ДокументОснование = Основание;
		КонецЕсли;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		Если НЕ ЭлектронныеДокументыБГУ.ДляДокументаСуществуетЭД(Объект.Ссылка) Тогда
			ЗаполнитьНаОснованииИсправительныйСчетФактураПолученный(Основание,Объект,ЗаполнятьШапкуПоОснованию);
			Объект.ДокументОснование = Основание;
		КонецЕсли;
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Если НЕ УчетНДС.ДопустимВводИСФНаОснованииПоступления(Основание, ОписаниеОшибки) Тогда
			ОписаниеОшибки = НСтр("ru='Ввод исправительного счета-фактуры на основании отменен.
				|'") + ОписаниеОшибки;
			
			Возврат Ложь;
		КонецЕсли;
		
		ЗаполнитьНаОснованииПоступлениеМЗ(Основание, Объект, ДополнительныеПараметры);
	КонецЕсли;
	
	Объект.ДатаИсправления = ТекущаяДатаСеанса();
	
	ЗаполнитьРеквизитыСторонСделки(Объект);
	
	Если не ЗначениеЗаполнено(Объект.ВалютаДокумента) тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьДвиженияПоРегистрам(ДокументОбъект, Отказ) Экспорт
	Движения = ДокументОбъект.Движения;
	Для каждого РегистрДвижения из Движения цикл
		Если ТипЗнч(РегистрДвижения) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
			И ТипЗнч(РегистрДвижения) <> Тип("РегистрСведенийНаборЗаписей.ОперацииСПрослеживаемымиТоварами") Тогда
			РегистрДвижения.Записывать = Истина;
			РегистрДвижения.Очистить();
		КонецЕсли;	
	КонецЦикла;
	
	ОперацияДокумента = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОбъект.Ссылка,Новый Структура("КФО,Операция,Курс,Кратность"));
	//
	Если ЗначениеЗаполнено(ОперацияДокумента.Операция) тогда
		СтруктураШапкиДокумента = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОбъект.Ссылка);
		
		СтруктураШапкиДокумента.Вставить("Ссылка",				ДокументОбъект.Ссылка);
		СтруктураШапкиДокумента.Вставить("КФО",					ОперацияДокумента.КФО);
		СтруктураШапкиДокумента.Вставить("Дата",				ДокументОбъект.Дата);
		СтруктураШапкиДокумента.Вставить("ДокументОснование",	ДокументОбъект.ДокументОснование);
		СтруктураШапкиДокумента.Вставить("КорректируемыйПериод",ДокументОбъект.КорректируемыйПериод);
		СтруктураШапкиДокумента.Вставить("ИсправляемыйДокумент",ДокументОбъект.ИсправляемыйДокумент);  
		
		СтруктураШапкиДокумента.Вставить("ЭтоКорректировка",	УчетНДС.ЭтоКорректировка(, ДокументОбъект.ИсправляемыйДокумент));
		СтруктураШапкиДокумента.Вставить("Курс",				ОперацияДокумента.Курс);
		СтруктураШапкиДокумента.Вставить("Кратность",			ОперацияДокумента.Кратность);
		
		ЭтоДопЛист = (СтруктураШапкиДокумента.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок);
		
		СтруктураШапкиДокумента.Вставить("РегистрацияВДопЛисте", ЭтоДопЛист);
		
		УчетНДС.АннулироватьОстаткиВходящегоНДС(
			СтруктураШапкиДокумента["ДокументОснование"],
			СтруктураШапкиДокумента["Дата"],
			Движения);
		
		ТабОснования = ПолучитьДанныеДляВходящегоНДСпоДокументу(СтруктураШапкиДокумента);
		
		Отказ = не СформироватьДвижения(СтруктураШапкиДокумента, ТабОснования, Движения);	
		
		Если не Отказ тогда
			УчетНДС.ЗарегестрироватьСчетФактуру(ДокументОбъект.Ссылка,Движения);
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

