// Движения

Функция СформироватьДвижения(СтруктураШапкиДокумента, ТаблицаДанных, Движения)
	
	Результат = Истина;
	//СчетРаспределения = ПланыСчетов.ЕПСБУ.НайтиПоКоду("210.Н1");
	Если    СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент 
		ИЛИ СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент Тогда
		//---
		// Совместимость с БГУ1
		//---
		// Если это счет-фактура налогового агента, то следует начислить НДС в бюджет и зарегистрироваться
		// в книге продаж или доп. листе книги продаж
		Для каждого ТекСтрока из ТаблицаДанных Цикл
			Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
				Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе	
				Если НЕ СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		
		Возврат Истина;
	ИначеЕсли СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный Тогда
		Для каждого ТекСтрока из ТаблицаДанных Цикл
			
			Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
				Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе
				Если НЕ СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			КонецЕсли;	
			
			СформироватьДвиженияПоРН_ИсходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока);
		КонецЦикла;	
		
		Возврат Истина;
	КонецЕсли;	
	
//******************************************	
	
	Для каждого ТекСтрока из ТаблицаДанных Цикл
