&НаСервере
Процедура ЗаполнитьПоОстаткам()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	СчетаДляЗапроса = БухгалтерскийУчет.СписокСчетов("17,18,ВПЛ,ИОЗ,НКО");
	ЗабалансовыеСчетаПоступленийИВыбытийДенежныхСредств = БухгалтерскийУчет.ПолучитьСвойстваСчетов(
															СчетаДляЗапроса, 
															, 
															"Валютный, УчетПоПодразделениям, КоличествоСубконто");
															
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Счета", 	СчетаДляЗапроса);
	Запрос.УстановитьПараметр("Период", Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(Объект.ФинансовыйГод), 4), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);

	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ВалютаРегламентированногоУчета.Значение) КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК ОстатокДебет,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК ОстатокКредит,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ОстатокВВалютеДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ОстатокВВалютеКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&Счета), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки,
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет.Порядок,
	|	КФО,
	|	КПС,
	|	КЭК,
	|	Валюта";
				   
	 		
	Объект.СчетаУчетаДенежныхСредств.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЗаполнитьКоличествоСубконто();
	
	ВидимостьЭлементов();
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидМежотчетногоПериода) Тогда
		Объект.ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ТехнологическиеОперации");
	КонецЕсли;	

КонецПроцедуры // ЗаполнитьПоОстаткам()

&НаСервере
Процедура ЗаполнитьКоличествоСубконто()

	Для каждого ТекСтрока Из Объект.СчетаУчетаДенежныхСредств Цикл
	
		СвойстваСчета = ЗабалансовыеСчетаПоступленийИВыбытийДенежныхСредств.Получить(ТекСтрока.Счет);
		Если СвойстваСчета <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекСтрока, СвойстваСчета, "УчетПоПодразделениям, Валютный, КоличествоСубконто");
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры // ЗаполнитьКоличествоСубконто()
 
&НаСервере
Процедура ВидимостьЭлементов()
	
	МаксКоличествоСубконто 	= 3;
	УчетПоПодразделениям 	= Ложь;
	Валютный 				= Ложь;
	ИспользуетсяВалюта 		= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	Если Объект.СчетаУчетаДенежныхСредств.Количество() > 0 Тогда
		
		МаксКоличествоСубконто 	= 0;
		
		Для каждого ТекСчет Из ЗабалансовыеСчетаПоступленийИВыбытийДенежныхСредств Цикл
			
			МаксКоличествоСубконто = Макс(МаксКоличествоСубконто, ТекСчет.Значение.КоличествоСубконто);	
			УчетПоПодразделениям = Макс(УчетПоПодразделениям, ТекСчет.Значение.УчетПоПодразделениям);	
			Валютный = Макс(Валютный, ТекСчет.Значение.Валютный);	
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Для ИндексСубконто = МаксКоличествоСубконто + 1 По БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
	
		Элементы["СчетаУчетаДенежныхСредствСубконто" + ИндексСубконто].Видимость = Ложь;	
	
	КонецЦикла;
	
	Для ИндексСубконто = 1 По МаксКоличествоСубконто Цикл
	
		Элементы["СчетаУчетаДенежныхСредствСубконто" + ИндексСубконто].Видимость = Истина;	
	
	КонецЦикла;

	
	Элементы.СчетаУчетаДенежныхСредствПодразделение.Видимость 			= УчетПоПодразделениям;
	Элементы.СчетаУчетаДенежныхСредствВалюта.Видимость 					= Мин(Валютный, ИспользуетсяВалюта);
	Элементы.СчетаУчетаДенежныхСредствГруппаОстатокВВалюте.Видимость 	= Мин(Валютный, ИспользуетсяВалюта);
	Элементы.СчетаУчетаДенежныхСредствИтогОстатокВВалютеКт.Видимость	= Мин(Валютный, ИспользуетсяВалюта);
	Элементы.СчетаУчетаДенежныхСредствИтогОстатокВВалютеДт.Видимость	= Мин(Валютный, ИспользуетсяВалюта);
	
КонецПроцедуры // ВидимостьЭлементов()

