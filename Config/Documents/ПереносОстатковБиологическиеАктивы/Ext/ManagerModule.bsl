//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	//
	
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ВидОперации,Номер");
	
	Если ЗначенияРеквизитов.ВидОперации <> Перечисления.ОперацииПереносОстатковБА.ОсновныеСредства Тогда
		Возврат;
	КонецЕсли;
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"				, ДокументСсылка.МоментВремени());
	Запрос.УстановитьПараметр("НазваниеДокумента"	, НСтр("ru = 'Бухгалтерская справка'"));
	Запрос.УстановитьПараметр("НомерДокумента"		, НомерДокумента);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.Содержание КАК Содержание,
	|	ТаблицаОсновныеСредства.Ссылка.ПеренестиОбесценение КАК ПеренестиОбесценение,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	&НазваниеДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	НЕ ТаблицаОсновныеСредства.СчетУчета.Забалансовый КАК НаБалансе,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.СчетУчета.Забалансовый
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	КОНЕЦ КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка";
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Период КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОсновныеСредства.Период КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.Содержание КАК ПричинаСписания,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И ТаблицаОсновныеСредства.НаБалансе";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.Организация КАК Организация,
	|	СтоимостьОбъектовОСОстатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство, ИнвентарныйНомер, ВидРаспоряжения) В
	|				(ВЫБРАТЬ
	|					ТаблицаОсновныеСредства.Организация КАК Организация,
	|					ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|					ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|					ТаблицаОсновныеСредства.ВидРаспоряжения КАК ВидРаспоряжения
	|				ИЗ
	|					ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОС.Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ТаблицаОС.Организация КАК Организация,
	|	ТаблицаОС.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Договор КАК Договор,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Стоимость КАК Стоимость,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОС.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОС.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОС.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОС.Содержание КАК Причина
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ТаблицаОС.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ТаблицаОС.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|			И ТаблицаОС.ВидРаспоряжения = ВТ_Остатки.ВидРаспоряжения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаОС.НомерСтроки";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.Организация КАК Организация,
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_ОстаткиАм
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство, ИнвентарныйНомер) В
	|				(ВЫБРАТЬ
	|					ТаблицаОсновныеСредства.Организация КАК Организация,
	|					ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|					ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|				ИЗ
	|					ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|				ГДЕ
	|					ТаблицаОсновныеСредства.НаБалансе)) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОС.Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ТаблицаОС.Организация КАК Организация,
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_ОстаткиАм.СуммаАмортизации КАК СуммаАмортизации,
	|	ВТ_ОстаткиАм.СуммаОбесценения КАК СуммаОбесценения,
	|	ИСТИНА КАК ЭтоСписание
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиАм КАК ВТ_ОстаткиАм
	|		ПО ТаблицаОС.ОсновноеСредство = ВТ_ОстаткиАм.ОсновноеСредство
	|			И ТаблицаОС.ИнвентарныйНомер = ВТ_ОстаткиАм.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаОС.НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область ИсточникДанных

Функция ТаблицаОстаткиОС(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ТипЧисло_15_2 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
		ТипСчет = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		ПустаяТаблица.Колонки.Добавить("СчетУчета"			, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("СчетАмортизации"	, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("СчетОбесценения"	, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("ИФО"				, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ПустаяТаблица.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ПустаяТаблица.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("ОсновноеСредство"	, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ПустаяТаблица.Колонки.Добавить("ЦМО"				, Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
		ПустаяТаблица.Колонки.Добавить("Подразделение"		, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
		ПустаяТаблица.Колонки.Добавить("Сумма"				, ТипЧисло_15_2);
		ПустаяТаблица.Колонки.Добавить("СуммаАмортизации"	, ТипЧисло_15_2);
		ПустаяТаблица.Колонки.Добавить("СуммаОбесценения"	, ТипЧисло_15_2);
		
		ПустаяТаблица.Колонки.Добавить("НоменклатураБА"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ПустаяТаблица.Колонки.Добавить("СчетУчетаБА"		, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("СуммаБА"			, ТипЧисло_15_2);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Ссылка.МоментВремени());
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.НоменклатураБА КАК НоменклатураБА,
	|	ОсновныеСредства.СчетУчетаБА КАК СчетУчетаБА,
	|	ОсновныеСредства.ЦенаБА КАК ЦенаБА,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СчетУчета.Забалансовый
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	КОНЕЦ КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Остатки.ЦМО КАК ЦМО,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	Остатки.СтоимостьОстаток КАК Сумма,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство,
	|						ВТ.ИнвентарныйНомер
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Остатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	Остатки.СуммаОбесцененияОстаток КАК СуммаОбесценения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ВТ_ОстаткиАм
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство,
	|						ВТ.ИнвентарныйНомер
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанные.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанные.СчетУчета КАК СчетУчета,
	|	УчетныеДанные.ИФО КАК ИФО,
	|	УчетныеДанные.КФО КАК КФО,
	|	УчетныеДанные.КПС КАК КПС
	|ПОМЕСТИТЬ ВТ_УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК УчетныеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Таблица.СчетУчета КАК СчетУчета,
	|	ВТ_Таблица.НоменклатураБА КАК НоменклатураБА,
	|	ВТ_Таблица.СчетУчетаБА КАК СчетУчетаБА,
	|	ВТ_Остатки.Количество * ВТ_Таблица.ЦенаБА КАК СуммаБА,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Сумма КАК Сумма,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ЕСТЬNULL(ВТ_ОстаткиАм.СуммаАмортизации, 0) КАК СуммаАмортизации,
	|	ЕСТЬNULL(ВТ_ОстаткиАм.СуммаОбесценения, 0) КАК СуммаОбесценения,
	|	ВТ_УчетныеДанные.ИФО КАК ИФО,
	|	ВТ_УчетныеДанные.КФО КАК КФО,
	|	ВТ_УчетныеДанные.КПС КАК КПС,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.СчетОбесценения КАК СчетОбесценения
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Таблица.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ВТ_Таблица.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|			И ВТ_Таблица.ВидРаспоряжения = ВТ_Остатки.ВидРаспоряжения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиАм КАК ВТ_ОстаткиАм
	|		ПО ВТ_Таблица.ОсновноеСредство = ВТ_ОстаткиАм.ОсновноеСредство
	|			И ВТ_Таблица.ИнвентарныйНомер = ВТ_ОстаткиАм.ИнвентарныйНомер
	|			И ВТ_Таблица.ВидРаспоряжения = ВТ_ОстаткиАм.ВидРаспоряжения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УчетныеДанные КАК ВТ_УчетныеДанные
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|			ПО ВТ_УчетныеДанные.СчетУчета = СоответствиеСчетовОС.СчетОС
	|		ПО ВТ_Таблица.ОсновноеСредство = ВТ_УчетныеДанные.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Таблица.НомерСтроки";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ТаблицаОстаткиМЗ(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ТипЧисло_15_2	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
		ТипСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ТипСубконто		= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		ПустаяТаблица.Колонки.Добавить("СчетУчета"			, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("ИФО"				, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ПустаяТаблица.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ПустаяТаблица.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("Номенклатура"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ПустаяТаблица.Колонки.Добавить("Субконто2"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто3"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Подразделение"		, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
		ПустаяТаблица.Колонки.Добавить("Сумма"				, ТипЧисло_15_2);
		
		ПустаяТаблица.Колонки.Добавить("НоменклатураБА"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ПустаяТаблица.Колонки.Добавить("СчетУчетаБА"		, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("СуммаБА"			, ТипЧисло_15_2);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Ссылка.МоментВремени());
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов("105.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Количество КАК Количество,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.Подразделение КАК Подразделение,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.СчетУчета КАК СчетУчета,
	|	Материалы.Сумма КАК Сумма,
	|	Материалы.НоменклатураБА КАК НоменклатураБА,
	|	Материалы.СчетУчетаБА КАК СчетУчетаБА,
	|	Материалы.СуммаБА КАК СуммаБА
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Номенклатура,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ.Номенклатура
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Таблица.СчетУчета КАК СчетУчета,
	|	ВТ_Таблица.Номенклатура КАК Номенклатура,
	|	ВТ_Таблица.КПС КАК КПС,
	|	ВТ_Таблица.ИФО КАК ИФО,
	|	ВТ_Таблица.Подразделение КАК Подразделение,
	|	ВТ_Таблица.КФО КАК КФО,
	|	ВТ_Таблица.НоменклатураБА КАК НоменклатураБА,
	|	ВТ_Таблица.СчетУчетаБА КАК СчетУчетаБА,
	|	ВТ_Таблица.Сумма КАК СуммаМЗ,
	|	ВТ_Таблица.Количество КАК КоличествоМЗ,
	|	ВТ_Таблица.СуммаБА КАК СуммаБА,
	|	ВТ_Остатки.Субконто2 КАК Субконто2,
	|	ВТ_Остатки.Субконто3 КАК Субконто3,
	|	ВТ_Остатки.Количество КАК Количество
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Таблица.Номенклатура = ВТ_Остатки.Номенклатура
	|			И ВТ_Таблица.СчетУчета = ВТ_Остатки.Счет
	|			И ВТ_Таблица.ИФО = ВТ_Остатки.ИФО
	|			И ВТ_Таблица.Подразделение = ВТ_Остатки.Подразделение
	|			И ВТ_Таблица.КФО = ВТ_Остатки.КФО
	|			И ВТ_Таблица.КПС = ВТ_Остатки.КПС
	|ИТОГИ ПО
	|	Номенклатура,
	|	СчетУчета,
	|	ИФО,
	|	Подразделение,
	|	КФО,
	|	КПС";
	
	Данные = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаРезультат = ТаблицаОстаткиМЗ();
	
	Для Каждого Строка1 Из Данные.Строки Цикл
		Для Каждого Строка2 Из Строка1.Строки Цикл
			Для Каждого Строка3 Из Строка2.Строки Цикл
				Для Каждого Строка4 Из Строка3.Строки Цикл
					Для Каждого Строка5 Из Строка4.Строки Цикл
						Для Каждого Строка6 Из Строка5.Строки Цикл
							
							СуммаМЗ = 0;
							СуммаБА = 0;
							
							Для Каждого СтрокаДанные Из Строка6.Строки Цикл
								
								НоваяСтрока = ТаблицаРезультат.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанные);
								
								НоваяСтрока.Сумма = ?(СтрокаДанные.КоличествоМЗ = 0, 0,
									Окр((СтрокаДанные.СуммаМЗ / СтрокаДанные.КоличествоМЗ) * СтрокаДанные.Количество, 2));
								
								НоваяСтрока.СуммаБА = ?(СтрокаДанные.КоличествоМЗ = 0, 0,
									Окр((СтрокаДанные.СуммаБА / СтрокаДанные.КоличествоМЗ) * СтрокаДанные.Количество, 2));
								
								СуммаМЗ = СуммаМЗ + НоваяСтрока.Сумма;
								СуммаБА = СуммаБА + НоваяСтрока.СуммаБА;
								
							КонецЦикла;
							
							Дельта = СтрокаДанные.СуммаМЗ - СуммаМЗ;
							НоваяСтрока.Сумма = НоваяСтрока.Сумма + Дельта;
							
							Дельта = СтрокаДанные.СуммаБА - СуммаБА;
							НоваяСтрока.СуммаБА = НоваяСтрока.СуммаБА + Дельта;
							
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ТаблицаОстаткиВложения(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ТипСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ТипСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		ПустаяТаблица.Колонки.Добавить("СчетУчета"			, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("ИФО"				, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ПустаяТаблица.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ПустаяТаблица.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("Субконто1"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто2"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто3"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Подразделение"		, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
		ПустаяТаблица.Колонки.Добавить("Сумма"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
		
		ПустаяТаблица.Колонки.Добавить("НоменклатураБА"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ПустаяТаблица.Колонки.Добавить("СчетУчетаБА"		, ТипСчет);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Ссылка.МоментВремени());
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вложения.НомерСтроки КАК НомерСтроки,
	|	Вложения.Вложение КАК Вложение,
	|	Вложения.СчетУчета КАК СчетУчета,
	|	Вложения.НоменклатураБА КАК НоменклатураБА,
	|	Вложения.СчетУчетаБА КАК СчетУчетаБА
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.Вложения КАК Вложения
	|ГДЕ
	|	Вложения.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК СчетУчета,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ.Вложение
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.СчетУчета КАК СчетУчета,
	|	ВТ_Остатки.Субконто1 КАК Субконто1,
	|	ВТ_Остатки.Субконто2 КАК Субконто2,
	|	ВТ_Остатки.Субконто3 КАК Субконто3,
	|	ВТ_Остатки.КФО КАК КФО,
	|	ВТ_Остатки.КПС КАК КПС,
	|	ВТ_Остатки.ИФО КАК ИФО,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Сумма КАК Сумма,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ВТ_Таблица.НоменклатураБА КАК НоменклатураБА,
	|	ВТ_Таблица.СчетУчетаБА КАК СчетУчетаБА
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Таблица КАК ВТ_Таблица
	|		ПО ВТ_Остатки.Субконто1 = ВТ_Таблица.Вложение
	|			И ВТ_Остатки.СчетУчета = ВТ_Таблица.СчетУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Таблица.НомерСтроки";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ТаблицаОстаткиВПути(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ТипСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ТипСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		ПустаяТаблица.Колонки.Добавить("СчетУчета"			, ТипСчет);
		ПустаяТаблица.Колонки.Добавить("ИФО"				, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ПустаяТаблица.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ПустаяТаблица.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("Субконто1"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто2"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто3"			, ТипСубконто);
		ПустаяТаблица.Колонки.Добавить("Подразделение"		, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
		ПустаяТаблица.Колонки.Добавить("Сумма"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
		
		ПустаяТаблица.Колонки.Добавить("НоменклатураБА"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ПустаяТаблица.Колонки.Добавить("СчетУчетаБА"		, ТипСчет);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Ссылка.МоментВремени());
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов("107.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВПути.НомерСтроки КАК НомерСтроки,
	|	ВПути.НФА КАК НФА,
	|	ВПути.СчетУчета КАК СчетУчета,
	|	ВПути.НоменклатураБА КАК НоменклатураБА,
	|	ВПути.СчетУчетаБА КАК СчетУчетаБА
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.ВПути КАК ВПути
	|ГДЕ
	|	ВПути.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК СчетУчета,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						ВТ.НФА
	|					ИЗ
	|						ВТ_Таблица КАК ВТ)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.СчетУчета КАК СчетУчета,
	|	ВТ_Остатки.Субконто1 КАК Субконто1,
	|	ВТ_Остатки.Субконто2 КАК Субконто2,
	|	ВТ_Остатки.Субконто3 КАК Субконто3,
	|	ВТ_Остатки.КФО КАК КФО,
	|	ВТ_Остатки.КПС КАК КПС,
	|	ВТ_Остатки.ИФО КАК ИФО,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Сумма КАК Сумма,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ВТ_Таблица.НоменклатураБА КАК НоменклатураБА,
	|	ВТ_Таблица.СчетУчетаБА КАК СчетУчетаБА
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Таблица КАК ВТ_Таблица
	|		ПО ВТ_Остатки.Субконто2 = ВТ_Таблица.НФА
	|			И ВТ_Остатки.СчетУчета = ВТ_Таблица.СчетУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Таблица.НомерСтроки";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

