#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ОчиститьТабличныеЧасти();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьТабличныеЧасти();
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма") + Материалы.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОсновныеСредства.Очистить();
	Материалы.Очистить();
	Вложения.Очистить();
	ВПути.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьТабличныеЧасти()
	
	Если ВидОперации <> Перечисления.ОперацииПереносОстатковБА.ОсновныеСредства Тогда
		ОсновныеСредства.Очистить();
	КонецЕсли;
	Если ВидОперации <> Перечисления.ОперацииПереносОстатковБА.МатериальныеЗапасы Тогда
		Материалы.Очистить();
	КонецЕсли;
	Если ВидОперации <> Перечисления.ОперацииПереносОстатковБА.Вложения Тогда
		Вложения.Очистить();
	КонецЕсли;
	Если ВидОперации <> Перечисления.ОперацииПереносОстатковБА.ВПути Тогда
		ВПути.Очистить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли