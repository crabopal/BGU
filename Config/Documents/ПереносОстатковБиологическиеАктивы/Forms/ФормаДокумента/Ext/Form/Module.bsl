#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваЦенаБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.СуммаБА = ТекущиеДанные.Количество * ТекущиеДанные.ЦенаБА;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетУчетаБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчетаБА) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер,СчетУчетаБА",
		ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер,
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	
	СтрокиТЧ = Объект.ОсновныеСредства.НайтиСтроки(Отбор);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		СтрокаТЧ.СчетУчетаБА = ТекущиеДанные.СчетУчетаБА;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваНоменклатураБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.НоменклатураБА) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер,НоменклатураБА",
		ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер,
		ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	
	СтрокиТЧ = Объект.ОсновныеСредства.НайтиСтроки(Отбор);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		СтрокаТЧ.НоменклатураБА = ТекущиеДанные.НоменклатураБА;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура МатериалыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.СуммаБА = ?(ТекущиеДанные.ЦенаБА = ТекущиеДанные.Цена,
			ТекущиеДанные.Сумма, ТекущиеДанные.Количество * ТекущиеДанные.ЦенаБА);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСуммаБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЦенаБА = ?(ТекущиеДанные.Количество = 0, 0,
			Окр(ТекущиеДанные.СуммаБА / ТекущиеДанные.Количество, 2));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчетаБА) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура,СчетУчетаБА", ТекущиеДанные.Номенклатура,
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	
	СтрокиТЧ = Объект.Материалы.НайтиСтроки(Отбор);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		СтрокаТЧ.СчетУчетаБА = ТекущиеДанные.СчетУчетаБА;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураБАПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.НоменклатураБА) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура,НоменклатураБА", ТекущиеДанные.Номенклатура,
		ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	
	СтрокиТЧ = Объект.Материалы.НайтиСтроки(Отбор);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		СтрокаТЧ.НоменклатураБА = ТекущиеДанные.НоменклатураБА;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВложения

&НаКлиенте
Процедура ВложенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение.Количество() > 0 Тогда
		ЗаполнитьВложенияПодборомМЗ(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВложенияПодборомМЗ(СписокМЗ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П"));
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("СписокМЗ"	, СписокМЗ);
	Запрос.УстановитьПараметр("Период"		, Объект.Дата + 1);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Вложение,
	|	ЕСТЬNULL(Остатки.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчетаБА
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&Период,
	|				Счет В (&СписокСчетов),
	|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|				Организация = &Организация
	|					И Субконто1 В (&СписокМЗ)) КАК Остатки
	|		ПО (Номенклатура.Ссылка = (ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура)))
	|			И (Остатки.КоличествоОстаток <> 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО (""106."" + ПОДСТРОКА(Остатки.Счет.Код, 5, 1) + ""7"" = ЕПСБУ.Код)
	|ГДЕ
	|	Номенклатура.Ссылка В(&СписокМЗ)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура("Вложение,СчетУчета", Выборка.Вложение, Выборка.СчетУчета);
		Если Объект.Вложения.НайтиСтроки(Отбор).Количество() = 0 Тогда
			НоваяСтрока = Объект.Вложения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВПути

&НаКлиенте
Процедура ВПутиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение.Количество() > 0 Тогда
		ТипЭлемента = ТипЗнч(ВыбранноеЗначение[0]);
		Если ТипЭлемента = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ЗаполнитьВПутиПодборомОС(ВыбранноеЗначение);
		ИначеЕсли ТипЭлемента = Тип("СправочникСсылка.Номенклатура") Тогда
			ЗаполнитьВПутиПодборомМЗ(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВПутиПодборомОС(СписокОС)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", БухгалтерскийУчет.СписокСчетов("107.21,107.31"));
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("СписокОС"	, СписокОС);
	Запрос.УстановитьПараметр("Период"		, Объект.Дата + 1);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК НФА,
	|	ЕСТЬNULL(Остатки.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчетаБА
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&Период,
	|				Счет В (&СписокСчетов),
	|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|				Организация = &Организация
	|					И Субконто1 В (&СписокОС)) КАК Остатки
	|		ПО (ОсновныеСредства.Ссылка = (ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства)))
	|			И (Остатки.КоличествоОстаток <> 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО (""107."" + ПОДСТРОКА(Остатки.Счет.Код, 5, 1) + ""4"" = ЕПСБУ.Код)
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&СписокОС)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура("НФА,СчетУчета", Выборка.НФА, Выборка.СчетУчета);
		Если Объект.ВПути.НайтиСтроки(Отбор).Количество() = 0 Тогда
			НоваяСтрока = Объект.ВПути.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
