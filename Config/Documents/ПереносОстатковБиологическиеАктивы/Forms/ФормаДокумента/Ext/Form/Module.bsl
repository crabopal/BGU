Процедура ЗаполнитьСчетБА(ИмяТЧ)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОграниченияСчета", "113.00");
	
	ДопПараметры = Новый Структура("ИмяТЧ", ИмяТЧ);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСчетаБА", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);
	
КонецПроцедуры

