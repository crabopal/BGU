&НаКлиенте
Процедура СоздатьМЗВопрос(ИмяТЧ)
	
	Если Элементы[ИмяТЧ].ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'В справочнике ""Номенклатура"" будут созданы элементы с типом номенклатуры ""Биологические активы""
                         |для выделенных строк табличной части с пустыми значениями в графе ""Биологический актив"".
                         |Продолжить?'");
	
	ДопПараметры = Новый Структура("ИмяТЧ", ИмяТЧ);
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьМЗЗавершение", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМЗЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если Параметры.ИмяТЧ = "ОсновныеСредства" Тогда
			СоздатьМЗизОССервер();
		ИначеЕсли Параметры.ИмяТЧ = "Материалы" Тогда
			СоздатьМЗизМЗСервер();
		ИначеЕсли Параметры.ИмяТЧ = "Вложения" Тогда
			СоздатьМЗизВложенийСервер();
		ИначеЕсли Параметры.ИмяТЧ = "ВПути" Тогда
			СоздатьМЗизВПутиСервер();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьМЗизОССервер()
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ОсновноеСредство"	, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Данные.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	Данные.Колонки.Добавить("СчетУчета"			, Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
		
		СтрокаТЧ = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.НоменклатураБА) Тогда
			
			СтрокаДанные					= Данные.Добавить();
			СтрокаДанные.ОсновноеСредство	= СтрокаТЧ.ОсновноеСредство;
			СтрокаДанные.ИнвентарныйНомер	= СтрокаТЧ.ИнвентарныйНомер;
			СтрокаДанные.СчетУчета			= СтрокаТЧ.СчетУчетаБА;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", Данные);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Таблица.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(Таблица.ИнвентарныйНомер КАК Справочник.ИнвентарныеНомераОС) КАК ИнвентарныйНомер,
	|	ВЫРАЗИТЬ(Таблица.СчетУчета КАК ПланСчетов.ЕПСБУ) КАК СчетУчета
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ОсновноеСредство.Наименование КАК Наименование,
	|	ВТ.ОсновноеСредство.НаименованиеПолное КАК НаименованиеПолное,
	|	ВТ.ОсновноеСредство.ИзготовительОС КАК ИзготовительОС,
	|	ВТ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(ВТ.ИнвентарныйНомер), """") КАК КодИнвентарногоНомера,
	|	ВТ.СчетУчета КАК СчетУчета,
	|	ВТ.СчетУчета.Код КАК КодСчетаУчета
	|ИЗ
	|	ВТ КАК ВТ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЕдШт = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	Пока Выборка.Следующий() Цикл
		
		НовыйЭлемент					= Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.Наименование		= Выборка.Наименование;
		НовыйЭлемент.НаименованиеПолное	= Выборка.НаименованиеПолное;
		НовыйЭлемент.СчетУчета			= Выборка.КодСчетаУчета;
		НовыйЭлемент.ИнвентарныйНомер	= Выборка.КодИнвентарногоНомера;
		НовыйЭлемент.ТипНоменклатуры	= Перечисления.ТипыНоменклатуры.БиологическиеАктивы;
		НовыйЭлемент.Родитель			= Объект.ГруппаБА;
		НовыйЭлемент.ЕдиницаИзмерения	= ЕдШт;
		НовыйЭлемент.ИзготовительОС		= Выборка.ИзготовительОС;
		
		НовыйЭлемент.Записать();
		
		Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер,СчетУчетаБА,НоменклатураБА",
