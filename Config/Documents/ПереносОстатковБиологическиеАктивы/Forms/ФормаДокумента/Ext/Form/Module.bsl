	Элементы.ВПутиПодбор.Доступность			= МожноЗаполнить;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения") Тогда
		
		ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
		
		Если ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
			ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ОтборИФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
			ПараметрыПодбора.Отбор.Вставить("КФО", Объект.ОтборКФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
			ПараметрыПодбора.Отбор.Вставить("Подразделение", Объект.ОтборПодразделение);
		КонецЕсли;
		
		ПараметрыПодбора.Отбор.Вставить("Счет", "106.21,106.31");
		ПараметрыПодбора.Вставить("ВидРаспоряжения", "Вложения");
		ПараметрыПодбора.Вставить("СкрытьКолонки", "ВидНФА,КФО,КПС,Подразделение,Количество,Цена,Сумма");
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ОсновныеСредства") Тогда
		
		ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
		ПараметрыПодбора.Отбор.Вставить("ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
		ПараметрыПодбора.Отбор.Вставить("ТипНФА", ПредопределенноеЗначение("Перечисление.ТипыНФА.Биоресурсы"));
		
		Если ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
			ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ОтборИФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
			ПараметрыПодбора.Отбор.Вставить("КФО", Объект.ОтборКФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
			ПараметрыПодбора.Отбор.Вставить("Подразделение", Объект.ОтборПодразделение);
		КонецЕсли;
		
		Если ОСБаланс Тогда
			ПараметрыПодбора.Отбор.Вставить("Счет", "101.00");
			ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
		Иначе
			ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));
		КонецЕсли;
		
		ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС,ЦМО");
		
		Если Объект.ОсновныеСредства.Количество() > 0 Тогда
			ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	
	ТаблицаОС.Колонки.Добавить("ГрупповойУчет");
	Данные = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"), "ГрупповойУчет");
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		СтрокаОС.ГрупповойУчет = Данные[СтрокаОС.ОсновноеСредство];
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Функция СоответствиеСчетовВложений(СписокСчетов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", СписокСчетов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетСтарый.Ссылка КАК СчетСтарый,
	|	СчетНовый.Ссылка КАК СчетНовый
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК СчетСтарый
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК СчетНовый
	|		ПО (""106."" + ПОДСТРОКА(СчетСтарый.Код, 5, 1) + ""7"" = СчетНовый.Код)
	|ГДЕ
	|	СчетСтарый.Ссылка В(&СписокСчетов)";
	
	Результат = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.СчетСтарый, Выборка.СчетНовый);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения") Тогда
		
		НовыеСтроки = Новый Массив;
		СписокСчетов = Новый Массив;
		
		Таблица = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Отбор = Новый Структура("Вложение,СчетУчета", СтрокаТаблицы.ОсновноеСредство, СтрокаТаблицы.СчетУчета);
			Если Объект.Вложения.НайтиСтроки(Отбор).Количество() = 0 Тогда
				НоваяСтрока = Объект.Вложения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
				НовыеСтроки.Добавить(НоваяСтрока);
				СписокСчетов.Добавить(НоваяСтрока.СчетУчета);
			КонецЕсли;
		КонецЦикла;
		
		СчетСтарыйНовый = СоответствиеСчетовВложений(СписокСчетов);
		
		Для Каждого НоваяСтрока Из НовыеСтроки Цикл
			НоваяСтрока.СчетУчетаБА = СчетСтарыйНовый[НоваяСтрока.СчетУчета];
		КонецЦикла;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ОсновныеСредства") Тогда
		
		ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
			Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
		
		Для Каждого НоваяСтрока Из ДобавленныеСтроки Цикл
			НоваяСтрока.ЦенаБА = НоваяСтрока.Цена;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			ТекущаяСтрока.СуммаБА = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаБА;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОССервер()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	Остатки.Счет КАК СчетУчета
	|ПОМЕСТИТЬ ВТ_РБ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.Биоресурсы)
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И &ОтборГруппаОС) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СтоимостьОстаток КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(Остатки.СтоимостьОстаток / Остатки.КоличествоОстаток КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Цена,
	|	ВТ_РБ.СчетУчета КАК СчетУчета
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_РБ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ВТ_РБ КАК ВТ_РБ)
	|				И Подразделение = &Подразделение) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РБ КАК ВТ_РБ
	|		ПО Остатки.ОсновноеСредство = ВТ_РБ.ОсновноеСредство
	|			И (ВЫБОР
	|				КОГДА Остатки.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ = ВТ_РБ.СчетУчета.Забалансовый)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.ОсновноеСредство.Наименование,
	|	Остатки.ИнвентарныйНомер.Код";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата + 1);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, СчетаСУчетомОтметок("101.00,21"));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
		Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям() И ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ОтборГруппаОС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаОС", "Субконто1 В ИЕРАРХИИ (&ГруппаОС)");
		Запрос.УстановитьПараметр("ГруппаОС", Объект.ОтборГруппаОС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаОС", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.ОсновныеСредства.Загрузить(Результат);
	
	Для Каждого СтрокаОС Из Объект.ОсновныеСредства Цикл
		СтрокаОС.ЦенаБА  = СтрокаОС.Цена;
		СтрокаОС.СуммаБА = СтрокаОС.Сумма;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМЗСервер()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Счет КАК СчетУчета,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Остатки.КоличествоОстатокДт КАК Количество,
	|	Остатки.СуммаОстатокДт КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстатокДт = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И Подразделение = &Подразделение
	|				И &ОтборГруппаМЗ) КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).Наименование";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата + 1);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, СчетаСУчетомОтметок("105.26,105.36"));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.ИФО", "Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
		Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.00").УчетПоПодразделениям;
	
	Если УчетПоПодразделениям И ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;
	Если Не УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.Подразделение", "Значение(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборГруппаМЗ) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаМЗ", "Субконто1 В ИЕРАРХИИ (&ГруппаМЗ)");
		Запрос.УстановитьПараметр("ГруппаМЗ", Объект.ОтборГруппаМЗ);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаМЗ", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.Материалы.Загрузить(Результат);
	
	Для Каждого СтрокаМЗ Из Объект.Материалы Цикл
		СтрокаМЗ.ЦенаБА  = СтрокаМЗ.Цена;
		СтрокаМЗ.СуммаБА = СтрокаМЗ.Сумма;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВложенияСервер()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Счет КАК СчетУчета,
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Вложение
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И Подразделение = &Подразделение
	|				И &ОтборГруппаОС) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Остатки.Счет,
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И Подразделение = &Подразделение
	|				И &ОтборГруппаМЗ) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.НоменклатураБА КАК НоменклатураБА
	|ПОМЕСТИТЬ ВТ_СоответствиеБА
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Материалы.Номенклатура,
	|	Материалы.НоменклатураБА
	|ИЗ
	|	Документ.ПереносОстатковБиологическиеАктивы.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СоответствиеБА.НФА КАК НФА,
	|	МАКСИМУМ(ВТ_СоответствиеБА.НоменклатураБА) КАК НоменклатураБА
	|ПОМЕСТИТЬ ВТ_БА
	|ИЗ
	|	ВТ_СоответствиеБА КАК ВТ_СоответствиеБА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СоответствиеБА.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Вложение КАК Вложение,
	|	ВТ_Остатки.СчетУчета КАК СчетУчета,
	|	ВТ_БА.НоменклатураБА КАК НоменклатураБА,
	|	ЕПСБУ.Ссылка КАК СчетУчетаБА
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БА КАК ВТ_БА
	|		ПО ВТ_Остатки.Вложение = ВТ_БА.НФА
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО (""106."" + ПОДСТРОКА(ВТ_Остатки.СчетУчета.Код, 5, 1) + ""7"" = ЕПСБУ.Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Остатки.СчетУчета.Порядок,
	|	ВТ_Остатки.Вложение.Наименование";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата + 1);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, СчетаСУчетомОтметок("106.21,106.31,106.2П,106.3П"));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
		Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям() И ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ОтборГруппаОС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаОС", "Субконто1 В ИЕРАРХИИ (&ГруппаОС)");
		Запрос.УстановитьПараметр("ГруппаОС", Объект.ОтборГруппаОС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаОС", "ИСТИНА");
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ОтборГруппаМЗ) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаМЗ", "Субконто1 В ИЕРАРХИИ (&ГруппаМЗ)");
		Запрос.УстановитьПараметр("ГруппаМЗ", Объект.ОтборГруппаМЗ);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборГруппаМЗ", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.Вложения.Загрузить(Результат);
	
КонецПроцедуры

