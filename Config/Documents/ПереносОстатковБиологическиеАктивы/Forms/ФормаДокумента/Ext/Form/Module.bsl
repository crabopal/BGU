&НаСервере
Функция СчетаПоКоду(КодыСчетов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ПОМЕСТИТЬ РодительскиеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В (&КодыСчетов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.Код КАК Код,
	|	ЕПСБУ.Наименование,
	|	ЕПСБУ.ДатаНачалаДействия,
	|	ЕПСБУ.ДатаОкончанияДействия
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|		(ВЫБРАТЬ
	|			РодительскиеСчета.Ссылка
	|		ИЗ
	|			РодительскиеСчета КАК РодительскиеСчета)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("КодыСчетов", СтрРазделить(КодыСчетов, ","));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСчетаДляОтбора()
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ОсновныеСредства") Тогда
		СтрокаСчетов = "101.00,21";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.МатериальныеЗапасы") Тогда
		СтрокаСчетов = "105.36,105.26";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения") Тогда
		СтрокаСчетов = "106.21,106.31,106.2П,106.3П";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ВПути") Тогда
		СтрокаСчетов = "107.21,107.23,107.31,107.33";
	Иначе
		СтрокаСчетов = "";
	КонецЕсли;
	
	СчетаДляОтбора.Очистить();
	Для Каждого Счет Из СчетаПоКоду(СтрокаСчетов) Цикл
		Если ЗначениеЗаполнено(Счет.ДатаОкончанияДействия) Тогда
			ПредставлениеСчета = НСтр("ru = '%1 - (до %3) %2'");
		Иначе
			ПредставлениеСчета = НСтр("ru = '%1 - %2'");
		КонецЕсли;
		СчетаДляОтбора.Добавить(Счет.Ссылка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПредставлениеСчета,
			Счет.Код,
			Счет.Наименование,
			Формат(Счет.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy;")));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СчетаСУчетомОтметок(КодыСчетов)
	
	ОтмеченныеСчета = ОтмеченныеСчета();
	Результат = Новый Массив;
	Для Каждого Счет Из СчетаПоКоду(КодыСчетов) Цикл
		Если ОтмеченныеСчета.Количество() = 0
			Или ОтмеченныеСчета.Получить(Счет.Ссылка) <> Неопределено Тогда
			Результат.Добавить(Счет.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтмеченныеСчета()
	Результат = Новый Соответствие;
	Для Каждого Счет Из СчетаДляОтбора Цикл
		Если Счет.Пометка Тогда
			Результат.Вставить(Счет.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура СохранитьОтмеченныеСчета(ТекущийОбъект)
	ТекущийОбъект.ОтборСчета.Очистить();
	Для Каждого Счет Из ОтмеченныеСчета() Цикл
		ТекущийОбъект.ОтборСчета.Добавить().СчетУчета = Счет.Ключ;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОтметитьСохраненныеСчета()
	СохраненныеСчета = Объект.ОтборСчета.Выгрузить();
	СохраненныеСчета.Индексы.Добавить("СчетУчета");
	
	Для Каждого Счет Из СчетаДляОтбора Цикл
		Счет.Пометка = СохраненныеСчета.Найти(Счет.Значение, "СчетУчета") <> Неопределено;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваЗаголовокОС.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОсновноеСредство", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "ОС:");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваЗаголовокБА.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОсновноеСредство", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "БА:");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыЗаголовокМЗ.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.Номенклатура", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "МЗ:");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыЗаголовокБА.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.Номенклатура", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "БА:");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Элементы.СтраницаОС.Видимость = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ОсновныеСредства"));
	Элементы.СтраницаМЗ.Видимость = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.МатериальныеЗапасы"));
	Элементы.СтраницаВложения.Видимость = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения"));
	Элементы.СтраницаВПути.Видимость = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ВПути"));
	
	Элементы.ПеренестиОбесценение.Видимость = Элементы.СтраницаОС.Видимость;
	
	ВидимостьОтборМЗ = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.МатериальныеЗапасы")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ВПути");
	ВидимостьОтборОС = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ОсновныеСредства")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.Вложения")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковБА.ВПути");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОтборГруппаМЗ", "Видимость", ВидимостьОтборМЗ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОтборГруппаОС", "Видимость", ВидимостьОтборОС);
	
КонецПроцедуры

