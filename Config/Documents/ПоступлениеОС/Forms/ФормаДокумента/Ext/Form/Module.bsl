	КапВложенияНоменклатураПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
КонецПроцедуры

&НаСервере
Процедура КапВложенияНоменклатураПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.КапВложения.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ДанныеОС = ПолучитьДанныеОсновногоСредства(ТекущиеДанные.ВнеоборотныйАктив);
	ТекущиеДанные.ВидНФА = ДанныеОС.ВидНФА;
	ТекущиеДанные.ПрослеживаемыйТовар = ?(ВедетсяУчетПрослеживаемыхТоваров,
		ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(ТекущиеДанные.ВнеоборотныйАктив, Объект), Ложь);
	ТекущиеДанные.СтранаПроисхождения = ДанныеОС.СтранаПроисхождения;
	ЕстьПрослеживаемыеТовары = ВычислитьЕстьПрослеживаемыеТовары();
	
КонецПроцедуры

