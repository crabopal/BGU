&НаКлиенте
Процедура КапВложенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.КапВложения.ТекущиеДанные;
		
		КоличествоСтрок = Объект.КапВложения.Количество();
		Если КоличествоСтрок > 1 Тогда
			ПредыдущаяСтрока = Объект.КапВложения[КоличествоСтрок-2];
			ТекущиеДанные.СтавкаНДС = ПредыдущаяСтрока.СтавкаНДС;
			ТекущиеДанные.КПС       = ПредыдущаяСтрока.КПС;
			ТекущиеДанные.КФО       = ПредыдущаяСтрока.КФО;
		Иначе
			ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, Элементы.КапВложения.ТекущиеДанные);
		
		УстановитьЗаголовкиКолонок(ТекущиеДанные);

		Если НЕ ТекущиеДанные.ОтразитьВКарточкеКапвложений Тогда
			ТекущиеДанные.ОтразитьВКарточкеКапвложений = Истина;
		КонецЕсли;	
	КонецЕсли;
	ПрослеживаемостьФормыБГУКлиент.ПриНачалеРедактированияСтроки(Элементы.КапВложения.ТекущиеДанные, Объект.СведенияПрослеживаемости, НоваяСтрока, Копирование);
КонецПроцедуры

