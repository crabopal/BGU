&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ВестиУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() 
		ИЛИ Объект.ДрагоценныеМатериалы.Количество() > 0;
	ЗаполнитьВидНФА();
	
	УстановитьДоступностьРеквизитовОрганизации(ЭтотОбъект);
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьДоступностьРасчетногСчетаГрузоотправителя(ЭтотОбъект);
	УстановитьДоступностьРасчетногСчетаКонтрагента(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	УчетРасчетовКлиентСервер.УправлениеЭлементамиЗачетаАвансов(ЭтаФорма);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	УстановитьЗаголовкиКолонокВсехСтрок();
	УстановитьЗаголовкиКолонокДрагМатериаловВсехСтрок();
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "КапВложения", Ложь);
	
	ПоставщикРезидентТаможенногоСоюза = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	ТребуетсяНапоминаниеУведомленийОВвозе = ТребуетсяНапоминаниеОбУведомленииОВвозе();
	УстановитьПредставлениеНадписиУведомлениеОВвозе();
	УстановитьЗначенияИВидимостьРеквизитовПрослеживаемости();
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы_НДС(ЭтотОбъект);
	УстановитьВидимостьНапоминанияОбУведомленияхОВвозе(ЭтотОбъект);
	УправлениеНФАКлиентСервер.ЗаполнитьСпособУчетаНДСВСтроках(Объект, Объект.КапВложения);
	
	УстановитьВидомостьЭлементовФормы_УчетДрагМатериаловВМЦКапвложений(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_НДС(Форма)
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПринятьНДСКВычетуУказываетсяВШапке = Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КапВложенияСпособУчетаНДС",
		"Видимость", ПринятьНДСКВычетуУказываетсяВСтроках);
	ЭлементыНДСКРаспределению = Новый Массив;
	ЭлементыНДСКРаспределению.Добавить("КапВложенияНДСКРаспределению");
	ЭлементыНДСКРаспределению.Добавить("КапВложенияТекстНДСКРаспределению");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыНДСКРаспределению,
		"Видимость", ПринятьНДСКВычетуУказываетсяВШапке);
	
	Элементы.ФормаПринятьНДСКВычетуУказываетсяВСтроках.Пометка = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)
	
	Элементы = Форма.Элементы;
	
	ВидимостьФлагаОтражатьВПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров;
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ОтражатьВПрослеживаемости");
	ИменаЭлементов.Добавить("КапВложенияПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьФлагаОтражатьВПрослеживаемости);
	ВидимостьРНПТ = Форма.ВедетсяУчетПрослеживаемыхТоваров
		И Форма.Объект.ОтражатьВПрослеживаемости
		И НЕ Форма.ПоставщикРезидентТаможенногоСоюза;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КапВложенияРНПТ",
		"Видимость", ВидимостьРНПТ);
	ВидимостьУведомленияОВвозе = Форма.ВедетсяУчетПрослеживаемыхТоваров
		И Форма.Объект.ОтражатьВПрослеживаемости
		И Форма.ПоставщикРезидентТаможенногоСоюза
		И Форма.ЕстьПрослеживаемыеТовары;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУведомлениеОВвозе",
		"Видимость", ВидимостьУведомленияОВвозе);
	
	ВидимостьРеквизитовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров
		И Форма.Объект.ОтражатьВПрослеживаемости;
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("КапВложенияСтранаПроисхождения");
	ИменаЭлементовПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьРеквизитовПрослеживаемости);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;             

	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("КапВложенияКоличество");
	ТекЭлементы.Добавить("СтраницаСведенияОбОборудовании");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ Объект.ПоступлениеБиблиотечногоФонда);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеТаблицыАвансыЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьАвансыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ДопустимыеВидыНФА = Новый Массив;
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"		, ДопустимыеВидыНФА);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "ПринятиеКУчетуВложения");
	ПараметрыПодбора.Вставить("КолонкиКорзины"	, Новый Структура("ОсновноеСредство", "ВнеоборотныйАктив"));
	
	Если Объект.КапВложения.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОССервер(Результат);
		Если ВедетсяУчетПрослеживаемыхТоваров Тогда
			ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленияхОВвозе", 0.1, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.КапВложения.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ИсходныеДанные = Объект.КапВложения.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ВнеоборотныйАктив");
	
	ДобавленныеСтроки = Новый Массив;
	Объект.КапВложения.Очистить();
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		ЭлементКоллекции = Объект.КапВложения.Добавить();
		СтрокаИсходныхДанных = ИсходныеДанные.Найти(СтрокаТаблицыОС.ВнеоборотныйАктив,"ВнеоборотныйАктив");
		Если СтрокаИсходныхДанных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаИсходныхДанных);
		Иначе
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
		КонецЕсли;
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, ЭлементКоллекции);
			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
		РасчитатьСтроку(ЭлементКоллекции, Объект.СуммаВключаетНДС, "Сумма");
		УстановитьЗаголовкиКолонок(ЭлементКоллекции);
	КонецЦикла;
	
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		ПрослеживаемостьБГУ.ПослеПодбораОС(Объект, ДобавленныеСтроки, "ВнеоборотныйАктив");
		ЕстьПрослеживаемыеТовары = ВычислитьЕстьПрослеживаемыеТовары();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВычислитьЕстьПрослеживаемыеТовары()
	Возврат Объект.СведенияПрослеживаемости.Количество() > 0
		// Для ввозимых товаров необходимо указать РНПТ на сам товар, а не на комлектующие
		Или (Не ПоставщикРезидентТаможенногоСоюза
			И ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.КапВложения));
КонецФункции

