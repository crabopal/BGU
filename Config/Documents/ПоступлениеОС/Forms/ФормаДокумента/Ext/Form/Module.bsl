Процедура КапВложенияНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ТекущиеДанные = Элементы.КапВложения.ТекущиеДанные;
		ТекущиеДанные.ВнеоборотныйАктив = ВыбранноеЗначение.Ссылка;
		ТекущиеДанные.ВидНФА = ВыбранноеЗначение.ВидНФА;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

