	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	СписокНПААмортизация = Новый СписокЗначений;
	СписокНПААмортизация.Добавить(Перечисления.ВидыНФА.НПА);
	СписокНПААмортизация.Добавить(Перечисления.ВидыНФА.КапВложения);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияСчетАмортизации.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияСуммаАмортизации.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.КапВложения.ВидНФА", ВидСравненияКомпоновкиДанных.ВСписке, СписокНПААмортизация);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияСчетОбесценения.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияСуммаОбесценения.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.КапВложения.ВидНФА", ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыНФА.КапВложения);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияЗаголовокВидГТ.Имя);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Вид документа:");

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияЗаголовокНомерДатаГТ.Имя);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "номер / дата / срок действия:");
КонецПроцедуры

