&НаСервере
Функция СчетУчетаПоТипуНФАИСчетуВложенийДляПереданныхЭлектроннымАктомНФА(НФА, СчетУчетаВложений)
	Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.38");
	
	Реквизиты = "ТипНФА";
	ЗначенияРеквизитовНФА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НФА, Реквизиты);

	Реквизиты = "Код";
	ЗначенияРеквизитовСчетаВложений = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетУчетаВложений, Реквизиты);

	ОЦ = Ложь;
	Если ЗначенияРеквизитовСчетаВложений.Код = "106.21" Тогда
		ОЦ = Истина;
	КонецЕсли;
	
	Если ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.БиблиотечныйФонд
		ИЛИ ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Прочие Тогда
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.28");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.38");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Биоресурсы Тогда
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.27");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.37");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Инвентарь Тогда	
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.26");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.36");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.НежилыеПомещения Тогда
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.22");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.32");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Оборудование Тогда
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.24");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.34");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Транспорт Тогда
		Если ОЦ Тогда
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.25");
		Иначе
			Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.35");
		КонецЕсли;	
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.ЖилыеПомещения Тогда	
		Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.11");
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.Сооружения Тогда
		Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.12");
	ИначеЕсли ЗначенияРеквизитовНФА.ТипНФА = Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость Тогда	
		Результат = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.13");
	КонецЕсли;

	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередачеНаСервере()
	УстановитьПривилегированныйРежим(Истина);

	ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя = 
		ДанныеЭлектронногоАктаОПриемеПередачеНФАПоНоменклатуреОтправителя(Объект.Организация, Объект.ДокументОснование);
		
	СведенияПТС = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[1].Выгрузить();
	СведенияКадастровогоУчета = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[2].Выгрузить();
	
	СведенияПоИнвентарнымОбъектамОтправителя = СведенияПоИнвентарнымОбъектамОтправителя(Объект.ДокументОснование);
	Если СведенияПоИнвентарнымОбъектамОтправителя.Количество() > 0 Тогда
		ИспользуетсяДата = Истина;
		ИспользуетсяКФО = Истина;
		ИспользуетсяКПС = Истина;
		
		ЗагружатьСведенияОШтрихкодахОбъектовНФА = ЭлектронныеДокументыБГУ.ЗагружатьСведенияОШтрихкодахОбъектовНФА(Объект.Организация);
		ТаблицаШтрихкодовОСАкта = ЭлектронныеДокументыБГУ.ПустаяТаблицаШтрихкодовОСАкта();
		
		ШаблонФормированияИнвНомеров = ПолучитьШаблонИнвНомера(Объект.Организация, Объект.Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
		
		GUIDИнвентарныеНомераОтправителя = Новый Массив;
		Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
			GUIDИнвентарныеНомераОтправителя.Добавить(ТекСтрока.GUIDИнвентарногоНомераУОтправителя);
		КонецЦикла;
		ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя = 
			ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя(Объект.Организация, GUIDИнвентарныеНомераОтправителя, Объект.ДокументОснование);
			
		ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[0].Выгрузить();
		ОбремененияПоИнвентарнымНомерамОтправителя = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[1].Выгрузить();
		СвязанныеКонтрагенты = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[2].Выгрузить();
		СведенияОСодержанииДрагМатериалов = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[3].Выгрузить();
		СведенияПТС = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[4].Выгрузить();
		СведенияКадастровогоУчета = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[5].Выгрузить();
		СведенияОШтрихкодах = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[6].Выгрузить();
		
		ИнвентарныйНомерДата = Объект.Дата;
		ИФО = Объект.ИФО;
		
		Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
			ТекНФА = Справочники.ОсновныеСредства.ПустаяСсылка();
			ИнвентарныйНомерКПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекСтрока.ИдентификаторСтроки);
			НайденныеСтроки = Объект.КапВложения.НайтиСтроки(ПараметрыОтбора);
			ИнвентарныйНомерКФО = Перечисления.КВД.ПустаяСсылка();
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекНФА = НайденныеСтроки[0].ВнеоборотныйАктив;
				ИнвентарныйНомерКПС = НайденныеСтроки[0].КПС;
				СчетУчетаВложений = НайденныеСтроки[0].СчетУчета;
				СчетУчета = СчетУчетаПоТипуНФАИСчетуВложенийДляПереданныхЭлектроннымАктомНФА(ТекНФА, СчетУчетаВложений);
				ИнвентарныйНомерКФО = НайденныеСтроки[0].КФО;
			КонецЕсли;
			
			РеестровыйНомер = ТекСтрока.РеестровыйНомер;
			ЗаводскойНомер = ТекСтрока.ЗаводскойНомер;
			НомерПаспорта = ТекСтрока.НомерПаспорта;
			ИнойНомер = ТекСтрока.ИнойНомер;
			ДатаВыпуска = ТекСтрока.ДатаВыпуска;
			ИнвентарныйНомерУОтправителя = ТекСтрока.ИнвентарныйНомерУОтправителя;
			GUIDИнвентарногоНомераУОтправителя = ТекСтрока.GUIDИнвентарногоНомераУОтправителя;
			
			НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
			Если ЗначениеЗаполнено(GUIDИнвентарногоНомераУОтправителя) Тогда
				ПараметрыОтбораИнвНомера = Новый Структура;
				ПараметрыОтбораИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя", GUIDИнвентарногоНомераУОтправителя);
				НайденныеСтрокиИнвНомера = ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя.НайтиСтроки(ПараметрыОтбораИнвНомера);
				Если НайденныеСтрокиИнвНомера.Количество()>0 Тогда
					НовыйИнвНомерСсылка = НайденныеСтрокиИнвНомера[0].Ссылка;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйИнвНомерСсылка) Тогда
				
				ПараметрыИнвНомера = Новый Структура;
				ПараметрыИнвНомера.Вставить("Дата"				, ИнвентарныйНомерДата);
				ПараметрыИнвНомера.Вставить("КФО"				, ИнвентарныйНомерКФО);
				ПараметрыИнвНомера.Вставить("КПС"				, ИнвентарныйНомерКПС);
				ПараметрыИнвНомера.Вставить("СчетУчета"			, СчетУчета);
				ПараметрыИнвНомера.Вставить("ИФО"				, ИФО);
				ПараметрыИнвНомера.Вставить("ОсновноеСредство"	, ТекНФА);
				
				ПараметрыИнвНомера.Вставить("ИнвентарныйНомерУОтправителя"	, ИнвентарныйНомерУОтправителя);
				ПараметрыИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя"	, GUIDИнвентарногоНомераУОтправителя);
				
				ПараметрыИнвНомера.Вставить("РеестровыйНомер"	, РеестровыйНомер);
				ПараметрыИнвНомера.Вставить("ЗаводскойНомер"	, ЗаводскойНомер);
				ПараметрыИнвНомера.Вставить("НомерПаспорта"	, НомерПаспорта);
				ПараметрыИнвНомера.Вставить("ИнойНомер"	, ИнойНомер);
				ПараметрыИнвНомера.Вставить("ДатаВыпуска"	, ДатаВыпуска);
				
				Отказ = Ложь;
				
				//Обременения по инвентарному номеру
				НайденныеСтрокиОбременений = ОбремененияПоИнвентарнымНомерамОтправителя.НайтиСтроки(ПараметрыОтбораИнвНомера);
				
				НовыйИнвНомерСсылка = СоздатьНовыйИнвентарныйНомер(Объект.Организация, ТекНФА, ПараметрыИнвНомера, ШаблонФормированияИнвНомеров, НайденныеСтрокиОбременений, СвязанныеКонтрагенты, Отказ);
			КонецЕсли;	

			//Заполнение сведений о содержании драгоценных материалов
			НайденныеСтрокиИнвНомераДМ = СведенияОСодержанииДрагМатериалов.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Для Каждого ТекДрагМатериал Из НайденныеСтрокиИнвНомераДМ Цикл
				НоваяСтрокаДМ = Объект.ДрагоценныеМатериалы.Добавить();
				
				ВидДрагМатериала = ЭлектронныеДокументыБГУ.ВидДрагМатериала(ТекДрагМатериал.КодВидаДрагоценногоМатериала, ТекДрагМатериал.ПолноеНаимВидаДрагоценногоМатериала);
				ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекДрагМатериал.ЕдИзмКод);
				
				НоваяСтрокаДМ.ОбъектНФА = ТекНФА;
				НоваяСтрокаДМ.ИнвНомер = НовыйИнвНомерСсылка;
				НоваяСтрокаДМ.ВидДрагМатериала = ВидДрагМатериала;
				НоваяСтрокаДМ.МассаДМ = ТекДрагМатериал.МассаДМ;
				НоваяСтрокаДМ.КоличествоДМ = ТекДрагМатериал.КоличествоДМ;
				НоваяСтрокаДМ.ЕдИзм = ЕдИзм;
			КонецЦикла;
			
			//Заполнение сведений ПТС
			НайденныеСтрокиИнвНомераПТС = СведенияПТС.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Для Каждого ТекДанныеПТС Из НайденныеСтрокиИнвНомераПТС Цикл
				НаборЗаписей = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
				НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
				НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() = 0 Тогда
					НоваяЗапись = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьМенеджерЗаписи();
					НоваяЗапись.Организация = Объект.Организация;
					НоваяЗапись.ОсновноеСредство = ТекНФА;
					НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеПТС);
					НоваяЗапись.ДвигательМодель = ТекДанныеПТС.МодельДвигателя;
					НоваяЗапись.ДвигательНомер = ТекДанныеПТС.НомерДвигателя;
					НоваяЗапись.Период = '19800101';
					НоваяЗапись.Записать(Ложь);
				КонецЕсли;	
			КонецЦикла;

			//Заполнение сведений кадастрового учета
			НайденныеСтрокиИнвНомераКадастра = СведенияКадастровогоУчета.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Для Каждого ТекДанныеКадастра Из НайденныеСтрокиИнвНомераКадастра Цикл
				НаборЗаписей = РегистрыСведений.СведенияКадастровогоУчета.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
				НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
				НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() = 0 Тогда
					НоваяЗапись = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
					НоваяЗапись.Организация = Объект.Организация;
					НоваяЗапись.ОсновноеСредство = ТекНФА;
					НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеКадастра);
					НоваяЗапись.КадастровыйНомерЗемлиНедвижимости = ТекДанныеКадастра.КадастровыйНомерЗемли;
					НоваяЗапись.Период = '19800101';
					НоваяЗапись.Записать(Ложь);
				КонецЕсли;	
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе	
		Для Каждого ТекСтрока Из Объект.КапВложения Цикл
			ТекНФА = ТекСтрока.ВнеоборотныйАктив;
			НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
			
			Реквизиты = "GUIDНоменклатурыОтправителя";
			ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНФА, Реквизиты);
			GUIDНоменклатурыОтправителя = ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя;
			
			ПараметрыОтбораИнвНомера = Новый Структура;
			ПараметрыОтбораИнвНомера.Вставить("GUIDНоменклатурыУОтправителя", GUIDНоменклатурыОтправителя);
			
			//Заполнение сведений ПТС
			НайденныеСтрокиИнвНомераПТС = СведенияПТС.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Для Каждого ТекДанныеПТС Из НайденныеСтрокиИнвНомераПТС Цикл
				НаборЗаписей = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
				НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
				НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() = 0 Тогда
					НоваяЗапись = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьМенеджерЗаписи();
					НоваяЗапись.Организация = Объект.Организация;
					НоваяЗапись.ОсновноеСредство = ТекНФА;
					НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеПТС);
					НоваяЗапись.ДвигательМодель = ТекДанныеПТС.МодельДвигателя;
					НоваяЗапись.ДвигательНомер = ТекДанныеПТС.НомерДвигателя;
					НоваяЗапись.Период = '19800101';
					НоваяЗапись.Записать(Ложь);
				КонецЕсли;	
			КонецЦикла;

			//Заполнение сведений кадастрового учета
			НайденныеСтрокиИнвНомераКадастра = СведенияКадастровогоУчета.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Для Каждого ТекДанныеКадастра Из НайденныеСтрокиИнвНомераКадастра Цикл
				НаборЗаписей = РегистрыСведений.СведенияКадастровогоУчета.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
				НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
				НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() = 0 Тогда
					НоваяЗапись = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
					НоваяЗапись.Организация = Объект.Организация;
					НоваяЗапись.ОсновноеСредство = ТекНФА;
					НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеКадастра);
					НоваяЗапись.КадастровыйНомерЗемлиНедвижимости = ТекДанныеКадастра.КадастровыйНомерЗемли;
					НоваяЗапись.Период = '19800101';
					НоваяЗапись.Записать(Ложь);
				КонецЕсли;	
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Функция ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя(Организация, GUIDИнвентарныхНомеровУОтправителя, ЭлектронныйАктОПриемеПередаче)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК Ссылка,
	               |	ИнвентарныеНомераОС.ОС КАК ОС,
	               |	ИнвентарныеНомераОС.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.GUIDИнвентарногоНомераУОтправителя В(&GUIDИнвентарныхНомеровУОтправителя)
	               |	И ИнвентарныеНомераОС.Владелец = &Организация
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Ссылка КАК Ссылка,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.НомерСтроки КАК НомерСтроки,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ИнвентарныйНомерУОтправителя КАК ИнвентарныйНомерУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.НаименованиеЧасти КАК НаименованиеЧасти,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.РазмерЧасти КАК РазмерЧасти,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ВидОбременения КАК ВидОбременения,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДатаНачала КАК ДатаНачала,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДатаОкончания КАК ДатаОкончания,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияВид КАК ДокументОбремененияВид,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияДата КАК ДокументОбремененияДата,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Контрагент КАК Контрагент,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдИзмКод КАК ЕдИзмКод,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдИзмНаим КАК ЕдИзмНаим,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.GUIDКонтрагента КАК GUIDКонтрагента
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ОбремененияПоИнвентарнымОбъектамНФА КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Ссылка = &ЭлектронныйАктОПриемеПередаче
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.Ссылка КАК Ссылка,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.НомерСтроки КАК НомерСтроки,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.GUIDКонтрагента КАК GUIDКонтрагента,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.ИНН КАК ИНН,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.КПП КАК КПП,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.ОГРН КАК ОГРН,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.ОГРНИП КАК ОГРНИП,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.НаименованиеКонтрагента КАК НаименованиеКонтрагента
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.СвязанныеКонтрагенты КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.Ссылка = &ЭлектронныйАктОПриемеПередаче
	               |;
	               |
