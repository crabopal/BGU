	СписокСчетов = Новый СписокЗначений;
	СписокСчетов.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("106.2D,106.2I,106.2N,106.2R,106.3D,106.3I,106.3N,106.3R,106.60,106.9I"));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.КапВложенияСПИОпределен.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.КапВложения.СчетУчета", ВидСравненияКомпоновкиДанных.НеВСписке, СписокСчетов);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
