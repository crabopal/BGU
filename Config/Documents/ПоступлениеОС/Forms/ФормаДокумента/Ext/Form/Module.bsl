&НаКлиенте
Процедура ЗаполнитьРеквизитыКапВложения(Команда)
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("СчетУчета", Новый Структура);
	Реквизиты.СчетУчета.Вставить("Счета", "106.00");
	Реквизиты.СчетУчета.Вставить("ВИерархии", Истина);
	Реквизиты.СчетУчета.Вставить("Дата", Объект.Дата);

	Реквизиты.Вставить("КФО");
	
	Реквизиты.Вставить("КПС", Новый Структура);
	Реквизиты.КПС.Вставить("НаДату", Объект.Дата);
	Реквизиты.КПС.Вставить("Организация", Объект.Организация);
	Реквизиты.КПС.Вставить("ИФО", Объект.ИФО);
	
	ВидыПоказателей = Новый Массив;
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	Реквизиты.КПС.Вставить("ВидПоказателя", ВидыПоказателей);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"ПоступлениеОС", "КапВложения", "КапВложения", Реквизиты);
КонецПроцедуры

