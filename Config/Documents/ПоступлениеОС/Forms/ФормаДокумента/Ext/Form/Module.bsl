	ДопПараметры = ОбщегоНазначенияБГУКлиент.СтруктураПараметровВыбораКомисии(ЭтотОбъект);
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Объект.Комиссия, ДопПараметры, Объект);
	
