&НаСервереБезКонтекста
Функция ПолучитьДанныеОсновногоСредства(Знач ОсновноеСредство)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, "ВидНФА, СтранаПроисхождения");

КонецФункции // ПолучитьДанныеОсновногоСредства()

&НаСервере
Процедура ЗаполнитьВидНФА()

	ЗначенияСвойств = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.КапВложения.Выгрузить(,"ВнеоборотныйАктив").ВыгрузитьКолонку("ВнеоборотныйАктив"), "ВидНФА");
	Для каждого ТекСтр Из Объект.Капвложения Цикл
		
		ТекКапВложение = ЗначенияСвойств[ТекСтр.ВнеоборотныйАктив];
		Если ТекКапВложение <> Неопределено Тогда
			ТекСтр.ВидНФА =  ТекКапВложение.ВидНФА;
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры // ЗаполнитьВидНФА()

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоВсемКФО", Истина);
	ПараметрыЗаполнения.Вставить("ПоВсемКПС", Истина);
	
	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Если НЕ Отказ Тогда
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОтменитьПроведениеПередЗаполнениемДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ЭтотОбъект.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетКонтрагента(Знач КонтрагентСсылка, ИмяВладельцаСчета, ИмяРеквизитаСчет)
	
	Возврат Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(КонтрагентСсылка,
		"Документ.ПоступлениеОС", , ИмяРеквизитаСчет, ИмяВладельцаСчета);
	
КонецФункции

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	Для Каждого СтрокаТЧ из Объект.КапВложения Цикл
		РасчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма");
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта_Параметры();
	ПараметрыПредставления.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыПредставления.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
	ПараметрыПредставления.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	ПараметрыПредставления.ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПараметрыПредставления.ПоказыватьНДС = Истина;
	ПараметрыПредставления.УчитыватьНДС = ПараметрыПредставления.ПоказыватьНДС;
	ПараметрыПредставления.ПоказыватьВалюту = Форма.КэшПараметров.ИспользоватьВалютныйУчет;
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиКолонок(ТекущаяСтрока)

	ТекущаяСтрока.ТекстСчетАмортизации = НСтр("ru = 'Счет:'");
	ТекущаяСтрока.ТекстСуммаАмортизации = НСтр("ru ='Сумма:'");

КонецПроцедуры // УстановитьЗаголовкиКолонок()

&НаСервере
Процедура УстановитьЗаголовкиКолонокВсехСтрок()

	Для каждого ТекущаяСтрока Из Объект.КапВложения Цикл
	
		УстановитьЗаголовкиКолонок(ТекущаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьОтветственного()
	
	Объект.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(
		Объект.Ответственный, Объект.Организация, "Документ.ПоступлениеОС");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНадписиУведомлениеОВвозе()
	
	ПрослеживаемостьФормыБГУ.УстановитьПредставлениеНадписиУведомлениеОВвозе(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НапоминатьОбУведомленияхОВвозе()
	
	РассчитатьНеобходимостьНапоминанияОВвозе();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьНапоминанияОбУведомленияхОВвозе(Форма)

	Если Форма.ПоказыватьБаннерУведомленийОВвозе Тогда
		ШаблонТекста = НСтр("ru = 'В документе присутствуют прослеживаемые товары. До %1 необходимо создать и отправить уведомление о ввозе в налоговую инспекцию и получить РНПТ.'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияУведомление",
			"Заголовок",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекста, Формат(Форма.СрокУведомленияОВвозе, "ДФ='дд ММММ'")));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаБаннерУведомлениеОВвозе",
			"Видимость", Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаБаннерУведомлениеОВвозе",
			"Видимость", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТребуетсяНапоминаниеОбУведомленииОВвозе()
	
	ЕстьПрослеживаемыеТовары = ВычислитьЕстьПрослеживаемыеТовары();
	
	Возврат ЕстьПрослеживаемыеТовары
		И ПоставщикРезидентТаможенногоСоюза
		И Объект.ОтражатьВПрослеживаемости;

КонецФункции

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.КапВложения.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.КапВложения.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияИВидимостьРеквизитовПрослеживаемости()

	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ПрослеживаемостьБГУ.ОбновитьПризнакПрослеживаемости(Объект, Объект.КапВложения, ВедетсяУчетПрослеживаемыхТоваров, "ВнеоборотныйАктив");
	РассчитатьНеобходимостьНапоминанияОВвозе();

КонецПроцедуры

&НаСервере
Процедура РассчитатьНеобходимостьНапоминанияОВвозе()
	
	ТребуетсяНапоминаниеДо = ТребуетсяНапоминаниеУведомленийОВвозе;
	ПоказыватьБаннерДо     = ПоказыватьБаннерУведомленийОВвозе;
	
	ТребуетсяНапоминаниеУведомленийОВвозе = ТребуетсяНапоминаниеОбУведомленииОВвозе();
	ПоказыватьБаннерУведомленийОВвозе     = ТребуетсяНапоминаниеУведомленийОВвозе И СписокУведомлений.Количество() = 0 И НЕ ОтключитьБаннерУведомленийОВвозе;
	Если ПоказыватьБаннерУведомленийОВвозе Тогда
		СрокУведомленияОВвозе = ПрослеживаемостьБГУ.СрокПодачиУведомления(Объект.Дата);
	КонецЕсли;
	
	Если ОбновитьСрокОтправкиУведомленийОВвозе
		ИЛИ ТребуетсяНапоминаниеДо <> ТребуетсяНапоминаниеУведомленийОВвозе
		ИЛИ ПоказыватьБаннерДо <> ПоказыватьБаннерУведомленийОВвозе Тогда
		
		УстановитьВидимостьНапоминанияОбУведомленияхОВвозе(ЭтотОбъект);
		ОбновитьСрокОтправкиУведомленийОВвозе = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости(Форма)

	Если НЕ Форма.ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;

	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.ПоступлениеОтПоставщика = Истина;
	ВидыОперацийПрослеживаемости.ПрочееПоступление = Истина;
	ВидыОперацийПрослеживаемости.ВозвратОтПокупателя = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
