	ДанныеДляПечати.Вставить("ВыборкаНФА"			, Результат[05].Выбрать());
	ДанныеДляПечати.Вставить("СоставКомиссий"		, Результат[06].Выгрузить());
	ДанныеДляПечати.Вставить("ЕГРН"					, Результат[08].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("ПТС"					, Результат[09].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("Характеристики"		, Результат[10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("Драгметаллы"			, Результат[11].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("ВыборкаФайлы"			, Результат[12].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаОбременения"	, Результат[13].Выбрать());
	ДанныеДляПечати.Вставить("ДатыОкончанияАмортизации", Результат[14].Выгрузить());
	ДанныеДляПечати.Вставить("ВыборкаФайлыАктаЭДО"	, Результат[15].Выбрать());
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ДанныеДляПечатиОтветного0510448(МассивОбъектов) Экспорт
	
	ДанныеДляПечати = ДанныеДляПечати0510448_КВ(МассивОбъектов);
	
	ВыборкаДокументов  = ДанныеДляПечати.ВыборкаДокументов;
	ВыборкаОС          = ДанныеДляПечати.ВыборкаНФА;
	ВыборкаФайлы       = ДанныеДляПечати.ВыборкаФайлы;
	СоставКомиссий     = ДанныеДляПечати.СоставКомиссий;
	ВыборкаОбременения = ДанныеДляПечати.ВыборкаОбременения;
	ВыборкаФайлыАктаЭДО = ДанныеДляПечати.ВыборкаФайлыАктаЭДО;
	
	ДатыОкончанияАморт = Неопределено;
	Если ДанныеДляПечати.Свойство("ДанныеДляПечати") Тогда
		ДатыОкончанияАморт = ДанныеДляПечати.ДатыОкончанияАмортизации;
	КонецЕсли;	
	
	ДопКолонки = "НомерСтроки,НФА,НаименованиеНФА,Адрес,Назначение";
	Справочники.ОсновныеСредства.ИнициализироватьПараметрыДопХарактеристик(ДанныеДляПечати);
	ПустыеДанныеСтрокиХарактеристик = Новый Структура(ДопКолонки);
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		СтрокаДокумента = ДанныеДокументов.Добавить();
		СтрокаДокумента.ИндивидуальныеХарактеристики = УправлениеПечатьюБГУ.ТаблицаИндивидуальныеХарактеристикиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПередаваемыеОбъекты = УправлениеПечатьюБГУ.ТаблицаСведенияОПередаваемыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА = УправлениеПечатьюБГУ.ТаблицаСведенияОПринятыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СведенияОбОграничениях = УправлениеПечатьюБГУ.ТаблицаСведенияОбОграниченияхАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиПриказ61н();
		СтрокаДокумента.Файлы = ЭлектронныеДокументыБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		
		// Данные руководителя
		РуководительЕстьВЗапросе = Ложь;
		Если ВыборкаДокументов.Владелец().Колонки.Найти("Руководитель") <> Неопределено И ЗначениеЗаполнено(ВыборкаДокументов["Руководитель"]) Тогда
			РуководительЕстьВЗапросе = Истина;
		КонецЕсли;
		
		Если Не РуководительЕстьВЗапросе Тогда
			СтрокаДокумента.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.Дата, ВыборкаДокументов.СтруктурноеПодразделение).ОтветственноеЛицоСсылка;
		КонецЕсли;	

		// Шапка
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		
		// Раздел 1
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		ТаблицаХарактеристик = ДанныеДляПечати.ТаблицаХарактеристики.СкопироватьКолонки();
		СписокКолонок = СтрРазделить(ДопКолонки, ",");
		Для Каждого Колонка Из СписокКолонок Цикл
			ТаблицаХарактеристик.Колонки.Добавить(Колонка);
		КонецЦикла;
		
		ВыборкаОС.Сбросить();
		
		Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
			Если ВыборкаДокументов.Передача Тогда
				
				СтрокаПередача = СтрокаДокумента.ПередаваемыеОбъекты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПередача, ВыборкаОС);
				
				СтрокаПередача.СрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
					ВыборкаОС.ДатаВводаВЭксплуатацию, ?(ВыборкаДокументов.Принятие,
					ВыборкаДокументов.Дата, ВыборкаДокументов.ДатаСписания));
				
				ПоискДаты = Новый Структура;
				ПоискДаты.Вставить("НФА", ВыборкаОС.НФА);
				ПоискДаты.Вставить("ИнвентарныйНомер", ВыборкаОС.ИнвентарныйНомерСсылка);
				
				Если ДатыОкончанияАморт <> Неопределено Тогда
					НайденныеДаты = ДатыОкончанияАморт.НайтиСтроки(ПоискДаты);
					Если НайденныеДаты.Количество() > 0 И ЗначениеЗаполнено(НайденныеДаты[0].ДатаОкончанияАмортизации) Тогда
						СтрокаПередача.ДатаОкончанияАмортизации = НайденныеДаты[0].ДатаОкончанияАмортизации;
					КонецЕсли;	
				КонецЕсли;	
				
			КонецЕсли;
			
			ДанныеДляПечати.Вставить("МожетСодержатьДрагМатериалы", ВыборкаОС.МожетСодержатьДрагМатериалы);
			ДанныеДляПечати.Вставить("ДатаСписания", ВыборкаДокументов.ДатаСписания);
			
			СтруктураПоискаОС = Новый Структура("ОсновноеСредство", ВыборкаОС.НФА);
			Справочники.ОсновныеСредства.ЗаполнитьТаблицуДопХарактеристик(
				ДанныеДляПечати, СтруктураПоискаОС,, ВыборкаОС.ИнвентарныйНомерСсылка);
			Если ДанныеДляПечати.ТаблицаХарактеристики.Количество() = 0
				И ТипЗнч(ВыборкаОС.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаХар = ТаблицаХарактеристик.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС);
			Иначе
				Для НомерСтроки = 1 По ДанныеДляПечати.ТаблицаХарактеристики.Количество() Цикл
					СтрокаХар = ТаблицаХарактеристик.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаХар, ДанныеДляПечати.ТаблицаХарактеристики[НомерСтроки-1]);
					Если НомерСтроки = 1 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС, ДопКолонки);
					ИначеЕсли НомерСтроки = 2 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ПустыеДанныеСтрокиХарактеристик);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// Раздел 2
		
		Для Каждого СтрокаХарактеристик Из ТаблицаХарактеристик Цикл
			СтрокаИндивидуальныеХарактеристики = СтрокаДокумента.ИндивидуальныеХарактеристики.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИндивидуальныеХарактеристики, СтрокаХарактеристик);
		КонецЦикла;
		
		// Раздел 3
		
		Если ВыборкаОбременения <> Неопределено Тогда
			
			ВыборкаОС.Сбросить();
			Пока ВыборкаОС.Следующий() Цикл
				ОтборОС = Новый Структура("ОсновноеСредство, ИнвНомер", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ПараметрыОтбора = Новый Структура("НФА, ИнвентарныйНомерСсылка", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ВыборкаОбременения.Сбросить();
				Пока ВыборкаОбременения.НайтиСледующий(ОтборОС) Цикл
					СтрокаОграничения = СтрокаДокумента.СведенияОбОграничениях.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОС);
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОбременения);
					СтрокаОграничения.НФА = ВыборкаОбременения.ОсновноеСредство;
					Контрагент = ВыборкаОбременения.Контрагент;
					
					Реквизиты = "ИНН, КПП, ЮридическоеФизическоеЛицо, ВидКонтрагента, Наименование";
					ЗначенияРеквизитовКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбременения.Контрагент, Реквизиты);
					СтрокаОграничения.ИННКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.ИНН;
					СтрокаОграничения.КППКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.КПП;
					ЮридическоеФизическоеЛицо = ЗначенияРеквизитовКонтрагента.ЮридическоеФизическоеЛицо;
					Если ЗначенияРеквизитовКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
						РеквизитыЮЛ = "ОГРН, НаименованиеПолное";
						ЗначенияРеквизитовЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮридическоеФизическоеЛицо, РеквизитыЮЛ);
						СтрокаОграничения.ОГРНКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.ОГРН;
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.НаименованиеПолное;
					Иначе
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = Справочники.ФизическиеЛица.ФИОФизлица(ЮридическоеФизическоеЛицо);
					КонецЕсли;
					
					НайденныеСтроки = СтрокаДокумента.ПередаваемыеОбъекты.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						СтрокаОграничения.НомерСтроки = НайденныеСтроки[0].НомерСтроки;	
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
		// Раздел 4
		
		Если ВыборкаДокументов.Принятие Тогда
			ВыборкаОС.Сбросить();
			
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
				СтрокаПриятогоОбъекта = СтрокаДокумента.ПринятыеОбъектыНФА.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаДокументов);
				ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаОС);
			
			КонецЦикла;
		КонецЕсли;
		
		// Приложения
		
		КоличествоФайловЭД = 0;
		Пока ВыборкаФайлыАктаЭДО.НайтиСледующий(СтруктураПоиска) Цикл
			КоличествоФайловЭД = КоличествоФайловЭД + 1;
			
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлыАктаЭДО);
		КонецЦикла;
		
		Если КоличествоФайловЭД = 0 Тогда
			Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
				ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлы);
			КонецЦикла;
		КонецЕсли;
		
		// Комиссия
		
		Отбор = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокиКомиссииДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого СтрокаКомиссии Из СтрокиКомиссииДокумента Цикл
			СтрокаКомиссииДокумента = СтрокаДокумента.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссииДокумента, СтрокаКомиссии);
			ФИОСИнициалами = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(СтрокаКомиссии);
			СтрокаКомиссииДокумента.ФИО = ФИОСИнициалами;
			СтрокаКомиссииДокумента.ОсобыеОтметки = ЭлектронныеДокументыБГУ.ФИОПоСтруктуре(СтрокаКомиссии);
		КонецЦикла;		
		
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьОбъектПоДоговору(ДоговорОснование, ПоступлениеОбъект, ЗаполнитьШапку = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДоговорОснование) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорОснование, "ПометкаУдаления,Представление");
	
	Если РеквизитыДоговора.ПометкаУдаления Тогда
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании не помеченного на удаление договора'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Договор = РаботаСОбязательствами.ПолучитьДоговорПервогоУровня(ДоговорОснование);
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,УчетПредметаДоговора,ЗаключаетсяПоРезультатамКонкурсныхПроцедур,ПризнакЗавершенияКонкурсныхПроцедур,РезультатЗавершенияКонкурсныхПроцедур,ПометкаУдаления,Представление");
	
	Если НЕ (РеквизитыДоговора.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") И РеквизитыДоговора.УчетПредметаДоговора) Тогда
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании договора с поставщиком с установленным признаком ""Учет предмета договора""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если РеквизитыДоговора.ЗаключаетсяПоРезультатамКонкурсныхПроцедур 
		И НЕ РеквизитыДоговора.ПризнакЗавершенияКонкурсныхПроцедур 
		И НЕ РеквизитыДоговора.РезультатЗавершенияКонкурсныхПроцедур = 1 Тогда  
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании договора по которому завершены конкурсные процедуры'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписокТМЦ.Номенклатура КАК Номенклатура,
	|	СУММА(СписокТМЦ.Количество) КАК Количество,
	|	СУММА(СписокТМЦ.СуммаВал) КАК СуммаВал,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС
	|ПОМЕСТИТЬ СписокТМЦ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура КАК Номенклатура,
	|		ПланФинансированияОбязательствСрезПоследних.Количество КАК Количество,
	|		ПланФинансированияОбязательствСрезПоследних.СуммаВВалюте КАК СуммаВал,
	|		ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КФО КАК КФО,
	|		ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС КАК КПС
	|	ИЗ
	|		РегистрСведений.ПланФинансированияОбязательств.СрезПоследних КАК ПланФинансированияОбязательствСрезПоследних
	|	ГДЕ
	|		ПланФинансированияОбязательствСрезПоследних.Обязательство = &Обязательство
	|		И ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура ССЫЛКА Справочник.ОсновныеСредства
	|		И (ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания <= &ДатаОкончания
	|				ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеОС.ВнеоборотныйАктив,
	|		-ПоступлениеОС.Количество,
	|		-ПоступлениеОС.Всего,
	|		ПоступлениеОС.КФО,
	|		ПоступлениеОС.КПС
	|	ИЗ
	|		Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОС
	|	ГДЕ
	|		ПоступлениеОС.Ссылка.Договор В ИЕРАРХИИ(&Обязательство)
	|		И ПоступлениеОС.Ссылка.ПометкаУдаления = ЛОЖЬ
	|		И ПоступлениеОС.Ссылка <> &СсылкаДокумента
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеОСВПути.ВнеоборотныйАктив,
	|		-ПоступлениеОСВПути.Количество,
	|		-ПоступлениеОСВПути.Всего,
	|		ПоступлениеОСВПути.КФО,
	|		ПоступлениеОСВПути.КПС
	|	ИЗ
	|		Документ.ПоступлениеОСВПути.КапВложения КАК ПоступлениеОСВПути
	|	ГДЕ
	|		ПоступлениеОСВПути.Ссылка.Договор В ИЕРАРХИИ(&Обязательство)
	|		И ПоступлениеОСВПути.Ссылка.ПометкаУдаления = ЛОЖЬ
	|		И ПоступлениеОСВПути.Ссылка <> &СсылкаДокумента) КАК СписокТМЦ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ПО СписокТМЦ.Номенклатура = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	|			И СписокТМЦ.КФО = УчетныеДанныеОбъектаОССрезПоследних.КФО
	|			И СписокТМЦ.КПС = УчетныеДанныеОбъектаОССрезПоследних.КПС
	|
	|СГРУППИРОВАТЬ ПО
	|	СписокТМЦ.Номенклатура,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство.Организация КАК Организация,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство.Контрагент КАК Контрагент,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК ДокументОснование,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ИФО КАК ИФО,
	|	&ДоговорОснование КАК Договор,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ВалютаРасчетов КАК ВалютаДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.СпособыЗачетаАвансов.Автоматически) КАК СпособЗачетаАванса,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.Поступление) КАК ВидПоступленияМЗ,
	|	ИСТИНА КАК СуммаВключаетНДС,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Регистратор.СчетКонтрагента КАК РасчетныйСчетКонтрагента,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.РеквизитыЛицевогоСчета КАК ЛицевойСчет
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних КАК СрокиИсполненияИСуммыОбязательствСрезПоследних
	|ГДЕ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство = &Обязательство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокТМЦ.Номенклатура КАК ВнеоборотныйАктив,
	|	СписокТМЦ.Количество КАК Количество,
	|	СписокТМЦ.Количество КАК КоличествоПоДокументам,
	|	СписокТМЦ.СуммаВал КАК Сумма,
	|	СписокТМЦ.СуммаВал КАК Всего,
	|	СписокТМЦ.СчетУчета КАК СчетУчета,
	|	СписокТМЦ.КФО КАК КФО,
	|	СписокТМЦ.КПС КАК КПС
	|ИЗ
	|	СписокТМЦ КАК СписокТМЦ
	|ГДЕ
	|	СписокТМЦ.Количество > 0";
	
	Запрос.УстановитьПараметр("Обязательство", Договор);
	Запрос.УстановитьПараметр("СсылкаДокумента", ПоступлениеОбъект.Ссылка); 
	Запрос.УстановитьПараметр("ДоговорОснование", ДоговорОснование); 
	
	Если НЕ ЗначениеЗаполнено(ПоступлениеОбъект.Дата) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ТекущаяДатаСеанса()));
	Иначе
		Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПоступлениеОбъект.Дата));
	КонецЕсли;
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Если ЗаполнитьШапку Тогда
		
		ВыборкаШапка = МассивРезультатов[1].Выбрать();
		ВыборкаШапка.Следующий();
		ЗаполнитьЗначенияСвойств(ПоступлениеОбъект, ВыборкаШапка);
		
	КонецЕсли;
	
	ТаблицаТМЦ = ПоступлениеОбъект["КапВложения"];
	
	ВыборкаТМЦ = МассивРезультатов[2].Выбрать();
	
	Пока ВыборкаТМЦ.Следующий() Цикл
		
		СтрТМЦ = ТаблицаТМЦ.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрТМЦ, ВыборкаТМЦ);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Многопоточный обработчик обновления.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
