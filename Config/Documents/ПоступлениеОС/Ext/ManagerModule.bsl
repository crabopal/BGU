#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ТекОрганизация = ДокументОбъект.Организация;
	ТекДата        = ДокументОбъект.Дата;
	Для каждого СтрокаТЧ из ДокументОбъект.КапВложения Цикл
		Если НЕ СтрокаТЧ.ОтразитьВКарточкеКапвложений ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда
			Продолжить;
		ИначеЕсли ТабДвижений.Найти(СтрокаТЧ.КарточкаКапвложений, "КарточкаКапвложений") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ТекОрганизация;
		НоваяСтрока.КарточкаКапвложений = СтрокаТЧ.КарточкаКапвложений;
		НоваяСтрока.Период              = ТекДата;
	КонецЦикла;	

	Возврат Истина;
КонецФункции	

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДокументов - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументОбъект.ПринятиеКУчетуОбъектовОС
//  МЗПоСебестоимости - Булево - не используется для печати ОС
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, МЗПоСебестоимости = Ложь) Экспорт
	Документы.ПринятиеКУчетуОбъектовОС.ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, МЗПоСебестоимости);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрослеживаемыйТовар

//Формирует текст запроса для определения прослеживаемого товара в документе
//
// Возвращаемое значение:
//  Строка - Текст сформированного запроса.
//
Функция ТекстЗапросаТаблицаПрослеживаемыхТоваровПоОснованию() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК Номенклатура,
	|	СУММА(ПоступлениеОСКапВложения.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА ПоступлениеОСКапВложения.Ссылка.СуммаВключаетНДС
	|				ТОГДА ПоступлениеОСКапВложения.Сумма - ПоступлениеОСКапВложения.СуммаНДС
	|			ИНАЧЕ ПоступлениеОСКапВложения.Сумма
	|		КОНЕЦ) КАК Сумма,
	|	ПоступлениеОСКапВложения.Ссылка.Организация КАК Организация,
	|	ПоступлениеОСКапВложения.Ссылка.Дата КАК ПериодСобытия,
	|	ПоступлениеОСКапВложения.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.ПрослеживаемыйТовар
	|	И ПоступлениеОСКапВложения.Ссылка = &Основание
	|	И ПоступлениеОСКапВложения.Ссылка.ОтражатьВПрослеживаемости
	|	И ЕСТЬNULL(ПоступлениеОСКапВложения.Ссылка.Контрагент.ЮридическоеФизическоеЛицо.СтранаРегистрации.УчастникЕАЭС, ЛОЖЬ)
	|	И ЕСТЬNULL(ПоступлениеОСКапВложения.Ссылка.Контрагент.ЮридическоеФизическоеЛицо.СтранаРегистрации, ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)) <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.Ссылка.Организация,
	|	ПоступлениеОСКапВложения.Ссылка.Дата,
	|	ПоступлениеОСКапВложения.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРегистрацииПрослеживаемыхТоваров.ВвозТоваровИзЕАЭС) КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.Номенклатура.КодТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТоварыПоОснованию
	|ИЗ
	|	ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЛОЖЬ КАК РанееРегистрировалсяВПрослеживаемости,
	|	0 КАК КоличествоУчет,
	|	ВТ_ТаблицаТоваров.ТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.ВидОперации КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваровРазмеченный
	|ИЗ
	|	ВТ_ТоварыПоОснованию КАК ВТ_ТаблицаТоваров";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаРНПТПоДокументу() Экспорт
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеОС.Ссылка,
	|	ЮрЛицоДокумента.СтранаРегистрации
	|ПОМЕСТИТЬ СтраныРегистрацииКонтрагента
	|ИЗ
	|	Документ.ПоступлениеОС КАК ПоступлениеОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮрЛицоДокумента
	|			ПО КонтрагентДокумента.ЮридическоеФизическоеЛицо = ЮрЛицоДокумента.Ссылка
	|		ПО ПоступлениеОС.Контрагент = КонтрагентДокумента.Ссылка
	|ГДЕ
	|	ПоступлениеОС.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеОС.Ссылка,
	|	ФизЛицоДокумента.СтранаРегистрации
	|ИЗ
	|	Документ.ПоступлениеОС КАК ПоступлениеОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛицоДокумента
	|			ПО КонтрагентДокумента.ЮридическоеФизическоеЛицо = ФизЛицоДокумента.Ссылка
	|		ПО ПоступлениеОС.Контрагент = КонтрагентДокумента.Ссылка
	|ГДЕ
	|	ПоступлениеОС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтраныРегистрацииКонтрагента.Ссылка
	|ИЗ
	|	СтраныРегистрацииКонтрагента КАК СтраныРегистрацииКонтрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО СтраныРегистрацииКонтрагента.СтранаРегистрации = СтраныМира.Ссылка
	|ГДЕ
	|	СтраныМира.УчастникЕАЭС
	|	И СтраныМира.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаМатериалы.Ссылка.Дата КАК Период,
	|	ТаблицаМатериалы.Ссылка.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ТаблицаМатериалы.Ссылка.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ТаблицаМатериалы.Ссылка КАК ДокументОперации,
	|	ТаблицаМатериалы.Ссылка.Контрагент КАК Контрагент,
	|	ТаблицаМатериалы.ВнеоборотныйАктив КАК ОсновноеСредство,
	|	ТаблицаМатериалы.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаМатериалы.Ссылка.КодОперацииПрослеживаемости КАК КодОперации,
	|	ТаблицаМатериалы.Количество КАК Количество,
	|	ТаблицаМатериалы.Всего - ТаблицаМатериалы.СуммаНДС КАК СуммаБезНДС,
	|	ЗНАЧЕНИЕ(Справочник.ТипыДокументов.УПД) КАК ТипДокументаВПрослеживаемости,
	|	ТаблицаМатериалы.Ссылка.НомерПервичногоДокумента КАК НомерДокумента,
	|	ТаблицаМатериалы.Ссылка.ДатаПервичногоДокумента КАК ДатаДокумента,
	|	ТаблицаМатериалы.ИдентификаторСтроки
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ТаблицаМатериалы
	|ГДЕ
	|	ТаблицаМатериалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		ИЛИ ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ТаблицаСведенияПрослеживаемости.Комплектующее
	|	КОНЕЦ КАК Комплектующее,
	|	ТаблицаСведенияПрослеживаемости.РНПТ,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТаблицаСведенияПрослеживаемости.СуммаБезНДС КАК СуммаБезНДС
	|ИЗ
	|	Документ.ПоступлениеОС.СведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|ГДЕ
	|	ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка"
КонецФункции

// Параметры отражения в прослеживаемости.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПоступлениеОС
// 
// Возвращаемое значение:
//  см. ПрослеживаемостьБГУ.ПараметрыОтраженияВПрослеживаемости
// 
Функция ПараметрыОтраженияВПрослеживаемости(ДокументОбъект) Экспорт
	Результат = ПрослеживаемостьБГУ.ПараметрыОтраженияВПрослеживаемости();
	
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ТипДокументаВПрослеживаемости = ПрослеживаемостьБГУ.ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(
		ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);

	Запрос.Текст = ТекстЗапросаТаблицаРНПТПоДокументу();
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат.КонтрагентЧленЕАЭС = Не РезультатЗапроса[РезультатЗапроса.ВГраница() - 2].Пустой();
	ТаблицаТовары = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить(); // ТаблицаЗначений
	ТаблицаСведенияРНПТ = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить(); // ТаблицаЗначений
	ТаблицаСведенияРНПТ.Индексы.Добавить("ИдентификаторСтроки");
	
	РаспределяемыеСтрокиРНПТ = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаТовары Цикл
		СтрокиРНПТ = ТаблицаСведенияРНПТ.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки",СтрокаТовара.ИдентификаторСтроки));
		Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
			Если ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
				ДобавитьСтрокуВТаблицуРНПТ(Результат.РНПТ_ОС, СтрокаТовара, СтрокаРНПТ);
			Иначе
				РаспределяемыеСтрокиРНПТ.Добавить(СтрокаРНПТ);
			КонецЕсли;
		КонецЦикла;
		ПрослеживаемостьБГУ.РаспределитьСуммуПоМассивуСтрок(РаспределяемыеСтрокиРНПТ, СтрокаТовара.СуммаБезНДС,
			"Количество", "СуммаБезНДС");
		Для Каждого СтрокаРНПТ Из РаспределяемыеСтрокиРНПТ Цикл
			ДобавитьСтрокуВТаблицуРНПТ(Результат.РНПТ_ОС, СтрокаТовара, СтрокаРНПТ);
		КонецЦикла;
		РаспределяемыеСтрокиРНПТ.Очистить();
	КонецЦикла;
	
	Возврат Результат;	
КонецФункции

Процедура ДобавитьСтрокуВТаблицуРНПТ(ТаблицаРНПТ, СтрокаТовара, СтрокаРНПТ)
	НоваяСтрокаРНПТ = ТаблицаРНПТ.Добавить();
	НоваяСтрокаРНПТ.Период = СтрокаТовара.ДатаДокумента;
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, СтрокаТовара);
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, СтрокаРНПТ);
	Если ЗначениеЗаполнено(НоваяСтрокаРНПТ.Комплектующее) Тогда
		НоваяСтрокаРНПТ.СтранаПроисхождения = СтрокаРНПТ.СтранаПроисхождения;
	Иначе
		НоваяСтрокаРНПТ.СтранаПроисхождения = СтрокаТовара.СтранаПроисхождения;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ТаблицыЗапроса = Новый Массив;
	
	СтруктураДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
	
	ТаблицыЗапроса.Добавить("УчетныеДанныеОбъектаОС");
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА КапВложения.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	КапВложения.Ссылка.Организация КАК Организация,
	|	КапВложения.Ссылка.ИФО КАК ИФО,
	|	КапВложения.ВнеоборотныйАктив КАК ОсновноеСредство,
	|	КапВложения.СчетУчета КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	КапВложения.СчетУчета.КОСГУДт КАК КЭК,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.КапВложение) КАК ВидУчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка) КАК ВидИмущества,
	|	КапВложения.СПИОпределен КАК СПИОпределен
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК КапВложения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = КапВложения.Ссылка)
	|ГДЕ
	|	КапВложения.Ссылка = &Ссылка";
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, ТаблицыЗапроса);
	ИнициализироватьЗапросыСвойстваРНПТ(Запрос, ТаблицыЗапроса);
	#Область УчетДрагМатериалов 
	ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса);
	#КонецОбласти

	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
	Для Каждого СтрокаТаблицы Из ТаблицыДляДвижений.УчетныеДанныеОбъектаОС Цикл
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетУчета, "106.60") Тогда
			СтрокаТаблицы.КЭК = ?(СтрокаТаблицы.СПИОпределен,
				БухгалтерскийУчетПовтИсп.КЭКПоКоду("352"),
				БухгалтерскийУчетПовтИсп.КЭКПоКоду("353"));
		КонецЕсли;
		СтрокаТаблицы.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(СтрокаТаблицы.СчетУчета);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, ТаблицыЗапроса)
	
	ТекстРазделителяЗапросовПакета = ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
	ТаблицыЗапроса.Добавить("ОтражениеЭДВУчете");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	РегистрыНакопления.ОтражениеЭДВУчете.ТекстЗапросаПоОтражениюЭДВУчете(Запрос.Параметры.Ссылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыСвойстваРНПТ(Запрос, ТаблицыЗапроса)
	ТаблицыЗапроса.Добавить("ТаблицаРНПТ");
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияПрослеживаемости.Ссылка.Организация КАК Организация,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.Ссылка.Дата КАК ДатаПоступления
	|ИЗ
	|	Документ.ПоступлениеОС.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка";
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + ТекстЗапроса;
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВОбъектахНФА");
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ПоступлениеОСДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ПоступлениеОСДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПоступлениеОСДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПоступлениеОСДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ПоступлениеОСДрагоценныеМатериалы.ОбъектМЦ КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	|	ПоступлениеОСДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ПоступлениеОСДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ПоступлениеОСДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	ВЫРАЗИТЬ(ПоступлениеОСДрагоценныеМатериалы.Ссылка КАК Документ.ПоступлениеОС).ВидПервичногоДокумента КАК Основание,
	|	ВЫРАЗИТЬ(ПоступлениеОСДрагоценныеМатериалы.Ссылка КАК Документ.ПоступлениеОС).НомерПервичногоДокумента КАК НомерОснования,
	|	ВЫРАЗИТЬ(ПоступлениеОСДрагоценныеМатериалы.Ссылка КАК Документ.ПоступлениеОС).ДатаПервичногоДокумента КАК ДатаОснования,
	|	ПоступлениеОСДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	Документ.ПоступлениеОС.ДрагоценныеМатериалы КАК ПоступлениеОСДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ПоступлениеОСДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	ПоступлениеОСДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И ПоступлениеОСДрагоценныеМатериалы.МассаДМ > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";   
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + ТекстЗапроса;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПринятиеКУчетуОбъектовОС";
	КомандаПечати.Идентификатор		= "АктПриемаПередачи0510448";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о приеме-передаче НФА (ф.0510448) (61н, ред. 100н)'");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "НФАПереданыЭлектроннымАктом",
		Ложь, ВидСравнения.Равно);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеОС";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный ордер (ф.0504207) (52н, ред. 103н)'");
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеОС";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_52н";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Приходный ордер (ф.0504207) (52н)'");
	КомандаПечати.Порядок			= 101;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеОС";
	КомандаПечати.Идентификатор		= "ОС-14";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт о приеме (поступлении) оборудования (ОС-14)'");
	КомандаПечати.Порядок			= 102;
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеОС";
	КомандаПечати.Идентификатор		= "ОтветныйАктПриемаПередачи0510448";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ответный Акт о приеме-передаче НФА'"), "0510448", "61н", "100н");
	КомандаПечати.Порядок			= 1;
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "НФАПереданыЭлектроннымАктом",
		Истина, ВидСравнения.Равно);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ПриходныйОрдер0504207_103н", "Приходный ордер (ф.0504207)", Печать0504207(МассивОбъектов, ОбъектыПечати, "_103н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ПриходныйОрдер0504207_52н", "Приходный ордер (ф.0504207)", Печать0504207(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОС-14") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ОС-14","Акт о приеме (поступлении) оборудования ОС-14", ПечатьОС14(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОтветныйАктПриемаПередачи0510448") Тогда
		
		ТабличныйДокумент = ЭлектронныеДокументыБГУ.НапечататьОтветный0510448(МассивОбъектов, ОбъектыПечати,
			ДанныеДляПечатиОтветного0510448(МассивОбъектов));
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ОтветныйАктПриемаПередачи0510448", "Ответный Акт о приеме-передаче НФА (ф.0510448)",
			ТабличныйДокумент);
		
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОСодержанииДрагМатериалов") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов", "Справка о содержании драг. материалов", ТабличныйДокумент);
		
	КонецЕсли;

КонецПроцедуры

Функция ПечатьОС14(МассивОбъектов, ОбъектыПечати)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСнизу = 0;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ОС14";
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктОПриемеОборудованияОС14");
	Страница1			= Макет.ПолучитьОбласть("Страница1");
	Заголовок2			= Макет.ПолучитьОбласть("Заголовок2");
	Шапка2				= Макет.ПолучитьОбласть("Шапка2");
	Строка2				= Макет.ПолучитьОбласть("Строка2");
	ЗаключениеКомиссии	= Макет.ПолучитьОбласть("ЗаключениеКомиссии");
	ЧленыКомиссии		= Макет.ПолучитьОбласть("ЧленыКомиссии");
	Подписи				= Макет.ПолучитьОбласть("Подписи");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеОС.Ссылка КАК Ссылка,
	               |	ПоступлениеОС.Номер КАК Номер,
	               |	ПоступлениеОС.Дата КАК Дата,
	               |	ПоступлениеОС.Организация,
	               |	ПоступлениеОС.Организация.НаименованиеПолное КАК ОрганизацияНаименование,
	               |	ПоступлениеОС.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОС.Подразделение) КАК ПодразделениеНаименование,
	               |	ПоступлениеОС.Контрагент,
	               |	ПоступлениеОС.Договор,
	               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОС.Договор) КАК ДоговорНаименование,
	               |	ПоступлениеОС.Грузоотправитель,
	               |	ПоступлениеОС.Изготовитель,
	               |	ПоступлениеОС.ДолжностьПредседателяКомиссии,
	               |	ПоступлениеОС.ФамилияПредседателяКомиссии,
	               |	ПоступлениеОС.ИмяПредседателяКомиссии,
	               |	ПоступлениеОС.ОтчествоПредседателяКомиссии,
	               |	ПоступлениеОС.ЦМО.Сотрудник КАК МОЛ,
	               |	ПоступлениеОС.ЦМО.МестоХранения КАК МестоХранения,
	               |	ПоступлениеОС.ЦМО.Сотрудник.Код КАК ТабельныйНомер,
	               |	ПоступлениеОСКапВложения.НомерСтроки КАК НомерСтроки,
	               |	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК НаименованиеОС,
	               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСКапВложения.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	               |	ПоступлениеОСКапВложения.Количество,
	               |	ВЫБОР
	               |		КОГДА ПоступлениеОСКапВложения.Количество <> 0
	               |			ТОГДА ПоступлениеОСКапВложения.Всего / ПоступлениеОСКапВложения.Количество
	               |		ИНАЧЕ ПоступлениеОСКапВложения.Всего
	               |	КОНЕЦ КАК Цена,
	               |	ПоступлениеОСКапВложения.Всего КАК Всего,
	               |	ПОДСТРОКА(ПоступлениеОС.ЗаключениеКомиссии, 1, 1000) КАК ЗаключениеКомиссии,
	               |	ПоступлениеОСКапВложения.ВидУпаковки,
	               |	ПоступлениеОСКапВложения.КоличествоПоДокументам,
	               |	ПоступлениеОСКапВложения.МассаОтправителя,
	               |	ПоступлениеОСКапВложения.МассаДороги,
	               |	ПоступлениеОСКапВложения.МассаФактическая,
	               |	ПоступлениеОСКапВложения.Дефекты,
	               |	ПоступлениеОСКапВложения.Примечание,
	               |	ПоступлениеОСКапВложения.ОсобыеОтметки,
	               |	"""" КАК ЗаводскойНомер,
	               |	ПоступлениеОС.ПрилагаемыеДокументы,
	               |	ПоступлениеОС.ЛицевойСчет,
	               |	ПоступлениеОС.РасчетныйСчетКонтрагента,
	               |	ПоступлениеОС.РасчетныйСчетГрузоотправителя,
	               |	ПоступлениеОС.Договор.ДатаДоговора КАК ДатаДоговора,
	               |	ПоступлениеОС.Договор.НомерДоговора КАК НомерДоговора
	               |ИЗ
	               |	Документ.ПоступлениеОС КАК ПоступлениеОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	               |		ПО ПоступлениеОС.Ссылка = ПоступлениеОСКапВложения.Ссылка
	               |ГДЕ
	               |	ПоступлениеОС.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	Номер,
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоставКомиссии.Ссылка КАК Ссылка,
	               |	СоставКомиссии.ДолжностьЧленаКомиссии КАК Должность,
	               |	СоставКомиссии.ФамилияЧленаКомиссии + "" "" + СоставКомиссии.ИмяЧленаКомиссии + "" "" + СоставКомиссии.ОтчествоЧленаКомиссии КАК ЧленКомиссии,
	               |	СоставКомиссии.ДокументОПолномочиях КАК Документ
	               |ИЗ
	               |	Документ.ПоступлениеОС.СоставКомиссии КАК СоставКомиссии
	               |ГДЕ
	               |	СоставКомиссии.Ссылка В(&МассивОбъектов)
	               |ИТОГИ ПО
	               |	Ссылка";
				   
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ПервыйДокумент = Истина;	
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка	= Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссии	= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		Страница1.Параметры.Заполнить(ВыборкаШапка);
		СтруктураСтраница1 = Новый Структура("ОрганизацияТелефонФакс,Номер,ОрганизацияБанковскиеРеквизиты,РуководительФИО,РуководительДолжность");
		
		Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
																				Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		Факс 	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
																				Справочники.ВидыКонтактнойИнформации.ФаксОрганизации);
		ТелефонФакс = ?(ПустаяСтрока(Телефон), "", "Тел.: "+Телефон) + ?(ПустаяСтрока(Факс), "", ?(ПустаяСтрока(Телефон), "", ", ") + "факс: " + Факс);																				
		СтруктураСтраница1.ОрганизацияТелефонФакс			= ТелефонФакс;
		Если ЗначениеЗаполнено(ВыборкаШапка.ЛицевойСчет) Тогда
			ПлатежныеРеквизиты =  Новый Структура("Корреспондент, СчетНомер, Банк, БИК, КоррСчет",
												"Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ВыборкаШапка.ЛицевойСчет.Владелец, ВыборкаШапка.ЛицевойСчет, ПлатежныеРеквизиты);
			СтруктураСтраница1.ОрганизацияБанковскиеРеквизиты	= ПлатежныеРеквизиты.Корреспондент
																+ " р/с " + ПлатежныеРеквизиты.СчетНомер
																+ " в " + ПлатежныеРеквизиты.Банк
																+ " БИК " + ПлатежныеРеквизиты.Бик
																+ " к/с " + ПлатежныеРеквизиты.КоррСчет;
		Иначе
			СтруктураСтраница1.ОрганизацияБанковскиеРеквизиты	= "";
		КонецЕсли;
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация,
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.Дата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											Руководитель.ОтветственноеЛицоСсылка, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);																														
		РуководительФИО			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		РуководительДолжность	= Руководитель.ДолжностьПредставление;
		СтруктураСтраница1.РуководительФИО			= РуководительФИО;
		СтруктураСтраница1.РуководительДолжность	= РуководительДолжность;
		СтруктураСтраница1.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер);
		Страница1.Параметры.Заполнить(СтруктураСтраница1);
		ГлБухгалтер  = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация,
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.Дата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											ГлБухгалтер.ОтветственноеЛицоСсылка, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);																														
		ГлБухгелтерФИО			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ПараметрыКонтрагентов = Новый Структура("КонтрагентНаименование, КонтрагентКодОКПО, 
												|КонтрагентАдресТелефон, КонтрагентБанковскиеРеквизиты, 
												|ИзготовительНаименование, ИзготовительКодОКПО, 
												|ГрузоотправительНаименование, ГрузоотправительКодОКПО, ГрузоотправительТелефонБанк");
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, ИНН, КПП, КодОКПО",
											ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		ПараметрыКонтрагентов.КонтрагентНаименование	= ДанныеКонтрагента.НаименованиеПолное;
		ПараметрыКонтрагентов.КонтрагентКодОКПО			= ДанныеКонтрагента.КодОКПО;
		Адрес 	= Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(ВыборкаШапка.Контрагент, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты); 
		Телефон = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(ВыборкаШапка.Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты); 
		
		ПараметрыКонтрагентов.КонтрагентАдресТелефон		= Адрес+?(ПустаяСтрока(Телефон), "", ", тел.:"+Телефон);
		Если ЗначениеЗаполнено(ВыборкаШапка.РасчетныйСчетКонтрагента) Тогда
			ПлатежныеРеквизиты =  Новый Структура("Корреспондент, СчетНомер, Банк, БИК, КоррСчет",
												"Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ВыборкаШапка.РасчетныйСчетКонтрагента, ВыборкаШапка.РасчетныйСчетКонтрагента, ПлатежныеРеквизиты);
			ПараметрыКонтрагентов.КонтрагентБанковскиеРеквизиты	= "р/с " + ПлатежныеРеквизиты.СчетНомер
																+ " в " + ПлатежныеРеквизиты.Банк
																+ " БИК " + ПлатежныеРеквизиты.Бик
																+ " к/с " + ПлатежныеРеквизиты.КоррСчет;
		Иначе
			ПараметрыКонтрагентов.КонтрагентБанковскиеРеквизиты = "";
		КонецЕсли;
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, ИНН, КПП, КодОКПО",
											ВыборкаШапка.Грузоотправитель, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		ПараметрыКонтрагентов.ГрузоотправительНаименование	= ДанныеКонтрагента.НаименованиеПолное;													
		ПараметрыКонтрагентов.ГрузоотправительКодОКПО		= ДанныеКонтрагента.КодОКПО;
		ТелефонКонтрагента = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(ВыборкаШапка.Грузоотправитель, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
		Если НЕ ПустаяСтрока(ТелефонКонтрагента) Тогда
			ТелефонКонтрагента = "Тел.: "+ТелефонКонтрагента;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаШапка.РасчетныйСчетГрузоотправителя) Тогда
			ПлатежныеРеквизиты =  Новый Структура("Корреспондент, СчетНомер, Банк, БИК, КоррСчет",
												"Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ВыборкаШапка.РасчетныйСчетГрузоотправителя, ВыборкаШапка.РасчетныйСчетГрузоотправителя, ПлатежныеРеквизиты);
			ПараметрыКонтрагентов.ГрузоотправительТелефонБанк	= ?(ПустаяСтрока(ТелефонКонтрагента), "", ТелефонКонтрагента + ", ")
																+ "р/с " + ПлатежныеРеквизиты.СчетНомер
																+ " в " + ПлатежныеРеквизиты.Банк
																+ " БИК " + ПлатежныеРеквизиты.Бик
																+ " к/с " + ПлатежныеРеквизиты.КоррСчет;
		Иначе
			ПараметрыКонтрагентов.ГрузоотправительТелефонБанк = "";
		КонецЕсли;
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, ИНН, КПП, КодОКПО",
											ВыборкаШапка.Изготовитель, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		ПараметрыКонтрагентов.ИзготовительНаименование		= ДанныеКонтрагента.НаименованиеПолное;													
		ПараметрыКонтрагентов.ИзготовительКодОКПО			= ДанныеКонтрагента.КодОКПО;
		
		Страница1.Параметры.Заполнить(ПараметрыКонтрагентов);
		
		ТабличныйДокумент.Вывести(Страница1);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент.Вывести(Заголовок2);
		ТабличныйДОкумент.Вывести(Шапка2);
		
		ВыборкаСтрок = ВыборкаШапка.Выбрать();
		КоличествоСтрок = ВыборкаСтрок.Количество();
		СтрокНаСтранице = 0;
		Пока ВыборкаСтрок.Следующий() Цикл
			
			Строка2.Параметры.Заполнить(ВыборкаСтрок);
			Если ВыборкаСтрок.НомерСтроки = КоличествоСтрок И СтрокНаСтранице > 0 Тогда
				Массив = Новый Массив;
				Массив.Добавить(Строка2);
				Если НЕ ТабличныйДокумент.ПроверитьВывод(Массив) Тогда
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(Шапка2);
					СтрокНаСтранице = 0;
				КонецЕсли;
			ИначеЕсли Не ТабличныйДокумент.ПроверитьВывод(Строка2) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(Шапка2);
				СтрокНаСтранице = 0;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(Строка2);
			СтрокНаСтранице = СтрокНаСтранице + 1;
		КонецЦикла;
		
		ЗаключениеКомиссии.Параметры.Заполнить(ВыборкаШапка);
		ТабличныйДокумент.Вывести(ЗаключениеКомиссии);
		
		Сч = 0;
		Если ЗначениеЗаполнено(ВыборкаШапка.ДолжностьПредседателяКомиссии)
			Или ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии)
			Или ЗначениеЗаполнено(ВыборкаШапка.ИмяПредседателяКомиссии)
			Или ЗначениеЗаполнено(ВыборкаШапка.ОтчествоПредседателяКомиссии) Тогда
			
			СтруктураПредседатель = Новый Структура("Должность,ЧленКомиссии", ВыборкаШапка.ДолжностьПредседателяКомиссии,
				ВыборкаШапка.ФамилияПредседателяКомиссии + " " + ВыборкаШапка.ИмяПредседателяКомиссии + " " + ВыборкаШапка.ОтчествоПредседателяКомиссии);
			ЧленыКомиссии.Параметры.Заполнить(СтруктураПредседатель);
			ТабличныйДокумент.Вывести(ЧленыКомиссии);
			Сч = Сч + 1; 
		КонецЕсли;
			
		ВыборкаКомиссии.Сбросить();
		Если ВыборкаКомиссии.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			ВыборкаКом = ВыборкаКомиссии.Выбрать();
			Пока ВыборкаКом.Следующий() Цикл
				ЧленыКомиссии.Параметры.Заполнить(ВыборкаКом);
				ТабличныйДокумент.Вывести(ЧленыКомиссии);
				Сч = Сч + 1;
			КонецЦикла;
		КонецЕсли;		
		ЧленыКомиссии.Параметры.Заполнить(Новый Структура("Должность,ЧленКомиссии,Документ"));
		Пока Сч < 3 Цикл
			ТабличныйДокумент.Вывести(ЧленыКомиссии);
			Сч = Сч + 1;
		КонецЦикла;
		
		СтруктураПодписи = Новый Структура("ГлБухгалтерФИО,МолДолжность,МолФИО");
		СтруктураПодписи.ГлБухгалтерФИО = ГлБухгелтерФИО;
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
											ВыборкаШапка.МОЛ, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		МолДолжность	= ДанныеСотрудника.Должность;
		МолФИО			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника);
		СтруктураПодписи.МолДолжность	= МолДолжность;
		СтруктураПодписи.МолФИО		= МолФИО;
		Подписи.Параметры.Заполнить(ВыборкаШапка);
		Подписи.Параметры.Заполнить(СтруктураПодписи);
		ТабличныйДокумент.Вывести(Подписи);
		
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно. 
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	
	КонецЦикла; 
	
	
	Возврат ТабличныйДокумент;	

КонецФункции // ПечатьОС14()

