Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	СчетаРасчетовССубконтоДоговоры.ЗагрузитьЗначения(Документы.ИнвентаризацияРасчетовСКонтрагентами.СчетаРасчетовССубконтоДоговоры());
	Счета04.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("04"));
	Счета20.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("20"));
	
	ЗаполнитьКолонкуВидСчета();
	
	// Отметка корректности сумм в строках таблицы:
	РассчитатьКолонкуОтметитьСтрокуНаСервере();
	
	ПричиныОбразованияДт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Дебиторская);
	Элементы.ДебиторскаяЗадолженностьПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияДт);
	
	ПричиныОбразованияКт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Кредиторская);
	Элементы.КредиторскаяЗадолженностьПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияКт);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	СчетаРасчетов = Новый СписокЗначений;
	СчетаРасчетов.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("205.00,209.00,206.00,302.00,207.00,301.00"));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДебиторскаяЗадолженностьАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДебиторскаяЗадолженность.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, СчетаРасчетов);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "КредиторскаяЗадолженностьАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.КредиторскаяЗадолженность.Счет", ВидСравненияКомпоновкиДанных.НеВСписке, СчетаРасчетов);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	КолонкаДоговор = Новый Массив;
	КолонкаДоговор.Добавить("ДебиторскаяЗадолженностьДоговор");
	КолонкаДоговор.Добавить("КредиторскаяЗадолженностьДоговор");
	КолонкаДоговор.Добавить("ДебиторскаяЗадолженностьАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	КолонкаДоговор.Добавить("КредиторскаяЗадолженностьАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкаДоговор, "Видимость", Объект.РежимЗаполнения <> 0);
	
КонецПроцедуры

