&НаКлиенте
Процедура СоздатьСписаниеКредиторскойЗадолженности(ВидОперации, СтрокиИнвентаризации = Неопределено)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание кредиторской задолженности'");
	
	// Проверим, что выбраны строки с одинаковым счетом и ИФО.
	СтрокиДляПроверки = ?(СтрокиИнвентаризации = Неопределено, Объект.КредиторскаяЗадолженность, СтрокиИнвентаризации);
	ЭтоПерваяСтрока = Истина;
	НомераСтрокИнвентаризации = Новый Массив;
	Для Каждого СтрокаИнвентаризации Из СтрокиДляПроверки Цикл
		
		Если ТипЗнч(СтрокаИнвентаризации) = Тип("Число") Тогда
			ДанныеСтроки = Объект.КредиторскаяЗадолженность.НайтиПоИдентификатору(СтрокаИнвентаризации);
		Иначе
			ДанныеСтроки = СтрокаИнвентаризации;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			
			// Проверим корректность выбранного вида операции.
			Если ЗначениеЗаполнено(ДанныеСтроки.Счет)
				И (Счета20.НайтиПоЗначению(ДанныеСтроки.Счет) <> Неопределено) // Это счет 20.
				И ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности") Тогда
				ПоказатьПредупреждение(, НСтр("ru='Для задолженности на забалансовом счете 20 применяется вид операции ""Прекратить наблюдение задолженности"".'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Счет)
				И (Счета20.НайтиПоЗначению(ДанныеСтроки.Счет) = Неопределено) // Это не счет 20.
				И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности") Тогда
