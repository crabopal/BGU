	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, ВыборГруппИЭлементов", Ложь, Истина);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы, Элементы.СписокКонтрагентов);
	
КонецПроцедуры

