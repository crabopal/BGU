&НаСервере
Функция ЕстьОшибки_ПроверитьПередЗаполнениемПоДаннымУчета()
	
	Возврат Документы.ИнвентаризацияРасчетовСКонтрагентами.ЕстьОшибки_ПроверитьПередЗаполнениемПоДаннымУчета(Объект);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчетаДЗ(РежимЗаполнения = 0)
	
	Если ЕстьОшибки_ПроверитьПередЗаполнениемПоДаннымУчета() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект["ДебиторскаяЗадолженность"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
			|табличная часть ""Дебиторская задолженность"".
			|
			|Продолжить и очистить?'");
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("РежимЗаполнения", РежимЗаполнения);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчетаДЗ_Выбор", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоДаннымУчетаДЗКлиент(РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры
