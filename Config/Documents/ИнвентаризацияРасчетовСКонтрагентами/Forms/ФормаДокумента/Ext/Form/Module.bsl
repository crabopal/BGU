&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["ДатаНачала"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["ДатаОкончания"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры
&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["ДатаНачала"]	= РезультатВыбора["НачалоПериода"];
		Объект["ДатаОкончания"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
		
		ПриИзмененииПериода();
	КонецЕсли;
	
КонецПроцедуры

