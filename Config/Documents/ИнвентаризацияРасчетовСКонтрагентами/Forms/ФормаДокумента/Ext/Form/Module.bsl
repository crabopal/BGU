&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент(ВидЗадолженности, РежимЗаполнения)
	
	РезультатЗадания = ЗаполнитьПоДаннымБухУчетаСервер(ВидЗадолженности, РежимЗаполнения);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияПоДаннымБухУчетаКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоДаннымБухУчетаСервер(ВидЗадолженности, РежимЗаполнения)
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Инвентаризация расчетов с контрагентами'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета(ВидЗадолженности, РежимЗаполнения);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.ИнвентаризацияРасчетовСКонтрагентами.ПолучитьДанныеБухУчета",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Перем ЗаполнитьДебиторскуюЗадолженность, ЗаполнитьКредиторскуюЗадолженность;
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеЗаполненияПоДаннымБухУчетаСервер(Результат.АдресРезультата, ЗаполнитьДебиторскуюЗадолженность, ЗаполнитьКредиторскуюЗадолженность);
		
		Если ЗаполнитьДебиторскуюЗадолженность И ЗаполнитьКредиторскуюЗадолженность Тогда
			ПоказатьСообщение = (Объект.ДебиторскаяЗадолженность.Количество() = 0 И Объект.КредиторскаяЗадолженность.Количество() = 0);
		ИначеЕсли ЗаполнитьДебиторскуюЗадолженность Тогда
			ПоказатьСообщение = (Объект.ДебиторскаяЗадолженность.Количество() = 0);
		ИначеЕсли ЗаполнитьКредиторскуюЗадолженность Тогда
			ПоказатьСообщение = (Объект.КредиторскаяЗадолженность.Количество() = 0);
		Иначе
			ПоказатьСообщение = Ложь;
		КонецЕсли;
		
		Если ПоказатьСообщение Тогда
			Текст = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют.'");
			ПоказатьПредупреждение(, Текст, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При заполнении по данным учета возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаСервер(Знач АдресРезультата, ЗаполнитьДебиторскуюЗадолженность, ЗаполнитьКредиторскуюЗадолженность)
	
	Перем Значение;
	
	РезультатыЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	ЗаполнитьДебиторскуюЗадолженность = РезультатыЗаполнения.Свойство("ДебиторскаяЗадолженность", Значение);
	
	Если ЗаполнитьДебиторскуюЗадолженность Тогда
		Объект.ДебиторскаяЗадолженность.Загрузить(Значение);
	КонецЕсли;
	
	ЗаполнитьКредиторскуюЗадолженность = РезультатыЗаполнения.Свойство("КредиторскаяЗадолженность", Значение);
	
	Если ЗаполнитьКредиторскуюЗадолженность Тогда
		Объект.КредиторскаяЗадолженность.Загрузить(Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета(ВидЗадолженности, РежимЗаполнения)
	
	ШапкаДокумента = Новый Структура("
		|РежимЗаполнения,
		|ЗаполнятьКодЦели,
		|ДатаИнвентаризации,
		|БезУчетаИФО,
		|Подразделение,
		|Организация,
		|КФО,
		|ИФО");

	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	
	СписокКонтрагентов = Объект.СписокКонтрагентов.Выгрузить();
	СписокСчетов = Объект.СписокСчетов.Выгрузить();
	
	ЗаполнитьДебиторскуюЗадолженность = (ВидЗадолженности = "Дебиторская" Или ВидЗадолженности = "Все");
	ЗаполнитьКредиторскуюЗадолженность = (ВидЗадолженности = "Кредиторская" Или ВидЗадолженности = "Все");

	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента",						ШапкаДокумента);
	ПараметрыПроцедуры.Вставить("СписокКонтрагентов",					СписокКонтрагентов);
	ПараметрыПроцедуры.Вставить("СписокСчетов",							СписокСчетов);
	ПараметрыПроцедуры.Вставить("ЗаполнитьДебиторскуюЗадолженность",	ЗаполнитьДебиторскуюЗадолженность);
	ПараметрыПроцедуры.Вставить("ЗаполнитьКредиторскуюЗадолженность",	ЗаполнитьКредиторскуюЗадолженность);
	ПараметрыПроцедуры.Вставить("РежимЗаполнения",						РежимЗаполнения);
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьСписокСчетовПоУмолчанию()
	
	Если Объект["СписокСчетов"].Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Перед заполнением будет очищена
			|табличная часть ""Счета учета расчетов"".
			|
			|Продолжить и заполнить счетами по умолчанию?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСписокСчетовПоУмолчанию_Выбор", ЭтотОбъект);
