#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЭтотОбъект.РежимЗаполнения = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("Договор");
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект.ДебиторскаяЗадолженность Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект.КредиторскаяЗадолженность Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнвентаризацияСервер.УстановитьДатуИнвентаризации(ДанныеЗаполнения, ЭтотОбъект);
	
	Документы.ИнвентаризацияРасчетовСКонтрагентами.ЗаполнитьСписокСчетовПоУмолчанию(ЭтотОбъект);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияРасчетовСКонтрагентами.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ЭтотОбъект, НастройкиМеханизма, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ЭтотОбъект, Отказ);
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("ДебиторскаяЗадолженность.Договор");
	НепроверяемыеРеквизиты.Добавить("КредиторскаяЗадолженность.Договор");
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров И (РежимЗаполнения <> 0) Тогда
		
		Для Каждого СтрокаТаблицы Из ДебиторскаяЗадолженность Цикл
			
			Если СтрокаТаблицы.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Договор) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Договор'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Дебиторская задолженность'"));
					ПолеОшибки = "ДебиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Договор";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
					Продолжить;
				КонецЕсли;
				
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
				
				Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "206.00,302.00") Тогда
					
					Если НЕ РеквизитыДоговора.ВестиПланГрафикИсполнения Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в плане-графике закупок, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""План-график закупок"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								СтрокаТаблицы.Договор);
						ПолеКолонки = "ДебиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Договор";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКолонки, "Объект", Отказ);
					КонецЕсли;
					
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "205.00,209.00")
					ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "207.00,301.00") Тогда
					
					Если НЕ РеквизитыДоговора.ВестиГрафикПлатежей Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в графике платежей, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""График платежей"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								СтрокаТаблицы.Договор);
						ПолеКолонки = "ДебиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Договор";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКолонки, "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаТаблицы Из КредиторскаяЗадолженность Цикл
			
			Если СтрокаТаблицы.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Договор) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Договор'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Кредиторская задолженность'"));
					ПолеОшибки = "КредиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Договор";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
					Продолжить;
				КонецЕсли;
				
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
				
				Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "205.00,209.00") Тогда
					
					Если НЕ РеквизитыДоговора.ВестиПланГрафикИсполнения Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в плане-графике реализации, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""План-график реализации"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								СтрокаТаблицы.Договор);
						ПолеКолонки = "КредиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Договор";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКолонки, "Объект", Отказ);
					КонецЕсли;
					
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "206.00,302.00")
					ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, "207.00,301.00") Тогда
					
					Если НЕ РеквизитыДоговора.ВестиГрафикПлатежей Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для автоматического отражения в графике платежей, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""График платежей"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
								СтрокаТаблицы.Договор);
						ПолеКолонки = "КредиторскаяЗадолженность[" + Формат(СтрокаТаблицы.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Договор";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКолонки, "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
