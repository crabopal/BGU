	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
Процедура СформироватьОписаниеДокументовСТабличнымиЧастями(Форма, Описание) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "ДебиторскаяЗадолженность", "ДебиторскаяЗадолженностьКонтрагент", "");
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "КредиторскаяЗадолженность", "КредиторскаяЗадолженностьКонтрагент", "");
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "СписокКонтрагентов", "СписокКонтрагентовКонтрагент", "");

КонецПроцедуры
// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПолучитьДанныеБухУчета", Истина);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаВыбора" Тогда
		//чтобы при программном открытии формы выбора установился режим выбора
		Параметры.Вставить("РежимВыбора", Истина);
		ВыбраннаяФорма = Метаданные.Документы.ИнвентаризацияРасчетовСКонтрагентами.Формы.ФормаСписка;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ДатаИнвентаризации,РежимЗаполнения");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ДатаИнвентаризации"	, НачалоДня(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("ДатаНачалоГода"		, НачалоГода(ЗначенияРеквизитов.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Дебиторская"			, Перечисления.ВидыЗадолженности.Дебиторская);
	Запрос.УстановитьПараметр("Кредиторская"		, Перечисления.ВидыЗадолженности.Кредиторская);
	Запрос.УстановитьПараметр("ДетализацияПоДоговорам", ЗначенияРеквизитов.РежимЗаполнения = 1);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ФормироватьДвиженияДолгосрочнойПросроченной = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.РазрешеноФормированиеДвиженийСтороннимиДокументами(ЗначенияРеквизитов.ДатаИнвентаризации);
	
	НомераТаблиц = Новый Структура;
	
	Если ФормироватьДвиженияДолгосрочнойПросроченной Тогда
		НомераТаблиц.Вставить("ДанныеЗадолженности", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ДолгосрочнаяПросроченнаяЗадолженность", НомераТаблиц.Количество());
		Запрос.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Служебная таблица данных задолженности
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаИнвентаризации КАК Период,
		|	&ДатаИнвентаризации КАК ДатаИнвентаризации,
		|	&Организация КАК Организация,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.Счет КАК СчетРасчетов,
		|	&Дебиторская КАК ВидЗадолженности,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.ИФО КАК ИФО,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.КФО КАК КФО,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.КПС КАК КПС,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.КЭК КАК КЭК,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА &ДетализацияПоДоговорам
		|			ТОГДА ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.Договор
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.Долгосрочная КАК Долгосрочная,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.Просроченная КАК Просроченная,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.ДатаИсполнения КАК ДатаИсполнения,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.ПричинаОбразованияКод КАК ПричинаОбразованияКод,
		|	ИнвентаризацияРасчетовСКонтрагентамиДебиторскаяЗадолженность.ПричинаОбразованияПояснение КАК ПричинаОбразованияПояснение,
