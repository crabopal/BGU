#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0504089
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504089_103н";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504089) (в ред.103н)'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504089";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504089)'");
	
	// Форма 0504089 расширенная (долгосрочная и просроченная задолженности)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504089Расширенная_103н";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504089) расширенная (в ред.103н)'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504089Расширенная";
	КомандаПечати.Представление = НСтр("ru='Инв. опись (ф. 0504089) расширенная'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504089_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504089_103н",
			"Инвентаризационная опись расчетов с покупателями, поставщиками (ф. 0504089)",
			ПечатьФормы0504089(МассивОбъектов, ОбъектыПечати,, "103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504089") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504089",
			"Инвентаризационная опись расчетов с покупателями, поставщиками (ф. 0504089)",
			ПечатьФормы0504089(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504089Расширенная_103н") Тогда
		
		Расширенная = Истина;
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504089Расширенная_103н",
			"Инвентаризационная опись расчетов с покупателями, поставщиками (ф. 0504089) расширенная",
			ПечатьФормы0504089(МассивОбъектов, ОбъектыПечати, Расширенная, "103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504089Расширенная") Тогда
		
		Расширенная = Истина;
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504089Расширенная",
			"Инвентаризационная опись расчетов с покупателями, поставщиками (ф. 0504089) расширенная",
			ПечатьФормы0504089(МассивОбъектов, ОбъектыПечати, Расширенная));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПолучитьСписокСчетовПоУмолчанию(ДатаИнвентаризации) Экспорт
	
	БезУчетаИерархии = Истина;
	
	Возврат БухгалтерскийУчет.СписокСчетов("
		|205.00,
		|206.00,
		|207.00,
		|208.00,
		|209.00,
		|210.05,
		|04,
		|301.00,
		|302.00,
		|303.00,
		|304.01,
		|304.02,
		|304.03,
		|304.04,
		|20",
		ДатаИнвентаризации,
		БезУчетаИерархии);
	
КонецФункции

Процедура ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ШапкаДокумента = ПараметрыПроцедуры.ШапкаДокумента;
	
	ДатаОпределенияОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ШапкаДокумента.ДатаИнвентаризации);
	
	СчетаДЗ = БухгалтерскийУчет.СписокСчетов("04");
	СчетаКЗ = БухгалтерскийУчет.СписокСчетов("20");
	
	СписокКонтрагентов = ПараметрыПроцедуры.СписокКонтрагентов.ВыгрузитьКолонку("Контрагент");
	
	ИспользоватьОтборПоКонтрагенту = (СписокКонтрагентов.Количество() > 0);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьОтборПоИФО = ИспользоватьУчетПоИФО И НЕ ШапкаДокумента["БезУчетаИФО"];
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьОтборПоПодразделению = ИспользоватьУчетПоПодразделениям И (ЗначениеЗаполнено(ШапкаДокумента["Подразделение"]));
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДатаЗапроса",						ДатаОпределенияОстатков);
	ЗапросЗаполнение.УстановитьПараметр("Организация",						ШапкаДокумента["Организация"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",								ШапкаДокумента["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",								ШапкаДокумента["ИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоИФО",			ИспользоватьОтборПоИФО);
	ЗапросЗаполнение.УстановитьПараметр("СписокСчетов",						ПолучитьСписокНепустыхСчетов(ПараметрыПроцедуры.СписокСчетов));
	ЗапросЗаполнение.УстановитьПараметр("СписокКонтрагентов",				СписокКонтрагентов);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ИспользоватьОтборПоКонтрагенту);
	ЗапросЗаполнение.УстановитьПараметр("СчетаДЗ",							СчетаДЗ);
	ЗапросЗаполнение.УстановитьПараметр("СчетаКЗ",							СчетаКЗ);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	ЗапросЗаполнение.УстановитьПараметр("Подразделение",					ШапкаДокумента["Подразделение"]);
	ЗапросЗаполнение.УстановитьПараметр("КЭК000",							БухгалтерскийУчетПовтИсп.КЭК0());
	ЗапросЗаполнение.УстановитьПараметр("ЗаполнятьКодЦели",					ШапкаДокумента.ЗаполнятьКодЦели);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Отбор контрагентов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	ОтборКонтрагентов
	|ИЗ
	|	Справочник.Контрагенты
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&СписокКонтрагентов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Фактические остатки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет													КАК Счет,
	|	Счет.Вид												КАК СчетВид,
	|	Счет.Порядок											КАК СчетПорядок,
	|	Счет.Забалансовый										КАК СчетЗабалансовый,
	|	Счет.БезДетализацииКОСГУ								КАК СчетБезДетализацииКОСГУ,
	|	ВЫБОР
	|		КОГДА Счет.КОСГУКт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) ТОГДА
	|			""0""
	|		ИНАЧЕ
	|			ПОДСТРОКА(Счет.КОСГУКт.Код, 3, 1)
	|	КОНЕЦ 													КАК СчетКИЕ,
	|	КФО														КАК КФО,
	|	КФО.Порядок												КАК КФОПорядок,
	|	КПС														КАК КПС,
	|	ВЫБОР
	|		КОГДА Счет.Забалансовый ТОГДА
	|			КЭК
	|		ИНАЧЕ
	|			&КЭК000
	|	КОНЕЦ													КАК КЭК,
	|	ВЫБОР 
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ													КАК ИФО,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто3
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1	КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2	КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3	КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.ОбъектыФинансовыхВложений) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1	КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.ОбъектыФинансовыхВложений) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2	КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.ОбъектыФинансовыхВложений) ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3	КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			
	|		ИНАЧЕ
	|			Счет.Наименование
	|	КОНЕЦ													КАК Контрагент,
