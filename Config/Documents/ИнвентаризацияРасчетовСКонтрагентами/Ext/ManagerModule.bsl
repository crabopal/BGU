	|ВЫБРАТЬ
	|	Счет													КАК Счет,
	|	СчетПорядок												КАК СчетПорядок,
	|	СчетЗабалансовый										КАК СчетЗабалансовый,
	|	СчетБезДетализацииКОСГУ									КАК СчетБезДетализацииКОСГУ,
	|	СчетКИЕ													КАК СчетКИЕ,
	|	КФО														КАК КФО,
	|	КФОПорядок												КАК КФОПорядок,
	|	КПС														КАК КПС,
	|	КЭК														КАК КЭК,
	|	Представление(КПС)										КАК КПСПредставление,
	|	ИФО														КАК ИФО,
	|	Контрагент												КАК Контрагент,
	|	КонтрагентНаименование									КАК КонтрагентНаименование,
	|	КонтрагентКИЕ											КАК КонтрагентКИЕ,
	|	Договор													КАК Договор,
	|	КодЦели													КАК КодЦели,
	|	ВидНалоговИПлатежейНаименование							КАК ВидНалоговИПлатежейНаименование,
	|	ВЫБОР
	|		КОГДА СчетВид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
	|			СуммаОстатокДт
	|		КОГДА СчетВид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
	|			СуммаОстатокКт
	|		КОГДА СчетВид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный) И СуммаОстаток > 0 ТОГДА
	|			СуммаОстаток
	|		ИНАЧЕ
	|			-СуммаОстаток
	|	КОНЕЦ													КАК Остаток,
	|	ВЫБОР
	|		КОГДА Счет В(&СчетаДЗ) ИЛИ (СчетВид = ЗНАЧЕНИЕ(ВидСчета.Активный) И НЕ Счет В(&СчетаКЗ)) ТОГДА
	|			ИСТИНА
	|		КОГДА Счет В(&СчетаКЗ) ИЛИ (СчетВид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) И НЕ Счет В(&СчетаДЗ)) ТОГДА
	|			ЛОЖЬ
	|		КОГДА СчетВид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный) ТОГДА
	|			(СуммаОстаток >= 0)
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ													КАК ЭтоДебиторскаяЗадолженность
	|ПОМЕСТИТЬ
	|	ОстаткиКлассифицированные
	|ИЗ
	|	ОстаткиФактические
	|ГДЕ
	|	СуммаОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Дебиторская задолженность
	|//
	|ВЫБРАТЬ
	|	Счет					КАК Счет,
	|	СчетПорядок				КАК СчетПорядок,
	|	СчетЗабалансовый		КАК СчетЗабалансовый,
	|	СчетБезДетализацииКОСГУ	КАК СчетБезДетализацииКОСГУ,
	|	СчетКИЕ					КАК СчетКИЕ,
	|	КФО						КАК КФО,
	|	КФОПорядок				КАК КФОПорядок,
	|	КПС						КАК КПС,
	|	КЭК						КАК КЭК,
	|	ИФО						КАК ИФО,
	|	Контрагент				КАК Контрагент,
	|	КонтрагентНаименование	КАК КонтрагентНаименование,
	|	КонтрагентКИЕ			КАК КонтрагентКИЕ,
	|	Договор					КАК Договор,
	|	КодЦели					КАК КодЦели,
	|	ВидНалоговИПлатежейНаименование	КАК ВидНалоговИПлатежейНаименование,
	|	0						КАК НеПодтверждено,
	|	0						КАК ИстекСрокДавности,
	|	Остаток					КАК Всего,
	|	Остаток					КАК Подтверждено
	|ИЗ
	|	ОстаткиКлассифицированные
	|ГДЕ
	|	ЭтоДебиторскаяЗадолженность
	|УПОРЯДОЧИТЬ ПО
	|	КонтрагентНаименование," + ?(ШапкаДокумента.РежимЗаполнения = 1, "Договор,", "") + "
	|	СчетПорядок,
	|	КФОПорядок,
	|	КПСПредставление,
	|	ИФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Кредиторская задолженность
	|//
	|ВЫБРАТЬ
	|	Счет					КАК Счет,
	|	СчетПорядок				КАК СчетПорядок,
	|	СчетЗабалансовый		КАК СчетЗабалансовый,
	|	СчетБезДетализацииКОСГУ	КАК СчетБезДетализацииКОСГУ,
	|	СчетКИЕ					КАК СчетКИЕ,
	|	КФО						КАК КФО,
	|	КФОПорядок				КАК КФОПорядок,
	|	КПС						КАК КПС,
	|	КЭК						КАК КЭК,
	|	ИФО						КАК ИФО,
	|	Контрагент				КАК Контрагент,
	|	КонтрагентНаименование	КАК КонтрагентНаименование,
	|	КонтрагентКИЕ			КАК КонтрагентКИЕ,
	|	Договор					КАК Договор,
	|	КодЦели					КАК КодЦели,
	|	ВидНалоговИПлатежейНаименование	КАК ВидНалоговИПлатежейНаименование,
	|	0						КАК НеПодтверждено,
	|	0						КАК ИстекСрокДавности,
	|	Остаток					КАК Всего,
	|	Остаток					КАК Подтверждено
	|ИЗ
	|	ОстаткиКлассифицированные
	|ГДЕ
	|	НЕ ЭтоДебиторскаяЗадолженность
	|УПОРЯДОЧИТЬ ПО
	|	КонтрагентНаименование," + ?(ШапкаДокумента.РежимЗаполнения = 1, "Договор,", "") + "
	|	СчетПорядок,
	|	КФОПорядок,
	|	КПСПредставление,
	|	ИФО
	|;";
	
	Результаты = ЗапросЗаполнение.ВыполнитьПакет();
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	СчетаРасчетовКИСЕ = БухгалтерскийУчет.СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ());
	
	РезультатыЗаполнения = Новый Структура();
	
	Если ПараметрыПроцедуры.ЗаполнитьДебиторскуюЗадолженность Тогда
		
		ДебиторскаяЗадолженность = Результаты[3].Выгрузить();
		
		ПрименитьВидНалоговИПлатежей(ДебиторскаяЗадолженность);
		
		Если ШапкаДокумента.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
			ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(ДебиторскаяЗадолженность, СчетаРасчетовКИСЕ);
		КонецЕсли;
		
		ДополнительныеПараметры = ИнвентаризацияСервер.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации();
		ДополнительныеПараметры.ВидЗадолженности						= Перечисления.ВидыЗадолженности.Дебиторская;
		ДополнительныеПараметры.ИспользоватьУчетПоИФО					= ИспользоватьУчетПоИФО;
		ДополнительныеПараметры.ИспользоватьКонтрольИсполненияДоговоров	= ИспользоватьКонтрольИсполненияДоговоров;
		
		ИнвентаризацияСервер.ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации(ДебиторскаяЗадолженность, ШапкаДокумента, ДополнительныеПараметры);
		
		РезультатыЗаполнения.Вставить("ДебиторскаяЗадолженность", ДебиторскаяЗадолженность);
		
	КонецЕсли;
	
	Если ПараметрыПроцедуры.ЗаполнитьКредиторскуюЗадолженность Тогда
		
		КредиторскаяЗадолженность = Результаты[4].Выгрузить();
		
		ПрименитьВидНалоговИПлатежей(КредиторскаяЗадолженность);
		
		Если ШапкаДокумента.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
			ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(КредиторскаяЗадолженность, СчетаРасчетовКИСЕ);
		КонецЕсли;
		
		ДополнительныеПараметры = ИнвентаризацияСервер.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации();
		ДополнительныеПараметры.ВидЗадолженности						= Перечисления.ВидыЗадолженности.Кредиторская;
		ДополнительныеПараметры.ИспользоватьУчетПоИФО					= ИспользоватьУчетПоИФО;
		ДополнительныеПараметры.ИспользоватьКонтрольИсполненияДоговоров	= ИспользоватьКонтрольИсполненияДоговоров;
		
		ИнвентаризацияСервер.ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации(КредиторскаяЗадолженность, ШапкаДокумента, ДополнительныеПараметры);
		
		РезультатыЗаполнения.Вставить("КредиторскаяЗадолженность", КредиторскаяЗадолженность);
		
	КонецЕсли;
	
	Если ПараметрыПроцедуры.РежимЗаполнения > 0 Тогда
		ПараметрыПоискаОборотов = ИнвентаризацияСервер.ПолучитьПустыеПараметрыПоискаОборотовСНачалаГода();
		ПараметрыПоискаОборотов.Организация							= ШапкаДокумента.Организация;
		ПараметрыПоискаОборотов.ДатаИнвентаризации					= ШапкаДокумента.ДатаИнвентаризации;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоИФО				= ИспользоватьУчетПоИФО;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоПодразделениям	= ИспользоватьУчетПоПодразделениям;
		
		Если ПараметрыПроцедуры.ЗаполнитьДебиторскуюЗадолженность Тогда
			ИнвентаризацияСервер.ОставитьОстаткиТолькоПросроченнойЗадолженности52н(РезультатыЗаполнения.ДебиторскаяЗадолженность, ПараметрыПоискаОборотов, ПараметрыПроцедуры.РежимЗаполнения);
		КонецЕсли;
		
		Если ПараметрыПроцедуры.ЗаполнитьКредиторскуюЗадолженность Тогда
			ИнвентаризацияСервер.ОставитьОстаткиТолькоПросроченнойЗадолженности52н(РезультатыЗаполнения.КредиторскаяЗадолженность, ПараметрыПоискаОборотов, ПараметрыПроцедуры.РежимЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(РезультатыЗаполнения, АдресРезультата);
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

