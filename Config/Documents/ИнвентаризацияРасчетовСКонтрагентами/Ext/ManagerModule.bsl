#Область ПечатьДокумента

// Форма 0504089 (инвентаризационная опись расчетов с покупателями, поставщиками
// и прочими дебиторами и кредиторами)
Функция	ПечатьФормы0504089(МассивСсылок, ОбъектыПечати, Расширенная = Ложь, РедакцияПечатнойФормы = Неопределено)
	
	// Используемый макет
	Если РедакцияПечатнойФормы = "103н" И Расширенная Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовСКонтрагентами.ПФ_MXL_Ф0504089_Расширенная_103н");
		
		КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовСКонтрагентами_ф0504089_Расширенная_103н";
		
	ИначеЕсли РедакцияПечатнойФормы = "103н" И НЕ Расширенная Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовСКонтрагентами.ПФ_MXL_Ф0504089_103н");
		
		КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовСКонтрагентами_ф0504089_103н";
		
	ИначеЕсли Расширенная Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовСКонтрагентами.ПФ_MXL_Ф0504089_Расширенная");
		
		КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовСКонтрагентами_ф0504089_Расширенная";
		
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияРасчетовСКонтрагентами.ПФ_MXL_Ф0504089");
		
		КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияРасчетовСКонтрагентами_ф0504089";
	КонецЕсли;
	
	// Заполняемый табличный документ
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб				= Истина;
	ТабДокумент.ОриентацияСтраницы		= ОриентацияСтраницы.Портрет;
