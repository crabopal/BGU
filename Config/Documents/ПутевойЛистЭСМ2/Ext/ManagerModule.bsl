		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РуководительПодразделенияФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("ДолжностьРуководителяПодразделения", ДанныеСотрудника.Должность);
		//Прораб
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Прораб, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ПрорабФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		
	
		СтруктураДанных.Вставить("ЧислоДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""ММ"""));
		СтруктураДанных.Вставить("ГодДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""гг"""));
		
