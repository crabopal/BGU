			СтруктураДанныхСтроки = Новый Структура;
			
			СтруктураДанныхСтроки.Вставить("ЧислоМесяца", Формат(ВыборкаРезультаты.ЧислоМесяца,"ДФ=""дд"""));
			СтруктураДанныхСтроки.Вставить("ВремяНачала", Формат(ВыборкаРезультаты.НачалоРаботы,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяОкончания", Формат(ВыборкаРезультаты.ОкончаниеРаботы,"ДФ=""ЧЧ:мм"""));
			НаименованиеАдрес = СокрЛП(ВыборкаРезультаты.НаименованиеОбъекта)+", "+СокрЛП(ВыборкаРезультаты.АдресОбъекта);
			СтруктураДанныхСтроки.Вставить("ОбъектНаименованиеАдрес", ?(НаименованиеАдрес = ", ","",НаименованиеАдрес));
