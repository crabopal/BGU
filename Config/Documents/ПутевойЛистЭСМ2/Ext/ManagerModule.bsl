	|	)
	|ИЗ
	|	Документ.ПутевойЛистЭСМ2 КАК ПутевойЛистЭСМ2
	|ГДЕ
	|	ПутевойЛистЭСМ2.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0340002";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		ТелефонЗаказчика = "";
		АдресЗаказчика = "";
		Если ЗначениеЗаполнено(СтруктураДанных.Заказчик) Тогда
			Если ВыборкаДокументов.Заказчик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
				АдресЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
				ТелефонЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
			ИначеЕсли ВыборкаДокументов.Заказчик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				АдресЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
				ТелефонЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
			КонецЕсли;
			СтруктураДанных.Вставить("НаименованиеЗаказчикаАдресТелефон", СтруктураДанных.НаименованиеЗаказчика + ", "+АдресЗаказчика+", "+ТелефонЗаказчика);
		КонецЕсли;
		
		//Машинист
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Машинист, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МашинистФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("МашинистРП", СтруктураДанных.Машинист.Контрагент.НаименованиеРП);
		//ТаксировщикПутевогоЛиста
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.ТаксировщикПутевогоЛиста, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РасчетчикФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("ДолжностьРасчетчика", ДанныеСотрудника.Должность);
		//РуководительПодразделения
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.РуководительПодразделения, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РуководительПодразделенияФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("ДолжностьРуководителяПодразделения", ДанныеСотрудника.Должность);
		//Прораб
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Прораб, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ПрорабФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		
	
		СтруктураДанных.Вставить("ЧислоДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""ММ"""));
		СтруктураДанных.Вставить("ГодДаты", 	Формат(ВыборкаДокументов.ДатаПутевогоЛиста,"ДФ=""гг"""));
		
		МаркаМашины = УчетГСМ.ПолучитьМаркуТС(СтруктураДанных.Машина);
		
		СтруктураДанных.Вставить("МаркаМашины", 	МаркаМашины);	
		СтруктураДанных.Вставить("Колонна", 	УчетГСМ.ПолучитьКолоннуТС(СтруктураДанных.Машина));
		
		СтруктураДанных.Вставить("НаименованиеМаркаМашины", 	Строка(СтруктураДанных.Машина) + ", "+МаркаМашины);
		
		СтруктураДанных.Вставить("КодВидаОперации", 	СтруктураДанных.КодВидаОперации);
		
		СтруктураДанных.Вставить("НачалоПериода", Формат(ВыборкаДокументов.НачалоПериода,"ДФ=""дд.ММ.гггг"""));	
		СтруктураДанных.Вставить("КонецПериода", Формат(ВыборкаДокументов.КонецПериода,"ДФ=""дд.ММ.гггг"""));	
		
		ПараметрыОС = Новый Структура;
		ПараметрыОС.Вставить("ОсновноеСредство", СтруктураДанных.Машина);
		
		ДанныеИнвентарногоНомера = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыОС);
		СтруктураДанных.Вставить("ИнвентарныйНомер", 	СокрЛП(ДанныеИнвентарногоНомера.ИнвентарныйНомер));
		
		//Ответственные за безопасность груза
		ВыборкаОтветственнных = ВыборкаДокументов.ОтветственныеЗаГруз.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаОтветственнных.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
		
			СтруктураДанных.Вставить("ДолжностьФИООтветственного"+НомерСтроки+"ЗаГруз", СокрЛП(ВыборкаОтветственнных.ДолжностьОтветственного)+", "+СокрЛП(ВыборкаОтветственнных.ФИООтветственного));
			
			СтруктураДанных.Вставить("Ответственный"+НомерСтроки+"ОтЗаказчика", СокрЛП(ВыборкаОтветственнных.ДолжностьОтветственногоОтЗаказчика)+", "+СокрЛП(ВыборкаОтветственнных.ФИООтветственногоОтЗаказчика));
		КонецЦикла;
		
		//Такелажники
		ВыборкаТакелажники = ВыборкаДокументов.Такелажники.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаТакелажники.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
		
			СтруктураДанных.Вставить("Такелажник"+НомерСтроки+"ФамилияИнициалы", СокрЛП(ВыборкаТакелажники.ФамилияИнициалыТакелажника));
			СтруктураДанных.Вставить("Такелажник"+НомерСтроки+"НомерУдостоверения", СокрЛП(ВыборкаТакелажники.НомерУдостоверения));
		КонецЦикла;
		
		//вывод областей табличного документа
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		//шапка таблицы задание водителю
		Область = Макет.ПолучитьОбласть("ШапкаТаблицыЗаданиеВодителю");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 11 Тогда
				Прервать;
			КонецЕсли;
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыЗаданиеВодителю");
			
			СтруктураДанныхСтроки = Новый Структура;

			СтруктураДанныхСтроки.Вставить("ЧислоМесяца", Формат(ВыборкаЗадания.ЧислоМесяца,"ДФ=""дд.ММ.гггг"""));
			НаименованиеАдрес = СокрЛП(ВыборкаЗадания.НаименованиеОбъекта)+", "+СокрЛП(ВыборкаЗадания.АдресОбъекта);
			СтруктураДанныхСтроки.Вставить("ОбъектНаименованиеАдрес", ?(НаименованиеАдрес = ", ","",НаименованиеАдрес));
			СтруктураДанныхСтроки.Вставить("ВыездВремя", Формат(ВыборкаЗадания.ВремяВыезда,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВыездСпидометр", ВыборкаЗадания.ПоказанияСпидометраПриВыезде);
			
			СтруктураДанныхСтроки.Вставить("ВозвращениеВремя", Формат(ВыборкаЗадания.ВремяВозвращения,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВозвращениеСпидометр", ВыборкаЗадания.ПоказанияСпидометраПриВозвращении);
			
			СтруктураДанныхСтроки.Вставить("ГорючееПриВыезде", ВыборкаЗадания.НаличиеГорючегоПриВыезде);
			
			МаркаКодБензин = СокрЛП(ВыборкаЗадания.МаркаБензина);
			СтруктураДанныхСтроки.Вставить("ВыданоБензинВид", ?(МаркаКодБензин="","",МаркаКодБензин));
			МаркаКодДТ = СокрЛП(ВыборкаЗадания.МаркаДТ);
			СтруктураДанныхСтроки.Вставить("ВыданоДТВид", ?(МаркаКодДТ="","",МаркаКодДТ));
			МаркаКодИное = СокрЛП(ВыборкаЗадания.МаркаИногоГорючего);
			СтруктураДанныхСтроки.Вставить("ВыданоИноеГорючееВид", ?(МаркаКодИное="","",МаркаКодИное));
			
			СтруктураДанныхСтроки.Вставить("ВыданоБензин", ВыборкаЗадания.ВыданоБензина);
			СтруктураДанныхСтроки.Вставить("ВыданоДТ", ВыборкаЗадания.ВыданоДТ);
			СтруктураДанныхСтроки.Вставить("ВыданоИноеГорючее", ВыборкаЗадания.ВыданоИногоГорючего);
			
			СтруктураДанныхСтроки.Вставить("ГорючееПриВозвращении", ВыборкаЗадания.ОстатокГорючегоПриВозвращении);
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыЗаданиеВодителю");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		
		//Оборотная сторона
		Область = Макет.ПолучитьОбласть("ШапкаТаблицыОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		ВыборкаРезультаты = ВыборкаДокументов.РезультатыРаботыТС.Выбрать();
		НомерСтроки = 0;
		Пока ВыборкаРезультаты.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 11 Тогда
				Прервать;
			КонецЕсли;
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			
			СтруктураДанныхСтроки = Новый Структура;
			
			СтруктураДанныхСтроки.Вставить("ЧислоМесяца", Формат(ВыборкаРезультаты.ЧислоМесяца,"ДФ=""дд.ММ.гггг"""));
			СтруктураДанныхСтроки.Вставить("ВремяНачала", Формат(ВыборкаРезультаты.НачалоРаботы,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяОкончания", Формат(ВыборкаРезультаты.ОкончаниеРаботы,"ДФ=""ЧЧ:мм"""));
			НаименованиеАдрес = СокрЛП(ВыборкаРезультаты.НаименованиеОбъекта)+", "+СокрЛП(ВыборкаРезультаты.АдресОбъекта);
			СтруктураДанныхСтроки.Вставить("ОбъектНаименованиеАдрес", ?(НаименованиеАдрес = ", ","",НаименованиеАдрес));
			СтруктураДанныхСтроки.Вставить("КодОбъекта", СокрЛП(ВыборкаРезультаты.КодОбъекта));
			СтруктураДанныхСтроки.Вставить("КодВидаРаботы", СокрЛП(ВыборкаРезультаты.КодВидаРаботы));
			СтруктураДанныхСтроки.Вставить("КодЭтапаРаботы", СокрЛП(ВыборкаРезультаты.КодЭтапаРаботы));
			СтруктураДанныхСтроки.Вставить("ОтработаноЧасов", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениРаботыТСВсего));
			СтруктураДанныхСтроки.Вставить("СтоимостьРаботы", ВыборкаРезультаты.СтоимостьРаботы);
			СтруктураДанныхСтроки.Вставить("КодПростоя", СокрЛП(ВыборкаРезультаты.КодПричиныПростоя));
			СтруктураДанныхСтроки.Вставить("КодВиновникаПростоя", СокрЛП(ВыборкаРезультаты.КодВиновникаПростоя));
			СтруктураДанныхСтроки.Вставить("ЧасыПростои", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениПростоя));
			
			СтруктураДанныхСтроки.Вставить("НочныеЧасы",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПНочныеЧасы));
			СтруктураДанныхСтроки.Вставить("ЧасыПробега",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПКоличествоВремени));
			СтруктураДанныхСтроки.Вставить("РасстояниеПробега", ВыборкаРезультаты.ПоказателиЗППробег);
			СтруктураДанныхСтроки.Вставить("СтоянкаНаЛинии", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПСтоянкаНаЛинии));
			
			СтруктураДанныхСтроки.Вставить("ПрочиеСверхурочные", СокрЛП(ВыборкаРезультаты.ПрочееСверхурочноеВид));
			СтруктураДанныхСтроки.Вставить("КодВидаОплатыПрочих", СокрЛП(ВыборкаРезультаты.КодВидаОплатыПрочегоСверхурочногоВремени));
			СтруктураДанныхСтроки.Вставить("ЧасыПрочих", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПрочееСверхурочноеВремя));
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
			
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Область = Макет.ПолучитьОбласть("ИтогоТаблицыОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ПодвалОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛистЭСМ2";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛистЭСМ2.ПФ_MXL_Форма0340002_368");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛистЭСМ2.Ссылка КАК Ссылка,
	|	ПутевойЛистЭСМ2.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛистЭСМ2.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛистЭСМ2.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Заказчик.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).КодОКПО КАК КодОКПОЗаказчика,
	|	ПутевойЛистЭСМ2.Заказчик,
	|	ПутевойЛистЭСМ2.СрокДействия,
	|	ПутевойЛистЭСМ2.ТранспортноеСредство КАК Машина,
	|	ПутевойЛистЭСМ2.Водитель КАК Машинист,
	|	ПутевойЛистЭСМ2.Комментарий,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛистЭСМ2.ОтветственныеЗаГруз.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФИООтветственного,
	|		ДолжностьОтветственного,
	|		ФИООтветственногоОтЗаказчика,
	|		ДолжностьОтветственногоОтЗаказчика
	|	),
	|	ПутевойЛистЭСМ2.Такелажники.(
	|		Ссылка,
	|		НомерСтроки,
	|		ФамилияИнициалыТакелажника,
	|		НомерУдостоверения
	|	),
	|	ПутевойЛистЭСМ2.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		ЧислоМесяца,
	|		НаименованиеОбъекта,
	|		АдресОбъекта,
	|		ВремяВыезда,
	|		ВремяВозвращения,
	|		ПоказанияСпидометраПриВыезде,
	|		ПоказанияСпидометраПриВозвращении,
	|		НаличиеГорючегоПриВыезде,
	|		ВыданоИногоГорючего,
	|		ВыданоБензина,
	|		ВыданоДТ,
	|		ОстатокГорючегоПриВозвращении,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоБензинВидГСМ КАК Справочник.ВидыГСМ).МаркаГорючего КАК МаркаБензина,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоБензинВидГСМ КАК Справочник.ВидыГСМ).КодМаркиГорючего КАК КодМаркиБензина,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоДТВидГСМ КАК Справочник.ВидыГСМ).МаркаГорючего КАК МаркаДТ,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоДТВидГСМ КАК Справочник.ВидыГСМ).КодМаркиГорючего КАК КодМаркиДТ,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоИногоГорючегоВидГСМ КАК Справочник.ВидыГСМ).МаркаГорючего КАК МаркаИногоГорючего,
	|		ВЫРАЗИТЬ(ПутевойЛистЭСМ2.ЗаданиеВодителю.ВыданоИногоГорючегоВидГСМ КАК Справочник.ВидыГСМ).КодМаркиГорючего КАК КодМаркиИногоГорючего
	|	),
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Заказчик.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное КАК НаименованиеЗаказчика,
	|	ПутевойЛистЭСМ2.НачалоПериода,
	|	ПутевойЛистЭСМ2.КонецПериода,
	|	ПутевойЛистЭСМ2.СтоимостьОдногоМашиноЧаса,
	|	ПутевойЛистЭСМ2.ТаксировщикПутевогоЛиста,
	|	ПутевойЛистЭСМ2.ПретензииКРаботеМашиниста,
	|	ПутевойЛистЭСМ2.ФактическийРасходБензина,
	|	ПутевойЛистЭСМ2.ФактическийРасходДТ,
	|	ПутевойЛистЭСМ2.ФактическийРасходИногоГорючего,
	|	ПутевойЛистЭСМ2.РасходБензинаПоНорме,
	|	ПутевойЛистЭСМ2.РасходДТПоНорме,
	|	ПутевойЛистЭСМ2.РасходИногоГорючегоПоНорме,
	|	ПутевойЛистЭСМ2.Участок,
	|	ПутевойЛистЭСМ2.КодВидаОперации,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Водитель.Контрагент КАК Справочник.Контрагенты).НаименованиеРП КАК МашинистРП,
	|	ПутевойЛистЭСМ2.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛистЭСМ2.Прораб,
	|	ПутевойЛистЭСМ2.РуководительПодразделения,
	|	ПутевойЛистЭСМ2.СведенияОПеревозке,
	|	ПутевойЛистЭСМ2.РезультатыРаботыТС.(
	|		Ссылка,
	|		НомерСтроки,
	|		ЧислоМесяца,
	|		НачалоРаботы,
	|		ОкончаниеРаботы,
	|		НаименованиеОбъекта,
	|		АдресОбъекта,
	|		КодОбъекта,
	|		КодВидаРаботы,
	|		КодЭтапаРаботы,
	|		КоличествоВремениРаботыТСВсего,
	|		СтоимостьРаботы,
	|		КодПричиныПростоя,
	|		КодВиновникаПростоя,
	|		КоличествоВремениПростоя,
	|		ПоказателиЗПНочныеЧасы,
	|		ПоказателиЗППробег,
	|		ПоказателиЗПКоличествоВремени,
	|		ПоказателиЗПСтоянкаНаЛинии,
	|		ПрочееСверхурочноеВид,
	|		КодВидаОплатыПрочегоСверхурочногоВремени,
	|		ПрочееСверхурочноеВремя
	|	)
	|ИЗ
	|	Документ.ПутевойЛистЭСМ2 КАК ПутевойЛистЭСМ2
	|ГДЕ
	|	ПутевойЛистЭСМ2.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0340002";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
