		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ДанныеВодителя = УчетГСМ.ПолучитьДанныеВодителя(СтруктураДанных.Машинист, СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия);
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Машинист, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
		СтруктураДанных.Машинист = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
			
		Область.Параметры.Заполнить(ДанныеВодителя);
		
		ТабличныйДокумент.Вывести(Область);
		
		//шапка таблицы задание водителю
		Область = Макет.ПолучитьОбласть("ШапкаТаблицыЗаданиеВодителю");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 11 Тогда
				Прервать;
			КонецЕсли;
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыЗаданиеВодителю");
			
			СтруктураДанныхСтроки = Новый Структура;

			СтруктураДанныхСтроки.Вставить("ЧислоМесяца", Формат(ВыборкаЗадания.ЧислоМесяца,"ДФ=""дд.ММ.гггг"""));
			НаименованиеАдрес = СокрЛП(ВыборкаЗадания.НаименованиеОбъекта)+", "+СокрЛП(ВыборкаЗадания.АдресОбъекта);
			СтруктураДанныхСтроки.Вставить("ОбъектНаименованиеАдрес", ?(НаименованиеАдрес = ", ","",НаименованиеАдрес));
			СтруктураДанныхСтроки.Вставить("ВыездВремя", Формат(ВыборкаЗадания.ВремяВыезда,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВыездСпидометр", ВыборкаЗадания.ПоказанияСпидометраПриВыезде);
			
			СтруктураДанныхСтроки.Вставить("ВозвращениеВремя", Формат(ВыборкаЗадания.ВремяВозвращения,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВозвращениеСпидометр", ВыборкаЗадания.ПоказанияСпидометраПриВозвращении);
			
			СтруктураДанныхСтроки.Вставить("ГорючееПриВыезде", ВыборкаЗадания.НаличиеГорючегоПриВыезде);
			
			МаркаКодБензин = СокрЛП(ВыборкаЗадания.МаркаБензина);
			СтруктураДанныхСтроки.Вставить("ВыданоБензинВид", ?(МаркаКодБензин="","",МаркаКодБензин));
			МаркаКодДТ = СокрЛП(ВыборкаЗадания.МаркаДТ);
			СтруктураДанныхСтроки.Вставить("ВыданоДТВид", ?(МаркаКодДТ="","",МаркаКодДТ));
			МаркаКодИное = СокрЛП(ВыборкаЗадания.МаркаИногоГорючего);
			СтруктураДанныхСтроки.Вставить("ВыданоИноеГорючееВид", ?(МаркаКодИное="","",МаркаКодИное));
			
			СтруктураДанныхСтроки.Вставить("ВыданоБензин", ВыборкаЗадания.ВыданоБензина);
			СтруктураДанныхСтроки.Вставить("ВыданоДТ", ВыборкаЗадания.ВыданоДТ);
			СтруктураДанныхСтроки.Вставить("ВыданоИноеГорючее", ВыборкаЗадания.ВыданоИногоГорючего);
			
			СтруктураДанныхСтроки.Вставить("ГорючееПриВозвращении", ВыборкаЗадания.ОстатокГорючегоПриВозвращении);
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыЗаданиеВодителю");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		
		//Оборотная сторона
		Область = Макет.ПолучитьОбласть("ШапкаТаблицыОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		ВыборкаРезультаты = ВыборкаДокументов.РезультатыРаботыТС.Выбрать();
		НомерСтроки = 0;
		Пока ВыборкаРезультаты.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 11 Тогда
				Прервать;
			КонецЕсли;
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			
			СтруктураДанныхСтроки = Новый Структура;
			
			СтруктураДанныхСтроки.Вставить("ЧислоМесяца", Формат(ВыборкаРезультаты.ЧислоМесяца,"ДФ=""дд.ММ.гггг"""));
			СтруктураДанныхСтроки.Вставить("ВремяНачала", Формат(ВыборкаРезультаты.НачалоРаботы,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяОкончания", Формат(ВыборкаРезультаты.ОкончаниеРаботы,"ДФ=""ЧЧ:мм"""));
			НаименованиеАдрес = СокрЛП(ВыборкаРезультаты.НаименованиеОбъекта)+", "+СокрЛП(ВыборкаРезультаты.АдресОбъекта);
			СтруктураДанныхСтроки.Вставить("ОбъектНаименованиеАдрес", ?(НаименованиеАдрес = ", ","",НаименованиеАдрес));
			СтруктураДанныхСтроки.Вставить("КодОбъекта", СокрЛП(ВыборкаРезультаты.КодОбъекта));
			СтруктураДанныхСтроки.Вставить("КодВидаРаботы", СокрЛП(ВыборкаРезультаты.КодВидаРаботы));
			СтруктураДанныхСтроки.Вставить("КодЭтапаРаботы", СокрЛП(ВыборкаРезультаты.КодЭтапаРаботы));
			СтруктураДанныхСтроки.Вставить("ОтработаноЧасов", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениРаботыТСВсего));
			СтруктураДанныхСтроки.Вставить("СтоимостьРаботы", ВыборкаРезультаты.СтоимостьРаботы);
			СтруктураДанныхСтроки.Вставить("КодПростоя", СокрЛП(ВыборкаРезультаты.КодПричиныПростоя));
			СтруктураДанныхСтроки.Вставить("КодВиновникаПростоя", СокрЛП(ВыборкаРезультаты.КодВиновникаПростоя));
			СтруктураДанныхСтроки.Вставить("ЧасыПростои", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениПростоя));
			
			СтруктураДанныхСтроки.Вставить("НочныеЧасы",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПНочныеЧасы));
			СтруктураДанныхСтроки.Вставить("ЧасыПробега",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПКоличествоВремени));
			СтруктураДанныхСтроки.Вставить("РасстояниеПробега", ВыборкаРезультаты.ПоказателиЗППробег);
			СтруктураДанныхСтроки.Вставить("СтоянкаНаЛинии", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПСтоянкаНаЛинии));
			
			СтруктураДанныхСтроки.Вставить("ПрочиеСверхурочные", СокрЛП(ВыборкаРезультаты.ПрочееСверхурочноеВид));
			СтруктураДанныхСтроки.Вставить("КодВидаОплатыПрочих", СокрЛП(ВыборкаРезультаты.КодВидаОплатыПрочегоСверхурочногоВремени));
			СтруктураДанныхСтроки.Вставить("ЧасыПрочих", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПрочееСверхурочноеВремя));
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
			
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Область = Макет.ПолучитьОбласть("ИтогоТаблицыОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ПодвалОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

#КонецОбласти

#КонецЕсли
