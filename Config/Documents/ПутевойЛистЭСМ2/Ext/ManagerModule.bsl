		СтруктураДанных.Вставить("МаркаМашины", 	МаркаМашины);	
		СтруктураДанных.Вставить("Колонна", 	УчетГСМ.ПолучитьКолоннуТС(СтруктураДанных.Машина));
		
		СтруктураДанных.Вставить("НаименованиеМаркаМашины", 	Строка(СтруктураДанных.Машина) + ", "+МаркаМашины);
		
		СтруктураДанных.Вставить("КодВидаОперации", 	СтруктураДанных.КодВидаОперации);
		СтруктураДанных.Вставить("СведенияОПеревозке", СтруктураДанных.СведенияОПеревозке);
		
		СтруктураДанных.Вставить("НачалоПериода", Формат(ВыборкаДокументов.НачалоПериода,"ДФ=""дд.ММ.гггг"""));	
		СтруктураДанных.Вставить("КонецПериода", Формат(ВыборкаДокументов.КонецПериода,"ДФ=""дд.ММ.гггг"""));	
		
		ПараметрыОС = Новый Структура;
		ПараметрыОС.Вставить("ОсновноеСредство", СтруктураДанных.Машина);
		
		ДанныеИнвентарногоНомера = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыОС);
		СтруктураДанных.Вставить("ИнвентарныйНомер", 	СокрЛП(ДанныеИнвентарногоНомера.ИнвентарныйНомер));
		
		//Ответственные за безопасность груза
