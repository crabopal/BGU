			СтруктураДанныхСтроки.Вставить("ВыданоИноеГорючее", ВыборкаЗадания.ВыданоИногоГорючего);
			
			СтруктураДанныхСтроки.Вставить("ГорючееПриВозвращении", ВыборкаЗадания.ОстатокГорючегоПриВозвращении);
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыЗаданиеВодителю");
