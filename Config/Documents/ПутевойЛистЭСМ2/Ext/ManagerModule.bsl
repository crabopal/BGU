			СтруктураДанныхСтроки.Вставить("КодВидаРаботы", СокрЛП(ВыборкаРезультаты.КодВидаРаботы));
			СтруктураДанныхСтроки.Вставить("КодЭтапаРаботы", СокрЛП(ВыборкаРезультаты.КодЭтапаРаботы));
			СтруктураДанныхСтроки.Вставить("ОтработаноЧасов", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениРаботыТСВсего));
			СтруктураДанныхСтроки.Вставить("СтоимостьРаботы", ВыборкаРезультаты.СтоимостьРаботы);
			СтруктураДанныхСтроки.Вставить("КодПростоя", СокрЛП(ВыборкаРезультаты.КодПричиныПростоя));
			СтруктураДанныхСтроки.Вставить("КодВиновникаПростоя", СокрЛП(ВыборкаРезультаты.КодВиновникаПростоя));
			СтруктураДанныхСтроки.Вставить("ЧасыПростои", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.КоличествоВремениПростоя));
			
			СтруктураДанныхСтроки.Вставить("НочныеЧасы",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПНочныеЧасы));
			СтруктураДанныхСтроки.Вставить("ЧасыПробега",УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПКоличествоВремени));
			СтруктураДанныхСтроки.Вставить("РасстояниеПробега", ВыборкаРезультаты.ПоказателиЗППробег);
			СтруктураДанныхСтроки.Вставить("СтоянкаНаЛинии", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПоказателиЗПСтоянкаНаЛинии));
			
			СтруктураДанныхСтроки.Вставить("ПрочиеСверхурочные", СокрЛП(ВыборкаРезультаты.ПрочееСверхурочноеВид));
			СтруктураДанныхСтроки.Вставить("КодВидаОплатыПрочих", СокрЛП(ВыборкаРезультаты.КодВидаОплатыПрочегоСверхурочногоВремени));
			СтруктураДанныхСтроки.Вставить("ЧасыПрочих", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаРезультаты.ПрочееСверхурочноеВремя));
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			ТабличныйДокумент.Вывести(Область);
			
		КонецЦикла;
		
		Для н = 1 По (11-НомерСтроки) Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Область = Макет.ПолучитьОбласть("ИтогоТаблицыОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ПодвалОборотнойСтороны");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста152ПриказМинтранса(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛистЭСМ2";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛистЭСМ2.ПФ_MXL_Форма0340002_152");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛистЭСМ2.Ссылка КАК Ссылка,
	|	ПутевойЛистЭСМ2.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛистЭСМ2.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛистЭСМ2.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛистЭСМ2.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
