			Если ВыборкаДокументов.Заказчик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
				АдресЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
				ТелефонЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
			ИначеЕсли ВыборкаДокументов.Заказчик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				АдресЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
				ТелефонЗаказчика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Заказчик.ЮридическоеФизическоеЛицо, 
																									Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
			КонецЕсли;
			СтруктураДанных.Вставить("НаименованиеЗаказчикаАдресТелефон", СтруктураДанных.НаименованиеЗаказчика + ", "+АдресЗаказчика+", "+ТелефонЗаказчика);
		КонецЕсли;
		
		//Машинист
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Машинист, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МашинистФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("МашинистРП", СтруктураДанных.Машинист.Контрагент.НаименованиеРП);
		//ТаксировщикПутевогоЛиста
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.ТаксировщикПутевогоЛиста, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РасчетчикФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("ДолжностьРасчетчика", ДанныеСотрудника.Должность);
		//РуководительПодразделения
