&НаКлиенте
Процедура ПроверитьКорректностьПериодаРабот()
	Если НЕ(Объект.НачалоПериода = Дата(1,1,1) ИЛИ Объект.КонецПериода = Дата(1,1,1)) Тогда
		Если Объект.НачалоПериода>Объект.КонецПериода Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Дата начала периода работ %1 больше даты окончания периода работ %2.'"), Формат(Объект.НачалоПериода,"ДФ=""дд.ММ.гггг"""), Формат(Объект.КонецПериода,"ДФ=""дд.ММ.гггг"""));
			Сообщение.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСрокДействияПоУмолчанию()
	Если (КонецДня(Объект.Дата) > КонецДня(Объект.СрокДействия))ИЛИ(Объект.СрокДействия = Дата(1,1,1)) Тогда
		Объект.СрокДействия = КонецДня(Объект.Дата);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТекстПроТаксировку()
	УчетГСМ.ЗаполнитьТекстПроТаксировку(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПерерасчетРасходаГорючего()
	Стр = Элементы.ЗаданиеВодителю.ТекущиеДанные;

	КоличествоЗаполненыхГраф = 0;
	Если Стр.ВыданоБензина <> 0 Тогда
		КоличествоЗаполненыхГраф  = КоличествоЗаполненыхГраф + 1;
	КонецЕсли;	
	Если Стр.ВыданоДТ <> 0 Тогда
		КоличествоЗаполненыхГраф  = КоличествоЗаполненыхГраф + 1;
	КонецЕсли;	
	Если Стр.ВыданоИногоГорючего <> 0 Тогда
		КоличествоЗаполненыхГраф  = КоличествоЗаполненыхГраф + 1;
	КонецЕсли;	
	
	ФактическийРасходБензина = 0;
	ФактическийРасходДТ = 0;
	ФактическийРасходИногоГорючего = 0;
	
	Если КоличествоЗаполненыхГраф > 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='В табличной части ""Задание водителю"" для одной строки указано количество для различных видов топлив,
		|что не позволяет произвести расчет остатка. Внесите исправление для некорректной строки.'");
		Сообщение.Сообщить();
	Иначе	
		
		Для каждого ТекущаяСтрока Из Объект.ЗаданиеВодителю Цикл
			Если ТекущаяСтрока.ВыданоБензина <> 0 Тогда
				РасходГорючегоПоФакту = ТекущаяСтрока.НаличиеГорючегоПриВыезде - ТекущаяСтрока.ОстатокГорючегоПриВозвращении + ТекущаяСтрока.ВыданоБензина;
				ФактическийРасходБензина = ФактическийРасходБензина + РасходГорючегоПоФакту;
			КонецЕсли;	
			Если ТекущаяСтрока.ВыданоДТ <> 0 Тогда
				РасходГорючегоПоФакту = ТекущаяСтрока.НаличиеГорючегоПриВыезде - ТекущаяСтрока.ОстатокГорючегоПриВозвращении + ТекущаяСтрока.ВыданоДТ;
				ФактическийРасходДТ = ФактическийРасходДТ+РасходГорючегоПоФакту;
			КонецЕсли;	
			Если Стр.ВыданоИногоГорючего <> 0 Тогда
				РасходГорючегоПоФакту = ТекущаяСтрока.НаличиеГорючегоПриВыезде - ТекущаяСтрока.ОстатокГорючегоПриВозвращении + ТекущаяСтрока.ВыданоИногоГорючего;
				ФактическийРасходИногоГорючего = ФактическийРасходИногоГорючего + РасходГорючегоПоФакту;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Объект.ФактическийРасходБензина = ФактическийРасходБензина;
	Объект.ФактическийРасходДТ = ФактическийРасходДТ;
	Объект.ФактическийРасходИногоГорючего = ФактическийРасходИногоГорючего;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыполнитьПослеВыбораАдресаЗаказчика(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЗаданиеВодителю.ТекущиеДанные.АдресОбъекта = УчетГСМКлиент.ПодготовитьСтрокуАдреса(ВыбранныйЭлемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораАдресОбъекта(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РезультатыРаботыТС.ТекущиеДанные.АдресОбъекта = УчетГСМКлиент.ПодготовитьСтрокуАдреса(ВыбранныйЭлемент);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьРежимыЗаполненияДанных()
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	СтруктураРежимовЗаполнения = УчетГСМ.РежимыНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства, ИдентификаторДокумента, Объект.ТранспортноеСредство);
	ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
	ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
	ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ;
	ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияДокумента(ОсновноеСредство)
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	ТаблицаНастроек = УчетГСМ.ДанныеНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства, ИдентификаторДокумента, ОсновноеСредство);
	
	Для Каждого ТекСтрока Из ТаблицаНастроек Цикл
		ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
		ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
		ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ = ТекСтрока.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ;
		ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ = ТекСтрока.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ;
		
		Объект.Водитель = ТекСтрока.Водитель;
		Объект.Заказчик = ТекСтрока.Заказчик;
		
		Объект.НачалоПериода = ТекСтрока.НачалоПериода;
		Объект.КонецПериода = ТекСтрока.КонецПериода;
		Объект.СтоимостьОдногоМашиноЧаса = ТекСтрока.СтоимостьОдногоМашиноЧаса;
		Объект.Участок = ТекСтрока.Участок;
		Объект.КодВидаОперации = ТекСтрока.КодВидаОперации;
		Объект.Прораб = ТекСтрока.Прораб;
		Объект.РуководительПодразделения = ТекСтрока.РуководительПодразделения;
		
		Если НЕ ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
			Объект.ВидПеревозки = ТекСтрока.ВидПеревозки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.СведенияОВидахСообщения) Тогда
			Объект.СведенияОВидахСообщения = ТекСтрока.СведенияОВидахСообщения;
			Если НЕ ЗначениеЗаполнено(ТекСтрока.СведенияОВидахСообщения) Тогда
				Объект.СведенияОВидахСообщения = СокрЛП(ТекСтрока.ВидСообщения);
			КонецЕсли;	
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеОПоказанияхСпидометра()
	ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
	
	ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
		ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраРасчетные(ПредыдущийПутевойЛист);
		ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	ИначеЕсли ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ Тогда
		ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеОбОстаткахГорючего()
	Если НЕ ЗначениеЗаполнено(ПредыдущийПутевойЛист) Тогда
		ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
	КонецЕсли;
	
	ДанныеГорючего = УчетГСМ.ОстаткиГорючегоПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПредыдущийПутевойЛист);
	ИначеЕсли ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ Тогда
		Для Каждого ТекСтрока Из ДанныеГорючего Цикл
			
			ВариантГСМ = ТекСтрока.ВариантГСМ;
			
			НоваяСтрока = Объект.ЗаданиеВодителю.Добавить();
			Если ВариантГСМ = 1 Тогда
				НоваяСтрока.ВыданоБензинВидГСМ = ТекСтрока.ВидГСМ;
			ИначеЕсли ВариантГСМ = 2 Тогда
				НоваяСтрока.ВыданоДТВидГСМ = ТекСтрока.ВидГСМ;
			ИначеЕсли ВариантГСМ = 3 Тогда
				НоваяСтрока.ВыданоИногоГорючегоВидГСМ = ТекСтрока.ВидГСМ;
			КонецЕсли;
			НоваяСтрока.НаличиеГорючегоПриВыезде = ТекСтрока.ОстатокГСМ;
		КонецЦикла;
		ОбновитьТекстЗаголовковВсехСтрокТаблицыЗаданиеВодителю(ЭтаФорма);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПутевойЛистТС)
	
	ОстатокГСМ = 0;
	
	ДанныеГорючего = УчетГСМ.ДвиженияГорючегоРасчетные(ПутевойЛистТС);
	
	Для каждого ТекСтрока Из ДанныеГорючего Цикл
		Если ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
			ОстатокГСМ = ОстатокГСМ + ТекСтрока.ОстатокГорючегоПриВозвращении;
		КонецЕсли;	
	КонецЦикла;	
	
	ОстатокГорючегоПриВыезде = ОстатокГСМ;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыЗаданиеВодителю(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ЗаданиеВодителю Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыЗаданиеВодителю(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыЗаданиеВодителю(ТекущаяСтрока)

	ТекущаяСтрока.НаименованиеОбъектаЗаголовок = НСтр("ru = 'наименование:'");
	ТекущаяСтрока.АдресОбъектаЗаголовок = НСтр("ru = 'адрес:'");
	ТекущаяСтрока.ВыездЗаголовок = НСтр("ru = 'выезд:'");
	ТекущаяСтрока.ВозвращениеЗаголовок = НСтр("ru = 'возвращение:'");
	ТекущаяСтрока.ВидБензинаЗаголовок = НСтр("ru = 'вид ГСМ:'");
	ТекущаяСтрока.БензинВыданоЗаголовок = НСтр("ru = 'выдано:'");
	
	ТекущаяСтрока.ВидДизельногоТопливаЗаголовок = НСтр("ru = 'вид ГСМ:'");
	ТекущаяСтрока.ДизельноеТопливоВыданоЗаголовок = НСтр("ru = 'выдано:'");
	
	ТекущаяСтрока.ВидИногоГорючегоЗаголовок = НСтр("ru = 'вид ГСМ:'");
	ТекущаяСтрока.ИноеГорючееВыданоЗаголовок = НСтр("ru = 'выдано:'");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОтветственныеЗаГруз(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ОтветственныеЗаГруз Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОтветственныеЗаГруз(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОтветственныеЗаГруз(ТекущаяСтрока)

	ТекущаяСтрока.ОтветственныйОтВладельцаФИОЗаголовок = НСтр("ru = 'ФИО:'");
	ТекущаяСтрока.ОтветственныйОтВладельцаДолжностьЗаголовок = НСтр("ru = 'должность:'");
	ТекущаяСтрока.ОтветственныйОтЗаказчикаФИОЗаголовок = НСтр("ru = 'ФИО:'");
	ТекущаяСтрока.ОтветственныйОтЗаказчикаДолжностьЗаголовок = НСтр("ru = 'должность:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыТС(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.РезультатыРаботыТС Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыТС(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыТС(ТекущаяСтрока)

	ТекущаяСтрока.НачалоРаботыЗаголовок = НСтр("ru = 'начало:'");
	ТекущаяСтрока.ОкончаниеРаботыЗаголовок = НСтр("ru = 'окончание:'");
	
	ТекущаяСтрока.НаименованиеОбъектаЗаголовок = НСтр("ru = 'наименование:'");
	ТекущаяСтрока.АдресОбъектаЗаголовок = НСтр("ru = 'адрес:'");
	ТекущаяСтрока.КодОбъектаЗаголовок = НСтр("ru = 'код:'");
	
	ТекущаяСтрока.КодЭтапаРаботыЗаголовок = НСтр("ru = 'код этапа:'");
	ТекущаяСтрока.КодВидаРаботыЗаголовок = НСтр("ru = 'код вида:'");
	
	ТекущаяСтрока.ВремяРаботыЗаголовок = НСтр("ru = 'время:'");
	ТекущаяСтрока.СтоимостьРаботыЗаголовок = НСтр("ru = 'стоимость:'");
	
	ТекущаяСтрока.ПричинаЗаголовок = НСтр("ru = 'причина:'");
	ТекущаяСтрока.КодПричиныЗаголовок = НСтр("ru = 'код причины:'");
	
	ТекущаяСтрока.КодВиновникаЗаголовок = НСтр("ru = 'код виновника:'");
	ТекущаяСтрока.ВремяПростояЗаголовок = НСтр("ru = 'время простоя:'");
	
	ТекущаяСтрока.НочныеЧасыЗаголовок = НСтр("ru = 'ночные часы:'");
	ТекущаяСтрока.СтоянкаЗаголовок = НСтр("ru = 'стоянка на линии:'");
	
	ТекущаяСтрока.ПробегЧасыЗаголовок = НСтр("ru = 'пробег, ч. мин.:'");
	ТекущаяСтрока.ПробегКмЗаголовок = НСтр("ru = 'пробег, км:'");
	
	ТекущаяСтрока.КодВидаОплатыЗаголовок = НСтр("ru = 'код вида оплаты:'");
	ТекущаяСтрока.ЧасыОплатыЗаголовок = НСтр("ru = 'часы оплаты:'");
	ТекущаяСтрока.ПрочиеЗаголовок = НСтр("ru = 'прочие (сверхурочные выходные и т.п.):'");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ОбновитьТекстЗаголовковВсехСтрокТаблицыЗаданиеВодителю(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОтветственныеЗаГруз(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыТС(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["НачалоПериода"]	= РезультатВыбора["НачалоПериода"];
		Объект["КонецПериода"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТранспортноеСредствоПриИзмененииНаСервере()
	
	УстановитьНомераТС();
	ЗаполнитьНастройкиЗаполненияДокумента(Объект.ТранспортноеСредство);
	Объект.НомерСмены = УчетГСМ.НомерСменыДляПутевогоЛиста(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата) + 1;
	
	//заполнение показаний спидометра при выезде
	Если ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
			ЗаполнитьДанныеОПоказанияхСпидометра();
		КонецЕсли;	
	КонецЕсли;
	
	//заполнение остатков горючего
	Если ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
			ЗаполнитьДанныеОбОстаткахГорючего();
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
		Объект.ВидПеревозки = УчетГСМ.ДанныеСведенийОПеревозкеПоУмолчанию();
	КонецЕсли;
	
	ЗаполнитьСписокВыбораВодителя();
	
КонецПроцедуры	

