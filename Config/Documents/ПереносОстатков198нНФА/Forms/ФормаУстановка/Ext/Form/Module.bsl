
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьЦМО			= Ложь;
	ЕстьДоговор		= Ложь;
	пСписокСчетов	= Новый Массив;
	
	Параметры.Свойство("Организация"	, Организация);
	Параметры.Свойство("ДатаПерехода"	, ДатаПерехода);
	Параметры.Свойство("СписокСчетов"	, пСписокСчетов);
	Параметры.Свойство("ЕстьЦМО"		, ЕстьЦМО);
	Параметры.Свойство("ЕстьДоговор"	, ЕстьДоговор);
	
	СписокСчетов.ЗагрузитьЗначения(пСписокСчетов);
	
	Элементы.ФлажокЦМО.Доступность = ЕстьЦМО;
	Элементы.ФлажокДоговор.Доступность = ЕстьДоговор;
	
	Если Не ЕстьЦМО И Не ЕстьДоговор Тогда
		ФлажокСчет = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура НовыйСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НаДату", ДатаПерехода);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Ссылка", СписокСчетов.ВыгрузитьЗначения()));	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокПриИзменении(Элемент)
	
	ДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьЭлементов()
	
	Элементы.НовыйСчет.ТолькоПросмотр	= Не ФлажокСчет;
	Элементы.ЦМО.ТолькоПросмотр			= Не ФлажокЦМО;
	Элементы.Договор.ТолькоПросмотр		= Не ФлажокДоговор;
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Структура;
	
	Если ФлажокСчет Тогда
		Результат.Вставить("НовыйСчет", НовыйСчет);
	КонецЕсли;
	Если ФлажокЦМО Тогда
		Результат.Вставить("ЦМО", ЦМО);
	КонецЕсли;
	Если ФлажокДоговор Тогда
		Результат.Вставить("Договор", Договор);
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		Закрыть();
	КонецЕсли;
	
	Результат.Вставить("СпособЗаполнения", СпособЗаполнения);
	
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры
