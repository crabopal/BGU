&НаСервере
Процедура ИнициализироватьПараметрыОпераций()
	
	ПравилаПереноса = Новый ТаблицаЗначений;
	ПравилаПереноса.Колонки.Добавить("Операция"			, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("СчетСтарый"		, Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПравилаПереноса.Колонки.Добавить("СчетНовый"		, Новый ОписаниеТипов("СписокЗначений"));
	ПравилаПереноса.Колонки.Добавить("Описание"			, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("ТипОбъекта"		, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("ОтборИК"			, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("ЕстьЦМО"			, Новый ОписаниеТипов("Булево"));
	ПравилаПереноса.Колонки.Добавить("ЕстьДоговор"		, Новый ОписаниеТипов("Булево"));
	ПравилаПереноса.Колонки.Добавить("ЕстьКонтрагент"	, Новый ОписаниеТипов("Булево"));
	
	Макет = Документы.ПереносОстатков198нНФА.ПолучитьМакет("Настройки");
	Для Сч = 2 По Макет.ВысотаТаблицы Цикл
		Операция = СокрЛП(Макет.Область("R"+Сч+"C1").Текст);
		Если Не ПустаяСтрока(Операция) Тогда
			
			СписокСчетов = СписокСчетовПоКодуИДате(Макет.Область("R"+Сч+"C2").Текст);
			СчетСтарый = ?(СписокСчетов.Количество() > 0, СписокСчетов[0], Неопределено);
			
			СписокСчетов = СписокСчетовПоКодуИДате(Макет.Область("R"+Сч+"C3").Текст);
			СчетНовый = Новый СписокЗначений;
			СчетНовый.ЗагрузитьЗначения(СписокСчетов);
			
			НоваяСтрока					= ПравилаПереноса.Добавить();
			НоваяСтрока.Операция		= Операция;
			НоваяСтрока.СчетСтарый		= СчетСтарый;
			НоваяСтрока.СчетНовый		= СчетНовый;
			НоваяСтрока.Описание		= СокрЛП(Макет.Область("R"+Сч+"C4").Текст);
			НоваяСтрока.ТипОбъекта		= СокрЛП(Макет.Область("R"+Сч+"C5").Текст);
			НоваяСтрока.ОтборИК			= СокрЛП(Макет.Область("R"+Сч+"C6").Текст);
			НоваяСтрока.ЕстьЦМО			= ЗначениеЗаполнено(СокрЛП(Макет.Область("R"+Сч+"C7").Текст));
			НоваяСтрока.ЕстьДоговор		= ЗначениеЗаполнено(СокрЛП(Макет.Область("R"+Сч+"C8").Текст));
			НоваяСтрока.ЕстьКонтрагент	= ЗначениеЗаполнено(СокрЛП(Макет.Область("R"+Сч+"C9").Текст));
			
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОпераций.Очистить();
	
	ЗаголовкиТипа = Новый Соответствие;
	ЗаголовкиТипа.Вставить("ОС"			, "Основные средства");
	ЗаголовкиТипа.Вставить("НМА"		, "Нематериальные активы");
	ЗаголовкиТипа.Вставить("НПА"		, "Непроизведеные активы");
	ЗаголовкиТипа.Вставить("КапВложения", "Капитальные вложения");
	ЗаголовкиТипа.Вставить("МЗ"			, "Материальные запасы");
	
	Для Каждого Операция Из Перечисления.ОперацииПереносОстатков198нНФА Цикл
		
		ИмяОперации = ЗначениеРеквизитаПеречисления(Операция, "Имя");
		СтрокиПравил = ПравилаПереноса.НайтиСтроки(Новый Структура("Операция", ИмяОперации));
		ПравилаОперации = ПравилаПереноса.Скопировать(СтрокиПравил, "СчетСтарый,СчетНовый");
		
		СчетаОперации = ПравилаОперации.ВыгрузитьКолонку("СчетСтарый");
		
		ПараметрыОперации = ПараметрыОпераций.Добавить();
		ПараметрыОперации.Операция = Операция;
		ПараметрыОперации.Правила.Загрузить(ПравилаОперации);
		ПараметрыОперации.Счета.ЗагрузитьЗначения(СчетаОперации);
		Если СтрокиПравил.Количество() > 0 Тогда
			ПараметрыОперации.Описание			= СтрокиПравил[0].Описание;
			ПараметрыОперации.ОтборИК			= СтрокиПравил[0].ОтборИК;
			ПараметрыОперации.ЕстьЦМО			= СтрокиПравил[0].ЕстьЦМО;
			ПараметрыОперации.ЕстьДоговор		= СтрокиПравил[0].ЕстьДоговор;
			ПараметрыОперации.ЕстьКонтрагент	= СтрокиПравил[0].ЕстьКонтрагент;
			ПараметрыОперации.ЭтоМЗ				= (СтрокиПравил[0].ТипОбъекта = "МЗ" Или ИмяОперации = "КапВложенияМЗ" Или ИмяОперации = "КапВложенияМЗ_НУ");
			ПараметрыОперации.Заголовок			= ЗаголовкиТипа[СтрокиПравил[0].ТипОбъекта];
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОперации				= ПараметрыОпераций.Добавить();
	ПараметрыОперации.Операция		= Перечисления.ОперацииПереносОстатков198нНФА.ПустаяСсылка();
	ПараметрыОперации.ЭтоМЗ			= Ложь;
	ПараметрыОперации.Заголовок		= ЗаголовкиТипа["ОС"];
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетовПоКодуИДате(СтрокаКодов)
	
	МассивКодов = СтрРазделить(СтрокаКодов, Символы.ПС, Ложь);
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаКодов.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Для Каждого ТекКод Из МассивКодов Цикл
		пТекКод = СокрЛП(ТекКод);
		НоваяСтрока = ТаблицаКодов.Добавить();
		ПозицияТочек = Найти(пТекКод, ":");
		Если ПозицияТочек = 0 Тогда
			НоваяСтрока.Код        = пТекКод;
			НоваяСтрока.ДатаНачала = Дата(1,1,1);
		Иначе	
			НоваяСтрока.Код        = Лев(пТекКод, (ПозицияТочек - 1));
			НоваяСтрока.ДатаНачала = Дата(Сред(пТекКод, (ПозицияТочек + 1)));
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.Код КАК Код,
	|	НАЧАЛОПЕРИОДА(ТаблицаКодов.ДатаНачала, ДЕНЬ) КАК ДатаНачала
	|ПОМЕСТИТЬ ТабКодов
	|ИЗ
	|	&ТаблицаКодов КАК ТаблицаКодов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабКодов КАК ТабКодов
	|		ПО ЕПСБУ.Код = ТабКодов.Код
	|			И ЕПСБУ.ДатаНачалаДействия = ТабКодов.ДатаНачала";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаКодов", ТаблицаКодов);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаПеречисления(Значение, Реквизит)
	
	Мет			= Значение.Метаданные();
	Индекс		= Перечисления[Мет.Имя].Индекс(Значение);
	Результат	= Мет.ЗначенияПеречисления[Индекс][Реквизит];
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПараметрыОперации()
	
	Возврат ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0];
	
КонецФункции

&НаКлиенте
Процедура ОтразитьПараметрыОперацииНаФорме()
	
	ПараметрыОперации = ПолучитьПараметрыОперации();
	
	Элементы.ВидОперации.РасширеннаяПодсказка.Заголовок = ПараметрыОперации.Описание;
	
	Элементы.ПереводыОбъектУчета.Заголовок	= ПараметрыОперации.Заголовок;
	Элементы.ПереводыКонтрагент.Видимость	= ПараметрыОперации.ЕстьКонтрагент;
	Элементы.ПереводыЦМО.Видимость			= ПараметрыОперации.ЕстьЦМО;
	Элементы.ПереводыДоговор.Видимость		= ПараметрыОперации.ЕстьДоговор;
	
	Элементы.ПереводыПодборОбъектов.Видимость = (Объект.ВидОперации =
		ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатков198нНФА.МЗ"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПереносаСервер()
	
	Результат = ПолучитьТаблицуОстатков();
	Объект.Переводы.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОстатков(СписокОбъектов = Неопределено)
	
	ПараметрыОперации = ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0];
	
	СписокСчетов = ПараметрыОперации.Счета.ВыгрузитьЗначения();
	
	Субконто = Новый Массив;
	Если ПараметрыОперации.ЭтоМЗ Тогда
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Иначе
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	КонецЕсли;
	
	Если ПараметрыОперации.ЕстьКонтрагент Тогда
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"		, Объект.ДатаПерехода);
	Запрос.УстановитьПараметр("Счет"		, СписокСчетов);
	Запрос.УстановитьПараметр("Субконто"	, Субконто);
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Остатки.Счет КАК СчетСтарый,
	|	Остатки.Субконто1 КАК ОбъектУчета
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			&Субконто,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И Подразделение = &Подразделение
	|				И Субконто1 В (&СписокОбъектов)) КАК Остатки
	|ГДЕ
	|	&ДопУсловие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Счет.Порядок,
	|	ОбъектУчета";
	
	Если ПараметрыОперации.ЕстьКонтрагент Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбъектУчета", "КАК ОбъектУчета,
			|	Остатки.Субконто2 КАК Контрагент");
	КонецЕсли;
		
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборСчет) Тогда
		Запрос.УстановитьПараметр("Счет", Объект.ОтборСчет);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
		Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	
	Если СписокОбъектов = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто1 В (&СписокОбъектов)", "");
	Иначе
		Запрос.УстановитьПараметр("СписокОбъектов", СписокОбъектов);
	КонецЕсли;
	
	ДопУсловие = "ИСТИНА";
	Если ЗначениеЗаполнено(ПараметрыОперации.ОтборИК) Тогда
		ДопУсловие = "ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства).ИмуществоКазны = " + ПараметрыОперации.ОтборИК;
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловие", ДопУсловие);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("СчетНовый");
	
	Для Каждого ТекСтрока Из Результат Цикл
		СписокНовыхСчетов = ПолучитьНовыйСчет(ПараметрыОперации.Правила, ТекСтрока);
		Если СписокНовыхСчетов.Количество() = 1 Тогда
			ТекСтрока.СчетНовый = СписокНовыхСчетов[0];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьНовыйСчет(Правила, ТекСтрока)
	
	Для Каждого СтрокаОперации Из Правила Цикл
		Если СтрокаОперации.СчетСтарый = ТекСтрока.СчетСтарый Тогда
			Возврат СтрокаОперации.СчетНовый.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Массив;
	
КонецФункции

&НаКлиенте
Функция НовыеСчетаОперации(СчетСтарый)
	
	Правила = ПолучитьПараметрыОперации().Правила;
	
	Для Каждого СтрокаОперации Из Правила Цикл
		Если СтрокаОперации.СчетСтарый = СчетСтарый Тогда
			Возврат СтрокаОперации.СчетНовый.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Массив;
	
КонецФункции

&НаКлиенте
Процедура ВыборСчета(Владелец, ТекущиееЗначение, СписокСчетов, НовыйСчет = Истина)
	
	ДатаДляОтбора = Объект.ДатаПерехода - ?(НовыйСчет, 0, 1);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НаДату", ДатаДляОтбора);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Ссылка", СписокСчетов));
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Владелец);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтарыйСчетСервер()
	
	ПараметрыОперации = ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0];
	
	СписокОбъектов = Объект.Переводы.Выгрузить().ВыгрузитьКолонку("ОбъектУчета");
	Результат = ПолучитьТаблицуОстатков(СписокОбъектов);
	
	ПустойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	Для Каждого ТекСтрока Из Объект.Переводы Цикл
		
		СтрРезультат = Результат.Найти(ТекСтрока.ОбъектУчета, "ОбъектУчета");
		
		Если СтрРезультат = Неопределено Тогда
			ТекСтрока.СчетСтарый = ПустойСчет;
		Иначе
			ТекСтрока.СчетСтарый = СтрРезультат.СчетСтарый;
			Если СтрРезультат.СчетНовый <> ПустойСчет Тогда
				ТекСтрока.СчетНовый = СтрРезультат.СчетНовый;
			ИначеЕсли ТекСтрока.СчетНовый <> ПустойСчет Тогда
				СписокНовыхСчетов = ПолучитьНовыйСчет(ПараметрыОперации.Правила, ТекСтрока);
				Если СписокНовыхСчетов.Найти(ТекСтрока.СчетНовый) = Неопределено Тогда
					ТекСтрока.СчетНовый = ПустойСчет;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТЧ(СписокОбъектов)
	
	Данные = ПолучитьТаблицуОстатков(СписокОбъектов);
	
	Для Каждого ОбъектУчета Из СписокОбъектов Цикл
		
		НоваяСтрока = Объект.Переводы.Добавить();
		НоваяСтрока.ОбъектУчета = ОбъектУчета;
		
		ДанныеСтроки = Данные.Найти(ОбъектУчета, "ОбъектУчета");
		Если ДанныеСтроки <> Неопределено Тогда	
			НоваяСтрока.СчетСтарый	= ДанныеСтроки.СчетСтарый;
			НоваяСтрока.СчетНовый	= ДанныеСтроки.СчетНовый;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияПоСписку(ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.СпособЗаполнения = 0 Тогда
		СтрокиЗаполнения = Объект.Переводы;
	Иначе
		СтрокиЗаполнения = Новый Массив;
		Для Каждого ВыделеннаяСтрока Из Элементы.Переводы.ВыделенныеСтроки Цикл
			СтрокиЗаполнения.Добавить(Объект.Переводы.НайтиПоИдентификатору(ВыделеннаяСтрока));
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из СтрокиЗаполнения Цикл
		
		Если ДанныеЗаполнения.Свойство("НовыйСчет") Тогда
			СтрокаТаблицы.СчетНовый = ДанныеЗаполнения["НовыйСчет"];
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ЦМО") Тогда
			СтрокаТаблицы.ЦМО = ДанныеЗаполнения["ЦМО"];
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("Договор") Тогда
			СтрокаТаблицы.Договор = ДанныеЗаполнения["Договор"];
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

