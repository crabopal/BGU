#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборОбъектов(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе,МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элементы.Переводы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗаполнить(Команда)
	
	Если Объект.Переводы.Количество() > 0 Тогда
		Если Объект.Проведен Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Заполнение возможно только в не проведеном документе'"));
		Иначе
			ТекстВопроса = "Таблица переноса будет очищена. Продолжить?";
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбъектыЗаполнитьПослеЗакрытияВопроса", ЭтаФорма, Параметры);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	Иначе
		ЗаполнитьТаблицуПереносаСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗаполнитьПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицуПереносаСервер();
	КонецЕсли;
	
КонецПроцедуры

