	ПерезаполнитьСтарыйСчетСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначение(Команда)
	
	ПараметрыОперации = ПолучитьПараметрыОперации();
	
	СписокСчетов = Новый Массив;
	Для Каждого Правило Из ПараметрыОперации.Правила Цикл
		Для Каждого СчетОперации Из Правило.СчетНовый Цикл
			Если СписокСчетов.Найти(СчетОперации.Значение) = Неопределено Тогда
				СписокСчетов.Добавить(СчетОперации.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"	, Объект.Организация);
	ПараметрыФормы.Вставить("ДатаПерехода"	, Объект.ДатаПерехода);
	ПараметрыФормы.Вставить("СписокСчетов"	, СписокСчетов);
	ПараметрыФормы.Вставить("ЕстьЦМО"		, ПараметрыОперации.ЕстьЦМО);
	ПараметрыФормы.Вставить("ЕстьДоговор"	, ПараметрыОперации.ЕстьДоговор);
	
	ОткрытьФорму("Документ.ПереносОстатков198нНФА.Форма.ФормаУстановка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

