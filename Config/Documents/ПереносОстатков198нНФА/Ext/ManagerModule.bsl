Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ВидОперации,Организация,ДатаПерехода,Дата,Номер");
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ИККонцессия Тогда
		ОтразитьДанныеДокументаИК(ДокументСсылка, ЗначенияРеквизитов, СтруктураДополнительныеСвойства);
	ИначеЕсли ЗначенияРеквизитов.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеВПользование
		Или ЗначенияРеквизитов.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеВПользованиеИК Тогда
		ОтразитьДанныеДокументаПоКонтрагентам(ДокументСсылка, ЗначенияРеквизитов,
			СтруктураДополнительныеСвойства, Перечисления.ВидыРаспоряженияОС.ПолученоВПользование);
	ИначеЕсли ЗначенияРеквизитов.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииОС
		Или ЗначенияРеквизитов.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииОСИК Тогда
		ОтразитьДанныеДокументаПоКонтрагентам(ДокументСсылка, ЗначенияРеквизитов,
			СтруктураДополнительныеСвойства, Перечисления.ВидыРаспоряженияОС.НаХранении);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьДанныеДокументаИК(ДокументСсылка, ЗначенияРеквизитов, ДопСвойства)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Период"				, Новый Граница(ЗначенияРеквизитов.ДатаПерехода-1, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодДата"			, ЗначенияРеквизитов.ДатаПерехода-1);
	Запрос.УстановитьПараметр("НазваниеДокумента"	, "Справка ф. 0504833");
	Запрос.УстановитьПараметр("НомерДокумента"		, ЗначенияРеквизитов.Номер);
	Запрос.УстановитьПараметр("ДатаДокумента"		, ЗначенияРеквизитов.Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносОстатков198нНФАПереводы.ОбъектУчета КАК ОбъектУчета,
	|	ПереносОстатков198нНФАПереводы.Договор КАК Договор,
	|	ПереносОстатков198нНФАПереводы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Объекты
	|ИЗ
	|	Документ.ПереносОстатков198нНФА.Переводы КАК ПереносОстатков198нНФАПереводы
	|ГДЕ
	|	ПереносОстатков198нНФАПереводы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.Организация КАК Организация,
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	СтоимостьОбъектовОСОстатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУОстаток,
	|	СтоимостьОбъектовОСОстатки.СуммаЕНВДОстаток КАК СуммаЕНВДОстаток,
	|	СтоимостьОбъектовОСОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ_Объекты.ОбъектУчета
	|					ИЗ
	|						ВТ_Объекты КАК ВТ_Объекты)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_Остатки.Организация КАК Организация,
	|	ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Договор КАК Договор,
	|	ВТ_Остатки.СтоимостьОстаток КАК Стоимость,
	|	ВТ_Остатки.КоличествоОстаток КАК Количество,
	|	ВТ_Остатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
	|	ВТ_Остатки.СуммаЕНВДОстаток КАК СуммаЕНВД,
	|	ВТ_Остатки.СуммаНДСОстаток КАК СуммаНДС,
	|	ВТ_Объекты.НомерСтроки КАК НомерСтроки,
	|	1 КАК ДопПорядок
	|ПОМЕСТИТЬ ВТ_Движения
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объекты КАК ВТ_Объекты
	|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_Объекты.ОбъектУчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ_Остатки.Организация,
	|	ВТ_Остатки.ОсновноеСредство,
	|	ВТ_Остатки.ИнвентарныйНомер,
	|	ВТ_Остатки.ЦМО,
	|	ВТ_Остатки.ВидРаспоряжения,
	|	ВТ_Остатки.Подразделение,
	|	ВТ_Объекты.Договор,
	|	ВТ_Остатки.СтоимостьОстаток,
	|	ВТ_Остатки.КоличествоОстаток,
	|	ВТ_Остатки.СуммаНеУчитываетсяНУОстаток,
	|	ВТ_Остатки.СуммаЕНВДОстаток,
	|	ВТ_Остатки.СуммаНДСОстаток,
	|	ВТ_Объекты.НомерСтроки,
	|	2
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объекты КАК ВТ_Объекты
	|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_Объекты.ОбъектУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПериодДата КАК Период,
	|	ВТ_Движения.ВидДвижения КАК ВидДвижения,
	|	ВТ_Движения.Организация КАК Организация,
	|	ВТ_Движения.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Движения.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Движения.ЦМО КАК ЦМО,
	|	ВТ_Движения.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ВТ_Движения.Подразделение КАК Подразделение,
	|	ВТ_Движения.Договор КАК Договор,
	|	ВТ_Движения.Стоимость КАК Стоимость,
	|	ВТ_Движения.Количество КАК Количество,
	|	ВТ_Движения.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
	|	ВТ_Движения.СуммаЕНВД КАК СуммаЕНВД,
	|	ВТ_Движения.СуммаНДС КАК СуммаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Прочее) КАК Событие,
	|	&НазваниеДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	&ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ВТ_Движения КАК ВТ_Движения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Движения.НомерСтроки,
	|	ВТ_Движения.ДопПорядок";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДопСвойства.ТаблицыДляДвижений.Вставить("СтоимостьОбъектовОС", Результат);
	
КонецПроцедуры

Процедура ОтразитьДанныеДокументаПоКонтрагентам(ДокументСсылка, ЗначенияРеквизитов, ДопСвойства, ВидРаспоряжения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"		, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("Период"			, Новый Граница(ЗначенияРеквизитов.ДатаПерехода-1, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодДата"		, ЗначенияРеквизитов.ДатаПерехода-1);
	Запрос.УстановитьПараметр("ВидРаспоряжения"	, ВидРаспоряжения);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносОстатков198нНФАПереводы.ОбъектУчета КАК ОбъектУчета,
	|	ПереносОстатков198нНФАПереводы.Контрагент КАК Контрагент,
	|	ПереносОстатков198нНФАПереводы.Договор КАК Договор,
	|	ПереносОстатков198нНФАПереводы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Объекты
	|ИЗ
	|	Документ.ПереносОстатков198нНФА.Переводы КАК ПереносОстатков198нНФАПереводы
	|ГДЕ
	|	ПереносОстатков198нНФАПереводы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Организация КАК Организация,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент КАК Контрагент,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, Контрагент) В
	|					(ВЫБРАТЬ
	|						ВТ_Объекты.ОбъектУчета,
	|						ВТ_Объекты.Контрагент
	|					ИЗ
	|						ВТ_Объекты КАК ВТ_Объекты)
	|				И ВидРаспоряжения = &ВидРаспоряжения) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_Остатки.Организация КАК Организация,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Контрагент КАК Контрагент,
	|	ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Остатки.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ВТ_Остатки.Договор КАК Договор,
	|	ВТ_Остатки.СтоимостьОстаток КАК Стоимость,
	|	ВТ_Остатки.КоличествоОстаток КАК Количество,
	|	ВТ_Объекты.НомерСтроки КАК НомерСтроки,
	|	1 КАК ДопПорядок
	|ПОМЕСТИТЬ ВТ_Движения
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объекты КАК ВТ_Объекты
	|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_Объекты.ОбъектУчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ_Остатки.Организация,
	|	ВТ_Остатки.ЦМО,
	|	ВТ_Остатки.Контрагент,
	|	ВТ_Остатки.ОсновноеСредство,
	|	ВТ_Остатки.ИнвентарныйНомер,
	|	ВТ_Остатки.ВидРаспоряжения,
	|	ВТ_Остатки.Подразделение,
	|	ВТ_Объекты.Договор,
	|	ВТ_Остатки.СтоимостьОстаток,
	|	ВТ_Остатки.КоличествоОстаток,
	|	ВТ_Объекты.НомерСтроки,
	|	2
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объекты КАК ВТ_Объекты
	|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_Объекты.ОбъектУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПериодДата КАК Период,
	|	ВТ_Движения.ВидДвижения КАК ВидДвижения,
	|	ВТ_Движения.Организация КАК Организация,
	|	ВТ_Движения.ЦМО КАК ЦМО,
	|	ВТ_Движения.Контрагент КАК Контрагент,
	|	ВТ_Движения.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Движения.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Движения.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ВТ_Движения.Подразделение КАК Подразделение,
	|	ВТ_Движения.Договор КАК Договор,
	|	ВТ_Движения.Стоимость КАК Стоимость,
	|	ВТ_Движения.Количество КАК Количество
	|ИЗ
	|	ВТ_Движения КАК ВТ_Движения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Движения.НомерСтроки,
	|	ВТ_Движения.ДопПорядок";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДопСвойства.ТаблицыДляДвижений.Вставить("СтоимостьОбъектовОСПоКонтрагентам", Результат);
	
КонецПроцедуры

