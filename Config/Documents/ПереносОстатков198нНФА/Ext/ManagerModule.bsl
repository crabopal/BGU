#Область ИсточникДанных

Функция ПустаяТаблицаОстатки() Экспорт
	
	ТипЧисло_18_2	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ТипЧисло_15_3	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ТипЧисло_15_2	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ТипСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипСубконто		= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	ПустаяТаблица.Колонки.Добавить("Счет"					, ТипСчет);
	ПустаяТаблица.Колонки.Добавить("СчетНовый"				, ТипСчет);
	ПустаяТаблица.Колонки.Добавить("Субконто1"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто2"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто3"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("ИФО"					, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО"					, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС"					, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК"					, Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	ПустаяТаблица.Колонки.Добавить("Валюта"					, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("Подразделение"			, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("Операция"				, Новый ОписаниеТипов("Строка", ,,, Новый КвалификаторыСтроки(15)));
	
	ПустаяТаблица.Колонки.Добавить("Сумма"					, ТипЧисло_18_2);
	ПустаяТаблица.Колонки.Добавить("ВалютнаяСумма"			, ТипЧисло_18_2);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ"	, ТипЧисло_15_2);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВД"				, ТипЧисло_15_2);
	ПустаяТаблица.Колонки.Добавить("СуммаНДС"				, ТипЧисло_15_2);
	ПустаяТаблица.Колонки.Добавить("Количество"				, ТипЧисло_15_3);
	
	ПустаяТаблица.Колонки.Добавить("ЦМО"					, Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПустаяТаблица.Колонки.Добавить("Контрагент"				, Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор"				, Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ТаблицаОстатки(РеквизитыДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Организация"	, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Период"		, РеквизитыДокумента.ДатаПерехода);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносОстатков.ОбъектУчета КАК ОбъектУчета,
	|	ПереносОстатков.СчетСтарый КАК Счет
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Документ.ПереносОстатков198нНФА.Переводы КАК ПереносОстатков
	|ГДЕ
	|	ПереносОстатков.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.ОбъектУчета КАК ОбъектУчета
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.Счет КАК Счет
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
	Результат		= Запрос.ВыполнитьПакет();
	СписокОбъектов	= Результат[1].Выгрузить().ВыгрузитьКолонку("ОбъектУчета");
	СписокСчетов	= Результат[2].Выгрузить().ВыгрузитьКолонку("Счет");
	
	СчетаАмортизации = Новый Массив;
	СчетаОбесценения = Новый Массив;
	
	СчетаКапВложений = Новый ТаблицаЗначений;
	ТипСчет = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	СчетаКапВложений.Колонки.Добавить("СчетУчета"		, ТипСчет);
	СчетаКапВложений.Колонки.Добавить("СчетАмортизации"	, ТипСчет);
	СчетаКапВложений.Колонки.Добавить("СчетОбесценения"	, ТипСчет);
	
	Если РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НМА
		Или РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияНМА
		Или РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияИК Тогда
		СчетаАмортизации = БухгалтерскийУчет.СписокСчетов("104.00");
		СчетаОбесценения = БухгалтерскийУчет.СписокСчетов("114.00");
	КонецЕсли;
	
	ЗаполнитьТаблицуСчетовКапВложений(СчетаКапВложений, РеквизитыДокумента.ВидОперации, РеквизитыДокумента.ДатаПерехода);
	
	Запрос.УстановитьПараметр("СписокОбъектов"	, СписокОбъектов);
	Запрос.УстановитьПараметр("Счет"			, СписокСчетов);
	Запрос.УстановитьПараметр("СчетАмортизации"	, СчетаАмортизации);
	Запрос.УстановитьПараметр("СчетОбесценения"	, СчетаОбесценения);
	Запрос.УстановитьПараметр("СчетаКапВложений", СчетаКапВложений);
	
	Запрос.Текст = ТекстЗапросаОстатков(РеквизитыДокумента.ВидОперации);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ТекстЗапросаОстатков(ВидОперации)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПереносОстатков.НомерСтроки КАК НомерСтроки,
	|	ПереносОстатков.ОбъектУчета КАК ОбъектУчета,
	|	ПереносОстатков.СчетСтарый КАК СчетСтарый,
	|	ПереносОстатков.СчетНовый КАК СчетНовый,
	|	ПереносОстатков.ЦМО КАК ЦМО,
	|	ПереносОстатков.Контрагент КАК Контрагент,
	|	ПереносОстатков.Договор КАК Договор
	|ПОМЕСТИТЬ Переводы
	|ИЗ
	|	Документ.ПереносОстатков198нНФА.Переводы КАК ПереносОстатков
	|ГДЕ
	|	ПереносОстатков.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.ВалютнаяСуммаОстаток КАК ВалютнаяСумма,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВДОстаток КАК СуммаЕНВД,
	|	Остатки.СуммаНДСОстаток КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА Остатки.Счет В (&Счет)
	|			ТОГДА ""Стоимость""
	|		КОГДА Остатки.Счет В (&СчетАмортизации)
	|			ТОГДА ""Амортизация""
	|		КОГДА Остатки.Счет В (&СчетОбесценения)
	|			ТОГДА ""Обесценение""
	|	КОНЕЦ КАК Операция,
	|	ВЫБОР
	|		КОГДА Остатки.Счет В (&Счет)
	|			ТОГДА 1
	|		КОГДА Остатки.Счет В (&СчетАмортизации)
	|			ТОГДА 2
	|		КОГДА Остатки.Счет В (&СчетОбесценения)
	|			ТОГДА 3
	|	КОНЕЦ КАК ДопПорядок
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет)
	|				ИЛИ Счет В (&СчетАмортизации)
	|				ИЛИ Счет В (&СчетОбесценения),
	|			,
	|			Организация = &Организация
	|				И (Субконто1 В (&СписокОбъектов)
	|					ИЛИ Субконто2 В (&СписокОбъектов))) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаКапВложений.СчетУчета КАК СчетУчета,
	|	СчетаКапВложений.СчетАмортизации КАК СчетАмортизации,
	|	СчетаКапВложений.СчетОбесценения КАК СчетОбесценения
	|ПОМЕСТИТЬ ВТ_СчетаКапВложений
	|ИЗ
	|	&СчетаКапВложений КАК СчетаКапВложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоответствиеСчетовОС.СчетОС КАК СчетУчета,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.СчетОбесценения КАК СчетОбесценения
	|ПОМЕСТИТЬ СоответствиеСчетов
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетаКапВложений.СчетУчета,
	|	СчетаКапВложений.СчетАмортизации,
	|	СчетаКапВложений.СчетОбесценения
	|ИЗ
	|	ВТ_СчетаКапВложений КАК СчетаКапВложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.Сумма КАК Сумма,
	|	Остатки.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Остатки.Количество КАК Количество,
	|	Остатки.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВД КАК СуммаЕНВД,
	|	Остатки.СуммаНДС КАК СуммаНДС,
	|	Остатки.Операция КАК Операция,
	|	ВЫБОР
	|		КОГДА Остатки.Операция = ""Стоимость""
	|			ТОГДА Переводы.СчетНовый
	|		КОГДА Остатки.Операция = ""Амортизация""
	|			ТОГДА СоответствиеСчетов.СчетАмортизации
	|		КОГДА Остатки.Операция = ""Обесценение""
	|			ТОГДА СоответствиеСчетов.СчетОбесценения
	|	КОНЕЦ КАК СчетНовый,
	|	Переводы.ЦМО КАК ЦМО,
	|	Переводы.Контрагент КАК Контрагент,
	|	Переводы.Договор КАК Договор
	|ИЗ
	|	Переводы КАК Переводы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО (Переводы.ОбъектУчета = Остатки.Субконто1
	|				ИЛИ Переводы.ОбъектУчета = Остатки.Субконто2)
	|			И (&ДопСоединение)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	|		ПО Переводы.СчетНовый = СоответствиеСчетов.СчетУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	Переводы.НомерСтроки,
	|	Остатки.ДопПорядок";
	
	ДопСоединение = "";
	Если ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииМЗ
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииМЗИК
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеПоЦСМЗ
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеВПользование
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеВПользованиеИК
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииОС
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.НаХраненииОСИК
		Или ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеПоЦСОС Тогда
		ДопСоединение = "И Переводы.Контрагент = Остатки.Субконто1";
	КонецЕсли;
	Если ВидОперации <> Перечисления.ОперацииПереносОстатков198нНФА.НМА
		И ВидОперации <> Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияНМА
		И ВидОперации <> Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияИК Тогда
		ДопСоединение = ДопСоединение + " И Переводы.СчетСтарый = Остатки.Счет";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И (&ДопСоединение)", ДопСоединение);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаполнитьТаблицуСчетовКапВложений(СчетаКапВложений, ВидОперации, ДатаПерехода)
	
	СписокСчетов = Новый Массив;
	
	Если ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияНМА Тогда
		
		СписокСчетов.Добавить("106.2N-104.2N-114.2N");
		СписокСчетов.Добавить("106.2R-104.2R-114.2R");
		СписокСчетов.Добавить("106.2I-104.2I-114.2I");
		СписокСчетов.Добавить("106.2D-104.2D-114.2D");
		
		СписокСчетов.Добавить("106.3N-104.3N-114.3N");
		СписокСчетов.Добавить("106.3R-104.3R-114.3R");
		СписокСчетов.Добавить("106.3I-104.3I-114.3I");
		СписокСчетов.Добавить("106.3D-104.3D-114.3D");
		
	ИначеЕсли ВидОперации = Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияИК Тогда
		
		СписокСчетов.Добавить("106.51-104.51-");
		СписокСчетов.Добавить("106.52-104.52-");
		СписокСчетов.Добавить("106.54-104.54-");
		//СписокСчетов.Добавить("106.55- - ");	
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого СтрокаСчета Из СписокСчетов Цикл
		
		ЧастиСтроки = СтрРазделить(СтрокаСчета, "-");
		
		НоваяСтрока					= СчетаКапВложений.Добавить();
		НоваяСтрока.СчетУчета		= БухгалтерскийУчет.СчетПоКоду(ЧастиСтроки[0], ДатаПерехода);
		НоваяСтрока.СчетАмортизации	= БухгалтерскийУчет.СчетПоКоду(ЧастиСтроки[1], ДатаПерехода);
		НоваяСтрока.СчетОбесценения	= БухгалтерскийУчет.СчетПоКоду(ЧастиСтроки[2], ДатаПерехода);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
