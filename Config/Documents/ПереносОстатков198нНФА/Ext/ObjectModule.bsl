#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Для Каждого ТаблицаДвижений Из Движения Цикл
		ТаблицаДвижений.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
	КонецЦикла;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Проведен Тогда
		ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	ОперацииВалюты = Новый Массив;
	ОперацииВалюты.Добавить(Перечисления.ОперацииПереносОстатков198нНФА.НМА);
	ОперацииВалюты.Добавить(Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияНМА);
	ОперацииВалюты.Добавить(Перечисления.ОперацииПереносОстатков198нНФА.КапВложенияИК);
	ОперацииВалюты.Добавить(Перечисления.ОперацииПереносОстатков198нНФА.ОбесценениеНПА);
	ОперацииВалюты.Добавить(Перечисления.ОперацииПереносОстатков198нНФА.ПолученноеВПользованиеИК);
	
	Если ОперацииВалюты.Найти(ВидОперации) <> Неопределено Тогда
		ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса;
	Иначе
		ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ТехнологическиеОперации;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	СписокДоговоров = Переводы.ВыгрузитьКолонку("Договор");
	КонтрагентыДоговоров = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокДоговоров, "Контрагент");
	
	ТекстПредупреждения = НСтр("ru='В строке %1 договор не соответствует контрагенту.'");
	
	Для Каждого СтрокаТаблицы Из Переводы Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Договор) И ЗначениеЗаполнено(СтрокаТаблицы.Контрагент)
			И СтрокаТаблицы.Контрагент <> КонтрагентыДоговоров[СтрокаТаблицы.Договор] Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстПредупреждения, СтрокаТаблицы.НомерСтроки),,
				"Объект.Переводы["+(СтрокаТаблицы.НомерСтроки-1)+"].Договор",,Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Переводы.Очистить();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли