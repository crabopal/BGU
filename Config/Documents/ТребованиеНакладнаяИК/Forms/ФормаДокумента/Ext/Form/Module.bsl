&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.ЗаполнятьСчет = ЗаполнятьСчет;
	ПараметрыОбработки.Включать105 = Ложь;
	ПараметрыОбработки.Включать108 = СчетУчета108(Форма);
	ПараметрыОбработки.ВШапке108 = СчетУчета108(Форма);
	ПараметрыОбработки.ДтКт = "Кт";
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчета108(Форма)

	Возврат Форма.Объект.СчетУчета = Форма.КэшПараметров.Локальные.Счет108;

КонецФункции

&НаСервере
Процедура СчетУчетаПриИзмененииНаСервере()
	УстановитьПараметрыУчетаИКПоЦМОиПодразделениям();
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ОбщегоНазначенияБГУ.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме()
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	СчетСсылка108 = БухгалтерскийУчет.СчетПоКоду("108.00", ДатаСчетов, Объект.Организация);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет108", СчетСсылка108);
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать105 = Ложь;
	ПараметрыЗаполненияСчета.Включать108 = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовые = Истина;
	ПараметрыЗаполненияСчета.ТолькоБалансовыеИК = Ложь;
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект, "Материалы", Истина);
	
	// Пустая колонка счет учета
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.Материалы.СчетУчета", ,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = '108.56'"));
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("МатериалыСчетУчета");
	Поле.Использование = Истина;
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ЗаполнитьДанныеСчетовВФорме();
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект, Объект, , Истина, , Истина, Истина);
	УстановитьПараметрыУчетаИКПоЦМОиПодразделениям();

	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтотОбъект);

КонецПроцедуры

