Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	Параметры.Вставить("НеПроверятьЗаполнение", Истина);
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	НеПересчитыватьСумму = Не Справочники.Организации.ПолучитьУчетнуюПолитику(Документ.Организация, Документ.Дата)
		.ВедениеАналитическогоУчетаИмуществаКазны;
	ИмяСписка = "Материалы";
	СинонимСписка = Документ.Метаданные().ТабличныеЧасти.Материалы.Синоним;
	
	Для Каждого СтрокаДокумента Из Документ.Материалы Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ИмяСписка = ИмяСписка;
		НоваяСтрока.СинонимСписка = СинонимСписка;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
			"НомерСтроки, КПС, КЭК, СчетУчета, Номенклатура, Количество");
		НоваяСтрока.КФО = Документ.КФО;
		НоваяСтрока.ДопАналитика = СтрокаДокумента.ДополнительнаяАналитикаСчета;
		НоваяСтрока.ДопИзмерение = Документ.ЦМО;
		НоваяСтрока.ДопИзмерениеПолучатель = Документ.ЦМОПолучатель;
		НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		НоваяСтрока.ИФО = Документ.ИФО;
		НоваяСтрока.НеПересчитыватьСумму = НеПересчитыватьСумму;
		НоваяСтрока.СуммаСписания = СтрокаДокумента.Сумма;
		НоваяСтрока.Подразделение = Документ.Подразделение;
		НоваяСтрока.ПодразделениеПолучатель = Документ.ПодразделениеПолучатель;
	КонецЦикла;
	
	Возврат ТаблицаДокумента;

КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать105 - Булево - счета 105 не учитываются, при заполнении
//   * Включать108 - Булево - счета 108 учитываются
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Кт");
	Результат.Вставить("Включать105", Ложь);
	Результат.Вставить("Включать108", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", НСтр("ru = 'Требование - накладная'"));
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка, ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Организация,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ВидДрагМатериала,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ЕдИзм,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.ТребованиеНакладнаяИК.ДрагоценныеМатериалы КАК ТребованиеНакладнаяИКДрагоценныеМатериалы
	 |ГДЕ
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ТребованиеНакладнаяИКДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	 "ВЫБРАТЬ
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ЧистаяМасса КАК ЧистаяМасса,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	 |ИЗ
	 |	Документ.ТребованиеНакладнаяИК.ДрагоценныеМатериалы КАК ТребованиеНакладнаяИКДрагоценныеМатериалы
	 |ГДЕ
	 |	ТребованиеНакладнаяИКДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ТребованиеНакладнаяИКДрагоценныеМатериалы.МассаДМ = 0
	 |	И ТребованиеНакладнаяИКДрагоценныеМатериалы.ЛигатурнаяМасса + ТребованиеНакладнаяИКДрагоценныеМатериалы.ЧистаяМасса > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
КонецПроцедуры	

