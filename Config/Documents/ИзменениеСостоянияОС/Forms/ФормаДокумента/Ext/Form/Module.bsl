#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьМестонахождениеОС()
	
	ЗаблокироватьДанныеФормыДляРедактирования();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МестонахождениеОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	               |	МестонахождениеОССрезПоследних.ЦМО,
	               |	МестонахождениеОССрезПоследних.Подразделение,
	               |	МестонахождениеОССрезПоследних.Состояние,
	               |	МестонахождениеОССрезПоследних.НазваниеДокумента,
	               |	МестонахождениеОССрезПоследних.НомерДокумента,
	               |	МестонахождениеОССрезПоследних.Период КАК ДатаСостояния,
	               |	МестонахождениеОССрезПоследних.ДатаДокумента
	               |ИЗ
	               |	РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ОсновноеСредство = &ОсновноеСредство) КАК МестонахождениеОССрезПоследних";

	Период = Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая);
	
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", Объект.ОсновноеСредство);
	
	Объект.ОсновныеСредства.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

