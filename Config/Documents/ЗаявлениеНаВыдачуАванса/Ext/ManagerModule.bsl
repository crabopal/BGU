#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СписокСсылокСГруппировкой(МассивСсылок) Экспорт
	
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Организация",	Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаСсылок.Колонки.Добавить("Валюта", 		Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаСсылок.Колонки.Добавить("Ключ");
	ТаблицаСсылок.Колонки.Добавить("МассивСсылок", 	Новый ОписаниеТипов("Массив"));
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАванса.Организация КАК Организация,
	|	ЗаявлениеНаВыдачуАванса.ВалютаДокумента КАК ВалютаДокумента,
	|	ЗаявлениеНаВыдачуАванса.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.СуммаДокумента = 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Рублевый,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.ВалютаДокумента = &ВалютаРуб
	|				ИЛИ ЗаявлениеНаВыдачуАванса.ВалютаДокумента ЕСТЬ NULL
	|				ИЛИ ЗаявлениеНаВыдачуАванса.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Валютный,
	|	ЗаявлениеНаВыдачуАванса.Организация.Представление КАК ОрганизацияПредставление,
	|	ЗаявлениеНаВыдачуАванса.ВалютаДокумента.Представление КАК ВалютаПредставление
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса КАК ЗаявлениеНаВыдачуАванса
	|ГДЕ
	|	ЗаявлениеНаВыдачуАванса.Ссылка В(&МассивСсылок)");
	
	Руб = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("ВалютаРуб", Руб);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Рублевый Тогда
			
			Строки = ТаблицаСсылок.НайтиСтроки(Новый Структура("Организация, Валюта", Выборка.Организация, Руб));
			Если Строки.Количество() = 0 Тогда
				Стр 			= ТаблицаСсылок.Добавить();
				Стр.Организация = Выборка.Организация;
				Стр.Валюта 		= Руб;
				Стр.Ключ 		= Выборка.ОрганизацияПредставление + "РУБ";
			Иначе
				Стр 			= Строки[0];
			КонецЕсли;
			
			Стр.МассивСсылок.Добавить(Выборка.Ссылка); 
		КонецЕсли;
		
		Если Выборка.Валютный Тогда
			
			Строки = ТаблицаСсылок.НайтиСтроки(Новый Структура("Организация, Валюта", Выборка.Организация, Выборка.ВалютаДокумента));
			Если Строки.Количество() = 0 Тогда
				Стр 			= ТаблицаСсылок.Добавить();
				Стр.Организация = Выборка.Организация;
				Стр.Валюта 		= Выборка.ВалютаДокумента;
				Стр.Ключ 		= Выборка.ОрганизацияПредставление + Выборка.ВалютаПредставление;
			Иначе
				Стр 			= Строки[0];
			КонецЕсли;
			
			Стр.МассивСсылок.Добавить(Выборка.Ссылка); 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСсылок;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ПЕЧАТИ

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявлениеНаВыдачуАванса";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ЗаявлениеНаВыдачуАванса";
	КомандаПечати.Представление		= НСтр("ru = 'Заявление на выдачу аванса'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеНаВыдачуАванса") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеНаВыдачуАванса", "Заявление на выдачу аванса", ПечатьЗаявления(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьЗаявления(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗаявлениеНаВыдачуАванса";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявлениеНаВыдачуАванса.ПФ_MXL_ЗаявлениеНаВыдачуАванса");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Константы.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	|ПОМЕСТИТЬ ВАЛЮТЫ
	|ИЗ
	|	Константы КАК Константы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАванса.Ссылка,
	|	ЗаявлениеНаВыдачуАванса.ВерсияДанных,
	|	ЗаявлениеНаВыдачуАванса.ПометкаУдаления,
	|	ЗаявлениеНаВыдачуАванса.Номер,
	|	ЗаявлениеНаВыдачуАванса.Дата,
	|	ЗаявлениеНаВыдачуАванса.Проведен,
	|	ЗаявлениеНаВыдачуАванса.Организация,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.Организация.НаименованиеПолное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ЗаявлениеНаВыдачуАванса.Организация.НаименованиеСокращенное = """"
	|						ТОГДА ЗаявлениеНаВыдачуАванса.Организация.Наименование
	|					ИНАЧЕ ЗаявлениеНаВыдачуАванса.Организация.НаименованиеСокращенное
	|				КОНЕЦ
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ЗаявлениеНаВыдачуАванса.Подразделение,
	|	ЗаявлениеНаВыдачуАванса.Подразделение.Наименование КАК СтруктурноеПодразделение,
	|	ЗаявлениеНаВыдачуАванса.Сотрудник,
	|	ЗаявлениеНаВыдачуАванса.ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.ВалютаДокумента В
	|					(ВЫБРАТЬ
	|						ВАЛЮТЫ.ВалютаРегламентированногоУчета
	|					ИЗ
	|						ВАЛЮТЫ)
	|				ИЛИ ЗаявлениеНаВыдачуАванса.ВалютаДокумента ЕСТЬ NULL 
	|			ТОГДА """"
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.ВалютаДокумента.НаименованиеПолное
	|	КОНЕЦ КАК ИнВалюта,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.ВалютаДокумента В
	|					(ВЫБРАТЬ
	|						ВАЛЮТЫ.ВалютаРегламентированногоУчета
	|					ИЗ
	|						ВАЛЮТЫ)
	|				ИЛИ ЗаявлениеНаВыдачуАванса.ВалютаДокумента ЕСТЬ NULL 
	|			ТОГДА 0
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.СуммаДокументаВВалюте
	|	КОНЕЦ КАК СуммаДокументаВВалюте,
	|	ЗаявлениеНаВыдачуАванса.СуммаДокумента,
	|	ЗаявлениеНаВыдачуАванса.СрокАванса,
	|	ЗаявлениеНаВыдачуАванса.НазначениеАванса,
	|	ЗаявлениеНаВыдачуАванса.Задолженность,
	|	ЗаявлениеНаВыдачуАванса.Руководитель,
	|	ЗаявлениеНаВыдачуАванса.Бухгалтер,
	|	ЗаявлениеНаВыдачуАванса.Комментарий,
	|	ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.(
	|		Ссылка,
	|		НомерСтроки,
	|		КомуЗаЧто КАК ТекстовоеПояснение,
	|		КФО,
	|		КПС,
	|		КЭК,
	|		Сумма,
	|		СуммаВВалюте
	|	)
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса КАК ЗаявлениеНаВыдачуАванса
	|ГДЕ
	|	ЗаявлениеНаВыдачуАванса.Ссылка В(&МассивОбъектов)");
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	ПервыйДокумент = Истина;

	Пока Выборка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;

		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.Сотрудник, СтруктураДанных.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("СотрудникФамилия", 			ДанныеСотрудника.Фамилия);
		СтруктураДанных.Вставить("СотрудникИмя", 				ДанныеСотрудника.Имя);
		СтруктураДанных.Вставить("СотрудникОтчество", 			ДанныеСотрудника.Отчество);
		СтруктураДанных.Вставить("СотрудникДолжность", 			ДанныеСотрудника.Должность);
		СтруктураДанных.Вставить("СотрудникИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));

		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.Руководитель, СтруктураДанных.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РуководительФамилия", 		ДанныеСотрудника.Фамилия);
		СтруктураДанных.Вставить("РуководительИмя", 			ДанныеСотрудника.Имя);
		СтруктураДанных.Вставить("РуководительОтчество", 		ДанныеСотрудника.Отчество);
		СтруктураДанных.Вставить("РуководительДолжность", 		ДанныеСотрудника.Должность);
		СтруктураДанных.Вставить("РуководительИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Бухгалтер, СтруктураДанных.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("БухгалтерИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		СтруктураДанных.Вставить("СуммаДокументаПрописью",
			ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтруктураДанных.СуммаДокумента,));
		
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		Если НЕ СтруктураДанных.РасчетРазмераАванса.Пустой() Тогда
			
			СтрокиРасчета = СтруктураДанных.РасчетРазмераАванса.Выбрать();
			
			ОбластьЗаголовокРасчета = Макет.ПолучитьОбласть("ЗаголовокРасчета");
			ОбластьЗаголовокРасчета.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьЗаголовокРасчета);
			
			Пока СтрокиРасчета.Следующий() Цикл
				
				ОбластьСтрокаРасчета = Макет.ПолучитьОбласть("СтрокаРасчета");
				ОбластьСтрокаРасчета.Параметры.Заполнить(СтрокиРасчета);
				
				ТабличныйДокумент.Вывести(ОбластьСтрокаРасчета);
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьПодвал.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
