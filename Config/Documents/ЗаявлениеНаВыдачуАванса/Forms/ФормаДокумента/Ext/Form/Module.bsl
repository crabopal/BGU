		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.РасчетРазмераАванса.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		ТекущиеДанные.Сумма = Объект.СуммаДокумента - (Объект.РасчетРазмераАванса.Итог("Сумма") - ТекущиеДанные.Сумма);
	КонецЕсли;
	
