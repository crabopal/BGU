Процедура РасчетРазмераАвансаКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасчетРазмераАванса.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПС, 
													Объект.Организация,
													Объект.ИФО,
													ТекущиеДанные.КФО,
													,
													Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура РасчетРазмераАвансаСуммаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.РасчетРазмераАванса.ТекущиеДанные.Сумма) Тогда
		Если ЗначениеЗаполнено(Элементы.РасчетРазмераАванса.ТекущиеДанные.СуммаВВалюте) Тогда
			Элементы.РасчетРазмераАванса.ТекущиеДанные.СуммаВВалюте = 0;
		КонецЕсли;
	КонецЕсли;
	
	ПриИзмененииСуммы();

КонецПроцедуры

