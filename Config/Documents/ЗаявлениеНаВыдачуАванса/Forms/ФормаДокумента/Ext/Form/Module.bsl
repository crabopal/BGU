&НаСервереБезКонтекста
Функция ПодразделениеСотрудника(ОбъектСотрудник, ОбъектДата)
	
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Подразделение", ОбъектСотрудник, ОбъектДата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
	Возврат ДанныеСотрудника.Подразделение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗадолженностьСотрудникаНаДату(Знач Организация, Знач Сотрудник, Знач Дата)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
	|ПОМЕСТИТЬ СчетаУчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Счет208)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Дата,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаУчета.СчетЕПСБУ
	|				ИЗ
	|					СчетаУчета КАК СчетаУчета),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
	|			Организация = &Организация
	|				И Субконто1 = &Контрагент) КАК ЖурналПроводокЕПСБУОстатки");
	
	ПараметрыГраницы = Новый Массив(2);
	ПараметрыГраницы[0] = Дата;
	ПараметрыГраницы[1] = ВидГраницы.Включая;
	Граница = Новый(Тип("Граница"), ПараметрыГраницы);
	
	Запрос.УстановитьПараметр("Дата", Граница);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Контрагент"));
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.СуммаОстаток;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

