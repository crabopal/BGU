&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ОрганизацияЗаполнена = ЗначениеЗаполнено(Объект.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЦМО",
		"Доступность", ЗначениеЗаполнено(Объект.Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Подразделение",
		"Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуСтроки(ИднСтроки)
	ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ИднСтроки);
	Если НЕ ЗначениеЗаполнено(ТекСтр.ДенежныйДокумент) ИЛИ ТекСтр.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	Цена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.ДенежныйДокумент,"НомСтоимость");
	ТекСтр.Сумма = ТекСтр.Количество * Цена;
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	
	ТаблицаДанных = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДанныхВХранилище);
		
	Объект.Материалы.Очистить();
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
			
	КонецЦикла;

КонецПроцедуры

