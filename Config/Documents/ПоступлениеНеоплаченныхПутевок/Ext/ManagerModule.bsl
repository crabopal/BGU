#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеНеоплаченныхПутевок";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный ордер (ф.0504207) (ред. 103н)'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеНеоплаченныхПутевок";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_52н";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный ордер (ф.0504207) (ред. 52н)'");
	КомандаПечати.Порядок			= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеНеоплаченныхПутевок";
	КомандаПечати.Идентификатор		= "ПриходныйОрдерМ4";
	КомандаПечати.Представление		= НСтр("ru = '(устарела) Приходный ордер (М-4)'");
	КомандаПечати.Порядок			= 99;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_103н",
			"Приходный ордер (ф.0504207) ред. 103н",
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_52н",
			"Приходный ордер (ф.0504207) ред. 52н",
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207"));
	КонецЕсли;
			
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдерМ4") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПриходныйОрдерМ4",
			"Поступление МЗ",
			ПечатьМ4(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует табличный документ Приходный ордер (ф.0504207)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0504207(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПоступлениеНеоплаченныхПутевок) КАК Ссылка,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт) КАК СчетДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт) КАК КПСДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт) КАК КПСКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт) КАК СчетКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт) КАК КЭКДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт) КАК КЭККт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КФО) КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК ВидДенежногоДокументаСсылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК ДенежныйДокументСсылка
	|ПОМЕСТИТЬ СчетаДтКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И (ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов)
	|					И ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы))
	|				И СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПоступлениеНеоплаченныхПутевок),
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	ВидДенежногоДокументаСсылка,
	|	ДенежныйДокументСсылка";
	
	Запрос.Выполнить();
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеНеоплаченныхПутевок.Ссылка КАК Ссылка,
	|	ПоступлениеНеоплаченныхПутевок.Номер КАК Номер,
	|	ПоступлениеНеоплаченныхПутевок.Дата КАК Дата,
	|	ПоступлениеНеоплаченныхПутевок.ВидПервичногоДокумента,
	|	ПоступлениеНеоплаченныхПутевок.ДатаПервичногоДокумента,
	|	ПоступлениеНеоплаченныхПутевок.НомерПервичногоДокумента,
	|	"""" КАК КодАналитики,
	|	ПоступлениеНеоплаченныхПутевок.Организация,
	|	ВЫБОР
	|		КОГДА ПоступлениеНеоплаченныхПутевок.Организация.НаименованиеПолное = """"
	|			ТОГДА ПоступлениеНеоплаченныхПутевок.Организация.Наименование
	|		ИНАЧЕ ПоступлениеНеоплаченныхПутевок.Организация.НаименованиеПолное
	|	КОНЕЦ КАК Получатель,
	|	ПоступлениеНеоплаченныхПутевок.Организация.КодОКПО КАК ОКПОПолучатель,
	|	ПоступлениеНеоплаченныхПутевок.Подразделение,
	|	ВЫБОР
	|		КОГДА ПоступлениеНеоплаченныхПутевок.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПоступлениеНеоплаченныхПутевок.Подразделение)
	|		ИНАЧЕ ПоступлениеНеоплаченныхПутевок.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК ПодразделениеПолучатель,
	|	ПоступлениеНеоплаченныхПутевок.Грузоотправитель КАК Контрагент,
	|	ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	|	ВЫБОР
	|		КОГДА ПоступлениеНеоплаченныхПутевок.Грузоотправитель.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ПоступлениеНеоплаченныхПутевок.Грузоотправитель)
	|				КОНЕЦ
	|		ИНАЧЕ ПоступлениеНеоплаченныхПутевок.Грузоотправитель.НаименованиеСокращенное
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ЮридическоеФизическоеЛицо.КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОКПОПоставщик,
	|	ПоступлениеНеоплаченныхПутевок.Грузоотправитель.ИНН КАК ИННПоставщик,
	|	ПоступлениеНеоплаченныхПутевок.Грузоотправитель.КПП КАК КПППоставщик,
	|	"""" КАК Договор,
	|	ПоступлениеНеоплаченныхПутевок.ЦМО.Сотрудник КАК Принял,
	|	"""" КАК Сдал,
	|	&ВалютаДокумента КАК ВалютаДокумента,
	|	ПоступлениеНеоплаченныхПутевок.ОтветственныйИсполнитель,
	|	ПоступлениеНеоплаченныхПутевок.ОтветственныйИсполнительБух
	|ИЗ
	|	Документ.ПоступлениеНеоплаченныхПутевок КАК ПоступлениеНеоплаченныхПутевок
	|ГДЕ
	|	ПоступлениеНеоплаченныхПутевок.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеНеоплаченныхПутевокМатериалы.Ссылка КАК Ссылка,
	|	1 КАК Порядок,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Наименование + "" ("" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Серия + "" "" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Номер + "")"" КАК Номенклатура,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Наименование + "" ("" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Серия + "" "" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Номер + "")"" КАК НоменклатураНаименование,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Наименование + "" ("" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Серия + "" "" + ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.Номер + "")"" КАК НоменклатураНаименованиеПолное,
	|	"""" КАК НомерНоменклатурный,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.Сумма КАК Всего,
	|	0 КАК СуммаНДС,
	|	0 КАК СтавкаНДС,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.Сумма КАК Сумма,
	|	ПоступлениеНеоплаченныхПутевокМатериалы.Количество,
	|	ВЫРАЗИТЬ(ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент КАК Справочник.ДенежныеДокументы).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СчетаДтКт.СчетДт,
	|	ЕСТЬNULL(СчетаДтКт.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСДт,
	|	СчетаДтКт.КПСКт,
	|	СчетаДтКт.СчетКт,
	|	СчетаДтКт.КЭКДт,
	|	СчетаДтКт.КЭККт,
	|	СчетаДтКт.КФО,
	|	ВЫРАЗИТЬ(ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдиницаНаименование,
	|	ВЫРАЗИТЬ(ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК ЕдиницаКод
	|ИЗ
	|	Документ.ПоступлениеНеоплаченныхПутевок.Материалы КАК ПоступлениеНеоплаченныхПутевокМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаДтКт КАК СчетаДтКт
	|		ПО ПоступлениеНеоплаченныхПутевокМатериалы.Ссылка = СчетаДтКт.Ссылка
	|			И ПоступлениеНеоплаченныхПутевокМатериалы.ВидДенежногоДокумента = СчетаДтКт.ВидДенежногоДокументаСсылка
	|			И ПоступлениеНеоплаченныхПутевокМатериалы.ДенежныйДокумент = СчетаДтКт.ДенежныйДокументСсылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ПоступлениеНеоплаченныхПутевокМатериалы.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	ПоступлениеНеоплаченныхПутевокМатериалы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Порядок,
	|	НомерСтроки";
	
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	Запрос.УстановитьПараметр("ВалютаДокумента", ВалютаДокумента);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат УправлениеПечатьюБГУ.ПечатьПриходногоОрдера_0504207(РезультатЗапроса, ОбъектыПечати, , ИмяМакета);
	
КонецФункции

// Функция формирует табличный документ Приходный ордер (ф.М-4)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьМ4(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_ПРИХОДНЫЙОРДЕР_М4";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеПутевокМатериалы.Ссылка,
	               |	1 КАК Порядок,
	               |	ПоступлениеПутевокМатериалы.НомерСтроки,
	               |	ПоступлениеПутевокМатериалы.ДенежныйДокумент КАК Номенклатура,
	               |	ПоступлениеПутевокМатериалы.ДенежныйДокумент.Наименование + "" ("" + ПоступлениеПутевокМатериалы.ДенежныйДокумент.Серия + "" "" + ПоступлениеПутевокМатериалы.ДенежныйДокумент.Номер + "")"" КАК пНоменклатура,
	               |	"" "" КАК НоменклатурныйНомер,
	               |	ПоступлениеПутевокМатериалы.ДенежныйДокумент.Наименование КАК пНоменклатура2,
	               |	ПоступлениеПутевокМатериалы.Сумма,
	               |	ПоступлениеПутевокМатериалы.Количество,
	               |	ПоступлениеПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ПОМЕСТИТЬ СоставыДокументов
	               |ИЗ
	               |	Документ.ПоступлениеНеоплаченныхПутевок.Материалы КАК ПоступлениеПутевокМатериалы
	               |ГДЕ
	               |	ПоступлениеПутевокМатериалы.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеПутевок.Ссылка КАК Ссылка,
	               |	ПоступлениеПутевок.Номер КАК Номер,
	               |	ПоступлениеПутевок.Дата КАК Дата,
	               |	ПоступлениеПутевок.ВидПервичногоДокумента,
	               |	ПоступлениеПутевок.ДатаПервичногоДокумента,
	               |	ПоступлениеПутевок.НомерПервичногоДокумента,
	               |	"""" КАК КодАналитики,
	               |	ПоступлениеПутевок.Организация,
	               |	ПоступлениеПутевок.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ПоступлениеПутевок.Организация.КодОКПО КАК КодОКПО,
	               |	ПоступлениеПутевок.ЦМО.Сотрудник КАК СотрудникСсылка,
	               |	ПоступлениеПутевок.ЦМО.МестоХранения КАК МестоХраненияСсылка,
	               |	ПоступлениеПутевок.ЦМО.МестоХранения.Представление КАК МестоХранения,
	               |	ПоступлениеПутевок.Грузоотправитель.Код КАК КодПоставщика,
	               |	ПоступлениеПутевок.Грузоотправитель КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.пНоменклатура = СоставыДокументов.пНоменклатура2 + "" ( )""
	               |			ТОГДА СоставыДокументов.пНоменклатура2
	               |		ИНАЧЕ СоставыДокументов.пНоменклатура
	               |	КОНЕЦ КАК Номенклатура,
	               |	СоставыДокументов.НоменклатурныйНомер,
	               |	СоставыДокументов.Сумма КАК Сумма,
	               |	СоставыДокументов.Сумма КАК Всего,
	               |	0 КАК НДС,
	               |	СоставыДокументов.Количество КАК Количество,
	               |	СоставыДокументов.ЕдиницаИзмерения.Код КАК КодЕдИзм,
	               |	СоставыДокументов.ЕдиницаИзмерения.Представление КАК ЕдИзм,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.Количество <> 0
	               |			ТОГДА СоставыДокументов.Сумма / СоставыДокументов.Количество
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Цена,
	               |	СоставыДокументов.Порядок КАК Порядок,
	               |	ПоступлениеПутевок.КФО КАК КФО
	               |ИЗ
	               |	Документ.ПоступлениеНеоплаченныхПутевок КАК ПоступлениеПутевок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СоставыДокументов КАК СоставыДокументов
	               |		ПО ПоступлениеПутевок.Ссылка = СоставыДокументов.Ссылка
	               |ГДЕ
	               |	ПоступлениеПутевок.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	Номер,
	               |	Порядок,
	               |	СоставыДокументов.НомерСтроки
	               |ИТОГИ
	               |	СУММА(Сумма),
	               |	СУММА(Количество)
	               |ПО
	               |	Ссылка";
				   
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ПриходныйОрдерМ4");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		СтруктураОбластьШапка = Новый Структура("НомерСопроводительногоДокумента,Номер,Поставщик");
		СтруктураОбластьШапка.НомерСопроводительногоДокумента 	= ВыборкаШапка.ВидПервичногоДокумента 
																+ ?(ПустаяСтрока(ВыборкаШапка.НомерПервичногоДокумента), "", " №"+ВыборкаШапка.НомерПервичногоДокумента)
																+ ?(ЗначениеЗаполнено(ВыборкаШапка.ДатаПервичногоДокумента), " от "+Формат(ВыборкаШапка.ДатаПервичногоДокумента,"ДЛФ=D"), "");
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное", ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		СтруктураОбластьШапка.Поставщик	= ДанныеКонтрагента.НаименованиеПолное;
		СтруктураОбластьШапка.Номер 	= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер);
		//СтруктураОбластьШапка.КорСчет	= БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(ВыборкаШапка.КорСчет,,ВыборкаШапка.КФО);
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
		
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтроки);
			Если НЕ ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		КонецЦикла;
		СтруктураОбластьИтог = Новый Структура("КоличествоИтог,СуммаИтог,НДСИтог,ВсегоИтог");

		СтруктураОбластьИтог.КоличествоИтог	= ВыборкаШапка.Количество;
		СтруктураОбластьИтог.СуммаИтог		= ВыборкаШапка.Сумма;
		СтруктураОбластьИтог.ВсегоИтог		= ВыборкаШапка.Сумма;
		СтруктураОбластьИтог.НДСИтог		= 0;
		ОбластьИтог.Параметры.Заполнить(СтруктураОбластьИтог);
		ТабличныйДокумент.Вывести(ОбластьИтог);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
											ВыборкаШапка.СотрудникСсылка, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьПодвал = Новый Структура("ДолжностьМОЛ,ФИОМол");
		СтруктураОбластьПодвал.ДолжностьМОЛ	= ДанныеСотрудника.Должность;
		СтруктураОбластьПодвал.ФИОМол		= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
													   НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
		
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
