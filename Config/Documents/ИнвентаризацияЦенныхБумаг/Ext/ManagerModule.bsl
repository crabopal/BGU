	|	ИнвентаризацияСоставКомиссии.Ссылка В(&МассивОбъектов)
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивСсылок);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаШапка = МассивРезультатов[0].Выбрать();
	ВыборкаТЧ1 = МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаТЧ2 = МассивРезультатов[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия = МассивРезультатов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиМОЛ"]);
		ОбластьЗаголовок.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		// Сведения о МОЛ
		МОЛ = ВыборкаШапка["МОЛ"];
		МОЛДолжность = "";
		МОЛФИО = "";
		Если ЗначениеЗаполнено(МОЛ) Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность",
				МОЛ, ВыборкаШапка["ДатаИнвентаризации"]);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			МОЛДолжность = ТребуемыеДанные.Должность;
			МОЛФИО = Корреспонденты.ФИОПоОбъекту(МОЛ, Истина);
		КонецЕсли;
		
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("МОЛДолжность", МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛФИО", МОЛФИО);
		
		ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьЗаключениеКомиссии = СформироватьЗаключениеКомиссии(ВыборкаШапка.ЗаключениеКомиссии, Макет);
		ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("Ссылка", ВыборкаШапка["Ссылка"]);
		
		ВыборкаКомиссия.Сбросить();
		ВыборкаТЧ1.Сбросить();
		ВыборкаТЧ2.Сбросить();
		
		ВыборкаКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		ВыборкаТЧ1.НайтиСледующий(ПоискТекущегоДокумента);
		ВыборкаТЧ2.НайтиСледующий(ПоискТекущегоДокумента);
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка, ВыборкаКомиссия.Выбрать(), ОбластьКомиссия, 3);
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиКомиссии"]);
		ОбластьДатаПодписиКомиссии.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		ТабДокумент.Вывести(ОбластьДатаПодписиКомиссии);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабДокумент.Вывести(ОбластьШапка1);
		
		ВыборкаТЧ1Детальная = ВыборкаТЧ1.Выбрать();
		Пока ВыборкаТЧ1Детальная.Следующий() Цикл
			
			ОбластьСтрока1.Параметры.Заполнить(ВыборкаТЧ1Детальная);
			
			МассивВыводимыхОбластей = Новый Массив;
			МассивВыводимыхОбластей.Добавить(ОбластьСтрока1);
			Если ВыборкаТЧ1Детальная.НомерСтроки = ВыборкаТЧ1Детальная.Количество() Тогда
				МассивВыводимыхОбластей.Добавить(ОбластьИтог1);
			КонецЕсли;
			
			Если НЕ ТабДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабДокумент.Вывести(ОбластьШапка1);
			КонецЕсли;
			
			ТабДокумент.Вывести(ОбластьСтрока1);
			
		КонецЦикла;
		
		ОбластьИтог1.Параметры.Заполнить(ВыборкаТЧ1);
		ТабДокумент.Вывести(ОбластьИтог1);
		
		ТабДокумент.Вывести(ОбластьОбъяснениеПричинРасхождений(ВыборкаШапка.ОбъяснениеПричинРасхождений, Макет));
		
		ТабДокумент.Вывести(ОбластьОбъяснениеПодвал);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабДокумент.Вывести(ОбластьШапка2);
		
		ВыборкаТЧ2Детальная = ВыборкаТЧ2.Выбрать();
		Пока ВыборкаТЧ2Детальная.Следующий() Цикл
			
			ОбластьСтрока2.Параметры.Заполнить(ВыборкаТЧ2Детальная);
			
			МассивВыводимыхОбластей = Новый Массив;
			МассивВыводимыхОбластей.Добавить(ОбластьСтрока2);
			Если ВыборкаТЧ2Детальная.НомерСтроки = ВыборкаТЧ2Детальная.Количество() Тогда
				МассивВыводимыхОбластей.Добавить(ОбластьИтог2);
			КонецЕсли;
			
			Если НЕ ТабДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабДокумент.Вывести(ОбластьШапка2);
			КонецЕсли;
			
			ТабДокумент.Вывести(ОбластьСтрока2);
			
		КонецЦикла;
		
		ОбластьИтог2.Параметры.Заполнить(ВыборкаТЧ2);
		ТабДокумент.Вывести(ОбластьИтог2);
		
	КонецЦикла;
	
	// Колонтитулы:
	ТабДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа = НСтр("ru='Форма 0504081 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

Функция СформироватьЗаключениеКомиссии(Текст, Макет)
	
	БлокиСтрок = Неопределено;
	
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, 160, "ЗаключениеКомиссииСтрока1");
	
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , 190, "ЗаключениеКомиссииСтрока2");
	
	МинимальноеКоличествоСтрок = 3;
	
	Возврат ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок);
	
КонецФункции

Функция ОбластьОбъяснениеПричинРасхождений(Текст, Макет)
	
	БлокиСтрок = Новый Массив;
	
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , 190, "ОбъяснениеСтрока");
	
	МинимальноеКоличествоСтрок = 3;
	
	Возврат ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок);
	
КонецФункции

