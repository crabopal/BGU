&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеВсехСтрокТаблицыЦенныеБумаги(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ЦенныеБумаги Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыЦенныеБумаги(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыЦенныеБумаги(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокНаДатуИнвентаризации = НСтр("ru = 'на дату инвентаризации:'");
	ТекущаяСтрока.ЗаголовокНаДатуВалютирования = НСтр("ru = 'на дату валютирования:'");
	
	ТекущаяСтрока.ЗаголовокКоличество = НСтр("ru = 'количество:'");
	ТекущаяСтрока.ЗаголовокВВалюте = НСтр("ru = 'в валюте:'");
	ТекущаяСтрока.ЗаголовокВРублях = НСтр("ru = 'в рублях:'");
	
	ТекущаяСтрока.ЗаголовокПустой = НСтр("ru = 'Х'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьНедостачиИзлишки(Строка)
	
	Если Строка.КоличествоФакт > Строка.КоличествоУчет Тогда
		Строка.КоличествоИзлишки = Строка.КоличествоФакт - Строка.КоличествоУчет;
		Строка.КоличествоНедостача = 0;
	ИначеЕсли Строка.КоличествоФакт < Строка.КоличествоУчет Тогда
		Строка.КоличествоИзлишки = 0;
		Строка.КоличествоНедостача = Строка.КоличествоУчет - Строка.КоличествоФакт;
	Иначе
		Строка.КоличествоИзлишки = 0;
		Строка.КоличествоНедостача = 0;
	КонецЕсли;
	
	Если Строка.НоминальнаяСтоимостьФакт > Строка.НоминальнаяСтоимостьУчет Тогда
		Строка.НоминальнаяСтоимостьИзлишки = Строка.НоминальнаяСтоимостьФакт - Строка.НоминальнаяСтоимостьУчет;
		Строка.НоминальнаяСтоимостьНедостача = 0;
	ИначеЕсли Строка.НоминальнаяСтоимостьФакт < Строка.НоминальнаяСтоимостьУчет Тогда
		Строка.НоминальнаяСтоимостьИзлишки = 0;
		Строка.НоминальнаяСтоимостьНедостача = Строка.НоминальнаяСтоимостьУчет - Строка.НоминальнаяСтоимостьФакт;
	Иначе
		Строка.НоминальнаяСтоимостьИзлишки = 0;
		Строка.НоминальнаяСтоимостьНедостача = 0;
	КонецЕсли;
	
	Если Строка.НоминальнаяСтоимостьВалютнаяФакт > Строка.НоминальнаяСтоимостьВалютнаяУчет Тогда
		Строка.НоминальнаяСтоимостьВалютнаяИзлишки = Строка.НоминальнаяСтоимостьВалютнаяФакт - Строка.НоминальнаяСтоимостьВалютнаяУчет;
		Строка.НоминальнаяСтоимостьВалютнаяНедостача = 0;
	ИначеЕсли Строка.НоминальнаяСтоимостьВалютнаяФакт < Строка.НоминальнаяСтоимостьВалютнаяУчет Тогда
		Строка.НоминальнаяСтоимостьВалютнаяИзлишки = 0;
		Строка.НоминальнаяСтоимостьВалютнаяНедостача = Строка.НоминальнаяСтоимостьВалютнаяУчет - Строка.НоминальнаяСтоимостьВалютнаяФакт;
	Иначе
		Строка.НоминальнаяСтоимостьВалютнаяИзлишки = 0;
		Строка.НоминальнаяСтоимостьВалютнаяНедостача = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	ЕстьДанные = (Объект["ЦенныеБумаги"].Количество() > 0);
	Если ЕстьДанные Тогда
		
		ТекстВопроса = НСтр("ru='При изменении периода рекомендуется очистить табличную часть.
			|
			|Продолжить и очистить табличную часть?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПериода_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Очищаем таблицы:
		Объект["Задолженность"].Очистить();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле Организация не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	//Если НЕ ЗначениеЗаполнено(Объект.МОЛ) Тогда
	//	Результат = Ложь;
	//	ТекстСообщения = НСтр("ru='Поле ""Ответственное лицо"" не заполнено'");
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
	//		Объект.Ссылка,
	//		"Объект.МОЛ");
	//КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЦенныеБумагиЦеннаяБумагаПриИзмененииНаСервере(Строка,Знач ДатаКурса)
	
	ВалютаЦеннойБумагиИКурс = ВалютаЦеннойБумагиИКурс(Строка.ЦеннаяБумага, ДатаКурса);
	
	Строка.Валюта = ВалютаЦеннойБумагиИКурс.Валюта;
	
	Строка.Курс = ВалютаЦеннойБумагиИКурс.Курс;
	Строка.Кратность = ВалютаЦеннойБумагиИКурс.Кратность;
	Строка.КурсНаДатуВалютирования = ВалютаЦеннойБумагиИКурс.Курс;
	Строка.КратностьНаДатуВалютирования = ВалютаЦеннойБумагиИКурс.Кратность;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВалютаЦеннойБумагиИКурс(ЦеннаяБумага, ДатаКурса)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Валюта", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦеннаяБумага, "Валюта"));
	
	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Результат.Валюта, ДатаКурса);
	
	Результат.Вставить("Курс", КурсВалюты.Курс);
	Результат.Вставить("Кратность", КурсВалюты.Кратность);
	
	Возврат Результат;
	
КонецФункции

