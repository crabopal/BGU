КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат
	КонецЕсли;
	
	СтрокаПлатеж = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПлатеж.КФО) Тогда
		Если СтрокаПлатеж.НомерСтроки > 1 Тогда
			СтрокаПлатеж.КФО = Объект.РасшифровкаПлатежа[СтрокаПлатеж.НомерСтроки-2].КФО;
		Иначе
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				СтрокаПлатеж.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПлатеж.ИсточникСредств) Тогда
		Если СтрокаПлатеж.НомерСтроки > 1 Тогда
			СтрокаПлатеж.ИсточникСредств = Объект.РасшифровкаПлатежа[СтрокаПлатеж.НомерСтроки-2].ИсточникСредств;
		Иначе
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",СтрокаПлатеж.КФО));
			Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
				СписокИСпоКФО = ИсточникиСредствПоКФО[0].СписокИсточников;
				Если СписокИСпоКФО.Количество() > 0 Тогда
					СтрокаПлатеж.ИсточникСредств = СписокИСпоКФО[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		СтрокаПлатеж.Сумма 		= Объект.СуммаДокумента - (Объект.РасшифровкаПлатежа.Итог("Сумма") - СтрокаПлатеж.Сумма);
		СтрокаПлатеж.СуммаВал	= Объект.СуммаДокументаВВалюте - (Объект.РасшифровкаПлатежа.Итог("СуммаВал") - СтрокаПлатеж.СуммаВал);
	КонецЕсли;
	
	Если Копирование Тогда
		Возврат
	КонецЕсли;
	
КонецПроцедуры

