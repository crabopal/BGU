&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	ПолучитьЛицевойСчетПоУмолчанию();
	
	Объект.РеквизитыСчетаЗачисления = Справочники.РеквизитыЛицевыхСчетов.ПустаяСсылка();
	ПолучитьРеквизитыСчетаЗачисления();
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Элементы.БухгалтерскаяОперация);
	КонецЕсли;
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	ДопустимыеИсточникиСредств = СписокВыбораИсточникСредств(Объект.ЛицевойСчет);
	
	Элементы.РасшифровкаПлатежаИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(Объект.ЛицевойСчет,СписокДопустимыхКФО,СписокИсточниковСредствПоКФО);
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		
		Если СписокДопустимыхКФО.НайтиПоЗначению(Стр.КФО) = Неопределено Тогда
			Стр.КФО = "";
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Стр.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет,Стр.КФО);
		Если ДопустимыеИсточникиСредств.Найти(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				Стр.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ВалютаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет,"ВалютаСчета");
	
	ОбновитьКурсВалюты(ЭтаФорма,Объект);
	
КонецПРоцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКурсВалюты(Форма, Объект)

	КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента,Форма.ДатаКурсаВалюты);
	Объект.Курс 			= КурсКратность.Курс;
	Объект.Кратность 		= КурсКратность.Кратность;
	
	ПересчитатьРублевоеПокрытие(Форма, Объект);
	
	РассчитатьКурсовуюРазницу(Форма, Объект);
	
КонецПроцедуры // ОбновитьКурсВалютыУстановитьДоступность()

&НаСервере
Процедура ПолучитьЛицевойСчетПоУмолчанию()
	
	Объект.ЛицевойСчет = Справочники.ЛицевыеСчета.ПолучитьЛицевойСчетПоУмолчанию(Объект.Организация, "Документ.ПоручениеНаПродажуВалюты", Объект.Дата, ,Объект.ВалютаДокумента);
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЛицевойСчетЗачисления()
	
	Объект.СчетЗачисленияРублей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыСчетаЗачисления, "Владелец");

	ПолучитьРеквизитыСчетаЗачисления();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыСчетаЗачисления()
	
	Если НЕ ЗначениеЗаполнено(Объект.СчетЗачисленияРублей) Тогда
		КазначействоСтрока = "";
		СчетИБанкСтрока = "";
		Элементы.КазначействоСтрока.Видимость = Ложь;
		Элементы.СчетИБанкСтрока.Видимость = Ложь;
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетЗачисленияРублей, "ТипЛицевогоСчета") = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
		РеквизитыСчетаЗачисленияСтруктура = Новый Структура("Счет, Казначейство, Банк", "СчетКазначейства.Код", "КассовыйОрган.НаименованиеПолное", "СчетКазначейства.КассовыйОрган.Наименование");
		РеквизитыСчетаЗачисления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.РеквизитыСчетаЗачисления, РеквизитыСчетаЗачисленияСтруктура);
		КазначействоСтрока = ""+РеквизитыСчетаЗачисления.Казначейство;
		СчетИБанкСтрока = "Счет № "+СокрЛП(РеквизитыСчетаЗачисления.Счет) + "; "+РеквизитыСчетаЗачисления.Банк;
		Элементы.КазначействоСтрока.Видимость = Истина;
		Элементы.СчетИБанкСтрока.Видимость = Истина;
	Иначе
		РеквизитыСчетаЗачисленияСтруктура = Новый Структура("Счет, Банк", "Владелец.Код", "КассовыйОрган.Наименование");
		РеквизитыСчетаЗачисления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.РеквизитыСчетаЗачисления, РеквизитыСчетаЗачисленияСтруктура);
		КазначействоСтрока = "";
		СчетИБанкСтрока = "Счет № "+СокрЛП(РеквизитыСчетаЗачисления.Счет) + "; "+РеквизитыСчетаЗачисления.Банк;
		Элементы.КазначействоСтрока.Видимость = Ложь;
		Элементы.СчетИБанкСтрока.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВалютныхРеквизитов(Форма)
	
	ВидимостьДоступность = Не Форма.Объект.ВалютаДокумента = Форма.ВалютаРегламентированногоУчета;
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("Курс");
	Реквизиты.Добавить("Кратность");
	Реквизиты.Добавить("СуммаДокумента");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		Реквизиты, "Доступность", ВидимостьДоступность);
		
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("РасшифровкаПлатежаСумма");
	Реквизиты.Добавить("ИтогоПоступленийВал");
	Реквизиты.Добавить("НадписьВалютаИтоги");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		Реквизиты, "Видимость", ВидимостьДоступность);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьГруппыИсполнение(Форма)
	
	ДоступностьГруппыИсполнение = Ложь;
	Статус = Неопределено;
	
	Если ТипЗнч(Форма.УстановленныеРеквизитыИсполнения) = Тип("Структура") Тогда
		Если Форма.УстановленныеРеквизитыИсполнения.Свойство("Статус",Статус) Тогда
			ДоступностьГруппыИсполнение = Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен");
		КонецЕсли;
	КонецЕсли;
	
	Форма.Элементы.СуммаВалютаКурс.Доступность = ДоступностьГруппыИсполнение;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьДатуКурсаВалюты(Форма)
	
	ДатаПроведения = Неопределено;
	
	Если ТипЗнч(Форма.УстановленныеРеквизитыИсполнения) = Тип("Структура") Тогда
		Форма.УстановленныеРеквизитыИсполнения.Свойство("ДатаПроведения",ДатаПроведения);
	КонецЕсли;
	
	Возврат ?(ДатаПроведения = Неопределено, Дата(1,1,1), ДатаПроведения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРублевоеПокрытие(Форма, Объект)
	Объект.СуммаДокумента = Объект.СуммаДокументаВВалюте*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность);
	Для Каждого ДанныеСтроки Из Объект.РасшифровкаПлатежа Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораИсточникСредств(Знач ЛицевойСчет)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ЛицевойСчет);
КонецФункции

&НаСервере
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()
	
	Элементы.ЛицевойСчет.Доступность = ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьКурсовуюРазницу(Форма, Объект)
	КурсоваяРазница = Объект.СуммаДокумента - Объект.СуммаРублейКЗачислению;
	ЗаголовокКурсовойРазницы = ?(КурсоваяРазница > 0, "Отрицательная курсовая разница:", "Положительная курсовая разница:");
	Форма.КурсоваяРазница = ?(КурсоваяРазница < 0, -КурсоваяРазница, КурсоваяРазница);
	Форма.КурсоваяРазницаЗаголовок = ЗаголовокКурсовойРазницы;
	Форма.КурсПродажиВалюты = ?(Объект.СуммаДокументаВВалюте = 0, 0, Объект.СуммаРублейКЗачислению / Объект.СуммаДокументаВВалюте);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуШапкиИИтогаТЧ(Форма)
	Объект = Форма.Объект;
	Форма.РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("СуммаВал") - Объект.СуммаДокументаВВалюте;
КонецПроцедуры

