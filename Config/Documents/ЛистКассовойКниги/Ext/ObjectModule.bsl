#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс


// Функция проверяет существование листа кассовой книги на дату
// текущего объекта.
// 
// Возвращаемое значение: 
// Булево.
// Истина - существует другой лист кассовой книги за этот день,
// Ложь - не существует.
// 
Функция СуществуетДокументЗаЭтотДень() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст="ВЫБРАТЬ
	|	ЛистКассовойКниги.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКниги КАК ЛистКассовойКниги
	|ГДЕ
	|	ЛистКассовойКниги.Организация = &Организация
	|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ЛистКассовойКниги.Ссылка <> &Ссылка
	|	И ЛистКассовойКниги.ВалютаДокумента = &ВалютаДокумента
	|	И ЛистКассовойКниги.Фондовый = &Фондовый
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКниги.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛистКассовойКниги.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКниги_52н КАК ЛистКассовойКниги
	|ГДЕ
	|	ЛистКассовойКниги.Организация = &Организация
	|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ЛистКассовойКниги.Ссылка <> &Ссылка
	|	И ЛистКассовойКниги.ВалютаДокумента = &ВалютаДокумента
	|	И ЛистКассовойКниги.Фондовый = &Фондовый
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКниги.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛистКассовойКниги.Ссылка
	|ИЗ
	|	Документ.ЛистКассовойКниги_52н КАК ЛистКассовойКниги
	|ГДЕ
	|	ЛистКассовойКниги.Организация = &Организация
	|	И ЛистКассовойКниги.Дата < &ДатаНач
	|	И ЛистКассовойКниги.Ссылка <> &Ссылка
	|	И ЛистКассовойКниги.ВалютаДокумента = &ВалютаДокумента
	|	И ЛистКассовойКниги.Фондовый = &Фондовый
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКниги.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))";
				 
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Подразделение",		Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(Подразделение));
	Запрос.УстановитьПараметр("ДатаНач",			НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон",			КонецДня(Дата));
	Запрос.УстановитьПараметр("Ссылка",				Ссылка);
	Запрос.УстановитьПараметр("ВалютаДокумента",	ВалютаДокумента);
	Запрос.УстановитьПараметр("Фондовый",			Фондовый);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ЗаполнитьДокумент() Экспорт
	
	Если Фондовый Тогда
	
		КассаОрганизации.ЗаполнитьОтчетКассираФондовый(ЭтотОбъект);
	
	Иначе
	
		КассаОрганизации.ЗаполнитьОтчетКассира(ЭтотОбъект);
	
	КонецЕсли; 
	
	Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если СуществуетДокументЗаЭтотДень() Тогда
		
		ТекстСообщения = НСтр("ru = 'Отчет кассира за "+Формат(ЭтотОбъект.Дата,"ДФ=dd.MM.yyyy")+" уже создан,
		|или существует отчет кассира по инстр. 52н, созданный более ранней датой.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.Дата",, Отказ);			

	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
	
		Фондовый = Ложь;
	
	КонецЕсли; 
	
	КассовыеОрдера.Очистить();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ТаблицаДокумента = КассовыеОрдера.Выгрузить(,"НомерСтроки, КассовыйДокумент");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаДокумента.НомерСтроки,
	|	ТаблицаДокумента.КассовыйДокумент
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.КассовыйДокумент,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|				ТОГДА ВедомостьНаВыдачуДенегИзКассы.Проведен
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|				ТОГДА ПриходныйКассовыйОрдер.Проведен
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|				ТОГДА ПриходныйОрдерФондовый.Проведен
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|				ТОГДА РасходныйКассовыйОрдер.Проведен
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|				ТОГДА РасходныйОрдерФондовый.Проведен
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Проведен,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|				ТОГДА ВедомостьНаВыдачуДенегИзКассы.Оплачено
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|				ТОГДА ПриходныйКассовыйОрдер.Оплачено
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|				ТОГДА ПриходныйОрдерФондовый.Оплачено
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|				ТОГДА РасходныйКассовыйОрдер.Оплачено
	|			КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|				ТОГДА РасходныйОрдерФондовый.Оплачено
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Оплачено,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВедомостьНаВыдачуДенегИзКассы.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйКассовыйОрдер.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйОрдерФондовый.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйКассовыйОрдер.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйОрдерФондовый.Ссылка)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Представление
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ПО ТаблицаДокумента.КассовыйДокумент = ПриходныйКассовыйОрдер.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерФондовый КАК ПриходныйОрдерФондовый
	|		ПО ТаблицаДокумента.КассовыйДокумент = ПриходныйОрдерФондовый.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|		ПО ТаблицаДокумента.КассовыйДокумент = РасходныйКассовыйОрдер.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерФондовый КАК РасходныйОрдерФондовый
	|		ПО ТаблицаДокумента.КассовыйДокумент = РасходныйОрдерФондовый.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВедомостьНаВыдачуДенегИзКассы КАК ВедомостьНаВыдачуДенегИзКассы
	|		ПО ТаблицаДокумента.КассовыйДокумент = ВедомостьНаВыдачуДенегИзКассы.Ссылка
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|					ТОГДА ВедомостьНаВыдачуДенегИзКассы.Проведен
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|					ТОГДА ПриходныйКассовыйОрдер.Проведен
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|					ТОГДА ПриходныйОрдерФондовый.Проведен
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|					ТОГДА РасходныйКассовыйОрдер.Проведен
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|					ТОГДА РасходныйОрдерФондовый.Проведен
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ = ЛОЖЬ
	|			ИЛИ ВЫБОР
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|					ТОГДА ВедомостьНаВыдачуДенегИзКассы.Оплачено
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|					ТОГДА ПриходныйКассовыйОрдер.Оплачено
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|					ТОГДА ПриходныйОрдерФондовый.Оплачено
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|					ТОГДА РасходныйКассовыйОрдер.Оплачено
	|				КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|					ТОГДА РасходныйОрдерФондовый.Оплачено
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ = ЛОЖЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.КассовыйДокумент,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ВедомостьНаВыдачуДенегИзКассы
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВедомостьНаВыдачуДенегИзКассы.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйКассовыйОрдер.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.ПриходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПриходныйОрдерФондовый.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйКассовыйОрдер.Ссылка)
	|		КОГДА ТаблицаДокумента.КассовыйДокумент ССЫЛКА Документ.РасходныйОрдерФондовый
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(РасходныйОрдерФондовый.Ссылка)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ";
	
	// запрос не получает никаких данных - можно отключить RLS
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Выборка.Количество() > 0 ;
	
	Если Отказ Тогда
		// очистим проверяемые реквизиты, чтобы не было лишних сообщений об ошибках
		
		ОшибкаПроведен = НСтр("ru = 'Документ %1 не проведен'");
		ОшибкаОплачено = НСтр("ru = 'Документ %1 не оплачен'");
		Пока Выборка.Следующий() Цикл
			
			Если НЕ Выборка.Оплачено Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаОплачено, Выборка.Представление);
			Иначе
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаПроведен, Выборка.Представление);
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Выборка.КассовыйДокумент);
			
		КонецЦикла;
		
		ПроверяемыеРеквизиты.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли