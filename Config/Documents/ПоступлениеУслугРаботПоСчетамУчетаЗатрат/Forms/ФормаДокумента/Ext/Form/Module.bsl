#Область ГосЗакупки

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоДоговору(ДоговорКонтрагента, ДатаСведений)
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		НаименованиеИКЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ, "Наименование");
		КодЗакупки = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(
			ДоговорКонтрагента, КонецДня(ДатаСведений), НаименованиеИКЗ);
		НомерБюджетногоОбязательстваПокупателя = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(
			ДоговорКонтрагента);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоОрганизации(ОрганизацияПокупатель)
	
	Если ЗначениеЗаполнено(ОрганизацияПокупатель) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияПокупатель, "Бюджет, КодОКТМО, КодПоРПБС");
		НомерРеестровойЗаписиПокупателя = СтруктураДанных.КодПоРПБС;
		КодОКТМО = СтруктураДанных.КодОКТМО;
		Бюджет = СтруктураДанных.Бюджет;
		
		СтруктураДанныхБюджет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Бюджет, "НаименованиеФинансовогоОргана");
		НаименованиеФинансовогоОрганаПокупателя = СтруктураДанныхБюджет.НаименованиеФинансовогоОргана;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоРеквизитамЛС(РеквизитыЛицевогоСчета)
	
	Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган, Владелец");
		Казначейство = СтруктураДанных.КассовыйОрган;
		СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Казначейство, "НаименованиеПолное, Код");
		ЛицевойСчет = СтруктураДанных.Владелец;
		СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "КодПоРПБС, Код, ИспользоватьДляСчетаУчетныйНомер");
		НомерЛицевогоСчетаПокупателя = СтруктураДанныхЛицевогоСчета.Код;
		КодПоРПБСЛицевогоСчета = СтруктураДанныхЛицевогоСчета.КодПоРПБС;
		ИспользоватьДляСчетаУчетныйНомер = СтруктураДанныхЛицевогоСчета.ИспользоватьДляСчетаУчетныйНомер;
		Если ИспользоватьДляСчетаУчетныйНомер И ЗначениеЗаполнено(КодПоРПБСЛицевогоСчета) Тогда
			НомерРеестровойЗаписиПокупателя = КодПоРПБСЛицевогоСчета;
		КонецЕсли;	
		
		КазначействоПокупателяКод = СтруктураДанныхКазначейства.Код;
		КазначействоПокупателяНаименование = СтруктураДанныхКазначейства.НаименованиеПолное;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСведенияИнформацияПокупателяГосЗакупки() 
	ЗаполнитьСведенияГосЗакупкиПоДоговору(Объект.Договор, Объект.Дата);
	ЗаполнитьСведенияГосЗакупкиПоОрганизации(Объект.Организация);
	ЗаполнитьСведенияГосЗакупкиПоРеквизитамЛС(Объект.ГосЗакупкаРеквизитыЛицевогоСчетаПокупателя);
КонецПроцедуры

&НаСервере
Процедура ГосЗакупкиДенежныеОбязательстваОбъектФАИПОбновитьКоды()
	
	Для каждого ТекСтрока Из Объект.ГосЗакупкиДенежныеОбязательства Цикл
		ОбъектФАИП = ТекСтрока.ОбъектФАИП;
		ДанныеОбъектаФАИП = ДанныеОбъектаФАИП(ОбъектФАИП);
		ТекСтрока.КодОбъектаФАИП = ДанныеОбъектаФАИП.КодФАИП;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ДанныеОбъектаФАИП(ОбъектФАИП)
	КодФАИП = "";
	
	Если ЗначениеЗаполнено(ОбъектФАИП) Тогда
		Если ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектФАИП, "КодФАИП");
			КодФАИП = СтруктураДанных.КодФАИП;
		ИначеЕсли ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.МероприятияПоИнформатизации") Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектФАИП, "Код");
			КодФАИП = СтруктураДанных.Код;
		КонецЕсли;
	КонецЕсли;
	
	РезультатСтруктураДанных = Новый Структура;
	РезультатСтруктураДанных.Вставить("КодФАИП", КодФАИП);
	
	Возврат РезультатСтруктураДанных;
КонецФункции	

&НаСервере
Процедура ЗаполнитьКодОКТМОМестаПоставкиПоКодуОКТМОПокупателяНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ГосЗакупкаКодОКТМОПокупателя) Тогда
		Объект.ГосЗакупкаКодОКТМОМестаПоставки = Объект.ГосЗакупкаКодОКТМОПокупателя;
	Иначе
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "КодОКТМО");
		Объект.ГосЗакупкаКодОКТМОМестаПоставки = СтруктураДанных.КодОКТМО;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольЗаполненияДанныхГосЗакупок()
	Если ЗначениеЗаполнено(Объект.ГосЗакупкаНомерДенежногоОбязательства) И Элементы.ГруппаЗакупкаДляГосударственныхНужд.Видимость Тогда
		Если Объект.ГосЗакупкиДенежныеОбязательства.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнены сведения о денежном обязательстве!'"),
			Объект.Ссылка,
			"Объект.ГосЗакупкиДенежныеОбязательства");
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	УстановитьВидимостьЭлементовФормы_НДС(Форма);
	
	ВидимостьЭлементовРезерв = Форма.Объект.ВидПоступления
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.НачислениеОбязательствЗаСчетРезерва");
	ЭлементыРезерв = Новый Массив;
	ЭлементыРезерв.Добавить("УслугиИРаботыЗаголовокФакт");
	ЭлементыРезерв.Добавить("УслугиИРаботыЗаголовокРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыКоличествоРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыСуммаРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыСтавкаНДСРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыСуммаНДСРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыСпособУчетаНДСРезерв");
	ЭлементыРезерв.Добавить("УслугиИРаботыВсегоРезерв");
	ЭлементыРезерв.Добавить("СтраницаОтложенныеОбязательства");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыРезерв,
		"Видимость", ВидимостьЭлементовРезерв);
		
	ВидимостьРезерв = Форма.Объект.ВидПоступления
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.ПоступлениеУслугРезерв")
		Или Форма.Объект.ВидПоступления
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.НачислениеОбязательствЗаСчетРезерва");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Резерв",
		"Видимость", ВидимостьРезерв);
		
	ВидимостьАванс = Форма.Объект.ВидПоступления
		<> ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.ПоступлениеУслугРезерв");
	ЭлементыАванс = Новый Массив;
	ЭлементыАванс.Добавить("СпособЗачетаАванса");
	ЭлементыАванс.Добавить("ЗачетАванса");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыАванс,
		"Видимость", ВидимостьАванс);
		
	ВидимостьОбязательств = Форма.Объект.ВидПоступления
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.ПоступлениеУслуг")
		Или Форма.Объект.ВидПоступления
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеУслуг.НачислениеОбязательствЗаСчетРезерва");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтрДенежныеОбязательства",
		"Видимость", ВидимостьОбязательств);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_НДС(Форма)

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПринятьНДСКВычетуУказываетсяВШапке = Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УслугиИРаботыСпособУчетаНДС",
		"Видимость", ПринятьНДСКВычетуУказываетсяВСтроках);
	ЭлементыНДСКРаспределению = Новый Массив;
	ЭлементыНДСКРаспределению.Добавить("УслугиИРаботыНДСКРаспределению");
	ЭлементыНДСКРаспределению.Добавить("УслугиИРаботыТекстНДСКРаспределению");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыНДСКРаспределению,
		"Видимость", ПринятьНДСКВычетуУказываетсяВШапке И Объект.ПринятьНДСКВычету);
	
	Элементы.ФормаПринятьНДСКВычетуУказываетсяВСтроках.Пометка = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;

КонецПроцедуры

// Получить КЭКВида затрат.
// 
// Параметры:
//  ВидЗатрат - СправочникСсылка.ВидыЗатрат
// 
// Возвращаемое значение:
//  СправочникСсылка.КОСГУ - Получить КЭКВида затрат
&НаСервереБезКонтекста
Функция ПолучитьКЭКВидаЗатрат(Знач ВидЗатрат) 
	КЭК = ПредопределенноеЗначение("Справочник.КОСГУ.ПустаяСсылка");
	Если ЗначениеЗаполнено(ВидЗатрат) Тогда
		КЭК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗатрат, "КЭК");
	КонецЕсли;	
	Возврат КЭК;
КонецФункции	

&НаКлиенте
Процедура ВопросПересчитатьДатуОплатитьДо(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ДатаДокумента = ?(ЗначениеЗаполнено(Объект.ДатаПодписанияПервичногоДокумента), Объект.ДатаПодписанияПервичногоДокумента, Объект.Дата);
		Объект.ОплатитьДо = ПредельнаяДатаОплатыЗадолженности(ДатаДокумента, Объект.Договор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредельнаяДатаОплатыЗадолженности(ДатаДокумента, Договор)
	
	Возврат КонтрольИсполненияДоговоров.ПредельнаяДатаОплатыЗадолженности(ДатаДокумента, Договор);
	
КонецФункции

&НаКлиенте
Процедура ПослеВводаДатыКонтроляЦен(ДатаКонтроля, ДопПараметры) Экспорт
	
	ДатаКонтроляЦен = ДатаКонтроля;
	
	Если ДатаКонтроляЦен = Неопределено Тогда
		ДатаКонтроляЦен = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ДатаКонтроля");
	КонецЕсли;
	
	Если ДатаКонтроляЦен <> Неопределено Тогда
		ВыполнитьКонтрольЦен(ДатаКонтроляЦен);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьКонтрольЦен(ДатаКонтроля)
	
	РаботаСОбязательствами.ВыполнитьКонтрольЦен(ДатаКонтроля, Объект, МассивСтрокКонтроляЦен, "УслугиИРаботы");
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область Инициализация

ЭтоНоваяСтрока = Ложь;

#КонецОбласти
