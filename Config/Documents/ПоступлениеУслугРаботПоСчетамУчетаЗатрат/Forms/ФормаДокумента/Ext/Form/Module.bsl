Процедура ДоговорПриИзмененииНаСервере()
	
	ВидСчетаФактуры = ПолучитьВидСчетаФактурыПоДоговоруСервер(Объект["Договор"]);
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения"); 
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УслугиИРаботыОбновитьДанныеВсехСтрок(Объект, СписокСчетов106)
	
	СчетаДокумента = Объект.УслугиИРаботы.Выгрузить(, "СчетЗатрат, СчетЗатратНУ");
	ВсеСчета = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета,
		СчетаДокумента.ВыгрузитьКолонку("СчетЗатрат"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета,
		СчетаДокумента.ВыгрузитьКолонку("СчетЗатратНУ"), Истина);
	СвойстваСчетов = ДанныеСчетов(ВсеСчета);
	ИменаКолонокСчетаЗатратБУ = ИменаКолонокСчетаЗатрат("БУ");
	ИменаКолонокСчетаЗатратНУ = ИменаКолонокСчетаЗатрат("НУ");
	ДанныеПустогоСчета = СтруктураДанныхСчета();
	
	Для Каждого СтрокаТаблицы Из Объект.УслугиИРаботы Цикл
		ТекСчетБУ = СвойстваСчетов.Получить(СтрокаТаблицы.СчетЗатрат);
		Если ТекСчетБУ = Неопределено Тогда
			ТекСчетБУ = ДанныеПустогоСчета;
		КонецЕсли;
		УстановитьДанныеСчетаВСтроку(СтрокаТаблицы, ИменаКолонокСчетаЗатратБУ, ТекСчетБУ);
		ТекСчетНУ = СвойстваСчетов.Получить(СтрокаТаблицы.СчетЗатратНУ);
		Если ТекСчетНУ = Неопределено Тогда
			ТекСчетНУ = ДанныеПустогоСчета;
		КонецЕсли;
		УстановитьДанныеСчетаВСтроку(СтрокаТаблицы, ИменаКолонокСчетаЗатратНУ, ТекСчетНУ);
		УстановитьКапВложение(СтрокаТаблицы, 0);
	КонецЦикла;
	ЗаполнитьСпособУчетаНДСВСтрокахРезерв(Объект);
	
КонецПроцедуры

