Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		Если (Объект.УслугиИРаботы.Количество() > 0) Тогда
			Возврат;
		КонецЕсли;	
		
		Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ЗаполнитьПоЭлектронномуДокументуПоставщика(Объект, ДокументОснование);
