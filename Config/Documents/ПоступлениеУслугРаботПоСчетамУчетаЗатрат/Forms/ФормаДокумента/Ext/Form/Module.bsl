Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = УправлениеНФАКлиентСервер.ПараметрыРасчетаСтрокиДокумента();
	ПараметрыРасчета.СуммаВключаетНДС = СуммаВключаетНДС;
