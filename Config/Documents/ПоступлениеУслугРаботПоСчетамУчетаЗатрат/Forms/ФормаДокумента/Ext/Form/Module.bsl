&НаСервере
Процедура ПервичныйДокументПриИзмененииНаСервере()
	ОбщегоНазначенияБГУ.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСпособУчетаНДСВСтрокахРезерв(Объект)
	Для Каждого СтрокаТаблицы Из Объект.УслугиИРаботы Цикл
		СтрокаТаблицы.СпособУчетаНДСРезерв = УправлениеНФАКлиентСервер.ЗначениеСпособУчетаНДС(
			СтрокаТаблицы.ПринятьНДСКВычетуРезерв, СтрокаТаблицы.НДСКРаспределениюРезерв);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВидПоступленияПриИзмененииНаСервере()
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьКурсВалютыНаСервере()
	
	КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
	Объект.Курс = КурсКратность.Курс;
	Объект.Кратность = КурсКратность.Кратность;
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Знач Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВсехСчетов106()
	ВсеСчета106.ЗагрузитьЗначения(Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ВсеСчета106ОС());
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборСчетаВСтрокеТЧ(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, ВидУчета)
	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыВыбора = Новый Структура;
	Если ВидУчета = "БУ" Тогда
		ПараметрыФормыВыбора.Вставить("ОграниченияСписокСчетов", ОграниченияСписокСчетовБУ);
	Иначе
		ПараметрыФормыВыбора.Вставить("ОграниченияСписокСчетов", ОграниченияСписокСчетовНУ);
	КонецЕсли;
	ПараметрыФормыВыбора.Вставить("СтрокаПоиска", Текст);
	ПараметрыФормыВыбора.Вставить("НаДату", Объект.Дата);
	ПараметрыФормыВыбора.Вставить("Организация", Объект.Организация);
	ПараметрыФормыВыбора.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыФормыВыбора);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСпискиОграниченийСчетов()
	ОграниченияСчетов = Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ОграниченияСчетов();
	ОграниченияСписокСчетовБУ = ОграниченияСчетов.ОграниченияСписокСчетовБУ;
	ОграниченияСписокСчетовНУ = ОграниченияСчетов.ОграниченияСписокСчетовНУ;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСубконтоНУПоСубконтоБУ(ТекущиеДанные, ЗначениеСубконтоБУ, ВидСубконтоБУ)  
	Для Индекс = 1 По 3 Цикл
		Если ТекущиеДанные["ВидСубконтоНУ" + Индекс] = ВидСубконтоБУ Тогда
			ТекущиеДанные["СубконтоЗатратНУ" + Индекс] = ЗначениеСубконтоБУ;
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьКапВложение(ТекущиеДанные, НомерСубконто = 0)
	Если НомерСубконто = 0 Тогда
		НомерСубконто = НомерСубконтоОС(ТекущиеДанные);
	КонецЕсли;
	Если НомерСубконто = 0 Тогда
		Возврат;
	КонецЕсли;
	ВидСубконтоОС = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства");
	Если ТекущиеДанные["ВидСубконто" + НомерСубконто] = ВидСубконтоОС Тогда
		ТекущиеДанные.КапВложение = ТекущиеДанные["СубконтоЗатрат" + НомерСубконто];
		Если ЗначениеЗаполнено(ТекущиеДанные.КапВложение) И ЗначениеЗаполнено(ТекущиеДанные.КарточкаКапвложений) Тогда
			ОСПоКапВложению = ОСпоКапВложению(ТекущиеДанные.КарточкаКапвложений);
			Если ОСПоКапВложению <> ТекущиеДанные.КапВложение Тогда
				ТекущиеДанные.КарточкаКапвложений = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Основное средство из карточки капвложений.
// 
// Параметры:
//  КапВложение - СправочникСсылка.КарточкиКапвложений
// 
// Возвращаемое значение:
//  СправочникСсылка.ОсновныеСредства
&НаСервереБезКонтекста
Функция ОСпоКапВложению(КапВложение)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КапВложение, "ОбъектВложений");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НомерСубконтоОС(ТекущиеДанные)
	ВидСубконтоОС = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства");
	Для Индекс = 1 По 3 Цикл
		Если ТекущиеДанные["ВидСубконто" + Индекс] = ВидСубконтоОС Тогда
			Возврат Индекс;
		КонецЕсли;	
	КонецЦикла;
	Возврат 0;
КонецФункции

&НаСервере
Функция ДоступнаКарточкаКапВложений(Счет)
	Возврат ВсеСчета106.НайтиПоЗначению(Счет) <> Неопределено;
КонецФункции

&НаСервере
Процедура УстановитьДоступностьКарточкиКапВложений(ТекущиеДанные)
	ДоступнаКарточкаКапВложений = ДоступнаКарточкаКапВложений(ТекущиеДанные.СчетЗатрат);
	Если НЕ ДоступнаКарточкаКапВложений Тогда
		ТекущиеДанные.ОтразитьВКарточкеКапвложений = Ложь;
		ТекущиеДанные.КарточкаКапвложений = Неопределено;
		ТекущиеДанные.КапВложение = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СчетЗатратПриИзмененииСервер(ИдентификаторСтроки)
	ЗаполнитьДанныеСчетаСервер(ИдентификаторСтроки, "БУ");
	ТекущиеДанные = Объект.УслугиИРаботы.НайтиПоИдентификатору(ИдентификаторСтроки);
	УстановитьДоступностьКарточкиКапВложений(ТекущиеДанные);
	Если ВедетсяНалоговыйУчет(ЭтотОбъект, ТекущиеДанные.КФО) Тогда
		УстановитьСчетНУ(ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетНУ(ИдентификаторСтроки)
	ЗаполнитьСчетНУПоСчетуБУ(ИдентификаторСтроки);
	УстановитьВсеСубконтоНУПоСубконтоБУ(Объект.УслугиИРаботы.НайтиПоИдентификатору(ИдентификаторСтроки));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВедетсяНалоговыйУчет(Форма, КФО)
	Возврат Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(КФО);
КонецФункции

&НаСервере
Процедура СчетЗатратНУПриИзмененииСервер(ИдентификаторСтроки)
	ЗаполнитьДанныеСчетаСервер(ИдентификаторСтроки, "НУ");
	УстановитьВсеСубконтоНУПоСубконтоБУ(Объект.УслугиИРаботы.НайтиПоИдентификатору(ИдентификаторСтроки));
КонецПроцедуры

&НаСервере
Процедура УстановитьВсеСубконтоНУПоСубконтоБУ(ТекущиеДанные)
	Для Индекс = 1 По ТекущиеДанные.КоличествоСубконтоЗатрат Цикл
		УстановитьСубконтоНУПоСубконтоБУ(ТекущиеДанные,
			ТекущиеДанные["СубконтоЗатрат" + Индекс], ТекущиеДанные["ВидСубконто" + Индекс]);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаКолонокСчетаЗатрат(ВидУчета)
	ИменаКолонокСчетаЗатрат = Новый Структура;
	Если ВидУчета = "БУ" Тогда
		ИменаКолонокСчетаЗатрат.Вставить("СчетЗатрат", "СчетЗатрат");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный1", "СубконтоОбязательный1");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный2", "СубконтоОбязательный2");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный3", "СубконтоОбязательный3");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто1", "ВидСубконто1");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто2", "ВидСубконто2");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто3", "ВидСубконто3");
		ИменаКолонокСчетаЗатрат.Вставить("КоличествоСубконто", "КоличествоСубконтоЗатрат");
		ИменаКолонокСчетаЗатрат.Вставить("КоличествоСубконтоУО", "КоличествоСубконтоЗатратУО");
		ИменаКолонокСчетаЗатрат.Вставить("НомерСубконтоВидыЗатрат", "НомерСубконтоВидыЗатрат");
		ИменаКолонокСчетаЗатрат.Вставить("УчетПоПодразделениям", "УчетПоПодразделениям");
	Иначе
		ИменаКолонокСчетаЗатрат.Вставить("СчетЗатрат", "СчетЗатратНУ");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный1", "СубконтоНУОбязательный1");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный2", "СубконтоНУОбязательный2");
		ИменаКолонокСчетаЗатрат.Вставить("СубконтоОбязательный3", "СубконтоНУОбязательный3");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто1", "ВидСубконтоНУ1");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто2", "ВидСубконтоНУ2");
		ИменаКолонокСчетаЗатрат.Вставить("ВидСубконто3", "ВидСубконтоНУ3");
		ИменаКолонокСчетаЗатрат.Вставить("КоличествоСубконто", "КоличествоНУСубконтоЗатрат");
		ИменаКолонокСчетаЗатрат.Вставить("КоличествоСубконтоУО", "КоличествоНУСубконтоЗатратУО");
		ИменаКолонокСчетаЗатрат.Вставить("НомерСубконтоВидыЗатрат", "НомерСубконтоНУВидыЗатрат");
	КонецЕсли;
	Возврат ИменаКолонокСчетаЗатрат;
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеСчетаСервер(ИдентификаторСтроки, ВидУчета)
	ЗаполнитьДанныеСчета(Объект.УслугиИРаботы.НайтиПоИдентификатору(ИдентификаторСтроки),
		ИменаКолонокСчетаЗатрат(ВидУчета));
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчета(ТекущиеДанные, ИменаКолонокСчетаЗатрат)
	ВыбранныйСчет = ТекущиеДанные[ИменаКолонокСчетаЗатрат.СчетЗатрат];
	ДанныеСчета = Неопределено;
	Если ЗначениеЗаполнено(ВыбранныйСчет) Тогда
		ДанныеСчета = ДанныеСчетов(ВыбранныйСчет).Получить(ВыбранныйСчет);
	КонецЕсли;
	Если ДанныеСчета <> Неопределено Тогда
		СтруктураДанныхСчета = ДанныеСчета;
	Иначе
		СтруктураДанныхСчета = СтруктураДанныхСчета();
	КонецЕсли;
	УстановитьДанныеСчетаВСтроку(ТекущиеДанные, ИменаКолонокСчетаЗатрат, СтруктураДанныхСчета);
	УстановитьСубконтоВидЗатрат(ТекущиеДанные);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДанныеСчетаВСтроку(ТекущиеДанные, ИменаКолонокСчетаЗатрат, ДанныеСчета)
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.СубконтоОбязательный1] = ДанныеСчета.СубконтоОбязательный1;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.СубконтоОбязательный2] = ДанныеСчета.СубконтоОбязательный2;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.СубконтоОбязательный3] = ДанныеСчета.СубконтоОбязательный3;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.ВидСубконто1] = ДанныеСчета.ВидСубконто1;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.ВидСубконто2] = ДанныеСчета.ВидСубконто2;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.ВидСубконто3] = ДанныеСчета.ВидСубконто3;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.КоличествоСубконто] = ДанныеСчета.КоличествоСубконто;
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.КоличествоСубконтоУО] = ДанныеСчета.КоличествоСубконто
		- ?(ДанныеСчета.НомерСубконтоВидыЗатрат = 0, 0, 1);
	ТекущиеДанные[ИменаКолонокСчетаЗатрат.НомерСубконтоВидыЗатрат] = ДанныеСчета.НомерСубконтоВидыЗатрат;
	ИмяУчетПоПодразделениям = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ИменаКолонокСчетаЗатрат, "УчетПоПодразделениям");
	Если ЗначениеЗаполнено(ИмяУчетПоПодразделениям) Тогда
		ТекущиеДанные[ИмяУчетПоПодразделениям] = ДанныеСчета.УчетПоПодразделениям;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетНУПоСчетуБУ(ИдентификаторСтроки)
	ТекущиеДанные = Объект.УслугиИРаботы.НайтиПоИдентификатору(ИдентификаторСтроки);
	СчетБУ = ТекущиеДанные.СчетЗатрат;
	ВидСчетаБУ = НалоговыйУчетКлиентСервер.ВидСчетаБУ(СчетБУ);
	Если ВидСчетаБУ = "СчетЗатрат" Тогда
		КорСчетБУ = Неопределено;
		СчетНУ = НалоговыйУчетКлиентСервер.СчетРасходовНУ(СчетБУ,
			ТекущиеДанные.СубконтоЗатрат1,
			ТекущиеДанные.СубконтоЗатрат2,
			ТекущиеДанные.СубконтоЗатрат3,
			КорСчетБУ,
			Объект.Организация,
			Объект.ИФО,
			ТекущиеДанные.ПодразделениеЗатрат,
			Объект.Дата);
	Иначе
		СчетНУ = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СчетБУ, Объект.Дата, "Дт");
	КонецЕсли;
	ТекущиеДанные.СчетЗатратНУ = СчетНУ;
	ЗаполнитьДанныеСчетаСервер(ИдентификаторСтроки, "НУ");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСубконтоСчетаЗатрат(ТекущиеДанные)
	ОчиститьСубконтоСчета(ТекущиеДанные, "БУ");
	ТекущиеДанные.КапВложение = Неопределено;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСубконтоСчетаЗатратНУ(ТекущиеДанные)
	ОчиститьСубконтоСчета(ТекущиеДанные, "НУ");
КонецПроцедуры

