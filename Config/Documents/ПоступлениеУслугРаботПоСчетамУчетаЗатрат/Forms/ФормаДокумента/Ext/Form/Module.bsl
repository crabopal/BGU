Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект.УслугиИРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, НоваяСтрока);
	КонецЦикла;
    ПересчитатьТабличнуюЧасть();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтотОбъект, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидСчетаФактурыПоДоговоруСервер(ДоговорСсылка)
	
	Возврат УчетНДС.ПолучитьВидСчетаФактурыПоДоговору(ДоговорСсылка);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;

	Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ЗаполнитьПоОстаткамАвансов(Объект, Модифицированность);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПоступлениюУслугКлиент()
	Если Объект.УслугиИРаботы.Количество() > 0
			Или Объект.ДенежныеОбязательства.Количество() > 0
			Или Объект.ОтложенныеОбязательства.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Заполнить по выбранному документу-основанию?'");
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗаполненииПоПоступлениюУслугРабот", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ЗаполнитьПоПоступлениюУслугСервер();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаполненииПоПоступлениюУслугРабот(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоПоступлениюУслугСервер();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПоступлениюУслугСервер()
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		
		Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ЗаполнитьПоПоступлениюУслугРаботПоСчетамУчетаЗатратРезерв(
			Объект, Объект.ДокументОснование, Истина);
		
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		
		Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ЗаполнитьПоПоступлениюУслугРабот(
			Объект, Объект.ДокументОснование, Истина);
		
		КонецЕсли;
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	УслугиИРаботыОбновитьДанныеВсехСтрок(Объект, ВсеСчета106);
	УправлениеНФАКлиентСервер.ЗаполнитьСпособУчетаНДСВСтроках(Объект, Объект.УслугиИРаботы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если СуммаВключаетНДСДоИзменения <> Объект.СуммаВключаетНДС Тогда
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы_НДС(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)
	
	Объект = Форма.Объект;
	
	ПараметрыПредставления = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта_Параметры();
	ПараметрыПредставления.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыПредставления.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
	ПараметрыПредставления.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	ПараметрыПредставления.ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПараметрыПредставления.ПоказыватьНДС = Истина;
	ПараметрыПредставления.УчитыватьНДС = ПараметрыПредставления.ПоказыватьНДС;
	ПараметрыПредставления.ПоказыватьВалюту = Форма.КэшПараметров.ИспользоватьВалютныйУчет;
	ПараметрыПредставления.Курс = Объект.Курс;
	ПараметрыПредставления.Кратность = Объект.Кратность;
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовЭДОДляЭДПоставщика, ВидимостьЭлементовЭДОДляГосНужд)
	
	Если ВидимостьЭлементовЭДОДляЭДПоставщика Тогда
		ВидимостьЭлементовЭДО = Истина;
		Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Отражение ЭД в учете'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДекорацияСостояниеЭДО", "Доступность", ВидимостьЭлементовЭДОДляЭДПоставщика);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиИРаботыИдентификаторПоставщика", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьЭлементовЭДОДляЭДПоставщика);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиИРаботыНаименованиеПоставщика", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьЭлементовЭДОДляЭДПоставщика);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаЗакупкаДляГосударственныхНужд", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовЭДОДляГосНужд);
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Субконто затрат
	УстановитьУсловноеОформлениеЗаглушкаСубконтоЗатрат(Элементы.УслугиИРаботыЗаглушкаСубконтоЗатрат);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатрат1);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатрат2);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатрат3);
	УстановитьУсловноеОформлениеЗаглушкаСубконтоЗатрат(Элементы.УслугиИРаботыЗаглушкаСубконтоЗатратНУ);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатратНУ1);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатратНУ2);
	УстановитьУсловноеОформлениеСубконтоЗатрат(Элементы.УслугиИРаботыСубконтоЗатратНУ3);
	УстановитьУсловноеОформлениеПодразделениеЗатрат(Элементы.УслугиИРаботыПодразделениеЗатрат);
	УстановитьУсловноеОформлениеКарточкиКапВложения();
	УстановитьУсловноеОформлениеСтатическихКолонок();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСтатическихКолонок()
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыЗаголовокФакт");
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Факт:'"));
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыЗаголовокРезерв");
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Резерв:'"));
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыЗаглушкаСубконтоЗатрат");
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуются'"));
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыЗаглушкаСубконтоЗатратНУ");
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуются'"));
	Элемент.Использование = Истина;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПодразделениеЗатрат(ЭлементФормы)
	ИмяЭлемента = ЭлементФормы.Имя;
	ИмяТаблицы = Элементы.УслугиИРаботы.Имя;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".УчетПоПодразделениям",
		Ложь);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".УчетПоПодразделениям",
		Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".ПодразделениеЗатрат",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Из шапки документа'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЗаглушкаСубконтоЗатрат(ЭлементФормы)
	ИмяЭлемента = ЭлементФормы.Имя;
	ИмяТаблицы = Элементы.УслугиИРаботы.Имя;
	ВидУчетаБУ = Прав(ИмяЭлемента, 2) <> "НУ";
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	ИмяКоличествоСубконтоЗатрат = ?(ВидУчетаБУ, "КоличествоСубконтоЗатратУО", "КоличествоНУСубконтоЗатратУО");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + "." + ИмяКоличествоСубконтоЗатрат,
		0,
		ВидСравненияКомпоновкиДанных.Больше);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСубконтоЗатрат(ЭлементФормы)
	
	ИмяЭлемента = ЭлементФормы.Имя;
	ИмяТаблицы = Элементы.УслугиИРаботы.Имя;
	НомерСубконто = Прав(ИмяЭлемента, 1);
	ВидУчетаБУ = Прав(ИмяЭлемента, 3) <> "НУ" + НомерСубконто;
	ТипЧисло = Новый ОписаниеТипов("Число");
	НомерСубконтоЧислом = ТипЧисло.ПривестиЗначение(НомерСубконто);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	ИмяКоличествоСубконтоЗатрат = ?(ВидУчетаБУ, "КоличествоСубконтоЗатрат", "КоличествоНУСубконтоЗатрат");
	ИмяНомерСубконтоВидыЗатрат = ?(ВидУчетаБУ, "НомерСубконтоВидыЗатрат", "НомерСубконтоНУВидыЗатрат");
	
	ГруппаИли = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИли,
		"Объект." + ИмяТаблицы + "." + ИмяКоличествоСубконтоЗатрат,
		НомерСубконтоЧислом,
		ВидСравненияКомпоновкиДанных.Меньше);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИли,
		"Объект." + ИмяТаблицы + "." + ИмяНомерСубконтоВидыЗатрат,
		НомерСубконтоЧислом,
		ВидСравненияКомпоновкиДанных.Равно);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Отметка незаполненного значения субконто
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);

	Если ВидУчетаБУ Тогда
		ИмяСубконтоОбязательный = "СубконтоОбязательный" + НомерСубконто;
	Иначе
		ИмяСубконтоОбязательный = "СубконтоНУОбязательный" + НомерСубконто;
	КонецЕсли;
	ИмяСубконтоОбязательный = ?(ВидУчетаБУ, "СубконтоОбязательный", "СубконтоНУОбязательный");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + "." + ИмяСубконтоОбязательный + НомерСубконто,
		Ложь,
		ВидСравненияКомпоновкиДанных.Равно);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеКарточкиКапВложения()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыОтразитьВКарточкеКапвложений");
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыКарточкаКапвложений");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.КапВложение", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	Элемент.Использование = Истина;

	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыКарточкаКапвложений");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.КапВложение", , ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.ОтразитьВКарточкеКапвложений", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.КарточкаКапвложений", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыКарточкаКапвложений");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.КапВложение", , ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.ОтразитьВКарточкеКапвложений", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыКапВложениеНеПрименимо");
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не используется'"));
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("УслугиИРаботыКапВложениеНеПрименимо");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.УслугиИРаботы.КапВложение", , ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	Элемент.Использование = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение, НоменклатураВЗаголовкеФормы = Истина)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.УслугиИРаботы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	РеквизитыДляФормыРедактирования = "Дата, Организация, ПодразделениеЗатрат, ИФО,
		|КПС, КЭК, ПодразделениеЗатрат, ВидЗатрат,
		|СчетЗатрат, СубконтоЗатрат1, СубконтоЗатрат2, СубконтоЗатрат3,
		|СчетЗатратНУ, СубконтоЗатратНУ1, СубконтоЗатратНУ2, СубконтоЗатратНУ3";
	ПараметрыФормы = Новый Структура(РеквизитыДляФормыРедактирования);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	Если НоменклатураВЗаголовкеФормы Тогда
		ПараметрыФормы.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
	КонецЕсли;		
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ОткрытьФорму("Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаРедактированияАналитикиЗатрат", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтражениеВУчетеОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы <> "Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаРедактированияАналитикиЗатрат" Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого ВыделеннаяСтрока Из Элементы.УслугиИРаботы.ВыделенныеСтроки Цикл
		ТекущиеДанные = Элементы.УслугиИРаботы.ДанныеСтроки(ВыделеннаяСтрока);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборМЗОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
