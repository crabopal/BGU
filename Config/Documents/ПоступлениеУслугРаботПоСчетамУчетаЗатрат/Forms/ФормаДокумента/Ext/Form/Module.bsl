КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Контрагент""'"),, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Объект.Организация");
		Возврат;
	КонецЕсли;

	ВыполняемыеДействия = Новый Массив;
	Если Объект.ЗачетАвансов.Количество() > 0 Тогда
		ВыполняемыеДействия.Добавить(НСтр("ru = 'Табличная часть будет очищена.'"));
	КонецЕсли;
	Если Объект.Проведен Тогда
		ВыполняемыеДействия.Добавить(НСтр("ru = 'Проведение документа будет отменено.'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыполняемыеДействия) Тогда
		ВыполняемыеДействия.Добавить(НСтр("ru = 'Продолжить?'"));
		ТекстВопроса = СтрСоединить(ВыполняемыеДействия, Символы.ПС);
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьАвансыЗавершение", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;	 

	ЗаполнитьАвансыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАналитикуЗатрат(Команда)
	
	Если Объект.УслугиИРаботы.Количество() > 0 Тогда
		ВыбраннаяСтрока = Элементы.УслугиИРаботы.ВыделенныеСтроки[0];
		Если Элементы.УслугиИРаботы.ВыделенныеСтроки.Количество() > 1 Тогда
			НоменклатураВЗаголовкеФормы = Ложь;
		Иначе
			НоменклатураВЗаголовкеФормы = Истина;
		КонецЕсли;
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока, НоменклатураВЗаголовкеФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДоговору(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСТр("ru = 'Не заполнено обязательное поле ""Договор""'"),,
			"Объект.Договор");
		Возврат;
	КонецЕсли;
	
	Если Объект.УслугиИРаботы.Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьТаблицуПоДоговору", ЭтотОбъект),
			НСтр("ru = 'Существующие строки документа будут удалены. 
			|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗаполнитьТаблицуПоДоговоруНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОснованию(Команда)
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
			НСтр("ru = 'Документ-основание'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , "Объект.ДокументОснование");
		Возврат;
	КонецЕсли;
	ЗаполнитьПоОснованиюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДО(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Контрагент""'"),, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед заполнением денежных обязательств проведение документа будет отменено.
			|Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОтменитьПроведениеПередЗаполнениемДО", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

