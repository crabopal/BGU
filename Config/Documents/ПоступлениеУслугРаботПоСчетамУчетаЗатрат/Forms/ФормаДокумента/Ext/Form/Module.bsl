		ТекущиеДанные["СубконтоЗатрат" + ТекущиеДанные.НомерСубконтоВидыЗатрат] = ТекущиеДанные.ВидЗатрат;
	КонецЕсли;
	Если ТекущиеДанные.НомерСубконтоНУВидыЗатрат <> 0 Тогда
		ТекущиеДанные["СубконтоЗатратНУ" + ТекущиеДанные.НомерСубконтоНУВидыЗатрат] = ТекущиеДанные.ВидЗатрат;
	КонецЕсли;
