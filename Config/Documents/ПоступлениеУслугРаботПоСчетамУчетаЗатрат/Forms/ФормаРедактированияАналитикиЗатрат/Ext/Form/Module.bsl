
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Заполним реквизиты формы из параметров.
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СписокРеквизитовДокумента());
	
	Организация = Параметры.Организация;
	ИФО 		= Параметры.ИФО;
	Дата 		= Параметры.Дата;
	
	НаименованиеНоменклатуры = "";
	Если ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		НаименованиеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Номенклатура, "Наименование");
	КонецЕсли;
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Аналитика затрат: %1'"), НаименованиеНоменклатуры);
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьОграниченияСчетов();
	УстановитьВидимостьСубконтоСчетаНаСервере(ИменаЭлементовСубконто("БУ"));
	УстановитьВидимостьСубконтоСчетаНаСервере(ИменаЭлементовСубконто("НУ"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И Не Отказ И Не ПроверитьЗаполнениеНаКлиенте() Тогда
			Отказ = Истина;
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(СписокРеквизитовДокумента());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтотОбъект);
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ФормаНастройкаОтраженияВУчете_Закрыть" И Источник = ВладелецФормы Тогда
		// Сообщение от основной формы документа при нажатии там Esc.
		// Сбрасываем флаг модифицированности и закрываем форму редактирования строки без вопросов.
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СчетЗатратПриИзменении(Элемент)
	УстановитьВидимостьСубконтоСчета(ИменаЭлементовСубконто("БУ"));
КонецПроцедуры

&НаКлиенте
Процедура СчетЗатратНУПриИзменении(Элемент)
	УстановитьВидимостьСубконтоСчета(ИменаЭлементовСубконто("НУ"));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОграниченияСчетов()
	ОграниченияСчетов = Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ОграниченияСчетов();
	ПараметрыВыбораБУ = Новый Массив;
	ПараметрыВыбораБУ.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов",
		ОграниченияСчетов.ОграниченияСписокСчетовБУ));
	ПараметрыВыбораБУ.Добавить(Новый ПараметрВыбора("НаДату", Дата));
	ПараметрыВыбораБУ.Добавить(Новый ПараметрВыбора("Организация", Организация));
	Элементы.СчетЗатрат.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораБУ);

	ПараметрыВыбораНУ = Новый Массив;
	ПараметрыВыбораНУ.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов",
		ОграниченияСчетов.ОграниченияСписокСчетовНУ));
	ПараметрыВыбораНУ.Добавить(Новый ПараметрВыбора("НаДату", Дата));
	ПараметрыВыбораНУ.Добавить(Новый ПараметрВыбора("Организация", Организация));
	Элементы.СчетЗатратНУ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораНУ);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСубконтоСчета(ИменаЭлементов)
	Если ЗначениеЗаполнено(ЭтотОбъект[ИменаЭлементов.СчетЗатрат]) Тогда
		УстановитьВидимостьСубконтоСчетаНаСервере(ИменаЭлементов);
	Иначе
		ОчиститьСубконтоСчета(ИменаЭлементов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСубконтоСчетаНаСервере(ИменаЭлементов)
	ДанныеСчета = Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
		.ДанныеСчетов(ЭтотОбъект[ИменаЭлементов.СчетЗатрат]).Получить(ЭтотОбъект[ИменаЭлементов.СчетЗатрат]);
	Если ДанныеСчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаголовкиСубконто = ЗаголовкиСубконто(ДанныеСчета);
	Для Индекс = 1 По 3 Цикл
		Элементы[ИменаЭлементов["Субконто" + Индекс]].Видимость = (Индекс <= ДанныеСчета.КоличествоСубконто);
		Элементы[ИменаЭлементов["Субконто" + Индекс]].Заголовок = ЗаголовкиСубконто.Получить(ДанныеСчета["ВидСубконто" + Индекс]);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗаголовкиСубконто(ДанныеСчета)
	Результат = Новый Соответствие;
	Если ДанныеСчета.КоличествоСубконто = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ИспользуемыеСубконто = Новый Массив;
	Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
		ИспользуемыеСубконто.Добавить(ДанныеСчета["ВидСубконто" + Индекс]);
	КонецЦикла;
	РеквизитыВидовСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ИспользуемыеСубконто, "Наименование");
	Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
		Результат.Вставить(ДанныеСчета["ВидСубконто" + Индекс], РеквизитыВидовСубконто[ДанныеСчета["ВидСубконто" + Индекс]]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОчиститьСубконтоСчета(ИменаЭлементов)
	Для Индекс = 1 По 3 Цикл
		ЭтотОбъект[ИменаЭлементов["Субконто" + Индекс]] = Неопределено;
		Элементы[ИменаЭлементов["Субконто" + Индекс]].Видимость = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИменаЭлементовСубконто(ВидУчета)
	Результат = Новый Структура;
	Если ВидУчета = "БУ" Тогда
		Результат.Вставить("СчетЗатрат", "СчетЗатрат");
		Результат.Вставить("Субконто1", "СубконтоЗатрат1");
		Результат.Вставить("Субконто2", "СубконтоЗатрат2");
		Результат.Вставить("Субконто3", "СубконтоЗатрат3");
	Иначе
		Результат.Вставить("СчетЗатрат", "СчетЗатратНУ");
		Результат.Вставить("Субконто1", "СубконтоЗатратНУ1");
		Результат.Вставить("Субконто2", "СубконтоЗатратНУ2");
		Результат.Вставить("Субконто3", "СубконтоЗатратНУ3");
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СписокРеквизитовДокумента()
	
	Возврат "КПС, КЭК, ПодразделениеЗатрат, ВидЗатрат,
		|СчетЗатрат, СубконтоЗатрат1, СубконтоЗатрат2, СубконтоЗатрат3,
		|СчетЗатратНУ, СубконтоЗатратНУ1, СубконтоЗатратНУ2, СубконтоЗатратНУ3";
	
КонецФункции

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
		ЭтотОбъект, Параметры.Организация, Параметры.Дата);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()
	
	Отказ = Ложь;
	
	// КПС
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'КПС'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КПС", "", Отказ);
	КонецЕсли;
	
	// КЭК
	Если НЕ ЗначениеЗаполнено(КЭК) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'КЭК'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КЭК", "", Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

#КонецОбласти
