// Выгрузить результат запроса в таблицу значений.
// 
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса
//  Таблица - ТаблицаЗначений
Процедура ВыгрузитьРезультатЗапросаВТаблицуЗначений(Выборка, Таблица)
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;
КонецПроцедуры

Функция ПериодОстатков(Объект, Модифицированность = Ложь)
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Возврат Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		Возврат Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
КонецФункции

#Область ЗаполнениеДокумента

// Заполнить по Поступлению услуг, работ (по счетам учета затрат).
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  ДокументОснование - ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  СтандартнаяОбработка - Булево
Процедура ЗаполнитьПоПоступлениюУслугРаботПоСчетамУчетаЗатратРезерв(Документ, ДокументОснование, СтандартнаяОбработка) Экспорт
	ВидОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ВидПоступления");
	Если ВидОснования <> Перечисления.ВидыОперацийПоступлениеУслуг.ПоступлениеУслугРезерв Тогда
		ВызватьИсключение "Заполнение на основании возможно только для вида операции ""Поступление услуг (резерв)""";
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Документ.ДокументОснование = ДокументОснование;
	Документ.ВидПоступления = Перечисления.ВидыОперацийПоступлениеУслуг.НачислениеОбязательствЗаСчетРезерва;	
	ЗаполнитьДокументПоОснованиюРезерв(Документ, ДокументОснование);
КонецПроцедуры

// Заполнить по Поступлению услуг, работ.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  ДокументОснование - ДокументСсылка.ПоступлениеУслугРабот
//  СтандартнаяОбработка - Булево
Процедура ЗаполнитьПоПоступлениюУслугРабот(Документ, ДокументОснование, СтандартнаяОбработка) Экспорт
	Аналитика40160 = АналитикаПроводки40160(ДокументОснование);
	Если Аналитика40160 = Неопределено Тогда
		ВызватьИсключение "Заполнение на основании возможно только для документов, формирующих резерв (счет 401.60)";
	КонецЕсли;
	КФОНУ = НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета();
	АналитикаБУ = Аналитика40160.БУ;
	АналитикаНУ = Аналитика40160.НУ;
	ЕстьАналитикаНУ = ЗначениеЗаполнено(АналитикаНУ.СчетЗатратНУ);
	СтандартнаяОбработка = Ложь;
	Документ.ДокументОснование = ДокументОснование;
	Документ.ВидПоступления = Перечисления.ВидыОперацийПоступлениеУслуг.НачислениеОбязательствЗаСчетРезерва;	
	ЗаполнитьДокументПоОснованиюРезерв(Документ, ДокументОснование);
	Документ.Резерв = АналитикаБУ.Резерв;
	Для Каждого Строка Из Документ.УслугиИРаботы Цикл
		ЗаполнитьЗначенияСвойств(Строка, АналитикаБУ);
		Если ЕстьАналитикаНУ И КФОНУ.Найти(Строка.КФО) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Строка, АналитикаНУ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заполняет указанный документ по договору, по которому указан предмет договора.
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат - заполняемый документ.
// 			 - см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
// 	ДоговорОснование - СправочникСсылка.Договоры - договор
// 	ЗаполнитьШапку - Булево - Признак необходимости заполнения шапки документа.
Процедура ЗаполнитьПоДоговору(Документ, ДоговорОснование, ЗаполнитьШапку = Ложь) Экспорт
	
	ТипыНоменклатуры = Новый Массив;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.УслугиАренды"));
	
	ПараметрыЗаполнения = РаботаСОбязательствами.ПараметрыПолученияОстатковНФАПоДоговору(Документ);
	ПараметрыЗаполнения.ПолучитьДанныеДоговора = ЗаполнитьШапку;
	ПараметрыЗаполнения.ДоговорОснование       = ДоговорОснование;
	ПараметрыЗаполнения.ТипыНоменклатуры       = ТипыНоменклатуры;

	ОстаткиНФАПоДоговору = РаботаСОбязательствами.ОстатокМЗУслугПоДоговору(ПараметрыЗаполнения);
	
	Если ОстаткиНФАПоДоговору = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполнитьШапку Тогда
		
		ЗаполнитьЗначенияСвойств(Документ, ОстаткиНФАПоДоговору.ДанныеДоговора);
		
		Документ.Договор            = ДоговорОснование;
		Документ.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Документ.СуммаВключаетНДС   = ИСТИНА;
		
	КонецЕсли;
	
	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", Документ.СуммаВключаетНДС);
	
	Для Каждого ОстатокТМЦ Из ОстаткиНФАПоДоговору.ОстаткиНФА Цикл
		
		НоваяСтрока = Документ.УслугиИРаботы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокТМЦ);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
		
	КонецЦикла;
	
	Документ.СуммаДокумента = Документ.УслугиИРаботы.Итог("Всего");
	
КонецПроцедуры

// Заполнить по остаткам авансов.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  Модифицированность - Булево - модифицированность формы
//  Отказ - Булево
//  
Процедура ЗаполнитьПоОстаткамАвансов(Объект, Знач Модифицированность = Ложь, Отказ = Ложь) Экспорт

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоВсемКФО", Истина);
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
	ПараметрыЗаполнения.Вставить("Дата",        Объект.Дата);
	ПараметрыЗаполнения.Вставить("Ссылка",      Объект.Ссылка);
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат"));
	Иначе
		ДокументОбъект = Объект;
	КонецЕсли;
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ДокументОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	Объект.ЗачетАвансов.Очистить();
	
	АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
		Новый Структура("ЭтоЗачетАванса", Истина));
	
	Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
		
		Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ЗачетАвансов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету, "КФО,КПС");
		
		НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
		НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(АвансКЗачету.СчетАвансов);
		НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполнить по электронному документу поставщика.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  ДанныеЗаполнения - ДокументСсылка.ЭлектронныйДокументПоставщика
//  СписокНоменклатуры - Неопределено, ТаблицаЗначений - Список номенклатуры
//  
Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(Объект, ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт

	ТребуемыеДанные = Новый Структура("ЗагруженИзЕИС, Организация, Контрагент, Договор, ВалютаДокумента,
		|СуммаВключаетНДС, ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента");
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, ТребуемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеОснования);
	
	ДатаПодписания = Дата(1,1,1);
	Если ДанныеОснования.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПодписания) Тогда
		Объект.Дата = ДатаПодписания;
	Иначе
		Объект.Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	Объект.ДатаПодписанияПервичногоДокумента = Объект.Дата;
	
	Объект.ДокументОснование = ДанныеЗаполнения;
	Объект.ВидПоступления = Перечисления.ВидыОперацийПоступлениеУслуг.ПоступлениеУслуг;
	Объект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	
	Если ТипЗнч(СписокНоменклатуры) <> Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(
			Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеУслугРабот, Объект.ДокументОснование);
	КонецЕсли;
	СписокНоменклатурыУслугБезКоличества =
		ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыУслугРаботБезКоличестваЭДПоставщика(
		Объект.ДокументОснование);
	
	НоменклатураДокумента = СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НоменклатураДокумента,
		СписокНоменклатурыУслугБезКоличества.ВыгрузитьКолонку("Номенклатура"));
	ЕдиницыИзмененияНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НоменклатураДокумента, "ЕдиницаИзмерения");
	
	Объект.УслугиИРаботы.Очистить();	
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 3 Тогда 
			НоваяСтрока = Объект.УслугиИРаботы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницыИзмененияНоменклатуры.Получить(НоваяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из СписокНоменклатурыУслугБезКоличества Цикл
		НоваяСтрока = Объект.УслугиИРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.ЕдиницаИзмерения = ЕдиницыИзмененияНоменклатуры.Получить(НоваяСтрока.Номенклатура);
	КонецЦикла;	
	
	Объект.СуммаДокумента = Объект.УслугиИРаботы.Итог("Всего");
	
КонецПроцедуры	

// Заполнить по начислению контрагентам ГИС ГМП
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  ДанныеЗаполнения - ДокументСсылка.НачислениеКонтрагентамГИСГМП
//  СписокНоменклатуры - Неопределено, ТаблицаЗначений - Список номенклатуры
//  СтандартнаяОбработка - Булево
//  
Процедура ЗаполнитьПоНачислениеКонтрагентамГИСГМП(Объект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	ТребуемыеРеквизиты = Новый Структура("Организация, ИННПолучателя, КПППолучателя, СуммаДокумента");
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, ТребуемыеРеквизиты);
	
	Если НЕ ЗначениеЗаполнено(ДанныеОснования.Организация) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Объект.Организация = ДанныеОснования.Организация;
	ТекПолучатель = Неопределено;
	ЭлектронныеДокументыБГУ.СсылкаНаОбъектПоИННКПП("Контрагенты",
		ДанныеОснования.ИННПолучателя,
		ДанныеОснования.КПППолучателя,
		ТекПолучатель,
		ТекущаяДатаСеанса());	
	Объект.Контрагент = ТекПолучатель;
	Объект.ДокументОснование = ДанныеЗаполнения;
	
	СтрТЧ = Объект.УслугиИРаботы.Добавить();
	СтрТЧ.Сумма = ДанныеОснования.СуммаДокумента;

КонецПроцедуры

// Заполнить денежные обязательства.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  Модифицированность - Булево - модифицированность формы
//  
Процедура ЗаполнитьДенежныеОбязательства(Объект, Знач Модифицированность = Ложь) Экспорт
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат"));
	Иначе
		ДокументОбъект = Объект;
	КонецЕсли;
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	
КонецПроцедуры

// Заполнить отложенные обязательства по остаткам.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  		
Процедура ЗаполнитьОтложенныеОбязательстваПоОстаткам(Объект) Экспорт
	
	Объект.ОтложенныеОбязательства.Очистить();
	
	Запрос = Новый Запрос;
	
	
КонецПроцедуры

// Заполнить отложенные обязательства по услугам.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		- см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  		
Процедура ЗаполнитьОтложенныеОбязательстваПоУслугамРаботам(Объект) Экспорт
	
	Объект.ОтложенныеОбязательства.Очистить();
	
	Таблица = Объект.УслугиИРаботы.Выгрузить(,
		"КФО, КПС, КЭК, Сумма, СуммаНДС, Всего, СуммаРезерв, СуммаНДСРезерв, ВсегоРезерв");
	Таблица.Свернуть("КФО, КПС, КЭК", "Сумма, СуммаНДС, Всего, СуммаРезерв, СуммаНДСРезерв, ВсегоРезерв");
	
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Объект.ОтложенныеОбязательства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Сумма = Строка.Всего;
		НоваяСтрока.СуммаРезерв = Строка.ВсегоРезерв;
	КонецЦикла;
	
КонецПроцедуры

// Аналитика проводки40160.
// 
// Параметры:
//  ПроверяемыйДокумент - ДокументСсылка.ПоступлениеУслугРабот - Проверяемый документ
// 
// Возвращаемое значение:
//  Неопределено - 
//  Структура:
//   * БУ - Структура:
//    ** СчетЗатрат - ПланСчетовСсылка.ЕПСБУ
//    ** СубконтоЗатрат1 - Характеристика.ВидыСубконто
//    ** СубконтоЗатрат2 - Характеристика.ВидыСубконто
//    ** СубконтоЗатрат3 - Характеристика.ВидыСубконто
//   * НУ - Структура:
//    ** СчетЗатратНУ - ПланСчетовСсылка.ЕПСБУ
//    ** СубконтоЗатратНУ1 - Характеристика.ВидыСубконто
//    ** СубконтоЗатратНУ2 - Характеристика.ВидыСубконто
//    ** СубконтоЗатратНУ3 - Характеристика.ВидыСубконто
Функция АналитикаПроводки40160(ПроверяемыйДокумент)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счета40160", БухгалтерскийУчет.СписокСчетов("401.60"));
	Запрос.УстановитьПараметр("Регистратор", ПроверяемыйДокумент);
	КодыСчетовНУ = ОграниченияСчетов().ОграниченияСписокСчетовНУ;
	СчетаНУ = БухгалтерскийУчет.СписокСчетов(СтрСоединить(КодыСчетовНУ, ","));
	Запрос.УстановитьПараметр("СчетаНУ", СчетаНУ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУ.СчетДт КАК СчетЗатрат,
	|	ЖурналПроводокЕПСБУ.СубконтоДт1 КАК СубконтоЗатрат1,
	|	ЖурналПроводокЕПСБУ.СубконтоДт2 КАК СубконтоЗатрат2,
	|	ЖурналПроводокЕПСБУ.СубконтоДт3 КАК СубконтоЗатрат3,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУ.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт1 КАК Справочник.Резервы)
	|		КОГДА ЖурналПроводокЕПСБУ.СубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт2 КАК Справочник.Резервы)
	|		КОГДА ЖурналПроводокЕПСБУ.СубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт3 КАК Справочник.Резервы)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Резервы.ПустаяСсылка)
	|	КОНЕЦ КАК Резерв
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Регистратор
	|	И СчетКт В (&Счета40160),, 1) КАК ЖурналПроводокЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУ.СчетДт КАК СчетЗатратНУ,
	|	ЖурналПроводокЕПСБУ.СубконтоДт1 КАК СубконтоЗатратНУ1,
	|	ЖурналПроводокЕПСБУ.СубконтоДт2 КАК СубконтоЗатратНУ2,
	|	ЖурналПроводокЕПСБУ.СубконтоДт3 КАК СубконтоЗатратНУ3,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУ.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт1 КАК Справочник.Резервы)
	|		КОГДА ЖурналПроводокЕПСБУ.СубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт2 КАК Справочник.Резервы)
	|		КОГДА ЖурналПроводокЕПСБУ.СубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.СубконтоКт3 КАК Справочник.Резервы)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Резервы.ПустаяСсылка)
	|	КОНЕЦ КАК Резерв
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Регистратор
	|	И СчетДт В (&СчетаНУ),, 1) КАК ЖурналПроводокЕПСБУ";
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если РезультатЗапроса[0].Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТаблицаБУ = РезультатЗапроса[0].Выгрузить();
	ТаблицаНУ = РезультатЗапроса[1].Выгрузить();
	
	АналитикаПроводок = Новый Структура;
	АналитикаПроводок.Вставить("БУ", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаБУ[0]));
	Если ТаблицаНУ.Количество() = 1 Тогда
		АналитикаПроводок.Вставить("НУ", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаНУ[0]));
	Иначе
		АналитикаПроводок.Вставить("НУ", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаНУ.Добавить()));
	КонецЕсли;
	
	Возврат АналитикаПроводок;
КонецФункции

// Заполнить по акту приемки товаров работ услуг.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеУслугРабот
//           - см. Документ.ПоступлениеУслугРабот.Форма.ФормаДокумента.Объект
//  АктПриемкиТРУ - ДокументСсылка.АктПриемкиТоваровРаботУслуг
Процедура ЗаполнитьПоАктуПриемкиТоваровРаботУслуг(Документ, АктПриемкиТРУ) Экспорт
	
	ДанныеАктаПриемкиТРУ = Документы.АктПриемкиТоваровРаботУслуг.ДанныеАктаПриемкиДляВводаПоступленияНФА(АктПриемкиТРУ);
	
	ШапкаАктаПриемки = ДанныеАктаПриемкиТРУ.Шапка;
	Документ.Дата = ШапкаАктаПриемки.Дата;
	Документ.Организация = ШапкаАктаПриемки.Организация;
	Документ.ИФО = ШапкаАктаПриемки.ИФО;
	Документ.Подразделение = ШапкаАктаПриемки.Подразделение;
	Документ.Контрагент = ШапкаАктаПриемки.Контрагент;
	Документ.Договор = ШапкаАктаПриемки.Договор;
	Документ.ВалютаДокумента = ШапкаАктаПриемки.ВалютаДокумента;
	
	Документ.УслугиИРаботы.Очистить();
	ПараметрыРасчетаНДС = Новый Структура("СуммаВключаетНДС", Истина);
	
	Для Каждого СтрокаАктаПриемки Из ДанныеАктаПриемкиТРУ.ТоварыРаботыУслуги Цикл
		НоваяСтрока = Документ.УслугиИРаботы.Добавить();
		НоваяСтрока.Номенклатура = СтрокаАктаПриемки.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = СтрокаАктаПриемки.ЕдиницаИзмерения;
		НоваяСтрока.СтавкаНДС = СтрокаАктаПриемки.СтавкаНДС;
		Если СтрокаАктаПриемки.КоличествоПринято <> СтрокаАктаПриемки.Количество Тогда
			НоваяСтрока.Количество = СтрокаАктаПриемки.КоличествоПринято;
			НоваяСтрока.Сумма = СтрокаАктаПриемки.СуммаПринято;
			// В "Акте приемки товаров, работ, услуг" НДС не включен в сумму,
			// но в "Сумма принято" - включен. Поэтому при пересчете сначала выделяется НДС из "суммы принято",
			// а потом повторно пересчитывается сумма.
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
			НоваяСтрока.Сумма = НоваяСтрока.Всего - НоваяСтрока.СуммаНДС;
		Иначе
			НоваяСтрока.Количество = СтрокаАктаПриемки.Количество;
			НоваяСтрока.Сумма = СтрокаАктаПриемки.Сумма;
			НоваяСтрока.СуммаНДС = СтрокаАктаПриемки.СуммаНДС;
			НоваяСтрока.Всего = СтрокаАктаПриемки.Всего;
		КонецЕсли;
		НоваяСтрока.Содержание = СтрокаАктаПриемки.Содержание;
		НоваяСтрока.КПС = СтрокаАктаПриемки.КПС;
		НоваяСтрока.КЭК = СтрокаАктаПриемки.КЭК;
		НоваяСтрока.КФО = СтрокаАктаПриемки.КФО;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Акт об оказании услуг / УПД");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);

	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
