// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица проводок, которые будут сформированы
//  ДокументОбъект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат - Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура - Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - ТаблицаЗначений - Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка - Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращаемое значение:
//  Булево - флаг успешного выполнения. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	Карточки = Новый Соответствие;
	Для Каждого СтрокаУслуг Из ДокументОбъект.УслугиИРаботы Цикл
		Если СтрокаУслуг.ОтразитьВКарточкеКапвложений
				И ЗначениеЗаполнено(СтрокаУслуг.КарточкаКапвложений)
				И Карточки.Получить(СтрокаУслуг.КарточкаКапвложений) = Неопределено Тогда

			НоваяСтрока = ТабДвижений.Добавить();
			НоваяСтрока.КарточкаКапвложений = СтрокаУслуг.КарточкаКапвложений;
			Карточки.Вставить(СтрокаУслуг.КарточкаКапвложений, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ТабДвижений.ЗаполнитьЗначения(ДокументОбъект.Организация, "Организация");
	ТабДвижений.ЗаполнитьЗначения(ДокументОбъект.Дата, "Период");
	
	Возврат Истина;
КонецФункции	

// Формирует таблицу источника данных "Поступление услуг, работ" 
// по документу "Поступление услуг, работ (по счетам учета затрат)".
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  		 - ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//  Параметры - см. ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ТаблицаПоступлениеУслугРаботПоДокументу.Параметры
// 
// Возвращаемое значение:
//  см. ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ТаблицаПоступлениеУслугРаботПоДокументу
Функция ТаблицаПоступлениеУслугРаботПоДокументу(Документ, Параметры) Экспорт
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		Возврат Документ.ТаблицаПоступлениеУслугРаботПоДокументу(Параметры);
	Иначе
		Возврат ТаблицаПоступлениеУслугРаботПоСсылке(Документ, Параметры);
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаПоступлениеУслугРаботПоСсылке(Документ, Параметры)
	
	Запрос = ЗапросТаблицаПоступлениеУслугРаботПоСсылке(Документ);
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	ПерваяСтрока = ТаблицаДокумента[0];
	Дата = ПерваяСтрока.Дата;
	Организация = ПерваяСтрока.Организация;
	ИФО = ПерваяСтрока.ИФО;
	ОтражатьВНалоговомУчете = НалоговыйУчет.ПлательщикНалогаНаПрибыль(Организация, Дата);
	КФОНУ = НалоговыйУчет.ПолучитьМассивКФОдляНалоговогоУчета();

	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
		Дата, Организация, ИФО);
	// При поступлении нужно анализировать переданный групповой счет, чтобы понимать
	// это от поставщика или подотчетника
	СчетРасчетовИзПараметров = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры,
		"СчетРасчетов",
		ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ЭтоСчет208 = ЗначениеЗаполнено(СчетРасчетовИзПараметров)
		И БухгалтерскийУчет.СчетВИерархии(СчетРасчетовИзПараметров, "208.00");
	ИспользуемыйСчет = ?(ЭтоСчет208, "208.00", "302.00");
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();

	ЗаполнятьСчетРасчетовВТаблице = Ложь;
	Если Не ЭтоСчет208 И ЗначениеЗаполнено(СчетРасчетов) Тогда
		ТаблицаДокумента.ЗаполнитьЗначения(СчетРасчетов, "СчетРасчетов");
	Иначе
		ЗаполнятьСчетРасчетовВТаблице = Истина;
	КонецЕсли;

	СчетаРасчетовПоКЭК = Новый Соответствие;
	Для Каждого Строка Из ТаблицаДокумента Цикл
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(Строка.Валюта) Тогда
			Строка.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗаполнятьСчетРасчетовВТаблице Тогда
			Строка.СчетРасчетов = СчетаРасчетовПоКЭК.Получить(Строка.КЭК);
			Если Не ЗначениеЗаполнено(Строка.СчетРасчетов) Тогда
				Строка.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					Строка.КЭК,
					ИспользуемыйСчет, ,
					Дата, Организация, ИФО);
				СчетаРасчетовПоКЭК.Вставить(Строка.КЭК, Строка.СчетРасчетов);
			КонецЕсли;
		КонецЕсли;
		
		Строка.ОтражатьВНалоговомУчете = ОтражатьВНалоговомУчете
			И КФОНУ.Найти(Строка.КФО) <> Неопределено;
		
	КонецЦикла;
	Возврат ТаблицаДокумента;
КонецФункции

Функция ЗапросТаблицаПоступлениеУслугРаботПоСсылке(Документ)
