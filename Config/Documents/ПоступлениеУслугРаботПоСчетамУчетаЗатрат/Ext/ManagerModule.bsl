Функция ОграниченияСчетов() Экспорт
	МетаданныеДокумента = Метаданные.НайтиПоТипу(Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат"));
	РеквизитыТаблицы = МетаданныеДокумента.ТабличныеЧасти.УслугиИРаботы.Реквизиты;
	
	Результат = Новый Структура;
	СписокСчетовБУ = Новый Массив;
	Для Каждого Ограничение Из РеквизитыТаблицы.СчетЗатрат.ПараметрыВыбора Цикл
		Если Ограничение.Имя = "ОграниченияСписокСчетов" Тогда
			СписокСчетовБУ = Новый Массив(Ограничение.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ОграниченияСписокСчетовБУ", Новый ФиксированныйМассив(СписокСчетовБУ));
	
	СписокСчетовНУ = Новый Массив;
	Для Каждого Ограничение Из РеквизитыТаблицы.СчетЗатратНУ.ПараметрыВыбора Цикл
		Если Ограничение.Имя = "ОграниченияСписокСчетов" Тогда
			СписокСчетовНУ = Новый Массив(Ограничение.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ОграниченияСписокСчетовНУ", Новый ФиксированныйМассив(СписокСчетовНУ));
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеСчетов(Знач Счета) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто1.Обязательный, ЛОЖЬ) КАК СубконтоОбязательный1,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто2.Обязательный, ЛОЖЬ) КАК СубконтоОбязательный2,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто3.Обязательный, ЛОЖЬ) КАК СубконтоОбязательный3,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто1.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) КАК ВидСубконто1,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто2.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) КАК ВидСубконто2,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто3.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) КАК ВидСубконто3,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто3.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА 3
	|		КОГДА ЕПСБУВидыСубконто2.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА 2
	|		КОГДА ЕПСБУВидыСубконто1.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоСубконто,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА 1
	|		КОГДА ЕПСБУВидыСубконто2.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА 2
	|		КОГДА ЕПСБУВидыСубконто3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерСубконтоВидыЗатрат
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто1.Ссылка
	|		И ЕПСБУВидыСубконто1.НомерСтроки = 1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто2.Ссылка
	|		И ЕПСБУВидыСубконто2.НомерСтроки = 2
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто3.Ссылка
	|		И ЕПСБУВидыСубконто3.НомерСтроки = 3
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Счета)";
	Запрос.УстановитьПараметр("Счета", Счета);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСчета = СтруктураДанныхСчета();
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
		Результат.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция СтруктураДанныхСчета()
	Результат = Новый Структура;
	Результат.Вставить("УчетПоПодразделениям", Ложь);
	Результат.Вставить("СубконтоОбязательный1", Ложь);
	Результат.Вставить("СубконтоОбязательный2", Ложь);
	Результат.Вставить("СубконтоОбязательный3", Ложь);
	Результат.Вставить("ВидСубконто1", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка"));
	Результат.Вставить("ВидСубконто2", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка"));
	Результат.Вставить("ВидСубконто3", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка"));
	Результат.Вставить("КоличествоСубконто", 0);
	Результат.Вставить("НомерСубконтоВидыЗатрат", 0);
	Возврат Результат;
КонецФункции

Функция ВсеСчета106ОС() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|	ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|		И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	|ГДЕ
	|	ЕПСБУ.Код ПОДОБНО ""106.%""
	|	И НЕ ЕПСБУ.ПометкаУдаления
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Заполнить документ по основанию при начислении обязательств за счет резерва.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//         - см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  ДокументОснование - ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат, ДокументСсылка.ПоступлениеУслугРабот -
Процедура ЗаполнитьДокументПоОснованиюРезерв(Объект, ДокументОснование) Экспорт
	
	// Получить данные
	ДанныеОснования = ДанныеДокументаОснования(ДокументОснование);
	
	Если ДанныеОснования.Шапка.Количество() = 0 Тогда
		ВызватьИсключение(НСтр("ru = 'Данные документа-основания не получены.'"));
	КонецЕсли;

	// Шапка
	ЗаполнитьЗначенияСвойств(Объект, ДанныеОснования.Шапка[0]);
	Если Не ЗначениеЗаполнено(Объект.СпособЗачетаАванса) Тогда
		Объект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	КонецЕсли;
	
	ПринятьНДСКВычетуУказываетсяШапке = Не ДанныеОснования.Шапка[0].ПринятьНДСКВычетуУказываетсяВСтроках;
	ПринятьНДСКВычету = ДанныеОснования.Шапка[0].ПринятьНДСКВычету;
	ПараметрыРасчетаСтроки = УправлениеНФАКлиентСервер.ПараметрыРасчетаСтрокиДокумента();
	ПараметрыРасчетаСтроки.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	// Услуги и работы
	Объект.УслугиИРаботы.Очистить();
	Для Каждого СтрокаОснования Из ДанныеОснования.ТоварыРаботыУслуги Цикл
		НоваяСтрока = Объект.УслугиИРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования);
		Если ПринятьНДСКВычетуУказываетсяШапке Тогда
			НоваяСтрока.ПринятьНДСКВычетуРезерв = ПринятьНДСКВычету;
		Иначе
			НоваяСтрока.ПринятьНДСКВычетуРезерв = СтрокаОснования.ПринятьНДСКВычету;
		КонецЕсли;
		НоваяСтрока.НДСКРаспределениюРезерв = СтрокаОснования.НДСКРаспределению;
		
		НоваяСтрока.Количество = НоваяСтрока.КоличествоРезерв;
		НоваяСтрока.Сумма = НоваяСтрока.СуммаРезерв;
		Если НоваяСтрока.СтавкаНДСРезерв = СтрокаОснования.НоменклатураСтавкаНДС Тогда
			НоваяСтрока.СтавкаНДС = НоваяСтрока.СтавкаНДСРезерв;
			НоваяСтрока.СуммаНДС = НоваяСтрока.СуммаНДСРезерв;
			НоваяСтрока.Всего = НоваяСтрока.ВсегоРезерв;
		Иначе
			Если ЗначениеЗаполнено(СтрокаОснования.НоменклатураСтавкаНДС) Тогда
				НоваяСтрока.СтавкаНДС = СтрокаОснования.НоменклатураСтавкаНДС;
			Иначе
				НоваяСтрока.СтавкаНДС = НоваяСтрока.СтавкаНДСРезерв;
			КонецЕсли;
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "СтавкаНДС", ПараметрыРасчетаСтроки);
			
		КонецЕсли;
	КонецЦикла;
	
	// Денежные обязательства
	ЗаполнитьДенежныеОбязательства(Объект);
	
	// Отложенные обязательства
	ЗаполнитьОтложенныеОбязательстваПоУслугамРаботам(Объект);
	
КонецПроцедуры

// Заполнить отложенные обязательства.
// 
// Параметры:
//  Объект - ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат
//         - см. Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Форма.ФормаДокумента.Объект
//  Модифицированность - Булево - Модифицированность
Процедура ЗаполнитьОтложенныеОбязательства(Объект, Модифицированность = Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОтложенныеОбязательства();
	Запрос.УстановитьПараметр("Период", ПериодОстатков(Объект, Модифицированность));
	Счет50299 = БухгалтерскийУчет.СчетПоКоду("502.99", Объект.Дата, Объект.Организация);
	Запрос.УстановитьПараметр("СчетОбязательств", Счет50299);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	
	ТаблицаДокумента = Объект.УслугиИРаботы.Выгрузить();
	ТаблицаДокумента.Свернуть("КПС, КЭК, КФО", "Сумма");
	Запрос.УстановитьПараметр("ДанныеДокумента", ТаблицаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Объект.ОтложенныеОбязательства.Очистить();
	ВыгрузитьРезультатЗапросаВТаблицуЗначений(Выборка, Объект.ОтложенныеОбязательства); 
КонецПроцедуры

Функция ТекстЗапросаОтложенныеОбязательства()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КЭК,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК СуммаРезерв
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет = &СчетОбязательств,, Организация = &Организация
	|	И ИФО = &ИФО
	|	И Субконто2 = &Договор) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокумента.КПС,
	|	ДанныеДокумента.КЭК,
	|	ДанныеДокумента.КФО,
	|	ДанныеДокумента.Сумма
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	&ДанныеДокумента КАК ДанныеДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПС,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭК,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ОбязательстваДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Ссылка
	|	И СчетКт = &СчетОбязательств,,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокумента.КПС,
	|	ДанныеДокумента.КЭК,
	|	ДанныеДокумента.КФО,
	|	ДанныеДокумента.Сумма,
	|	Остатки.СуммаРезерв,
	|	ОбязательстваДокумента.Сумма КАК СуммаДвижений
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.КПС,
	|		ВложенныйЗапрос.КЭК,
	|		ВложенныйЗапрос.КФО,
	|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
	|	ИЗ
	|		ДанныеДокумента КАК ВложенныйЗапрос
	|	СГРУППИРОВАТЬ ПО
	|		ВложенныйЗапрос.КПС,
	|		ВложенныйЗапрос.КЭК,
	|		ВложенныйЗапрос.КФО) КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ДанныеДокумента.КПС = Остатки.КПС
	|		И ДанныеДокумента.КЭК = Остатки.КЭК
	|		И ДанныеДокумента.КФО = Остатки.КФО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбязательстваДокумента КАК ОбязательстваДокумента
	|		ПО ДанныеДокумента.КПС = ОбязательстваДокумента.КПС
	|		И ДанныеДокумента.КЭК = ОбязательстваДокумента.КЭК
	|		И ДанныеДокумента.КФО = ОбязательстваДокумента.КФО";
КонецФункции

// Данные документа основания.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат, ДокументСсылка.ПоступлениеУслугРабот -
// 
// Возвращаемое значение:
//  Структура - Данные документа основания:
// * Шапка - см. ТаблицаДанныеШапки
// * ТоварыРаботыУслуги - см. ТаблицаДанныеТоварыРаботыУслуги 
Функция ДанныеДокументаОснования(ДокументОснование)

	ТекстЗапроса = "";
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		ТекстЗапроса = ТекстЗапросаПоОснованиюПоступлениеУслугРабот();
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		ТекстЗапроса = ТекстЗапросаПоОснованиюПоступлениеУслугРаботПоСчетамУчетаЗатрат();
	Иначе
		ВызватьИсключение(НСтр("ru = 'Не правильный тип документа-основания'"),
			КатегорияОшибки.ОшибкаИспользованияВстроенногоЯзыка);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", ТаблицаДанныеШапки());
	Результат.Вставить("ТоварыРаботыУслуги", ТаблицаДанныеТоварыРаботыУслуги());
	
	ВыгрузитьРезультатЗапросаВТаблицуЗначений(РезультатЗапроса[0].Выбрать(), Результат.Шапка);
	ВыгрузитьРезультатЗапросаВТаблицуЗначений(РезультатЗапроса[1].Выбрать(), Результат.ТоварыРаботыУслуги);
	
	Возврат Результат;
	
КонецФункции

