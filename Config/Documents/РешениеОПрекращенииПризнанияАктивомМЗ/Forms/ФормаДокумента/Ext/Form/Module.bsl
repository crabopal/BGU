&НаСервереБезКонтекста
Функция ДанныеДокументаИнвентаризации(Документ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Инвентаризация.КФО КАК КФО,
	|	Инвентаризация.Счет КАК Счет,
	|	Инвентаризация.Ссылка.Счет КАК СчетУчета
	|ИЗ
	|	Документ.ИнвентаризацияМЗ.Материалы КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Ссылка В(&Ссылка)
	|	И (Инвентаризация.КоличествоНеСоответствует <> 0
	|			ИЛИ Инвентаризация.СуммаНеСоответствует <> 0)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокКФО = Новый Массив;
	СписокСчетов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КФО) И СписокКФО.Найти(Выборка.КФО) = Неопределено Тогда
			СписокКФО.Добавить(Выборка.КФО);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Счет) И СписокКФО.Найти(Выборка.Счет) = Неопределено Тогда
			СписокСчетов.Добавить(Выборка.Счет);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	Результат.Вставить("СчетУчета", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Если СписокКФО.Количество() = 1 Тогда
		Результат.КФО = СписокКФО[0];
	КонецЕсли;
	Если СписокСчетов.Количество() = 1 Тогда
		Результат.СчетУчета = СписокСчетов[0];
	ИначеЕсли СписокСчетов.Количество() > 1 Тогда
		Результат.СчетУчета = Выборка.СчетУчета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКЭШПараметровФормыЛокальныеСчета()
	
	Период = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	
	СчетаОтбор = Новый СписокЗначений;
	СчетаОтбор.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("105.00,09", Период,, Объект.Организация));
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетаОтбор", СчетаОтбор);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет09", БухгалтерскийУчет.СчетПоКоду("09", Период, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет02_4", БухгалтерскийУчет.СчетПоКоду("02.4", Период, Объект.Организация));
	
	ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Объект.Организация, Ложь);
	ПараметрыДанныхСчетов.ДатаСчета = Период;
	ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
	
	ВидыДопАналитики = Новый Соответствие;
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		Если ЗначениеЗаполнено(ДанныеСчета.ДополнительноеСубконто) Тогда
			ВидыДопАналитики.Вставить(ДанныеСчета.ТекущийСчет, ДанныеСчета.ДополнительноеСубконто);
		КонецЕсли;
	КонецЦикла;

	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидыДопАналитики", ВидыДопАналитики);
	
КонецПроцедуры

