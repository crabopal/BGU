	ВсеДопустимыеТипы.Добавить(Тип("ДокументСсылка.ИнвентаризацияМЗ"));
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьОграничениеТиповОснования_Решение0510440(
		Форма, ВсеДопустимыеТипы);
