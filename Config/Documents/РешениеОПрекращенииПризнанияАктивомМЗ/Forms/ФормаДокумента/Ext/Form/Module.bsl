&НаКлиенте
Процедура ОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументУжеВыбран = Объект.Основание.НайтиСтроки(Новый Структура("ДокументИнвентаризации", ВыбранноеЗначение)).Количество() > 0;
	
	Если Не ДокументУжеВыбран Тогда
		НоваяСтрока = Объект.Основание.Добавить();
		НоваяСтрока.ДокументИнвентаризации = ВыбранноеЗначение;
		
		ДанныеДокумента = ДанныеДокументаИнвентаризации(ВыбранноеЗначение);
		НоваяСтрока.КФО			= ДанныеДокумента.КФО;
		НоваяСтрока.СчетУчета	= ДанныеДокумента.СчетУчета;
		Если Объект.Основание.Количество() = 1 Тогда
			УстановитьОграниченияПоВидуОснования(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеДокументИнвентаризацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Основание.ТекущиеДанные;
	
	ДанныеДокумента = ДанныеДокументаИнвентаризации(ТекущиеДанные.ДокументИнвентаризации);
	ТекущиеДанные.КФО		= ДанныеДокумента.КФО;
	ТекущиеДанные.СчетУчета	= ДанныеДокумента.СчетУчета;
	УстановитьОграниченияПоВидуОснования(ЭтотОбъект);
	
КонецПроцедуры

