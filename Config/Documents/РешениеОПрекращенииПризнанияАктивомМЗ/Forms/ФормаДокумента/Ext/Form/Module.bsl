&НаСервере
Процедура УправлениеЭлементамиГолосования()
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	Если Объект.Аннулирован Или (Объект.Проведен И НЕ Объект.Резервировать) Тогда
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		РешениеСотрудникаМодифицированность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	ПараметрыОбработки.ТолькоБалансовые = Ложь;
	
	Если Строка.СчетУчета = Форма.КэшПараметров.Локальные.Счет09 Тогда
		ПараметрыОбработки.ИмяРеквизитаЕстьДополнительноеСубконто = "ЕстьДополнительноеСубконтоОС";
		ПараметрыОбработки.ИмяРеквизитаДополнительнаяАналиткаВидСубконто = "ДополнительнаяАналиткаОСВидСубконто";
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
		ЗаполнитьЗначенияСвойств(Строка, ПолучитьСтруктуруДанныхДопАналитик024(Форма));
	Иначе
		Если Строка.ЕстьДополнительноеСубконтоОС Тогда
			Строка.ЕстьДополнительноеСубконтоОС = Ложь;
			Строка.ДополнительнаяАналиткаОСВидСубконто = Неопределено;
		КонецЕсли;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруДанныхДопАналитик024(Форма)
	
	ЛокальныеПараметрыФормы = Форма.КэшПараметров.Локальные;
	
	ВидСубконтоДопАналитики02_4 = ЛокальныеПараметрыФормы.ВидыДопАналитики.Получить(ЛокальныеПараметрыФормы.Счет02_4);
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ДополнительнаяАналиткаВидСубконто", ВидСубконтоДопАналитики02_4);
	СтруктураЗаполнения.Вставить("ЕстьДополнительноеСубконто", ЗначениеЗаполнено(ВидСубконтоДопАналитики02_4)); 
	
	Возврат СтруктураЗаполнения;

КонецФункции

