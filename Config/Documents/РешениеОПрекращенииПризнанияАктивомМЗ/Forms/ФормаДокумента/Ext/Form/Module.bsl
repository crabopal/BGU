&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Элементы = Форма.Элементы;
	ДопустимыйВидОснования = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВыбранныйВидОснования_Решение0510440(
		Форма.Объект);
	ВидимостьКоманды0510466 = (ДопустимыйВидОснования = Неопределено
		Или ДопустимыйВидОснования = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОснованиеПодборОснования0510466",
		"Видимость", ВидимостьКоманды0510466);
	ВидимостьКоманды0504087 = (ДопустимыйВидОснования = Неопределено
		Или ДопустимыйВидОснования = Тип("ДокументСсылка.ИнвентаризацияМЗ"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОснованиеПодборОснования0504087",
		"Видимость", ВидимостьКоманды0504087);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СотрудникЦМО(ЦМО)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМО, "Сотрудник");
КонецФункции

&НаКлиенте
Функция ОтборДляПодбораОснований(ВыбраннаяФорма)
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	
	Если ВыбраннаяФорма = "ИнвентаризацияМЗ" Тогда
	 	Отбор.Вставить("Счет", ЭтотОбъект.КэшПараметров.Локальные.СчетаОтбор.ВыгрузитьЗначения());
		Если ЗначениеЗаполнено(Объект.ЦМО) Тогда
			Отбор.Вставить("ЦМО", Объект.ЦМО);
		КонецЕсли;
	ИначеЕсли ВыбраннаяФорма = "ИнвентаризационнаяОписьНФА" Тогда
		Если ЗначениеЗаполнено(Объект.ЦМО) Тогда
		 	Отбор.Вставить("МОЛ", СотрудникЦМО(Объект.ЦМО));
		КонецЕсли;
	КонецЕсли;
	Возврат Отбор;
КонецФункции

&НаКлиенте
Функция ПараметрыФормыПодбора(ВыбраннаяФорма)
	Отбор = ОтборДляПодбораОснований(ВыбраннаяФорма);
	ПараметрыФормы = Новый Структура("Отбор,ЗакрыватьПриВыборе", Отбор, Ложь);
	ПараметрыФормы.Вставить("ПустойСчетУчета", Истина);
	Возврат ПараметрыФормы;
КонецФункции

&НаКлиенте
Процедура ОткрытьПодборОснования(ВыбраннаяФорма)
	ПараметрыПодбора = УправлениеМатериальнымиЗапасамиФормыКлиент.ПараметрыПодбораОснования_Решение0510440();
	ПараметрыПодбора.ИмяТипаДокумента = ВыбраннаяФорма;
	ПараметрыПодбора.ПараметрыФормы = ПараметрыФормыПодбора(ВыбраннаяФорма);
	ПараметрыПодбора.ЭлементФормы = Элементы.Основание;

	ПараметрыПодбора.ПроверяемыеРеквизиты.Добавить("ЦМО,МОЛ/Место хранения");
	
	УправлениеМатериальнымиЗапасамиФормыКлиент.ОткрытьПодборОснования_Решение0510440(ЭтотОбъект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель",
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		#Если НаКлиенте Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель""'"));			
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры

