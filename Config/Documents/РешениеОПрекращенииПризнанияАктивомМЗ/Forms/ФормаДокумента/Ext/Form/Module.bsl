	УстановитьДанныеДинамическихКолонокДопАналитикаОС();
	
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокДопАналитикаОС()

	ЛокальныеПараметрыФормы = ЭтотОбъект.КэшПараметров.Локальные;
	
	ОтборПоСчету = Новый Структура("СчетУчета", ЛокальныеПараметрыФормы.Счет09);
	
	СтрокиОС = Объект.Материалы.НайтиСтроки(ОтборПоСчету);
	Если СтрокиОС.Количество() Тогда
		
		ВидСубконтоДопАналитики09 = ЛокальныеПараметрыФормы.ВидыДопАналитики.Получить(ЛокальныеПараметрыФормы.Счет09);
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("ДополнительнаяАналиткаОСВидСубконто", ВидСубконтоДопАналитики09);
		СтруктураЗаполнения.Вставить("ЕстьДополнительноеСубконтоОС", ЗначениеЗаполнено(ВидСубконтоДопАналитики09));
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(СтруктураЗаполнения, ПолучитьСтруктуруДанныхДопАналитик024(ЭтотОбъект));
		
		Для Каждого СтрокаОС Из СтрокиОС Цикл
			ЗаполнитьЗначенияСвойств(СтрокаОС, СтруктураЗаполнения);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация,
			Объект.Дата,
			Объект.Организация);
	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;

	Если Не ТребуетсяВызовСервера 
		И Не ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		УстановитьРуководителя(Объект);
		
	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		УстановитьРуководителя(Объект);
		ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.ОбработатьИзменениеПримененияДетальногоКЭК340и440(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Дата,
		ЭтотОбъект.КэшПараметров.Организация);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьРеквизитыЛокальногоАкта();
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии 
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМЗНаСервере()
	
	ДокОснования = Объект.Основание.Выгрузить().ВыгрузитьКолонку("ДокументИнвентаризации");
	Документы.РешениеОПрекращенииПризнанияАктивомМЗ.ЗаполнитьПоИнвентаризации(ДокОснования, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект, "Материалы", Истина);
	
	// Решение сотрудника.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Использование = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
	ЭлементУО.Отбор,
	"Объект.Материалы.ЕстьДополнительноеСубконтоОС",
	Ложь,
	ВидСравненияКомпоновкиДанных.Равно);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	ПолеТаблицы = ЭлементУО.Поля.Элементы.Добавить();
	ПолеТаблицы.Поле = Новый ПолеКомпоновкиДанных("МатериалыДополнительнаяАналитикаОС");
	ПолеТаблицы.Использование = Истина;
	
КонецПроцедуры

