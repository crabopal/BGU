	|	ДатаСчетаФактуры								КАК ДатаСчетаФактуры,
	|	Контрагент										КАК Контрагент,
	|	Договор											КАК Договор,
	|	Договор.ТипДоговораНДС							КАК ТипДоговораНДС,
	|	ОбъектНалогообложения							КАК ОбъектНалогообложения,
	|	ДатаДокументаОснования							КАК ДатаДокументаОснования,
	|	КФО												КАК КФО,
	|	ПричинаНалогообложения							КАК ПричинаНалогообложения,
	|	ВидЦенности										КАК ВидЦенности,
	|	КПССчетРасчетов									КАК КПССчетРасчетов,
	|	СчетРасчетов									КАК СчетРасчетов,
	|	СчетКредита										КАК СчетКредита,
	|	СтавкаНДС										КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА СчетРасчетов В(&Счета205хА) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			ОбъектНалогообложения
	|	КОНЕЦ											КАК ДокументРасчетов,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|	СУММА(СуммаБезНДС)								КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)									КАК СуммаНДС,
	|	СУММА(СуммаБезНДС + СуммаНДС)					КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)						КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)							КАК СуммаНДСВалютная,
	|	СУММА(СуммаБезНДСВалютная + СуммаНДСВалютная)	КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаАвансыПолученныеПредъявленныеКомиссионером
	|	И СуммаБезНДС >= 0
	|	И СуммаНДС >= 0
	|	И СуммаБезНДСВалютная >= 0
	|	И СуммаНДСВалютная >= 0
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	Договор.ТипДоговораНДС,
	|	ОбъектНалогообложения,
	|	ДатаДокументаОснования,
	|	КФО,
	|	ПричинаНалогообложения,
	|	ВидЦенности,
	|	КПССчетРасчетов,
	|	СчетРасчетов,
	|	СчетКредита,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА СчетРасчетов В(&Счета205хА) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			ОбъектНалогообложения
	|	КОНЕЦ,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокументаОснования,
	|	ОбъектНалогообложения,
	|	ДатаСчетаФактуры
	|;";
	
	РезультатыЗапроса = ЗапросОстатки.ВыполнитьПакет();
	
	ТаблицаПокупка				= РезультатыЗапроса[1].Выгрузить();
	ТаблицаАвансыПолученные		= РезультатыЗапроса[2].Выгрузить();
	ТаблицаНДСНалоговогоАгента	= РезультатыЗапроса[3].Выгрузить();
	ТаблицаСМРХозСпособом		= РезультатыЗапроса[4].Выгрузить();
	ТаблицаТаможня				= РезультатыЗапроса[5].Выгрузить();
	
	РезультатыЗаполнения = Новый Структура();
	
	Если ЗаполнитьЗакладку.Покупка Тогда
		
		// [7]. Объекты вложений
		ОбъектыВложений = РезультатыЗапроса[7].Выгрузить().ВыгрузитьКолонку("ОбъектВложений");
		
		// [8]. Дата самого раннего документа поступления ОС
		Выборка = РезультатыЗапроса[8].Выбрать();
		
		ДатаНачалаОборотов = Неопределено;
		
		Пока Выборка.Следующий() Цикл
			ДатаНачалаОборотов = Выборка["ДатаДокумента"];
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ДатаНачалаОборотов) Тогда
			ДатаНачалаОборотов = Неопределено;
		КонецЕсли;
		
		ТаблицаПокупка = ПолучитьТаблицуПокупка(
			ТаблицаПокупка,
			ШапкаДокумента["Организация"],
			ОбъектыВложений, 
			ДатаНачалаОборотов,
			НастройкиЧтенияОстатков.ДатаОстатков);
			
		ТаблицаПокупка = УчетНДС.ТрансформироватьТаблицуСКолонкамиНДС_ИзОбщих_ВИндивидуальные(ТаблицаПокупка);
		
		ЗаполнитьКодыВидовОпераций(ТаблицаПокупка, "Покупка");
		
		МассивСчетовФактур = ТаблицаПокупка.ВыгрузитьКолонку("СчетФактура");
		
		УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаПокупка, МассивСчетовФактур);
		
		РезультатыЗаполнения.Вставить("Покупка", ТаблицаПокупка);
		
	КонецЕсли;
	
	ТаблицаАвансыПолученныеПредъявленныеКомиссионером = РезультатыЗапроса[9].Выгрузить();
	
	Если ЗаполнитьЗакладку.АвансыПолученные Тогда
		СчетаФактурыНаОтгрузку = УчетНДС.НовыйТаблицаДокументовСчетаФактурыНаОтгрузку();
		
		ТаблицаЗачтенныеАвансы = УчетНДС.РазбитьПоДатамЗачетаАвансаПолученного(ТаблицаАвансыПолученные, ШапкаДокумента,,, СчетаФактурыНаОтгрузку);
		
		Если ТаблицаЗачтенныеАвансы.Количество() > 0 Тогда
			ЗаполнитьКодыВидовОпераций(ТаблицаЗачтенныеАвансы, "АвансыПолученные");
			
			МассивСчетовФактур = ТаблицаЗачтенныеАвансы.ВыгрузитьКолонку("СчетФактура");
			
			УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаЗачтенныеАвансы, МассивСчетовФактур);
		КонецЕсли;
		
		ТаблицаЗачтенныеАвансы.Колонки.Добавить("ПоУчету", Новый ОписаниеТипов("Булево"));
		ТаблицаЗачтенныеАвансы.ЗаполнитьЗначения("Истина", "ПоУчету");
		
		РезультатыЗаполнения.Вставить("АвансыПолученные", ТаблицаЗачтенныеАвансы);
		
		РезультатыЗаполнения.Вставить("СчетаФактурыНаОтгрузку", СчетаФактурыНаОтгрузку);
	КонецЕсли;
	
	Если ЗаполнитьЗакладку.АвансыПолученныеПредъявленныеКомиссионером И ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугЧерезКомиссионеров") Тогда
		
		АвансыКомиссионера = Истина;
		
		ТаблицаЗачтенныеАвансы = УчетНДС.РазбитьПоДатамЗачетаАвансаПолученного(ТаблицаАвансыПолученныеПредъявленныеКомиссионером, ШапкаДокумента, АвансыКомиссионера);
		
		Если ТаблицаЗачтенныеАвансы.Количество() > 0 Тогда
			ЗаполнитьКодыВидовОпераций(ТаблицаЗачтенныеАвансы, "АвансыПолученныеПредъявленныеКомиссионером");
			
			МассивСчетовФактур = ТаблицаЗачтенныеАвансы.ВыгрузитьКолонку("СчетФактура");
			
			УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаЗачтенныеАвансы, МассивСчетовФактур);
		КонецЕсли;
		
		ТаблицаЗачтенныеАвансы.Колонки.Добавить("ПоУчету", Новый ОписаниеТипов("Булево"));
		ТаблицаЗачтенныеАвансы.ЗаполнитьЗначения("Истина", "ПоУчету");
		
		РезультатыЗаполнения.Вставить("АвансыПолученныеПредъявленныеКомиссионером", ТаблицаЗачтенныеАвансы);
		
	КонецЕсли;
	
	Если ЗаполнитьЗакладку.НДСНалоговогоАгента Тогда
		
		ЗаполнитьКодыВидовОпераций(ТаблицаНДСНалоговогоАгента, "НДСНалоговогоАгента");
		
		МассивСчетовФактур = ТаблицаНДСНалоговогоАгента.ВыгрузитьКолонку("СчетФактура");
		
		УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаНДСНалоговогоАгента, МассивСчетовФактур);
		
		РезультатыЗаполнения.Вставить("НДСНалоговогоАгента", ТаблицаНДСНалоговогоАгента);
		
	КонецЕсли;
	
	Если ЗаполнитьЗакладку.СМРХозспособом Тогда
		
		ЗаполнитьКодыВидовОпераций(ТаблицаСМРХозСпособом, "СМРХозспособом");
		
		МассивСчетовФактур = ТаблицаСМРХозСпособом.ВыгрузитьКолонку("СчетФактура");
		
		УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаСМРХозСпособом, МассивСчетовФактур);
		
		РезультатыЗаполнения.Вставить("СМРХозспособом", ТаблицаСМРХозСпособом);
		
	КонецЕсли;
	
	Если ЗаполнитьЗакладку.ТаможенныйНДС Тогда
		
		// [7]. Объекты вложений
		ОбъектыВложений = РезультатыЗапроса[7].Выгрузить().ВыгрузитьКолонку("ОбъектВложений");
		
		// [8]. Дата самого раннего документа поступления ОС
		Выборка = РезультатыЗапроса[8].Выбрать();
		
		ДатаНачалаОборотов = Неопределено;
		
		Пока Выборка.Следующий() Цикл
			ДатаНачалаОборотов = Выборка["ДатаДокумента"];
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ДатаНачалаОборотов) Тогда
			ДатаНачалаОборотов = Неопределено;
		КонецЕсли;
		
		ТаблицаПокупка = ПолучитьТаблицуПокупка(
			ТаблицаТаможня,
			ШапкаДокумента["Организация"],
			ОбъектыВложений, 
			ДатаНачалаОборотов,
			НастройкиЧтенияОстатков.ДатаОстатков);
			
		ЗаполнитьКолонкиВсегоТаможенныйНДС(ТаблицаПокупка);
		
		ЗаполнитьКодыВидовОпераций(ТаблицаПокупка, "ТаможенныйНДС");
		
		МассивСчетовФактур = ТаблицаПокупка.ВыгрузитьКолонку("СчетФактура");
		
		УчетНДС.ЗаполнитьКолонкиДопЛиста(ТаблицаПокупка, МассивСчетовФактур);
		
		РезультатыЗаполнения.Вставить("ТаможенныйНДС", ТаблицаПокупка);
		
	КонецЕсли;
	
	ИменаИсключений = Новый Массив();
	ИменаИсключений.Добавить("СчетаФактурыНаОтгрузку");
	
	ЗаполнитьКолонкуКПС30304(РезультатыЗаполнения, ШапкаДокумента, ИменаИсключений);
	
	ПоместитьВоВременноеХранилище(РезультатыЗаполнения, АдресРезультата);
	
КонецПроцедуры

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	НастройкиЧтенияОстатков = ПолучитьНастройкиЧтенияОстатков(ДокументОбъект);
	
	ЗапросОстатки = ИнициализироватьЗапрос_Остатки_ВходящийНДС(ДокументОбъект, НастройкиЧтенияОстатков);
	
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборСчетФактура",			НастройкиЧтенияОстатков.ИспользоватьОтбор.СчетФактура);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборОбъектНалогообложения",	НастройкиЧтенияОстатков.ИспользоватьОтбор.ОбъектНалогообложения);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборКФО",					НастройкиЧтенияОстатков.ИспользоватьОтбор.КФО);
	ЗапросОстатки.УстановитьПараметр("ОтборСчетФактура",						НастройкиЧтенияОстатков.Отбор.СчетФактура);
	ЗапросОстатки.УстановитьПараметр("ОтборОбъектНалогообложения",				НастройкиЧтенияОстатков.Отбор.ОбъектНалогообложения);
