#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ШапкаДокумента				= ПараметрыПроцедуры["ШапкаДокумента"];
	ЗаполняемыеТабличныеЧасти	= ПараметрыПроцедуры["ЗаполняемыеТабличныеЧасти"];
	
	ДатаОкончанияИгнорированияДокументовРасчетов = УчетНДС.ПолучитьДатуОкончанияИгнорированияДокументовРасчетов(ШапкаДокумента["Организация"]);
	
	СтруктураСчетовАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	
	Счета205хА = СтруктураСчетовАвансов["МассивСчетов"];
	
	ЗаполнитьЗакладку = Новый Структура();
	ЗаполнитьЗакладку.Вставить("Покупка",				ЗаполняемыеТабличныеЧасти.Свойство("Покупка"));
	ЗаполнитьЗакладку.Вставить("АвансыПолученные",		ЗаполняемыеТабличныеЧасти.Свойство("АвансыПолученные"));
	ЗаполнитьЗакладку.Вставить("НДСНалоговогоАгента",	ЗаполняемыеТабличныеЧасти.Свойство("НДСНалоговогоАгента"));
	ЗаполнитьЗакладку.Вставить("СМРХозспособом",		ЗаполняемыеТабличныеЧасти.Свойство("СМРХозспособом"));
	ЗаполнитьЗакладку.Вставить("ТаможенныйНДС",			ЗаполняемыеТабличныеЧасти.Свойство("ТаможенныйНДС"));
	ЗаполнитьЗакладку.Вставить("АвансыПолученныеПредъявленныеКомиссионером",	ЗаполняемыеТабличныеЧасти.Свойство("АвансыПолученныеПредъявленныеКомиссионером"));
	
	НастройкиЧтенияОстатков = ПолучитьНастройкиЧтенияОстатков(ШапкаДокумента, ЗаполнитьЗакладку);
	
	// Настраиваем запрос
	ЗапросОстатки = ИнициализироватьЗапрос_Остатки_ВходящийНДС(ШапкаДокумента, НастройкиЧтенияОстатков);
	
	ЗапросОстатки.УстановитьПараметр("Счета205хА", Счета205хА);
	ЗапросОстатки.УстановитьПараметр("ДатаОкончанияИгнорированияДокументовРасчетов", ДатаОкончанияИгнорированияДокументовРасчетов);
	
	ЗапросОстатки.Текст = ЗапросОстатки.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для закладки ""Покупка""
	|//
	|ВЫБРАТЬ
	|	СчетФактура					КАК СчетФактура,
	|	ДатаСчетаФактуры			КАК ДатаСчетаФактуры,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	Договор.ТипДоговораНДС		КАК ТипДоговораНДС,
	|	ОбъектНалогообложения		КАК ОбъектНалогообложения,
	|	ДатаДокументаОснования		КАК ДатаДокументаОснования,
	|	КФО							КАК КФО,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВидЦенности					КАК ВидЦенности,
	|	КПССчетРасчетов				КАК КПССчетРасчетов,
	|	СчетРасчетов				КАК СчетРасчетов,
	|	СчетКредита					КАК СчетКредита,
	|	СтавкаНДС					КАК СтавкаНДС,
	|	СУММА(СуммаБезНДС)			КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)				КАК СуммаНДС,
	|	СУММА(СуммаБезНДСВалютная)	КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)		КАК СуммаНДСВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаПокупка
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	Договор.ТипДоговораНДС,
	|	ОбъектНалогообложения,
	|	ДатаДокументаОснования,
	|	КФО,
	|	ПричинаНалогообложения,
	|	ВидЦенности,
	|	КПССчетРасчетов,
	|	СчетРасчетов,
	|	СчетКредита,
	|	СтавкаНДС
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для закладки ""Авансы полученные""
	|//
	|ВЫБРАТЬ
	|	СчетФактура										КАК СчетФактура,
	|	ДатаСчетаФактуры								КАК ДатаСчетаФактуры,
	|	Контрагент										КАК Контрагент,
	|	Договор											КАК Договор,
	|	Договор.ТипДоговораНДС							КАК ТипДоговораНДС,
	|	ОбъектНалогообложения							КАК ОбъектНалогообложения,
	|	ДатаДокументаОснования							КАК ДатаДокументаОснования,
	|	КФО												КАК КФО,
	|	ПричинаНалогообложения							КАК ПричинаНалогообложения,
	|	ВидЦенности										КАК ВидЦенности,
	|	КПССчетРасчетов									КАК КПССчетРасчетов,
	|	СчетРасчетов									КАК СчетРасчетов,
	|	СчетКредита										КАК СчетКредита,
	|	СтавкаНДС										КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА СчетРасчетов В(&Счета205хА) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			ОбъектНалогообложения
	|	КОНЕЦ											КАК ДокументРасчетов,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|	СУММА(СуммаБезНДС)								КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)									КАК СуммаНДС,
	|	СУММА(СуммаБезНДС + СуммаНДС)					КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)						КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)							КАК СуммаНДСВалютная,
	|	СУММА(СуммаБезНДСВалютная + СуммаНДСВалютная)	КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаАвансыПолученные
	|	И СуммаБезНДС >= 0
	|	И СуммаНДС >= 0
	|	И СуммаБезНДСВалютная >= 0
	|	И СуммаНДСВалютная >= 0
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	Договор.ТипДоговораНДС,
	|	ОбъектНалогообложения,
	|	ДатаДокументаОснования,
	|	КФО,
	|	ПричинаНалогообложения,
	|	ВидЦенности,
	|	КПССчетРасчетов,
	|	СчетРасчетов,
	|	СчетКредита,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА СчетРасчетов В(&Счета205хА) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			ОбъектНалогообложения
	|	КОНЕЦ,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокументаОснования,
	|	ОбъектНалогообложения,
	|	ДатаСчетаФактуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для закладки ""НДС налогового агента""
	|//
	|ВЫБРАТЬ
	|	СчетФактура										КАК СчетФактура,
	|	ДатаСчетаФактуры								КАК ДатаСчетаФактуры,
	|	Контрагент										КАК Контрагент,
	|	Договор											КАК Договор,
	|	Договор.ТипДоговораНДС							КАК ТипДоговораНДС,
	|	СчетКредита										КАК СчетКредита,
	|	СчетРасчетов									КАК СчетРасчетов,
	|	КПССчетРасчетов									КАК КПССчетРасчетов,
	|	ОбъектНалогообложения							КАК ОбъектНалогообложения,
	|	ВидЦенности										КАК ВидЦенности,
	|	КФО												КАК КФО,
	|	СтавкаНДС										КАК СтавкаНДС,
	|	ИСТИНА											КАК ПоУчету,
	|	СУММА(СуммаБезНДС)								КАК Сумма,
	|	СУММА(СуммаНДС)									КАК СуммаНДС,
	|	СУММА(СуммаБезНДС + СуммаНДС)					КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)						КАК СуммаВалютная,
	|	СУММА(СуммаНДСВалютная)							КАК СуммаНДСВалютная,
	|	СУММА(СуммаБезНДСВалютная + СуммаНДСВалютная)	КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаНДСНалоговогоАгента
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	Договор.ТипДоговораНДС,
	|	СчетКредита,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	ОбъектНалогообложения,
	|	ВидЦенности,
	|	КФО,
	|	СтавкаНДС,
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	СчетФактура,
	|	ОбъектНалогообложения,
	|	КПССчетРасчетов,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для закладки ""СМР хоз. способом""
	|//
	|ВЫБРАТЬ
	|	СчетФактура										КАК СчетФактура,
	|	ДатаСчетаФактуры								КАК ДатаСчетаФактуры,
	|	СчетКредита										КАК СчетКредита,
	|	ОбъектНалогообложения							КАК ОбъектНалогообложения,
	|	КПССчетРасчетов									КАК КПССчетРасчетов,
	|	ВидЦенности										КАК ВидЦенности,
	|	КФО												КАК КФО,
	|	СтавкаНДС										КАК СтавкаНДС,
	|	ИСТИНА											КАК ПоУчету,
	|	СУММА(СуммаБезНДС)								КАК Сумма,
	|	СУММА(СуммаНДС)									КАК СуммаНДС,
	|	СУММА(СуммаБезНДС + СуммаНДС)					КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)						КАК СуммаВалютная,
	|	СУММА(СуммаНДСВалютная)							КАК СуммаНДСВалютная,
	|	СУММА(СуммаБезНДСВалютная + СуммаНДСВалютная)	КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаСМРХозСпособом
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	СчетКредита,
	|	ОбъектНалогообложения,
	|	КПССчетРасчетов,
	|	ВидЦенности,
	|	КФО,
	|	СтавкаНДС,
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры,
	|	СчетФактура,
	|	ОбъектНалогообложения,
	|	КПССчетРасчетов,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для закладки Таможня
	|//
	|ВЫБРАТЬ
	|	СчетФактура					КАК СчетФактура,
	|	ДатаСчетаФактуры			КАК ДатаСчетаФактуры,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	Договор.ТипДоговораНДС		КАК ТипДоговораНДС,
	|	ОбъектНалогообложения		КАК ОбъектНалогообложения,
	|	ДатаДокументаОснования		КАК ДатаДокументаОснования,
	|	КФО							КАК КФО,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВидЦенности					КАК ВидЦенности,
	|	КПССчетРасчетов				КАК КПССчетРасчетов,
