		КонецЕсли;
		
		УчетНДС.ПереименоватьКолонки(ТаблицаДвижений, Переименование, "вперед");
		
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["ДополнительныеЛистыКнигиПокупок"], ТаблицаДвижений, Истина);
	КонецЕсли;
	
	//---
	// КнигаПродаж
	//---
	Если ТаблицаТЧ_ОсновнойРазделКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ОсновнойРазделКниги,
			ТаблицаОстатки_ДляКнигиПродаж,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "АвансыПолученные" ИЛИ ИмяТЧ = "АвансыПолученныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["КнигаПродаж"], ТаблицаДвижений, Истина);
	КонецЕсли;
	
	//---
	// ДополнительныеЛистыКнигиПродаж
	//---
	Если ТаблицаТЧ_ДополнительныеЛистыКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ДополнительныеЛистыКниги,
			ТаблицаОстатки_ДляКнигиПродаж,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "АвансыПолученные" ИЛИ ИмяТЧ = "АвансыПолученныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["ДополнительныеЛистыКнигиПродаж"], ТаблицаДвижений, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДвиженияСчетаФактурыНаОтгрузкуДляКнигиПокупок(ТаблицыДляДвижений, ДокументОбъект)
	
	ТаблицаДвижений = РегистрыНакопления.СчетаФактурыНаОтгрузкуДляКнигиПокупок.СоздатьНаборЗаписей().Выгрузить();
	
	ПоискАвансов = Новый Структура("ИдентификаторСтроки");
	
	Для Каждого СтрокаСФНаОтгрузку Из ДокументОбъект.СчетаФактурыНаОтгрузку Цикл
		ЗаполнитьЗначенияСвойств(ПоискАвансов, СтрокаСФНаОтгрузку);
		
		МассивСтрок = ДокументОбъект.АвансыПолученные.НайтиСтроки(ПоискАвансов);
		
		// Все найденные строки таблицы авансов имеют совпадающие поля СчетФактура, ДатаЗачета.
		СтрокаАванса = МассивСтрок[0];
		
		Если Не ЗначениеЗаполнено(СтрокаАванса.СчетФактура) Тогда
			Продолжить;
		КонецЕсли;
		
		// Значение поля КорректируемыйПериод может различаться.
		СписокКорректируемыхПериодов = ПолучитьСписокРазличныхКорректируемыхПериодов(МассивСтрок);
		
		Для Каждого КорректируемыйПериод Из СписокКорректируемыхПериодов Цикл
			ДобавитьДвижениеСчетаФактурыНаОтгрузкуДляКнигиПокупок(ТаблицаДвижений, ДокументОбъект,
				СтрокаАванса, СтрокаСФНаОтгрузку, КорректируемыйПериод);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаДвижений.Свернуть("Период,Активность,"
		+ "Организация,СчетФактураНаАванс,ДатаЗачета,КорректируемыйПериод,"
		+ "СчетФактураНаОтгрузку,НомерСчетаФактуры,ДатаСчетаФактуры");
	
	ТаблицыДляДвижений.Вставить("СчетаФактурыНаОтгрузкуДляКнигиПокупок", ТаблицаДвижений);
	
КонецПроцедуры

Функция ПолучитьСписокРазличныхКорректируемыхПериодов(МассивСтрокАвансыПолученные)
	
	ПустаяДата = '00010101';
	
	СписокЗначений = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из МассивСтрокАвансыПолученные Цикл
		Если СтрокаТаблицы.ЗаписьДопЛиста Тогда
			КорректируемыйПериод = СтрокаТаблицы.КорректируемыйПериод;
		Иначе
			КорректируемыйПериод = ПустаяДата;
		КонецЕсли;
		
		Если СписокЗначений.Найти(КорректируемыйПериод) = Неопределено Тогда
			СписокЗначений.Добавить(КорректируемыйПериод);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

Процедура ДобавитьДвижениеСчетаФактурыНаОтгрузкуДляКнигиПокупок(ТаблицаДвижений, ДокументОбъект,
		СтрокаАванса, СтрокаСФНаОтгрузку, КорректируемыйПериод)
	
	НоваяСтрока = ТаблицаДвижений.Добавить();
	
	НоваяСтрока.Период					= ДокументОбъект.Дата;
	НоваяСтрока.Активность				= Истина;
	НоваяСтрока.Организация				= ДокументОбъект.Организация;
	НоваяСтрока.СчетФактураНаАванс		= СтрокаАванса.СчетФактура;
	НоваяСтрока.ДатаЗачета				= СтрокаАванса.ДатаЗачета;
	НоваяСтрока.КорректируемыйПериод	= КорректируемыйПериод;
	
	НоваяСтрока.СчетФактураНаОтгрузку	= СтрокаСФНаОтгрузку.СчетФактура;
	НоваяСтрока.НомерСчетаФактуры		= СтрокаСФНаОтгрузку.Номер;
	НоваяСтрока.ДатаСчетаФактуры		= СтрокаСФНаОтгрузку.Дата;
	
КонецПроцедуры

Процедура ЗаполнитьКодыВидовОпераций(ЗаполняемаяТаблица, ИмяТабличнойЧасти)
	
	// Для различных строк табличной части могут установиться различные коды видов операций
	
	ЗаполняемаяТаблица.Колонки.Добавить("КодВидаОперации", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(2)));
	
	ОсновныеПараметры = Новый Структура();
	ОсновныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"ФормированиеЗаписейКнигиПокупок");
	ОсновныеПараметры.Вставить("ИмяТабличнойЧасти",			ИмяТабличнойЧасти);
	
	ОсновныеПараметры.Вставить("Контрагент",				Неопределено);
	ОсновныеПараметры.Вставить("Договор",					Неопределено);
	ОсновныеПараметры.Вставить("ТипДоговораНДС",			Неопределено);
	
	Для Каждого СтрокаТаблицы Из ЗаполняемаяТаблица Цикл
		ЗаполнитьЗначенияСвойств(ОсновныеПараметры, СтрокаТаблицы);
		ОсновныеПараметры.Вставить("ДокументОснование", СтрокаТаблицы["СчетФактура"]);
		
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(ОсновныеПараметры);
		
		СтрокаТаблицы["КодВидаОперации"] = КодВидаОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуКПС30304(РезультатыЗаполнения, ШапкаДокумента, ИменаИсключений = Неопределено)
	
	СчетаФактуры = Новый Массив();
	
	Для Каждого Элемент Из РезультатыЗаполнения Цикл
		ИмяТЧ = Элемент.Ключ;
		
		Если ТипЗнч(ИменаИсключений) = Тип("Массив") И ИменаИсключений.Найти(ИмяТЧ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТЧ = Элемент.Значение;
		
		Если ТЧ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТЧ.Колонки.Найти("КПС30304") = Неопределено Тогда
			ТЧ.Колонки.Добавить("КПС30304", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаФактуры, ТЧ.ВыгрузитьКолонку("СчетФактура"));
	КонецЦикла;
	
	Если СчетаФактуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКПС = ПолучитьТаблицуКПС30304(СчетаФактуры);
	
	ПоляПоиска = "СчетФактура";
	
	Поиск = Новый Структура(ПоляПоиска);
	
	ТаблицаКПС.Индексы.Добавить(ПоляПоиска);
	
	Для Каждого Элемент Из РезультатыЗаполнения Цикл
		ИмяТЧ = Элемент.Ключ;
		
		Если ТипЗнч(ИменаИсключений) = Тип("Массив") И ИменаИсключений.Найти(ИмяТЧ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТЧ = Элемент.Значение;
		
		Для Каждого СтрокаТЧ Из ТЧ Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТЧ);
			
			МассивСтрок = ТаблицаКПС.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТЧ["КПС30304"] = МассивСтрок[0]["КПС30304"];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнитьПустыеКПС30304ПоРабочемуПлануСчетов(РезультатыЗаполнения, ШапкаДокумента, ИменаИсключений);
	
КонецПроцедуры

Функция ПолучитьТаблицуКПС30304(СчетаФактуры)
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("КПС_30304");
	ИменаРеквизитов.Добавить("КПС30304");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",		СчетаФактуры);
	ЗапросПоиск.УстановитьПараметр("ИменаРеквизитов",	ИменаРеквизитов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Актуальные типовые операции
	|//
	|ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ТиповыеОперацииСчетФактураПолученный
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|		ПО	ТиповыеОперации.ИдентификаторДокумента = ИдентификаторыОбъектовМетаданных.Ссылка
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = ""Документ.СчетФактураПолученный""
	|	И НЕ ТиповыеОперации.ПометкаУдаления
	|	И НЕ ТиповыеОперации.НеИспользуется
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Реквизиты актуальных типовых операций
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	РеквизитыТиповыхОперацийСчетФактураПолученный
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций
	|ГДЕ
	|	Владелец В(
	|		ВЫБРАТЬ
	|			Ссылка
	|		ИЗ
	|			ТиповыеОперацииСчетФактураПолученный)
	|	И ИмяДляФормулы В(&ИменаРеквизитов)
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Одно значение КПС для каждого счета-фактуры
	|//
	|// Из документов СчетФактураПолученный
	|ВЫБРАТЬ
	|	ЗначенияДополнительныхРеквизитовОпераций.Объект		КАК СчетФактура,
	|	ЗначенияДополнительныхРеквизитовОпераций.Значение	КАК КПС30304
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеквизитыТиповыхОперацийСчетФактураПолученный
	|		ПО	ЗначенияДополнительныхРеквизитовОпераций.Объект В(&МассивСсылок)
	|		И	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = РеквизитыТиповыхОперацийСчетФактураПолученный.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Из документов СчетФактураВыданный
	|ВЫБРАТЬ
	|	Ссылка				КАК СчетФактура,
	|	МАКСИМУМ(КПС30304)	КАК КПС30304
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И КПС30304 <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьПустыеКПС30304ПоРабочемуПлануСчетов(РезультатыЗаполнения, ШапкаДокумента, ИменаИсключений)
	
	// Если для какого-то счета-фактуры КПС 303.04 оказался незаполненным,
	// то определим КПС по рабочему плану счетов.
	// Дату и КФО для такого определения возьмем из уже заполненных табличных частей.
	
	Организация = ШапкаДокумента["Организация"];
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ИФО = ШапкаДокумента["ИФО"];
	Иначе
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	
	ОписаниеТаблицы = Новый Структура();
	ОписаниеТаблицы.Вставить("ИмяКолонкиДата",	"ДатаСчетаФактуры");
	ОписаниеТаблицы.Вставить("ИмяКолонкиКФО",	"КФО");
	ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",	"КПС30304");
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("СторонаПроводки",				"Дт");
	ПараметрыЗаполнения.Вставить("Организация",					Организация);
	ПараметрыЗаполнения.Вставить("Счет",						БухгалтерскийУчет.СчетПоКоду("303.04"));
	ПараметрыЗаполнения.Вставить("ИФО",							ИФО);
	ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",			Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Истина);
	
	Для Каждого Элемент Из РезультатыЗаполнения Цикл
		ИмяТЧ = Элемент.Ключ;
		
		Если ТипЗнч(ИменаИсключений) = Тип("Массив") И ИменаИсключений.Найти(ИмяТЧ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТЧ = Элемент.Значение;
		
		Если ТЧ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск = Новый Структура("КПС30304", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
		
		МассивСтрок = ТЧ.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТЧ, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицуПокупка(ОстаткиДляТаблицыПокупка, Организация, ОбъектыВложений, ДатаНачалаОборотов, ДатаОстатков)
	
	ТаблицаПокупка = ОстаткиДляТаблицыПокупка;
	
	ТаблицаПокупка.Колонки.Добавить("ДатаПринятияКУчету", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	ДатыДокументов = ТаблицаПокупка.ВыгрузитьКолонку("ДатаСчетаФактуры");
	
	ТаблицаПокупка.ЗагрузитьКолонку(ДатыДокументов, "ДатаПринятияКУчету");
	
	КолонкиГруппировок = "
		|КФО,
		|ДатаСчетаФактуры,
		|СчетФактура,
		|ВидЦенности,
		|Контрагент,
		|ДатаПринятияКУчету,
		|ОбъектНалогообложения,
		|СчетРасчетов,
		|КПССчетРасчетов,
		|СтавкаНДС,
		|СчетКредита";
	
	КолонкиСуммирования = "
		|СуммаБезНДС,
		|СуммаНДС,
		|СуммаБезНДСВалютная,
		|СуммаНДСВалютная";
	
	ТаблицаПокупка.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ТаблицаПокупка.Сортировать("ДатаПринятияКУчету,ДатаСчетаФактуры,СчетФактура,ОбъектНалогообложения,СчетРасчетов,КПССчетРасчетов,КФО");
	
	ТаблицаПокупка.Колонки.Добавить("ПоУчету", Новый ОписаниеТипов("Булево"));
	ТаблицаПокупка.ЗаполнитьЗначения(Истина, "ПоУчету");
	
	Возврат ТаблицаПокупка;
	
КонецФункции

Процедура ЗаполнитьКолонкиВсегоТаможенныйНДС(Таблица)
	
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	
	Таблица.Колонки.Добавить("Всего",			ТипЧисло);
	Таблица.Колонки.Добавить("ВсегоВалютная",	ТипЧисло);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы["Всего"]			= СтрокаТаблицы["СуммаБезНДС"]			+ СтрокаТаблицы["СуммаНДС"];
		СтрокаТаблицы["ВсегоВалютная"]	= СтрокаТаблицы["СуммаБезНДСВалютная"]	+ СтрокаТаблицы["СуммаНДСВалютная"];
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
