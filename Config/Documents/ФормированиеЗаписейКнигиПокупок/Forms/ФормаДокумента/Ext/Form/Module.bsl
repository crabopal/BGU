		|Покупка,
		|АвансыПолученные,
		|АвансыПолученныеПредъявленныеКомиссионером,
		|НДСНалоговогоАгента,
		|СМРХозспособом,
		|ТаможенныйНДС");
	
	Для Каждого Элемент Из ИменаТаблиц Цикл
		ИмяТаблицы = Элемент.Ключ;
		
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
