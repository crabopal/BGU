#Область ДокументыСчетовФактурНаОтгрузкуГрафа7аКнигиПокупок

&НаКлиенте
Процедура ПроверитьИОткрытьФормуСчетаФактурыНаОтгрузку()
	
	Перем Отказ;
	
	ТекДанные = Элементы.АвансыПолученные.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьПередОткрытиемФормыСчетаФактурыНаОтгрузку(ТекДанные, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуДокументовСчетовФактурНаОтгрузку(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПередОткрытиемФормыСчетаФактурыНаОтгрузку(ТекДанные, Отказ)
	
	Отказ = Ложь;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗаполнениеПоляСтрокиТабличнойЧасти(ТекДанные, "СчетФактура", НСтр("ru='Счет-фактура на аванс'"),
		"АвансыПолученные", НСтр("ru='Авансы полученные'"), Объект.Ссылка, Отказ);
	
	ПроверитьЗаполнениеПоляСтрокиТабличнойЧасти(ТекДанные, "Контрагент", НСтр("ru='Контрагент'"),
		"АвансыПолученные", НСтр("ru='Авансы полученные'"), Объект.Ссылка, Отказ);
	
	ПроверитьЗаполнениеПоляСтрокиТабличнойЧасти(ТекДанные, "Договор", НСтр("ru='Договор'"),
		"АвансыПолученные", НСтр("ru='Авансы полученные'"), Объект.Ссылка, Отказ);
	
	ПроверитьЗаполнениеПоляСтрокиТабличнойЧасти(ТекДанные, "ДатаЗачета", НСтр("ru='Дата зачета аванса'"),
		"АвансыПолученные", НСтр("ru='Авансы полученные'"), Объект.Ссылка, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеПоляСтрокиТабличнойЧасти(ТекДанные, ИмяПоля, СинонимПоля, ИмяТабличнойЧасти, СинонимТабличнойЧасти, ОбъектСсылка, Отказ)
	
	Если Не ЗначениеЗаполнено(ТекДанные[ИмяПоля]) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			СинонимПоля, ТекДанные.НомерСтроки, СинонимТабличнойЧасти);
				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ОбъектСсылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, ТекДанные.НомерСтроки, ИмяПоля),
			"Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДокументовСчетовФактурНаОтгрузку(ТекДанные)
	
	ИдСтроки = ТекДанные.ПолучитьИдентификатор();
	
	АдресДанных = ПоместитьДанныеВХранилище_ДокументыСчетовФактурНаОтгрузку(ИдСтроки);
	
	ПараметрыФормы = УчетНДСКлиент.НовыйПараметрыОткрытияОбщейФормыДокументыСчетовФактурНаОтгрузку();
	ПараметрыФормы.АдресДанных = АдресДанных;
	ПараметрыФормы.СчетФактура = ТекДанные.СчетФактура;
	ПараметрыФормы.ИсключитьРегистратор = Объект.Ссылка;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИдСтроки", ИдСтроки);
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗакрытаФормаДокументыСчетовФактурНаОтгрузку", ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.ДокументыСчетовФактурНаОтгрузку", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеВХранилище_ДокументыСчетовФактурНаОтгрузку(ИдСтроки)
	
	ТекДанные = Объект.АвансыПолученные.НайтиПоИдентификатору(ИдСтроки);
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	Отбор.НаДату		= ТекДанные.ДатаЗачета;
	Отбор.Организация	= Объект.Организация;
	
	Отбор.СписокКонтрагентов.Добавить(ТекДанные.Контрагент);
	Отбор.СписокДоговоров.Добавить(ТекДанные.Договор);
	Отбор.СписокКФО.Добавить(ТекДанные.КФО);
	Отбор.СписокСчетовРасчетов.Добавить(ТекДанные.СчетРасчетов);
	Отбор.СписокКПССчетРасчетов.Добавить(ТекДанные.КПССчетРасчетов);
	Отбор.СписокСчетовФактурНаАванс.Добавить(ТекДанные.СчетФактура);
	
	ПоискИдентификатора = Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
	
	МассивСтрок = Объект.СчетаФактурыНаОтгрузку.НайтиСтроки(ПоискИдентификатора);
	
	Данные = УчетНДС.НовыйДанныеДляОбщейФормыДокументыСчетовФактурНаОтгрузку();
	Данные.СчетаФактурыНаОтгрузку = Объект.СчетаФактурыНаОтгрузку.Выгрузить(МассивСтрок);
	Данные.Отбор = Отбор;
	
	АдресДанных = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
	Возврат АдресДанных;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение, ДополнительныеПараметры);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение, ДополнительныеПараметры)
	
	Если Не ЭтоАдресВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаОтгрузку) Тогда
		Возврат;
	КонецЕсли;
	
	ИдСтроки = ДополнительныеПараметры.ИдСтроки;
	
	ТаблицаСчетаФактурыНаОтгрузку = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаОтгрузку);
	
	ТекДанные = Объект.АвансыПолученные.НайтиПоИдентификатору(ИдСтроки);
	
	ИдентификаторСтроки = ТекДанные.ИдентификаторСтроки;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) И ТаблицаСчетаФактурыНаОтгрузку.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		СтруктураАналитики = Новый Структура(ПолучитьИменаПолейАналитикиПоискаИдентификатораСтроки());
		
		ЗаполнитьЗначенияСвойств(СтруктураАналитики, ТекДанные);
		
		ИдентификаторСтрокиКандидат = НайтиИдентификаторСтрокиПоАналитике(СтруктураАналитики, ТекДанные.НомерСтроки);
		
		Если ЗначениеЗаполнено(ИдентификаторСтрокиКандидат) Тогда
			ИдентификаторСтроки = ИдентификаторСтрокиКандидат;
		Иначе
			ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		КонецЕсли;
		
		УстановитьИдентификаторыСтрокПоАналитике(ИдентификаторСтроки, СтруктураАналитики);
	КонецЕсли;
	
	ЗаписатьДокументыСчетовФактурНаОтгрузкуПоИдентификатору(ИдентификаторСтроки, ТаблицаСчетаФактурыНаОтгрузку);
	
	Если ЗначениеЗаполнено(ИдентификаторСтроки) И ТаблицаСчетаФактурыНаОтгрузку.Количество() = 0 Тогда
		ОчиститьИдентификаторыСтрок(ИдентификаторСтроки);
	КонецЕсли;
	
	ЗаполнитьПредставлениеСФНаОтгрузкуДляИдентификатора(ИдентификаторСтроки, ТаблицаСчетаФактурыНаОтгрузку);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДокументыСчетовФактурНаОтгрузкуПоИдентификатору(ИдентификаторСтроки, ТаблицаСчетаФактурыНаОтгрузку)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = Объект.СчетаФактурыНаОтгрузку.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Объект.СчетаФактурыНаОтгрузку.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаОтгрузку Цикл
		НоваяСтрока = Объект.СчетаФактурыНаОтгрузку.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиАвансыПолученные()
	
	ПоискИдентификатора = Новый Структура("ИдентификаторСтроки");
	
	Для Каждого СтрокаТаблицы Из Объект.АвансыПолученные Цикл
		ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		
		Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ПоискИдентификатора.ИдентификаторСтроки = ИдентификаторСтроки;
			
			МассивСтрок = Объект.СчетаФактурыНаОтгрузку.НайтиСтроки(ПоискИдентификатора);
			
			ПредставлениеСФНаОтгрузку = ПолучитьНадписьСчетаФактурыНаОтгрузку(МассивСтрок);
		Иначе
			ПредставлениеСФНаОтгрузку = "";
		КонецЕсли;
		
		СтрокаТаблицы.ПредставлениеСФНаОтгрузку = ПредставлениеСФНаОтгрузку;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИдентификаторСтроки(ТекДанные)
	
	Перем ПредставлениеСФНаОтгрузку;
	
	СчетФактура = ТекДанные.СчетФактура;
	ДатаЗачета = ТекДанные.ДатаЗачета;
	
	Если ЗначениеЗаполнено(СчетФактура) И ЗначениеЗаполнено(ДатаЗачета) Тогда
		СтруктураАналитики = Новый Структура(ПолучитьИменаПолейАналитикиПоискаИдентификатораСтроки());
		
		ЗаполнитьЗначенияСвойств(СтруктураАналитики, ТекДанные);
		
		ИдентификаторСтроки = НайтиИдентификаторСтрокиПоАналитике(СтруктураАналитики, ТекДанные.НомерСтроки, ПредставлениеСФНаОтгрузку);
	Иначе
		ИдентификаторСтроки = "";
		ПредставлениеСФНаОтгрузку = "";
	КонецЕсли;
	
	ТекДанные.ИдентификаторСтроки = ИдентификаторСтроки;
	ТекДанные.ПредставлениеСФНаОтгрузку = ПредставлениеСФНаОтгрузку;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИменаПолейАналитикиПоискаИдентификатораСтроки()
	
	Возврат "СчетФактура,ДатаЗачета,СчетРасчетов,КПССчетРасчетов,КФО";
	
КонецФункции

&НаСервере
Функция НайтиИдентификаторСтрокиПоАналитике(Знач СтруктураАналитики, Знач НомерТекущейСтроки, ПредставлениеСФНаОтгрузку = "")
	
	ИдентификаторСтроки = "";
	ПредставлениеСФНаОтгрузку = "";
	
	МассивСтрок = Объект.АвансыПолученные.НайтиСтроки(СтруктураАналитики);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрокаТаблицы.НомерСтроки <> НомерТекущейСтроки Тогда
			ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
			
			Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		Возврат "";
	КонецЕсли;
	
	ПоискИдентификатора = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = Объект.СчетаФактурыНаОтгрузку.НайтиСтроки(ПоискИдентификатора);
	
	ПредставлениеСФНаОтгрузку = ПолучитьНадписьСчетаФактурыНаОтгрузку(МассивСтрок);
	
	Возврат ИдентификаторСтроки;
	
КонецФункции

&НаСервере
Процедура УстановитьИдентификаторыСтрокПоАналитике(ИдентификаторСтроки, СтруктураАналитики)
	
	МассивСтрок = Объект.АвансыПолученные.НайтиСтроки(СтруктураАналитики);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьИдентификаторыСтрок(ИдентификаторСтроки)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = Объект.АвансыПолученные.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.ИдентификаторСтроки = "";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеСФНаОтгрузкуДляИдентификатора(ИдентификаторСтроки, ТаблицаСчетаФактурыНаОтгрузку)
	
	ПредставлениеСФНаОтгрузку = ПолучитьНадписьСчетаФактурыНаОтгрузку(ТаблицаСчетаФактурыНаОтгрузку);
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = Объект.АвансыПолученные.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.ПредставлениеСФНаОтгрузку = ПредставлениеСФНаОтгрузку;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНадписьСчетаФактурыНаОтгрузку(ТаблицаСчетаФактурыНаОтгрузку)
	
	Возврат УчетНДС.ПолучитьНадписьСчетаФактурыНаОтгрузку(ТаблицаСчетаФактурыНаОтгрузку,, Истина);
	
КонецФункции

&НаСервере
Процедура ДобавитьУсловноеОформление_ПустаяКолонкаСчетаФактурыНаОтгрузку()
	
	ИмяТЧ = "АвансыПолученные";
	
	ПутьКДанным = "Объект." + ИмяТЧ;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Надпись в пустой колонке ""Счета-фактуры на отгрузку""'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.ИдентификаторСтроки", ИмяТЧ));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<отсутствуют>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "ПредставлениеСФНаОтгрузку");
	
КонецПроцедуры

&НаСервере
Процедура АвансыПолученныеСчетФактураПриИзмененииСервер(ИдСтроки)
	
	Перем ПредставлениеСФНаОтгрузку;
	
	ТекДанные = Объект.АвансыПолученные.НайтиПоИдентификатору(ИдСтроки);
	
	СчетФактура = ТекДанные.СчетФактура;
	ДатаЗачета = ТекДанные.ДатаЗачета;
	
	Сведения = КонтрагентСчетФактуры(СчетФактура);
	ЗаполнитьЗначенияСвойств(ТекДанные, Сведения);
	
	СтруктураАналитики = Новый Структура(ПолучитьИменаПолейАналитикиПоискаИдентификатораСтроки());
	
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ТекДанные);
	
	ИдентификаторСтроки = НайтиИдентификаторСтрокиПоАналитике(СтруктураАналитики, ТекДанные.НомерСтроки, ПредставлениеСФНаОтгрузку);
	
	ТекДанные.ИдентификаторСтроки = ИдентификаторСтроки;
	ТекДанные.ПредставлениеСФНаОтгрузку = ПредставлениеСФНаОтгрузку;
	
КонецПроцедуры

