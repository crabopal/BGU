		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ПодсказкаКПС30304);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
		
		// Условие
		ИмяПоля = "Объект." + ИмяТаблицы + ".КПС30304";
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформляемые поля
		ИмяЭлемента = ИмяТаблицы + "КПС30304";
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыИтогов(ИменаЭлементов, ИспользоватьВалютныйУчет)
	
	ОтображатьЗаголовокГруппы = ИспользоватьВалютныйУчет;
	
	Для Каждого Элемент Из ИменаЭлементов Цикл
		ИмяЭлементаГруппы	= Элемент.Ключ;
		ИмяЭлементаПоля		= Элемент.Значение;
		
		УстановитьЗаголовокПоля = НЕ ИспользоватьВалютныйУчет;
		
		// Элемент группы
		Элементы[ИмяЭлементаГруппы].ОтображатьЗаголовок = ОтображатьЗаголовокГруппы;
		
		// Элемент поля
		Если УстановитьЗаголовокПоля Тогда
			Элементы[ИмяЭлементаПоля].Заголовок				= Элементы[ИмяЭлементаГруппы].Заголовок;
			Элементы[ИмяЭлементаПоля].ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Лево;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

