		УстановитьИдентификаторСтроки(Элементы.АвансыПолученные.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвансыПолученныеСчетФактураПриИзменении(Элемент)
	
	ТекДанные = Элементы.АвансыПолученные.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекДанные.СчетФактура) Тогда
		ОчищающаяСтруктура = Новый Структура("
			|Контрагент,
			|Договор,
			|ИдентификаторСтроки,
			|ПредставлениеСФНаОтгрузку");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		Возврат;
	КонецЕсли;
	
	АвансыПолученныеСчетФактураПриИзмененииСервер(ТекДанные.ПолучитьИдентификатор());
	
