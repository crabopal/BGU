Процедура АвансыПолученныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "АвансыПолученные", "");
	
	Если ИмяПоля = "ПредставлениеСФНаОтгрузку" Тогда
		СтандартнаяОбработка = Ложь;
		
		ПроверитьИОткрытьФормуСчетаФактурыНаОтгрузку();
	КонецЕсли;
	
