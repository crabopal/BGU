	<Attributes>
		<Attribute name="Список" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>~Список.Ref</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ПоступлениеМЗ.Ссылка КАК Ссылка,
	ПоступлениеМЗ.Организация КАК Организация,
	ПоступлениеМЗ.Контрагент КАК Контрагент,
	ПоступлениеМЗ.Контрагент КАК Поставщик,
	ПоступлениеМЗ.Договор КАК Договор,
	ОперацииДокументов.Операция КАК Операция,
	ПоступлениеМЗ.Дата КАК Дата,
	&amp;ПоступлениеМЗПредставление КАК ВидДокумента,
	ВЫРАЗИТЬ(ПоступлениеМЗ.Номер КАК СТРОКА(13)) КАК Номер,
	ПоступлениеМЗ.СуммаДокумента КАК СуммаДокумента,
	ПоступлениеМЗ.ИФО КАК ИФО
ИЗ
	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ПоступлениеМЗ.Ссылка = ОперацииДокументов.Документ
ГДЕ
	&amp;ВидПодбораЭДП = ЛОЖЬ
	И ОперацииДокументов.Документ ССЫЛКА Документ.ПоступлениеМЗ
	И ПоступлениеМЗ.Дата &gt;= &amp;НачалоПериода
	И ПоступлениеМЗ.Дата &lt;= &amp;КонецПериода
	И ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА КАК Поле1
			ИЗ
				РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
			ГДЕ
				ЖурналПроводокЕПСБУ.Регистратор = ПоступлениеМЗ.Ссылка
				И ЖурналПроводокЕПСБУ.СчетКт В ИЕРАРХИИ (&amp;Счет30404, &amp;Счет40120))</QueryText>
				<AutoSaveUserSettings>false</AutoSaveUserSettings>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
