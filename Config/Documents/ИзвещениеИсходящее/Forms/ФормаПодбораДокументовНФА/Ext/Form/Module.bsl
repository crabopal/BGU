#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидПодбора = Неопределено;
	Если НЕ Параметры.Свойство("ВидПодбора", ВидПодбора) Тогда
		ВидПодбора = "ТМЦ";
	КонецЕсли;
	Если НЕ Параметры.Свойство("ЗаДату", ЗаДату) Тогда
		ЗаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	НачалоПериода = ЗаДату;
	КонецПериода = ЗаДату;
	Параметры.Свойство("Организация",	ОтборОрганизация);
	Параметры.Свойство("Получатель",	ОтборПолучатель);
	Параметры.Свойство("Поставщик",		ОтборПоставщик);
	Параметры.Свойство("ЕстьЭДП",		ЕстьЭДП);
	УстановитьПараметрыПериода(ЭтотОбъект);
	УстановитьТекстЗапросаДинамическогоСпискаДокументов(ЕстьЭДП);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация);
	Если ЗначениеЗаполнено(ОтборПолучатель) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Контрагент", 	ОтборПолучатель);
	КонецЕсли;
	Если ЕстьЭДП И ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Поставщик", ОтборПоставщик,,,ЗначениеЗаполнено(ОтборПоставщик));
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НачалоПериода", НачалоДня(ЗаДату),	Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонецПериода", 	КонецДня(ЗаДату),	Истина);
	Если ЕстьЭДП Тогда
			Заголовок = НСтр("ru = 'Электронные документы поставщика'");
	Иначе	
		Если ВидПодбора = "ПолучениеНФАПоставщика" Тогда
			Заголовок = НСтр("ru = 'Документы поступления НФА со склада поставщика'");
		Иначе
			Заголовок = НСтр("ru = 'Документы поступления НФА со склада получателя'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПолучательПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Контрагент", ОтборПолучатель,,,ЗначениеЗаполнено(ОтборПолучатель));
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоставщикПриИзменении(Элемент)
	Если ЕстьЭДП И ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Поставщик", ОтборПоставщик,,,ЗначениеЗаполнено(ОтборПоставщик));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЕстьЭДППриИзменении(Элемент)
	УстановитьТекстЗапросаДинамическогоСпискаДокументов(ЕстьЭДП);
	Если ЕстьЭДП И ЗначениеЗаполнено(ОтборПоставщик) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Поставщик", ОтборПоставщик,,,ЗначениеЗаполнено(ОтборПоставщик));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачалоПриИзменении(Элемент)
	УстановитьПараметрыПериода(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПериодКонецПриИзменении(Элемент)
	УстановитьПараметрыПериода(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(Неопределено, ТекущиеДанные.Ссылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОповеститьОВыбореСтроки(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Для каждого Строка Из Элементы.Список.ВыделенныеСтроки Цикл
		ОповеститьОВыборе(Элементы.Список.ДанныеСтроки(Строка).Ссылка);
	КонецЦикла; 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыПериода(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "НачалоПериода",	НачалоДня(Форма.НачалоПериода),	Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "КонецПериода",	КонецДня(Форма.КонецПериода),	Истина);

КонецПроцедуры // УстановитьПараметрыПериода()

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Вставить("КонецПериода",  КонецПериода);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтотОбъект, "ВыбратьПериодЗавершение");
		
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		НачалоПериода = РезультатВыбора.НачалоПериода;
		КонецПериода  = РезультатВыбора.КонецПериода;
		Модифицированность = Истина;
		
		УстановитьПараметрыПериода(ЭтотОбъект);
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ТипыДокументовПоступленияНФА(ЕстьЭДП) Экспорт

	МассивТипов = Новый Массив;
	Если ЕстьЭДП Тогда 
		МассивТипов.Добавить(Тип("ДокументСсылка.ЭлектронныйДокументПоставщика"));
	Иначе
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеИК"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРабот"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	КонецЕсли;
	
	Возврат МассивТипов;

КонецФункции

&НаСервере
Функция НастройкиПроверкиОборотовПоСчетам() Экспорт

	Настройки = Новый ТаблицаЗначений;
	Настройки.Колонки.Добавить("ТипДокумента", Новый ОписаниеТипов("Тип"));
	Настройки.Колонки.Добавить("СтрокаСчетовДт", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0)));
	Настройки.Колонки.Добавить("СтрокаСчетовКт", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0)));
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПоступлениеМЗ");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПоступлениеОС");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПоступлениеИК");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПоступлениеУслугРабот");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Настройка = Настройки.Добавить();
	Настройка.ТипДокумента = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС");
	Настройка.СтрокаСчетовКт = "304.04,401.20";
	
	Возврат Настройки;

КонецФункции // НастройкиПроверкиОборотовПоСчетам()

&НаСервере
Процедура УстановитьТекстЗапросаДинамическогоСпискаДокументов(ВведенЭДП)

	ДополнительныеПараметрыСписка = Новый Структура;
	МассивТипов = Новый Массив;
	МассивТипов = ТипыДокументовПоступленияНФА(ВведенЭДП);
	
	ТекстЗапроса = "";
	ПервыйЗапрос = Истина;
	НомерЗапроса = 1;
	
	НастройкиПроверкиОборотовПоСчетам = НастройкиПроверкиОборотовПоСчетам();
	
	Если ВведенЭДП Тогда 
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВыбираемыйДокумент.Ссылка КАК Ссылка,
		               |	ВыбираемыйДокумент.Дата КАК Дата,
		               |	ВыбираемыйДокумент.Организация КАК Организация,
		               |	ВыбираемыйДокумент.Отправитель КАК Контрагент,
		               |	ВыбираемыйДокумент.Контрагент КАК Поставщик,
		               |	ВыбираемыйДокумент.Договор КАК Договор,
		               |	""Электронный документ поставщика"" КАК ВидДокумента,
		               |	ВыбираемыйДокумент.СуммаДокумента КАК СуммаДокумента
		               |ИЗ
		               |	Документ.ЭлектронныйДокументПоставщика КАК ВыбираемыйДокумент
		               |ГДЕ
		               |	ВыбираемыйДокумент.Дата >= &НачалоПериода
		               |	И ВыбираемыйДокумент.Дата <= &КонецПериода";
		
	Иначе
		Для каждого ТипДокумента Из МассивТипов Цикл
			
			Если Не ПервыйЗапрос Тогда
				ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все");
			КонецЕсли;
			
			МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
			
			ТекстЗапроса = ТекстЗапроса + 
				"ВЫБРАТЬ
				|	ВыбираемыйДокумент.Ссылка"			+ ?(ПервыйЗапрос, " КАК Ссылка", "") + ",
				|	ВыбираемыйДокумент.Дата"			+ ?(ПервыйЗапрос, " КАК Дата", "") + ",
				|	ВыбираемыйДокумент.Организация"		+ ?(ПервыйЗапрос, " КАК Организация", "");
			Если МетаданныеДокумента.Реквизиты.Найти("ИФО") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",		
				|	ВыбираемыйДокумент.ИФО"				+ ?(ПервыйЗапрос, " КАК ИФО", "");
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",		
				|	NULL"								+ ?(ПервыйЗапрос, " КАК ИФО", "");
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",		
				|	ВыбираемыйДокумент.СуммаДокумента"				+ ?(ПервыйЗапрос, " КАК СуммаДокумента", "");
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",		
				|	0"								+ ?(ПервыйЗапрос, " КАК ИФО", "");
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",		
				|	ВыбираемыйДокумент.Контрагент"		+ ?(ПервыйЗапрос, " КАК Контрагент", "");
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",		
				|	NULL"								+ ?(ПервыйЗапрос, " КАК Контрагент", "");
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",		
				|	ВыбираемыйДокумент.Контрагент"		+ ?(ПервыйЗапрос, " КАК Поставщик", "");
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",		
				|	NULL"								+ ?(ПервыйЗапрос, " КАК Поставщик", "");
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Договор") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",		
				|	ВыбираемыйДокумент.Договор"			+ ?(ПервыйЗапрос, " КАК Договор", "");
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",		
				|	NULL"								+ ?(ПервыйЗапрос, " КАК Договор", "");
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса + ",		
			|	ОперацииДокументов.Операция" + ?(ПервыйЗапрос, " КАК Операция", "") + ",
			|	""" +МетаданныеДокумента.Представление() + """"	+ ?(ПервыйЗапрос, " КАК ВидДокумента", "") + "
			|ИЗ
			|	Документ." + МетаданныеДокумента.Имя + " КАК ВыбираемыйДокумент
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
			|		ПО ВыбираемыйДокумент.Ссылка = ОперацииДокументов.Документ
			|ГДЕ
			|	ОперацииДокументов.Документ ССЫЛКА Документ." + МетаданныеДокумента.Имя + "
			|	И ВыбираемыйДокумент.Дата >= &НачалоПериода
			|	И ВыбираемыйДокумент.Дата <= &КонецПериода";
			
			НастройкаОборотов = НастройкиПроверкиОборотовПоСчетам.Найти(ТипДокумента, "ТипДокумента");
			Если НастройкаОборотов <> Неопределено Тогда
				
				РазделительВложенныхУсловий = "";
				ТекстЗапроса = ТекстЗапроса + "	
				|	И ИСТИНА В
				|		(ВЫБРАТЬ ПЕРВЫЕ 1
				|			Истина
				|		ИЗ
				|			РегистрБухгалтерии.ЖурналПроводокЕПСБУ Как ЖурналПроводокЕПСБУ
				|		ГДЕ
				|			ЖурналПроводокЕПСБУ.Регистратор = ВыбираемыйДокумент.Ссылка
				|			И (";
				Если ЗначениеЗаполнено(НастройкаОборотов.СтрокаСчетовКт) Тогда
					ТекстЗапроса = ТекстЗапроса + "ЖурналПроводокЕПСБУ.СчетКт В (&СчетаКт" + НомерЗапроса + ")";
					РазделительВложенныхУсловий = "
					|			ИЛИ ";
					ДополнительныеПараметрыСписка.Вставить("СчетаКт" + НомерЗапроса, БухгалтерскийУчет.СписокСчетов(НастройкаОборотов.СтрокаСчетовКт));
				КонецЕсли;
				Если ЗначениеЗаполнено(НастройкаОборотов.СтрокаСчетовДт) Тогда
					ТекстЗапроса = ТекстЗапроса + РазделительВложенныхУсловий + "ЖурналПроводокЕПСБУ.СчетКт В (&СчетаДт" + НомерЗапроса + ")";
					ДополнительныеПараметрыСписка.Вставить("СчетаКт" + НомерЗапроса, БухгалтерскийУчет.СписокСчетов(НастройкаОборотов.СтрокаСчетовДт));
				КонецЕсли;
				ТекстЗапроса = ТекстЗапроса + "))";
				
			КонецЕсли;
			
			ПервыйЗапрос = Ложь;
			НомерЗапроса = НомерЗапроса + 1;
		
		КонецЦикла;
	КонецЕсли;	
		
	Список.ТекстЗапроса = ТекстЗапроса;
	
	Для каждого ДополнительныйПараметр Из ДополнительныеПараметрыСписка Цикл
	
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, ДополнительныйПараметр.Ключ, ДополнительныйПараметр.Значение, Истина);
	
	КонецЦикла; 
		

КонецПроцедуры // УстановитьТекстЗапросаДинамическогоСпискаДокументов()

#КонецОбласти
