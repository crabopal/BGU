	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументИзвещениеИсходящее.Ссылка,
	ДокументИзвещениеИсходящее.ВерсияДанных,
	ДокументИзвещениеИсходящее.ПометкаУдаления,
	ДокументИзвещениеИсходящее.Номер,
	ДокументИзвещениеИсходящее.Дата,
	ДокументИзвещениеИсходящее.Проведен,
	ДокументИзвещениеИсходящее.Организация,
	ДокументИзвещениеИсходящее.ИФО,
	ДокументИзвещениеИсходящее.ВидИзвещения,
	ДокументИзвещениеИсходящее.Комментарий,
	ДокументИзвещениеИсходящее.Получатель,
	ДокументИзвещениеИсходящее.Поставщик,
	ДокументИзвещениеИсходящее.Договор,
	ДокументИзвещениеИсходящее.Руководитель,
	ДокументИзвещениеИсходящее.ГлавныйБухгалтер,
	ДокументИзвещениеИсходящее.ДатаСчетаПоставщика,
	ДокументИзвещениеИсходящее.НомерСчетаПоставщика,
	ДокументИзвещениеИсходящее.СуммаДокумента,
	ДокументИзвещениеИсходящее.МоментВремени,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументИзвещениеИсходящее.Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументИзвещениеИсходящее.Получатель
            ТОГДА ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.ВЭлектронномВиде)
        ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.НаБумажномНосителе)
    КОНЕЦ КАК СпособСоставленияДокументаПоУмолчанию,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументИзвещениеИсходящее.Получатель
            ТОГДА 1
        ИНАЧЕ 0
    КОНЕЦ КАК ЕстьНастройкаЭДО
ИЗ
	Документ.ИзвещениеИсходящее КАК ДокументИзвещениеИсходящее
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ДокументИзвещениеИсходящее.Ссылка = ОперацииДокументов.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументИзвещениеИсходящее.Ссылка = НаличиеФайлов.ОбъектСФайлами}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументИзвещениеИсходящее.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОтправкиЭлектронныхДокументов КАК НастройкиЭДО
		ПО (НастройкиЭДО.Получатель = ДокументИзвещениеИсходящее.Получатель) И (НастройкиЭДО.Отправитель = ДокументИзвещениеИсходящее.Организация) И (НастройкиЭДО.Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка))}
		
		</QueryText>
				<MainTable>Document.ИзвещениеИсходящее</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
