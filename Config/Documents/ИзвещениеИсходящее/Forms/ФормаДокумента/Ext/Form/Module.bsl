КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДО(Команда)
	
	Если Объект.ДенежныеОбязательства.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед заполнением денежных обязательств будет очищена.
			|Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОчиститьТаблицуДО", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьПроводки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ДатаСведений", Объект.Дата);
	ПараметрыФормы.Вставить("ИсходящееИзвещение", Объект.Ссылка);
	ПараметрыФормы.Вставить("ОтветноеИзвещение", ОтветноеИзвещение);
	
	АдресТаблицыСопоставленияПроводок = ПоместитьТаблицуСопоставленияПроводокВХранилище();
	
	ПараметрыФормы.Вставить("АдресТаблицыСопоставленияПроводок", АдресТаблицыСопоставленияПроводок);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СопоставлениеПроводокЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.ИзвещениеИсходящее.Форма.ФормаСопоставленияПроводок", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура РекомендоватьПроводки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ДатаСведений", Объект.Дата);
	ПараметрыФормы.Вставить("ИсходящееИзвещение", Объект.Ссылка);
	ПараметрыФормы.Вставить("ВидИзвещения", Объект.ВидИзвещения);
	
	АдресТаблицыРекомендуемыхПроводок = ПоместитьТаблицуРекомендуемыхПроводокВХранилище();
	
	ПараметрыФормы.Вставить("АдресТаблицыРекомендуемыхПроводок", АдресТаблицыРекомендуемыхПроводок);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РекомендацияПроводокЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.ИзвещениеИсходящее.Форма.ФормаРекомендуемыеПроводки", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения);
	
КонецПроцедуры	

