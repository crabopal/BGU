&НаКлиенте
Процедура ПередаваемыеПроводкиСчетКтПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	ОчиститьКПСиКЭК(ТекущиеДанные, "Кт");
	
	ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ТекущиеДанные, "Кт");
	
	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ПараметрыПодстановки.ДтКт = "Кт";
	ПараметрыПодстановки.Объект = Объект;
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
	ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(ТекущиеДанные, ПараметрыПодстановки);
	ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, ТекущиеДанные, "Кт");
	
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика") Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.СчетКт) Тогда
			Если ТекущиеДанные.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.Счет30404 Тогда
				ТекущиеДанные.КЭКДт = КЭКПередачи(ТекущиеДанные.СчетКт);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.КЭККт) Тогда
		
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, ТекущиеДанные, "Кт");
		
	КонецЕсли;
	
КонецПроцедуры

