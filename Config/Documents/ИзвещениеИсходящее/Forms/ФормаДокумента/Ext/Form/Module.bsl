&НаСервере
Функция ДанныеПервичногоДокумента(ВидДокумента, ДокументСсылка)
	Результат = Новый Структура("ВидДокумента, НомерДокумента, ДатаДокумента");
	Если ВидДокумента = НСтр("ru='ЭлектронныйДокументПоставщика'") Тогда
		Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ТипФорматаЭД, НомерПервичногоДокумента,
		|ДатаПервичногоДокумента, ВидПервичногоДокумента");
	ИначеЕсли ВидДокумента = НСтр("ru='АктПриемки'") Тогда
		Результат.ВидДокумента = НСтр("ru='Акт приемки'");
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Номер");
		Результат.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, 
			ДанныеДокумента.Номер);
		Результат.ДатаДокумента = ДанныеДокумента.Дата;
	Иначе
		Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "НомерПервичногоДокумента,
		|ДатаПервичногоДокумента, ВидПервичногоДокумента");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

