&НаКлиенте
Процедура ПриложенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ДокументПриложения", ВыбранноеЗначение);
	
	ДанныеПоиска = Объект.Приложения.НайтиСтроки(ПараметрыОтбора);
	Если ДанныеПоиска.Количество() = 0 Тогда
		НоваяСтрока = Объект.Приложения.Добавить();
		
		НоваяСтрока.ДокументПриложения = ВыбранноеЗначение;
		ТекущиеДанные = НоваяСтрока;
		Если ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			ДанныеПервичногоДокумента = ДанныеПервичногоДокумента(НСтр("ru='ЭлектронныйДокументПоставщика'"), ТекущиеДанные.ДокументПриложения);
			ТекущиеДанные.ВидДокумента = ДанныеПервичногоДокумента.ВидПервичногоДокумента;
			ТекущиеДанные.НомерДокумента = ДанныеПервичногоДокумента.НомерПервичногоДокумента;
			ТекущиеДанные.ДатаДокумента = ДанныеПервичногоДокумента.ДатаПервичногоДокумента;
		ИначеЕсли ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.АктПриемкиМ7") Тогда
			ДанныеПервичногоДокумент = ДанныеПервичногоДокумента(НСтр("ru='АктПриемки'"), ТекущиеДанные.ДокументПриложения);
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеПервичногоДокумент);
		ИначеЕсли ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеМЗ")
			ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеИК") 
			ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеОС")
			ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
			ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
			ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеУслугРабот") 
			Тогда
			ДанныеПервичногоДокумента = ДанныеПервичногоДокумента(, ТекущиеДанные.ДокументПриложения);
			ТекущиеДанные.ВидДокумента = ДанныеПервичногоДокумента.ВидПервичногоДокумента;
			ТекущиеДанные.НомерДокумента = ДанныеПервичногоДокумента.НомерПервичногоДокумента;
			ТекущиеДанные.ДатаДокумента = ДанныеПервичногоДокумента.ДатаПервичногоДокумента;
		Иначе
			ТекущиеДанные.ВидДокумента = "";
			ТекущиеДанные.НомерДокумента = "";
			ТекущиеДанные.ДатаДокумента = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриложенияЭлектронныйДокументПоставщикаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Приложения.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументПриложения) Тогда
			Если ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДанныеПервичногоДокумента = ДанныеПервичногоДокумента(НСтр("ru='ЭлектронныйДокументПоставщика'"), ТекущиеДанные.ДокументПриложения);
				ТекущиеДанные.ВидДокумента = ДанныеПервичногоДокумента.ВидПервичногоДокумента;
				ТекущиеДанные.НомерДокумента = ДанныеПервичногоДокумента.НомерПервичногоДокумента;
				ТекущиеДанные.ДатаДокумента = ДанныеПервичногоДокумента.ДатаПервичногоДокумента;
			ИначеЕсли ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.АктПриемкиМ7") Тогда
				ДанныеПервичногоДокумент = ДанныеПервичногоДокумента(НСтр("ru='АктПриемки'"), ТекущиеДанные.ДокументПриложения);
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеПервичногоДокумент);
			ИначеЕсли ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеМЗ")
				ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеИК") 
				ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеОС")
				ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
				ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
				ИЛИ ТипЗнч(ТекущиеДанные.ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеУслугРабот") 
				Тогда
				ДанныеПервичногоДокумента = ДанныеПервичногоДокумента(, ТекущиеДанные.ДокументПриложения);
				ТекущиеДанные.ВидДокумента = ДанныеПервичногоДокумента.ВидПервичногоДокумента;
				ТекущиеДанные.НомерДокумента = ДанныеПервичногоДокумента.НомерПервичногоДокумента;
				ТекущиеДанные.ДатаДокумента = ДанныеПервичногоДокумента.ДатаПервичногоДокумента;
			КонецЕсли;
		Иначе
			ТекущиеДанные.ВидДокумента = "";
			ТекущиеДанные.НомерДокумента = "";
			ТекущиеДанные.ДатаДокумента = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

