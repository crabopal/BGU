&НаСервере
Процедура ЗаполнитьСпискиНФАНаСервере()

	Объект.ОсновныеСредства.Очистить();
	Объект.Материалы.Очистить();
	Объект.ВозвратнаяТара.Очистить();
	
	ТаблицаЭДП = Новый ТаблицаЗначений;
	ТаблицаЭДП.Колонки.Добавить("ЭлектронныйДокументПоставщика", Новый ОписаниеТипов("ДокументСсылка.ЭлектронныйДокументПоставщика"));
	ТаблицаЭДП.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		
	Для каждого ТекСтрока Из Объект.Приложения Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ДокументПриложения) Тогда
			Если ТипЗнч(ТекСтрока.ДокументПриложения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				НоваяСтрока = ТаблицаЭДП.Добавить();
				НоваяСтрока.ЭлектронныйДокументПоставщика = ТекСтрока.ДокументПриложения;
				НоваяСтрока.КФО = ТекСтрока.КФО;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ДокументыЭДП = ТаблицаЭДП.ВыгрузитьКолонку("ЭлектронныйДокументПоставщика");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаЭДП.ЭлектронныйДокументПоставщика КАК ЭДП,
	               |	ТаблицаЭДП.КФО КАК КФО
	               |ПОМЕСТИТЬ ЭДПИзвещения
	               |ИЗ
	               |	&ТаблицаЭДП КАК ТаблицаЭДП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка КАК Ссылка,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки КАК НомерСтроки,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ЕдиницаИзмеренияКод КАК ЕдиницаИзмеренияКод,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторПоставщика КАК ИдентификаторПоставщика,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество КАК Количество,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ПризнакНоменклатуры КАК ПризнакНоменклатуры,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма КАК Сумма,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СуммаНДС КАК СуммаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Цена КАК Цена,
	               |	ЭДПИзвещения.КФО КАК КФО
	               |ПОМЕСТИТЬ СписокНоменклатурыЭДП
	               |ИЗ
	               |	ЭДПИзвещения КАК ЭДПИзвещения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |		ПО ЭДПИзвещения.ЭДП = ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка В(&ДокументыЭДП)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	1 КАК ТипНФА,
	               |	СписокНоменклатурыЭДП.Номенклатура КАК Номенклатура,
	               |	СписокНоменклатурыЭДП.Количество КАК Количество,
	               |	СписокНоменклатурыЭДП.Всего КАК Сумма,
	               |	СписокНоменклатурыЭДП.КФО КАК КФО,
	               |	&Счет051 КАК СчетУчета
	               |ИЗ
	               |	СписокНоменклатурыЭДП КАК СписокНоменклатурыЭДП
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(СписокНоменклатурыЭДП.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	2,
	               |	СписокНоменклатурыЭДП.Номенклатура,
	               |	СписокНоменклатурыЭДП.Количество,
	               |	СписокНоменклатурыЭДП.Всего,
	               |	СписокНоменклатурыЭДП.КФО,
	               |	&Счет052
	               |ИЗ
	               |	СписокНоменклатурыЭДП КАК СписокНоменклатурыЭДП
	               |ГДЕ
	               |	СписокНоменклатурыЭДП.ПризнакНоменклатуры = ""1""
	               |	И ТИПЗНАЧЕНИЯ(СписокНоменклатурыЭДП.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	3,
	               |	СписокНоменклатурыЭДП.Номенклатура,
	               |	СписокНоменклатурыЭДП.Количество,
	               |	СписокНоменклатурыЭДП.Всего,
	               |	СписокНоменклатурыЭДП.КФО,
	               |	&Счет052
	               |ИЗ
	               |	СписокНоменклатурыЭДП КАК СписокНоменклатурыЭДП
	               |ГДЕ
	               |	СписокНоменклатурыЭДП.ПризнакНоменклатуры = ""1ВТ""
	               |	И ТИПЗНАЧЕНИЯ(СписокНоменклатурыЭДП.Номенклатура) = ТИП(Справочник.Номенклатура)";
	
	Запрос.УстановитьПараметр("ТаблицаЭДП", ТаблицаЭДП);
	Запрос.УстановитьПараметр("ДокументыЭДП", ДокументыЭДП);
	
	Запрос.УстановитьПараметр("Счет051", ЭтотОбъект.КэшПараметров.Локальные.Счет051);
	Запрос.УстановитьПараметр("Счет052", ЭтотОбъект.КэшПараметров.Локальные.Счет052);
	
	ДанныеНМА = Запрос.Выполнить().Выгрузить();
	Для каждого ТекСтрока Из ДанныеНМА Цикл
		Если ТекСтрока.ТипНФА = 1 Тогда
			НоваяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначениясвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ОсновноеСредство = ТекСтрока.Номенклатура;
		ИначеЕсли  ТекСтрока.ТипНФА = 2 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначениясвойств(НоваяСтрока, ТекСтрока); 
		ИначеЕсли  ТекСтрока.ТипНФА = 3 Тогда
			НоваяСтрока = Объект.ВозвратнаяТара.Добавить();
			ЗаполнитьЗначениясвойств(НоваяСтрока, ТекСтрока); 
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ВходящееИзвещениеПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.ВходящееИзвещение) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВходящееИзвещение, "Поставщик, Договор, Отправитель");
		Объект.Получатель = ЗначенияРеквизитов.Отправитель;
		Объект.Поставщик = ЗначенияРеквизитов.Поставщик;
		Объект.Договор = ЗначенияРеквизитов.Договор;
		
		ДанныеДокументов = ЭлектронныеДокументыБГУ.ЗаполнитьПриложенияПоИзвещению(Объект.ВходящееИзвещение);
		
		Объект.Приложения.Загрузить(ДанныеДокументов.ЭДП);
		Для каждого ТекСтрока Из ДанныеДокументов.АктыПриемкиПоЭДП Цикл
			НоваяСтрока = Объект.Приложения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ТекСтрока.ДокументПриложения, ТекСтрока.ДокументПриложения.Номер);
		КонецЦикла;		
		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиОтражениеВУчетеРазделенияЗемельныхУчастковЭДО()

	Объект.ПередаваемыеПроводки.Очистить();
	Объект.Материалы.Очистить();
	Объект.ОсновныеСредства.Очистить();
	Объект.ВозвратнаяТара.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Извещение", Объект.ВходящееИзвещение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеВходящееЗемельныеУчастки.НомерСтроки КАК НомерСтроки,
	|	ИзвещениеВходящееЗемельныеУчастки.Выбыло КАК Выбыло,
	|	ИзвещениеВходящееЗемельныеУчастки.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзвещениеВходящееЗемельныеУчастки.ОсновноеСредство.Наименование КАК ОсновноеСредствоНаименование,
	|	ИзвещениеВходящееЗемельныеУчастки.ОсновноеСредство.НаименованиеПолное КАК ОсновноеСредствоНаименованиеПолное,
	|	ИзвещениеВходящееЗемельныеУчастки.ИнвентарныйНомер.Код КАК ИнвентарныйНомер,
	|	ИзвещениеВходящееЗемельныеУчастки.КадастровыйНомер КАК КадастровыйНомер,
	|	ИзвещениеВходящееЗемельныеУчастки.КФО КАК КФО,
	|	ИзвещениеВходящееЗемельныеУчастки.Сумма КАК Сумма
	|ИЗ
	|	Документ.ИзвещениеВходящее.ЗемельныеУчастки КАК ИзвещениеВходящееЗемельныеУчастки
	|ГДЕ
	|	ИзвещениеВходящееЗемельныеУчастки.Ссылка = &Извещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Выборка = Запрос.Выполнить().Выбрать();
	Счет2613 = БухгалтерскийУчет.СчетПоКоду("26.13", Объект.Дата, Объект.Организация);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет2613);
	НомерСубконтоОС = 0;
	НомерСубконтоВидБезвозмедногоПользования = 0;
	Для НомерСубконто = 1 По 3 Цикл
		Если СвойстваСчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			НомерСубконтоОС = НомерСубконто;
		ИначеЕсли СвойстваСчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.ВидыБезвозмездногоПользования Тогда
			НомерСубконтоВидБезвозмедногоПользования = НомерСубконто;
		КонецЕсли;
	КонецЦикла;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Выбыло Тогда
			СторонаПроводки = "Кт";
			СодержаниеПроводки = НСтр("ru = 'Списано'");
		Иначе
			СторонаПроводки = "Дт";
			СодержаниеПроводки = НСтр("ru = 'Принято к учету'");
		КонецЕсли;
		НоваяСтрока = Объект.ПередаваемыеПроводки.Добавить();
		НоваяСтрока["Счет" + СторонаПроводки] = Счет2613;
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяСтрока, СторонаПроводки);
		ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
		ПараметрыПодстановки.ДтКт = СторонаПроводки;
		ПараметрыПодстановки.Объект = Объект;
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(
			ПараметрыПодстановки, Объект);
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(
			ПараметрыПодстановки, ЭтотОбъект);
		ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(
			СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
		ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(
			НоваяСтрока, ПараметрыПодстановки);
		Если НомерСубконтоОС > 0 Тогда
			НоваяСтрока["Субконто" + СторонаПроводки + НомерСубконтоОС] = Выборка.ОсновноеСредство;
		КонецЕсли;
		Если НомерСубконтоВидБезвозмедногоПользования > 0 Тогда
			НоваяСтрока["Субконто" + СторонаПроводки + НомерСубконтоВидБезвозмедногоПользования]
				= Перечисления.ВидыБезвозмездногоПользования.ПереданноеВПользованиеПоИнымОснованиям;
		КонецЕсли;
		НоваяСтрока.Сумма = Выборка.Сумма;
		Если ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			СодержаниеПроводки = СодержаниеПроводки + " инв. №:" + СокрЛП(Выборка.ИнвентарныйНомер) + ",";
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ОсновноеСредствоНаименованиеПолное) Тогда
			НаименованиеОС = Выборка.ОсновноеСредствоНаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ОсновноеСредствоНаименование) Тогда
			НаименованиеОС = Выборка.ОсновноеСредствоНаименование;
		Иначе
			НаименованиеОС = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(НаименованиеОС) Тогда
			СодержаниеПроводки = СодержаниеПроводки + " " + НаименованиеОС;
		КонецЕсли;
		НоваяСтрока.Содержание = СодержаниеПроводки;
		
	КонецЦикла;
	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиЗаказчикаПриПолученииОтПолучателя()

	Объект.ПередаваемыеПроводки.Очистить();
	Объект.Материалы.Очистить();
	Объект.ОсновныеСредства.Очистить();
	Объект.ВозвратнаяТара.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Извещение", Объект.ВходящееИзвещение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) КАК ТипЗначения,
	|	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры КАК ТипНоменклатуры,
	|	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Справочник.ОсновныеСредства).ВидНФА КАК ВидНФА,
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Содержание КАК Содержание
	|ИЗ
	|	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	|ГДЕ
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Извещение = &Извещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка,
	|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки";
	
	Счет40120 = БухгалтерскийУчет.СчетПоКоду("401.20", Объект.Дата, Объект.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПередаваемыеПроводки.Добавить();
		НоваяСтрока.СчетДт = Счет40120;
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяСтрока, "Дт");
		
		СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		Если Выборка.ТипЗначения = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			Если Выборка.ВидНФА = Перечисления.ВидыНФА.ОС
				Или Выборка.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
				СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.31", Объект.Дата, Объект.Организация);
			ИначеЕсли Выборка.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
				СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.32", Объект.Дата, Объект.Организация);
			ИначеЕсли Выборка.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
				СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.33", Объект.Дата, Объект.Организация);
			КонецЕсли;
		ИначеЕсли Выборка.ТипЗначения = Тип("СправочникСсылка.Номенклатура") Тогда
			Если Выборка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БиологическиеАктивы Тогда
				СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.36", Объект.Дата, Объект.Организация);
			Иначе
				СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Объект.Дата, Объект.Организация);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетКт = СчетРасчетов;
			ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяСтрока, "Кт");
			ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
			ПараметрыПодстановки.ДтКт = "Кт";
			ПараметрыПодстановки.Объект = Объект;
			ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
			ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, ЭтотОбъект);
			ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
			ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(НоваяСтрока, ПараметрыПодстановки);
			ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, НоваяСтрока, "Кт");
		КонецЕсли;
		
		НоваяСтрока.Сумма = Выборка.Всего;
		НоваяСтрока.Содержание = Выборка.Содержание;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиЗаказчикаПриПолученииОтПолучателяРезерв()

	Объект.ПередаваемыеПроводки.Очистить();
	Объект.Материалы.Очистить();
	Объект.ОсновныеСредства.Очистить();
	Объект.ВозвратнаяТара.Очистить();
	
	ТаблицаПриложения = Объект.Приложения.Выгрузить();
	
	НепустыеПриложения = Новый Массив;
	Для Каждого СтрокаПриложения Из ТаблицаПриложения Цикл
		Если ЗначениеЗаполнено(СтрокаПриложения.ДокументПриложения) Тогда
			НепустыеПриложения.Добавить(СтрокаПриложения.ДокументПриложения);
		КонецЕсли;
	КонецЦикла;
	
	Если НепустыеПриложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", НепустыеПриложения);
	Запрос.УстановитьПараметр("Счет40120", БухгалтерскийУчет.СчетПоКоду("401.20", Объект.Дата, Объект.Организация));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТРегистраторы
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|ГДЕ
	|	ПоступлениеМЗ.ДокументОснование В(&ДокументОснование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеИК.Ссылка
	|ИЗ
	|	Документ.ПоступлениеИК КАК ПоступлениеИК
	|ГДЕ
	|	ПоступлениеИК.ДокументОснование В(&ДокументОснование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеОС.Ссылка
	|ИЗ
	|	Документ.ПоступлениеОС КАК ПоступлениеОС
	|ГДЕ
	|	ПоступлениеОС.ДокументОснование В(&ДокументОснование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеОСИК.Ссылка
	|ИЗ
	|	Документ.ПоступлениеОСИК КАК ПоступлениеОСИК
	|ГДЕ
	|	ПоступлениеОСИК.ДокументОснование В(&ДокументОснование)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоКт3,
	|	&Счет40120 КАК СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В
	|				(ВЫБРАТЬ
	|					ВТРегистраторы.Ссылка
	|				ИЗ
	|					ВТРегистраторы),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПередаваемыеПроводки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяСтрока, "Дт");
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяСтрока, "Кт");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУчтеннымТМЦ()

	Объект.ПередаваемыеПроводки.Очистить();
	Объект.Материалы.Очистить();
	Объект.ОсновныеСредства.Очистить();
	Объект.ВозвратнаяТара.Очистить();
	
	ТаблицаПриложения = Объект.Приложения.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеИК.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ДокументыУчетаНФА
	               |ИЗ
	               |	Документ.ПоступлениеИК КАК ПоступлениеИК
	               |ГДЕ
	               |	ПоступлениеИК.Ссылка В(&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПоступлениеМЗ.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |ГДЕ
	               |	ПоступлениеМЗ.Ссылка В(&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПоступлениеОС.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеОС КАК ПоступлениеОС
	               |ГДЕ
	               |	ПоступлениеОС.Ссылка В(&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
