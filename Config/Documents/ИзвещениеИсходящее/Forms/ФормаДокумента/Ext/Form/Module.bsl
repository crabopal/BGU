	               |	ПоступлениеОСКапВложения.Ссылка В (&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ 
	               |	ПоступлениеУслугРаботУслугиИРаботы.Номенклатура,
				   |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	               |	ПоступлениеУслугРаботУслугиИРаботы.Количество,
	               |	ПоступлениеУслугРаботУслугиИРаботы.Всего,
	               |	ПоступлениеУслугРаботУслугиИРаботы.КФО,
	               |	""УР""
	               |ИЗ
	               |	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК ПоступлениеУслугРаботУслугиИРаботы
	               |ГДЕ
	               |	ПоступлениеУслугРаботУслугиИРаботы.Ссылка В (&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ 
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.ОсновноеСредство,
				   |	ПринятиеКУчетуОбъектовИКОсновныеСредства.ИнвентарныйНомер,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка.КФО,
	               |	""ОС""
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ПринятиеКУчетуОбъектовИКОсновныеСредства
	               |ГДЕ
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка В (&ДокументПриложения)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ 
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство,
				   |	ПринятиеКУчетуОбъектовОСОсновныеСредства.ИнвентарныйНомер,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.КФО,
	               |	""ОС""
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ПринятиеКУчетуОбъектовОСОсновныеСредства
	               |ГДЕ
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка В (&ДокументПриложения)
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗВозвратнаяТара.Номенклатура,
				   |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	               |	ПоступлениеМЗВозвратнаяТара.Количество,
	               |	ПоступлениеМЗВозвратнаяТара.Сумма,
	               |	ПоступлениеМЗВозвратнаяТара.КФО,
	               |	""ВТ""
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	               |ГДЕ
	               |	ПоступлениеМЗВозвратнаяТара.Ссылка В (&ДокументПриложения)";
	
	Запрос.УстановитьПараметр("ДокументПриложения", ТаблицаДокументовУчета.ВыгрузитьКолонку("Ссылка"));
	Запрос.УстановитьПараметр("СчетаСанкционирования", СчетаСанкционирования);
	Результат = Запрос.ВыполнитьПакет();
	
	ПроводкиВсехУчетныхДокументов = Результат[1].Выгрузить();
	Объект.ПередаваемыеПроводки.Загрузить(ПроводкиВсехУчетныхДокументов);
	УстановитьСвойстваСчетовВПередаваемыхПроводках();
	ДополнитьПолныеНаименованияНФА();
	
	СписокНФА = Результат[2].Выгрузить();
	Для каждого ТекСтрока Из СписокНФА Цикл
		Если ТекСтрока.ТипМЦ = "МЗ" Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет052;
		ИначеЕсли ТекСтрока.ТипМЦ = "ВТ" Тогда
			НоваяСтрока = Объект.ВозвратнаяТара.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет052;
		ИначеЕсли ТекСтрока.ТипМЦ = "ОС" Тогда
			НоваяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ОсновноеСредство = ТекСтрока.Номенклатура;
			НоваяСтрока.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет051;
		КонецЕсли;	
	КонецЦикла;	
	
	ПроверкаЭлектронныхИзвещений();
КонецПроцедуры

&НаСервере
Процедура ДополнитьПолныеНаименованияНФА()
	УточненныеСодержанияПроводок = Документы.ИзвещениеИсходящее
		.ПолныеНаименованияПередаваемыхНФА(Объект.ПередаваемыеПроводки.Выгрузить());
	Для Каждого Проводка Из Объект.ПередаваемыеПроводки Цикл
		УточненноеСодержание = Документы.ИзвещениеИсходящее.ПолучитьСодержаниеПроводки(
			Неопределено,
			Проводка.НомерСтроки,
			УточненныеСодержанияПроводок);
		Если ЗначениеЗаполнено(УточненноеСодержание) Тогда
			Проводка.Содержание = УточненноеСодержание;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПриложенияПоДокументамПередачиНаСервере()
	ДанныеДокументов = ДанныеДокументовПередачи();
	Объект.Приложения.Очистить();
	Для Каждого ТекСтрока Из Объект.ДокументыПередачи Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДокументПередачи) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.Приложения.Добавить();
		ДанныеДокумента = ДанныеДокументов.Получить(ТекСтрока.ДокументПередачи);
		Если ЗначениеЗаполнено(ДанныеДокумента.ПервичныйДокумент)
				И Не ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
				ДанныеДокумента.ПервичныйДокумент, ПервичныеДокументыБГУ.СлужебныйИдентификаторДокументКонтагента()) Тогда
			НоваяСтрока.ВидДокумента = ПервичныеДокументыБГУ.ВидПервичногоДокумента(ДанныеДокумента.ПервичныйДокумент);
			НоваяСтрока.ДатаДокумента = ДанныеДокумента.Дата;
			НоваяСтрока.НомерДокумента = ДанныеДокумента.Номер;
		Иначе
			Если ЗначениеЗаполнено(ДанныеДокумента.ВидПервичногоДокумента) Тогда
				НоваяСтрока.ВидДокумента = ДанныеДокумента.ВидПервичногоДокумента;
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеДокумента.ДатаПервичногоДокумента) Тогда
				НоваяСтрока.ДатаДокумента = ДанныеДокумента.ДатаПервичногоДокумента;
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеДокумента.НомерПервичногоДокумента) Тогда
				НоваяСтрока.НомерДокумента = ДанныеДокумента.НомерПервичногоДокумента;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ДатаДокумента) Тогда
			НоваяСтрока.ДатаДокумента = ДанныеДокумента.Дата;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.НомерДокумента) Тогда
			НоваяСтрока.НомерДокумента = ДанныеДокумента.Номер;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ВидДокумента) Тогда
			Если ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.СписаниеБСО") Тогда
				НоваяСтрока.ВидДокумента = НСтр("ru = 'Акт о списании бланков строгой отчетности'");
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ВыбытиеНеоплаченныхПутевок")
				ИЛИ ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПередачаБСО")
				ИЛИ ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
				ИЛИ ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
				НоваяСтрока.ВидДокумента = НСтр("ru = 'Накладная на отпуск материалов (материальных ценностей) на сторону'");
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПередачаОбъектовОС")
				ИЛИ ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
				НоваяСтрока.ВидДокумента = НСтр("ru = 'Акт о приеме-передаче объектов нефинансовых активов'");
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПоступлениеБСО")
				Или ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПоступлениеМЗ")
				Или  ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
				НоваяСтрока.ВидДокумента = НСтр("ru = 'Приходный ордер на приемку материальных ценностей (нефинансовых активов)'");
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
				НоваяСтрока.ВидДокумента = НСтр("ru = 'Извещение'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ДанныеДокументовПередачи()
	Результат = Новый Соответствие;
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(
		Объект.ДокументыПередачи.Выгрузить(, "ДокументПередачи").ВыгрузитьКолонку("ДокументПередачи"));
	Для Каждого ТипДокументы Из ДокументыПоТипам Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокументы.Ключ);
		ИменаРеквизитов = Новый Массив;
		ИменаРеквизитов.Добавить("Дата, Номер, Ссылка");
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПервичныйДокумент", МетаданныеДокумента) Тогда
			ИменаРеквизитов.Добавить("ПервичныйДокумент");
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВидПервичногоДокумента", МетаданныеДокумента) Тогда
			ИменаРеквизитов.Добавить("ВидПервичногоДокумента");
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаПервичногоДокумента", МетаданныеДокумента) Тогда
			ИменаРеквизитов.Добавить("ДатаПервичногоДокумента");
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("НомерПервичногоДокумента", МетаданныеДокумента) Тогда
			ИменаРеквизитов.Добавить("НомерПервичногоДокумента");
		КонецЕсли;
		ДанныеДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ТипДокументы.Значение,
			СтрСоединить(ИменаРеквизитов, ","));
		НастройкаПечатиНомера = БиблиотекаФункцийОбменаПовтИсп.ПолучитьЗначениеНастройкиПечатиПрефиксаНомераВидаДокумента(
			МетаданныеДокумента.ПолноеИмя());
		Для Каждого Документ Из ТипДокументы.Значение Цикл
			ДанныеДокумента = РеквизитыДокументаПередачи();
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеДокументов.Получить(Документ));
			ДанныеДокумента.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоЗначениюНастройки(
				НастройкаПечатиНомера, ДанныеДокумента.Номер);
			Результат.Вставить(Документ, ДанныеДокумента);
		КонецЦикла;
		
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция РеквизитыДокументаПередачи()
	Результат = Новый Структура;
	Результат.Вставить("Дата");
	Результат.Вставить("Номер");
	Результат.Вставить("ПервичныйДокумент");
	Результат.Вставить("ВидПервичногоДокумента");
	Результат.Вставить("ДатаПервичногоДокумента");
	Результат.Вставить("НомерПервичногоДокумента");
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьРеквизитовДляЭДОПередачиНФА(Форма)
	Результат = Ложь;
	
	Если Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика")
		ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада")
		ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада")
		ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО") Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПоказатьРеквизитыЭДО()
	
	ВидимостьОтветногоИзвещения = Ложь;
	ВидимостьКомандыСопоставленияПроводок = Ложь;
	ВидимостьКомандыРекомендацииПроводок = Истина;
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Получатель, Объект.Организация);
	Если ВидимостьЭлементовЭДО Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ВходящееИзвещение) Тогда
			ОтветноеИзвещение = ЭлектронныеДокументыБГУ.ОтветноеИзвещениеПоИсходящемуИзвещению(Объект.Ссылка);
			Если ЗначениеЗаполнено(ОтветноеИзвещение) Тогда
				ВидимостьОтветногоИзвещения = Истина;
				ВидимостьКомандыСопоставленияПроводок = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВходящееИзвещение) Тогда
		ВидимостьКомандыСопоставленияПроводок = Истина;
		ВидимостьКомандыРекомендацииПроводок = Ложь;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтветноеИзвещение", "Видимость", ВидимостьОтветногоИзвещения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаСопоставитьПроводки", "Видимость", ВидимостьКомандыСопоставленияПроводок);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаРекомендоватьПроводки", "Видимость", ВидимостьКомандыРекомендацииПроводок);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтветноеИзвещение(ДокументОтветногоИзвещения, Форма, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ДокументОтветногоИзвещения) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтветногоИзвещения = Новый Структура("Ключ", ДокументОтветногоИзвещения);
	
	ОткрытьФорму("Документ.ИзвещениеВходящее.ФормаОбъекта", ПараметрыОтветногоИзвещения, Форма);
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаЭлектронныхИзвещений()
	ВидимостьРезультатовКонтроляЭлектронныхИзвещений = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ВходящееИзвещение) Тогда
		
		ДанныеВходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Объект.ВходящееИзвещение);
		
		СуммаВходящегоИзвещения = 0;
		Если ЗначениеЗаполнено(ДанныеВходящегоИзвещения) Тогда
			Если (Объект.ТипЭлектронногоИзвещения = 20) 
				ИЛИ (Объект.ТипЭлектронногоИзвещения = 24)
				ИЛИ (Объект.ТипЭлектронногоИзвещения = 26)
				ИЛИ (Объект.ТипЭлектронногоИзвещения = 28)
				ИЛИ (Объект.ТипЭлектронногоИзвещения = 30)
				ИЛИ (Объект.ТипЭлектронногоИзвещения = 32) Тогда
				СуммаВходящегоИзвещения = ДанныеВходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаПолучатель");
			Иначе	
				СуммаВходящегоИзвещения = ДанныеВходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаОтправитель");
			КонецЕсли;
		КонецЕсли;	
		
		Если Объект.ПередаваемыеПроводки.Количество() > 0 Тогда
			СуммаОтветногоИзвещения = Объект.ПередаваемыеПроводки.Итог("Сумма");
		ИначеЕсли Объект.ДокументыПередачи.Количество() > 0 Тогда
			ПередаваемыеПроводкиДокументовПередачи = ЭлектронныеДокументыБГУ.ПроводкиПоДокументамПередачи(Объект.ДокументыПередачи.Выгрузить(), Объект.Ссылка);
			СуммаОтветногоИзвещения = ПередаваемыеПроводкиДокументовПередачи.Итог("Сумма");
		Иначе
			СуммаОтветногоИзвещения = 0;
		КонецЕсли;	
		
		Если СуммаВходящегоИзвещения<>СуммаОтветногоИзвещения Тогда
			ВидимостьРезультатовКонтроляЭлектронныхИзвещений = Истина;
			
			РезультатыКонтроляЭлектронныхИзвещений = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Внимание! Входящее извещение на сумму: %1, передаваемые проводки ответного извещения на сумму: %2!'"),
				?(СуммаВходящегоИзвещения = 0, НСтр("ru='0.00'"), Формат(СуммаВходящегоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '")), ?(СуммаОтветногоИзвещения = 0, НСтр("ru='0.00'"), Формат(СуммаОтветногоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '")));
		КонецЕсли;	
	Иначе
		СуммаИсходящегоИзвещения = 0;
		
		ДанныеИсходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Объект.Ссылка);
		Если ЗначениеЗаполнено(ДанныеИсходящегоИзвещения) Тогда
			Если (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 19) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 23) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 25) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 27) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 29) Тогда
				СуммаИсходящегоИзвещения = ДанныеИсходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаПолучатель");
			Иначе	
				СуммаИсходящегоИзвещения = ДанныеИсходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаОтправитель");
			КонецЕсли;
		КонецЕсли;
		
		СуммаОтветногоИзвещения = 0;
		ОтветноеИзвещение = ЭлектронныеДокументыБГУ.ОтветноеИзвещениеПоИсходящемуИзвещению(Объект.Ссылка);
		Если ЗначениеЗаполнено(ОтветноеИзвещение) Тогда
			ДанныеВходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(ОтветноеИзвещение);
			Если ЗначениеЗаполнено(ДанныеВходящегоИзвещения) Тогда
				СуммаОтветногоИзвещения = ДанныеВходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаОтправитель");
			КонецЕсли;	
			Если СуммаИсходящегоИзвещения<>СуммаОтветногоИзвещения Тогда
				ВидимостьРезультатовКонтроляЭлектронныхИзвещений = Истина;
				
				РезультатыКонтроляЭлектронныхИзвещений = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Внимание! Исходящее извещение на сумму: %1, а проводки ответного извещения на сумму: %2!'"),
					Формат(СуммаИсходящегоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '"), ?(СуммаОтветногоИзвещения = 0, НСтр("ru='0.00'"), Формат(СуммаОтветногоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '")));
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РезультатыКонтроляЭлектронныхИзвещений", "Видимость", ВидимостьРезультатовКонтроляЭлектронныхИзвещений);
КонецПроцедуры	

