&НаКлиенте
Процедура ВидИзвещенияПриИзменении(Элемент)
	ВидИзвещенияПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ВидИзвещенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		
	Если ВыбранноеЗначение = Объект.ВидИзвещения Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ВыполняемыеДействия = Новый Массив;
	ОчищаемыеТаблицы = Новый Массив;
	Если Объект.ПередаваемыеПроводки.Количество() > 0 Тогда
		Если Не ВидимостьЗакладкиПередаваемыеПроводки(ЭтотОбъект, ВыбранноеЗначение)
			ИЛИ Не ЦентрализованноеСнабжениеКлиентСервер.ПередаваемыеПроводкиСоответствуютВидуИзвещения(ЭтотОбъект) Тогда
			ВыполняемыеДействия.Добавить(НСтр("ru = ' - очищены передаваемые проводки'"));
			ОчищаемыеТаблицы.Добавить("ПередаваемыеПроводки");
		КонецЕсли;
	КонецЕсли;
	
	ШаблонТекстаДействия = НСтр("ru = ' - очищена таблица ""%1""'");
	ИменаТаблиц = Новый Структура;
	ИменаТаблиц.Вставить("ОсновныеСредства", НСтр("ru = 'Основные средства'"));
	ИменаТаблиц.Вставить("Материалы", НСтр("ru = 'Материалы'"));
	ИменаТаблиц.Вставить("ВозвратнаяТара", НСтр("ru = 'Возвратная тара'"));
	ИменаТаблиц.Вставить("ДенежныеОбязательства", НСтр("ru = 'Денежные обязательства'"));
	Для Каждого Таблица Из ИменаТаблиц Цикл
		Если Объект[Таблица.Ключ].Количество() > 0 И Не ВидимостьЗакладки(Таблица.Ключ, ВыбранноеЗначение) Тогда
			ВыполняемыеДействия.Добавить(СтрШаблон(ШаблонТекстаДействия, Таблица.Значение));
			ОчищаемыеТаблицы.Добавить(Таблица.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ДокументыПередачи.Количество() > 0
		И Не ВидимостьЗакладки("ДокументыПередачи", ВыбранноеЗначение)
		И Не ДокументыСоответствуютВидуОперации(ВыбранноеЗначение) Тогда
		
		ВыполняемыеДействия.Добавить(СтрШаблон(ШаблонТекстаДействия, НСтр("ru = 'Документы передачи'")));
		ОчищаемыеТаблицы.Добавить("ДокументыПередачи");
	КонецЕсли;
	
	Если ВыполняемыеДействия.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		ТекстВопроса = СтрШаблон(НСтр("ru = 'При изменении вида извещения будут выполнены следующие действия:
											|
											|%1
											|
											|Продолжить изменение вида извещения?'"),
								СтрСоединить(ВыполняемыеДействия, Символы.ПС));
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Выполнить все действия и изменить вид извещения'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Не изменять вид извещения'"));
		
		ДопПараметры = Новый Структура("ОчищаемыеТаблицы, ВыбранноеЗначение", ОчищаемыеТаблицы, ВыбранноеЗначение);
		Оповещение = Новый ОписаниеОповещения("ВидИзвещенияОбработкаВыбораЗавершение", ЭтотОбъект, ДопПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

