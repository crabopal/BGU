#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДопустимыеКЭККолонкиДО()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВтРодители
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код В(&КодыКОСГУ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВтРодители.Ссылка КАК Ссылка
	|			ИЗ
	|				ВтРодители КАК ВтРодители)";
	КодыКОСГУ = Новый Массив;
	КодыКОСГУ.Добавить("310");
	КодыКОСГУ.Добавить("320");
	КодыКОСГУ.Добавить("330");
	КодыКОСГУ.Добавить("340");
	КодыКОСГУ.Добавить("262");
	КодыКОСГУ.Добавить("263");
	Запрос.УстановитьПараметр("КодыКОСГУ", КодыКОСГУ);
	ДопустимыеКОСГУ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ПараметрыВыбораКОСГУ = Новый Массив;
	ПараметрыВыбораКОСГУ.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДопустимыеКОСГУ)));
	
	Элементы.ДенежныеОбязательстваКЭК.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКОСГУ);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		УстановитьСлужебныеДанныеВыбораСчетов();
		ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
		ЦентрализованноеСнабжение.ПерезаполнитьСчетаПередаваемыхПроводок(ЭтотОбъект);
		
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		УстановитьПодписиОрганизации(Объект.Организация, Объект.Дата, Объект.Руководитель, Объект.ГлавныйБухгалтер);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	УстановитьСлужебныеДанныеВыбораСчетов();
	УстановитьПодписиОрганизации(Объект.Организация, Объект.Дата, Объект.Руководитель, Объект.ГлавныйБухгалтер);
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСубконтоВТаблицу(ИмяЭлемента)
	Если Объект.ПередаваемыеПроводки.Количество() > 0 Тогда
		УстановитьСубконтоВТаблицуНаСервере(ИмяЭлемента);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСубконтоВТаблицуНаСервере(ИмяЭлемента)
	
	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
	
	ЭтоПодтверждениеРасчетовПоПоставкамНФА =
		Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА
		Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА;
	Если ИмяЭлемента = "Получатель" Тогда
		Если ЭтоПодтверждениеРасчетовПоПоставкамНФА Тогда
			ПараметрыПодстановки.КонтрагентКт = Объект.Получатель;
		Иначе
			ПараметрыПодстановки.КонтрагентДт = Объект.Получатель;
		КонецЕсли;
	ИначеЕсли ИмяЭлемента = "Поставщик" Тогда
		Если ЭтоПодтверждениеРасчетовПоПоставкамНФА Тогда
			Возврат;
		КонецЕсли;
		ПараметрыПодстановки.КонтрагентКт = Объект.Поставщик;
		ПараметрыПодстановки.ДоговорКт = Объект.Договор;
	ИначеЕсли ИмяЭлемента = "Договор" Тогда
		Если ЭтоПодтверждениеРасчетовПоПоставкамНФА Тогда
			ПараметрыПодстановки.ДоговорДт = Объект.Договор;
		Иначе
			ПараметрыПодстановки.ДоговорКт = Объект.Договор;
		КонецЕсли;
	Иначе
		ВызватьИсключение "Не правильное имя элемента";
	КонецЕсли;
	
	Для Каждого Проводка Из Объект.ПередаваемыеПроводки Цикл
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоВСтроке(Проводка, ПараметрыПодстановки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидИзвещенияОбработкаВыбораЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Модифицированность = Истина;
		Для Каждого ИмяТаблицы Из ДопПараметры.ОчищаемыеТаблицы Цикл
			Объект[ИмяТаблицы].Очистить();
		КонецЦикла;
		
		Объект.ВидИзвещения = ДопПараметры.ВыбранноеЗначение;
		ВидИзвещенияПриИзмененииНаКлиенте();
		
	Иначе
		Элементы.ВидИзвещения.ОбновитьТекстРедактирования();
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВидИзвещенияПриИзмененииНаКлиенте()
	
	Если Объект.ВидИзвещения <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика") Тогда
		Объект.ЗапланироватьОплату = Ложь;
		Объект.ОплатитьДо = Дата(1, 1, 1);
	КонецЕсли;
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидИзвещения);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	ВидИзвещенияПриИзмененииНаСервере();
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	УстановитьПервуюАктивнуюЗакладку();
	
КонецПроцедуры

&НаСервере
Процедура ВидИзвещенияПриИзмененииНаСервере()
	ПереключательДокументооборотСоСтороныПолучателя = ЦентрализованноеСнабжение.ДокументооборотСоСтороныПолучателя(
		Объект.ВидИзвещения);
	УстановитьСлужебныеДанныеВыбораСчетов();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьСлужебныеДанныеВыбораСчетов()

	ЦентрализованноеСнабжение.ИнициализироватьДопустимыеКорреспонденции(ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиентСервер.УстановитьПараметрыВыбораСчетов(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПервуюАктивнуюЗакладку()
	Для Каждого ПодчиненнаяСтраница Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
		Если ПодчиненнаяСтраница.Видимость И ПодчиненнаяСтраница.Доступность Тогда
			Элементы.Страницы.ТекущаяСтраница = ПодчиненнаяСтраница;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
	//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОчиститьТаблицуДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	ТаблицаОбязательств = Новый ТаблицаЗначений;
	ТаблицаОбязательств.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаОбязательств.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаОбязательств.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаОбязательств.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОбязательств.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОбязательств.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаОбязательств.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число"));
	
	Для Каждого Проводка Из Объект.ПередаваемыеПроводки Цикл
		
		СтрокаОбязательств = ТаблицаОбязательств.Добавить();
		
		СтрокаОбязательств.Контрагент    = Проводка.СубконтоКт1;
		СтрокаОбязательств.Договор       = Проводка.СубконтоКт2;
		СтрокаОбязательств.Подразделение = Проводка.ПодразделениеКт;
		СтрокаОбязательств.КПС           = Проводка.КПСКт;
		СтрокаОбязательств.КФО           = Проводка.КФО;
		СтрокаОбязательств.КЭК           = Проводка.КЭКДт;
		СтрокаОбязательств.Сумма         = Проводка.Сумма;
		
	КонецЦикла;
	
	ТаблицаОбязательств.Свернуть("Подразделение, Контрагент, Договор, КФО, КПС, КЭК", "Сумма");
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ПереключательДокументооборотСоСтороныПолучателя = ЦентрализованноеСнабжение.ДокументооборотСоСтороныПолучателя(
		Объект.ВидИзвещения);
	УстановитьСлужебныеДанныеВыбораСчетов();
	УстановитьСвойстваСчетовВПередаваемыхПроводках();
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	ЦентрализованноеСнабжениеКлиентСервер.УстановитьПараметрыВыбораСчетов(ЭтотОбъект);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидИзвещения);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКЭШПараметровФормыЛокальныеСчета()

	ВставитьСчетВКэшПараметровФормы("05.1");
	ВставитьСчетВКэшПараметровФормы("05.2");
	ВставитьСчетВКэшПараметровФормы("105.36");
	ВставитьСчетВКэшПараметровФормы("215.31");
	ВставитьСчетВКэшПараметровФормы("302.27");
	ВставитьСчетВКэшПараметровФормы("302.31");
	ВставитьСчетВКэшПараметровФормы("302.32");
	ВставитьСчетВКэшПараметровФормы("302.33");
	ВставитьСчетВКэшПараметровФормы("302.34");
	ВставитьСчетВКэшПараметровФормы("303.05");
	ВставитьСчетВКэшПараметровФормы("304.04");
	ВставитьСчетВКэшПараметровФормы("401.10");
	ВставитьСчетВКэшПараметровФормы("401.20");
	ВставитьСчетВКэшПараметровФормы("401.40");
	ВставитьСчетВКэшПараметровФормы("401.50");
	
	ЗаполнитьСвойстваСчетов();
	
КонецПроцедуры

&НаСервере
Процедура ВставитьСчетВКэшПараметровФормы(КодСчета)

	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчета = Объект.Дата;
	Иначе
		ДатаСчета = ТекущаяДатаСеанса();
	КонецЕсли;
	ИмяКлюча = "Счет" + СтрЗаменить(КодСчета, ".", "");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить(ИмяКлюча,
		БухгалтерскийУчет.СчетПоКоду(КодСчета, ДатаСчета, Объект.Организация));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКэшПараметровФормыЛокальныеКЭК()
	ВставитьКЭКВКэшПараметровФормы("310");
	ВставитьКЭКВКэшПараметровФормы("320");
	ВставитьКЭКВКэшПараметровФормы("330");
	ВставитьКЭКВКэшПараметровФормы("340");
КонецПроцедуры

&НаСервере
Процедура ВставитьКЭКВКэшПараметровФормы(КодКЭК)
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КЭК" + КодКЭК, БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПередаваемыеПроводки",
		"Видимость", ВидимостьЗакладкиПередаваемыеПроводки(Форма, Объект.ВидИзвещения));
	СтраницыНФА = Новый Массив;
	СтраницыНФА.Добавить("ГруппаОсновныеСредства");
	СтраницыНФА.Добавить("ГруппаМатериалы");
	СтраницыНФА.Добавить("ГруппаВозвратнаяТара");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, СтраницыНФА,
		"Видимость", ЦентрализованноеСнабжениеКлиентСервер.ВидимостьПередачиНФАИсходящееИзвещение(Объект.ВидИзвещения));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДокументыПередачи",
		"Видимость", ВидимостьЗакладкиДокументыПередачи(Объект.ВидИзвещения));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДенежныеОбязательства",
		"Видимость", ВидимостьЗакладкиДенежныеОбязательства(Объект.ВидИзвещения));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПояснениеМБТ",
		"Видимость", ВидимостьЗакладкиПояснениеМБТ(Объект.ВидИзвещения));
	УстановитьТекущуюЗакладку(Форма);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПриложенияПодборДокументовПоступленияНФА",
		"Видимость", ЭтоОтветноеИзвещениеПередачиНФА(Объект.ВидИзвещения));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПередаваемыеПроводкиЗаполнитьПередаваемыеПроводки",
		"Видимость",
		ПоВидуИзвещенияВозможноЗаполнениеПроводок(Объект.ВидИзвещения));

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Поставщик");
	ИменаЭлементов.Добавить("Договор");
	ИменаЭлементов.Добавить("ВидДокументаПоставщика");
	ИменаЭлементов.Добавить("НомерСчетаПоставщика");
	ИменаЭлементов.Добавить("ДатаСчетаПоставщика");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьРеквизитовПоставщикаПоВидуИзвещения(Объект.ВидИзвещения));
	
	Элементы.ДокументыПередачиДокументПередачи.ОграничениеТипа = ОписаниеТиповДокументовПоВидуИзвещения(
		Форма, Объект.ВидИзвещения);
	
	Если ВыбираютсяДокументыПоступления(Объект.ВидИзвещения) Тогда
		ЗаголовокЗакладки = НСтр("ru = 'Документы поступления'");
		ЗаголовокКолонки  = НСтр("ru = 'Документ поступления'");
		ЗаголовокКнопкиЗаполнить = НСтр("ru = 'Заполнить по документам поступления'");
	ИначеЕсли ВыбираютсяДокументыУточнения(Объект.ВидИзвещения) Тогда
		ЗаголовокЗакладки = НСтр("ru = 'Документы уточнения'");
		ЗаголовокКолонки  = НСтр("ru = 'Документ уточнения'");
		ЗаголовокКнопкиЗаполнить = НСтр("ru = 'Заполнить по документам уточнения'");
	Иначе
		ЗаголовокЗакладки = НСтр("ru = 'Документы передачи'");
		ЗаголовокКолонки  = НСтр("ru = 'Документ передачи'");
		ЗаголовокКнопкиЗаполнить = НСтр("ru = 'Заполнить по документам передачи'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДокументыПередачи",
		"Заголовок", ЗаголовокЗакладки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыПередачиДокументПередачи",
		"Заголовок", ЗаголовокКолонки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПриложенияЗаполнитьПриложенияПоДокументамПередачи",
		"Заголовок", ЗаголовокКнопкиЗаполнить);
		
	Если ПолучательЗаказчик(Объект.ВидИзвещения) Тогда
		ЗаголовокПолучатель = НСтр("ru = 'Заказчик по контракту'");
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ") Тогда
		ЗаголовокПолучатель = НСтр("ru = 'Орган, исполняющий полномочия собственника'");
	Иначе
		ЗаголовокПолучатель = НСтр("ru = 'Получатель'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Получатель",
		"Заголовок", ЗаголовокПолучатель);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВходящееИзвещение", "Видимость",
		ВидимостьВходящегоИзвещения(Объект));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПриложенияЗаполнитьСпискиНФА", "Видимость", Элементы.ГруппаМатериалы.Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПриложенияЗаполнитьПриложенияПоДокументамПередачи", "Видимость", Элементы.ГруппаДокументыПередачи.Видимость);
	
	ВидимостьРеквизитовДляЭДОПередачиНФА = ВидимостьРеквизитовДляЭДОПередачиНФА(Форма);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПриложенияЭлектронныйДокументПоставщика", "Видимость", ВидимостьРеквизитовДляЭДОПередачиНФА);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПриложенияКФО", "Видимость", ВидимостьРеквизитовДляЭДОПередачиНФА);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьДокументооборотСоСтороныПолучателя", "Видимость", Форма.ПереключательДокументооборотСоСтороныПолучателя);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекущуюЗакладку(Форма)
	Если Не Форма.Элементы.Страницы.ТекущаяСтраница.Видимость Тогда
		ЗакладкаПоУмолчанию = ЗакладкаПоУмолчанию(Форма);
		Если ЗакладкаПоУмолчанию <> Неопределено Тогда
			Форма.Элементы.Страницы.ТекущаяСтраница = ЗакладкаПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучательЗаказчик(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыбираютсяДокументыПоступления(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеБСО")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДохода")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеТребований")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыбираютсяДокументыУточнения(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладки(ИмяЗакладки, ВидИзвещения)
	
	Если ИмяЗакладки = "ОсновныеСредства"
		Или ИмяЗакладки = "Материалы"
		Или ИмяЗакладки = "ВозвратнаяТара" Тогда
		Возврат ЦентрализованноеСнабжениеКлиентСервер.ВидимостьПередачиНФАИсходящееИзвещение(ВидИзвещения);
	ИначеЕсли ИмяЗакладки = "ДенежныеОбязательства" Тогда
		Возврат ВидимостьЗакладкиДенежныеОбязательства(ВидИзвещения);
	ИначеЕсли ИмяЗакладки = "ДокументыПередачи" Тогда
		Возврат ВидимостьЗакладкиДокументыПередачи(ВидИзвещения);
	Иначе
		ВызватьИсключение "Не известное имя закладки";
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиПередаваемыеПроводки(Форма, ВидИзвещения)
	Если Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы")
		Или Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений") Тогда
		
		Возврат Форма.Объект.ПередаваемыеПроводки.Количество() > 0;
		
	Иначе
		Возврат Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
			ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада")
			ИЛИ (ЗначениеЗаполнено(Форма.ВсеДопустимыеКорреспонденции)
				И Форма.ВсеДопустимыеКорреспонденции.СчетаДт.Количество() > 0);
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиДенежныеОбязательства(ВидИзвещения)
	Возврат ЦентрализованноеСнабжениеКлиентСервер.ВидимостьДенежныхОбязательствИсходящееИзвещение(ВидИзвещения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиПояснениеМБТ(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ") 
		ИЛИ ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиДокументыПередачи(ВидИзвещения)
	Возврат ЦентрализованноеСнабжениеКлиентСервер.ВидимостьДокументовПередачиИсходящееИзвещение(ВидИзвещения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОтветноеИзвещениеПередачиНФА(ВидИзвещения)
	
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПоВидуИзвещенияВозможноЗаполнениеПроводок(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьРеквизитовПоставщикаПоВидуИзвещения(ВидИзвещения)
	Возврат ЦентрализованноеСнабжениеКлиентСервер.ВидимостьРеквизитовПоставщикаИсходящееИзвещение(ВидИзвещения);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗакладкаПоУмолчанию(Форма)
	
	Если Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада")
		ИЛИ Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаБСО") Тогда 
		Возврат Форма.Элементы.ГруппаДокументыПередачи;
	ИначеЕсли Форма.Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств") Тогда 
		Возврат Форма.Элементы.ГруппаДокументыПередачи;
	Иначе
		Возврат Форма.Элементы.ГруппаПередаваемыеПроводки;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьВходящегоИзвещения(Объект)
	Возврат Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеБСО")	
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДохода")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеТребований")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРБП")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО");
		
КонецФункции

&НаСервере
Процедура ЗаполнитьПоПередаваемымТМЦ()

	Объект.ПередаваемыеПроводки.Очистить();
	Объект.ДенежныеОбязательства.Очистить();
	
	ПередаваемыеОС = Объект.ОсновныеСредства.Выгрузить();
	ПередаваемыеОС.Колонки.Добавить("ВидНФА", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыНФА"));
	ПередаваемыеОС.ЗаполнитьЗначения(Перечисления.ВидыНФА.ОС, "ВидНФА");
	ПередаваемыеОС.Свернуть("КФО, ВидНФА", "Сумма");
	
	ПередаваемыеМЗ = Объект.Материалы.Выгрузить(, "КФО, Номенклатура, Сумма");
	ПередаваемыеМЗ.Колонки.Добавить("КЭКДт");
	
	НоменклатураТЧ = ПередаваемыеМЗ.ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	ТипыНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НоменклатураТЧ, "ТипНоменклатуры");
	КЭКТиповНоменклатуры = Новый Соответствие;
	Для каждого СтрокаМЗ Из ПередаваемыеМЗ Цикл
		
		ТипНоменклатуры = ТипыНоменклатуры[СтрокаМЗ.Номенклатура];
		Если КЭКТиповНоменклатуры[ТипНоменклатуры] = Неопределено Тогда
			Если ЗначениеЗаполнено(ТипНоменклатуры) Тогда
				ИспользуемыйКЭК = БухгалтерскийУчет.КЭКНоменклатуры(Объект.Организация,
																	Объект.ИФО,
																	,
																	Объект.Дата,
																	ПланыСчетов.ЕПСБУ.ПустаяСсылка(),
																	ТипНоменклатуры,
																	"Дт");
			Иначе
				ИспользуемыйКЭК = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЭтотОбъект.КэшПараметров.Локальные.Счет10536).КОСГУДт;
			КонецЕсли;
			КЭКТиповНоменклатуры.Вставить(ТипНоменклатуры, ИспользуемыйКЭК);
		КонецЕсли;
		
		СтрокаМЗ.КЭКДт = КЭКТиповНоменклатуры[ТипНоменклатуры];
		
	КонецЦикла;
	
	ПередаваемыеМЗ.Свернуть("КФО, КЭКДт", "Сумма");
	
	Для каждого ТекСуммаНФА Из ПередаваемыеОС Цикл
	
		ПередПроводка = Объект.ПередаваемыеПроводки.Добавить();
		ПередПроводка.КФО = ТекСуммаНФА.КФО;
		
		ПередПроводка.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.Счет30404;
		
		Если ТекСуммаНФА.ВидНФА = Перечисления.ВидыНФА.ОС Тогда
			ПередПроводка.СчетКт = ЭтотОбъект.КэшПараметров.Локальные.Счет30231;
			ПередПроводка.КЭКДт = ЭтотОбъект.КэшПараметров.Локальные.КЭК310;
			
			ПередПроводка.Сумма = ТекСуммаНФА.Сумма;
		КонецЕсли;
		
		ПередПроводка.СубконтоДт1 = Объект.Получатель;
		
		ПередПроводка.СубконтоКт1 = Объект.Поставщик;
		ПередПроводка.СубконтоКт2 = Объект.Договор;
		
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, ПередПроводка, "Кт");
		
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ПередПроводка, "Дт");
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ПередПроводка, "Кт");
	КонецЦикла; 
	
	Для каждого ТекСуммаНФА Из ПередаваемыеМЗ Цикл
	
		ПередПроводка = Объект.ПередаваемыеПроводки.Добавить();
		ПередПроводка.КФО = ТекСуммаНФА.КФО;
		
		ПередПроводка.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.Счет30404;
		ПередПроводка.КЭКДт = ТекСуммаНФА.КЭКДт;

		ПередПроводка.СчетКт = ЭтотОбъект.КэшПараметров.Локальные.Счет30234;
		
		ПередПроводка.Сумма = ТекСуммаНФА.Сумма;
		
		ПередПроводка.СубконтоДт1 = Объект.Получатель;
		
		ПередПроводка.СубконтоКт1 = Объект.Поставщик;
		ПередПроводка.СубконтоКт2 = Объект.Договор;
		
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, ПередПроводка, "Кт");
		
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ПередПроводка, "Дт");
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ПередПроводка, "Кт");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КЭКПередачи(СчетКредита)

	Если СчетКредита = ЭтотОбъект.КэшПараметров.Локальные.Счет30231 Тогда
		Возврат ЭтотОбъект.КэшПараметров.Локальные.КЭК310;
	ИначеЕсли СчетКредита = ЭтотОбъект.КэшПараметров.Локальные.Счет30232 Тогда
		Возврат ЭтотОбъект.КэшПараметров.Локальные.КЭК320;
	ИначеЕсли СчетКредита = ЭтотОбъект.КэшПараметров.Локальные.Счет30233 Тогда
		Возврат ЭтотОбъект.КэшПараметров.Локальные.КЭК330;
	ИначеЕсли СчетКредита = ЭтотОбъект.КэшПараметров.Локальные.Счет30234 Тогда
		Возврат ЭтотОбъект.КэшПараметров.Локальные.КЭК340;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.КОСГУ.ПустаяСсылка");
	КонецЕсли;

КонецФункции

&НаСервере
Процедура УстановитьСвойстваСчетовВПередаваемыхПроводках()

	Для каждого ТекСтр Из Объект.ПередаваемыеПроводки Цикл
	
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ТекСтр, "Дт");
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ТекСтр, "Кт");
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКПСиКЭК(ТекущиеДанные, Сторона = "Дт")

	Если Не ЗначениеЗаполнено(ТекущиеДанные["Счет"+Сторона]) Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные["КПС"+Сторона]) Тогда
			ТекущиеДанные["КПС"+Сторона] = ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка");
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущиеДанные["КЭК"+Сторона]) Тогда
			ТекущиеДанные["КЭК"+Сторона] = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущиеДанные["Подразделение"+Сторона]) Тогда
			ТекущиеДанные["Подразделение"+Сторона] = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
		КонецЕсли;
	КонецЕслИ;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПодписиОрганизации(Организация, Дата, Руководитель, ГлавныйБухгалтер)

	ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", 		Организация, Дата).Свойство("ОтветственноеЛицоСсылка", Руководитель);
	ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Главный бухгалтер", 	Организация, Дата).Свойство("ОтветственноеЛицоСсылка", ГлавныйБухгалтер);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеТиповДокументовПоВидуИзвещения(Форма, ВидИзвещения)
	
	Если ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада") Тогда
		МассивТипов = Форма.ТипыДокументов_ПередачаНФАСоСклада;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств") Тогда
		МассивТипов = Форма.ТипыДокументов_ПередачаДенежныхСредств;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаБСО") Тогда
		МассивТипов = Форма.ТипыДокументов_ПередачаБСО;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений") Тогда
		МассивТипов = Форма.ТипыДокументов_ПередачаФинансовыхВложений;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы") Тогда
		МассивТипов = Форма.ТипыДокументов_ПередачаВложенийВФинансовыеАктивы;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеБСО") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеБСО;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеДенежныхСредств;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДохода") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеДохода;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеОбязательств;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаТребований") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеТребований;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРБП") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеРБП;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеФинансовыхВложений;
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы") Тогда
		МассивТипов = Форма.ТипыДокументов_ПолучениеВложенийВФинансовыеАктивы;
	Иначе
		МассивТипов = Новый Массив;
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

&НаКлиенте
Функция ДокументыСоответствуютВидуОперации(ВидИзвещения)

	ОписаниеТипов = ОписаниеТиповДокументовПоВидуИзвещения(ЭтотОбъект, ВидИзвещения);
	Если ОписаниеТипов.Типы().Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для каждого ТекДокумент Из Объект.ДокументыПередачи Цикл
		Если НЕ ОписаниеТипов.СодержитТип(ТипЗнч(ТекДокумент.ДокументПередачи)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Истина;

КонецФункции

