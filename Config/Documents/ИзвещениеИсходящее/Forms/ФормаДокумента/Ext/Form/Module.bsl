&НаКлиенте
Процедура ПередаваемыеПроводкиКЭКДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	
	ОграниченияКЭК = Неопределено;
	ОграниченияСчет = ТекущиеДанные.СчетДт;
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика") Тогда
		Если ТекущиеДанные.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.Счет30404 Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.СчетКт) Тогда
				ОграниченияКЭК = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КЭКПередачи(ТекущиеДанные.СчетКт));
				ОграниченияСчет = Неопределено;
			КонецЕсли;
		ИначеЕсли ТекущиеДанные.СчетДт = ЭтотОбъект.КэшПараметров.Локальные.Счет40120 Тогда
			ОграниченияКЭК = "241,242,251,252,253";
			ОграниченияСчет = Неопределено;
		КонецЕсли;
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.НачислениеДохода") Тогда
		ОграниченияКЭК = "100,400";
		ОграниченияСчет = Неопределено;
	КонецЕсли;
    	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭКДт,
								Объект.Организация, 
								Объект.ИФО,
								ТекущиеДанные.КФО, 
                                ОграниченияСчет,
								Объект.Дата,
								"Дт",
								ОграниченияКЭК);
КонецПроцедуры

