Функция НовыеПараметрыДополнительныхСведенийЭлектронногоИзвещения0504805()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийЭлектронногоИзвещения0504805();
КонецФункции

&НаКлиенте
Процедура НадписьДопСведенияЭлектронногоИзвещенияПоФорме0504805Нажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Параметры.Ключ.Пустая() Тогда
		ТекстОшибки = НСтр("ru='Необходимо записать документ для заполнения сведений электронного извещения.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыДопСведений = НовыеПараметрыДополнительныхСведенийЭлектронногоИзвещения0504805();
	
	КодыДополнительныхКоманд = Новый Массив;
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА") Тогда
		КодыДополнительныхКоманд.Добавить(1);
		КодыДополнительныхКоманд.Добавить(2);
	КонецЕсли;	
	
	ПараметрыДопСведений.Ссылка = Объект.Ссылка;
	ПараметрыДопСведений.ДатаСведений = Объект.Дата;
	ПараметрыДопСведений.Организация = Объект.Организация;
	ПараметрыДопСведений.КодыДополнительныхКоманд = КодыДополнительныхКоманд; 
	
	ЭлектронныеДокументыБГУКлиент.ОткрытьФормуДопСведенийДляЭлектронногоИзвещенияПоФорме0504805(ЭтотОбъект, Объект, ПараметрыДопСведений);
	
КонецПроцедуры

