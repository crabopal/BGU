	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПСДт, 
													Объект.Организация,
													Объект.ИФО,
													ТекущиеДанные.КФО,
