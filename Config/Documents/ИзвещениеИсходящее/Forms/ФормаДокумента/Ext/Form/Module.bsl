&НаКлиенте
Процедура ЗаполнитьПередаваемыеПроводки(Команда)
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика") Тогда
		ЗаполнитьПоПередаваемымТМЦ();
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика")
		Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада") Тогда
		ЗаполнитьПоУчтеннымТМЦ();
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО") Тогда
		ЗаполнитьПроводкиЗаказчикаПриПолученииОтПолучателяРезерв();
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО") Тогда
		ЗаполнитьПроводкиЗаказчикаПриПолученииОтПолучателя();
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО") Тогда
		ЗаполнитьПроводкиОтражениеВУчетеРазделенияЗемельныхУчастковЭДО();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодборДокументов(Команда)
	
	Если НЕ ВидимостьЗакладкиДокументыПередачи(Объект.ВидИзвещения) Тогда
		ТекстПредупреждения = НСтр("ru = 'Команда не может использоваться с видом извещения ""%1""'");
		ПоказатьПредупреждение(Неопределено, СтрШаблон(ТекстПредупреждения, Объект.ВидИзвещения));
		Возврат;
	КонецЕсли;
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("Организация",        Объект.Организация);
	ПараметрыДляВыбора.Вставить("ЗаДату",             Объект.Дата);
	ПараметрыДляВыбора.Вставить("Получатель",         Объект.Получатель);
	ПараметрыДляВыбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыДляВыбора.Вставить("Поставщик",          Объект.Поставщик);
	ПараметрыДляВыбора.Вставить("ВидИзвещения",       Объект.ВидИзвещения);
	
	ОткрытьФорму("Документ.ИзвещениеИсходящее.Форма.ФормаПодбораДокументов", ПараметрыДляВыбора, Элементы.ДокументыПередачи);
КонецПроцедуры

&НаКлиенте
Процедура ПодборДокументовПоступленияНФА(Команда)
	Если НЕ ЭтоОтветноеИзвещениеПередачиНФА(Объект.ВидИзвещения) Тогда
		ТекстПредупреждения = НСтр("ru = 'Команда не может использоваться с видом извещения ""%1""'");
		ПоказатьПредупреждение(Неопределено, СтрШаблон(ТекстПредупреждения, Объект.ВидИзвещения));
		Возврат;
	КонецЕсли;
	
	ЕстьЭДП = Ложь;
	ДатаВходящегоИзвещения = Объект.Дата;
	Если ЗначениеЗаполнено(Объект.ВходящееИзвещение) Тогда
		ДанныеВходящегоИзвещения = ДанныеВходящегоИзвещения();
		ДатаВходящегоИзвещения = ДанныеВходящегоИзвещения.Дата;
		
		ЕстьЭДП = ДляВходящегоИзвещенияЕстьЭДП();
	КонецЕсли;
	
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("Организация",        Объект.Организация);
	ПараметрыДляВыбора.Вставить("ЗаДату",             ДатаВходящегоИзвещения);
	ПараметрыДляВыбора.Вставить("Получатель",         Объект.Получатель);
	ПараметрыДляВыбора.Вставить("Поставщик",          Объект.Поставщик);
	ПараметрыДляВыбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыДляВыбора.Вставить("ЕстьЭДП",            ЕстьЭДП);
	
	ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораПоВидуИзвещения(Объект.ВидИзвещения);
	Если Не ПустаяСтрока(ВидПодбора) Тогда
		ПараметрыДляВыбора.Вставить("ВидПодбора", ВидПодбора);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ИзвещениеИсходящее.Форма.ФормаПодбораДокументовНФА", ПараметрыДляВыбора, Элементы.Приложения);
	
КонецПроцедуры

// СтандартныеПодсистемы.Свойства
&НаКлиенте
