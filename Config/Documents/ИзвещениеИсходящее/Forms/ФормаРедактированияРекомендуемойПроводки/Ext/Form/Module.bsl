&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаСведений = Параметры.ДатаСведений;
	Если ЗначениеЗаполнено(Параметры.КФО) Тогда
		КФО = Перечисления.КВД[Число(Параметры.КФО)-1];
	КонецЕсли;
	КПСДт = Параметры.КПСДт;
	КПСКт = Параметры.КПСКт;
	
	Если ЗначениеЗаполнено(Параметры.СчетДт) Тогда
		СчетДт = БухгалтерскийУчет.СчетПоКоду(Параметры.СчетДт, ДатаСведений);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.СчетКт) Тогда
		СчетКт = БухгалтерскийУчет.СчетПоКоду(Параметры.СчетКт, ДатаСведений);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.КЭКДт) Тогда
		КЭКДт = Справочники.КОСГУ.НайтиПоКоду(Параметры.КЭКДт);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.КЭККт) Тогда
		КЭККт = Справочники.КОСГУ.НайтиПоКоду(Параметры.КЭККт);
	КонецЕсли;
	Содержание = Параметры.Содержание;
	НомерПроводки = Параметры.НомерПроводки;
	НомерПроводкиПоПорядку = Параметры.НомерПроводкиПоПорядку;
	КоличествоПроводокОтправителя = Параметры.КоличествоПроводокОтправителя;
	Элементы.НомерПроводки.МаксимальноеЗначение = КоличествоПроводокОтправителя;
	
	Элементы.ПроводкаОтправителя.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Проводка отправителя № %1'"),
			НомерПроводки);
			
	ПроводкаОтправителя = Параметры.ПроводкаОтправителя;		
			
	ПроводкаПолучателя = ТекстПроводкиПолучателя();		
	
КонецПроцедуры
		
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Данные рекомендуемой проводки изменены, но не сохранены.
			|
			|Сохранить?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если ПеренестиВДокумент = Истина Тогда
		АдресДанныхПроводкиВХранилище = ПоместитьДанныеПроводкиВХранилище();
		
		Структура = Новый Структура("АдресДанныхПроводкиВХранилище", АдресДанныхПроводкиВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КПСДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КПСДтОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ВыбранноеЗначение =  СокрЛП(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КПСКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура КПСКтОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ВыбранноеЗначение =  СокрЛП(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();		
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

&НаКлиенте
Процедура КПСДтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

&НаКлиенте
Процедура КЭКДтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

&НаКлиенте
Процедура КПСКтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

&НаКлиенте
Процедура КЭККтПриИзменении(Элемент)
	
	ПроводкаПолучателя = ТекстПроводкиПолучателя();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	ЭтотОбъект.Закрыть(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);

КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеПроводкиВХранилище()
	ДанныеРекомендуемойПроводки = ДанныеРекомендуемойПроводки();
	
	Результат = ПоместитьВоВременноеХранилище(ДанныеРекомендуемойПроводки, УникальныйИдентификатор);

	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеРекомендуемойПроводки()
	Результат = Новый Структура;
	
	ТекстКФО = СокрЛП(КФО);
	ТекстСчетДт = СокрЛП(СчетДт);
	ТекстСчетКт = СокрЛП(СчетКт);
	ТекстКПСДт = КПСДт;
	ТекстКПСКт = КПСКт;
	ТекстКЭКДт = СокрЛП(КЭКДт);
	ТекстКЭККт = СокрЛП(КЭККт);
	
	Результат.Вставить("КФО", ТекстКФО);
	Результат.Вставить("СчетДт", ТекстСчетДт);
	Результат.Вставить("СчетКт", ТекстСчетКт);
	Результат.Вставить("КПСДт", КПСДт);
	Результат.Вставить("КПСКт", КПСКт);
	Результат.Вставить("КЭКДт", ТекстКЭКДт);
	Результат.Вставить("КЭККт", ТекстКЭККт);
	Результат.Вставить("Содержание", Содержание);
	Результат.Вставить("НомерПроводкиПоПорядку", НомерПроводкиПоПорядку);
	Результат.Вставить("НомерПроводки", НомерПроводки);
	
	Проводка = ЭлектронныеДокументыБГУ.ПредставлениеПроводкиИзвещения(ТекстКФО, ТекстКПСДт, ТекстСчетДт, ТекстКЭКДт, ТекстКПСКт, ТекстСчетКт, ТекстКЭККт); 
	
	Результат.Вставить("Проводка", Проводка);
	
	Возврат Результат; 
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПроводкиПолучателя()
	Результат = "";
	
	ПредставлениеСчетаДтПолучателя = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
		?(ЗначениеЗаполнено(КПСДт), КПСДт, НСтр("ru = 'XX'")), ?(ЗначениеЗаполнено(КФО), КФО, НСтр("ru = 'X'")), ?(ЗначениеЗаполнено(СчетДт), СчетДт, НСтр("ru = 'XXX.XX'")), ?(ЗначениеЗаполнено(КЭКДт), КЭКДт, НСтр("ru = 'XXX'")));
	
	ПредставлениеСчетаКтПолучателя = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
		?(ЗначениеЗаполнено(КПСКт), КПСКт, НСтр("ru = 'XX'")), ?(ЗначениеЗаполнено(КФО), КФО, НСтр("ru = 'X'")), ?(ЗначениеЗаполнено(СчетКт), СчетКт, НСтр("ru = 'XXX.XX'")), ?(ЗначениеЗаполнено(КЭККт), КЭККт, НСтр("ru = 'XXX'")));
		
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Дт %1 - Кт %2'"),
			ПредставлениеСчетаДтПолучателя, ПредставлениеСчетаКтПолучателя);
			
	Возврат Результат;		
КонецФункции	

#КонецОбласти




