#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидИзвещения = Параметры.ВидИзвещения;
	ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораПоВидуИзвещения(ВидИзвещения);
	ВидПодбора = ?(ЗначениеЗаполнено(ВидПодбора), ВидПодбора, "ТМЦ");
	ЗаДату = ?(ЗначениеЗаполнено(Параметры.ЗаДату), Параметры.ЗаДату, ОбщегоНазначения.ТекущаяДатаПользователя());
	НачалоПериода = ЗаДату;
	КонецПериода = ЗаДату;
	ОтборОрганизация = Параметры.Организация;
	ОтборПолучатель = Параметры.Получатель;
	
	УстановитьПараметрыПериода(ЭтотОбъект);
	УстановитьТекстЗапросаДинамическогоСпискаДокументов(ВидИзвещения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", ОтборОрганизация, , , 
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	Если ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораПоступленияНФА()
			Или ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораУточнениеПоступленияНФА()
			Или ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика() Тогда
		Если ЗначениеЗаполнено(Параметры.Поставщик) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Контрагент",
				Параметры.Поставщик, , , 
				Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		КонецЕсли;
	ИначеЕсли ЕстьРеквизитКонтрагент
			И ВидПодбора <> ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Контрагент", ОтборПолучатель,,,
			ЗначениеЗаполнено(ОтборПолучатель), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НачалоПериода", НачалоДня(ЗаДату), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонецПериода", 	КонецДня(ЗаДату), Истина);
	
	УстановитьЗаголовокФормы(ВидПодбора);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодНачалоПриИзменении(Элемент)
	УстановитьПараметрыПериода(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПериодКонецПриИзменении(Элемент)
	УстановитьПараметрыПериода(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(Неопределено, ТекущиеДанные.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериод(Команда)
	
	РедактированиеПериода = Новый ДиалогРедактированияСтандартногоПериода();
	РедактированиеПериода.Период = Новый СтандартныйПериод(НачалоПериода, КонецПериода);
	ВыбранныйПериод = Ждать РедактированиеПериода.РедактироватьАсинх();
	Если ВыбранныйПериод <> Неопределено Тогда
		НачалоПериода = ВыбранныйПериод.ДатаНачала;
		КонецПериода = ВыбранныйПериод.ДатаОкончания;
		Модифицированность = Истина;
		УстановитьПараметрыПериода(ЭтотОбъект);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовокФормы(ВидПодбора)
	Если ВидПодбора = "Платежи" Тогда
		Заголовок = НСтр("ru = 'Документы передачи денежных средств / документов'");
	ИначеЕсли ВидПодбора = "ПолучениеФинансовыхВложений"
			Или ВидПодбора = "ПередачаФинансовыхВложений" Тогда
		Заголовок = НСтр("ru = 'Документы передачи финансовых вложений'");
	ИначеЕсли ВидПодбора = "ПолучениеВложенийВФинансовыеАктивы"
			Или ВидПодбора = "ПередачаВложенийВФинансовыеАктивы" Тогда
		Заголовок = НСтр("ru = 'Документы передачи вложений в финансовые активы'");
	ИначеЕсли ВидПодбора = "СписаниеДоходовБудущихПериодов" Тогда
		Заголовок = НСтр("ru = 'Списание доходов будущих периодов'");
	ИначеЕсли ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораПоступленияНФА() Тогда
		Заголовок = НСтр("ru = 'Документы поступления НФА'");
	ИначеЕсли ВидПодбора = ЦентрализованноеСнабжениеКлиентСервер.ВидПодбораОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ() Тогда
		Заголовок = НСтр("ru = 'Документы разделения земельных участков'");
	Иначе
		Заголовок = НСтр("ru = 'Документы передачи ТМЦ'");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОВыбореСтроки(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Для каждого Строка Из Элементы.Список.ВыделенныеСтроки Цикл
		ОповеститьОВыборе(Элементы.Список.ДанныеСтроки(Строка).Ссылка);
	КонецЦикла; 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыПериода(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "НачалоПериода",	НачалоДня(Форма.НачалоПериода),	Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "КонецПериода",	КонецДня(Форма.КонецПериода),	Истина);

КонецПроцедуры // УстановитьПараметрыПериода()

&НаСервере
Процедура УстановитьТекстЗапросаДинамическогоСпискаДокументов(ВидИзвещения)

	ДополнительныеПараметрыСписка = Новый Структура;
	МассивТипов = Документы.ИзвещениеИсходящее.ТипыДокументовПередачиПоВидуИзвещения(ВидИзвещения);
	Если МассивТипов.Количество() = 0 Тогда
		МассивТипов = Документы.ИзвещениеИсходящее.ТипыДокументовПередачиПоВидуИзвещения(
			Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада);
	КонецЕсли;
	
	НомерЗапроса = 1;
	
	ТекстыЗапроса = Новый Массив;
	
	НастройкиПроверкиОборотовПоСчетам = Документы.ИзвещениеИсходящее.НастройкиПроверкиОборотовПоСчетам();
	
	Для каждого ТипДокумента Из МассивТипов Цикл
		
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВыбираемыйДокумент.Ссылка КАК Ссылка,
		|	ВыбираемыйДокумент.Дата КАК Дата,
		|	ВыбираемыйДокумент.Организация КАК Организация,
		|	&ПолеИФО КАК ИФО,
		|	&ПолеКонтрагент КАК Контрагент,
		|	&ПолеДоговор КАК Договор,
		|	&ЗаказчикПоКонтракту КАК ЗаказчикПоКонтракту,
		|	ОперацииДокументов.Операция КАК Операция,
		|	""&ПредставлениеДокумента"" КАК ВидДокумента
		|ИЗ
		|	#ВидДокумента КАК ВыбираемыйДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|		ПО ВыбираемыйДокумент.Ссылка = ОперацииДокументов.Документ
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ОперацииДокументов.Документ) = &ТипДокумента
		|	И ВыбираемыйДокумент.Дата >= &НачалоПериода
		|	И ВыбираемыйДокумент.Дата <= &КонецПериода";
		Если МетаданныеДокумента.Реквизиты.Найти("ИФО") <> Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИФО" , "ВыбираемыйДокумент.ИФО");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИФО" , "NULL");
		КонецЕсли;
		Если МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			ЕстьРеквизитКонтрагент = Истина;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент" , "ВыбираемыйДокумент.Контрагент");
		ИначеЕсли МетаданныеДокумента.Реквизиты.Найти("КонтрагентДокумента") <> Неопределено Тогда
			ЕстьРеквизитКонтрагент = Истина;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент" , "ВыбираемыйДокумент.КонтрагентДокумента");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент" , "NULL");
		КонецЕсли;
		Если МетаданныеДокумента.Реквизиты.Найти("ЗаказчикПоКонтракту") <> Неопределено Тогда
			ЕстьРеквизитЗаказчикПоКонтракту = Истина;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЗаказчикПоКонтракту" , "ВыбираемыйДокумент.ЗаказчикПоКонтракту");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЗаказчикПоКонтракту" , "NULL");
		КонецЕсли;
		Если МетаданныеДокумента.Реквизиты.Найти("Договор") <> Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор" , "ВыбираемыйДокумент.Договор");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор" , "NULL");
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПредставлениеДокумента" , МетаданныеДокумента.Представление());
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ВидДокумента" , МетаданныеДокумента.ПолноеИмя());
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипДокумента" , "ТИП(" + МетаданныеДокумента.ПолноеИмя() + ")");
		
		НастройкаОборотов = НастройкиПроверкиОборотовПоСчетам.Найти(ТипДокумента, "ТипДокумента");
		Если НастройкаОборотов <> Неопределено Тогда
			
			РазделительВложенныхУсловий = "";
			ТекстЗапроса = ТекстЗапроса + "	
			|	И ИСТИНА В
			|		(ВЫБРАТЬ ПЕРВЫЕ 1
			|			Истина
			|		ИЗ
			|			РегистрБухгалтерии.ЖурналПроводокЕПСБУ Как ЖурналПроводокЕПСБУ
			|		ГДЕ
			|			ЖурналПроводокЕПСБУ.Регистратор = ВыбираемыйДокумент.Ссылка
			|			И (";
			Если ЗначениеЗаполнено(НастройкаОборотов.СтрокаСчетовДт) Тогда
				ТекстЗапроса = ТекстЗапроса + "ЖурналПроводокЕПСБУ.СчетДт В (&СчетаДт" + НомерЗапроса + ")";
				РазделительВложенныхУсловий = "
				|			ИЛИ ";
				ДополнительныеПараметрыСписка.Вставить("СчетаДт" + НомерЗапроса, БухгалтерскийУчет.СписокСчетов(НастройкаОборотов.СтрокаСчетовДт));
			КонецЕсли;
			Если ЗначениеЗаполнено(НастройкаОборотов.СтрокаСчетовКт) Тогда
				ТекстЗапроса = ТекстЗапроса + РазделительВложенныхУсловий + "ЖурналПроводокЕПСБУ.СчетКт В (&СчетаКт" + НомерЗапроса + ")";
				ДополнительныеПараметрыСписка.Вставить("СчетаКт" + НомерЗапроса, БухгалтерскийУчет.СписокСчетов(НастройкаОборотов.СтрокаСчетовКт));
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса + "))";
			
		КонецЕсли;
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
		НомерЗапроса = НомерЗапроса + 1;
	
	КонецЦикла; 
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все"));
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
	Для каждого ДополнительныйПараметр Из ДополнительныеПараметрыСписка Цикл
	
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, ДополнительныйПараметр.Ключ, ДополнительныйПараметр.Значение, Истина);
	
	КонецЦикла; 
		

КонецПроцедуры // УстановитьТекстЗапросаДинамическогоСпискаДокументов()

#КонецОбласти
