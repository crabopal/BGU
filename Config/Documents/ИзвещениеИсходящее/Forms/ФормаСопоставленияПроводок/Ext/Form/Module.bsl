&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Параметры.Организация;
	ДатаСведений = Параметры.ДатаСведений;
	ИсходящееИзвещение = Параметры.ИсходящееИзвещение;
	ОтветноеИзвещение = Параметры.ОтветноеИзвещение;
	
	Предупреждение = НСтр("ru = 'Данная форма предназначена для ручного сопоставления проводок в печатной форме ""Электронное извещение (ф.0504805)"".
	|Если сопоставление проводок выполнено вручную, то автоматическое сопоставление проводок не производится.'");
	
	ЗагрузитьСписокПереданныхПроводокИзДокумента(Параметры.АдресТаблицыСопоставленияПроводок);
	
	Если ЗначениеЗаполнено(ИсходящееИзвещение.ВходящееИзвещение) Тогда
		ОтправленноеИзвещение = ИсходящееИзвещение.ВходящееИзвещение;
		ВидимостьДляОтветногоИзвещения = Ложь;
	Иначе
		ОтправленноеИзвещение = ИсходящееИзвещение;
		ВидимостьДляОтветногоИзвещения = Истина;
	КонецЕсли;

	ТипЭлектронногоИзвещения = 0;
	Если ЗначениеЗаполнено(ИсходящееИзвещение) Тогда
		ТипЭлектронногоИзвещения = ИсходящееИзвещение.ТипЭлектронногоИзвещения;	
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаВосстановитьСопоставлениеПоДаннымПолучателя",
		"Видимость", ВидимостьДляОтветногоИзвещения);
	
	ДанныеЭДОтправленногоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(ОтправленноеИзвещение);
	
	Если ДанныеЭДОтправленногоИзвещения = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ШаблонДтКт = НСтр("ru = 'Дт %1 - Кт %2'");
	ШаблонДт = НСтр("ru = 'Дт %1'");
	ШаблонКт = НСтр("ru = 'Кт %2'");
	
	Для Каждого ТекСтрока Из ДанныеЭДОтправленногоИзвещения.ТаблицаПроводок Цикл
		НоваяСтрока = ПроводкиОтправителя.Добавить();
		Содержание = ТекСтрока.пСодержание;
		НомерПроводки = "";
		ПозицияТочки = Найти(ТекСтрока.пСодержание, ".");
		Если ПозицияТочки > 0 Тогда
			НомерПроводки = Сред(ТекСтрока.пСодержание, 0, ПозицияТочки-1);
			Содержание = СокрЛП(Сред(ТекСтрока.пСодержание, ПозицияТочки+1));
		КонецЕсли;	
		
		НоваяСтрока.НомерПроводки = Число(НомерПроводки);
		НоваяСтрока.Содержание = Содержание;
		
		ШаблонПроводки = ШаблонДтКт;
		Если ТипЭлектронногоИзвещения = 20 ИЛИ ТипЭлектронногоИзвещения = 23 ИЛИ ТипЭлектронногоИзвещения = 25 ИЛИ ТипЭлектронногоИзвещения = 27 ИЛИ ТипЭлектронногоИзвещения = 29 Тогда
			НоваяСтрока.Сумма = Число(ТекСтрока.пСуммаПолучатель);
			Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пДебетСчетПолучатель)) Тогда
				ШаблонПроводки = ШаблонКт;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пКредитСчетПолучатель)) Тогда
				ШаблонПроводки = ШаблонДт;
			КонецЕсли;
			
			Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПроводки,
					ТекСтрока.пДебетСчетПолучатель, ТекСтрока.пКредитСчетПолучатель);			
		Иначе
			Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пДебетСчетОтправитель)) Тогда
				ШаблонПроводки = ШаблонКт;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пКредитСчетОтправитель)) Тогда
				ШаблонПроводки = ШаблонДт;
			КонецЕсли;
					
			НоваяСтрока.Сумма = Число(ТекСтрока.пСуммаОтправитель);
			Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПроводки,
					ТекСтрока.пДебетСчетОтправитель, ТекСтрока.пКредитСчетОтправитель);			
		КонецЕсли;	
		
		НоваяСтрока.Проводка = Проводка;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИсходящееИзвещение.ВходящееИзвещение) Тогда
		СтруктураДанных = Документы.ИзвещениеИсходящее.ПодготовитьДанныеДляЭД(ИсходящееИзвещение);
		ПередаваемыеПроводки = СтруктураДанных.ПередаваемыеПроводки;
		ПроводкиПоДокументам = Ложь;
		Если (ПередаваемыеПроводки = Неопределено) Тогда
			ПроводкиПоДокументам = Истина;
		Иначе
			Если ПередаваемыеПроводки.Количество() = 0 Тогда
				ПроводкиПоДокументам = Истина;
			КонецЕсли;
		КонецЕсли;
		Если ПроводкиПоДокументам Тогда
			ПередаваемыеПроводки = ЭлектронныеДокументыБГУ.ПроводкиПоДокументамПередачи(ИсходящееИзвещение.ДокументыПередачи, ИсходящееИзвещение);
			ПередаваемыеПроводки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка"));
			НомерСтроки = 0;
			Для Каждого ТекСтрока Из ПередаваемыеПроводки Цикл
				НомерСтроки = НомерСтроки + 1;
				ТекСтрока.НомерСтроки = Строка(НомерСтроки);
			КонецЦикла;	
		КонецЕсли;	

		Для Каждого ТекСтрока Из ПередаваемыеПроводки Цикл
			ШаблонПроводки = ШаблонДтКт;
			НоваяСтрока = ПроводкиПолучателя.Добавить();
			
			ПредставлениеСчетаДт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
				ТекСтрока.КПСДт, ТекСтрока.КФО, ТекСтрока.СчетДт, ТекСтрока.КЭКДт);
			
			ПредставлениеСчетаКт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
				ТекСтрока.КПСКт, ТекСтрока.КФО, ТекСтрока.СчетКт, ТекСтрока.КЭККт);
				
			НомерПроводки = ТекСтрока.НомерСтроки; 	
			НоваяСтрока.НомерПроводки = Число(НомерПроводки);
			
			Содержание = ТекСтрока.Содержание;
			НоваяСтрока.Содержание = Содержание;
			НоваяСтрока.Сумма = ТекСтрока.Сумма;
			
			Если НЕ ЗначениеЗаполнено(СокрЛП(ПредставлениеСчетаДт)) Тогда
				ШаблонПроводки = ШаблонКт;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СокрЛП(ПредставлениеСчетаКт)) Тогда
				ШаблонПроводки = ШаблонДт;
			КонецЕсли;
			
			Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПроводки,
					ПредставлениеСчетаДт, ПредставлениеСчетаКт);			
			
			НоваяСтрока.Проводка = Проводка;
			
		КонецЦикла;
	Иначе
		//Отправленное извещение
		Если ЗначениеЗаполнено(ОтветноеИзвещение) Тогда
			ДанныеЭДОтветногоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(ОтветноеИзвещение);
			
			Для Каждого ТекСтрока Из ДанныеЭДОтветногоИзвещения.ТаблицаПроводок Цикл
				ШаблонПроводки = ШаблонДтКт;
				НоваяСтрока = ПроводкиПолучателя.Добавить();
				Содержание = ТекСтрока.пСодержание;
				НомерПроводки = "";
				ПозицияТочки = Найти(ТекСтрока.пСодержание, ".");
				Если ПозицияТочки > 0 Тогда
					НомерПроводки = Сред(ТекСтрока.пСодержание, 0, ПозицияТочки-1);
					Содержание = СокрЛП(Сред(ТекСтрока.пСодержание, ПозицияТочки+1));
				КонецЕсли;	
				
				НоваяСтрока.НомерПроводки = Число(НомерПроводки);
				НоваяСтрока.Содержание = Содержание;
				НоваяСтрока.Сумма = Число(ТекСтрока.пСуммаОтправитель);
				
				Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пДебетСчетОтправитель)) Тогда
					ШаблонПроводки = ШаблонКт;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СокрЛП(ТекСтрока.пКредитСчетОтправитель)) Тогда
					ШаблонПроводки = ШаблонДт;
				КонецЕсли;
				
				Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПроводки,
						ТекСтрока.пДебетСчетОтправитель, ТекСтрока.пКредитСчетОтправитель);			
				
				НоваяСтрока.Проводка = Проводка;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	СопоставлениеПроводок = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыСопоставленияПроводок);
	Если СопоставлениеПроводок.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ОтветноеИзвещение) Тогда
			СопоставлениеПроводок = ОтветноеИзвещение.СопоставлениеПроводок.Выгрузить();
		КонецЕсли;	
	КонецЕсли;	
	СопоставлениеИзДокумента.Загрузить(СопоставлениеПроводок);
	
	СопоставлениеНеОпределено = Истина;
	Если СопоставлениеПроводок.Количество() > 0 Тогда
		СопоставлениеНеОпределено = Ложь;
		Для Каждого ТекСтрока Из СопоставлениеПроводок Цикл
			НомераПроводокОтправителя = СтрРазделить(ТекСтрока.НомераПроводокОтправителя, ",", Ложь);
			НомераПроводокПолучателя = СтрРазделить(ТекСтрока.НомераПроводокПолучателя, ",", Ложь);
			КомментарииСопоставления = СтрРазделить(ТекСтрока.КомментарийСопоставления, ";", Истина);
			
			Если НомераПроводокОтправителя.Количество() = 1 Тогда
				Если НомераПроводокПолучателя.Количество() = 1 Тогда
					НомерПроводкиОтправителя = Число(НомераПроводокОтправителя[0]);
					НомерПроводкиПолучателя = Число(НомераПроводокПолучателя[0]);
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("НомерПроводки", НомерПроводкиПолучателя);
					НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						Для Каждого ТекПроводка Из НайденныеСтроки Цикл
							ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиОтправителя;
							ТекПроводка.Комментарий = ТекСтрока.КомментарийСопоставления;
						КонецЦикла;	
					КонецЕсли;
				ИначеЕсли НомераПроводокПолучателя.Количество() > 1 Тогда
					НомерПроводкиОтправителя = Число(НомераПроводокОтправителя[0]);
					
					НомераПроводокПолучателяДляОтбора = Новый Массив;
					Для Каждого ТекНомер Из НомераПроводокПолучателя Цикл
						НомераПроводокПолучателяДляОтбора.Добавить(Число(ТекНомер));
					КонецЦикла;
					
					Для Каждого ТекПроводка Из ПроводкиПолучателя Цикл
						ИндексНайденногоЗначения = НомераПроводокПолучателяДляОтбора.Найти(ТекПроводка.НомерПроводки);
						Если ИндексНайденногоЗначения <> Неопределено Тогда
							ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиОтправителя;
							Если ТекПроводка.НомерПроводки <= КомментарииСопоставления.Количество() Тогда
								ТекПроводка.Комментарий = КомментарииСопоставления[ТекПроводка.НомерПроводки-1];
							КонецЕсли;
						КонецЕсли;	
					КонецЦикла;	
					
				КонецЕсли;	
			ИначеЕсли НомераПроводокОтправителя.Количество() > 1 Тогда
				Если НомераПроводокПолучателя.Количество() = 1 Тогда
					НомерПроводкиПолучателя = Число(НомераПроводокПолучателя[0]);
					
					НомераПроводокОтправителяДляОтбора = Новый Массив;
					Для Каждого ТекНомер Из НомераПроводокОтправителя Цикл
						НомераПроводокОтправителяДляОтбора.Добавить(Число(ТекНомер));
					КонецЦикла;
					
					Для Каждого ТекПроводка Из ПроводкиОтправителя Цикл
						ИндексНайденногоЗначения = НомераПроводокОтправителяДляОтбора.Найти(ТекПроводка.НомерПроводки);
						Если ИндексНайденногоЗначения <> Неопределено Тогда
							ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиПолучателя;
						КонецЕсли;	
					КонецЦикла;
					
					Если НомерПроводкиПолучателя <= КомментарииСопоставления.Количество() Тогда
						ПроводкиПолучателя[НомерПроводкиПолучателя-1].Комментарий = КомментарииСопоставления[НомерПроводкиПолучателя-1];
					КонецЕсли;
					
				ИначеЕсли НомераПроводокПолучателя.Количество() > 1 Тогда
					
				КонецЕсли;	
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	СопоставилиПроводку = Ложь;
	Если СопоставлениеНеОпределено Тогда
		Для Каждого ТекПроводкаОтправителя Из ПроводкиОтправителя Цикл
			СопоставилиПроводку = Ложь;
			ТекНомер = ТекПроводкаОтправителя.НомерПроводки;
			ТекСумма = ТекПроводкаОтправителя.Сумма;
			Для Каждого ТекСтрока Из ПроводкиПолучателя Цикл
				Если ТекСтрока.НомерПроводкиУчастникаОбмена = 0 Тогда
					ТекСуммаПолучателя = ТекСтрока.Сумма;
					Если ТекСумма = ТекСуммаПолучателя Тогда 
						ТекСтрока.НомерПроводкиУчастникаОбмена = ТекНомер;
						СопоставилиПроводку = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если СопоставилиПроводку Тогда
				Продолжить;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ПеренестиВДокумент = Истина Тогда
		АдресСопоставленияПроводокВХранилище = ПоместитьСопоставлениеПроводокВХранилище();
		
		Структура = Новый Структура("АдресСопоставленияПроводокВХранилище", АдресСопоставленияПроводокВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Настройки сопоставления проводок отправителя и получателя изменены, но не перенесены в документ.
			|
			|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
    РезультатПроверки = ПроверкаКорректностиСопоставления();
	
	Если ТипЗнч(РезультатПроверки) = Тип("Структура") Тогда
		ОшибочныеНомераПроводокОтправителя = РезультатПроверки.ОшибочныеНомераПроводокОтправителя;
		ОшибочныеНомераПроводокПолучателя = РезультатПроверки.ОшибочныеНомераПроводокПолучателя;
		Если НЕ (ОшибочныеНомераПроводокОтправителя = "" И ОшибочныеНомераПроводокПолучателя = "") Тогда
			ПоказатьПредупреждение(Неопределено, СтрШаблон(РезультатПроверки.ТекстПредупреждения, ОшибочныеНомераПроводокОтправителя, ОшибочныеНомераПроводокПолучателя));
		
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);

КонецПроцедуры

&НаКлиенте
Процедура УказатьНомерПроводкиУПолучателя(Команда)
	ПроводкиПолучателяПоНомерам = Новый СписокЗначений;
	ПроводкиПолучателяПоНомерам.Добавить("0", НСтр("ru = 'Не определено'"));
	
	Для Каждого ТекСтрока Из ПроводкиПолучателя Цикл
		Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. %2 руб. %3 %4'"),
			ТекСтрока.НомерПроводки, ТекСтрока.Сумма, ТекСтрока.Проводка, ТекСтрока.Содержание);			

		ПроводкиПолучателяПоНомерам.Добавить(Строка(ТекСтрока.НомерПроводки), Проводка);
	КонецЦикла;	
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияНомераПроводкиУПолучателя", ЭтаФорма);
	ПроводкиПолучателяПоНомерам.ПоказатьВыборЭлемента(Оповещение, "Выберите проводку получателя");
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьНомерПроводкиУОтправителя(Команда)
	
	ПроводкиОтправителяПоНомерам = Новый СписокЗначений;
	ПроводкиОтправителяПоНомерам.Добавить("0", НСтр("ru = 'Не определено'"));
	
	Для Каждого ТекСтрока Из ПроводкиОтправителя Цикл
		Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. %2 руб. %3 %4'"),
			ТекСтрока.НомерПроводки, ТекСтрока.Сумма, ТекСтрока.Проводка, ТекСтрока.Содержание);			

		ПроводкиОтправителяПоНомерам.Добавить(Строка(ТекСтрока.НомерПроводки), Проводка);
	КонецЦикла;	
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияНомераПроводкиУОтправителя", ЭтаФорма);
	ПроводкиОтправителяПоНомерам.ПоказатьВыборЭлемента(Оповещение, "Выберите проводку отправителя");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоменятьНомераПроводокУОтправителяМестами(Команда)
	
	МассивСтрок = Элементы.ПроводкиПолучателя.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 2 Тогда
		ПерваяСтр = ПроводкиПолучателя.НайтиПоИдентификатору(МассивСтрок[0]);
		ВтораяСтр = ПроводкиПолучателя.НайтиПоИдентификатору(МассивСтрок[1]);
		
		НомерПервой = ПерваяСтр.НомерПроводкиУчастникаОбмена;
		ПерваяСтр.НомерПроводкиУчастникаОбмена = ВтораяСтр.НомерПроводкиУчастникаОбмена;
		ВтораяСтр.НомерПроводкиУчастникаОбмена = НомерПервой;
		
		Модифицированность = Истина;
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Необходимо выбрать 2 проводки получателя и повторить операцию'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УказатьНомерВыбраннойПроводкиУОтправителя(Команда)
	МассивСтрок = Элементы.ПроводкиОтправителя.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 1 Тогда
		ПерваяСтр = ПроводкиПолучателя.НайтиПоИдентификатору(МассивСтрок[0]);
		НомерВыбраннойПроводки = ПерваяСтр.НомерПроводки;
		Если ЗначениеЗаполнено(НомерВыбраннойПроводки) Тогда
			МассивСтрокПолучателя = Элементы.ПроводкиПолучателя.ВыделенныеСтроки;
			Если МассивСтрокПолучателя.Количество() > 0 Тогда
				Для Каждого ТекПроводка Из МассивСтрокПолучателя Цикл
					ПроводкаПолучена = ПроводкиПолучателя.НайтиПоИдентификатору(ТекПроводка);
					ПроводкаПолучена.НомерПроводкиУчастникаОбмена = НомерВыбраннойПроводки;
				КонецЦикла;
			Иначе
				ТекстПредупреждения = НСтр("ru = 'Необходимо выбрать проводки получателя и повторить операцию'");
				ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
				
				Возврат;
			КонецЕсли;
		КонецЕсли;	
		
		Модифицированность = Истина;
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Необходимо выбрать 1 проводку отправителя и повторить операцию'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьВсеБезНомераУОтправителя(Команда)
	ЭтотОбъект.ИспользоватьОтборПроводокПолучателя = Ложь;
	ЭтотОбъект.ИспользоватьОтборНесопоставленныхПроводокПолучателя = НЕ ЭтотОбъект.ИспользоватьОтборНесопоставленныхПроводокПолучателя;
	Элементы.ПроводкиПолучателя.ОтборСтрок = Неопределено;
	Если ЭтотОбъект.ИспользоватьОтборНесопоставленныхПроводокПолучателя Тогда
		Если Элементы.ПроводкиПолучателя.ТекущиеДанные <> Неопределено Тогда
			ОтборПроводокПолучателя(0);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьПоНомеруУОтправителя(Команда)
	ЭтотОбъект.ИспользоватьОтборНесопоставленныхПроводокПолучателя = Ложь;
	ЭтотОбъект.ИспользоватьОтборПроводокПолучателя = НЕ ЭтотОбъект.ИспользоватьОтборПроводокПолучателя;
	Элементы.ПроводкиПолучателя.ОтборСтрок = Неопределено;
	Если ЭтотОбъект.ИспользоватьОтборПроводокПолучателя Тогда
		Если Элементы.ПроводкиПолучателя.ТекущиеДанные <> Неопределено Тогда
			ОтборПроводокПолучателя(Элементы.ПроводкиОтправителя.ТекущиеДанные.НомерПроводки);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтбор(Команда)
	
	Элементы.ПроводкиПолучателя.ОтборСтрок = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСопоставлениеПоДаннымПолучателя(Команда)
	ВосстановитьСопоставлениеПоДаннымПолучателяНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Модифицированность = Истина;
		Закрыть();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокПереданныхПроводокИзДокумента(АдресОбъектовВХранилище)
	Если ЭтоАдресВременногоХранилища(АдресОбъектовВХранилище) Тогда
		СопоставлениеПроводокИзДокумента = ПолучитьИзВременногоХранилища(АдресОбъектовВХранилище);
		СопоставлениеИзДокумента.Загрузить(СопоставлениеПроводокИзДокумента);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияНомераПроводкиУПолучателя(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент = Неопределено Тогда
        Сообщить(НСтр("ru='Проводка получателя не выбрана.'"));
    Иначе
        ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
		
		МассивСтрок = Элементы.ПроводкиОтправителя.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = ПроводкиОтправителя.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.НомерПроводкиУчастникаОбмена = Число(ВыбранноеЗначение);
			КонецЕсли;
		КонецЦикла;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияНомераПроводкиУОтправителя(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент = Неопределено Тогда
        Сообщить(НСтр("ru='Проводка отправителя не выбрана.'"));
    Иначе
        ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
		
		МассивСтрок = Элементы.ПроводкиПолучателя.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = ПроводкиПолучателя.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.НомерПроводкиУчастникаОбмена = Число(ВыбранноеЗначение);
			КонецЕсли;
		КонецЦикла;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СопоставлениеПроводокДляДокумента()
	СопоставлениеПроводокДляДокумента = Новый ТаблицаЗначений;
	СопоставлениеПроводокДляДокумента.Колонки.Добавить("НомераПроводокОтправителя", Новый ОписаниеТипов("Строка"));
	СопоставлениеПроводокДляДокумента.Колонки.Добавить("НомераПроводокПолучателя", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ТекСтрока Из ПроводкиОтправителя Цикл
		Если ЗначениеЗаполнено(ТекСтрока.НомерПроводкиУчастникаОбмена) Тогда
			СопоставленныеПроводкиОтправителя = Новый Массив;
			СопоставленныеПроводкиПолучателя = Новый Массив;
			СопоставленныеПроводкиПолучателя.Добавить(Строка(ТекСтрока.НомерПроводкиУчастникаОбмена));
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводкиУчастникаОбмена", ТекСтрока.НомерПроводкиУчастникаОбмена);
			НайденныеСтроки = ПроводкиОтправителя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				Для Каждого ТекПроводка Из НайденныеСтроки Цикл
					СопоставленныеПроводкиОтправителя.Добавить(Строка(ТекПроводка.НомерПроводки));
				КонецЦикла;
				Если СопоставленныеПроводкиОтправителя.Количество()>0 Тогда
					НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
					НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
					НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
				КонецЕсли;
			Иначе
				СопоставленныеПроводкиОтправителя.Добавить(Строка(ТекПроводка.НомерПроводки));
				СопоставленныеПроводкиПолучателя.Добавить("0");
				
				НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
				НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
				НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
			КонецЕсли;
		Иначе
			СопоставленныеПроводкиОтправителя = Новый Массив;
			СопоставленныеПроводкиПолучателя = Новый Массив;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводкиУчастникаОбмена", ТекСтрока.НомерПроводки);
			НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СопоставленныеПроводкиОтправителя.Добавить(Строка(ТекСтрока.НомерПроводки));
				СопоставленныеПроводкиПолучателя.Добавить("0");
				
				НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
				НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
				НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ПроводкиПолучателя Цикл
		Если ЗначениеЗаполнено(ТекСтрока.НомерПроводкиУчастникаОбмена) Тогда
			СопоставленныеПроводкиПолучателя = Новый Массив;
			СопоставленныеПроводкиОтправителя = Новый Массив;
			СопоставленныеПроводкиОтправителя.Добавить(Строка(ТекСтрока.НомерПроводкиУчастникаОбмена));
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводкиУчастникаОбмена", ТекСтрока.НомерПроводкиУчастникаОбмена);
			НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				Для Каждого ТекПроводка Из НайденныеСтроки Цикл
					СопоставленныеПроводкиПолучателя.Добавить(ТекПроводка.НомерПроводки);
				КонецЦикла;
				Если СопоставленныеПроводкиПолучателя.Количество()>0 Тогда
					НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
					НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
					НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
				КонецЕсли;
			Иначе
				СопоставленныеПроводкиОтправителя.Добавить("0");
				СопоставленныеПроводкиПолучателя.Добавить(Строка(ТекПроводка.НомерПроводки));
				
				НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
				НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
				НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
			КонецЕсли;
		Иначе
			СопоставленныеПроводкиОтправителя = Новый Массив;
			СопоставленныеПроводкиПолучателя = Новый Массив;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводкиУчастникаОбмена", ТекСтрока.НомерПроводки);
			НайденныеСтроки = ПроводкиОтправителя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СопоставленныеПроводкиОтправителя.Добавить("0");
				СопоставленныеПроводкиПолучателя.Добавить(Строка(ТекСтрока.НомерПроводки));
				
				НоваяСтрока = СопоставлениеПроводокДляДокумента.Добавить();
				НоваяСтрока.НомераПроводокОтправителя = СтрСоединить(СопоставленныеПроводкиОтправителя, ",");
				НоваяСтрока.НомераПроводокПолучателя = СтрСоединить(СопоставленныеПроводкиПолучателя, ",");
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	СопоставлениеПроводокДляДокумента.Свернуть("НомераПроводокОтправителя, НомераПроводокПолучателя");
	СопоставлениеПроводокДляДокумента.Сортировать("НомераПроводокОтправителя");
	
	СопоставлениеПроводокДляДокумента.Колонки.Добавить("КомментарийСопоставления", Новый ОписаниеТипов("Строка"));

	Для Каждого ТекСтрока Из СопоставлениеПроводокДляДокумента Цикл
		НомераПроводокПолучателя = СтрРазделить(ТекСтрока.НомераПроводокПолучателя, ",", Ложь);
		НомерПроводки = 0;
		СоставнойКомментарий = Новый Массив;
		Если НомераПроводокПолучателя.Количество() > 0 Тогда
			Для Каждого ТекПр Из НомераПроводокПолучателя Цикл 
				НомерПроводки = Число(ТекПр);
			
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("НомерПроводки", НомерПроводки);
				НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Для Каждого ТекНашлиСтроку Из НайденныеСтроки Цикл
						СоставнойКомментарий.Добавить(ТекНашлиСтроку.Комментарий);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
		ТекСтрока.КомментарийСопоставления = СтрСоединить(СоставнойКомментарий, ";");
	КонецЦикла;	
	
	Возврат СопоставлениеПроводокДляДокумента;
КонецФункции

&НаСервере
Функция ПоместитьСопоставлениеПроводокВХранилище()
	СопоставлениеПроводокДляДокумента = СопоставлениеПроводокДляДокумента();
	
	Результат = ПоместитьВоВременноеХранилище(СопоставлениеПроводокДляДокумента, УникальныйИдентификатор);

	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверкаКорректностиСопоставления()
	СопоставлениеПроводокДляДокумента = СопоставлениеПроводокДляДокумента();
	
	СтруктураСведенийОбОшибке = Новый Структура;
	КонтрольПройден = Истина;
	
	КонтрольКорректностиНомеровСопоставленияПройден(СопоставлениеПроводокДляДокумента, СтруктураСведенийОбОшибке, КонтрольПройден);
	Если НЕ КонтрольПройден Тогда
		Возврат СтруктураСведенийОбОшибке;
	Иначе
		КонтрольКорректностиСопоставленияПройден(СопоставлениеПроводокДляДокумента, СтруктураСведенийОбОшибке, КонтрольПройден);
		Если НЕ КонтрольПройден Тогда
			Возврат СтруктураСведенийОбОшибке;
		КонецЕсли;	
	КонецЕсли;	

	Возврат СтруктураСведенийОбОшибке;
	
КонецФункции

&НаСервере
Процедура КонтрольКорректностиНомеровСопоставленияПройден(СопоставлениеПроводокДляДокумента, СтруктураСведенийОбОшибке, РезультатКонтроля)
	
	МассивСведенийОбОшибкеОтправителя = Новый Массив;
	МассивСведенийОбОшибкеПолучателя = Новый Массив;
	
	Для Каждого ТекСтрока Из ПроводкиОтправителя Цикл
		Если ТекСтрока.НомерПроводкиУчастникаОбмена <> 0 Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводки", ТекСтрока.НомерПроводкиУчастникаОбмена);
			НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				РезультатКонтроля = Ложь;
				МассивСведенийОбОшибкеОтправителя.Добавить(ТекСтрока.НомерПроводкиУчастникаОбмена);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ПроводкиПолучателя Цикл
		Если ТекСтрока.НомерПроводкиУчастникаОбмена <> 0 Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерПроводки", ТекСтрока.НомерПроводкиУчастникаОбмена);
			НайденныеСтроки = ПроводкиОтправителя.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				РезультатКонтроля = Ложь;
				МассивСведенийОбОшибкеПолучателя.Добавить(ТекСтрока.НомерПроводкиУчастникаОбмена);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	СтруктураСведенийОбОшибке.Вставить("ОшибочныеНомераПроводокОтправителя", СтрСоединить(МассивСведенийОбОшибкеОтправителя, ","));
	СтруктураСведенийОбОшибке.Вставить("ОшибочныеНомераПроводокПолучателя", СтрСоединить(МассивСведенийОбОшибкеПолучателя, ","));
	
	ТекстПредупреждения = НСтр("ru = 'Контроль корректности не пройден (для отправителя указаны отсутствующие проводки получателя: %1,
	|(для получателя указаны отсутствующие проводки отправителя: %2. Требуется скорректировать номера проводок и повторить операцию.'");
	
	СтруктураСведенийОбОшибке.Вставить("ТекстПредупреждения", ТекстПредупреждения);
	
КонецПроцедуры	

&НаСервере
Процедура КонтрольКорректностиСопоставленияПройден(СопоставлениеПроводокДляДокумента, СтруктураСведенийОбОшибке, РезультатКонтроля)
	ТаблицаПроверкиПроводокОтправителя = Новый ТаблицаЗначений;
	ТаблицаПроверкиПроводокОтправителя.Колонки.Добавить("НомерПроводки", Новый ОписаниеТипов("Строка"));
	ТаблицаПроверкиПроводокОтправителя.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	ТаблицаПроверкиПроводокПолучателя = Новый ТаблицаЗначений;
	ТаблицаПроверкиПроводокПолучателя.Колонки.Добавить("НомерПроводки", Новый ОписаниеТипов("Строка"));
	ТаблицаПроверкиПроводокПолучателя.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из СопоставлениеПроводокДляДокумента Цикл
		НомераПроводок = СтрРазделить(ТекСтрока.НомераПроводокОтправителя, ",", Ложь);
		Для Каждого ТекПроводка Из НомераПроводок Цикл
			НоваяСтрока = ТаблицаПроверкиПроводокОтправителя.Добавить();
			НоваяСтрока.НомерПроводки = ТекПроводка;
			НоваяСтрока.Количество = 1;
		КонецЦикла;	
		НомераПроводок = СтрРазделить(ТекСтрока.НомераПроводокПолучателя, ",", Ложь);
		Для Каждого ТекПроводка Из НомераПроводок Цикл
			НоваяСтрока = ТаблицаПроверкиПроводокПолучателя.Добавить();
			НоваяСтрока.НомерПроводки = ТекПроводка;
			НоваяСтрока.Количество = 1;
		КонецЦикла;	
	КонецЦикла;
	
	ТаблицаПроверкиПроводокОтправителя.Свернуть("НомерПроводки", "Количество");
	ТаблицаПроверкиПроводокПолучателя.Свернуть("НомерПроводки", "Количество");
	
	МассивСведенийОбОшибкеОтправителя = Новый Массив;
	МассивСведенийОбОшибкеПолучателя = Новый Массив;
	
	Для Каждого ТекСтрока Из ТаблицаПроверкиПроводокОтправителя Цикл
		Если ТекСтрока.Количество > 1 Тогда
			РезультатКонтроля = Ложь;
			МассивСведенийОбОшибкеОтправителя.Добавить(ТекСтрока.НомерПроводки);
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ТаблицаПроверкиПроводокПолучателя Цикл
		Если ТекСтрока.Количество > 1 Тогда
			РезультатКонтроля = Ложь;
			МассивСведенийОбОшибкеПолучателя.Добавить(ТекСтрока.НомерПроводки);
		КонецЕсли;	
	КонецЦикла;	
	
	СтруктураСведенийОбОшибке.Вставить("ОшибочныеНомераПроводокОтправителя", СтрСоединить(МассивСведенийОбОшибкеОтправителя, ","));
	СтруктураСведенийОбОшибке.Вставить("ОшибочныеНомераПроводокПолучателя", СтрСоединить(МассивСведенийОбОшибкеПолучателя, ","));
	
	ТекстПредупреждения = НСтр("ru = 'Контроль корректности не пройден (повтор проводок отправителя: %1, повтор проводок получателя: %2).
	|Требуется скорректировать сопоставление и повторить операцию.'");
	
	СтруктураСведенийОбОшибке.Вставить("ТекстПредупреждения", ТекстПредупреждения);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьСопоставлениеПоДаннымПолучателяНаСервере()
	Если ЗначениеЗаполнено(ОтветноеИзвещение) Тогда
		СопоставлениеПроводок = ОтветноеИзвещение.СопоставлениеПроводок.Выгрузить();
		
		СопоставлениеНеОпределено = Истина;
		Если СопоставлениеПроводок.Количество() > 0 Тогда
			СопоставлениеНеОпределено = Ложь;
			Для Каждого ТекСтрока Из СопоставлениеПроводок Цикл
				НомераПроводокОтправителя = СтрРазделить(ТекСтрока.НомераПроводокОтправителя, ",", Ложь);
				НомераПроводокПолучателя = СтрРазделить(ТекСтрока.НомераПроводокПолучателя, ",", Ложь);
				
				Если НомераПроводокОтправителя.Количество() = 1 Тогда
					Если НомераПроводокПолучателя.Количество() = 1 Тогда
						НомерПроводкиОтправителя = Число(НомераПроводокОтправителя[0]);
						НомерПроводкиПолучателя = Число(НомераПроводокПолучателя[0]);
						
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("НомерПроводки", НомерПроводкиПолучателя);
						НайденныеСтроки = ПроводкиПолучателя.НайтиСтроки(ПараметрыОтбора);
						Если НайденныеСтроки.Количество()>0 Тогда
							Для Каждого ТекПроводка Из НайденныеСтроки Цикл
								ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиОтправителя;
							КонецЦикла;	
						КонецЕсли;
					ИначеЕсли НомераПроводокПолучателя.Количество() > 1 Тогда
						НомерПроводкиОтправителя = Число(НомераПроводокОтправителя[0]);
						
						НомераПроводокПолучателяДляОтбора = Новый Массив;
						Для Каждого ТекНомер Из НомераПроводокПолучателя Цикл
							НомераПроводокПолучателяДляОтбора.Добавить(Число(ТекНомер));
						КонецЦикла;
						
						Для Каждого ТекПроводка Из ПроводкиПолучателя Цикл
							ИндексНайденногоЗначения = НомераПроводокПолучателяДляОтбора.Найти(ТекПроводка.НомерПроводки);
							Если ИндексНайденногоЗначения <> Неопределено Тогда
								ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиОтправителя;
							КонецЕсли;	
						КонецЦикла;	
						
					КонецЕсли;	
				ИначеЕсли НомераПроводокОтправителя.Количество() > 1 Тогда
					Если НомераПроводокПолучателя.Количество() = 1 Тогда
						НомерПроводкиПолучателя = Число(НомераПроводокПолучателя[0]);
						
						НомераПроводокОтправителяДляОтбора = Новый Массив;
						Для Каждого ТекНомер Из НомераПроводокОтправителя Цикл
							НомераПроводокОтправителяДляОтбора.Добавить(Число(ТекНомер));
						КонецЦикла;
						
						Для Каждого ТекПроводка Из ПроводкиОтправителя Цикл
							ИндексНайденногоЗначения = НомераПроводокОтправителяДляОтбора.Найти(ТекПроводка.НомерПроводки);
							Если ИндексНайденногоЗначения <> Неопределено Тогда
								ТекПроводка.НомерПроводкиУчастникаОбмена = НомерПроводкиПолучателя;
							КонецЕсли;	
						КонецЦикла;	
						
					ИначеЕсли НомераПроводокПолучателя.Количество() > 1 Тогда
						
					КонецЕсли;	
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Если СопоставлениеНеОпределено Тогда
			Для Каждого ТекСтрока Из ПроводкиПолучателя Цикл
				ТекСтрока.НомерПроводкиУчастникаОбмена = ТекСтрока.НомерПроводки;
			КонецЦикла;
		КонецЕсли;	
		
		Модифицированность = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПроводокПолучателя(НомерПроводкиУчастникаОбмена)
	
	Элементы.ПроводкиПолучателя.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("НомерПроводкиУчастникаОбмена",НомерПроводкиУчастникаОбмена));
	
КонецПроцедуры	

#КонецОбласти
