//@strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

// Заголовки колонок для вывода ошибок заполнения
Перем ЗаголовкиКолонок; // Структура

// Значение функциональной опции "Использовать учет по подразделениям"
Перем УчетПоПодразделениям; // Булево

#КонецОбласти

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
// Параметры:
//  Таблица - см. УправлениеДоступом.ТаблицаНаборыЗначенийДоступа
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЗаполнитьЗаголовкиКолонок();
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Для каждого ТекСтр Из ПередаваемыеПроводки Цикл
		Для каждого ПроверяемаяСторона Из ПроверяемыеСтороныПроводки(ТекСтр) Цикл
			ПроверитьСторонуПроводки(ТекСтр, ПроверяемаяСторона, Отказ);
		КонецЦикла; 
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	ОчиститьНеиспользуемыеДанные();
	
	Параметры = Новый Структура;
	
	Если ЗначениеЗаполнено(ВходящееИзвещение) Тогда
		ЭДП = Новый ТаблицаЗначений;
		ЭлектронныеДокументыБГУ.ЗаполнитьСписокЭлектронныхДокументовПоставщикаПоИзвещению(ВходящееИзвещение, ЭДП);
		Параметры.Вставить("ЭДП", ЭДП);
	КонецЕсли;	
		
	ТипЭлектронногоИзвещения = ЦентрализованноеСнабжение.ТипИсходящегоЭлектронногоИзвещения(ВидИзвещения, Параметры);
	
	СуммаДокумента = ПередаваемыеПроводки.Итог("Сумма");
	
	Если СуммаДокумента = 0 И ДокументыПередачи.Количество() > 0 Тогда
		ЗаполнитьСуммуДокументаПоДокументамПередачи();
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ТипОснования = ТипЗнч(ДанныеЗаполнения);
	Если НЕ Документы.ТипВсеСсылки().СодержитТип(ТипОснования) Или НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		
		ЦентрализованноеСнабжение.ЗаполнитьИсходящееИзвещениеПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		
		ЗаполнитьПоСписаниюДоходовБудущихПериодов(ДанныеЗаполнения);
		
	ИначеЕсли ЭтоДокументНачисленияДохода(ТипОснования) Тогда
		
		ЗаполнитьПоДокументуНачислениеДохода(ДанныеЗаполнения);
		
	Иначе
	
		ВидИзвещения = ВидИзвещенияПоПроводкамДокументаОснования(ДанныеЗаполнения);
		Если Не ЗначениеЗаполнено(ВидИзвещения) Тогда
			ВидИзвещения = ВидИзвещенияПоТипуДокументаОснования(ТипОснования);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВидИзвещения) Тогда
			//@skip-check invocation-parameter-type-intersect
			ЗаполнитьПоДокументу(ДанныеЗаполнения);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоСписаниюДоходовБудущихПериодов(ДанныеЗаполнения)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, ИФО");
		Организация = ДанныеДокументаОснования.Организация;
		ИФО = ДанныеДокументаОснования.ИФО;
		
		ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ;
		
		ДокументыПередачи.Добавить().ДокументПередачи = ДанныеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

// Это документ начисления дохода.
// 
// Параметры:
//  ТипОснования - Неопределено
// 
// Возвращаемое значение:
//  Булево - Это документ начисления дохода
Функция ЭтоДокументНачисленияДохода(ТипОснования)
	Возврат ТипДокументНачисленияДохода().СодержитТип(ТипОснования);
КонецФункции

// Тип документ начисления дохода.
// 
// Возвращаемое значение:
//  ОписаниеТипов
Функция ТипДокументНачисленияДохода()
	Возврат Новый ОписаниеТипов("ДокументСсылка.НачислениеДоходов, ДокументСсылка.АктОбОказанииУслуг");
КонецФункции

// Заполнить по документу начисление дохода.
// 
// Параметры:
//  ДанныеЗаполнения - см. ТипДокументНачисленияДохода
Процедура ЗаполнитьПоДокументуНачислениеДохода(ДанныеЗаполнения)
	
	// Учетная политика
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, ИФО, Дата");
	Организация = ДанныеДокументаОснования.Организация;
	ИФО = ДанныеДокументаОснования.ИФО;
	Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	
	СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация, ИФО, ДанныеДокументаОснования.Дата);
	ТипПС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС, "ТипПланаСчетов");
	Если ТипПС = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
		ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода;
	Иначе
		ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований;
	КонецЕсли;
	
	СчеДт = БухгалтерскийУчет.СчетПоКоду("304.04", Дата, Организация);
	КПСДтПоКФО = Новый Соответствие;
	ДопустимыеКодыСчетов = ЦентрализованноеСнабжение.ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(ВидИзвещения);
	ДопустимыеКорреспонденции = ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция();
	Если ЗначениеЗаполнено(ДопустимыеКодыСчетов) Тогда
		ДопустимыеКорреспонденции.СчетаКт = ЦентрализованноеСнабжение.ПолучитьСсылкиДопустимыхСчетов(ЭтотОбъект, ДопустимыеКодыСчетов.СчетаКт);
	КонецЕсли;
	СвойстваИспользуемыхСчетов = ЦентрализованноеСнабжение.ТаблицаСвойстваИспользуемыхСчетов();
	ЦентрализованноеСнабжение.УстановитьСвойстваИспользуемыхСчетов(СвойстваИспользуемыхСчетов, ДопустимыеКорреспонденции);
	
	ПроводкиОснования = ПроводкиДокументаОснования(ДанныеЗаполнения);
	Для Каждого ПроводкаОснования Из ПроводкиОснования Цикл
		
		КПСДт = КПСДтПоКФО.Получить(ПроводкаОснования.КФО);
		Если КПСДт = Неопределено Тогда
			КПСДт = БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, ПроводкаОснования.КФО, Дата, СчеДт);
			КПСДтПоКФО.Вставить(ПроводкаОснования.КФО, КПСДт);
		КонецЕсли;
		
		ПередаваемаяПроводка = ПередаваемыеПроводки.Добавить();
		ПередаваемаяПроводка.КФО = ПроводкаОснования.КФО;
		ПередаваемаяПроводка.СчетДт = СчеДт;
		ПередаваемаяПроводка.КПСДт = КПСДт;
		ПередаваемаяПроводка.КЭКДт = ПроводкаОснования.КЭККт;
		Если ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода Тогда
			ПередаваемаяПроводка.СчетКт = ЦентрализованноеСнабжениеКлиентСервер.ЕдинственныйДопустимыйСчет(
				ДопустимыеКорреспонденции, "Кт");
			Если ЗначениеЗаполнено(ПередаваемаяПроводка.СчетКт) Тогда
				ПередаваемаяПроводка.КПСКт = БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, ПроводкаОснования.КФО, Дата, ПередаваемаяПроводка.СчетКт);
				ПараметрыКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
				ПараметрыКЭК.Дата = Дата;
				ПараметрыКЭК.Организация = Организация;
				ПараметрыКЭК.ИФО = ИФО;
				ПараметрыКЭК.КФО = ПроводкаОснования.КФО;
				ПараметрыКЭК.Счет = ПередаваемаяПроводка.СчетКт;
				ПараметрыКЭК.ДтКт = "Кт";
				ПередаваемаяПроводка.КЭККт = БухгалтерскийУчет.КЭКПроводки(ПараметрыКЭК);
			КонецЕсли;
		Иначе
			ПередаваемаяПроводка.СчетКт = ПроводкаОснования.СчетДт;
			ПередаваемаяПроводка.КПСКт = ПроводкаОснования.КПСДт;
			ПередаваемаяПроводка.КЭККт = ПроводкаОснования.КЭКДт;
			ПередаваемаяПроводка.СубконтоКт1 = ПроводкаОснования.СубконтоДт1;
			ПередаваемаяПроводка.СубконтоКт2 = ПроводкаОснования.СубконтоДт2;
			ПередаваемаяПроводка.СубконтоКт3 = ПроводкаОснования.СубконтоДт3;
			ПередаваемаяПроводка.ПодразделениеКт = ПроводкаОснования.ПодразделениеДт;
		КонецЕсли;
		ПередаваемаяПроводка.Сумма = ПроводкаОснования.Сумма;
		ПередаваемаяПроводка.Содержание = ПроводкаОснования.Содержание;
	КонецЦикла;
	
КонецПроцедуры

// Таблица проводок основания.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица проводок основания:
// * КПСДт - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КФО - ПеречислениеСсылка.КВД -
// * КЭКДт - СправочникСсылка.КОСГУ -
// * КЭККт - СправочникСсылка.КОСГУ -
// * ПодразделениеДт - СправочникСсылка.Подразделения -
// * Содержание - Строка -
// * СубконтоДт1 - Характеристика.ВидыСубконто
// * СубконтоДт2  - Характеристика.ВидыСубконто
// * СубконтоДт3 - Характеристика.ВидыСубконто
// * Сумма - Число -
// * СчетДт - ПланСчетовСсылка.ЕПСБУ -
Функция ТаблицаПроводокОснования()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КПСДт", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("КЭКДт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("КЭККт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("ПодразделениеДт", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Результат.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СубконтоДт1", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("СубконтоДт2", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("СубконтоДт3", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Возврат Результат;
КонецФункции

// Проводки документа основания.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. ТаблицаПроводокОснования
Функция ПроводкиДокументаОснования(ДокументОснование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|ГДЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = &Регистратор
	|	И НЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Забалансовый
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки";
	Запрос.УстановитьПараметр("Регистратор", ДокументОснование);
	
	Результат = ТаблицаПроводокОснования();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВидИзвещенияПоПроводкамДокументаОснования(ДанныеЗаполнения)
	
	РассчитанныйВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПустаяСсылка();
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ВидПоступленияМЗ")
			= Перечисления.ВидыПоступленийМЗ.Поступление Тогда
		РассчитанныйВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ВидПередачиМЗ")
			= Перечисления.ВидыПередачиМЗ.ВозвратПоставщику Тогда
		РассчитанныйВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА;
	КонецЕсли;
	Если ЗначениеЗаполнено(РассчитанныйВидИзвещения)
			И НЕ ЕстьПроводкиПоСчетамЦС(ДанныеЗаполнения) Тогда
		РассчитанныйВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПустаяСсылка();
	КонецЕсли;
	
	Возврат РассчитанныйВидИзвещения;
КонецФункции

Функция ЕстьПроводкиПоСчетамЦС(ДанныеЗаполнения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор = &Регистратор
	|	И ((ЖурналПроводокЕПСБУ.СчетДт В (&СчетаВложений)
	|		И ЖурналПроводокЕПСБУ.СчетКт В (&СчетаЦС))
	|	ИЛИ (ЖурналПроводокЕПСБУ.СчетДт В (&СчетаЦС)
	|		И ЖурналПроводокЕПСБУ.СчетКт В (&СчетаВложений)
	|		И ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияКт В 
	|			(ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.СписаниеВнутриведомственное),
	|			 ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.СписаниеОдногоУровняБюджета))))";
	Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("СчетаВложений", БухгалтерскийУчет.СписокСчетов("101.00, 105.00, 106.00"));
	Запрос.УстановитьПараметр("СчетаЦС", БухгалтерскийУчет.СписокСчетов("304.04, 401.10"));
	УстановитьПривилегированныйРежим(Истина);
	ЕстьПроводки = Не Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ЕстьПроводки;
КонецФункции

// Вид извещения по типу документа основания.
// 
// Параметры:
//  ТипОснования - Тип -
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение - Вид извещения по типу документа основания
Функция ВидИзвещенияПоТипуДокументаОснования(ТипОснования)
	ПроверямыеВидыОпераций = Новый Массив; // Массив из ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
	ПроверямыеВидыОпераций.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада);
	ПроверямыеВидыОпераций.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств);
	
	Для Каждого ВидОперации Из ПроверямыеВидыОпераций Цикл
		ДопустимыеТипыОснований = Документы.ИзвещениеИсходящее.ТипыДокументовПередачиПоВидуИзвещения(ВидОперации);
		Если ДопустимыеТипыОснований.Найти(ТипОснования) <> Неопределено Тогда
			Возврат ВидОперации;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПустаяСсылка();
	
КонецФункции

// Заполнить по документу.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка - Данные заполнения
Процедура ЗаполнитьПоДокументу(ДанныеЗаполнения)
	МетаданныеОснования = ДанныеЗаполнения.Метаданные(); // ОбъектМетаданных
	
	ИменаРеквизитов = Новый Структура;
	ИменаРеквизитов.Вставить("Дата");
	ИменаРеквизитов.Вставить("Организация");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
		И ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеОснования) Тогда
		ИменаРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеОснования) Тогда
		ИменаРеквизитов.Вставить("Получатель", "Контрагент");
	КонецЕсли;
	
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, ИменаРеквизитов);
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДанныеДокументаОснования.Дата = ДатаПроведения;
	КонецЕсли;
	
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, ИменаРеквизитов);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ДокументыПередачи.Добавить().ДокументПередачи = ДанныеЗаполнения;
КонецПроцедуры

Процедура ОчиститьНеиспользуемыеДанные()
	
	Если ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика Тогда
		ДокументыПередачи.Очистить();
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада Тогда
		ПередаваемыеПроводки.Очистить();
		ОсновныеСредства.Очистить();
		Материалы.Очистить();
		ВозвратнаяТара.Очистить();
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств Тогда
		ПередаваемыеПроводки.Очистить();
		ОсновныеСредства.Очистить();
		Материалы.Очистить();
		ВозвратнаяТара.Очистить();
		Поставщик              = Справочники.Контрагенты.ПустаяСсылка();
		Договор                = Справочники.Договоры.ПустаяСсылка();
		ДатаСчетаПоставщика    = '00010101';
		НомерСчетаПоставщика   = "";
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований Тогда
		ДокументыПередачи.Очистить();
		ОсновныеСредства.Очистить();
		Материалы.Очистить();
		ВозвратнаяТара.Очистить();
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств Тогда
		ДокументыПередачи.Очистить();
		ОсновныеСредства.Очистить();
		Материалы.Очистить();
		ВозвратнаяТара.Очистить();
		Поставщик              = Справочники.Контрагенты.ПустаяСсылка();
		Договор                = Справочники.Договоры.ПустаяСсылка();
		ДатаСчетаПоставщика    = '00010101';
		НомерСчетаПоставщика   = "";
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода Тогда
		ДокументыПередачи.Очистить();
		ОсновныеСредства.Очистить();
		Материалы.Очистить();
		ВозвратнаяТара.Очистить();
		Поставщик              = Справочники.Контрагенты.ПустаяСсылка();
		Договор                = Справочники.Договоры.ПустаяСсылка();
		ДатаСчетаПоставщика    = '00010101';
		НомерСчетаПоставщика   = "";
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьЗаголовкиКолонок()
	ЗаголовкиКолонок = Новый Структура;
	ЗаголовкиКолонок.Вставить("СчетДт", НСтр("ru = 'Счет дебета'"));
	ЗаголовкиКолонок.Вставить("ПодразделениеДт", НСтр("ru = 'Подразделение дебета'"));
	ЗаголовкиКолонок.Вставить("КПСДт", НСтр("ru = 'КПС дебета'"));
	ЗаголовкиКолонок.Вставить("КЭКДт", НСтр("ru = 'КЭК дебета'"));
	ЗаголовкиКолонок.Вставить("СубконтоДт", НСтр("ru = 'Субконто дебета'"));
	ЗаголовкиКолонок.Вставить("СчетКт", НСтр("ru = 'Счет кредита'"));
	ЗаголовкиКолонок.Вставить("ПодразделениеКт", НСтр("ru = 'Подразделение кредита'"));
	ЗаголовкиКолонок.Вставить("КПСКт", НСтр("ru = 'КПС кредита'"));
	ЗаголовкиКолонок.Вставить("КЭККт", НСтр("ru = 'КЭК кредита'"));
	ЗаголовкиКолонок.Вставить("СубконтоКт", НСтр("ru = 'Субконто кредита'"));
КонецПроцедуры

// Проверить реквизит.
// 
// Параметры:
//  СтрокаДокумента - ДокументТабличнаяЧастьСтрока.ИзвещениеИсходящее.ПередаваемыеПроводки - 
//  ИмяРеквизита - Строка - Имя реквизита
//  ЗаголовокРеквизита - Строка - Заголовок реквизита
//  Отказ - Булево - Отказ
Процедура ПроверитьРеквизит(СтрокаДокумента, ИмяРеквизита, Знач ЗаголовокРеквизита, Отказ)
	Если Не ЗначениеЗаполнено(СтрокаДокумента[ИмяРеквизита]) Тогда
		Если Не ЗначениеЗаполнено(ЗаголовокРеквизита) Тогда
			ЗаголовокРеквизита = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗаголовкиКолонок, ИмяРеквизита, ""); // Строка
		КонецЕсли;
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", ЗаголовокРеквизита,
			СтрокаДокумента.НомерСтроки, НСтр("ru = 'ПередаваемыеПроводки'"), );
		ИмяПоля = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ПередаваемыеПроводки", СтрокаДокумента.НомерСтроки,
			ИмяРеквизита);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ИмяПоля, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

// Проверить сторону проводки.
// 
// Параметры:
//  СтрокаДокумента - ДокументТабличнаяЧастьСтрока.ИзвещениеИсходящее.ПередаваемыеПроводки - Строка документа
//  ДтКт - Строка - Дт кт
//  Отказ - Булево - Отказ
Процедура ПроверитьСторонуПроводки(СтрокаДокумента, ДтКт, Отказ)
	ИмяКолонкиСчет = "Счет" + ДтКт; // Строка
	ШаблонЗаголовкаСубконто = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗаголовкиКолонок, "Субконто" + ДтКт, "")
		+ ": %1"; // Строка
	ПроверитьРеквизит(СтрокаДокумента, ИмяКолонкиСчет, "", Отказ);
	Если ЗначениеЗаполнено(СтрокаДокумента[ИмяКолонкиСчет]) Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента[ИмяКолонкиСчет]);
		Если УчетПоПодразделениям
			И СвойстваСчета.УчетПоПодразделениям
			И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение Тогда
			ПроверитьРеквизит(СтрокаДокумента, "Подразделение" + ДтКт, "", Отказ);
		КонецЕсли;
		Если СвойстваСчета.УчетПоКПС Тогда
			ПроверитьРеквизит(СтрокаДокумента, "КПС" + ДтКт, "", Отказ);
		КонецЕсли;
		Если СвойстваСчета.УчетПоКЭК Тогда
			ПроверитьРеквизит(СтрокаДокумента, "КЭК" + ДтКт, "", Отказ);
		КонецЕсли;
		Для СчетчикСубконто=1 по 3 Цикл
			Если СвойстваСчета["ВидСубконто"+СчетчикСубконто] <> Неопределено 
				И СвойстваСчета["ВидСубконто"+СчетчикСубконто+"Обязательный"] Тогда
				ЗаголовокРеквизита = СтрШаблон(ШаблонЗаголовкаСубконто, СвойстваСчета["ВидСубконто" + СчетчикСубконто
					+ "Наименование"]);
				ПроверитьРеквизит(СтрокаДокумента, "Субконто" + ДтКт + СчетчикСубконто, ЗаголовокРеквизита, Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьСуммуДокументаПоДокументамПередачи()
	
	ВыбранныеДокументы = ДокументыПередачи.Выгрузить();
	ТипыДокументов = Новый Соответствие;
	Для Каждого СтрокаДокумента Из ВыбранныеДокументы Цикл
		Если Не ЗначениеЗаполнено(СтрокаДокумента.ДокументПередачи) Тогда
			Продолжить;
		КонецЕсли;
		ТипДокумента = ТипЗнч(СтрокаДокумента.ДокументПередачи);
		ДокументыЭтогоТипа = ТипыДокументов.Получить(ТипДокумента);
		Если ДокументыЭтогоТипа = Неопределено Тогда
			ДокументыЭтогоТипа = Новый Массив;
			ТипыДокументов.Вставить(ТипДокумента, ДокументыЭтогоТипа);
		КонецЕсли;
		ДокументыЭтогоТипа.Добавить(СтрокаДокумента.ДокументПередачи);
	КонецЦикла;
	Если ТипыДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	ЧастиЗапроса = Новый Массив;
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка,
	|	&ПолеСуммаДокумента КАК СуммаДокумента,
	|	ЕСТЬNULL(ОперацияДокумента.СуммаОперации, 0) КАК СуммаОперации
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаДокумента
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацияДокумента
	|	ПО ТаблицаДокумента.Ссылка = ОперацияДокумента.Документ
	|ГДЕ
	|	ТаблицаДокумента.Ссылка В (&СсылкиДокументов)";
	
	Индекс = 0;
	Для Каждого ИспользуемыйТип Из ТипыДокументов Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ИспользуемыйТип.Ключ);
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокумента", МетаданныеДокумента) Тогда
			ПолеСуммаДокумента = "ТаблицаДокумента.СуммаДокумента";
		Иначе
			ПолеСуммаДокумента = "0";
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПолеСуммаДокумента", ПолеСуммаДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДокумента", МетаданныеДокумента.ПолноеИмя());
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СсылкиДокументов", "&СсылкиДокументов" + Индекс);
		Запрос.УстановитьПараметр("СсылкиДокументов" + Индекс, ИспользуемыйТип.Значение);
		ЧастиЗапроса.Добавить(ТекстЗапроса);
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.СуммаДокумента) Тогда
			СуммаДокумента = СуммаДокумента + Выборка.СуммаДокумента;
		Иначе
			СуммаДокумента = СуммаДокумента + Выборка.СуммаОперации;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяемые стороны проводки.
// 
// Параметры:
//  СтрокаДокумента - ДокументТабличнаяЧастьСтрока.ИзвещениеИсходящее.ПередаваемыеПроводки - Строка документа
// 
// Возвращаемое значение:
//  Массив из Строка - Проверяемые стороны проводки
Функция ПроверяемыеСтороныПроводки(СтрокаДокумента)

	ПроверятьСчетДт = Ложь;
	ПроверятьСчетКт = Ложь;
	
	Если ЗначениеЗаполнено(СтрокаДокумента.СчетДт) Тогда
		ПроверятьСчетДт = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаДокумента.СчетКт) Тогда
		ПроверятьСчетКт = Истина;
	КонецЕсли;
	
	Если НЕ (ПроверятьСчетДт И ПроверятьСчетКт) Тогда
		Если НЕ ПроверятьСчетДт И Не ПроверятьСчетКт Тогда
			ПроверятьВсеСчета = Истина;
		Иначе
			Если ПроверятьСчетДт Тогда
				ПроверяемыйСчет = СтрокаДокумента.СчетДт;
			Иначе
				ПроверяемыйСчет = СтрокаДокумента.СчетКт;
			КонецЕсли;
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроверяемыйСчет);
			ПроверятьВсеСчета = НЕ СвойстваСчета.Забалансовый;
		КонецЕсли;
		Если ПроверятьВсеСчета Тогда
			ПроверятьСчетДт = Истина;
			ПроверятьСчетКт = Истина;
		КонецЕсли;
	КонецЕсли;
	
