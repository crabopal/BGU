#Область СлужебныеПроцедурыИФункции

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИзвещениеИсходящее";
	КомандаПечати.Идентификатор = "Извещение_103н";
	КомандаПечати.Представление = НСтр("ru = 'Извещение (ф. 0504805), ред.103н'");
	КомандаПечати.Порядок		= 1;
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИзвещениеИсходящее";
	КомандаПечати.Идентификатор = "Извещение_Электронное";
	КомандаПечати.Представление = НСтр("ru = 'Электронное извещение (ф.0504805)'");
	КомандаПечати.Порядок		= 2;
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИзвещениеИсходящее";
	КомандаПечати.Идентификатор = "Извещение_52н";
	КомандаПечати.Представление = НСтр("ru = 'Извещение (ф. 0504805), ред.52н'");
	КомандаПечати.Порядок		= 3;
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИзвещениеИсходящее";
	КомандаПечати.Идентификатор = "Извещение";
	КомандаПечати.Представление = НСтр("ru = '(устарел) Извещение (ф. 0504805)'");
	КомандаПечати.Порядок		= 99;
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Извещение_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Извещение_103н",
			"Извещение (ф.0504805) ред.103н",
			ПечатьИзвещения(ДанныеДляПечатиИзвещения(МассивОбъектов), ОбъектыПечати, "ПФ_MXL_Извещение0504805_103н"));
		
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Извещение_Электронное") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Извещение_Электронное",
			"Электронное извещение (ф.0504805)",
			ПечатьЭлектронногоИзвещения(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Извещение0504805_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Извещение") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Извещение",
			"Извещение (ф.0504805)",
			ПечатьИзвещения(ДанныеДляПечатиИзвещения(МассивОбъектов), ОбъектыПечати, "ПФ_MXL_Извещение0504805"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Извещение_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Извещение_52н",
			"Извещение (ф.0504805) ред. 52н",
			ПечатьИзвещения(ДанныеДляПечатиИзвещения(МассивОбъектов), ОбъектыПечати, "ПФ_MXL_Извещение0504805_52н"));
		
	КонецЕсли;

КонецПроцедуры // Печать()

// Данные для печати извещения.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ИзвещениеИсходящее
// 
// Возвращаемое значение:
//  см. ТаблицаДанныхДляПечатиИзвещения
Функция ДанныеДляПечатиИзвещения(МассивОбъектов)
	
	ТаблицаДокументов = ТаблицаДанныхДляПечатиИзвещения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПечатиИзвещения();
	Запрос.УстановитьПараметр("СчетаАмортизации", БухгалтерскийУчет.СписокСчетов("104.00,Н02"));
	Запрос.УстановитьПараметр("СчетОЦИ",          БухгалтерскийУчет.СписокСчетов("ОЦИ"));
	Запрос.УстановитьПараметр("Счет17",           БухгалтерскийУчет.СписокСчетов("17"));
	Запрос.УстановитьПараметр("Счет18",           БухгалтерскийУчет.СписокСчетов("18"));
	Запрос.УстановитьПараметр("МассивОбъектов",   МассивОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[1].Выбрать();
	ВыборкаПередаваемыеПроводки = РезультатЗапроса[2].Выбрать();
	ВыборкаПроводкиИзвещения = РезультатЗапроса[3].Выбрать();
	ВыборкаПроводки = РезультатЗапроса[5].Выбрать();
	ТаблицаПроводок = РезультатЗапроса[5].Выгрузить();
	
	ПолныеНаименованияНФА = ПолныеНаименованияПередаваемыхНФА(ТаблицаПроводок, Истина);
	
	Отбор = Новый Структура("Ссылка", Неопределено);
	Пока ВыборкаШапка.Следующий() Цикл
		
		ПечатьОтПолучателя = ДокументПечатаетсяОтПолучателя(ВыборкаШапка);
		СтрокаДокумента = ТаблицаДокументов.Добавить();
		СтрокаДокумента.Проводки = ТаблицаПроводокДляПечатиИзвещения();
		СтрокаДокумента.ВидИзвещения = ВыборкаШапка.ВидИзвещения;
		СтрокаДокумента.Ссылка = ВыборкаШапка.Ссылка;
		
		ДобавитьДанныеШапкиДокумента(СтрокаДокумента, ВыборкаШапка, ПечатьОтПолучателя);
		
		ВыборкаПроводкиИзвещения.Сбросить();
		ВыборкаПередаваемыеПроводки.Сбросить();
		ВыборкаПроводки.Сбросить();
		Если ВыборкаШапка.ИсправлениеОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
				Или ВыборкаШапка.ИсправлениеОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
			ПередаваемыеПроводки = ВыборкаПроводкиИзвещения;
		Иначе
			ПередаваемыеПроводки = ВыборкаПередаваемыеПроводки;
		КонецЕсли;
		Отбор.Ссылка = ВыборкаШапка.Ссылка;
		Если ПередаваемыеПроводки.НайтиСледующий(Отбор) Тогда
			ДобавитьДанныеПроводокДокумента(СтрокаДокумента.Проводки, ПередаваемыеПроводки, ПечатьОтПолучателя, Отбор);
		ИначеЕсли ВыборкаПроводки.НайтиСледующий(Отбор) Тогда
			ДобавитьДанныеПроводокДокумента(СтрокаДокумента.Проводки, ВыборкаПроводки, ПечатьОтПолучателя, Отбор,
				ПолныеНаименованияНФА);
		КонецЕсли;
		
		ДобавитьДанныеПодвала(СтрокаДокумента, ВыборкаШапка, ПечатьОтПолучателя);
		
	КонецЦикла;

	Возврат ТаблицаДокументов;

КонецФункции

