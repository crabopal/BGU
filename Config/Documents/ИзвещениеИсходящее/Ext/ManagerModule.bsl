Процедура ЗаполнитьДанныеПолучателяВСтрокеЭлектронногоИзвещения(НомерПроводки, ТипИзвещения, ДанныеЭДОтветногоИзвещения, ДанныеСтроки)
	Если ТипИзвещения = 19 ИЛИ ТипИзвещения = 23 ИЛИ ТипИзвещения = 25 ИЛИ ТипИзвещения = 27 ИЛИ ТипИзвещения = 29 Тогда
		Если НЕ ДанныеЭДОтветногоИзвещения = Неопределено Тогда
			ТекСтрокаПолучателя = ДанныеЭДОтветногоИзвещения.ТаблицаПроводок[НомерПроводки-1];
			ДанныеСтроки.пДебетСчетОтправитель = ТекСтрокаПолучателя.пДебетСчетОтправитель;
			ДанныеСтроки.пКредитСчетОтправитель = ТекСтрокаПолучателя.пКредитСчетОтправитель;
			ДанныеСтроки.пСуммаОтправитель = ТекСтрокаПолучателя.пСуммаОтправитель;
		Иначе
			ДанныеСтроки.пДебетСчетПолучатель = "";
			ДанныеСтроки.пКредитСчетПолучатель = "";
			ДанныеСтроки.пСуммаПолучатель = "";
		КонецЕсли;
	Иначе	
		Если НЕ ДанныеЭДОтветногоИзвещения = Неопределено Тогда
			ТекСтрокаПолучателя = ДанныеЭДОтветногоИзвещения.ТаблицаПроводок[НомерПроводки-1];
			ДанныеСтроки.пДебетСчетПолучатель = ТекСтрокаПолучателя.пДебетСчетОтправитель;
			ДанныеСтроки.пКредитСчетПолучатель = ТекСтрокаПолучателя.пКредитСчетОтправитель;
			ДанныеСтроки.пСуммаПолучатель = ТекСтрокаПолучателя.пСуммаОтправитель;
		Иначе
			ДанныеСтроки.пДебетСчетПолучатель = "";
			ДанныеСтроки.пКредитСчетПолучатель = "";
			ДанныеСтроки.пСуммаПолучатель = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

