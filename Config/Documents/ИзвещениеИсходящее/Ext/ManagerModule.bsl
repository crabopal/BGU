	               |	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК НаименованиеДокументаФайла,
	               |	ПриложенныеФайлыДляЭДОБГУ.ВидСведений КАК ВидСведений
	               |ИЗ
	               |	РегистрСведений.ПриложенныеФайлыДляЭДОБГУ КАК ПриложенныеФайлыДляЭДОБГУ
	               |ГДЕ
	               |	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);	
	Запрос.УстановитьПараметр("СчетаАмортизации",	БухгалтерскийУчет.СписокСчетов("104.00,Н02", ДокументСсылка.Дата, , ДокументСсылка.Организация));
	Запрос.УстановитьПараметр("СчетОЦИ",			БухгалтерскийУчет.СписокСчетов("ОЦИ", ДокументСсылка.Дата, , ДокументСсылка.Организация));

	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаПроводок = МассивРезультатов[1].Выгрузить();
	Если ТаблицаПроводок.Количество() = 0 Тогда
		ТаблицаПроводок = МассивРезультатов[4].Выгрузить();
	Иначе
		ТаблицаПроводок = МассивРезультатов[1].Выгрузить();
	КонецЕсли;	
	Если ТаблицаПроводок.Колонки.Найти("Содержание") = Неопределено Тогда
		ТаблицаПроводок.Очистить();
	КонецЕсли;
	Если ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеБСО
		ИЛИ ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств Тогда
		
		ТаблицаПроводок = ПередаваемыеПроводкиПоДокументамПоступления(ДокументСсылка);
	КонецЕсли;
	
	Если ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ
		И ТаблицаПроводок.Количество() = 0
		И ДокументСсылка.ДокументыПередачи.Количество() > 0 Тогда
		ТаблицаПроводок = ПередаваемыеПроводкиПоДокументамПередачи(ДокументСсылка);
	КонецЕсли;	
	
	Структура = Новый Структура("Шапка, ПередаваемыеПроводки, ДокументыПередачи, Приложения, ПередаваемаяНоменклатура, ПроводкиДокументаУчета, ФайлыИзвещения",
		МассивРезультатов[0].Выбрать(), ТаблицаПроводок, МассивРезультатов[2].Выгрузить(),
		МассивРезультатов[3].Выгрузить(), МассивРезультатов[5].Выгрузить(), МассивРезультатов[7].Выгрузить(), МассивРезультатов[8].Выгрузить());
	
	Возврат Структура;
	
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	Для каждого ТекСтрока Из ДокументСсылка.ДокументыПередачи Цикл
		Если ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада Тогда
			Если ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.СписаниеБСО")
				ИЛИ ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ПередачаБСО") Тогда
				ОписаниеОшибки = НСтр("ru='Документы передачи БСО (Акт списания БСО, Передача БСО) следует использовать
				|с видом извещения ""Передача БСО"".'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				
				Результат = Ложь;
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументПередачи) = Тип("ДокументСсылка.ВыбытиеНеоплаченныхПутевок") Тогда
				ОписаниеОшибки = НСтр("ru='Документы передачи путевок (Выбытие неоплаченных путевок) следует использовать 
				|с видом извещения ""Передача денежных средств/документов"".'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	Если ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеБСО
		ИЛИ ДокументСсылка.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств Тогда
		Если ДокументСсылка.ДокументыПередачи.Количество() = 0 Тогда
			ОписаниеОшибки = НСтр("ru='Не указан ни один документ поступления на закладке ""Документы поступления"" 
			|для заполнения списка ""Передаваемые проводки"" в электронном документе.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Получатель) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен получатель.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Получатель;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес получателя.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо получателя.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		Участник = Контрагент;
		СведенияОбУчастнике = Неопределено; 
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике);
		
		Если Участник.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			КодОКПО = СведенияОбУчастнике.КодОКПО;
			Если ЗначениеЗаполнено(КодОКПО) Тогда
				Если СтрДлина(КодОКПО)<>8 Тогда
					ОписаниеОшибки = НСтр("ru='Код ОКПО для контрагента-получателя должен иметь длину 8 знаков.'");
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСсылка.Поставщик) Тогда
		Участник = ДокументСсылка.Поставщик;
		СведенияОбУчастнике = Неопределено; 
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике);
		
		Если Участник.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			КодОКПО = СведенияОбУчастнике.КодОКПО;
			Если ЗначениеЗаполнено(КодОКПО) Тогда
				Если СтрДлина(КодОКПО)<>8 Тогда
					ОписаниеОшибки = НСтр("ru='Код ОКПО для контрагента-поставщика должен иметь длину 8 знаков.'");
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;
		
	Для Каждого ТекСтрока Из ДокументСсылка.ПередаваемыеПроводки Цикл
		ПроверкаСтрокиТЧ(Результат, НСтр("ru='Передаваемые проводки'"), ТекСтрока);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Руководитель) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Руководитель"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ГлавныйБухгалтер) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Главный бухгалтер"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Ответственный) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен ответственный.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.Ответственный.ФизическоеЛицо) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнено физическое лицо у ответственного.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ПроверкаСтрокиТЧ(Результат, ИмяТЧ, ТекСтрока)
	Если ИмяТЧ = НСтр("ru='Передаваемые проводки'") Тогда
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Сумма) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена сумма в строке %1 таблицы на закладке ""%2"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ИмяТЧ);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

Функция ПередаваемыеПроводкиПоДокументамПоступления(ДокументСсылка)
	ТаблицаДокументыУчета = ДокументСсылка.ДокументыПередачи.Выгрузить();
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ПоступлениеБСО.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ДокументыУчета
	               |ИЗ
	               |	Документ.ПоступлениеБСО КАК ПоступлениеБСО
	               |ГДЕ
	               |	ПоступлениеБСО.Ссылка В(&ДокументыПередачи)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КассовоеПоступление.Ссылка
	               |ИЗ
	               |	Документ.КассовоеПоступление КАК КассовоеПоступление
	               |ГДЕ
	               |	КассовоеПоступление.Ссылка В(&ДокументыПередачи)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПриходныйОрдерФондовый.Ссылка
	               |ИЗ
	               |	Документ.ПриходныйОрдерФондовый КАК ПриходныйОрдерФондовый
	               |ГДЕ
	               |	ПриходныйОрдерФондовый.Ссылка В(&ДокументыПередачи)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПоступлениеНеоплаченныхПутевок.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеНеоплаченныхПутевок КАК ПоступлениеНеоплаченныхПутевок
	               |ГДЕ
	               |	ПоступлениеНеоплаченныхПутевок.Ссылка В(&ДокументыПередачи)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОперацияБух.Ссылка
	               |ИЗ
	               |	Документ.ОперацияБух КАК ОперацияБух
	               |ГДЕ
	               |	ОперацияБух.Ссылка В(&ДокументыПередачи)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокументыУчета.Ссылка КАК Ссылка
	               |ИЗ
	               |	ДокументыУчета КАК ДокументыУчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК Количество
	               |ИЗ
	               |	ДокументыУчета КАК ДокументыУчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |		ПО (ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ДокументыУчета.Ссылка)
	               |ГДЕ
	               |(ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.ТипСчета, ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	               |			ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт.ТипСчета, ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))
	               |;";
	Запрос.УстановитьПараметр("ДокументыПередачи", ТаблицаДокументыУчета.ВыгрузитьКолонку("ДокументПередачи"));
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаДокументовУчета = Результат[1].Выгрузить();
	
	Для каждого ТекСтрока Из ТаблицаДокументовУчета Цикл
		ДокументУчета = ТекСтрока.Ссылка;
		Если НЕ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ОперацияБух") Тогда
			Если НЕ ДокументУчета.Проведен Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Документ %1 не проведен. Проводки документа не будут переданы.'"), ДокументУчета);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,);	
			Конецесли;
		КонецЕсли;	
	КонецЦикла;
	
	ПроводкиВсехУчетныхДокументов = Результат[2].Выгрузить();
	
	ПроводкиВсехУчетныхДокументов.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка"));
