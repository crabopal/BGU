//  ТаблицаЗначений - Таблица проводок для печати извещения:
// * пСодержание - Строка - 
// * пСуммаОтправитель - Число - 
// * пДебетСчетОтправитель - Строка - 
// * пКредитСчетОтправитель - Строка - 
// * пСуммаПолучатель - Число - 
// * пДебетСчетПолучатель - Строка - 
// * пКредитСчетПолучатель - Строка - 
Функция ТаблицаПроводокДляПечатиИзвещения()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("пСодержание", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("пСуммаОтправитель", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("пДебетСчетОтправитель", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("пКредитСчетОтправитель", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("пСуммаПолучатель", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("пДебетСчетПолучатель", Новый ОписаниеТипов("Строка"));
