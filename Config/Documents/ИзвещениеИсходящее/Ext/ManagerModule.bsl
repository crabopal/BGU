КонецФункции

// Печать извещения.
// 
// Параметры:
//  ДанныеДляПечати - см. ТаблицаДанныхДляПечатиИзвещения
//  ОбъектыПечати - см. УправлениеПечатью.Печать.ОбъектыПечати
//  ИмяМакета - Строка - Имя макета
// 
// Возвращаемое значение:
//  ТабличныйДокумент - Печать извещения
Функция ПечатьИзвещения(ДанныеДляПечати, ОбъектыПечати, ИмяМакета)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПарметрыПечатиИзвещения0504805";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИзвещениеИсходящее." + ИмяМакета);
	
	ОбластьМакетаЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакетаВерх = Макет.ПолучитьОбласть("Верх");
	ОбластьМакетаСтрока1 = Макет.ПолучитьОбласть("Строка1");
	ОбластьМакетаНиз = Макет.ПолучитьОбласть("Низ");
	
	ЕстьОбластьПояснениеМБТ = (Макет.Области.Найти("ПояснениеМБТ") <> Неопределено);
	ОбластьПояснениеМБТ = Неопределено;
	Если ЕстьОбластьПояснениеМБТ Тогда
		ОбластьПояснениеМБТ = Макет.ПолучитьОбласть("ПояснениеМБТ");
	КонецЕсли;
	
	ОборотыВЖурналОпераций = Новый ТаблицаЗначений;
	ОборотыВЖурналОпераций.Колонки.Добавить("пДебетСчетОтправитель",  Новый ОписаниеТипов("Строка"));
	ОборотыВЖурналОпераций.Колонки.Добавить("пКредитСчетОтправитель",  Новый ОписаниеТипов("Строка"));
	ОборотыВЖурналОпераций.Колонки.Добавить("пДебетСчетПолучатель", Новый ОписаниеТипов("Строка"));
	ОборотыВЖурналОпераций.Колонки.Добавить("пКредитСчетПолучатель", Новый ОписаниеТипов("Строка"));
	ОборотыВЖурналОпераций.Колонки.Добавить("пСуммаОтправитель", Новый ОписаниеТипов("Число"));
	ОборотыВЖурналОпераций.Колонки.Добавить("пСуммаПолучатель", Новый ОписаниеТипов("Число"));
	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из ДанныеДляПечати Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОборотыВЖурналОпераций.Очистить();
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(Документ);
		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
		Если Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ
			И ЕстьОбластьПояснениеМБТ
			И ЗначениеЗаполнено(Документ.ПояснениеМБТ) Тогда
			
			ОбластьПояснениеМБТ.Параметры.Заполнить(Документ);
			ТабличныйДокумент.Вывести(ОбластьПояснениеМБТ);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		пИтогоСуммаОтправитель = 0;
		пИтогоСуммаПолучатель = 0;
		Для Каждого ПередаваемаяПроводка Из Документ.Проводки Цикл
			ОбластьМакетаСтрока.Параметры.Заполнить(ПередаваемаяПроводка);
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			пИтогоСуммаОтправитель = пИтогоСуммаОтправитель + ПередаваемаяПроводка.пСуммаОтправитель;
			пИтогоСуммаПолучатель = пИтогоСуммаПолучатель + ПередаваемаяПроводка.пСуммаПолучатель;
			ЗаполнитьЗначенияСвойств(ОборотыВЖурналОпераций.Добавить(), ПередаваемаяПроводка);
		КонецЦикла;		
		ПараметрыПодвала = Новый Структура("пИтогоСуммаОтправитель, пИтогоСуммаПолучатель",
			пИтогоСуммаОтправитель, пИтогоСуммаПолучатель);
	
		ОбластьМакетаИтого.Параметры.Заполнить(ПараметрыПодвала);
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		
		ОборотыВЖурналОпераций.Свернуть(
			"пДебетСчетОтправитель, пКредитСчетОтправитель, пДебетСчетПолучатель, пКредитСчетПолучатель",
			"пСуммаОтправитель, пСуммаПолучатель");
	
		ТабличныйДокумент.Вывести(ОбластьМакетаВерх);
		Для каждого ТекОборот Из ОборотыВЖурналОпераций Цикл
			
			ОбластьМакетаСтрока1.Параметры.Заполнить(ТекОборот);
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока1);
		
		КонецЦикла; 
		ТабличныйДокумент.Вывести(ОбластьМакетаНиз);

		ОбластьМакетаПодвал.Параметры.Заполнить(Документ);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Документ.Ссылка);
	КонецЦикла;
		
	Возврат ТабличныйДокумент;
	
КонецФункции

// Полные наименования передаваемых НФА.
// Если ПоДокументамПередачи = Истина, то результат группируется не только по документу-извещению,
// но и по регистратору, которым сформированы проводки. В этом случае результат будет таким:
//  Соответствие из КлючИЗначение:
//   - Ключ - ДокументСсылка
//   - Значение - Соответствие из КлючИЗначение:
//   	- Ключ - ДокументСсылка - регистратор движения
//   	- Значение - Соответствие из КлючИЗначение:
//   		- Ключ - Число
//   		- Значение - Строка
// 
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений
//  ПоДокументамПередачи - Булево - добавлять в результат документ передачи.
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка
//   * Значение - Соответствие из КлючИЗначение:
//   ** Ключ - Число
//   ** Значение - Строка
Функция ПолныеНаименованияПередаваемыхНФА(ТаблицаПроводок, ПоДокументамПередачи = Ложь) Экспорт
	
	ПроблемныеПроводки = Новый ТаблицаЗначений;
	ПроблемныеПроводки.Колонки.Добавить("Ссылка", Документы.ТипВсеСсылки());
	ПроблемныеПроводки.Колонки.Добавить("Регистратор", Документы.ТипВсеСсылки());
	ПроблемныеПроводки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ПроблемныеПроводки.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	ПроблемныеПроводки.Колонки.Добавить("ПроверямыеСсылки", Новый ОписаниеТипов("Массив"));
	
	ПроверяемыеОС = Новый Массив; // Массив из СправочникСсылка.ОсновныеСредства
	ПроверяемыеМЗ = Новый Массив; // Массив из СправочникСсылка.Номенклатура
	ВыбратьПроблемныеПроводки(ТаблицаПроводок, ПроверяемыеМЗ, ПроверяемыеОС, ПроблемныеПроводки);
	
	ДанныеСсылок = Новый Соответствие;
	Если ПроверяемыеОС.Количество() > 0 Тогда
		ДанныеСсылок.Вставить(Тип("СправочникСсылка.ОсновныеСредства"),
			ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПроверяемыеОС, "НаименованиеПолное"));
	Иначе
		ДанныеСсылок.Вставить(Тип("СправочникСсылка.ОсновныеСредства"), Новый Соответствие);
	КонецЕсли;
	Если ПроверяемыеМЗ.Количество() > 0 Тогда
		ДанныеСсылок.Вставить(Тип("СправочникСсылка.Номенклатура"),
			ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПроверяемыеМЗ, "НаименованиеПолное"));
	Иначе
		ДанныеСсылок.Вставить(Тип("СправочникСсылка.Номенклатура"), Новый Соответствие);
	КонецЕсли;
	
	Результат = Новый Соответствие;
	Для Каждого ПроверяемаяСтрока Из ПроблемныеПроводки Цикл
		НовоеСодержание = СформироватьДлинноеПолноеНаименование(ПроверяемаяСтрока.Содержание,
			ПроверяемаяСтрока.ПроверямыеСсылки, ДанныеСсылок);
		Если ЗначениеЗаполнено(НовоеСодержание) Тогда
			ТекущийДокумент = Результат.Получить(ПроверяемаяСтрока.Ссылка);
			Если ТекущийДокумент = Неопределено Тогда
				ТекущийДокумент = Новый Соответствие;
				Результат.Вставить(ПроверяемаяСтрока.Ссылка, ТекущийДокумент);
			КонецЕсли;
			Если ПоДокументамПередачи И ЗначениеЗаполнено(ПроверяемаяСтрока.Регистратор) Тогда
				ТекущийРегистратор = ТекущийДокумент.Получить(ПроверяемаяСтрока.Регистратор);
				Если ТекущийРегистратор = Неопределено Тогда
					ТекущийРегистратор = Новый Соответствие;
					ТекущийДокумент.Вставить(ПроверяемаяСтрока.Регистратор, ТекущийРегистратор);
				КонецЕсли;
				КонтейнерНаименований = ТекущийРегистратор; 
			Иначе
				КонтейнерНаименований = ТекущийДокумент;
			КонецЕсли;
			КонтейнерНаименований.Вставить(ПроверяемаяСтрока.НомерСтроки, НовоеСодержание);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДлинноеПолноеНаименование(Знач Содержание, ПроверямыеСсылки, ДанныеСсылок)
	НаименованиеЗаполнено = Ложь;
	Для Каждого ПроверяемаяСсылка Из ПроверямыеСсылки Цикл
		ДанныеПоТипу = ДанныеСсылок.Получить(ТипЗнч(ПроверяемаяСсылка));
		Если ДанныеПоТипу = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НаименованиеСсылки = ДанныеПоТипу.Получить(ПроверяемаяСсылка);
		Если НаименованиеСсылки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НачальнаяПозиция = 1;
		НачалоНаименования = Лев(НаименованиеСсылки, 10);
		НачалоСтроки = СтрНайти(Содержание, НачалоНаименования, , НачальнаяПозиция); 
		Пока НачалоСтроки > 0 Цикл
			Если СтрНачинаетсяС(НаименованиеСсылки, Сред(Содержание, НачалоСтроки)) Тогда
				Содержание = Лев(Содержание, НачалоСтроки - 1)
					+ НаименованиеСсылки;
				НаименованиеЗаполнено = Истина;
				Прервать;
			Иначе
				НачальнаяПозиция = НачалоСтроки + 1;
				НачалоСтроки = СтрНайти(Содержание, НачалоНаименования, , НачальнаяПозиция); 
			КонецЕсли;
		КонецЦикла;
		Если НаименованиеЗаполнено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НаименованиеЗаполнено Тогда
		Возврат Содержание;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Процедура ВыбратьПроблемныеПроводки(ТаблицаПроводок, ПроверяемыеМЗ, ПроверяемыеОС, ДанныеПроводок)
	// Проверяется длина немного меньше, чем максимальная, 
	// чтобы учесть возможное прерывание текста на непечатных символах
	МаксимальнаяДлинаСодержания = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ
		.Реквизиты.Содержание.Тип.КвалификаторыСтроки.Длина - 5;
	ПроверяемыеПоля = Новый Массив;
	ПроверяемыеПоля.Добавить("СубконтоДт1");
	ПроверяемыеПоля.Добавить("СубконтоДт2");
	ПроверяемыеПоля.Добавить("СубконтоДт3");
	ПроверяемыеПоля.Добавить("СубконтоКт1");
	ПроверяемыеПоля.Добавить("СубконтоКт2");
	ПроверяемыеПоля.Добавить("СубконтоКт3");
	
	ЕстьПолеОС = (ТаблицаПроводок.Колонки.Найти("ОсновноеСредство") <> Неопределено);
	ЕстьПолеМЗ = (ТаблицаПроводок.Колонки.Найти("Номенклатура") <> Неопределено);
	
	Для Каждого Проводка Из ТаблицаПроводок Цикл
		Если СтрДлина(Проводка.Содержание) < МаксимальнаяДлинаСодержания Тогда
			// Содержание уместилось
			Продолжить;
		КонецЕсли;
		Если ЕстьПолеОС Тогда
			ОсновноеСредство = Проводка.ОсновноеСредство;
		Иначе
			ОсновноеСредство = ЗначениеЗаданногоТипаИзПолей(Проводка, ПроверяемыеПоля,
				Тип("СправочникСсылка.ОсновныеСредства"));
		КонецЕсли;
		Если ЕстьПолеМЗ Тогда
			Номенклатура = Проводка.Номенклатура;
		Иначе
			Номенклатура = ЗначениеЗаданногоТипаИзПолей(Проводка, ПроверяемыеПоля,
				Тип("СправочникСсылка.Номенклатура"));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОсновноеСредство)
				И Не ЗначениеЗаполнено(Номенклатура) Тогда
			// Предусмотрено заполнение полного наименования только из ОС или МЗ.
			// Если в проводке их нет, то дополнить содержание невозможно.
			Продолжить;
		КонецЕсли;
		ПроверяемыеСсылки = Новый Массив;
		Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
			ПроверяемыеСсылки.Добавить(ОсновноеСредство);
			ПроверяемыеОС.Добавить(ОсновноеСредство);
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ПроверяемыеСсылки.Добавить(Номенклатура);
			ПроверяемыеМЗ.Добавить(Номенклатура);
		КонецЕсли;
		ПроверяемаяСтрока = ДанныеПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(ПроверяемаяСтрока, Проводка);
		ПроверяемаяСтрока.ПроверямыеСсылки = ПроверяемыеСсылки;
	КонецЦикла;
КонецПроцедуры

Функция ЗначениеЗаданногоТипаИзПолей(Контейнер, Поля, ЗаданныйТип)
	Для Каждого ИмяПоля Из Поля Цикл
		Если ТипЗнч(Контейнер[ИмяПоля]) = ЗаданныйТип Тогда
			Возврат Контейнер[ИмяПоля];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ТекстЗапросаПечатиИзвещения()

	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Приложения.Ссылка КАК Ссылка,
	|	МАКСИМУМ(Приложения.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ Приложения
	|ИЗ
	|	Документ.ИзвещениеИсходящее.Приложения КАК Приложения
	|ГДЕ
	|	Приложения.Ссылка В (&МассивОбъектов)
	|СГРУППИРОВАТЬ ПО
	|	Приложения.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзвещениеИсходящее.Ссылка КАК Ссылка,
	|	ИзвещениеИсходящее.Номер КАК Номер,
	|	ИзвещениеИсходящее.Дата КАК Дата,
	|	ИзвещениеИсходящее.Проведен КАК Проведен,
	|	ИзвещениеИсходящее.Организация КАК Организация,
	|	ИзвещениеИсходящее.ИФО КАК ИФО,
	|	ИзвещениеИсходящее.ВидИзвещения КАК ВидИзвещения,
	|	ИзвещениеИсходящее.Комментарий КАК Комментарий,
	|	ИзвещениеИсходящее.Получатель КАК Получатель,
	|	ИзвещениеИсходящее.Поставщик КАК Поставщик,
	|	ИзвещениеИсходящее.Договор КАК Договор,
	|	ИзвещениеИсходящее.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	ИзвещениеИсходящее.Организация.КодОКПО КАК пКодОКПО,
	|	ИзвещениеИсходящее.Организация.КодПоРПБС КАК КодПоРПБС,
	|	ИзвещениеИсходящее.Организация.ИНН КАК ИНН,
	|	ИзвещениеИсходящее.Организация.КПП КАК КПП,
	|	ИзвещениеИсходящее.Получатель.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК пНаименованиеПолучатель,
	|	ИзвещениеИсходящее.Получатель.ЮридическоеФизическоеЛицо.КодОКПО КАК пКодОКПОПолучатель,
	|	ИзвещениеИсходящее.Получатель.ЮридическоеФизическоеЛицо.КодПоРПБС КАК пКодРПБСПолучатель,
	|	ИзвещениеИсходящее.Получатель.ИНН КАК ИННПолучатель,
	|	ИзвещениеИсходящее.Получатель.КПП КАК КПППолучатель,
	|	ИзвещениеИсходящее.Организация.КодПоППП.Код КАК пКодГлавы,
	|	ИзвещениеИсходящее.Получатель.ЮридическоеФизическоеЛицо.КодПоППП.Код КАК пКодГлавыПолучатель,
	|	ИзвещениеИсходящее.Руководитель КАК Руководитель,
	|	ИзвещениеИсходящее.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	ИзвещениеИсходящее.Ответственный КАК Ответственный,
	|	ИзвещениеИсходящее.ПояснениеМБТ КАК ПояснениеМБТ,
	|	ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) КАК ИсправлениеОшибок,
	|	ЕСТЬNULL(ПриложенияМаксимум.НомерСтроки, 0) КАК КоличествоПриложений
	|ИЗ
	|	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ИзвещениеИсходящее.Ссылка = ОперацииДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Приложения КАК ПриложенияМаксимум
	|		ПО ИзвещениеИсходящее.Ссылка = ПриложенияМаксимум.Ссылка
	|ГДЕ
	|	ИзвещениеИсходящее.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередаваемыеПроводки.Ссылка КАК Ссылка,
	|	ПередаваемыеПроводки.НомерСтроки КАК НомерСтроки,
	|	ПередаваемыеПроводки.КФО КАК КФО,
	|	ПередаваемыеПроводки.СчетДт КАК СчетДт,
	|	ПередаваемыеПроводки.КПСДт КАК КПСДт,
	|	ПередаваемыеПроводки.КЭКДт КАК КЭКДт,
	|	ПередаваемыеПроводки.СубконтоДт1 КАК СубконтоДт1,
