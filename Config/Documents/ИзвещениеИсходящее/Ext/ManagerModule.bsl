Процедура ДобавитьДанныеШапкиДокумента(СтрокаШапкиДокумента, Документ, ПечатьОтПолучателя)

	СтрокаШапкиДокумента.Дата = Документ.Дата;
	СтрокаШапкиДокумента.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		Документ.Ссылка,
		Документ.Номер);
	
	Если ПечатьОтПолучателя Тогда
		СтрокаШапкиДокумента.пНаименованиеОтправитель = Документ.пНаименованиеПолучатель;
		СтрокаШапкиДокумента.ИННОтправитель           = Документ.пКодРПБСПолучатель;
		СтрокаШапкиДокумента.пКодОКПООтправитель      = Документ.пКодОКПОПолучатель;
		СтрокаШапкиДокумента.пКодГлавыОтправитель     = Документ.пКодГлавыПолучатель;
		СтрокаШапкиДокумента.КППОтправитель           = Документ.КПППолучатель;
		СтрокаШапкиДокумента.пНаименованиеПолучатель  = Документ.пНаименованиеОрганизации;
		СтрокаШапкиДокумента.ИННПолучатель            = Документ.КодПоРПБС;
		СтрокаШапкиДокумента.пКодОКПОПолучатель       = Документ.пКодОКПО;
		СтрокаШапкиДокумента.пКодГлавыПолучатель      = Документ.пКодГлавы;
		СтрокаШапкиДокумента.КПППолучатель            = Документ.КПП;
	Иначе
		СтрокаШапкиДокумента.пНаименованиеОтправитель = Документ.пНаименованиеОрганизации;
		СтрокаШапкиДокумента.ИННОтправитель           = Документ.ИНН;
		СтрокаШапкиДокумента.пКодОКПООтправитель      = Документ.пКодОКПО;
		СтрокаШапкиДокумента.пКодГлавыОтправитель     = Документ.пКодГлавы;
		СтрокаШапкиДокумента.КППОтправитель           = Документ.КПП;
		СтрокаШапкиДокумента.пНаименованиеПолучатель  = Документ.пНаименованиеПолучатель;
		СтрокаШапкиДокумента.ИННПолучатель            = Документ.ИННПолучатель;
		СтрокаШапкиДокумента.пКодОКПОПолучатель       = Документ.пКодОКПОПолучатель;
		СтрокаШапкиДокумента.пКодГлавыПолучатель      = Документ.пКодГлавыПолучатель;
		СтрокаШапкиДокумента.КПППолучатель            = Документ.КПППолучатель;
	КонецЕсли;
	
	СтрокаШапкиДокумента.ПояснениеМБТ = Документ.ПояснениеМБТ;

КонецПроцедуры

Процедура ДобавитьДанныеПроводокДокумента(ПечатаемыеПроводки, Проводки, ПечатьОтПолучателя, Отбор, Знач ПолныеНаименованияНФА = Неопределено)

	Если ПолныеНаименованияНФА = Неопределено Тогда
		ПолныеНаименованияНФА = Новый Соответствие;
	КонецЕсли;
	
	СчетаНФА = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("108.50") Цикл
		СчетаНФА.Вставить(Счет, Истина);
	КонецЦикла;
	СчетаПередачиВПользование = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("24.50, 25.50, 26.50") Цикл
		СчетаПередачиВПользование.Вставить(Счет, Истина);
	КонецЦикла;
	ЕстьПроводкиКтНФА = Ложь;
	СтрокиПередачиВПользование = Новый Массив;
	ПередаваемыеНФА = Новый Массив;
	СтрокиКромеПередачиВПользование = Новый Массив;

	Пока Истина Цикл
		НоваяСтрока = ДобавитьДанныеПроводки(ПечатаемыеПроводки, Проводки, ПечатьОтПолучателя, ПолныеНаименованияНФА);
		Если СчетаПередачиВПользование.Получить(Проводки.СчетДт) <> Неопределено Тогда
			СтрокиПередачиВПользование.Добавить(НоваяСтрока);
			Если ЗначениеЗаполнено(Проводки.ОсновноеСредство) Тогда
				ПередаваемыеНФА.Добавить(Проводки.ОсновноеСредство);
			Иначе
				ПередаваемыеНФА.Добавить(Проводки.Номенклатура);
			КонецЕсли;
		Иначе
			СтрокиКромеПередачиВПользование.Добавить(НоваяСтрока);
			Если Не ЕстьПроводкиКтНФА
					И СчетаНФА.Получить(Проводки.СчетКт) <> Неопределено
					И СчетаНФА.Получить(Проводки.СчетДт) = Неопределено Тогда
				ЕстьПроводкиКтНФА = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Не Проводки.НайтиСледующий(Отбор) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьПроводкиКтНФА И СтрокиПередачиВПользование.Количество() > 0 Тогда
		ДополнительноОбработатьПроводкиПриПередачеВПользование(ПечатаемыеПроводки, СтрокиПередачиВПользование,
			ПередаваемыеНФА, СтрокиКромеПередачиВПользование);
	КонецЕсли;

КонецПроцедуры

Процедура ДополнительноОбработатьПроводкиПриПередачеВПользование(ПечатаемыеПроводки, СтрокиПередачиВПользование, ПередаваемыеНФА, СтрокиКромеПередачиВПользование)
	
	// Из удаляемой проводки нужно взять шаблон текста содержания записи, чтобы в Извещении было не
	// "Списана стоимость", а "Передано в аренду".
	ПрефиксСодержания = "";
	Для ИндексПроводки = 0 По ПередаваемыеНФА.ВГраница() Цикл
		Если ЗначениеЗаполнено(ПередаваемыеНФА[ИндексПроводки]) Тогда
			НаименованиеНФА = Строка(ПередаваемыеНФА[ИндексПроводки]);
			Если СтрДлина(НаименованиеНФА) > 50 Тогда
				НаименованиеНФА = Лев(НаименованиеНФА, 50);
			КонецЕсли;
			НомерСимвола = СтрНайти(СтрокиПередачиВПользование[ИндексПроводки].пСодержание, НаименованиеНФА);
			Если НомерСимвола > 1 Тогда
				ПрефиксСодержания = СокрЛП(Лев(СтрокиПередачиВПользование[ИндексПроводки].пСодержание, НомерСимвола - 1));
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Забалансовые проводки удаляются из печати
	Для Каждого УдаляемаяСтрока Из СтрокиПередачиВПользование Цикл
		ПечатаемыеПроводки.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	// В оставшихся балансовых проводках нужно изменить содержание, в соответствии с найденным префиксом.
	// Если текст содержания не соответствует тексту в типовой конфигурации, то его не нужно заменять.
	Если Не ПустаяСтрока(ПрефиксСодержания) Тогда
		ПрефиксСодержания = ПрефиксСодержания + " ";
		ТекстДляЗамены = "Списана балансовая стоимость";
		НомерСимволаПослеЗамены = СтрДлина(ТекстДляЗамены) + 1;
		Для Каждого ПроверяемаяПроводка Из СтрокиКромеПередачиВПользование Цикл
			Если СтрНачинаетсяС(ПроверяемаяПроводка.пСодержание, ТекстДляЗамены) Тогда
				ПроверяемаяПроводка.пСодержание = ПрефиксСодержания
					+ СокрЛ(Сред(ПроверяемаяПроводка.пСодержание, НомерСимволаПослеЗамены));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьДанныеПроводки(ПечатаемыеПроводки, ПередаваемыеПроводки, ПечатьОтПолучателя, ПолныеНаименованияНФА)
	
	Суффикс = СуффиксОтправительПолучатель(Истина, ПечатьОтПолучателя);
	НоваяСтрокаПроводки = ПечатаемыеПроводки.Добавить();
	НоваяСтрокаПроводки.пСодержание = СодержаниеПроводки(ПередаваемыеПроводки, ПолныеНаименованияНФА);

	НоваяСтрокаПроводки["пСумма" + Суффикс] = ПередаваемыеПроводки.Сумма;
	НоваяСтрокаПроводки["пДебетСчет" + Суффикс] = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
		ПередаваемыеПроводки.КПСДт, ПередаваемыеПроводки.КФО, ПередаваемыеПроводки.СчетДт, ПередаваемыеПроводки.КЭКДт);
	НоваяСтрокаПроводки["пКредитСчет" + Суффикс] = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
		ПередаваемыеПроводки.КПСКт, ПередаваемыеПроводки.КФО, ПередаваемыеПроводки.СчетКт, ПередаваемыеПроводки.КЭККт);
	Возврат НоваяСтрокаПроводки;
	
КонецФункции

Функция СодержаниеПроводки(ПередаваемыеПроводки, ПолныеНаименованияНФА)
	Содержание = ПередаваемыеПроводки.Содержание;
	ДанныеДД = Новый Структура("ВидДД, ДенежныйДокумент");
	ЗаполнитьЗначенияСвойств(ДанныеДД, ПередаваемыеПроводки);
	Если ЗначениеЗаполнено(ДанныеДД.ВидДД) Тогда
		Если ЗначениеЗаполнено(ДанныеДД.ДенежныйДокумент) Тогда
			ШаблонСодержанияДД = НСтр("ru = 'Передача денежных документов. %1. %2.'");
		Иначе
			ШаблонСодержанияДД = НСтр("ru = 'Передача денежных документов. %1.'");
		КонецЕсли;
		Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСодержанияДД, ДанныеДД.ВидДД, ДанныеДД.ДенежныйДокумент);
	Иначе
		СсылкаРегистратора = Новый Структура("Регистратор");
		ЗаполнитьЗначенияСвойств(СсылкаРегистратора, ПередаваемыеПроводки);
		УточненноеСодержание = ПолучитьСодержаниеПроводки(ПередаваемыеПроводки.Ссылка,
			ПередаваемыеПроводки.НомерСтроки,
			ПолныеНаименованияНФА,
			СсылкаРегистратора.Регистратор);
		Если ЗначениеЗаполнено(УточненноеСодержание) Тогда
			Содержание = УточненноеСодержание;
		КонецЕсли;
	КонецЕсли;
	Возврат Содержание;
КонецФункции

Функция ПолучитьСодержаниеПроводки(Документ, НомерСтроки, УточненныеСодержания, Регистратор = Неопределено) Экспорт
	ДанныеДокумента = УточненныеСодержания.Получить(Документ);
	Если ДанныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	УточненноеСодержание = ДанныеДокумента.Получить(НомерСтроки);
	Если Не ЗначениеЗаполнено(УточненноеСодержание) И ЗначениеЗаполнено(Регистратор) Тогда
		ДанныеРегистратора = ДанныеДокумента.Получить(Регистратор);
		Если ДанныеРегистратора <> Неопределено Тогда
			УточненноеСодержание = ДанныеРегистратора.Получить(НомерСтроки);
		КонецЕсли;
	КонецЕсли;
	Возврат УточненноеСодержание;
КонецФункции

Процедура ДобавитьДанныеПодвала(СтрокаШапкиДокумента, Документ, ПечатьОтПолучателя)

	СтрокаШапкиДокумента.пКоличествоПриложений = Документ.КоличествоПриложений;

	Суффикс = СуффиксОтправительПолучатель(Истина, ПечатьОтПолучателя);
	
	СтрокаШапкиДокумента["пФИОРуководитель" + Суффикс] = Справочники.Сотрудники.ФамилияИО(
		Документ.Руководитель,
		Истина,
		Документ.Дата);
	СтрокаШапкиДокумента["пФИОБухгалтер" + Суффикс] = Справочники.Сотрудники.ФамилияИО(
		Документ.ГлавныйБухгалтер,
		Истина,
		Документ.Дата);
	ДанныеОтветственного = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(
		Документ.Ответственный,
		Документ.Организация,
		Документ.Дата,
		Истина);
	СтрокаШапкиДокумента["ДолжностьИсполнитель" + Суффикс] = ДанныеОтветственного.ДолжностьНаименование;
	СтрокаШапкиДокумента["ФИОИсполнитель" + Суффикс] = ДанныеОтветственного.ФИО;
	СтрокаШапкиДокумента["ТелефонИсполнитель" + Суффикс] = ДанныеОтветственного.НомерТелефона;
	СтрокаШапкиДокумента["ЭлАдресИсполнитель" + Суффикс] = ДанныеОтветственного.ЭлектроннаяПочта;
	
КонецПроцедуры

// Суффикс отправитель получатель.
// 
// Параметры:
//  Отправитель - Булево
//  ПечатьОтПолучателя - Булево
// 
// Возвращаемое значение:
//  Строка
Функция СуффиксОтправительПолучатель(Знач Отправитель, ПечатьОтПолучателя)
	Если ПечатьОтПолучателя Тогда
		Отправитель = Не Отправитель;
	КонецЕсли;
	Если Отправитель Тогда
		Возврат "Отправитель";
	КонецЕсли;
	Возврат "Получатель";
КонецФункции

Функция ДокументПечатаетсяОтПолучателя(Документ)

	Возврат Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ
		Или Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА
		Или Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА
		Или Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика
		Или Документ.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ;

КонецФункции

#КонецОбласти

// Функция - Таблица передаваемых расчетов
//
// Параметры:
//  Документ - ДокументОбъект.ИзвещениеИсходящее
//
//  ТаблицаРасчетов	 - ТаблицаЗначений
//	Описание см. в функции УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов()
//
// Возвращаемое значение: - ТаблицаЗначений - колонки:
//	Описание см. в функции УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов()
//
Функция ПодготовитьТаблицуРасчетовПоДокументу(ТаблицаРасчетов, Документ,  Параметры, Отказ) Экспорт
	
	Для Каждого СтрИсх Из Документ.ПередаваемыеПроводки Цикл
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		
		СтрокаРасчетов.ЭтоПоступление 	= Истина;
		СтрокаРасчетов.ИФО 			= Документ.ИФО;
		СтрокаРасчетов.КФО 			= СтрИсх.КФО;
		СтрокаРасчетов.КПС 			= СтрИсх.КПСКт;
		СтрокаРасчетов.КЭК 			= СтрИсх.КЭККт;
		СтрокаРасчетов.Подразделение 	= СтрИсх.ПодразделениеКт;
		СтрокаРасчетов.СчетРасчетов 	= СтрИсх.СчетКт;
		СтрокаРасчетов.СуммаРасчетов	= СтрИсх.Сумма;
		
		Для Инд = 1 По 3 Цикл
			Если ТипЗнч(СтрИсх["СубконтоКт" + СокрЛП(Строка(Инд))]) = Тип("СправочникСсылка.Контрагенты") Тогда
				СтрокаРасчетов.Контрагент = СтрИсх["СубконтоКт" + СокрЛП(Строка(Инд))];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Инд = 1 По 3 Цикл
			Если ТипЗнч(СтрИсх["СубконтоКт" + СокрЛП(Строка(Инд))]) = Тип("СправочникСсылка.Договоры") Тогда
				СтрокаРасчетов.Договор = СтрИсх["СубконтоКт" + СокрЛП(Строка(Инд))];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРасчетов.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции	

Функция ТипыДокументовПередачиПоВидуИзвещения(ВидИзвещения) Экспорт

	МассивТипов = Новый Массив;
	Если ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада Тогда 
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаГруппОбъектовОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаЗдания"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаОбъектаОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаОбъектовОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
		МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеБСО"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаБСО"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ВыбытиеНеоплаченныхПутевок"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаОбъектовИК"));
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускИК"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств Тогда 
		МассивТипов.Добавить(Тип("ДокументСсылка.ВыбытиеНеоплаченныхПутевок"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаВозврат"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
		МассивТипов.Добавить(Тип("ДокументСсылка.КассовоеВыбытие"));
		МассивТипов.Добавить(Тип("ДокументСсылка.КорректировкаРасчетовСУчредителем"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
		МассивТипов.Добавить(Тип("ДокументСсылка.РасходныйОрдерФондовый"));
		МассивТипов.Добавить(Тип("ДокументСсылка.РСКППеречисление"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаБСО Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеБСО"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПередачаБСО"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ВыбытиеФинансовыхВложений"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ВыбытиеФинансовыхВложений"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеБСО Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеБСО"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.КассовоеПоступление"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеНеоплаченныхПутевок"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПриходныйОрдерФондовый"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ОперацияБух"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ИзвещениеВходящее"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДохода
		ИЛИ ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств
		ИЛИ ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеТребований Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ОперацияБух"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеРБП Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ИзвещениеВходящее"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ОперацияБух"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуФинансовыхВложений"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ФормированиеВложенийВФинансовыеАктивы"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА
		Или ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРабот"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	КонецЕсли;
	
	Возврат МассивТипов;

КонецФункции // ТипыДокументовПередачиПоВидуИзвещения()

