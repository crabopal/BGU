
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "Организация, НалоговыйОрган, ОтчетныйГод, ВидСправки");
	
	УстановитьВидимостьПоВидуСправки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьПоВидуСправки()
	
	СправкиОбразование =	ВидСправки = ПредопределенноеЗначение("Перечисление.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги");
	СправкиМедицина =		ВидСправки = ПредопределенноеЗначение("Перечисление.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги");
	СправкиФизкультура =	ВидСправки = ПредопределенноеЗначение("Перечисление.ВидыСправокДляНалоговогоВычета.ФизкультурноОздоровительныеУслуги");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СведенияДляСправокОбразованиеСуммаРасходов", "Видимость", СправкиОбразование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СведенияДляСправокОбразованиеОчнаяФорма", "Видимость", СправкиОбразование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СведенияДляСправокМедицинаСуммаРасходов1", "Видимость", СправкиМедицина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СведенияДляСправокМедицинаСуммаРасходов2", "Видимость", СправкиМедицина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СведенияДляСправокФизкультураСуммаРасходов", "Видимость", СправкиФизкультура);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	СведенияДляСправок.Очистить();
	
	//Добавить заполнение в зависимости от вида справки
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСоСтудентамиОбороты.Контрагент КАК Налогоплательщик,
		|	ВЫБОР
		|		КОГДА РасчетыСоСтудентамиОбороты.Контрагент = РасчетыСоСтудентамиОбороты.Студент.Контрагент
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
		|		ИНАЧЕ РасчетыСоСтудентамиОбороты.Студент.Контрагент
		|	КОНЕЦ КАК Получатель,
		|	РасчетыСоСтудентамиОбороты.СуммаРеглРасход КАК ОбразованиеСуммаРасходов
		|ИЗ
		|	РегистрНакопления.РасчетыСоСтудентами.Обороты(&НачалоПериода, &КонецПериода, , Организация = &Организация) КАК РасчетыСоСтудентамиОбороты
		|ГДЕ
		|	РасчетыСоСтудентамиОбороты.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|	И РасчетыСоСтудентамиОбороты.СуммаРеглРасход > 0";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ОтчетныйГод));
	Запрос.УстановитьПараметр("КонецПериода", КонецГода(ОтчетныйГод));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = СведенияДляСправок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

