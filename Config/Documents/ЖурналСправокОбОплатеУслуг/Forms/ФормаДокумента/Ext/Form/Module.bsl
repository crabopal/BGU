&НаСервере
Функция НайтиСправкуОбОплатеУслугПоУИД(УИДСправкиВЖурнале)
	
	СправкаПоУИД = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.УИДСправкиВЖурнале = &УИДСправкиВЖурнале";
	
	Запрос.УстановитьПараметр("УИДСправкиВЖурнале", УИДСправкиВЖурнале);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СправкаПоУИД = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
		
	Возврат СправкаПоУИД;
	
КонецФункции

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
