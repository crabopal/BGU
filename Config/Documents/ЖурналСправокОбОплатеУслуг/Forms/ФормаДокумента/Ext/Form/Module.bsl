&НаСервере
Процедура ПроверитьНаСервере(Отказ = Ложь, ЕстьКритичныеОшибки = Ложь, ТаблицаОшибок, НеблокирующиеПроверки = Истина)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ДокументОбъект.ПроверитьОбязательныеПоля(ЕстьКритичныеОшибки);
	Если ЕстьКритичныеОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.ПроверитьДанныеДокумента(Отказ, НеблокирующиеПроверки);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УведомлениеОбъект = ДокументОбъект.Уведомление.ПолучитьОбъект();
	ТаблицаОшибок = УведомлениеОбъект.ПроверитьДокументСВыводомВТаблицу(УникальныйИдентификатор);
	Отказ = ТаблицаОшибок.Количество() > 0;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСправкамиНаСервере()
	
	// Необходимо добавить в ТЧ все проведенные документы-справки (с учетом отбора), не использованные в других журналах.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка КАК Ссылка,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСведений,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки КАК НомерКорректировки
		|ПОМЕСТИТЬ ВТ_ВсеСправки
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Проведен
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.ОтчетныйГод = &ОтчетныйГод
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.ВидСправки = &ВидСправки
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.НалоговыйОрган = &НалоговыйОрган
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеСправки.НомерСведений КАК НомерСведений,
		|	МАКСИМУМ(ВТ_ВсеСправки.НомерКорректировки) КАК НомерКорректировки
		|ПОМЕСТИТЬ ВТ_НомераИКорректировки
		|ИЗ
		|	ВТ_ВсеСправки КАК ВТ_ВсеСправки
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВсеСправки.НомерСведений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеСправки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_СправкиМаксимальныйНомер
		|ИЗ
		|	ВТ_ВсеСправки КАК ВТ_ВсеСправки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НомераИКорректировки КАК ВТ_НомераИКорректировки
		|		ПО ВТ_ВсеСправки.НомерСведений = ВТ_НомераИКорректировки.НомерСведений
		|		И ВТ_ВсеСправки.НомерКорректировки = ВТ_НомераИКорректировки.НомерКорректировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВТ_СправкиМаксимальныйНомер.Ссылка КАК СправкаОбОплатеУслуг
		|ИЗ
		|	ВТ_СправкиМаксимальныйНомер КАК ВТ_СправкиМаксимальныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЖурналСправокОбОплатеУслуг.Справки КАК ЖурналСправокОбОплатеУслугСправки
		|		ПО ВТ_СправкиМаксимальныйНомер.Ссылка = ЖурналСправокОбОплатеУслугСправки.СправкаОбОплатеУслуг
		|		И ЖурналСправокОбОплатеУслугСправки.Ссылка <> &Ссылка
		|		И НЕ ЖурналСправокОбОплатеУслугСправки.Ссылка.ПометкаУдаления
		|ГДЕ
		|	ЖурналСправокОбОплатеУслугСправки.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("ВидСправки",		Объект.ВидСправки);
	Запрос.УстановитьПараметр("ОтчетныйГод",	Объект.ОтчетныйГод);
	Запрос.УстановитьПараметр("НалоговыйОрган",	Объект.НалоговыйОрган);
	Запрос.УстановитьПараметр("Ссылка",		    Объект.Ссылка);
	
	Объект.Справки.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

