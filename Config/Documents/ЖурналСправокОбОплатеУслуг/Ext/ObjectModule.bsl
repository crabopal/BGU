#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий 

Процедура ПриКопировании(ОбъектКопирования)
	
	Справки.Очистить();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Пустая() Тогда
		НоваяСсылка = Документы.ЖурналСправокОбОплатеУслуг.ПолучитьСсылку();
		УстановитьСсылкуНового(НоваяСсылка);
	КонецЕсли;
		
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		АктуализироватьУведомлениеОСпецрежимахНалогообложения(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбязательныеПоля(Отказ) Экспорт
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не указана организация.'"), ЭтотОбъект, "Организация", "Объект", Отказ);
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДанныеДокумента(Отказ, НеблокирующиеПроверки = Истина) Экспорт
	ДополнительныеСвойства.Вставить("НеблокирующиеПроверки", НеблокирующиеПроверки);
	
	Если Не ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Ошибки = Неопределено;
	ДополнительныеСвойства.Свойство("Ошибки", Ошибки);
КонецПроцедуры

Процедура АктуализироватьУведомлениеОСпецрежимахНалогообложения(ТекущийОбъект)
	
	УведомлениеОбъект = Неопределено;
	Если ЗначениеЗаполнено(Уведомление) Тогда
		УведомлениеОбъект = Уведомление.ПолучитьОбъект();
	КонецЕсли;
		
	Если УведомлениеОбъект = Неопределено Тогда
		УведомлениеОбъект = Документы.УведомлениеОСпецрежимахНалогообложения.СоздатьДокумент();
	КонецЕсли;
	
	УведомлениеОбъект.Дата = Дата;
	УведомлениеОбъект.ДатаПодписи = Дата;
	УведомлениеОбъект.Организация = Организация;
	УведомлениеОбъект.Основание = Ссылка;
	УведомлениеОбъект.РегистрацияВИФНС = НалоговыйОрган;
	УведомлениеОбъект.ВидУведомления = Перечисления.ВидыСправокДляНалоговогоВычета.ВидУведомленияПоВидуСправки(ВидСправки);
	УведомлениеОбъект.ИмяОтчета = 
		УведомлениеОСпецрежимахНалогообложенияПовтИсп.ПолучитьСоответствиеВидовУведомленийИменамОтчетов()[УведомлениеОбъект.ВидУведомления];
	УведомлениеОбъект.ИмяФормы = 
		СтрРазделить(ИнтерфейсыВзаимодействияБРОВызовСервера.ПолучитьИмяФормыУведомленияПоУмолчанию(УведомлениеОбъект.ВидУведомления, Дата), ".")[3];
		
	Запрос = Новый Запрос;
	Если УведомлениеОбъект.ВидУведомления = Перечисления.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаМедицинскихУслуг Тогда 
		Запрос.Текст = "ВЫБРАТЬ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.УИДСправкиВЖурнале КАК УИД,
		|	&НаимОрг КАК НаимОрг,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСвед,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки КАК НомКорр,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикФамилия КАК Фамилия,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИмя КАК Имя,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикОтчество КАК Отчество,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИНН КАК ИННФЛ,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДатаРождения КАК ДатаРожд,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументВид КАК КодВидДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументНомер КАК СерНомДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументДата КАК ДатаДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо КАК НалогоплательщикИПолучательУслугиОдноЛицо,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательФамилия КАК ФамилияПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИмя КАК ИмяПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательОтчество КАК ОтчествоПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИНН КАК ИННФЛПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДатаРождения КАК ДатаРождПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументВид КАК КодВидДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументНомер КАК СерНомДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументДата КАК ДатаДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.МедицинаСуммаРасходов1 КАК СуммаКод1,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.МедицинаСуммаРасходов2 КАК СуммаКод2,
		|	ВЫБОР КОГДА СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо
		|		ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК ПрПациент
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка В(&Справки)";
	ИначеЕсли УведомлениеОбъект.ВидУведомления = Перечисления.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаОбразовательныхУслуг Тогда 
		Запрос.Текст = "ВЫБРАТЬ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.УИДСправкиВЖурнале КАК УИД,
		|	&НаимОрг КАК НаимОрг,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСвед,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки КАК НомКорр,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикФамилия КАК Фамилия,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИмя КАК Имя,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикОтчество КАК Отчество,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИНН КАК ИННФЛ,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДатаРождения КАК ДатаРожд,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументВид КАК КодВидДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументНомер КАК СерНомДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументДата КАК ДатаДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо КАК НалогоплательщикИПолучательУслугиОдноЛицо,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательФамилия КАК ФамилияПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИмя КАК ИмяПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательОтчество КАК ОтчествоПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИНН КАК ИННФЛПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДатаРождения КАК ДатаРождПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументВид КАК КодВидДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументНомер КАК СерНомДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументДата КАК ДатаДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ОбразованиеСуммаРасходов КАК СуммаРасх,
		|	ВЫБОР КОГДА СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо
		|		ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК ПрОбуч,
		|	ВЫБОР КОГДА СправкаОбОплатеУслугДляНалоговогоВычета.ОбразованиеОчнаяФорма
		|		ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК ПрФормОбуч
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка В(&Справки)";
	ИначеЕсли УведомлениеОбъект.ВидУведомления = Перечисления.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаФизкультурноОздоровительныхУслуг Тогда 
		Запрос.Текст = "ВЫБРАТЬ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.УИДСправкиВЖурнале КАК УИД,
		|	&НаимОрг КАК НаимОрг,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСвед,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки КАК НомКорр,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикФамилия КАК Фамилия,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИмя КАК Имя,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикОтчество КАК Отчество,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИНН КАК ИННФЛ,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДатаРождения КАК ДатаРожд,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументВид КАК КодВидДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументНомер КАК СерНомДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументДата КАК ДатаДок,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо КАК НалогоплательщикИПолучательУслугиОдноЛицо,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательФамилия КАК ФамилияПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИмя КАК ИмяПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательОтчество КАК ОтчествоПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИНН КАК ИННФЛПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДатаРождения КАК ДатаРождПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументВид КАК КодВидДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументНомер КАК СерНомДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументДата КАК ДатаДокПолучатель,
		|	СправкаОбОплатеУслугДляНалоговогоВычета.ФизкультураСуммаРасходов КАК СуммаРасх,
		|	ВЫБОР КОГДА СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо
		|		ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК ПрКлиент
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка В(&Справки)";
	КонецЕсли;
	НаимОрг = Справочники.Организации.ПредставлениеУчреждения(Организация, Истина);
	Запрос.УстановитьПараметр("Справки", Справки.ВыгрузитьКолонку("СправкаОбОплатеУслуг"));
	Запрос.УстановитьПараметр("НаимОрг", НаимОрг);
	ДанныеСправок = Запрос.Выполнить().Выгрузить();
	
	ДанныеУведомления = Новый Структура;
	ДанныеУведомления.Вставить("ОтчГод", Формат(Год(ОтчетныйГод), "ЧГ="));
	ДанныеУведомления.Вставить("РазрешитьВыгружатьСОшибками", РазрешитьВыгружатьСОшибками);
	ДанныеУведомления.Вставить("НаимОрг", НаимОрг);
	
	Отчеты[УведомлениеОбъект.ИмяОтчета].ЗаполнитьЖурналСправокДанными(УведомлениеОбъект, ДанныеУведомления, ДанныеСправок);
	УведомлениеОбъект.Записать();
	
	Уведомление = УведомлениеОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли