#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ОбменДанными.Загрузка Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ВидПоступления = Перечисления.ВидыОперацийИК.Поступление Тогда
		Отказ = ОсновноеСредствоУжеПринятоКУчету();
	Иначе
		Отказ = ОсновноеСредствоУжеВозвращено();
	КонецЕсли;
	Если Отказ Тогда 
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
	КонецЕсли;
	
	Если ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда
		ИЛИ ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратБезвозмездноеПользование Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользования");
		МассивНепроверяемыхРеквизитов.Добавить("ПорядокПогашенияСтоимости");
		СтоимостьНеПогашается = Истина;
		
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);
		Если НЕ УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
			МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользования");
		КонецЕсли;
		СтоимостьНеПогашается = Ложь;
	КонецЕсли;
	УправлениеОсновнымиСредствами.ДобавитьНепроверяемыеРеквизитыСчетаЗатрат(СтоимостьНеПогашается,
		ПорядокПогашенияСтоимости, СчетУчетаЗатрат, МассивНепроверяемыхРеквизитов);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ИнвентарныйНомер		= Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	УправлениеОсновнымиСредствами.ОчиститьНеиспользуемыеРеквизитыПринятияКУчету(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации, НачислятьАмортизацию, СчетУчетаЗатрат,
														КЭКЗатрат, КПСЗатрат, ПодразделениеЗатрат, СубконтоЗатрат1, СубконтоЗатрат2, СубконтоЗатрат3);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияИК.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ОсновноеСредствоУжеПринятоКУчету()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПРЕДСТАВЛЕНИЕ(СобытияОС.Событие) КАК Событие,
	               |	СобытияОС.ДатаСобытия,
	               |	ВЫБОР
	               |		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	               |			ТОГДА 1
	               |		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	               |			ТОГДА 2
	               |		ИНАЧЕ 3
	               |	КОНЕЦ КАК Поле1,
	               |	СобытияОС.Регистратор,
	               |	ПРЕДСТАВЛЕНИЕ(СобытияОС.Регистратор) КАК ПредставлениеРегистратора
	               |ИЗ
	               |	РегистрСведений.СобытияОС КАК СобытияОС
	               |ГДЕ
	               |	СобытияОС.Организация = &Организация
	               |	И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |	И СобытияОС.ИнвНомер = &ИнвНомер";
	Если ЭтотОбъект.ЭтоНовый() Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	И СобытияОС.Период <= &Период";
		Запрос.УстановитьПараметр("Период", 		КонецДня(Дата));
	Иначе
		Запрос.Текст = Запрос.Текст + "
	               |	И СобытияОС.МоментВремени <= &МоментВремени
	               |	И СобытияОС.Регистратор <> &Регистратор";
		Запрос.УстановитьПараметр("МоментВремени",	МоментВремени());
		Запрос.УстановитьПараметр("Регистратор",	Ссылка);
	КонецЕсли;	
	Запрос.Текст = Запрос.Текст + "	
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Поле1";
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство",	ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер",			ИнвентарныйНомер);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Если ОсновноеСредство.ГрупповойУчет Тогда
			ТекстСообщения = НСтр("ru='По выбранному инвентарному номеру уже произведено [ВидСобытияОС] документом [Регистратор]'");
			ВставляемыеПараметры = Новый Структура("ВидСобытияОС, Регистратор", НРег(Выборка.Событие), Выборка.ПредставлениеРегистратора);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщения, ВставляемыеПараметры);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.ИнвентарныйНомер");
		Иначе
			ТекстСообщения = НСтр("ru='По выбранному объекту уже произведено [ВидСобытияОС] документом [Регистратор]'");
			ВставляемыеПараметры = Новый Структура("ВидСобытияОС, Регистратор", НРег(Выборка.Событие), Выборка.ПредставлениеРегистратора);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщения, ВставляемыеПараметры);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство");
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
				
КонецФункции

Функция ОсновноеСредствоУжеВозвращено()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СобытияОС.Период,
	               |	СобытияОС.Событие,
	               |	СобытияОС.ОсновноеСредство,
	               |	СобытияОС.ИнвНомер
	               |ПОМЕСТИТЬ ВсеСобытия
	               |ИЗ
	               |	РегистрСведений.СобытияОС КАК СобытияОС
	               |ГДЕ
	               |	СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |	И СобытияОС.Организация = &Организация
	               |	И СобытияОС.ИнвНомер = &ИнвНомер
	               |	И СобытияОС.ДатаСобытия <= &Период
	               |	И СобытияОС.Событие В (&СобытиеПередача, &СобытиеВозврат)
	               |	И СобытияОС.Регистратор <> &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Передача.Период КАК ДатаПередачи,
	               |	Возврат.Период КАК ДатаВозврата
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(ВсеСобытия.Период) КАК Период
	               |	ИЗ
	               |		ВсеСобытия КАК ВсеСобытия
	               |	ГДЕ
	               |		ВсеСобытия.Событие = &СобытиеПередача) КАК Передача,
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(ВсеСобытия.Период) КАК Период
	               |	ИЗ
	               |		ВсеСобытия КАК ВсеСобытия
	               |	ГДЕ
	               |		ВсеСобытия.Событие = &СобытиеВозврат) КАК Возврат
	               |ГДЕ
	               |	Передача.Период ЕСТЬ НЕ NULL ";
	Запрос.УстановитьПараметр("Период", 			?(Ссылка.Пустая(), КонецДня(Дата), Дата));
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство",	ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер", 			ИнвентарныйНомер);
	Запрос.УстановитьПараметр("Ссылка", 			Ссылка);
	Если ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда Тогда
		Запрос.УстановитьПараметр("СобытиеПередача",	Перечисления.ВидыСобытийОС.СдачаВАренду);
		Запрос.УстановитьПараметр("СобытиеВозврат", 	Перечисления.ВидыСобытийОС.ВозвратИзАренды);
		ТекстСообщения1 = НСтр("ru='Основное средство [ОС], инв. № [ИнвНом] не было передано в аренду'");
		ТекстСообщения2 = НСтр("ru='Основное средство [ОС], инв. № [ИнвНом] уже возвращено из аренды'");
	ИначеЕсли ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратБезвозмездноеПользование Тогда
		Запрос.УстановитьПараметр("СобытиеПередача", 	Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование);
		Запрос.УстановитьПараметр("СобытиеВозврат", 	Перечисления.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования);
		ТекстСообщения1 = НСтр("ru='Основное средство [ОС], инв. № [ИнвНом] не было передано в безвозмездное пользование'");
		ТекстСообщения2 = НСтр("ru='Основное средство [ОС], инв. № [ИнвНом] уже возвращено из безвозмездного пользоваения'");
	КонецЕсли;
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		
		ПараметрыСообщения = Новый Структура("ОС, ИнвНом", ОсновноеСредство, ?(ЗначениеЗаполнено(ИнвентарныйНомер), СокрЛП(ИнвентарныйНомер.Код), НСтр("ru='<не выбран>'")));
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщения1, ПараметрыСообщения));
		Возврат Истина;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Если ЗначениеЗаполнено(Выборка.ДАтаВозврата) Тогда
			
			ПараметрыСообщения = Новый Структура("ОС, ИнвНом", ОсновноеСредство, ?(ЗначениеЗаполнено(ИнвентарныйНомер), СокрЛП(ИнвентарныйНомер.Код), НСтр("ru='<не выбран>'")));
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщения2, ПараметрыСообщения));
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#КонецЕсли