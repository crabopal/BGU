&НаКлиенте
Перем ВыборОСОбработан;

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УправлениеНФА.ПроверитьУчетИмуществаКазны();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект, "ВыбратьКомиссию,СоставКомиссииПодобратьКомиссию,ВыбратьПредседателя");
	
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитаФормыПоПлануСчетов(Объект.СчетУчетаЗатрат);
	
	// если документ скопирован или введен на основании, то чтения на сервере не было
	Если Параметры.Ключ.Пустая() И ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		ПрочитатьРеквизитыОС(Объект.ОсновноеСредство, ОС_КодОКОФ, ОС_СчетУчета, ОС_АмортизационнаяГруппа, Объект.Дата);
	КонецЕсли;
	Если Параметры.Ключ.Пустая() Тогда
		ДоступностьЭлементовПоОперации(ЭтаФорма, Объект);
		УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
		УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(ЭтаФорма, Объект);
		УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	КонецЕсли;

	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, Новый Структура("СчетОбъекта, Субконто1, Субконто2, Субконто3, Подразделение",
																									"СчетУчетаЗатрат",
																									"СубконтоЗатрат1",
																									"СубконтоЗатрат2",
																									"СубконтоЗатрат3",
																									"ПодразделениеЗатрат"));
																									
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСписокВыбораКПСЗатрат(Элементы.КПСЗатрат);		
	УправлениеОсновнымиСредствамиКлиентСервер.УстановитьТекстИЦветКПСЗатрат(Элементы.КПСЗатрат, Объект.КПСЗатрат);
	
	Элементы.Подразделение.АвтоОтметкаНезаполненного = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
														И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям;
	
	УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма);	
	
	УстановитьОграниченияВыбораСчетаУчетаОС();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеОсновнымиСредствамиКлиент.ПриОткрытииДокумента173н(ЭтотОбъект, "ПринятиеКУчетуОбъектовИК");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	ПрочитатьРеквизитыОС(Объект.ОсновноеСредство, ОС_КодОКОФ, ОС_СчетУчета, ОС_АмортизационнаяГруппа, Объект.Дата);
	
	УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма);
	
	ДоступностьЭлементовПоОперации(ЭтаФорма, Объект);
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
    Оповестить("ДокументыПоУчетуИКИзменение");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если Лев(ИсточникВыбора.ИмяФормы,40) = "Справочник.ПостоянноДействующиеКомиссии." Тогда
		УправлениеОсновнымиСредствамиКлиент.УстановитьКомиссиюВДокументОС(ВыбранноеЗначение, Объект, ЭтаФорма);
	ИначеЕсли Лев(ИсточникВыбора.ИмяФормы,22) = "Справочник.Сотрудники." Тогда
		УправлениеОсновнымиСредствамиКлиент.ОбработатьВыборПредседателяКомиссии(ЭтаФорма,
																				ВыбранноеЗначение, 
																				, 
																				Объект.ДолжностьПредседателяКомиссии,
																				Объект.ФамилияПредседателяКомиссии,
																				Объект.ИмяПредседателяКомиссии,
																				Объект.ОтчествоПредседателяКомиссии);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбработатьДанныеОС = Ложь;
	
	Если ИмяСобытия = "ЗаполнениеДанныхОС" И ТипЗнч(Параметр) = Тип("Структура") И Источник = ЭтаФорма Тогда
		ОсновноеСредство = Неопределено;
		Параметр.Свойство("Ссылка", ОсновноеСредство);
		Если ОсновноеСредство = Объект.ОсновноеСредство Тогда
			ОбработатьДанныеОС = Истина;
			ЗначенияРеквизитов = Новый Структура("СчетУчета,АмортизационнаяГруппа");
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Параметр);			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_ОсновныеСредства" И Источник = Объект.ОсновноеСредство Тогда
		
		ОбработатьДанныеОС = Истина;
		ЗначенияРеквизитов = ЗначенияРеквизитовОС(Объект.ОсновноеСредство, Объект.Дата);
		
	КонецЕсли;
	
	Если ОбработатьДанныеОС Тогда
		
		ОС_Модифицированность = Ложь;
		
		Если ЗначенияРеквизитов.АмортизационнаяГруппа <> ОС_АмортизационнаяГруппа Тогда
			ОС_АмортизационнаяГруппа = ЗначенияРеквизитов.АмортизационнаяГруппа;
			ОС_Модифицированность = Истина;
		КонецЕсли;
		Если ЗначенияРеквизитов.СчетУчета <> ОС_СчетУчета Тогда
			ОС_СчетУчета = ЗначенияРеквизитов.СчетУчета;
			ОС_Модифицированность = Истина;
		КонецЕсли;
		Если ОС_Модифицированность Тогда
			ПриИзмененииОсновногоСредства(Ложь);
		КонецЕсли;
		УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ПрочитатьРеквизитыОС(Объект.ОсновноеСредство, ОС_КодОКОФ, ОС_СчетУчета, ОС_АмортизационнаяГруппа, Объект.Дата);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ВидПоступленияПриИзменении(Элемент)
	ДоступностьЭлементовПоОперации(ЭтаФорма, Объект);
	УстановитьПараметрыАмортизации();
	УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(ЭтаФорма, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	Если НЕ ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны
		И НЕ ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости) Тогда
		Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
	КонецЕсли;
	
	Если ВыборОСОбработан Тогда
		ПриИзмененииОсновногоСредства(НЕ ЗначениеЗаполнено(Объект.ИнвентарныйНомер));
	Иначе
		ОсновноеСредствоПриИзмененииНаСервере();
		ПриИзмененииОсновногоСредства(Ложь);
	КонецЕсли;
	ВыборОСОбработан = Ложь;
	
	РассчитатьСумму(Ложь);
	
	УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборОСОбработан = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СоответствиеРеквизитов = Новый Соответствие;
	СоответствиеРеквизитов.Вставить("КодПоОКОФ", 				"ОС_КодОКОФ");
	СоответствиеРеквизитов.Вставить("СчетУчета", 				"ОС_СчетУчета");
	СоответствиеРеквизитов.Вставить("АмортизационнаяГруппа", 	"ОС_АмортизационнаяГруппа");
	СоответствиеРеквизитов.Вставить("ИнвентарныйНомер", 		"Объект.ИнвентарныйНомер");
	УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбораОсновногоСредства(ВыбранноеЗначение, Новый Структура("Форма, Объект", ЭтаФорма, Объект), СоответствиеРеквизитов, ВыборОСОбработан);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура("Отбор, НаДату, ТекущаяСтрока",
										Новый Структура("Владелец, ОС",
														Объект.Организация,
														Объект.ОсновноеСредство),
										?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата),													
										Объект.ИнвентарныйНомер);
	//Параметры для формирования Инвентарных номеров
	ПараметрыФормы.Вставить("Дата",				Объект.Дата);
	ПараметрыФормы.Вставить("КФО",								ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	ПараметрыФормы.Вставить("СчетУчета",						Объект.СчетУчета);
	ПараметрыФормы.Вставить("Организация",						Объект.Организация);
	ПараметрыФормы.Вставить("ОсновноеСредство",					Объект.ОсновноеСредство);
	ПараметрыФормы.Вставить("ИнвентарныйНомер",					Объект.ИнвентарныйНомер);
	ПараметрыФормы.Вставить("ФормированиеИзДокумента",			Истина);
	ПараметрыФормы.Вставить("Регистратор",						Объект.Ссылка);
    ПараметрыФормы.Вставить("ФормированиеИнвНомераБезОбработки",Истина);
	ПараметрыФормы.Вставить("ПроверитьСоздатьИнвентарныйНомер",	Истина);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ПометкаУдаления, Владелец, ОС", Ложь, Объект.Организация, Объект.ОсновноеСредство));
	
	ДопустимыеВидыКПС = Новый СписокЗначений;
	ДопустимыеВидыКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
	ДопустимыеВидыКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	
	ПараметрыФормы.Вставить("ДопустимыеВидыКПС",ДопустимыеВидыКПС);
		
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

