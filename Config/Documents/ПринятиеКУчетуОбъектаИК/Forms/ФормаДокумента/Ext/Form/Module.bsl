&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.РеквизитыЛицевогоСчета.Доступность				= ДоступностьЭлементов;
	Элементы.Подразделение.Доступность						= ДоступностьЭлементов;
	Элементы.ОсновноеСредство.Доступность 					= ДоступностьЭлементов;
	
	Элементы.ВыбратьКомиссию.Доступность					= ДоступностьЭлементов;
	Элементы.ВыбратьПредседателя.Доступность				= ДоступностьЭлементов;
	Элементы.СоставКомиссииПодобратьКомиссию.Доступность	= ДоступностьЭлементов;

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()
 
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(Форма, Объект)

	Элементы = Форма.Элементы;
	ВестиАналитическийИИнвентарныйУчет = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ЭтоПоступление = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление");
	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПорядокПогашенияСтоимости.Доступность				= ЭтоПоступление;
	Элементы.ПредупреждениеВсеРеквизитыЗаполнены.Доступность	= ДоступностьЭлементов;
	Элементы.ИнвентарныйНомер.Доступность 						= ДоступностьЭлементов И ВестиАналитическийИИнвентарныйУчет;
	Элементы.ПервоначальнаяСтоимость.Доступность				= ДоступностьЭлементов;
	Элементы.СуммаАмортизации.Доступность 						= ДоступностьЭлементов И ЭтоПоступление;
	Элементы.ДатаВводаВЭксплуатацию.Доступность 				= ДоступностьЭлементов И ЭтоПоступление И ВестиАналитическийИИнвентарныйУчет;
	Элементы.ОставшийсяСрокПолезногоИспользования.Доступность	= ДоступностьЭлементов И ЭтоПоступление И ВестиАналитическийИИнвентарныйУчет;
	Элементы.СрокПолезногоИспользования.Доступность 			= ДоступностьЭлементов И ЭтоПоступление И ВестиАналитическийИИнвентарныйУчет;
	Элементы.ДекорацияМесяцев.Доступность 						= ДоступностьЭлементов И ЭтоПоступление И ВестиАналитическийИИнвентарныйУчет;
	Элементы.ПорядокПогашенияСтоимости.Доступность 				= ДоступностьЭлементов И ЭтоПоступление И ВестиАналитическийИИнвентарныйУчет;
	
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровАмортизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	Если ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	Объект.ПорядокПогашенияСтоимости,
																											Элементы.СпособНачисленияАмортизации,
																											ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));
		Элементы.НачислятьАмортизацию.Доступность = Объект.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
		
		ДоступностьЭлементов = (Объект.ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается"))
								И ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости);
		УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, ДоступностьЭлементов);
	Иначе
		Элементы.СпособНачисленияАмортизации.Доступность	= Ложь;
		Элементы.НачислятьАмортизацию.Доступность			= Ложь;
		УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, Ложь);		
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьПараметровАмортизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовГруппыСчетаЗатрат(Форма, ДоступностьЭлементов = Истина)

	Элементы = Форма.Элементы;
	
	Элементы.СчетУчетаЗатрат.Доступность	= ДоступностьЭлементов;	
	Элементы.КЭКЗатрат.Доступность 			= ДоступностьЭлементов;	
	Элементы.КПСЗатрат.Доступность 			= ДоступностьЭлементов;	

КонецПроцедуры // УстановитьДоступностьЭлементовГруппыСчетаЗатрат()
 
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(Форма)
	
    Если Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
		И ЗначениеЗаполнено(Форма.Объект.ОсновноеСредство) Тогда
		
		СтруктураРеквизитовОС = Новый Структура("СчетУчета, КодПоОКОФ, АмортизационнаяГруппа",
												Форма.ОС_СчетУчета,
												Форма.ОС_КодОКОФ,
												Форма.ОС_АмортизационнаяГруппа);
		
		Форма.ЗаполнитьДанныеОбОС = УправлениеОсновнымиСредствамиКлиентСервер.ПредставлениеСтрокиЗаполнитьДанныеОбОС(
			СтруктураРеквизитовОС, Форма.Объект.Дата);
		
	Иначе
		Форма.ЗаполнитьДанныеОбОС = "";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПредупреждениеВсеРеквизитыЗаполнены",
		"Видимость", Не ПустаяСтрока(Форма.ЗаполнитьДанныеОбОС));

КонецПроцедуры // УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС()

&НаКлиенте
Процедура РассчитатьОставшийсяСрокПолезногоИспользования()
	Если ЗначениеЗаполнено(Объект.ДатаВводаВЭксплуатацию) Тогда
		Объект.ОставшийсяСрокПолезногоИспользования = 0;
		ДатаОкончанияЭксплуатации = КонецМесяца(ДобавитьМесяц(Объект.ДатаВводаВЭксплуатацию, Объект.СрокПолезногоИспользования));
		ВрДата = НачалоМесяца(ДобавитьМесяц(Объект.Дата,1));
		Пока КонецМесяца(ВрДата) <= ДатаОкончанияЭксплуатации Цикл
			Объект.ОставшийсяСрокПолезногоИспользования = Объект.ОставшийсяСрокПолезногоИспользования + 1;
			ВрДата = ДобавитьМесяц(ВрДата, 1);
		КонецЦикла;
	Иначе	
		Объект.ОставшийсяСрокПолезногоИспользования = 0;
	КонецЕсли;
КонецПроцедуры // РассчитатьОставшийсяСрокПолезногоИспользования()
 
&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);
	УправлениеОсновнымиСредствамиКлиент.ОбработатьИзменениеСубконто(Элемент, Объект, СтрокаДанных, НомерСубконто)									

КонецПроцедуры // ОбработатьИзменениеСубконто()

&НаКлиенте
Процедура ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									Объект.СчетУчетаЗатрат,
									Объект.СубконтоЗатрат1,
									Объект.СубконтоЗатрат2,
									Объект.СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Организация,
													СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьНачалоВыбораСубконто()

&НаСервереБезКонтекста
Процедура ПрочитатьРеквизитыОС(ОсновноеСредство, ОС_КодОКОФ, ОС_СчетУчета, ОС_АмортизационнаяГруппа, НаДату)
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, НаДату);
	ОС_СчетУчета             = ДанныеОбъектаОС.СчетУчета;
	ОС_АмортизационнаяГруппа = ДанныеОбъектаОС.АмортизационнаяГруппа;
	ОС_КодОКОФ               = "";
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияРеквизитовОС(ОС, НаДату)
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОС, НаДату);
	ЗначенияРеквизитов = Новый Структура("СчетУчета,АмортизационнаяГруппа");
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ДанныеОбъектаОС);
			
	Возврат ДанныеОбъектаОС;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииОсновногоСредства(ПолучатьИнвентарныйНомер)
	
	ЭтоПоступление = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление");
	Если ПолучатьИнвентарныйНомер И ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		УстановитьИнвентарныйНомер(Объект.ОсновноеСредство, Объект.ИнвентарныйНомер, Объект.Дата, Параметры.Ключ);
	КонецЕсли;
	
    УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма);
	Если ЭтоПоступление Тогда
		УстановитьСрокПолезногоИспользования();
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
		УстановитьПорядокПогашенияСтоимости();
	КонецЕсли;
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			

КонецПроцедуры // ПриИзмененииОсновногоСредства()
 
&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере()

	СведенияОбОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ОсновноеСредство, "АмортизационнаяГруппа, ВидНФА");
	ОС_АмортизационнаяГруппа	= СведенияОбОС.АмортизационнаяГруппа;
	ОС_ВидНФА					= СведенияОбОС.ВидНФА;
	ОС_КодОКОФ					= "";
	ОС_СчетУчета				= УправлениеОсновнымиСредствами.СчетУчетаОС(Объект.ОсновноеСредство, Объект.Ссылка);
	
	Если Не ЗначениеЗаполнено(Объект.ИнвентарныйНомер) Тогда
		УстановитьИнвентарныйНомер(Объект.ОсновноеСредство, Объект.ИнвентарныйНомер, Объект.Дата, Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры // ОсновноеСредствоПриИзменении()

&НаСервереБезКонтекста
Процедура УстановитьИнвентарныйНомер(ОсновноеСредство, ИнвентарныйНомер, Дата, Ссылка = Неопределено)

	Если ЗначениеЗаполнено(Ссылка) и НЕ Ссылка.Пустая() Тогда
		ПериодЗапроса = Ссылка.МоментВремени();
	Иначе
		ПериодЗапроса = КонецДня(Дата);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	               |	ЕСТЬNULL(МестонахождениеОССрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)) КАК Состояние
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |				&Период,
	               |				ОсновноеСредство = &ОсновноеСредство
	               |					И Регистратор <> &Ссылка) КАК МестонахождениеОССрезПоследних
	               |		ПО ИнвентарныеНомераОС.Ссылка = МестонахождениеОССрезПоследних.ИнвНомер
	               |ГДЕ
	               |	ЕСТЬNULL(МестонахождениеОССрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	               |	И ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	               |	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	Запрос.УстановитьПараметр("ОсновноеСредство", 	ОсновноеСредство);
	Запрос.УстановитьПараметр("Период",				ПериодЗапроса);
	Запрос.УстановитьПараметр("Ссылка",				Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Иначе
		ТаблицаИнвНомеров = Результат.Выгрузить();
		ИнвентарныйНомер = ТаблицаИнвНомеров[0].ИнвентарныйНомер;
	КонецЕсли;

КонецПроцедуры // УстановитьИнвентарныйНомер()

&НаКлиенте
Процедура УстановитьСрокПолезногоИспользования()

	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиент.РасчетСрокаПолезногоИспользования(ОС_АмортизационнаяГруппа);
	Если Объект.СрокПолезногоИспользования = 0 ИЛИ СрокПолезногоИспользования <> 0 Тогда
		Объект.СрокПолезногоИспользования = СрокПолезногоИспользования;	
	КонецЕсли;
	
КонецПроцедуры // УстановитьСрокПолезногоИспользования()

&НаКлиенте
Процедура УстановитьПараметрыАмортизации()

	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление") Тогда
		Если ЗначениеЗаполнено(Объект.ОсновноеСредство) И Не ЗначениеЗаполнено(Объект.ПорядокПогашенияСтоимости) Тогда
			Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
				Объект.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
				Объект.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
			Иначе
				Объект.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");	
				Объект.СпособНачисленияАмортизации	= Неопределено;
			КонецЕсли;
			Если Объект.СрокПолезногоИспользования = 0 И ЗначениеЗаполнено(ОС_АмортизационнаяГруппа) Тогда
				УстановитьСрокПолезногоИспользования();
			КонецЕсли;
			ПараметрыВыбораЗначения = ПараметрыВыбораПараметровНачисленияАмортизации();
			УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
							Объект.СпособНачисленияАмортизации,
							Объект.НачислятьАмортизацию,
							ПараметрыВыбораЗначения);
			УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			
		КонецЕсли;
	Иначе
		Объект.СрокПолезногоИспользования 			= 0;
		Объект.ПорядокПогашенияСтоимости 			= Неопределено;
		Объект.СпособНачисленияАмортизации 			= Неопределено;
		Объект.НачислятьАмортизацию					= Ложь;
		Объект.ДатаВводаВЭксплуатацию				= Неопределено;
		Объект.ОставшийсяСрокПолезногоИспользования	= Неопределено;
		Объект.СчетУчетаЗатрат						= Неопределено;
		Объект.КЭКЗатрат							= Неопределено;
		Объект.СуммаАмортизации						= 0;
		ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, Новый Структура("СчетОбъекта, Субконто1, Субконто2, Субконто3,
																										|Подразделение,
																										|ОчищатьОтстуствующие,
																										|СубконтоОбъекта1, СубконтоОбъекта2, СубконтоОбъекта3",
																										"СчетУчетаЗатрат",
																										"СубконтоЗатрат1",
																										"СубконтоЗатрат2",
																										"СубконтоЗатрат3",
																										"ПодразделениеЗатрат",
																										,
																										"СубконтоЗатрат1",
																										"СубконтоЗатрат2",
																										"СубконтоЗатрат3"));
		УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);			
	КонецЕсли;

КонецПроцедуры // УстановитьПараметрыАмортизации()

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьЭлементовПоОперации(Форма, Объект)
	
	Элементы = Форма.Элементы;

	ЭтоВозврат = Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда")
				ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование");
	Элементы.Контрагент.АвтоОтметкаНезаполненного = ЭтоВозврат;				
	Если ЭтоВозврат Тогда
		Элементы.Контрагент.ОтметкаНезаполненного = Не ЗначениеЗаполнено(Объект.Контрагент);
	Иначе
		Элементы.Контрагент.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	Элементы.РассчитатьСтоимость.Доступность = ЭтоВозврат;
КонецПроцедуры // ДоступностьЭлементовПоОперации()

&НаКлиенте
Процедура РассчитатьСумму(СообщатьОбОшибках = Ложь)

	Если НЕ (Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование")) Тогда
		Возврат;
	КонецЕсли;

	Если Не ВсеРеквизитыЗаполнены(СообщатьОбОшибках) Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммуВозврата();
	
КонецПроцедуры // РассчитатьСумму()

&НаКлиенте
Функция ВсеРеквизитыЗаполнены(СообщатьОбОшибках)
	Результат = Истина;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		Если СообщатьОбОшибках Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено обязательное поле ""Организация""'"),,"Объект.Организация");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Результат = Ложь;
		Если СообщатьОбОшибках Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено обязательное поле ""Поставщик""'"),,"Объект.Контрагент");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Результат = Ложь;
		Если СообщатьОбОшибках Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено обязательное поле ""Основное средство""'"),,"Объект.ОсновноеСредство");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;	
КонецФункции

&НаСервере
Процедура РассчитатьСуммуВозврата()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В (&Счет),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &Контрагент
	               |				И Субконто2 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки";
	Если Объект.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда Тогда
		КодСчета = "25";
	Иначе
		КодСчета = "26";
	КонецЕсли;
	Запрос.УстановитьПараметр("Счет", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов(КодСчета));
	Запрос.УстановитьПараметр("Период", ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ОсновноеСредство", Объект.ОсновноеСредство);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Объект.ПервоначальнаяСтоимость = 0;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Если Выборка.КоличествоОстатокДт = 0 Тогда
			Объект.ПервоначальнаяСтоимость = Выборка.СуммаОстатокДт;
		Иначе
			Объект.ПервоначальнаяСтоимость = Выборка.СуммаОстатокДт / Выборка.КоличествоОстатокДт;
		КонецЕсли
	КонецЕсли;

КонецПроцедуры // РассчитатьСуммуВозврата()

