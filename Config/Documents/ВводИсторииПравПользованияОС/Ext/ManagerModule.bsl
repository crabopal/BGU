#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВалютаДокумента,АвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("СведенияОбОбъектахПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ОсновныеСведения.ДатаПринятияКУчету КАК Период,
	|	ОсновныеСведения.Ссылка.Договор КАК Договор,
	|	ОсновныеСведения.Ссылка.Организация КАК Организация,
	|	ОсновныеСведения.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСведения.УсловиеПользования КАК УсловиеПользования,
	|	ОсновныеСведения.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	ОсновныеСведения.ДатаНачалаАмортизации КАК ДатаНачалаСрокаПользования,
	|	ОсновныеСведения.ДатаОкончанияАмортизации КАК ДатаОкончанияСрокаПользования,
	|	ОсновныеСведения.АренднаяПлатаСумма КАК АренднаяПлатаСумма,
	|	ОсновныеСведения.АренднаяПлатаЗаПериод КАК АренднаяПлатаЗаПериод,
	|	ОсновныеСведения.АренднаяПлатаДеньНачисления КАК АренднаяПлатаДеньНачисления,
	|	ОсновныеСведения.ВидПервичногоДокумента КАК ДокументОснованиеВид,
	|	ОсновныеСведения.ДатаПервичногоДокумента КАК ДокументОснованиеДата,
	|	ОсновныеСведения.НомерПервичногоДокумента КАК ДокументОснованиеНомер,
	|	NULL КАК ТипИзмененийУсловийПользования,
	|	NULL КАК НачалоПериодаПересчета,
	|	NULL КАК КонецПериодаПересчета,
	|	ОсновныеСведения.ДатаПриемкиОбъектаВПользование КАК ДатаПриемкиОбъектаВПользование
	|ИЗ
	|	Документ.ВводИсторииПравПользованияОС.ОсновныеСредства КАК ОсновныеСведения
	|ГДЕ
	|	ОсновныеСведения.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СведенияОбИзменениях.ДатаИзменения,
	|	СведенияОбИзменениях.Ссылка.Договор,
	|	СведенияОбИзменениях.Ссылка.Организация,
	|	СведенияОбИзменениях.ОсновноеСредство,
	|	СведенияОбИзменениях.УсловиеПользования,
	|	NULL,
	|	СведенияОбИзменениях.ДатаНачалаАмортизации,
	|	СведенияОбИзменениях.ДатаОкончанияАмортизации,
	|	СведенияОбИзменениях.АренднаяПлатаСумма,
	|	СведенияОбИзменениях.АренднаяПлатаЗаПериод,
	|	NULL,
	|	СведенияОбИзменениях.ВидПервичногоДокумента,
	|	СведенияОбИзменениях.ДатаПервичногоДокумента,
	|	СведенияОбИзменениях.НомерПервичногоДокумента,
	|	СведенияОбИзменениях.ТипИзмененийУсловийПользования,
	|	СведенияОбИзменениях.НачалоПериодаПересчета,
	|	СведенияОбИзменениях.КонецПериодаПересчета,
	|	NULL
	|ИЗ
	|	Документ.ВводИсторииПравПользованияОС.СведенияОбИзменениях КАК СведенияОбИзменениях
	|ГДЕ
	|	СведенияОбИзменениях.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	НомераТаблиц.Вставить("ГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВводИсторииПравПользованияОС.Ссылка КАК Ссылка,
	|	ВводИсторииПравПользованияОС.ДатаПринятияКУчету КАК Период,
	|	ВводИсторииПравПользованияОС.Ссылка.Организация КАК Организация,
	|	ВводИсторииПравПользованияОС.Ссылка.Договор КАК Договор,
	|	ГрафикАмортизации.ОсновноеСредство КАК ОсновноеСредство,
	|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК ДатаНачисленияАмортизации,
	|	ГрафикАмортизации.ОплатитьДо КАК ОплатитьДо,
	|	ИСТИНА КАК ПоПервоначальнойОценке,
	|	ГрафикАмортизации.Амортизация КАК Амортизация,
	|	ГрафикАмортизации.АренднаяПлата КАК АренднаяПлата
	|ИЗ
	|	Документ.ВводИсторииПравПользованияОС.ОсновныеСредства КАК ВводИсторииПравПользованияОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ПервоначальныйГрафикАмортизации КАК ГрафикАмортизации
	|		ПО ВводИсторииПравПользованияОС.Ссылка = ГрафикАмортизации.Ссылка
	|			И ВводИсторииПравПользованияОС.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
	|ГДЕ
	|	ВводИсторииПравПользованияОС.Ссылка = &Ссылка
	|	И (ГрафикАмортизации.Амортизация <> 0
	|			ИЛИ ГрафикАмортизации.АренднаяПлата <> 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СведенияОбИзменениях.Ссылка,
	|	СведенияОбИзменениях.ДатаИзменения,
	|	СведенияОбИзменениях.Ссылка.Организация,
	|	СведенияОбИзменениях.Ссылка.Договор,
	|	ГрафикАмортизации.ОсновноеСредство,
	|	ГрафикАмортизации.ДатаНачисленияАмортизации,
	|	ГрафикАмортизации.ОплатитьДо,
	|	ЛОЖЬ,
	|	ГрафикАмортизации.Амортизация,
	|	ГрафикАмортизации.АренднаяПлата
	|ИЗ
	|	Документ.ВводИсторииПравПользованияОС.СведенияОбИзменениях КАК СведенияОбИзменениях
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
	|		ПО СведенияОбИзменениях.Ссылка = ГрафикАмортизации.Ссылка
	|			И СведенияОбИзменениях.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
	|			И СведенияОбИзменениях.ДатаИзменения = ГрафикАмортизации.ДатаИзменения
	|ГДЕ
	|	СведенияОбИзменениях.Ссылка = &Ссылка
	|	И (ГрафикАмортизации.Амортизация <> 0
	|			ИЛИ ГрафикАмортизации.АренднаяПлата <> 0)";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И ЗначенияРеквизитов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
		
		Запрос.УстановитьПараметр("Валюта", ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВалютаДокумента), ЗначенияРеквизитов.ВалютаДокумента,
			Константы.ВалютаРегламентированногоУчета.Получить()));
		
		НомераТаблиц.Вставить("ИсполнениеОбязательствПоставщиками", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК Период,
		|	ПервоначальныеСведения.Ссылка.Организация КАК Организация,
		|	ПервоначальныеСведения.Ссылка.Контрагент КАК Контрагент,
		|	ПервоначальныеСведения.Ссылка.Договор КАК Договор,
		|	ПервоначальныеСведения.СчетРасчетов КАК СчетРасчетов,
		|	&Валюта КАК Валюта,
		|	ПервоначальныеСведения.Ссылка.ИФО КАК ИФО,
		|	ПервоначальныеСведения.Ссылка.КФО КАК КФО,
		|	ПервоначальныеСведения.КПСРасчетов КАК КПС,
		|	ПервоначальныеСведения.КЭКРасходов КАК КЭК,
		|	ПервоначальныеСведения.ОсновноеСредство КАК ОсновноеСредство,
		|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК ИсполнитьДо,
		|	ГрафикАмортизации.АренднаяПлата КАК Сумма
		|ИЗ
		|	Документ.ВводИсторииПравПользованияОС.ОсновныеСредства КАК ПервоначальныеСведения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ПервоначальныйГрафикАмортизации КАК ГрафикАмортизации
		|		ПО ПервоначальныеСведения.Ссылка = ГрафикАмортизации.Ссылка
		|			И ПервоначальныеСведения.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
		|ГДЕ
		|	ПервоначальныеСведения.Ссылка = &Ссылка
		|	И ПервоначальныеСведения.Ссылка.Договор.ВестиПланГрафикИсполнения
		|	И ГрафикАмортизации.АренднаяПлата <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГрафикАмортизации.ДатаНачисленияАмортизации,
		|	СведенияОбИзменениях.Ссылка.Организация,
		|	СведенияОбИзменениях.Ссылка.Контрагент,
		|	СведенияОбИзменениях.Ссылка.Договор,
		|	СведенияОбИзменениях.СчетРасчетов,
		|	&Валюта,
		|	СведенияОбИзменениях.Ссылка.ИФО,
		|	СведенияОбИзменениях.Ссылка.КФО,
		|	СведенияОбИзменениях.КПСРасчетов,
		|	СведенияОбИзменениях.КЭКРасходов,
		|	СведенияОбИзменениях.ОсновноеСредство,
		|	ГрафикАмортизации.ДатаНачисленияАмортизации,
		|	ГрафикАмортизации.АренднаяПлата
		|ИЗ
		|	Документ.ВводИсторииПравПользованияОС.СведенияОбИзменениях КАК СведенияОбИзменениях
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
		|		ПО СведенияОбИзменениях.Ссылка = ГрафикАмортизации.Ссылка
		|			И СведенияОбИзменениях.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
		|			И СведенияОбИзменениях.ДатаИзменения = ГрафикАмортизации.ДатаИзменения
		|ГДЕ
		|	СведенияОбИзменениях.Ссылка = &Ссылка
		|	И СведенияОбИзменениях.Ссылка.Договор.ВестиПланГрафикИсполнения
		|	И ГрафикАмортизации.АренднаяПлата <> 0";
		
		НомераТаблиц.Вставить("ОплатаПоставщикамКредиторам", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ГрафикАмортизации.ОплатитьДо КАК Период,
		|	ПервоначальныеСведения.Ссылка.Организация КАК Организация,
		|	ПервоначальныеСведения.Ссылка.Контрагент КАК Контрагент,
		|	ПервоначальныеСведения.Ссылка.Договор КАК Договор,
		|	ПервоначальныеСведения.СчетРасчетов КАК СчетРасчетов,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг) КАК ВидРасчетов,
		|	&Валюта КАК Валюта,
		|	ПервоначальныеСведения.Ссылка.ИФО КАК ИФО,
		|	ПервоначальныеСведения.Ссылка.КФО КАК КФО,
		|	ПервоначальныеСведения.КПСРасчетов КАК КПС,
		|	ПервоначальныеСведения.КЭКРасходов КАК КЭК,
		|	ПервоначальныеСведения.ОсновноеСредство КАК ОсновноеСредство,
		|	ГрафикАмортизации.ОплатитьДо КАК ОплатитьДо,
		|	ГрафикАмортизации.АренднаяПлата КАК Сумма
		|ИЗ
		|	Документ.ВводИсторииПравПользованияОС.ОсновныеСредства КАК ПервоначальныеСведения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ПервоначальныйГрафикАмортизации КАК ГрафикАмортизации
		|		ПО ПервоначальныеСведения.Ссылка = ГрафикАмортизации.Ссылка
		|			И ПервоначальныеСведения.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
		|ГДЕ
		|	ПервоначальныеСведения.Ссылка = &Ссылка
		|	И ПервоначальныеСведения.Ссылка.Договор.ВестиГрафикПлатежей
		|	И ГрафикАмортизации.АренднаяПлата <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГрафикАмортизации.ОплатитьДо,
		|	СведенияОбИзменениях.Ссылка.Организация,
		|	СведенияОбИзменениях.Ссылка.Контрагент,
		|	СведенияОбИзменениях.Ссылка.Договор,
		|	СведенияОбИзменениях.СчетРасчетов,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг),
		|	&Валюта,
		|	СведенияОбИзменениях.Ссылка.ИФО,
		|	СведенияОбИзменениях.Ссылка.КФО,
		|	СведенияОбИзменениях.КПСРасчетов,
		|	СведенияОбИзменениях.КЭКРасходов,
		|	СведенияОбИзменениях.ОсновноеСредство,
		|	ГрафикАмортизации.ОплатитьДо,
		|	ГрафикАмортизации.АренднаяПлата
		|ИЗ
		|	Документ.ВводИсторииПравПользованияОС.СведенияОбИзменениях КАК СведенияОбИзменениях
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводИсторииПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
		|		ПО СведенияОбИзменениях.Ссылка = ГрафикАмортизации.Ссылка
		|			И СведенияОбИзменениях.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
		|			И СведенияОбИзменениях.ДатаИзменения = ГрафикАмортизации.ДатаИзменения
		|ГДЕ
		|	СведенияОбИзменениях.Ссылка = &Ссылка
		|	И СведенияОбИзменениях.Ссылка.Договор.ВестиГрафикПлатежей
		|	И ГрафикАмортизации.АренднаяПлата <> 0";
		
	КонецЕсли;
	
	НомераТаблиц.Вставить("ВТ_СведенияОбИмуществе", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_ПриемкаОбъектовВПользование", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СоставОбъектовПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СведенияОбИмуществе.Ссылка.Дата КАК Дата,
	|	СведенияОбИмуществе.Ссылка.Договор КАК Договор,
