#Область ЗаполнениеДокумента

Функция ЗаполнитьОсновныеСведения(Объект) Экспорт
	
	Отказ = Ложь;
	
	Объект.ОсновныеСредства.Очистить();
	
	// 1. По документам ПринятиеКУчетуПравПользованияОС.
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Договор",     Объект.Договор);
	Запрос.УстановитьПараметр("Счета11140",  БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("Счета30200",  БухгалтерскийУчет.СписокСчетов("302.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты11140.Организация КАК Организация,
	|	ВЫРАЗИТЬ(Обороты11140.Регистратор КАК Документ.ПринятиеКУчетуПравПользованияОС) КАК Регистратор,
