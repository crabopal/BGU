&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КодыИзмененийУсловийПользованияОбъектамиОС", Новый Соответствие);
	Выборка = Справочники.ТипыИзмененийУсловийПользованияОбъектамиОС.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтотОбъект.КэшПараметров.Локальные.КодыИзмененийУсловийПользованияОбъектамиОС.Вставить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	СведенияОбИзмененияхЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВедутсяГрафикиИсполненияПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедутсяГрафикиИсполненияПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедутсяГрафикиИсполненияПоДоговору;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "АвтоматическиОтразитьВГрафикахИсполненияДоговоров",
		"Видимость", ВедутсяГрафикиИсполненияПоДоговору);
	
	РеквизитыКонтрольИсполненияДоговоров = Новый Массив;
	РеквизитыКонтрольИсполненияДоговоров.Добавить("КФО");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("ОсновныеСредстваСчетРасчетов");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("ОсновныеСредстваКПСРасчетов");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("ОсновныеСредстваКЭКРасходов");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("СведенияОбИзмененияхСчетРасчетов");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("СведенияОбИзмененияхКПСРасчетов");
	РеквизитыКонтрольИсполненияДоговоров.Добавить("СведенияОбИзмененияхКЭКРасходов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыКонтрольИсполненияДоговоров, "Видимость",
			ВедутсяГрафикиИсполненияПоДоговору И Объект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров);
	
	ЭлементыОсновноеСредство = Новый Массив;
	ЭлементыОсновноеСредство.Добавить("ОсновныеСредстваОсновноеСредство");
	ЭлементыОсновноеСредство.Добавить("СведенияОбИзмененияхОсновноеСредство");
	ЭлементыОсновноеСредство.Добавить("СведенияОбИмуществеОсновноеСредство");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОсновноеСредство, "Видимость", Не ЗначениеЗаполнено(Форма.ОсновноеСредство));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Доступность и оформление сумм в зависимости от вида операции.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваВсегоСправедливая");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваВсего");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Доступность счета и КПС расчетов в зависимости от вида операции.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСчетРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваКПСРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Первоначальный график начисления амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// График начисления амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СведенияОбИзмененияхГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СведенияОбИзменениях.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СведенияОбИзмененияхГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СведенияОбИзменениях.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПараметрыДоговораВКэшеФормы()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедутсяГрафикиИсполненияПоДоговору", Ложь);
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		ЭтотОбъект.КэшПараметров.Локальные.ВедутсяГрафикиИсполненияПоДоговору = 
			?(РеквизитыДоговора = Неопределено, Ложь, РеквизитыДоговора.ВестиГрафикПлатежей ИЛИ РеквизитыДоговора.ВестиПланГрафикИсполнения);
	КонецЕсли;
	
КонецПроцедуры

