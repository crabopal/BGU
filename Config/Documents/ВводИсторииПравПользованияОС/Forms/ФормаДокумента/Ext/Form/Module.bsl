Процедура УстановитьДоступностьДоговора(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Контрагент));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОбъектаОС(ОсновноеСредство, Договор, Организация, Период)
	
	ДанныеОбъектаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, "ВидНФА");
	
	ДанныеДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
	ДанныеОбъектаОС.Вставить("ВидОбязательства", ДанныеДоговора.ВидОбязательства);
	ДанныеОбъектаОС.Вставить("ДатаДоговора", ДанныеДоговора.ДатаДоговора);
	ДанныеОбъектаОС.Вставить("НомерДоговора", ДанныеДоговора.НомерДоговора);
	
	Отбор = Новый Структура("ОсновноеСредство, Договор, Организация", ОсновноеСредство, Договор, Организация);
	ПараметрыАмортизации = РегистрыСведений.ПараметрыАмортизацииПравПользованияОС.ПолучитьПоследнее(Период, Отбор);
	ДанныеОбъектаОС.Вставить("ВидОперации", ПараметрыАмортизации.ВидОперации);
	ДанныеОбъектаОС.Вставить("СпособПризнанияРасходов", ПараметрыАмортизации.СпособПризнанияРасходов);
	ДанныеОбъектаОС.Вставить("ДатаНачалаАмортизации", ПараметрыАмортизации.ДатаНачалаАмортизации);
	ДанныеОбъектаОС.Вставить("ДатаОкончанияАмортизации", ПараметрыАмортизации.ДатаОкончанияАмортизации);
	
	Возврат ДанныеОбъектаОС;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокВыбораУсловийПользования(ВидОперации)
	
	СписокВыбора = Новый СписокЗначений;
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование") Тогда
		СписокВыбора.Добавить(Справочники.УсловияПользованияОбъектамиОС.НайтиПоКоду("21"));
		СписокВыбора.Добавить(Справочники.УсловияПользованияОбъектамиОС.НайтиПоКоду("22"));
	Иначе
		СписокВыбора.Добавить(Справочники.УсловияПользованияОбъектамиОС.НайтиПоКоду("11"));
		СписокВыбора.Добавить(Справочники.УсловияПользованияОбъектамиОС.НайтиПоКоду("12"));
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОсновныеСведенияНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Отказ = Документы.ВводИсторииПравПользованияОС.ЗаполнитьОсновныеСведения(Объект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПервоначальногоГрафикаНачисленияАмортизации(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Договор");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(Объект.ВалютаДокумента), Объект.ВалютаДокумента, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
	
	ПараметрыФормы.Вставить("ВидОперации",      ДанныеСтроки.ВидОперации);
	ПараметрыФормы.Вставить("АмортизацияСумма", ДанныеСтроки.ВсегоСправедливая);
	ПараметрыФормы.Вставить("СуммаПоДоговору",  ДанныеСтроки.Всего);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОсновноеСредство", ДанныеСтроки.ОсновноеСредство);
	НайденныеСтроки = Объект.ПервоначальныйГрафикАмортизации.НайтиСтроки(Отбор);
	
	ПараметрыФормы.Вставить("КоличествоПериодов",          НайденныеСтроки.Количество());
	ПараметрыФормы.Вставить("АренднаяПлатаСумма",          ДанныеСтроки.АренднаяПлатаСумма);
	ПараметрыФормы.Вставить("АренднаяПлатаЗаПериод",       ДанныеСтроки.АренднаяПлатаЗаПериод);
	ПараметрыФормы.Вставить("АренднаяПлатаДеньНачисления", ДанныеСтроки.АренднаяПлатаДеньНачисления);
	ПараметрыФормы.Вставить("АренднаяПлатаДеньОплаты",     ДанныеСтроки.АренднаяПлатаДеньОплаты);
	
	ПараметрыФормы.Вставить("СпособПризнанияРасходов",  ДанныеСтроки.СпособПризнанияРасходов);
	ПараметрыФормы.Вставить("ДатаНачалаАмортизации",    ДанныеСтроки.ДатаНачалаАмортизации);
	ПараметрыФормы.Вставить("ДатаОкончанияАмортизации", ДанныеСтроки.ДатаОкончанияАмортизации);
	
	ПараметрыФормы.Вставить("ГрафикАмортизации", ПоместитьПервоначальныйГрафикАмортизацииВХранилище(ДанныеСтроки.ОсновноеСредство));
	
	ОткрытьФорму("Документ.ПринятиеКУчетуПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция ПоместитьПервоначальныйГрафикАмортизацииВХранилище(ОсновноеСредство)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОсновноеСредство", ОсновноеСредство);
	
	ГрафикАмортизации = Объект.ПервоначальныйГрафикАмортизации.Выгрузить(Отбор);
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПервоначальногоГрафикаНачисленияАмортизацииНаСервере(ТекущаяСтрока, ПараметрыГрафикаАмортизации)
	
	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"СпособПризнанияРасходов,ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
		|АренднаяПлатаСумма,АренднаяПлатаЗаПериод,АренднаяПлатаДеньНачисления,АренднаяПлатаДеньОплаты");
	
	// Удаляем строки особого графика из табличной части.
	ОтборПоОбъектуОС = Новый Структура("ОсновноеСредство", ДанныеСтроки.ОсновноеСредство);
	НайденныеСтроки = Объект.ПервоначальныйГрафикАмортизации.НайтиСтроки(ОтборПоОбъектуОС);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ПервоначальныйГрафикАмортизации.Удалить(Объект.ПервоначальныйГрафикАмортизации.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки графика амортизации.
	ГрафикАмортизацииПоОбъекту = ПолучитьИзВременногоХранилища(ПараметрыГрафикаАмортизации.ГрафикАмортизации);
	Если ГрафикАмортизацииПоОбъекту.Количество() > 0 Тогда
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			НоваяСтрока = Объект.ПервоначальныйГрафикАмортизации.Добавить();
			НоваяСтрока.ОсновноеСредство = ДанныеСтроки.ОсновноеСредство;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
				"ДатаНачисленияАмортизации,Амортизация,АренднаяПлата,ОплатитьДо");
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСтроки.ВсегоСправедливая = ПараметрыГрафикаАмортизации.АмортизацияСумма;
	ДанныеСтроки.Всего = ПараметрыГрафикаАмортизации.СуммаПоДоговору;
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГрафикаНачисленияАмортизации(ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.СведенияОбИзменениях.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Договор, ТипИзмененийУсловийПользования,
		|АренднаяПлатаСумма, АренднаяПлатаСуммаДоИзменения,
		|АренднаяПлатаЗаПериод, АренднаяПлатаЗаПериодДоИзменения,
		|НачалоПериодаПересчета, КонецПериодаПересчета,
		|УсловиеПользованияДоИзменения, УсловиеПользования, 
		|ДатаНачалаАмортизацииДоИзменения, ДатаНачалаАмортизации, ДатаОкончанияАмортизацииДоИзменения, ДатаОкончанияАмортизации");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект, "Организация, Договор");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Дата = ДанныеСтроки.ДатаИзменения;
	ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(Объект.ВалютаДокумента), Объект.ВалютаДокумента, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
	
	ПараметрыФормы.Вставить("ВидОперации", ДанныеСтроки.ВидОперацииПринятияКУчетуПравПользованияОС);
	ПараметрыФормы.Вставить("ВидОперацииДокумента", ДанныеСтроки.ВидОперации);
	
	ПараметрыФормы.Вставить("ГрафикАмортизации", ПоместитьГрафикАмортизацииВХранилище(ДанныеСтроки.ОсновноеСредство, ДанныеСтроки.ДатаИзменения));
	
	ОткрытьФорму("Документ.ПрекращениеПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьГрафикАмортизацииВХранилище(ОсновноеСредство, ДатаИзменения)
	
	ОтборПоОбъекту = Новый Структура("ДатаИзменения, ОсновноеСредство", ДатаИзменения, ОсновноеСредство);
	ГрафикАмортизации = Объект.ГрафикАмортизации.Выгрузить(ОтборПоОбъекту);
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораГрафикаНачисленияАмортизацииНаСервере(ТекущаяСтрока, ПараметрыГрафикаАмортизации)
	
	ДанныеСтроки = Объект.СведенияОбИзменениях.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
		|АренднаяПлатаСумма,АренднаяПлатаЗаПериод,НачалоПериодаПересчета,КонецПериодаПересчета");
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"ТипИзмененийУсловийПользования,УсловиеПользования");
	
	// Удаляем строки особого графика из табличной части.
	ОтборПоОбъекту = Новый Структура("ДатаИзменения, ОсновноеСредство", ДанныеСтроки.ДатаИзменения, ДанныеСтроки.ОсновноеСредство);
	НайденныеСтроки = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъекту);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки графика амортизации.
	ВсегоСправедливаяИзменение = 0;
	ВсегоИзменение = 0;
	ГрафикАмортизацииПоОбъекту = ПолучитьИзВременногоХранилища(ПараметрыГрафикаАмортизации.ГрафикАмортизации);
	Если ГрафикАмортизацииПоОбъекту.Количество() > 0 Тогда
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			НоваяСтрока = Объект.ГрафикАмортизации.Добавить();
			НоваяСтрока.ДатаИзменения = ДанныеСтроки.ДатаИзменения;
			НоваяСтрока.ОсновноеСредство = ДанныеСтроки.ОсновноеСредство;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
				"АмортизацияДоИзменения,Амортизация,АмортизацияПослеИзменения,
				|АренднаяПлатаДоИзменения,АренднаяПлата,АренднаяПлатаПослеИзменения,
				|ДатаНачисленияАмортизации,ОплатитьДо");
			ВсегоСправедливаяИзменение = ВсегоСправедливаяИзменение + НоваяСтрока.Амортизация;
			ВсегоИзменение = ВсегоИзменение + НоваяСтрока.АренднаяПлата;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСтроки.ВсегоСправедливая = ВсегоСправедливаяИзменение;
	ДанныеСтроки.Всего = ВсегоИзменение;
	
	СведенияОбИзмененияхЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораОсновноеСредство(Договор, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОбОбъектахПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	РегистрСведений.СведенияОбОбъектахПравПользованияОС КАК СведенияОбОбъектахПравПользованияОС
	|ГДЕ
	|	СведенияОбОбъектахПравПользованияОС.Договор = &Договор
	|	И СведенияОбОбъектахПравПользованияОС.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	СведенияОбОбъектахПравПользованияОС.ОсновноеСредство.Наименование";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СписокВыбора = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.ОсновноеСредство);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура СведенияОбИмуществеУстановитьОтборВТаблице()
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ОсновноеСредство", ОсновноеСредство);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.ОсновныеСредства.ОтборСтрок;
	Если ТекущийОтборСтрок <> НовыйОтборСтрок Тогда
		Элементы.ОсновныеСредства.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.СведенияОбИзменениях.ОтборСтрок;
	Если ТекущийОтборСтрок <> НовыйОтборСтрок Тогда
		Элементы.СведенияОбИзменениях.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.СведенияОбИмуществе.ОтборСтрок;
	Если ТекущийОтборСтрок <> НовыйОтборСтрок Тогда
		Элементы.СведенияОбИмуществе.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

