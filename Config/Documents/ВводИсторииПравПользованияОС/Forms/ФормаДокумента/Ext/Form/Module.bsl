
&НаКлиенте
Перем ЭтоНоваяСтрока;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтаФорма, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	СведенияОбИзмененияхЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ПринятиеКУчетуПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации" Тогда
		
		ОбработкаВыбораПервоначальногоГрафикаНачисленияАмортизацииНаСервере(Элементы.ОсновныеСредства.ТекущаяСтрока, ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.ПрекращениеПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации" Тогда
		
		ОбработкаВыбораГрафикаНачисленияАмортизацииНаСервере(Элементы.СведенияОбИзменениях.ТекущаяСтрока, ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	Объект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЭтотОбъект.КэшПараметров.Локальные.ВедутсяГрафикиИсполненияПоДоговору;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическиОтразитьВГрафикахИсполненияДоговоровПриИзменении(Элемент)
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	ПодключитьОбработчикОжидания("СведенияОбИмуществеУстановитьОтборВТаблице", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокОбъектовОС = СписокВыбораОсновноеСредство(Объект.Договор, Объект.Организация);
	Элемент.СписокВыбора.Очистить();
	Для Каждого ОбъектОС Из СписокОбъектовОС Цикл
		Элемент.СписокВыбора.Добавить(ОбъектОС.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОсновныеСредстваГрафикАмортизации" Тогда
		ОткрытьФормуПервоначальногоГрафикаНачисленияАмортизации(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ОсновныеСредства.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ОсновныеСредстваГрафикАмортизации"
			И НЕ ТекущиеДанные.ГрафикАмортизацииЗаполнен Тогда
			ВыбраннаяСтрока = Элементы.ОсновныеСредства.ТекущаяСтрока;
			ОткрытьФормуПервоначальногоГрафикаНачисленияАмортизации(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если НЕ Отказ Тогда
		// Удаляем строки графика амортизации из табличной части.
		ОтборПоОбъекту = Новый Структура("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
		ГрафикАмортизацииПоОбъекту = Объект.ПервоначальныйГрафикАмортизации.НайтиСтроки(ОтборПоОбъекту);
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			Объект.ПервоначальныйГрафикАмортизации.Удалить(Объект.ПервоначальныйГрафикАмортизации.Индекс(СтрокаГрафика));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоНоваяСтрока = НоваяСтрока;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ТекущиеДанные.ОсновноеСредство = ОсновноеСредство; // Из шапки.
		
		ТекущиеДанные.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам");
		
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ДанныеОбъекта = ДанныеОбъектаОС(ТекущиеДанные.ОсновноеСредство, Объект.Договор, Объект.Организация, Объект.Дата);
	Если ЗначениеЗаполнено(ДанныеОбъекта.ВидОбязательства) Тогда
		ТекущиеДанные.ВидПервичногоДокумента = ДанныеОбъекта.ВидОбязательства;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.ДатаДоговора) Тогда
		ТекущиеДанные.ДатаПервичногоДокумента = ДанныеОбъекта.ДатаДоговора;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.НомерДоговора) Тогда
		ТекущиеДанные.НомерПервичногоДокумента = ДанныеОбъекта.НомерДоговора;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.ВидОперации) Тогда
		ТекущиеДанные.ВидОперации = ДанныеОбъекта.ВидОперации;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.СпособПризнанияРасходов) Тогда
		ТекущиеДанные.СпособПризнанияРасходов = ДанныеОбъекта.СпособПризнанияРасходов;
		ТекущиеДанные.ДатаНачалаАмортизации = ДанныеОбъекта.ДатаНачалаАмортизации;
		ТекущиеДанные.ДатаОкончанияАмортизации = ДанныеОбъекта.ДатаОкончанияАмортизации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваУсловиеПользованияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	СписокУсловийПользования = СписокВыбораУсловийПользования(ТекущиеДанные.ВидОперации);
	Элемент.СписокВыбора.Очистить();
	Для Каждого УсловиеПользования Из СписокУсловийПользования Цикл
		Элемент.СписокВыбора.Добавить(УсловиеПользования.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваДатаПринятияКУчетуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.ДатаПриемкиОбъектаВПользование = ТекущиеДанные.ДатаПринятияКУчету;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВсегоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.ВсегоСправедливая = ТекущиеДанные.Всего;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваГрафикАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуПервоначальногоГрафикаНачисленияАмортизации(Элементы.ОсновныеСредства.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонки(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСумма             = НСтр("ru = 'Сумма по договору:'");
	СтрокаТаблицы.ЗаголовокСуммаСправедливая = НСтр("ru = 'Справедливая стоимость:'");
	
	СтрокаТаблицы.ГрафикАмортизации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, с %2 по %3'"),
		СтрокаТаблицы.СпособПризнанияРасходов,
		Формат(СтрокаТаблицы.ДатаНачалаАмортизации, "ДЛФ=Д"),
		Формат(СтрокаТаблицы.ДатаОкончанияАмортизации, "ДЛФ=Д"));
	СтрокаТаблицы.ГрафикАмортизацииЗаполнен = ЗначениеЗаполнено(СтрокаТаблицы.АренднаяПлатаСумма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СведенияОбИзменениях

&НаКлиенте
Процедура СведенияОбИзмененияхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СведенияОбИзмененияхГрафикАмортизации" Тогда
		ОткрытьФормуГрафикаНачисленияАмортизации(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элементы.СведенияОбИзменениях.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.СведенияОбИзменениях.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "СведенияОбИзмененияхГрафикАмортизации"
			И НЕ ТекущиеДанные.ГрафикАмортизацииЗаполнен Тогда
			ВыбраннаяСтрока = Элементы.СведенияОбИзменениях.ТекущаяСтрока;
			ОткрытьФормуГрафикаНачисленияАмортизации(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.СведенияОбИзменениях.ТекущиеДанные;
	
	Если НЕ Отказ Тогда
		// Удаляем строки графика амортизации из табличной части.
		ОтборПоОбъекту = Новый Структура("ДатаИзменения, ОсновноеСредство", ТекущиеДанные.ДатаИзменения, ТекущиеДанные.ОсновноеСредство);
		ГрафикАмортизацииПоОбъекту = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъекту);
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоНоваяСтрока = НоваяСтрока;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.СведенияОбИзменениях.ТекущиеДанные;
		ТекущиеДанные.ОсновноеСредство = ОсновноеСредство; // Из шапки.
		
		СведенияОбИзмененияхЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СведенияОбИзменениях.ТекущиеДанные;
	ДанныеОбъекта = ДанныеОбъектаОС(ТекущиеДанные.ОсновноеСредство, Объект.Договор, Объект.Организация, Объект.Дата);
	Если ЗначениеЗаполнено(ДанныеОбъекта.ВидОбязательства) Тогда
		ТекущиеДанные.ВидПервичногоДокумента = ДанныеОбъекта.ВидОбязательства;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.ДатаДоговора) Тогда
		ТекущиеДанные.ДатаПервичногоДокумента = ДанныеОбъекта.ДатаДоговора;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.НомерДоговора) Тогда
		ТекущиеДанные.НомерПервичногоДокумента = ДанныеОбъекта.НомерДоговора;
	КонецЕсли;
	
	// Удаляем строки графика амортизации из табличной части.
	ОтборПоОбъектуИПериоду = Новый Структура("ДатаИзменения, ОсновноеСредство", ТекущиеДанные.ДатаИзменения, ТекущиеДанные.ОсновноеСредство);
	ГрафикАмортизацииПоОбъекту = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъектуИПериоду);
	Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
		Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	СтрокаСведенийЗаполнена = Ложь;
	
	ОтборПоОбъекту = Новый Структура("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
	СтрокиСведенияОбИзменениях = Объект.СведенияОбИзменениях.НайтиСтроки(ОтборПоОбъекту);
	Если СтрокиСведенияОбИзменениях.Количество() > 0 Тогда // Из строки табличной части "Сведения об изменениях".
		
		ПредСтрокаСведений = Неопределено;
		Для Каждого СтрокаСведений Из СтрокиСведенияОбИзменениях Цикл
			Если (СтрокаСведений.ДатаИзменения < ТекущиеДанные.ДатаИзменения)
				И (ПредСтрокаСведений = Неопределено ИЛИ СтрокаСведений.ДатаИзменения >= ПредСтрокаСведений.ДатаИзменения) Тогда
				ПредСтрокаСведений = СтрокаСведений;
			КонецЕсли;
		КонецЦикла;
		
		Если ПредСтрокаСведений <> Неопределено Тогда
			
			ТекущиеДанные.ДатаНачалаАмортизацииДоИзменения = ПредСтрокаСведений.ДатаНачалаАмортизации;
			ТекущиеДанные.ДатаОкончанияАмортизацииДоИзменения = ПредСтрокаСведений.ДатаОкончанияАмортизации;
			ТекущиеДанные.АренднаяПлатаСуммаДоИзменения = ПредСтрокаСведений.АренднаяПлатаСумма;
			ТекущиеДанные.АренднаяПлатаЗаПериодДоИзменения = ПредСтрокаСведений.АренднаяПлатаЗаПериод;
			ТекущиеДанные.УсловиеПользованияДоИзменения = ПредСтрокаСведений.УсловиеПользования;
			
			ТекущиеДанные.ДатаНачалаАмортизации = ТекущиеДанные.ДатаНачалаАмортизацииДоИзменения;
			ТекущиеДанные.ДатаОкончанияАмортизации = ТекущиеДанные.ДатаОкончанияАмортизацииДоИзменения;
			ТекущиеДанные.АренднаяПлатаСумма = ТекущиеДанные.АренднаяПлатаСуммаДоИзменения;
			ТекущиеДанные.АренднаяПлатаЗаПериод = ТекущиеДанные.АренднаяПлатаЗаПериодДоИзменения;
			ТекущиеДанные.УсловиеПользования = ТекущиеДанные.УсловиеПользованияДоИзменения;
			
			// Копируем график амортизации из строки с предыдущей датой изменения, из табличной части ГрафикАмортизации.
			ОтборПоОбъектуИПериоду = Новый Структура("ДатаИзменения, ОсновноеСредство", ПредСтрокаСведений.ДатаИзменения, ПредСтрокаСведений.ОсновноеСредство);
			СтрокиГрафикАмортизации = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъектуИПериоду);
			Если СтрокиГрафикАмортизации.Количество() > 0 Тогда
				
				Для Каждого СтрокаГрафика Из СтрокиГрафикАмортизации Цикл
					НоваяСтрока = Объект.ГрафикАмортизации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика, "ОсновноеСредство, ДатаНачисленияАмортизации, ОплатитьДо");
					НоваяСтрока.ДатаИзменения = ТекущиеДанные.ДатаИзменения;
					НоваяСтрока.АмортизацияДоИзменения = СтрокаГрафика.АмортизацияПослеИзменения;
					НоваяСтрока.АренднаяПлатаДоИзменения = СтрокаГрафика.АренднаяПлатаПослеИзменения;
					НоваяСтрока.АмортизацияПослеИзменения = НоваяСтрока.АмортизацияДоИзменения;
					НоваяСтрока.АренднаяПлатаПослеИзменения = НоваяСтрока.АренднаяПлатаДоИзменения;
				КонецЦикла;
				
			КонецЕсли;
			
			СтрокаСведенийЗаполнена = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОтборПоОбъекту = Новый Структура("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
	СтрокиПервоначальныеСведения = Объект.ОсновныеСредства.НайтиСтроки(ОтборПоОбъекту);
	Если Не СтрокаСведенийЗаполнена И СтрокиПервоначальныеСведения.Количество() > 0 Тогда // Из соответствующей строки табличной части "Основные сведения".
		
		ТекущиеДанные.ДатаНачалаАмортизацииДоИзменения = СтрокиПервоначальныеСведения[0].ДатаНачалаАмортизации;
		ТекущиеДанные.ДатаОкончанияАмортизацииДоИзменения = СтрокиПервоначальныеСведения[0].ДатаОкончанияАмортизации;
		ТекущиеДанные.АренднаяПлатаСуммаДоИзменения = СтрокиПервоначальныеСведения[0].АренднаяПлатаСумма;
		ТекущиеДанные.АренднаяПлатаЗаПериодДоИзменения = СтрокиПервоначальныеСведения[0].АренднаяПлатаЗаПериод;
		ТекущиеДанные.УсловиеПользованияДоИзменения = СтрокиПервоначальныеСведения[0].УсловиеПользования;
		
		ТекущиеДанные.ДатаНачалаАмортизации = ТекущиеДанные.ДатаНачалаАмортизацииДоИзменения;
		ТекущиеДанные.ДатаОкончанияАмортизации = ТекущиеДанные.ДатаОкончанияАмортизацииДоИзменения;
		ТекущиеДанные.АренднаяПлатаСумма = ТекущиеДанные.АренднаяПлатаСуммаДоИзменения;
		ТекущиеДанные.АренднаяПлатаЗаПериод = ТекущиеДанные.АренднаяПлатаЗаПериодДоИзменения;
		ТекущиеДанные.УсловиеПользования = ТекущиеДанные.УсловиеПользованияДоИзменения;
		
		ТекущиеДанные.ВидОперацииПринятияКУчетуПравПользованияОС = СтрокиПервоначальныеСведения[0].ВидОперации;
		
		// Копируем график амортизации из табличной части ПервоначальныйГрафикАмортизации.
		Отбор = Новый Структура("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
		СтрокиПервоначальныйГрафикАмортизации = Объект.ПервоначальныйГрафикАмортизации.НайтиСтроки(Отбор);
		Если СтрокиПервоначальныйГрафикАмортизации.Количество() > 0 Тогда
			
			Для Каждого СтрокаГрафика Из СтрокиПервоначальныйГрафикАмортизации Цикл
				НоваяСтрока = Объект.ГрафикАмортизации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика, "ОсновноеСредство, ДатаНачисленияАмортизации, ОплатитьДо");
				НоваяСтрока.ДатаИзменения = ТекущиеДанные.ДатаИзменения;
				НоваяСтрока.АмортизацияДоИзменения = СтрокаГрафика.Амортизация;
				НоваяСтрока.АренднаяПлатаДоИзменения = СтрокаГрафика.АренднаяПлата;
				НоваяСтрока.АмортизацияПослеИзменения = НоваяСтрока.АмортизацияДоИзменения;
				НоваяСтрока.АренднаяПлатаПослеИзменения = НоваяСтрока.АренднаяПлатаДоИзменения;
			КонецЦикла;
			
		КонецЕсли;
		
		СтрокаСведенийЗаполнена = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОбИзмененияхГрафикАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуГрафикаНачисленияАмортизации(Элементы.СведенияОбИзменениях.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СведенияОбИзмененияхЗаполнитьДобавленныеКолонки(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.СведенияОбИзменениях Цикл
		СведенияОбИзмененияхЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СведенияОбИзмененияхЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСумма             = НСтр("ru = 'Сумма по договору:'");
	СтрокаТаблицы.ЗаголовокСуммаСправедливая = НСтр("ru = 'Справедливая стоимость:'");
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ТипИзмененийУсловийПользования) Тогда
		КодИзмененийУсловийПользования = Форма.КэшПараметров.Локальные.КодыИзмененийУсловийПользованияОбъектамиОС.Получить(СтрокаТаблицы.ТипИзмененийУсловийПользования);
		СтрокаТаблицы.ГрафикАмортизации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, на сумму %2'"),
			КодИзмененийУсловийПользования + ": " + СтрокаТаблицы.ТипИзмененийУсловийПользования,
			Формат(СтрокаТаблицы.ВсегоСправедливая, "ЧЦ=10; ЧДЦ=2"));
		СтрокаТаблицы.ГрафикАмортизацииЗаполнен = Истина;
	Иначе
		СтрокаТаблицы.ГрафикАмортизации = НСтр("ru = '<не выбрано>'");
		СтрокаТаблицы.ГрафикАмортизацииЗаполнен = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СведенияОбИмуществе

&НаКлиенте
Процедура СведенияОбИмуществеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.СведенияОбИмуществе.ТекущиеДанные;
		ТекущиеДанные.ОсновноеСредство = ОсновноеСредство; // Из шапки.
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОсновныеСведения(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.ИФО");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Договор'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Договор");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ОсновныеСредства.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьОсновныеСведенияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьОсновныеСведенияНаСервере();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

