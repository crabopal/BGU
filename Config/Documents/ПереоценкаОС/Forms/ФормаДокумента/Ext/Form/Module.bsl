
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();

		Если ЗначениеЗаполнено(Параметры.Основание)
			И ТипЗнч(Параметры.Основание) = Тип("Структура")
			И Параметры.Основание.Свойство("ДокументОснование")
			И ТипЗнч(Параметры.Основание.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
			ЗаполнитьОстаткиОС();
			ОсновныеСредстваРассчитатьВсеСтроки(ЭтотОбъект);
		КонецЕсли;	
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами". 
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВсехСтрок(ЭтотОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	ДатаПриИзмененииНаСервере();
	
	ОсновныеСредстваРассчитатьВсеСтроки(ЭтотОбъект);
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	ЗаполнитьОстаткиОС();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.ОсновныеСредства.Очистить();
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	Объект.ОсновныеСредства.Очистить();
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Объект.ОсновныеСредства.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособПереоценкиПриИзменении(Элемент)
	
	ОсновныеСредстваРассчитатьВсеСтроки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	Объект.ОсновныеСредства.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаЦелевогоДокумента = Неопределено;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СсылкаЦелевогоДокумента = Объект.Ссылка;
	КонецЕсли;	
	ДопПараметры = Новый Структура("СсылкаЦелевогоДокумента", СсылкаЦелевогоДокумента);
	Оповещение = Новый ОписаниеОповещения("ДокументОснованиеПриИзменении_Завершение", ЭтотОбъект, ДопПараметры);
	УправлениеОсновнымиСредствамиКлиент.ВвестиЦелевойДокументНаОсновании(
		Объект.ДокументОснование, ЭтотОбъект, Оповещение, "ПереоценкаОС");
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ПараметрыЗапроса = Новый Структура("Дата, Организация, ИФО, КФО, Подразделение");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО",
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОСПоПодразделениям);
		
	ОС = ТекущиеДанные.ОсновноеСредство;
	ДанныеОС = ПолучитьДанныеОС(ПараметрыЗапроса, ОС);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеОС);
	ТекущиеДанные.ОсновноеСредство = ОС;
	
	ТекущиеДанные.ПереоцененнаяСтоимость = ТекущиеДанные.БалансоваяСтоимость - ТекущиеДанные.СуммаАмортизации - ТекущиеДанные.СуммаОбесценения;
	ОсновныеСредстваРассчитатьСтроку(ЭтотОбъект, ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПереоцененнаяСтоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ОсновныеСредстваРассчитатьСтроку(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваОбработкаВыбораПодбораНаСервере(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище); 
	
	ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОсновноеСредство, ИнвентарныйНомер");
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	
	Объект.ОсновныеСредства.Очистить();
	
	ТабСПИ = ТаблицаСПИ_ОС(ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"), Объект.Дата);
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОС);
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицыОС);
		
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			ПереоцененнаяСтоимость			= СтрокиИсходныхДанных[0].ПереоцененнаяСтоимость;
			СрокПолезногоИспользования		= СтрокиИсходныхДанных[0].СрокПолезногоИспользования;
			СрокПолезногоИспользованияНовый	= СтрокиИсходныхДанных[0].СрокПолезногоИспользованияНовый;
			СрокЭксплуатацииФакт			= СтрокиИсходныхДанных[0].СрокЭксплуатацииФакт;			
		Иначе
			ПереоцененнаяСтоимость = 
				НоваяСтрока.БалансоваяСтоимость - НоваяСтрока.СуммаАмортизации - НоваяСтрока.СуммаОбесценения;
			
			СтрокаСПИ = ТабСПИ.Найти(НоваяСтрока.ОсновноеСредство, "ОсновноеСредство");
			СрокПолезногоИспользования = ?(СтрокаСПИ = Неопределено, 0, СтрокаСПИ.СрокПолезногоИспользования);
			СрокПолезногоИспользованияНовый	= СрокПолезногоИспользования;
			СрокЭксплуатацииФакт			= СрокФактическогоИспользованияОС(Объект.Организация,
				НоваяСтрока.ОсновноеСредство, НоваяСтрока.ИнвентарныйНомер, Объект.Дата);			
		КонецЕсли;
		
		НоваяСтрока.ПереоцененнаяСтоимость			= ПереоцененнаяСтоимость;
		НоваяСтрока.СрокПолезногоИспользования		= СрокПолезногоИспользования;
		НоваяСтрока.СрокПолезногоИспользованияНовый	= СрокПолезногоИспользованияНовый;
		НоваяСтрока.СрокЭксплуатацииФакт			= СрокЭксплуатацииФакт;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВсехСтрок(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокБалансоваяСтоимость         = НСтр("ru = 'балансовая стоимость:'");
	ТекущаяСтрока.ЗаголовокАмортизация                 = НСтр("ru = 'накопленная амортизация:'");
	ТекущаяСтрока.ЗаголовокОбесценение                 = НСтр("ru = 'накопленное обесценение:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимость         = НСтр("ru = 'остаточная стоимость:'");
	
	ТекущаяСтрока.ОстаточнаяСтоимость      = ТекущаяСтрока.БалансоваяСтоимость      - ТекущаяСтрока.СуммаАмортизации      - ТекущаяСтрока.СуммаОбесценения;
	ТекущаяСтрока.ОстаточнаяСтоимостьНовая = ТекущаяСтрока.БалансоваяСтоимостьНовая - ТекущаяСтрока.СуммаАмортизацииНовая - ТекущаяСтрока.СуммаОбесценения;
	
	ТекущаяСтрока.БалансоваяСтоимостьИзменение = ТекущаяСтрока.БалансоваяСтоимостьНовая - ТекущаяСтрока.БалансоваяСтоимость;
	ТекущаяСтрока.СуммаАмортизацииИзменение    = ТекущаяСтрока.СуммаАмортизацииНовая    - ТекущаяСтрока.СуммаАмортизации;
	ТекущаяСтрока.ОстаточнаяСтоимостьИзменение = ТекущаяСтрока.ОстаточнаяСтоимостьНовая - ТекущаяСтрока.ОстаточнаяСтоимость;
	
	ТекущаяСтрока.ЗаголовокСрокИспользованияДоИзменения    = НСтр("ru = 'до изменения:'");
	ТекущаяСтрока.ЗаголовокСрокИспользованияПослеИзменения = НСтр("ru = 'после изменения:'");
	ТекущаяСтрока.ЗаголовокСрокИспользованияФактический    = НСтр("ru = 'фактический:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваРассчитатьВсеСтроки(Форма)
	Объект = Форма.Объект;
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваРассчитатьСтроку(Форма, СтрокаТаблицы);
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваРассчитатьСтроку(Форма, СтрокаТаблицы)
	Объект = Форма.Объект;
	
	Если Объект.СпособПереоценки = ПредопределенноеЗначение("Перечисление.СпособыПереоценкиОС.ПересчитатьПропорционально") Тогда
		
		Коэффициент = ?(СтрокаТаблицы.ОстаточнаяСтоимость = 0, 1, СтрокаТаблицы.ПереоцененнаяСтоимость / СтрокаТаблицы.ОстаточнаяСтоимость);
		СтрокаТаблицы.БалансоваяСтоимостьНовая	= СтрокаТаблицы.БалансоваяСтоимость * Коэффициент;
		СтрокаТаблицы.СуммаАмортизацииНовая		= СтрокаТаблицы.СуммаАмортизации * Коэффициент;
		
	ИначеЕсли Объект.СпособПереоценки = ПредопределенноеЗначение("Перечисление.СпособыПереоценкиОС.СписатьАмортизацию") Тогда
		
		СтрокаТаблицы.БалансоваяСтоимостьНовая	= СтрокаТаблицы.ПереоцененнаяСтоимость;
		СтрокаТаблицы.СуммаАмортизацииНовая		= 0;
		
	Иначе
		
		СтрокаТаблицы.БалансоваяСтоимостьНовая	= 0;
		СтрокаТаблицы.СуммаАмортизацииНовая		= 0;
		
	КонецЕсли;
	
	СтрокаТаблицы.СрокПолезногоИспользованияНовый = СтрокаТаблицы.СрокПолезногоИспользования;
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(СтрокаТаблицы);
	
КонецПроцедуры

