КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКадастру(Команда)
	
	ПроверяемыеПараметры = СтруктураПроверяемыхРеквизитов();
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(ПроверяемыеПараметры, Объект, Истина);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = Объект.ОсновныеСредства.Количество() > 0;
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьПоКадаструЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоКадаструСервер();
		ОсновныеСредстваРассчитатьВсеСтроки(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПоКадаструЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоКадаструСервер();
		ОсновныеСредстваРассчитатьВсеСтроки(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

