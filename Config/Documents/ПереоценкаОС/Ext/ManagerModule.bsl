#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу разделителей для формирования нескольких документов "Обесценение ОС" на основании одного документа
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА  - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.ОбесценениеОС - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- Структура с ключами:
//    * Разделители, значение - ТаблицаЗначений - таблица разделителей документов с полями, 
//    	соответствующими составу разделителя: 
//    * ЗаголовкиКолонок, значение - Структура - структкра содержит в качестве ключей имена колонок
//        таблицы "Разделители", а в качестве значений заголовки этих колонок
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт  
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Ссылка.ДокументОснование КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.ИзменениеСтоимости) КАК ВидОтклонения,
	|	ОсновныеСредства.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	1 КАК Количество
	|ИЗ
	|	Документ.ПереоценкаОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &ПереоценкаОССсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

#КонецОбласти
	
#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ПериодДокумента = ДокументСсылка.МоментВремени();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"				, ПериодДокумента);
	Запрос.УстановитьПараметр("ДатаСобытия"			, ПериодДокумента.Дата);
	Запрос.УстановитьПараметр("ИмяДокумента"		, ДокументСсылка.Метаданные().ПредставлениеОбъекта);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ОсновныеСредства.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ОсновныеСредства.БалансоваяСтоимостьНовая - ОсновныеСредства.БалансоваяСтоимость КАК Стоимость,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Переоценка) КАК Событие,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.ВидПервичногоДокумента = """"
	|			ТОГДА &ИмяДокумента
	|		ИНАЧЕ ОсновныеСредства.Ссылка.ВидПервичногоДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.НомерПервичногоДокумента = """"
	|			ТОГДА ОсновныеСредства.Ссылка.Номер
	|		ИНАЧЕ ОсновныеСредства.Ссылка.НомерПервичногоДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ОсновныеСредства.Ссылка.ДатаПервичногоДокумента
	|	КОНЕЦ КАК ДатаДокумента
	|ИЗ
	|	Документ.ПереоценкаОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.БалансоваяСтоимостьНовая <> ОсновныеСредства.БалансоваяСтоимость";
	
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.СпособПереоценки = ЗНАЧЕНИЕ(Перечисление.СпособыПереоценкиОС.ПересчитатьПропорционально)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.СпособПереоценки = ЗНАЧЕНИЕ(Перечисление.СпособыПереоценкиОС.ПересчитатьПропорционально)
	|			ТОГДА ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаАмортизации
	|		ИНАЧЕ ОсновныеСредства.СуммаАмортизации - ОсновныеСредства.СуммаАмортизацииНовая
	|	КОНЕЦ КАК СуммаАмортизации
	|ИЗ
	|	Документ.ПереоценкаОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.СуммаАмортизацииНовая <> ОсновныеСредства.СуммаАмортизации";	
	
	
	ТаблицыЗапроса.Добавить("ТаблицаДокумента");
	ТаблицыЗапроса.Добавить("ВТ_РасчетАмортизацииОССрезПоследних");
	ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +	
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ПереоцененнаяСтоимость КАК ПереоцененнаяСтоимость,
	|	ОсновныеСредства.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ОсновныеСредства.СрокПолезногоИспользованияНовый КАК СрокПолезногоИспользованияНовый,
	|	ОсновныеСредства.СрокЭксплуатацииФакт КАК СрокЭксплуатацииФакт
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ПереоценкаОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И (ОсновныеСредства.БалансоваяСтоимость <> ОсновныеСредства.БалансоваяСтоимостьНовая
	|			ИЛИ ОсновныеСредства.СуммаАмортизации <> ОсновныеСредства.СуммаАмортизацииНовая)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОССрезПоследних.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ПОМЕСТИТЬ ВТ_РасчетАмортизацииОССрезПоследних
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ТаблицаДокумента.ОсновноеСредство
	|				ИЗ
	|					ТаблицаДокумента КАК ТаблицаДокумента)) КАК РасчетАмортизацииОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаДокумента.Период КАК Период,
	|	ТаблицаДокумента.Организация КАК Организация,
	|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДокумента.ПереоцененнаяСтоимость КАК СтоимостьДляВычисленияАмортизации,
	|	ТаблицаДокумента.СрокПолезногоИспользованияНовый КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.СрокПолезногоИспользованияНовый <= ТаблицаДокумента.СрокЭксплуатацииФакт
	|			ТОГДА 1
	|		ИНАЧЕ ТаблицаДокумента.СрокПолезногоИспользованияНовый - ТаблицаДокумента.СрокЭксплуатацииФакт
	|	КОНЕЦ КАК СрокИспользованияДляВычисленияАмортизации,
	|	ВТ_РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	ВТ_РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	ВТ_РасчетАмортизацииОССрезПоследних.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РасчетАмортизацииОССрезПоследних КАК ВТ_РасчетАмортизацииОССрезПоследних
	|		ПО ТаблицаДокумента.ОсновноеСредство = ВТ_РасчетАмортизацииОССрезПоследних.ОсновноеСредство";
	
	Результат = Запрос.ВыполнитьПакет();
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента)
	Запрос = Новый Запрос;
	
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	ДанныеИнвентаризации.КФО КАК КФО
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта В (2, 3)
	|	И (ДанныеИнвентаризации.КоличествоОбесценение <> 0 ИЛИ ДанныеИнвентаризации.СуммаОбесценение <> 0)
	|	И ДанныеИнвентаризации.Счет = &СчетЗемли
	|Сгруппировать ПО	
	|	ДанныеИнвентаризации.ИФО,
	|	ДанныеИнвентаризации.КФО
	|	";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("СчетЗемли", БухгалтерскийУчет.СчетПоКоду("103.11"));
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить();
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ИФО", "ИФО"));
	
	Возврат(СтруктураРазделителей);
КонецФункции	

#КонецОбласти

#КонецЕсли
