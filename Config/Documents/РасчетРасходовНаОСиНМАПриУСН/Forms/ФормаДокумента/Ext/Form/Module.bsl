&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ТекущийИдСтроки = ПолучитьНовыйИдСтроки();
	
	ОбновитьНастройкиНалогообложения();
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкиНалогообложения()
	
	ДатаДокумента   = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ЭтотОбъект.КэшПараметров.Дата);
	КонецПериода    = КонецКвартала(ДатаДокумента);
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, КонецПериода);
	
	ДатаРегистрации = Справочники.Организации.ДатаРегистрацииОрганизации(Объект.Организация);
	
	// Параметры налогового периода запомним в кэше в локальных параметрах.
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НалоговыйПериодРасширен",
		УчетУСН.НалоговыйПериодРасширен(Объект.Организация, КонецПериода, ДатаРегистрации));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НалоговыйПериодПропущен",
		УчетУСН.НалоговыйПериодПропущен(Объект.Организация, КонецПериода, ДатаРегистрации));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЭтоРасширенныйНалоговыйПериод",
		ЭтотОбъект.КэшПараметров.Локальные.НалоговыйПериодПропущен
		ИЛИ (ЭтотОбъект.КэшПараметров.Локальные.НалоговыйПериодРасширен И НачалоКвартала(Объект.Дата) = НачалоГода(Объект.Дата)));
	
	ПредставлениеТекущегоПериода = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		Перечисления.ДоступныеПериодыОтчета.Квартал, НачалоКвартала(КонецПериода), КонецПериода);
	ПредставлениеСледующегоПериода = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		Перечисления.ДоступныеПериодыОтчета.Квартал, НачалоКвартала(КонецПериода+1), КонецКвартала(КонецПериода+1));
	
	// Применение УСН "Доходы минус расходы".
	Если КонецПериода < ДатаРегистрации Тогда
		
		ШаблонПодсказки = НСтр("ru = 'Регламентную операцию ""%1"" за %2 формировать не нужно.
			|Дата регистрации организации - %3.'");
		ПояснениеПрименениеУСН = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПодсказки,
			Метаданные.Документы.РасчетРасходовНаОСиНМАПриУСН.Представление(),
			ПредставлениеТекущегоПериода,
			Формат(ДатаРегистрации, "ДФ=dd.MM.yyyy"));
		
	ИначеЕсли НЕ ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		
		ШаблонПодсказки = НСтр("ru = 'Регламентную операцию ""%1"" за %2 формировать не нужно.
			|Организация не применяет УСН с объектом налогообложения ""Доходы, уменьшенные на величину расходов"" в указанном периоде.'");
		ПояснениеПрименениеУСН = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПодсказки,
			Метаданные.Документы.РасчетРасходовНаОСиНМАПриУСН.Представление(),
			ПредставлениеТекущегоПериода);
		
	Иначе
		ПояснениеПрименениеУСН = "";
	КонецЕсли;
	Элементы.ПояснениеПрименениеУСН.Заголовок = ПояснениеПрименениеУСН;
	
	// Расширенный налоговый период.
	Если ЭтотОбъект.КэшПараметров.Локальные.НалоговыйПериодПропущен Тогда
		
		ШаблонПодсказки = НСтр("ru = 'Регламентную операцию ""%1"" за %2 формировать не нужно.
			|Расходы с даты регистрации %3 по %4 учитываются в регламентной операции за %5.'");
		ПояснениеРасширенныйНалоговыйПериод = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПодсказки,
			Метаданные.Документы.РасчетРасходовНаОСиНМАПриУСН.Представление(),
			ПредставлениеТекущегоПериода,
			Формат(ДатаРегистрации, "ДФ=dd.MM.yyyy"),
			Формат(КонецПериода, "ДФ=dd.MM.yyyy"),
			ПредставлениеСледующегоПериода);
		
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.НалоговыйПериодРасширен Тогда
		
		ШаблонПодсказки = НСтр("ru = 'Расходы с даты регистрации %1 по %2 учитываются в регламентной операции за %3.'");
		ПояснениеРасширенныйНалоговыйПериод = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПодсказки,
			Формат(ДатаРегистрации, "ДФ=dd.MM.yyyy"),
			Формат(КонецПериода, "ДФ=dd.MM.yyyy"),
			ПредставлениеТекущегоПериода);
		
	Иначе
		
		ПояснениеРасширенныйНалоговыйПериод = "";
		
	КонецЕсли;
	Элементы.ПояснениеРасширенныйНалоговыйПериод.Заголовок = ПояснениеРасширенныйНалоговыйПериод;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.ПояснениеПрименениеУСН.Видимость =
		НЕ Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы;
	Элементы.ПояснениеРасширенныйНалоговыйПериод.Видимость =
		Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И Форма.КэшПараметров.Локальные.ЭтоРасширенныйНалоговыйПериод;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткам()
	
	Объект.ОСиНМА.Очистить();
	Объект.ПризнанныеРасходыУСН.Очистить();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	
	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецКвартала(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьДокумент(ПараметрыЗаполнения);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуРасходовЗаКвартал()
	
	СтрокиРасходов = Объект.ПризнанныеРасходыУСН.НайтиСтроки(
		Новый Структура("ИдСтроки", Элементы.ПризнанныеРасходыУСН.ТекущиеДанные.ИдСтроки));
	
	СуммаРасходовЗаКвартал = 0;
	Для Каждого СтрокаРасходов Из СтрокиРасходов Цикл
	
		СуммаРасходовЗаКвартал = СуммаРасходовЗаКвартал
			+ СтрокаРасходов.СписатьСумма
			+ СтрокаРасходов.СписатьНДС
			+ СтрокаРасходов.СписатьНеУчитываетсяНУ
			+ СтрокаРасходов.СписатьЕНВД;
		
	КонецЦикла;
	
	Элементы.ОСиНМА.ТекущиеДанные.СуммаРасходовЗаКвартал = СуммаРасходовЗаКвартал;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНовыйИдСтроки()

	КолонкаИД = Объект.ОСиНМА.Выгрузить(,"ИдСтроки");
	КолонкаИД.Сортировать("ИдСтроки Убыв");
	Если КолонкаИД.Количество() = 0 Тогда
		Возврат 1;
	Иначе
		Возврат КолонкаИД[0].ИдСтроки + 1;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура УдалитьРасходыУСН(ИдСтроки)

	СтрокиКУдалению = Объект.ПризнанныеРасходыУСН.НайтиСтроки(Новый Структура("ИдСтроки", ИдСтроки));
	Для каждого Строка Из СтрокиКУдалению Цикл
		Объект.ПризнанныеРасходыУСН.Удалить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияТекущейСтроки()
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПозицияСтрокиИзменилась = ИдентификаторТекущейСтроки <> Неопределено;
	Иначе
		ПозицияСтрокиИзменилась = ТекущиеДанные.ПолучитьИдентификатор() <> ИдентификаторТекущейСтроки;
	КонецЕсли;
	
	Если НЕ ПозицияСтрокиИзменилась Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтбор = Новый Структура("ИдСтроки", -1);
	Иначе
		НовыйОтбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	Элементы.ПризнанныеРасходыУСН.ОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтбор);
	
КонецПроцедуры

