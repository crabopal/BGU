	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОСиНМА.Ссылка КАК Регистратор,
	|	ОСиНМА.Ссылка.Дата КАК Период,
	|	ОСиНМА.Ссылка.Организация КАК Организация,
	|	ОСиНМА.ОсновноеСредство КАК ОсновноеСредство,
	|	ОСиНМА.ДатаОплаты КАК ДатаОплаты,
	|	ОСиНМА.ДатаПодачиДокументовНаГосРегистрацию КАК ДатаПодачиДокументовНаГосРегистрацию,
	|	ОСиНМА.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	ОСиНМА.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
	|	ОСиНМА.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
	|	ОСиНМА.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ОСиНМА.КоличествоКварталовВНалоговомПериоде КАК КоличествоКварталовВНалоговомПериоде,
	|	ОСиНМА.ДоляСтоимостиЗаНалоговыйПериод КАК ДоляСтоимостиЗаНалоговыйПериод,
	|	ОСиНМА.ДоляСтоимостиЗаКвартал КАК ДоляСтоимостиЗаКвартал,
	|	ОСиНМА.СуммаРасходовЗаКвартал КАК СуммаРасходовЗаКвартал,
	|	ОСиНМА.СуммаРасходовЗаНалоговыйПериод КАК СуммаРасходовЗаНалоговыйПериод,
	|	ОСиНМА.РасходыПрошлыхПериодов КАК РасходыПрошлыхПериодов,
	|	ОСиНМА.ОставшаясяЧастьРасходов КАК ОставшаясяЧастьРасходов,
	|	ОСиНМА.ДатаВыбытия КАК ДатаВыбытия
	|ИЗ
	|	Документ.РасчетРасходовНаОСиНМАПриУСН.ОСиНМА КАК ОСиНМА
	|ГДЕ
	|	ОСиНМА.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОСиНМА.НомерСтроки";
	НомераТаблиц.Вставить("КнигаУчетаДоходовИРасходовОСиНМА", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

