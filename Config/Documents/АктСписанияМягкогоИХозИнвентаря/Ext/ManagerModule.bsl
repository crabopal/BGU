// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаря";
	КомандаПечати.Идентификатор		= "АктСписанияМЗ0504143_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании мягкого и хоз. инвентаря'"), "0504143", "52н", "103н");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаря";
	КомандаПечати.Идентификатор		= "Акт0510434";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт приема-передачи в личное пользование'"), "0510434", "61н");
	КомандаПечати.Порядок			= 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВыдатьВЛичноеПользование",
		Истина);
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаря";
	КомандаПечати.Идентификатор		= "АктСписанияМЗ0504143_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании мягкого и хоз. инвентаря'"), "0504143", "52н");
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаря";
	КомандаПечати.Идентификатор		= "АктСписанияМЗ0504143";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт о списании мягкого и хоз. инвентаря (ф. 0504143)'");
	КомандаПечати.Порядок			= 100;
	ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати(КомандаПечати);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504143_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504143_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании мягкого и хоз. инвентаря'"), "0504143", "52н", "103н"),
			ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря0504143_103н"));
	КонецЕсли;
			
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504143_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504143_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании мягкого и хоз. инвентаря'"), "0504143", "52н"),
			ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря504143_52н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504143") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504143",
			"Списание материалов",
			ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря0504143"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акт0510434") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Акт0510434",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт приема-передачи в личное пользование'"), "0510434", "61н"),
			Напечатать0510434(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	
	// Реквизит "НеПересчитыватьСумму" устанавливается только при загрузке данных
	НеРедактируемыеРеквизиты.Добавить("НеПересчитыватьСумму");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	ИменаСкрываемыхКнопок = Новый Массив;
	ИменаСкрываемыхКнопок.Добавить("МатериалыЗаполнитьКПСНоменклатура");
	Результат.Вставить("ИменаСкрываемыхКнопок", ИменаСкрываемыхКнопок);
	Возврат Результат;
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ОтразитьВКарточкеКапвложений = Ложь;
	Если НЕ ДополнительныеРеквизиты.Свойство("ОтразитьВКарточкеКапвложений", ОтразитьВКарточкеКапвложений) 
		ИЛИ НЕ ОтразитьВКарточкеКапвложений Тогда
		// Если движения в карточке капвложений отражать не нужно, то ничего не делаем	
		Возврат Истина;	
	ИначеЕсли НЕ ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(ДополнительныеРеквизиты.СчетДт) Тогда
		Возврат Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДополнительныеРеквизиты.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Бухгалтерская операция"" включен флажок 
		|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;		
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДополнительныеРеквизиты.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;
	
	Возврат Истина;
КонецФункции	

Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт

	Возврат УправлениеМатериальнымиЗапасами.ТекстЗапросаТаблицыДляРасчетаДвиженийАктыСписанияМЗ(
	"Документ.АктСписанияМягкогоИХозИнвентаря.Материалы");

КонецФункции

