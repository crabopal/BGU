	|		КОГДА ТаблицаМатериалы.Ссылка.Организация.НаименованиеПолное = """"
	|			ТОГДА ТаблицаМатериалы.Ссылка.Организация.Наименование
	|		ИНАЧЕ ТаблицаМатериалы.Ссылка.Организация.НаименованиеПолное
	|	КОНЕЦ КАК пНаименованиеОрганизации,
	|	ТаблицаМатериалы.Ссылка.Организация.КодОКПО КАК пКодОКПО,
	|	ВЫБОР
	|		КОГДА ТаблицаМатериалы.Ссылка.ПодразделениеОтправитель.НаименованиеПолное = """"
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ТаблицаМатериалы.Ссылка.ПодразделениеОтправитель)
	|		ИНАЧЕ ТаблицаМатериалы.Ссылка.ПодразделениеОтправитель.НаименованиеПолное
	|	КОНЕЦ КАК пПодразделение,
	|	ТаблицаМатериалы.Ссылка.Организация.ИНН КАК ИНН,
	|	ВЫБОР
	|		КОГДА ТаблицаМатериалы.Ссылка.ПодразделениеОтправитель.ОбособленноеПодразделение
	|			ТОГДА ТаблицаМатериалы.Ссылка.ПодразделениеОтправитель.РегистрацияВНалоговомОргане.КПП
	|		ИНАЧЕ ТаблицаМатериалы.Ссылка.Организация.КПП
	|	КОНЕЦ КАК КПП,
	|	ТаблицаМатериалы.Ссылка.ЦМООтправитель.Сотрудник КАК пМОЛ,
	|	ТаблицаМатериалы.Ссылка.ЦМООтправитель.Код КАК пТабНомМОЛ,
	|	ВЫБОР
	|		КОГДА ТаблицаМатериалы.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ (ЕСТЬNULL(ТаблицаМатериалы.Сумма, 0) + ЕСТЬNULL(СуммаПоДвижениям.Сумма, 0) - ЕСТЬNULL(СуммаПоДокументам.Сумма, 0)) / ТаблицаМатериалы.Количество
	|	КОНЕЦ КАК пЦена
	|ИЗ
	|	Материалы КАК ТаблицаМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммаПоДокументам КАК СуммаПоДокументам
	|			ЛЕВОЕ СОЕДИНЕНИЕ СуммаПоДвижениям КАК СуммаПоДвижениям
	|			ПО СуммаПоДокументам.Ссылка = СуммаПоДвижениям.Регистратор
	|				И СуммаПоДокументам.Номенклатура = СуммаПоДвижениям.Номенклатура
	|				И СуммаПоДокументам.СчетКт = СуммаПоДвижениям.СчетКт
	|				И СуммаПоДокументам.КПСКт = СуммаПоДвижениям.КПСКт
	|				И СуммаПоДокументам.КФО = СуммаПоДвижениям.КФО
	|				И СуммаПоДокументам.ДополнительнаяАналитикаСчета = СуммаПоДвижениям.ДержательИмущества
	|		ПО ТаблицаМатериалы.Ссылка = СуммаПоДокументам.Ссылка
	|			И ТаблицаМатериалы.НомерСтроки = СуммаПоДокументам.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер,
	|	пНомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии,
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктСписанияМягкогоИХозИнвентаря.СоставКомиссии КАК АктСписанияМягкогоИХозИнвентаряСоставКомиссии
	|ГДЕ
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктСписанияМягкогоИХозИнвентаряСоставКомиссии.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Счет27", БухгалтерскийУчет.СписокСчетов("27"));
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия = РезультатЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(Выборка);
		СтруктураОбластьМакетаЗаголовок = Новый Структура;
		СтруктураОбластьМакетаЗаголовок.Вставить("пДиректор",Справочники.Сотрудники.ФамилияИО(Выборка.Руководитель, Истина, Выборка.пДата));
		Если ЗначениеЗаполнено(Выборка.ДатаУтверждения) Тогда
			СтруктураОбластьМакетаЗаголовок.Вставить("пДатаУтверждения", Формат(Выборка.ДатаУтверждения, "ДФ='''""''dd''""'' MMMM yyyy ''г.'''"));
		Иначе
			СтруктураОбластьМакетаЗаголовок.Вставить("пДатаУтверждения", """____"" ________________ 20____г.");
		КонецЕсли;
		
		пДатаПриказа = "";
		Если ЗначениеЗаполнено(Выборка.пДатаПриказа) Тогда
			пДатаПриказа = Формат(Выборка.пДатаПриказа,"ДЛФ=ДД");
		КонецЕсли;
		СтруктураОбластьМакетаЗаголовок.Вставить("пДатаПриказа",пДатаПриказа);
		СтруктураОбластьМакетаЗаголовок.Вставить("пДатаЗаголовка",Формат(Выборка.пДата,"ДЛФ=ДД"));
		
		ВыборкаКомиссия.Сбросить();																				
		СтруктураПоиска = Новый Структура("Ссылка", Выборка.Ссылка);
		Если ВыборкаКомиссия.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаКомиссияТекДок = ВыборкаКомиссия.Выбрать();
		Иначе
			ВыборкаКомиссияТекДок = Неопределено;
		КонецЕсли;
		пЧленыКомиссии = "";
		ОбластьКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(Выборка, ВыборкаКомиссияТекДок, ОбластьМакетаКомиссия, 3, пЧленыКомиссии, Истина);
		СтруктураОбластьМакетаЗаголовок.Вставить("пЧленыКомиссии", пЧленыКомиссии);

		ОбластьМакетаЗаголовок.Параметры.Заполнить(СтруктураОбластьМакетаЗаголовок);
		
		//НастройкаПечатиНомера
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаЗаголовок,"пНомер",Выборка.пНомер,Выборка.Ссылка,Неопределено, Истина);
		//

		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		пКоличествоИтого = 0;
		пСуммаИтого		 = 0;
		ВыборкаСтрок = Выборка.Выбрать();
		Пока ВыборкаСтрок.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаСтрок.пНомерСтроки) Тогда
				Продолжить;
			КонецЕсли;
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтрок);
			
			ПредставлениеСчетДт = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
				ВыборкаСтрок.КПСДт, ВыборкаСтрок.КФО, ВыборкаСтрок.СчетДт, ВыборкаСтрок.КЭКДт);
			ПредставлениеСчетКт = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
				ВыборкаСтрок.КПСКт, ВыборкаСтрок.КФО, ВыборкаСтрок.СчетКт, ВыборкаСтрок.КЭККт);
			
			СтруктураОбластьМакетаСтрока = Новый Структура("пСчетДебета,пСчетКредита",ПредставлениеСчетДт,ПредставлениеСчетКт);
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураОбластьМакетаСтрока);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			пКоличествоИтого = пКоличествоИтого + ВыборкаСтрок.пКоличество;
			пСуммаИтого		 = пСуммаИтого		+ ВыборкаСтрок.пСумма;
		КонецЦикла;
		СтруктураОбластьМакетаИтого = Новый Структура("пКоличествоИтого,пСуммаИтого",пКоличествоИтого,пСуммаИтого);
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтруктураОбластьМакетаСтр2Начало = Новый Структура;
		Если пКоличествоИтого = Цел(пКоличествоИтого) Тогда
			СтруктураОбластьМакетаСтр2Начало.Вставить("пКоличествоИтогоПрописью",ЧислоПрописью(пКоличествоИтого,,"штука,штуки,штук,ж,,,,,0"));
		Иначе
			СтруктураОбластьМакетаСтр2Начало.Вставить("пКоличествоИтогоПрописью","");
		КонецЕсли;
		Если пСуммаИтого <> 0 Тогда
			СтруктураОбластьМакетаСтр2Начало.Вставить("пСуммаИтогоПрописью",ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(пСуммаИтого, 
																		Константы.ВалютаРегламентированногоУчета.Получить()));
		Иначе																		
			СтруктураОбластьМакетаСтр2Начало.Вставить("пСуммаИтогоПрописью", "");
		КонецЕсли;
		СтруктураОбластьМакетаСтр2Начало.Вставить("ЗаключениеКомиссии", Выборка.ЗаключениеКомиссии);
		ОбластьМакетаСтр2Начало.Параметры.Заполнить(СтруктураОбластьМакетаСтр2Начало);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Начало);
		
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Шапка);
		
		ПодвалСтраницы2 = Новый Массив;
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Строка);
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Строка);
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Подвал);
		ПодвалСтраницы2.Добавить(ОбластьКомиссия);
		ПодвалСтраницы2.Добавить(ОбластьМакетаПодвал);
		
		Пока ТабличныйДокумент.ПроверитьВывод(ПодвалСтраницы2) Цикл
			ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Строка);
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Строка);
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Подвал);
		
		// комиссия
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
		
		//ТабличныйДокумент.Вывести(ОбластьМакетаСтр2);
		//
		//ТабличныйДокумент.Вывести(ОбластьКомиссия);
		//ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ДанныеДляПечати0510434(МассивОбъектов)
	
	ПодразделенияСписанияМЗ = УправлениеПечатьюБГУ.ПодразделенияСотрудниковМЗ0510434(МассивОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПодразделенияСписанияМЗ", ПодразделенияСписанияМЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодразделенияСписанияМЗ.Документ КАК Документ,
	|	ПодразделенияСписанияМЗ.Подразделение КАК Подразделение,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ПодразделенияСписанияМЗ
	|ИЗ
	|	&ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|;
	|ВЫБРАТЬ
	|	МатериальныеЗапасы.Ссылка КАК Ссылка,
	|	МатериальныеЗапасы.НомерСтроки КАК НомерСтроки,
	|	МатериальныеЗапасы.Номенклатура КАК Номенклатура,
	|	МатериальныеЗапасы.Количество КАК Количество,
	|	МатериальныеЗапасы.ВидимыеДефекты КАК Дефекты,
	|	МатериальныеЗапасы.ОсобыеОтметки КАК ОсобыеОтметки,
	|	АктСписанияМягкогоИХозИнвентаря.ПолучательИмущества КАК СотрудникОбеспечения
	|ПОМЕСТИТЬ ВТ_Материалы
	|ИЗ
	|	Документ.АктСписанияМягкогоИХозИнвентаря.Материалы КАК МатериальныеЗапасы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМягкогоИХозИнвентаря КАК АктСписанияМягкогоИХозИнвентаря
	|	ПО МатериальныеЗапасы.Ссылка = АктСписанияМягкогоИХозИнвентаря.Ссылка
	|ГДЕ
	|	МатериальныеЗапасы.Ссылка В (&МассивОбъектов)
	|	И АктСписанияМягкогоИХозИнвентаря.Ссылка В (&МассивОбъектов)
	|;
	|ВЫБРАТЬ
	|	ОбеспечениеСотрудниковИмуществом.Владелец КАК Сотрудник,
	|	ТЧОбеспечениеИмуществом.Имущество,
	|	ТЧОбеспечениеИмуществом.Приспособления КАК Приспособления,
	|	ТЧОбеспечениеИмуществом.РазмерОдежды КАК РазмерОдежды,
	|	ТЧОбеспечениеИмуществом.РазмерГоловногоУбора КАК РазмерГоловногоУбора,
	|	ТЧОбеспечениеИмуществом.РазмерОбуви КАК РазмерОбуви,
	|	ТЧОбеспечениеИмуществом.РазмерИное КАК РазмерИное,
	|	ТЧОбеспечениеИмуществом.НормаВыдачи КАК НормаВыдачи,
	|	ТЧОбеспечениеИмуществом.СрокИспользованияПоНормативу КАК СрокИспользованияПоНормативу,
	|	ТЧОбеспечениеИмуществом.ЕдиницаИзмеренияСрока КАК ЕдиницаИзмеренияСрока,
	|	ТЧОбеспечениеИмуществом.КодУсловияВозвратаИмущества КАК КодУсловияВозвратаИмущества
	|ПОМЕСТИТЬ Вт_ОбеспечениеИмуществом
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом КАК ОбеспечениеСотрудниковИмуществом
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК ТЧОбеспечениеИмуществом
	|	ПО ОбеспечениеСотрудниковИмуществом.Ссылка = ТЧОбеспечениеИмуществом.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМягкогоИХозИнвентаря КАК АктСписанияМягкогоИХозИнвентаря
	|	ПО ОбеспечениеСотрудниковИмуществом.Владелец = АктСписанияМягкогоИХозИнвентаря.ПолучательИмущества
	|ГДЕ
	|	АктСписанияМягкогоИХозИнвентаря.Ссылка В (&МассивОбъектов)
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктСписанияМягкогоИХозИнвентаря.Ссылка КАК Ссылка,
	|	АктСписанияМягкогоИХозИнвентаря.Номер КАК Номер,
