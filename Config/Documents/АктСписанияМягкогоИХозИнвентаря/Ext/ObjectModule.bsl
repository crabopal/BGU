#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	НепроверяемыеРеквизиты = Новый Массив;
	Если Не БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.ЦМО) Тогда
		НепроверяемыеРеквизиты.Добавить("ЦМООтправитель");
	КонецЕсли;
	Если КФОВТабличнойЧасти Тогда
		НепроверяемыеРеквизиты.Добавить("КФО");
	Иначе
		НепроверяемыеРеквизиты.Добавить("Материалы.КФО");
	КонецЕсли;
	НепроверяемыеРеквизиты.Добавить("Материалы.СтранаПроисхождения");
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "Материалы", "Материалы", Отказ);
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ПроверитьОчиститьКПС = Истина;
	Если Не КФОВТабличнойЧасти Тогда
		СтруктураДействий.ОчиститьКФО = Истина;
	КонецЕсли;

	ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, "Материалы",, Отказ);
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Материалы", Истина);
	ПрослеживаемостьБГУ.СписаниеМЗПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	УправлениеМатериальнымиЗапасами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НеПересчитыватьСумму = Ложь;
	
	Если СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация) Тогда
		ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
		ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
		ПараметрыОбработки.Вставить("ДтКт",          "Кт");
		
		Для каждого Строка Из Материалы Цикл
			
			Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
				ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
				ПараметрыОбработки.Счет         = Строка.СчетУчета;
				
				УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ОчиститьДопСубконто = УправлениеМатериальнымиЗапасами.ПараметрыПроверкиЗаполненияДопСубконто(ВыдатьВЛичноеПользование, Дата, Организация);
	УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(Материалы, СтруктураДействий);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОтразитьДвиженияРезервирования(ЭтотОбъект);
	ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли