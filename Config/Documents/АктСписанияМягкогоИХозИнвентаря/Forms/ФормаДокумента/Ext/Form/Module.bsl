&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	РассчитатьПрослеживаемыеТовары();
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект);
	ЗаполнитьДанныеСчетовВФорме();
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьВидимостьЭлементовЗагруженногоДокумента(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект, Объект);
	
	УправлениеМатериальнымиЗапасами.УстановитьВидДопСубконтоЛичногоПользования(
	ЭтотОбъект,
	Объект.ВыдатьВЛичноеПользование,
	?(ЭтотОбъект.КэшПараметров.Локальные.Счета27.Количество(), ЭтотОбъект.КэшПараметров.Локальные.Счета27[0], ПланыСчетов.ЕПСБУ.ПустаяСсылка()),
	"МатериалыДополнительноеСубконтоСчета",
	"Материалы");
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьПризнакФормыДополнительноеСубконто3(ЭтотОбъект);

	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	УстановитьДоступностьКФО(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьВидимостьКолонкиДопСубконто()

	Если ВсеСчета105.НайтиПоЗначению(Объект.СчетУчета) = Неопределено Тогда
		УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(Элементы.МатериалыДополнительнаяАналитикаСчета, Объект.СчетУчета);
	Иначе
		УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(Элементы.МатериалыДополнительнаяАналитикаСчета, ВсеСчета105);
	КонецЕсли;

КонецПроцедуры // ОтключитьВидимостьКолонкиДопСубконто()

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",				Объект.СчетУчета);
	ПараметрыПодбора.Вставить("КФО",					Объект.КФО);
	ПараметрыПодбора.Вставить("ЦМО", 					Объект.ЦМООтправитель);
	ПараметрыПодбора.Вставить("Подразделение",			Объект.ПодразделениеОтправитель);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");

	Если СчетУчета27(ЭтотОбъект) Тогда
		ПараметрыПодбора.Вставить("ПодборОстатковВПользовании", Истина);
		ПараметрыПодбора.Вставить("СчетОстатковВПользовании", Объект.СчетУчета);
	КонецЕсли;
	
	Если Объект.ВыдатьВЛичноеПользование Тогда
		ПараметрыПодбора.Вставить("ВладелецНормыВыдачи", Объект.ПолучательИмущества);
	КонецЕсли;
	
	ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер.ДополнительнаяАналитикаСчетаУчетаМатериалов(Объект.СчетУчета, Объект.Организация);
	Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
		ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
	КонецЕсли;
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаКлиенте
Процедура ДоступностьСвязанныхЭлементов()

	Элементы.ЦМООтправитель.Доступность				= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПодразделениеОтправитель.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект.Материалы.Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				СтрокаМатериалы.КоличествоНорма = СтрокаМатериалы.Количество;
				ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаМатериалы, Ложь, Истина);
				СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			Иначе
				СтрокаМатериалыОбъект = Объект.Материалы[СтрокаМатериалы.НомерСтрокиДокумента-1];
				КпересчетаНормы = ?(СтрокаМатериалыОбъект.Количество > 0, СтрокаМатериалыОбъект.КоличествоНорма / СтрокаМатериалыОбъект.Количество, 1);
				СтрокаМатериалы.КоличествоНорма = СтрокаМатериалы.Количество*КпересчетаНормы;
			КонецЕсли;
		КонецЦикла;
		
		Объект.Материалы.Загрузить(ВтМатериалы);
		
		РассчитатьПрослеживаемыеТовары();
		УстановитьВидимостьЭлементов(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет, ЭтоПодбор = Ложь)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
	Если Не ЭтоПодбор Тогда
		РеквизитыНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(Строка.Номенклатура, Форма.Объект.Дата);
		ЗаполнитьЗначенияСвойств(Строка, РеквизитыНоменклатуры,
			"ПрослеживаемыйТовар, КомплектСПрослеживаемымиТоварами, СтранаПроисхождения");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
		Строка.ДополнительноеСубконтоВидСубконто = Форма.ДополнительноеСубконто27ВидСубконто;
	КонецЕсли;
	
КонецПроцедуры

