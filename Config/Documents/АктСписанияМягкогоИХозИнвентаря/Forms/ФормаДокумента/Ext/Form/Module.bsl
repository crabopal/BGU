&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекНомерСтроки = ТекущиеДанные.НомерСтроки;
		Если ТекНомерСтроки >1 Тогда
			ТекущиеДанные.ПричинаСписания = Объект.Материалы[ТекНомерСтроки-2].ПричинаСписания;
		КонецЕсли;
		
	КонецЕсли;
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если Копирование И ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = ПредопределенноеЗначение("Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

