&НаСервере
Процедура ОбновитьДанныеСчетовВФорме()
	ЗаполнитьДанныеСчетовВФорме();
	Если Элементы.СчетУчета.СписокВыбора.НайтиПоЗначению(Объект.СчетУчета) = Неопределено Тогда
		Объект.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме()

	Элементы.СчетУчета.СписокВыбора.Очистить();

	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ОтключитьВидимостьКолонкиДопСубконто();
	Счет10500 = БухгалтерскийУчет.СчетПоКоду("105.00", Объект.Дата, Объект.Организация);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105", Счет10500);
	Элементы.СчетУчета.СписокВыбора.Добавить(Счет10500);
	
	Счета27 = ПолучитьСчета27();
	СчетУчетаИмуществаВПользовании = Новый Массив;
	Для Каждого ТекСчет27 Из Счета27 Цикл
		Элементы.СчетУчета.СписокВыбора.Добавить(ТекСчет27.Значение, ТекСчет27.Представление);
		СчетУчетаИмуществаВПользовании.Добавить(ТекСчет27.Значение);
	КонецЦикла;
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счета27", Новый ФиксированныйМассив(СчетУчетаИмуществаВПользовании));
	
	ВидыДопСубконто = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительногоСубконтоУчетаМЗ();
	Для Каждого НастройкаСчета Из ВидыДопСубконто Цикл
		СчетаДопСубконто3.Добавить(НастройкаСчета.Ключ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСчета27()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счета27)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код УБЫВ";
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Счета27 = БухгалтерскийУчет.СписокСчетов("27", ДатаСчетов, , Объект.Организация);
	Запрос.УстановитьПараметр("Счета27", Счета27);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;
	Возврат Результат;
КонецФункции

