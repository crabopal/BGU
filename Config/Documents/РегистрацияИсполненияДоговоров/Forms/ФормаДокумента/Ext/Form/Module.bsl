#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользоватьДетализациюПоКОСГУВГрафиках = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(Объект.ВидДоговоров);
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(Объект.ВидДоговоров);
	
	ПредыдущийВидДоговоров = Объект.ВидДоговоров;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоСПоставщиком = (Объект.ВидДоговоров = ПредопределенноеЗначение(
		"Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
	ЭтоСПокупателем = (Объект.ВидДоговоров = ПредопределенноеЗначение(
		"Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
	ЭтоМБТ = (Объект.ВидДоговоров = ПредопределенноеЗначение(
		"Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта"));
	ЭтоСубсидия = (Объект.ВидДоговоров = ПредопределенноеЗначение(
		"Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии"));
	
	// План-график реализации, закупок доступен для договоров "С поставщиком" или "С покупателем".
	КолонкиОстаток = Новый Массив;
	КолонкиОстаток.Добавить("ИсполнениеДоговоров");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КолонкиОстаток, "Видимость", ЭтоСПоставщиком ИЛИ ЭтоСПокупателем ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия);
	
	Если ЭтоСПоставщиком Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график закупок'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсполнениеДоговоровРасширеннаяПодсказка", "Заголовок",
			НСтр("ru = 'Введите информацию о фактическом исполнении плана-графика закупок по операциям поступления ценностей (товаров, работ, услуг), которые не были отражены в графике ранее'"));
	ИначеЕсли ЭтоСПокупателем Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график реализации'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсполнениеДоговоровРасширеннаяПодсказка", "Заголовок",
			НСтр("ru = 'Введите информацию о фактическом исполнении плана-графика реализации по операциям реализации ценностей (товаров, работ, услуг), которые не были отражены в графике ранее'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график исполнения'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсполнениеДоговоровРасширеннаяПодсказка", "Заголовок",
			НСтр("ru = 'Введите информацию о фактическом исполнении плана-графика исполнения по операциям, которые не были отражены в графике ранее'"));
	КонецЕсли;
	
	// Детализация по КЭК.
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ИсполнениеДоговоровКЭК");
	ЭлементыДопАналитика.Добавить("ОплатаПоДоговорамКЭК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", Форма.ИспользоватьДетализациюПоКОСГУВГрафиках);
	
	// Дополнительная аналитика.
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ОплатаПоДоговорамДопКлассификация");
	ЭлементыДопАналитика.Добавить("ОплатаПоДоговорамКодМероприятия");
	ЭлементыДопАналитика.Добавить("ОплатаПоДоговорамКодЦели");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", Форма.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере(ЗаполнитьГрафикИсполнения = Истина, ЗаполнитьГрафикПлатежей = Истина)
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Отказ = Документы.РегистрацияИсполненияДоговоров.ЗаполнитьПоДаннымУчета(Объект, ЗаполнитьГрафикИсполнения, ЗаполнитьГрафикПлатежей);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
