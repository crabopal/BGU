			|		
			|			ОБЪЕДИНИТЬ ВСЕ
			|		
			|			ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				ПереносОплаты.Регистратор
			|			ИЗ
			|				ПереносОплаты)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоступлениеДенежныхСредств.Период КАК Период,
			|	ПоступлениеДенежныхСредств.Организация КАК Организация,
			|	ПоступлениеДенежныхСредств.ИФО КАК ИФО,
			|	ПоступлениеДенежныхСредств.КФО КАК КФО,
			|	ПоступлениеДенежныхСредств.КПС КАК КПС,
			|	ПоступлениеДенежныхСредств.КЭК КАК КЭК,
			|	ПоступлениеДенежныхСредств.Счет КАК Счет,
			|	ПоступлениеДенежныхСредств.Субконто1 КАК Субконто1,
			|	ПоступлениеДенежныхСредств.Субконто2 КАК Субконто2,
			|	ПоступлениеДенежныхСредств.Субконто3 КАК Субконто3,
			|	ПоступлениеДенежныхСредств.Контрагент КАК Контрагент,
			|	ПоступлениеДенежныхСредств.Договор КАК Договор,
			|	ПоступлениеДенежныхСредств.Договор.ВидДоговора КАК ВидДоговора,
			|	ПоступлениеДенежныхСредств.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
			|	ПоступлениеДенежныхСредств.ДопСубконто КАК ДопСубконто,
			|	ПоступлениеДенежныхСредств.Валюта КАК Валюта,
			|	ПоступлениеДенежныхСредств.КорСчет КАК КорСчет,
			|	ПоступлениеДенежныхСредств.Регистратор КАК Регистратор,
			|	ПоступлениеДенежныхСредств.СуммаРасчетовРуб КАК СуммаРасчетовРуб,
			|	ПоступлениеДенежныхСредств.СуммаРасчетовВал КАК СуммаРасчетовВал,
			|	ПоступлениеДенежныхСредств.СуммаРасчетов КАК СуммаРасчетов,
			|	ЛОЖЬ КАК ЭтоПереносОплаты
			|ИЗ
			|	ПоступлениеДенежныхСредств КАК ПоступлениеДенежныхСредств
			|		ЛЕВОЕ СОЕДИНЕНИЕ ОтраженаОплатаОтПокупателейДебиторов КАК ОтраженаОплатаОтПокупателейДебиторов
			|		ПО ПоступлениеДенежныхСредств.Регистратор = ОтраженаОплатаОтПокупателейДебиторов.Регистратор
			|		ЛЕВОЕ СОЕДИНЕНИЕ ОтраженаРегистрацияИсполненияДоговоров КАК ОтраженаРегистрацияИсполненияДоговоров
			|		ПО ПоступлениеДенежныхСредств.Регистратор = ОтраженаРегистрацияИсполненияДоговоров.Регистратор
			|ГДЕ
			|	ПоступлениеДенежныхСредств.СуммаРасчетов <> 0
			|	И ОтраженаОплатаОтПокупателейДебиторов.Регистратор ЕСТЬ NULL
			|	И ОтраженаРегистрацияИсполненияДоговоров.Регистратор ЕСТЬ NULL
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ПереносОплаты.Период,
			|	ПереносОплаты.Организация,
			|	ПереносОплаты.ИФО,
			|	ПереносОплаты.КФО,
			|	ПереносОплаты.КПС,
			|	ПереносОплаты.КЭК,
			|	ПереносОплаты.Счет,
			|	ПереносОплаты.Субконто1,
			|	ПереносОплаты.Субконто2,
			|	ПереносОплаты.Субконто3,
			|	ПереносОплаты.Контрагент,
			|	ПереносОплаты.Договор,
			|	ПереносОплаты.Договор.ВидДоговора,
			|	ПереносОплаты.Договор.ВестиГрафикПлатежей,
			|	ПереносОплаты.ДопСубконто,
			|	ПереносОплаты.Валюта,
			|	ПереносОплаты.КорСчет,
			|	ПереносОплаты.Регистратор,
			|	ПереносОплаты.СуммаРасчетовРуб,
			|	ПереносОплаты.СуммаРасчетовВал,
			|	ПереносОплаты.СуммаРасчетов,
			|	ИСТИНА
			|ИЗ
			|	ПереносОплаты КАК ПереносОплаты
			|		ЛЕВОЕ СОЕДИНЕНИЕ ОтраженаОплатаОтПокупателейДебиторов КАК ОтраженаОплатаОтПокупателейДебиторов
			|		ПО ПереносОплаты.Регистратор = ОтраженаОплатаОтПокупателейДебиторов.Регистратор
			|		ЛЕВОЕ СОЕДИНЕНИЕ ОтраженаРегистрацияИсполненияДоговоров КАК ОтраженаРегистрацияИсполненияДоговоров
			|		ПО ПереносОплаты.Регистратор = ОтраженаРегистрацияИсполненияДоговоров.Регистратор
			|ГДЕ
			|	ПереносОплаты.СуммаРасчетов <> 0
			|	И ОтраженаОплатаОтПокупателейДебиторов.Регистратор ЕСТЬ NULL
			|	И ОтраженаРегистрацияИсполненияДоговоров.Регистратор ЕСТЬ NULL
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период";
			
			Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "Договоры.Контрагент = &Контрагент");
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "Договоры.Ссылка = &Договор");
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА");
			КонецЕсли;
			
			Результат = Запрос.ВыполнитьПакет();
			
			РегистрацияОплатыОтПокупателейДебиторов = Результат[НомераТаблиц.РегистрацияОплатыОтПокупателейДебиторов].Выгрузить();
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ЭтоПоступление", Новый ОписаниеТипов("Булево"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("КодМероприятия", Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("КодЦели", Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ИсточникСредств", Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств"));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("ИмяСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
			РегистрацияОплатыОтПокупателейДебиторов.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
			Для Каждого СтрокаОплата Из РегистрацияОплатыОтПокупателейДебиторов Цикл
				
				СтрокаОплата.ИмяСписка = "ОплатаПоДоговорам";
				СтрокаОплата.СинонимСписка = "График платежей";
				СтрокаОплата.НомерСтроки = РегистрацияОплатыОтПокупателейДебиторов.Индекс(СтрокаОплата) + 1;
				
				СтрокаОплата.ЭтоПоступление = Истина; // Поступление денежных средств.
				СтрокаОплата.СчетРасчетов = СтрокаОплата.Счет;
				СтрокаОплата.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
				
				Если Не БухгалтерскийУчет.КЭКВИерархии(СтрокаОплата.КЭК, "100,200,300,400") Тогда
					СтрокаОплата.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаОплата.СчетРасчетов);
				КонецЕсли;
				
			КонецЦикла;
			
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
			Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
			Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
			
			ТаблицаОплатаОтПокупателейДебиторов = КонтрольИсполненияДоговоров.ТаблицаОплатаОтПокупателейДебиторов(
				РегистрацияОплатыОтПокупателейДебиторов, ДокументОбъект, Реквизиты, Отказ);
			
			ДокументОбъект.ОплатаПоДоговорам.Очистить();
			Для Каждого СтрокаОплата Из ТаблицаОплатаОтПокупателейДебиторов Цикл
				НоваяСтрока = ДокументОбъект.ОплатаПоДоговорам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОплата);
			КонецЦикла;
			
			
		ИначеЕсли ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			  ИЛИ ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			  ИЛИ ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			  ИЛИ ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			// Исполнение графика платежей по договору с поставщиком отражается в момент погашения кредиторской задолженности (Дт 302.00).
			
			Если ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			 ИЛИ ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг Тогда
				Запрос.УстановитьПараметр("СчетаРасчетовСПоставщикамиКредиторами", БухгалтерскийУчет.СписокСчетов("301.00"));
				Запрос.УстановитьПараметр("СчетаЗачетВстречныхТребований", Новый Массив);
			Иначе
				Запрос.УстановитьПараметр("СчетаРасчетовСПоставщикамиКредиторами", БухгалтерскийУчет.СписокСчетов("302.00"));
				Запрос.УстановитьПараметр("СчетаЗачетВстречныхТребований", БухгалтерскийУчет.СписокСчетов("205.00,209.00"));
				Запрос.УстановитьПараметр("СчетаСредстваВоВременномРаспоряжении30401", БухгалтерскийУчет.СписокСчетов("304.01"));
			КонецЕсли;
			Запрос.УстановитьПараметр("СчетаДенежныхСредств", БухгалтерскийУчет.СписокСчетов("201.00,210.02"));
			
			ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
			
			НомераТаблиц = Новый Структура;
			НомераТаблиц.Вставить("ДоговорыСГрафикомПлатежей", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("ВыплатаДенежныхСредств", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("ПереносОплаты", НомераТаблиц.Количество());
