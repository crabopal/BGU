// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ИспользоватьВалютныйУчет);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("ИсполнениеОбязательствПоставщиками");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ИсполнениеДоговоров.Ссылка.Дата КАК Период,
	|	ИсполнениеДоговоров.ИФО КАК ИФО,
	|	ИсполнениеДоговоров.КФО КАК КФО,
	|	ИсполнениеДоговоров.КПС КАК КПС,
	|	ИсполнениеДоговоров.КЭК КАК КЭК,
	|	ИсполнениеДоговоров.СчетРасчетов КАК СчетРасчетов,
	|	ИсполнениеДоговоров.Ссылка.Организация КАК Организация,
	|	ИсполнениеДоговоров.Контрагент КАК Контрагент,
	|	ИсполнениеДоговоров.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ &ИспользоватьВалютныйУчет
	|				ИЛИ ИсполнениеДоговоров.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ИсполнениеДоговоров.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ИсполнениеДоговоров.ИсполнитьДо КАК ИсполнитьДо,
	|	ИсполнениеДоговоров.Сумма КАК Сумма
	|ИЗ
	|	Документ.РегистрацияИсполненияДоговоров.ИсполнениеДоговоров КАК ИсполнениеДоговоров
	|ГДЕ
	|	ИсполнениеДоговоров.Ссылка = &Ссылка
	|	И ИсполнениеДоговоров.Договор.ВестиПланГрафикИсполнения
	|	И ИсполнениеДоговоров.Договор.ВидДоговора В(&ВидыДоговоровСПоставщикамиКредиторами)";
	
	ТаблицыЗапроса.Добавить("ИсполнениеДоговоровСПокупателями");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ИсполнениеДоговоров.Ссылка.Дата КАК Период,
	|	ИсполнениеДоговоров.ИФО КАК ИФО,
	|	ИсполнениеДоговоров.КФО КАК КФО,
	|	ИсполнениеДоговоров.КПС КАК КПС,
	|	ИсполнениеДоговоров.КЭК КАК КЭК,
	|	ИсполнениеДоговоров.СчетРасчетов КАК СчетРасчетов,
	|	ИсполнениеДоговоров.Ссылка.Организация КАК Организация,
	|	ИсполнениеДоговоров.Контрагент КАК Контрагент,
	|	ИсполнениеДоговоров.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ &ИспользоватьВалютныйУчет
	|				ИЛИ ИсполнениеДоговоров.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ИсполнениеДоговоров.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ИсполнениеДоговоров.ИсполнитьДо КАК ИсполнитьДо,
	|	ИсполнениеДоговоров.Сумма КАК Сумма
	|ИЗ
	|	Документ.РегистрацияИсполненияДоговоров.ИсполнениеДоговоров КАК ИсполнениеДоговоров
	|ГДЕ
	|	ИсполнениеДоговоров.Ссылка = &Ссылка
	|	И ИсполнениеДоговоров.Договор.ВестиПланГрафикИсполнения
	|	И ИсполнениеДоговоров.Договор.ВидДоговора В(&ВидыДоговоровСПокупателямиДебиторами)";
	
	ТаблицыЗапроса.Добавить("ОплатаПоставщикамКредиторам");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ОплатаПоДоговорам.Ссылка.Дата КАК Период,
	|	ОплатаПоДоговорам.ИФО КАК ИФО,
	|	ОплатаПоДоговорам.КФО КАК КФО,
	|	ОплатаПоДоговорам.КПС КАК КПС,
	|	ОплатаПоДоговорам.КЭК КАК КЭК,
	|	ОплатаПоДоговорам.СчетРасчетов КАК СчетРасчетов,
	|	ОплатаПоДоговорам.Ссылка.Организация КАК Организация,
	|	ОплатаПоДоговорам.Контрагент КАК Контрагент,
	|	ОплатаПоДоговорам.Договор КАК Договор,
	|	ОплатаПоДоговорам.ДопКлассификация КАК ДопКлассификация,
	|	ОплатаПоДоговорам.КодМероприятия КАК КодМероприятия,
	|	ОплатаПоДоговорам.КодЦели КАК КодЦели,
	|	ВЫБОР
	|		КОГДА НЕ &ИспользоватьВалютныйУчет
	|				ИЛИ ОплатаПоДоговорам.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ОплатаПоДоговорам.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ОплатаПоДоговорам.ВидРасчетов КАК ВидРасчетов,
	|	ОплатаПоДоговорам.ОплатитьДо КАК ОплатитьДо,
	|	ОплатаПоДоговорам.Сумма КАК Сумма
	|ИЗ
	|	Документ.РегистрацияИсполненияДоговоров.ОплатаПоДоговорам КАК ОплатаПоДоговорам
	|ГДЕ
	|	ОплатаПоДоговорам.Ссылка = &Ссылка
	|	И ОплатаПоДоговорам.Договор.ВестиГрафикПлатежей
	|	И ОплатаПоДоговорам.Договор.ВидДоговора В(&ВидыДоговоровСПоставщикамиКредиторами)";
	
	ТаблицыЗапроса.Добавить("ОплатаОтПокупателейДебиторов");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ОплатаПоДоговорам.Ссылка.Дата КАК Период,
	|	ОплатаПоДоговорам.ИФО КАК ИФО,
	|	ОплатаПоДоговорам.КФО КАК КФО,
	|	ОплатаПоДоговорам.КПС КАК КПС,
	|	ОплатаПоДоговорам.КЭК КАК КЭК,
	|	ОплатаПоДоговорам.СчетРасчетов КАК СчетРасчетов,
	|	ОплатаПоДоговорам.Ссылка.Организация КАК Организация,
	|	ОплатаПоДоговорам.Контрагент КАК Контрагент,
	|	ОплатаПоДоговорам.Договор КАК Договор,
	|	ОплатаПоДоговорам.ДопКлассификация КАК ДопКлассификация,
	|	ОплатаПоДоговорам.КодМероприятия КАК КодМероприятия,
	|	ОплатаПоДоговорам.КодЦели КАК КодЦели,
	|	ВЫБОР
	|		КОГДА НЕ &ИспользоватьВалютныйУчет
	|				ИЛИ ОплатаПоДоговорам.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ОплатаПоДоговорам.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ОплатаПоДоговорам.ВидРасчетов КАК ВидРасчетов,
	|	ОплатаПоДоговорам.ОплатитьДо КАК ОплатитьДо,
	|	ОплатаПоДоговорам.Сумма КАК Сумма
	|ИЗ
	|	Документ.РегистрацияИсполненияДоговоров.ОплатаПоДоговорам КАК ОплатаПоДоговорам
	|ГДЕ
	|	ОплатаПоДоговорам.Ссылка = &Ссылка
	|	И ОплатаПоДоговорам.Договор.ВестиГрафикПлатежей
	|	И ОплатаПоДоговорам.Договор.ВидДоговора В(&ВидыДоговоровСПокупателямиДебиторами)";
	
	Запрос.УстановитьПараметр("ВидыДоговоровСПоставщикамиКредиторами", КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПоставщикамиКредиторами());
	Запрос.УстановитьПараметр("ВидыДоговоровСПокупателямиДебиторами", КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПокупателямиДебиторами());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры	

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьПоДаннымУчета(ДокументОбъект, ЗаполнитьГрафикИсполнения = Истина, ЗаполнитьГрафикПлатежей = Истина) Экспорт
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ВидДоговоров",  ДокументОбъект.ВидДоговоров);
	Запрос.УстановитьПараметр("Контрагент",    ДокументОбъект.Контрагент);
	Запрос.УстановитьПараметр("Договор",       ДокументОбъект.Договор);
	Запрос.УстановитьПараметр("НачалоПериода", ?(ЗначениеЗаполнено(ДокументОбъект.НачалоПериода), НачалоДня(ДокументОбъект.НачалоПериода), Неопределено));
	Запрос.УстановитьПараметр("КонецПериода",  ?(ЗначениеЗаполнено(ДокументОбъект.КонецПериода), КонецДня(ДокументОбъект.КонецПериода), Неопределено));
	
	Если ЗаполнитьГрафикИсполнения Тогда
		
		Если ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		 ИЛИ ДокументОбъект.ВидДоговоров = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта Тогда
			
			// Исполнение плана-графика реализации отражается в момент начисления доходов текущего периода (Кт 401.10).
			
			Запрос.УстановитьПараметр("СчетаРасчетовСПокупателямиДебиторами", БухгалтерскийУчет.СписокСчетов("205.00,209.00"));
			Запрос.УстановитьПараметр("Счета40140", БухгалтерскийУчет.СписокСчетов("401.40"));
			Запрос.УстановитьПараметр("Счета40110", БухгалтерскийУчет.СписокСчетов("401.10"));
			
			ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
			
			НомераТаблиц = Новый Структура;
			НомераТаблиц.Вставить("ДоговорыСПланомГрафикомРеализации", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("НачислениеДоходовТекущегоПериода", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("ПризнаниеДоходовТекущегоПериода", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("ОтраженоИсполнениеДоговоровСПокупателями", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("ОтраженаРегистрацияИсполненияДоговоров", НомераТаблиц.Количество());
			НомераТаблиц.Вставить("РегистрацияИсполненияДоговоровСПокупателями", НомераТаблиц.Количество());
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Договоры.Ссылка КАК Договор
			|ПОМЕСТИТЬ ДоговорыСПланомГрафикомРеализации
			|ИЗ
			|	Справочник.Договоры КАК Договоры
			|ГДЕ
			|	Договоры.ВидДоговора = &ВидДоговоров
			|	И Договоры.ВестиПланГрафикИсполнения
			|	И &УсловиеДоговор
			|	И &УсловиеКонтрагент
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕПСБУОбороты.Период КАК Период,
			|	ЕПСБУОбороты.Организация КАК Организация,
			|	ЕСТЬNULL(ЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
			|	ЕПСБУОбороты.КФО КАК КФО,
			|	ЕПСБУОбороты.КПС КАК КПС,
			|	ЕПСБУОбороты.КЭККор КАК КЭК,
			|	ЕПСБУОбороты.Счет КАК Счет,
			|	ЕПСБУОбороты.Субконто1 КАК Субконто1,
			|	ЕПСБУОбороты.Субконто2 КАК Субконто2,
			|	ЕПСБУОбороты.Субконто3 КАК Субконто3,
			|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
			|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
			|	ВЫБОР
			|		КОГДА НЕ ЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Контрагенты
			|				И НЕ ЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Договоры
			|			ТОГДА ЕПСБУОбороты.Субконто3
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК ДопСубконто,
			|	ВЫБОР
			|		КОГДА ЕПСБУОбороты.Валюта ЕСТЬ NULL
			|				ИЛИ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|			ТОГДА &ВалютаРеглУчета
			|		ИНАЧЕ ЕПСБУОбороты.Валюта
			|	КОНЕЦ КАК Валюта,
			|	ЕПСБУОбороты.КорСчет КАК КорСчет,
			|	ЕПСБУОбороты.Регистратор КАК Регистратор,
			|	ЕПСБУОбороты.СуммаОборотДт КАК СуммаРасчетовРуб,
			|	ЕПСБУОбороты.ВалютнаяСуммаОборотДт КАК СуммаРасчетовВал,
			|	ВЫБОР
			|		КОГДА ЕПСБУОбороты.Счет.Валютный
			|			ТОГДА ЕПСБУОбороты.ВалютнаяСуммаОборотДт
			|		ИНАЧЕ ЕПСБУОбороты.СуммаОборотДт
			|	КОНЕЦ КАК СуммаРасчетов
			|ПОМЕСТИТЬ НачислениеДоходовТекущегоПериода
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Регистратор,
			|			Счет В (&СчетаРасчетовСПокупателямиДебиторами),
			|			,
			|			Организация = &Организация
			|				И Субконто2 В
			|					(ВЫБРАТЬ
			|						ДоговорыСПланомГрафикомРеализации.Договор
			|					ИЗ
