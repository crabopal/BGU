#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// Заполнение


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	
	ТипЗначения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипЗначения = Тип("Структура") И ДанныеЗаполнения.Свойство("СпособЗаполнения") Тогда
		
		Если ДанныеЗаполнения.СпособЗаполнения = "ЗаполнениеПоПакету" Тогда 
			СтандартнаяОбработка = Ложь;
			ЗаполнениеПоПакету(ДанныеЗаполнения);
			
		Иначе 
			ВызватьИсключение "Неизвестный способ заполнения";
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Дата) Тогда 
		Дата = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнениеПоПакету(ДанныеЗаполнения) 
	
	// Ожидаемая структура данных
	// ДанныеЗаполнения.СпособЗаполнения
	// ДанныеЗаполнения.Пакет
	// ДанныеЗаполнения.Группа
	// ДанныеЗаполнения.ПолноеИмяФайла
	// ДанныеЗаполнения.ДвоичныеДанные
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пакет",ДанныеЗаполнения.Пакет);
	Запрос.УстановитьПараметр("Группа",ДанныеЗаполнения.Группа);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПакетВыгрузкиОтчетности.Организация,
	|	ПакетВыгрузкиОтчетности.Период КАК ОтчетныйПериод,
	|	ПакетВыгрузкиОтчетности.ФорматВыгрузки КАК ФорматВыгрузки,
	|	ПакетВыгрузкиОтчетности.Ссылка КАК Пакет,
	|	&Группа
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка = &Пакет";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		
		Шаблон = НСтр("ru = 'Не удалось получить основные данные пакета ""%1"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеЗаполнения.Пакет);
		ВызватьИсключение Сообщение;
		
	КонецЕсли;
	ОсновныеДанные = РезультатЗапроса.Выгрузить()[0];
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ОсновныеДанные);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПакетВыгрузкиОтчетностиДопДанныеГрупп.ВидОтправляемогоДокумента КАК ВидДокумента,
	|	ПакетВыгрузкиОтчетностиДопДанныеГрупп.КодИФНС КАК КодИФНСПолучателя,
	|	ПакетВыгрузкиОтчетностиДопДанныеГрупп.НомерКорректировки
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ДопДанныеГрупп КАК ПакетВыгрузкиОтчетностиДопДанныеГрупп
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиДопДанныеГрупп.Ссылка = &Пакет
	|	И ПакетВыгрузкиОтчетностиДопДанныеГрупп.Группа = &Группа";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		
		Шаблон = НСтр("ru = 'Не удалось получить дополнительные данные пакета ""%1"" и группы ""%2"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеЗаполнения.Пакет,ДанныеЗаполнения.Группа);
		ВызватьИсключение Сообщение;
		
	КонецЕсли;
	ДополнительныеДанные = Запрос.Выполнить().Выгрузить()[0];
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДополнительныеДанные);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка КАК Отчет
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ОтчетыПакета КАК ПакетВыгрузкиОтчетностиОтчетыПакета
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка = &Пакет
	|	И ПакетВыгрузкиОтчетностиОтчетыПакета.Группа = &Группа";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		
		Шаблон = НСтр("ru = 'Не удалось получить отчеты пакета ""%1"" и группы ""%2"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеЗаполнения.Пакет,ДанныеЗаполнения.Группа);
		ВызватьИсключение Сообщение;
		
	КонецЕсли;
	ЭкземплярыОтчетов.Загрузить(РезультатЗапроса.Выгрузить());
	
	ИмяФайлаВыгрузки = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеЗаполнения.ПолноеИмяФайла,Ложь).Имя;
	
	ДвоичныеДанныеФайла = Новый ХранилищеЗначения(ДанныеЗаполнения.ДвоичныеДанные);	
	
	
КонецПроцедуры	

// Заполнение
////////////////////////////////////////////////////////////////////////////////
// Выгрузка в БГУ2

// Выгружает документ и возвращает свойства файла выгрузки.
//
// Параметры:
//  УникальныйИдентификатор - уникальный идентификатор, который требуется использовать при помещении данных во временное
//  хранилище.
//
// Результат:
//	Массив структур или Неопределено, если не удалось сформировать файл выгрузки.
//	Ключи структуры:
//		- АдресФайлаВыгрузки - адрес двоичных данных файла выгрузки во временном хранилище.
//		- ИмяФайлаВыгрузки - короткое имя файла выгрузки (с расширением).
Функция ВыгрузитьДокумент(УникальныйИдентификатор = Неопределено) Экспорт
	
	ДвоичныеДанные = ДвоичныеДанныеФайла.Получить();
	
	СтрокаОтвета = Новый Структура;
	СтрокаОтвета.Вставить("АдресФайлаВыгрузки", ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор));
	СтрокаОтвета.Вставить("ИмяФайлаВыгрузки"  , ИмяФайлаВыгрузки);
	
	МассивОтветов = Новый Массив;
	МассивОтветов.Добавить(СтрокаОтвета);
	
	Возврат МассивОтветов;
	
КонецФункции

// Выгрузка в БГУ2
////////////////////////////////////////////////////////////////////////////////
// Выгрузка в БГУ1 

// Формирование выгрузки для отправки по защищенным каналам связи.
//
Функция СформироватьВыходнойФайл(Отказ) Экспорт
	
	Если ЭтоНовый() Тогда
		Сообщить(НСтр("ru = 'Документ необходимо записать.'"), СтатусСообщения.Внимание);
		Отказ = Истина;
		Возврат "";
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	ДвоичныеДанные = ДвоичныеДанныеФайла.Получить();
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
	
	Возврат ТекстовыйДокумент.ПолучитьТекст();
	
КонецФункции // СформироватьВыходнойФайл

// Выгрузка в БГУ1
