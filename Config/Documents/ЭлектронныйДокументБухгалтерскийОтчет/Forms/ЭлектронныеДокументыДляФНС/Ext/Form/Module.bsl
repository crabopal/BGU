
////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьСписокДокументов(Знач СписокДокументов)

	ТаблицаДокументов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументБухгалтерскийОтчет.Ссылка,
	|	ЭлектронныйДокументБухгалтерскийОтчет.Номер,
	|	ЕСТЬNULL(СтатусыОтправки.Статус, ""Не отправлен"") КАК Статус
	|ИЗ
	|	Документ.ЭлектронныйДокументБухгалтерскийОтчет КАК ЭлектронныйДокументБухгалтерскийОтчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыОтправки КАК СтатусыОтправки
	|		ПО СтатусыОтправки.Объект = ЭлектронныйДокументБухгалтерскийОтчет.Ссылка
	|ГДЕ
	|	ЭлектронныйДокументБухгалтерскийОтчет.Ссылка В(&СписокДокументов)";
	
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		СтрокаТаблицы = ТаблицаДокументов.Добавить();
		СтрокаТаблицы.Ссылка  = Выборка.Ссылка;
		СтрокаТаблицы.Пометка = Истина;
		СтрокаТаблицы.Представление = "№ " +  Выборка.Номер;
		СтрокаТаблицы.Статус = Строка(Выборка.Статус);
	КонецЦикла;

КонецПроцедуры // ЗаполнитьСписокДокументов()

&НаКлиенте
Функция ВозможноВзаимодействиеСКонтролирующимОрганом()
	
	МассивОрганизацийДляПроверки = ИспользуемыеОрганизации();
	
	Для Каждого ОрганизацияДляПроверки Из МассивОрганизацийДляПроверки Цикл 
		
		НастроенОбменВУниверсальномФормате = Ложь;
		УчетнаяЗаписьПредназначенаДляДокументооборотаСКО = Ложь;
		
		ВыгрузкаВФНСКлиентПереопределяемый.ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганВФормеСписка(ОрганизацияДляПроверки, "ФНС", НастроенОбменВУниверсальномФормате, УчетнаяЗаписьПредназначенаДляДокументооборотаСКО);
		
		Если НЕ НастроенОбменВУниверсальномФормате Тогда
			ВыгрузкаВФНСКлиентПереопределяемый.ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(ОрганизацияДляПроверки);
			Возврат Ложь;
		Иначе
			Если УчетнаяЗаписьПредназначенаДляДокументооборотаСКО = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Недостаточно прав для использования модуля документооборота!'"));
				Возврат Ложь;
				
			ИначеЕсли УчетнаяЗаписьПредназначенаДляДокументооборотаСКО = Ложь Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Учетная запись документооборота, сопоставленная организации, не предназначена для взаимодействия с ФНС.'"));
				
				Возврат Ложь;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;// Все организации прошли проверку.

КонецФункции // ВозможноВзаимодействиеСКонтролирующимОрганом()


&НаСервере
Функция ИспользуемыеОрганизации()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы",ТаблицаДокументов.Выгрузить(Новый Структура("Пометка",Истина)).ВыгрузитьКолонку("Ссылка"));
	Запрос.Текст= 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭлектронныйДокументБухгалтерскийОтчет.Организация КАК Организация
	|ИЗ
	|	Документ.ЭлектронныйДокументБухгалтерскийОтчет КАК ЭлектронныйДокументБухгалтерскийОтчет
	|ГДЕ
	|	ЭлектронныйДокументБухгалтерскийОтчет.Ссылка В(&Документы)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
КонецФункции	

&НаКлиенте
Процедура УстановитьПометкуДляСтрок(Знач ЗначениеПометки)

	Для Каждого Стр Из ТаблицаДокументов Цикл
		Стр.Пометка = ЗначениеПометки;
	КонецЦикла;

КонецПроцедуры // УстановитьПометкуДляСтрок()

&НаКлиенте
Процедура ВыполнитьОтправкуВнутр(Реузультат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ДополнительныеПараметры.Этап = "РезультатВопроса";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОтправкуВнутр",ЭтаФорма,ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения,НСтр("ru='Вы подтверждаете, что отчетность заполнена полностью и корректно?'"), РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатВопроса" Тогда 
		
		Если Реузультат = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "РезультатПолученияКонтекста";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОтправкуВнутр",ЭтаФорма,ДополнительныеПараметры);
		
		ВыгрузкаВФНСКлиентПереопределяемый.ПолучитьКонтекстЭДО(ОписаниеОповещения);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатПолученияКонтекста" Тогда 	
		
		Если ЗначениеЗаполнено(Реузультат.ТекстОшибки) Тогда 
			Сообщить(Реузультат.ТекстОшибки);
			Возврат;
		КонецЕсли;            
		
		ДополнительныеПараметры.Вставить("КонтекстЭДО",Реузультат.КонтекстЭДО);
		ДополнительныеПараметры.Вставить("Счетчик",0);
		ДополнительныеПараметры.Вставить("ВсегоДокументов",ДополнительныеПараметры.ОтмеченныеДокументы.Количество());
		
		
		КонтекстЭДОКлиент = Реузультат.КонтекстЭДО;
		ОтмеченныеДокументы = ДополнительныеПараметры.ОтмеченныеДокументы;
		
		ДополнительныеПараметры.Этап = "ЦиклОтправкиЧ1";
		
		ВыполнитьОтправкуВнутр(Неопределено,ДополнительныеПараметры);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклОтправкиЧ1" Тогда 
		
		Если Не ЗначениеЗаполнено(ДополнительныеПараметры.ОтмеченныеДокументы) Тогда 
			Состояние();
			
			ДополнительныеПараметры.Этап = "РезультатВопросаЗакрытие";
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОтправкуВнутр",ЭтаФорма,ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения,НСтр("ru='Все отмеченные отчеты были отправлены. 
														|Закрыть форму списка отчетов для отправки?'"), РежимДиалогаВопрос.ДаНет);
			
			Возврат;
		КонецЕсли;
		СтрДокумента = ДополнительныеПараметры.ОтмеченныеДокументы[0];
		
		
		СтрокаСостояния = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Отправка отчета %1'"),
		СтрДокумента.Представление);
		
		Прогресс = Окр(ДополнительныеПараметры.Счетчик * 100 / ДополнительныеПараметры.ВсегоДокументов);
		Состояние(СтрокаСостояния, Прогресс);
		
		ДополнительныеПараметры.Счетчик = ДополнительныеПараметры.Счетчик + 1;
		
		
		ДополнительныеПараметры.Вставить("СтрДокумента",СтрДокумента);
		ДополнительныеПараметры.Этап = "ЦиклОтправкиЧ2";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОтправкуВнутр",ЭтаФорма,ДополнительныеПараметры);
			
		ДополнительныеПараметры.КонтекстЭДО.ОтправкаРегламентированногоОтчетаВФНС(ДополнительныеПараметры.СтрДокумента.Ссылка, ОписаниеОповещения);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклОтправкиЧ2" Тогда 	
		
		Если не Реузультат Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'При отправке отчетов произошли ошибки. Отправка прервана.'"));
			Возврат;
		КонецЕсли;
		
		ВыгруженнаяСтрока = ДополнительныеПараметры.ОтмеченныеДокументы.Получить(0);
		ВыгруженнаяСтрока.Пометка = Ложь;
		ДополнительныеПараметры.ОтмеченныеДокументы.Удалить(0);
		
		ДополнительныеПараметры.Этап = "ЦиклОтправкиЧ1";
		
		ВыполнитьОтправкуВнутр(Неопределено,ДополнительныеПараметры);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатВопросаЗакрытие" Тогда 
		
		Если Реузультат = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ЭтаФорма.Закрыть();
	
	КонецЕсли;
	
	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокДокументов(Параметры.СписокДокументов);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = ТаблицаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПоказатьЗначение(,ДанныеСтроки.Ссылка);
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОтправитьВыбранные(Команда)
	
	ОтмеченныеДокументы = ТаблицаДокументов.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если ОтмеченныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю((НСтр("ru = 'Необходимо отметить документы, которые требуется отправить.'")));
		Возврат;
	КонецЕсли;
	
	Если Не ВозможноВзаимодействиеСКонтролирующимОрганом() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап","Начало");
	ДополнительныеПараметры.Вставить("ОтмеченныеДокументы",ОтмеченныеДокументы);	
	
	ВыполнитьОтправкуВнутр(Неопределено,ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьПометкуДляСтрок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СброситьВсе(Команда)
	УстановитьПометкуДляСтрок(Ложь);
КонецПроцедуры
