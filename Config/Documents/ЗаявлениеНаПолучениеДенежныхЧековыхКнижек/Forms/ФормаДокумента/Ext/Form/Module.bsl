#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОтветственныеЛица()
	
	ОтветственныеЛица = ОрганизационнаяСтруктураПовтИсп.ОтветственныеЛицаОрганизацииСоответствием(Объект.Организация, Объект.Дата);
	
	Объект.Руководитель = ОтветственныеЛица.Получить("Руководитель").ОтветственноеЛицоСсылка;
	Объект.РуководительДолжность = ОтветственныеЛица.Получить("Руководитель").ДолжностьПредставление;
	РуководительФИО = ОтветственныеЛица.Получить("Руководитель").ОтветственноеЛицоФИО;
	
	Объект.ГлБухгалтер = ОтветственныеЛица.Получить("Главный бухгалтер").ОтветственноеЛицоСсылка;
	Объект.ГлБухгалтерДолжность = ОтветственныеЛица.Получить("Главный бухгалтер").ДолжностьПредставление;
	ГлБухгалтерФИО = ОтветственныеЛица.Получить("Главный бухгалтер").ОтветственноеЛицоФИО;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСотрудника(Элемент)
	
	ПараметрыФормы = Новый Структура("ТребуемыеДанные, Отбор, ЗакрыватьПриВыборе",
									"Фамилия, Имя, Отчество, Должность",
									Новый Структура("Владелец", Объект.Организация),
									Истина);
	
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораСотрудника(ЭлементИмя, ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		ВыбранныйСотрудник = ВыбранноеЗначение;
	Иначе
		ВыбранныйСотрудник = ВыбранноеЗначение.Ссылка;
	КонецЕсли;
	
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, Должность, УдостоверениеЛичности, ДолжностьНаименование, ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи",
	ВыбранныйСотрудник, 
	Объект.Дата);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
	
	ЭтаФорма[ЭлементИмя] = ДанныеСотрудника.НаименованиеПолное;
	
	Если ЭлементИмя = "ПолучательФИО" Тогда
		Объект.Получатель 					= ВыбранныйСотрудник;
		Объект.ПолучательДолжность 			= ДанныеСотрудника.ДолжностьНаименование;
		Объект.ПолучательДокументВид 		= ДанныеСотрудника.ВидДокумента;
		Объект.ПолучательДокументСерия 		= ДанныеСотрудника.Серия;
		Объект.ПолучательДокументНомер 		= ДанныеСотрудника.Номер;
		Объект.ПолучательДокументВыданКем 	= ДанныеСотрудника.КемВыдан;
		Объект.ПолучательДокументВыданКогда = ДанныеСотрудника.ДатаВыдачи;
		
	ИначеЕсли ЭлементИмя = "РуководительФИО" Тогда
		Объект.Руководитель 			= ВыбранныйСотрудник;
		Объект.РуководительДолжность 	= ДанныеСотрудника.ДолжностьНаименование;
		
	ИначеЕсли ЭлементИмя = "ГлБухгалтерФИО" Тогда
		Объект.ГлБухгалтер 			= ВыбранныйСотрудник;
		Объект.ГлБухгалтерДолжность = ДанныеСотрудника.ДолжностьНаименование;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПриИзменении(Элемент)
	
	Если Элемент.Имя = "ПолучательФИО" Тогда
		Объект.Получатель = ПолучательФИО;
	ИначеЕсли Элемент.Имя = "РуководительФИО" Тогда
		Объект.Руководитель = РуководительФИО;
	ИначеЕсли Элемент.Имя = "ГлБухгалтерФИО" Тогда
		Объект.ГлБухгалтер = ГлБухгалтерФИО;
	КонецЕсли;
	
	Модифицированность = ИСТИНА;
	
КонецПроцедуры

