	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявлениеНаПолучениеДенежныхЧековыхКнижек";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявление на получение чековых книжек (ред. от 31.12.2010 № 199н)'");
