Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек22н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек22н",
			"Заявление на получение денежных чековых книжек",
			ПечатьЗаявления(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек22н"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек",
			"Заявление на получение денежных чековых книжек",
			ПечатьЗаявления(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек0531242") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек0531242",
			"Заявление на получение денежных чековых книжек",
			ПечатьЗаявления(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек0531242"));
	КонецЕсли;

КонецПроцедуры

// Функция формирует табличный документ 
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявления(МассивОбъектов, ОбъектыПечати, НомерФормы)
	Перем Месяцы;
	
	Месяцы = Новый Массив;
	Месяцы.Добавить("января");
	Месяцы.Добавить("февраля");
	Месяцы.Добавить("марта");
	Месяцы.Добавить("апреля");
	Месяцы.Добавить("мая");
	Месяцы.Добавить("июня");
	Месяцы.Добавить("июля");
	Месяцы.Добавить("августа");
	Месяцы.Добавить("сентября");
	Месяцы.Добавить("октября");
	Месяцы.Добавить("ноября");
	Месяцы.Добавить("декабря");	
	
	ТабДокумент 					= Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявлениеНаПолучениеДенежныхЧековыхКнижек";
	Макет 							= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявлениеНаПолучениеДенежныхЧековыхКнижек." + НомерФормы);
	Обл   							= Макет.ПолучитьОбласть("Заявление");
		
	Обл.Параметры.Заполнить(МассивОбъектов[0]);
	Обл.Параметры.ПредставлениеОрганизации	= ?(МассивОбъектов[0].Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование,
												МассивОбъектов[0].Организация.НаименованиеСокращенное,
												МассивОбъектов[0].Организация.НаименованиеПолное);
	Обл.Параметры.Казначейство				= МассивОбъектов[0].ОрганКазначейства.НаименованиеПолное;
	Обл.Параметры.КодПоРПБС					= МассивОбъектов[0].Организация.КодПоРПБС;
	Обл.Параметры.ИНН						= МассивОбъектов[0].Организация.ИНН;
	Обл.Параметры.КОФК						= МассивОбъектов[0].ОрганКазначейства.Код;
	Обл.Параметры.День						= День(МассивОбъектов[0].Дата);
	Обл.Параметры.Месяц						= Месяцы[Месяц(МассивОбъектов[0].Дата) - 1];
	Обл.Параметры.Год						= Формат(Год(МассивОбъектов[0].Дата), "ЧГ=''");
	Обл.Параметры.КоличествоПрописью		= СокрЛП(ЧислоПрописью(МассивОбъектов[0].КоличествоКнижек, "Л=ru_RU", ",,,ж,,,ж,,0"));
	Обл.Параметры.ПредставлениеРаботника	= МассивОбъектов[0].ПолучательДолжность + ", " + Строка(МассивОбъектов[0].Получатель);
	Обл.Параметры.ДеньВыдачи				= День(МассивОбъектов[0].ПолучательДокументВыданКогда);
	Обл.Параметры.МесяцВыдачи				= Месяцы[Месяц(МассивОбъектов[0].ПолучательДокументВыданКогда) - 1];
	Обл.Параметры.ГодВыдачи					= Формат(Год(МассивОбъектов[0].ПолучательДокументВыданКогда), "ЧГ=''");
	Обл.Параметры.РуководительФИО			= Корреспонденты.ФИОПоОбъекту(Строка(МассивОбъектов[0].Руководитель), ИСТИНА);
	Обл.Параметры.ГлБухгалтерФИО			= Корреспонденты.ФИОПоОбъекту(Строка(МассивОбъектов[0].ГлБухгалтер), ИСТИНА);
	
	ТабДокумент.Вывести(Обл);
		
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 1, ОбъектыПечати, МассивОбъектов[0]);
	
	Возврат ТабДокумент;
	
КонецФункции

