&НаКлиенте
Процедура ВывестиВопросПоЗаполнению(СпособПодбора)
	
	ДопПараметры = Новый Структура("ИмяМакета", СпособПодбора);
		
	ТекстВопроса = НСтр("ru='Документ уже заполнен, выберите необходимое действие:'"); 
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить("Перезаполнить", "Перезаполнить документ");
	СписокКнопок.Добавить("Добавить", "Добавить строки по отбору");
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВопросаПередЗаполнением", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Отмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОкноОтбора(ИмяМакета)
	Адреса = РаботаСоСтудентамиВызовСервера.ПолучитьАдресаСКДПодбора(ИмяМакета, УникальныйИдентификатор);

	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = СтрШаблон(НСтр("ru = 'Настройка параметров отбора учащихся (значения на %1)'"), Формат(Объект.Дата, "ДЛФ=DD"));
	
	ДопПараметры = Новый Структура("Адреса, ИмяМакета", Адреса, ИмяМакета);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы, ЭтаФорма, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
	
	Если Объект.Учащиеся.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;	
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчащимисяСервер(Адреса)
	
	ДанныеОтчета = РаботаСоСтудентами.ПолучитьДанныеПодбораУчащихся(Адреса, Объект.Организация, Объект.Факультет, Объект.Дата);
	
	ПараметрыДолгосрочныхДоговоров = Новый Структура;
	ПараметрыДолгосрочныхДоговоров.Вставить("Организация", Объект.Организация);
	ПараметрыДолгосрочныхДоговоров.Вставить("Факультет", Объект.Факультет);
	ПараметрыДолгосрочныхДоговоров.Вставить("Валюта", Объект.ВалютаДокумента);
	ПараметрыДолгосрочныхДоговоров.Вставить("НачалоПериода", Объект.НачалоПериода);
	ПараметрыДолгосрочныхДоговоров.Вставить("КонецПериода", Объект.КонецПериода);
	ПараметрыДолгосрочныхДоговоров.Вставить("СпособЗаполненияПоПериоду", Объект.СпособЗаполненияПоПериоду);
	
	ДополненныеДанные = РаботаСоСтудентами.ОтобратьИДополнитьДолгосрочныеДоговоры(ДанныеОтчета, ПараметрыДолгосрочныхДоговоров);
	
	ДополненныеДанныеСОплатами = РаботаСоСтудентами.ДополнитьДолгосрочныеДоговорыДаннымиОплаты(ДополненныеДанные, ПараметрыДолгосрочныхДоговоров);
	
	СтруктураПоиска = Новый Структура("Учащийся, Контрагент, ДоговорКонтрагента, НачалоПериода, КонецПериода, ДатаОплаты"); 
	
	Для Каждого СтрокаДанных Из ДополненныеДанныеСОплатами Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДанных);
		МассивСтрок = Объект.Учащиеся.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() = 0 Тогда
			// Добавляем только отсутствующие строки, без дублирования по всем измерениям.
			Если СтрокаДанных.Сумма > 0 Тогда
				НоваяСтрока = Объект.Учащиеся.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
	
	УстановитьПредупреждение();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитТЧ(ИмяРеквизита, Значение)
	
	Для каждого Строка Из Объект.Учащиеся Цикл
			
		Строка[ИмяРеквизита] = Значение;
		Строка.АвтоРасчет = Ложь;
			
	КонецЦикла; 
	
КонецПроцедуры

