Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
      УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЗапроситьОчисткуТабЧасти(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЭлементВладелец = ДопПараметры.Элемент;
		ТабЧасть = ДопПараметры.ТабЧасть;
		
		ТабЧасть.Очистить();
		ПараметрыФормыВыбора = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Организация));
		ОткрытьФорму("Справочник.Подразделения.Форма.ФормаВыбора", ПараметрыФормыВыбора, ЭлементВладелец);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПередОтбором(Результат, ДопПараметры) Экспорт
	Если Результат = "Перезаполнить" Тогда
		ТабЧасть = ДопПараметры.ТабЧасть;
		
		ТабЧасть.Очистить();
	КонецЕсли;
	
	Если Результат <> КодВозвратаДиалога.Отмена Тогда
		ИмяМакета = ДопПараметры.ИмяМакета;
		ОткрытьФормуОтбора(ИмяМакета, ИмяМакета = "Подбор");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоясняющиеНадписи(Стр)
	Стр.НадписьС = НСтр("ru='с:'");
	Стр.НадписьПо = НСтр("ru='по:'");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонки()
	Для Каждого Стр Из Объект.СтудентыДопУслуги Цикл
		ЗаполнитьПоясняющиеНадписи(Стр);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтбора(ИмяМакета, ДобавлятьПоляБыстрогоОтбора)
	Адреса = РаботаСоСтудентамиВызовСервера.ПолучитьАдресаСКДПодбора(ИмяМакета, УникальныйИдентификатор, ДобавлятьПоляБыстрогоОтбора);
	
	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = СтрШаблон(НСтр("ru = 'Настройка параметров отбора учащихся (значения на %1)'"),
		Формат(РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(Объект) - 1, "ДЛФ=DD"));
	
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ЗаполнитьСтудентамиЗавершение", ЭтотОбъект, Новый Структура("Адреса", Адреса)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСтраницПоВидуПриказа()
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);
	
	Элементы.СтраницаДопУслуги.Видимость = ДопУслуга;
	Элементы.ИспользоватьФакультетДокументаДопУслуги.Видимость = ДопУслуга;
	Элементы.ДатаОкончанияДействия.Видимость = ДопУслуга;
	Элементы.СтраницаСписокСтудентов.Видимость = Не ДопУслуга;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДопУслугаПоВидуПриказа(ВидПриказа)
	Возврат РаботаСоСтудентамиПовтИсп.ДопУслугаПоВидуПриказа(ВидПриказа);
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПриказНаДопУслугу(ВидПриказа)
	Возврат (ВидПриказа.УправлениеДополнительнойУслугой = 1);
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьПустуюТаблицуСтудентов()
	
	Таблица = Новый ТаблицаЗначений();
	
	Таблица.Колонки.Добавить("Студент", Новый ОписаниеТипов("СправочникСсылка.Студенты"));
	
	Возврат Таблица;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоляПоВиду(ВидПриказа)
	
	ПоляПоВиду = Справочники.ВидыПриказовОбразование.ПолучитьПоляВида(ВидПриказа);
	ПоляПоВиду.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка"));
	Для каждого СтрокаПоля Из ПоляПоВиду Цикл
		СтрокаПоля.ИмяКолонки = РаботаСоСтудентамиПовтИсп.ИмяКолонкиПоПолю(СтрокаПоля.Поле);
	КонецЦикла; 
	
	Возврат ПоляПоВиду;

КонецФункции // ПолучитьПоляПоВиду()

&НаСервереБезКонтекста
Функция ПолучитьДанныеПоСтудентуСервер(Студент, Договор, ВидПриказа, Период)

	Результат = Новый Структура;

	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СведенияОСтудентахСрезПоследних.Период КАК Период,
	               |	ПоляПоПриказу.Студент КАК Студент,
	               |	ПоляПоПриказу.Поле КАК Поле,
	               |	ЕСТЬNULL(СведенияОСтудентахСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение,
	               |	ПоляПоПриказу.Договор КАК Договор
	               |ПОМЕСТИТЬ СрезПараметров
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		&Студент КАК Студент,
	               |		ВидыПриказовОбразованиеПоля.Поле КАК Поле,
	               |		&Договор КАК Договор
	               |	ИЗ
	               |		Справочник.ВидыПриказовОбразование.Поля КАК ВидыПриказовОбразованиеПоля
	               |	ГДЕ
	               |		ВидыПриказовОбразованиеПоля.Ссылка = &ВидПриказа
	               |		И ВидыПриказовОбразованиеПоля.ПоказыватьПредыдущееЗначение) КАК ПоляПоПриказу
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(&Период, ) КАК СведенияОСтудентахСрезПоследних
	               |		ПО ПоляПоПриказу.Студент = СведенияОСтудентахСрезПоследних.Студент
	               |			И ПоляПоПриказу.Поле = СведенияОСтудентахСрезПоследних.Поле
	               |			И ПоляПоПриказу.Договор = СведенияОСтудентахСрезПоследних.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СрезПараметров.Студент КАК Студент,
	               |	СрезПараметров.Поле КАК Поле,
	               |	СрезПараметров.Значение КАК Значение
	               |ИЗ
	               |	СрезПараметров КАК СрезПараметров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(СрезПараметров.Период) КАК Период,
	               |			СрезПараметров.Студент КАК Студент,
	               |			СрезПараметров.Договор КАК Договор
	               |		ИЗ
	               |			СрезПараметров КАК СрезПараметров
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СрезПараметров.Студент,
	               |			СрезПараметров.Договор) КАК СрезПоследних
	               |		ПО СрезПараметров.Студент = СрезПоследних.Студент
	               |			И СрезПараметров.Договор = СрезПоследних.Договор
	               |ГДЕ
	               |	СрезПараметров.Период = СрезПоследних.Период";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Студент", Студент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидПриказа", ВидПриказа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИмяКолонки = РаботаСоСтудентамиПовтИсп.ИмяКолонкиПоПолю(Выборка.Поле);
		Результат.Вставить("Предыдущее" + ИмяКолонки, Выборка.Значение);
		
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции // ПолучитьДанныеПоСтудентуСервер()

// Добавляет колонку на форму
//
// Параметры:
// Имя - Строка - имя колонки на форме
// Заголовок - Строка - заголовок колонки на форме
// ОбработчикПриИзменении - Строка - путь к обработчику поля ПриИзменении()
// ОбработчикНачалоВыбора - Строка - путь к обработчику поля НачалоВыбора()
// ЦветФона - Цвет - цвет фона поля 
// ЦветФонаЗаголовка - Цвет - цвет фона заголовка поля
//
// Возвращаемое значение:
// ПолеФормы
//
&НаСервере
Функция ДобавитьПолеФормы(Имя,
						 Заголовок = Неопределено,
						 ОбработчикПриИзменении = "",
						 ОбработчикНачалоВыбора = "",
						 ШиринаПоля = 0,
						 ЦветФона = Неопределено,
						 ЦветФонаЗаголовка = Неопределено,
						 Родитель = Неопределено,
						 КартинкаШапки = Неопределено,
						 ПутьКДанным = Неопределено,
						 ТолькоПросмотрПоля = Ложь,
						 СвязиПараметровВыбора = Неопределено)
	
	НовоеПоле                     = Элементы.Добавить("ТаблицаСтудентов" + Имя, Тип("ПолеФормы"), ?(Родитель = Неопределено, Элементы.ТаблицаСтудентов, Родитель));
	НовоеПоле.ПутьКДанным         = ?(ЗначениеЗаполнено(ПутьКДанным), ПутьКДанным, "ТаблицаСтудентов." + Имя);
	НовоеПоле.Заголовок           = ?(ЗначениеЗаполнено(Заголовок), Заголовок, Имя);
	НовоеПоле.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	НовоеПоле.Вид                 = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ТолькоПросмотр      = ТолькоПросмотрПоля;
	НовоеПоле.Ширина              = ШиринаПоля;
	
	Если СвязиПараметровВыбора <> Неопределено Тогда
		НовоеПоле.СвязиПараметровВыбора = СвязиПараметровВыбора;
	КонецЕсли;
	
	Если ЦветФонаЗаголовка <> Неопределено Тогда
		НовоеПоле.ЦветФонаЗаголовка = ЦветФонаЗаголовка;
	КонецЕсли;
	
	Если ЦветФона <> Неопределено Тогда
		НовоеПоле.ЦветФона = ЦветФона;
	КонецЕсли;
		
	Если КартинкаШапки <> Неопределено Тогда
		НовоеПоле.КартинкаШапки = КартинкаШапки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ОбработчикПриИзменении) Тогда
		НовоеПоле.УстановитьДействие("ПриИзменении", ОбработчикПриИзменении);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбработчикНачалоВыбора) Тогда
		НовоеПоле.УстановитьДействие("НачалоВыбора", ОбработчикНачалоВыбора);
	КонецЕсли;
	
	Возврат НовоеПоле;
	
КонецФункции

// Добавляет колонку на форму
//
// Параметры:
// Имя - Строка - имя колонки на форме
// Заголовок - Строка - заголовок колонки на форме
// ОбработчикПриИзменении - Строка - путь к обработчику поля ПриИзменении()
// ОбработчикНачалоВыбора - Строка - путь к обработчику поля НачалоВыбора()
// ЦветФона - Цвет - цвет фона поля 
// ЦветФонаЗаголовка - Цвет - цвет фона заголовка поля
//
// Возвращаемое значение:
// ПолеФормы
//
&НаСервере
Функция ДобавитьГруппуФормы(Имя, Заголовок = Неопределено, ОтображатьВШапке = Ложь, КартинкаШапки = Неопределено, ГруппировкаКолонок, Родитель = Неопределено)
	
	НоваяГруппа                  = Элементы.Добавить("ТаблицаСтудентов" + Имя, Тип("ГруппаФормы"), ?(Родитель = Неопределено, Элементы.ТаблицаСтудентов, Родитель));
	НоваяГруппа.Заголовок        = ?(ЗначениеЗаполнено(Заголовок), Заголовок, Имя);
	НоваяГруппа.Вид              = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппа.Группировка      = ГруппировкаКолонок;
	НоваяГруппа.ОтображатьВШапке = ОтображатьВШапке;
	
	Если ОтображатьВШапке И КартинкаШапки <> Неопределено Тогда
		НоваяГруппа.КартинкаШапки = КартинкаШапки;
	КонецЕсли;
	
	Возврат НоваяГруппа;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДокумент()
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);
	
	Если Не ДопУслуга Тогда
		ПостроитьТаблицуСтудентов();
		ЗагрузитьТабличнуюЧастьСтуденты();
		УстановитьПредупреждение();
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредыдущиеЗначенияПолей()
	
	ТаблицаСтудентовРеквизит = ТаблицаСтудентов.Выгрузить(, "Студент, Договор");
	ОбщегоНазначенияБГУ.ПронумероватьТаблицуЗначений(ТаблицаСтудентовРеквизит, "Индекс");
	
	Запрос = Новый Запрос;
	ТекстЗапрос = "ВЫБРАТЬ
	              |	ПриказыСтуденты.Индекс КАК Индекс,
	              |	ПриказыСтуденты.Студент КАК Студент,
	              |	ПриказыСтуденты.Договор КАК Договор
	              |ПОМЕСТИТЬ ВТСтуденты
	              |ИЗ
	              |	&ТаблицаСтуденты КАК ПриказыСтуденты
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	СписокСтудентов.Индекс КАК Индекс,
	              |	СписокСтудентов.Студент КАК Студент,
	              |	СписокСтудентов.Договор КАК Договор,
	              |	ВидыПриказовОбразованиеПоля.Поле КАК Поле
	              |ПОМЕСТИТЬ ВТПредПоля
	              |ИЗ
	              |	(ВЫБРАТЬ
	              |		ВТСтуденты.Индекс КАК Индекс,
	              |		ВТСтуденты.Студент КАК Студент,
	              |		ВТСтуденты.Договор КАК Договор
	              |	ИЗ
	              |		ВТСтуденты КАК ВТСтуденты
	              |	
	              |	СГРУППИРОВАТЬ ПО
	              |		ВТСтуденты.Индекс,
	              |		ВТСтуденты.Студент,
	              |		ВТСтуденты.Договор) КАК СписокСтудентов,
	              |	Справочник.ВидыПриказовОбразование.Поля КАК ВидыПриказовОбразованиеПоля
	              |ГДЕ
	              |	ВидыПриказовОбразованиеПоля.Ссылка = &ВидПриказа
	              |	И ВидыПриказовОбразованиеПоля.ПоказыватьПредыдущееЗначение
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТПредПоля.Индекс КАК Индекс,
	              |	ВТПредПоля.Студент КАК Студент,
	              |	ВТПредПоля.Договор КАК Договор,
	              |	ВТПредПоля.Поле КАК Поле,
	              |	ЕСТЬNULL(СведенияОСтудентахСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	              |ИЗ
	              |	ВТПредПоля КАК ВТПредПоля
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(&Период, ) КАК СведенияОСтудентахСрезПоследних
	              |		ПО ВТПредПоля.Студент = СведенияОСтудентахСрезПоследних.Студент
	              |			И ВТПредПоля.Поле = СведенияОСтудентахСрезПоследних.Поле
	              |			И ВТПредПоля.Договор = СведенияОСтудентахСрезПоследних.Договор
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Индекс
	              |ИТОГИ ПО
	              |	Студент";
	Запрос.Текст = ТекстЗапрос;                
	Запрос.УстановитьПараметр("ТаблицаСтуденты", ТаблицаСтудентовРеквизит);
	Запрос.УстановитьПараметр("ВидПриказа", Объект.ВидПриказа);
	Запрос.УстановитьПараметр("Период", РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(Объект) - 1);
	
	ВыборкаСтуденты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтуденты.Следующий() Цикл
		
		ВыборкаПоля = ВыборкаСтуденты.Выбрать();
		Пока ВыборкаПоля.Следующий() Цикл
			
			СтрокаСтудента = ТаблицаСтудентов[ВыборкаПоля.Индекс];
			ИмяКолонки = РаботаСоСтудентамиПовтИсп.ИмяКолонкиПоПолю(ВыборкаПоля.Поле);
			СтрокаСтудента["Предыдущее" + ИмяКолонки] = ВыборкаПоля.Значение;	
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличнуюЧастьСтуденты()
	
	ТаблицаСтудентовОбъект = Объект.Студенты.Выгрузить();
	ОбщегоНазначенияБГУ.ПронумероватьТаблицуЗначений(ТаблицаСтудентовОбъект, "Индекс");
	
	Запрос = Новый Запрос;
	ТекстЗапрос = "ВЫБРАТЬ
	              |	ПриказыСтуденты.Индекс КАК Индекс,
	              |	ПриказыСтуденты.Студент КАК Студент,
	              |	ПриказыСтуденты.Договор КАК Договор,
	              |	ПриказыСтуденты.Поле КАК Поле,
	              |	ПриказыСтуденты.Значение КАК Значение
	              |ПОМЕСТИТЬ ВТСтуденты
	              |ИЗ
	              |	&ТаблицаСтуденты КАК ПриказыСтуденты
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	СписокСтудентов.Индекс КАК Индекс,
	              |	СписокСтудентов.Студент КАК Студент,
	              |	СписокСтудентов.Договор КАК Договор,
	              |	ВидыПриказовОбразованиеПоля.Поле КАК Поле
	              |ПОМЕСТИТЬ ВТПредПоля
	              |ИЗ
	              |	(ВЫБРАТЬ
	              |		ВТСтуденты.Индекс КАК Индекс,
	              |		ВТСтуденты.Студент КАК Студент,
	              |		ВТСтуденты.Договор КАК Договор
	              |	ИЗ
	              |		ВТСтуденты КАК ВТСтуденты
	              |	
	              |	СГРУППИРОВАТЬ ПО
	              |		ВТСтуденты.Индекс,
	              |		ВТСтуденты.Студент,
	              |		ВТСтуденты.Договор) КАК СписокСтудентов,
	              |	Справочник.ВидыПриказовОбразование.Поля КАК ВидыПриказовОбразованиеПоля
	              |ГДЕ
	              |	ВидыПриказовОбразованиеПоля.Ссылка = &ВидПриказа
	              |	И ВидыПриказовОбразованиеПоля.ПоказыватьПредыдущееЗначение
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТПредПоля.Индекс КАК Индекс,
	              |	ВТПредПоля.Студент КАК Студент,
	              |	ВТПредПоля.Договор КАК Договор,
	              |	ВТПредПоля.Поле КАК Поле,
	              |	ЕСТЬNULL(СведенияОСтудентахСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	              |ПОМЕСТИТЬ ВТСтудентыПредПоля
	              |ИЗ
	              |	ВТПредПоля КАК ВТПредПоля
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(&Период, Факультет = &Факультет) КАК СведенияОСтудентахСрезПоследних
	              |		ПО ВТПредПоля.Студент = СведенияОСтудентахСрезПоследних.Студент
	              |			И ВТПредПоля.Поле = СведенияОСтудентахСрезПоследних.Поле
	              |			И ВТПредПоля.Договор = СведенияОСтудентахСрезПоследних.Договор
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТСтуденты.Индекс КАК Индекс,
	              |	ВТСтуденты.Студент КАК Студент,
	              |	ВТСтуденты.Договор КАК Договор,
	              |	ВТСтуденты.Поле КАК Поле,
	              |	ВТСтуденты.Значение КАК Значение,
	              |	ИСТИНА КАК ЗаполняемоеПоле,
	              |	ЛОЖЬ КАК ПредыдущееЗначение
	              |ПОМЕСТИТЬ ВТСтудентыВсеПоля
	              |ИЗ
	              |	ВТСтуденты КАК ВТСтуденты
	              |
	              |ОБЪЕДИНИТЬ ВСЕ
	              |
	              |ВЫБРАТЬ
	              |	ВТСтудентыПредПоля.Индекс,
	              |	ВТСтудентыПредПоля.Студент,
	              |	ВТСтудентыПредПоля.Договор,
	              |	ВТСтудентыПредПоля.Поле,
	              |	ВТСтудентыПредПоля.Значение,
	              |	ЛОЖЬ,
	              |	ИСТИНА
	              |ИЗ
	              |	ВТСтудентыПредПоля КАК ВТСтудентыПредПоля
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТСтудентыВсеПоля.Индекс КАК Индекс,
	              |	ВТСтудентыВсеПоля.Студент КАК Студент,
	              |	ВТСтудентыВсеПоля.Договор КАК Договор,
	              |	ВТСтудентыВсеПоля.Поле КАК Поле,
	              |	ВТСтудентыВсеПоля.Значение КАК Значение,
	              |	ВТСтудентыВсеПоля.ЗаполняемоеПоле КАК ЗаполняемоеПоле,
	              |	ВТСтудентыВсеПоля.ПредыдущееЗначение КАК ПредыдущееЗначение
	              |ИЗ
	              |	ВТСтудентыВсеПоля КАК ВТСтудентыВсеПоля
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Индекс
	              |ИТОГИ ПО
	              |	Студент,
	              |	Договор";
	Запрос.Текст = ТекстЗапрос;                
	Запрос.УстановитьПараметр("ТаблицаСтуденты", ТаблицаСтудентовОбъект);
	Запрос.УстановитьПараметр("ВидПриказа", Объект.ВидПриказа);
	Запрос.УстановитьПараметр("Период", РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(Объект) - 1);
	Запрос.УстановитьПараметр("Факультет", Объект.Факультет);
	
	ВыборкаСтуденты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтуденты.Следующий() Цикл
		ВыборкаДоговоры = ВыборкаСтуденты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДоговоры.Следующий() Цикл
			
			СтрокаСтудента = ТаблицаСтудентов.Добавить();
			СтрокаСтудента.Студент = ВыборкаДоговоры.Студент;
			СтрокаСтудента.Договор = ВыборкаДоговоры.Договор;
			
			ВыборкаПоля = ВыборкаДоговоры.Выбрать();
			
			Пока ВыборкаПоля.Следующий() Цикл
				
				ИмяКолонки = РаботаСоСтудентамиПовтИсп.ИмяКолонкиПоПолю(ВыборкаПоля.Поле);
				
				Если ВыборкаПоля.ЗаполняемоеПоле И СтрокаСтудента.Свойство(ИмяКолонки) Тогда
					
					СтрокаСтудента[ИмяКолонки] = ВыборкаПоля.Значение;	
					
				ИначеЕсли ВыборкаПоля.ПредыдущееЗначение Тогда
					
					СтрокаСтудента["Предыдущее" + ИмяКолонки] = ВыборкаПоля.Значение;	
				
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЦикла; 
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыФормы(ПоляПоВиду)
	
	ДобавляемыеКолонкиТаблицы = Новый Массив;
	УдаляемыеКолонкиТаблицы = Новый Массив;
	УдаляемыеЭлементы = Новый Массив;
	
	ТаблицаЗначений = СоздатьПустуюТаблицуСтудентов();
	
	Для Каждого Поле Из ПоляПоВиду Цикл                                    
		                                  
		Если Поле.Заполнять Тогда
			ТаблицаЗначений.Колонки.Добавить(Поле.ИмяКолонки, Поле.ТипЗначения, Поле.Заголовок);
		КонецЕсли; 
		
		Если Поле.ПоказыватьПредыдущееЗначение Тогда
			ТаблицаЗначений.Колонки.Добавить("Предыдущее" + Поле.ИмяКолонки, Поле.ТипЗначения, Поле.Заголовок);
		КонецЕсли; 
			
	КонецЦикла;	
	
	РеквизитыТаблицы = ПолучитьРеквизиты("ТаблицаСтудентов");
	Для Каждого Реквизит Из РеквизитыТаблицы Цикл
		Если Найти(Реквизит.Имя, "Поле") Тогда
			УдаляемыеКолонкиТаблицы.Добавить("ТаблицаСтудентов." + Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если Найти(Колонка.Имя, "Поле") Тогда
			УдаляемаяКолонка = УдаляемыеКолонкиТаблицы.Найти("ТаблицаСтудентов." + Колонка.Имя);
			Если УдаляемаяКолонка <> Неопределено Тогда
				УдаляемыеКолонкиТаблицы.Удалить(УдаляемаяКолонка);
			Иначе
				ДобавляемыеКолонкиТаблицы.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ТаблицаСтудентов", Колонка.Заголовок, Истина));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если УдаляемыеКолонкиТаблицы.Количество() > 0 Или ДобавляемыеКолонкиТаблицы.Количество() > 0 Тогда
		ИзменитьРеквизиты(ДобавляемыеКолонкиТаблицы, УдаляемыеКолонкиТаблицы);
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из Элементы.ТаблицаСтудентов.ПодчиненныеЭлементы Цикл
		Если Найти(ТекЭлемент.Имя, "Поле") Тогда
			УдаляемыеЭлементы.Добавить(ТекЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;

	ТаблицаСтудентовЗначение = РеквизитФормыВЗначение("ТаблицаСтудентов");
	МассивУдаляемыхКолонок = Новый Массив;
	
	Для каждого КолонкаТаблицы Из ТаблицаСтудентовЗначение.Колонки Цикл
		
		Если КолонкаТаблицы.Имя <> "Студент" И КолонкаТаблицы.Имя <> "Договор" Тогда
			МассивУдаляемыхКолонок.Добавить(КолонкаТаблицы)
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого Колонка Из МассивУдаляемыхКолонок Цикл
		ТаблицаСтудентовЗначение.Колонки.Удалить(Колонка);
	КонецЦикла; 
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		
		Если Колонка.Имя <> "Студент" И Колонка.Имя <> "Договор" Тогда
			ТаблицаСтудентовЗначение.Колонки.Добавить(Колонка.Имя);	
		КонецЕсли; 
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаСтудентовЗначение, "ТаблицаСтудентов");
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьУсловноеОформление()
	
	УсловныеОформления = Новый Массив;
	
	Для Каждого Оформление Из ЭтаФорма.УсловноеОформление.Элементы Цикл
		Если Оформление.Представление = "СозданоПрограммно" Тогда
			УсловныеОформления.Добавить(Оформление);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Оформление Из УсловныеОформления Цикл
		УсловноеОформление.Элементы.Удалить(Оформление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормыСписка(ПоляПоВиду)
	
	Для каждого Поле Из ПоляПоВиду Цикл
		
		ГруппаПоля = ДобавитьГруппуФормы("ГруппаПоля" + Поле.ИмяКолонки,,,, ГруппировкаКолонок.Вертикальная);
		
		Если Поле.ПоказыватьПредыдущееЗначение Тогда
			
			НовоеПоле = ДобавитьПолеФормы("Предыдущее" + Поле.ИмяКолонки, Поле.Заголовок + " (пред.)",,,,,, ГруппаПоля,,, Истина);		
			НовоеПоле.ЦветТекста = WebЦвета.НейтральноСерый;
			
			НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
			НовыйЭлементУО.ИдентификаторПользовательскойНастройки = "Предыдущее" + Поле.ИмяКолонки;
			НовыйЭлементУО.Представление = "СозданоПрограммно";
			НовыйЭлементУО.Использование = Истина;
			
			ЭлементОтбора = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаСтудентов.Предыдущее" + Поле.ИмяКолонки);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
			
			НовоеПолеУО = НовыйЭлементУО.Поля.Элементы.Добавить();
			НовоеПолеУО.Использование = Истина;
			НовоеПолеУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСтудентовПредыдущее" + Поле.ИмяКолонки);
			
			НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<пустое значение>");
			
		КонецЕсли; 
		
		Если Поле.Заполнять Тогда
						
			НовоеПоле = ДобавитьПолеФормы(Поле.ИмяКолонки, Поле.Заголовок,,,,,, ГруппаПоля);
			НовоеПоле.БыстрыйВыбор = Ложь;
			
			Если Поле.ТипЗначения.СодержитТип(Тип("СправочникСсылка.СтавкиОплатыОбразование")) Тогда
				
				ПараметрыВыбораЗначения = Новый Массив;
				ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("ВыбиратьСОграничением", Истина));
				ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Период", РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(Объект)));
				НовоеПоле.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
				
			ИначеЕсли Поле.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ГруппыСтудентов")) Тогда
				
				// Зададим УО для поля
				НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
				НовыйЭлементУО.ИдентификаторПользовательскойНастройки = Поле.ИмяКолонки;
				НовыйЭлементУО.Представление = "СозданоПрограммно";
				НовыйЭлементУО.Использование = Истина;

				ЭлементОтбора = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Факультет");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				
				НовоеПолеУО = НовыйЭлементУО.Поля.Элементы.Добавить();
				НовоеПолеУО.Использование = Истина;
				НовоеПолеУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСтудентов" + Поле.ИмяКолонки);
				
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<Выберите факультет>");
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
				
				// Укажим параметры выбора
				Связь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Факультет");
				Связи = Новый Массив;
				Связи.Добавить(Связь);
				НовоеПоле.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
				
			ИначеЕсли Поле.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияПолейПриказов")) Тогда
				
				ПараметрыВыбораЗначения = Новый Массив;
				ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Поле.Поле));
				НовоеПоле.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
			
			КонецЕсли;
			
			Если Поле.ЗаполнениеОбязательно Тогда
				
				НовоеПоле.АвтоОтметкаНезаполненного = Истина;
				
			Иначе
				
				НовоеПоле.АвтоОтметкаНезаполненного = Ложь;
				
				НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
				НовыйЭлементУО.ИдентификаторПользовательскойНастройки = Поле.ИмяКолонки;
				НовыйЭлементУО.Представление = "СозданоПрограммно";
				НовыйЭлементУО.Использование = Истина;
				
				ЭлементОтбора = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаСтудентов." + Поле.ИмяКолонки);
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				
				НовоеПолеУО = НовыйЭлементУО.Поля.Элементы.Добавить();
				НовоеПолеУО.Использование = Истина;
				НовоеПолеУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСтудентов" + Поле.ИмяКолонки);
				
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<пустое значение>");
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.НейтральноСерый);
			
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьТаблицуСтудентов()
	
	ПоляПоВиду = ПолучитьПоляПоВиду(Объект.ВидПриказа);
	
	СоздатьРеквизитыФормы(ПоляПоВиду);
	ОчиститьУсловноеОформление();
	СоздатьЭлементыФормыСписка(ПоляПоВиду); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
	
	ЕстьПолеГруппы = Справочники.ВидыПриказовОбразование.ЕстьПолеПоВидуПриказа(Объект.ВидПриказа, ПланыВидовХарактеристик.ПоляПриказовОбразование.Группа);
	
	Если ТаблицаСтудентов.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;	
		Элементы.ВидПриказа.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;	
		
		Если ЕстьПолеГруппы Тогда
			ТекстПредупреждения = НСтр("ru='При изменении факультета будет выполнена очистка групп учащихся и рекомендуется проверить корректность заполнения списка'");
		Иначе
			ТекстПредупреждения = НСтр("ru='При изменении факультета рекомендуется проверить корректность заполнения списка учащихся'");
		КонецЕсли; 
		Элементы.Факультет.ПредупреждениеПриРедактировании = ТекстПредупреждения;
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		Элементы.ВидПриказа.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьСтудентовВТабличнуюЧасть(ТекущийОбъект, ПараметрыЗаписи, Отказ)
	
	ТекущийОбъект.Студенты.Очистить();
	ПоляВида = ПолучитьПоляПоВиду(ТекущийОбъект.ВидПриказа);
	СтудентНеУказанДляПроведения = Ложь;
	НомерСтроки = 1;
	
	// Если приказ формирует записи по изменению состояния учащихся, требуется дополнительная проверка заполнения договора.
	// В случае приказа по начислению компенсации или фомированию прочих записей в регистр сведений об учащемся, 
	// и договор на обучение у учащегося в этом случае может отсутствовать.
	ПроверятьДоговор = Ложь;
	Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.ВидПриказа, "СостояниеСтудента")) Тогда
		ПроверятьДоговор = Истина;
	КонецЕсли;
		
	Для каждого СтрокаСтудент Из ТаблицаСтудентов Цикл
		
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Если СтрокаСтудент.Студент.Пустая() Тогда
				СтудентНеУказанДляПроведения = Истина;
				
				ТекстОшибки = НСтр("ru='В строке ""%1"" не указано значение поля ""Студент""'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НомерСтроки);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки,
					Объект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Студент"),
					,
					Отказ
				);
			КонецЕсли;
			
			Если ПроверятьДоговор И СтрокаСтудент.Договор.Пустая() Тогда
				ТекстОшибки = НСтр("ru='В строке ""%1"" не указано значение поля ""Договор"". Для приказов с изменением состояния учащегося необходимо указание договора расчетов.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НомерСтроки);
				//Предупреждение выводим, но без отказа в проведении. HL-746900
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки,
					Объект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Договор"),
					,);
			КонецЕсли;
				
		КонецЕсли;
		
		ПерваяСтрока = Истина;
		
		НоваяСтрока = ТекущийОбъект.Студенты.Добавить();
		НоваяСтрока.Студент = СтрокаСтудент.Студент;
		НоваяСтрока.Договор = СтрокаСтудент.Договор;
				
		Для каждого Поле Из ПоляВида Цикл
				
			Если Поле.Заполнять Тогда
				
				Если ПерваяСтрока Тогда
					
					ПерваяСтрока = Ложь;
					
				Иначе
					
					НоваяСтрока = ТекущийОбъект.Студенты.Добавить();
					НоваяСтрока.Студент = СтрокаСтудент.Студент;
					НоваяСтрока.Договор = СтрокаСтудент.Договор;
					
				КонецЕсли; 
		
				Если НЕ Поле.ЗаполнениеОбязательно ИЛИ ЗначениеЗаполнено(СтрокаСтудент[Поле.ИмяКолонки]) Тогда
					
					НоваяСтрока.Поле = Поле.Поле;
					НоваяСтрока.Значение = СтрокаСтудент[Поле.ИмяКолонки];
					
				Иначе
					
					Если СтудентНеУказанДляПроведения Тогда
						
						ТекстОшибки = НСтр("ru='В строке №%1 не указано значение поля """ + Поле.Заголовок+ """'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НомерСтроки);
						
					Иначе        
						
						ТекстОшибки = НСтр("ru='Для студента ""%1"" в строке №%2 не указано значение поля """ + Поле.Заголовок+ """'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаСтудент.Студент, НомерСтроки);
						
					КонецЕсли; 
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстОшибки,
						Объект.Ссылка,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, Поле.ИмяКолонки),
						,
						Отказ
					);
					
				КонецЕсли; 
			
			КонецЕсли; 
			
		КонецЦикла; 
		
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтудентамиСервер(Адреса)
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);	
	
	ПериодПриказа = РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(Объект) - 1;
	ДанныеОтчета = РаботаСоСтудентами.ПолучитьДанныеПодбораУчащихся(Адреса, Объект.Организация, Объект.Факультет, ПериодПриказа);
	
	ТабЧасть = ?(ДопУслуга, Объект.СтудентыДопУслуги, ТаблицаСтудентов);
	
	ДанныеОтчетаСДоговорами = ДополнитьДанныеОтчетаДоговорами(ДанныеОтчета);
	
	Для каждого СтрокаДанных Из ДанныеОтчетаСДоговорами Цикл
		
		НоваяСтрока = ТабЧасть.Добавить();
		НоваяСтрока.Студент = СтрокаДанных.Студент;
		НоваяСтрока.Договор = СтрокаДанных.Договор;
		
		Если ДопУслуга Тогда
			НоваяСтрока.НачислениеСтудентамЗаПрочиеУслуги = ДопУслугаПоВидуПриказа(Объект.ВидПриказа);
			НоваяСтрока.Плательщик = СтрокаДанных.Контрагент;
			НоваяСтрока.НачалоНачисления = Объект.ДатаНачалаДействия;
			НоваяСтрока.ОкончаниеНачисления = Объект.ДатаОкончанияДействия;
			ЗаполнитьПоясняющиеНадписи(НоваяСтрока);
		КонецЕсли;
	КонецЦикла; 
	
	Если Не ДопУслуга Тогда
		ЗаполнитьПредыдущиеЗначенияПолей();
	КонецЕсли;
	
	УстановитьПредупреждение();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаПоУчащемусяСервер(Студент) 
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Студент, "Контрагент");
	
КонецФункции

&НаСервере
Функция ДополнитьДанныеОтчетаДоговорами(ДанныеОтчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеОтчета.Студент КАК Студент
		|ПОМЕСТИТЬ ДанныеОтчета
		|ИЗ
		|	&ДанныеОтчета КАК ДанныеОтчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Студент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Студенты.Ссылка КАК Студент,
		|	Студенты.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ ДанныеСтуденты
		|ИЗ
		|	ДанныеОтчета КАК ДанныеОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Студенты КАК Студенты
		|		ПО ДанныеОтчета.Студент = Студенты.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеСтуденты.Студент КАК Студент,
		|	ДанныеСтуденты.Контрагент КАК Контрагент,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Договоры.Ссылка) КАК КоличествоДоговоров
		|ПОМЕСТИТЬ СтудентыПоКоличествуДоговоров
		|ИЗ
		|	ДанныеСтуденты КАК ДанныеСтуденты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО ДанныеСтуденты.Контрагент = Договоры.Контрагент
		|ГДЕ
		|	Договоры.ПометкаУдаления = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеСтуденты.Студент,
		|	ДанныеСтуденты.Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтудентыПоКоличествуДоговоров.Студент КАК Студент,
		|	Договоры.Ссылка КАК Договор
		|ПОМЕСТИТЬ СтудентыСДоговором
		|ИЗ
		|	СтудентыПоКоличествуДоговоров КАК СтудентыПоКоличествуДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО СтудентыПоКоличествуДоговоров.Контрагент = Договоры.Контрагент
		|ГДЕ
		|	СтудентыПоКоличествуДоговоров.КоличествоДоговоров = 1
		|	И Договоры.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеСтуденты.Студент КАК Студент,
		|	СведенияОСтудентахСрезПоследних.Договор КАК Договор
		|ПОМЕСТИТЬ ДоговорыПоСведениям
		|ИЗ
		|	ДанныеСтуденты КАК ДанныеСтуденты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(
		|				&НаДату,
		|				Студент В
		|						(ВЫБРАТЬ
		|							ДанныеСтуденты.Студент
		|						ИЗ
		|							ДанныеСтуденты КАК ДанныеСтуденты)
		|					И Факультет = &Факультет
		|					И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
		|					И Значение В (&СостояниеЗачислен)) КАК СведенияОСтудентахСрезПоследних
		|		ПО ДанныеСтуденты.Студент = СведенияОСтудентахСрезПоследних.Студент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыПоСведениям.Студент КАК Студент,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДоговорыПоСведениям.Договор) КАК КоличествоДоговоров
		|ПОМЕСТИТЬ ДоговорыПоСведениямКоличество
		|ИЗ
		|	ДоговорыПоСведениям КАК ДоговорыПоСведениям
		|
		|СГРУППИРОВАТЬ ПО
		|	ДоговорыПоСведениям.Студент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыПоСведениямКоличество.Студент КАК Студент,
		|	ДоговорыПоСведениям.Договор КАК Договор
		|ПОМЕСТИТЬ СтудентыОдинЗарегДоговор
		|ИЗ
		|	ДоговорыПоСведениямКоличество КАК ДоговорыПоСведениямКоличество
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДоговорыПоСведениям КАК ДоговорыПоСведениям
		|		ПО ДоговорыПоСведениямКоличество.Студент = ДоговорыПоСведениям.Студент
		|ГДЕ
		|	ДоговорыПоСведениямКоличество.КоличествоДоговоров = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеСтуденты.Студент КАК Студент,
		|	ЕСТЬNULL(СтудентыОдинЗарегДоговор.Договор, ЕСТЬNULL(СтудентыСДоговором.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка))) КАК Договор
		|ПОМЕСТИТЬ СтудентыИДоговорыИтог
		|ИЗ
		|	ДанныеСтуденты КАК ДанныеСтуденты
		|		ЛЕВОЕ СОЕДИНЕНИЕ СтудентыСДоговором КАК СтудентыСДоговором
		|		ПО ДанныеСтуденты.Студент = СтудентыСДоговором.Студент
		|		ЛЕВОЕ СОЕДИНЕНИЕ СтудентыОдинЗарегДоговор КАК СтудентыОдинЗарегДоговор
		|		ПО ДанныеСтуденты.Студент = СтудентыОдинЗарегДоговор.Студент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтудентыИДоговорыИтог.Студент КАК Студент,
		|	СтудентыИДоговорыИтог.Договор КАК Договор,
		|	СтудентыИДоговорыИтог.Договор.Контрагент КАК Контрагент
		|ИЗ
		|	СтудентыИДоговорыИтог КАК СтудентыИДоговорыИтог";
	
	Запрос.УстановитьПараметр("ДанныеОтчета", ДанныеОтчета);
	Запрос.УстановитьПараметр("СостояниеЗачислен", РаботаСоСтудентамиПовтИсп.ПолучитьСостоянияПоВидуДействия(Истина));
	Запрос.УстановитьПараметр("Факультет", Объект.Факультет);
	Запрос.УстановитьПараметр("НаДату", Объект.ДатаНачалаДействия);	
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеОтчетаСДоговорами = РезультатЗапроса.Выгрузить();
	
	Возврат ДанныеОтчетаСДоговорами;
		
КонецФункции

&НаСервере
Процедура ПроверитьДублиСтрок(Отказ)
	
	ТаблицаСтудентовОбъект = ТаблицаСтудентов.Выгрузить();
	ОбщегоНазначенияБГУ.ПронумероватьТаблицуЗначений(ТаблицаСтудентовОбъект, "Индекс");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаСтудентов.Индекс,
	               |	ТаблицаСтудентов.Студент,
	               |	ТаблицаСтудентов.Договор
	               |ПОМЕСТИТЬ ТаблицаСтудентов
	               |ИЗ
	               |	&ТаблицаСтудентов КАК ТаблицаСтудентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ТаблицаСтудентов.Индекс) КАК Индекс,
	               |	ТаблицаСтудентов.Студент,
	               |	ТаблицаСтудентов.Договор
	               |ИЗ
	               |	ТаблицаСтудентов КАК ТаблицаСтудентов
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаСтудентов.Студент,
	               |	ТаблицаСтудентов.Договор
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(*) > 1";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСтудентов", ТаблицаСтудентовОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстОшибки = "";
	ТекстОшибки = НСтр("ru = 'Студент %1 и договор %2 повторяется в табличной части приказа'");	
	
	Пока Выборка.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.Студент, Выборка.Договор),
				Объект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", Выборка.Индекс + 1, "Студент"),
				,
				Отказ
		);
			
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьФакультета()

	Элементы.Факультет.Доступность = ЗначениеЗаполнено(Объект.Организация);	

КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимостьЗакладокСтраниц()

	Если Элементы.Страницы.ПодчиненныеЭлементы.Количество()>0 Тогда
		Элементы.Страницы.ОтображениеСтраниц=ОтображениеСтраницФормы.ЗакладкиСверху;
	Иначе
		Элементы.Страницы.ОтображениеСтраниц=ОтображениеСтраницФормы.Нет;
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьЗакладокСтраниц()

&НаСервереБезКонтекста
Функция СтудентЯвляетсяГруппой(ВыбранноеЗначение)
	
	Возврат ОбщегоНазначения.ОбъектЯвляетсяГруппой(ВыбранноеЗначение);
	
КонецФункции

