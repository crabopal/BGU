&НаКлиенте
Процедура ЗаполнитьСтудентами(Команда)
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);
	
	Если ДопУслуга Тогда
		ТабЧасть = Объект.СтудентыДопУслуги;
	Иначе
		ТабЧасть = ТаблицаСтудентов;
	КонецЕсли;
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Объект.Организация.Пустая() Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Организация"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Организация", "Объект", Отказ);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Дата начала действия"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "ДатаНачалаДействия", "Объект", Отказ);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Факультет"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);
		
	КонецЕсли;

	Если НЕ Отказ Тогда
		Если ТабЧасть.Количество() > 0 Тогда
			
			ДопПараметры = Новый Структура("ТабЧасть,ИмяМакета", ТабЧасть, "Подбор");
			
			ТекстВопроса = НСтр("ru='Документ уже заполнен, выберите необходимое действие:'"); 
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить("Перезаполнить", "Перезаполнить документ");
			СписокКнопок.Добавить("Добавить", "Добавить по отбору");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
			
			Оповещение = Новый ОписаниеОповещения("ДействиеПередОтбором", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Отмена);
		Иначе
			ОткрытьФормуОтбора("Подбор", Истина);
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

