&НаКлиенте
Процедура ЗаполнитьСтудентамиЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Адреса = ДополнительныеПараметры.Адреса;
    
    
    Если Результат <> Неопределено Тогда
        
        Адреса.НастройкиКомпоновкиДанных = Результат;
        ЗаполнитьСтудентамиСервер(Адреса);
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКолонки(Команда)
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидПриказа", Объект.ВидПриказа);
	ПараметрыФормы.Вставить("Факультет", Объект.Факультет);	
	Значение = Неопределено;
	
	ОткрытьФорму("Документ.ПриказОбразование.Форма.ФормаЗаполнениеРеквизитов", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ЗаполнитьКолонкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКолонкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	ДопУслуга = ЭтоПриказНаДопУслугу(Объект.ВидПриказа);
	
	Если ДопУслуга Тогда
		ТаблицаЗаполнения = Объект.СтудентыДопУслуги;
	Иначе
		ТаблицаЗаполнения = ТаблицаСтудентов;
	КонецЕсли;
	
    Если Результат <> Неопределено Тогда
        
        Для каждого СтрокаТЧ Из ТаблицаЗаполнения Цикл
            
            Для каждого ЭлементЗначения Из Результат Цикл
				ИмяКолонки = ?(ДопУслуга, СтрЗаменить(ЭлементЗначения.Ключ, " ", ""), РаботаСоСтудентамиКлиентСервер.ИмяКолонкиПоПолю(ЭлементЗначения.Ключ));
				Если НРег(ИмяКолонки) = "дополнительнаяуслуга" Тогда
					ИмяКолонки = "НачислениеСтудентамЗаПрочиеУслуги";
				КонецЕсли;
				
                СтрокаТЧ[ИмяКолонки] = ЭлементЗначения.Значение;
                
            КонецЦикла; 	
            
		КонецЦикла; 
		
        Модифицированность = Истина;
		
    КонецЕсли;

КонецПроцедуры

