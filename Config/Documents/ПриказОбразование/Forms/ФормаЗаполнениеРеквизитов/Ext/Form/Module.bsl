
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Факультет = Параметры.Факультет;
	ПолеГруппа = ПланыВидовХарактеристик.ПоляПриказовОбразование.Группа;
	ТаблицаПолейПоВиду = Справочники.ВидыПриказовОбразование.ПолучитьПоляВида(Параметры.ВидПриказа);
	
	Для каждого СтрокаПоля Из ТаблицаПолейПоВиду Цикл
		
		Если СтрокаПоля.Заполнять Тогда
			
			НоваяСтрока = ТаблицаПолей.Добавить();
			НоваяСтрока.Поле = СтрокаПоля.Поле;
			Если НоваяСтрока.Поле = ПолеГруппа И Факультет.Пустая() Тогда
				НоваяСтрока.Текст = "Укажите факультет";
			КонецЕсли; 
		
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если ТаблицаПолей.Количество() = 0 Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНетПолей;
		Элементы.ФормаЗаполнитьДокумент.Доступность = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПолейЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Поле = Элементы.ТаблицаПолей.ТекущиеДанные.Поле;
	
	Если Поле = ПредопределенноеЗначение("ПланВидовХарактеристик.ПоляПриказовОбразование.Группа") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураОтбора = Новый Структура("Владелец", Факультет);
		ПараметрыФормы = Новый Структура("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.ГруппыСтудентов.ФормаВыбора", ПараметрыФормы, Элемент);
		
	ИначеЕсли ПолеИзЗначенияПолейПриказов(Поле) Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураОтбора = Новый Структура("Владелец", Поле);
		ПараметрыФормы = Новый Структура("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.ЗначенияПолейПриказов.ФормаВыбора", ПараметрыФормы, Элемент);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПолейЗначениеАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Поле = Элементы.ТаблицаПолей.ТекущиеДанные.Поле;
	
	Если Поле = ПредопределенноеЗначение("ПланВидовХарактеристик.ПоляПриказовОбразование.Группа") Тогда
		
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьДанныеВыбораГруппы(Факультет, Текст);
		
	ИначеЕсли ПолеИзЗначенияПолейПриказов(Поле) Тогда 
		
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьДанныеВыбораДопЗначения(Поле, Текст);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПолейЗначениеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Поле = Элементы.ТаблицаПолей.ТекущиеДанные.Поле;
	
	Если Поле = ПредопределенноеЗначение("ПланВидовХарактеристик.ПоляПриказовОбразование.Группа") Тогда
		
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьДанныеВыбораГруппы(Факультет, Текст);
		
	ИначеЕсли ПолеИзЗначенияПолейПриказов(Поле) Тогда 
		
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьДанныеВыбораДопЗначения(Поле, Текст);
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	СоответствиеПолей = Новый Соответствие;
	
	Для каждого СтрокаПоля Из ТаблицаПолей Цикл
		
		Если ЗначениеЗаполнено(СтрокаПоля.Значение) Тогда
			
			СоответствиеПолей[СтрокаПоля.Поле] = СтрокаПоля.Значение;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Закрыть(СоответствиеПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораГруппы(Факультет, Текст)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Владелец", Факультет); 
	
	ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыВыбораЗначения.Вставить("Отбор", СтруктураОтбора);

	Возврат Справочники.ГруппыСтудентов.ПолучитьДанныеВыбора(ПараметрыВыбораЗначения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораДопЗначения(ВладелецЗначения, Текст)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Владелец", ВладелецЗначения); 
	
	ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыВыбораЗначения.Вставить("Отбор", СтруктураОтбора);

	Возврат Справочники.ЗначенияПолейПриказов.ПолучитьДанныеВыбора(ПараметрыВыбораЗначения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолеИзЗначенияПолейПриказов(Поле)

	Возврат Поле.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияПолейПриказов"));

КонецФункции 

#КонецОбласти



