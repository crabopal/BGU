#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		
		ДатаНачалаДействия = ТекущаяДата();
		
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Студенты") Тогда
		
		ЗаполнитьПоСтуденту(ДанныеЗаполнения);
		
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("Студент")
			И ДанныеЗаполнения.Свойство("Договор")
			И ДанныеЗаполнения.Свойство("ВидПриказа") Тогда
			
			ЭтоПрочиеУслуги = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.ВидПриказа, "УправлениеДополнительнойУслугой") <> 0 );
			
			Если ДанныеЗаполнения.Свойство("ДатаНачалаДействия") Тогда
				ДатаНачалаДействия = ДанныеЗаполнения.ДатаНачалаДействия;
			КонецЕсли;
			
			Если ЭтоПрочиеУслуги Тогда
				Если ДанныеЗаполнения.Свойство("Факультет") Тогда
					ИспользоватьФакультетДокументаДопУслуги = Истина;
				КонецЕсли;					
					
				НоваяСтрока = СтудентыДопУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения, "Студент,Договор");
				Если ДанныеЗаполнения.Свойство("НачислениеСтудентамЗаПрочиеУслуги") Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения, "НачислениеСтудентамЗаПрочиеУслуги");
				Иначе
					НоваяСтрока.НачислениеСтудентамЗаПрочиеУслуги = РаботаСоСтудентамиПовтИсп.ДопУслугаПоВидуПриказа(ДанныеЗаполнения.ВидПриказа);
				КонецЕсли;
				
				НоваяСтрока.Плательщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Студент, "Контрагент");
				НоваяСтрока.ПорядокВыпискиСФ = Перечисления.ПорядокВыпискиСФЗаУслуги.Сводно;
				НоваяСтрока.НачалоНачисления = ДатаНачалаДействия;
												
			Иначе
				НоваяСтрока = Студенты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения, "Студент,Договор");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЭтоОсновнаяУслуга = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидПриказа, "УправлениеДополнительнойУслугой") = 0);
	
	Если ЭтоОсновнаяУслуга Тогда
		ПроверяемыеРеквизиты.Добавить("Факультет");
	ИначеЕсли ИспользоватьФакультетДокументаДопУслуги Тогда
		ПроверяемыеРеквизиты.Добавить("Факультет");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ДопУслуга = ЭтоПриказНаДопУслугу(ЭтотОбъект.ВидПриказа);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если Не ДопУслуга Тогда
		
			Запрос = Новый Запрос;
			ТекстЗапроса = "ВЫБРАТЬ
			               |	ТаблицаСтудентов.Студент КАК Студент,
			               |	ТаблицаСтудентов.Договор КАК Договор,
			               |	ТаблицаСтудентов.Поле КАК Поле,
			               |	ТаблицаСтудентов.Значение КАК Значение
			               |ПОМЕСТИТЬ ТаблицаСтудентовОбъекта
			               |ИЗ
			               |	&ТаблицаСтудентов КАК ТаблицаСтудентов
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ТаблицаСтудентов.Студент КАК Студент,
			               |	ТаблицаСтудентов.Договор КАК Договор,
			               |	ТаблицаСтудентов.Поле КАК Поле,
			               |	ТаблицаСтудентов.Значение КАК Значение
			               |ПОМЕСТИТЬ ТаблицаСтудентов
			               |ИЗ
			               |	ТаблицаСтудентовОбъекта КАК ТаблицаСтудентов
			               |ГДЕ
			               |	ТаблицаСтудентов.Поле <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.ПустаяСсылка)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	ТаблицаСтудентов.Студент,
			               |	ТаблицаСтудентов.Договор,
			               |	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента),
			               |	&СостояниеСтудента
			               |ИЗ
			               |	ТаблицаСтудентовОбъекта КАК ТаблицаСтудентов
			               |ГДЕ
			               |	&УчитыватьСостояние
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ТаблицаСтудентов.Студент,
			               |	ТаблицаСтудентов.Договор
			               |
			               |ИНДЕКСИРОВАТЬ ПО
			               |	Студент,
			               |	Поле
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ПРЕДСТАВЛЕНИЕССЫЛКИ(СведенияОСтудентах.Регистратор) КАК РегистраторПредставление,
			               |	ТаблицаСтудентов.Студент КАК Студент,
			               |	ТаблицаСтудентов.Договор КАК Договор,
			               |	ТаблицаСтудентов.Поле КАК Поле,
			               |	ТаблицаСтудентов.Значение КАК Значение,
			               |	СведенияОСтудентах.Значение КАК ЗначениеДействующее
			               |ИЗ
			               |	ТаблицаСтудентов КАК ТаблицаСтудентов
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
			               |		ПО ТаблицаСтудентов.Студент = СведенияОСтудентах.Студент
			               |			И ТаблицаСтудентов.Поле = СведенияОСтудентах.Поле
			               |			И ТаблицаСтудентов.Договор = СведенияОСтудентах.Договор
			               |ГДЕ
			               |	СведенияОСтудентах.Период = &Период
			               |	И СведенияОСтудентах.Факультет = &Факультет
			               |	И СведенияОСтудентах.Активность
			               |	И &УсловиеПоРегистратору";
						   
			Если ЭтоНовый() Тогда
				
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &УсловиеПоРегистратору", "");
				
			Иначе 
				
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &УсловиеПоРегистратору", "И СведенияОСтудентах.Регистратор <> &Регистратор");
				Запрос.УстановитьПараметр("Регистратор", Ссылка);
				
			КонецЕсли; 
			
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("ТаблицаСтудентов", Студенты.Выгрузить());
			Запрос.УстановитьПараметр("Период", РаботаСоСтудентамиКлиентСервер.ПолучитьПериодПриказа(ЭтотОбъект));
			Запрос.УстановитьПараметр("Факультет", Факультет);
			Запрос.УстановитьПараметр("СостояниеСтудента", РаботаСоСтудентамиПовтИсп.ПолучитьСостояниеПоВидуПриказа(ВидПриказа));
			Запрос.УстановитьПараметр("УчитыватьСостояние", (РаботаСоСтудентамиПовтИсп.ПолучитьСостояниеПоВидуПриказа(ВидПриказа) <> Справочники.СостоянияСтудентов.ПустаяСсылка())); 
			
			Выборка = Запрос.Выполнить().Выбрать();
			ТекстОшибки = НСтр("ru = 'Для студента ""%1"" свойство ""%2"" со значением ""%3"" не может быть установлено, т.к. документом ""%4"" на эту дату уже установлено значение ""%5""!'");	
			
			Пока Выборка.Следующий() Цикл
				
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										ТекстОшибки,
										Выборка.Студент, 
										Выборка.Поле,
										Выборка.Значение,
										Выборка.РегистраторПредставление,
										Выборка.ЗначениеДействующее
							);
//				ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект,,, Отказ);
				ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект,,, );
				
			КонецЦикла;
			
		Иначе
			
			ПроверитьЗаполнениеРеквизитовТабличнойЧасти(Отказ);
			
		КонецЕсли;
		
	КонецЕсли;  
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.ПриказОбразование.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СведенияОПрочихУслугахСтудентам");
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СведенияОСтудентах");
	РаботаСоСтудентами.ОтразитьНачисленияОбразованиеПоследовательность(ДополнительныеСвойства, ПринадлежностьПоследовательностям, Отказ);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоСтуденту(ДанныеЗаполнения)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СведенияОСтудентах.Факультет
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
	               |ГДЕ
	               |	СведенияОСтудентах.Студент = &Студент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СведенияОСтудентах.Период УБЫВ";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Студент", ДанныеЗаполнения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Факультет = Выборка.Факультет;
		
	КонецЦикла; 
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "Организация");
	КонтрагентСтудент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "Контрагент");
	
	НоваяСтрока = Студенты.Добавить();
	НоваяСтрока.Студент = ДанныеЗаполнения;
	
	// Если для студента по тому же контрагенту задан только один договор, сразу добавляем его в табличную часть.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Договор
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", КонтрагентСтудент);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НоваяСтрока.Договор = ВыборкаДетальныеЗаписи.Договор;
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Функция ЭтоПриказНаДопУслугу(ВидПриказа)
	Возврат (ВидПриказа.УправлениеДополнительнойУслугой = 1);
КонецФункции

Процедура ПроверитьЗаполнениеРеквизитовТабличнойЧасти(Отказ)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабЧасть.НомерСтроки,
	               |	ТабЧасть.Студент,
	               |	ТабЧасть.НачислениеСтудентамЗаПрочиеУслуги,
	               |	ТабЧасть.НачалоНачисления,
	               |	ТабЧасть.ОкончаниеНачисления,
	               |	ТабЧасть.Договор,
	               |	ТабЧасть.Льгота,
	               |	ТабЧасть.Плательщик,
	               |	ТабЧасть.ПорядокВыпискиСФ
	               |ПОМЕСТИТЬ ТабЧасть
	               |ИЗ
	               |	&ТабЧасть КАК ТабЧасть
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабЧасть.НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.Студент
	               |	КОНЕЦ КАК Учащийся,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.НачислениеСтудентамЗаПрочиеУслуги = ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.НачислениеСтудентамЗаПрочиеУслуги
	               |	КОНЕЦ КАК НачислениеЗаУслугу,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.НачалоНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.НачалоНачисления
	               |	КОНЕЦ КАК НачалоНачисления,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.Договор
	               |	КОНЕЦ КАК Договор,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.Плательщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.Плательщик
	               |	КОНЕЦ КАК Плательщик
	               |ИЗ
	               |	ТабЧасть КАК ТабЧасть
	               |ГДЕ
	               |	(ВЫБОР
	               |				КОГДА ТабЧасть.Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ТабЧасть.Студент
	               |			КОНЕЦ ЕСТЬ NULL 
	               |			ИЛИ ВЫБОР
	               |				КОГДА ТабЧасть.НачислениеСтудентамЗаПрочиеУслуги = ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ТабЧасть.НачислениеСтудентамЗаПрочиеУслуги
	               |			КОНЕЦ ЕСТЬ NULL 
	               |			ИЛИ ВЫБОР
	               |				КОГДА ТабЧасть.НачалоНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ТабЧасть.НачалоНачисления
	               |			КОНЕЦ ЕСТЬ NULL 
	               |			ИЛИ ВЫБОР
	               |				КОГДА ТабЧасть.Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ТабЧасть.Договор
	               |			КОНЕЦ ЕСТЬ NULL 
	               |			ИЛИ ВЫБОР
	               |				КОГДА ТабЧасть.Плательщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ТабЧасть.Плательщик
	               |			КОНЕЦ ЕСТЬ NULL )
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабЧасть.НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.Студент
	               |	КОНЕЦ КАК Учащийся,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.ОкончаниеНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА NULL
	               |		ИНАЧЕ ТабЧасть.ОкончаниеНачисления
	               |	КОНЕЦ КАК ОкончаниеНачисления
	               |ИЗ
	               |	ТабЧасть КАК ТабЧасть
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТабЧасть.ОкончаниеНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				ТОГДА NULL
	               |			ИНАЧЕ ТабЧасть.ОкончаниеНачисления
	               |		КОНЕЦ ЕСТЬ NULL ";
	Запрос.УстановитьПараметр("ТабЧасть", ЭтотОбъект.СтудентыДопУслуги.Выгрузить());
				   
	Результат = Запрос.ВыполнитьПакет();
	ОбязательныеРеквизиты = Результат[1].Выгрузить();
	БессрочныеНачисления = Результат[2].Выгрузить();
	
	Если ОбязательныеРеквизиты.Количество() > 0 Тогда
		Отказ = Истина;
		
		СтрокаСообщения = НСтр("ru='В строке %1 не заполнен реквизит %2!'");
		
		Для Каждого Стр Из ОбязательныеРеквизиты Цикл
			Если Стр.Учащийся = NULL Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки, НСтр("ru='Учащийся'")),
										ЭтотОбъект,
										,
										"СтудентыДопУслуги[" + Стр.НомерСтроки + "].Учащийся");
			КонецЕсли;
			
			Если Стр.НачислениеЗаУслугу = NULL Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки, НСтр("ru='НачислениеЗаУслугу'")),
										ЭтотОбъект,
										,
										"СтудентыДопУслуги[" + Стр.НомерСтроки + "].НачислениеЗаУслугу");
			КонецЕсли;
			
			Если Стр.НачалоНачисления = NULL Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки, НСтр("ru='НачалоНачисления'")),
										ЭтотОбъект,
										,
										"СтудентыДопУслуги[" + Стр.НомерСтроки + "].НачалоНачисления");
			КонецЕсли;
			
			Если Стр.Плательщик = NULL Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки, НСтр("ru='Плательщик'")),
										ЭтотОбъект,
										,
										"СтудентыДопУслуги[" + Стр.НомерСтроки + "].Плательщик");
			КонецЕсли;
			
			Если Стр.Договор = NULL Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки, НСтр("ru='Договор'")),
										ЭтотОбъект,
										,
										"СтудентыДопУслуги[" + Стр.НомерСтроки + "].Договор");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если БессрочныеНачисления.Количество() > 0 Тогда
		СтрокаСообщения = НСтр("ru='В строке %1 назначено бессрочное начисление за услугу!'");
		
		Для Каждого Стр Из БессрочныеНачисления Цикл
			ОбщегоНазначения.СообщитьПользователю(
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Стр.НомерСтроки),
										ЭтотОбъект);
		КонецЦикла;
	КонецЕсли;
				   
КонецПроцедуры

#КонецОбласти

#КонецЕсли