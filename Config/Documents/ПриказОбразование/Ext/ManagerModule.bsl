#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.Приказы - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства) Экспорт
	ДопУслуга = ЭтоПриказНаДопУслугу(Ссылка.ВидПриказа);
	
	Запрос = Новый Запрос;
	
	Если ДопУслуга Тогда
		ТекстЗапроса = ТекстЗапросаДопУслуги();
		
		Запрос.Текст = ТекстЗапроса
			+ ТекстЗапросаТаблицыПоследовательностьНачисленияОбразование();
			
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
		ТаблицыДляДвижений.Вставить("СведенияОПрочихУслугахСтудентам", МассивРезультатов[0].Выгрузить());
		ТаблицыДляДвижений.Вставить("СведенияОСтудентах", Новый ТаблицаЗначений);
		ТаблицыДляДвижений.Вставить("НачисленияОбразованиеПоследовательность", МассивРезультатов[1].Выгрузить());
	Иначе
		ТекстЗапроса = ТекстЗапросаСведенияОСтудентах();
		
		Запрос.Текст = ТекстЗапроса
			+ ТекстЗапросаТаблицыПоследовательностьНачисленияОбразование();
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
		ТаблицыДляДвижений.Вставить("СведенияОПрочихУслугахСтудентам", Новый ТаблицаЗначений);
		ТаблицыДляДвижений.Вставить("СведенияОСтудентах", МассивРезультатов[0].Выгрузить());
		ТаблицыДляДвижений.Вставить("НачисленияОбразованиеПоследовательность", МассивРезультатов[1].Выгрузить());	
	КонецЕсли;
		
КонецПроцедуры	

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаДопУслуги()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПриказОбразованиеСтудентыДопУслуги.Студент КАК Студент,
	               |	ПриказОбразованиеСтудентыДопУслуги.НачислениеСтудентамЗаПрочиеУслуги КАК НачислениеСтудентамЗаПрочиеУслуги,
	               |	ВЫБОР
	               |		КОГДА ПриказОбразованиеСтудентыДопУслуги.Ссылка.ИспользоватьФакультетДокументаДопУслуги = ИСТИНА
	               |			ТОГДА ПриказОбразованиеСтудентыДопУслуги.Ссылка.Факультет
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК Факультет,
	               |	ПриказОбразованиеСтудентыДопУслуги.НачалоНачисления КАК НачалоНачисления,
	               |	ПриказОбразованиеСтудентыДопУслуги.ОкончаниеНачисления КАК ОкончаниеНачисления,
	               |	ПриказОбразованиеСтудентыДопУслуги.Договор КАК Договор,
	               |	ПриказОбразованиеСтудентыДопУслуги.Льгота КАК Льгота,
	               |	ПриказОбразованиеСтудентыДопУслуги.Плательщик КАК Плательщик,
	               |	ПриказОбразованиеСтудентыДопУслуги.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	               |ИЗ
	               |	Документ.ПриказОбразование.СтудентыДопУслуги КАК ПриказОбразованиеСтудентыДопУслуги
	               |ГДЕ
	               |	ПриказОбразованиеСтудентыДопУслуги.Ссылка = &Ссылка
				   |;
				   |
				   |/////////////////////////////////////////////////////////////////////////////
				   |";
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстЗапросаТаблицыПоследовательностьНачисленияОбразование()
	
	ТекстЗапроса = Символы.ПС;
	
	ТекстЗапроса = ТекстЗапроса 
						+ "ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |	ПриказОбразованиеСтуденты.Ссылка.ДатаНачалаДействия КАК Период,
						  |	ПриказОбразованиеСтуденты.Ссылка КАК Регистратор,
						  |	ПриказОбразованиеСтуденты.Ссылка.Факультет КАК Факультет,
						  |	ПриказОбразованиеСтуденты.Договор КАК Договор,
						  |	ПриказОбразованиеСтуденты.Студент КАК Студент
						  |ИЗ
						  |	Документ.ПриказОбразование.Студенты КАК ПриказОбразованиеСтуденты
						  |ГДЕ
						  |	ПриказОбразованиеСтуденты.Ссылка = &Ссылка
						  |	И (ПриказОбразованиеСтуденты.Ссылка.ВидПриказа.СостояниеСтудента <> ЗНАЧЕНИЕ(Справочник.СостоянияСтудентов.ПустаяСсылка)
						  |			ИЛИ ПриказОбразованиеСтуденты.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Льгота)
						  |			ИЛИ ПриказОбразованиеСтуденты.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СтавкаОплаты))";
						  
   ТекстЗапроса = ТекстЗапроса + Символы.ПС 
   					+ ";
						  |/////////////////////////////////////////////////////////////////////////////
						  |";
   											
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЭтоПриказНаДопУслугу(ВидПриказа)
	Возврат (ВидПриказа.УправлениеДополнительнойУслугой = 1);
КонецФункции

Функция ТекстЗапросаСведенияОСтудентах()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПриказСтуденты.Ссылка.ДатаНачалаДействия КАК Период,
	               |	ПриказСтуденты.Ссылка.Факультет КАК Факультет,
	               |	ПриказСтуденты.Студент КАК Студент,
	               |	ПриказСтуденты.Договор КАК Договор,
	               |	ПриказСтуденты.Поле КАК Поле,
	               |	ПриказСтуденты.Значение КАК Значение
	               |ИЗ
	               |	Документ.ПриказОбразование.Студенты КАК ПриказСтуденты
	               |ГДЕ
	               |	ПриказСтуденты.Ссылка = &Ссылка
	               |	И ПриказСтуденты.Поле <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.ПустаяСсылка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписокСтудентов.Приказ.ДатаНачалаДействия,
	               |	СписокСтудентов.Приказ.Факультет,
	               |	СписокСтудентов.Студент,
	               |	СписокСтудентов.Договор,
	               |	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента),
	               |	СписокСтудентов.Приказ.ВидПриказа.СостояниеСтудента
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПриказСтуденты.Студент КАК Студент,
	               |		ПриказСтуденты.Договор КАК Договор,
	               |		ПриказСтуденты.Ссылка КАК Приказ
	               |	ИЗ
	               |		Документ.ПриказОбразование.Студенты КАК ПриказСтуденты
	               |	ГДЕ
	               |		ПриказСтуденты.Ссылка = &Ссылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ПриказСтуденты.Студент,
	               |		ПриказСтуденты.Договор,
	               |		ПриказСтуденты.Ссылка) КАК СписокСтудентов
	               |ГДЕ
	               |	СписокСтудентов.Приказ.ВидПриказа.СостояниеСтудента <> ЗНАЧЕНИЕ(Справочник.СостоянияСтудентов.ПустаяСсылка)"
	+ "
					   |;
					   |/////////////////////////////////////////////////////////////////////////////";   
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти

#КонецЕсли
