	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

Функция ВыгрузитьУведомлениеОбИсчисленныхСуммахНалогов(ДокументСсылка, УникальныйИдентификатор = Неопределено) Экспорт
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	УведомлениеОбъект = ДокументОбъект.Уведомление.ПолучитьОбъект();
	Возврат УведомлениеОбъект.ВыгрузитьДокумент(УникальныйИдентификатор)
	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КБКНалогов() Экспорт
	
	КБКНалогов = Новый Структура;
	КБКНалогов.Вставить("КБКНалоговНДФЛ", 					  Новый Массив);
	КБКНалогов.Вставить("КБКНалоговУплачиваемыхЕжемесячно",   Новый Массив);
	КБКНалогов.Вставить("КБКНалоговУплачиваемыхПоквартально", Новый Массив);
	КБКНалогов.Вставить("ПредставленияКБК", 				  Новый ТаблицаЗначений);
	КБКНалогов.ПредставленияКБК.Колонки.Добавить("КодБК", 			 Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	КБКНалогов.ПредставленияКБК.Колонки.Добавить("ПредставлениеКБК", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки));
	
	Макет = Документы.УведомлениеОбИсчисленныхСуммахНалогов.ПолучитьМакет("КБКНалогов");
	
    ПрочитатьКБКНалоговИзМакета(КБКНалогов, Макет, "КБКНалоговНДФЛ");
    ПрочитатьКБКНалоговИзМакета(КБКНалогов, Макет, "КБКНалоговУплачиваемыхЕжемесячно");
    ПрочитатьКБКНалоговИзМакета(КБКНалогов, Макет, "КБКНалоговУплачиваемыхПоквартально");
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КБКНалогов.КБКНалоговУплачиваемыхЕжемесячно, 
		КБКНалогов.КБКНалоговНДФЛ);
	
    Возврат КБКНалогов;
КонецФункции

Процедура ПрочитатьКБКНалоговИзМакета(КБКНалогов, Макет, Префикс)

	Область = Макет.Область(Префикс);
	Для Ряд = Область.Верх По Область.Низ Цикл
		КодБК = СокрП(Макет.Область(Ряд, 1).Текст);
		КБКНалогов[Префикс].Добавить(КодБК);
		СтрокаПредставлениеКБК = КБКНалогов.ПредставленияКБК.Добавить();
		СтрокаПредставлениеКБК.КодБК = КодБК;
		СтрокаПредставлениеКБК.ПредставлениеКБК = СокрП(Макет.Область(Ряд, 2).Текст);
	КонецЦикла;

КонецПроцедуры

Функция ДублирующиеЗаписиДокумента(ДокументОбъект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГоловнаяОрганизация = РегламентированнаяОтчетность.ГоловнаяОрганизация(ДокументОбъект.Организация);
	Организации 		= Справочники.Организации.ВсяОрганизация(ГоловнаяОрганизация);
	
	ТаблицаНалоги = ДокументОбъект.Налоги.Выгрузить();
	КолонкиСверки = "КПП, КодПоОКТМО, КодБК, НачалоПериода, КонецПериода";
	ТаблицаНалоги.Свернуть(КолонкиСверки);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",        ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаНалоги", ТаблицаНалоги);
	Запрос.УстановитьПараметр("Организации",   Организации);
	Запрос.УстановитьПараметр("ДатаДокумента", ДокументОбъект.Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНалоги.КПП КАК КПП,
	|	ТаблицаНалоги.КодПоОКТМО КАК КодПоОКТМО,
	|	ТаблицаНалоги.КодБК КАК КодБК,
	|	ТаблицаНалоги.НачалоПериода КАК НачалоПериода,
	|	ТаблицаНалоги.КонецПериода КАК КонецПериода
	|ПОМЕСТИТЬ ВТ_ТаблицаНалоги
	|ИЗ
	|	&ТаблицаНалоги КАК ТаблицаНалоги
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаНалоги.КПП,
	|	ТаблицаНалоги.КодПоОКТМО,
	|	ТаблицаНалоги.КодБК,
	|	ТаблицаНалоги.НачалоПериода,
	|	ТаблицаНалоги.КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка.Организация КАК Организация,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка КАК Ссылка,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка.Дата КАК Дата,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.НомерСтроки КАК НомерСтроки,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.КПП КАК КПП,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.КодПоОКТМО КАК КодПоОКТМО,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.КодБК КАК КодБК,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.Сумма КАК Сумма,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.НачалоПериода КАК НачалоПериода,
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.КонецПериода КАК КонецПериода
	|ИЗ
	|	ВТ_ТаблицаНалоги КАК ВТ_ТаблицаНалоги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОбИсчисленныхСуммахНалогов.Налоги КАК УведомлениеОбИсчисленныхСуммахНалоговНалоги
	|		ПО ВТ_ТаблицаНалоги.КПП = УведомлениеОбИсчисленныхСуммахНалоговНалоги.КПП
	|			И ВТ_ТаблицаНалоги.КодПоОКТМО = УведомлениеОбИсчисленныхСуммахНалоговНалоги.КодПоОКТМО
	|			И ВТ_ТаблицаНалоги.КодБК = УведомлениеОбИсчисленныхСуммахНалоговНалоги.КодБК
	|			И ВТ_ТаблицаНалоги.НачалоПериода = УведомлениеОбИсчисленныхСуммахНалоговНалоги.НачалоПериода
	|			И ВТ_ТаблицаНалоги.КонецПериода = УведомлениеОбИсчисленныхСуммахНалоговНалоги.КонецПериода
	|ГДЕ
	|	УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка <> &Ссылка
	|	И УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка.Организация В(&Организации)
	|	И УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка.Проведен
	|	И УведомлениеОбИсчисленныхСуммахНалоговНалоги.Ссылка.Дата <= &ДатаДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Ссылка,
	|	НомерСтроки";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
