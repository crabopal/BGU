#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Документ 					= Параметры.Документ;
	Организация 				= Параметры.Организация;
	АдресВременногоХранилища 	= Параметры.АдресВременногоХранилища;
	
	ПолноеИмяДокумента			= ОбщегоНазначения.ИмяТаблицыПоСсылке(Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.НачислениеИмущественныхНалогов") Тогда
		ЗаполнитьПоДокументуНачислениеИмущественныхНалогов();
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ОтражениеЗарплатыВУчете") Тогда
		ЗаполнитьПоДокументуОтражениеЗарплатыВУчете();
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СведенияОбУдержанномНДФЛ") Тогда
		ЗаполнитьПоДокументуСведенияОбУдержанномНДФЛ();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ", Документ);
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", Истина);
	ИмяФормыОбъекта = СтрШаблон("%1.ФормаОбъекта", ПолноеИмяДокумента);
	ОткрытьФорму(ИмяФормыОбъекта, ПараметрыОткрытия, ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодобранныеНачисления

&НаКлиенте
Процедура ПодобранныеНачисленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ПодготовитьИПередатьДанные();
	РезультатЗакрытия = "ОК";
	Закрыть(РезультатЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоДокументуНачислениеИмущественныхНалогов()

	ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуНачислениеИмущественныхНалогов(Документ);
	
	Для каждого Строка Из ТаблицаНалоги Цикл
		НоваяСтрока = ПодобранныеНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ЗаполнитьПредставлениеПериода(НоваяСтрока);	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОтражениеЗарплатыВУчете()

	ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуОтражениеЗарплатыВУчете(Документ);
	
	Для каждого Строка Из ТаблицаНалоги Цикл
		НоваяСтрока = ПодобранныеНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ЗаполнитьПредставлениеПериода(НоваяСтрока);	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуСведенияОбУдержанномНДФЛ()

	ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуСведенияОбУдержанномНДФЛ(Документ);
	
	Для каждого Строка Из ТаблицаНалоги Цикл
		НоваяСтрока = ПодобранныеНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ЗаполнитьПредставлениеПериода(НоваяСтрока);	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеПериода(СтрокаТаблицы)
	
	СтрокаТаблицы.ПредставлениеПериода =
		ПредставлениеПериодаОтчета(СтрокаТаблицы.НачалоПериода, СтрокаТаблицы.КонецПериода);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеПериодаОтчета(НачалоПериода, КонецПериода)

	Возврат ЕдиныйНалоговыйСчетКлиентСервер.ПредставлениеПериодаОтчета(НачалоПериода, КонецПериода);
	
КонецФункции

&НаСервере
Процедура ПодготовитьИПередатьДанные()
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("Документ", Документ);
	ДанныеВозврата.Вставить("ТаблицаНалоги", ПодобранныеНачисления.Выгрузить());
	ПоместитьВоВременноеХранилище(ДанныеВозврата, АдресВременногоХранилища);
	
КонецПроцедуры

#КонецОбласти