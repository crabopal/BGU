#Область ОписаниеПеременных

&НаКлиенте
Перем РезультатЗакрытия;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Организация 				= Параметры.Организация;
	АдресВременногоХранилища 	= Параметры.АдресВременногоХранилища;
	
	ГоловнаяОрганизация 		= РегламентированнаяОтчетность.ГоловнаяОрганизация(Организация);
	КППГоловнойОрганизации 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГоловнаяОрганизация, "КПП");
	ОКТМООрганизации 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодОКТМО");
	
	УстановитьОтборыСпискаВыбора(СписокНачислениеИмущественныхНалогов);
	УстановитьОтборыСпискаВыбора(СписокОтражениеЗарплатыВУчете);
	УстановитьОтборыСпискаВыбора(СписокСведенияОбУдержанномНДФЛ);

	АдресВременногоХранилищаФормаПодбора = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Настройки = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("ПодборНачисленийВУведомление", "");
	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ПредварительныйПросмотрВыбора") Тогда
			ПредварительныйПросмотрВыбора = Настройки.ПредварительныйПросмотрВыбора;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы И ПодобранныеНачисления.Количество() > 0 Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПодобранныеНачисления.Количество() > 0 И РезультатЗакрытия = Неопределено Тогда
		Отказ = Истина;
		ВопросПередЗакрытиемПеренестиДанныеАсинх();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПредварительныйПросмотрВыбора", ПредварительныйПросмотрВыбора);
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ПодборНачисленийВУведомление", "", Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокНачислениеИмущественныхНалогов

&НаКлиенте
Процедура СписокНачислениеИмущественныхНалоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если ПредварительныйПросмотрВыбора Тогда
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилищаФормаПодбора);
		ПараметрыОткрытияФормы.Вставить("Документ",	ВыбраннаяСтрока[0]);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ДобавитьВТаблицуНачислений", ЭтотОбъект);
		
		ОткрытьФорму("Документ.УведомлениеОбИсчисленныхСуммахНалогов.Форма.ФормаПодбораДанныеДокумента", ПараметрыОткрытияФормы, , , , ,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиНачислениеИмущественныхНалогов(ВыбраннаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокНачислениеИмущественныхНалоговВыборЗначения(Элемент, Значение, СтандартнаяОбработка)

	СписокНачислениеИмущественныхНалоговВыбор(Элемент, Значение, , СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокОтражениеЗарплатыВУчете

&НаКлиенте
Процедура СписокОтражениеЗарплатыВУчетеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ПредварительныйПросмотрВыбора Тогда
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилищаФормаПодбора);
		ПараметрыОткрытияФормы.Вставить("Документ",	ВыбраннаяСтрока[0]);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ДобавитьВТаблицуНачислений", ЭтотОбъект);
		
		ОткрытьФорму("Документ.УведомлениеОбИсчисленныхСуммахНалогов.Форма.ФормаПодбораДанныеДокумента", ПараметрыОткрытияФормы, , , , ,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиОтражениеЗарплатыВУчете(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОтражениеЗарплатыВУчетеВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СписокОтражениеЗарплатыВУчетеВыбор(Элемент, Значение, , СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокСведенияОбУдержанномНДФЛ

&НаКлиенте
Процедура СписокСведенияОбУдержанномНДФЛВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ПредварительныйПросмотрВыбора Тогда
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилищаФормаПодбора);
		ПараметрыОткрытияФормы.Вставить("Документ",	ВыбраннаяСтрока[0]);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ДобавитьВТаблицуНачислений", ЭтотОбъект);
		
		ОткрытьФорму("Документ.УведомлениеОбИсчисленныхСуммахНалогов.Форма.ФормаПодбораДанныеДокумента", ПараметрыОткрытияФормы, , , , ,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиСведенияОбУдержанномНДФЛ(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСведенияОбУдержанномНДФЛВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СписокСведенияОбУдержанномНДФЛВыбор(Элемент, Значение, , СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодобранныеНачисления

&НаКлиенте
Процедура ПодобранныеНачисленияПриИзменении(Элемент)
	ОбновитьНумерациюСтрок(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеНачисленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ПодготовитьИПередатьДанные();
	РезультатЗакрытия = "ПеренестиВДокумент";
	Закрыть(РезультатЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	РезультатЗакрытия = "Отмена";
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборыСпискаВыбора(СписокВыбора)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВыбора,
		"Организация", Организация, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВыбора,
		"Проведен", Истина, , , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиНачислениеИмущественныхНалогов(Знач ВыбранныеЗначения)

	Для каждого Документ Из ВыбранныеЗначения Цикл
		УдалитьИзПодобранныеНачисленияДанныеПоДокументу(Документ);
		ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуНачислениеИмущественныхНалогов(Документ);
        ДобавитьВТаблицуПодобранныеНачисления(Документ, ТаблицаНалоги);
	КонецЦикла;
	ОбновитьНумерациюСтрок(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиОтражениеЗарплатыВУчете(Знач ВыбранныеЗначения)

	Для каждого Документ Из ВыбранныеЗначения Цикл
		УдалитьИзПодобранныеНачисленияДанныеПоДокументу(Документ);
		ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуОтражениеЗарплатыВУчете(Документ);
        ДобавитьВТаблицуПодобранныеНачисления(Документ, ТаблицаНалоги);
	КонецЦикла;
	ОбновитьНумерациюСтрок(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодобранныеНачисленияВыбраннымиСтрокамиСведенияОбУдержанномНДФЛ(Знач ВыбранныеЗначения)

	Для каждого Документ Из ВыбранныеЗначения Цикл
		УдалитьИзПодобранныеНачисленияДанныеПоДокументу(Документ);
		ТаблицаНалоги = ЕдиныйНалоговыйСчет.ТаблицаНалогиПоДокументуСведенияОбУдержанномНДФЛ(Документ);
        ДобавитьВТаблицуПодобранныеНачисления(Документ, ТаблицаНалоги);
	КонецЦикла;
	ОбновитьНумерациюСтрок(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура УдалитьИзПодобранныеНачисленияДанныеПоДокументу(Документ)

	СтрокиКУдалению = ПодобранныеНачисления.НайтиСтроки(Новый Структура("Документ", Документ));
	Для каждого Строка Из СтрокиКУдалению Цикл
		ПодобранныеНачисления.Удалить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВТаблицуПодобранныеНачисления(Документ, ТаблицаНалоги)
	
	ДобавилиСтроку = Ложь;
	
    Для каждого Строка Из ТаблицаНалоги Цикл
		НоваяСтрока = ПодобранныеНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Документ = Документ;
		ЗаполнитьПредставлениеПериода(НоваяСтрока);
		ДобавилиСтроку = Истина;
	КонецЦикла;
	
	Если ДобавилиСтроку Тогда
		Элементы.ПодобранныеНачисления.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеПериода(СтрокаТаблицы)
	
	СтрокаТаблицы.ПредставлениеПериода =
		ПредставлениеПериодаОтчета(СтрокаТаблицы.НачалоПериода, СтрокаТаблицы.КонецПериода);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеПериодаОтчета(НачалоПериода, КонецПериода)

	Возврат ЕдиныйНалоговыйСчетКлиентСервер.ПредставлениеПериодаОтчета(НачалоПериода, КонецПериода);
	
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередЗакрытиемПеренестиДанныеАсинх()

	ТекстВопроса = НСтр("ru = 'Подобранные начисления не перенесены в документ.
		|
		|Перенести?'");
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Отмена);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПодготовитьИПередатьДанные();
		РезультатЗакрытия = "ПеренестиВДокумент";
		Закрыть(РезультатЗакрытия);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		РезультатЗакрытия = "Отмена";
		Закрыть(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьИПередатьДанные()
	
	ТаблицаНалоги = РеквизитФормыВЗначение("ПодобранныеНачисления");
	ЕдиныйНалоговыйСчет.СвернутьТаблицуНалоги(ТаблицаНалоги);
	
	ПоместитьВоВременноеХранилище(ТаблицаНалоги, АдресВременногоХранилища);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВТаблицуНачислений(РезультатЗакрытияДанныеДокумента, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытияДанныеДокумента = "ОК" Тогда
		
		ДобавитьВТаблицуНачисленийНаСервере();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВТаблицуНачисленийНаСервере()
	
	ДанныеВозврата = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаФормаПодбора);
	УдалитьИзПодобранныеНачисленияДанныеПоДокументу(ДанныеВозврата.Документ);
	ДобавитьВТаблицуПодобранныеНачисления(ДанныеВозврата.Документ, ДанныеВозврата.ТаблицаНалоги);
	ОбновитьНумерациюСтрок(ЭтотОбъект);
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНумерациюСтрок(Форма)
	
	ПодобранныеНачисления = Форма.ПодобранныеНачисления;
	КоличествоСтрок = ПодобранныеНачисления.Количество() - 1;
	Для ИндексСтроки = 0 По КоличествоСтрок Цикл
		ПодобранныеНачисления[ИндексСтроки].НомерСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти