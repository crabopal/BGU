КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКонтрольныеСоотношенияЗавершение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Объект.Проведен Или Модифицированность Тогда
		Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	Если НЕ ДополнительныеПараметры.Свойство("СообщениеПриОтсутствииОшибок") Тогда
		ДополнительныеПараметры.Вставить("СообщениеПриОтсутствииОшибок", Истина);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("Записать", Объект.Уведомление.Пустая());
	
	КлючУникальности = Объект.Уведомление;
	РегламентированнаяОтчетностьКлиент.ПроверитьКонтрольныеСоотношения_СКП(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьКонтрольныеСоотношенияВОтчете() Экспорт
	
	РезультатПроверки = КонтрольныеСоотношенияИсчисленныеСуммыНалогов.ПроверитьКонтрольныеСоотношенияВОтчете(ЭтотОбъект, Объект.Уведомление);
	ЕстьОшибкиПроверкиКонтрольныхСоотношений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатПроверки, "ЧислоОшибок", 0) > 0;
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьДокументирование() Экспорт
	Возврат ВыполнитьДокументированиеНаСервере();
КонецФункции

&НаСервере
Функция ВыполнитьДокументированиеНаСервере()
	Возврат КонтрольныеСоотношенияИсчисленныеСуммыНалогов.ВыполнитьДокументированиеНаСервере(ЭтотОбъект, Объект.Уведомление);
КонецФункции

&НаКлиенте
Процедура АктивизироватьЯчейку(Ячейка) Экспорт
	
	Если Ячейка.Раздел = "СумИсчНалог_2023" Тогда
		НомерСтроки = Число(СокрЛП(СтрЗаменить(Ячейка.Страница, "Стр. ", "")));
		Для Каждого СтрокаДокумента Из Объект.Налоги Цикл
			Если НомерСтроки = СтрокаДокумента.НомерСтроки Тогда
				Элементы.Налоги.ТекущаяСтрока = СтрокаДокумента.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНаКлиенте(Автосохранение = Ложь, ВыполняемоеОповещение = Неопределено) Экспорт 
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИнициализироватьРеквизитыОрганизации();
	
	КБКНалогов = Документы.УведомлениеОбИсчисленныхСуммахНалогов.КБКНалогов();
	
	КБКНалоговНДФЛ = Новый ФиксированныйМассив(
		КБКНалогов.КБКНалоговНДФЛ);

	КБКНалоговУплачиваемыхЕжемесячно = Новый ФиксированныйМассив(
		КБКНалогов.КБКНалоговУплачиваемыхЕжемесячно);
	
	КБКНалоговУплачиваемыхПоквартально = Новый ФиксированныйМассив(
		КБКНалогов.КБКНалоговУплачиваемыхПоквартально);
		
	ПредставленияКБК.Загрузить(КБКНалогов.ПредставленияКБК);	

	Элементы.ФормаРазрешитьВыгружатьСОшибками.Пометка = Объект.РазрешитьВыгружатьСОшибками;

	СтруктураРеквизитовФормы = Новый Структура;
	СтруктураРеквизитовФормы.Вставить("мСохраненныйДок", Объект.Уведомление);
	СтруктураРеквизитовФормы.Вставить("Организация",     ГоловнаяОрганизация);
		
	ЗаполнитьДобавленныеКолонкиТаблицы();

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НалогиВидНалогаИлиПлатежа");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.Налоги.ВидНалогаИлиПлатежа", ,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      Новый ПолеКомпоновкиДанных("Объект.Налоги.ПредставлениеКБК"));
	
КонецПроцедуры

&НаСервере
Процедура ЗапретитьРедактированиеДокумента()
	
	Если ТолькоПросмотр Или Объект.РазрешитьРедактированиеУведомления Тогда
		Возврат;	
	КонецЕсли;
	
	КонтролирующийОрган      = Перечисления.ТипыКонтролирующихОрганов.ФНС;
	СтатусОтправки           = Неопределено;
	СостояниеСдачиОтчетности = Неопределено;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
		Объект.Уведомление, Объект.Организация, КонтролирующийОрган, СостояниеСдачиОтчетности, СтатусОтправки);
	
	Если СостояниеСдачиОтчетности <> Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат Тогда
	
		ТолькоПросмотр = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаРазрешитьРедактированиеУведомления",
			"Видимость", Истина);		
	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ИнициализироватьРеквизитыОрганизации();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьРеквизитыОрганизации()
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация,
		"КПП,КодОКТМО,ГоловнаяОрганизация");
	
	КППОрганизации 		= РеквизитыОрганизации.КПП;
	КодПоОКТМО 			= РеквизитыОрганизации.КодОКТМО;
	ГоловнаяОрганизация	= РеквизитыОрганизации.ГоловнаяОрганизация;
	
	Если Не ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
		ГоловнаяОрганизация = Объект.Организация;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеСтрокиНалогиПриИзмененииВидНалогаИлиПлатежа(Знач ДанныеСтроки)

	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.ВидНалогаИлиПлатежа) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Результат.Вставить("КодБК", Справочники.ВидыНалоговИПлатежей.КБКВидаНалога(ДанныеСтроки.ВидНалогаИлиПлатежа));
	ДанныеСтроки.Вставить("КодБК", Результат.КодБК);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, ДанныеСтрокиНалогиПриИзмененииКодБК(ДанныеСтроки),
		Истина);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеСтрокиНалогиПриИзмененииКодБК(Знач ДанныеСтроки)

	Результат = Новый Структура;
	Результат.Вставить("ПредставлениеКБК", ПредставлениеКБКНалога(ДанныеСтроки.КодБК));
	
	ПериодОтчета = ПериодОтчетаПоДатеУведомления(ДанныеСтроки.КодБК, ДанныеСтроки.Дата);
	Если Не ПериодичностьНеИзменилась(ДанныеСтроки, ПериодОтчета) Тогда
		Результат.Вставить("НачалоПериода", ПериодОтчета.НачалоПериода);
		Результат.Вставить("КонецПериода",  ПериодОтчета.КонецПериода);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПериодичностьНеИзменилась(ПериодОтчета, НовыйПериодОтчета)
	Возврат
		ЗначениеЗаполнено(ПериодОтчета.НачалоПериода)
		И ЗначениеЗаполнено(НовыйПериодОтчета.НачалоПериода)
		И ((ЭтоПериодНДФЛ(ПериодОтчета) И ЭтоПериодНДФЛ(НовыйПериодОтчета))
		Или (ЭтоПериодМесяц(ПериодОтчета) И ЭтоПериодМесяц(НовыйПериодОтчета))
		Или (ЭтоПериодКвартал(ПериодОтчета) И ЭтоПериодКвартал(НовыйПериодОтчета)));
КонецФункции

&НаСервере
Функция ЭтоПериодНДФЛ(ПериодОтчета)
	Возврат	
		НачалоМесяца(ПериодОтчета.НачалоПериода) <> ПериодОтчета.НачалоПериода
		Или КонецМесяца(ПериодОтчета.КонецПериода) <> КонецДня(ПериодОтчета.КонецПериода);
КонецФункции

&НаСервере
Функция ЭтоПериодМесяц(ПериодОтчета)
	Возврат
		НачалоМесяца(ПериодОтчета.НачалоПериода) = ПериодОтчета.НачалоПериода
		И КонецМесяца(ПериодОтчета.НачалоПериода) = КонецДня(ПериодОтчета.КонецПериода);
КонецФункции

&НаСервере
Функция ЭтоПериодКвартал(ПериодОтчета)
	Возврат
		НачалоКвартала(ПериодОтчета.НачалоПериода) = ПериодОтчета.НачалоПериода
		И КонецКвартала(ПериодОтчета.НачалоПериода) = КонецДня(ПериодОтчета.КонецПериода);
КонецФункции

&НаСервере
Функция ПериодОтчетаПоДатеУведомления(Знач КодБК, Знач ДатаДокумента)

	Если КБКНалоговНДФЛ.Найти(КодБК) <> Неопределено Тогда
		ПериодОтчета = ПериодОтчетаНДФЛПоДатеУведомления(ДатаДокумента);	
	ИначеЕсли КБКНалоговУплачиваемыхЕжемесячно.Найти(КодБК) <> Неопределено Тогда 	
		ПериодОтчета = ПериодОтчетаЕжемесячныйПоДатеУведомления(ДатаДокумента);	
	ИначеЕсли КБКНалоговУплачиваемыхПоквартально.Найти(КодБК) <> Неопределено Тогда 	
		ПериодОтчета = ПериодОтчетаПоквартальныйПоДатеУведомления(ДатаДокумента);	
	Иначе	
		ПериодОтчета = Новый Структура;
		ПериодОтчета.Вставить("НачалоПериода", Дата(1,1,1));
		ПериодОтчета.Вставить("КонецПериода", Дата(1,1,1));
	КонецЕсли;
	
	Возврат ПериодОтчета;
	
КонецФункции

&НаСервере
Функция ПериодОтчетаНДФЛПоДатеУведомления(Знач ДатаДокумента)
	
	ПериодОтчета = Новый Структура;
	ПериодОтчета.Вставить("НачалоПериода", Дата(1,1,1));
	ПериодОтчета.Вставить("КонецПериода", Дата(1,1,1));

	ДатаДокумента = НачалоДня(ДатаДокумента);
	
	СрокПредоставления1 = Дата(Год(ДатаДокумента), Месяц(ДатаДокумента), 3);
	УточненныйСрокПредоставления1 = УточненныйСрокСУчетомВыходногоДня(СрокПредоставления1);
	
	СрокПредоставления2 = Дата(Год(ДатаДокумента), Месяц(ДатаДокумента), 25);
	УточненныйСрокПредоставления2 = УточненныйСрокСУчетомВыходногоДня(СрокПредоставления2);
	
	Если УточненныйСрокПредоставления1 >= ДатаДокумента
		И Не НачалоГода(ДатаДокумента) = НачалоМесяца(ДатаДокумента) Тогда
		
		ПериодОтчета.НачалоПериода = Дата(
			Год(ДатаДокумента),
			Месяц(ДобавитьМесяц(ДатаДокумента, -1)),
			23);
		ПериодОтчета.КонецПериода  = КонецМесяца(ПериодОтчета.НачалоПериода);
		
	ИначеЕсли УточненныйСрокПредоставления2 >= ДатаДокумента Тогда
		
		ПериодОтчета.КонецПериода = Дата(
			Год(ДатаДокумента),
			Месяц(ДатаДокумента),
			22);
		ПериодОтчета.НачалоПериода  = НачалоМесяца(ПериодОтчета.КонецПериода);
		
	Иначе
		
		ПериодОтчета.НачалоПериода = Дата(
			Год(ДатаДокумента),
			Месяц(ДатаДокумента),
			23);
		ПериодОтчета.КонецПериода = КонецМесяца(ПериодОтчета.НачалоПериода);
		
	КонецЕсли;
	
	Возврат ПериодОтчета;
	
КонецФункции

&НаСервере
Функция ПериодОтчетаЕжемесячныйПоДатеУведомления(Знач ДатаДокумента)
	
	ПериодОтчета = Новый Структура;
	ПериодОтчета.Вставить("НачалоПериода", Дата(1,1,1));
	ПериодОтчета.Вставить("КонецПериода", Дата(1,1,1));

	ДатаДокумента = НачалоДня(ДатаДокумента);
	
	СрокПредоставления = Дата(Год(ДатаДокумента), Месяц(ДатаДокумента), 25);
	УточненныйСрокПредоставления = УточненныйСрокСУчетомВыходногоДня(СрокПредоставления);
	Если УточненныйСрокПредоставления >= ДатаДокумента Тогда
		ПериодОтчета.НачалоПериода = НачалоМесяца(ДобавитьМесяц(УточненныйСрокПредоставления, -1));
	Иначе
		ПериодОтчета.НачалоПериода = НачалоМесяца(УточненныйСрокПредоставления);
	КонецЕсли;
	ПериодОтчета.КонецПериода = КонецМесяца(ПериодОтчета.НачалоПериода);
	
	Возврат ПериодОтчета;
	
КонецФункции

&НаСервере
Функция ПериодОтчетаПоквартальныйПоДатеУведомления(Знач ДатаДокумента)
	
	ПериодОтчета = Новый Структура;
	ПериодОтчета.Вставить("НачалоПериода", Дата(1,1,1));
	ПериодОтчета.Вставить("КонецПериода", Дата(1,1,1));
	
	ДатаДокумента = НачалоДня(ДатаДокумента);
	
	СрокПредоставления = НачалоКвартала(ДатаДокумента);
	СрокПредоставления = ДобавитьМесяц(СрокПредоставления, 
		?(СрокПредоставления = НачалоГода(СрокПредоставления), 1, 0));
	СрокПредоставления = Дата(Год(СрокПредоставления), Месяц(СрокПредоставления), 25);
		
	УточненныйСрокПредоставления = УточненныйСрокСУчетомВыходногоДня(СрокПредоставления);
	Если УточненныйСрокПредоставления >= ДатаДокумента Тогда
		ПериодОтчета.НачалоПериода = НачалоКвартала(ДобавитьМесяц(УточненныйСрокПредоставления, -3));
	Иначе
		ПериодОтчета.НачалоПериода = НачалоКвартала(УточненныйСрокПредоставления);
	КонецЕсли;
	ПериодОтчета.КонецПериода = КонецКвартала(ПериодОтчета.НачалоПериода);
	
	Возврат ПериодОтчета;
	
КонецФункции

&НаСервере
Функция УточненныйСрокСУчетомВыходногоДня(Знач СрокИсходный, ПолучатьПредшествующие = Ложь)
	
	УточненныйСрок = СрокИсходный;
	ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
	ПараметрыПолученияБлижайшихРабочихДат = КалендарныеГрафики.ПараметрыПолученияБлижайшихРабочихДат(ПроизводственныйКалендарь);
	Если ПолучатьПредшествующие Тогда
		ПараметрыПолученияБлижайшихРабочихДат.ПолучатьПредшествующие = Истина;
	КонецЕсли;
	
	ГрафикПереноса = КалендарныеГрафики.БлижайшиеРабочиеДаты(
		ПроизводственныйКалендарь,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СрокИсходный),
		ПараметрыПолученияБлижайшихРабочихДат);
		
	НовыйСрок = ГрафикПереноса[СрокИсходный];
	Если ЗначениеЗаполнено(НовыйСрок) Тогда
		УточненныйСрок = НовыйСрок;
	КонецЕсли;

	Возврат УточненныйСрок;
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеСтрокиНалогиПриИзмененииНалогСборПлатеж(Знач ДанныеСтроки)

	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.НалогСборПлатеж) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	КодПоОКТМО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.НалогСборПлатеж, "КодОКТМО");
	Если ЗначениеЗаполнено(КодПоОКТМО) Тогда
		Результат.Вставить("КодПоОКТМО", КодПоОКТМО);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

