Процедура ДополнитьТаблицуНалогов(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = "ПеренестиВДокумент" Тогда
		
		ДополнитьТаблицуНалоговНаСервере();
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДополнитьТаблицуНалоговНаСервере()
	
	ТаблицаНалоги = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	ПоляПоиска = "КПП,КодПоОКТМО,КодБК,НачалоПериода,КонецПериода";
	ПараметрыПоиска = Новый Структура(ПоляПоиска);
	
	Для каждого СтрокаНалоги Из ТаблицаНалоги Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрокаНалоги);
		НашлиСтроки = Объект.Налоги.НайтиСтроки(ПараметрыПоиска);
		Если НашлиСтроки.Количество() > 0 Тогда
			НоваяСтрока = НашлиСтроки[0];
		Иначе
			НоваяСтрока = Объект.Налоги.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНалоги);
		ЗаполнитьДобавленныеКолонкиСтрокиТаблицы(НоваяСтрока);
	КонецЦикла;
	
КонецПроцедуры 

