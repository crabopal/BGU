&НаСервере
Функция ПредставлениеКБКНалога(КодБК)
	
	ПредставлениеКБКНалога = "";
	НашлиПредставление = ПредставленияКБК.НайтиСтроки(Новый Структура("КодБК", КодБК));
	Если НашлиПредставление.Количество() > 0 Тогда
		ПредставлениеКБКНалога = НашлиПредставление[0].ПредставлениеКБК;
	КонецЕсли;
	
	Возврат ПредставлениеКБКНалога;

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуПодбора()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	ПараметрыОткрытияФормы.Вставить("Организация", 				Объект.Организация);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ДополнитьТаблицуНалогов", ЭтотОбъект);
	
	ОткрытьФорму("Документ.УведомлениеОбИсчисленныхСуммахНалогов.Форма.ФормаПодбора", ПараметрыОткрытияФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
