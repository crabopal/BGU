				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПоступлениеУслугРабот.Ссылка,
	ДокументПоступлениеУслугРабот.ВерсияДанных,
