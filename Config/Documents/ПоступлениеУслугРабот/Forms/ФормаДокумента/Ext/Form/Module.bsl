&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(ТекНоменклатура)
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура, "СтавкаНДС, ЕдиницаИзмерения");
	
	Возврат СтруктураДанных;
	
