Процедура УслугиИРаботыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "УслугиИРаботыАналитикаЗатрат" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоНоваяСтрока = НоваяСтрока;
	
	Если НоваяСтрока И Не Копирование Тогда
		СтрокаТаблицы = Элементы.УслугиИРаботы.ТекущиеДанные;
		СтрокаТаблицы.АналитикаЗатрат = "<...>";
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиИРаботыПриАктивизацииЯчейки(Элемент)
	
	Если Элементы.УслугиИРаботы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.УслугиИРаботы.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "УслугиИРаботыАналитикаЗатрат"
			И НЕ Элементы.УслугиИРаботы.ТекущиеДанные.АналитикаЗатратЗаполнена Тогда
			ВыбраннаяСтрока = Элементы.УслугиИРаботы.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УслугиИРаботыОбновитьТекстАналитикиЗатратВсехСтрок(Объект)
	
	Для Каждого СтрокаТаблицы Из Объект.УслугиИРаботы Цикл
		УслугиИРаботыОбновитьТекстАналитикиЗатратВСтрокеТаблицы(Объект, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УслугиИРаботыОбновитьТекстАналитикиЗатратВСтрокеТаблицы(Объект, СтрокаТаблицы)
	
	АналитикаЗатратТекст 		= "";
	АналитикаЗатратЗаполнена 	= Истина;
	
	Если СтрокаТаблицы.Свойство("КПС") И ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
		АналитикаЗатратТекст = АналитикаЗатратТекст + ", " + СтрокаТаблицы.КПС;
	КонецЕсли;
	Если СтрокаТаблицы.Свойство("КЭК") И ЗначениеЗаполнено(СтрокаТаблицы.КЭК) Тогда
		АналитикаЗатратТекст = АналитикаЗатратТекст + ", " + СтрокаТаблицы.КЭК;
	КонецЕсли;
	Если СтрокаТаблицы.Свойство("ВидЗатрат") И ЗначениеЗаполнено(СтрокаТаблицы.ВидЗатрат) Тогда
		АналитикаЗатратТекст = АналитикаЗатратТекст + ", " + СтрокаТаблицы.ВидЗатрат;
	КонецЕсли;
	Если СтрокаТаблицы.Свойство("ПодразделениеЗатрат") И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеЗатрат)
		И НЕ СтрокаТаблицы.ПодразделениеЗатрат = Объект.Подразделение Тогда
		АналитикаЗатратТекст = АналитикаЗатратТекст + ", " + СтрокаТаблицы.ПодразделениеЗатрат;
	КонецЕсли;
	
	СтрокаТаблицы.АналитикаЗатрат 			= Сред(АналитикаЗатратТекст, 3);
	СтрокаТаблицы.АналитикаЗатратЗаполнена 	= АналитикаЗатратЗаполнена;
	
КонецПроцедуры

