КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Контрагент""'"),, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Объект.Организация");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "";	
	Если Объект.ЗачетАвансов.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена.
		|'") ;
	КонецЕсли;
	Если Объект.Проведен Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Проведение документа будет отменено.
		|'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		 ТекстВопроса = ТекстВопроса + НСтр("ru = 'Продолжить?'");
		 ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьАвансыЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		 Возврат;
	КонецЕсли;	 

	ЗаполнитьАвансыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансыЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьАвансыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге(Команда)
	
	ПометкаНовая = НЕ Элементы.УслугиИРаботыРедактированиеВДиалоге.Пометка;
	
	УправлениеВидимостьюКолонокТаблицыУслугиИРаботы(Элементы,ПометкаНовая);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАналитикуЗатрат(Команда)
	
	Если Объект.УслугиИРаботы.Количество() > 0 Тогда
		ВыбраннаяСтрока = Элементы.УслугиИРаботы.ВыделенныеСтроки[0];
		Если Элементы.УслугиИРаботы.ВыделенныеСтроки.Количество() > 1 Тогда
			НоменклатураВЗаголовкеФормы = Ложь;
		Иначе
			НоменклатураВЗаголовкеФормы = Истина;
		КонецЕсли;
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока,НоменклатураВЗаголовкеФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДоговору(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСТр("ru = 'Не заполнено обязательное поле ""Договор""'"),,
			"Объект.Договор");
		Возврат;
	КонецЕсли;
	
	Если Объект.УслугиИРаботы.Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьТаблицуПоДоговору", ЭтотОбъект),
			НСтр("ru = 'Существующие строки документа будут удалены. 
			|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗаполнитьТаблицуПоДоговоруНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
&НаКлиенте
Процедура Подключаемый_КонтрольИсполненияДоговоровПоказатьСтатус(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДокументСсылка", Объект.Ссылка);
	ДопПараметры.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	ДопПараметры.Вставить("ОтразитьВГрафикеИсполнения", Объект.ОтразитьВГрафикеИсполненияДоговора);
	
	КонтрольИсполненияДоговоровКлиент.ПоказатьСтатусИсполнения(
		Объект.Организация, Объект.Контрагент, Объект.Договор, ДопПараметры, ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры
