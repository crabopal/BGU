&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоВсемКФО", Истина);
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ);
	
	Объект.ЗачетАвансов.Очистить();
	Для каждого СтрокаОбъекта Из ДокументОбъект.ЗачетАвансов Цикл
		ЗаполнитьЗначенияСвойств(Объект.ЗачетАвансов.Добавить(), СтрокаОбъекта);
	КонецЦикла;
	
	Если НЕ Отказ Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ВалютаДоИзменения <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтаФорма, Объект);
	КонецЕсли;
	Если СуммаВключаетНДСДоИзменения <> Объект.СуммаВключаетНДС Тогда
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)
	
	Объект = Форма.Объект;
	
	ПараметрыПредставления = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта_Параметры();
	ПараметрыПредставления.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыПредставления.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
	ПараметрыПредставления.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	ПараметрыПредставления.ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПараметрыПредставления.ПоказыватьНДС = Истина;
	ПараметрыПредставления.УчитыватьНДС = ПараметрыПредставления.ПоказыватьНДС;
	ПараметрыПредставления.ПоказыватьВалюту = Форма.КэшПараметров.ИспользоватьВалютныйУчет;
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовЭДОДляЭДПоставщика, ВидимостьЭлементовЭДОДляГосНужд)
	Объект = Форма.Объект;
	
	Если ВидимостьЭлементовЭДОДляЭДПоставщика Тогда
		ВидимостьЭлементовЭДО = Истина;
		Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Отражение ЭД в учете'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДекорацияСостояниеЭДО", "Доступность", ВидимостьЭлементовЭДОДляЭДПоставщика);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиИРаботыИдентификаторПоставщика", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьЭлементовЭДОДляЭДПоставщика);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиИРаботыНаименованиеПоставщика", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьЭлементовЭДОДляЭДПоставщика);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаЗакупкаДляГосударственныхНужд", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовЭДОДляГосНужд);
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// УслугиАналитикаУчета
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УслугиИРаботыАналитикаЗатрат.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.УслугиИРаботы.АналитикаЗатратЗаполнена");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	Элемент.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УслугиИРаботыАналитикаЗатрат.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.УслугиИРаботы.АналитикаЗатратЗаполнена");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеГиперссылкаЦвет);
	
	Элемент.Использование = Истина;
	
	// Выключенный флажок "КомиссионнаяТорговля" - недоступные поля "Комитент", "ДоговорКомитента"

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыКомитент");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УслугиИРаботыДоговорКомитента");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.УслугиИРаботы.КомиссионнаяТорговля", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение, НоменклатураВЗаголовкеФормы = Истина)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.УслугиИРаботы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КПС, КЭК, ВидЗатрат,Номенклатура");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	Если НЕ НоменклатураВЗаголовкеФормы Тогда
		ПараметрыФормы.Вставить("Номенклатура","");
	КонецЕсли;
	
	ПараметрыФормы.Подразделение = ДанныеСтроки.ПодразделениеЗатрат;
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ОткрытьФорму("Документ.ПоступлениеУслугРабот.Форма.ФормаРедактированияАналитикиЗатрат", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.УслугиИРаботы.ВыделенныеСтроки Цикл
	
	ТекущиеДанные = Элементы.УслугиИРаботы.ДанныеСтроки(ВыделеннаяСтрока);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете);
	
	Если НЕ Объект.Подразделение = СтруктураОтражениеВУчете.Подразделение Тогда
		ТекущиеДанные.ПодразделениеЗатрат = СтруктураОтражениеВУчете.Подразделение;
	Иначе
		ТекущиеДанные.ПодразделениеЗатрат = "";
	КонецЕсли;
	
	УслугиИРаботыОбновитьТекстАналитикиЗатратВСтрокеТаблицы(Объект, ТекущиеДанные);
	
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюКолонокТаблицыУслугиИРаботы(Элементы,Пометка)
	
	Элементы.УслугиИРаботыРедактированиеВДиалоге.Пометка = Пометка;
	
	Элементы.ХарактеристикиЗатрат.Видимость 			= НЕ Пометка;
	Элементы.УслугиИРаботыПодразделениеЗатрат.Видимость = НЕ Пометка;
	Элементы.УслугиИРаботыАналитикаЗатрат.Видимость 	= Пометка;
	
КонецПроцедуры

