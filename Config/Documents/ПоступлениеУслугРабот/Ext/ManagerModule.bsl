#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	
	ОбъектМетаданных = Метаданные.Документы.ПоступлениеУслугРабот;
	Если ПравоДоступа("Добавление", ОбъектМетаданных) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = ОбъектМетаданных.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначения.ПредставлениеОбъекта(ОбъектМетаданных);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Записывать";
		КомандаСоздатьНаОсновании.МножественныйВыбор = Ложь;
		
		ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаСоздатьНаОсновании,"Организация",,ВидСравненияКомпоновкиДанных.Заполнено);
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица проводок, которые будут сформированы
//  ДокументОбъект - ДокументОбъект - Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура - Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - ТаблицаЗначений - Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка - Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращаемое значение:
//  Булево - флаг успешного выполнения. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ОтразитьВКарточкеКапвложений = Ложь;
	Если НЕ ДополнительныеРеквизиты.Свойство("ОтразитьВКарточкеКапвложений", ОтразитьВКарточкеКапвложений) 
		ИЛИ НЕ ОтразитьВКарточкеКапвложений Тогда
		// Если движения в карточке капвложений отражать не нужно, то ничего не делаем	
		Возврат Истина;
	КонецЕсли;
		
	Если ПроверитьТабДвиженийДляКарточкиКапвложенийПоДокументуПоставки(
		ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Тогда
		Возврат Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДополнительныеРеквизиты.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Бухгалтерская операция"" включен флажок 
		|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
		Возврат Ложь;	
	КонецЕсли;		
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДополнительныеРеквизиты.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;
	
	Возврат Истина;
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет указанный документ по договору, по которому указан предмет договора.
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеУслугРабот - заполняемый документ.
// 			- ДанныеФормыСтруктураСКоллекцией - реквизит формы документа "Объект"
// 	ДоговорОснование - СправочникСсылка.Договоры - договор
// 	ЗаполнитьШапку - Булево - Признак необходимости заполнения шапки документа.
Процедура ЗаполнитьПоДоговору(Документ, ДоговорОснование, ЗаполнитьШапку = Ложь) Экспорт
	
	ТипыНоменклатуры = Новый Массив;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.УслугиАренды"));
	
	ПараметрыЗаполнения = РаботаСОбязательствами.ПараметрыПолученияОстатковНФАПоДоговору(Документ);
	ПараметрыЗаполнения.ПолучитьДанныеДоговора = ЗаполнитьШапку;
	ПараметрыЗаполнения.ДоговорОснование       = ДоговорОснование;
	ПараметрыЗаполнения.ТипыНоменклатуры       = ТипыНоменклатуры;

	ОстаткиНФАПоДоговору = РаботаСОбязательствами.ОстатокМЗУслугПоДоговору(ПараметрыЗаполнения);
	
	Если ОстаткиНФАПоДоговору = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполнитьШапку Тогда
		
		ЗаполнитьЗначенияСвойств(Документ, ОстаткиНФАПоДоговору.ДанныеДоговора);
		
		Документ.Договор            = ДоговорОснование;
		Документ.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Документ.СуммаВключаетНДС   = ИСТИНА;
		
	КонецЕсли;
	
	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", Документ.СуммаВключаетНДС);
	
	Для Каждого ОстатокТМЦ Из ОстаткиНФАПоДоговору.ОстаткиНФА Цикл
		
		НоваяСтрока = Документ.УслугиИРаботы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокТМЦ);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
		
	КонецЦикла;
	
	Документ.СуммаДокумента = Документ.УслугиИРаботы.Итог("Всего");
	
КонецПроцедуры

// Заполнить по акту приемки товаров работ услуг.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеУслугРабот
//           - см. Документ.ПоступлениеУслугРабот.Форма.ФормаДокумента.Объект
//  АктПриемкиТРУ - ДокументСсылка.АктПриемкиТоваровРаботУслуг
Процедура ЗаполнитьПоАктуПриемкиТоваровРаботУслуг(Документ, АктПриемкиТРУ) Экспорт
	
	ДанныеАктаПриемкиТРУ = Документы.АктПриемкиТоваровРаботУслуг.ДанныеАктаПриемкиДляВводаПоступленияНФА(АктПриемкиТРУ);
	
	ШапкаАктаПриемки = ДанныеАктаПриемкиТРУ.Шапка;
	Документ.Дата = ШапкаАктаПриемки.Дата;
	Документ.Организация = ШапкаАктаПриемки.Организация;
	Документ.ИФО = ШапкаАктаПриемки.ИФО;
	Документ.Подразделение = ШапкаАктаПриемки.Подразделение;
	Документ.Контрагент = ШапкаАктаПриемки.Контрагент;
	Документ.Договор = ШапкаАктаПриемки.Договор;
	Документ.ВалютаДокумента = ШапкаАктаПриемки.ВалютаДокумента;
	
	Документ.УслугиИРаботы.Очистить();
	ПараметрыРасчетаНДС = Новый Структура("СуммаВключаетНДС", Истина);
	
	Для Каждого СтрокаАктаПриемки Из ДанныеАктаПриемкиТРУ.ТоварыРаботыУслуги Цикл
		НоваяСтрока = Документ.УслугиИРаботы.Добавить();
		НоваяСтрока.Номенклатура = СтрокаАктаПриемки.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = СтрокаАктаПриемки.ЕдиницаИзмерения;
		НоваяСтрока.СтавкаНДС = СтрокаАктаПриемки.СтавкаНДС;
		Если СтрокаАктаПриемки.КоличествоПринято <> СтрокаАктаПриемки.Количество Тогда
			НоваяСтрока.Количество = СтрокаАктаПриемки.КоличествоПринято;
			НоваяСтрока.Сумма = СтрокаАктаПриемки.СуммаПринято;
			// В "Акте приемки товаров, работ, услуг" НДС не включен в сумму,
			// но в "Сумма принято" - включен. Поэтому при пересчете сначала выделяется НДС из "суммы принято",
			// а потом повторно пересчитывается сумма.
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
			НоваяСтрока.Сумма = НоваяСтрока.Всего - НоваяСтрока.СуммаНДС;
		Иначе
			НоваяСтрока.Количество = СтрокаАктаПриемки.Количество;
			НоваяСтрока.Сумма = СтрокаАктаПриемки.Сумма;
			НоваяСтрока.СуммаНДС = СтрокаАктаПриемки.СуммаНДС;
			НоваяСтрока.Всего = СтрокаАктаПриемки.Всего;
		КонецЕсли;
		НоваяСтрока.Содержание = СтрокаАктаПриемки.Содержание;
		НоваяСтрока.КПС = СтрокаАктаПриемки.КПС;
		НоваяСтрока.КЭК = СтрокаАктаПриемки.КЭК;
		НоваяСтрока.КФО = СтрокаАктаПриемки.КФО;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьТабДвиженийДляКарточкиКапвложенийПоДокументуПоставки(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки)
	
	Если Не ДополнительныеРеквизиты.Свойство("ПартияМПЗ")
		Или ТипЗнч(ДополнительныеРеквизиты.ПартияМПЗ) <> Тип("ДокументСсылка.ПоступлениеОС") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеОСКапВложения.КарточкаКапвложений
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.Ссылка = &Ссылка
	|	И ПоступлениеОСКапВложения.ОтразитьВКарточкеКапвложений";
	Запрос.УстановитьПараметр("Ссылка", ДополнительныеРеквизиты.ПартияМПЗ);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ДокументОбъект.Организация;
		НоваяСтрока.КарточкаКапвложений = Выборка.КарточкаКапвложений;
		НоваяСтрока.Период              = ДокументОбъект.Дата;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Акт об оказании услуг / УПД");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	ИнициализироватьЗапросыПоОтражениюАгентскихУслуг(Запрос, НомераТаблиц);

	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеУслугРабот КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюАгентскихУслуг(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ЗакупленныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПоступлениеУслугРабот.Дата КАК Период,
	|	ПоступлениеУслугРабот.Организация КАК Организация,
	|	ПоступлениеУслугРаботУслугиИРаботы.Комитент КАК Контрагент,
	|	ПоступлениеУслугРаботУслугиИРаботы.ДоговорКомитента КАК ДоговорКонтрагента,
	|	ПоступлениеУслугРаботУслугиИРаботы.Номенклатура КАК Номенклатура,
	|	ПоступлениеУслугРабот.Дата КАК ДатаРеализации,
	|	ПоступлениеУслугРабот.Ссылка КАК ДокументРасчетов,
	|	СУММА(ПоступлениеУслугРаботУслугиИРаботы.Количество) КАК Количество,
	|	СУММА(ПоступлениеУслугРаботУслугиИРаботы.Всего) КАК Сумма,
	|	СУММА(ПоступлениеУслугРаботУслугиИРаботы.СуммаНДС) КАК СуммаНДС,
	|	ПоступлениеУслугРабот.Ссылка КАК Партия
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК ПоступлениеУслугРаботУслугиИРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	|		ПО ПоступлениеУслугРаботУслугиИРаботы.Ссылка = ПоступлениеУслугРабот.Ссылка
	|ГДЕ
	|	ПоступлениеУслугРабот.Ссылка = &Ссылка
	|	И ПоступлениеУслугРаботУслугиИРаботы.КомиссионнаяТорговля
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеУслугРаботУслугиИРаботы.Номенклатура,
	|	ПоступлениеУслугРабот.Организация,
	|	ПоступлениеУслугРаботУслугиИРаботы.Комитент,
	|	ПоступлениеУслугРаботУслугиИРаботы.ДоговорКомитента,
