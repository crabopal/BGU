#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормы_Начисления

&НаКлиенте
Процедура НачисленияПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ЭтоНачислениеПоДолгосрочнымДоговорам =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам"));
	Если ЭтоНачислениеПоДолгосрочнымДоговорам Тогда
		БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
			ЭтаФорма, ТекущиеДанные.СчетДБП, НачисленияПоляАналитикиСчетаДБП());
		БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
			ЭтаФорма, ТекущиеДанные.СчетДоходов, НачисленияПоляАналитикиСчетаДоходов());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
		
		Если Копирование Тогда
			ТекущиеДанные.ОстатокДБП = 0;
			ТекущиеДанные.ИДСтроки = "";
			ТекущиеДанные.ИдентификаторЭД = "";
		Иначе
			
			НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
			
			ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
			СтавкаНДС = Неопределено;
			Если УчитываетсяНДС(Объект.НачислениеЗаУслугу, СтавкаНДС) Тогда
				ТекущиеДанные.СтавкаНДС = СтавкаНДС;
			КонецЕсли;
			
			ЭтоНачислениеПоДолгосрочнымДоговорам =
				(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам"));
			Если ЭтоНачислениеПоДолгосрочнымДоговорам Тогда
				
				// По умолчанию основная система налогообложения, доходы от обычных видов деятельности.
				ТекущиеДанные.ВидДеятельностиНУ = ПредопределенноеЗначение(
					"Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения");
				ТекущиеДанные.СчетДоходовНУ = ЭтотОбъект.КэшПараметров.Локальные.СчетДоходовНУПоУмолчанию;
				
				НачисленияРассчитатьКоэффициентСписанияВСтрокеТаблицы(ТекущиеДанные);
				
			Иначе // ПоКраткосрочнымДоговорам
				
				ТекущиеДанные.ПериодНачисленияНачало = НачалоМесяца(Объект.ПериодНачисления);
				ТекущиеДанные.ПериодНачисленияКонец = КонецМесяца(Объект.ПериодНачисления);
				
				Если ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
					
					ТекущиеДанные.НачислениеЗаУслугу = Объект.НачислениеЗаУслугу;
					ТекущиеДанные.СтавкаОплаты = ПолучитьСтавкуОплатыПоНачислению(Объект.НачислениеЗаУслугу, Объект.ПериодНачисления);
					
					ТекущиеДанные.Сумма = РаботаСоСтудентамиКлиентСервер.ПолучитьСуммуНачисленияПоСтроке(Объект, ТекущиеДанные);
					ТекущиеДанные.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(ТекущиеДанные, Объект.СуммаВключаетНДС);
					ТекущиеДанные.Всего = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(ТекущиеДанные, Объект.СуммаВключаетНДС);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	ЭтоНачислениеПоДолгосрочнымДоговорам =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам"));
	Если НЕ ЭтоНачислениеПоДолгосрочнымДоговорам
		И ТекущаяСтрока <> Неопределено
		И ЗначениеЗаполнено(ТекущаяСтрока.СтавкаОплаты) Тогда
		ТекущаяСтрока.Сумма = РаботаСоСтудентамиКлиентСервер.ПолучитьСуммуНачисленияПоСтроке(Объект, ТекущаяСтрока);
		ТекущаяСтрока.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(ТекущаяСтрока, Объект.СуммаВключаетНДС);
		ТекущаяСтрока.Всего = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(ТекущаяСтрока, Объект.СуммаВключаетНДС);
	КонецЕсли;
	
	ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтудентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату", Объект.Дата);
	
	Если ЗначениеЗаполнено(Объект.Факультет) Тогда
		ТекущиеДанные.Факультет = Объект.Факультет;
		Отбор.Вставить("Факультет", Объект.Факультет);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
		ТекущиеДанные.НачислениеЗаУслугу = Объект.НачислениеЗаУслугу;
		Отбор.Вставить("НачислениеЗаУслугу", Объект.НачислениеЗаУслугу);
	КонецЕсли;
	
	ПараметрыАвтоподстановки = ПараметрыАвтоподстановкиДанныхПоСтуденту(ТекущиеДанные.Студент, Отбор);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ПараметрыАвтоподстановки, "ПорядокВыпискиСФ");
	
	Если ПараметрыАвтоподстановки.Договоры.Количество() = 1 Тогда
		ТекущиеДанные.ДоговорКонтрагента = ПараметрыАвтоподстановки.Договоры[0]; // Единственный доступный вариант.
		НачисленияДоговорКонтрагентаПриИзменении(Элемент);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДоговорКонтрагента) И ПараметрыАвтоподстановки.Договоры.Найти(ТекущиеДанные.ДоговорКонтрагента) = Неопределено Тогда
		ТекущиеДанные.ДоговорКонтрагента = Неопределено; // Выбранный договор отсутствует среди доступных.
		НачисленияДоговорКонтрагентаПриИзменении(Элемент);
	КонецЕсли;
	Если ПараметрыАвтоподстановки.Плательщики.Количество() = 1 Тогда
		ТекущиеДанные.Контрагент = ПараметрыАвтоподстановки.Плательщики[0]; // Единственный доступный вариант.
		НачисленияКонтрагентПриИзменении(Элемент);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Контрагент) И ПараметрыАвтоподстановки.Плательщики.Найти(ТекущиеДанные.Контрагент) = Неопределено Тогда
		ТекущиеДанные.Контрагент = Неопределено; // Выбранный контрагент отсутствует среди доступных.
		НачисленияКонтрагентПриИзменении(Элемент);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Факультет) Тогда
		Если ПараметрыАвтоподстановки.Факультеты.Количество() = 1 Тогда
			ТекущиеДанные.Факультет = ПараметрыАвтоподстановки.Факультеты[0]; // Единственный доступный вариант.
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Факультет) И ПараметрыАвтоподстановки.Факультеты.Найти(ТекущиеДанные.Факультет) = Неопределено Тогда
			ТекущиеДанные.Факультет = Неопределено; // Выбранный факультет отсутствует среди доступных.
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
		Если ПараметрыАвтоподстановки.ПрочиеУслуги.Количество() = 1  Тогда
			ТекущиеДанные.НачислениеЗаУслугу = ПараметрыАвтоподстановки.ПрочиеУслуги[0]; // Единственный доступный вариант.
			НачисленияНачислениеПриИзменении(Элемент);
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.НачислениеЗаУслугу) И ПараметрыАвтоподстановки.ПрочиеУслуги.Найти(ТекущиеДанные.НачислениеЗаУслугу) = Неопределено Тогда
			ТекущиеДанные.НачислениеЗаУслугу = Неопределено; // Выбранная прочая услуга отсутствует среди доступных.
			НачисленияНачислениеПриИзменении(Элемент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКонтрагентПриИзменении(Элемент)
	
	Если Не Объект.УчитыватьНДС Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Контрагент.Пустая() Тогда
		
		Если  ТекВидКонтрагента(ТекущаяСтрока.Контрагент) = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
			
			Если ТекущаяСтрока.ПорядокВыпискиСФ <> ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.НаПлательщика") Тогда
				
				Если ТекущаяСтрока.ПорядокВыпискиСФ.Пустая() Тогда
					
					ТекущаяСтрока.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.НаПлательщика");
					
				Иначе
					
					ТекстВопроса = НСтр("ru='Установить порядок выписки счет-фактуры ""на плательщика""?'");
					
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
					ДопПараметры.Вставить("Значение", ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.НаПлательщика"));
					
					Оповещение = Новый ОписаниеОповещения("ВопросОбУстановкеПорядкаВыпискиСФ", ЭтотОбъект, ДопПараметры);
					ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
				
				КонецЕсли; 
				
				
			КонецЕсли;
			
			//Электронные документы (акты)
			НастройкаДоступностиЭДО();
			
			ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(ТекущаяСтрока.Контрагент);
			ТекущаяСтрока.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
			ТекущаяСтрока.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
			
		Иначе
			
			Если ТекущаяСтрока.ПорядокВыпискиСФ <> ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно") Тогда
				
				Если ТекущаяСтрока.ПорядокВыпискиСФ.Пустая() Тогда
					
					ТекущаяСтрока.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно");
					
				Иначе
					
					ТекстВопроса = НСтр("ru='Установить порядок выписки счет-фактуры ""сводно""?'");
					
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
					ДопПараметры.Вставить("Значение", ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно"));
					
					Оповещение = Новый ОписаниеОповещения("ВопросОбУстановкеПорядкаВыпискиСФ", ЭтотОбъект, ДопПараметры);
					ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ДоговорКонтрагента) Тогда
		
