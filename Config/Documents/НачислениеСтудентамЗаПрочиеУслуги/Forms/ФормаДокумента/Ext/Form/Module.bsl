&НаКлиенте
Процедура НачисленияСчетДБППриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.КЭК) Тогда // По умолчанию КЭК 131.
		ТекущиеДанные.КЭК = ЭтотОбъект.КэшПараметров.Локальные.КЭКПоУмолчанию;
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетДБП, НачисленияПоляАналитикиСчетаДБП());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетДБП, НачисленияПоляАналитикиСчетаДБП());
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСчетДБПНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ТекущийСчет = Новый Структура("Счет, КПС, КФО");
	ТекущийСчет.Счет = ТекущиеДанные.СчетДБП;
	ТекущийСчет.КПС  = ТекущиеДанные.КПС;
	ТекущийСчет.КФО  = ТекущиеДанные.КФО;
	
	ОграниченияСписокСчетов = Новый СписокЗначений;
	ОграниченияСписокСчетов.Добавить("401.40");
	
	ОграниченияКПС = Новый Массив;
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка,
		ТекущийСчет, Объект.Организация, Объект.ИФО, ОграниченияСписокСчетов, ТекущиеДанные.КФО, ОграниченияКПС, Объект.Дата,, );
	
КонецПроцедуры

