&НаКлиенте
Процедура ВопросОбУстановкеПорядкаВыпискиСФ(РезультатОтвет, ДопПараметры) Экспорт
	ТекущаяСтрока = ДопПараметры.ТекущаяСтрока;
	Значение = ДопПараметры.Значение;
	
	Если РезультатОтвет = КодВозвратаДиалога.Да Тогда
		ТекущаяСтрока.ПорядокВыпискиСФ = Значение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтудентамиПоОтбору(Результат, ДопПараметры) Экспорт
	Адреса = ДопПараметры.Адреса;
	ИмяМакета = ДопПараметры.ИмяМакета;
	
	Если Результат <> Неопределено Тогда
		
		Адреса.НастройкиКомпоновкиДанных = Результат;
		ЗаполнитьСтудентамиСервер(Адреса, ИмяМакета);
		
	КонецЕсли;
	
	//Электронные документы (акты)
	НастройкаДоступностиЭДО();
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(СтрТЧ.Контрагент);
		СтрТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		СтрТЧ.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборНачисленияВСтрокеТабличнойЧасти(Результат, ДопПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
		
		Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДопПараметры);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ПорядокВыпискиСФ) Тогда
			ТекущиеДанные.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОчисткуТабличнойЧасти(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИмяМакета = ДопПараметры.ИмяМакета;
		
		Объект.Начисления.Очистить();
		
		ОткрытьФормуОтбора(ИмяМакета);
	КонецЕсли;
КонецПроцедуры

