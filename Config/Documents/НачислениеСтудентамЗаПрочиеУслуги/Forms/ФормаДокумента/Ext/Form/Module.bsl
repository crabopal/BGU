&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетДоходовНУПоУмолчанию",
		БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КЭКПоУмолчанию",
		БухгалтерскийУчетПовтИсп.КЭКПоКоду("131"));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НастройкиСчетовУчетаДБП",
		УчетДоходовРасходов.НастройкиСчетовУчетаДБП());
	
	ЗаполнитьСлужебныеРеквизитыТаблицы();
	НачисленияЗаполнитьДобавленныеКолонки();
	
	КонтрольИсполненияДоговоров.ЗаполнитьДоступныеСтатусыДокументов(
		Элементы.НачисленияОтразитьВГрафикеИсполненияДоговора.СписокВыбора, Ложь);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Счета учета доступен для редактирования только в строках, введенных вручную.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияКПС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияКФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияСчетДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияКЭК");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ОстатокДБП", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Доходы будущих периодов в валюте.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияОстатокДБПВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияСуммаРуб");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВсегоРуб");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВалютаРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВалютаРеглУчета");
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.Начисления.СчетДБПВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.Начисления.ВалютаРасчетов", ВидСравненияКомпоновкиДанных.Равно, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Статья прочих доходов (НУ).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияСтатьяПрочихДоходовНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.СчетДоходовНУ",
			ВидСравненияКомпоновкиДанных.НеРавно, БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	// Параметры списания ДБП.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияДатаНачалаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияДатаОкончанияСписания");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.СпособПризнанияДоходов",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// КонтрольИсполненияДоговоров
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияОтразитьВГрафикеИсполненияДоговора");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ВестиПланГрафикИсполнения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не ведется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	// Конец КонтрольИсполненияДоговоров
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДоговоров(Договора)
	
	Если ТипЗнч(Договора) = Тип("СправочникСсылка.Договоры") Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Договора);
	Иначе
		Ссылки = Договора;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ссылки, "Ссылка,ВидДоговора,ВестиПланГрафикИсполнения");
	
