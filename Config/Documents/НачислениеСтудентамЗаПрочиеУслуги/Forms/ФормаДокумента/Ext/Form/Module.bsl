#Область ГрупповаяОтправкаЭлектронныхДокументовПоЭДО

&НаСервере
Процедура НастройкаДоступностиЭДО()
	СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору();
	
	//Электронные документы (акты)
	ЕстьЭлектронныеАкты = Ложь;
	ВыгружатьЭДОВФайлыБезНастроекЭДО = ЭлектронныеДокументыБГУ.УПДФормироватьСтатус1ПриОтсутствииНастройкиЭДО(Объект.Организация);
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(СтрТЧ.Контрагент);
		СтрТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		Если ВидимостьЭлементовЭДО Тогда
			ЕстьЭлектронныеАкты = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СоздатьЭлектронныеДокументы", "Видимость", ЕстьЭлектронныеАкты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СоздатьПередаточныеДокументыДляЭДО", "Видимость", ЕстьЭлектронныеАкты ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияШагПервый", "Видимость", ЕстьЭлектронныеАкты ИЛИ (ВыгружатьЭДОВФайлыБезНастроекЭДО И Объект.УчитыватьНДС));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияШагВторой", "Видимость", ЕстьЭлектронныеАкты ИЛИ (ВыгружатьЭДОВФайлыБезНастроекЭДО И Объект.УчитыватьНДС));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияШагТретий", "Видимость", ЕстьЭлектронныеАкты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"РеквизитыЛицевогоСчета", "Видимость", ЕстьЭлектронныеАкты ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НачисленияГруппаЭДО", "Видимость", ЕстьЭлектронныеАкты ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПередаточныеДокументыДляЭДОНаСервере()
	СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору();
	
	ЕстьЗамечания = Ложь;
	Для Каждого ТекСтрока Из Объект.Начисления Цикл
		Если ТекСтрока.ОформлятьЭД И НЕ ЗначениеЗаполнено(ТекСтрока.ИдентификаторЭД) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнены идентификаторы строк. Следует перезаписать документ и повторить попытку создания.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			
			Возврат;
		КонецЕсли;
		Если ТекСтрока.ОформлятьЭД Тогда
			Если ТекСтрока.Всего = 0 Тогда
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена сумма передаточного документа для строки %1. Следует заполнить данные и повторить попытку создания.'"), 
					ТекСтрока.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
				
				ЕстьЗамечания = Истина;
			КонецЕсли;
			
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.НачислениеЗаУслугу, "Номенклатура");
			НоменклатураУслуги = СтруктураДанных.Номенклатура;
			
			Если НЕ ЗначениеЗаполнено(НоменклатураУслуги) Тогда
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена номенклатура для начисления за услугу для строки %1. Следует заполнить данные и повторить попытку создания.'"), 
					ТекСтрока.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
				
				ЕстьЗамечания = Истина;
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	Если ЕстьЗамечания Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из Объект.Начисления Цикл
		Если ТекСтрока.ОформлятьЭД Тогда
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
			ДанныеЗаполнения.Вставить("Дата", Объект.Дата);
			ДанныеЗаполнения.Вставить("Организация", Объект.Организация);
			ДанныеЗаполнения.Вставить("Ответственный", Объект.Ответственный);
			
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.НачислениеЗаУслугу, "Номенклатура");
			НоменклатураУслуги = СтруктураДанных.Номенклатура;
			
			ДанныеЗаполнения.Вставить("Номенклатура", НоменклатураУслуги);
			ДанныеЗаполнения.Вставить("СуммаДокумента", ТекСтрока.Всего);
			ДанныеЗаполнения.Вставить("Контрагент", ТекСтрока.Контрагент);
			ДанныеЗаполнения.Вставить("Договор", ТекСтрока.ДоговорКонтрагента);
			ДанныеЗаполнения.Вставить("РеквизитыЛицевогоСчета", Объект.РеквизитыЛицевогоСчета);
			ДанныеЗаполнения.Вставить("СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора", СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора);
			
			РеквизитыДоговора = "КПСПродавца, КодЦелиПродавца";
			ЗначенияРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.ДоговорКонтрагента, РеквизитыДоговора);
			ДанныеЗаполнения.Вставить("КПСПродавца", ЗначенияРеквизитовДоговора.КПСПродавца);
			ДанныеЗаполнения.Вставить("КодЦелиПродавца", ЗначенияРеквизитовДоговора.КодЦелиПродавца);
			
			СоздатьПередаточныйДокументЭД(ТекСтрока.ИдентификаторЭД, ДанныеЗаполнения);
			
			ТекСтрока.ПередаточныйДокументЭД = НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ТекСтрока.ИдентификаторЭД, 
				ТекСтрока.Контрагент,
				ТекСтрока.ДоговорКонтрагента);
		КонецЕсли;	
	КонецЦикла;
	
	ПоказатьПередаточныеДокументыЭДО();
	
	НачисленияЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Функция НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ИдентификаторЭД, КонтрагентЭД, ДоговорЭД)
	
	Результат = ЭлектронныеДокументыБГУ.НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ИдентификаторЭД, КонтрагентЭД, ДоговорЭД);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиПередаточныйДокументЭДПоКонтрагентуИДоговору(ДокументОснованиеЭД, КонтрагентЭД, ДоговорЭД)
	
	Результат = ЭлектронныеДокументыБГУ.НайтиПередаточныйДокументЭДПоКонтрагентуИДоговору(ДокументОснованиеЭД, КонтрагентЭД, ДоговорЭД);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьПередаточныйДокументЭД(ИдентификаторЭД, ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
		СсылкаНаВладельца = НайтиПередаточныйДокументЭДПоКонтрагентуИДоговору(ДанныеЗаполнения.ДокументОснование, ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.Договор);
	Иначе	
		СсылкаНаВладельца = НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ИдентификаторЭД, ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.Договор);
	КонецЕсли;	
		
	Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для контрагента ""%1"" по ""%2"" для номенклатуры ""%3"" на сумму %4 не удалось заполнить передаточный документ'"), 
		ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.Договор, ДанныеЗаполнения.Номенклатура, ДанныеЗаполнения.СуммаДокумента);
	
	РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
	НачатьТранзакцию();
	
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			
			Если ДанныеЗаполнения.СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
				НайденнаяСтрока = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Найти(ИдентификаторЭД, "ИдентификаторЭД");
				Если НайденнаяСтрока = Неопределено Тогда
					НоваяСтрока = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Добавить();
					НоваяСтрока.ИдентификаторЭД = ИдентификаторЭД;
					НоваяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
				Иначе
					НайденнаяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйПередаточныйДокументУслугиРаботы.СоздатьДокумент();
			ДокументОбъект.Дата = ДанныеЗаполнения.Дата;
			ДокументОбъект.УстановитьНовыйНомер();
			
			Если ДанныеЗаполнения.СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
				ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
				ДокументОбъект.РеквизитыЛицевогоСчета = ДанныеЗаполнения.РеквизитыЛицевогоСчета;
				ДокументОбъект.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
				ДокументОбъект.Ответственный = ДанныеЗаполнения.Ответственный;
				ДокументОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
				ДокументОбъект.Договор = ДанныеЗаполнения.Договор;
				ДокументОбъект.КПСПродавца = ДанныеЗаполнения.КПСПродавца;
				ДокументОбъект.КодЦелиПродавца = ДанныеЗаполнения.КодЦелиПродавца;
				
				НоваяСтрока = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Добавить();
				НоваяСтрока.ИдентификаторЭД = ИдентификаторЭД;
				НоваяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.РеквизитыЛицевогоСчета) Тогда
				ЛицевойСчетОрганизиции = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(ДанныеЗаполнения.Организация,
					"Документ.ЗаявкаНаВозврат", ДанныеЗаполнения.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
				Если ЗначениеЗаполнено(ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета) Тогда
					ДокументОбъект.РеквизитыЛицевогоСчета = ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета;
				КонецЕсли;	
			КонецЕсли;
			
			Если ЭлектронныеДокументыБГУ.УПДЗаполнятьДатуПередачиПоДатеДокументаРеализации(Объект.Организация) Тогда
				
				ДокументОбъект.ДатаПередачиТРУ = ДанныеЗаполнения.Дата;
				ДокументОбъект.ТРУПереданы = Истина;
				
			КонецЕсли;  
			
			СведенияПоОтветственному = ЭлектронныеДокументыБГУ.ПолучитьСведенияОтветственныхЭлектронныУПД(Объект.Организация);
			
			Если ЗначениеЗаполнено(СведенияПоОтветственному) Тогда
				
				ДокументОбъект.ОтветственныйПередалТРУ 						= СведенияПоОтветственному.ОтветственныйПередалТРУ;	
				ДокументОбъект.ОтветственныйПередалТРУВид 					= СведенияПоОтветственному.ОтветственныйПередалТРУВид;
				ДокументОбъект.ОтветственныйПередалТРУДоверенность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДоверенность;
				ДокументОбъект.ОтветственныйПередалТРУДолжность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДолжность;
				ДокументОбъект.ОтветственныйПередалТРУИныеСведения 			= СведенияПоОтветственному.ОтветственныйПередалТРУИныеСведения;
				ДокументОбъект.ОтветственныйПередалТРУКонтрагент 			= СведенияПоОтветственному.ОтветственныйПередалТРУКонтрагент;
				ДокументОбъект.ОтветственныйПередалТРУДокументПолномочий 	= СведенияПоОтветственному.ОтветственныйПередалТРУДокументПолномочий;
                ДокументОбъект.ОтветственныйПередалТРУОснованиеПолномочий 	= "";
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ДанныеЗаполнения.СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
			ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
			ДокументОбъект.РеквизитыЛицевогоСчета = ДанныеЗаполнения.РеквизитыЛицевогоСчета;
			ДокументОбъект.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
			ДокументОбъект.Ответственный = ДанныеЗаполнения.Ответственный;
			ДокументОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
			ДокументОбъект.Договор = ДанныеЗаполнения.Договор;
			ДокументОбъект.КПСПродавца = ДанныеЗаполнения.КПСПродавца;
			ДокументОбъект.КодЦелиПродавца = ДанныеЗаполнения.КодЦелиПродавца;
			
			НайденнаяСтрока = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Найти(ИдентификаторЭД, "ИдентификаторЭД");
			Если НайденнаяСтрока = Неопределено Тогда
				НоваяСтрока = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Добавить();
				НоваяСтрока.ИдентификаторЭД = ИдентификаторЭД;
				НоваяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
			Иначе
				НайденнаяСтрока.Сумма = ДанныеЗаполнения.СуммаДокумента;
			КонецЕсли;	
		КонецЕсли;
		
		ДокументОбъект.СуммаДокумента = ДокументОбъект.ИдентификаторыСтрокДокументаОснования.Итог("Сумма");
		
		ДокументОбъект.Записать(РежимЗаписи, РежимПроведенияДокумента.Неоперативный);
		ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа для ЭДО %1 '"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПередаточныеДокументыЭДО()
	ПередаточныеДокументы = Новый Массив;
	Для Каждого ТекСтрока Из Объект.Начисления Цикл
		ПередаточныйДокументЭД = НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ТекСтрока.ИдентификаторЭД,
			ТекСтрока.Контрагент,
			ТекСтрока.ДоговорКонтрагента);
		
		ТекСтрока.ПередаточныйДокументЭД = ПередаточныйДокументЭД;
		Если ЗначениеЗаполнено(ПередаточныйДокументЭД) Тогда
			ПередаточныеДокументы.Добавить(ПередаточныйДокументЭД);
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПередаточныйДокументЭД, "Номер, Дата");
			НаименованиеДокументаЭД = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '№ %1 от %2'"), 
				СтруктураДанных.Номер, Формат(СтруктураДанных.Дата, "ДФ=dd.MM.yyyy"));

			ТекСтрока.ПередаточныйДокументЭДНаименование = НаименованиеДокументаЭД;
			ТекСтрока.ПросмотретьЭД = НСтр("ru = 'Открыть'");
		Иначе
			ТекСтрока.ПросмотретьЭД = "";
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьСостоянияЭД(ПередаточныеДокументы);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостоянияЭД(ПередаточныеДокументы)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияЭД.СсылкаНаОбъект КАК СсылкаНаОбъект,
	               |	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭД
	               |ИЗ
	               |	РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
	               |ГДЕ
	               |	СостоянияЭД.СсылкаНаОбъект В(&ДокументыЭД)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СостоянияЭД.Дата УБЫВ";
	Запрос.УстановитьПараметр("ДокументыЭД", ПередаточныеДокументы);
	
	СостоянияВсехЭД = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из Объект.Начисления Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ПередаточныйДокументЭД) Тогда
			НайденнаяСтрока = СостоянияВсехЭД.Найти(ТекСтрока.ПередаточныйДокументЭД, "СсылкаНаОбъект");
			Если НайденнаяСтрока = Неопределено Тогда
				ТекСтрока.СостояниеЭД = "";
			Иначе
				ТекСтрока.СостояниеЭД = НайденнаяСтрока.СостояниеЭД;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПередаточныйДокументЭД(ВыбранноеЗначение)
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ПередаточныйДокументЭД) Тогда
		ПараметрыФормыПередаточныйДокументЭД = Новый Структура;
		ПараметрыФормыПередаточныйДокументЭД.Вставить("Ключ", ДанныеСтроки.ПередаточныйДокументЭД);
		ОткрытьФорму("Документ.ЭлектронныйПередаточныйДокументУслугиРаботы.Форма.ФормаДокумента", ПараметрыФормыПередаточныйДокументЭД);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭД(ВыбранноеЗначение)
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ПередаточныйДокументЭД) Тогда
		ОбменСКонтрагентамиКлиент.ОткрытьАктуальныйЭлектронныйДокумент(ДанныеСтроки.ПередаточныйДокументЭД);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВидимостьЭлементовЭДОДляСтроки(Контрагент)

	Возврат ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Контрагент, Объект.Организация);
	
КонецФункции

&НаСервере
Процедура ОбновитьВидимостьДекорацийКомандЭДОДокумента()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияШагПервый", "Видимость", ЕстьЭлектронныеАкты ИЛИ (ВыгружатьЭДОВФайлыБезНастроекЭДО И Объект.УчитыватьНДС));
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияШагВторой", "Видимость", ЕстьЭлектронныеАкты ИЛИ (ВыгружатьЭДОВФайлыБезНастроекЭДО И Объект.УчитыватьНДС));
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервереДляГруппыЭД(ТекущийОбъект)
	
	СоздаватьПередаточныеДокументыПоКонтрагентуИДоговору = ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору();
	
	ИдентификаторыЭД = ТекущийОбъект.Начисления.Выгрузить();
	ИдентификаторыЭД.Свернуть("Контрагент, ДоговорКонтрагента, ИдентификаторЭД", "Сумма");
	
	Для Каждого ТекСтрока Из ИдентификаторыЭД Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ИдентификаторЭД) Тогда
			ТекСтрока.ИдентификаторЭД = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;	
	
	//Электронные документы (акты)
	Для Каждого СтрТЧ Из ТекущийОбъект.Начисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторЭД) Тогда
			Если СоздаватьПередаточныеДокументыПоКонтрагентуИДоговору Тогда
				ПараметрыПоиска = Новый Структура();
				ПараметрыПоиска.Вставить("Контрагент", СтрТЧ.Контрагент);
				ПараметрыПоиска.Вставить("ДоговорКонтрагента", СтрТЧ.ДоговорКонтрагента);
				НайденнаяСтрока = ИдентификаторыЭД.НайтиСтроки(ПараметрыПоиска);
				Если НЕ НайденнаяСтрока = Неопределено Тогда
					СтрТЧ.ИдентификаторЭД = НайденнаяСтрока[0].ИдентификаторЭД;
				КонецЕсли;	
			Иначе	
				СтрТЧ.ИдентификаторЭД = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору()
	Возврат ЭлектронныеДокументыБГУ.ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(Объект.Ссылка);
КонецФункции	

#КонецОбласти

