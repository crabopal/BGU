&НаСервереБезКонтекста
Функция ПолучитьПорядокВыпискиСФ(Студент, НачислениеЗаУслугу, Плательщик, ПериодНачисления)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СведенияОПрочихУслугахСтудентам.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	               |ИЗ
	               |	РегистрСведений.СведенияОПрочихУслугахСтудентам КАК СведенияОПрочихУслугахСтудентам
	               |ГДЕ
	               |	СведенияОПрочихУслугахСтудентам.Студент = &Студент
	               |	И СведенияОПрочихУслугахСтудентам.НачислениеСтудентамЗаПрочиеУслуги = &Начисление
	               |	И ВЫБОР
	               |			КОГДА (ВЫРАЗИТЬ(&Плательщик КАК Справочник.Контрагенты)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |				ТОГДА СведенияОПрочихУслугахСтудентам.Плательщик = &Плательщик
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И (СведенияОПрочихУслугахСтудентам.НачалоНачисления < &НачалоПериода
	               |			ИЛИ СведенияОПрочихУслугахСтудентам.НачалоНачисления МЕЖДУ &НачалоПериода И &КонецПериода)
	               |	И (СведенияОПрочихУслугахСтудентам.ОкончаниеНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ИЛИ СведенияОПрочихУслугахСтудентам.ОкончаниеНачисления > &КонецПериода
	               |			ИЛИ СведенияОПрочихУслугахСтудентам.ОкончаниеНачисления МЕЖДУ &НачалоПериода И &КонецПериода)";
				   
	Запрос.УстановитьПараметр("Студент", Студент);
	Запрос.УстановитьПараметр("Начисление", НачислениеЗаУслугу);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодНачисления));
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ПорядокВыпискиСФ;
	Иначе
		Возврат Перечисления.ПорядокВыпискиСФЗаУслуги.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаполнитьГраницыПериодаВСтроках()
	Для Каждого Стр Из Объект.Начисления Цикл
		Стр.ПериодНачисленияНачало = НачалоМесяца(Объект.ПериодНачисления);
		Стр.ПериодНачисленияКонец = КонецМесяца(Объект.ПериодНачисления);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтбора(ИмяМакета)
	Адреса = ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище(ИмяМакета);
	
	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = НСтр("ru = 'Настройка параметров отбора учащихся'");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Адреса", Адреса);
	ДопПараметры.Вставить("ИмяМакета", ИмяМакета);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСтудентамиПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы, ЭтаФорма, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ВычислитьКоличествоДней()
	Объект.КоличествоРабочихДней = День(КонецМесяца(Объект.ПериодНачисления));
КонецПроцедуры

&НаСервереБезКонтекста
Функция УчитываетсяНДС(Начисление, СтавкаНДС = Неопределено)
	Если Начисление.УчитыватьНДС Тогда
		СтавкаНДС = Начисление.СтавкаНДС;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтавкуОплатыПоНачислению(Начисление, ДатаСреза)
	СтавкиОплаты = РегистрыСведений.ПараметрыНачисленийЗаПрочиеУслугиСтудентам.СрезПоследних(НачалоМесяца(ДатаСреза), Новый Структура("НачислениеСтудентамЗаПрочиеУслуги", Начисление));
	
	Если СтавкиОплаты.Количество() > 0 Тогда
		Возврат СтавкиОплаты[0].СтавкаОплаты;
	Иначе
		Возврат Справочники.СтавкиОплатыОбразование.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьКолонки()
	Элементы.НачисленияНачислениеЗаУслугу.Видимость = Не ЗначениеЗаполнено(Объект.НачислениеЗаУслугу);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыТаблицы()
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ОшибкаПериода", "ВЫБОР КОГДА ТаблицаДанных.ПериодНачисленияНачало > ТаблицаДанных.ПериодНачисленияКонец ИЛИ НАЧАЛОПЕРИОДА(ТаблицаДанных.ПериодНачисленияНачало, МЕСЯЦ) <> НАЧАЛОПЕРИОДА(ТаблицаДанных.ПериодНачисленияКонец, МЕСЯЦ) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ");
	СтруктураЗаполнения.Вставить("Всего", "ТаблицаДанных.Сумма" + ?(Объект.СуммаВключаетНДС, "", " + ТаблицаДанных.СуммаНДС"));
	      
	РаботаСоСтудентами.ЗаполнитьСлужебныеРеквизитыТаблицы(Объект.Начисления, СтруктураЗаполнения);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище(ИмяМакетаСбораДанных)
	
	Адреса = Новый Структура("СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных");
	
	СхемаКомпоновкиДанных = Документы.НачислениеСтудентамЗаПрочиеУслуги.ПолучитьМакет(ИмяМакетаСбораДанных);
	Адреса.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	Если ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
		НастройкиКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		ОтборКомпоновки = НастройкиКомпоновки.Отбор;
		
		ПолеНачисление = Новый ПолеКомпоновкиДанных("НачислениеЗаУслугу");
		ЭлементНайден = Ложь;
		
		Для Каждого ЭлементОтбора Из ОтборКомпоновки.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ПолеНачисление Тогда
				ЭлементНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЭлементНайден Тогда
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ПравоеЗначение = Объект.НачислениеЗаУслугу;
			ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
			Адреса.НастройкиКомпоновкиДанных = ПоместитьВоВременноеХранилище(НастройкиКомпоновки, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Адреса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтудентамиСервер(Адреса, ИмяМакета)
		
	ПараметрыРасчета = РаботаСоСтудентами.ПолучитьСтруктуруПараметровРасчета();
	ПараметрыРасчета.Период = Объект.ПериодНачисления;
	ПараметрыРасчета.Факультет = Объект.Факультет;
	ПараметрыРасчета.Валюта = Объект.ВалютаДокумента;
	ПараметрыРасчета.НастройкиКомпоновкиДанных = Адреса.НастройкиКомпоновкиДанных;
	ПараметрыРасчета.ВидНачисления = "НачислениеСтудентамЗаПрочиеУслуги";
	
	ПараметрыРасчета.Вставить("ИмяМакета", ИмяМакета);
	ПараметрыРасчета.Вставить("Организация", Объект.Организация);
	ПараметрыРасчета.Вставить("Номенклатура", Объект.НачислениеЗаУслугу.Номенклатура);
	ПараметрыРасчета.Вставить("ВидОперации",  Объект.ВидОперации);
	ПараметрыРасчета.Вставить("ИФО", Объект.ИФО);
	
	ДанныеРасчета = РаботаСоСтудентами.РассчитатьНачисления(ПараметрыРасчета);
	
	// Ставка НДС по умолчанию.
	Если ДанныеРасчета.Колонки.Найти("СтавкаНДС") = Неопределено Тогда
		ДанныеРасчета.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	КонецЕсли;
	СтавкаНДСПоУмолчанию = ?(Объект.УчитыватьНДС И ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) И ЗначениеЗаполнено(Объект.НачислениеЗаУслугу.СтавкаНДС),
		Объект.НачислениеЗаУслугу.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
	ДанныеРасчета.ЗаполнитьЗначения(СтавкаНДСПоУмолчанию, "СтавкаНДС");
	
	Объект.Начисления.Загрузить(ДанныеРасчета);
	
	ПроверитьДополнитьДанныеДляНачисления();
	НачисленияЗаполнитьДобавленныеКолонки();

	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДополнитьДанныеДляНачисления()
	
	ШаблонПлательщик = НСтр("ru='Для учащегося ""%1"" не указан плательщик для периода расчета с %2 по %3'");
	ШаблонСтавка = НСтр("ru='Для учащегося ""%1"" не указана ставка оплаты для периода расчета с %2 по %3'");
	ШаблонФакультет = НСтр("ru='Для учащегося ""%1"" по прочим услугам указано начисление по факультету основного обучения. 
						|При этом записей о зачислении по основной образовательной деятельности найдено: %2'");
	
	Для каждого СтрокаНачисления Из Объект.Начисления Цикл
		
		Если Объект.ВидОперации <> Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам Тогда
			
			Если СтрокаНачисления.Контрагент.Пустая() Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПлательщик,
					СтрокаНачисления.Студент, 
					Формат(СтрокаНачисления.ПериодНачисленияНачало, "ДЛФ=DD"),
					Формат(СтрокаНачисления.ПериодНачисленияКонец, "ДЛФ=DD"));
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "Контрагент");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект");
				
			КонецЕсли;
			
			Если СтрокаНачисления.СтавкаОплаты.Пустая() Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтавка, 
					СтрокаНачисления.Студент, 
					Формат(СтрокаНачисления.ПериодНачисленияНачало, "ДЛФ=DD"),
					Формат(СтрокаНачисления.ПериодНачисленияКонец, "ДЛФ=DD"));
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "СтавкаОплаты");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект");
				
			КонецЕсли;
			
			Если СтрокаНачисления.ФакультетыПоОсновнойДеятельности = Истина И СтрокаНачисления.КоличествоФакультетов <> 1 Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонФакультет, 
					СтрокаНачисления.Студент, 
					СтрокаНачисления.КоличествоФакультетов);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "Студент");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект");
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаНачисления.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаНачисления, Объект.СуммаВключаетНДС);
		СтрокаНачисления.Всего = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтрокаНачисления, Объект.СуммаВключаетНДС);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьУчетаНДС()
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("НачисленияСтавкаНДС");
	МассивЭлементов.Добавить("НачисленияСуммаНДС");
	МассивЭлементов.Добавить("НачисленияГруппаВсего");
	МассивЭлементов.Добавить("НачисленияПорядокВыпискиСФ");
	МассивЭлементов.Добавить("УправлениеСчетФактурамиПечати");
	МассивЭлементов.Добавить("ИтогиВсегоНДС");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Объект.УчитыватьНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьНадписьНДСВалюта(Форма)
	
	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ВалютаДокумента, Курс, Кратность, УчитыватьНДС, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НДСВалюта = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоги(Форма)

	Форма.ИтогиВсего    = Форма.Объект.Начисления.Итог("Всего");
	Форма.ИтогиВсегоНДС = Форма.Объект.Начисления.Итог("СуммаНДС");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОпределитьКорректностьПериода(СтрокаДанных)
	
	СтрокаДанных.ОшибкаПериода = (СтрокаДанных.ПериодНачисленияНачало > СтрокаДанных.ПериодНачисленияКонец 
	                          ИЛИ НачалоМесяца(СтрокаДанных.ПериодНачисленияНачало) <> НачалоМесяца(СтрокаДанных.ПериодНачисленияКонец));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыВыбораСтавкиОплаты(ЭлементСтавкаОплаты, СтруктураПараметров)
	
	НовыеПараметрыВыбора = Новый Массив;
	
	НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Валюта", СтруктураПараметров.Валюта)); 
	
	ЭлементСтавкаОплаты.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьФакультета()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Факультет", "Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаКлиенте
Функция ЗаполнениеСтудентамиВозможно(СУчетомФакультета = Истина)

	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	Если Объект.Организация.Пустая() Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Организация"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Организация", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если СУчетомФакультета И НЕ ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Факультет"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если НЕ СУчетомФакультета И ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Для заполнения без учета факультета поле ""Факультет"" должно быть пустым!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ПериодНачисления) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Период начисления"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "ПериодНачисленияСтрокой",, Отказ);		
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Валюта документа"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "НДСВалюта",, Отказ);		
		
	КонецЕсли;

	Возврат НЕ Отказ;

КонецФункции // ЗаполнениеВозможно()

&НаСервереБезКонтекста
