&НаКлиенте
Процедура ЗаполнитьСтудентами(Команда)
			
	Если ЗаполнениеСтудентамиВозможно() Тогда
		
		Если Объект.Начисления.Количество() > 0 Тогда
			ДопПараметры = Новый Структура("ИмяМакета", "СборДанныхНачислений");
			
			Оповещение = Новый ОписаниеОповещения("ЗапроситьОчисткуТабличнойЧасти", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru='Табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Иначе
			ОткрытьФормуОтбора("СборДанныхНачислений");
		КонецЕсли;
		
	КонецЕсли;  
		
КонецПроцедуры

