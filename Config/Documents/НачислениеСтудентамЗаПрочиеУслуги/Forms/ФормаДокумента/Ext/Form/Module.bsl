		ТекущиеДанные.СтавкаНДС = СтавкаНДС;
		ТекущиеДанные.ПорядокВыпискиСФ = ПолучитьПорядокВыпискиСФ(ТекущиеДанные.Студент, ТекущиеДанные.НачислениеЗаУслугу, ТекущиеДанные.Контрагент, Объект.ПериодНачисления);
		
		СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДС(ТекущиеДанные.Сумма, Объект.СуммаВключаетНДС, УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС));
		ТекущиеДанные.СуммаНДС = СуммаНДС;
