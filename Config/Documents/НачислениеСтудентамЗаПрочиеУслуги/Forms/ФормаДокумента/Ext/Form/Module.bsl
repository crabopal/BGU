&НаКлиенте
Процедура НачисленияНачислениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОтборСтудент", ТекущаяСтрока.Студент);
	Отбор.Вставить("ОтборНаДату", НачалоМесяца(Объект.ПериодНачисления));
	Отбор.Вставить("НачалоПериода", ?(ЗначениеЗаполнено(Объект.ПериодНачисления), НачалоМесяца(Объект.ПериодНачисления), ТекущаяСтрока.ПериодНачисленияНачало));
	Отбор.Вставить("КонецПериода", ?(ЗначениеЗаполнено(Объект.ПериодНачисления), КонецМесяца(Объект.ПериодНачисления), ТекущаяСтрока.ПериодНачисленияКонец));
	
	Если ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Отбор.Вставить("ОтборВидНачисления", Объект.ВидОперации);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыборНачисленияВСтрокеТабличнойЧасти", ЭтотОбъект, Новый Структура);
	ОткрытьФорму("Справочник.НачисленияСтудентамЗаПрочиеУслуги.Форма.ФормаВыбораСОтборами",
		Новый Структура("Отбор", Отбор), Элемент,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

