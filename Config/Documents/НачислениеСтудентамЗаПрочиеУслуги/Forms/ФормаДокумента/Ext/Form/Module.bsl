&НаКлиенте
Процедура НДСВалютаНажатие(Элемент, СтандартнаяОбработка)
	
	// Старые значения (до изменения) запомним в кэше в локальных параметрах.
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("УчитыватьНДС", Объект.УчитыватьНДС);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Курс", Объект.Курс);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Кратность", Объект.Кратность);
	
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(СтруктураРезультат, ДопПараметры) Экспорт
	
	Если ТипЗнч(СтруктураРезультат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	БылиВнесеныИзменения = (ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента)
		ИЛИ (ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС)
		ИЛИ (ЭтотОбъект.КэшПараметров.Локальные.УчитыватьНДС <> Объект.УчитыватьНДС)
		ИЛИ (ЭтотОбъект.КэшПараметров.Локальные.Курс <> Объект.Курс)
		ИЛИ (ЭтотОбъект.КэшПараметров.Локальные.Кратность <> Объект.Кратность);
	
	Если БылиВнесеныИзменения Тогда
	
		Если Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаДокумента Тогда
			БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
			УстановитьПараметрыВыбораСтавкиОплаты(Элементы.НачисленияСтавкаОплаты, Новый Структура("Валюта", Объект.ВалютаДокумента));
		КонецЕсли; 
		
		ПересчитатьНДС = ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС;
		ИзмененУчетНДС = ЭтотОбъект.КэшПараметров.Локальные.УчитыватьНДС <> Объект.УчитыватьНДС;
		МассивУдаляемыхСтрок = Новый Массив;
		
		Для каждого СтрокаНачисления Из Объект.Начисления Цикл
			
			Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам") Тогда
				
				МассивУдаляемыхСтрок.Добавить(СтрокаНачисления);
				
			ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоКраткосрочнымДоговорам")
				И НЕ СтрокаНачисления.СтавкаОплаты.Пустая()
				И РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(СтрокаНачисления.СтавкаОплаты).Валюта <> Объект.ВалютаДокумента Тогда
				
				МассивУдаляемыхСтрок.Добавить(СтрокаНачисления);
				
			ИначеЕсли ПересчитатьНДС Или ИзмененУчетНДС Тогда
				
				Если Объект.УчитыватьНДС Тогда
					СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДС(СтрокаНачисления.Сумма, Объект.СуммаВключаетНДС, УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаНачисления.СтавкаНДС));
					СтрокаНачисления.СуммаНДС = СуммаНДС;
					СтрокаНачисления.Всего = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтрокаНачисления, Объект.СуммаВключаетНДС);
					СтрокаНачисления.ПорядокВыпискиСФ = ПолучитьПорядокВыпискиСФ(СтрокаНачисления.Студент, СтрокаНачисления.НачислениеЗаУслугу, СтрокаНачисления.Контрагент, Объект.ПериодНачисления);
				Иначе
					СтрокаНачисления.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
					СтрокаНачисления.СуммаНДС = 0;
					СтрокаНачисления.Всего = СтрокаНачисления.Сумма;
					СтрокаНачисления.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно");
				КонецЕсли;
				
			КонецЕсли; 
				
		КонецЦикла; 
		
		Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
			Объект.Начисления.Удалить(УдаляемаяСтрока);
		КонецЦикла; 
		
		Если ИзмененУчетНДС Тогда
			УстановитьВидимостьУчетаНДС(); 
			ОбновитьВидимостьДекорацийКомандЭДОДокумента();
		КонецЕсли; 
		
		ОбновитьИтоги(ЭтаФорма);
		СформироватьНадписьНДСВалюта(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачислениеПриИзменении(Элемент)
	
	НачислениеПриИзмененииНаСервере();
	СформироватьНадписьНДСВалюта(ЭтаФорма);
	УстановитьВидимостьКолонки();
	
КонецПроцедуры

&НаСервере
Процедура НачислениеПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
		
		НачислениеЗаУслугу = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.НачислениеЗаУслугу,
			"ВидНачисления,УчитыватьНДС");
		
		Объект.УчитыватьНДС = НачислениеЗаУслугу.УчитыватьНДС;
		
		ЭтоНачислениеПоДолгосрочнымДоговорам = (НачислениеЗаУслугу.ВидНачисления = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам);
		Объект.ВидОперации = ?(ЭтоНачислениеПоДолгосрочнымДоговорам, Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам,
			Перечисления.ВидыОперацийНачисленияУчащимся.ПоКраткосрочнымДоговорам);
		ВидОперацииПриИзмененииНаСервере();
		
	Иначе
		Объект.УчитыватьНДС = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьУчетаНДС();
	ОбновитьВидимостьДекорацийКомандЭДОДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура НачислениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.НачислениеЗаУслугу <> ВыбранноеЗначение 
		И Объект.Начисления.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;

		ТекстВопроса = НСтр("ru = 'При изменении начисления за услугу табличная часть будет очищена.
									|Продолжить?'");
									
		ДополнительныеПараметры = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
		ОписаниеОповещения = Новый ОписаниеОповещения("НачислениеОбработкаВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Да);
				
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НачислениеОбработкаВыбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Ответ = РезультатВопроса;
	
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;
	
	Объект.НачислениеЗаУслугу = ДополнительныеПараметры.ВыбранноеЗначение;
    
    Объект.Начисления.Очистить();
	
	Модифицированность = Истина;
	
	УстановитьВидимостьКолонки();
    
КонецПроцедуры

&НаКлиенте
Процедура НачислениеОчистка(Элемент, СтандартнаяОбработка)
	
	Если Объект.Начисления.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекстВопроса = НСтр("ru = 'При очистке поля ""Начисления за услугу"" табличная часть будет очищена. 
								|Продолжить?'");
		
		ДополнительныеПараметры = Новый Структура("ВыбранноеЗначение", Неопределено);
		Оповещение = Новый ОписаниеОповещения("НачислениеОбработкаВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет); 
		
	КонецЕсли;                                        
	
КонецПроцедуры

