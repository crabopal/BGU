&НаСервере
Процедура НачисленияЗаполнитьДобавленныеКолонки()
	
	ЭтоНачислениеПоДолгосрочнымДоговорам = (Объект.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам);
	РеквизитыДоговоров = РеквизитыДоговоров(Объект.Начисления.Выгрузить(,"ДоговорКонтрагента").ВыгрузитьКолонку("ДоговорКонтрагента"));
	
	Для Каждого СтрокаТаблицы Из Объект.Начисления Цикл
		
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы, РеквизитыДоговоров);
		
		Если ЭтоНачислениеПоДолгосрочнымДоговорам Тогда
			
			БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
				СтрокаТаблицы, СтрокаТаблицы.СчетДБП, НачисленияПоляАналитикиСчетаДБП());
			БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
				СтрокаТаблицы, СтрокаТаблицы.СчетДоходов, НачисленияПоляАналитикиСчетаДоходов());
			
			НачисленияРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы, РеквизитыДоговоров = Неопределено)
	
	Если ТипЗнч(РеквизитыДоговоров) = Тип("Соответствие")
		И РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента] <> Неопределено Тогда
		СтрокаТаблицы.ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента].ВестиПланГрафикИсполнения;
	Иначе
		СтрокаТаблицы.ВестиПланГрафикИсполнения = Ложь;
	КонецЕсли;
	
	НастройкиСчетовУчетаДБП = Форма.КэшПараметров.Локальные.НастройкиСчетовУчетаДБП;
	Если ТипЗнч(НастройкиСчетовУчетаДБП) = Тип("Соответствие")
		И НастройкиСчетовУчетаДБП[СтрокаТаблицы.СчетДБП] <> Неопределено Тогда
		СтрокаТаблицы.СчетДБПВалютный = НастройкиСчетовУчетаДБП[СтрокаТаблицы.СчетДБП].Валютный;
	Иначе
		СтрокаТаблицы.СчетДБПВалютный = Ложь;
	КонецЕсли;
	СтрокаТаблицы.ВалютаРасчетов = Форма.Объект.ВалютаДокумента;
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	// Поля СуммаРуб и ВсегоРуб отображаются информационно, рассчитываются по курсу, определяемому по остатку 401.4х.
	КурсПересчета = ?(СтрокаТаблицы.ОстатокДБПВВалюте = 0, 1, СтрокаТаблицы.ОстатокДБП / СтрокаТаблицы.ОстатокДБПВВалюте);
	СтрокаТаблицы.СуммаРуб = СтрокаТаблицы.Сумма * КурсПересчета;
	СтрокаТаблицы.ВсегоРуб = СтрокаТаблицы.Всего * КурсПересчета;
	
	СтрокаТаблицы.ЗаголовокОформлятьЭД = НСтр("ru = 'Передача по ЭДО:'");
	СтрокаТаблицы.ЗаголовокПередаточныйДокументЭД = НСтр("ru = 'Передаточный документ:'");
	
	СтрокаТаблицы.ЗаголовокПросмотретьЭД = НСтр("ru = 'Электронный документ:'");
	СтрокаТаблицы.ЗаголовокСостояниеЭД = НСтр("ru = 'Состояние ЭД:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НачисленияРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы, СуммаИзмененаВручную = Ложь)
	
	Если СуммаИзмененаВручную Тогда
		
		// Сумма изменена вручную, сбросим параметры авторасчета.
		СтрокаТаблицы.КоэффициентЧислитель   = 0;
		СтрокаТаблицы.КоэффициентЗнаменатель = 0;
		
		// Коэффициент списания определим по фактически указанной сумме списания.
		СтрокаТаблицы.Коэффициент = ?(СтрокаТаблицы.ОстатокДБП = 0, 0,
			СтрокаТаблицы.Всего / СтрокаТаблицы.ОстатокДБП);
		
	КонецЕсли;
	
	Если СтрокаТаблицы.КоэффициентЧислитель = 0
	   И СтрокаТаблицы.КоэффициентЗнаменатель = 0 Тогда
		Если СтрокаТаблицы.Коэффициент <> 0 Тогда
			СтрокаТаблицы.РасчетКоэффициентаСписания =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2 %)'"),
					СтрокаТаблицы.Коэффициент,
					Формат(СтрокаТаблицы.Коэффициент * 100, "ЧЦ=5;ЧДЦ=2"));
		Иначе
			СтрокаТаблицы.РасчетКоэффициентаСписания = "";
		КонецЕсли;
	Иначе
		СтрокаТаблицы.РасчетКоэффициентаСписания =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 / %2 = %3'"),
				СтрокаТаблицы.КоэффициентЧислитель,
				СтрокаТаблицы.КоэффициентЗнаменатель,
				СтрокаТаблицы.Коэффициент);
	КонецЕсли;
	
КонецПроцедуры

