// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Поиск документов для заполнения факультета в таб.части Начисления
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК НачислениеСтудентамЗаПрочиеУслугиНачисления
	|ГДЕ
	|	НачислениеСтудентамЗаПрочиеУслугиНачисления.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления
	// Заполнение документов (табличной части Начсиления)
	
	ПолноеИмяОбъекта = "Документ.НачислениеСтудентамЗаПрочиеУслуги";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Сведения для заполнения факультета по данным реквизита шапки документа
	|//
	|ВЫБРАТЬ
	|	Ссылка КАК Документ
	|ИЗ
	|	ВТДляОбработки
	|ГДЕ
	|	ВТДляОбработки.Ссылка.Факультет <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	// [0]. Сведения для заполнения факультета по данным реквизита шапки документа
	Результат0 = РезультатыЗапроса[0];
	
	Если Результат0.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	СтатистикаДокументов = Новый Структура();
	СтатистикаДокументов.Вставить("КоличествоОшибок",	0);
	СтатистикаДокументов.Вставить("Обработано",		0);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта",		ПолноеИмяОбъекта);
	ДополнительныеПараметры.Вставить("СтатистикаДокументов",	СтатистикаДокументов);
	
	Если Не Результат0.Пустой() Тогда
		Выборка = Результат0.Выбрать();
		
		ОбработатьДокументыДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно завершено заполнение поля Факультет табличных частей по данным реквизита в документах НачислениеСтудентамЗаПрочиеУслуги в очередной порции объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.Обработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры)
	
	СтатистикаДокументов = ДополнительныеПараметры.СтатистикаДокументов;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Документ;
		
		Попытка
			
			ОбработатьДокументДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры);
			
			СтатистикаДокументов.Обработано = СтатистикаДокументов.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось заполнить Факультет в табличных частях документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаДокументов.КоличествоОшибок = СтатистикаДокументов.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;


КонецПроцедуры

Процедура ОбработатьДокументДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ДокОбъект.Начисления.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
				
		Запрос.Текст = "ВЫБРАТЬ
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.НомерСтроки КАК НомерСтроки,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ДнейПосещения КАК ДнейПосещения,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ДоговорКонтрагента КАК ДоговорКонтрагента,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ИДСтроки КАК ИДСтроки,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Контрагент КАК Контрагент,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Льгота КАК Льгота,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ПериодНачисленияКонец КАК ПериодНачисленияКонец,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СтавкаНДС КАК СтавкаНДС,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СтавкаОплаты КАК СтавкаОплаты,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Студент КАК Студент,
		               |	ВЫБОР
		               |		КОГДА НачислениеСтудентамЗаПрочиеУслугиНачисления.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		               |			ТОГДА НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка.Факультет
		               |		ИНАЧЕ НачислениеСтудентамЗаПрочиеУслугиНачисления.Факультет
		               |	КОНЕЦ КАК Факультет,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Сумма КАК Сумма,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СуммаНДС КАК СуммаНДС,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.КФО КАК КФО,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.КПС КАК КПС,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.КЭК КАК КЭК,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СчетДБП КАК СчетДБП,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ОстатокДБП КАК ОстатокДБП,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ДатаНачалаСписания КАК ДатаНачалаСписания,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Коэффициент КАК Коэффициент,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.КоэффициентЧислитель КАК КоэффициентЧислитель,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.КоэффициентЗнаменатель КАК КоэффициентЗнаменатель,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СчетДоходов КАК СчетДоходов,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СубконтоДоходов1 КАК СубконтоДоходов1,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СубконтоДоходов2 КАК СубконтоДоходов2,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СубконтоДоходов3 КАК СубконтоДоходов3,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СчетДоходовНУ КАК СчетДоходовНУ,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ОформлятьЭД КАК ОформлятьЭД,
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ИдентификаторЭД КАК ИдентификаторЭД
		               |ИЗ
		               |	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК НачислениеСтудентамЗаПрочиеУслугиНачисления
		               |ГДЕ
		               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка = &Ссылка";
				
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// [0]. Данные по ТЧ Начисления
		Результат0 = РезультатыЗапроса[0];
		Если НЕ Результат0.Пустой() Тогда
			ДокОбъект.Начисления.Загрузить(Результат0.Выгрузить());
		КонецЕсли;
				
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Перем Запрос, ТекстЗапроса;
	Перем Результат, ТаблицыДвижений;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Начисления.Ссылка.ПериодНачисления КАК Период,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Факультет,
	               |	Начисления.Студент,
	               |	Начисления.Контрагент,
	               |	Начисления.ДоговорКонтрагента,
	               |	Начисления.Ссылка.ВалютаДокумента КАК ВалютаВзаиморасчетов,
	               |	Начисления.Сумма + ВЫБОР
	               |		КОГДА Начисления.Ссылка.СуммаВключаетНДС
	               |			ТОГДА 0
	               |		ИНАЧЕ Начисления.СуммаНДС
	               |	КОНЕЦ КАК СуммаВзаиморасчетов,
	               |	(Начисления.Сумма + ВЫБОР
	               |		КОГДА Начисления.Ссылка.СуммаВключаетНДС
	               |			ТОГДА 0
	               |		ИНАЧЕ Начисления.СуммаНДС
	               |	КОНЕЦ) * Начисления.Ссылка.Курс / Начисления.Ссылка.Кратность КАК СуммаРегл,
	               |	Начисления.Ссылка.Номер КАК НомерПервичногоДокумента,
	               |	Начисления.Ссылка.Дата КАК ДатаПервичногоДокумента,
	               |	""Начисление учащимся за прочие услуги"" КАК ВидПервичногоДокумента,
	               |	ВЫБОР
	               |		КОГДА Начисления.НачислениеЗаУслугу = ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка)
	               |			ТОГДА Начисления.Ссылка.НачислениеЗаУслугу
	               |		ИНАЧЕ Начисления.НачислениеЗаУслугу
	               |	КОНЕЦ КАК НачислениеЗаУслугу
	               |ПОМЕСТИТЬ Начисления
	               |ИЗ
	               |	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК Начисления
	               |ГДЕ
	               |	Начисления.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Начисления.Период КАК Период,
	               |	Начисления.Организация КАК Организация,
	               |	Начисления.Факультет КАК Факультет,
	               |	Начисления.Студент КАК Студент,
	               |	Начисления.Контрагент КАК Контрагент,
	               |	Начисления.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	Начисления.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	               |	СУММА(Начисления.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов,
	               |	СУММА(Начисления.СуммаРегл) КАК СуммаРегл,
	               |	Начисления.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	               |	Начисления.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	               |	Начисления.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	               |	Начисления.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	               |ИЗ
	               |	Начисления КАК Начисления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Начисления.Студент,
	               |	Начисления.Период,
	               |	Начисления.Факультет,
	               |	Начисления.Контрагент,
	               |	Начисления.ДоговорКонтрагента,
	               |	Начисления.НомерПервичногоДокумента,
	               |	Начисления.ДатаПервичногоДокумента,
	               |	Начисления.ВидПервичногоДокумента,
	               |	Начисления.ВалютаВзаиморасчетов,
	               |	Начисления.Организация,
	               |	Начисления.НачислениеЗаУслугу";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.Выполнить();
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("РасчетыСоСтудентамиДопУслуги", Результат.Выгрузить());
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(ДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

// Подготовить таблицу расчетов по документу (в унифицированном формате) для источника данных ТаблицаРасчетовСЗачетомАвансов.
// 
// Параметры:
//  Документ - ДокументОбъект.НачислениеЗаУслугиОбразования
//  Параметры - Структура - Параметры 
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Начисления",
		"ИФО,КФО,КПС,КЭК,Факультет,Контрагент,ДоговорКонтрагента,
		|ВалютаДокумента,ОстатокДБП,ОстатокДБПВВалюте,УчитыватьНДС,СуммаВключаетНДС,СуммаНДС,Сумма",
		Документ, Параметры);
	
	Если Документ.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоКраткосрочнымДоговорам Тогда
		
		// Исключение из общего принципа - для начислений по краткосрочным договорам (образование),
		// КФО, КПС и КЭК берем из параметров источника данных (реквизитов типовой операции),
		// несмотря на то, что одноименные реквизиты есть в табличной части.
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Начисления.ИФО КАК ИФО,
		|	&ПараметрКФО КАК КФО,
		|	&ПараметрКПС КАК КПС,
		|	&ПараметрКЭК КАК КЭК,
		|	Начисления.Факультет КАК Подразделение,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.ДоговорКонтрагента КАК Договор,
		|	Начисления.ВалютаДокумента КАК Валюта,
		|	Начисления.СуммаНДС КАК СуммаНДС,
		|	ВЫБОР
		|		КОГДА Начисления.УчитыватьНДС
		|				И НЕ Начисления.СуммаВключаетНДС
		|			ТОГДА Начисления.Сумма + Начисления.СуммаНДС
		|		ИНАЧЕ Начисления.Сумма
		|	КОНЕЦ КАК СуммаРасчетов
		|ИЗ
		|	ТаблицаНачисления КАК Начисления";
		Запрос.УстановитьПараметр("ПараметрКФО", Параметры.КФО);
		Запрос.УстановитьПараметр("ПараметрКПС", Параметры.КПС);
		Запрос.УстановитьПараметр("ПараметрКЭК", Параметры.КЭКРасчетов);
		
	Иначе // ПоДолгосрочнымДоговорам
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Начисления.ИФО КАК ИФО,
		|	Начисления.КФО КАК КФО,
		|	Начисления.КПС КАК КПС,
		|	Начисления.КЭК КАК КЭК,
		|	Начисления.Факультет КАК Подразделение,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.ДоговорКонтрагента КАК Договор,
		|	Начисления.ВалютаДокумента КАК Валюта,
		|	Начисления.ОстатокДБП КАК ОстатокДБП,
		|	Начисления.ОстатокДБПВВалюте КАК ОстатокДБПВВалюте,
		|	Начисления.СуммаНДС КАК СуммаНДС,
		|	ВЫБОР
		|		КОГДА Начисления.УчитыватьНДС
		|				И НЕ Начисления.СуммаВключаетНДС
		|			ТОГДА Начисления.Сумма + Начисления.СуммаНДС
		|		ИНАЧЕ Начисления.Сумма
		|	КОНЕЦ КАК СуммаРасчетов
		|ИЗ
		|	ТаблицаНачисления КАК Начисления";
		
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Начисления.Факультет", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Начисления.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	Если Параметры.ПоВсемКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Начисления.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	
	РасчетыПоУслугамРаботам = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДокумента Из РасчетыПоУслугамРаботам Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		НоваяСтрока.ЭтоПоступление = Ложь;
		
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
			?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
			Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
			ТекстОшибки = НСтр("ru='Невозможно определить счет расчетов с контрагентом по КЭК ""%1"".
				|Проверьте настройки соответствия аналитических счетов КЭК.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				НоваяСтрока.КЭК);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
				Документ.Ссылка, , "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРасчетов.Свернуть("ЭтоПоступление,ИФО,КФО,КПС,КЭК,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта",
		"СуммаНДС,СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

// Подготовить таблицу документа (в унифицированном формате) для источника данных РеализацияУслугРабот.
// 
// Параметры:
//  Документ - ДокументОбъект.НачислениеЗаУслугиОбразования
//  Параметры - Структура - Параметры 
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРеализацияУслугРаботПоДокументу
Функция ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры) Экспорт
	
	ТаблицаРеализацияУслугРабот = УчетРасчетов.ПустаяТаблицаРеализацияУслугРаботПоДокументу();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачислениеЗаУслугуВШапкеДокумента", Документ.НачислениеЗаУслугу);
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Начисления",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Факультет,Контрагент,ДоговорКонтрагента,ВалютаДокумента,ОстатокДБП,ОстатокДБПВВалюте,
		|НачислениеЗаУслугу,Количество,Сумма,СтавкаНДС,СуммаНДС,УчитыватьНДС,СуммаВключаетНДС,
		|СчетДБП,СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ,
		|ОтразитьВГрафикеИсполненияДоговора",
		Документ, Параметры);
	
	Если Документ.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоКраткосрочнымДоговорам Тогда
		
		// Исключение из общего принципа - для начислений по краткосрочным договорам (образование),
		// КФО, КПС и КЭК берем из параметров источника данных (реквизитов типовой операции),
		// несмотря на то, что одноименные реквизиты есть в табличной части.
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Начисления.НомерСтроки КАК НомерСтроки,
		|	Начисления.ИФО КАК ИФО,
		|	&ПараметрКФО КАК КФО,
		|	&ПараметрКПС КАК КПС,
		|	&ПараметрКЭК КАК КЭК,
		|	Начисления.Факультет КАК Подразделение,
		|	ВЫБОР
		|		КОГДА Начисления.НачислениеЗаУслугу = ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка)
		|			ТОГДА &НачислениеЗаУслугуВШапкеДокумента
		|		ИНАЧЕ Начисления.НачислениеЗаУслугу
		|	КОНЕЦ КАК НачислениеЗаУслугу,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.ДоговорКонтрагента КАК Договор,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетДБП,
		|	&ПараметрСчетДоходов КАК СчетДоходов,
		|	&ПараметрСубконтоДоходов1 КАК СубконтоДоходов1,
		|	&ПараметрСубконтоДоходов2 КАК СубконтоДоходов2,
		|	&ПараметрСубконтоДоходов3 КАК СубконтоДоходов3,
		|	&ПараметрВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	&ПараметрСчетДоходовНУ КАК СчетДоходовНУ,
		|	&ПараметрСтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	Начисления.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	Начисления.ВалютаДокумента КАК Валюта,
		|	ВЫБОР
		|		КОГДА Начисления.УчитыватьНДС
		|				И НЕ Начисления.СуммаВключаетНДС
		|			ТОГДА Начисления.Сумма + Начисления.СуммаНДС
		|		ИНАЧЕ Начисления.Сумма
		|	КОНЕЦ КАК Сумма,
		|	Начисления.СтавкаНДС КАК СтавкаНДС,
		|	Начисления.СуммаНДС КАК СуммаНДС
		|ПОМЕСТИТЬ РеализацияУслугРабот
		|ИЗ
		|	ТаблицаНачисления КАК Начисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Начисления"" КАК ИмяСписка,
		|	""Начисления"" КАК СинонимСписка,
		|	РеализацияУслугРабот.НомерСтроки КАК НомерСтроки,
		|	РеализацияУслугРабот.ИФО КАК ИФО,
		|	РеализацияУслугРабот.КФО КАК КФО,
		|	РеализацияУслугРабот.КПС КАК КПС,
		|	РеализацияУслугРабот.КЭК КАК КЭК,
		|	РеализацияУслугРабот.Подразделение КАК Подразделение,
		|	РеализацияУслугРабот.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
		|	ВЫРАЗИТЬ(НачисленияСтудентамЗаПрочиеУслуги.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачисленияСтудентамЗаПрочиеУслуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК СТРОКА(254)) КАК Содержание,
		|	РеализацияУслугРабот.Контрагент КАК Контрагент,
		|	РеализацияУслугРабот.Договор КАК Договор,
		|	РеализацияУслугРабот.СчетДБП КАК СчетДБП,
		|	РеализацияУслугРабот.СчетДоходов КАК СчетДоходов,
		|	РеализацияУслугРабот.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	РеализацияУслугРабот.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	РеализацияУслугРабот.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	РеализацияУслугРабот.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	РеализацияУслугРабот.СчетДоходовНУ КАК СчетДоходовНУ,
		|	РеализацияУслугРабот.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	РеализацияУслугРабот.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	РеализацияУслугРабот.Валюта КАК Валюта,
		|	0 КАК Количество,
		|	РеализацияУслугРабот.Сумма КАК Сумма,
		|	РеализацияУслугРабот.СтавкаНДС КАК СтавкаНДС,
		|	РеализацияУслугРабот.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	РеализацияУслугРабот КАК РеализацияУслугРабот
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НачисленияСтудентамЗаПрочиеУслуги КАК НачисленияСтудентамЗаПрочиеУслуги
		|		ПО РеализацияУслугРабот.НачислениеЗаУслугу = НачисленияСтудентамЗаПрочиеУслуги.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("ПараметрКФО", Параметры.КФО);
		Запрос.УстановитьПараметр("ПараметрКПС", Параметры.КПС);
		Запрос.УстановитьПараметр("ПараметрКЭК", Параметры.КЭК);
		Запрос.УстановитьПараметр("ПараметрСчетДоходов", Параметры.СчетДоходов);
		Запрос.УстановитьПараметр("ПараметрСубконтоДоходов1", Параметры.СубконтоДоходов1);
		Запрос.УстановитьПараметр("ПараметрСубконтоДоходов2", Параметры.СубконтоДоходов2);
		Запрос.УстановитьПараметр("ПараметрСубконтоДоходов3", Параметры.СубконтоДоходов3);
		
		// Налоговый учет по налогу на прибыль.
		Запрос.УстановитьПараметр("ПараметрВидДеятельностиНУ",
			?(Параметры.Свойство("ВидДеятельностиНУ") И ЗначениеЗаполнено(Параметры.ВидДеятельностиНУ), Параметры.ВидДеятельностиНУ,
			Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения) ); // Значение по умолчанию.
		Запрос.УстановитьПараметр("ПараметрСчетДоходовНУ",
			?(Параметры.Свойство("СчетДоходовНУ") И ЗначениеЗаполнено(Параметры.СчетДоходовНУ), Параметры.СчетДоходовНУ,
			БухгалтерскийУчет.СчетПоКоду("Н90.01", Документ.Дата, Документ.Организация)) ); // Значение по умолчанию.
		Запрос.УстановитьПараметр("ПараметрСтатьяПрочихДоходовНУ",
			?(Параметры.Свойство("СтатьяПрочихДоходовНУ") И ЗначениеЗаполнено(Параметры.СтатьяПрочихДоходовНУ), Параметры.СтатьяПрочихДоходовНУ,
			Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка()) ); // Значение по умолчанию.
		
	Иначе // ПоДолгосрочнымДоговорам
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Начисления.НомерСтроки КАК НомерСтроки,
		|	Начисления.ИФО КАК ИФО,
		|	Начисления.КФО КАК КФО,
		|	Начисления.КПС КАК КПС,
		|	Начисления.КЭК КАК КЭК,
		|	Начисления.Факультет КАК Подразделение,
		|	ВЫБОР
		|		КОГДА Начисления.НачислениеЗаУслугу = ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка)
		|			ТОГДА &НачислениеЗаУслугуВШапкеДокумента
		|		ИНАЧЕ Начисления.НачислениеЗаУслугу
		|	КОНЕЦ КАК НачислениеЗаУслугу,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.ДоговорКонтрагента КАК Договор,
		|	Начисления.СчетДБП КАК СчетДБП,
		|	Начисления.ОстатокДБП КАК ОстатокДБП,
		|	Начисления.ОстатокДБПВВалюте КАК ОстатокДБПВВалюте,
		|	Начисления.СчетДоходов КАК СчетДоходов,
		|	Начисления.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	Начисления.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	Начисления.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	Начисления.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	Начисления.СчетДоходовНУ КАК СчетДоходовНУ,
		|	Начисления.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	Начисления.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	Начисления.ВалютаДокумента КАК Валюта,
		|	ВЫБОР
		|		КОГДА Начисления.УчитыватьНДС
		|				И НЕ Начисления.СуммаВключаетНДС
		|			ТОГДА Начисления.Сумма + Начисления.СуммаНДС
		|		ИНАЧЕ Начисления.Сумма
		|	КОНЕЦ КАК Сумма,
		|	Начисления.СтавкаНДС КАК СтавкаНДС,
		|	Начисления.СуммаНДС КАК СуммаНДС
		|ПОМЕСТИТЬ РеализацияУслугРабот
		|ИЗ
		|	ТаблицаНачисления КАК Начисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Начисления"" КАК ИмяСписка,
		|	""Начисления"" КАК СинонимСписка,
		|	РеализацияУслугРабот.НомерСтроки КАК НомерСтроки,
		|	РеализацияУслугРабот.ИФО КАК ИФО,
		|	РеализацияУслугРабот.КФО КАК КФО,
		|	РеализацияУслугРабот.КПС КАК КПС,
		|	РеализацияУслугРабот.КЭК КАК КЭК,
		|	РеализацияУслугРабот.Подразделение КАК Подразделение,
		|	РеализацияУслугРабот.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
		|	ВЫРАЗИТЬ(НачисленияСтудентамЗаПрочиеУслуги.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачисленияСтудентамЗаПрочиеУслуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК СТРОКА(254)) КАК Содержание,
		|	РеализацияУслугРабот.Контрагент КАК Контрагент,
		|	РеализацияУслугРабот.Договор КАК Договор,
		|	РеализацияУслугРабот.СчетДБП КАК СчетДБП,
		|	РеализацияУслугРабот.ОстатокДБП КАК ОстатокДБП,
		|	РеализацияУслугРабот.ОстатокДБПВВалюте КАК ОстатокДБПВВалюте,
		|	РеализацияУслугРабот.СчетДоходов КАК СчетДоходов,
		|	РеализацияУслугРабот.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	РеализацияУслугРабот.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	РеализацияУслугРабот.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	РеализацияУслугРабот.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	РеализацияУслугРабот.СчетДоходовНУ КАК СчетДоходовНУ,
		|	РеализацияУслугРабот.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	РеализацияУслугРабот.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	РеализацияУслугРабот.Валюта КАК Валюта,
		|	0 КАК Количество,
		|	РеализацияУслугРабот.Сумма КАК Сумма,
		|	РеализацияУслугРабот.СтавкаНДС КАК СтавкаНДС,
		|	РеализацияУслугРабот.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	РеализацияУслугРабот КАК РеализацияУслугРабот
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НачисленияСтудентамЗаПрочиеУслуги КАК НачисленияСтудентамЗаПрочиеУслуги
		|		ПО РеализацияУслугРабот.НачислениеЗаУслугу = НачисленияСтудентамЗаПрочиеУслуги.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Начисления.Факультет", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	РеализацияУслугРабот = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ЭтоДолгосрочныйДоговор = (Документ.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам);
	
	Для Каждого СтрокаДокумента Из РеализацияУслугРабот Цикл
		
		НоваяСтрока = ТаблицаРеализацияУслугРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
			?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
			Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
		Если Не ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда // По умолчанию - 205.31.
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.31", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		НоваяСтрока.ВидОперацииДБП = ?(ЭтоДолгосрочныйДоговор, Перечисления.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование, Перечисления.ВидыОперацийНачисленияДБП.ПустаяСсылка());
		
		Если ЭтоДолгосрочныйДоговор
			И ИспользоватьВалютныйУчет 
			И ЗначениеЗаполнено(НоваяСтрока.Валюта)
			И НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
			КурсПересчета = ?(СтрокаДокумента.ОстатокДБПВВалюте = 0, 1, СтрокаДокумента.ОстатокДБП / СтрокаДокумента.ОстатокДБПВВалюте);
			НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.Сумма * КурсПересчета;
		Иначе
			НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.Сумма;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализацияУслугРабот;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//	КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Пустой обработчик. Для нормальной работы подсистемы печати и добавления внешних печатных форм
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// ВАЖНО: В качестве массива объектов принимается тип ДокументСсылка.СчетФактура, 
	// т.к. именно на его основании печатается акт и формируется нумерация
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктОбОказанииУслуг",
															"Акт об оказании услуг",
															ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктВыполненныхУслуг");
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги 	= Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	МассивДляПроверки = Новый Массив;
	МассивДляПроверки.Добавить(ОбластьИтоги);
	МассивДляПроверки.Добавить(ОбластьПодвал);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК Ссылка,
	|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование,
	|	СчетФактураВыданный.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.Организация.НаименованиеПолное = """"
	|			ТОГДА СчетФактураВыданный.Организация.Наименование
	|		ИНАЧЕ СчетФактураВыданный.Организация.НаименованиеПолное
	|	КОНЕЦ + "" ИНН "" + СчетФактураВыданный.Организация.ИНН + "" КПП "" + СчетФактураВыданный.Организация.КПП КАК пНаименованиеОрганизации,
	|	СчетФактураВыданный.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА СчетФактураВыданный.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ СчетФактураВыданный.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ СчетФактураВыданный.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	СчетФактураВыданный.Контрагент.ИНН КАК КонтрагентИНН,
	|	СчетФактураВыданный.Контрагент.КПП КАК КонтрагентКПП,
	|	СчетФактураВыданный.Дата КАК пДата,
	|	СчетФактураВыданный.Договор.Представление КАК пДоговор,
	|	СчетФактураВыданный.СуммаНДС КАК пИтогНДС,
	|	СчетФактураВыданный.СуммаДокумента КАК пИтогСумма,
	|	СчетФактураВыданный.СуммаДокумента КАК пИтогВсего,
	|	СчетФактураВыданный.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	СчетФактураВыданный.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫРАЗИТЬ(СчетФактураВыданный.ДокументОснование КАК Документ.НачислениеСтудентамЗаПрочиеУслуги).Номер КАК НомерНачисления,
	|	ВЫРАЗИТЬ(СчетФактураВыданный.ДокументОснование КАК Документ.НачислениеСтудентамЗаПрочиеУслуги) КАК Начисление,
	|	СчетФактураВыданный.Номер КАК НомерСФ,
	|	СчетФактураВыданный.Ссылка КАК СФСсылка,
	|	СчетФактураВыданный.ВалютаДокумента.Представление КАК пВалюта,
	|	СчетФактураВыданный.ДокументОснование.Руководитель КАК Руководитель,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.КодСпособаВыставления = 2
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОформлятьЭД	
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставНФА.Ссылка КАК Ссылка,
	|	СоставНФА.НомерСтроки КАК пНом,
	|	СоставНФА.НФА.Представление КАК пНаименование,
	|	СоставНФА.ЕдиницаИзмерения.Представление КАК пЕдИзм,
	|	1 КАК пКоличество,
	|	СоставНФА.Всего КАК пЦена,
	|	СоставНФА.Всего КАК пСумма
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА КАК СоставНФА
	|ГДЕ
	|	СоставНФА.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.Ссылка,
	|	СоставНФА.НомерСтроки";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = Результат[0].Выбрать();
	ВыборкаСтроки = Результат[1].Выгрузить();
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Если ВыборкаШапка.ОформлятьЭД Тогда
			//Электронные акты
			Продолжить;
		КонецЕсли;	
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
			
		СтруктураОбластьШапка = Новый Структура("пАдресТелефон,пЗаказчик,пДата,пНомер");
		
		СтруктураОбластьШапка.пАдресТелефон = АдресОрганизации
			+ ?(ПустаяСтрока(ТелефонОрганизации), "", ", тел.:"+ТелефонОрганизации);
		
		СтруктураОбластьШапка.пЗаказчик = ВыборкаШапка.КонтрагентНаименование
		+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентИНН), "", " ИНН " + ВыборкаШапка.КонтрагентИНН)
		+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентКПП), "", " КПП " + ВыборкаШапка.КонтрагентКПП);
		
		СтруктураОбластьШапка.пДата	= Формат(ВыборкаШапка.пДата, "ДЛФ=DD");		
		СтруктураОбластьШапка.пНомер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Начисление,ВыборкаШапка.НомерНачисления) + "/" + ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.СФСсылка,ВыборкаШапка.НомерСФ);
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		// Строки таб. части
		СтрокиТЧ = ВыборкаСтроки.НайтиСтроки(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			ОбластьСтрока.Параметры.Заполнить(СтрокаТЧ);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		// Строки таб. части
		
		ОбластьИтоги.Параметры.Заполнить(Новый Структура("пТекстНДС",?(ВыборкаШапка.СуммаВключаетНДС, "В том числе НДС", "Итого НДС")));
		ОбластьИтоги.Параметры.Заполнить(ВыборкаШапка);
		
		ТабличныйДокумент.Вывести(ОбластьИтоги);
		СтруктураОбластьПодвал = Новый Структура("пИтогВсегоПрописью,пИтогНДСПрописью,РуководительДолжность,РуководительФИО");
		СтруктураОбластьПодвал.пИтогВсегоПрописью 	= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогВсего, ВыборкаШапка.ВалютаДокумента);
		СтруктураОбластьПодвал.пИтогНДСПрописью 	= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогНДС, ВыборкаШапка.ВалютаДокумента);
		
		ДанныеРуководителя = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеРуководителя);
		СтруктураОбластьПодвал.РуководительДолжность = ДанныеРуководителя.Должность;
		СтруктураОбластьПодвал.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Истина, ВыборкаШапка.пДата);
		
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.ДокументОснование);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаДоходовБудущихПериодовОбразование") Тогда
		
		Объект.ДокументОснование = Основание;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КорректировкаДоходовБудущихПериодовОбразование.Ссылка КАК Ссылка,
		|	КорректировкаДоходовБудущихПериодовОбразование.Дата КАК Дата,
		|	КорректировкаДоходовБудущихПериодовОбразование.Организация КАК Организация,
		|	КорректировкаДоходовБудущихПериодовОбразование.ИФО КАК ИФО,
		|	КорректировкаДоходовБудущихПериодовОбразование.Студент КАК Студент,
		|	КорректировкаДоходовБудущихПериодовОбразование.Контрагент КАК Контрагент,
		|	КорректировкаДоходовБудущихПериодовОбразование.Договор КАК ДоговорКонтрагента,
		|	КорректировкаДоходовБудущихПериодовОбразование.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
		|	КорректировкаДоходовБудущихПериодовОбразование.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	КорректировкаДоходовБудущихПериодовОбразование.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	КорректировкаДоходовБудущихПериодовОбразование.СчетДоходов КАК СчетДоходов,
		|	КорректировкаДоходовБудущихПериодовОбразование.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	КорректировкаДоходовБудущихПериодовОбразование.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	КорректировкаДоходовБудущихПериодовОбразование.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	КорректировкаДоходовБудущихПериодовОбразование.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	КорректировкаДоходовБудущихПериодовОбразование.СчетДоходовНУ КАК СчетДоходовНУ,
		|	КорректировкаДоходовБудущихПериодовОбразование.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	КорректировкаДоходовБудущихПериодовОбразование.ВидДеятельностиУСН КАК ВидДеятельностиУСН
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование КАК КорректировкаДоходовБудущихПериодовОбразование
		|ГДЕ
		|	КорректировкаДоходовБудущихПериодовОбразование.Ссылка = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоходыБудущихПериодов.Ссылка.Студент КАК Студент,
		|	ДоходыБудущихПериодов.Ссылка.Контрагент КАК Контрагент,
		|	ДоходыБудущихПериодов.Ссылка.Договор КАК ДоговорКонтрагента,
		|	ДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
		|	ДоходыБудущихПериодов.Номенклатура.СтавкаНДС КАК СтавкаНДС,
		|	ДоходыБудущихПериодов.СчетДБП КАК СчетДБП,
		|	ДоходыБудущихПериодов.КФО КАК КФО,
		|	ДоходыБудущихПериодов.КПС КАК КПС,
		|	ДоходыБудущихПериодов.КЭК КАК КЭК,
		|	ДоходыБудущихПериодов.Подразделение КАК Подразделение,
		|	ДоходыБудущихПериодов.ОстатокДБП + ДоходыБудущихПериодов.Всего КАК Сумма
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ДоходыБудущихПериодов КАК ДоходыБудущихПериодов
		|ГДЕ
		|	ДоходыБудущихПериодов.Ссылка = &Основание
		|	И ДоходыБудущихПериодов.ОстатокДБП + ДоходыБудущихПериодов.Всего <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоходыБудущихПериодов.НомерСтроки";
		Запрос.УстановитьПараметр("Основание", Основание);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		Шапка      = РезультатЗапроса[0].Выгрузить();
		Начисления = РезультатЗапроса[1].Выгрузить();
		
		ЗаполнитьЗначенияСвойств(Объект, Шапка[0], "Дата,Организация,ИФО");
		Объект.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам;
		
		Если Начисления.Количество() = 0 Тогда
			// Не обнаружено остатков доходов будущих периодов для отражения в доходах текущего периода.
			Возврат Истина;
		КонецЕсли;
		
		Начисления.Свернуть("Студент,Контрагент,ДоговорКонтрагента,Номенклатура,СтавкаНДС,СчетДБП,КФО,КПС,КЭК,Подразделение", "Сумма");
		// Заполняем из первой строки. Разная аналитика (Номенклатура) по одному договору обучения не рекомендуется.
		// Разная аналитика (КФО, КПС, КЭК) по одному договору обучения не поддерживается (нет необходимости).
		Объект.Факультет = Начисления[0].Подразделение;
		
		НачислениеЗаПоследнийМесяц = Объект.Начисления.Добавить();
		ЗаполнитьЗначенияСвойств(НачислениеЗаПоследнийМесяц, Начисления[0]);
		ЗаполнитьЗначенияСвойств(НачислениеЗаПоследнийМесяц, Шапка[0],
			"СпособПризнанияДоходов,ДатаНачалаСписания,ДатаОкончанияСписания,
			|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,
			|ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ");
		
		НачислениеЗаПоследнийМесяц.Коэффициент = 1;
		НачислениеЗаПоследнийМесяц.КоэффициентЧислитель = 1;
		НачислениеЗаПоследнийМесяц.КоэффициентЗнаменатель = 1;
		
		Если ЗначениеЗаполнено(НачислениеЗаПоследнийМесяц.СтавкаНДС)
			И НачислениеЗаПоследнийМесяц.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
			Объект.УчитыватьНДС = Истина;
			Объект.СуммаВключаетНДС = Истина;
			СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", НачислениеЗаПоследнийМесяц.Сумма, НачислениеЗаПоследнийМесяц.СтавкаНДС);
			НачислениеЗаПоследнийМесяц.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
		КонецЕсли;
		
		СведенияОПрочихУслугахСтуденту = РаботаСоСтудентами.СведенияОПрочихУслугахСтуденту(
			Шапка[0].Студент, Шапка[0].Контрагент, Шапка[0].ДоговорКонтрагента, Объект.Дата, Объект.Факультет);
		Если СведенияОПрочихУслугахСтуденту.Количество() = 1 Тогда
			Объект.НачислениеЗаУслугу = СведенияОПрочихУслугахСтуденту[0].НачислениеСтудентамЗаПрочиеУслуги;
			НачислениеЗаПоследнийМесяц.ПорядокВыпискиСФ = СведенияОПрочихУслугахСтуденту[0].ПорядокВыпискиСФ;
		КонецЕсли;
		
		НачислениеЗаПоследнийМесяц.ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
		
		// Налоговый учет.
		Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, НачислениеЗаПоследнийМесяц.КФО) Тогда
			
			Если НЕ ЗначениеЗаполнено(НачислениеЗаПоследнийМесяц.ВидДеятельностиНУ) Тогда
				// По умолчанию - основная система налогообложения.
				НачислениеЗаПоследнийМесяц.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НачислениеЗаПоследнийМесяц.СчетДоходовНУ) Тогда
				// По умолчанию - доходы от обычных видов деятельности.
				НачислениеЗаПоследнийМесяц.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата);
			КонецЕсли;
			
			Если НЕ БухгалтерскийУчет.СчетВИерархии(НачислениеЗаПоследнийМесяц.СчетДоходовНУ, "Н91.01") Тогда
				НачислениеЗаПоследнийМесяц.СтатьяПрочихДоходовНУ = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		НачислениеЗаПоследнийМесяц.ОстатокДБП = НачислениеЗаПоследнийМесяц.Сумма;
		Объект.СуммаДокумента = НачислениеЗаПоследнийМесяц.Сумма;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
