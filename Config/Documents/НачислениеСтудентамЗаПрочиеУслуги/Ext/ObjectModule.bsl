#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		
		ПериодНачисления = НачалоМесяца(ТекущаяДатаСеанса());
		ВалютаДокумента = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
		Курс = СтруктураКурса.Курс;
		Кратность = СтруктураКурса.Кратность;
		
	КонецЕсли; 
	
	Если ДанныеЗаполнения <> Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
		ТекстСообщения = "";
		Если НЕ Документы.НачислениеСтудентамЗаПрочиеУслуги.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если Не УчитыватьНДС Тогда
		НепроверяемыеРеквизиты.Добавить("Начисления.ПорядокВыпискиСФ");
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам Тогда
		НепроверяемыеРеквизиты.Добавить("Начисления.ПериодНачисленияНачало");
		НепроверяемыеРеквизиты.Добавить("Начисления.ПериодНачисленияКонец");
	Иначе
		
		Для каждого СтрокаНачисления Из Начисления Цикл
			
			Если УчитыватьНДС Тогда
				ПроверитьЗаполнениеСуммыНДСВСтроке(СтрокаНачисления, Отказ);
			КонецЕсли;
			
			ПроверитьЗаполнениеПериодаНачисленияВСтроке(СтрокаНачисления, Отказ);
			
		КонецЦикла;
		
		ПроверитьДублиСтрокИСуществующиеНачисления(Отказ);
	
	КонецЕсли;
	
	ПроверитьФакультетыОсновногоОбучения(Отказ);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	// Соответствие вида начисления и вида операции.
	Если ЗначениеЗаполнено(НачислениеЗаУслугу) Тогда
		
		ПараметрыНачисленияЗаУслугу = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НачислениеЗаУслугу, "ВидНачисления");
		Если ВидОперации <> ПараметрыНачисленияЗаУслугу.ВидНачисления Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Вид начисления ""%1"" не соответствует виду операции документа ""%2"".'"),
					ВидОперации, ПараметрыНачисленияЗаУслугу.ВидНачисления);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "НачислениеЗаУслугу", "Объект", Отказ);
		КонецЕсли;
		
	Иначе // Начисление за услугу указывается в строке табличной части.
		
		
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
	МассивИдентификаторовСтрок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		//Если ссылка пустая, значит документ новый, устанавливаем новые идентификаторы всем строкам
		Для Каждого СтрТЧ Из Начисления Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);			
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	Иначе
		//Если ссылка не пустая, нужен анализ идентификаторов строк.
		//Т.к. возможна ситуация, когда строку скопировали, а исходную - удалили.
		//В этом случае нужно ранее присвоенные идентификаторы назначить новым строкам.
		Запрос = Новый Запрос("ВЫБРАТЬ
	      |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
	      |	НачислениеРодительскойПлатыНачисления.Студент КАК Учащийся,
	      |	НачислениеРодительскойПлатыНачисления.Контрагент,
	      |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
	      |	НачислениеРодительскойПлатыНачисления.ИДСтроки
	      |ПОМЕСТИТЬ ТекущиеНачисления
	      |ИЗ
	      |	&Начисления КАК НачислениеРодительскойПлатыНачисления
	      |;
	      |
	      |////////////////////////////////////////////////////////////////////////////////
	      |ВЫБРАТЬ
	      |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
	      |	НачислениеРодительскойПлатыНачисления.Студент КАК Учащийся,
	      |	НачислениеРодительскойПлатыНачисления.Контрагент,
	      |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
	      |	НачислениеРодительскойПлатыНачисления.ИДСтроки
	      |ПОМЕСТИТЬ ДанныеДокумента
	      |ИЗ
	      |	Документ.НачислениеЗаУслугиОбразования.Начисления КАК НачислениеРодительскойПлатыНачисления
	      |ГДЕ
	      |	НачислениеРодительскойПлатыНачисления.Ссылка = &Ссылка
	      |;
	      |
	      |////////////////////////////////////////////////////////////////////////////////
	      |ВЫБРАТЬ
	      |	ТекущиеНачисления.НомерСтроки,
	      |	ТекущиеНачисления.Учащийся,
	      |	ТекущиеНачисления.Контрагент,
	      |	ТекущиеНачисления.ДоговорКонтрагента,
	      |	ТекущиеНачисления.ИДСтроки,
	      |	ДанныеДокумента.НомерСтроки КАК НомерСтрокиИсх,
	      |	ДанныеДокумента.ИДСтроки КАК ИДСтрокиИсх,
	      |	ДанныеДокумента.Учащийся КАК УчащийсяИсх,
	      |	ДанныеДокумента.Контрагент КАК КонтрагентИсх,
	      |	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагентаИсх
	      |ПОМЕСТИТЬ СвязанныеТаблицы
	      |ИЗ
	      |	ТекущиеНачисления КАК ТекущиеНачисления
	      |		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
	      |		ПО ТекущиеНачисления.Учащийся = ДанныеДокумента.Учащийся
	      |			И ТекущиеНачисления.Контрагент = ДанныеДокумента.Контрагент
	      |			И ТекущиеНачисления.ДоговорКонтрагента = ДанныеДокумента.ДоговорКонтрагента
	      |			И ТекущиеНачисления.ИДСтроки = ДанныеДокумента.ИДСтроки
	      |;
	      |
	      |////////////////////////////////////////////////////////////////////////////////
	      |ВЫБРАТЬ
	      |	СвязанныеТаблицы.НомерСтрокиИсх,
	      |	СвязанныеТаблицы.ИДСтрокиИсх,
	      |	СвязанныеТаблицы.УчащийсяИсх,
	      |	СвязанныеТаблицы.КонтрагентИсх,
	      |	СвязанныеТаблицы.ДоговорКонтрагентаИсх
	      |ПОМЕСТИТЬ СвободныеИдентификаторы
	      |ИЗ
	      |	СвязанныеТаблицы КАК СвязанныеТаблицы
	      |ГДЕ
	      |	СвязанныеТаблицы.НомерСтроки ЕСТЬ NULL 
	      |;
	      |
	      |////////////////////////////////////////////////////////////////////////////////
	      |ВЫБРАТЬ
	      |	СвязанныеТаблицы.НомерСтроки КАК НомерСтроки,
	      |	СвободныеИдентификаторы.ИДСтрокиИсх
	      |ИЗ
	      |	СвязанныеТаблицы КАК СвязанныеТаблицы
	      |		ЛЕВОЕ СОЕДИНЕНИЕ СвободныеИдентификаторы КАК СвободныеИдентификаторы
	      |		ПО СвязанныеТаблицы.Учащийся = СвободныеИдентификаторы.УчащийсяИсх
	      |			И СвязанныеТаблицы.Контрагент = СвободныеИдентификаторы.КонтрагентИсх
	      |			И СвязанныеТаблицы.ДоговорКонтрагента = СвободныеИдентификаторы.ДоговорКонтрагентаИсх
	      |ГДЕ
	      |	СвязанныеТаблицы.НомерСтрокиИсх ЕСТЬ NULL
		  |	И НЕ СвободныеИдентификаторы.ИДСтрокиИсх ЕСТЬ NULL
	      |
	      |УПОРЯДОЧИТЬ ПО
	      |	НомерСтроки
	      |ИТОГИ ПО
	      |	НомерСтроки");
							  
		Запрос.УстановитьПараметр("Начисления",Начисления.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого СтрТЧ Из Начисления Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				Если Выборка.НайтиСледующий(Новый Структура("НомерСтроки",СтрТЧ.НомерСтроки)) Тогда
					ВыборкаДетальная = Выборка.Выбрать();
					Пока ВыборкаДетальная.Следующий() Цикл
						Если МассивИдентификаторовСтрок.Найти(ВыборкаДетальная.ИДСтрокиИсх) = Неопределено Тогда
							СтрТЧ.ИДСтроки = ВыборкаДетальная.ИДСтрокиИсх;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
					СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	КонецЕсли;
	
	ПериодНачисления = НачалоМесяца(ПериодНачисления);
	
	Если УчитыватьНДС Тогда
		СуммаДокумента = Начисления.Итог("Сумма") + ?(СуммаВключаетНДС, 0, Начисления.Итог("СуммаНДС"));
	Иначе
		СуммаВключаетНДС = Ложь;
		СуммаДокумента = Начисления.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.НачислениеСтудентамЗаПрочиеУслуги.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетыСоСтудентамиДопУслуги");
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НДСНеоблагаемыеОперации");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДокументыПоНеоблагаемымНДСОперациям");
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиСтрокИСуществующиеНачисления(Отказ)
	
	ШаблонТекстДублей = НСтр("ru = 'Для учащегося ""%1"" повторяется начисление за услугу ""%2"" по аналитике: плательщик ""%3"", договор ""%4"", период с %5 по %6 и ставке ""%7""'");
	ШаблонТекстНачислений = НСтр("ru = 'Для учащегося %1 по договору %2 уже есть начисление по услуге %3 за выбранный период,
							|на сумму %4 в документе %5'");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаНачислений.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаНачислений.Студент КАК Студент,
	               |	ТаблицаНачислений.Контрагент КАК Контрагент,
	               |	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ТаблицаНачислений.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
	               |	ТаблицаНачислений.ПериодНачисленияКонец КАК ПериодНачисленияКонец,
	               |	ТаблицаНачислений.СтавкаОплаты КАК СтавкаОплаты,
	               |	ТаблицаНачислений.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	               |ПОМЕСТИТЬ ТаблицаНачислений
	               |ИЗ
	               |	&ТаблицаНачислений КАК ТаблицаНачислений
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Студент,
	               |	ПериодНачисленияНачало,
	               |	ПериодНачисленияКонец,
	               |	СтавкаОплаты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНачислений.Студент КАК Студент,
	               |	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	НачисленияФактическиеДопУслуги.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
	               |	СУММА(НачисленияФактическиеДопУслуги.СуммаВзаиморасчетов) КАК Сумма,
	               |	НачисленияФактическиеДопУслуги.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ФактическиеНачисления
	               |ИЗ
	               |	ТаблицаНачислений КАК ТаблицаНачислений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСоСтудентамиДопУслуги КАК НачисленияФактическиеДопУслуги
	               |		ПО ТаблицаНачислений.Студент = НачисленияФактическиеДопУслуги.Студент
	               |			И ТаблицаНачислений.ДоговорКонтрагента = НачисленияФактическиеДопУслуги.ДоговорКонтрагента
	               |ГДЕ
	               |	НачисленияФактическиеДопУслуги.Регистратор <> &Регистратор
	               |	И ТИПЗНАЧЕНИЯ(НачисленияФактическиеДопУслуги.Регистратор) = ТИП(Документ.НачислениеСтудентамЗаПрочиеУслуги)
	               |	И НачисленияФактическиеДопУслуги.Факультет = &Факультет
	               |	И НачисленияФактическиеДопУслуги.Период = &ПериодНачисления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНачислений.Студент,
	               |	ТаблицаНачислений.ДоговорКонтрагента,
	               |	ТаблицаНачислений.ПериодНачисленияКонец,
	               |	НачисленияФактическиеДопУслуги.Регистратор,
	               |	НачисленияФактическиеДопУслуги.НачислениеЗаУслугу
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(НачисленияФактическиеДопУслуги.СуммаВзаиморасчетов) > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ТаблицаНачислений.НомерСтроки) КАК НомерСтроки,
	               |	ТаблицаНачислений.Студент КАК Студент,
	               |	ТаблицаНачислений.Контрагент КАК Контрагент,
	               |	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ТаблицаНачислений.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
	               |	ТаблицаНачислений.ПериодНачисленияКонец КАК ПериодНачисленияКонец,
	               |	ТаблицаНачислений.СтавкаОплаты КАК СтавкаОплаты,
	               |	ТаблицаНачислений.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	               |ИЗ
	               |	ТаблицаНачислений КАК ТаблицаНачислений
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНачислений.Студент,
	               |	ТаблицаНачислений.Контрагент,
	               |	ТаблицаНачислений.ДоговорКонтрагента,
	               |	ТаблицаНачислений.ПериодНачисленияНачало,
	               |	ТаблицаНачислений.ПериодНачисленияКонец,
	               |	ТаблицаНачислений.СтавкаОплаты,
	               |	ТаблицаНачислений.НачислениеЗаУслугу
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(*) > 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНачислений.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаНачислений.Студент КАК Студент,
	               |	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ТаблицаНачислений.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
	               |	ЕСТЬNULL(НачисленияФактическиеДопУслуги.Сумма, 0) КАК Сумма,
	               |	ЕСТЬNULL(НачисленияФактическиеДопУслуги.Регистратор, НЕОПРЕДЕЛЕНО) КАК ДокументНачисления
	               |ИЗ
	               |	ТаблицаНачислений КАК ТаблицаНачислений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ФактическиеНачисления КАК НачисленияФактическиеДопУслуги
	               |		ПО ТаблицаНачислений.Студент = НачисленияФактическиеДопУслуги.Студент
	               |			И ТаблицаНачислений.ДоговорКонтрагента = НачисленияФактическиеДопУслуги.ДоговорКонтрагента
	               |			И ТаблицаНачислений.НачислениеЗаУслугу = НачисленияФактическиеДопУслуги.НачислениеЗаУслугу
	               |ГДЕ
	               |	ЕСТЬNULL(НачисленияФактическиеДопУслуги.Сумма, 0) <> 0";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаНачислений", Начисления.Выгрузить(, "НомерСтроки, Студент, Контрагент, ДоговорКонтрагента, ПериодНачисленияНачало, ПериодНачисленияКонец, СтавкаОплаты, НачислениеЗаУслугу"));
	Запрос.УстановитьПараметр("ПериодНачисления", ПериодНачисления);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	// МассивРезультатов[0] - ВТ ТаблицаНачислений
	// МассивРезультатов[1] - ВТ ФактическиеНачисления
	ВыборкаДублей = МассивРезультатов[2].Выбрать();
	ВыборкаНачислений = МассивРезультатов[3].Выбрать();
	
	Пока ВыборкаДублей.Следующий() Цикл
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстДублей,
			ВыборкаДублей.Студент,
			ВыборкаДублей.НачислениеЗаУслугу,
			ВыборкаДублей.Контрагент,
			ВыборкаДублей.ДоговорКонтрагента,
			Формат(ВыборкаДублей.ПериодНачисленияНачало, "ДЛФ=D"),
			Формат(ВыборкаДублей.ПериодНачисленияКонец, "ДЛФ=D"),
			ВыборкаДублей.СтавкаОплаты
		);
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", ВыборкаДублей.НомерСтроки, "Студент");
		ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект, Поле,, Отказ);
		
	КонецЦикла;
	
	Пока ВыборкаНачислений.Следующий() Цикл
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстНачислений,
			ВыборкаНачислений.Студент,
			ВыборкаНачислений.ДоговорКонтрагента,
			ВыборкаНачислений.НачислениеЗаУслугу,
			ВыборкаНачислений.Сумма,
			ВыборкаНачислений.ДокументНачисления
		);
		
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления",
			ВыборкаНачислений.НомерСтроки, "Студент");
		ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект, Поле,, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСуммыНДСВСтроке(СтрокаНачисления, Отказ)

	Если СтрокаНачисления.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС И СтрокаНачисления.СтавкаНДС <> Перечисления.СтавкиНДС.НДС0 Тогда
		
		Если СтрокаНачисления.СуммаНДС = 0 Тогда
			
			ШаблонСуммаНДС = НСтр("ru = 'Не заполнена колонка ""Сумма НДС"" в строке %НомерСтроки% списка ""Начисления""'");
			ТекстСообщения = СтрЗаменить(ШаблонСуммаНДС, "%НомерСтроки%", Строка(СтрокаНачисления.НомерСтроки));
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "СуммаНДС");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле,, Отказ);
		
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаполнениеПериодаНачисленияВСтроке(СтрокаНачисления, Отказ)

	Если СтрокаНачисления.ПериодНачисленияНачало < НачалоМесяца(ПериодНачисления) Тогда
		
		ШаблонНачалоПериода = НСтр("ru = 'Дата начала начисления в строке %НомерСтроки% списка ""Начисления"" меньше, чем период начисления документа'");
		ТекстСообщения = СтрЗаменить(ШаблонНачалоПериода, "%НомерСтроки%", Строка(СтрокаНачисления.НомерСтроки));
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "ПериодНачисленияНачало");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле,, Отказ);
			
	КонецЕсли; 
	
	Если СтрокаНачисления.ПериодНачисленияКонец > КонецМесяца(ПериодНачисления) Тогда
		
		ШаблонКонецПериода = НСтр("ru = 'Дата конца начисления в строке %НомерСтроки% списка ""Начисления"" больше, чем период начисления документа'");
		ТекстСообщения = СтрЗаменить(ШаблонКонецПериода, "%НомерСтроки%", Строка(СтрокаНачисления.НомерСтроки));
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", СтрокаНачисления.НомерСтроки, "ПериодНачисленияКонец");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле,, Отказ);
		
	КонецЕсли; 

КонецПроцедуры
 
