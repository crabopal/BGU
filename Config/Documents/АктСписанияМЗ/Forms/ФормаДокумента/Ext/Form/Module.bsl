&НаКлиенте
Процедура ПослеОтветаНаВопросОбУдалении(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да И Элементы.Материалы.ТекущиеДанные <> Неопределено Тогда
		ОбъектНаУдаление = Элементы.Материалы.ТекущиеДанные.Номенклатура;
		ПриУдаленииНоменклатуры(ОбъектНаУдаление);
		Объект.Материалы.Удалить(Элементы.Материалы.ТекущаяСтрока);
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриУдаленииНоменклатуры(ОбъектНаУдаление)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА (%1) на закладке ""Драгоценные материалы""?'"),
			СокрЛП(ОбъектНаУдаление));
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаДокументаОснования()
	ТипыОснований = Объект.Ссылка.Метаданные().Реквизиты.ДокументОснование.Тип.Типы();
	
	ТипыОграничений = Новый Массив;
	Для Каждого ТипОснования Из ТипыОснований Цикл
		Если ТипОснования <> Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ") Тогда
			ТипыОграничений.Добавить(ТипОснования);				
		КонецЕсли;
	КонецЦикла;
	Элементы.ДокументОснование.ОграничениеТипа = Новый ОписаниеТипов(ТипыОграничений);
	Элементы.РешениеОПрекращенииПризнанияАктивом.ОграничениеТипа =
		Новый ОписаниеТипов("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ");
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЕстьРешениеОПрекращенииПризнанияАктивомПриИзмененииАсинх()
	ФлагИзменился = Ждать ЕстьСогласиеПользователяНаИзменениеФлагаЕстьРешение(); 
	Если Не ФлагИзменился Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		ОчиститьРеквизитыНедоступныеЕслиВыбраноРешение(Объект);
		УправлениеМатериальнымиЗапасамиКлиентСервер.ОчиститьВидДопСубконтоЛичногоПользования(ЭтотОбъект, "МатериалыДополнительноеСубконтоСчета");
	Иначе
		Объект.ДокументОснование = Неопределено;
		ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(ЭтотОбъект);
	КонецЕсли;
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Асинх Функция ЕстьСогласиеПользователяНаИзменениеФлагаЕстьРешение()
	
	ТекстВопроса = "";
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		Если Объект.ВыдатьВЛичноеПользование Тогда
			ТекстВопроса = НСтр("ru = 'Будет снят флаг ""Выдать в личное пользование"" и очищен получатель имущества'");
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.ДокументОснование)
			И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ") Тогда
			ТекстВопроса = НСтр("ru = 'Будет очищен документ ""Решение""'");				
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстВопроса) Тогда
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Если Результат <> КодВозвратаДиалога.ОК Тогда
			Объект.ЕстьРешениеОПрекращенииПризнанияАктивом = Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПослеИзмененияДокументаОснования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоДокументуОснованию();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ПодготовитьФормуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияФлажкаАннулирован(Результат, ДополнительныеПараметры) Экспорт
	Если ЭтоАктСписания0510460или0510461 Тогда
		УправлениеЭлементамиГолосования();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПервичныйДокументПриИзмененииНаСервере()
	
	Если ЭтоАктСписания0510460или0510461 И Объект.Материалы.Количество() > 0 Тогда
		ПроверитьЗаполнениеИдентификатораСтроки();
	КонецЕсли;
	
	Если  Объект.СоставКомиссии.Количество() > 0
			И ЭтоАктСписания0510460или0510461
			И Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
		Объект.СоставКомиссии.Очистить();
	КонецЕсли;
	
