&НаКлиенте
Процедура ЦМООтправительОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЦМООтправительДоИзменения = Объект.ЦМООтправитель;
КонецПроцедуры

&НаКлиенте
Процедура ЦМООтправительПриИзменении(Элемент)
	ПараметрыИзмененияЦМО = УправлениеНФАКлиент.ПараметрыИзмененияРеквизитаСОчисткойТЧ();
	ПараметрыИзмененияЦМО.ЗначениеДоИзменения = ЦМООтправительДоИзменения;
	ПараметрыИзмененияЦМО.ИмяРеквизита = "ЦМООтправитель";
	ПараметрыИзмененияЦМО.СинонимРеквизита = НСтр("ru = 'МОЛ/Место хранения'");
	ПараметрыИзмененияЦМО.ИменаТабличныхЧастей = "Материалы, ДрагоценныеМатериалы, СведенияПрослеживаемости";
	
	УправлениеНФАКлиент.ПриИзмененииРеквизитаСОчисткойТЧ(Объект, ПараметрыИзмененияЦМО);
	ОчисткаРеквизитовПолучателяИмуществаСчет27(ЭтотОбъект);
	УстановитьВидимостьЭлементовЦМО_ЛичногоПользованияСчет27(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОтвета = Новый ОписаниеОповещения("ПослеИзмененияДокументаОснования", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Заполнить документ по выбранному документу-основанию?'");
	ПоказатьВопрос(ОписаниеОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ДержательИмуществаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекущийДержательИмущества = Объект.ПолучательИмущества;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДержательИмуществаПриИзменении(Элемент)
	
	Если ТекущийДержательИмущества <> Объект.ПолучательИмущества Тогда
		Если Объект.Материалы.Количество() Тогда
			Если Ждать СогласиеПользователяНаОчисткуМатериалы() Тогда
				Объект.Материалы.Очистить();
			Иначе
				Объект.ПолучательИмущества = ТекущийДержательИмущества;
			КонецЕсли;
		КонецЕсли;
		ОчисткаРеквизитовПолучателяИмуществаСчет27(ЭтотОбъект);
		УстановитьВидимостьЭлементовЦМО_ЛичногоПользованияСчет27(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательИмуществаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ПолучательИмущества) И УчетПоПодразделениямНаСчетахУчетаИмущества Тогда
		Объект.ПодразделениеПолучатель = ТекущееПодразделениеПолучателяИмущества(Объект.Дата, Объект.ПолучательИмущества);
	КонецЕсли;

КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ТекущиеДанные.РезолюцияКомиссииОдобрена = Ложь;
		ТекущиеДанные.ИтогГолосования = 0;
		ТекущиеДанные.РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.ПустаяСсылка");
	КонецЕсли;

	Если НоваяСтрока И НЕ Копирование Тогда
		Если СчетУчетаВТаблицеБратьИзШапки(ЭтотОбъект) Тогда
			ТекущиеДанные.СчетУчета = Объект.СчетУчета;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, ТекущиеДанные);
		КонецЕсли;
		ТекНомерСтроки = ТекущиеДанные.НомерСтроки;
		Если ТекНомерСтроки >1 Тогда
			ТекущиеДанные.ПричинаСписания = Объект.Материалы[ТекНомерСтроки-2].ПричинаСписания;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.НаправленияРасходаМПЗ") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписания = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПричиныСписанияНФА") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписанияСсылка = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПередУдалением(Элемент, Отказ)
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбУдалении", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'После удаления строки ее нельзя будет добавить вручную.
			|Для повторного добавления строки потребуется полностью заполнить документ на основании ""Решения о прекращении признанания"".
			|Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ОбъектНаУдаление = Элементы.Материалы.ТекущиеДанные.Номенклатура;
	ПриУдаленииНоменклатуры(ОбъектНаУдаление);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, Элементы.Материалы.ТекущиеДанные, Истина);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	ТекДанные = Элементы.Материалы.ТекущиеДанные;
	ТекДанные.КоличествоНорма = ТекДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаПриИзменении(Элемент)
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, Элементы.Материалы.ТекущиеДанные, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.НачалоВыбораСчетаМатериалаВТаблицеДокумента(ЭтотОбъект,
		Объект.СчетУчета, Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.АвтоПодборСчетаМатериалаВТаблицеДокумента(ЭтотОбъект, Объект.СчетУчета, Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.ОкончаниеВводаТекстаСчетаМатериалаВТаблицеДокумента(ЭтотОбъект, Объект.СчетУчета, Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.НаправленияРасходаМПЗ.Форма.ФормаВыбора",,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПричинаСписанияАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) > 0 Тогда
		ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.НаправленияРасходаМПЗ"), ПараметрыВыбораЗначения);
		Если ДанныеВыбора.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыДополнительнаяАналитикаСчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если СчетУчета27(ЭтотОбъект) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ОрганизацияСотрудника", Объект.Организация));
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ДополнительнаяАналитикаСчета);
		ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы, Элемент);
	КонецЕсли;
КонецПроцедуры

