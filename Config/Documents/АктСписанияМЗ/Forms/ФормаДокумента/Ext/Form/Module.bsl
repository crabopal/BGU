&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МатериалыКФО", "Видимость",
		Форма.Объект.КФОВТабличнойЧасти);
	
	ЭтоАктПриемаПередачи0510434 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "Акт0510434");
	ЭтоАктОСписании0510460или0510461 = Форма.ЭтоАктСписания0510460или0510461;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыЗаполнитьКПСНоменклатура",
		"Видимость", Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	ЭлементыСписанияБезРешения = Новый Массив;
	ЭлементыСписанияБезРешения.Добавить("ДокументОснование");
	ЭлементыСписанияБезРешения.Добавить("АналитикаОперацииСДрагМатериалами");
	ЭлементыСписанияБезРешения.Добавить("НоменклатураЛома");
	ЭлементыСписанияБезРешения.Добавить("СписокНФАДокументаОснования");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалы");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалыЗаполнитьСписокДМДляСписания");
	ЭлементыСписанияБезРешения.Добавить("ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыСписанияБезРешения,
		"Видимость", Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РешениеОПрекращенииПризнанияАктивом",
		"Видимость", Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	// Элементы только акта списания 0510460
	Элементы61н = Новый Массив;
	Элементы61н.Добавить("ТребуетсяУтилизация");
	Элементы61н.Добавить("МатериалыПричинаСписанияСсылка");
	Элементы61н.Добавить("МатериалыСерияБСО");
	Элементы61н.Добавить("МатериалыНачальныйНомерБСО");
	Элементы61н.Добавить("МатериалыКонечныйНомерБСО");
	Элементы61н.Добавить("МатериалыУстановитьПричинуСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы61н,
		"Видимость", ЭтоАктОСписании0510460или0510461);
	
	Элементы61нДляСписания = Новый Массив;
	Элементы61нДляСписания.Добавить("Комиссия");
	Элементы61нДляСписания.Добавить("ГруппаИндикаторКворумаПрисутствия");
	Элементы61нДляСписания.Добавить("СоставКомиссии1");
	Элементы61нДляСписания.Добавить("НадписьГолосование");
	Элементы61нДляСписания.Добавить("Сотрудник");
	Элементы61нДляСписания.Добавить("СохранитьРезультатыГолосования");
	Элементы61нДляСписания.Добавить("НадписьФайл");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы61нДляСписания,
		"Видимость", ЭтоАктОСписании0510460или0510461);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФайлСотрудника",
		"Видимость", ЭтоАктОСписании0510460или0510461
		И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУдалитьФайл",
		"Видимость", ЭтоАктОСписании0510460или0510461
		И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьФайлНеВыбран",
		"Видимость", ЭтоАктОСписании0510460или0510461
		И Не ЗначениеЗаполнено(Форма.ФайлСотрудника));
	
	// Элементы акта списания 0504230
	Элементы52н = Новый Массив;
	Элементы52н.Добавить("СоставКомиссии");
	Элементы52н.Добавить("НомерПриказа");
	Элементы52н.Добавить("ДатаПриказа");
	Элементы52н.Добавить("ДекорацияВыбратьКомиссию");
	Элементы52н.Добавить("ДолжностьПредседательКомиссии");
	Элементы52н.Добавить("ФамилияПредседательКомиссии");
	Элементы52н.Добавить("ИмяПредседательКомиссии");
	Элементы52н.Добавить("ОтчествоПредседательКомиссии");
	Элементы52н.Добавить("ВыбратьПредседателяКомиссии");
	Элементы52н.Добавить("ЗаключениеКомиссии");
	Элементы52н.Добавить("МатериалыПричинаСписания");
	Элементы52н.Добавить("МатериалыУстановитьНаправлениеРасхода");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы52н,
		"Видимость",
		Не ЭтоАктПриемаПередачи0510434
		И Не ЭтоАктОСписании0510460или0510461
		И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	// Общие реквизиты для выдачи в личное пользование
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыдатьВЛичноеПользование",
		"Видимость",
		СчетУчета105(Форма) И Не ЭтоАктОСписании0510460или0510461 И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	ЭлементыПередачиИмущества = Новый Массив;
	ЭлементыПередачиИмущества.Добавить("ПолучательИмущества");
	ЭлементыПередачиИмущества.Добавить("ОткрытьНормуСотрудника");
	ЭлементыПередачиИмущества.Добавить("МатериалыВидимыеДефекты");
	ЭлементыПередачиИмущества.Добавить("МатериалыОсобыеОтметки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыПередачиИмущества,
		"Видимость", Объект.ВыдатьВЛичноеПользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодразделениеПолучатель",
		"Видимость", Объект.ВыдатьВЛичноеПользование И Форма.УчетПоПодразделениямНаСчетахУчетаИмущества);

	// Основание списания
	ЭлементыОснования = Новый Массив;
	ЭлементыОснования.Добавить("ВидОснованияСписания");
	ЭлементыОснования.Добавить("ДатаОснованияСписания");
	ЭлементыОснования.Добавить("НомерОснованияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыОснования,
		"Видимость", Не ЭтоАктОСписании0510460или0510461);
	
	// Резервирование и подбор
	ЭлементыРезервированияПодбор = Новый Массив;
	ЭлементыРезервированияПодбор.Добавить("ПереключательРезервирование");
	ЭлементыРезервированияПодбор.Добавить("Аннулирован");
	ЭлементыРезервированияПодбор.Добавить("МатериалыПодборНоменклатуры");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыРезервированияПодбор,
		"Видимость", Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
		
	// Прослеживаемость
	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров
		И СчетУчетаПрослеживаемый(Форма)
		И Форма.ЕстьПрослеживаемыеТовары
		И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом;
	
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОтражатьВПрослеживаемости");
	ИменаЭлементовПрослеживаемости.Добавить("МатериалыПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ИменаЭлементовДвиженияПрослеживаемости = Новый Массив;
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("МатериалыСтранаПроисхождения");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("МатериалыРНПТ");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовДвиженияПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости И Объект.ОтражатьВПрослеживаемости);
	
	УстановитьВидимостьЭлементовЦМО_ЛичногоПользованияСчет27(Форма);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"МатериалыДополнительноеСубконтоСчета",
		"Видимость", Форма.ЕстьДополнительноеСубконто3 ИЛИ ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто));
	
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(Форма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме = Неопределено)

	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Истина;
	ПараметрыЗаполненияСчета.Включать106 = Истина;
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);
	
	Для Каждого НастройкаСчета Из ДанныеСчетовВФорме Цикл
		Если ЗначениеЗаполнено(НастройкаСчета.ДополнительноеСубконто3) Тогда
			СчетаДопСубконто3.Добавить(НастройкаСчета.Счет);
		КонецЕсли;
	КонецЦикла;
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ОтключитьВидимостьКолонкиДопСубконто();
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	МассивСчетов27 = БухгалтерскийУчет.СписокСчетов("27", ДатаСчетов, , Объект.Организация);
	ФиксМассивСчетов27 = Новый ФиксированныйМассив(МассивСчетов27);
	СчетСсылка105 = БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчетов, Объект.Организация);
	СчетСсылка106 = БухгалтерскийУчет.СчетПоКоду("106.00", ДатаСчетов, Объект.Организация);
	СчетСсылка0133 = БухгалтерскийУчет.СчетПоКоду("01.33", ДатаСчетов, Объект.Организация);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105", СчетСсылка105);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет106", СчетСсылка106);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0133", СчетСсылка0133);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счета27", ФиксМассивСчетов27);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетУчетаИмуществаВПользовании",
		БухгалтерскийУчет.СчетПоКоду("27.02", ДатаСчетов, Объект.Организация));

	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ПрослеживаемыеСчета",
		Новый ФиксированныйМассив(ПрослеживаемостьБГУ.СчетаУчетаНФАСПрослеживаемостью(ДатаСчетов, Объект.Организация)));
		
	УчетПоПодразделениямНаСчетахУчетаИмущества = УправлениеМатериальнымиЗапасами.ЕстьУчетПоПодразделениямСчетаУчета27(
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям, ЭтотОбъект.КэшПараметров.Локальные.Счета27);

КонецПроцедуры

