	Если Не ПустаяСтрока(ТекстОшибкиПриЗаписи) Тогда
		ПоказатьПредупреждение(Неопределено, ТекстОшибкиПриЗаписи);
		ТекстОшибкиПриЗаписи = "";
	КонецЕсли;
