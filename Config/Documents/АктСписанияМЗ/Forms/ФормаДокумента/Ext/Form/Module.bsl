КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		Возврат;
	КонецЕсли;
	ПараметрыПодбора = УправлениеМатериальнымиЗапасамиФормыКлиент.ПараметрыОткрытияПодбора();
	ПроверяемыеРеквизиты = Новый Массив;
	ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'Организация'"));
	Если Не СчетУчета27(ЭтотОбъект) Тогда
		ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'ЦМООтправитель, МОЛ/Место хранения'"));
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.ЦМООтправитель) Тогда
			ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'ПолучательИмущества, Получатель имущества(сотрудник)'")); 
		КонецЕсли;
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'СчетУчета, Счет учета'"));
	Если Не Объект.КФОВТабличнойЧасти Тогда
		ПроверяемыеРеквизиты.Добавить(НСтр("ru = 'КФО'"));
	КонецЕсли;
	ПараметрыПодбора.ПроверяемыеРеквизиты = СтрСоединить(ПроверяемыеРеквизиты, ";");
	ПараметрыПодбора.ПараметрыОтбора = ДополнитьСтруктуруПодбора();
	Если Объект.Материалы.Количество() Тогда
		ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора);
	КонецЕсли;
	УправлениеМатериальнымиЗапасамиФормыКлиент.ОткрытьПодборМатериалов(ЭтотОбъект, Объект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписокСчетов(Команда)
	
	Если ЗначениеЗаполнено(Объект["Организация"]) Тогда
		ПараметрыФормы = Новый Структура("Организация, ИФО, Дата",
			Объект.Организация,
			Объект.ИФО,
			Объект.Дата);
		ОткрытьФорму("РегистрСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ.Форма.НастройкаСпискаСчетов", ПараметрыФормы);
		
	Иначе
		ТекстЗаголовка = НСтр("ru='Инвентаризация материалов'");
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено. Список счетов редактируется только для конкретной организации, поэтому сначала выберите ее.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения, 20, ТекстЗаголовка);
		
	КонецЕсли;
	
КонецПроцедуры

