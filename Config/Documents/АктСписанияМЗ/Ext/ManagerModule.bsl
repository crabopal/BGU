// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.АктСписанияМЗ
//  Параметры - Структура
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	Возврат УправлениеМатериальнымиЗапасами.ТаблицаСписанияМатериальныхЗапасовПоДокументуАктыСписанияМЗ(Документ, Параметры);
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

Функция ПечатьАкта230(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	АктСписанияМЗМатериалы.Ссылка КАК Ссылка,
	|	АктСписанияМЗМатериалы.СчетУчета КАК Счет
	|ПОМЕСТИТЬ СчетаДокументов
	|ИЗ
	|	Документ.АктСписанияМЗ.Материалы КАК АктСписанияМЗМатериалы
	|ГДЕ
	|	АктСписанияМЗМатериалы.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетДт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСДт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетКт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСКт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭККт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА Выразить(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 Как Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА Выразить(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 Как Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА Выразить(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 Как Справочник.Номенклатура)
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 НЕ В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 НЕ В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 НЕ В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3
	|		ИНАЧЕ Неопределено
	|	КОНЕЦ КАК ДопСубконто,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	0 КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И Регистратор ССЫЛКА Документ.АктСписанияМЗ,
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|ГДЕ
	|	(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор, ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт) В
	|			(ВЫБРАТЬ
	|				СчетаДокументов.Ссылка,
	|				СчетаДокументов.Счет
	|			ИЗ
	|				СчетаДокументов КАК СчетаДокументов
	|			ГДЕ
	|				СчетаДокументов.Ссылка = ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМЗ.Ссылка,
	|	АктСписанияМЗ.Номер КАК ТекстНомер,
	|	АктСписанияМЗ.Дата КАК ТекстДата,
	|	АктСписанияМЗ.Организация,
	|	АктСписанияМЗ.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	АктСписанияМЗ.Организация.КодОКПО КАК КодОКПО,
	|	АктСписанияМЗ.Организация.ИНН КАК ИНН,
	|	АктСписанияМЗ.Организация.КПП КАК КПП,
	|	АктСписанияМЗ.ИФО,
	|	АктСписанияМЗ.КФО,
	|	АктСписанияМЗ.ПодразделениеОтправитель,
	|	АктСписанияМЗ.ПодразделениеОтправитель.Наименование КАК Подразделение,
	|	АктСписанияМЗ.ЦМООтправитель,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗ.ЦМООтправитель <> ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|			ТОГДА АктСписанияМЗ.ЦМООтправитель.Сотрудник.Контрагент
	|		ИНАЧЕ АктСписанияМЗ.ПолучательИмущества.Контрагент
	|	КОНЕЦ КАК ЦМО,
	|	АктСписанияМЗ.ДолжностьПредседательКомиссии КАК ДолжностьПредседателяКомиссии,
	|	АктСписанияМЗ.ФамилияПредседательКомиссии КАК ФамилияПредседателяКомиссии,
	|	АктСписанияМЗ.ИмяПредседательКомиссии КАК ИмяПредседателяКомиссии,
	|	АктСписанияМЗ.ОтчествоПредседательКомиссии КАК ОтчествоПредседателяКомиссии,
	|	АктСписанияМЗ.НомерПриказа КАК ТекстНомерПриказа,
	|	АктСписанияМЗ.ДатаПриказа КАК ТекстДатаПриказа,
	|	АктСписанияМЗ.Руководитель.Контрагент КАК ДиректорСсылка,
	|	АктСписанияМЗ.ЗаключениеКомиссии,
	|	АктСписанияМЗ.КФОВТабличнойЧасти,
	|	АктСписанияМЗ.Материалы.(
	|		Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК НоменклатураСсылка,
	|		ВЫБОР
	|			КОГДА АктСписанияМЗ.Материалы.Номенклатура.НаименованиеПолное = """"
	|				ТОГДА АктСписанияМЗ.Материалы.Номенклатура.Наименование
	|			ИНАЧЕ АктСписанияМЗ.Материалы.Номенклатура.НаименованиеПолное
	|		КОНЕЦ КАК НоменклатураПредставление,
	|		Номенклатура.Наименование КАК НоменклатураНаименование,
	|		Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|		КоличествоНорма КАК НормаРасхода,
	|		Количество,
	|		ПричинаСписания,
	|		ПРЕДСТАВЛЕНИЕ(АктСписанияМЗ.Материалы.Номенклатура.ЕдиницаИзмерения) КАК Единица,
	|		Номенклатура.Код КАК КодНоменклатуры,
	|		Номенклатура.НоменклатурныйНомер КАК НоменклатурныйНомерНоменклатуры,
	|		ВЫБОР
	|			КОГДА АктСписанияМЗ.Материалы.Номенклатура.НоменклатурныйНомер = """"
	|				ТОГДА АктСписанияМЗ.Материалы.Номенклатура.Код
	|			ИНАЧЕ АктСписанияМЗ.Материалы.Номенклатура.НоменклатурныйНомер
	|		КОНЕЦ КАК НоменклатурныйНомер,
	|		КФО,
	|		СчетУчета,
	|		КПС,
	|		КЭК,
	|		ДополнительнаяАналитикаСчета
	|	),
	|	АктСписанияМЗ.СоставКомиссии.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДолжностьЧленаКомиссии,
	|		ФамилияЧленаКомиссии,
	|		ИмяЧленаКомиссии,
	|		ОтчествоЧленаКомиссии
	|	)
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктСписанияМЗ.Дата,
	|	АктСписанияМЗ.Номер,
	|	НомерСтроки";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДвиженияДокументов = РезультатЗапроса[1].Выгрузить();
	ВыборкаДокументы = РезультатЗапроса[2].Выбрать();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.Автомасштаб = Истина;
	ТабДокумент.ПолеСлева  = 5;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ИмяПараметровПечати = "ПараметрыПечати_АктСписанияМЗ_0504230";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктСписанияМЗ." + ИмяМакета);
	
	ОбластьМакетаЗаголовок  = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка      = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока     = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого      = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал     = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакетаКомиссия   = Макет.ПолучитьОбласть("Комиссия");
	ОбластьМакетаДата       = Макет.ПолучитьОбласть("Дата");
	
	ОбластьМакетаЗаключение1 = Макет.ПолучитьОбласть("Заключение1");
	ОбластьМакетаЗаключение2 = Макет.ПолучитьОбласть("Заключение2");
	
	ЕстьДопОбластиКомиссия = Макет.Области.Найти("Комиссия1") <> Неопределено;
	МассивДопОбластейКомиссия = Новый Массив;
	Если ЕстьДопОбластиКомиссия Тогда
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия1"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия2"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия3"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия4"));
		МассивДопОбластейКомиссия.Добавить(ОбластьМакетаКомиссия);
	Иначе
		МассивДопОбластейКомиссия.Добавить(ОбластьМакетаКомиссия);
	КонецЕсли;
	
	ПараметрыРаспределенияДвижений = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвижений.ИмяКолонкиКЭК          = "КЭККт";
	ПараметрыРаспределенияДвижений.ИмяКолонкиНоменклатура = "НоменклатураСсылка";
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Номенклатура", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("СчетКт",       "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КПСКт",        "КПС");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Количество",   "Количество");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КЭККт",        "КЭК");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("ДопСубконто",  "ДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("Номенклатура", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("СчетКт",       "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КПСКт",        "КПС");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументы.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(ВыборкаДокументы);
		
		ДанныеДиректора = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ВыборкаДокументы.ДиректорСсылка, ВыборкаДокументы.ТекстДата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеДиректора, Истина);
		ДанныеЦМО = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ВыборкаДокументы.ЦМО, ВыборкаДокументы.ТекстДата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеЦМО, Истина);
		
		ГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ВыборкаДокументы.Организация,
			ВыборкаДокументы.ТекстДата, ВыборкаДокументы.ПодразделениеОтправитель);
		ДанныеГлБухгалтера = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ГлавныйБухгалтер.ОтветственноеЛицоСсылка, ВыборкаДокументы.ТекстДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеГлБухгалтера, Истина);
		ПараметрыОтметкиБухгалтерии = Новый Структура;
		ПараметрыОтметкиБухгалтерии.Вставить("Дата", Формат(ВыборкаДокументы.ТекстДата,"ДФ='MMMM yyyy'"));
		ПараметрыОтметкиБухгалтерии.Вставить("ФИОГлавныйБухгалтер",
			КорреспондентыКлиентСервер.ФИО(ДанныеГлБухгалтера, Истина));
		Для каждого ТекОбластьКомиссия Из МассивДопОбластейКомиссия Цикл
		
			ТекОбластьКомиссия.Параметры.Заполнить(ПараметрыОтметкиБухгалтерии);
		
		КонецЦикла;
		
		СтрокаКомиссия = "";
		ВыборкаКомиссия = ВыборкаДокументы.СоставКомиссии.Выбрать();
		ОбластьКомиссия = СформироватьОбластьКомиссия(
			ВыборкаДокументы, ВыборкаКомиссия, МассивДопОбластейКомиссия, 3, СтрокаКомиссия, Истина);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Директор", 		КорреспондентыКлиентСервер.ФИО(ДанныеДиректора, Истина));
		СтруктураПараметров.Вставить("МОЛ", 			"" + ДанныеЦМО.Фамилия + " " + ДанныеЦМО.Имя + " "
														+ ДанныеЦМО.Отчество);
		СтруктураПараметров.Вставить("ДатаПриказа", 	?(ЗначениеЗаполнено(ВыборкаДокументы.ТекстДатаПриказа),
														Формат(ВыборкаДокументы.ТекстДатаПриказа, "ДЛФ=DD"),
														"_______________"));
		СтруктураПараметров.Вставить("НомерПриказа", 	?(ЗначениеЗаполнено(ВыборкаДокументы.ТекстНомерПриказа),
														СокрЛП(ВыборкаДокументы.ТекстНомерПриказа),
														"_______________"));
		СтруктураПараметров.Вставить("Номер", 			РегистрыСведений.НастройкиПечатиПрефиксаНомера
														.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
														"АктСписанияМЗ", ВыборкаДокументы.ТекстНомер));
		СтруктураПараметров.Вставить("Дата", 			Формат(ВыборкаДокументы.ТекстДата, "ДЛФ=D"));
		СтруктураПараметров.Вставить("ДатаЗаголовка",	Формат(ВыборкаДокументы.ТекстДата, "ДЛФ=DD"));
		СтруктураПараметров.Вставить("ЧленыКомиссии",	СтрокаКомиссия);
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(СтруктураПараметров);
		ТабДокумент.Вывести(ОбластьМакетаЗаголовок);
		ТабДокумент.Вывести(ОбластьМакетаШапка);
		
		ОбластьЗаключение = Новый ТабличныйДокумент;
		ВыведеноСтрокЗаключения = ВывестиДлиннуюСтроку(ВыборкаДокументы.ЗаключениеКомиссии,
														 ОбластьЗаключение, 
														 ОбластьМакетаЗаключение1,
														 ОбластьМакетаЗаключение2,
														 "ЗаключениеЯчейка1",
														 "ЗаключениеЯчейка2");
		Для Счетчик = ВыведеноСтрокЗаключения + 1 По 3 Цикл
			
			ПустаяОбластьМакетаЗаключение2 = Макет.ПолучитьОбласть("Заключение2");
			ОбластьЗаключение.Вывести(ПустаяОбластьМакетаЗаключение2);
		
		КонецЦикла;
		
		СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(Новый Структура("Регистратор", ВыборкаДокументы.Ссылка));
		ТаблицаДвижений = ДвиженияДокументов.Скопировать(СтрокиДвижений);
		ВыборкаМатериалы = ВыборкаДокументы.Материалы.Выбрать();
		
		Если ВыборкаДокументы.КФОВТабличнойЧасти Тогда
			ПараметрыРаспределенияДвижений.КФОВТаблице            = Истина;
			ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КФО",          "КФО");
			ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КФО",          "КФО");
		Иначе
			ПараметрыРаспределенияДвижений.КФОВТаблице            = Ложь;
			Если ПараметрыРаспределенияДвижений.СоответствиеКолонок.Свойство("КФО") Тогда
				ПараметрыРаспределенияДвижений.СоответствиеКолонок.Удалить("КФО");
			КонецЕсли;
			Если ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Свойство("КФО") Тогда
				ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Удалить("КФО");
			КонецЕсли;
		КонецЕсли;

		ПараметрыРаспределенияДвижений.Организация = ВыборкаДокументы.Организация;
		ПараметрыРаспределенияДвижений.ИФО = ВыборкаДокументы.ИФО;
		ПараметрыРаспределенияДвижений.КФО = ВыборкаДокументы.КФО;
		ПараметрыРаспределенияДвижений.Дата = ВыборкаДокументы.ТекстДата;
		ПараметрыРаспределенияДвижений.ВыборкаМатериалы = ВыборкаМатериалы;
		ПараметрыРаспределенияДвижений.ТаблицаДвижений = ТаблицаДвижений;
		УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвижений);
		
		ВыборкаМатериалы = ВыборкаДокументы.Материалы.Выбрать();
		СуммаИтого 		= 0;
		КоличествоИтого	= 0;
		КоличествоСтрок = ВыборкаМатериалы.Количество();
		Пока ВыборкаМатериалы.Следующий() Цикл
			
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаМатериалы);
			
			СтруктураПараметров = Новый Структура("Цена, Сумма, СчетДебета, СчетКредита");
			СтруктураОтбора = Новый Структура("НомерСтрокиДокумента", ВыборкаМатериалы.НомерСтроки);

			ТекущиеДвижения = ТаблицаДвижений.НайтиСтроки(СтруктураОтбора);
			Если ТекущиеДвижения.Количество() > 0 Тогда
				ТекущееДвижение = ТекущиеДвижения[0];
				
				Если ТекущееДвижение.Количество <> 0 Тогда
					Цена = Окр(ТекущееДвижение.Сумма / ТекущееДвижение.Количество, 2);
				Иначе
					Цена = 0;
				КонецЕсли;
				Сумма = ТекущееДвижение.Сумма;

				Если ЗначениеЗаполнено(ТекущееДвижение.СчетДт) Тогда
					СтруктураПараметров.СчетДебета = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
						ТекущееДвижение.КПСДт, ТекущееДвижение.КФО, ТекущееДвижение.СчетДт, ТекущееДвижение.КЭКДт,,)
				КонецЕсли;
				СтруктураПараметров.СчетКредита = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
					ТекущееДвижение.КПСКт, ТекущееДвижение.КФО, ТекущееДвижение.СчетКт, ТекущееДвижение.КЭККт,,);
			Иначе
				Цена = 0;
				Сумма = 0;
			КонецЕсли;
			
			СтруктураПараметров.Цена	= Формат(Цена, "ЧДЦ=2");
			СтруктураПараметров.Сумма	= Формат(Сумма, "ЧДЦ=2");
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураПараметров);
				
			Если ВыборкаМатериалы.НомерСтроки <> КоличествоСтрок Тогда
				Если Не ТабДокумент.ПроверитьВывод(ОбластьМакетаСтрока) Тогда
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабДокумент.Вывести(ОбластьМакетаШапка);
				КонецЕсли;
			Иначе
				Области = Новый Массив;
				Области.Добавить(ОбластьМакетаСтрока);
				Области.Добавить(ОбластьМакетаИтого);
				Области.Добавить(ОбластьМакетаПодвал);
				Области.Добавить(ОбластьЗаключение);
				Области.Добавить(ОбластьКомиссия);
				Области.Добавить(ОбластьМакетаДата);
				Если Не ТабДокумент.ПроверитьВывод(Области) Тогда
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабДокумент.Вывести(ОбластьМакетаШапка);
				КонецЕсли;
			КонецЕсли;
			
			СуммаИтого 		= СуммаИтого		+ Сумма;
			КоличествоИтого	= КоличествоИтого	+ ВыборкаМатериалы.Количество;
			
			ТабДокумент.Вывести(ОбластьМакетаСтрока);
		
		КонецЦикла;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("КоличествоИтого", КоличествоИтого);
		СтруктураПараметров.Вставить("СуммаИтого", Формат(СуммаИтого, "ЧДЦ=2"));
		СтруктураПараметров.Вставить("СуммаИтогоПрописью",
			ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаИтого, Неопределено));
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураПараметров);
		ТабДокумент.Вывести(ОбластьМакетаИтого);
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураПараметров);
		ТабДокумент.Вывести(ОбластьМакетаПодвал);
		ТабДокумент.Вывести(ОбластьЗаключение);
		ТабДокумент.Вывести(ОбластьКомиссия);
		ТабДокумент.Вывести(ОбластьМакетаДата);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
		Для каждого ТекДвижение Из СтрокиДвижений Цикл
		
			ДвиженияДокументов.Удалить(ТекДвижение);
		
		КонецЦикла; 
		
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

// Выводит длинные строки в многострочные части печатных форм. 
//
// Параметры:
// СтрокаВывода - строка - которую будем выводить
// ТабДокумент - ТабличныйДокумент
// Область1 - ОбластьЯчеекТабличногоДокумента - Укороченная строка, с которой начинается вывод
// Область2 - ОбластьЯчеекТабличногоДокумента - Полная строка, котороя будет множиться
// НаименованиеЯчейкиОбласть1 - Строка - Наименование области Область1
// НаименованиеЯчейкиОбласть2 - Строка - Наименование области Область2
//
// Возвращает количество выведенных строк
Функция ВывестиДлиннуюСтроку(СтрокаВывода, ТабДокумент, Область1, Область2, НаименованиеЯчейкиОбласть1,
	НаименованиеЯчейкиОбласть2)
	
	МассивСтрок = СтрРазделить(СтрокаВывода, Символы.ПС, Ложь);
	МассивСлов = Новый Массив;
	Для каждого ТекСтрока Из МассивСтрок Цикл
		
		МассивСловТекущейСтроки =  СтрРазделить(ТекСтрока, " ", Ложь);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСлов, МассивСловТекущейСтроки);
		МассивСлов.Добавить(Символы.ПС);
	
	КонецЦикла;
	
	Если МассивСлов.Количество() > 0 Тогда
		МассивСлов.Удалить(МассивСлов.ВГраница());
	КонецЕсли;
	
	ЯчейкаОбласть1 = Область1.Область(НаименованиеЯчейкиОбласть1);
	ЯчейкаОбласть2 = Область2.Область(НаименованиеЯчейкиОбласть2);
	
	ЧислоСимволов1 = Цел(ЯчейкаОбласть1.ШиринаКолонки * (ЯчейкаОбласть1.Право - ЯчейкаОбласть1.Лево + 1));
	ЧислоСимволов2 = Цел(ЯчейкаОбласть2.ШиринаКолонки * (ЯчейкаОбласть2.Право - ЯчейкаОбласть2.Лево + 1));
	
	ТекИндекс = 0;
	Область1.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов1));
	ТабДокумент.Вывести(Область1);
	КолВыведенныхСтрок = 1;
	Пока ТекИндекс <= МассивСлов.Количество() - 1 Цикл
		Область2.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов2));
		ТабДокумент.Вывести(Область2);
		КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
	КонецЦикла;
	
	Возврат КолВыведенныхСтрок;
	
КонецФункции

// Формирует строку из массива слов, которая помещается в область шириной "ШиринаВСимволах".
// Выбор слов из массива начинается с индекса "ТекИндекс"
// 
// Параметры:
//  МассивСлов - Массив из Строка -  Массив слов
//  ТекИндекс - Число -  Тек индекс
//  ШиринаВСимволах - Число -  Ширина в символах
// 
// Возвращаемое значение:
//  Произвольный, Строка -  Собрать строку из массива для области
Функция СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ШиринаВСимволах) Экспорт
	ТекСтрока = "";
	ВсегоСимволов = 0;
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
		ТекСлово = МассивСлов[к];
		Если ТекСлово = Символы.ПС Тогда
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		КонецЕсли;	
		Если СтрДлина(ТекСлово) > ШиринаВСимволах И ВсегоСимволов = 0 Тогда
			ТекСтрока = ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		КонецЕсли;	
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		Если ВсегоСимволов < ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
		ИначеЕсли ВсегоСимволов = ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		Иначе
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТекСтрока;
КонецФункции	

Функция СформироватьОбластьКомиссия(ВыборкаШапка, ВыборкаКомиссия, МассивОбластейКомиссия, КоличествоСтрокКомиссии=3, СтрокаКомиссия = "", ВписыватьДолжности = Ложь) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	СоставСтрокиКомиссии = Новый Массив;
	ИндексОбластиКомиссия = 0;
	ШаблонСДолжностью = "%2 %1";
	ШаблонБезДолжности = "%1";
	
	пСтатусЧленаКомиссии	= "Председатель комиссии";
	пДолжностьЧленаКомиссии = ВыборкаШапка.ДолжностьПредседателяКомиссии;
	Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии) Тогда
		пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																	ВыборкаШапка.ФамилияПредседателяКомиссии,
																	ВыборкаШапка.ИмяПредседателяКомиссии,
																	ВыборкаШапка.ОтчествоПредседателяКомиссии), Истина);
		Если ВписыватьДолжности И НЕ ПустаяСтрока(ВыборкаШапка.ДолжностьПредседателяКомиссии) Тогда
			ИспользуемыйШаблон = ШаблонСДолжностью;
		Иначе
			ИспользуемыйШаблон = ШаблонБезДолжности;
		КонецЕсли;
		СоставСтрокиКомиссии.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИспользуемыйШаблон,
			пЧленКомиссии, ПредставлениеДолжностиДляПечати(ВыборкаШапка.ДолжностьПредседателяКомиссии)));	
	Иначе
		пЧленКомиссии			= "";
	КонецЕсли;
	СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии, пДолжностьЧленаКомиссии, пЧленКомиссии",
		пСтатусЧленаКомиссии, пДолжностьЧленаКомиссии, пЧленКомиссии);
	
	ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
	ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
	ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
	ТабличныйДокумент.Вывести(ОбластьКомиссия);
	
	пСтатусЧленаКомиссии = "Члены комиссии:";
	ВывелиСтрок = 1;    // председатель комиссии это была первая выведеная строка
	Если ТипЗнч(ВыборкаКомиссия)=Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Пока ВыборкаКомиссия.Следующий() Цикл
			ВывелиСтрок = ВывелиСтрок + 1;
			пДолжностьЧленаКомиссии = ВыборкаКомиссия.ДолжностьЧленаКомиссии;
			пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																			ВыборкаКомиссия.ФамилияЧленаКомиссии,
																			ВыборкаКомиссия.ИмяЧленаКомиссии,
																			ВыборкаКомиссия.ОтчествоЧленаКомиссии), Истина);
			СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии, пДолжностьЧленаКомиссии, пЧленКомиссии",
				пСтатусЧленаКомиссии, пДолжностьЧленаКомиссии, пЧленКомиссии);

			ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
			ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
			
			ТабличныйДокумент.Вывести(ОбластьКомиссия);
			
			пСтатусЧленаКомиссии = "";
			Если ВписыватьДолжности И НЕ ПустаяСтрока(ВыборкаКомиссия.ДолжностьЧленаКомиссии) Тогда
				ИспользуемыйШаблон = ШаблонСДолжностью;
			Иначе
				ИспользуемыйШаблон = ШаблонБезДолжности;
			КонецЕсли;
			СоставСтрокиКомиссии.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИспользуемыйШаблон,
				пЧленКомиссии, ПредставлениеДолжностиДляПечати(ВыборкаКомиссия.ДолжностьЧленаКомиссии)));	
		КонецЦикла;
	КонецЕсли;
		
	Для Счетчик = ВывелиСтрок По КоличествоСтрокКомиссии Цикл
		СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии, пДолжностьЧленаКомиссии, пЧленКомиссии",
			пСтатусЧленаКомиссии, "", "");

		ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
		ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
		ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		
		пСтатусЧленаКомиссии = "";
	КонецЦикла;
	
	СтрокаКомиссия = СтрСоединить(СоставСтрокиКомиссии, ", ");

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПредставлениеДолжностиДляПечати(Знач Должность)

	Должность = СокрЛП(Должность);
	Если СтрДлина(Должность) < 2 Тогда
		Возврат Должность;
	Иначе
		Возврат Нрег(Лев(Должность, 1)) + Сред(Должность, 2);
	КонецЕсли;

КонецФункции

#Область ПечатьАктаСписанияЛитературы0504144

Функция ТекстЗапросаШапкиДляПечатиАктаСписанияЛитературы0504144()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМЗ.Ссылка КАК Ссылка,
	|	АктСписанияМЗ.Организация.НаименованиеПолное КАК ОргНазв,
	|	АктСписанияМЗ.Организация.ИНН КАК ИНН,
	|	ЕСТЬNULL(АктСписанияМЗ.Организация.РегистрацияВНалоговомОргане.КПП, """") КАК КПП,
	|	АктСписанияМЗ.Организация.КодОКПО КАК КодОКПО,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(АктСписанияМЗ.ПодразделениеОтправитель.НаименованиеПолное, 1, 100) <> """"
	|			ТОГДА АктСписанияМЗ.ПодразделениеОтправитель.НаименованиеПолное
	|		ИНАЧЕ АктСписанияМЗ.ПодразделениеОтправитель.Наименование
	|	КОНЕЦ Как Подразделение,
	|	АктСписанияМЗ.ЦМООтправитель КАК ЦМООтправитель,
	|	АктСписанияМЗ.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	ЕСТЬNULL(АктСписанияМЗ.ЦМООтправитель.Сотрудник.Код, """") КАК УчетныйНомерОтправитель,
	|	ЕСТЬNULL(АктСписанияМЗ.ЦМООтправитель.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Сотрудник,
	|	АктСписанияМЗ.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	АктСписанияМЗ.Руководитель КАК УполномоченноеЛицо,
	|	АктСписанияМЗ.Дата КАК Дата,
	|	АктСписанияМЗ.Номер КАК Номер,
	|	АктСписанияМЗ.Организация КАК Организация,
	|	АктСписанияМЗ.КФО КАК КФО,
	|	АктСписанияМЗ.ИФО КАК ИФО,
	|	АктСписанияМЗ.ДолжностьПредседательКомиссии КАК ДолжностьПредседателяКомиссии,
	|	АктСписанияМЗ.ФамилияПредседательКомиссии КАК ФамилияПредседателяКомиссии,
	|	АктСписанияМЗ.ИмяПредседательКомиссии КАК ИмяПредседателяКомиссии,
	|	АктСписанияМЗ.ОтчествоПредседательКомиссии КАК ОтчествоПредседателяКомиссии,
	|	АктСписанияМЗ.Комиссия КАК Комиссия,
	|	ЕСТЬNULL(АктСписанияМЗ.Комиссия.ДатаПриказа, АктСписанияМЗ.НомерПриказа) КАК НомерПриказа,
	|	ЕСТЬNULL(АктСписанияМЗ.Комиссия.НомерПриказа, АктСписанияМЗ.ДатаПриказа) КАК ДатаПриказа
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
КонецФункции

Функция ТекстЗапросаТаблицыМатериалыДляПечатиАктаСписанияЛитературы0504144()
	Возврат
	"ВЫБРАТЬ
