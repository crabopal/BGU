// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив из Строка
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	
	// Реквизит "НеПересчитыватьСумму" устанавливается только при загрузке данных
	НеРедактируемыеРеквизиты.Добавить("НеПересчитыватьСумму");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Конец СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	ИменаСкрываемыхКнопок = Новый Массив;
	ИменаСкрываемыхКнопок.Добавить("МатериалыЗаполнитьКПСНоменклатура");
	Результат.Вставить("ИменаСкрываемыхКнопок", ИменаСкрываемыхКнопок);
	//@skip-check constructor-function-return-section
	Возврат Результат;
КонецФункции

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.АктСписанияМЗ -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМООтправитель,
	|	ДанныеИнвентаризации.Подразделение КАК ПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Счет В (&ВсеСчета105)
	|			ТОГДА &Счет10500
	|		КОГДА ДанныеИнвентаризации.Счет В (&ВсеСчета106)
	|			ТОГДА &Счет10600
	|		ИНАЧЕ ДанныеИнвентаризации.Счет
	|	КОНЕЦ КАК СчетУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДанныеИнвентаризации.ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Счет В (&ВсеСчета105)
	|			ТОГДА &Счет10500
	|		КОГДА ДанныеИнвентаризации.Счет В (&ВсеСчета106)
	|			ТОГДА &Счет10600
	|		ИНАЧЕ ДанныеИнвентаризации.Счет
	|	КОНЕЦ
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И (СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = УправлениеНФА.УдалитьПолеИзТекстЗапроса(Запрос.Текст, "ИФО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("ВсеСчета105", БухгалтерскийУчет.СписокСчетов("105.00"));
	Запрос.УстановитьПараметр("Счет10500", БухгалтерскийУчет.СчетПоКоду("105.00"));
	Запрос.УстановитьПараметр("ВсеСчета106", БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("Счет10600", БухгалтерскийУчет.СчетПоКоду("106.00"));
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	АктСписания.Ссылка КАК ДокументОтклонения,
	|	АктСписания.ДокументОснование КАК ДокументИнвентаризации,
	|	ТабМатериалы.Номенклатура КАК НФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача) КАК ВидОтклонения,
	|	АктСписания.ЦМООтправитель.МестоХранения КАК МестоИнвентаризации,
	|	ТабМатериалы.Количество КАК Количество
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ.Материалы КАК ТабМатериалы
	|		ПО АктСписания.Ссылка = ТабМатериалы.Ссылка
	|ГДЕ
	|	АктСписания.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ АктСписания.ПометкаУдаления
	|	И АктСписания.Ссылка <> &АктСписанияМЗСсылка";
КонецФункции

#Область Печать

// Добавить данные для печати акта списания литературы ф. 0504144.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаСписанияЛитературы0504144
//  МассивДокументов - Массив из ДокументСсылка.АктСписанияМЗ
Процедура ДобавитьДанныеДляПечатиАктаСписанияЛитературы0504144(ДанныеДляПечати, МассивДокументов) Экспорт
	
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивДокументов);

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаСписанияЛитературы0504144());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиАктаСписанияЛитературы0504144());
	ЧастиЗапроса.Добавить(ТекстЗапросаКомиссииДляПечатиАктаСписанияЛитературы0504144());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивДокументов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссииСтарые = РезультатЗапроса[2].Выбрать();
	
	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивДокументов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");

	Пока ВыборкаШапка.Следующий() Цикл
		НоваяСтрокаДокумента = ДанныеДляПечати.Добавить();
		НоваяСтрокаДокумента.СписокЛитературы = УправлениеПечатьюБГУ.ТаблицаСписокДляПечатиАктаСписанияЛитературы0504144();
		НоваяСтрокаДокумента.Комиссия = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаСписанияЛитературы0504144();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ВыборкаШапка, , "Комиссия");

		Если ЗначениеЗаполнено(ВыборкаШапка.УполномоченноеЛицо) Тогда
			Руководитель = ВыборкаШапка.УполномоченноеЛицо;
		Иначе
			Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация,
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаШапка.Дата).ОтветственноеЛицоСсылка;
		КонецЕсли;
		НоваяСтрокаДокумента.ОргДиректор = Справочники.Сотрудники.ФамилияИО(Руководитель, Истина, ВыборкаШапка.Дата);

		Если ЗначениеЗаполнено(ВыборкаШапка.Комиссия) Тогда
			// Председатель
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
			СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
			Если СтрокиПредседатель.Количество() > 0 Тогда
				НоваяСтрокаДокумента.ДолжностьПредседателяКомиссии = СтрокиПредседатель[0].НаименованиеДолжности;
				НоваяСтрокаДокумента.ИмяПредседателяКомиссии = СтрокиПредседатель[0].Имя;
				НоваяСтрокаДокумента.ОтчествоПредседателяКомиссии = СтрокиПредседатель[0].Отчество;
				НоваяСтрокаДокумента.ФамилияПредседателяКомиссии = СтрокиПредседатель[0].Фамилия;
			КонецЕсли;
		
			// Члены комиссии
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
			СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
				СтрокаКомиссия = НоваяСтрокаДокумента.Комиссия.Добавить();
				СтрокаКомиссия.ДолжностьЧленаКомиссии = ЧленКомиссии.НаименованиеДолжности;
				СтрокаКомиссия.ИмяЧленаКомиссии = ЧленКомиссии.Имя;
				СтрокаКомиссия.ОтчествоЧленаКомиссии = ЧленКомиссии.Отчество;
				СтрокаКомиссия.ФамилияЧленаКомиссии = ЧленКомиссии.Фамилия;
			КонецЦикла;
		Иначе
			// Члены комиссии
			ВыборкаКомиссииСтарые.Сбросить();
			Пока ВыборкаКомиссииСтарые.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
				СтрокаКомиссия = НоваяСтрокаДокумента.Комиссия.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, ВыборкаКомиссииСтарые);
			КонецЦикла;
		КонецЕсли;

		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
		
		ПричиныСписания = Новый	Массив;
		СпСчетовДт = Новый Массив;
		СпСчетовКт = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			НоваяСтрокаСостава = НоваяСтрокаДокумента.СписокЛитературы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			Если ЗначениеЗаполнено(СтрокиДокумента.ПричинаСписания) Тогда
				ПричиныСписания.Добавить(СтрокиДокумента.ПричинаСписания);
			ИначеЕсли ЗначениеЗаполнено(СтрокиДокумента.ПричинаСписанияНаименование) Тогда
				ПричиныСписания.Добавить(СтрокиДокумента.ПричинаСписанияНаименование);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокиДокумента.НомерНоменклатурный) Тогда
				НоваяСтрокаСостава.ИнвНомер = СтрокиДокумента.НомерНоменклатурный;
			Иначе
				НоваяСтрокаСостава.ИнвНомер = СтрокиДокумента.НоменклатураКод;
			КонецЕсли;
			ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.Сумма;
				НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
				СпСчетовДт.Добавить(УправлениеПечатьюБГУ.ПредставлениеСчета(СтрокиДвижений[0], "Дт"));
				СпСчетовКт.Добавить(УправлениеПечатьюБГУ.ПредставлениеСчета(СтрокиДвижений[0], "Кт"));
			Иначе
				Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
					НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ПричиныСписания = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПричиныСписания);
		ВременныйСписок = Новый СписокЗначений;
		ВременныйСписок.ЗагрузитьЗначения(ПричиныСписания);
		ВременныйСписок.СортироватьПоЗначению();
		ПричиныСписания = ВременныйСписок.ВыгрузитьЗначения();
		НоваяСтрокаДокумента.ПричинаСписания = СтрСоединить(ПричиныСписания, ", ");
		
		НоваяСтрокаДокумента.СуммаИтого = НоваяСтрокаДокумента.СписокЛитературы.Итог("Сумма");
		НоваяСтрокаДокумента.КоличествоИтого = НоваяСтрокаДокумента.СписокЛитературы.Итог("Количество");
		
		СпСчетовДт	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(СпСчетовДт);
		СпСчетовКт	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(СпСчетовКт);
		НоваяСтрокаДокумента.СчетДебета	 = СтрСоединить(СпСчетовДт, Символы.ПС);
		НоваяСтрокаДокумента.СчетКредита = СтрСоединить(СпСчетовКт, Символы.ПС);
		
	КонецЦикла;
	
	
КонецПроцедуры

// Добавить данные для печати акта о списании БСО ф.0510461.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОСписанииБСО0510461
//  МассивОбъектов - Массив из ДокументСсылка.АктСписанияМЗ
Процедура ДобавитьДанныеДляПечатиАктаОСписанииБСО0510461(ДанныеДляПечати, МассивОбъектов) Экспорт

	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОСписанииБСО0510461());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыБСОДляПечатиАктаОСписанииБСО0510461());
	ЧастиЗапроса.Добавить(УправлениеПечатьюБГУ.ТекстЗапросаФайлыДляПечатиПриказ61н());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать();
	ВыборкаФайлы = РезультатЗапроса[2].Выбрать();
	
	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");
	ОтборПоСсылке = Новый Структура("Ссылка", Неопределено);
	
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеДляПечати.Добавить();
		СтрокаШапки.СписываемыеБСО = УправлениеПечатьюБГУ.ТаблицаБСОДляПечатиАктаОСписанииБСО0510461();
		СтрокаШапки.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаОСписанииБСО0510461();
		СтрокаШапки.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиАктаОСписанииБСО0510461();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаШапка.УполномоченноеЛицо);
		СотрудникиДокумента.Добавить(ВыборкаШапка.Сотрудник);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия, Имя, Отчество, Должность, НаименованиеПолное", ВыборкаШапка.Дата);

		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.УполномоченноеЛицо);
		СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);

		ДанныеЦМО = ДанныеСотрудников.Получить(ВыборкаШапка.Сотрудник);
		Если ДанныеЦМО <> Неопределено Тогда
			СтрокаШапки.ЦМООтправитель = ДанныеЦМО.НаименованиеПолное;
		КонецЕсли;
		
		СтрокаШапки.МестонахождениеОбъектов = ВыборкаШапка.Местонахождение;
		АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			ВыборкаШапка.МестоХранения,
			Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			СтрокаШапки.МестонахождениеОбъектов = СтрШаблон(НСтр("ru = '%1, %2'"),
				СтрокаШапки.МестонахождениеОбъектов,
				АдресМестаХранения);
		КонецЕсли;
		
		ОтборПоСсылке.Ссылка = ВыборкаШапка.Ссылка;
		
		ТабличныеЧасти.Сбросить();
		Пока ТабличныеЧасти.НайтиСледующий(ОтборПоСсылке) Цикл
			СтрокаБСО = СтрокаШапки.СписываемыеБСО.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаБСО, ТабличныеЧасти);
			
			СтрокаБСО.Номера = УправлениеПечатьюБГУ.ПредставлениеНомеровБСОПоПриказу61н(ТабличныеЧасти.НомерНачальный,
				ТабличныеЧасти.НомерКонечный);
			ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, ТабличныеЧасти.КодСтроки);
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				СтрокаБСО.Сумма = СтрокаСебестоимости.Сумма;
				Если СтрокаБСО.Количество <> 0 Тогда
					СтрокаБСО.Цена = СтрокаБСО.Сумма / СтрокаБСО.Количество; 
				КонецЕсли;
			КонецЕсли;
			
			ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = ТабличныеЧасти.ИдентификаторСтроки;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаБСО, РезультатыГолосованияПоСтроке[0],
					"ИтогГолосования,РезолюцияКомиссииОдобрена,ГолосованиеПоСтрокеЗавершено");
			КонецЕсли;
			
		КонецЦикла;
	
		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(ОтборПоСсылке) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;

		ДанныеКомиссий = СтрокаШапки.СоставКомиссии;
		Если ЗначениеЗаполнено(ВыборкаШапка.Комиссия) Тогда
			// Председатель
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
			СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого Председатель Из СтрокиПредседатель Цикл
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, Председатель);
				СтрокаКомиссия.Председатель = Истина;
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(Председатель);
				СтрокаКомиссия.ИмяФайла = Председатель.ОсобыеОтметки;
			КонецЦикла;
		
			// Члены комиссии
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
			СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, ЧленКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
				СтрокаКомиссия.ИмяФайла = ЧленКомиссии.ОсобыеОтметки;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавить данные для печати акта списания НФА 0510454.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаСписанияОбъектовНФА0510454
//  МассивДокументов - Массив из ДокументСсылка.АктСписанияМЗ
Процедура ДобавитьДанныеДляПечатиАктаСписанияНФА0510454(ДанныеДляПечати, МассивДокументов) Экспорт
	
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивДокументов);
	Если СоставКомиссий.Количество() > 0 Тогда
		СоставКомиссий.Индексы.Добавить("Ссылка");
	КонецЕсли;

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаСписанияНФА0510454());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиАктаСписанияНФА0510454());
	ЧастиЗапроса.Добавить(ТекстЗапросаФайлыДляПечатиАктаСписанияНФА0510454());
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивДокументов);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	СтрокиДокумента = РезультатЗапроса[1].Выбрать();
	ВыборкаФайлы = РезультатЗапроса[2].Выбрать();
	
	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивДокументов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	ГруппыНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		СтрокаШапки = ДанныеДляПечати.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.СведенияОбОбъектах = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахДляПечатиАктаСписанияОбъектовНФА0510454();
		СтрокаШапки.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаСоставКомиссииДляПечатиАктаСписанияОбъектовНФА0510454();
		СтрокаШапки.Приложения = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиАктаСписанияОбъектовНФА0510454();
		
		СчетаУчета = Новый Соответствие;
		Отбор = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
		СтрокиДокумента.Сбросить();
		Пока СтрокиДокумента.НайтиСледующий(Отбор) Цикл
	
			НоваяСтрокаСостава = СтрокаШапки.СведенияОбОбъектах.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			СчетаУчета.Вставить(СтрокиДокумента.СчетУчета, Истина);

			ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				НоваяСтрокаСостава.БалансоваяСтоимость = СтрокаСебестоимости.Сумма;
			КонецЕсли;

		КонецЦикла;
		
		ИспользуемыеКоды = Новый Соответствие;
		ВидИмущества = Новый Массив;
		АналитическаяГруппа = Новый Массив;
		Для Каждого КлючИЗначение Из СчетаУчета Цикл
			ОписаниеГруппы = ГруппыНФА.Получить(КлючИЗначение.Ключ);
			Если ИспользуемыеКоды.Получить(ОписаниеГруппы.Код) = Неопределено Тогда
				ИспользуемыеКоды.Вставить(ОписаниеГруппы.Код, Истина);
				ВидИмущества.Добавить(ОписаниеГруппы.Наименование);
				Если СтрДлина(ОписаниеГруппы.Код) = 6 Тогда
					АналитическаяГруппа.Добавить(Прав(ОписаниеГруппы.Код, 2));
				Иначе
					АналитическаяГруппа.Добавить(ОписаниеГруппы.Код);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СтрокаШапки.ВидИмущества = СтрСоединить(ВидИмущества, ", ");
		СтрокаШапки.АналитическаяГруппа = СтрСоединить(АналитическаяГруппа, ", ");
		
		КомиссияДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого ЧленКомиссии Из КомиссияДокумента Цикл
			СтрокаКомиссии = СтрокаШапки.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссии, ЧленКомиссии);
		КонецЦикла;

		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.Приложения.Добавить(), ВыборкаФайлы);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ГолосованиеКомиссии

// Заполнить результат голосования.
// 
// Параметры:
//  Форма - см. Документ.АктСписанияМЗ.Форма.ФормаДокумента
Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЭтоАктОСписании0510460или0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктОСписанииМЗ0510460_157н")
		Или ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н")
		Или ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктСписания0510454");
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация)
		И ЭтоАктОСписании0510460или0510461;
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Управление элементами голосования.
// 
// Параметры:
//  Форма - см. Документ.АктСписанияМЗ.Форма.ФормаДокумента
Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоАктОСписании0510460или0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктОСписанииМЗ0510460_157н")
		Или ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н")
		Или ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктСписания0510454");
	Если ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии") Тогда
		ОбъектАннулирован = Объект.Аннулирован;
		ДоступностьГолосования = Не ОбъектАннулирован
			И (Объект.Резервировать Или Не Объект.Проведен);
	ИначеЕсли Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		ОбъектАннулирован = Ложь;
		ДоступностьГолосования = Ложь;
	Иначе
		ОбъектАннулирован = Ложь;
		ДоступностьГолосования = Не Объект.Проведен;
	КонецЕсли;
	
	ДоступностьГолосования = ДоступностьГолосования
		И Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация)
		И ЭтоАктОСписании0510460или0510461
		И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом;
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("МатериалыИтогГолосования");
	ЭлементыГолосование.Добавить("МатериалыРезолюцияКомиссииОдобрена");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование,
		"Видимость",
		ЭтоАктОСписании0510460или0510461 И Не ОбъектАннулирован И Не Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("МатериалыРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность",
		ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать106 - Булево - получать свойства счета 106
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Кт");
	Результат.Вставить("Включать106", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица бухгалтерских проводок, которые уже сформировал документ, и которые
//					могут использоваться для формирования таблицы движений в другие регистры
//  ДокументОбъект - ДокументОбъект - Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура - Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - ТаблицаЗначений - Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка - Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
// 
// Возвращаемое значение:
//  Булево - Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ОтразитьВКарточкеКапвложений = Ложь;
	Если НЕ ДополнительныеРеквизиты.Свойство("ОтразитьВКарточкеКапвложений", ОтразитьВКарточкеКапвложений) 
		ИЛИ НЕ ОтразитьВКарточкеКапвложений Тогда
		// Если движения в карточке капвложений отражать не нужно, то ничего не делаем	
		Возврат Истина;	
	ИначеЕсли НЕ ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(ДополнительныеРеквизиты.СчетВложений) Тогда
		Возврат Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДополнительныеРеквизиты.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Бухгалтерская операция"" включен флажок 
		|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;		
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДополнительныеРеквизиты.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;
	
	Возврат Истина;
КонецФункции	

// Текст запроса таблицы для расчета движений.
// 
// Возвращаемое значение:
//  Строка - Текст запроса таблицы для расчета движений
Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт
	
	Возврат УправлениеМатериальнымиЗапасами.ТекстЗапросаТаблицыДляРасчетаДвиженийАктыСписанияМЗ(
	"Документ.АктСписанияМЗ.Материалы");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьОстаткиМЗПоРешениюОПрекращенииПризнания(Объект) Экспорт
	ВызовИзФормы = (ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура"));
	Отказ = Ложь;
	ДанныеРешения = ДанныеПоРешениюОПрекращенииПризнания(Объект.ДокументОснование, Объект.Ссылка);
	ТаблицаОстатков = ДанныеРешения.ОстаткиМатериалов;
	КолонкиПоиска = "Номенклатура, СчетУчета, КФО, КПС, КЭК";
	ТаблицаОстатков.Индексы.Добавить(КолонкиПоиска);
	Отбор = Новый Структура(КолонкиПоиска);
	Для Каждого СтрокаДокумента Из Объект.Материалы Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		Если Не Объект.КФОВТабличнойЧасти Тогда
			Отбор.КФО = Объект.КФО;
		КонецЕсли;
		НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(Отбор);
		НеСписанноеКоличество = СтрокаДокумента.Количество;
		Для Каждого СтрокаОстатка Из НайденныеСтроки Цикл
			СписываемоеКоличество = Мин(СтрокаОстатка.Количество, НеСписанноеКоличество);
			СтрокаОстатка.Количество = СтрокаОстатка.Количество - СписываемоеКоличество;
			НеСписанноеКоличество = НеСписанноеКоличество - СписываемоеКоличество;
		КонецЦикла;
		Если НеСписанноеКоличество > 0 Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность", "Количество",
				СтрокаДокумента.НомерСтроки, НСтр("ru = 'Материалы'"),
				НСтр("ru = 'Не хватает остатка не списанных материалов. Возможно они списаны другим документом.'"));
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", СтрокаДокумента.НомерСтроки,
				"Количество");
			Если ВызовИзФормы Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект, ПутьКПолю, , Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Не Отказ;
КонецФункции

// Данные по решению о прекращении признания.
// 
// Параметры:
//  Решение - ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ
//  ТекущийДокумент - ДокументСсылка.АктСписанияМЗ
// 
// Возвращаемое значение:
//  Структура - Данные по решению о прекращении признания:
// * ДанныеШапки - Структура - :
// ** ДатаОснования - Дата - 
// ** Организация - СправочникСсылка.Организации - 
// ** ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// ** ЦМООтправитель - СправочникСсылка.ЦМО - 
// ** ПодразделениеОтправитель - СправочникСсылка.Подразделения - 
// ** Руководитель - СправочникСсылка.Сотрудники - 
// * ОстаткиМатериалов - ТаблицаЗначений: 
// ** НомерСтроки - Число
// ** Номенклатура - СправочникСсылка.Номенклатура
// ** Количество - Число - Остаток не списанных МЗ по Решению
// ** Сумма - Число - Остаток суммы не списанных МЗ по Решению
// ** СчетУчета - ПланСчетовСсылка.ЕПСБУ
// ** КФО - ПеречислениеСсылка.КВД
// ** КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
// ** КЭК - СправочникСсылка.КОСГУ
// ** ИдентификаторСтроки - Строка - Идентификатор строки в Решении
Функция ДанныеПоРешениюОПрекращенииПризнания(Решение, ТекущийДокумент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗ.Дата КАК ДатаОснования,
	|	РешениеОПрекращенииПризнанияАктивомМЗ.Организация,
	|	РешениеОПрекращенииПризнанияАктивомМЗ.ИФО,
	|	РешениеОПрекращенииПризнанияАктивомМЗ.ЦМО КАК ЦМООтправитель,
	|	РешениеОПрекращенииПризнанияАктивомМЗ.Подразделение КАК ПодразделениеОтправитель,
	|	РешениеОПрекращенииПризнанияАктивомМЗ.Руководитель
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомМЗ КАК РешениеОПрекращенииПризнанияАктивомМЗ
	|ГДЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ВложенныйЗапрос.НомерСтроки) КАК НомерСтроки,
	|	ВложенныйЗапрос.Номенклатура,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
	|	ВложенныйЗапрос.СчетУчета,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.КЭК,
	|	МАКСИМУМ(ВложенныйЗапрос.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ИЗ (
	|	ВЫБРАТЬ	
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.НомерСтроки КАК НомерСтроки,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.Номенклатура,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.Количество,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.СчетУчета,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.КФО,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.КПС,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.КЭК,
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.ИдентификаторСтроки
	|	ИЗ
	|		Документ.РешениеОПрекращенииПризнанияАктивомМЗ.Материалы КАК РешениеОПрекращенииПризнанияАктивомМЗМатериалы
	|	ГДЕ
	|		РешениеОПрекращенииПризнанияАктивомМЗМатериалы.Ссылка = &Ссылка
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		0,
	|		ТЧМатериалы.Номенклатура,
	|		- ТЧМатериалы.Количество,
	|		ТЧМатериалы.СчетУчета,
	|		ВЫБОР
	|			КОГДА АктСписанияМЗ.КФОВТабличнойЧасти
	|				ТОГДА ТЧМатериалы.КФО
	|			ИНАЧЕ АктСписанияМЗ.КФО
	|		КОНЕЦ,
	|		ТЧМатериалы.КПС,
	|		ТЧМатериалы.КЭК,
	|		""""
	|	ИЗ
	|		Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ.Материалы КАК ТЧМатериалы
	|		ПО АктСписанияМЗ.Ссылка = ТЧМатериалы.Ссылка
	|	ГДЕ
	|		АктСписанияМЗ.ДокументОснование = &Ссылка
	|		И АктСписанияМЗ.Проведен
	|		И АктСписанияМЗ.Ссылка <> &АктСписанияМЗ) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.СчетУчета,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.КЭК
	|	
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Количество) > 0	
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Решение);
	Запрос.УстановитьПараметр("АктСписанияМЗ", ТекущийДокумент);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ДанныеШапки = Новый Структура;	
	ДанныеШапки.Вставить("ДатаОснования", '00010101');
	ДанныеШапки.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ДанныеШапки.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ДанныеШапки.Вставить("ЦМООтправитель", Справочники.ЦМО.ПустаяСсылка());
	ДанныеШапки.Вставить("ПодразделениеОтправитель", Справочники.Подразделения.ПустаяСсылка());
	ДанныеШапки.Вставить("Руководитель", Справочники.Сотрудники.ПустаяСсылка());
	
	ШапкаОснования = РезультатЗапроса[0].Выбрать();
	Если ШапкаОснования.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеШапки, ШапкаОснования);
	КонецЕсли;
	
	ОстаткиМатериалов = РезультатЗапроса[1].Выгрузить(); // ТаблицаЗначений
	
	Возврат Новый Структура("ДанныеШапки, ОстаткиМатериалов", ДанныеШапки, ОстаткиМатериалов);
	
КонецФункции

// Заполнить по инвентаризации0510466.
// 
// Параметры:
//  ДокументыИнвентаризации - Массив из ДокументСсылка.ИнвентаризационнаяОписьНФА - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.АктСписанияМЗ, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510466(ДокументыИнвентаризации, ЗаполняемыйДокумент) Экспорт 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументыИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризации.НФА КАК НФА,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.КФО) КАК КоличествоКФО,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.КПС) КАК КоличествоКПС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.Счет) КАК КоличествоСчет
	|ПОМЕСТИТЬ СгруппированныеСтроки
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации В(&Документы466)
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И ДанныеИнвентаризации.ЦМОРаздела1 = &ЦМО
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И (НЕ &УчетПоПодразделениям
	|			ИЛИ НЕ ЕСТЬNULL(ДанныеИнвентаризации.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ИЛИ ДанныеИнвентаризации.Подразделение = &Подразделение)
	|	И ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|	И ДанныеИнвентаризации.Счет В(&ДопустимыеСчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки,
	|	ДанныеИнвентаризации.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСтрок = 1
	|				ИЛИ СгруппированныеСтроки.КоличествоКФО = 1
	|			ТОГДА ДанныеИнвентаризации.КФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|	КОНЕЦ КАК КФО,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСтрок = 1
	|				ИЛИ СгруппированныеСтроки.КоличествоКПС = 1
	|			ТОГДА ДанныеИнвентаризации.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК КПС,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСтрок = 1
	|				ИЛИ СгруппированныеСтроки.КоличествоСчет = 1
	|			ТОГДА ДанныеИнвентаризации.Счет
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Количество < ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено
	|			ТОГДА ДанныеИнвентаризации.Количество
	|		ИНАЧЕ ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СгруппированныеСтроки КАК СгруппированныеСтроки
	|		ПО ДанныеИнвентаризации.ДокументИнвентаризации = СгруппированныеСтроки.ДокументИнвентаризации
	|			И ДанныеИнвентаризации.НомерСтроки = СгруппированныеСтроки.НомерСтроки
	|			И ДанныеИнвентаризации.НФА = СгруппированныеСтроки.НФА
	|ГДЕ
	|	ДанныеИнвентаризации.Счет В(&ДопустимыеСчета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Документы466", ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("ЦМО", ЗаполняемыйДокумент.ЦМООтправитель);
	Запрос.УстановитьПараметр("ИФО", ЗаполняемыйДокумент.ИФО);
	Запрос.УстановитьПараметр("Подразделение", ЗаполняемыйДокумент.ПодразделениеОтправитель);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаполняемыйДокумент.СчетУчета, "Код");
	Если КодСчета = "105.00" Тогда
		Запрос.УстановитьПараметр("ДопустимыеСчета", БухгалтерскийУчет.СписокСчетов("105.00"));
	ИначеЕсли КодСчета = "106.00" Тогда
		Запрос.УстановитьПараметр("ДопустимыеСчета", БухгалтерскийУчет.СписокСчетов("106.00"));
	Иначе
		Запрос.УстановитьПараметр("ДопустимыеСчета", ЗаполняемыйДокумент.СчетУчета);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();

	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЗаполняемыйДокумент);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");

	Пока Выборка.Следующий() Цикл
		СтрокаМатериалы = ЗаполняемыйДокумент.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Выборка);
		СтрокаМатериалы.КоличествоНорма = СтрокаМатериалы.Количество;
		СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ПараметрыОбработки.Номенклатура = СтрокаМатериалы.Номенклатура;
		ПараметрыОбработки.Счет         = СтрокаМатериалы.СчетУчета;
		
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(СтрокаМатериалы, ПараметрыОбработки);
	КонецЦикла;

КонецПроцедуры

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", НСтр("ru = 'Акт списания материалов'"));
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка, ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

