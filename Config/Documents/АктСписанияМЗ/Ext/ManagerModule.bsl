	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	 "ВЫБРАТЬ
	 |	АктСписанияМЗДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	АктСписанияМЗДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	АктСписанияМЗДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	АктСписанияМЗДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	АктСписанияМЗДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	АктСписанияМЗДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
