	|	АктСписанияМЗ.Ссылка В(&МассивОбъектов)
	|	И АктСписанияМЗСоставКомиссии.Ссылка В(&МассивОбъектов)
	|	И АктСписанияМЗ.Комиссия = ЗНАЧЕНИЕ(Справочник.ПостоянноДействующиеКомиссии.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
КонецФункции

Функция ТекстЗапросаРешенияДляПечатиДвиженийАктаОСписанииМЗ0510460()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	АктСписанияМЗ.Ссылка КАК Ссылка,
	|	АктСписанияМЗ.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В (&МассивОбъектов)
	|	И АктСписанияМЗ.ДокументОснование ССЫЛКА Документ.РешениеОПрекращенииПризнанияАктивомМЗ";
КонецФункции

// Данные для печати акта о списании МЗ 0510460.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.АктСписанияМЗ
// 
// Возвращаемое значение:
//  Структура:
//   * ДанныеШапки - см. ТаблицаШапкиДляПечатиАктаОСписанииМЗ0510460
//   * ТабличнаяЧасть - Соответствие из Массив см. ЗаголовокТабличнойЧастиДляПечатиАктаОСписанииМЗ0510460
//   * Комиссия - см. ТаблицаКомиссияДляПечатиАктаОСписанииМЗ0510460
//   * Приложения - см. ТаблицаФайлыДляПечатиАктаОСписанииМЗ0510460
//   
Функция ДанныеДляПечатиАктаОСписанииМЗ0510460(МассивОбъектов)

	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаФайлыДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаКомиссииДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаРешенияДляПечатиДвиженийАктаОСписанииМЗ0510460());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаФайлы = РезультатЗапроса[2].Выбрать();
	ВыборкаКомиссииСтарые = РезультатЗапроса[3].Выбрать();
	РешенияДляЧтенияДвижений = РезультатЗапроса[4].Выгрузить();
	
	СоответствиеДокументов = Новый ТаблицаЗначений;
	СоответствиеДокументов.Колонки.Добавить("Регистратор", Документы.ТипВсеСсылки());
	СоответствиеДокументов.Колонки.Добавить("Документ", Документы.ТипВсеСсылки());
	ОбъектыДляЧтенияДвижений = ОбщегоНазначения.СкопироватьРекурсивно(МассивОбъектов);
	Для Каждого ДокументРешение Из РешенияДляЧтенияДвижений Цикл
		СтрокаСоответствия = СоответствиеДокументов.Добавить();
		СтрокаСоответствия.Регистратор = ДокументРешение.ДокументОснование;
		СтрокаСоответствия.Документ = ДокументРешение.Ссылка;
		ОбъектыДляЧтенияДвижений.Добавить(ДокументРешение.ДокументОснование);
	КонецЦикла;
	
	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(ОбъектыДляЧтенияДвижений,
		СоответствиеДокументов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");

	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");
	
	Результат = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОСписанииМЗ0510460();
	Пока ВыборкаШапка.Следующий() Цикл
		
		СтрокаШапки = Результат.Добавить();
		СтрокаШапки.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаОСписанииМЗ0510460();
		СтрокаШапки.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиАктаОСписанииМЗ0510460();
		
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаШапка.УполномоченноеЛицо);
		СотрудникиДокумента.Добавить(ВыборкаШапка.ОтветственныйИсполнитель);
		Если ЗначениеЗаполнено(ВыборкаШапка.Сотрудник) Тогда
			СотрудникиДокумента.Добавить(ВыборкаШапка.Сотрудник);
		КонецЕсли;
		
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия, Имя, Отчество, Должность, Подразделение, НаименованиеПолное",
			ВыборкаШапка.Дата,
			Истина);
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.УполномоченноеЛицо);
		СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);

		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.ОтветственныйИсполнитель);
		СтрокаШапки.ОтветственныйДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеСотрудника.ТелефонРабочийФизическиеЛица;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеСотрудника.EmailФизическиеЛица;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеСотрудника.Подразделение;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.Сотрудник) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.Сотрудник);
			СтрокаШапки.ЦМООтправитель = ДанныеСотрудника.НаименованиеПолное;
		КонецЕсли;
		
		АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			ВыборкаШапка.МестоХранения,
			Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			СтрокаШапки.МестонахождениеОбъектов = СтрШаблон(НСтр("ru = '%1, %2'"),
				СтрокаШапки.МестонахождениеОбъектов,
				АдресМестаХранения);
		КонецЕсли;
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("КодГруппы", Новый ОписаниеТипов("Строка"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			КодГрупповогоСчета = Строка(СтрокиДокумента.КФО);
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				КодГрупповогоСчета = КодГрупповогоСчета + "." + ТекущаяГруппаНФА.Код;
			КонецЕсли;
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(КодГрупповогоСчета);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = УправлениеПечатьюБГУ.ЗаголовокТабличнойЧастиДляПечатиАктаОСписанииМЗ0510460();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.КодГруппы = КодГрупповогоСчета;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					ЗаголовокТабличнойЧасти.КодГруппыНФА = КодГрупповогоСчета;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = Строка(СтрокиДокумента.КФО) + ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(КодГрупповогоСчета, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаСостава.НомерНоменклатурный) Тогда
				НоваяСтрокаСостава.НомерНоменклатурный = СтрокиДокумента.НоменклатураКод;
			КонецЕсли;
			ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.Сумма;
				НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
			Иначе
				Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
					НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
				КонецЕсли;
			КонецЕсли;
			Если СтрокиДокумента.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БСО Тогда
				Если ЗначениеЗаполнено(СтрокиДокумента.СерияБСО) Тогда
					НоваяСтрокаСостава.НомерНоменклатурный = СтрокиДокумента.СерияБСО;
				КонецЕсли;
				НоваяСтрокаСостава.НомерИной = УправлениеПечатьюБГУ.ПредставлениеНомеровБСОПоПриказу61н(
					СтрокиДокумента.НачальныйНомерБСО,
					СтрокиДокумента.КонечныйНомерБСО);
			КонецЕсли;
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = СтрокиДокумента.ИдентификаторСтроки;
			ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, РезультатыГолосованияПоСтроке[0],
					"ИтогГолосования,РезолюцияКомиссииОдобрена,ГолосованиеПоСтрокеЗавершено");
			КонецЕсли;
			
		КонецЦикла;
		
		ДанныеТабличныхЧастейДокумента = СтрокаШапки.ГруппыНФА;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.КодГруппы);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.Комиссия) Тогда
			// Председатель
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
			СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого Председатель Из СтрокиПредседатель Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, Председатель);
				СтрокаКомиссия.Председатель = Истина;
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(Председатель);
				СтрокаКомиссия.ИмяФайла = Председатель.ОсобыеОтметки;
			КонецЦикла;
		
			// Члены комиссии
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
			СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, ЧленКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
				СтрокаКомиссия.ИмяФайла = ЧленКомиссии.ОсобыеОтметки;
			КонецЦикла;
		Иначе
			// Председатель
			Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседательКомиссии) Тогда
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				СтрокаКомиссия.Председатель = Истина;
				ФИОПредседателя = Новый Структура;
				ФИОПредседателя.Вставить("Фамилия", ВыборкаШапка.ФамилияПредседательКомиссии);
				ФИОПредседателя.Вставить("Имя", ВыборкаШапка.ИмяПредседательКомиссии);
				ФИОПредседателя.Вставить("Отчество", ВыборкаШапка.ОтчествоПредседательКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОПредседателя);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаШапка.ДолжностьПредседательКомиссии;
			КонецЕсли;
			// Члены комиссии
			ВыборкаКомиссииСтарые.Сбросить();
			Пока ВыборкаКомиссииСтарые.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ФИОЧленаКомиссии = Новый Структура;
				ФИОЧленаКомиссии.Вставить("Фамилия", ВыборкаКомиссииСтарые.ФамилияЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Имя", ВыборкаКомиссииСтарые.ИмяЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Отчество", ВыборкаКомиссииСтарые.ОтчествоЧленаКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОЧленаКомиссии);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаКомиссииСтарые.ДолжностьЧленаКомиссии;
			КонецЦикла;
		КонецЕсли;

		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

Функция ДанныеДляПечати0510434(МассивОбъектов)
	
	ПодразделенияСписанияМЗ = УправлениеПечатьюБГУ.ПодразделенияСотрудниковМЗ0510434(МассивОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПодразделенияСписанияМЗ", ПодразделенияСписанияМЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодразделенияСписанияМЗ.Документ КАК Документ,
	|	ВЫРАЗИТЬ(ПодразделенияСписанияМЗ.Подразделение КАК Справочник.Подразделения) КАК Подразделение,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ПодразделенияСписанияМЗ
	|ИЗ
	|	&ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МатериальныеЗапасы.Ссылка КАК Ссылка,
	|	МатериальныеЗапасы.НомерСтроки КАК НомерСтроки,
	|	МатериальныеЗапасы.Номенклатура КАК Номенклатура,
	|	МатериальныеЗапасы.Количество КАК Количество,
	|	МатериальныеЗапасы.ВидимыеДефекты КАК Дефекты,
	|	МатериальныеЗапасы.ОсобыеОтметки КАК ОсобыеОтметки,
	|	АктСписанияМЗ.ПолучательИмущества КАК СотрудникОбеспечения
	|ПОМЕСТИТЬ ВТ_Материалы
	|ИЗ
	|	Документ.АктСписанияМЗ.Материалы КАК МатериальныеЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|		ПО МатериальныеЗапасы.Ссылка = АктСписанияМЗ.Ссылка
	|ГДЕ
	|	МатериальныеЗапасы.Ссылка В (&МассивОбъектов)
	|	И АктСписанияМЗ.Ссылка В (&МассивОбъектов)
	|ИНДЕКСИРОВАТЬ ПО
	|	СотрудникОбеспечения,
	|	Номенклатура
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОбеспечениеСотрудниковИмуществом.Владелец КАК Сотрудник,
	|	ТЧОбеспечениеИмуществом.Имущество,
	|	ТЧОбеспечениеИмуществом.Приспособления КАК Приспособления,
	|	ТЧОбеспечениеИмуществом.РазмерОдежды КАК РазмерОдежды,
	|	ТЧОбеспечениеИмуществом.РазмерГоловногоУбора КАК РазмерГоловногоУбора,
	|	ТЧОбеспечениеИмуществом.РазмерОбуви КАК РазмерОбуви,
	|	ТЧОбеспечениеИмуществом.РазмерИное КАК РазмерИное,
	|	ТЧОбеспечениеИмуществом.НормаВыдачи КАК НормаВыдачи,
	|	ТЧОбеспечениеИмуществом.СрокИспользованияПоНормативу КАК СрокИспользованияПоНормативу,
	|	ТЧОбеспечениеИмуществом.ЕдиницаИзмеренияСрока КАК ЕдиницаИзмеренияСрока,
	|	ТЧОбеспечениеИмуществом.КодУсловияВозвратаИмущества КАК КодУсловияВозвратаИмущества
	|ПОМЕСТИТЬ Вт_ОбеспечениеИмуществом
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом КАК ОбеспечениеСотрудниковИмуществом
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК ТЧОбеспечениеИмуществом
	|	ПО ОбеспечениеСотрудниковИмуществом.Ссылка = ТЧОбеспечениеИмуществом.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|	ПО ОбеспечениеСотрудниковИмуществом.Владелец = АктСписанияМЗ.ПолучательИмущества
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В (&МассивОбъектов)
	|ИНДЕКСИРОВАТЬ ПО
	|	Сотрудник,
	|	Имущество
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМЗ.Ссылка КАК Ссылка,
	|	АктСписанияМЗ.Номер КАК Номер,
	|	АктСписанияМЗ.Дата КАК ДатаАкта,
	|	АктСписанияМЗ.Организация КАК Организация,
	|	1 КАК Операция,
	|	АктСписанияМЗ.ЦМООтправитель.Сотрудник КАК СотрудникОтправитель,
	|	АктСписанияМЗ.ЦМООтправитель.Сотрудник.Код КАК ТабельныйНомерОтправитель,
	|	АктСписанияМЗ.ЦМООтправитель.МестоХранения.Наименование КАК МестонахождениеОтправитель,
	|	АктСписанияМЗ.ПолучательИмущества КАК СотрудникПолучатель,
	|	ЕСТЬNULL(АктСписанияМЗ.ПолучательИмущества.Код, """") КАК ТабельныйНомерПолучатель,
	|	АктСписанияМЗ.ПодразделениеОтправитель КАК СтруктурноеПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗ.ПодразделениеОтправитель.НаименованиеПолное = """"
	|			ТОГДА АктСписанияМЗ.ПодразделениеОтправитель.Наименование
	|		ИНАЧЕ АктСписанияМЗ.ПодразделениеОтправитель.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияОтправитель,
	|	ПодразделенияСписанияМЗ.Подразделение КАК СтруктурноеПодразделениеПолучатель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПодразделенияСписанияМЗ.Подразделение.НаименованиеПолное, """") = """"
	|			ТОГДА ПодразделенияСписанияМЗ.Подразделение.Наименование
	|		ИНАЧЕ ПодразделенияСписанияМЗ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияПолучатель,
	|	АктСписанияМЗ.ПолучательИмущества КАК СотрудникОбеспечения,
	|	АктСписанияМЗ.ВидОснованияСписания КАК НаименованиеПриказа,
	|	АктСписанияМЗ.НомерОснованияСписания КАК НомерПриказа,
	|	АктСписанияМЗ.ДатаОснованияСписания КАК ДатаПриказа
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|		ПО АктСписанияМЗ.Ссылка = ПодразделенияСписанияМЗ.Документ
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В (&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МатериальныеЗапасы.Ссылка КАК Ссылка,
	|	МатериальныеЗапасы.НомерСтроки КАК НомерСтроки,
	|	МатериальныеЗапасы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА МатериальныеЗапасы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА МатериальныеЗапасы.Номенклатура.Наименование
	|		ИНАЧЕ МатериальныеЗапасы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМЗ,
	|	ВЫБОР
	|		КОГДА МатериальныеЗапасы.Номенклатура.НоменклатурныйНомер = """"
	|			ТОГДА МатериальныеЗапасы.Номенклатура.Код
	|		ИНАЧЕ МатериальныеЗапасы.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК НоменклатурныйНомер,
	|	МатериальныеЗапасы.Номенклатура.ЕдиницаИзмерения.Наименование КАК НаименованиеЕИ,
	|	МатериальныеЗапасы.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕИ,
	|	0 КАК Сумма,
	|	МатериальныеЗапасы.Количество КАК Количество,
	|	МатериальныеЗапасы.Дефекты КАК Дефекты,
	|	МатериальныеЗапасы.ОсобыеОтметки КАК ОсобыеОтметки,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.Приспособления, """") КАК Приспособления,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерОдежды, 0) КАК РазмерОдежды,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерГоловногоУбора, 0) КАК РазмерГоловногоУбора,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерОбуви, 0) КАК РазмерОбуви,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерИное, 0) КАК РазмерИное,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.НормаВыдачи, 0) КАК НормаВыдачи,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.СрокИспользованияПоНормативу, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.ЕдиницаИзмеренияСрока, 0) КАК ЕдиницаИзмеренияСрока,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.КодУсловияВозвратаИмущества, """") КАК КодВозврата
	|ИЗ
	|	ВТ_Материалы КАК МатериальныеЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОбеспечениеИмуществом КАК ОбеспечениеИмуществом
	|		ПО (МатериальныеЗапасы.СотрудникОбеспечения = ОбеспечениеИмуществом.Сотрудник)
	|		И МатериальныеЗапасы.Номенклатура = ОбеспечениеИмуществом.Имущество
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов"	, РезультатЗапроса[3]);
	ДанныеДляПечати.Вставить("ВыборкаМЗДок"			, РезультатЗапроса[4]);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция Напечатать0510434(МассивОбъектов, ОбъектыПечати)
	
	ДанныеДляПечати		= ДанныеДляПечати0510434(МассивОбъектов);
	ВыборкаДокументов	= ДанныеДляПечати.ВыборкаДокументов.Выбрать();
	ВыборкаМЗДок		= ДанныеДляПечати.ВыборкаМЗДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
	Пока ВыборкаДокументов.Следующий() Цикл
		
		// Шапка
		СтрокаДокумента = ДанныеДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникОтправитель);
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникПолучатель);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия,Имя,Отчество,Должность,ДолжностьНаименование,НаименованиеПолное",
			ВыборкаДокументов.ДатаАкта);
		ДанныеСотрудникаОтправителя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникОтправитель);	
		СтрокаДокумента.ФИООтправитель = ДанныеСотрудникаОтправителя.НаименованиеПолное;
		
		ДанныеСотрудникаПолучателя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникПолучатель);	
		СтрокаДокумента.ФИОПолучатель = ДанныеСотрудникаПолучателя.НаименованиеПолное;
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокаДокумента.МатериальныеЗапасы = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахМЗДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
		
		// Материальные запасы
		
		ВыборкаМЗДок.Сбросить();
		Если ВыборкаМЗДок.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаМЗ = ВыборкаМЗДок.Выбрать();
			Пока ВыборкаМЗ.НайтиСледующий(СтруктураПоиска) Цикл
				СтрокаМЗ = СтрокаДокумента.МатериальныеЗапасы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаМЗ, ВыборкаМЗ);
				ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаДокументов.Ссылка, ВыборкаМЗ.НомерСтроки);
				СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					СтрокаМЗ.Сумма = СтрокаСебестоимости.Сумма;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		СтрокаДокумента.ОбъектыСдалНаименованиеДолжности = ДанныеСотрудникаОтправителя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалСотрудник = ВыборкаДокументов.СотрудникОтправитель;
		СтрокаДокумента.ОбъектыСдалФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаОтправителя, Истина);
		
		СтрокаДокумента.ОбъектыПринялНаименованиеДолжности = ДанныеСотрудникаПолучателя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялСотрудник = ВыборкаДокументов.СотрудникПолучатель;
		СтрокаДокумента.ОбъектыПринялФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаПолучателя, Истина);
		
	КонецЦикла;
	
	Возврат УправлениеПечатьюБГУ.Напечатать0510434(МассивОбъектов, ОбъектыПечати, ДанныеДокументов);
	
КонецФункции

#Область ПечатьАктаОСписанииБСО0510461

Функция ТекстЗапросаШапкиДляПечатиАктаОСписанииБСО0510461()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМЗ.Ссылка,
	|	АктСписанияМЗ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	АктСписанияМЗ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	АктСписанияМЗ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	АктСписанияМЗ.Руководитель КАК УполномоченноеЛицо,
	|	ЕСТЬNULL(АктСписанияМЗ.ЦМООтправитель.Сотрудник.Код, """") КАК УчетныйНомерОтправитель,
