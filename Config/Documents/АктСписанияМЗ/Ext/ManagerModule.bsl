// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Проверяем, нужно ли для макета формировать табличный документ.
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписанииБСО0510461_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьАктОСписанииБСО0510461(МассивОбъектов,
			ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
			НСтр("ru = 'Акт списания БСО'"), "0510461", "61н", "157н");
	КонецЕсли;

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктСписания0510454");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510454(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
			НСтр("ru = 'Акт о списании объектов НФА'"), "0510454", "61н", "157н");
	КонецЕсли;
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписанииМЗ0510460_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьАктОСписанииМЗ0510460(МассивОбъектов,
			ОбъектыПечати,
			ДанныеДляПечатиАктаОСписанииМЗ0510460(МассивОбъектов));
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
			НСтр("ru = 'Акт о списании МЗ'"), "0510460", "61н", "157н");
	КонецЕсли;
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "ф0504144_52н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьАктСписанияЛитературы0504144(МассивОбъектов,
			ОбъектыПечати, "ПФ_MXL_АктСписанияЛитературы_0504144_52н");
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Акт о списании исключенных объектов библиотечного фонда'");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504230") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504230",
			"Списание материалов",
			ПечатьАкта230(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМЗ0504230"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504230_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504230_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании МЗ'"), "0504230", "52н"),
			ПечатьАкта230(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМЗ0504230_52н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504230_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияМЗ0504230_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании МЗ'"), "0504230", "52н", "103н"),
			ПечатьАкта230(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМЗ0504230_103н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акт0510434") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Акт0510434",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт приема-передачи в личное пользование'"), "0510434", "61н"),
			Напечатать0510434(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

