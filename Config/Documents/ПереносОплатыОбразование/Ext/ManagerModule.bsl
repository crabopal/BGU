Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,Номер");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Запрос.УстановитьПараметр("ВидПервичногоДокумента",   НСтр("ru = 'Перенос оплаты (образование)'"));
	Запрос.УстановитьПараметр("НомерПервичногоДокумента", ЗначенияРеквизитов.Номер);
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента",  ЗначенияРеквизитов.Дата);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("РасчетыСоСтудентами", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Ссылка КАК Регистратор,
	|	Расчеты.НомерСтроки КАК НомерСтроки,
	|	Расчеты.Ссылка.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	Расчеты.Ссылка.Организация КАК Организация,
	|	Расчеты.ФакультетРасчетов КАК Факультет,
	|	Расчеты.СтудентРасчетов КАК Студент,
	|	Расчеты.КонтрагентРасчетов КАК Контрагент,
	|	Расчеты.ДоговорРасчетов КАК ДоговорКонтрагента,
	|	Расчеты.Валюта КАК ВалютаВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА Расчеты.Валюта = &ВалютаРегламентированногоУчета
	|			ТОГДА Расчеты.Сумма
	|		ИНАЧЕ Расчеты.СуммаВал
	|	КОНЕЦ КАК СуммаВзаиморасчетов,
	|	Расчеты.Сумма КАК СуммаРегл,
	|	&ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	Расчеты.ДокументОплаты КАК ДокументОплаты
	|ИЗ
	|	Документ.ПереносОплатыОбразование.Расчеты КАК Расчеты
	|ГДЕ
	|	Расчеты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Ссылка,
	|	Расчеты.НомерСтроки,
	|	Расчеты.Ссылка.Дата,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	Расчеты.Ссылка.Организация,
	|	Расчеты.Факультет,
	|	Расчеты.Студент,
	|	Расчеты.Контрагент,
	|	Расчеты.Договор,
	|	Расчеты.Валюта,
	|	ВЫБОР
	|		КОГДА Расчеты.Валюта = &ВалютаРегламентированногоУчета
	|			ТОГДА -1 * Расчеты.Сумма
	|		ИНАЧЕ -1 * Расчеты.СуммаВал
	|	КОНЕЦ,
	|	-1 * Расчеты.Сумма,
	|	&ВидПервичногоДокумента,
	|	&НомерПервичногоДокумента,
	|	&ДатаПервичногоДокумента,
	|	Расчеты.ДокументОплаты
	|ИЗ
	|	Документ.ПереносОплатыОбразование.Расчеты КАК Расчеты
	|ГДЕ
	|	Расчеты.Ссылка = &Ссылка
	|	И (Расчеты.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуДоговорамиСтудента)
	|			ИЛИ Расчеты.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуСтудентами))
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Функция ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	РасшифровкаПлатежа = УчетРасчетов.ПустаяТаблицаРасшифровкаПлатежаУнифицированная();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Расчеты"" КАК ИмяСписка,
	|	""Расчеты"" КАК СинонимСписка,
	|	Расчеты.НомерСтроки КАК НомерСтроки,
	|	ИСТИНА КАК ЭтоПоступление,
	|	Расчеты.Ссылка.ИФО КАК ИФО,
	|	Расчеты.ФакультетРасчетов КАК Подразделение,
	|	Расчеты.КФО КАК КФО,
	|	Расчеты.КПС КАК КПС,
	|	Расчеты.КонтрагентРасчетов КАК Контрагент,
	|	Расчеты.ДоговорРасчетов КАК Договор,
	|	Расчеты.ДоговорРасчетов.ВидДоговора КАК ВидДоговора,
	|	Расчеты.ДоговорРасчетов.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
	|	Расчеты.Валюта КАК Валюта,
	|	Расчеты.СчетРасчетов КАК СчетРасчетов,
	|	Расчеты.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
	|	Расчеты.ВидРасчетов КАК ВидРасчетов,
	|	Расчеты.ОплатитьДо КАК ОплатитьДо,
	|	Расчеты.ДопКлассификация КАК ДопКлассификация,
	|	Расчеты.КодМероприятия КАК КодМероприятия,
	|	Расчеты.КодЦели КАК КодЦели,
	|	ВЫБОР
	|		КОГДА Расчеты.Валюта = &ВалютаРегламентированногоУчета
	|			ТОГДА Расчеты.Сумма
	|		ИНАЧЕ Расчеты.СуммаВал
	|	КОНЕЦ КАК СуммаРасчетов,
	|	Расчеты.Сумма КАК СуммаРуб
	|ИЗ
	|	Документ.ПереносОплатыОбразование.Расчеты КАК Расчеты
	|ГДЕ
	|	Расчеты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Расчеты"",
	|	""Расчеты"",
	|	Расчеты.НомерСтроки,
	|	ИСТИНА,
	|	Расчеты.Ссылка.ИФО,
	|	Расчеты.Факультет,
	|	Расчеты.КФО,
	|	Расчеты.КПС,
	|	Расчеты.Контрагент,
	|	Расчеты.Договор,
	|	Расчеты.Договор.ВидДоговора,
	|	Расчеты.Договор.ВестиГрафикПлатежей,
	|	Расчеты.Валюта,
	|	Расчеты.СчетРасчетов,
	|	Расчеты.ДопСубконтоРасчетов,
	|	Расчеты.ВидРасчетов,
	|	Расчеты.ОплатитьДо,
	|	Расчеты.ДопКлассификация,
	|	Расчеты.КодМероприятия,
	|	Расчеты.КодЦели,
	|	ВЫБОР
	|		КОГДА Расчеты.Валюта = &ВалютаРегламентированногоУчета
	|			ТОГДА -1 * Расчеты.Сумма
	|		ИНАЧЕ -1 * Расчеты.СуммаВал
	|	КОНЕЦ,
	|	-1 * Расчеты.Сумма
	|ИЗ
	|	Документ.ПереносОплатыОбразование.Расчеты КАК Расчеты
	|ГДЕ
	|	Расчеты.Ссылка = &Ссылка
	|	И (Расчеты.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуДоговорамиСтудента)
	|			ИЛИ Расчеты.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуСтудентами))
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТаблицаРасчеты = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДокумента Из ТаблицаРасчеты Цикл
		
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаДокумента.СчетРасчетов);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет расчетов'"),
				СтрокаДокумента.НомерСтроки, "Расчеты");
			ПолеКолонки = "Объект." + СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетРасчетов";
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РасшифровкаПлатежа;
	
КонецФункции

