Функция ЗаполнитьПоПоступлениямОплаты(ДокументОбъект) Экспорт
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Контрагент",    ДокументОбъект.Контрагент);
	Запрос.УстановитьПараметр("Договор",       ДокументОбъект.Договор);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДокументОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДокументОбъект.КонецПериода));
	
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.00,209.00,210.05"));
	Запрос.УстановитьПараметр("СчетаДенежныхСредств", БухгалтерскийУчет.СписокСчетов("201.00,210.02"));
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	НомераТаблиц = Новый Структура;
	
	ДокументОбъект.Расчеты.Очистить();
	
	НомераТаблиц.Вставить("ПоступлениеОплаты", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.КПС КАК КПС,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	ЕПСБУОбороты.Субконто1 КАК Субконто1,
	|	ЕПСБУОбороты.Субконто2 КАК Субконто2,
	|	ЕПСБУОбороты.Субконто3 КАК Субконто3,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ ЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Контрагенты
	|				И НЕ ЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Договоры
	|			ТОГДА ЕПСБУОбороты.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопСубконто,
	|	ВЫБОР
	|		КОГДА ЕПСБУОбороты.Валюта ЕСТЬ NULL
	|				ИЛИ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ЕПСБУОбороты.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ЕПСБУОбороты.Подразделение КАК Подразделение,
	|	ЕПСБУОбороты.КорСчет КАК КорСчет,
	|	ЕПСБУОбороты.Регистратор КАК ДокументОплаты,
	|	ЕПСБУОбороты.СуммаОборотКт КАК ОплаченоСумма,
	|	ЕПСБУОбороты.ВалютнаяСуммаОборотКт КАК ОплаченоСуммаВал
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор,
	|			КорСчет В (&СчетаДенежныхСредств),
	|			) КАК ЕПСБУОбороты";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "Субконто1 = &Контрагент");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "Субконто2 = &Договор");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаПоступлениеОплаты = Результат[НомераТаблиц.ПоступлениеОплаты].Выгрузить();
	Для Каждого ПоступлениеОплаты Из ТаблицаПоступлениеОплаты Цикл
		
		НоваяСтрока = ДокументОбъект.Расчеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоступлениеОплаты);
		
		Если НЕ ЗначениеЗаполнено(ПоступлениеОплаты.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		НоваяСтрока.Сумма    = НоваяСтрока.ОплаченоСумма;
		НоваяСтрока.СуммаВал = НоваяСтрока.ОплаченоСуммаВал;
		
		// Значения по умолчанию.
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.31", ДокументОбъект.Дата, ДокументОбъект.Организация);
		НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

Функция ЗаполнитьПоОстаткамРасчетов(ДокументОбъект) Экспорт
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НаДату",        КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Контрагент",    ДокументОбъект.Контрагент);
	Запрос.УстановитьПараметр("Договор",       ДокументОбъект.Договор);
	
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.00,209.00,210.05"));
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	НомераТаблиц = Новый Структура;
	
	ДокументОбъект.Расчеты.Очистить();
	
	НомераТаблиц.Вставить("ОстаткиРасчетов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Контрагенты
	|				И НЕ ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопСубконто,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL
	|				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРеглУчета
	|		ИНАЧЕ ЕПСБУОстатки.Валюта
	|	КОНЕЦ КАК Валюта,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокСумма,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ОстатокСуммаВал
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&НаДату,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор) КАК ЕПСБУОстатки";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "Субконто1 = &Контрагент");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "Субконто2 = &Договор");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаОстаткиРасчетов = Результат[НомераТаблиц.ОстаткиРасчетов].Выгрузить();
	СведенияОДоговорахСтудентов = РаботаСоСтудентами.СведенияОДоговорахСтудентов(ТаблицаОстаткиРасчетов.ВыгрузитьКолонку("Договор"));
	
	Для Каждого ОстаткиРасчетов Из ТаблицаОстаткиРасчетов Цикл
		
		ОтборПоДоговору = Новый Структура("Договор", ОстаткиРасчетов.Договор);
		СведенияОДоговоре = СведенияОДоговорахСтудентов.НайтиСтроки(ОтборПоДоговору);
		
		ЭтоДоговорСтудента = (СведенияОДоговоре.Количество() > 0);
		Если Не ЭтоДоговорСтудента Тогда
			Продолжить; // Нет данных о договоре в регистрах расчетов со студентами.
		КонецЕсли;
		Если СведенияОДоговоре[0].ЭтоДоговорСтудентаЗаПрочиеУслуги Тогда
			Продолжить; // Документ не предназначен для переноса оплаты между договорами за прочие услуги.
		КонецЕсли; 
		
		НоваяСтрока = ДокументОбъект.Расчеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиРасчетов);
		
		Если НЕ ЗначениеЗаполнено(ОстаткиРасчетов.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		НоваяСтрока.Сумма    = НоваяСтрока.ОстатокСумма;
		НоваяСтрока.СуммаВал = НоваяСтрока.ОстатокСуммаВал;
		
		// Значения по умолчанию.
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.31", ДокументОбъект.Дата, ДокументОбъект.Организация);
		НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		
		Если СведенияОДоговоре.Количество() = 1 Тогда // Единственный вариант.
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СведенияОДоговоре[0], "Студент,Факультет");
		КонецЕсли;
		
		Если ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуДоговорамиСтудента Тогда
			НоваяСтрока.КонтрагентРасчетов = НоваяСтрока.Контрагент;
			НоваяСтрока.СтудентРасчетов = НоваяСтрока.Студент;
			
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуСтудентами Тогда
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение новых реквизитов ФакультетРасчетов и СтудентРасчетов значениями Факультет и Студент
	// в существующих документах с видами операций ПереносОплатыМеждуДоговорамиСтудента и ПереносОплатыПрочихКредиторов.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПереносОплатыОбразованиеРасчеты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПереносОплатыОбразование.Расчеты КАК ПереносОплатыОбразованиеРасчеты
	|ГДЕ
	|	ПереносОплатыОбразованиеРасчеты.Ссылка.ВидОперации В(&ВидыОпераций)
	|	И ПереносОплатыОбразованиеРасчеты.СтудентРасчетов = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	|	И ПереносОплатыОбразованиеРасчеты.ФакультетРасчетов = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	ВидыОпераций = Новый Массив; // Виды операций документа до версии 2.0.102.
	ВидыОпераций.Добавить(Перечисления.ВидыОперацийПереносОплатыОбразование.ПереносОплатыМеждуДоговорамиСтудента);
	ВидыОпераций.Добавить(Перечисления.ВидыОперацийПереносОплатыОбразование.ПереносОплатыПрочихКредиторов);
	Запрос.УстановитьПараметр("ВидыОпераций", ВидыОпераций);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ПереносОплатыОбразование";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		// Заполнение новых реквизитов ФакультетРасчетов и СтудентРасчетов значениями Факультет и Студент
		// в существующих документах с видами операций ПереносОплатыМеждуДоговорамиСтудента и ПереносОплатыПрочихКредиторов.
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрокаТаблицы Из Объект.Расчеты Цикл
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтудентРасчетов) Тогда
				СтрокаТаблицы.СтудентРасчетов = СтрокаТаблицы.Студент;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.ФакультетРасчетов) Тогда
				СтрокаТаблицы.ФакультетРасчетов = СтрокаТаблицы.Факультет;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
