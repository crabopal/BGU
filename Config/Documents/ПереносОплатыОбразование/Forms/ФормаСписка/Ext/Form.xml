	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>~Список.Ref</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ПереносОплатыОбразование.Ссылка КАК Ссылка,
	ПереносОплатыОбразование.ПометкаУдаления КАК ПометкаУдаления,
	ПереносОплатыОбразование.Номер КАК Номер,
	ПереносОплатыОбразование.Дата КАК Дата,
	ПереносОплатыОбразование.Проведен КАК Проведен,
	ПереносОплатыОбразование.Организация КАК Организация,
	ПереносОплатыОбразование.ИФО КАК ИФО,
	ПереносОплатыОбразование.ВидОперации КАК ВидОперации,
	ПереносОплатыОбразование.Контрагент КАК Контрагент,
	ПереносОплатыОбразование.Договор КАК Договор,
	ПереносОплатыОбразование.СуммаДокумента КАК СуммаДокумента,
	ПереносОплатыОбразование.Комментарий КАК Комментарий,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.Операция ЕСТЬ NULL
				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.Операция ЕСТЬ NULL
				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
					ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
				КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
					ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
			КОНЕЦ
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.Операция ЕСТЬ NULL
				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.Операция ЕСТЬ NULL
				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
			ТОГДА 1
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
					ТОГДА 4
				КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
					ТОГДА 3
				ИНАЧЕ 2
			КОНЕЦ
	КОНЕЦ КАК СостояниеОперацииКод,
	ПереносОплатыОбразование.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО
ИЗ
	Документ.ПереносОплатыОбразование КАК ПереносОплатыОбразование
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ПереносОплатыОбразование.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ПереносОплатыОбразование.Ссылка = ОперацииДокументов.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
		ПО ПереносОплатыОбразование.Ссылка = ЖурналПроводокЕПСБУ.Регистратор
			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ПереносОплатыОбразование.Ссылка = НаличиеФайлов.ОбъектСФайлами}</QueryText>
				<MainTable>Document.ПереносОплатыОбразование</MainTable>
