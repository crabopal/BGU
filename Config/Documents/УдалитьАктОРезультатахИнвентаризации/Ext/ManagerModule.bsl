#Область СлужебныеПроцедурыИФункции

Функция ПечатьФормы0504835(МассивСсылок, ОбъектыПечати, ТипМакета = Неопределено)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ИмяПараметровПечати = "ПечатьФормы0504835";
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Если ТипМакета = "194н" Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УдалитьАктОРезультатахИнвентаризации.ПФ_MXL_Ф0504835_194н");
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УдалитьАктОРезультатахИнвентаризации.ПФ_MXL_Ф0504835");
	КонецЕсли;
	
	СимволПрочерка = "-";
	
	// Настраиваем запрос:
	ЗапросыПечать = Новый Запрос();
	ЗапросыПечать.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	ЗапросыПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапка документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка							КАК ДокСсылка,
	|	Док.Номер							КАК Номер,
	|	Док.Дата 							КАК Дата,
	|	Док.Организация						КАК Организация,
	|	Док.Организация.НаименованиеПолное	КАК НаименованиеОрганизации,
	|	Док.Организация.КодОКПО				КАК КодОКПО,
	|	Док.МОЛ								КАК МОЛ,
	|	Док.МОЛ.Контрагент.НаименованиеРП	КАК МОЛНаименованиеРП,
	|	
	|	Док.ВидАктива						КАК ВидАктива,
	|	Док.ВедомостьРасхождений			КАК ВедомостьРасхождений,
	|	Док.ВедомостьРасхождений.Номер		КАК ВедомостьРасхожденийНомер,
	|	Док.ВедомостьРасхождений.Дата		КАК ВедомостьРасхожденийДата,
	|	Док.ВыводыКомиссии					КАК ВыводыКомиссии,
	|	Док.ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии		КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии			КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
	|	Док.ДатаНачала						КАК ДатаНачала,
	|	Док.ДатаОкончания					КАК ДатаОкончания,
	|	Док.ДатаПриказаИнвентаризации		КАК ДатаПриказаИнвентаризации,
	|	Док.НомерПриказаИнвентаризации		КАК НомерПриказаИнвентаризации,
	|	Док.ДатаПриказаКомиссии				КАК ДатаПриказаКомиссии,
	|	Док.НомерПриказаКомиссии			КАК НомерПриказаКомиссии
	|	
	|ИЗ
	|	Документ.УдалитьАктОРезультатахИнвентаризации	КАК Док
	|
	|ГДЕ
	|	Док.Ссылка В (&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица инвентаризационной комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии		КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии			КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.УдалитьАктОРезультатахИнвентаризации.СоставКомиссии	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица используемых описей
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка		КАК ДокСсылка,
	|	ТЧ.Опись.Номер	КАК Номер,
	|	ТЧ.Опись.Дата	КАК Дата,
	|	ТЧ.Опись		КАК Опись
	|ИЗ
	|	Документ.УдалитьАктОРезультатахИнвентаризации.ИнвентаризационныеОписи	КАК ТЧ
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	| 	ДокСсылка
	|;";
	
	РезультатПечать = ЗапросыПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= РезультатПечать[0].Выбрать();
	ВыборкаДокКомиссия	= РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокОписи		= РезультатПечать[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета:
		ОбластьЗаголовок			= Макет.ПолучитьОбласть("Заголовок");
		ОбластьПредседательКомиссии	= Макет.ПолучитьОбласть("ПредседательКомиссии");
		ОбластьЧленыКомиссии		= Макет.ПолучитьОбласть("ЧленыКомиссии");
		ОбластьЗаголовок2			= Макет.ПолучитьОбласть("Заголовок2");
		ОбластьИнвОписи1			= Макет.ПолучитьОбласть("ИнвОписи1");
		ОбластьИнвОписи2			= Макет.ПолучитьОбласть("ИнвОписи2");
		ОбластьВедомостьРасхождений	= Макет.ПолучитьОбласть("ВедомостьРасхождений");
		ОбластьКомиссия				= Макет.ПолучитьОбласть("Комиссия");
		ОбластьПолеДаты				= Макет.ПолучитьОбласть("ПолеДаты");
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокОписи.Сбросить();
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокОписи		= ВыборкаДокОписи.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокКомиссия	= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		
		//---
		// Заголовок
		//---
		НомерСтраницы  = 1;
	
		//---
		// Сведения о МОЛ
		//---
		МОЛ				= ВыборкаШапка.МОЛ;
		МОЛФИО			= СимволПрочерка;
		МОЛФИОПолное	= СимволПрочерка;
		Параметр_МОЛДолжность		= "";
		Параметр_МОЛНаименованиеРП	= СимволПрочерка;
		Если ЗначениеЗаполнено(МОЛ) Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность, НаименованиеПолное",
				МОЛ,
				ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			Параметр_МОЛДолжность = ТребуемыеДанные.Должность;
			МОЛФИО			= Корреспонденты.ФИОПоОбъекту(МОЛ, Истина);
			МОЛФИОПолное	= ТребуемыеДанные.НаименованиеПолное;
			
			Параметр_МОЛНаименованиеРП	= ВыборкаШапка.МОЛНаименованиеРП;
			
			Если НЕ ЗначениеЗаполнено(Параметр_МОЛНаименованиеРП) Тогда
				Параметр_МОЛНаименованиеРП = ?(ЗначениеЗаполнено(МОЛФИОПолное),
					МОЛФИОПолное,
					МОЛФИО);
			КонецЕсли;
		КонецЕсли;
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("ДатаПрописью, ФИОДиректор, ФИОМОЛ",
			Формат(ВыборкаШапка.Дата, "ДЛФ=DD"),
			БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителя(ВыборкаШапка.Организация, ВыборкаШапка.Дата),
			МОЛФИО);
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(
			ОбластьЗаголовок,
			"Номер",
			ВыборкаШапка.Номер,
			ВыборкаШапка.ДокСсылка,
			Неопределено,
			Истина);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		//---
		// Председатель, члены комиссии (в составе):
		//---
		// Председатель (в составе):
		ЗначенияПараметров = Новый Структура("Должность, ФИО",
			ВыборкаШапка.ДолжностьПредседателяКомиссии,
			ВыборкаШапка.ФамилияПредседателяКомиссии + " " + Лев(ВыборкаШапка.ИмяПредседателяКомиссии, 1) + ". " + Лев(ВыборкаШапка.ОтчествоПредседателяКомиссии, 1) + ".");
		ОбластьПредседательКомиссии.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьПредседательКомиссии);
		// Члены комиссии (в составе):
		КолВыведенныхСтрок = 0;
		ВыборкаКомиссия = ВыборкаДокКомиссия.Выбрать();
		Пока ВыборкаКомиссия.Следующий() Цикл
			ЗначенияПараметров = Новый Структура("Должность, ФИО",
				ВыборкаКомиссия.ДолжностьЧленаКомиссии,
				ВыборкаКомиссия.ФамилияЧленаКомиссии + " " + Лев(ВыборкаКомиссия.ИмяЧленаКомиссии, 1) + ". " + Лев(ВыборкаКомиссия.ОтчествоЧленаКомиссии, 1) + ".");
			ОбластьЧленыКомиссии.Параметры.Заполнить(ЗначенияПараметров);
			ТабДокумент.Вывести(ОбластьЧленыКомиссии);
			
			КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
		КонецЦикла;
		ЗначенияПараметров = Новый Структура("Должность, ФИО", "", "");
		ОбластьЧленыКомиссии.Параметры.Заполнить(ЗначенияПараметров);
		Для к = (КолВыведенныхСтрок + 1) по 3 Цикл
			ТабДокумент.Вывести(ОбластьЧленыКомиссии);
		КонецЦикла;
		// Восстанавливаем выборку комиссии:
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокКомиссия = ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		//---
		// ФИО, должность МОЛ
		//---
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("ФИОМОЛ, ДолжностьМОЛ",
			Параметр_МОЛНаименованиеРП,
			Параметр_МОЛДолжность);
		ОбластьЗаголовок2.Параметры.Заполнить(ВыборкаШапка);
		ОбластьЗаголовок2.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьЗаголовок2);
		
		//---
		// Инвентаризационные описи
		//---
		// Первая строка:
		ЗначенияПараметров = Новый Структура();
		ВыборкаОписи = ВыборкаДокОписи.Выбрать();
		Если ВыборкаОписи.Следующий() Тогда
			ЗначенияПараметров = Новый Структура("НомВед1, ДатаВед1",
				РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
					ВыборкаОписи.Опись, ВыборкаОписи.Номер),
				ВыборкаОписи.Дата);
		КонецЕсли;
		ОбластьИнвОписи1.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьИнвОписи1);
		// Вторая и последующие строки:
		НомВед2 = "";	ДатаВед2 = "";
		НомВед3 = "";	ДатаВед3 = "";
		КолВыведенныхСтрок = 0;
		Выводим = Ложь;
		Пока ВыборкаОписи.Следующий() Цикл
			Если Выводим Тогда
				НомВед3		= РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
								ВыборкаОписи.Опись, ВыборкаОписи.Номер);
				ДатаВед3	= ВыборкаОписи.Дата;
				
				ЗначенияПараметров = Новый Структура("НомВед2, ДатаВед2, НомВед3, ДатаВед3",
					НомВед2,	ДатаВед2,
					НомВед3,	ДатаВед3);
				ОбластьИнвОписи2.Параметры.Заполнить(ЗначенияПараметров);
				ТабДокумент.Вывести(ОбластьИнвОписи2);
				
				НомВед2 = "";   ДатаВед2 = "";
				НомВед3 = "";   ДатаВед3 = "";
				КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
				Выводим = Ложь;
			Иначе
				НомВед2		= РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
								ВыборкаОписи.Опись, ВыборкаОписи.Номер);
				ДатаВед2	= ВыборкаОписи.Дата;
				
				Выводим = Истина;
			КонецЕсли;
		КонецЦикла;
		// Обработка случая, когда строка - последняя, и заполнена частично:
		Если Выводим Тогда
			ЗначенияПараметров = Новый Структура("НомВед2, ДатаВед2, НомВед3, ДатаВед3",
				НомВед2,	ДатаВед2,
				НомВед3,	ДатаВед3);
			ОбластьИнвОписи2.Параметры.Заполнить(ЗначенияПараметров);
			ТабДокумент.Вывести(ОбластьИнвОписи2);
			
			НомВед2 = "";   ДатаВед2 = "";
			НомВед3 = "";   ДатаВед3 = "";
			КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
			Выводим = Ложь;
		КонецЕсли;
		// Общее кол-во строк с описями должно быть не менее 3 (1 первая строка и 2 последующих):
		Для к = (КолВыведенныхСтрок + 1) по 2 Цикл
			ЗначенияПараметров = Новый Структура("НомВед2, ДатаВед2, НомВед3, ДатаВед3",
				НомВед2,	ДатаВед2,
				НомВед3,	ДатаВед3);
			ОбластьИнвОписи2.Параметры.Заполнить(ЗначенияПараметров);
			ТабДокумент.Вывести(ОбластьИнвОписи2);
			
			НомВед2 = "";   ДатаВед2 = "";
			НомВед3 = "";   ДатаВед3 = "";
		КонецЦикла;
		
		//---
		// Выводы комиссии
		//---
		ВывестиВыводыКомиссии(
			ВыборкаШапка.ВыводыКомиссии,
			ТабДокумент,
			Макет);
		
		//---
		// Ведомость расхождений
		//---
		ЗначенияПараметров = Новый Структура("ВедомостьНомер, ВедомостьДата",
			РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
				ВыборкаШапка.ВедомостьРасхождений, ВыборкаШапка.ВедомостьРасхожденийНомер),
			ВыборкаШапка.ВедомостьРасхожденийДата);
		ОбластьВедомостьРасхождений.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьВедомостьРасхождений);
		
		//---
		// Инвентаризационная комиссия
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		// Дата внизу страницы:
		ОбластьПолеДаты.Параметры.Заполнить(ВыборкаШапка);
		ТабДокумент.Вывести(ОбластьПолеДаты);
		
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиВыводыКомиссии(Текст, ТабДокумент, Макет)
	
	БлокиСтрок = Неопределено;
	
	// Блок 1
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, 70, "ВыводыКомиссии1");
	
	// Блок 2
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , 100, "ВыводыКомиссии2");
	
	МинимальноеКоличествоСтрок = 5;
	
	ИмяПараметраОбласти = "ВыводыКомиссии";
	
	ОбластьВыводыКомиссии = ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок, ИмяПараметраОбласти);
	
	ТабДокумент.Вывести(ОбластьВыводыКомиссии);
	
КонецПроцедуры

Функция ПолучитьПредставлениеПозиции(ДокументОбъект, СтрокаТаблицыРасхождения)
	
	ПредставлениеПозиции = "";
	
	Если ЗначениеЗаполнено(СтрокаТаблицыРасхождения["ОбъектУчета"]) Тогда
		СимволРазделительВнутриПозиции	= " ";
		
		ПредставлениеПозиции = СокрЛП(СтрокаТаблицыРасхождения["ОбъектУчета"])
			+ ?(ДокументОбъект["ВыводитьНомерОбъектаУчета"],
				СимволРазделительВнутриПозиции + СокрЛП(СтрокаТаблицыРасхождения["НомерОбъектаУчета"]),
				"")
			+ ?(ДокументОбъект["ВыводитьКоличество"] И ЗначениеЗаполнено(СтрокаТаблицыРасхождения["Количество"]) И ЗначениеЗаполнено(СтрокаТаблицыРасхождения["ЕдИзм"]),
				СимволРазделительВнутриПозиции + Формат(СтрокаТаблицыРасхождения["Количество"], "ЧГ=0") + Символы.НПП + СтрокаТаблицыРасхождения["ЕдИзм"],
				"")
			+ ?(ДокументОбъект["ВыводитьСумму"] И ЗначениеЗаполнено(СтрокаТаблицыРасхождения["Сумма"]),
				СимволРазделительВнутриПозиции + Формат(СтрокаТаблицыРасхождения["Сумма"], "ЧГ=0") + Символы.НПП + НСтр("ru='руб.'"),
				"");
	КонецЕсли;
	
	Возврат ПредставлениеПозиции;
	
КонецФункции

Функция СформироватьВыводыКомиссии(ДокументОбъект)
	
	Если ДокументОбъект["Недостачи"].Количество() = 0 И ДокументОбъект["Излишки"].Количество() = 0 Тогда
		Возврат НСтр("ru='Недостачи и излишки не выявлены'");
	КонецЕсли;
	
	ВыводыКомиссии = "";
	
	ЗаголовокНедостачи			= НСтр("ru='Выявлено отсутствие следующих материальных ценностей: '");
	ЗаголовокИзлишки			= НСтр("ru='Выявлено наличие следующих неучтенных материальных ценностей: '");
	СимволРазделительПозиций	= "; ";
	
	// Перечисляем недостачи
	Описание = "";
	ПозицияПервая = Истина;
	Для Каждого СтрокаТЧ Из ДокументОбъект["Недостачи"] Цикл
		ПредставлениеПозиции = ПолучитьПредставлениеПозиции(ДокументОбъект, СтрокаТЧ);
		Если ЗначениеЗаполнено(ПредставлениеПозиции) Тогда
			Описание = Описание + ?(ПозицияПервая, "", СимволРазделительПозиций) + ПредставлениеПозиции;
			
			ПозицияПервая = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Описание) Тогда
		ВыводыКомиссии = ВыводыКомиссии + ЗаголовокНедостачи + Описание;
	КонецЕсли;
	
	// Перечисляем излишки
	Описание = "";
	ПозицияПервая = Истина;
	Для Каждого СтрокаТЧ Из ДокументОбъект["Излишки"] Цикл
		ПредставлениеПозиции = ПолучитьПредставлениеПозиции(ДокументОбъект, СтрокаТЧ);
		Если ЗначениеЗаполнено(ПредставлениеПозиции) Тогда
			Описание = Описание + ?(ПозицияПервая, "", СимволРазделительПозиций) + ПредставлениеПозиции;
			
			ПозицияПервая = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Описание) Тогда
		ВыводыКомиссии = ВыводыКомиссии + ?(ЗначениеЗаполнено(ВыводыКомиссии), "
			|
			|",
			"") + ЗаголовокИзлишки + Описание;
	КонецЕсли;
	
	Возврат ВыводыКомиссии;
	
КонецФункции

Функция ПолучитьИнвентаризационныеОписиБезМОЛ(Параметры)
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Опись,
	|	Дата	КАК Дата
	|ИЗ
	|	Документ.[ИмяДокумента]
	|ГДЕ
	|	Проведен
	|	И	ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И	ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И	Организация = &Организация
	|";
	
	Разделитель = "ОБЪЕДИНИТЬ ВСЕ";
	
	ТипыОписей = ПоддерживаемыеТипыОписей();
	
	МассивСтрок = Новый Массив();
	
	Для Каждого ИмяДокумента Из ТипыОписей.БезМОЛ Цикл
		Если НЕ ПравоДоступа("Чтение", Метаданные.Документы[ИмяДокумента]) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрЗаменить(ТекстШаблон, "[ИмяДокумента]", ИмяДокумента));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений();
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",	Параметры.Организация);
	ЗапросПоиск.УстановитьПараметр("ДатаНачала",	Параметры.ДатаНачалаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаОкончания",	Параметры.ДатаОкончанияИнвентаризации);
	ЗапросПоиск.Текст = СтрСоединить(МассивСтрок, Разделитель);
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	Таблица.Сортировать("Дата Возр");
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьИнвентаризационныеОписиПоМОЛ(Параметры)
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Опись,
	|	Дата	КАК Дата
	|ИЗ
	|	Документ.[ИмяДокумента]
	|ГДЕ
	|	Проведен
	|	И ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Организация = &Организация
	|	И [РеквизитМОЛ] В(&МОЛ)
	|";
	
	Разделитель = "ОБЪЕДИНИТЬ ВСЕ";
	
	ТипыОписей = ПоддерживаемыеТипыОписей();
	
	МассивСтрок = Новый Массив();
	
	Для Каждого ИмяДокумента Из ТипыОписей.СМОЛ Цикл
		Если НЕ ПравоДоступа("Чтение", Метаданные.Документы[ИмяДокумента]) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяДокумента = "ИнвентаризацияКассы" Тогда
			РеквизитМОЛ = "МОЛ";
		Иначе
			РеквизитМОЛ = "ЦМО";
		КонецЕсли;
		
		Текст = СтрЗаменить(ТекстШаблон, "[ИмяДокумента]", ИмяДокумента);
		Текст = СтрЗаменить(Текст, "[РеквизитМОЛ]", РеквизитМОЛ);
		
		МассивСтрок.Добавить(Текст);
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений();
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",	Параметры.Организация);
	ЗапросПоиск.УстановитьПараметр("ДатаНачала",	Параметры.ДатаНачалаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаОкончания",	Параметры.ДатаОкончанияИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("МОЛ",			ИнвентаризацияСервер.ПолучитьСписокОтбораПоМОЛ(Параметры));
	ЗапросПоиск.Текст = СтрСоединить(МассивСтрок, Разделитель);
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	Таблица.Сортировать("Дата Возр");
	
	Возврат Таблица;
	
КонецФункции

#КонецОбласти

#КонецЕсли
