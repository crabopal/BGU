// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0504835
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504835";
	КомандаПечати.Представление = НСтр("ru='Акт о результатах инвентаризации (ф. 0504835)'");
	КомандаПечати.Порядок = 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504835_194н";
	КомандаПечати.Представление = НСтр("ru='Акт о результатах инвентаризации (ф. 0504835) (в ред. 194н)'");
	КомандаПечати.Порядок = 2;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504835") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504835",
			"Акт о результатах инвентаризации (ф.0504835)",
			ПечатьФормы0504835(МассивОбъектов, ОбъектыПечати));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504835_194н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504835_194н",
			"Акт о результатах инвентаризации (ф.0504835)",
			ПечатьФормы0504835(МассивОбъектов, ОбъектыПечати, "194н"));
	КонецЕсли;
	
КонецПроцедуры // Печать()

Процедура ЗаполнитьНаОснованииВедомостиРасхождений(ЗаполняемыйДокумент, ВедомостьРасхожденийСсылка) Экспорт
	
	ШапкаВедомости = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВедомостьРасхожденийСсылка, "Организация, МОЛ, ДатаНачалаИнвентаризации, ДатаОкончанияИнвентаризации");
	
	МОЛ = ШапкаВедомости["МОЛ"];
	
	Если ТипЗнч(МОЛ) = Тип("СправочникСсылка.ЦМО") Тогда
		МОЛ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МОЛ, "Сотрудник");
	КонецЕсли;
	
	// Шапка
	ЗаполняемыйДокумент["ВедомостьРасхождений"]	= ВедомостьРасхожденийСсылка;
	ЗаполняемыйДокумент["Организация"]			= ШапкаВедомости["Организация"];
	ЗаполняемыйДокумент["МОЛ"]					= МОЛ;
	ЗаполняемыйДокумент["ДатаНачала"]			= ШапкаВедомости["ДатаНачалаИнвентаризации"];
	ЗаполняемыйДокумент["ДатаОкончания"]		= ШапкаВедомости["ДатаОкончанияИнвентаризации"];
	
	// Табличная часть "Инвентаризационные описи"
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьИнвентаризационныеОписиПоВедомости(ЗаполняемыйДокумент);
	
	// Табличные части "Недостачи" и "Излишки"
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьРасхожденияПоВедомости(ЗаполняемыйДокумент);
	
	// Текст выводов комиссии
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьВыводыКомиссии(ЗаполняемыйДокумент);
	
КонецПроцедуры

Процедура ЗаполнитьИнвентаризационныеОписиПоВедомости(ДокументОбъект) Экспорт
	
	ЗапросОписи = Новый Запрос();
	ЗапросОписи.УстановитьПараметр("ДокСсылка", ДокументОбъект["ВедомостьРасхождений"]);
	ЗапросОписи.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТЧ.Опись	КАК Опись
	|ИЗ
	|	Документ.ВедомостьИнвентаризации.ИнвентаризационныеОписи	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокСсылка
	|;";
	
	ДокументОбъект["ИнвентаризационныеОписи"].Загрузить(ЗапросОписи.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьИнвентаризационныеОписиПоМОЛ(ДокументОбъект) Экспорт
	
	Параметры = Новый Структура();
	Параметры.Вставить("Организация",					ДокументОбъект["Организация"]);
	Параметры.Вставить("МОЛ",							ДокументОбъект["МОЛ"]);
	Параметры.Вставить("ДатаНачалаИнвентаризации",		ДокументОбъект["ДатаНачала"]);
	Параметры.Вставить("ДатаОкончанияИнвентаризации",	ДокументОбъект["ДатаОкончания"]);
	
	Если ЗначениеЗаполнено(Параметры.МОЛ) Тогда
		ТаблицаИнвентаризационныеОписи = ПолучитьИнвентаризационныеОписиПоМОЛ(Параметры);
	Иначе
		ТаблицаИнвентаризационныеОписи = ПолучитьИнвентаризационныеОписиБезМОЛ(Параметры);
	КонецЕсли;
	
	ДокументОбъект["ИнвентаризационныеОписи"].Загрузить(ТаблицаИнвентаризационныеОписи);
	
КонецПроцедуры

Процедура ЗаполнитьРасхожденияПоВедомости(ДокументОбъект) Экспорт
	
	СписокМОЛ = ИнвентаризацияСервер.ПолучитьВсеЦМОСотрудникаДляОтбора(ДокументОбъект["МОЛ"]);
	
	ЗапросРасхождения = Новый Запрос();
	ЗапросРасхождения.УстановитьПараметр("ВедомостьИнвентаризации",		ДокументОбъект["ВедомостьРасхождений"]);
	ЗапросРасхождения.УстановитьПараметр("СписокМОЛ",					СписокМОЛ);
	ЗапросРасхождения.УстановитьПараметр("ВариантФормированияОписи194н", 1);
	ЗапросРасхождения.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Недостачи
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектУчета													КАК ОбъектУчета,
	|	НомерОбъектаУчета											КАК НомерОбъектаУчета,
	|	ЕдИзм														КАК ЕдИзм,
	|	СУММА(ЕстественнаяУбыльКоличество + СверхНормКоличество)	КАК Количество,
	|	СУММА(ЕстественнаяУбыльСумма + СверхНормСумма)				КАК Сумма
	|ИЗ
	|	Документ.ВедомостьИнвентаризации.ВедомостьРасхождений	КАК ТЧ
	|ГДЕ
	|	Ссылка = &ВедомостьИнвентаризации
	|	И ВЫБОР
	|		КОГДА Ссылка.ВариантФормированияОписи = &ВариантФормированияОписи194н ТОГДА
	|			// Колонка МОЛ в табличной части не используется
	|			ИСТИНА
	|		ИНАЧЕ
	|			(МОЛ В(&СписокМОЛ))
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ОбъектУчета,
	|	НомерОбъектаУчета,
	|	ЕдИзм
	|ИМЕЮЩИЕ
	|	СУММА(ЕстественнаяУбыльКоличество + СверхНормКоличество) > 0
	|	ИЛИ СУММА(ЕстественнаяУбыльСумма + СверхНормСумма) > 0
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Излишки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектУчета					КАК ОбъектУчета,
	|	НомерОбъектаУчета			КАК НомерОбъектаУчета,
	|	ЕдИзм						КАК ЕдИзм,
	|	СУММА(ИзлишкиКоличество)	КАК Количество,
	|	СУММА(ИзлишкиСумма)			КАК Сумма
	|ИЗ
	|	Документ.ВедомостьИнвентаризации.ВедомостьРасхождений	КАК ТЧ
	|ГДЕ
	|	Ссылка = &ВедомостьИнвентаризации
	|	И ВЫБОР
	|		КОГДА Ссылка.ВариантФормированияОписи = &ВариантФормированияОписи194н ТОГДА
	|			// Колонка МОЛ в табличной части не используется
	|			ИСТИНА
	|		ИНАЧЕ
	|			(МОЛ В(&СписокМОЛ))
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ОбъектУчета,
	|	НомерОбъектаУчета,
	|	ЕдИзм
	|ИМЕЮЩИЕ
	|	СУММА(ИзлишкиКоличество) > 0
	|	ИЛИ СУММА(ИзлишкиСумма) > 0
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектУчета
	|;";
	
	РезультатРасхождения = ЗапросРасхождения.ВыполнитьПакет();
	
	// [0]. Недостачи
	ДокументОбъект["Недостачи"].Загрузить(РезультатРасхождения[0].Выгрузить());
	
	// [1]. Излишки
	ДокументОбъект["Излишки"].Загрузить(РезультатРасхождения[1].Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьРасхожденияПоОписям(ДокументОбъект) Экспорт
	
	ДокументВедомостьИнвентаризации = Документы.ВедомостьИнвентаризации.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(ДокументВедомостьИнвентаризации, ДокументОбъект);
	
	ДокументВедомостьИнвентаризации["ВариантФормированияОписи"] = 1;
	
	ДокументВедомостьИнвентаризации["ИнвентаризационныеОписи"].Загрузить(ДокументОбъект["ИнвентаризационныеОписи"].Выгрузить());
	
	Документы.ВедомостьИнвентаризации.ЗаполнитьПоОписям(ДокументВедомостьИнвентаризации);
	
	ТаблицаВедомостьРасхождений = ДокументВедомостьИнвентаризации["ВедомостьРасхождений"];
	
	ДокументОбъект["Недостачи"].Очистить();
	ДокументОбъект["Излишки"].Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВедомостьРасхождений Цикл
		НедостачаСумма		= СтрокаТаблицы["ЕстественнаяУбыльСумма"]		+ СтрокаТаблицы["СверхНормСумма"];
		НедостачаКоличество	= СтрокаТаблицы["ЕстественнаяУбыльКоличество"]	+ СтрокаТаблицы["СверхНормКоличество"];
		ИзлишекКоличество	= СтрокаТаблицы["ИзлишкиКоличество"];
		ИзлишекСумма		= СтрокаТаблицы["ИзлишкиСумма"];
		
		// Недостача
		Если НЕ (НедостачаСумма = 0 И НедостачаКоличество = 0) Тогда
			НоваяСтрока = ДокументОбъект["Недостачи"].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока["Количество"]	= НедостачаКоличество;
			НоваяСтрока["Сумма"]		= НедостачаСумма;
		КонецЕсли;
		
		// Излишек
		Если НЕ (ИзлишекСумма = 0 И ИзлишекКоличество = 0) Тогда
			НоваяСтрока = ДокументОбъект["Излишки"].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока["Количество"]	= ИзлишекКоличество;
			НоваяСтрока["Сумма"]		= ИзлишекСумма;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВыводыКомиссии(ДокументОбъект) Экспорт
	
	ДокументОбъект["ВыводыКомиссии"] = СформироватьВыводыКомиссии(ДокументОбъект);
	
КонецПроцедуры

Функция ПоддерживаемыеТипыОписей() Экспорт
	
	ИменаДокументов = Новый Массив();
	
	ИменаБезМОЛ = Новый Массив();
	
	ИменаСМОЛ = Новый Массив();
	ИменаСМОЛ.Добавить("ИнвентаризацияДрагКамнейВИК");
	ИменаСМОЛ.Добавить("ИнвентаризацияДрагКамнейВНФА");
	ИменаСМОЛ.Добавить("ИнвентаризацияДрагМеталловВИК");
	ИменаСМОЛ.Добавить("ИнвентаризацияДрагМеталловВНФА");
	ИменаСМОЛ.Добавить("ИнвентаризацияИК");
	ИменаСМОЛ.Добавить("ИнвентаризацияМЗ");
	ИменаСМОЛ.Добавить("ИнвентаризацияОС");
	ИменаСМОЛ.Добавить("ИнвентаризацияКассы");
	
	МассивТипов = Метаданные.Документы.УдалитьАктОРезультатахИнвентаризации.ТабличныеЧасти.ИнвентаризационныеОписи.Реквизиты.Опись.Тип.Типы();
	
	Для Каждого Тип Из МассивТипов Цикл
		
		ПредставлениеТипа = ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип);
		
		ИмяДокумента = СтрЗаменить(ПредставлениеТипа, "ДокументСсылка.", "");
		
		ИменаДокументов.Добавить(ИмяДокумента);
		
		Если ИменаСМОЛ.Найти(ИмяДокумента) = Неопределено Тогда
			ИменаБезМОЛ.Добавить(ИмяДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("Все",		ИменаДокументов);
	Результат.Вставить("СМОЛ",		ИменаСМОЛ);
	Результат.Вставить("БезМОЛ",	ИменаБезМОЛ);
	
	Возврат Результат;
	
КонецФункции

