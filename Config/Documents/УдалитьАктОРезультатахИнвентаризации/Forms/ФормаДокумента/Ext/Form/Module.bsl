	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОчиститьРеквизитыНесоответствующиеМОЛ()
	
	// Очищаем реквизиты документа
	ОчищающаяСтруктура = Новый Структура("
		|ВедомостьРасхождений,
		|ВидАктива,
		|ВыводыКомиссии");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	// Очищаем реквизиты формы
	
	// Очищаем табличные части документа
	Объект["ИнвентаризационныеОписи"].Очистить();
	Объект["Излишки"].Очистить();
	Объект["Недостачи"].Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьРасхожденийПриИзмененииКлиент()
	
	Если ЗначениеЗаполнено(Объект["ВедомостьРасхождений"]) Тогда
		ТекстСообщения = НСтр("ru='Заполнить документ по выбранной ведомости расхождений?'");
	Иначе
		ТекстСообщения = НСтр("ru='Рекомендуется выполнить очистку документа.
			|
			|Очистить документ?'");
	КонецЕсли;
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВедомостьРасхожденийПриИзмененииКлиент_Выбор", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ВедомостьРасхожденийПриИзмененииКлиент_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Если ЗначениеЗаполнено(Объект["ВедомостьРасхождений"]) Тогда
			ЗаполнитьВсеНаОснованииВедомостиСервер();
		Иначе
			ОчиститьРеквизитыНесоответствующиеВедомостиРасхождений()
		КонецЕсли;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОчиститьРеквизитыНесоответствующиеВедомостиРасхождений()
	
	// Очищаем реквизиты документа
	ОчищающаяСтруктура = Новый Структура("
		|ВидАктива,
		|ВыводыКомиссии");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	// Очищаем реквизиты формы
	
	// Очищаем табличные части документа
	Объект["ИнвентаризационныеОписи"].Очистить();
	Объект["Излишки"].Очистить();
	Объект["Недостачи"].Очистить();
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены(СработавшаяКоманда)
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект["Ссылка"],
			"Объект.Организация");
	КонецЕсли;
	
	Если СработавшаяКоманда.Имя = "ЗаполнитьОписиПоВедомости"
		ИЛИ (СработавшаяКоманда.Имя = "ЗаполнитьРасхождения"
			И СледуетЗаполнитьРасхожденияПоВедомостиРасхождений(Объект)) Тогда
			
		Если НЕ ЗначениеЗаполнено(Объект["ВедомостьРасхождений"]) Тогда
			Результат = Ложь;
			ТекстСообщения = НСтр("ru='Поле ""Ведомость расхождений"" не заполнено'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект["Ссылка"],
				"Объект.ВедомостьРасхождений");
		КонецЕсли;
	КонецЕсли;
	
	Если СработавшаяКоманда.Имя = "ЗаполнитьОписиПоМОЛ" Тогда
		Если НЕ ЗначениеЗаполнено(Объект["ДатаНачала"]) Тогда
			Результат = Ложь;
			ТекстСообщения = НСтр("ru='Поле ""Дата начала проведения инвентаризации"" не заполнено'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект["Ссылка"],
				"Объект.ДатаНачала");
			КонецЕсли;
			
		Если НЕ ЗначениеЗаполнено(Объект["ДатаОкончания"]) Тогда
			Результат = Ложь;
			ТекстСообщения = НСтр("ru='Поле ""Дата окончания проведения инвентаризаци"" не заполнено'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект["Ссылка"],
				"Объект.ДатаОкончания");
		КонецЕсли;
	КонецЕсли;
	
	Если (СработавшаяКоманда.Имя = "ЗаполнитьРасхождения"
		И СледуетЗаполнитьРасхожденияПоИнвентаризационнымОписям(Объект)) Тогда
		
		Если Объект["ИнвентаризационныеОписи"].Количество() = 0 Тогда
			Результат = Ложь;
			ТекстСообщения = НСтр("ru='Таблица ""Инвентаризационные описи"" не заполнена'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект["Ссылка"],
				"Объект.ИнвентаризационныеОписи");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьКомментарийКнопкаЗаполнить()
	
	Если СледуетЗаполнитьРасхожденияПоВедомостиРасхождений(Объект) Тогда
		// Заполнить по ведомости
		КомментарийКнопкаЗаполнить = НСтр("ru='(по ведомости расхождений)'");
		
	ИначеЕсли СледуетЗаполнитьРасхожденияПоИнвентаризационнымОписям(Объект) Тогда
		// Заполнить по описям
		КомментарийКнопкаЗаполнить = НСтр("ru='(по описям)'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СледуетЗаполнитьРасхожденияПоВедомостиРасхождений(ДокументОбъект)
	
	Возврат ЗначениеЗаполнено(ДокументОбъект["ВедомостьРасхождений"]);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СледуетЗаполнитьРасхожденияПоИнвентаризационнымОписям(ДокументОбъект)
	
	Возврат НЕ ЗначениеЗаполнено(ДокументОбъект["ВедомостьРасхождений"]);
	
КонецФункции

&НаСервере
Процедура ИнициализироватьТипыОписей()
	
	ТипыОписей = Документы.УдалитьАктОРезультатахИнвентаризации.ПоддерживаемыеТипыОписей();
	
	ТипыОписейБезМОЛ.Очистить();
	
	Для Каждого ИмяДокумента Из ТипыОписей["БезМОЛ"] Цикл
		ОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
		
		ТипыОписейБезМОЛ.Добавить(ИмяДокумента, ОбъектМетаданных.Представление());
	КонецЦикла;
	
	ТипыОписейБезМОЛ.СортироватьПоПредставлению();
	
	ТипыОписейСМОЛ.Очистить();
	
	Для Каждого ИмяДокумента Из ТипыОписей["СМОЛ"] Цикл
		ОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
		
		ТипыОписейСМОЛ.Добавить(ИмяДокумента, ОбъектМетаданных.Представление());
	КонецЦикла;
	
	ТипыОписейСМОЛ.СортироватьПоПредставлению();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентаризационныеВедомостиОписьНачалоВыбора_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОткрытьФормуТиповОписей(Результат.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуТиповОписей(ИмяДокумента)
	
	ИмяОткрываемойФормы = "Документ." + ИмяДокумента + ".ФормаВыбора";
	
	Отбор = Новый Структура();
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("Проведен", Истина);
	
	Если ЗначениеЗаполнено(Объект.МОЛ) Тогда
		СписокОтбораПоМОЛ = ПолучитьСписокОтбораПоМОЛ(Объект.МОЛ, Объект.Организация);
		
		Отбор.Вставить("МОЛ", СписокОтбораПоМОЛ);
		Отбор.Вставить("ЦМО", СписокОтбораПоМОЛ);
	КонецЕсли;
	
	ПараметрыОткрываемойФормы = Новый Структура("Отбор", Отбор);
	
	ПараметрыОткрываемойФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыОткрываемойФормы, Элементы.ИнвентаризационныеВедомостиОпись);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменениеМОЛ()
	
	Если Объект.МОЛ = ПрежнееЗначениеМОЛ Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Изменение МОЛ вызовет очистку документа.
		|
		|Продолжить и сменить МОЛ?'");
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ПодтвердитьИзменениеМОЛ_Выбор", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменениеМОЛ_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ПрежнееЗначениеМОЛ = Объект.МОЛ;
		
		МОЛПриИзмененииКлиент();
		
	Иначе
		
		Объект.МОЛ = ПрежнееЗначениеМОЛ;
		
	КонецЕсли;
	
КонецПроцедуры

