&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	НовДоступностьОписи				= ЗначениеЗаполнено(Объект.Организация);
	НовДоступностьВыводыКомиссии	= ЗначениеЗаполнено(Объект.Организация);
	НовДоступностьКомиссия			= ЗначениеЗаполнено(Объект.Организация);
	НовДоступностьВедомость			= ЗначениеЗаполнено(Объект.МОЛ);
	
	// Описи и автозаполнение
	Элементы["СтраницаИнвентаризационныеОписи"].ТолькоПросмотр						= НЕ НовДоступностьОписи;
	Элементы["ГруппаРасхождения"].ТолькоПросмотр									= НЕ НовДоступностьОписи;
	Элементы["ЗаполнитьРасхождения"].Доступность									= НовДоступностьОписи;
	Элементы["ЗаполнитьВыводыКомиссии"].Доступность									= НовДоступностьОписи;
	Элементы["ИнвентаризационныеВедомостиЗаполнитьОписиПоВедомости"].Доступность	= НовДоступностьОписи;
	Элементы["ИнвентаризационныеВедомостиЗаполнитьОписиПоМОЛ"].Доступность			= НовДоступностьОписи;
	
	// Выводы комиссии
	Элементы["ГруппаВыводыКомиссии"].ТолькоПросмотр	= НЕ НовДоступностьВыводыКомиссии;
	
	// Инвентаризационная комиссия
	Элементы["СтраницаИнвентаризация"].ТолькоПросмотр			= НЕ НовДоступностьКомиссия;
	Элементы["УстановитьПериод"].Доступность					= НовДоступностьКомиссия;
	Элементы["КомандаВыбратьКомиссию"].Доступность				= НовДоступностьКомиссия;
	Элементы["ВыбратьПредседателяКомиссии"].Доступность			= НовДоступностьКомиссия;
	Элементы["СоставКомиссииПодобратьСотрудников"].Доступность	= НовДоступностьКомиссия;
	
	Элементы["ВедомостьРасхождений"].ТолькоПросмотр = НЕ НовДоступностьВедомость;
	
	УстановитьКомментарийКнопкаЗаполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ТекстСообщения = НСтр("ru='Изменение организации вызовет очистку документа.
		|
		|Продолжить и сменить организацию?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОчиститьРеквизитыНесоответствующиеОрганизации();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОчиститьРеквизитыНесоответствующиеОрганизации()
	
	// Очищаем реквизиты документа
	ОчищающаяСтруктура = Новый Структура("
		|МОЛ,
		|ВедомостьРасхождений,
		|ДолжностьПредседателяКомиссии,
		|ФамилияПредседателяКомиссии,
		|ИмяПредседателяКомиссии,
		|ОтчествоПредседателяКомиссии,
		|НомерПриказаИнвентаризации,
		|ДатаПриказаИнвентаризации,
		|НомерПриказаКомиссии,
		|ДатаПриказаКомиссии,
		|МестоИнвентаризации,
		|ПричинаИнвентаризации,
		|ВидАктива,
		|ВыводыКомиссии");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	// Очищаем реквизиты формы
	
	// Очищаем табличные части документа
	Объект["ИнвентаризационныеОписи"].Очистить();
	Объект["СоставКомиссии"].Очистить();
	Объект["Излишки"].Очистить();
	Объект["Недостачи"].Очистить();
	
КонецПроцедуры

