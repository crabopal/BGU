// Заполнение табличных частей

&НаКлиенте
Процедура ЗаполнитьОписиПоВедомостиКлиент()
	
	ЗаполнитьОписиПоВедомостиСервер();
	
	Если Объект["ИнвентаризационныеОписи"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='В указанной ведомости отсутствуют инвентаризационные описи'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьОписиПоВедомостиСервер()
	
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьИнвентаризационныеОписиПоВедомости(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОписиПоМОЛКлиент()
	
	ЗаполнитьОписиПоМОЛСервер();
	
	Если Объект["ИнвентаризационныеОписи"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Не обнаружены проведенные документы инвентаризации в указанном периоде времени'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьОписиПоМОЛСервер()
	
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьИнвентаризационныеОписиПоМОЛ(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРасхожденияКлиент()
	
	ЗаполнитьРасхожденияСервер();
	
	Если Объект["Недостачи"].Количество() = 0 И Объект["Излишки"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Расхождения не обнаружены'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
	ОбновитьВыводыКомиссии();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасхожденияСервер()
	
	Если СледуетЗаполнитьРасхожденияПоВедомостиРасхождений(Объект) Тогда
		// Заполнить по ведомости
		Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьРасхожденияПоВедомости(Объект);
		
	ИначеЕсли СледуетЗаполнитьРасхожденияПоИнвентаризационнымОписям(Объект) Тогда
		// Заполнить по описям
		Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьРасхожденияПоОписям(Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыводыКомиссииСервер()
	
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьВыводыКомиссии(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВыводыКомиссии()
	
	Если Объект["Недостачи"].Количество() = 0 И Объект["Излишки"].Количество() = 0 Тогда
		Объект["ВыводыКомиссии"] = "";
	Иначе
		ЗаполнитьВыводыКомиссииСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВсеНаОснованииВедомостиСервер()
	
	Документы.УдалитьАктОРезультатахИнвентаризации.ЗаполнитьНаОснованииВедомостиРасхождений(Объект, Объект["ВедомостьРасхождений"]);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокОтбораПоМОЛ(МОЛ, Организация)
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("МОЛ", МОЛ);
	ШапкаДокумента.Вставить("Организация", Организация);
	
	Возврат ИнвентаризацияСервер.ПолучитьСписокОтбораПоМОЛ(ШапкаДокумента);
	
КонецФункции

