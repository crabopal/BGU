	Объект.ДанныеРежимаРаботы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для каждого ТекСтрока Из Объект.ДанныеРежимаРаботы Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЦикла	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНормативныйРасходГСМНаСервере()
	Для Каждого ТекущийРежим Из Объект.ДанныеРежимаРаботы Цикл
		РассчитатьНормативПоКлючу(ТекущийРежим.НомерСтроки,ТекущийРежим.КлючСтроки,ТекущийРежим.НомерСтроки,ТекущийРежим.ПродолжительностьРаботы,ТекущийРежим.КоличествоОбработанныхМЦ,ТекущийРежим.ПоказанияСчетчика,ТекущийРежим.ВидГСМ);			
	КонецЦикла;	
	//свертка для итоговой таблицы и заполнение результатов расчета
	ИтоговаяТаблицаНормативногоРасхода = Объект.ДанныеРежимаРаботы.Выгрузить(,"ВидГСМ, НормативРасходаГСМ,ПолученоГСМ,ФактическийРасходГСМ");	
	ИтоговаяТаблицаНормативногоРасхода.Свернуть("ВидГСМ","НормативРасходаГСМ,ПолученоГСМ,ФактическийРасходГСМ");
	
	ДанныеОбОстаткахГСМ = УчетГСМ.ДанныеФактическогоОстаткаГСМПоследнегоРабочегоЛистаАгрегата(Объект);
	
	//Заполнение нормативного расхода
	Объект.ФактическийРасходГСМ.Очистить();	
	Для Каждого ТекущийНормативныйРасход Из ИтоговаяТаблицаНормативногоРасхода Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		НоваяСтрока.ВидГСМ = ТекущийНормативныйРасход.ВидГСМ;
		НоваяСтрока.ВыданоГорючее = ТекущийНормативныйРасход.ПолученоГСМ;
		НоваяСтрока.ФактическийРасходГорючего = ТекущийНормативныйРасход.ФактическийРасходГСМ;
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.НормативРасходаГСМ;
		НоваяСтрока.ЕдиницаИзмерения = ТекущийНормативныйРасход.ВидГСМ.ЕдиницаИзмерения;
		ОстатокГорючегоПриВыезде = УчетГСМ.ОстатокГСМПоТаблицеОстатков(ТекущийНормативныйРасход.ВидГСМ, ДанныеОбОстаткахГСМ); 
		НоваяСтрока.ОстатокГорючегоПриВыезде = ?(ОстатокГорючегоПриВыезде < 0, 0, ОстатокГорючегоПриВыезде);
	КонецЦикла;	
	
	//Расчет расхода смазочных материалов и специальных жидкостей
	Объект.НормативныйРасходСМ.Очистить();
	Для Каждого ТекущийРежим Из Объект.ДанныеРежимаРаботы Цикл
		РассчитатьНормативСмазочныхМатериаловПоКлючу(ТекущийРежим.НомерСтроки,ТекущийРежим.КлючСтроки,ТекущийРежим.ВидГСМ);			
	КонецЦикла;	
	
	ИтоговаяТаблицаНормативногоРасходаСМ = Объект.НормативныйРасходСМ.Выгрузить(,"ВидСМ, ЗначениеРасходаСМ");	
	ИтоговаяТаблицаНормативногоРасходаСМ.Свернуть("ВидСМ","ЗначениеРасходаСМ");
	
	Для Каждого ТекущийНормативныйРасход Из ИтоговаяТаблицаНормативногоРасходаСМ Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		НоваяСтрока.ВидГСМ = ТекущийНормативныйРасход.ВидСМ;
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ЕдиницаИзмерения = ТекущийНормативныйРасход.ВидСМ.ЕдиницаИзмерения;		
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ФактическийРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		ОстатокГорючегоПриВыезде = УчетГСМ.ОстатокГСМПоТаблицеОстатков(ТекущийНормативныйРасход.ВидСМ, ДанныеОбОстаткахГСМ); 
		НоваяСтрока.ОстатокГорючегоПриВыезде = ?(ОстатокГорючегоПриВыезде < 0, 0, ОстатокГорючегоПриВыезде); 
		ОстатокГорючегоПриВозвращении = НоваяСтрока.ОстатокГорючегоПриВыезде - ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ОстатокГорючегоПриВозвращении = ?(ОстатокГорючегоПриВозвращении < 0, 0, ОстатокГорючегоПриВозвращении);
	КонецЦикла;	
	
	//Расчет экономии/перерасхода горючего
	Для Каждого ТекущийРасход Из Объект.ФактическийРасходГСМ Цикл
		ИтогоРасходГорючего = ТекущийРасход.НормативныйРасходГорючего - ТекущийРасход.ФактическийРасходГорючего;
		ТекущийРасход.Экономия = 0;
		ТекущийРасход.Перерасход = 0;
		Если ИтогоРасходГорючего > 0 Тогда
			ТекущийРасход.Экономия = ИтогоРасходГорючего;
		ИначеЕсли ИтогоРасходГорючего < 0 Тогда
			ТекущийРасход.Перерасход = (-1)*ИтогоРасходГорючего;
		КонецЕсли;	
	КонецЦикла;	
	
	//Добавим строки с остатками для тех видов ГСМ, которые отсутствуют в ТЧ "Фактический расход ГСМ", но есть в остатках таксировки предыдущего рабочего листа агрегата
	Для Каждого ТекСтрока Из ДанныеОбОстаткахГСМ Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидГСМ", ТекСтрока.ВидГСМ);
		НайденныеСтроки = Объект.ФактическийРасходГСМ.НайтиСтроки(ПараметрыОтбора); 		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
			НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
			НоваяСтрока.НормативныйРасходГорючего = 0;
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;	
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении; 
			НоваяСтрока.ОстатокГорючегоПриВозвращении = ТекСтрока.ОстатокГорючегоПриВозвращении; 
		КонецЕсли;	
	КонецЦикла;	
	
	Объект.ФактическийРасходГСМ.Сортировать("ВидГСМ Возр"); 
	
	//Сообщение о необходимости перезаполнения ТЧ Материалы
	Если Объект.Материалы.Количество() > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Выполнен перерасчет нормативного расхода ГСМ. Следует перезаполнить табличную часть ""Списываемые материалы"".'");
		Сообщение.Сообщить();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкиПоКлючу(Ключ,ВидГСМРежима, ВидПоказателя, ЗначениеПоказателя)
	//Заполнение норм расхода
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указана организация. Укажите организацию в поле ""Организация"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если Объект.ДатаРабочегоЛистаАгрегата = Дата(1,1,1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указана дата рабочего листа агрегата. Укажите дату в поле ""от"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.Агрегат) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указан агрегат. Укажите агрегат в поле ""Агрегат"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;
	
	СписокВидовГСМ = Новый СписокЗначений;
	СписокВидовГСМ.Добавить(ВидГСМРежима);	
	
	НастройкиРасчета = УчетГСМ.ПолучитьНормыРасходаТС(Объект.Организация,Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты,Объект.Агрегат,Справочники.НормыРасходаГСМДляАгрегатов.ПустаяСсылка(),ВидГСМРежима,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
	
	Выборка = НастройкиРасчета.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В организации %1 по виду ГСМ %2 на %3 для агрегата нет актуальных настроек в регистре ""Настройки норм расхода ГСМ для транспортных средств и агрегатов"".'"),Объект.Организация,ВидГСМРежима,Формат(КонецДня(Объект.ДатаРабочегоЛистаАгрегата),"ДЛФ=Д"));
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
		ДобавитьНастройки = Истина;
		//Контроль сезонности параметра расчета
		Если Выборка.Настройка.СезонныйПараметр Тогда
			//контроль даты рабочего листа агрегата и сезона
			ДобавитьНастройки = СезонныеНастройкиСоответствуютДате(Выборка.Настройка,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
		КонецЕсли;	
		
		Если ДобавитьНастройки Тогда
			ДобавитьНорму = Истина;
			Если Выборка.Настройка.ВидНормы = Перечисления.ВидыНормРасходаГСМАгрегатов.БазоваяНормаРасхода Тогда
				Если ВидПоказателя = Выборка.Настройка.ОсновнойПараметрРасчета Тогда
					ДобавитьНорму = Истина;
				Иначе
					ДобавитьНорму = Ложь;
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru='Вид основного параметра расчета в норме расхода из настройки ('")+СокрЛП(Выборка.Настройка.ОсновнойПараметрРасчета)+НСтр("ru=') не соответствует показателю расчета в режиме работы агрегата ('")+
						СокрЛП(ВидПоказателя)+НСтр("ru='). Следует указать соответствующую норму расхода вручную.'");
					Сообщение.Сообщить();
				КонецЕсли;
			Иначе
				ДобавитьНорму = Истина;
			КонецЕсли;	
			
			Если ДобавитьНорму Тогда
				НоваяСтрока = Объект.НормыРасхода.Добавить();
				НоваяСтрока.НаименованиеНормы = Выборка.НазваниеНастройки;
				НоваяСтрока.Норма = Выборка.Настройка;
				НоваяСтрока.Значение = Выборка.Настройка.Значение;
				НоваяСтрока.ЕдиницаИзмерения = Выборка.Настройка.ЕдиницаИзмерения;
				НоваяСтрока.Параметр = Выборка.Настройка.ОсновнойПараметрРасчета;
				НоваяСтрока.ЗначениеПараметра = Выборка.Настройка.ЗначениеОсновногоПараметраРасчета;
				НоваяСтрока.ЕдиницаИзмеренияПараметра = Выборка.Настройка.ЕдиницаИзмеренияПараметра;
				НоваяСтрока.КлючСтроки = Ключ;
				
				Если (Выборка.Настройка.ВидНормы = Перечисления.ВидыНормРасходаГСМАгрегатов.НормаРасходаСмазочныхМатериалов) Тогда
					СписокВидовГСМ.Добавить(Выборка.Настройка.ВидСМ);	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	//Заполнение поправочных коэффициентов расхода
	НастройкиРасчета = УчетГСМ.ПолучитьНормыРасходаТС(Объект.Организация,Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты,Объект.Агрегат,Справочники.ПоправочныеКоэффициентыРасчетаНормГСМ.ПустаяСсылка(),СписокВидовГСМ,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
	
	Выборка = НастройкиРасчета.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьНастройки = Истина;
		//Контроль сезонности параметра расчета
		Если Выборка.Настройка.СезонныйПараметр Тогда
			//контроль даты рабочего листа агрегата и сезона
			ДобавитьНастройки = СезонныеНастройкиСоответствуютДате(Выборка.Настройка,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
		КонецЕсли;	
		Если ДобавитьНастройки Тогда
			НоваяСтрока = Объект.ПоправочныеКоэффициенты.Добавить();
			НоваяСтрока.НаименованиеКоэффициента = Выборка.НазваниеНастройки;
			НоваяСтрока.ПоправочныйКоэффициент = Выборка.Настройка;
			НоваяСтрока.Значение = Выборка.Настройка.ЗначениеВПроцентах;
			НоваяСтрока.КлючСтроки = Ключ;
		КонецЕсли;
	КонецЦикла;	
	
	//Заполнение поправочных значений расхода
	НастройкиРасчета = УчетГСМ.ПолучитьНормыРасходаТС(Объект.Организация,Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты,Объект.Агрегат,Справочники.ПоправочныеЗначенияРасчетаНормГСМ.ПустаяСсылка(),СписокВидовГСМ,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
	
	Выборка = НастройкиРасчета.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьНастройки = Истина;
		//Контроль сезонности параметра расчета
		Если Выборка.Настройка.СезонныйПараметр Тогда
			//контроль даты рабочего листа агрегата и сезона
			ДобавитьНастройки = СезонныеНастройкиСоответствуютДате(Выборка.Настройка,КонецДня(Объект.ДатаРабочегоЛистаАгрегата));
		КонецЕсли;	
		
		Если ДобавитьНастройки Тогда
			НоваяСтрока = Объект.ПоправочныеЗначения.Добавить();
			НоваяСтрока.НаименованиеЗначения = Выборка.НазваниеНастройки;
			НоваяСтрока.ПоправочноеЗначение = Выборка.Настройка;
			НоваяСтрока.Значение = Выборка.Настройка.Значение;
			НоваяСтрока.ЕдиницаИзмерения = Выборка.Настройка.ЕдиницаИзмерения;
			НоваяСтрока.ЗначениеОсновногоПараметраРасчета = Выборка.Настройка.ЗначениеОсновногоПараметраРасчета;
			НоваяСтрока.ЕдиницаИзмеренияПараметра = Выборка.Настройка.ЕдиницаИзмеренияПараметра;
			НоваяСтрока.КлючСтроки = Ключ;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиРасчетаГСМДляТСНаСервере()
	Объект.НормыРасхода.Очистить();
	Объект.ПоправочныеКоэффициенты.Очистить();
	Объект.ПоправочныеЗначения.Очистить();
	
	Для Каждого ТекущиеДанные Из Объект.ДанныеРежимаРаботы Цикл
		Если ТекущиеДанные.ПродолжительностьРаботы > 0 Тогда
			ВидПоказателя = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПродолжительностьРаботы;
			ЗначениеПоказателя = 0;
		ИначеЕсли ТекущиеДанные.КоличествоОбработанныхМЦ > 0 Тогда
			ВидПоказателя = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.КоличествоОбработанныхМЦ;
			ЗначениеПоказателя = 0;
		ИначеЕсли ТекущиеДанные.ПоказанияСчетчика > 0 Тогда
			ВидПоказателя = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПоказанияСчетчика;
			ЗначениеПоказателя = ТекущиеДанные.ПоказанияСчетчика;
		Иначе	
			ВидПоказателя = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПустаяСсылка();
			ЗначениеПоказателя = 0;
		КонецЕсли;
		
		ДобавитьНастройкиПоКлючу(ТекущиеДанные.КлючСтроки, ТекущиеДанные.ВидГСМ, ВидПоказателя, ЗначениеПоказателя);
	КонецЦикла;	
	
	Объект.НормыРасхода.Сортировать("Значение Убыв");
	Объект.ПоправочныеЗначения.Сортировать("Значение  Убыв");
	Объект.ПоправочныеКоэффициенты.Сортировать("Значение  Убыв");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерерасчетПоказанийСчетчика()
	ТекущиеДанные = Элементы.ДанныеРежимаРаботы.ТекущиеДанные;

	Если ТекущиеДанные.ПоказанияСчетчикаНаКонец > 0 Тогда
		ТекущиеДанные.ПоказанияСчетчика = ТекущиеДанные.ПоказанияСчетчикаНаКонец - ТекущиеДанные.ПоказанияСчетчикаНаНачало;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДанныеАгрегата()
	ДанныеОсновногоПараметраРасчета = УчетГСМ.ОсновнойПараметрРасчетаРасходаГСМАгрегата(Объект.Организация, Объект.Агрегат);
	ОсновнойПараметрРасчета = ДанныеОсновногоПараметраРасчета.ОсновнойПараметрРасчета;
	ЕдиницаИзмеренияРаботы = ДанныеОсновногоПараметраРасчета.ЕдиницаИзмеренияРаботы;
	
	Элементы.ДекорацияМаркаНомерДвигателя.Заголовок = ПолучитьМаркуНомерДвигателяАгрегата();
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСчетаУчетаМЗ105(Форма)
	СчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("105.23,105.33");
	Форма.Счета105.ЗагрузитьЗначения(СчетаУчета);	
КонецПроцедуры

&НаСервере
Функция	СезонныеНастройкиСоответствуютДате(НастройкиСезона,ДатаРасчета)	
	Результат = Истина;
	Если НастройкиСезона.МесяцНачалаСезона > НастройкиСезона.МесяцОкончанияСезона Тогда
		//с конца на начало года	
		НачалоПервогоПериодаСезона = Дата(Год(ДатаРасчета),1,1);
		КонецПервогоПериодаСезона = Конецдня(Дата(Год(ДатаРасчета),НастройкиСезона.МесяцОкончанияСезона,НастройкиСезона.ЧислоМесяцаОкончанияСезона));
		
		НачалоВторогоПериодаСезона = Дата(Год(ДатаРасчета),НастройкиСезона.МесяцНачалаСезона,НастройкиСезона.ЧислоМесяцаНачалаСезона);
		КонецВторогоПериодаСезона = Конецдня(Дата(Год(ДатаРасчета),12,31));
		
		Если (НачалоПервогоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецПервогоПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
			Результат = Истина;
		Иначе
			Если (НачалоВторогоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецВторогоПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		//в середине года
		НачалоПериодаСезона = Дата(Год(ДатаРасчета),НастройкиСезона.МесяцНачалаСезона,НастройкиСезона.ЧислоМесяцаНачалаСезона);
		КонецПериодаСезона = КонецДня(Дата(Год(ДатаРасчета),НастройкиСезона.МесяцОкончанияСезона,НастройкиСезона.ЧислоМесяцаОкончанияСезона));
		Если (НачалоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции	

&НаКлиенте
Функция ПолучитьТекущуюСтрокуФактическогоРасхода()
	Возврат Элементы.ФактическийРасходГСМ.ТекущиеДанные;
КонецФункции

&НаКлиенте
Процедура ПерерасчетЭкономииПерерасхода()
	Стр = ПолучитьТекущуюСтрокуФактическогоРасхода();
	
	РасходГорючегоПоФакту = Стр.ОстатокГорючегоПриВыезде - Стр.ОстатокГорючегоПриВозвращении + Стр.ВыданоГорючее;
	Если РасходГорючегоПоФакту < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Фактический расход для строки %1 отрицательный. Возможно, неверно указано заправленное (выданное) количество ГСМ!'"),Стр.НомерСтроки);
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Стр.ФактическийРасходГорючего = РасходГорючегоПоФакту;
	
	ИтогоРасходГорючего = Стр.НормативныйРасходГорючего - Стр.ФактическийРасходГорючего;
	Стр.Экономия = 0;
	Стр.Перерасход = 0;
	Если ИтогоРасходГорючего > 0 Тогда
		Стр.Экономия = ИтогоРасходГорючего;
	ИначеЕсли ИтогоРасходГорючего < 0 Тогда
		Стр.Перерасход = (-1)*ИтогоРасходГорючего;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуДляРасчета(ФормулаРасчета)
	Возврат СтрЗаменить(Строка(ФормулаРасчета),Символы.НПП,"");
КонецФункции	

&НаСервере
Процедура РассчитатьНормативПоКлючу(НомерСтрокиРежима,Ключ,НомерРежима,ПродолжительностьРаботыСекунд,КоличествоОбработанныхМЦ,ПоказанияСчетчика,ВидГСМ)
	ТекстФормулыРасчетаГСМДляАгрегата = "";
	
	D = 0;
	РасшифровкаD = "";
	Для Каждого ТекСтрока Из Объект.ПоправочныеКоэффициенты Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидГСМ, ТекСтрока.ПоправочныйКоэффициент.ВидГСМ)) Тогда
			D = D + ТекСтрока.Значение;	
			РасшифровкаD = РасшифровкаD + ?(РасшифровкаD="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата номер %1 у поправочного коэффициента ""%2"" не указано значение в строке %3.'"),НомерРежима,ТекСтрока.НаименованиеКоэффициента,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если Найти(РасшифровкаD,"+")>0 Тогда
		РасшифровкаD = "(" + РасшифровкаD + ")";
	ИначеЕсли РасшифровкаD = "" Тогда 
		РасшифровкаD = "0";
	КонецЕсли;
	
	S = "";
	ИдентификаторФормулыРасчета = 0;
	НаименованиеКонтрольногоПоказателя = "";
	
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			Если ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПродолжительностьРаботы Тогда
				//Время работы
				ТекстФормулыРасчетаГСМДляАгрегата = "(Tw/Th)*Hs*(1+0.01*D)+Hplus";
				НаименованиеКонтрольногоПоказателя = "Контрольный период (ч)";
				НаименованиеОсновногоПоказателя = "Продолжительность работы агрегата"" (поле ""Время, ч.,м."")";
 				ИдентификаторФормулыРасчета = 1;
				
				ПродолжительностьВремениВЧасах = Окр(ПродолжительностьРаботыСекунд / 3600,2);
				ПериодРасхода = ТекСтрока.ЗначениеПараметра;
				
				РасходЗаПериод = ТекСтрока.Значение;
				S = ПродолжительностьВремениВЧасах;
			ИначеЕсли ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.КоличествоОбработанныхМЦ Тогда
				//Количество обработанных единиц
				ТекстФормулыРасчетаГСМДляАгрегата = "(Aw/Op)*Hs*(1+0.01*D)+Hplus";
				НаименованиеКонтрольногоПоказателя = "Контрольное количество (шт)";
				НаименованиеОсновногоПоказателя = "Количество обработанных МЦ (шт)"" (поле ""Кол-во МЦ"")";
				ИдентификаторФормулыРасчета = 2;
				
				S = "Aw";
				ВсегоЕдиницОбработано = КоличествоОбработанныхМЦ;
				КоличествоРасхода = ТекСтрока.ЗначениеПараметра;
				РасходЗаПериод = ТекСтрока.Значение;
				S = ВсегоЕдиницОбработано;
				
			ИначеЕсли ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПоказанияСчетчика Тогда
				//Показания счетчика
				ТекстФормулыРасчетаГСМДляАгрегата = "(Cw/Cp)*Hs*(1+0.01*D)+Hplus";
				НаименованиеКонтрольногоПоказателя = "Контрольное количество работы агрегата по счетчику (ед)";
				НаименованиеОсновногоПоказателя = "Количество работы агрегата по счетчику"" (поле ""Итого по счетчику"")";
				ИдентификаторФормулыРасчета = 3;
				
				ВсегоЕдиницПоСчетчику = ПоказанияСчетчика;
				КоличествоЕдиницРасхода = ТекСтрока.ЗначениеПараметра;
				РасходЗаПериод = ТекСтрока.Значение;
				S = ВсегоЕдиницПоСчетчику;
			Иначе
				Если (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМАгрегатов.НормаРасходаСмазочныхМатериалов) Тогда
					Продолжить;
				Иначе	
					//не заполнен тип параметра - расчет не может быть проведен
					НаименованиеКонтрольногоПоказателя = "";
					НаименованиеОсновногоПоказателя = "";
					ИдентификаторФормулыРасчета = 0;
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата в строке номер %1 не указан тип основного параметра расчета в строке %2.'"),НомерРежима,ТекСтрока.НомерСтроки);
					Сообщение.Сообщить();
					
					ПараметрыОтбора = Новый Структура("КлючСтроки", Ключ); 	
					МассивОтбора = Объект.ДанныеРежимаРаботы.НайтиСтроки(ПараметрыОтбора);
					Для Каждого СтрокаОтбора Из МассивОтбора Цикл
						СтрокаОтбора.РасшифровкаРасчетаНормативногоРасходаГСМ = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы агрегата в строке не указан тип основного параметра расчета в строке %1.'"),ТекСтрока.НомерСтроки);
						СтрокаОтбора.НормативРасходаГСМ = 0;
						СтрокаОтбора.ИдентификаторФормулыРасчета = ИдентификаторФормулыРасчета;
						СтрокаОтбора.ЭкономияПерерасход = 0;
					КонецЦикла;	
					Возврат;
				КонецЕсли;	
			КонецЕсли;
			
			//Контроль заполнения основного показателя расчета
			Если S = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки %1 режима работы агрегата не указано значение ""%2.'"),НомерРежима,НаименованиеОсновногоПоказателя);
				Сообщение.Сообщить();
			КонецЕсли;
			
			//контроль деления на 0
			Если ТекСтрока.ЗначениеПараметра = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата номер %1 у нормы расхода ""%2"" не указано значение основного параметра расчета ""%3"" (%4) в строке %5. Деление на ноль не позволяет провести расчет.'"),НомерРежима,ТекСтрока.НаименованиеНормы,ТекСтрока.Параметр,НаименованиеКонтрольногоПоказателя,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			
				ПараметрыОтбора = Новый Структура("КлючСтроки", Ключ); 	
				МассивОтбора = Объект.ДанныеРежимаРаботы.НайтиСтроки(ПараметрыОтбора);
				Для Каждого СтрокаОтбора Из МассивОтбора Цикл
					СтрокаОтбора.РасшифровкаРасчетаНормативногоРасходаГСМ = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не указано значение основного параметра расчета ""%1"". Деление на ноль не позволяет провести расчет.'"),НаименованиеКонтрольногоПоказателя);
					СтрокаОтбора.НормативРасходаГСМ = 0;
					СтрокаОтбора.ИдентификаторФормулыРасчета = ИдентификаторФормулыРасчета;
					СтрокаОтбора.ЭкономияПерерасход = 0;
				КонецЦикла;	
				
				Возврат;
			КонецЕсли;	
			
		КонецЕсли;
	КонецЦикла;	
	
	//Поправочные значения расхода литров на каждые Х часов работы
	Hplus = 0;
	РасшифровкаHplus = "";
	Для Каждого ТекСтрока Из Объект.ПоправочныеЗначения Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидГСМ, ТекСтрока.ПоправочноеЗначение.ВидГСМ)) Тогда
			Если ТекСтрока.ЗначениеОсновногоПараметраРасчета = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата номер %1 у поправочного значения ""%2"" не указано значение основного параметра расчета в строке %3. Поправочное значение не учтено в расчете.'"),НомерРежима,ТекСтрока.НаименованиеЗначения,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			Иначе	
				Hplus = Hplus + (S/ТекСтрока.ЗначениеОсновногоПараметраРасчета)*ТекСтрока.Значение;
				РасшифровкаHplus = РасшифровкаHplus + ?(РасшифровкаHplus="",""," + ") + "("+ПолучитьСтрокуДляРасчета(S)+" / "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеОсновногоПараметраРасчета)+") * "+ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			КонецЕсли;
			
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата номер %1 у поправочного значения ""%2"" не указано значение в строке %3.'"),НомерРежима,ТекСтрока.НаименованиеЗначения,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если (Найти(РасшифровкаHplus,"+")>0)ИЛИ(Найти(РасшифровкаHplus,"*")>0) Тогда
		РасшифровкаHplus = "(" + РасшифровкаHplus + ")";
	ИначеЕсли РасшифровкаHplus = "" Тогда 
		РасшифровкаHplus = "0";
	КонецЕсли;
	
	Если ИдентификаторФормулыРасчета = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки режима работы агрегата номер %1 не определен алгоритм расчета.'"),НомерРежима);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	

	ТекстФормулы = ТекстФормулыРасчетаГСМДляАгрегата;
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"D",ПолучитьСтрокуДляРасчета(D));
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hs",РасходЗаПериод);
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Tw",ПродолжительностьВремениВЧасах);
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Th",ПериодРасхода);
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Aw",ВсегоЕдиницОбработано);
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Op",КоличествоРасхода);
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Cw",ВсегоЕдиницПоСчетчику);
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Cp",КоличествоЕдиницРасхода);
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hplus",ПолучитьСтрокуДляРасчета(Hplus));
	
	НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ВидГСМ, Объект.ДатаРабочегоЛистаАгрегата);
	
	НормативныйРасходГСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
	
	//детальная расшифровка
	ТекстРасшифровкиФормулы = ТекстФормулыРасчетаГСМДляАгрегата;
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"D",РасшифровкаD);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hs",РасходЗаПериод);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Tw",ПродолжительностьВремениВЧасах);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Th",ПериодРасхода);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Aw",ВсегоЕдиницОбработано);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Op",КоличествоРасхода);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Cw",ВсегоЕдиницПоСчетчику);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Cp",КоличествоЕдиницРасхода);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hplus",РасшифровкаHplus);
	
	
	ПараметрыОтбора = Новый Структура("КлючСтроки", Ключ); 	
	МассивОтбора = Объект.ДанныеРежимаРаботы.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		СтрокаОтбора.РасшифровкаРасчетаНормативногоРасходаГСМ = ТекстРасшифровкиФормулы;
		СтрокаОтбора.НормативРасходаГСМ = НормативныйРасходГСМ;
		СтрокаОтбора.ИдентификаторФормулыРасчета = ИдентификаторФормулыРасчета;
		
		СтрокаОтбора.ЭкономияПерерасход = НормативныйРасходГСМ - СтрокаОтбора.ФактическийРасходГСМ;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ПоправкаАктуальнаДляВидаГСМ(ТекущийВидГСМ, ВидГСМПоправки)
	Результат = Ложь;
	Если ТекущийВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
		Если НЕ ЗначениеЗаполнено(ВидГСМПоправки) Тогда
			Результат = Истина;
		Иначе
			Если ТекущийВидГСМ = ВидГСМПоправки Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		Если ТекущийВидГСМ = ВидГСМПоправки Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура РассчитатьНормативСмазочныхМатериаловПоКлючу(НомерРежима,Ключ,ВидГСМ)
	ТекстФормулыРасчетаСМДляАгрегата = "(0.01*ЗначениеРасходаГСМ*ЗначениеНормы)*(1+0.01*D)+Hplus";
	ЗначениеНормативногоРасходаТоплива = ПолучитьСтрокуДляРасчета(Объект.ДанныеРежимаРаботы[НомерРежима-1].НормативРасходаГСМ);
	
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ЗначениеЗаполнено(ТекСтрока.Норма)) Тогда
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы номер %1 у нормы расхода ""%2"" не указано значение в строке %3.'"),НомерРежима,ТекСтрока.НаименованиеНормы,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
			Если (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМАгрегатов.НормаРасходаСмазочныхМатериалов) Тогда
				ТекстФормулы = ТекстФормулыРасчетаСМДляАгрегата;
				ВидСМ = ТекСтрока.Норма.ВидСМ;
				
				//поправочные коэффициенты на каждые 100 единиц топлива
				D = 0;
				РасшифровкаD = "";
				Для Каждого ТекСтрокаПК Из Объект.ПоправочныеКоэффициенты Цикл
					Если (ТекСтрокаПК.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидСМ, ТекСтрокаПК.ПоправочныйКоэффициент.ВидГСМ)) Тогда
						D = D + ТекСтрокаПК.Значение;	
						РасшифровкаD = РасшифровкаD + ?(РасшифровкаD="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрокаПК.Значение);
						//контроль заполнения значений
						Если ТекСтрокаПК.Значение = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы номер %1 у поправочного коэффициента ""%2"" не указано значение в строке %3.'"),НомерРежима,ТекСтрокаПК.НаименованиеКоэффициента,ТекСтрокаПК.НомерСтроки);
							Сообщение.Сообщить();
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
				Если Найти(РасшифровкаD,"+")>0 Тогда
					РасшифровкаD = "(" + РасшифровкаD + ")";
				ИначеЕсли РасшифровкаD = "" Тогда 
					РасшифровкаD = "0";
				КонецЕсли;
				
				//Поправочные значения расхода литров на каждые 100 единиц топлива
				Hplus = 0;
				РасшифровкаHplus = "";
				Для Каждого ТекСтрокаПЗ Из Объект.ПоправочныеЗначения Цикл
					Если (ТекСтрокаПЗ.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидСМ, ТекСтрокаПЗ.ПоправочноеЗначение.ВидГСМ)) Тогда
						Если ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы номер %1 у поправочного значения ""%2"" не указано значение основного параметра расчета в строке %3. Поправочное значение не учтено в расчете.'"),НомерРежима,ТекСтрокаПЗ.НаименованиеЗначения,ТекСтрокаПЗ.НомерСтроки);
							Сообщение.Сообщить();
						Иначе	
							Hplus = Hplus + (ЗначениеНормативногоРасходаТоплива/ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета)*ТекСтрокаПЗ.Значение;
							РасшифровкаHplus = РасшифровкаHplus + ?(РасшифровкаHplus="",""," + ") + "("+ПолучитьСтрокуДляРасчета(ЗначениеНормативногоРасходаТоплива)+" / "+ПолучитьСтрокуДляРасчета(ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета)+") * "+ПолучитьСтрокуДляРасчета(ТекСтрокаПЗ.Значение);
						КонецЕсли;
						
						//контроль заполнения значений
						Если ТекСтрокаПЗ.Значение = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы номер %1 у поправочного значения ""%2"" не указано значение в строке %3.'"),НомерРежима,ТекСтрокаПЗ.НаименованиеЗначения,ТекСтрокаПЗ.НомерСтроки);
							Сообщение.Сообщить();
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
				Если (Найти(РасшифровкаHplus,"+")>0)ИЛИ(Найти(РасшифровкаHplus,"*")>0) Тогда
					РасшифровкаHplus = "(" + РасшифровкаHplus + ")";
				ИначеЕсли РасшифровкаHplus = "" Тогда 
					РасшифровкаHplus = "0";
				КонецЕсли;
				
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"ЗначениеНормы",ПолучитьСтрокуДляРасчета(ТекСтрока.Значение));
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"D",ПолучитьСтрокуДляРасчета(D));
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hplus",ПолучитьСтрокуДляРасчета(Hplus));
				ТекстФормулыФакт = ТекстФормулы;
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"ЗначениеРасходаГСМ", ЗначениеНормативногоРасходаТоплива);
				
				НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ВидСМ, Объект.ДатаРабочегоЛистаАгрегата);
				
				НормативныйРасходСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
				
				//детальная расшифровка
				ТекстРасшифровкиФормулы = ТекстФормулыРасчетаСМДляАгрегата;
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"ЗначениеРасходаГСМ",ПолучитьСтрокуДляРасчета(Объект.ДанныеРежимаРаботы[НомерРежима-1].НормативРасходаГСМ));
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"ЗначениеНормы",ПолучитьСтрокуДляРасчета(ТекСтрока.Значение));
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"D",РасшифровкаD);
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hplus",РасшифровкаHplus);
				
				НоваяСтрока = Объект.НормативныйРасходСМ.Добавить();
				НоваяСтрока.НомерРежима = НомерРежима;
				НоваяСтрока.ВидГСМ = ВидГСМ;
				НоваяСтрока.ВидСМ = ТекСтрока.Норма.ВидСМ;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.Норма.ЕдиницаИзмерения;
				НоваяСтрока.ЗначениеРасходаСМ = НормативныйРасходСМ;
				НоваяСтрока.РасшифровкаРасчетаСМ = ТекстРасшифровкиФормулы;
				НоваяСтрока.КлючСтроки = Ключ;
				
				НоваяСтрока.РасшифровкаРасчетаСМФакт = ТекстФормулыФакт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.Материалы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО,
		|КФО, КПС, КЭК, Количество");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.КПС = ДанныеСтроки.КПСДт;
	ПараметрыФормы.Подразделение = ДанныеСтроки.ПодразделениеДт;
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыСчета = Новый Структура("ОграниченияСписокСчетов",
	
	БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("106.00,109.00,401.20"));
	
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02"));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,,"Количество,КПС,Подразделение"); // КФО, КПС, КЭК и пр.
	
	ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ТекущиеДанные.СчетНУ          = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СубконтоНУ1     = СтруктураОтражениеВУчете.СубконтоНУ1;
	ТекущиеДанные.СубконтоНУ2     = СтруктураОтражениеВУчете.СубконтоНУ2;
	ТекущиеДанные.СубконтоНУ3     = СтруктураОтражениеВУчете.СубконтоНУ3;
	
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, Подразделение",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3", "КПСДт", "ПодразделениеДт");
	ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС, ЕстьКПС, ЕстьПодразделение",
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, ТекущиеДанные.КФО),
		Ложь,
		Ложь,
		НЕ ТекущиеДанные.КПС = ТекущиеДанные.КПСДт И ЗначениеЗаполнено(ТекущиеДанные.КПСДт),
		НЕ ТекущиеДанные.Подразделение = ТекущиеДанные.ПодразделениеДт И ЗначениеЗаполнено(ТекущиеДанные.ПодразделениеДт));
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	// Колонки ОтражениеВУчете
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, Подразделение",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3", "КПСДт", "ПодразделениеДт");
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС, ЕстьКПС, ЕстьПодразделение",
			НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, СтрокаТаблицы.КФО),
			Ложь,
			Ложь,
			НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт),
			НЕ СтрокаТаблицы.Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВыбранныйСотрудник = Константы.ВалютаРегламентированногоУчета.Получить();
	
	УстановитьФункциональныеОпцииФормы();
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДанныеРежимаРаботы(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыНормыРасхода(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыПоправочныеЗначенияРасхода(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыФактическийРасход(ЭтаФорма);
	ОбновитьТекстДанныеОЗаправкеВсехСтрокТаблицыФактическийРасход(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыМатериалы(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыТаксировки();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ЗаполнитьДобавленныеКолонкиТаблицыРежимов();
	
	УчетПоПодразделениямДляСчетовУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.23,105.33", , Объект.Дата).УчетПоПодразделениям;

	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	ПереименованиеЭлементовФормыПоВидуТаксировки(ЭтаФорма, Объект);
	УстановитьВидимостьЭлементов(ЭтаФорма);
	НастройкаДоступностиЭлементов(ЭтаФорма, Объект);
КонецПроцедуры

&НаСервере
Функция ПолучитьМаркуНомерДвигателяАгрегата()
	Результат = "";
	
	ЗаполнениеПоУЛ = Ложь;
	Если ЗначениеЗаполнено(Объект.РабочийЛистАгрегата) Тогда
		Если Объект.Агрегат = Объект.РабочийЛистАгрегата.Агрегат Тогда
			ЗаполнениеПоУЛ = Истина;
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Агрегат (машина) в указанном рабочем (учетном) листе не соответствует выбранному.'");
			Сообщение.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗаполнениеПоУЛ Тогда
		Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата") Тогда
			СтруктураДанныхРабочегоЛиста = УчетГСМ.ПолучитьДанныеРабочегоЛистаАгрегата(Объект.РабочийЛистАгрегата);
			МаркаДвигателя = СокрЛП(СтруктураДанныхРабочегоЛиста.МаркаДвигателяАгрегата);
			НомерДвигателя = СокрЛП(СтруктураДанныхРабочегоЛиста.НомерДвигателяАгрегата); 
			Если НЕ ЗначениеЗаполнено(МаркаДвигателя) Тогда
				МаркаДвигателя = УчетГСМ.ПолучитьМаркуДвигателя(Объект.Агрегат);
			Конецесли;	
			Если НЕ ЗначениеЗаполнено(НомерДвигателя) Тогда
				НомерДвигателя = УчетГСМ.ПолучитьНомерДвигателя(Объект.Агрегат);
			Конецесли;	
			Результат = СокрЛП(МаркаДвигателя)+", "+СокрЛП(НомерДвигателя); 
		ИначеЕсли Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда 
			СтруктураДанныхРабочегоЛиста = УчетГСМ.ПолучитьДанныеУчетногоЛистаТракториста(Объект.РабочийЛистАгрегата);
			МаркаДвигателя = СокрЛП(СтруктураДанныхРабочегоЛиста.ГаражныйНомер);
			НомерДвигателя = СокрЛП(СтруктураДанныхРабочегоЛиста.РегистрационныйНомернойЗнак);        
			Если НЕ ЗначениеЗаполнено(МаркаДвигателя) Тогда
				МаркаДвигателя = УчетГСМ.ПолучитьГаражныйНомерТС(Объект.Агрегат);
			Конецесли;	
			Если НЕ ЗначениеЗаполнено(НомерДвигателя) Тогда
				НомерДвигателя = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(Объект.Агрегат);
			Конецесли;	
			Результат = СокрЛП(МаркаДвигателя)+", "+СокрЛП(НомерДвигателя); 
		КонецЕсли;	
	Иначе
		Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата") Тогда
			Результат = УчетГСМ.ПолучитьМаркуДвигателя(Объект.Агрегат)+", "+УчетГСМ.ПолучитьНомерДвигателя(Объект.Агрегат); 
		ИначеЕсли Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда 
			Результат = УчетГСМ.ПолучитьГаражныйНомерТС(Объект.Агрегат)+", "+УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(Объект.Агрегат); 
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗаполнитьСписываемыеМатериалыГСМНаСервере()
	Объект.Материалы.Очистить();
	
	//списание по фактическому расходу
	Для каждого ТекРасход Из Объект.ФактическийРасходГСМ Цикл
		СписатьВидГСМ = ТекРасход.ВидГСМ;
		СписатьКоличество = ТекРасход.ФактическийРасходГорючего;
		НормаРасхода = ТекРасход.НормативныйРасходГорючего;
		
		Если СписатьКоличество > 0 Тогда
			НастройкиСписанияГСМПоУмолчанию = УчетГСМ.НастройкиСписанияГСМПоУмолчанию(Объект.Организация, Объект.Агрегат, СписатьВидГСМ);
			
			Номенклатура = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
			СчетУчетаНоменклатуры = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, ПланыСчетов.ЕПСБУ.НайтиПоКоду(НастройкиСписанияГСМПоУмолчанию[0].СчетУчета), ПланыСчетов.ЕПСБУ.ПустаяСсылка());
			ЕдиницаИзмеренияГСМ = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].Номенклатура.ЕдиницаИзмерения, Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
			ИФО = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].ИФО, Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			Подразделение = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].Подразделение, Справочники.Подразделения.ПустаяСсылка());
			КФО = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].КФО, Перечисления.КВД.ПустаяСсылка());
			КПС = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].КПС, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
			
			ЦМО = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].ЦМО, Справочники.ЦМО.ПустаяСсылка());
			Если (ТипЗнч(ЦМО) = Тип("СправочникСсылка.МестаХранения"))И(ЗначениеЗаполнено(ЦМО)) Тогда
				ЦМО = УчетГСМ.ЦМОПоСотрудникуИМестуХранения(Объект.МОЛ, ЦМО);
			КонецЕсли;	
			
			ПодразделениеДт = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].ПодразделениеДт, Справочники.Подразделения.ПустаяСсылка());
			КПСДт = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].КПСДт, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
			
			ДополнительнаяАналитикаСчета = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].ДополнительнаяАналитикаСчета, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			ПричинаСписания = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].ПричинаСписания, "");
			
			СчетДт = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СчетДт, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
			СубконтоДт1 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоДт1, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			СубконтоДт2 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоДт2, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			СубконтоДт3 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоДт3, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			
			СчетНУ = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СчетНУ, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
			СубконтоНУ1 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоНУ1, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			СубконтоНУ2 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоНУ2, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			СубконтоНУ3 = ?(НастройкиСписанияГСМПоУмолчанию.Количество()>0, НастройкиСписанияГСМПоУмолчанию[0].СубконтоНУ3, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			
			НоваяСтрока = Объект.Материалы.Добавить();
			
			НоваяСтрока.ИФО = ИФО;
			НоваяСтрока.Подразделение = ?(УчетПоПодразделениямДляСчетовУчета, Подразделение, Справочники.Подразделения.ПустаяСсылка());
			
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.СчетУчета = СчетУчетаНоменклатуры;
			НоваяСтрока.КФО = КФО;
			НоваяСтрока.КПС = КПС;
			НоваяСтрока.ЦМО = ЦМО;
			НоваяСтрока.ДополнительнаяАналитикаСчета = ДополнительнаяАналитикаСчета;
			
			НоваяСтрока.СчетДт = СчетДт;
			НоваяСтрока.СубконтоДт1 = СубконтоДт1;
			НоваяСтрока.СубконтоДт2 = СубконтоДт2;
			НоваяСтрока.СубконтоДт3 = СубконтоДт3;
			
			НоваяСтрока.ПодразделениеДт = ПодразделениеДт;
			НоваяСтрока.КПСДт = КПСДт;
			
			НоваяСтрока.СчетНУ = СчетНУ;
			НоваяСтрока.СубконтоНУ1 = СубконтоНУ1;
			НоваяСтрока.СубконтоНУ2 = СубконтоНУ2;
			НоваяСтрока.СубконтоНУ3 = СубконтоНУ3;
			
			НоваяСтрока.Количество = СписатьКоличество;
			НоваяСтрока.КоличествоНорма = НормаРасхода;
			
			НоваяСтрока.ПричинаСписания = ПричинаСписания;
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			
		КонецЕсли;	
	КонецЦикла;	
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтаФорма, Объект);
	ЗаполнитьДобавленныеКолонкиТаблиц();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастройкаДоступностиЭлементов(Форма, Объект)

	ЭтоПроведенныйДокумент = Объект.Проведен;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ВидТаксировки", "ТолькоПросмотр", ЭтоПроведенныйДокумент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ЗаполнитьНастройкиРасчетаГСМДляТС", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьНормативныйРасходГСМ", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьСводныйРасходГСМ", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыЗаполнитьСписываемыеМатериалыГСМ", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыПодборНоменклатуры", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыУстановитьНаправлениеРасхода", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ТаксировкиРабочихЛистовЗаполнитьСписокДокументовТаксировки", "Доступность", НЕ ЭтоПроведенныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьФактическийРасходаСМ", "Доступность", НЕ ЭтоПроведенныйДокумент);
	
КонецПроцедуры	

