&НаКлиенте
Процедура ФактическийРасходГСМПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ФактическийРасходГСМЗаправки" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуДанныхОЗаправках(ВыбраннаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПриАктивизацииЯчейки(Элемент)
	Если Элементы.ФактическийРасходГСМ.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ФактическийРасходГСМ.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ФактическийРасходГСМЗаправки"
			И НЕ Элементы.ФактическийРасходГСМ.ТекущиеДанные.ЗаправкиЗаполнены Тогда
			ВыбраннаяСтрока = Элементы.ФактическийРасходГСМ.ТекущаяСтрока;
			ОткрытьФормуДанныхОЗаправках(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("ВидГСМ", Элемент.ТекущиеДанные.ВидГСМ); 	
	//удаление заправок
	МассивКУдалению = Объект.ЗаправкиГСМ.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.ЗаправкиГСМ.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ЭтоНоваяСтрока = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ФактическийРасходГСМ.ТекущиеДанные;
		ОбновитьТекстЗаголовковВСтрокеТаблицыФактическийРасход(ТекущиеДанные);
		ОбновитьТекстДанныеОЗаправкеСтрокиТаблицыФактическийРасход(ЭтаФорма, ТекущиеДанные); 
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаксировкиРабочихЛистов

&НаКлиенте
Процедура ТаксировкиРабочихЛистовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекущиеДанные = Элементы.ТаксировкиРабочихЛистов.ТекущиеДанные;
	ОбновитьТекстЗаголовковВСтрокеТаблицыТаксировкиНаКлиенте(ТекущиеДанные);	
КонецПроцедуры

&НаКлиенте
Процедура ТаксировкиРабочихЛистовТаксировкаРабочегоЛистаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	МассивОтбора = Новый Массив;
	МассивОтбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата"));
	МассивОтбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста"));
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ВидТаксировки", МассивОтбора));
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Документ.ТаксировкаРабочегоЛистаАгрегата.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

