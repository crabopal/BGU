	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ВидГСМ", ТекущаяСтрока.ВидГСМ);
	ПараметрыФормы.Вставить("ВидОбъектаРасходаГСМ", ПредопределенноеЗначение("Перечисление.ВидыОбъектовРасходаГСМ.Агрегаты"));

	ОткрытьФорму("Справочник.ПоправочныеКоэффициентыРасчетаНормГСМ.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПоправочныеКоэффициентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.ДанныеРежимаРаботы.ТекущиеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбран режим работы, для которого добавляется поправочный коэффициент расхода ГСМ.'");
		Сообщение.Сообщить();
		
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

