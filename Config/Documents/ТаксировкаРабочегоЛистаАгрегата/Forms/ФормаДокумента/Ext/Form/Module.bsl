КонецПРоцедуры	

&НаСервере
Процедура ПоказатьКоличествоВремени()
	Для Каждого Строка Из Объект.ДанныеРежимаРаботы Цикл
		Строка.ПродолжительностьРаботыСтр = УчетВремениКлиентСервер.ЧислоВСтроку(Строка.ПродолжительностьРаботы);
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Процедура УстановитьРеквизитыИзУчетногоЛиста()
	
	Если ЗначениеЗаполнено(Объект.РабочийЛистАгрегата) Тогда
		Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда
			УстановитьРеквизитыИзУчетногоЛистаТракториста();
		ИначеЕсли Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата") Тогда	
			УстановитьРеквизитыИзРабочегоЛистаАгрегата();
		КонецЕсли;
		
		УстановитьДанныеАгрегата();
	Иначе
		Объект.Агрегат = Справочники.ОсновныеСредства.ПустаяСсылка();
		Объект.МОЛ = Справочники.Сотрудники.ПустаяСсылка();
		Объект.НомерРабочегоЛистаАгрегата = "";
		Объект.ДатаРабочегоЛистаАгрегата = Дата(1,1,1);
		Объект.МаркаДвигателяАгрегата = "";
		Объект.НомерДвигателяАгрегата = "";
		Объект.ГаражныйНомер = "";
		Объект.РегистрационныйНомернойЗнак = "";
		
		Элементы.ДекорацияМаркаНомерДвигателя.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыИзРабочегоЛистаАгрегата()
	ПоследнееЗначениеОрганизации = Объект.Организация;
	
	ДокументОснование = Объект.РабочийЛистАгрегата;
	
	ЗаполняемыеДанные = "Организация, Агрегат, МОЛ, Подразделение";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ПоследнееЗначениеОрганизации;
	КонецЕсли;
	
	Объект.ДатаРабочегоЛистаАгрегата = ДокументОснование.Дата;
	Объект.НомерРабочегоЛистаАгрегата = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование.Ссылка,ДокументОснование.Номер);
	
	Объект.МаркаДвигателяАгрегата = ДокументОснование.МаркаДвигателяАгрегата;
	Объект.НомерДвигателяАгрегата = ДокументОснование.НомерДвигателяАгрегата;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ДатаРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.НаименованиеРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПродолжительностьРаботы КАК ПродолжительностьРаботы,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.КоличествоОбработанныхМЦ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаНачало,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаКонец,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчика,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ВидГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПолученоМЗ КАК ПолученоГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ИзрасходованоМЗ КАК ФактическийРасходГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ВидГСМ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Оператор
	|ИЗ
	|	Документ.РабочийЛистАгрегата.РезультатыРаботыАгрегата КАК РабочийЛистАгрегатаРезультатыРаботыАгрегата
	|ГДЕ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Ссылка = &РабочийЛист";	
	
	Запрос.УстановитьПараметр("РабочийЛист", ДокументОснование);
	
	Объект.ДанныеРежимаРаботы.Очистить();
	Объект.ДанныеРежимаРаботы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для каждого ТекСтрока Из Объект.ДанныеРежимаРаботы Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЦикла	
	
КонецПроцедуры

