&НаКлиенте
Процедура АгрегатНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТолькоАгрегаты = Истина;
	Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда
		ТолькоАгрегаты = Ложь;
	КонецЕсли;	
	
	Отбор = Новый Структура("Организация", Объект.Организация);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, РежимВыбора, ЗакрыватьПриВыборе, МножественныйВыбор, ТолькоАгрегаты, ТекущаяСтрока",
		Отбор, Истина, Истина, Истина, Ложь, ТолькоАгрегаты, Объект.Агрегат);
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаВыбораТранспортногоСредства", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура АгрегатИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ЗначениеВидаОбъектаРасходаГСМ = "Агрегат";
	
	Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда
		ЗначениеВидаОбъектаРасходаГСМ = "ТранспортноеСредство";
	КонецЕсли;	
	
	НовыйПараметр = Новый ПараметрВыбора("ВидОбъектаРасходаГСМ", ЗначениеВидаОбъектаРасходаГСМ);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.Агрегат.ПараметрыВыбора = НовыеПараметры;
