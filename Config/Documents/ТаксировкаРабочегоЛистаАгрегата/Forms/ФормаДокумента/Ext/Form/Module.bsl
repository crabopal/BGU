	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена И ВыбранноеЗначение <> Неопределено Тогда
		СтруктураДанных = ПолучитьДанныеНоменклатуры(ВыбранноеЗначение);
		ТекущиеДанные = Элементы.ДанныеРежимаРаботы.ТекущиеДанные;   
		
		ВыбранноеЗначение = СтруктураДанных.НаименованиеПолное;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеРежимаРаботыПриАктивизацииЯчейки(Элемент)
	Если Элементы.ДанныеРежимаРаботы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ДанныеРежимаРаботы.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ПоказателиРасчета"
			И НЕ Элементы.ДанныеРежимаРаботы.ТекущиеДанные.ПоказателиРасчетаЗаполнены Тогда
			ВыбраннаяСтрока = Элементы.ДанныеРежимаРаботы.ТекущаяСтрока;
			ОткрытьФормуВводаПоказателейРасчета(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

