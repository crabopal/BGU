	Для Каждого ТекущаяСтрока Из Объект.ТаксировкиРабочихЛистов Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыТаксировки(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыАктыОСписании()
	Если Объект.АналитикаАктовОСписании.Количество() > 0 Тогда
		ПараметрыАналитикиАктов = Объект.АналитикаАктовОСписании.Выгрузить();
		ПараметрыАналитикиАктов.Свернуть("ИФО, ЦМО, Подразделение");
		ЗаполнитьДанныеОбАктахОСписанииМЗ(ПараметрыАналитикиАктов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбАктахОСписанииМЗ(АналитикаАктов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.ИФО КАК ИФО,
	               |	Таб.Подразделение КАК Подразделение,
	               |	Таб.ЦМО КАК ЦМО
	               |ПОМЕСТИТЬ ВТДанные
	               |ИЗ
	               |	&Данные КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АктСписанияМЗ.Ссылка КАК Ссылка,
	               |	АктСписанияМЗ.ИФО КАК ИФО,
	               |	АктСписанияМЗ.ПодразделениеОтправитель КАК Подразделение,
	               |	АктСписанияМЗ.ЦМООтправитель КАК ЦМО
	               |ПОМЕСТИТЬ АктыТаксировки
	               |ИЗ
	               |	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	               |ГДЕ
	               |	АктСписанияМЗ.ДокументОснование = &ДокументОснование
	               |	И АктСписанияМЗ.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДанные.ИФО КАК ИФО,
	               |	ВТДанные.Подразделение КАК Подразделение,
	               |	ВТДанные.ЦМО КАК ЦМО,
	               |	АктыТаксировки.Ссылка КАК АктОСписанииМЗ,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(АктыТаксировки.Ссылка, 0) = 0
	               |			ТОГДА ""Создать новый акт""
	               |		ИНАЧЕ АктыТаксировки.Ссылка
	               |	КОНЕЦ КАК АктОСписанииМЗИнфо
	               |ИЗ
	               |	ВТДанные КАК ВТДанные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ АктыТаксировки КАК АктыТаксировки
	               |		ПО ВТДанные.ИФО = АктыТаксировки.ИФО
	               |			И ВТДанные.Подразделение = АктыТаксировки.Подразделение
	               |			И ВТДанные.ЦМО = АктыТаксировки.ЦМО";
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Запрос.УстановитьПараметр("Данные", АналитикаАктов);
	ДанныеАктов = Запрос.Выполнить().Выгрузить();
	
	АктыОСписанииМЗ.Загрузить(ДанныеАктов);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыТаксировки(ТекущаяСтрока)

	ДанныеТаксировки = ПолучитьДанныеТаксировкиУчетногоЛистаАгрегата(ТекущаяСтрока.ТаксировкаРабочегоЛиста);
	
	ТекущаяСтрока.РабочийЛистТаксировки = ДанныеТаксировки.НаименованиеДокумента;
	ТекущаяСтрока.ЕстьОперацияТаксировки = ДанныеТаксировки.НомерКартинки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыТаксировкиНаКлиенте(ТекущаяСтрока)

	ДанныеТаксировки = ПолучитьДанныеТаксировкиУчетногоЛистаАгрегата(ТекущаяСтрока.ТаксировкаРабочегоЛиста);
	
	ТекущаяСтрока.РабочийЛистТаксировки = ДанныеТаксировки.НаименованиеДокумента;
	ТекущаяСтрока.ЕстьОперацияТаксировки = ДанныеТаксировки.НомерКартинки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаПоказателейРасчета(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ДанныеРежимаРаботы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ДатаРабот, ИдентификаторФормулыРасчета, ПродолжительностьРаботы, ПродолжительностьРаботыСтр, КоличествоОбработанныхМЦ,
		|ПоказанияСчетчикаНаНачало, ПоказанияСчетчикаНаКонец, ПоказанияСчетчика, ЕдиницаИзмеренияРаботы");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыФормы.ЕдиницаИзмеренияРаботы) Тогда
		ПараметрыФормы.ЕдиницаИзмеренияРаботы = ЕдиницаИзмеренияРаботы;
	КонецЕсли;
	
	Если ПараметрыФормы.ПродолжительностьРаботы > 0 Тогда
		ПараметрыФормы.ИдентификаторФормулыРасчета = 1;	
	ИначеЕсли ПараметрыФормы.КоличествоОбработанныхМЦ > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 2;	
	ИначеЕсли ПараметрыФормы.ПоказанияСчетчика > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
	Иначе
		Если ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПродолжительностьРаботы") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 1;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.КоличествоОбработанныхМЦ") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 2;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПоказанияСчетчика") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
		КонецЕсли;			
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВводаПоказателейРасчетаДляАгрегата", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыРежимов()
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");
	Для Каждого СтрокаТаблицы Из Объект.ДанныеРежимаРаботы Цикл
		ЗаполнитьДобавленныеКолонкиПоказателиРасчета(СтрокаТаблицы, ПоляФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ДанныеСтроки, ПоляФормы=Неопределено) Экспорт
	ПоказателиРасчетаТекст = НСтр("ru='Ввести данные о работе агрегата'");
	ПоказателиРасчетаЗаполнены = Ложь;
	
	Идентификатор = 0;
	Если ДанныеСтроки[ПоляФормы.Время]>0 Тогда
		Идентификатор = 1;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Количество]>0 Тогда         
		Идентификатор = 2;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Счетчик]>0 Тогда
		Идентификатор = 3;
	КонецЕсли;	
	
	Если Идентификатор = 1 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Продолжительность работы: %1'"),
		УчетВремениКлиентСервер.ЧислоВСтроку(ДанныеСтроки[ПоляФормы.Время]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 2 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объем работы: %1 %2'"),
		Формат(ДанныеСтроки[ПоляФормы.Количество], "ЧЦ=17; ЧДЦ=2; ЧН=-"), Строка(ДанныеСтроки[ПоляФормы.ЕдиницаИзмеренияРаботы]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 3 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Показания счетчика: %1'"),
		Формат(ДанныеСтроки[ПоляФормы.Счетчик], "ЧЦ=17; ЧН=-"));
		ПоказателиРасчетаЗаполнены = Истина;
	КонецЕсли;	
	
	ДанныеСтроки.ПоказателиРасчета          = ПоказателиРасчетаТекст;
	ДанныеСтроки.ПоказателиРасчетаЗаполнены = ПоказателиРасчетаЗаполнены;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПоказателейРасчетаНаКлиенте(СтруктураПоказателейРасчета)
	ТекущиеДанные = Элементы.ДанныеРежимаРаботы.ТекущиеДанные;
	ТекущиеДанные.ПродолжительностьРаботы = 0;
	ТекущиеДанные.КоличествоОбработанныхМЦ = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаНачало = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаКонец = 0;
	ТекущиеДанные.ПоказанияСчетчика = 0;
	
	ИдентификаторФормулыРасчета = СтруктураПоказателейРасчета.ИдентификаторФормулыРасчета;
	ТекущиеДанные.ИдентификаторФормулыРасчета = ИдентификаторФормулыРасчета;
	
	Если ИдентификаторФормулыРасчета = 1 Тогда
		Если СтруктураПоказателейРасчета.ПродолжительностьРаботы = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПродолжительностьРаботы = СтруктураПоказателейРасчета.ПродолжительностьРаботы;
			ТекущиеДанные.ПродолжительностьРаботыСтр = СтруктураПоказателейРасчета.ПродолжительностьРаботыСтр;
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 2 Тогда
		Если СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.КоличествоОбработанныхМЦ = СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ;
			ТекущиеДанные.ЕдиницаИзмеренияРаботы = СтруктураПоказателейРасчета.ЕдиницаИзмеренияРаботы;
			
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 3 Тогда
		Если СтруктураПоказателейРасчета.ПоказанияСчетчика = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПоказанияСчетчикаНаНачало = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаНачало;
			ТекущиеДанные.ПоказанияСчетчикаНаКонец = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаКонец;
			ТекущиеДанные.ПоказанияСчетчика = СтруктураПоказателейРасчета.ПоказанияСчетчика;
		КонецЕсли;
	КонецЕсли;	
	
	ТекущиеДанные.ЕдиницаИзмеренияРаботы = СтруктураПоказателейРасчета.ЕдиницаИзмеренияРаботы;
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");

	ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ТекущиеДанные, ПоляФормы);
		 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДанныеЗаправокДляВидаГСМ(Форма, ВидГСМ, ЕдиницаИзмерения)
	Объект = Форма.Объект;
	
	Результат = Истина;
	ПараметрыОтбораЗаправок = Новый Структура;
	ПараметрыОтбораЗаправок.Вставить("ВидГСМ", ВидГСМ);
	НайденныеСтроки = Объект.ЗаправкиГСМ.НайтиСтроки(ПараметрыОтбораЗаправок);
	ИтогКоличество = 0;
	ИтогСумма = 0;
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ИтогКоличество = ИтогКоличество + ТекСтрока.Количество;
		ИтогСумма = ИтогСумма + ТекСтрока.Сумма;
	КонецЦикла;	
	
	ТекстЗаправок = Формат(ИтогКоличество, "ЧЦ=17; ЧДЦ=3; ЧН=0")+" "+Строка(ЕдиницаИзмерения)+", "+Формат(ИтогСумма, "ЧЦ=17; ЧДЦ=2; ЧН=0")+" "+Строка(Форма.ВалютаРубли);
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстЗаправок", ТекстЗаправок);
	Результат.Вставить("ЕстьЗаправки", ?(НайденныеСтроки.Количество()=0, Ложь, Истина));
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ОткрытьФормуДанныхОЗаправках(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ФактическийРасходГСМ.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ВидГСМ) Тогда
		ИмяСписка = НСтр("ru = 'Движение горючего и расчет фактического расхода ГСМ'");
		Префикс = "Объект.ФактическийРасходГСМ[" + Формат(ВыбранноеЗначение, "ЧН=0; ЧГ=") + "].";
		
		Поле = Префикс + "ВидГСМ";
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид ГСМ'"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Поле, ,);
		
		Возврат;
	КонецЕсли;	
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыОтбораЗаправок = Новый Структура;
	ПараметрыОтбораЗаправок.Вставить("ВидГСМ", ДанныеСтроки.ВидГСМ);
	
	АдресДанныхЗаправкиВХранилище = ПоместитьТаблицуЗаправкиГСМВХранилище(ПараметрыОтбораЗаправок);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("МОЛ", Объект.МОЛ);
	ПараметрыФормы.Вставить("ДатаЛистаУчета", Объект.ДатаРабочегоЛистаАгрегата);
	ПараметрыФормы.Вставить("ВидГСМ", ДанныеСтроки.ВидГСМ);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", ДанныеСтроки.ЕдиницаИзмерения);
	ПараметрыФормы.Вставить("ВсегоВыданоЗаправлено", ДанныеСтроки.ВыданоГорючее);
	ПараметрыФормы.Вставить("АдресДанныхЗаправкиВХранилище", АдресДанныхЗаправкиВХранилище);
	
	ОткрытьФорму("Обработка.ДанныеОЗаправкахГСМ.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуЗаправкиГСМВХранилище(ПараметрыОтбораЗаправок)
	
	ДанныеОВсехЗаправках = Объект.ЗаправкиГСМ.Выгрузить();
	
	СтрокиТаблицыЗаправкиГСМ = ДанныеОВсехЗаправках.НайтиСтроки(ПараметрыОтбораЗаправок); 
	
	Возврат ПоместитьВоВременноеХранилище(СтрокиТаблицыЗаправкиГСМ);

КонецФункции

&НаСервере
Процедура ОбработкаДобавленияДанныхЗаправкиНаСервере(Знач ВыбранноеЗначение)
	
	УчетГСМ.ОбработатьДобавлениеЗакупокДляВидаГСМ(Объект.ЗаправкиГСМ, ВыбранноеЗначение);
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение.ВидГСМ) Тогда
		ОбщееКоличествоГСМ = ВыбранноеЗначение.ОбщееКоличествоГСМ;
		
		СтруктураПоискаГСМ = Новый Структура("ВидГСМ");
		СтруктураПоискаГСМ.ВидГСМ = ВыбранноеЗначение.ВидГСМ;
		
		СтрокиИсходныхДанных = Объект.ФактическийРасходГСМ.НайтиСтроки(СтруктураПоискаГСМ);
		Для Каждого	ТекСтрока Из СтрокиИсходныхДанных Цикл
			Если ТекСтрока.ВыданоГорючее = 0 Тогда
				ТекСтрока.ВыданоГорючее = ОбщееКоличествоГСМ;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ЭтоСводныйРасчет = ?(Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам"), Истина, Ложь);
	ЭтоРасчетДляАгрегата = ?(Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата"), Истина, Ложь);
	ЭтоРасчетДляТС = ?(Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста"), Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаДанныеРабочегоЛиста", "Видимость", НЕ ЭтоСводныйРасчет);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаСтраницаИсходныеДанныеРасчета", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ФактическийРасходГСМОстатокГорючегоПриВыезде", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ФактическийРасходГСМОстатокГорючегоПриВозвращении", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьНормативныйРасходГСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаТаксировкиРабочихЛистов", "Видимость", ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьСводныйРасходГСМ", "Видимость", ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаУправлениеРасчетФактическогоРасходаГСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьФактическийРасходаСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РезультатРасходГСМОстатокГорючегоПриВозвращении", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыЗаголовокПодразделение", "Видимость", Форма.УчетПоПодразделениямДляСчетовУчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыПодразделение", "Видимость", Форма.УчетПоПодразделениямДляСчетовУчета);
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МаркаДвигателяАгрегата", "Видимость", ЭтоРасчетДляАгрегата);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"НомерДвигателяАгрегата", "Видимость", ЭтоРасчетДляАгрегата);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РегистрационныйНомернойЗнак", "Видимость", ЭтоРасчетДляТС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГаражныйНомер", "Видимость", ЭтоРасчетДляТС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"Подразделение", "Видимость", НЕ Форма.УчетПоПодразделениямДляСчетовУчета);
	
	ЭтоАктОСписании0510460 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "АктОСписанииМЗ0510460_157н");
	ОдинАктОСписании = Объект.ОдинАктОСписании;

	// Элементы только акта списания 0510460
	Элементы61н = Новый Массив;
	Элементы61н.Добавить("НадписьГолосование");
	Элементы61н.Добавить("Сотрудник");
	Элементы61н.Добавить("СохранитьРезультатыГолосования");
	Элементы61н.Добавить("НадписьФайл");
	Элементы61н.Добавить("МатериалыПричинаСписанияСсылка");
	Элементы61н.Добавить("МатериалыУстановитьПричинуСписания");
	Элементы61н.Добавить("МатериалыГруппаПроцентГолосовЗа");
	Элементы61н.Добавить("МатериалыПодменюУстановитьРешение");
	Элементы61н.Добавить("МатериалыПодменюУстановитьРешениеЕдиногласно");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы61н,
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФайлСотрудника",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУдалитьФайл",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьФайлНеВыбран",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И Не ЗначениеЗаполнено(Форма.ФайлСотрудника));
	
	НесколькоАктов = Объект.АналитикаАктовОСписании.Количество() > 0;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаАктыОСписании",
		"Видимость", ЭтоАктОСписании0510460 И НесколькоАктов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Комиссия", "Видимость", ЭтоАктОСписании0510460);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаИндикаторКворумаПрисутствия", "Видимость", ЭтоАктОСписании0510460);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СоставКомиссии1", "Видимость", ЭтоАктОСписании0510460);
	
	
	// Элементы акта списания 0504230
	Элементы52н = Новый Массив;
	Элементы52н.Добавить("СоставКомиссии");
	Элементы52н.Добавить("НомерПриказа");
	Элементы52н.Добавить("ДатаПриказа");
	Элементы52н.Добавить("ДекорацияВыбратьКомиссию");
	Элементы52н.Добавить("ДолжностьПредседательКомиссии");
	Элементы52н.Добавить("ФамилияПредседательКомиссии");
	Элементы52н.Добавить("ИмяПредседательКомиссии");
	Элементы52н.Добавить("ОтчествоПредседательКомиссии");
	Элементы52н.Добавить("ВыбратьПредседателяКомиссии");
	Элементы52н.Добавить("ЗаключениеКомиссии");
	Элементы52н.Добавить("МатериалыПричинаСписания");
	Элементы52н.Добавить("МатериалыУстановитьНаправлениеРасхода");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы52н,
		"Видимость", Не ЭтоАктОСписании0510460);
	
КонецПроцедуры	

&НаСервере
Функция ТаблицаЗначенийОбъединенияРасходаГСМ(МассивТаксировок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ВидГСМ,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ЕдиницаИзмерения,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ОстатокГорючегоПриВыезде,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ВыданоГорючее,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ОстатокГорючегоПриВозвращении,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.ФактическийРасходГорючего,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.НормативныйРасходГорючего,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.Экономия,
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.Перерасход
	               |ИЗ
	               |	Документ.ТаксировкаРабочегоЛистаАгрегата.ФактическийРасходГСМ КАК ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ
	               |ГДЕ
	               |	ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.Ссылка В(&МассивТаксировок)";
				   
	Запрос.УстановитьПараметр("МассивТаксировок", МассивТаксировок);
	ТаблицаРасходаГСМ = Запрос.Выполнить().Выгрузить();
	ТаблицаРасходаГСМ.Свернуть("ВидГСМ", "ОстатокГорючегоПриВыезде, ВыданоГорючее, ВыданоГорючее, 
								|ОстатокГорючегоПриВозвращении, ФактическийРасходГорючего, НормативныйРасходГорючего, Экономия, Перерасход");
	
	Возврат ТаблицаРасходаГСМ;
КонецФункции

&НаСервере
Функция ТаблицаЗначенийОбъединенияЗаправокГСМ(МассивТаксировок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ДатаЗаправки,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.НомерДокументаОснования,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ВидГСМ,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ЕдиницаИзмерения,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.Количество,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.Сумма,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ТопливнаяКарта,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.СерияТопливнойКарты,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.НомерТопливнойКарты,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ТалонНаТопливо,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.КоличествоТалонов,
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.Контрагент
	               |ИЗ
	               |	Документ.ТаксировкаРабочегоЛистаАгрегата.ЗаправкиГСМ КАК ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ
	               |ГДЕ
	               |	ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.Ссылка В(&МассивТаксировок)
	               |	И НЕ ТаксировкаРабочегоЛистаАгрегатаЗаправкиГСМ.ВидГСМ В (&НеЗаполненВидГСМ)";
				   
	Запрос.УстановитьПараметр("МассивТаксировок", МассивТаксировок);
	Запрос.УстановитьПараметр("НеЗаполненВидГСМ", Справочники.ВидыГСМ.ПустаяСсылка());
	ТаблицаЗаправокГСМ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаЗаправокГСМ;
КонецФункции

&НаСервере
Функция ПровестиУточняющийРасчетФактическогоРасходаСМ()
	
	ДатаРасчета = Объект.ДатаРабочегоЛистаАгрегата;
	
	//Расчет общего количества расхода по нормам для СМ
	ТаблицаНормативныйРасход = Объект.ФактическийРасходГСМ.Выгрузить(,"ВидГСМ, НормативныйРасходГорючего, ФактическийРасходГорючего");
	ТаблицаНормативныйРасход.Свернуть("ВидГСМ","НормативныйРасходГорючего, ФактическийРасходГорючего");
	
	ТаблицаГорючее = Новый ТаблицаЗначений;
	ТаблицаГорючее.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	ТаблицаГорючее.Колонки.Добавить("НормативныйРасходГорючего",  Новый ОписаниеТипов("Число"));
	ТаблицаГорючее.Колонки.Добавить("ФактическийРасходГорючего",  Новый ОписаниеТипов("Число"));
	
	ТаблицаСМ = Новый ТаблицаЗначений;
	ТаблицаСМ.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	ТаблицаСМ.Колонки.Добавить("ФактическийРасходГорючего",  Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ТаблицаНормативныйРасход Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее) Тогда
			НоваяСтрока = ТаблицаГорючее.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого ТекСтрока Из Объект.ДанныеРежимаРаботы Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее) Тогда
			СтруктураПоискаГСМ = Новый Структура("ВидГСМ");
			СтруктураПоискаГСМ.ВидГСМ = ТекСтрока.ВидГСМ;
			
			СтрокиИсходныхДанных = ТаблицаГорючее.НайтиСтроки(СтруктураПоискаГСМ);
			Для Каждого	ТекГСМ Из СтрокиИсходныхДанных Цикл
				НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ТекСтрока.ВидГСМ, ДатаРасчета);
				Если ТекГСМ.НормативныйРасходГорючего = 0 Тогда
					ЗначениеФактическогоРасходаТоплива = 0;
				Иначе	
					ЗначениеФактическогоРасходаТоплива = Окр(ТекГСМ.ФактическийРасходГорючего * (ТекСтрока.НормативРасходаГСМ/ТекГСМ.НормативныйРасходГорючего),
															НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
				КонецЕсли;											
				//расчет для каждого СМ из НормативныйРасходСМ
				СтруктураПоискаНормСМ = Новый Структура("ВидГСМ, КлючСтроки");
				СтруктураПоискаНормСМ.ВидГСМ = ТекСтрока.ВидГСМ;
				СтруктураПоискаНормСМ.КлючСтроки = ТекСтрока.КлючСтроки;
				
				СтрокиИсходныхДанныхНормСМ = Объект.НормативныйРасходСМ.НайтиСтроки(СтруктураПоискаНормСМ);
				Для Каждого	ТекСМ Из СтрокиИсходныхДанныхНормСМ Цикл
					ФормулаДляРасчетаФактаСМ = ТекСМ.РасшифровкаРасчетаСМФакт;
					
					ТекстФормулы = СтрЗаменить(ФормулаДляРасчетаФактаСМ,"ЗначениеРасходаГСМ",ЗначениеФактическогоРасходаТоплива);
						
					НастройкиОкругленияСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ТекСМ.ВидСМ, ДатаРасчета);
					
					ФактическийРасходСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияСМ.РежимОкругления);
					
					НоваяСтрока = ТаблицаСМ.Добавить();
					НоваяСтрока.ВидГСМ = ТекСМ.ВидСМ;
					НоваяСтрока.ФактическийРасходГорючего = ФактическийРасходСМ;
					Прервать;
				КонецЦикла;
				
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;		
	
	ТаблицаСМ.Свернуть("ВидГСМ", "ФактическийРасходГорючего");
	
	//Уточняющий расчет фактического расхода СМ
	Для Каждого ТекСтрока Из Объект.ФактическийРасходГСМ Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СмазочныеМатериалы) ИЛИ  
			(ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СпециальныеЖидкости) Тогда
			СтруктураПоискаНормСМ = Новый Структура("ВидГСМ");
			СтруктураПоискаНормСМ.ВидГСМ = ТекСтрока.ВидГСМ;
			
			СтрокиИсходныхДанныхНормСМ = ТаблицаСМ.НайтиСтроки(СтруктураПоискаНормСМ);
			Для Каждого	ТекСМ Из СтрокиИсходныхДанныхНормСМ Цикл
				ТекСтрока.ФактическийРасходГорючего = ТекСМ.ФактическийРасходГорючего;
				РезультатРасчета = ТекСтрока.ФактическийРасходГорючего - ТекСтрока.НормативныйРасходГорючего;
				Если РезультатРасчета > 0 Тогда
					ТекСтрока.Перерасход = РезультатРасчета;
					ТекСтрока.Экономия = 0;
				Иначе
					ТекСтрока.Перерасход = 0;
					ТекСтрока.Экономия = (-1)*РезультатРасчета;
				КонецЕсли;	
				Если (ТекСтрока.ОстатокГорючегоПриВыезде + ТекСтрока.ВыданоГорючее)>0 Тогда
					ТекСтрока.ОстатокГорючегоПриВозвращении = ТекСтрока.ОстатокГорючегоПриВыезде + ТекСтрока.ВыданоГорючее - ТекСтрока.ФактическийРасходГорючего;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокДокументовТаксировкиНаСервере()
	Если Объект.ТаксировкиРабочихЛистов.Количество()>0 Тогда
	 	Объект.ТаксировкиРабочихЛистов.Очистить();
	КонецЕсли;
	
	МассивОтбораВидовТаксировки = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ВидТаксировкиОтбор) Тогда
		МассивОтбораВидовТаксировки.Добавить(Объект.ВидТаксировкиОтбор);
	Иначе
		МассивОтбораВидовТаксировки.Добавить(Перечисления.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата);
		МассивОтбораВидовТаксировки.Добавить(Перечисления.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ОперацииДокументов.Операция ЕСТЬ NULL
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
	               |			ТОГДА 0
	               |		КОГДА НЕ ОперацииДокументов.Операция ЕСТЬ NULL
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК ЕстьОперация,
	               |	ТаксировкаРабочегоЛистаАгрегата.Ссылка КАК Ссылка,
	               |	ТаксировкаРабочегоЛистаАгрегата.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ТаксировкаРабочегоЛистаАгрегата КАК ТаксировкаРабочегоЛистаАгрегата
	               |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО ТаксировкаРабочегоЛистаАгрегата.Ссылка = ОперацииДокументов.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |		ПО ТаксировкаРабочегоЛистаАгрегата.Ссылка = ЖурналПроводокЕПСБУ.Регистратор
	               |			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)}
	               |ГДЕ
	               |	ТаксировкаРабочегоЛистаАгрегата.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаКонцаПериода
	               |	И ТаксировкаРабочегоЛистаАгрегата.ВидТаксировки В(&ВидТаксировки)
	               |	И ТаксировкаРабочегоЛистаАгрегата.ПометкаУдаления = ЛОЖЬ
	               |	И &ОтборПоАгрегату = ЛОЖЬ
	               |	И &ОтборПоМОЛ = ЛОЖЬ
	               |	И &ОтборПоПодразделению = ЛОЖЬ
	               |	И ТаксировкаРабочегоЛистаАгрегата.Организация = &Организация";
				   
				   
	Если ЗначениеЗаполнено(Объект.Агрегат) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоАгрегату = ЛОЖЬ", "ТаксировкаРабочегоЛистаАгрегата.Агрегат = &Агрегат");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.МОЛ) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоМОЛ = ЛОЖЬ", "ТаксировкаРабочегоЛистаАгрегата.МОЛ = &МОЛ");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоПодразделению = ЛОЖЬ", "ТаксировкаРабочегоЛистаАгрегата.Подразделение = &Подразделение");
	КонецЕсли;
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоДня(Объект.ДатаНачалаПериода));			   
	Запрос.УстановитьПараметр("ДатаКонцаПериода", КонецДня(Объект.ДатаКонцаПериода));			   
	Запрос.УстановитьПараметр("ВидТаксировки", МассивОтбораВидовТаксировки);
	Запрос.УстановитьПараметр("ОтборПоАгрегату", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("ОтборПоМОЛ", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("ОтборПоПодразделению", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("Агрегат", Объект.Агрегат);			   
	Запрос.УстановитьПараметр("МОЛ", Объект.МОЛ);	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Проведен Тогда
			НоваяСтрока = Объект.ТаксировкиРабочихЛистов.Добавить();
			НоваяСтрока.ТаксировкаРабочегоЛиста = Выборка.Ссылка;
			Если Выборка.ЕстьОперация = 2 Тогда
				ТекстОшибки = НСтр("ru='У документа ""%1"" уже есть операция списания ГСМ!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.Ссылка);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,"ТаксировкиРабочихЛистов");
			КонецЕсли;	
		Иначе
			ТекстОшибки = НСтр("ru='Документ ""%1"" не проведен и не включен в список таксировок для расчета общего расхода ГСМ!'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.Ссылка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,"ТаксировкиРабочихЛистов");
		КонецЕсли;
	КонецЦикла;	
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыТаксировки();
КонецПроцедуры

&НаСервере
Процедура РассчитатьСводныйРасходГСМНаСервере()
	
	МассивТаксировок = Новый Массив;
	
	Для Каждого ТекСтрока Из Объект.ТаксировкиРабочихЛистов Цикл
		МассивТаксировок.Добавить(ТекСтрока.ТаксировкаРабочегоЛиста);
	КонецЦикла;	
	
	ОбъединенныеДанные = ТаблицаЗначенийОбъединенияРасходаГСМ(МассивТаксировок);
	
	Объект.ФактическийРасходГСМ.Очистить();
	Для Каждого ТекСтрока Из ОбъединенныеДанные Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
		Если ТекСтрока.НормативныйРасходГорючего > ТекСтрока.ФактическийРасходГорючего Тогда
			НоваяСтрока.Экономия = ТекСтрока.НормативныйРасходГорючего - ТекСтрока.ФактическийРасходГорючего;
			НоваяСтрока.Перерасход = 0;
		Иначе
			НоваяСтрока.Перерасход = ТекСтрока.ФактическийРасходГорючего - ТекСтрока.НормативныйРасходГорючего;
			НоваяСтрока.Экономия = 0;
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъединенныеЗаправки = ТаблицаЗначенийОбъединенияЗаправокГСМ(МассивТаксировок);
	
	Объект.ЗаправкиГСМ.Очистить();
	Для Каждого ТекСтрока Из ОбъединенныеЗаправки Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ВидГСМ) Тогда
			НоваяСтрока = Объект.ЗаправкиГСМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереименованиеЭлементовФормыПоВидуТаксировки(Форма, Объект)
	Если Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата") Тогда
		Форма.Элементы.ДекорацияЗаголовокМаркаНомерДвигателя.Заголовок = "Марка, номер двигателя:";
		Форма.Элементы.Агрегат.Заголовок = НСтр("ru='Агрегат'");
		Форма.Элементы.РабочийЛистАгрегата.Заголовок = НСтр("ru='Рабочий лист'");
		Форма.Элементы.ГруппаДанныеРабочегоЛиста.Заголовок = НСтр("ru='Данные рабочего листа'");
		Форма.Элементы.МОЛ.Заголовок = НСтр("ru='МОЛ'");
	ИначеЕсли Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста") Тогда 
		Форма.Элементы.ДекорацияЗаголовокМаркаНомерДвигателя.Заголовок = НСтр("ru='Гаражный №, гос. номер. знак:'");
		Форма.Элементы.Агрегат.Заголовок = НСтр("ru='Машина'");
		Форма.Элементы.РабочийЛистАгрегата.Заголовок = НСтр("ru='Учетный лист'");
		Форма.Элементы.ГруппаДанныеРабочегоЛиста.Заголовок = НСтр("ru='Данные учетного листа'");
		Форма.Элементы.МОЛ.Заголовок = НСтр("ru='Машинист'");
	КонецЕсли;	
КонецПроцедуры

