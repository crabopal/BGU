&НаКлиенте
Процедура НормыРасходаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и Элементы.ДанныеРежимаРаботы.ТекущиеДанные <> Неопределено тогда
		Элементы.НормыРасхода.ТекущиеДанные.КлючСтроки = Элементы.ДанныеРежимаРаботы.ТекущиеДанные.КлючСтроки;
		
		ТекущиеДанные = Элементы.НормыРасхода.ТекущиеДанные;
		ОбновитьТекстЗаголовковВСтрокеТаблицыНормыРасхода(ТекущиеДанные);		
		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НормыРасходаНормаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НормыРасхода.ТекущиеДанные;
	ТекущийВидГСМ = Элементы.ДанныеРежимаРаботы.ТекущиеДанные.ВидГСМ;
	Если ЗначениеЗаполнено(ТекущиеДанные.Норма) Тогда
		//заполнение из настроек расхода
		СтруктураДанных = ПолучитьДанныеНормы(ТекущиеДанные.Норма);
		
		Если ТекущийВидГСМ <> СтруктураДанных.ВидГСМ Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для текущего режима работы вид ГСМ не соответствует виду ГСМ выбранной нормы расхода и данные не попадут в расчет.'");
			Сообщение.Сообщить();
			ТекущиеДанные.Норма = Неопределено;
			Возврат;
		КонецЕсли;	
		
		ТекущиеДанные.Значение = СтруктураДанных.Значение;
		ТекущиеДанные.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
		ТекущиеДанные.Параметр = СтруктураДанных.ОсновнойПараметрРасчета;
		ТекущиеДанные.ЗначениеПараметра = СтруктураДанных.ЗначениеОсновногоПараметраРасчета;
		ТекущиеДанные.ЕдиницаИзмеренияПараметра = СтруктураДанных.ЕдиницаИзмеренияПараметра;
		
		ТекущиеДанные.НаименованиеНормы = ТекущиеДанные.Норма;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НормыРасходаНормаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	ТекущаяСтрока = Элементы.ДанныеРежимаРаботы.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не добавлено ни одного режима работы в табличной части Режимы работы с различными параметрами расчета нормативного расхода ГСМ.'");
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВидГСМ) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для режима работы номер %1 не указан вид ГСМ'"),ТекущаяСтрока.НомерСтроки);
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ВидГСМ", ТекущаяСтрока.ВидГСМ);

	ОткрытьФорму("Справочник.НормыРасходаГСМДляАгрегатов.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

