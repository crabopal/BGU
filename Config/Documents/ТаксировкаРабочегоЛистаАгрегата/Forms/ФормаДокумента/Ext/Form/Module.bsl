&НаКлиенте
Процедура ДанныеРежимаРаботыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЭтоНоваяСтрока = НоваяСтрока;
	
	Если НоваяСтрока тогда
		ТекущаяСтрока = Элементы.ДанныеРежимаРаботы.ТекущиеДанные;
		ТекущаяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
		ОтборДляНормПараметровРасчета(ТекущаяСтрока.КлючСтроки);
		ОтборДляЗначенийПараметровРасчета(ТекущаяСтрока.КлючСтроки);
		ОтборДляКоэффициентовПараметровРасчета(ТекущаяСтрока.КлючСтроки);
		ОбновитьТекстЗаголовковВСтрокеТаблицыДанныеРежимаРаботы(ТекущаяСтрока);
		
		Если Копирование Тогда
			Возврат;
		КонецЕсли;
		ТекущаяСтрока.ПоказателиРасчета = НСтр("ru='Ввести данные о работе агрегата'");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеРежимаРаботыПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("КлючСтроки", Элемент.ТекущиеДанные.КлючСтроки); 	
	//удаление норм
	МассивКУдалению = Объект.НормыРасхода.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.НормыРасхода.Удалить(СтрокаКУдалению);
	КонецЦикла;	
	//удаление значений
	МассивКУдалению = Объект.ПоправочныеЗначения.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.ПоправочныеЗначения.Удалить(СтрокаКУдалению);
	КонецЦикла;	
	//удаление коэффициентов
	МассивКУдалению = Объект.ПоправочныеКоэффициенты.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.ПоправочныеКоэффициенты.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

