
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КоличествоОбработанныхМЦ = Параметры.КоличествоОбработанныхМЦ;
	ПоказанияСчетчика = Параметры.ПоказанияСчетчика;
	ПродолжительностьРаботы = Параметры.ПродолжительностьРаботы;
	КлючСтроки = Параметры.КлючСтроки;
	
	ПоказатьКоличествоВремени();
	
	ИдентификаторФормулыРасчета = Параметры.ИдентификаторФормулыРасчета;
	
	ВидГСМ = Параметры.ВидГСМ;
	ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	ЕдиницаИзмеренияРаботы = Параметры.ЕдиницаИзмеренияРаботы;
	РасшифровкаРасчетаНормативногоРасходаГСМ = Параметры.РасшифровкаРасчетаНормативногоРасходаГСМ;
	НормативРасходаГСМ = Параметры.НормативРасходаГСМ;
	ФактическийРасходГСМ = Параметры.ФактическийРасходГСМ;
	ЭкономияПерерасход = Параметры.ЭкономияПерерасход;
	
	ДанныеФормулы = УчетГСМ.ПолучитьФормулуДляАгрегата(ИдентификаторФормулыРасчета);
	
	Элементы.ДекорацияФормула.Заголовок = ДанныеФормулы.Формула;
	Элементы.ДекорацияПоясненияФормулы.Заголовок = ДанныеФормулы.Пояснение;
	
	Элементы.ДекорацияФормулаЧисла.Заголовок = РасшифровкаРасчетаНормативногоРасходаГСМ + ?(НормативРасходаГСМ = 0,""," = "+Строка(НормативРасходаГСМ));
	
	Если НормативРасходаГСМ > ФактическийРасходГСМ Тогда
		Элементы.ДекорацияВидРезультата.Заголовок = "Экономия: ";
	ИначеЕсли НормативРасходаГСМ < ФактическийРасходГСМ Тогда
		Элементы.ДекорацияВидРезультата.Заголовок = "Перерасход: ";
		ЭкономияПерерасход = ЭкономияПерерасход * (-1);
	Иначе
		Элементы.ДекорацияВидРезультата.Заголовок = "";
		ЭкономияПерерасход = 0;
	КонецЕсли;	
	
	Элементы.ДекорацияФормулаЭкономияПерерасход.Заголовок = ?(НормативРасходаГСМ = 0,"",Строка(НормативРасходаГСМ) + " - " + Строка(ФактическийРасходГСМ) + " = "+Строка(ЭкономияПерерасход));
	
	ДанныеФормулыСМ = УчетГСМ.ПолучитьФормулуДляСМ();
	Элементы.ДекорацияФормулаСМ.Заголовок = ДанныеФормулыСМ.Формула;
	Элементы.ДекорацияПоясненияФормулыСМ.Заголовок = ДанныеФормулыСМ.Пояснение;
	
	УстановитьВидимостьЭлементов(ЭтаФорма, ИдентификаторФормулыРасчета);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.РасчетСМ.Очистить();
	
	Для каждого ТекСтрока Из ЭтаФорма.ВладелецФормы.Объект.НормативныйРасходСМ Цикл
		Если (ТекСтрока.КлючСтроки = КлючСтроки) И (ТекСтрока.ВидГСМ = ВидГСМ) Тогда
			НоваяСтрока = РасчетСМ.Добавить();
			НоваяСтрока.ВидСМ = ТекСтрока.ВидСМ;
			НоваяСтрока.РасшифровкаРасчета = ТекСтрока.РасшифровкаРасчетаСМ;
			НоваяСтрока.Результат = ТекСтрока.ЗначениеРасходаСМ;
			НоваяСтрока.ЕдИзм = ТекСтрока.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЦикла;	
	ЭтаФорма.РасчетСМ.Сортировать("ВидСМ Возр");
	//Элементы.ГруппаРасчетСМ.Видимость = ?(РасчетСМ.Количество() = 0, Ложь, Истина);	
	ВидимостьСМ = ?(РасчетСМ.Количество() = 0, Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"ГруппаРасчетСМ", "Видимость", ВидимостьСМ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма, ИдентификаторФормулы)
	Если ИдентификаторФормулы = 1 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"КоличествоОбработанныхМЦ", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ПоказанияСчетчика", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ЕдиницаИзмеренияРаботы", "Видимость", Ложь);
	ИначеЕсли ИдентификаторФормулы = 2 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ПродолжительностьРаботыСтр", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ПоказанияСчетчика", "Видимость", Ложь);
	ИначеЕсли ИдентификаторФормулы = 3 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ПродолжительностьРаботыСтр", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"КоличествоОбработанныхМЦ", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ЕдиницаИзмеренияРаботы", "Видимость", Ложь);
	КонецЕсли;	

КонецПроцедуры	

&НаСервере
Процедура ПоказатьКоличествоВремени()
	ПродолжительностьРаботыСтр = УчетВремениКлиентСервер.ЧислоВСтроку(ПродолжительностьРаботы);
КонецПроцедуры	

#КонецОбласти
