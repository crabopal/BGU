Процедура ЗаполнитьДанныеАгрегатаДляСводнойТаксировки()
	ЭтотОбъект.Агрегат = "";
	ЭтотОбъект.НомерДвигателяАгрегата = ""; 
	ЭтотОбъект.МаркаДвигателяАгрегата = "";
	ЭтотОбъект.РегистрационныйНомернойЗнак = ""; 
	ЭтотОбъект.ГаражныйНомер = "";
	
	ТаблицаТаксировок = ЭтотОбъект.ТаксировкиРабочихЛистов.Выгрузить();
	ТаблицаТаксировок.Колонки.Добавить("ОС", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Для каждого ТекСтрока Из ТаблицаТаксировок Цикл
		ТекСтрока.ОС = ТекСтрока.ТаксировкаРабочегоЛиста.Агрегат;
	КонецЦикла;	
	ТаблицаТаксировок.Свернуть("ОС");
	
	Если ТаблицаТаксировок.Количество()=1 Тогда
		ОС = ТаблицаТаксировок[0].ОС;
		Если ЗначениеЗаполнено(ОС) Тогда
			ПТС = УчетГСМ.ПолучитьПаспортТранспортногоСредства(ОС, Дата);
			
			ЭтотОбъект.Агрегат = ОС;
			ЭтотОбъект.НомерДвигателяАгрегата = ПТС.ДвигательНомер; 
			ЭтотОбъект.МаркаДвигателяАгрегата = ПТС.ДвигательМодель;
			ЭтотОбъект.РегистрационныйНомернойЗнак = ПТС.РегистрационныйЗнак; 
			ЭтотОбъект.ГаражныйНомер = ПТС.ГаражныйНомер;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

