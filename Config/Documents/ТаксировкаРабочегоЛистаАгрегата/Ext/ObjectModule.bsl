#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЭтотОбъект.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		ЗаполнитьДанныеАгрегатаДляСводнойТаксировки();
	КонецЕсли;
	
	ПодразделениеДляАктаОСписании = Справочники.Подразделения.ПустаяСсылка();
	ЦМОДляАктаОСписании = Справочники.ЦМО.ПустаяСсылка();
	ИФОДляАктаОСписании = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	ОдинАктОСписании = Ложь;
	
	АналитикаАктовОСписании.Очистить();
	СписываемыеМатериалы = ЭтотОбъект.Материалы.Выгрузить();
	СписываемыеМатериалы.Свернуть("Подразделение, ЦМО, ИФО","Количество");
	Если СписываемыеМатериалы.Количество() = 0 Тогда
		ОдинАктОСписании = Истина;
	ИначеЕсли СписываемыеМатериалы.Количество() = 1 Тогда
		ПодразделениеДляАктаОСписании = СписываемыеМатериалы[0].Подразделение;
		ЦМОДляАктаОСписании = СписываемыеМатериалы[0].ЦМО;
		ИФОДляАктаОСписании = СписываемыеМатериалы[0].ИФО;
		ОдинАктОСписании = Истина;
	ИначеЕсли СписываемыеМатериалы.Количество() > 1 Тогда
		ОдинАктОСписании = Ложь;
		АналитикаАктовОСписании.Загрузить(СписываемыеМатериалы);
	КонецЕсли;	
	
	СписаниеМатериаловАктомСписанияМЗ = Ложь;
	Если ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору("АктОСписанииМЗ0510460_157н") Тогда
		Если НЕ ОдинАктОСписании Тогда
			СписаниеМатериаловАктомСписанияМЗ = Истина;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ТаксировкаСсылка = УчетГСМ.НайтиТаксировкиПоДокументу(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(ТаксировкаСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа уже введена %1.'"),ТаксировкаСсылка);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РабочийЛистАгрегата") Тогда
		ЗаполнитьПоРабочемуЛистуАгрегата(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УчетныйЛистТрактористаМашиниста") Тогда	
		ЗаполнитьПоУчетномуЛистуТрактористаМашиниста(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ТаксировкаРабочегоЛистаАгрегата.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	Если ВидТаксировки <> Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасходГСМ");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ЗаправкиГСМПоТопливнымКартам");
	КонецЕсли;	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ЭтотОбъект.РабочийЛистАгрегата = Неопределено;
	ЭтотОбъект.НомерРабочегоЛистаАгрегата = "";
	ЭтотОбъект.ДатаРабочегоЛистаАгрегата = "";
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПризнакиУчетаСчетов105ГСМ = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.23,105.33", , Дата);
	
	Для каждого СтрокаТаблицы Из Материалы Цикл
		Префикс = "Материалы[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		ИмяСписка = НСтр("ru = 'Списываемые материалы ГСМ'");
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Номенклатура'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Номенклатура";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КФО'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "КФО";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КПС'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "КПС";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если ИспользоватьУчетПоПодразделениям И ПризнакиУчетаСчетов105ГСМ.УчетПоПодразделениям И НЕ ПризнакиУчетаСчетов105ГСМ.РазрешитьНеУказыватьПодразделение
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Подразделение'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Подразделение";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет учета'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "СчетУчета";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ЦМО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'МОЛ/Место хранения'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "ЦМО";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДт) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Дебет'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "СчетДт";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ (СтрокаТаблицы.Количество > 0) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Количество'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Количество";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Агрегат");
		МассивНепроверяемыхРеквизитов.Добавить("МОЛ");
	КонецЕсли;	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоРабочемуЛистуАгрегата(РабочийЛист) Экспорт
	ДокументОснование = РабочийЛист;
	
	ЗаполняемыеДанные = "Организация, Агрегат, МОЛ, Подразделение";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДатаРабочегоЛистаАгрегата = ДокументОснование.Дата;
	ЭтотОбъект.НомерРабочегоЛистаАгрегата = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование.Ссылка,ДокументОснование.Номер);
	ЭтотОбъект.РабочийЛистАгрегата = ДокументОснование;
	ЭтотОбъект.МаркаДвигателяАгрегата = ДокументОснование.МаркаДвигателяАгрегата;
	ЭтотОбъект.НомерДвигателяАгрегата = ДокументОснование.НомерДвигателяАгрегата;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ДатаРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.НаименованиеРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПродолжительностьРаботы КАК ПродолжительностьРаботы,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.КоличествоОбработанныхМЦ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаНачало,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаКонец,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчика,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ВидГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПолученоМЗ КАК ПолученоГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ИзрасходованоМЗ КАК ФактическийРасходГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ЕдиницаИзмеренияРаботы КАК ЕдиницаИзмеренияРаботы,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Оператор
	|ИЗ
	|	Документ.РабочийЛистАгрегата.РезультатыРаботыАгрегата КАК РабочийЛистАгрегатаРезультатыРаботыАгрегата
	|ГДЕ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Ссылка = &РабочийЛист";	
	
	Запрос.УстановитьПараметр("РабочийЛист", РабочийЛист);
	
	ДанныеРежимаРаботы.Очистить();
	ДанныеРежимаРаботы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для каждого ТекСтрока Из ДанныеРежимаРаботы Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
	ЭтотОбъект.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуАгрегата;
	
КонецПроцедуры	

Процедура ЗаполнитьПоУчетномуЛистуТрактористаМашиниста(РабочийЛист) Экспорт
	ДокументОснование = РабочийЛист;
	
	ЗаполняемыеДанные = "Организация, Агрегат, МОЛ, Подразделение";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДатаРабочегоЛистаАгрегата = ДокументОснование.Дата;
	ЭтотОбъект.НомерРабочегоЛистаАгрегата = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование.Ссылка,ДокументОснование.Номер);
	ЭтотОбъект.РабочийЛистАгрегата = ДокументОснование;
	
	ЭтотОбъект.ГаражныйНомер = ДокументОснование.ГаражныйНомер;
	ЭтотОбъект.РегистрационныйНомернойЗнак = ДокументОснование.РегистрационныйНомернойЗнак;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ДатаРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.НаименованиеРабот,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПродолжительностьРаботы КАК ПродолжительностьРаботы,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.КоличествоОбработанныхМЦ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаНачало,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчикаНаКонец,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПоказанияСчетчика,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ВидГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ПолученоМЗ КАК ПолученоГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ИзрасходованоМЗ КАК ФактическийРасходГСМ,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.ЕдиницаИзмеренияРаботы КАК ЕдиницаИзмеренияРаботы,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Оператор,
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.НаименованиеКультуры,
