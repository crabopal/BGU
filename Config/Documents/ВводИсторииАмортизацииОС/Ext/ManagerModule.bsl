КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВводИсторииАмортизацииОСИсторияАмортизации.ДатаНачисленияАмортизации КАК Период,
	               |	ВводИсторииАмортизацииОС.Ссылка КАК Регистратор,
	               |	ЗНАЧЕНИЕ(ВидДВиженияНакопления.Приход) КАК ВидДвижения,
	               |	ВводИсторииАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
	               |	ВводИсторииАмортизацииОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	               |	ВводИсторииАмортизацииОС.Организация КАК Организация,
	               |	ВводИсторииАмортизацииОСИсторияАмортизации.СуммаАмортизации КАК СуммаАмортизации
	               |ИЗ
	               |	Документ.ВводИсторииАмортизацииОС.ИсторияАмортизации КАК ВводИсторииАмортизацииОСИсторияАмортизации
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводИсторииАмортизацииОС КАК ВводИсторииАмортизацииОС
	               |		ПО ВводИсторииАмортизацииОСИсторияАмортизации.Ссылка = ВводИсторииАмортизацииОС.Ссылка
	               |ГДЕ
	               |	ВводИсторииАмортизацииОС.Ссылка = &Ссылка
	               |	И ВводИсторииАмортизацииОСИсторияАмортизации.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВводИсторииАмортизацииОСИсторияАмортизации.НомерСтроки";
	
	АмортизацияОбъектовОС = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("АмортизацияОбъектовОС", АмортизацияОбъектовОС);
	
КонецПроцедуры

