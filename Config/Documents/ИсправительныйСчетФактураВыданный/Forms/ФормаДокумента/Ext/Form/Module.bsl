#Область ДокументыСчетовФактурНаАвансСтрока5б

&НаКлиенте
Процедура ПроверитьИОткрытьФормуДокументовСчетовФактурНаАванс(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстПояснения = НСтр("ru='Необходимо заполнить это поле перед редактированием списка документов счетов-фактур на аванс.'");
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", НСтр("ru='Контрагент'"),,, ТекстПояснения),
			Объект.Ссылка, "Контрагент", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", НСтр("ru='Договор'"),,, ТекстПояснения),
			Объект.Ссылка, "Договор", "Объект", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуДокументовСчетовФактурНаАванс();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДокументовСчетовФактурНаАванс()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СчетФактура",				Объект.Ссылка);
	СтруктураПараметров.Вставить("АдресТаблицДокумента",	ПоместитьТаблицыДокументаВХранилище_ДокументыСчетовФактурНаАванс());
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗакрытаФормаДокументыСчетовФактурНаАванс", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ДокументыСчетовФактурНаАванс", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаДокументыСчетовФактурНаАванс(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДокументыСчетовФактурНаАванс(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицыДокументаВХранилище_ДокументыСчетовФактурНаАванс()
	
	Отбор = Документы.ИсправительныйСчетФактураВыданный.ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект);
	
	ТаблицыДокумента = Новый Структура;
	ТаблицыДокумента.Вставить("СчетаФактурыНаАванс",	Объект.СчетаФактурыНаАванс.Выгрузить());
	ТаблицыДокумента.Вставить("Отбор",					Отбор);
	
	АдресТаблицДокумента = ПоместитьВоВременноеХранилище(ТаблицыДокумента, УникальныйИдентификатор);
	
	Возврат АдресТаблицДокумента;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДокументыСчетовФактурНаАванс(ВыбранноеЗначение)
	
	Объект.СчетаФактурыНаАванс.Очистить();
	
	Если Не ЭтоАдресВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаАванс) Тогда
		УстановитьНадписьСчетаФактурыНаАванс();
		
		Возврат;
	КонецЕсли;
	
	ТаблицаСчетаФактурыНаАванс = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаАванс);
	
	Объект.СчетаФактурыНаАванс.Загрузить(ТаблицаСчетаФактурыНаАванс);
	
	УстановитьНадписьСчетаФактурыНаАванс();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьСчетаФактурыНаАванс()
	
	НадписьСчетаФактурыНаАванс = УчетНДС.ПолучитьНадписьСчетаФактурыНаАванс(Объект.СчетаФактурыНаАванс);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНадписиСчетаФактурыНаАванс()
	
	Элементы.НадписьСчетаФактурыНаАванс.Видимость =
		ТипЗнч(Объект.ИсправляемыйДокумент) = Тип("ДокументСсылка.СчетФактураВыданный")
		И УчетНДСКлиентСервер.ДоступноУказаниеСчетовФактурНаАванс(Объект.ПричинаНалогообложения);
	
КонецПроцедуры

#КонецОбласти
