&НаСервере
Функция ПоместитьТаблицыДокументаВХранилище()
	
	ТаблицыДокумента = Новый Структура;
	ТаблицыДокумента.Вставить("ТаблицаДокументовОбОтгрузке",	Объект.ДокументыОбОтгрузке.Выгрузить());
	ТаблицыДокумента.Вставить("ТаблицаСоставНФА",				Объект.СоставНФА.Выгрузить());
	
	АдресТаблицДокумента = ПоместитьВоВременноеХранилище(ТаблицыДокумента, УникальныйИдентификатор);
	
	Возврат АдресТаблицДокумента;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаДокументовОбОтгрузке(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДокументыОбОтгрузке(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыОбОтгрузке(ВыбранноеЗначение)
	
	Объект.ДокументыОбОтгрузке.Очистить();
	
	Если Не ЭтоАдресВременногоХранилища(ВыбранноеЗначение.АдресТаблицыОтгрузочныхДокументов) Тогда
		УстановитьНадписьДокументыОбОтгрузке();
		
		Возврат;
	КонецЕсли;
	
	ТаблицаОтгрузочныхДокументов = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТаблицыОтгрузочныхДокументов);
	
	Объект.ДокументыОбОтгрузке.Загрузить(ТаблицаОтгрузочныхДокументов);
	
	УстановитьНадписьДокументыОбОтгрузке();
	
КонецПроцедуры

