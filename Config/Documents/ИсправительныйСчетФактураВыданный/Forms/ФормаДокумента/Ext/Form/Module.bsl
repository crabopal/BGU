Процедура НастроитьФормуПрослеживаемостьСервер()
	
	Если ЗначениеЗаполнено(Объект.ИсправляемыйДокумент) Тогда
		НаДату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ИсправляемыйДокумент, "Дата");
	Иначе
		НаДату = Объект.Дата;
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУ.НастроитьФормуИКолонкуПрослеживаемыйТовар(ЭтаФорма, НаДату);
	
