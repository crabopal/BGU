&НаКлиенте
Процедура НадписьДокументыОбОтгрузкеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументРеализации = Неопределено;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СчетФактура",				Объект.Ссылка);
	СтруктураПараметров.Вставить("Контрагент",				Объект.Контрагент);
	СтруктураПараметров.Вставить("ДоговорКонтрагента",		Объект.Договор);
	СтруктураПараметров.Вставить("ИсправляемыйДокумент",	Объект.ИсправляемыйДокумент);
	СтруктураПараметров.Вставить("ДокументКорректировки",	Объект.ДокументКорректировки);
	СтруктураПараметров.Вставить("НаДату",					Объект.Дата);
	СтруктураПараметров.Вставить("АдресТаблицДокумента",	ПоместитьТаблицыДокументаВХранилище());
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗакрытаФормаДокументовОбОтгрузке", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ДокументыОбОтгрузкеСчетаФактуры", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

