Процедура НастроитьФормуСервер_ПоПричинеНалогообложения()
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
	ЭтоНалоговыйАгент = УчетНДСПовтИсп.НалоговыйАгент(Объект.ПричинаНалогообложения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаОснованииКлиент(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	НовоеЗначение = Объект[ИмяЭлемента];
	
	Если ЗначениеЗаполнено(НовоеЗначение) Тогда
		
		ТекстВопроса = НСтр("ru='Заполнить на основании указанного документа?'");
		
		ДополнительныеПараметры = Новый Структура("ИмяЭлемента", ИмяЭлемента);
		
		ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗаполнитьНаОснованииКлиент_Выбор", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
		
	Иначе
		ДиагностироватьЦепочкуДокументовСчетовФактур();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаОснованииКлиент_Выбор(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьНаОснованииСервер(ДополнительныеПараметры);
		
	Иначе
		ДиагностироватьЦепочкуДокументовСчетовФактур();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаОснованииСервер(ДополнительныеПараметры)
	
	Перем ОписаниеОшибки, ДопПараметры;
	
	Если ЗначениеЗаполнено(Объект.ДокументКорректировки) Тогда
		Основание = Объект.ДокументКорректировки;
		
		Если ДополнительныеПараметры.ИмяЭлемента = "ДокументОснование" Тогда
			ДопПараметры = "ТолькоДозаполнитьПоСчетуФактуре";
		КонецЕсли;
	Иначе
		Основание = Объект.ДокументОснование;
	КонецЕсли;
	
	Если Не Документы.ИсправительныйСчетФактураВыданный.ЗаполнитьНаОсновании(Основание, Объект, ОписаниеОшибки, ДопПараметры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
		ДиагностироватьЦепочкуДокументовСчетовФактур();
		
		Возврат;
	КонецЕсли;
	
	НастроитьФормуСервер_ПоВидуИсправляемогоДокумента();
	
	НастроитьВидимостьКолонкиСодержаниеУслуги();
	
	НастроитьФормуСервер_ПоПричинеНалогообложения();
	
	КонтрагентПриИзменении_ЭДО();
	
	УстановитьНадписьДокументыОбОтгрузке();
	УстановитьВидимостьНадписиДокументыОбОтгрузке();
	
	УстановитьНадписьСчетаФактурыНаАванс();
	УстановитьВидимостьНадписиСчетаФактурыНаАванс();
	
	// МаркировкаПродукции
	ЭлектронныеДокументыБГУ.ЗаполнитьРеквизитыМаркировки(Объект, "СоставНФА");
	// Конец МаркировкаПродукции
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ДиагностироватьЦепочкуДокументовСчетовФактур();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДиагностироватьЦепочкуДокументовСчетовФактур()
	
	УчетНДС.ДиагностироватьЦепочкуДокументовСчетовФактур(ЭтотОбъект);
	
КонецПроцедуры

