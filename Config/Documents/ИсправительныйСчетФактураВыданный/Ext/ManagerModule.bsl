	|		СтавкаНДСДоИзменения	КАК СтавкаНДСДоКорректировки,
    |		СуммаНДСДоИзменения 	КАК СуммаНДСДоКорректировки,
    |		ВсегоДоИзменения 		КАК ВсегоДоКорректировки,
	|		СуммаАкцизаДоИзменения	КАК СуммаАкцизаДоКорректировки,
	|		СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаДоИзменения,
	|		СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров,
	|		ИдентификаторСтроки КАК ИдентификаторСтроки
	|	)  Как ОснованиеСоставНФА,
	|	СчетФактураВыданный.ПлатежноРасчетныеДокументы.(
    |		ДатаДокумента	КАК ДатаДокумента,
    |		НомерДокумента	КАК НомерДокумента
	|	) КАК ОснованиеПлатежноРасчетныеДокументы,
    |	СчетФактураВыданный.КодыУпаковокМаркируемойПродукции.(
    |		НомерУпаковки КАК НомерУпаковки,
    |		ИдентификаторСтроки КАК ИдентификаторСтроки,
    |		ТипУпаковки КАК ТипУпаковки
	|	) КАК ОснованиеКодыУпаковокМаркируемойПродукции
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ДокументОснования);
	
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	Объект.СоставНФА.Очистить();
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт.
	НФА = Основание.ОснованиеСоставНФА.Выбрать();
	Пока НФА.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, НФА);
		
		Если НЕ ЗначениеЗаполнено(СтрокаНФА["ЕдиницаИзмерения"]) Тогда
			Если ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = СтрокаНФА.НФА.ЕдиницаИзмерения;
			ИначеЕсли ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = ЕдИзмШт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("СуммаНДС");
	ИменаПолей.Добавить("Всего");
	
	УчетНДС.ЗаполнитьСуммыУвеличенияУменьшения(Объект.СоставНФА, ИменаПолей);
	
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Выборка = Основание.ОснованиеПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПлатежноРасчетныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Объект.КодыУпаковокМаркируемойПродукции.Очистить();
	Выборка = Основание.ОснованиеКодыУпаковокМаркируемойПродукции.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПРоцедуры

Процедура ДозаполнитьПоСчетуФактуре(ДокументОбъект, СчетФактура)
	
	Если НЕ ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат;
	КонецЕсли;
	
	// Реквизиты шапки
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
		 	|ПричинаНалогообложения,
		 	|КодВидаОперации,
		 	|Грузоотправитель,
		 	|Грузополучатель,
		 	|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		ДокументОбъект.ИсправляемыйДокумент = СчетФактура;
		ДокументОбъект.НомерИсправления = 1;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииИсправительныйСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|ПричинаНалогообложения,
		 	|КодВидаОперации,
			|НомерИсправления,
			|ИсправляемыйДокумент,
			|Грузоотправитель,
			|Грузополучатель,
			|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		ДокументОбъект.НомерИсправления = ЗначенияРеквизитов.НомерИсправления + 1;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииКорректировочныйСчетФактураВыданный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|ПричинаНалогообложения,
			|КодВидаОперации,
			|ИдентификаторГосКонтракта");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		ДокументОбъект.ИсправляемыйДокумент = СчетФактура;
		ДокументОбъект.НомерИсправления = 1;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// Табличные части
	
	УчетНДС.ЗаполнитьПлатежноРасчетныеДокументы(ДокументОбъект, СчетФактура);
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииНакладнаяНаОтпускМ15(Знач ДокументОснования, Объект, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры = "ТолькоДозаполнитьПоСчетуФактуре" Тогда
		ДозаполнитьПоСчетуФактуре(Объект, Объект.ДокументОснование);
		
		Возврат;
	КонецЕсли;
	
	ЭтоКорректировка = Ложь;
	
	РезультатыПоиска = УчетНДС.НайтиПредыдущийСчетФактуруРеализации(ДокументОснования);
	
	Если РезультатыПоиска <> Неопределено Тогда
		ЭтоКорректировка = УчетНДС.ЭтоКорректировка(РезультатыПоиска.Ссылка);
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка", ДокументОснования);
	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка							КАК ДокументКорректировки,
	|	Дата												КАК Дата,
	|	Организация											КАК Организация,
	|	ИФО													КАК ИФО,
	|	Подразделение										КАК Подразделение,
	|	Контрагент											КАК Контрагент,
	|	Договор												КАК Договор,
	|	ВалютаДокумента										КАК ВалютаДокумента,
	|	КФО													КАК КФО,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.РеализацияЛомаШкур) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.РеализацияЛом)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15	КАК НакладнаяНаОтпускМ15
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|";
	
	Если ЭтоКорректировка Тогда
		// Вариант 2. Заполнение ИСФ(к)
		//
		// Заполняем три набора полей:
		//	- Поле<ДоКорректировки>
		//	- Поле<ДоИзменения>
		//	- Поле
		
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [1](2). Данные табличной части СоставНФА
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура									КАК НФА,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
		|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
		|			&ЕдИзмШт
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|	КОНЕЦ											КАК ЕдиницаИзмерения,
		|	
		|	// До корректировки
		|	СтавкаНДС										КАК СтавкаНДСДоКорректировки,
		|	КоличествоДоКорректировки						КАК КоличествоДоКорректировки,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС И СуммаДоКорректировки <> 0 ТОГДА
		|			ЦенаДоКорректировки - ВЫРАЗИТЬ(СуммаНДСДоКорректировки * (Цена/СуммаДоКорректировки) КАК Число(15,2)) 
		|		ИНАЧЕ
		|			ЦенаДоКорректировки
		|	КОНЕЦ											КАК ЦенаДоКорректировки,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
		|			СуммаДоКорректировки - СуммаНДСДоКорректировки
		|		ИНАЧЕ
		|			СуммаДоКорректировки
		|	КОНЕЦ											КАК СуммаДоКорректировки,
		|	СуммаНДСДоКорректировки							КАК СуммаНДСДоКорректировки,
		|	ВсегоДоКорректировки							КАК ВсегоДоКорректировки,
		|	
		|	// После корректировки
		|	СтавкаНДС										КАК СтавкаНДСДоИзменения,
		|	Количество										КАК КоличествоДоИзменения,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС И Сумма <> 0 ТОГДА
		|			Цена - ВЫРАЗИТЬ(СуммаНДС * (Цена/Сумма) КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Цена
		|	КОНЕЦ											КАК ЦенаДоИзменения,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
		|			Сумма - СуммаНДС
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК СуммаДоИзменения,
		|	СуммаНДС										КАК СуммаНДСДоИзменения,
		|	Всего											КАК ВсегоДоИзменения,
		|	
		|	// После корректировки (дубль)
		|	СтавкаНДС										КАК СтавкаНДС,
		|	Количество										КАК Количество,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС И Сумма <> 0 ТОГДА
		|			Цена - ВЫРАЗИТЬ(СуммаНДС * (Цена/Сумма) КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Цена
		|	КОНЕЦ											КАК Цена,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
		|			Сумма - СуммаНДС
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК Сумма,
		|	СуммаНДС										КАК СуммаНДС,
		|	Всего											КАК Всего
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.Материалы	КАК Материалы
		|ГДЕ 
		|	Ссылка = &ДокументОснованиеСсылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура									КАК НФА,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
		|			ВЫРАЗИТЬ(Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
		|			&ЕдИзмШт
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|	КОНЕЦ											КАК ЕдиницаИзмерения,
		|	
		|	// До корректировки
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДСДоКорректировки,
		|	КоличествоДоКорректировки						КАК КоличествоДоКорректировки,
		|	ВЫБОР
		|		КОГДА КоличествоДоКорректировки <> 0 ТОГДА
		|			ВЫРАЗИТЬ(СуммаДоКорректировки / КоличествоДоКорректировки КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			СуммаДоКорректировки
		|	КОНЕЦ											КАК ЦенаДоКорректировки,
		|	СуммаДоКорректировки							КАК СуммаДоКорректировки,
		|	0												КАК СуммаНДСДоКорректировки,
		|	СуммаДоКорректировки							КАК ВсегоДоКорректировки,
		|	
		|	// После корректировки
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДСДоИзменения,
		|	Количество										КАК КоличествоДоИзменения,
		|	ВЫБОР
		|		КОГДА Количество <> 0 ТОГДА
		|			ВЫРАЗИТЬ(Сумма / Количество КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК ЦенаДоИзменения,
		|	Сумма											КАК СуммаДоИзменения,
		|	0												КАК СуммаНДСДоИзменения,
		|	Сумма											КАК ВсегоДоИзменения,
		|	
		|	// После корректировки (дубль)
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДС,
		|	Количество										КАК Количество,
		|	ВЫБОР
		|		КОГДА Количество <> 0 ТОГДА
		|			ВЫРАЗИТЬ(Сумма / Количество КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК Цена,
		|	Сумма											КАК Сумма,
		|	0												КАК СуммаНДС,
		|	Сумма											КАК Всего
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.ВозвратнаяТара
		|ГДЕ
		|	Ссылка = &ДокументОснованиеСсылка	
		|;";
		
	Иначе
		// Вариант 1. Заполнение ИСФ(о)
		//
		// Заполняем два набора полей:
		//	- Поле<ДоИзменения>
		//	- Поле
		
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [1](1). Данные табличной части СоставНФА
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура									КАК НФА,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
		|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
		|			&ЕдИзмШт
