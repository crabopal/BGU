Процедура ОчиститьПоляДоКорректировки(ДокументОбъект) Экспорт
	
	ОчищающаяСтруктура = Новый Структура();
	
	ОчищающаяСтруктура.Вставить("КоличествоДоКорректировки",	0);
	ОчищающаяСтруктура.Вставить("ЦенаДоКорректировки",			0);
	ОчищающаяСтруктура.Вставить("СуммаДоКорректировки",			0);
	ОчищающаяСтруктура.Вставить("СуммаНДСДоКорректировки",		0);
	ОчищающаяСтруктура.Вставить("ВсегоДоКорректировки",			0);
	
	ОчищающаяСтруктура.Вставить("СуммаНДСУвеличение",			0);
	ОчищающаяСтруктура.Вставить("СуммаНДСУменьшение",			0);
	ОчищающаяСтруктура.Вставить("ВсегоУвеличение",				0);
	ОчищающаяСтруктура.Вставить("ВсегоУменьшение",				0);
	
	ОчищающаяСтруктура.Вставить("СтавкаНДСДоКорректировки",		Перечисления.СтавкиНДС.ПустаяСсылка());
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СоставНФА Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьОтветственныхЛиц(ДокументОбъект) Экспорт
	
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(ДокументОбъект);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОтветственныеЛица);
	
КонецПроцедуры

Функция ПолучитьОтветственныхЛиц(Шапка)
	
	Лицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	СтруктураФИО = Новый Структура();
	СтруктураФИО.Вставить("Фамилия",	Лицо.ОтветственноеЛицоФамилия);
	СтруктураФИО.Вставить("Имя",		Лицо.ОтветственноеЛицоИмя);
	СтруктураФИО.Вставить("Отчество",	Лицо.ОтветственноеЛицоОтчество);
	
	ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
	
	Лицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	СтруктураФИО = Новый Структура();
	СтруктураФИО.Вставить("Фамилия",	Лицо.ОтветственноеЛицоФамилия);
	СтруктураФИО.Вставить("Имя",		Лицо.ОтветственноеЛицоИмя);
	СтруктураФИО.Вставить("Отчество",	Лицо.ОтветственноеЛицоОтчество);
	
	ФИОГлавногоБухгалтера = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
	
	ОтветственныеЛица = Новый Структура();
	ОтветственныеЛица.Вставить("ФИОРуководителя",		ФИОРуководителя);
	ОтветственныеЛица.Вставить("ФИОГлавногоБухгалтера",	ФИОГлавногоБухгалтера);
	
	Возврат ОтветственныеЛица;
	
КонецФункции

//---
// Заполнение на основании

Процедура ЗаполнитьНаОснованииСчетФактураВыданный(Знач ДокументОснования,Объект)
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактураВыданный.Организация КАК Организация,
	               |	СчетФактураВыданный.Организация.ИНН КАК ИННПродавца,
	               |	СчетФактураВыданный.Организация.КПП КАК КПППродавца,
	               |	ВЫБОР
	               |		КОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация <> &ПустоеУчреждение
	               |			ТОГДА ВЫБОР
	               |					КОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА СчетФактураВыданный.Организация.ГоловнаяОрганизация.Представление
	               |					ИНАЧЕ СчетФактураВыданный.Организация.ГоловнаяОрганизация.НаименованиеСокращенное
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА СчетФактураВыданный.Организация.НаименованиеСокращенное = """"
	               |					ТОГДА СчетФактураВыданный.Организация.Представление
	               |				ИНАЧЕ СчетФактураВыданный.Организация.НаименованиеСокращенное
	               |			КОНЕЦ
	               |	КОНЕЦ КАК НаименованиеПродавца,
	               |	ОрганизацияАдрес.Адрес КАК АдресПродавца,
	               |	СчетФактураВыданный.ИФО КАК ИФО,
	               |	СчетФактураВыданный.Подразделение КАК Подразделение,
	               |	СчетФактураВыданный.Контрагент КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА СчетФактураВыданный.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА """"
	               |		КОГДА НЕ СчетФактураВыданный.Контрагент.НаименованиеСокращенное = """"
	               |			ТОГДА СчетФактураВыданный.Контрагент.НаименованиеСокращенное
	               |		КОГДА СчетФактураВыданный.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |				И НЕ СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |		ИНАЧЕ СчетФактураВыданный.Контрагент.Наименование
	               |	КОНЕЦ КАК НаименованиеПокупателя,
	               |	СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.ИНН КАК ИННПокупателя,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица)
	               |			ТОГДА СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.КПП
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КПППокупателя,
	               |	СчетФактураВыданный.Номер КАК НомерПервичногоДокумента,
	               |	СчетФактураВыданный.ДокументОснование.Дата КАК ДатаПервичногоДокумента,
	               |	КонтрагентАдрес.Адрес КАК АдресПокупателя,
	               |	СчетФактураВыданный.Ссылка КАК ИсправляемыйДокумент,
	               |	СчетФактураВыданный.Договор КАК Договор,
	               |	СчетФактураВыданный.СуммаДокумента КАК СуммаДокумента,
	               |	СчетФактураВыданный.СуммаНДС КАК СуммаНДС,
	               |	СчетФактураВыданный.ПричинаНалогообложения КАК ПричинаНалогообложения,
	               |	СчетФактураВыданный.Руководитель КАК Руководитель,
	               |	СчетФактураВыданный.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	               |	СчетФактураВыданный.ВалютаДокумента КАК ВалютаДокумента,
	               |	СчетФактураВыданный.КодВидаОперации КАК КодВидаОперации,
	               |	1 КАК НомерИсправления,
	               |	СчетФактураВыданный.Грузоотправитель КАК Грузоотправитель,
	               |	СчетФактураВыданный.Грузополучатель КАК Грузополучатель,
	               |	СчетФактураВыданный.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	               |	СчетФактураВыданный.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
	               |	СчетФактураВыданный.СоставНФА.(
	               |		НФА КАК НФА,
	               |		СодержаниеУслуги КАК СодержаниеУслуги,
	               |		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |		КодВидаТовара КАК КодВидаТовара,
	               |		Количество КАК Количество,
	               |		Цена КАК Цена,
	               |		Сумма КАК Сумма,
	               |		СтавкаНДС КАК СтавкаНДС,
	               |		СуммаНДС КАК СуммаНДС,
	               |		Всего КАК Всего,
	               |		СуммаАкциза КАК СуммаАкциза,
	               |		СтавкаНДС КАК СтавкаНДСДоИзменения,
	               |		Количество КАК КоличествоДоИзменения,
	               |		Цена КАК ЦенаДоИзменения,
	               |		Сумма КАК СуммаДоИзменения,
	               |		СуммаНДС КАК СуммаНДСДоИзменения,
	               |		Всего КАК ВсегоДоИзменения,
	               |		СуммаАкциза КАК СуммаАкцизаДоИзменения,
	               |		ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |		СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаДоИзменения,
	               |		СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |	) КАК ОснованиеСоставНФА,
	               |	СчетФактураВыданный.ПлатежноРасчетныеДокументы.(
	               |		ДатаДокумента КАК ДатаДокумента,
	               |		НомерДокумента КАК НомерДокумента
	               |	) КАК ОснованиеПлатежноРасчетныеДокументы,
	               |	СчетФактураВыданный.КодыУпаковокМаркируемойПродукции.(
	               |		НомерУпаковки КАК НомерУпаковки,
	               |		ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |		ТипУпаковки КАК ТипУпаковки
	               |	) КАК ОснованиеКодыУпаковокМаркируемойПродукции,
	               |	СчетФактураВыданный.ДокументыОбОтгрузке.(
	               |		Ссылка КАК Ссылка,
	               |		НомерСтроки КАК НомерСтроки,
	               |		НомераСтрок КАК НомераСтрок,
	               |		НаименованиеДокумента КАК НаименованиеДокумента,
	               |		НомерДокумента КАК НомерДокумента,
	               |		ДатаДокумента КАК ДатаДокумента
	               |	) КАК ОснованиеДокументыОбОтгрузке
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЮридическиеЛицаКонтактнаяИнформация.Представление КАК Адрес,
	               |			ЮридическиеЛица.Ссылка КАК Ссылка
	               |		ИЗ
	               |			Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	               |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица.КонтактнаяИнформация КАК ЮридическиеЛицаКонтактнаяИнформация
	               |				ПО (ЮридическиеЛицаКонтактнаяИнформация.Ссылка = ЮридическиеЛица.Ссылка)
	               |		ГДЕ
	               |			ЮридическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты)) КАК КонтрагентАдрес
	               |		ПО СчетФактураВыданный.Контрагент.ЮридическоеФизическоеЛицо.Ссылка = КонтрагентАдрес.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ОрганизацииКонтактнаяИнформация.Ссылка КАК Ссылка,
	               |			ОрганизацииКонтактнаяИнформация.Представление КАК Адрес
	               |		ИЗ
	               |			Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	               |		ГДЕ
	               |			ОрганизацииКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты)) КАК ОрганизацияАдрес
	               |		ПО СчетФактураВыданный.Организация.Ссылка = ОрганизацияАдрес.Ссылка
	               |ГДЕ
	               |	СчетФактураВыданный.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ДокументОснования);
	Запрос.УстановитьПараметр("Дата",ДокументОснования.Дата);
	Запрос.УстановитьПараметр("ПустоеУчреждение", Справочники.Организации.ПустаяСсылка());
	
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	Объект.СоставНФА.Очистить();
	
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	
	// Ответственные лица
	УстановитьОтветственныхЛиц(Объект);
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт.
	НФА = Основание.ОснованиеСоставНФА.Выбрать();
	Пока НФА.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, НФА);
		
		Если НЕ ЗначениеЗаполнено(СтрокаНФА["ЕдиницаИзмерения"]) Тогда
			Если ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = СтрокаНФА.НФА.ЕдиницаИзмерения;
			ИначеЕсли ТипЗнч(СтрокаНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаНФА["ЕдиницаИзмерения"] = ЕдИзмШт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Выборка = Основание.ОснованиеПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
