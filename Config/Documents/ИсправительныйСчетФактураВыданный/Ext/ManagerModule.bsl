	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. Данные таблицы СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка												КАК ДокСсылка,
	|	НомерСтроки											КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА НЕ СодержаниеУслуги ПОДОБНО """" ТОГДА
	|			ВЫРАЗИТЬ(СодержаниеУслуги КАК СТРОКА(1000))
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ИЛИ ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ВЫБОР
	|				КОГДА НЕ НФА.НаименованиеПолное ПОДОБНО """" ТОГДА
	|					НФА.НаименованиеПолное
	|				ИНАЧЕ
	|					НФА.Наименование
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(НФА КАК СТРОКА(1000))
	|	КОНЕЦ												КАК НоменклатураПредставление,
	|	ВЫБОР
	|		КОГДА Ссылка.ПричинаНалогообложения В (&ПричиныНалогообложенияКодВидаТовара) ТОГДА
	|			КодВидаТовара
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ												КАК КодВидаТовара,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ												КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения.Код
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ												КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения.Наименование
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ												КАК ПредставлениеСтраны,
	|	
	|	// До изменения
	|	ЕдиницаИзмерения									КАК ЕдиницаИзмеренияДоИзменения,
	|	ЕдиницаИзмерения.Код								КАК ЕдиницаИзмеренияКодДоИзменения,
	|	ЕдиницаИзмерения.Представление						КАК ЕдиницаИзмеренияПредставлениеДоИзменения,
	|	КоличествоДоКорректировки							КАК КоличествоДоИзменения,
	|	ЦенаДоКорректировки									КАК ЦенаДоИзменения,
	|	СуммаДоКорректировки								КАК СуммаДоИзменения,
	|	ПРЕДСТАВЛЕНИЕ(СтавкаНДСДоКорректировки)				КАК СтавкаНДСДоИзменения,
	|	СуммаНДСДоКорректировки								КАК СуммаНДСДоИзменения,
	|	ВсегоДоКорректировки								КАК ВсегоДоИзменения,
	|	СуммаАкцизаДоКорректировки							КАК АкцизДоИзменения,
	|	
	|	// После изменения
	|	ЕдиницаИзмерения									КАК ЕдиницаИзмеренияПослеИзменения,
	|	ЕдиницаИзмерения.Код								КАК ЕдиницаИзмеренияКодПослеИзменения,
	|	ЕдиницаИзмерения.Представление						КАК ЕдиницаИзмеренияПредставлениеПослеИзменения,
	|	Количество											КАК КоличествоПослеИзменения,
	|	Цена												КАК ЦенаПослеИзменения,
	|	Сумма												КАК СуммаПослеИзменения,
	|	ПРЕДСТАВЛЕНИЕ(СтавкаНДС)							КАК СтавкаНДСПослеИзменения,
	|	СуммаНДС											КАК СуммаНДСПослеИзменения,
	|	Всего												КАК ВсегоПослеИзменения,
	|	СуммаАкциза											КАК АкцизПослеИзменения,
	|	
	|	// Увеличение
	|	ВЫБОР
	|		КОГДА Сумма - СуммаДоКорректировки >= 0
	|			ТОГДА Сумма - СуммаДоКорректировки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаУвеличение,
	|	СуммаНДСУвеличение									КАК СуммаНДСУвеличение,
	|	ВсегоУвеличение										КАК ВсегоУвеличение,
	|	СуммаАкцизаУвеличение								КАК АкцизУвеличение,
	|	
	|	// Уменьшение
	|	ВЫБОР
	|		КОГДА СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки <= 0
	|			ТОГДА -(СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаУменьшение,
	|	СуммаНДСУменьшение									КАК СуммаНДСУменьшение,
	|	ВсегоУменьшение										КАК ВсегоУменьшение,
	|	СуммаАкцизаУменьшение								КАК АкцизУменьшение
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.СоставНФА	КАК СоставНФА
	|ГДЕ
	|	Ссылка В (&СсылкиНаДокументы)
	|	И	ТИПЗНАЧЕНИЯ(Ссылка.ИсправляемыйДокумент) = ТИП(Документ.КорректировочныйСчетФактураВыданный)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(СуммаУменьшение)		КАК СуммаУменьшение,
	|	СУММА(СуммаУвеличение)		КАК СуммаУвеличение,
	|	СУММА(СуммаНДСУменьшение)	КАК СуммаНДСУменьшение,
	|	СУММА(СуммаНДСУвеличение)	КАК СуммаНДСУвеличение,
	|	СУММА(ВсегоУменьшение)		КАК ВсегоУменьшение,
	|	СУММА(ВсегоУвеличение)		КАК ВсегоУвеличение
	|ПО
	|	// Обязательно первые итоги по ссылке на документ
	|	Ссылка
	|;
