	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Объект.ДокументыОбОтгрузке.Очистить();
	Выборка = Основание.ОснованиеДокументыОбОтгрузке.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ДокументыОбОтгрузке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПРоцедуры

