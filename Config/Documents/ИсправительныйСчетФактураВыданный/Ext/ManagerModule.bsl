	|////////////////////////////////////////////////////////////////////////////////
	|// [9]. Данные табличной части СчетаФактурыОтКомиссионера
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НЕОПРЕДЕЛЕНО	КАК ПокупательСФПредставление,
	|	НЕОПРЕДЕЛЕНО	КАК ПокупательСФ,
	|	НЕОПРЕДЕЛЕНО	КАК ПокупательИНН,
	|	НЕОПРЕДЕЛЕНО	КАК Грузополучатель,
	|	НЕОПРЕДЕЛЕНО	КАК ГрузополучательПредставление,
	|	НЕОПРЕДЕЛЕНО	КАК НомерСФ,
	|	НЕОПРЕДЕЛЕНО	КАК ДатаСФ
	|ГДЕ
	|	ЛОЖЬ";
	
	МассивРезультатов = ЗапросПечать.ВыполнитьПакет();
	
	ПризнакиСчетовФактур = УчетНДС.ПолучитьПризнакиСчетовФактур(МассивОбъектов);
	
	Результат1 = Новый Структура();
	
	// [0]. Данные табличной части СоставНФА
	ОбщаяТаблицаСоставНФА = МассивРезультатов[0].Выгрузить();
	ОбщаяТаблицаСоставНФА.Индексы.Добавить("Ссылка");
	Результат1.Вставить("ОбщаяТаблицаСоставНФА",				ОбщаяТаблицаСоставНФА);
	
	// [1]. (Заглушка) Данные табличной части РасчетноПлатежныеДокументы
	Результат1.Вставить("ВыборкаДокПлатежноРасчетныеДокументы",	МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	// [3]. Список объектов для дальнейшего группового получения контактной информации (адресов)
	Результат1.Вставить("СписокОбъектовДляОпределенияАдресов",	МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// [4]. Данные шапки документа
	Результат1.Вставить("ВыборкаШапка",							МассивРезультатов[4].Выбрать());
	
	// [5]. Данные табличной части ДокументыОбОтгрузке
	ОбщаяТаблицаДокументыОбОтгрузке = МассивРезультатов[5].Выгрузить();
	Результат1.Вставить("ОбщаяТаблицаДокументыОбОтгрузке",		ОбщаяТаблицаДокументыОбОтгрузке);
	
	// [6]. Данные табличной части СчетаФактурыНаАванс
	Результат1.Вставить("ОбщаяТаблицаСчетаФактурыНаАванс",		МассивРезультатов[6].Выгрузить());
	
	Результат1.Вставить("ПризнакиСчетовФактур", ПризнакиСчетовФактур);
	
	Результат2 = Новый Структура();
	
	// [7]. Данные шапки документа
	Результат2.Вставить("ВыборкаШапка",			МассивРезультатов[7].Выбрать());
	
	// [8]. Данные таблицы СоставНФА
	Результат2.Вставить("ВыборкаДокСоставНФА",	МассивРезультатов[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Результат2.Вставить("ПризнакиСчетовФактур", ПризнакиСчетовФактур);
	
	// Прослеживаемость
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		ПоказателиПрослеживаемости1 = Документы.СчетФактураВыданный.ПолучитьПоказателиПрослеживаемости(МассивОбъектов);
		ПоказателиПрослеживаемости2 = Документы.КорректировочныйСчетФактураВыданный.ПолучитьПоказателиПрослеживаемости(МассивОбъектов);
		
		Результат1.Вставить("ПоказателиПрослеживаемости", ПоказателиПрослеживаемости1);
		Результат2.Вставить("ПоказателиПрослеживаемости", ПоказателиПрослеживаемости2);
	КонецЕсли;
	// Конец Прослеживаемость
	
	// [9]. Данные табличной части СчетаФактурыОтКомиссионера
	Результат1.Вставить("ВыборкаПокупатели", МассивРезультатов[9].Выгрузить());
	
	Результат = Новый Структура();
	Результат.Вставить("СчетФактураВыданный",					Результат1);
	Результат.Вставить("КорректировочныйСчетФактураВыданный",	Результат2);
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьПечать(СтруктураПараметровОбработчика, ДанныеДокументовДляПечати, ИдентификаторПостановления)
	
	Перем ТабДокумент1, ТабДокумент2;
	
	// Для печати исправительных счетов-фактур важным требованием является одинаковый состав постановлений,
	// утверждающих печатные формы обычного и корректировочного счетов-фактур.
	// В форме списка документов отображается неизменный состав команд печати,
	// а в списке могут быть как исправительные обычные, так и корректировочные счета-фактуры.
	
	Если ДанныеДокументовДляПечати.СчетФактураВыданный.ВыборкаШапка.Количество() > 0 Тогда
		ТабДокумент1 = УчетНДС.ПечатьСчетаФактуры(
			ДанныеДокументовДляПечати["СчетФактураВыданный"],
			СтруктураПараметровОбработчика,
			ИдентификаторПостановления);
	КонецЕсли;
	
	Если ДанныеДокументовДляПечати.КорректировочныйСчетФактураВыданный.ВыборкаШапка.Количество() > 0 Тогда
		ТабДокумент2 = УчетНДС.ПечатьКорректировочногоСчетаФактуры(
			ДанныеДокументовДляПечати["КорректировочныйСчетФактураВыданный"],
			СтруктураПараметровОбработчика,
			ИдентификаторПостановления);
	КонецЕсли;
	
	Результат = Новый ТабличныйДокумент();
	
	Если ТабДокумент1 <> Неопределено И ТабДокумент2 <> Неопределено Тогда
		Результат = ТабДокумент1;
		Результат.ВывестиГоризонтальныйРазделительСтраниц();
		Результат.Вывести(ТабДокумент2);
		
	ИначеЕсли ТабДокумент1 <> Неопределено Тогда
		Результат = ТабДокумент1;
		
	ИначеЕсли ТабДокумент2 <> Неопределено Тогда
		Результат = ТабДокумент2;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка, ИсправляемыйДок = "СФ", ЭтоУПД) Экспорт
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	Если ИсправляемыйДок = "СФ" Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Док.Ссылка КАК Ссылка,
		               |	Док.ИсправляемыйДокумент.Номер КАК НомерСчетаФактуры,
		               |	Док.ИсправляемыйДокумент.Дата КАК ДатаСчетаФактуры,
		               |	Док.НомерИсправления КАК НомерИсправления,
		               |	Док.ДатаИсправления КАК ДатаИсправления,
		               |	Док.НаименованиеПродавца КАК НаименованиеПродавца,
		               |	Док.АдресПродавца КАК АдресПродавца,
		               |	Док.ИННПродавца + ""/"" + Док.КПППродавца КАК ИННКПППродавца,
		               |	Док.Грузоотправитель КАК Грузоотправитель,
		               |	Док.НаименованиеГрузоотправителя КАК НаименованиеГрузоотправителя,
		               |	Док.АдресГрузоотправителя КАК АдресГрузоотправителя,
		               |	Док.Грузополучатель КАК Грузополучатель,
		               |	Док.НаименованиеГрузополучателя КАК НаименованиеГрузополучателя,
		               |	Док.АдресГрузополучателя КАК АдресГрузополучателя,
		               |	Док.НаименованиеПокупателя КАК НаименованиеПокупателя,
		               |	Док.АдресПокупателя КАК АдресПокупателя,
		               |	Док.ИННПокупателя + ""/"" + Док.КПППокупателя КАК ИННКПППокупателя,
		               |	Док.ВалютаДокумента.НаименованиеПолное КАК НаименованиеВалюты,
		               |	Док.ВалютаДокумента.Код КАК КодВалюты,
		               |	ВЫРАЗИТЬ(Док.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное КАК ВалютаПредставление,
		               |	&КурсВзаиморасчетов КАК Курс,
		               |	Док.ПричинаНалогообложения КАК ПричинаНалогообложения,
		               |	Док.ФИОРуководителя КАК ФИОРуководителя,
		               |	Док.ФИОГлавногоБухгалтера КАК ФИОГлавногоБухгалтера,
		               |	Док.Организация КАК Организация,
		               |	Док.Подразделение КАК Подразделение,
		               |	Док.Контрагент КАК Контрагент,
					   //|	Док.НаименованиеГрузоотправителя КАК Грузоотправитель,
					   //|	Док.НаименованиеГрузополучателя КАК Грузополучатель,
		               |	Док.ИННПродавца КАК ИННПродавца,
		               |	Док.КПППродавца КАК КПППродавца,
		               |	Док.ИННПокупателя КАК ИННПокупателя,
		               |	Док.КПППокупателя КАК КПППокупателя,
		               |	Док.ФИОРуководителя КАК Руководитель,
		               |	Док.ФИОГлавногоБухгалтера КАК ГлавныйБухгалтер,
		               |	Док.ВалютаДокумента КАК Валюта,
		               |	Док.ДокументОснование КАК ДокументОснование,
		               |	Док.ВидЦенности КАК ВидЦенности,
		               |	Док.ИсправляемыйДокумент КАК ИсправляемыйДокумент,
		               |	Док.Договор КАК Договор,
		               |	Док.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
		               |	Док.КодыВидовТоваров КАК КодыВидовТоваров,
		               |	Док.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
		               |	Док.ДокументКорректировки КАК ДокументКорректировки
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный КАК Док
		               |ГДЕ
		               |	Док.Ссылка = &Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Док.СоставНФА.НомерСтроки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СоставНФА.НомерСтроки КАК НомерСтроки,
		               |	СоставНФА.НФА КАК НФА,
		               |	СоставНФА.СодержаниеУслуги КАК СодержаниеУслуги,
		               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код, """") КАК ЕдиницаИзмеренияКод,
		               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	           		   |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
		               |	СоставНФА.Количество КАК Количество,
		               |	СоставНФА.ЦенаДоИзменения КАК ЦенаДоИзменения,
		               |	СоставНФА.Цена КАК Цена,
		               |	СоставНФА.Сумма КАК Стоимость,
		               |	СоставНФА.СтавкаНДС КАК СтавкаНДС,
		               |	СоставНФА.СуммаНДС КАК СуммаНДС,
		               |	СоставНФА.Всего КАК Всего,
		               |	СоставНФА.СуммаАкциза КАК СуммаАкциза,
		               |	СоставНФА.КодВидаТовара КАК КодВидаТовара,
					   |	СоставНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
					   |	СоставНФА.СведенияОбъемноСортовогоУчетаДоИзменения КАК СведенияОбъемноСортовогоУчетаДоИзменения,
					   |	СоставНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК СоставНФА
		               |ГДЕ
		               |	СоставНФА.Ссылка = &Ссылка
		               |	И СоставНФА.Всего <> 0
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СоставПРД.Ссылка КАК Ссылка,
		               |	СоставПРД.НомерСтроки КАК НомерСтроки,
		               |	СоставПРД.ДатаДокумента КАК ДатаДокумента,
		               |	СоставПРД.НомерДокумента КАК НомерДокумента
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный.ПлатежноРасчетныеДокументы КАК СоставПРД
		               |ГДЕ
		               |	СоставПРД.Ссылка = &Ссылка;
					   |				   
					   |////////////////////////////////////////////////////////////////////////////////
					   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
					   |ИЗ
					   |	Документ.ИсправительныйСчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК СчетФактураКодыУпаковокМаркируемойПродукции
					   |ГДЕ
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка
					   |;
					   |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ДокументыОбОтгрузке.НомерСтроки КАК НомерСтроки,
		               |	ДокументыОбОтгрузке.НомераСтрок КАК НомераСтрок,
		               |	ДокументыОбОтгрузке.НаименованиеДокумента КАК НаименованиеДокумента,
		               |	ДокументыОбОтгрузке.НомерДокумента КАК НомерДокумента,
		               |	ДокументыОбОтгрузке.ДатаДокумента КАК ДатаДокумента
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный.ДокументыОбОтгрузке КАК ДокументыОбОтгрузке
		               |ГДЕ
		               |	ДокументыОбОтгрузке.Ссылка = &Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СчетаФактурыНаАванс.НомерСтроки КАК НомерСтроки,
		               |	СчетаФактурыНаАванс.СчетФактура КАК СчетФактура,
		               |	СчетаФактурыНаАванс.Дата КАК Дата,
		               |	СчетаФактурыНаАванс.Номер КАК Номер,
		               |	СчетаФактурыНаАванс.ДатаИсправления КАК ДатаИсправления,
		               |	СчетаФактурыНаАванс.НомерИсправления КАК НомерИсправления
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный.СчетаФактурыНаАванс КАК СчетаФактурыНаАванс
		               |ГДЕ
		               |	СчетаФактурыНаАванс.Ссылка = &Ссылка";
					   
		Запрос = Новый Запрос(ТекстЗапроса);			   
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);	
		Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицаШапка = МассивРезультатов[0].Выгрузить();
		
		Структура = Новый Структура();
		Структура.Вставить("Шапка",							ТаблицаШапка);
		Структура.Вставить("ТабЧастьНФА",					МассивРезультатов[1].Выгрузить());
		Структура.Вставить("ТабЧастьПРД",					МассивРезультатов[2].Выгрузить());
		Структура.Вставить("ТабЧастьМаркировкаТоваров",		МассивРезультатов[3].Выгрузить());
		Структура.Вставить("ТабЧастьДокументыОбОтгрузке",	МассивРезультатов[4].Выгрузить());
		Структура.Вставить("ТабЧастьСчетаФактурыНаАванс",	МассивРезультатов[5].Выгрузить());
		
		СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка);
		Структура.Вставить("СтороныСделки", СтороныСделки);
		
		СтрокаШапкиДокумента = ТаблицаШапка[0];
		
		ШапкаДокумента = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаШапкиДокумента);
		ШапкаДокумента.Вставить("Дата", СтрокаШапкиДокумента.ДатаСчетаФактуры);
		
		НомерДокумента = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(ШапкаДокумента);
		Структура.Вставить("НомерДокумента", НомерДокумента);
		
		// Прослеживаемость
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
			Документы.СчетФактураВыданный.ДобавитьПоказателиПрослеживаемости(ДокументСсылка, Структура.ТабЧастьНФА);
		КонецЕсли;
		// Конец Прослеживаемость
		
		ДобавитьСведенияДокументыОбОтгрузкеЭДО(Структура, ЭтоУПД);
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Док.Ссылка КАК Ссылка,
		               |	Док.ПричинаНалогообложения КАК ПричинаНалогообложения,
		               |	Док.ИсправляемыйДокумент.Номер КАК НомерКорректировки,
		               |	Док.ИсправляемыйДокумент.Дата КАК Дата,
		               |	Док.НомерИсправления КАК НомерИсправленияКорректировки,
		               |	Док.ДатаИсправления КАК ДатаИсправленияКорректировки,
					   |	Док.ИсправляемыйДокумент КАК ИсправляемыйДокумент,
		               |	Док.ИсправляемыйДокумент.НомерПервичногоДокумента КАК НомерСчетаФактуры,
		               |	Док.ИсправляемыйДокумент.ДатаПервичногоДокумента КАК ДатаСчетаФактуры,
		               |	ВЫБОР
		               |		КОГДА Док.ИсправляемыйДокумент.ДокументОснование ССЫЛКА Документ.ИсправительныйСчетФактураВыданный
		               |			ТОГДА Док.ИсправляемыйДокумент.ДокументОснование.НомерИсправления
		               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
		               |	КОНЕЦ КАК НомерИсправления,
		               |	ВЫБОР
		               |		КОГДА Док.ИсправляемыйДокумент.ДокументОснование ССЫЛКА Документ.ИсправительныйСчетФактураВыданный
		               |			ТОГДА Док.ИсправляемыйДокумент.ДокументОснование.ДатаИсправления
		               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
		               |	КОНЕЦ КАК ДатаИсправления,
		               |	Док.ВалютаДокумента.НаименованиеПолное КАК НаименованиеВалюты,
		               |	Док.ВалютаДокумента.Код КАК КодВалюты,
		               |	Док.ДокументОснование КАК ДокументОснование,
		               |	Док.НаименованиеПродавца КАК НаименованиеПродавца,
		               |	Док.АдресПродавца КАК АдресПродавца,
		               |	Док.ИННПродавца + "" / "" + Док.КПППродавца КАК ИННКПППродавца,
		               |	Док.НаименованиеПокупателя КАК НаименованиеПокупателя,
		               |	Док.АдресПокупателя КАК АдресПокупателя,
		               |	Док.ИННПокупателя + "" / "" + Док.КПППокупателя КАК ИННКПППокупателя,
		               |	ВЫРАЗИТЬ(Док.ВалютаДокумента КАК Справочник.Валюты).Код КАК ВалютаКод,
		               |	ВЫРАЗИТЬ(Док.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное КАК ВалютаПредставление,
		               |	&КурсВзаиморасчетов КАК Курс,
		               |	Док.ВидЦенности КАК ВидЦенности,
		               |	Док.Организация КАК Организация,
		               |	Док.Подразделение КАК Подразделение,
		               |	Док.Контрагент КАК Контрагент,
		               |	Док.ФИОРуководителя КАК ФИОРуководителя,
		               |	Док.ФИОГлавногоБухгалтера КАК ФИОГлавногоБухгалтера,
		               |	Док.Договор КАК Договор,
		               |	Док.Номер КАК Номер,
		               |	Док.НомерИсправления КАК НомерИсправленияСФ,
		               |	Док.КодыВидовТоваров КАК КодыВидовТоваров,
		               |	Док.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
		               |	Док.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
		               |	Док.ДокументКорректировки КАК ДокументКорректировки
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный КАК Док
		               |ГДЕ
		               |	Док.Ссылка = &Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Док.СоставНФА.НомерСтроки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СоставНФА.НомерСтроки КАК НомерСтроки,
		               |	СоставНФА.НФА КАК НФА,
		               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование, """") КАК ЕдиницаИзмеренияНаименование,
		               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код, """") КАК ЕдиницаИзмеренияКод,
		               |	СоставНФА.КоличествоДоКорректировки КАК КоличествоДоИзменения,
		               |	СоставНФА.Количество КАК Количество,
		               |	СоставНФА.ЦенаДоКорректировки КАК ЦенаДоИзменения,
		               |	СоставНФА.Цена КАК Цена,
		               |	СоставНФА.СуммаДоКорректировки КАК СуммаДоИзменения,
		               |	СоставНФА.Сумма КАК Сумма,
					   |	ВЫБОР
					   |		КОГДА СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки <= 0
					   |			ТОГДА -(СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки)
					   |		ИНАЧЕ 0
					   |	КОНЕЦ КАК СуммаУменьшение,
					   |	ВЫБОР
					   |		КОГДА СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки >= 0
					   |			ТОГДА СоставНФА.Сумма - СоставНФА.СуммаДоКорректировки
					   |		ИНАЧЕ 0
					   |	КОНЕЦ КАК СуммаУвеличение,
		               |	СоставНФА.СтавкаНДСДоКорректировки КАК СтавкаНДСДоИзменения,
		               |	СоставНФА.СтавкаНДС КАК СтавкаНДС,
		               |	СоставНФА.СуммаНДСДоКорректировки КАК СуммаНДСДоИзменения,
		               |	СоставНФА.СуммаНДС КАК СуммаНДС,
		               |	СоставНФА.СуммаНДСУменьшение КАК СуммаНДСУменьшение,
		               |	СоставНФА.СуммаНДСУвеличение КАК СуммаНДСУвеличение,
		               |	СоставНФА.ВсегоДоКорректировки КАК ВсегоДоИзменения,
		               |	СоставНФА.Всего КАК Всего,
		               |	СоставНФА.ВсегоУменьшение КАК ВсегоУменьшение,
		               |	СоставНФА.ВсегоУвеличение КАК ВсегоУвеличение,
		               |	СоставНФА.СуммаАкцизаДоКорректировки КАК СуммаАкцизаДоИзменения,
		               |	СоставНФА.СуммаАкциза КАК СуммаАкциза,
		               |	СоставНФА.СуммаАкцизаУвеличение КАК СуммаАкцизаУвеличение,
		               |	СоставНФА.СуммаАкцизаУменьшение КАК СуммаАкцизаУменьшение,
		               |	СоставНФА.КодВидаТовара КАК КодВидаТовара,
					   |	СоставНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
					   |	СоставНФА.СведенияОбъемноСортовогоУчетаДоИзменения КАК СведенияОбъемноСортовогоУчетаДоИзменения,
					   |	СоставНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК СоставНФА
		               |ГДЕ
		               |	СоставНФА.Ссылка = &Ссылка
		               |	И СоставНФА.Всего <> 0;
					   |
					   |////////////////////////////////////////////////////////////////////////////////
					   |ВЫБРАТЬ
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
					   |ИЗ
					   |	Документ.ИсправительныйСчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК СчетФактураКодыУпаковокМаркируемойПродукции
					   |ГДЕ
					   |	СчетФактураКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицаШапка = МассивРезультатов[0].Выгрузить();
		
		Структура = Новый Структура();
		Структура.Вставить("Шапка",						ТаблицаШапка);
		Структура.Вставить("ТабЧастьНФА",				МассивРезультатов[1].Выгрузить());
		Структура.Вставить("ТабЧастьМаркировкаТоваров", МассивРезультатов[2].Выгрузить());
		
		СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка);
		Структура.Вставить("СтороныСделки", СтороныСделки);
		
		НомерДокумента = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(ТаблицаШапка[0]);
		Структура.Вставить("НомерДокумента", НомерДокумента);
		
		КодыУпаковокИзСФ = Документы.КорректировочныйСчетФактураВыданный.ПолучитьКодыУпаковокИзСФ(ТаблицаШапка[0].ИсправляемыйДокумент);
		Структура.Вставить("КодыУпаковокИзСФ", КодыУпаковокИзСФ);
		
		// Прослеживаемость
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
			Документы.КорректировочныйСчетФактураВыданный.ДобавитьПоказателиПрослеживаемости(ДокументСсылка, Структура.ТабЧастьНФА);
		КонецЕсли;
		// Конец Прослеживаемость
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ПричинаНалогообложения) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнена причина налогообложения.'");
		Сообщить(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Договор) Тогда
		СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
		
		Если НЕ ЗначениеЗаполнено(СвойстваДоговора.ВидОбязательства) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен вид обязательства в договоре'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СвойстваДоговора.ДатаДоговора) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата договора'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ДокументыОбОтгрузке

Функция ДобавитьСведенияДокументыОбОтгрузкеЭДО(ДанныеЭДО, ЭтоУПД)
	
	Шапка						= ДанныеЭДО.Шапка[0];
	ТаблицаСоставНФА			= ДанныеЭДО.ТабЧастьНФА;
	ТаблицаДокументыОбОтгрузке	= ДанныеЭДО.ТабЧастьДокументыОбОтгрузке;
	СтруктураНомераСчетаФактуры	= ДанныеЭДО.НомерДокумента;
	
	Таблица = ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД);
	
	Строка5а = УчетНДС.ПолучитьПредставлениеСтроки5а(Таблица, Шапка.ДатаСчетаФактуры);
	
	ДокументыОбОтгрузке = Новый Структура();
	ДокументыОбОтгрузке.Вставить("Таблица", Таблица);
	ДокументыОбОтгрузке.Вставить("Строка5а", Строка5а);
	
	ДанныеЭДО.Вставить("ДокументыОбОтгрузке", ДокументыОбОтгрузке);
	
КонецФункции

#КонецОбласти

#КонецЕсли
