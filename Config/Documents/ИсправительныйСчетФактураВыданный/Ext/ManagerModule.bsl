Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактураАвто") Тогда
		
		ИдентификаторПостановления = Неопределено;
		
		ИмяМакета = "СчетФактураАвто";
		
		СинонимМакета = "Счет-фактура";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура1096") Тогда
		
		ИдентификаторПостановления = "1096";
		
		ИмяМакета = "СчетФактура1096";
		
		СинонимМакета = "Счет-фактура (1096)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура2023Кв4Прослеж") Тогда
		
		ИдентификаторПостановления = "2023Кв4Прослеж";
		
		ИмяМакета = "СчетФактура2023Кв4Прослеж";
		
		СинонимМакета = "Счет-фактура (534 389-ФЗ)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура534") Тогда
		
		ИдентификаторПостановления = "534";
		
		ИмяМакета = "СчетФактура534";
		
		СинонимМакета = "Счет-фактура (534)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура981") Тогда
		
		ИдентификаторПостановления = "981";
		
		ИмяМакета = "СчетФактура981";
		
		СинонимМакета = "Счет-фактура (981)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура625") Тогда
		
		ИдентификаторПостановления = "625";
		
		ИмяМакета = "СчетФактура625";
		
		СинонимМакета = "Счет-фактура (625)";
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетФактура1137") Тогда
		
		ИдентификаторПостановления = "1137";
		
		ИмяМакета = "СчетФактура1137";
		
		СинонимМакета = "Счет-фактура (1137)";
		
	КонецЕсли;
	
	СтруктураПараметровОбработчика = Новый Структура();
	СтруктураПараметровОбработчика.Вставить("МассивОбъектов",	МассивОбъектов);
	СтруктураПараметровОбработчика.Вставить("ПараметрыПечати",	ПараметрыПечати);
	СтруктураПараметровОбработчика.Вставить("ОбъектыПечати",	ОбъектыПечати);
	СтруктураПараметровОбработчика.Вставить("ПараметрыВывода",	ПараметрыВывода);
	
	ДанныеДокументов = ПолучитьДанныеДокументовДляПечати(СтруктураПараметровОбработчика["МассивОбъектов"]);
	
	ТабДокумент = ВыполнитьПечать(
		СтруктураПараметровОбработчика,
		ДанныеДокументов,
		ИдентификаторПостановления);
			
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СинонимМакета,
		ТабДокумент);
	
КонецПроцедуры

Процедура СформироватьДвиженияПоРегистрам(ДокументОбъект, Отказ) Экспорт
	Движения = ДокументОбъект.Движения;
	Для каждого РегистрДвижения из Движения цикл
		Если ТипЗнч(РегистрДвижения) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
			И ТипЗнч(РегистрДвижения) <> Тип("РегистрСведенийНаборЗаписей.ОперацииСПрослеживаемымиТоварами") Тогда
			РегистрДвижения.Записывать = Истина;
			РегистрДвижения.Очистить();
		КонецЕсли;	
	КонецЦикла;
	
	ОперацияДокумента = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОбъект.Ссылка,Новый Структура("КФО,Операция,Курс,Кратность"));
	//
	Если ЗначениеЗаполнено(ОперацияДокумента.Операция) тогда
		СтруктураШапкиДокумента = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОбъект.Ссылка);
		
		СтруктураШапкиДокумента.Вставить("Ссылка",					ДокументОбъект.Ссылка);
		Если ЗначениеЗаполнено(ОперацияДокумента.КФО) тогда
			СтруктураШапкиДокумента.Вставить("КФО",					ОперацияДокумента.КФО);
		Иначе
			СтруктураШапкиДокумента.Вставить("КФО",					Перечисления.КВД.Бюджет);
		КонецЕсли;	
		СтруктураШапкиДокумента.Вставить("Дата",					ДокументОбъект.Дата);
		СтруктураШапкиДокумента.Вставить("ДокументКорректировки",	ДокументОбъект.Ссылка);
		
		СтруктураШапкиДокумента.Вставить("ЭтоКорректировка",	УчетНДС.ЭтоКорректировка(, ДокументОбъект.ИсправляемыйДокумент));
		СтруктураШапкиДокумента.Вставить("Курс",				ОперацияДокумента.Курс);
		СтруктураШапкиДокумента.Вставить("Кратность",			ОперацияДокумента.Кратность);
		
		ТабОснования = ПолучитьДанныеДляИсходящегоНДСпоДокументу(СтруктураШапкиДокумента);
		
		Отказ = не СформироватьДвижения(СтруктураШапкиДокумента, ТабОснования, Движения);	
		
		Если не Отказ тогда
			УчетНДС.ЗарегестрироватьСчетФактуру(ДокументОбъект.Ссылка,Движения);
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект) Экспорт
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	Отбор.НаДату		= Объект.ДатаИсправления;
	Отбор.Организация	= Объект.Организация;
	
	Отбор.СписокКонтрагентов.Добавить(Объект.Контрагент);
	Отбор.СписокДоговоров.Добавить(Объект.Договор);
	
	ЗаполнитьСписокДокументовЗачетаАванса(Отбор, Объект);
	
	Возврат Отбор;
	
КонецФункции

#Область ДокументыОбОтгрузке

// Составляет применяемую таблицу документов об отгрузке для документа счета-фактуры выданного.
// Применяемая таблица игнорирует фактически хранящиеся документы об отгрузке для УПД и аванса.
// Может отличаться от авто-таблицы документов об отгрузке, см.функцию ПолучитьАвтоТаблицуДокументыОбОтгрузке.
//
// Параметры:
//	Шапка				- Структура			- шапка документа счета-фактуры.
//	ТаблицаСоставНФА	- ТаблицаЗначений	- табличная часть СоставНФА.
//											Может содержать колонку ДокументОснование.
//	ТаблицаДокументыОбОтгрузке	- ТаблицаЗначений	- табличная часть ДокументыОбОтгрузке.
//	СтруктураНомераСчетаФактуры	- Структура	- номер счета-фактуры с учетом префикса обособленного подразделения.
//	ЭтоУПД						- Булево	- признак заполнения УПД (если Истина). Ложь означает заполнение счета-фактуры.
//
// Возвращаемое значение:
//	ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию УчетНДС.НовыйТаблицаДокументыОбОтгрузке()
Функция ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД) Экспорт
	
	Таблица = УчетНДС.НовыйТаблицаДокументыОбОтгрузке();
	
	Если УчетНДСПовтИсп.Аванс(Шапка.ПричинаНалогообложения) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ЭтоУПД Тогда
		ПолныйДиапазонНомеровСтрок = УчетНДС.ФорматироватьДиапазонЧисловыхЗначений(1, ТаблицаСоставНФА.Количество());
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомераСтрок				= ПолныйДиапазонНомеровСтрок;
		НоваяСтрока.НаименованиеДокумента	= НСтр("ru='УПД'");
		НоваяСтрока.НомерДокумента			= СтруктураНомераСчетаФактуры.Номер;
		НоваяСтрока.ДатаДокумента			= НачалоДня(Шапка.ДатаСчетаФактуры);
		
		Возврат Таблица;
	КонецЕсли;
	
	Если ТаблицаДокументыОбОтгрузке.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаДокументыОбОтгрузке Цикл
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
	Иначе
		Таблица = ПолучитьАвтоТаблицуДокументыОбОтгрузке(ТаблицаСоставНФА, Шапка.ИсправляемыйДокумент, Шапка.ДокументКорректировки);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

// Составляет авто-таблицу документов об отгрузке для документа счета-фактуры выданного.
// Авто-таблица составляется по документам-основаниям счета-фактуры.
// Может отличаться от применяемой таблицы документов об отгрузке, см.функцию ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке.
//
// Параметры:
//	ТаблицаСоставНФА		- ТаблицаЗначений	- табличная часть СоставНФА.
//	ИсправляемыйДокумент	- ДокументСсылка	- первоначальный счет-фактура.
//	ДокументКорректировки	- ДокументСсылка	- документ корректировки.
//
// Возвращаемое значение:
//	ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию УчетНДС.НовыйТаблицаДокументыОбОтгрузке()
Функция ПолучитьАвтоТаблицуДокументыОбОтгрузке(ТаблицаСоставНФА, ИсправляемыйДокумент, ДокументКорректировки) Экспорт
	
	Таблица = УчетНДС.НовыйТаблицаДокументыОбОтгрузке();
	
	Если ТаблицаСоставНФА.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсправляемыйДокумент) Или ТипЗнч(ИсправляемыйДокумент) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат Таблица;
	КонецЕсли;
	
	ДокументРеализации = ?(ЗначениеЗаполнено(ДокументКорректировки),
		ДокументКорректировки, 
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсправляемыйДокумент, "ДокументОснование"));
	
	Возврат Документы.СчетФактураВыданный.ПолучитьАвтоТаблицуДокументыОбОтгрузке(ТаблицаСоставНФА, ДокументРеализации);
	
КонецФункции

