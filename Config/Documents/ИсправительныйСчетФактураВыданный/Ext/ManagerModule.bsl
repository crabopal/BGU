// Движения

Функция СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТаблицаДвижений)
	
	Для каждого  ТекСтрока из ТаблицаДвижений цикл
		
		СуммыСторно = ПолучитьСуммыСторно(ТекСтрока);
		
		Если СуммыСторно <> Неопределено Тогда
			
			Если ТекСтрока.МестоРегистрацииСторно = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
				ДвижениеСторно = Движения.КнигаПокупок.Добавить();
			Иначе
				ДвижениеСторно = Движения.КнигаПродаж.Добавить();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, ТекСтрока);
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КФО");
			ДвижениеСторно.Период      = СтруктураШапкиДокумента.Дата;
			ДвижениеСторно.СчетФактура = СтруктураШапкиДокумента.ДокументОснование;
			ДвижениеСторно.СтавкаНДС = ТекСтрока.СтавкаНДСДоИзменения;
			ДвижениеСторно.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
			
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, СуммыСторно);
			
		КонецЕсли;
		
		СуммыДвижения = ПолучитьСуммыДвижения(ТекСтрока, СтруктураШапкиДокумента);
		
		Если СуммыДвижения <> Неопределено Тогда
			
			Если ТекСтрока.МестоРегистрацииДвижения = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
				Движение = Движения.КнигаПокупок.Добавить();
			Иначе
				Движение = Движения.КнигаПродаж.Добавить();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
			ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КФО");
			Движение.Период      = СтруктураШапкиДокумента.Дата;
			Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
			Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
			
			ЗаполнитьЗначенияСвойств(Движение, СуммыДвижения);
			
		КонецЕсли;
		
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Функция СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТаблицаДвижений)
	Для каждого  ТекСтрока из ТаблицаДвижений цикл
		
		СуммыСторно = ПолучитьСуммыСторно(ТекСтрока);
		
		Если СуммыСторно <> Неопределено Тогда
			Если ТекСтрока.МестоРегистрацииСторно = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
				ДвижениеСторно = Движения.ДополнительныеЛистыКнигиПокупок.Добавить();
			Иначе
				ДвижениеСторно = Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, ТекСтрока);
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод, КФО");
			ДвижениеСторно.Период      = СтруктураШапкиДокумента.Дата;
			ДвижениеСторно.СчетФактура = СтруктураШапкиДокумента.ДокументОснование;
			ДвижениеСторно.СтавкаНДС = ТекСтрока.СтавкаНДСДоИзменения;
			ДвижениеСторно.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
			
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, СуммыСторно);
		КонецЕсли;
		
		СуммыДвижения = ПолучитьСуммыДвижения(ТекСтрока, СтруктураШапкиДокумента);
		
		Если СуммыДвижения <> Неопределено Тогда
			
			Если ТекСтрока.МестоРегистрацииДвижения = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
				Движение	= Движения.ДополнительныеЛистыКнигиПокупок.Добавить();
			Иначе
				Движение	= Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
			ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод, КФО");
			Движение.Период      = СтруктураШапкиДокумента.Дата;
			Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
			Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
			
			ЗаполнитьЗначенияСвойств(Движение, СуммыДвижения);
			
		КонецЕсли;
		
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Функция ПолучитьСуммыСторно(СтрокаТаблицы)
	
	СуммаНДС = СтрокаТаблицы["СуммаНДСДоКорректировки"] - СтрокаТаблицы["СуммаНДСДоИзменения"];
	
	СуммаБезНДС = СтрокаТаблицы["СуммаДоКорректировки"] - СтрокаТаблицы["СуммаДоИзменения"];
	
	СуммаНДСВалютная = СтрокаТаблицы["СуммаНДСДоКорректировкиВалютная"] - СтрокаТаблицы["СуммаНДСДоИзмененияВалютная"];
	
	СуммаБезНДСВалютная = СтрокаТаблицы["СуммаДоКорректировкиВалютная"] - СтрокаТаблицы["СуммаДоИзмененияВалютная"];
	
	Если СуммаНДС = 0 И СуммаБезНДС = 0 И СуммаНДСВалютная = 0 И СуммаБезНДСВалютная = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СуммыСторно = Новый Структура();
	СуммыСторно.Вставить("СуммаНДС",			СуммаНДС);
	СуммыСторно.Вставить("СуммаБезНДС",			СуммаБезНДС);
	СуммыСторно.Вставить("СуммаНДСВалютная",	СуммаНДСВалютная);
	СуммыСторно.Вставить("СуммаБезНДСВалютная",	СуммаБезНДСВалютная);
	
	УчетНДС.УстановитьЗнакЧисел(СуммыСторно, "-");
	
	Возврат СуммыСторно;
	
КонецФункции

Функция ПолучитьСуммыДвижения(СтрокаТаблицы, СтруктураШапкиДокумента)
	
	Если СтруктураШапкиДокумента["ЭтоКорректировка"] Тогда
		
		СуммаНДС = СтрокаТаблицы["СуммаНДС"] - СтрокаТаблицы["СуммаНДСДоКорректировки"];
		
		СуммаБезНДС = СтрокаТаблицы["Сумма"] - СтрокаТаблицы["СуммаДоКорректировки"];
		
		СуммаНДСВалютная = СтрокаТаблицы["СуммаНДС"] - СтрокаТаблицы["СуммаНДСДоКорректировкиВалютная"];
		
		СуммаБезНДСВалютная = СтрокаТаблицы["Сумма"] - СтрокаТаблицы["СуммаДоКорректировкиВалютная"];
		
	Иначе
		
		СуммаНДС = СтрокаТаблицы["СуммаНДС"];
		
		СуммаБезНДС = СтрокаТаблицы["Сумма"];
		
		СуммаНДСВалютная = СтрокаТаблицы["СуммаНДСВалютная"];
		
		СуммаБезНДСВалютная = СтрокаТаблицы["СуммаВалютная"];
		
	КонецЕсли;
	
	Если СуммаНДС = 0 И СуммаБезНДС = 0 И СуммаНДСВалютная = 0 И СуммаБезНДСВалютная = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СуммыДвижения = Новый Структура();
	СуммыДвижения.Вставить("СуммаНДС",				СуммаНДС);
	СуммыДвижения.Вставить("СуммаБезНДС",			СуммаБезНДС);
	СуммыДвижения.Вставить("СуммаНДСВалютная",		СуммаНДСВалютная);
	СуммыДвижения.Вставить("СуммаБезНДСВалютная",	СуммаБезНДСВалютная);
	
	УчетНДС.УстановитьЗнакЧисел(СуммыДвижения, "+");
	
	Возврат СуммыДвижения;
	
КонецФункции

Функция СформироватьДвижения(СтруктураШапкиДокумента, ТабОснования, Движения)
	
	Если СтруктураШапкиДокумента.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок Тогда
		Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТабОснования) Тогда
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Если НЕ СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТабОснования) Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Истина;
КонецФункции	

Функция ПолучитьДанныеДляИсходящегоНДСпоДокументу(СтруктураШапкиДокумента)
	
	ДокументСсылка		= СтруктураШапкиДокумента.Ссылка;
	Курс				= СтруктураШапкиДокумента.Курс;
	Кратность			= СтруктураШапкиДокумента.Кратность;
	ЭтоКорректировка	= СтруктураШапкиДокумента.ЭтоКорректировка;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка",			ДокументСсылка);
	Запрос.УстановитьПараметр("Курс",					?(ЗначениеЗаполнено(Курс), Курс, 1));
	Запрос.УстановитьПараметр("Кратность",				?(ЗначениеЗаполнено(Кратность), Кратность, 1));
	Запрос.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	Запрос.УстановитьПараметр("ЭтоКорректировка",		ЭтоКорректировка);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Общая таблица для движений по всем регистрам
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &ЭтоКорректировка И ВсегоДоКорректировки > ВсегоДоИзменения ТОГДА
	|			// Исправляемая выданная корректировка была на уменьшение,
	|			// и поэтому была зарегистрирована в книге покупок
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|	КОНЕЦ													КАК МестоРегистрацииСторно,
	|	ВЫБОР
	|		КОГДА &ЭтоКорректировка И ВсегоДоИзменения > Всего ТОГДА
	|			// Данное исправление выданной корректировки на уменьшение,
	|			// и поэтому должно быть зарегистрировано в книге покупок
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|	КОНЕЦ													КАК МестоРегистрацииДвижения,
	|	СтавкаНДС																КАК СтавкаНДС,
	|	СтавкаНДСДоИзменения													КАК СтавкаНДСДоИзменения,
	|	СтавкаНДСДоКорректировки												КАК СтавкаНДСДоКорректировки,
	|	ВЫРАЗИТЬ(СуммаДоКорректировки * &Курс / &Кратность КАК ЧИСЛО(15,2))			КАК СуммаДоКорректировки,
	|	ВЫРАЗИТЬ(СуммаДоИзменения * &Курс / &Кратность КАК ЧИСЛО(15,2))				КАК СуммаДоИзменения,
	|	ВЫРАЗИТЬ(Сумма * &Курс / &Кратность КАК ЧИСЛО(15,2))						КАК Сумма,
	|	ВЫРАЗИТЬ(СуммаНДСДоКорректировки * &Курс / &Кратность КАК ЧИСЛО(15,2))		КАК СуммаНДСДоКорректировки,
	|	ВЫРАЗИТЬ(СуммаНДСДоИзменения * &Курс / &Кратность КАК ЧИСЛО(15,2))			КАК СуммаНДСДоИзменения,
	|	ВЫРАЗИТЬ(СуммаНДС * &Курс / &Кратность КАК ЧИСЛО(15,2))						КАК СуммаНДС,
	|	ВЫРАЗИТЬ(ВсегоДоКорректировки * &Курс / &Кратность КАК ЧИСЛО(15,2))			КАК ВсегоДоКорректировки,
	|	ВЫРАЗИТЬ(ВсегоДоИзменения * &Курс / &Кратность КАК ЧИСЛО(15,2))				КАК ВсегоДоИзменения,
	|	ВЫРАЗИТЬ(Всего * &Курс / &Кратность КАК ЧИСЛО(15,2))						КАК Всего,
