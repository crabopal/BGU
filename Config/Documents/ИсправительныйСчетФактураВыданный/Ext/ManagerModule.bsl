		|	
		|	// До корректировки
		|	СтавкаНДС										КАК СтавкаНДСДоИзменения,
		|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС И СуммаДоКорректировки <> 0 ТОГДА
		|			ЦенаДоКорректировки - ВЫРАЗИТЬ(СуммаНДСДоКорректировки * (Цена/СуммаДоКорректировки) КАК Число(15,2)) 
		|		ИНАЧЕ
		|			ЦенаДоКорректировки
		|	КОНЕЦ											КАК ЦенаДоИзменения,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
		|			СуммаДоКорректировки - СуммаНДСДоКорректировки
		|		ИНАЧЕ
		|			СуммаДоКорректировки
		|	КОНЕЦ											КАК СуммаДоИзменения,
		|	СуммаНДСДоКорректировки							КАК СуммаНДСДоИзменения,
		|	ВсегоДоКорректировки							КАК ВсегоДоИзменения,
		|	
		|	// После корректировки
		|	СтавкаНДС										КАК СтавкаНДС,
		|	Количество										КАК Количество,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС И Сумма <> 0 ТОГДА
		|			Цена - ВЫРАЗИТЬ(СуммаНДС * (Цена/Сумма) КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Цена
		|	КОНЕЦ											КАК Цена,
		|	ВЫБОР
		|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
		|			Сумма - СуммаНДС
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК Сумма,
		|	СуммаНДС										КАК СуммаНДС,
		|	Всего											КАК Всего,
		|	СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаДоИзменения,
		|	СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура	КАК Номенклатура
		|ГДЕ 
		|	Ссылка = &ДокументОснованиеСсылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура									КАК НФА,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
		|			ВЫРАЗИТЬ(Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
		|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
		|			&ЕдИзмШт
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|	КОНЕЦ											КАК ЕдиницаИзмерения,
		|	
		|	// До корректировки
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДСДоИзменения,
		|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
		|	ВЫБОР
		|		КОГДА КоличествоДоКорректировки <> 0 ТОГДА
		|			ВЫРАЗИТЬ(СуммаДоКорректировки / КоличествоДоКорректировки КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			СуммаДоКорректировки
		|	КОНЕЦ											КАК ЦенаДоИзменения,
		|	СуммаДоКорректировки							КАК СуммаДоИзменения,
		|	0												КАК СуммаНДСДоИзменения,
		|	СуммаДоКорректировки							КАК ВсегоДоИзменения,
		|	
		|	// После корректировки
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДС,
		|	Количество										КАК Количество,
		|	ВЫБОР
		|		КОГДА Количество <> 0 ТОГДА
		|			ВЫРАЗИТЬ(Сумма / Количество КАК ЧИСЛО(15,2))
		|		ИНАЧЕ
		|			Сумма
		|	КОНЕЦ											КАК Цена,
		|	Сумма											КАК Сумма,
		|	0												КАК СуммаНДС,
		|	Сумма											КАК Всего,
		|	"""" КАК СведенияОбъемноСортовогоУчетаДоИзменения,
		|	"""" КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.ВозвратнаяТара
		|ГДЕ
		|	Ссылка = &ДокументОснованиеСсылка	
		|;";
	КонецЕсли;
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Данные шапки
	Шапка = РезультатыЗапроса[0].Выгрузить()[0];
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	Если РезультатыПоиска <> Неопределено Тогда
		ДозаполнитьПоСчетуФактуре(Объект, РезультатыПоиска.Ссылка);
	КонецЕсли;
	
	// [1]. Данные табличной части СоставНФА
	Объект.СоставНФА.Загрузить(РезультатыЗапроса[1].Выгрузить());
	
	Для Каждого СтрокаТаблицы Из Объект.СоставНФА Цикл
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "СуммаНДС");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Всего");
	КонецЦикла;
	
	// Ответственные лица
	УстановитьОтветственныхЛиц(Объект);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыСторонСделки(ДокументОбъект, Знач ОбозначениеСтороны = Неопределено) Экспорт
	
	ШапкаДокумента = Новый Структура("
		|Дата,
		|Контрагент,
		|Организация,
		|Подразделение,
		|Грузоотправитель,
		|Грузополучатель,
		|ПричинаНалогообложения");
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Если НЕ УчетНДС.ЗаполненыОбязательныеРеквизитыДляОпределенияСторонСделки(ШапкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = УчетНДС.РасширитьШапкуДокументаДляОпределенияПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокумента);
	
	ОбщаяКонтактнаяИнформация = УчетНДС.ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["СписокОбъектовДляОпределенияАдресов"]);
	
	СтороныСделки = УчетНДС.ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["ШапкаДокументаРасширенная"],
		ОбщаяКонтактнаяИнформация);
	
	Параметры = Новый Структура();
	
	Если ОбозначениеСтороны = Неопределено ИЛИ ОбозначениеСтороны = "Продавец" Тогда
		Параметры.Вставить("НаименованиеПродавца",	СтороныСделки.Продавец.Наименование);
		Параметры.Вставить("АдресПродавца",			СтороныСделки.Продавец.Адрес.Представление);
		Параметры.Вставить("ИННПродавца",			СтороныСделки.Продавец.ИНН);
		Параметры.Вставить("КПППродавца",			СтороныСделки.Продавец.КПП);
	КонецЕсли;
	
	Если ОбозначениеСтороны = Неопределено ИЛИ ОбозначениеСтороны = "Покупатель" Тогда
		Параметры.Вставить("НаименованиеПокупателя",	СтороныСделки.Покупатель.Наименование);
		Параметры.Вставить("АдресПокупателя",			СтороныСделки.Покупатель.Адрес.Представление);
		Параметры.Вставить("ИННПокупателя",				СтороныСделки.Покупатель.ИНН);
		Параметры.Вставить("КПППокупателя",				СтороныСделки.Покупатель.КПП);
	КонецЕсли;
	
	Если ОбозначениеСтороны = Неопределено ИЛИ ОбозначениеСтороны = "Грузоотправитель" Тогда
		Параметры.Вставить("НаименованиеГрузоотправителя",	СтороныСделки.Грузоотправитель.Наименование);
		Параметры.Вставить("АдресГрузоотправителя",			СтороныСделки.Грузоотправитель.Адрес.Представление);
	КонецЕсли;
	
	Если ОбозначениеСтороны = Неопределено ИЛИ ОбозначениеСтороны = "Грузополучатель" Тогда
		Параметры.Вставить("НаименованиеГрузополучателя",	СтороныСделки.Грузополучатель.Наименование);
		Параметры.Вставить("АдресГрузополучателя",			СтороныСделки.Грузополучатель.Адрес.Представление);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Параметры);
	
КонецПроцедуры

Процедура ЗаполнитьСчетаФактурыНаАванс(Объект)
	
	Отбор = ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект);
	
	ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор);
	
	Объект.СчетаФактурыНаАванс.Загрузить(ТаблицаДокументов);
	
КонецПроцедуры

Процедура ЗаполнитьСписокДокументовЗачетаАванса(Отбор, Объект)
	
	Если ЗначениеЗаполнено(Объект.ДокументКорректировки) Тогда
		ДокументСсылка = Объект.ДокументКорректировки;
	Иначе
		ДокументСсылка = ПолучитьПервичныйДокументПередачиДляСчетаФактуры(Объект.ДокументОснование);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		Отбор.СписокДокументовЗачетаАванса.Добавить(ДокументСсылка);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПервичныйДокументПередачиДляСчетаФактуры(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументОснование");
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
			Возврат ЗначенияРеквизитов.ДокументОснование;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументКорректировки,ДокументОснование");
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументКорректировки) Тогда
			Возврат ЗначенияРеквизитов.ДокументКорректировки;
		КонецЕсли;
		
		Возврат ПолучитьПервичныйДокументПередачиДляСчетаФактуры(ЗначенияРеквизитов.ДокументОснование);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

