#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ЗаполнитьДанныеТЧПоДокументам(МассивДокументов) Экспорт
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Дата КАК ДатаНачисления,
		|	КвитанцияНаОплатуГосуслуг.ВидКвитанции КАК ВидКвитанции,
		|	КвитанцияНаОплатуГосуслуг.ОсновнойИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
		|	КвитанцияНаОплатуГосуслуг.ДополнительныйИдентификаторПлательщика КАК ДополнительныйИдентификаторПлательщика,
		|	КвитанцияНаОплатуГосуслуг.ПонижающийКоэффициент КАК ПонижающийКоэффициент,
		|	КвитанцияНаОплатуГосуслуг.ДатаОкончанияДействияСкидки КАК ДатаОкончанияДействияСкидки,
		|	КвитанцияНаОплатуГосуслуг.ПроцентСкидки КАК ПроцентСкидки,
		|	КвитанцияНаОплатуГосуслуг.КодУФК КАК КодУФК,
		|	КвитанцияНаОплатуГосуслуг.НомерЛицевоСчетаВУФК КАК НомерЛицевоСчетаВУФК,
		|	КвитанцияНаОплатуГосуслуг.ПолучательОГРН КАК ПолучательОГРН,
		|	КвитанцияНаОплатуГосуслуг.НаименованиеОрганизацииПолучателя КАК НаименованиеОрганизацииПолучателя,
		|	КвитанцияНаОплатуГосуслуг.ПричинаАннулирования КАК ПричинаАннулирования,
		|	КвитанцияНаОплатуГосуслуг.СтавкаНДС КАК СтавкаНДС,
		|	КвитанцияНаОплатуГосуслуг.СуммаНДС КАК СуммаНДС,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления,
		|	КвитанцияНаОплатуГосуслуг.СуммаДокумента КАК СуммаДокумента,
		|	КвитанцияНаОплатуГосуслуг.СтатусСоставителя КАК СтатусСоставителя,
		|	КвитанцияНаОплатуГосуслуг.СрокДействия КАК СрокДействия,
		|	КвитанцияНаОплатуГосуслуг.ПолучательНаименованиеБанка КАК ПолучательНаименованиеБанка,
		|	КвитанцияНаОплатуГосуслуг.ПолучательНаименование КАК ПолучательНаименование,
		|	КвитанцияНаОплатуГосуслуг.ПолучательКорСчетБанка КАК ПолучательКорСчетБанка,
		|	КвитанцияНаОплатуГосуслуг.ПолучательКазначейство КАК ПолучательКазначейство,
		|	КвитанцияНаОплатуГосуслуг.ПолучательБИКБанка КАК ПолучательБИКБанка,
		|	КвитанцияНаОплатуГосуслуг.ПолучательБанковскийСчет КАК ПолучательБанковскийСчет,
		|	КвитанцияНаОплатуГосуслуг.ПоказательТипа КАК ПоказательТипа,
		|	КвитанцияНаОплатуГосуслуг.ПоказательПериода КАК ПоказательПериода,
		|	КвитанцияНаОплатуГосуслуг.ПоказательОснования КАК ПоказательОснования,
		|	КвитанцияНаОплатуГосуслуг.ПоказательНомера КАК ПоказательНомера,
		|	КвитанцияНаОплатуГосуслуг.ПоказательДаты КАК ПоказательДаты,
		|	ПРЕДСТАВЛЕНИЕ(КвитанцияНаОплатуГосуслуг.Номенклатура) КАК НаименованиеУслуги,
		|	ПРЕДСТАВЛЕНИЕ(КвитанцияНаОплатуГосуслуг.Плательщик) КАК ПлательщикНаименование,
		|	КвитанцияНаОплатуГосуслуг.НазначениеПлатежа КАК НазначениеПлатежа,
		|	КвитанцияНаОплатуГосуслуг.КПППолучателя КАК КПППолучателя,
		|	КвитанцияНаОплатуГосуслуг.Комментарий КАК КомментарийНачисления,
		|	КвитанцияНаОплатуГосуслуг.КодОКАТО КАК КодОКАТО,
		|	КвитанцияНаОплатуГосуслуг.КодБКПлатежа КАК КодБКПлатежа,
		|	КвитанцияНаОплатуГосуслуг.ИННПолучателя КАК ИННПолучателя,
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК НачислениеСсылка,
		|	КвитанцияНаОплатуГосуслуг.Номер КАК НомерНачисления,
		|	КвитанцияНаОплатуГосуслуг.ФиксированнаяСуммаСкидки КАК ФиксированнаяСуммаСкидки,
		|	КвитанцияНаОплатуГосуслуг.ДатаИзменения КАК ДатаИзменения,
		|	КвитанцияНаОплатуГосуслуг.КодОКВЭД2 КАК КодОКВЭД2,
		|	КвитанцияНаОплатуГосуслуг.НаименованиеОКВЭД2 КАК НаименованиеОКВЭД2,
		|	КвитанцияНаОплатуГосуслуг.Предварительное КАК Предварительное
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивНачислений)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНачисления,
		|	НомерНачисления";
	
	Запрос.УстановитьПараметр("МассивНачислений", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЧДанных = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрДанных Из ТЧДанных Цикл
		
		СтрТЧ = Начисления.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрТЧ,СтрДанных);
		СтрТЧ.ИД_Начисления = "N_"+Строка(СтрТЧ.НачислениеСсылка.УникальныйИдентификатор());
		
	КонецЦикла;
	
	ТЧДанных = Неопределено;
	
	СуммаНачислений = Начисления.Итог("СуммаДокумента");
	КоличествоНачислений = Начисления.Количество();
			
КонецПроцедуры
		
#КонецЕсли