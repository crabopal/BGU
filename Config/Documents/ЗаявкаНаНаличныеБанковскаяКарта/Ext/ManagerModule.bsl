// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличныеБанковскаяКарта";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531243_21н";
	КомандаПечати.Представление		= НСтр("ru = 'Заявка на перечисление средств на карту (ф. 0531243)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличныеБанковскаяКарта";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531243";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на перечисление средств на карту (ф. 0531243) (в ред. 10н)'");
	КомандаПечати.Порядок			= 100;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличныеБанковскаяКарта";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531844";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на перечисление средств на карту (ф. 0531844)'");
	КомандаПечати.Порядок			= 200;
	
		
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531844") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531844",
			"Заявка на перечисление средств на карту", ПечатьФормы(МассивОбъектов, ОбъектыПечати, "0531844"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531243") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531243",
			"Заявка на перечисление средств на карту", ПечатьФормы(МассивОбъектов, ОбъектыПечати, "0531243"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531243_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531243_21н",
			"Заявка на перечисление средств на карту", ПечатьФормы(МассивОбъектов, ОбъектыПечати, "0531243_21н"));
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено)  
		
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
    ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть("Подвал"));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	ВыводимыеОбласти[1].Параметры.Заполнить(ПоляПодвала);
	Попытка
		Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
			ТабДокумент.Вывести(ВыводимыеОбласти[1]);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Если НЕ ШапкаРаздела = Неопределено Тогда
				ТабДокумент.Вывести(ШапкаРаздела);	
			КонецЕсли;	
			Если НЕ Шапка = Неопределено Тогда
				ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	Исключение
//		Сообщить("В системе не установлено ни одного принтера.");
	КонецПопытки;

КонецПроцедуры

// Функция формирует табличный документ Заявка на наличные (ф 0531844)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьФормы(МассивОбъектов, ОбъектыПечати, НомерФормы)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаНаличныеБанковскаяКарта_ЗаявкаНаНаличныеБанковскаяКарта";
	
	Если НомерФормы = "0531844" Тогда
		Макет 										= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаНаличныеБанковскаяКарта.ПФ_MXL_Форма0531844");
	ИначеЕсли НомерФормы = "0531243" Тогда
		Макет 										= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаНаличныеБанковскаяКарта.ПФ_MXL_Форма0531243");
	ИначеЕсли НомерФормы = "0531243_21н" Тогда
		Макет 										= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаНаличныеБанковскаяКарта.ПФ_MXL_Форма0531243_21н");
    КонецЕсли; 
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаНаличныеБанковскаяКарта(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		
		// Раздел 2
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", Новый Структура, ДанныеДляПечати, ,);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.РасшифровкаПлатежа Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_2", );  
		КонецЦикла;
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
