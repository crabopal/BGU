&НаСервере
Функция ИнвентарныйНомерОС(ОрганизацияОС, ОбъектОС)
	Результат = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.ОС = &ОбъектОС
	               |	И ИнвентарныеНомераОС.Владелец = &ОрганизацияОС
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ОрганизацияОС", ОрганизацияОС);	
	Запрос.УстановитьПараметр("ОбъектОС", ОбъектОС);	
	СписокИнвНомеров = Запрос.Выполнить().Выгрузить();
	
	Если СписокИнвНомеров.Количество() = 1 Тогда
		Результат = СписокИнвНомеров[0].Ссылка;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗаполнитьДокументПоДокументуСписанияНФА(ДокументСписанияДргМатериалов, ОбъектНФА, ИнвНомер)
	Объект.Основание = "Акт списания материалов";
	Объект.НомерОснования = ДокументСписанияДргМатериалов.Номер;
	Объект.ДатаОснования = ДокументСписанияДргМатериалов.Дата;
	
	Для каждого ТекСтрока Из ДокументСписанияДргМатериалов.ДрагоценныеМатериалы Цикл
		НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ОбъектНФА = ОбъектНФА;
		НоваяСтрока.ИнвНомер = ИнвНомер;
		НоваяСтрока.ВидДвиженияДМ = Перечисления.ВидыДвиженийДрагМатериалов.ПринятиеКУчету;
		НоваяСтрока.Примечание = СокрЛП(ДокументСписанияДргМатериалов);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериалов()
	
	Если НЕ Объект.ВидОперацийНаличияДрагМатериалов = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ДрагоценныеМатериалы Цикл
	
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.МатериальнаяЦенностьЗаголовок = НСтр("ru = 'Материальная ценность:'");
	ТекущаяСтрока.КоличествоМЦЗаголовок 		= НСтр("ru = 'Количество:'"); 
	
	ЕдиницаИзм = ПолучитьЕдиницуИзмеренияМатериальнойЦенности(ТекущаяСтрока.ОбъектМЦ);
	
	ТекущаяСтрока.ЕдиницаИзмерения = ЕдиницаИзм;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЕдиницуИзмеренияМатериальнойЦенности(Знач ОбъектМЦ)
	
	Если ТипЗнч(ОбъектМЦ) = Тип("СправочникСсылка.ОсновныеСредства") ИЛИ Не ЗначениеЗаполнено(ОбъектМЦ) Тогда 
		ЕдиницаИзм = УчетДрагМатериалов.Штуки();
	Иначе
		Если ЗначениеЗаполнено(ОбъектМЦ.ЕдиницаИзмерения) Тогда
			ЕдиницаИзм = ОбъектМЦ.ЕдиницаИзмерения; 
		Иначе
			ЕдиницаИзм = УчетДрагМатериалов.Штуки(); 
		КонецЕсли;
	КонецЕсли;
	Возврат ЕдиницаИзм;

КонецФункции

