&НаСервере
Процедура СкорректироватьСведенияВводаОстатковОСГрупповойУчетНаСервере()
	ОС = Новый ТаблицаЗначений;
	ОС.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ОС.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ОС.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ОС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	ДатаСведений = Объект.Дата + 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	               |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	               |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	               |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала
	               |ПОМЕСТИТЬ ОССГрупповымУчетом
	               |ИЗ
	               |	Документ.ИзменениеНаличияДрагМатериалов.ДрагоценныеМатериалы КАК ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы
	               |ГДЕ
	               |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка = &Ссылка
	               |	И ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА КАК Справочник.ОсновныеСредства).ГрупповойУчет = ИСТИНА
	               |	И НЕ ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОССГрупповымУчетом.НомерСтроки КАК НомерСтроки,
	               |	ОССГрупповымУчетом.ОбъектНФА КАК ОбъектНФА,
	               |	ОССГрупповымУчетом.ИнвНомер КАК ИнвНомер,
	               |	ОССГрупповымУчетом.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия
	               |ИЗ
	               |	ОССГрупповымУчетом КАК ОССГрупповымУчетом
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(&ДатаСведений, Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)) КАК СобытияОССрезПоследних
	               |		ПО ОССГрупповымУчетом.ОбъектНФА = СобытияОССрезПоследних.ОсновноеСредство
	               |			И ОССГрупповымУчетом.ИнвНомер = СобытияОССрезПоследних.ИнвНомер";
	
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоУдаленныхЭлементов = 0;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ДатаСобытия) Тогда
			Объект.ДрагоценныеМатериалы.Удалить(Выборка.НомерСтроки - 1 - КоличествоУдаленныхЭлементов);
			КоличествоУдаленныхЭлементов = КоличествоУдаленныхЭлементов + 1;
		Иначе
			НоваяСтрока = ОС.Добавить();
			НоваяСтрока.ОбъектНФА = Выборка.ОбъектНФА;
			НоваяСтрока.ИнвНомер = Выборка.ИнвНомер;
			НоваяСтрока.ВидДрагМатериала = Выборка.ВидДрагМатериала;
			НоваяСтрока.Количество = 1;
		КонецЕсли;
	КонецЦикла;	

	ОС.Свернуть("ОбъектНФА, ВидДрагМатериала", "Количество");
	
	ПризнакКорректировки = НСтр("ru='Корректировка ошибки переноса данных'");
	
	Для Каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		Если СтрНайти(ТекСтрока.Примечание, ПризнакКорректировки) = 0 Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОбъектНФА);
			ПараметрыОтбора.Вставить("ВидДрагМатериала", ТекСтрока.ВидДрагМатериала);
			НайденныеСтроки = ОС.НайтиСтроки(ПараметрыОтбора);   

			Если НайденныеСтроки.Количество() > 0 Тогда
				КоличествоОС = НайденныеСтроки[0].Количество;
				НекорректнаяМасса = ТекСтрока.МассаДМ;
				НекорректноеКоличество = ТекСтрока.КоличествоДМ;
				
				КорректнаяМасса = НекорректнаяМасса / КоличествоОС;
				КорректноеКоличество = НекорректноеКоличество / КоличествоОС;
				
				ТекСтрока.МассаДМ = КорректнаяМасса;
				ТекСтрока.КоличествоДМ = КорректноеКоличество;
				
				СтароеПримечание = ТекСтрока.Примечание;
				Если ЗначениеЗаполнено(СтароеПримечание) Тогда
					ТекСтрока.Примечание = СтрШаблон("%1 %2", СтароеПримечание, ПризнакКорректировки);
				Иначе
					ТекСтрока.Примечание = "Корректировка ошибки переноса данных";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

