&НаСервере
Процедура ПодготовитьФормуНаСервере() 
	
	ВестиУчетДрагМатериаловМЦВКапвложениях = 
		Объект.ВидОперацийНаличияДрагМатериалов = 1 ИЛИ УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений();
		
	Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено; 
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтаФорма); 
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериалов();
	ЗаполнитьОбъектыСДрагМатериалами();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);   
	
КонецПроцедуры

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0)И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе	
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ЭтоКапвложение", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);
	
	СписокКолонок = "ОбъектНФА, ИнвНомер, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЧистаяМасса, ЛигатурнаяМасса, ЕдИзм";
	Если Объект.ВидОперацийНаличияДрагМатериалов = 1 Тогда
		СписокКолонок = "ОбъектНФА, ОбъектМЦ, КоличествоМЦ, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЕдИзм";
	КонецЕсли;
	
	ТаблицаОС = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок, СписокКолонок);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ПараметрыПодбора.ОбъектНФА);
	Если Объект.ВидОперацийНаличияДрагМатериалов <> 1 Тогда 
		ПараметрыОтбора.Вставить("ИнвНомер", ПараметрыПодбора.ИнвНомер); 
	КонецЕсли;
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);   	
	
	Возврат НайденныеСтроки;
КонецФункции	

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
		Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , 
		?(Объект.ВидОперацийНаличияДрагМатериалов = 1, "ОбъектНФА,ОбъектМЦ,ВидДрагМатериала", "ОбъектНФА,ИнвНомер,ВидДрагМатериала"));
		
	Для Каждого	ТекСтрока Из ДобавленныеСтроки Цикл
		ТекСтрока.ВидДвиженияДМ = Перечисления.ВидыДвиженийДрагМатериалов.ПринятиеКУчету;
	КонецЦикла;		
КонецПроцедуры

&НаСервере
Функция СтруктураПараметровПолученияОстатков()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка",Объект.Ссылка);
	СтруктураПараметров.Вставить("Период",Объект.Дата);
	
	Если Объект.Ссылка.Пустая() Тогда
		СтруктураПараметров.Период = КонецДня(Объект.Дата);
	Иначе
		СтруктураПараметров.Период = Объект.Дата;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции	

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)

	КоллекцияОС = Объект.СписокНФАДокументаОснования;
	КолонкиПоиска = "ОбъектНФА";
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ТаблицаОС.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
	ТаблицаОС.Колонки.КоличествоОстаток.Имя = "КоличествоВсего";
	
	ИсходныеДанные = КоллекцияОС.Выгрузить();
	ИсходныеДанные.Индексы.Добавить(КолонкиПоиска);
	
	ДобавленныеСтроки = Новый Массив;
	СтруктураПоиска = Новый Структура(КолонкиПоиска);

	КоллекцияОС.Очистить();
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		СтрокаТаблицыОС.Количество = 1;
		СтрокаТаблицыОС.КоличествоВсего = 1;
		
		ЭлементКоллекции = КоллекцияОС.Добавить();
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицыОС);
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0]);
		Иначе
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
	КонецЦикла;

	Для Каждого ТекущаяСтрока Из ДобавленныеСтроки Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
			
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	КонтрольЗаполненияСпискаОбъектовНФА();
	
	ПараметрыПолученияОстатков = СтруктураПараметровПолученияОстатков();
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);

	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
КонецПроцедуры	

&НаСервере
Процедура КонтрольЗаполненияСпискаОбъектовНФА()
	
	Для каждого ТекСтрока Из Объект.СписокНФАДокументаОснования Цикл
		Если ТекСтрока.Количество = 0 Тогда
			Если (ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства")) Тогда
				ТекстОшибки = НСтр("ru='В списке ""Объекты НФА, содержащие драг. материалы"" для объекта основных средств ""%1"" (инв. № %2) не указано количество изменяемых объектов в строке %3'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер, ТекСтрока.НомерСтроки);
			Иначе
				ТекстОшибки = НСтр("ru='В списке ""Объекты НФА, содержащие драг. материалы"" для номенклатуры ""%1"" не указано количество изменяемых объектов в строке %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "ГруппаНФАДокументаОснования", "Объект", );
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	
	ТаблицаСписанияОбъектов = Объект.СписокНФАДокументаОснования.Выгрузить(,"ОбъектНФА, ИнвНомер, Количество");
	
	Если Объект.ВидОперацийНаличияДрагМатериалов = 1 Тогда
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	Иначе
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписания(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	КонецЕсли;

	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.СписокНФАДокументаОснования Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОбъектНФА);
		Если Объект.ВидОперацийНаличияДрагМатериалов <> 1 Тогда
			ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвНомер);
		КонецЕсли;
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);		
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсего = ТекСтрокаМассива.КоличествоВсего; 
				Прервать;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Объект 	 = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВидОперацийНаличияДрагМатериалов", "Видимость", Форма.ВестиУчетДрагМатериаловМЦВКапвложениях);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "БухгалтерскаяОперация", "Видимость", Форма.ВестиУчетДрагМатериаловМЦВКапвложениях);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаМЦ", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыИнвНомер", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияИнвНомер", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокДрагМатериаловВЛомеИОтходах", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаЗаполнить", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);   
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыЗаполнитьСписокДМДляСписанияКапвложений", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияГруппаДобавить", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);   
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияДобавитьСписокДМДляКапвложения", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияДобавитьЛомОтходыДМДляОбъекта", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияГруппаПодобрать", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыСкорректироватьСведенияВводаОстатковОСГрупповойУчет", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов <> 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияКФО", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокНФАДокументаОснованияЦМО", "Видимость", Объект.ВидОперацийНаличияДрагМатериалов = 1); 
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Изменить:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Объект = Форма.Объект;
	
	Для каждого ТекущаяСтрока Из Объект.СписокНФАДокументаОснования Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧСписокНФАДокументаОснования(МассивДокументов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПоступлениеОСКапВложения.КФО КАК КФО,
	               |	ВЫРАЗИТЬ(ПоступлениеОСКапВложения.Ссылка КАК Документ.ПоступлениеОС).ЦМО КАК ЦМО,
	               |	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК ОбъектНФА,
	               |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	               |	ВЫБОР
	               |		КОГДА ПоступлениеОСКапВложения.Количество = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ПоступлениеОСКапВложения.Количество
	               |	КОНЕЦ КАК КоличествоВсего,
	               |	ВЫБОР
	               |		КОГДА ПоступлениеОСКапВложения.Количество = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ПоступлениеОСКапВложения.Количество
	               |	КОНЕЦ КАК Количество
	               |ИЗ
	               |	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	               |ГДЕ
	               |	ПоступлениеОСКапВложения.Ссылка В(&МассивДокументовПоступления)
	               |	И ВЫРАЗИТЬ(ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК Справочник.ОсновныеСредства).ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.КапВложения)"; 
	
	Запрос.УстановитьПараметр("МассивДокументовПоступления", МассивДокументов); 
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.СписокНФАДокументаОснования.Загрузить(Результат);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	ЗаполнитьОбъектыСДрагМатериалами();
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперации");
	СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("ЦМО", "МОЛ/Место хранения");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

 &НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"					, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("Счет"							, "106.00"); 
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"						, ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
	ПараметрыПодбора.Вставить("Период"								, Объект.Дата);
	ПараметрыПодбора.Вставить("СкрытьКолонки"						, "ГрупповойУчет,ИнвентарныйНомер,Договор,Контрагент,СуммаАмортизации,СуммаОбесценения");
	ПараметрыПодбора.Вставить("ВидРаспоряжения"						, "Вложения");
	ПараметрыПодбора.Вставить("НеИспользоватьПредопределенныеКолонки"	, Истина);
	
	Если Объект.СписокНФАДокументаОснования.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.СписокНФАДокументаОснования.Выгрузить();
	ТаблицаОС.Колонки.ОбъектНФА.Имя = "ОсновноеСредство";
	ТаблицаОС.Колонки.КоличествоВсего.Имя = "КоличествоОстаток";
	
	ТаблицаОС.Колонки.Добавить("ВидНФА");
	
	Для Каждого Элемент Из ТаблицаОС Цикл
		 Элемент.ВидНФА = Перечисления.ВидыНФА.КапВложения;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.СписокНФАДокументаОснования; 
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер); 
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", ?(Объект.ВидОперацийНаличияДрагМатериалов = 1,
							Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"), УчетДрагМатериалов.ТипОбъектаНФА()));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = Объект.СписокНФАДокументаОснования.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.ОбъектНФА;
		НоваяСтрока.ИнвНомер = ?(Объект.ВидОперацийНаличияДрагМатериалов = 1,
										СтрокаТЧ.ИнвНомер.ПустаяСсылка(), СтрокаТЧ.ИнвНомер);
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции	

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);

КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
КонецФункции	

