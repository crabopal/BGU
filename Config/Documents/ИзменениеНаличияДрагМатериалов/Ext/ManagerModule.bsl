#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
		Запрос.Текст =    "ВЫБРАТЬ
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка.Дата КАК Период,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Регистратор,
		                  |	ВЫБОР
		                  |		КОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.ПринятиеКУчету)
		                  |			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		                  |		КОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.Списание)
		                  |			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		                  |	КОНЕЦ КАК ВидДвижения,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
		                  |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).Организация КАК Организация,
		                  |	ВЫБОР
		                  |		КОГДА ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).ВидОперацийНаличияДрагМатериалов = 1
		                  |			ТОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектМЦ
		                  |		ИНАЧЕ ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА
		                  |	КОНЕЦ КАК ОбъектНФА,
		                  |	ВЫБОР
		                  |		КОГДА ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).ВидОперацийНаличияДрагМатериалов = 1
		                  |			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) 
		                  |		ИНАЧЕ ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер
		                  |	КОНЕЦ КАК ИнвНомер,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
		                  |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).Основание КАК Основание,
		                  |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).НомерОснования КАК НомерОснования,
		                  |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).ДатаОснования КАК ДатаОснования,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.АналитикаОперации КАК АналитикаОперации
		                  |ИЗ
		                  |	Документ.ИзменениеНаличияДрагМатериалов.ДрагоценныеМатериалы КАК ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы
		                  |ГДЕ
		                  |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка = &Ссылка
		                  |	И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.МассаДМ > 0
		                  |
		                  |УПОРЯДОЧИТЬ ПО
		                  |	НомерСтроки";
						  
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + 
						    "ВЫБРАТЬ
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка.Дата КАК Период,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Регистратор,
						    |	ВЫБОР
						    |		КОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.ПринятиеКУчету)
						    |			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
						    |		КОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.Списание)
						    |			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
						    |	КОНЕЦ КАК ВидДвижения,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
						    |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).Организация КАК Организация,
						    |	ВЫБОР
						    |		КОГДА ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).ВидОперацийНаличияДрагМатериалов = 1
						    |			ТОГДА ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектМЦ
						    |		ИНАЧЕ ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА
						    |	КОНЕЦ КАК ОбъектНФА,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
						    |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЧистаяМасса КАК ЧистаяМасса,
						    |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).Основание КАК Основание,
						    |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).НомерОснования КАК НомерОснования,
						    |	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Документ.ИзменениеНаличияДрагМатериалов).ДатаОснования КАК ДатаОснования,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
						    |ИЗ
						    |	Документ.ИзменениеНаличияДрагМатериалов.ДрагоценныеМатериалы КАК ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы
						    |ГДЕ
						    |	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка = &Ссылка
						    |	И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЛигатурнаяМасса + ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЧистаяМасса > 0
						    |
						    |УПОРЯДОЧИТЬ ПО
						    |	НомерСтроки";
						  
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	НаличиеДрагМатериаловВОбъектахНФА =	РезультатЗапроса[0].Выгрузить();
	НаличиеДрагМатериаловВЛомеИОтходах = РезультатЗапроса[1].Выгрузить();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("НаличиеДрагМатериаловВОбъектахНФА",  НаличиеДрагМатериаловВОбъектахНФА);
	ТаблицыДляДвижений.Вставить("НаличиеДрагМатериаловВЛомеИОтходах",  НаличиеДрагМатериаловВЛомеИОтходах);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОбИзмененииСодержанияДрагМатериалов", 1);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОбИзмененииСодержанияДрагМатериалов") Тогда
	
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОбИзмененииСодержанияДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОбИзмененииСодержанияДрагМатериалов","Справка об изменении содержания драг. материалов", ТабличныйДокумент);
			
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
	
#КонецЕсли
