#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ИзменениеНаличияДрагМатериалов.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Движения по регистрам сведений
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НаличиеДрагМатериаловВОбъектахНФА");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НаличиеДрагМатериаловВЛомеИОтходах");

	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	ОбъектыСГрупповымИИнвентарнымУчетом = ТаблицаГрупповыхОбъектовОССИнвНомерами(ОбъектыДМ);
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В списке ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1"" в строке %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		Если (ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства"))И((ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0)) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" для основного средства недопустимо заполнение реквизитов ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		//для ОС с групповым учетом и несколькими инв.номерами указали содержание драг. материалов без инвентарных номеров
		Если (ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства")) Тогда
			Если ТекСтрока.ОбъектНФА.ГрупповойУчет И НЕ ЗначениеЗаполнено(ТекСтрока.ИнвНомер) Тогда
				Если ОбъектыСГрупповымИИнвентарнымУчетом.Найти(ТекСтрока.ОбъектНФА, "ОбъектНФА") <> Неопределено Тогда
					ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" для объекта основных средств с групповым учетом не указан инвентарный номер: ""%1""'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры	

Функция ТаблицаГрупповыхОбъектовОССИнвНомерами(ОбъектыДМ)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА
	               |ПОМЕСТИТЬ ДМ
	               |ИЗ
	               |	&ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	               |ГДЕ
	               |	ДрагоценныеМатериалы.ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДМ.ОбъектНФА,
	               |	ИнвентарныеНомераОС.Ссылка КАК ИнвНомер
	               |ПОМЕСТИТЬ ОСГрУчетИнвУчет
	               |ИЗ
	               |	ДМ КАК ДМ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |		ПО ДМ.ОбъектНФА = ИнвентарныеНомераОС.ОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	               |	И ВЫРАЗИТЬ(ДМ.ОбъектНФА КАК Справочник.ОсновныеСредства).ГрупповойУчет = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОСГрУчетИнвУчет.ОбъектНФА
	               |ИЗ
	               |	ОСГрУчетИнвУчет КАК ОСГрУчетИнвУчет";
	Запрос.УстановитьПараметр("ДрагоценныеМатериалы",ОбъектыДМ);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#КонецЕсли
