&НаСервере
Процедура ИнициализироватьФорму()
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	СтатусыЗадолженностиДопускающиеРеклассификацию.ЗагрузитьЗначения(
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыЗадолженностиДопускающиеРеклассификацию());
	
	СтатусыЗадолженностиДопускающиеОтражениеПросроченной.ЗагрузитьЗначения(
		ИнвентаризацияКлиентСервер.ПолучитьСтатусыЗадолженностиДопускающиеОтражениеПросроченной());
		
	СпискиЗабалансовыхСчетов = Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьСпискиЗабалансовыхСчетов();
	
	ЗабалансовыеСчета.ЗагрузитьЗначения(СпискиЗабалансовыхСчетов.Все);
	
	Счета04.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("04"));
	Счета20.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("20"));
	Счета30300.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("303.00"));
	
	// Значения настроек из общего модуля.
	ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной =
		ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной();
		
	ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности =
		ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности();
	
	ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме =
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	НастроитьНедоступностьИзмененияКолонок();
	
	ИменаПолейБезОткрытияФормыРазбивкиСтроки.ЗагрузитьЗначения(
		Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьИменаПолейРаздела2РедактируемыхБезОткрытияФормыРазбивкиСтроки());
		
	ЗаполнитьСпискиВыбораКодаПричиныОбразования();
	
	УстановитьУсловноеОформление();
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ЗаполнитьСлужебныеКолонки(ЭтотОбъект);
	
	УстановитьПредставлениеНомераКомиссии();
	
	УстановитьПредставлениеМестаПроведения();
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
	НастроитьОтборПоПодразделению();
	
	ДебиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	КредиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.УстановитьУсловноеОформление(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровкуСтрокиРаздела(ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Счет) Тогда
		Возврат;
	КонецЕсли;
	
	Если Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено Тогда
		ОткрытьОтчетАнализЗадолженности30300(ИмяТЧ, ТекДанные);
	Иначе
		Если Не ЗначениеЗаполнено(ТекДанные.Договор) Тогда
			Возврат;
		КонецЕсли;
		
		ОткрытьОтчетАнализЗадолженности(ИмяТЧ, ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетАнализЗадолженности(ИмяТЧ, ТекДанные)
	
	Если ИмяТЧ = "Раздел11" Или ИмяТЧ = "Раздел21" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская");
		
	ИначеЕсли ИмяТЧ = "Раздел12" Или ИмяТЧ = "Раздел22" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская");
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	
	// В отчете дата задается не границей, а датой.
	ПараметрыФормы.Вставить("ДатаОтчета",						ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации));
	ПараметрыФормы.Вставить("Организация",						Объект.Организация);
	ПараметрыФормы.Вставить("ВидЗадолженности",					ВидЗадолженности);
	ПараметрыФормы.Вставить("ВидЗадолженностиИспользование",	Истина);
	ПараметрыФормы.Вставить("Контрагент",						ТекДанные.Контрагент);
	ПараметрыФормы.Вставить("Договор",							ТекДанные.Договор);
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки",	"ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов",			ТекДанные.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС",					ТекДанные.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО",					ТекДанные.КФО);
	ПараметрыФормы.Расшифровка.Вставить("ИФО",					ТекДанные.ИФО);
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, ТекДанные.ИсходныйНомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетАнализЗадолженности30300(ИмяТЧ, ТекДанные)
	
	// В отчете указывается стандартный период, а не одна дата.
	ДатаОпределенияЗадолженности = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации);
	
	Период = Новый СтандартныйПериод(НачалоДня(ДатаОпределенияЗадолженности), КонецДня(ДатаОпределенияЗадолженности));
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура());
	ПараметрыФормы.Отбор.Вставить("Период",					Период);
	ПараметрыФормы.Отбор.Вставить("Организация",			Объект.Организация);
	ПараметрыФормы.Отбор.Вставить("ВидНалогаИлиПлатежа",	ТекДанные.ВидНалогаИПлатежа);
	ПараметрыФормы.Отбор.Вставить("Счет30300",				ТекДанные.Счет);
	ПараметрыФормы.Отбор.Вставить("КПС",					ТекДанные.КПС);
	ПараметрыФормы.Отбор.Вставить("КФО",					ТекДанные.КФО);
	
	Если ЗначениеЗаполнено(ТекДанные.НалогИПлатежОрганизации) Тогда
		ПараметрыФормы.Отбор.Вставить("НалогСборПлатеж", ТекДанные.НалогИПлатежОрганизации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ИФО) Тогда
		ПараметрыФормы.Отбор.Вставить("ИФО", ТекДанные.ИФО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Подразделение) Тогда
		ПараметрыФормы.Отбор.Вставить("Подразделение", ТекДанные.Подразделение);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженностиПоПлатежамВБюджеты.Форма", ПараметрыФормы, ЭтотОбъект, ТекДанные.ИсходныйНомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСписокВыбораСтатусаЗадолженности(ИмяТЧ)
	
	СписокВыбора = Элементы[ИмяТЧ + "СтатусЗадолженности"].СписокВыбора;
	
	СписокВыбора.Очистить();
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Счет) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоДебиторскаяЗадолженность = (ИмяТЧ = "Раздел21");
	
	ЭтоЗабалансовыйСчет = (ЗабалансовыеСчета.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоДебиторскаяЗадолженность Тогда
		Если ЭтоЗабалансовыйСчет Тогда
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиЗабалансовыеСчета();
		Иначе
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
		КонецЕсли;
	Иначе
		Если ЭтоЗабалансовыйСчет Тогда
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыКредиторскойЗадолженностиЗабалансовыеСчета();
		Иначе
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыКредиторскойЗадолженностиБалансовыеСчета();
		КонецЕсли;
	КонецЕсли;
	
	СписокВыбора.ЗагрузитьЗначения(Список);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНомераКомиссии()
	
	ПредставлениеНомераКомиссии = "";
	
	Если ЗначениеЗаполнено(Объект.НомерКомиссии) Или ЗначениеЗаполнено(Объект.НомерРабочейКомиссии) Тогда
		ПредставлениеНомераКомиссии = ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(Объект.НомерКомиссии, Объект.НомерРабочейКомиссии);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеМестаПроведения()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеМестаПроведения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеСпискаСчетов(СписокСчетов, МаксимальнаяДлинаСтроки = 50)
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаТаблицы.КФО), Строка(СтрокаТаблицы.КФО), "0"),
			Строка(СтрокаТаблицы.Счет)));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Представление = НСтр("ru='<отсутствует>'");
	Иначе
		Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "), МаксимальнаяДлинаСтроки);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

&НаСервере
Функция НужноЗаблокироватьРеквизиты()
	
	Возврат ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект)
		Или ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьВидНалогиИПлатежаВместоКонтрагента(Элемент, СтандартнаяОбработка)
	
	ИмяТЧ = СтрЗаменить(Элемент.Имя, "Контрагент", "");
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Контрагент) И ЗначениеЗаполнено(ТекДанные.ВидНалогаИПлатежа) Тогда
		ПоказатьЗначение(, ТекДанные.ВидНалогаИПлатежа);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодИПояснениеПричиныОбразованияВСтрокеТаблицы(СтрокаТаблицы, Знач ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекКФО = СтрокаТаблицы.КФО;
	КодПричины = Лев(ВыбранноеЗначение, 2);
	ТекстПричиныПоСписку = Сред(ВыбранноеЗначение, 6);
	
	ТекстПричины = БухгалтерскийУчетКлиент.СоответсвиеПричиныЗадолженностиПоКодуКФО(ТекстПричиныПоСписку, КодПричины, ТекКФО);
	
	СтрокаТаблицы.ПричинаОбразованияКод = КодПричины;
	СтрокаТаблицы.ПричинаОбразованияПояснение = ТекстПричины;
	
КонецПроцедуры

#Область ПанельРасписки

&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	
	НастроитьДоступностьРазделов();

	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРазделов()
	
	ЭтоОбычныйДокумент			= ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект);
	ЭтоЗаголовочныйДокумент		= ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект);
	ЭтоСодержательныйДокумент	= ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект);
	
	Если ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент Тогда
		РаспискаПроведена = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;
	Иначе
		РаспискаПроведена = Ложь;
	КонецЕсли;
	
	// Видимость закладок
	
	Элементы.ГруппаРаздел1.Видимость				= ЭтоОбычныйДокумент Или ЭтоСодержательныйДокумент;
	Элементы.ГруппаРаздел2.Видимость				= ЭтоОбычныйДокумент Или ЭтоСодержательныйДокумент;
	Элементы.ГруппаСписокДокументовСерии.Видимость	= ЭтоЗаголовочныйДокумент;
	Элементы.ГруппаКомиссия.Видимость				= ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент;
	
	// Команды заполнения
	
	Элементы.ГруппаРаздел1Заполнить.Доступность = РаспискаПроведена;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ЗаполнитьРаздел2");
	ИменаЭлементов.Добавить("РасшифроватьРаздел11");
	ИменаЭлементов.Добавить("РасшифроватьРаздел12");
	ИменаЭлементов.Добавить("РасшифроватьРаздел21");
	ИменаЭлементов.Добавить("РасшифроватьРаздел22");
	ИменаЭлементов.Добавить("ГрупповоеЗаполнениеСтрокРаздел21");
	ИменаЭлементов.Добавить("ГрупповоеЗаполнениеСтрокРаздел22");
	ИменаЭлементов.Добавить("РазбитьСтрокуРаздела21");
	ИменаЭлементов.Добавить("РазбитьСтрокуРаздела22");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		РаспискаПроведена Или ЭтоСодержательныйДокумент);
	
	// СерииДокументов
	Если ЭтоСодержательныйДокумент Тогда
		// Только просмотр реквизитов шапки для содержательных документов
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить("Организация");
		ИменаЭлементов.Добавить("Подразделение");
		ИменаЭлементов.Добавить("ИФО");
		ИменаЭлементов.Добавить("РешениеОПроведенииИнвентаризации");
		ИменаЭлементов.Добавить("ОтветственныйИсполнитель");
		ИменаЭлементов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов,
			"ТолькоПросмотр",
			Истина);
	КонецЕсли;
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

#Область РешениеОПроведенииИнвентаризации

&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтотОбъект, РезультатВыбора);
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
	Объект.Раздел11.Очистить();
	Объект.Раздел12.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

#Область ПанельСерииДокументов

&НаСервере
Процедура НастроитьФормуПоСерииДокументов()
	
	НастроитьПанельСерииДокументовСервер();
	
	Если Объект.СписокДокументовСерии.Количество() > 0 Тогда
		ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии();
	КонецЕсли;
	
	НастроитьДоступностьРазделов();

КонецПроцедуры

&НаСервере
Процедура НастроитьПанельСерииДокументовСервер()
	
	ИнвентаризацияСервер.НастроитьПанельСерииДокументовНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии()
	
	ИнвентаризацияСервер.ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии(ЭтотОбъект);
	
	ИтогКоличествоСтрокРаздел11 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел11");
	ИтогКоличествоСтрокРаздел12 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел12");
	ИтогКоличествоСтрокРаздел21 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел21");
	ИтогКоличествоСтрокРаздел22 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел22");
	
КонецПроцедуры

#КонецОбласти

#Область УдалениеСодержательныхДокументов

// Пометка удаления

&НаКлиенте
Процедура ПодтвердитьИУдалитьДокументыСерииЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		УдалитьДокументыСерииКлиент(ДополнительныеПараметры.ЗначениеПометкиУдаления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДокументыСерииКлиент(ЗначениеПометкиУдаления)
	
	УдалитьДокументыСерииСервер(ЗначениеПометкиУдаления);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьДокументыСерииСервер(ЗначениеПометкиУдаления)
	
	ИнвентаризацияСервер.УстановитьПометкуУдаленияСодержательныхДокументовСерии(Объект, ЗначениеПометкиУдаления);
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
КонецПроцедуры

// Очистка и пометка удаления

&НаКлиенте
Процедура ПодтвердитьОчиститьИУдалитьДокументыСерииЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОчиститьИУдалитьДокументыСерииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИУдалитьДокументыСерииКлиент()
	
	ОчиститьИУдалитьДокументыСерииСервер();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьИУдалитьДокументыСерииСервер()
	
	ИнвентаризацияСервер.ОчиститьСодержательныеДокументыСерии(Объект);
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРазделов

#Область Раздел1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент(Команда, РежимЗаполнения = 0)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("РежимЗаполнения", РежимЗаполнения);
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтотОбъект,
		НСтр("ru = 'Заполнить по данным бух.учета'"),
		"ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента",
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел11.Количество() > 0 Или Объект.Раздел12.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличные части документа будут очищены.
			|
			|Продолжить и заполнить разделы 1.1 и 1.2?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(ДополнительныеПараметры.РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(ОписаниеОповещения.РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(РежимЗаполнения)
	
	Перем Отказ;
	
	ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(РежимЗаполнения, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент(РежимЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(Знач РежимЗаполнения, Отказ)
	
	Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПроверитьПередЗаполнениемРаздела1(Объект, РежимЗаполнения, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент(РежимЗаполнения)
	
	Объект.Раздел11.Очистить();
	Объект.Раздел12.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	
	Объект.СписокДокументовСерии.Очистить();
	
	Объект.ИтогиРаздела21ПоСчету.Очистить();
	Объект.ИтогиРаздела21ПоКонтрагенту.Очистить();
	Объект.ИтогиРаздела22ПоСчету.Очистить();
	Объект.ИтогиРаздела22ПоКонтрагенту.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер(РежимЗаполнения);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер(РежимЗаполнения)
	
	ПараметрыФункции = Новый Структура("
		|Ссылка,
		|ДатаИнвентаризации,
		|Организация,
		|ИФО,
		|Подразделение");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыФункции.Вставить("СписокСчетов", Объект.СписокСчетов.Выгрузить());
	ПараметрыФункции.Вставить("РежимЗаполнения", РежимЗаполнения);
	
	// СерииДокументов
	ИнвентаризацияСервер.ДобавитьПараметрыРасчетаСерииДокументов(ПараметрыФункции, Объект);
	// Конец СерииДокументов
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510469'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьДанныеДляРаздела1",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата);
		
		Если ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект) Тогда
			Если Объект.Раздел11.Количество() = 0 И Объект.Раздел12.Количество() = 0 Тогда
				ТекстСообщения = НСтр("ru='После заполнения разделы 1.1 и 1.2 оказались пустыми'");
				
				ПоказатьПредупреждение(, ТекстСообщения);
			КонецЕсли;
			
		ИначеЕсли ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект) Тогда
			ИнвентаризацияКлиент.СообщитьОСозданииСерииДокументов(Объект.СписокДокументовСерии.Количество(), "1, 2");
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 1 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.Свойство("Раздел11") И Результат.Свойство("Раздел12") Тогда
		Объект.Раздел11.Загрузить(Результат.Раздел11);
		Объект.Раздел12.Загрузить(Результат.Раздел12);
		
		Объект.ИдентификаторСерииДокументов = "";
		Объект.ЭтоЗаголовочныйДокумент = Ложь;
		
		Объект.ВыявленыНеподтвержденныеСуммы = Ложь;
		Объект.ВыявленыСуммыТребующиеРеклассификации = Ложь;
		
		Модифицированность = Истина;
	Иначе
		ЭтотОбъект.Прочитать();
	КонецЕсли;
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

#Область Раздел2

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2Клиент(Команда)
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтотОбъект,
		НСтр("ru = 'Заполнить по данным раздела 1'"),
		"ПроверитьИЗаполнитьРаздел2ПослеПроверкиЗаписиДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел21.Количество() > 0 Или Объект.Раздел22.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличные части документа будут очищены.
			|
			|Продолжить и заполнить разделы 2.1 и 2.2?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел2КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел2КорректностьЗаполненияПредыдущихРазделовКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел2КорректностьЗаполненияПредыдущихРазделовКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел2КорректностьЗаполненияПредыдущихРазделовКлиент()
	
	ЗаполнитьРаздел2Клиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел2Клиент()
	
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	
	Объект.ИтогиРаздела21ПоСчету.Очистить();
	Объект.ИтогиРаздела21ПоКонтрагенту.Очистить();
	Объект.ИтогиРаздела22ПоСчету.Очистить();
	Объект.ИтогиРаздела22ПоКонтрагенту.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел2Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел2Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел2Сервер()
	
	ПараметрыФункции = Новый Структура("Ссылка", Объект.Ссылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 2 инвентаризационной описи 0510469'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьДанныеДляРаздела2",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел2Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел2Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел21.Количество() = 0 И Объект.Раздел22.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения разделы 2.1 и 2.2 оказались пустыми'");
			
			ПоказатьПредупреждение(, ТекстСообщения);
		КонецЕсли;
		
		Модифицированность = Истина;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 2 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел2Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.Свойство("ТаблицаРаздела21") И Результат.Свойство("ТаблицаРаздела22") Тогда
		Объект.Раздел21.Загрузить(Результат.ТаблицаРаздела21);
		Объект.Раздел22.Загрузить(Результат.ТаблицаРаздела22);
		
		Объект.ИтогиРаздела21ПоСчету.Загрузить(Результат.ИтогиРаздела21ПоСчету);
		Объект.ИтогиРаздела21ПоКонтрагенту.Загрузить(Результат.ИтогиРаздела21ПоКонтрагенту);
		Объект.ИтогиРаздела22ПоСчету.Загрузить(Результат.ИтогиРаздела22ПоСчету);
		Объект.ИтогиРаздела22ПоКонтрагенту.Загрузить(Результат.ИтогиРаздела22ПоКонтрагенту);
		
		Объект.ВыявленыНеподтвержденныеСуммы = Результат.ВыявленыНеподтвержденныеСуммы;
		Объект.ВыявленыСуммыТребующиеРеклассификации = Результат.ВыявленыСуммыТребующиеРеклассификации;
	КонецЕсли;
	
	Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ЗаполнитьСлужебныеКолонки(ЭтотОбъект);
	
	ДебиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	КредиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ИменаПолей

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляСумма(ПостфиксВидаСуммы, ПостфиксВалютная)
	
	Возврат СтрШаблон("Сумма%1%2", ПостфиксВидаСуммы, ПостфиксВалютная);
	
КонецФункции

&НаКлиенте
Функция ВыделитьКомпонентыИмениПоля(Знач ИмяПоля)
	
	Если СтрНайти(ИмяПоля, "Подтвержденная") > 0 Тогда
		ВидСуммы = "Подтвержденная";
		ИмяПоля = СтрЗаменить(ИмяПоля, "Подтвержденная", "");
		
	ИначеЕсли СтрНайти(ИмяПоля, "Неподтвержденная") > 0 Тогда
		ВидСуммы = "Неподтвержденная";
		ИмяПоля = СтрЗаменить(ИмяПоля, "Неподтвержденная", "");
		
	Иначе
		ВидСуммы = "";
	КонецЕсли;
	
	Если СтрНайти(ИмяПоля, "Вал") > 0 Тогда
		Валютная = "Вал";
		
	ИначеЕсли СтрНайти(ИмяПоля, "Руб") > 0 Тогда
		Валютная = "Руб";
		
	Иначе
		Валютная = "";
	КонецЕсли;
	
	Возврат НовыйКомпонентыИмени(ВидСуммы, Валютная);
	
КонецФункции

&НаКлиенте
Функция НовыйКомпонентыИмени(ПостфиксВидСуммы, ПостфиксВалютная)
	
	КомпонентыИмени = Новый Структура();
	КомпонентыИмени.Вставить("ВидСуммы", ПостфиксВидСуммы);
	КомпонентыИмени.Вставить("Валютная", ПостфиксВалютная);
	
	Возврат КомпонентыИмени;
	
КонецФункции

#КонецОбласти

#Область РасчетСуммРаздела2

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеРаздела2(Элемент, ИмяТЧ)
	
	ИмяПоляСумма = СтрЗаменить(Элемент.Имя, ИмяТЧ, "");
	
	КомпонентыИмени = ВыделитьКомпонентыИмениПоля(ИмяПоляСумма);
	
	ПостфиксВидаСуммы	= КомпонентыИмени.ВидСуммы;
	ПостфиксВалютная	= КомпонентыИмени.Валютная;
	
	ИмяПоляБухУчет = ИмяПоляСумма("", ПостфиксВалютная);
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	СуммаБухУчет	= ТекДанные[ИмяПоляБухУчет];
	Сумма			= ТекДанные[ИмяПоляСумма];
	
	ИзмененныеПоля = Новый Структура();
	ИзмененныеПоля.Вставить(ИмяПоляСумма, КомпонентыИмени);
	
	// Любая сумма <= Бух.учет (вал., руб.)
	Если (СуммаБухУчет >= 0 И Сумма > СуммаБухУчет) Или (СуммаБухУчет <= 0 И Сумма < СуммаБухУчет) Тогда
		ТекДанные[ИмяПоляСумма] = СуммаБухУчет;
		
		Сумма = СуммаБухУчет;
	КонецЕсли;
	
	Если ПостфиксВидаСуммы = "Подтвержденная" Или ПостфиксВидаСуммы = "Неподтвержденная" Тогда
		// Бух.учет = Подтвержденная + Неподтвержденная (вал., руб.)
		// Такое равенство поддерживается только при опциональной настройке.
		
		ПостфиксВидСуммыКор = ?(ПостфиксВидаСуммы = "Подтвержденная", "Неподтвержденная", "Подтвержденная");
		
		ИмяПоляСуммаКор	= ИмяПоляСумма(ПостфиксВидСуммыКор, ПостфиксВалютная);
		
		Если Сумма = 0 И Не ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
			СуммаКор = 0;
		Иначе
			СуммаКор = СуммаБухУчет - Сумма;
		КонецЕсли;
		
		ТекДанные[ИмяПоляСумма]		= Сумма;
		ТекДанные[ИмяПоляСуммаКор]	= СуммаКор;
		
		ИзмененныеПоля.Вставить(ИмяПоляСуммаКор, ВыделитьКомпонентыИмениПоля(ИмяПоляСуммаКор));
	КонецЕсли;
	
	Если ПостфиксВалютная = "Вал" Тогда
		ПересчитатьРублевыеСуммы(ТекДанные, ИзмененныеПоля);
	КонецЕсли;

	ОчиститьНедоступныеПоляВСтрокеРаздела2(ТекДанные, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьНедоступныеПоляВСтрокеРаздела2(СтрокаТаблицы, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности)
	
	Если Не ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности Тогда
		ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьПоляАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(СтрокаТаблицы)
	
	// Поля акта сверки недоступны (очищаются), если отсутствует подтвержденная сумма.
	
	Если СтрокаТаблицы.СуммаПодтвержденнаяВал = 0 И СтрокаТаблицы.СуммаПодтвержденнаяРуб = 0 Тогда
		СтрокаТаблицы.ДатаАктаСверки = '00010101';
		СтрокаТаблицы.НомерАктаСверки = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьРублевыеСуммы(ТекДанные, ИзмененныеПоля)
	
	Перем Курс;
	
	ВидыСумм = Новый Соответствие();
	
	Для Каждого Элемент Из ИзмененныеПоля Цикл
		ИмяПоляСуммаВал = Элемент.Ключ;
		КомпонентыИмени = Элемент.Значение;
		
		Если Курс = Неопределено Тогда
			Курс = ПолучитьКурсВалютыРасчетов(ТекДанные);
		КонецЕсли;
		
		ИмяПоляСуммаРуб = ИмяПоляСумма(КомпонентыИмени.ВидСуммы, "Руб");
		
		ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаВал] * Курс;
		
		ВидыСумм.Вставить(КомпонентыИмени.ВидСуммы, Истина);
	КонецЦикла;
	
	Если ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
		ВыравнятьИтогРублевыхСумм(ТекДанные, ВидыСумм);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКурсВалютыРасчетов(ТекДанные)
	
	// Курс определяем из остатков бух.учета.
	СуммаВал = ТекДанные.СуммаВал;
	
	Если ЗначениеЗаполнено(СуммаВал) Тогда
		Возврат ТекДанные.СуммаРуб / СуммаВал;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевыхСумм(ТекДанные, ВидыСумм)
	
	Если НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные) Тогда
		ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НужноВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные)
	
	Если ТекДанные.СуммаПодтвержденнаяВал = 0 И ТекДанные.СуммаНеподтвержденнаяВал = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (ТекДанные.СуммаПодтвержденнаяРуб + ТекДанные.СуммаНеподтвержденнаяРуб) <> ТекДанные.СуммаРуб;
	
КонецФункции

&НаКлиенте
Процедура ВыравнятьИтогРублевойСуммыПодтвержденнаяНеподтвержденная(ТекДанные)
	
	// Корректируем наибольшую рублевую сумму.
	
	СуммаПодтвержденнаяРуб = ТекДанные.СуммаПодтвержденнаяРуб;
	СуммаНеподтвержденнаяРуб = ТекДанные.СуммаНеподтвержденнаяРуб;
	СуммаБухУчетРуб = ТекДанные.СуммаРуб;
	
	Подтвержденная = Макс(СуммаПодтвержденнаяРуб, -СуммаПодтвержденнаяРуб);
	Неподтвержденная = Макс(СуммаНеподтвержденнаяРуб, -СуммаНеподтвержденнаяРуб);
	
	Если Подтвержденная > Неподтвержденная Тогда
		ИмяПоля = "СуммаПодтвержденнаяРуб";
	Иначе
		ИмяПоля = "СуммаНеподтвержденнаяРуб";
	КонецЕсли;
	
	ТекДанные[ИмяПоля] = СуммаБухУчетРуб - (СуммаПодтвержденнаяРуб + СуммаНеподтвержденнаяРуб - ТекДанные[ИмяПоля]);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФлажокТребуетРеклассификации(ТекДанные)
	
	ЭтоСтатусПросроченнойЗадолженности = (СтатусыЗадолженностиДопускающиеРеклассификацию.НайтиПоЗначению(ТекДанные.СтатусЗадолженности) <> Неопределено);
	
	ТекДанные.СуммаТребуетРеклассификации = ЭтоСтатусПросроченнойЗадолженности;
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтроки

&НаКлиенте
Процедура ПроверитьИОткрытьФормуРазбивкиСтроки(ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если Не ПроверитьПередОткрытиемФормыРазбивкиСтроки(ТекДанные, ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуРазбивкиСтроки(ТекДанные, ИмяТЧ);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередОткрытиемФормыРазбивкиСтроки(ТекДанные, ИмяТЧ)
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку.'"));
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоВыделенныхСтрок = Элементы[ИмяТЧ].ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенныхСтрок > 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите только одну строку для разбивки.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) И Не ЕстьЗаполненныеСуммыБухУчета(ТекДанные) Тогда
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке все суммы бух.учета нулевые. Разбивка таких строк не предусмотрена.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтроки(ТекДанные, ИмяТЧ)
	
	ПараметрыФормыРазбивки = ПолучитьПараметрыФормыРазбивкиСтроки(ТекДанные.ПолучитьИдентификатор(), ИмяТЧ);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИсходнаяСтрока", ПараметрыФормыРазбивки.ИсходнаяСтрока);
	ДополнительныеПараметры.Вставить("ИмяТЧ", ИмяТЧ);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами.Форма.РазбивкаСтроки", ПараметрыФормыРазбивки,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьЗаполненныеСуммыБухУчета(СтрокаТаблицы)
	
	Возврат СтрокаТаблицы.СуммаВал <> 0 Или СтрокаТаблицы.СуммаРуб <> 0;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФормыРазбивкиСтроки(ИдСтроки, ИмяТЧ)
	
	ТекДанные = Объект[ИмяТЧ].НайтиПоИдентификатору(ИдСтроки);
	
	Возврат Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьПараметрыФормыРазбивкиСтроки(ЭтотОбъект, ТекДанные, ИмяТЧ);
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтроки(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = ДополнительныеПараметры.ИмяТЧ;
	
	// НомераСтрокФрагментов упорядочены по возрастанию.
	НомераСтрокФрагментов	= РезультатВыбора.НомераСтрокФрагментов;
	ФрагментыСтроки			= РезультатВыбора.ФрагментыСтроки;
	
	КоличествоПрежнихФрагментов = НомераСтрокФрагментов.Количество();
	КоличествоНовыхФрагментов = ФрагментыСтроки.Количество();
	
	// Удаляем прежние фрагменты, начиная с последнего.
	Для Счетчик = 1 По КоличествоПрежнихФрагментов Цикл
		Индекс = КоличествоПрежнихФрагментов - Счетчик;
		
		Объект[ИмяТЧ].Удалить(НомераСтрокФрагментов[Индекс] - 1);
	КонецЦикла;
	
	// Вставляем новые фрагменты на место первой строки прежних фрагментов, начиная с последнего.
	ИндексВставки = НомераСтрокФрагментов[0] - 1;
	
	ОбщиеПоля = "КодСтроки,Контрагент,ИдентификаторКонтрагента,Договор,НаименованиеДокумента,ДатаДокумента,НомерДокумента"
		+ ",ДатаИсполнения,КФО,Счет,КПС,КЭК,ИФО,Подразделение,Валюта,ВидНалогаИПлатежа,НалогИПлатежОрганизации";
	
	// Реквизиты акта сверки и суммы подтвержденной и неподтвержденной задолженностей
	// указываются лишь в одной первой строке фрагментов.
	// В очередных строках фрагментов эти показатели должны быть пустыми.
	ИменаПолейУказываемыхВПервойСтрокеФрагментов = "ДатаАктаСверки,
		|НомерАктаСверки,
		|СуммаПодтвержденнаяВал,
		|СуммаПодтвержденнаяРуб,
		|СуммаНеподтвержденнаяВал,
		|СуммаНеподтвержденнаяРуб";
	
	ОчищающаяСтруктураОчередныхФрагментовСтроки = Новый Структура(ИменаПолейУказываемыхВПервойСтрокеФрагментов);
	
	// Применяем обратный порядок обхода фрагментов.
	Для Счетчик = 1 По КоличествоНовыхФрагментов Цикл
		Индекс = КоличествоНовыхФрагментов - Счетчик;
		
		СтруктураСтроки = ФрагментыСтроки[Индекс];
		
		НоваяСтрока = Объект[ИмяТЧ].Вставить(ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры.ИсходнаяСтрока, ОбщиеПоля);
		
		Если СтруктураСтроки.ПризнакПервогоФрагментаСтроки Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатВыбора.ИсходнаяСтрока, ИменаПолейУказываемыхВПервойСтрокеФрагментов);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктураОчередныхФрагментовСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоНовыхФрагментов = 1 Тогда
		НоваяСтрока.ИдентификаторСтроки = Неопределено;
		НоваяСтрока.ПризнакФрагментаСтроки = Ложь;
		НоваяСтрока.ПризнакПервогоФрагментаСтроки = Ложь;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Элементы[ИмяТЧ].ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимоОткрытьФормуРазбивкиСтроки(Поле, ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТЧ, "");
	
	Если ТекДанные.ПризнакФрагментаСтроки
		И ИменаПолейБезОткрытияФормыРазбивкиСтроки.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ГрупповоеЗаполнениеСтрок

&НаКлиенте
Процедура ОткрытьФормуГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти)
	
	КоличествоСтрок = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок)
	
	Если ИмяТабличнойЧасти = "Раздел21" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская");
	Иначе
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская");
	КонецЕсли;
	
	СвязиПараметровВыбора = Новый Структура("Дата,ДатаИнвентаризации,Организация,ИФО,Подразделение,ВидЗадолженности");
	
	ЗаполнитьЗначенияСвойств(СвязиПараметровВыбора, Объект);
	
	СвязиПараметровВыбора.ВидЗадолженности = ВидЗадолженности;
	
	ЗначенияЗаполнения = Новый Структура();
	
	ТекДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("ЗаключениеКомиссии", ТекДанные.ЗаключениеКомиссии);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("ОписьСсылка",				Объект.Ссылка);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьВыделенныеСтрокиРаздела2(ВыбранноеЗначение, ДополнительныеПараметры);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыделенныеСтрокиРаздела2(ВыбранноеЗначение, ДополнительныеПараметры)
	
	Перем СуммаТребуетРеклассификации, ПодтверждениеАктомСверки, ОчиститьВсеСуммыПриОтсутствииАктаСверки, СписокИдентификаторовСтрок;
	Перем ДатаВозникновения, ПричинаОбразованияКод, ПричинаОбразованияПояснение, ПричинаОбразованияДополнительно;
	
	ОчищающаяСтруктураОчередныхСтрокФрагментов = Новый Структура("
		|ДатаАктаСверки,
		|НомерАктаСверки,
		|СуммаПодтвержденнаяВал,
		|СуммаПодтвержденнаяРуб,
		|СуммаНеподтвержденнаяВал,
		|СуммаНеподтвержденнаяРуб");
	
	Если ВыбранноеЗначение.Свойство("СуммаТребуетРеклассификации", СуммаТребуетРеклассификации) Тогда
		ВыбранноеЗначение.Удалить("СуммаТребуетРеклассификации");
	КонецЕсли;
	
	Если ВыбранноеЗначение.Свойство("ПодтверждениеАктомСверки", ПодтверждениеАктомСверки) Тогда
		ВыбранноеЗначение.Удалить("ПодтверждениеАктомСверки");
	КонецЕсли;
	
	Если ВыбранноеЗначение.Свойство("ОчиститьВсеСуммыПриОтсутствииАктаСверки", ОчиститьВсеСуммыПриОтсутствииАктаСверки) Тогда
		ВыбранноеЗначение.Удалить("ОчиститьВсеСуммыПриОтсутствииАктаСверки");
	КонецЕсли;
	
	УстановитьПоляОтраженияПросроченной = Ложь;
	ОчищающаяСтруктураПоляОтраженияПросроченнойДолгосрочной = Новый Структура("
		|ДатаВозникновения,
		|ПричинаОбразованияКод,
		|ПричинаОбразованияПояснение,
		|ПричинаОбразованияДополнительно");
	
	Если ВыбранноеЗначение.Свойство("ДатаВозникновения", ДатаВозникновения)
		Или ВыбранноеЗначение.Свойство("ПричинаОбразованияКод", ПричинаОбразованияКод)
		Или ВыбранноеЗначение.Свойство("ПричинаОбразованияПояснение", ПричинаОбразованияПояснение)
		Или ВыбранноеЗначение.Свойство("ПричинаОбразованияДополнительно", ПричинаОбразованияДополнительно) Тогда
		
		ЕстьЗаполненноеПоле = ЗначениеЗаполнено(ДатаВозникновения)
			Или ЗначениеЗаполнено(ПричинаОбразованияКод)
			Или ЗначениеЗаполнено(ПричинаОбразованияПояснение)
			Или ЗначениеЗаполнено(ПричинаОбразованияДополнительно);
		
		УстановитьПоляОтраженияПросроченной = ЕстьЗаполненноеПоле;
	КонецЕсли;
	
	ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти;
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	ЕстьНастройкиСвязанныеСАктомСверки = (ПодтверждениеАктомСверки <> Неопределено
		Или ОчиститьВсеСуммыПриОтсутствииАктаСверки <> Неопределено);
	
	Если ЕстьНастройкиСвязанныеСАктомСверки Тогда
		// Некоторые показатели указываются только в первом фрагменте строки,
		// а в последующих фрагментах строки (очередных) должны быть пустыми.
		ПервыеСтрокиВыделенныхФрагментов = ПолучитьПервыеСтрокиВыделенныхФрагментов(ВыделенныеСтроки, ИмяТабличнойЧасти, СписокИдентификаторовСтрок);
		
		ОбработанныеИдентификаторыСтрокФрагментов = Новый Соответствие();
		
		ТаблицыИтоговФрагментовСтрок = Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ПолучитьТаблицыИтоговСуммБухУчетаФрагментовСтрок(
			ЭтотОбъект, ИмяТабличнойЧасти, СписокИдентификаторовСтрок);
	КонецЕсли;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыбранноеЗначение);
		
		Если СуммаТребуетРеклассификации <> Неопределено Тогда
			Если СуммаТребуетРеклассификации
				И (СтрокаТаблицы.СуммаВал <> 0 Или СтрокаТаблицы.СуммаРуб <> 0)
				И СтатусыЗадолженностиДопускающиеРеклассификацию.НайтиПоЗначению(СтрокаТаблицы.СтатусЗадолженности) <> Неопределено Тогда
				СтрокаТаблицы.СуммаТребуетРеклассификации = Истина;
			Иначе
				СтрокаТаблицы.СуммаТребуетРеклассификации = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если УстановитьПоляОтраженияПросроченной
			И СтатусыЗадолженностиДопускающиеОтражениеПросроченной.НайтиПоЗначению(
				СтрокаТаблицы.СтатусЗадолженности) = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктураПоляОтраженияПросроченнойДолгосрочной);
		КонецЕсли;
		
		ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		
		ЭтоСтрокаФрагмента = ЗначениеЗаполнено(ИдентификаторСтроки);
		
		Если ЭтоСтрокаФрагмента И Не СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
			// Выделенная строка фрагмента - очередная строка.
			// В таких строках очищаем показатели, связанные с актом сверки.
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктураОчередныхСтрокФрагментов);
		КонецЕсли;
		
		Если ЕстьНастройкиСвязанныеСАктомСверки Тогда
			Если ЭтоСтрокаФрагмента Тогда
				ВремИдСтроки = ОбработанныеИдентификаторыСтрокФрагментов.Получить(ИдентификаторСтроки);
				
				Если ВремИдСтроки <> Неопределено Тогда
					// В первой строке этих фрагментов строк уже обработаны все показатели, зависящие от акта сверки.
					Продолжить;
				КонецЕсли;
				
				СтрокаТаблицы = ПолучитьСтрокуПервогоФрагмента(СтрокаТаблицы, ИмяТабличнойЧасти, ПервыеСтрокиВыделенныхФрагментов);
				
				ОбработанныеИдентификаторыСтрокФрагментов.Вставить(ИдентификаторСтроки, Истина);
			КонецЕсли;
			
			Если ПодтверждениеАктомСверки <> Неопределено Тогда
				ПрименитьНастройкуПодтвержденияАктомСверки(СтрокаТаблицы, ВыбранноеЗначение, ПодтверждениеАктомСверки,
					ТаблицыИтоговФрагментовСтрок,
					ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности,
					ИдентификаторСтроки);
			КонецЕсли;
			
			Если ОчиститьВсеСуммыПриОтсутствииАктаСверки <> Неопределено Тогда
				Если ОчиститьВсеСуммыПриОтсутствииАктаСверки = Истина
					И Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаАктаСверки)
					И Не ЗначениеЗаполнено(СтрокаТаблицы.НомерАктаСверки) Тогда
					СтрокаТаблицы.СуммаПодтвержденнаяРуб = 0;
					СтрокаТаблицы.СуммаПодтвержденнаяВал = 0;
					
					СтрокаТаблицы.СуммаНеподтвержденнаяРуб = 0;
					СтрокаТаблицы.СуммаНеподтвержденнаяВал = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуПервогоФрагмента(СтрокаТаблицы, ИмяТЧ, ПервыеСтрокиВыделенныхФрагментов)
	
	Если СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
		Возврат СтрокаТаблицы;
	КонецЕсли;
	
	ИдСтроки = ПервыеСтрокиВыделенныхФрагментов.Получить(СтрокаТаблицы.ИдентификаторСтроки);
	
	Возврат Объект[ИмяТЧ].НайтиПоИдентификатору(ИдСтроки);
	
КонецФункции

&НаСервере
Функция ПолучитьПервыеСтрокиВыделенныхФрагментов(Знач ВыделенныеСтроки, Знач ИмяТЧ, СписокИдентификаторовСтрок)
	
	ТабличнаяЧасть = Объект[ИмяТЧ];
	
	СписокИдентификаторовСтрок = Новый Массив();
	
	ПервыеСтрокиФрагментов = Новый Соответствие();
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		
		Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		ИдПервойСтроки = ПервыеСтрокиФрагментов.Получить(ИдентификаторСтроки);
		
		Если ИдПервойСтроки <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПризнакПервогоФрагментаСтроки Тогда
			ПервыеСтрокиФрагментов.Вставить(ИдентификаторСтроки, ИдСтроки);
		Иначе
			Поиск.ИдентификаторСтроки = ИдентификаторСтроки;
			
			МассивСтрок = ТабличнаяЧасть.НайтиСтроки(Поиск);
			
			ПервыеСтрокиФрагментов.Вставить(ИдентификаторСтроки, МассивСтрок[0].ПолучитьИдентификатор());
		КонецЕсли;
		
		СписокИдентификаторовСтрок.Добавить(ИдентификаторСтроки);
	КонецЦикла;
	
	Возврат ПервыеСтрокиФрагментов;
	
КонецФункции

&НаСервере
Процедура ПрименитьНастройкуПодтвержденияАктомСверки(СтрокаТаблицы, ВыбранноеЗначение, ПодтверждениеАктомСверки,
	ТаблицыИтоговФрагментовСтрок, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности, ИдентификаторСтроки)
	
	Если ТаблицыИтоговФрагментовСтрок <> Неопределено И ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ТаблицаИтоговФрагментовСтрок = ТаблицыИтоговФрагментовСтрок.Получить(ИдентификаторСтроки);
		
		ИсточникСведений = ТаблицаИтоговФрагментовСтрок[0];
	Иначе
		ИсточникСведений = СтрокаТаблицы;
	КонецЕсли;
	
	Если ПодтверждениеАктомСверки = 0 Тогда
		// Сумма не подтверждена в полном объеме.
		
		СтрокаТаблицы.СуммаПодтвержденнаяВал = 0;
		СтрокаТаблицы.СуммаПодтвержденнаяРуб = 0;
		
		СтрокаТаблицы.СуммаНеподтвержденнаяВал = ИсточникСведений.СуммаВал;
		СтрокаТаблицы.СуммаНеподтвержденнаяРуб = ИсточникСведений.СуммаРуб;
		
	ИначеЕсли ПодтверждениеАктомСверки = 1 Тогда
		// Сумма подтверждена в полном объеме.
		
		СтрокаТаблицы.СуммаПодтвержденнаяВал = ИсточникСведений.СуммаВал;
		СтрокаТаблицы.СуммаПодтвержденнаяРуб = ИсточникСведений.СуммаРуб;
		
		СтрокаТаблицы.СуммаНеподтвержденнаяВал = 0;
		СтрокаТаблицы.СуммаНеподтвержденнаяРуб = 0;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыбранноеЗначение, "ДатаАктаСверки,НомерАктаСверки");
	КонецЕсли;
	
	ОчиститьНедоступныеПоляВСтрокеРаздела2(СтрокаТаблицы, ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности);
	
КонецПроцедуры

#КонецОбласти

#Область ОтражениеПросроченнойИДолгосрочнойЗадолженности

&НаСервере
Процедура ЗаполнитьСпискиВыбораКодаПричиныОбразования()
	
	ПричиныОбразованияДт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Дебиторская);
	ПричиныОбразованияКт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Кредиторская);
	
	Элементы.Раздел21ПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияДт);
	Элементы.Раздел22ПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияКт);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияТекстаОтраженияЗадолженности(Элемент, СтандартнаяОбработка)
	
	ИмяЭлемента = Элемент.Имя;
	
	Если СтрНачинаетсяС(ИмяЭлемента, "Раздел21") Тогда
		ИмяТЧ = "Раздел21";
	ИначеЕсли СтрНачинаетсяС(ИмяЭлемента, "Раздел22") Тогда
		ИмяТЧ = "Раздел22";
	Иначе
		Возврат;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(ИмяЭлемента, ИмяТЧ, "");
	
	Если ИмяПоля = "ПричинаОбразованияПояснение" Тогда
		ЗаголовокПоля = НСтр("ru='Причина возникновения задолженности'");
	ИначеЕсли ИмяПоля = "ПричинаОбразованияДополнительно" Тогда
		ЗаголовокПоля = НСтр("ru='Дополнительное описание причины возникновения задолженности'");
	Иначе
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗначениеПоля = Элементы[ИмяТЧ].ТекущиеДанные[ИмяПоля];
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяТЧ",	ИмяТЧ);
	ДополнительныеПараметры.Вставить("ИмяПоля",	ИмяПоля);
	
	Оповещение = Новый ОписаниеОповещения("ВведенТекстОтраженияЗадолженности", ЭтотОбъект, ДополнительныеПараметры);
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, ЗначениеПоля, ЗаголовокПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ВведенТекстОтраженияЗадолженности(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ	= ДополнительныеПараметры.ИмяТЧ;
	ИмяПоля	= ДополнительныеПараметры.ИмяПоля;
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	ТекДанные[ИмяПоля] = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляОтраженияПросроченнойДолгосрочной(ТекДанные)
	
	СтатусДопускаетОтражение = (СтатусыЗадолженностиДопускающиеОтражениеПросроченной.НайтиПоЗначению(ТекДанные.СтатусЗадолженности) <> Неопределено);
	
	Если СтатусДопускаетОтражение Тогда
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("
		|ДатаВозникновения,
		|ПричинаОбразованияКод,
		|ПричинаОбразованияПояснение,
		|ПричинаОбразованияДополнительно");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

#КонецОбласти

#Область СписаниеЗадолженности

&НаКлиенте
Процедура ДебиторскаяЗадолженностьСписатьНаКлиенте(ВидОперации)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание дебиторской задолженности'");
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Данные были изменены. Необходимо сначала сохранить изменения.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	ИначеЕсли НЕ Объект.Проведен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для ввода документов списания дебиторской задолженности необходимо сначала провести инвентаризационную опись.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	КонецЕсли;
	
	ДокументыСписания = Новый Структура;
	СписокИФО = Новый Массив;
	
	Для Каждого СтрокаДЗ Из Объект.Раздел21 Цикл
		
		ЭтоСчет205 = ( СтрНайти(Строка(СтрокаДЗ.Счет), "205") > 0 );
		ЭтоСчет207 = ( СтрНайти(Строка(СтрокаДЗ.Счет), "207") > 0 );
		ЭтоСчет209 = ( СтрНайти(Строка(СтрокаДЗ.Счет), "209") > 0 );
		ЭтоСчет210 = ( СтрНайти(Строка(СтрокаДЗ.Счет), "210.05") > 0 );
		ЭтоСчет04 = ЗначениеЗаполнено(СтрокаДЗ.Счет)
			И (Счета04.НайтиПоЗначению(СтрокаДЗ.Счет) <> Неопределено);
		
		КлючДокумента = Новый Массив;
		КлючДокумента.Добавить("Документ");
		Если ЭтоСчет205 Тогда
			КлючДокумента.Добавить("Счет20500");
		ИначеЕсли ЭтоСчет207 Тогда
			КлючДокумента.Добавить("Счет20700");
		ИначеЕсли ЭтоСчет209 Тогда
			КлючДокумента.Добавить("Счет20900");
		ИначеЕсли ЭтоСчет210 Тогда
			КлючДокумента.Добавить("Счет21000");
		ИначеЕсли ЭтоСчет04 Тогда
			КлючДокумента.Добавить("Счет04");
		Иначе // Документ СписаниеВосстановлениеЗадолженностиПоДоходам не предназначен для списания задолженности по другим счетам.
			Если ЗначениеЗаполнено(ВидОперации)
				И (СтрокаДЗ.СтатусЗадолженности = ПредопределенноеЗначение("Перечисление.СтатусыЗадолженности.Сомнительная")
				Или СтрокаДЗ.СтатусЗадолженности = ПредопределенноеЗначение("Перечисление.СтатусыЗадолженности.Безнадежная")) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Документ ""%1"" (ф. 0510436, 0510445) не используется для списания дебиторской задолженности по счету %2.'"),
						НСтр("ru='Списание, восстановление задолженности по доходам'"),
						Строка(СтрокаДЗ.Счет));
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
					"Раздел21[" + Формат(СтрокаДЗ.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатусЗадолженности", "Объект");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ИспользоватьУчетПоИФО Тогда
			НомерИФО = СписокИФО.Найти(СтрокаДЗ.ИФО);
			Если НомерИФО = Неопределено Тогда
				СписокИФО.Добавить(СтрокаДЗ.ИФО);
				НомерИФО = 0; // Первый индекс массива.
			КонецЕсли;
			КлючДокумента.Добавить(Строка(НомерИФО));
		КонецЕсли;
		
		КлючТекущегоДокумента = СтрСоединить(КлючДокумента);
		
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности")
			И СтрокаДЗ.СтатусЗадолженности = ПредопределенноеЗначение("Перечисление.СтатусыЗадолженности.Сомнительная")
			И Не ЭтоСчет04 Тогда
			ДобавитьСтрокуВДокументСписанияЗадолженности(ДокументыСписания, КлючТекущегоДокумента, СтрокаДЗ);
		КонецЕсли;
		
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности")
			И СтрокаДЗ.СтатусЗадолженности = ПредопределенноеЗначение("Перечисление.СтатусыЗадолженности.Безнадежная") Тогда
			ДобавитьСтрокуВДокументСписанияЗадолженности(ДокументыСписания, КлючТекущегоДокумента, СтрокаДЗ);
		КонецЕсли;
		
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.ВосстановлениеСомнительнойЗадолженности")
			И СтрокаДЗ.СтатусЗадолженности = ПредопределенноеЗначение("Перечисление.СтатусыЗадолженности.КВосстановлению")
			И ЭтоСчет04 Тогда
			ДобавитьСтрокуВДокументСписанияЗадолженности(ДокументыСписания, КлючТекущегоДокумента, СтрокаДЗ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДокументыСписания.Количество() = 0 Тогда
		ТекстПредупреждения = СтрШаблон("Отсутствуют данные для формирования документов списания задолженности с видом операции ""%1""", ВидОперации);
		ПоказатьПредупреждение(, ТекстПредупреждения, 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	КонецЕсли;
	
	// Создание документов списания дебиторской задолженности.
	Для Каждого ДокументСписания Из ДокументыСписания Цикл
		
		НомераСтрокИнвентаризации = Новый Массив;
		Для Каждого СтрокаИнвентаризации Из ДокументСписания.Значение Цикл
			НомераСтрокИнвентаризации.Добавить(СтрокаИнвентаризации.НомерСтроки);
		КонецЦикла;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
		ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
		ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.ФормаОбъекта", ПараметрыФормы,
			ЭтотОбъект, ДокументСписания.Ключ, , , , РежимОткрытияОкнаФормы.Независимый);
		
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
