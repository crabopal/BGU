	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерЧастиСтрокой", "2");
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	ВывестиИтогиРаздела2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, "2");
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерЧасти)
	
	ВывестиИтогиРаздела2ПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерЧасти);
	
	ВывестиИтогиРаздела2ПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерЧасти);
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2ПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерЧастиСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["ИтогиРаздела2" + НомерПодразделаСтрокой + "ПоСчету"];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьПервая		= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоНомеруСчетаПервая"];
	ОбластьОчередная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоНомеруСчетаОчередная"];
	
	Если КоличествоСтрок = 0 Тогда
		СтруктураЗаполнения = ?(НомерЧастиСтрокой = "1",
			Данные.СтруктураЗаполненияПустыхИтоговПоСчету_Часть1,
			Данные.СтруктураЗаполненияПустыхИтоговПоСчету_Часть2);
			
		ОбластьПервая.Параметры.Заполнить(СтруктураЗаполнения);
		
		ТабДокумент.Вывести(ОбластьПервая);
		
		Возврат;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура("НомерСчета");
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗначенияПараметров.НомерСчета =  ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК);

		Область = ?(НомерСтроки = 1, ОбластьПервая, ОбластьОчередная);
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		Если НомерЧастиСтрокой = "1" Тогда
			ИмяКлючаПрочерка = СтрШаблон("Раздел2%1_Часть%2_ИтогоПоНомеруСчета",
				НомерПодразделаСтрокой,
				НомерЧастиСтрокой);
			
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ПрочеркиПустыхПолей, ИмяКлючаПрочерка);
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2ПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерЧастиСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["ИтогиРаздела2" + НомерПодразделаСтрокой + "ПоКонтрагенту"];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьЕдинственная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоКонтрагентуЕдинственная"];
	ОбластьПервая		= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоКонтрагентуПервая"];
	ОбластьОчередная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоКонтрагентуОчередная"];
	ОбластьПоследняя	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерЧастиСтрокой + "ПоКонтрагентуПоследняя"];
	
	Если КоличествоСтрок = 0 Тогда
		СтруктураЗаполнения = ?(НомерЧастиСтрокой = "1",
			Данные.СтруктураЗаполненияПустыхИтоговПоКонтрагенту_Часть1,
			Данные.СтруктураЗаполненияПустыхИтоговПоКонтрагенту_Часть2);
		
		ОбластьЕдинственная.Параметры.Заполнить(СтруктураЗаполнения);
		
		ТабДокумент.Вывести(ОбластьЕдинственная);
		
		Возврат;
	КонецЕсли;
	
	НомерСтроки = 0;
	
	ЗначенияПараметров = Новый Структура("НаименованиеКонтрагента");
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если КоличествоСтрок = 1 Тогда
			Область = ОбластьЕдинственная;
			
		ИначеЕсли НомерСтроки = 1 Тогда
			Область = ОбластьПервая;
			
		ИначеЕсли НомерСтроки = КоличествоСтрок Тогда
			Область = ОбластьПоследняя;
			
		Иначе
			Область = ОбластьОчередная;
		КонецЕсли;
		
		Область.Параметры.Заполнить(Выборка);
		
		Если Не ЗначениеЗаполнено(Выборка.НаименованиеКонтрагента) И ЗначениеЗаполнено(Выборка.ВидНалогаИПлатежа) Тогда
			ЗначенияПараметров.НаименованиеКонтрагента = Выборка.ВидНалогаИПлатежа;
			
			Область.Параметры.Заполнить(ЗначенияПараметров);
		КонецЕсли;
		
		Если НомерЧастиСтрокой = "1" Тогда
			ИмяКлючаПрочерка = СтрШаблон("Раздел2%1_Часть%2_ИтогоПоКонтрагенту",
				НомерПодразделаСтрокой,
				НомерЧастиСтрокой);
			
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ПрочеркиПустыхПолей, ИмяКлючаПрочерка);
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510469_Раздел1(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
	
	Если Не ЗначениеЗаполнено(Выборка.НаименованиеКонтрагента) И ЗначениеЗаполнено(Выборка.ВидНалогаИПлатежа) Тогда
		ЗначенияПараметров.Вставить("НаименованиеКонтрагента", Выборка.ВидНалогаИПлатежа);
	КонецЕсли;
	
	Если Выборка.Валюта = ДополнительныеПараметры.ВалютаРУ Тогда
		Если Выборка.СуммаВал = 0 Тогда
			ЗначенияПараметров.Вставить("СуммаВал", ДополнительныеПараметры.СимволПустойВалютнойСуммыДляРублей);
		КонецЕсли;
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИмяКлючаПрочерка = "Раздел1" + ДополнительныеПараметры.НомерПодразделаСтрокой;
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, ИмяКлючаПрочерка);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510469_Раздел2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
		
	Если ДополнительныеПараметры.НомерЧастиСтрокой = "1" Тогда
		Если Не ЗначениеЗаполнено(Выборка.НаименованиеКонтрагента) И ЗначениеЗаполнено(Выборка.ВидНалогаИПлатежа) Тогда
			ЗначенияПараметров.Вставить("НаименованиеКонтрагента", Выборка.ВидНалогаИПлатежа);
		КонецЕсли;
		
		ОписаниеСтатусаЗадолженности = ИнвентаризацияКлиентСервер.ПолучитьОписаниеСтатусаЗадолженности(
			Выборка.СтатусЗадолженности, ДополнительныеПараметры.ОписаниеСтатусовЗадолженности);
			
		ЗначенияПараметров.Вставить("КодСтатуса", ОписаниеСтатусаЗадолженности.Код);
		ЗначенияПараметров.Вставить("НаименованиеСтатуса", ОписаниеСтатусаЗадолженности.Наименование);
		
		Если Выборка.Валюта = ДополнительныеПараметры.ВалютаРУ Тогда
			Если Выборка.СуммаВал = 0 Тогда
				ЗначенияПараметров.Вставить("СуммаВал", ДополнительныеПараметры.СимволПустойВалютнойСуммыДляРублей);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.НомерЧастиСтрокой = "2" Тогда
		Если Выборка.Валюта = ДополнительныеПараметры.ВалютаРУ Тогда
			Если Выборка.СуммаПодтвержденнаяВал = 0 Тогда
				ЗначенияПараметров.Вставить("СуммаПодтвержденнаяВал", ДополнительныеПараметры.СимволПустойВалютнойСуммыДляРублей);
			КонецЕсли;
			
			Если Выборка.СуммаНеподтвержденнаяВал = 0 Тогда
				ЗначенияПараметров.Вставить("СуммаНеподтвержденнаяВал", ДополнительныеПараметры.СимволПустойВалютнойСуммыДляРублей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИмяКлючаПрочерка = СтрШаблон("Раздел2%1_Часть%2_СтрокаТаблицы",
		ДополнительныеПараметры.НомерПодразделаСтрокой,
		ДополнительныеПараметры.НомерЧастиСтрокой);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, ИмяКлючаПрочерка);
	
КонецПроцедуры

#КонецОбласти

#Область РеестрДокументовКПроводимойИнвентаризации

Функция ПолучитьТекстЗапросаДокументыИзмененияЗадолженности()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые счета
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО	КАК КФО,
	|	ТЗ.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблицаИсключаемыхСчетов
	|ИЗ
	|	&ТаблицаИсключаемыхСчетов КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Отбор контрагентов
	|//
	|ВЫБРАТЬ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	ОтборКонтрагентов
	|ИЗ
	|	Справочник.Контрагенты
	|ГДЕ
	|	&ИспользоватьОтборПоКонтрагенту И Ссылка В ИЕРАРХИИ(&СписокКонтрагентов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Список регистраторов
	|//
	|ВЫБРАТЬ
	|	Регистратор					КАК ДокументСсылка,
	|	Период						КАК Период,
	|	КФО							КАК КФО,
	|	СчетДт						КАК СчетДт,
	|	СчетКт						КАК СчетКт,
	|	Сумма						КАК Сумма,
	|	ЕСТЬNULL(КоличествоДт, 0)	КАК КоличествоДт,
	|	ЕСТЬNULL(КоличествоКт, 0)	КАК КоличествоКт,
	|	ВидПервичногоДокумента		КАК НаименованиеДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента,
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	// Признаки.
	|	(СчетДт В(&СписокСчетов)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
	|				ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоДт1 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоДт2 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоДт3 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаДтСоответствуетОтбору,
	|	(СчетКт В(&СписокСчетов)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
	|				ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт1) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоКт1 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт2) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоКт2 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт3) = ТИП(Справочник.Контрагенты) ТОГДА
	|						СубконтоКт3 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт1) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт2) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт3) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(СубконтоКт3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)					КАК СторонаКтСоответствуетОтбору
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,
	|		&ДатаОкончания,
	|		Активность
	|		И Счет В (&СписокСчетов)
	|		И Организация = &Организация
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				 ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Отбор по контрагенту
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
	|				ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|						Субконто1 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|						Субконто2 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|						Субконто3 В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|						ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (ВЫБРАТЬ Ссылка ИЗ ОтборКонтрагентов)
	|						
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению И Счет.УчетПоПодразделениям ТОГДА
	|				Подразделение В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И НЕ (КФО, Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов),
	|		Регистратор
	|	)";
	
КонецФункции

