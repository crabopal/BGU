Процедура ДобавитьУсловноеОформление_НедоступностьПолейОтраженияПросроченнойЗадолженности(УсловноеОформление, ИмяТЧ, ОбщиеПараметры, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Поля отражения просроченной задолженности доступны для редактирования только если указан
	// соответствующий статус задолженности, и такая задолженность является просроченной.
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаВозникновения");
	ИменаПолей.Добавить("ПричинаОбразованияКод");
	ИменаПолей.Добавить("ПричинаОбразованияПояснение");
	ИменаПолей.Добавить("ПричинаОбразованияДополнительно");
	
	СписокСтатусов = Новый СписокЗначений();
	СписокСтатусов.ЗагрузитьЗначения(ОбщиеПараметры.СтатусыЗадолженностиДопускающиеОтражениеПросроченной);
	
	НачалоПутиПоляУсловия = СтрШаблон("%1%2.", ?(ЭтоФормаРазбивкиСтроки, "", "Объект."), ИмяТЧ);
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность поля отражения просроченной и долгосрочной задолженности (%1, %2)'"), ИмяТЧ, ИмяПоля);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + "СтатусЗадолженности");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
		Условие.ПравоеЗначение = СписокСтатусов;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НачалоПутиПоляУсловия + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

