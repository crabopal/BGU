Процедура ДозаполнитьТаблицуЗадолженностиПоДаннымБухУчета(ТаблицаЗадолженности, ВидЗадолженности, ПараметрыПроцедуры, ПараметрыПоиска, СчетаРасчетовКИСЕ)
	
	Если ПараметрыПроцедуры.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
		ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(ТаблицаЗадолженности, СчетаРасчетовКИСЕ);
	КонецЕсли;
	
	ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности);
	
	ЗаполнитьДолгосрочнуюПросроченнуюЗадолженность(ТаблицаЗадолженности, ВидЗадолженности, ПараметрыПроцедуры, ПараметрыПоиска);
	
	ИнвентаризацияСервер.ЗаполнитьДатуВозникновенияЗадолженности61н(ТаблицаЗадолженности);
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности)
	
	ТаблицаЗадолженности.Колонки.Добавить("ИдентификаторКонтрагента", ОбщегоНазначения.ОписаниеТипаСтрока(22));
	
	// Для расчетов по платежам (переплатам по платежам) в бюджеты графа 4 не заполняется (пункт 64.137 приказа 61н).
	Поиск = Новый Структура("ЭтоСчет30300", Ложь);
	
	ВремТЗ = ТаблицаЗадолженности.Скопировать(Поиск, "Контрагент");
	ВремТЗ.Свернуть("Контрагент");
	СписокКонтрагентов = ВремТЗ.ВыгрузитьКолонку("Контрагент");
	
	ИдентификаторыКонтрагентов = БухгалтерскийУчет.ИдентификаторыКонтрагентов(СписокКонтрагентов);
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		СтрокаТаблицы.ИдентификаторКонтрагента = ИдентификаторыКонтрагентов.Получить(СтрокаТаблицы.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюЗадолженность(ТаблицаОписи, Знач ВидЗадолженности, Знач ПараметрыПроцедуры, Знач ПараметрыПоиска)
	
	Перем КолонкиПоиска, КолонкиПоиска30300;
	
	ОписаниеТипаСуммы = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	ТаблицаОписи.Колонки.Добавить("ДолгосрочнаяВал",	ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ДолгосрочнаяРуб",	ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяВал",	ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяРуб",	ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ДатаИсполнения",		Новый ОписаниеТипов("Дата"));
	ТаблицаОписи.Колонки.Добавить("СтрокаОбработана",	Новый ОписаниеТипов("Булево"));
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрок",	ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	
	ИспользоватьУчетПоИФО					= ПараметрыПоиска.ИспользоватьУчетПоИФО;
	ИспользоватьУчетПоПодразделениям		= ПараметрыПоиска.ИспользоватьУчетПоПодразделениям;
	ИспользоватьКонтрольИсполненияДоговоров	= ПараметрыПоиска.ИспользоватьКонтрольИсполненияДоговоров;
	
	ДатаОпределенияЗадолженности = ПолучитьДатуОпределенияЗадолженности(ПараметрыПоиска);
	
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		// Анализ задолженности для всех счетов, кроме 303.00.
		// Могут быть заполнены долгосрочная и просроченная компоненты суммы.
		ТаблицаОтбора = ПолучитьТаблицуОтбораАнализаЗадолженности(ТаблицаОписи, ИспользоватьУчетПоИФО, КолонкиПоиска);
		
		АнализЗадолженности = КонтрольИсполненияДоговоров.АнализЗадолженности(
			ПараметрыПоиска.Организация,
			ДатаОпределенияЗадолженности,
			ТаблицаОтбора,
			ВидЗадолженности);
		
		АнализЗадолженности.Свернуть(КолонкиПоиска + ",СрокИсполнения,ВидЗадолженности",
			"Остаток,Краткосрочная,Долгосрочная,Просроченная");
		АнализЗадолженности.Индексы.Добавить(КолонкиПоиска);
		
		СоответствующиеСчетаРасчетов = ПолучитьСоответствующиеСчетаРасчетов(ДатаОпределенияЗадолженности, ПараметрыПоиска.Организация);
		
		Для Каждого СтрокаЗадолженности Из ТаблицаОписи Цикл
			Если СтрокаЗадолженности.ЭтоСчет30300 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности(СтрокаЗадолженности,
				АнализЗадолженности, КолонкиПоиска, ПараметрыПоиска, СоответствующиеСчетаРасчетов);
				
			УстановитьКоличествоПодстрок(СтрокаЗадолженности);
		КонецЦикла;
	КонецЕсли;
	
	// Анализ задолженности для счетов 303.00.
	// Может быть заполнена лишь просроченная компонента суммы.
	ТаблицаОтбора30300 = ПолучитьТаблицуОтбораАнализаЗадолженности30300(ТаблицаОписи, ИспользоватьУчетПоИФО,
		ИспользоватьУчетПоПодразделениям, КолонкиПоиска30300);
	
	АнализЗадолженности30300 = Отчеты.АнализЗадолженностиПоПлатежамВБюджеты.АнализЗадолженностиПоПлатежамВБюджеты(
		ПараметрыПоиска.Организация,
		НачалоДня(ДатаОпределенияЗадолженности),
		КонецДня(ДатаОпределенияЗадолженности),
		ТаблицаОтбора30300);
	
	АнализЗадолженности30300.Свернуть(КолонкиПоиска30300 + ",СрокИсполнения",
		"СуммаКонечныйОстаток,Просроченная");
	АнализЗадолженности30300.Индексы.Добавить(КолонкиПоиска30300);
	
	Для Каждого СтрокаЗадолженности Из ТаблицаОписи Цикл
		Если Не СтрокаЗадолженности.ЭтоСчет30300 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности30300(СтрокаЗадолженности,
			АнализЗадолженности30300, КолонкиПоиска30300);
			
		УстановитьКоличествоПодстрок(СтрокаЗадолженности);
	КонецЦикла;
	
	ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ПараметрыПроцедуры.ДатаИнвентаризации);
	
КонецПроцедуры

Функция ПолучитьДатуОпределенияЗадолженности(ПараметрыПоиска)
	
	ДатаОпределенияЗадолженности = ПараметрыПоиска.ДатаОстатков;
	
	Если ТипЗнч(ДатаОпределенияЗадолженности) = Тип("Граница") Тогда
		ДатаОпределенияЗадолженности = ДатаОпределенияЗадолженности.Значение;
	КонецЕсли;
	
	Возврат КонецДня(ДатаОпределенияЗадолженности);
	
КонецФункции

Функция ПолучитьИменаКолонокТаблицыСтрокой(Таблица)
	
	ИменаКолонок = Новый Массив();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(ИменаКолонок, ",");
	
КонецФункции

// Анализ задолженности для всех счетов, кроме 303.00.

Функция ПолучитьТаблицуОтбораАнализаЗадолженности(Знач ТаблицаОписи, Знач ИспользоватьУчетПоИФО, КолонкиПоиска)
	
	Поиск = Новый Структура("ЭтоСчет30300", Ложь);
	
	ТаблицаОтбора = ТаблицаОписи.Скопировать(Поиск,
		"Контрагент,Договор,Счет,КПС,КФО,Валюта" + ?(ИспользоватьУчетПоИФО, ",ИФО", ""));
	
	ТаблицаОтбора.Колонки.Счет.Имя = "СчетРасчетов";
	
	КолонкиПоиска = ПолучитьИменаКолонокТаблицыСтрокой(ТаблицаОтбора);
	
	ТаблицаОтбора.Свернуть(КолонкиПоиска);
	
	Возврат ТаблицаОтбора;
	
КонецФункции

Функция ПолучитьСоответствующиеСчетаРасчетов(НаДату, Организация)
	
	// Соответствие счетов 206.00 - 302.00.
	СоответствующиеСчетаРасчетов = Новый Соответствие();
	
	СоответствиеСчетов = УчетРасчетов.СоответствиеСчетовАвансовСчетамРасчетов("302.00", НаДату, Организация);
	
	Для Каждого Элемент Из СоответствиеСчетов Цикл
		СоответствующиеСчетаРасчетов.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
	Возврат СоответствующиеСчетаРасчетов;
	
КонецФункции

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности(СтрокаЗадолженности, АнализЗадолженности, КолонкиПоиска, ПараметрыПоиска, СоответствующиеСчетаРасчетов)
	
	УказанаИностраннаяВалюта = ПараметрыПоиска.ИспользоватьВалютныйУчет И СтрокаЗадолженности.Валюта <> ПараметрыПоиска.ВалютаРУ;
	
	ОтборЗадолженности = Новый Структура(КолонкиПоиска);
	ЗаполнитьЗначенияСвойств(ОтборЗадолженности, СтрокаЗадолженности);
	ОтборЗадолженности.СчетРасчетов = СтрокаЗадолженности.Счет;
	
	// Соответствие счетов 206-302
	СоответствияСчета = СоответствующиеСчетаРасчетов.Получить(ОтборЗадолженности.СчетРасчетов);
	
	Если СоответствияСчета <> Неопределено Тогда
		ОтборЗадолженности.СчетРасчетов = СоответствияСчета;
	КонецЕсли;
	
	ПустаяДата = '00010101';
	
	НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборЗадолженности);
	
	ИтогОстаток			= 0;
	ИтогДолгосрочная	= 0;
	ИтогПросроченная	= 0;
	ДатаИсполнения		= ПустаяДата;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Остаток = 0 Тогда
			Продолжить; // Пропускаем строки, на которые не распределены остатки задолженности.
		КонецЕсли;
		
		ИтогОстаток			= ИтогОстаток		+ НайденнаяСтрока.Остаток;
		ИтогДолгосрочная	= ИтогДолгосрочная	+ НайденнаяСтрока.Долгосрочная;
		ИтогПросроченная	= ИтогПросроченная	+ НайденнаяСтрока.Просроченная;
		
		СрокИсполнения = ?(ЗначениеЗаполнено(НайденнаяСтрока.СрокИсполнения), НайденнаяСтрока.СрокИсполнения, ПустаяДата);
		
		ДатаИсполнения = Макс(ДатаИсполнения, СрокИсполнения);
	КонецЦикла;
	
	Если ИтогОстаток <= 0
		Или УказанаИностраннаяВалюта И СтрокаЗадолженности.СуммаВал <> ИтогОстаток
		Или Не УказанаИностраннаяВалюта И СтрокаЗадолженности.СуммаРуб <> ИтогОстаток Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИтогДолгосрочная)
		И Не ЗначениеЗаполнено(ИтогПросроченная)
		И Не ЗначениеЗаполнено(ДатаИсполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Если УказанаИностраннаяВалюта Тогда
		// Расчеты в валюте.
		// Считаем, что график (в валюте) задан на весь остаток задолженности по счету расчетов (в рублях) => расчет через пропорцию. 
		КурсВалютыРасчетов = ?(ЗначениеЗаполнено(СтрокаЗадолженности.СуммаВал),
			СтрокаЗадолженности.СуммаРуб / СтрокаЗадолженности.СуммаВал,
			0);
			
		СтрокаЗадолженности.ДолгосрочнаяВал	= ИтогДолгосрочная;
		СтрокаЗадолженности.ДолгосрочнаяРуб	= ИтогДолгосрочная * КурсВалютыРасчетов;
		СтрокаЗадолженности.ПросроченнаяВал	= ИтогПросроченная;
		СтрокаЗадолженности.ПросроченнаяРуб	= ИтогПросроченная * КурсВалютыРасчетов;
	Иначе
		// Расчеты в рублях.
		СтрокаЗадолженности.ДолгосрочнаяРуб	= ИтогДолгосрочная;
		СтрокаЗадолженности.ПросроченнаяРуб	= ИтогПросроченная;
	КонецЕсли;
	
	СтрокаЗадолженности.ДатаИсполнения = ДатаИсполнения;
	СтрокаЗадолженности.СтрокаОбработана = Истина;
	
КонецПроцедуры

Процедура УстановитьКоличествоПодстрок(СтрокаЗадолженности)
	
	Если СтрокаЗадолженности.ДолгосрочнаяВал <> 0 Или СтрокаЗадолженности.ДолгосрочнаяРуб <> 0 Тогда
		Если Не (СтрокаЗадолженности.ДолгосрочнаяВал = СтрокаЗадолженности.СуммаВал
			И СтрокаЗадолженности.ДолгосрочнаяРуб = СтрокаЗадолженности.СуммаРуб) Тогда
			СтрокаЗадолженности.КоличествоПодстрок = СтрокаЗадолженности.КоличествоПодстрок + 1;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаЗадолженности.ПросроченнаяВал <> 0 Или СтрокаЗадолженности.ПросроченнаяРуб <> 0 Тогда
		Если Не (СтрокаЗадолженности.ПросроченнаяВал = СтрокаЗадолженности.СуммаВал
			И СтрокаЗадолженности.ПросроченнаяРуб = СтрокаЗадолженности.СуммаРуб) Тогда
			СтрокаЗадолженности.КоличествоПодстрок = СтрокаЗадолженности.КоличествоПодстрок + 1;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ДатаИнвентаризации)
	
	// Задолженность считается просроченной в полной сумме, если у договора задана дата его окончания,
	// и эта дата окончания договора меньше даты инвентаризации.
	//
	// Задолженность считается долгосрочной в полной сумме, если у договора задана дата его окончания,
	// и эта дата окончания договора превышает более чем на 12 месяцев дату инвентаризации.
	
	ТаблицаОписи.Индексы.Добавить("СтрокаОбработана");
	
	Поиск = Новый Структура("СтрокаОбработана", Ложь);
	МассивСтрок = ТаблицаОписи.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КонецПериодаКраткосрочнойЗадолженности = КонецДня(ДобавитьМесяц(ДатаИнвентаризации, 12));
	ДатаИсполненияПриНевозможностиУстановления = ИнвентаризацияКлиентСервер.ПолучитьДатуИсполненияПриНевозможностиУстановления();
	
	ВремТЗ = ТаблицаОписи.Скопировать(МассивСтрок, "Договор");
	ВремТЗ.Свернуть("Договор");
	
	СписокДоговоров = ВремТЗ.ВыгрузитьКолонку("Договор");
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		ТаблицаСвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаИнвентаризации);
	Иначе
		// Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		ТаблицаСвойстваДоговоров = ИнвентаризацияСервер.ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Поиск = Новый Структура("Договор");
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.СтрокаОбработана = Истина;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСвойств = ТаблицаСвойстваДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСвойств.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваДоговора = МассивСвойств[0];
		
		ОкончаниеДоговора = СвойстваДоговора.ОкончаниеДоговора;
		ДоговорПросрочен = СвойстваДоговора.ДоговорПросрочен;
		
		СтрокаТаблицы.ДатаИсполнения = ОкончаниеДоговора;
		
		УказаноЗначениеОкончаниеДоговора = (ТипЗнч(ОкончаниеДоговора) = Тип("Дата"));
		УказаноЗначениеДоговорПросрочен = (ТипЗнч(ДоговорПросрочен) = Тип("Булево"));
		
		ЗадолженностьПросроченная = Ложь;
		ЗадолженностьДолгосрочная = Ложь;
		
		Если УказаноЗначениеОкончаниеДоговора И ЗначениеЗаполнено(ОкончаниеДоговора) Тогда
			Если КонецПериодаКраткосрочнойЗадолженности < ОкончаниеДоговора
				И ОкончаниеДоговора < ДатаИсполненияПриНевозможностиУстановления Тогда
				ЗадолженностьДолгосрочная = Истина;
				
			ИначеЕсли ОкончаниеДоговора < ДатаИнвентаризации Тогда
				ЗадолженностьПросроченная = Истина;
			КонецЕсли;
			
		ИначеЕсли УказаноЗначениеДоговорПросрочен Тогда
			ЗадолженностьПросроченная = ДоговорПросрочен;
		КонецЕсли;
		
		Если ЗадолженностьПросроченная Тогда
			СтрокаТаблицы.ПросроченнаяВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.ПросроченнаяРуб = СтрокаТаблицы.СуммаРуб;
			
		ИначеЕсли ЗадолженностьДолгосрочная Тогда
			СтрокаТаблицы.ДолгосрочнаяВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.ДолгосрочнаяРуб = СтрокаТаблицы.СуммаРуб;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Анализ задолженности для счетов 303.00.

Функция ПолучитьТаблицуОтбораАнализаЗадолженности30300(Знач ТаблицаОписи, Знач ИспользоватьУчетПоИФО, Знач ИспользоватьУчетПоПодразделениям, КолонкиПоиска)
	
	Поиск = Новый Структура("ЭтоСчет30300", Истина);
	
	ТаблицаОтбора = ТаблицаОписи.Скопировать(Поиск,
		"Счет,КПС,КФО,ВидНалогаИПлатежа,НалогИПлатежОрганизации" + ?(ИспользоватьУчетПоИФО, ",ИФО", "")
		+ ?(ИспользоватьУчетПоПодразделениям, ",Подразделение", ""));
	
	ТаблицаОтбора.Колонки.Счет.Имя = "Счет30300";
	ТаблицаОтбора.Колонки.ВидНалогаИПлатежа.Имя = "ВидНалогаИлиПлатежа";
	ТаблицаОтбора.Колонки.НалогИПлатежОрганизации.Имя = "НалогСборПлатеж";
	
	КолонкиПоиска = ПолучитьИменаКолонокТаблицыСтрокой(ТаблицаОтбора);
	
	ТаблицаОтбора.Свернуть(КолонкиПоиска);
	
	Возврат ТаблицаОтбора;
	
КонецФункции

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности30300(СтрокаЗадолженности, АнализЗадолженности, КолонкиПоиска)
	
	ОтборЗадолженности = Новый Структура(КолонкиПоиска);
	ЗаполнитьЗначенияСвойств(ОтборЗадолженности, СтрокаЗадолженности);
	ОтборЗадолженности.Счет30300			= СтрокаЗадолженности.Счет;
	ОтборЗадолженности.ВидНалогаИлиПлатежа	= СтрокаЗадолженности.ВидНалогаИПлатежа;
	ОтборЗадолженности.НалогСборПлатеж		= СтрокаЗадолженности.НалогИПлатежОрганизации;
	
	НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборЗадолженности);
	
	ПустаяДата = '00010101';
	
	ИтогОстаток = 0;
	ИтогПросроченная = 0;
	ДатаИсполнения = ПустаяДата;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ИтогОстаток = ИтогОстаток + НайденнаяСтрока.СуммаКонечныйОстаток;
		ИтогПросроченная = ИтогПросроченная + НайденнаяСтрока.Просроченная;
		
		СрокИсполнения = ?(ЗначениеЗаполнено(НайденнаяСтрока.СрокИсполнения), НайденнаяСтрока.СрокИсполнения, ПустаяДата);
		
		ДатаИсполнения = Макс(ДатаИсполнения, СрокИсполнения);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИтогПросроченная)
		И Не ЗначениеЗаполнено(ДатаИсполнения) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗадолженности.ПросроченнаяРуб   = ИтогПросроченная;
	СтрокаЗадолженности.ДатаИсполнения = ДатаИсполнения;
	СтрокаЗадолженности.СтрокаОбработана = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

Функция ПолучитьПараметрыЗаполненияСтатусовРаздела2()
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("СтатусыЗадолженностиДопускающиеРеклассификацию", ПолучитьСтатусыЗадолженностиДопускающиеРеклассификацию());
	ПараметрыЗаполнения.Вставить("СпискиЗабалансовыхСчетов", ПолучитьСпискиЗабалансовыхСчетов());
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Функция РассчитатьИтогиРаздела2(Раздел21, Раздел22)
	
	Итоги = Новый Структура();
	Итоги.Вставить("ИтогиРаздела21ПоСчету", РассчитатьИтогиПоСчету(Раздел21));
	Итоги.Вставить("ИтогиРаздела21ПоКонтрагенту", РассчитатьИтогиПоКонтрагенту(Раздел21));
	Итоги.Вставить("ИтогиРаздела22ПоСчету", РассчитатьИтогиПоСчету(Раздел22));
	Итоги.Вставить("ИтогиРаздела22ПоКонтрагенту", РассчитатьИтогиПоКонтрагенту(Раздел22));
	
	Возврат Итоги;
	
КонецФункции

Функция РассчитатьИтогиПоСчету(Таблица)
	
	ЭтоТипТаблицаЗначений = (ТипЗнч(Таблица) = Тип("ТаблицаЗначений"));
	
	КолонкиГруппировки = ПолучитьИменаКолонокГруппировкиСчет();
	КолонкиСуммирования = ПолучитьИменаКолонокСумирования();
	
	КолонкиВыгрузки = КолонкиГруппировки + "," + КолонкиСуммирования;
	
	Если ЭтоТипТаблицаЗначений Тогда
		ВремТаблица = Таблица.Скопировать(, КолонкиВыгрузки);
	Иначе
		ВремТаблица = Таблица.Выгрузить(, КолонкиВыгрузки);
	КонецЕсли;
	
	ВремТаблица.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	ВремТаблица.Сортировать(КолонкиГруппировки);
	
	Возврат ВремТаблица;
	
КонецФункции

Функция РассчитатьИтогиПоКонтрагенту(Таблица)
	
	ЭтоТипТаблицаЗначений = (ТипЗнч(Таблица) = Тип("ТаблицаЗначений"));
	
	КолонкиГруппировки = ПолучитьИменаКолонокГруппировкиКонтрагент();
	КолонкиСуммирования = ПолучитьИменаКолонокСумирования();
	
	КолонкиВыгрузки = КолонкиГруппировки + "," + КолонкиСуммирования;
	
	Если ЭтоТипТаблицаЗначений Тогда
		ВремТаблица = Таблица.Скопировать(, КолонкиВыгрузки);
	Иначе
		ВремТаблица = Таблица.Выгрузить(, КолонкиВыгрузки);
	КонецЕсли;
	
	ВремТаблица.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	СортироватьИтогиПоКонтрагенту(ВремТаблица);
	
	Возврат ВремТаблица;
	
КонецФункции

Функция ПолучитьИменаКолонокГруппировкиСчет()
	
	Возврат "Счет,КПС,КФО,КЭК";
	
КонецФункции

Функция ПолучитьИменаКолонокГруппировкиКонтрагент()
	
	Возврат "Контрагент,ИдентификаторКонтрагента,ВидНалогаИПлатежа";
	
КонецФункции

Функция ПолучитьИменаКолонокСумирования()
	
	Возврат "СуммаРуб,СуммаПодтвержденнаяРуб,СуммаНеподтвержденнаяРуб";
	
КонецФункции

Процедура СортироватьИтогиПоКонтрагенту(Таблица)
	
	ЗапросСортировка = Новый Запрос();
	ЗапросСортировка.УстановитьПараметр("Таблица", Таблица);
	ЗапросСортировка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная таблица итогов по контрагенту.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ТЗ.Контрагент КАК Справочник.Контрагенты)					КАК Контрагент,
	|	ВЫРАЗИТЬ(ТЗ.ИдентификаторКонтрагента КАК СТРОКА(22))				КАК ИдентификаторКонтрагента,
	|	ВЫРАЗИТЬ(ТЗ.ВидНалогаИПлатежа КАК Справочник.ВидыНалоговИПлатежей)	КАК ВидНалогаИПлатежа,
	|	ВЫРАЗИТЬ(ТЗ.СуммаРуб КАК ЧИСЛО(18,2))								КАК СуммаРуб,
	|	ВЫРАЗИТЬ(ТЗ.СуммаПодтвержденнаяРуб КАК ЧИСЛО(18,2))					КАК СуммаПодтвержденнаяРуб,
	|	ВЫРАЗИТЬ(ТЗ.СуммаНеподтвержденнаяРуб КАК ЧИСЛО(18,2))				КАК СуммаНеподтвержденнаяРуб
	|ПОМЕСТИТЬ
	|	ВТ
	|ИЗ
	|	&Таблица КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Упорядоченная таблица итогов по контрагенту.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.Контрагент				КАК Контрагент,
	|	ВТ.ИдентификаторКонтрагента	КАК ИдентификаторКонтрагента,
	|	ВТ.ВидНалогаИПлатежа		КАК ВидНалогаИПлатежа,
	|	ВТ.СуммаРуб					КАК СуммаРуб,
	|	ВТ.СуммаПодтвержденнаяРуб	КАК СуммаПодтвержденнаяРуб,
	|	ВТ.СуммаНеподтвержденнаяРуб	КАК СуммаНеподтвержденнаяРуб,
	|	ВЫБОР
	|		КОГДА ВТ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			И НЕ ВТ.ВидНалогаИПлатежа = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка) ТОГДА
	|			ЕСТЬNULL(СправочникВидыНалоговИПлатежей.Наименование, """")
	|		ИНАЧЕ
	|			ЕСТЬNULL(СправочникКонтрагенты.Наименование, """")
	|	КОНЕЦ						КАК ПорядокНаименование
	|ИЗ
	|	ВТ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК СправочникКонтрагенты
	|		ПО ВТ.Контрагент = СправочникКонтрагенты.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК СправочникВидыНалоговИПлатежей
	|		ПО ВТ.ВидНалогаИПлатежа = СправочникВидыНалоговИПлатежей.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокНаименование";
	
	Таблица = ЗапросСортировка.Выполнить().Выгрузить();
	
	Таблица.Колонки.Удалить("ПорядокНаименование");
	
КонецПроцедуры

Процедура ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаЗадолженности, ЭтоДебиторскаяЗадолженность, ПараметрыЗаполнения)
	
	// В случае разбивки строки на фрагменты показатели акта сверки и подтвержденные/не подтвержденные суммы
	// указываются в первой строке фрагментов. В очередных фрагментах эти показатели не заполняются (остаются пустыми).
	
	СтатусыЗадолженностиДопускающиеРеклассификацию = ПараметрыЗаполнения.СтатусыЗадолженностиДопускающиеРеклассификацию;
	ЗабалансовыеСчета = ПараметрыЗаполнения.СпискиЗабалансовыхСчетов.Все;
	
	СтатусЗадолженностиПоУмолчаниюБаланс = Перечисления.СтатусыЗадолженности.Текущая;
	СтатусЗадолженностиПоУмолчаниюЗабалансДЗ = Перечисления.СтатусыЗадолженности.Сомнительная;
	СтатусЗадолженностиПоУмолчаниюЗабалансКЗ = Перечисления.СтатусыЗадолженности.Невостребованная;
	
	СтатусЗадолженностиТекущая = Перечисления.СтатусыЗадолженности.Текущая;
	СтатусЗадолженностиДолгосрочная = Перечисления.СтатусыЗадолженности.Долгосрочная;
	СтатусЗадолженностиПросроченная = Перечисления.СтатусыЗадолженности.Просроченная;
	
	ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной =
		ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной();
	
	ТаблицаНовыеСтроки = ТаблицаЗадолженности.СкопироватьКолонки();
	ТаблицаНовыеСтроки.Колонки.Добавить("ИндексВставки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	ОчищающаяСтруктура = Новый Структура("
		|ДолгосрочнаяВал,
		|ДолгосрочнаяРуб,
		|ПросроченнаяВал,
		|ПросроченнаяРуб");
	
	НекопируемыеПоля = "СтатусЗадолженности,СуммаПодтвержденнаяВал,СуммаПодтвержденнаяРуб"
		+ ",НомерАктаСверки,ДатаАктаСверки,СуммаНеподтвержденнаяВал,СуммаНеподтвержденнаяРуб";
	
	НовыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		ЭтоЗабалансовыйСчет = (ЗабалансовыеСчета.Найти(СтрокаТаблицы.Счет) <> Неопределено);
		
		Если ЭтоДебиторскаяЗадолженность Тогда
			Если ЭтоЗабалансовыйСчет Тогда
				СтатусЗадолженностиПоУмолчанию = СтатусЗадолженностиПоУмолчаниюЗабалансДЗ;
			Иначе
				СтатусЗадолженностиПоУмолчанию = СтатусЗадолженностиПоУмолчаниюБаланс;
			КонецЕсли;
		Иначе
			Если ЭтоЗабалансовыйСчет Тогда
				СтатусЗадолженностиПоУмолчанию = СтатусЗадолженностиПоУмолчаниюЗабалансКЗ;
			Иначе
				СтатусЗадолженностиПоУмолчанию = СтатусЗадолженностиПоУмолчаниюБаланс;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТаблицы.КодСтроки = СтрокаТаблицы.НомерСтроки;
		СтрокаТаблицы.СтатусЗадолженности = СтатусЗадолженностиПоУмолчанию;
		
		Если ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной Тогда
			СтрокаТаблицы.СуммаНеподтвержденнаяВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.СуммаНеподтвержденнаяРуб = СтрокаТаблицы.СуммаРуб;
		КонецЕсли;
		
		Если ЭтоЗабалансовыйСчет Тогда
			// Строки забалансовых счетов не разбиваем на фрагменты.
			Если СтатусыЗадолженностиДопускающиеРеклассификацию.Найти(СтрокаТаблицы.СтатусЗадолженности) <> Неопределено Тогда
				СтрокаТаблицы.СуммаТребуетРеклассификации = Истина;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.ДолгосрочнаяВал = 0 И СтрокаТаблицы.ДолгосрочнаяРуб = 0
			И СтрокаТаблицы.ПросроченнаяВал = 0 И СтрокаТаблицы.ПросроченнаяРуб = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		
		Если СтрокаТаблицы.ДолгосрочнаяВал <> 0 Или СтрокаТаблицы.ДолгосрочнаяРуб <> 0 Тогда
			Если СтрокаТаблицы.ДолгосрочнаяВал = СтрокаТаблицы.СуммаВал И СтрокаТаблицы.ДолгосрочнаяРуб = СтрокаТаблицы.СуммаРуб Тогда
				// Сумма полностью является долгосрочной.
				// Разбивать такую строку не требуется.
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
				
				СтрокаТаблицы.СтатусЗадолженности = СтатусЗадолженностиДолгосрочная;
				
				Продолжить;
			КонецЕсли;
			
			// Добавляем новую строку.
			НоваяСтрока = ТаблицаНовыеСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, НекопируемыеПоля);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
			
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.СтатусЗадолженности = СтатусЗадолженностиДолгосрочная;
			НоваяСтрока.ИндексВставки = СтрокаТаблицы.НомерСтроки; // Вставка после исходной строки.
			
			НоваяСтрока.СуммаВал = СтрокаТаблицы.ДолгосрочнаяВал;
			НоваяСтрока.СуммаРуб = СтрокаТаблицы.ДолгосрочнаяРуб;
			
			// Уменьшаем сумму в исходной строке.
			СтрокаТаблицы.СуммаВал = СтрокаТаблицы.СуммаВал - СтрокаТаблицы.ДолгосрочнаяВал;
			СтрокаТаблицы.СуммаРуб = СтрокаТаблицы.СуммаРуб - СтрокаТаблицы.ДолгосрочнаяРуб;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПросроченнаяВал <> 0 Или СтрокаТаблицы.ПросроченнаяРуб <> 0 Тогда
			Если СтрокаТаблицы.ПросроченнаяВал = СтрокаТаблицы.СуммаВал И СтрокаТаблицы.ПросроченнаяРуб = СтрокаТаблицы.СуммаРуб Тогда
				// Сумма полностью является просроченной.
				// Разбивать такую строку не требуется.
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
				
				СтрокаТаблицы.СтатусЗадолженности = СтатусЗадолженностиПросроченная;
				СтрокаТаблицы.СуммаТребуетРеклассификации = Истина;
				
				Продолжить;
			КонецЕсли;
			
			// Добавляем новую строку.
			НоваяСтрока = ТаблицаНовыеСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, НекопируемыеПоля);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
			
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.СтатусЗадолженности = СтатусЗадолженностиПросроченная;
			НоваяСтрока.СуммаТребуетРеклассификации = Истина;
			НоваяСтрока.ИндексВставки = СтрокаТаблицы.НомерСтроки; // Вставка после исходной строки.
			
			НоваяСтрока.СуммаВал = СтрокаТаблицы.ПросроченнаяВал;
			НоваяСтрока.СуммаРуб = СтрокаТаблицы.ПросроченнаяРуб;
			
			// Уменьшаем сумму в исходной строке.
			СтрокаТаблицы.СуммаВал = СтрокаТаблицы.СуммаВал - СтрокаТаблицы.ПросроченнаяВал;
			СтрокаТаблицы.СуммаРуб = СтрокаТаблицы.СуммаРуб - СтрокаТаблицы.ПросроченнаяРуб;
		КонецЕсли;
		
		СтрокаТаблицы.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
	КоличествоСтрок = ТаблицаНовыеСтроки.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - Счетчик;
		
		ДобавленнаяСтрока = ТаблицаНовыеСтроки[ИндексСтроки];
		
		НоваяСтрока = ТаблицаЗадолженности.Вставить(ДобавленнаяСтрока.ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавленнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьДатуВозникновенияДляНеподходящихСтатусов(ТаблицаЗадолженности)
	
	СписокСтатусов = ПолучитьСтатусыЗадолженностиДопускающиеОтражениеПросроченной();
	
	ОчищающаяСтруктура = Новый Структура("ДатаВозникновения");
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		Если СписокСтатусов.Найти(СтрокаТаблицы.СтатусЗадолженности) = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ПолучитьОбщиеПараметрыПроверкиВсехРазделов()
	
	ОбщиеПараметры = Новый Структура();
	ОбщиеПараметры.Вставить("ИспользоватьВалютныйУчет",	ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ОбщиеПараметры.Вставить("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ОбщиеПараметры.Вставить("ПостфиксыВидовСуммы",		ПолучитьПостфиксыВидовСуммы());
	ОбщиеПараметры.Вставить("МетаданныеРаздел21",		Метаданные.Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ТабличныеЧасти.Раздел21);
	ОбщиеПараметры.Вставить("МетаданныеРаздел22",		Метаданные.Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ТабличныеЧасти.Раздел22);
	ОбщиеПараметры.Вставить("ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме",
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме());
		
	ОбщиеПараметры.Вставить("ПредставлениеТаблицыФрагментовСтроки",	НСтр("ru='Фрагменты строки'"));
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Процедура ПроверитьРаздел2(ДокументОбъект, НомерПодраздела, ОбщиеПараметры, ЕстьОшибки)
	
	ИмяТЧ = "Раздел2" + НомерПодраздела;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(ДокументОбъект.Ссылка, СтрокаТаблицы, ИмяТЧ, ОбщиеПараметры, ЕстьОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(ДокументСсылка, СтрокаТаблицы, ИмяТЧ, ОбщиеПараметры, ЕстьОшибки, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Реквизиты акта сверки должны быть указаны при наличии любой подтвержденной суммы.
	
	Если СтрокаТаблицы.СуммаПодтвержденнаяВал = 0 И СтрокаТаблицы.СуммаПодтвержденнаяРуб = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоляДата		= "ДатаАктаСверки";
	ИмяПоляНомер	= "НомерАктаСверки";
	
	Если ЭтоФормаРазбивкиСтроки Тогда
		МетаданныеТЧ = ОбщиеПараметры.МетаданныеРаздел21;
	Иначе
		МетаданныеТЧ = ОбщиеПараметры["Метаданные" + ИмяТЧ];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляДата]) Тогда
		Если ЭтоФормаРазбивкиСтроки Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				МетаданныеТЧ.Реквизиты[ИмяПоляДата].Синоним);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаИсходнаяСтрока", 1, ИмяПоляДата),
				, ЕстьОшибки);
		Иначе
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				МетаданныеТЧ.Реквизиты[ИмяПоляДата].Синоним,
				СтрокаТаблицы.НомерСтроки,
				МетаданныеТЧ.Синоним);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, ИмяПоляДата),
				"Объект", ЕстьОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляНомер]) Тогда
		Если ЭтоФормаРазбивкиСтроки Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				МетаданныеТЧ.Реквизиты[ИмяПоляНомер].Синоним);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаИсходнаяСтрока", 1, ИмяПоляНомер),
				, ЕстьОшибки);
		Иначе
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				МетаданныеТЧ.Реквизиты[ИмяПоляНомер].Синоним,
				СтрокаТаблицы.НомерСтроки,
				МетаданныеТЧ.Синоним);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, ИмяПоляНомер),
				"Объект", ЕстьОшибки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки)
	
	// Итоги по таблице должны совпадать с разбиваемой суммой.
	
	ЭтоИностраннаяВалюта = (ФормаРазбивкиСтроки.Валюта <> ОбщиеПараметры.ВалютаРУ);
	
	ПостфиксВалютная = ?(ЭтоИностраннаяВалюта, "Вал", "Руб");
	
	ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммамСлужебная(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки, ПостфиксВалютная);
	
	Если ЭтоИностраннаяВалюта И ОбщиеПараметры.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме Тогда
		// Проверяем также равенство рублевых итогов.
		ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммамСлужебная(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки, "Руб");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммамСлужебная(ФормаРазбивкиСтроки, ОбщиеПараметры, ЕстьОшибки, ПостфиксВалютная)
	
	ИмяПоля = ИмяПоляСумма("", ПостфиксВалютная);
	
	РазбиваемаяСумма	= ФормаРазбивкиСтроки["ИсходнаяСтрока" + ИмяПоля];
	ИтогПоТаблице		= ФормаРазбивкиСтроки["Итог" + ИмяПоля];
	
	МетаданныеТЧ = ОбщиеПараметры.МетаданныеРаздел21;
	
	Если ИтогПоТаблице <> РазбиваемаяСумма Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Итог по колонке ""%1"" (%2) отличается от разбиваемой суммы (%3) исходной строки'"),
			МетаданныеТЧ.Реквизиты[ИмяПоля].Синоним,
			Формат(ИтогПоТаблице, "ЧДЦ=2"),
			Формат(РазбиваемаяСумма, "ЧДЦ=2"));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
			"Итог" + ИмяПоля,, ЕстьОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтроки

Функция НовыйСтруктураИсходнойСтроки()
	
	Возврат Новый Структура("
		// Колонки табличной части
		|НомерСтроки,
		|КодСтроки,
		|ИдентификаторСтроки,
		|Контрагент,
		|ИдентификаторКонтрагента,
		|Договор,
		|НаименованиеДокумента,
		|ДатаДокумента,
		|НомерДокумента,
		|ДатаИсполнения,
		|КФО,
		|Счет,
		|КПС,
		|КЭК,
		|ИФО,
		|Подразделение,
		|Валюта,
		|СуммаВал,
		|СуммаРуб,
		|СтатусЗадолженности,
		|СуммаПодтвержденнаяВал,
		|СуммаПодтвержденнаяРуб,
		|СуммаНеподтвержденнаяВал,
		|СуммаНеподтвержденнаяРуб,
		|ДатаАктаСверки,
		|НомерАктаСверки,
		|СуммаТребуетРеклассификации,
		|ЗаключениеКомиссии,
		|ВидНалогаИПлатежа,
		|НалогИПлатежОрганизации");
		
КонецФункции

Функция СобратьИсходнуюСтрокуПоФрагментам(ФрагментыСтроки)
	
	СтруктураИсходнойСтроки = НовыйСтруктураИсходнойСтроки();
	
	ЗаполнитьЗначенияСвойств(СтруктураИсходнойСтроки, ФрагментыСтроки[0]);
	
	СтруктураИсходнойСтроки.СуммаВал					= ФрагментыСтроки.Итог("СуммаВал");
	СтруктураИсходнойСтроки.СуммаРуб					= ФрагментыСтроки.Итог("СуммаРуб");
	СтруктураИсходнойСтроки.СуммаПодтвержденнаяВал		= ФрагментыСтроки.Итог("СуммаПодтвержденнаяВал");
	СтруктураИсходнойСтроки.СуммаПодтвержденнаяРуб		= ФрагментыСтроки.Итог("СуммаПодтвержденнаяРуб");
	СтруктураИсходнойСтроки.СуммаНеподтвержденнаяВал	= ФрагментыСтроки.Итог("СуммаНеподтвержденнаяВал");
	СтруктураИсходнойСтроки.СуммаНеподтвержденнаяРуб	= ФрагментыСтроки.Итог("СуммаНеподтвержденнаяРуб");
	
	Возврат СтруктураИсходнойСтроки;
	
КонецФункции

Функция ПолучитьИменаПолейРаздела2РедактируемыхСОткрытиемФормыРазбивкиСтроки(ИмяТЧРаздела)
	
	ИменаПолейБезОткрытия = ПолучитьИменаПолейРаздела2РедактируемыхБезОткрытияФормыРазбивкиСтроки();
	
	ИменаПолейСОткрытием = Новый Массив();
	
	МетаданныеРеквизитов = Метаданные.Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ТабличныеЧасти[ИмяТЧРаздела].Реквизиты;
	
	Для Каждого Реквизит Из МетаданныеРеквизитов Цикл
		ИмяРеквизита = Реквизит.Имя;
		
		Если ИменаПолейБезОткрытия.Найти(ИмяРеквизита) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПолейСОткрытием.Добавить(ИмяРеквизита);
	КонецЦикла;
	
	Возврат ИменаПолейСОткрытием;
	
КонецФункции

