Функция ПолучитьДанныеДляПечати0510469(МассивОбъектов)
	
	Перем СерииДокументовДляПечати;
	
	// СерииДокументов
	ИнвентаризацияСервер.ПрочитатьСерииДокументовДляПечати(МассивОбъектов, СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", СерииДокументовДляПечати.ДополненныйМассивОбъектов);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510469();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Данные.Выборки.Вставить("Шапки",						РезультатыЗапроса[1].Выбрать());
	Данные.Выборки.Вставить("Раздел11",						РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел12",						РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел21",						РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел22",						РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела21ПоСчету",		РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела21ПоКонтрагенту",	РезультатыЗапроса[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела22ПоСчету",		РезультатыЗапроса[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела22ПоКонтрагенту",	РезультатыЗапроса[9].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(СерииДокументовДляПечати.ДополненныйМассивОбъектов));
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(СерииДокументовДляПечати.ДополненныйМассивОбъектов));
	
	Данные.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоСчету_Часть1", ПолучитьСтруктуруЗаполненияПустыхИтоговПоСчету_Часть1());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоСчету_Часть2", ПолучитьСтруктуруЗаполненияПустыхИтоговПоСчету_Часть2());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоКонтрагенту_Часть1", ПолучитьСтруктуруЗаполненияПустыхИтоговПоКонтрагенту_Часть1());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоКонтрагенту_Часть2", ПолучитьСтруктуруЗаполненияПустыхИтоговПоКонтрагенту_Часть2());
	
	Данные.Вставить("ОписаниеСтатусовЗадолженности", ИнвентаризацияКлиентСервер.ПолучитьОписаниеСтатусовЗадолженности());
	Данные.Вставить("ВалютаРУ", Константы.ВалютаРегламентированногоУчета.Получить());
	Данные.Вставить("СимволПустойВалютнойСуммыДляРублей", "х");
	
	// СерииДокументов
	Данные.Выборки.Вставить("ШапкиПоискаЗаголовочныхДокументов", РезультатыЗапроса[1].Выбрать());
	Данные.Вставить("СерииДокументовДляПечати", СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ОбщиеПоляРазделов = "ВидРасчетов,НомерСчета,ИдентификаторКонтрагента,НаименованиеКонтрагента"
		+ ",НаименованиеДокумента,ДатаДокумента,НомерДокумента,ДатаИсполнения,КодВалюты";
		
	ПоляЧасти1 = ОбщиеПоляРазделов + ",КодСтатуса,НаименованиеСтатуса";
	ПоляЧасти2 = "ДатаАктаСверки,НомерАктаСверки,ЗаключениеКомиссии";
	
	ПоляИтогоПоНомеруСчета = "НомерСчета";
	ПоляИтогоПоКонтрагенту = "ИдентификаторКонтрагента,НаименованиеКонтрагента";
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Раздел11",								ОбщиеПоляРазделов);
	ИменаПолей.Вставить("Раздел12",								ОбщиеПоляРазделов);
	ИменаПолей.Вставить("Раздел21_Часть1_СтрокаТаблицы",		ПоляЧасти1);
	ИменаПолей.Вставить("Раздел21_Часть1_ИтогоПоНомеруСчета",	ПоляИтогоПоНомеруСчета);
	ИменаПолей.Вставить("Раздел21_Часть1_ИтогоПоКонтрагенту",	ПоляИтогоПоКонтрагенту);
	ИменаПолей.Вставить("Раздел21_Часть2_СтрокаТаблицы",		ПоляЧасти2);
	ИменаПолей.Вставить("Раздел22_Часть1_СтрокаТаблицы",		ПоляЧасти1);
	ИменаПолей.Вставить("Раздел22_Часть1_ИтогоПоНомеруСчета",	ПоляИтогоПоНомеруСчета);
	ИменаПолей.Вставить("Раздел22_Часть1_ИтогоПоКонтрагенту",	ПоляИтогоПоКонтрагенту);
	ИменаПолей.Вставить("Раздел22_Часть2_СтрокаТаблицы",		ПоляЧасти2);
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
КонецФункции

Функция ПолучитьСтруктуруЗаполненияПустыхИтоговПоСчету_Часть1()
	
	СимволПрочерка = НСтр("ru='—'");
	ПредставлениеНуля = "0,00";
	
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("НомерСчета", СимволПрочерка);
