Функция ПолучитьДанныеБухУчета(ПараметрыПроцедуры)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ПараметрыПроцедуры);
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",						ПараметрыПоиска.ДатаОстатков);
	ЗапросПоиск.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("Подразделение",						ПараметрыПоиска.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ЗаполнятьКодЦели",					ПараметрыПоиска.ЗаполнятьКодЦели);
	ЗапросПоиск.УстановитьПараметр("СчетаДЗ",							ПараметрыПоиска.СчетаДЗ);
	ЗапросПоиск.УстановитьПараметр("СчетаКЗ",							ПараметрыПоиска.СчетаКЗ);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ПараметрыПоиска.ИспользоватьОтборПоКонтрагенту);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",				ПараметрыПоиска.СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("КЭК000",							ПараметрыПоиска.КЭК000);
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	ЗапросПоиск.УстановитьПараметр("СписокИсключаемыхСчетов",			ПараметрыПоиска.СписокИсключаемыхСчетов);
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьКонтрольИсполненияДоговоров", ПараметрыПоиска.ИспользоватьКонтрольИсполненияДоговоров);
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	ЗапросПоиск.УстановитьПараметр("ПустаяВалюта",						ПараметрыПоиска.ПустаяВалюта);
	ЗапросПоиск.УстановитьПараметр("ПустойКонтрагент",					ПараметрыПоиска.ПустойКонтрагент);
	ЗапросПоиск.УстановитьПараметр("Счета30300",						ПараметрыПоиска.Счета30300);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстатки();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапросов = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	СчетаРасчетовКИСЕ = БухгалтерскийУчет.СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ());
	
	// [4]. Дебиторская задолженность
	ТаблицаДебиторскаяЗадолженность = РезультатыЗапросов[4].Выгрузить();
	
	ДозаполнитьТаблицуЗадолженностиПоДаннымБухУчета(ТаблицаДебиторскаяЗадолженность,
		Перечисления.ВидыЗадолженности.Дебиторская,
		ПараметрыПроцедуры,
		ПараметрыПоиска,
		СчетаРасчетовКИСЕ);
	
	// [5]. Кредиторская задолженность
	ТаблицаКредиторскаяЗадолженность = РезультатыЗапросов[5].Выгрузить();
	
	ДозаполнитьТаблицуЗадолженностиПоДаннымБухУчета(ТаблицаКредиторскаяЗадолженность,
		Перечисления.ВидыЗадолженности.Кредиторская,
		ПараметрыПроцедуры,
		ПараметрыПоиска,
		СчетаРасчетовКИСЕ);
	
	Если ПараметрыПроцедуры.РежимЗаполнения > 0 Тогда
		ПараметрыПоискаОборотов = ИнвентаризацияСервер.ПолучитьПустыеПараметрыПоискаОборотовСНачалаГода();
		ПараметрыПоискаОборотов.Организация							= ПараметрыПроцедуры.Организация;
		ПараметрыПоискаОборотов.ДатаИнвентаризации					= ПараметрыПроцедуры.ДатаИнвентаризации;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоИФО				= ПараметрыПоиска.ИспользоватьУчетПоИФО;
		ПараметрыПоискаОборотов.ИспользоватьУчетПоПодразделениям	= ПараметрыПоиска.ИспользоватьУчетПоПодразделениям;
		
		ИнвентаризацияСервер.ОставитьОстаткиТолькоПросроченнойЗадолженности61н(ТаблицаДебиторскаяЗадолженность, ПараметрыПоискаОборотов, ПараметрыПроцедуры.РежимЗаполнения);
		ИнвентаризацияСервер.ОставитьОстаткиТолькоПросроченнойЗадолженности61н(ТаблицаКредиторскаяЗадолженность, ПараметрыПоискаОборотов, ПараметрыПроцедуры.РежимЗаполнения);
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Раздел11", ТаблицаДебиторскаяЗадолженность);
	Результат.Вставить("Раздел12", ТаблицаКредиторскаяЗадолженность);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыПоискаОстатков(ПараметрыПроцедуры)
	
	ИспользоватьУчетПоИФО					= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет				= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьУчетПоПодразделениям		= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьКонтрольИсполненияДоговоров	= ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	НастройкиОтбораСчетовИКФО = ИнвентаризацияСервер.ПолучитьНастройкиОтбораСчетовИКФО(ПараметрыПроцедуры.СписокСчетов, ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	СчетаДЗ = БухгалтерскийУчет.СписокСчетов("04", ДатаОстатков);
	СчетаКЗ = БухгалтерскийУчет.СписокСчетов("20", ДатаОстатков);
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",						ДатаОстатков);
	ПараметрыПоиска.Вставить("Организация",							ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",				ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",									ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоПодразделению",	ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("Подразделение",						ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ЗаполнятьКодЦели",					Ложь);
	ПараметрыПоиска.Вставить("СчетаДЗ",								СчетаДЗ);
	ПараметрыПоиска.Вставить("СчетаКЗ",								СчетаКЗ);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКонтрагенту",		Ложь);
	ПараметрыПоиска.Вставить("СписокКонтрагентов",					Новый Массив());
	ПараметрыПоиска.Вставить("КЭК000",								БухгалтерскийУчетПовтИсп.КЭК0());
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",				НастройкиОтбораСчетовИКФО.ИспользоватьОтборПоКФО);
	ПараметрыПоиска.Вставить("СписокКФО",							НастройкиОтбораСчетовИКФО.СписокКФО);
	ПараметрыПоиска.Вставить("СписокСчетов",						НастройкиОтбораСчетовИКФО.СписокСчетов);
	ПараметрыПоиска.Вставить("ТаблицаИсключаемыхСчетов",			НастройкиОтбораСчетовИКФО.ДетальнаяТаблицаИсключаемыеСчета);
	ПараметрыПоиска.Вставить("СписокИсключаемыхСчетов",
		ИнвентаризацияСервер.ПолучитьСписокИсключаемыхСчетовИзНастроекЗаполненияОписейПоРешению(
			Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами"), ПараметрыПроцедуры.Организация));
	
	ПараметрыПоиска.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ИспользоватьКонтрольИсполненияДоговоров);
	
	ПараметрыПоиска.Вставить("ИспользоватьВалютныйУчет",			ИспользоватьВалютныйУчет);
	ПараметрыПоиска.Вставить("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ПараметрыПоиска.Вставить("ПустаяВалюта",						Справочники.Валюты.ПустаяСсылка());
	ПараметрыПоиска.Вставить("ПустойКонтрагент",					Справочники.Контрагенты.ПустаяСсылка());
	ПараметрыПоиска.Вставить("Счета30300",							БухгалтерскийУчет.СписокСчетов("303.00"));
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстатки()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые счета
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО	КАК КФО,
	|	ТЗ.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблицаИсключаемыхСчетов
	|ИЗ
	|	&ТаблицаИсключаемыхСчетов КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Отбор контрагентов
	|//
	|ВЫБРАТЬ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	ОтборКонтрагентов
	|ИЗ
	|	Справочник.Контрагенты
	|ГДЕ
	|	&ИспользоватьОтборПоКонтрагенту И Ссылка В ИЕРАРХИИ(&СписокКонтрагентов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Фактические остатки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет													КАК Счет,
	|	Счет.Вид												КАК СчетВид,
	|	Счет.Порядок											КАК СчетПорядок,
	|	Счет.Валютный											КАК СчетВалютный,
	|	Счет.Забалансовый										КАК СчетЗабалансовый,
	|	Счет.БезДетализацииКОСГУ								КАК СчетБезДетализацииКОСГУ,
	|	ВЫБОР
	|		КОГДА Счет.КОСГУКт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) ТОГДА
	|			""0""
	|		ИНАЧЕ
	|			ПОДСТРОКА(Счет.КОСГУКт.Код, 3, 1)
	|	КОНЕЦ 													КАК СчетКИЕ,
	|	КФО														КАК КФО,
	|	КПС														КАК КПС,
	|	ВЫБОР
	|		КОГДА Счет.Забалансовый ТОГДА
	|			КЭК
	|		ИНАЧЕ
	|			&КЭК000
	|	КОНЕЦ													КАК КЭК,
	|	ВЫБОР 
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ													КАК ИФО,
	|	ВЫБОР 
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ													КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто1
	|		КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто2
	|		КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто3
	|			
	|		КОГДА Субконто1 ССЫЛКА Справочник.ОбъектыФинансовыхВложений ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, &ПустойКонтрагент)
	|		КОГДА Субконто2 ССЫЛКА Справочник.ОбъектыФинансовыхВложений ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, &ПустойКонтрагент)
	|		КОГДА Субконто3 ССЫЛКА Справочник.ОбъектыФинансовыхВложений ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.ОбъектыФинансовыхВложений).Контрагент, &ПустойКонтрагент)
	|			
	|		ИНАЧЕ
	|			&ПустойКонтрагент
