#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура УстановитьВыявленныеОтклонения(ДокументОбъект) Экспорт
	
	ВыявленыНеподтвержденныеСуммы21			= Ложь;
	ВыявленыСуммыТребующиеРеклассификации21	= Ложь;
	
	ВыявленыНеподтвержденныеСуммы22			= Ложь;
	ВыявленыСуммыТребующиеРеклассификации22	= Ложь;
	
	ВыявитьОтклоненияВТаблице(ДокументОбъект.Раздел21, ВыявленыНеподтвержденныеСуммы21, ВыявленыСуммыТребующиеРеклассификации21);
	ВыявитьОтклоненияВТаблице(ДокументОбъект.Раздел22, ВыявленыНеподтвержденныеСуммы22, ВыявленыСуммыТребующиеРеклассификации22);
	
	ДокументОбъект.ВыявленыНеподтвержденныеСуммы = ВыявленыНеподтвержденныеСуммы21 Или ВыявленыНеподтвержденныеСуммы22;
	ДокументОбъект.ВыявленыСуммыТребующиеРеклассификации = ВыявленыСуммыТребующиеРеклассификации21 Или ВыявленыСуммыТребующиеРеклассификации22;
	
КонецПроцедуры

Функция ПолучитьСтатусыЗадолженностиДопускающиеРеклассификацию() Экспорт
	
	Возврат ИнвентаризацияКлиентСервер.ПолучитьСтатусыПросроченнойЗадолженности();
	
КонецФункции

Функция ПолучитьСтатусыЗадолженностиДопускающиеОтражениеПросроченной() Экспорт
	
	Возврат ИнвентаризацияКлиентСервер.ПолучитьСтатусыЗадолженностиДопускающиеОтражениеПросроченной();
	
КонецФункции

#Область НастройкаФорм

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	ПрежнийИдентификаторСтроки = Неопределено;
	
	Для Каждого СтрокаТаблицы Из Объект.Раздел21 Цикл
		СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
		
		Если СтрокаТаблицы.ПризнакФрагментаСтроки И ПрежнийИдентификаторСтроки <> СтрокаТаблицы.ИдентификаторСтроки Тогда
			ПрежнийИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
			
			СтрокаТаблицы.ПризнакПервогоФрагментаСтроки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПрежнийИдентификаторСтроки = Неопределено;
	
	Для Каждого СтрокаТаблицы Из Объект.Раздел22 Цикл
		СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
		
		Если СтрокаТаблицы.ПризнакФрагментаСтроки И ПрежнийИдентификаторСтроки <> СтрокаТаблицы.ИдентификаторСтроки Тогда
			ПрежнийИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
			
			СтрокаТаблицы.ПризнакПервогоФрагментаСтроки = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление(ФормаДокумента) Экспорт
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента);
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыУсловногоОформления();
	
	// Раздел 1.
	
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "Раздел11");
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "Раздел12");
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел11");
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел12");
	
	// Раздел 2.
	
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "Раздел22");
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "ИтогиРаздела21ПоКонтрагенту");
	ДобавитьУсловноеОформление_ВывестиНаименованиеВидаНалогаИПлатежа(УсловноеОформление, "ИтогиРаздела22ПоКонтрагенту");
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел21");
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел22");
	
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел21");
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "Раздел22");
	
	Если ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности() Тогда
		ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, "Раздел21");
		ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, "Раздел22");
	Иначе
		ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, "Раздел21");
		ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, "Раздел22");
	КонецЕсли;
	
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНулевойСумме(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНулевойСумме(УсловноеОформление, "Раздел22");
	
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНеподходящемСтатусе(УсловноеОформление, "Раздел21", ОбщиеПараметры);
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНеподходящемСтатусе(УсловноеОформление, "Раздел22", ОбщиеПараметры);
	
	ДобавитьУсловноеОформление_ПоляФрагментовСтрокиРедактируемыеСОткрытиемФормы(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_ПоляФрагментовСтрокиРедактируемыеСОткрытиемФормы(УсловноеОформление, "Раздел22");
	
	ДобавитьУсловноеОформление_ПервыеФрагментыСтрок(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_ПервыеФрагментыСтрок(УсловноеОформление, "Раздел22");
	
	ДобавитьУсловноеОформление_ОчередныеФрагментыСтрок(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_ОчередныеФрагментыСтрок(УсловноеОформление, "Раздел22");
	
	ДобавитьУсловноеОформление_НедоступностьПолейОтраженияПросроченнойЗадолженности(УсловноеОформление, "Раздел21", ОбщиеПараметры);
	ДобавитьУсловноеОформление_НедоступностьПолейОтраженияПросроченнойЗадолженности(УсловноеОформление, "Раздел22", ОбщиеПараметры);
	
	// Список счетов.
	ДобавитьУсловноеОформление_КФО0ВСпискеСчетов(УсловноеОформление);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление_ФормаРазбивкиСтроки(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыУсловногоОформления();
	
	Если ИнвентаризацияКлиентСервер.ДоступноУказаниеАктаСверкиПриОтсутствииПодтвержденнойЗадолженности() Тогда
		ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, Неопределено, Истина);
	Иначе
		ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, Неопределено, Истина);
	КонецЕсли;
	
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаИсходнаяСтрока", Истина);
	ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНулевойСумме(УсловноеОформление, "ТаблицаФрагментыСтроки", Истина);
	
	ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНеподходящемСтатусе(УсловноеОформление, "ТаблицаФрагментыСтроки", ОбщиеПараметры, Истина);
	
	ДобавитьУсловноеОформление_НедоступностьПолейОтраженияПросроченнойЗадолженности(УсловноеОформление, "ТаблицаФрагментыСтроки", ОбщиеПараметры, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРазделов

Функция ПолучитьДанныеДляРаздела1(ПараметрыФункции) Экспорт
	
	Данные = ПолучитьДанныеБухУчета(ПараметрыФункции);
	
	РасчетСерииДокументов = ИнвентаризацияСервер.РассчитатьСериюДокументов(Данные, ПараметрыФункции);
	
	Если РасчетСерииДокументов = Неопределено Тогда
		Возврат Данные;
	Иначе
		ИнвентаризацияСервер.СоздатьСериюДокументов(РасчетСерииДокументов, Данные, ПараметрыФункции);
		
		Возврат РасчетСерииДокументов;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела2(ПараметрыФункции) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.Ссылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Раздел11,
	|	Раздел12
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыявленыНеподтвержденныеСуммы = Ложь;
	ВыявленыСуммыТребующиеРеклассификации = Ложь;
	
	Если Таблица.Количество() = 0 Тогда
		ТаблицаРаздела21 = Новый ТаблицаЗначений();
		ТаблицаРаздела22 = Новый ТаблицаЗначений();
		
		ИтогиРаздела21ПоСчету		= Новый ТаблицаЗначений();
		ИтогиРаздела21ПоКонтрагенту	= Новый ТаблицаЗначений();
		ИтогиРаздела22ПоСчету		= Новый ТаблицаЗначений();
		ИтогиРаздела22ПоКонтрагенту	= Новый ТаблицаЗначений();
	Иначе
		ТаблицаРаздела21 = Таблица[0].Раздел11;
		ТаблицаРаздела22 = Таблица[0].Раздел12;
		
		МетаданныеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами.ТабличныеЧасти;
		
		ИнвентаризацияСервер.ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(ТаблицаРаздела21, МетаданныеТЧ.Раздел21);
		ИнвентаризацияСервер.ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(ТаблицаРаздела22, МетаданныеТЧ.Раздел22);
		
		Если ИнвентаризацияКлиентСервер.ПриОтсутствииАктаСверкиСчитатьВсюЗадолженностьНеподтвержденной() Тогда
			// По умолчанию все суммы считаем не подтвержденными актом сверки.
			ТаблицаРаздела21.ЗагрузитьКолонку(ТаблицаРаздела21.ВыгрузитьКолонку("СуммаВал"), "СуммаНеподтвержденнаяВал");
			ТаблицаРаздела21.ЗагрузитьКолонку(ТаблицаРаздела21.ВыгрузитьКолонку("СуммаРуб"), "СуммаНеподтвержденнаяРуб");
			
			ТаблицаРаздела22.ЗагрузитьКолонку(ТаблицаРаздела22.ВыгрузитьКолонку("СуммаВал"), "СуммаНеподтвержденнаяВал");
			ТаблицаРаздела22.ЗагрузитьКолонку(ТаблицаРаздела22.ВыгрузитьКолонку("СуммаРуб"), "СуммаНеподтвержденнаяРуб");
			
			// Отклонения считаются выявленными при наличии суммы, не подтвержденной актом сверки.
			// По текущему алгоритму сумма задолженности при заполнении раздела 2 считается не подтвержденной актом сверки в полном объеме.
			// Строка с такой суммой обязательно есть в одной из таблиц, если таблица заполнена.
			ВыявленыНеподтвержденныеСуммы = ТаблицаРаздела21.Количество() > 0 Или ТаблицаРаздела22.Количество() > 0;
		КонецЕсли;
		
		Строка21 = ТаблицаРаздела21.Найти(Истина, "СуммаТребуетРеклассификации");
		Строка22 = ТаблицаРаздела22.Найти(Истина, "СуммаТребуетРеклассификации");
		
		ВыявленыСуммыТребующиеРеклассификации = (Строка21 <> Неопределено Или Строка22 <> Неопределено);
		
		ИтогиРаздела2 = РассчитатьИтогиРаздела2(ТаблицаРаздела21, ТаблицаРаздела22);
		ИтогиРаздела21ПоСчету		= ИтогиРаздела2.ИтогиРаздела21ПоСчету;
		ИтогиРаздела21ПоКонтрагенту = ИтогиРаздела2.ИтогиРаздела21ПоКонтрагенту;
		ИтогиРаздела22ПоСчету		= ИтогиРаздела2.ИтогиРаздела22ПоСчету;
		ИтогиРаздела22ПоКонтрагенту	= ИтогиРаздела2.ИтогиРаздела22ПоКонтрагенту;
		
		ПараметрыЗаполнения = ПолучитьПараметрыЗаполненияСтатусовРаздела2();
		
		ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаРаздела21, Истина, ПараметрыЗаполнения);
		ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаРаздела22, Ложь, ПараметрыЗаполнения);
		
		ОчиститьДатуВозникновенияДляНеподходящихСтатусов(ТаблицаРаздела21);
		ОчиститьДатуВозникновенияДляНеподходящихСтатусов(ТаблицаРаздела22);
	КонецЕсли;
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаРаздела21",				ТаблицаРаздела21);
	Данные.Вставить("ТаблицаРаздела22",				ТаблицаРаздела22);
	Данные.Вставить("ИтогиРаздела21ПоСчету",		ИтогиРаздела21ПоСчету);
	Данные.Вставить("ИтогиРаздела21ПоКонтрагенту",	ИтогиРаздела21ПоКонтрагенту);
	Данные.Вставить("ИтогиРаздела22ПоСчету",		ИтогиРаздела22ПоСчету);
	Данные.Вставить("ИтогиРаздела22ПоКонтрагенту",	ИтогиРаздела22ПоКонтрагенту);
	
	Данные.Вставить("ВыявленыНеподтвержденныеСуммы",			ВыявленыНеподтвержденныеСуммы);
	Данные.Вставить("ВыявленыСуммыТребующиеРеклассификации",	ВыявленыСуммыТребующиеРеклассификации);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьСпискиЗабалансовыхСчетов() Экспорт
	
	СчетаДЗ = БухгалтерскийУчет.СписокСчетов("04,42");
	СчетаКЗ = БухгалтерскийУчет.СписокСчетов("20");
	
	СчетаВсе = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(СчетаДЗ);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаВсе, СчетаКЗ, Истина);
	
	ЗабалансовыеСчета = Новый Структура();
	ЗабалансовыеСчета.Вставить("ДЗ", СчетаДЗ);
	ЗабалансовыеСчета.Вставить("КЗ", СчетаКЗ);
	ЗабалансовыеСчета.Вставить("Все", СчетаВсе);
	
	Возврат ЗабалансовыеСчета;
	
КонецФункции

Процедура ЗаполнитьИтогиРаздела2(ДокументОбъект) Экспорт
	
	ИтогиРаздела2 = РассчитатьИтогиРаздела2(ДокументОбъект.Раздел21, ДокументОбъект.Раздел22);
	
	КолонкиГруппировкиСчет = ПолучитьИменаКолонокГруппировкиСчет();
	КолонкиГруппировкиКонтрагент = ПолучитьИменаКолонокГруппировкиКонтрагент();
	КолонкиСуммирования = ПолучитьИменаКолонокСумирования();
	
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(
		ДокументОбъект.ИтогиРаздела21ПоСчету, ИтогиРаздела2.ИтогиРаздела21ПоСчету,
		КолонкиГруппировкиСчет, КолонкиСуммирования);
		
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(
		ДокументОбъект.ИтогиРаздела21ПоКонтрагенту, ИтогиРаздела2.ИтогиРаздела21ПоКонтрагенту,
		КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
		
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(
		ДокументОбъект.ИтогиРаздела22ПоСчету, ИтогиРаздела2.ИтогиРаздела22ПоСчету,
		КолонкиГруппировкиСчет, КолонкиСуммирования);
		
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(
		ДокументОбъект.ИтогиРаздела22ПоКонтрагенту, ИтогиРаздела2.ИтогиРаздела22ПоКонтрагенту,
		КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
		
КонецПроцедуры

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	Если ДокументОбъект.Раздел11.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
	КонецЕсли;
	
	Если ДокументОбъект.Раздел12.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел22", ЕстьОшибки);
	КонецЕсли;
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов();
	
	ПроверитьРаздел2(ДокументОбъект, 1, ОбщиеПараметры, ЕстьОшибки);
	ПроверитьРаздел2(ДокументОбъект, 2, ОбщиеПараметры, ЕстьОшибки);
	
	// В содержательных документах серии не указывается состав комиссии.
	Если Не ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки);
		
		ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель");
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ПроверитьФормуРазбивкиСтроки(ФормаРазбивкиСтроки, Отказ) Экспорт
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыПроверкиВсехРазделов();
	
	СтрокаТаблицы = ФормаРазбивкиСтроки.ТаблицаИсходнаяСтрока[0];
	
	ПроверитьРаздел2_ЗаполненыРеквизитыАктаСверки(Неопределено, СтрокаТаблицы, Неопределено, ОбщиеПараметры, Отказ, Истина);

	ПроверитьРаздел2_СуммыФрагментовРавныРазбиваемымСуммам(ФормаРазбивкиСтроки, ОбщиеПараметры, Отказ);	
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Знач РежимЗаполнения, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	МетаданныеДокумента = Метаданные.Документы.ИнвентаризационнаяОписьРасчетовСКонтрагентами;
	
	Если ДокументОбъект.СписокСчетов.Количество() = 0 Тогда
		Отказ = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение", МетаданныеДокумента.ТабличныеЧасти.СписокСчетов.Синоним),
			ДокументОбъект.Ссылка,
			"Объект.СписокСчетов");
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтроки

Функция ПолучитьПараметрыФормыРазбивкиСтроки(ФормаДокумента, ТекДанные, ИмяТЧ) Экспорт
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		ТаблицаФрагментов = ПолучитьФрагментыРазбитойСтроки(ДокументОбъект[ИмяТЧ], ТекДанные.ИдентификаторСтроки);
		
		ИсходнаяСтрока = СобратьИсходнуюСтрокуПоФрагментам(ТаблицаФрагментов);
		
		ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаФрагментов);
	Иначе
		ФрагментыСтроки = Неопределено;
		
		ИсходнаяСтрока = НовыйСтруктураИсходнойСтроки();
		
		ЗаполнитьЗначенияСвойств(ИсходнаяСтрока, ТекДанные);
	КонецЕсли;
	
	ПараметрыФормыРазбивки = Новый Структура();
	ПараметрыФормыРазбивки.Вставить("ИсходнаяСтрока", ИсходнаяСтрока);
	ПараметрыФормыРазбивки.Вставить("ФрагментыСтроки", ФрагментыСтроки);
	ПараметрыФормыРазбивки.Вставить("ИмяТЧ", ИмяТЧ);
	ПараметрыФормыРазбивки.Вставить("ОписьСсылка", ДокументОбъект.Ссылка);
	ПараметрыФормыРазбивки.Вставить("ВалютаРУ", ФормаДокумента.ВалютаРУ);
	
	Возврат ПараметрыФормыРазбивки;
	
КонецФункции

Функция ПолучитьФрагментыРазбитойСтроки(ТаблицаРаздела, ИдентификаторСтроки) Экспорт
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	ТаблицаФрагментов = ТаблицаРаздела.Выгрузить(Поиск);
	
	ТаблицаФрагментов.Сортировать("НомерСтроки");
	
	Возврат ТаблицаФрагментов;
	
КонецФункции

Функция ПолучитьИменаПолейРаздела2РедактируемыхБезОткрытияФормыРазбивкиСтроки() Экспорт
	
	// Оба раздела 2.1 и 2.2 имеют одинаковый состав колонок.
	
	МассивИмен = Новый Массив();
	
	МассивИмен.Добавить("ЗаключениеКомиссии");
	МассивИмен.Добавить("ДатаВозникновения");
	МассивИмен.Добавить("ПричинаОбразованияКод");
	МассивИмен.Добавить("ПричинаОбразованияПояснение");
	МассивИмен.Добавить("ПричинаОбразованияДополнительно");
	
	Возврат МассивИмен;
	
КонецФункции

Функция ПолучитьТаблицыИтоговСуммБухУчетаФрагментовСтрок(ФормаДокумента, ИмяТабличнойЧасти, СписокИдентификаторовСтрок) Экспорт
	
	ТабличнаяЧасть = ФормаДокумента.Объект[ИмяТабличнойЧасти];
	
	ИменаПолейСуммыБухУчетаСтрокой = "СуммаВал,СуммаРуб";
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ТаблицыИтогов = Новый Соответствие();
	
	Для Каждого ИдентификаторСтроки Из СписокИдентификаторовСтрок Цикл
		Поиск.ИдентификаторСтроки = ИдентификаторСтроки;
		
		ТаблицаФрагментов = ТабличнаяЧасть.Выгрузить(Поиск, ИменаПолейСуммыБухУчетаСтрокой);
		ТаблицаФрагментов.Свернуть(, ИменаПолейСуммыБухУчетаСтрокой);
		
		ТаблицыИтогов.Вставить(ИдентификаторСтроки, ТаблицаФрагментов);
	КонецЦикла;
	
	Возврат ТаблицыИтогов;
	
КонецФункции

#КонецОбласти

#Область РеестрДокументовКПроводимойИнвентаризации

Функция ПрочитатьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДокументСсылка) Экспорт
	
	ДанныеОписи = Отчеты.РеестрДокументовКПроводимойИнвентаризации.НовыйОбщиеДанныеОписи();
	
	ДанныеОписи.Вставить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ДанныеОписи.Вставить("СписокСчетов");
	
	ДанныеОписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ДанныеОписи);
	
	ДанныеОписи.СписокСчетов = ДанныеОписи.СписокСчетов.Выгрузить();
	
	Возврат ДанныеОписи;
	
КонецФункции

Процедура ПроверитьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(Знач ДанныеОписи, Отказ) Экспорт
	
	Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПроверитьОбщиеДанныеОписи(ДанныеОписи, Отказ);
	
	ШаблонСообщения = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьШаблонСообщенияПроверкиПередФормированиемРеестра();
	
	Если Не ЗначениеЗаполнено(ДанныеОписи.ОтветственныйИсполнительБухгалтерскойСлужбы) Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru='Ответственный исполнитель бух. службы'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "ОтветственныйИсполнительБухгалтерскойСлужбы", "Объект", Отказ);
	КонецЕсли;
	
	Если ДанныеОписи.СписокСчетов.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, НСтр("ru='Список счетов'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "СписокСчетов", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументыДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, ПериодФормирования) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ДанныеОписи);
	
	ЗапросДокументы = Новый Запрос();
	ЗапросДокументы.УстановитьПараметр("ДатаНачала",						НачалоДня(ПериодФормирования.Дата1));
	ЗапросДокументы.УстановитьПараметр("ДатаОкончания",						КонецДня(ПериодФормирования.Дата2));
	
	ЗапросДокументы.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросДокументы.УстановитьПараметр("СписокПодразделений",				ПараметрыПоиска.Подразделение);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ПараметрыПоиска.ИспользоватьОтборПоКонтрагенту);
	ЗапросДокументы.УстановитьПараметр("СписокКонтрагентов",				ПараметрыПоиска.СписокКонтрагентов);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросДокументы.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросДокументы.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросДокументы.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросДокументы.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	ЗапросДокументы.УстановитьПараметр("ПустаяВалюта",						ПараметрыПоиска.ПустаяВалюта);
	
	ЗапросДокументы.Текст = ПолучитьТекстЗапросаДокументыИзмененияЗадолженности();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов = ЗапросДокументы.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

