#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПостфиксыВидовСуммы()
	
	ПостфиксыВидовСуммы = Новый Массив();
	
	ПостфиксыВидовСуммы.Добавить("");
	ПостфиксыВидовСуммы.Добавить("Подтвержденная");
	ПостфиксыВидовСуммы.Добавить("Неподтвержденная");
	
	Возврат ПостфиксыВидовСуммы;
	
КонецФункции

Функция ИмяПоляСумма(ПостфиксВидаСуммы, ПостфиксВалютная)
	
	Возврат СтрШаблон("Сумма%1%2", ПостфиксВидаСуммы, ПостфиксВалютная);
	
КонецФункции

Процедура ВыявитьОтклоненияВТаблице(Знач Таблица, ВыявленыНеподтвержденныеСуммы, ВыявленыСуммыТребующиеРеклассификации)
	
	ВыявленыНеподтвержденныеСуммы = Ложь;
	ВыявленыСуммыТребующиеРеклассификации = Ложь;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.СуммаНеподтвержденнаяВал <> 0 Или СтрокаТаблицы.СуммаНеподтвержденнаяРуб <> 0 Тогда
			ВыявленыНеподтвержденныеСуммы = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаТребуетРеклассификации И (СтрокаТаблицы.СуммаВал <> 0 Или СтрокаТаблицы.СуммаРуб <> 0) Тогда
			ВыявленыСуммыТребующиеРеклассификации = Истина;
		КонецЕсли;
		
		Если ВыявленыНеподтвержденныеСуммы И ВыявленыСуммыТребующиеРеклассификации Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область НастройкаФорм

Функция ПолучитьОбщиеПараметрыУсловногоОформления()
	
	ОбщиеПараметры = Новый Структура();
	
	ОбщиеПараметры.Вставить("СтатусыЗадолженностиДопускающиеРеклассификацию",
		ПолучитьСтатусыЗадолженностиДопускающиеРеклассификацию());
		
	ОбщиеПараметры.Вставить("СтатусыЗадолженностиДопускающиеОтражениеПросроченной",
		ПолучитьСтатусыЗадолженностиДопускающиеОтражениеПросроченной());
	
	ОбщиеПараметры.Вставить("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ОбщиеПараметры.Вставить("ПостфиксыВидовСуммы",				ПолучитьПостфиксыВидовСуммы());
	ОбщиеПараметры.Вставить("ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме",
		ИнвентаризацияКлиентСервер.ОбеспечиватьРавенствоИтоговРублевыхФрагментовРазбиваемойСумме());
		
	Возврат ОбщиеПараметры;
	
КонецФункции

Процедура ДобавитьУсловноеОформление_КФО0ВСпискеСчетов(УсловноеОформление)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Представление пустого КФО в списке счетов'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СписокСчетов.КФО");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "0");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСчетовКФО");
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Валютные суммы недоступны при указании валюты Рубль.
	
	ПутьКДанным = ?(ЭтоФормаРазбивкиСтроки, "", "Объект.") + ИмяТЧ;
	
	Для Каждого ПостфиксВидаСуммы Из ОбщиеПараметры.ПостфиксыВидовСуммы Цикл
		ИмяПоля = ИмяПоляСумма(ПостфиксВидаСуммы, "Вал");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность валютных сумм (%1, %2)'"), ИмяПоля, ИмяТЧ);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = ОбщиеПараметры.ВалютаРУ;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
		
		Если ЭтоФормаРазбивкиСтроки И ИмяТЧ = "ТаблицаФрагментыСтроки" Тогда
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьРублевыхСумм(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Рублевые суммы недоступны и рассчитываются автоматически при указании иностранной валюты.
	
	ПутьКДанным = ?(ЭтоФормаРазбивкиСтроки, "", "Объект.") + ИмяТЧ;
	
	Для Каждого ПостфиксВидаСуммы Из ОбщиеПараметры.ПостфиксыВидовСуммы Цикл
		ИмяПоля = ИмяПоляСумма(ПостфиксВидаСуммы, "Руб");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность рублевых сумм иностранной валюты (%1, %2)'"), ИмяПоля, ИмяТЧ);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным + ".Валюта");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = ОбщиеПараметры.ВалютаРУ;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
		
		Если ЭтоФормаРазбивкиСтроки И ИмяТЧ = "ТаблицаФрагментыСтроки" Тогда
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// Акт сверки не требуется, если одновременно и валютная, и рублевая ПОДТВЕРЖДЕННАЯ сумма равны нулю.
	
	ПостфиксВидаСуммы = "Подтвержденная";
	
	ИмяПоляВалютнойСуммы = ИмяПоляСумма(ПостфиксВидаСуммы, "Вал");
	ИмяПоляРублевойСуммы = ИмяПоляСумма(ПостфиксВидаСуммы, "Руб");
	
	Если ЭтоФормаРазбивкиСтроки Тогда
		ПутьПоляВалютнойСуммы = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляВалютнойСуммы);
		ПутьПоляРублевойСуммы = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляРублевойСуммы);
	Иначе
		ПутьПоляВалютнойСуммы = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляВалютнойСуммы);
		ПутьПоляРублевойСуммы = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляРублевойСуммы);
	КонецЕсли;
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаАктаСверки");
	ИменаПолей.Добавить("НомерАктаСверки");
	
	Для Каждого ИмяПоляАктаСверки Из ИменаПолей Цикл
		Если ЭтоФормаРазбивкиСтроки Тогда
			ПутьПоляАктаСверки = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляАктаСверки);
			ИмяОформляемогоЭлемента = "ТаблицаИсходнаяСтрока" + ИмяПоляАктаСверки;
		Иначе
			ПутьПоляАктаСверки = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляАктаСверки);
			ИмяОформляемогоЭлемента = ИмяТЧ + ИмяПоляАктаСверки;
		КонецЕсли;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Не требуется акт сверки (%1)'"), ИмяОформляемогоЭлемента);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляВалютнойСуммы);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляРублевойСуммы);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляАктаСверки);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяОформляемогоЭлемента);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_УбратьОтметкуНезаполненногоАктаСверкиПриОтсутствииПодтвержденнойЗадолженности(УсловноеОформление, ОбщиеПараметры, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
	// При отсутствии подтвержденной задолженности указание акта сверки является опциональным.
	
	ИмяПоляВалютнойСуммы = "СуммаПодтвержденнаяВал";
	ИмяПоляРублевойСуммы = "СуммаПодтвержденнаяРуб";
	
	Если ЭтоФормаРазбивкиСтроки Тогда
		ПутьПоляВалютнойСуммы = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляВалютнойСуммы);
		ПутьПоляРублевойСуммы = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляРублевойСуммы);
	Иначе
		ПутьПоляВалютнойСуммы = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляВалютнойСуммы);
		ПутьПоляРублевойСуммы = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляРублевойСуммы);
	КонецЕсли;
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаАктаСверки");
	ИменаПолей.Добавить("НомерАктаСверки");
	
	Для Каждого ИмяПоляАктаСверки Из ИменаПолей Цикл
		Если ЭтоФормаРазбивкиСтроки Тогда
			ПутьПоляАктаСверки = СтрШаблон("ТаблицаИсходнаяСтрока.%1", ИмяПоляАктаСверки);
			ИмяОформляемогоЭлемента = "ТаблицаИсходнаяСтрока" + ИмяПоляАктаСверки;
		Иначе
			ПутьПоляАктаСверки = СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляАктаСверки);
			ИмяОформляемогоЭлемента = ИмяТЧ + ИмяПоляАктаСверки;
		КонецЕсли;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='При отсутствии подтвержденной задолженности указание акта сверки является опциональным (%1)'"), ИмяОформляемогоЭлемента);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляВалютнойСуммы);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляРублевойСуммы);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоляАктаСверки);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяОформляемогоЭлемента);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НедоступностьФлажкаСуммаТребуетРеклассификацииПриНулевойСумме(УсловноеОформление, ИмяТЧ, ЭтоФормаРазбивкиСтроки = Ложь)
	
