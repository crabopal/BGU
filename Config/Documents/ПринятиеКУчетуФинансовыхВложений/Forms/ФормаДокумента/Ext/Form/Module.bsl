#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подобрать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстОшибки = НСтр("ru='Не выбрана организация!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Организация", Объект.Организация);
	ПараметрыОткрытия.Вставить("ИФО", Объект.ИФО);
	ПараметрыОткрытия.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыОткрытия.Вставить("Валюта", Объект.ВалютаДокумента);
	Если Параметры.Ключ.Пустая() И НачалоДня(Объект.Дата) = Объект.Дата Тогда
		ПараметрыОткрытия.Вставить("Дата", КонецДня(Объект.Дата));
	Иначе
		ПараметрыОткрытия.Вставить("Дата", Объект.Дата);
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ОткрытьФорму("Документ.ПринятиеКУчетуФинансовыхВложений.Форма.ПодборВложенийВФинансовыеАктивы",
		ПараметрыОткрытия, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

