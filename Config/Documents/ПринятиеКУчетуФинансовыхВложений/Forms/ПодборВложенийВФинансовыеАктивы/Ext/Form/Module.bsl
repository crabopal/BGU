#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Счета215 = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("215.00");
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	ОбъектыФинансовыхВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПланыВидовХарактеристик.ВидыСубконто.ОбъектыФинансовыхВложений);
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоПодразделениямНаСчетах215 = УчетПоПодразделениям И БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(Счета215);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", Параметры.Дата);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Организация", Параметры.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИФО", Параметры.ИФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Подразделение", Параметры.Подразделение);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьУчетПоПодразделениям", УчетПоПодразделениямНаСчетах215);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Счета215", Счета215);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОбъектыФинансовыхВложений", ОбъектыФинансовыхВложений);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ВалютаОстатков", Параметры.Валюта);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Валюта", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьИнформационнуюНадпись();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ОповеститьОВыборе(АдресПодобранныхВХранилище(ЭтотОбъект.ВладелецФормы.УникальныйИдентификатор));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДобавитьВОтобранные();
	ОбновитьИнформационнуюНадпись();
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДобавитьВОтобранные();
	ОбновитьИнформационнуюНадпись();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаПодобранных

&НаКлиенте
Процедура ТаблицаПодобранныхПриИзменении(Элемент)
	ОбновитьИнформационнуюНадпись();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПодобранныхПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ДобавитьВОтобранные();
	ОбновитьИнформационнуюНадпись();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПодобранныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьВОтобранные()
	
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		
		// проверка того, что финансовое вложение уже было выбрано
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектФинансовыхВложений", ТекущиеДанные.ОбъектФинансовыхВложений);
		ПараметрыОтбора.Вставить("КФО", ТекущиеДанные.КФО);
		ПараметрыОтбора.Вставить("КПС", ТекущиеДанные.КПС);
		
		Строки = ТаблицаПодобранных.НайтиСтроки(ПараметрыОтбора);
		Если Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТаблицаПодобранных.Добавить(), ТекущиеДанные);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформационнуюНадпись()
	
	Сумма = Формат(ТаблицаПодобранных.Итог("Сумма"), "ЧЦ=15; ЧДЦ=2; ЧН=");
	Количество = НРег(ЧислоПрописью(ТаблицаПодобранных.Количество(), "Л = ru_RU; ДП = Ложь; НП = Истина; НД = Ложь;",
		НСтр("ru = 'финансовое вложение, финансовых вложения, финансовых вложений,с,,,,,0'")));
	
	ИнформационнаяНадпись = НСтр("ru = 'Всего подобрано [Количество] на сумму [Сумма] руб.'");
	
	ВставляемыеЗначения = Новый Структура;
	ВставляемыеЗначения.Вставить("Количество",Количество);
	ВставляемыеЗначения.Вставить("Сумма",Сумма);
	
	ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ИнформационнаяНадпись, ВставляемыеЗначения);
	
КонецПроцедуры

&НаСервере
Функция АдресПодобранныхВХранилище(УникальныйИдентификаторВладельца)
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПодобранных.Выгрузить(), УникальныйИдентификаторВладельца);
	
КонецФункции

#КонецОбласти
