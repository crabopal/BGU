	|	СписаниеОбъектовИКДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.МассаДМ КАК ЧистаяМасса,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.ЛигатурнаяМассаЛома КАК ЛигатурнаяМасса,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	СписаниеОбъектовИКДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	|ИЗ
	|	Документ.СписаниеОбъектовИК.ДрагоценныеМатериалы КАК СписаниеОбъектовИКДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = СписаниеОбъектовИКДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	СписаниеОбъектовИКДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И СписаниеОбъектовИКДрагоценныеМатериалы.МассаДМ > 0
	|	И НЕ СписаниеОбъектовИКДрагоценныеМатериалы.Ссылка.НоменклатураЛома = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И (СписаниеОбъектовИКДрагоценныеМатериалы.ОбъектНФА, СписаниеОбъектовИКДрагоценныеМатериалы.ИнвНомер) В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство,
	|				ВТ.ИнвентарныйНомер
	|			ИЗ
	|				ТаблицаОсновныеСредства КАК ВТ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписаниеОбъектовИКДрагоценныеМатериалы.НомерСтроки";
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаПолучениемДоговора(ТекстЗапроса)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойКонтрагент_ПодЗамену", 
	"ВЫБОР
	|		КОГДА СтоимостьОбъектовОСОстатки.Договор <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|			ТОГДА СтоимостьОбъектовОСОстатки.Договор.Контрагент
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойДоговор_ПодЗамену", "СтоимостьОбъектовОСОстатки.Договор");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ГДЕ", "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|				&Период,
	|				(Организация, ОсновноеСредство)
	|					В (ВЫБРАТЬ ВТ.Ссылка.Организация, ВТ.ОсновноеСредство 
	|						ИЗ Документ.СписаниеОбъектовИК.ОсновныеСредства КАК ВТ 
	|						ГДЕ ВТ.Ссылка = &Ссылка)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = СтоимостьОбъектовОСОстатки.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = СтоимостьОбъектовОСОстатки.ИнвентарныйНомер
	|ГДЕ");
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаПолучениемКонтрагента(Запрос, НомераТаблиц, РеквизитыДокумента, ПараметрыСписания)
	
	Если РеквизитыДокумента.ДоговорВТабличнойЧасти Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойКонтрагент_ПодЗамену", 
		"ВЫБОР
		|		КОГДА НЕ ОстаткиПоКонтрагентам.Контрагент ЕСТЬ NULL
		|			ТОГДА ОстаткиПоКонтрагентам.Контрагент
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", 
		"ВЫБОР
		|		КОГДА НЕ ОстаткиПоКонтрагентам.Договор ЕСТЬ NULL
		|			ТОГДА ОстаткиПоКонтрагентам.Договор
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
		|				&Период,
		|				(Организация, ОсновноеСредство)
		|					В (ВЫБРАТЬ ВТ.Ссылка.Организация, ВТ.ОсновноеСредство 
		|					ИЗ Документ.СписаниеОбъектовИК.ОсновныеСредства КАК ВТ 
		|					ГДЕ ВТ.Ссылка = &Ссылка)
		|					И ВидРаспоряжения = &ВидРаспКонтр) КАК ОстаткиПоКонтрагентам
		|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ОстаткиПоКонтрагентам.ОсновноеСредство
		|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ОстаткиПоКонтрагентам.ИнвентарныйНомер
		|			И ТаблицаОсновныеСредства.Контрагент = ОстаткиПоКонтрагентам.Контрагент
		|			И ТаблицаОсновныеСредства.Договор = ОстаткиПоКонтрагентам.Договор
		|ГДЕ");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойКонтрагент_ПодЗамену", "ОстаткиПоКонтрагентам.Контрагент");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", "ОстаткиПоКонтрагентам.Договор");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
		|				&Период,
		|				(Организация, ОсновноеСредство)
		|					В (ВЫБРАТЬ ВТ.Ссылка.Организация, ВТ.ОсновноеСредство 
		|					ИЗ Документ.СписаниеОбъектовИК.ОсновныеСредства КАК ВТ 
		|					ГДЕ ВТ.Ссылка = &Ссылка)
		|					И ВидРаспоряжения = &ВидРаспКонтр) КАК ОстаткиПоКонтрагентам
		|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ОстаткиПоКонтрагентам.ОсновноеСредство
		|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ОстаткиПоКонтрагентам.ИнвентарныйНомер
		|ГДЕ");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Период", РеквизитыДокумента.МоментВремени);
	Запрос.УстановитьПараметр("ВидРаспКонтр", ПараметрыСписания.ВидРаспоряженияУКонтрагента);
	
КонецПроцедуры

#КонецОбласти

