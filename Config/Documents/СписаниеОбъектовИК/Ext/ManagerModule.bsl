// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиИнвКарточек(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СписаниеОбъектовИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
КонецФункции

#КонецОбласти

Функция ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента)
	Запрос = Новый Запрос;
	ВидыОпераций = УправлениеОсновнымиСредствамиКлиентСервер.СписокВидовОперацииДокумента(
		Тип("ДокументСсылка.СписаниеОбъектовИК")).ВыгрузитьЗначения();
	ВидыИмущества = Новый Массив;
	ВидыИмущества.Добавить(Перечисления.ВидыИмущества.Казна);
	ВидыИмущества.Добавить(Перечисления.ВидыИмущества.ВКонцессии);

	КодыСчетовГруппСтрокой = "";
	Для каждого ТекОперация из ВидыОпераций Цикл
		Для каждого ТекИмущество из ВидыИмущества Цикл
			КодыСчетовГруппСтрокой = КодыСчетовГруппСтрокой + ?(ЗначениеЗаполнено(КодыСчетовГруппСтрокой), ",", "") 
			+ КодыСчетовУчетаОСПоВидуОперацииИИмущества(ТекОперация, ТекИмущество);
		КонецЦикла;	
	КонецЦикла;	
	
	КодыСчетовГрупп = СтрРазделить(КодыСчетовГруппСтрокой, ",", Ложь);
	
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаГруппы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В (&КодыСчетовГрупп)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ ДанныеИнвентаризации.Счет.Забалансовый
	|			ТОГДА ВЫБОР
	|				КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 5, 1) = ""5""
	|					ТОГДА &ИК
	|				ИНАЧЕ &ИКвКонцессии
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""01""
	|				ТОГДА &ИКвПользовании
	|			ИНАЧЕ &ИКнаХранении
	|		КОНЕЦ
	|	КОНЕЦ КАК ВидУчета,
	|	ДанныеИнвентаризации.ЦМОРаздела4 КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение,
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	ДанныеИнвентаризации.КФО КАК КФО
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 6
	|	И ДанныеИнвентаризации.Счет В ИЕРАРХИИ
	|		(ВЫБРАТЬ
	|			СчетаГруппы.Ссылка
	|		ИЗ
	|			СчетаГруппы)
	|	И (ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|	ИЛИ ДанныеИнвентаризации.СуммаНедостачаНеПодтверждено <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА НЕ ДанныеИнвентаризации.Счет.Забалансовый
	|			ТОГДА ВЫБОР
	|				КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 5, 1) = ""5""
	|					ТОГДА &ИК
	|				ИНАЧЕ &ИКвКонцессии
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""01""
	|				ТОГДА &ИКвПользовании
	|			ИНАЧЕ &ИКнаХранении
	|		КОНЕЦ
	|	КОНЕЦ,
	|	ДанныеИнвентаризации.ЦМОРаздела4,
	|	ДанныеИнвентаризации.Подразделение,
	|	ДанныеИнвентаризации.ИФО,
	|	ДанныеИнвентаризации.КФО";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("КодыСчетовГрупп", КодыСчетовГрупп);
	Запрос.УстановитьПараметр("ИК", ПредставлениеВидаУчетаПоИмениПараметра("ИК"));
	Запрос.УстановитьПараметр("ИКвКонцессии", ПредставлениеВидаУчетаПоИмениПараметра("ИКвКонцессии"));
	Запрос.УстановитьПараметр("ИКвПользовании", ПредставлениеВидаУчетаПоИмениПараметра("ИКвПользовании"));
	Запрос.УстановитьПараметр("ИКнаХранении", ПредставлениеВидаУчетаПоИмениПараметра("ИКнаХранении"));
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить();
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ВидУчета", "Вид учета"));
	
	Возврат(СтруктураРазделителей);
КонецФункции	

Функция ТаблицаРазделителейДокументов_РешениеОПрекращенииПризнанияАктивомИК(ДокументОснование, СсылкаЦелевогоДокумента)
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧОсновныеСредства.КФО КАК КФО
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомИК.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|	И НЕ ТЧОсновныеСредства.ОсновноеСредство.ТипНФА = &ТипНФА";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("ТипНФА", Перечисления.ТипыНФА.Транспорт);
	
	Возврат Запрос.Выполнить().Выгрузить();
