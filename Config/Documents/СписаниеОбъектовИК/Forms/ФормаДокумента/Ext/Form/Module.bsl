#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	Если РешениеСотрудникаМодифицированность
		И ЗначениеЗаполнено(ВыбранныйСотрудник)
		И ВыбранныйСотрудник <> Сотрудник Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Сотрудник", ВыбранныйСотрудник);
		ДопПараметры.Вставить("РезультатыГолосования", Новый Массив);
		Для Каждого СтрокаОС Из Объект.ОсновныеСредства Цикл
			Если ЗначениеЗаполнено(СтрокаОС.РешениеСотрудникаПоРезолюции) Тогда
				РезультатГолосования = Новый Структура("ИдентификаторСтроки,РешениеСотрудникаПоРезолюции",
					СтрокаОС.ИдентификаторСтроки, СтрокаОС.РешениеСотрудникаПоРезолюции);
				ДопПараметры.РезультатыГолосования.Добавить(РезультатГолосования);
			КонецЕсли;
		КонецЦикла;
		
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), ВыбранныйСотрудник);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	СотрудникПриИзмененииНаСервере();
	
	ВыбранныйСотрудник = Сотрудник;
	
	РешениеСотрудникаМодифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОтборПрисутствующих = Новый Структура("Отсутствует", Ложь);
	ПрисутствующиеЧленыКомиссии = Объект.СоставКомиссии.НайтиСтроки(ОтборПрисутствующих);
	
	// Выбирается из присутствующих членов комиссии.
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.Добавить(Объект.Председатель);
	Для Каждого ЧленКомиссии Из ПрисутствующиеЧленыКомиссии Цикл
		Элемент.СписокВыбора.Добавить(ЧленКомиссии.Сотрудник);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	Для Каждого НоваяСтрока Из ДобавленныеСтроки Цикл
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		Если НЕ НоваяСтрока.ОтразитьВКарточкеКапвложений Тогда
			НоваяСтрока.ОтразитьВКарточкеКапвложений = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
	//РассчитатьСуммыНаСервере();
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Организация",,Отказ);
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ВидИмущества) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид имущества'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ВидИмущества",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки, РассчитыватьСуммы = Истина)

	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	НоваяСтрока = ТаблицаОС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	ЗаполнитьСтрокуТЧ(ТекущиеДанные, ТабОстатков);
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ОсновноеСредствоПриИзмененииНаСервере(Элементы.ОсновныеСредства.ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРешениеСотрудникаПоРезолюцииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСтоимостьЕдиницыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы;
	Иначе	
		ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекущиеДанные.Количество;
	КонецЕсли;	
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		//ТекущиеДанные.СтоимостьЕдиницы = 0;
		ТекущиеДанные.СтоимостьЕдиницы = ТекущиеДанные.Сумма;
	Иначе
		ТекущиеДанные.СтоимостьЕдиницы = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(ТекущиеДанные);
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекущиеДанные.Количество;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	ОбъектНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ("+
						СокрЛП(ОбъектНаУдаление)+") на закладке ""Драгоценные материалы""?'"), Режим, 0);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК") 
			И НЕ ТекущиеДанные.ОтразитьВКарточкеКапвложений Тогда
			ТекущиеДанные.ОтразитьВКарточкеКапвложений = Истина;
		КонецЕсли;	

		//Если Не Копирование Тогда
		//	ТекущиеДанные.Количество = 1;
		//	ПересчитатьСуммыТекущейСтроки(ТекущиеДанные);
		//	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные);
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетУчетаОСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
		ТекущиеДанные.УчетПоКПС = Ложь;
	Иначе
		ТекущиеДанные.УчетПоКПС = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетУчета).УчетПоКПС;
	КонецЕсли;
	
КонецПроцедуры

