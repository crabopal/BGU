&НаСервереБезКонтекста
Функция НаименованиеПричиныСписания(ПричинаСсылка)
	Возврат Справочники.ПричиныСписанияНФА.НаименованиеПричиныСписания(ПричинаСсылка);
КонецФункции	

&НаКлиенте
Процедура ПриИзмененииВидаОперации()
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКнаХранении")
		И Объект.ВосстановитьНаБалансе Тогда
			
		// Реквизит "ВосстановитьНаБалансе" стал невидимым и если он включен, его нужно выключить. От этого
		// зависит выбор типовой бухгалтерской операции
		Объект.ВосстановитьНаБалансе = Ложь;
		ПриИзмененииВосстановитьНаБалансе();
	КонецЕсли;	

	Если НЕ ЭтоВО_Списание01_02(Объект.ВидОперации) И Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Ложь;
	ИначеЕсли ЭтоВО_Списание01_02(Объект.ВидОперации) И НЕ Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Истина;
	КонецЕсли;	
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКНаБалансе")
		И Объект.ВидИмущества <> ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			
		// Реквизит "ВидИмущества" можно выбирать только при виде списания "Списание ИК на балансе (108)".
		// Для других видов списания вид имущества должен быть только "Казна", т.к. на заб. счетах 01 и 02 не может 
		// быть имущества в концессии
		Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна");
		ПриИзмененииВидИмущества();
	КонецЕсли;	

	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьОтборСчетаУчетаОС();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ОтключитьУчетВКарточкахКапвложений();
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииВосстановитьНаБалансе()
	УстановитьОтборСчетаУчетаОС();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВидИмущества()
	УстановитьОтборСчетаУчетаОС();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора_ОчисткаТабЧастей_Завершение(Результат, ДопПараметры) Экспорт
	Если ДопПараметры.Параметры.ИмяРеквизита = "ИФО" Тогда
		ИФОПриИзменении(ДопПараметры.Элемент);
	ИначеЕсли ДопПараметры.Параметры.ИмяРеквизита = "Организация" Тогда
		ОрганизацияПриИзменении(ДопПараметры.Элемент);
	ИначеЕсли ДопПараметры.Параметры.ИмяРеквизита = "ВидОперации" Тогда
		ПриИзмененииВидаОперации();
	КонецЕсли;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе) Экспорт
	Возврат Документы.СписаниеОбъектовИК.КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе);
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеОСвТЧ(РассчитыватьСуммы = Истина)
	Для каждого СтрокаТЧ Из Объект.ОсновныеСредства Цикл
		ОсновноеСредствоПриИзмененииНаСервере(СтрокаТЧ.ПолучитьИдентификатор(), РассчитыватьСуммы);
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура РешениеПриИзменении_Завершение(Результат, Параметры) Экспорт                     
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	

	ЗаполнитьПоОснованию(Объект.Решение, Результат, СсылкаЦелевогоДокумента);
	Если ТипЗнч(Объект.Решение) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ПриИзмененииВидаОперации();
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоОснованию(ДокументОснования, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.СписаниеОбъектовИК"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокументОснования, Разделитель, Истина, СсылкаЦелевогоДокумента);
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	ЗаполнитьДанныеОСвТЧ(Ложь);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьДокументаОснование(Форма)
	Форма.Элементы.ДокументОснование.Видимость = ЗначениеЗаполнено(Форма.Объект.ДокументОснование);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЕстьРешениеОПрекращенииПризнанияАктивом(Форма)
	Объект = Форма.Объект;
	ЕстьРешение = ЗначениеЗаполнено(Объект.Решение) 
		И (ТипЗнч(Объект.Решение) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом")
		ИЛИ ТипЗнч(Объект.Решение) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК"));
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом <> ЕстьРешение Тогда
		 Объект.ЕстьРешениеОПрекращенииПризнанияАктивом = ЕстьРешение;
	КонецЕсли;		
КонецПроцедуры	

&НаКлиенте
Процедура ОтключитьУчетВКарточкахКапвложений()
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК") Тогда
		
		Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
			Если СтрокаТЧ.ОтразитьВКарточкеКапвложений Тогда
				СтрокаТЧ.ОтразитьВКарточкеКапвложений = Ложь;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВО_Списание01_02(ВО)
	Возврат(ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКПолученноеВПользование")
		ИЛИ ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКнаХранении"));
КонецФункции	

