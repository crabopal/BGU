&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	
	ЭтоСписаниеКапвложенийИК = 	
		     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК"); 
	ВедетсяУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений()
		ИЛИ (ЭтоСписаниеКапвложенийИК И Объект.ДрагоценныеМатериалы.Количество() > 0);

	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ(); 
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ЦМО");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	ВидОперации = Объект.ВидОперации;
	
	ВО_СписаниеИКНаБалансе = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКНаБалансе");
	ВО_СписаниеИКнаХранении = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКнаХранении");
	ВО_СписаниеИКПолученноеВПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКПолученноеВПользование");
	ВО_СписаниеКапвложенийВИК = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК");
	ВО_СписаниеИКнаХранении = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКнаХранении");
	ВО_СписаниеИКПолученноеВПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКПолученноеВПользование");
	
	ЭтоСписаниеВложенийВИК = (ВидОперации = ВО_СписаниеКапвложенийВИК);
	ЭлементыИнвентарногоУчета = Новый Массив;
	ЭлементыИнвентарногоУчета.Добавить("ОсновныеСредстваИнвентарныйНомер");
	ЭлементыИнвентарногоУчета.Добавить("ВосстановлениеОСИнвентарныйНомер");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнвентарногоУчета, "Доступность", 
		Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны И НЕ ЭтоСписаниеВложенийВИК);
		
	ЭтоСписаниеИКНаБалансе = (ВидОперации = ВО_СписаниеИКНаБалансе);
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваГруппаСуммаАмортизации");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
	ЭлементыАмортизации.Добавить("ГруппаПолучатель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ЭтоСписаниеИКНаБалансе);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваСуммаАмортизацииЗаТекущийМесяц", "Видимость", 
		ЭтоСписаниеИКНаБалансе И НЕ Форма.ОтразитьВМежотчетномПериоде);

	ЭтоСписаниеИКнаХранении = (ВидОперации = ВО_СписаниеИКнаХранении);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВосстановитьНаБалансе", "Видимость", ЭтоСписаниеИКнаХранении);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаВосстановлениеОС", "Видимость", ЭтоСписаниеИКнаХранении И Объект.ВосстановитьНаБалансе);
	
	ВидимостьЭлементовКарточки = 
		(ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК"));
	ЭлементыКарточкаКапвложений = Новый Массив;
	ЭлементыКарточкаКапвложений.Добавить("ОсновныеСредстваГруппаКарточкаКапвложений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыКарточкаКапвложений, "Видимость", ВидимостьЭлементовКарточки);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВидИмущества", "Доступность", ЭтоСписаниеИКНаБалансе);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКомандаРассчитатьСтоимостьОС", "Доступность", ЭтоСписаниеИКНаБалансе ИЛИ ЭтоСписаниеВложенийВИК);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоговорВТабличнойЧасти", "Видимость", ЭтоВО_Списание01_02(Объект.ВидОперации));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКонтрагентДоговор", "Видимость", Объект.ДоговорВТабличнойЧасти);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаМЦ", "Видимость", ЭтоСписаниеВложенийВИК И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыИнвНомер", "Видимость", НЕ (ЭтоСписаниеВложенийВИК И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений));
	
КонецПроцедуры
	
&НаКлиенте
Процедура УстановитьОтборСчетаУчетаОС()
	КодыСчетов = КодыСчетовУчетаОСПоВидуОперацииИИмущества(Объект.ВидОперации, Объект.ВидИмущества, Объект.ВосстановитьНаБалансе);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыФормы()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Получить(СтрокаТаблицы.ОсновноеСредство);
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС, "ГрупповойУчет,ВидНФА");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			СтрокаТаблицы.УчетПоКПС = Ложь;
		Иначе
			СтрокаТаблицы.УчетПоКПС = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета).УчетПоКПС;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомиссии()
	
	ЕстьКомиссия = ЗначениеЗаполнено(Объект.Комиссия);
	
	Элементы.ГруппаИндикаторКворумаПрисутствия.Видимость = ЕстьКомиссия;
	Элементы.ГруппаПриказОНазначенииКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	//Элементы.ГруппаПредседательКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.Председатель.Видимость = ЕстьКомиссия;
	Элементы.ВыбратьПредседателяКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии1.Видимость = ЕстьКомиссия;
	Элементы.ЗаключениеКомиссии.Видимость = Не ЕстьКомиссия;
	
КонецПроцедуры

