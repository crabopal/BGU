// Основные средства

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Истина)

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, СообщатьОбОшибках);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.Подразделение.ОтметкаНезаполненного Тогда
			
			СтруктураРеквизитов.Вставить("Подразделение");
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКНаБалансе") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК") Тогда
		ВидРаспоряжения = "Вложения";
	ИначеЕсли Объект.ВидОперации 
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКнаХранении") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении");
	ИначеЕсли Объект.ВидОперации 
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.СписаниеИКПолученноеВПользование") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПолученоВПользование");
	Иначе
		ВидРаспоряжения = Неопределено;
	КонецЕсли;	
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", ВидРаспоряжения);
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, КодыСчетов);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	Если ЗначениеЗаполнено(Объект.ЦМО) Тогда
		ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМО);
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
	ПараметрыПодбора.Вставить("ДоговорВТабличнойЧасти", Объект.ДоговорВТабличнойЧасти);
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура РассчитатьСуммуАмортизацииЗаТекущийМесяц(ТекущиеДанные = Неопределено)
	
	Если Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата).НачислятьАмортизациюПервымЧислом Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		СписокОС = Новый Массив;
		СписокОС.Добавить(ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;

	ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(СписокОС, Объект, Ложь, Ложь, Истина);
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		Если ТекущиеДанные <> Неопределено И СтрокаТаблицы <> ТекущиеДанные Тогда
			Продолжить;
		КонецЕсли;
		СтрокаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаАмортизации = Неопределено Тогда
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = 0;
		Иначе			
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = СтрокаАмортизации.СуммаАмортизацииБУ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()

	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
		
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);
	
	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ЭтоСписаниеКапвложенийИК = 
		     Объект.ВидОперации = Перечисления.ВидыОперацийИК.СписаниеКапвложенийВИК;
			 
	Если НЕ (ВедетсяУчетДрагМатериаловВМЦКапвложений И ЭтоСписаниеКапвложенийИК) Тогда
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияОС(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков, Истина);
 	Иначе
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	КонецЕсли;
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОсновноеСредство);
		Если НЕ ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
			ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвентарныйНомер);
		КонецЕсли;
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);		
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ?(ЭтоСписаниеКапвложенийИК, ТекСтрока.Количество, ТекСтрокаМассива.КоличествоВсего); 
				Прервать;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	ТЧ = Объект.ОсновныеСредства.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.ОсновноеСредство,
			|	ТаблицаОбъектовНФА.ИнвентарныйНомер,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.ОсновноеСредство КАК ОбъектНФА,
			|	СписокНФАСписания.ИнвентарныйНомер КАК ИнвНомер,
			|	СписокНФАСписания.Количество
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания";
			
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТЧ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	Если НЕ ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда 
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	Иначе
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер); 
		КонецЕсли;
	КонецЦикла;	
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.МатериальнаяЦенностьЗаголовок = НСтр("ru = 'Материальная ценность:'");
	ТекущаяСтрока.КоличествоМЦЗаголовок 		= НСтр("ru = 'Количество:'"); 
	
	ЕдиницаИзм = ПолучитьЕдиницуИзмеренияМатериальнойЦенности(ТекущаяСтрока.ОбъектМЦ);
	
	ТекущаяСтрока.ЕдиницаИзмерения = ЕдиницаИзм;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЕдиницуИзмеренияМатериальнойЦенности(Знач ОбъектМЦ)
	
	Если ТипЗнч(ОбъектМЦ) = Тип("СправочникСсылка.ОсновныеСредства") ИЛИ Не ЗначениеЗаполнено(ОбъектМЦ) Тогда 
		ЕдиницаИзм = УчетДрагМатериалов.Штуки();
	Иначе
		Если ЗначениеЗаполнено(ОбъектМЦ.ЕдиницаИзмерения) Тогда
			ЕдиницаИзм = ОбъектМЦ.ЕдиницаИзмерения; 
		Иначе
			ЕдиницаИзм = УчетДрагМатериалов.Штуки(); 
		КонецЕсли;
	КонецЕсли;
	Возврат ЕдиницаИзм;

КонецФункции 

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ()
	
	Если НЕ (Объект.ВидОперации = Перечисления.ВидыОперацийИК.СписаниеКапвложенийВИК
					И ВедетсяУчетДрагМатериаловВМЦКапвложений) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ДрагоценныеМатериалы Цикл
	
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

