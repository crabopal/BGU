&НаКлиенте
Процедура ВосстановитьНаБалансеПриИзменении(Элемент)
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена. Продолжить?'");   
		Оповещение = Новый ОписаниеОповещения("ВосстановитьНаБалансеПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 10);
		Возврат;
	КонецЕсли;	
	
	ПриИзмененииВосстановитьНаБалансе();
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНаБалансеПриИзмененииЗавершение(Результат, Параметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Объект.ВосстановитьНаБалансе = НЕ Объект.ВосстановитьНаБалансе;
		Возврат;
	КонецЕсли;	
	
	Объект.ОсновныеСредства.Очистить();
	ПриИзмененииВосстановитьНаБалансе();
КонецПроцедуры	

