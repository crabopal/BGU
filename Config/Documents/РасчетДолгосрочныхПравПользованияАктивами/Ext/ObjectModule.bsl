#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
		
		Если СтрокаТаблицы.Долгосрочные < 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'в т.ч. долгосрочные'"),
				СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования ОС, НПА'"),
				НСтр("ru = 'Указана отрицательная сумма долгосрочных прав пользования ОС, НПА.'"));
			ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Долгосрочные";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		ИначеЕсли СтрокаТаблицы.Долгосрочные > 0 И СтрокаТаблицы.Долгосрочные > СтрокаТаблицы.ОстаточнаяСтоимость Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'в т.ч. долгосрочные'"),
				СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования ОС, НПА'"),
				НСтр("ru = 'Указана сумма долгосрочных прав пользования ОС, НПА, превышающая остаточную стоимость.'"));
			ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Долгосрочные";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ПраваПользованияНМА Цикл
		
		Если СтрокаТаблицы.Долгосрочные < 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'в т.ч. долгосрочные'"),
				СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования НМА'"),
				НСтр("ru = 'Указана отрицательная сумма долгосрочных прав пользования НМА.'"));
			ПолеОшибки = "ПраваПользованияНМА[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Долгосрочные";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		ИначеЕсли СтрокаТаблицы.Долгосрочные > 0 И СтрокаТаблицы.Долгосрочные > СтрокаТаблицы.ОстаточнаяСтоимость Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'в т.ч. долгосрочные'"),
				СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования НМА'"),
				НСтр("ru = 'Указана сумма долгосрочных прав пользования НМА, превышающая остаточную стоимость.'"));
			ПолеОшибки = "ПраваПользованияНМА[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Долгосрочные";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
