#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.СведенияОДенежномОбязательстве", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаНаСервере()
	
	Перем ДопустимыеИсточникиСредств;
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет);
	
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	Если ДопустимыеИсточникиСредств.Найти(Объект.ИсточникСредств) = Неопределено Тогда
		Объект.ИсточникСредств = "";
		Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
			Объект.ИсточникСредств = ДопустимыеИсточникиСредств[0];
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
   	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецФункции

&НаСервере
Процедура ПодтверждающийДокументПриИзмененииНаСервере()
	
	Документы.СведенияОДенежномОбязательстве.ЗаполнитьПоПодтверждающемуДокументу(Объект.ПодтверждающийДокумент, Объект);
	
	ПриИзмененииЛицевогоСчетаНаСервере();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитов()
	
	Если Объект.РасшифровкаОбязательства.Количество() > 0 Тогда 
		ИнформацияОЗагрузкеДанных = НСтр("ru = 'Документ сформирован по данным, загруженным из ЕИС в сфере закупок'");
		Элементы.ИнформацияОЗагрузкеДанных.Видимость = Истина;
		Элементы.ГруппаДатаНомерЕИС.Видимость = Истина;
		Элементы.ГруппаРеквизитыДокумента.Видимость = Ложь;
		Элементы.ГруппаРеквизитыЕИС.Видимость = Истина;
		Элементы.ПодтверждающийДокумент.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ИнформацияОЗагрузкеДанных.Видимость = Ложь;
		Элементы.ГруппаДатаНомерЕИС.Видимость = Ложь;
		Элементы.ГруппаРеквизитыДокумента.Видимость = Истина;
		Элементы.ГруппаРеквизитыЕИС.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти
	
// ИнтеграцияС1САрхивом
