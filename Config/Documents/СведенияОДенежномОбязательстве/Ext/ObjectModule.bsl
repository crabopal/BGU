#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АвансовыйОтчет")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявлениеНаВыдачуАванса")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтражениеЗарплатыВУчете")  
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеИК")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗВПути")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеОСВПути")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеОСИК")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеУслугРабот")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОбслуживаниеКредитовИЗаймов")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзвещениеИсходящее") 
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходныйОрдерФондовый") 
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктПриемкиТоваровРаботУслуг")  
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо")  
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОКомандировании") 
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица")  
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НачислениеИмущественныхНалогов")
		Тогда
		
		Документы.СведенияОДенежномОбязательстве.ЗаполнитьПоПодтверждающемуДокументу(ДанныеЗаполнения, ЭтотОбъект); 
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС") Тогда 
		
		Если НЕ ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда 
			ТекстОшибки = НСтр("ru='Формирование сведений возможно только для документа, созданного на основании ""Электронного документа поставщика"".'");
			ВызватьИсключение ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		Если ДанныеЗаполнения.Отбор.Количество() > 1 ИЛИ ДанныеЗаполнения.Отбор.Количество() = 0 Тогда
			ТекстОшибки = НСтр("ru='В документе %1 не указан договор, или указано более одного договора. Ввод на основании невозможен.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ДанныеЗаполнения);
			ВызватьИсключение ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		Документы.СведенияОДенежномОбязательстве.ЗаполнитьПоПодтверждающемуДокументу(ДанныеЗаполнения, ЭтотОбъект);  
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
