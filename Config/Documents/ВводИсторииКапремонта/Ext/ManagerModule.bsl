КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Капремонт.Дата КАК Период,
	|	Капремонт.Ссылка.ОсновноеСредство КАК ОС,
	|	Капремонт.Ссылка.ИнвентарныйНомер КАК ИнвНомер,
	|	Капремонт.Ссылка.Организация КАК Организация,
	|	Капремонт.Сумма КАК СуммаНаКапРемонт,
	|	Капремонт.НазваниеДокумента КАК НазваниеДокумента,
	|	Капремонт.НомерДокумента КАК НомерДокумента,
	|	Капремонт.НомерГТ КАК НомерГТ,
	|	Капремонт.ДатаГТ КАК ДатаГТ,
	|	Капремонт.СрокДействияГТ КАК СрокДействияГТ
	|ИЗ
	|	Документ.ВводИсторииКапремонта.Капремонт КАК Капремонт
	|ГДЕ
	|	Капремонт.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Модернизация.Дата КАК Период,
	|	Модернизация.Ссылка.Организация КАК Организация,
	|	Модернизация.Ссылка.ОсновноеСредство КАК ОсновноеСредство,
	|	Модернизация.Ссылка.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Модернизация.Сумма КАК Стоимость,
	|	Модернизация.НазваниеДокумента КАК НазваниеДокумента,
	|	Модернизация.НомерДокумента КАК НомерДокумента
	|ПОМЕСТИТЬ ВТ_Модернизация
	|ИЗ
	|	Документ.ВводИсторииКапремонта.Модернизация КАК Модернизация
	|ГДЕ
	|	Модернизация.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Модернизация.Период КАК Период,
	|	ВТ_Модернизация.Организация КАК Организация,
	|	ВТ_Модернизация.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Модернизация.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Модернизация.Стоимость КАК Стоимость,
	|	ВТ_Модернизация.НазваниеДокумента КАК НазваниеДокумента,
	|	ВТ_Модернизация.НомерДокумента КАК НомерДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(перечисление.ВидыСобытийОС.Реконструкция) КАК Событие
	|ИЗ
	|	ВТ_Модернизация КАК ВТ_Модернизация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Модернизация.Период,
	|	ВТ_Модернизация.Организация,
	|	ВТ_Модернизация.ОсновноеСредство,
	|	ВТ_Модернизация.ИнвентарныйНомер,
	|	ВТ_Модернизация.Стоимость,
	|	ВТ_Модернизация.НазваниеДокумента,
	|	ВТ_Модернизация.НомерДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе),
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ЗНАЧЕНИЕ(перечисление.ВидыСобытийОС.ПустаяСсылка)
	|ИЗ
	|	ВТ_Модернизация КАК ВТ_Модернизация";
		
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("КапРемонтОС");
	ТаблицыЗапроса.Добавить("ВТ_Модернизация");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

