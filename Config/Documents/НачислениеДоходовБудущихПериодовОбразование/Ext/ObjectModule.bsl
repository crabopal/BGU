#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КорректировкаДоходовБудущихПериодовОбразование") Тогда
		
		Запрос = Новый Запрос;
		НомераТаблиц = Новый Структура;
		НомераТаблиц.Вставить("РеквизитыШапки", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ДоходыБудущихПериодов", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ПорядокОплаты", НомераТаблиц.Количество());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеквизитыШапки.Ссылка КАК Ссылка,
		|	РеквизитыШапки.Организация КАК Организация,
		|	РеквизитыШапки.ИФО КАК ИФО,
		|	РеквизитыШапки.Студент КАК Студент,
		|	РеквизитыШапки.Контрагент КАК Контрагент,
		|	РеквизитыШапки.Договор КАК Договор,
		|	РеквизитыШапки.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
		|	РеквизитыШапки.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	РеквизитыШапки.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	РеквизитыШапки.СчетДоходов КАК СчетДоходов,
		|	РеквизитыШапки.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	РеквизитыШапки.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	РеквизитыШапки.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	РеквизитыШапки.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	РеквизитыШапки.СчетДоходовНУ КАК СчетДоходовНУ,
		|	РеквизитыШапки.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	РеквизитыШапки.ВидДеятельностиУСН КАК ВидДеятельностиУСН
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование КАК РеквизитыШапки
		|ГДЕ
		|	РеквизитыШапки.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоходыБудущихПериодов.Ссылка КАК Ссылка,
		|	ДоходыБудущихПериодов.НомерСтроки КАК НомерСтроки,
		|	ДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
		|	ДоходыБудущихПериодов.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
		|	ДоходыБудущихПериодов.СчетДБП КАК СчетДБП,
		|	ДоходыБудущихПериодов.КФО КАК КФО,
		|	ДоходыБудущихПериодов.КПС КАК КПС,
		|	ДоходыБудущихПериодов.КЭК КАК КЭК,
		|	ДоходыБудущихПериодов.Подразделение КАК Подразделение,
		|	ДоходыБудущихПериодов.ОстатокДБП КАК ОстатокДБП,
		|	ДоходыБудущихПериодов.Всего КАК Всего,
		|	ДоходыБудущихПериодов.СчетРасчетов КАК СчетРасчетов,
		|	ДоходыБудущихПериодов.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	ДоходыБудущихПериодов.ДопКлассификация КАК ДопКлассификация,
		|	ДоходыБудущихПериодов.КодМероприятия КАК КодМероприятия,
		|	ДоходыБудущихПериодов.КодЦели КАК КодЦели
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ДоходыБудущихПериодов КАК ДоходыБудущихПериодов
		|ГДЕ
		|	ДоходыБудущихПериодов.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПорядокОплаты.Ссылка КАК Ссылка,
		|	ПорядокОплаты.НомерСтроки КАК НомерСтроки,
		|	ПорядокОплаты.СуммаВВалюте КАК СуммаВВалюте,
		|	ПорядокОплаты.СуммаВВалютеДоИзменений КАК СуммаВВалютеДоИзменений,
		|	ПорядокОплаты.СуммаВВалютеПослеИзменений КАК СуммаВВалютеПослеИзменений,
		|	ПорядокОплаты.ОплатитьДо КАК ОплатитьДо,
		|	ПорядокОплаты.НачалоПериода КАК НачалоПериода,
		|	ПорядокОплаты.КонецПериода КАК КонецПериода,
		|	ПорядокОплаты.Примечание КАК Примечание,
		|	ПорядокОплаты.Факультет КАК Факультет,
		|	ПорядокОплаты.Валюта КАК Валюта
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ПорядокОплаты КАК ПорядокОплаты
		|ГДЕ
		|	ПорядокОплаты.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
		
		Результат = Запрос.ВыполнитьПакет();
		
		РеквизитыШапки = Результат[НомераТаблиц.РеквизитыШапки].Выгрузить();
		ОснованиеДоходыБудущихПериодов = Результат[НомераТаблиц.ДоходыБудущихПериодов].Выгрузить();
		ОснованиеПорядокОплаты = Результат[НомераТаблиц.ПорядокОплаты].Выгрузить();
		
		ДанныеОснования = РеквизитыШапки[0];
		Если Не ЗначениеЗаполнено(ДанныеОснования.Студент) Тогда
			ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='В документе %1 не заполнен реквизит ""Учащийся"". Заполнение невозможно.'"),
					ДанныеЗаполнения);
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		Если РеквизитыШапки.Количество() > 0
			И ОснованиеДоходыБудущихПериодов.Количество() > 0 Тогда
			
			ДатаСведений = Неопределено; // Сведения из регистров получаем без ограничения по дате.
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеОснования, "Организация,ИФО");
			
			// Факультет, СчетДБП и аналитику заполняем из первой строки основания.
			СтрокаДБП = ОснованиеДоходыБудущихПериодов[0];
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтрокаДБП,
				"СчетДБП,КФО,КПС,КЭК,Номенклатура,Подразделение,
				|ДопКлассификация,КодМероприятия,КодЦели");
			
			ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			СуммаВключаетНДС = Истина; // Остаток на счете 401.40 включает сумму НДС.
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПлательщикиПоДоговоруОбразование.Контрагент КАК Контрагент,
			|	ПлательщикиПоДоговоруОбразование.Договор КАК ДоговорКонтрагента
			|ИЗ
			|	РегистрСведений.ПлательщикиПоДоговоруОбразование КАК ПлательщикиПоДоговоруОбразование
			|ГДЕ
			|	ПлательщикиПоДоговоруОбразование.Студент = &Студент
			|	И ПлательщикиПоДоговоруОбразование.Договор = &Договор";
			Запрос.УстановитьПараметр("Студент", ДанныеОснования.Студент);
			Запрос.УстановитьПараметр("Договор", ДанныеОснования.Договор);
			
			НачислениеЗаПрочиеУслуги = Запрос.Выполнить().Пустой(); // Определяем по наличию хотя бы одной записи в регистре.
			
			Если НачислениеЗаПрочиеУслуги Тогда
				
				// Попробуем найти начисление по указанному договору.
				СведенияОПрочихУслугахСтуденту = РаботаСоСтудентами.СведенияОПрочихУслугахСтуденту(
					ДанныеОснования.Студент, ДанныеОснования.Контрагент, ДанныеОснования.Договор, ДатаСведений, Подразделение);
				Если СведенияОПрочихУслугахСтуденту.Количество() = 1 Тогда
					НачислениеЗаУслугу = СведенияОПрочихУслугахСтуденту[0].НачислениеСтудентамЗаПрочиеУслуги;
				КонецЕсли;
				
			КонецЕсли;
			
			// Начисления.
			СтрокаНачисления = Начисления.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНачисления, ДанныеОснования,
				"Студент,Контрагент,Договор");
			ЗаполнитьЗначенияСвойств(СтрокаНачисления, СтрокаДБП,
				"СчетРасчетов,ДопСубконтоРасчетов");
			
			СтрокаНачисления.Количество = 1;
			СтрокаНачисления.ЕдиницаИзмерения = СтрокаДБП.НоменклатураЕдиницаИзмерения;
			
			// Порядок учета доходов.
			Если Не ЗначениеЗаполнено(ДанныеОснования.СпособПризнанияДоходов) Тогда
				Отбор = Новый Структура("Договор,Организация", ДанныеОснования.Договор, ДанныеОснования.Организация);
				ПорядокУчетаДоходов = РегистрыСведений.ПараметрыСписанияДоходовБудущихПериодов.ПолучитьПоследнее(, Отбор);
			Иначе
				ПорядокУчетаДоходов = ДанныеОснования;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПорядокУчетаДоходов,
				"СпособПризнанияДоходов,ДатаНачалаСписания,ДатаОкончанияСписания,
				|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,
				|ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ");
			ВидДеятельностиУСН = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
			
			// Порядок оплаты.
			Для Каждого СтрокаПорядокОплаты Из ОснованиеПорядокОплаты Цикл
				
				Если СтрокаПорядокОплаты.СуммаВВалюте = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ПорядокОплаты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПорядокОплаты,
					"ОплатитьДо,НачалоПериода,КонецПериода,Примечание");
				НоваяСтрока.СуммаПроцент = (-1) * СтрокаПорядокОплаты.СуммаВВалюте;
				
				СтрокаНачисления.Всего = СтрокаНачисления.Всего + НоваяСтрока.СуммаПроцент;
				
			КонецЦикла;
			
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
			ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаНачисления, "Всего", ПараметрыРасчета);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
	 ИЛИ СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		
		Если ЗначениеЗаполнено(ДатаНачалаСписания) И ЗначениеЗаполнено(ДатаОкончанияСписания)
			И (ДатаОкончанияСписания < ДатаНачалаСписания) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Дата окончания списания'"),,,
				НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДатаОкончанияСписания", "Объект", Отказ);
		КонецЕсли;
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ДатаНачалаСписания");
		НепроверяемыеРеквизиты.Добавить("ДатаОкончанияСписания");
	КонецЕсли;
	
	РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДоходов,
		ЭтотОбъект, , Отказ);
	
	// Налоговый учет.
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
	Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, ДатаУчетнойПолитики, КФО) Тогда
		
		ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетДоходовНУ, "Н91.01");
		Если НЕ ЭтоПрочиеДоходы Тогда
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		КонецЕсли;
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
		
	ИначеЕсли УчетУСНКлиентСервер.ОтражатьВУСН(Организация, ДатаУчетнойПолитики, КФО) Тогда
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	// Проверим соответствие сумм начислений и итоговой суммы по общему графику оплаты.
	Если РежимВводаГрафикаОплаты = 0 Тогда // В абсолютных величинах.
		
		ОтборСтрок = Новый Структура("ИдентификаторСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
		ИтогСуммаОплатыПоГрафику = ПорядокОплаты.Выгрузить(ОтборСтрок, "СуммаПроцент").Итог("СуммаПроцент");
		
		Отбор = Новый Структура("ОсобыйПорядокОплаты", Ложь);
		СтрокиСОбщимПорядкомОплаты = Начисления.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицы Из СтрокиСОбщимПорядкомОплаты Цикл
			
			Если СтрокаТаблицы.Всего <> ИтогСуммаОплатыПоГрафику Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Всего'"),
					СтрокаТаблицы.НомерСтроки,
					НСтр("ru = 'Начисления'"),
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Сумма начисления %1 %3 не соответствует итоговой сумме по общему графику оплаты %2 %3.
						|Возможно, для данного начисления необходимо установить особый порядок оплаты.'"),
							СтрокаТаблицы.Всего,
							ИтогСуммаОплатыПоГрафику,
							ВалютаДокумента));
				ПолеВсего = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеВсего, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Проверим соответствие сумм начислений и графиков с особым графиком оплаты.
	Отбор = Новый Структура("ОсобыйПорядокОплаты", Истина);
	СтрокиСОсобымПорядкомОплаты = Начисления.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы Из СтрокиСОсобымПорядкомОплаты Цикл
		
		Если СтрокаТаблицы.РежимВводаОсобогоГрафикаОплаты = 0 Тогда // В абсолютных величинах.
			
			ОтборСтрок = Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
			ИтогСуммаОплатыПоГрафику = ПорядокОплаты.Выгрузить(ОтборСтрок, "СуммаПроцент").Итог("СуммаПроцент");
			
			Если СтрокаТаблицы.Всего <> ИтогСуммаОплатыПоГрафику Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Всего'"),
					СтрокаТаблицы.НомерСтроки,
					НСтр("ru = 'Начисления'"),
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Сумма начисления %1 %3 не соответствует итоговой сумме по особому графику оплаты %2 %3.'"),
							СтрокаТаблицы.Всего,
							ИтогСуммаОплатыПоГрафику,
							ВалютаДокумента));
				ПолеВсего = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеВсего, "Объект", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверим корректность настроек счетов бухгалтерского учета.
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетДБП);
	Если ИспользоватьУчетПоПодразделениям И Не СвойстваСчетаДБП.УчетПоПодразделениям Тогда
		
		СчетаРасчетов = ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(Начисления.ВыгрузитьКолонку("СчетРасчетов"));
		Для Каждого СчетРасчетов Из СчетаРасчетов Цикл
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасчетов);
			Если СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Внимание! На счете %1 ведется учет по подразделениям. В таком случае, на счете %2 также следует установить учет по подразделениям.
					|Установите признак ""Учет по подразделениям"" в настройке счета %2 (в разделе ""Учет и отчетность - План счетов (ЕПСБУ)"").'"),
						СчетРасчетов,
						СчетДБП);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, , "Объект");
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Проверим флаги ВестиГрафикПлатежей и ВестиПланГрафикИсполнения в договорах.
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Начисления.ВыгрузитьКолонку("Договор"),
			"ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		
		Для Каждого СтрокаНачисления Из Начисления Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаНачисления.Договор) Тогда
				Продолжить;
			КонецЕсли;
			
			ВидДоговора = РеквизитыДоговоров[СтрокаНачисления.Договор].ВидДоговора;
			ВестиГрафикПлатежей = РеквизитыДоговоров[СтрокаНачисления.Договор].ВестиГрафикПлатежей;
			ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаНачисления.Договор].ВестиПланГрафикИсполнения;
			Если Не ВестиГрафикПлатежей Или Не ВестиПланГрафикИсполнения Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Для корректного ведения и контроля исполнения графиков по долгосрочному договору с учащимся, следует установить признаки ""График платежей"" и ""План-график реализации"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
						СтрокаНачисления.Договор);
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Договор'"),
					СтрокаНачисления.НомерСтроки,
					НСтр("ru = 'Начисления'"),
					ТекстОшибки);
				ПолеДоговор = "Начисления[" + Формат(СтрокаНачисления.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Договор";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеДоговор, "Объект");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Начисления.Итог("Всего");
	
	Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
		ДатаНачалаСписания = Неопределено;
		ДатаОкончанияСписания = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли