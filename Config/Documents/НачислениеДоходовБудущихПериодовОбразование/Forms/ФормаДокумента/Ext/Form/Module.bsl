&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	ВидУслуг = ?(Объект.НачислениеЗаПрочиеУслуги, 1, 0);
	
	// Отбор строк на странице "Общий порядок оплаты".
	Элементы.ПорядокОплаты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Перечисления.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование);
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	НачисленияЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовОсобыйПорядокОплаты(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УстановитьВидимостьФлагаАннулироватьПлановыеПоступленияОплаты(ЭтотОбъект);
	УстановитьДоступностьНачисленияЗаПрочиеУслуги(ЭтотОбъект);
	УстановитьДоступностьПодразделения(ЭтотОбъект);
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОсобыйПорядокПризнанияДоходовТекущегоПериода =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке"));
	ПризнаниеДоходовТекущегоПериодаПоГрафику =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ДатаНачалаСписания");
	СрокСписания.Добавить("ДатаОкончанияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ ПризнаниеДоходовТекущегоПериодаПоГрафику);
	
	Если ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаНачалаСписания));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаОкончанияСписания));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходовПредупреждение",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ Форма.ИспользоватьКонтрольИсполненияДоговоров);
	
	Если ПризнаниеДоходовТекущегоПериодаПоГрафику Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Доходы будущих периодов относятся на финансовый результат текущего периода согласно графику, установленному на закладке ""Общий (особый) порядок оплаты"".'"));
	ИначеЕсли ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Суммы списания доходов будущих периодов указываются вручную в документе начисления доходов текущего периода.'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'В течение указанного срока доходы будущих периодов относятся на финансовый результат текущего периода.'"));
	КонецЕсли;
	
	Если Объект.РежимВводаГрафикаОплаты = 0 Тогда // В абсолютных величинах.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГрафикОплатыСуммаПроцент", "Заголовок", НСтр("ru = 'Сумма'"));
	Иначе // В относительных величинах.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГрафикОплатыСуммаПроцент", "Заголовок", НСтр("ru = '%, доля'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовОсобыйПорядокОплаты(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Форма.НачислениеРежимВводаГрафикаОплаты = 0 Тогда // В абсолютных величинах.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОсобыйПорядокОплатыСуммаПроцент", "Заголовок", НСтр("ru = 'Сумма'"));
	Иначе // В относительных величинах.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ОсобыйПорядокОплатыСуммаПроцент", "Заголовок", НСтр("ru = '%, доля'"));
	КонецЕсли;
	
	ЭлементыОсобыйПорядокОплаты = Новый Массив;
	ЭлементыОсобыйПорядокОплаты.Добавить("НачислениеРежимВводаГрафикаОплаты");
	ЭлементыОсобыйПорядокОплаты.Добавить("ОсобыйПорядокОплаты");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОсобыйПорядокОплаты, "Доступность", Форма.НачислениеОсобыйПорядокОплаты);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО)
		И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	ОтражатьВНалоговомУчетеУСН = УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Объект.КФО)
		И (Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходы
		ИЛИ Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьФлагаАннулироватьПлановыеПоступленияОплаты(Форма)
	
	// При переходе на СГС "Долгосрочные договоры" может потребоваться аннулировать
	// действующие плановые поступления оплаты по студентам, которые зачислены до 2020 г.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"АннулироватьПлановыеПоступленияОплаты", "Видимость", Форма.ОтразитьВМежотчетномПериоде);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьНачисленияЗаПрочиеУслуги(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НачислениеЗаУслугу", "Доступность", Форма.ВидУслуг <> 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НачисленияРассчитатьСтоимостьПоГрафикамОплаты", "Видимость", Форма.ВидУслуг = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НачисленияРассчитатьСтоимостьПоГрафикуОплатыПрочиеУслуги", "Видимость", Форма.ВидУслуг <> 0);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияОсобыйПорядокУстановитьОтборВТаблице()
	
	ТекущиеДанные = Элементы.НачисленияОсобыйПорядок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.ОсобыйПорядокОплаты.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.ИдентификаторСтроки <> НовыйОтборСтрок.ИдентификаторСтроки Тогда
		Элементы.ОсобыйПорядокОплаты.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьИтоговуюСуммуОплатыПоГрафику(Форма, ИдентификаторСтроки)
	
	Объект = Форма.Объект;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	ОбщийГрафикОплаты = Объект.ПорядокОплаты.НайтиСтроки(ОтборСтрок);
	
	ИтогСуммаОплатыПоГрафику = 0;
	Для Каждого СтрокаГрафика Из ОбщийГрафикОплаты Цикл
		ИтогСуммаОплатыПоГрафику = ИтогСуммаОплатыПоГрафику + СтрокаГрафика.СуммаПроцент;
	КонецЦикла;
	
	Возврат ИтогСуммаОплатыПоГрафику;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВопросаПередЗаполнением(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = "Перезаполнить" Тогда
		Объект.Начисления.Очистить();
	КонецЕсли;
	
	ИмяМакета = ДопПараметры.ИмяМакета;
	
	ВызватьОкноОтбора(ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОтбору(Результат, ДопПараметры) Экспорт
	
	Адреса = ДопПараметры.Адреса;
	ИмяМакета = ДопПараметры.ИмяМакета;
	
	Если Результат <> Неопределено Тогда
		
		Адреса.НастройкиКомпоновкиДанных = Результат;
		ЗаполнитьУчащимисяСервер(Адреса);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОкноОтбора(ИмяМакета)
	
	Адреса = РаботаСоСтудентамиВызовСервера.ПолучитьАдресаСКДПодбора(ИмяМакета, УникальныйИдентификатор);
	
	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = СтрШаблон(НСтр("ru = 'Настройка параметров отбора учащихся (значения на %1)'"), Формат(Объект.Дата, "ДЛФ=DD"));
	
	ДопПараметры = Новый Структура("Адреса, ИмяМакета", Адреса, ИмяМакета);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы, ЭтаФорма, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчащимисяСервер(Адреса)
	
	ДанныеУчащихся = РаботаСоСтудентами.ПолучитьДанныеПодбораУчащихся(Адреса, Объект.Организация, Объект.Подразделение, Объект.Дата,
		?(Объект.НачислениеЗаПрочиеУслуги, Объект.НачислениеЗаУслугу, Неопределено) );
	
	ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(Объект.Номенклатура,
		Объект.Организация, Объект.Дата);
	
	НаДату = ?(ЗначениеЗаполнено(Объект.ВидМежотчетногоПериода), КонецГода(Объект.Дата) + 1, Объект.Дата);
	
	Для каждого СтрокаТаблицы Из ДанныеУчащихся Цикл
		
		НоваяСтрока = Объект.Начисления.Добавить();
		НоваяСтрока.Студент    = СтрокаТаблицы.Студент;
		НоваяСтрока.Контрагент = СтрокаТаблицы.Контрагент;
		НоваяСтрока.Договор    = СтрокаТаблицы.ДоговорКонтрагента;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Количество) Тогда
			НоваяСтрока.Количество = 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмерения) Тогда
			НоваяСтрока.ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеНоменклатуры.СтавкаНДС) Тогда
			НоваяСтрока.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
		КонецЕсли;
		РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "СтавкаНДС");
		
		УчетРасчетов.ЗаполнитьПараметрыСчетаИДопСубконтоРасчетов(НоваяСтрока,
			Объект.КЭК, "205.00", НаДату, Объект.Организация, Объект.ИФО);
		
	КонецЦикла;
	
	Если Объект.НачислениеЗаПрочиеУслуги Тогда
		РассчитатьПоГрафикуОплатыПрочихУслуг();
	Иначе
		РассчитатьПоГрафикамОплатыНаСервере();
	КонецЕсли;
	
	УстановитьПредупреждение();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
	
	Если Объект.Начисления.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Подразделение.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Подразделение.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		
	КонецЕсли; 
	
КонецПроцедуры

// Расчет по графикам оплаты.

&НаКлиенте
Функция РассчитатьПоГрафикамОплатыВозможно()
	
	СтатусВозможноЗаполнить = Новый Структура;
	СтатусВозможноЗаполнить.Вставить("Отказ", Ложь);
	СтатусВозможноЗаполнить.Вставить("ЗадатьВопрос", Ложь); // Запросить подтверждение перед перезаполнением.
	СтатусВозможноЗаполнить.Вставить("ТекстВопроса",
		НСтр("ru = 'Рассчитать суммы начислений по графикам оплаты?'") );
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.Организация",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ИФО",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Факультет'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.Подразделение",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Валюта'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ВалютаДокумента",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если Объект.Начисления.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Список студентов на закладке ""Начисления"" пуст. Сначала заполните список студентов.'"),,,,
			СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если СтатусВозможноЗаполнить.Отказ Тогда
		Возврат СтатусВозможноЗаполнить;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ПорядокОплаты.Количество() > 0);
	Если ЕстьДанныеВДокументе Тогда
		СтатусВозможноЗаполнить.ТекстВопроса = СтатусВозможноЗаполнить.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные на закладках ""Общий порядок оплаты"" и ""Особый порядок оплаты"" будут очищены.'");
		СтатусВозможноЗаполнить.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат СтатусВозможноЗаполнить;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимостьПоГрафикуОплатыЗавершение(ВыбранныйГрафикОплаты, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйГрафикОплаты) Тогда
		РассчитатьПоГрафикамОплатыНаСервере(ВыбранныйГрафикОплаты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоГрафикамОплатыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьПоГрафикамОплатыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьПоГрафикамОплатыНаСервере(ГрафикОплаты = Неопределено);
	
	Документы.НачислениеДоходовБудущихПериодовОбразование.РассчитатьПоГрафикамОплаты(Объект, ГрафикОплаты);
	
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
КонецПроцедуры

&НаСервере
Функция РассчитатьПоГрафикуОплатыПрочихУслуг();
	
	Отказ = Ложь;
	
	ПараметрыНачисленияЗаУслугу = РаботаСоСтудентами.ПараметрыНачисленийЗаПрочиеУслуги(Объект.НачислениеЗаУслугу, КонецДня(Объект.Дата));
	Если ЗначениеЗаполнено(ПараметрыНачисленияЗаУслугу.ГрафикОплаты) Тогда
		РассчитатьПоГрафикамОплатыНаСервере(ПараметрыНачисленияЗаУслугу.ГрафикОплаты);
	Иначе // График оплаты не задан для указанного начисления.
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьШаблонГрафикаОплатыЗавершение(ВыбранныйГрафикОплат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйГрафикОплат) Тогда
		
		ИтоговаяСуммаПоГрафику = ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ДопПараметры.ИдентификаторСтроки);
		
		Если НЕ ЗначениеЗаполнено(ДопПараметры.ИдентификаторСтроки) Тогда // Общий порядок оплаты.
			УстановитьВидимостьЭлементов(ЭтотОбъект);
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Установить сумму корректировки доходов будущих периодов %1 для учащихся с общим порядком оплаты?'"),
				Формат(ИтоговаяСуммаПоГрафику, "ЧЦ=15;ЧДЦ=2"));
		Иначе // Особый порядок оплаты.
			УстановитьВидимостьЭлементовОсобыйПорядокОплаты(ЭтотОбъект);
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Установить сумму корректировки доходов будущих периодов %1 для выбранного учащегося?'"),
				Формат(ИтоговаяСуммаПоГрафику, "ЧЦ=15;ЧДЦ=2"));
		КонецЕсли;
		
		ДопПараметры.Вставить("ИтоговаяСуммаПоГрафику", ИтоговаяСуммаПоГрафику);
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьСуммуПоГрафикуОплатЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ИдентификаторСтроки)
	
	ОсобыйПорядокОплаты = ЗначениеЗаполнено(ИдентификаторСтроки);
	
	// Удаляем строки по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплаты.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		Объект.ПорядокОплаты.Удалить(Объект.ПорядокОплаты.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Заполняем график оплат по выбранному графику оплат.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиОплатыОбразование.Ссылка КАК Ссылка,
	|	ГрафикиОплатыОбразование.Валюта КАК Валюта,
	|	ГрафикиОплатыОбразование.РежимВводаГрафикаОплаты КАК РежимВводаГрафикаОплаты,
	|	ГрафикиОплатыОбразование.ПорядокОплаты.(
	|		НомерСтроки КАК НомерСтроки,
	|		ОплатитьДо КАК ОплатитьДо,
	|		СуммаПроцент КАК СуммаПроцент,
	|		НачалоПериода КАК НачалоПериода,
	|		КонецПериода КАК КонецПериода,
	|		Примечание КАК Примечание
	|	) КАК ПорядокОплаты
	|ИЗ
	|	Справочник.ГрафикиОплатыОбразование КАК ГрафикиОплатыОбразование
	|ГДЕ
	|	ГрафикиОплатыОбразование.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо,
	|	НачалоПериода,
	|	КонецПериода";
	Запрос.УстановитьПараметр("Ссылка", ВыбранныйГрафикОплат);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ОсобыйПорядокОплаты Тогда // Общий порядок оплаты.
			Объект.РежимВводаГрафикаОплаты = Выборка.РежимВводаГрафикаОплаты;
		Иначе // Особый порядок оплаты.
			ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
			СтрокиНачислений = Объект.Начисления.НайтиСтроки(ОтборПоИдентификатору);
			Если СтрокиНачислений.Количество() > 0 Тогда // Должна быть только одна строка с указанным мдентификатором.
				СтрокиНачислений[0].РежимВводаОсобогоГрафикаОплаты = Выборка.РежимВводаГрафикаОплаты;
				НачислениеРежимВводаГрафикаОплаты = Выборка.РежимВводаГрафикаОплаты;
			КонецЕсли;
		КонецЕсли;
		
		ВыборкаПорядокОплаты = Выборка.ПорядокОплаты.Выбрать();
		Пока ВыборкаПорядокОплаты.Следующий() Цикл
			НоваяСтрока = Объект.ПорядокОплаты.Добавить();
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПорядокОплаты,
				"ОплатитьДо,СуммаПроцент,НачалоПериода,КонецПериода,Примечание");
		КонецЦикла;
		
	КонецЦикла;
	
	Если ОсобыйПорядокОплаты Тогда
		ИтогСуммаОплатыПоОсобомуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
			ИдентификаторСтроки);
		Возврат ИтогСуммаОплатыПоОсобомуГрафику;
	Иначе
		ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
		Возврат ИтогСуммаОплатыПоОбщемуГрафику;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СохранитьШаблонГрафикаОплатыЗавершение(НаименованиеГрафикаОплаты, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(НаименованиеГрафикаОплаты) Тогда
		
		СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ДопПараметры.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ИдентификаторСтроки)
	
	ОсобыйПорядокОплаты = ЗначениеЗаполнено(ИдентификаторСтроки);
	
	ГрафикОплатОбъект = Справочники.ГрафикиОплатыОбразование.СоздатьЭлемент();
	ГрафикОплатОбъект.Наименование = НаименованиеГрафикаОплаты;
	
	Если НЕ ОсобыйПорядокОплаты Тогда // Общий порядок оплаты.
		ГрафикОплатОбъект.РежимВводаГрафикаОплаты = Объект.РежимВводаГрафикаОплаты;
	Иначе // Особый порядок оплаты.
		ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
		СтрокиНачислений = Объект.Начисления.НайтиСтроки(ОтборПоИдентификатору);
		Если СтрокиНачислений.Количество() > 0 Тогда // Должна быть только одна строка с указанным мдентификатором.
			СтрокиНачислений[0].РежимВводаОсобогоГрафикаОплаты = Объект.РежимВводаГрафикаОплаты;
			НачислениеРежимВводаГрафикаОплаты = Объект.РежимВводаГрафикаОплаты;
		КонецЕсли;
	КонецЕсли;
	
	Если ГрафикОплатОбъект.РежимВводаГрафикаОплаты = 0 Тогда
		ГрафикОплатОбъект.Валюта = Объект.ВалютаДокумента;
	КонецЕсли;
	
	// Сохраняем строки по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплаты.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		НоваяСтрока = ГрафикОплатОбъект.ПорядокОплаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
			"ОплатитьДо,СуммаПроцент,НачалоПериода,КонецПериода,Примечание");
	КонецЦикла;
	
	Попытка
		ГрафикОплатОбъект.Записать();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Записан новый элемент ""%1"" справочника ""Графики оплат"" в разделе ""Платное обучение - Долгосрочные договоры"".'"), НаименованиеГрафикаОплаты);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось записать новый элемент справочника ""Графики оплат (образование)"".'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

// Расчет по ставкам оплаты.

&НаКлиенте
Функция РассчитатьПоСтавкамОплатыВозможно()
	
	СтатусВозможноЗаполнить = Новый Структура;
	СтатусВозможноЗаполнить.Вставить("Отказ", Ложь);
	СтатусВозможноЗаполнить.Вставить("ЗадатьВопрос", Ложь); // Запросить подтверждение перед перезаполнением.
	СтатусВозможноЗаполнить.Вставить("ТекстВопроса",
		НСтр("ru = 'Рассчитать суммы начислений по ставкам оплаты?'") );
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.Организация",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ИФО",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Факультет'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.Подразделение",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Валюта'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ВалютаДокумента",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если Объект.Начисления.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Список студентов на закладке ""Начисления"" пуст. Сначала заполните список студентов.'"),,,,
			СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если СтатусВозможноЗаполнить.Отказ Тогда
		Возврат СтатусВозможноЗаполнить;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ПорядокОплаты.Количество() > 0);
	Если ЕстьДанныеВДокументе Тогда
		СтатусВозможноЗаполнить.ТекстВопроса = СтатусВозможноЗаполнить.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные на закладках ""Общий порядок оплаты"" и ""Особый порядок оплаты"" будут очищены.'");
		СтатусВозможноЗаполнить.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат СтатусВозможноЗаполнить;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимостьПоСтавкеОплатыЗавершение(ВыбраннаяСтавка, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбраннаяСтавка) Тогда
		РассчитатьПоСтавкамОплатыНаСервере(ВыбраннаяСтавка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоСтавкамОплатыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьПоСтавкамОплатыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьПоСтавкамОплатыНаСервере(СтавкаОплаты = Неопределено);
	
	Документы.НачислениеДоходовБудущихПериодовОбразование.РассчитатьПоСтавкамОплаты(Объект, СтавкаОплаты);
	
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
КонецПроцедуры

// Прочее.

&НаКлиенте
Процедура ЗаполнитьСуммуПоГрафикуОплатЗавершение(РезультатВопроса, ДопПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ДопПараметры.ИдентификаторСтроки);
	НайденныеСтроки = Объект.Начисления.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаДокумента Из НайденныеСтроки Цикл
		СтрокаДокумента.Всего = ДопПараметры.ИтоговаяСуммаПоГрафику;
		РасчитатьСтроку(СтрокаДокумента, Объект.СуммаВключаетНДС, "Всего");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммаВключаетНДС()
	
	Для каждого ТекУслуга Из Объект.Начисления Цикл
		РасчитатьСтроку(ТекУслуга, Объект.СуммаВключаетНДС, "Сумма");
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(Номенклатура, Организация, Дата)
	
	СтруктураДанных = Новый Структура("ЕдиницаИзмерения,СтавкаНДС");
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, СтруктураДанных);
	Возврат ДанныеНоменклатуры;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	
	// Расчет реквизитов "Цена", "Сумма", "СуммаНДС", "Всего".
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПодразделения(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Подразделение",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетДоходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Ложь);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыАвтоподстановкиДанныхПоСтуденту(Студент, ВидУслуг, Отбор)
	
	Если ВидУслуг = 0 Тогда
		Возврат РаботаСоСтудентами.ПараметрыАвтоподстановкиДанныхПоСтуденту(Студент, "ОбразовательныеУслуги", Отбор);
	Иначе
		Возврат РаботаСоСтудентами.ПараметрыАвтоподстановкиДанныхПоСтуденту(Студент, "ПрочиеУслуги", Отбор);
	КонецЕсли;
	
КонецФункции

