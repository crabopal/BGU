	ИтогСуммаОплатыПоОсобомуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект, ТекущиеДанные.ИдентификаторСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьУчащимися(Команда)
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Факультет'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Подразделение",, Отказ);
	КонецЕсли;
	
	Если Объект.НачислениеЗаПрочиеУслуги И Не ЗначениеЗаполнено(Объект.НачислениеЗаУслугу) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид начисления за прочие услуги'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.НачислениеЗаУслугу",, Отказ);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		ИмяМакета = ?(Объект.НачислениеЗаПрочиеУслуги, "ПодборПоНачислениюЗаПрочиеУслуги", "ПодборСПлательщиком");
		
		Если Объект.Начисления.Количество() > 0 Тогда
			ДопПараметры = Новый Структура("ИмяМакета", ИмяМакета);
			
			ТекстВопроса = НСтр("ru='Документ уже заполнен, выберите необходимое действие:'"); 
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить("Перезаполнить", "Перезаполнить документ");
			СписокКнопок.Добавить("Добавить", "Добавить по отбору");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
			
			Оповещение = Новый ОписаниеОповещения("ОбработкаВопросаПередЗаполнением", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Отмена);
		Иначе
			ВызватьОкноОтбора(ИмяМакета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуНачисления(Команда)
	
	Подсказка = НСтр("ru='Введите сумму начисления:'");
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСуммуНачисленияЗавершение", ЭтотОбъект);
	ПоказатьВводЧисла(Оповещение, 0, Подсказка, 15, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуНачисленияЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Для Каждого ИдентификаторВыделеннойСтроки Из Элементы.Начисления.ВыделенныеСтроки Цикл
			СтрокаНачисления = Объект.Начисления.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			СтрокаНачисления.Всего = Результат;
			РасчитатьСтроку(СтрокаНачисления, Объект.СуммаВключаетНДС, "Всего");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьПоГрафикамОплаты(Команда)
	
	СтатусВозможноЗаполнить = РассчитатьПоГрафикамОплатыВозможно();
	Если СтатусВозможноЗаполнить.Отказ Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(СтатусВозможноЗаполнить.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("РассчитатьПоГрафикамОплатыЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, СтатусВозможноЗаполнить.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		РассчитатьПоГрафикамОплатыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьПоГрафикуОплатыПрочиеУслуги(Команда)
	
	Отказ = РассчитатьПоГрафикуОплатыПрочихУслуг();
	
	Если Отказ Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не указан график оплаты для вида начислений за прочие услуги ""%1""'"),
				Объект.НачислениеЗаУслугу);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.НачислениеЗаУслугу");
	КонецЕсли;
	
КонецПроцедуры

