#Область ОбработчикиСобытийЭлементовТаблицыФормы_Начисления

&НаКлиенте
Процедура НачисленияПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если НЕ Отказ И ТекущиеДанные.ОсобыйПорядокОплаты Тогда
		// Удаляем строки особого графика из табличной части.
		ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
		ОсобыйГрафикОплаты = Объект.ПорядокОплаты.НайтиСтроки(ОтборПоИдентификатору);
		Для Каждого СтрокаГрафика Из ОсобыйГрафикОплаты Цикл
			Объект.ПорядокОплаты.Удалить(Объект.ПорядокОплаты.Индекс(СтрокаГрафика));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтудентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату", Объект.Дата);
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Отбор.Вставить("Факультет", Объект.Подразделение);
	КонецЕсли;
	
	ПараметрыАвтоподстановки = ПараметрыАвтоподстановкиДанныхПоСтуденту(ТекущиеДанные.Студент, ВидУслуг, Отбор);
	
	Если ПараметрыАвтоподстановки.Договоры.Количество() = 1 Тогда
		ТекущиеДанные.Договор = ПараметрыАвтоподстановки.Договоры[0]; // Единственный доступный вариант.
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Договор) И ПараметрыАвтоподстановки.Договоры.Найти(ТекущиеДанные.Договор) = Неопределено Тогда
		ТекущиеДанные.Договор = Неопределено; // Выбранный договор отсутствует среди доступных.
	КонецЕсли;
	Если ПараметрыАвтоподстановки.Плательщики.Количество() = 1 Тогда
		ТекущиеДанные.Контрагент = ПараметрыАвтоподстановки.Плательщики[0]; // Единственный доступный вариант.
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Контрагент) И ПараметрыАвтоподстановки.Плательщики.Найти(ТекущиеДанные.Контрагент) = Неопределено Тогда
		ТекущиеДанные.Контрагент = Неопределено; // Выбранный контрагент отсутствует среди доступных.
	КонецЕсли;
	
КонецПроцедуры

