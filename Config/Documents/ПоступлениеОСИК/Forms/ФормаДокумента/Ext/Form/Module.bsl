&НаКлиенте
Процедура ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередаче(Команда)
	ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередачеНаСервере();
	
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Контрагент""'"),, "Объект.Контрагент");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Объект.Организация");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "";	
	Если Объект.ЗачетАвансов.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена.
		|'") ;
	КонецЕсли;
	Если Объект.Проведен Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Проведение документа будет отменено.
		|'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		 ТекстВопроса = ТекстВопроса + НСтр("ru = 'Продолжить?'");
		 ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнениеТаблицыАвансыЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		 Возврат;
	КонецЕсли;	 

	ЗаполнитьАвансыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимОтбораДМПоОбъекту(Команда)
	
	ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА = НЕ ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА;
	УстановитьВидимостьДанныхДрагМатериалов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписокДМДляОбъекта(Команда)

	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект вложения!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе
		Если Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Количество() = 1 Тогда
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМ(ЭтотОбъект, Объект,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ОсновноеСредство,
				ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка"),
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Количество, "Изделия");
			
			ЭтотОбъект.ВариантВводаДанныхДМ = 1;  
		Иначе
			МассивВыделенныеСтроки = Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки;
			
			АдресТаблицыОбъектовНФА = ПоместитьТаблицуОбъектовНФАДляДМВХранилище(МассивВыделенныеСтроки);
			
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМДляПеречняОбъектов(ЭтотОбъект, Объект,
				АдресТаблицыОбъектовНФА, "Изделия"); 
			
			ЭтотОбъект.ВариантВводаДанныхДМ = 2;
		КонецЕсли;	
			
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьОбъектыОдногоНФА(Команда)
	
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект НФА!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе
		Если Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Количество() = 1 Тогда
			ТекущийЭлементСправочникаНФА = Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ОсновноеСредство;
			
			Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Очистить();
			Для Каждого ТекСтрока Из ЭтотОбъект.ОбъектыНФАСДрагМатериалами Цикл
				Если ТекСтрока.ОсновноеСредство = ТекущийЭлементСправочникаНФА Тогда
					Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Добавить(ТекСтрока.ПолучитьИдентификатор());
				КонецЕсли;
			КонецЦикла;
				
		Иначе
			ТекстОшибки = НСтр("ru='Следует выбрать один объект НФА!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
				Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

