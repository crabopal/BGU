&НаСервере
Функция ВидимостьЭлементовЭДОДляДокумента()
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВидимостьЭлементовЭДОАкта448()
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовЭДОДляЭДПоставщика, ВидимостьЭлементовЭДОАкта448)
	Объект = Форма.Объект;
	
	Если ВидимостьЭлементовЭДОДляЭДПоставщика Тогда
		ВидимостьЭлементовЭДО = Истина;
		Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Отражение ЭД в учете'");
	Конецесли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО И НЕ Объект.НФАПереданыЭлектроннымАктом);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НадписьДопСведенияЭлектронногоАктаПоФорме0510448", "Видимость", ВидимостьЭлементовЭДОАкта448);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи", "Видимость", ВидимостьЭлементовЭДОАкта448);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КапВложенияЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередаче", "Видимость", ВидимостьЭлементовЭДОАкта448);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		
		Если (Объект.КапВложения.Количество() > 0) Тогда
			Возврат;
		КонецЕсли;	
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.ЗаполнитьПоЭлектронномуДокументуПоставщика(ДокументОснование);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

&НаСервере
Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений = "")
	ЭлектронныеДокументыБГУ.ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, ТекстСведений);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСведенийЭлектронногоАктаОПриемеПередаче(ДанныеДляАкта)
	КоличествоФайлов = ДанныеДляАкта.КоличествоФайлов;
	
	ТекстСведений = ЭлектронныеДокументыБГУКлиент.ТекстПриложеноФайлов(КоличествоФайлов);

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений);
КонецПроцедуры	

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;             

	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("КапВложенияКоличество");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ Объект.ПоступлениеБиблиотечногоФонда);       
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаДрагМатериалы", "Видимость", Форма.ВестиУчетДрагМатериаловВМЦКапвложений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередачеНаСервере()
	
	ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя = 
		ДанныеЭлектронногоАктаОПриемеПередачеНФАПоНоменклатуреОтправителя(Объект.Организация, Объект.ДокументОснование);
		
	СведенияПТС = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[1].Выгрузить();
	СведенияКадастровогоУчета = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[2].Выгрузить();
		
	Для Каждого ТекСтрока Из Объект.КапВложения Цикл
		ТекНФА = ТекСтрока.ВнеоборотныйАктив;
		НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();

		Реквизиты = "GUIDНоменклатурыОтправителя";
		ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНФА, Реквизиты);
		GUIDНоменклатурыОтправителя = ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя;
		
		ПараметрыОтбораИнвНомера = Новый Структура;
		ПараметрыОтбораИнвНомера.Вставить("GUIDНоменклатурыУОтправителя", GUIDНоменклатурыОтправителя);
		
		//Заполнение сведений ПТС
		НайденныеСтрокиИнвНомераПТС = СведенияПТС.НайтиСтроки(ПараметрыОтбораИнвНомера);
		Для Каждого ТекДанныеПТС Из НайденныеСтрокиИнвНомераПТС Цикл
			НаборЗаписей = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
			НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
			НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Объект.Организация;
				НоваяЗапись.ОсновноеСредство = ТекНФА;
				НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеПТС);
				НоваяЗапись.ДвигательМодель = ТекДанныеПТС.МодельДвигателя;
				НоваяЗапись.ДвигательНомер = ТекДанныеПТС.НомерДвигателя;
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;	
		КонецЦикла;

		//Заполнение сведений кадастрового учета
		НайденныеСтрокиИнвНомераКадастра = СведенияКадастровогоУчета.НайтиСтроки(ПараметрыОтбораИнвНомера);
		Для Каждого ТекДанныеКадастра Из НайденныеСтрокиИнвНомераКадастра Цикл
			НаборЗаписей = РегистрыСведений.СведенияКадастровогоУчета.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
			НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
			НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Объект.Организация;
				НоваяЗапись.ОсновноеСредство = ТекНФА;
				НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеКадастра);
				НоваяЗапись.КадастровыйНомерЗемлиНедвижимости = ТекДанныеКадастра.КадастровыйНомерЗемли;
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДанныеЭлектронногоАктаОПриемеПередачеНФАПоНоменклатуреОтправителя(Организация, ЭлектронныйАктОПриемеПередаче)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.Ссылка КАК Ссылка,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.НомерСтроки КАК НомерСтроки,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.ИнвентарныйНомерУОтправителя КАК ИнвентарныйНомерУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.НаименованиеНФА КАК НаименованиеНФА,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.GUIDНоменклатурыУОтправителя КАК GUIDНоменклатурыУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОСодержанииДрагМатериалов.КодВидаДрагоценногоМатериала КАК КодВидаДрагоценногоМатериала,
