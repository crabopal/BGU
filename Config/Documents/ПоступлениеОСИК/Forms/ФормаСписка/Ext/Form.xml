	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.НФАПереданыЭлектроннымАктом</Field>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.ПервичныйДокумент</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПоступлениеИК.Ссылка КАК Ссылка,
	ДокументПоступлениеИК.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПоступлениеИК.Номер КАК Номер,
	ДокументПоступлениеИК.Дата КАК Дата,  
	ВЫБОР
		КОГДА ДокументПоступлениеИК.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ДокументПоступлениеИК.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ДокументПоступлениеИК.Проведен КАК Проведен,
	ДокументПоступлениеИК.Организация КАК Организация,
	ДокументПоступлениеИК.ИФО КАК ИФО,
	ДокументПоступлениеИК.Подразделение КАК Подразделение,
	ДокументПоступлениеИК.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	ДокументПоступлениеИК.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	ДокументПоступлениеИК.Контрагент КАК Контрагент,
	ДокументПоступлениеИК.Договор КАК Договор,
	ДокументПоступлениеИК.СуммаДокумента КАК СуммаДокумента,
	ДокументПоступлениеИК.ЦМО КАК ЦМО,
	ДокументПоступлениеИК.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	ДокументПоступлениеИК.ВалютаДокумента КАК ВалютаДокумента,
	ДокументПоступлениеИК.Комментарий КАК Комментарий,
	ДокументПоступлениеИК.СуммаВключаетНДС КАК СуммаВключаетНДС,
	ДокументПоступлениеИК.ПрилагаемыеДокументы КАК ПрилагаемыеДокументы,
	ДокументПоступлениеИК.ЛицевойСчет КАК ЛицевойСчет,
	ДокументПоступлениеИК.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
	ДокументПоступлениеИК.ПервичныйДокумент КАК ПервичныйДокумент,
	ДокументПоступлениеИК.НФАПереданыЭлектроннымАктом КАК НФАПереданыЭлектроннымАктом,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументПоступлениеИК.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(СостоянияЭДАкта.СостояниеЭДО) = ТИП(Перечисление.СостоянияДокументовАктовЭДОБГУ)
			ТОГДА ПРЕДСТАВЛЕНИЕ(СостоянияЭДАкта.СостояниеЭДО)
		КОГДА ОтражениеЭДВУчетеОбороты.СуммаОборот &gt; 0
				И ДокументПоступлениеИК.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
			ТОГДА "Отражение ЭД в учете"
		ИНАЧЕ СостоянияЭД.ПредставлениеСостояния
	КОНЕЦ КАК ОбщееСостояниеЭДО,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен
ИЗ
