	|		КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	|			ТОГДА ПоступлениеИККапВложения.СуммаНДС
	|		ИНАЧЕ ВЫРАЗИТЬ(ПоступлениеИККапВложения.СуммаНДС * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК СуммаНДС,
	|	ПоступлениеИККапВложения.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ПоступлениеИККапВложения.Ссылка.ПринятьНДСКВычету = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	|						ТОГДА ПоступлениеИККапВложения.Всего - ПоступлениеИККапВложения.СуммаНДС
	|					ИНАЧЕ (ВЫРАЗИТЬ(ПоступлениеИККапВложения.Всего * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2))) - (ВЫРАЗИТЬ(ПоступлениеИККапВложения.СуммаНДС * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2)))
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	|					ТОГДА ПоступлениеИККапВложения.Всего
	|				ИНАЧЕ ВЫРАЗИТЬ(ПоступлениеИККапВложения.Всего * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2))
	|			КОНЕЦ
	|	КОНЕЦ КАК Сумма,
	|	ПоступлениеИККапВложения.Количество КАК Количество,
	|	СчетаДтКт.СчетДт КАК СчетДт,
	|	СчетаДтКт.КПСДт КАК КПСДт,
	|	СчетаДтКт.КПСКт КАК КПСКт,
	|	СчетаДтКт.СчетКт КАК СчетКт,
	|	СчетаДтКт.КЭКДт КАК КЭКДт,
	|	СчетаДтКт.КЭККт КАК КЭККт,
	|	СчетаДтКт.КФО КАК КФО,
	|	КлассификаторЕдиницИзмерения.Ссылка КАК ЕдиницаИзмерения,
	|	КлассификаторЕдиницИзмерения.Наименование КАК ЕдиницаНаименование,
