#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ДействующиеИд = РасходыСводно.ВыгрузитьКолонку("ИдСтроки");
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаРасходов Из РасходыДетально Цикл
		Если ДействующиеИд.Найти(СтрокаРасходов.ИдСтроки) = Неопределено Тогда
			СтрокиКУдалению.Добавить(СтрокаРасходов);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекСтрока Из СтрокиКУдалению Цикл
		РасходыДетально.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

// Заполняет документ остатками затрат по счетам учета затрат
//
Процедура ЗаполнитьДокумент(ПараметрыЗаполнения) Экспорт

	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	// Рассчитаем долю расходов, относящихся к деятельности на ЕНВД.
	ЭтотОбъект.ДоляЕНВД = ДоляРасходовЕНВД(Организация, Дата) * 100;
	
	// Получим остатки расходов к распределению.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	ЕСТЬNULL(Остатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.Счет.Родитель КАК СчетГруппа,
	|	Остатки.Счет КАК СчетУчетаУСН,
	|	ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.РасходыУСН) КАК РасходыУСН,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.СуммаОстаток КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНеУчитываемых
	|			ТОГДА Остатки.СуммаНеУчитываетсяНУОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетЕНВД
	|			ТОГДА Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНДС
	|			ТОГДА Остатки.СуммаНДСОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНДСРуб
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетаРасходовУСН),
	|			,
	|			Организация = &Организация
	|				И КФО В (&КФО)) КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетУчетаУСН,
	|	Субконто1,
	|	РасходыУСН
	|ИТОГИ
	|	СУММА(СуммаРуб),
	|	СУММА(СуммаНеУчитываетсяНУРуб),
	|	СУММА(СуммаЕНВДРуб),
	|	СУММА(СуммаНДСРуб)
	|ПО
	|	ИФО,
	|	КФО,
	|	КПС,
	|	Подразделение,
	|	СчетГруппа,
	|	Субконто1";
	
	Запрос.УстановитьПараметр("Период",          Новый Граница(КонецКвартала(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",     Организация);
	Запрос.УстановитьПараметр("КФО",             УчетУСНКлиентСервер.МассивКФОдляНалоговогоУчетаУСН());
	
	СчетаРасходовКРаспределению = БухгалтерскийУчет.СписокСчетов("У10.Р,У20.Р,У41.Р,У68.Р,У70.Р");
	Запрос.УстановитьПараметр("СчетаРасходовУСН", СчетаРасходовКРаспределению);
	
	Результат = Запрос.Выполнить();
	
	// Заполняем табличные части документа.
	ВыборкаПоИФО = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоИФО.Следующий() Цикл
	ВыборкаПоКФО = ВыборкаПоИФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоКФО.Следующий() Цикл
	ВыборкаПоКПС = ВыборкаПоКФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоКПС.Следующий() Цикл
	ВыборкаПоПодразделениям = ВыборкаПоКПС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоПодразделениям.Следующий() Цикл
	ВыборкаПоСчетамГруппам = ВыборкаПоПодразделениям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСчетамГруппам.Следующий() Цикл
	ВыборкаПоСубконто1 = ВыборкаПоСчетамГруппам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСубконто1.Следующий() Цикл
	
		НоваяСтрока = РасходыСводно.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоСубконто1);
		НоваяСтрока.ИдСтроки = РасходыСводно.Количество();
		
		ВыборкаДетальная = ВыборкаПоСубконто1.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			
			СтрокаДетально = РасходыДетально.Добавить();
			СтрокаДетально.ИдСтроки = НоваяСтрока.ИдСтроки;
			
			СтрокаДетально.СчетУчета  = ВыборкаДетальная.СчетУчетаУСН;
			СтрокаДетально.РасходыУСН = ВыборкаДетальная.РасходыУСН;
			СтрокаДетально.Субконто3  = ВыборкаДетальная.Субконто3;
			
			СтрокаДетально.ОстатокСумма           = ВыборкаДетальная.СуммаРуб;
			СтрокаДетально.ОстатокНДС             = ВыборкаДетальная.СуммаНДСРуб;
			СтрокаДетально.ОстатокЕНВД            = ВыборкаДетальная.СуммаЕНВДРуб;
			СтрокаДетально.ОстатокНеУчитываетсяНУ = ВыборкаДетальная.СуммаНеУчитываетсяНУРуб;
			
		КонецЦикла;
	
	КонецЦикла;
	КонецЦикла;
	КонецЦикла;
	КонецЦикла;
	КонецЦикла;
	КонецЦикла;
	
	РассчитатьСуммыСписанияПоДолеЕНВД();
	
КонецПроцедуры

Функция ДоляРасходовЕНВД(Организация, Знач НаДату) Экспорт

	УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, НаДату);
	НарастающимИтогомСНачалаГода = (УчетнаяПолитика.МетодРаспределенияРасходовУСНПоВидамДеятельности =
		Перечисления.МетодыРаспределенияРасходовУСНПоВидамДеятельности.НарастающимИтогомСНачалаГода);
	
	НачалоПериода = ?(НарастающимИтогомСНачалаГода, НачалоГода(НаДату), НачалоКвартала(НаДату));
	КонецПериода  = КонецКвартала(НаДату);
	
	Если УчетнаяПолитика.БазаРаспределенияРасходовУСНПоВидамДеятельности =
			Перечисления.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыОтРеализацииБУ Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
		Запрос.УстановитьПараметр("Организация",   Организация);
		Запрос.УстановитьПараметр("СчетаДоходов",  БухгалтерскийУчет.СписокСчетов("401.10"));
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУОбороты.СуммаОборотКт КАК СуммаДоходовВсего,
		|	ЕПСБУОбороты.СуммаЕНВДОборотКт КАК СуммаОсобыйПорядок
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&СчетаДоходов), , Организация В (&Организация), , ) КАК ЕПСБУОбороты";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.СуммаДоходовВсего = 0 Тогда
				// Если нет определенности, то считаем, что все расходы относятся к деятельности на основной системе обложения
				Возврат 0;
			Иначе
				Возврат Выборка.СуммаОсобыйПорядок / Выборка.СуммаДоходовВсего;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
		Запрос.УстановитьПараметр("Организация",   Организация);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КнигаУчетаДоходовИРасходовОбороты.ДоходыУСНОборот,
		|	КнигаУчетаДоходовИРасходовОбороты.ДоходыЕНВДОборот,
		|	КнигаУчетаДоходовИРасходовОбороты.ДоходыВсегоОборот
		|ИЗ
		|	РегистрНакопления.КнигаУчетаДоходовИРасходов.Обороты(&НачалоПериода, &КонецПериода, , Организация = &Организация) КАК КнигаУчетаДоходовИРасходовОбороты";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ДоходыУСНОборот   = ?(НЕ ЗначениеЗаполнено(Выборка.ДоходыУСНОборот),   0, Выборка.ДоходыУСНОборот);
			ДоходыЕНВДОборот  = ?(НЕ ЗначениеЗаполнено(Выборка.ДоходыЕНВДОборот),  0, Выборка.ДоходыЕНВДОборот);
			ДоходыВсегоОборот = ?(НЕ ЗначениеЗаполнено(Выборка.ДоходыВсегоОборот), 0, Выборка.ДоходыВсегоОборот);
			
			Если УчетнаяПолитика.БазаРаспределенияРасходовУСНПоВидамДеятельности =
					Перечисления.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыПринимаемыеНУ Тогда
				Возврат ?(ДоходыЕНВДОборот + ДоходыУСНОборот = 0, 0, ДоходыЕНВДОборот / (ДоходыЕНВДОборот + ДоходыУСНОборот));
			Иначе // Перечисления.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыВсегоНУ
				Возврат ?(ДоходыВсегоОборот = 0, 0, ДоходыЕНВДОборот / ДоходыВсегоОборот);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Процедура РассчитатьСуммыСписанияПоДолеЕНВД() Экспорт
	
	БазаРаспределенияРасходов = Новый Массив;
	БазаРаспределенияРасходов.Добавить(100 - ЭтотОбъект.ДоляЕНВД);
	БазаРаспределенияРасходов.Добавить(ЭтотОбъект.ДоляЕНВД);
	
	Для Каждого СтрокаДетально Из ЭтотОбъект.РасходыДетально Цикл
		
		РаспределениеСуммаРуб    = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаДетально.ОстатокСумма, БазаРаспределенияРасходов);
		РаспределениеСуммаНДСРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаДетально.ОстатокНДС, БазаРаспределенияРасходов);
		
		Если РаспределениеСуммаРуб <> Неопределено Тогда
			СтрокаДетально.СписатьНаУСНСумма  = РаспределениеСуммаРуб[0];
			СтрокаДетально.СписатьНаЕНВДСумма = РаспределениеСуммаРуб[1];
		Иначе
			СтрокаДетально.СписатьНаУСНСумма  = СтрокаДетально.ОстатокСумма;
			СтрокаДетально.СписатьНаЕНВДСумма = 0;
		КонецЕсли;
		
		Если РаспределениеСуммаНДСРуб <> Неопределено Тогда
			СтрокаДетально.СписатьНаУСНСуммаНДС  = РаспределениеСуммаНДСРуб[0];
			СтрокаДетально.СписатьНаЕНВДСуммаНДС = РаспределениеСуммаНДСРуб[1];
		Иначе
			СтрокаДетально.СписатьНаУСНСуммаНДС  = СтрокаДетально.ОстатокНДС;
			СтрокаДетально.СписатьНаЕНВДСуммаНДС = 0;
		КонецЕсли;
		
		// Остатки, отнесенные к ЕНВД и неучитываемым расходам, не распределяем.
		СтрокаДетально.СписатьНаЕНВДСуммаЕНВД            = СтрокаДетально.ОстатокЕНВД;
		СтрокаДетально.СписатьНаЕНВДСуммаНеУчитываетсяНУ = 0;
		СтрокаДетально.СписатьНаУСНСуммаНеУчитываетсяНУ  = СтрокаДетально.ОстатокНеУчитываетсяНУ;
		СтрокаДетально.СписатьНаУСНСуммаЕНВД             = 0;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли