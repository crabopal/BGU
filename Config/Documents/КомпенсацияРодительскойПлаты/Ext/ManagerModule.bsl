#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КомпенсацияРодительскойПлатыДети.Ссылка.НачалоПериода КАК НачалоПериода,
	|	КомпенсацияРодительскойПлатыДети.Ссылка.КонецПериода КАК КонецПериода,
	|	КомпенсацияРодительскойПлатыДети.Ссылка.Организация КАК Организация,
	|	КомпенсацияРодительскойПлатыДети.Ссылка.ИФО КАК ИФО,
	|	КомпенсацияРодительскойПлатыДети.Ребенок КАК Ребенок,
	|	КомпенсацияРодительскойПлатыДети.Плательщик КАК Плательщик,
	|	КомпенсацияРодительскойПлатыДети.СчетПлательщика КАК СчетПлательщика,
	|	КомпенсацияРодительскойПлатыДети.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	КомпенсацияРодительскойПлатыДети.Сумма КАК СуммаОплаты,
	|	КомпенсацияРодительскойПлатыДети.СуммаКомпенсации КАК СуммаКомпенсации,
	|	КомпенсацияРодительскойПлатыДети.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	КомпенсацияРодительскойПлатыДети.НастройкаКомпенсации
	|ИЗ
	|	Документ.КомпенсацияРодительскойПлаты.Дети КАК КомпенсацияРодительскойПлатыДети
	|ГДЕ
	|	КомпенсацияРодительскойПлатыДети.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ЖурналУчетаКомпенсацииРодительскойПлаты",
		Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.КомпенсацияРодительскойПлаты";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ВедомостьРасчетаКомпенсацииРП";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость расчета компенсации родительской платы'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ВедомостьРасчетаКомпенсацииРП") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ВедомостьРасчетаКомпенсацииРП",
			"Ведомость расчета компенсации родительской платы",
			ПечатьВедомости(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьВедомости(МассивОбъектов, ОбъектыПечати)
	
	ВидРасчета = Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить();
	Если ЗначениеЗаполнено(ВидРасчета) Тогда
		СпособРасчета = Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить() = Перечисления.СпособыРасчетаКомпенсацииРП.ПоСреднемесячной;
	Иначе
		СпособРасчета = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СпособРасчета) Тогда
		ТекстСообщения = НСтр("ru='Не настроен способ расчета компенсации родительской платы!
						|Настроить способ расчета можно в настройке параметров учета!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	ИначеЕсли СпособРасчета Тогда
		НастройкиСтавки = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.СрезПоследних(МассивОбъектов[0].КонецПериода);
		
		Если НастройкиСтавки.Количество() > 0 Тогда
			ТипСтавки = НастройкиСтавки[0].ВидСтавки;
			ЗначениеСтавки = НастройкиСтавки[0].Ставка;
		КонецЕсли;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ВедомостьРасчетаКомпенсацииРП";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.КомпенсацияРодительскойПлаты.ПФ_MXL_ВедомостьРасчетаКомпенсацииРП");
	
	ПервыйДокумент = Истина;

	Для Каждого Ссылка Из МассивОбъектов Цикл
		Если Не ПервыйДокумент Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент    = Ложь;	
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		ДанныеДляПечати = ПодготовитьДанныеДляПечати(Ссылка, СпособРасчета, ЗначениеСтавки, ТипСтавки);
		
		Область = Макет.ПолучитьОбласть("Шапка");
		
		Если НЕ СпособРасчета Тогда
			Область.УдалитьОбласть(Область.Область("Ставка"), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Ссылка.ГруппаДетскогоУчреждения) Тогда
			Область.УдалитьОбласть(Область.Область("ГруппаШапка"), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;	
		
		Область.Параметры.Заполнить(ДанныеДляПечати.Шапка);
		ТабДок.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Строка");
		
		Если ЗначениеЗаполнено(Ссылка.ГруппаДетскогоУчреждения) Тогда
			Область.УдалитьОбласть(Область.Область("ГруппаСтрока"), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		
		Для Каждого Стр Из ДанныеДляПечати.ТаблицаСтрок Цикл
			Область.Параметры.Заполнить(Стр);
			ТабДок.Вывести(Область);
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("Итого");
		Область.Параметры.Заполнить(ДанныеДляПечати.Итоги);
		ТабДок.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Подписи");
		Область.Параметры.Заполнить(ДанныеДляПечати.Подписи);
		ТабДок.Вывести(Область);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, Ссылка);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПодготовитьДанныеДляПечати(Ссылка, СпособРасчета, ЗначениеСтавки, ТипСтавки)
	
	ДанныеДляПечати = Новый Структура;
	
	РабочихДней = РодительскаяПлата.ПолучитьКоличествоРабочихДнейПоКалендарю(Ссылка.НачалоПериода, Ссылка.КонецПериода);
	
	Шапка = Новый Структура;
	Шапка.Вставить("Период", Формат(Ссылка.НачалоПериода, "ДФ='ММММ гггг ""г.""'"));
	Шапка.Вставить("Дата", Ссылка.Дата);
	Шапка.Вставить("Организация", ?(Ссылка.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование, Ссылка.Организация.Наименование, Ссылка.Организация.НаименованиеПолное));
	Шапка.Вставить("КодПоОКПО", Ссылка.Организация.КодОКПО);
	Шапка.Вставить("ГруппаДДУ", ?(ЗначениеЗаполнено(Ссылка.ГруппаДетскогоУчреждения), Ссылка.ГруппаДетскогоУчреждения, ""));
	Шапка.Вставить("СпособРасчета", ?(СпособРасчета, "по средней ставке", "по фактической сумме"));
	Если СпособРасчета Тогда
		Шапка.Вставить("СтавкаОплаты", ?(ТипСтавки = Перечисления.ВидыСтавкиКомпенсацииРодительскойПлаты.Дневная, Строка(ЗначениеСтавки) + " руб. за день", Строка(ЗначениеСтавки) + " руб. за месяц"));
	КонецЕсли;
	Шапка.Вставить("РабочихДнейВМесяце", РабочихДней);
	ДанныеДляПечати.Вставить("Шапка", Шапка);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КомпенсацияРодительскойПлатыДети.НомерСтроки КАК Нпп,
	|	КомпенсацияРодительскойПлатыДети.ГруппаДетскогоУчреждения КАК ГруппаДДУ,
	|	ЕСТЬNULL(ГрафикиРаботыГрупп.ГрафикРаботы, НЕОПРЕДЕЛЕНО) КАК ГрафикРаботы,
	|	КомпенсацияРодительскойПлатыДети.Ребенок КАК Ребенок,
	|	КомпенсацияРодительскойПлатыДети.Плательщик КАК Плательщик,
	|	КомпенсацияРодительскойПлатыДети.СчетПлательщика.Код КАК СчетПлательщика,
	|	КомпенсацияРодительскойПлатыДети.Сумма КАК Сумма,
	|	КомпенсацияРодительскойПлатыДети.СуммаКомпенсации КАК СуммаКомпенсации,
	|	КомпенсацияРодительскойПлатыДети.ПроцентКомпенсации КАК Процент,
	|	0 КАК Дней,
	|	Договоры.Договор КАК Договор
	|ИЗ
	|	Документ.КомпенсацияРодительскойПлаты.Дети КАК КомпенсацияРодительскойПлатыДети
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ.СрезПоследних(&КонецПериода, ) КАК Договоры
	|		ПО КомпенсацияРодительскойПлатыДети.Ребенок = Договоры.Ребенок
	|			И КомпенсацияРодительскойПлатыДети.ГруппаДетскогоУчреждения = Договоры.ГруппаДетскогоУчреждения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботыГруппДетскогоУчреждения.СрезПоследних(&НачалоПериода, ) КАК ГрафикиРаботыГрупп
	|		ПО КомпенсацияРодительскойПлатыДети.ГруппаДетскогоУчреждения = ГрафикиРаботыГрупп.ГруппаДетскогоУчреждения
	|ГДЕ
	|	КомпенсацияРодительскойПлатыДети.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Нпп";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("РабочихДней", РабочихДней);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Ссылка.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Ссылка.КонецПериода));
	Запрос.УстановитьПараметр("Организация", Ссылка.Организация);
	Запрос.УстановитьПараметр("Группа", Ссылка.ГруппаДетскогоУчреждения);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ТаблицаСтрок = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТаблицаСтрок Цикл
		Стр.Дней = РасчетыПоРодительскойПлате.КолПосещений(Ссылка.НачалоПериода, Ссылка.КонецПериода, Стр.ГрафикРаботы, Стр.Ребенок, Стр.ГруппаДДУ, 0);
	КонецЦикла;
	
	ДанныеДляПечати.Вставить("ТаблицаСтрок", ТаблицаСтрок);
	
	Итоги = Новый Структура;
	Итоги.Вставить("Сумма", ТаблицаСтрок.Итог("Сумма"));
	Итоги.Вставить("Дней", ТаблицаСтрок.Итог("Дней"));
	Итоги.Вставить("СуммаКомпенсации", ТаблицаСтрок.Итог("СуммаКомпенсации"));
	
	ДанныеДляПечати.Вставить("Итоги", Итоги);
	
	Подписи = Новый Структура;
	Подписи.Вставить("Дата", Ссылка.Дата);
	Подписи.Вставить("Руководитель", Корреспонденты.ФИОПоОбъекту(Ссылка.Руководитель, Истина));
	Подписи.Вставить("ГлБухгалтер", Корреспонденты.ФИОПоОбъекту(Ссылка.ГлБухгалтер, Истина));
	
	ДанныеДляПечати.Вставить("Подписи", Подписи);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

#КонецОбласти

#КонецЕсли

