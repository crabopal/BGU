Процедура ГруппаДетскогоУчрежденияПриИзмененииНаСервере()

	НужныеСтроки = Объект.Дети.Выгрузить(Новый Структура("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения));
	
	Объект.Дети.Загрузить(НужныеСтроки);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если НЕ Объект.РасчетЗаНесколькоМесяцев Тогда
		
		Если НЕ КонецМесяца(Объект.НачалоПериода) = КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;
		
	Иначе
		
		Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;

	КонецЕсли;	
	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.КонецПериода = НовоеЗначение;
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтотОбъект, "Объект.КонецПериода", "КонецПериодаСтрокой", Ложь);

	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьИзменениеОкончанияПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  НачалоМесяца(Объект.КонецПериода);
			
	КонецЕсли;

	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.НачалоПериода = НовоеЗначение;
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтотОбъект, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Объект)

	Объект.ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"), 
		Объект.Организация,
		Объект.Дата,
		Объект.Подразделение).ОтветственноеЛицоСсылка;
																					
	Объект.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), 
		Объект.Организация,
		Объект.Дата,
		Объект.Подразделение).ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаСервере
Процедура РассчитатьСтроку(ИдентификаторСтроки, ИмяКолонки)
	
	СтрокаТЧ = Объект.Дети.НайтиПоИдентификатору(ИдентификаторСтроки);
	ДанныеРебенка = РодительскаяПлата.ДанныеРебенка(СтрокаТЧ.Ребенок, Объект.Организация, КонецМесяца(Объект.КонецПериода));
	
	// Заполнить данные строки
	
	СтрокаТЧ.ГруппаДетскогоУчреждения = ДанныеРебенка.ДанныеГруппы.ГруппаДетскогоУчреждения;
	Если ИмяКолонки = "Ребенок" И Не ЗначениеЗаполнено(СтрокаТЧ.НастройкаКомпенсации) Тогда
		ЗаполнитьПараметрыКомпенсацииИзДанныхРебенка(СтрокаТЧ, ДанныеРебенка.ПараметрыКомпенсации);
	КонецЕсли;
	Если ИмяКолонки = "Ребенок" Тогда
		ЗаполнитьПлательщикаИзДанныхРебенка(СтрокаТЧ, ДанныеРебенка.Плательщик);
	КонецЕсли;
	
	// Рассчитать суммы
	
	ПараметрыКомпенсации = ПараметрыКомпенсацииИзДанныхРебенка(ДанныеРебенка.ПараметрыКомпенсации, СтрокаТЧ.НастройкаКомпенсации);
	
	Если ПараметрыКомпенсации = Неопределено Тогда
		СуммовыеПоказатели = СуммовыеПоказателиСтроки(Неопределено);
	Иначе
		
		ПараметрыРасчета = ПараметрыРасчетаДанныхСтроки();
		ПараметрыРасчета.Ребенок                  = СтрокаТЧ.Ребенок;
		ПараметрыРасчета.Настройка                = ПараметрыКомпенсации.НастройкаКомпенсации;
		ПараметрыРасчета.НачалоПериода            = НачалоМесяца(Объект.НачалоПериода);
		ПараметрыРасчета.КонецПериода             = КонецМесяца(Объект.КонецПериода);
		ПараметрыРасчета.ГруппаДетскогоУчреждения = СтрокаТЧ.ГруппаДетскогоУчреждения;
		ПараметрыРасчета.ДоговорКонтрагента       = ДанныеРебенка.ДанныеГруппы.Договор;
		ПараметрыРасчета.СтавкаОплаты             = ДанныеРебенка.ДанныеГруппы.СтавкаОплаты;
		ПараметрыРасчета.Льгота                   = ДанныеРебенка.ДанныеГруппы.Льгота;
		
		СуммовыеПоказатели = СуммовыеПоказателиСтроки(ПараметрыРасчета);
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СуммовыеПоказатели);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыКомпенсацииИзДанныхРебенка(Строка, ПараметрыКомпенсации)

	Если ПараметрыКомпенсации.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(ПараметрыКомпенсации[0].НастройкаКомпенсации) Тогда
			Строка.НастройкаКомпенсации = ПараметрыКомпенсации[0].НастройкаКомпенсации;
		ИначеЕсли ЗначениеЗаполнено(Объект.НастройкаРасчета) Тогда
			Строка.НастройкаКомпенсации = Объект.НастройкаРасчета;
		Иначе
			Строка.НастройкаКомпенсации = РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
		КонецЕсли;
	Иначе
		Строка.НастройкаКомпенсации = Справочники.НастройкиРасчетовПоРодительскойПлате.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлательщикаИзДанныхРебенка(Строка, Плательщик)

	Если ЗначениеЗаполнено(Плательщик.Плательщик) Тогда
		Строка.Плательщик = Плательщик.Плательщик;
		Строка.СчетПлательщика = Плательщик.СчетПлательщика;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПараметрыКомпенсацииИзДанныхРебенка(ПараметрыКомпенсации, ВыбраннаяНастройкаКомпенсации)

	Если ЗначениеЗаполнено(Объект.НастройкаРасчета) Тогда
		ОбщаяНастройка = Объект.НастройкаРасчета;
	Иначе
		ОбщаяНастройка = РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
	КонецЕсли;
	
	Для каждого СтрокаНастройкиКомпенсации Из ПараметрыКомпенсации Цикл
		Если ЗначениеЗаполнено(ВыбраннаяНастройкаКомпенсации) И ВыбраннаяНастройкаКомпенсации <> ОбщаяНастройка Тогда
			Если ВыбраннаяНастройкаКомпенсации = СтрокаНастройкиКомпенсации.НастройкаКомпенсации Тогда
				Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаНастройкиКомпенсации);
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(СтрокаНастройкиКомпенсации.НастройкаКомпенсации) Тогда
				Настройка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаНастройкиКомпенсации);
				Настройка.НастройкаКомпенсации = ОбщаяНастройка;
				Если ЗначениеЗаполнено(Настройка.НастройкаКомпенсации) Тогда
					Возврат Настройка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПараметрыРасчетаДанныхСтроки()

	Возврат Новый Структура("Настройка, НачалоПериода, КонецПериода, Ребенок, ГруппаДетскогоУчреждения, ДоговорКонтрагента, СтавкаОплаты, Льгота");

КонецФункции

&НаСервере
Функция СуммовыеПоказателиСтроки(НастройкиРасчета)

	РезультатРасчета = Новый Структура("Сумма, ПроцентКомпенсации, СуммаКомпенсации", 0, 0, 0);
	Если НастройкиРасчета = Неопределено Тогда
		Возврат РезультатРасчета;
	КонецЕсли;
	
	Формула = ФормулаРасчетаКомпенсации(НастройкиРасчета.Настройка);
	ОтредактироватьТекстФормулы(Формула);
	
	НачалоПериода              = НастройкиРасчета.НачалоПериода;
	КонецПериода               = НастройкиРасчета.КонецПериода;
	Ребенок                    = НастройкиРасчета.Ребенок;
	ГруппаДетскогоУчреждения   = НастройкиРасчета.ГруппаДетскогоУчреждения;
	ГрафикРаботы               = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НастройкиРасчета.НачалоПериода);
	РодительскаяПлатаДопУслуги = 0;
	Организация                = Объект.Организация;
	ДатаОстатка                = Истина;
	ДоговорКонтрагента         = НастройкиРасчета.ДоговорКонтрагента;
	СтавкаОплаты               = НастройкиРасчета.СтавкаОплаты;
	Льгота                     = НастройкиРасчета.Льгота;
	
	Попытка
		
		Парамс = Новый Структура();
		Парамс.Вставить("НачалоПериода", НачалоПериода);
		Парамс.Вставить("КонецПериода", КонецПериода);
		Парамс.Вставить("Ребенок", Ребенок);
		Парамс.Вставить("ГруппаДетскогоУчреждения", ГруппаДетскогоУчреждения);
		Парамс.Вставить("ГрафикРаботы", ГрафикРаботы);
		Парамс.Вставить("ДоговорКонтрагента", ДоговорКонтрагента);
		Парамс.Вставить("СтавкаОплаты", СтавкаОплаты);
		Парамс.Вставить("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
		Парамс.Вставить("Организация", Организация);
		Парамс.Вставить("Льгота", Льгота);
		Парамс.Вставить("ДатаОстатка", ДатаОстатка);
		
		Формула = ФормулаВставитьПараметры(Формула, Парамс);
		Результат = ОбщегоНазначения.ВычислитьВБезопасномРежиме(Формула, Парамс); // Результат = Вычислить(Формула);
		
	Исключение
		РодительскаяПлата.ВывестиСообщениеОбОшибке(Формула, Объект.Ссылка, ИнформацияОбОшибке());
		Возврат РезультатРасчета;
	КонецПопытки;
	
	ПроцентКомпенсации = РасчетыПоРодительскойПлате.ПроцентКомпенсации(КонецПериода, Ребенок);
	
	РезультатРасчета.Сумма              = Результат;
	РезультатРасчета.ПроцентКомпенсации = ПроцентКомпенсации;
	РезультатРасчета.СуммаКомпенсации   = Окр(Результат * ПроцентКомпенсации / 100, 2);
	
	Возврат РезультатРасчета;

КонецФункции

&НаСервере
Функция ФормулаВставитьПараметры(Формула, Парамс)
	Разделители = ",()+-*/= ";
	Результат = "";
	Лексема = "";
	Для НомерСимвола = 1 По СтрДлина(Формула) Цикл
		Символ = Сред(Формула, НомерСимвола, 1);
		Если Найти(Разделители, Символ) > 0 Тогда
			// Закрываем накопленную лексему.
			Если Лексема <> "" Тогда
				Если ЕстьТакойПарам(Парамс, Лексема) Тогда
					Результат = Результат + "Параметры." + Лексема;
				Иначе
					Результат = Результат + Лексема;
				КонецЕсли;
				Лексема = "";
			КонецЕсли;
			// Сам разделитель сохраняем как есть.
			Результат = Результат + Символ;
		Иначе
			Лексема = Лексема + Символ;
		КонецЕсли;
	КонецЦикла;
	// Закрываем последнюю лексему, если формула не закончилась разделителем.
	Если Лексема <> "" Тогда
		Если ЕстьТакойПарам(Парамс, Лексема) Тогда
			Результат = Результат + "Параметры." + Лексема;
		Иначе
			Результат = Результат + Лексема;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
// ----------------------------------------------------------------------------
Функция ЕстьТакойПарам(Парамс, Лексема)
	Вернем = Ложь;
	Попытка
		Вернем = Парамс.Свойство(Лексема);
	Исключение
	КонецПопытки;
	Возврат Вернем;
КонецФункции

&НаСервере
Функция ФормулаРасчетаКомпенсации(Настройка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиРасчетовПоРодительскойПлатеНастройки.ПредставлениеФормулы КАК ПредставлениеФормулы
	|ИЗ
	|	Справочник.НастройкиРасчетовПоРодительскойПлате.Настройки КАК НастройкиРасчетовПоРодительскойПлатеНастройки
	|ГДЕ
	|	НастройкиРасчетовПоРодительскойПлатеНастройки.Ссылка = &Ссылка
	|	И НастройкиРасчетовПоРодительскойПлатеНастройки.НомерСтроки = 3";
	Запрос.УстановитьПараметр("Ссылка", Настройка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПредставлениеФормулы;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ОтредактироватьТекстФормулы(Стр)
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ"")","НачалоМесяца(НачалоПериода)");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ"")","КонецМесяца(КонецПериода)"); 
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""МЕСЯЦ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""МЕСЯЦ"",""ОКОНЧАНИЕ"")");
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""КВАРТАЛ"")","НачалоКвартала(НачалоПериода)");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""КВАРТАЛ"")","КонецКвартала(КонецПериода)");
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""КВАРТАЛ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""КВАРТАЛ"",""ОКОНЧАНИЕ"")");
	Стр = СтрЗаменить(Стр,"&РодительскаяПлатаДопУслуги","РодительскаяПлатаДопУслуги");
	Стр = СтрЗаменить(Стр,"&Организация","Организация");
	Стр = СтрЗаменить(Стр, "ВЫБОР", "?(");
	Стр = СтрЗаменить(Стр, "КОГДА", "");
	Стр = СтрЗаменить(Стр, "ТОГДА", ",");
	Стр = СтрЗаменить(Стр, "ИНАЧЕ", ",");
	Стр = СтрЗаменить(Стр, "КОНЕЦ", ")");
	Стр = СтрЗаменить(Стр, " ", "");
КонецПроцедуры

