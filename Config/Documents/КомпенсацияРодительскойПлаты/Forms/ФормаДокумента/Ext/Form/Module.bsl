	Запрос.Текст = "";
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьУстранитьДубли(НоваяТаблица, КонецПериода)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабДок.ГруппаДетскогоУчреждения,
				   |	ТабДок.НачалоПериода,
	               |	ТабДок.Ребенок,
	               |	ТабДок.Плательщик,
	               |	ТабДок.СчетПлательщика,
	               |	ТабДок.ПроцентКомпенсации,
	               |	ТабДок.Контрагент,
	               |	ТабДок.Сумма,
	               |	ТабДок.СуммаКомпенсации,
	               |	ТабДок.НастройкаКомпенсации
	               |ПОМЕСТИТЬ ТабДок
	               |ИЗ
	               |	&ТабДок КАК ТабДок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТабДок.ГруппаДетскогоУчреждения,
				   |	ТабДок.НачалоПериода,
	               |	ТабДок.Ребенок,
	               |	ТабДок.Плательщик,
	               |	ТабДок.СчетПлательщика,
	               |	ТабДок.ПроцентКомпенсации,
	               |	ТабДок.Контрагент,
	               |	ТабДок.Сумма,
	               |	ТабДок.СуммаКомпенсации,
	               |	ТабДок.НастройкаКомпенсации
	               |ИЗ
	               |	ТабДок КАК ТабДок";
				   				   
	Запрос.УстановитьПараметр("ТабДок", НоваяТаблица);
		
	НоваяТаблица = Запрос.Выполнить().Выгрузить();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьИспользованиеНастройкиРасчета(НоваяТаблица, ДопустимаяНастройкаРасчета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабДок.ГруппаДетскогоУчреждения,
	               |	ТабДок.Ребенок,
	               |	ТабДок.Плательщик,
	               |	ТабДок.СчетПлательщика,
	               |	ТабДок.ПроцентКомпенсации,
	               |	ТабДок.Контрагент,
	               |	ТабДок.Сумма,
	               |	ТабДок.СуммаКомпенсации,
	               |	ТабДок.НастройкаКомпенсации
	               |ПОМЕСТИТЬ ТабДок
	               |ИЗ
	               |	&ТабДок КАК ТабДок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТабДок.ГруппаДетскогоУчреждения,
	               |	ТабДок.Ребенок,
	               |	ТабДок.Плательщик,
	               |	ТабДок.СчетПлательщика,
	               |	ТабДок.ПроцентКомпенсации,
	               |	ТабДок.Контрагент,
	               |	ТабДок.Сумма,
	               |	ТабДок.СуммаКомпенсации,
	               |	ТабДок.НастройкаКомпенсации
	               |ИЗ
	               |	ТабДок КАК ТабДок
	               |ГДЕ
	               |	ТабДок.НастройкаКомпенсации = &ДопустимаяНастройкаРасчета";
				   
	Запрос.УстановитьПараметр("ТабДок", НоваяТаблица);
	Запрос.УстановитьПараметр("ДопустимаяНастройкаРасчета", ДопустимаяНастройкаРасчета);
	
	НоваяТаблица = Запрос.Выполнить().Выгрузить();
КонецПроцедуры

