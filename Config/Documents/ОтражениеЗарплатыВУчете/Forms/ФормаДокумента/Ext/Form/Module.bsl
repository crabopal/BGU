		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

