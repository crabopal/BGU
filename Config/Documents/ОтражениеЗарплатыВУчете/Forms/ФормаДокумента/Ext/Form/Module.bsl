&НаСервереБезКонтекста
Процедура ПолучитьЗначенияРеквизитовСтроки(ДатаСреза, РеквизитыПоиска, ЗаполняемыеРеквизиты)
	
	Если ЗначениеЗаполнено(РеквизитыПоиска.СтатьяФинансированияЗарплата) Тогда
		НастройкиСтатьиФинансирования = РегистрыСведений.НастройкаСтатейФинансированияЗарплата.СрезПоследних(
			ДатаСреза, РеквизитыПоиска);
		Если НастройкиСтатьиФинансирования.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ЗаполняемыеРеквизиты, НастройкиСтатьиФинансирования[0]);
		ИначеЕсли РеквизитыПоиска.Свойство("КЭК") Тогда
			РеквизитыПоиска.Удалить("КЭК");
			ПолучитьЗначенияРеквизитовСтроки(ДатаСреза, РеквизитыПоиска, ЗаполняемыеРеквизиты);
		ИначеЕсли РеквизитыПоиска.Свойство("ВидОперацииПоЗарплате") Тогда
			РеквизитыПоиска.Удалить("ВидОперацииПоЗарплате");
			ПолучитьЗначенияРеквизитовСтроки(ДатаСреза, РеквизитыПоиска, ЗаполняемыеРеквизиты);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСоответствиеОпераций(ВидОперацииЗГУ, ВидОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ,
	               |	СоответствиеОперацийУчетаЗарплаты.ОперацияБГУ
	               |ИЗ
	               |	РегистрСведений.СоответствиеОперацийУчетаЗарплаты КАК СоответствиеОперацийУчетаЗарплаты
	               |ГДЕ
	               |	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ = &ОперацияЗГУ
	               |	И СоответствиеОперацийУчетаЗарплаты.ОперацияБГУ = &ОперацияБГУ";
	Запрос.УстановитьПараметр("ОперацияЗГУ", ВидОперацииЗГУ);
	Запрос.УстановитьПараметр("ОперацияБГУ", ВидОперации);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.Количество() > 0;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьЗаписьСоответствияОпераций(СоответствиеОпераций)
	МЗ = РегистрыСведений.СоответствиеОперацийУчетаЗарплаты.СоздатьМенеджерЗаписи();
	МЗ.ОперацияЗГУ = СоответствиеОпераций.ВидОперацииЗГУ;
	МЗ.ОперацияБГУ = СоответствиеОпераций.ВидОперации;
	МЗ.Записать();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбязательностьРеквизитов()
	
	Если Не Объект.ИмпортированИзЗГУ Тогда
		
		Элементы.ИФО.АвтоОтметкаНезаполненного           = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
		
		Элементы.ИФО.ОтметкаНезаполненного =
			?(Элементы.ИФО.АвтоОтметкаНезаполненного, НЕ ЗначениеЗаполнено(Объект.ИФО), Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	// Колонки ОтражениеВУчете.
	Для Каждого СтрокаТаблицы Из Объект.Операции Цикл
		
		ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
			И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
		ОтражатьВУСНДоходыМинусРасходы = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
			И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаТаблицы.КФО);
		
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы,
			Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы,
				|ОтразитьВКарточкеКапвложений, КарточкаКапвложений",
				ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы,
				СтрокаТаблицы.ОтразитьВКарточкеКапвложений, СтрокаТаблицы.КарточкаКапвложений));
		
		ОграниченияОперации = ПолучитьОграниченияОперации(СтрокаТаблицы.ВидОперации, "Счет");
		ОтражениеВУчетеДоступность = Не (ТипЗнч(ОграниченияОперации)=Тип("Массив") И ОграниченияОперации.Количество()=0);
		СтрокаТаблицы.ОтражениеВУчетеДоступность = ОтражениеВУчетеДоступность;
		
		Если Не ОтражениеВУчетеДоступность Тогда
			СтрокаТаблицы.Счет          = Неопределено;
			СтрокаТаблицы.Субконто1     = Неопределено;
			СтрокаТаблицы.Субконто2     = Неопределено;
			СтрокаТаблицы.Субконто3     = Неопределено;
			СтрокаТаблицы.ОтражениеВУСН = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОграниченияОперации(ВидОперации, Ограничение)
	
	Если ВидОперации["Все" + Ограничение] Тогда
		Возврат Неопределено;
	Иначе
		Возврат ВидОперации["Ограничения" + Ограничение].ВыгрузитьКолонку(Ограничение);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.Операции.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("КПС", ?(ЗначениеЗаполнено(ДанныеСтроки.КПССчет),ДанныеСтроки.КПССчет, ДанныеСтроки.КПС));
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      Истина);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.Субконто1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.Субконто2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.Субконто3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет расходов'"));
	
	МассивСчетов = ПолучитьОграниченияОперации(ДанныеСтроки.ВидОперации, "Счет");
	Если ТипЗнч(МассивСчетов) = Тип("Массив") Тогда
		Если МассивСчетов.Количество() > 0 Тогда
			ПараметрыСчета = Новый Структура;
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", МассивСчетов);
			ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
			ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	// УСН
	ПараметрыФормы.Вставить("ОтражениеВУСН", ДанныеСтроки.ОтражениеВУСН);
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И ДанныеСтроки.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_Разные") Тогда
		 // Для прочих удержаний не нужно показывать реквизит "Расходы (УСН)", порядок отражения в УСН определяется начислением.
		ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	КонецЕсли;
	
	// Карточка капвложений
	ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,,"КПС,КЭК"); // КФО и пр.
	ТекущиеДанные.КПССчет = СтруктураОтражениеВУчете.КПС;
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	ОтражатьВУСНДоходыМинусРасходы = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(ТекущиеДанные.КФО);
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные,
		Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы,
			|ОтразитьВКарточкеКапвложений, КарточкаКапвложений",
			ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы,
			ТекущиеДанные.ОтразитьВКарточкеКапвложений, ТекущиеДанные.КарточкаКапвложений));
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКорректностьКФО()
	
	ДопустимыеКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(
		Объект.Организация, Объект.ИФО, ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
	
	Для Каждого Стр Из Объект.Операции Цикл
		
		Если ДопустимыеКФО.Найти(Стр.КФО) = Неопределено Тогда
			Стр.КФО = Перечисления.КВД.ПустаяСсылка();
		Конецесли;
		
	КонецЦикла
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеПодразделений(Отказ, ТекущийОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЧОперации.НомерСтроки КАК НомерСтроки,
	               |	ТЧОперации.Счет КАК Счет,
	               |	ТЧОперации.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ТЧОперации
	               |ИЗ
	               |	&ТЧОперации КАК ТЧОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧОперации.НомерСтроки
	               |ИЗ
	               |	ТЧОперации КАК ТЧОперации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ПО ТЧОперации.Счет = ЕПСБУ.Ссылка
	               |ГДЕ
	               |	ТЧОперации.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	И ЕПСБУ.УчетПоПодразделениям
	               |	И НЕ ЕПСБУ.РазрешитьНеУказыватьПодразделение";
	Запрос.УстановитьПараметр("ТЧОперации", ТекущийОбъект.Операции.Выгрузить(, "НомерСтроки, Счет, Подразделение"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Не установлено подразделение в строке %1.'");
		
		Для Каждого Стр Из Результат Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Стр.НомерСтроки),
						ТекущийОбъект,
						"Операции[" + (Стр.НомерСтроки - 1) + "].Подразделение");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ИмпортированИзЗГУ = Объект.ИмпортированИзЗГУ;
	УчетПоИФО            = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
	УчетПоПодразделениям = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям;
	
	Элементы.ИФО.Видимость = (Не ИмпортированИзЗГУ) И УчетПоИФО;
	
	Элементы.ОперацииИФО.Видимость = ИмпортированИзЗГУ И УчетПоИФО;
	
	Элементы.ОперацияЗарплата.Видимость = ИмпортированИзЗГУ;
	
	Элементы.ОперацииЗаполнить.Видимость = ИмпортированИзЗГУ;
	
	Элементы.ОперацииПодразделение.Видимость = УчетПоПодразделениям;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	//---
	// Вид операции ЗП_Удержания_Разные
	//---

	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Операции.ВидОперации");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	Условие.ПравоеЗначение = Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_Разные;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// Оформляемое поле
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОперацииЯвляетсяОснованиемОформленияКассовогоЧека");
	
	Элементы.ОперацииПодразделение.АвтоОтметкаНезаполненного = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям;
	
	//---
	// Оформляемое поле ОперацииНалог
	//---
	
	СписокВидовОпераций = Новый СписокЗначений;
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛ);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛПередачаЗадолженностиВНалоговыйОрган);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛСПревышения);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_ЕдиныйСтраховойТариф);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛп61ст210ПоСтавке13);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛп61ст210ПоСтавке15);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛРКСН);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛРКСНПоСтавке15);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛСПревышенияПоСтавке18);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛСПревышенияПоСтавке20);
	СписокВидовОпераций.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты. ЗП_Удержания_НДФЛСПревышенияПоСтавке22);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОперацииНалог.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Операции.ВидОперации", ВидСравненияКомпоновкиДанных.НеВСписке, СписокВидовОпераций);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//---
	// Оформляемое поле ОперацииСуммаНУ
	//---
	СписокКФОдляНалоговогоУчета = Новый СписокЗначений;
	СписокКФОдляНалоговогоУчета.ЗагрузитьЗначения(НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	СписокКФОдляНалоговогоУчета.Добавить(Перечисления.КВД.ПустаяСсылка());
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОперацииСуммаНУ.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Операции.КФО", ВидСравненияКомпоновкиДанных.НЕВСписке, СписокКФОдляНалоговогоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	//---
	// Оформляемое поле ОперацииВидНалога
	//---
	
	СписокВидовОперацийФонды = ПолучитьВидыОперацийФонды();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОперацииВидНалога.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Объект.Операции.ВидОперации", ВидСравненияКомпоновкиДанных.НеВСписке, СписокВидовОперацийФонды);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаСервере
Функция НалогСборПлатежПоУмолчанию(Организация, ВидНалога)
	
	Возврат Документы.ОтражениеЗарплатыВУчете.НалогСборПлатежПоУмолчанию(Организация, ВидНалога);
	
КонецФункции

&НаКлиенте
Процедура КФОПриИзменении(ТекущиеДанные)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   ТекущиеДанные.КФО,
											   Объект.Дата,
											   ТекущиеДанные.КПС,
											   Неопределено);
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
		ТекущиеДанные.СуммаНУ     = 0;
	КонецЕсли;
	
	ОтражатьВУСНДоходыМинусРасходы = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВУСНДоходыМинусРасходы Тогда
		ТекущиеДанные.ОтражениеВУСН = Неопределено;
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные,
		Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН,
			|ОтразитьВКарточкеКапвложений, КарточкаКапвложений",
			ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы, 
			ТекущиеДанные.ОтразитьВКарточкеКапвложений, ТекущиеДанные.КарточкаКапвложений));
		
	КонецПроцедуры

Функция ПолучитьВидыОперацийФонды() Экспорт
	
	СписокВидовОпераций = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыОперацийОтраженияЗарплаты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВидыОперацийОтраженияЗарплаты КАК ВидыОперацийОтраженияЗарплаты
	               |ГДЕ
	               |	ВидыОперацийОтраженияЗарплаты.ЭтоВзносы";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		СписокВидовОпераций.Добавить(Результат.Ссылка);
	КонецЦикла;
	
	Возврат  СписокВидовОпераций;
	
КонецФункции

