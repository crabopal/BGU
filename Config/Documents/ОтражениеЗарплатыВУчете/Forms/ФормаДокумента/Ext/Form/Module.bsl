Процедура ВидОперацииПриИзменении(Элемент)
	
	ВидОперацииПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзмененииНаКлиенте()
	
	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;
	
	ТекущиеДанные.Счет        = Неопределено;
	ТекущиеДанные.КФО         = Неопределено;
	ТекущиеДанные.КПС         = Неопределено;
	ТекущиеДанные.Субконто1   = Неопределено;
	ТекущиеДанные.Субконто2   = Неопределено;
	ТекущиеДанные.Субконто3   = Неопределено;
	ТекущиеДанные.СчетНУ      = Неопределено;
	ТекущиеДанные.СубконтоНУ1 = Неопределено;
	ТекущиеДанные.СубконтоНУ2 = Неопределено;
	ТекущиеДанные.СубконтоНУ3 = Неопределено;
	ТекущиеДанные.Налог       = Неопределено;
	ТекущиеДанные.ВидНалога   = Неопределено;
	ТекущиеДанные.ОтражениеВУчете = "<...>";
	ТекущиеДанные.ОтражениеВУчетеЗаполнено = Ложь;
	
	ОграниченияОперации = ПолучитьОграниченияОперации(ТекущиеДанные.ВидОперации, "Счет");
	ТекущиеДанные.ОтражениеВУчетеДоступность = Не (ТипЗнч(ОграниченияОперации)=Тип("Массив") И ОграниченияОперации.Количество()=0);
	
	Если Объект.ИмпортированИзЗГУ И ЗначениеЗаполнено(ТекущиеДанные.ВидОперацииПоЗарплатеЗГУ) И ЗначениеЗаполнено(ТекущиеДанные.ВидОперации) Тогда
		Если Не ЕстьСоответствиеОпераций(ТекущиеДанные.ВидОперацииПоЗарплатеЗГУ, ТекущиеДанные.ВидОперации) Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидОперацииЗГУ", ТекущиеДанные.ВидОперацииПоЗарплатеЗГУ);
			ДопПараметры.Вставить("ВидОперации", ТекущиеДанные.ВидОперации);
			
			Оповещение = Новый ОписаниеОповещения("ВопросУстановкиСоответствияОпераций", ЭтотОбъект, ДопПараметры);
			
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru='Установить соответствие операций ""%1"" (ЗиКГУ) и ""%2"" (БГУ)?'"),
								ТекущиеДанные.ВидОперацииПоЗарплатеЗГУ,
								ТекущиеДанные.ВидОперации);
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		КонецЕсли;
	КонецЕсли;
	
	ВидОперацииПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.Операции.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ТекущиеДанные.ВидОперации.ЭтоВзносы Тогда
		ВидНалога = ТекущиеДанные.ВидОперации.ВидНалога;
		
		ТекущиеДанные.Налог = НалогСборПлатежПоУмолчанию(Объект.Организация, ВидНалога);
		ТекущиеДанные.ВидНалога = ВидНалога;
	КонецЕсли;
	
КонецПроцедуры

