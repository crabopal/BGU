&НаКлиенте
Процедура ОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ОперацииОтражениеВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОперацииПриАктивизацииЯчейки(Элемент)

	Если Элементы.Операции.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.Операции.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ОперацииОтражениеВУчете"
			И НЕ Элементы.Операции.ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.Операции.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОперацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ЭтоНоваяСтрока = НоваяСтрока;

	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = Элементы.Операции.ТекущиеДанные;
	СтрокаТаблицы.ОтражениеВУчете = "<...>";

КонецПроцедуры

