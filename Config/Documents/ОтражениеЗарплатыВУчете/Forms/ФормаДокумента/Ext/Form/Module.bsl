&НаКлиенте
Процедура ОперацииКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;
	
	ОграниченияКЭК = ПолучитьОграниченияОперации(ТекущиеДанные.ВидОперации, "КЭК");
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭК,
								Объект.Организация, 
								Объект.ИФО,
								ТекущиеДанные.КФО, 
								Неопределено,
								Объект.Дата,
								Неопределено,
								ОграниченияКЭК,
								Истина,
								Неопределено);
								
								
	
КонецПроцедуры

&НаКлиенте
Процедура ОперацииДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("Контрагент", Элементы.Операции.ТекущиеДанные.Контрагент);
	
	ОтборВид = Новый СписокЗначений;
	ОтборВид.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ИноеОбязательство"));
	ОтборВид.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));

	Отбор.Вставить("ВидДоговора", ОтборВид);
	
	Отбор.Вставить("ДоговорЗаключен", Истина);
	
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.Договоры.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОперацииОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
