
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет документ данными для отражения в бюджетном учете
// при программном создании и заполнении документа.
//
Процедура ЗаполнитьДанныеДляБюджетногоУчета(Контрагент) Экспорт
		
	// Заполняем вид первичного документа
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидПервичногоДокумента) Тогда	
		ЭтотОбъект.ВидПервичногоДокумента = "Платежная ведомость";
	КонецЕсли;
	
	ЭтотОбъект.Записать();
	
	//Заполняем типовую операцию
	ЗаполнитьСвойстваТиповойОперации(Контрагент);
	
КонецПроцедуры

Процедура ДополнитьДанныеТабличнойЧасти(Контрагент, ВыгруженыДанныеСотрудников = Неопределено) Экспорт
	
	Запрос = Новый Запрос;                                    
	Запрос.УстановитьПараметр("НаДату", ЭтотОбъект.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СпособОтраженияЗарплатыВБухУчете КАК СпособОтражения,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.Организация КАК Организация,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.КодНалоговогоОргана КАК КодНалоговогоОргана,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.ВидОперации КАК ВидОперацииЗГУ,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СчетДт КАК Счет,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.Субконто1 КАК Субконто1,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.Субконто2 КАК Субконто2,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.Субконто3 КАК Субконто3,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СчетНУ КАК СчетНУ,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СубконтоНУ1 КАК СубконтоНУ1,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СубконтоНУ2 КАК СубконтоНУ2,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.СубконтоНУ3 КАК СубконтоНУ3,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.ОтражениеВУСН КАК ОтражениеВУСН,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.НеИспользоватьВходящиеДанныеЗГУ КАК НеИспользоватьВходящиеДанныеЗГУ,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.КодЦели КАК КодЦели,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.КодМероприятия КАК КодМероприятия,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних.ДопКлассификация КАК ДопКлассификация
	               |ИЗ
	               |	РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СрезПоследних(&НаДату, ) КАК НастройкаСпособовОтраженияЗарплатыВБухУчетеСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗГУ,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.Организация КАК Организация,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.ВидОперации КАК ВидОперацииЗГУ,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.КЭК КАК КЭКСтатьи,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.ИФО КАК ИФО,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.КФО КАК КФО,
	               |	НастройкаСтатейФинансированияЗарплатаСрезПоследних.КПС КАК КПС
	               |ИЗ
	               |	РегистрСведений.НастройкаСтатейФинансированияЗарплата.СрезПоследних(&НаДату, ) КАК НастройкаСтатейФинансированияЗарплатаСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ КАК ОперацияЗГУ,
	               |	СоответствиеОперацийУчетаЗарплаты.ОперацияБГУ КАК ОперацияБГУ
	               |ИЗ
	               |	РегистрСведений.СоответствиеОперацийУчетаЗарплаты КАК СоответствиеОперацийУчетаЗарплаты";
	
	Результат = Запрос.ВыполнитьПакет();
	
	НастройкаСпОтр = Результат[0].Выгрузить();
	НастройкаСпОтр.Индексы.Добавить("СпособОтражения,Организация,КодНалоговогоОргана,ВидОперацииЗГУ");
	
	НастройкаСтФин = Результат[1].Выгрузить();
	НастройкаСтФин.Индексы.Добавить("СтатьяФинансированияЗГУ,Организация,ВидОперацииЗГУ,КЭКСтатьи");
	
	СоответствиеОпераций = Результат[2].Выгрузить();
	СоответствиеОпераций.Индексы.Добавить("ОперацияЗГУ,ОперацияБГУ");
	
	ФизическоеЛицо = ?(ЗначениеЗаполнено(Контрагент), Контрагент.ЮридическоеФизическоеЛицо, Справочники.ФизическиеЛица.ПустаяСсылка());
	
	КЭК213 = Справочники.КОСГУ.НайтиПоКоду("213");
	КЭК210 = БухгалтерскийУчет.СписокКЭК("210");
	
	ВидыОперацийФонды = Документы.ОтражениеЗарплатыВУчете.ПолучитьВидыОперацийФонды();
	
	ВыгруженыДанныеСотрудников = ?(ВыгруженыДанныеСотрудников = Неопределено, Ложь, ВыгруженыДанныеСотрудников);
	
	Если ВыгруженыДанныеСотрудников Тогда
		МассивФизЛиц = ЭтотОбъект.Операции.ВыгрузитьКолонку("ФизическоеЛицо");
		
		ЗапросКонтрагент = Новый Запрос;
		ЗапросКонтрагент.УстановитьПараметр("МассивФизЛиц", МассивФизЛиц);
		ЗапросКонтрагент.Текст = "ВЫБРАТЬ
		                         |	Контрагенты.Ссылка КАК Контрагент,
		                         |	Контрагенты.ЮридическоеФизическоеЛицо КАК ФизическоеЛицо 
		                         |ИЗ
		                         |	Справочник.Контрагенты КАК Контрагенты
		                         |ГДЕ
		                         |	Контрагенты.ЮридическоеФизическоеЛицо В(&МассивФизЛиц)";
		ТаблицаКонтрагент = ЗапросКонтрагент.Выполнить().Выгрузить();
	КонецЕсли;
	
	ВидыОперацийМассив = Новый Массив;
	ВидыОперацийМассив.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_Разные);
	ВидыОперацийМассив.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_ПФРДополнительная);
	
	Для Каждого СтрокаОперации Из ЭтотОбъект.Операции Цикл
		
		Если Не ВыгруженыДанныеСотрудников Тогда
			Если Не ЗначениеЗаполнено(СтрокаОперации.Контрагент) Тогда
				СтрокаОперации.ФизическоеЛицо = ФизическоеЛицо;
				СтрокаОперации.Контрагент = Контрагент;
			КонецЕсли;
		ИначеЕсли ТаблицаКонтрагент <> Неопределено Тогда
			НайденнаяСтрока = ТаблицаКонтрагент.Найти(СтрокаОперации.ФизическоеЛицо, "ФизическоеЛицо");
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаОперации.Контрагент = НайденнаяСтрока.Контрагент;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ОперацияЗГУ", СтрокаОперации.ВидОперацииПоЗарплате);
		
		СтрокаСоответствиеОпераций = СоответствиеОпераций.НайтиСтроки(СтруктураОтбора);
		Если СтрокаСоответствиеОпераций.Количество() > 0 Тогда
			СтрокаОперации.ВидОперации = СтрокаСоответствиеОпераций[0].ОперацияБГУ;
		КонецЕсли;
		
		Если КЭК210.Найти(СтрокаОперации.КЭК) <> Неопределено 
			И ВидыОперацийФонды.Найти(СтрокаОперации.ВидОперацииПоЗарплате) <> Неопределено Тогда
			СтрокаОперации.КЭК = КЭК213;
		КонецЕсли;
		
		СтруктураОтбораСтФин = Новый Структура;
		СтруктураОтбораСтФин.Вставить("СтатьяФинансированияЗГУ",СтрокаОперации.СтатьяФинансированияЗарплата);
		СтруктураОтбораСтФин.Вставить("Организация", ЭтотОбъект.Организация);
		СтруктураОтбораСтФин.Вставить("ВидОперацииЗГУ", СтрокаОперации.ВидОперацииПоЗарплате);
		СтруктураОтбораСтФин.Вставить("КЭКСтатьи", СтрокаОперации.КЭК);
		
		СтрокаСтФин = Документы.ОтражениеЗарплатыВУчете.НайтиСтрокуСтФин(СтруктураОтбораСтФин, НастройкаСтФин);
		
		Если СтрокаСтФин.Количество() = 0 Тогда
			Если СтрокаОперации.ВидОперацииПоЗарплате = Перечисления.ВидыОперацийПоЗарплате.НДФЛ 
			И СтрокаОперации.КЭК = КЭК213 Тогда
				СтруктураОтбораСтФин.СтатьяФинансированияЗГУ = Справочники.СтатьиФинансированияЗарплата.УдержанияИзСредствФСС;
				СтрокаСтФин = Документы.ОтражениеЗарплатыВУчете.НайтиСтрокуСтФин(СтруктураОтбораСтФин, НастройкаСтФин);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаСтФин.Количество() = 0 Тогда 
			СтруктураОтбораСтФин.КЭКСтатьи = Справочники.КОСГУ.ПустаяСсылка();
			СтрокаСтФин = Документы.ОтражениеЗарплатыВУчете.НайтиСтрокуСтФин(СтруктураОтбораСтФин, НастройкаСтФин);
		КонецЕсли;
		
		Если СтрокаСтФин.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаОперации, СтрокаСтФин[0]);
		КонецЕсли;
		
		СтруктураОтбораСпОтр = Новый Структура;
		Если СтрокаОперации.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.ПустаяСсылка()
			И СтрокаОперации.ВидОперацииПоЗарплате = Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЗаЗадержкуЗарплаты Тогда
			СтрокаОперации.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.КомпенсацияЗаЗадержкуЗарплаты;
		ИначеЕсли СтрокаОперации.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.ПустаяСсылка()
			И СтрокаОперации.ВидОперацииПоЗарплате = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФСС Тогда
			СтрокаОперации.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.РасходыПоСтрахованиюФСС;
		КонецЕсли;
		
		СтруктураОтбораСпОтр.Вставить("СпособОтражения", СтрокаОперации.СпособОтраженияЗарплатыВБухУчете);
		СтруктураОтбораСпОтр.Вставить("Организация", ЭтотОбъект.Организация);
		СтруктураОтбораСпОтр.Вставить("ВидОперацииЗГУ", СтрокаОперации.ВидОперацииПоЗарплате);
		СтруктураОтбораСпОтр.Вставить("КодНалоговогоОргана", СтрокаОперации.НДФЛКодНалоговогоОргана);
		
		СтрокаСпОтр = НастройкаСпОтр.НайтиСтроки(СтруктураОтбораСпОтр);
		
		Если СтрокаСпОтр.Количество() = 0 Тогда 
			СтруктураОтбораСпОтр.КодНалоговогоОргана = "";
			СтрокаСпОтр = НастройкаСпОтр.НайтиСтроки(СтруктураОтбораСпОтр);
		КонецЕсли;
		
		Если СтрокаСпОтр.Количество() > 0 Тогда
			
			СписокСвойств = "Счет,Субконто1,Субконто2,Субконто3";
			
			Если ЗначениеЗаполнено(СтрокаОперации.Субконто1) И Не СтрокаСпОтр[0].НеИспользоватьВходящиеДанныеЗГУ Тогда
				СписокСвойств = "Счет,Субконто2,Субконто3";
			КонецЕсли;
			
			Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ЭтотОбъект.Организация, ЭтотОбъект.Дата, СтрокаОперации.КФО) Тогда
				СписокСвойств = СписокСвойств + ",СчетНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,ОтражениеВУСН";
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаОперации, СтрокаСпОтр[0],СписокСвойств);
			
		КонецЕсли;
		
		Если ТипЗнч(СтрокаОперации.Субконто2) = Тип("СправочникСсылка.НалогиИПлатежиОрганизации") И ЗначениеЗаполнено(СтрокаОперации.Субконто2) Тогда
			СтрокаОперации.Налог = Справочники.НалогиИПлатежиОрганизации.ПустаяСсылка();
		Иначе
			СтрокаОперации.Налог = Документы.ОтражениеЗарплатыВУчете.НалогСборПлатежПоУмолчанию(ЭтотОбъект.Организация, СтрокаОперации.ВидОперации.ВидНалога);
			СтрокаОперации.ВидНалога = СтрокаОперации.ВидОперации.ВидНалога;
		КонецЕсли;
		
		ВидОперации = СтрокаОперации.ВидОперации;
		
		Если ВидыОперацийМассив.Найти(ВидОперации) <> Неопределено И ЗначениеЗаполнено(СтрокаОперации.Счет) Тогда
			ЗаполнитьОграниченияОперацииОтраженияЗп(ВидОперации, СтрокаОперации.Счет);
		КонецЕсли;
		
	КонецЦикла;
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	КолонкиГруппировки = "Подразделение,
			               |ИФО,
			               |ФизическоеЛицо,
			               |ВидОперацииПоЗарплатеЗГУ,
			               |ВидОперацииПоЗарплате,
			               |СтатьяФинансированияЗарплата,
			               |СпособОтраженияЗарплатыВБухУчете,
			               |ПериодПринятияРасходов,
			               |ВидНачисленияОплатыТрудаДляНУ,
			               |ОблагаетсяЕНВД,
			               |НДФЛКодПоОКТМО,
			               |НДФЛКПП,
			               |НДФЛКодНалоговогоОргана,
			               |ВидОперации,
			               |КФО,
			               |КПС,
			               |КЭК,
			               |Счет,
			               |Субконто1,
			               |Субконто2,
			               |Субконто3,
			               |Контрагент,
			               |Договор,
			               |СчетНУ,
			               |СубконтоНУ1,
			               |СубконтоНУ2,
			               |СубконтоНУ3,
			               |ОтражениеВУСН,
			               |ЯвляетсяОснованиемОформленияКассовогоЧека,
			               |КЭКСчет,
			               |ВидНалога,
			               |Налог,
			               |КодЦели,
			               |КодМероприятия,
			               |ДопКлассификация";
	
	Если Не УчетПоПодразделениям Тогда
		КолонкиГруппировки = СтрЗаменить(КолонкиГруппировки, "Подразделение,", "");
	КонецЕсли;
	
	Если Не УчетПоИФО Тогда
		КолонкиГруппировки = СтрЗаменить(КолонкиГруппировки, "ИФО,", "");
	КонецЕсли;
	
	ЭтотОбъект.Операции.Свернуть(КолонкиГруппировки, "Сумма, СуммаНУ");
	
	ЭтотОбъект.ИмпортированИзЗГУ = Истина;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиИсполнителяЭтапа");
	
	ЭтотОбъект.Записать();
	
	ЗаполнитьСвойстваТиповойОперации(Контрагент);
КонецПроцедуры

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если Не ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИФО");
		МассивНепроверяемыхРеквизитов.Добавить("Операции.ИФО");
	ИначеЕсли ЭтотОбъект.ИмпортированИзЗГУ Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИФО");
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Операции.ИФО");
	КонецЕсли;
	
	Если Не ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
		МассивНепроверяемыхРеквизитов.Добавить("Операции.Подразделение");
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
		ПроверятьПодразделениеВТаблице = ПроверитьЗаполнениеПодразделений();
		Если Не ПроверятьПодразделениеВТаблице Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Операции.Подразделение");
		КонецЕсли;
	КонецЕсли;
		
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ИмпортированИзЗГУ Тогда
		// Установим ИФО и Подразделение из шапки в строки табличной части.
		// В импортированных из ЗГУ документах ИФО и Подразделение уже в табличной части.
		// При формировании проводок используются ИФО и Подразделение только из табличной части.
		Для Каждого СтрокаТаблицы Из Операции Цикл
			СтрокаТаблицы.ИФО = ИФО;
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) И ЗначениеЗаполнено(Подразделение) Тогда
				СтрокаТаблицы.Подразделение = Подразделение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Операции.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИфункции

Процедура ЗаполнитьСвойстваТиповойОперации(Контрагент = Неопределено)
	
	Если Контрагент = Неопределено Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запись = РегистрыСведений.ОперацииДокументов.СоздатьМенеджерЗаписи();
	Запись.Документ = ЭтотОбъект.Ссылка;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ДанныеДляЗаписи = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(Ссылка);
		ДанныеДляЗаписи.Операция    = Справочники.ТиповыеОперации.ОтражениеЗарплатыВУчете_ОтражениеЗарплаты;
		ДанныеДляЗаписи.Организация = Организация;
		ДанныеДляЗаписи.Дата        = Дата;
		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(Ссылка, ДанныеДляЗаписи);
	КонецЕсли;
	
	//Заполняем реквизит типовой операции
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &Ссылка
	|	И РеквизитыТиповыхОпераций.РеквизитПроводки = &РеквизитПроводки";
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.ТиповыеОперации.ОтражениеЗарплатыВУчете_ОтражениеЗарплаты);	
	Запрос.УстановитьПараметр("РеквизитПроводки", ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Контрагенты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда     
		
		Запись = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьМенеджерЗаписи();
		Запись.Объект = ЭтотОбъект.Ссылка;
		Запись.РеквизитОперации = Выборка.Ссылка;
		Запись.Прочитать();
		Если Не (Запись.Выбран() И ЗначениеЗаполнено(Запись.Значение)) Тогда
			Запись.Объект = ЭтотОбъект.Ссылка;
			Запись.РеквизитОперации = Выборка.Ссылка;
			Запись.Значение = Контрагент;
			Запись.Записать();
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьОграниченияОперацииОтраженияЗп(ВидОперации, Счет)
	
	Если Не ВидОперации.ВсеСчет И ВидОперации.ОграниченияСчет.Найти(Счет, "Счет") = Неопределено Тогда
		Попытка
	  		НачатьТранзакцию();

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ВидыОперацийОтраженияЗарплаты");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ВидОперации);
			Блокировка.Заблокировать();
			
			ОбъектВидОперации = ВидОперации.ПолучитьОбъект();
	        ОбъектВидОперации.ОграниченияСчет.Добавить().Счет = Счет;
	         			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектВидОперации);
				
			ЗафиксироватьТранзакцию();
	 	Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось обработать вид операции отражения зарплаты: ""%1"" по причине: %2'"), 
				ВидОперации, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			СобытиеЖурналаРегистрации = ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации();
			ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ВидыОперацийОтраженияЗарплаты, ВидОперации, ТекстСообщения,
			РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьЗаполнениеПодразделений()
	
	ПроверятьПодразделениеВТаблице = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЧОперации.НомерСтроки КАК НомерСтроки,
	               |	ТЧОперации.Счет КАК Счет,
	               |	ТЧОперации.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ТЧОперации
	               |ИЗ
	               |	&ТЧОперации КАК ТЧОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧОперации.НомерСтроки
	               |ИЗ
	               |	ТЧОперации КАК ТЧОперации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ПО ТЧОперации.Счет = ЕПСБУ.Ссылка
	               |ГДЕ
	               |	ТЧОперации.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	И ЕПСБУ.УчетПоПодразделениям
	               |	И НЕ ЕПСБУ.РазрешитьНеУказыватьПодразделение";
	Запрос.УстановитьПараметр("ТЧОперации", ЭтотОбъект.Операции.Выгрузить(, "НомерСтроки, Счет, Подразделение"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		ПроверятьПодразделениеВТаблице = Ложь;
	КонецЕсли;
	
	Возврат ПроверятьПодразделениеВТаблице;
	
КонецФункции

#КонецОбласти

#КонецЕсли