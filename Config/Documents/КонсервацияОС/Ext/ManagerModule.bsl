#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "МоментВремени,Организация");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"		, Новый Граница(ЗначенияРеквизитов.МоментВремени, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"	, ЗначенияРеквизитов.Организация);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.Ссылка.ВидОперации > 0 КАК НачислятьАмортизацию,
	|	""Акт"" КАК ВидПервичногоДокумента,
	|	ОсновныеСредства.Ссылка.Дата КАК ДатаПервичногоДокумента,
	|	ОсновныеСредства.Ссылка.Номер КАК НомерПервичногоДокумента,
	|	ИСТИНА КАК Консервация,
	|	ОсновныеСредства.Срок КАК СрокПриостановки
	|ИЗ
	|	Документ.КонсервацияОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.Ссылка.ВидОперации < 2";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	""Акт"" КАК НазваниеДокумента,
	|	ОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ОсновныеСредства.Ссылка.Номер КАК НомерДокумента,
	|	ОсновныеСредства.Ссылка.Причина КАК Причина,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.ВидОперации = 2
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Консервация)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Расконсервация)
	|	КОНЕЦ КАК Событие
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.КонсервацияОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.Ссылка.ВидОперации >= 2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ КАК ВТ)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Период КАК Период,
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ.НазваниеДокумента КАК НазваниеДокумента,
	|	ВТ.ДатаДокумента КАК ДатаДокумента,
	|	ВТ.НомерДокумента КАК НомерДокумента,
	|	ВТ.Событие КАК Событие,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ВТ.Причина КАК Причина
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ВТ.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.КонсервацияОС";
	КомандаПечати.Идентификатор		= "АктКонсервации";
	КомандаПечати.Представление		= НСтр("ru = 'Акт консервации (расконсервации)'");
	КомандаПечати.ЗаголовокФормы	= НСтр("ru = 'Печать акта консервации (расконсервации)'");
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктКонсервации") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктКонсервации", "Акта консервации (расконсервации)",
			ПечатьАктаКонсервации(МассивОбъектов, ПараметрыПечати, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьАктаКонсервации(МассивОбъектов, ПараметрыПечати, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.КлючПараметровПечати = "ПараметрыПечати_АктКонсервации";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.КонсервацияОС.ПФ_MXL_АктКонсервации");
	
	Области = Новый Структура;
	Области.Вставить("Шапка"			, Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("Причина"			, Макет.ПолучитьОбласть("Причина"));
	Области.Вставить("ШапкаТаблицы"		, Макет.ПолучитьОбласть("ШапкаТаблицы"));
	Области.Вставить("Строка"			, Макет.ПолучитьОбласть("Строка"));
	Области.Вставить("ЗаключениеШапка1"	, Макет.ПолучитьОбласть("ЗаключениеШапка1"));
	Области.Вставить("ЗаключениеШапка2"	, Макет.ПолучитьОбласть("ЗаключениеШапка2"));
	Области.Вставить("Заключение"		, Макет.ПолучитьОбласть("Заключение"));
	Области.Вставить("ЗаключениеПодвал1", Макет.ПолучитьОбласть("ЗаключениеПодвал1"));
	Области.Вставить("ЗаключениеПодвал2", Макет.ПолучитьОбласть("ЗаключениеПодвал2"));
	Области.Вставить("СоставКомиссии"	, Макет.ПолучитьОбласть("СоставКомиссии"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	Документ.Организация КАК ОрганизацияСсылка,
	|	ВЫБОР
	|		КОГДА Документ.Организация.НаименованиеПолное = """"
	|			ТОГДА Документ.Организация.Наименование
	|		ИНАЧЕ Документ.Организация.НаименованиеПолное
	|	КОНЕЦ КАК Организация,
	|	Документ.Организация.КодОКПО КАК ОКПО,
	|	Документ.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	Документ.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	Документ.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	Документ.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	Документ.ВидОперации = 0
	|		ИЛИ Документ.ВидОперации = 2 КАК ЭтоКонсервация,
	|	Документ.НомерОснованияДляАкта КАК НомерПриказа,
	|	Документ.ДатаОснованияДляАкта КАК ДатаПриказа,
	|	Документ.Мероприятия КАК Мероприятия,
	|	Документ.Причина КАК Причина
	|ИЗ
	|	Документ.КонсервацияОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Номер,
	|	Документ.Организация,
	|	ВЫБОР
	|		КОГДА Документ.Организация.НаименованиеПолное = """"
	|			ТОГДА Документ.Организация.Наименование
	|		ИНАЧЕ Документ.Организация.НаименованиеПолное
	|	КОНЕЦ,
	|	Документ.Организация.КодОКПО,
	|	Документ.ФамилияПредседателяКомиссии,
	|	Документ.ИмяПредседателяКомиссии,
	|	Документ.ОтчествоПредседателяКомиссии,
	|	Документ.ДолжностьПредседателяКомиссии,
	|	Документ.ВидОперации = 0
	|		ИЛИ Документ.ВидОперации = 2,
	|	Документ.НомерОснованияДляАкта,
	|	Документ.ДатаОснованияДляАкта,
	|	Документ.Мероприятия,
	|	Документ.Причина
	|ИЗ
	|	Документ.КонсервацияИК КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК Наименование,
	|	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.ИнвентарныйНомер) КАК ИнвентарныйНомер,
	|	ОсновныеСредства.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.Срок КАК Срок
	|ИЗ
	|	Документ.КонсервацияОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка,
	|	ОсновныеСредства.НомерСтроки,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ,
	|	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.ИнвентарныйНомер),
	|	ОсновныеСредства.БалансоваяСтоимость,
	|	ОсновныеСредства.СуммаАмортизации,
	|	ОсновныеСредства.Срок
	|ИЗ
	|	Документ.КонсервацияИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставКомиссии.Ссылка КАК Ссылка,
	|	СоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	СоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	СоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	СоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.КонсервацияОС.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	СоставКомиссии.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставКомиссии.Ссылка,
	|	СоставКомиссии.ДолжностьЧленаКомиссии,
	|	СоставКомиссии.ФамилияЧленаКомиссии,
	|	СоставКомиссии.ИмяЧленаКомиссии,
	|	СоставКомиссии.ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.КонсервацияИК.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	СоставКомиссии.Ссылка В(&МассивОбъектов)
	|ИТОГИ ПО
	|	Ссылка";
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка	= Результат[0].Выбрать();
	ВыборкаОС		= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия	= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		// Шапка
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаШапка.ОрганизацияСсылка, ВыборкаШапка.Дата);
		ФИОСтруктура = Новый Структура("Фамилия,Имя,Отчество", Руководитель.ОтветственноеЛицоФамилия,
		Руководитель.ОтветственноеЛицоИмя, Руководитель.ОтветственноеЛицоОтчество);
		ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ФИОСтруктура, Истина);
		
		ПараметрыШапки = Новый Структура;
		ПараметрыШапки.Вставить("Номер"				, ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер));
		ПараметрыШапки.Вставить("ДатаПриказа"		, Формат(ВыборкаШапка.ДатаПриказа, "ДЛФ=D; ДП='                  '"));
		ПараметрыШапки.Вставить("НомерПриказа"		, ?(ЗначениеЗаполнено(ВыборкаШапка.НомерПриказа), ВыборкаШапка.НомерПриказа, "           "));
		ПараметрыШапки.Вставить("ФИОРуководителя"	, ФИОРуководителя);
		ПараметрыШапки.Вставить("Префикс"			, ?(ВыборкаШапка.ЭтоКонсервация, "", "рас"));
		
		Области.Шапка.Параметры.Заполнить(ВыборкаШапка);
		Области.Шапка.Параметры.Заполнить(ПараметрыШапки);
		
		ТабДок.Вывести(Области.Шапка);
		
		// Причина
		
		Области.Причина.Параметры.Заполнить(ВыборкаШапка);
		ТабДок.Вывести(Области.Причина);
		
		// Таблица
		
		ТабДок.Вывести(Области.ШапкаТаблицы);
		
		ВыборкаОС.Сбросить();
		
		Если ВыборкаОС.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			
			ВыборкаОСДок = ВыборкаОС.Выбрать();
			
			Пока ВыборкаОСДок.Следующий() Цикл
				
				Области.Строка.Параметры.Заполнить(ВыборкаОСДок);
				ТабДок.Вывести(Области.Строка);
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Заключение
		
		ОбластьЗаключениеШапка = ?(ВыборкаШапка.ЭтоКонсервация, Области.ЗаключениеШапка1,  Области.ЗаключениеШапка2);
		ОбластьЗаключениеШапка.Параметры.Заполнить(ПараметрыШапки);
		ТабДок.Вывести(ОбластьЗаключениеШапка);
		
		УправлениеПечатьюБГУ.ВывестиДлиннуюСтроку(ВыборкаШапка.Мероприятия, ТабДок, Области.Заключение,, 2);
		ОбластьЗаключениеПодвал = ?(ВыборкаШапка.ЭтоКонсервация, Области.ЗаключениеПодвал1, Области.ЗаключениеПодвал2);
		ТабДок.Вывести(ОбластьЗаключениеПодвал);
		
		// Комиссия
		
		ВыборкаКомиссия.Сбросить();
		
		Если ВыборкаКомиссия.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			ВыборкаКомиссияДок = ВыборкаКомиссия.Выбрать();
		Иначе
			ВыборкаКомиссияДок = Неопределено;
		КонецЕсли;
		
		Комиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(ВыборкаШапка, ВыборкаКомиссияДок, Области.СоставКомиссии);
		ТабДок.Вывести(Комиссия);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

#КонецЕсли
