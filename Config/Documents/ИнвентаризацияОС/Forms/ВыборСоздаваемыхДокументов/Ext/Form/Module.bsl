
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Отказ = Не ЭтоАдресВременногоХранилища(Параметры.АдресВХранилище);	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("Организация"				, Организация);
	Параметры.Свойство("СчетУчета"					, СчетУчета);
	Параметры.Свойство("ВидДокументов"				, ВидДокументов);
	Параметры.Свойство("АдресВХранилище"			, АдресВХранилище);
	Параметры.Свойство("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);
	Параметры.Свойство("Контрагент"					, Контрагент);
	
	Дерево = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	ВидыДокументов = Новый Массив;
	
	Для Каждого ТекСтр Из Дерево.Строки Цикл
	
		НовСтр = ДеревоДокументов.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр);
		
		ПерваяСтрока = Истина;
		КоличествоПоДокументу = 0;
		СуммаПоДокументу = 0;
		ЕстьВключенные = Ложь;
		ЕстьВыключенные = Ложь;
		Для Каждого ТекВложСтр Из ТекСтр.Строки Цикл
			
			Если ПерваяСтрока Тогда
				ЗаполнитьЗначенияСвойств(НовСтр, ТекВложСтр, "ИФО,КФО,КПС,Подразделение,Счет,ОсновноеСредство,ИнвентарныйНомер,ВидДокумента,Цена,ПолноеИмяДокумента,ЦМО,ИмяДокумента");
			Иначе
				НовСтр.ИнвентарныйНомер = Неопределено;	
			КонецЕсли;
		
			НовВложСтр = НовСтр.ПолучитьЭлементы().Добавить();
			НовВложСтр.НомерСтрокиДокумента = ТекВложСтр.НомерСтроки;
			ЗаполнитьЗначенияСвойств(НовВложСтр, ТекВложСтр);
			
			КоличествоПоДокументу = КоличествоПоДокументу + ТекВложСтр.Количество;
			СуммаПоДокументу = СуммаПоДокументу + ТекВложСтр.Сумма;
			
			НовВложСтр.Пометка = ВозможнаяПометкаСтроки(ТекВложСтр, 1);
			
			Если НовВложСтр.Пометка = 1 Тогда
				ЕстьВключенные = Истина;
			Иначе
				ЕстьВыключенные = Истина;
			КонецЕсли;
			
			Если ВидыДокументов.Найти(ТекВложСтр.ИмяДокумента) = Неопределено Тогда
				ВидыДокументов.Добавить(ТекВложСтр.ИмяДокумента);
			КонецЕсли;
			
		КонецЦикла;
		НовСтр.Количество = КоличествоПоДокументу;
		НовСтр.Сумма = СуммаПоДокументу;
		
		НовСтр.Пометка = ?(ЕстьВключенные, ?(ЕстьВыключенные, 2, 1), 0);
	
	КонецЦикла;
	
	Элементы.ДеревоДокументовПодразделение.Видимость = ВестиУчетПоПодразделениям;
	
	ЗаполнитьТиповыеОперацииДокументов(ВидыДокументов);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДокументов

&НаКлиенте
Процедура ДеревоДокументовПометкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	НовЗначениеПометки = ?(ТекущиеДанные.Пометка = 2, 0, ТекущиеДанные.Пометка);   
	//ТекущиеДанные.Пометка = НовЗначениеПометки;
	Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
		ЕстьВключенные = Ложь;
		ЕстьВыключенные = Ложь;
		Для каждого ТекСтр Из ТекущиеДанные.ПолучитьЭлементы() Цикл
		
			ТекСтр.Пометка = ВозможнаяПометкаСтроки(ТекСтр, НовЗначениеПометки);
			Если ТекСтр.Пометка = 1 Тогда
				ЕстьВключенные = Истина;                       
			Иначе
				ЕстьВыключенные = Истина;
			КонецЕсли;
		
		КонецЦикла; 
		ТекущиеДанные.Пометка = ?(ЕстьВключенные, ?(ЕстьВыключенные, 2, 1), 0);
	Иначе
		ТекущиеДанные.Пометка = ВозможнаяПометкаСтроки(ТекущиеДанные, НовЗначениеПометки);	
	КонецЕсли;
	Если ТекущиеДанные.ПолучитьРодителя() <> Неопределено Тогда
		ЕстьВключенные = Ложь;
		ЕстьВыключенные = Ложь;
		Для каждого ТекСтр Из ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы() Цикл
		
			Если ТекСтр.Пометка = 1 Тогда
				ЕстьВключенные = Истина;
			Иначе
				ЕстьВыключенные = Истина;
			КонецЕсли;
		
		КонецЦикла;
		ТекущиеДанные.ПолучитьРодителя().Пометка = ?(ЕстьВключенные, ?(ЕстьВыключенные, 2, 1), 0);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДопРеквизитыБухОперации

&НаКлиенте
Процедура ДопРеквизитыБухОперацииЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДопРеквизитыБухОперации.ТекущиеДанные;
	ТекущиеДанные.Пометка = ЗначениеЗаполнено(ТекущиеДанные.ЗначениеРеквизита);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаСоздатьОтмеченныеДокументы(Команда)
	
	Оповестить("СозданиеДокументов", СоздатьОтмеченныеДокументы(), ВладелецФормы);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьПометкуВсем(Команда)
	Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		ЕстьОтмеченные = Ложь;
		ЕстьНеОтмеченные = Ложь;
		Для каждого ТекСтр1 Из ТекСтр.ПолучитьЭлементы() Цикл
		
			ТекСтр1.Пометка = ВозможнаяПометкаСтроки(ТекСтр1, 1);
			Если ТекСтр1.Пометка = 0 Тогда
				ЕстьНеОтмеченные = Истина;
			Иначе
				ЕстьОтмеченные = Истина;
			КонецЕсли;
		
		КонецЦикла;
		
		ТекСтр.Пометка = ?(ЕстьОтмеченные, ?(ЕстьНеОтмеченные, 2, 1), 0);
	    
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьПометкуВсем(Команда)
	Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
	
		ТекСтр.Пометка = 0;
		Для каждого ТекСтр1 Из ТекСтр.ПолучитьЭлементы() Цикл
		
			ТекСтр1.Пометка = 0;
		
		КонецЦикла; 
	
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазвернутьВсе(Команда)
	Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоДокументов.Развернуть(ТекСтр.ПолучитьИдентификатор());	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСвернутьВсе(Команда)
	Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоДокументов.Свернуть(ТекСтр.ПолучитьИдентификатор());	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаВОтдельныйДокумент(Команда)
	ВыделенныеСтроки = Элементы.ДеревоДокументов.ВыделенныеСтроки;
	ПеренестиВОтдельныйДокумент(ВыделенныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура КомандаВОдинДокумент(Команда)
	ВыделенныеСтроки = Элементы.ДеревоДокументов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() < 2 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Для объединения объектов в один документ выделите несколько объектов и нажмите ""В один документ""'"));
		Возврат;
	КонецЕсли;
	ОбъединитьВОдинДокумент(ВыделенныеСтроки);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВозможнаяПометкаСтроки(ТекСтрока, ЖелаемаяПометка)

	Возврат ?(ЗначениеЗаполнено(ТекСтрока.Документ), 0, ЖелаемаяПометка);	

КонецФункции

&НаСервере
Функция СоздатьОтмеченныеДокументы()
	
	ТипКПС = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТаблицаДопРеквизитов = ДопРеквизитыБухОперации.Выгрузить();
	
	ТипыДокументов52н = Новый Массив;
	ТипыДокументов52н.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	ТипыДокументов52н.Добавить(Тип("ДокументСсылка.СписаниеТранспорта"));
	ТипыДокументов52н.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	
	ОперативныйУчет			= БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "21");
	Арендованные			= БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "01");
	НаОтветственномХранении	= БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "02");
	ЭтоНПА					= БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "103.00");
	
	Если ВидДокументов = "ПринятиеКУчету" Тогда
		Для Каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
			
			Если ТекСтр.Пометка > 0 Тогда
				
				МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ТекСтр.ПолноеИмяДокумента);
				МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТекСтр.ПолноеИмяДокумента);
				
				НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
				НовыйДокумент.УстановитьСсылкуНового(МенеджерДокумента.ПолучитьСсылку());
				НовыйДокумент.Дата = ТекущаяДатаСеанса();
				НовыйДокумент.Организация = Организация;
				ЭтоДокумент52н = ТипыДокументов52н.Найти(ТипЗнч(НовыйДокумент.Ссылка)) <> Неопределено;
				
				Если ТекСтр.ПолноеИмяДокумента = "Документ.ПоступлениеНФАпоЦС" Тогда
					
					ЗаполняемыеРеквизиты = "ИФО,Подразделение,ЦМО";
					ЗаполнитьЗначенияСвойств(НовыйДокумент, ТекСтр, ЗаполняемыеРеквизиты);
					НовыйДокумент.Контрагент = Контрагент;
					
					//ТекСтр.НомерСтрокиДокумента = -1;				
					СтрокиДерева = ТекСтр.ПолучитьЭлементы();
					ТекСтр.НомерСтрокиДокумента = СтрокиДерева[0].НомерСтрокиДокумента;
					Для Каждого ТекВложСтр Из СтрокиДерева Цикл						
						Если ТекВложСтр.Пометка > 0 Тогда
							НовСтрокаДокумента = НовыйДокумент.ОсновныеСредства.Добавить();
							ЗаполнитьЗначенияСвойств(НовСтрокаДокумента, ТекВложСтр);
							НовСтрокаДокумента.СчетУчета = СчетУчета;
							ТекВложСтр.Документ = НовыйДокумент.Ссылка;						
						КонецЕсли;	
					КонецЦикла;
					
				Иначе
					
					Если ЭтоДокумент52н Тогда
						Если Арендованные Или НаОтветственномХранении Тогда
							НовыйДокумент.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс;
						Иначе
							НовыйДокумент.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;
						КонецЕсли;
						НовыйДокумент.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ТекСтр.ПолучитьЭлементы()[0].Счет);
						НовыйДокумент.ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
						НовыйДокумент.Курс = 1;
						НовыйДокумент.Кратность = 1;
					Иначе
						НовыйДокумент.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101;
					КонецЕсли;
					
					Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("СчетУчета", МетаданныеДокумента) Тогда
						НовыйДокумент.СчетУчета = ЭтаФорма.СчетУчета;
					ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("СчетОС", МетаданныеДокумента) Тогда
						НовыйДокумент.СчетОС = ЭтаФорма.СчетУчета;
					КонецЕсли;
					ЕстьТЧОсновныеСредства = МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено;
					Если ЕстьТЧОсновныеСредства Тогда
						ЗаполняемыеРеквизиты = "ИФО, КФО, Подразделение, ЦМО";
						ПервоначальнаяСтоимость = 0;
					Иначе
						ПервоначальнаяСтоимость = ТекСтр.Сумма;
						ЗаполняемыеРеквизиты = "ИФО, КФО, Подразделение, ОсновноеСредство, ИнвентарныйНомер, ЦМО";
					КонецЕсли;
					Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КПС", МетаданныеДокумента) Тогда
						ЗаполняемыеРеквизиты = ЗаполняемыеРеквизиты + ", КПС";
					КонецЕсли;
					КоличествоВсего = 0;
					ЗаполнитьЗначенияСвойств(НовыйДокумент, ТекСтр, ЗаполняемыеРеквизиты);
					СтрокиДерева = ТекСтр.ПолучитьЭлементы();
					//ЗаполнитьЗначенияСвойств(НовыйДокумент, СтрокиДерева[0], "КФО");
					Если НЕ ЕстьТЧОсновныеСредства Тогда
						ТекСтр.НомерСтрокиДокумента = СтрокиДерева[0].НомерСтрокиДокумента;
						ТекСтр.СтрокиДерева[0].Документ = НовыйДокумент.Ссылка;
					Иначе
						ТекСтр.НомерСтрокиДокумента = -1;
						Для каждого ТекВложСтр Из СтрокиДерева Цикл
							
							Если ТекВложСтр.Пометка > 0 Тогда
								ПервоначальнаяСтоимость = ТекВложСтр.Сумма;
								КоличествоВсего = КоличествоВсего + ТекВложСтр.Количество;
								НовСтрокаДокумента = НовыйДокумент.ОсновныеСредства.Добавить();
								ЗаполнитьЗначенияСвойств(НовСтрокаДокумента, ТекВложСтр);
								
								Если ЭтоДокумент52н Тогда
									Если ОперативныйУчет Тогда
										НовСтрокаДокумента.СчетУчетаОС = УправлениеОсновнымиСредствамиПовтИсп.СчетУчетаПоЗабалансовомуСчетуОС(ТекВложСтр.Счет);
										НовСтрокаДокумента.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию;
									Иначе
										НовСтрокаДокумента.СчетУчетаОС = ТекВложСтр.Счет;
										Если ЭтоНПА Тогда
											НовСтрокаДокумента.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается;
										Иначе
											НовСтрокаДокумента.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации;
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
								
								ТекВложСтр.Документ = НовыйДокумент.Ссылка;
							КонецЕсли;
							
						КонецЦикла; 
					КонецЕсли;
					
					Если НЕ ЭтоДокумент52н Тогда
						НовыйДокумент.ПервоначальнаяСтоимость = ПервоначальнаяСтоимость;
					КонецЕсли;
					Если ЕстьТЧОсновныеСредства Тогда
						НовыйДокумент.Количество = КоличествоВсего;	
					КонецЕсли;
					
					ВыполнитьОбработкуПослеСозданияДокумента(НовыйДокумент);
					
				КонецЕсли;
			
				НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
				ТекСтр.Документ = НовыйДокумент.Ссылка;
				Для каждого ТекСтрокаДерева Из ТекСтр.ПолучитьЭлементы() Цикл
				
					ТекСтрокаДерева.Документ = НовыйДокумент.Ссылка;	
				
				КонецЦикла;
				ЗаписатьТиповуюОперациюДокумента(НовыйДокумент, ТекСтр, ТаблицаДопРеквизитов);
				
			КонецЕсли;
		
		КонецЦикла;
	Иначе // Если ВидДокументов = "Списание" Тогда
		Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
			
			Если ТекСтр.Пометка > 0 Тогда
				
				МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ТекСтр.ПолноеИмяДокумента);
				МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТекСтр.ПолноеИмяДокумента);
				ЕстьВидОперации = МетаданныеДокумента.Реквизиты.Найти("ВидОперации") <> Неопределено;
				
				НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
				НовыйДокумент.УстановитьСсылкуНового(МенеджерДокумента.ПолучитьСсылку());
				НовыйДокумент.Дата 			= ТекущаяДатаСеанса();
				НовыйДокумент.Организация 	= Организация;
				
				Если ТекСтр.ПолноеИмяДокумента = "Документ.ОперацияБух" Тогда
					
					СтрокиДерева = ТекСтр.ПолучитьЭлементы();
					ТекСтр.НомерСтрокиДокумента = СтрокиДерева[0].НомерСтрокиДокумента;
					
					Для Каждого ТекВложСтр Из СтрокиДерева Цикл
						
						Если ТекВложСтр.Пометка > 0 Тогда
							
							НоваяЗапись = НовыйДокумент.Движения.ЖурналПроводокЕПСБУ.Добавить();
							
							НоваяЗапись.Организация					= НовыйДокумент.Организация;
							НоваяЗапись.Период						= НовыйДокумент.Дата;
							
							НоваяЗапись.ИФО							= ТекВложСтр.ИФО;
							НоваяЗапись.КФО							= ТекВложСтр.КФО;
							НоваяЗапись.КПСКт						= ТекВложСтр.КПС;
							НоваяЗапись.СчетКт						= ТекВложСтр.Счет;							
							НоваяЗапись.КоличествоКт				= ТекВложСтр.Количество;							
							НоваяЗапись.ПодразделениеКт				= ТекВложСтр.Подразделение;
							НоваяЗапись.Сумма						= ТекВложСтр.Сумма;
							
							НоваяЗапись.СубконтоКт.ОсновныеСредства	= ТекВложСтр.ОсновноеСредство;
							НоваяЗапись.СубконтоКт.ЦМО				= ТекВложСтр.ЦМО; 
							НоваяЗапись.СубконтоКт.Контрагенты		= Контрагент;
							
							//НоваяЗапись.Содержание
							//НоваяЗапись.ВидПервичногоДокумента
							//НоваяЗапись.ДатаПервичногоДокумента
							//НоваяЗапись.НомерПервичногоДокумента

						КонецЕсли;
						
					КонецЦикла;
					
					НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
					ТекСтр.Документ = НовыйДокумент.Ссылка;
					Для Каждого ТекСтрокаДерева Из ТекСтр.ПолучитьЭлементы() Цикл						
						ТекСтрокаДерева.Документ = НовыйДокумент.Ссылка;	
					КонецЦикла;
					
				Иначе
					
					ЭтоДокумент52н = ТипыДокументов52н.Найти(ТипЗнч(НовыйДокумент.Ссылка)) <> Неопределено;
					
					Если ЕстьВидОперации Тогда
						Если ЭтоДокумент52н Тогда
							Если ОперативныйУчет Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет;
							ИначеЕсли Арендованные Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование;
							ИначеЕсли НаОтветственномХранении Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении;
							Иначе
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
							КонецЕсли;
							
							Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВидИмущества", МетаданныеДокумента) Тогда
								НовыйДокумент.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ТекСтр.ПолучитьЭлементы()[0].Счет);
							КонецЕсли;
						Иначе
							Если ОперативныйУчет Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет;
							ИначеЕсли Арендованные Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование;
							ИначеЕсли НаОтветственномХранении Тогда
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении;
							Иначе
								НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					ЕстьТЧОсновныеСредства = МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено;
					Если ЕстьТЧОсновныеСредства Тогда
						ЗаполняемыеРеквизиты = "ИФО, КФО, Подразделение, ЦМО";
						ПервоначальнаяСтоимость = 0;
					Иначе
						ПервоначальнаяСтоимость = ТекСтр.Сумма;
						ЗаполняемыеРеквизиты = "ИФО, КФО, КПС, Подразделение, ОсновноеСредство, ИнвентарныйНомер,"
						+ "ЦМО, Сумма";
					КонецЕсли;
					КоличествоВсего = 0;
					ЗаполнитьЗначенияСвойств(НовыйДокумент, ТекСтр, ЗаполняемыеРеквизиты);
					Если МетаданныеДокумента.Реквизиты.Найти("СчетУчета") <> Неопределено Тогда
						НовыйДокумент.СчетУчета = ТекСтр.Счет;
					КонецЕсли;
					Если НЕ ЕстьТЧОсновныеСредства Тогда
						ТекСтр.НомерСтрокиДокумента = ТекСтр.ПолучитьЭлементы()[0].НомерСтрокиДокумента;
						ТекСтр.ПолучитьЭлементы()[0].Документ = НовыйДокумент.Ссылка;
					Иначе
						ТекСтр.НомерСтрокиДокумента = -1;
						ЕстьИдентификаторСтроки = 
							(МетаданныеДокумента.ТабличныеЧасти["ОсновныеСредства"].Реквизиты.Найти("ИдентификаторСтроки") <> Неопределено);
						Для каждого ТекВложСтр Из ТекСтр.ПолучитьЭлементы() Цикл
							
							Если ТекВложСтр.Пометка > 0 Тогда
								НовСтрокаДокумента = НовыйДокумент.ОсновныеСредства.Добавить();
								ЗаполнитьЗначенияСвойств(НовСтрокаДокумента, ТекВложСтр);
								Если ЕстьИдентификаторСтроки Тогда
									НовСтрокаДокумента.ИдентификаторСтроки = Новый УникальныйИдентификатор;
								КонецЕсли;	
								
								ТекВложСтр.Документ = НовыйДокумент.Ссылка;
								
								Если ЭтоДокумент52н Тогда
									НовСтрокаДокумента.СчетУчета = ТекВложСтр.Счет;
									НовСтрокаДокумента.СтоимостьЕдиницы = ТекВложСтр.Цена;
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЦикла; 
					КонецЕсли;
					
					ВыполнитьОбработкуПослеСозданияДокумента(НовыйДокумент);
					НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
					ТекСтр.Документ = НовыйДокумент.Ссылка;
					Для каждого ТекСтрокаДерева Из ТекСтр.ПолучитьЭлементы() Цикл
						
						ТекСтрокаДерева.Документ = НовыйДокумент.Ссылка;	
						
					КонецЦикла;
					ЗаписатьТиповуюОперациюДокумента(НовыйДокумент, ТекСтр, ТаблицаДопРеквизитов);
					
					ТекСтр.Документ = НовыйДокумент.Ссылка;
					Если ЕстьТЧОсновныеСредства Тогда
						Для каждого ТекВложСтр Из ТекСтр.ПолучитьЭлементы() Цикл
							Если ТекВложСтр.Пометка > 0 Тогда
								ТекВложСтр.Документ = НовыйДокумент.Ссылка;
							КонецЕсли;
						КонецЦикла; 
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли; 
	
	ДеревоРезультат = Новый ДеревоЗначений;	
	ДеревоРезультат.Колонки.Добавить("ИФО");
	ДеревоРезультат.Колонки.Добавить("КФО");
	ДеревоРезультат.Колонки.Добавить("КПС");
	ДеревоРезультат.Колонки.Добавить("Подразделение");
	ДеревоРезультат.Колонки.Добавить("Счет");
	ДеревоРезультат.Колонки.Добавить("ОсновноеСредство");
	ДеревоРезультат.Колонки.Добавить("ИнвентарныйНомер");
	ДеревоРезультат.Колонки.Добавить("Цена");
	ДеревоРезультат.Колонки.Добавить("Количество");
	ДеревоРезультат.Колонки.Добавить("Сумма");
	ДеревоРезультат.Колонки.Добавить("ВидДокумента");
	ДеревоРезультат.Колонки.Добавить("ИмяДокумента");
	ДеревоРезультат.Колонки.Добавить("ЦМО");
	ДеревоРезультат.Колонки.Добавить("Документ");
	ДеревоРезультат.Колонки.Добавить("НомерСтрокиДокумента");
	
	Для каждого ТекСтр Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Если ТекСтр.Пометка>0 Тогда
			НовСтр = ДеревоРезультат.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр);
			Для каждого ТекСтр1 Из ТекСтр.ПолучитьЭлементы() Цикл
				Если ТекСтр1.Пометка>0 Тогда	
					НовСтр1 = НовСтр.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр1, ТекСтр1);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Адр = ПоместитьВоВременноеХранилище(ДеревоРезультат, АдресВХранилище);
	Возврат Адр;
	
КонецФункции

&НаСервере
Процедура ЗаписатьТиповуюОперациюДокумента(НовыйДокумент, ТекСтр, ТаблицаДопРеквизитов)

	ДанныеДляЗаписи = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(НовыйДокумент.Ссылка);
	ДанныеДляЗаписи.Дата = НовыйДокумент.Дата;
	ДанныеДляЗаписи.Операция = ТиповыеОперацииДокументов[ТекСтр.ИмяДокумента];
	ДанныеДляЗаписи.Организация = Организация;
	РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(НовыйДокумент.Ссылка, ДанныеДляЗаписи);
	
	ЗначенияДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций
											.СоздатьНаборЗаписей();
	ЗначенияДопРеквизитов.Отбор.Объект.Установить(НовыйДокумент.Ссылка);
	Для каждого ДопРеквизит Из Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповыеОперацииДокументов[ТекСтр.ИмяДокумента]) Цикл
		
		СтрокаДопРеквизита = ТаблицаДопРеквизитов.Найти(ВРЕГ(ДопРеквизит.ИмяДляФормулы), "ИмяДляФормулы");
		
		Если СтрокаДопРеквизита <> Неопределено 
			И СтрокаДопРеквизита.Пометка Тогда
			ЗначениеДопРеквизита = ЗначенияДопРеквизитов.Добавить();
			ЗначениеДопРеквизита.Значение 			= СтрокаДопРеквизита.ЗначениеРеквизита;
			ЗначениеДопРеквизита.РеквизитОперации	= ДопРеквизит.Ссылка;
			ЗначениеДопРеквизита.Объект 			= НовыйДокумент.Ссылка;
			//ЗначениеДопРеквизита.Свойство 		= ДопРеквизит.РеквизитПроводки;
		КонецЕсли;
	
	КонецЦикла;
	Если ЗначенияДопРеквизитов.Количество() > 0 Тогда
		ЗначенияДопРеквизитов.Записать(Истина);
	КонецЕсли;

КонецПроцедуры
 

&НаСервере
Процедура ВыполнитьОбработкуПослеСозданияДокумента(Документ)

	Если ТипЗнч(Документ) = Тип("ДокументОбъект.СписаниеГруппОбъектовОС") Тогда
		
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Документ, ПолучитьДатуОпределенияОстатков(Документ));
		ПараметрыПолученияОстатков.ЦМО 				= Документ.ЦМО;
		ПараметрыПолученияОстатков.Подразделение	= Документ.Подразделение;
		
		Если Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет") Тогда
			ПараметрыПолученияОстатков.ИспользуемыйСчет = "ЗабалансовыйСчет";
		КонецЕсли;
		
		Если Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
			ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Документ.ОсновныеСредства, ПараметрыПолученияОстатков.ТаблицаОС);
		ПараметрыПолученияОстатков.ТаблицаОС.ЗаполнитьЗначения(Документ.КФО, "КФО");
		ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;
		
		Если Документ.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
			ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков); 
		Иначе
			ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
		КонецЕсли;
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ОсновноеСредство",	"ОсновноеСредство");
		ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",	"ИнвентарныйНомер");
		ПараметрыЗаполнения.Вставить("СуммаАмортизации",	"СуммаАмортизации");
		
		СписокОС = Документ.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
		
		ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер", Ложь);
		
		Для каждого СтрокаТаблицы Из Документ.ОсновныеСредства Цикл
			УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, СтрокаТаблицы, ПараметрыЗаполнения);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.СписаниеЛитературы") Тогда
		// рассчитать амортизацию
		СписокОС = Документ.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
		ТаблицаОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьСпискаОС(	СписокОС,
																				ПолучитьДатуОпределенияОстатков(Документ),
																				Документ.Организация,
																				Документ.КФО,
																				Документ.КПС,
																				Документ.ЦМО,
																				Документ.ИФО,
																				Документ.Подразделение,
																				Документ.Ссылка);
		Для каждого ТекСтрОС Из Документ.ОсновныеСредства Цикл
			УправлениеОсновнымиСредствами.ПолучитьОстаткиОСпоТаблицеОстатков(	ТаблицаОС, 
																				ТекСтрОС.ОсновноеСредство, 
																				ТекСтрОС.ИнвентарныйНомер, 
																				ТекСтрОС.Количество, 
																				0, // сумму не пересчитываем 
																				ТекСтрОС.СуммаАмортизации,
																				0); 			
		КонецЦикла;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.СписаниеАвтотранспорта")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СписаниеТранспорта") 
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СписаниеОбъектаОС") Тогда
		// рассчитать амортизацию
		ТаблицаОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьСпискаОС(	Документ.ОсновноеСредство,
																				ПолучитьДатуОпределенияОстатков(Документ),
																				Документ.Организация,
																				Документ.КФО,
																				Документ.КПС,
																				Документ.ЦМО,
																				Документ.ИФО,
																				Документ.Подразделение);
		КоличествоВТаблице = ТаблицаОС.Количество();
		Если КоличествоВТаблице=1 Тогда
			Документ.СуммаАмортизации	= ТаблицаОС[0].АмортизацияТекОС;
		ИначеЕсли КоличествоВТаблице>0 Тогда
			НайденаСтрока = ТаблицаОС.Найти(Документ.ИнвентарныйНомер, "ИнвНомер");
			Если НайденаСтрока<>Неопределено Тогда
				Документ.СуммаАмортизации	= НайденаСтрока.АмортизацияТекОС;
			КонецЕсли;	
		Иначе
			Документ.СуммаАмортизации	= 0;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ПринятиеКУчетуЗдания")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.ПринятиеКУчетуОбъектаОС")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.ПринятиеКУчетуОС") Тогда
		
		Если ТипЗнч(Документ) = Тип("ДокументОбъект.ПринятиеКУчетуОС") Тогда
			СведенияОбОС = УправлениеОсновнымиСредствами.ПолучитьСведенияОбОС(	
																	Документ.Дата,
																	Документ.ОсновныеСредства[0].ОсновноеСредство);
		Иначе																		
			СведенияОбОС = УправлениеОсновнымиСредствами.ПолучитьСведенияОбОС(	
																	Документ.Дата,
																	Документ.ОсновноеСредство);
		КонецЕсли;																	
																	
		Если ЗначениеЗаполнено(СведенияОбОС.СрокПолезногоИспользования) Тогда
			Документ.СрокПолезногоИспользования = СведенияОбОС.СрокПолезногоИспользования;
		Иначе
			СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
																			СведенияОбОС.АмортизационнаяГруппа);
			Если Документ.СрокПолезногоИспользования = 0 ИЛИ СрокПолезногоИспользования <> 0 Тогда
				Документ.СрокПолезногоИспользования = СрокПолезногоИспользования;	
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СведенияОбОС.ПорядокПогашенияСтоимости) Тогда
			Документ.ПорядокПогашенияСтоимости = СведенияОбОС.ПорядокПогашенияСтоимости;
			Документ.СпособНачисленияАмортизации = СведенияОбОС.СпособНачисленияАмортизации;
			Документ.НачислятьАмортизацию = СведенияОбОС.НачислятьАмортизацию;
		Иначе
			УправлениеОсновнымиСредствамиКлиентСервер.УстановитьПорядокПогашенияСтоимости(
										Документ.ПорядокПогашенияСтоимости,
										Документ.СпособНачисленияАмортизации,
										Документ.НачислятьАмортизацию,
										Новый Структура("Дата, ВидНФА, СтоимостьНФА, СчетУчета, СчетУчетаЗабалансовый",
														Документ.Дата,
														СведенияОбОС.ВидНФА,
														Документ.ПервоначальнаяСтоимость,
														СведенияОбОС.СчетУчета,
														БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(
															СведенияОбОС.СчетУчета).Забалансовый));
		КонецЕсли;															
		ЗаполнитьЗначенияСвойств(Документ, СведенияОбОС, "СчетУчетаЗатрат,КЭКЗатрат,КПСЗатрат,ПодразделениеЗатрат,"
														+ "СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3");
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ПринятиеКУчетуОбъектовОС") Тогда
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
			Документ.Организация, Документ.Дата, Документ.Подразделение);
		
		Документ.Руководитель = Руководитель.ОтветственноеЛицоСсылка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьДатуОпределенияОстатков(Документ)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "ДатаСписанияСБухУчета") Тогда
		Значение = ?(ЗначениеЗаполнено(Документ.ДатаСписанияСБухУчета), 
			КонецДня(Документ.ДатаСписанияСБухУчета), 
			КонецДня(Документ.Дата));
	Иначе
		Значение = КонецДня(Документ.Дата);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТиповыеОперацииДокументов(ВидыДокументов)
	
	СоответствиеОпераций = Новый Соответствие;
	СписокОпераций = Новый Массив;
	
	СчетЗабаланс	= Ложь;
	ОперативныйУчет	= Ложь;
	Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "01,02") Тогда
		СчетЗабаланс = Истина;
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчета, "21") Тогда
		ОперативныйУчет = Истина;
	КонецЕсли;
	
	Для Каждого ВидДокумента Из ВидыДокументов Цикл
		
		Если ВидДокумента = "ПринятиеКУчетуОбъектовОС" Тогда
			
			Если СчетЗабаланс Тогда
				ТекОперация = Справочники.ТиповыеОперации.ПринятиеКУчетуОбъектовОС_Аренда;
			Иначе
				ТекОперация = Справочники.ТиповыеОперации.ПринятиеКУчетуОбъектовОС_ОприходованиеИзлишков;
			КонецЕсли;
			
		ИначеЕсли ВидДокумента = "ПоступлениеНФАпоЦС" Тогда
			
			ТекОперация = Справочники.ТиповыеОперации.ПоступлениеНФАпоЦС_ПоступлниеНФА;
			
		ИначеЕсли ВидДокумента = "СписаниеЛитературы" Тогда
			
			ТекОперация = Справочники.ТиповыеОперации.СписаниеЛитературы_СписаниеНедостачЗаСчетВиновныхЛиц;
			
		ИначеЕсли ВидДокумента = "СписаниеОбъектовОС" Тогда
			
			Если СчетЗабаланс Тогда
				ТекОперация = Справочники.ТиповыеОперации.СписаниеОбъектовОС_СписаниеЗабаланс;		
			ИначеЕсли ОперативныйУчет Тогда			
				ТекОперация = Справочники.ТиповыеОперации.СписаниеОбъектовОС_СписаниеОперУчет;
			Иначе
				ТекОперация = Справочники.ТиповыеОперации.СписаниеОбъектовОС_СписаниеНедостачЗаСчетВиновныхЛиц; 
			КонецЕсли;				
			
		ИначеЕсли ВидДокумента = "СписаниеТранспорта" Тогда
			
			Если СчетЗабаланс Тогда
				ТекОперация = Справочники.ТиповыеОперации.СписаниеОбъектовОС_СписаниеЗабаланс;
			ИначеЕсли ОперативныйУчет Тогда			
				ТекОперация = Справочники.ТиповыеОперации.СписаниеОбъектовОС_СписаниеОперУчет;
			Иначе
				ТекОперация = Справочники.ТиповыеОперации.СписаниеТранспорта_СписаниеНедостачЗаСчетВиновныхЛиц;		
			КонецЕсли;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		СоответствиеОпераций.Вставить(ВидДокумента, ТекОперация);
		СписокОпераций.Добавить(ТекОперация);
		
	КонецЦикла;
	
	ТиповыеОперацииДокументов = Новый ФиксированноеСоответствие(СоответствиеОпераций);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК Ссылка,
	|	РеквизитыТиповыхОпераций.Код КАК Код,
	|	РеквизитыТиповыхОпераций.Наименование КАК Наименование,
	|	РеквизитыТиповыхОпераций.Владелец КАК Владелец,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.ОтборЭлементов КАК ОтборЭлементов,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки КАК РеквизитПроводки
	|ПОМЕСТИТЬ ДопРеквизиты
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец В(&МассивОпераций)
	|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
	|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДопРеквизиты.РеквизитПроводки КАК РеквизитПроводки,
	|	ДопРеквизиты.ИмяДляФормулы КАК ИмяДляФормулы,
	|	ДопРеквизиты.ОтборЭлементов КАК ОтборЭлементов,
	|	ДопРеквизиты.Наименование КАК ЗаголовокРеквизита,
	|	ДопРеквизиты.РеквизитПроводки.Наименование КАК ИмяРеквизита
	|ИЗ
	|	ДопРеквизиты КАК ДопРеквизиты
	|ГДЕ
	|	ДопРеквизиты.Ссылка В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				Т.Ссылка
	|			ИЗ
	|				ДопРеквизиты КАК Т
	|			ГДЕ
	|				Т.ИмяДляФормулы = ДопРеквизиты.ИмяДляФормулы
	|				И Т.РеквизитПроводки = ДопРеквизиты.РеквизитПроводки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДопРеквизиты.Владелец,
	|	ДопРеквизиты.Ссылка.Родитель.Код,
	|	ДопРеквизиты.Код";
	
	Запрос.УстановитьПараметр("МассивОпераций", СписокОпераций);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		НовСтрокаДопРеквизита = ДопРеквизитыБухОперации.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрокаДопРеквизита, Выборка);
		НовСтрокаДопРеквизита.ИмяРеквизита = Выборка.ЗаголовокРеквизита;
		НовСтрокаДопРеквизита.ИмяДляФормулы = ВРЕГ(НовСтрокаДопРеквизита.ИмяДляФормулы);
	
	КонецЦикла;
	
	Если ДопРеквизитыБухОперации.Количество() > 0 Тогда
		Элементы.ДопРеквизитыБухОперации.ВысотаВСтрокахТаблицы = Мин(ДопРеквизитыБухОперации.Количество(), 5);
	Иначе
		Элементы.ДопРеквизитыБухОперации.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПеренестиВОтдельныйДокумент(ВыделенныеСтроки)

	СоответствиеСтрок = Новый Соответствие;
	
	Для каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
	
		ТекСтрока = ДеревоДокументов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Родитель = ТекСтрока.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Продолжить;
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Документ) Тогда
			Продолжить;
		ИначеЕсли Родитель.ПолучитьЭлементы().Количество() = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторРодителя = Родитель.ПолучитьИдентификатор();
		НовыйРодитель = СоответствиеСтрок.Получить(ИдентификаторРодителя);
		Если НовыйРодитель = Неопределено Тогда
			НовыйРодитель = ДеревоДокументов.ПолучитьЭлементы().Добавить();
			СоответствиеСтрок.Вставить(ИдентификаторРодителя, НовыйРодитель);
			ЗаполнитьЗначенияСвойств(НовыйРодитель, Родитель,,"Количество, Сумма");
		КонецЕсли;
		
		НоваяСтрока = НовыйРодитель.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		Родитель.ПолучитьЭлементы().Удалить(ТекСтрока);
	
	КонецЦикла;
	
	Для каждого ИдентификаторРодителя Из СоответствиеСтрок Цикл
	
		СтарРодитель = ДеревоДокументов.НайтиПоИдентификатору(ИдентификаторРодителя.Ключ);
		Если СтарРодитель.ПолучитьЭлементы().Количество() = 0 Тогда
			ДеревоДокументов.ПолучитьЭлементы().Удалить(СтарРодитель);
		Иначе
			ЕстьОтмеченный = Ложь;
			ЕстьНеОтмеченный = Ложь;
			Количество = 0;
			Сумма = 0;
			Для каждого ТекСтр Из СтарРодитель.ПолучитьЭлементы() Цикл
				Если ТекСтр.Пометка Тогда
					ЕстьОтмеченный = Истина;
				Иначе
					ЕстьНеОтмеченный = Истина;
				КонецЕсли;
				Количество = Количество + ТекСтр.Количество;
				Сумма = Сумма + ТекСтр.Сумма;
				
			КонецЦикла; 
			СтарРодитель.Пометка = ?(ЕстьОтмеченный, ?(ЕстьНеОтмеченный,2,1),0);
			СтарРодитель.Количество = Количество;
			СтарРодитель.Сумма = Сумма;
		КонецЕсли;
		
		НовРодитель = ИдентификаторРодителя.Значение;
		ЕстьОтмеченный = Ложь;
		ЕстьНеОтмеченный = Ложь;
		Количество = 0;
		Сумма = 0;
		Для каждого ТекСтр Из НовРодитель.ПолучитьЭлементы() Цикл
			Если ТекСтр.Пометка Тогда
				ЕстьОтмеченный = Истина;
			Иначе
				ЕстьНеОтмеченный = Истина;
			КонецЕсли;
			Количество = Количество + ТекСтр.Количество;
			Сумма = Сумма + ТекСтр.Сумма;
		КонецЦикла; 
		НовРодитель.Пометка = ?(ЕстьОтмеченный, ?(ЕстьНеОтмеченный,2,1),0);
		НовРодитель.Количество = Количество;
		НовРодитель.Сумма = Сумма;
	
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ОбъединитьВОдинДокумент(ВыделенныеСтроки)

	МассивИменДокументов = Новый Массив;
	МассивИменДокументов.Добавить("СписаниеГруппОбъектовОС");
	МассивИменДокументов.Добавить("ПринятиеКУчетуОС");

	МассивТипов = Новый Массив;
	Для каждого ИмяДокумента Из МассивИменДокументов Цикл
	
		МассивТипов.Добавить(Тип("ДокументСсылка." + ИмяДокумента));
	
	КонецЦикла; 
	
	ТаблицаОбъединения = Новый ТаблицаЗначений;
	ТаблицаОбъединения.Колонки.Добавить("ИФО", 					Новый ОписаниеТипов(
																"СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаОбъединения.Колонки.Добавить("КФО", 					Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОбъединения.Колонки.Добавить("КПС", 					Новый ОписаниеТипов(
																"СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОбъединения.Колонки.Добавить("Подразделение", 		Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаОбъединения.Колонки.Добавить("Счет", 				Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаОбъединения.Колонки.Добавить("ОсновноеСредство", 	Новый ОписаниеТипов(
																"СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъединения.Колонки.Добавить("ИнвентарныйНомер", 	Новый ОписаниеТипов(
																"СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъединения.Колонки.Добавить("Цена", 				Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("Сумма", 				Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("ВидДокумента", 		Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	ТаблицаОбъединения.Колонки.Добавить("Документ", 			Новый ОписаниеТипов(МассивТипов));
	ТаблицаОбъединения.Колонки.Добавить("ПолноеИмяДокумента",	Новый ОписаниеТипов("Строка"));
	ТаблицаОбъединения.Колонки.Добавить("ЦМО", 					Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ТаблицаОбъединения.Колонки.Добавить("НомерСтрокиДокумента", Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("ИмяДокумента", 		Новый ОписаниеТипов("Строка"));
	ТаблицаОбъединения.Колонки.Добавить("СтрокаПотомок", 		Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("СтрокаРодитель", 		Новый ОписаниеТипов("Число"));
	ТаблицаОбъединения.Колонки.Добавить("ДокументВыбран", 		Новый ОписаниеТипов("Булево"));
	
	СоответствиеСтрок = Новый Соответствие;
	Для каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
	
		ТекСтрока = ДеревоДокументов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если МассивИменДокументов.Найти(ТекСтрока.ИмяДокумента) = Неопределено Тогда
			// документ без ТЧ. в объединении не участвует
			Продолжить;
		КонецЕсли;
		
		ТекРодитель = ТекСтрока.ПолучитьРодителя();
		
		Если ТекРодитель = Неопределено Тогда
			// Передан родитель, пробуем объединить его потомков
			
			Для каждого Потомок Из ТекСтрока.ПолучитьЭлементы() Цикл
				
				НовСтрока = ТаблицаОбъединения.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Потомок);	
				НовСтрока.ДокументВыбран	= ЗначениеЗаполнено(НовСтрока.Документ);
				НовСтрока.СтрокаПотомок		= Потомок.ПолучитьИдентификатор();
				НовСтрока.СтрокаРодитель	= ИдентификаторСтроки;
			
			КонецЦикла; 
			
		Иначе			
			
			НовСтрока = ТаблицаОбъединения.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);	
			НовСтрока.ДокументВыбран 	= ЗначениеЗаполнено(НовСтрока.Документ);
			НовСтрока.СтрокаПотомок		= ИдентификаторСтроки;
			НовСтрока.СтрокаРодитель	= ТекРодитель.ПолучитьИдентификатор();
			
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаБезДокумента 	= ТаблицаОбъединения.Скопировать(Новый Структура("ДокументВыбран", Ложь));
	ТаблицаСДокументом		= ТаблицаОбъединения.Скопировать(Новый Структура("ДокументВыбран", Истина));
	ТаблицаНовыхРодителей	= ТаблицаОбъединения.СкопироватьКолонки();
	СтруктураПоиска = Новый Структура("ИФО, КФО, КПС, Подразделение, Счет, ЦМО, Цена, ИмяДокумента");
	
	МассивИдентификаторовРодителей	= Новый Массив;
	
	Для каждого СтрокаБезДокумента Из ТаблицаБезДокумента Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаБезДокумента);
		СтрокиСДокументами = ТаблицаСДокументом.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиСДокументами.Количество() > 0 Тогда
			ТекСтрокаСДокументом = СтрокиСДокументами[0];
			
			НоваяСтрока = ДеревоДокументов.НайтиПоИдентификатору(ТекСтрокаСДокументом.СтрокаРодитель).ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаБезДокумента);
			
			ДеревоДокументов.НайтиПоИдентификатору(СтрокаБезДокумента.СтрокаРодитель).ПолучитьЭлементы().Удалить(ДеревоДокументов.НайтиПоИдентификатору(СтрокаБезДокумента.СтрокаПотомок));
			
			ИдентификаторРодителя = ТекСтрокаСДокументом.СтрокаРодитель;//.ПолучитьИдентификатор();
			ДобавитьВМассив(МассивИдентификаторовРодителей, ИдентификаторРодителя);
			ДобавитьВМассив(МассивИдентификаторовРодителей, СтрокаБезДокумента.СтрокаРодитель);
		Иначе
			
			СтрокиНовыхРодителей = ТаблицаНовыхРодителей.НайтиСтроки(СтруктураПоиска);
			
			Если СтрокиНовыхРодителей.Количество()>0 Тогда
				СтрокаНовыхРодителей = ДеревоДокументов.НайтиПоИдентификатору(СтрокиНовыхРодителей[0].СтрокаРодитель);
			Иначе
				
				СтрокаНовыхРодителей = ДеревоДокументов.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНовыхРодителей, ДеревоДокументов.НайтиПоИдентификатору(СтрокаБезДокумента.СтрокаРодитель));
				
				СтрокаТабНовыхРодителей = ТаблицаНовыхРодителей.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТабНовыхРодителей, СтруктураПоиска);
				СтрокаТабНовыхРодителей.СтрокаРодитель = СтрокаНовыхРодителей.ПолучитьИдентификатор();
				
				ДобавитьВМассив(МассивИдентификаторовРодителей, СтрокаНовыхРодителей.ПолучитьИдентификатор());
				
			КонецЕсли;
			
			НоваяСтрока = СтрокаНовыхРодителей.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаБезДокумента);
			
			ДеревоДокументов.НайтиПоИдентификатору(СтрокаБезДокумента.СтрокаРодитель).ПолучитьЭлементы().Удалить(ДеревоДокументов.НайтиПоИдентификатору(СтрокаБезДокумента.СтрокаПотомок));
			
			ДобавитьВМассив(МассивИдентификаторовРодителей, СтрокаБезДокумента.СтрокаРодитель);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ТекРодитель Из МассивИдентификаторовРодителей Цикл
	
		ЭлементыРодителя = ДеревоДокументов.НайтиПоИдентификатору(ТекРодитель).ПолучитьЭлементы();
		Если ЭлементыРодителя.Количество() = 0 Тогда
			ДеревоДокументов.ПолучитьЭлементы().Удалить(ДеревоДокументов.НайтиПоИдентификатору(ТекРодитель));
		Иначе
			ЕстьОтмеченный = Ложь;
			ЕстьНеОтмеченный = Ложь;
			Количество = 0;
			Сумма = 0;
			
			Для каждого ТекСтр Из ЭлементыРодителя Цикл
				Если ТекСтр.Пометка Тогда
					ЕстьОтмеченный = Истина;
				Иначе
					ЕстьНеОтмеченный = Истина;
				КонецЕсли;
				Количество = Количество + ТекСтр.Количество;
				Сумма = Сумма + ТекСтр.Сумма;
			КонецЦикла; 
			ТекСтрокаРодитель = ДеревоДокументов.НайтиПоИдентификатору(ТекРодитель);
			ТекСтрокаРодитель.Пометка = ?(ЕстьОтмеченный, ?(ЕстьНеОтмеченный,2,1),0);
			ТекСтрокаРодитель.Количество = Количество;
			ТекСтрокаРодитель.Сумма = Сумма;
			
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВМассив(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
