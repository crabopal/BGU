&НаКлиенте
Процедура ЗаполнитьРеквизитыОСВТекущейСтроке(ТекущиеДанные)
	
	Если НЕ ВыборОСОбработан Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ПолучитьРеквизитыОС(ТекущиеДанные.ОсновноеСредство, 
																		Объект.ЦМО, 
																		Объект.ДатаИнвентаризации,
																		ВидНФА = "4"));
																					
		КонецЕсли;
	КонецЕсли;
	
	ВыборОСОбработан = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборОС(ТекущиеДанные, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПереданИнвНомер = ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ВыбранноеЗначение.Свойство("ИнвентарныйНомер");
	
	Если ПереданИнвНомер Тогда
		ПереданИнвНомер = ЗначениеЗаполнено(ВыбранноеЗначение.ИнвентарныйНомер);
	КонецЕсли;	
	
	ИменаРеквизитовПолей = Новый Структура("ИнвентарныйНомер, Счет", "ИнвентарныйНомер", "СчетУчета");
	
	УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбораОсновногоСредстваВТабличнойЧасти(ВыбранноеЗначение, 
																						СтандартнаяОбработка, 
																						ТекущиеДанные, 
																						ИменаРеквизитовПолей, 
																						ВыборОСОбработан);
	Если НЕ ПереданИнвНомер Тогда
		ВыборОСОбработан = Ложь;
	КонецЕсли;

КонецПроцедуры

