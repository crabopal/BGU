&НаКлиенте
Процедура ИзлишкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Излишки.ТекущиеДанные;
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ИзлишкиЦМО");
	МассивРеквизитов.Добавить("ИзлишкиКПС");
	МассивРеквизитов.Добавить("ИзлишкиКФО");
	МассивРеквизитов.Добавить("ИзлишкиИФО");
	МассивРеквизитов.Добавить("ИзлишкиПодразделение");
	МассивРеквизитов.Добавить("ИзлишкиОсновноеСредство");
	МассивРеквизитов.Добавить("ИзлишкиИнвентарныйНомер");
	МассивРеквизитов.Добавить("ИзлишкиКоличество");
	МассивРеквизитов.Добавить("ИзлишкиДокумент");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
														Элементы,
														МассивРеквизитов,
														"РедактированиеТекста",
														НЕ ЗапрещеноРедактированиеРеквизитовСтроки(ТекущиеДанные));
