	Объект.Инвентаризация.Очистить();
	Объект.Остатки.Очистить();
	Объект.Недостачи.Очистить();
	Объект.Излишки.Очистить();
	Объект.НастройкаПорядка.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыВидовНФА()
	
	Документы.ИнвентаризацияОС.ЗаполнитьВариантыВидовНФА(ЭтаФорма);
	
