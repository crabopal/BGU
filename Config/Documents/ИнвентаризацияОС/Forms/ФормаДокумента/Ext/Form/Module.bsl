&НаКлиенте
Процедура ВидНФАПриИзмененииЗавершениеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОчиститьТабличныеЧасти();
		ВидНФА = ДополнительныеПараметры.ВидНФА;
		ВидНФАПриИзменении(ДополнительныеПараметры.Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаНФА(Инициализация = Ложь)
	
	СчетУчетаПоУмолчанию = Документы.ИнвентаризацияОС.ПолучитьСчетУчетаПоУмолчанию(Объект, ВидНФА, ВариантыВидовНФА);	
	
	ПрименитьСчетУчетаПоУмолчаниюСервер();
	
	СписокСчетовСтрокой = ВариантыВидовНФА.Получить(ВидНФА);
	
	ВестиУчетПоПодразделениям = ЭтаФорма.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(СписокСчетовСтрокой).УчетПоПодразделениям;
		
	НастроитьДоступностьПолейОтбора(Инициализация);
	
	НастроитьКолонкуИнвНомер();
	
	НастроитьСписокВыбораСчета(СписокСчетовСтрокой);
	
	НастроитьВидимостьКолонкиЕдИзм();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьКолонкуИнвНомер()
	
	ИспользуетсяКолонкаИнвНомер = Документы.ИнвентаризацияОС.ИспользуетсяКолонкаИнвНомер(Объект);
	
	Элементы.Инвентаризация194нГруппаОС.Заголовок = ?(ВидНФА = "9",
		?(ИспользуетсяКолонкаИнвНомер, НСтр("ru='Право пользования, Инв.№, Договор'"), НСтр("ru='Право пользования, Договор'")),
		НСтр("ru='Основное средство, Инв.№'"));
	
	Элементы.Инвентаризация194нИнвентарныйНомер.Видимость = ИспользуетсяКолонкаИнвНомер;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокВыбораСчета(СписокСчетовСтрокой)
	
	СписокСчетов = СтрРазделить(СписокСчетовСтрокой, ",", Ложь);
	
	Если СписокСчетов.Количество() > 1 Тогда
		СписокСчетов.Удалить(0);
	КонецЕсли;
	
	ОграничениеСчетов = Новый ФиксированныйМассив(СписокСчетов);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКолонкиЕдИзм()
	
	НовВидимость = ИнвентаризацияСервер.УстанавливатьКоличествоПоУмолчанию(Объект);
	
	Элементы.Инвентаризация194нЕдИзм.Видимость = НовВидимость;
	
КонецПроцедуры

&НаСервере
Процедура СчетУчетаПриИзмененииСервер()
	
	Если НЕ ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		Объект.СчетУчета = СчетУчетаПоУмолчанию;
	КонецЕсли;
	
	КэшироватьСвойстваСчетаУчетаСервер();
	
	Если ВидНФА = "" Тогда
		УстановитьВидНФАПоСчету();
		
		НастроитьТипыВыбораМОЛ();
		
		СогласоватьЗначениеЦМО();
	КонецЕсли;
	
	НастроитьДоступностьПолейОтбора();
	
	НастроитьКолонкуИнвНомер();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьПолейОтбора(Инициализация = Ложь)
	
	ДоступностьПолейОтбора = ПолучитьДоступностьПолейОтбора();
	
	КПСДоступен = ДоступностьПолейОтбора.КПС;
	Элементы.КПС.ТолькоПросмотр = Не КПСДоступен; 
	Если Не Инициализация И Не КПСДоступен Тогда
		Объект.КПС = ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка");
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	КонтрагентДоступен = ДоступностьПолейОтбора.Контрагент;
	Элементы.Контрагент.ТолькоПросмотр = Не КонтрагентДоступен; 
	Если Не Инициализация И Не КонтрагентДоступен Тогда
		Объект.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	ДоговорДоступен = ДоступностьПолейОтбора.Договор;
	Элементы.Договор.ТолькоПросмотр = Не ДоговорДоступен; 
	Если Не Инициализация И Не ДоговорДоступен Тогда
		Объект.Договор = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	Элементы.НастройкаПорядкаПодразделение.Видимость 	= ВестиУчетПоПодразделениям;
	Элементы.НедостачиПодразделение.Видимость			= ВестиУчетПоПодразделениям;
	Элементы.ИзлишкиПодразделение.Видимость				= ВестиУчетПоПодразделениям;
	
	Элементы.Инвентаризация194нДоговор.Видимость = ДоговорДоступен;
	
КонецПроцедуры
	
