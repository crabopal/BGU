КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВосстановитьИзКэшаДатаИнвентаризации(Форма)
	
	Форма.Объект["ДатаИнвентаризации"] = Форма["КэшДатаИнвентаризации"];
	
КонецПроцедуры
	
&НаСервере
Процедура КэшироватьСвойстваСчетаУчетаСервер()
	
	ВремСтруктура = Новый Структура("
		|ДатаНачалаДействия,
		|ДатаОкончанияДействия");
	
	Если ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		
		ВремСтруктура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СчетУчета, "ДатаНачалаДействия,ДатаОкончанияДействия");
		
	КонецЕсли;
	
	КэшСвойстваСчетаУчета = Новый ФиксированнаяСтруктура(ВремСтруктура);
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьСчетУчетаПоУмолчаниюСервер()
	
	СписокСчетовСтрокой = ВариантыВидовНФА[ВидНФА];
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(
		СписокСчетовСтрокой,
		Объект.ДатаИнвентаризации,
		,
		Объект.Организация);
	
	СчетВИерархии = (СписокСчетов.Найти(Объект.СчетУчета) <> Неопределено);
	
	Если СчетВИерархии Тогда
		Возврат;
	КонецЕсли;
	
	СчетИзменится = (Объект.СчетУчета <> СчетУчетаПоУмолчанию);
	
	Если СчетИзменится Тогда
		Объект.СчетУчета = СчетУчетаПоУмолчанию;
		
		КэшироватьСвойстваСчетаУчетаСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	Если ИнвентаризацияКлиент.СчетДействуетНаДату(КэшСвойстваСчетаУчета, Объект.ДатаИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СчетУчета = Неопределено;
	
	КэшироватьСвойстваСчетаУчетаСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ОбновитьКэшДатаИнвентаризации(ЭтаФорма);
		
		ЗаполнитьВариантыВидовНФА();
		
		ПриИзмененииВидаНФА();
		
		ЭтаФорма.Модифицированность = Истина;
		
		// Прослеживаемость
		НастроитьФормуПрослеживаемостьСервер();
		// Конец Прослеживаемость
		
	Иначе
		
		ВосстановитьИзКэшаДатаИнвентаризации(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	// Проверим корректность входных данных для заполнения.
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Огранизация"" не заполнено'"),
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект.Ссылка,
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

