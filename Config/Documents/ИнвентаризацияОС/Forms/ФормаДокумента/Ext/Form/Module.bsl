&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//
	// 1. Инвентаризация - Цена не редактируется при наличии данных по учету
	//
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Инвентаризация - Цена не редактируется при наличии данных по учету";
	
	// Условия
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Инвентаризация.КоличествоБУ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвентаризацияЦена");
	
	//
	// 2. Инвентаризация194н - надпись "кол-во"
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Инвентаризация194н - надпись ""кол-во""";
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Ложь;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='кол-во'"));
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Инвентаризация194нПолеНадписьКоличество");
	
	//
	// 3. Инвентаризация194н - надпись "сумма"
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Инвентаризация194н - надпись ""сумма""";
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Ложь;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='сумма'"));
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Инвентаризация194нПолеНадписьСумма");
	
	//
	// Надпись инв.номера <отсутствует>
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Надпись инв.номера <отсутствует>";
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Инвентаризация.ИнвентарныйНомер");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<отсутствует>'"));
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Инвентаризация194нИнвентарныйНомер");
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеКолонкаЕдИзм(ЭтаФорма, "Инвентаризация", "Инвентаризация194н", Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКэшДатаИнвентаризации(Форма)
	
