&НаСервере
Процедура ДобавитьОСПоШтрихкоду(Штрихкод)
	
	РезультатПоиска = РегистрыСведений.Штрихкоды.НайтиОбъектПоШтрихкоду(Штрихкод);
	
	Если Не ЗначениеЗаполнено(РезультатПоиска.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок = Объект.Инвентаризация.НайтиСтроки(РезультатПоиска);
	
	Если МассивСтрок.Количество() = 0 Тогда
		СтрокаТаблицы = Объект.Инвентаризация.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатПоиска);
	Иначе
		СтрокаТаблицы = МассивСтрок[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
		СтрокаТаблицы.КоличествоФУ = 1;
	Иначе
		СтрокаТаблицы.КоличествоФУ = СтрокаТаблицы.КоличествоФУ + 1;
	КонецЕсли;
	
	ИнвентаризацияКлиентСервер.Редактирование0504087_ПересчитатьСтрокуИнвентаризацииОС(СтрокаТаблицы);
	
КонецПроцедуры

