&НаСервере
Функция ТипыЗначенияМОЛпоВидуНФА()
	
	Перем НомерСубконтоЦМО;
	
	СчетОтбор = Документы.ИнвентаризацияОС.ПолучитьСчетУчетаОтбор(Объект, ВидНФА, ВариантыВидовНФА, СчетУчетаПоУмолчанию);
	
	НомераСубконто = Документы.ИнвентаризацияОС.ПолучитьНомераСубконто(СчетОтбор);
	
	НомераСубконто.Свойство("ЦМО", НомерСубконтоЦМО);
	
	ТипыЗначения = Новый Массив();
	
	Если НомерСубконтоЦМО <> Неопределено Тогда
		ТипыЗначения.Добавить(Тип("СправочникСсылка.ЦМО"));
		ТипыЗначения.Добавить(Тип("СправочникСсылка.Сотрудники"));
	Иначе
		ТипыЗначения.Добавить(Тип("СправочникСсылка.Контрагенты"));
	КонецЕсли;
	
	Возврат ТипыЗначения;
	
КонецФункции

&НаСервере
Процедура НастроитьТипыВыбораМОЛ()
	
	Элементы["ЦМО"].ОграничениеТипа = Новый ОписаниеТипов(ТипыЗначенияМОЛпоВидуНФА());
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступностьПолейОтбора()
	
	Перем	НомерСубконтоЦМО,
			НомерСубконтоКонтрагенты,
			НомерСубконтоДоговоры;
	
	СчетОтбор = Документы.ИнвентаризацияОС.ПолучитьСчетУчетаОтбор(Объект, ВидНФА, ВариантыВидовНФА, СчетУчетаПоУмолчанию);
	
	НомераСубконто = Документы.ИнвентаризацияОС.ПолучитьНомераСубконто(СчетОтбор);
	
	НомераСубконто.Свойство("ЦМО",			НомерСубконтоЦМО);
	НомераСубконто.Свойство("Контрагенты",	НомерСубконтоКонтрагенты);
	НомераСубконто.Свойство("Договоры",		НомерСубконтоДоговоры);
	
	ПризнакиВеденияУчета = Документы.ИнвентаризацияОС.ПолучитьПризнакиВеденияУчета(СчетОтбор);
	
	ДоступностьПолейОтбора = Новый Структура();
	ДоступностьПолейОтбора.Вставить("Контрагент",	НомерСубконтоЦМО <> Неопределено И НомерСубконтоКонтрагенты <> Неопределено);
	ДоступностьПолейОтбора.Вставить("Договор",		НомерСубконтоДоговоры <> Неопределено);
	ДоступностьПолейОтбора.Вставить("КПС",			ПризнакиВеденияУчета.УчетПоКПС);
	
	Возврат ДоступностьПолейОтбора;
	
КонецФункции
	
&НаСервере
Процедура СогласоватьЗначениеЦМО()
	
	Если НЕ ЗначениеЗаполнено(Объект.ЦМО) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыЗначенияМОЛ = ТипыЗначенияМОЛпоВидуНФА();
	
	Если ТипыЗначенияМОЛ.Найти(ТипЗнч(Объект.ЦМО)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ЦМО = Неопределено;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыОС(Знач ОсновноеСредство, Знач ЦМО, Знач ДатаДок, Знач ОперативныйУчет)
	
	Результат = Новый Структура("Счет,ИнвентарныйНомер,ПрослеживаемыйТовар");
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, ДатаДок);
	
	Результат.Вставить("ПрослеживаемыйТовар", ДанныеОбъектаОС.ПрослеживаемыйТовар);
	
	// пробуем получить инвентарный номер
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомер
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ЦМО = &ЦМО
	|				И ВидРаспоряжения = &ВидРаспоряжения) КАК СтоимостьОбъектовОСОстатки");  

	Если ТипЗнч(ЦМО) = Тип("СправочникСсылка.Сотрудники") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЦМО = &ЦМО", "ЦМО.Сотрудник = &ЦМО");
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", 			ДатаДок);
	Запрос.УстановитьПараметр("Организация", 		ДанныеОбъектаОС.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство",	ОсновноеСредство);
	Запрос.УстановитьПараметр("ЦМО", 				ЦМО);
	Запрос.УстановитьПараметр("ВидРаспоряжения",	?(ОперативныйУчет,
						Перечисления.ВидыРаспоряженияОС.ОперативныйУчет,
						Перечисления.ВидыРаспоряженияОС.НаБалансе));
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Количество() = 1 Тогда
		РезультатЗапроса.Следующий();
		Результат.Вставить("ИнвентарныйНомер", РезультатЗапроса.ИнвНомер);
	КонецЕсли;
	
	Если ОперативныйУчет Тогда
		Результат.Вставить("Счет", УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(ДанныеОбъектаОС.СчетУчета));
	Иначе
		Результат.Вставить("Счет", ДанныеОбъектаОС.СчетУчета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура РаспределитьИзлишки()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ТаблицаИзлишки = Объект.Излишки.Выгрузить();
	ТаблицаИзлишки.Колонки.Добавить("Использовано", Новый ОписаниеТипов("Булево"));
	ТаблицаИзлишки.ЗаполнитьЗначения(Ложь, "Использовано");
	Объект.Излишки.Очистить();
	
	ТаблицаИнвентаризация = Объект.Инвентаризация.Выгрузить(Новый Структура("КоличествоНедостач", 0));
	
	Для каждого ТекИзлишек Из ТаблицаИнвентаризация Цикл
		
		Если ТекИзлишек.КоличествоИзлишков = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекИзлишек.ИнвентарныйНомер) Тогда
			
			СтруктураОтбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
			
		Иначе
			
			СтруктураОтбор = Новый Структура("ОсновноеСредство");
			
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтруктураОтбор, ТекИзлишек);
		
		КоличествоИзлишек = ТекИзлишек.КоличествоИзлишков;
		
		СтрокиИзлишков = ТаблицаИзлишки.НайтиСтроки(СтруктураОтбор);
		Для каждого СтрокаИзлишков Из СтрокиИзлишков Цикл
		
			Если КоличествоИзлишек <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если НЕ СтрокаИзлишков.Использовано И ЗначениеЗаполнено(СтрокаИзлишков.Документ) Тогда
				НоваяСтрокаИзлишков = Объект.Излишки.Добавить();
			    ЗаполнитьЗначенияСвойств(НоваяСтрокаИзлишков, СтрокаИзлишков);
				КоличествоИзлишек = КоличествоИзлишек - НоваяСтрокаИзлишков.Количество;
				СтрокаИзлишков.Использовано = Истина;
			КонецЕсли;
		
		КонецЦикла; 
		
		Если КоличествоИзлишек > 0 Тогда
			
			НоваяСтрокаИзлишков = Объект.Излишки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаИзлишков, ТекИзлишек);
			НоваяСтрокаИзлишков.Количество = КоличествоИзлишек;
			НоваяСтрокаИзлишков.Сумма = НоваяСтрокаИзлишков.Количество * НоваяСтрокаИзлишков.Цена;
			
		КонецЕсли;
	
	КонецЦикла; 
	
	Для каждого СтрокаИзлишков Из ТаблицаИзлишки Цикл
		
		Если НЕ СтрокаИзлишков.Использовано И ЗначениеЗаполнено(СтрокаИзлишков.Документ) Тогда
			НоваяСтрокаИзлишков = Объект.Излишки.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрокаИзлишков, СтрокаИзлишков);
		КонецЕсли;
	
	КонецЦикла; 
	
	ЗаполнитьСтатусыДокументов();
	Модифицированность = Истина;

КонецПроцедуры


&НаСервере
Функция СтруктураОтбораПоПорядку()

	ОтборПоПорядку = Новый Структура("КФО, ЦМО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ОтборПоПорядку.Вставить("ИФО");
	КонецЕсли;
	Если ВестиУчетПоПодразделениям Тогда
		ОтборПоПорядку.Вставить("Подразделение");
	КонецЕсли;
	Возврат ОтборПоПорядку;	

КонецФункции

&НаСервере
Процедура РаспределитьНедостачи()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ТаблицаОстатки 			= Объект.Остатки.Выгрузить();
	ТаблицаПорядок 			= Объект.НастройкаПорядка.Выгрузить();
	ТаблицаНедостачи 		= Объект.Недостачи.Выгрузить();
	ТаблицаНедостачи.Колонки.Добавить("Использовано", Новый ОписаниеТипов("Булево"));
	ТаблицаНедостачи.ЗаполнитьЗначения(Ложь, "Использовано");
	Объект.Недостачи.Очистить();
	
	ТаблицаИнвентаризация	= Объект.Инвентаризация.Выгрузить(Новый Структура("КоличествоИзлишков", 0));
	
	Для каждого СтрокаИнвентаризации Из ТаблицаИнвентаризация Цикл
		
		Если СтрокаИнвентаризации.КоличествоНедостач = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаИнвентаризации.ИнвентарныйНомер) Тогда
			СтруктураОтбора = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
		Иначе
			СтруктураОтбора = Новый Структура("ОсновноеСредство");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаИнвентаризации);
		КоличествоНедостачи = СтрокаИнвентаризации.КоличествоНедостач;
		
		ТекущиеНедостачи = ТаблицаНедостачи.НайтиСтроки(СтруктураОтбора);
		Для каждого ТекНедостача Из ТекущиеНедостачи Цикл
			Если КоличествоНедостачи <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если Не ТекНедостача.Использовано И ЗначениеЗаполнено(ТекНедостача.Документ) Тогда
				НоваяСтрокаНедостач = Объект.Недостачи.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНедостач, ТекНедостача);
				КоличествоНедостачи = КоличествоНедостачи - НоваяСтрокаНедостач.Количество;
				ТекНедостача.Использовано = Истина;
			КонецЕсли;
		
		КонецЦикла; 
		
		ТекущиеОстатки = Объект.Остатки.Выгрузить(СтруктураОтбора);
		
		
		Если КоличествоНедостачи > 0 Тогда
			
			Для каждого ТекущийПорядок Из ТаблицаПорядок Цикл
				
				ОтборПоПорядку = СтруктураОтбораПоПорядку();
				
				ЗаполнитьЗначенияСвойств(ОтборПоПорядку, ТекущийПорядок);
				ОтборПоПорядку.Вставить("ОсновноеСредство", СтрокаИнвентаризации.ОсновноеСредство);
				Если ЗначениеЗаполнено(СтрокаИнвентаризации.ИнвентарныйНомер) Тогда
					ОтборПоПорядку.Вставить("ИнвентарныйНомер", СтрокаИнвентаризации.ИнвентарныйНомер);
				КонецЕсли;
				
				СтрокиОстатков = Объект.Остатки.Выгрузить(ОтборПоПорядку);
				
				Для каждого ТекСтрокаОстатков Из СтрокиОстатков Цикл
				
					НоваяСтрокаНедостач = Объект.Недостачи.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаНедостач, ТекСтрокаОстатков);
					НоваяСтрокаНедостач.Количество = Мин(КоличествоНедостачи, ТекСтрокаОстатков.Количество);
					НоваяСтрокаНедостач.КоличествоБУ = ТекСтрокаОстатков.Количество;
					
					КоличествоНедостачи = КоличествоНедостачи - НоваяСтрокаНедостач.Количество;
					
					Если КоличествоНедостачи = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла; 
				
				Если КоличествоНедостачи = 0 Тогда
					Прервать;
				КонецЕсли;
			
			КонецЦикла; 
			
			
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ТекНедостача Из ТаблицаНедостачи Цикл
	
		Если ЗначениеЗаполнено(ТекНедостача.Документ) И Не ТекНедостача.Использовано Тогда
			ЗаполнитьЗначенияСвойств(Объект.Недостачи.Добавить(), ТекНедостача);
		КонецЕсли;
	
	КонецЦикла; 
	
	ЗаполнитьСтатусыДокументов();
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуНедостач(ТекущийИдентификатор)

	ТекущаяСтрока = Объект.Недостачи.НайтиПоИдентификатору(ТекущийИдентификатор);
	ОтборСтроки = Новый Структура;
	ОтборСтроки.Вставить("ОсновноеСредство", ТекущаяСтрока.ОсновноеСредство);
	ОтборСтроки.Вставить("ИнвентарныйНомер", ТекущаяСтрока.ИнвентарныйНомер);
	
	СтрокиОС = Объект.Остатки.Выгрузить(ОтборСтроки);
	Если СтрокиОС.Количество() = 1 Тогда
		ТекущаяСтрокаОС = СтрокиОС[0];
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекущаяСтрокаОС);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Функция ЗапрещеноРедактированиеРеквизитовСтроки(ТекущиеДанные)

	Возврат ТекущиеДанные.СостояниеДокумента = 0;	

КонецФункции

&НаСервере
Процедура ДобавитьСообщениеОбОшибке(Источник, ИнформацияОбОшибке, МассивСообщенийПользователю)
	
	ОписаниеДляПользователя = ?(ИнформацияОбОшибке.Причина = Неопределено, 
								ИнформацияОбОшибке.Описание, 
								ИнформацияОбОшибке.Причина.Описание);
	ТекстОшибкиДляЖР = "{" + ИнформацияОбОшибке.ИмяМодуля 
					 + "(" + СтрЗаменить(ИнформацияОбОшибке.НомерСтроки, Символы.НПП, "") + ")}: "
					 + ИнформацияОбОшибке.Описание + "
						|				"+ИнформацияОбОшибке.ИсходнаяСтрока 
					 + ?(ИнформацияОбОшибке.Причина = Неопределено, 
					 	 "", 
						 Символы.ПС + "по причине:" +Символы.ПС+ИнформацияОбОшибке.Причина.Описание);
	ЗаписьЖурналаРегистрации(ПредставлениеСобытияЖурналаРегистрации("_$Data$_.Post"),
							 УровеньЖурналаРегистрации.Ошибка,
							 Источник.Метаданные(),
							 Источник,
							 ТекстОшибкиДляЖР);
	МассивСообщенийПользователю.Добавить(Новый Структура("ТекстСообщенияПользователю,КлючДанных",
														  ОписаниеДляПользователя+": "+Источник, Источник));				

КонецПроцедуры

