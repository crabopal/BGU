&НаКлиенте
Функция СтандартнаяОбработкаРедактированияРеквизитаТЧ(Знач Элемент)

	Пока Элемент.Родитель <> Неопределено И ТипЗнч(Элемент) <> Тип("ТаблицаФормы") Цикл
	
		Элемент = Элемент.Родитель;
	
	КонецЦикла; 
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы")
		И ЗапрещеноРедактированиеРеквизитовСтроки(Элементы[Элемент.Имя].ТекущиеДанные) Тогда
		
		ПоказатьПредупреждение(,СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'По строке проведен документ %1. Изменение данных запрещено'"),
							?(Элемент.Имя = "Излишки",  НСтр("ru = 'оприходования'"), НСтр("ru = 'списания'"))),
						15);
		Возврат Ложь;
			
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;

