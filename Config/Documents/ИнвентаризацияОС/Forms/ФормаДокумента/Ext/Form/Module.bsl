&НаКлиенте
Процедура СоздатьДокументыПоИзлишкам()
	
	ВыделенныеСтроки = Элементы.Излишки.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"				, Объект.Организация);
	ПараметрыФормы.Вставить("СчетУчета"					, Объект.СчетУчета);
	ПараметрыФормы.Вставить("ВидДокументов"				, "ПринятиеКУчету");	
	ПараметрыФормы.Вставить("АдресВХранилище"			, ПолучитьДеревоПоИзлишкам(ВыделенныеСтроки, Истина)); 
	ПараметрыФормы.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);	
	ПараметрыФормы.Вставить("Контрагент"				, Объект.Контрагент);
	
	ОткрытьФорму("Документ.ИнвентаризацияОС.Форма.ВыборСоздаваемыхДокументов", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПолучитьДеревоПоИзлишкам(ВыделенныеСтроки, БлокироватьДанные = Ложь)
	
	Если БлокироватьДанные Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ТаблицаИзлишков = Объект.Излишки.Выгрузить();
	Иначе
		ТаблицаИзлишков = Объект.Излишки.Выгрузить();
		ТаблицаИзлишков.Очистить();
		Для каждого Идентификатор Из ВыделенныеСтроки Цикл
			
			ЗаполнитьЗначенияСвойств(ТаблицаИзлишков.Добавить(), Объект.Излишки.НайтиПоИдентификатору(Идентификатор));
		
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаИзлишков", ТаблицаИзлишков);
	Запрос.УстановитьПараметр("Счет101", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("101.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнвентаризацияОСИзлишки.НомерСтроки КАК НомерСтроки,
	|	ИнвентаризацияОСИзлишки.ИФО КАК ИФО,
	|	ИнвентаризацияОСИзлишки.КФО КАК КФО,
	|	ИнвентаризацияОСИзлишки.КПС КАК КПС,
	|	ИнвентаризацияОСИзлишки.Счет КАК Счет,
	|	ИнвентаризацияОСИзлишки.ОсновноеСредство КАК ОсновноеСредство,
