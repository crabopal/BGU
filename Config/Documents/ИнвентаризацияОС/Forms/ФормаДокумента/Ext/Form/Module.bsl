&НаКлиенте
Процедура ВыборРеквизитаБУ(ИмяРеквизита, НовоеЗначение, СтандартнаяОбработка)

	Если Объект[ИмяРеквизита] <> НовоеЗначение Тогда
		
		Если Объект.Инвентаризация.Итог("КоличествоБУ") <> 0 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ТекстВопроса = НСтр("ru = 'При изменении будет очищено количество ""по данным бухгалерского учета""
									|Изменить реквизит и очистить количество?'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить и очистить количество'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять'"));
			
			Оповещение = Новый ОписаниеОповещения("ВыборРеквизитаБУЗавершение", ЭтотОбъект, 
				Новый Структура("ИмяРеквизита, НовоеЗначение", ИмяРеквизита, НовоеЗначение));
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 15, КодВозвратаДиалога.Нет);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборРеквизитаБУЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Модифицированность = Истина;
		
		Объект[ДополнительныеПараметры.ИмяРеквизита] = ДополнительныеПараметры.НовоеЗначение;
		
		ОчиститьКоличествоБУ();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
