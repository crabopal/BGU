//

// 173н

&НаКлиенте
Процедура КомандаСоздатьДокументыПоНедостачамЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КомандаСоздатьДокументыПоНедостачамФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДокументыПоНедостачамФрагмент()
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	КонецЕсли;
	СоздатьДокументыПоНедостачам();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыПоНедостачам()
	
	ВыделенныеСтроки = Элементы.Недостачи.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"				, Объект.Организация);
	ПараметрыФормы.Вставить("СчетУчета"					, Объект.СчетУчета);
	ПараметрыФормы.Вставить("ВидДокументов"				, "Списание");	
	ПараметрыФормы.Вставить("АдресВХранилище"			, ПолучитьДеревоПоНедостачам(ВыделенныеСтроки)); 
	ПараметрыФормы.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);								 
	ПараметрыФормы.Вставить("Контрагент"				, Объект.Контрагент);
	
	ОткрытьФорму("Документ.ИнвентаризацияОС.Форма.ВыборСоздаваемыхДокументов", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДеревоПоНедостачам(ВыделенныеСтроки, БлокироватьДанные = Ложь)
	
	Если БлокироватьДанные Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ТаблицаНедостачи = Объект.Недостачи.Выгрузить();
	Иначе
		ТаблицаНедостачи = Объект.Недостачи.Выгрузить().СкопироватьКолонки();
		Для каждого Идентификатор Из ВыделенныеСтроки Цикл
			
			ТекСтр = Объект.Недостачи.НайтиПоИдентификатору(Идентификатор);
			Если ТекСтр <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаНедостачи.Добавить(), ТекСтр);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;		
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентаризацияОСНедостачи.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ИнвентаризацияОСНедостачи.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	ИнвентаризацияОСНедостачи.КФО КАК КФО,
	|	ИнвентаризацияОСНедостачи.КПС КАК КПС,
	|	ИнвентаризацияОСНедостачи.Счет КАК Счет,
	|	ИнвентаризацияОСНедостачи.ОсновноеСредство КАК ОсновноеСредство,
	|	ИнвентаризацияОСНедостачи.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ИнвентаризацияОСНедостачи.КоличествоБУ КАК КоличествоБУ,
	|	ИнвентаризацияОСНедостачи.Количество КАК Количество,
	|	ИнвентаризацияОСНедостачи.ЦМО КАК ЦМО,
	|	ВЫБОР
