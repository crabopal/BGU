&НаКлиенте
Процедура КомандаПровестиДокумент(Команда)
	ВыделенныеСтроки = ЭтаФорма.ТекущийЭлемент.ВыделенныеСтроки;
	Результат = ИзменитьПроведениеДокументов(ЭтаФорма.ТекущийЭлемент.Имя, 
											 ВыделенныеСтроки, 
											 РежимЗаписиДокумента.Проведение);
	ОбработаноДокументов = Результат.ОбработанныеДокументы;
	УспешноОбработанные	 = Результат.УспешноОбработанные;

	ПоказатьОповещениеПользователя(	НСтр("ru = 'Проведение документов'"),,
									СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
																 НСтр("ru = 'Обработано документов: %1
																			|Проведено: %2
																			|Не проведено: %3'"),
																ОбработаноДокументов,
																УспешноОбработанные,
																(ОбработаноДокументов - УспешноОбработанные)),
									БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьПроведениеДокумента(Команда) 
	ВыделенныеСтроки = ЭтаФорма.ТекущийЭлемент.ВыделенныеСтроки;
	Результат = ИзменитьПроведениеДокументов(ЭтаФорма.ТекущийЭлемент.Имя, 
											 ВыделенныеСтроки, 
											 РежимЗаписиДокумента.ОтменаПроведения);
	ОбработаноДокументов = Результат.ОбработанныеДокументы;
	УспешноОбработанные	 = Результат.УспешноОбработанные;

	ПоказатьОповещениеПользователя(	НСтр("ru = 'Отмена проведения документов'"),,
									СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
																 НСтр("ru = 'Обработано документов: %1
																			|Проведение отменено: %2
																			|Проведение не отменено: %3'"),
																 ОбработаноДокументов,
																 УспешноОбработанные,
																 (ОбработаноДокументов - УспешноОбработанные)),
									БиблиотекаКартинок.Информация32);
КонецПроцедуры

