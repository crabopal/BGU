// 52н

&НаКлиенте
Процедура КомандаСоздатьДокументыПоНедостачамЗавершение52н(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КомандаСоздатьДокументыПоНедостачамФрагмент52н();

КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДокументыПоНедостачамФрагмент52н()
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	КонецЕсли;
	СоздатьДокументыПоНедостачам52н();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыПоНедостачам52н()
	
	ВыделенныеСтроки = Элементы.Недостачи.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"				, Объект.Организация);
	ПараметрыФормы.Вставить("СчетУчета"					, Объект.СчетУчета);
	ПараметрыФормы.Вставить("ВидДокументов"				, "Списание");	
	ПараметрыФормы.Вставить("АдресВХранилище"			, ПолучитьДеревоПоНедостачам52н(ВыделенныеСтроки)); 
	ПараметрыФормы.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);
	ПараметрыФормы.Вставить("Контрагент"				, Объект.Контрагент);
	
	ОткрытьФорму("Документ.ИнвентаризацияОС.Форма.ВыборСоздаваемыхДокументов", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДеревоПоНедостачам52н(ВыделенныеСтроки, БлокироватьДанные = Ложь)
	
	Если БлокироватьДанные Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ТаблицаНедостачи = Объект.Недостачи.Выгрузить();
	Иначе
		ТаблицаНедостачи = Объект.Недостачи.Выгрузить().СкопироватьКолонки();
		Для каждого Идентификатор Из ВыделенныеСтроки Цикл
			
			ТекСтр = Объект.Недостачи.НайтиПоИдентификатору(Идентификатор);
			Если ТекСтр <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаНедостачи.Добавить(), ТекСтр);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	ТаблицаНедостачи.Колонки.Добавить("ВидИмущества");
	ТаблицаНедостачи.Колонки.Добавить("Транспорт");
	
	ТипыНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаНедостачи.ВыгрузитьКолонку("ОсновноеСредство"), "ТипНФА");
	
	Для Каждого ТекСтрокаНедостачи Из ТаблицаНедостачи Цикл
		
		ТекСтрокаНедостачи.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ТекСтрокаНедостачи.Счет);
		ТекСтрокаНедостачи.Транспорт = (ТипыНФА[ТекСтрокаНедостачи.ОсновноеСредство] = Перечисления.ТипыНФА.Транспорт);
		
	КонецЦикла;

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("НомерСтроки");
	Дерево.Колонки.Добавить("ИФО");
	Дерево.Колонки.Добавить("КФО");
	Дерево.Колонки.Добавить("КПС");
	Дерево.Колонки.Добавить("Счет");
	Дерево.Колонки.Добавить("ОсновноеСредство");
	Дерево.Колонки.Добавить("ИнвентарныйНомер");
	Дерево.Колонки.Добавить("Количество");
	Дерево.Колонки.Добавить("ЦМО");
	Дерево.Колонки.Добавить("Подразделение");
	Дерево.Колонки.Добавить("Документ");
	Дерево.Колонки.Добавить("ГрупповойУчет");
	Дерево.Колонки.Добавить("ПолеСоединения");
	Дерево.Колонки.Добавить("ИмяДокумента");
	Дерево.Колонки.Добавить("ВидДокумента");
	Дерево.Колонки.Добавить("ПолноеИмяДокумента");
	Дерево.Колонки.Добавить("Ключ");
	Дерево.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	Дерево.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	ТаблицаГруппировок = ТаблицаНедостачи.Скопировать(,"ИФО,КФО,ЦМО,Подразделение,ВидИмущества,Транспорт");
	ТаблицаГруппировок.Свернуть("ИФО,КФО,ЦМО,Подразделение,ВидИмущества,Транспорт");
	Отбор = Новый Структура("ИФО,КФО,ЦМО,Подразделение,ВидИмущества,Транспорт");
	ОтборОстатки = Новый Структура("ИФО,КФО,КПС,Счет,ОсновноеСредство,ЦМО,Подразделение,ИнвентарныйНомер");
	
	Если ВидНФА = "8" Тогда
		ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ОперацияБух"));
	Иначе
		ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	КонецЕсли;	
	ДанныеОМ = Новый Структура;
	ДанныеОМ.Вставить("ИмяДокумента", ИОМ.Имя);
	ДанныеОМ.Вставить("ВидДокумента", ИОМ.Ссылка);
	ДанныеОМ.Вставить("ПолноеИмяДокумента", ИОМ.ПолноеИмя);
	
	ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СписаниеТранспорта"));
	ДанныеОМТ = Новый Структура;
	ДанныеОМТ.Вставить("ИмяДокумента", ИОМ.Имя);
	ДанныеОМТ.Вставить("ВидДокумента", ИОМ.Ссылка);
	ДанныеОМТ.Вставить("ПолноеИмяДокумента", ИОМ.ПолноеИмя);
	
	Для каждого СтрокаГруппировки Из ТаблицаГруппировок Цикл
	
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаГруппировки);
		СтрокиДокумента = ТаблицаНедостачи.НайтиСтроки(Отбор);
		
		ВеткаДерева = Дерево.Строки.Добавить();
		Для каждого ТекСтрокаДокумента Из СтрокиДокумента Цикл
		
			ЛистДерева = ВеткаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(ЛистДерева, ТекСтрокаДокумента);
			Если ТекСтрокаДокумента.Транспорт Тогда
				ЗаполнитьЗначенияСвойств(ЛистДерева, ДанныеОМТ);
			Иначе
				ЗаполнитьЗначенияСвойств(ЛистДерева, ДанныеОМ);
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОтборОстатки, ТекСтрокаДокумента);
			
			// получить цену
			СтрокиОстатков = Объект.Остатки.НайтиСтроки(ОтборОстатки);
			Если СтрокиОстатков.Количество() > 0 Тогда
				Если ЛистДерева.Количество = СтрокиОстатков[0].Количество Тогда
					ЛистДерева.Сумма = СтрокиОстатков[0].СтоимостьБалансовая;
				ИначеЕсли СтрокиОстатков[0].Количество <> 0 Тогда
					ЛистДерева.Сумма = ЛистДерева.Количество * СтрокиОстатков[0].СтоимостьБалансовая / СтрокиОстатков[0].Количество;
				КонецЕсли;
			КонецЕсли;
			Если ЛистДерева.Количество <> 0 Тогда
				ЛистДерева.Цена = ЛистДерева.Сумма / ЛистДерева.Количество;
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Дерево, УникальныйИдентификатор);
	
КонецФункции


&НаКлиенте
Процедура СоздатьДокументыПоИзлишкам52()
	
	ВыделенныеСтроки = Элементы.Излишки.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"				, Объект.Организация);
	ПараметрыФормы.Вставить("СчетУчета"					, Объект.СчетУчета);
	ПараметрыФормы.Вставить("ВидДокументов"				, "ПринятиеКУчету");	
	ПараметрыФормы.Вставить("АдресВХранилище"			, ПолучитьДеревоПоИзлишкам52(ВыделенныеСтроки, Истина)); 
	ПараметрыФормы.Вставить("ВестиУчетПоПодразделениям"	, ВестиУчетПоПодразделениям);
	ПараметрыФормы.Вставить("Контрагент"				, Объект.Контрагент);
	
	ОткрытьФорму("Документ.ИнвентаризацияОС.Форма.ВыборСоздаваемыхДокументов", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПолучитьДеревоПоИзлишкам52(ВыделенныеСтроки, БлокироватьДанные = Ложь)
	
	Если БлокироватьДанные Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ТаблицаИзлишков = Объект.Излишки.Выгрузить();
	Иначе
		ТаблицаИзлишков = Объект.Излишки.Выгрузить();
		ТаблицаИзлишков.Очистить();
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
			
			ЗаполнитьЗначенияСвойств(ТаблицаИзлишков.Добавить(), Объект.Излишки.НайтиПоИдентификатору(Идентификатор));
		
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаИзлишков.Колонки.Добавить("ВидИмущества");
	
	Для Каждого ТекСтрокаИзлишков Из ТаблицаИзлишков Цикл
	
		ТекСтрокаИзлишков.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ТекСтрокаИзлишков.Счет);
	
	КонецЦикла;

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("НомерСтроки");
	Дерево.Колонки.Добавить("ИФО");
	Дерево.Колонки.Добавить("КФО");
	Дерево.Колонки.Добавить("КПС");
	Дерево.Колонки.Добавить("Счет");
	Дерево.Колонки.Добавить("ОсновноеСредство");
	Дерево.Колонки.Добавить("ИнвентарныйНомер");
	Дерево.Колонки.Добавить("Количество");
	Дерево.Колонки.Добавить("ЦМО");
	Дерево.Колонки.Добавить("Подразделение");
	Дерево.Колонки.Добавить("Документ");
	Дерево.Колонки.Добавить("ГрупповойУчет");
	Дерево.Колонки.Добавить("ПолеСоединения");
	Дерево.Колонки.Добавить("ИмяДокумента");
	Дерево.Колонки.Добавить("ВидДокумента");
	Дерево.Колонки.Добавить("ПолноеИмяДокумента");
	Дерево.Колонки.Добавить("Ключ");
	Дерево.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	Дерево.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	ПоляГруппировок = "ИФО,КФО,ЦМО,Подразделение,ВидИмущества";
	ТаблицаГруппировок = ТаблицаИзлишков.Скопировать(, ПоляГруппировок);
	ТаблицаГруппировок.Свернуть(ПоляГруппировок);
	Отбор = Новый Структура(ПоляГруппировок);
	
	Если ВидНФА = "8" Тогда
		ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПоступлениеНФАпоЦС"));
	Иначе	
		ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	КонецЕсли;	
	ДанныеОМ = Новый Структура;
	ДанныеОМ.Вставить("ИмяДокумента", ИОМ.Имя);
	ДанныеОМ.Вставить("ВидДокумента", ИОМ.Ссылка);
	ДанныеОМ.Вставить("ПолноеИмяДокумента", ИОМ.ПолноеИмя);
	
	Для Каждого СтрокаГруппировки Из ТаблицаГруппировок Цикл
	
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаГруппировки);
		СтрокиДокумента = ТаблицаИзлишков.НайтиСтроки(Отбор);
		
		ВеткаДерева = Дерево.Строки.Добавить();
		Для Каждого ТекСтрокаДокумента Из СтрокиДокумента Цикл
		
			ЛистДерева = ВеткаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(ЛистДерева, ТекСтрокаДокумента);
			ЗаполнитьЗначенияСвойств(ЛистДерева, ДанныеОМ);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Дерево, УникальныйИдентификатор);

КонецФункции

// Общие

&НаСервере
Процедура ОбновитьДокументыПоИзлишкам(АдресВХранилище)

	Если НЕ ЭтоАдресВременногоХранилища(АдресВХранилище) Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоДокументов = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаИзлишки Тогда
		
		Для каждого ТекСтр Из ДеревоДокументов.Строки Цикл
			
			Если ТекСтр.НомерСтрокиДокумента<0 Тогда
				Для каждого ТекСтр1 Из ТекСтр.Строки Цикл
					Объект.Излишки[ТекСтр1.НомерСтрокиДокумента-1].Документ = ТекСтр1.Документ;
				КонецЦикла; 
			Иначе
				Объект.Излишки[ТекСтр.НомерСтрокиДокумента-1].Документ = ТекСтр.Документ;
			КонецЕсли;
		
		КонецЦикла;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаНедостачи Тогда
		
		Для каждого ТекСтр Из ДеревоДокументов.Строки Цикл
			
			Если ТекСтр.НомерСтрокиДокумента<0 Тогда
				Для каждого ТекСтр1 Из ТекСтр.Строки Цикл
					Объект.Недостачи[ТекСтр1.НомерСтрокиДокумента-1].Документ = ТекСтр1.Документ;
				КонецЦикла; 
			Иначе
				Объект.Недостачи[ТекСтр.НомерСтрокиДокумента-1].Документ = ТекСтр.Документ;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;

	ЗаполнитьСтатусыДокументов();
	
КонецПроцедуры

