&НаКлиенте
Процедура ВыгрузитьДанныеВТСД()
	#Если ВебКлиент Тогда
	ПоказатьПредупреждение(,НСтр("ru = 'Работа с торговым оборудованием не поддерживается в режиме веб-клиента.
					|Для использования терминала сбора данных запустите программу в режиме тонкого клиента.'"), 15);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Объекты не выгружены'"));
	Возврат;
	#КонецЕсли

	ОСБезШтрихкода = Неопределено;
	ТаблицаТСД = ТаблицаОСдляТСД(ОСБезШтрихкода);
	
	Если ОСБезШтрихкода.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Обнаружены объекты без штрихкода.
									|Объекты без штрихкода не будут выгружены в ТСД.
									|Открыть форму формирования штрихкода для данных объектов?'");
		Кнопки = Новый СписокЗначений();									
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Открыть форму формирования штрихкода'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Выгрузить в ТСД объекты со штрихкодом'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьДанныеВТСД_ПослеВопроса", ЭтотОбъект, Неопределено);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 15);
		
	Иначе
		ВыгрузитьДанныеВТСД_ВыполнитьВыгрузку();
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Функция ТаблицаОСдляТСД(ОСБезШтрихкода = Неопределено)
	ОСБезШтрихкода = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ОсновноеСредство,
	|	Т.ИнвентарныйНомер,
	|	Т.Цена,
	|	Т.КоличествоБУ КАК Количество
	|ПОМЕСТИТЬ Инвентаризация
	|ИЗ
	|	&Инвентаризация КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Инвентаризация.ОсновноеСредство.Наименование Как ОсновноеСредство,
	|	Инвентаризация.ИнвентарныйНомер.Код Как ИнвентарныйНомер,
	|	Инвентаризация.Цена,
	|	ШтрихКоды.Штрихкод,
	|	Инвентаризация.Количество
	|ИЗ
	|	Инвентаризация КАК Инвентаризация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|		ПО Инвентаризация.ОсновноеСредство = ШтрихКоды.Объект
	|			И Инвентаризация.ИнвентарныйНомер = ШтрихКоды.ИнвентарныйНомер";
	Запрос.УстановитьПараметр("Инвентаризация", Объект.Инвентаризация.Выгрузить());
	
	МассивТСД = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ПустаяСтрока(Выборка.Штрихкод) Тогда
			
			ОСБезШтрихкода.Добавить(Новый Структура("Объект, ИнвентарныйНомер", 
													Выборка.ОсновноеСредство, 
													Выборка.ИнвентарныйНомер));
			
		Иначе
			
			НоваяСтрока = Новый Структура("Штрихкод, Номенклатура, Цена, Количество", 
										  Выборка.Штрихкод, 
										  СокрЛП(Выборка.ОсновноеСредство) + 
										  ?(ПустаяСтрока(Выборка.ИнвентарныйНомер), 
										  	"", 
											" инв:" + СокрЛП(Выборка.ИнвентарныйНомер)),
										  Выборка.Цена,
										  Выборка.Количество);
			МассивТСД.Добавить(НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивТСД;

КонецФункции

&НаКлиенте
Процедура ВыгрузитьДанныеВТСД_ПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		// открыть форму ввода штрихкода и
		// после закрытия перезаполнить таблицу ТСД
		ПараметрыФормы = Новый Структура("МассивОбъектов", АдресТаблицыДляСозданияШтрихкодов());
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьДанныеВТСД_ВыполнитьВыгрузку", ЭтотОбъект, Неопределено);
		ОткрытьФорму("РегистрСведений.ШтрихКоды.Форма.ФормаСозданияШтрихкодовОС", ПараметрыФормы, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Результат <> КодВозвратаДиалога.Нет Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Объекты не выгружены'"));
		Возврат;
	Иначе
		ВыгрузитьДанныеВТСД_ВыполнитьВыгрузку();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АдресТаблицыДляСозданияШтрихкодов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ШтрихКоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	|		ПО ТаблицаОС.ОсновноеСредство = ШтрихКоды.Объект
	|			И ТаблицаОС.ИнвентарныйНомер = ШтрихКоды.ИнвентарныйНомер";
	
	Запрос.УстановитьПараметр("ТаблицаОС", Объект.Инвентаризация.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер"));
	
	Возврат ПоместитьВоВременноеХранилище(Запрос.Выполнить().Выгрузить(), УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ВыгрузитьДанныеВТСД_ВыполнитьВыгрузку(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
