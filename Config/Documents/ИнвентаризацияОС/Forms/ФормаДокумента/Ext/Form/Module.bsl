	|ВЫБРАТЬ
	|	Таблица.Ссылка КАК Документ,
	|	ВЫБОР
	|		КОГДА Таблица.ПометкаУдаления
	|			ТОГДА 1
	|		КОГДА Таблица.Проведен
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СтатусДокумента
	|ИЗ
	|	Таблица КАК Таблица";		
	
	МассивДокументов = Новый Массив;
	Для Каждого ТекСтр Из Объект.Излишки Цикл
		Если ЗначениеЗаполнено(ТекСтр.Документ) И МассивДокументов.Найти(ТекСтр.Документ)=Неопределено Тогда
			МассивДокументов.Добавить(ТекСтр.Документ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекСтр Из Объект.Недостачи Цикл
		Если ЗначениеЗаполнено(ТекСтр.Документ) И МассивДокументов.Найти(ТекСтр.Документ)=Неопределено Тогда
			МассивДокументов.Добавить(ТекСтр.Документ);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Выборка = Запрос.Выполнить().Выгрузить();				   
	Для Каждого ТекСтр Из Объект.Излишки Цикл
	
		СтрТекСтр = Выборка.Найти(ТекСтр.Документ, "Документ");
		Если СтрТекСтр=Неопределено Тогда
			ТекСтр.СостояниеДокумента = 3;
		Иначе
			ТекСтр.СостояниеДокумента = СтрТекСтр.СтатусДокумента;
		КонецЕсли;
	
	КонецЦикла; 

	Для Каждого ТекСтр Из Объект.Недостачи Цикл
	
		СтрТекСтр = Выборка.Найти(ТекСтр.Документ, "Документ");
		Если СтрТекСтр = Неопределено Тогда
			ТекСтр.СостояниеДокумента = 3;
		Иначе
			ТекСтр.СостояниеДокумента = СтрТекСтр.СтатусДокумента;
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Функция ИзменитьПроведениеДокументов(ИмяТЧ, ВыделенныеСтроки, РежимЗаписи)

	ОбработанныеДокументы = Новый Массив;
	УспешноОбработанные = Новый Массив;
	МассивСообщенийПользователю = Новый Массив;
	Для каждого ТекВыделеннаяСтрока Из ВыделенныеСтроки Цикл
	
		ТекСтрока = Объект[ИмяТЧ].НайтиПоИдентификатору(ТекВыделеннаяСтрока);
		Если ЗначениеЗаполнено(ТекСтрока.Документ)
			И ОбработанныеДокументы.Найти(ТекСтрока.Документ) = Неопределено Тогда
			ОбработанныеДокументы.Добавить(ТекСтрока.Документ);
			
			ДокументОбъект = ТекСтрока.Документ.ПолучитьОбъект();
			Попытка
				ДокументОбъект.Записать(РежимЗаписи, РежимПроведенияДокумента.Неоперативный);
				УспешноОбработанные.Добавить(ТекСтрока.Документ);
				ИсторияРаботыПользователя.Добавить(ПолучитьНавигационнуюСсылку(ТекСтрока.Документ));
			Исключение
				ОписаниеОшибки = ИнформацияОбОшибке();
				ДобавитьСообщениеОбОшибке(ТекСтрока.Документ, ОписаниеОшибки, МассивСообщенийПользователю);
			КонецПопытки;
		КонецЕсли;
	
	КонецЦикла; 	
   	ЗаполнитьСтатусыДокументов();
	
	КоличествоСообщений = МассивСообщенийПользователю.ВГраница();
	ОграничениеЦикла = Мин(КоличествоСообщений, 9);
	Если (КоличествоСообщений - ОграничениеЦикла) < 3 Тогда
		ОграничениеЦикла = КоличествоСообщений;
	КонецЕсли;
	Для Индекс = 0 По ОграничениеЦикла Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(	
									 МассивСообщенийПользователю[Индекс].ТекстСообщенияПользователю,
									 МассивСообщенийПользователю[Индекс].КлючДанных);
	КонецЦикла;
	Если КоличествоСообщений > ОграничениеЦикла Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									 СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									 НСтр("ru = '.. и еще %1 ошибок. Подробности в журнале регистрации'"),
									 (КоличествоСообщений-ОграничениеЦикла)));
	КонецЕсли;
	
	Возврат Новый Структура("ОбработанныеДокументы, УспешноОбработанные", 
							 ОбработанныеДокументы.Количество(), 
							 УспешноОбработанные.Количество());
							 
КонецФункции

#Область РазбивкаСтрокиИнвентаризацииНФА

&НаКлиенте
Процедура ПослеРазбивкиСтрокиИнвентаризацииНфа(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы.Инвентаризация194нСуммаФУ;
	
	ИндексыСтрок = РезультатВыбора;
	
	Для Каждого ИндексСтроки Из ИндексыСтрок Цикл
		СтрокаТаблицы = Объект.Инвентаризация[ИндексСтроки];
		
		ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьФактическиеПоказатели(
			ЭтаФорма,
			СтрокаТаблицы,
			"СуммаФУ");
			
		ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(
			ЭтаФорма,
			СтрокаТаблицы,
			Истина);
	КонецЦикла;
	
КонецПроцедуры	

#КонецОбласти

#Область Прослеживаемость

&НаСервере
Процедура НастроитьФормуПрослеживаемостьСервер()
	
	ПрослеживаемостьФормыБГУ.НастроитьФормуИКолонкуПрослеживаемыйТовар(
		ЭтаФорма,
		Объект.ДатаИнвентаризации,
		"Инвентаризация",
		"ОсновноеСредство",
		"Инвентаризация194н");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПрослеживаемыеТовары(ТолькоИзлишки)
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		Если Объект["ПрослеживаемыеТовары"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением прослеживаемых товаров будет очищена
				|табличная часть ""Инвентаризация"".
				|
				|Продолжить и заполнить прослеживаемые товары?'");
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ТолькоИзлишки", ТолькоИзлишки);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПрослеживаемыеТовары_Выбор", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьПрослеживаемыеТоварыКлиент(ТолькоИзлишки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПрослеживаемыеТовары_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПрослеживаемыеТоварыКлиент(ПараметрыОповещения.ТолькоИзлишки);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПрослеживаемыеТоварыКлиент(ТолькоИзлишки)
	
	ЗаполнитьПрослеживаемыеТоварыСервер(ТолькоИзлишки);
	
	Если Объект["ПрослеживаемыеТовары"].Количество() = 0 Тогда
		
		ТекстШаблон = "%1
			|
			|%2";
		
		Если ТолькоИзлишки Тогда
			Текст1 = НСтр("ru='В излишках табличной части ""Инвентаризация"" не выявлены прослеживаемые ОС.'");
		Иначе
			Текст1 = НСтр("ru='В данных учёта табличной части ""Инвентаризация"" не выявлены прослеживаемые ОС.'");
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Текст1,
			НСтр("ru='Либо эти ОС в полном объеме уже были зарегистрированы в системе прослеживаемости ранее.
				|В этом случае не требуется их повторная регистрация.'"));
		
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьПрослеживаемыеТоварыСервер(ТолькоИзлишки)
	
	ПрослеживаемостьБГУ.ЗаполнитьПрослеживаемыеТовары(Объект, ТолькоИзлишки);
	
КонецПроцедуры

