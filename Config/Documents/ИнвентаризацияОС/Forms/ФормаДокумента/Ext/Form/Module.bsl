	ТекущиеДанные = Элементы.Инвентаризация194н.ТекущиеДанные;
	
	// Прослеживаемость
	ТекущиеДанные.ПрослеживаемыйТовар = Ложь;
	// Конец Прослеживаемость
	
	ЗаполнитьРеквизитыОСВТекущейСтроке(ТекущиеДанные);
	
	// Прослеживаемость
	ВозможноИзменениеВидимостиКолонкиПрослеживаемыйТовар = (ТекущиеДанные.ПрослеживаемыйТовар <> ЕстьПрослеживаемыеТовары);
	Если ВозможноИзменениеВидимостиКолонкиПрослеживаемыйТовар Тогда
		НастроитьФормуПрослеживаемостьСервер();
	КонецЕсли;
	// Конец Прослеживаемость
	
КонецПроцедуры

