#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект, ТолькоПересчитать = Ложь) Экспорт
	
	Перем ВариантыВидовНФА;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьОтборПоПодразделению = ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение);
	
	Объект = ДокументОбъект;
	
	Если НЕ ТолькоПересчитать Тогда
		Объект.Инвентаризация.Очистить();
	КонецЕсли;
	
	ВидНФА = ПолучитьВидНФАПоСчету(Объект, ВариантыВидовНФА);
	
	Если Документы.ИнвентаризацияОС.ЭтоИнвентаризация_11100(Объект) Тогда
		
		Документы.ИнвентаризацияОС.ЗаполнитьПоДаннымУчета_11100(Объект);
		
		Возврат;
		
	КонецЕсли;
	
	УстанавливатьКоличествоПоУмолчанию = Истина;
	
	КоличествоПоУмолчанию = ИнвентаризацияСервер.ПолучитьКоличествоПоУмолчанию();
	
	Если УстанавливатьКоличествоПоУмолчанию Тогда
		ВыбиратьНулевоеКоличество = Истина;
		ЗаменятьНулевоеКоличество = Истина;
	Иначе
		ВыбиратьНулевоеКоличество = Ложь;
		ЗаменятьНулевоеКоличество = Ложь;
	КонецЕсли;
	
	Если Объект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г. Счет в шапке
		
		ПоляВыбораВложенныйЗапрос = "Т.Счет	КАК Счет,";
		
		ПоляГруппировкиВложенныйЗапрос = ",Т.Счет";
		
		ПоляВыбораТаблицаИнвентаризация = "";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	ИначеЕсли Объект["ВариантФормированияОписи"] = 1 Тогда
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		
		ПоляВыбораВложенныйЗапрос = "
			|Т.Счет	КАК Счет,
			|Т.КПС	КАК КПС,
			|Т.КФО	КАК КФО,";
		
		ПоляГруппировкиВложенныйЗапрос = ",Т.Счет,КПС,КФО";
		
		ПоляВыбораТаблицаИнвентаризация = "
			|ВложенныйЗапрос.КПС	КАК КПС,
			|ВложенныйЗапрос.КФО	КАК КФО,";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	ИначеЕсли Объект["ВариантФормированияОписи"] = 2 Тогда
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		
		ПоляВыбораВложенныйЗапрос = "
			|Т.Счет			КАК Счет,
			|НЕОПРЕДЕЛЕНО	КАК КПС,
			|НЕОПРЕДЕЛЕНО	КАК КФО,";
		
		ПоляГруппировкиВложенныйЗапрос = ",Т.Счет";
		
		ПоляВыбораТаблицаИнвентаризация = "
			|ВложенныйЗапрос.КПС	КАК КПС,
			|ВложенныйЗапрос.КФО	КАК КФО,";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	Иначе
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		ПоляВыбораВложенныйЗапрос = "
			|БлижайшиеОбщиеРодителиСчетов.Счет	КАК Счет,
			|НЕОПРЕДЕЛЕНО						КАК КПС,
			|НЕОПРЕДЕЛЕНО						КАК КФО,";
		
		ПоляГруппировкиВложенныйЗапрос = ",БлижайшиеОбщиеРодителиСчетов.Счет";
		
		ПоляВыбораТаблицаИнвентаризация = "
			|ВложенныйЗапрос.КПС	КАК КПС,
			|ВложенныйЗапрос.КФО	КАК КФО,";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "
			|ЛЕВОЕ СОЕДИНЕНИЕ	БлижайшиеОбщиеРодителиСчетов
			|	ПО	Т.ОсновноеСредство = БлижайшиеОбщиеРодителиСчетов.НФА
			|	И	Т.ИнвентарныйНомер = БлижайшиеОбщиеРодителиСчетов.ИнвНомер";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = ИнвентаризацияСервер.ПолучитьТекстЗапросаБлижайшиеОбщиеРодителиСчетов(
			"ОстаткиПоИнвНомерам",
			"ОсновноеСредство",
			"ИнвентарныйНомер",
			СдвигИндексаВсехТаблиц);
		
	КонецЕсли;
	
	СчетОтбор = ПолучитьСчетУчетаОтбор(ДокументОбъект, ВидНФА, ВариантыВидовНФА);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0].
	|//
	|ВЫБРАТЬ
	|	ОСДокумента.ОсновноеСредство,
	|	ЕСТЬNULL(ОСДокумента.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ОСДокумента.КоличествоФУ,
	|	ОСДокумента.СуммаФУ,
	|	ОСДокумента.Счет
	|ПОМЕСТИТЬ ОСДокумента
	|ИЗ
	|	&ОСДокумента КАК ОСДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1].
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦМО.Ссылка
	|ПОМЕСТИТЬ ЦМО
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.Ссылка = &ЦМО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЦМО.Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.Сотрудник = &ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2].
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	[ВыборМОЛИзОстатковЕПСБУ] КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоОстатокДт
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В ИЕРАРХИИ (&Счет),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И КФО = &КФО
	|				И КПС = &КПС
	|				И ИФО = &ИФО
	|				И [ОтборПоМОЛИзОстатковЕПСБУ]
	|				И [ОтборПоКонтрагентуИзОстатковЕПСБУ]
	|				И [ОтборПоДоговоруИзОстатковЕПСБУ]
	|	) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьОтборПоПодразделению И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	[ВыборМОЛИзОстатковЕПСБУ],
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	
	|" + ?(ВыбиратьНулевоеКоличество, "", "
	|ИМЕЮЩИЕ
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) <> 0") + "
	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3].
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	|	[ВыборМОЛИзСтоимостиОбъектов] КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА СтоимостьОбъектовОСОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	СУММА(СтоимостьОбъектовОСОстатки.СтоимостьОстаток) КАК Сумма,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ИнвНомера
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|			И ВидРаспоряжения = &ВидРаспоряжения
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОстаткиБУ.ОсновноеСредство
	|					ИЗ
	|						ОстаткиБУ)
	|				И [ОтборПоМОЛИзСтоимостиОбъектов]
	|				И [ОтборПоКонтрагентуИзСтоимостиОбъектов]
	|				И [ОтборПоДоговоруИзСтоимостиОбъектов]
	|	) КАК СтоимостьОбъектовОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	|	[ВыборМОЛИзСтоимостиОбъектов],
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА СтоимостьОбъектовОСОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	
	|" + ?(ВыбиратьНулевоеКоличество, "", "
	|ИМЕЮЩИЕ
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) <> 0") + "
	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4].
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБУ.Счет,
	|	ОстаткиБУ.ОсновноеСредство,
	|	ОстаткиБУ.ЦМО,
	|	ОстаткиБУ.Подразделение,
	|	ОстаткиБУ.КПС,
	|	ОстаткиБУ.ИФО,
	|	ОстаткиБУ.КФО,
	|	ВЫБОР
	|		КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|			ЕСТЬNULL(ОстаткиБУ.СуммаОстатокДт, 0)
	|		ИНАЧЕ
	|			ЕСТЬNULL(ИнвНомера.Сумма, ОстаткиБУ.СуммаОстатокДт)
	|	КОНЕЦ																							КАК СуммаБУ,
	|	ВЫБОР
	|		КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|			ЕСТЬNULL(ОстаткиБУ.КоличествоОстатокДт, 0)
	|		ИНАЧЕ
	|			ЕСТЬNULL(ИнвНомера.Количество, ОстаткиБУ.КоличествоОстатокДт)
	|	КОНЕЦ																							КАК КоличествоБУ,
	|	ЕСТЬNULL(ИнвНомера.ИнвентарныйНомер	, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ОстаткиПоИнвНомерам
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИнвНомера КАК ИнвНомера
	|		ПО ОстаткиБУ.ОсновноеСредство = ИнвНомера.ОсновноеСредство
	|			И ОстаткиБУ.ЦМО = ИнвНомера.ЦМО
	|			И ОстаткиБУ.Подразделение = ИнвНомера.Подразделение
	|;
	|"
	
	+ ТекстЗапросаБлижайшиеОбщиеРодителиСчетов
	
	+ "
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для таблицы Инвентаризация
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА &НеЗаполнятьЦену ИЛИ ВложенныйЗапрос.КоличествоБУ = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(ВложенныйЗапрос.СуммаБУ / ВложенныйЗапрос.КоличествоБУ КАК Число(18,5))
	|	КОНЕЦ									КАК Цена,
	|	ВложенныйЗапрос.КоличествоБУ,
	|	ВложенныйЗапрос.СуммаБУ,
	|	ВложенныйЗапрос.ИнвентарныйНомер," + ПоляВыбораТаблицаИнвентаризация + "
	|	ВложенныйЗапрос.КоличествоФУ,
	|	ВложенныйЗапрос.СуммаФУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.ОсновноеСредство КАК ОсновноеСредство,
	|		СУММА(Т.КоличествоБУ) КАК КоличествоБУ,
	|		СУММА(Т.СуммаБУ) КАК СуммаБУ,
	|		Т.ИнвентарныйНомер КАК ИнвентарныйНомер," + ПоляВыбораВложенныйЗапрос + "
	|		СУММА(Т.КоличествоФУ) КАК КоличествоФУ,
	|		СУММА(Т.СуммаФУ) КАК СуммаФУ
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ОстаткиПоИнвНомерам.Счет КАК Счет,
	|			ОстаткиПоИнвНомерам.ОсновноеСредство КАК ОсновноеСредство,
	|			ОстаткиПоИнвНомерам.ЦМО КАК ЦМО,
	|			ОстаткиПоИнвНомерам.КПС КАК КПС,
	|			ОстаткиПоИнвНомерам.ИФО КАК ИФО,
	|			ОстаткиПоИнвНомерам.КФО КАК КФО,
	|			ОстаткиПоИнвНомерам.КоличествоБУ КАК КоличествоБУ,
	|			ОстаткиПоИнвНомерам.СуммаБУ КАК СуммаБУ,
	|			ОстаткиПоИнвНомерам.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|			0 КАК КоличествоФУ,
	|			0 КАК СуммаФУ
	|		ИЗ
	|			ОстаткиПоИнвНомерам
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ОСДокумента.Счет,
	|			ОСДокумента.ОсновноеСредство,
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(&ЦМО) = ТИП(Справочник.ЦМО)
	|					ТОГДА &ЦМО
	|			КОНЕЦ,
	|			NULL,
	|			NULL,
	|			NULL,
	|			0,
	|			0,
	|			ОСДокумента.ИнвентарныйНомер,
	|			ОСДокумента.КоличествоФУ,
	|			ОСДокумента.СуммаФУ
	|		ИЗ
	|			ОСДокумента КАК ОСДокумента
	|				ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоИнвНомерам КАК ОстаткиПоИнвНомерам
	|				ПО ОСДокумента.ОсновноеСредство = ОстаткиПоИнвНомерам.ОсновноеСредство
	|					И ОСДокумента.ИнвентарныйНомер = ОстаткиПоИнвНомерам.ИнвентарныйНомер
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|				ПО ОСДокумента.ОсновноеСредство = ОсновныеСредства.Ссылка
	|		ГДЕ
	|			ОстаткиПоИнвНомерам.ОсновноеСредство ЕСТЬ NULL ) КАК Т" + СоединениеСТаблицейСчетовБлижайшихРодителей + "
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.ОсновноеСредство,
	|		Т.ИнвентарныйНомер" + ПоляГруппировкиВложенныйЗапрос + ") КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ВложенныйЗапрос.ОсновноеСредство = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ВложенныйЗапрос.ИнвентарныйНомер = ИнвентарныеНомераОС.Ссылка
	|%ДопУсловие%
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновныеСредства.Наименование,
	|	ИнвентарныеНомераОС.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Данные для таблицы Остатки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиПоИнвНомерам.Счет,
	|	ОстаткиПоИнвНомерам.ОсновноеСредство,
	|	ОстаткиПоИнвНомерам.ЦМО,
	|	ОстаткиПоИнвНомерам.Подразделение,
	|	ОстаткиПоИнвНомерам.КПС,
	|	ОстаткиПоИнвНомерам.ИФО,
	|	ОстаткиПоИнвНомерам.КФО,
	|	ОстаткиПоИнвНомерам.КоличествоБУ КАК Количество,
	|	ОстаткиПоИнвНомерам.СуммаБУ КАК СтоимостьБалансовая,
	|	ОстаткиПоИнвНомерам.ИнвентарныйНомер
	|ИЗ
	|	ОстаткиПоИнвНомерам КАК ОстаткиПоИнвНомерам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Данные для таблицы НастройкаПорядка
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОстаткиБУ.Подразделение,
	|	ОстаткиБУ.КФО,
	|	ОстаткиБУ.ИФО,
	|	ОстаткиБУ.КПС,
	|	ОстаткиБУ.ЦМО
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ";
	
	ОСДокумента = Объект.Инвентаризация.Выгрузить(,"ОсновноеСредство,ИнвентарныйНомер,КоличествоФУ,СуммаФУ,Счет");
	ОСДокумента.Свернуть("ОсновноеСредство,ИнвентарныйНомер,Счет", "КоличествоФУ,СуммаФУ");
	
	Запрос.УстановитьПараметр("СчетГруппа",			Объект.СчетУчета);
	Запрос.УстановитьПараметр("НеЗаполнятьЦену",	Объект.НеЗаполнятьЦену);
	
	Запрос.УстановитьПараметр("Период", 			ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(Объект.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация",		Объект.Организация);
	Запрос.УстановитьПараметр("Счет", 				СчетОтбор);
	Запрос.УстановитьПараметр("ЦМО", 				Объект.ЦМО);
	Запрос.УстановитьПараметр("ОСДокумента", 		ОСДокумента);
	
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	Запрос.УстановитьПараметр("Подразделение",						Объект.Подразделение);
	
	Запрос.УстановитьПараметр("СчетаИсточникСуммРегистрБухгалтерии", ПолучитьСчетаИсточникСуммРегистрБухгалтерии(Объект));
	
	Если ЗначениеЗаполнено(Объект.КФО) Тогда
		Запрос.УстановитьПараметр("КФО", 			Объект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.КПС) Тогда
		Запрос.УстановитьПараметр("КПС", 			Объект.КПС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КПС = &КПС", "");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", 			Объект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Если ТипЗнч(Объект.ЦМО) = Тип("СправочникСсылка.Контрагенты") Тогда
		КонтрагентДляОтбора = Объект.ЦМО;
	Иначе
		КонтрагентДляОтбора = Объект.Контрагент;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент", КонтрагентДляОтбора);
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДопУсловие%", "");
	
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПустаяСсылка();
	Если (ВидНФА = "1" Или ВидНФА = "2" Или ВидНФА = "3" Или ВидНФА = "10") Тогда
		// счета 101, 102, 103, 106
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
	ИначеЕсли ВидНФА = "4" Тогда // счет 21
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
	Иначе
		// Применяется регистр СтоимостьОбъектовОСПоКонтрагентам
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".СтоимостьОбъектовОС", ".СтоимостьОбъектовОСПоКонтрагентам");		
		Если ВидНФА = "5" Тогда // счет 01
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;			
		ИначеЕсли ВидНФА = "6" // счет 02
			ИЛИ ВидНФА = "7" Тогда // счет 02.3
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
		ИначеЕсли ВидНФА = "12" Тогда // счет 24
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВУправление;
		ИначеЕсли ВидНФА = "13" Тогда // счет 25
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду;
		ИначеЕсли ВидНФА = "14" Тогда // счет 26
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование;
		ИначеЕсли ВидНФА = "11" Тогда // счет 27
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВЛичноеПользование;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидРаспоряжения", ВидРаспоряжения);
	
	НомераСубконто = ПолучитьНомераСубконто(СчетОтбор);
	
	НомерСубконтоЦМО			= Неопределено;
	НомерСубконтоКонтрагенты	= Неопределено;
	НомерСубконтоДоговоры		= Неопределено;
	
	НомераСубконто.Свойство("ЦМО",			НомерСубконтоЦМО);
	НомераСубконто.Свойство("Контрагенты",	НомерСубконтоКонтрагенты);
	НомераСубконто.Свойство("Договоры",		НомерСубконтоДоговоры);
	
	ИспользоватьОтборПоЦМО = (НомерСубконтоЦМО <> Неопределено);
	
	ИспользоватьОтборПоКонтрагенту = (НомерСубконтоКонтрагенты <> Неопределено И ЗначениеЗаполнено(КонтрагентДляОтбора));
	
	ИспользоватьОтборПоДоговору = (НомерСубконтоДоговоры <> Неопределено И ЗначениеЗаполнено(Объект.Договор));
	
	Если ИспользоватьОтборПоДоговору Тогда
		ИспользоватьОтборПоКонтрагенту = Ложь;
	КонецЕсли;
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	
	Если ИспользоватьОтборПоЦМО Тогда
		// связь с остатками ЕПСБУ по ЦМО
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		
		НомерСубконтоЦМО = ВидыСубконто.Количество();
		
		ТекстВыборМОЛИзОстатковЕПСБУ = СтрЗаменить(
			"ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто[НомерСубконтоЦМО] КАК Справочник.ЦМО)",
			"[НомерСубконтоЦМО]",
			НомерСубконтоЦМО);
			
		ТекстОтборПоМОЛИзОстатковЕПСБУ = СтрЗаменить(
			"Субконто[НомерСубконтоЦМО] В (ВЫБРАТЬ ЦМО.Ссылка ИЗ ЦМО)",
			"[НомерСубконтоЦМО]",
			НомерСубконтоЦМО);
		
		ТекстОтборПоМОЛИзСтоимостиОбъектов = "ЦМО В (ВЫБРАТЬ ЦМО.Ссылка ИЗ ЦМО)";
		
		ТекстВыборМОЛИзСтоимостиОбъектов = "СтоимостьОбъектовОСОстатки.ЦМО";
	Иначе
		
		ТекстВыборМОЛИзОстатковЕПСБУ = "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)";
		
		ТекстОтборПоМОЛИзОстатковЕПСБУ = "Истина";
		
		ТекстОтборПоМОЛИзСтоимостиОбъектов = "Истина";
		
		ТекстВыборМОЛИзСтоимостиОбъектов = "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)";
	КонецЕсли;
	
	Если ИспользоватьОтборПоКонтрагенту Тогда
		// связь с остатками ЕПСБУ по Контрагенту
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		
		НомерСубконтоКонтрагенты = ВидыСубконто.Количество();
		
		ТекстВыборМОЛИзОстатковЕПСБУ = СтрЗаменить(
			"ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто[НомерСубконтоКонтрагенты] КАК Справочник.Контрагенты)",
			"[НомерСубконтоКонтрагенты]",
			НомерСубконтоКонтрагенты);
			
		ТекстОтборПоКонтрагентуИзОстатковЕПСБУ = СтрЗаменить(
			"Субконто[НомерСубконтоКонтрагенты] = &Контрагент",
			"[НомерСубконтоКонтрагенты]",
			НомерСубконтоКонтрагенты);
			
		ТекстВыборМОЛИзСтоимостиОбъектов = "СтоимостьОбъектовОСОстатки.Контрагент";
		
		ТекстОтборПоКонтрагентуИзСтоимостиОбъектов = "Контрагент = &Контрагент";
		
	Иначе
		
		ТекстОтборПоКонтрагентуИзОстатковЕПСБУ = "Истина";
		
		ТекстОтборПоКонтрагентуИзСтоимостиОбъектов = "Истина";
		
	КонецЕсли;

	Если ИспользоватьОтборПоДоговору Тогда
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		
		НомерСубконтоДоговоры = ВидыСубконто.Количество();
		
		ТекстОтборПоДоговоруИзОстатковЕПСБУ = СтрЗаменить(
			"Субконто[НомерСубконтоДоговоры] = &Договор",
			"[НомерСубконтоДоговоры]",
			НомерСубконтоДоговоры);
			
		ТекстОтборПоДоговоруИзСтоимостиОбъектов = "Договор = &Договор";
		
	Иначе
		
		ТекстОтборПоДоговоруИзОстатковЕПСБУ = "Истина";
		
		ТекстОтборПоДоговоруИзСтоимостиОбъектов = "Истина";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ВыборМОЛИзОстатковЕПСБУ]", ТекстВыборМОЛИзОстатковЕПСБУ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоМОЛИзОстатковЕПСБУ]", ТекстОтборПоМОЛИзОстатковЕПСБУ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ВыборМОЛИзСтоимостиОбъектов]", ТекстВыборМОЛИзСтоимостиОбъектов);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоМОЛИзСтоимостиОбъектов]", ТекстОтборПоМОЛИзСтоимостиОбъектов);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоКонтрагентуИзОстатковЕПСБУ]", ТекстОтборПоКонтрагентуИзОстатковЕПСБУ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоКонтрагентуИзСтоимостиОбъектов]", ТекстОтборПоКонтрагентуИзСтоимостиОбъектов);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоДоговоруИзОстатковЕПСБУ]", ТекстОтборПоДоговоруИзОстатковЕПСБУ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоДоговоруИзСтоимостиОбъектов]", ТекстОтборПоДоговоруИзСтоимостиОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// [5]. Данные для таблицы Инвентаризация
	ТаблицаИнвентаризация = РезультатЗапроса[5 + СдвигИндексаВсехТаблиц].Выгрузить();
	
	ИменаКолонок = Неопределено;
	ИнвентаризацияСервер.Редактирование0504087_СоздатьКолонкиЧисловыхПоказателей(ТаблицаИнвентаризация, ДокументОбъект.Ссылка, ИменаКолонок);
	
	Если ВыбиратьНулевоеКоличество И ЗаменятьНулевоеКоличество Тогда
		ИнвентаризацияСервер.УстановитьКоличествоПоУмолчанию(
			ТаблицаИнвентаризация,
			ИменаКолонок,
			Истина,
			ДокументОбъект["НеЗаполнятьЦену"],
			Истина);
	КонецЕсли;
	
	ИнвентаризацияСервер.Редактирование0504087_РассчитатьРасхождениеВТаблице(ТаблицаИнвентаризация, ИменаКолонок);
	
	Объект.Инвентаризация.Загрузить(ТаблицаИнвентаризация);
	
	// [6]. Данные для таблицы Остатки
	ТаблицаОстатки = РезультатЗапроса[6 + СдвигИндексаВсехТаблиц].Выгрузить();
	
	Если ВыбиратьНулевоеКоличество И ЗаменятьНулевоеКоличество Тогда
		// Для таблицы остатков колонки имеют иные имена
		ИменаКолонок.Вставить("КоличествоУчет", "Количество");
		ИменаКолонок.Вставить("СуммаУчет", "СтоимостьБалансовая");
		
		ИнвентаризацияСервер.УстановитьКоличествоПоУмолчанию(
			ТаблицаОстатки,
			ИменаКолонок);
	КонецЕсли;
	
	Объект.Остатки.Загрузить(ТаблицаОстатки);
	
	// [7]. Данные для таблицы НастройкаПорядка
	Объект.НастройкаПорядка.Загрузить(РезультатЗапроса[7 + СдвигИндексаВсехТаблиц].Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьДанныеФУизТСДСервер(ДокументОбъект, ТаблицаТСД) Экспорт
	
	Перем ВариантыВидовНФА;
	
	Объект = ДокументОбъект;
	
	ВидНФА = ПолучитьВидНФАПоСчету(Объект, ВариантыВидовНФА);
	
	Для каждого ТекСтр Из Объект.Инвентаризация Цикл
	
		ТекСтр.КоличествоФУ = 0;
	
	КонецЦикла;
	
	ТаблицаЗагрузкиИзТСД = Новый ТаблицаЗначений;
	ТаблицаЗагрузкиИзТСД.Колонки.Добавить("Штрихкод",
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(13, ДопустимаяДлина.Фиксированная)));
	ТаблицаЗагрузкиИзТСД.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для каждого ТекОбъектТСД Из ТаблицаТСД Цикл
	
		ЗаполнитьЗначенияСвойств(ТаблицаЗагрузкиИзТСД.Добавить(), ТекОбъектТСД);
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаТСД.Штрихкод КАК Штрихкод,
	|	ТаблицаТСД.Количество
	|ПОМЕСТИТЬ ТаблицаТСД
	|ИЗ
	|	&ТаблицаТСД КАК ТаблицаТСД
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ШтрихКоды.Объект, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредство,
	|	ЕСТЬNULL(ШтрихКоды.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ТаблицаТСД.Штрихкод,
	|	СУММА(ТаблицаТСД.Количество) КАК Количество
	|ПОМЕСТИТЬ ОСизТСД
	|ИЗ
	|	ТаблицаТСД КАК ТаблицаТСД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	|		ПО ТаблицаТСД.Штрихкод = ШтрихКоды.Штрихкод
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТСД.Штрихкод,
	|	ЕСТЬNULL(ШтрихКоды.Объект, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)),
	|	ЕСТЬNULL(ШтрихКоды.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Инвентаризация.НомерСтроки,
	|	Инвентаризация.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(Инвентаризация.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	Инвентаризация.Цена,
	|	Инвентаризация.КоличествоБУ,
	|	Инвентаризация.СуммаБУ,
	|	Инвентаризация.КФО,
	|	Инвентаризация.КПС
	|ПОМЕСТИТЬ Инвентаризация
	|ИЗ
	|	&Инвентаризация КАК Инвентаризация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	Если ВидНФА = "4" Тогда
		// для ОС в опер. учете получаем счет учета в опер. учете (21)
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета
		|ПОМЕСТИТЬ СчетаУчетаОС1
		|ИЗ
		|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ОСизТСД.ОсновноеСредство
		|					ИЗ
		|						ОСизТСД КАК ОСизТСД
		|			
		|					ОБЪЕДИНИТЬ ВСЕ
		|			
		|					ВЫБРАТЬ
		|						Инвентаризация.ОсновноеСредство
		|					ИЗ
		|						Инвентаризация КАК Инвентаризация)
		|				И СчетУчета В (&СчетаОС)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетаУчетаОС1.ОсновноеСредство,
		|	МАКСИМУМ(СоответствиеСчетовОС.ЗабалансовыйСчет) КАК СчетУчета
		|ПОМЕСТИТЬ СчетаУчетаОС
		|ИЗ
		|	СчетаУчетаОС1 КАК СчетаУчетаОС1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
		|		ПО СчетаУчетаОС1.СчетУчета = СоответствиеСчетовОС.СчетОС
		|
		|СГРУППИРОВАТЬ ПО
		|	СчетаУчетаОС1.ОсновноеСредство
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетаУчетаОС1.ОсновноеСредство";
	Иначе
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета
		|ПОМЕСТИТЬ СчетаУчетаОС
		|ИЗ
		|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ОСизТСД.ОсновноеСредство
		|					ИЗ
		|						ОСизТСД КАК ОСизТСД
		|			
		|					ОБЪЕДИНИТЬ ВСЕ
		|			
		|					ВЫБРАТЬ
		|						Инвентаризация.ОсновноеСредство
		|					ИЗ
		|						Инвентаризация КАК Инвентаризация)
		|				И СчетУчета В (&СчетаОС)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Инвентаризация.НомерСтроки КАК НомерСтроки,
	|	Инвентаризация.ОсновноеСредство,
	|	Инвентаризация.ИнвентарныйНомер,
	|	Инвентаризация.Цена,
	|	Инвентаризация.КоличествоБУ,
	|	Инвентаризация.СуммаБУ,
	|	ОСизТСД.Количество КАК КоличествоФУ,
	|	ОсновныеСредства.Наименование КАК НаименованиеОС,
	|	ИнвентарныеНомераОС.Код КАК КодИнвНом,
	|	ЕСТЬNULL(СчетаУчетаОС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК Счет,
	|	Инвентаризация.КФО,
	|	Инвентаризация.КПС
	|ИЗ
	|	Инвентаризация КАК Инвентаризация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОСизТСД КАК ОСизТСД
	|		ПО Инвентаризация.ОсновноеСредство = ОСизТСД.ОсновноеСредство
	|			И Инвентаризация.ИнвентарныйНомер = ОСизТСД.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО Инвентаризация.ОсновноеСредство = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО Инвентаризация.ИнвентарныйНомер = ИнвентарныеНомераОС.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаУчетаОС КАК СчетаУчетаОС
	|		ПО Инвентаризация.ОсновноеСредство = СчетаУчетаОС.ОсновноеСредство
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	1000000,
	|	ОСизТСД.ОсновноеСредство,
	|	ОСизТСД.ИнвентарныйНомер,
	|	0,
	|	0,
	|	0,
	|	ОСизТСД.Количество,
	|	ОсновныеСредства.Наименование,
	|	ИнвентарныеНомераОС.Код,
	|	ЕСТЬNULL(СчетаУчетаОС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)),
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|ИЗ
	|	ОСизТСД КАК ОСизТСД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Инвентаризация КАК Инвентаризация
	|		ПО ОСизТСД.ОсновноеСредство = Инвентаризация.ОсновноеСредство
	|			И ОСизТСД.ИнвентарныйНомер = Инвентаризация.ИнвентарныйНомер
	|			И (ОСизТСД.ОсновноеСредство <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ОСизТСД.ИнвентарныйНомер = ИнвентарныеНомераОС.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ОСизТСД.ОсновноеСредство = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаУчетаОС КАК СчетаУчетаОС
	|		ПО ОСизТСД.ОсновноеСредство = СчетаУчетаОС.ОсновноеСредство
	|ГДЕ
	|	Инвентаризация.ОсновноеСредство ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	НаименованиеОС,
	|	КодИнвНом
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОСизТСД.Штрихкод
	|ИЗ
	|	ОСизТСД КАК ОСизТСД
	|ГДЕ
	|	ОСизТСД.ОсновноеСредство = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ТаблицаТСД",     ТаблицаЗагрузкиИзТСД);
	Запрос.УстановитьПараметр("Инвентаризация", Объект.Инвентаризация.Выгрузить());
	Запрос.УстановитьПараметр("СчетаОС",        БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00"));
	Запрос.УстановитьПараметр("Период",         Объект.Дата);
	Запрос.УстановитьПараметр("Организация",    Объект.Организация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Объект.Инвентаризация.Загрузить(РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить());
	
	РассчитатьПоказателиВТаблице(Объект.Инвентаризация, Объект.ВариантФормированияОписи);
	
	Ошибки = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать();
	КоличествоОшибок = Ошибки.Количество();
	Если КоличествоОшибок>0 Тогда
		ТекстОшибки = НСтр("ru = 'Не найден штрихкод %1'");
		СчетчикОшибок = 0;
		ТекстДляЖурналаРегистрации = "";
		ПредельноеЧислоОшибок = ?(Мин(25, КоличествоОшибок) <= 25, КоличествоОшибок, 20);
		Пока Ошибки.Следующий() Цикл
			
			СчетчикОшибок = СчетчикОшибок + 1;
			ТекущаяОшибка = СтрШаблон(ТекстОшибки, Ошибки.Штрихкод);
			Если СчетчикОшибок <= ПредельноеЧислоОшибок Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекущаяОшибка);
			КонецЕсли;
			ТекстДляЖурналаРегистрации = ТекстДляЖурналаРегистрации + ТекущаяОшибка + Символы.ПС;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации("Заполнение из ТСД", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ИнвентаризацияОС, Объект.Ссылка, ТекстДляЖурналаРегистрации);
		
		Если КоличествоОшибок > ПредельноеЧислоОшибок Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Всего %1 ошибок. Подробности см. в журнале регистрации'"),
				КоличествоОшибок));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура РассчитатьПоказателиВТаблице(Таблица, ВариантФормированияОписи, ОчиститьКоличествоБУ = Ложь, ПересчитатьФУпоБУ = Ложь) Экспорт
	
	// см. ИнвентаризацияСервер.ПолучитьНастройкиФормы0504087_ИнвентаризацияОС()
	// ИменаКолонокЧисловыхПоказателей
	//						Показатель				Имя реквизита табличной части
	ИменаКолонок = Новый Структура();
	ИменаКолонок.Вставить("КоличествоФакт",			"КоличествоФУ");
	ИменаКолонок.Вставить("КоличествоУчет",			"КоличествоБУ");
	ИменаКолонок.Вставить("КоличествоИзлишек",		"КоличествоИзлишков");
	ИменаКолонок.Вставить("КоличествоНедостача",	"КоличествоНедостач");
	ИменаКолонок.Вставить("СуммаФакт",				"СуммаФУ");
	ИменаКолонок.Вставить("СуммаУчет",				"СуммаБУ");
	ИменаКолонок.Вставить("СуммаИзлишек",			"СуммаИзлишков");
	ИменаКолонок.Вставить("СуммаНедостача",			"СуммаНедостач");
	
	Форма = Новый Структура();
	Форма.Вставить("КэшВариантФормированияОписи", Новый Структура());
	
	Форма.КэшВариантФормированияОписи.Вставить("ИменаКолонокЧисловыхПоказателей", ИменаКолонок);
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("КоличествоБУ", 0);
	ОчищающаяСтруктура.Вставить("СуммаБУ", 0);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если ОчиститьКоличествоБУ Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		КонецЕсли;
		
		Если ПересчитатьФУпоБУ Тогда
			СтрокаТаблицы["КоличествоФУ"] = СтрокаТаблицы["КоличествоБУ"];
		КонецЕсли;
		
		Если ВариантФормированияОписи = 0 Тогда
			// 0. Опись до 2018 г.
			
			ИнвентаризацияКлиентСервер.Редактирование0504087_ПересчитатьСтрокуИнвентаризацииОС(СтрокаТаблицы);
			
		Иначе
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			
			ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьФактическиеПоказатели(
				Форма,
				СтрокаТаблицы,
				"КоличествоФУ");
					
			ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(
				Форма,
				СтрокаТаблицы,
				Истина);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВариантыВидовНФА(ФормаДокумента) Экспорт
	
	Перем ТаблицаНастроек;
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	ВариантыВидовНФА = ПолучитьВариантыВидовНФА(ДокументОбъект, ТаблицаНастроек);
	
	Список = ПолучитьСписокВыбораГруппыСчетов(ТаблицаНастроек);
	
	ФормаДокумента["ВариантыВидовНФА"] = ВариантыВидовНФА;
	
	СписокВыбора = ФормаДокумента.Элементы["ВидНФА"].СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из Список Цикл
		НовыйЭлемент = СписокВыбора.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементСписка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВидНФАПоСчету(Знач ДокументОбъект, ВариантыВидовНФА = Неопределено) Экспорт
	
	СчетУчета = ДокументОбъект["СчетУчета"];
	
	Если СчетУчета.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	НаДату = Неопределено;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ДатаИнвентаризации) Тогда
		НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ДокументОбъект.Дата;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ВариантыВидовНФА = Неопределено Тогда
		ВариантыВидовНФА = ПолучитьВариантыВидовНФА(ДокументОбъект);
	КонецЕсли;
	
	КоличествоРодителей = 4;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СчетУчета",		СчетУчета);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",	'00010101');
	ЗапросПоиск.УстановитьПараметр("ПустойКод",		"");
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Ссылка.Код, &ПустойКод)																КАК СчетУчетаКод,
	|	
	|	ЕСТЬNULL(Ссылка.Родитель.Код, &ПустойКод)														КАК Родитель1Код,
	|	ЕСТЬNULL(Ссылка.Родитель.ДатаНачалаДействия, &ПустаяДата)										КАК Родитель1ДатаНачалаДействия,
	|	ЕСТЬNULL(Ссылка.Родитель.ДатаОкончанияДействия, &ПустаяДата)									КАК Родитель1ДатаОкончанияДействия,
	|	
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Код, &ПустойКод)												КАК Родитель2Код,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.ДатаНачалаДействия, &ПустаяДата)								КАК Родитель2ДатаНачалаДействия,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.ДатаОкончанияДействия, &ПустаяДата)							КАК Родитель2ДатаОкончанияДействия,
	|	
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.Код, &ПустойКод)										КАК Родитель3Код,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.ДатаНачалаДействия, &ПустаяДата)						КАК Родитель3ДатаНачалаДействия,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.ДатаОкончанияДействия, &ПустаяДата)					КАК Родитель3ДатаОкончанияДействия,
	|	
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.Родитель.Код, &ПустойКод)							КАК Родитель4Код,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.Родитель.ДатаНачалаДействия, &ПустаяДата)			КАК Родитель4ДатаНачалаДействия,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.Родитель.ДатаОкончанияДействия, &ПустаяДата)			КАК Родитель4ДатаОкончанияДействия
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В(&СчетУчета)";
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	СтрокаТаблицы = Таблица[0];
	
	СчетУчетаИРодители = Новый Массив();
	СчетУчетаИРодители.Добавить(СтрокаТаблицы.СчетУчетаКод);
	
	Для Счетчик = 1 По КоличествоРодителей Цикл
		КодРодителя = СтрокаТаблицы["Родитель" + Счетчик + "Код"];
		
		Если Не ЗначениеЗаполнено(КодРодителя) Тогда
			Прервать;
		КонецЕсли;
		
		ДатаНачалаДействия		= СтрокаТаблицы["Родитель" + Счетчик + "ДатаНачалаДействия"];
		ДатаОкончанияДействия	= СтрокаТаблицы["Родитель" + Счетчик + "ДатаОкончанияДействия"];
		
		СчетРодителяДействующий = (Не ЗначениеЗаполнено(ДатаНачалаДействия) Или ДатаНачалаДействия <= НаДату)
			И (Не ЗначениеЗаполнено(ДатаОкончанияДействия) Или ДатаОкончанияДействия >= НаДату);
		
		Если Не СчетРодителяДействующий Тогда
			Прервать;
		КонецЕсли;
		
		СчетУчетаИРодители.Добавить(КодРодителя);
	КонецЦикла;
	
	РезультатыПоиска = Новый ТаблицаЗначений();
	РезультатыПоиска.Колонки.Добавить("ВидНФА",				Новый ОписаниеТипов("Строка"));
	РезультатыПоиска.Колонки.Добавить("СовпавшийСчет",		ОбщегоНазначения.ОписаниеТипаЧисло(1,0,ДопустимыйЗнак.Неотрицательный));
	РезультатыПоиска.Колонки.Добавить("ПозицияСовпадения",	ОбщегоНазначения.ОписаниеТипаЧисло(1,0,ДопустимыйЗнак.Неотрицательный));
	
	СовпавшийСчет = Новый Структура();
	СовпавшийСчет.Вставить("Счет",		1);
	СовпавшийСчет.Вставить("Родитель",	2);
	
	ПозицияСовпадения = Новый Структура();
	ПозицияСовпадения.Вставить("ДетальныйСчет",	1);
	ПозицияСовпадения.Вставить("ГруппаСчетов",	2);
	
	Для Каждого Элемент Из ВариантыВидовНФА Цикл
		
		ВидНФА				= Элемент.Ключ;
		СписокСчетовСтрокой	= Элемент.Значение;
		
		Если ВидНФА = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СписокСчетов = СтрРазделить(СписокСчетовСтрокой, ", ");
		
		КоличествоСчетовВСписке = СписокСчетов.Количество();
		
		Для Счетчик = 1 По СчетУчетаИРодители.Количество() Цикл
			КодСчета = СчетУчетаИРодители[Счетчик - 1];
			
			Индекс = СписокСчетов.Найти(КодСчета);
			
			Если Индекс = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = РезультатыПоиска.Добавить();
			НоваяСтрока.ВидНФА				= ВидНФА;
			НоваяСтрока.СовпавшийСчет		= СовпавшийСчет[?(Счетчик = 1, "Счет", "Родитель")];
			НоваяСтрока.ПозицияСовпадения	= ПозицияСовпадения[?(Индекс = 0, "ГруппаСчетов", "ДетальныйСчет")];
		КонецЦикла;
	КонецЦикла;
	
	Если РезультатыПоиска.Количество() = 0 Тогда
		Возврат "";
	ИначеЕсли РезультатыПоиска.Количество() > 1 Тогда
		РезультатыПоиска.Сортировать("СовпавшийСчет Возр,ПозицияСовпадения Возр");
	КонецЕсли;
	
	Возврат РезультатыПоиска[0].ВидНФА;
	
КонецФункции

Функция ПолучитьСчетУчетаОтбор(Знач ДокументОбъект, Знач ВидНФА = Неопределено, Знач ВариантыВидовНФА = Неопределено, Знач СчетУчетаПоУмолчанию = Неопределено) Экспорт
	
	НаДату		= НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	Организация	= ДокументОбъект["Организация"];
	СчетУчета	= ДокументОбъект["СчетУчета"];
	
	Если ВидНФА = Неопределено Тогда
		ВидНФА = ПолучитьВидНФАПоСчету(ДокументОбъект, ВариантыВидовНФА);
	КонецЕсли;	
	
	СписокСчетовСтрокой = ВариантыВидовНФА.Получить(ВидНФА);
	
	СписокСчетовМассив = СтрРазделить(СписокСчетовСтрокой, ",", Ложь);
	
	Если СписокСчетовМассив.Количество() > 1 Тогда
		СписокСчетовМассив.Удалить(0);
	КонецЕсли;
	
	Если СчетУчетаПоУмолчанию = Неопределено Тогда
		СчетУчетаПоУмолчанию = ПолучитьСчетУчетаПоУмолчанию(ДокументОбъект, ВидНФА, ВариантыВидовНФА);
	КонецЕсли;
	
	Если СписокСчетовМассив.Количество() > 1 И СчетУчета = СчетУчетаПоУмолчанию Тогда
		
		БезУчетаИерархии = Истина;
		
		Возврат БухгалтерскийУчет.СписокСчетов(
			СписокСчетовМассив,
			НаДату,
			БезУчетаИерархии);
			
	Иначе
		
		Возврат СчетУчета;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСчетУчетаПоУмолчанию(Знач ДокументОбъект, Знач ВидНФА = Неопределено, Знач ВариантыВидовНФА = Неопределено) Экспорт
	
	НаДату		= НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	Организация	= ДокументОбъект["Организация"];
	
	Если ВидНФА = Неопределено Тогда
		ВидНФА = ПолучитьВидНФАПоСчету(ДокументОбъект, ВариантыВидовНФА);
	КонецЕсли;	
	
	Если ВидНФА = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СписокСчетовСтрока = ВариантыВидовНФА.Получить(ВидНФА);
	
	Если СписокСчетовСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СписокСчетовМассив = СтрРазделить(СписокСчетовСтрока, ",", Ложь);
	
	Возврат БухгалтерскийУчет.СчетПоКоду(СписокСчетовМассив[0], НаДату, Организация);
	
КонецФункции

Функция ПолучитьСчетаИнвентаризации(НаДату = Неопределено) Экспорт
	
	// Список счетов может содержать более одного кода счета.
	// При указании списка из нескольких счетов, первый элемент используется только для вывода в форму.
	// Первый элемент в отборе не участвует.
	// Отбор осуществляется только по счетам, указанным со второй позиции и далее.
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТаблицаНастроек = ПолучитьПустуюТаблицуНастроекГруппСчетов();
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "1", НСтр("ru = '101.00: Основные средства (на балансе)'"), "101.00");
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "2", НСтр("ru = '102.00: Нематериальные активы'"), "102.00");
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "3", НСтр("ru = '103.00: Непроизведенные активы'"), "103.00");
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "4", НСтр("ru = '21: Основные средства (оперативный учет)'"), "21");
	
	// +субконто Контрагенты (до 01.01.2021), Договоры (с 01.01.2021)
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "5", НСтр("ru = '01: Основные средства (арендованные)'"), "01");
	
	// +субконто Контрагенты (до 01.01.2021), Договоры (с 01.01.2021)
	Если НаДату	>= '20210101' Тогда
		Наименование = НСтр("ru = '02: Имущество на хранении'");
		// Указываем конкретные счета, чтобы исключить счета учета МЗ.
		СписокСчетовСтрока = "02,02.11,02.21,02.31,02.51,02.52,02.5";
	Иначе
		Наименование = НСтр("ru = '02.1: Основные средства (хранение)'");
		СписокСчетовСтрока = "02.1";
	КонецЕсли;
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "6", Наименование, СписокСчетовСтрока);
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "7", НСтр("ru = '02.3: Основные средства (не признанные активом)'"), "02.3");
	
	// +субконто Контрагенты (до 01.01.2021), Договоры (с 01.01.2021)
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "8", НСтр("ru = '22.1: Основные средства (полученные по ЦС)'"), "22.1");
	
	// +субконто Договоры
	Если НаДату	>= '20210101' Тогда
		Наименование = НСтр("ru = '111.00: Права пользования активами'");
		СписокСчетовСтрока = "111.00";
	Иначе
		Наименование = НСтр("ru = '111.40: Права пользования активами'");
		СписокСчетовСтрока = "111.40";
	КонецЕсли;
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "9", Наименование, СписокСчетовСтрока);
	
	Если НаДату	>= '20210101' Тогда
		// +субконто ВидыЗатрат (кроме 106.90), Договоры (106.90)
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "10", НСтр("ru = '106.00: Вложения в нефинансовые активы'"), 
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"106.00," 
			+ "106.10,"
			+ "106.21,106.2D,106.2I,106.2N,106.2R,"
			+ "106.31,106.32,106.33,106.3D,106.3I,106.3N,106.3R,"
			+ "106.40,"
			+ "106.51,106.52,106.53,106.54,106.55,"
			+ "106.60,"
			+ "106.90");
	КонецЕсли;
	
	Если НаДату	>= '20200101' Тогда
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "11", НСтр("ru = '27.01: Основные средства (личное пользование)'"), "27.01");
	КонецЕсли;
	
	Если НаДату	>= '20230101' Тогда
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "12", НСтр("ru = '24: Переданные в доверительное управление'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"24," 
			+ "24.11,24.13,"
			+ "24.20,24.21,24.22,24.24,"
			+ "24.31,24.32,24.33");
	Иначе
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "12", НСтр("ru = '24: Переданные в доверительное управление'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"24," 
			+ "24.11,24.13,"
			+ "24.20,24.21,24.22,24.24,"
			+ "24.31,24.32");
	КонецЕсли;
	
	Если НаДату	>= '20230101' Тогда
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "13", НСтр("ru = '25: Переданные в аренду'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"25," 
			+ "25.11,25.13,"
			+ "25.21,25.22,"
			+ "25.31,25.32,25.33,"
			+ "25.40,"
			+ "25.51,25.52,25.53,25.54,25.55,"
			+ "25.60,"
			+ "25.90");
	Иначе
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "13", НСтр("ru = '25: Переданные в аренду'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"25," 
			+ "25.11,25.13,"
			+ "25.21,25.22,"
			+ "25.31,25.32,"
			+ "25.51,25.52,25.53,25.54,25.55");
	КонецЕсли;
	
	Если НаДату	>= '20230101' Тогда
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "14", НСтр("ru = '26: Переданные в безвозмездное пользование'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"26," 
			+ "26.11,26.13,"
			+ "26.21,26.22,"
			+ "26.31,26.32,26.33,"
			+ "26.51,26.52,26.53,26.54,26.55,26.57"
			+ "26.40,"
			+ "26.60,"
			+ "26.90");

	Иначе
		// +субконто Контрагенты
		ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "14", НСтр("ru = '26: Переданные в безвозмездное пользование'"),
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			"26," 
			+ "26.11,26.13,"
			+ "26.21,26.22,"
			+ "26.31,26.32,"
			+ "26.51,26.52,26.53,26.54,26.55,26.57");
	КонецЕсли;
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "15", НСтр("ru = '13.1: Экспериментальные устройства'"), "13.1");
	
	ДобавитьНастройкуПустойГруппыСчетов(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Процедура УпорядочитьСписокВыбораГруппСчетов(СписокВыбора)
	
	ПорядокЭлементов = Новый Массив();
	ПорядокЭлементов.Добавить("1");
	ПорядокЭлементов.Добавить("2");
	ПорядокЭлементов.Добавить("3");
	ПорядокЭлементов.Добавить("10");
	ПорядокЭлементов.Добавить("9");
	ПорядокЭлементов.Добавить("5");
	ПорядокЭлементов.Добавить("6");
	ПорядокЭлементов.Добавить("7");
	ПорядокЭлементов.Добавить("15");
	ПорядокЭлементов.Добавить("4");
	ПорядокЭлементов.Добавить("8");
	ПорядокЭлементов.Добавить("12");
	ПорядокЭлементов.Добавить("13");
	ПорядокЭлементов.Добавить("14");
	ПорядокЭлементов.Добавить("11");
	
	СвойстваЭлемента = Новый Структура("Значение,Представление,Пометка,Картинка");
	
	НовыйИндексЭлемента = -1;
	
	Для Каждого Обозначение Из ПорядокЭлементов Цикл
		
		ЭлементСписка = СписокВыбора.НайтиПоЗначению(Обозначение);
		
		Если ЭлементСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйИндексЭлемента = НовыйИндексЭлемента + 1;
		
		ТекущийИндексЭлемента = СписокВыбора.Индекс(ЭлементСписка);
		
		Если ТекущийИндексЭлемента = НовыйИндексЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СвойстваЭлемента, ЭлементСписка);
		
		СписокВыбора.Удалить(ЭлементСписка);
		
		СписокВыбора.Вставить(НовыйИндексЭлемента,
			СвойстваЭлемента.Значение,
			СвойстваЭлемента.Представление,
			СвойстваЭлемента.Пометка,
			СвойстваЭлемента.Картинка);
			
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокВыбораГруппыСчетов(ТаблицаСчетов)
	
	СписокВыбора = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		
		Обозначение = СтрокаТаблицы.Обозначение;
		
		Наименование = СтрокаТаблицы.Наименование;
		
		Если ЗначениеЗаполнено(Обозначение) Тогда
			
			СписокВыбора.Добавить(СтрокаТаблицы.Обозначение, СтрокаТаблицы.Наименование);
			
		КонецЕсли;
		
	КонецЦикла;
	
	УпорядочитьСписокВыбораГруппСчетов(СписокВыбора);
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПолучитьВариантыВидовНФА(Знач ДокументОбъект, ТаблицаНастроек = Неопределено)
	
	НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	
	ВариантыВидовНФА = Новый Соответствие();
	
	ТаблицаНастроек = ПолучитьСчетаИнвентаризации(НаДату);
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		
		ВариантыВидовНФА.Вставить(СтрокаТаблицы.Обозначение, СтрокаТаблицы.СписокСчетовСтрока);
		
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(ВариантыВидовНФА);
	
КонецФункции

Функция ПолучитьНомераСубконто(МассивСчетов) Экспорт
	
	ИскомыеВидыСубконто = Новый Массив();
	ИскомыеВидыСубконто.Добавить("ОсновныеСредства");
	ИскомыеВидыСубконто.Добавить("ЦМО");
	ИскомыеВидыСубконто.Добавить("Контрагенты");
	ИскомыеВидыСубконто.Добавить("Договоры");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСчетов", МассивСчетов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидСубконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&МассивСчетов)";
	
	ТаблицаВидыСубконто = ЗапросПоиск.Выполнить().Выгрузить();
	
	НомераСубконто = Новый Структура();
	
	Поиск = Новый Структура();
	
	НПП = 0;
	
	Для Каждого ИскомыйВид Из ИскомыеВидыСубконто Цикл
		
		Поиск.Вставить("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконто[ИскомыйВид]);
		
		МассивСтрок = ТаблицаВидыСубконто.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НПП = НПП + 1;
		
		НомераСубконто.Вставить(ИскомыйВид, Строка(НПП));
		
	КонецЦикла;
	
	Возврат НомераСубконто;
	
КонецФункции

Функция ПолучитьПризнакиВеденияУчета(МассивСчетов) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСчетов", МассивСчетов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(УчетПоКПС), Ложь)				КАК УчетПоКПС,
	|	ЕСТЬNULL(МАКСИМУМ(УчетПоКЭК), Ложь)				КАК УчетПоКЭК,
	|	ЕСТЬNULL(МАКСИМУМ(УчетПоПодразделениям), Ложь)	КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&МассивСчетов)";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	ПризнакиВеденияУчета = Новый Структура("
		|УчетПоКПС,
		|УчетПоКЭК,
		|УчетПоПодразделениям");
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПризнакиВеденияУчета, Выборка);
		Прервать;
	КонецЦикла;
	
	Возврат ПризнакиВеденияУчета;
	
КонецФункции

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПустуюТаблицуНастроекГруппСчетов()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаНастроек = Новый ТаблицаЗначений();
	
	ТаблицаНастроек.Колонки.Добавить("Обозначение",			ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("Наименование",		ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("СписокСчетовСтрока",	ТипСтрока);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Процедура ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, Обозначение, Наименование, СписокСчетовСтрока)
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	
	НоваяСтрока.Обозначение			= Обозначение;
	НоваяСтрока.Наименование		= Наименование;
	НоваяСтрока.СписокСчетовСтрока	= СписокСчетовСтрока;
	
КонецПроцедуры

Процедура ДобавитьНастройкуПустойГруппыСчетов(ТаблицаНастроек)
	
	МассивСтрок = ТаблицаНастроек.ВыгрузитьКолонку("СписокСчетовСтрока");
	
	МассивСтрок.Вставить(0, "<первый элемент-заглушка>");
	
	ДобавитьНастройкуГруппыСчетов(ТаблицаНастроек, "", "", СтрСоединить(МассивСтрок, ","));
	
КонецПроцедуры

