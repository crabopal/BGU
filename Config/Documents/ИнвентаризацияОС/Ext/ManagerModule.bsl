#КонецОбласти

Функция ПолучитьДатыИзмененияСоставаГруппСчетов() Экспорт
	
	// Здесь указываются даты, в которые начинают действовать новые счета учета НФА.
	// Эти счета учета используются в шапке, составляют группы счетов,
	// и используются для отбора при заполнении по данным учета.
	
	// При пересечении указанных здесь временных границ меняется состав групп счетов.
	// Заканчивают действие одни группы счетов, начинают действовать другие.
	
	// см. процедуры составления списка групп счетов для проведения инвентаризации.
	// Даты в условиях этих процедур совпадают с датами, указанными здесь.
	
	ДатыИзменений = Новый СписокЗначений();
	ДатыИзменений.Добавить('20200101');
	ДатыИзменений.Добавить('20210101');
	
	ДатыИзменений.СортироватьПоЗначению();
	
	Возврат Новый ФиксированныйМассив(ДатыИзменений.ВыгрузитьЗначения());
	
КонецФункции

Функция ЭтоИнвентаризация_11100(ДокументОбъект) Экспорт
	
	НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = Неопределено;
	КонецЕсли;
	
	Счета11100 = БухгалтерскийУчет.СписокСчетов("111.00", НаДату);
	
	Возврат (Счета11100.Найти(ДокументОбъект.СчетУчета) <> Неопределено);
	
КонецФункции

Функция ДоступныСчета11160(ДокументОбъект)
	
	НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = Неопределено;
	КонецЕсли;
	
	Счета11160 = БухгалтерскийУчет.СписокСчетов("111.60", НаДату);
	
	СчетаДокумента = БухгалтерскийУчет.СписокСчетов(ДокументОбъект.СчетУчета, НаДату);
	
	Для Каждого Счет11160 Из Счета11160 Цикл
		Если СчетаДокумента.Найти(Счет11160) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИспользуетсяКолонкаИнвНомер(ДокументОбъект) Экспорт
	
	Если ЭтоИнвентаризация_11100(ДокументОбъект) Тогда
		Возврат ДоступныСчета11160(ДокументОбъект);
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
	
Процедура ЗаполнитьПоДаннымУчета_11100(ДокументОбъект) Экспорт
	
	ДанныеБухУчета = ПолучитьДанныеБухУчета_11100(ДокументОбъект);
	
	ТаблицаОстатки = ДанныеБухУчета.ТаблицаОстатки;
	
	ДокументОбъект.Инвентаризация.Загрузить(ТаблицаОстатки);
	
	ТаблицаОстатки.Колонки.Найти("КоличествоБУ").Имя = "Количество";
	ТаблицаОстатки.Колонки.Найти("СуммаБУ").Имя = "СтоимостьБалансовая";
	
	ДокументОбъект.Остатки.Загрузить(ТаблицаОстатки);
	
	ДокументОбъект.НастройкаПорядка.Загрузить(ДанныеБухУчета.ТаблицаНастройкаПорядка);
	
КонецПроцедуры

Функция ПолучитьДанныеБухУчета_11100(ДокументОбъект)
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	ЗначенияДляОтбора = ПолучитьЗначенияДляОтбора_11100(ДокументОбъект);
	
	Договор = ЗначенияДляОтбора["СписокДоговоров"];
	
	// Приоритетным считаем отбор по Договору.
	// Если Договор не указан, но указан Контрагент, то отбираем по ВСЕМ договорам Контрагента.
	// Если не указан и Контрагент, то не накладываем отбор по Договору.
	
	УказанКонтрагент	= ЗначениеЗаполнено(ДокументОбъект.Контрагент);
	
	УказанДоговор		= ЗначениеЗаполнено(ДокументОбъект.Договор);
	
	ИспользоватьОтборПоДоговору = (УказанКонтрагент ИЛИ УказанДоговор);
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьОтборПоПодразделению = (ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение));
	
	ИспользоватьОтборПоИФО = (ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО));
	
	НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("Период",								ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации));
	ЗапросОстатки.УстановитьПараметр("Счет",								ДокументОбъект.СчетУчета);
	ЗапросОстатки.УстановитьПараметр("Организация",							ДокументОбъект.Организация);
	ЗапросОстатки.УстановитьПараметр("ЦМО",									ЗначенияДляОтбора["СписокЦМО"]);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ЗапросОстатки.УстановитьПараметр("ВидыСубконто",						ВидыСубконто);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоКФО",				ЗначениеЗаполнено(ДокументОбъект.КФО));
	ЗапросОстатки.УстановитьПараметр("КФО",									ДокументОбъект.КФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоКПС",				ЗначениеЗаполнено(ДокументОбъект.КПС));
	ЗапросОстатки.УстановитьПараметр("КПС",									ДокументОбъект.КПС);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоИФО",				ИспользоватьОтборПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИФО",									ДокументОбъект.ИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	ЗапросОстатки.УстановитьПараметр("Подразделение",						ДокументОбъект.Подразделение);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоДоговору",			ИспользоватьОтборПоДоговору);
	ЗапросОстатки.УстановитьПараметр("Договор",								Договор);
	ЗапросОстатки.УстановитьПараметр("Счета11140",							БухгалтерскийУчет.СписокСчетов("111.40", НаДату));
	ЗапросОстатки.УстановитьПараметр("ВидРаспоряжения",						Перечисления.ВидыРаспоряженияОС.НаБалансе);
	ЗапросОстатки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Остатки по регистру бухгалтерии без инв.номеров
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)					КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).Наименование	КАК ОсновноеСредствоНаименование,
	|	ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО)								КАК ЦМО,
	|	ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры)							КАК Договор,
	|	Счет																КАК Счет,
	|	КФО																	КАК КФО,
	|	КПС																	КАК КПС,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ																КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ																КАК ИФО,
	|	СУММА(СуммаОстатокДт)												КАК СуммаОстатокДт,
	|	СУММА(КоличествоОстатокДт)											КАК КоличествоОстатокДт
	|ПОМЕСТИТЬ
	|	ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&Период,					// 1
	|		Счет В ИЕРАРХИИ (&Счет),	// 2
	|		&ВидыСубконто,				// 3
	|		Организация = &Организация	// 4
	|		И Субконто2 В(&ЦМО)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|				Субконто3 В(&Договор)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКПС ТОГДА
	|				КПС = &КПС
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьОтборПоПодразделению И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства),
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).Наименование,
	|	ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО),
	|	ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры),
	|	Счет,
	|	КФО,
	|	КПС,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Инвентарные номера
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновноеСредство			КАК ОсновноеСредство,
	|	ИнвентарныйНомер			КАК ИнвентарныйНомер,
	|	ЦМО							КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ						КАК Подразделение,
	|	СУММА(СтоимостьОстаток)		КАК Сумма,
	|	СУММА(КоличествоОстаток)	КАК Количество
	|ПОМЕСТИТЬ
	|	ИнвНомера
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|		&Период,
	|		Организация = &Организация
	|		И ВидРаспоряжения = &ВидРаспоряжения
	|		И ОсновноеСредство В (ВЫБРАТЬ ОстаткиБУ.ОсновноеСредство ИЗ ОстаткиБУ)
	|		И ЦМО В(&ЦМО)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|				Договор В(&Договор)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)
	|СГРУППИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер,
	|	ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки по регистру бухгалтерии с инв.номерами
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБУ.ОсновноеСредство											КАК ОсновноеСредство,
	|	ОстаткиБУ.ОсновноеСредствоНаименование								КАК ОсновноеСредствоНаименование,
	|	ОстаткиБУ.ЦМО														КАК ЦМО,
	|	ОстаткиБУ.Договор													КАК Договор,
	|	ОстаткиБУ.Счет														КАК Счет,
	|	ОстаткиБУ.КФО														КАК КФО,
	|	ОстаткиБУ.КПС														КАК КПС,
	|	ОстаткиБУ.Подразделение												КАК Подразделение,
	|	ОстаткиБУ.ИФО														КАК ИФО,
	|	ЕСТЬNULL(ИнвНомера.Сумма, ОстаткиБУ.СуммаОстатокДт)					КАК СуммаБУ,
	|	ЕСТЬNULL(ИнвНомера.Количество, 
	|		ВЫБОР
	|			КОГДА Счет В(&Счета11140) ТОГДА
	|				1
	|			ИНАЧЕ
	|				ОстаткиБУ.КоличествоОстатокДт
	|		КОНЕЦ)															КАК КоличествоБУ,
	|	ЕСТЬNULL(ИнвНомера.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|	ЛЕВОЕ СОЕДИНЕНИЕ ИнвНомера КАК ИнвНомера
	|		ПО	ОстаткиБУ.ОсновноеСредство	= ИнвНомера.ОсновноеСредство
	|		И	ОстаткиБУ.ЦМО				= ИнвНомера.ЦМО
	|		И	ОстаткиБУ.Подразделение		= ИнвНомера.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для таблицы НастройкаПорядка
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиБУ.Подразделение,
	|	ОстаткиБУ.КФО,
	|	ОстаткиБУ.ИФО,
	|	ОстаткиБУ.ЦМО
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ";
	
	РезультатЗапроса = ЗапросОстатки.ВыполнитьПакет();
	
	ТаблицаОстатки = РезультатЗапроса[2].Выгрузить();
	
	ЗаполнитьНедостачуИЦену(ТаблицаОстатки, ДокументОбъект.НеЗаполнятьЦену);
	
	ДанныеБухУчета = Новый Структура();
	ДанныеБухУчета.Вставить("ТаблицаОстатки", ТаблицаОстатки);
	ДанныеБухУчета.Вставить("ТаблицаНастройкаПорядка", РезультатЗапроса[3].Выгрузить());
	
	Возврат ДанныеБухУчета;
	
КонецФункции

Функция ПолучитьЗначенияДляОтбора_11100(ДокументОбъект)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ЦМО",				ДокументОбъект["ЦМО"]);
	ЗапросПоиск.УстановитьПараметр("УказанДоговор",		ЗначениеЗаполнено(ДокументОбъект["Договор"]));
	ЗапросПоиск.УстановитьПараметр("Договор",			ДокументОбъект["Договор"]);
	ЗапросПоиск.УстановитьПараметр("УказанКонтрагент",	ЗначениеЗаполнено(ДокументОбъект["Контрагент"]));
	ЗапросПоиск.УстановитьПараметр("Контрагент",		ДокументОбъект["Контрагент"]);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все значения для отбора по МОЛ
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Ссылка = &ЦМО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Сотрудник = &ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все значения для отбора по Договору
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	&УказанДоговор
	|	И Ссылка В ИЕРАРХИИ(&Договор)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	&УказанКонтрагент И НЕ &УказанДоговор
	|	И Контрагент В ИЕРАРХИИ(&Контрагент)
	|;";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	// [0]. Все значения для отбора по МОЛ
	СписокЦМО = РезультатыПоиска[0].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// [1]. Все значения для отбора по Договору
	СписокДоговоров = РезультатыПоиска[1].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ЗначенияДляОтбора = Новый Структура();
	ЗначенияДляОтбора.Вставить("СписокЦМО",			СписокЦМО);
	ЗначенияДляОтбора.Вставить("СписокДоговоров",	СписокДоговоров);
	
	Возврат ЗначенияДляОтбора;
	
КонецФункции

Процедура ЗаполнитьНедостачуИЦену(Таблица, НеЗаполнятьЦену)
	
	Таблица.Колонки.Добавить("КоличествоНедостач",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,0)));
	Таблица.Колонки.Добавить("СуммаНедостач",		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	Таблица.Колонки.Добавить("Цена",				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,5)));
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.КоличествоНедостач	= СтрокаТаблицы.КоличествоБУ;
		СтрокаТаблицы.СуммаНедостач			= СтрокаТаблицы.СуммаБУ;
		
		Если НеЗаполнятьЦену ИЛИ СтрокаТаблицы.КоличествоБУ = 0 Тогда
			Продолжить;
		Иначе
			СтрокаТаблицы.Цена = СтрокаТаблицы.СуммаБУ / СтрокаТаблицы.КоличествоБУ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСчетаИсточникСуммРегистрБухгалтерии(ДокументОбъект)
	
	НаДату = НачалоДня(ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации));
	
	Возврат БухгалтерскийУчет.СписокСчетов("106.00", НаДату);
	
КонецФункции

