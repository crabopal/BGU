#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	НепроверяемыеРеквизиты.Добавить("Инвентаризация.Счет");
	НепроверяемыеРеквизиты.Добавить("Инвентаризация.КФО");
	НепроверяемыеРеквизиты.Добавить("Инвентаризация.КПС");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ЭтотОбъект, Отказ);
	
	ТаблицаИнвентаризация = Инвентаризация.Выгрузить(,"НомерСтроки, Счет");
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетаДокумента.НомерСтроки КАК НомерСтроки,
	                      |	СчетаДокумента.Счет КАК Счет
	                      |ПОМЕСТИТЬ СчетаДокумента
	                      |ИЗ
	                      |	&СчетаДокумента КАК СчетаДокумента
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СчетаДокумента.НомерСтроки КАК НомерСтроки,
	                      |	ПРЕДСТАВЛЕНИЕ(СчетаДокумента.Счет) КАК Представление
	                      |ИЗ
	                      |	СчетаДокумента КАК СчетаДокумента
	                      |ГДЕ
	                      |	НЕ СчетаДокумента.Счет В ИЕРАРХИИ (&СчетУчета)
	                      |	И СчетаДокумента.Счет <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)");
	Запрос.УстановитьПараметр("СчетаДокумента", ТаблицаИнвентаризация);
	Запрос.УстановитьПараметр("СчетУчета", СчетУчета);
	Выборка = Запрос.Выполнить().Выбрать();					  
	КоличествоОшибок = Выборка.Количество();
	Если КоличествоОшибок > 0 Тогда
		ТекстОшибки = НСтр("ru='В строке %1 счет учета %2 не совпадает со счетом документа'");
		Отказ = Истина;
		Пока Выборка.Следующий() Цикл
		
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.НомерСтроки, Выборка.Представление),
															,,"Объект.Инвентаризация["+(Выборка.НомерСтроки-1)+"].Счет");
		
		КонецЦикла; 
	КонецЕсли;
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьЗаполнениеПолногоСчетаВТабличнойЧасти(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	// удалим из таблицы Остатки все ОС, не вошедшие в инвентаризацию
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентаризацияОСОстатки.ИФО,
	               |	ИнвентаризацияОСОстатки.КФО,
	               |	ИнвентаризацияОСОстатки.КПС,
	               |	ИнвентаризацияОСОстатки.Счет,
	               |	ИнвентаризацияОСОстатки.ОсновноеСредство,
	               |	ИнвентаризацияОСОстатки.ИнвентарныйНомер,
	               |	ИнвентаризацияОСОстатки.Количество,
	               |	ИнвентаризацияОСОстатки.СтоимостьБалансовая,
	               |	ИнвентаризацияОСОстатки.ЦМО,
	               |	ИнвентаризацияОСОстатки.Подразделение
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	&Остатки КАК ИнвентаризацияОСОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИнвентаризацияОСИнвентаризация.ОсновноеСредство,
	               |	ИнвентаризацияОСИнвентаризация.ИнвентарныйНомер,
	               |	ИнвентаризацияОСИнвентаризация.Цена,
	               |	ИнвентаризацияОСИнвентаризация.КоличествоБУ,
	               |	ИнвентаризацияОСИнвентаризация.КоличествоФУ,
	               |	ИнвентаризацияОСИнвентаризация.СуммаБУ,
	               |	ИнвентаризацияОСИнвентаризация.СуммаФУ,
	               |	ИнвентаризацияОСИнвентаризация.ЕстьОтклонения,
	               |	ИнвентаризацияОСИнвентаризация.КоличествоНедостач,
	               |	ИнвентаризацияОСИнвентаризация.СуммаНедостач,
	               |	ИнвентаризацияОСИнвентаризация.КоличествоИзлишков,
	               |	ИнвентаризацияОСИнвентаризация.СуммаИзлишков,
	               |	ИнвентаризацияОСИнвентаризация.Счет
	               |ПОМЕСТИТЬ Инвентаризация
	               |ИЗ
	               |	&Инвентаризация КАК ИнвентаризацияОСИнвентаризация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	Остатки КАК Остатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Инвентаризация КАК Инвентаризация
	               |		ПО Остатки.ОсновноеСредство = Инвентаризация.ОсновноеСредство
	               |			И Остатки.ИнвентарныйНомер = Инвентаризация.ИнвентарныйНомер
	               |ГДЕ
	               |	Инвентаризация.ОсновноеСредство ЕСТЬ NULL 
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Остатки.ИФО,
	               |	Остатки.КФО,
	               |	Остатки.КПС,
	               |	Остатки.Счет,
	               |	Остатки.ОсновноеСредство,
	               |	Остатки.ИнвентарныйНомер,
	               |	Остатки.Количество,
	               |	Остатки.СтоимостьБалансовая,
	               |	Остатки.ЦМО,
	               |	Остатки.Подразделение
	               |ИЗ
	               |	Остатки КАК Остатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Инвентаризация КАК Инвентаризация
	               |		ПО Остатки.ОсновноеСредство = Инвентаризация.ОсновноеСредство
	               |			И Остатки.ИнвентарныйНомер = Инвентаризация.ИнвентарныйНомер
	               |ГДЕ
	               |	Инвентаризация.ОсновноеСредство ЕСТЬ НЕ NULL";
	Запрос.УстановитьПараметр("Остатки", 		Остатки.Выгрузить());
	Запрос.УстановитьПараметр("Инвентаризация", Инвентаризация.Выгрузить());
	Результат = Запрос.ВыполнитьПакет();
	ФлагИзменения = НЕ Результат[2].Пустой();
	Если ФлагИзменения Тогда
		Остатки.Загрузить(Результат[3].Выгрузить());
	КонецЕсли;
	
	// Удаляем неиспользуемые реквизиты для текущего варианта использования описи
	ИнвентаризацияСервер.ВариантФормированияОписи0504087_ОчиститьНеиспользуемыеРеквизиты(ЭтотОбъект);
	
	Если НЕ Документы.ИнвентаризацияОС.ИспользуетсяКолонкаИнвНомер(ЭтотОбъект) Тогда
		ОчищающаяСтруктура = Новый Структура("ИнвентарныйНомер");
		
		Для Каждого СтрокаТаблицы Из ЭтотОбъект.Инвентаризация Цикл
			ЗаполнитьЗначенияСвойств(Строкатаблицы, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
	МаксимальноеКоличествоСтрок = 99999;
	
	Если ЭтотОбъект.Инвентаризация.Количество() <= МаксимальноеКоличествоСтрок И ЭтотОбъект.Остатки.Количество() > МаксимальноеКоличествоСтрок Тогда
		КоличествоСтрок = ЭтотОбъект.Остатки.Количество();
		
		НомерПервойУдаляемойСтроки = МаксимальноеКоличествоСтрок + 1;
		
		Для Счетчик = НомерПервойУдаляемойСтроки По КоличествоСтрок Цикл
			ЭтотОбъект.Остатки.Удалить(НомерПервойУдаляемойСтроки - 1);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Остатки.Очистить();
	Инвентаризация.Очистить();
	Недостачи.Очистить();
	Излишки.Очистить();
	НастройкаПорядка.Очистить();
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ИнвентаризацияСервер.УстановитьДатуИнвентаризации(ДанныеЗаполнения, ЭтотОбъект);
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ТипДанныхЗаполнения = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("СписокОсновныхСредств") Тогда
		
		ЗаполнитьИнвентаризациюСОтборомПоОсновнымСредствам(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Прослеживаемость.ВедетсяУчетПрослеживаемыхТоваров(Дата) Тогда
		ПрослеживаемостьБГУ.ЗарегистрироватьПрослеживаемыйТовар(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПрослеживаемостьБГУ.УдалениеПроведенияПервичногоДокумента(Ссылка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИнвентаризациюСОтборомПоОсновнымСредствам(ДанныеЗаполнения)
	
	Дата         = ДанныеЗаполнения.Дата;
	Организация  = ДанныеЗаполнения.Организация;
	ЦМО          = ДанныеЗаполнения.ЦМО;
	СчетУчета    = ДанныеЗаполнения.ГруппаСчетов;
	ВариантФормированияОписи = 1;
	
	ДатаИнвентаризации = Дата;
	ДатаНачала         = Дата;
	ДатаОкончания      = Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&ГруппаСчетов)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
	Запрос.УстановитьПараметр("ГруппаСчетов", СчетУчета);
	СчетаОстатков = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Документы.ИнвентаризацияОС.ЗаполнитьПоДаннымУчета(ЭтотОбъект, Ложь);
	СтрокиКУдалению = Новый Массив;
	
	Для каждого СтрокаОС Из Инвентаризация Цикл
		
		Если ДанныеЗаполнения.СписокОсновныхСредств.Найти(СтрокаОС.ОсновноеСредство) = Неопределено Тогда
			СтрокиКУдалению.Добавить(СтрокаОС);
		КонецЕсли;
	
	КонецЦикла; 
	
	Для каждого УдаляемаяСтрока Из СтрокиКУдалению Цикл
	
		Инвентаризация.Удалить(УдаляемаяСтрока);
	
	КонецЦикла;
	
	Документы.ИнвентаризацияОС.РассчитатьПоказателиВТаблице(
		Инвентаризация,
		ВариантФормированияОписи,
		,
		Истина);

	ПрослеживаемостьБГУ.ЗаполнитьПрослеживаемыеТовары(ЭтотОбъект, Ложь);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли