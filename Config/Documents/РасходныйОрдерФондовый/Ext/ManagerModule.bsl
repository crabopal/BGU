#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс	
	
// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РасходныйКассовыйОрдер";
	КомандаПечати.Идентификатор		= "КО2";
	КомандаПечати.Представление		= НСтр("ru = 'Расходный кассовый ордер'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"КО2") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"КО2","РКО",ПечатьКО2(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	             |	РасходныйОрдерФондовыйРасшифровка.Ссылка.Дата КАК Период,
	             |	РасходныйОрдерФондовыйРасшифровка.Ссылка.Организация,
	             |	ВЫБОР
	             |		КОГДА РасходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение.ВедетсяКассоваяКнига
	             |			ТОГДА РасходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение
	             |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	             |	КОНЕЦ КАК Подразделение,
	             |	РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
	             |	СУММА(РасходныйОрдерФондовыйРасшифровка.Количество) КАК Количество,
	             |	СУММА(РасходныйОрдерФондовыйРасшифровка.Сумма) КАК Сумма,
	             |	РасходныйОрдерФондовыйРасшифровка.КФО,
	             |	РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента
	             |ИЗ
	             |	Документ.РасходныйОрдерФондовый.Расшифровка КАК РасходныйОрдерФондовыйРасшифровка
	             |ГДЕ
	             |	РасходныйОрдерФондовыйРасшифровка.Ссылка = &Ссылка
	             |	И РасходныйОрдерФондовыйРасшифровка.Ссылка.Оплачено
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	РасходныйОрдерФондовыйРасшифровка.Ссылка.Организация,
	             |	РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
	             |	РасходныйОрдерФондовыйРасшифровка.Ссылка.Дата,
	             |	РасходныйОрдерФондовыйРасшифровка.КФО,
	             |	РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента,
	             |	ВЫБОР
	             |		КОГДА РасходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение.ВедетсяКассоваяКнига
	             |			ТОГДА РасходныйОрдерФондовыйРасшифровка.Ссылка.Подразделение
	             |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	             |	КОНЕЦ";
				 
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ДенежныеДокументыДвижения = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ТаблицыДляДвижений.Вставить("ДенежныеДокументы",  ДенежныеДокументыДвижения);
	
КонецПроцедуры //ИнициализироватьДанныеДокумента()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.РасходныйОрдерФондовый -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 12
	|	И ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0";
		
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	РКО.Ссылка КАК Ссылка,
	|	РКО.ДокументОснование,
	|	СоставДокумента.ДенежныйДокумент,
	|	ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка) КАК СерияБСО,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача),
	|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка),
	|	СоставДокумента.Количество,
	|	0 КАК НомерНачальный,
	|	0 КАК НомерКонечный
	|ИЗ
	|	Документ.РасходныйОрдерФондовый КАК РКО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерФондовый.Расшифровка КАК СоставДокумента
	|		ПО РКО.Ссылка = СоставДокумента.Ссылка
	|ГДЕ
	|	РКО.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ РКО.ПометкаУдаления
	|	И РКО.Ссылка <> &РасходныйОрдерФондовыйСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьКО2(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КО2";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КО2");
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	РасходныйОрдерФондовый.Ссылка,
	             |	РасходныйОрдерФондовый.Номер КАК Номер,
	             |	РасходныйОрдерФондовый.Дата КАК ДатаДокумента,
	             |	РасходныйОрдерФондовый.Организация,
	             |	РасходныйОрдерФондовый.Подразделение,
	             |	РасходныйОрдерФондовый.ПодразделениеКор.Код КАК КодПодразделения,
	             |	РасходныйОрдерФондовый.СуммаДокумента,
	             |	РасходныйОрдерФондовый.ПодразделениеКор,
	             |	РасходныйОрдерФондовый.Счет,
	             |	РасходныйОрдерФондовый.КорСчет,
	             |	РасходныйОрдерФондовый.Выдать КАК ФИОПолучателя,
	             |	РасходныйОрдерФондовый.Основание,
	             |	РасходныйОрдерФондовый.Приложение,
	             |	РасходныйОрдерФондовый.Руководитель,
	             |	РасходныйОрдерФондовый.ГлБухгалтер,
	             |	РасходныйОрдерФондовый.Кассир,
	             |	РасходныйОрдерФондовый.ПоДокументу КАК РеквизитыДокументаУдостоверяющегоЛичность,
	             |	РасходныйОрдерФондовый.Организация.Наименование КАК НаименованиеОрганизации,
	             |	РасходныйОрдерФондовый.Подразделение.Наименование КАК НаименованиеПодразделения,
	             |	РасходныйОрдерФондовый.Организация.Префикс КАК ПрефиксОрганизации,
	             |	ВЫБОР
	             |		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	             |			ТОГДА ВложенныйЗапрос.КФО
	             |		ИНАЧЕ ""0""
	             |	КОНЕЦ КАК КФО,
	             |	РасходныйОрдерФондовый.КодЦелевогоНазначения.Код КАК КодЦелевогоНазначения,
	             |	РасходныйОрдерФондовый.КодАналитическогоУчета,
	             |	РасходныйОрдерФондовый.Организация.КодОКПО КАК ОрганизацияПоОКПО
	             |ИЗ
	             |	Документ.РасходныйОрдерФондовый КАК РасходныйОрдерФондовый
	             |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	             |			РасходныйОрдерФондовыйРасшифровка.Ссылка КАК Ссылка,
	             |			МАКСИМУМ(РасходныйОрдерФондовыйРасшифровка.КФО) КАК КФО,
	             |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасходныйОрдерФондовыйРасшифровка.КФО) КАК КоличествоКФО
	             |		ИЗ
	             |			Документ.РасходныйОрдерФондовый.Расшифровка КАК РасходныйОрдерФондовыйРасшифровка
	             |		ГДЕ
	             |			РасходныйОрдерФондовыйРасшифровка.Ссылка В(&МассивОбъектов)
	             |		
	             |		СГРУППИРОВАТЬ ПО
	             |			РасходныйОрдерФондовыйРасшифровка.Ссылка) КАК ВложенныйЗапрос
	             |		ПО РасходныйОрдерФондовый.Ссылка = ВложенныйЗапрос.Ссылка
	             |ГДЕ
	             |	РасходныйОрдерФондовый.Ссылка В(&МассивОбъектов)
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Номер";
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ОбластьШапка.Параметры.Заполнить(Шапка);
		СтруктураОбластьШапка = Новый Структура("НомерДокумента,Сумма,СуммаПрописью,ПредставлениеОрганизации,ПредставлениеПодразделения,ДебетСубСчет,КредитСубСчет,ФИОРуководителя,ФИОГлавногоБухгалтера,ФИОКассира");
		СтруктураОбластьШапка.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка,Шапка.Номер);
		
		//Сумма = Формат(Шапка.СуммаДокумента, "ЧЦ=15; ЧДЦ=2");
		//
		СтруктураОбластьШапка.Сумма = Шапка.СуммаДокумента;
		СтруктураОбластьШапка.СуммаПрописью=ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Шапка.СуммаДокумента,Константы.ВалютаРегламентированногоУчета.Получить());
		
		СтруктураОбластьШапка.ПредставлениеОрганизации=Шапка.НаименованиеОрганизации;
		СтруктураОбластьШапка.ПредставлениеПодразделения=Шапка.НаименованиеПодразделения;
		
		СтруктураОбластьШапка.ДебетСубСчет = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.КорСчет, , Шапка.КФО);
		СтруктураОбластьШапка.КредитСубСчет = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.Счет, , Шапка.КФО);
		
		СтруктураОбластьШапка.Вставить("КодЦелевогоНазначения", СокрЛП(Шапка.КодЦелевогоНазначения));
		
		СтруктураОбластьШапка.ФИОРуководителя = Справочники.Контрагенты.ФамилияИО(Шапка.Руководитель, Истина, Шапка.ДатаДокумента);
		СтруктураОбластьШапка.ФИОГлавногоБухгалтера = Справочники.Контрагенты.ФамилияИО(Шапка.ГлБухгалтер, Истина, Шапка.ДатаДокумента);
		СтруктураОбластьШапка.ФИОКассира = Справочники.Контрагенты.ФамилияИО(Шапка.Кассир, Истина, Шапка.ДатаДокумента);
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Объединить();
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Обвести(Линия, Линия, Линия, Линия);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Текст                   = "Ф О Н Д О В Ы Й";
		ЦветПечати                                              = Новый Цвет(83,114,187); 
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветТекста              = ЦветПечати;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветРамки               = ЦветПечати;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
		ЖирныйШрифт                                             = Новый Шрифт(ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт,, 11, Истина);
		ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт                   = ЖирныйШрифт;
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ-основание'");
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТипДанныхЗаполнения = ТипЗнч(Основание);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОКомандировании") Тогда
		ЗаполнитьДокументНаОснованииРешенияОКомандировании(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
		ЗаполнитьДокументНаОснованииРешенияОКомпенсации(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
		ИЛИ ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ЗаполнитьДокументНаОснованииЗаявкиОбоснованияЗакупкиМалогоОбъема(Основание, Объект, Отказ, ОписаниеОшибки);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьДокументНаОснованииРешенияОКомандировании(ДокументОснование, Объект)
	
	Объект.ДокументОснование = ДокументОснование;
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументОснование,"Организация, ИФО, Подразделение");
	
	Объект.КорСчет 			= БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	Объект.Счет 			= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.35");
	Объект.ПодразделениеКор = ДокументОснование.Подразделение;
	Объект.Контрагент 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.Сотрудник, "Контрагент");
	Объект.Договор 			= ДокументОснование.ОснованиеПринятияОбязательства;
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.Выдать, Объект.ПоДокументу);
	
	ТаблицаДляЗаполнения = ДокументОснование.ФинансовоеОбеспечение.Выгрузить(,"КФО, КПС, Сумма");
	ТаблицаДляЗаполнения.Очистить();
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из ДокументОснование[ТЧ] Цикл
			Если СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов") Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТаблицаДляЗаполнения.Добавить(), СтрокаТЧ);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
		
		Если СтрокаОснования.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект.Расшифровка.Добавить(), СтрокаОснования);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект.Расшифровка.Итог("Сумма");
	
КонецПроцедуры

