Процедура ЗаполнитьДокументНаОснованииЗаявкиОбоснованияЗакупкиМалогоОбъема(ДокументОснование, Объект, Отказ, ОписаниеОшибки)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "СпособВыдачиДенежныхСредств")
			<> Перечисления.СпособыВыдачиДенежныхСредствПодотчетномуЛицу.ДенежныеДокументы Тогда
		Отказ = Истина;
		ОписаниеОшибки = НСтр("ru='Неподходящий способ выдачи денежных средств'");
		Возврат;
	КонецЕсли;
	
	Объект.ДокументОснование = ДокументОснование;
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументОснование, "Организация, ИФО, Подразделение");
	
	КЭКОснования = ДокументОснование.ТоварыРаботыУслуги.ВыгрузитьКолонку("КЭК");
	КЭКОснования = ОбщегоНазначенияКлиентСервер.СвернутьМассив(КЭКОснования);
	
	Если КЭКОснования.Количество() = 1 Тогда
		Объект.КорСчет = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			КЭКОснования[0], "208.00", , ТекущаяДатаСеанса(), Объект.Организация, Объект.ИФО);
	Иначе
		Объект.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	КонецЕсли;
	Объект.Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.35");
	Объект.ПодразделениеКор = ДокументОснование.Подразделение;
	Объект.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.ПодотчетноеЛицо, "Контрагент");
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		Объект.Договор = ДокументОснование.ОснованиеПринятияОбязательства;
	Иначе
		Объект.Договор = ДокументОснование.Договор;
	КонецЕсли;
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.Выдать, Объект.ПоДокументу);
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема") Тогда
		ТаблицаДляЗаполнения = ДокументОснование.ТоварыРаботыУслуги.Выгрузить(,"КФО, КПС, Сумма, Количество");
	Иначе
		ТаблицаДляЗаполнения = ДокументОснование.ТоварыРаботыУслуги.Выгрузить(,"КФО, КПС, Сумма, Количество, ДенежныйДокумент");
	КонецЕсли;
	ТаблицаДляЗаполнения.Очистить();
	
	Для Каждого СтрокаТЧ Из ДокументОснование["ТоварыРаботыУслуги"] Цикл
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
			И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов") Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТаблицаДляЗаполнения.Добавить(), СтрокаТЧ);
	КонецЦикла;
	
	Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
		
		Если СтрокаОснования.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.Расшифровка.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования);
		
		Если ЗначениеЗаполнено(НоваяСтрока.ДенежныйДокумент) Тогда
			НоваяСтрока.ВидДенежногоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				НоваяСтрока.ДенежныйДокумент, "Владелец");
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект.Расшифровка.Итог("Сумма");
	
КонецПроцедуры

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДокументИнвентаризации - ДокументСсылка.ИнвентаризационнаяОписьБСО - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.РасходныйОрдерФондовый, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510465(ДокументИнвентаризации, ЗаполняемыйДокумент) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокументаИнвентаризации.СчетУчета КАК СчетУчета,
	|	ДанныеДокументаИнвентаризации.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ДанныеДокументаИнвентаризации.ДенежныйДокумент КАК ДенежныйДокумент,
	|	ДанныеДокументаИнвентаризации.КФО КАК КФО,
	|	ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено КАК Количество,
	|	ДанныеДокументаИнвентаризации.СуммаНедостачаНеПодтверждено КАК Сумма
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеДокументаИнвентаризации
	|ГДЕ
	|	(ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.СуммаНедостачаНеПодтверждено <> 0)
	|	И ДанныеДокументаИнвентаризации.ВидОбъекта = 12";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаполняемыйДокумент.СуммаДокумента = 0;
	Пока Выборка.Следующий() Цикл
		ЗаполняемыйДокумент.Счет = Выборка.СчетУчета;
		НоваяСтрока = ЗаполняемыйДокумент.Расшифровка.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ЗаполняемыйДокумент.СуммаДокумента = ЗаполняемыйДокумент.СуммаДокумента + НоваяСтрока.Сумма;
	КонецЦикла;

КонецПроцедуры

// Получает данные о контрагенте. Фамилия, имя, отчество и документ физического лица.
//
Процедура ЗаполнитьДанныеКонтрагента(Контрагент, Выдать, ПоДокументу) Экспорт
	
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ВыдатьКому, УдостоверениеЛичности", Контрагент); 
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	Если ЗначениеЗаполнено(ДанныеКонтрагента.ВыдатьКому) Тогда
		Выдать = ДанныеКонтрагента.ВыдатьКому;
	ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
		Выдать = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
	Иначе
		Выдать = ДанныеКонтрагента.НаименованиеПолное;
	КонецЕсли;
	ПоДокументу = ДанныеКонтрагента.УдостоверениеЛичности;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
