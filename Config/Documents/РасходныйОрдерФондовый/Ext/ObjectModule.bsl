#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Перем ИсходныйРежимЗаписи;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект); 
	
	ДополнительныеСвойства.Свойство("ИсходныйРежимЗаписи", ИсходныйРежимЗаписи);
	
	ТекущиеПрава = КассаОрганизации.ПраваНаТекущийКассовыйДокумент(Ссылка);
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьОтменуПроведения;
	ИначеЕсли Проведен Тогда
		Если ИсходныйРежимЗаписи <> Неопределено 
			И ИсходныйРежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
		Иначе
			Отказ = Не ТекущиеПрава.РазрешитьПроведение;
		КонецЕсли;
	Иначе
		Отказ = НЕ ТекущиеПрава.РазрешитьПроведение;
	КонецЕсли;
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для выполнения операции'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОтчетКассира=Неопределено;
		Отказ = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Изменение документа запрещено. Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение и Оплачено = Ложь Тогда
		ОтчетКассира=Неопределено;
		Отказ = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Нельзя снять флаг ""Оплачено"". Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	ОтчетКассира = Неопределено;
	Отказ        = БухгалтерскийУчет.ЕстьПроведенныйОтчетКассираЗаЭтотДень(ЭтотОбъект, ОтчетКассира);
	Если Отказ Тогда
		
		ТекстСообщения = НСтр("ru='Документ не может быть записан с текущей датой, т.к. за данный день уже имеется проведенный документ Отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.РасходныйОрдерФондовый.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДенежныеДокументы")
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения) Тогда
		ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокОснование = Неопределено;
		ДанныеЗаполнения.Свойство("Основание", ДокОснование);
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияКассы.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
		
	ИначеЕсли ДанныеЗаполнения <> Неопределено Тогда
		
		ТекстСообщения = "";
		Если НЕ Документы.РасходныйОрдерФондовый.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ВызватьИсключение НСтр("ru='На основании выбранного документа нельзя ввести расходный кассовый ордер (фондовый) по причине:'")
				+ Символы.ПС + ТекстСообщения;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	КассаОрганизации.ПроверитьКорректностьЗаполненияТаблицыКассовогоДокумента(ЭтотОбъект, "Расшифровка", Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		И ДанныеЗаполнения.Свойство("Разделитель");
КонецФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДанныеЗаполнения - Структура:
//   * Разделитель - Структура
//   * ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьБСО
Процедура ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения)
	Расшифровка.Очистить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация"));
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
	КорСчет = БухгалтерскийУчет.СчетПоКоду("401.10", Дата, Организация);
	Документы.РасходныйОрдерФондовый.ЗаполнитьПоИнвентаризации0510465(
		ДанныеЗаполнения.ДокументОснование,
		ЭтотОбъект)
КонецПроцедуры

#КонецОбласти

#КонецЕсли