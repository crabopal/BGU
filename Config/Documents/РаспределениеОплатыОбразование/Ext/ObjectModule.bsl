#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		
		Если Распределение.Количество() = 0 Тогда
			
			ТекстСообщения = НСтр("ru = 'Необходимо заполнить документ оплатами!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.Распределение",, Отказ);
			
		КонецЕсли;
		
		Если СуществуетДокументЗаЭтотДень() Тогда
			
			ТекстСообщения = НСтр("ru = 'Распределение оплаты за " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy")+" уже создано.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.Дата",, Отказ)
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ШаблонОшибкаРаспределения = НСтр("ru = 'Не распределена сумма в строке %НомерСтроки%'");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = РаботаСоСтудентами.ПолучитьТекстЗапросаСтатусовРаспределенияОплаты();
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Распределение", Распределение.Выгрузить(, "НомерСтроки, Студент, КодСтроки, Сумма, СуммаВалюта"));
	Запрос.УстановитьПараметр("РаспределениеОбщих", РаспределениеОбщихДоговоров.Выгрузить(, "КодСтроки, Сумма, СуммаВалюта"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СтатусРаспределения = 2 Тогда // Не распределено
			
			ТекстСообщения = СтрЗаменить(ШаблонОшибкаРаспределения, "%НомерСтроки%", Строка(Выборка.НомерСтроки));
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Распределение", Выборка.НомерСтроки, "Сумма");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, Поле, "Объект", Отказ);	
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.РаспределениеОплатыОбразование.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетыСоСтудентами");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетыСоСтудентамиДопУслуги");
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Распределение.Очистить();
	РаспределениеОбщихДоговоров.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция проверяет существование распределение оплаты на дату.
// 
// Возвращаемое значение: 
// Булево.
// Истина - существует другое распределение за этот день,
// Ложь - не существует.
// 
Функция СуществуетДокументЗаЭтотДень()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Документ.Ссылка
	               |ИЗ
	               |	Документ.РаспределениеОплатыОбразование КАК Документ
	               |ГДЕ
	               |	Документ.Организация = &Организация
	               |	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
	               |	И Документ.Ссылка <> &Ссылка
	               |	И Документ.Факультет = &Факультет
	               |	И Документ.Проведен";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#КонецЕсли
