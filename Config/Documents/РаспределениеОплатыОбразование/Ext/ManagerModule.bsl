				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаБезФакультета.КоличествоОшибок = СтатистикаБезФакультета.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;


КонецПроцедуры

Процедура ОбработатьДокументБезФакультетаДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ДокОбъект.Распределение.Количество() = 0 И ДокОбъект.РаспределениеОбщихДоговоров.Количество() = 0 Тогда
