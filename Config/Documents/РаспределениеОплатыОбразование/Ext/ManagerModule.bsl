		Запрос.УстановитьПараметр("ДатаДокумента", ДокОбъект.Дата);
				
		Запрос.Текст = "ВЫБРАТЬ
		               |	РаспределениеОплатыОбразованиеРаспределение.НомерСтроки КАК НомерСтроки,
		               |	РаспределениеОплатыОбразованиеРаспределение.Студент КАК Студент,
		               |	РаспределениеОплатыОбразованиеРаспределение.Контрагент КАК Контрагент,
		               |	РаспределениеОплатыОбразованиеРаспределение.ДоговорКонтрагента КАК ДоговорКонтрагента,
		               |	РаспределениеОплатыОбразованиеРаспределение.Сумма КАК Сумма,
		               |	РаспределениеОплатыОбразованиеРаспределение.СуммаВалюта КАК СуммаВалюта,
		               |	РаспределениеОплатыОбразованиеРаспределение.Валюта КАК Валюта,
		               |	РаспределениеОплатыОбразованиеРаспределение.ДокументОплаты КАК ДокументОплаты,
		               |	РаспределениеОплатыОбразованиеРаспределение.КодСтроки КАК КодСтроки,
		               |	РаспределениеОплатыОбразованиеРаспределение.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		               |	РаспределениеОплатыОбразованиеРаспределение.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		               |	РаспределениеОплатыОбразованиеРаспределение.НомерПервичногоДокумента КАК НомерПервичногоДокумента
		               |ПОМЕСТИТЬ ТЧРаспределение
		               |ИЗ
		               |	Документ.РаспределениеОплатыОбразование.Распределение КАК РаспределениеОплатыОбразованиеРаспределение
		               |ГДЕ
		               |	РаспределениеОплатыОбразованиеРаспределение.Ссылка = &Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.НомерСтроки КАК НомерСтроки,
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Студент КАК Студент,
		               |	ТЧРаспределение.ДоговорКонтрагента КАК ДоговорКонтрагента,
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Сумма КАК Сумма,
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.СуммаВалюта КАК СуммаВалюта,
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.КодСтроки КАК КодСтроки
		               |ПОМЕСТИТЬ ТЧРаспределениеОбщихДоговоров
		               |ИЗ
		               |	Документ.РаспределениеОплатыОбразование.РаспределениеОбщихДоговоров КАК РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЧРаспределение КАК ТЧРаспределение
		               |		ПО РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.КодСтроки = ТЧРаспределение.КодСтроки
		               |ГДЕ
		               |	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка = &Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СведенияОСтудентахСрезПоследних.Студент КАК Студент,
		               |	СведенияОСтудентахСрезПоследних.Договор КАК Договор,
