#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	РаспределениеОплатыОбразованиеРаспределение.Ссылка.Дата КАК Период,
	|	РаспределениеОплатыОбразованиеРаспределение.Студент КАК Студент,
	|	РаспределениеОплатыОбразованиеРаспределение.Ссылка.Организация КАК Организация,
	|	РаспределениеОплатыОбразованиеРаспределение.Факультет КАК Факультет,
	|	РаспределениеОплатыОбразованиеРаспределение.Контрагент КАК Контрагент,
	|	РаспределениеОплатыОбразованиеРаспределение.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РаспределениеОплатыОбразованиеРаспределение.Валюта КАК ВалютаВзаиморасчетов,
	|	РаспределениеОплатыОбразованиеРаспределение.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.ДокументОплаты КАК ДокументОплаты,
	|	РаспределениеОплатыОбразованиеРаспределение.Сумма КАК СуммаРегл,
	|	РаспределениеОплатыОбразованиеРаспределение.СуммаВалюта КАК СуммаВзаиморасчетов,
	|	РаспределениеОплатыОбразованиеРаспределение.РасчетыДопУслуги КАК РасчетыДопУслуги,
	|	РаспределениеОплатыОбразованиеРаспределение.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	|ПОМЕСТИТЬ ВТ_ДанныеДокумента
	|ИЗ
	|	Документ.РаспределениеОплатыОбразование.Распределение КАК РаспределениеОплатыОбразованиеРаспределение
	|ГДЕ
	|	РаспределениеОплатыОбразованиеРаспределение.Ссылка = &Ссылка
	|	И РаспределениеОплатыОбразованиеРаспределение.Студент <> ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	РаспределениеОплатыОбразованиеРаспределение.Ссылка.Дата,
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Студент,
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка.Организация,
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Факультет,
	|	РаспределениеОплатыОбразованиеРаспределение.Контрагент,
	|	РаспределениеОплатыОбразованиеРаспределение.ДоговорКонтрагента,
	|	РаспределениеОплатыОбразованиеРаспределение.Валюта,
	|	РаспределениеОплатыОбразованиеРаспределение.ВидПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.ДатаПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.НомерПервичногоДокумента,
	|	РаспределениеОплатыОбразованиеРаспределение.ДокументОплаты,
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Сумма,
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.СуммаВалюта,
	|	РаспределениеОплатыОбразованиеРаспределение.РасчетыДопУслуги,
	|	РаспределениеОплатыОбразованиеРаспределение.НачислениеЗаУслугу
	|ИЗ
	|	Документ.РаспределениеОплатыОбразование.РаспределениеОбщихДоговоров КАК РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РаспределениеОплатыОбразование.Распределение КАК РаспределениеОплатыОбразованиеРаспределение
	|		ПО РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.КодСтроки = РаспределениеОплатыОбразованиеРаспределение.КодСтроки
	|ГДЕ
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка = &Ссылка
	|	И РаспределениеОплатыОбразованиеРаспределение.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокумента.ВидДвижения КАК ВидДвижения,
	|	ВТ_ДанныеДокумента.Период КАК Период,
	|	ВТ_ДанныеДокумента.Студент КАК Студент,
	|	ВТ_ДанныеДокумента.Организация КАК Организация,
	|	ВТ_ДанныеДокумента.Факультет КАК Факультет,
	|	ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_ДанныеДокумента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	ВТ_ДанныеДокумента.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ВТ_ДанныеДокумента.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ВТ_ДанныеДокумента.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ВТ_ДанныеДокумента.ДокументОплаты КАК ДокументОплаты,
	|	ВТ_ДанныеДокумента.СуммаРегл КАК СуммаРегл,
	|	ВТ_ДанныеДокумента.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
	|ИЗ
	|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
	|ГДЕ
	|	ВТ_ДанныеДокумента.РасчетыДопУслуги = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокумента.ВидДвижения КАК ВидДвижения,
	|	ВТ_ДанныеДокумента.Период КАК Период,
	|	ВТ_ДанныеДокумента.Студент КАК Студент,
	|	ВТ_ДанныеДокумента.Организация КАК Организация,
	|	ВТ_ДанныеДокумента.Факультет КАК Факультет,
	|	ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
	|	ВТ_ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_ДанныеДокумента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	ВТ_ДанныеДокумента.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ВТ_ДанныеДокумента.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ВТ_ДанныеДокумента.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ВТ_ДанныеДокумента.ДокументОплаты КАК ДокументОплаты,
	|	ВТ_ДанныеДокумента.СуммаРегл КАК СуммаРегл,
	|	ВТ_ДанныеДокумента.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ВТ_ДанныеДокумента.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	|ИЗ
	|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
	|ГДЕ
	|	ВТ_ДанныеДокумента.РасчетыДопУслуги = ИСТИНА";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	РасчетыСоСтудентамиДвижения = Результат[1].Выгрузить();
	РасчетыСоСтудентамиДопУслугиДвижения = Результат[2].Выгрузить();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("РасчетыСоСтудентами", РасчетыСоСтудентамиДвижения);
	ТаблицыДляДвижений.Вставить("РасчетыСоСтудентамиДопУслуги", РасчетыСоСтудентамиДопУслугиДвижения);
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Поиск документов для заполнения факультета в таб.части Распределение, РаспределениеОбщихДоговоров
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РаспределениеОплатыОбразованиеРаспределение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РаспределениеОплатыОбразование.Распределение КАК РаспределениеОплатыОбразованиеРаспределение
	|ГДЕ
	|	РаспределениеОплатыОбразованиеРаспределение.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	И РаспределениеОплатыОбразованиеРаспределение.Студент <> ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка
	|ИЗ
	|	Документ.РаспределениеОплатыОбразование.РаспределениеОбщихДоговоров КАК РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров
	|ГДЕ
	|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления
	// Заполнение документов (табличной части Распределение и РаспределениеОбщихДоговоров)
	
	ПолноеИмяОбъекта = "Документ.РаспределениеОплатыОбразование";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Сведения для заполнения факультета по данным реквизита шапки документа
	|//
	|ВЫБРАТЬ
	|	Ссылка КАК Документ
	|ИЗ
	|	ВТДляОбработки
	|ГДЕ
	|	ВТДляОбработки.Ссылка.Факультет <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Сведения для заполнения факультета по данным регистра сведений СведенияОСтудентах
	|//
	|ВЫБРАТЬ
	|	Ссылка КАК Документ
	|ИЗ
	|	ВТДляОбработки
	|ГДЕ
	|	ВТДляОбработки.Ссылка.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|;";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	// [0]. Сведения для заполнения факультета по данным реквизита шапки документа
	Результат0 = РезультатыЗапроса[0];
	
	// [1]. Сведения для заполнения факультета по данным регистра сведений СведенияОСтудентах
	Результат1 = РезультатыЗапроса[1];
	
	Если Результат0.Пустой() И Результат1.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	СтатистикаСФакультетом = Новый Структура();
	СтатистикаСФакультетом.Вставить("КоличествоОшибок",	0);
	СтатистикаСФакультетом.Вставить("Обработано",		0);
	
	СтатистикаБезФакультета = Новый Структура();
	СтатистикаБезФакультета.Вставить("КоличествоОшибок",0);
	СтатистикаБезФакультета.Вставить("Обработано",		0);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта",		ПолноеИмяОбъекта);
	ДополнительныеПараметры.Вставить("СтатистикаСФакультетом",	СтатистикаСФакультетом);
	ДополнительныеПараметры.Вставить("СтатистикаБезФакультета",	СтатистикаБезФакультета);
	
	Если Не Результат0.Пустой() Тогда
		ВыборкаФакультет = Результат0.Выбрать();
		
		ОбработатьДокументыСФакультетомДляПереходаНаНовуюВерсию(ВыборкаФакультет, ДополнительныеПараметры);
	КонецЕсли;
	
	Если Не Результат1.Пустой() Тогда
		ВыборкаПоРегистру = Результат1.Выбрать();
		
		ОбработатьДокументыБезФакультетаДляПереходаНаНовуюВерсию(ВыборкаПоРегистру, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаСФакультетом.Обработано = 0 И ДополнительныеПараметры.СтатистикаБезФакультета.Обработано = 0 Тогда
		
		СтатистикаОшибокВсего = ДополнительныеПараметры.СтатистикаСФакультетом.КоличествоОшибок + ДополнительныеПараметры.СтатистикаБезФакультета.КоличествоОшибок;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			СтатистикаОшибокВсего);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаСФакультетом.Обработано = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно завершено заполнение поля Факультет табличных частей по данным реквизита в документах РаспределениеОплатыОбразование в очередной порции объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаСФакультетом.Обработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаБезФакультета.Обработано = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно завершено заполнение поля Факультет табличных частей по данным регистра в документах РаспределениеОплатыОбразование в очередной порции объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаБезФакультета.Обработано);
		
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументыСФакультетомДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры)
	
	СтатистикаСФакультетом = ДополнительныеПараметры.СтатистикаСФакультетом;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Документ;
		
		Попытка
			
			ОбработатьДокументСФакультетомДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры);
			
			СтатистикаСФакультетом.Обработано = СтатистикаСФакультетом.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось заполнить Факультет в табличных частях документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаСФакультетом.КоличествоОшибок = СтатистикаСФакультетом.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;


КонецПроцедуры

Процедура ОбработатьДокументСФакультетомДляПереходаНаНовуюВерсию(ДокументСсылка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ДокОбъект.Распределение.Количество() = 0 И ДокОбъект.РаспределениеОбщихДоговоров.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	РаспределениеОплатыОбразованиеРаспределение.НомерСтроки КАК НомерСтроки,
		|	РаспределениеОплатыОбразованиеРаспределение.Студент КАК Студент,
		|	ВЫБОР
		|		КОГДА РаспределениеОплатыОбразованиеРаспределение.Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ РаспределениеОплатыОбразованиеРаспределение.Ссылка.Факультет
		|	КОНЕЦ КАК Факультет,
		|	РаспределениеОплатыОбразованиеРаспределение.Контрагент КАК Контрагент,
		|	РаспределениеОплатыОбразованиеРаспределение.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РаспределениеОплатыОбразованиеРаспределение.Сумма КАК Сумма,
		|	РаспределениеОплатыОбразованиеРаспределение.СуммаВалюта КАК СуммаВалюта,
		|	РаспределениеОплатыОбразованиеРаспределение.Валюта КАК Валюта,
		|	РаспределениеОплатыОбразованиеРаспределение.ДокументОплаты КАК ДокументОплаты,
		|	РаспределениеОплатыОбразованиеРаспределение.КодСтроки КАК КодСтроки,
		|	РаспределениеОплатыОбразованиеРаспределение.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	РаспределениеОплатыОбразованиеРаспределение.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	РаспределениеОплатыОбразованиеРаспределение.НомерПервичногоДокумента КАК НомерПервичногоДокумента
		|ИЗ
		|	Документ.РаспределениеОплатыОбразование.Распределение КАК РаспределениеОплатыОбразованиеРаспределение
		|ГДЕ
		|	РаспределениеОплатыОбразованиеРаспределение.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.НомерСтроки КАК НомерСтроки,
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Студент КАК Студент,
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка.Факультет КАК Факультет,
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Сумма КАК Сумма,
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.СуммаВалюта КАК СуммаВалюта,
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.КодСтроки КАК КодСтроки
		|ИЗ
		|	Документ.РаспределениеОплатыОбразование.РаспределениеОбщихДоговоров КАК РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров
		|ГДЕ
		|	РаспределениеОплатыОбразованиеРаспределениеОбщихДоговоров.Ссылка = &Ссылка";
				
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// [0]. Данные по ТЧ Распределение
		Результат0 = РезультатыЗапроса[0];
		Если НЕ Результат0.Пустой() Тогда
			ДокОбъект.Распределение.Загрузить(Результат0.Выгрузить());
		КонецЕсли;
				
		// [1]. Данные по ТЧ РаспределениеОбщихДоговоров
		Результат1 = РезультатыЗапроса[1];
		Если НЕ Результат1.Пустой() Тогда
			ДокОбъект.РаспределениеОбщихДоговоров.Загрузить(Результат1.Выгрузить());
		КонецЕсли;		
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьДокументыБезФакультетаДляПереходаНаНовуюВерсию(Выборка, ДополнительныеПараметры)
	
	СтатистикаБезФакультета = ДополнительныеПараметры.СтатистикаБезФакультета;
	
