#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОплатами(Команда)
	
	Если Объект.Распределение.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Список распределения будет перезаполнен. Продолжить?'");
		
		Оповещение = Новый ОписаниеОповещения("ЗапросНаОчисткуТабличнойЧасти", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьОплатамиСервер();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДанныхДокументаОплаты(Команда)
	
	ВидимостьДанныхДокументаОплаты = НЕ ВидимостьДанныхДокументаОплаты;
