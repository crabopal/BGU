#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспределение

&НаКлиенте
Процедура РаспределениеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Распределение.ТекущиеДанные;
	
	Если Поле.Имя = "РаспределениеСтудентТекст" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("Факультет", Объект.Факультет);
		ПараметрыФормы.Вставить("Контрагент", ТекущаяСтрока.Контрагент);
		ПараметрыФормы.Вставить("ДоговорКонтрагента", ТекущаяСтрока.ДоговорКонтрагента);
		ПараметрыФормы.Вставить("СуммаОплаты", ТекущаяСтрока.Сумма);
		ПараметрыФормы.Вставить("СуммаОплатыВалюта", ТекущаяСтрока.СуммаВалюта);
		ПараметрыФормы.Вставить("ВалютаВзаиморасчетов", ТекущаяСтрока.Валюта);
		ПараметрыФормы.Вставить("КодСтроки", ТекущаяСтрока.КодСтроки);
		ПараметрыФормы.Вставить("ДатаДокумента", Объект.Дата);
		ПараметрыФормы.Вставить("АдресСтудентовВХранилище", ПоместитьСтудентовВХранилище(ТекущаяСтрока.КодСтроки));
		
		ОткрытьФорму("Документ.РаспределениеОплатыОбразование.Форма.ФормаРаспределенияОбщихДоговоров", ПараметрыФормы, ЭтаФорма);
		
	ИначеЕсли Поле.Имя = "РаспределениеДокументОплаты" Тогда
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументОплаты) Тогда
			
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(Неопределено, ТекущаяСтрока.ДокументОплаты);			
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

