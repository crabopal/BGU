Процедура УстановитьВидимостьДокументовОплаты()
	
	Элементы.РаспределениеДокументОплаты.Видимость = ВидимостьДанныхДокументаОплаты;
	Элементы.РаспределениеГруппаПервичныйДокумент.Видимость = ВидимостьДанныхДокументаОплаты;
	
	Элементы.РаспределениеВидимостьДанныхДокументаОплаты.Заголовок = ?(ВидимостьДанныхДокументаОплаты, "Скрыть данные оплаты", "Показать данные оплаты");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВспомогательныеДанные()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = РаботаСоСтудентами.ПолучитьТекстЗапросаСтатусовРаспределенияОплаты();
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Распределение", Объект.Распределение.Выгрузить(, "НомерСтроки, Студент, КодСтроки, Сумма, СуммаВалюта"));
	Запрос.УстановитьПараметр("РаспределениеОбщих", Объект.РаспределениеОбщихДоговоров.Выгрузить(, "КодСтроки, Сумма, СуммаВалюта"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект.Распределение[Выборка.НомерСтроки - 1].СтатусРаспределения = Выборка.СтатусРаспределения;
		Объект.Распределение[Выборка.НомерСтроки - 1].СтудентТекст = Выборка.СтудентТекст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаИзмененияРаспределенияСтудентовНаСервере(ВыбранноеЗначение)
	
	ТаблицаРаспределенияПоСтудентам = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресСтудентовВХранилище);
	КодСтрокиПодбора = ВыбранноеЗначение.КодСтроки;
	
	// Заполняем данные распределения
	СтруктураПоиска = Новый Структура("КодСтроки", КодСтрокиПодбора);
	МассивНайденныхСтрок = Объект.РаспределениеОбщихДоговоров.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
		Объект.РаспределениеОбщихДоговоров.Удалить(НайденнаяСтрока);
	КонецЦикла; 
	
	ОбщаяСумма = 0;
	Для каждого СтрокаРаспределения Из ТаблицаРаспределенияПоСтудентам Цикл
		
		НоваяСтрока = Объект.РаспределениеОбщихДоговоров.Добавить();
		НоваяСтрока.Студент = СтрокаРаспределения.Студент;
		НоваяСтрока.Сумма = СтрокаРаспределения.Сумма;
		НоваяСтрока.СуммаВалюта = СтрокаРаспределения.СуммаВалюта;
		НоваяСтрока.КодСтроки = КодСтрокиПодбора;
		
		ОбщаяСумма = ОбщаяСумма + СтрокаРаспределения.Сумма; 
	КонецЦикла; 
	
	// Заполняем сводные данные, обрабатывается всегда первая найденная строка
	МассивНайденныхСтрок = Объект.Распределение.НайтиСтроки(СтруктураПоиска);
	Попытка
		
		Если МассивНайденныхСтрок[0].Сумма = ОбщаяСумма Тогда
			
			СтатусРаспределения = 1; 
			СтудентТекст = "Распределено"; 
			
		Иначе
			
			СтатусРаспределения = 2; 
			СтудентТекст = "Не распределено"; 
			
		КонецЕсли; 
		
		МассивНайденныхСтрок[0].СтатусРаспределения = СтатусРаспределения;
		МассивНайденныхСтрок[0].СтудентТекст = СтудентТекст;
		
	Исключение
		
		ВызватьИсключение НСтр("ru='Не удалось найти строку по идентификатору (возможно расхождение данных документа)!
											|Рекомендуется перезаполнить документ.'");
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьСтудентовВХранилище(КодСтроки)
	
	ТаблицаПередачи = Объект.РаспределениеОбщихДоговоров.Выгрузить(, "Студент, Факультет, Сумма, СуммаВалюта");
	ТаблицаПередачи.Очистить();
	
	СтруктураОтбора = Новый Структура("КодСтроки", КодСтроки);
	МассивСтрок = Объект.РаспределениеОбщихДоговоров.НайтиСтроки(СтруктураОтбора);
	Для каждого НайденнаяСтрока Из МассивСтрок Цикл
		
		НоваяСтрока = ТаблицаПередачи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока)
		
	КонецЦикла; 
	
	АдресСтудентовВХранилище = ПоместитьВоВременноеХранилище(ТаблицаПередачи.Скопировать(), УникальныйИдентификатор);
	
	Возврат АдресСтудентовВХранилище;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОплатамиСервер()
	
	РаботаСоСтудентами.ЗаполнитьДокументРаспределения(Объект);	
	УстановитьПредупреждение();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
	
	Если Объект.Распределение.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		
	КонецЕсли; 
	
КонецПроцедуры

