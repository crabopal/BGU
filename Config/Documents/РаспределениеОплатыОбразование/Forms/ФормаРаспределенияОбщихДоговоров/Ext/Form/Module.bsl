
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КодСтроки = Параметры.КодСтроки;
	ДатаДокумента = Параметры.ДатаДокумента;
	Организация = Параметры.Организация;
	Факультет = Параметры.Факультет;
	СуммаОплаты = Параметры.СуммаОплаты;
	СуммаОплатыВалюта = Параметры.СуммаОплатыВалюта;
	Контрагент = Параметры.Контрагент;
	ДоговорКонтрагента = Параметры.ДоговорКонтрагента;
	ВалютаВзаиморасчетов = Параметры.ВалютаВзаиморасчетов;
	
	Элементы.СуммаОплаты.Заголовок = "Сумма (" + Строка(ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета()) + ")";
	Элементы.ТаблицаСтудентовСумма.Заголовок = "Сумма (" + Строка(ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета()) + ")";
	
	Если ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() = ВалютаВзаиморасчетов Тогда
		
		Элементы.СуммаОплатыВалюта.Видимость = Ложь;
		Элементы.ТаблицаСтудентовСуммаВалюта.Видимость = Ложь;
		
	Иначе
		
		Элементы.СуммаОплатыВалюта.Заголовок = "Сумма (" + Строка(ВалютаВзаиморасчетов) + ")";
		Элементы.ТаблицаСтудентовСуммаВалюта.Заголовок = "Сумма (" + Строка(ВалютаВзаиморасчетов) + ")";
	
	КонецЕсли; 
	
	Если СуммаОплаты < 0 Тогда
		
		Элементы.ТаблицаСтудентовСумма.МаксимальноеЗначение = 0;
		Элементы.ТаблицаСтудентовСуммаВалюта.МаксимальноеЗначение = 0;
		
	Иначе
		
		Элементы.ТаблицаСтудентовСумма.МинимальноеЗначение = 0;
		Элементы.ТаблицаСтудентовСуммаВалюта.МинимальноеЗначение = 0;
		
	КонецЕсли; 
	
	ЗаполнитьСтудентовИзХранилища();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверитьДублиСтрок(Отказ);	
	
	ШаблонСтудент = НСтр("ru='В строке ""%1"" не указано значение поля ""Студент""'");
	ШаблонСумма = НСтр("ru='В строке ""%1"" не указано значение поля ""Сумма""'");
	НомерСтроки = 1;
	
	Для каждого СтрокаСтудента Из ТаблицаСтудентов Цикл
		
		Если СтрокаСтудента.Студент.Пустая() Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтудент, НомерСтроки);	
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Студент");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);

		КонецЕсли; 
		
		Если СтрокаСтудента.Сумма = 0 Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСумма, НомерСтроки);	
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Сумма");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);

		ИначеЕсли СуммаОплаты > 0 И СтрокаСтудента.Сумма < 0 Тогда
			
			ТекстОшибки = НСтр("ru='Сумма не может быть отрицательной!'");
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Сумма");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);
			
		ИначеЕсли СуммаОплаты < 0 И СтрокаСтудента.Сумма > 0 Тогда
			
			ТекстОшибки = НСтр("ru='Сумма не может быть положительной!'");
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "Сумма");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);
			
		КонецЕсли; 
		
		Если СтрокаСтудента.СуммаВалюта = 0 Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСумма, НомерСтроки);	
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "СуммаВалюта");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);

		ИначеЕсли СуммаОплатыВалюта > 0 И СтрокаСтудента.СуммаВалюта < 0 Тогда
			
			ТекстОшибки = НСтр("ru='Сумма не может быть отрицательной!'");
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "СуммаВалюта");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);
			
		ИначеЕсли СуммаОплатыВалюта < 0 И СтрокаСтудента.СуммаВалюта > 0 Тогда
			
			ТекстОшибки = НСтр("ru='Сумма не может быть положительной!'");
			ПутьРеквизита = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТаблицаСтудентов", НомерСтроки, "СуммаВалюта");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, ПутьРеквизита,, Отказ);
			
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла; 
	
	Если СуммаОплаты <> ТаблицаСтудентов.Итог("Сумма") Тогда
		
		ТекстОшибки = НСтр("ru='Общая сумма (" + Строка(СуммаОплаты) + ") не совпадает с распределенной суммой (" + Строка(ТаблицаСтудентов.Итог("Сумма")) + ")!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "СуммаОплаты",, Отказ);
		
	КонецЕсли; 
	
	Если СуммаОплатыВалюта <> ТаблицаСтудентов.Итог("СуммаВалюта") Тогда
		
		ТекстОшибки = НСтр("ru='Общая сумма (" + Строка(СуммаОплатыВалюта) + ") не совпадает с распределенной суммой (" + Строка(ТаблицаСтудентов.Итог("СуммаВалюта")) + ")!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "СуммаОплатыВалюта",, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ПеренестиВДокумент Тогда
		
		АдресСтудентовВХранилище = ПоместитьСтудентовВХранилище();
		СтруктураЗакрытия = Новый Структура;
		СтруктураЗакрытия.Вставить("АдресСтудентовВХранилище", АдресСтудентовВХранилище);
		СтруктураЗакрытия.Вставить("КодСтроки", КодСтроки);
		ОповеститьОВыборе(СтруктураЗакрытия);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаСтудентов

&НаКлиенте
Процедура ТаблицаСтудентовСтудентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация", Организация);
	Если НЕ Факультет.Пустая() Тогда
		СтруктураОтбора.Вставить("Факультет", Факультет);
	КонецЕсли; 
	
	ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
	ПараметрыФормы.Вставить("ДатаЗначений", ДатаДокумента);
	
	ОткрытьФорму("Справочник.Студенты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСтудентовСуммаПриИзменении(Элемент)
	
	Если СуммаОплаты = СуммаОплатыВалюта Тогда
		
		// Все в рублях -> пересчитываем безусловно.
		// Это важно, если валюты в системе не учитываются, например
		
		ТекущаяСтрока = Элементы.ТаблицаСтудентов.ТекущиеДанные;	
		ТекущаяСтрока.СуммаВалюта = ТекущаяСтрока.Сумма;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСтудентовСуммаВалютаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСтудентов.ТекущиеДанные;
	
	Коэффициент = СуммаОплаты / СуммаОплатыВалюта;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.СуммаВалюта * Коэффициент;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ОчиститьСообщения();
	
	Если ПроверитьЗаполнение() Тогда
		
		ПеренестиВДокумент = Истина;
		Закрыть(КодВозвратаДиалога.OK);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтудентами(Команда)
	
	Отказ = Ложь;
	
	Если ТаблицаСтудентов.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru='Список учащихся будет перезаполнен, продолжить?'");

		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьСтудентамиЗавершение", ЭтаФорма), ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		
		Возврат; 
		
	КонецЕсли; 
	
	ЗаполнитьСтудентамиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтудентамиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли; 
    
    ЗаполнитьСтудентамиСервер();

КонецПроцедуры

&НаКлиенте
Процедура РаспределитьСуммыРавномерно(Команда)
	
	РаспределитьСумму("Сумма", СуммаОплаты);	
	РаспределитьСумму("СуммаВалюта", СуммаОплатыВалюта);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПоместитьСтудентовВХранилище()
	
	АдресСтудентовВХранилище = ПоместитьВоВременноеХранилище(ТаблицаСтудентов.Выгрузить(), УникальныйИдентификатор);
	Возврат АдресСтудентовВХранилище;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтудентовИзХранилища()
	
	ТаблицаСтудентовИзХранилища = ПолучитьИзВременногоХранилища(Параметры.АдресСтудентовВХранилище);
	ТаблицаСтудентов.Загрузить(ТаблицаСтудентовИзХранилища);

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСтудентамиСервер()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СведенияОСтудентахСрезПоследних.Студент КАК Студент,
	               |	СведенияОСтудентахСрезПоследних.Договор КАК Договор,
	               |	МАКСИМУМ(СведенияОСтудентахСрезПоследних.Факультет) КАК Факультет
	               |ПОМЕСТИТЬ ФакультетПоСтудентДоговор
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах.СрезПоследних(&Период, Договор = &ДоговорКонтрагента) КАК СведенияОСтудентахСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СведенияОСтудентахСрезПоследних.Студент,
	               |	СведенияОСтудентахСрезПоследних.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Плательщики.Студент КАК Студент,
	               |	ЕСТЬNULL(ФакультетПоСтудентДоговор.Факультет, НЕОПРЕДЕЛЕНО) КАК Факультет
	               |ИЗ
	               |	РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(&Период, НЕ Студент.ВАрхиве) КАК Плательщики
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ФакультетПоСтудентДоговор КАК ФакультетПоСтудентДоговор
	               |		ПО Плательщики.Студент = ФакультетПоСтудентДоговор.Студент
	               |			И Плательщики.Договор = ФакультетПоСтудентДоговор.Договор
	               |ГДЕ
	               |	Плательщики.Контрагент = &Контрагент
	               |	И Плательщики.Договор = &ДоговорКонтрагента";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Период", ДатаДокумента);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	
	ТаблицаСтудентов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДублиСтрок(Отказ)
	
	ВремТаблицаСтудентов = ТаблицаСтудентов.Выгрузить();
	ОбщегоНазначенияБГУ.ПронумероватьТаблицуЗначений(ВремТаблицаСтудентов, "НомерСтроки");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаСтудентов.НомерСтроки,
	               |	ТаблицаСтудентов.Студент
	               |ПОМЕСТИТЬ ТаблицаСтудентов
	               |ИЗ
	               |	&ТаблицаСтудентов КАК ТаблицаСтудентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ТаблицаСтудентов.НомерСтроки) КАК НомерСтроки,
	               |	ТаблицаСтудентов.Студент
	               |ИЗ
	               |	ТаблицаСтудентов КАК ТаблицаСтудентов
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаСтудентов.Студент
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(*) > 1";
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ТаблицаСтудентов", ВремТаблицаСтудентов);
	ВыборкаДублей = Запрос.Выполнить().Выбрать();
	
	ТекстОшибки = НСтр("ru = 'Студент %1 повторяется в списке'");
	
	Пока ВыборкаДублей.Следующий() Цикл
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ВыборкаДублей.Студент);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,, "ТаблицаСтудентов[" + (ВыборкаДублей.НомерСтроки - 1) + "].Студент",, Отказ);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьСумму(ИмяРеквизита, Сумма)
	
	КоличествоСтрок = ТаблицаСтудентов.Количество();
	
	Если КоличествоСтрок > 0 Тогда
		
		СуммаВСтроку = Окр(Сумма / КоличествоСтрок, 2); 
		
		Для каждого СтрокаСтудента Из ТаблицаСтудентов Цикл
			СтрокаСтудента[ИмяРеквизита] = СуммаВСтроку;
		КонецЦикла; 	
		
		Если Сумма <> ТаблицаСтудентов.Итог(ИмяРеквизита) Тогда
			СтрокаСтудента[ИмяРеквизита] = СтрокаСтудента[ИмяРеквизита] + (Сумма - ТаблицаСтудентов.Итог(ИмяРеквизита));			
		КонецЕсли; 
	
	КонецЕсли; 	
	
КонецПроцедуры

#КонецОбласти


