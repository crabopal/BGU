	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.КадастровыйНомерЗдания КАК КадастровыйНомерЗдания,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.УсловныйНомер КАК УсловныйНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.КоличествоЭтажей КАК КоличествоЭтажей,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.ОбщаяПлощадь КАК ОбщаяПлощадь,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.ОбщийОбъем КАК ОбщийОбъем,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.ПодземныйОбъем КАК ПодземныйОбъем,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.ЭтоПомещение КАК ЭтоПомещение
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.СведенияКадастровогоУчета КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияКадастровогоУчета.Ссылка = &ЭлектронныйАктОПриемеПередаче";
	Запрос.УстановитьПараметр("GUIDИнвентарныхНомеровУОтправителя", GUIDИнвентарныхНомеровУОтправителя);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЭлектронныйАктОПриемеПередаче", ЭлектронныйАктОПриемеПередаче);

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

&НаСервере
Функция ВидимостьЭлементовЭДОАкта448()
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьПризнакИмуществоКазныЕслиЭлектроннымАктомПереданыОС()
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ТекОС = ТекСтрока.ОсновноеСредство;
		Если ЗначениеЗаполнено(ТекОС) Тогда
			СвойстваОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекОС, "ИмуществоКазны");
			Если НЕ СвойстваОС.ИмуществоКазны Тогда
				Попытка
					ТекОСОбъект = ТекОС.ПолучитьОбъект();
					ТекОСОбъект.ИмуществоКазны = Истина;
					ТекОСОбъект.Записать();
				Исключение
					ЗаписьЖурналаРегистрации(
						НСтр("ru = 'Основные средства.Не удалось установить признак имущества казны'", ОбщегоНазначения.КодОсновногоЯзыка()),
						УровеньЖурналаРегистрации.Ошибка,
						ТекОСОбъект.Метаданные(),,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередачеНаСервере()
	
	ИспользуетсяДата = Истина;
	ИспользуетсяКФО = Истина;
	ИспользуетсяКПС = Истина;

	ЗагружатьСведенияОШтрихкодахОбъектовНФА = ЭлектронныеДокументыБГУ.ЗагружатьСведенияОШтрихкодахОбъектовНФА(Объект.Организация);
	ТаблицаШтрихкодовОСАкта = ЭлектронныеДокументыБГУ.ПустаяТаблицаШтрихкодовОСАкта();
	
	Объект.ДрагоценныеМатериалы.Очистить();
	
	ШаблонФормированияИнвНомеров = ПолучитьШаблонИнвНомера(Объект.Организация, Объект.Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
	
	СведенияПоИнвентарнымОбъектамОтправителя = СведенияПоИнвентарнымОбъектамОтправителя(Объект.ДокументОснование);
	
	GUIDИнвентарныеНомераОтправителя = Новый Массив;
	Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
		GUIDИнвентарныеНомераОтправителя.Добавить(ТекСтрока.GUIDИнвентарногоНомераУОтправителя);
	КонецЦикла;
	ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя = 
		ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя(Объект.Организация, GUIDИнвентарныеНомераОтправителя, Объект.ДокументОснование);
		
	ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[0].Выгрузить();
	ОбремененияПоИнвентарнымНомерамОтправителя = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[1].Выгрузить();
	СвязанныеКонтрагенты = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[2].Выгрузить();
	СведенияОСодержанииДрагМатериалов = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[3].Выгрузить();
	СведенияПТС = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[4].Выгрузить();
	СведенияКадастровогоУчета = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[5].Выгрузить();
	СведенияОШтрихкодах = ДанныеЭлектронногоАктаОПриемеПередачеНФАПоИнвентарнымНомерамОтправителя[6].Выгрузить();
		
	ИнвентарныйНомерДата = Объект.Дата;
	ИнвентарныйНомерКФО = Объект.КФО;
	ИФО = Объект.ИФО;
	
	Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
		ТекНФА = Справочники.ОсновныеСредства.ПустаяСсылка();
		ИнвентарныйНомерКПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекСтрока.ИдентификаторСтроки);
		НайденныеСтроки = Объект.ОсновныеСредства.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ТекНФА = НайденныеСтроки[0].ОсновноеСредство;
			ИнвентарныйНомерКПС = НайденныеСтроки[0].КПС;
			СчетУчета = НайденныеСтроки[0].СчетУчетаОС;
		КонецЕсли;

		РеестровыйНомер = ТекСтрока.РеестровыйНомер;
		ЗаводскойНомер = ТекСтрока.ЗаводскойНомер;
		НомерПаспорта = ТекСтрока.НомерПаспорта;
		ИнойНомер = ТекСтрока.ИнойНомер;
		ДатаВыпуска = ТекСтрока.ДатаВыпуска;
		ИнвентарныйНомерУОтправителя = ТекСтрока.ИнвентарныйНомерУОтправителя;
		GUIDИнвентарногоНомераУОтправителя = ТекСтрока.GUIDИнвентарногоНомераУОтправителя;
		
		НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		Если ЗначениеЗаполнено(GUIDИнвентарногоНомераУОтправителя) Тогда
			ПараметрыОтбораИнвНомера = Новый Структура;
			ПараметрыОтбораИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя", GUIDИнвентарногоНомераУОтправителя);
			НайденныеСтрокиИнвНомера = ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Если НайденныеСтрокиИнвНомера.Количество()>0 Тогда
				НовыйИнвНомерСсылка = НайденныеСтрокиИнвНомера[0].Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НовыйИнвНомерСсылка) Тогда
			
			ПараметрыИнвНомера = Новый Структура;
			ПараметрыИнвНомера.Вставить("Дата"				, ИнвентарныйНомерДата);
			ПараметрыИнвНомера.Вставить("КФО"				, ИнвентарныйНомерКФО);
			ПараметрыИнвНомера.Вставить("КПС"				, ИнвентарныйНомерКПС);
			ПараметрыИнвНомера.Вставить("СчетУчета"			, СчетУчета);
			ПараметрыИнвНомера.Вставить("ИФО"				, ИФО);
			ПараметрыИнвНомера.Вставить("ОсновноеСредство"	, ТекНФА);
			
			ПараметрыИнвНомера.Вставить("ИнвентарныйНомерУОтправителя"	, ИнвентарныйНомерУОтправителя);
			ПараметрыИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя"	, GUIDИнвентарногоНомераУОтправителя);
			
			ПараметрыИнвНомера.Вставить("РеестровыйНомер"	, РеестровыйНомер);
			ПараметрыИнвНомера.Вставить("ЗаводскойНомер"	, ЗаводскойНомер);
			ПараметрыИнвНомера.Вставить("НомерПаспорта"	, НомерПаспорта);
			ПараметрыИнвНомера.Вставить("ИнойНомер"	, ИнойНомер);
			ПараметрыИнвНомера.Вставить("ДатаВыпуска"	, ДатаВыпуска);
			
			Отказ = Ложь;
			
			//Обременения по инвентарному номеру
			НайденныеСтрокиОбременений = ОбремененияПоИнвентарнымНомерамОтправителя.НайтиСтроки(ПараметрыОтбораИнвНомера);
			
			НовыйИнвНомерСсылка = СоздатьНовыйИнвентарныйНомер(Объект.Организация, ТекНФА, ПараметрыИнвНомера, ШаблонФормированияИнвНомеров, НайденныеСтрокиОбременений, СвязанныеКонтрагенты, Отказ);
		КонецЕсли;	

		НайденныеСтроки[0].ИнвентарныйНомер = НовыйИнвНомерСсылка;
		
		//Заполнение сведений о содержании драгоценных материалов
		НайденныеСтрокиИнвНомераДМ = СведенияОСодержанииДрагМатериалов.НайтиСтроки(ПараметрыОтбораИнвНомера);
		Для Каждого ТекДрагМатериал Из НайденныеСтрокиИнвНомераДМ Цикл
			НоваяСтрокаДМ = Объект.ДрагоценныеМатериалы.Добавить();
			
			ВидДрагМатериала = ЭлектронныеДокументыБГУ.ВидДрагМатериала(ТекДрагМатериал.КодВидаДрагоценногоМатериала, ТекДрагМатериал.ПолноеНаимВидаДрагоценногоМатериала);
			ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекДрагМатериал.ЕдИзмКод);
			
			НоваяСтрокаДМ.ОбъектНФА = ТекНФА;
			НоваяСтрокаДМ.ИнвНомер = НовыйИнвНомерСсылка;
			НоваяСтрокаДМ.ВидДрагМатериала = ВидДрагМатериала;
			НоваяСтрокаДМ.МассаДМ = ТекДрагМатериал.МассаДМ;
			НоваяСтрокаДМ.КоличествоДМ = ТекДрагМатериал.КоличествоДМ;
			НоваяСтрокаДМ.ЕдИзм = ЕдИзм;
		КонецЦикла;
		
		//Заполнение сведений ПТС
		НайденныеСтрокиИнвНомераПТС = СведенияПТС.НайтиСтроки(ПараметрыОтбораИнвНомера);
		Для Каждого ТекДанныеПТС Из НайденныеСтрокиИнвНомераПТС Цикл
			НаборЗаписей = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
			НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
			НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Объект.Организация;
				НоваяЗапись.ОсновноеСредство = ТекНФА;
				НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеПТС);
				НоваяЗапись.ДвигательМодель = ТекДанныеПТС.МодельДвигателя;
				НоваяЗапись.ДвигательНомер = ТекДанныеПТС.НомерДвигателя;
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;	
		КонецЦикла;

		//Заполнение сведений кадастрового учета
		НайденныеСтрокиИнвНомераКадастра = СведенияКадастровогоУчета.НайтиСтроки(ПараметрыОтбораИнвНомера);
		Для Каждого ТекДанныеКадастра Из НайденныеСтрокиИнвНомераКадастра Цикл
			НаборЗаписей = РегистрыСведений.СведенияКадастровогоУчета.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
			НаборЗаписей.Отбор.ОсновноеСредство.Установить(ТекНФА);
			НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(НовыйИнвНомерСсылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Объект.Организация;
				НоваяЗапись.ОсновноеСредство = ТекНФА;
				НоваяЗапись.ИнвентарныйНомер = НовыйИнвНомерСсылка;
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанныеКадастра);
				НоваяЗапись.КадастровыйНомерЗемлиНедвижимости = ТекДанныеКадастра.КадастровыйНомерЗемли;
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;

	//Загрузка сведений о штрихкодах
	Если ЗагружатьСведенияОШтрихкодахОбъектовНФА Тогда
		Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			ОбъектНФА = ТекСтрока.ОсновноеСредство;
			ИнвНомер = ТекСтрока.ИнвентарныйНомер;
			GUIDНоменклатурыОтправителя = "";
			GUIDИнвентарногоНомераУОтправителя = "";
			Если ЗначениеЗаполнено(ОбъектНФА) Тогда
				РеквизитыНФА = "GUIDНоменклатурыОтправителя";
				ЗначенияРеквизитовНФА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектНФА, РеквизитыНФА);
				GUIDНоменклатурыОтправителя = ЗначенияРеквизитовНФА.GUIDНоменклатурыОтправителя;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ИнвНомер) Тогда
				РеквизитыИнвНомер = "GUIDИнвентарногоНомераУОтправителя";
				ЗначенияРеквизитовИнвНомер = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнвНомер, РеквизитыИнвНомер);
				GUIDИнвентарногоНомераУОтправителя = ЗначенияРеквизитовИнвНомер.GUIDИнвентарногоНомераУОтправителя;
			КонецЕсли;
			Если ЗначениеЗаполнено(GUIDНоменклатурыОтправителя) И ЗначениеЗаполнено(GUIDИнвентарногоНомераУОтправителя) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("GUIDНоменклатурыУОтправителя", GUIDНоменклатурыОтправителя);
				ПараметрыОтбора.Вставить("GUIDИнвентарногоНомераУОтправителя", GUIDИнвентарногоНомераУОтправителя);
				НайденныеСтроки = СведенияОШтрихкодах.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					Для Каждого ТекСведенияШК Из НайденныеСтроки Цикл
						НоваяСтрока = ТаблицаШтрихкодовОСАкта.Добавить();
						НоваяСтрока.ОбъектНФА = ТекСтрока.ОсновноеСредство;
						НоваяСтрока.ИнвНомер = ТекСтрока.ИнвентарныйНомер;
						НоваяСтрока.GUIDНоменклатуры = GUIDНоменклатурыОтправителя;
						НоваяСтрока.GUIDИнвентарногоНомера = GUIDИнвентарногоНомераУОтправителя;
						НоваяСтрока.НаименованиеТипаШтрихкода = ТекСведенияШК.НаименованиеТипаШтрихкода;
						НоваяСтрока.ЗначениеШтрихкода = ТекСведенияШК.ЗначениеШтрихкода;
					КонецЦикла;	
				КонецЕсли;	
			ИначеЕсли ЗначениеЗаполнено(GUIDНоменклатурыОтправителя) И НЕ ЗначениеЗаполнено(GUIDИнвентарногоНомераУОтправителя) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("GUIDНоменклатурыУОтправителя", GUIDНоменклатурыОтправителя);
				НайденныеСтроки = СведенияОШтрихкодах.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					Для Каждого ТекСведенияШК Из НайденныеСтроки Цикл
						НоваяСтрока = ТаблицаШтрихкодовОСАкта.Добавить();
						НоваяСтрока.ОбъектНФА = ТекСтрока.ОсновноеСредство;
						НоваяСтрока.ИнвНомер = ТекСтрока.ИнвентарныйНомер;
						НоваяСтрока.GUIDНоменклатуры = GUIDНоменклатурыОтправителя;
						НоваяСтрока.GUIDИнвентарногоНомера = "";
						НоваяСтрока.НаименованиеТипаШтрихкода = ТекСведенияШК.НаименованиеТипаШтрихкода;
						НоваяСтрока.ЗначениеШтрихкода = ТекСведенияШК.ЗначениеШтрихкода;
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого ТекСтрока Из ТаблицаШтрихкодовОСАкта Цикл
			Штрихкод = ТекСтрока.ЗначениеШтрихкода;
			Если ЗначениеЗаполнено(Штрихкод) Тогда
				ДанныеШКОС = РегистрыСведений.Штрихкоды.НайтиОбъектПоШтрихкоду(Штрихкод);
				Если ЗначениеЗаполнено(ДанныеШКОС.ОсновноеСредство) Тогда
					Если НЕ (ТекСтрока.ОбъектНФА = ДанныеШКОС.ОсновноеСредство) И НЕ (ТекСтрока.ИнвНомер = ДанныеШКОС.ИнвентарныйНомер) Тогда
						ШаблонСообщения = НСтр("ru = 'Штрихкод ""%1"" для ""%2"" (инв. № %3) уже есть в базе для ""%4"" (инв. № %5).'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
							Штрихкод, ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер, ДанныеШКОС.ОсновноеСредство, ДанныеШКОС.ИнвентарныйНомер);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					КонецЕсли;	
				Иначе
					ТекстСообщения = "";
					ЭлектронныеДокументыБГУ.ЗаписатьНовыйШтрихкодОС(ТекСтрока, Объект.Ссылка, ТекстСообщения);
					Если ЗначениеЗаполнено(ТекстСообщения) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	

	УстановитьПризнакИмуществоКазныЕслиЭлектроннымАктомПереданыОС();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьШаблонИнвНомера(Организация, Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС)
	
	НаДату = ?(ЗначениеЗаполнено(Дата), Дата, Неопределено);
	Шаблон = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, НаДату).ШаблонИнвентарныхНомеров;
	
	УстановитьПризнакиИспользованияПараметровШаблона(Шаблон, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
	
	Возврат Шаблон;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьПризнакиИспользованияПараметровШаблона(Шаблон, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС)
	
	Если ЗначениеЗаполнено(Шаблон) Тогда
		
		ИспользуемыеРеквизиты = Новый Массив;
		Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(Шаблон.ВидШаблона, Шаблон.СоставШаблона.Выгрузить());
		Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула, ИспользуемыеРеквизиты);
		
		ИспользуетсяДата	= (ИспользуемыеРеквизиты.Найти("ДАТА")	<> Неопределено);
		ИспользуетсяКФО		= (ИспользуемыеРеквизиты.Найти("КФО")	<> Неопределено);
		ИспользуетсяКПС		= (ИспользуемыеРеквизиты.Найти("КПС")	<> Неопределено);
		
	Иначе
		
		ИспользуетсяДата	= Ложь;
		ИспользуетсяКФО		= Ложь;
		ИспользуетсяКПС		= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьНовыйИнвентарныйНомер(Организация, НоваяСсылка, ДанныеИнвентарногоНомера, ШаблонФормированияИнвНомеров, НайденныеСтрокиОбременений, СвязанныеКонтрагенты, Отказ)

	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ШаблонФормированияИнвНомеров) Тогда
		Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(ШаблонФормированияИнвНомеров.ВидШаблона,
			ШаблонФормированияИнвНомеров.СоставШаблона.Выгрузить());
		Формула = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула);
		Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(Формула, ДанныеИнвентарногоНомера);
		
		ДанныеИнвентарногоНомера.Вставить("Префикс"				, Префикс);
		ДанныеИнвентарногоНомера.Вставить("ДлинаНомера"			, ШаблонФормированияИнвНомеров.ДлинаНомера);
		ДанныеИнвентарногоНомера.Вставить("БезУчетаПрефикса"	, ШаблонФормированияИнвНомеров.БезУчетаПрефикса);
		
		ПоследнийНомер = Справочники.ИнвентарныеНомераОС.ПоследнийНомер(Организация, ДанныеИнвентарногоНомера);
	Иначе
		Префикс = "";
		ДанныеИнвентарногоНомера.Вставить("Префикс"				, Префикс);
		ПоследнийНомер = Справочники.ИнвентарныеНомераОС.ПоследнийНомер(Организация, );
		ДлинаНомера = СтрДлина(ПоследнийНомер);
		ДанныеИнвентарногоНомера.Вставить("ДлинаНомера"			, ДлинаНомера);
		ДанныеИнвентарногоНомера.Вставить("БезУчетаПрефикса"	, Истина);
		
		Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ПоследнийНомер) Тогда
			ДлинаПоследнегоНомера = СтрДлина(ПоследнийНомер);
			Для н = 1 По ДлинаПоследнегоНомера Цикл
				ВременныйПоследнийНомер = Прав(ПоследнийНомер, н);
				Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ВременныйПоследнийНомер) Тогда
					Префикс = Лев(ПоследнийНомер, ДлинаПоследнегоНомера - н + 1);
					ПоследнийНомер = Прав(ПоследнийНомер, н - 1);
					ДанныеИнвентарногоНомера.БезУчетаПрефикса = Ложь;
					ДанныеИнвентарногоНомера.Префикс = Префикс;
					ДанныеИнвентарногоНомера.ДлинаНомера = СтрДлина(ПоследнийНомер);
					
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
		
	КонецЕсли;
	ПорядковыйНомер = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0) + 1;
	
	ДанныеИнвентарногоНомера.Вставить("ПорядковыйНомер", ПорядковыйНомер);

	ИнвНомерКод = ДанныеИнвентарногоНомера.Префикс + Формат(
		ДанныеИнвентарногоНомера.ПорядковыйНомер, "ЧВН=; ЧГ=; ЧЦ=" + ДанныеИнвентарногоНомера.ДлинаНомера);
		
	НовыйОбъектИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();
	НовыйОбъектИнвНомер.Владелец		= Организация;
	НовыйОбъектИнвНомер.ОС				= НоваяСсылка;
	НовыйОбъектИнвНомер.Код				= ИнвНомерКод;
	НовыйОбъектИнвНомер.ЗаводскойНомер	= ДанныеИнвентарногоНомера.ЗаводскойНомер;
	НовыйОбъектИнвНомер.РеестровыйНомер	= ДанныеИнвентарногоНомера.РеестровыйНомер;
	НовыйОбъектИнвНомер.НомерПаспорта	= ДанныеИнвентарногоНомера.НомерПаспорта;
	НовыйОбъектИнвНомер.ИнойНомер	= ДанныеИнвентарногоНомера.ИнойНомер;
	НовыйОбъектИнвНомер.ДатаВыпуска	= ДанныеИнвентарногоНомера.ДатаВыпуска;
	НовыйОбъектИнвНомер.ИнвентарныйНомерУОтправителя = ДанныеИнвентарногоНомера.ИнвентарныйНомерУОтправителя;
	НовыйОбъектИнвНомер.GUIDИнвентарногоНомераУОтправителя = ДанныеИнвентарногоНомера.GUIDИнвентарногоНомераУОтправителя;
	
	Для Каждого ТекСтрока Из НайденныеСтрокиОбременений Цикл
		КонтрагентОбременения = Справочники.Контрагенты.ПустаяСсылка();
		
		НоваяСтрокаОбременения = НовыйОбъектИнвНомер.Обременения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОбременения, ТекСтрока);

		ПараметрыОтбораКонтрагента = Новый Структура;
		ПараметрыОтбораКонтрагента.Вставить("GUIDКонтрагента", ТекСтрока.GUIDКонтрагента);
		НайденныеСтрокиКонтрагента = СвязанныеКонтрагенты.НайтиСтроки(ПараметрыОтбораКонтрагента);
		Если НайденныеСтрокиКонтрагента.Количество()>0 Тогда
			ДанныеКонтрагентаИНН = НайденныеСтрокиКонтрагента[0].ИНН;
			ДанныеКонтрагентаКПП = НайденныеСтрокиКонтрагента[0].КПП;
			ПолноеНаименование = НайденныеСтрокиКонтрагента[0].НаименованиеКонтрагента;
			
			ЭлектронныеДокументыБГУ.СсылкаНаОбъектПоИННКПП("Контрагенты", ДанныеКонтрагентаИНН, ДанныеКонтрагентаКПП, КонтрагентОбременения);
			Если НЕ ЗначениеЗаполнено(КонтрагентОбременения) Тогда
				//Создание нового контрагента
				ИНН = ДанныеКонтрагентаИНН;
				КПП = ДанныеКонтрагентаКПП;
				РеквизитыКонтрагента = Новый Структура;
				РеквизитыКонтрагента.Вставить("ИНН", ИНН);
				РеквизитыКонтрагента.Вставить("КПП", КПП);
				РеквизитыКонтрагента.Вставить("Наименование", ПолноеНаименование);
				
				Если СтрДлина(ИНН) = 12 Тогда
					НаименованиеБезИП = ПолноеНаименование;
					Если Лев(ПолноеНаименование, 2) = "ИП" Тогда
						НаименованиеБезИП = Сред(ПолноеНаименование, 3);
					Иначе
						ПризнакИП = "Индивидуальный предприниматель";
						ПозИП = СтрНайти(ПолноеНаименование, ПризнакИП);
						Если ПозИП > 0 Тогда
							НаименованиеБезИП = Сред(ПолноеНаименование, СтрДлина(ПризнакИП)+1);
						КонецЕсли;
					КонецЕсли;
					ФИОПоОтдельности = ЭлектронныеДокументыБГУ.ФИОПоОтдельности(НаименованиеБезИП);
					РеквизитыКонтрагента.Вставить("Фамилия", ФИОПоОтдельности.Фамилия);
					РеквизитыКонтрагента.Вставить("Имя", ФИОПоОтдельности.Имя);
					РеквизитыКонтрагента.Вставить("Отчество", ФИОПоОтдельности.Отчество);
				КонецЕсли;	
				
				ЭлектронныеДокументыБГУ.СоздатьКонтрагентаПоРеквизитам(РеквизитыКонтрагента, КонтрагентОбременения);
				
			КонецЕсли;	
		КонецЕсли;
		
		НоваяСтрокаОбременения.Контрагент = КонтрагентОбременения;
	КонецЦикла;	
	
	ЗаписатьОбъект(НовыйОбъектИнвНомер, Отказ);
	
	Возврат НовыйОбъектИнвНомер.Ссылка;
	
КонецФункции	

&НаСервере
Процедура ЗаписатьОбъект(ЗаписываемыйОбъект, Отказ)
	
	Попытка
		ЗаписываемыйОбъект.Записать();
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке();
		
		ОтменитьТранзакцию();
		
		МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ЗаписываемыйОбъект)));
		
		ЗаписьЖурналаРегистрации("Групповое создание инвентарных номеров по данным акта о приеме-передаче НФА.Запись",
								УровеньЖурналаРегистрации.Ошибка,
								МетаданныеОбъекта,
								,
								ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ОписаниеОшибки));
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция СведенияПоИнвентарнымОбъектамОтправителя(ДокументАктОПриемеПередаче)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.НФА КАК НФА,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.ИнвентарныйНомерУОтправителя КАК ИнвентарныйНомерУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.GUIDНоменклатурыУОтправителя КАК GUIDНоменклатурыУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.РеестровыйНомер КАК РеестровыйНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.ЗаводскойНомер КАК ЗаводскойНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.НомерПаспорта КАК НомерПаспорта,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.ИнойНомер КАК ИнойНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.ДатаВыпуска КАК ДатаВыпуска,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПереданныеНФА КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.СведенияОбОбъектахНФА КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА
	               |		ПО ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.GUIDНоменклатурыУОтправителя = ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.GUIDНоменклатурыУОтправителя
	               |			И ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.ИнвентарныйНомерУОтправителя = ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.ИнвентарныйНомерУОтправителя
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.Ссылка = &Ссылка
	               |	И ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеНФА.ЕстьИнвентарныйНомерУОтправителя = ИСТИНА
	               |	И ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСведенияОбОбъектахНФА.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументАктОПриемеПередаче);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений = "")
	ЭлектронныеДокументыБГУ.ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, ТекстСведений);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСведенийЭлектронногоАктаОПриемеПередаче(ДанныеДляАкта)
	КоличествоФайлов = ДанныеДляАкта.КоличествоФайлов;
	
	ТекстСведений = ЭлектронныеДокументыБГУКлиент.ТекстПриложеноФайлов(КоличествоФайлов);

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений);
КонецПроцедуры	

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();
КонецФункции

&НаКлиенте
Процедура НадписьДопСведенияЭлектронногоАктаПоФорме0510448Нажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Параметры.Ключ.Пустая() Тогда
		ТекстОшибки = НСтр("ru='Необходимо записать документ для заполнение сведений электронного акта о приеме-передаче НФА.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыДопСведений = НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();
	
	ПараметрыДопСведений.Ссылка = Объект.Ссылка;
	ПараметрыДопСведений.ДатаСведений = Объект.Дата;
	ПараметрыДопСведений.Организация = Объект.Организация;
	
	ЭлектронныеДокументыБГУКлиент.ОткрытьФормуДопСведенийДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, Объект, ПараметрыДопСведений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи()

	УправлениеНФА.ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи(Объект, ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииВидПоступления(Форма)
	Объект = Форма.Объект;
	ЭтоПоступлениеИзПользования = 
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
	Если НЕ ЭтоПоступлениеИзПользования И Объект.ПередачаЧастейОбъектов Тогда
		Объект.ПередачаЧастейОбъектов = Ложь;
	КонецЕсли;	
	
	УстановитьВидимостьЭлементов(Форма);
	УстановитьОтборСчетаУчетаОС(Форма);
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении_Завершение(Результат, Параметры) Экспорт                     
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	ВвестиНаОсновании_ИнвентаризационнаяОписьНФА(Объект.ДокументОснование, Результат, СсылкаЦелевогоДокумента);

    ПриИзмененииВидПоступления(ЭтотОбъект);
	ЗаполнитьМЦВнеоборотногоАктиваСДрагМатериалами(Истина);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
КонецПроцедуры	

&НаСервере
Процедура ВвестиНаОсновании_ИнвентаризационнаяОписьНФА(ДокОснование, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.ПринятиеКУчетуОбъектовИК"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокОснование, Разделитель, Истина, СсылкаЦелевогоДокумента);
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьСоздатьИнвентарнуюКарточку(Форма)
	
	Возврат(НЕ УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Форма.Объект.ВидПоступления));
	
