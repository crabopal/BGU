&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьВидНФАВложений(Неопределено);
	
	ЭтоПриобретениеИлиИзготовлениеИК =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	ВедетсяУчетДрагМатериаловВКапвожениях = 
			УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() ИЛИ (Объект.МЦСДрагоценнымиМатериалами.Количество() > 0 И ЭтоПриобретениеИлиИзготовлениеИК);	
	
	ВалютаРубли = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	ПервыйПределОС = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПределыОС().ПервыйПределОС;
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтотОбъект);
	
	УстановитьВидимостьСуммВВалюте(ЭтаФорма);
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	ОпределитьНаличиеДоговораВложения();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ЦМО");
	СвязанныеРеквизиты.Добавить("ПодразделениеОтправитель");
	СвязанныеРеквизиты.Добавить("ЦМООтправитель");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыФормы()
	
	// Добавленные колонки таблицы ОС.
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство"),
		"ВидНФА,ТипНФА,ГрупповойУчет");
	
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ЗначенияРеквизитовОС = ЗначенияРеквизитов[ТекущаяСтрока.ОсновноеСредство];
		Если ЗначенияРеквизитовОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ЗначенияРеквизитовОС, "ВидНФА,ТипНФА,ГрупповойУчет");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	ПредставлениеВалюты = Строка(Объект.ВалютаПоступления);
	
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока, ПредставлениеВалюты);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока, ПредставлениеВалюты = "")
	
	ТекущаяСтрока.ЗаголовокСумма = НСтр("ru = 'Сумма (руб):'");
	ТекущаяСтрока.ЗаголовокСуммаВВалюте = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сумма (%1):'"), ПредставлениеВалюты);
	
	ТекущаяСтрока.ЗаголовокСуммаАмортизации = НСтр("ru = 'сумма амортизации:'");
	ТекущаяСтрока.ЗаголовокСуммаОбесценения = НСтр("ru = 'сумма обесценения:'");
	ТекущаяСтрока.ЗаголовокДатаВводаВЭксплуатацию = НСтр("ru = 'дата ввода в эскпл.:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокПолезногоИспользования = НСтр("ru = 'оставшийся срок исп.:'");
	
	ТекущаяСтрока.ЗаголовокВидГТ = НСтр("ru = 'вид документа:'");
	ТекущаяСтрока.ЗаголовокНомерДатаГТ = НСтр("ru = 'номер / дата / срок действия:'");
	
	ТекущаяСтрока.НадписьСоздатьИнвКарточку = НСтр("ru = 'создать'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(Форма, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(Форма, ТекущаяСтрока)
	
	ПогашениеСтоимостиБУ = НСтр("ru = '<...>'");
	Если ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Стоимость не погашается'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Списание при вводе в эксплуатацию'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Если ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = '100% амортизации при вводе в эксплуатацию'");
		Иначе
			ПогашениеСтоимостиБУ = НСтр("ru = '<...>'");
		КонецЕсли;
	КонецЕсли;
	
	ШаблонСтроки = НСтр("ru = '%1'");
		
	ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, ПогашениеСтоимостиБУ);
		
	
	ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма, Неопределено, Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект		= Форма.Объект;
	Элементы	= Форма.Элементы;
	
	ЭлементыВалютногоУчета = Новый Массив;
	ЭлементыВалютногоУчета.Добавить("ОсновныеСредстваИтогСуммаВВалюте");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		ЭлементыВалютногоУчета, "Видимость", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
		
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
		
	ЭтоПоступлениеИзПользования = 
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
	
	Элементы.СтраницаКапитальныеВложения.Видимость = ЭтоПриобретениеИлиИзготовление;
	
	// видимость и настройка параметров амортизации доступна только для поступивших или изготовленных объектов
	ДоступнаВидимостьПараметровАмортизации = ДоступнаВидимостьПараметровАмортизации(Форма);
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваПорядокПогашенияСтоимости");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСпособНачисленияАмортизации");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваНачислятьАмортизацию");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСчетУчетаЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваКЭКЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваКПСЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваПодразделениеЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат1");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат2");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат3");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСрокПолезногоИспользования");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваОтражениеВУчете");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ДоступнаВидимостьПараметровАмортизации);
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("ОсновныеСредстваОтражениеВУчетеЕстьОшибка");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", ДоступнаВидимостьПараметровАмортизации 
		И НЕ Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПоступлениеЗабаланс"));
	
	ВозможнаПереданнаяАмортизация = ДоступнаВидимостьПереданнойАмортизации(Форма);
	ЭлементыПереданнойАмортизации = Новый Массив;
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваСуммаАмортизации");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокСуммаАмортизации");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокСуммаОбесценения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПереданнойАмортизации, "Видимость", ВозможнаПереданнаяАмортизация);
	
	ВозможнаДатаВводаВЭксплуатацию = ДоступнаВидимостьДатаВводаВэксплуатацию(Форма);
	ЭлементыПереданнойАмортизации = Новый Массив;
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваДатаВводаВЭксплуатацию");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваОставшийсяСрокПолезногоИспользования");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокДатаВводаВЭксплуатацию");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокОставшийсяСрокПолезногоИспользования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПереданнойАмортизации, "Видимость", ВозможнаДатаВводаВЭксплуатацию);
	
	ДоступнаИнвКарточка = ДоступнаВидимостьСоздатьИнвентарнуюКарточку(Форма);
	ЭлементыИнвКарточки = Новый Массив;
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваСоздатьИнвентарнуюКарточку");
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваНадписьСоздатьИнвКарточку");
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваНомерИнвентарнойКарточки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнвКарточки, "Видимость", ДоступнаИнвКарточка);
	
	ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма);
	
	ВестиАналитическийИИнвентарныйУчет = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	ЭлементыИнвентарногоУчета = Новый Массив;
	ЭлементыИнвентарногоУчета.Добавить("ОсновныеСредстваИнвентарныйНомер");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнвентарногоУчета, "Видимость", ВестиАналитическийИИнвентарныйУчет);
	
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("Количество");
	ТекЭлементы.Добавить("ОсновныеСредстваКоличество");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ Объект.ПоступлениеБиблиотечногоФонда И НЕ Объект.ПередачаЧастейОбъектов);
		
	ВОсВнутреннимПеремещением = Новый Массив;
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратУправление"));
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда"));
	ВОсВнутреннимПеремещением.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование"));
	ВидимостьЦМООтправитель = 
		(ВОсВнутреннимПеремещением.Найти(Объект.ВидПоступления) <> Неопределено); 
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ГруппаКнопокЗаполнитьОтправителя");
	ИменаЭлементов.Добавить("ГруппаЦМООтправитель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьЦМООтправитель И НЕ Объект.ПередачаЧастейОбъектов);            
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ПередачаЧастейОбъектов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьЦМООтправитель);            
	
	Элементы.Контрагент.АвтоотметкаНезаполненного = ЭтоПоступлениеИзПользования;
	Элементы.Контрагент.ОтметкаНезаполненного = ЭтоПоступлениеИзПользования;

	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ОсновныеСредстваГТ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		МассивЭлементов, "Видимость", ВозможныГарантийныеОбязательства(Объект.ВидПоступления));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаСписанияМЦСДрагМатериалами", "Видимость", (ЭтоПриобретениеИлиИзготовление 
								И Форма.ВедетсяУчетДрагМатериаловВКапвожениях));							
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыЗаполнитьСписокДМДляСписания", "Видимость", ЭтоПриобретениеИлиИзготовление 
								И Форма.ВедетсяУчетДрагМатериаловВКапвожениях);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "АналитикаОперацииСДрагМатериалами", "Видимость", Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление"));					
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСуммВВалюте(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьСуммВВалюте = Форма.КэшПараметров.ИспользоватьВалютныйУчет И Объект.ВалютаПоступления <> Форма.ВалютаРубли;
	
	ЭлементыСуммВВалюте = Новый Массив;
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваЗаголовокСуммаВВалюте");
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваСуммаВВалюте");
	ЭлементыСуммВВалюте.Добавить("ВалютаРубли");
	
	// Заголовок строки для суммы в рублях тоже нет смысла показывать, если документ в рублях.
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваЗаголовокСумма");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыСуммВВалюте, "Видимость", ВидимостьСуммВВалюте);
	
	Элементы.ОсновныеСредстваИтогСуммаВВалюте.Видимость = ВидимостьСуммВВалюте;
	Элементы.ВалютаПоступления1.Видимость = ВидимостьСуммВВалюте;
	
КонецПроцедуры

// Капитальные вложения

&НаКлиенте
Процедура СчетКредитаПриИзменении(Элемент)
	
	ПервоначальнаяСтоимостьЕдиницы = 0;
	Объект.КапитальныеВложения.Очистить();
	
	ОпределитьНаличиеДоговораВложения();
	
	Если ЗначениеЗаполнено(Объект.СчетВложений)
		И ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма) Тогда
		РассчитатьСуммуВложенийНаСервере();
	КонецЕсли;
	
КонецПроцедуры


// Основные средства

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуИзДругойСтроки(Получатель, Источник)
	
	ЗаполнитьЗначенияСвойств(Получатель, Источник,
		"Сумма," +
		"СчетУчетаОС,КПС,СрокПолезногоИспользования,ПорядокПогашенияСтоимости," +
		"СпособНачисленияАмортизации,НачислятьАмортизацию,СчетУчетаЗатрат," +
		"КПСЗатрат,КЭКЗатрат,ПодразделениеЗатрат,СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3," +
		"СуммаВВалюте,ОтражениеВУчетеБУЗаполненоНекорректно,ОтражениеВУчете,"+
		"НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку,"+
		"ОтражениеВУчетеЕстьОшибка,ОтражениеВУчетеБУЗаполненоНекорректно,"+
		"НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку," +
		"НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете()
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = "ПорядокПогашенияСтоимости"
		+ ",СпособНачисленияАмортизации"
		+ ",СрокПолезногоИспользования"
		+ ",НачислятьАмортизацию"
		+ ",СчетУчетаЗатрат"
		+ ",КЭКЗатрат"
		+ ",КПСЗатрат"
		+ ",ПодразделениеЗатрат"
		+ ",СубконтоЗатрат1"
		+ ",СубконтоЗатрат2"
		+ ",СубконтоЗатрат3";
	
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыТекущейСтроки = Новый Структура;
	ПараметрыТекущейСтроки.Вставить("ОтражатьВНалоговомУчете", Ложь);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыТекущейСтроки.Вставить("СписокРеквизитовСтрокиДокумента", ИменаРеквизитов);
	ПараметрыТекущейСтроки.Вставить("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
	ПараметрыТекущейСтроки.Вставить("ИнвентарныйНомер", ТекущиеДанные.ИнвентарныйНомер);
	ПараметрыТекущейСтроки.Вставить("ПараметрыСтроки", ДанныеТекущейСтроки);
	ПараметрыТекущейСтроки.Вставить("ИспользоватьУчетПоПодразделениям", ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям);
	ПараметрыТекущейСтроки.Вставить("Дата", Объект.Дата);
	ПараметрыТекущейСтроки.Вставить("Организация", Объект.Организация);
	ПараметрыТекущейСтроки.Вставить("ИФО", Объект.ИФО);
	ПараметрыТекущейСтроки.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат",
		ПроверятьЗаполнениеСчетаУчетаЗатрат(Объект.ВидПоступления));
	ПараметрыТекущейСтроки.Вставить("ИмуществоКазны", Истина);
	
	ОткрытьФорму("Документ.ПринятиеКУчетуОбъектовОС.Форма.ФормаНастройкаОтраженияВУчете",
		ПараметрыТекущейСтроки,
		ЭтотОбъект,,,,Новый ОписаниеОповещения("ОкончаниеНастройкиОтраженияВУчете", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеНастройкиОтраженияВУчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		ВыделенныеСтроки = Элементы.ОсновныеСредства.ВыделенныеСтроки;
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если ТекущиеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
				УстановитьОставшийсяСрокИспользования(ТекущиеДанные);
			КонецЕсли;
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
			УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные, ВыделенныеСтроки);
			
		КонецЦикла;
		
		//УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные);
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные, ВыделенныеСтроки = Неопределено)
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		
		// При большом количестве строк в табличной части, это сильно уменьшает количество итераций.
		// Производительность значительно увеличивается.
		Если ВыделенныеСтроки <> Неопределено Тогда
			Если ВыделенныеСтроки.Найти(ТекСтрока.ПолучитьИдентификатор()) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если ТекСтрока <> ТекущиеДанные
			И ТекСтрока.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство И ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
			
			ЗаполнитьСтрокуИзДругойСтроки(ТекСтрока, ТекущиеДанные);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьОтражениеВУчетеИзРанееВведеннойСтроки(ТекущиеДанные)
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
		Если СтрокаДокумента <> ТекущиеДанные Тогда
			Если СтрокаДокумента.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство Тогда
				ЗаполнитьСтрокуИзДругойСтроки(ТекущиеДанные, СтрокаДокумента);
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УстановитьОставшийсяСрокИспользования(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОставшийсяСрокИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			ТекущиеДанные.ДатаВводаВЭксплуатацию,
			ТекущиеДанные.СрокПолезногоИспользования,
			Объект.Дата);
	
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования = 
		?(ОставшийсяСрокИспользования < 0, 0, ОставшийсяСрокИспользования);

//	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования = ОставшийсяСрокИспользования;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДаты()
	
	ЗаданаДатаВводаВЭксплуатацию = Ложь;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаВводаВЭксплуатацию) Тогда
			ЗаданаДатаВводаВЭксплуатацию = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗаданаДатаВводаВЭксплуатацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'В некоторых строках документа указана ""Дата ввода в эксплуатацию"".
		|После изменения даты рекомендуется пересчитать оставшийся срок полезного использования
		|в строках документа.
		|Пересчитать оставшийся срок полезного использования?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПересчитатьОстСрокИспПриИзмененииДатыЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			УстановитьОставшийсяСрокИспользования(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущаяСтрока)
	
	Объект = Форма.Объект;
	
	Если Форма.КэшПараметров.ИспользоватьВалютныйУчет И Объект.ВалютаПоступления <> Форма.ВалютаРубли Тогда
		
		ТекущаяСтрока.СуммаВВалюте = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			ТекущаяСтрока.Сумма,
			Новый Структура("Валюта, Курс, Кратность",
				Форма.ВалютаРубли, 1, 1),
			Новый Структура("Валюта, Курс, Кратность",
				Объект.ВалютаПоступления, Объект.Курс, Объект.Кратность));
		
	Иначе
		ТекущаяСтрока.СуммаВВалюте = ТекущаяСтрока.Сумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьВалютнуюСуммуВоВсехСтроках(Форма)
	Объект = Форма.Объект;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КодыСчетовДляВыбора(Объект)
	СтрокаКодов = "";
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПоступлениеЗабаланс") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			СтрокаКодов = "01.50,02.50,02.5";
		КонецЕсли;
	ИначеЕсли Объект.ВидПоступления = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратЗемУчастковИзПользования") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна")
			ИЛИ Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое")
			ИЛИ Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			СтрокаКодов = "108.55";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			СтрокаКодов = "108.95";
		КонецЕсли;   

	ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна")
		ИЛИ Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое")
		ИЛИ Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
		СтрокаКодов = "108.50";
	ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
		СтрокаКодов = "108.90";
	КонецЕсли;   
	
	Возврат СтрокаКодов;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСчетаУчетаОС(Форма)
	Объект = Форма.Объект;
	КодыСчетов = КодыСчетовДляВыбора(Объект);
	Форма.КодыСчетов = ?(ЗначениеЗаполнено(КодыСчетов), КодыСчетов, "-");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетов(СтрокаСчетов)                                       
	Возврат БухгалтерскийУчет.СписокСчетов(СтрокаСчетов);
КонецФункции	

&НаКлиенте
Процедура УстановитьОтборСчетаВложений()
	
	Если Объект.Дата < '20210101' Тогда
		КодыСчетовВложений = "106.00";
	Иначе
		КодыСчетовВложений = "106.50,106.90";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаГрупповогоВводаОССервер(ВыбранноеЗначение)
	
	ТаблицаСозданныхОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	ПерваяДобавленнаяСтрока = Неопределено;
	Для каждого Строка Из ТаблицаСозданныхОС Цикл
		
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.СчетУчетаОС = Строка.СчетУчета;
		НоваяСтрока.Сумма = Строка.ПервоначальнаяСтоимость;
		Если НЕ Объект.ПередачаЧастейОбъектов Тогда
			НоваяСтрока.Количество = 1;
		КонецЕсли;	
		
		Если ПерваяДобавленнаяСтрока = Неопределено Тогда
			ПерваяДобавленнаяСтрока = НоваяСтрока;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверка заполнения

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма, Ошибки, НеЗаполнятьОшибки)
	
	Объект = Форма.Объект;
	
	ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
	ПроверятьЗаполнениеСчетаУчетаЗатрат
		= ПроверятьЗаполнениеСчетаУчетаЗатрат(Объект.ВидПоступления);
	
	ПараметрыПроверкиОшибок = Новый Структура;
	ПараметрыПроверкиОшибок.Вставить("ВидПоля","Колонка");
	ПараметрыПроверкиОшибок.Вставить("ВидСообщения", "Заполнение");
	ПараметрыПроверкиОшибок.Вставить("НомерСтроки",ТекущаяСтрока.НомерСтроки);
	ПараметрыПроверкиОшибок.Вставить("ТекстСообщения","");
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеСписка","Основные средства");
	ПараметрыПроверкиОшибок.Вставить("ИмяСписка","Объект.ОсновныеСредства[%1]");
	ПараметрыПроверкиОшибок.Вставить("ГруппаОшибок","Объект.ОсновныеСредства");
	ПараметрыПроверкиОшибок.Вставить("ИндексСтроки",ИндексСтроки);
	ПараметрыПроверкиОшибок.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат",
		ПроверятьЗаполнениеСчетаУчетаЗатрат);
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеПоля");
	ПараметрыПроверкиОшибок.Вставить("УчетПоПодразделениям", Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям);
	ПараметрыПроверкиОшибок.Вставить("ИмяПоля");
	
	Отказ = Ложь;
	ТекущаяСтрока.ОтражениеВУчетеБУЗаполненоНекорректно  = Ложь;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) 
		И ТекущаяСтрока.Количество <> 1 И НЕ Объект.ПередачаЧастейОбъектов Тогда
		
		Отказ = Истина;
		ТекущаяСтрока.ОтражениеВУчетеБУЗаполненоНекорректно = Истина;
		Если Не НеЗаполнятьОшибки Тогда
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Корректность", "Количество", ТекущаяСтрока.НомерСтроки, "Основные средства",
				НСтр("ru = 'Если в строке выбран инвентарный номер, то количество должно быть равно 1'"));
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"Объект.ОсновныеСредства[%1].Количество", ТекстСообщения,
				"Объект.ОсновныеСредства", ИндексСтроки, ТекстСообщения, ИндексСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Отказ ИЛИ НЕ НеЗаполнятьОшибки Тогда
		Если Не УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьЗаполнениеСтрокиПринятияКУчетуБУ(
			ТекущаяСтрока, НеЗаполнятьОшибки, ПараметрыПроверкиОшибок, Ошибки) Тогда
			Отказ = Истина;
			ТекущаяСтрока.ОтражениеВУчетеБУЗаполненоНекорректно = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	Иначе
		ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчетаОССоответствуетВидуИмущества(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.ВидИмущества)
	 ИЛИ Не ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаОС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Соответствует = (СписокСчетов(КодыСчетовДляВыбора(Объект)).Найти(ТекущаяСтрока.СчетУчетаОС) <> Неопределено);
	
	Если НЕ Соответствует Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Счет учета объекта ОС, НМА, НПА в строке %1 не соответствует выбранному виду имущества.'"),
				ТекущаяСтрока.НомерСтроки);
		
		Если Ошибки = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"Объект.ОсновныеСредства[%1].СчетУчетаОС",
					ТекущаяСтрока.ПолучитьИдентификатор()));
		Иначе
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"Объект.ОсновныеСредства[%1].СчетУчетаОС", ТекстОшибки,,
				ТекущаяСтрока.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Соответствует;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверятьЗаполнениеСчетаУчетаЗатрат(ВидПоступления)
	
	Возврат ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
		Или ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока);
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости <> ТекущаяСтрока.ПорядокПогашенияСтоимости
		Или РекомендуемыйПорядок.ДопустимыеСпособыНачисленияАмортизации.Найти(ТекущаяСтрока.СпособНачисленияАмортизации) = Неопределено Тогда
		
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0;
		
		ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1].ОтражениеВУчетеЕстьОшибка",
			РекомендуемыйПорядок.ПояснениеУказанногоПорядка,"Объект.ОсновныеСредства",
			ИндексСтроки, РекомендуемыйПорядок.ПояснениеУказанногоПорядка);
	Иначе
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРекомедуемыеОтражениеВУчетеВСтроке(Форма, ТекущаяСтрока)
	
	Если ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0 Тогда
		
		РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока);
		
		ТекущаяСтрока.ПорядокПогашенияСтоимости = РекомендуемыйПорядок.ПорядокПогашенияСтоимости;
		ТекущаяСтрока.СпособНачисленияАмортизации = РекомендуемыйПорядок.СпособНачисленияАмортизации;
		
		ВвестиВЭксплуатацию = РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию;
		Если ВвестиВЭксплуатацию <> Неопределено Тогда
			ТекущаяСтрока.НачислятьАмортизацию = ВвестиВЭксплуатацию;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока)
	Если НЕ ДоступнаВидимостьПараметровАмортизации(Форма) Тогда
		Результат = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураПорядкаАмортизации();
	Иначе                                                                                   
		Результат = УправлениеОсновнымиСредствамиКлиентСервер.РекомендуемыйПорядокПогашенияСтоимости(
			ТекущаяСтрока.ВидНФА,
			ТекущаяСтрока.ТипНФА,
			?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество),
			Форма.Объект.Дата,
			Форма.Объект.ВидИмущества,
			,
			ТекущаяСтрока.СчетУчетаОС);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

// Прочие

&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКомиссии()
	
	ЕстьКомиссия = ЗначениеЗаполнено(Объект.Комиссия);
	
	Элементы.ГруппаПриказОНазначенииКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	//Элементы.ГруппаПредседательКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.Председатель.Видимость = ЕстьКомиссия;
	Элементы.ВыбратьПредседателяКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии1.Видимость = ЕстьКомиссия;
	
КонецПроцедуры

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0)И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);
	
	ТаблицаНФА = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок, "ОбъектНФА, ИнвНомер, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЕдИзм");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНФА);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ПараметрыПодбора.ОбъектНФА);
	ПараметрыОтбора.Вставить("ИнвНомер", ПараметрыПодбора.ИнвНомер);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеСтроки;
	
КонецФункции

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение, ВариантВводаДанныхДМ = 1)
	
	Если ВариантВводаДанныхДМ = 2 Тогда
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъектов(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ИнвНомер,ВидДрагМатериала");
	Иначе
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ИнвНомер,ВидДрагМатериала");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	
	Для Каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,"СчетУчетаОС, ОсновноеСредство, ИнвентарныйНомер, Количество");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчетаОС)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер); 
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = ЭтаФорма.ОбъектыНФАСДрагМатериалами.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.ОсновноеСредство;
		НоваяСтрока.ИнвНомер = СтрокаТЧ.ИнвентарныйНомер;
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);
	
КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВнеоборотныйАктивПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
		ВнеоборотныйАктивПриИзмененииНаСервере();
	Иначе
		Объект.КапитальныеВложения.Очистить();
		Объект.СчетВложений = Неопределено;
		ПервоначальнаяСтоимостьЕдиницы = 0;
		Объект.СуммаАмортизацииВложений = 0;
		Объект.СуммаОбесцененияВложений = 0;
		Элементы.КапитальныеВложенияДоговор.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтражениеВУчетеСтрок(Команда)
	ОткрытьФормуНастройкиОтраженияВУчете();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("КПС", Новый Структура);
	Реквизиты.КПС.Вставить("Дата", Объект.Дата);
	Реквизиты.КПС.Вставить("Организация", Объект.Организация);
	Реквизиты.КПС.Вставить("ИФО", Объект.ИФО);

	Реквизиты.Вставить("СчетУчетаОС", Новый Структура);
	Реквизиты.СчетУчетаОС.Вставить("Счета", КодыСчетовДляВыбора(Объект));
	Реквизиты.СчетУчетаОС.Вставить("ВИерархии", Истина);
	Реквизиты.СчетУчетаОС.Вставить("Дата", Объект.Дата);

	Реквизиты.Вставить("Количество");
	Реквизиты.Вставить("Сумма");

	Если ДоступнаВидимостьПараметровАмортизации(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СрокПолезногоИспользования");
	КонецЕсли;
	Если ДоступнаВидимостьПереданнойАмортизации(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СуммаАмортизации");
	КонецЕсли;
	Если ДоступнаВидимостьДатаВводаВэксплуатацию(ЭтотОбъект) Тогда
		Реквизиты.Вставить("ДатаВводаВЭксплуатацию");
	КонецЕсли;
	Если ДоступнаВидимостьСоздатьИнвентарнуюКарточку(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СоздатьИнвентарнуюКарточку");
	КонецЕсли;

	Если ВозможныГарантийныеОбязательства(Объект.ВидПоступления) Тогда
		Реквизиты.Вставить("НаименованиеГТ", Новый Структура);
		Реквизиты.НаименованиеГТ.Вставить("ТипыДляВыбора", 
			Новый ОписаниеТипов("Строка, СправочникСсылка.ВидыПервичныхДокументов"));
		Реквизиты.НаименованиеГТ.Вставить("СинонимДляВыбора", НСтр("ru = 'Вид документа гарантии'")); 

		Реквизиты.Вставить("НомерГТ");
		Реквизиты.Вставить("ДатаГТ");
		Реквизиты.Вставить("СрокДействияГТ");
	КонецЕсли;	
	
	ОповещениеОЗаверщенииИзменения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокЗавершение", ЭтотОбъект);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"ПринятиеКУчетуОбъектовОС", "ОсновныеСредства", "ОсновныеСредства", Реквизиты, ОповещениеОЗаверщенииИзменения);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьПараметровАмортизации(Форма)
	
	Возврат Форма.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны
		И (Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
		ИЛИ Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление")
		ИЛИ Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПоступлениеЗабаланс"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьДатаВводаВэксплуатацию(Форма)
	
	Возврат(
	Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
	ИЛИ Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление")
	);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьПереданнойАмортизации(Форма)
	
	Возврат(
	Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление")
	ИЛИ Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление")
	);
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьОстСрокИспПриИзмененииДатыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			УстановитьОставшийсяСрокИспользования(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВнеоборотныйАктивПриИзмененииНаСервере()
	
	ПервоначальнаяСтоимостьЕдиницы	= 0;
	
	ДанныеОбъектаВложений = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.ВнеоборотныйАктив, Объект.Ссылка);
	Объект.СчетВложений = ДанныеОбъектаВложений.СчетВложений;
	
	ЗаполнитьВидНФАВложений(ДанныеОбъектаВложений.ВидНФА);
	ЗаполнитьМЦВнеоборотногоАктиваСДрагМатериалами(Истина);
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма) Тогда
		РассчитатьСуммуВложенийНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидНФАВложений(Знач ВидНФА)
	
	Если Не ЗначениеЗаполнено(ВидНФА) И ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
		ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВнеоборотныйАктив, "ВидНФА");
	КонецЕсли;
	
	ОбъектВложений_ВидНФА = ВидНФА;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(Форма, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("ВнеоборотныйАктив", "Объект вложений");
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыДляПроверки, Объект, Ложь, Ошибки);
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервере
Процедура РассчитатьСуммуВложенийНаСервере()
	УправлениеОсновнымиСредствами.ЗаполнитьКапитальныеВложенияПоОстаткам(Объект, "ПринятиеКУчетуОбъектовИК");
	
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	
	Для Каждого СтрокаТабЧасти Из Объект.ОсновныеСредства Цикл
		ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, СтрокаТабЧасти);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ВидИмущества) И ЗначениеЗаполнено(Объект.СчетВложений) Тогда
		Объект.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(Объект.СчетВложений);
	КонецЕсли;
	
	ОпределитьНаличиеДоговораВложения();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПериодПолученияОстатков(Объект)
	
	Возврат ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьЦенуЕдиницыВложений(Форма)
	
	Форма.ПервоначальнаяСтоимостьЕдиницы = Форма.Объект.КапитальныеВложения.Итог("Сумма") /
		?(Форма.Объект.КапитальныеВложения.Итог("Количество") = 0, 1, Форма.Объект.КапитальныеВложения.Итог("Количество"));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыТекущейСтроки(Форма, ТекущиеДанные)
	
	Объект = Форма.Объект;
	
	КоличествоКапвложенийВсего = Объект.КапитальныеВложения.Итог("Количество");
	Если ТекущиеДанные.Количество = КоличествоКапвложенийВсего
		ИЛИ Объект.ПоступлениеБиблиотечногоФонда Тогда
		ТекущиеДанные.Сумма            = Объект.КапитальныеВложения.Итог("Сумма");
		ТекущиеДанные.СуммаАмортизации = Объект.СуммаАмортизацииВложений;
		ТекущиеДанные.СуммаОбесценения = Объект.СуммаОбесцененияВложений;
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницы;
		Если КоличествоКапвложенийВсего <> 0 Тогда
			ТекущиеДанные.СуммаАмортизации = 
				ТекущиеДанные.Количество * Объект.СуммаАмортизацииВложений / КоличествоКапвложенийВсего;
			ТекущиеДанные.СуммаОбесценения = 
				ТекущиеДанные.Количество * Объект.СуммаОбесцененияВложений / КоличествоКапвложенийВсего;
		Иначе
			ТекущиеДанные.СуммаАмортизации = 0;
			ТекущиеДанные.СуммаОбесценения = 0;
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВложений(Команда)
	
	Перем Ошибки;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма, Ошибки) Тогда
		РассчитатьСуммуВложенийНаСервере();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКурсВалюты(Команда)
	ОбновитьКурсИКратностьВалюты(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКурсИКратностьВалюты(Форма)
	
	Объект = Форма.Объект;
	Если ЗначениеЗаполнено(Объект.ВалютаПоступления) И Объект.ВалютаПоступления <> Форма.ВалютаРубли Тогда
		ТекущийКурсВалюты = ПолучитьКурсВалюты(Объект.ВалютаПоступления, Объект.Дата);
		Объект.Курс = ТекущийКурсВалюты.Курс;
		Объект.Кратность = ТекущийКурсВалюты.Кратность;
	Иначе
		Объект.Курс = 1;
		Объект.Кратность = 1;
	КонецЕсли;
	
	ПересчитатьВалютнуюСуммуВоВсехСтроках(Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередаче(Команда)
	ЗаполнитьСведенияПоЭлектронномуАктуОПриемеПередачеНаСервере();
	
	Модифицированность = Истина;
КонецПроцедуры

// Переменная формы "ДопустимыйКПС" используется для автозаполнения при добавлении строки документа
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДопустимыйКПС(Форма)
	
	Объект = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		
		Форма.ДопустимыйКПС = ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка");
		
	Иначе
		
		Форма.ДопустимыйКПС = ПолучитьДопустимыйГКБК(Объект.Организация, Объект.ИФО, Объект.КФО, ДатаПолученияНСИ(Объект));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДопустимыйГКБК(Знач Организация, Знач ИФО, Знач КФО, Знач Дата)
	
	гКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК");
	ДопустимыеВидыКПС = БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Организация, ИФО, КФО, Дата);
	
	Если ДопустимыеВидыКПС.Найти(гКБК) = Неопределено Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	КлассификационныеПризнакиСчетов.Ссылка
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	|ГДЕ
	|	КлассификационныеПризнакиСчетов.ВидПоказателя = &ВидПоказателя
	|	И (КлассификационныеПризнакиСчетов.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КлассификационныеПризнакиСчетов.ДатаНачалаДействия <= &Дата)
	|	И (КлассификационныеПризнакиСчетов.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КлассификационныеПризнакиСчетов.ДатаОкончанияДействия >= &Дата)
	|	И КлассификационныеПризнакиСчетов.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ВидПоказателя", гКБК);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКФО(Форма)
	
	КФОБюджет = ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
	
	Объект = Форма.Объект;
	ДопустимыеКФО = БухгалтерскийУчетВызовСервераПовтИсп.КФОПоУчетнойПолитике(Объект.Организация, Объект.ИФО,
		Форма.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
	
	Если ДопустимыеКФО.Найти(КФОБюджет) <> Неопределено Тогда
		Объект.КФО = КФОБюджет;
	Иначе
		Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДатаПолученияНСИ(Объект)
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаНСИ = Объект.Дата;
	Иначе
		#Если Сервер Тогда
			ДатаНСИ = ТекущаяДатаСеанса();
		#Иначе
			ДатаНСИ = ТекущаяДата();
		#КонецЕсли
	КонецЕсли;
	
	Возврат ДатаНСИ;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьИнвентарныйНомер(Форма, ИдентификаторСтроки, ОчищатьПередУстановкой = Ложь)
	
	Объект = Форма.Объект;
	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ОчищатьПередУстановкой Тогда
		ТекущиеДанные.ИнвентарныйНомер = ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		
		/////
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
			ТекущиеДанные.ИнвентарныйНомер = УправлениеОсновнымиСредствами.ПолучитьИнвентарныйНомерНеВЭкплуатации(
				ТекущиеДанные.ОсновноеСредство, Объект.Организация, ПериодПолученияОстатков(Объект),
				Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ИнвентарныйНомер"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствамиКлиент.ПолучитьНомерИнвентарнойКарточи(
			ЭтотОбъект, Объект.ОсновныеСредства.Индекс(ТекСтрока));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	
	ОбновитьАналитикуОперацииПоДрагМатериалам();
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМЦВнеоборотногоАктиваСДрагМатериалами(ПерезаполнитьТЧ = Ложь)
	
	Если ПерезаполнитьТЧ Тогда
		Объект.МЦСДрагоценнымиМатериалами.Очистить();
	КонецЕсли;
	
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	
	Если Объект.МЦСДрагоценнымиМатериалами.Количество() = 0
						И ВедетсяУчетДрагМатериаловВКапвожениях И ЭтоПриобретениеИлиИзготовление Тогда
		
		ТаблицаОбъектовОС = УчетДрагМатериалов.ПолучитьСписокОстатковМЦ(Объект.Дата, Объект.Организация, Объект.ВнеоборотныйАктив);
		ТаблицаОбъектовОС.Колонки.КоличествоОстаток.Имя = "Количество";
		ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
		
		Для Каждого ТекСтрока Из ТаблицаОбъектовОС Цикл
			ТекСтрока.КоличествоВсего = ТекСтрока.Количество;
		КонецЦикла;

		Объект.МЦСДрагоценнымиМатериалами.Загрузить(ТаблицаОбъектовОС);
				
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере(ВыбранныйОбъектНФА)
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Капвложение = Объект.ВнеоборотныйАктив;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА)
	
	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Капвложение, ТаблицаСписанияОбъектов, ПериодОстатков);		
	
	ОсновноеСредство = ВыбранныйОбъектНФА.ОсновноеСредство;
	ИнвентарныйНомер = ВыбранныйОбъектНФА.ИнвентарныйНомер;
	
	Если ОстаткиДМ.Количество() > 0 Тогда
		Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
		Для Каждого Строка Из Объект.ДрагоценныеМатериалы Цикл  
			Строка.ОбъектНФА = ОсновноеСредство;
			Строка.ИнвНомер = ИнвентарныйНомер; 
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьАналитикуОперацииПоДрагМатериалам() 
	
	Если Объект.ВидПоступления <> Перечисления.ВидыОперацийИК.Поступление 
			ИЛИ Объект.ОсновныеСредства.Количество() = 0 Тогда
		Объект.АналитикаОперацииСДрагМатериалами = 
			Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	ТЗИнвНомеров = Объект.ОсновныеСредства.Выгрузить(,"ИнвентарныйНомер");
	МассивИнв = ТЗИнвНомеров.ВыгрузитьКолонку("ИнвентарныйНомер");
	СоответствиеРеквизитовИнвНомеров = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивИнв, "ИнвентарныйНомерЗаимствуется");
	
	Для Каждого ТекСтрока Из МассивИнв Цикл
		ИнвНомерЗаимстувуется = ?(СоответствиеРеквизитовИнвНомеров.Получить(ТекСтрока) <> Неопределено,
			СоответствиеРеквизитовИнвНомеров.Получить(ТекСтрока), Ложь); 
		Если ЗначениеЗаполнено(ТекСтрока) И ИнвНомерЗаимстувуется Тогда
			Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ВыходИзГрупповогоИнвентарногоУчета");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	Объект.АналитикаОперацииСДрагМатериалами = Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПустаяСсылка");
	
КонецПроцедуры

&НаСервере
Процедура ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(ИзмененныеИнвНомераОбъектовОС)
	
	Если Объект.ВидПоступления <> Перечисления.ВидыОперацийИК.Поступление Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИзмененныеИнвНомераОбъектовОС) = Тип("Структура") Тогда
		
		ИзмененныйОбъект = ИзмененныеИнвНомераОбъектовОС.ОсновноеСредство;
		ИнвНомерИзмененногоОбъекта = ИзмененныеИнвНомераОбъектовОС.ИнвНомер;
		
		Если ЗначениеЗаполнено(ИнвНомерИзмененногоОбъекта) И ИнвНомерИзмененногоОбъекта.ИнвентарныйНомерЗаимствуется Тогда

			ТаблицаОбъектовСИзмИнвентарнымиНомерами = Новый ТаблицаЗначений; 
			ТаблицаОбъектовСИзмИнвентарнымиНомерами.Колонки.Добавить("ОбъектНФА", Тип("СправочникСсылка.ОсновныеСредства"));
			ТаблицаОбъектовСИзмИнвентарнымиНомерами.Колонки.Добавить("ИнвНомер", Тип("СправочникСсылка.ИнвентарныеНомераОС"));
			
			НоваяСтрокаТЗ = ТаблицаОбъектовСИзмИнвентарнымиНомерами.Добавить();
			НоваяСтрокаТЗ.ОбъектНФА = ИзмененныйОбъект;
			НоваяСтрокаТЗ.ИнвНомер = ИнвНомерИзмененногоОбъекта;
			
			ДанныеДМОбъектов = УчетДрагМатериалов.ЗаполнитьДМДляПринятияКУчетуОбъектовВышедшихИзГрупповогоУчета(Объект.Организация, ТаблицаОбъектовСИзмИнвентарнымиНомерами);
		Иначе
			Возврат;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ИзмененныеИнвНомераОбъектовОС) = Тип("ТаблицаЗначений") тогда
		
		ИзмененныеИнвНомераОбъектовОС.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
		ИзмененныеИнвНомераОбъектовОС.Колонки.ИнвентарныйНомер.Имя = "ИнвНомер";
		
		ДанныеДМОбъектов = УчетДрагМатериалов.ЗаполнитьДМДляПринятияКУчетуОбъектовВышедшихИзГрупповогоУчета(Объект.Организация, ИзмененныеИнвНомераОбъектовОС);
	Иначе
		Возврат;		
	КонецЕсли;
	
	ТекущийОбъектНФА = "";
	
	Для Каждого ТекСтрока Из ДанныеДМОбъектов Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОбъектНФА); 
		ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвНомер);
		
		НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 
			ИЛИ ТекущийОбъектНФА = ТекСтрока.ОбъектНФА Тогда
			
			НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
			НоваяСтрока.ОбъектНФА 	= ТекСтрока.ОбъектНФА;
			НоваяСтрока.ИнвНомер 	= ТекСтрока.ИнвНомер;
			НоваяСтрока.КлючСтроки 	= УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер); 
			
			Если ТекущийОбъектНФА <> ТекСтрока.ОбъектНФА Тогда
				ТекущийОбъектНФА = ТекСтрока.ОбъектНФА;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура  ПроверитьКоличествоПринятихКУчетуДрагМатериаловКапвложения(Отказ)
	
	ПринимаемыеДрагМатериалы = Объект.ДрагоценныеМатериалы.Выгрузить(,"ВидДрагМатериала,МассаДМ,КоличествоДМ");
	ПринимаемыеДрагМатериалы.Свернуть("ВидДрагМатериала","МассаДМ,КоличествоДМ");
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ДрагМатериалыКапвложения = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Объект.ВнеоборотныйАктив, ТаблицаСписанияОбъектов, ПериодОстатков);		
	  
	Для Каждого Строка Из ПринимаемыеДрагМатериалы Цикл
			
		НайденнаяСтрока = ДрагМатериалыКапвложения.Найти(Строка.ВидДрагМатериала,"ВидДрагМатериала");
		
		Если НайденнаяСтрока = Неопределено ИЛИ НайденнаяСтрока.МассаДМ <> Строка.МассаДМ 
					ИЛИ Строка.КоличествоДМ <> НайденнаяСтрока.КоличествоДМ Тогда
					
			ТекстОшибки = СтрШаблон(Нстр("ru='Количество принимаемого к учету ""%1"" не совпадает с количеством ""%1"" в материальных ценностях капитального вложения.'"),
				Строка.ВидДрагМатериала);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ДрагоценныеМатериалы");		
					
			Если Не Отказ Тогда		
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПодборОС(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтотОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПодборВложений(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтаФорма, Объект, ПараметрыПодбораКапвложения());
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПоступления", "Вид поступления");
	СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	СтруктураРеквизитов.Вставить("Организация", "Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО", "ИФО");
	КонецЕсли;
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
//		СтруктураРеквизитов.Вставить("ЦМООтправитель", "МОЛ/Место хранения (отправитель)");
		СтруктураРеквизитов.Вставить("Контрагент", "Контрагент");
	КонецЕсли;
	//
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
//		СтруктураРеквизитов.Вставить("ВнеоборотныйАктив", "Объект вложений");
//		СтруктураРеквизитов.Вставить("СчетВложений", "Счет объекта вложений");
		Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
			СтруктураРеквизитов.Вставить("Количество", "Количество");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление")
		Или Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление") Тогда
		ВидРаспоряжения = "ПринятиеКУчету";
		ПараметрыПодбора.Отбор.Вставить("Счет", "108.00");
		ПараметрыПодбора.Отбор.Вставить("ИмуществоКазны", Истина);
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратУправление") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление");
		ПараметрыПодбора.Отбор.Вставить("Счет", "24.50");
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду");
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			ПараметрыПодбора.Отбор.Вставить("Счет", "25.90");
		Иначе	
			ПараметрыПодбора.Отбор.Вставить("Счет", "25.50");
		КонецЕсли;	
	ИначеЕсли Объект.ВидПоступления = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование") 
		ИЛИ Объект.ВидПоступления = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратЗемУчастковИзПользования") Тогда
			
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование");
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			ПараметрыПодбора.Отбор.Вставить("Счет", "26.90");
		Иначе	
			ПараметрыПодбора.Отбор.Вставить("Счет", "26.50");
		КонецЕсли;	
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПоступлениеЗабаланс") Тогда
		ВидРаспоряжения = "ПринятиеКУчету";
		ПараметрыПодбора.Отбор.Вставить("Счет", "01, 02");
		ПараметрыПодбора.Отбор.Вставить("ИмуществоКазны", Истина);
	Иначе
		ВидРаспоряжения = Неопределено;
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", ВидРаспоряжения);
	
	Если ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету" Тогда
		СписокНФА = Новый Массив;
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
		ПараметрыПодбора.Отбор.Вставить("ВидНФА", СписокНФА);
	Иначе
		ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
		ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
		ПараметрыПодбора.Отбор.Вставить("Контрагент"	, Объект.Контрагент);
		Если ЗначениеЗаполнено(Объект.ЦМООтправитель) Тогда
			ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМООтправитель);
		ИначеЕсли ЗначениеЗаполнено(Объект.ЦМО) Тогда
			ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМО);
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("СкрытьКолонки", "ЦМО");
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("СчетУчета", "СчетУчетаОС"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, ПараметрыПодбора) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЭтоПодборКапвложения = Ложь;
		Если ПараметрыПодбора.Свойство("ЭтоПодборКапвложения", ЭтоПодборКапвложения) И ЭтоПодборКапвложения Тогда
			ОбработкаВыбораПодбораОССервер(Результат, Истина);
			
			Если ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
				ВнеоборотныйАктивПриИзмененииНаСервере();
			КонецЕсли;	
		Иначе	 	
			ОбработкаВыбораПодбораОССервер(Результат);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбораКапвложения() Экспорт
	
	ПараметрыПодбора = Новый Структура("Отбор", Новый Структура);
	ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО", Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет", КодыСчетовКапвложений());
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", "Вложения");
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
	ПараметрыПодбора.Вставить("ЭтоПодборКапвложения", Истина);
	
	Возврат ПараметрыПодбора;
КонецФункции

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение, ЭтоПодборКапвложения = Ложь)
	
	Если ЭтоПодборКапвложения Тогда
		ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		КолСтрок = ТаблицаОС.Количество();
		Если КолСтрок = 0 Тогда
			Возврат;
		ИначеЕсли КолСтрок > 1 Тогда
			ТекстСообщения = НСтр(
				"ru = 'В подборе выбрано больше одного объекта капвложений. Подбирать следует один объект.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;	
		
		Объект.ВнеоборотныйАктив = ТаблицаОС[0].ОсновноеСредство;
		
	Иначе	
		ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		
		ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
		ИсходныеДанные.Индексы.Добавить("ОсновноеСредство");
		
		Объект.ОсновныеСредства.Очистить();
		Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
			
			ЭлементКоллекции = Объект.ОсновныеСредства.Добавить();
			ЭтоЗаполнениеНовойСтроки = Истина;
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ЭлементКоллекции, Строка(Объект.ВалютаПоступления));
			
			СтруктураПоискаСтроки = Новый Структура("ОсновноеСредство, ИнвентарныйНомер",
				СтрокаТаблицыОС.ОсновноеСредство, СтрокаТаблицыОС.ИнвентарныйНомер);
			
			СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоискаСтроки);
			Если СтрокиИсходныхДанных.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0], "СчетУчетаОС, ВидНФА, ТипНФА, ГрупповойУчет");
				ЗаполнитьСтрокуИзДругойСтроки(ЭлементКоллекции, СтрокиИсходныхДанных[0]);
				ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0]);
				ЭтоЗаполнениеНовойСтроки = Ложь;
			Иначе
				ЭлементКоллекции.КПС = ДопустимыйКПС;
				
				Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
					
					ЭлементКоллекции.Сумма = ЭлементКоллекции.Количество * ПервоначальнаяСтоимостьЕдиницы;
					
				КонецЕсли;
				ОсновноеСредствоПриИзмененииНаСервере(ЭлементКоллекции.ПолучитьИдентификатор(), ЭтоЗаполнениеНовойСтроки, Истина);
			КонецЕсли;
			
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ЭлементКоллекции);
			
		КонецЦикла;  
		
		Если ТаблицаОС.Количество() > 0 Тогда
			ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(ТаблицаОС);
			ОбновитьАналитикуОперацииПоДрагМатериалам();
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

