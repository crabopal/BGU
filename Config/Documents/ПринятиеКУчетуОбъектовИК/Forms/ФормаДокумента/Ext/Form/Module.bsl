#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = НоваяСтрока;
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		
		ТекущиеДанные.КПС = ДопустимыйКПС;
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(
			Объект.ВидПоступления) Тогда
			Если ЗначениеЗаполнено(ОбъектВложений_ВидНФА)
				И ОбъектВложений_ВидНФА <> ПредопределенноеЗначение(
				"Перечисление.ВидыНФА.КапВложения") Тогда
				ТекущиеДанные.ОсновноеСредство = Объект.ВнеоборотныйАктив;
				ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),
					ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС, Истина);
			КонецЕсли;                              
			
			Если НЕ Объект.ПоступлениеБиблиотечногоФонда И НЕ Объект.ПередачаЧастейОбъектов Тогда
				Если ПервоначальнаяСтоимостьЕдиницы < ПервыйПределОС Тогда
					// ОС до 3000 обычно учитываются без инв. номеров,
					// значит можно ввести все количество в одну строку
					Если Объект.ОсновныеСредства.Количество() > 1
						И ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
						// вероятно, все таки будут указаны инв. номера
						ТекущиеДанные.Количество = 1;
					Иначе
						ТекущиеДанные.Количество = Объект.КапитальныеВложения.Итог("Количество");
					КонецЕсли;
				Иначе
					// будут указаны инв номера
					ТекущиеДанные.Количество = 1;
				КонецЕсли;
			КонецЕсли;	
			ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, ТекущиеДанные);
		КонецЕсли;
		// пробуем найти этот объект в ранее введенных строках
		// если найдется, то заполнить отражение в учете из этой строки
		Если НЕ ЗаполнитьОтражениеВУчетеИзРанееВведеннойСтроки(ТекущиеДанные) Тогда
			УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
		КонецЕсли;	
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные, Строка(Объект.ВалютаПоступления));
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
		
	ИначеЕсли НоваяСтрока И Копирование Тогда
		
		// в скопированной строке только пробуем заполнить инв. номер
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(
			Объект.ВидПоступления) Тогда
			
			ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
			Если ЗначениеЗаполнено(ОбъектВложений_ВидНФА)
				И ОбъектВложений_ВидНФА <> ПредопределенноеЗначение(
				"Перечисление.ВидыНФА.КапВложения") Тогда
				
				ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),
					ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОсновныеСредстваОтражениеВУчете"
		ИЛИ Поле.Имя = "ОсновныеСредстваОтражениеВУчетеЕстьОшибка"Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	ОсновноеСредствоПриИзмененииНаСервере(ИдентификаторСтроки,
		ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС <> Истина Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено И ВыбранноеЗначение <> ТекущиеДанные.ОсновноеСредство Тогда
			ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки,
	Знач ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС, Знач НеЗаполнятьИнвНомер = Ложь)
	
	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ДанныеЗаполнены = Ложь;
	Если ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина Тогда
		Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			Если ТекСтрока.ОсновноеСредство = ТекущаяСтрока.ОсновноеСредство
				И ТекСтрока.ПолучитьИдентификатор() <> ИдентификаторСтроки Тогда
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекСтрока, "СчетУчетаОС, ВидНФА, ТипНФА, ГрупповойУчет");
				ЗаполнитьСтрокуИзДругойСтроки(ТекущаяСтрока, ТекСтрока);
				ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекСтрока);
				ДанныеЗаполнены = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ДанныеЗаполнены Тогда
		ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекущаяСтрока.ОсновноеСредство, Объект.Ссылка);
		ТекущаяСтрока.ВидНФА      = ДанныеОбъектаОС.ВидНФА;
		ТекущаяСтрока.ТипНФА      = ДанныеОбъектаОС.ТипНФА;
		ТекущаяСтрока.СчетУчетаОС = ДанныеОбъектаОС.СчетУчета;
		ТекущаяСтрока.КПС         = ДанныеОбъектаОС.КПС;
		ТекущаяСтрока.ГрупповойУчет = ДанныеОбъектаОС.ГрупповойУчет;
		ТекущаяСтрока.НомерИнвентарнойКарточки	 = "";
		ТекущаяСтрока.СоздатьИнвентарнуюКарточку = Ложь;
	КонецЕсли;
	
	Если Не НеЗаполнятьИнвНомер Тогда
		УстановитьИнвентарныйНомер(ЭтотОбъект, ИдентификаторСтроки, Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокПолезногоИспользования) Тогда
		УправлениеОсновнымиСредствами.УстановитьСрокПолезногоИспользованияВСтрокеТЧ(
			ТекущаяСтрока, "ПринятиеКУчетуОбъектовИК");
	КонецЕсли;
	
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущаяСтрока);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭтоПервый = Истина;
	
	Для Каждого ИнвентарныйНомер Из ВыбранноеЗначение Цикл
		Если ЭтоПервый Тогда
			ЗаполняемаяСтрока = ТекущиеДанные;
			ЭтоПервый = Ложь;
		Иначе
			ЗаполняемаяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, ТекущиеДанные);
		КонецЕсли;
		ЗаполняемаяСтрока.ИнвентарныйНомер	= ИнвентарныйНомер;
		Если НЕ Объект.ПередачаЧастейОбъектов Тогда
			ЗаполняемаяСтрока.Количество = 1;
		КонецЕсли;	
	КонецЦикла;
	
	СведенияОбъектаОС = Новый Структура("ОсновноеСредство, ИнвНомер",
		ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер);
	
	ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(СведенияОбъектаОС);
	ОбновитьАналитикуОперацииПоДрагМатериалам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ИзмененныйОбъект = ТекущиеДанные.ОсновноеСредство;
	ИнвНомерИзмененногоОбъекта = ТекущиеДанные.ИнвентарныйНомер;
	СведенияОбъектаОС = Новый Структура("ОсновноеСредство, ИнвНомер", 
		ИзмененныйОбъект, ИнвНомерИзмененногоОбъекта);
	
	ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(СведенияОбъектаОС);
   	ОбновитьАналитикуОперацииПоДрагМатериалам();
                          
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетОСПриИзменении(Элемент)
	
	СчетУчетаОССоответствуетВидуИмущества(ЭтаФорма, Элементы.ОсновныеСредства.ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваДатаВводаВЭксплуатациюПриИзменении(Элемент)
	
	УстановитьОставшийсяСрокИспользования(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСрокПолезногоИспользованияПриИзменении(Элемент)
	
	УстановитьОставшийсяСрокИспользования(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьВалютнуюСуммуВСтроке(ЭтотОбъект, ТекущиеДанные);
	
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуНастройкиОтраженияВУчете();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	ОбъектНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтаФорма, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ("+
						СокрЛП(ОбъектНаУдаление)+") на закладке ""Драгоценные материалы""?'"), Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСоздатьИнвентарнуюКарточкуПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.ПолучитьНомерИнвентарнойКарточи(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокНФАДокументаОснования

&НаКлиенте
Процедура СписокНФАДокументаОснованияПриАктивизацииСтроки(Элемент)
	
	Если (Элемент.ТекущиеДанные <> Неопределено)И(ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА) Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставКомиссии

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	УстановитьДоступностьКомиссии();
	
	Если Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = ОбщегоНазначенияБГУКлиент.СтруктураПараметровВыбораКомисии(ЭтотОбъект);
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Объект.Комиссия, ДопПараметры, Объект);
	
КонецПроцедуры

