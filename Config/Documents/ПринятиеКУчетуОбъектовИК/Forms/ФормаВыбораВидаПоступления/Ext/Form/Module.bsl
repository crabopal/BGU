#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСписокВидовОперацийДокумента(
		Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК"), СписокВидовОпераций);
	
	Если Параметры.Свойство("ЗначенияЗаполнения")
		И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
		
		ПереданныеЗначенияЗаполнения = Новый ФиксированнаяСтруктура(Параметры.ЗначенияЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВидовОперацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	КлючеваяОперация ="СозданиеФормыПринятиеКУчетуОбъектовИК";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);
	
	ПараметрыДокумента = Новый Структура;
	Если ЗначениеЗаполнено(ПереданныеЗначенияЗаполнения) Тогда
		ПараметрыДокумента.Вставить("ЗначенияЗаполнения", Новый Структура(ПереданныеЗначенияЗаполнения));
	Иначе
		ПараметрыДокумента.Вставить("ЗначенияЗаполнения", Новый Структура);
	КонецЕсли;
	ПараметрыДокумента.ЗначенияЗаполнения.Вставить("ВидПоступления", СписокВидовОпераций[ВыбраннаяСтрока].Значение);
	ОткрытьФорму("Документ.ПринятиеКУчетуОбъектовИК.ФормаОбъекта", ПараметрыДокумента);
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
