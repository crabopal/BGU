#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);
	ВестиАналитическийИИнвентарныйУчет = УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ВидПоступления);
	ЭтоПоступлениеЗабаланс = (ВидПоступления = Перечисления.ВидыОперацийИК.ПоступлениеЗабаланс);
	
	Если ВестиАналитическийИИнвентарныйУчет Тогда
		Если Не ЭтоПоступлениеИзПользования Тогда
			УправлениеОсновнымиСредствами.ЕстьОСПринятыеКУчету(ЭтотОбъект, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПоступления = Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление Тогда
		СуммаВложений = КапитальныеВложения.Итог("Сумма");
		СуммаТЧ = ОсновныеСредства.Итог("Сумма"); 
		КоличествоКапвложений = КапитальныеВложения.Итог("Количество");
		КоличествоТЧ = ОсновныеСредства.Итог("Количество"); 

		Если КоличествоТЧ > КоличествоКапвложений Тогда
			ТекстОшибки = 
				УправлениеОсновнымиСредствами.ТекстПревышенияКоличестваОбъектовНадКоличествомВложения(
				КоличествоТЧ, КоличествоКапвложений);	
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Количество", "Объект", Отказ);
		ИначеЕсли СуммаТЧ = СуммаВложений И КоличествоТЧ <> КоличествоКапвложений Тогда
			ТекстОшибки = 
				УправлениеОсновнымиСредствами.ТекстНеравнстваКоличествОбъектовИВложенийПриРавенствеСумм(
				КоличествоТЧ, КоличествоКапвложений);	
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,, "Объект", Отказ);
		КонецЕсли;

		Если СуммаТЧ > СуммаВложений Тогда
			ТекстОшибки = 
				УправлениеОсновнымиСредствами.ТекстПревышенияСуммыОбъектвоНадСуммойВложения(СуммаТЧ, СуммаВложений);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ);
		КонецЕсли;
	КонецЕсли;

	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если ЭтоПоступлениеИзПользования Тогда
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.КПС");
	Иначе
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления) Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ВнеоборотныйАктив");
		НеПроверяемыеРеквизиты.Добавить("СчетВложений");
		
	КонецЕсли;
	
	СписокСчетов = ОсновныеСредства.ВыгрузитьКолонку("СчетУчетаОС");
	Если Не БухгалтерскийУчет.ПодразделениеОбязательно(СписокСчетов) Тогда
		// Если нет учета по подразделениям, то подразделение не контролируем, ни для отправителя, ни для получателя 
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
	ИначеЕсли Документы.ПринятиеКУчетуОбъектовИК.ВОсВнутреннимПеремещением().Найти(ВидПоступления) = Неопределено
		ИЛИ ПередачаЧастейОбъектов Тогда
		// Если есть учет по подразделениям, то подразделение получателя контролируем, 
		// только в случае, если есть внутреннее перемещение по счетам 108
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
	КонецЕсли;                           
	
	// Проверим заполнение карточки капвложений
	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление);
	Если ОперацииСоСчетом106.Найти(ВидПоступления) = Неопределено ИЛИ НЕ ОтразитьВКарточкеКапвложений Тогда
		НеПроверяемыеРеквизиты.Добавить("КарточкаКапвложений");
	КонецЕсли;		
	
	Если ПоступлениеБиблиотечногоФонда ИЛИ ПередачаЧастейОбъектов Тогда
		МассивРеков = Новый Массив;
		МассивРеков.Добавить("Количество");
		МассивРеков.Добавить("ОсновныеСредства.Количество");
		
		Для каждого ТекРек из МассивРеков Цикл
			Если НеПроверяемыеРеквизиты.Найти(ТекРек) = Неопределено Тогда
				НеПроверяемыеРеквизиты.Добавить(ТекРек);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
	Если ВестиАналитическийИИнвентарныйУчет Тогда
		
		ПроверятьПараметрыПереданныхОбъектов = (ВидПоступления = Перечисления.ВидыОперацийИК.Поступление 
			И УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны);
		
		Для Каждого ТекущаяСтрока Из ОсновныеСредства Цикл
			
			СтрокаТаблицы = "ОсновныеСредства["+ (ТекущаяСтрока.НомерСтроки - 1) +"]."; 
			
			Если (Не ТекущаяСтрока.ОсновноеСредство.ГрупповойУчет) И (ТекущаяСтрока.Количество > 1) Тогда
				ТекстОшибки = НСтр("ru='В строке %2 списка объектов на закладке ""Основные средства, НМА, НПА"" для объекта с индивидуальным учетом ""%1"" указано количество больше 1'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекущаяСтрока.ОсновноеСредство, ТекущаяСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "Количество", "Объект", Отказ);
			КонецЕсли;

			Если ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) 
				И ТекущаяСтрока.Количество <> 1 И НЕ ПередачаЧастейОбъектов Тогда
				ТекстОшибки = НСтр("ru = 'Если в строке выбран инвентарный номер, то количество должно быть равно 1'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "Количество", "Объект", Отказ);
			КонецЕсли;
			
			Если ПроверятьПараметрыПереданныхОбъектов И ТекущаяСтрока.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
				И ТекущаяСтрока.СуммаАмортизации <> 0 Тогда
				Если ТекущаяСтрока.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию Тогда
					Если ТекущаяСтрока.ДатаВводаВЭксплуатацию = '00010101' Тогда
						ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "дата ввода в экспл.");
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "ДатаВводаВЭксплуатацию", "Объект", Отказ);
					КонецЕсли;
				Иначе
					Если ТекущаяСтрока.ОставшийсяСрокПолезногоИспользования = 0 И ТекущаяСтрока.СуммаАмортизации < ТекущаяСтрока.Сумма Тогда
						ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "оставшийся срок исп.");
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "ОставшийсяСрокПолезногоИспользования", "Объект", Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ЦенаОС = ТекущаяСтрока.Сумма / ?(ТекущаяСтрока.Количество = 0, 1, ТекущаяСтрока.Количество);
			Причина = "";
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер)
				И УправлениеОсновнымиСредствамиКлиентСервер.ДляОбъектаОбязательноУказаниеИнвНомера(
					ТекущаяСтрока.ОсновноеСредство,,ТекущаяСтрока.СчетУчетаОС, ЦенаОС, Причина)
				И НЕ ПоступлениеБиблиотечногоФонда И НЕ ЭтоПоступлениеЗабаланс Тогда
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Заполнение", "Инвентарный номер", ТекущаяСтрока.НомерСтроки, "Основные средства")
				+ "
				|
				|" + Причина;
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "ИнвентарныйНомер", "Объект", Отказ);
			КонецЕсли;
			
			Если Не ЭтоПоступлениеИзПользования И ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаОС) Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущаяСтрока.СчетУчетаОС);
				Если СвойстваСчета.УчетПоКПС И Не ЗначениеЗаполнено(ТекущаяСтрока.КПС) Тогда
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Колонка", "Заполнение", "КПС", ТекущаяСтрока.НомерСтроки, "Основные средства");
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "КПС", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			Если ТекущаяСтрока.СоздатьИнвентарнуюКарточку И Не ЗначениеЗаполнено(ТекущаяСтрока.НомерИнвентарнойКарточки) Тогда
				Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ВидПоступления) Тогда
					// если это поступление из пользования, то флаг будет снят при записи
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
					"Заполнение", "Номер инвентарной карточки", ТекущаяСтрока.НомерСтроки, "Основные средства");
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрокаТаблицы + "НомерИнвентарнойКарточки", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
	Если Не Отказ Тогда
		РегистрыСведений.НомераИнвентарныхКарточек.ПроверитьУникальность(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	// Стоимость ОС с групповым учетом должна быть одинаковой во всех строках
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ОбъектКопирования.ВидПоступления <> Перечисления.ВидыОперацийИК.Поступление Тогда
		Для каждого СтрокаОС Из ОсновныеСредства Цикл
			СтрокаОС.Сумма = 0;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ВалютаПоступления) Тогда
			ЭтотОбъект.ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
			ЭтотОбъект.Курс = 1;
			ЭтотОбъект.Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	// очистка реквизитов
	
	// переданная амортизация, дата фактического ввода в эксплуатацию
	// могут быть заполнены только для поступления
	Если  ВидПоступления <> Перечисления.ВидыОперацийИК.Поступление
		И ВидПоступления <> Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление Тогда
		Для каждого ТекСтр Из ОсновныеСредства Цикл
			Если ТекСтр.СуммаАмортизации <> 0 Тогда
				ТекСтр.СуммаАмортизации = 0;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтр.ДатаВводаВЭксплуатацию) Тогда
				ТекСтр.ДатаВводаВЭксплуатацию = '00010101';
			КонецЕсли;
			Если ТекСтр.ОставшийсяСрокПолезногоИспользования<>0 Тогда
				ТекСтр.ОставшийсяСрокПолезногоИспользования = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ЭтотОбъект.ВидПоступления) Тогда
		
		Для Каждого ТекСтр Из ОсновныеСредства Цикл
			Если ТекСтр.СоздатьИнвентарнуюКарточку = Истина Тогда
				ТекСтр.СоздатьИнвентарнуюКарточку = Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтр.НомерИнвентарнойКарточки) Тогда
				ТекСтр.НомерИнвентарнойКарточки = "";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Комиссия) Тогда
		Председатель = Справочники.Сотрудники.ПустаяСсылка();
		Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
			СтрокаКомиссии.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
			СтрокаКомиссии.Отсутствует = Ложь;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании")
			И ТипЗнч(ДанныеЗаполнения.ВводНаОсновании) = Тип("Булево") 
			И ДанныеЗаполнения.ВводНаОсновании
			И ДанныеЗаполнения.Свойство("ДокументОснование")
			И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
			ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения);
			СтандартнаяОбработка = Ложь;
		Иначе	
			ДанныеЗаполнения.Свойство("Основание", Основание);
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
				СтандартнаяОбработка = Ложь;
				Документы.ИнвентаризацияИК.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
				СчетУчетаИнвентаризации = Основание.Счет;
				
				Если Не БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчетаИнвентаризации, "108.51,108.55") Тогда
					ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
				Иначе
					ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
				КонецЕсли;	
				
				Для каждого ТекущаяСтрока Из ОсновныеСредства Цикл
					ТекущаяСтрока.СчетУчетаОС = СчетУчетаИнвентаризации;
				КонецЦикла;	
				
				КФО = Перечисления.КВД.Бюджет;
				
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				
				СтандартнаяОбработка = Ложь;
				Организация = Основание.Организация;
				ДанныеЗаполнения.Вставить("Организация", Организация);
				
				Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Организация) Тогда
					РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Основание);
					Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
						ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(Основание, РазличающаясяНоменклатураКонтрагентаИОрганизации);
						ВызватьИсключение ТекстСообщения;
					КонецЕсли;
				КонецЕсли;	
				
				Если ДанныеЗаполнения.Свойство("НоменклатураДляОтраженияВУчете") Тогда
					ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание, ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить());
				Иначе
					ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
				СтандартнаяОбработка = Ложь;
				Организация = Основание.Организация;
				ДанныеЗаполнения.Вставить("Организация", Организация);
				ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения.Основание);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	

		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		
		ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВалютаПоступления) Тогда
		ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
		Курс = 1;
		Кратность = 1;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчетаОС, ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчетаОС)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбъектНФА,
				ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В списке ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1"" в строке %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовИК;
	ВидПоступления = Перечисления.ВидыОперацийИК.Поступление;

	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаПоступления = ДанныеЗаполнения.ВалютаДокумента;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	ДокументОснование = ДанныеЗаполнения;
	
	КФО = Перечисления.КВД.Бюджет;
	ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	
	Если ЗначениеЗаполнено(ВалютаПоступления) Тогда
		Если ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			Курс = 1;
			Кратность = 1;
		Иначе
			КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(ДанныеЗаполнения.ВалютаДокумента, ДатаПервичногоДокумента);
			Курс = КурсКратность.Курс;
			Кратность = КурсКратность.Кратность;
		КонецЕсли;	
	Иначе
		ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
		Курс = 1;
		Кратность = 1;
	КонецЕсли;
	
	ЗаполнятьСведенияОС = Ложь;
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокОСЭДПоставщикаДляПринятияКУчету(ТипДокументаУчета, ДокументОснование);
		ЗаполнятьСведенияОС = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 4 Тогда
			НоваяСтрока = ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ОсновноеСредство = СтрокаТЧ.Номенклатура;
			НоваяСтрока.Сумма = СтрокаТЧ.Всего;
			
			Если СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.ОС
				ИЛИ СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
				НоваяСтрока.СчетУчетаОС = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("108.52");
			ИначеЕсли СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
				НоваяСтрока.СчетУчетаОС = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("108.54");
			ИначеЕсли СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.НПА Тогда 
				НоваяСтрока.СчетУчетаОС = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("108.55");
			КонецЕсли;
			
			Если ЗаполнятьСведенияОС Тогда
				НоваяСтрока.СуммаАмортизации = СтрокаТЧ.СуммаАмортизации;
				НоваяСтрока.ДатаВводаВЭксплуатацию = СтрокаТЧ.ДатаВводаВЭксплуатацию;
				
				СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "АмортизационнаяГруппа"));
				
				НоваяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
				
				НоваяСтрока.ОставшийсяСрокПолезногоИспользования =
					УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
						НоваяСтрока.ДатаВводаВЭксплуатацию,
						НоваяСтрока.СрокПолезногоИспользования,
						ТекущаяДата());
				
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма"); 
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		Если ДанныеЗаполнения.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Для ответного акта нельзя ввести документ данного типа.'");

			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;	
	КонецЕсли;
	
	КодВидаОперации = ДанныеЗаполнения.КодВидаОперации;

	Если КодВидаОперации = НСтр("ru = 'ПередачаКапвложений'") Тогда
		Возврат;	
	КонецЕсли;	
	
	ВидПоступления = Перечисления.ВидыОперацийИК.Поступление;
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовИК;
	
	Организация = ДанныеЗаполнения.Организация;
	ДокументОснование = ДанныеЗаполнения;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	ПервичныйДокумент = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");
	
	КФО = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("КВД", ДанныеЗаполнения.КФОУОтправителя, Истина);
	ВидИмущества = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ВидыИмущества", ДанныеЗаполнения.КодВидаИмуществаУОтправителя, Истина);
	ВалютаПоступления = Справочники.Валюты.НайтиПоКоду(ДанныеЗаполнения.КодВалюты);
	НФАПереданыЭлектроннымАктом = Истина;
	ИспользуемыеИдентификаторы = Новый Массив;

	ОсновныеСредства.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаполнения.ПереданныеНФА Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		НоваяСтрока.ОсновноеСредство = ТекСтрока.НФА;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.БалансоваяСтоимость;
		НоваяСтрока.СуммаАмортизации = ТекСтрока.СуммаНачисленнойАмортизации;
		НоваяСтрока.СуммаОбесценения = ТекСтрока.СуммаНачисленногоОбесценения;
		НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;	
		
		НоваяСтрока.КПС = БухгалтерскиеОперации.КПСПоКоду(ТекСтрока.КодКПСУОтправителя, Дата);
		
		СчетУчетаОС = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		Если ЗначениеЗаполнено(ТекСтрока.КодСчетаУчетаУОтправителя) Тогда
			КодСчетаОтправителяСтр = Сред(ТекСтрока.КодСчетаУчетаУОтправителя,1,3);
			КодСчетаОтправителя = Число(КодСчетаОтправителяСтр);
			Если КодСчетаОтправителя = 101 Тогда
				СписокСчетовОС = БухгалтерскийУчет.СписокСчетов("101.11,101.12,101.13,101.15,101.17,101.18,101.22,101.23,101.32,101.33", Дата, , Организация);
				СчетУчетаОСУОтправителя = БухгалтерскиеОперации.СчетПоКоду(ТекСтрока.КодСчетаУчетаУОтправителя, Дата);
				Если НЕ СписокСчетовОС.Найти(СчетУчетаОСУОтправителя) = Неопределено Тогда
					СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду("108.51", Дата);
				КонецЕсли;	
			ИначеЕсли КодСчетаОтправителя = 102 Тогда
				СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду("108.54", Дата);
			ИначеЕсли КодСчетаОтправителя = 103 Тогда
				СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду("108.55", Дата);
			ИначеЕсли КодСчетаОтправителя = 108 Тогда
				СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду(ТекСтрока.КодСчетаУчетаУОтправителя, Дата);
			Иначе
				СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду("108.52", Дата);
			КонецЕсли;	
		КонецЕсли;	
		
		НоваяСтрока.СчетУчетаОС = СчетУчетаОС;
		
		НоваяСтрока.ДатаВводаВЭксплуатацию = ТекСтрока.ДатаВводаВЭксплуатациюУОтправителя;
		НоваяСтрока.СрокПолезногоИспользования = ТекСтрока.СрокПолезногоИспользованияУОтправителя;
		
		ОставшийсяСрокПолезногоИспользования = ТекСтрока.СрокПолезногоИспользованияУОтправителя - ТекСтрока.ФактическийСрокЭксплуатацииУОтправителя;
		НоваяСтрока.ОставшийсяСрокПолезногоИспользования = ?(ОставшийсяСрокПолезногоИспользования < 0, 0, ОставшийсяСрокПолезногоИспользования);

		Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
КонецПроцедуры

// Заполнить по входящему извещению.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.ИзвещениеВходящее -
//
Процедура ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения)
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, Поставщик, Договор, ИФО");
	
	Дата 				= ОбщегоНазначения.ТекущаяДатаПользователя();
	ДокументОснование 	= ДанныеЗаполнения;
	Организация 		= ДанныеОснования.Организация;
	ИФО 				= ДанныеОснования.ИФО;
	КФО 				= Перечисления.КВД.Бюджет;
	Контрагент 			= ДанныеОснования.Поставщик;
	Договор 			= ДанныеОснования.Договор;
	ВидПоступления 		= Перечисления.ВидыОперацийИК.Поступление;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеВходящееОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзвещениеВходящееОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ИзвещениеВходящееОсновныеСредства.Количество КАК Количество,
	|	ИзвещениеВходящееОсновныеСредства.Сумма КАК Сумма,
	|	ИзвещениеВходящееОсновныеСредства.Сумма КАК СуммаВВалюте
	|ИЗ
	|	Документ.ИзвещениеВходящее.ОсновныеСредства КАК ИзвещениеВходящееОсновныеСредства
	|ГДЕ
	|	ИзвещениеВходящееОсновныеСредства.Ссылка = &Ссылка
	|	И ИзвещениеВходящееОсновныеСредства.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ВыборкаОсновныеСредства = Запрос.Выполнить().Выбрать();
	Пока ВыборкаОсновныеСредства.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаОсновныеСредства);
		НоваяСтрока.СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
			ВыборкаОсновныеСредства.АмортизационнаяГруппа);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения)
	ДокОснование = ДанныеЗаполнения.ДокументОснование;
	Разделитель = ДанныеЗаполнения.Разделитель;   
	
	ДокументОснование = ДокОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Разделитель);
	
	СсылкаЦелевогоДокумента = Неопределено;
	Если ДанныеЗаполнения.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = ДанныеЗаполнения.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.НФА КАК ОсновноеСредство,
	|	ДанныеИнвентаризации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта В (6, 7)
	|	И ДанныеИнвентаризации.ЦМОРаздела4 = &ЦМО
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Запрос.УстановитьПараметр("ЦМО", Разделитель.ЦМО);
	Выборка = Запрос.Выполнить().Выбрать();    
	
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Организация, Дата, Номер");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование,, "Номер");
	Дата = НачалоДня(Дата);  
	ВидПоступления = Перечисления.ВидыОперацийИК.Поступление;
	ВидИмущества = Перечисления.ВидыИмущества.Казна;
	
	ИдентификаторИнвОписи = "Форма0510466";
	ОснованиеДляАкта = ПервичныеДокументыБГУ
		.ПредставленияПервичныхДокументов(ИдентификаторИнвОписи)[ИдентификаторИнвОписи].ПредставлениеФормы;
	НомерОснованияДляАкта = ОбщегоНазначенияБГУ
		.ПолучитьНомерДляПечатиПоНастройке(ДокОснование, ДанныеДокОснование.Номер);
	ДатаОснованияДляАкта = ДанныеДокОснование.Дата;
	
	ОсновныеСредства.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		УправлениеОсновнымиСредствами.УстановитьСрокПолезногоИспользованияВСтрокеТЧ(
			НоваяСтрока, "ПринятиеКУчетуОбъектовИК");
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
