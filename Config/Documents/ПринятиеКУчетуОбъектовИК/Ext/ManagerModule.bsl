#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление);
	Если ОперацииСоСчетом106.Найти(ДокументОбъект.ВидПоступления) = Неопределено 
		ИЛИ НЕ ДокументОбъект.ОтразитьВКарточкеКапвложений Тогда
		Возврат Истина;	
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Стоимость вложений"" включен флажок 
		|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;	
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДокументОбъект.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;

	Возврат Истина;
КонецФункции	

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДокументов - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументОбъект.ПринятиеКУчетуОбъектовОС
//  МЗПоСебестоимости - Булево - не используется для печати ОС
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, МЗПоСебестоимости = Ложь) Экспорт
	Документы.ПринятиеКУчетуОбъектовОС.ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, МЗПоСебестоимости);
КонецПроцедуры

Функция ВОсВнутреннимПеремещением() Экспорт
	ВОсВнутреннимПеремещением = Новый Массив;
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда"));
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование"));
	ВОсВнутреннимПеремещением.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратУправление"));
		
	Возврат ВОсВнутреннимПеремещением;
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Принятие к учету объектов ОС (ИК)" 
// на основании одного документа 
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА  - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.ПринятиеКУчетуОбъектовИК - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- ТаблицаЗначений с полями:
//  * ЦМО - ДокументСсылка.ЦМО
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт  
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Ссылка.ДокументОснование КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ОсновныеСредства.Количество КАК Количество
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &ПринятиеКУчетуОбъектовИКСсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

// Определяет, возможны ли гарантийные обязательства для указанной операции.
//
// Параметры:
//   ВидОперации - ПеречислениеСсылка.ВидыОперацийПринятияКУчетуОС - вид поступления для проверки возможности 
//   	гарантийных обязательств поставщика для переданного вида поступления.
//
// Возвращаемое значение:
//   Булево - Истина, если возможны гарантийные обязательства, иначе Ложь
Функция ВозможныГарантийныеОбязательства(ВидОперации) Экспорт
	ВО_ПринятиеКУчетуИзготовление = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление");	
	ВО_Поступление = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление");	

	МассивВО = Новый Массив;
	МассивВО.Добавить(ВО_Поступление);
	МассивВО.Добавить(ВО_ПринятиеКУчетуИзготовление);
	Возврат(МассивВО.Найти(ВидОперации) <> Неопределено);
КонецФункции	

#КонецОбласти

#Область ПроведениеДокумента


Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
		"Дата, Номер, Организация, ВидПоступления, ЦМО, ВнеоборотныйАктив, 
		|ЦМООтправитель, Подразделение, ПодразделениеОтправитель, ВидМежотчетногоПериода, ПервичныйДокумент");
	
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ЗначенияРеквизитов.ВидПоступления);
	НомерДокументаПоНастройке = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер);
	
	ЭтоВозвратЗемлиИзПользования = (
		ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратЗемУчастковИзПользования); 
	
	Если ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.Поступление
		Или ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление Тогда
		ДатаУП = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВидМежотчетногоПериода), 
			КонецГода(ЗначенияРеквизитов.Дата) + 1, ЗначенияРеквизитов.Дата);	
		УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(ЗначенияРеквизитов.Организация, ДатаУП);
		НачислятьАмортизацию = УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
	Иначе
		НачислятьАмортизацию = Ложь;
	КонецЕсли;
	
	УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям();  

	// Определим необходимость перемещения между ЦМО
	ПереместитьСтоимостьПоЦМО = Ложь;
	ВОсВнутреннимПеремещением = ВОсВнутреннимПеремещением();
	Если (ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМО) И ЗначениеЗаполнено(ЗначенияРеквизитов.ЦМООтправитель)
		И ЗначенияРеквизитов.ЦМО <> ЗначенияРеквизитов.ЦМООТправитель
		ИЛИ
		ЗначениеЗаполнено(ЗначенияРеквизитов.Подразделение) И ЗначениеЗаполнено(ЗначенияРеквизитов.ПодразделениеОтправитель)
		И ЗначенияРеквизитов.Подразделение <> ЗначенияРеквизитов.ПодразделениеОТправитель) 
		И ВОсВнутреннимПеремещением.Найти(ЗначенияРеквизитов.ВидПоступления) <> Неопределено Тогда
		
		ПереместитьСтоимостьПоЦМО = Истина;
	КонецЕсли;	
	
	МассивСчетовМЦ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Основные средства");
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Номенклатура");
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка" , ДокументСсылка);
	
	ИмяДокумента = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ПервичныйДокумент)
		И ЗначенияРеквизитов.ПервичныйДокумент <> 
			Справочники.ПервичныеДокументы.НайтиПоРеквизиту("Идентификатор", "ДокументКонтрагента_Служебный"),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитов.ПервичныйДокумент, "ВидПервичногоДокумента"),
		НСтр("ru = 'Акт о приеме-передаче объектов нефинансовых активов'"));
	Запрос.УстановитьПараметр("ИмяДокумента", ИмяДокумента);
	
	Запрос.УстановитьПараметр("НомерДокумента"				, НомерДокументаПоНастройке);
	Запрос.УстановитьПараметр("ЭтоПоступлениеИзПользования"	, ЭтоПоступлениеИзПользования);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"		, УчетПоПодразделениям);
	Запрос.УстановитьПараметр("НачислятьАмортизацию"		, НачислятьАмортизацию);
	Запрос.УстановитьПараметр("Счета01"						, БухгалтерскийУчет.СписокСчетов("01"));
	Запрос.УстановитьПараметр("ЭтоВозвратЗемлиИзПользования", ЭтоВозвратЗемлиИзПользования);
	Запрос.УстановитьПараметр("ПереместитьСтоимостьПоЦМО"   , ПереместитьСтоимостьПоЦМО);
    Запрос.УстановитьПараметр("Организация"                 , ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ВнеоборотныйАктив"           , ЗначенияРеквизитов.ВнеоборотныйАктив);
    Запрос.УстановитьПараметр("Период"           			, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("МассивСчетовМЦ"				, МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ"			, МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ"			, МассивСубконтоМЗ);

	КодСчета =
		?(ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда, "25",
		?(ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратБезвозмездноеПользование, "26",
		?(ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратУправление, "24",
		"")));
	Запрос.УстановитьПараметр("УчетПоПодразделениямКонтрагент", ?(КодСчета = "", Ложь,
		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(КодСчета).УчетПоПодразделениям));
	
	ОперацииПоВосстановлениюВУчете = Новый Массив;
	ОперацииПоВосстановлениюВУчете.Добавить(Перечисления.ВидыОперацийИК.ВозвратЗемУчастковИзПользования);
	Запрос.УстановитьПараметр("ЭтоОперацииПоВосстановлениюВУчете", 
		ОперацииПоВосстановлениюВУчете.Найти(ЗначенияРеквизитов.ВидПоступления) <> Неопределено);
	Запрос.УстановитьПараметр("ВозможныГарантийныеОбязательства", 
		ВозможныГарантийныеОбязательства(ЗначенияРеквизитов.ВидПоступления));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыБУ(Запрос, НомераТаблиц);
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыБУ(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТ_Документ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_Таблица", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ПринятиеКУчетуОбъектовИК.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ПринятиеКУчетуОбъектовИК.Организация КАК Организация,
	|	ПринятиеКУчетуОбъектовИК.ВалютаПоступления КАК ВалютаПоступления,
	|	ПринятиеКУчетуОбъектовИК.Курс КАК Курс,
	|	ПринятиеКУчетуОбъектовИК.Кратность КАК Кратность,
	|	ПринятиеКУчетуОбъектовИК.ВидПоступления КАК ВидПоступления,
