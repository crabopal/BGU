// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.РасшифровкаВнесенныхЧерезБанкоматСредств";
	КомандаПечати.Идентификатор = "ПФ_MXL_Форма0531251_22н";
	КомандаПечати.Представление = НСтр("ru = 'Расшифровка внесенных через банкомат средств (ф. 0531251)'");
	КомандаПечати.Порядок		= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.РасшифровкаВнесенныхЧерезБанкоматСредств";
	КомандаПечати.Идентификатор = "ПФ_MXL_Форма0531251";
	КомандаПечати.Представление = НСтр("ru = '(Устарела) Расшифровка внесенных через банкомат средств (ф. 0531251) (ред. 10н)'");
	КомандаПечати.Порядок		= 100;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.РасшифровкаВнесенныхЧерезБанкоматСредств";
	КомандаПечати.Идентификатор = "ПФ_MXL_Форма0531846";
	КомандаПечати.Представление = НСтр("ru = '(Устарела) Расшифровка внесенных через банкомат средств (ф. 0531846)'");
	КомандаПечати.Порядок		= 100;
	
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531251_22н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531251_22н",
			"Расшифровка внесенных через банкомат средств",
			ПечатьРасшифровки(МассивОбъектов, ОбъектыПечати, "0531251"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531846") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531846",
			"Расшифровка внесенных через банкомат средств",
			ПечатьРасшифровки(МассивОбъектов, ОбъектыПечати, "0531846"));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531251") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531251",
			"Расшифровка внесенных через банкомат средств",
			ПечатьРасшифровки(МассивОбъектов, ОбъектыПечати, "0531251_10н"));
	КонецЕсли;

КонецПроцедуры

