#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект); 
	
	НельзяПровести = НЕ (СуммаДокумента = Расшифровка.Итог("Сумма"));
	
	Если НельзяПровести Тогда
		ТекстСообщения = НСтр("ru='Проведение невозможно. Сумма документа не равна сумме расшифровки. Не распределена сумма: '") + Формат((СуммаДокумента - Расшифровка.Итог("Сумма")),"ЧДЦ=2");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СуммаДокумента", "Объект");
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НельзяПровести Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		ОбъектОснование = ДанныеЗаполнения.ПолучитьОбъект();
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбъектОснование,, "Номер,Дата,Ответственный,Проведен");
		ВидОперацииБанковскаяКарта = 1;
		
		МассивКФО = ОбъектОснование.РасшифровкаПлатежа.ВыгрузитьКолонку("КФО");
		
		ДанныеЛицевогоСчета = ПлатежноРасчетныеДокументы.ДанныеЛицевогоСчетаПоКФО(Организация, МассивКФО);
		
		ЛицевойСчет = ДанныеЛицевогоСчета.ЛицевойСчет;
		РеквизитыЛицевогоСчета = ДанныеЛицевогоСчета.РеквизитыЛицевогоСчета;
		ОрганКазначейства = ДанныеЛицевогоСчета.ОрганФК;
		
		СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Дата); 	
	
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Дата); 		
			ПерваяПодпись 		  = СвойстваЛицевогоСчета.ПерваяПодпись;
			ВтораяПодпись 		  = СвойстваЛицевогоСчета.ВтораяПодпись;
			ПерваяПодписьДолжность = СвойстваЛицевогоСчета.ПерваяПодписьДолжность;
			ВтораяПодписьДолжность = СвойстваЛицевогоСчета.ВтораяПодписьДолжность;
		КонецЕсли;
		
		Для Каждого СтрОсн ИЗ ОбъектОснование.РасшифровкаПлатежа Цикл
			
			Стр = Расшифровка.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, СтрОсн);
			
			ИсточникПоКФО = ДанныеЛицевогоСчета.РазделыИКФО.НайтиСтроки(Новый Структура("КФО", Стр.КФО));
			Если ИсточникПоКФО.Количество() > 0 Тогда
				Стр.ИсточникСредств = ИсточникПоКФО[0].ИсточникСредств;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли



