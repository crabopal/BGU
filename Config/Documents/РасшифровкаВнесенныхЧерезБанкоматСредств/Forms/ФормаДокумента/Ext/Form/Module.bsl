&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.РасшифровкаВнесенныхЧерезБанкоматСредств", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция УстановитьДолжность(Знач Подпись, ПодписьПечататьДолжность, Дата)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДолжностьСотрудника(Подпись, ПодписьПечататьДолжность, Дата);
КонецФункции

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец, КассовыйОрган");
	Объект.ЛицевойСчет 				= РеквизитыОбъекта.Владелец;
	Объект.ОрганКазначейства		= РеквизитыОбъекта.КассовыйОрган;
	
   	ПриИзмененииЛицевогоСчета();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;
	
	СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата); 	
	ДопустимыеИсточникиСредств 	= ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет);
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		Объект.ПерваяПодпись 				= СвойстваЛицевогоСчета.ПерваяПодпись;
		Объект.ВтораяПодпись 				= СвойстваЛицевогоСчета.ВтораяПодпись;
		Объект.ПерваяПодписьДолжность		= СвойстваЛицевогоСчета.ПерваяПодписьДолжность;
		Объект.ВтораяПодписьДолжность		= СвойстваЛицевогоСчета.ВтораяПодписьДолжность;
	Иначе
		Объект.ПерваяПодписьДолжность         	= "";
		Объект.ВтораяПодписьДолжность		  	= "";
		Объект.ОрганКазначейства				= "";
	КонецЕсли;	
	
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	Элементы.РасшифровкаИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	Для Каждого Стр Из Объект.Расшифровка Цикл
		Если ДопустимыеИсточникиСредств.Найти(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				Стр.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьИсточникСредств(ДатаОбъекта) 
	
	Если ДатаОбъекта >= Дата('20130101000000') тогда
		Элементы.ИсточникСредств.Видимость 				= Ложь;
		Элементы.РасшифровкаИсточникСредств.Видимость 	= Истина;
	Иначе
		Элементы.ИсточникСредств.Видимость 				= Истина;
		Элементы.РасшифровкаИсточникСредств.Видимость 	= Ложь;
	КонецЕсли;	
	
КонецПРоцедуры	

