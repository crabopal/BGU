
&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ФормаДлительнойОперации, МассивИменФайлов, СписокФайлов, СписокИменФайлов, ИзНихКаталогов;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Задание         = ЭтаФорма.Параметры.Задание; 	
	КаталогЗагрузки = ЭтаФорма.Параметры.КаталогЗагрузки; 
	ВидОбмена       = ЭтаФорма.Параметры.ВидОбмена;
	КаталогВыгрузки = ЭтаФорма.Параметры.КаталогЗагрузки;
	
	Если ПустаяСтрока(КаталогЗагрузки) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Каталог загрузки>> в настройках обмена'"));
		Отказ = Истина;
	КонецЕсли;  	
	
КонецПроцедуры    

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбщиеВнутренниеДанные = Новый Соответствие;   
	ПодобратьФайлыДляДекодирования();
	
КонецПроцедуры

&НаКлиенте
Процедура КатологВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУстановкеРасширенияРаботыСФайлами", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(Оповещение,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУстановкеРасширенияРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если РасширениеПодключено Тогда     
		
		СтандартнаяОбработка = Ложь;
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыбора.Каталог = КаталогВыгрузки;
		ДиалогВыбора.Показать(Новый ОписаниеОповещения("ПослеВопросаОбУстановкеРасширенияРаботыСФайламиЗавершение", ЭтотОбъект, Новый Структура("ДиалогВыбора", ДиалогВыбора)));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУстановкеРасширенияРаботыСФайламиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда   
		
		ДиалогВыбора = ДополнительныеПараметры.ДиалогВыбора;
		КаталогВыгрузки = ДиалогВыбора.Каталог; 
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьВременныеФайлы() 
	
	Для каждого Строка Из ТаблицаФайлов Цикл
		
		УдалитьФайлы(Строка.ВременныйФайл); 
		
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	УдалитьВременныеФайлы();	

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьПометки(Команда)
	УстановитьСнятьФлажки(ТаблицаФайлов,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	УстановитьСнятьФлажки(ТаблицаФайлов,Истина);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловИмяФайлаБезПодписиОткрытие(Элемент, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь; 
	СодержимоеФайла      = ОпределитьСодержимоеФайла(Элемент.ТекстРедактирования);
	
	ПараметрыФормы       = Новый Структура("ТекстФайла", СодержимоеФайла);
	ПараметрыФормы.Вставить("Заголовок", "Содержимое декодированного файла"); 
	
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраXML", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры  

&НаСервере
Функция ПолучитьМассивФайлов() 
	
	ВладелецФайла 	    = Задание.Ссылка;
	МассивФайлов 	    = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайла, МассивФайлов);
	НовыйМассивФайлов 	= Новый Массив;      
		
	Попытка
		КодировкаТекстаФайла	= КодировкаТекста[Задание.ВидОбмена.КодировкаТекстаФайла]
	Исключение
		КодировкаТекстаФайла    = Задание.ВидОбмена.КодировкаТекстаФайла;
	КонецПопытки;
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл   
		
		ИнформацияОФайле = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);
		
		ДвоичныеДанные   = ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла);
		
		Если ЭтоАдресВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла) Тогда
			
			ВременныйКаталог = КаталогВременныхФайлов();
	        ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
			
			ИмяВременногоФайла = ВременныйКаталог + ИнформацияОФайле.ИмяФайла;
			ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
			
			ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
			СодержимоеФайла = ТекстовыйФайл.Прочитать();
			ТекстовыйФайл.Закрыть();
			УдалитьФайлы(ИмяВременногоФайла);  
			
		КонецЕсли;   
				
		Если Найти(СодержимоеФайла, "SigValue") > 0 Тогда
			НовыйМассивФайлов.Добавить(ПрисоединенныйФайл)
		КонецЕсли;  
				
	КонецЦикла;	
	
	Возврат НовыйМассивФайлов;
	
КонецФункции


&НаКлиенте
Процедура Сохранить(Команда)
	
	ТекстОшибки = "";
	
	ДополнительныеПараметры = Новый Структура; 
	ДополнительныеПараметры.Вставить("МассивФайлов", ПолучитьМассивФайлов());
	
	ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(Задание, НастройкаОбменаИзЗадания(Задание), КаталогВыгрузки, ТекстОшибки, УникальныйИдентификатор, ДополнительныеПараметры);
		
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции       

&НаСервереБезКонтекста
Процедура СделатьЗаписьВЖурналеРегистрации(СписокОшибок)
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СписокОшибок);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокФайлов(СписокФайловВКаталоге, ДополнительныеПараметры = Неопределено) Экспорт
	
	СписокФайлов     = СписокФайловВКаталоге;
	МассивИменФайлов = Новый Массив;
	ИзНихКаталогов   = 0;
	
	Для каждого ТекФайл Из СписокФайлов Цикл				
		Оповещение = Новый ОписаниеОповещения(
					"ПослеПроверкиНаКаталог", ЭтотОбъект, СократитьИмяФайла(ТекФайл.Имя));
		ТекФайл.НачатьПроверкуЭтоКаталог(Оповещение);
		
	КонецЦикла; 
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиНаКаталог(ЭтоКаталог, ИмяФайла) Экспорт
	
	Если ЭтоКаталог Тогда
		ИзНихКаталогов = ИзНихКаталогов + 1;
		Возврат;
	КонецЕсли;
	
	МассивИменФайлов.Добавить(ИмяФайла);
	
	Если МассивИменФайлов.Количество() + ИзНихКаталогов <> СписокФайлов.Количество() Тогда
		Возврат; // ждем завершения проверки всех файлов на каталоги
	КонецЕсли;
	
	МассивПроверенныхФайлов = ПроверитьИменаФайловНаСервере(МассивИменФайлов);
	
	Если МассивПроверенныхФайлов.Количество()=0 Тогда
		ТекстСообщения = НСтр("ru='Не найдено файлов, соответствующих условию'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПомещаемыеФайлы     = Новый Массив;
	МассивИменФайлов    = Новый Массив;
	МассивАдресовФайлов = Новый Массив;
	
	Для каждого ТекФайл Из СписокФайлов Цикл
		Если МассивПроверенныхФайлов.Найти(СократитьИмяФайла(ТекФайл.Имя))<>Неопределено Тогда
			ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ТекФайл.ПолноеИмя));
		КонецЕсли;
	КонецЦикла; 
	
	ПомещенныеФайлы = Новый Массив;
	
	Попытка
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниям", ЭтотОбъект); 
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы, , Ложь, УникальныйИдентификатор);
	Исключение
		ОписаниеОшибки = НСтр("ru='Ошибка передачи файлов на сервер. Подробности в журнале регистрации'");
		СписокОшибок   = Новый СписокЗначений;  
		СписокОшибок.Добавить(Новый Структура(	"ИмяСобытия, ПредставлениеУровня, Комментарий", 
												"Задание на импорт данных.Передача файлов",
												"Ошибка",
												ОписаниеОшибки()));
		СделатьЗаписьВЖурналеРегистрации(СписокОшибок);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниям(ПомещенныеФайлы);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокФайловМножественный()
	
    ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСписокФайлов", ЭтотОбъект); 
	НачатьПоискФайлов(ОписаниеОповещения, КаталогЗагрузки, "*.???", Истина);
	
КонецПроцедуры // ЗаполнитьСписокФайловМножественный()

&НаСервере
Функция ПроверитьИменаФайловНаСервере(МассивИменФайлов, ОчищатьТаблицуФайлов = Ложь)
		
	СхемаПроверки = БиблиотекаФункцийОбмена.СоздатьСхемуПроверкиИменФайлов(МассивИменФайлов, ВидОбмена, Задание.Организация);

	МассивПроверенныхФайлов = БиблиотекаФункцийОбмена.ПроверитьМассивФайловПоПравилу(МассивИменФайлов, СхемаПроверки, Задание);
	
	Возврат МассивПроверенныхФайлов;
	
КонецФункции // ПроверитьИменаФайловНаСервере()

&НаКлиентеНаСервереБезКонтекста
Функция СократитьИмяФайла(Знач ВыбранноеИмяФайла)

	Поз = Макс(Найти(ВыбранноеИмяФайла, "/"), Найти(ВыбранноеИмяФайла, "\"));
	Пока Поз>0 Цикл
		ВыбранноеИмяФайла = Сред(ВыбранноеИмяФайла, Поз+1);
		Поз = Макс(Найти(ВыбранноеИмяФайла, "/"), Найти(ВыбранноеИмяФайла, "\"));
	КонецЦикла;
	Возврат ВыбранноеИмяФайла;

КонецФункции // СократитьИмяФайла()

&НаКлиенте
Процедура ЗаполнитьСписокФайловБезУстановкиРасширения()

	МассивАдресовФайлов = Новый Массив;
	СписокИменФайлов    = Новый Структура;
		
	ОчиститьСообщения();
	
	ОписаниеОповещения                = Новый ОписаниеОповещения("ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниям", ЭтотОбъект); 
	ОписаниеОповещенияПередПомещением = Новый ОписаниеОповещения("ПрисвоитьФайламИмя", ЭтотОбъект); 
	
	Диалог                            = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    НачатьПомещениеФайлов(ОписаниеОповещения, Диалог, Истина, УникальныйИдентификатор)
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПрисоединенныеФайлы(МассивФайлов)
	
	УстановитьПривилегированныйРежим(Истина);
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		
		ПрисоединенныйФайл.ПолучитьОбъект().Удалить();			
			
	КонецЦикла; 
	
КонецПроцедуры	  

&НаКлиенте
Процедура ПрисвоитьФайламИмя(ПомещаемыеФайлы, Отказ, ДополнительныеПараметры = Неопределено) Экспорт

	Если Отказ Тогда
		Возврат
	КонецЕсли;
	
	Для каждого Файл Из ПомещаемыеФайлы Цикл
		СписокИменФайлов.Вставить("Инд_" + СтрЗаменить(Файл.ИдентификаторФайла, "-", "_"), Файл.Имя);
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниям(МассивОписаний, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(СписокИменФайлов) И (ДополнительныеПараметры = Неопределено) Тогда
		
		ДополнительныеПараметры = Новый Структура("СписокИменФайлов", Новый Структура);
		
		Для каждого ИмяФайла Из СписокИменФайлов Цикл
			ДополнительныеПараметры.СписокИменФайлов.Вставить(ИмяФайла.Ключ, ИмяФайла.Значение)
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниямСервер(МассивОписаний, ДополнительныеПараметры);
		
КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьПодключениеРасширенияРаботыСФайлами(Подключено, ДопПараметры) Экспорт
	
	Если Подключено Тогда		
		ЗаполнитьСписокФайловМножественный();				
	Иначе		
		ЗаполнитьСписокФайловБезУстановкиРасширения();	
	КонецЕсли;
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуЗагружаемыхФайловПоОписаниямСервер(МассивОписаний, ДополнительныеПараметры) 
		
	Если МассивОписаний = Неопределено Тогда
		Возврат;
	КонецЕсли;	   
	
	Попытка
		КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
	Исключение
		КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
	КонецПопытки;  
	
	ТаблицаФайловНаДекодирование = Новый ТаблицаЗначений; 
	ТаблицаФайловНаДекодирование.Колонки.Добавить("Использовать",         Новый ОписаниеТипов("Булево")); 
	ТаблицаФайловНаДекодирование.Колонки.Добавить("ИмяФайлаСПодписью",    Новый ОписаниеТипов("Строка"));
	ТаблицаФайловНаДекодирование.Колонки.Добавить("ИмяФайлаБезПодписи",   Новый ОписаниеТипов("Строка"));   
	ТаблицаФайловНаДекодирование.Колонки.Добавить("СодержимоеФайла",      Новый ОписаниеТипов("Строка"));  
	ТаблицаФайловНаДекодирование.Колонки.Добавить("ВременныйФайл",        Новый ОписаниеТипов("Строка"));
				
	ЕстьСписокИменФайлов = ?(ЗначениеЗаполнено(ДополнительныеПараметры), ДополнительныеПараметры.Свойство("СписокИменФайлов"), Ложь) И ЗначениеЗаполнено(ДополнительныеПараметры.СписокИменФайлов);
	
	Для каждого ТекОписание Из МассивОписаний Цикл
	
		ИмяФайла             = СократитьИмяФайла(ТекОписание.Имя);
		
		Если НЕ ЗначениеЗаполнено(ИмяФайла) И ЕстьСписокИменФайлов Тогда
			 ИмяФайла = ДополнительныеПараметры.СписокИменФайлов["Инд_" + СтрЗаменить(ТекОписание.ИдентификаторФайла, "-", "_")];
		КонецЕсли;
		
		ИмяВременногоФайла   = ПолучитьИмяВременногоФайла();
		ПолучитьИзВременногоХранилища(ТекОписание.Хранение).Записать(ИмяВременногоФайла);	
		
		ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
		СодержимоеФайла = ТекстовыйФайл.Прочитать();
		ТекстовыйФайл.Закрыть();
		
		Если Найти(СодержимоеФайла, "SigEnvelope") > 0 Тогда     
			
			Строка                    = ТаблицаФайловНаДекодирование.Добавить();
		
			Строка.ИмяФайлаСПодписью  = ИмяФайла;	
			Строка.ВременныйФайл      = ИмяВременногоФайла;
			Строка.Использовать       = Истина;  
			
        Иначе
		
			УдалитьФайлы(ИмяВременногоФайла);			
											 
		КонецЕсли;
	
	КонецЦикла;    
	
	Если ТаблицаФайловНаДекодирование.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Не найдено файлов с подписью!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);    
		
	Иначе
		
		ЭтаФорма.Элементы.Декодировать.Доступность = Истина;
		
	КонецЕсли;
		
	ЭтаФорма.ТаблицаФайлов.Загрузить(ТаблицаФайловНаДекодирование);

КонецПроцедуры 

&НаКлиенте
Процедура ПодобратьФайлыДляДекодирования()   
			
	ВыбранныеФайлы = Новый Массив;
	
	#Если ВебКлиент Тогда
				
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьПодключениеРасширенияРаботыСФайлами", ЭтотОбъект);
		ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения,
			НСтр("ru = 'Рекомендуется установить расширение для работы с файлами (не обязательное действие).'"), Истина);
		
		Возврат;
		
	#Иначе
		
		ЗаполнитьСписокФайловМножественный();	
		
	#КонецЕсли
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСнятьФлажки(Таблица, ЗначениеФлажка)
	
	Для Каждого СтрТаб Из Таблица Цикл
		СтрТаб.Использовать = ЗначениеФлажка;
	КонецЦикла;   
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьФайлыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
        
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ТекстОшибки = "";
	
		ДополнительныеПараметры = Новый Структура; 
		ДополнительныеПараметры.Вставить("МассивФайлов", "");
		
		ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(Задание, НастройкаОбменаИзЗадания(Задание), КаталогВыгрузкиИзЗадания(Задание), ТекстОшибки, УникальныйИдентификатор, ДополнительныеПараметры);
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоместитьФайлВПрисоединенные(АдресФайлаВоВременномХранилище, ИмяФайлаПередачи)  
	
	РаботаСФайлами.ДобавитьФайл(
	Новый Структура("ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, Автор, ВремяИзмененияУниверсальное",  
	Задание.Ссылка, 
	Лев(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") - 1),
	Сред(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") + 1), 
	ПользователиКлиентСервер.ТекущийПользователь(),
	УниверсальноеВремя(ТекущаяДатаСеанса())),     
	АдресФайлаВоВременномХранилище);	

КонецПроцедуры	

&НаСервереБезКонтекста
Функция НастройкаОбменаИзЗадания(ЗаданиеСсылка) 
	
	Возврат ЗаданиеСсылка.НастройкаОбмена;
	
КонецФункции   

&НаСервереБезКонтекста
Функция КаталогВыгрузкиИзЗадания(ЗаданиеСсылка) 
	
	Возврат ЗаданиеСсылка.КаталогВыгрузки;
	
КонецФункции 

&НаСервере
Функция ОпределитьСодержимоеФайла(ИмяФайла)
	
	Если ЗначениеЗаполнено(ИмяФайла) И ИмяФайла <> "Не открыт" Тогда  
		 		
		 Строки = ТаблицаФайлов.НайтиСтроки(Новый Структура("ИмяФайлаБезПодписи", ИмяФайла));
		 
		 Если Строки.Количество()> 0 Тогда 
			 Возврат Строки[0].СодержимоеФайла;
		 КонецЕсли;
		 
	КонецЕсли;	 
	
КонецФункции	

&НаСервере
Процедура ДекодироватьНаСервере() 
		
	ПостроительDOM = Новый ПостроительDOM;
	ЧтениеXML      = Новый ЧтениеXML;
	
	Для каждого Строка Из ТаблицаФайлов Цикл    
		
		Если НЕ Строка.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		ЧтениеXML.ОткрытьФайл(Строка.ВременныйФайл);    
		ДокументDOM             = ПостроительDOM.Прочитать(ЧтениеXML);  
		ЗакодированноеСообщение = ДокументDOM.ПолучитьЭлементыПоИмени("Object");
	
		Если ЗакодированноеСообщение.Количество() > 0 Тогда  
		
			СодержимоеСообщения = Base64Значение(ЗакодированноеСообщение[0].ТекстовоеСодержимое); 
		
			Если ЗначениеЗаполнено(СодержимоеСообщения) Тогда
				
				ВременныйФайл       = ПолучитьИмяВременногоФайла();
		        СодержимоеСообщения.Записать(ВременныйФайл);      
						
				Попытка
					КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
				Исключение
					КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
				КонецПопытки;  
				
				Чтение              = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекстаФайла);
		        СодержимоеСообщения = Чтение.Прочитать();
				
				Если ЗначениеЗаполнено(СодержимоеСообщения) Тогда
					ЧтениеXML.УстановитьСтроку(СодержимоеСообщения);
				КонецЕсли; 
				
			
				ДвоичныеДанные 					       = Новый ДвоичныеДанные(ВременныйФайл);
				АдресФайлаВоВременномХранилище 	       = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
				
				ПоместитьФайлВПрисоединенные(АдресФайлаВоВременномХранилище, Строка.ИмяФайлаСПодписью);  

				
				Чтение.Закрыть();
				УдалитьФайлы(ВременныйФайл);   
				
		        Строка.СодержимоеФайла    = СодержимоеСообщения;
				Строка.ИмяФайлаБезПодписи = Строка.ИмяФайлаСПодписью;   
				
			Иначе
				
				Строка.ИмяФайлаБезПодписи = "Не открыт";
				
			КонецЕсли;
			
		КонецЕсли;	
			
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура Декодировать(Команда)  
	
	Отказ = Ложь;

	СтрокиИстина = ТаблицаФайлов.НайтиСтроки(Новый Структура("Использовать", Истина));  
	
	Если СтрокиИстина.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбран ни один файл для декодирования'"),,"Объект.ТаблицаФайлов",, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	    
	
	УдалитьПрисоединенныеФайлы(ПолучитьМассивФайлов());
	
	ДекодироватьНаСервере();  
	
	Для Каждого Строка Из ТаблицаФайлов Цикл
		Если Строка.ИмяФайлаБезПодписи = Строка.ИмяФайлаСПодписью Тогда   
			
			 Элементы.КатологВыгрузки.Доступность = Истина;   
			 Элементы.Сохранить.Доступность       = Истина;
			 
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры


#КонецОбласти

