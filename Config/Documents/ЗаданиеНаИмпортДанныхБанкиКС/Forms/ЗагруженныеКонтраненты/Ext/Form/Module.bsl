

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТаблицаКонтрагентовПерем = ЗначениеИзСтрокиВнутр(ЭтаФорма.Параметры.ЗагруженныеКонтрагенты);
	
	Если ТипЗнч(ТаблицаКонтрагентовПерем) <> Тип("ТаблицаЗначений") Тогда
		Отказ = Истина;	
	КонецЕсли; 
		
	ПередаваемыеСведения = ТаблицаКонтрагентовПерем.Скопировать(, "Наименование, ИНН, КПП, КодПоРПБС, ЭтоФизическоеЛицо");
	ПередаваемыеСведения.Свернуть("Наименование, ИНН, КПП, КодПоРПБС, ЭтоФизическоеЛицо");
	
	ЭтаФорма.ЗагруженныеКонтрагенты.Загрузить(ПередаваемыеСведения);
	
	Для каждого Контрагент Из ЭтаФорма.ЗагруженныеКонтрагенты Цикл
		Контрагент.Загрузить = Истина;
	КонецЦикла;
	
	ЭтаФорма.ТаблицаКонтрагентов = ЗначениеВСтрокуВнутр(ТаблицаКонтрагентовПерем);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКонтрагентовНаСервере()
	
	ТаблицаКонтрагентовПерем = ЗначениеИзСтрокиВнутр(ЭтаФорма.ТаблицаКонтрагентов);
	
	Для каждого Контрагент Из ЭтаФорма.ЗагруженныеКонтрагенты Цикл
		
		Если НЕ Контрагент.Загрузить Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Контрагент.Контрагент) Тогда  
			
			 РеквизитыКонтрагента = Новый Структура;    
			 ФИО                  = ""; 
			 НовыйКонтрагент      = Справочники.Контрагенты.ПустаяСсылка();
			 
			 Если ЗначениеЗаполнено(Контрагент.Наименование) И (Найти(ВРЕГ(Контрагент.Наименование), "ИП ") > 0 ИЛИ Найти(НРЕГ(Контрагент.Наименование), "предприниматель") > 0) Тогда  
		
				к = Найти(ВРЕГ(Контрагент.Наименование), "ИП ");  
			    м = Найти(НРЕГ(Контрагент.Наименование), "предприниматель");
				
				Если к > 0 Тогда
					ФИО = Трег(СокрЛП(Сред(Контрагент.Наименование, к + 2)));
				ИначеЕсли м > 0 Тогда
				    ФИО = Трег(СокрЛП(Сред(Контрагент.Наименование, м + 15)));	
				КонецЕсли;	
				  
			КонецЕсли;	

            Если ЗначениеЗаполнено(ФИО)	Тогда
				ФИО = ТРег(ФИО);
				СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ФИО);
				РеквизитыКонтрагента.Вставить("Фамилия", СтруктураФИО.Фамилия);
				РеквизитыКонтрагента.Вставить("Имя", СтруктураФИО.Имя);		
				РеквизитыКонтрагента.Вставить("Отчество", СтруктураФИО.Отчество);
			КонецЕсли;	
			
			РеквизитыКонтрагента.Вставить("ИНН",                      Контрагент.ИНН);
			РеквизитыКонтрагента.Вставить("КПП",                      Контрагент.КПП);  
			РеквизитыКонтрагента.Вставить("Наименование",             ?(ЗначениеЗаполнено(ФИО), ФИО, Контрагент.Наименование));
			РеквизитыКонтрагента.Вставить("НаименованиеСокращенное",  ?(ЗначениеЗаполнено(ФИО), ФИО, Контрагент.Наименование));
			РеквизитыКонтрагента.Вставить("КодПоРПБС",                Контрагент.КодПоРПБС);
			  
			Если Найти(ВРЕГ(Контрагент.Наименование), "ИП ") > 0 ИЛИ Найти(НРЕГ(Контрагент.Наименование), "предприниматель") > 0 Тогда 
				 РеквизитыКонтрагента.Вставить("ТипКонтрагента",   Справочники.ТипыКонтрагентов.НайтиПоКоду("6"));
				 РеквизитыКонтрагента.Вставить("НаименованиеСокращенное",  ТРег(Контрагент.Наименование));
			 
		    ИначеЕсли СтрДлина(Контрагент.ИНН) > 10 Или НЕ ЗначениеЗаполнено(Контрагент.ИНН) Тогда  
				РеквизитыКонтрагента.Вставить("ТипКонтрагента",   Справочники.ТипыКонтрагентов.НайтиПоКоду("7"))		
			КонецЕсли;
					
			ЭлектронныеДокументыБГУ.СоздатьКонтрагентаПоРеквизитам(РеквизитыКонтрагента, НовыйКонтрагент);
			
			Контрагент.Контрагент = НовыйКонтрагент;
			
		КонецЕсли;
		
		РепликиКонтрагента = ТаблицаКонтрагентовПерем.НайтиСтроки(Новый Структура("Наименование,             ИНН,           КПП,            КодПоРПБС,            ЭтоФизическоеЛицо",
		                                                                           Контрагент.Наименование, Контрагент.ИНН, Контрагент.КПП, Контрагент.КодПоРПБС, Контрагент.ЭтоФизическоеЛицо));
		ТекущаяСсылка  = "";	
		ДокументОбъект = "";
		
	    Для каждого Реплика Из РепликиКонтрагента Цикл
			Если ЗначениеЗаполнено(Реплика.ДокументСсылка) И ЗначениеЗаполнено(Реплика.ИмяРеквизита) Тогда
				 Если ТекущаяСсылка <> Реплика.ДокументСсылка Тогда
					 Если ДокументОбъект <> "" Тогда
						  ДокументОбъект.Записать();   //записываем предыдущий объект
					 КонецЕсли;
				 	 ДокументОбъект = Реплика.ДокументСсылка.ПолучитьОбъект();
					 ТекущаяСсылка  = Реплика.ДокументСсылка;
				 КонецЕсли;
				 Если ЗначениеЗаполнено(Реплика.ИмяТабличнойЧасти) Тогда
					 ДокументОбъект[Реплика.ИмяТабличнойЧасти][Реплика.НомерСтроки][Реплика.ИмяРеквизита] = Контрагент.Контрагент;
				 Иначе
					 ДокументОбъект[Реплика.ИмяРеквизита]                                                 = Контрагент.Контрагент;
				 КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
		Если ДокументОбъект <> "" Тогда
		    ДокументОбъект.Записать();   //записываем последний объект
		КонецЕсли;		
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКонтрагентов(Команда)
	
	ЗагрузитьКонтрагентовНаСервере();
	ЭтаФорма.Закрыть();
	
КонецПроцедуры
