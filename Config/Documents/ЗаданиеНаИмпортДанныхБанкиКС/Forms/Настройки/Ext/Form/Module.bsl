////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаписатьНастройкиПоУмолчанию(Параметры)
	
	НастройкиПоУмолчанию = РегистрыСведений.НастройкиОбменаБанкиКСПоУмолчанию.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(НастройкиПоУмолчанию, Параметры); 
		
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		НастройкиПоУмолчанию.Записать();
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка записи настроек. ""%1""'"), ОписаниеОшибки());			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
			
КонецПроцедуры

&НаСервере
Функция ПолучитьТипКассовогоОргана()

	Возврат ЭтаФорма.ВидОбмена.ТипКассовогоОргана;

КонецФункции

&НаКлиенте
Функция РеквизитыЗаполненыКорректно()
	
	СтатусВозврата = Истина;
	
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Тип обмена>>'"),, "ВидОбмена");
		СтатусВозврата = Ложь;	
	КонецЕсли; 
	
		
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НастройкаФорматов) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Настройка форматов>>'"),, "НастройкаФорматов");
		СтатусВозврата = Ложь;	
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НастройкаОбмена) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Настройка обмена>>'"),, "НастройкаОбмена");
		СтатусВозврата = Ложь;	
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(КассовыйОрган) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Кассовый орган>>'"),, "КассовыйОрган");
		СтатусВозврата = Ложь;	
	КонецЕсли; 

	Возврат СтатусВозврата;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка(), "ВидОбмена,НастройкаФорматов,НастройкаОбмена,КассовыйОрган,НастройкиПоУмолчанию,ОК");
	
	ВидОбмена 			= Параметры.ВидОбмена;
	Организация      	= Параметры.Организация;
	КассовыйОрган    	= Параметры.КассовыйОрган;
	НастройкаФорматов 	= Параметры.НастройкаФорматов;
	НастройкаОбмена		= Параметры.НастройкаОбмена;
	
	Если ЗначениеЗаполнено(ВидОбмена) Тогда
		
		Массив = Новый Массив;
		Если ЗначениеЗаполнено(ВидОбмена.ТипКассовогоОргана) Тогда
			Массив.Добавить(Тип(ВидОбмена.ТипКассовогоОргана));
		Иначе
			Массив.Добавить(Тип("СправочникСсылка.Банки"));
			Массив.Добавить(Тип("СправочникСсылка.Казначейства"));
		КонецЕсли;
		ОписаниеТипов  	= Новый ОписаниеТипов(Массив);
		Значение       	= КассовыйОрган;
		КассовыйОрган  	= ОписаниеТипов.ПривестиЗначение(Значение);
		Элементы.КассовыйОрган.ДоступныеТипы   = ОписаниеТипов;
		Элементы.КассовыйОрган.ОграничениеТипа = ОписаниеТипов;
	КонецЕсли;

КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВидОбменаПриИзменении(Элемент)
		
	НастройкаФорматов	= "";              
	НастройкаОбмена     = "";
	
	Если ЗначениеЗаполнено(ВидОбмена) Тогда
		
		Массив = Новый Массив;
		ТипКО = ПолучитьТипКассовогоОргана();
		Если ЗначениеЗаполнено(ТипКО) Тогда
			Массив.Добавить(Тип(ТипКО));
		Иначе
			Массив.Добавить(Тип("СправочникСсылка.Банки"));
			Массив.Добавить(Тип("СправочникСсылка.Казначейства"));
		КонецЕсли;

		ОписаниеТипов  	= Новый ОписаниеТипов(Массив);
		Значение       	= КассовыйОрган;
		КассовыйОрган  	= ОписаниеТипов.ПривестиЗначение(Значение);
		
		Элементы.КассовыйОрган.ДоступныеТипы   = ОписаниеТипов;
		Элементы.КассовыйОрган.ОграничениеТипа = ОписаниеТипов;
	Иначе
		
		КассовыйОрган  	= "";
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КассовыйОрганНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда
	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для корректного выбора кассового органа необходимо сначала заполнить поле <<Тип обмена>>'"),, "ВидОбмена");
		СтандартнаяОбработка = Ложь;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаФорматовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда
	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для корректного выбора настройки форматов необходимо сначала заполнить поле <<Тип обмена>>'"),, "ВидОбмена");
		СтандартнаяОбработка = Ложь;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОбменаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда
	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для корректного выбора настройки обмена необходимо сначала заполнить поле <<Тип обмена>>'"),, "ВидОбмена");
		СтандартнаяОбработка = Ложь;
	
	КонецЕсли; 
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	Если РеквизитыЗаполненыКорректно() Тогда
		
		ПараметрыЗакрытияФормы = Новый Структура("ВидОбмена, КассовыйОрган, НастройкаФорматов, НастройкаОбмена", 
		ВидОбмена, КассовыйОрган, НастройкаФорматов, НастройкаОбмена);
		
		Закрыть(ПараметрыЗакрытияФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиПоУмолчанию(Команда)
	
	Если РеквизитыЗаполненыКорректно() Тогда
		
		ПараметрыНастройки = Новый Структура("ВидОбмена, Организация, КассовыйОрган, НастройкаФорматов, НастройкаОбмена", 
		ВидОбмена, Организация, КассовыйОрган, НастройкаФорматов, НастройкаОбмена);
		
		ЗаписатьНастройкиПоУмолчанию(ПараметрыНастройки);
		
	КонецЕсли;	

КонецПроцедуры

