&НаКлиенте
Процедура ВопросОбОчисткеТЧ(РезультатОтвет, ДопПараметры) Экспорт
	Если РезультатОтвет = КодВозвратаДиалога.Да Тогда
		
		Объект.Компенсация.Очистить();
		
		Элемент = ДопПараметры.Элемент;
		Если Элемент.Имя = "Факультет" Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", Новый Структура("Организация", Объект.Организация));
			
			ОткрытьФорму("Справочник.Подразделения.ФормаВыбора", ПараметрыФормы, Элемент, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	УстановитьДоступностьФакультета(ЭтотОбъект);
	УстановитьВидимостьСчетаЗатрат(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьФакультета(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Факультет",
		"Доступность",
		ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСчетаЗатрат(Форма)

	ЭлементыВТаблице = Новый Массив;
	ЭлементыВТаблице.Добавить("КомпенсацияКФО");
	ЭлементыВТаблице.Добавить("КомпенсацияКПС");
	ЭлементыВТаблице.Добавить("КомпенсацияКЭК");

	ЭлементыВШапке = Новый Массив;
	ЭлементыВШапке.Добавить("КФО");
	ЭлементыВШапке.Добавить("КПС");
	ЭлементыВШапке.Добавить("КЭК");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ЭлементыВТаблице,
		"Видимость",
		Форма.Объект.АналитикаЗатратВКаждойСтроке);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ЭлементыВШапке,
		"Видимость",
		НЕ Форма.Объект.АналитикаЗатратВКаждойСтроке);

КонецПроцедуры

&НаКлиенте
Функция ЗаполнениеСтудентамиВозможно()
	
	ОчиститьСообщения();

	Отказ = Ложь;
	
	ПроверитьЗаполнениеПоля(Объект.ПериодНачисления, НСтр("ru='Период начисления'"), "ПериодНачисленияСтрокой", Отказ);
	ПроверитьЗаполнениеПоля(Объект.Организация,      НСтр("ru='Организация'"),       "Объект.Организация",      Отказ);
	ПроверитьЗаполнениеПоля(Объект.Факультет,        НСтр("ru='Факультет'"),         "Объект.Факультет",        Отказ);

	Возврат НЕ Отказ;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьЗаполнениеПоля(ЗначениеПоля, ЗаголовокПоля, ИмяПоля, Отказ)
	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		СообщитьОшибкуЗаполнения(ЗаголовокПоля, ИмяПоля, Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьОшибкуЗаполнения(ЗаголовокПоля, ИмяПоля, Отказ)
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,, ЗаголовокПоля),,
		ИмяПоля,,
		Отказ);		
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОчисткуТабличнойЧасти(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОткрытьФормуОтбора();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГраницыПериодаВСтроках()
	Для Каждого Стр Из Объект.Компенсация Цикл
		Стр.ПериодНачисленияНачало = НачалоМесяца(Объект.ПериодНачисления);
		Стр.ПериодНачисленияКонец = КонецМесяца(Объект.ПериодНачисления);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтбора()
	Адреса = ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище();

	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = НСтр("ru = 'Настройка параметров отбора учащихся'");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Адреса", Адреса);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСтудентамиПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы, ЭтаФорма, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище()
	
	Адреса = Новый Структура("СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных");
	
	СхемаКомпоновкиДанных = Документы.НачислениеКомпенсацииОбразование.ПолучитьМакет("СборДанныхНачислений");
	Адреса.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	Возврат Адреса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСтудентамиПоОтбору(Результат, ДопПараметры) Экспорт
	Адреса = ДопПараметры.Адреса;
	
	Если Результат <> Неопределено Тогда
		
		Адреса.НастройкиКомпоновкиДанных = Результат;
		ЗаполнитьСтудентамиСервер(Адреса);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтудентамиСервер(Адреса)
	
	Объект.Компенсация.Очистить();
		
	ПараметрыРасчета = РаботаСоСтудентами.ПолучитьСтруктуруПараметровРасчета();
	ПараметрыРасчета.Период = Объект.ПериодНачисления;
	ПараметрыРасчета.Факультет = Объект.Факультет;
	ПараметрыРасчета.НастройкиКомпоновкиДанных = Адреса.НастройкиКомпоновкиДанных;
	ПараметрыРасчета.ВидНачисления = "НачислениеКомпенсацииОбразование";	
	
	ПараметрыРасчета.Вставить("ИмяМакета", "СборДанныхНачислений");
	ПараметрыРасчета.Вставить("Организация",  Объект.Организация);
	
	ДанныеРасчета = РаботаСоСтудентами.РассчитатьНачисления(ПараметрыРасчета);
	Объект.Компенсация.Загрузить(ДанныеРасчета);
	
	ПроверитьДанныеДляНачисления();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДанныеДляНачисления()
	
	ШаблонПлательщик = НСтр("ru='Для студента ""%1"" не указан плательщик для периода расчета с %2 по %3'");
	
	Для каждого СтрокаНачисления Из Объект.Компенсация Цикл
			
		Если СтрокаНачисления.Контрагент.Пустая() Тогда
			
			ТекстОшибки = СтрШаблон(ШаблонПлательщик, 
				СтрокаНачисления.Студент, 
				Формат(СтрокаНачисления.ПериодНачисленияНачало, "ДЛФ=DD"),
				Формат(СтрокаНачисления.ПериодНачисленияКонец, "ДЛФ=DD"));
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Компенсация",
				СтрокаНачисления.НомерСтроки,
				"Контрагент");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , Поле, "Объект");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВСтроке(ИдентификаторСтроки)
	
	СтрокаТЧ = Объект.Компенсация.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	РассчитатьСтроку(Объект, СтрокаТЧ);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(Объект, СтрокаТЧ)
	
	СтрокаТЧ.Сумма = (СтрокаТЧ.СтавкаКомпенсацииЗаДень * СтрокаТЧ.КоличествоДней) + СтрокаТЧ.СтавкаКомпенсацииЗаПериод;
	
КонецПроцедуры

