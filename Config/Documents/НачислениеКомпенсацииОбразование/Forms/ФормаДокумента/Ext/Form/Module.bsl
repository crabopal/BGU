&НаКлиенте
Процедура ЗаполнитьСтудентами(Команда)
			
	Если НЕ ЗаполнениеСтудентамиВозможно() Тогда
		Возврат;
	КонецЕсли;
		
	Если Объект.Компенсация.Количество() > 0 Тогда
	
		ТекстСообщения = НСтр("ru='Табличная часть будет очищена.
			|Продолжить?'");
		
		Оповещение = Новый ОписаниеОповещения("ЗапроситьОчисткуТабличнойЧасти", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
	Иначе
		
		ОткрытьФормуОтбора();
		
	КонецЕсли;
		
КонецПроцедуры

