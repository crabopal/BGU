	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ПервичныйДокумент</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПоступлениеМЗ.Ссылка,
	ДокументПоступлениеМЗ.ВерсияДанных,
	ДокументПоступлениеМЗ.ПометкаУдаления,
	ДокументПоступлениеМЗ.Номер,
	ДокументПоступлениеМЗ.Дата,
	ДокументПоступлениеМЗ.Проведен,
	ДокументПоступлениеМЗ.Организация,
	ДокументПоступлениеМЗ.ИФО,
	ДокументПоступлениеМЗ.Подразделение,
	ВЫБОР
		КОГДА ДокументПоступлениеМЗ.ВидПоступленияМЗ = ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования)
			И ДокументПоступлениеМЗ.ПолучательИмущества &lt;&gt; ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			ТОГДА ДокументПоступлениеМЗ.ПолучательИмущества.Контрагент
		ИНАЧЕ ДокументПоступлениеМЗ.Контрагент
	КОНЕЦ КАК Контрагент,
	ДокументПоступлениеМЗ.Договор,
	ДокументПоступлениеМЗ.СуммаДокумента,
	ДокументПоступлениеМЗ.ВалютаДокумента,
	ДокументПоступлениеМЗ.Комментарий,
	ДокументПоступлениеМЗ.СуммаВключаетНДС,
	ДокументПоступлениеМЗ.ЦМО,
	ДокументПоступлениеМЗ.ВидПервичногоДокумента,
	ДокументПоступлениеМЗ.ДатаПервичногоДокумента,
	ДокументПоступлениеМЗ.НомерПервичногоДокумента,
	ДокументПоступлениеМЗ.Грузоотправитель,
	ДокументПоступлениеМЗ.Грузополучатель,
	ДокументПоступлениеМЗ.Доверенность,
	ДокументПоступлениеМЗ.СчетУчета,
	ДокументПоступлениеМЗ.ВидБезвозмездногоПользования,
	ДокументПоступлениеМЗ.МоментВремени,
	ДокументПоступлениеМЗ.ПервичныйДокумент,
	ДокументПоступлениеМЗ.Материалы.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Номенклатура КАК Номенклатура,
		КоличествоМест КАК КоличествоМест,
		Коэффициент КАК Коэффициент,
		Количество КАК Количество,
		Сумма КАК Сумма,
		СтавкаНДС КАК СтавкаНДС,
		СуммаНДС КАК СуммаНДС,
		Всего КАК Всего,
		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		НДСКРаспределению КАК НДСКРаспределению,
		СчетУчета КАК СчетУчета,
		ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
		КПС КАК КПС,
		ЦенаОприходования КАК ЦенаОприходования,
		ОтражениеВУСН КАК ОтражениеВУСН,
		УдалитьНоменклатураПоставщика КАК УдалитьНоменклатураПоставщика,
		КФО КАК КФО,
		КЭК КАК КЭК,
		СубконтоЗабалансовыйСчет1 КАК СубконтоЗабалансовыйСчет1,
		СубконтоЗабалансовыйСчет2 КАК СубконтоЗабалансовыйСчет2,
		СубконтоЗабалансовыйСчет3 КАК СубконтоЗабалансовыйСчет3,
		ИдентификаторСтроки КАК ИдентификаторСтроки,
		ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
		СтранаПроисхождения КАК СтранаПроисхождения,
		КоличествоДоКорректировки КАК КоличествоДоКорректировки,
		СуммаДоКорректировки КАК СуммаДоКорректировки,
		СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
		ВсегоДоКорректировки КАК ВсегоДоКорректировки,
		ВидимыеДефекты КАК ВидимыеДефекты,
		ОсобыеОтметки КАК ОсобыеОтметки
	) КАК Материалы,
	ДокументПоступлениеМЗ.ВозвратнаяТара.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Номенклатура КАК Номенклатура,
		Количество КАК Количество,
		Сумма КАК Сумма,
		СчетУчета КАК СчетУчета,
		ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
		КПС КАК КПС,
		ЦенаОприходования КАК ЦенаОприходования,
		УдалитьНоменклатураПоставщика КАК УдалитьНоменклатураПоставщика,
		КФО КАК КФО,
		КЭК КАК КЭК,
		КоличествоДоКорректировки КАК КоличествоДоКорректировки,
		СуммаДоКорректировки КАК СуммаДоКорректировки
	) КАК ВозвратнаяТара,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
