&НаКлиенте
Функция ОткрытьПодборМЗ()
	Возврат НомерЗабалансовогоСубконтоОС = 0;
КонецФункции

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(ВыбранноеЗначение)

	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	
	ДобавленныеСтроки = Новый Массив;
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоОС] = СтрокаОС.ОсновноеСредство;
		Если ЗначениеЗаполнено(НомерЗабалансовогоСубконтоЦМО) Тогда
			НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоЦМО] = СтрокаОС.ЦМО;
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерЗабалансовогоСубконтоДоп) Тогда
			Если ВидСубконтоЗабалансовогоСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоДоп] = СтрокаОС.Договор;
			ИначеЕсли ВидСубконтоЗабалансовогоСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоДоп] = СтрокаОС.Контрагент;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.Сумма = СтрокаОС.Сумма;
		НоваяСтрока.Количество = СтрокаОС.Количество;
		НоваяСтрока.ИнвентарныйНомер = СтрокаОС.ИнвентарныйНомер;
		ДобавленныеСтроки.Добавить(НоваяСтрока);
	КонецЦикла;
	
	Если ВидСубконтоЗабалансовогоСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
		ПараметрыЗаполненияДоговора = Новый Структура;
		ПараметрыЗаполненияДоговора.Вставить("НомерСубконтоОС", НомерЗабалансовогоСубконтоОС);
		ПараметрыЗаполненияДоговора.Вставить("НомерСубконтоДоговоры", НомерЗабалансовогоСубконтоДоп);
		Если Объект.Ссылка.Пустая() Тогда
			ПараметрыЗаполненияДоговора.Вставить("Период", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
		Иначе
			ПараметрыЗаполненияДоговора.Вставить("Период", Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
		КонецЕсли;
		ПараметрыЗаполненияДоговора.Вставить("Организация", Объект.Организация);
		ПараметрыЗаполненияДоговора.Вставить("ДобавленныеСтроки", ДобавленныеСтроки);
		ДополнительноЗаполнитьДоговор(ПараметрыЗаполненияДоговора);
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнительноЗаполнитьДоговор(ПараметрыЗаполненияДоговора);
	
	ИспользуемыеОС = Новый Массив;
	Для Каждого Строка Из ПараметрыЗаполненияДоговора.ДобавленныеСтроки Цикл
		ИспользуемыеОС.Добавить(Строка["СубконтоЗабалансовыйСчет" + ПараметрыЗаполненияДоговора.НомерСубконтоОС]);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&Период, Организация = &Организация
	|	И ВидРаспоряжения = &ВидРаспоряжения
	|	И ОсновноеСредство В (&ОсновныеСредства)) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки";
	Запрос.УстановитьПараметр("Период", ПараметрыЗаполненияДоговора.Период);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполненияДоговора.Организация);
	Запрос.УстановитьПараметр("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"));
	Запрос.УстановитьПараметр("ОсновныеСредства", ИспользуемыеОС);
	
	ДоговорыОС = Запрос.Выполнить().Выгрузить();
	ДоговорыОС.Индексы.Добавить("ОсновноеСредство");
	Отбор = Новый Структура("ОсновноеСредство");
	
	Для Каждого Строка Из ПараметрыЗаполненияДоговора.ДобавленныеСтроки Цикл
		Отбор.ОсновноеСредство = Строка["СубконтоЗабалансовыйСчет" + ПараметрыЗаполненияДоговора.НомерСубконтоОС];
		СтрокиДоговора = ДоговорыОС.НайтиСтроки(Отбор);
		Если СтрокиДоговора.Количество() > 0 Тогда
			Строка["СубконтоЗабалансовыйСчет" + ПараметрыЗаполненияДоговора.НомерСубконтоДоговоры] = СтрокиДоговора[0].Договор;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСчетовВФорме()
	ЗаполнитьДанныеСчетовВФорме();
	Если Элементы.СчетУчета.СписокВыбора.НайтиПоЗначению(Объект.СчетУчета) = Неопределено Тогда
		Объект.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме = Неопределено)
	
	Элементы.СчетУчета.СписокВыбора.Очистить();
	
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Не ВидПоступленияТолькоСчет105(Объект.ВидПоступленияМЗ);
	ПараметрыЗаполненияСчета.Включать106 = Истина;
	Если Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика")
		И ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугДляКомитентов") Тогда
		ПараметрыЗаполненияСчета.Включать0234 = Истина;
	КонецЕсли;
	
	Если Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратОтПокупателя")
		И ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов") Тогда
		ПараметрыЗаполненияСчета.Включать0233 = Истина;
	КонецЕсли;
	
	ПараметрыЗаполненияСчета.ТолькоБалансовые = ВидПоступленияТолькоСчета105_106(Объект.ВидПоступленияМЗ);
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	УправлениеМатериальнымиЗапасами.УстановитьОграниченияСчетовДляВыбораТары(Элементы.ВозвратнаяТараСчетУчета);
	МассивСчетов27 = ПолучитьСчета27();
	СчетУчетаИмуществаВПользовании = Новый ФиксированныйМассив(МассивСчетов27);
	УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(
		Элементы.ВозвратнаяТараДополнительнаяАналитикаСчета, ВсеСчета105);
	Для каждого СчетМЗ Из Элементы.СчетУчета.СписокВыбора Цикл
		ЭтоНеБалансовыйСчет = ВсеСчета105.НайтиПоЗначению(СчетМЗ.Значение) = Неопределено
			И ВсеСчета113.НайтиПоЗначению(СчетМЗ.Значение) = Неопределено
			И ВсеСчета106.НайтиПоЗначению(СчетМЗ.Значение) = Неопределено;
		
		Если ЭтоНеБалансовыйСчет Тогда
			ЗабалансовыеСчетаМЗ.Добавить(СчетМЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	ДополнительныеСубконтоСчетов = Новый ФиксированноеСоответствие(ПараметрыЗаполненияСчета.ВидыСубконтоСчетов);
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	ПрочитатьСвойстваЗабалансовогоСчета();
	УстановитьЗаголовокСубконтоЗабалансовогоСчета(ЭтотОбъект);
	
	УчетПоПодразделениямНаСчетахУчетаИмущества = УправлениеМатериальнымиЗапасами.ЕстьУчетПоПодразделениямСчетаУчета27(
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям, СчетУчетаИмуществаВПользовании);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСчета27()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	(ЕПСБУ.Код = ""27""
	|			ИЛИ ЕПСБУ.Код = ""27.02"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И (ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаНачалаДействия <= &ПериодСчета)
	|	И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &ПериодСчета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.Код УБЫВ";
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ПериодСчета = НачалоДня(Объект.Дата);
	Иначе
		ПериодСчета = НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	КонецЕсли;
	Запрос.УстановитьПараметр("ПериодСчета", ПериодСчета);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции 

