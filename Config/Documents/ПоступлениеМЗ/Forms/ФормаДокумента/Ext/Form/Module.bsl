#Область ОбработчикиСобытийЭлементовТаблицыФормыВозвратнаяТара

&НаКлиенте
Процедура ВозвратнаяТараПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ВозвратнаяТара.ТекущиеДанные;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(
			Объект, Элементы.ВозвратнаяТара.ТекущиеДанные);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета)
			И (УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
				Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект)) Тогда
			ТекущиеДанные.УчетПоКПС = Истина;
		КонецЕсли;
		
		КоличествоСтрок = Объект.ВозвратнаяТара.Количество();
		Если КоличествоСтрок > 1 Тогда
			ПредыдущаяСтрока = Объект.ВозвратнаяТара[КоличествоСтрок-2];
			ТекущиеДанные.КПС = ПредыдущаяСтрока.КПС;
			ТекущиеДанные.КФО = ПредыдущаяСтрока.КФО;
		КонецЕсли;
		
		Если Объект.ЭтоКорректировка Тогда
			УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьТекстЗаголовковКорректировкиВСтроке(ТекущиеДанные);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратнаяТараНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВозвратнаяТара.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		
		ЗаполнитьДанныеНоменклатурыВСтроке("ВозвратнаяТара", ТекущиеДанные.ПолучитьИдентификатор(), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратнаяТараСчетУчетаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВозвратнаяТара.ТекущиеДанные;
	
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, Ложь);
	АвтозаполнениеКПСКФОПоСчетуВСтроке(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

