КонецПроцедуры

&НаКлиенте
Процедура ПервичныйДокументПриИзменении(Элемент)
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	Если ВедетсяУчетПрослеживаемыхТоваров И ЕстьПрослеживаемыеТовары Тогда
		УстановитьОбязательностьДатыНомераДокументаПоставщика();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидПоступленияМЗПриИзменении(Элемент)
	
	Если ТребуетсяПерезаполнитьСписокСчетовУчетаВШапке() Тогда
		ОбновитьДанныеСчетовВФорме();
	КонецЕсли;
	Если Объект.ВидПоступленияМЗ <> ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета") Тогда
		Объект.ЗабалансовыйСчет = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	УстановитьОграниченияТиповДокументаОснования(ЭтотОбъект, Объект);
	ВыполнитьПриведениеЗначенияДокументаОснования();
	УстановитьСчетУчетаВШапке();
	УстановитьЗачетАванса(ЭтотОбъект);
	УстановитьУчетНДС(ЭтотОбъект);
	УстановитьОтражатьВПрослеживаемости(ЭтотОбъект);
	УстановитьКодОперацииПрослеживаемости(ЭтотОбъект);
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидПоступленияМЗ);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	ВидПоступленияМЗПриИзмененииНаСервере();
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	УстановитьДоступностьИзмененияСчетовУчета(ЭтотОбъект, Объект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьЗаголовокЗакладкиВозвратИзАренды(ЭтотОбъект);
	УстановитьДоступностьРедактированияСтрокВДокументахНФА(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПоступленияМЗОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ВидПоступленияДоИзменения = Объект.ВидПоступленияМЗ;
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда 
		Возврат;
	КонецЕсли;
	
	Если (Объект.Материалы.Количество() > 0) И (ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика")) Тогда
		СтандартнаяОбработка = Ложь;
		Объект.ДокументОснование = ВыбранноеЗначение;
		Модифицированность = Истина;
		
		Возврат;
	КонецЕсли;	
	
	Если (Объект.Материалы.Количество() > 0 Или  Объект.ВозвратнаяТара.Количество() > 0)
		И ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекстВопроса = НСтр("ru='Документ будет перезаполнен, существующие строки удалены!'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Выполнить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отменить выбор документа'"));
		
		ДополнительныеПараметры = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументОснованиеОбработкаВыбораЗавершение", ЭтотОбъект,
			ДополнительныеПараметры), ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Да);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ЗаполнитьПоДокументуОснованию(Объект.ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
