	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0133",
		БухгалтерскийУчет.СчетПоКоду("01.33", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет24",
		БухгалтерскийУчет.СчетПоКоду("24", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет25",
		БухгалтерскийУчет.СчетПоКоду("25", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет26",
		БухгалтерскийУчет.СчетПоКоду("26", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0233",
		БухгалтерскийУчет.СчетПоКоду("02.33", Объект.Дата, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0234",
		БухгалтерскийУчет.СчетПоКоду("02.34", Объект.Дата, Объект.Организация));
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ДанныеСчетовВФорме = Неопределено;
	ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме);
	ЗаполнитьДопустимыеКЭКСчетов();
	ИзменитьОтборКЭК();
	
	УправлениеМатериальнымиЗапасами.УстановитьВидДопСубконтоЛичногоПользования(
	ЭтотОбъект,
	Объект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования,
	?(СчетУчетаИмуществаВПользовании.Количество(), СчетУчетаИмуществаВПользовании[0], ПланыСчетов.ЕПСБУ.ПустаяСсылка()),
	"МатериалыДополнительноеСубконтоСчета",
	"Материалы");
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ВестиУчетПоЗакупкеТоваровУслугДляКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугДляКомитентов");
	ПоставщикРезидентТаможенногоСоюза = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	ТребуетсяНапоминаниеУведомленийОВвозе = ТребуетсяНапоминаниеОбУведомленииОВвозе();
	УстановитьПредставлениеНадписиУведомлениеОВвозе();
	РассчитатьНеобходимостьНапоминанияОВвозе();
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	
	УправлениеМатериальнымиЗапасами.УстановитьТипНоменклатурыВСтрокахДляБиологическихАктивов(Объект.Материалы);
	УстановитьДанныеДинамическихКолонок(ДанныеСчетовВФорме);
	УстановитьОграниченияТиповДокументаОснования(ЭтотОбъект, Объект);
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтотОбъект);

	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьДоступностьИзмененияСчетовУчета(ЭтотОбъект, Объект);
	УстановитьЗаголовокЗакладкиВозвратИзАренды(ЭтотОбъект);

	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УчетРасчетовКлиентСервер.УправлениеЭлементамиЗачетаАвансов(ЭтотОбъект);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидПоступленияМЗ);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	УправлениеНФАКлиентСервер.ЗаполнитьСпособУчетаНДСВСтроках(Объект, Объект.Материалы);
	Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ОбязательностьЗаполненияРеквизита(Объект, "ДокументОснование") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
			"АвтоотметкаНезаполненного", Ложь);
	КонецЕсли;
	УстановитьОбязательностьДатыНомераДокументаПоставщика();
	
КонецПроцедуры

