&НаСервере
Процедура ВидПоступленияМЗПриИзмененииНаСервере()

	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	Если Объект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования Тогда
		Если Не ЗначениеЗаполнено(Объект.ПолучательИмущества) И ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Объект.ПолучательИмущества = ЕдинственныйСотрудникПоКонтрагенту(Объект.Контрагент, Объект.Организация);
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ПолучательИмущества) Тогда
			Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	УстановитьОбязательностьДатыНомераДокументаПоставщика();
	
	Если Объект.ВидПоступленияМЗ <> Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика Тогда
		Объект.НесколькоКПСРасчетов = Ложь;
		Если ЗначениеЗаполнено(Объект.КПСРасчетов) Тогда
			Объект.КПСРасчетов = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.УстановитьВидДопСубконтоЛичногоПользования(
	ЭтотОбъект,
	Объект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования,
	?(СчетУчетаИмуществаВПользовании.Количество(), СчетУчетаИмуществаВПользовании[0], ПланыСчетов.ЕПСБУ.ПустаяСсылка()),
	"МатериалыДополнительноеСубконтоСчета",
	"Материалы");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыДополнительноеСубконтоСчета", "Видимость",
		ЗначениеЗаполнено(ДополнительноеСубконто27ВидСубконто));

КонецПроцедуры

