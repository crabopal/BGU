		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПолучениеНеСвязанноеСРеализацией"));
	КонецЕсли;
	
	Форма.Элементы.КодОперацииПрослеживаемости.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);

