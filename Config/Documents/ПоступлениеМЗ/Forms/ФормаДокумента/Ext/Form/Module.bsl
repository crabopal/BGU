&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные.КоличествоМест = 1;
		ТекущиеДанные.Коэффициент    = 1;
		ТекущиеДанные.Количество     = 1;
		
		ПоступлениеНаСчет105_106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
		
		Если НЕ ПоступлениеНаСчет105_106 Тогда
			ТекущиеДанные.СчетУчета = Объект.СчетУчета;
		КонецЕсли;
		КоличествоСтрок = Объект.Материалы.Количество();
		Если КоличествоСтрок > 1 Тогда
			ПредыдущаяСтрока = Объект.Материалы[КоличествоСтрок-2];
			ТекущиеДанные.КПС = ПредыдущаяСтрока.КПС;
			ТекущиеДанные.КФО = ПредыдущаяСтрока.КФО;
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(
			Объект, Элементы.Материалы.ТекущиеДанные, Истина);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета)
			И ПоступлениеНаСчет105_106 Тогда
			ТекущиеДанные.УчетПоКПС = Истина;
		КонецЕсли;
		
		Если Объект.ЭтоКорректировка Тогда
			УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьТекстЗаголовковКорректировкиВСтроке(ТекущиеДанные);
		КонецЕсли;
		
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, Элементы.Материалы.ТекущиеДанные);
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		Элементы.Материалы.ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Если Копирование И ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = ПредопределенноеЗначение("Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка");
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиент.ПриНачалеРедактированияСтроки(Элементы.Материалы.ТекущиеДанные, Объект.СведенияПрослеживаемости, НоваяСтрока, Копирование);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		
		ЗаполнитьДанныеНоменклатурыВСтроке("Материалы", ТекущиеДанные.ПолучитьИдентификатор(), Истина);
		ЗаполнитьПризнакКомиссионногоТовараНоменклатуры(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
