&НаСервере
Процедура ЗаполнитьДопустимыеКЭКСчетов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КОСГУ.Ссылка КАК КЭК
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ	
	|	КОСГУ.Ссылка В ИЕРАРХИИ
	|	(ВЫБРАТЬ
	|		ЕПСБУ.КОСГУДт
	|	ИЗ
	|		ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ГДЕ
	|		ЕПСБУ.Ссылка В (&ВсеСчета105)
	|	)	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КОСГУ.Ссылка КАК КЭК
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ	
	|	КОСГУ.Ссылка В ИЕРАРХИИ
	|	(ВЫБРАТЬ
	|		ЕПСБУ.КОСГУДт
	|	ИЗ
	|		ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ГДЕ
	|		ЕПСБУ.Ссылка В (&ВсеСчета113)
	|	)";
	Запрос.УстановитьПараметр("ВсеСчета105", ВсеСчета105.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ВсеСчета113", ВсеСчета113.ВыгрузитьЗначения());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КЭК105.ЗагрузитьЗначения(РезультатЗапроса[0].Выгрузить().ВыгрузитьКолонку("КЭК"));
	КЭК113.ЗагрузитьЗначения(РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("КЭК"));
	
КонецПроцедуры

