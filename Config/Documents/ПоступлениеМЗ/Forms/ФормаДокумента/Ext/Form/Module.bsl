&НаКлиенте
Процедура ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачиИмяФайла" Тогда
		УправлениеНФАКлиент.ОткрытьЭлектронныйДокументПриложенияИзФайла(
			ВыбраннаяСтрока, 
			ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи, 
			УникальныйИдентификатор);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПринятьНДСКВычетуУказываетсяВСтроках(Команда)
	Объект.ПринятьНДСКВычетуУказываетсяВСтроках = Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	Если Объект.ПринятьНДСКВычетуУказываетсяВСтроках Тогда
		УстановитьПринятьНДСКВычетуВСтроках();
	КонецЕсли;
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	ОбработкаЗавершения = Новый ОписаниеОповещения("ВыполнитьИзменениеРеквизитовСтрок", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО",         Объект.ИФО);
	ПараметрыФормы.Вставить("Дата",        Объект.Дата);
	ПараметрыФормы.Вставить("СчетУчета",   Объект.СчетУчета); 
	ПараметрыФормы.Вставить("НесколькоКПСРасчетов",   Объект.НесколькоКПСРасчетов);
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		НачальныеЗначения = Новый СписокЗначений;
		НачальныеЗначения.Добавить(ТекущиеДанные.СчетУчета, "СчетУчета");
		НачальныеЗначения.Добавить(ТекущиеДанные.КФО, "КФО");
		НачальныеЗначения.Добавить(ТекущиеДанные.КПС, "КПС");
		НачальныеЗначения.Добавить(ТекущиеДанные.КЭК, "КЭК");
		НачальныеЗначения.Добавить(ТекущиеДанные.КПСРасчетов, "КПСРасчетов");
		НачальныеЗначения.Добавить(ТекущиеДанные.ДополнительнаяАналитикаСчета, "ДополнительнаяАналитикаСчета");
		ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ПоступлениеМЗ.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,
		ЭтотОбъект,,,, ОбработкаЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборМЗ(Команда)
	
	Если ОткрытьПодборМЗ() Тогда
		Если ЭтоВозвратИзПользования(Объект.ВидПоступленияМЗ) И НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСТр("ru = 'Контрагент'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "Объект.Контрагент");
		ИначеЕсли Объект.ВидПоступленияМЗ
				= ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования")
			И НЕ ЗначениеЗаполнено(Объект.ПолучательИмущества) Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСТр("ru = 'Получатель имущества'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "Объект.ПолучательИмущества");
		Иначе
			УправлениеМатериальнымиЗапасамиКлиент.ОткрытьПодборМатериалов(ЭтотОбъект, Объект, "Материалы",
				ДополнитьСтруктуруПодбора("Материалы"));
		КонецЕсли;
	Иначе
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("ИФО"				, Объект.ИФО);
		ПараметрыПодбора.Вставить("Счет"			, Объект.ЗабалансовыйСчет);
		ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"));
		ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
		УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтотОбъект, Объект, ПараметрыПодбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТары(Команда)
	УправлениеМатериальнымиЗапасамиКлиент.ОткрытьПодборМатериалов(ЭтотОбъект, Объект, "ВозвратнаяТара",
		ДополнитьСтруктуруПодбора("ВозвратнаяТара"));
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвансы(Команда)
	
	Если Не ОбязательныеПоляДляЗаполненияЗаполнены() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = "";
	ЧастиВопроса = Новый Массив;	
	Если Объект.ЗачетАвансов.Количество() > 0 Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Табличная часть будет очищена.'"));
	КонецЕсли;
	Если Объект.Проведен Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Проведение документа будет отменено.'"));
	КонецЕсли;
	
	Если ЧастиВопроса.Количество() > 0 Тогда
		ЧастиВопроса.Добавить(НСтр("ru = 'Продолжить?'"));
		ТекстВопроса = СтрСоединить(ЧастиВопроса, Символы.ПС);
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнениеТаблицыАвансыЗавершение", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;	 

	ЗаполнитьАвансыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДО(Команда)
	
	Если Не ОбязательныеПоляДляЗаполненияЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед заполнением денежных обязательств проведение документа будет отменено.
			|Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОтменитьПроведениеПередЗаполнениемДО", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
&НаКлиенте
Процедура Подключаемый_КонтрольИсполненияДоговоровПоказатьСтатус(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДокументСсылка", Объект.Ссылка);
	ДопПараметры.Вставить("ОтразитьВГрафикеИсполнения", Объект.ОтразитьВГрафикеИсполненияДоговора);
	ДопПараметры.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	
	КонтрольИсполненияДоговоровКлиент.ПоказатьСтатусИсполнения(
		Объект.Организация, Объект.Контрагент, Объект.Договор, ДопПараметры, ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры
