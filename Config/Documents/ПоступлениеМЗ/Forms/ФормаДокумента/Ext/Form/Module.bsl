КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ДокументПоставщика(Форма)

	Видимость = (Не ЭтоАктОПриемеПередаче0510448(Форма)
			Или Форма.Объект.НФАПереданыЭлектроннымАктом)
		И Не ЭтоВозвратИзЛичногоПользования(Форма.Объект.ВидПоступленияМЗ);

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ВидПервичногоДокумента");
	ИменаЭлементов.Добавить("НомерПервичногоДокумента");
	ИменаЭлементов.Добавить("ДатаПервичногоДокумента");
	ИменаЭлементов.Добавить("ДатаПодписанияПервичногоДокумента");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов, "Видимость", Видимость);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ПоступлениеОтПоставщика(Форма)
		
	ЭлементыПоступленияОтПоставщика = Новый Массив;
	ЭлементыПоступленияОтПоставщика.Добавить("СпособЗачетаАванса");
	ЭлементыПоступленияОтПоставщика.Добавить("ЗачетАванса");
	ЭлементыПоступленияОтПоставщика.Добавить("СтрДенежныеОбязательства");
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ЭтоПоступлениеОтПоставщика = Объект.ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика")
		И (УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(Форма)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(Форма));
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыПоступленияОтПоставщика,
		"Видимость", ЭтоПоступлениеОтПоставщика);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_НДС(Форма)
	
	ЭлементыНДС = Новый Массив;
	ЭлементыНДС.Добавить("СчетФактура");
	// колонки таблицы Материалы
	ЭлементыНДС.Добавить("МатериалыСуммаНДС");
	// если НДС не выводим, то колонка Всего тоже не нужна
	ЭлементыНДС.Добавить("МатериалыВсего");
	// итоги
	ЭлементыНДС.Добавить("МатериалыИтогНДС");
	ЭлементыНДС.Добавить("ДекорацияПустая2");
	ЭлементыНДС.Добавить("СуммаНДСДокумента");
	// команда
	ЭлементыНДС.Добавить("ФормаПринятьНДСКВычетуУказываетсяВСтроках");
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	УчитываетсяНДС = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(Форма);
	Если УчитываетсяНДС Тогда
		ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
		ПринятьНДСКВычетуУказываетсяВШапке = Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	Иначе
		ПринятьНДСКВычетуУказываетсяВСтроках = Ложь;
		ПринятьНДСКВычетуУказываетсяВШапке = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыНДС,
		"Видимость", УчитываетсяНДС И НЕ Форма.Объект.ЭтоКорректировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыСтавкаНДС",
		"Видимость", УчитываетсяНДС);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтступ",
		"Видимость", НЕ УчитываетсяНДС И НЕ Форма.Объект.ЭтоКорректировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыСпособУчетаНДС",
		"Видимость", ПринятьНДСКВычетуУказываетсяВСтроках И НЕ Форма.Объект.ЭтоКорректировка);
	ЭлементыНДСКРаспределению = Новый Массив;
	ЭлементыНДСКРаспределению.Добавить("МатериалыНДСКРаспределению");
	ЭлементыНДСКРаспределению.Добавить("МатериалыТекстНДСКРаспределению");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыНДСКРаспределению,
		"Видимость", ПринятьНДСКВычетуУказываетсяВШапке И НЕ Форма.Объект.ЭтоКорректировка);
	
	Элементы.ФормаПринятьНДСКВычетуУказываетсяВСтроках.Пометка = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Корректировка(Форма)

	ИменаЭлементовСКорректировкой = Новый Массив;
	ИменаЭлементовСКорректировкой.Добавить("МатериалыЗаголовокДоКорректировки");
