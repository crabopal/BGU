&НаСервере
Процедура ВыполнитьИзменениеРеквизитовСтрокНаСервере(Знач ЗначенияДляЗаполнения, Знач ИдентификаторыСтрок)

	ЗаполнятьКЭК = ЗначенияДляЗаполнения.Свойство("КЭК");
	ЗаполнятьСчет = ЗначенияДляЗаполнения.Свойство("СчетУчета");
	
	Для Каждого Идентификатор Из ИдентификаторыСтрок Цикл
	
		ТекСтрока = Объект.Материалы.НайтиПоИдентификатору(Идентификатор);
		ЗаполнитьЗначенияСвойств(ТекСтрока, ЗначенияДляЗаполнения);
		
		Если ЗаполнятьСчет Тогда
			ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект, ТекСтрока);
			ПараметрыОбработки.ДтКт = "Дт";
			ПараметрыОбработки.Включать106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
			ПараметрыОбработки.Включать113 = Истина;
			// Переданный счет не нужно менять. Только получить его свойства и доп. субконто.
			ПараметрыОбработки.ЗаполнятьСчет = Ложь;
			
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(ТекСтрока, ПараметрыОбработки);
		КонецЕсли;
		Если ЗаполнятьКЭК Тогда
			ТекСтрока.КЭК = ЗначенияДляЗаполнения.КЭК;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

