&НаКлиенте
Функция ДополнитьСтруктуруПодбора(ДополнительныйПараметр)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета", Объект.СчетУчета);
	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект)
		Или ДополнительныйПараметр = "ВозвратнаяТара" Тогда
		ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	КонецЕсли;
	ТипыНоменклатуры = Новый СписокЗначений;
	Если ДополнительныйПараметр = "Материалы" Тогда
		ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	
		ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер
			.ДополнительнаяАналитикаСчетаУчетаМатериалов(Объект.СчетУчета, Объект.Организация);
		Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
			ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
		КонецЕсли;
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
		Если Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета") Тогда
			ПараметрыПодбора.Вставить("РасширенныйПодборНоменклатуры", Истина);
		КонецЕсли;
	Иначе
		ПараметрыПодбора.Вставить("ИмяТаблицы",				"ВозвратнаяТара");
		ПараметрыПодбора.Вставить("ПредставлениеТаблицы",	"Возвратная тара");
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	КонецЕсли;
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("Валюта",					Объект.ВалютаДокумента);
	ПараметрыПодбора.Вставить("ЕстьЦена",				Истина);
	ПараметрыПодбора.Вставить("ПоказыватьЦены",			Истина);
	
	Если ЭтоВозвратИзПользования(Объект.ВидПоступленияМЗ) Тогда
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",				Истина);
		ПараметрыПодбора.Вставить("ПроверятьОстаткиВПользовании",	Истина);
		ПараметрыПодбора.Вставить("КонтрагентОстатковВПользовании",	Объект.Контрагент);
		Если ЗначениеЗаполнено(Объект.ЦМОПриВозврате) Тогда
			ПараметрыПодбора.Вставить("ЦМО", Объект.ЦМОПриВозврате);
			ПараметрыПодбора.Вставить("Подразделение", Объект.ПодразделениеПриВозврате);
		Иначе
			ПараметрыПодбора.Вставить("ЦМО", Объект.ЦМО);
			ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);
		КонецЕсли;
		Если Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзДоверительногоУправления") Тогда
			ПараметрыПодбора.Вставить("СчетОстатковВПользовании", ЭтотОбъект.КэшПараметров.Локальные.Счет24);
		ИначеЕсли Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзАренды") Тогда
			ПараметрыПодбора.Вставить("СчетОстатковВПользовании", ЭтотОбъект.КэшПараметров.Локальные.Счет25);
		ИначеЕсли Объект.ВидПоступленияМЗ = ПредопределенноеЗначение(
			"Перечисление.ВидыПоступленийМЗ.ВозвратИзБезвПользования") Тогда
			ПараметрыПодбора.Вставить("СчетОстатковВПользовании", ЭтотОбъект.КэшПараметров.Локальные.Счет26);
			ПараметрыПодбора.Вставить("ВидБезвозмездногоПользования", Объект.ВидБезвозмездногоПользования);
			ПараметрыПодбора.Вставить("ИспользоватьВидБезвозмездногоПользования", Истина);
		КонецЕсли;
	ИначеЕсли Объект.ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования") Тогда
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",				Истина);
		ПараметрыПодбора.Вставить("ПодборОстатковВПользовании",		Истина);
		ПараметрыПодбора.Вставить("СотрудникОстатковВПользовании",	Объект.ПолучательИмущества);
		ПараметрыПодбора.Вставить("Подразделение", Объект.ПодразделениеИсточник);
		ПараметрыПодбора.Вставить("СчетОстатковВПользовании",	СчетУчетаИмуществаВПользовании[0]);
		ПараметрыПодбора.Вставить("СчетУчета",	СчетУчетаИмуществаВПользовании[0]);
	ИначеЕсли ЗначениеЗаполнено(Объект.ЗабалансовыйСчет) Тогда
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",				Истина);
		ПараметрыПодбора.Вставить("СчетУчета",	Объект.ЗабалансовыйСчет);
		ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);
		ПараметрыПодбора.Вставить("РасширенныйПодборНоменклатуры",	Истина);
	КонецЕсли;
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Контрагент));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ЦМО");
	ИменаЭлементов.Добавить("Подразделение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаСервере
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Материалы.Итог("Всего") + Объект.ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	Для Каждого СтрокаТЧ из Объект.Материалы Цикл
		РасчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма");
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНоменклатурыВСтроке(ИмяТаблицы, ИдентификаторСтроки, Знач ЗаполнятьСчет)
	
	Если ЗабалансовыеСчетаМЗ.НайтиПоЗначению(Объект.СчетУчета) <> Неопределено Тогда
		ЗаполнятьСчет = Ложь;
	КонецЕсли;
	
	ТекущиеДанные = Объект[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ИмяТаблицы = "Материалы" Тогда
		СтруктураДанных = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата);
		Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(ЭтотОбъект) Тогда
			ТекущиеДанные.СтавкаНДС = СтруктураДанных.СтавкаНДС;
		КонецЕсли;
		ТекущиеДанные.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
		ТекущиеДанные.ПрослеживаемыйТовар = СтруктураДанных.ПрослеживаемыйТовар;
		ТекущиеДанные.КомплектСПрослеживаемымиТоварами = СтруктураДанных.КомплектСПрослеживаемымиТоварами;
		ТекущиеДанные.СтранаПроисхождения = СтруктураДанных.СтранаПроисхождения;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(
			ТекущиеДанные, СтруктураДанных.ТипНоменклатуры);
		Если ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
			ТекущиеДанные.ВариантКомплектаПТ = Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, ЗаполнятьСчет);
	АвтозаполнениеКПСКФОПоСчетуВСтроке(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.ЗаполнятьСчет = ЗаполнятьСчет;
	ПараметрыОбработки.ДтКт          = "Дт";
	ПараметрыОбработки.Включать113   = Истина;
	ПараметрыОбработки.Включать106   = Истина;
	ПараметрыОбработки.Включать0233   = Истина;
	ПараметрыОбработки.Включать0234   = Истина;
	ПараметрыОбработки.ВШапке106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(Форма);
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	Если ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
		Строка.ДополнительноеСубконтоВидСубконто = Форма.ДополнительноеСубконто27ВидСубконто;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура АвтозаполнениеКПСКФОПоСчетуВСтроке(Форма, Строка)

	Если Строка.УчетПоКПС Тогда
		Если Форма.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС
			И НЕ ЗначениеЗаполнено(Строка.КПС) И ЗначениеЗаполнено(Строка.СчетУчета) Тогда
			
			ЗначенияАвтозаполнения = УправлениеНФАВызовСервера.ЗначенияКПСКФОПоУмолчаниюДляСчета(
			Форма.Объект.Организация,
			Форма.Объект.ИФО,
			Строка.СчетУчета,
			Форма.Объект.Дата,
			Строка.КФО);
			
			Если ЗначенияАвтозаполнения <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Строка, ЗначенияАвтозаполнения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОграниченияТиповДокументаОснования(Форма, Объект)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"ДокументОснование",
		"ОграничениеТипа",
		ОграничениеТиповДокументаОснования(Объект.ВидПоступленияМЗ, Объект.ЭтоКорректировка));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПриведениеЗначенияДокументаОснования()
	
	НовоеОграничениеТипа = ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(Элементы,
		"ДокументОснование", "ОграничениеТипа");
	Если ТипЗнч(НовоеОграничениеТипа) = Тип("ОписаниеТипов") Тогда
		Объект.ДокументОснование = НовоеОграничениеТипа.ПривестиЗначение(Объект.ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОграничениеТиповДокументаОснования(ВидПоступленияМЗ, ЭтоКорректировка)
	МассивТипов = Новый Массив;
	Если ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратОтПокупателя") Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12"));
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЭлектронныйДокументПоставщика"));
		
	ИначеЕсли ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзАренды")
		ИЛИ ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзБезвПользования")
		ИЛИ ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзДоверительногоУправления") Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЭлектронныйДокументПоставщика"));
		
	ИначеЕсли ЭтоКорректировка Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
		
	Иначе
		
		МассивТипов.Добавить(Тип("ДокументСсылка.АктОбУтилизацииМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.АктОбУтилизацииОС"));
		МассивТипов.Добавить(Тип("ДокументСсылка.АктПриемкиМ7"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ИзвещениеВходящее"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ИнвентаризацияМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗВПути"));
		МассивТипов.Добавить(Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеБСО"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ТаксировкаПутевогоЛиста"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЭлектронныйДокументПоставщика"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий"));
		МассивТипов.Добавить(Тип("СправочникСсылка.Договоры"));
	
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(МассивТипов);
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ)
	
	ПоступлениеНаСчет106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	ОтражатьСписаниеСЗабаланса = Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета");
	ЗаменитьЗабалансовыйСчетИзПодбора = Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования")
		Или ОтражатьСписаниеСЗабаланса;
	
	УстановитьСчетУчетаИзШапки = НЕ УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
		И Не ПоступлениеНаСчет106;
	ЗаполнятьНДСВТаблице = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(ЭтотОбъект);
	
	СчетТоваровНаКомиссии = БухгалтерскийУчет.СчетПоКоду("02.33", Объект.Дата, Объект.Организация);
	
	СчетТоваровЗакупкаПоКомиссии = БухгалтерскийУчет.СчетПоКоду("02.34", Объект.Дата, Объект.Организация);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект[ИмяТЧ].Добавить(); // см. Документ.ПоступлениеМЗ.Форма.ФормаДокумента.Элементы.Материалы
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		Если ПоступлениеНаСчет106 Тогда
			// Из подбора возвращаеся счет 105.хх. Его нужно заменить на 106.хх
			НоваяСтрока.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
		Если ИмяТЧ = "Материалы" Тогда
			УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, НоваяСтрока);
			НоваяСтрока.КоличествоМест = 1;
			НоваяСтрока.Коэффициент    = 1;
			Если УстановитьСчетУчетаИзШапки Тогда
				НоваяСтрока.СчетУчета = Объект.СчетУчета;
			ИначеЕсли ЗаменитьЗабалансовыйСчетИзПодбора Тогда
				НоваяСтрока.СчетУчета = УправлениеМатериальнымиЗапасами.ПолучитьСчетНоменклатурыПоУмолчанию(
					НоваяСтрока.Номенклатура);
			КонецЕсли;
			Если Не ЗаполнятьНДСВТаблице Тогда
				НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
				НоваяСтрока.СуммаНДС = 0;
			КонецЕсли;
			ЗаполнитьСубконтоЗабалансовогоСчетаВСтроке(НоваяСтрока, ЭлементПодбора.ДополнительнаяАналитикаСчета,
				?(ЗначениеЗаполнено(ЭлементПодбора.ЦМО), ЭлементПодбора.ЦМО, Объект.ЦМО));
			Если ЗначениеЗаполнено(ЭлементПодбора.ЦМО) И НомерЗабалансовогоСубконтоЦМО > 0 Тогда
				НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоЦМО] = ЭлементПодбора.ЦМО;
			КонецЕсли;
			РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");
		КонецЕсли;
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчета));
		
		Если ЗначениеЗаполнено(НоваяСтрока.СчетУчета) И ИмяТЧ = "Материалы"Тогда
			Если НоваяСтрока.СчетУчета = СчетТоваровНаКомиссии ИЛИ НоваяСтрока.СчетУчета = СчетТоваровЗакупкаПоКомиссии Тогда
				НоваяСтрока.КомиссионнаяТорговля = Истина;
			Иначе
				НоваяСтрока.КомиссионнаяТорговля = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если (НЕ НоваяСтрока.ЕстьДополнительноеСубконто
			 И ЗначениеЗаполнено(НоваяСтрока.ДополнительнаяАналитикаСчета))
			 ИЛИ Объект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования Тогда
			НоваяСтрока.ДополнительнаяАналитикаСчета = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	РассчитатьСуммуДокумента();
	РассчитатьНеобходимостьНапоминанияОВвозе();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьОбязательностьДатыНомераДокументаПоставщика();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСубконтоЗабалансовогоСчетаВСтроке(Строка, ДополнительнаяАналитикаСчета,ЦМО)
	Если НомерЗабалансовогоСубконтоЦМО > 0 Тогда
		Строка["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоЦМО] = ЦМО;
	КонецЕсли;
	Если НомерЗабалансовогоСубконтоДоп > 0 Тогда
		Строка["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоДоп] = ДополнительнаяАналитикаСчета;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСвойстваЗабалансовогоСчета(Форма)
	Форма.НомерЗабалансовогоСубконтоЦМО = 0;
	Форма.НомерЗабалансовогоСубконтоДоп = 0;
	Форма.НомерЗабалансовогоСубконтоОС = 0;
	Форма.ЗаголовокЗабалансовогоСубконтоДоп = "";
	Форма.ВидСубконтоЗабалансовогоСубконтоДоп = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСвойстваЗабалансовогоСчета()
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.ЗабалансовыйСчет);
	ОчиститьСвойстваЗабалансовогоСчета(ЭтотОбъект);
	Для Номер = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Если СвойстваСчета["ВидСубконто" + Номер] = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
			НомерЗабалансовогоСубконтоЦМО = Номер;
		ИначеЕсли СвойстваСчета["ВидСубконто" + Номер] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			НомерЗабалансовогоСубконтоОС = Номер;
		ИначеЕсли СвойстваСчета["ВидСубконто" + Номер] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
			НомерЗабалансовогоСубконтоДоп = Номер;
			ЗаголовокЗабалансовогоСубконтоДоп = СвойстваСчета["ВидСубконто" + Номер + "Наименование"];
			ВидСубконтоЗабалансовогоСубконтоДоп = СвойстваСчета["ВидСубконто" + Номер]; 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	
	Если (Объект.Материалы.Количество() > 0) И 
		(ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика")) Тогда
		Возврат;
	КонецЕсли;	
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоОснованию(ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	УправлениеМатериальнымиЗапасами.УстановитьТипНоменклатурыВСтрокахДляБиологическихАктивов(Объект.Материалы);
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(Истина);
	РассчитатьСуммуДокумента();
	
КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтотОбъект, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКПСВТаблицеМатериалы()
		
	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект) Тогда
		УправлениеМатериальнымиЗапасами.ЗаполнитьКПСМЗвТЧПоступления(Объект, "Материалы", Истина);
		Если Объект.ВозвратнаяТара.Количество() Тогда
			УправлениеМатериальнымиЗапасами.ЗаполнитьКПСМЗвТЧПоступления(Объект, "ВозвратнаяТара", Истина);
		КонецЕсли;
	Иначе
		УправлениеМатериальнымиЗапасами.ЗаполнитьКПСМЗвТЧПоступления(Объект, "Материалы");
		Если Объект.ВозвратнаяТара.Количество() Тогда
			УправлениеМатериальнымиЗапасами.ЗаполнитьКПСМЗвТЧПоступления(Объект, "ВозвратнаяТара");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетУчетаВТаблицеМатериалы()

	Если Не ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьСчет106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	ВычислятьСчет = ЗаполнятьСчет106 Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект);
	
	СчетУчета0233 = ЭтотОбъект.КэшПараметров.Локальные.Счет0233;
	СчетУчета0234 = ЭтотОбъект.КэшПараметров.Локальные.Счет0234;
	
	Если ВычислятьСчет Тогда
		НоменклатураДокумента = Объект.Материалы.Выгрузить().ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(НоменклатураДокумента, "СчетУчета, ТипНоменклатуры");
		КЭШСчетов = Новый Соответствие;
		Для каждого ТекСтрока Из Объект.Материалы Цикл
			СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			
			// Если нужен счет 106.хх и в таблице заполнен счет 105,
			// нужно попробовать определить счет 106.хх по счету 105.хх (113.хх)
			Если ЗаполнятьСчет106 Тогда
				Если ЗначениеЗаполнено(ТекСтрока.СчетУчета)
					И (ВсеСчета105.НайтиПоЗначению(ТекСтрока.СчетУчета) <> Неопределено
						Или ВсеСчета113.НайтиПоЗначению(ТекСтрока.СчетУчета) <> Неопределено) Тогда
					СчетУчета = УправлениеМатериальнымиЗапасами.СчетВложенийПоСчетуМатериала(ТекСтрока.СчетУчета,
																							 Объект.Организация,
																							 Объект.Дата);
				КонецЕсли;
			КонецЕсли;
			
			ТекНоменклатура = ДанныеНоменклатуры.Получить(ТекСтрока.Номенклатура);
			Если Не ЗначениеЗаполнено(СчетУчета) И ТекНоменклатура <> Неопределено Тогда
				СчетУчетаСтр = ТекНоменклатура.СчетУчета;
				СчетУчета = КЭШСчетов.Получить(СчетУчетаСтр);
				Если СчетУчета = Неопределено Тогда
					СчетУчета = БухгалтерскийУчет.СчетПоКоду(СчетУчетаСтр, Объект.Дата, Объект.Организация);
					КЭШСчетов.Вставить(СчетУчетаСтр, СчетУчета);
				КонецЕсли;
				Если ЗаполнятьСчет106 И ЗначениеЗаполнено(СчетУчета) Тогда
					// Из полученного счета 105 (113) нужно получить счет 106
					СчетУчета = УправлениеМатериальнымиЗапасами.СчетВложенийПоСчетуМатериала(
						СчетУчета,
						Объект.Организация,
						Объект.Дата);
				КонецЕсли;
			КонецЕсли;
			ТекСтрока.СчетУчета = СчетУчета;
			Если ЗначениеЗаполнено(СчетУчета) И ТекНоменклатура <> Неопределено Тогда
				ТекСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Объект.Организация, Объект.ИФО, ТекСтрока.КФО,
					Объект.Дата, СчетУчета, ТекНоменклатура.ТипНоменклатуры, "Дт");
			Иначе
				ТекСтрока.КЭК = Справочники.КОСГУ.ПустаяСсылка();
			КонецЕсли;
			//Проверим если счет относится к комиссионной торговле необходимо заполнить признак "Комиссионная торговля" у позиции номенклатуры
			Если ТекСтрока.СчетУчета = СчетУчета0233 ИЛИ ТекСтрока.СчетУчета = СчетУчета0234 Тогда
				ТекСтрока.КомиссионнаяТорговля = Истина;
			Иначе
				ТекСтрока.КомиссионнаяТорговля = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетУчета);
		Для каждого ТекСтрока Из Объект.Материалы Цикл
			ТекСтрока.СчетУчета = Объект.СчетУчета;
			//Проверим если счет относится к комиссионной торговле необходимо заполнить признак "Комиссионная торговля" у позиции номенклатуры
			Если ТекСтрока.СчетУчета = СчетУчета0233 ИЛИ ТекСтрока.СчетУчета = СчетУчета0234 Тогда
				ТекСтрока.КомиссионнаяТорговля = Истина;
			Иначе
				ТекСтрока.КомиссионнаяТорговля = Ложь;
			КонецЕсли;
			ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка();
			ТекСтрока.УчетПоКПС = СвойстваСчета.УчетПоКПС;
			Если НЕ СвойстваСчета.УчетПоКПС Тогда
				ТекСтрока.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
				ТекСтрока.КЭК = Справочники.КОСГУ.ПустаяСсылка();
			КонецЕсли;
			ТекСтрока.НДСКРаспределению = Ложь;
			РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "СтавкаНДС");
		КонецЦикла;
		Если Не СвойстваСчета.Валютный Тогда
			Объект.ВалютаДокумента = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(Ложь);
	УстановитьЗачетАванса(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);

КонецПроцедуры // УстановитьСчетУчетаВТаблицеМатериалы()

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЗаполнятьВозвратнуюТару, ДанныеСчетовВФорме = Неопределено)
	ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
		ЭтотОбъект, Объект);
	ПараметрыЗаполненияКолонок.Включать106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	ПараметрыЗаполненияКолонок.Включать113 = Истина;
	ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
	УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);
	
	Если ВестиУчетПоЗакупкеТоваровУслугДляКомитентов Тогда
		ПараметрыЗаполненияКолонок.Включать0234 = Истина;
	КонецЕсли;
	
	Если ЗаполнятьВозвратнуюТару Тогда
		ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
			ЭтотОбъект, Объект);
		ПараметрыЗаполненияКолонок.ИмяТаблицы = "ВозвратнаяТара";
		ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
		УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);
	КонецЕсли;
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПериодЗаполнения = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗаполнения = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Документы.ПоступлениеМЗ.ЗаполнитьПоОстаткамАвансов(Объект, ПериодЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОтменитьПроведениеПередЗаполнениемДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетУчетаВШапке()
	
	УстановитьСчет105 = ВидПоступленияТолькоСчет105(Объект.ВидПоступленияМЗ)
		И Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
		И Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	УстановитьСчет0233 = ВидПоступленияТолькоСчет0233(Объект.ВидПоступленияМЗ);
	Если УстановитьСчет105 Тогда
		Объект.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет105;
		УстановитьСчетУчетаВТаблицеМатериалы();
	ИначеЕсли УстановитьСчет0233 Тогда
		Объект.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет0233;
		УстановитьСчетУчетаВТаблицеМатериалы()
	КонецЕсли;

КонецПроцедуры // УстановитьСчетУчетаВШапке()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьИзмененияСчетовУчета(Форма, Объект)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СчетУчета",
		"Доступность", НЕ ВидПоступленияТолькоСчет105(Объект.ВидПоступленияМЗ));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВозвратИзПользования(ВидПоступленияМЗ)

	Возврат ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзАренды")
		ИЛИ ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзБезвПользования")
		ИЛИ ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзДоверительногоУправления");
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВозвратИзЛичногоПользования(ВидПоступленияМЗ)

	Возврат ВидПоступленияМЗ = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования");
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидПоступленияТолькоСчет105(ВидПоступления)
	
	ВидыПоступлений = Новый Массив;
	ВидыПоступлений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета"));
	ВидыПоступлений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзАренды"));
	ВидыПоступлений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзДоверительногоУправления"));
	ВидыПоступлений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзБезвПользования"));
	ВидыПоступлений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования"));
	
	Возврат ВидыПоступлений.Найти(ВидПоступления) <> Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидПоступленияТолькоСчета105_106(ВидПоступления)
	Возврат ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика");
КонецФункции

&НаКлиенте
Функция ТребуетсяПерезаполнитьСписокСчетовУчетаВШапке()
	ДоИзмененияТолько105_106 = ВидПоступленияТолькоСчета105_106(ВидПоступленияДоИзменения);
	ПослеИзмененияТолько105_106 = ВидПоступленияТолькоСчета105_106(Объект.ВидПоступленияМЗ);
	Возврат ДоИзмененияТолько105_106 <> ПослеИзмененияТолько105_106;
КонецФункции

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0) И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе	
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);

	ТаблицаНФА = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок,
		"ОбъектНФА, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЧистаяМасса, ЛигатурнаяМасса, ЕдИзм");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНФА);

КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ПараметрыПодбора.ОбъектНФА);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеСтроки;
КонецФункции	

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
		Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ВидДрагМатериала");
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, "");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.Материалы.Выгрузить(,"Номенклатура, СчетУчета, Количество");
	
	ТаблицаОбъектовМЗ = Новый ТаблицаЗначений;
	ТаблицаОбъектовМЗ.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	НеСодержатДрагМатериалы = УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НеСодержатДрагМатериалы.Найти(ТекСтрока.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
				Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
					НоваяСтрока = ТаблицаОбъектовМЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
					НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.Номенклатура, ""); 
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаОбъектовМЗ);
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовМЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = ОбъектыНФАСДрагМатериалами.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.Номенклатура;
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);

КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	ТаблицаДМ.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуПоДоговору(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуПоДоговоруНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоДоговоруНаСервере()
	
	Объект.Материалы.Очистить();
	
	Документы.ПоступлениеМЗ.ЗаполнитьПоДоговору(Объект, Объект.Договор);

	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(Ложь);
	
	УстановитьВидимостьКПСРасчетовВТЧ(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры	

&НаСервере
Процедура ДобавитьДрагМатериалыОбъектаПоТехДокументации(ВыбранныйОбъектНФА, ОбъектНФА, Количество)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.МассаДМ * &Количество) КАК МассаДМ,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.КоличествоДМ * &Количество) КАК КоличествоДМ,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм КАК ЕдИзм
	               |ИЗ
	               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.ДрагМатериалы КАК ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы
	               |ГДЕ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм";

	Запрос.УстановитьПараметр("Ссылка", ВыбранныйОбъектНФА);
	Запрос.УстановитьПараметр("Количество", Количество);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ОбъектНФА = ОбъектНФА;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДрагМатериалыПоТехДокументацииНаСервере()
	ТаблицаНФА = ОбъектыНФАСДрагМатериалами.Выгрузить();
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументации(ТаблицаНФА);
	Объект.ДрагоценныеМатериалы.Загрузить(ТаблицаНФА);
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуСведенийОСодержанииДрагМатериаловПоТехДокументации(ОбъектНФА, ТехДокументация)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(ТехДокументация) Тогда
		ПараметрыФормы.Вставить("Ключ", ТехДокументация);
	Иначе
		ПараметрыФормы.Вставить("ОбъектНФА", ОбъектНФА);
	КонецЕсли;	
	ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗачетАванса(Форма)

	Объект = Форма.Объект;
	
	Если Объект.ВидПоступленияМЗ <> ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика") Тогда
		
		Если Объект.СпособЗачетаАванса <> ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать") Тогда
			
			Объект.СпособЗачетаАванса = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.НеЗачитывать");
			Объект.ЗачетАвансов.Очистить();
			УчетРасчетовКлиентСервер.УправлениеЭлементамиЗачетаАвансов(Форма);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьЗачетАванса()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьУчетНДС(Форма)

	Объект = Форма.Объект;
	Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ПоступлениеМЗЭтоПоступлениеИлиВозврат(Объект.ВидПоступленияМЗ) Тогда
		Объект.ПринятьНДСКВычету = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВалюту(Форма)

	Объект = Форма.Объект;
	Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ПоступлениеМЗЭтоПоступлениеИлиВозврат(Объект.ВидПоступленияМЗ) Тогда
		Объект.ВалютаДокумента = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта_Параметры();
	ПараметрыПредставления.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыПредставления.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
	ПараметрыПредставления.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	ПараметрыПредставления.ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПараметрыПредставления.ПоказыватьНДС = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(Форма);
	ПараметрыПредставления.УчитыватьНДС = ПараметрыПредставления.ПоказыватьНДС;
	ПараметрыПредставления.ПоказыватьВалюту = Форма.КэшПараметров.ИспользоватьВалютныйУчет;
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокЗакладкиВозвратИзАренды(Форма)
	Если ЭтоВозвратИзПользования(Форма.Объект.ВидПоступленияМЗ) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаВозвратИзАренды",
			"Заголовок", Форма.Объект.ВидПоступленияМЗ);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Элементы = Форма.Элементы;

	УстановитьВидимостьЭлементовФормы_ПоДоверенности(Форма);
	УстановитьВидимостьЭлементовФормы_ОснованиеДляАкта(Форма);
	УстановитьВидимостьЭлементовФормы_Комиссия(Форма);
	УстановитьВидимостьЭлементовФормы_Корректировка(Форма);
	УстановитьВидимостьЭлементовФормы_НДС(Форма);
	УстановитьВидимостьЭлементовФормы_ПоступлениеОтПоставщика(Форма);
	УстановитьВидимостьЭлементовФормы_СчетРасчетов(Форма);
	УстановитьВидимостьЭлементовФормы_Отправитель(Форма);
	УстановитьВидимостьЭлементовФормы_Валюта(Форма);
	УстановитьВидимостьЭлементовФормы_ЗабалансовыйСчет(Форма);
	УстановитьВидимостьЭлементовВозвратаИзПользования(Форма);
	УстановитьВидимостьВидаПользования(Форма);
	УстановитьВидимостьЭлементовФормы_ДокументПоставщика(Форма);
	УстановитьВидимостьЭлементовФормы_ПоставкаОтКонтрагента(Форма);
	УстановитьВидимостьЭлементовФормы_ЦМОПриВозврате(Форма);
	УстановитьВидимостьКПСРасчетовВТЧ(Форма);
	УстановитьВидимостьЭлементовКомиссионнаяТорговля(Форма);
	
	ВидимостьНадписиВалютаНДС = ВДокументеВозможенУчетВалюты(Форма)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(Форма);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьВалютаНДС",
		"Видимость", ВидимостьНадписиВалютаНДС);
	
	ВидимостьРеквизитовВозврата =
		Форма.Объект.ВидПоступленияМЗ = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ВозвратОтПокупателя");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыЦенаОприходования",
		"Видимость", ВидимостьРеквизитовВозврата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВозвратнаяТараЦенаОприходования",
		"Видимость", ВидимостьРеквизитовВозврата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МатериалыДополнительноеСубконтоСчета", "Видимость",
		ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто));
	
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма);
	
КонецПроцедуры

