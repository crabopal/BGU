#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Параметры.Организация;
	Дата = Параметры.Дата;
	ИФО = Параметры.ИФО;
	НесколькоКПСРасчетов = Параметры.НесколькоКПСРасчетов;
	ЗаполнитьСписокСчетов();
	ЗаполнитьДанныеСчетовВФорме();
	ЗаполнитьПараметрыВыбораДопСубконто();
	ЗаполнитьСтрокиТаблицы();
	ПроизвольныйКЭК = БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, , Дата)
		= Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация;
	КЭК000 = БухгалтерскийУчетПовтИсп.КЭК0();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаРеквизитов

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ТекущиеДанные.ИзменятьРеквизит = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	ТипРеквизита = ?(ТекущиеДанные.ТипРеквизита.Типы().Количество() = 1, ТекущиеДанные.ТипРеквизита.Типы()[0], Неопределено);
	
	Если ТипРеквизита = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораСчета();
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ЗначениеРеквизита);
		ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораКПС();
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ЗначениеРеквизита);
		ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.КОСГУ") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораКОСГУ();
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ЗначениеРеквизита);
		ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипРеквизита = Тип("ПеречислениеСсылка.КВД") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораКВД();
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипРеквизита, ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		ДополнительныеПараметры = Новый Структура("Элемент, ТекущиеДанные", Элемент, ТекущиеДанные);
		
		Если ТипСубконтоДополнительнаяАналитика.Типы().Количество() = 1 Тогда
			
			ПродолжитьВыборДопСубконто(ТипСубконтоДополнительнаяАналитика.Типы()[0], ДополнительныеПараметры);
			
		Иначе
			
			СписокТипов = Новый СписокЗначений;
			СписокТипов.ЗагрузитьЗначения(ТипСубконтоДополнительнаяАналитика.Типы());
			СписокТипов.СортироватьПоЗначению();
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьВыборДопСубконто", ЭтотОбъект, ДополнительныеПараметры);
			СписокТипов.ПоказатьВыборЭлемента(ОписаниеОповещения, НСтр("ru='Выбор типа данных'"));
			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	ВыполнитьАвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	ВыполнитьАвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВозвращаемоеЗначение = Новый Структура;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если СтрокаТаблицы.ИзменятьРеквизит Тогда
			ВозвращаемоеЗначение.Вставить(СтрокаТаблицы.ИмяРеквизита, СтрокаТаблицы.ЗначениеРеквизита);
		КонецЕсли;
	
	КонецЦикла;
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПродолжитьВыборДопСубконто(Знач ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		ВыбранноеЗначение = ВыбранноеЗначение.Значение;
	КонецЕсли;
	
	Элемент = ДополнительныеПараметры.Элемент;
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	ПолноеИмяТипа = БухгалтерскийУчетКлиент.ПолноеИмяПоТипуЗначения(ВыбранноеЗначение);
	Если Не ЗначениеЗаполнено(ПолноеИмяТипа) Тогда
		// Используется стандартное открытие формы выбора
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Для Каждого Параметр Из ПараметрыВыбораДопСубконто Цикл
		Отбор.Вставить(Параметр.Имя, Параметр.Значение);
	КонецЦикла;
	
	ИмяОткрываемойФормы = ПолноеИмяТипа + ".ФормаВыбора";
	ПараметрыФормы = Новый Структура("Отбор, РежимВыбора", Отбор, Истина);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ЗначениеРеквизита);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСчетов()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ (&Счет)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	Если Параметры.СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация) Тогда
		Счета = Новый Массив;
		Счета.Добавить(Параметры.СчетУчета);
		Счет113 = БухгалтерскийУчет.СчетПоКоду("113.00", Дата, Организация);
		Если ЗначениеЗаполнено(Счет113) Тогда
			Счета.Добавить(Счет113);
		КонецЕсли;
		Запрос.УстановитьПараметр("Счет", Счета);
	Иначе
		Запрос.УстановитьПараметр("Счет", Параметры.СчетУчета);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокСчетов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	ЗаполнитьДопустимыеКЭК();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопустимыеКЭК()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ЕПСБУ.КОСГУДт КАК КОСГУДт
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Ссылка В (&ДопустимыеСчета))";
	Запрос.УстановитьПараметр("ДопустимыеСчета", СписокСчетов.ВыгрузитьЗначения());
	ДопустимыеКЭК.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме()
	ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь);
	ПараметрыДанныхСчетов.Включать106 = Истина;
	ПараметрыДанныхСчетов.ДатаСчета = Дата;
	ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		Если ДанныеСчета.Счет = Параметры.СчетУчета Тогда
			Если ЗначениеЗаполнено(ДанныеСчета.ДополнительноеСубконто)
				И НЕ ЗначениеЗаполнено(ВидСубконтоДополнительнаяАналитика) Тогда
				ВидСубконтоДополнительнаяАналитика = ДанныеСчета.ДополнительноеСубконто;
				ТипСубконтоДополнительнаяАналитика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСубконтоДополнительнаяАналитика, "ТипЗначения");
			КонецЕсли;
			Если ДанныеСчета.УчетПоКПС Тогда
				УчетПоКПС = Истина;
			КонецЕсли;
			Если ДанныеСчета.УчетПоКЭК Тогда
				УчетПоКЭК = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	ТипРеквизита = ?(ТекущиеДанные.ТипРеквизита.Типы().Количество() = 1, ТекущиеДанные.ТипРеквизита.Типы()[0], Неопределено);
	
	Если ТипРеквизита = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораСчета();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипРеквизита, ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораКПС();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипРеквизита, ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипРеквизита = Тип("ПеречислениеСсылка.КВД") Тогда
		
		ПараметрыФормы = ПараметрыФормыДляВыбораКВД();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипРеквизита, ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыВыбораДопСубконто()
	МетаданныеОрганизации = Метаданные.Справочники.Организации;
	ИменаПараметров = Новый Структура;
	Для Каждого Тип Из ТипСубконтоДополнительнаяАналитика.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Если ОбъектМетаданных.Владельцы.Содержит(МетаданныеОрганизации)
				Или ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", ОбъектМетаданных) Тогда
				ИменаПараметров.Вставить("Организация");
			КонецЕсли;
		ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", ОбъектМетаданных) Тогда
				ИменаПараметров.Вставить("Организация");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ИменаПараметров, ЭтотОбъект);
	
	Для Каждого Параметр Из ИменаПараметров Цикл
		СтрокаПараметра = ПараметрыВыбораДопСубконто.Добавить();
		СтрокаПараметра.Имя = Параметр.Ключ;
		СтрокаПараметра.Значение = Параметр.Значение;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиТаблицы()
	
	Если УчетПоКПС Тогда
		ДобавитьСтрокуРеквизита("КПС", НСтр("ru = 'КПС'"),
			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов")); 
		Если НесколькоКПСРасчетов Тогда 	
			ДобавитьСтрокуРеквизита("КПСРасчетов", НСтр("ru = 'КПС расчетов'"),
			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		КонецЕсли;	
	КонецЕсли;
	ДобавитьСтрокуРеквизита("КФО", НСтр("ru = 'КФО'"), Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДобавитьСтрокуРеквизита("СчетУчета", НСтр("ru = 'Счет учета'"), Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Если УчетПоКЭК Тогда
		ДобавитьСтрокуРеквизита("КЭК", НСтр("ru = 'КЭК'"), Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидСубконтоДополнительнаяАналитика) Тогда
		ДобавитьСтрокуРеквизита("ДополнительнаяАналитикаСчета", НСтр("ru = 'Доп. аналитика'"),
			ТипСубконтоДополнительнаяАналитика);
	КонецЕсли;
	
	СохраненныеЗначения = Новый Соответствие;
	Для Каждого Значение Из Параметры.НачальныеЗначения Цикл
		СохраненныеЗначения.Вставить(Значение.Представление, Значение.Значение);
	КонецЦикла;
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитов Цикл
		СтрокаРеквизита.ЗначениеРеквизита = СохраненныеЗначения.Получить(СтрокаРеквизита.ИмяРеквизита);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРеквизита(Имя, Представление, Тип)
	НоваяСтрока = ТаблицаРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита           = Имя;
	НоваяСтрока.ПредставлениеРеквизита = Представление;
	НоваяСтрока.ТипРеквизита           = Тип;
КонецПроцедуры

&НаКлиенте
Функция ПараметрыФормыДляВыбораСчета()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОграниченияСписокСчетов", СписокСчетов);
	ПараметрыФормы.Вставить("ВидСравненияВСписке",     Истина);
	ПараметрыФормы.Вставить("НаДату",                  Дата);
	ПараметрыФормы.Вставить("Организация", Организация);
	
	Возврат ПараметрыФормы;

КонецФункции

&НаКлиенте
Функция ПараметрыФормыДляВыбораКПС()

	ВидыПоказателей = Новый Массив;
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату",          Дата);
	Отбор.Вставить("Организация",     Организация);
	Отбор.Вставить("ИФО",             ИФО);
	Отбор.Вставить("ВидПоказателя", ВидыПоказателей);
	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	Возврат ПараметрыФормы;

КонецФункции

&НаКлиенте
Функция ПараметрыФормыДляВыбораКВД()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НаДату",          Дата);
	ПараметрыФормы.Вставить("Организация",     Организация);
	ПараметрыФормы.Вставить("ИФО",             ИФО);
	
	Возврат ПараметрыФормы;

КонецФункции

&НаКлиенте
Функция ПараметрыФормыДляВыбораКОСГУ()
	
	ПараметрыФормы = Новый Структура;
	УстановленныйСчет = УстановленныйСчет();
	Если ЗначениеЗаполнено(УстановленныйСчет) Тогда
		ОграниченияУчетнойПолитики = Новый Структура;
		ОграниченияУчетнойПолитики.Вставить("Организация", Организация);
		ОграниченияУчетнойПолитики.Вставить("ИФО", ИФО);
		
		ДополнительныйОтбор = Новый Структура;
		ДополнительныйОтбор.Вставить("Счет", УстановленныйСчет);
		ДополнительныйОтбор.Вставить("ДК", "Дт");
		ДополнительныйОтбор.Вставить("ОграниченияУчетнойПолитики", ОграниченияУчетнойПолитики);
		ДополнительныйОтбор.Вставить("НаДату", Дата);
		ДополнительныйОтбор.Вставить("ОграниченияКЭК", ДопустимыеКЭК.ВыгрузитьЗначения());
		
		ПараметрыФормы.Вставить("ДополнительныйОтбор", ДополнительныйОтбор);
		
	Иначе
		Отбор = Новый Структура("Ссылка", ДопустимыеКЭК.ВыгрузитьЗначения());
		Если ПроизвольныйКЭК Тогда
			Отбор.Ссылка.Добавить(КЭК000);
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Отбор", Отбор);
	КонецЕсли;
	Возврат ПараметрыФормы;

КонецФункции

&НаКлиенте
Функция УстановленныйСчет()

	Для Каждого Строка Из ТаблицаРеквизитов Цикл
		Если Строка.ИзменятьРеквизит Тогда
			ТипРеквизита = ?(Строка.ТипРеквизита.Типы().Количество() = 1,
				Строка.ТипРеквизита.Типы()[0], Неопределено);
			Если ТипРеквизита = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				Возврат Строка.ЗначениеРеквизита;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецФункции

#КонецОбласти

