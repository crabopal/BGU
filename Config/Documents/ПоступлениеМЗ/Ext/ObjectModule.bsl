	ВыборкаМатериалы.ЗаполнитьЗначения(ВыборкаШапка.КФО, "КФО");
	Материалы.Загрузить(ВыборкаМатериалы);
	ВыборкаТара = Результат[2].Выгрузить();
	ВыборкаТара.ЗаполнитьЗначения(ВыборкаШапка.КФО, "КФО");
	ВозвратнаяТара.Загрузить(ВыборкаТара);
	ВыборкаРНПТ = Результат[3].Выгрузить();
	СведенияПрослеживаемости.Загрузить(ВыборкаРНПТ);
	
	ПараметрыОбработкиСтроки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработкиСтроки.Вставить("ДтКт", "Дт");
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить(Материалы);
	ТабличныеЧасти.Добавить(ВозвратнаяТара);
	
	Для каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
	
		Для каждого Строка Из ТабличнаяЧасть Цикл
			
			Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
				ПараметрыОбработкиСтроки.ЗаполнятьСчет = НЕ ЗначениеЗаполнено(Строка.СчетУчета);
				ПараметрыОбработкиСтроки.Номенклатура = Строка.Номенклатура;
				УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработкиСтроки);
			ИначеЕсли Не ЗначениеЗаполнено(Строка.СчетУчета) Тогда
				Строка.СчетУчета = УправлениеМатериальнымиЗапасами.СчетУчетаСсылкаИзНоменклатуры(Строка.Номенклатура);
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла; 
	
	СуммаДокумента = Материалы.Итог("Всего") + ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

// Заполняет документ по договору, в котором указан предмет договора.
// 
// Параметры:
// 	ДанныеЗаполнения - СправочникСсылка.Договоры - Договор
Процедура ЗаполнитьПоДоговору(ДанныеЗаполнения)
	
	Если ЭтоНовый() И Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
		
	Документы.ПоступлениеМЗ.ЗаполнитьПоДоговору(ЭтотОбъект, ДанныеЗаполнения, Истина);
	
КонецПроцедуры

// Заполнить по регистрации обязательства.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам - Данные заполнения
Процедура ЗаполнитьПоРегистрацииОбязательства(ДанныеЗаполнения)
	
	 ЗаполнитьПоДоговору(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "Договор"));
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено)

	Если ДанныеЗаполнения.НеОтражаетсяВУчете Тогда
		ОписаниеОшибки = НСтр("ru='Для документа-основания на странице ""Дополнительно"" включен признак ""Электронный документ не отражается в учете"".'");

		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗ;
	
	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	ДатаПодписанияПервичногоДокумента = Дата;
	
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	ДокументОснование = ДанныеЗаполнения;
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00");
	
	ВходящееИзвещение = ДанныеЗаполнения.Извещение;
	Если ЗначениеЗаполнено(ВходящееИзвещение) Тогда
		РеквизитыИзвещения = "ТипЭлектронногоИзвещения";
		СтруктураДанныхИзвещения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВходящееИзвещение, РеквизитыИзвещения);
		Если СтруктураДанныхИзвещения.ТипЭлектронногоИзвещения = 29 Тогда
			ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика;
			СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34");
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование);
	КонецЕсли;
	
	ПараметрыОбработкиСтроки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработкиСтроки.Вставить("ДтКт", "Дт");
	ИспользуемыеИдентификаторы = Новый Массив;
	
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 1 Тогда 
			НоваяСтрока = Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.КоличествоМест = 1;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения");
			ПараметрыОбработкиСтроки.Номенклатура = НоваяСтрока.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока, ПараметрыОбработкиСтроки);
			Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
				ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
			КонецЕсли;
		ИначеЕсли СтрокаТЧ.КодВидаНоменклатуры = 5 Тогда 
			НоваяСтрокаВТ = ВозвратнаяТара.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаВТ, СтрокаТЧ);
			ПараметрыОбработкиСтроки.Номенклатура = НоваяСтрокаВТ.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрокаВТ, ПараметрыОбработкиСтроки);
			НоваяСтрокаВТ.ЦенаОприходования = СтрокаТЧ.Цена; 
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы);
	Если СведенияПрослеживаемости.Количество()>0 Тогда
		ОтражатьВПрослеживаемости = Истина;
		ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика;
		СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34");
		КодОперацииПрослеживаемости = Справочники.КодыОперацийПрослеживаемости.ПриобретениеПлательщикомНДС;
	КонецЕсли;	
	
	СуммаДокумента = Материалы.Итог("Всего");
	
КонецПроцедуры

Процедура ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.Количество КАК Количество,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.ЭлектронныйДокументПоставщика.СведенияПрослеживаемости КАК ЭлектронныйДокументПоставщикаСведенияПрослеживаемости
	|ГДЕ
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.Ссылка = &ДокументОснование
	|	И ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.ИдентификаторСтроки В(&ИспользуемыеИдентификаторы)";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ИспользуемыеИдентификаторы", ИспользуемыеИдентификаторы);
	
	СведенияПрослеживаемости.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры
 
Процедура ЗаполнитьПоТаксировкеПутевогоЛиста(ДанныеЗаполнения)
	Организация = ДанныеЗаполнения.Организация;
	
	ДокументОснование = ДанныеЗаполнения;
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика;
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	СуммаВключаетНДС = Истина;
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация);
	СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Дата, Организация);
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДанныеНеОтраженные = УчетГСМ.ДанныеОПоступленияхГСМДляТаксировки(ДанныеЗаполнения);
	
	ДанныеТаксировки = ДанныеТаксировки(ДанныеЗаполнения);
	
	РазныеИФО = ДанныеТаксировки.ИФО;
	Если РазныеИФО.Количество() > 0 Тогда
		ИФО = РазныеИФО[0].ИФО;
	КонецЕсли;	
	
	Если ДанныеНеОтраженные.Количество() > 0 Тогда
		ТекДокумент = ДанныеНеОтраженные[0];
		Контрагент = ТекДокумент.Контрагент;
		Договор = ТекДокумент.Договор;
		ЦМО = ДанныеТаксировки.ЦМО;
		Подразделение = ДанныеТаксировки.Подразделение;
		ОтветственныйИсполнитель = ДанныеТаксировки.ОтветственныйИсполнитель;
		ОтветственныйИсполнительБух = ДанныеТаксировки.ОтветственныйИсполнительБух;
		ВидПервичногоДокумента = ДанныеТаксировки.ВидПервичногоДокументаЗакупки;
		ДатаПервичногоДокумента = ДанныеТаксировки.ДатаПервичногоДокументаЗакупки;
		НомерПервичногоДокумента = ДанныеТаксировки.НомерПервичногоДокументаЗакупки;
		Если ЗначениеЗаполнено(ДатаПервичногоДокумента) Тогда
			Дата = ДатаПервичногоДокумента;
		КонецЕсли;
		
		ТаблицаМЗ = ДанныеТаксировки.Материалы;
		
		Материалы.Загрузить(ТаблицаМЗ);
		
		Для каждого СтрокаТЧ Из Материалы Цикл
			СтрокаТЧ.КЭК = БухгалтерскийУчет.КЭКСчета(Организация, ИФО, СтрокаТЧ.КФО, Дата, СтрокаТЧ.СчетУчета.Код, "Дт",,);
			
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СтавкаНДС", ПараметрыРасчета);
			
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры	

Функция ДанныеТаксировки(Таксировка)
	ТаблицаГСМ = Новый ТаблицаЗначений;
	ТаблицаИФО = Новый ТаблицаЗначений;
	
	Результат = Новый Структура;
	Результат.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
	Результат.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Результат.Вставить("ОтветственныйИсполнитель", Справочники.Сотрудники.ПустаяСсылка());
	Результат.Вставить("ОтветственныйИсполнительБух", Справочники.Сотрудники.ПустаяСсылка());
	Результат.Вставить("ВидПервичногоДокументаЗакупки", "Кассовый чек");
	Результат.Вставить("НомерПервичногоДокументаЗакупки", "");
	Результат.Вставить("ДатаПервичногоДокументаЗакупки", Дата(1,1,1));
	Результат.Вставить("Материалы", ТаблицаГСМ);
	Результат.Вставить("ИФО", ТаблицаИФО);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТаксировкаПутевогоЛистаМатериалы.ЦМО КАК ЦМО,
	               |	ТаксировкаПутевогоЛистаМатериалы.Подразделение КАК Подразделение,
	               |	ТаксировкаПутевогоЛистаМатериалы.Ссылка.МОЛ КАК МОЛ,
	               |	ТаксировкаПутевогоЛистаМатериалы.Ссылка.РасчетПроизвел КАК РасчетПроизвел
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста.Материалы КАК ТаксировкаПутевогоЛистаМатериалы
	               |ГДЕ
	               |	ТаксировкаПутевогоЛистаМатериалы.Ссылка = &СсылкаНаТаксировку
	               |	И НЕ ТаксировкаПутевогоЛистаМатериалы.ЦМО = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ВидГСМ КАК ВидГСМ,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Количество КАК Количество,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ДатаЗаправки КАК ДатаЗаправки,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.НомерДокументаОснования КАК НомерДокументаОснования,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Сумма КАК Сумма,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Сумма КАК Всего,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ПараметрыДоговораПоставкиГСМ КАК ПараметрыДоговораПоставкиГСМ,
	               |	НастройкиУчетаГСМДляОС.Номенклатура КАК Номенклатура,
	               |	НастройкиУчетаГСМДляОС.ИФО КАК ИФО,
	               |	НастройкиУчетаГСМДляОС.КФО КАК КФО,
	               |	НастройкиУчетаГСМДляОС.СчетУчета КАК СчетУчета,
	               |	НастройкиУчетаГСМДляОС.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	               |	НастройкиУчетаГСМДляОС.КПС КАК КПС,
	               |	1 КАК КоличествоМест,
	               |	1 КАК Коэффициент,
	               |	ВЫРАЗИТЬ(НастройкиУчетаГСМДляОС.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС КАК СтавкаНДС
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста.ЗаправкиГСМ КАК ТаксировкаПутевогоЛистаЗаправкиГСМ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаГСМДляОС КАК НастройкиУчетаГСМДляОС
	               |		ПО ТаксировкаПутевогоЛистаЗаправкиГСМ.Ссылка.Организация = НастройкиУчетаГСМДляОС.Организация
	               |			И ТаксировкаПутевогоЛистаЗаправкиГСМ.Ссылка.ТранспортноеСредство = НастройкиУчетаГСМДляОС.ОсновноеСредство
	               |			И ТаксировкаПутевогоЛистаЗаправкиГСМ.ВидГСМ = НастройкиУчетаГСМДляОС.ВидГСМ
	               |ГДЕ
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Ссылка = &СсылкаНаТаксировку
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаксировкаПутевогоЛистаМатериалы.ИФО КАК ИФО
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста.Материалы КАК ТаксировкаПутевогоЛистаМатериалы
	               |ГДЕ
	               |	ТаксировкаПутевогоЛистаМатериалы.Ссылка = &СсылкаНаТаксировку";
	
	Запрос.УстановитьПараметр("СсылкаНаТаксировку", Таксировка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ЦМО = Выборка.ЦМО;
		Результат.Подразделение = Выборка.Подразделение;
		Результат.ОтветственныйИсполнитель = Выборка.МОЛ;
		Результат.ОтветственныйИсполнительБух = Выборка.РасчетПроизвел;
	КонецЕсли;	
	
	ТаблицаМатериалов = РезультатЗапроса[1].Выгрузить();
	Результат.Материалы = ТаблицаМатериалов;
	ТаблицаИФО = РезультатЗапроса[2].Выгрузить();
	Результат.ИФО = ТаблицаИФО;
	Если ТаблицаМатериалов.Количество() > 0 Тогда 
		Результат.НомерПервичногоДокументаЗакупки = ТаблицаМатериалов[0].НомерДокументаОснования;
		Результат.ДатаПервичногоДокументаЗакупки = ТаблицаМатериалов[0].ДатаЗаправки;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Материалы.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='%2 списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА, Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	
КонецПроцедуры	

