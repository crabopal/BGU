#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Неопределено") Тогда
		
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		
	ИначеЕсли ЭтоЗаполнениеНаОснованииИнвентаризации0510466(ДанныеЗаполнения) Тогда
		ЗаполнитьПоИнвентаризации0510466(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("КорректируемыйДокумент") Тогда
			ДокументОснование = ДанныеЗаполнения.КорректируемыйДокумент; 
			ЗаполнитьКорректировку();
		Иначе
			
			Если ДанныеЗаполнения.Свойство("ВалютаДокумента") Тогда
				ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
			КонецЕсли;
			
			ДанныеЗаполнения.Свойство("Основание", Основание);
			
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
				СтандартнаяОбработка = Ложь;
				Документы.ИнвентаризацияМЗ.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				
				Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Основание.Организация) Тогда
					РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Основание);
					Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
						ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(Основание, РазличающаясяНоменклатураКонтрагентаИОрганизации);
						ВызватьИсключение ТекстСообщения;
					КонецЕсли;
				КонецЕсли;	
				
				ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание, ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить());
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
				СтандартнаяОбработка = Ложь;
				ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения.Основание);
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения);
		
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ДанныеЗаполнения)) Тогда
		
		ЗаполнитьПоОснованию(ДанныеЗаполнения, СтандартнаяОбработка);

	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	ПрослеживаемостьБГУ.УдалениеПроведенияПервичногоДокумента(Ссылка);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(ЭтотОбъект) Тогда
		ОчиститьНДСВСтроках();
	КонецЕсли;
	СуммаДокумента = Материалы.Итог("Всего") + ВозвратнаяТара.Итог("Сумма");
	
	КэшТиповДопСубконто = Новый Соответствие;
	УправлениеМатериальнымиЗапасами.ПривестиЗначенияДопСубконтоВТабличнойЧасти(Материалы, КэшТиповДопСубконто);
	УправлениеМатериальнымиЗапасами.ПривестиЗначенияДопСубконтоВТабличнойЧасти(ВозвратнаяТара, КэшТиповДопСубконто);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ВидПоступленияМЗ <> Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика
		И ДенежныеОбязательства.Количество() > 0 Тогда
		
		ДенежныеОбязательства.Очистить();
	КонецЕсли;
	
	Если ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Дата) Тогда
		Если ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика Тогда
			ОтражатьВПрослеживаемости = Истина;
		КонецЕсли;
	Иначе
		ОтражатьВПрослеживаемости = Ложь;
	КонецЕсли;
	ОбщегоНазначенияБГУ.ОчиститьВидМежотчетногоПериода(ЭтотОбъект);
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
	Если Не ЭтоКорректировка Тогда
		НомерКорректировки = 0;
	КонецЕсли;
	
	Если Не НесколькоКПСРасчетов Тогда
		
		СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
		СтруктураДействий.ОчиститьКПСРасчетов = Истина;
		УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(Материалы, СтруктураДействий);
		УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(ВозвратнаяТара, СтруктураДействий);

	КонецЕсли;
	
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Материалы", Истина);
	ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, ,"Оприходование комплекта", Отказ);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Материалы.СтранаПроисхождения");
	
	ПроверитьЗаполнениеОтсутствияЧленовКомиссии(НепроверяемыеРеквизиты, Отказ);
	УчетРасчетов.ЗачетАвансовВыданныхОбработкаПроверкиЗаполнения(ЭтотОбъект, НепроверяемыеРеквизиты, Отказ);
	
	Если Не Документы.ПоступлениеМЗ.ЗаполнятьДатуНомерДокументаПоставщика(ЭтотОбъект) Тогда
		НепроверяемыеРеквизиты.Добавить("НомерПервичногоДокумента");
		НепроверяемыеРеквизиты.Добавить("ДатаПервичногоДокумента");
	КонецЕсли;
	
	Если ВидПоступленияМЗ <> Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика Тогда
		НепроверяемыеРеквизиты.Добавить("СчетРасчетов");
		НепроверяемыеРеквизиты.Добавить("ДенежныеОбязательства.КФО");
		НепроверяемыеРеквизиты.Добавить("ДенежныеОбязательства.КПС");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетУчета) 
		И НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(СчетУчета).УчетПоКПС Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.КПС");
	КонецЕсли;
	
	Если ВидПоступленияМЗ <> Перечисления.ВидыПоступленийМЗ.ВозвратОтПокупателя Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.ЦенаОприходования");
		НепроверяемыеРеквизиты.Добавить("ВозвратнаяТара.ЦенаОприходования");
	КонецЕсли;
	
	Если ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.Всего");
	КонецЕсли;
		
	Если ВидПоступленияМЗ <> Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета Тогда
		НепроверяемыеРеквизиты.Добавить("ЗабалансовыйСчет");
	КонецЕсли;
	
	Если Не БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.ЦМО) Тогда
		НепроверяемыеРеквизиты.Добавить("ЦМО");
	КонецЕсли;
	
	Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ОбязательностьЗаполненияРеквизита(ЭтотОбъект, "ДокументОснование") Тогда
		НепроверяемыеРеквизиты.Добавить("ДокументОснование");
	КонецЕсли; 
		
	Если НЕ НесколькоКПСРасчетов Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.КПСРасчетов");
		НепроверяемыеРеквизиты.Добавить("ВозвратнаяТара.КПСРасчетов");
	КонецЕсли;
	
	ДобавитьНепроверяемыеСубконтоЗабалансовогоСчета(НепроверяемыеРеквизиты);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	ПрослеживаемостьБГУ.СформироватьДвижения(ЭтотОбъект);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	Если УправлениеМатериальнымиЗапасами.СчетУчетаРавен105(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасами.СчетУчетаРавен106(ЭтотОбъект) Тогда
			
		ОбязательноЗаполнитьКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ОбъектКопирования.Дата,
			ОбъектКопирования.Организация,
			ДатаНовогоДокумента,
			Организация);
		
		УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
			ОбязательноЗаполнитьКЭК);
	КонецЕсли;
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ОчиститьДопСубконто =
		УправлениеМатериальнымиЗапасами.ПараметрыПроверкиЗаполненияДопСубконто(ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования, Дата, Организация);
	УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(Материалы, СтруктураДействий);

	ОбщегоНазначенияБГУ.ОчиститьВидМежотчетногоПериода(ЭтотОбъект);
	ЭтоКорректировка   = Ложь;
	НомерКорректировки = 0;
	ДокументОснование  = Неопределено;
	НФАПереданыЭлектроннымАктом = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеОтсутствияЧленовКомиссии(НепроверяемыеРеквизиты, Отказ)
	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
		Если СтрокаКомиссии.Отсутствует И Не ЗначениеЗаполнено(СтрокаКомиссии.ПричинаОтсутствия) Тогда
			ПутьКРеквизиту = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаКомиссии.НомерСтроки, "ПричинаОтсутствия");
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , НСтр("ru = 'Причина отсутствия'"), СтрокаКомиссии.НомерСтроки, НСтр("ru = 'Состав комиссии'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Объект", ПутьКРеквизиту, Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьНепроверяемыеСубконтоЗабалансовогоСчета(НепроверяемыеРеквизиты)
	МаксимальноеКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	Если ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета
		И ЗначениеЗаполнено(ЗабалансовыйСчет) Тогда

		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЗабалансовыйСчет);
		Для Счетчик = 1 По МаксимальноеКоличествоСубконто Цикл
			Если Счетчик > СвойстваСчета.КоличествоСубконто
				Или СвойстваСчета["ВидСубконто" + Счетчик] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				Или НЕ СвойстваСчета["ВидСубконто" + Счетчик + "Обязательный"] Тогда
				НепроверяемыеРеквизиты.Добавить("Материалы.СубконтоЗабалансовыйСчет" + Счетчик);
			КонецЕсли;
		КонецЦикла;
		 			
	Иначе
		Для Счетчик = 1 По МаксимальноеКоличествоСубконто Цикл
			НепроверяемыеРеквизиты.Добавить("Материалы.СубконтоЗабалансовыйСчет" + Счетчик);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьНДСВСтроках()
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	Для Каждого Строка Из Материалы Цикл
		Если ЗначениеЗаполнено(Строка.СтавкаНДС) И Строка.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
			Строка.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(Строка, "Сумма", ПараметрыРасчета);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоОснованию(ДанныеЗаполнения, СтандартнаяОбработка = Истина) Экспорт

	ТипОснования = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипОснования = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		ЗаполнитьКорректировку();
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПоступлениеМЗВПути") Тогда
		
		ДокументОснование = ДанныеЗаполнения; 
		ЗаполнитьПоПоступлениюВПути(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗ") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		ЗаполнитьПоРешениюОПризнанииОбъектовМЗ(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипОснования = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		
		ДокументОснование = ДанныеЗаполнения; 
		ЗаполнитьПоРеализации(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктПриемкиМ7") Тогда
		
		ЗаполнитьПоАктуПриемки(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("СправочникСсылка.Договоры") Тогда
			
		ЗаполнитьПоДоговору(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда	
		
		ЗаполнитьПоРегистрацииОбязательства(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	

		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС") Тогда
		
		ИнтеграцияВЕТИСБГУ.ЗаполнитьПоступлениеТоваровНаОснованииВходящейТранспортнойОперацииВЕТИС(ЭтотОбъект, ДанныеЗаполнения,, СтандартнаяОбработка);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ИнвентаризацияПродукцииВЕТИС") Тогда
		
		ИнтеграцияВЕТИСБГУ.ЗаполнитьОприходованиеТоваровНаОснованииИнвентаризацииПродукцииВЕТИС(ЭтотОбъект, ДанныеЗаполнения,, СтандартнаяОбработка);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.СписаниеБСО") Тогда
		
		ЗаполнитьПоСписаниюБСО(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") Тогда
		
		ЗаполнитьПоТаксировкеПутевогоЛиста(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		
		ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктОбУтилизацииМЗ")
		Или ТипОснования = Тип("ДокументСсылка.АктОбУтилизацииОС") Тогда
			
		ЗаполнитьПоАктуОбУтилизации(ДанныеЗаполнения);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Документы.ПоступлениеМЗ.ЗаполнитьПоИнвентаризации0510466(ДокументОснование, ЭтотОбъект)
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоАктуОбУтилизации(ДанныеЗаполнения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШапкаДокумента.Организация КАК Организация,
	|	ШапкаДокумента.ИФО КАК ИФО,
	|	ШапкаДокумента.Подразделение КАК Подразделение,
	|	ШапкаДокумента.ЦМО КАК ЦМО,
	|	ШапкаДокумента.ГолосованиеЗаПолученныеМатериалы КАК ГолосованиеЗаПолученныеМатериалы
	|ИЗ
	|	#Документ КАК ШапкаДокумента
	|ГДЕ
	|	ШапкаДокумента.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПолученныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПолученныеМатериалы.Номенклатура КАК Номенклатура,
	|	ПолученныеМатериалы.Номенклатура.СчетУчета КАК НоменклатураСчетУчета,
	|	ПолученныеМатериалы.Номенклатура.ТипНоменклатуры КАК НоменклатураТипНоменклатуры,
	|	ПолученныеМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПолученныеМатериалы.Цена КАК Цена,
	|	ПолученныеМатериалы.Количество КАК Количество,
	|	ПолученныеМатериалы.Сумма КАК Сумма,
	|	ПолученныеМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	#ТаблицаДокумента КАК ПолученныеМатериалы
	|ГДЕ
	|	ПолученныеМатериалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДрагоценныеМатериалыВПолученныхМЦ.ОбъектНФА КАК ОбъектНФА,
	|	ДрагоценныеМатериалыВПолученныхМЦ.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СУММА(ДрагоценныеМатериалыВПолученныхМЦ.МассаДМ) КАК МассаДМ,
	|	ДрагоценныеМатериалыВПолученныхМЦ.ЕдИзм КАК ЕдИзм,
	|	СУММА(ДрагоценныеМатериалыВПолученныхМЦ.КоличествоДМ) КАК КоличествоДМ
	|ИЗ
	|	#ТаблицаДрагМатериаловДокумента КАК ДрагоценныеМатериалыВПолученныхМЦ
	|ГДЕ
	|	ДрагоценныеМатериалыВПолученныхМЦ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДрагоценныеМатериалыВПолученныхМЦ.ОбъектНФА,
	|	ДрагоценныеМатериалыВПолученныхМЦ.ВидДрагМатериала,
	|	ДрагоценныеМатериалыВПолученныхМЦ.ЕдИзм";
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	ИмяДокументаОснования = ДанныеЗаполнения.Метаданные().ПолноеИмя();
	ИмяТаблицыПолученныеМатериалы = ИмяДокументаОснования + ".ПолученныеМатериалы";
	ИмяТаблицыДрагоценныеМатериалыВПолученныхМЦ = ИмяДокументаОснования + ".ДрагоценныеМатериалыВПолученныхМЦ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Документ", ИмяДокументаОснования);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаДокумента", ИмяТаблицыПолученныеМатериалы);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаДрагМатериаловДокумента", ИмяТаблицыДрагоценныеМатериалыВПолученныхМЦ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ГолосованиеЗаПолученныеМатериалы = Ложь;
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		Организация = ВыборкаШапка.Организация;
		ИФО = ВыборкаШапка.ИФО;
		Подразделение = ВыборкаШапка.Подразделение;
		ЦМО = ВыборкаШапка.ЦМО;
		ГолосованиеЗаПолученныеМатериалы = ВыборкаШапка.ГолосованиеЗаПолученныеМатериалы;
	КонецЕсли;
	
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00");
	ДокументОснование = ДанныеЗаполнения;
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	
	КЭШСчетов = Новый Соответствие;
	Если ГолосованиеЗаПолученныеМатериалы Тогда
		РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеЗаполнения));
		ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", ДанныеЗаполнения, "");
	КонецЕсли;
	
	СуммаДокумента = 0;
	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ВыборкаСтроки = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаСтроки.Следующий() Цикл
		Если ГолосованиеЗаПолученныеМатериалы Тогда
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = ВыборкаСтроки.ИдентификаторСтроки;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() = 0
					Или Не РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтроки);
		СохраненныйСчет = КЭШСчетов.Получить(ВыборкаСтроки.НоменклатураСчетУчета);
		Если СохраненныйСчет = Неопределено Тогда
			СохраненныйСчет = БухгалтерскийУчет.СчетПоКоду(ВыборкаСтроки.НоменклатураСчетУчета, ОбщегоНазначения.ТекущаяДатаПользователя(), Организация);
			КЭШСчетов.Вставить(ВыборкаСтроки.НоменклатураСчетУчета, СохраненныйСчет);
		КонецЕсли;
		НоваяСтрока.СчетУчета = СохраненныйСчет;
		НоваяСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Организация,
			ИФО,
			Перечисления.КВД.ПустаяСсылка(),
			ОбщегоНазначения.ТекущаяДатаПользователя(),
			НоваяСтрока.СчетУчета,
			ВыборкаСтроки.НоменклатураТипНоменклатуры,
			"Дт");
		НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Всего;
	КонецЦикла;

	ВыборкаСтрокиДМ = РезультатЗапроса[2].Выбрать();
	Пока ВыборкаСтрокиДМ.Следующий() Цикл
		НоваяСтрока = ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтрокиДМ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКорректировку()

	УправлениеМатериальнымиЗапасами.ПроверитьДокументОснованиеНеКорректировался(ДокументОснование, Ссылка);
	
	ОснованиеОбъект = ДокументОснование.ПолучитьОбъект();
	Если ОснованиеОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКорректировкуШапка(ОснованиеОбъект);
	ЗаполнитьКорректировкуМатериалы(ОснованиеОбъект);
	ЗаполнитьКорректировкуВозвратнаяТара(ОснованиеОбъект);
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ЗачетАвансов"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ДрагоценныеМатериалы"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ДополнительныеРеквизиты"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ДенежныеОбязательства"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "СведенияПрослеживаемости"); 	
	
	ЭтоКорректировка = Истина;
	НомерКорректировки = ОснованиеОбъект.НомерКорректировки + 1;

КонецПроцедуры

Процедура ЗаполнитьПоСписаниюБСО(ДанныеЗаполнения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписаниеБСО.Организация,
	|	СписаниеБСО.ИФО,
	|	СписаниеБСО.ЦМО,
	|	СписаниеБСО.Подразделение,
	|	СписаниеБСО.ВидМежотчетногоПериода,
	|	СписаниеБСО.Дата
	|ИЗ
	|	Документ.СписаниеБСО КАК СписаниеБСО
	|ГДЕ
	|	СписаниеБСО.Ссылка = &Ссылка
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НоменклатураБСО.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	|		ИНАЧЕ СписаниеБСОСоставБСО.БСО
	|	КОНЕЦ КАК БСО,
	|	СУММА(СписаниеБСОСоставБСО.Количество) КАК Количество,
	|	НоменклатураБСО.Номенклатура,
	|	НоменклатураБСО.Номенклатура.СчетУчета КАК СчетУчета,
	|	СписаниеБСО.КФО
	|ИЗ
	|	Документ.СписаниеБСО.СоставБСО КАК СписаниеБСОСоставБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО КАК СписаниеБСО
	|		ПО СписаниеБСОСоставБСО.Ссылка = СписаниеБСО.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Номенклатура.БСО,
	|			МАКСИМУМ(Номенклатура.Ссылка) КАК Номенклатура
	|		ИЗ
	|			Справочник.Номенклатура КАК Номенклатура
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО.СоставБСО КАК СписаниеБСОСоставБСО
	|				ПО Номенклатура.БСО = СписаниеБСОСоставБСО.БСО
	|		ГДЕ
	|			СписаниеБСОСоставБСО.Ссылка = &Ссылка
	|		СГРУППИРОВАТЬ ПО
	|			Номенклатура.БСО) КАК НоменклатураБСО
	|		ПО СписаниеБСОСоставБСО.БСО = НоменклатураБСО.БСО
	|ГДЕ
	|	СписаниеБСОСоставБСО.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураБСО.Номенклатура,
	|	ВЫБОР
	|		КОГДА НоменклатураБСО.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	|		ИНАЧЕ СписаниеБСОСоставБСО.БСО
	|	КОНЕЦ,
	|	СписаниеБСО.КФО";
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	КонецЕсли;
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация);
	ДокументОснование = ДанныеЗаполнения;
	
	КЭШСчетов = Новый Соответствие;
	КОСГУ = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	
	ВыборкаСтроки = РезультатЗапроса[1].Выбрать();
	Материалы.Очистить();
	ВозвратнаяТара.Очистить();
	Пока ВыборкаСтроки.Следующий() Цикл
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтроки);
		НоваяСтрока.Сумма = НоваяСтрока.Количество;
		НоваяСтрока.Всего = НоваяСтрока.Количество;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
		НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Если ЗначениеЗаполнено(ВыборкаСтроки.СчетУчета) Тогда
			СчетУчетаСтр = КЭШСчетов.Получить(ВыборкаСтроки.СчетУчета);
			Если СчетУчетаСтр = Неопределено Тогда
				СчетУчетаСтр = БухгалтерскийУчет.СчетПоКоду(ВыборкаСтроки.СчетУчета, Дата, Организация);
				Если НЕ ЗначениеЗаполнено(СчетУчетаСтр) Тогда
					 СчетУчетаСтр = БухгалтерскийУчет.СчетПоКоду("105.36", Дата, Организация);
				КонецЕсли;
				КЭШСчетов.Вставить(ВыборкаСтроки.СчетУчета, СчетУчетаСтр);
			КонецЕсли;
		Иначе
			СчетУчетаСтр = БухгалтерскийУчет.СчетПоКоду("105.36", Дата, Организация);
		КонецЕсли;
		НоваяСтрока.СчетУчета = СчетУчетаСтр;
		НоваяСтрока.КЭК = КОСГУ;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьПоАктуПриемки(ДанныеЗаполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктПриемкиМ7.Организация КАК Организация,
	|	АктПриемкиМ7.ИФО КАК ИФО,
	|	АктПриемкиМ7.Контрагент КАК Контрагент,
	|	АктПриемкиМ7.Договор КАК Договор,
	|	АктПриемкиМ7.ЦМО КАК ЦМО,
	|	АктПриемкиМ7.Дата КАК Дата,
	|	АктПриемкиМ7.Грузоотправитель КАК Грузоотправитель,
	|	АктПриемкиМ7.Подразделение КАК Подразделение,
	|	АктПриемкиМ7.НомерВходящегоДокумента КАК НомерПервичногоДокумента,
	|	АктПриемкиМ7.ДатаВходящегоДокумента КАК ДатаПервичногоДокумента,
	|	АктПриемкиМ7.ВидВходящегоДокумента КАК ВидПервичногоДокумента,
	|	АктПриемкиМ7.Проведен КАК Проведен
	|ИЗ
	|	Документ.АктПриемкиМ7 КАК АктПриемкиМ7
	|ГДЕ
	|	АктПриемкиМ7.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктПриемкиМ7Материалы.Номенклатура КАК Номенклатура,
	|	АктПриемкиМ7Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	АктПриемкиМ7Материалы.Цена КАК Цена,
	|	АктПриемкиМ7Материалы.КоличествоБой + АктПриемкиМ7Материалы.КоличествоИзлишки КАК Количество,
	|	АктПриемкиМ7Материалы.КПС КАК КПС,
	|	АктПриемкиМ7Материалы.СчетУчета КАК СчетУчета,
	|	АктПриемкиМ7Материалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	АктПриемкиМ7Материалы.КФО КАК КФО,
	|	АктПриемкиМ7Материалы.КЭК КАК КЭК,
	|	ВЫБОР
	|		КОГДА АктПриемкиМ7Материалы.КоличествоБой + АктПриемкиМ7Материалы.КоличествоИзлишки = АктПриемкиМ7Материалы.КоличествоПоДокументам
	|			ТОГДА АктПриемкиМ7Материалы.СуммаПоДокументам
	|		КОГДА АктПриемкиМ7Материалы.КоличествоБой + АктПриемкиМ7Материалы.КоличествоИзлишки = 0
	|			ТОГДА 0
	|		ИНАЧЕ (АктПриемкиМ7Материалы.КоличествоБой + АктПриемкиМ7Материалы.КоличествоИзлишки) * АктПриемкиМ7Материалы.Сумма / АктПриемкиМ7Материалы.Количество
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	Документ.АктПриемкиМ7.Материалы КАК АктПриемкиМ7Материалы
	|ГДЕ
	|	АктПриемкиМ7Материалы.Ссылка = &Ссылка
	|	И (АктПриемкиМ7Материалы.КоличествоБой > 0
	|			ИЛИ АктПриемкиМ7Материалы.КоличествоИзлишки > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктПриемкиМ7Материалы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		Если Не ВыборкаШапка.Проведен Тогда
			ВызватьИсключение НСтр("ru = 'Документ-основание должен быть проведен'");
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДокументОснование = ДанныеЗаполнения;
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	
	Счет02 = БухгалтерскийУчет.СчетПоКоду("02.2", Дата, Организация);
	ИспользоватьСчет02 = ЗначениеЗаполнено(Счет02);
	Если ИспользоватьСчет02 Тогда
		СчетУчета = Счет02;
		СвойстваСчета02 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет02);
		УчетПоКПС = СвойстваСчета02.УчетПоКПС;
		УчетПоКЭК = СвойстваСчета02.УчетПоКЭК;
	Иначе
		УчетПоКПС = Истина;
		УчетПоКЭК = Истина;
	КонецЕсли;
	
	Материалы.Очистить();
	СуммаДокумента = 0;
	ВыборкаМатериалы = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы);
		НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.Всего = НоваяСтрока.Сумма;
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Сумма;
		Если ИспользоватьСчет02 Тогда
			НоваяСтрока.СчетУчета = Счет02;
			НоваяСтрока.ДополнительнаяАналитикаСчета = Контрагент;
		КонецЕсли;
		Если Не УчетПоКПС Тогда
			НоваяСтрока.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		КонецЕсли;
		Если Не УчетПоКЭК Тогда
			НоваяСтрока.КЭК = Справочники.КОСГУ.ПустаяСсылка();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлениюВПути(ДанныеЗаполнения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПоступлениеМЗвПути", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СчетПоКоду("105.00"));
	Запрос.УстановитьПараметр("Счет107", БухгалтерскийУчет.СписокСчетов("107.00"));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(, Счет В (&Счет107), , Субконто3 = &ПоступлениеМЗвПути) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПоступлениеМЗВПути.Организация КАК Организация,
	|	ПоступлениеМЗВПути.ИФО КАК ИФО,
	|	ПоступлениеМЗВПути.Подразделение КАК Подразделение,
	|	ПоступлениеМЗВПути.Контрагент КАК Контрагент,
	|	ПоступлениеМЗВПути.Договор КАК Договор,
	|	ПоступлениеМЗВПути.ВалютаДокумента КАК ВалютаДокумента,
	|	ПоступлениеМЗВПути.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ПоступлениеМЗВПути.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ПоступлениеМЗВПути.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ПоступлениеМЗВПути.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	&Счет105 КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Перечисление.СпособыЗачетаАвансов.НеЗачитывать) КАК СпособЗачетаАванса,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.Поступление) КАК ВидПоступленияМЗ,
	|	ПоступлениеМЗВПути.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
	|	ПоступлениеМЗВПути.ПринятьНДСКВычетуУказываетсяВСтроках
	|ИЗ
	|	Документ.ПоступлениеМЗВПути КАК ПоступлениеМЗВПути
	|ГДЕ
	|	ПоступлениеМЗВПути.Ссылка = &ПоступлениеМЗвПути
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧМатериалы.НомерСтроки КАК НомерСтроки,
	|	ТЧМатериалы.Номенклатура КАК Номенклатура,
	|	ТЧМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	ТЧМатериалы.Коэффициент КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА ТЧМатериалы.Коэффициент <> 0
	|			ТОГДА Остатки.КоличествоОстаток / ТЧМатериалы.Коэффициент
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоМест,
	|	Остатки.СуммаОстаток КАК Всего,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
	|	ТЧМатериалы.Номенклатура.СчетУчета КАК НоменклатураСчетУчета,
	|	ТЧМатериалы.КПС КАК КПС,
	|	ТЧМатериалы.КФО КАК КФО,
	|	ТЧМатериалы.КЭК КАК КЭК,
	|	ТЧМатериалы.Номенклатура.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТЧМатериалы.Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТЧМатериалы.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
	|	ТЧМатериалы.НДСКРаспределению КАК НДСКРаспределению
	|ИЗ
	|	Документ.ПоступлениеМЗВПути.Материалы КАК ТЧМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТЧМатериалы.Номенклатура = Остатки.Номенклатура
	|			И ТЧМатериалы.СчетУчета = Остатки.Счет
	|			И ТЧМатериалы.КПС = Остатки.КПС
	|			И ТЧМатериалы.КФО = Остатки.КФО
	|ГДЕ
	|	ТЧМатериалы.Ссылка = &ПоступлениеМЗвПути
	|	И Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧТара.НомерСтроки КАК НомерСтроки,
	|	ТЧТара.Номенклатура КАК Номенклатура,
	|	ТЧТара.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	ТЧТара.Номенклатура.СчетУчета КАК НоменклатураСчетУчета,
	|	ТЧТара.КПС КАК КПС,
	|	ТЧТара.КФО КАК КФО,
	|	ТЧТара.КЭК КАК КЭК
	|ИЗ
	|	Документ.ПоступлениеМЗВПути.ВозвратнаяТара КАК ТЧТара
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТЧТара.Номенклатура = Остатки.Номенклатура
	|			И ТЧТара.СчетУчета = Остатки.Счет
	|			И ТЧТара.КПС = Остатки.КПС
	|			И ТЧТара.КФО = Остатки.КФО
	|ГДЕ
	|	ТЧТара.Ссылка = &ПоступлениеМЗвПути
	|	И Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РезультатЗапроса[1].Выгрузить()[0]);
	
	ПараметрыОбработкиСтроки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработкиСтроки.Вставить("ДтКт", "Дт");
	
	Материалы.Очистить();
	ВыборкаМатериалы = РезультатЗапроса[2].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
	
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы);
		НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду(ВыборкаМатериалы.НоменклатураСчетУчета);
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Всего;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			ПараметрыОбработкиСтроки.Счет          = НоваяСтрока.СчетУчета;
			ПараметрыОбработкиСтроки.ЗаполнятьСчет = НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчета);
			ПараметрыОбработкиСтроки.Номенклатура  = НоваяСтрока.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока, ПараметрыОбработкиСтроки);
		КонецЕсли;
	
	КонецЦикла;
	
	ВозвратнаяТара.Очистить();
	ВыборкаТара = РезультатЗапроса[3].Выбрать();
	Пока ВыборкаТара.Следующий() Цикл
	
		НоваяСтрока = ВозвратнаяТара.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТара);
		НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду(ВыборкаТара.НоменклатураСчетУчета);
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Сумма;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			ПараметрыОбработкиСтроки.Счет          = НоваяСтрока.СчетУчета;
			ПараметрыОбработкиСтроки.ЗаполнятьСчет = НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчета);
			ПараметрыОбработкиСтроки.Номенклатура  = НоваяСтрока.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока, ПараметрыОбработкиСтроки);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоРешениюОПризнанииОбъектовМЗ(ДанныеЗаполнения)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовМЗ.Организация КАК Организация,
	|	РешениеОПризнанииОбъектовМЗ.ИФО КАК ИФО,
	|	РешениеОПризнанииОбъектовМЗ.Подразделение КАК Подразделение,
	|	РешениеОПризнанииОбъектовМЗ.ЦМО КАК ЦМО,
	|	РешениеОПризнанииОбъектовМЗ.Контрагент КАК Контрагент,
	|	РешениеОПризнанииОбъектовМЗ.Договор КАК Договор,
	|	РешениеОПризнанииОбъектовМЗ.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовМЗ КАК РешениеОПризнанииОбъектовМЗ
	|ГДЕ
	|	РешениеОПризнанииОбъектовМЗ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовМЗМатериалы.Номенклатура КАК Номенклатура,
	|	РешениеОПризнанииОбъектовМЗМатериалы.Количество КАК Количество,
	|	РешениеОПризнанииОбъектовМЗМатериалы.Сумма КАК Сумма,
	|	РешениеОПризнанииОбъектовМЗМатериалы.СчетУчета КАК СчетУчета,
	|	РешениеОПризнанииОбъектовМЗМатериалы.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	РешениеОПризнанииОбъектовМЗМатериалы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(РешениеОПризнанииОбъектовМЗМатериалы.Номенклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры
	|ИЗ
