// Заполнить по входящему извещению.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.ИзвещениеВходящее -
Процедура ЗаполнитьПоВходящемуИзвещению(ДанныеЗаполнения)
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, Поставщик, Договор, ИФО");
	
	Дата               = ОбщегоНазначения.ТекущаяДатаПользователя();
	ДокументОснование  = ДанныеЗаполнения;
	Организация        = ДанныеОснования.Организация;
	ИФО                = ДанныеОснования.ИФО;
	Контрагент         = ДанныеОснования.Поставщик;
	Договор            = ДанныеОснования.Договор;
	ВидПоступленияМЗ   = Перечисления.ВидыПоступленийМЗ.Поступление;
	СчетУчета          = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация);
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	СуммаВключаетНДС   = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	СпрНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА &ВестиУчетПрослеживаемыхТоваров
	|			ТОГДА СпрНоменклатура.ПрослеживаемыйТовар
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПрослеживаемыйТовар,
	|	СпрНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	СпрНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ЕСТЬNULL(ПланСчетов.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
	|ПОМЕСТИТЬ СчетаУчетаНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ПланСчетов
	|		ПО СпрНоменклатура.СчетУчета = ПланСчетов.Код
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзвещениеВходящее.Материалы КАК Материалы
	|		ПО СпрНоменклатура.Ссылка = Материалы.Номенклатура
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Ссылка,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	СпрНоменклатура.ТипНоменклатуры,
	|	ЕСТЬNULL(ПланСчетов.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ПланСчетов
	|		ПО СпрНоменклатура.СчетУчета = ПланСчетов.Код
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзвещениеВходящее.ВозвратнаяТара КАК ВозвратнаяТара
	|		ПО СпрНоменклатура.Ссылка = ВозвратнаяТара.Номенклатура
	|ГДЕ
	|	ВозвратнаяТара.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.КФО КАК КФО,
	|	Материалы.Количество КАК Количество,
	|	Материалы.Сумма КАК Сумма,
	|	СчетаУчетаНоменклатуры.СчетУчета КАК СчетУчета,
	|	СчетаУчетаНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	|	СчетаУчетаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СчетаУчетаНоменклатуры.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	СчетаУчетаНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	|	СчетаУчетаНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Документ.ИзвещениеВходящее.Материалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаУчетаНоменклатуры КАК СчетаУчетаНоменклатуры
	|		ПО Материалы.Номенклатура = СчетаУчетаНоменклатуры.Номенклатура
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратнаяТара.Номенклатура КАК Номенклатура,
	|	ВозвратнаяТара.КФО КАК КФО,
	|	ВозвратнаяТара.Количество КАК Количество,
	|	ВозвратнаяТара.Сумма КАК Сумма,
	|	СчетаУчетаНоменклатуры.СчетУчета КАК СчетУчета,
	|	СчетаУчетаНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Документ.ИзвещениеВходящее.ВозвратнаяТара КАК ВозвратнаяТара
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаУчетаНоменклатуры КАК СчетаУчетаНоменклатуры
	|		ПО ВозвратнаяТара.Номенклатура = СчетаУчетаНоменклатуры.Номенклатура
	|ГДЕ
	|	ВозвратнаяТара.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВозвратнаяТара.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("ВестиУчетПрослеживаемыхТоваров", ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	КПССчетов = Новый ТаблицаЗначений;
	КПССчетов.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КПССчетов.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	КПССчетов.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КПССчетов.Индексы.Добавить("СчетУчета, КФО");
	
	ПараметрыРасчетаСтроки = Новый Структура;
	ПараметрыРасчетаСтроки.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	Материалы.Очистить();
	ВыборкаМатериалы = Результат[1].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		СтрокаМатериалы = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, ВыборкаМатериалы);
		СтрокаМатериалы.КоличествоМест = СтрокаМатериалы.Количество;
		СтрокаМатериалы.Коэффициент = 1;
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаМатериалы, "Сумма", ПараметрыРасчетаСтроки);
		СтрокаМатериалы.КПС = ПолучитьКПССчета(СтрокаМатериалы.СчетУчета, СтрокаМатериалы.КФО, КПССчетов);
		СтрокаМатериалы.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Организация, ИФО, СтрокаМатериалы.КФО,
			Дата, СтрокаМатериалы.СчетУчета, ВыборкаМатериалы.ТипНоменклатуры, "Дт");
	КонецЦикла;
	
	ВозвратнаяТара.Очистить();
	ВыборкаВозвратнаяТара = Результат[2].Выбрать();
	Пока ВыборкаВозвратнаяТара.Следующий() Цикл
		СтрокаВозвратнаяТара = ВозвратнаяТара.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВозвратнаяТара, ВыборкаВозвратнаяТара);
		СтрокаВозвратнаяТара.КПС = ПолучитьКПССчета(СтрокаВозвратнаяТара.СчетУчета, СтрокаВозвратнаяТара.КФО, КПССчетов);
		СтрокаВозвратнаяТара.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Организация, ИФО, СтрокаВозвратнаяТара.КФО,
			Дата, СтрокаВозвратнаяТара.СчетУчета, ВыборкаВозвратнаяТара.ТипНоменклатуры, "Дт");
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКПССчета(Счет, КФО, КПССчетов)
	Отбор = Новый Структура;
	Отбор.Вставить("СчетУчета", Счет);
	Отбор.Вставить("КФО", КФО);
	СохраненныйКПС = КПССчетов.НайтиСтроки(Отбор);
	Если СохраненныйКПС.Количество() > 0 Тогда
		Возврат СохраненныйКПС[0].КПС;
	КонецЕсли;

	КПСПоСчету = БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, КФО, Дата, Счет);
	НоваяСтрока = КПССчетов.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
	НоваяСтрока.КПС = КПСПоСчету;
	
	Возврат КПСПоСчету;
	
КонецФункции

Процедура ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		Если ДанныеЗаполнения.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Для ответного акта нельзя ввести документ данного типа.'");

			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;	
	КонецЕсли;
	
	КодВидаИмущества = ДанныеЗаполнения.КодВидаИмуществаУОтправителя;

	Организация = ДанныеЗаполнения.Организация;
	ДокументОснование = ДанныеЗаполнения;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ОснованиеДляАкта = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаОснованияДляАкта = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерОснованияДляАкта = ДанныеЗаполнения.НомерПервичногоДокумента;

	ПервичныйДокумент = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");
	
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	КФО = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("КВД", ДанныеЗаполнения.КФОУОтправителя, Истина);
	
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	
	СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Дата, Организация);
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	СуммаВключаетНДС   = Истина;
	
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация);
	Если КодВидаИмущества = НСтр("ru='ВложенияВНФА'") Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.00", Дата, Организация);
	КонецЕсли;	
	
	ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(ДанныеЗаполнения.КодВалюты);
	Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;

	НФАПереданыЭлектроннымАктом = Истина;
	ИспользуемыеИдентификаторы = Новый Массив;
	ПереданнаяНоменклатура = Новый ТаблицаЗначений;
	ПереданнаяНоменклатура.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПереданнаяНоменклатура.Колонки.Добавить("GUIDНоменклатуры", Новый ОписаниеТипов("Строка"));
	
	Материалы.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаполнения.ПереданныеНФА Цикл
		НовСтрока = ПереданнаяНоменклатура.Добавить();
		НовСтрока.ОбъектНФА = ТекСтрока.НФА;
		НовСтрока.GUIDНоменклатуры = ТекСтрока.GUIDНоменклатурыУОтправителя;
		
		НоваяСтрока = Материалы.Добавить();
		НоваяСтрока.Номенклатура = ТекСтрока.НФА;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.БалансоваяСтоимость;
		НоваяСтрока.Всего = ТекСтрока.БалансоваяСтоимость;
		НоваяСтрока.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоКоду(ТекСтрока.КодСтраныПроисхождения);
		НоваяСтрока.ПрослеживаемыйТовар = ТекСтрока.ПрослеживаемыйТовар;
		НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
		НоваяСтрока.КоличествоМест = ТекСтрока.Количество;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекСтрока.ЕдИзмКод);
		НоваяСтрока.КФО = КФО;
		НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		
		НоваяСтрока.КПС = БухгалтерскиеОперации.КПСПоКоду(ТекСтрока.КодКПСУОтправителя, Дата);
		НоваяСтрока.СчетУчета = БухгалтерскиеОперации.СчетПоКоду(ТекСтрока.КодСчетаУчетаУОтправителя, Дата);
		
		Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СведенияПрослеживаемости.Очистить();
	ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы);
	Если ДанныеЗаполнения.СведенияПрослеживаемости.Количество() > 0 Тогда
		ОтражатьВПрослеживаемости = Истина;
		КодОперацииПрослеживаемости = Справочники.КодыОперацийПрослеживаемости.БезвозмездноеПолучение;
		
		Для Каждого ТекСтрока Из ДанныеЗаполнения.СведенияПрослеживаемости Цикл
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);			
		КонецЦикла;	
	КонецЕсли;
	
	ДрагоценныеМатериалы.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаполнения.СведенияОСодержанииДрагМатериалов Цикл
		НоваяСтрока = ДрагоценныеМатериалы.Добавить();
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("GUIDНоменклатуры", ТекСтрока.GUIDНоменклатурыУОтправителя);
		НайденныеСтроки = ПереданнаяНоменклатура.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ОбъектНФА = НайденныеСтроки[0].ОбъектНФА;
			НоваяСтрока.ОбъектНФА = ОбъектНФА;
		КонецЕсли;
		НоваяСтрока.ВидДрагМатериала = Справочники.ДрагМеталлы.НайтиПоКоду(ТекСтрока.КодВидаДрагоценногоМатериала);
		НоваяСтрока.ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекСтрока.ЕдИзмКод);
		НоваяСтрока.КоличествоДМ = ТекСтрока.КоличествоДМ;
		НоваяСтрока.МассаДМ = ТекСтрока.МассаДМ;
	КонецЦикла;
	
	СуммаДокумента = Материалы.Итог("Сумма");
	
КонецПроцедуры

Функция ЭтоЗаполнениеНаОснованииИнвентаризации0510466(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		И ДанныеЗаполнения.Свойство("Разделитель");
КонецФункции

// Заполнить по инвентаризации 0510466.
// 
// Параметры:
//  ДанныеЗаполнения - Структура:
//   * Разделитель - Структура
//   * ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА
Процедура ЗаполнитьПоИнвентаризации0510466(ДанныеЗаполнения)
	Материалы.Очистить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация, Дата, Номер");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование, "Организация");
	ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация);
	КонецЕсли;
	ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору("АктПриемаПередачи0510448");

	ИдентификаторИнвОписи = "Форма0510466";
	ОснованиеДляАкта = ПервичныеДокументыБГУ
		.ПредставленияПервичныхДокументов(ИдентификаторИнвОписи)[ИдентификаторИнвОписи].ПредставлениеФормы;
	НомерОснованияДляАкта = ОбщегоНазначенияБГУ
		.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование, ДанныеДокОснование.Номер);
	ДатаОснованияДляАкта = ДанныеДокОснование.Дата;
	
	Документы.ПоступлениеМЗ.ЗаполнитьПоИнвентаризации0510466(
		ДанныеЗаполнения.ДокументОснование,
		ЭтотОбъект)
КонецПроцедуры

