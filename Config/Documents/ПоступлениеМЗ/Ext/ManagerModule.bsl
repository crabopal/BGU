	|		ПО ПоступлениеМЗВозвратнаяТара.Ссылка = СчетаДтКт.Ссылка
	|			И ПоступлениеМЗВозвратнаяТара.Номенклатура = СчетаДтКт.НоменклатураСсылка
	|			И ПоступлениеМЗВозвратнаяТара.КФО = СчетаДтКт.КФО
	|			И ПоступлениеМЗВозвратнаяТара.КПСРасчетов = СчетаДтКт.КПСКт
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ПоступлениеМЗВозвратнаяТара.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	ПоступлениеМЗВозвратнаяТара.Ссылка В(&МассивОбъектов)
	|	И НЕ СчетаДтКт.СчетДтУчетКПС
	|	И СчетаДтКт.НомерСтроки В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				Т.НомерСтроки
	|			ИЗ
	|				СчетаДтКт КАК Т
	|			ГДЕ
	|				ПоступлениеМЗВозвратнаяТара.Ссылка = Т.Ссылка
	|				И ПоступлениеМЗВозвратнаяТара.Номенклатура = Т.НоменклатураСсылка
	|				И ПоступлениеМЗВозвратнаяТара.КФО = Т.КФО
	|				И ПоступлениеМЗВозвратнаяТара.КПСРасчетов = Т.КПСКт
	|			УПОРЯДОЧИТЬ ПО
	|				Т.НомерСтроки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеМЗВозвратнаяТара.Ссылка,
	|	2,
	|	ПоступлениеМЗВозвратнаяТара.НомерСтроки,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.Наименование,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.НаименованиеПолное,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.НоменклатурныйНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	|			ТОГДА ПоступлениеМЗВозвратнаяТара.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ПоступлениеМЗВозвратнаяТара.Сумма * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2))
	|	КОНЕЦ,
	|	0,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка),
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	|			ТОГДА ПоступлениеМЗВозвратнаяТара.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ПоступлениеМЗВозвратнаяТара.Сумма * ЕСТЬNULL(ОперацииДокументов.Курс, 1) / ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК ЧИСЛО(18, 2))
	|	КОНЕЦ,
	|	ПоступлениеМЗВозвратнаяТара.Количество,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.ЕдиницаИзмерения,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.ЕдиницаИзмерения.Наименование,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура.ЕдиницаИзмерения.Код
	|ИЗ
	|	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаДтКт КАК СчетаДтКт
	|		ПО ПоступлениеМЗВозвратнаяТара.Ссылка = СчетаДтКт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ПоступлениеМЗВозвратнаяТара.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	ПоступлениеМЗВозвратнаяТара.Ссылка В(&МассивОбъектов)
	|	И СчетаДтКт.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Порядок,
	|	НомерСтроки";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат УправлениеПечатьюБГУ.ПечатьПриходногоОрдера_0504207(РезультатЗапроса, ОбъектыПечати, , ИмяМакета);
	
КонецФункции

// Функция формирует табличный документ Приходный ордер (ф.М-4)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьМ4(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_ПРИХОДНЫЙОРДЕР_М4";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеМЗМатериалы.Ссылка КАК Ссылка,
	               |	1 КАК Порядок,
	               |	ПоступлениеМЗМатериалы.НомерСтроки КАК НомерСтроки,
	               |	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	               |	ПоступлениеМЗМатериалы.Номенклатура.НоменклатурныйНомер КАК НоменклатурныйНомер,
	               |	ПоступлениеМЗМатериалы.Всего КАК Всего,
	               |	ПоступлениеМЗМатериалы.СуммаНДС КАК СуммаНДС,
	               |	ПоступлениеМЗМатериалы.СтавкаНДС КАК СтавкаНДС,
	               |	ПоступлениеМЗМатериалы.Сумма КАК Сумма,
	               |	ПоступлениеМЗМатериалы.Количество КАК Количество,
	               |	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ПОМЕСТИТЬ СоставыДокументов
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	               |ГДЕ
	               |	ПоступлениеМЗМатериалы.Ссылка В(&МассивОбъектов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗВозвратнаяТара.Ссылка,
	               |	2,
	               |	ПоступлениеМЗВозвратнаяТара.НомерСтроки,
	               |	ПоступлениеМЗВозвратнаяТара.Номенклатура,
	               |	ПоступлениеМЗВозвратнаяТара.Номенклатура.НоменклатурныйНомер,
	               |	ПоступлениеМЗВозвратнаяТара.Сумма,
	               |	0,
	               |	0,
	               |	0,
	               |	ПоступлениеМЗВозвратнаяТара.Количество,
	               |	ПоступлениеМЗВозвратнаяТара.Номенклатура.ЕдиницаИзмерения
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	               |ГДЕ
	               |	ПоступлениеМЗВозвратнаяТара.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ОперацииДокументов.Курс, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ОперацииДокументов.Курс
	               |	КОНЕЦ КАК Курс,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ОперацииДокументов.Кратность, 0) = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ОперацииДокументов.Кратность
	               |	КОНЕЦ КАК Кратность,
	               |	ПоступлениеМЗ.Ссылка КАК Документ
	               |ПОМЕСТИТЬ КурсИКратностьДокумента
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО ПоступлениеМЗ.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	ПоступлениеМЗ.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУ.СчетКт) КАК КорСчет,
	               |	ЖурналПроводокЕПСБУ.Регистратор КАК Ссылка,
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУ.КПСКт) КАК КорСчетБК,
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУ.КЭККт) КАК КорСчетКОСГУ,
	               |	МАКСИМУМ(ЖурналПроводокЕПСБУ.КФО) КАК КФО
	               |ПОМЕСТИТЬ КорСчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |ГДЕ
	               |	ЖурналПроводокЕПСБУ.Регистратор В(&МассивОбъектов)
	               |	И ЖурналПроводокЕПСБУ.СчетДт В(&Счет105106)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУ.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеМЗ.Ссылка КАК Ссылка,
	               |	ПоступлениеМЗ.Номер КАК Номер,
	               |	ПоступлениеМЗ.Дата КАК Дата,
	               |	ПоступлениеМЗ.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	               |	ПоступлениеМЗ.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	               |	ПоступлениеМЗ.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	               |	"""" КАК КодАналитики,
	               |	ПоступлениеМЗ.Организация КАК Организация,
	               |	ПоступлениеМЗ.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ПоступлениеМЗ.Организация.КодОКПО КАК КодОКПО,
	               |	ПоступлениеМЗ.ЦМО.Сотрудник КАК СотрудникСсылка,
	               |	ПоступлениеМЗ.ЦМО.МестоХранения КАК МестоХраненияСсылка,
	               |	ПоступлениеМЗ.ЦМО.МестоХранения.Представление КАК МестоХранения,
	               |	ПоступлениеМЗ.Контрагент.Код КАК КодПоставщика,
	               |	ПоступлениеМЗ.Контрагент КАК Контрагент,
	               |	ПоступлениеМЗ.ВалютаДокумента КАК ВалютаДокумента,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.Номенклатура.НаименованиеПолное = """"
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(СоставыДокументов.Номенклатура)
	               |		ИНАЧЕ СоставыДокументов.Номенклатура.НаименованиеПолное
	               |	КОНЕЦ КАК Номенклатура,
	               |	СоставыДокументов.НоменклатурныйНомер КАК НоменклатурныйНомер,
	               |	СоставыДокументов.Всего * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК Всего,
	               |	СоставыДокументов.СуммаНДС * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК НДС,
	               |	СоставыДокументов.СтавкаНДС КАК СтавкаНДС,
	               |	(ВЫРАЗИТЬ(СоставыДокументов.Всего * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2))) - (ВЫРАЗИТЬ(СоставыДокументов.СуммаНДС * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2))) КАК Сумма,
	               |	СоставыДокументов.Количество КАК Количество,
	               |	СоставыДокументов.ЕдиницаИзмерения.Код КАК КодЕдИзм,
	               |	СоставыДокументов.ЕдиницаИзмерения.Представление КАК ЕдИзм,
	               |	ВЫБОР
	               |		КОГДА СоставыДокументов.Количество <> 0
	               |			ТОГДА ((ВЫРАЗИТЬ(СоставыДокументов.Всего * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2))) - (ВЫРАЗИТЬ(СоставыДокументов.СуммаНДС * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2)))) / СоставыДокументов.Количество
	               |		ИНАЧЕ (ВЫРАЗИТЬ(СоставыДокументов.Всего * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2))) - (ВЫРАЗИТЬ(СоставыДокументов.СуммаНДС * КурсИКратностьДокумента.Курс / КурсИКратностьДокумента.Кратность КАК ЧИСЛО(18, 2)))
	               |	КОНЕЦ КАК Цена,
	               |	КорСчета.КорСчет КАК КорСчет,
	               |	КорСчета.КорСчетБК КАК КорСчетБК,
	               |	КорСчета.КорСчетКОСГУ КАК КорСчетКОСГУ,
	               |	СоставыДокументов.Порядок КАК Порядок,
	               |	КорСчета.КФО КАК КФО
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КурсИКратностьДокумента КАК КурсИКратностьДокумента
	               |		ПО ПоступлениеМЗ.Ссылка = КурсИКратностьДокумента.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СоставыДокументов КАК СоставыДокументов
	               |		ПО ПоступлениеМЗ.Ссылка = СоставыДокументов.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КорСчета КАК КорСчета
	               |		ПО ПоступлениеМЗ.Ссылка = КорСчета.Ссылка
	               |ГДЕ
	               |	ПоступлениеМЗ.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	Номер,
	               |	Порядок,
	               |	СоставыДокументов.НомерСтроки
	               |ИТОГИ
	               |	СУММА(Всего),
	               |	СУММА(НДС),
	               |	СУММА(Сумма),
	               |	СУММА(Количество),
	               |	МАКСИМУМ(КорСчет),
	               |	МАКСИМУМ(КорСчетБК),
	               |	МАКСИМУМ(КорСчетКОСГУ),
	               |	МАКСИМУМ(КФО)
	               |ПО
	               |	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("Счет105106"		, БухгалтерскийУчетПовтИсп.СписокСчетов("105.00,106.00"));
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ПриходныйОрдерМ4");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		СтруктураОбластьШапка = Новый Структура("НомерСопроводительногоДокумента,Номер,Поставщик,КорСчет");
		СтруктураОбластьШапка.НомерСопроводительногоДокумента 	= ВыборкаШапка.ВидПервичногоДокумента 
																+ ?(ПустаяСтрока(ВыборкаШапка.НомерПервичногоДокумента), "", " №"+ВыборкаШапка.НомерПервичногоДокумента)
																+ ?(ЗначениеЗаполнено(ВыборкаШапка.ДатаПервичногоДокумента), " от "+Формат(ВыборкаШапка.ДатаПервичногоДокумента,"ДЛФ=D"), "");
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное", ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		СтруктураОбластьШапка.Поставщик	= ДанныеКонтрагента.НаименованиеПолное;
		СтруктураОбластьШапка.Номер 	= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер);
		СтруктураОбластьШапка.КорСчет	= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета("", ВыборкаШапка.КФО, ВыборкаШапка.КорСчет, "");
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
		
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтроки);
			Если НЕ ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		КонецЦикла;
		СтруктураОбластьИтог = Новый Структура("КоличествоИтог,СуммаИтог,НДСИтог,ВсегоИтог");

		СтруктураОбластьИтог.КоличествоИтог	= ВыборкаШапка.Количество;
		СтруктураОбластьИтог.СуммаИтог		= ВыборкаШапка.Сумма;
		СтруктураОбластьИтог.НДСИтог		= ВыборкаШапка.НДС;
		СтруктураОбластьИтог.ВсегоИтог		= ВыборкаШапка.Всего;
		ОбластьИтог.Параметры.Заполнить(СтруктураОбластьИтог);
		ТабличныйДокумент.Вывести(ОбластьИтог);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
											ВыборкаШапка.СотрудникСсылка, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьПодвал = Новый Структура("ДолжностьМОЛ,ФИОМол");
		СтруктураОбластьПодвал.ДолжностьМОЛ	= ДанныеСотрудника.Должность;
		СтруктураОбластьПодвал.ФИОМол		= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
													   НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
		
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеДляПечати0510434(МассивОбъектов)
	
	ПодразделенияСписанияМЗ = УправлениеПечатьюБГУ.ПодразделенияСотрудниковМЗ0510434(МассивОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПодразделенияСписанияМЗ", ПодразделенияСписанияМЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодразделенияСписанияМЗ.Документ КАК Документ,
	|	ПодразделенияСписанияМЗ.Подразделение КАК Подразделение,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ПодразделенияСписанияМЗ
	|ИЗ
	|	&ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатериальныеЗапасы.Ссылка КАК Ссылка,
	|	МатериальныеЗапасы.НомерСтроки КАК НомерСтроки,
	|	МатериальныеЗапасы.Номенклатура КАК Номенклатура,
	|	МатериальныеЗапасы.Количество КАК Количество,
	|	МатериальныеЗапасы.ВидимыеДефекты КАК ВидимыеДефекты,
	|	МатериальныеЗапасы.ОсобыеОтметки КАК ОсобыеОтметки,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК СотрудникОбеспечения,
	|	МатериальныеЗапасы.Сумма
	|ПОМЕСТИТЬ ВТ_Материалы
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК МатериальныеЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО МатериальныеЗапасы.Ссылка = ПоступлениеМЗ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|		ПО ПоступлениеМЗ.Ссылка = ПодразделенияСписанияМЗ.Документ
	|ГДЕ
	|	МатериальныеЗапасы.Ссылка В (&МассивОбъектов)
	|	И ПоступлениеМЗ.Ссылка В (&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияСписанияМЗ.Сотрудник КАК Сотрудник,
	|	ТЧОбеспечениеИмуществом.Имущество,
	|	ТЧОбеспечениеИмуществом.Приспособления КАК Приспособления,
	|	ТЧОбеспечениеИмуществом.РазмерОдежды КАК РазмерОдежды,
	|	ТЧОбеспечениеИмуществом.РазмерГоловногоУбора КАК РазмерГоловногоУбора,
	|	ТЧОбеспечениеИмуществом.РазмерОбуви КАК РазмерОбуви,
	|	ТЧОбеспечениеИмуществом.РазмерИное КАК РазмерИное,
	|	ТЧОбеспечениеИмуществом.НормаВыдачи КАК НормаВыдачи,
	|	ТЧОбеспечениеИмуществом.СрокИспользованияПоНормативу КАК СрокИспользованияПоНормативу,
	|	ТЧОбеспечениеИмуществом.ЕдиницаИзмеренияСрока КАК ЕдиницаИзмеренияСрока,
	|	ТЧОбеспечениеИмуществом.КодУсловияВозвратаИмущества КАК КодУсловияВозвратаИмущества
	|ПОМЕСТИТЬ Вт_ОбеспечениеИмуществом
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом КАК ОбеспечениеСотрудниковИмуществом
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК ТЧОбеспечениеИмуществом
	|		ПО ОбеспечениеСотрудниковИмуществом.Ссылка = ТЧОбеспечениеИмуществом.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|		ПО ОбеспечениеСотрудниковИмуществом.Владелец = ПодразделенияСписанияМЗ.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеМЗ.Ссылка КАК Ссылка,
	|	ПоступлениеМЗ.Номер КАК Номер,
	|	ПоступлениеМЗ.Дата КАК ДатаАкта,
	|	ПоступлениеМЗ.Организация КАК Организация,
	|	2 КАК Операция,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК СотрудникОтправитель,
	|	ЕСТЬNULL(ПодразделенияСписанияМЗ.Сотрудник.Код, """") КАК ТабельныйНомерОтправитель,
	|	ПоступлениеМЗ.ЦМО.Сотрудник КАК СотрудникПолучатель,
	|	ЕСТЬNULL(ПоступлениеМЗ.ЦМО.Сотрудник.Код, """") КАК ТабельныйНомерПолучатель,
	|	ПоступлениеМЗ.ЦМО.МестоХранения.Наименование КАК МестонахождениеПолучатель,
	|	ПодразделенияСписанияМЗ.Подразделение КАК СтруктурноеПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПодразделенияСписанияМЗ.Подразделение.НаименованиеПолное, """") = """"
	|			ТОГДА ПодразделенияСписанияМЗ.Подразделение.Наименование
	|		ИНАЧЕ ПодразделенияСписанияМЗ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияОтправитель,
	|	ПоступлениеМЗ.Подразделение КАК СтруктурноеПодразделениеПолучатель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПоступлениеМЗ.Подразделение.НаименованиеПолное, """") = """"
	|			ТОГДА ПоступлениеМЗ.Подразделение.Наименование
	|		ИНАЧЕ ПоступлениеМЗ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделенияПолучатель,
	|	ПодразделенияСписанияМЗ.Сотрудник КАК СотрудникОбеспечения,
	|	ПоступлениеМЗ.ВидПервичногоДокумента КАК НаименованиеПриказа,
	|	ПоступлениеМЗ.НомерПервичногоДокумента КАК НомерПриказа,
	|	ПоступлениеМЗ.ДатаПервичногоДокумента КАК ДатаПриказа
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодразделенияСписанияМЗ КАК ПодразделенияСписанияМЗ
	|		ПО ПоступлениеМЗ.Ссылка = ПодразделенияСписанияМЗ.Документ
	|ГДЕ
	|	ПоступлениеМЗ.Ссылка В (&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатериальныеЗапасы.Ссылка КАК Ссылка,
	|	МатериальныеЗапасы.НомерСтроки КАК НомерСтроки,
	|	МатериальныеЗапасы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА МатериальныеЗапасы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА МатериальныеЗапасы.Номенклатура.Наименование
	|		ИНАЧЕ МатериальныеЗапасы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМЗ,
	|	ВЫБОР
	|		КОГДА МатериальныеЗапасы.Номенклатура.НоменклатурныйНомер = """"
	|			ТОГДА МатериальныеЗапасы.Номенклатура.Код
	|		ИНАЧЕ МатериальныеЗапасы.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК НоменклатурныйНомер,
	|	МатериальныеЗапасы.Номенклатура.ЕдиницаИзмерения.Наименование КАК НаименованиеЕИ,
	|	МатериальныеЗапасы.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕИ,
	|	МатериальныеЗапасы.Сумма КАК Сумма,
	|	МатериальныеЗапасы.Количество КАК Количество,
	|	МатериальныеЗапасы.ВидимыеДефекты КАК Дефекты,
	|	МатериальныеЗапасы.ОсобыеОтметки КАК ОсобыеОтметки,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.Приспособления, """") КАК Приспособления,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерОдежды, 0) КАК РазмерОдежды,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерГоловногоУбора, 0) КАК РазмерГоловногоУбора,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерОбуви, 0) КАК РазмерОбуви,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.РазмерИное, 0) КАК РазмерИное,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.НормаВыдачи, 0) КАК НормаВыдачи,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.СрокИспользованияПоНормативу, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.ЕдиницаИзмеренияСрока, 0) КАК ЕдиницаИзмеренияСрока,
	|	ЕСТЬNULL(ОбеспечениеИмуществом.КодУсловияВозвратаИмущества, """") КАК КодВозврата
	|ИЗ
	|	ВТ_Материалы КАК МатериальныеЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ОбеспечениеИмуществом КАК ОбеспечениеИмуществом
	|		ПО (МатериальныеЗапасы.СотрудникОбеспечения = ОбеспечениеИмуществом.Сотрудник)
	|		И МатериальныеЗапасы.Номенклатура = ОбеспечениеИмуществом.Имущество
	|ГДЕ
	|	МатериальныеЗапасы.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов"	, РезультатЗапроса[3]);
	ДанныеДляПечати.Вставить("ВыборкаМЗДок"			, РезультатЗапроса[4]);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция Напечатать0510434(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ДанныеДляПечати		= ДанныеДляПечати0510434(МассивОбъектов);
	ВыборкаДокументов	= ДанныеДляПечати.ВыборкаДокументов.Выбрать();
	ВыборкаМЗДок		= ДанныеДляПечати.ВыборкаМЗДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
	Пока ВыборкаДокументов.Следующий() Цикл
		
		// Шапка
		СтрокаДокумента = ДанныеДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникОтправитель);
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникПолучатель);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия,Имя,Отчество,Должность,ДолжностьНаименование,НаименованиеПолное",
			ВыборкаДокументов.ДатаАкта);
		ДанныеСотрудникаОтправителя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникОтправитель);	
		СтрокаДокумента.ФИООтправитель = ДанныеСотрудникаОтправителя.НаименованиеПолное;
		
		ДанныеСотрудникаПолучателя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникПолучатель);	
		СтрокаДокумента.ФИОПолучатель = ДанныеСотрудникаПолучателя.НаименованиеПолное;
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокаДокумента.МатериальныеЗапасы = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахМЗДляПечатиАктПриемаПередачиИмуществаВЛичномПользовании0510434();
		
		// Материальные запасы
		
		ВыборкаМЗДок.Сбросить();
		Если ВыборкаМЗДок.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаМЗ = ВыборкаМЗДок.Выбрать();
			Пока ВыборкаМЗ.НайтиСледующий(СтруктураПоиска) Цикл
				СтрокаМЗ = СтрокаДокумента.МатериальныеЗапасы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаМЗ, ВыборкаМЗ);
			КонецЦикла;
		КонецЕсли;
		
		СтрокаДокумента.ОбъектыСдалНаименованиеДолжности = ДанныеСотрудникаОтправителя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалДолжность = ДанныеСотрудникаОтправителя.Должность;
		СтрокаДокумента.ОбъектыСдалСотрудник = ВыборкаДокументов.СотрудникОтправитель;
		СтрокаДокумента.ОбъектыСдалФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаОтправителя, Истина);
		
		СтрокаДокумента.ОбъектыПринялНаименованиеДолжности = ДанныеСотрудникаПолучателя.ДолжностьНаименование;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялДолжность = ДанныеСотрудникаПолучателя.Должность;
		СтрокаДокумента.ОбъектыПринялСотрудник = ВыборкаДокументов.СотрудникПолучатель;
		СтрокаДокумента.ОбъектыПринялФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудникаПолучателя, Истина);
		
	КонецЦикла;
	
	Возврат УправлениеПечатьюБГУ.Напечатать0510434(МассивОбъектов, ОбъектыПечати, ДанныеДокументов);
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ПолучитьЗначениеНастроекЗаполненияКПС(ДоговорСсылка, Период, Организация)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Договоры.КПСМатериаловВПоступлениеМЗ КАК КПСМатериаловВПоступлениеМЗ
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка = &Ссылка
	|	И НЕ Договоры.КПСМатериаловВПоступлениеМЗ В (ЗНАЧЕНИЕ(Перечисление.ВидыНастройкиКПСВПоступленияхМЗ.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.ВидыНастройкиКПСВПоступленияхМЗ.ПоУчетнойПолитике))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.КПСМатериаловВПоступлениеМЗ
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|		ПО Договоры.Организация = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|			И (Договоры.Ссылка = &Ссылка)
	|			И (Договоры.КПСМатериаловВПоступлениеМЗ В (ЗНАЧЕНИЕ(Перечисление.ВидыНастройкиКПСВПоступленияхМЗ.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.ВидыНастройкиКПСВПоступленияхМЗ.ПоУчетнойПолитике)))");
	
	Запрос.УстановитьПараметр("Ссылка", ДоговорСсылка);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);

	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() Тогда
		Выборка.Следующий();
		Возврат Выборка.КПСМатериаловВПоступлениеМЗ;
	КонецЕсли;
	
	Возврат Перечисления.ВидыНастройкиКПСВПоступленияхМЗ.ПустаяСсылка();
	
КонецФункции

// Заполнить по инвентаризации0510466.
// 
// Параметры:
//  ДокументыИнвентаризации - Массив из ДокументСсылка.ИнвентаризационнаяОписьНФА - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.ПоступлениеМЗ, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510466(ДокументыИнвентаризации, ЗаполняемыйДокумент) Экспорт 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументыИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризации.НФА КАК НФА,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок
	|ПОМЕСТИТЬ СгруппированныеСтроки
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И (&УсловиеМестоХранения)
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации В(&Документы466)
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И СправочникЦМО.Ссылка = &ЦМО
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И (НЕ &УчетПоПодразделениям
	|			ИЛИ НЕ ЕСТЬNULL(ДанныеИнвентаризации.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ИЛИ ДанныеИнвентаризации.Подразделение = &Подразделение)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки,
	|	ДанныеИнвентаризации.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСтрок = 1
	|				И ДанныеИнвентаризации.Количество <> 0
	|			ТОГДА ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено * ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СгруппированныеСтроки КАК СгруппированныеСтроки
	|		ПО ДанныеИнвентаризации.ДокументИнвентаризации = СгруппированныеСтроки.ДокументИнвентаризации
	|			И ДанныеИнвентаризации.НомерСтроки = СгруппированныеСтроки.НомерСтроки
	|			И ДанныеИнвентаризации.НФА = СгруппированныеСтроки.НФА";
	Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаполняемыйДокумент.ЦМО, "МестоХранения")) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения",
			"ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения",
			"ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(Строка)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Документы466", ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("ЦМО", ЗаполняемыйДокумент.ЦМО);
	Запрос.УстановитьПараметр("ИФО", ЗаполняемыйДокумент.ИФО);
	Запрос.УстановитьПараметр("Подразделение", ЗаполняемыйДокумент.Подразделение);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВШапке105 = ЗаполняемыйДокумент.СчетУчета = БухгалтерскийУчет.СчетПоКоду(
		"105.00", ЗаполняемыйДокумент.Дата, ЗаполняемыйДокумент.Организация);
	ВШапке106 = ЗаполняемыйДокумент.СчетУчета = БухгалтерскийУчет.СчетПоКоду(
		"106.00", ЗаполняемыйДокумент.Дата, ЗаполняемыйДокумент.Организация);
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЗаполняемыйДокумент);
	ПараметрыОбработки.Вставить("ВШапке105", ВШапке105);
	ПараметрыОбработки.Вставить("ВШапке106", ВШапке106);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Истина);
	ПараметрыОбработки.Вставить("ДтКт", "Дт");
	ПараметрыОбработки.Вставить("Организация", ЗаполняемыйДокумент.Организация);
	ПараметрыОбработки.Вставить("ИФО", ЗаполняемыйДокумент.ИФО);
	ПараметрыОбработки.Вставить("Дата", ЗаполняемыйДокумент.Дата);

	ЗаполняемыйДокумент.СуммаДокумента = 0;
	Пока Выборка.Следующий() Цикл
		СтрокаМатериалы = ЗаполняемыйДокумент.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Выборка);
		СтрокаМатериалы.КоличествоМест = СтрокаМатериалы.Количество;
		СтрокаМатериалы.Коэффициент = 1;
		СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		
		ПараметрыОбработки.Номенклатура = СтрокаМатериалы.Номенклатура;
		ПараметрыОбработки.Счет         = СтрокаМатериалы.СчетУчета;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(СтрокаМатериалы, ПараметрыОбработки);
		
		СтрокаМатериалы.Всего = СтрокаМатериалы.Сумма;
		ЗаполняемыйДокумент.СуммаДокумента = ЗаполняемыйДокумент.СуммаДокумента + СтрокаМатериалы.Всего;
	КонецЦикла;

КонецПроцедуры

// Заполняет указанный документ по договору, по которому указан предмет договора.
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеМЗ - заполняемый документ.
// 			 - см. Документ.ПоступлениеМЗ.Форма.ФормаДокумента.Объект
// 	ДоговорОснование - СправочникСсылка.Договоры - договор
// 	ЗаполнитьШапку - Булево - Признак необходимости заполнения шапки документа.

Процедура ЗаполнитьПоДоговору(Документ, ДоговорОснование, ЗаполнитьШапку = Ложь) Экспорт
	
	ПараметрыЗаполнения = РаботаСОбязательствами.ПараметрыПолученияОстатковНФАПоДоговору(Документ);
	ПараметрыЗаполнения.ПолучитьДанныеДоговора = ЗаполнитьШапку;
	ПараметрыЗаполнения.ДоговорОснование       = ДоговорОснование;
	ПараметрыЗаполнения.ТипыНоменклатуры       = УправлениеМатериальнымиЗапасами.ТипыНоменклатурыМатериальныеЗапасы();
	
	ОстаткиНФАПоДоговору = РаботаСОбязательствами.ОстатокМЗУслугПоДоговору(ПараметрыЗаполнения);
	
	Если ОстаткиНФАПоДоговору = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполнитьШапку Тогда
		
		ЗаполнитьЗначенияСвойств(Документ, ОстаткиНФАПоДоговору.ДанныеДоговора);
		
		Документ.СчетУчета          = БухгалтерскийУчет.СчетПоКоду("105.00", Документ.Дата, Документ.Организация);
		Документ.Договор            = ДоговорОснование;
		Документ.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Документ.ВидПоступленияМЗ   = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика;
		Документ.СуммаВключаетНДС   = Истина;
		
	КонецЕсли;
	
	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", Документ.СуммаВключаетНДС);
	ЗаполнятьНДСВТаблице = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.ВПоступленииМЗВозможенУчетНДС(Документ);
	
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	ПараметрыОбработкиСтроки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Документ);
	ПараметрыОбработкиСтроки.ДтКт          = "Дт";
	ПараметрыОбработкиСтроки.ЗаполнятьСчет = Ложь;
	
	ДатаСчета = Документ.Дата;
	Если Не ЗначениеЗаполнено(ДатаСчета) Тогда
		ДатаСчета = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Счета105 = БухгалтерскийУчет.СписокСчетов("105.00", ДатаСчета, , Документ.Организация);
	Счета113 = БухгалтерскийУчет.СписокСчетов("113.00", ДатаСчета, , Документ.Организация);
	ЕстьСчета105 = Ложь;
	ЕстьСчета113 = Ложь;
	ЭтоПоступлениеНаСчет106 = Документ.СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.00", ДатаСчета, Документ.Организация);
	
	МассивКПСРасчетов = ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОстаткиНФАПоДоговору.ОстаткиНФА.ВыгрузитьКолонку("КПС"));
	КоличествоКПСР = МассивКПСРасчетов.Количество();
	Документ.НесколькоКПСРасчетов = КоличествоКПСР > 1;
	Если КоличествоКПСР = 1 Тогда
		Документ.КПСРасчетов = МассивКПСРасчетов[0];
	КонецЕсли;

	Для Каждого ОстатокТМЦ Из ОстаткиНФАПоДоговору.ОстаткиНФА Цикл
		
		НоваяСтрока = Документ.Материалы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокТМЦ);
		НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду(ОстатокТМЦ.СчетУчетаКод,
			 Документ.Дата, Документ.Организация);
		ЕстьСчета105 = ЕстьСчета105 Или Счета105.Найти(НоваяСтрока.СчетУчета) <> Неопределено;
		ЕстьСчета113 = ЕстьСчета113 Или Счета113.Найти(НоваяСтрока.СчетУчета) <> Неопределено;
		Если ЭтоПоступлениеНаСчет106 И ЗначениеЗаполнено(НоваяСтрока.СчетУчета) Тогда
			НоваяСтрока.СчетУчета = УправлениеМатериальнымиЗапасами.СчетВложенийПоСчетуМатериала(
				НоваяСтрока.СчетУчета,
				Документ.Дата,
				ДатаСчета);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) ИЛИ НоваяСтрока.КЭК = КЭК340 Тогда
			ПараметрыОбработкиСтроки.Счет          = НоваяСтрока.СчетУчета;
			ПараметрыОбработкиСтроки.Номенклатура  = НоваяСтрока.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока,
				ПараметрыОбработкиСтроки);
		КонецЕсли;
			Если Не ЗаполнятьНДСВТаблице Тогда
				НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
				НоваяСтрока.СуммаНДС = 0;
			КонецЕсли;

		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
		
	КонецЦикла;
	
	Если ЕстьСчета105 И ЕстьСчета113 Тогда
		Документ.СчетРасчетов       = БухгалтерскийУчет.СчетПоКоду("302.30", Документ.Дата, Документ.Организация);
	ИначеЕсли ЕстьСчета113 Тогда
		Документ.СчетРасчетов       = БухгалтерскийУчет.СчетПоКоду("302.36", Документ.Дата, Документ.Организация);
	Иначе
		Документ.СчетРасчетов       = БухгалтерскийУчет.СчетПоКоду("302.34", Документ.Дата, Документ.Организация);
	КонецЕсли;
	
	Если НЕ ЭтоПоступлениеНаСчет106 Тогда
		Если ПолучитьЗначениеНастроекЗаполненияКПС(ДоговорОснование, Документ.Дата, Документ.Организация) = Перечисления.ВидыНастройкиКПСВПоступленияхМЗ.ПоОбщимПравилам Тогда
			УправлениеМатериальнымиЗапасами.ЗаполнитьКПСМЗвТЧПоступления(Документ, "Материалы");
		КонецЕсли;
	КонецЕсли;
	
	Документ.СуммаДокумента = Документ.Материалы.Итог("Всего") + Документ.ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

// Заполняет таблицу "Зачет авансов"
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеМЗ, ДанныеФормыСтруктураСКоллекцией - заполняемый документ.
// 	ПериодОстатков - Граница - граница расчета остатков авансов.
Процедура ЗаполнитьПоОстаткамАвансов(Документ, ПериодОстатков, Отказ) Экспорт
	
	ПараметрыЗаполнения = БухгалтерскийУчет.ПараметрыЗаполненияТаблицыДокументаЗачетАвансов(Документ);
	
	ПараметрыЗаполнения.ПериодОстатков = ПериодОстатков;
	ПараметрыЗаполнения.СчетРасчетов = Документ.СчетРасчетов;
	ПараметрыЗаполнения.КПСРасчетовВТЧ = Документ.НесколькоКПСРасчетов;
	ПараметрыЗаполнения.КПС = Документ.КПСРасчетов;
	
	Если  Документ.НесколькоКПСРасчетов ИЛИ ЗначениеЗаполнено(Документ.КПСРасчетов) Тогда
		ПараметрыЗаполнения.ПоВсемКПС = Ложь;
	Иначе
		ПараметрыЗаполнения.ПоВсемКПС = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Документ.КПСРасчетов) Тогда
		ПараметрыЗаполнения.КПС = Документ.КПСРасчетов;
		ПараметрыЗаполнения.ПоВсемКПС = Ложь;
	Иначе
		ПараметрыЗаполнения.ПоВсемКПС = Истина;
	КонецЕсли;
	
	Если ТипЗнч(Документ) <> Тип("ДокументОбъект.ПоступлениеМЗ") Тогда
		ДокументОбъект = ДанныеФормыВЗначение(Документ, Тип("ДокументОбъект.ПоступлениеМЗ"));
	Иначе
		ДокументОбъект = Документ;
	КонецЕсли;
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ДокументОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		
		Документ.ЗачетАвансов.Очистить();
		
		АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
			Новый Структура("ЭтоЗачетАванса", Истина));
		
		Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
			
			Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Документ.ЗачетАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету, "КФО,КПС");
			
			НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
			НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(АвансКЗачету.СчетАвансов);
			НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

