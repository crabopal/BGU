			УправлениеПечатьюБГУ.Напечатать0510448(МассивОбъектов, ОбъектыПечати, Ложь));
		
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОтветныйАктПриемаПередачи0510448") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ОтветныйАктПриемаПередачи0510448", "Ответный Акт о приеме-передаче НФА (ф.0510448)",
			ЭлектронныеДокументыБГУ.НапечататьОтветный0510448ДляМЗ(МассивОбъектов, ОбъектыПечати, Ложь));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстыЗапросовДляПечати0510448()
	ТекстыЗапросов = Новый Структура;
	ТекстыЗапросов.Вставить("Шапка");
	ТекстыЗапросов.Вставить("Материалы");
	ТекстыЗапросов.Вставить("ДрагоценныеМатериалы");
	ТекстыЗапросов.Вставить("ФизическиеЛица");
	ТекстыЗапросов.Вставить("Председатели");
	ТекстыЗапросов.Вставить("СоставКомиссии");
	ТекстыЗапросов.Вставить("ДополнительныеРеквизиты");
	
	ТекстыЗапросов.Шапка =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК Дата,
	|	Документ.Организация КАК Организация,
	|	Документ.ИФО КАК ИФО,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Документ.Контрагент.ОбособленноеПодразделение, ЛОЖЬ)
	|			ТОГДА Документ.Контрагент.ГоловнаяОрганизация
	|		ИНАЧЕ Документ.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Документ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА ЕСТЬNULL(Документ.Контрагент.ОбособленноеПодразделение, ЛОЖЬ)
	|		И Документ.Контрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|				КОГДА Документ.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|				И ВЫРАЗИТЬ(Документ.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо КАК
	|					Справочник.ЮридическиеЛица).НаименованиеПолное <> """"
	|					ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо КАК
	|						Справочник.ЮридическиеЛица).НаименованиеПолное
	|				КОГДА Документ.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное <> """"
	|					ТОГДА Документ.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	|				ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Документ.Контрагент.ГоловнаяОрганизация)
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА Документ.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			И ВЫРАЗИТЬ(Документ.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное <> """"
	|				ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
	|			КОГДА Документ.Контрагент.НаименованиеСокращенное <> """"
	|				ТОГДА Документ.Контрагент.НаименованиеСокращенное
	|			ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Документ.Контрагент)
	|		КОНЕЦ
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	ВЫБОР
	|		КОГДА Документ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА ЕСТЬNULL(Документ.Контрагент.ОбособленноеПодразделение, ЛОЖЬ)
	|		И Документ.Контрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо КАК
	|				Справочник.ЮридическиеЛица).КодПоППП.НаименованиеПолное
	|		КОГДА Документ.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	|			ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ЮридическоеФизическоеЛицо КАК
	|				Справочник.ЮридическиеЛица).КодПоППП.НаименованиеПолное
	|	КОНЕЦ КАК КонтрагентУчредитель,
	|	ВЫБОР
	|		КОГДА Документ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА ЕСТЬNULL(Документ.Контрагент.ОбособленноеПодразделение, ЛОЖЬ)
	|		И Документ.Контрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо КАК
	|				Справочник.ЮридическиеЛица).КодПоППП.Код
	|		КОГДА Документ.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	|			ТОГДА ВЫРАЗИТЬ(Документ.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).КодПоППП.Код
	|	КОНЕЦ КАК КонтрагентГлаваБК,
	|	ВЫБОР
	|		КОГДА Документ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА """"
