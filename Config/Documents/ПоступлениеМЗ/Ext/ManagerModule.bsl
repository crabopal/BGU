#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.ПоступлениеМЗ -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|			
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 8
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = УправлениеНФА.УдалитьПолеИзТекстЗапроса(Запрос.Текст, "ИФО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат 
	"ВЫБРАТЬ
	|	АктСписания.Ссылка КАК ДокументОтклонения,
	|	АктСписания.ДокументОснование КАК ДокументИнвентаризации,
	|	ТабМатериалы.Номенклатура КАК НФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения,
	|	АктСписания.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ТабМатериалы.Количество КАК Количество
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК АктСписания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ.Материалы КАК ТабМатериалы
	|		ПО АктСписания.Ссылка = ТабМатериалы.Ссылка
	|ГДЕ
	|	АктСписания.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ АктСписания.ПометкаУдаления
	|	И АктСписания.Ссылка <> &ПоступлениеМЗСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать106 - Булево - получать свойства счета 106
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Дт");
	Результат.Вставить("Включать106", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	ИменаТабличныхЧастей.Добавить("ВозвратнаяТара");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеМЗ
//  Параметры - Структура
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	Счет27 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Счет27", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	
	Если Не ЗначениеЗаполнено(Счет27) Тогда
		Счет27 = БухгалтерскийУчет.СчетПоКоду("27.02", Документ.Дата, Документ.Организация);
		Если Не ЗначениеЗаполнено(Счет27) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не найден счет 27.02, действующий на %1'"),
			Формат(Документ.Дата, "ДФ=dd.MM.yyyy")));
		КонецЕсли;
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет27);
	
	ВидДопСубконто27 = Неопределено;
	Для Счетчик = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Счетчик]) Тогда
			Если СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				
				ВидДопСубконто27 = СвойстваСчета["ВидСубконто" + Счетчик];
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Ссылка.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	ВЫБОР
	|		КОГДА Материалы.Ссылка.ПодразделениеИсточник = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ТОГДА Материалы.Ссылка.Подразделение
	|		ИНАЧЕ Материалы.Ссылка.ПодразделениеИсточник
	|	КОНЕЦ КАК Подразделение,
	|	Материалы.Ссылка.Подразделение КАК ПодразделениеПолучатель,
	|	&УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	&РазрешитьНеУказыватьПодразделение КАК РазрешитьНеУказыватьПодразделение,
	|	&СчетУчета КАК СчетУчета,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Материалы.Ссылка.ПолучательИмущества = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|			ТОГДА Материалы.Ссылка.Контрагент
	|		ИНАЧЕ Материалы.Ссылка.ПолучательИмущества.Контрагент
	|	КОНЕЦ КАК ДопАналитика,
	|	ВЫБОР
	|		КОГДА &ВидДопСубконто27 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА &ВидДопСубконто27
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|	КОНЕЦ КАК ДопИзмерениеВидСубконто,
	|	ВЫБОР
	|		КОГДА &ВидДопСубконто27 <> НЕОПРЕДЕЛЕНО
	|			ТОГДА Материалы.ДополнительноеСубконтоСчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопИзмерение,
	|	НЕОПРЕДЕЛЕНО КАК ДопИзмерениеПолучатель,
	|	Материалы.Количество КАК Количество,
	|	ЛОЖЬ КАК НеПересчитыватьСумму,
	|	0 КАК СуммаСписания,
	|	0 КАК СуммаСписанияНУ
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("СчетУчета", Счет27);
	Запрос.УстановитьПараметр("ВидДопСубконто27", ВидДопСубконто27);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", СвойстваСчета.УчетПоПодразделениям);
	Запрос.УстановитьПараметр("РазрешитьНеУказыватьПодразделение", СвойстваСчета.РазрешитьНеУказыватьПодразделение);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Ссылка КАК Ссылка,
	|	ПоступлениеМЗМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗМатериалы.Количество КАК Количество,
	|	ПоступлениеМЗМатериалы.КПС КАК КПС,
	|	ПоступлениеМЗМатериалы.КФО КАК КФО,
	|	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗМатериалы.КЭК КАК КЭК,
	|	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗМатериалы.Ссылка.Дата КАК Дата,
	|	ПоступлениеМЗМатериалы.Ссылка.Организация КАК Организация,
	|	ПоступлениеМЗМатериалы.Ссылка.ИФО КАК ИФО
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка В(&МассивОбъектов)";
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы:
// * Материалы - Массив из Строка - имена элементов
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("КЭК");
	ИменаРеквизитов.Добавить("ЕдиницаИзмерения");
	ИменаРеквизитов.Добавить("КоличествоМест");
	ИменаРеквизитов.Добавить("Коэффициент");
	ИменаРеквизитов.Добавить("Сумма");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументСсылка.ПоступлениеМЗ
//  МЗПоСебестоимости - Булево - печать по себестоимости или по цене реализации
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивОбъектов, МЗПоСебестоимости) Экспорт
	
	УправлениеМатериальнымиЗапасами.ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивОбъектов,
		ТекстыЗапросовДляПечати0510448(), МЗПоСебестоимости);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнятьДатуНомерДокументаПоставщика(Документ) Экспорт
	
	Если Документ.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования
			Или Не ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Документ.Дата)
			Или Не ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Документ.Материалы)
			Или Не Документ.ОтражатьВПрослеживаемости Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Документ.ПервичныйДокумент, "АктПриемаПередачи0510448") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СчетаПрослеживаемыхМЗ = УправлениеМатериальнымиЗапасами.СчетаУчетаПрослеживаемыхМЗ(
		Документ.Дата, Документ.Организация);
	Возврат СчетаПрослеживаемыхМЗ.Получить(Документ.СчетУчета) <> Неопределено;
КонецФункции

#Область ПрослеживаемыйТовар

//Формирует текст запроса для определения прослеживаемого товара в документе
//
// Возвращаемое значение:
//  Строка - Текст сформированного запроса.
//
Функция ТекстЗапросаТаблицаПрослеживаемыхТоваровПоОснованию() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	СУММА(ПоступлениеМЗМатериалы.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА ПоступлениеМЗМатериалы.Ссылка.СуммаВключаетНДС
	|				ТОГДА ПоступлениеМЗМатериалы.Сумма - ПоступлениеМЗМатериалы.СуммаНДС
	|			ИНАЧЕ ПоступлениеМЗМатериалы.Сумма
	|		КОНЕЦ) КАК Сумма,
	|	ПоступлениеМЗМатериалы.Ссылка.Организация КАК Организация,
	|	ПоступлениеМЗМатериалы.Ссылка.Дата КАК ПериодСобытия,
	|	ПоступлениеМЗМатериалы.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|ГДЕ
	|	ПоступлениеМЗМатериалы.ПрослеживаемыйТовар
	|	И ПоступлениеМЗМатериалы.Ссылка = &Основание
	|	И ЕСТЬNULL(ПоступлениеМЗМатериалы.Ссылка.Контрагент.ЮридическоеФизическоеЛицо.СтранаРегистрации.УчастникЕАЭС, ЛОЖЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗМатериалы.Ссылка.Организация,
	|	ПоступлениеМЗМатериалы.Ссылка.Дата,
	|	ПоступлениеМЗМатериалы.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРегистрацииПрослеживаемыхТоваров.ВвозТоваровИзЕАЭС) КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.Номенклатура.КодТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТоварыПоОснованию
	|ИЗ
	|	ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЛОЖЬ КАК РанееРегистрировалсяВПрослеживаемости,
	|	0 КАК КоличествоУчет,
	|	ВТ_ТаблицаТоваров.ТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.ВидОперации КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваровРазмеченный
	|ИЗ
	|	ВТ_ТоварыПоОснованию КАК ВТ_ТаблицаТоваров";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Дата, Номер, ЭтоКорректировка, ДокументОснование, ЗабалансовыйСчет");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПериодДвижений", ДанныеДокумента.Дата); 
	Запрос.УстановитьПараметр("ГраницаДокумента", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ИмяДокумента"			, НСтр("ru = 'Приходный ордер'"));
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ДанныеДокумента.Номер));
	Если ДанныеДокумента.ЭтоКорректировка Тогда
		Запрос.УстановитьПараметр("КорректируемыйДокумент", ДанныеДокумента.ДокументОснование);
	КонецЕсли;
	УчетПодр = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02").УчетПоПодразделениям;
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПодр);
	Запрос.УстановитьПараметр("ЕстьОС", БухгалтерскиеОперации.ЕстьВидСубконто(ДанныеДокумента.ЗабалансовыйСчет, "ОсновныеСредства"));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц);
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ДанныеДокумента.ЭтоКорректировка, ДанныеДокумента.ДокументОснование);
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	ТекстУсловияСписанияЗабалансовыхОС = "ОсновныеСредства.Ссылка.ВидПоступленияМЗ = ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета)
	|	И &ЕстьОС";
	
	УправлениеМатериальнымиЗапасами.ИнициализироватьЗапросыСписанияЗабалансовыхОС(
	Запрос,
	НомераТаблиц,
	"Документ.ПоступлениеМЗ.Материалы",
	ТекстУсловияСписанияЗабалансовыхОС);

	ПрослеживаемостьБГУ.ИнициализироватьЗапросыСвойстваРНПТ(ДокументСсылка, Запрос, НомераТаблиц);

	ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДанныеДокумента.Дата);
	
	ИнициализироватьЗапросыПоЗакупленнымТоварамКомитентов(Запрос, НомераТаблиц, ДанныеДокумента.Дата);
	
	Результат = Запрос.ВыполнитьПакет();
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ДополнительныеСвойства.ТаблицыДляДвижений,
		ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ЭтоКорректировка, КорректируемыйДокумент)

	Запрос.УстановитьПараметр("ИмяДокументаДМ", НСтр("ru = 'Приходный ордер / Требование-накладная'"));
	
	ПараметрыЗапроса = УчетДрагМатериалов.ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА_Параметры(
		"Документ.ПоступлениеМЗ.ДрагоценныеМатериалы", "Приход");
	ПараметрыЗапроса.ЭтоКорректировка = ЭтоКорректировка;
	ПараметрыЗапроса.КорректируемыйДокумент = КорректируемыйДокумент;
	
	УчетДрагМатериалов.ИнициализироватьДанныеДокумента(Запрос, НомераТаблиц, ПараметрыЗапроса);
	 
КонецПроцедуры	

Процедура ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ДвиженияТоваров",       НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТоварыВТорговыхТочках", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата КАК Период,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка КАК Регистратор,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация КАК Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО КАК ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ИзмененияОстатковТоваровВТорговойТочкеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ИзмененияОстатковТоваровВТорговойТочкеТовары
	|ГДЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка = &Ссылка
	|	И ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ПоступлениеТоваровНаСкладТорговойТочки = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДвиженияТоваров.Период КАК Период,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.Организация КАК Организация,
	|	ДвиженияТоваров.ЦМО КАК ЦМО,
	|	ДвиженияТоваров.Номенклатура КАК Номенклатура,
	|	ДвиженияТоваров.Количество КАК Количество
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	РегистрыНакопления.ОтражениеЭДВУчете.ТекстЗапросаПоОтражениюЭДВУчете(Запрос.Параметры.Ссылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДатаДокумента)
	
	Запрос.УстановитьПараметр("Счет", БухгалтерскийУчет.СписокСчетов("02.33", ДатаДокумента));
	
	НомераТаблиц.Вставить("РеализованныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПоступлениеМЗ.Дата КАК Период,
	|	ПоступлениеМЗ.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК Документ.ПоступлениеМЗ).Контрагент КАК Контрагент,
	|	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК Документ.ПоступлениеМЗ).Договор КАК ДоговорКомитента,
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗ.Контрагент КАК Покупатель,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.НакладнаяНаОтпускМ15
	|			ТОГДА ВЫРАЗИТЬ(ПоступлениеМЗ.ДокументОснование КАК Документ.НакладнаяНаОтпускМ15).Дата
	|		КОГДА ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.НакладнаяНаРеализациюТорг12
	|			ТОГДА ВЫРАЗИТЬ(ПоступлениеМЗ.ДокументОснование КАК Документ.НакладнаяНаРеализациюТорг12).Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаРеализации,
	|	ПоступлениеМЗ.Ссылка КАК ДокументРасчетов,
	|	СУММА(-ПоступлениеМЗМатериалы.Количество) КАК Количество,
	|	СУММА(-ПоступлениеМЗМатериалы.Всего) КАК Выручка,
	|	СУММА(-ПоступлениеМЗМатериалы.ЦенаОприходования * ПоступлениеМЗМатериалы.Количество) КАК СуммаПоступления,
	|	СУММА(-ПоступлениеМЗМатериалы.СуммаНДС) КАК СуммаНДС,
	|	ПоступлениеМЗ.Ссылка КАК Ссылка,
	|	ПоступлениеМЗ.Договор КАК Договор
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО ПоступлениеМЗМатериалы.Ссылка = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ПоступлениеМЗ.Ссылка = &Ссылка
	|	И ПоступлениеМЗМатериалы.СчетУчета В(&Счет)
	|	И ПоступлениеМЗ.ВидПоступленияМЗ = ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.ВозвратОтПокупателя)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеМЗ.Дата,
	|	ПоступлениеМЗ.Организация,
	|	ПоступлениеМЗ.Контрагент,
	|	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК Документ.ПоступлениеМЗ).Контрагент,
	|	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК Документ.ПоступлениеМЗ).Договор,
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗ.Ссылка,
	|	ПоступлениеМЗ.Договор,
	|	ПоступлениеМЗ.Ссылка,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.НакладнаяНаОтпускМ15
	|			ТОГДА ВЫРАЗИТЬ(ПоступлениеМЗ.ДокументОснование КАК Документ.НакладнаяНаОтпускМ15).Дата
	|		КОГДА ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.НакладнаяНаРеализациюТорг12
	|			ТОГДА ВЫРАЗИТЬ(ПоступлениеМЗ.ДокументОснование КАК Документ.НакладнаяНаРеализациюТорг12).Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ"; 
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоЗакупленнымТоварамКомитентов(Запрос, НомераТаблиц, ДатаДокумента)
	
	Запрос.УстановитьПараметр("СчетЗакупленныхТоваровКомитенту", БухгалтерскийУчет.СписокСчетов("02.34", ДатаДокумента));
	
	НомераТаблиц.Вставить("ЗакупленныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПоступлениеМЗ.Дата КАК Период,
	|	ПоступлениеМЗ.Организация КАК Организация,
	|	ПоступлениеМЗМатериалы.Комитент КАК Контрагент,
	|	ПоступлениеМЗМатериалы.ДоговорКомитента КАК ДоговорКонтрагента,
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗ.Ссылка КАК Партия,
	|	СУММА(ПоступлениеМЗМатериалы.Количество) КАК Количество,
	|	СУММА(ПоступлениеМЗМатериалы.Всего) КАК Сумма,
	|	СУММА(ПоступлениеМЗМатериалы.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО ПоступлениеМЗМатериалы.Ссылка = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ПоступлениеМЗ.Ссылка = &Ссылка
	|	И ПоступлениеМЗМатериалы.СчетУчета В(&СчетЗакупленныхТоваровКомитенту)
	|	И ПоступлениеМЗ.ВидПоступленияМЗ = ЗНАЧЕНИЕ(Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика)
	|	И ПоступлениеМЗМатериалы.КомиссионнаяТорговля
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеМЗ.Дата,
	|	ПоступлениеМЗ.Организация,
	|	ПоступлениеМЗМатериалы.Комитент,
	|	ПоступлениеМЗМатериалы.ДоговорКомитента,
	|	ПоступлениеМЗМатериалы.Номенклатура,
