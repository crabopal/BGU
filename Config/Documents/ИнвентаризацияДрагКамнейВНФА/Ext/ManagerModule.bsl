	Запрос.УстановитьПараметр("МассивОбъектов", 		МассивОбъектов); 
	Запрос.УстановитьПараметр("ВыводитьФактНаличие",	ВыводитьФактНаличие);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	МассивДанных = Запрос.ВыполнитьПакет();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктИнвентаризацииИНВ9_0317010");
	
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	ОбластьПодписиМОЛ		= Макет.ПолучитьОбласть("ПодписиМОЛ");
	ОбластьПодвалЗаголовка	= Макет.ПолучитьОбласть("ПодвалЗаголовка");
	
	ОбластьЕдиницыИзмерения	= Макет.ПолучитьОбласть("ТаблицаЕдиницИзмерения");
	ОбластьШапка			= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока			= Макет.ПолучитьОбласть("Строка");
	ОбластьПустаяСтрока		= Макет.ПолучитьОбласть("ПустаяСтрока");
	
	ОбластьИтогоПоСтранице 			= Макет.ПолучитьОбласть("ИтогоПоСтранице");
	ОбластьИтогоПоАктуЧисло			= Макет.ПолучитьОбласть("ИтогоПоАктуЧисло");
	ОбластьИтогоПоСтраницеЗаг 		= Макет.ПолучитьОбласть("ИтогоПоСтраницеЗаг");
	
	ОбластьПодвалНачало				= Макет.ПолучитьОбласть("ИтогоПоАкту");
	ОбластьИтоги					= Макет.ПолучитьОбласть("Итоги");
	ОбластьДопСтрока				= Макет.ПолучитьОбласть("ДопСтрока");
	
	ОбластьКомиссия					= Макет.ПолучитьОбласть("Комиссия");
	ОбластьПодвалСередина			= Макет.ПолучитьОбласть("ПодвалСередина");
	ОбластьПодвалКонец				= Макет.ПолучитьОбласть("ПодвалКонец");
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	ПервыйДокумент = Истина;
	ВыборкаШапка = МассивДанных[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия = МассивДанных[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОбъекты = МассивДанных[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаСтроки = МассивДанных[6].Выбрать(); 
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДанныеМОЛ = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, НаименованиеПолное, Должность",
									ВыборкаШапка.ЦМО, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеМОЛ, Истина);
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьЗаголовок,"НомерАкта",ВыборкаШапка.Номер,ВыборкаШапка.Ссылка,, Истина);

		ПараметрыЗаполнения = Новый Структура(
										"ПолноеФИОМОЛ, МолДолжность, МолНаименование",
											ДанныеМОЛ.НаименованиеПолное,
											ДанныеМОЛ.Должность,
											КорреспондентыКлиентСервер.ФИО(ДанныеМОЛ));
		ОбластьПодписиМОЛ.Параметры.Заполнить(ПараметрыЗаполнения);
		
		НомерСтроки = 1;
		
		//------вывод на печать------------																				
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗаголовка);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	    //--------------------------------------------------------------------------------------------------------------
		
		ТабличныйДокумент.Вывести(ОбластьЕдиницыИзмерения);
		
		ТекущаяСтрока = 0;
		СтрокНаСтранице	= 0;
		КоличествоП	= 0;
		МассаП		= 0;
		КоличествоФ	= 0;
		МассаФ		= 0;
		
		ИтогоКоличествоП	= 0;
		ИтогоМассаП			= 0;
		ИтогоКоличествоФ	= 0;
		ИтогоМассаФ			= 0;
		
		КоличествоСтрок = ВыборкаШапка.КоличествоСтрок + ВыборкаШапка.КоличествоОбъектов;
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
	    ВыборкаОбъекты.Сбросить();
		СчетчикОбъектов = 1;
	    Если ВыборкаОбъекты.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
	    	ВыборкаОбъектыНФА = ВыборкаОбъекты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОбъектыНФА.Следующий() Цикл
				
				ВыборкаИнвНомер = ВыборкаОбъектыНФА.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаИнвНомер.Следующий() Цикл
					Выборка = ВыборкаИнвНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока Выборка.Следующий() Цикл
						
						КодОбъектаНФА = ВыборкаОбъектыНФА.Код;
						Если ТипЗнч(ВыборкаОбъектыНФА.ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
							НоменклатурныйНомерМЗ = ВыборкаОбъектыНФА.ОбъектНФА.НоменклатурныйНомер;
							Если ЗначениеЗаполнено(НоменклатурныйНомерМЗ) Тогда
								КодОбъектаНФА = НоменклатурныйНомерМЗ;
							КонецЕсли;	
						КонецЕсли;	
				
						СтруктураОбъектаНФА = Новый Структура("Ном, НаименованиеНФА, КодНФА, ЕдИзм, Количество, НомерИзделия, КоличествоП, МассаП, КоличествоФ, МассаФ",
						                                    СчетчикОбъектов,
															ВыборкаОбъектыНФА.Наименование,
															КодОбъектаНФА,
															Выборка.НаименованиеЕдиницы,
															ВыборкаИнвНомер.Количество,
															ВыборкаИнвНомер.ИнвНомер,
															0,
															0,
															0,
															0
															);
						
						ОбластьСтрока.Параметры.Заполнить(СтруктураОбъектаНФА);
						ТабличныйДокумент.Вывести(ОбластьСтрока);
						
						СчетчикДМ = 1;
						
						ВыборкаСтроки.Сбросить();
						Пока ВыборкаСтроки.НайтиСледующий(Новый Структура("Ссылка, ОбъектНФА, ИнвНомер", ВыборкаШапка.Ссылка, ВыборкаОбъектыНФА.ОбъектНФА, ВыборкаИнвНомер.ИнвНомер)) Цикл
							
							СтруктураДрагМатериала = Новый Структура("Ном, НаименованиеНФА, КодНФА, ЕдИзм, Количество, НомерИзделия, КоличествоП, МассаП, КоличествоФ, МассаФ",
							                                    Строка(СчетчикОбъектов)+"."+Строка(СчетчикДМ),
																"  "+ВыборкаСтроки.ВидДрагМатериала,
																"",
																"",
																0,
																"",
																ВыборкаСтроки.КоличествоП,
																ВыборкаСтроки.МассаП,
																ВыборкаСтроки.КоличествоФ,
																ВыборкаСтроки.МассаФ
																);
							
							ОбластьСтрока.Параметры.Заполнить(СтруктураДрагМатериала);
							ТабличныйДокумент.Вывести(ОбластьСтрока);
							
							СчетчикДМ = СчетчикДМ + 1;
							
							ТекущаяСтрока = ТекущаяСтрока + 1;
							СтрокНаСтранице = СтрокНаСтранице + 1;
							
							// проверим вывод
							
							Массив = Новый Массив;       
							Массив.Добавить(ОбластьСтрока);
							Массив.Добавить(ОбластьИтогоПоСтранице);
							Если ТекущаяСтрока = КоличествоСтрок Тогда
								Массив.Добавить(ОбластьИтогоПоАктуЧисло);
							КонецЕсли;
							Массив.Добавить(ОбластьИтогоПоСтраницеЗаг);
							Массив.Добавить(ОбластьИтоги);
							Если Не ТабличныйДокумент.ПроверитьВывод(Массив) Тогда
								
								ПараметрыЗаполнения = Новый Структура;
								ПараметрыЗаполнения.Вставить("КоличествоП", КоличествоП);
								ПараметрыЗаполнения.Вставить("МассаП", 		МассаП);
								ПараметрыЗаполнения.Вставить("КоличествоФ", КоличествоФ);
								ПараметрыЗаполнения.Вставить("МассаФ", 		МассаФ);
								ОбластьИтогоПоСтранице.Параметры.Заполнить(ПараметрыЗаполнения);
								ТабличныйДокумент.Вывести(ОбластьИтогоПоСтранице);
								
								ТабличныйДокумент.Вывести(ОбластьИтогоПоСтраницеЗаг);
								ВывестиИтогиПоСтраницеИНВ9(	ТабличныйДокумент,
																ОбластьИтоги, 
																СтрокНаСтранице,
																КоличествоФ,
																МассаФ,
																ВыводитьФактНаличие);
								ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();												
								ТабличныйДокумент.Вывести(ОбластьШапка);
								
								СтрокНаСтранице	= 0;
								КоличествоП		= 0;
								МассаП			= 0;
								КоличествоФ		= 0;
								МассаФ			= 0;
								
							КонецЕсли;
							
							КоличествоП 	= КоличествоП  	+ ВыборкаСтроки.КоличествоП;
							МассаП			= МассаП 		+ ВыборкаСтроки.МассаП;
							КоличествоФ 	= КоличествоФ  	+ ВыборкаСтроки.КоличествоФ;
							МассаФ			= МассаФ 		+ ВыборкаСтроки.МассаФ;
							
							ИтогоКоличествоП	= ИтогоКоличествоП + ВыборкаСтроки.КоличествоП;
							ИтогоМассаП			= ИтогоМассаП + ВыборкаСтроки.МассаП;
							ИтогоКоличествоФ	= ИтогоКоличествоФ + ВыборкаСтроки.КоличествоФ;
							ИтогоМассаФ			= ИтогоМассаФ + ВыборкаСтроки.МассаФ;
							
						КонецЦикла;
						СчетчикОбъектов = СчетчикОбъектов + 1;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;	
		
		Массив = Новый Массив;
		Массив.Добавить(ОбластьПустаяСтрока);
		Массив.Добавить(ОбластьПустаяСтрока);
		Массив.Добавить(ОбластьИтогоПоСтранице);
		Массив.Добавить(ОбластьИтогоПоАктуЧисло);
		Массив.Добавить(ОбластьИтогоПоСтраницеЗаг);
		Массив.Добавить(ОбластьИтоги);
		
		Пока ТабличныйДокумент.ПроверитьВывод(Массив) Цикл
			ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("КоличествоП", КоличествоП);
		ПараметрыЗаполнения.Вставить("МассаП", 		МассаП);
		ПараметрыЗаполнения.Вставить("КоличествоФ", КоличествоФ);
		ПараметрыЗаполнения.Вставить("МассаФ", 		МассаФ);
		ОбластьИтогоПоСтранице.Параметры.Заполнить(ПараметрыЗаполнения);
		ТабличныйДокумент.Вывести(ОбластьИтогоПоСтранице);
		
		ПараметрыЗаполнения.КоличествоП	= ИтогоКоличествоП;
		ПараметрыЗаполнения.МассаП		= ИтогоМассаП;
		ПараметрыЗаполнения.КоличествоФ	= ИтогоКоличествоФ;
		ПараметрыЗаполнения.МассаФ		= ИтогоМассаФ;
		ОбластьИтогоПоАктуЧисло.Параметры.Заполнить(ПараметрыЗаполнения);
		ТабличныйДокумент.Вывести(ОбластьИтогоПоАктуЧисло);
		
		ТабличныйДокумент.Вывести(ОбластьИтогоПоСтраницеЗаг);
		ВывестиИтогиПоСтраницеИНВ9(	ТабличныйДокумент,
										ОбластьИтоги, 
										СтрокНаСтранице,
										КоличествоФ,
										МассаФ,
										ВыводитьФактНаличие);
		
	    //--------------------------------------------------------------------------------------------------------------
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ОбластьПодвалНачало);
		ПараметрыЗаполнения.КоличествоП	= ИтогоКоличествоП;
		ПараметрыЗаполнения.МассаП		= ИтогоМассаП;
		ПараметрыЗаполнения.КоличествоФ	= ИтогоКоличествоФ;
		ПараметрыЗаполнения.МассаФ		= ИтогоМассаФ;
		
		ВывестиИтогиПоСтраницеИНВ9(	ТабличныйДокумент,
										ОбластьИтоги, 
										ВыборкаШапка.КоличествоСтрок,
										ИтогоКоличествоФ,
										ИтогоМассаФ,
										ВыводитьФактНаличие);
										
		ТабличныйДокумент.Вывести(ОбластьДопСтрока);
	
		ВыборкаКомиссия.Сбросить();
		ВыборкаКомиссия.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(	ВыборкаШапка, 
																						ВыборкаКомиссия.Выбрать(), 
																						ОбластьКомиссия, 
																						3);
		
		ТабличныйДокумент.Вывести(ОбластьВсяКомиссия);

		Если СчетчикОбъектов > 1 Тогда
			ПервыйНомерСтр = "1";
			ПоследнийНомерСтр = СтрШаблон("%1.%2", Строка(СчетчикОбъектов-1), Строка(СчетчикДМ-1));
		Иначе
			ПервыйНомерСтр = "_______";
			ПоследнийНомерСтр = "_______";
		КонецЕсли;
		
		ОбластьПодвалСередина.Параметры.ПервыйНомер = ПервыйНомерСтр;
		ОбластьПодвалСередина.Параметры.ПоследнийНомер = ПоследнийНомерСтр;
		
		ТабличныйДокумент.Вывести(ОбластьПодвалСередина);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалКонец);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

Процедура ВывестиИтогиПоСтраницеИНВ9(	ТабличныйДокумент,
											ОбластьИтоги,
											КоличествоСтрок,
											КоличествоФ = 0,
											МассаФ = 0,
											ВыводитьФактНаличие = Ложь)

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КоличествоПорядковыхНомеровПрописью", ЧислоПрописью(КоличествоСтрок,, ",,,м,,,,,0"));
	Если ВыводитьФактНаличие Тогда
		СтруктураПараметров.Вставить("КоличествоФактическоеПрописью",
				УчетДрагМатериалов.КоличествоМЦПрописью(КоличествоФ));
		СтруктураПараметров.Вставить("МассаФактическаяПрописью",
				УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассаФ));
	КонецЕсли;
	
	ОбластьИтоги.Параметры.Заполнить(СтруктураПараметров);
	ТабличныйДокумент.Вывести(ОбластьИтоги);

КонецПроцедуры


Функция ПечатьФормыИНВ22(МассивОбъектов, ОбъектыПечати) 
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ИнвентаризацияДрагКамней_ПечатьФормыИНВ22";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИНВ22");

	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("ВидИнвЛомОтходы",	Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВЛомеОтходах);
	ЗапросПечать.УстановитьПараметр("МассивСсылок",		МассивОбъектов);
	ЗапросПечать.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка КАК ДокСсылка,
	|	Док.Номер КАК Номер,
	|	Док.ДатаИнвентаризации КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	Док.Организация.КодОКПО КАК КодОКПО,
	|	Док.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	Док.НомерПриказаИнвентаризации КАК НомерПриказаИнвентаризации,
	|	Док.ДатаПриказаИнвентаризации КАК ДатаПриказаИнвентаризации,
	|	ВЫБОР
	|		КОГДА Док.ВидИнвентаризации = &ВидИнвЛомОтходы
	|			ТОГДА ""Драгоценные камни, содержащиеся в ломе и отходах""
	|		ИНАЧЕ ""Драгоценные камни, природные алмазы и изделия из них""
	|	КОНЕЦ КАК НаименованиеИмуществаОбязательств,
	|	Док.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания,
	|	Док.ПричинаИнвентаризации КАК ПричинаПроведенияИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияДрагКамнейВНФА КАК Док
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияДрагКамнейВНФА.СоставКомиссии КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В(&МассивСсылок)
	|ИТОГИ ПО
	|	ДокСсылка";
	
	ЗапросПечать.ВыполнитьПакет();
	
	Результаты = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= Результаты[0].Выбрать();
	ВыборкаДокКомиссия	= Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
		ОбластьКомиссия	= Макет.ПолучитьОбласть("Комиссия");
		ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
		
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокКомиссия = ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		КоличествоСтрок = 0;
		
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент	= Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		НомерСтраницы = 1;
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьШапка,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,,Истина);
		ТабДокумент.Вывести(ОбластьШапка);
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ВыборкаШапка["Организация"],
			ВыборкаШапка["Дата"]);
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("ДолжностьРуководителя",	Руководитель["ДолжностьПредставление"]);
		ЗначенияПараметров.Вставить("ФИОРуководителя",			КорреспондентыКлиентСервер.ФИО(Руководитель["ОтветственноеЛицоФИО"]));
		ЗначенияПараметров.Вставить("ДатаНачала",		Формат(ВыборкаШапка["ДатаНачала"], "ДФ=dd.MM.yyyy"));
		ЗначенияПараметров.Вставить("ДатаОкончания",	Формат(ВыборкаШапка["ДатаОкончания"], "ДФ=dd.MM.yyyy"));
		ОбластьПодвал.Параметры.Заполнить(ВыборкаШапка);
		ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьИнвОписиЛомОтходы(МассивОбъектов, ОбъектыПечати, ВыводитьФактНаличие = Ложь)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если НЕ ПечатнаяФормаСоответствует(МассивОбъектов, Истина) Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентаризацияДрагКамнейВНФАИнвентаризация.Ссылка,
	|	КОЛИЧЕСТВО(ИнвентаризацияДрагКамнейВНФАИнвентаризация.НомерСтроки) КАК КоличествоСтрок
	|ПОМЕСТИТЬ ВсегоСтрокВИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияДрагКамнейВНФА.Инвентаризация КАК ИнвентаризацияДрагКамнейВНФАИнвентаризация
	|
	|СГРУППИРОВАТЬ ПО
	|	ИнвентаризацияДрагКамнейВНФАИнвентаризация.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ИнвентаризацияДрагКамнейВНФАИнвентаризация.Ссылка,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияДрагКамнейВНФАИнвентаризация.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ПОДСТРОКА(ИнвентаризацияДрагКамнейВНФАИнвентаризация.ОбъектНФА.Наименование, 1, 30) + ИнвентаризацияДрагКамнейВНФАИнвентаризация.ОбъектНФА.Код
	|		ИНАЧЕ ПОДСТРОКА(ИнвентаризацияДрагКамнейВНФАИнвентаризация.ОбъектНФА.Наименование, 1, 30) + ИнвентаризацияДрагКамнейВНФАИнвентаризация.ОбъектНФА.Код + ИнвентаризацияДрагКамнейВНФАИнвентаризация.ИнвентарныйНомер.Код
	|	КОНЕЦ КАК КлючОбъекта,
	|	1 КАК Количество
	|ПОМЕСТИТЬ ОбъектыНФА
	|ИЗ
	|	Документ.ИнвентаризацияДрагКамнейВНФА.Инвентаризация КАК ИнвентаризацияДрагКамнейВНФАИнвентаризация
	|ГДЕ
	|	ИнвентаризацияДрагКамнейВНФАИнвентаризация.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбъектыНФА.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(ОбъектыНФА.Количество) КАК КоличествоОбъектов
	|ПОМЕСТИТЬ ДанныеОКоличествеОбъектов
	|ИЗ
	|	ОбъектыНФА КАК ОбъектыНФА
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбъектыНФА.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризацияДрагКамнейВНФА.Ссылка КАК Ссылка,
	|	ИнвентаризацияДрагКамнейВНФА.Номер КАК Номер,
	|	ИнвентаризацияДрагКамнейВНФА.ДатаИнвентаризации КАК Дата,
	|	ИнвентаризацияДрагКамнейВНФА.Организация,
	|	ИнвентаризацияДрагКамнейВНФА.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	ИнвентаризацияДрагКамнейВНФА.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	ИнвентаризацияДрагКамнейВНФА.Организация.КодОКПО КАК КодОКПО,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО ССЫЛКА Справочник.ЦМО
	|			ТОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО ССЫЛКА Справочник.Сотрудники
	|			ТОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|	КОНЕЦ КАК ПолноеФИОМОЛ,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО ССЫЛКА Справочник.ЦМО
	|			ТОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО.Сотрудник
	|		КОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО ССЫЛКА Справочник.Сотрудники
	|			ТОГДА ИнвентаризацияДрагКамнейВНФА.ЦМО
	|	КОНЕЦ КАК ЦМО,
	|	ИнвентаризацияДрагКамнейВНФА.НомерПриказаИнвентаризации КАК НомерПриказа,
	|	ИнвентаризацияДрагКамнейВНФА.ДатаПриказаИнвентаризации КАК ДатаПриказа,
	|	ИнвентаризацияДрагКамнейВНФА.МестоИнвентаризации,
	|	ИнвентаризацияДрагКамнейВНФА.ДатаНачала КАК ДатаНачалаИнвентаризации,
	|	ИнвентаризацияДрагКамнейВНФА.ДатаОкончания КАК ДатаОкончанияИнвентаризации,
	|	ИнвентаризацияДрагКамнейВНФА.ДолжностьПредседателяКомиссии,
	|	ИнвентаризацияДрагКамнейВНФА.ФамилияПредседателяКомиссии,
	|	ИнвентаризацияДрагКамнейВНФА.ИмяПредседателяКомиссии,
	|	ИнвентаризацияДрагКамнейВНФА.ОтчествоПредседателяКомиссии,
	|	ВсегоСтрокВИнвентаризации.КоличествоСтрок,
	|	ДанныеОКоличествеОбъектов.КоличествоОбъектов
	|ИЗ
	|	ДанныеОКоличествеОбъектов КАК ДанныеОКоличествеОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризацияДрагКамнейВНФА КАК ИнвентаризацияДрагКамнейВНФА
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВсегоСтрокВИнвентаризации КАК ВсегоСтрокВИнвентаризации
	|			ПО (ВсегоСтрокВИнвентаризации.Ссылка = ИнвентаризацияДрагКамнейВНФА.Ссылка)
	|		ПО ДанныеОКоличествеОбъектов.Ссылка = ИнвентаризацияДрагКамнейВНФА.Ссылка
	|ГДЕ
	|	ИнвентаризацияДрагКамнейВНФА.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.Ссылка КАК Ссылка,
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.НомерСтроки,
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.ДолжностьЧленаКомиссии,
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.ФамилияЧленаКомиссии,
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.ИмяЧленаКомиссии,
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияДрагКамнейВНФА.СоставКомиссии КАК ИнвентаризацияДрагКамнейВНФАСоставКомиссии
	|ГДЕ
	|	ИнвентаризацияДрагКамнейВНФАСоставКомиссии.Ссылка В(&МассивОбъектов)
