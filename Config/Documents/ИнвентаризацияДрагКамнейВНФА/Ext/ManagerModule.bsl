#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПроцедурыИФункцииПечати

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнвентаризацияДрагКамнейВНФА";
	КомандаПечати.Идентификатор = "ИнвОписьИНВ9";
	КомандаПечати.Представление = НСтр("ru = 'Акт инвентаризации драгоценных камней (ИНВ-9)'");
	КомандаПечати.Порядок		= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнвентаризацияДрагКамнейВНФА";
	КомандаПечати.Идентификатор = "ИнвОписьИНВ9фактНаличие";
	КомандаПечати.Представление = НСтр("ru = 'Акт инвентаризации драгоценных камней (ИНВ-9) (факт. наличие)'");
	КомандаПечати.Порядок		= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнвентаризацияДрагКамнейВНФА";
	КомандаПечати.Идентификатор = "ИнвОписьЛомОтходы";
	КомандаПечати.Представление = НСтр("ru = 'Акт инвентаризации драгоценных камней в ломе и отходах'");
	КомандаПечати.Порядок		= 3;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнвентаризацияДрагКамнейВНФА";
	КомандаПечати.Идентификатор = "ИнвОписьЛомОтходыфактНаличие";
	КомандаПечати.Представление = НСтр("ru = 'Акт инвентаризации драгоценных камней в ломе и отходах (факт. наличие)'");
	КомандаПечати.Порядок		= 4;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнвентаризацияДрагКамнейВНФА";
	КомандаПечати.Идентификатор = "ПечатьИнв22";
	КомандаПечати.Представление = НСтр("ru = 'Приказ о проведении инвентаризации (ИНВ-22)'");
	КомандаПечати.Порядок		= 5;
		
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ИнвОписьИНВ9") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(	
											КоллекцияПечатныхФорм,
											"ИнвОписьИНВ9",
											"Акт инвентаризации драгоценных камней (ИНВ-9) (ф. 0317009)",
											ПечатьИнвОписиИНВ9(МассивОбъектов, ОбъектыПечати));
											
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ИнвОписьИНВ9фактНаличие") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(	
											КоллекцияПечатныхФорм,
											"ИнвОписьИНВ9фактНаличие",
											"Акт инвентаризации драгоценных камней (ИНВ-9) (ф. 0317009)",
											ПечатьИнвОписиИНВ9(МассивОбъектов, ОбъектыПечати, Истина));
											
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ИнвОписьЛомОтходы") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(	
											КоллекцияПечатныхФорм,
											"ИнвОписьЛомОтходы",
											"Акт инвентаризации драгоценных камней в ломе и отходах",
											ПечатьИнвОписиЛомОтходы(МассивОбъектов, ОбъектыПечати));
											
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ИнвОписьЛомОтходыфактНаличие") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(	
											КоллекцияПечатныхФорм,
											"ИнвОписьЛомОтходыфактНаличие",
											"Акт инвентаризации драгоценных камней в ломе и отходах",
											ПечатьИнвОписиЛомОтходы(МассивОбъектов, ОбъектыПечати, Истина));
											
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнв22") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(	
											КоллекцияПечатныхФорм,
											"ПечатьИнв22",
											"Приказ ИНВ-22",
											ПечатьФормыИНВ22(МассивОбъектов, ОбъектыПечати));
											
	КонецЕсли;
		
КонецПроцедуры // Печать()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьИнвОписиИНВ9(МассивОбъектов, ОбъектыПечати, ВыводитьФактНаличие = Ложь)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если НЕ ПечатнаяФормаСоответствует(МассивОбъектов) Тогда
		Возврат ТабличныйДокумент;
