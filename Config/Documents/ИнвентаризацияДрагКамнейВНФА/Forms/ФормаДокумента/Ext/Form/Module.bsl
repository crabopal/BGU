&НаКлиенте
Процедура КомандаЗаполнитьПоБУЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КомандаЗаполнитьПоБУФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПоБУФрагмент()
	
	ЗаполнитьТаблицуИнвентаризацияПоБУ();
	
	Если Объект.Инвентаризация.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Нет данных для заполнения инвентаризации'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИнвентаризацияПоУчетуИНВ9(МассивЦМО, МассивДрагМатериалов, ТолькоПересчитать = Ложь)
	
		
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиЕдиницИзмеренияДрагМатериалов.Организация КАК Организация,
	|	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
	|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ НастройкиЕдиницИзмерения
	|ИЗ
	|	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	|ГДЕ
	|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения = &Караты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ ДанныеОСПоЦМО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаСведений,
	|			Счет В ИЕРАРХИИ (&МассивСчетовОС) И Счет.Код <> ""МЦК"",
	|			&МассивСубконтоОС,
	|			Организация = &Организация
	|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.Организация КАК Организация,
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО
	|ПОМЕСТИТЬ МестонахождениеОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&ДатаСведений,
	|			Организация = &Организация
	|				И &ПодразделенияНет) КАК СтоимостьОбъектовОСОстатки
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Организация,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ЦМО
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&ДатаСведений,
	|			Организация = &Организация
	|				И &ПодразделенияНет
	|				И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|					ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
