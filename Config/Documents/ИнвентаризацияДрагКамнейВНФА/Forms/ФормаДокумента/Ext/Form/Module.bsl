	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеМЗПоЦМО.Организация КАК Организация,
	|	ДанныеМЗПоЦМО.ОбъектНФА КАК ОбъектНФА,
	|	ДанныеМЗПоЦМО.ИнвНомер КАК ИнвНомер,
	|	ДанныеМЗПоЦМО.ЦМО КАК ЦМО,
	|	ДанныеМЗПоЦМО.Количество КАК Количество,
	|	ОстаткиМЗИК.ОбщееКоличество КАК ОбщееКоличество,
	|	ВЫРАЗИТЬ(ДанныеМЗПоЦМО.ОбъектНФА КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ИтоговыеДанныеОбОстаткахМЗ
	|ИЗ
	|	ДанныеМЗПоЦМО КАК ДанныеМЗПоЦМО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМЗИК КАК ОстаткиМЗИК
	|		ПО ДанныеМЗПоЦМО.Организация = ОстаткиМЗИК.Организация
	|			И ДанныеМЗПоЦМО.ОбъектНФА = ОстаткиМЗИК.ОбъектНФА
	|			И ДанныеМЗПоЦМО.ИнвНомер = ОстаткиМЗИК.ИнвНомер
	|ГДЕ
	|	ДанныеМЗПоЦМО.ЦМО В(&МассивЦМО)
	|	И ДанныеМЗПоЦМО.Организация = &Организация"
	
	+
	
	УчетДрагМатериалов.ДополнитьТекстЗапросаИнвентаризацияПоУчетуИНВ()
	
	+
	
	"ВЫБРАТЬ
	|	ДанныеМЦ.Организация КАК Организация,
	|	ДанныеМЦ.ОбъектНФА КАК ОбъектНФА,
	|	ДанныеМЦ.ЦМО КАК ЦМО,
	|	ДанныеМЦ.ИнвНомер КАК ИнвНомер,
	|	СУММА(ДанныеМЦ.Количество) КАК Количество,
	|	ДанныеМЦ.ОбщееКоличество КАК ОбщееКоличество,
	|	ДанныеМЦ.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ИтоговыеДанныеМЦ
	|ИЗ
	|	ДанныеМЦ КАК ДанныеМЦ 
	|СГРУППИРОВАТЬ ПО
	|	ДанныеМЦ.Организация,
	|	ДанныеМЦ.ОбъектНФА,
	|	ДанныеМЦ.ЦМО,
	|	ДанныеМЦ.ИнвНомер,
	|	ДанныеМЦ.ОбщееКоличество,
	|	ДанныеМЦ.ЕдиницаИзмерения
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация КАК Организация,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК ИнвНомер,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НастройкиЕдиницИзмерения.Коэффициент, 0) <> 0
	|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток, 0) * НастройкиЕдиницИзмерения.Коэффициент КАК ЧИСЛО(17, 8))
	|		ИНАЧЕ ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток, 0)
	|	КОНЕЦ КАК МассаДМОстаток,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	|	НастройкиЕдиницИзмерения.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ ОстаткиДрагМатериалов
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(
	|			&ДатаСведений,
	|			Организация = &Организация
	|				И ВидДрагМатериала В (&МассивДрагМатериалов)) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницИзмерения КАК НастройкиЕдиницИзмерения
	|		ПО НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = НастройкиЕдиницИзмерения.Организация
	|			И НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм = НастройкиЕдиницИзмерения.УчетнаяЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговыеДанныеМЦ.ОбъектНФА КАК ОбъектНФА,
	|	ИтоговыеДанныеМЦ.ИнвНомер КАК ИнвентарныйНомер,
	|	ИтоговыеДанныеМЦ.Количество КАК Количество,
	|	ИтоговыеДанныеМЦ.ОбщееКоличество КАК ОбщееКоличество,
	|	ИтоговыеДанныеМЦ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОстаткиДрагМатериалов.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ОстаткиДрагМатериалов.ЕдИзм КАК ЕдиницаИзмеренияДрагМатериала,
	|	ОстаткиДрагМатериалов.МассаДМОстаток КАК ОбщаяМассаДМОстаток,
	|	ОстаткиДрагМатериалов.КоличествоДМОстаток КАК ОбщееКоличествоДМОстаток,
	|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(ОстаткиДрагМатериалов.МассаДМОстаток КАК ЧИСЛО(17, 8))) * (ВЫРАЗИТЬ(ИтоговыеДанныеМЦ.Количество КАК ЧИСЛО(17, 8))) / (ВЫРАЗИТЬ(ИтоговыеДанныеМЦ.ОбщееКоличество КАК ЧИСЛО(17, 8))) КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
	|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(ОстаткиДрагМатериалов.КоличествоДМОстаток КАК ЧИСЛО(17, 8))) * (ВЫРАЗИТЬ(ИтоговыеДанныеМЦ.Количество КАК ЧИСЛО(17, 8))) / (ВЫРАЗИТЬ(ИтоговыеДанныеМЦ.ОбщееКоличество КАК ЧИСЛО(17, 8))) КАК ЧИСЛО(17, 0)) КАК КоличествоДМУчет
	|ПОМЕСТИТЬ ДанныеПоДМ
	|ИЗ
	|	ИтоговыеДанныеМЦ КАК ИтоговыеДанныеМЦ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДрагМатериалов КАК ОстаткиДрагМатериалов
	|		ПО ИтоговыеДанныеМЦ.Организация = ОстаткиДрагМатериалов.Организация
	|			И ИтоговыеДанныеМЦ.ОбъектНФА = ОстаткиДрагМатериалов.ОбъектНФА
	|			И ИтоговыеДанныеМЦ.ИнвНомер = ОстаткиДрагМатериалов.ИнвНомер
	|ГДЕ
	|	ОстаткиДрагМатериалов.МассаДМОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПоДМ.ОбъектНФА КАК ОбъектНФА,
	|	ДанныеПоДМ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ДанныеПоДМ.Количество) КАК Количество,
	|	СУММА(ДанныеПоДМ.ОбщееКоличество) КАК ОбщееКоличество,
	|	ДанныеПоДМ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеПоДМ.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала,
	|	СУММА(ДанныеПоДМ.ОбщаяМассаДМОстаток) КАК ОбщаяМассаДМОстаток,
	|	СУММА(ДанныеПоДМ.ОбщееКоличествоДМОстаток) КАК ОбщееКоличествоДМОстаток,
	|	СУММА(ДанныеПоДМ.МассаДМУчет) КАК МассаДМУчет,
	|	СУММА(ДанныеПоДМ.КоличествоДМУчет) КАК КоличествоДМУчет
	|ИЗ
	|	ДанныеПоДМ КАК ДанныеПоДМ
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеПоДМ.ОбъектНФА,
	|	ДанныеПоДМ.ИнвентарныйНомер,
	|	ДанныеПоДМ.ЕдиницаИзмерения,
	|	ДанныеПоДМ.ВидДрагМатериала,
	|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала";	
			
			
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	МассивСчетовОС = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Объект.Организация, МассивСчетовОС, "Основные средства");
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	МассивСчетовМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Объект.Организация, МассивСчетовМЗ, "Номенклатура");
	МассивСчетовМЗИК = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗИК();  
	
	МассивСчетовМЦ = БухгалтерскийУчет.СписокСчетов("МЦК");
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивСубконтоМЦ = Новый Массив; 
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивСчетовКапвложенийИК = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийИК();
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПодразделенияНет", "Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",	Объект.Подразделение);
	Иначе
		Запрос.УстановитьПараметр("ПодразделенияНет",	Истина);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаСведений", 			ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(Объект.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",		УчетДрагМатериалов.Штуки());
	Запрос.УстановитьПараметр("МассивЦМО",				МассивЦМО);
	Запрос.УстановитьПараметр("МассивСчетовОС",			МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСчетовМЗ",			МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСчетовМЗИК",		МассивСчетовМЗИК);
	Запрос.УстановитьПараметр("МассивСчетовМЦ",			МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоОС",		МассивСубконтоОС);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",		МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ",		МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСчетовКапвложенийИК",	МассивСчетовКапвложенийИК);
	Запрос.УстановитьПараметр("МассивДрагМатериалов",	МассивДрагМатериалов);
	Запрос.УстановитьПараметр("Караты",					УчетДрагМатериалов.Караты());
	
	РезультатЗапроса = Запрос.Выполнить();
	Объект.Инвентаризация.Загрузить(РезультатЗапроса.Выгрузить());
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуИнвентаризацияПоУчетуЛомаОтходов(МассивЦМО, МассивДрагМатериалов, ТолькоПересчитать = Ложь)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеЛомВсе
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеЛом
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И &ПодразделенияНет
			|				И Субконто2 В (&МассивЦМО)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеЛом.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеЛом.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеЛом.ЦМО КАК ЦМО,
			|	ВЫБОР
			|		КОГДА ДанныеЛом.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|			ТОГДА ДанныеЛом.Количество
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Количество,
			|	ВЫБОР
			|		КОГДА ДанныеЛом.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(ДанныеЛомВсе.Количество, 1)
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК КоличествоВсего
			|ПОМЕСТИТЬ ПолныеДанныеЛом
			|ИЗ
			|	ДанныеЛом КАК ДанныеЛом
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеЛомВсе КАК ДанныеЛомВсе
			|		ПО (ДанныеЛомВсе.ОбъектНФА = ДанныеЛом.ОбъектНФА)
			|			И (ДанныеЛомВсе.ИнвентарныйНомер = ДанныеЛом.ИнвентарныйНомер)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеЛом.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеЛом.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеЛом.Количество КАК Количество,
			|	ДанныеЛом.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток * ДанныеЛом.Количество / ДанныеЛом.КоличествоВсего КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ВЫБОР
			|		КОГДА ДанныеЛом.ОбъектНФА ССЫЛКА Справочник.Номенклатура
			|			ТОГДА ДанныеЛом.ОбъектНФА.ЕдиницаИзмерения
			|		ИНАЧЕ &ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЕдИзм КАК ЕдиницаИзмеренияДрагМатериала
			|ПОМЕСТИТЬ ДанныеВУчетныхЕдиницах
			|ИЗ
			|	ПолныеДанныеЛом КАК ДанныеЛом
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ВидДрагМатериала В (&МассивДрагМатериалов)) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
			|		ПО ДанныеЛом.ОбъектНФА = НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА
			|ГДЕ
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
			|ПОМЕСТИТЬ НастройкиЕдиницУчета
			|ИЗ
			|	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
			|ГДЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения = &Караты
			|	И НастройкиЕдиницИзмеренияДрагМатериалов.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеВУчетныхЕдиницах.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеВУчетныхЕдиницах.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеВУчетныхЕдиницах.Количество КАК Количество,
			|	ДанныеВУчетныхЕдиницах.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(ДанныеВУчетныхЕдиницах.МассаДМУчет * ВЫБОР
			|			КОГДА НастройкиЕдиницУчета.Коэффициент ЕСТЬ NULL
			|				ТОГДА 1
			|			КОГДА НастройкиЕдиницУчета.Коэффициент = 0
			|				ТОГДА 1
			|			ИНАЧЕ НастройкиЕдиницУчета.Коэффициент
			|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала,
			|	ДанныеВУчетныхЕдиницах.КоличествоВсего КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеПоДМ
			|ИЗ
			|	ДанныеВУчетныхЕдиницах КАК ДанныеВУчетныхЕдиницах
			|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницУчета КАК НастройкиЕдиницУчета
			|		ПО ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала = НастройкиЕдиницУчета.УчетнаяЕдиницаИзмерения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеПоДМ.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеПоДМ.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СУММА(ДанныеПоДМ.Количество) КАК Количество,
			|	ДанныеПоДМ.ВидДрагМатериала КАК ВидДрагМатериала,
			|	СУММА(ДанныеПоДМ.МассаДМУчет) КАК МассаДМУчет,
			|	ДанныеПоДМ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала,
			|	СУММА(ДанныеПоДМ.КоличествоВсего) КАК КоличествоВсего
			|ИЗ
			|	ДанныеПоДМ КАК ДанныеПоДМ
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеПоДМ.ОбъектНФА,
			|	ДанныеПоДМ.ИнвентарныйНомер,
			|	ДанныеПоДМ.ВидДрагМатериала,
			|	ДанныеПоДМ.ЕдиницаИзмерения,
			|	ДанныеПоДМ.ЕдиницаИзмеренияДрагМатериала";			
			
			
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	МассивСчетовОС = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Объект.Организация, МассивСчетовОС, "Основные средства");
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	МассивСчетовМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Объект.Организация, МассивСчетовМЗ, "Номенклатура");
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПодразделенияНет", "Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",	Объект.Подразделение);
	Иначе
		Запрос.УстановитьПараметр("ПодразделенияНет",	Истина);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", 				ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(Объект.ДатаИнвентаризации));
	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",		УчетДрагМатериалов.Штуки());
	Запрос.УстановитьПараметр("МассивЦМО",				МассивЦМО);
	Запрос.УстановитьПараметр("МассивСчетовОС",			МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСчетовМЗ",			МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоОС",		МассивСубконтоОС);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",		МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("МассивДрагМатериалов",	МассивДрагМатериалов);
	Запрос.УстановитьПараметр("Караты",				УчетДрагМатериалов.Караты());
	
	РезультатЗапроса = Запрос.Выполнить();
	Объект.Инвентаризация.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуИнвентаризацияПоБУ(ТолькоПересчитать = Ложь)
	
	МассивЦМО = МассивЦМО();
	МассивДМ = МассивДМ();
	
	Если Объект.ВидИнвентаризации = Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВЛомеОтходах Тогда
		ЗаполнитьТаблицуИнвентаризацияПоУчетуЛомаОтходов(МассивЦМО, МассивДМ, ТолькоПересчитать)
	ИначеЕсли Объект.ВидИнвентаризации = Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВНФА Тогда	
		ЗаполнитьТаблицуИнвентаризацияПоУчетуИНВ9(МассивЦМО, МассивДМ, ТолькоПересчитать)
	Иначе
		Возврат;
	КонецЕсли;	
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыИнвентаризация();
	
КонецПроцедуры // ЗаполнитьТаблицуИнвентаризацияПоБУ()

&НаСервере
Функция МассивЦМО()
	
	МассивЦМО = Новый Массив;
	Если ТипЗнч(Объект.ЦМО) = Тип("СправочникСсылка.Сотрудники") Тогда
		ЗапросМОЛ = Новый Запрос;
		ЗапросМОЛ.Текст = "ВЫБРАТЬ
		                  |	ЦМО.Ссылка
		                  |ИЗ
		                  |	Справочник.ЦМО КАК ЦМО
		                  |ГДЕ
		                  |	ЦМО.Сотрудник = &Сотрудник
		                  |	И ЦМО.ПометкаУдаления = ЛОЖЬ";
					
		ЗапросМОЛ.УстановитьПараметр("Сотрудник", Объект.ЦМО);
		РезультатЗапросаМОЛ = ЗапросМОЛ.Выполнить();
		Выборка = РезультатЗапросаМОЛ.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивЦМО.Добавить(Выборка.Ссылка);
		КонецЦикла;	
	ИначеЕсли ТипЗнч(Объект.ЦМО) = Тип("СправочникСсылка.ЦМО") Тогда	
		МассивЦМО.Добавить(Объект.ЦМО);
	КонецЕсли;	
	
	Возврат МассивЦМО;
КонецФункции	

&НаСервере
Функция МассивДМ()
	ТипДМ = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни;
	
	МассивДМ = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ОтборДрагоценныйМатериал) Тогда
		Если Объект.ОтборДрагоценныйМатериал.ЭтоГруппа Тогда
			МассивДМ = УчетДрагМатериалов.МассивДрагМатериалов(ТипДМ, Объект.ОтборДрагоценныйМатериал);
		Иначе	
			МассивДМ.Добавить(Объект.ОтборДрагоценныйМатериал);
		КонецЕсли;
	Иначе
		МассивДМ = УчетДрагМатериалов.МассивДрагМатериалов(ТипДМ);
	КонецЕсли;
	
	Возврат МассивДМ;	
КонецФункции	

&НаСервере
Процедура ПересчитатьФУпоБУ()

	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Для каждого ТекущиеДанные Из Объект.Инвентаризация Цикл
		ТекущиеДанные.МассаДМФакт = ТекущиеДанные.МассаДМУчет;
		ТекущиеДанные.КоличествоДМФакт = ТекущиеДанные.КоличествоДМУчет;
	КонецЦикла; 	

КонецПроцедуры // ПересчитатьФУпоБУ()

&НаКлиенте
Функция НельзяДобавитьВТЧИнвентаризация()

	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									НСтр("ru = 'Не заполнен обязательный реквизит ""Организация""'"),
									,
									"Объект.Организация",,Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ЦМО) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									НСтр("ru = 'Не заполнен обязательный реквизит ""МОЛ / Место хранения""'"),
									,
									"Объект.ЦМО",,Отказ);
	КонецЕсли;
	Возврат Отказ;							

КонецФункции // НельзяДобавитьВТЧИнвентаризация()

&НаКлиенте
Процедура ДоступностьСвязанныхРеквизитовОрганизации()

	ЗначениеДоступности = ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность 	= ЗначениеДоступности;
	Элементы.ЦМО.Доступность			= ЗначениеДоступности;

КонецПроцедуры // ДоступностьСвязанныхРеквизитовОрганизации()

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	РазрешеноРедактированиеОбъекта = РазрешеноРедактированиеОбъекта(Объект)
									И ПравоДоступа("Изменение", Метаданные.Документы.ИнвентаризацияДрагКамнейВНФА);

	МассивРеквизитовТолькоПросмотр = Новый Массив;
	МассивРеквизитовТолькоПросмотр.Добавить("Номер");
	МассивРеквизитовТолькоПросмотр.Добавить("Дата");
	МассивРеквизитовТолькоПросмотр.Добавить("Организация");
	МассивРеквизитовТолькоПросмотр.Добавить("Подразделение");
	МассивРеквизитовТолькоПросмотр.Добавить("ЦМО");
	МассивРеквизитовТолькоПросмотр.Добавить("НомерПриказа");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаПриказа");
	МассивРеквизитовТолькоПросмотр.Добавить("ДолжностьПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ФамилияПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ИмяПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("ОтчествоПредседателяКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("НомерПриказаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаПриказаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаНачала");
	МассивРеквизитовТолькоПросмотр.Добавить("ДатаОкончания");
	МассивРеквизитовТолькоПросмотр.Добавить("ПричинаИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("МестоИнвентаризации");
	МассивРеквизитовТолькоПросмотр.Добавить("Комментарий");
	
	МассивРеквизитовТолькоПросмотр.Добавить("СоставКомиссии");
	МассивРеквизитовТолькоПросмотр.Добавить("Инвентаризация");
	
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(	Элементы, 
																		МассивРеквизитовТолькоПросмотр,
																		"ТолькоПросмотр",
																		НЕ РазрешеноРедактированиеОбъекта);
																		
КонецПроцедуры // УстановитьДоступностьЭлементов()

&НаКлиентеНаСервереБезКонтекста
Функция РазрешеноРедактированиеОбъекта(Объект)

	Если Объект.Проведен Тогда
		#Если НаКлиенте Тогда
		ТекстПредупреждения = НСтр("ru = 'Редактирование проведенного документа запрещено. 
										|Для изменения документа необходимо отменить проведение.'");
		ПоказатьПредупреждение(,ТекстПредупреждения, 15);
		#КонецЕсли
		Возврат Ложь;
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
		
	Возврат НЕ Объект.Проведен;

КонецФункции // РазрешеноРедактированиеОбъекта()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)

	Объект = Форма.Объект;
	ВидИнвентаризации = Объект.ВидИнвентаризации;
	Элементы = Форма.Элементы;
	
	Если ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВЛомеОтходах") Тогда
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоЗаголовок.Видимость = Ложь;
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМУчет.Видимость = Ложь;
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМФакт.Видимость = Ложь;
	ИначеЕсли ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВНФА") Тогда
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоЗаголовок.Видимость = Истина;
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМУчет.Видимость = Истина;
		Элементы.ИнвентаризацияДрагКамниНФАКоличествоДМФакт.Видимость = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоОбъектовНФАЗаголовок = НСтр("ru = 'Количество:'");
	ТекущаяСтрока.ЧистаяМассаЗаголовок = НСтр("ru = 'Масса (кар):'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Количество (шт):'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОбщийТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоОбъектовНФАЗаголовок = НСтр("ru = 'Количество:'");
	ТекущаяСтрока.ЧистаяМассаЗаголовок = НСтр("ru = 'Масса (кар):'");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыИнвентаризация()

	Если Объект.ВидИнвентаризации = Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВЛомеОтходах Тогда
		Для Каждого ТекущаяСтрока Из Объект.Инвентаризация Цикл
			ОбновитьОбщийТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока);
		КонецЦикла;
	ИначеЕсли Объект.ВидИнвентаризации = Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагКамнейВНФА Тогда
		Для Каждого ТекущаяСтрока Из Объект.Инвентаризация Цикл
			ОбновитьТекстЗаголовковВСтрокеТаблицыИнвентаризация(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
