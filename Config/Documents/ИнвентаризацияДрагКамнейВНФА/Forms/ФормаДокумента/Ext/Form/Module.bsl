КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура КомандаЗаполнитьПоБУ(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если НельзяДобавитьВТЧИнвентаризация() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Инвентаризация.Количество() > 0 Тогда
		ТекстВопроса = 
		НСтр("ru = 'При заполнении по данным учета может измениться состав таблицы ""Инвентаризация"":
					|	- будут удалены объекты отсутствующие в учете и по фактическим данным,
					|	- будут добавлены объекты по которым есть данные в учете.
					|Продолжить заполнение с изменением таблицы ""Инвентаризация""?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить заполнение'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Ответ = Неопределено;

		
		ПоказатьВопрос(Новый ОписаниеОповещения("КомандаЗаполнитьПоБУЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 15, КодВозвратаДиалога.Отмена);
		Возврат;
	КонецЕсли;
	
	КомандаЗаполнитьПоБУФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьДанныеБУ(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если НельзяДобавитьВТЧИнвентаризация() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуИнвентаризацияПоБУ(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьФУпоБУ(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьФУпоБУ();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьКомиссию(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентаризацияКлиент.ОткрытьВыборКомиссии(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьПредседателя(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ИнвентаризацияКлиент.ОткрытьВыборПредседателяКомиссии(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодобратьЧленовКомиссии(Команда)
	
	Если НЕ РазрешеноРедактированиеОбъекта(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ИнвентаризацияКлиент.ОткрытьПодборКомиссии(ЭтаФорма);
	
КонецПроцедуры

