#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокОснование = Неопределено;
		ДанныеЗаполнения.Свойство("Основание", ДокОснование);
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияКассы.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
			
		ИначеЕсли ТипЗнч(ДокОснование) = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.АктОРезультатахИнвентаризацииНаличныхДС.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
		
	ИначеЕсли ДанныеЗаполнения	<> Неопределено Тогда
		
		ТекстСообщения = "";
		Если не Документы.ПриходныйКассовыйОрдер.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения; 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ПриходныйКассовыйОрдер.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НаличныеДенежныеСредства")

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	КассаОрганизации.ПроверитьКорректностьЗаполненияТаблицыКассовогоДокумента(ЭтотОбъект,, Отказ);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		
		Если ЗначениеЗаполнено(ВалютаДокумента)
			И ЗначениеЗаполнено(ПроданнаяВалюта)
			И НЕ ВалютаДокумента = ПроданнаяВалюта
			И БухгалтерскийУчет.СчетВИерархии(КорСчет, "201.20") Тогда
			
			ПроверяемыеРеквизиты.Добавить("СуммаПроданнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КурсПроданнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КратностьПроданнойВалюты");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НастройкиЭДО.ИспользуютсяВнутренниеДокументы() Тогда
		ПроверяемыеРеквизиты.Добавить("ГлБухгалтер");
		ПроверяемыеРеквизиты.Добавить("Кассир");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Перем ИсходныйРежимЗаписи;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект); 
	
	ДополнительныеСвойства.Свойство("ИсходныйРежимЗаписи", ИсходныйРежимЗаписи);
	
	ТекущиеПрава = КассаОрганизации.ПраваНаТекущийКассовыйДокумент(Ссылка);
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ = НЕ ТекущиеПрава.РазрешитьОтменуПроведения;
	ИначеЕсли Проведен Тогда
		Если ИсходныйРежимЗаписи <> Неопределено 
			И ИсходныйРежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			Отказ = НЕ ТекущиеПрава.РазрешитьЗапись;
		Иначе
			Отказ = Не ТекущиеПрава.РазрешитьПроведение;
		КонецЕсли;
	Иначе
		Отказ = НЕ ТекущиеПрава.РазрешитьПроведение;
	КонецЕсли;
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для выполнения операции'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("НеПроверятьОтчетКассира", ) Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОтчетКассира = Неопределено;
		Отказ        = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Изменение документа запрещено. Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение и Оплачено = Ложь Тогда
		ОтчетКассира = Неопределено;
		Отказ        = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(ЭтотОбъект, ОтчетКассира);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Нельзя снять флаг ""Оплачено"". Документ включен в отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	ОтчетКассира = Неопределено;
	Отказ        = БухгалтерскийУчет.ЕстьПроведенныйОтчетКассираЗаЭтотДень(ЭтотОбъект, ОтчетКассира);
	Если Отказ Тогда
		
		ТекстСообщения = НСтр("ru='Документ не может быть записан с текущей датой, т.к. за данный день уже имеется проведенный документ Отчет кассира № "+ОтчетКассира.НомерЛиста+".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,ОтчетКассира.Ссылка,,,Отказ);
		Возврат;
		
	КонецЕсли;
	
	Если НЕ УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет) Тогда
		
		Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
			СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			СтрокаРасшифровки.ДопСубконтоРасчетов = Неопределено;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПоступлениеВыручкиТорговойТочки И НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ТекстСообщения = НСтр("ru='Документ отражает выручку за кассовую смену. Следует указать документ ""Отчет по кассовой смене"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументОснование",,Отказ);
		Возврат;
		
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЭтотОбъект.НомерЧекаККМ = 0;
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла;
	
	Оплачено = Ложь;
	Аннулирован = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ остатками задолженности к погашению.
//
Процедура ЗаполнитьПоОстаткамЗадолженности() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	
	ПлатежноРасчетныеДокументы.ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(
		РасшифровкаПлатежа, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
