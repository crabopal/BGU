#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	                      |	ДанныеДокумента.Ссылка.Организация КАК Организация,
	                      |	ВЫБОР
	                      |		КОГДА ДанныеДокумента.Ссылка.Подразделение.ВедетсяКассоваяКнига
	                      |			ТОГДА ДанныеДокумента.Ссылка.Подразделение
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	                      |	КОНЕЦ КАК Подразделение,
	                      |	ДанныеДокумента.Ссылка.ВалютаДокумента КАК Валюта,
	                      |	ДанныеДокумента.Ссылка.Дата КАК Период,
	                      |	ДанныеДокумента.КФО КАК КФО,
	                      |	СУММА(ДанныеДокумента.Сумма) КАК Сумма
	                      |ИЗ
	                      |	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ДанныеДокумента
	                      |ГДЕ
	                      |	ДанныеДокумента.Ссылка = &Ссылка
	                      |	И ДанныеДокумента.Ссылка.Оплачено = ИСТИНА
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ДанныеДокумента.КФО,
	                      |	ДанныеДокумента.Ссылка.Дата,
	                      |	ДанныеДокумента.Ссылка.Организация,
	                      |	ДанныеДокумента.Ссылка.ВалютаДокумента,
	                      |	ВЫБОР
	                      |		КОГДА ДанныеДокумента.Ссылка.Подразделение.ВедетсяКассоваяКнига
	                      |			ТОГДА ДанныеДокумента.Ссылка.Подразделение
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	                      |	КОНЕЦ");	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НаличныеДенежныеСредстваДвижения = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("НаличныеДенежныеСредства",  НаличныеДенежныеСредстваДвижения);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПриходныйКассовыйОрдер";
	КомандаПечати.Идентификатор		= "КО1";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный кассовый ордер'");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"КО1") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"КО1","ПКО",ПечатьКО1(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьКО1(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КО1";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КО1");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Номер КАК Номер,
	|	ПриходныйКассовыйОрдер.Дата КАК ДатаДокумента,
	|	ПриходныйКассовыйОрдер.Организация.НаименованиеПолное КАК ПолноеНаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА ПриходныйКассовыйОрдер.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование = ИСТИНА
	|			ТОГДА ПриходныйКассовыйОрдер.Организация.НаименованиеСокращенное
	|		ИНАЧЕ ПриходныйКассовыйОрдер.Организация.НаименованиеПолное
	|	КОНЕЦ КАК ПредставлениеОрганизации,
	|	ПриходныйКассовыйОрдер.Организация.НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА ПриходныйКассовыйОрдер.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ПриходныйКассовыйОрдер.Подразделение
	|		ИНАЧЕ ПриходныйКассовыйОрдер.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК ПредставлениеПодразделения,
	|	ПриходныйКассовыйОрдер.Счет,
	|	ПриходныйКассовыйОрдер.КорСчет,
	|	ПриходныйКассовыйОрдер.ПодразделениеКор,
	|	ПриходныйКассовыйОрдер.КодАналитическогоУчета,
	|	ПриходныйКассовыйОрдер.КодЦелевогоНазначения.Код КАК КодЦелевогоНазначения,
	|	ПриходныйКассовыйОрдер.СуммаДокумента КАК Сумма,
	|	ПриходныйКассовыйОрдер.ГлБухгалтер,
	|	ПриходныйКассовыйОрдер.Кассир,
	|	ПриходныйКассовыйОрдер.ПринятоОт,
	|	ПриходныйКассовыйОрдер.Основание,
	|	ПриходныйКассовыйОрдер.Приложение,
	|	ПриходныйКассовыйОрдер.Ссылка,
	|	ПриходныйКассовыйОрдер.СтавкаНДС,
	|	ПриходныйКассовыйОрдер.СуммаНДС,
	|	ПриходныйКассовыйОрдер.ВалютаДокумента,
	|	ПриходныйКассовыйОрдер.Организация.Префикс КАК ПрефиксОрганизации,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК КФО,
	|	ЕСТЬNULL(ПриходныйКассовыйОрдер.ПодразделениеКор.Код, """") КАК КодПодразделения,
	|	ПриходныйКассовыйОрдер.Организация.КодОКПО КАК ОрганизацияПоОКПО,
	|	ЛОЖЬ КАК Фондовый,
	|	ПриходныйКассовыйОрдер.ПоступлениеВыручкиТорговойТочки
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|			МАКСИМУМ(ПриходныйКассовыйОрдерРасшифровкаПлатежа.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПриходныйКассовыйОрдерРасшифровкаПлатежа.КФО) КАК КоличествоКФО
	|		ИЗ
	|			Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
	|		ГДЕ
	|			ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка) КАК ВложенныйЗапрос
	|		ПО ПриходныйКассовыйОрдер.Ссылка = ВложенныйЗапрос.Ссылка
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйОрдерФондовый.Номер,
	|	ПриходныйОрдерФондовый.Дата,
	|	ПриходныйОрдерФондовый.Организация.НаименованиеПолное,
	|	ВЫБОР
	|		КОГДА ПриходныйОрдерФондовый.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование = ИСТИНА
	|			ТОГДА ПриходныйОрдерФондовый.Организация.НаименованиеСокращенное
	|		ИНАЧЕ ПриходныйОрдерФондовый.Организация.НаименованиеПолное
	|	КОНЕЦ,
	|	ПриходныйОрдерФондовый.Организация.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА ПриходныйОрдерФондовый.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ПриходныйОрдерФондовый.Подразделение
	|		ИНАЧЕ ПриходныйОрдерФондовый.Подразделение.НаименованиеПолное
	|	КОНЕЦ,
	|	ПриходныйОрдерФондовый.Счет,
	|	ПриходныйОрдерФондовый.КорСчет,
	|	ПриходныйОрдерФондовый.ПодразделениеКор,
	|	ПриходныйОрдерФондовый.КодАналитическогоУчета,
	|	ПриходныйОрдерФондовый.КодЦелевогоНазначения.Код,
	|	ПриходныйОрдерФондовый.СуммаДокумента,
	|	ПриходныйОрдерФондовый.ГлБухгалтер,
	|	ПриходныйОрдерФондовый.Кассир,
	|	ПриходныйОрдерФондовый.ПринятоОт,
	|	ПриходныйОрдерФондовый.Основание,
	|	ПриходныйОрдерФондовый.Приложение,
	|	ПриходныйОрдерФондовый.Ссылка,
	|	NULL,
	|	0,
	|	ВалютаРегламентированногоУчета.Значение,
	|	ПриходныйОрдерФондовый.Организация.Префикс,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ,
	|	ПриходныйОрдерФондовый.ПодразделениеКор.Код,
	|	ПриходныйОрдерФондовый.Организация.КодОКПО,
	|	ИСТИНА,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ПриходныйОрдерФондовый КАК ПриходныйОрдерФондовый
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПриходныйОрдерФондовыйРасшифровка.Ссылка КАК Ссылка,
	|			МАКСИМУМ(ПриходныйОрдерФондовыйРасшифровка.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПриходныйОрдерФондовыйРасшифровка.КФО) КАК КоличествоКФО
	|		ИЗ
	|			Документ.ПриходныйОрдерФондовый.Расшифровка КАК ПриходныйОрдерФондовыйРасшифровка
	|		ГДЕ
	|			ПриходныйОрдерФондовыйРасшифровка.Ссылка В(&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПриходныйОрдерФондовыйРасшифровка.Ссылка) КАК ВложенныйЗапрос
	|		ПО ПриходныйОрдерФондовый.Ссылка = ВложенныйЗапрос.Ссылка,
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	|ГДЕ
	|	ПриходныйОрдерФондовый.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, Шапка);
		
		СтруктураОбластьШапка = Новый Структура("Сумма,СуммаРубКоп,СуммаПрописью,ВТомЧисле,КодДебета,СубСчет,ФИОГлавногоБухгалтера,ФИОКассира,НомерДокумента,ДатаДокументаКв");
		СтруктураОбластьШапка.Сумма = Формат(Шапка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧГ=0");
		СтруктураОбластьШапка.Вставить("СуммаСНазваниемВалюты", Формат(Шапка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧГ=0") + ?(Шапка.ВалютаДокумента = ВалютаРегламентированногоУчета, "", " " + Шапка.ВалютаДокумента));
		СтруктураОбластьШапка.СуммаРубКоп = РубКоп(Шапка.Сумма, Шапка.ВалютаДокумента);
		СтруктураОбластьШапка.СуммаПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Шапка.Сумма, Шапка.ВалютаДокумента);
		
		СтруктураОбластьШапка.Вставить("КодЦелевогоНазначения", СокрЛП(Шапка.КодЦелевогоНазначения));
		
		Если НЕ Шапка.Фондовый Тогда
			ДокументСсылка = Шапка.Ссылка;
			
			Если Шапка.ПоступлениеВыручкиТорговойТочки Тогда
				ДанныеСтавкиДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииПКО(ДокументСсылка);

				Если ДанныеСтавкиДокумента.ТаблицаПоСтавкам.Количество() = 0 Тогда
					СтруктураОбластьШапка.ВТомЧисле = "без налога (НДС)";
				Иначе
					СчетчикСтрок = 1;
					ВсегоСтрок = ДанныеСтавкиДокумента.ТаблицаПоСтавкам.Количество();
					ТекстДляНДС = "НДС";
					Для каждого ТекСтрока Из ДанныеСтавкиДокумента.ТаблицаПоСтавкам Цикл
						ТекстДляНДС = ТекстДляНДС + "(" + ТекСтрока.СтавкаНДС + ")" + РубКоп(ТекСтрока.СуммаНДС, Шапка.ВалютаДокумента);
						Если СчетчикСтрок < ВсегоСтрок Тогда
							ТекстДляНДС = СокрП(ТекстДляНДС) + "; ";
						КонецЕсли;	
						СчетчикСтрок = СчетчикСтрок + 1;	
					КонецЦикла;
					СтруктураОбластьШапка.ВТомЧисле = ТекстДляНДС;
				КонецЕсли;
			ИначеЕсли ДокументСсылка.ДокументыЧекаККМ.Количество() > 0 Тогда
				ДанныеСтавкиДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(ДокументСсылка);
				Если ДанныеСтавкиДокумента.ТаблицаПоСтавкам.Количество() = 0 Тогда
					СтруктураОбластьШапка.ВТомЧисле = "без налога (НДС)";
				Иначе
					СчетчикСтрок = 1;
					ВсегоСтрок = ДанныеСтавкиДокумента.ТаблицаПоСтавкам.Количество();
					ТекстДляНДС = "НДС";
					Для каждого ТекСтрока Из ДанныеСтавкиДокумента.ТаблицаПоСтавкам Цикл
						ТекстДляНДС = ТекстДляНДС + "(" + ТекСтрока.СтавкаНДС + ")" + РубКоп(ТекСтрока.СуммаНДС, Шапка.ВалютаДокумента);
						Если СчетчикСтрок < ВсегоСтрок Тогда
							ТекстДляНДС = СокрП(ТекстДляНДС) + "; ";
						КонецЕсли;	
						СчетчикСтрок = СчетчикСтрок + 1;	
					КонецЦикла;
					СтруктураОбластьШапка.ВТомЧисле = ТекстДляНДС;
				КонецЕсли;
			Иначе
				СтруктураОбластьШапка.ВТомЧисле = ?(Шапка.СуммаНДС > 0, " НДС(" + Шапка.СтавкаНДС + ")" + РубКоп(Шапка.СуммаНДС, Шапка.ВалютаДокумента), "без налога (НДС)");
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураОбластьШапка.КодДебета = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.Счет, , Шапка.КФО);
		СтруктураОбластьШапка.СубСчет = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.КорСчет, , Шапка.КФО);
		
		СтруктураОбластьШапка.ФИОГлавногоБухгалтера=Справочники.Контрагенты.ФамилияИО(Шапка.ГлБухгалтер, Истина, Шапка.ДатаДокумента); 
		СтруктураОбластьШапка.ФИОКассира=Справочники.Контрагенты.ФамилияИО(Шапка.Кассир, Истина, Шапка.ДатаДокумента); 
		
		СтруктураОбластьШапка.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка,Шапка.Номер);
		СтруктураОбластьШапка.ДатаДокументаКв = Формат(Шапка.ДатаДокумента,"ДЛФ=DD");
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		Если Шапка.Фондовый Тогда
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Объединить();
			Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Обвести(Линия, Линия, Линия, Линия);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Текст                   = "Ф О Н Д О В Ы Й";
			ЦветПечати                                              = Новый Цвет(83,114,187); 
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветТекста              = ЦветПечати;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветРамки               = ЦветПечати;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
			ЖирныйШрифт                                             = Новый Шрифт(ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт,, 11, Истина);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт                   = ЖирныйШрифт;
		КонецЕсли;			
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции // ПечатьКО1

// Формирует представление суммы в рублях
//
// Параметры
//  Сумма  - Число - Заданная сумма
//  Валюта  - СправочникСсылка.Валюты - Валюта суммы
//
// Возвращаемое значение:
//   Строка   - Строковое представление суммы.
//
Функция РубКоп(Сумма, Валюта)
	
	Если Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		 ОписаниеВал1 = " руб. ";
		 ОписаниеВал2 = " коп. ";
	Иначе
		 ОписаниеВал1 =  "-";
		 ОписаниеВал2 =  " " + Валюта.Наименование;
	КонецЕсли;	
	
	Коп = ОКР(100*(Сумма-Цел(Сумма)),0,1);
	Руб = Формат(Цел(Сумма), "ЧЦ=15; ЧРД=-; ЧГ=0");
	
	СуммаРубКоп= " " + Руб + ОписаниеВал1 + Строка(Цел(Коп/10)) + Строка(Коп-10*Цел(Коп/10)) + ОписаниеВал2;
	
	Возврат СуммаРубКоп;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Отказ = НЕ Основание.Проведен;
	Если Отказ	Тогда
		ОписаниеОшибки = НСтр("ru='Документ-основание не проведен. Проведите документ-основание и повторите операцию.'");
		Возврат Ложь;
	КонецЕсли;	
	
	ТипДанныхЗаполнения = ТипЗнч(Основание);

	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаНаНаличные") ИЛИ ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаНаНаличныеБанковскаяКарта") Тогда
		Если НЕ ЗаполнитьДокументНаОснованииЗаявкаНаНаличные(Основание, Объект) Тогда
			ОписаниеОшибки = НСтр("ru='Статус документа ""Заявка на наличные"" должен быть Исполнен'");
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		ЗаполнитьДокументНаОснованииОтчетаОРозничныхПродажах(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		ЗаполнитьДокументНаОснованииАвансовогоОтчета(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
		ЗаполнитьДокументНаОснованииОтчетаОРасходахПодотчетногоЛица(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		Если НЕ ЗаполнитьДокументНаОснованииОтчетаПоКассовойСмене(Основание, Объект) Тогда
			Возврат Ложь;
		КонецЕсли;	
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЗаполнитьДокументНаОснованииАктаОбОказанииУслуг(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнитьДокументНаОснованииНакладнойТорг12(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗаполнитьДокументНаОснованииСчетНаОплату(Основание, Объект);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьДокументНаОснованииЗаявкаНаНаличные(Знач ДокументОснования, Объект)
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаявкаНаНаличные.Организация,
	|	ЗаявкаНаНаличные.ИФО,
	|	ЗаявкаНаНаличные.Ссылка КАК ДокументОснование,
	|	ЗаявкаНаНаличные.СуммаДокумента,
	|	ЗаявкаНаНаличные.Работник.Контрагент КАК Контрагент,
	|	ЗаявкаНаНаличные.Подразделение,
	|	ЗаявкаНаНаличные.РасшифровкаПлатежа.(
	|		ИсточникСредств,
	|		Сумма КАК Сумма,
	|		КБКНазначениеПлатежа КАК КПС,
	|		КОСГУНазначениеПлатежа КАК КЭК,
	|		СтрокаНазначениеПлатежа,
	|		Примечание,
	|		КодЦели КАК КодЦели,
	|		КодМероприятия КАК КодМероприятия,
	|		ДопКлассификация КАК ДопКлассификация,
	|		КФО КАК КФО
	|	) КАК Расшифровка,
	|	ЗаявкаНаНаличные.РаботникФИО КАК ПринятоОт,
	|	СостояниеПлатежноРасчетныхДокументов.Статус
	|ИЗ
	|	&ТаблицаДокумента КАК ЗаявкаНаНаличные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|		ПО ЗаявкаНаНаличные.Ссылка = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
	|ГДЕ
	|	ЗаявкаНаНаличные.Ссылка = &Ссылка";
				   
				   
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&ТаблицаДокумента", "Документ." 
	+ ?(ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЗаявкаНаНаличные"), "ЗаявкаНаНаличные", "ЗаявкаНаНаличныеБанковскаяКарта"));
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснования);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	
	Если Основание.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	
	Объект.КорСчет 	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.03");
	Объект.Счет 	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
	
	Расшифровка = Основание.Расшифровка.Выбрать();
	Пока Расшифровка.Следующий() цикл
		РасшифровкаПлатежа = Объект.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(РасшифровкаПлатежа, Расшифровка);
	КонецЦикла;	
	
	
	Возврат Истина;
		
КонецФункции

Функция ЗаполнитьДокументНаОснованииОтчетаОРозничныхПродажах(Знач ДокументОснование, Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтчетОРозничныхПродажах.Дата КАК Дата,
	               |	ОтчетОРозничныхПродажах.Организация КАК Организация,
	               |	ОтчетОРозничныхПродажах.Подразделение КАК Подразделение,
	               |	ОтчетОРозничныхПродажах.СуммаДокумента КАК СуммаДокумента,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеКор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК КорСчет,
	               |	ВалютаРегламентированногоУчета.Значение КАК ВалютаДокумента,
	               |	ОтчетОРозничныхПродажах.ИФО КАК ИФО,
	               |	"""" КАК ПринятоОт,
	               |	ОтчетОРозничныхПродажах.Контрагент КАК Контрагент,
	               |	ЛОЖЬ КАК Оплачено,
	               |	ВЫБОР
	               |		КОГДА ВложенныйЗапрос.КоличествоСтавокНДС = 1
	               |			ТОГДА ВложенныйЗапрос.СтавкаНДС
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК СтавкаНДС,
	               |	ВложенныйЗапрос.СуммаНДС КАК СуммаНДС,
	               |	ОтчетОРозничныхПродажах.Ссылка КАК ДокументОснование,
	               |	ОтчетОРозничныхПродажах.КассирОперационист КАК Кассир,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭК,
	               |	ОтчетОРозничныхПродажах.Продажи.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		Сумма,
	               |		СтавкаНДС,
	               |		СуммаНДС
	               |	),
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	               |	ЗначениеРеквизитовПоУмолчаниюСрезПоследних.ЗначениеРеквизита КАК Счет
	               |ИЗ
	               |	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
	               |	(ВЫБРАТЬ
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтчетОРозничныхПродажахПродажи.СтавкаНДС) КАК КоличествоСтавокНДС,
	               |		СУММА(ОтчетОРозничныхПродажахПродажи.СуммаНДС) КАК СуммаНДС,
	               |		МАКСИМУМ(ОтчетОРозничныхПродажахПродажи.СтавкаНДС) КАК СтавкаНДС
	               |	ИЗ
	               |		Документ.ОтчетОРозничныхПродажах.Продажи КАК ОтчетОРозничныхПродажахПродажи
	               |	ГДЕ
	               |		ОтчетОРозничныхПродажахПродажи.Ссылка = &ДокументОснование) КАК ВложенныйЗапрос,
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор = &ДокументОснование, НомерСтроки, 1) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	               |		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ОтчетОРозничныхПродажах.Ссылка,
	               |	РегистрСведений.ЗначениеРеквизитовПоУмолчанию.СрезПоследних(
	               |			,
	               |			ВидОбъекта = &ИОМ_ПриходныйКассовыйОрдер
	               |				И ИмяРеквизита = ""Счет"") КАК ЗначениеРеквизитовПоУмолчаниюСрезПоследних
	               |ГДЕ
	               |	ОтчетОРозничныхПродажах.Ссылка = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ИОМ_ПриходныйКассовыйОрдер", ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПриходныйКассовыйОрдер")));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Объект, Выборка);
	
	Продажи = Выборка.Продажи.Выбрать();
	Пока Продажи.Следующий() Цикл
	
		НовСтрока = Объект.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Выборка, "КПС, КЭК, КФО");
		ЗаполнитьЗначенияСвойств(НовСтрока, Продажи, "Сумма");
	
	КонецЦикла; 
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьДокументНаОснованииАвансовогоОтчета(Знач ДокументОснование, Объект)
	
	Запрос = Новый Запрос;
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.Сотрудник, "Контрагент");
	
	Запрос.УстановитьПараметр("пСчет", 							БухгалтерскийУчет.СписокСчетов("208.00")); 
	Запрос.УстановитьПараметр("Организация", 					ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Субконто1", 						Контрагент);
	Запрос.УстановитьПараметр("АвансовыйОчетСсылка",			ДокументОснование);
	Запрос.УстановитьПараметр("ДокументыАвансов", 				ДокументОснование.Получено.ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("ДокументыИзрасходовано", 		ДокументОснование.Израсходовано.ВыгрузитьКолонку("ПриходныйДокумент"));
	Запрос.УстановитьПараметр("ДокументыПерерасхода", 			ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументПерерасхода"));
	Запрос.УстановитьПараметр("ДокументыОстатка", 				ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументОстатка"));
	
	Запрос.УстановитьПараметр("МоментВремени", РасчетыСПодотчетнымиЛицами.МоментВремениДокументаНачальногоОстатка(ДокументОснование));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета) КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Валюты.Ссылка ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт
	|	КОНЕЦ КАК ПредыдущийАвансОстаток,
	|	ВЫБОР
	|		КОГДА Валюты.Ссылка ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт
	|	КОНЕЦ КАК ПредыдущийАвансПерерасход,
	|	0 КАК Получено,
	|	0 КАК Израсходовано,
	|	0 КАК ВозвращенОстаток,
	|	0 КАК ВыданПерерасход
	|ПОМЕСТИТЬ ДетальныеДанные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&пСчет),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОстатки.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Счет,
	|	ЖурналПроводокЕПСБУОбороты.КПС,
	|	ЖурналПроводокЕПСБУОбороты.КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета),
	|	ЖурналПроводокЕПСБУОбороты.Субконто1,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыИзрасходовано)
	|				ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор = &АвансовыйОчетСсылка
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыОстатка)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыПерерасхода)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&МоментВремени,
	|			,
	|			Регистратор,
	|			Счет В (&пСчет),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОбороты.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыИзрасходовано)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыОстатка)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыПерерасхода)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор = &АвансовыйОчетСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(СоответствияАналитическихСчетовКЭК.КЭК) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ДетальныеДанные.Счет = СоответствияАналитическихСчетовКЭК.Счет
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоответствияАналитическихСчетовКЭК.КЭК) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДетальныеДанные.Счет КАК КорСчет,
	|	ДетальныеДанные.КПС КАК КПС,
	|	ДетальныеДанные.КФО КАК КФО,
	|	ДетальныеДанные.Валюта КАК ВалютаДокумента,
	|	ДетальныеДанные.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) - СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) + СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) - СУММА(ДетальныеДанные.ВозвращенОстаток) + СУММА(ДетальныеДанные.ВыданПерерасход) > 0
	|			ТОГДА СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) - СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) + СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) - СУММА(ДетальныеДанные.ВозвращенОстаток) + СУММА(ДетальныеДанные.ВыданПерерасход)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма,
	|	АвансовыйОтчет.Организация КАК Организация,
	|	АвансовыйОтчет.ИФО КАК ИФО,
	|	АвансовыйОтчет.Подразделение КАК Подразделение,
	|	АвансовыйОтчет.Подразделение КАК ПодразделениеКор,
	|	АвансовыйОтчет.ОснованиеПринятияОбязательства КАК Договор,
	|	ЕСТЬNULL(СчетКЭК.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК КАК СчетКЭК
	|		ПО ДетальныеДанные.Счет = СчетКЭК.Счет,
	|	Документ.АвансовыйОтчет КАК АвансовыйОтчет
	|ГДЕ
	|	АвансовыйОтчет.Ссылка = &АвансовыйОчетСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет,
	|	ДетальныеДанные.КПС,
	|	ДетальныеДанные.КФО,
	|	ДетальныеДанные.Валюта,
	|	ДетальныеДанные.Контрагент,
	|	АвансовыйОтчет.Организация,
	|	АвансовыйОтчет.ИФО,
	|	АвансовыйОтчет.Подразделение,
	|	АвансовыйОтчет.ОснованиеПринятияОбязательства,
	|	СчетКЭК.КЭК,
	|	АвансовыйОтчет.Подразделение
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) - СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) + СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) - СУММА(ДетальныеДанные.ВозвращенОстаток) + СУММА(ДетальныеДанные.ВыданПерерасход) > 0
	|ИТОГИ
	|	МАКСИМУМ(Контрагент),
	|	СУММА(Сумма),
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(ИФО),
	|	МАКСИМУМ(Подразделение),
	|	МАКСИМУМ(ПодразделениеКор),
	|	МАКСИМУМ(Договор)
	|ПО
	|	ВалютаДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументОснование,"Организация,ИФО,Подразделение,ВалютаДокумента");
	
	Объект.ДокументОснование = ДокументОснование;
	
	Объект.СуммаДокумента = Выборка.Сумма;
	
	Объект.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	Объект.Счет = БухгалтерскийУчет.СчетПоКоду("201.34", ТекущаяДатаСеанса());
	Объект.ПодразделениеКор = ДокументОснование.Подразделение;
	Объект.Контрагент = Контрагент;
	Объект.Договор = ДокументОснование.ОснованиеПринятияОбязательства;
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.ПринятоОт);
	
	РасшифровкаПлатежа = Выборка.Выбрать();
	Пока РасшифровкаПлатежа.Следующий() Цикл
		
		НовСтрока = Объект.РасшифровкаПлатежа.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовСтрока, РасшифровкаПлатежа);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьДокументНаОснованииОтчетаОРасходахПодотчетногоЛица(Знач ДокументОснование, Объект)
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Сотрудник.Контрагент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00"));
	Запрос.УстановитьПараметр("Организация", ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Субконто1", Контрагент);
	Запрос.УстановитьПараметр("ОтчетОРасходахПодотчетногоЛица", ДокументОснование);
	Запрос.УстановитьПараметр("ДокументыАвансов", ДокументОснование.Получено.ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СписокСчетов("105.00", ДокументОснование.Дата));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.ПриходныйДокумент КАК ДокументРасхода
	|ПОМЕСТИТЬ ДокументыРасходов
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|	И ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.ПоДокументу
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета) КАК Валюта,
	|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Получено,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В
	|				(ВЫБРАТЬ
	|					Т.ДокументРасхода
	|				ИЗ
	|					ДокументыРасходов КАК Т)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Израсходовано,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В
	|					(ВЫБРАТЬ
	|						Т.ДокументРасхода
	|					ИЗ
	|						ДокументыРасходов КАК Т)
	|				И ЖурналПроводокЕПСБУОбороты.КорСчет В (&Счет105)
	|			ТОГДА ЖурналПроводокЕПСБУОбороты.КЭККор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ КАК КЭКРасходов
	|ПОМЕСТИТЬ ДетальныеДанные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Счет В (&Счет208),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОбороты.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В
	|				(ВЫБРАТЬ
	|					Т.ДокументРасхода
	|				ИЗ
	|					ДокументыРасходов КАК Т))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(СоответствияАналитическихСчетовКЭК.КЭК) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ДетальныеДанные.Счет = СоответствияАналитическихСчетовКЭК.Счет
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоответствияАналитическихСчетовКЭК.КЭК) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(ДетальныеДанные.КЭКРасходов) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК2
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|ГДЕ
	|	ДетальныеДанные.КЭКРасходов <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДетальныеДанные.КЭКРасходов) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДетальныеДанные.Счет КАК КорСчет,
	|	ДетальныеДанные.КПС КАК КПС,
	|	ДетальныеДанные.КФО КАК КФО,
	|	ДетальныеДанные.Валюта КАК ВалютаДокумента,
	|	ДетальныеДанные.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) > 0
	|			ТОГДА СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма,
	|	ОтчетОРасходахПодотчетногоЛица.Организация КАК Организация,
	|	ОтчетОРасходахПодотчетногоЛица.ИФО КАК ИФО,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение КАК Подразделение,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение КАК ПодразделениеКор,
	|	ОтчетОРасходахПодотчетногоЛица.ОснованиеПринятияОбязательства КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ СчетКЭК2.КЭК ЕСТЬ NULL
	|			ТОГДА СчетКЭК2.КЭК
	|		КОГДА НЕ СчетКЭК.КЭК ЕСТЬ NULL
	|			ТОГДА СчетКЭК.КЭК
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ КАК КЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК КАК СчетКЭК
	|		ПО ДетальныеДанные.Счет = СчетКЭК.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК2 КАК СчетКЭК2
	|		ПО ДетальныеДанные.Счет = СчетКЭК2.Счет,
	|	Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет,
	|	ДетальныеДанные.КПС,
	|	ДетальныеДанные.КФО,
	|	ДетальныеДанные.Валюта,
	|	ДетальныеДанные.Контрагент,
	|	ОтчетОРасходахПодотчетногоЛица.Организация,
	|	ОтчетОРасходахПодотчетногоЛица.ИФО,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение,
	|	ОтчетОРасходахПодотчетногоЛица.ОснованиеПринятияОбязательства,
	|	СчетКЭК2.КЭК,
	|	СчетКЭК.КЭК,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) > 0
	|ИТОГИ
	|	МАКСИМУМ(Контрагент),
	|	СУММА(Сумма),
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(ИФО),
	|	МАКСИМУМ(Подразделение),
	|	МАКСИМУМ(ПодразделениеКор),
	|	МАКСИМУМ(Договор)
	|ПО
	|	ВалютаДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Объект, Выборка);
	
	Объект.ДокументОснование = ДокументОснование;
	
	Объект.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	Объект.Счет = БухгалтерскийУчет.СчетПоКоду("201.34", ТекущаяДатаСеанса());
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.ПринятоОт);
	
	РасшифровкаПлатежа = Выборка.Выбрать();
	Пока РасшифровкаПлатежа.Следующий() Цикл
		
		НовСтрока = Объект.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, РасшифровкаПлатежа);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
	
КонецПроцедуры

Функция ЗаполнитьДокументНаОснованииОтчетаПоКассовойСмене(Знач ДокументОснование, Объект)
	
	СчетУчетаПродажЗаНаличные = РозничныеПродажиБГУ.ЕдинственныйСчетУчетаПродажЗаНаличные(ДокументОснование);
	
	Если СчетУчетаПродажЗаНаличные.КоличествоСчетовУчета = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Введены приходные кассовые ордеры на всю сумму наличных денежных средств!'");
		Сообщение.Сообщить();
		
		Возврат Ложь;
	ИначеЕсли СчетУчетаПродажЗаНаличные.КоличествоСчетовУчета > 1 Тогда	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Для ввода новых приходных ордеров рекомендуется использовать помощник ввода новых ПКО по кнопке ""Создать приходный кассовый ордер"" на закладке ""Расчет наличными""!'");
		Сообщение.Сообщить();
		
		Возврат Ложь;
	КонецЕсли;	
	
	Документы.ОтчетПоКассовойСмене.ВводНаОсновании_ЗаполнитьДокумент(Объект, ДокументОснование, СчетУчетаПродажЗаНаличные);
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьДокументНаОснованииАктаОбОказанииУслуг(Знач ДокументОснование, Объект)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Организация КАК Организация,
	               |	АктОбОказанииУслуг.ИФО КАК ИФО,
	               |	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	               |	АктОбОказанииУслуг.Договор КАК Договор,
	               |	АктОбОказанииУслуг.Подразделение КАК Подразделение,
	               |	АктОбОказанииУслуг.СуммаДокумента КАК СуммаДокумента,
	               |	АктОбОказанииУслуг.Ссылка КАК ДокументОснование,
	               |	АктОбОказанииУслуг.УслугиОказанные.(
	               |		СтавкаНДС КАК СтавкаНДС,
	               |		СУММА(СуммаНДС) КАК СуммаНДС
	               |	) КАК УслугиОказанные,
	               |	АктОбОказанииУслуг.Контрагент.ВидКонтрагента КАК ВидКонтрагента,
	               |	АктОбОказанииУслуг.Контрагент.Наименование КАК ФИО
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	АктОбОказанииУслуг.УслугиОказанные.(СтавкаНДС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
		
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	Если ЗначениеЗаполнено(Основание.Контрагент) И Основание.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда 
		Объект.ПринятоОт = Основание.ФИО;	
	КонецЕсли;
	Если ЗначениеЗаполнено(Основание.Договор) Тогда 
		Объект.Основание = ПредставлениеДоговора(Объект.Договор);
	КонецЕсли;

	Объект.Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
	
	Расшифровка = Основание.УслугиОказанные.Выгрузить();
	Если Расшифровка.Количество() = 1 Тогда 
		Объект.СтавкаНДС 	= Расшифровка[0].СтавкаНДС;
		Объект.СуммаНДС 	= Расшифровка[0].СуммаНДС;
	ИначеЕсли Расшифровка.Количество() > 1 Тогда 
		Объект.СуммаНДС 	= Расшифровка.Итог("СуммаНДС");
	КонецЕсли;		
	
	РасшифровкаПлатежа = Объект.РасшифровкаПлатежа.Добавить();
	РасшифровкаПлатежа.Сумма = ДокументОснование.СуммаДокумента;
	
	ДокументыЧекаККМ = Объект.ДокументыЧекаККМ.Добавить();
	ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
	ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
КонецФункции	

Функция ЗаполнитьДокументНаОснованииНакладнойТорг12(Знач ДокументОснование, Объект)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	НакладнаяНаРеализациюТорг12.Ссылка КАК ДокументОснование,
	               |	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	               |	НакладнаяНаРеализациюТорг12.ИФО КАК ИФО,
	               |	НакладнаяНаРеализациюТорг12.Контрагент КАК Контрагент,
	               |	НакладнаяНаРеализациюТорг12.Договор КАК Договор,
	               |	НакладнаяНаРеализациюТорг12.Подразделение КАК Подразделение,
	               |	НакладнаяНаРеализациюТорг12.КФО КАК КФО,
	               |	НакладнаяНаРеализациюТорг12.Номенклатура.(
	               |		СтавкаНДС КАК СтавкаНДС,
	               |		СУММА(СуммаНДС) КАК СуммаНДС
	               |	) КАК Номенклатура,
	               |	НакладнаяНаРеализациюТорг12.СуммаДокумента КАК СуммаДокумента,
	               |	НакладнаяНаРеализациюТорг12.Контрагент.Наименование КАК ФИО,
	               |	НакладнаяНаРеализациюТорг12.Контрагент.ВидКонтрагента КАК ВидКонтрагента
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НакладнаяНаРеализациюТорг12.Номенклатура.(СтавкаНДС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
		
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	Если ЗначениеЗаполнено(Основание.Контрагент) И Основание.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда 
		Объект.ПринятоОт = Основание.ФИО;	
	КонецЕсли;
	Если ЗначениеЗаполнено(Основание.Договор) Тогда 
		Объект.Основание = ПредставлениеДоговора(Объект.Договор);
	КонецЕсли;

	Объект.Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
	
	Расшифровка = Основание.Номенклатура.Выгрузить();
	Если Расшифровка.Количество() = 1 Тогда 
		Объект.СтавкаНДС 	= Расшифровка[0].СтавкаНДС;
		Объект.СуммаНДС 	= Расшифровка[0].СуммаНДС;
	ИначеЕсли Расшифровка.Количество() > 1 Тогда 
		Объект.СуммаНДС 	= Расшифровка.Итог("СуммаНДС");
	КонецЕсли;	
	
	РасшифровкаПлатежа 			= Объект.РасшифровкаПлатежа.Добавить();
	РасшифровкаПлатежа.Сумма 	= ДокументОснование.СуммаДокумента;
	РасшифровкаПлатежа.КФО      = Основание.КФО;
	
	ДокументыЧекаККМ = Объект.ДокументыЧекаККМ.Добавить();
	ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
	ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
КонецФункции	

Функция ЗаполнитьДокументНаОснованииСчетНаОплату(Знач ДокументОснование, Объект) Экспорт 

	Объект.РасшифровкаПлатежа.Очистить();
	Объект.ДокументыЧекаККМ.Очистить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	                      |	0 КАК СуммаНДС
	                      |ПОМЕСТИТЬ СуммыПлатежа
	                      |ИЗ
	                      |	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
	                      |ГДЕ
	                      |	СчетНаОплатуВозвратнаяТара.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуМатериалы.СтавкаНДС,
	                      |	СчетНаОплатуМатериалы.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	                      |ГДЕ
	                      |	СчетНаОплатуМатериалы.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуОсновныеСредства.СтавкаНДС,
	                      |	СчетНаОплатуОсновныеСредства.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.ОсновныеСредства КАК СчетНаОплатуОсновныеСредства
	                      |ГДЕ
	                      |	СчетНаОплатуОсновныеСредства.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуУслуги.СтавкаНДС,
	                      |	СчетНаОплатуУслуги.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.Услуги КАК СчетНаОплатуУслуги
	                      |ГДЕ
	                      |	СчетНаОплатуУслуги.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СуммыПлатежа.СтавкаНДС КАК СтавкаНДС,
	                      |	СУММА(СуммыПлатежа.СуммаНДС) КАК СуммаНДС
	                      |ИЗ
	                      |	СуммыПлатежа КАК СуммыПлатежа
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	СуммыПлатежа.СтавкаНДС
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СчетНаОплату.Ссылка КАК ДокументОснование,
	                      |	СчетНаОплату.ИФО КАК ИФО,
	                      |	СчетНаОплату.Организация КАК Организация,
	                      |	СчетНаОплату.Подразделение КАК Подразделение,
	                      |	СчетНаОплату.Контрагент КАК Контрагент,
	                      |	СчетНаОплату.КФО КАК КФО,
	                      |	СчетНаОплату.КОСГУ КАК КОСГУ,
	                      |	СчетНаОплату.Договор КАК Договор,
	                      |	СчетНаОплату.СуммаДокумента КАК СуммаДокумента,
	                      |	СчетНаОплату.Контрагент.Наименование КАК ФИО,
	                      |	СчетНаОплату.Контрагент.ВидКонтрагента КАК ВидКонтрагента,
	                      |	СчетНаОплату.КПС КАК КПС
	                      |ИЗ
	                      |	Документ.СчетНаОплату КАК СчетНаОплату
	                      |ГДЕ
	                      |	СчетНаОплату.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаНДС 		= МассивРезультатов[1].Выгрузить();
	ВыборкаШапка 	= МассивРезультатов[2].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, ВыборкаШапка);
		
		Если ЗначениеЗаполнено(ВыборкаШапка.Контрагент) И ВыборкаШапка.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда 
			Объект.ПринятоОт = ВыборкаШапка.ФИО;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаШапка.Договор) Тогда 
			Объект.Основание = ПредставлениеДоговора(Объект.Договор);
		КонецЕсли;
		
		Объект.Счет 	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
		Объект.КорСчет 	= БухгалтерскийУчет.СчетПоКоду("205.31");
		
		Если ВыборкаНДС.Количество() = 1 Тогда 
			Объект.СтавкаНДС 	= ВыборкаНДС[0].СтавкаНДС;
			Объект.СуммаНДС 	= ВыборкаНДС[0].СуммаНДС;
		ИначеЕсли ВыборкаНДС.Количество() > 1 Тогда 
			Объект.СуммаНДС 	= ВыборкаНДС.Итог("СуммаНДС");
		КонецЕсли;	
		
		РасшифровкаПлатежа 			= Объект.РасшифровкаПлатежа.Добавить();
		РасшифровкаПлатежа.Сумма 	= ДокументОснование.СуммаДокумента;
		РасшифровкаПлатежа.КФО      = ВыборкаШапка.КФО;
		РасшифровкаПлатежа.КПС      = ВыборкаШапка.КПС;
		РасшифровкаПлатежа.КЭК	    = ВыборкаШапка.КОСГУ;
		
		ДокументыЧекаККМ 							= Объект.ДокументыЧекаККМ.Добавить();
		ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
		ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеДоговора(Договор)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
	Возврат "" + РеквизитыДоговора.ВидОбязательства
		+ " от " + Формат(РеквизитыДоговора.ДатаДоговора, "ДФ=dd.MM.yyyy") + " № " + РеквизитыДоговора.НомерДоговора;
	
КонецФункции

// Получает данные контрагента и заполняет по этим данных параметр ПринятоОт
//
Процедура ЗаполнитьДанныеКонтрагента(Контрагент, ПринятоОт)
	
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ПолучитьОтКого", Контрагент);
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	Если ЗначениеЗаполнено(ДанныеКонтрагента.ПолучитьОтКого) Тогда
		ПринятоОт = ДанныеКонтрагента.ПолучитьОтКого;
	ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
		ПринятоОт = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
	Иначе
		ПринятоОт = ДанныеКонтрагента.НаименованиеПолное;
	КонецЕсли;
	
КонецПроцедуры

