
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитовШапкиПоПлануСчетов("Документы", "ПриходныйКассовыйОрдер", Объект);

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части

	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			
			УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата,
				Объект.ГлБухгалтер, Объект.Кассир);
			
			Если Параметры.Основание <> Неопределено
				И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
				РеквизитыФормы = БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтаФорма);
				Если РеквизитыФормы.Найти("ТиповаяОперация") <> Неопределено 
					И НЕ ЗначениеЗаполнено(ЭтаФорма.ТиповаяОперация) Тогда
					ЭтаФорма.типоваяОперация = Справочники.ТиповыеОперации.ПКО_ДоходыОтРозничныхПродаж;
					ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элементы[БухгалтерскиеОперацииКлиентСервер.ПрефиксЭлементовОперации() + "ТиповаяОперация"].Родитель.Имя);
				КонецЕсли;
			ИначеЕсли Параметры.Основание <> Неопределено
				И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
				Основание = Параметры.Основание;
			ИначеЕсли Параметры.Свойство("ОтчетПоКассовойСмене") Тогда
					Документы.ОтчетПоКассовойСмене.ВводНаОсновании_ЗаполнитьДокумент(Объект, Параметры.ОтчетПоКассовойСмене, Параметры.СчетУчетаПродажЗаНаличные);
					УстановитьВидимостьЭлементовФормы();
					ПодготовитьФормуНаСервере();
			КонецЕсли;
			
			Если Объект.ПоступлениеВыручкиТорговойТочки И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
				Объект.ДокументОснование = "";
			КонецЕсли;
			
			Объект.НомерЧекаККМ = 0;
			Объект.НомерСменыККМ = 0;
			Объект.СтатусЧекаККМ = "";
			Если ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.АктОбОказанииУслуг") И 
				ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") И 
				ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.СчетНаОплату") Тогда  
				Объект.ДокументыЧекаККМ.Очистить();
			КонецЕсли;	
			Объект.ИсправительныйЧекККМ = "";
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
			Объект.ВалютаДокумента = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
			Объект.Курс = 1;
			Объект.Кратность = 1;
		ИначеЕсли Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
			Объект.Курс = КурсКратность.Курс;
			Объект.Кратность = КурсКратность.Кратность;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ПроданнаяВалюта)
			И Объект.ПроданнаяВалюта <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			КурсКратность = ПолучитьКурс(Объект.ПроданнаяВалюта, Объект.Дата);
			Объект.КурсПроданнойВалюты = КурсКратность.Курс;
			Объект.КратностьПроданнойВалюты = КурсКратность.Кратность;
		КонецЕсли;
		
		ПодготовитьФормуНаСервере();
		
		Если Параметры.Основание <> Неопределено И (ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.АктОбОказанииУслуг") ИЛИ ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12"))Тогда 
			ВведенныеДокументыПКО 	= РозничныеПродажиБГУ.НайтиДокументыВведенныеНаОсновании(Параметры.Основание, "ПриходныйКассовыйОрдер");
			ВведенныеДокументыЭО	= РозничныеПродажиБГУ.НайтиДокументыВведенныеНаОсновании(Параметры.Основание, "ЭквайринговаяОперация");
			Если ВведенныеДокументыПКО.Количество() > 0 ИЛИ ВведенныеДокументыЭО.Количество() > 0 Тогда 
				ЕстьДокументОплаты = Истина;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементовВалюта();
	
	УчетРасчетов.УстановитьУсловноеОформлениеТаблицыРасшифровкаПлатежа(УсловноеОформление);
	
	УстановитьДанныеДляПечатиЧековККМ();
	ПрочитатьДополнительныеДанныеЧековККМ();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	РасчетЗачетаАвансаПостоплаты();
	
	Если Объект.ПоступлениеВыручкиТорговойТочки Тогда
		ПоказатьНаименованиеТорговойТочки();
	КонецЕсли;
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства

	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Основание)
		И ТипЗнч(Основание) = Тип("ДокументСсылка.АвансовыйОтчет")
		И Объект.СуммаДокумента = 0 Тогда
		
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Остаток задолженности по документу ""%1"" равен 0. Укажите сумму документа вручную'"),
				Основание);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(Текст, , "Объект.СуммаДокумента",);
				
	КонецЕсли;
		
	Если ЕстьДокументОплаты Тогда 
		ТекстСообщения = НСтр("ru='Для документа " + Объект.ДокументОснование + " уже введен документ оплаты!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	
	РассчитатьКурсовуюРазницу(ЭтотОбъект);
	
	БухгалтерскиеОперацииКлиент.ПриОткрытии(ЭтотОбъект);
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Оповестить("РегистрНакопленияНаличныеДенежныеСредстваИзменение");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Оповестить("ПКОДляОтчетаПоКассовойСменеИзменение");
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ИсходныйРежимЗаписи") Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ИсходныйРежимЗаписи", ПараметрыЗаписи.ИсходныйРежимЗаписи);
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	
	РасчетЗачетаАвансаПостоплаты();
	УстановитьВидимостьЭлементовФормы();
	
	ДействияСКонтактнымиДаннымиДляЧекаККМ();
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, ТекущийОбъект);
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборДокументаОснованияЧекаККМ.Форма.Форма" Тогда
		ОбработкаДобавленияДокументовОснованийДляЧекаНаСервере(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ПодборПлатежейПоГрафику" Тогда
		ОбработатьПодборПоГрафикуПлатежейНаСервере(ВыбранноеЗначение);
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если (ИмяСобытия = "ФискальныеОперацииБГУИзменение") Тогда
		УстановитьВидимостьЭлементовФормы();
		НомерКассовогоЧека  = НомерЧекаДляДокумента();
		ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	КонецЕсли;

	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
		Если Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			
			ОбновитьКурсВалюты();
			БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(Истина, Ложь);
			
		КонецЕсли;
		
		РассчитатьКурсовуюРазницу(ЭтотОбъект);
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
		
		УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата,
			Объект.ГлБухгалтер, Объект.Кассир);
		
		ОбновитьКурсВалютыЛицевогоСчета(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	УстановитьДоступностьДоговора();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	
	УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата,
		Объект.ГлБухгалтер, Объект.Кассир);
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата,
			Объект.ГлБухгалтер, Объект.Кассир);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ОткрытьФорму("Справочник.ОснованияКассовыхОрдеров.ФормаВыбора",,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Основание = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	
	УстановитьДоступностьДоговора();
	ЗаполнениеДанныхДляЧекаККМ();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	// Заполнение поля ПринятоОт.
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ПолучитьОтКого", Объект.Контрагент); 
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	Если ЗначениеЗаполнено(ДанныеКонтрагента.ПолучитьОтКого) Тогда
		Объект.ПринятоОт = ДанныеКонтрагента.ПолучитьОтКого;
	ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
		Объект.ПринятоОт = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
	Иначе
		Объект.ПринятоОт = ДанныеКонтрагента.НаименованиеПолное;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор) И НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		Объект.Основание = ПредставлениеДоговора(Объект.Договор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеВыручкиТорговойТочкиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоКассовойСменеПриИзменении(Элемент)
	
	ПерезаполнитьПоКассовойСменеНаСервере();
	УстановитьДоступностьДоговора();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	ПересчитатьНДС();
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
	ПересчитатьНДС();
	РасчетЗачетаАвансаПостоплаты();
	РассчитатьКурсовуюРазницу(ЭтотОбъект);
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
КонецПроцедуры

&НаКлиенте
Процедура ВалютаДокументаПриИзменении(Элемент)
	
	ОбновитьКурсВалюты();
	УстановитьВидимостьЭлементовВалюта();
	РассчитатьКурсовуюРазницу(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КорСчетПриИзменении(Элемент)
	
	КорСчетПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура КорСчетПриИзмененииНаСервере()
	
	Для Каждого СтрокаДокумента Из Объект.РасшифровкаПлатежа Цикл
		
		Если БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "304.01") Тогда
			СтрокаДокумента.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение");
		КонецЕсли;
		
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(СтрокаДокумента,
			СтрокаДокумента.КЭК, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
		
	КонецЦикла;
	
	УстановитьВидимостьЭлементовФормы();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	УстановитьВидимостьЭлементовВалюта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОплаченоПриИзменении(Элемент)
	
	Если Объект.Оплачено Тогда
		Объект.Аннулирован = Ложь;
		Объект.ДатаАннулирования = "";
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура АннулированПриИзменении(Элемент)
	
	Если Объект.Аннулирован Тогда
		Объект.Оплачено = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();

КонецПроцедуры

