&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
	УстановитьВидимостьЭлементовФормы();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамЗадолженностиНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоОстаткамЗадолженности();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьОбъектВФорме(РежимЗаписи)

	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписи);
	ПараметрыЗаписи.Вставить("ИсходныйРежимЗаписи", РежимЗаписи);
	Возврат ЭтаФорма.Записать(ПараметрыЗаписи);

КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.Подразделение.Доступность = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПодразделениеКор.Доступность = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ГлБухгалтер.Доступность = ЗначениеЗаполнено(Объект.Организация);
	Элементы.Кассир.Доступность = ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура ПересчитатьНДС()

	Объект.СуммаНДС = Объект.СуммаДокумента
		/ (100 + УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Объект.СтавкаНДС))
		* УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Объект.СтавкаНДС);	

КонецПроцедуры // ПересчитатьНДС()

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("Организация");
	МассивЭлементов.Добавить("Подразделение");
	МассивЭлементов.Добавить("ИФО");
	МассивЭлементов.Добавить("Номер");
	МассивЭлементов.Добавить("Дата");
	МассивЭлементов.Добавить("ВалютаДокумента");
	МассивЭлементов.Добавить("Счет");
	МассивЭлементов.Добавить("ПодразделениеКор");
	МассивЭлементов.Добавить("КорСчет");
	МассивЭлементов.Добавить("КодАналитическогоУчета");
	МассивЭлементов.Добавить("СуммаДокумента");
	МассивЭлементов.Добавить("СтавкаНДС");
	МассивЭлементов.Добавить("СуммаНДС");
	МассивЭлементов.Добавить("КодЦелевогоНазначения");
	МассивЭлементов.Добавить("Контрагент");
	МассивЭлементов.Добавить("ПринятоОт");
	МассивЭлементов.Добавить("Договор");
	МассивЭлементов.Добавить("Основание");
	МассивЭлементов.Добавить("Приложение");
	МассивЭлементов.Добавить("РасшифровкаПлатежа");
	МассивЭлементов.Добавить("ГлБухгалтер");
	МассивЭлементов.Добавить("Кассир");
	МассивЭлементов.Добавить("Комментарий");
	
	МассивЭлементовДоступность = Новый Массив;
	МассивЭлементовДоступность.Добавить("ЗаполнитьСумму");
	МассивЭлементовДоступность.Добавить("КомандаЗаполнитьОснование");
	МассивЭлементовДоступность.Добавить("РасшифровкаПлатежаПодборПоГрафикуПлатежей");
	МассивЭлементовДоступность.Добавить("РасшифровкаПлатежаКомандаЗаполнитьПоОстаткамЗадолженности");
	
	МассивЭлементовПроведение = Новый Массив;
	МассивЭлементовПроведение.Добавить("Оплачено");
	МассивЭлементовПроведение.Добавить("Аннулирован");
	МассивЭлементовПроведение.Добавить("ДатаАннулирования");
	
	ТекущиеПрава 					= КассаОрганизации.ПраваНаТекущийКассовыйДокумент(Объект.Ссылка);
	МассивЭлементовТолькоПросмотр	= ТекущиеПрава.ЭлементыТолькоПросмотр;
	РазрешитьПроведение				= ТекущиеПрава.РазрешитьПроведение;
	РазрешитьОтменуПроведения		= ТекущиеПрава.РазрешитьОтменуПроведения;
	РазрешитьЗапись					= ТекущиеПрава.РазрешитьЗапись;
	РазрешитьФормированиеПроводок	= ТекущиеПрава.РазрешитьФормированиеПроводок;


	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр", МассивЭлементовТолькоПросмотр);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементовПроведение, "ТолькоПросмотр", МассивЭлементовТолькоПросмотр ИЛИ НЕ РазрешитьПроведение);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементовДоступность, "Доступность", НЕ МассивЭлементовТолькоПросмотр);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПровестиИЗакрыть", 			"Видимость", РазрешитьПроведение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаПровести", 				"Видимость", РазрешитьПроведение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаОтменаПроведения",		"Видимость", РазрешитьОтменуПроведения);
	
	Если РазрешитьПроведение Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПровестиИЗакрыть", 	"КнопкаПоУмолчанию", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаПровестиИЗакрыть", 	"Отображение", ОтображениеКнопки.Авто);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаЗаписать", 		"Отображение", ОтображениеКнопки.Картинка);
	ИначеЕсли РазрешитьЗапись Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаЗаписать", 		"КнопкаПоУмолчанию", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаЗаписать", 		"Отображение", ОтображениеКнопки.КартинкаИТекст);
		Если РазрешитьФормированиеПроводок И Объект.Оплачено Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаЗаписать", 	"Заголовок", "Записать и провести");
	    КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаЗаписать",		"Видимость", Ложь);	
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	ВидимостьКнопкиПечатьЧекаККМ = Истина;
	ЕстьЗаключительныйЧекИсправительный = Ложь;
	
	Если СтатусЧекаККМПробит ИЛИ Объект.ПоступлениеВыручкиТорговойТочки Тогда
		ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВидимостьКнопкиПечатьЧекаККМ = Истина;
			ЕстьЗаключительныйЧекИсправительный = Истина;
		Иначе
			ВидимостьКнопкиПечатьЧекаККМ = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 		"Видимость", ВидимостьКнопкиПечатьЧекаККМ);
	
	ВидимостьКомандККТ = ПодключаемоеОборудованиеБГУ.ВидимостьКомандККТПоТипуКассыККМ(Объект.КассаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаEmail", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаSMS", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтказКлиентаОтСохраненияТелефонаEmail", 		"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДанныеSMSИлиEmail", 									"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОчиститьEmailИSMS",								"Видимость", ВидимостьКомандККТ);
	
	Если НЕ МассивЭлементовТолькоПросмотр Тогда
		Если Объект.Оплачено Тогда
			Элементы.Аннулирован.ТолькоПросмотр = Истина;
			Элементы.ДатаАннулирования.ТолькоПросмотр = Истина;
		ИначеЕсли Объект.Аннулирован Тогда
			Элементы.Оплачено.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

	ВидимостьВыручкаРозничнойТочки = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
			ВидимостьВыручкаРозничнойТочки = Истина;
		КонецЕсли;
	ИначеЕсли Объект.ПоступлениеВыручкиТорговойТочки Тогда
		ВидимостьВыручкаРозничнойТочки = Истина;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "205.00,209.00,401.10") Тогда
		ВидимостьВыручкаРозничнойТочки = Истина;
	КонецЕсли;
	
	ВидимостьДокументОснование = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ВидимостьДокументОснование = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаПоступлениеВыручкиОтТорговойТочки", "Видимость", ВидимостьВыручкаРозничнойТочки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаОтчетПоКассовойСмене", "Доступность", Объект.ПоступлениеВыручкиТорговойТочки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДанныеЧекаККМ", "Видимость", НЕ Объект.ПоступлениеВыручкиТорговойТочки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДокументыЧекаККМСуммаПредоплаты", "Видимость", Объект.ЭтоПостоплата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаЗачетаАванса", "Видимость", Объект.ЭтоПостоплата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаПостоплаты", "Видимость", Объект.ЭтоПостоплата);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДокументОснование", "Видимость", ВидимостьДокументОснование);
	
	ИспользуетсяНастройкаПогашенияЗадолженности = УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет);
	НастройкаПогашенияЗадолженности = Новый Массив;
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСчетРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСпособПогашенияЗадолженности");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		НастройкаПогашенияЗадолженности, "Видимость", ИспользуетсяНастройкаПогашенияЗадолженности И НЕ Объект.ПоступлениеВыручкиТорговойТочки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаКомандаЗаполнитьПоОстаткамЗадолженности", "Видимость",
		ИспользуетсяНастройкаПогашенияЗадолженности И НЕ Объект.ПоступлениеВыручкиТорговойТочки ИЛИ БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "207.00"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеДоговора(Договор)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
	Возврат "" + РеквизитыДоговора.ВидОбязательства
		+ " от " + Формат(РеквизитыДоговора.ДатаДоговора, "ДФ=dd.MM.yyyy") + " № " + РеквизитыДоговора.НомерДоговора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Организация, Подразделение, Дата, ГлБухгалтер, Кассир)
	
	ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	Кассир = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Кассир", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

