&НаКлиенте
Процедура РасшифровкаПлатежаДопСубконтоРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДопСубконтоРасчетовВид) Тогда
		ПараметрыВыбораДопСубконто = Новый Структура;
		ПараметрыВыбораДопСубконто.Вставить("Организация",   Объект.Организация);
		ПараметрыВыбораДопСубконто.Вставить("Счет",          ТекущиеДанные.СчетРасчетов);
		ПараметрыВыбораДопСубконто.Вставить("НомерСубконто", ТекущиеДанные.ДопСубконтоРасчетовНомер);
		ПараметрыВыбораДопСубконто.Вставить("Субконто" + ТекущиеДанные.ДопСубконтоРасчетовНомер, ТекущиеДанные.ДопСубконтоРасчетов);
		БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораДопСубконто);
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Отбор = Новый Структура("ВидРасчетов,КФО,КодЦели,КодМероприятия,ДопКлассификация");
	ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
	Отбор.Вставить("ИФО", Объект.ИФО);
	Отбор.Вставить("Контрагент", Объект.Контрагент);
	Отбор.Вставить("Договор", Объект.Договор);
	Отбор.Вставить("Валюта", Объект.ВалютаДокумента);
	Отбор.Вставить("КПС", ТекущиеДанные.КПС);
	Отбор.Вставить("КЭК", ТекущиеДанные.КЭК);
	Отбор.Вставить("ЭтоПоступление", Истина);
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Объект.Организация, Объект.Договор, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаЗаполнитьДобавленныеКолонки()
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		
		Для Каждого СтрокаДокумента Из Объект.РасшифровкаПлатежа Цикл
			УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(СтрокаДокумента,
				СтрокаДокумента.КЭК, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормы_ДокументыЧекаККМ

&НаКлиенте
Процедура ДокументыЧекаККМДокументОснованиеЧекаККМПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДокументыЧекаККМ.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОснованиеЧекаККМ) Тогда
		Если ТипЗнч(ТекущиеДанные.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная");
		Иначе
			Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
				ТекущиеДанные.ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
			Иначе			
				ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
			КонецЕсли;	
		КонецЕсли;	
		РасчетЗачетаАвансаПостоплаты();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЧекаККМСуммаПредоплатыПриИзменении(Элемент)
