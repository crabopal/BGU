КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКурсВалютыЛицевогоСчета(Форма)
	
	КурсКратность = ПолучитьКурс(Форма.Объект.ПроданнаяВалюта, Форма.Объект.Дата);
	Форма.Объект.КурсПроданнойВалюты = КурсКратность.Курс;
	Форма.Объект.КратностьПроданнойВалюты = КурсКратность.Кратность;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовВалюта()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "КурсКратность", "Видимость", ЗначениеЗаполнено(Объект.ВалютаДокумента) И Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВалютаЛС", "Видимость", БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "201.20"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВалютаЛС", "ПодсказкаВвода", Объект.ВалютаДокумента);
	
	ВидимостьГруппыКонвертация = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ВалютаДокумента)
		И ЗначениеЗаполнено(Объект.ПроданнаяВалюта)
		И НЕ Объект.ВалютаДокумента = Объект.ПроданнаяВалюта
		И БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "201.20") Тогда
		
		ВидимостьГруппыКонвертация = Истина;
		
		Если Объект.ВалютаДокумента = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если Объект.КратностьПроданнойВалюты = 1 Тогда
				ВалютнаяПара = "";
			Иначе
				ВалютнаяПара = "" + Объект.ВалютаДокумента + " за " + Объект.КратностьПроданнойВалюты + " " + Объект.ПроданнаяВалюта;
			КонецЕсли;
		ИначеЕсли Объект.ПроданнаяВалюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если Объект.Кратность = 1 Тогда
				ВалютнаяПара = "";
			Иначе
				ВалютнаяПара = "" + Объект.ПроданнаяВалюта + " за " + Объект.Кратность + " " + Объект.ВалютаДокумента;
			КонецЕсли;
		Иначе
			ВалютнаяПара = "(" + Объект.ПроданнаяВалюта + " / " + Объект.ВалютаДокумента + ")";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Элементы.КонвертацияВалюты.Видимость = ВидимостьГруппыКонвертация Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонвертацияВалюты", "Видимость", ВидимостьГруппыКонвертация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьКурсовуюРазницу(Форма)
	
	Если Форма.Объект.СуммаПроданнойВалюты = 0 ИЛИ Форма.Объект.СуммаДокумента = 0 Тогда
		Форма.ОбменныйКурс = 0;
	ИначеЕсли Форма.Объект.ПроданнаяВалюта = Форма.КэшПараметров.ВалютаРегламентированногоУчета Тогда
		Форма.ОбменныйКурс = Форма.Объект.СуммаПроданнойВалюты * Форма.Объект.Кратность / Форма.Объект.СуммаДокумента;
	Иначе
		Форма.ОбменныйКурс = Форма.Объект.СуммаДокумента / Форма.Объект.СуммаПроданнойВалюты;
	КонецЕсли;
	
	КурсоваяРазница = Форма.Объект.СуммаДокумента * Форма.Объект.Курс / ?(Форма.Объект.Кратность = 0, 1, Форма.Объект.Кратность)
					- Форма.Объект.СуммаПроданнойВалюты * Форма.Объект.КурсПроданнойВалюты / ?(Форма.Объект.КратностьПроданнойВалюты = 0, 1, Форма.Объект.КратностьПроданнойВалюты);
	
	ЗаголовокКурсовойРазницы = ?(КурсоваяРазница < 0,
								НСтр("ru = 'Отрицательная курсовая разница:'"),
								НСтр("ru = 'Положительная курсовая разница:'"));
	Форма.КурсоваяРазница = ?(КурсоваяРазница < 0, - КурсоваяРазница, КурсоваяРазница);
	Форма.КурсоваяРазницаЗаголовок = ЗаголовокКурсовойРазницы;
	
КонецПроцедуры

