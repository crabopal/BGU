КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаПриИзменении(Элемент)
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
		
		СуммаБезСтроки = Объект.РасшифровкаПлатежа.Итог("Сумма") - ТекущиеДанные.Сумма;
		Остаток = Объект.СуммаДокумента - СуммаБезСтроки;
		ТекущиеДанные.Сумма = ?(ТекущиеДанные.Сумма = 0, Остаток, Мин(ТекущиеДанные.Сумма, Остаток));
		Если БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.КорСчет).Код = "304.01" Тогда
			ТекущиеДанные.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение");	
		КонецЕсли;
		
		Если НЕ Копирование Тогда
			ТекущиеДанные.СпособПогашенияЗадолженности =
				ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК); 	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.КорСчет);
	ОграниченияКПС = Новый Массив;
	
	Если СвойстваСчета.Код = "210.03" ИЛИ СвойстваСчета.Код = "304.01" Тогда 
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));
	ИначеЕсли СвойстваСчета.Родитель = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("201.20") Тогда
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
	КонецЕсли;
	
	Если ОграниченияКПС.Количество()>0 Тогда
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
														СтандартнаяОбработка, 
														ТекущиеДанные.КПС, 
														Объект.Организация,
														Объект.ИФО,
														ТекущиеДанные.КФО,
														ОграниченияКПС,
														Объект.Дата);
	Иначе
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
														СтандартнаяОбработка, 
														ТекущиеДанные.КПС, 
														Объект.Организация,
														Объект.ИФО,
														ТекущиеДанные.КФО,
														Объект.КорСчет,
														Объект.Дата);
	КонецЕсли;
													
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКФОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.КорСчет).Код = "304.01" Тогда
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение"));
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКЭКПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.КорСчет) Тогда
		РасшифровкаПлатежаКЭКПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаКЭКПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(Элементы.РасшифровкаПлатежа.ТекущаяСтрока);
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
			ДанныеСтроки.КЭК, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовПриИзменении(Элемент)
	
	РасшифровкаПлатежаСчетРасчетовПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаПлатежаСчетРасчетовПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(Элементы.РасшифровкаПлатежа.ТекущаяСтрока);
	
	ДанныеСтроки.ДопСубконтоРасчетов = Неопределено;
	ДанныеСтроки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ДанныеСтроки,
		ДанныеСтроки.КЭК, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КЭК) И ЗначениеЗаполнено(ДанныеСтроки.СчетРасчетов) Тогда
		ДанныеСтроки.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(ДанныеСтроки.СчетРасчетов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСчетРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
