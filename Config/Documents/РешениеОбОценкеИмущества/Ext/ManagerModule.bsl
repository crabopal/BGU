// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Сумма");
	ИменаРеквизитов.Добавить("СуммаАмортизации");
	ИменаРеквизитов.Добавить("СуммаОбесценения");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Формирует запрос для получения данных печати и результат запроса добавляет в массив ДанныеВидовДокументов
//
// Параметры:
//  ДанныеВидовДокументов - Массив - в этот массив процедура добавит результат запроса
//  МассивОбъектов - Массив - массив документов-ссылок одного вида
Процедура ДобавитьДанныеДляПечати0510442(ДанныеВидовДокументов, МассивОбъектов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РешениеОбОценкеИмущества.Ссылка КАК Ссылка,
	|	РешениеОбОценкеИмущества.Номер КАК Номер,
	|	РешениеОбОценкеИмущества.Дата КАК ДатаАкта,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА РешениеОбОценкеИмущества.Организация
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ВЫБОР
	|					КОГДА РешениеОбОценкеИмущества.Организация.НаименованиеПолное = """"
	|						ТОГДА РешениеОбОценкеИмущества.Организация.Наименование
	|					ИНАЧЕ РешениеОбОценкеИмущества.Организация.НаименованиеПолное
	|				КОНЕЦ
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА РешениеОбОценкеИмущества.Организация.КодПоРПБС
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ РешениеОбОценкеИмущества.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	РешениеОбОценкеИмущества.Подразделение КАК СтруктурноеПодразделение,
	|	ВЫБОР
	|		КОГДА РешениеОбОценкеИмущества.Подразделение.НаименованиеПолное = """"
	|			ТОГДА РешениеОбОценкеИмущества.Подразделение.Наименование
	|		ИНАЧЕ РешениеОбОценкеИмущества.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	РешениеОбОценкеИмущества.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	РешениеОбОценкеИмущества.Организация.КодПоППП.Код КАК ГлаваБК,
	|	РешениеОбОценкеИмущества.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	РешениеОбОценкеИмущества.Организация.Бюджет.Код КАК ОКТМО,
	|	РешениеОбОценкеИмущества.Получатель КАК Получатель,
	|	РешениеОбОценкеИмущества.Получатель.Наименование КАК НаименованиеПолучателя,
	|	РешениеОбОценкеИмущества.ВидПервичногоДокумента КАК ВидДокументаОСогласовании,
	|	РешениеОбОценкеИмущества.ДатаПервичногоДокумента КАК ДатаДокументаОСогласовании,
	|	РешениеОбОценкеИмущества.НомерПервичногоДокумента КАК НомерДокументаОСогласовании,
	|	РешениеОбОценкеИмущества.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	РешениеОбОценкеИмущества.Комиссия.НомерПриказа КАК НомерПриказа,
	|	РешениеОбОценкеИмущества.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	РешениеОбОценкеИмущества.Ответственный КАК Ответственный,
	|	РешениеОбОценкеИмущества.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.РешениеОбОценкеИмущества КАК РешениеОбОценкеИмущества
	|ГДЕ
	|	РешениеОбОценкеИмущества.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РешениеОбОценкеИмущества.Дата,
	|	РешениеОбОценкеИмущества.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ОсновныеСредства.МетодРыночныхЦен КАК МетодРыночныхЦен,
	|	ОсновныеСредства.ОпределенаОценщиком КАК ОпределенаОценщиком,
	|	ОсновныеСредства.СправедливаяСтоимость КАК СправедливаяСтоимость,
	|	ОсновныеСредства.ОценкаНомер КАК ОценкаНомер,
	|	ОсновныеСредства.ОценкаДата КАК ОценкаДата
	|ПОМЕСТИТЬ ОсновныеСредства
	|ИЗ
	|	Документ.РешениеОбОценкеИмущества.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
