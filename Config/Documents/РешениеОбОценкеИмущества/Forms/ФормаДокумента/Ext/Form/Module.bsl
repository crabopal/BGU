&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьДопКолонкиПоСтроке(ТекСтрока)
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекСтрока.ОстаточнаяСтоимость = ТекСтрока.Сумма - ТекСтрока.СуммаАмортизации - ТекСтрока.СуммаОбесценения; 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьДопКолонкиВоВсехСтроках(ТабЧасть)
	Для каждого ТекСтрока из ТабЧасть Цикл
		РассчитатьДопКолонкиПоСтроке(ТекСтрока);
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Решение сотрудника.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	// Определение стоимости
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваМетодРыночныхЦен.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОпределенаОценщиком", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваОценкаНомер.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваОценкаДата.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОпределенаОценщиком", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);

	ОбщегоНазначенияБГУ.УстановитьУсловноеОформлениеКомиссии(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элемент)
	
	Для Каждого ЭлементСписка Из Элемент.СписокВыбора Цикл
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элемент.Имя);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, Элемент.ПутьКДанным,
			ВидСравненияКомпоновкиДанных.Равно, ЭлементСписка.Значение);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСписка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

