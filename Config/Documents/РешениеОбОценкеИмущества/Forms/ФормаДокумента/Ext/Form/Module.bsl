Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	//Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
	//	СтруктураРеквизитов.Вставить("ИФО");
	//КонецЕсли;
	//Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
	//	Если Элементы.Подразделение.ОтметкаНезаполненного Тогда
	//		СтруктураРеквизитов.Вставить("Подразделение");
	//	КонецЕсли;
	//КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС,СчетУчета,ЦМО");
	
КонецПроцедуры

