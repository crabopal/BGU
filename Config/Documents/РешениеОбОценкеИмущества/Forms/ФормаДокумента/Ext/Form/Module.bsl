&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧ(Команда)
	Реквизиты = Новый Структура("СправедливаяСтоимость, ОпределенаОценщиком, ОценкаНомер, ОценкаДата");
	
	Реквизиты.Вставить("МетодРыночныхЦен", Новый Структура);
	СписокВыбора = Элементы.ОсновныеСредстваМетодРыночныхЦен.СписокВыбора.Скопировать();
	Реквизиты.МетодРыночныхЦен.Вставить("СписокВыбора", СписокВыбора); 

	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект,
		"РешениеОбОценкеИмущества",
		"ОсновныеСредства",
		"ОсновныеСредства",
		Реквизиты);
КонецПроцедуры

// ГолосованиеКомиссии
&НаКлиенте
Процедура КомандаСохранитьРезультатыГолосования(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Сотрудник", Сотрудник);
	ДопПараметры.Вставить("РезультатыГолосования", РезультатыГолосованияСотрудника(Объект.ОсновныеСредства));
	
	Оповещение = Новый ОписаниеОповещения("ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), Сотрудник);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

