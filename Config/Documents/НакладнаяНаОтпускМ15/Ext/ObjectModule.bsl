#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ЗаполнитьПоПоступлению(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗаполнитьПоСчету(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ПередачаНаХранениеВПереработку") Тогда
			ЗаполнитьПоПередачеНаХранениеВПереработку(ДанныеЗаполнения.ПередачаНаХранениеВПереработку);
		ИначеЕсли ДанныеЗаполнения.Свойство("КорректируемыйДокумент") Тогда
			ЗаполнитьКорректировку(ДанныеЗаполнения.КорректируемыйДокумент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(Материалы);
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(ВозвратнаяТара);
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
	Если ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.Реализация
		Или ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику
		Или ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику
		Или НеПересчитыватьСумму Тогда
		СуммаДокумента = Материалы.Итог("Всего");
	Иначе
		СуммаДокумента = 0;
	КонецЕсли;
	ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, "Материалы",, Отказ);
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Материалы", Истина);
	ПрослеживаемостьБГУ.СписаниеМЗПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	УправлениеМатериальнымиЗапасами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Материалы.СтранаПроисхождения");
	
	ВедетсяУчетПоРеализацииТоваровУслугКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов");
	
	Если ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку
		И ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки Тогда
		
		НепроверяемыеРеквизиты.Добавить("ЦМОПриПередаче");
	
	КонецЕсли;
	Если ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаСторону
		ИЛИ ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку
		ИЛИ ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки Тогда
		НепроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	Если ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратПоставщику
		И ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаРеализацию
		И ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию
		И ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
		НепроверяемыеРеквизиты.Добавить("Договор");
	КонецЕсли;
	
	Если Не ЭтоКорректировка Тогда
		НепроверяемыеРеквизиты.Добавить("ДокументОснование");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Если Не Документы.НакладнаяНаОтпускМ15.ПроверитьЗаполнениеДокументаОснования(ЭтотОбъект)
			Или Не ПроверитьСоставТабличнойЧастиПоДокументуОснованию() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если ВедетсяУчетПоРеализацииТоваровУслугКомитентов Тогда
		ПроверитьЗаполнениеДополнительнойАналитикиКомиссионныхТоваров(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "Материалы", "Материалы", Отказ);		
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "ВозвратнаяТара", "Возвратная тара", Отказ);		
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	Если УправлениеМатериальнымиЗапасами.СчетУчетаРавен105(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасами.СчетУчетаРавен106(ЭтотОбъект) Тогда
		ОбязательноЗаполнитьКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ОбъектКопирования.Дата,
			ОбъектКопирования.Организация,
			ДатаНовогоДокумента,
			Организация);
		
		УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
			ОбязательноЗаполнитьКЭК);
	КонецЕсли;
	
	НеПересчитыватьСумму = Ложь;
	
	СтруктураДействий = УправлениеМатериальнымиЗапасами.ДопустимыеДействияОбработкиТабличнойЧасти();
	СтруктураДействий.ОчиститьДопСубконто = УправлениеМатериальнымиЗапасами.ПараметрыПроверкиЗаполненияДопСубконто(Ложь, Дата, Организация);
	УправлениеМатериальнымиЗапасами.ОбработатьТабличнуюЧасть(Материалы, СтруктураДействий);
	
	Если ЭтоКорректировка Тогда
		ОчиститьРеквизитыКорректировки();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьСоставТабличнойЧастиПоДокументуОснованию()
	Если ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаВозврата.НомерСтроки,
	|	ТаблицаВозврата.Номенклатура,
	|	ТаблицаВозврата.СчетУчета,
	|	ТаблицаВозврата.КПС,
	|	ТаблицаВозврата.КФО
	|ПОМЕСТИТЬ ТаблицаВозврата
	|ИЗ
	|	&ТаблицаВозврата КАК ТаблицаВозврата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВозврата.НомерСтроки,
	|	ТаблицаВозврата.Номенклатура,
	|	ТаблицаВозврата.СчетУчета,
	|	ТаблицаВозврата.КПС,
	|	ТаблицаВозврата.КФО
	|ИЗ
	|	ТаблицаВозврата КАК ТаблицаВозврата
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|		ПО ТаблицаВозврата.Номенклатура = ПоступлениеМЗМатериалы.Номенклатура
	|		И ТаблицаВозврата.СчетУчета = ПоступлениеМЗМатериалы.СчетУчета
	|		И ТаблицаВозврата.КПС = ПоступлениеМЗМатериалы.КПС
	|		И ТаблицаВозврата.КФО = ПоступлениеМЗМатериалы.КФО
	|		И ПоступлениеМЗМатериалы.Ссылка = &Ссылка
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Номенклатура ЕСТЬ NULL";
	ТаблицаМатериалы = Материалы.Выгрузить(, "НомерСтроки, Номенклатура, СчетУчета, КПС");
	ТаблицаМатериалы.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаМатериалы.ЗаполнитьЗначения(КФО, "КФО");
	Запрос.УстановитьПараметр("ТаблицаВозврата", ТаблицаМатериалы);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Отказ = Ложь;
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = СтрШаблон(НСтр("ru = 'В строке %1 выбран материал, которого не было в документе поставки'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", Выборка.НомерСтроки, "Номенклатура"),
			Отказ);
	КонецЦикла;
	Возврат Не Отказ;
	
КонецФункции
 
Процедура ОчиститьРеквизитыКорректировки()

	РеквизитыКорректировки = Новый Структура;
	РеквизитыКорректировки.Вставить("Номенклатура", Новый Массив);
	РеквизитыКорректировки.Номенклатура.Добавить("КоличествоДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("ЦенаДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("СуммаДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("СуммаНДСДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("ВсегоДоКорректировки");

	РеквизитыКорректировки.Вставить("ВозвратнаяТара", Новый Массив);
	РеквизитыКорректировки.ВозвратнаяТара.Добавить("КоличествоДоКорректировки");
	РеквизитыКорректировки.ВозвратнаяТара.Добавить("СуммаДоКорректировки");
	
	УправлениеНФА.ОчиститьРеквизитыКорректировки(ЭтотОбъект, РеквизитыКорректировки);

КонецПроцедуры

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоПоступлению(ДанныеЗаполнения) Экспорт
	
	Материалы.Очистить();
	ВозвратнаяТара.Очистить();
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения,
		"Организация, ИФО, Контрагент, Договор, ВалютаДокумента,"
		+ "СуммаВключаетНДС, ЦМО, Подразделение, СчетУчета, Проведен");
																				
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования, , "Проведен");
	ДокументОснование = ДанныеЗаполнения;
	Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	Счет40160 = БухгалтерскийУчет.СчетПоКоду("401.60", Дата, РеквизитыОснования.Организация);
	СуммаВключаетНДС = РеквизитыОснования.СуммаВключаетНДС;
	Если ЕстьПроводкиПоступленияПоСчету40160(ДокументОснование, РеквизитыОснования.СчетУчета, Счет40160) Тогда
		ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику;
	Иначе
		ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику;
	КонецЕсли;
	
	КФО = Перечисления.КВД.ПустаяСсылка();
	Если ЕстьПроводкиПоступленияПоСчету106(ДанныеЗаполнения, РеквизитыОснования.СчетУчета, КФО) Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.00", Дата, Организация);
		Если Дата >= '2021.01.01' Тогда
			ЗаполнитьПоПоступлению106БезПартий();
		Иначе
			ЗаполнитьПоПоступлению106(ДанныеЗаполнения, РеквизитыОснования);
		КонецЕсли;
	Иначе
		ЗаполнитьПоПоступлению105(ДанныеЗаполнения, РеквизитыОснования);
	КонецЕсли;
	
	//Если КФО не удалось определить по счету учета проверим, что это возрат и попробуем определить по счету расчетов
	Если КФО = Перечисления.КВД.ПустаяСсылка() Тогда
		Если ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику Тогда
			ЗаполнитьКФОПоСчетуРасчетов(ДанныеЗаполнения, ДанныеЗаполнения.СчетРасчетов, КФО);
		КонецЕсли;
	КонецЕсли;
	
	СуммаДокумента = Материалы.Итог("Всего") + ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьПоСчету(ДанныеЗаполнения) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплату.ИФО,
				   |	СчетНаОплату.Подразделение,
	               |	СчетНаОплату.Контрагент,
	               |	СчетНаОплату.Договор,
	               |	СчетНаОплату.ВалютаДокумента,
	               |	СчетНаОплату.СуммаВключаетНДС,
	               |	СчетНаОплату.КПС,
	               |	СчетНаОплату.КФО,
	               |	СчетНаОплату.Организация,
	               |	&Счет105 КАК СчетУчета
	               |ИЗ
	               |	Документ.СчетНаОплату КАК СчетНаОплату
	               |ГДЕ
	               |	СчетНаОплату.Ссылка = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплатуМатериалы.Номенклатура,
	               |	СчетНаОплатуМатериалы.Количество,
	               |	СчетНаОплатуМатериалы.Сумма,
	               |	СчетНаОплатуМатериалы.СтавкаНДС,
	               |	СчетНаОплатуМатериалы.СуммаНДС,
	               |	СчетНаОплатуМатериалы.Всего,
	               |	СчетНаОплатуМатериалы.НомерСтроки КАК НомерСтроки,
	               |	ЕПСБУ.Ссылка КАК СчетУчета
	               |ИЗ
	               |	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
	               |		ПО СчетНаОплатуМатериалы.Номенклатура = СпрНоменклатура.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуМатериалы.Ссылка = &ДокументОснование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплатуВозвратнаяТара.Номенклатура,
	               |	СчетНаОплатуВозвратнаяТара.Количество,
	               |	СчетНаОплатуВозвратнаяТара.Сумма,
	               |	СчетНаОплатуВозвратнаяТара.НомерСтроки КАК НомерСтроки,
	               |	ЕПСБУ.Ссылка КАК СчетУчета
	               |ИЗ
	               |	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
	               |		ПО СчетНаОплатуВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуВозвратнаяТара.Ссылка = &ДокументОснование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация));
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка = Результат[0].Выбрать();
	ВыборкаШапка.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.Реализация;
	ВыборкаМатериалы = Результат[1].Выгрузить();
	Материалы.Загрузить(ВыборкаМатериалы);
	ВыборкаТара = Результат[2].Выгрузить();
	ВозвратнаяТара.Загрузить(ВыборкаТара);
    ДокументОснование = ДанныеЗаполнения;
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(Материалы, ЭтотОбъект);	
	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(ВозвратнаяТара, ЭтотОбъект);	
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлению106БезПартий()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.НомерСтроки,
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗМатериалы.ЕдиницаИзмерения,
	|	ПоступлениеМЗМатериалы.Количество,
	|	ПоступлениеМЗМатериалы.Сумма,
	|	ПоступлениеМЗМатериалы.СтавкаНДС,
	|	ПоступлениеМЗМатериалы.СуммаНДС,
	|	ПоступлениеМЗМатериалы.Всего,
	|	ПоступлениеМЗМатериалы.СчетУчета,
	|	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗМатериалы.КПС,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗМатериалы.Количество <> 0
	|			ТОГДА ПоступлениеМЗМатериалы.Сумма / ПоступлениеМЗМатериалы.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена,
	|	ПоступлениеМЗМатериалы.НДСКРаспределению КАК НДСКРаспределению,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗМатериалы.Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках
	|			ТОГДА ПоступлениеМЗМатериалы.ПринятьНДСКВычету
	|		ИНАЧЕ ПоступлениеМЗМатериалы.Ссылка.ПринятьНДСКВычету
	|	КОНЕЦ КАК ПринятьНДСКВычету
	|ПОМЕСТИТЬ Материалы
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеМЗВозвратнаяТара.НомерСтроки,
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура,
	|	ПоступлениеМЗВозвратнаяТара.Количество,
	|	ПоступлениеМЗВозвратнаяТара.Сумма,
	|	ПоступлениеМЗВозвратнаяТара.СчетУчета,
	|	ПоступлениеМЗВозвратнаяТара.ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗВозвратнаяТара.КПС
	|ПОМЕСТИТЬ ВозвратнаяТара
	|ИЗ
	|	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	|ГДЕ
	|	ПоступлениеМЗВозвратнаяТара.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Остатки.КПС,
	|	Остатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	Остатки.СуммаОстатокДт КАК СуммаОстаток,
	|	Остатки.Счет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетаОстатков), &ВидыСубконто,
	|		Организация = &Организация
	|	И КФО = &КФО
	|	И Субконто2 = &ЦМО) КАК Остатки
	|ГДЕ
	|	КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.НомерСтроки,
	|	Материалы.Номенклатура,
	|	Материалы.ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстаток < Материалы.Количество
	|			ТОГДА Остатки.КоличествоОстаток
	|		ИНАЧЕ Материалы.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстаток < Материалы.Количество
	|			ТОГДА Остатки.СуммаОстаток
	|		ИНАЧЕ Материалы.Количество * Остатки.СуммаОстаток / Остатки.КоличествоОстаток
	|	КОНЕЦ КАК Сумма,
	|	Материалы.СтавкаНДС,
	|	Остатки.Счет КАК СчетУчета,
	|	Материалы.КПС,
	|	Материалы.НДСКРаспределению,
	|	Материалы.ПринятьНДСКВычету
	|ИЗ
	|	Материалы КАК Материалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО Остатки.Номенклатура = Материалы.Номенклатура
	|		И Остатки.КПС = Материалы.КПС
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратнаяТара.НомерСтроки,
	|	ВозвратнаяТара.Номенклатура,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстаток < ВозвратнаяТара.Количество
	|			ТОГДА Остатки.КоличествоОстаток
	|		ИНАЧЕ ВозвратнаяТара.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Остатки.КоличествоОстаток < ВозвратнаяТара.Количество
	|			ТОГДА Остатки.СуммаОстаток
	|		ИНАЧЕ ВозвратнаяТара.Количество * Остатки.СуммаОстаток / Остатки.КоличествоОстаток
	|	КОНЕЦ КАК Сумма,
	|	Остатки.Счет КАК СчетУчета,
	|	ВозвратнаяТара.КПС
	|ИЗ
	|	ВозвратнаяТара КАК ВозвратнаяТара
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО Остатки.Номенклатура = ВозвратнаяТара.Номенклатура
	|		И Остатки.КПС = ВозвратнаяТара.КПС
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	СчетаОстатков = БухгалтерскийУчет.СписокСчетов("106.2П, 106.3П", Дата, , Организация);
	ВидыСубконтоЗапроса = БухгалтерскийУчет.СписокСубконто("Номенклатура, ЦМО");
	Если Ссылка.Пустая() Тогда
		ПериодЗапроса = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗапроса = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;		
	Запрос.УстановитьПараметр("Период", ПериодЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("СчетаОстатков", СчетаОстатков);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконтоЗапроса);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("ЦМО", ЦМО);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчетаНДС.Вставить("РассчитыватьЦену", Истина);
	
	ВыборкаМатериалы = РезультатЗапроса[3].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрокаМатериалы = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериалы, ВыборкаМатериалы, , "НДСКРаспределению, ПринятьНДСКВычету");
		Если ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериалы, ВыборкаМатериалы, "НДСКРаспределению, ПринятьНДСКВычету");
		Иначе
			УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрокаМатериалы, "Сумма", ПараметрыРасчетаНДС);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаВозвратнаяТара = РезультатЗапроса[4].Выбрать();
	Пока ВыборкаВозвратнаяТара.Следующий() Цикл
		НоваяСтрокаВозвратнаяТара = ВозвратнаяТара.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаВозвратнаяТара, ВыборкаВозвратнаяТара);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлению106(ДокументОснование, РеквизитыОснования)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			,
	               |			Счет В (&Счет106),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &ДокументОснование
	               |				И КФО = &КФО) КАК ЖурналПроводокЕПСБУОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗМатериалы.НомерСтроки КАК НомерСтроки,
	               |	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	               |	ПоступлениеМЗМатериалы.КПС КАК КПС,
	               |	Остатки.СчетУчета КАК СчетУчета,
	               |	Остатки.КоличествоОстаток КАК Количество,
	               |	Остатки.СуммаОстаток КАК Сумма,
	               |	Остатки.СуммаОстаток КАК Всего,
	               |	Остатки.СуммаОстаток / Остатки.КоличествоОстаток КАК Цена,
	               |	ВЫРАЗИТЬ(&ДокументОснование КАК Документ.ПоступлениеМЗ) КАК ДополнительнаяАналитикаСчета,
	               |	ПоступлениеМЗМатериалы.СтавкаНДС КАК СтавкаНДС,
	               |	0 КАК СуммаНДС
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	               |		ПО ПоступлениеМЗМатериалы.Номенклатура = Остатки.Номенклатура
	               |			И ПоступлениеМЗМатериалы.КПС = Остатки.КПС
	               |ГДЕ
	               |	Остатки.КоличествоОстаток <> 0
	               |	И ПоступлениеМЗМатериалы.Ссылка = &ДокументОснование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗВозвратнаяТара.Номенклатура КАК Номенклатура,
	               |	ПоступлениеМЗВозвратнаяТара.КПС КАК КПС,
	               |	Остатки.СчетУчета КАК СчетУчета,
	               |	Остатки.СуммаОстаток КАК Сумма,
	               |	Остатки.КоличествоОстаток КАК Количество,
	               |	ВЫРАЗИТЬ(&ДокументОснование КАК Документ.ПоступлениеМЗ) КАК ДополнительнаяАналитикаСчета
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	               |		ПО ПоступлениеМЗВозвратнаяТара.Номенклатура = Остатки.Номенклатура
	               |			И ПоступлениеМЗВозвратнаяТара.КПС = Остатки.КПС
	               |ГДЕ
	               |	Остатки.СуммаОстаток <> 0
	               |	И ПоступлениеМЗВозвратнаяТара.Ссылка = &ДокументОснование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПоступлениеМЗВозвратнаяТара.НомерСтроки";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);				   
	Запрос.УстановитьПараметр("Организация", РеквизитыОснования.Организация);
	Запрос.УстановитьПараметр("КФО", КФО);
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Партии);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);				   
	Запрос.УстановитьПараметр("Счет106",      БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	СписокМатериалов = Результат[1].Выгрузить();
	Для каждого ТекСтрока Из СписокМатериалов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.СтавкаНДС) И (ТекСтрока.СуммаНДС = 0) Тогда
			РасчитатьСтроку(ТекСтрока, ДокументОснование.СуммаВключаетНДС, "СтавкаНДС");
		КонецЕсли;	
	КонецЦикла;	
	
	Материалы.Загрузить(СписокМатериалов);
	ВозвратнаяТара.Загрузить(Результат[2].Выгрузить());
	
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.00", Дата, Организация);

	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаСторону;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлению105(ДокументОснование, РеквизитыОснования)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПоступлениеМЗМатериалы.Количество КАК Количество,
	|	ПоступлениеМЗМатериалы.Сумма КАК Сумма,
	|	ПоступлениеМЗМатериалы.СтавкаНДС КАК СтавкаНДС,
	|	ПоступлениеМЗМатериалы.СуммаНДС КАК СуммаНДС,
	|	ПоступлениеМЗМатериалы.Всего КАК Всего,
	|	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗМатериалы.КПС КАК КПС,
	|	ПоступлениеМЗМатериалы.КомиссионнаяТорговля КАК КомиссионнаяТорговля,
	|	ПоступлениеМЗМатериалы.Комитент КАК Комитент,
	|	ПоступлениеМЗМатериалы.ДоговорКомитента КАК ДоговорКомитента,
	|	ЕСТЬNULL(ПоступлениеМЗМатериалы.КЭК.Код, """") КАК КЭК,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗМатериалы.Количество <> 0
	|			ТОГДА ПоступлениеМЗМатериалы.Сумма / ПоступлениеМЗМатериалы.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена,
	|	ПоступлениеМЗМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ПоступлениеМЗМатериалы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ПоступлениеМЗМатериалы.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПоступлениеМЗМатериалы.НДСКРаспределению КАК НДСКРаспределению,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.ПринятьНДСКВычетуУказываетсяВСтроках
	|			ТОГДА ПоступлениеМЗМатериалы.ПринятьНДСКВычету
	|		ИНАЧЕ ПоступлениеМЗ.ПринятьНДСКВычету
	|	КОНЕЦ КАК ПринятьНДСКВычету
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|	ПО ПоступлениеМЗМатериалы.Ссылка = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеМЗМатериалы.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеМЗВозвратнаяТара.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗВозвратнаяТара.Количество КАК Количество,
	|	ПоступлениеМЗВозвратнаяТара.Сумма КАК Сумма,
	|	ПоступлениеМЗВозвратнаяТара.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗВозвратнаяТара.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗВозвратнаяТара.КПС КАК КПС
	|ИЗ
	|	Документ.ПоступлениеМЗ.ВозвратнаяТара КАК ПоступлениеМЗВозвратнаяТара
	|ГДЕ
	|	ПоступлениеМЗВозвратнаяТара.Ссылка = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеМЗВозвратнаяТара.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|*
	|ИЗ
	|	Документ.ПоступлениеМЗ.СведенияПрослеживаемости КАК ПоступлениеМЗСведенияПрослеживаемости
	|ГДЕ
	|	ПоступлениеМЗСведенияПрослеживаемости.Ссылка = &ДокументОснование";
	Результат = Запрос.ВыполнитьПакет();
	КэшТиповДопСубконто = Новый Соответствие;
	
	Материалы.Очистить();
	ВыборкаМатериалы = Результат[0].Выбрать();
	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы, , "НДСКРаспределению, ПринятьНДСКВычету");
		Если ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы, "НДСКРаспределению, ПринятьНДСКВычету");
		КонецЕсли;
		НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("4" + Сред(ВыборкаМатериалы.КЭК, 2));
		УправлениеМатериальнымиЗапасами.ПривестиЗначениеДопСубконтоВСтроке(НоваяСтрока, КэшТиповДопСубконто);
	КонецЦикла;
	
	ВозвратнаяТара.Очистить();
	ВыборкаТара = Результат[1].Выбрать();
	Пока ВыборкаТара.Следующий() Цикл
		НоваяСтрока = ВозвратнаяТара.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТара);
		УправлениеМатериальнымиЗапасами.ПривестиЗначениеДопСубконтоВСтроке(НоваяСтрока, КэшТиповДопСубконто);
	КонецЦикла;
	
	СведенияПрослеживаемости.Очистить();
	ВыборкаРНПТ = Результат[2].Выбрать();
	Пока ВыборкаРНПТ.Следующий() Цикл
		НоваяСтрока = СведенияПрослеживаемости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаРНПТ);
	КонецЦикла;

КонецПроцедуры

Функция ЕстьПроводкиПоступленияПоСчету106(ДокументОснование, Счет, КФО = Неопределено)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЖурналПроводокЕПСБУ.КФО КАК КФО,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУ.СчетДт В ИЕРАРХИИ (&СчетУчета)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ПоступлениеНаСчет106
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |ГДЕ
	               |	ЖурналПроводокЕПСБУ.Регистратор = &ДокументОснование
	               |	И (ЖурналПроводокЕПСБУ.СчетДт В ИЕРАРХИИ (&СчетУчета)
	               |			ИЛИ ЖурналПроводокЕПСБУ.СчетДт В (&Счет106))";
	Запрос.УстановитьПараметр("СчетУчета", Счет);
	Запрос.УстановитьПараметр("Счет106", БухгалтерскийУчет.СписокСчетов("106.00"));
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КФО = Выборка.КФО;
		Если Выборка.ПоступлениеНаСчет106 Тогда

			Возврат Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Процедура ЗаполнитьКФОПоСчетуРасчетов(ДокументОснование, Счет, КФО = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПроводокЕПСБУ.КФО КАК КФО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор = &ДокументОснование
