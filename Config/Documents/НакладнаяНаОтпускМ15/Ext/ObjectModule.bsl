КонецФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Материалы.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ДрагМатериалыДокумента.ОбъектНФА,
	               |	ДрагМатериалыДокумента.МассаДМ,
	               |	ДрагМатериалыДокумента.ЛигатурнаяМасса,
	               |	ДрагМатериалыДокумента.ЧистаяМасса,
	               |	ДрагМатериалыДокумента.КоличествоДМ
	               |ПОМЕСТИТЬ ДрагМатериалыДокумента
	               |ИЗ
	               |	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ОбъектыДокумента.Номенклатура
	               |ПОМЕСТИТЬ ОбъектыДокумента
	               |ИЗ
	               |	&ОбъектыДокумента КАК ОбъектыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОбъектыНФАДокумента.Организация,
	               |	ОбъектыНФАДокумента.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЛигатурнаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЧистаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьДрагМатериалы
	               |ПОМЕСТИТЬ ОбъектыНФАДокумента
	               |ИЗ
	               |	ОбъектыДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
	               |			И ОбъектыНФАДокумента.Номенклатура = ДрагМатериалыДокумента.ОбъектНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	               |	0 КАК ЧистаяМассаОстаток,
	               |	0 КАК ЛигатурнаяМассаОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	               |		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток,
	               |	0,
	               |	0,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
	               |		ПО (НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВЛомеИОтходахОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
				   
	ТаблицаОбъектовНФА = Материалы.Выгрузить(,"Номенклатура");
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" из списка ""Материальные запасы"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ОбъектНФА);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьПоПередачеНаХранениеВПереработку(ПередачаДавальческогоСырья) Экспорт
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Передача = ПередачаДавальческогоСырья.ПолучитьОбъект();
	
	Если Передача.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возврат с хранения (из переработки) может быть заполнен на основании передачи на хранение (в переработку).
			|Выбран документ с видом движения ""%1""'"), Передача.ВидПередачиМЗ);
	КонецЕсли;
	
	ДокументОснование = ПередачаДавальческогоСырья;
	ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Передача, "Организация, СчетУчета, КФО, Перевозчик, ЦМО, Подразделение,"
		+ "ЦМОПриПередаче, ПодразделениеПриПередаче, Контрагент, Договор");
	
	Материалы.Очистить();
	ВозвратнаяТара.Очистить();
	
	Для Каждого СтрокаДокумента Из Передача.Материалы Цикл
		
		ЗаполнитьЗначенияСвойств(Материалы.Добавить(), СтрокаДокумента);
		
	КонецЦикла;
	
	Для Каждого СтрокаДокумента Из Передача.ВозвратнаяТара Цикл
		
		ЗаполнитьЗначенияСвойств(ВозвратнаяТара.Добавить(), СтрокаДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", ИмяРеквизита <> "Цена");
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

Процедура ЗаполнитьКорректировку(Основание)
	
	УправлениеМатериальнымиЗапасами.ПроверитьДокументОснованиеНеКорректировался(Основание, Ссылка);
	
	ОснованиеОбъект = Основание.ПолучитьОбъект();
	Если ОснованиеОбъект = Неопределено Тогда
		ВызватьИсключение "Не заполнен документ-основание";
	КонецЕсли;
	
	ДокументОснование = Основание;
	ЗаполнитьКорректировкуШапка(ЭтотОбъект, ОснованиеОбъект);
	ЗаполнитьКорректировкуМатериалы(ЭтотОбъект, ОснованиеОбъект);
	ЗаполнитьКорректировкуВозвратнаяТара(ЭтотОбъект, ОснованиеОбъект);
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ДрагоценныеМатериалы"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "ДополнительныеРеквизиты"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(ЭтотОбъект, ОснованиеОбъект, "СведенияПрослеживаемости"); 	
	
	ЭтоКорректировка = Истина;
	НомерКорректировки = ОснованиеОбъект.НомерКорректировки + 1;
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуШапка(Объект, ОснованиеОбъект)

	ИменаИсключенныхПолей =
	"Ссылка,
	|ВерсияДанных,
	|ПометкаУдаления,
	|Номер,
	|Дата,
	|Проведен,
	|Комментарий,
	|ИДИсточника,
	|ДокументОснование,
	|Ответственный,
	|ЭтоКорректировка,
	|НомерКорректировки";
	ЗаполнитьЗначенияСвойств(Объект, ОснованиеОбъект, , ИменаИсключенныхПолей);	

КонецПроцедуры

Процедура ЗаполнитьКорректировкуМатериалы(Объект, ОснованиеОбъект)
	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "Материалы"); 
	
	КорректируемыеКолонки =
	"Количество,
	|Цена,
	|Сумма,
	|СуммаНДС,
	|Всего";
	УправлениеМатериальнымиЗапасами.ЗаполнитьКолонкиДоКорректировки(Объект.Материалы, КорректируемыеКолонки);
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуВозвратнаяТара(Объект, ОснованиеОбъект)
	
	ИменаПолей =
	"Номенклатура,
	|Количество,
	|Сумма,
	|СчетУчета,
	|КПС,
	|ДополнительнаяАналитикаСчета,
	|КЭК";
	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "ВозвратнаяТара", ИменаПолей); 
	
	КорректируемыеКолонки =
	"Количество,
	|Сумма";
	УправлениеМатериальнымиЗапасами.ЗаполнитьКолонкиДоКорректировки(Объект.ВозвратнаяТара, КорректируемыеКолонки);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеДополнительнойАналитикиКомиссионныхТоваров(Объект, Отказ)
	
	СчетУчетаЗакупкиКомиссионныхТоваров = БухгалтерскийУчет.СчетПоКоду("02.34", Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.Материалы Цикл
	
		Если ЗначениеЗаполнено(ТекСтрока.СчетУчета)
			И ТекСтрока.КомиссионнаяТорговля
			И НЕ ЗначениеЗаполнено(ТекСтрока.ДополнительнаяАналитикаСчета)Тогда
			
			Если ТекСтрока.СчетУчета = СчетУчетаЗакупкиКомиссионныхТоваров Тогда
				Продолжить;
			КонецЕсли;
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Дополнительная аналитика счета'"), ТекСтрока.НомерСтроки, "Материалы");
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", ТекСтрока.НомерСтроки, "ДополнительнаяАналитикаСчета");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПутьКПолю, ,Отказ);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоПередачеНаРеализацию(ПередачаНаРеализацию) Экспорт
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Передача = ПередачаНаРеализацию.ПолучитьОбъект();
	
	Если Передача.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаРеализацию Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возврат с товаров переданных на реализацию может быть заполнен на основании передачи на реализацию.
			|Выбран документ с видом движения ""%1""'"), Передача.ВидПередачиМЗ);
	КонецЕсли;
	
	ДокументОснование = ПередачаНаРеализацию;
	ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Передача, "Организация, СчетУчета, КФО, Перевозчик, ЦМО, Подразделение,"
		+ "ЦМОПриПередаче, ПодразделениеПриПередаче, Контрагент, Договор");
	
	Материалы.Очистить();
	ВозвратнаяТара.Очистить();
	
	Для Каждого СтрокаДокумента Из Передача.Материалы Цикл
		
		ЗаполнитьЗначенияСвойств(Материалы.Добавить(), СтрокаДокумента);
		
	КонецЦикла;
	
	Для Каждого СтрокаДокумента Из Передача.ВозвратнаяТара Цикл
		
		ЗаполнитьЗначенияСвойств(ВозвратнаяТара.Добавить(), СтрокаДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

