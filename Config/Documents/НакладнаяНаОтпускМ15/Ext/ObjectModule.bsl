	Если Выборка.Следующий() Тогда
		КФО = Выборка.КФО;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьПроводкиПоступленияПоСчету40160(ДокументОснование, Счет, Счет40160)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
