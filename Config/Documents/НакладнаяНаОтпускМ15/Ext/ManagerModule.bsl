#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																				ДокументСсылка.Дата);
	ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																				ДокументСсылка.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НакладнаяНаОтпускМ15.Номер КАК Номер,
	               |	НакладнаяНаОтпускМ15.Дата КАК Дата,
	               |	НакладнаяНаОтпускМ15.Организация КАК Организация,
	               |	НакладнаяНаОтпускМ15.Контрагент КАК Контрагент,
	               |	НакладнаяНаОтпускМ15.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	               |	НакладнаяНаОтпускМ15.Грузоотправитель КАК Грузоотправитель,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.РасчетныйСчетГрузоотправителя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаОтпускМ15.РасчетныйСчетГрузоотправителя
	               |	КОНЕЦ КАК СчетГрузоотправителя,
	               |	НакладнаяНаОтпускМ15.Грузополучатель КАК Грузополучатель,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.РасчетныйСчетГрузополучателя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаОтпускМ15.РасчетныйСчетГрузополучателя
	               |		КОГДА НакладнаяНаОтпускМ15.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаОтпускМ15.РасчетныйСчетКонтрагента
	               |	КОНЕЦ КАК СчетГрузополучателя,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	               |	НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	&Руководитель КАК Руководитель,
	               |	&ГлБухгалтер КАК ГлавныйБухгалтер,
	               |	НакладнаяНаОтпускМ15.ДокументОснование КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры) КАК Договор,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименование,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаОтпускМ15.ВалютаДокумента
	               |		ИНАЧЕ &РегламентированнаяВалюта
	               |	КОНЕЦ КАК Валюта,
	               |	НакладнаяНаОтпускМ15.Контрагент.ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	               |	НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					КОГДА НЕ НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	               |					КОГДА НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |							И НЕ НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |						ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |					ИНАЧЕ НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.Наименование
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаОтпускМ15.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					ИНАЧЕ НакладнаяНаОтпускМ15.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	               |	НакладнаяНаОтпускМ15.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
	               |	НакладнаяНаОтпускМ15.Ссылка КАК Ссылка,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУВид КАК ОтветственныйПередалТРУВид,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУДолжность КАК ОтветственныйПередалТРУДолжность,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУОснованиеПолномочий КАК ОтветственныйПередалТРУОснованиеПолномочий,
	               |	НакладнаяНаОтпускМ15.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	               |	НакладнаяНаОтпускМ15.ДатаПередачиТРУ КАК ДатаПередачиТРУ,
	               |	НакладнаяНаОтпускМ15.ТРУПереданы КАК ТРУПереданы
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НакладнаяНаОтпускМ15Материалы.НомерСтроки КАК НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
	               |	КОНЕЦ КАК ТоварНаименование,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер
	               |	КОНЕЦ КАК КодТовара,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Представление КАК ЕдиницаИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Код) КАК БазоваяЕдиницаКод,
	               |	НакладнаяНаОтпускМ15Материалы.Количество КАК МассаНетто,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НЕ НакладнаяНаОтпускМ15Материалы.Ссылка.СуммаВключаетНДС
	               |				ТОГДА НакладнаяНаОтпускМ15Материалы.Цена
	               |			КОГДА НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (НакладнаяНаОтпускМ15Материалы.Всего - НакладнаяНаОтпускМ15Материалы.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА НакладнаяНаОтпускМ15Материалы.Количество = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ НакладнаяНаОтпускМ15Материалы.Количество
	               |					КОНЕЦ
	               |			КОГДА НакладнаяНаОтпускМ15Материалы.СуммаНДС = 0 И НакладнаяНаОтпускМ15Материалы.Цена <> 0
	               |				ТОГДА НакладнаяНаОтпускМ15Материалы.Цена
	               |			ИНАЧЕ (НакладнаяНаОтпускМ15Материалы.Всего - НакладнаяНаОтпускМ15Материалы.СуммаНДС) / ВЫБОР
	               |					КОГДА НакладнаяНаОтпускМ15Материалы.Количество = 0
	               |						ТОГДА 1
	               |					ИНАЧЕ НакладнаяНаОтпускМ15Материалы.Количество
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК Цена,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (НакладнаяНаОтпускМ15Материалы.Всего - НакладнаяНаОтпускМ15Материалы.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ НакладнаяНаОтпускМ15Материалы.Всего - НакладнаяНаОтпускМ15Материалы.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаБезНДС,
	               |	НакладнаяНаОтпускМ15Материалы.СтавкаНДС КАК СтавкаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА НакладнаяНаОтпускМ15Материалы.СуммаНДС * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ НакладнаяНаОтпускМ15Материалы.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаОтпускМ15Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА НакладнаяНаОтпускМ15Материалы.Всего * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ НакладнаяНаОтпускМ15Материалы.Всего
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаСНДС,
	               |	НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Справочник.Номенклатура).СтранаПроисхождения.Код) КАК КодСтраныПроисхождения,
