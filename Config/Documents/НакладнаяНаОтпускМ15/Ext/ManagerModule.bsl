// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.НакладнаяНаОтпускМ15
//  Параметры - Структура
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	ТаблицаДокумента.Колонки.Добавить("УчетПоПодразделениям",              Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("РазрешитьНеУказыватьПодразделение", Новый ОписаниеТипов("Булево"));
	
	ИмяСписка = "Материалы";
	СинонимСписка = Документ.Метаданные().ТабличныеЧасти.Материалы.Синоним;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Документ.СчетУчета);
	
	ВидДопСубконто27 = Неопределено;
	Для Счетчик = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Счетчик]) Тогда
			Если СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				ВидДопСубконто27 = СвойстваСчета["ВидСубконто" + Счетчик];
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаДокумента Из Документ.Материалы Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ИмяСписка = ИмяСписка;
		НоваяСтрока.СинонимСписка = СинонимСписка;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
			"НомерСтроки, КПС, КЭК, СчетУчета, Номенклатура, Количество, СуммаСписания, СуммаСписанияНУ");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ, "ИФО, КФО, НеПересчитыватьСумму");

		НоваяСтрока.ДопАналитика = СтрокаДокумента.ДополнительнаяАналитикаСчета;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.ДополнительноеСубконтоСчета) И ВидДопСубконто27 <> Неопределено Тогда
			НоваяСтрока.ДопИзмерение = СтрокаДокумента.ДополнительноеСубконтоСчета;
			НоваяСтрока.ДопИзмерениеВидСубконто = ВидДопСубконто27;
		Иначе
			НоваяСтрока.ДопИзмерение = Документ.ЦМО;
			НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		КонецЕсли;
		
		НоваяСтрока.УчетПоПодразделениям              = СвойстваСчета.УчетПоПодразделениям;
		НоваяСтрока.РазрешитьНеУказыватьПодразделение = СвойстваСчета.РазрешитьНеУказыватьПодразделение;
		НоваяСтрока.Подразделение                     = Документ.Подразделение;
		НоваяСтрока.ПодразделениеПолучатель           = Документ.Подразделение;
	КонецЦикла;
	
	Возврат ТаблицаДокумента;

КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускМ15.Ссылка
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	|ГДЕ
	|	НакладнаяНаОтпускМ15.ВидПередачиМЗ Не В (ЗНАЧЕНИЕ(Перечисление.ВидыПередачиМЗ.Реализация),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыПередачиМЗ.ВозвратПоставщику))
	|	И Не НакладнаяНаОтпускМ15.НеПересчитыватьСумму
	|	И НакладнаяНаОтпускМ15.СуммаДокумента <> 0";
	
	ДокументыКОбработке = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		ДокументыКОбработке.Добавить(Выборка.Ссылка);
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
			ДокументыКОбработке.Очистить();
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.НакладнаяНаОтпускМ15";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); // ДокументОбъект.НакладнаяНаОтпускМ15
			ОбъектИзменен = Ложь;
			Если Объект <> Неопределено Тогда 
				Объект.Заблокировать();
				Если Объект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.Реализация
					И Объект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратПоставщику
					И Не Объект.НеПересчитыватьСумму
					И Объект.СуммаДокумента <> 0 Тогда
						Объект.СуммаДокумента = 0;
						ОбъектИзменен = Истина;
				КонецЕсли;
			КонецЕсли;
				
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// Отдельный обработчик обновления.
// Обработчик многопоточный, поэтому его не нужно объединять с существующим.
// Предыдущий обработчик вызывался на версии 2.0.91 и маловероятно, что у кого-то еще будет использоваться.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2(Параметры) Экспорт

	ПервичныеДокументыБГУ.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры,
		Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));	
	
КонецПроцедуры

