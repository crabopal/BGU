#Область Печать

// Формирует текстовое представление команды печати "Акта о приеме-передаче НФА (ф.0504101)".
// 
// Параметры:
// 	ПоСебестоимости - Булево - добавлять текст " (по себестоимости)"
// 	Редакция - Строка - номер редакции
// Возвращаемое значение:
// 	Строка - представление команды
Функция ПредставлениеКомандыПечати0504101(ПоСебестоимости, Редакция) Экспорт
	ПредставлениеКоманды = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приеме-передаче НФА'"),
		"0504101", "52н", Редакция, Истина);
	Если ПоСебестоимости Тогда
		Возврат ПредставлениеКоманды + НСтр("ru = ' (по себестоимости)'");
	Иначе
		Возврат ПредставлениеКоманды;
	КонецЕсли;
Конецфункции

// Формирует печатные формы "Акта приема-передачи НФА (ф.0504101)" объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документо в
//
Процедура ВывестиТабличныйДокумент0504101ВКоллекцию(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СинонимМакета = ПредставлениеКомандыПечати0504101(ПараметрыПечати.ПоСебестоимости, ПараметрыПечати.Редакция);
	ТабличныйДокумент = ПечатьАктаПриемаПередачи0504101(МассивОбъектов, ОбъектыПечати, ПараметрыПечати); 
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		ИмяМакета0504101(ПараметрыПечати.ПоСебестоимости, ПараметрыПечати.Редакция),
		СинонимМакета,
		ТабличныйДокумент);
КонецПроцедуры

// Проверить, нужно ли печатать макет "Акт приема-передачи НФА (ф.0504101)".
// Функция предназначена для использования только внутри процедуры Печать.
//
// Параметры:
//  КоллекцияПечатныхФорм - ТаблицаЗначений - служебный параметр, переданный в процедуру Печать;
//
// Возвращаемое значение:
//  Булево - Истина, если макет надо печатать.
//
Функция НужноПечататьМакет0504101(КоллекцияПечатныхФорм, ПараметрыПечати) Экспорт
	ПоСебестоимости = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПечати, "ПоСебестоимости", Ложь);
	Редакция = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПечати, "Редакция", "");
	Возврат УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета0504101(ПоСебестоимости, Редакция));
КонецФункции

// Добавляет команду печати "Акта приема-передачи НФА (ф.0504101)"
// 
// Параметры:
// 	КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
// 	Представление - Строка - представление добавляемой команды
// 	Порядок - Число - порядок команды в подменю печать
// 	ПоСебестоимости - Булево - печатать форму "по себестоимости"
// 	Редакция - Строка - номер редакции, для выбора макета печатной формы.
//
Процедура ДобавитьКомандуПечати0504101(КомандыПечати, Представление, Порядок, ПоСебестоимости, Редакция) Экспорт
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаОтпускМ15";
	КомандаПечати.Идентификатор		= ИмяМакета0504101(ПоСебестоимости, Редакция);
	КомандаПечати.Представление		= Представление;
	КомандаПечати.Порядок			= Порядок;
	КомандаПечати.ДополнительныеПараметры.Вставить("ПоСебестоимости", ПоСебестоимости);
	КомандаПечати.ДополнительныеПараметры.Вставить("Редакция",        Редакция);
	Если Не ПоСебестоимости Тогда
		ДопустимыеВидыНакладной = Новый Массив;
		ДопустимыеВидыНакладной.Добавить(Перечисления.ВидыПередачиМЗ.Реализация);
		ДопустимыеВидыНакладной.Добавить(Перечисления.ВидыПередачиМЗ.ВозвратПоставщику);
		ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати,
			"ВидПередачиМЗ",
			ДопустимыеВидыНакладной,
			ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	Порядок = Порядок + 1;
КонецПроцедуры

Функция ДанныеДляТТН(Ссылка, ОбщийИтог = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Запрос.Текст = Документы.НакладнаяНаРеализациюТорг12.ТекстЗапросаТоварыДляТТН(ОбщийИтог, "Документ.НакладнаяНаОтпускМ15", "Материалы");
		
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать106 - Булево - получать свойства счета 106
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Кт");
	Результат.Вставить("Включать106", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	ИменаТабличныхЧастей.Добавить("ВозвратнаяТара");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроверкаЗаполнения

// Проверить заполнение документа основания.
// 
// Параметры:
//  Объект - ДокументОбъект.НакладнаяНаОтпускМ15
//         - см. Документ.НакладнаяНаОтпускМ15.Форма.ФормаДокумента.Объект 
// 
// Возвращаемое значение:
//  Булево
Функция ПроверитьЗаполнениеДокументаОснования(Объект) Экспорт
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование)
			И Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
		ТекстОшибки = НСтр("ru= 'При возврате материалов, поступивших через счет 401.60, необходимо указать документ поставки'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, , "Объект.ДокументОснование");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Получить признаки учета НДСНоменклатуры документа основания.
// 
// Параметры:
//  Объект - ДокументОбъект.НакладнаяНаОтпускМ15
//         - см. Документ.НакладнаяНаОтпускМ15.Форма.ФормаДокумента.Объект 
// 
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Номенклатура
//   * Количество
//   * Сумма
//   * СтавкаНДС
//   * СуммаНДС
//   * Всего
//   * НДСКРаспределению
//   * ПринятьНДСКВычету
//   * ДополнительнаяАналитикаСчета
//   * КПС
//   * СчетУчета
//   * КФО
//   * КЭК
Функция ПолучитьТаблицуПоступления(Объект) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗМатериалы.Количество,
	|	ПоступлениеМЗМатериалы.Сумма,
	|	ПоступлениеМЗМатериалы.СтавкаНДС,
	|	ПоступлениеМЗМатериалы.СуммаНДС,
	|	ПоступлениеМЗМатериалы.Всего,
	|	ПоступлениеМЗМатериалы.НДСКРаспределению,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.ПринятьНДСКВычетуУказываетсяВСтроках
	|			ТОГДА ПоступлениеМЗМатериалы.ПринятьНДСКВычету
	|		ИНАЧЕ ПоступлениеМЗ.ПринятьНДСКВычету
	|	КОНЕЦ КАК ПринятьНДСКВычету,
	|	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗМатериалы.КПС,
	|	ПоступлениеМЗМатериалы.СчетУчета,
	|	ПоступлениеМЗМатериалы.КФО,
	|	ПоступлениеМЗМатериалы.КЭК
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО ПоступлениеМЗМатериалы.Ссылка = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Номер, ЭтоКорректировка, ДокументОснование");
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПериодДвижений", ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ДанныеДокумента.Номер));
	Если ДанныеДокумента.ЭтоКорректировка Тогда
		Запрос.УстановитьПараметр("КорректируемыйДокумент", ДанныеДокумента.ДокументОснование);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ДанныеДокумента.ЭтоКорректировка, ДанныеДокумента.ДокументОснование);
	
	ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДокументСсылка, ДанныеДокумента.Дата);
	
	ИнициализироватьЗапросыПоЗакупленнымТоварамКомитентов(Запрос, НомераТаблиц, ДокументСсылка, ДанныеДокумента.Дата);
	
	Результат = Запрос.ВыполнитьПакет();

	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(ТаблицыДляДвижений, ДокументСсылка); 
	ДобавитьДвиженияРасходОстаткиКодовИСМП(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ЭтоКорректировка, КорректируемыйДокумент)

	Запрос.УстановитьПараметр("ИмяДокументаДМ", НСтр("ru = 'Накладная на отпуск материалов на сторону'"));
	
	ПараметрыЗапроса = УчетДрагМатериалов.ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА_Параметры(
		"Документ.НакладнаяНаОтпускМ15.ДрагоценныеМатериалы", "Расход");
	ПараметрыЗапроса.ЭтоКорректировка = ЭтоКорректировка;
	ПараметрыЗапроса.КорректируемыйДокумент = КорректируемыйДокумент;

	УчетДрагМатериалов.ИнициализироватьДанныеДокумента(Запрос, НомераТаблиц, ПараметрыЗапроса);
	 
КонецПроцедуры	

Процедура ДобавитьДвиженияРасходОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)
	
	Если ОбменИСМПБГУ.ВедетсяКонтрольОстатковКодовИСМП(ДокументСсылка.Организация) Тогда 
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыУпаковокМаркируемойПродукции.Ссылка.Организация КАК Организация,
		|	КодыУпаковокМаркируемойПродукции.НомерУпаковки КАК КодИСМП,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	КодыУпаковокМаркируемойПродукции.Ссылка.Дата КАК Период,
		|	КодыУпаковокМаркируемойПродукции.Ссылка КАК Регистратор,
		|	1 КАК Количество,
		|	Материалы.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТКоды
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.КодыУпаковокМаркируемойПродукции КАК КодыУпаковокМаркируемойПродукции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускМ15.Материалы КАК Материалы
		|		ПО КодыУпаковокМаркируемойПродукции.Ссылка = Материалы.Ссылка
		|			И КодыУпаковокМаркируемойПродукции.ИдентификаторСтроки = Материалы.ИдентификаторСтроки
		|ГДЕ
		|	КодыУпаковокМаркируемойПродукции.Ссылка = &ДокументСсылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НакладнаяНаОтпускМ15Материалы.Ссылка.Организация,
		|	НакладнаяНаОтпускМ15Материалы.КодGTIN,
		|	НакладнаяНаОтпускМ15Материалы.Номенклатура,
		|	НакладнаяНаОтпускМ15Материалы.Ссылка.Дата,
		|	НакладнаяНаОтпускМ15Материалы.Ссылка,
		|	НакладнаяНаОтпускМ15Материалы.Количество,
		|	НакладнаяНаОтпускМ15Материалы.НомерСтроки
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
		|ГДЕ
		|	НакладнаяНаОтпускМ15Материалы.Ссылка = &ДокументСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоды.Организация КАК Организация,
		|	ВТКоды.КодИСМП КАК КодИСМП,
		|	ВТКоды.Номенклатура КАК Номенклатура,
		|	ВТКоды.Период КАК Период,
		|	ВТКоды.Регистратор КАК Регистратор,
		|	СУММА(ВТКоды.Количество) КАК Количество,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	ВТКоды.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТКоды КАК ВТКоды
		|ГДЕ
		|	ВТКоды.КодИСМП <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТКоды.Организация,
		|	ВТКоды.КодИСМП,
		|	ВТКоды.Номенклатура,
		|	ВТКоды.Период,
		|	ВТКоды.Регистратор,
		|	ВТКоды.НомерСтроки"; 
		
		ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();         
		
		ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);  
		Если ТаблицаДвиженийОстаткиКодовИСМП.Количество() > 0 Тогда 
			ОбменИСМПБГУ.ПроверитьОстаткиКодовИСМП(ДокументСсылка, ТаблицаДвиженийОстаткиКодовИСМП);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДокументСсылка, ДатаДокумента)
	
	Запрос.УстановитьПараметр("СчетРеализацияПоКомисии", БухгалтерскийУчет.СписокСчетов("02.33", ДатаДокумента));
	Запрос.УстановитьПараметр("Период", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	
	НомераТаблиц.Вставить("ДанныеДокумента", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиМатериаловПоПартиям", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РеализованныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускМ15.Дата КАК Период,
	|	НакладнаяНаОтпускМ15.Организация КАК Организация,
	|	НакладнаяНаОтпускМ15.Контрагент КАК Покупатель,
	|	НакладнаяНаОтпускМ15.Дата КАК ДатаРеализации,
	|	НакладнаяНаОтпускМ15.Ссылка КАК ДокументРасчетов,
	|	НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Номенклатура,
	|	НакладнаяНаОтпускМ15Материалы.Количество КАК Количество,
	|	НакладнаяНаОтпускМ15Материалы.Всего КАК Выручка,
	|	НакладнаяНаОтпускМ15Материалы.ДополнительнаяАналитикаСчета КАК Партия,
	|	НакладнаяНаОтпускМ15Материалы.СуммаНДС КАК СуммаНДС,
	|	НакладнаяНаОтпускМ15.ЦМО КАК ЦМО
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	|		ПО НакладнаяНаОтпускМ15Материалы.Ссылка = НакладнаяНаОтпускМ15.Ссылка
	|ГДЕ
	|	НакладнаяНаОтпускМ15.Ссылка = &Ссылка
	|	И НЕ НакладнаяНаОтпускМ15.Резервировать
	|	И НакладнаяНаОтпускМ15Материалы.СчетУчета В(&СчетРеализацияПоКомисии)
	|	И НакладнаяНаОтпускМ15.ВидПередачиМЗ = ЗНАЧЕНИЕ(Перечисление.ВидыПередачиМЗ.Реализация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Документ.ПоступлениеМЗ) КАК Партия,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиМатериаловПоПартиям
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетРеализацияПоКомисии), , ) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДанныеДокумента.Период КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ОстаткиМатериаловПоПартиям.Партия.Контрагент КАК Контрагент,
	|	ОстаткиМатериаловПоПартиям.Партия.Договор КАК ДоговорКомитента,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Покупатель КАК Покупатель,
	|	ДанныеДокумента.ДатаРеализации КАК ДатаРеализации,
	|	ДанныеДокумента.ДокументРасчетов КАК ДокументРасчетов,
	|	СУММА(ДанныеДокумента.Количество) КАК Количество,
	|	СУММА(ДанныеДокумента.Выручка) КАК Выручка,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМатериаловПоПартиям.КоличествоОстаток > 0
	|				ТОГДА ОстаткиМатериаловПоПартиям.СуммаОстаток / ОстаткиМатериаловПоПартиям.КоличествоОстаток * ДанныеДокумента.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПоступления,
