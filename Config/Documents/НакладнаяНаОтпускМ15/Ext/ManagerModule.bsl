Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетКонтрагента) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен расчетный счет контрагента в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.РеквизитыЛицевогоСчета) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены реквизиты лицевого счета в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Грузоотправитель) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетГрузоотправителя) Тогда
			ОписаниеОшибки = НСтр("ru='Заполнен грузоотправитель, но не заполнен расчетный счет грузоотправителя в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Грузополучатель) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетГрузополучателя) Тогда
			ОписаниеОшибки = НСтр("ru='Заполнен грузополучатель, но не заполнен расчетный счет грузополучателя в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	НеобходимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(ДокументСсылка.Контрагент, ДокументСсылка.Организация);
	Если НеобходимостьДанныхЭДОПродавцаДляГосНужд Тогда
		ДанныеЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументСсылка);
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.ДатаГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата гос.контракта в карточке договора %1 (реквизит ""от"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.НомерГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен номер гос.контракта в карточке договора %1 (реквизит ""№"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.Материалы Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения, КодПоКТРУ, КодКаталога");
			
			Если НЕ ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в карточке номенклатуры в строке %1 таблицы на закладке ""Материалы"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Материалы"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.ВозвратнаяТара Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в карточке номенклатуры в строке %1 таблицы на закладке ""Возвратная тара"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Возвратная тара"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	ЭлектронныеДокументыБГУ.ПроверитьЗаполнениеДанныхМаркировкиВТаблицеМатериалов(ДокументСсылка, "Материалы", "Материалы", "Номенклатура", Результат);
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

