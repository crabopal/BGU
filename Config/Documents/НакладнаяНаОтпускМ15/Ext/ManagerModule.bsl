	|		ПО (ДанныеДокументов.Ссылка = СчетаДт.Ссылка)
	|			И (ДанныеДокументов.СчетУчета = СчетаДт.СчетКредит)
	|			И (ДанныеДокументов.КПС = СчетаДт.КПСКт)
	|			И (ДанныеДокументов.Номенклатура = СчетаДт.Номенклатура)
	|			И (ДанныеДокументов.ДополнительнаяАналитикаСчета = СчетаДт.ДопСубконто)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	|		ПО (ДанныеДокументов.СчетУчета = СоответствиеСчетов.СчетУчета)
	|			И (ДанныеДокументов.ВидПередачиМЗ = СоответствиеСчетов.ВидПередачи)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокументов.Ссылка,
	|	ДанныеДокументов.ПорядокТЧ,
	|	ДанныеДокументов.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	СчетаПередачи = Новый Массив;
	Счет24 = БухгалтерскийУчет.СчетПоКоду("24");
	Если ЗначениеЗаполнено(Счет24) Тогда
		СчетаПередачи.Добавить(Счет24);
	КонецЕсли;
	Счет25 = БухгалтерскийУчет.СчетПоКоду("25");
	Если ЗначениеЗаполнено(Счет25) Тогда
		СчетаПередачи.Добавить(Счет25);
	КонецЕсли;
	Счет26 = БухгалтерскийУчет.СчетПоКоду("26");
	Если ЗначениеЗаполнено(Счет26) Тогда
		СчетаПередачи.Добавить(Счет26);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаПередачи", СчетаПередачи);
	Запрос.УстановитьПараметр("СчетаМЗ", БухгалтерскийУчет.СчетПоКоду("105.00"));
	
	Запрос.УстановитьПараметр("Передача24", Перечисления.ВидыПередачиМЗ.ПередачаВДоверительноеУправление);
	Запрос.УстановитьПараметр("Передача25", Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруАренды);
	Запрос.УстановитьПараметр("Передача26", Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруБезвмозмездногоПользования);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Возврат РезультатЗапроса;
КонецФункции

Функция ТаблицаДвиженийПоРегиструБухгалтерииДляПечати()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.НакладнаяНаОтпускМ15"));
	Результат.Колонки.Добавить("Баланс", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("НоменклатураСсылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("ДопСубконто", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КоличествоОстаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаОстаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КПССсылка", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КЭКСсылка", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("НомерСтрокиДокумента", Новый ОписаниеТипов("Число"));

	Возврат Результат;
	
КонецФункции

Функция ДвиженияПоРегиструБухгалтерииДляПечати(МассивОбъектов, ВыборкаШапка, ВыборкаВсеСтроки)
	
	ПараметрыРаспределенияДвижений = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвижений.ИмяКолонкиНоменклатура  = "НоменклатураСсылка";
	ПараметрыРаспределенияДвижений.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("СчетУчета",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КПССсылка",          "КПССсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("ДопСубконто",        "ДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "КПССсылка");

	ПараметрыРаспределенияДвиженийЗаб = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиКЭК           = "";
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиНоменклатура  = "НоменклатураСсылка";
	ПараметрыРаспределенияДвиженийЗаб.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("СчетУчета", "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("ДопСубконто",        "ЗабалансовыйДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "ЗабалансовыйКПС");

	Движения = ТаблицаДвиженийПоРегиструБухгалтерииДляПечати();
	ТаблицаДвижений = ДвиженияДляНакладной0504205(МассивОбъектов);
	ДвиженияЗабаланс = ДвиженияЗабалансДляНакладной0504205(МассивОбъектов);
	
	// Если есть и балансовые и забалансовые движения, то выводим только данные балансовых проводок.
	Если ТаблицаДвижений.Количество() > 0 И ДвиженияЗабаланс.Количество() > 0 Тогда
		ДвиженияЗабаланс.Очистить();
	КонецЕсли;

	Пока ВыборкаШапка.Следующий() Цикл

		ВыборкаВсеСтроки.Сбросить();
		Если ВыборкаВсеСтроки.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			ВыборкаСтроки = ВыборкаВсеСтроки.Выбрать();
		Иначе
			ВыборкаСтроки = Неопределено;
		КонецЕсли;

		Если ВыборкаСтроки <> Неопределено Тогда
			ТаблицаДвиженийДокумента = ТаблицаДвижений.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
			ПараметрыРаспределенияДвижений.Организация = ВыборкаШапка.Организация;
			ПараметрыРаспределенияДвижений.ИФО = ВыборкаШапка.ИФО;
			ПараметрыРаспределенияДвижений.КФО = ВыборкаШапка.КФО;
			ПараметрыРаспределенияДвижений.Дата = ВыборкаШапка.Дата;
			ПараметрыРаспределенияДвижений.ВыборкаМатериалы = ВыборкаСтроки;
			ПараметрыРаспределенияДвижений.ТаблицаДвижений = ТаблицаДвиженийДокумента;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвижений);
			
			Для Каждого РаспределенноеДвижение Из ТаблицаДвиженийДокумента Цикл
				НовоеДвижение = Движения.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеДвижение, РаспределенноеДвижение);
				НовоеДвижение.Баланс = Истина;
			КонецЦикла;
			
			ВыборкаСтроки.Сбросить();
			ТаблицаДвиженийДокументаЗаб = ДвиженияЗабаланс.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
			ПараметрыРаспределенияДвиженийЗаб.Организация = ВыборкаШапка.Организация;
			ПараметрыРаспределенияДвиженийЗаб.ИФО = ВыборкаШапка.ИФО;
			ПараметрыРаспределенияДвиженийЗаб.КФО = ВыборкаШапка.КФО;
			ПараметрыРаспределенияДвиженийЗаб.Дата = ВыборкаШапка.Дата;
			ПараметрыРаспределенияДвиженийЗаб.ВыборкаМатериалы = ВыборкаСтроки;
			ПараметрыРаспределенияДвиженийЗаб.ТаблицаДвижений = ТаблицаДвиженийДокументаЗаб;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвиженийЗаб);
			ВыборкаСтроки.Сбросить();
			
			Для Каждого РаспределенноеДвижение Из ТаблицаДвиженийДокументаЗаб Цикл
				НовоеДвижение = Движения.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеДвижение, РаспределенноеДвижение);
				НовоеДвижение.Баланс = Ложь;
			КонецЦикла;

		КонецЕсли;
		
	КонецЦикла;
	
	ВыборкаШапка.Сбросить();
	
	Возврат Движения;
	
КонецФункции

Функция ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Накладная0504205";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ПараметрыПечати.ИмяМакета);
	
	ОбластьМакетаВозврат    = Макет.ПолучитьОбласть("ВозвратМатериалов");
	ОбластьМакетаЗаголовок  = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка  	= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого  	= Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	
	Если ПараметрыПечати.ПоСебестоимости Тогда
		ТаблицаДвижений = ДвиженияДляНакладной0504205(МассивОбъектов);
		ДвиженияЗабаланс = ДвиженияЗабалансДляНакладной0504205(МассивОбъектов);
	КонецЕсли;
	
	РезультатЗапроса = ДанныеДляПечати0504205(МассивОбъектов);
	ВыборкаШапка     = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выбрать();
	ВыборкаВсеСтроки = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();

	ПараметрыРаспределенияДвижений = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвижений.ИмяКолонкиКЭК           = "КЭКСсылка";
	ПараметрыРаспределенияДвижений.ИмяКолонкиНоменклатура  = "НоменклатураСсылка";
	ПараметрыРаспределенияДвижений.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("СчетУчета",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КПССсылка",          "КПССсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КЭКСсылка",          "КЭКСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("ДопСубконто",        "ДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "КПССсылка");

	ПараметрыРаспределенияДвиженийЗаб = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиКЭК           = "";
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиНоменклатура  = "НоменклатураСсылка";
	ПараметрыРаспределенияДвиженийЗаб.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("СчетУчета", "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("ДопСубконто",        "ЗабалансовыйДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "НоменклатураСсылка");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Если ВыборкаШапка.ВозвратСХраненияИзПереработки Тогда
			ТабличныйДокумент.Вывести(ОбластьМакетаВозврат);
		КонецЕсли;

		ПараметрыДата = Новый Структура("ДатаЗаголовка", Формат(ВыборкаШапка.Дата, "ДФ='dd MMMM yyyy'") + " г."); 	
		ОбластьМакетаЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		ОбластьМакетаЗаголовок.Параметры.Заполнить(ПараметрыДата);
		Если ВыборкаШапка.ЕстьИзменениеКПППолучатель ИЛИ ВыборкаШапка.ЕстьИзменениеКПППеревозчик Тогда
			ИзмененныеКПП = Новый Структура;
			Если ВыборкаШапка.ЕстьИзменениеКПППолучатель Тогда
				ИзмененныеКПП.Вставить("КПППолучатель", Справочники.Контрагенты.ПолучитьКПП(
					ВыборкаШапка.ПолучательСсылка, ВыборкаШапка.Дата));
			КонецЕсли;
			Если ВыборкаШапка.ЕстьИзменениеКПППеревозчик Тогда
				ИзмененныеКПП.Вставить("КПППеревозчик", Справочники.Контрагенты.ПолучитьКПП(
					ВыборкаШапка.ПеревозчикСсылка, ВыборкаШапка.Дата));
			КонецЕсли;
			ОбластьМакетаЗаголовок.Параметры.Заполнить(ИзмененныеКПП);
		КонецЕсли;

		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(
			ОбластьМакетаЗаголовок, "Номер", ВыборкаШапка.Номер, ВыборкаШапка.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		КоличествоИтого 	= 0;
		СуммаБезНДСИтого 	= 0;
		СуммаНДСИтого 		= 0;
		ВсегоИтого 			= 0;
		КоличествоСтрок 	= 0;
		
		ВыборкаВсеСтроки.Сбросить();
		Если ВыборкаВсеСтроки.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			ВыборкаСтроки = ВыборкаВсеСтроки.Выбрать();
		Иначе
			ВыборкаСтроки = Неопределено;
		КонецЕсли;
		
		Если ВыборкаСтроки <> Неопределено И ПараметрыПечати.ПоСебестоимости Тогда
			ТаблицаДвиженийДокумента = ТаблицаДвижений.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
			ПараметрыРаспределенияДвижений.Организация = ВыборкаШапка.Организация;
			ПараметрыРаспределенияДвижений.ИФО = ВыборкаШапка.ИФО;
			ПараметрыРаспределенияДвижений.КФО = ВыборкаШапка.КФО;
			ПараметрыРаспределенияДвижений.Дата = ВыборкаШапка.Дата;
			ПараметрыРаспределенияДвижений.ВыборкаМатериалы = ВыборкаСтроки;
			ПараметрыРаспределенияДвижений.ТаблицаДвижений = ТаблицаДвиженийДокумента;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвижений);
			ВыборкаСтроки.Сбросить();
			ТаблицаДвиженийДокументаЗаб = ДвиженияЗабаланс.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
			ПараметрыРаспределенияДвиженийЗаб.Организация = ВыборкаШапка.Организация;
			ПараметрыРаспределенияДвиженийЗаб.ИФО = ВыборкаШапка.ИФО;
			ПараметрыРаспределенияДвиженийЗаб.КФО = ВыборкаШапка.КФО;
			ПараметрыРаспределенияДвиженийЗаб.Дата = ВыборкаШапка.Дата;
			ПараметрыРаспределенияДвиженийЗаб.ВыборкаМатериалы = ВыборкаСтроки;
			ПараметрыРаспределенияДвиженийЗаб.ТаблицаДвижений = ТаблицаДвиженийДокументаЗаб;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвиженийЗаб);
			ВыборкаСтроки.Сбросить();
		КонецЕсли;
		
		Пока ВыборкаСтроки <> Неопределено И ВыборкаСтроки.Следующий() Цикл

			КоличествоСтрок = КоличествоСтрок + 1;
			СчетаВСтроке = Новый Структура("Кредит, Дебет", "", "");
			
			Если ЗначениеЗаполнено(ВыборкаСтроки.СчетУчета) Тогда
				СчетаВСтроке.Кредит = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
					ВыборкаСтроки.КПС,
					ВыборкаШапка.КФО,
					ВыборкаСтроки.СчетУчета,
					ВыборкаСтроки.КЭККт,
					Истина);
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ВыборкаСтроки.СчетДебет) Тогда
				СчетаВСтроке.Дебет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
					ВыборкаСтроки.КПСДт,
					ВыборкаШапка.КФО,
					ВыборкаСтроки.СчетДебет,
					ВыборкаСтроки.КЭКДт,
					Истина);
			КонецЕсли;
			
			СтруктураПараметров = Новый Структура("Количество, СуммаБезНДС, СуммаНДС, СуммаВсего, Цена", 0, 0, 0, 0, 0);
			
			Если ПараметрыПечати.ПоСебестоимости Тогда
				
				СтрокиДвижений = ТаблицаДвиженийДокумента.НайтиСтроки(Новый Структура("НомерСтрокиДокумента", ВыборкаСтроки.НомерСтроки));
				
				Если СтрокиДвижений.Количество() > 0 Тогда
					
					СтрокаСебестоимости = СтрокиДвижений[0];
					СтруктураПараметров.Количество = ВыборкаСтроки.Количество;
					
					Если ВыборкаСтроки.Количество = СтрокаСебестоимости.КоличествоОстаток Тогда
						СтруктураПараметров.СуммаВсего = СтрокаСебестоимости.СуммаОстаток;
						СтруктураПараметров.Цена = ?(СтруктураПараметров.Количество = 0, 0, СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток);
					ИначеЕсли СтрокаСебестоимости.КоличествоОстаток > 0 Тогда
						СтруктураПараметров.Цена = Окр(СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток, 2);
						СтруктураПараметров.СуммаВсего = СтруктураПараметров.Цена * СтруктураПараметров.Количество;
					КонецЕсли;
					
					СтруктураПараметров.СуммаБезНДС = СтруктураПараметров.СуммаВсего;
					СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - СтруктураПараметров.Количество;
					СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - СтруктураПараметров.СуммаВсего;
						
				КонецЕсли;

				СтрокиДвиженийЗаб = ТаблицаДвиженийДокументаЗаб.НайтиСтроки(Новый Структура("НомерСтрокиДокумента", ВыборкаСтроки.НомерСтроки));
				Если СтрокиДвиженийЗаб.Количество() > 0 Тогда
					
					Если СтрокиДвижений.Количество() = 0 Тогда
						// Если есть только забалансовые движения, значит в счетах заданые не правильные данные.
						// Сумма в этом случае заполняется из забалансовых проводок
						СтрокаСебестоимости = СтрокиДвиженийЗаб[0];

						СчетаВСтроке.Кредит = "";
						СчетаВСтроке.Дебет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
							СтрокаСебестоимости.КПССсылка,
							ВыборкаШапка.КФО,
							СтрокаСебестоимости.СчетУчета,
							СтрокаСебестоимости.КЭКСсылка);
						
						СтруктураПараметров.Количество = ВыборкаСтроки.Количество;
						
						Если ВыборкаСтроки.Количество = СтрокаСебестоимости.КоличествоОстаток Тогда
							СтруктураПараметров.СуммаВсего = СтрокаСебестоимости.СуммаОстаток;
							СтруктураПараметров.Цена = ?(СтруктураПараметров.Количество = 0, 0, СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток);
						ИначеЕсли СтрокаСебестоимости.КоличествоОстаток > 0 Тогда
							СтруктураПараметров.Цена = Окр(СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток, 2);
							СтруктураПараметров.СуммаВсего = СтруктураПараметров.Цена * СтруктураПараметров.Количество;
						КонецЕсли;
						
						СтруктураПараметров.СуммаБезНДС = СтруктураПараметров.СуммаВсего;
						СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - СтруктураПараметров.Количество;
						СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - СтруктураПараметров.СуммаВсего;
					КонецЕсли;
					
						
				КонецЕсли;
				
			Иначе
				ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаСтроки);
			КонецЕсли;
			
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтроки);
			ОбластьМакетаСтрока.Параметры.Заполнить(СчетаВСтроке);
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураПараметров);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			КоличествоИтого		= КоличествоИтого 	+ СтруктураПараметров.Количество;
			СуммаБезНДСИтого	= СуммаБезНДСИтого	+ СтруктураПараметров.СуммаБезНДС;
			СуммаНДСИтого		= СуммаНДСИтого		+ СтруктураПараметров.СуммаНДС;
			ВсегоИтого			= ВсегоИтого		+ СтруктураПараметров.СуммаВсего;
		
		КонецЦикла; 
		
		СтруктураОбластьМакетаИтого = Новый Структура("КоличествоИтого, СуммаБезНДСИтого, СуммаНДСИтого, СуммаВсегоИтого");
		СтруктураОбластьМакетаИтого.КоличествоИтого		= КоличествоИтого;
		СтруктураОбластьМакетаИтого.СуммаБезНДСИтого	= СуммаБезНДСИтого;
		СтруктураОбластьМакетаИтого.СуммаНДСИтого		= СуммаНДСИтого;
		СтруктураОбластьМакетаИтого.СуммаВсегоИтого		= ВсегоИтого;
		
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		
		СтруктураОбластьМакетаПодвал = Новый Структура("СуммаВсегоИтогоПрописью, ФИОБухгалтер, ПериодЖурнала, ДолжностьОтпустил, ФИООтпустил, ДолжностьПолучил, ФИОПолучил, ДолжностьИсполнитель, ФИОИсполнитель, ТелефонИсполнитель, ЭлАдресИсполнитель");
		СтруктураОбластьМакетаПодвал.СуммаВсегоИтогоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(
			ВсегоИтого, ВалютаРегУчета);
		СтруктураОбластьМакетаПодвал.ПериодЖурнала = Формат(ВыборкаШапка.Дата, "ДФ='MMMM yyyy'"); 
		ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
			ВыборкаШапка.Организация,
			ВыборкаШапка.Дата,
			ВыборкаШапка.Подразделение);
		СтруктураОбластьМакетаПодвал.ФИОБухгалтер	  = КорреспондентыКлиентСервер.ФИО(ГлБухгалтер.ОтветственноеЛицоФИО, Истина);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
			ВыборкаШапка.Отпустил, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		ФИОЦМО = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
			ДанныеСотрудника.Фамилия, ДанныеСотрудника.Имя, ДанныеСотрудника.Отчество), Истина);
		ДолжностьЦМО = ДанныеСотрудника.Должность;
		
		Если ВыборкаШапка.ВозвратСХраненияИзПереработки Тогда
			СтруктураОбластьМакетаПодвал.ФИОПолучил        = ФИОЦМО;
			СтруктураОбластьМакетаПодвал.ДолжностьПолучил  = ДолжностьЦМО;
		Иначе
			
			Если ЗначениеЗаполнено(ВыборкаШапка.ФИОПолучателя) Тогда
