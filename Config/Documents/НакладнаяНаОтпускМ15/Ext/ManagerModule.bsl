// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив из Строка - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	
	// Реквизит "НеПересчитыватьСумму" устанавливается только при загрузке данных
	НеРедактируемыеРеквизиты.Добавить("НеПересчитыватьСумму");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Цена");
	ИменаРеквизитов.Добавить("Сумма");
	ИменаРеквизитов.Добавить("СтавкаНДС");
	ИменаРеквизитов.Добавить("СуммаНДС");
	ИменаРеквизитов.Добавить("Всего");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Сумма");
	Результат.Вставить("ВозвратнаяТара", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Текст запроса таблицы для расчета движений.
// 
// Возвращаемое значение:
//  Строка -  Текст запроса таблицы для расчета движений
Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускМ15Материалы.Ссылка КАК Ссылка,
	|	НакладнаяНаОтпускМ15Материалы.НомерСтроки,
	|	НакладнаяНаОтпускМ15Материалы.Номенклатура,
	|	НакладнаяНаОтпускМ15Материалы.Количество,
	|	НакладнаяНаОтпускМ15Материалы.КПС,
	|	НакладнаяНаОтпускМ15Материалы.Ссылка.КФО КАК КФО,
	|	НакладнаяНаОтпускМ15Материалы.СчетУчета,
	|	НакладнаяНаОтпускМ15Материалы.КЭК,
	|	НакладнаяНаОтпускМ15Материалы.ДополнительнаяАналитикаСчета,
	|	НакладнаяНаОтпускМ15Материалы.Ссылка.Дата КАК Дата,
	|	НакладнаяНаОтпускМ15Материалы.Ссылка.Организация КАК Организация,
	|	НакладнаяНаОтпускМ15Материалы.Ссылка.ИФО КАК ИФО
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
	|ГДЕ
	|	НакладнаяНаОтпускМ15Материалы.Ссылка В (&МассивОбъектов)";
КонецФункции

// Добавить данные для печати накладной0510458.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиНакладной0510458
//  МассивОбъектов - Массив из ДокументСсылка.НакладнаяНаОтпускМ15
Процедура ДобавитьДанныеДляПечатиНакладной0510458(ДанныеДляПечати, МассивОбъектов) Экспорт
	
	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаСоответствиеСчетовПередачиДляНакладной0510458());
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиНакладной0510458());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиНакладной0510458());
	ЧастиЗапроса.Добавить(ТекстЗапросаДвиженияЗабалансДляПечатиНакладнойНаОтпуск0510458());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов()); 
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));
	Запрос.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
	Запрос.УстановитьПараметр("Счет10856", БухгалтерскийУчет.СчетПоКоду("108.56"));
	СчетаПередачи = Новый Массив;
	Счет24 = БухгалтерскийУчет.СчетПоКоду("24");
	Если ЗначениеЗаполнено(Счет24) Тогда
		СчетаПередачи.Добавить(Счет24);
	КонецЕсли;
	Счет25 = БухгалтерскийУчет.СчетПоКоду("25");
	Если ЗначениеЗаполнено(Счет25) Тогда
		СчетаПередачи.Добавить(Счет25);
	КонецЕсли;
	Счет26 = БухгалтерскийУчет.СчетПоКоду("26");
	Если ЗначениеЗаполнено(Счет26) Тогда
		СчетаПередачи.Добавить(Счет26);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаПередачи", СчетаПередачи);
	Запрос.УстановитьПараметр("СчетаМЗ", БухгалтерскийУчет.СчетПоКоду("105.00"));
	Запрос.УстановитьПараметр("Передача24", Перечисления.ВидыПередачиМЗ.ПередачаВДоверительноеУправление);
	Запрос.УстановитьПараметр("Передача25", Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруАренды);
	Запрос.УстановитьПараметр("Передача26", Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруБезвмозмездногоПользования);

	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[3].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаДвиженийЗаб = РезультатЗапроса[5].Выгрузить();
	
	ПроверятьСуммыРезервов = ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
		И ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии");
	ПараметрыРаспределенияДвиженийЗаб = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиКЭК           = "";
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиНоменклатура  = "Номенклатура";
	ПараметрыРаспределенияДвиженийЗаб.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("НоменклатураСсылка", "Номенклатура");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("СчетУчета", "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("ДопСубконто",        "ЗабалансовыйДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "Номенклатура");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеДляПечати.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.ИННОрганизации = ДанныеОрганизации.ИНН;
		СтрокаШапки.КППОрганизации = ДанныеОрганизации.КПП;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.УполномоченноеЛицо) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
				ВыборкаШапка.УполномоченноеЛицо, ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.УполномоченноеЛицоДатаПодписи = ВыборкаШапка.Дата;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.СотрудникОтправитель) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, НаименованиеПолное, Код",
				ВыборкаШапка.СотрудникОтправитель, ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтрокаШапки.ЦМООтправитель = ДанныеСотрудника.НаименованиеПолное;
			СтрокаШапки.ОтпустилДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.ОтпустилФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.ОтпустилДатаПодписи = ВыборкаШапка.Дата;
			СтрокаШапки.УчетныйНомерОтправитель = ДанныеСотрудника.Код;
		КонецЕсли;
		
		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		Если ЗначениеЗаполнено(СтрокаШапки.ПолучилФИО) И СтрНайти(СтрокаШапки.ПолучилФИО, ".") = 0 Тогда
			СтрокаШапки.ПолучилФИО = КорреспондентыКлиентСервер.ФИО(СтрокаШапки.ПолучилФИО);
		КонецЕсли;
		
		ВычислятьСуммуИзДвижений = ВыборкаШапка.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.Реализация И ВыборкаШапка.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаРеализацию;
		ВычислятьСуммуИзДвиженийЗабаланс =
			(ВыборкаШапка.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруБезвмозмездногоПользования
				Или ВыборкаШапка.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруАренды
				Или ВыборкаШапка.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаВДоверительноеУправление)
			И ((ПроверятьСуммыРезервов И НЕ ВыборкаШапка.Резервировать)
				Или Не ПроверятьСуммыРезервов);
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
			Если ВычислятьСуммуИзДвиженийЗабаланс Тогда
				ТаблицаДвиженийДокументаЗаб = ТаблицаДвиженийЗаб.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
				ПараметрыРаспределенияДвиженийЗаб.Организация = ВыборкаШапка.Организация;
				ПараметрыРаспределенияДвиженийЗаб.ИФО = ВыборкаШапка.ИФО;
				ПараметрыРаспределенияДвиженийЗаб.Дата = ВыборкаШапка.Дата;
				ПараметрыРаспределенияДвиженийЗаб.ВыборкаМатериалы = СтрокиДокумента;
				ПараметрыРаспределенияДвиженийЗаб.ТаблицаДвижений = ТаблицаДвиженийДокументаЗаб;
				УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвиженийЗаб);
				СтрокиДокумента.Сбросить();
			КонецЕсли;
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("Группа", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		Всего = 0;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				ГрупповойСчет = ТекущаяГруппаНФА.Группа;
			Иначе
				ГрупповойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			КонецЕсли;
			
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(ГрупповойСчет);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = УправлениеПечатьюБГУ.ЗаголовокТабличнойЧастиДляПечатиНакладной0510458();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.Группа = ГрупповойСчет;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					Если СтрДлина(ТекущаяГруппаНФА.Код) > 4 Тогда
						ЗаголовокТабличнойЧасти.КодГруппыНФА = Сред(ТекущаяГруппаНФА.Код, 5);
					Иначе
						ЗаголовокТабличнойЧасти.КодГруппыНФА = ТекущаяГруппаНФА.Код;
					КонецЕсли;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(ГрупповойСчет, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			Если ВычислятьСуммуИзДвижений Тогда
				Если ВычислятьСуммуИзДвиженийЗабаланс Тогда
					ОтборСтрокиДокумента = Новый Структура("НомерСтрокиДокумента", СтрокиДокумента.НомерСтроки);
					СтрокиДвижений = ТаблицаДвиженийДокументаЗаб.НайтиСтроки(ОтборСтрокиДокумента);
					Если СтрокиДвижений.Количество() > 0 Тогда
						СтрокаСебестоимости = СтрокиДвижений[0];
						НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.СуммаОстаток;
						Если СтрокаСебестоимости.КоличествоОстаток <> 0 Тогда
							НоваяСтрокаСостава.Цена = СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток;
						КонецЕсли;
						СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - НоваяСтрокаСостава.Количество;
						СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - НоваяСтрокаСостава.Сумма;
					Иначе
						Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
							НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
						КонецЕсли;
					КонецЕсли;
				Иначе	
					ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
					СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
					Если СтрокиДвижений.Количество() > 0 Тогда
						СтрокаСебестоимости = СтрокиДвижений[0];
						НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.Сумма;
						НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
					Иначе
						Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
							НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				НоваяСтрокаСостава.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка();
				НоваяСтрокаСостава.СуммаНДС = 0;
				НоваяСтрокаСостава.Всего = НоваяСтрокаСостава.Сумма;
			КонецЕсли;
			Всего = Всего + НоваяСтрокаСостава.Всего;
		КонецЦикла;
		
		СтрокаШапки.Всего = Всего;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.Группа);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		СтрокаШапки.СоставДокумента = ДанныеТабличныхЧастейДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

