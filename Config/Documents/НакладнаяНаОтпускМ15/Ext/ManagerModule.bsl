			КонецЕсли;
			
			КоличествоСтрок = КоличествоСтрок + 1;
		
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтроки);
			пКорСчет = "" + ВыборкаШапка.КФО;
			пКорСчет = пКорСчет + ?(ПустаяСтрока(пКорСчет), "", ".")
				+ ?(ЗначениеЗаполнено(ВыборкаСтроки.СчетУчета), ВыборкаСтроки.СчетУчета, БухгалтерскиеОперацииПовтИсп.СчетУчетаСсылкаИзНоменклатуры(ВыборкаСтроки.Номенклатура));
			ОбластьМакетаСтрока.Параметры.Заполнить(Новый Структура("пСчетКредита", пКорСчет));
			
			СтруктураПараметров = Новый Структура("пКоличество, пСуммаБезНДС, пСуммаНДС, пВсего, пЦена", 0, 0, 0, 0, 0);
			Если ПараметрыПечати.ПоСебестоимости Тогда
				
				Отбор = Новый Структура("Ссылка, СчетУчета, Номенклатура, КПС");
				ЗаполнитьЗначенияСвойств(Отбор, ВыборкаСтроки);
				СтрокиДвижений = ТаблицаДвижений.НайтиСтроки(Отбор);
				Если СтрокиДвижений.Количество() > 0 Тогда
					
					СтрокаСебестоимости = СтрокиДвижений[0];
					СтруктураПараметров.пКоличество = ВыборкаСтроки.пКоличество;
					Если ВыборкаСтроки.пКоличество = СтрокаСебестоимости.КоличествоОстаток Тогда
						СтруктураПараметров.пВсего = СтрокаСебестоимости.СуммаОстаток;
						СтруктураПараметров.пЦена = ?(СтруктураПараметров.пКоличество = 0, 0, СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток);
					ИначеЕсли СтрокаСебестоимости.КоличествоОстаток > 0 Тогда
						СтруктураПараметров.пЦена = Окр(СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток, 2);
						СтруктураПараметров.пВсего = СтруктураПараметров.пЦена * СтруктураПараметров.пКоличество;
					КонецЕсли;
					СтруктураПараметров.пСуммаБезНДС = СтруктураПараметров.пВсего;
					СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - СтруктураПараметров.пКоличество;
					СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - СтруктураПараметров.пВсего;
						
				КонецЕсли;
				
			Иначе
				ЗаполнитьЗначенияСвойств(СтруктураПараметров, ВыборкаСтроки);
			КонецЕсли;
			
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураПараметров);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			КоличествоИтого		= КоличествоИтого 	+ СтруктураПараметров.пКоличество;
			СуммаБезНДСИтого	= СуммаБезНДСИтого	+ СтруктураПараметров.пСуммаБезНДС;
			СуммаНДСИтого		= СуммаНДСИтого		+ СтруктураПараметров.пСуммаНДС;
			ВсегоИтого			= ВсегоИтого		+ СтруктураПараметров.пВсего;
			
		
		КонецЦикла; 
		СтруктураОбластьМакетаИтого = Новый Структура("пКоличествоИтого,пСуммаБезНДСИтого,пСуммаНДСИтого,пВсегоИтого");
		СтруктураОбластьМакетаИтого.пКоличествоИтого	= КоличествоИтого;
		СтруктураОбластьМакетаИтого.пСуммаБезНДСИтого	= СуммаБезНДСИтого;
		СтруктураОбластьМакетаИтого.пСуммаНДСИтого		= СуммаНДСИтого;
		СтруктураОбластьМакетаИтого.пВсегоИтого		= ВсегоИтого;
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		
		СтруктураОбластьМакетаПодвал = Новый Структура("пКоличествоНаименованийПрописью,пВсегоИтогоПрописью,пСуммаНалогов,пДолжностьРуководитель,пФИОРуководитель,пФИОБухгалтер");
		СтруктураОбластьМакетаПодвал.пКоличествоНаименованийПрописью = ЧислоПрописью(КоличествоСтрок,,"наименование,наименования,наименований,с,,,,,0");
		
		СтруктураОбластьМакетаПодвал.пВсегоИтогоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВсегоИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		СтруктураОбластьМакетаПодвал.пСуммаНалогов = "в том числе сумма НДС: " 
														+ ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаНДСИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
											Руководитель.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пДолжностьРуководитель = ДанныеСотрудника.Должность;
		СтруктураОбластьМакетаПодвал.пФИОРуководитель = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
		ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											ГлБухгалтер.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пФИОБухгалтер	  = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьМакетаПодвал);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
	
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьАктаПриемаПередачи0504101(МассивОбъектов, ОбъектыПечати, ПараметрыВывода)

	ДанныеДокументов = ДанныеДляПечати0504101(МассивОбъектов, ПараметрыВывода.ПоСебестоимости);
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов", ДанныеДокументов[0].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаОС",         ДанныеДокументов[1].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаКомиссия",   ДанныеДокументов[2].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаДвижения",   ДанныеДокументов[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	ДополнительныеХарактеристики = Новый Структура("ЕГРН, ПТС, Характеристики");
	ДополнительныеХарактеристики.Вставить("Драгметаллы", ДанныеДокументов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Справочники.ОсновныеСредства.ИнициализироватьПараметрыДопХарактеристик(ДополнительныеХарактеристики);
	
	Возврат УправлениеПечатьюБГУ.Вывести0504101вТабличныйДокумент(ДанныеДляПечати, ОбъектыПечати, ДополнительныеХарактеристики, ПараметрыВывода.Редакция);
	
КонецФункции

Функция ДанныеДляПечати0504101(МассивОбъектов, ПоСебестоимости)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ПоСебестоимости Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) = ""24""
		|			ТОГДА &Передача24
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) = ""25""
		|			ТОГДА &Передача25
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) = ""26""
		|			ТОГДА &Передача26
		|	КОНЕЦ КАК ВидПередачи,
		|	ПОДСТРОКА(ЕПСБУ.Код, 4, 1) КАК ПодКод,
		|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС,
		|	ЕПСБУ.УчетПоКЭК КАК УчетПоКЭК
		|ПОМЕСТИТЬ СчетаПередачи
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетаПередачи)
		|	И НЕ ЕПСБУ.ЭлементГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) В (""2"", ""А"", ""Б"")
		|			ТОГДА ""2""
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) В (""3"", ""В"", ""Г"")
		|			ТОГДА ""3""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ПодКод
		|ПОМЕСТИТЬ СчетаУчета
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетаМЗ)
		|	И НЕ ЕПСБУ.ЭлементГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетаУчета.Ссылка КАК СчетУчета,
		|	СчетаПередачи.Ссылка КАК СчетПередачи,
		|	СчетаПередачи.ВидПередачи КАК ВидПередачи,
		|	СчетаПередачи.УчетПоКПС КАК УчетПоКПС,
		|	СчетаПередачи.УчетПоКЭК КАК УчетПоКЭК
		|ПОМЕСТИТЬ СоответствиеСчетов
		|ИЗ
		|	СчетаУчета КАК СчетаУчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаПередачи КАК СчетаПередачи
		|		ПО (СчетаПередачи.ПодКод = СчетаУчета.ПодКод)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетУчета,
		|	ВидПередачи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НакладнаяНаОтпускМ15.Ссылка КАК Ссылка,
		|	НакладнаяНаОтпускМ15.Дата КАК Дата,
		|	НакладнаяНаОтпускМ15.Организация КАК Организация,
		|	НакладнаяНаОтпускМ15.ИФО КАК ИФО,
		|	НакладнаяНаОтпускМ15.КФО КАК КФО
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
		|ГДЕ
		|	НакладнаяНаОтпускМ15.Ссылка В(&МассивОбъектов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НакладнаяНаОтпускМ15Материалы.Ссылка КАК Ссылка,
		|	НакладнаяНаОтпускМ15Материалы.Номенклатура КАК НоменклатураСсылка,
		|	НакладнаяНаОтпускМ15Материалы.Количество КАК Количество,
		|	НакладнаяНаОтпускМ15Материалы.Сумма КАК Сумма,
		|	НакладнаяНаОтпускМ15Материалы.КПС КАК КПССсылка,
		|	НакладнаяНаОтпускМ15Материалы.КЭК КАК КЭКСсылка,
		|	НакладнаяНаОтпускМ15Материалы.СчетУчета КАК СчетУчета,
		|	НакладнаяНаОтпускМ15Материалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
		|	НакладнаяНаОтпускМ15Материалы.НомерСтроки КАК НомерСтроки,
		|	СоответствиеСчетов.СчетПередачи КАК ЗабалансовыйСчетУчета,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СоответствиеСчетов.УчетПоКПС, ЛОЖЬ)
		|			ТОГДА НакладнаяНаОтпускМ15Материалы.КПС
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
		|	КОНЕЦ КАК ЗабалансовыйКПС,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СоответствиеСчетов.УчетПоКЭК, ЛОЖЬ)
		|			ТОГДА НакладнаяНаОтпускМ15Материалы.КЭК
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|	КОНЕЦ КАК ЗабалансовыйКЭК,
		|	НакладнаяНаОтпускМ15.Контрагент КАК ЗабалансовыйДополнительнаяАналитикаСчета
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
		|		ПО НакладнаяНаОтпускМ15Материалы.Ссылка = НакладнаяНаОтпускМ15.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
		|		ПО НакладнаяНаОтпускМ15Материалы.СчетУчета = СоответствиеСчетов.СчетУчета
		|			И (НакладнаяНаОтпускМ15.ВидПередачиМЗ = СоответствиеСчетов.ВидПередачи)
		|ГДЕ
		|	НакладнаяНаОтпускМ15Материалы.Ссылка В(&МассивОбъектов)
		|ИТОГИ ПО
		|	Ссылка";
		СчетаПередачи = Новый Массив;
		Счет24 = БухгалтерскийУчет.СчетПоКоду("24");
		Если ЗначениеЗаполнено(Счет24) Тогда
			СчетаПередачи.Добавить(Счет24);
		КонецЕсли;
		Счет25 = БухгалтерскийУчет.СчетПоКоду("25");
		Если ЗначениеЗаполнено(Счет25) Тогда
			СчетаПередачи.Добавить(Счет25);
		КонецЕсли;
		Счет26 = БухгалтерскийУчет.СчетПоКоду("26");
		Если ЗначениеЗаполнено(Счет26) Тогда
			СчетаПередачи.Добавить(Счет26);
		КонецЕсли;
		Запрос.УстановитьПараметр("СчетаПередачи", СчетаПередачи);
		Запрос.УстановитьПараметр("СчетаМЗ", БухгалтерскийУчет.СчетПоКоду("105.00"));
		
