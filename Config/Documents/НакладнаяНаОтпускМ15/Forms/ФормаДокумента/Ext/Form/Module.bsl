&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или (Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета
			И Не ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня)
		Или ((УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
				Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект)) 
			И УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
				ЭтотОбъект.КэшПараметров.Дата,
				ЭтотОбъект.КэшПараметров.Организация,
				Объект.Дата,
				Объект.Организация));
	
	Если ТребуетсяВызовСервера Тогда
		
		ДатаПриИзмененииНаСервере();
		
		БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса,
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьВалютаДляКонтроляКурса);
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	ОбновитьСрокОтправкиУведомлений = Истина;
	ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленииОПеремещении", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	КонецЕсли;
	
	Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект) Тогда
			
		УправлениеМатериальнымиЗапасами.ОбработатьИзменениеПримененияДетальногоКЭК340и440(ЭтотОбъект,
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация);
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ЗаполнитьОтветственныеЛица(Объект);
		УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
		ЗаполнитьСчетаУчетаМЗПоОрганизации();
		ЗаполнитьВсеСчета106();
		УправлениеМатериальнымиЗапасами.УстановитьОграниченияСчетовДляВыбораТары(Элементы.ВозвратнаяТараСчетУчета);
		УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(
			Элементы.ВозвратнаяТараДополнительнаяАналитикаСчета, ВсеСчета105);
		УстановитьСчетаВЛокальныйКэшФормы();
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьСчетаУчетаМЗПоОрганизации();
	УстановитьСчетаВЛокальныйКэшФормы();
	ЗаполнитьОтветственныеЛица(Объект);	
	ЗаполнитьСведенияОПриемкеПередачеПоставщикаДляУПД();
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
	РеализацияВЕАЭС = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ВидКонтрагента");
	УстановитьВидимостьЭлементовЧековККМ(ЭтотОбъект, ВидКонтрагента);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));

	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	ВидимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(Объект.Контрагент, Объект.Организация);
	
	ВидимостьЭлементовМаркировки = ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(Объект.Организация);
	Если Объект.КодыУпаковокМаркируемойПродукции.Количество()>0 Тогда
		ВидимостьЭлементовМаркировки = Истина;
	КонецЕсли;
	
	ЕстьПравоСозданиеЭТрН = ПравоДоступа("Изменение", Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная);
	НастроенОбменЭПД = ЭлектронныеДокументыБГУ.ДокументооборотЭПДНастроен(Объект.Организация, Объект.Контрагент, ВидимостьЭлементовЭДО);
	Если НастроенОбменЭПД Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(ЭтотОбъект);
	КонецЕсли;
	
	ВидимостьЭлементовАктирования = ЭлектронноеАктированиеБГУ.ВидимостьЭлементовАктирования(Объект.Организация, Объект.Договор);
	УстановитьВидимостьЭлементовЭДО(ЭтаФорма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхЭДОПродавцаДляГосНужд, ВидимостьЭлементовАктирования);
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения,ОплатаВстречнымПредоставлением"); 
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидПередачиМЗ);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		
		Объект.ОплатаВстречнымПредоставлением = ?(РеквизитыДоговора.ОплатаВстречнымПредоставлением = Истина, Истина, Ложь);
		
		ВидимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(Объект.Контрагент, Объект.Организация);
		ЗаполнитьДанныеЭДОПродавцаДляГосНужд(ВидимостьДанныхЭДОПродавцаДляГосНужд);
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		ЭлектронноеАктированиеБГУ.ПриИзмененииКлючевыхРеквизитовЭлектронногоАктирования(ЭтотОбъект);
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
		ВидимостьЭлементовМаркировки = ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(Объект.Организация);
		ВидимостьЭлементовАктирования = ЭлектронноеАктированиеБГУ.ВидимостьЭлементовАктирования(Объект.Организация, Объект.Договор);
		Если Не ВидимостьЭлементовЭДО Тогда
			ВидимостьЭлементовЭДО = ВидимостьЭлементовАктирования;
		КонецЕсли;
		УстановитьВидимостьЭлементовЭДО(ЭтаФорма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхЭДОПродавцаДляГосНужд, ВидимостьЭлементовАктирования);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.ДокументОснование = ЭтотОбъект.КэшПараметров.Локальные.ДокументОснование;
		Возврат;
	КонецЕсли;
	
	ПриИзмененииДокументаОснования();

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииДокументаОснования()

	ДоступностьВалюты(ЭтотОбъект);
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ЗаполнитьПоДокументуОснованию(Объект.ДокументОснование);
	КонецЕсли;

КонецПроцедуры // ПриИзмененииДокументаОснования()

&НаКлиенте
Процедура ПриИзмененииСчетаУчета(Результат, Параметры) Экспорт
	
	ТребуетсяНапоминаниеОбУведомленииОПеремещении();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьПризнакФормыДополнительноеСубконто3(ЭтотОбъект);
	УстановитьВидимостьДопСубконто3(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.Материалы Цикл
			
			РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Сумма");
			
		КонецЦикла;
		РассчитатьСуммуДокумента();
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ТипЦены <> Объект.ТипЦены Тогда
		
		Если Объект.Материалы.Количество() = 0 ИЛИ Не ЗначениеЗаполнено(Объект.ТипЦены) Тогда
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Изменился тип цены.
							|Пересчитать цены в таблице документа?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Да, пересчитать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Нет, не пересчитывать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не изменять тип цены");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ТипЦеныПриИзмененииЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Отмена);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПересчитатьЦеныНоменклатуры();
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Нет Тогда
		Объект.ТипЦены = ЭтотОбъект.КэшПараметров.Локальные.ТипЦены;
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РеализацияПоСтавке0ПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьРеализацияПоСтавке0Истина();
	Иначе
		УстановитьРеализацияПоСтавке0Ложь()
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеализацияПоСтавке0Ложь()

	Объект.РеализацияПоСтавке0 = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеализацияПоСтавке0Истина()

	Для каждого ТекСтр Из Объект.Материалы Цикл
	
		ТекСтр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
		РасчитатьСтроку(ТекСтр, Объект.СуммаВключаетНДС, "СтавкаНДС");
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтавкиНДССтрокИзНоменклатуры(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		УстановитьСтавкиНДСИзНоменклатурыНаСервере();
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура УстановитьСтавкиНДСИзНоменклатурыНаСервере()

	ВсяНоменклатура = Новый Массив;
	Для Каждого ТекСтр Из Объект.Материалы Цикл
		ВсяНоменклатура.Добавить(Текстр.Номенклатура);
	КонецЦикла;
	
	СтавкиНДСНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ВсяНоменклатура, "СтавкаНДС");
	
	Для Каждого ТекСтр Из Объект.Материалы Цикл
		СтавкаНДСТекНоменклатуры = СтавкиНДСНоменклатуры.Получить(ТекСтр.Номенклатура);
		Если СтавкаНДСТекНоменклатуры <> Неопределено Тогда
			ТекСтр.СтавкаНДС = СтавкаНДСТекНоменклатуры.СтавкаНДС;
			РасчитатьСтроку(ТекСтр, Объект.СуммаВключаетНДС, "Цена");
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтрокиНаСервере(ИдентификаторСтроки)

	ТекущиеДанные = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	РеквизитыНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры,
		"ПрослеживаемыйТовар, КомплектСПрослеживаемымиТоварами, СтранаПроисхождения, ТипНоменклатуры");

	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(
		ТекущиеДанные, РеквизитыНоменклатуры.ТипНоменклатуры);
	ЗаполнятьПоДокументуПоступления = (Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику
			Или Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику)
		И Документы.НакладнаяНаОтпускМ15.ПроверитьЗаполнениеДокументаОснования(Объект)
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеМЗ");
	ЗаполнятьСчет = Истина;
	Если ЗаполнятьПоДокументуПоступления Тогда
		ЗаполнитьРеквизитыСтрокиИзПоступления(ТекущиеДанные);
		ЗаполнятьСчет = Ложь;
	Иначе
		ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.ТипЦены, Объект.Дата,
			Объект.Организация);
		РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Сумма");
	КонецЕсли;
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, ЗаполнятьСчет, Истина);

	ТекущиеДанные.МаркируемыйТовар = МаркируемыйТовар(ТекущиеДанные.ПолучитьИдентификатор());
	ТекущиеДанные.МаркируемыйТоварОбъемноСортовогоУчета = МаркируемыйТоварОбъемноСортовогоУчета(
		ТекущиеДанные.ПолучитьИдентификатор());
		
	Если ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыСтрокиИзПоступления(СтрокаДокумента)
	
	ТаблицаОснования = Документы.НакладнаяНаОтпускМ15.ПолучитьТаблицуПоступления(Объект);
	СтрокиНоменклатуры = ТаблицаОснования.НайтиСтроки(Новый Структура("Номенклатура", СтрокаДокумента.Номенклатура));
	Если СтрокиНоменклатуры.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокиНоменклатуры[0], , "НДСКРаспределению, ПринятьНДСКВычету");
		Если Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокиНоменклатуры[0], "НДСКРаспределению, ПринятьНДСКВычету");
		КонецЕсли;
		Если СтрокаДокумента.Количество <> 0 Тогда
			СтрокаДокумента.Цена = СтрокаДокумента.Сумма / СтрокаДокумента.Количество;
		КонецЕсли;
	ИначеЕсли Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.РезервВозвратПоставщику Тогда
		Если СтрокиНоменклатуры.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Выбранная номенклатура отсутствует в документе поставки'"));
		Иначе
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Выбранная номенклатура присутствует в документе поставки несколько раз.
					|Рекомендуется перезаполнить документ по документу поставки и удалить лишние строки.'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

