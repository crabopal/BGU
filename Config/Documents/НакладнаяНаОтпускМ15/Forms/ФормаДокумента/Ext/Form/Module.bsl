		Оповещение = Новый ОписаниеОповещения("ВопросПересчитатьДатуОплатитьДо", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Пересчитать крайний срок оплаты (предельную дату исполнения) от даты подписания?'"), РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("Тип") Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
			ТекстВопроса = НСтр("ru='Документ будет заполнен по документу поступления?'");
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			ТекстВопроса = НСтр("ru='Документ будет заполнен по документу ""Счет на оплату""?'");
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			ТекстВопроса = НСтр("ru='Документ будет заполнен по передаче на хранение (в переработку)?'");
		КонецЕсли;
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Заполнить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отменить выбор документа'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументОснованиеПриИзмененииЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки,,КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;
	
	ПриИзмененииДокументаОснования();
	
КонецПроцедуры

