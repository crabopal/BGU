&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовПередачи(Форма)

	Объект = Форма.Объект;
	
	ЭтоРеализация = (Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.Реализация"));
	ЭтоВозвратПоставщику = (Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратПоставщику"));
	ВидимостьРеквизитаКомиссионнаяТорговля = ВидимостьРеквизитаКомиссионнаяТорговля(Форма);
	ВидимостьРеквизитовПоКомитенту = ВидимостьРеквизитовПоКомитенту(Форма);
	ВидимостьЦМО                  = ВидимостьЦМО(Форма);
	ВидимостьРеквизитовПередачи   = ВидимостьРеквизитовПередачи(Форма);
	ВидимостьРеквизитовПередачиДС = ВидимостьРеквизитовПередачиДС(Форма);
	ВидимостьРеквизитовВозвратаДС = ВидимостьРеквизитовВозвратаДС(Форма);
	ОбязательностьЦМОПриПередаче  = ОбязательностьЦМОПриПередаче(Форма);
	ЗаголовокСтраницаПередачи     = ЗаголовокСтраницаПередачи(Форма);
	ЗаголовокСтраницаВозврата     = ЗаголовокСтраницаВозврата(Форма);
	ЗаголовокГруппаПолучатель     = ЗаголовокГруппаПолучатель(Форма);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПолучатель",
		"Заголовок", ЗаголовокГруппаПолучатель);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтраницаПередача",
		"Заголовок", ЗаголовокСтраницаПередачи);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ВозвратСХраненияИзПереработки",
		"Заголовок", ЗаголовокСтраницаВозврата);
	
	ИменаЭлементовЦМО = Новый Массив;
	ИменаЭлементовЦМО.Добавить("ЦМО");
	ИменаЭлементовЦМО.Добавить("Подразделение");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовЦМО,
		"Видимость", ВидимостьЦМО);
	
	ИменаЭлементовПередачи = Новый Массив;
	ИменаЭлементовПередачи.Добавить("МатериалыЦена");
	ИменаЭлементовПередачи.Добавить("МатериалыСуммаБезНДС");
