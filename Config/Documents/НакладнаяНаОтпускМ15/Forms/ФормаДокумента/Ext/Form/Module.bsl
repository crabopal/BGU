	ИменаЭлементовПередачиСКорректировкой.Добавить("МатериалыЦена1");
	ИменаЭлементовПередачиСКорректировкой.Добавить("МатериалыСуммаНДСДоКорректировки");
	ИменаЭлементовПередачиСКорректировкой.Добавить("МатериалыСуммаДоКорректировки");
	ИменаЭлементовПередачиСКорректировкой.Добавить("МатериалыВсегоДоКорректировки");
	ИменаЭлементовПередачиСКорректировкой.Добавить("ВозвратнаяТараСуммаДоКорректировки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПередачиСКорректировкой,
		"Видимость", ВидимостьРеквизитовПередачи И Объект.ЭтоКорректировка);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыКоличество",
		"Видимость", НЕ Объект.ЭтоКорректировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыЦена",
		"Видимость", ВидимостьРеквизитовПередачи(ЭтотОбъект) И НЕ Объект.ЭтоКорректировка);
	
	Если Не Объект.ЭтоКорректировка Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
			"ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
			"АвтоотметкаНезаполненного", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ВестиУчетПоРеализацииТоваровУслугКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов");
	ВестиУчетПоЗакупкеТоваровУслугДляКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугДляКомитентов");
	ДанныеСчетовВФорме = Неопределено;
	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ЗаполнитьСчетаУчетаМЗПоОрганизации(ДанныеСчетовВФорме);
	ЗаполнитьВсеСчета106();
	УправлениеМатериальнымиЗапасами.УстановитьТипНоменклатурыВСтрокахДляБиологическихАктивов(Объект.Материалы);
	УправлениеМатериальнымиЗапасами.УстановитьОграниченияСчетовДляВыбораТары(Элементы.ВозвратнаяТараСчетУчета);
	УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(
		Элементы.ВозвратнаяТараДополнительнаяАналитикаСчета, ВсеСчета105);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ДанныеСчетовВФорме);
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьПризнакФормыДополнительноеСубконто3(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьТекстЗаголовковКорректировкиВТаблице(Объект.Материалы);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьТекстЗаголовковКорректировкиВТаблице(Объект.ВозвратнаяТара);
	УстановитьОграниченияТиповДокументаОснования(ЭтотОбъект, Объект);
	УстановитьДоступностьИзмененияСчетовУчета(ЭтотОбъект, Объект);
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьВидимостьЭлементовЗагруженногоДокумента(ЭтотОбъект, "Материалы");
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьВидимостьЭлементовЗагруженногоДокумента(ЭтотОбъект, "ВозвратнаяТара");
	
	РеализацияВЕАЭС = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	ТребуетсяНапоминаниеУведомленийОПеремещении = ТребуетсяНапоминаниеОбУведомленииОПеремещении();
	УстановитьПредставлениеНадписиУведомлениеОПеремещении();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей,
		Объект.ВидПередачиМЗ);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	УстановитьДоступностьЦМОПодразделение(ЭтотОбъект);
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьОбязательностьКонтрагента(ЭтотОбъект);
	УстановитьОбязательностьДоговора(ЭтотОбъект);
	ДоступностьВалюты(ЭтотОбъект);
	УстановитьВидимостьРеквизитовПередачи(ЭтотОбъект);
	УстановитьВидимостьВидаПользования(ЭтотОбъект);
	УстановитьВидимостьЭлементовКомиссии(ЭтотОбъект);
	УстановитьВидимостьДопСубконто3(ЭтотОбъект);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект);

	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ВидКонтрагента");
	Иначе
		ВидКонтрагента = Перечисления.ЮрФизЛицо.ПустаяСсылка();
	КонецЕсли;
	УстановитьВидимостьЭлементовЧековККМ(ЭтотОбъект, ВидКонтрагента);

КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ДанныеСчетовВФорме = Неопределено)
	ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
		ЭтотОбъект, Объект);
	ПараметрыЗаполненияКолонок.Включать106 = Истина;
	ПараметрыЗаполненияКолонок.Включать113 = Истина;
	
	Если ВестиУчетПоРеализацииТоваровУслугКомитентов Тогда
		ПараметрыЗаполненияКолонок.Включать0233 = Истина;
	КонецЕсли;
	
	ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
	УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);

	ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
		ЭтотОбъект, Объект);
	ПараметрыЗаполненияКолонок.ИмяТаблицы = "ВозвратнаяТара";
	ПараметрыЗаполненияКолонок.Включать106 = Истина;
	ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
	УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);
КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора(ИмяТаблицы)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",				Объект.СчетУчета);	
	ПараметрыПодбора.Вставить("КФО",					Объект.КФО);
	Если Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки")
		ИЛИ Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию")Тогда
		ПараметрыПодбора.Вставить("ЦМО", 				Объект.ЦМОПриПередаче);
		ПараметрыПодбора.Вставить("Подразделение",		Объект.ПодразделениеПриПередаче);
	Иначе
		ПараметрыПодбора.Вставить("ЦМО", 				Объект.ЦМО);
		ПараметрыПодбора.Вставить("Подразделение",		Объект.Подразделение);
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДополнитьСчетом113", Истина);
	
	ПараметрыПодбора.Вставить("ДополнитьСчетом0233", ВестиУчетПоРеализацииТоваровУслугКомитентов);
	
	Если ВестиУчетПоЗакупкеТоваровУслугДляКомитентов 
		И Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратПоставщику") Тогда
		ПараметрыПодбора.Вставить("ДополнитьСчетом0234", Истина);
	Иначе
		ПараметрыПодбора.Вставить("ДополнитьСчетом0234", Ложь);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	Если ИмяТаблицы = "Материалы" Тогда
		ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	
		ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер
			.ДополнительнаяАналитикаСчетаУчетаМатериалов(Объект.СчетУчета, Объект.Организация);
		Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
			ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
		КонецЕсли;
		
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
	Иначе
		ПараметрыПодбора.Вставить("ИмяТаблицы",				"ВозвратнаяТара");
		ПараметрыПодбора.Вставить("ПредставлениеТаблицы",	"Возвратная тара");
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	КонецЕсли;
	
	Если СчетУчета27(ЭтотОбъект) Тогда
		ПараметрыПодбора.Вставить("ПодборОстатковВПользовании", Истина);
		ПараметрыПодбора.Вставить("ДатаРасчетов", Объект.Дата);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("Валюта",					Объект.ВалютаДокумента);
	
	ЭтоПодборСчета106 = УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект);
	Если НЕ ЭтоПодборСчета106 Тогда
		ПараметрыПодбора.Вставить("ЕстьЦена",			Истина);
		ПараметрыПодбора.Вставить("ПоказыватьЦены",		Истина);
		ПараметрыПодбора.Вставить("ТипЦен",				Объект.ТипЦены);
	КонецЕсли;
	ПараметрыПодбора.Вставить("ЭтоПодборСчета106",		ЭтоПодборСчета106);
	Возврат ПараметрыПодбора;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчета27(Форма)

	Возврат Форма.КэшПараметров.Локальные.Счета27.Найти(Форма.Объект.СчетУчета) <> Неопределено;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЦМОПодразделение(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ЦМО");
	ИменаЭлементов.Добавить("Подразделение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Контрагент));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьКонтрагента(Форма)

	МожноПустой = Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаНаСторону")
		ИЛИ Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку")
		ИЛИ Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию")
		ИЛИ Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки");
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Контрагент",
		"АвтоотметкаНезаполненного", НЕ МожноПустой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Контрагент",
		"ОтметкаНезаполненного", НЕ МожноПустой И НЕ ЗначениеЗаполнено(Форма.Объект.Контрагент));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьДоговора(Форма)

	ЗаполнятьОбязательно = 
		Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.РезервВозвратПоставщику")
		Или Форма.Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратПоставщику");
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"АвтоотметкаНезаполненного", ЗаполнятьОбязательно);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"ОтметкаНезаполненного", ЗаполнятьОбязательно И НЕ ЗначениеЗаполнено(Форма.Объект.Договор));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();	
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Процедура ПересчитатьЦеныНоменклатуры()

	МассивНоменклатуры = Объект.Материалы.Выгрузить(, "Номенклатура");
	ТаблицаЦен = ПолучитьЦенуНоменклатуры(МассивНоменклатуры.ВыгрузитьКолонку("Номенклатура"),
		Объект.ТипЦены, Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.Материалы Цикл
	
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрока.Номенклатура, "Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			ТекСтрока.Цена = СтрокаЦены.Цена;
		Иначе
			ТекСтрока.Цена = 0;
		КонецЕсли;
		РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла; 

КонецПроцедуры // ПересчитатьЦеныНоменклатуры()

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение, ИмяТаблицы)
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	СчетТоваровНаКомиссии = БухгалтерскийУчет.СчетПоКоду("02.33", Объект.Дата, Объект.Организация);
	
	СчетТоваровЗакупкаПоКомиссии = БухгалтерскийУчет.СчетПоКоду("02.34", Объект.Дата, Объект.Организация);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект[ИмяТаблицы].Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаМатериалы, Ложь, ИмяТаблицы = "Материалы");
			КонецЕсли;
			
			Если ИмяТаблицы = "Материалы" Тогда
				Если ЗначениеЗаполнено(СтрокаМатериалы.СчетУчета)Тогда
					Если СтрокаМатериалы.СчетУчета = СчетТоваровНаКомиссии ИЛИ СтрокаМатериалы.СчетУчета = СчетТоваровЗакупкаПоКомиссии Тогда
						СтрокаМатериалы.КомиссионнаяТорговля = Истина;
					Иначе
						СтрокаМатериалы.КомиссионнаяТорговля = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ИмяТаблицы = "Материалы" Тогда
				Если Объект.РеализацияПоСтавке0 Тогда
					СтрокаМатериалы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
				КонецЕсли;
				РасчитатьСтроку(СтрокаМатериалы, Объект.СуммаВключаетНДС, "Сумма");
			КонецЕсли;
		КонецЦикла;
		
		Объект[ИмяТаблицы].Загрузить(ВтМатериалы);
		РассчитатьСуммуДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет, ВключатьСчет106)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.ЗаполнятьСчет = ЗаполнятьСчет;
	ПараметрыОбработки.Включать106   = ВключатьСчет106;
	ПараметрыОбработки.Включать113   = Истина;
	ПараметрыОбработки.Включать0233  = Истина;
	ПараметрыОбработки.ДтКт          = "Кт";
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ДокументОбъект.ЗаполнитьПоПоступлению(ДокументОснование);
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ДокументОбъект.ЗаполнитьПоСчету(ДокументОснование);
	ИначеЕсли Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию Тогда
		ДокументОбъект.ЗаполнитьПоПередачеНаРеализацию(ДокументОснование);
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ДокументОбъект.ЗаполнитьПоПередачеНаХранениеВПереработку(ДокументОснование);
	Иначе
		Возврат;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	РассчитатьСуммуДокумента();
	
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы();
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект);

КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

&НаСервере
Процедура ЗаполнитьСчетаУчетаМЗПоОрганизации(ДанныеСчетовВФорме = Неопределено)

	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Истина;
	ПараметрыЗаполненияСчета.Включать0233 = ВестиУчетПоРеализацииТоваровУслугКомитентов;
	Если Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику Тогда
		ПараметрыЗаполненияСчета.Включать0234 = ВестиУчетПоЗакупкеТоваровУслугДляКомитентов;
	КонецЕсли;
	ПараметрыЗаполненияСчета.Включать106 = Истина;
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);
	
	Для Каждого НастройкаСчета Из ДанныеСчетовВФорме Цикл
		Если ЗначениеЗаполнено(НастройкаСчета.ДополнительноеСубконто3) Тогда
			СчетаДопСубконто3.Добавить(НастройкаСчета.Счет);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьВалюты(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ВалютаДокумента",
		"Доступность", Не ЗначениеЗаполнено(Форма.Объект.ДокументОснование));

КонецПроцедуры // ДоступностьВалюты()

&НаСервере
Процедура РассчитатьСуммуДокумента()
	Объект.СуммаДокумента = Объект.Материалы.Итог("Всего")+Объект.ВозвратнаяТара.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтотОбъект, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

