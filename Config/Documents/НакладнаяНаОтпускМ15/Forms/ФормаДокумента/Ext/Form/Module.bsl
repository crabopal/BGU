	ИменаЭлементовПередачи.Добавить("ДекорацияПустая2");
	ИменаЭлементовПередачи.Добавить("МатериалыИтогСуммаНДС1");
	ИменаЭлементовПередачи.Добавить("НадписьВалютаНДС");
	ИменаЭлементовПередачи.Добавить("МатериалыИтог");
	ИменаЭлементовПередачи.Добавить("ВалютаИтогов");
	ИменаЭлементовПередачи.Добавить("ВозвратнаяТараИтогСумма");
