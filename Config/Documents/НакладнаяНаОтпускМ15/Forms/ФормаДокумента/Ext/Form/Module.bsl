КонецПроцедуры // ЗаполнитьКПСнаСервере()

&НаСервере
Процедура ЗаполнитьВсеСчета106()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = ""106.2П"" ИЛИ ЕПСБУ.Код = ""106.3П""";
	ВсеСчета106.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОграниченияТиповДокументаОснования(Форма, Объект)

	МассивТипов = Новый Массив;
	Если Объект.ЭтоКорректировка Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	
	ИначеЕсли Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.РезервВозвратПоставщику")
			Или Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратПоставщику") Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
		
	ИначеЕсли Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки")
		ИЛИ Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию") Тогда
		
		МассивТипов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
		
	ИначеЕсли Объект.ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаНаСторону") Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
		МассивТипов.Добавить(Тип("ДокументСсылка.СчетНаОплату"));
	Иначе
		
		МассивТипов.Добавить(Тип("ДокументСсылка.СчетНаОплату"));
	
	КонецЕсли;

	НовоеОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	Форма.Элементы.ДокументОснование.ОграничениеТипа = НовоеОграничениеТипа;
	Объект.ДокументОснование = НовоеОграничениеТипа.ПривестиЗначение(Объект.ДокументОснование);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьИзмененияСчетовУчета(Форма, Объект)
	Если ЭтоПередачаВПользование(Объект.ВидПередачиМЗ) Тогда
		
		Форма.Элементы.СчетУчета.ОтображениеПредупрежденияПриРедактировании
			= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Форма.Элементы.СчетУчета.ПредупреждениеПриРедактировании
			= НСтр("ru = 'Операции передачи по договору возмездного или безвозмездного пользования возможны только со счетов 105.хх'");
		
	Иначе
		
		Форма.Элементы.СчетУчета.ОтображениеПредупрежденияПриРедактировании
			= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетУчетаПоВидуПередачиМЗ()
	Если ЭтоПередачаВПользование(Объект.ВидПередачиМЗ)
		Или ЭтоОперацияПоДавальческомуСырью(Объект.ВидПередачиМЗ) Тогда
		
		Если Не УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект) Тогда
			Объект.СчетУчета = Счет105();
			Объект.Материалы.Очистить();
		КонецЕсли;
	ИначеЕсли ЭтоОперацияПоКомиссионнымТоварам(Объект.ВидПередачиМЗ) Тогда
		Если Объект.СчетУчета <> Счет0233() Тогда
			Объект.СчетУчета = Счет0233();
			Объект.Материалы.Очистить();
		КонецЕсли
		
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПередачаВПользование(ВидПередачиМЗ)

	Возврат ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаПоДоговоруАренды")
		ИЛИ ВидПередачиМЗ = ПредопределенноеЗначение(
			"Перечисление.ВидыПередачиМЗ.ПередачаПоДоговоруБезвмозмездногоПользования")
		ИЛИ ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаВДоверительноеУправление");

КонецФункции // ЭтоПередачаВПользование()

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОперацияПоДавальческомуСырью(ВидПередачиМЗ)

	Возврат ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку")
		ИЛИ ВидПередачиМЗ = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки");

КонецФункции // ЭтоПередачаВПользование()
	
&НаСервере
Процедура УстановитьСчетаВЛокальныйКэшФормы()

	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105", БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчетов, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет106", БухгалтерскийУчет.СчетПоКоду("106.00", ДатаСчетов, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет27", БухгалтерскийУчет.СчетПоКоду("27", ДатаСчетов, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0233", БухгалтерскийУчет.СчетПоКоду("02.33", ДатаСчетов, Объект.Организация));
	МассивСчетов27 = БухгалтерскийУчет.СписокСчетов("27", ДатаСчетов, , Объект.Организация);
	ФиксМассивСчетов27 = Новый ФиксированныйМассив(МассивСчетов27);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счета27", ФиксМассивСчетов27);

КонецПроцедуры

