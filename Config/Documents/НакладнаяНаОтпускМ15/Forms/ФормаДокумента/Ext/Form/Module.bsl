&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОтветственныеЛица(Объект)
	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	УстановленРуководитель = Ложь;
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		УстановленРуководитель = Истина;
	КонецЕсли;

	#Если НаКлиенте Тогда
	Если УстановленРуководитель Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель""'"));
	КонецЕсли;			
	#КонецЕсли
КонецПроцедуры

