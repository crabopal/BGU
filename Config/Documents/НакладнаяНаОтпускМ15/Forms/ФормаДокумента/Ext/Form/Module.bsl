&НаКлиенте
Процедура НоменклатураОбъемноСортовогоУчетаМаркированныхТоваровНоменклатураКодGTINНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.НоменклатураОбъемноСортовогоУчетаМаркированныхТоваров.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораКода", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"		, Объект.Организация);
		ПараметрыФормы.Вставить("Номенклатура"		, ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("ОСУ"				, Истина);  
		ПараметрыФормы.Вставить("ДатаОстатков"		, Объект.Дата);
		ПараметрыФормы.Вставить("Количество"		, ТекущиеДанные.Количество);
						
		ОткрытьФорму("ОбщаяФорма.ВыборКодаИСМПБГУ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыДополнительнаяАналитикаСчетаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
		
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные.СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("02.34") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СчетДт", ТекущиеДанные.СчетУчета);
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("Дата", Объект.Дата);
		ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
		ПараметрыФормы.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		ОткрытьФорму("Документ.ПоступлениеМЗ.ФормаВыбора", ПараметрыФормы, Элемент);
	КонецЕсли;
	
