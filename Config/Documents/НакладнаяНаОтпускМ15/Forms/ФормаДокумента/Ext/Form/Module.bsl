	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", НСтр("ru = 'Истина'"));
	Поле = ЭлементУО.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("МатериалыДоговорКомитента");
