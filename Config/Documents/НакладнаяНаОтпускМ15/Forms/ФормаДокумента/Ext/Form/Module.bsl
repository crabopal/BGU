
#Область ОписаниеПеременных
	
// Используется при изменении ЦМО, для проверки необходимости очистки таблицы
&НаКлиенте
Перем ЦМОДоИзменения; // СправочникСсылка.ЦМО

// Используется при изменении КФО, для проверки необходимости очистки таблицы
&НаКлиенте
Перем КФОДоИзменения; // ПеречислениеСсылка.КВД

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаБаннерУведомлениеОПеремещении",
		"Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьКорректировка",
		"ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьВалютаНДС",
		"Доступность", ТолькоПросмотр <> Истина);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ЗаполнитьТекстПроСчетФактуруСервер();
	УправлениеМатериальнымиЗапасами.УстановитьКорректирующийДокумент(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьСвойстваЭлементовГруппыКорректировка(ЭтотОбъект);
	НастроитьОтображениеКорректировки();
	ЭлектронныеДокументыБГУ.ЗаполнитьРеквизитыМаркировки(Объект, "Материалы");
	УправлениеМатериальнымиЗапасамиФормы.ДокументПриСозданииНаСервере(ЭтотОбъект);
	
	// Настроить доступность редактирования строк по ФО "ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА"
	ОбщегоНазначенияБГУ.УстановитьДоступностьРедактированияСтрокВДокументахНФА(ЭтотОбъект);
	Если ОбщегоНазначенияБГУКлиентСервер.ЗапрещеноДобавлениеСтрокВДокументыНФА(ЭтотОбъект) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыЗаполнитьКПСНоменклатура",
			"Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВозвратнаяТараЗаполнитьКПСВозвратнаяТара",
			"Видимость", Ложь);
	КонецЕсли;
	// Конец Настроить доступность редактирования строк по ФО "ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА"
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Если Объект.ДанныеДляАктированияЕИС.Количество() > 0 Тогда
				Объект.Материалы.Очистить();
				Объект.ДанныеДляАктированияЕИС.Очистить();
			КонецЕсли;
		КонецЕсли;
		
		ПодготовитьФормуНаСервере();
		УстановитьСчетаВЛокальныйКэшФормы();
		
		Если Не ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			ЗаполнитьОтветственныеЛица(Объект);
		КонецЕсли;
		ЗаполнитьСведенияОПриемкеПередачеПоставщикаДляУПД();
		
	КонецЕсли;
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ИнтеграцияИС
	ИнтеграцияИС.ПриСозданииНаСервереВФормеДокументаОснования(ЭтотОбъект, Объект, ИнтеграцияИС.ПараметрыИнтеграцииВФорме("ВетИС",ИнтеграцияИС.ИмяЭлементаДляРазмещения()));
	// Конец ИнтеграцияИС
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);

	// Подсистема "ОбменСКонтрагентами".
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	Если НЕ ВидимостьЭлементовЭДО Тогда
		ВидимостьЭлементовЭДО = ЭлектронноеАктированиеБГУ.ВидимостьЭлементовАктирования(Объект.Организация, Объект.Договор);
	КонецЕсли;
	ВидимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(Объект.Контрагент, Объект.Организация);
	
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	
	ЗаполнитьЗначенияСвойств(
		ЭтотОбъект, ЭлектронныеДокументыБГУ.РеквизитыЭТрН(Объект.Ссылка));
	ЭлектронныеДокументыБГУКлиентСервер.ПроверитьВозможностьОформленияЭПД(ЭтотОбъект);
	ЭлектронныеДокументыБГУ.ДополнительныеКомандыЭДО_ФормаДокумента(ЭтотОбъект);
	
	ЕстьПравоСозданиеЭТрН = ПравоДоступа("Изменение", Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная);
	НастроенОбменЭПД = ЭлектронныеДокументыБГУ.ДокументооборотЭПДНастроен(Объект.Организация, Объект.Контрагент, ВидимостьЭлементовЭДО);
	Если НастроенОбменЭПД Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(ЭтотОбъект);
	КонецЕсли;

	ВидимостьЭлементовМаркировкиОбъемноСортовогоУчета = ЭлектронныеДокументыБГУ.ИспользованиеОбъемноСортовойУчетМаркированныхТоваров(Объект.Организация);
	
	ВидимостьЭлементовМаркировки = ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(Объект.Организация);
	
	Если Объект.КодыУпаковокМаркируемойПродукции.Количество()>0 Тогда
		ВидимостьЭлементовМаркировки = Истина;
	КонецЕсли;

	Если НЕ ВидимостьЭлементовЭДО Тогда
		ВидимостьЭлементовМаркировки = Ложь;	
	КонецЕсли;	
	
	Если ВидимостьЭлементовМаркировки Тогда
		УстановитьВидимостьЭлементовМаркировкиОбъектноСортовойУчет(ЭтаФорма, ВидимостьЭлементовМаркировкиОбъемноСортовогоУчета);
	Иначе
		УстановитьВидимостьЭлементовМаркировкиОбъектноСортовойУчет(ЭтаФорма, ВидимостьЭлементовМаркировки);
	КонецЕсли;
	
	ВидимостьЭлементовАктирования = ЭлектронноеАктированиеБГУ.ВидимостьЭлементовАктирования(Объект.Организация, Объект.Договор);
	
	ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД();
	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448();
	УстановитьВидимостьЭлементовЭДО(ЭтаФорма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхЭДОПродавцаДляГосНужд, ВидимостьЭлементовАктирования);
	ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере();
	// Конец подсистема "ОбменСКонтрагентами".

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.КомандыЭДО_ФормаДокумента(ЭтотОбъект);
	ЭлектронноеАктированиеБГУ.ЗаполнитьСлужебныеДанныеЕИС(ЭтотОбъект, "Материалы", "Материалы");
	ЭлектронноеАктированиеБГУ.ЗаполнитьРеквизитыЭлектронногоАктирования(ЭтотОбъект, "Материалы");
	ЭлектронноеАктированиеБГУ.ЗаполнитьПредставленияСтрокКонтракта(ЭтотОбъект, "Материалы");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства

	УстановитьУсловноеОформление();
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом

	ПервичныеДокументыБГУ.ПриСозданииНаСервере(ЭтотОбъект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	УстановитьСчетаВЛокальныйКэшФормы();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьСлужебныеДанныеЕИС(ЭтотОбъект, "Материалы", "Материалы");
	ЭлектронноеАктированиеБГУ.ЗаполнитьРеквизитыЭлектронногоАктирования(ЭтотОбъект, "Материалы");
	ЭлектронноеАктированиеБГУ.ЗаполнитьПредставленияСтрокКонтракта(ЭтотОбъект, "Материалы");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленииОПеремещении", 0.1, Истина);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);

	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
		
	ЭлектронныеДокументыБГУ.СохранитьКодыМаркировки(Объект.Материалы, ТекущийОбъект);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.СохранитьИдентификаторыДляАктированияЕИС(Объект.Материалы, ТекущийОбъект);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);
	
//	Оповестить("ДокументыПоУчетуМатериальныхЗапасовИзменение");
	УправлениеМатериальнымиЗапасамиФормыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	УстановитьВидимостьДанныхДрагМатериалов();
	
	Если Объект.ЭтоКорректировка Тогда
		Оповестить("Запись_НакладнаяНаОтпускМ15", Объект.ДокументОснование, Объект.Ссылка);
	Иначе
		Оповестить("Запись_НакладнаяНаОтпускМ15", ПараметрыЗаписи, Объект.Ссылка);
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если УправлениеМатериальнымиЗапасамиКлиент.ОбработкаВыбораИзПодбораМЗ(ИсточникВыбора) Тогда
		ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение,ИсточникВыбора.ИмяТаблицы);
		ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленииОПеремещении", 0.1, Истина);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.КонтрольИсполненияДоговоров" Тогда
		Объект.ОтразитьВГрафикеИсполненияДоговора = ВыбранноеЗначение;
		КонтрольИсполненияДоговоровКлиент.УстановитьСтатусОтразитьДокументВГрафикеИсполнения(
			ЭтотОбъект, Объект.ОтразитьВГрафикеИсполненияДоговора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.НомераГТД.Форма.ФормаПодбораРНПТ" Тогда
		ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.СведенияЭлектронногоУПДПоставщика" Тогда
		ОбработатьВыборСведенийЭлектронногоУПДПоставщика(ВыбранноеЗначение);	
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.СведенияЭлектронногоАктаОПриемеПередачеНФА" Тогда
		ОбработатьВыборСведенийЭлектронногоАктаОПриемеПередаче(ВыбранноеЗначение);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_СчетФактураВыданный"
		ИЛИ ИмяСобытия = "Запись_КорректировочныйСчетФактураВыданный"
		ИЛИ ИмяСобытия = "Запись_ИсправительныйСчетФактураВыданный" Тогда
		
		ЗаполнитьТекстПроСчетФактуруКлиент(Параметр, Источник);
		
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_НакладнаяНаОтпускМ15" И Параметр = Объект.Ссылка Тогда
		ОбновитьДанныеКорректировки();
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_УведомлениеОПеремещенииПрослеживаемыхТоваров" 
		И ТипЗнч(Параметр) = Тип("Структура")
		И Параметр.Свойство("СопроводительныеДокументы")
		И Параметр.СопроводительныеДокументы.Найти(Объект.Ссылка) <> Неопределено Тогда
		
		УстановитьПредставлениеНадписиУведомлениеОПеремещении();
		ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленииОПеремещении", 0.1, Истина);
	КонецЕсли;	

	Если ИмяСобытия = "ОбновитьСостояниеЭДАктов" Тогда
		ОбновитьСостояниеЭДОАктаПоФорме0510448НаКлиенте();
	КонецЕсли;
	
	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// ИнтеграцияИС
	ИнтеграцияИСКлиент.ОбработкаОповещенияВФормеДокументаОснования(
		ЭтотОбъект,
		Объект,
		ИмяСобытия,
		Параметр,
		Источник);
	// Конец ИнтеграцияИС
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы();
		
	ПодготовитьФормуНаСервере();
	ЭлектронныеДокументыБГУ.ВосстановитьРеквизитыМаркировки(Объект.Материалы, ПараметрыЗаписи);
	ЗаполнитьПризнакиОбъемноСортовогоУчетаМаркированныхТоваровНаСервере();
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".  

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьРеквизитыЭлектронногоАктирования(ЭтотОбъект, "Материалы");
	ЭлектронноеАктированиеБГУ.ЗаполнитьПредставленияСтрокКонтракта(ЭтотОбъект, "Материалы");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД();
	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448();
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, ТекущийОбъект);
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЭлектронныеДокументыБГУ.КэшироватьРеквизитыМаркировки(Объект.Материалы, ПараметрыЗаписи);

КонецПроцедуры

