	|							И НЕ НакладнаяНаОтпускМ15.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА НакладнаяНаОтпускМ15.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(НакладнаяНаОтпускМ15.Контрагент)
	|				КОНЕЦ
	|		ИНАЧЕ НакладнаяНаОтпускМ15.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК Получатель,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускМ15.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА НакладнаяНаОтпускМ15.Контрагент.ЮридическоеФизическоеЛицо.КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОКПОПолучатель,
	|	НакладнаяНаОтпускМ15.Контрагент.ИНН КАК ИННПолучатель,
	|	НакладнаяНаОтпускМ15.Контрагент.КПП КАК КПППолучатель,
	|	НакладнаяНаОтпускМ15.Договор.Представление КАК Договор,
	|	НакладнаяНаОтпускМ15.ЦМО.Сотрудник КАК Отпустил,
	|	НакладнаяНаОтпускМ15.КФО КАК КФО,
	|	НакладнаяНаОтпускМ15.Ответственный,
	|	НакладнаяНаОтпускМ15Материалы.БСО.Наименование + ВЫБОР
	|		КОГДА НакладнаяНаОтпускМ15Материалы.СерияБСО = ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ""; "" + НакладнаяНаОтпускМ15Материалы.СерияБСО.Наименование
	|	КОНЕЦ + ВЫБОР
	|		КОГДА НакладнаяНаОтпускМ15Материалы.НомерНачальный = """"
	|				И НакладнаяНаОтпускМ15Материалы.НомерКонечный = """"
	|			ТОГДА """"
	|		КОГДА НакладнаяНаОтпускМ15Материалы.НомерНачальный = НакладнаяНаОтпускМ15Материалы.НомерКонечный
	|			ТОГДА ""; "" + НакладнаяНаОтпускМ15Материалы.НомерНачальный
	|		КОГДА НакладнаяНаОтпускМ15Материалы.НомерНачальный = """"
	|			ТОГДА ""; "" + НакладнаяНаОтпускМ15Материалы.НомерКонечный
	|		КОГДА НакладнаяНаОтпускМ15Материалы.НомерКонечный = """"
	|			ТОГДА ""; "" + НакладнаяНаОтпускМ15Материалы.НомерНачальный
	|		ИНАЧЕ ""; "" + НакладнаяНаОтпускМ15Материалы.НомерНачальный + ""-"" + НакладнаяНаОтпускМ15Материалы.НомерКонечный
	|	КОНЕЦ КАК Номенклатура,
	|	НакладнаяНаОтпускМ15Материалы.БСО.Код КАК НомерПаспорта,
	|	"""" КАК НоменклатурныйНомер,
	|	НакладнаяНаОтпускМ15Материалы.БСО.ЕдиницаИзмерения.Код КАК ЕдиницаКод,
	|	НакладнаяНаОтпускМ15Материалы.БСО.ЕдиницаИзмерения.Наименование КАК ЕдиницаНаименование,
	|	ЕСТЬNULL(НакладнаяНаОтпускМ15Материалы.Количество, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НакладнаяНаОтпускМ15Материалы.Количество, 0) = 0
	|			ТОГДА ЕСТЬNULL(Проводки.Сумма, 0)
	|		ИНАЧЕ ЕСТЬNULL(Проводки.Сумма, 0) / ЕСТЬNULL(НакладнаяНаОтпускМ15Материалы.Количество, 1)
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(Проводки.Сумма, 0) КАК СуммаБезНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	ЕСТЬNULL(Проводки.Сумма, 0) КАК СуммаВсего,
	|	"""" КАК СчетДт,
	|	"""" КАК КПСДт,
	|	"""" КАК КЭКДт,
	|	НакладнаяНаОтпускМ15.СчетУчета КАК СчетКт,
	|	"""" КАК КПСКт,
	|	"""" КАК КЭККт,
	|	НакладнаяНаОтпускМ15Материалы.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ПередачаБСО КАК НакладнаяНаОтпускМ15
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаБСО.СоставБСО КАК НакладнаяНаОтпускМ15Материалы
	|			ЛЕВОЕ СОЕДИНЕНИЕ Проводки КАК Проводки
	|			ПО (Проводки.Ссылка = НакладнаяНаОтпускМ15Материалы.Ссылка)
	|				И НакладнаяНаОтпускМ15Материалы.БСО = Проводки.Номенклатура
	|				И НакладнаяНаОтпускМ15Материалы.Количество = Проводки.Количество
	|		ПО НакладнаяНаОтпускМ15.Ссылка = НакладнаяНаОтпускМ15Материалы.Ссылка
	|ГДЕ
	|	НакладнаяНаОтпускМ15.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Возврат УправлениеПечатьюБГУ.Напечатать0504205(Запрос, ОбъектыПечати, ИмяМакета);
	
КонецФункции

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьНакладнойМ15(МассивОбъектов, ОбъектыПечати)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПередачаБСО.Номер КАК пНомер,
	|	ПередачаБСО.Ссылка КАК Ссылка,
	|	ПередачаБСО.Дата КАК пДата,
	|	ПередачаБСО.Организация КАК Организация,
	|	ПередачаБСО.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	ПередачаБСО.Организация.КодОКПО КАК пКодОКПО,
	|	ПередачаБСО.Подразделение КАК Подразделение,
	|	ПередачаБСО.Подразделение.Представление КАК пПодразделениеОтправитель,
	|	ПередачаБСО.ЦМО.Сотрудник КАК ЦМОСотрудник,
	|	ПередачаБСО.Контрагент.Представление КАК пКонтрагент,
	|	ПРЕДСТАВЛЕНИЕ(ПередачаБСО.Договор) КАК пДоговор,
	|	ПередачаБСО.КФО КАК КФО
	|ИЗ
	|	Документ.ПередачаБСО КАК ПередачаБСО
	|ГДЕ
	|	ПередачаБСО.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПередачаБСОСоставБСО.БСО КАК Номенклатура,
	|	ПередачаБСОСоставБСО.БСО.Наименование + ВЫБОР
	|		КОГДА ПередачаБСОСоставБСО.СерияБСО = ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ""; "" + ПередачаБСОСоставБСО.СерияБСО.Наименование
	|	КОНЕЦ + ВЫБОР
	|		КОГДА ПередачаБСОСоставБСО.НомерНачальный = """"
	|				И ПередачаБСОСоставБСО.НомерКонечный = """"
	|			ТОГДА """"
	|		КОГДА ПередачаБСОСоставБСО.НомерНачальный = ПередачаБСОСоставБСО.НомерКонечный
	|			ТОГДА ""; "" + ПередачаБСОСоставБСО.НомерНачальный
	|		КОГДА ПередачаБСОСоставБСО.НомерНачальный = """"
	|			ТОГДА ""; "" + ПередачаБСОСоставБСО.НомерКонечный
	|		КОГДА ПередачаБСОСоставБСО.НомерКонечный = """"
	|			ТОГДА ""; "" + ПередачаБСОСоставБСО.НомерНачальный
	|		ИНАЧЕ ""; "" + ПередачаБСОСоставБСО.НомерНачальный + ""-"" + ПередачаБСОСоставБСО.НомерКонечный
	|	КОНЕЦ КАК пНоменклатура,
	|	ПередачаБСОСоставБСО.БСО.Код КАК пКодАналитики,
	|	"""" КАК пНоменклатурныйНомер,
	|	ЕСТЬNULL(ПередачаБСОСоставБСО.Количество, 0) КАК пКоличество,
	|	ПередачаБСОСоставБСО.БСО.ЕдиницаИзмерения.Код КАК пКодЕдиницы,
	|	ПередачаБСОСоставБСО.БСО.ЕдиницаИзмерения.Наименование КАК пЕдиница,
	|	0 КАК пЦена,
	|	0 КАК пСуммаБезНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК пСтавкаНДС,
	|	0 КАК пСуммаНДС,
	|	0 КАК пВсего,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ПередачаБСО.СчетУчета КАК СчетУчета,
	|	ПередачаБСО.СчетУчета.Представление КАК СчетУчетаПредставление,
	|	ПередачаБСОСоставБСО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПередачаБСО КАК ПередачаБСО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаБСО.СоставБСО КАК ПередачаБСОСоставБСО
	|		ПО ПередачаБСО.Ссылка = ПередачаБСОСоставБСО.Ссылка
	|ГДЕ
	|	ПередачаБСО.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПередачаБСОСоставБСО.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПередачаБСО) КАК Ссылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.БСО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	|	КОНЕЦ КАК Номенклатура,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК Количество,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК КоличествоОстаток,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК СуммаОстаток,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И (ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|					ИЛИ ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|					ИЛИ ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПередачаБСО),
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.БСО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт";
				   
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	// печать всегда по себестоимости
	Возврат УправлениеПечатьюБГУ.ПечатьНакладнойНаОтпускМЗнаСторону0315007(РезультатЗапроса, ОбъектыПечати, Истина);

КонецФункции

