#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.НакладнаяНаОтпускМ15";
	КомандаПечати.Идентификатор  = "Накладная0510458_157н";
	КомандаПечати.Представление  = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на отпуск материальных ценностей на сторону'"), "0510458", "61н", "157н");
	КомандаПечати.Порядок        = 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПередачаБСО";
	КомандаПечати.Идентификатор		= "Накладная0504205_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на отпуск материалов на сторону'"), "0504205", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 2;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПередачаБСО";
	КомандаПечати.Идентификатор		= "Накладная0504205_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на отпуск материалов на сторону'"), "0504205", "52н", , Истина);
	КомандаПечати.Порядок			= 3;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПередачаБСО";
	КомандаПечати.Идентификатор		= "ПередачаБСО";
	КомандаПечати.Представление		= НСтр("ru = '(устарела) Накладная на отпуск на сторону М-15'");
	КомандаПечати.Порядок			= 99;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Накладная0510458_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьНакладнуюНаОтпускМЗ0510458(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
			НСтр("ru = 'Накладная на отпуск материальных ценностей на сторону'"), "0510458", "61н", "157н");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПередачаБСО") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"ПередачаБСО",
			"Накладная на отпуск на сторону М-15",
			ПечатьНакладнойМ15(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_103н",
			"Накладная на отпуск материалов на сторону (ф.0504205) ред.103н",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_52н",
			"Накладная на отпуск материалов на сторону (ф.0504205) ред.52н",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205"));
		
	КонецЕсли;
	
КонецПроцедуры

