#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Возвращает таблицу значений по данным табличной части документа для формирования режерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивРеквизитовКУдалению = Новый Массив;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации) Тогда
		
		ТаблицаОС = ОсновныеСредства.Выгрузить(, "НомерСтроки,ОсновноеСредство,ИнвентарныйНомер,Сумма,Количество");
		ДанныеПроверки = Новый Структура("Ссылка,Дата,Организация,ВидОперации,ТаблицаОС",
			Ссылка, Дата, Организация, ВидОперации, ТаблицаОС);
		
		Отказ = Не УправлениеОсновнымиСредствами.МожноПровестиПередачуОбъектовОС(ДанныеПроверки);
		
		Если Отказ Тогда
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СписокСчетов = ОсновныеСредства.ВыгрузитьКолонку("СчетУчета");
	СвойстваСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокСчетов, "УчетПоКПС");
	УчетПоКПС = Ложь;
	Для Каждого ДанныеСчета Из СвойстваСчетов Цикл
		Если ДанныеСчета.Значение Тогда
			УчетПоКПС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не УчетПоКПС Тогда
		МассивРеквизитовКУдалению.Добавить("ОсновныеСредства.КПС");
	КонецЕсли;
	
	Если Не БухгалтерскийУчет.ПодразделениеОбязательно(СписокСчетов) Тогда
		// Если нет учета по подразделениям, то подразделение не контролируем, ни для отправителя, ни для получателя 
		МассивРеквизитовКУдалению.Добавить("Подразделение");
		МассивРеквизитовКУдалению.Добавить("ПодразделениеПолучатель");
	ИначеЕсли Документы.ПередачаОбъектовИК.ВОсВнутреннимПеремещением().Найти(ВидОперации) = Неопределено
		ИЛИ ПередачаЧастейОбъектов Тогда
		// Если есть учет по подразделениям, то подразделение получателя контролируем, 
		// только в случае, если есть внутреннее перемещение по счетам 108   
		МассивРеквизитовКУдалению.Добавить("ПодразделениеПолучатель");
	КонецЕсли;                           
	
	Если НЕ ВидОперации = Перечисления.ВидыОперацийИК.Реализация Тогда
		МассивРеквизитовКУдалению.Добавить("ВалютаДокумента");
	КонецЕсли;	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивРеквизитовКУдалению);
	
	Для Каждого ТекСтр Из ОсновныеСредства Цикл
		
		Если ЗначениеЗаполнено(ТекСтр.ИнвентарныйНомер) и ТекСтр.Количество>1 Тогда
			ТекстПредупреждения = НСтр("ru='Для объектов с присвоенным инвентарным номером не может быть количество больше 1'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,"Объект.ОсновныеСредства["+(ТекСтр.НомерСтроки-1)+"].Количество",,Отказ);
		КонецЕсли;
		
		Если ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(ТекСтр.СчетУчета) 
			И ТекСтр.ОтразитьВКарточкеКапвложений И НЕ ЗначениеЗаполнено(ТекСтр.КарточкаКапвложений) Тогда
			ТекстПредупреждения = НСтр("ru='Если в колонке ""Отразить в карточке капвложений"" включен флажок,
				|должен быть заполнена карточка капвложений.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,
				"Объект.ОсновныеСредства[" + (ТекСтр.НомерСтроки - 1) + "].КарточкаКапвложений",,Отказ);
		КонецЕсли;
	
	КонецЦикла;
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Комиссия) Тогда
		Председатель = Справочники.Сотрудники.ПустаяСсылка();
		Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
			СтрокаКомиссии.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
			СтрокаКомиссии.Отсутствует = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ОсновныеСредства");
	
	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") И ДанныеЗаполнения.ВводНаОсновании Тогда
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
				ЗаполнитьПо_ПоступлениеОСИК(ДанныеЗаполнения);
			ИначеЕсли ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
				ЗаполнитьПо_ПринятиеКУчетуОбъектовИК(ДанныеЗаполнения);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ЭтоПередачаКапвложенийИК = 
		ВидОперации = Перечисления.ВидыОперацийИК.ПередачаКапвложений;
		
	ВедетсяУчетДрагМатериаловВМЦКапвложений = ЭтоПередачаКапвложенийИК И
		(ДрагоценныеМатериалы.Количество() > 0 ИЛИ УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений());
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Если ЭтоПередачаКапвложенийИК Тогда
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийИК();
	Иначе
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбъектНФА,
				ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если Не (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;   
	Запрос.Текст = УчетДрагМатериалов.ТекстЗапросаПроверкиЗаполненияСодержанияДрагМатериаловКапвложений(ВедетсяУчетДрагМатериаловВМЦКапвложений);
	
	Если ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда 
			
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ОбъектМЦ, МассаДМ, КоличествоДМ");   
		
		Капвложения = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, Количество");
		Капвложения.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
		
		ТаблицаОбъектовНФА = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Организация,Капвложения, Новый Граница(Ссылка.Дата, ВидГраницы.Включая));

	Иначе
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер, МассаДМ, КоличествоДМ");  
		
		ТаблицаОбъектовНФА = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		Если ЭтоПередачаКапвложенийИК Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта  вложений ""%1"" из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов по материальной ценности ""%2"". Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ОбъектМЦ);
		Иначе
			ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ИнвНомер);
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПо_ПоступлениеОСИК(ДанныеЗаполнения)
	ОсновныеСредства.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Организация КАК Организация,
	|	Шапка.ИФО КАК ИФО,
	|	Шапка.Подразделение КАК Подразделение,
	|	Шапка.ЦМО КАК ЦМО,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.ПоступлениеОСИК КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КапВложения.ВнеоборотныйАктив КАК ОсновноеСредство,
	|	КапВложения.КПС КАК КПС,
	|	КапВложения.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА КапВложения.Количество = 0
	|			ТОГДА КапВложения.Сумма
	|		ИНАЧЕ КапВложения.Сумма / КапВложения.Количество
	|	КОНЕЦ КАК ЦенаПродажи,
	|	ВЫБОР
	|		КОГДА КапВложения.Количество = 0
	|			ТОГДА КапВложения.Сумма
	|		ИНАЧЕ КапВложения.Сумма / КапВложения.Количество
	|	КОНЕЦ КАК СтоимостьЕдиницы,
	|	КапВложения.Сумма КАК Сумма,
	|	КапВложения.СтавкаНДС КАК СтавкаНДС,
	|	КапВложения.СуммаНДС КАК СуммаНДС,
	|	КапВложения.Сумма КАК СуммаПродажи,
	|	КапВложения.Всего КАК Всего,
	|	КапВложения.СчетУчета КАК СчетУчета,
	|	КапВложения.ОтразитьВКарточкеКапвложений КАК ОтразитьВКарточкеКапвложений,
	|	КапВложения.КарточкаКапвложений КАК КарточкаКапвложений
	|ИЗ
	|	Документ.ПоступлениеОСИК.КапВложения КАК КапВложения
	|ГДЕ
	|	КапВложения.Ссылка = &Ссылка
	|	И КапВложения.КФО = &КФО
	|	И КапВложения.СчетУчета В(&СчетаУчета)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("КФО", ДанныеЗаполнения.Разделитель.КФО);

	ДокументОснование = ДанныеЗаполнения.ДокументОснование;    
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений");
	КФО = ДанныеЗаполнения.Разделитель.КФО;
	ВидИмущества = ДанныеЗаполнения.Разделитель.ВидИмущества;
	
	ДанныеОснования   = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
	Дата1 = ?(ЗначениеЗаполнено(Дата), Дата, ДанныеОснования.Дата);
	Организация1 = ?(ЗначениеЗаполнено(Организация), Организация, ДанныеОснования.Организация);
	СчетаУчета = Перечисления.ВидыИмущества.СчетаКапвложенйПоВидуИмущества(
		ДанныеЗаполнения.Разделитель.ВидИмущества, Дата1, Организация1);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = Результат[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	КонецЕсли;	
	
	ВыборкаТЧ = Результат[1].Выбрать();
	Пока ВыборкаТЧ.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТЧ);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьПо_ПринятиеКУчетуОбъектовИК(ДанныеЗаполнения)
	ОсновныеСредства.Очистить();
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументОснование, "ВидПоступления");
	
	ВО_ПоступлениеЗабаланс = Перечисления.ВидыОперацийИК.ПоступлениеЗабаланс;

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Организация КАК Организация,
	|	Док.ИФО КАК ИФО,
	|	Док.КФО КАК КФО,
	|	Док.Подразделение КАК Подразделение,
	|	Док.ЦМО КАК ЦМО,
	|	Док.ВидПоступления КАК ВидПоступления,
	|	Док.ВидИмущества КАК ВидИмущества,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Договор КАК Договор
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовИК КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.СчетУчета КАК СчетУчета,
	|	СУММА(ТабЧасть.Количество) КАК Количество,
	|	СУММА(ТабЧасть.Сумма) КАК Сумма,
	|	СУММА(ТабЧасть.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(ТабЧасть.СуммаОбесценения) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ОС_УжеПередано
	|ИЗ
	|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ТабЧасть
	|ГДЕ
	|	ТабЧасть.Ссылка.ДокументОснование = &Ссылка
	|	И ТабЧасть.Ссылка.ВидИмущества = &ВидИмущества
	|	И НЕ ТабЧасть.Ссылка.ПометкаУдаления
	|	И (&НетСсылкиЦелевогоДокумента ИЛИ ТабЧасть.Ссылка <> &СсылкаЦелевогоДокумента)
	|СГРУППИРОВАТЬ ПО	
	|	ТабЧасть.ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер,
	|	ТабЧасть.КПС,
	|	ТабЧасть.СчетУчета
	|;
	|//////////////////////////////////////////////////
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.СчетУчетаОС КАК СчетУчета,
	|	ТабЧасть.Количество - ЕСТЬNULL(ОС_УжеПередано.Количество, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА ТабЧасть.Количество = 0
	|			ТОГДА ТабЧасть.Сумма
	|		ИНАЧЕ ТабЧасть.Сумма / ТабЧасть.Количество
	|	КОНЕЦ КАК СтоимостьЕдиницы,
	|	ТабЧасть.Сумма - ЕСТЬNULL(ОС_УжеПередано.Сумма, 0) КАК Сумма,
	|	ТабЧасть.СуммаАмортизации - ЕСТЬNULL(ОС_УжеПередано.СуммаАмортизации, 0) КАК СуммаАмортизации,
	|	ТабЧасть.СуммаОбесценения - ЕСТЬNULL(ОС_УжеПередано.СуммаОбесценения, 0) КАК СуммаОбесценения
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ТабЧасть
	|	ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПередано КАК ОС_УжеПередано
	|		ПО ТабЧасть.ОсновноеСредство = ОС_УжеПередано.ОсновноеСредство
	|		И ТабЧасть.ИнвентарныйНомер = ОС_УжеПередано.ИнвентарныйНомер
	|		И ТабЧасть.КПС = ОС_УжеПередано.КПС
	|		И ТабЧасть.СчетУчетаОС = ОС_УжеПередано.СчетУчета
	|ГДЕ
	|	ТабЧасть.Ссылка = &Ссылка
	|	И (НЕ ТабЧасть.Ссылка.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПоступлениеЗабаланс) 
	|		ИЛИ ТабЧасть.СчетУчетаОС В ИЕРАРХИИ (&СчетУчета))	
	|	И (ТабЧасть.Количество - ЕСТЬNULL(ОС_УжеПередано.Количество, 0) > 0
	|	ИЛИ ТабЧасть.Сумма - ЕСТЬNULL(ОС_УжеПередано.Сумма, 0) > 0)
	|	";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("ВидИмущества", ДанныеЗаполнения.Разделитель.ВидИмущества);
	
	Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеЗабаланс Тогда
		Запрос.УстановитьПараметр("СчетУчета", ДанныеЗаполнения.Разделитель.СчетУчета);
	Иначе
		Запрос.УстановитьПараметр("СчетУчета", Неопределено);
	КонецЕсли;		
	Запрос.УстановитьПараметр("СсылкаЦелевогоДокумента", Ссылка);
	Запрос.УстановитьПараметр("НетСсылкиЦелевогоДокумента", НЕ ЗначениеЗаполнено(Ссылка));

	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка = Результат[0].Выбрать();
	ВыборкаТЧ = Результат[2].Выбрать();
	
	Если ВыборкаТЧ.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'По документу ""%1"" все объекты, вероятно, уже переданы'"); 
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, ДанныеЗаполнения.ДокументОснование));
		Возврат;
	КонецЕсли;	
	
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка,, "Контрагент, Договор");
		Если ДанныеЗаполнения.Разделитель.ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии Тогда
			ВидИмущества = ДанныеЗаполнения.Разделитель.ВидИмущества;
		Иначе
			ВидИмущества = Перечисления.ВидыИмущества.Казна;
		КонецЕсли;		
		
		Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеЗабаланс Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка, "Контрагент, Договор");
			Если ДанныеЗаполнения.Разделитель.СчетУчета = БухгалтерскийУчет.СчетПоКоду("01") Тогда
				ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование;
			Иначе	
				ВидОперации = Перечисления.ВидыОперацийИК.ПередачаОСнаХранении;
			КонецЕсли;
		Иначе	
			ВидОперации = Перечисления.ВидыОперацийИК.Передача;
		КонецЕсли;	
	КонецЕсли;	

	Пока ВыборкаТЧ.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТЧ);
		Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеЗабаланс Тогда
			НоваяСтрока.Договор = ВыборкаШапка.Договор;
		КонецЕсли;	
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
КонецПроцедуры	

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(
		ОсновныеСредства.ВыгрузитьКолонку("СчетУчета"));
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	СубконтоДоговоры = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	СубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	
	ЭтоВозврат = (ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование
	ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаОСнаХранении);
	
	Для каждого СтрокаТЧ из ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, Количество, Сумма, НомерСтроки");

		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		Если СтрокаСчета.УчетПоЦМО Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, КФО, ЦМО, ПередачаЧастейОбъектов");
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, КФО, ПередачаЧастейОбъектов");
		КонецЕсли;	
		
		Если ЭтоВозврат Тогда
			Если СтрокаСчета.ВидДопАналитики = СубконтоДоговоры Тогда
				Если ДоговорВТабличнойЧасти Тогда
					Если ЗначениеЗаполнено(СтрокаТЧ.Договор) Тогда
						НоваяСтрока.ДопАналитика = СтрокаТЧ.Договор;
					КонецЕсли;	
				Иначе	
					Если ЗначениеЗаполнено(Договор) Тогда
						НоваяСтрока.ДопАналитика = Договор;
					КонецЕсли;	
				КонецЕсли;	
			ИначеЕсли СтрокаСчета.ВидДопАналитики = СубконтоКонтрагенты И ЗначениеЗаполнено(Контрагент) Тогда
				НоваяСтрока.ДопАналитика = Контрагент;
			КонецЕсли;	
		КонецЕсли;	
		
		Если СтрокаСчета.УчетПоКПС Тогда
			НоваяСтрока.КПС = СтрокаТЧ.КПС;
		КонецЕсли;	
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Подразделение;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	// Теперь нужно заполнить ДопАналитику по остаткам, если она есть на счетах. Например, если передача идет
	// по счетам 108.90, то там может быть договор	
	УправлениеОсновнымиСредствами.ЗаполнитьДопАналитикуВТаблицеСписанияОС(ТабСчетов, ТаблицаДока, ЭтотОбъект);

	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	
	ТаблицаДока = ТаблицаСписанияОС();

	МассивВОсКонтролемОбременений = Новый Массив;
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.Передача);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.ПередачаУправление);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.ПередачаАренда);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.ПередачаБезмозмездноеПользование);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.Реализация);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.ПередачаИКвФинансовуюАренду);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийИК.ПередачаЗемУчастковВПользование);
	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(ТаблицаДока, ЭтотОбъект, 
		МассивВОсКонтролемОбременений.Найти(ВидОперации) <> Неопределено);
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецЕсли