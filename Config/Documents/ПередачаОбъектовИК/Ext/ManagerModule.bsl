#Область ВводНаОсновании

// Формирует таблицу разделителей для формирования нескольких документов "Передача объектов ИК" на основании одного документа
// "Поступление ИК"                  
// 
// Параметры:
//  - ДокОснование - ДокументСсылка - документ-основание
//
// Возвращает таблицу значений с полями:
//  * ПеречислениеСсылка.КФО
//  * ПеречислениеСсылка.ВидыИмущества
Функция ТаблицаРазделителейДокументов_ПоступлениеОСИК(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	СвойстваОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Дата, Организация");
	Счета_Казна = БухгалтерскийУчет.СписокСчетов(
		"106.50", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_ВКонцессии = БухгалтерскийУчет.СписокСчетов(
		"106.90", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТЧОсновныеСредства.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_Казна)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.Казна)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ВКонцессии)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|	КОНЕЦ КАК ВидИмущества
	|ИЗ
	|	Документ.ПоступлениеОСИК.КапВложения КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧОсновныеСредства.КФО,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_Казна)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.Казна)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ВКонцессии)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|	КОНЕЦ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("Счета_Казна", Счета_Казна);
	Запрос.УстановитьПараметр("Счета_ВКонцессии", Счета_ВКонцессии);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Передача объектов ИК" на основании одного документа
// "Принятие к учету ОС, НМА, НПА (Имущество казны)"                  
// 
// Параметры:
//  - ДокОснование - ДокументСсылка - документ-основание
//
// Возвращает таблицу значений с полями:
//  * ПеречислениеСсылка.КФО
//  * ПеречислениеСсылка.ВидыИмущества
Функция ТаблицаРазделителейДокументов_ПринятиеКУчетуОбъектовИК(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "ВидПоступления");
	
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	Если РеквизитыДокумента.ВидПоступления = Перечисления.ВидыОперацийИК.ПоступлениеЗабаланс Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета КАК СчетУчета,
		|	СУММА(ТЧОсновныеСредства.Количество) КАК Количество
		|ПОМЕСТИТЬ ОС_УжеПереданные
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|		ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|		ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|		ВЫБОР
		|			КОГДА ТЧОсновныеСредства.СчетУчета В ИЕРАРХИИ (&Счет01)
		|				ТОГДА &Счет01
		|			ИНАЧЕ &Счет02
		|		КОНЕЦ КАК СчетУчета,
		|		ТЧОсновныеСредства.Количество КАК Количество
		|	ИЗ
		|		Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ТЧОсновныеСредства
		|	ГДЕ
		|		ТЧОсновныеСредства.Ссылка.ДокументОснование = &Ссылка
		|		И НЕ ТЧОсновныеСредства.Ссылка.ПометкаУдаления
		|		И (&НетСсылкиЦелевогоДокумента 
		|			ИЛИ ТЧОсновныеСредства.Ссылка <> &СсылкаЦелевогоДокумента)) КАК ТЧОсновныеСредства
		|СГРУППИРОВАТЬ ПО
		|	ТЧОсновныеСредства.ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер,
		|	ТЧОсновныеСредства.ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|		ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|		ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|		ВЫБОР
		|			КОГДА ТЧОсновныеСредства.СчетУчетаОС В ИЕРАРХИИ (&Счет01)
		|				ТОГДА &Счет01
		|			ИНАЧЕ &Счет02
		|		КОНЕЦ КАК СчетУчета,
		|		ТЧОсновныеСредства.Количество КАК Количество
		|	ИЗ
		|		Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ТЧОсновныеСредства
		|	ГДЕ
		|		ТЧОсновныеСредства.Ссылка = &Ссылка) КАК ТЧОсновныеСредства
		|	ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПереданные КАК ОС_УжеПереданные
		|		ПО ТЧОсновныеСредства.ОсновноеСредство = ОС_УжеПереданные.ОсновноеСредство	
		|		И ТЧОсновныеСредства.ВидИмущества = ОС_УжеПереданные.ВидИмущества	
		|		И ТЧОсновныеСредства.СчетУчета = ОС_УжеПереданные.СчетУчета
		|ГДЕ
		|	ТЧОсновныеСредства.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0) > 0
		|СГРУППИРОВАТЬ ПО
		|	ТЧОсновныеСредства.ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета
		|";
		
		СтруктураРазделителей.Вставить("ЗаголовкиКолонок", 
			Новый Структура("ВидИмущества, СчетУчета", "Вид имущества", "Счет учета"));
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|	СУММА(ТЧОсновныеСредства.Количество) КАК Количество
		|ПОМЕСТИТЬ ОС_УжеПереданные
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка.ДокументОснование = &Ссылка
		|	И НЕ ТЧОсновныеСредства.Ссылка.ПометкаУдаления
		|	И (&НетСсылкиЦелевогоДокумента 
		|		ИЛИ ТЧОсновныеСредства.Ссылка <> &СсылкаЦелевогоДокумента)
		|СГРУППИРОВАТЬ ПО	
		|	ТЧОсновныеСредства.ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Ссылка.ВидИмущества
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|		ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|		ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|		ТЧОсновныеСредства.Количество КАК Количество
		|	ИЗ
		|		Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ТЧОсновныеСредства
		|	ГДЕ
		|		ТЧОсновныеСредства.Ссылка = &Ссылка) КАК ТЧОсновныеСредства
		|	ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПереданные КАК ОС_УжеПереданные
		|		ПО ТЧОсновныеСредства.ОсновноеСредство = ОС_УжеПереданные.ОсновноеСредство	
		|		И ТЧОсновныеСредства.ИнвентарныйНомер = ОС_УжеПереданные.ИнвентарныйНомер
		|		И ТЧОсновныеСредства.ВидИмущества = ОС_УжеПереданные.ВидИмущества
		|ГДЕ
		|	ТЧОсновныеСредства.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0) > 0
		|СГРУППИРОВАТЬ ПО	
		|	ТЧОсновныеСредства.ВидИмущества
		|";
		
		СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ВидИмущества", "Вид имущества"));
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("Счет01", БухгалтерскийУчет.СчетПоКоду("01"));
	Запрос.УстановитьПараметр("Счет02", БухгалтерскийУчет.СчетПоКоду("02"));
	Запрос.УстановитьПараметр("СсылкаЦелевогоДокумента", СсылкаЦелевогоДокумента);
	Запрос.УстановитьПараметр("НетСсылкиЦелевогоДокумента", НЕ ЗначениеЗаполнено(СсылкаЦелевогоДокумента));
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить(); 
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	
	Возврат СтруктураРазделителей;
КонецФункции	

