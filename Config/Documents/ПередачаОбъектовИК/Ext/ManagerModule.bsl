// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьКарточекКапвложений") Тогда
		
		ДанныеДляПечати = 
			УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов, "КарточкаКапвложений");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ПечатьКарточекКапвложений", НСтр("ru = 'Карточки капвложений (ф.0509211)'"), 
		Справочники.КарточкиКапвложений.Печать0509211(ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек") Тогда
		
		ДанныеДляПечати = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки(ДанныеДляПечати, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_103н",
			"Накладная на отпуск материалов на сторону (ф.0504205) (в ред.103н)",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205_103н"));
		
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_52н",
			"Накладная на отпуск материалов на сторону (ф.0504205)",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205"));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт", ЕдиницаИзмерения);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Ссылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДебет,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКредит,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК Количество
	|ПОМЕСТИТЬ Проводки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор В (&МассивОбъектов), , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПередачаОбъектовИК.Ссылка КАК Ссылка,
	|	ПередачаОбъектовИК.Дата КАК Дата,
	|	ПередачаОбъектовИК.Номер КАК Номер,
	|	ПередачаОбъектовИК.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИК.Организация.НаименованиеПолное = """"
	|			ТОГДА ПередачаОбъектовИК.Организация.Наименование
	|		ИНАЧЕ ПередачаОбъектовИК.Организация.НаименованиеПолное
	|	КОНЕЦ КАК Отправитель,
	|	ПередачаОбъектовИК.Организация.КодОКПО КАК ОКПООтправитель,
	|	ПередачаОбъектовИК.Организация.ИНН КАК ИННОтправитель,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИК.Подразделение.ОбособленноеПодразделение
	|			ТОГДА ПередачаОбъектовИК.Подразделение.РегистрацияВНалоговомОргане.КПП
	|		ИНАЧЕ ПередачаОбъектовИК.Организация.КПП
	|	КОНЕЦ КАК КППОтправитель,
	|	ПередачаОбъектовИК.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИК.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ПередачаОбъектовИК.Подразделение.Представление
	|		ИНАЧЕ ПередачаОбъектовИК.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК ПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИК.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ПередачаОбъектовИК.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ПередачаОбъектовИК.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ПередачаОбъектовИК.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ПередачаОбъектовИК.Контрагент.Представление
	|				КОНЕЦ
	|		ИНАЧЕ ПередачаОбъектовИК.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК Получатель,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИК.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ПередачаОбъектовИК.Контрагент.ЮридическоеФизическоеЛицо.КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОКПОПолучатель,
	|	ПередачаОбъектовИК.Контрагент.ИНН КАК ИННПолучатель,
	|	ПередачаОбъектовИК.Контрагент.КПП КАК КПППолучатель,
	|	ПередачаОбъектовИК.Договор.Представление КАК Договор,
	|	ПередачаОбъектовИК.ЦМО.Сотрудник КАК Отпустил,
	|	ПередачаОбъектовИК.Ответственный КАК Ответственный,
	|	ПередачаОбъектовИК.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.НомерПаспорта КАК СТРОКА(100)), """") <> """"
	|			ТОГДА ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.НомерПаспорта
	|		КОГДА ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.ИнойНомер, """") <> """"
	|			ТОГДА ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.ИнойНомер
	|		КОГДА ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.Код, """") <> """"
	|			ТОГДА ПередачаОбъектовИКОсновныеСредства.ИнвентарныйНомер.Код
	|		ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство.Код
	|	КОНЕЦ КАК НомерПаспорта,
	|	ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство.НоменклатурныйНомер КАК НомерНоменклатурный,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК ЕдиницаКод,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдиницаНаименование,
	|	ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.ЦенаПродажи, 0) КАК Цена,
	|	ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.СуммаНДС, 0) КАК СуммаНДС,
	|	ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.СуммаПродажи, 0) КАК СуммаБезНДС,
	|	ЕСТЬNULL(ПередачаОбъектовИКОсновныеСредства.Всего, 0) КАК СуммаВсего,
	|	ПередачаОбъектовИКОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Проводки.СчетДебет.Представление, """") КАК СчетДт,
	|	ЕСТЬNULL(Проводки.КПСДт.Представление, """") КАК КПСДт,
	|	ЕСТЬNULL(Проводки.КЭКДт.Представление, """") КАК КЭКДт,
	|	ЕСТЬNULL(Проводки.СчетКредит.Представление, """") КАК СчетКт,
	|	ЕСТЬNULL(Проводки.КПСКт.Представление, """") КАК КПСКт,
	|	ЕСТЬNULL(Проводки.КЭККт.Представление, """") КАК КЭККт
	|ИЗ
	|	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ПередачаОбъектовИКОсновныеСредства
	|			ЛЕВОЕ СОЕДИНЕНИЕ Проводки КАК Проводки
	|			ПО ПередачаОбъектовИКОсновныеСредства.Ссылка = Проводки.Ссылка
	|				И ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство = Проводки.ОсновноеСредство
	|				И ПередачаОбъектовИКОсновныеСредства.СчетУчета = Проводки.СчетКредит
	|				И (Проводки.Количество <> 0)
	|		ПО ПередачаОбъектовИК.Ссылка = ПередачаОбъектовИКОсновныеСредства.Ссылка
	|ГДЕ
	|	ПередачаОбъектовИК.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Возврат УправлениеПечатьюБГУ.Напечатать0504205(Запрос, ОбъектыПечати, ИмяМакета);
	
КонецФункции

Функция ДанныеДляТТН(Ссылка, ОбщийИтог = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Запрос.Текст = Документы.ПередачаОбъектовОС.ТекстЗапросаОСДляТТН(ОбщийИтог,"Документ.ПередачаОбъектовИК");
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

#КонецОбласти

