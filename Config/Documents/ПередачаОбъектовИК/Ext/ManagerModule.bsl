	Запрос.УстановитьПараметр("Руководитель", Руководитель.ОтветственноеЛицоСсылка);
	Запрос.УстановитьПараметр("ГлБухгалтер", ГлБухгалтер.ОтветственноеЛицоСсылка);
	Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);
	Запрос.УстановитьПараметр("КратностьВзаиморасчетов", КратностьВзаиморасчетов);
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", ВалютаРегУчета);
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЭлектронныеДокументыБГУ.Штуки());
	
	Возврат(Запрос.ВыполнитьПакет());
