// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ТекОрганизация = ДокументОбъект.Организация;
	ТекДата        = ДокументОбъект.Дата;
	Для каждого СтрокаТЧ из ДокументОбъект.ОсновныеСредства Цикл
		Если НЕ ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(СтрокаТЧ.СчетУчета) Тогда
			Продолжить;
		ИначеЕсли НЕ СтрокаТЧ.ОтразитьВКарточкеКапвложений ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда
			Продолжить;
		ИначеЕсли ТабДвижений.Найти(СтрокаТЧ.КарточкаКапвложений, "КарточкаКапвложений") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ТекОрганизация;
		НоваяСтрока.КарточкаКапвложений = СтрокаТЧ.КарточкаКапвложений;
		НоваяСтрока.Период              = ТекДата;
	КонецЦикла;	

	Возврат Истина;
КонецФункции	

Функция ВОсВнутреннимПеремещением() Экспорт
	ВОсВнутреннимПеремещением = Новый Массив;
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаУправление"));
	ВОсВнутреннимПеремещением.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаАренда"));
	ВОсВнутреннимПеремещением.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование"));
		
	Возврат ВОсВнутреннимПеремещением;
КонецФункции	

// Формирует данные табличной части (ТЧ) документа для проверки остатков в функции ПолучитьОстаткиОСЗабаланс
// общего модуля БухгалтерскиеОперацииПовтИсп
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПередачаОбъектовИК - документ, для которого собираем данные ТЧ
//
// Возвращаемое значение:
//  - ТаблицаЗначений - таблица, содержащая данные ТЧ 
Функция ДанныеТЧдляПроверкиОстатковЗабалансомВТО(ДокументСсылка) Экспорт
	ДоговорВТабличнойЧасти = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДоговорВТабличнойЧасти");
	
	Если ДоговорВТабличнойЧасти Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьДоговоры,		
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьКонтрагенты
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.Ссылка В
		|		(ВЫБРАТЬ
		|			Таб.СчетУчета
		|		ИЗ
		|			ТабЧасть КАК Таб)
		|	И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|	ИЛИ ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУВидыСубконто.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть.НомерСтроки КАК НомерСтроки,
		|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
		|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТабЧасть.КПС КАК КПС,
		|	ТабЧасть.Количество КАК Количество,
		|	ТабЧасть.Сумма КАК Сумма,
		|	ТабЧасть.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьКонтрагенты
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьДоговоры
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Договор
		|	КОНЕЦ КАК Договор
		|ИЗ
		|	ТабЧасть КАК ТабЧасть
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
		|		ПО Счета.Ссылка = ТабЧасть.СчетУчета
		|";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Передача объектов ИК" на основании 
// одного документа
// 
// Параметры:
//  - ДокОснование - ДокументСсылка - документ-основание
//
// Возвращает таблицу значений с полями:
//  * ПеречислениеСсылка.КФО
//  * ПеречислениеСсылка.ВидыИмущества
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
		Возврат ТаблицаРазделителейДокументов_ПоступлениеОСИК(ДокОснование, СсылкаЦелевогоДокумента);
	ИначеЕсли ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		Возврат ТаблицаРазделителейДокументов_ПринятиеКУчетуОбъектовИК(ДокОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередачаОбъектовИК.ВидИмущества КАК ВидИмущества,
	|	ПередачаОбъектовИК.ВидОперации КАК ВидОперации,
	|	ПередачаОбъектовИК.ЦМО КАК ЦМО,
	|	ПередачаОбъектовИК.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ПередачаОбъектовИК.Дата КАК Дата,
	|	ПередачаОбъектовИК.Номер КАК Номер,
	|	ПередачаОбъектовИК.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ПередачаОбъектовИК.ДоговорВТабличнойЧасти КАК ДоговорВТабличнойЧасти,
	|	ПередачаОбъектовИК.Резервировать КАК Резервировать
	|ИЗ
	|	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
	|ГДЕ
	|	ПередачаОбъектовИК.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДатыПроведенияДокументов.ДатаПроведения КАК ДатаПроведения
	|ИЗ
	|	РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|ГДЕ
	|	ДатыПроведенияДокументов.Документ = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.ВыполнитьПакет();
	
	РеквизитыДокумента = Новый Структура();
	ДанныеДокумента = Результат[0].Выгрузить();
	Если ДанныеДокумента.Количество() > 0 Тогда
		Для каждого ТекКолонка из ДанныеДокумента.Колонки Цикл
			РеквизитыДокумента.Вставить(ТекКолонка.Имя, ДанныеДокумента[0][ТекКолонка.Имя]);
		КонецЦикла;	
	КонецЕсли;	
	
	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	// Если задана дата проведения, будем использовать ее в запросах
	ВыборкаДатаПроведения = Результат[1].Выбрать();
	Если ВыборкаДатаПроведения.Следующий() И ЗначениеЗаполнено(ВыборкаДатаПроведения.ДатаПроведения) Тогда
		РеквизитыДокумента.Вставить("Дата", ВыборкаДатаПроведения.ДатаПроведения);
	КонецЕсли;	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	
	НомераТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"	, НСтр("ru = 'Акт о приеме-передаче объектов НФА'"));
	Запрос.УстановитьПараметр("НомерДокумента"	, НомерДокумента);
		
	Если НЕ РеквизитыДокумента.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаКапвложений Тогда
			
		ЭтоПередачаВПользование = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(
			РеквизитыДокумента.ВидОперации) 
			И РеквизитыДокумента.ВидОперации <> Перечисления.ВидыОперацийИК.ПередачаЗемУчастковВПользование;
		Запрос.УстановитьПараметр("ЭтоПередачаВПользование", ЭтоПередачаВПользование);
		
		НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|		ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ КАК ДатаСписанияСБухУчета,
		|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
		|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
		|	ТаблицаОсновныеСредства.Ссылка.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
		|	ВЫБОР
		|		КОГДА ВидыСубконтоЦМО.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ЦМО
		|	КОНЕЦ КАК ЦМО,
		|	ВЫБОР
		|		КОГДА ВидыСубконтоЦМО.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель
		|	КОНЕЦ КАК ЦМОПолучатель,
		|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
		|	ТаблицаОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТаблицаОсновныеСредства.Количество КАК Количество,
		|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
		|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
		|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
		|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
		|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента = """"
		|			ТОГДА &ИмяДокумента
		|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента
		|	КОНЕЦ КАК НазваниеДокумента,
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента = """"
		|			ТОГДА &НомерДокумента
		|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента
		|	КОНЕЦ КАК НомерДокумента,
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
		|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента
		|	КОНЕЦ КАК ДатаДокумента,
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
		|		ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПообъектныйУчет,
		|	ТаблицаОсновныеСредства.Ссылка.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов
		|ПОМЕСТИТЬ ТаблицаОсновныеСредства
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ТаблицаОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконтоЦМО
		|		ПО ТаблицаОсновныеСредства.СчетУчета = ВидыСубконтоЦМО.Ссылка
		|		И (ВидыСубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
		|ГДЕ
		|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	ИнвентарныйНомер";
		
		Если РеквизитыДокумента.ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии Тогда
			ДополнитьТекстЗапросаПолучениемДоговора(Запрос.Текст);
			Запрос.УстановитьПараметр("Период", РеквизитыДокумента.Дата);
		КонецЕсли;
		
		Если РеквизитыДокумента.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование
			Или РеквизитыДокумента.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаОСнаХранении Тогда
			Если РеквизитыДокумента.ДоговорВТабличнойЧасти Тогда
				ДополнитьТекстЗапросаПолучениемКонтрагента_ДоговорВТЧ(Запрос.Текст);
			Иначе			
				ДополнитьТекстЗапросаПолучениемКонтрагента(Запрос.Текст);
			КонецЕсли;	
			Запрос.УстановитьПараметр("Период", РеквизитыДокумента.Дата);
			Если РеквизитыДокумента.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование Тогда
				ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
			Иначе
				ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
			КонецЕсли;
			Запрос.УстановитьПараметр("ВидРаспоряженияК", ВидРаспоряжения);
		КонецЕсли;
		
		НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК ДатаСобытия,
		|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
		|ГДЕ
		|	НЕ &ЭтоПередачаВПользование
		|	И ТаблицаОсновныеСредства.ПообъектныйУчет";
		
		// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
		ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления(РеквизитыДокумента.ВидОперации);
		ПараметрыСписания.ПередачаЧастейОбъектов = РеквизитыДокумента.ПередачаЧастейОбъектов;
		
		УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(
			Запрос, НомераТаблиц, ДокументСсылка, ПараметрыСписания);
	КонецЕсли;
		
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());	
	Запрос.Текст = Запрос.Текст + ?(НомераТаблиц.Количество() > 1, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка КАК Документ.ПередачаОбъектовИК).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПередачаКапвложений)
	|			ТОГДА ПередачаОбъектовИКДрагоценныеМатериалы.ОбъектМЦ
	|		ИНАЧЕ ПередачаОбъектовИКДрагоценныеМатериалы.ОбъектНФА
	|	КОНЕЦ КАК ОбъектНФА,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка КАК Документ.ПередачаОбъектовИК).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПередачаКапвложений)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|		ИНАЧЕ ПередачаОбъектовИКДрагоценныеМатериалы.ИнвНомер
	|	КОНЕЦ КАК ИнвНомер,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ИСТИНА КАК ЭтоСписание,
	|	ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	|ИЗ
	|	Документ.ПередачаОбъектовИК.ДрагоценныеМатериалы КАК ПередачаОбъектовИКДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	ПередачаОбъектовИКДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И ПередачаОбъектовИКДрагоценныеМатериалы.МассаДМ > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки"; 
	 
КонецПроцедуры	

Процедура ДополнитьТекстЗапросаПолучениемДоговора(ТекстЗапроса)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)", "СтоимостьОбъектовОСОстатки.Договор");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ГДЕ", "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|				&Период,
	|				(Организация, ОсновноеСредство)
	|					В (ВЫБРАТЬ ВТ.Ссылка.Организация, ВТ.ОсновноеСредство ИЗ Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ВТ ГДЕ ВТ.Ссылка = &Ссылка)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = СтоимостьОбъектовОСОстатки.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = СтоимостьОбъектовОСОстатки.ИнвентарныйНомер
	|ГДЕ");
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаПолучениемКонтрагента(ТекстЗапроса)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОсновныеСредства.Ссылка.Контрагент" , "СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)", "СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ГДЕ", "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|				&Период,
	|				(Организация, ОсновноеСредство)
	|					В (ВЫБРАТЬ ВТ.Ссылка.Организация, ВТ.ОсновноеСредство ИЗ Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ВТ ГДЕ ВТ.Ссылка = &Ссылка)
	|				И ВидРаспоряжения = &ВидРаспоряженияК) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер
	|ГДЕ");
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаПолучениемКонтрагента_ДоговорВТЧ(ТекстЗапроса)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОсновныеСредства.Ссылка.Контрагент",
	"ВЫБОР
	|		КОГДА НЕ СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент ЕСТЬ NULL
	|			ТОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)", 
	"ВЫБОР
	|		КОГДА НЕ СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор ЕСТЬ NULL
	|			ТОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ГДЕ", "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|				&Период,
	|				(Организация, ОсновноеСредство)
	|					В (ВЫБРАТЬ 
	|							ВТ.Ссылка.Организация, 
	|							ВТ.ОсновноеСредство 
	|						ИЗ Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ВТ ГДЕ ВТ.Ссылка = &Ссылка)
	|				И ВидРаспоряжения = &ВидРаспоряженияК) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер
	|			И ТаблицаОсновныеСредства.Ссылка.Контрагент = СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент
	|			И ТаблицаОсновныеСредства.Договор = СтоимостьОбъектовОСПоКонтрагентамОстатки.Договор
	|ГДЕ");
	
КонецПроцедуры

