#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																				ДокументСсылка.Дата);
	ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																				ДокументСсылка.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПередачаОбъектовИК.Номер КАК Номер,
	               |	ПередачаОбъектовИК.Дата КАК Дата,
	               |	ПередачаОбъектовИК.Организация КАК Организация,
	               |	ПередачаОбъектовИК.Контрагент КАК Контрагент,
	               |	ПередачаОбъектовИК.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	               |	ПередачаОбъектовИК.Грузоотправитель КАК Грузоотправитель,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.РасчетныйСчетГрузоотправителя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовИК.РасчетныйСчетГрузоотправителя
	               |	КОНЕЦ КАК СчетГрузоотправителя,
	               |	ПередачаОбъектовИК.Грузополучатель КАК Грузополучатель,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.РасчетныйСчетГрузополучателя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовИК.РасчетныйСчетГрузополучателя
	               |		КОГДА ПередачаОбъектовИК.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовИК.РасчетныйСчетКонтрагента
	               |	КОНЕЦ КАК СчетГрузополучателя,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	               |	ПередачаОбъектовИК.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	&Руководитель КАК Руководитель,
	               |	&ГлБухгалтер КАК ГлавныйБухгалтер,
	               |	ЗНАЧЕНИЕ(Документ.ПередачаОбъектовИК.ПустаяСсылка) КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.Договор КАК Справочник.Договоры) КАК Договор,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИК.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИК.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименование,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовИК.ВалютаДокумента
	               |		ИНАЧЕ &РегламентированнаяВалюта
	               |	КОНЕЦ КАК Валюта,
	               |	ПередачаОбъектовИК.Контрагент.ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	               |	ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					КОГДА НЕ ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	               |					КОГДА ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |							И НЕ ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |						ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |					ИНАЧЕ ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.Наименование
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИК.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					ИНАЧЕ ПередачаОбъектовИК.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	               |	ПередачаОбъектовИК.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
	               |	ПередачаОбъектовИК.Ссылка КАК Ссылка,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУВид КАК ОтветственныйПередалТРУВид,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУДолжность КАК ОтветственныйПередалТРУДолжность,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУОснованиеПолномочий КАК ОтветственныйПередалТРУОснованиеПолномочий,
	               |	ПередачаОбъектовИК.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	               |	ПередачаОбъектовИК.ДатаПередачиТРУ КАК ДатаПередачиТРУ,
	               |	ПередачаОбъектовИК.ТРУПереданы КАК ТРУПереданы
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
	               |ГДЕ
	               |	ПередачаОбъектовИК.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПередачаОбъектовИКОсновныеСредства.НомерСтроки КАК НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное
	               |	КОНЕЦ КАК ТоварНаименование,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НоменклатурныйНомер = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НоменклатурныйНомер
	               |	КОНЕЦ КАК КодТовара,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование) КАК ЕдиницаИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код) КАК БазоваяЕдиницаКод,
	               |	ПередачаОбъектовИКОсновныеСредства.Количество КАК МассаНетто,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НЕ ПередачаОбъектовИКОсновныеСредства.Ссылка.СуммаВключаетНДС
	               |				ТОГДА ПередачаОбъектовИКОсновныеСредства.СтоимостьЕдиницы
	               |			КОГДА ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (ПередачаОбъектовИКОсновныеСредства.Всего - ПередачаОбъектовИКОсновныеСредства.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА ПередачаОбъектовИКОсновныеСредства.Количество = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Количество
	               |					КОНЕЦ
	               |			КОГДА ПередачаОбъектовИКОсновныеСредства.СуммаНДС = 0 И ПередачаОбъектовИКОсновныеСредства.СтоимостьЕдиницы <> 0
	               |				ТОГДА ПередачаОбъектовИКОсновныеСредства.СтоимостьЕдиницы
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовИКОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовИКОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Всего - ПередачаОбъектовИКОсновныеСредства.СуммаНДС
	               |				КОНЕЦ / ВЫБОР
	               |					КОГДА ПередачаОбъектовИКОсновныеСредства.Количество = 0
	               |						ТОГДА 1
	               |					ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Количество
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК Цена,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ВЫБОР
	               |						КОГДА ПередачаОбъектовИКОсновныеСредства.Всего = 0
	               |							ТОГДА ПередачаОбъектовИКОсновныеСредства.Сумма
	               |						ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Всего - ПередачаОбъектовИКОсновныеСредства.СуммаНДС
	               |					КОНЕЦ * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовИКОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовИКОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Всего - ПередачаОбъектовИКОсновныеСредства.СуммаНДС
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаБезНДС,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовИКОсновныеСредства.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	               |		ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.СтавкаНДС
	               |	КОНЕЦ КАК СтавкаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ПередачаОбъектовИКОсновныеСредства.СуммаНДС * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовИКОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ВЫБОР
	               |						КОГДА ПередачаОбъектовИКОсновныеСредства.Всего = 0
	               |							ТОГДА ПередачаОбъектовИКОсновныеСредства.Сумма
	               |						ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Всего
	               |					КОНЕЦ * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовИКОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовИКОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовИКОсновныеСредства.Всего
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаСНДС,
	               |	ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).СтранаПроисхождения.Код) КАК КодСтраныПроисхождения,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).СтранаПроисхождения.Наименование КАК НаименованиеСтраныПроисхождения,
	               |	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	               |	""1"" КАК Признак,
	               |	ПередачаОбъектовИКОсновныеСредства.Количество КАК Количество,
	               |	"""" КАК ПризнакДополнительнаяИнформация,
	               |	ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдиницаИзмеренияНаименование,
	               |	ПередачаОбъектовИКОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодКаталога КАК КодКаталога,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодПоКТРУ КАК КодПоКТРУ,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИКОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодТНВЭД КАК КодТНВЭД,
	               |	"""" КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ПередачаОбъектовИКОсновныеСредства
	               |ГДЕ
	               |	ПередачаОбъектовИКОсновныеСредства.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПередачаОбъектовИККодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ПередачаОбъектовИККодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	               |	ПередачаОбъектовИККодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК.КодыУпаковокМаркируемойПродукции КАК ПередачаОбъектовИККодыУпаковокМаркируемойПродукции
	               |ГДЕ
	               |	ПередачаОбъектовИККодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПередачаОбъектовИКСведенияПрослеживаемости.РНПТ КАК РНПТ,
	               |	ПередачаОбъектовИКСведенияПрослеживаемости.Количество КАК Количество,
	               |	ПередачаОбъектовИКСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	               |	ПередачаОбъектовИКСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК.СведенияПрослеживаемости КАК ПередачаОбъектовИКСведенияПрослеживаемости
	               |ГДЕ
	               |	ПередачаОбъектовИКСведенияПрослеживаемости.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.НомерСтроки КАК НомерСтроки,
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС КАК ИдентификаторДляАктированияЕИС,
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.СтранаПроизводителя КАК СтранаПроизводителя,
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.ОбъемВТекстовомВыражении КАК ОбъемВТекстовомВыражении
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК.ДанныеДляАктированияЕИС КАК ПередачаОбъектовИКДанныеДляАктированияЕИС
	               |ГДЕ
	               |	ПередачаОбъектовИКДанныеДляАктированияЕИС.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
