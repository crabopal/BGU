&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

#Область ЭДОСКонтрагентами

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхПродавца = Ложь, ВидимостьЭлементовАктирования = Ложь)

	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	
	ВидимостьЭлементовРеализации =
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация");
		
	Если НЕ ВидимостьЭлементовРеализации Тогда
		ВидимостьЭлементовЭДО = Ложь;	
	КонецЕсли;		
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КомандыЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваМаркируемыеУпаковки", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовМаркировки);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаДополнительныеСведенияОМаркированныхТоварах", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРеализацияДляГосНужд", "Видимость", ВидимостьДанныхПродавца);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваПредставлениеДляАктированияЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваСтраныТовараЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ТоварыУслугиЗаполнитьПоКонтракту", "Видимость", ВидимостьЭлементовАктирования);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СостояниеЭТрН", "Видимость", Форма.МожноОформитьЭПД);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭПД", "Видимость", Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН);

	Если Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЭДОПродавцаДляГосНужд(ВидимостьДанныхПродавца)
	
	Если ВидимостьДанныхПродавца Тогда 
		ДанныеЭДОДоговора = ЭлектронныеДокументыБГУ.ДанныеЭДОПродавцаДляГосНужд(Объект.Договор);
		Если Не ЗначениеЗаполнено(Объект.КПСПродавца) Тогда
			Объект.КПСПродавца = ДанныеЭДОДоговора.КПСПродавца;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.КодЦелиПродавца) Тогда
			Объект.КодЦелиПродавца = ДанныеЭДОДоговора.КодЦелиПродавца;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.РасчетныйСчетКонтрагента) Тогда
			Объект.РасчетныйСчетКонтрагента = ДанныеЭДОДоговора.СчетКонтрагента;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаВозврат", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
			Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма						= ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка			= Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект			= РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО	= Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО		= Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

#КонецОбласти

#Область МаркировкаПродукции

&НаСервере
Функция МаркируемыйТовар(ИдентификаторНоменклатуры)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторНоменклатуры).ОсновноеСредство);
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОбменСЛКПоставщикаЕИС

&НаСервере
Процедура ЗаполнитьПоКонтрактуНаСервере()
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьПоКонтрактуНаСервере(ЭтотОбъект);
	ЭлектронноеАктированиеБГУ.ЗаполнитьСлужебныеДанныеЕИС(ЭтотОбъект, "ОсновныеСредства", "ОсновныеСредства");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ЭлектронныеДокументыБГУ.ЗаполнитьРеквизитыМаркировки(Объект, "ОсновныеСредства");
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ТекСтрока.СтоимостьЕдиницы = ТекСтрока.ЦенаПродажи;
	КонецЦикла;
	
	ЗаполнитьПоясненияВсехСтрок();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКонтрактуПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоКонтрактуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", ИмяРеквизита <> "Цена");
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

#КонецОбласти

#Область УчетДрагМатериалов

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
		
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	ТЧ = Объект.ОсновныеСредства.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.ОсновноеСредство,
			|	ТаблицаОбъектовНФА.ИнвентарныйНомер,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.ОсновноеСредство КАК ОбъектНФА,
			|	СписокНФАСписания.ИнвентарныйНомер КАК ИнвНомер,
			|	СписокНФАСписания.Количество
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания";
			
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТЧ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ЭтоПередачаКапвложенийИК = 
		Объект.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаКапвложений;
	
	Если ЭтоПередачаКапвложенийИК И ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);		
	Иначе
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияОС(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков, Истина);
	КонецЕсли;

	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОсновноеСредство);
		Если НЕ ЭтоПередачаКапвложенийИК Тогда
			ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвентарныйНомер);
		КонецЕсли;	
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);		
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ?(ЭтоПередачаКапвложенийИК, ТекСтрока.Количество, ТекСтрокаМассива.КоличествоВсего); 
				Прервать;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийИК.ПередачаКапвложений И ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	Иначе 
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляИК();
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер); 
		КонецЕсли;
	КонецЦикла;	
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Для каждого ТекущаяСтрока Из Форма.ОбъектыНФАСДрагМатериалами Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры	

