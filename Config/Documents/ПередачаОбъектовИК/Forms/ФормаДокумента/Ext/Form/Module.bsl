&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыРеализации(Форма, ТекущиеДанные, ИмяРеквизита)

	Объект = Форма.Объект;
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", ИмяРеквизита <> "Цена");
	ПараметрыРасчета.Вставить("ИмяРеквизитаЦена", "ЦенаПродажи");
	ПараметрыРасчета.Вставить("ИмяРеквизитаСумма", "СуммаПродажи");
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(ТекущиеДанные, ИмяРеквизита, ПараметрыРасчета);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			
			ПересчитатьСуммыРеализации(ЭтотОбъект, ТекСтрока, "Сумма");
			
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуАмортизацииЗаТекущийМесяц(ТекущиеДанные = Неопределено)
	
	Если Объект.ВидОперации <> Перечисления.ВидыОперацийИК.Передача
		И Объект.ВидОперации <> Перечисления.ВидыОперацийИК.Реализация
		И Объект.ВидОперации <> Перечисления.ВидыОперацийИК.ПередачаИКвФинансовуюАренду
		ИЛИ Справочники.Организации.ПолучитьУчетнуюПолитику(
			Объект.Организация, Объект.Дата).НачислятьАмортизациюПервымЧислом Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		СписокОС = Новый Массив;
		СписокОС.Добавить(ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;

	ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(СписокОС, Объект, Ложь, Ложь, Истина);
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		Если ТекущиеДанные <> Неопределено И СтрокаТаблицы <> ТекущиеДанные Тогда
			Продолжить;
		КонецЕсли;
		СтрокаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");	
		Если СтрокаАмортизации = Неопределено Тогда
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = 0;
		Иначе			
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = СтрокаАмортизации.СуммаАмортизацииБУ;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеЗапчастей()
	
	Если Объект.Проведен И СписаниеЗапчастей.Пустая() Тогда
		
		СписокОсновныхСредств = Новый Массив;
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			СписокОсновныхСредств.Добавить(СтрокаТаблицы.ОсновноеСредство);
		КонецЦикла;
		
		Необходим = УправлениеМатериальнымиЗапасамиВызовСервера.ПроверитьОстаткиНаСчете09(
			Объект.Дата, Объект.Организация, Объект.ИФО,, СписокОсновныхСредств);
		Если Необходим Тогда
			Оповещение = Новый ОписаниеОповещения("СоздатьДокументСписанияЗапчастей", ЭтотОбъект, Объект.Ссылка);
			ТекстСообщения = НСтр("ru = 'У транспортных средств найдены запасные части.
                                   |Сформировать документ по списанию запасных частей?'");
			ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументСписанияЗапчастей(Результат, ДокументОС) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбщегоНазначенияБГУКлиент.ОткрытьФормуДокументаСписанияЗапчастей(ДокументОС, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиДокументСписанияЗапчастей()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктСписанияМЗ.Дата КАК Дата,
	|	АктСписанияМЗ.Номер КАК Номер,
	|	АктСписанияМЗ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.ДокументОснование = &Регистратор
	|	И АктСписанияМЗ.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СписаниеЗапчастей = Выборка.Ссылка;
	Иначе
		СписаниеЗапчастей = Документы.АктСписанияМЗ.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстСписаниеЗапчастей()
	
	Если ЗначениеЗаполнено(СписаниеЗапчастей) Тогда
		
		ЗначенияРеквизитов = РеквизитыДокументаОснования(СписаниеЗапчастей);
		Дата = ЗначенияРеквизитов.Дата;
		Номер = ЗначенияРеквизитов.Номер;
		
		ТекстНомер	= ?(ЗначениеЗаполнено(Номер), Номер, "...");
		ТекстДата	= ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДЛФ=D"), "...");
		ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Акт № %1 от %2 г.'"), ТекстНомер, ТекстДата);
	Иначе
		ТекстНадписи = НСтр("ru='Ввести списание запчастей'");
	КонецЕсли;
	
	ЭтаФорма["НадписьСписаниеЗапчастей"] = ТекстНадписи;
	
КонецПроцедуры

