&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Организация",,Отказ);
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ВидИмущества) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид имущества'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ВидИмущества",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ОсновныеСредстваМаркируемыеУпаковки" Тогда
		ТекДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
		
		Если ТекДанныеСтроки <> Неопределено И ТекДанныеСтроки.МаркируемыйТовар Тогда
			
			ИдентификаторСтроки = ТекДанныеСтроки.ИдентификаторСтроки;
			Если НЕ ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
				ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			
			СтандартнаяОбработка = Ложь;
			ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировки(ЭтотОбъект, СтандартнаяОбработка, "ОсновныеСредства");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки)

	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	НоваяСтрока = ТаблицаОС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	ЗаполнитьСтрокуТЧ(ТекущиеДанные, ТабОстатков);
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц(ТекущиеДанные);
	
КонецПроцедуры

