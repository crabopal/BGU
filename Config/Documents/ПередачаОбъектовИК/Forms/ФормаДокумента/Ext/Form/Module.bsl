КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСтоимостьЕдиницыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы;
	Иначе	
		ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекущиеДанные.Количество;
	КонецЕсли;	
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		//ТекущиеДанные.СтоимостьЕдиницы = 0;
		ТекущиеДанные.СтоимостьЕдиницы = ТекущиеДанные.Сумма;
	Иначе
		ТекущиеДанные.СтоимостьЕдиницы = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(ТекущиеДанные);
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекущиеДанные.Количество;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	ПересчитатьСуммыРеализации(ЭтотОбъект, ТекущиеДанные, "Количество");
	
КонецПроцедуры

