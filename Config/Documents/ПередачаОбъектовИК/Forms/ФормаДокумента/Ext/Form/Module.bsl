&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если НоваяСтрока И Не Копирование Тогда
		ЗаполнитьПоясненияВСтроке(ТекущиеДанные);

		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений")
			И НЕ ТекущиеДанные.ОтразитьВКарточкеКапвложений Тогда
			ТекущиеДанные.ОтразитьВКарточкеКапвложений = Истина;
		КонецЕсли;	
	КонецЕсли;
	Если Копирование Тогда
		ТекущиеДанные.ИдентификаторСтроки = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	ОбъектНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтаФорма, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ("+
						СокрЛП(ОбъектНаУдаление)+") на закладке ""Драгоценные материалы""?'"), Режим, 0);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПредставлениеДляАктированияЕИСПриИзменении(Элемент)

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СписокВыбора = Элемент.СписокВыбора;
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭлектронноеАктированиеЕИСКлиент.ПриИзмененииИдентификатораДляАктированияЕИС(
		СписокВыбора, "ОсновныеСредства", ТекущиеДанные);
	ДанныеСтроки = ЭлектронноеАктированиеЕИСВызовСервера.ДанныеСтрокиКонтрактаПоИдентификатору(
		Объект.Договор,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС);
	ТекущиеДанные.ЦенаПродажи = ДанныеСтроки.Цена;
	ТекущиеДанные.Всего = ДанныеСтроки.Сумма;		
	РасчитатьСтроку(Элементы.ОсновныеСредства.ТекущиеДанные, Объект.СуммаВключаетНДС, "Всего");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС

