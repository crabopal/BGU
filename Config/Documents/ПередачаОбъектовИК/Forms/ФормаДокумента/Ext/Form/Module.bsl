    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтоПередачаВКапвложенийИК = 	
		     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений"); 
	ВедетсяУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений()
		ИЛИ (ЭтоПередачаВКапвложенийИК И Объект.ДрагоценныеМатериалы.Количество() > 0);
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ(); 
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));

	ЗаполнитьПоясненияВсехСтрок();
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеТаблицыОсновныеСредства()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Получить(СтрокаТаблицы.ОсновноеСредство);
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС, "ГрупповойУчет,ВидНФА");
		КонецЕсли;
		УстановитьУчетПоКПСВСтроке(СтрокаТаблицы);
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Истина)

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, СообщатьОбОшибках);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперации");
	СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.Подразделение.ОтметкаНезаполненного Тогда
			СтруктураРеквизитов.Вставить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений") Тогда
		СтруктураРеквизитов.Вставить("ЦМО");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	НужнаАмортизация = Ложь;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКПолученныхВПользование")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаОСнаХранении") Тогда
		
		ВидРаспоряжения = ?(
			Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаОСнаХранении"),
			ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"),
			ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПолученоВПользование"));	
			
		ПараметрыПодбора.Отбор.Вставить("Контрагент", Объект.Контрагент);
		Если НЕ Объект.ДоговорВТабличнойЧасти Тогда
			ПараметрыПодбора.Отбор.Вставить("Договор", Объект.Договор);
		КонецЕсли;	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений") Тогда
		ВидРаспоряжения = "Вложения";
	Иначе
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		НужнаАмортизация = Истина;
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, ВидРаспоряжения);
	ПараметрыПодбора.Вставить("НужнаАмортизация", НужнаАмортизация);
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "ЦМО,Контрагент");
	ПараметрыПодбора.Вставить("КолонкиКорзины"	, Новый Структура("Цена", "СтоимостьЕдиницы"));
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, КодыСчетов);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений") Тогда
		ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМО);
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДоговорВТабличнойЧасти", Объект.ДоговорВТабличнойЧасти);
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
			УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
		КонецЕсли;
		
		Если Объект.ПередачаЧастейОбъектов И СтрокаТаблицы.Количество <> 0 Тогда
			СтрокаТаблицы.Количество = 0;
		КонецЕсли;	
		
		ЗаполнитьПоясненияВСтроке(СтрокаТаблицы);
		
	КонецЦикла;
	
	//РассчитатьСуммыНаСервере();
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
	ЗаполнитьСведенияДокументаСписания(ДобавленныеСтроки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияДокументаСписания(ДобавленныеСтроки)
	
	СписокОС = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
		СписокОС.Добавить(СтрокаТаблицы.ОсновноеСредство);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			 , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Организация"		 , Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство" , СписокОС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОС.Период КАК Период,
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.Причина КАК ПричинаСписания
	|ПОМЕСТИТЬ ДвиженияСписания
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация = &Организация
	|	И СтоимостьОбъектовОС.ВидРаспоряжения В (ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе), ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет))
	|	И СтоимостьОбъектовОС.ОсновноеСредство В(&ОсновноеСредство)
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период < &Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияСписания.ОсновноеСредство КАК ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ДвиженияСписания.Период) КАК Период
	|ПОМЕСТИТЬ МаксПериодСписания
	|ИЗ
	|	ДвиженияСписания КАК ДвиженияСписания
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияСписания.ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ДвиженияСписания.ОсновноеСредство, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредство,
	|	ЕСТЬNULL(ДвиженияСписания.ИнвентарныйНомер, """") КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ДвиженияСписания.ПричинаСписания, """") КАК ПричинаСписания
	|ИЗ
	|	МаксПериодСписания КАК МаксПериодСписания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияСписания КАК ДвиженияСписания
	|		ПО МаксПериодСписания.ОсновноеСредство = ДвиженияСписания.ОсновноеСредство
	|			И МаксПериодСписания.ИнвентарныйНомер = ДвиженияСписания.ИнвентарныйНомер
	|			И МаксПериодСписания.Период = ДвиженияСписания.Период";
	
	ДокументыСписания = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
		Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер", 
			СтрокаТаблицы.ОсновноеСредство, СтрокаТаблицы.ИнвентарныйНомер);
		
		Данные = ДокументыСписания.НайтиСтроки(Отбор);
		Если Данные.Количество() > 0 Тогда
			СтрокаТаблицы.ПричинаСписания = Данные[0].ПричинаСписания;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)

	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	Элементы = Форма.Элементы;
	
	ВО_Передача = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Передача");
	ВО_Реализация = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация");
	ВО_ПередачаИКвФинансовуюАренду = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКвФинансовуюАренду");
	ВО_ПередачаКапвложений = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений");
	ВО_ПередачаБезмозмездноеПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование");
	ВО_ПередачаЗемУчастковВПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаЗемУчастковВПользование");
	ВО_ПередачаУправление = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаУправление");
	ВО_ПередачаАренда = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаАренда");
	
	ВидимостьРеквизитовАмортизации = ВидимостьРеквизитовАмортизации(Форма);	
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииНакопленная");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииЗаТекущийМесяц");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ВидимостьРеквизитовАмортизации);
	
	ВестиАналитическийИИнвентарныйУчет = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	ЭлементыИнвентарногоУчета = Новый Массив;
	ЭлементыИнвентарногоУчета.Добавить("ОсновныеСредстваИнвентарныйНомер");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнвентарногоУчета, "Доступность", ВестиАналитическийИИнвентарныйУчет 
		И Объект.ВидОперации <> ВО_ПередачаКапвложений);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияРуб", "Видимость", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	ВидимостьЭлементовРеализации =
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация");
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ОсновныеСредстваНадписьЦенаПродажи");
	ИменаЭлементов.Добавить("ОсновныеСредстваНадписьСуммаПродажи");
	ИменаЭлементов.Добавить("ОсновныеСредстваЦенаПродажи");
	ИменаЭлементов.Добавить("ОсновныеСредстваСуммаПродажи");
	ИменаЭлементов.Добавить("ОсновныеСредстваСтавкаНДС");
	ИменаЭлементов.Добавить("ОсновныеСредстваСуммаНДС");
	ИменаЭлементов.Добавить("ОсновныеСредстваВсего");
	ИменаЭлементов.Добавить("ОсновныеСредстваИтогВсего");
	ИменаЭлементов.Добавить("ОсновныеСредстваИтогСуммаНДС");
	ИменаЭлементов.Добавить("НадписьСчетФактура");
	
	ИменаЭлементов.Добавить("ВалютаДокумента");
   	ИменаЭлементов.Добавить("ГруппаРасчетныеСчета");
	ИменаЭлементов.Добавить("ГруппаГрузоотправитель");
	ИменаЭлементов.Добавить("ГруппаГрузополучатель");
	ИменаЭлементов.Добавить("КодыУпаковокМаркируемойПродукции");
	ИменаЭлементов.Добавить("ГруппаРеализацияДляГосНужд");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьЭлементовРеализации);
	
	ВидимостьЦМОПолучатель = 
		(ВОсВнутреннимПеремещением().Найти(Объект.ВидОперации) <> Неопределено); 
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ГруппаКнопкиЗаполнитьПолучателя");
	ИменаЭлементов.Добавить("ЦМОПолучатель");
	ИменаЭлементов.Добавить("ПодразделениеПолучатель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьЦМОПолучатель И НЕ Объект.ПередачаЧастейОбъектов);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ПередачаЧастейОбъектов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", ВидимостьЦМОПолучатель);
	
	ВидимостьЭлементовКарточки = (ВидОперации = ВО_ПередачаКапвложений);
	ЭлементыКарточкаКапвложений = Новый Массив;
	ЭлементыКарточкаКапвложений.Добавить("ОсновныеСредстваГруппаКарточкаКапвложений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыКарточкаКапвложений, "Видимость", ВидимостьЭлементовКарточки);
	
	Элементы.ВидБезвозмездногоПользования.Видимость =
		(Объект.ВидОперации = ВО_ПередачаБезмозмездноеПользование
		ИЛИ Объект.ВидОперации = ВО_ПередачаИКвФинансовуюАренду
		ИЛИ Объект.ВидОперации = ВО_ПередачаЗемУчастковВПользование);
	
	ЭтоПередачаВПользование =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации);
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ОсновныеСредстваКоличество");
	ИменаЭлементов.Добавить("ОсновныеСредстваКомандаРассчитатьСтоимостьОС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", НЕ Объект.ПередачаЧастейОбъектов);

	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("ДоговорВТабличнойЧасти");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", ЭтоВО_Передача01_02(Объект.ВидОперации));
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("ОсновныеСредстваДоговор");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", Объект.ДоговорВТабличнойЧасти);

	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("Договор");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", НЕ Объект.ДоговорВТабличнойЧасти);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОсновныеСредстваЗарегистрироватьОбременения", "Видимость",
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаМЦ", "Видимость", ВидимостьЭлементовКарточки И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыИнвНомер", "Видимость", НЕ (ВидимостьЭлементовКарточки И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений));
		
КонецПроцедуры

