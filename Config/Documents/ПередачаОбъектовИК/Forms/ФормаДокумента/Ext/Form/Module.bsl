Процедура ОбработатьВыборСведенийЭлектронногоАктаОПриемеПередаче(ДанныеДляАкта)
	КоличествоФайлов = ДанныеДляАкта.КоличествоФайлов;
	
	ТекстСведений = ЭлектронныеДокументыБГУКлиент.ТекстПриложеноФайлов(КоличествоФайлов);

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений);
КонецПроцедуры	

&НаКлиенте
Процедура НадписьДопСведенияЭлектронногоАктаПоФорме0510448Нажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Параметры.Ключ.Пустая() Тогда
		ТекстОшибки = НСтр("ru='Необходимо записать документ для заполнение сведений электронного акта о приеме-передаче НФА.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыДопСведений = НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();

	КодыДополнительныхКоманд = Новый Массив;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений") Тогда
		КодыДополнительныхКоманд.Добавить(2);
	Иначе
		КодыДополнительныхКоманд.Добавить(1);
	КонецЕсли;	
	
	ПараметрыДопСведений.Ссылка = Объект.Ссылка;
	ПараметрыДопСведений.ДатаСведений = Объект.Дата;
	ПараметрыДопСведений.Организация = Объект.Организация;
	ПараметрыДопСведений.КодыДополнительныхКоманд = КодыДополнительныхКоманд; 
	
	ЭлектронныеДокументыБГУКлиент.ОткрытьФормуДопСведенийДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, Объект, ПараметрыДопСведений);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииВидОперации(Форма)
	Объект = Форма.Объект;
	ЭтоПередачаВПользование =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации);
	Если НЕ ЭтоПередачаВПользование И Объект.ПередачаЧастейОбъектов Тогда
		Объект.ПередачаЧастейОбъектов = Ложь;	
	КонецЕсли;		
	
	Если НЕ ЭтоВО_Передача01_02(Объект.ВидОперации) И Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Ложь;
	ИначеЕсли ЭтоВО_Передача01_02(Объект.ВидОперации) И НЕ Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВО_Передача01_02(ВО)
	Возврат(ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКПолученныхВПользование")
		ИЛИ ВО = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаОСнаХранении"));
КонецФункции	

