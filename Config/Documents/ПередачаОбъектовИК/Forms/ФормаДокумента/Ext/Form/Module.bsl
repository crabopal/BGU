	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаОСнаХранении") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			КодыСчетов = "02.50,02.5";
		КонецЕсли;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			КодыСчетов = "106.50";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "106.90";
		КонецЕсли;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаЗемУчастковВПользование") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			КодыСчетов = "108.55";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "108.95";
		КонецЕсли;
	Иначе
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			КодыСчетов = "108.50";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "108.90";
		КонецЕсли;
	КонецЕсли;
	
