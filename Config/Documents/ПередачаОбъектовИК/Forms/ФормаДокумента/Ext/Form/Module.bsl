&НаКлиенте
Процедура УстановитьОтборСчетаУчетаОС()
	
	КодыСчетов = "-";
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКПолученныхВПользование") Тогда
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
			КодыСчетов = "01.50";
