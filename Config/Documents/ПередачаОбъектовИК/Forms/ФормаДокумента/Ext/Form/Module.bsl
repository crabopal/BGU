&НаСервере
Процедура ВвестиНаОсновании(ДокументОснования, Разделитель)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ДанныеЗаполнения = Новый Структура();
	ДанныеЗаполнения.Вставить("ДокументОснование", ДокументОснования);
	ДанныеЗаполнения.Вставить("Разделитель", Разделитель);
	ДанныеЗаполнения.Вставить("ВводНаОсновании", Истина);
	ДанныеЗаполнения.Вставить("СсылкаЦелевогоДокумента", Неопределено);

	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьРеквизитовАмортизации(Форма)
	ВидОперации = Форма.Объект.ВидОперации;
	
	ВО_Передача = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Передача");
	ВО_Реализация = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация");
	ВО_ПередачаИКвФинансовуюАренду = ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКвФинансовуюАренду");
	ВО_ПередачаБезмозмездноеПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование");
	ВО_ПередачаУправление = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаУправление");
	ВО_ПередачаАренда = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаАренда");
	
	ВидимостьРеквизитов =
		ВидОперации = ВО_Передача
		Или ВидОперации = ВО_Реализация
		Или ВидОперации = ВО_ПередачаИКвФинансовуюАренду
		// Если есть учет ИК по ЦМО или по подразделениям, то амортизацию надо тоже перемещать
		Или ВидОперации = ВО_ПередачаБезмозмездноеПользование
		Или ВидОперации = ВО_ПередачаУправление
		Или ВидОперации = ВО_ПередачаАренда;
		
	Возврат ВидимостьРеквизитов;	
КонецФункции	

