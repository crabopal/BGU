	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.ПервичныйДокумент</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
				<Field>Список.СписокИнвНомеров</Field>
				<Field>Список.СписокОС</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ПередачаОбъектовИК.Ссылка КАК Ссылка,
	ПередачаОбъектовИК.ПометкаУдаления КАК ПометкаУдаления,
	ПередачаОбъектовИК.Номер КАК Номер,
	ПередачаОбъектовИК.Дата КАК Дата,
	ВЫБОР
		КОГДА ПередачаОбъектовИК.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ПередачаОбъектовИК.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ПередачаОбъектовИК.Проведен КАК Проведен,
	ПередачаОбъектовИК.Организация КАК Организация,
	ПередачаОбъектовИК.ИФО КАК ИФО,
	ПередачаОбъектовИК.Подразделение КАК Подразделение,
	ПередачаОбъектовИК.Комментарий КАК Комментарий,
	ПередачаОбъектовИК.КФО КАК КФО,
	ПередачаОбъектовИК.Контрагент КАК Контрагент,
	ПередачаОбъектовИК.СуммаДокумента КАК СуммаДокумента,
	ПередачаОбъектовИК.ВидОперации КАК ВидОперации,
	ОперацииДокументов.Операция КАК Операция,
	ПередачаОбъектовИК.ВидИмущества КАК ВидИмущества,
	ПередачаОбъектовИК.Ответственный КАК Ответственный,
	ПередачаОбъектовИК.ПервичныйДокумент,
	ОсновноеСредствоДокумента.ОсновноеСредство КАК ОсновноеСредство,
	ОсновноеСредствоДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ОсновноеСредство ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокОС,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер ЕСТЬ NULL
			ТОГДА ИСТИНА
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			ТОГДА ЕСТЬNULL(ОсновноеСредствоДокумента.ОсновноеСредство.ГрупповойУчет, ЛОЖЬ)
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокИнвНомеров,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(СостоянияЭДАкта.СостояниеЭДО) = ТИП(Перечисление.СостоянияДокументовАктовЭДОБГУ)
