	ТекущиеДанные = Элементы.РасшифовкаПлатежа.ТекущиеДанные;
											
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.КорСчет, 
																			ТекущиеДанные.КПС, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															Объект.ИФО,
															Объект.КорСчет,
															ТекущиеДанные.КФО,
															,
															Объект.Дата);
											
КонецПроцедуры

