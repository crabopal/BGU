&НаКлиенте
Процедура РасшифовкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		СуммаБезСтроки = Объект.РасшифровкаПлатежа.Итог("Сумма") - Элемент.ТекущиеДанные.Сумма;
		Остаток = Объект.СуммаДокумента - СуммаБезСтроки;
		Элемент.ТекущиеДанные.Сумма = ?(Элемент.ТекущиеДанные.Сумма = 0, Остаток, Мин(Элемент.ТекущиеДанные.Сумма, Остаток));
		//Элемент.ТекущиеДанные.КорСчет = Объект.КорСчет;
	КонецЕсли;	
	
