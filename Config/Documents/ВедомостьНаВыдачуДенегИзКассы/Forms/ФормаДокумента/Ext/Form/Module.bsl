Процедура РасшифовкаПлатежаСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.РасшифовкаПлатежа.ТекущиеДанные.Сотрудник = ВыбранноеЗначение.Ссылка;
		Элементы.РасшифовкаПлатежа.ТекущиеДанные.ПодразделениеКор = ВыбранноеЗначение.Подразделение;
	Иначе
		Элементы.РасшифовкаПлатежа.ТекущиеДанные.ПодразделениеКор = "";
	КонецЕсли;	

