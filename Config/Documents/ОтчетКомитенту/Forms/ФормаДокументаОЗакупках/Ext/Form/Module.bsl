&НаСервереБезКонтекста
Функция РаспределитьПропорционально(Знач РаспределяемаяСумма, Знач Коэффициенты, Знач Точность = 2) Экспорт

	Если Коэффициенты.Количество() = 0 Или Не ЗначениеЗаполнено(РаспределяемаяСумма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексМаксимальногоКоэффициента = 0;
	МаксимальныйКоэффициент = 0;
	РаспределеннаяСумма = 0;
	СуммаКоэффициентов  = 0;
	
	Для Индекс = 0 По Коэффициенты.Количество() - 1 Цикл
		Коэффициент = Коэффициенты[Индекс];
		
		АбсолютноеЗначениеКоэффициента = ?(Коэффициент > 0, Коэффициент, -Коэффициент);
		Если МаксимальныйКоэффициент < АбсолютноеЗначениеКоэффициента Тогда
			МаксимальныйКоэффициент = АбсолютноеЗначениеКоэффициента;
			ИндексМаксимальногоКоэффициента = Индекс;
		КонецЕсли;
		
		СуммаКоэффициентов = СуммаКоэффициентов + Коэффициент;
	КонецЦикла;
	
	Если СуммаКоэффициентов = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Массив(Коэффициенты.Количество());
	
	Для Индекс = 0 По Коэффициенты.Количество() - 1 Цикл
		Результат[Индекс] = Окр(РаспределяемаяСумма * Коэффициенты[Индекс] / СуммаКоэффициентов, Точность, 1);
		РаспределеннаяСумма = РаспределеннаяСумма + Результат[Индекс];
	КонецЦикла;
	
	Дельта = РаспределяемаяСумма - РаспределеннаяСумма;
	
	Если Дельта > 0 Тогда 
		
		// Погрешности округления отнесем на коэффициент с максимальным весом.
		Если Не РаспределеннаяСумма = РаспределяемаяСумма Тогда
			Результат[ИндексМаксимальногоКоэффициента] = Результат[ИндексМаксимальногоКоэффициента] + Дельта;
		КонецЕсли;
		
	ИначеЕсли Дельта < 0 Тогда 
		
		// Если распределили больше чем положено, размазываем погрешность по ближайшим максимальным весам.
		ЗначениеПогрешности = 1 / Pow(10, Точность);
		КоличествоЭлементовПогрешности = -Дельта / ЗначениеПогрешности;
		
		КоэффициентыРешето = Новый Массив(Новый ФиксированныйМассив(Коэффициенты));
		
		Для Сч = 1 По КоличествоЭлементовПогрешности Цикл 
			МаксимальныйКоэффициент = ОбщегоНазначенияБГУКлиентСервер.МаксимальноеЗначениеВМассиве(КоэффициентыРешето);
			Индекс = КоэффициентыРешето.Найти(МаксимальныйКоэффициент);
			Результат[Индекс] = Результат[Индекс] - ЗначениеПогрешности;
			КоэффициентыРешето[Индекс] = 0;
		КонецЦикла;
		
	Иначе 
		// Если Дельта = 0, то все идеально.
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСуммаНДС(Форма, ИмяТаблицы,  СоответствиеРеквизитов = Неопределено) Экспорт

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	Если СоответствиеРеквизитов <> Неопределено Тогда
		СтрокаТаблицы = ИзСтрокиТаблицыДокумента(Элементы[ИмяТаблицы].ТекущиеДанные, СоответствиеРеквизитов);
	Иначе
		СтрокаТаблицы = Элементы[ИмяТаблицы].ТекущиеДанные;
	КонецЕсли; 

	Если СтрокаТаблицы.Свойство("Всего") Тогда
		СтрокаТаблицы.Всего = СтрокаТаблицы.Сумма + ?(Объект.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
	КонецЕсли;
	
	Если СоответствиеРеквизитов <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			Элементы[ИмяТаблицы].ТекущиеДанные, 
			ВСтрокуТаблицыДокумента(СтрокаТаблицы, СоответствиеРеквизитов));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИзСтрокиТаблицыДокумента(ИсходнаяСтрока, СоответствиеРеквизитов)
	Результат = Новый Структура;
	
	Для каждого СоответствиеРеквизита Из СоответствиеРеквизитов Цикл
		Результат.Вставить(СоответствиеРеквизита.Ключ, ИсходнаяСтрока[СоответствиеРеквизита.Значение]);
	КонецЦикла; 
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВСтрокуТаблицыДокумента(ИсходнаяСтрока, СоответствиеРеквизитов)
	Результат = Новый Структура;
	
	Для каждого СоответствиеРеквизита Из СоответствиеРеквизитов Цикл
		Результат.Вставить(СоответствиеРеквизита.Значение, ИсходнаяСтрока[СоответствиеРеквизита.Ключ]);
	КонецЦикла; 
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена, ЦенаВключаетНДС, СуммаВключаетНДС, СтавкаНДС)

	// Инициализация переменных
	НадоВключитьНДС  = Ложь;
	НадоИсключитьНДС = Ложь;
	НоваяЦена		 = Цена;

	Если СуммаВключаетНДС
		И (НЕ ЦенаВключаетНДС) Тогда
		
		// Надо добавлять НДС       
		НадоВключитьНДС = Истина;
	ИначеЕсли (НЕ СуммаВключаетНДС)
		И ЦенаВключаетНДС  Тогда
		
		// Надо исключать НДС       
		НадоИсключитьНДС = Истина;
	КонецЕсли;
		
	Если НадоИсключитьНДС Тогда
		НоваяЦена = (НоваяЦена * 100) / (100 + СтавкаНДС);
	КонецЕсли;

	Если НадоВключитьНДС Тогда
		НоваяЦена = (НоваяЦена * (100 + СтавкаНДС)) / 100;
	КонецЕсли;

	Возврат НоваяЦена;

КонецФункции

&НаКлиенте
Процедура ВопросПередЗаполнениемСчетовФактурЗакупкиЗавершение (Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьСчетаФактурыСервер("Поставщики");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСчетаФактурыСервер(ТабличнаяЧастьДляСФ)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ОбъектФормы = РеквизитФормыВЗначение("Объект");
		
		РеквизитыШапки = ПолучитьДанныеДляЗаполненияШапкиСчетаФактуры(Объект.Ссылка, ТабличнаяЧастьДляСФ);
		
		Если ТабличнаяЧастьДляСФ = "Поставщики" Тогда
			ВсеПодчиненныеСчетаФактуры = ПолучитьТаблицыПодчиненныхСчетовФактурВыданных(Объект.Ссылка, ТабличнаяЧастьДляСФ);
		КонецЕсли;
			
		Для каждого КлючИЗначение Из ВсеПодчиненныеСчетаФактуры Цикл
			
			ИмяТаблицы = КлючИЗначение.Ключ;
			ПодчиненныеСчетаФактуры = КлючИЗначение.Значение;
			
			ДанныеСчетовФактур = ДанныеСчетовФактурПоДокументу(ИмяТаблицы, ОбъектФормы, ТабличнаяЧастьДляСФ);
			НайтиСоздатьПодчиненныеСчетаФактуры(Объект.Ссылка, ДанныеСчетовФактур, ПодчиненныеСчетаФактуры, ИмяТаблицы, ОбъектФормы, РеквизитыШапки);
			
		КонецЦикла;
		
		ЗаполнитьДобавленныеКолонкиТаблиц();
		УправлениеФормой(ЭтотОбъект);
		
		Записать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицыПодчиненныхСчетовФактурВыданных(ДокументСсылка, ВидОперацииСФ)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК КлючСтроки,
	|	СчетФактураВыданный.Ссылка КАК Ссылка,
	|	СчетФактураВыданный.Контрагент КАК Поставщик,
	|	НАЧАЛОПЕРИОДА(СчетФактураВыданный.Дата, ДЕНЬ) КАК ДатаСФ,
	|	СчетФактураВыданный.Проведен КАК Проведен,
	|	СчетФактураВыданный.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.КодВидаОперации = ""27""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СводныйСФ
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетФактураВыданный.Дата,
	|	ПометкаУдаления УБЫВ,
	|	Ссылка";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат.Вставить(ВидОперацииСФ, ПолучитьТаблицуПодчиненныхСчетовФактур(РезультатыЗапроса[0]));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуПодчиненныхСчетовФактур(РезультатЗапроса)

	ТаблицаСФ = РезультатЗапроса.Выгрузить();
	ТаблицаСФ.Колонки.Добавить("Использован", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаСФ;

КонецФункции

&НаСервере
Процедура НайтиСоздатьПодчиненныеСчетаФактуры(ДокументСсылка, ДанныеСчетовФактур, ПодчиненныеСчетаФактуры, ИмяТаблицы, ОбъектФормы, РеквизитыШапки)
	
	СписокДобавленныхСФ = Новый СписокЗначений;
	
	Для каждого СтрокаТаблицы Из ДанныеСчетовФактур Цикл
		
		СтрокаСФ = НайтиСтрокуСчетаФактуры(ПодчиненныеСчетаФактуры, СтрокаТаблицы, ИмяТаблицы, СписокДобавленныхСФ);
		
		Если СтрокаСФ <> Неопределено Тогда
			
			Если СтрокаСФ.ДатаСФ <> СтрокаТаблицы.ДатаСФ
				ИЛИ СтрокаСФ.СводныйСФ <> СтрокаТаблицы.СводныйСФ Тогда 
				
				ДокументСФ		=  СтрокаСФ.Ссылка.ПолучитьОбъект();
				Если СтрокаСФ.ДатаСФ <> СтрокаТаблицы.ДатаСФ Тогда
					Если ТипЗнч(ДокументСФ) = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
						ДокументСФ.Дата = СтрокаТаблицы.ДатаСФ;
					Иначе
						ДокументСФ.ДатаВходящегоДокумента = СтрокаТаблицы.ДатаСФ;
					КонецЕсли;
				КонецЕсли;
				
				ДокументСФ.ДополнительныеСвойства.Вставить("ОбновлятьРеквизитыПриЗаписи", Ложь);
				ДокументСФ.Записать();
				// Обновить значение строки таблицы с счетами-фактурами
				ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
				ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("КлючСтроки", СтрокаТаблицы.КлючСтроки);
			СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
			Если СтрокаТЧ <> Неопределено Тогда
				СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
				СтрокаСФ.Использован = Истина;
				Если ИмяТаблицы = "Поставщики" Тогда
					СписокДобавленныхСФ.Добавить(СтрокаСФ.Ссылка);
				КонецЕсли;	
			КонецЕсли;
			
			Продолжить;
			
		ИначеЕсли ИмяТаблицы = "Поставщики" Тогда	
			
			ДокументСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(ДокументСФ, РеквизитыШапки);
			
			ДокументСФ.Дата                   = СтрокаТаблицы.ДатаСФ;
			ДокументСФ.Контрагент             = СтрокаТаблицы.Поставщик;
			ДокументСФ.Договор                = СтрокаТаблицы.Договор;
			ДокументСФ.Ответственный          = Пользователи.ТекущийПользователь();
			ДокументСФ.Комментарий     = 
				НСтр("ru = 'Создан автоматически на основании документа отчет комитента о закупках'");
				
			ЗаполнитьТаблицуПоставщики(ДокументСФ, ДанныеСчетовФактур, СтрокаТаблицы.СводныйСФ, СтрокаТаблицы.ПоставщикСФ);
				
			Если СтрокаТаблицы.СводныйСФ Тогда
				ДокументСФ.КодВидаОперации = "27";
			Иначе
				ДокументСФ.КодВидаОперации = "01";
			КонецЕсли;
				
			ДокументСФ.КодСпособаВыставления	= 1;
			ДокументСФ.Выставлен				= Истина;
			ДокументСФ.ДатаВыставления			= Объект.Дата;
			
			Документы.СчетФактураВыданный.УстановитьОтветственныхЛиц(ДокументСФ);
			
			// Получим коды ключей для заполнения табличной части Номенклатура
			КлючиСчетаФактуры = Новый Массив;
			Если СтрокаТаблицы.СводныйСФ Тогда
				Для каждого СтрокаДанныхСФ Из ДанныеСчетовФактур Цикл
					Если СтрокаДанныхСФ.ДатаСФ = СтрокаТаблицы.ДатаСФ Тогда
						КлючиСчетаФактуры.Добавить(СтрокаДанныхСФ.КлючСтроки);
					КонецЕсли;
				КонецЦикла;
			Иначе
				КлючиСчетаФактуры.Добавить(СтрокаТаблицы.КлючСтроки);
			КонецЕсли;
				
			ДанныеНоменклатурыДляСФ = ПолучитьТаблицуНоменклатурыДляСФ(ОбъектФормы, ДокументСФ, СтрокаТаблицы, КлючиСчетаФактуры);
			
			Документы.СчетФактураВыданный.ЗаполнитьКолонкиСчетов(РеквизитыШапки, ДанныеНоменклатурыДляСФ, ДокументСФ, Истина);
			
			ДокументСФ.СоставНФА.Загрузить(ДанныеНоменклатурыДляСФ);
			
			ДокументСФ.ДокументОснование = ДокументСсылка;
			
		КонецЕсли;
		
		ДокументСФ.Записать();
		
		// Этот новый счет-фактуру нужно зафиксировать в таблице счетов-фактур
		СтрокаСФ = ПодчиненныеСчетаФактуры.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
		ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТаблицы.КлючСтроки);
		СтрокаТЧ = Объект[ИмяТаблицы].НайтиСтроки(Отбор);
		Если СтрокаТЧ <> Неопределено Тогда 
			СтрокаТЧ[0].СчетФактура = СтрокаСФ.Ссылка;
			СтрокаСФ.Использован = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляЗаполненияШапкиСчетаФактуры(ОснованиеСсылка, ТабличнаяЧастьДляСФ)
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ТабличнаяЧастьДляСФ", ТабличнаяЧастьДляСФ);
	
	ЗапросЗаполнение.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка КАК ДокументОснование,
	|	ОтчетКомитенту.Дата КАК Дата,
	|	ОтчетКомитенту.Организация КАК Организация,
	|	ОтчетКомитенту.ИФО КАК ИФО,
	|	ОтчетКомитенту.Подразделение КАК Подразделение,
	|	ОтчетКомитенту.Контрагент КАК Посредник,
	|	ОтчетКомитенту.Договор КАК Договор,
	|	ОтчетКомитенту.ВалютаДокумента КАК ВалютаДокумента,
	|	ОтчетКомитенту.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку) КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.ОтчетКомитенту КАК ОтчетКомитенту
	|ГДЕ
	|	ОтчетКомитенту.Ссылка = &ДокументОснованиеСсылка";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	Возврат Шапка;
	
КонецФункции

&НаСервере
Функция ПолучитьОтветственныхЛиц(Шапка)
	
	ОтветственныеЛица = Новый Структура();
	ОтветственныеЛица.Вставить("Руководитель");
	ОтветственныеЛица.Вставить("ГлавныйБухгалтер");
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Организация")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Дата")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Подразделение") Тогда
		Возврат ОтветственныеЛица;
	КонецЕсли;
	
	ЛицоРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ЛицоГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ОтветственныеЛица.Руководитель		= ЛицоРуководитель.ОтветственноеЛицоСсылка;
	ОтветственныеЛица.ГлавныйБухгалтер	= ЛицоГлавныйБухгалтер.ОтветственноеЛицоСсылка;
	
	Возврат ОтветственныеЛица;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	ЗаполнитьТекстПроСчетФактуруНадпись(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения, "СчетФактураВыданный");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруНадпись(Форма, ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено, ОтборПоСчетамФактурам = Неопределено) Экспорт
	
	ИменаРеквизитовФормы = Новый Структура();
	ИменаРеквизитовФормы.Вставить("СчетФактураСсылка",	"СчетФактура");
	ИменаРеквизитовФормы.Вставить("СчетФактураНадпись",	"НадписьСчетФактура");
	
	СчетФактураСсылка = Форма[ИменаРеквизитовФормы.СчетФактураСсылка];
	
	Если ЗначениеЗаполнено(СчетФактураСсылка) И ЗначениеЗаполнено(ИсточникОбработкиОповещения)
		И СчетФактураСсылка <> ИсточникОбработкиОповещения Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСФ = Новый Структура;
	ОтборСФ.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Реализация);
	
	Отбор = Новый Структура;
	Отбор.Вставить("СчетФактураВыданный", ОтборСФ);
	
	Если НЕ ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		СчетФактураСсылка = УчетНДС.НайтиПодчиненныйСчетФактуру(Форма["Объект"].Ссылка, ОтборПоСчетамФактурам, Отбор);
		
		Форма[ИменаРеквизитовФормы.СчетФактураСсылка] = СчетФактураСсылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		Если ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, "НомерПервичногоДокумента,ДатаПервичногоДокумента");
			Номер	= ЗначенияРеквизитов["НомерПервичногоДокумента"];
			Дата	= ЗначенияРеквизитов["ДатаПервичногоДокумента"];
			
		Иначе
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, "Номер,Дата");
			Номер	= ЗначенияРеквизитов["Номер"];
			Дата	= ЗначенияРеквизитов["Дата"];
		КонецЕсли;
		ТекстНомер	= ?(НЕ ПустаяСтрока(Номер), Номер, "...");
		ТекстДата	= ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДЛФ=D"), "...");
		ТекстНадписи = СтрШаблон(НСтр("ru='№ %1 от %2 г.'"), ТекстНомер, ТекстДата);
	Иначе
		ТекстНадписи = НСтр("ru='Ввести счет-фактуру'");
	КонецЕсли;
	
	Форма[ИменаРеквизитовФормы.СчетФактураНадпись] = ТекстНадписи;
	
КонецПроцедуры

&НаСервере
Функция ДанныеСчетовФактурПоДокументу(ИмяТаблицы, ОбъектФормы, ТабличнаяЧастьДляСФ)
	
	ТаблицаДокумента = ОбъектФормы[ИмяТаблицы];
	
	//Если счета-фактуры генерируются сводно, то получим из таблицы счета-фактуры которые будут сводными
	ТаблицаДатСФ = Новый ТаблицаЗначений;
	Если Объект.ВыписыватьСчетаФактурыСводно Тогда
		ТаблицаДатСФ = ТаблицаДокумента.Выгрузить().Скопировать(Новый Структура("ПолученСФ", Истина),"ДатаСФ");
		ТаблицаДатСФ.Колонки.Добавить("КоличествоСФ", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
		ТаблицаДатСФ.ЗаполнитьЗначения(1, "КоличествоСФ");
		ТаблицаДатСФ.Свернуть("ДатаСФ", "КоличествоСФ");
	КонецЕсли;
	
	ПоляКолонок  = "Поставщик, ДатаСФ, СчетФактура";
	ПоляКолонок = ПоляКолонок + ", КлючСтроки";
	
	ДанныеСчетовФактур = ТаблицаДокумента.ВыгрузитьКолонки(ПоляКолонок);
	ДанныеСчетовФактур.Колонки.Добавить("НомерСчетаФактуры", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ДанныеСчетовФактур.Колонки.Добавить("СводныйСФ", Новый ОписаниеТипов("Булево"));
	ДанныеСчетовФактур.Колонки.Добавить("ЕдиныйСФ", Новый ОписаниеТипов("Булево"));
	ДанныеСчетовФактур.Колонки.Добавить("ПоставщикСФ", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ДанныеСчетовФактур.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ДанныеСчетовФактур.Колонки.Добавить("Всего", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДанныеСчетовФактур.Колонки.Добавить("НДС", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	Для каждого СтрокаТабличнойЧасти Из ТаблицаДокумента Цикл
		Если СтрокаТабличнойЧасти.ПолученСФ Тогда
			НоваяСтрока = ДанныеСчетовФактур.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
			НоваяСтрока.Поставщик = Объект.Контрагент;
			НоваяСтрока.ПоставщикСФ = СтрокаТабличнойЧасти.Поставщик;
			НоваяСтрока.Договор = Объект.Договор;
			СчетФактураПоДате = ТаблицаДатСФ.Найти(СтрокаТабличнойЧасти.ДатаСФ);
			Если СчетФактураПоДате <> Неопределено
				И СчетФактураПоДате.КоличествоСФ > 1 Тогда 
				НоваяСтрока.СводныйСФ = Истина;
			Иначе
				НоваяСтрока.СводныйСФ = Ложь;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаТабличнойЧасти.СчетФактура) Тогда
			СтрокаТабличнойЧасти.СчетФактура = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	// Самые ранние счета-фактуры создаем сначала
	ДанныеСчетовФактур.Сортировать("ДатаСФ Возр");
	
	Возврат ДанныеСчетовФактур;

КонецФункции

&НаСервере
Функция НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаДокумента, ИмяТаблицы, СписокДобавленныхСФ)
	
	СтруктураПоиска  = Новый Структура("Ссылка", СтрокаДокумента.СчетФактура);
	НайденныеСтроки  = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Поставщик = СтрокаДокумента.Поставщик
			ИЛИ НЕ ЗначениеЗаполнено(НайденнаяСтрока.ПокупатПоставщикель) Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураПоиска = Новый Структура("ДатаСФ", СтрокаДокумента.ДатаСФ);
	НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Поставщик = СтрокаДокумента.Поставщик
			ИЛИ НЕ ЗначениеЗаполнено(НайденнаяСтрока.Поставщик) Тогда
			
			Если СтрокаДокумента.СводныйСФ Тогда
				// найден подходящий счет-фактура
				Возврат НайденнаяСтрока;
			ИначеЕсли НайденнаяСтрока.КлючСтроки <> Неопределено Тогда
				Если НайденнаяСтрока.КлючСтроки = СтрокаДокумента.КлючСтроки Тогда
					// найден подходящий счет-фактура
					Возврат НайденнаяСтрока;
				Иначе
					Продолжить;
				КонецЕсли;
			ИначеЕсли СписокДобавленныхСФ.НайтиПоЗначению(НайденнаяСтрока.Ссылка) <> Неопределено Тогда
				Продолжить;
			Иначе
				// найден подходящий счет-фактура
				Возврат НайденнаяСтрока;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПолучитьТаблицуНоменклатурыДляСФ(ОбъектФормы, ДокументСФ, СтрокаТаблицы, КлючиСчетаФактуры)
	
	ТаблицыДокумента = Новый Структура;
	
	ТаблицыДокумента.Вставить("Номенклатура", ОбъектФормы.Товары);
	
	ДанныеНоменклатурыДляСФ = ТаблицыДокумента.Номенклатура.ВыгрузитьКолонки("ЕдиницаИзмерения, Количество, Сумма, Цена, СтавкаНДС, СуммаНДС");
	ДанныеНоменклатурыДляСФ.Колонки.Добавить("НФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеНоменклатурыДляСФ.Колонки.Добавить("Всего", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДанныеНоменклатурыДляСФ.Колонки.Добавить("КомиссионнаяТорговля", Новый ОписаниеТипов("Булево"));
	
	ПараметрыОтбора = Новый Структура;
	
	Для каждого ТаблицаДокумента Из ТаблицыДокумента Цикл
		Для Каждого КлючСтроки Из КлючиСчетаФактуры Цикл
			ПараметрыОтбора.Вставить("КлючСтроки", КлючСтроки);
			НайденныеСтроки = ТаблицаДокумента.Значение.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаПоКлючу Из НайденныеСтроки Цикл
				СтрокаТЧ = ДанныеНоменклатурыДляСФ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаПоКлючу);
				
				СтрокаТЧ.НФА = СтрокаПоКлючу.Номенклатура;
				
				Если ОбъектФормы.СуммаВключаетНДС Тогда 
					СтрокаТЧ.Всего = СтрокаПоКлючу.Сумма;
				Иначе
					СтрокаТЧ.Всего = СтрокаПоКлючу.Сумма + СтрокаПоКлючу.СуммаНДС;
				КонецЕсли;
				
				Если ОбъектФормы.СуммаВключаетНДС И НЕ СтрокаПоКлючу.Сумма = 0 Тогда 
					СтрокаТЧ.Цена = СтрокаПоКлючу.Цена - СтрокаПоКлючу.СуммаНДС * (СтрокаПоКлючу.Цена / СтрокаПоКлючу.Сумма);
				Иначе
					СтрокаТЧ.Цена = СтрокаПоКлючу.Цена;
				КонецЕсли;
				
				СтрокаТЧ.Сумма = СтрокаТЧ.Всего - СтрокаПоКлючу.СуммаНДС;
				
				СтрокаТЧ.КомиссионнаяТорговля = Истина;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДанныеНоменклатурыДляСФ;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		
		ЗаполнитьРассчитатьСуммы(
		ЭтотОбъект.КэшПараметров.ВалютаДокумента,
		Ложь,
		Ложь,
		Истина);
		
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоставщики(ДокументСФ, ДанныеСчетовФактур, СводныйКомиссионныйСчетФактура, ПоставщикВСтроке)
	
	Для каждого СтрокаПоставщики Из ДанныеСчетовФактур Цикл
		Если СтрокаПоставщики.ДатаСФ = НачалоДня(ДокументСФ.Дата) И СтрокаПоставщики.Поставщик = ДокументСФ.Контрагент Тогда
			Если СводныйКомиссионныйСчетФактура Тогда
				СоздатьЗаполнитьСтрокуТабличнойЧастиПоставщики(ДокументСФ, СтрокаПоставщики)
			Иначе
				Если ПоставщикВСтроке = СтрокаПоставщики.ПоставщикСФ Тогда
					СоздатьЗаполнитьСтрокуТабличнойЧастиПоставщики(ДокументСФ, СтрокаПоставщики)
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗаполнитьСтрокуТабличнойЧастиПоставщики(ДокументСФ, СтрокаПоставщики)
	
	СтрокаТЧ = ДокументСФ.СчетаФактурыОтКомиссионера.Добавить();
	СтрокаТЧ.ПокупательСФ = СтрокаПоставщики.ПоставщикСФ;
	СтрокаТЧ.НомерСФ = СтрокаПоставщики.НомерСчетаФактуры;
	СтрокаТЧ.СтоимостьТоваров = СтрокаПоставщики.Всего;
	СтрокаТЧ.СуммаНДС = СтрокаПоставщики.НДС;
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаПоставщики);
	
КонецПроцедуры

