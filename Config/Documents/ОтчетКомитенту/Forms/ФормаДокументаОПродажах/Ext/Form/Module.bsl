&НаКлиенте
Процедура ЗаполнитьРеализованнымПоДоговору(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ТекстПредупреждения = НСтр("ru = 'Не выбран договор. Заполнение невозможно.'") ;
		ПоказатьПредупреждение( , ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	Если Объект.Товары.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена%ПредупреждениеОЗаписиДокумента% Заполнить?'");
	ИначеЕсли Модифицированность Тогда
		ТекстВопроса = НСтр("ru = ' Перед заполнением документ будет записан! Продолжить?'") ;
	Иначе
		ЗаполнитьРеализованнымНаСервере();
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрЗаменить(ТекстВопроса, "%ПредупреждениеОЗаписиДокумента%", 
		?(Модифицированность, Символы.ПС + НСтр("ru=' (документ будет записан!)'"), "."));
	
	Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемТабличнойЧастиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.Товары Цикл
			
			РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Сумма");
			
		КонецЦикла;
		ПересчитатьВознаграждениеВТабличнойЧасти();
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

