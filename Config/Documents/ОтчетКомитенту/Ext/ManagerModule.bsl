#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаСписка"
		ИЛИ ВидФормы = "ФормаВыбора" Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ВидОперации = Параметры.Ключ.ВидОперации;
	ИначеЕсли Параметры.Свойство("ЗначенияЗаполнения") 
		И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")
		И Параметры.ЗначенияЗаполнения.Свойство("ВидОперации") Тогда 
		ВидОперации = Параметры.ЗначенияЗаполнения.ВидОперации;
	ИначеЕсли Параметры.Свойство("ЗначениеКопирования") 
		И ЗначениеЗаполнено(Параметры.ЗначениеКопирования)
		И ТипЗнч(Параметры.ЗначениеКопирования) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда 
		ВидОперации = Параметры.ЗначениеКопирования.ВидОперации;
	ИначеЕсли Параметры.Свойство("Основание") 
		И ЗначениеЗаполнено(Параметры.Основание) Тогда
		// На основании ПоступленияТоваровУслуг вводится отчет комитенту о продажах.
		ДоговорОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Основание, "Договор");
		ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорОснования, "ВидДоговора");
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку Тогда
			ВидОперации = Перечисления.ВидыОперацийОтчетКомитенту.ОтчетОЗакупках;
		Иначе
			ВидОперации = Перечисления.ВидыОперацийОтчетКомитенту.ОтчетОПродажах;
		КонецЕсли;
	Иначе
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов") Тогда
			ВидОперации = Перечисления.ВидыОперацийОтчетКомитенту.ОтчетОПродажах;
		Иначе
			ВидОперации = Неопределено;
		КонецЕсли;
	КонецЕсли;
		
	СтандартнаяОбработка = Ложь;
	ФормыОтчетовКомитенту = ПолучитьСоответствиеВидовОтчетаКомитентуФормам();
	ВыбраннаяФорма = ФормыОтчетовКомитенту[ВидОперации];
	Если ВыбраннаяФорма = Неопределено Тогда
		ВыбраннаяФорма = "ФормаДокумента";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ВидОперацииДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ВидОперации");
	
	НомераТаблиц = Новый Структура;
	Если ВидОперацииДокумента = Перечисления.ВидыОперацийОтчетКомитенту.ОтчетОПродажах Тогда
		ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц);
	Иначе
		ИнициализироватьЗапросыПоЗакупленнымТоварамДляКомитентов(Запрос, НомераТаблиц);
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("РеализованныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Организация КАК Организация,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Дата КАК Период,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Контрагент КАК Контрагент,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Договор КАК ДоговорКомитента,
	|	ОтчетКомитентуОПродажахТовары.Номенклатура КАК Номенклатура,
	|	ОтчетКомитентуОПродажахТовары.Покупатель КАК Покупатель,
	|	ОтчетКомитентуОПродажахТовары.ДатаРеализации КАК ДатаРеализации,
	|	ОтчетКомитентуОПродажахТовары.ДокументРасчетов КАК ДокументРасчетов,
	|	СУММА(ОтчетКомитентуОПродажахТовары.Количество) КАК Количество,
	|	СУММА(ОтчетКомитентуОПродажахТовары.СуммаПоступления) КАК СуммаПоступления,
	|	СУММА(ОтчетКомитентуОПродажахТовары.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ОтчетКомитентуОПродажахТовары.Сумма) КАК Выручка
	|ИЗ
	|	Документ.ОтчетКомитенту.Товары КАК ОтчетКомитентуОПродажахТовары
	|ГДЕ
	|	ОтчетКомитентуОПродажахТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетКомитентуОПродажахТовары.Номенклатура,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Организация,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Дата,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Контрагент,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Договор,
	|	ОтчетКомитентуОПродажахТовары.Покупатель,
	|	ОтчетКомитентуОПродажахТовары.ДатаРеализации,
	|	ОтчетКомитентуОПродажахТовары.ДокументРасчетов";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоЗакупленнымТоварамДляКомитентов(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ЗакупленныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Организация КАК Организация,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Дата КАК Период,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Контрагент КАК Контрагент,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Договор КАК ДоговорКонтрагента,
	|	ОтчетКомитентуОПродажахТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ОтчетКомитентуОПродажахТовары.Количество) КАК Количество,
	|	СУММА(ОтчетКомитентуОПродажахТовары.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ВЫБОР
	|			КОГДА ОтчетКомитентуОПродажахТовары.Ссылка.СуммаВключаетНДС
	|				ТОГДА ОтчетКомитентуОПродажахТовары.Сумма
	|			ИНАЧЕ ОтчетКомитентуОПродажахТовары.Сумма + ОтчетКомитентуОПродажахТовары.СуммаНДС
	|		КОНЕЦ) КАК Сумма,
	|	ОтчетКомитентуПоставщики.Партия КАК Партия
	|ИЗ
	|	Документ.ОтчетКомитенту.Товары КАК ОтчетКомитентуОПродажахТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитенту.Поставщики КАК ОтчетКомитентуПоставщики
	|		ПО ОтчетКомитентуОПродажахТовары.Ссылка = ОтчетКомитентуПоставщики.Ссылка
	|			И ОтчетКомитентуОПродажахТовары.КлючСтроки = ОтчетКомитентуПоставщики.КлючСтроки
	|ГДЕ
	|	ОтчетКомитентуОПродажахТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетКомитентуОПродажахТовары.Номенклатура,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Организация,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Дата,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Контрагент,
	|	ОтчетКомитентуОПродажахТовары.Ссылка.Договор,
	|	ОтчетКомитентуОПродажахТовары.Покупатель,
	|	ОтчетКомитентуОПродажахТовары.ДатаРеализации,
	|	ОтчетКомитентуОПродажахТовары.ДокументРасчетов,
	|	ОтчетКомитентуПоставщики.Партия";
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Отчет комитенту
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ОтчетКомитенту";
	КомандаПечати.Представление = НСтр("ru = 'Отчет комитенту'");

	// Акт об оказании услуг
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АктОбОказанииУслуг";
	КомандаПечати.Представление = НСтр("ru = 'Акт об оказании услуг'");
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОтчетКомитенту") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ОтчетКомитенту", "Отчет комитенту",
			ПечатьОтчетаКомитенту(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктОбОказанииУслуг",
															"Акт об оказании услуг",
															ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует табличный документ с печатной формой накладной,
// разработанной методистами
//
// Возвращаемое значение:
//  Табличный документ - печатная форма накладной
//
Функция ПечатьОтчетаКомитенту(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетКомитенту_ОтчетКомитенту";
	
	ВыводитьКоды = Ложь;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧПоставщики.Ссылка КАК Ссылка,
	|	ТЧПоставщики.НомерСтроки КАК НомерСтроки,
	|	ТЧПоставщики.КлючСтроки КАК КлючСтроки,
	|	ТЧПоставщики.Поставщик КАК Поставщик,
	|	ТЧПоставщики.Партия КАК Партия,
	|	ДокПоступления.Дата КАК ДатаПартии,
	|	ВЫБОР
	|		КОГДА НЕ СчетФактураПолученный.Ссылка ЕСТЬ NULL
	|			ТОГДА СчетФактураПолученный.Ссылка.ДатаПервичногоДокумента
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаВходящегоСчетаФактуры,
	|	ВЫБОР
	|		КОГДА НЕ СчетФактураПолученный.Ссылка ЕСТЬ NULL
	|			ТОГДА СчетФактураПолученный.Ссылка.НомерПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерВходящегоСчетаФактуры,
	|	ЕСТЬNULL(ДокПоступления.ДатаПервичногоДокумента, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВходящегоДокумента,
	|	ЕСТЬNULL(ДокПоступления.НомерПервичногоДокумента, """") КАК НомерВходящегоДокумента,
	|	ТЧПоставщики.СчетФактура КАК СчетФактураВыданный,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.ПолученСФ
	|			ТОГДА ЕСТЬNULL(ТЧПоставщики.СчетФактура.Дата, ТЧПоставщики.ДатаСФ)
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаВыданногоСчетаФактуры,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.ПолученСФ
	|			ТОГДА ЕСТЬNULL(ТЧПоставщики.СчетФактура.Номер, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерВыданногоСчетаФактуры
	|ПОМЕСТИТЬ ВТ_РеквизитыПартий
	|ИЗ
	|	Документ.ОтчетКомитенту.Поставщики КАК ТЧПоставщики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ДокПоступления
	|		ПО ТЧПоставщики.Партия = ДокПоступления.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученный
	|		ПО (ДокПоступления.Ссылка = СчетФактураПолученный.ДокументОснование)
	|ГДЕ
	|	ТЧПоставщики.Ссылка В(&МассивОбъектов)
	|	И ТЧПоставщики.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОтчетКомитенту.ОтчетОЗакупках)
	|	И ТИПЗНАЧЕНИЯ(ТЧПоставщики.Партия) = ТИП(Документ.ПоступлениеМЗ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧПоставщики.Ссылка,
	|	ТЧПоставщики.НомерСтроки,
	|	ТЧПоставщики.КлючСтроки,
	|	ТЧПоставщики.Поставщик,
	|	ТЧПоставщики.Партия,
	|	ПоступлениеУслугРабот.Дата,
	|	ВЫБОР
	|		КОГДА НЕ СчетФактураПолученный.Ссылка ЕСТЬ NULL
	|			ТОГДА СчетФактураПолученный.Ссылка.ДатаПервичногоДокумента
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ СчетФактураПолученный.Ссылка ЕСТЬ NULL
	|			ТОГДА СчетФактураПолученный.Ссылка.НомерПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ЕСТЬNULL(ПоступлениеУслугРабот.ДатаПервичногоДокумента, ДАТАВРЕМЯ(1, 1, 1)),
	|	ЕСТЬNULL(ПоступлениеУслугРабот.НомерПервичногоДокумента, """"),
	|	ТЧПоставщики.СчетФактура,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.ПолученСФ
	|			ТОГДА ЕСТЬNULL(ТЧПоставщики.СчетФактура.Дата, ТЧПоставщики.ДатаСФ)
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.ПолученСФ
	|			ТОГДА ЕСТЬNULL(ТЧПоставщики.СчетФактура.Номер, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|ИЗ
	|	Документ.ОтчетКомитенту.Поставщики КАК ТЧПоставщики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	|		ПО ТЧПоставщики.Партия = ПоступлениеУслугРабот.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученный
	|		ПО (ПоступлениеУслугРабот.Ссылка = СчетФактураПолученный.ДокументОснование)
	|ГДЕ
	|	ТЧПоставщики.Ссылка В(&МассивОбъектов)
	|	И ТЧПоставщики.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОтчетКомитенту.ОтчетОЗакупках)
	|	И ТИПЗНАЧЕНИЯ(ТЧПоставщики.Партия) = ТИП(Документ.ПоступлениеУслугРабот)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЧПоставщики.Ссылка,
	|	ТЧПоставщики.КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОтчетКомитентуТовары.ДокументРасчетов.ДокументОснование ССЫЛКА Документ.НакладнаяНаОтпускМ15
	|			ТОГДА ВЫРАЗИТЬ(ОтчетКомитентуТовары.ДокументРасчетов.ДокументОснование КАК Документ.НакладнаяНаОтпускМ15)
	|		КОГДА ОтчетКомитентуТовары.ДокументРасчетов.ДокументОснование ССЫЛКА Документ.НакладнаяНаРеализациюТорг12
	|			ТОГДА ВЫРАЗИТЬ(ОтчетКомитентуТовары.ДокументРасчетов.ДокументОснование КАК Документ.НакладнаяНаРеализациюТорг12)
	|	КОНЕЦ КАК ДокОснование,
	|	ПоступлениеМЗ.Ссылка КАК ДокументРасчетов
	|ПОМЕСТИТЬ ВТ_ДокОснованияВозвратов
	|ИЗ
	|	Документ.ОтчетКомитенту.Товары КАК ОтчетКомитентуТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО ОтчетКомитентуТовары.ДокументРасчетов = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ОтчетКомитентуТовары.Ссылка В(&МассивОбъектов)
