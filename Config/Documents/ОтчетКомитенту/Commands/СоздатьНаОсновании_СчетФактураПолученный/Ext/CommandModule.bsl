
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) 
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Счет-фактура от комитента по авансам полученным (перевыставленный)");
	СписокВыбора.Добавить("Счет-фактура от комитента по реализации (перевыставленный)");
	СписокВыбора.Добавить("Корректировочный счет-фактура от комитента (перевыставленный)");
	
	Оповещение = Новый ОписаниеОповещения("ВыборИзСпискаЗавершение", ЭтотОбъект, ПараметрКоманды);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите вид счета-фактуры полученного'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИзСпискаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйЭлемент.Значение = "Счет-фактура от комитента по авансам полученным (перевыставленный)" Тогда 
		
		ЭлементыОтбора = Новый Структура("ПричинаНалогообложенияНДС, Основание", ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента"), ДополнительныеПараметры);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
		ОткрытьФорму("Документ.СчетФактураПолученный.ФормаОбъекта", ПараметрыФормы);
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Счет-фактура от комитента по реализации (перевыставленный)" Тогда
		
		ЭлементыОтбора = Новый Структура("ПричинаНалогообложенияНДС, Основание", ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента"), ДополнительныеПараметры);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
		ОткрытьФорму("Документ.СчетФактураПолученный.ФормаОбъекта", ПараметрыФормы);
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Корректировочный счет-фактура от комитента (перевыставленный)" Тогда
		
		ЭлементыОтбора = Новый Структура("ПричинаНалогообложенияНДС, Основание", ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента"), ДополнительныеПараметры);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
		ОткрытьФорму("Документ.КорректировочныйСчетФактураПолученный.ФормаОбъекта", ПараметрыФормы);
	
	КонецЕсли;
	
КонецПроцедуры