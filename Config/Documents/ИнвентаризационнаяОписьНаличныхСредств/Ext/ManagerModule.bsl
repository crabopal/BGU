Функция РазделЗаполнен(НомерРазделаСтрокой, Данные, СтрокаШапки)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["Раздел" + НомерРазделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	Возврат Выборка.Количество() > 0;
	
КонецФункции

