#Область ЗаполнениеРазделов

Функция ПолучитьПараметрыПоискаНаличныхСредств(ПараметрыПроцедуры)
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПроцедуры.ДатаИнвентаризации);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",							ДатаОстатков);
	ПараметрыПоиска.Вставить("Организация",								ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("СписокСчетов",							БухгалтерскийУчет.СписокСчетов("201.34", ДатаОстатков));
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",					Ложь);
	ПараметрыПоиска.Вставить("КФО",										Неопределено);
	ПараметрыПоиска.Вставить("ИспользоватьВалютныйУчет",				ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",					ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",					ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("ИФО",										ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",		ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("Подразделение",							ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ВалютаРУ",								БухгалтерскиеОперации.ВалютаРегламентированногоУчета());
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткаДенежныхСредств()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Детальные остатки
	|//
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И Остатки.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) И Остатки.Валюта <> &ВалютаРУ ТОГДА
	|			Остатки.Валюта
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ											КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И Остатки.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) И Остатки.Валюта <> &ВалютаРУ ТОГДА
	|			Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ
	|			Остатки.СуммаОстаток
	|	КОНЕЦ											КАК Сумма,
	|	Остатки.КФО										КАК КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			Остатки.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ											КАК ИФО,
	|	Остатки.КПС										КАК КПС,
	|	Остатки.КЭК										КАК КЭК,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ											КАК Подразделение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков, // 1
	|		Счет В (&СписокСчетов), // 2
	|		, // 3
	|		Организация = &Организация // 4
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО И &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)	КАК Остатки
	|ГДЕ
	|	// Отбор по подразделению
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
КонецФункции

Процедура УдалитьНулевыеДетальныеОстатки(ДетальныеОстатки, ТаблицаРаздела1)
	
	Если ТаблицаРаздела1.Количество() = 0 Тогда
		ДетальныеОстатки.Очистить();
		
		Возврат;
	КонецЕсли;
	
	ПоискВалюты = Новый Структура("Валюта");
	
	Для Каждого СтрокаРаздела1 Из ТаблицаРаздела1 Цикл
		Если СтрокаРаздела1.Сумма <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПоискВалюты, СтрокаРаздела1);
		
		МассивСтрокОстатков = ДетальныеОстатки.НайтиСтроки(ПоискВалюты);
		
		Для Каждого СтрокаТаблицыОстатков Из МассивСтрокОстатков Цикл
			ДетальныеОстатки.Удалить(СтрокаТаблицыОстатков);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

Функция ПечатьФормы0510467(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	КлючПараметровПечати = "ПечатьФормы0510467";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.Автомасштаб = Истина;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати0510467(МассивОбъектов);
	
	ОбластиМакета = ПолучитьОбластиМакета0510467();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		ТабДокумент = СформироватьПечатнуюФорму0510467(Данные, ВыборкаШапка, ОбластиМакета, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510467 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФорму0510467(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	КлючПараметровПечати = "ПечатьФормы0510467";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.Автомасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	СведенияМОЛ = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.МОЛ, СтрокаШапки.Дата);
	
	ЗначенияПараметров.Вставить("ОтветственноеЛицо",	СтрШаблон("%1 %2", СведенияМОЛ.ДолжностьНаименование, СведенияМОЛ.ФИОПолное));
	ЗначенияПараметров.Вставить("УчетныйНомер",			СведенияМОЛ.Код);
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерДокументаДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.РешениеОПроведенииИнвентаризации,
		СтрокаШапки.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("Дата",				СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер",			НомерДокументаДляПечати);
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапки.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапки.НомерКомиссии, СтрокаШапки.НомерРабочейКомиссии, Истина));

	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 1
	
	ВывестиТаблицуРаздела0510467("1", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабДокумент.Вывести(ОбластиМакета.Раздел2Заголовок);
	
	ВывестиТаблицуРаздела0510467("21", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	Область = ОбластиМакета.Раздел21НомераДокументов;
	Область.Параметры.Заполнить(СтрокаШапки);
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, СтрокаШапки, Данные.ПрочеркиПустыхПолей, "Раздел21_НомераКассовыхДокументов");
	ТабДокумент.Вывести(Область);
	
	ВывестиТаблицуРаздела0510467("22", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 2
	
	ОбщиеПараметрыВыводаКомиссии = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ОбщиеПараметрыВыводаКомиссии.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии:'");
	ОбщиеПараметрыВыводаКомиссии.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ОбщиеПараметрыВыводаКомиссии.ЗаголовокУполномоченногоЛица	= НСтр("ru='Уполномоченное председателем лицо:'");
	ОбщиеПараметрыВыводаКомиссии.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапки.НомерРабочейКомиссии);
	ОбщиеПараметрыВыводаКомиссии.ВыводитьДополнительныеСведения = Истина;
	ОбщиеПараметрыВыводаКомиссии.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ОбщиеПараметрыВыводаКомиссии.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел2, ОбщиеПараметрыВыводаКомиссии);
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 3
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	Если РазделЗаполнен("3", Данные, СтрокаШапки) Тогда
		ВывестиТаблицуРаздела0510467("3", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		// ПРИЛОЖЕНИЯ
		
		УправлениеПечатьюБГУ.ВывестиПриложенияПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.Приложение);
	Иначе
		// В случае отсутствия расхождений (излишков и (или) недостачи) табличная часть Раздела 3
		// и перечень приложений к нему не формируется и в копии электронной Инвентаризационной описи
		// (ф. 0510467) на бумажном носителе не отображается.
		ТабДокумент.Вывести(ОбластиМакета.Раздел3Заголовок);
	КонецЕсли;
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.МОЛ, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственное лицо'"));
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 4
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиТаблицуРаздела0510467("4", ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 4
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел4, ОбщиеПараметрыВыводаКомиссии);
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнитель, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиТаблицуРаздела0510467(НомерРазделаСтрокой, ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["Раздел" + НомерРазделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	НаборыКолонок = Новый Массив();
	НаборыКолонок.Добавить(1);
	
	Если НомерРазделаСтрокой = "3" Тогда
		// В разделе 3 два набора колонок
		НаборыКолонок.Добавить(2);
	КонецЕсли;
	
	КоличествоНаборовКолонок = НаборыКолонок.Количество();
	
	Для Каждого НомерНабораКолонок Из НаборыКолонок Цикл
		ИмяКлючаПрочерков = "Раздел" + НомерРазделаСтрокой;
		
		Если НомерРазделаСтрокой = "3" Тогда
			ИмяКлючаПрочерков = ИмяКлючаПрочерков + "_НаборКолонок" + Строка(НомерНабораКолонок);
		КонецЕсли;
		
		ПостфиксИмениОбласти = ?(КоличествоНаборовКолонок > 1, НомерНабораКолонок, "");
		
		ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
		
		// Заголовок выводим только один раз, перед первым набором колонок.
		Если НомерНабораКолонок = 1 Тогда
			ПараметрыВыводаТаблицы.Области.Заголовок			= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Заголовок"];
		КонецЕсли;
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Шапка" + ПостфиксИмениОбласти];
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Строка" + ПостфиксИмениОбласти];
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета["Раздел" + НомерРазделаСтрокой + "Итого" + ПостфиксИмениОбласти];
		
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.ИнвентаризационнаяОписьНаличныхСредств.ЗаполнитьОбластьСтрокаТаблицы0510467";
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей",	Данные.ПрочеркиПустыхПолей);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ИмяКлючаПрочерков",	ИмяКлючаПрочерков);
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		ВремЗапрос = Новый Запрос("ВЫБРАТЬ 0 КАК Поле1");
		ВыборкаИтогиТаблицы = ВремЗапрос.Выполнить().Выбрать();
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаИтогиТаблицы;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		Если НомерНабораКолонок <> КоличествоНаборовКолонок Тогда
			Выборка = ОбщаяВыборка.Выбрать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

