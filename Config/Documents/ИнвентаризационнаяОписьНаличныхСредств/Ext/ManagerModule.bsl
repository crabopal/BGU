Функция ПолучитьДанныеДляПечати0510467(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510467();
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Данные.Выборки.Вставить("Шапки",	РезультатыЗапроса[0].Выбрать());
	Данные.Выборки.Вставить("Раздел1",	РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел21",	РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел22",	РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел3",	РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел4",	РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	// Для раздела 2 не применяются приложенные файлы, они применяются только к разделу 4.
	Данные.Вставить("СоставКомиссииРаздел2", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел2"));
	Данные.СоставКомиссииРаздел2.ЗаполнитьЗначения(Неопределено, "ФайлОсобогоМнения");
	Данные.СоставКомиссииРаздел2.ЗаполнитьЗначения(Неопределено, "НаименованиеФайлаОсобогоМнения");
	
	Данные.Вставить("СоставКомиссииРаздел4", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел4"));
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Данные.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Раздел1", "НаименованиеВалюты,КодВалюты");
	ИменаПолей.Вставить("Раздел21", "НаименованиеВалюты,КодВалюты");
	ИменаПолей.Вставить("Раздел21_НомераКассовыхДокументов", "ПоследнийНомерПКО,ПоследнийНомерРКО");
	ИменаПолей.Вставить("Раздел22", "НаименованиеВалюты,КодВалюты");
	ИменаПолей.Вставить("Раздел3_НаборКолонок1", "НаименованиеВалюты,КодВалюты,НаименованиеДокумента,НомерДокумента,ДатаДокумента");
	ИменаПолей.Вставить("Раздел3_НаборКолонок2", "ОбъяснениеПричинРасхождений");
	ИменаПолей.Вставить("Раздел4", "НаименованиеВалюты,КодВалюты,СтатусОбъяснения,ЗаключениеКомиссии");
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
КонецФункции

