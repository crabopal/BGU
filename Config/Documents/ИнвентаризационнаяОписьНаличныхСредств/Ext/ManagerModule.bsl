#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
	КонецЕсли;
	
	ПроверитьДублиСтрокРаздела21(ДокументОбъект, ЕстьОшибки);
	
	ПроверитьРаздел3(ДокументОбъект, ЕстьОшибки);
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел2", НСтр("ru='Состав комиссии для раздела 2'"));
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел4", НСтр("ru='Состав комиссии для раздела 4'"));
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура УстановитьВыявленыОтклонения(ДокументОбъект) Экспорт
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел4 Цикл
		Если СтрокаТаблицы.СуммаИзлишки <> 0 Или СтрокаТаблицы.СуммаНедостача <> 0 Тогда
			ДокументОбъект.ВыявленыОтклонения = Истина;
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ВыявленыОтклонения = Ложь;
	
КонецПроцедуры

#Область ЗаполнениеРазделов

Функция ПолучитьДанныеБухУчета(ПараметрыПроцедуры) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаНаличныхСредств(ПараметрыПроцедуры);
	
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаОстатков",							ПараметрыПоиска.ДатаОстатков);
	ЗапросОстатки.УстановитьПараметр("Организация",								ПараметрыПоиска.Организация);
	ЗапросОстатки.УстановитьПараметр("СписокСчетов",							ПараметрыПоиска.СписокСчетов);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоКФО",					ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросОстатки.УстановитьПараметр("КФО",										ПараметрыПоиска.КФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьВалютныйУчет",				ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоИФО",					ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоИФО",					ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросОстатки.УстановитьПараметр("ИФО",										ПараметрыПоиска.ИФО);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",		ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоОдномуПодразделению);
	ЗапросОстатки.УстановитьПараметр("Подразделение",							ПараметрыПоиска.Подразделение);
	ЗапросОстатки.УстановитьПараметр("ВалютаРУ",								ПараметрыПоиска.ВалютаРУ);
	
	ЗапросОстатки.Текст = ПолучитьТекстЗапросаОстаткаДенежныхСредств();
	
	УстановитьПривилегированныйРежим(Истина);
	ДетальныеОстатки = ЗапросОстатки.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаРаздела1 = ДетальныеОстатки.Скопировать();
	ТаблицаРаздела1.Свернуть("Валюта", "Сумма");
	
	УдалитьНулевыеДетальныеОстатки(ДетальныеОстатки, ТаблицаРаздела1);
	
	Если ТаблицаРаздела1.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаРаздела1.Добавить();
		НоваяСтрока.Валюта = ПараметрыПоиска.ВалютаРУ;
		НоваяСтрока.Сумма = 0;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаОстатки", ДетальныеОстатки);
	Результат.Вставить("ТаблицаРаздела1", ТаблицаРаздела1);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела21(ПараметрыПроцедуры) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыПроцедуры.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаРаздела21 = ЗапросЗаполнение.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела21", ТаблицаРаздела21);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПоследниеПроведенныеКассовыеДокументы(ПараметрыПроцедуры) Экспорт
	
	СоответствиеДокументРеквизит = Новый Соответствие();
	СоответствиеДокументРеквизит.Вставить("ПриходныйКассовыйОрдер",	"ПоследнийПКО");
	СоответствиеДокументРеквизит.Вставить("РасходныйКассовыйОрдер",	"ПоследнийРКО");
	
	ИменаДокументов = Новый Массив();
	ИменаДокументов.Добавить("ПриходныйКассовыйОрдер");
	ИменаДокументов.Добавить("РасходныйКассовыйОрдер");
	
	Запросы = Новый Запрос();
	Запросы.УстановитьПараметр("Организация",								ПараметрыПроцедуры.Организация);
	Запросы.УстановитьПараметр("ДатаИнвентаризации",						ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыПроцедуры.ДатаИнвентаризации));
	Запросы.УстановитьПараметр("ИФО",										ПараметрыПроцедуры.ИФО);
	Запросы.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запросы.УстановитьПараметр("БезУчетаИФО",								Не ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	Запросы.УстановитьПараметр("Подразделение",								ПараметрыПроцедуры.Подразделение);
	Запросы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запросы.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	
	// Получим по одному самому последнему документу каждого вида
	Текст = "	
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка										КАК Ссылка,
	|	Дата										КАК Дата,
	|	Номер										КАК Номер,
	|	""[ОбозначениеСоответствующегоРеквизита]""	КАК ОбозначениеСоответствующегоРеквизита
	|ИЗ
	|	Документ.[ИмяДокумента]
	|ГДЕ
	|	Дата <= &ДатаИнвентаризации
	|	И	Организация = &Организация
	|	И	Проведен
	|	// Отбор по ИФО:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО И НЕ &БезУчетаИФО ТОГДА
	|			ИФО = &ИФО
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	// Отбор по подразделению:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;";
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;";
	
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеСоответствующегоРеквизита",	СоответствиеДокументРеквизит.Получить(ИмяДокумента));
		ВставляемыеЗначения.Вставить("ИмяДокумента",			ИмяДокумента);
		ТекстЗапроса = ТекстЗапроса + СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Текст, ВставляемыеЗначения);
	КонецЦикла;
	Запросы.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = Запросы.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Получим самый последний документ для каждого обозначения реквизита:
	ВозвращаемыйРезультат = Новый Структура();
	ПоследниеДокументы = Новый Структура();
	ПоследнийДокумент = Неопределено;
	инд = 0;
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		ОбозначениеСоответствующегоРеквизита = СоответствиеДокументРеквизит.Получить(ИмяДокумента);
		инд = инд + 1;
		РезультатЗапроса = РезультатыЗапроса[инд];
		
		Если РезультатЗапроса.Пустой() Тогда
			ТекДата		= '00010101';
			ТекСсылка	= Неопределено;
			ТекНомер	= "";
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ТекДата		= Выборка["Дата"];
			ТекСсылка	= Выборка["Ссылка"];
			ТекНомер	= Выборка["Номер"];
		КонецЕсли;
		
		ОбновитьПоследнийДокумент = Ложь;
		Если ПоследниеДокументы.Свойство(ОбозначениеСоответствующегоРеквизита, ПоследнийДокумент) Тогда
			Если ТекДата > ПоследнийДокумент["Дата"] Тогда
				ОбновитьПоследнийДокумент = Истина;
			КонецЕсли;
		Иначе
			ОбновитьПоследнийДокумент = Истина;
		КонецЕсли;
		
		Если ОбновитьПоследнийДокумент Тогда
			ПоследнийДокумент = Новый Структура();
			ПоследнийДокумент.Вставить("Дата",		ТекДата);
			ПоследнийДокумент.Вставить("Ссылка",	ТекСсылка);
			ПоследнийДокумент.Вставить("Номер",		ТекНомер);
			ПоследниеДокументы.Вставить(ОбозначениеСоответствующегоРеквизита, ПоследнийДокумент);
			
			// Возвращаемые сведения
			ИмяРеквизитаСсылка = ОбозначениеСоответствующегоРеквизита;
			
			Если ИмяРеквизитаСсылка = "ПоследнийПКО" Тогда
				ИмяРеквизитаНомер = "ПоследнийНомерПКО";
				
			ИначеЕсли ИмяРеквизитаСсылка = "ПоследнийРКО" Тогда
				ИмяРеквизитаНомер = "ПоследнийНомерРКО"
			КонецЕсли;
			
			ЗначениеРеквизитаСсылка	= ТекСсылка;
			Если ЗначениеЗаполнено(ЗначениеРеквизитаСсылка) Тогда
				ЗначениеРеквизитаНомер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
					ЗначениеРеквизитаСсылка,
					ПоследнийДокумент["Номер"]);
			Иначе
				ЗначениеРеквизитаНомер = "";
			КонецЕсли;
			ВозвращаемыйРезультат.Вставить(ИмяРеквизитаСсылка,	ЗначениеРеквизитаСсылка);
			ВозвращаемыйРезультат.Вставить(ИмяРеквизитаНомер,	ЗначениеРеквизитаНомер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВозвращаемыйРезультат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела22(ПараметрыПроцедуры) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыПроцедуры.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел21
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросЗаполнение.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаРаздела1 = РезультатыЗапроса[0].Выгрузить();
	
	ТаблицаРаздела21 = РезультатыЗапроса[1].Выгрузить();
	
	ТаблицаРаздела22 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьНаличныхСредств.ТабличныеЧасти.Раздел22);
	
	ПараметрыРасчета = ИнвентаризацияСервер.ПолучитьПараметрыРасчетаИзлишковНедостачи();
	ПараметрыРасчета.ПовторитьТаблицуУчет = Истина;
	
	ИнвентаризацияСервер.РассчитатьИзлишкиНедостачу(ТаблицаРаздела1, ТаблицаРаздела21, ТаблицаРаздела22, "Валюта", "Сумма", ПараметрыРасчета);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела22", ТаблицаРаздела22);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела3(ПараметрыПроцедуры) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыПроцедуры.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел22
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И Не (СуммаИзлишки = 0 И СуммаНедостача = 0)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаРаздела22 = ЗапросЗаполнение.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаРаздела3 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьНаличныхСредств.ТабличныеЧасти.Раздел3);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела22 Цикл
		НоваяСтрока = ТаблицаРаздела3.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "Валюта,СуммаИзлишки,СуммаНедостача");
		
		НоваяСтрока.КодСтроки = СтрокаТаблицы.НомерСтроки;
		
		НоваяСтрока.СуммаИзлишкиНеПодтверждено = СтрокаТаблицы.СуммаИзлишки;
		НоваяСтрока.СуммаНедостачаНеПодтверждено = СтрокаТаблицы.СуммаНедостача;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела3", ТаблицаРаздела3);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияРаздела4(ПараметрыПроцедуры) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка", ПараметрыПроцедуры.ДокументСсылка);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные раздела 3
	|//
	|ВЫБРАТЬ
	|	НомерСтроки						КАК НомерСтроки,
	|	КодСтроки						КАК КодСтроки,
	|	Валюта							КАК Валюта,
	|	СуммаИзлишкиНеПодтверждено		КАК СуммаИзлишки,
	|	СуммаНедостачаНеПодтверждено	КАК СуммаНедостача
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел3
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные раздела 1
	|//
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	Валюта		КАК Валюта
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросЗаполнение.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [0]. Данные раздела 3
	ТаблицаРаздела3 = РезультатыЗапроса[0].Выгрузить();
	
	// [1]. Данные раздела 1
	ТаблицаРаздела1 = РезультатыЗапроса[1].Выгрузить();
	
	ТекстЗаключенияКомиссииОтклоненияНеВыявлены = ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ПараметрыПроцедуры.ДокументСсылка);
	
	ТаблицаРаздела4 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьНаличныхСредств.ТабличныеЧасти.Раздел4);
	
	ВыявленыОтклонения = Ложь;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела3 Цикл
		НоваяСтрока = ТаблицаРаздела4.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "КодСтроки,Валюта,СуммаИзлишки,СуммаНедостача");
		
		Если СтрокаТаблицы.СуммаИзлишки = 0 И СтрокаТаблицы.СуммаНедостача = 0 Тогда
			НоваяСтрока.ЗаключениеКомиссии = ТекстЗаключенияКомиссииОтклоненияНеВыявлены;
			НоваяСтрока.СтатусОбъяснения = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
		Иначе
			ВыявленыОтклонения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ИнвентаризацияСервер.ЗаполнитьСтатусОбъясненияНеТребуется(ТаблицаРаздела4, ПараметрыПроцедуры.ДокументСсылка);
	
	Если Не ВыявленыОтклонения Тогда
		// при отсутствии отклонений в таблице 4 приведем все строки из таблицы 1.
		
		ЗаключениеКомиссииОтклоненияНеВыявлены = ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ПараметрыПроцедуры.ДокументСсылка);
		
		ТаблицаРаздела4.Очистить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаРаздела1 Цикл
			НоваяСтрока = ТаблицаРаздела4.Добавить();
			
			НоваяСтрока.КодСтроки = СтрокаТаблицы.НомерСтроки;
			НоваяСтрока.Валюта = СтрокаТаблицы.Валюта;
			НоваяСтрока.ЗаключениеКомиссии = ЗаключениеКомиссииОтклоненияНеВыявлены;
			НоваяСтрока.СтатусОбъяснения = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела4", ТаблицаРаздела4);
	Результат.Вставить("ВыявленыОтклонения", ВыявленыОтклонения);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("МОЛ");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("МестоИнвентаризации");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела22(Знач ДокументОбъект, Отказ) Экспорт
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела4(Знач ДокументОбъект, Отказ) Экспорт
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", Отказ);
	КонецЕсли;
	
КонецПроцедуры

