Процедура ПроверитьДублиСтрокРаздела21(ДокументОбъект, Отказ)
	
	ИмяТЧ = "Раздел21";
	
	ПредставлениеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНаличныхСредств.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	ДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ДокументОбъект.Раздел21, "Валюта");
	
	Если ДублиСтрок.Количество() > 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
	ПараметрыВывода.ТаблицаИмя					= ИмяТЧ;
	ПараметрыВывода.ТаблицаПредставление		= ПредставлениеТЧ;
	ПараметрыВывода.ОбъектСсылка				= ДокументОбъект.Ссылка;
	ПараметрыВывода.ШаблонСтроки				= НСтр("ru='Обнаружены дубли строк валюты (Таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
	ПараметрыВывода.ИмяПоляДляВыводаСообщений	= "Валюта";
	
	ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ДублиСтрок, ПараметрыВывода);
	
КонецПроцедуры

Процедура ПроверитьРаздел3(ДокументОбъект, Отказ)
	
	ИмяТЧ = "Раздел3";
	
	ПредставлениеТЧ = НСтр("ru='Раздел 3'");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел3 Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаИзлишкиПодтверждено) Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаНедостачаПодтверждено) Тогда
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеДокумента) Тогда
				Отказ = Истина;
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='Наименование документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументОбъект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "НаименованиеДокумента"));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерДокумента) Тогда
				Отказ = Истина;
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='Номер документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументОбъект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "НомерДокумента"));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаДокумента) Тогда
				Отказ = Истина;
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='Дата документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументОбъект.Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "ДатаДокумента"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

