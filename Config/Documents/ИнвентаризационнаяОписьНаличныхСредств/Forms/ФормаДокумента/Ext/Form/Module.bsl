#Область РешениеОПроведенииИнвентаризации

&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтаФорма, РезультатВыбора);
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	
	Объект.Раздел1.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

#Область ПоследниеНомераКассовыхДокументов

&НаСервере
Процедура НомерКассовогоДокумента_Инициализация()
	
	// Имена открываемых форм документов
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("ПоследнийНомерПКО", "Документ.ПриходныйКассовыйОрдер.ФормаВыбора");
	ВремСоответствие.Вставить("ПоследнийНомерРКО", "Документ.РасходныйКассовыйОрдер.ФормаВыбора");
	
	ИменаФормДокументов = Новый ФиксированноеСоответствие(ВремСоответствие);
	
КонецПроцедуры

&НаКлиенте
Функция НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	ИменаРеквизитов = Новый Структура();
	ИменаРеквизитов.Вставить("ДокументСсылка", СтрЗаменить(ИмяЭлемента, "Номер", ""));
	ИменаРеквизитов.Вставить("НомерДокумента", ИмяЭлемента);
	
	Возврат ИменаРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура НомерКассовогоДокумента_ПриИзменении(Элемент)
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	ДокументСсылка = Объект[ИменаРеквизитов["ДокументСсылка"]];
	ВведенныйНомер = Объект[ИменаРеквизитов["НомерДокумента"]];
	
	ОчиститьСсылку = ПустаяСтрока(ВведенныйНомер)
		ИЛИ НЕ НомерКассовогоДокумента_НомераОдинаковые(ДокументСсылка, ВведенныйНомер);
	
	Если ОчиститьСсылку Тогда
		Объект[ИменаРеквизитов["ДокументСсылка"]] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ПриНачалеВыбора(Элемент)
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	КассовыйДокументСсылка	= Объект[ИменаРеквизитов["ДокументСсылка"]];
	
	ИмяОткрываемойФормы = ИменаФормДокументов.Получить(Элемент.Имя);
	
	Если ТипЗнч(ИмяОткрываемойФормы) = Тип("СписокЗначений") Тогда
		ЗаголовокДиалога = НСтр("ru='Выбор типа данных'");
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("КассовыйДокументСсылка",	КассовыйДокументСсылка);
		ПараметрыОповещения.Вставить("Элемент",					Элемент);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НомерКассовогоДокумента_ВыбранТипДокумента", ЭтотОбъект, ПараметрыОповещения);
		
		ИмяОткрываемойФормы.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗавершении, ЗаголовокДиалога);
	Иначе
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ВыбранТипДокумента(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда
		ИмяОткрываемойФормы = РезультатВыбора.Значение;
		
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, ПараметрыОповещения["КассовыйДокументСсылка"], ПараметрыОповещения["Элемент"]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент)
	
	ПериодДляСписка = Новый СтандартныйПериод();
	ПериодДляСписка.ДатаОкончания = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект["ДатаИнвентаризации"]);
	
	Отбор = Новый Структура();
	Отбор.Вставить("Период",		ПериодДляСписка);
	Отбор.Вставить("Проведен",		Истина);
	Отбор.Вставить("Организация",	Объект["Организация"]);
	Если ИспользоватьУчетПоИФО И ЗначениеЗаполнено(Объект["ИФО"]) Тогда
		Отбор.Вставить("ИФО", Объект["ИФО"]);
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(Объект["Подразделение"]) Тогда
		Отбор.Вставить("Подразделение", Объект["Подразделение"]);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор",			Отбор);
	ПараметрыФормы.Вставить("ТекущаяСтрока",	КассовыйДокументСсылка);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	Объект[ИменаРеквизитов["ДокументСсылка"]] = ВыбранноеЗначение;
	
	Объект[ИменаРеквизитов["НомерДокумента"]] = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерКассовогоДокумента_НомераОдинаковые(ДокументСсылка, ВведенныйНомер)
	
	// Считаем номера одинаковыми с точностью до префикса, возможно удаленного настройкой
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ПустаяСтрока(ВведенныйНомер);
	КонецЕсли;
	
	ТекущийНомер = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка);
	
	НовыйНомер = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка, ВведенныйНомер);
	
	Возврат (ТекущийНомер = НовыйНомер);
	
КонецФункции

&НаСервереБезКонтекста
Функция НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка, НомерДокумента = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НомерДокумента = Неопределено Тогда
		НомерДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер");
	КонецЕсли;
	
	Возврат	РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		ДокументСсылка, НомерДокумента);
	
КонецФункции

&НаКлиенте
Процедура НомерКассовогоДокумента_УточнитьИОпределить()
	
	НомераПоследнихДокументовУжеЗаполнены =
		ЗначениеЗаполнено(Объект["ПоследнийНомерПКО"])
		Или ЗначениеЗаполнено(Объект["ПоследнийНомерРКО"]);
		
	Если НомераПоследнихДокументовУжеЗаполнены Тогда
		ТекстСообщения = НСтр("ru='Номера последних кассовых документов будут определены автоматически.
			|Продолжить?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НомерКассовогоДокумента_ПодтвержденоОпределение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	Иначе
		НомерКассовогоДокумента_ОпределитьСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ПодтвержденоОпределение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		НомерКассовогоДокумента_ОпределитьСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НомерКассовогоДокумента_ОпределитьСервер()
	
	ПараметрыПроцедуры = Новый Структура("
		|Организация,
		|Подразделение,
		|ДатаИнвентаризации,
		|ИФО");
	
	ЗаполнитьЗначенияСвойств(ПараметрыПроцедуры, Объект);
	
	ПоследниеОрдера = Документы.ИнвентаризационнаяОписьНаличныхСредств.ПолучитьПоследниеПроведенныеКассовыеДокументы(ПараметрыПроцедуры);
	
	ЗаполнитьЗначенияСвойств(Объект, ПоследниеОрдера);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРазделов

#Область Раздел1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент()
	
	Если Объект.Раздел1.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением по данным учета все табличные части документа будут очищены.
			|
			|Продолжить и заполнить по данным учета?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьПередЗаполнениемРаздела1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьПередЗаполнениемРаздела1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПередЗаполнениемРаздела1Клиент()
	
	Отказ = Ложь;
	
	ПроверитьПередЗаполнениемРаздела1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьНаличныхСредств.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	Объект.Раздел1.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер()
	
	ПараметрыФункции = Новый Структура("
		|Организация,
		|Подразделение,
		|ДатаИнвентаризации,
		|МОЛ,
		|ИФО,
		|КФО");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510467'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьНаличныхСредств.ПолучитьДанныеБухУчета",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел1.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 1 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
		
		Модифицированность = Истина;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 1 возникла ошибка.
			|Подробности см. в журнале регистрации.'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел1.Загрузить(Результат.ТаблицаРаздела1);
	Объект.Остатки.Загрузить(Результат.ТаблицаОстатки);
	
КонецПроцедуры

