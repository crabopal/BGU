Процедура ПроверитьИЗаполнитьРаздел4ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел4.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличная часть документа будет очищена.
			|
			|Продолжить и заполнить раздел 4'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел4КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьПередЗаполнениемРаздела4Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел4КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьПередЗаполнениемРаздела4Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПередЗаполнениемРаздела4Клиент()
	
	Отказ = Ложь;
	
	ПроверитьПередЗаполнениемРаздела4Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел4Клиент();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела4Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьНаличныхСредств.ПроверитьПередЗаполнениемРаздела4(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел4Клиент()
	
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	РезультатЗадания = ЗаполнитьРаздел4Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел4Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел4Сервер()
	
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции = Новый Структура("ДокументСсылка", Объект.Ссылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 4 инвентаризационной описи 0510467'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьНаличныхСредств.ПолучитьДанныеДляЗаполненияРаздела4",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел4Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел4Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел4.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 4 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10);
		КонецЕсли;
		
		Модифицированность = Истина;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 4 возникла ошибка.
			|Подробности см. в журнале регистрации.'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел4Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел4.Загрузить(Результат.ТаблицаРаздела4);
	
	Объект.ВыявленыОтклонения = Результат.ВыявленыОтклонения;
	
КонецПроцедуры

