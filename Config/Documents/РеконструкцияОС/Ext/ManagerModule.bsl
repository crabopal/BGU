#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС);
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияНМА);
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияНПА);
	Если ОперацииСоСчетом106.Найти(ДокументОбъект.ВидОперации) = Неопределено 
		ИЛИ НЕ ДокументОбъект.ОтразитьВКарточкеКапвложений Тогда
		Возврат Истина;	
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Стоимость вложений"" включен флажок 
		|""Отразить в:"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;	
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДокументОбъект.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;

	Возврат Истина;
КонецФункции	

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
		"Организация,Дата,Номер,ВидОперации,КФО,ТолькоРегистрацияАкта, СформироватьПеремещение");
		
	Если ЗначенияРеквизитов.ТолькоРегистрацияАкта Тогда
		// Очистим старые движения документа. Автоматически они не удаляются.  
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Для каждого НаборЗаписей из ДокументОбъект.Движения Цикл
			ИмяРегистра = НаборЗаписей.Метаданные().Имя;
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяРегистра, НаборЗаписей.ВыгрузитьКолонки());
		КонецЦикла;	
		
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяФормыДокумента"	, НСтр("ru = 'Акт приема-сдачи отремонтированных, реконструированных и модернизированных объектов основных средств'"));
	Запрос.УстановитьПараметр("НомерДокумента"		, ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер));
	Запрос.УстановитьПараметр("Организация"			, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("МоментВремени"		, Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ОСДокумента", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеконструкцияОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ОСДокумента
	|ИЗ
	|	Документ.РеконструкцияОС.ОсновныеСредства КАК РеконструкцияОСОсновныеСредства
	|ГДЕ
	|	РеконструкцияОСОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство";
	
	НомераТаблиц.Вставить("СобытияОССрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаВводаВЭксплуатацию
	|ПОМЕСТИТЬ СобытияОССрезПоследних
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)) КАК СобытияОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство";
	
	НомераТаблиц.Вставить("РасчетАмортизацииОССрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки
	|ПОМЕСТИТЬ РасчетАмортизацииОССрезПоследних
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)) КАК РасчетАмортизацииОССрезПоследних";
	
	НомераТаблиц.Вставить("СтоимостьОстатки", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор
	|ПОМЕСТИТЬ СтоимостьОстатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки";
	
	НомераТаблиц.Вставить("ДанныеДокумента", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	РеконструкцияОСОсновныеСредства.Ссылка.Дата КАК Дата,
	|	РеконструкцияОСОсновныеСредства.Ссылка.Организация КАК Организация,
	|	РеконструкцияОСОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	РеконструкцияОСОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА РеконструкцияОСОсновныеСредства.Ссылка.ВидПервичногоДокумента = """"
	|			ТОГДА &ИмяФормыДокумента
	|		ИНАЧЕ РеконструкцияОСОсновныеСредства.Ссылка.ВидПервичногоДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА РеконструкцияОСОсновныеСредства.Ссылка.НомерПервичногоДокумента = """"
	|			ТОГДА &НомерДокумента
	|		ИНАЧЕ РеконструкцияОСОсновныеСредства.Ссылка.НомерПервичногоДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА РеконструкцияОСОсновныеСредства.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА РеконструкцияОСОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ РеконструкцияОСОсновныеСредства.Ссылка.ДатаПервичногоДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	РеконструкцияОСОсновныеСредства.Ссылка.НаименованиеГарантийногоТалона КАК НаименованиеГТ,
	|	РеконструкцияОСОсновныеСредства.Ссылка.НомерГарантийногоТалона КАК НомерГТ,
	|	РеконструкцияОСОсновныеСредства.Ссылка.ДатаГарантийногоТалона КАК ДатаГТ,
	|	РеконструкцияОСОсновныеСредства.Ссылка.СрокДействияГарантийногоТалона КАК СрокДействияГТ,
	|	РеконструкцияОСОсновныеСредства.Ссылка.Договор КАК ДоговорИсполнителя,
	|	РеконструкцияОСОсновныеСредства.ВидРаботы КАК ВидРаботы,
	|	РеконструкцияОСОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	РеконструкцияОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	РеконструкцияОСОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РеконструкцияОСОсновныеСредства.ЦМО КАК ЦМО,
	|	РеконструкцияОСОсновныеСредства.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
	|	РеконструкцияОСОсновныеСредства.СрокЭксплуатацииФакт КАК СрокЭксплуатацииФакт,
	|	РеконструкцияОСОсновныеСредства.СрокПолезногоИспользованияПослеМодернизации КАК
	|		СрокПолезногоИспользованияПослеМодернизации,
	|	РеконструкцияОСОсновныеСредства.СрокПолезногоИспользованияПослеМодернизацииНУ КАК
	|		СрокПолезногоИспользованияПослеМодернизацииНУ,
	|	РеконструкцияОСОсновныеСредства.ПредполагаемыйОбъемВыработкиПослеМодернизации КАК
	|		ПредполагаемыйОбъемВыработкиПослеМодернизации,
	|	РеконструкцияОСОсновныеСредства.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаЗатратПоАмортизационнойПремии,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии1 КАК СубконтоПоАмортизационнойПремии1,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии2 КАК СубконтоПоАмортизационнойПремии2,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии3 КАК СубконтоПоАмортизационнойПремии3,
	|	РеконструкцияОСОсновныеСредства.СуммаКапитальныхВложенийВключаемыхВРасходыНУ КАК
	|		СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
	|	РеконструкцияОСОсновныеСредства.СуммаРемонта + РеконструкцияОСОсновныеСредства.СуммаДемонтажа +
	|		РеконструкцияОСОсновныеСредства.СуммаТранспортировки КАК СуммаРемонта,
	|	РеконструкцияОСОсновныеСредства.СуммаМодернизации + РеконструкцияОСОсновныеСредства.СуммаДемонтажа +
	|		РеконструкцияОСОсновныеСредства.СуммаТранспортировки КАК СуммаМодернизации,
	|	РеконструкцияОСОсновныеСредства.Сумма1 КАК Сумма1,
	|	РеконструкцияОСОсновныеСредства.Сумма2 КАК Сумма2,
	|	РеконструкцияОСОсновныеСредства.Сумма4 КАК Сумма4,
	|	РеконструкцияОСОсновныеСредства.Сумма5 КАК Сумма5,
	|	РеконструкцияОСОсновныеСредства.Сумма6 КАК Сумма6,
	|	РеконструкцияОСОсновныеСредства.Сумма7 КАК Сумма7,
	|	РеконструкцияОСОсновныеСредства.СуммаМодернизацииНУ КАК СуммаМодернизацииНУ,
	|	РеконструкцияОСОсновныеСредства.СуммаМодернизацииНеУчитываетсяНУ КАК СуммаМодернизацииНеУчитываетсяНУ,
	|	РеконструкцияОСОсновныеСредства.СуммаМодернизацииЕНВД КАК СуммаМодернизацииЕНВД,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ЕСТЬNULL(СобытияОССрезПоследних.ДатаВводаВЭксплуатацию, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВводаВЭксплуатацию,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	СтоимостьОстатки.Договор КАК Договор,
	|	РеконструкцияОСОсновныеСредства.ВосстановительнаяСтоимость КАК ВосстановительнаяСтоимость,
