
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сумма = Параметры.Сумма;
	РедактированиеРазрешено = Параметры.РедактированиеРазрешено;
	Редактирование = РедактированиеРазрешено;
	Элементы.ФормаВключитьРедактирование.Пометка = Редактирование;
	
	СформироватьТаблицуСуммыПоКФО();
	ЗаполнитьТаблицуСуммыПОКФОПоПараметрам();
	СформироватьПодвалТаблицыСуммыПоКФО(ЭтотОбъект);

	УправлениеРеквизитами(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСуммыПоКФО

&НаКлиенте
Процедура СуммыПоКФОПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	СформироватьПодвалТаблицыСуммыПоКФО(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Если НЕ ТаблицаЗаполненаКорректно() Тогда
		Текст = НСтр(
			"ru = 'Итоговая сумма в табличной части должна быть равна сумме, указанной в резквизите ""Сумма"".'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);	
		Возврат;
	КонецЕсли;	
	
	Закрыть(СуммыПоКФО);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВключитьРедактирование(Команда)
	Если НЕ Редактирование Тогда
		ТекстВопроса = НСтр("ru = 'Не рекомендуется редактировать распределение суммы затрат по КФО в табличной части.
							|Продолжить?'");
							
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;	 					
	КонецЕсли;
		
	Редактирование = НЕ Редактирование;
	Элементы.ФормаВключитьРедактирование.Заголовок = ?(Редактирование
	, НСтр("ru = 'Отключить редактирование'")
	, НСтр("ru = 'Включить редактирование'"));
	Элементы.ФормаВключитьРедактирование.Пометка = Редактирование;
	
	УправлениеРеквизитами(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ТаблицаЗаполненаКорректно()
	Итог = СуммыПоКФО.Итог("Сумма");
	
	Возврат(Итог = Сумма ИЛИ Итог = 0);
КонецФункции	

&НаСервере
Процедура ЗаполнитьТаблицуСуммыПОКФОПоПараметрам()
	Для каждого ТекСтрока из СуммыПоКФО Цикл
		ТекСтрока.Сумма = Параметры["Сумма" + ТекСтрока.КФО];
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура СформироватьТаблицуСуммыПоКФО()
	Для п = 1 по 7 Цикл
		Если п = 3 Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = СуммыПоКФО.Добавить();
		НоваяСтрока.КФО = "" + п;
	КонецЦикла;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьПодвалТаблицыСуммыПоКФО(Форма)
	Итог = Форма.СуммыПоКФО.Итог("Сумма"); 
	Форма.Элементы.СуммыПоКФОСумма.ТекстПодвала = Формат(Итог, "ЧЦ=18; ЧДЦ=2;");
	Форма.Элементы.СуммыПоКФОСумма.ЦветТекстаПодвала = 
		?(Итог = Форма.Сумма, Новый Цвет(), Новый Цвет(255, 0, 0));
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеРеквизитами(Форма)
	Форма.Элементы.ФормаВключитьРедактирование.Видимость = НЕ Форма.РедактированиеРазрешено;
	Форма.Элементы.ДекорацияПредупреждение.Видимость = НЕ Форма.РедактированиеРазрешено;
	Форма.Элементы.СуммыПоКФО.ТолькоПросмотр = НЕ Форма.Редактирование;
КонецПроцедуры	

#КонецОбласти

