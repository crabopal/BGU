&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	ДатаНачалаРаботПоДоговору = Объект.Договор.ДатаДоговора;
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		СрокиПоДоговорам = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(Объект.Договор, Объект.Дата);
		СрокиПоДоговору = СрокиПоДоговорам.Найти(Объект.Договор, "Договор");
		ДатаОкончанияРаботПоДоговору = ?(СрокиПоДоговору = Неопределено, Дата(1,1,1), СрокиПоДоговору.ОкончаниеДействия);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		СвойстваОбъекта = УправлениеСвойствами.ЗначенияСвойств(Объект.Договор, Истина, Ложь);
		СтруктураДатаОкончанияДоговора = СвойстваОбъекта.Найти(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора, "Свойство");
		ДатаОкончанияРаботПоДоговору = ?(СтруктураДатаОкончанияДоговора = Неопределено, "", СтруктураДатаОкончанияДоговора.Значение);
	КонецЕсли;
	
	Если Объект.ДатаНачалаРаботПоДоговору = Дата(1,1,1) Тогда
		Объект.ДатаНачалаРаботПоДоговору = ДатаНачалаРаботПоДоговору;
	КонецЕсли;
	Если Объект.ДатаОкончанияРаботПоДоговору = Дата(1,1,1) Тогда
		Объект.ДатаОкончанияРаботПоДоговору = ДатаОкончанияРаботПоДоговору;
	КонецЕсли;
	
	Если Объект.ДатаНачала = Дата(1,1,1) Тогда
		Объект.ДатаНачала =  ДатаНачалаРаботПоДоговору;
	КонецЕсли;
	Если Объект.ДатаОкончания = Дата(1,1,1) Тогда
		Объект.ДатаОкончания = ДатаОкончанияРаботПоДоговору;
	КонецЕсли;

КонецПроцедуры

