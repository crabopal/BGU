		ОсновноеСредствоПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
		
		// Обновим реквизиты на форме из строки табличной части.
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
		
