&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Не ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Сначала необходимо выбрать вид операции'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Объект вложений'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ВнеоборотныйАктив",, Отказ);
		Иначе
			Если ОбъектВложений_ВидНФА <> ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения") Тогда
				ТекстСообщения = НСтр("ru='Реконструкция, модернизация списка ОС, НМА возможна только 
					|при выборе объекта вложений с видом ""Капитальные вложения"".'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	УправлениеОсновнымиСредствамиКлиентСервер.СформироватьЗаголовокСуммыПоКФОвТЧ(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоНоваяСтрока = НоваяСтрока;

	Если НЕ НоваяСтрока Тогда
		Возврат;
	ИначеЕсли Копирование Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ОбнулитьСуммыХвСтрокеТЧ(Элементы.ОсновныеСредства.ТекущиеДанные);
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = Элементы.ОсновныеСредства.ТекущиеДанные;
	СтрокаТаблицы.ОтражениеВУчете = "<...>";
	ОбновитьТекстЗаголовковВСтрокеТаблицыОС(Объект, СтрокаТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
	
//	СуммаМодернизации = Объект.ОсновныеСредства.Итог("СуммаМодернизации");
//	СуммаРемонта = Объект.ОсновныеСредства.Итог("СуммаРемонта");
	
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПослеУдаления(Элемент)
	
	СуммаМодернизации = Объект.ОсновныеСредства.Итог("СуммаМодернизации");
	СуммаРемонта = Объект.ОсновныеСредства.Итог("СуммаРемонта");
	
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОтражениеВУчетеОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	СтруктураПолей = Новый Структура("СчетУчетаЗатратПоАмортизационнойПремии,
		|СубконтоПоАмортизационнойПремии1, СубконтоПоАмортизационнойПремии2, СубконтоПоАмортизационнойПремии3");
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияВУчете(Элементы.ОсновныеСредства.ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриАктивизацииЯчейки(Элемент)
	
	Если Элементы.ОсновныеСредства.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ОсновныеСредства.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ОсновныеСредстваОтражениеВУчете"
			И НЕ Элементы.ОсновныеСредства.ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.ОсновныеСредства.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

