&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьФлагиНалоговогоУчета(ЭтотОбъект);
	
	Если Объект.ОсновныеСредства.Количество() = 0 Тогда
		Объект.ОсновныеСредства.Добавить();
	КонецЕсли;
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.ВнеоборотныйАктив, Объект);
	УстановитьТекстПредставленияРНПТ();
	ЗаполнитьПредставлениеРНПТВоВсехСтроках();
	РежимФормыСписокОбъектов = (Объект.ОсновныеСредства.Количество() > 1);
	Если НЕ РежимФормыСписокОбъектов Тогда
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
	Иначе
		ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
	КонецЕсли;
	
	ОбъектВложений_ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВнеоборотныйАктив, "ВидНФА");
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	УстановитьВидимостьЗакладок(ЭтотОбъект);
	УстановитьВидимостьИОтборыКапВложения();
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	РассчитатьОставшиесяСрокиИспользования(ЭтотОбъект);
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	
	ОпределитьНаличиеДоговораВложения();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(Объект, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(Объект, ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокМодернизация    = НСтр("ru = 'модернизация:'");
	ТекущаяСтрока.ЗаголовокДемонтаж        = НСтр("ru = 'демонтаж:'");
	ТекущаяСтрока.ЗаголовокТранспортировка = НСтр("ru = 'транспортировка:'");
	ТекущаяСтрока.ЗаголовокРемонт          = НСтр("ru = 'ремонт:'");
	
	ТекущаяСтрока.ЗаголовокМодернизацияНУ               = НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокМодернизацияНеУчитываетсяНУ  = НСтр("ru = 'Не уч.:'");
	ТекущаяСтрока.ЗаголовокМодернизацияЕНВД             = НСтр("ru = 'ЕНВД:'");
	
	ТекущаяСтрока.ЗаголовокВосстановительнаяСтоимость   = НСтр("ru = 'восстановительная:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимость          = НСтр("ru = 'остаточная:'");
	ТекущаяСтрока.ЗаголовокСтоимостьПоОкончанииРабот    = НСтр("ru = 'по окончании работ:'");
	
	ТекущаяСтрока.ЗаголовокВосстановительнаяСтоимостьНУ = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимостьНУ        = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокСтоимостьПоОкончанииРаботНУ  = НСтр("ru = 'НУ:'");
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
		ТекущаяСтрока.ЗаголовокСрокПослеМодернизации   = НСтр("ru = 'по данным учета:'");
	Иначе
		ТекущаяСтрока.ЗаголовокСрокПослеМодернизации   = НСтр("ru = 'после модернизации:'");
	КонецЕсли;
	ТекущаяСтрока.ЗаголовокОставшийсяСрок          = НСтр("ru = 'оставшийся:'");
	ТекущаяСтрока.ЗаголовокФактическийСрок         = НСтр("ru = 'факт. срок использования:'");
	
	ТекущаяСтрока.ЗаголовокСрокПослеМодернизацииНУ = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокНУ        = НСтр("ru = 'НУ:'");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЗакладок(Форма)
	
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("ОсновныеСредства");
	МассивИмен.Добавить("ГруппаПодвалИтоги");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		МассивИмен, "Видимость", Форма.РежимФормыСписокОбъектов);
		
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("СтраницаНалоговыйУчет");
	МассивИмен.Добавить("СтраницаОсновноеСредство");
		
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		МассивИмен, "Видимость", НЕ Форма.РежимФормыСписокОбъектов);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИОтборыКапВложения()
	
	ВидОперации = Объект.ВидОперации;
	
	ЭтоКапРемонт = (ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС);
	
	РеквизитыМодернизации = Новый Массив;
	РеквизитыМодернизации.Добавить("ГруппаКапитальныеВложения");
	РеквизитыМодернизации.Добавить("СуммаДокумента");
	РеквизитыМодернизации.Добавить("СуммаМодернизации");
	РеквизитыМодернизации.Добавить("ОсновныеСредстваСуммаМодернизации");
	РеквизитыМодернизации.Добавить("ОсновныеСредстваЗаголовокМодернизация");
	РеквизитыМодернизации.Добавить("ОсновныеСредстваИтогСуммаМодернизации");
	РеквизитыМодернизации.Добавить("КапитальныеВложения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыМодернизации, "Видимость", НЕ ЭтоКапРемонт);
	
	РеквизитыМодернизации = Новый Массив;
	РеквизитыМодернизации.Добавить("СрокПолезногоИспользованияПослеМодернизации");
	РеквизитыМодернизации.Добавить("ОсновныеСредстваЗаголовокСрокПослеМодернизации");
	РеквизитыМодернизации.Добавить("ОсновныеСредстваСрокПолезногоИспользованияПослеМодернизации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыМодернизации, "ТолькоПросмотр", ЭтоКапРемонт);
	
	Элементы.СрокПолезногоИспользованияПослеМодернизации.Заголовок =
		?(ЭтоКапРемонт, НСтр("ru = 'По данным учета'"),
						НСтр("ru = 'После модернизации'"));
	
	РеквизитыКапРемонта = Новый Массив;
	РеквизитыКапРемонта.Добавить("СуммаВложенийВРемонт");
	РеквизитыКапРемонта.Добавить("СуммаРемонта");
	РеквизитыКапРемонта.Добавить("ОсновныеСредстваСуммаРемонта");
	РеквизитыКапРемонта.Добавить("ОсновныеСредстваЗаголовокРемонт");
	РеквизитыКапРемонта.Добавить("ОсновныеСредстваИтогСуммаРемонта");
//	РеквизитыКапРемонта.Добавить("ГруппаГарантийныйТалон");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыКапРемонта, "Видимость", ЭтоКапРемонт);
	
	// Параметры выбора объекта вложений, ОС, НМА и счета кредита.
	Если ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияНМА Тогда
		
		ПараметрыВыбораЗначения = Новый Массив;
		ПараметрыВыбораТЧ = Новый Массив;
		МассивВидовНФА = Новый Массив;
		МассивВидовНФА.Добавить(Перечисления.ВидыНФА.НМА);
		ПараметрыВыбораТЧ.Добавить(Новый ПараметрВыбора("Отбор.ВидНФА", Новый ФиксированныйМассив(МассивВидовНФА)));
		//Нельзя модернизировать ОС с групповым учетом
		ПараметрыВыбораТЧ.Добавить(Новый ПараметрВыбора("Отбор.ГрупповойУчет", Ложь));
		
		МассивВидовНФА.Добавить(Перечисления.ВидыНФА.КапВложения);
		ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.ВидНФА", Новый ФиксированныйМассив(МассивВидовНФА)));
		
		Элементы.ВнеоборотныйАктив.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
		Элементы.ОсновноеСредство.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораТЧ);
		Элементы.ОсновныеСредстваОсновноеСредство.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораТЧ);
		
		СписокСчетов = "106.22,106.2D,106.2I,106.2N,106.2R,106.32,106.3D,106.3I,106.3N,106.3R,106.42,106.60,106.9I";
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС
		ИЛИ ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		
		ПараметрыВыбораЗначения = Новый Массив;
		ПараметрыВыбораТЧ = Новый Массив;
		
		МассивВидовНФА = Новый Массив;
		МассивВидовНФА.Добавить(Перечисления.ВидыНФА.ОС);
		ПараметрыВыбораТЧ.Добавить(Новый ПараметрВыбора("Отбор.ВидНФА",	Новый ФиксированныйМассив(МассивВидовНФА)));
		Если ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС Тогда
			//Нельзя модернизировать ОС с групповым учетом
			ПараметрыВыбораТЧ.Добавить(Новый ПараметрВыбора("Отбор.ГрупповойУчет", Ложь));
		КонецЕсли;
		
		МассивВидовНФА.Добавить(Перечисления.ВидыНФА.КапВложения);
		ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("Отбор.ВидНФА", Новый ФиксированныйМассив(МассивВидовНФА)));
		
		Элементы.ВнеоборотныйАктив.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
		Элементы.ОсновноеСредство.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораТЧ);
		Элементы.ОсновныеСредстваОсновноеСредство.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораТЧ);
		
		СписокСчетов = "106.11,106.КС,106.21,106.31,106.41,106.91,106.92";
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияНПА Тогда
		
		СписокСчетов = "106.9I";
		
	КонецЕсли;
	
	ПараметрыВыбораСчета = Новый Массив;
	ПараметрыВыбораСчета.Добавить(Новый ПараметрВыбора("ОграниченияСчета", СписокСчетов));
	Элементы.СчетКредита.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСчета);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовЗаполненияЗатрат()
	
	Элементы.ЗаполнитьСуммуДемонтажа.Видимость = РежимФормыСписокОбъектов;
	Элементы.ЗаполнитьСуммуТранспортировки.Видимость = РежимФормыСписокОбъектов;
	Элементы.ДекорацияЗаполнительКнопки.Видимость = РежимФормыСписокОбъектов;
	
	Элементы.РазницаИтогаТЧРемонтРеконструкция.Видимость = РежимФормыСписокОбъектов;
	Элементы.РазницаИтогаТЧДемонтаж.Видимость = РежимФормыСписокОбъектов;
	Элементы.РазницаИтогаТЧТранспортировка.Видимость = РежимФормыСписокОбъектов;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект = Форма.Объект;
	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете;
	
	Форма.Элементы.СтраницаНалоговыйУчет.Видимость =
		ВидимостьЭлементовНалоговогоУчета И НЕ Форма.РежимФормыСписокОбъектов;
	
	// Шапка.
	РеквизитыНУ = Новый Массив;
	
	РеквизитыНУ.Добавить("СуммаМодернизацииНУ");
	РеквизитыНУ.Добавить("СуммаМодернизацииНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("СуммаМодернизацииЕНВД");
	
	РеквизитыНУ.Добавить("ВосстановительнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("ОстаточнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("СтоимостьПоОкончанииРаботНУ");
	
	РеквизитыНУ.Добавить("СрокПолезногоИспользованияПослеМодернизацииНУ");
	РеквизитыНУ.Добавить("СрокПолезногоИспользованияПослеМодернизацииОставшийсяНУ");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета);
	
	// Таблица кап.вложений.
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета
			И (НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоКПС(Объект.Дата) ИЛИ НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоЦМО(Объект.Дата)));
	
	// Таблица объектов ОС, НМА.
	РеквизитыНУ = Новый Массив;
	
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокМодернизацияНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокМодернизацияНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокМодернизацияЕНВД");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаМодернизацииНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаМодернизацииНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаМодернизацииЕНВД");
	
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокВосстановительнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокОстаточнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокСтоимостьПоОкончанииРаботНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваВосстановительнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваОстаточнаяСтоимостьНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСтоимостьПоОкончанииРаботНУ");
	
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокСрокПослеМодернизацииНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокОставшийсяСрокНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСрокПолезногоИспользованияПослеМодернизацииНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваОставшийсяСрокНУ");
	
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаКапитальныхВложенийВключаемыхВРасходыНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваОтражениеВУчете");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета);
	
	Если ВидимостьЭлементовНалоговогоУчета Тогда
		
		// Амортизационная премия.
		Если НЕ Форма.РежимФормыСписокОбъектов Тогда
			Форма.ВключитьКапитальныеВложенияВРасходыНУ = ПараметрыАмортизационнойПремииЗаполнены(Форма)
				ИЛИ Форма.ВключитьКапитальныеВложенияВРасходыНУ;
			УстановитьВидимостьПараметровАмортизационнойПремии(Форма);
			УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Форма.СчетУчетаЗатратПоАмортизационнойПремии);
		Иначе
			ЗаполнитьДобавленныеКолонкиОтражениеВУчете(Форма);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	Объект = Форма.Объект;

	РеквизитыСуммыПоКФО = Новый Массив;
	РеквизитыСуммыПоКФО.Добавить("ДекорацияСуммыПоКФО");
	РеквизитыСуммыПоКФО.Добавить("ОсновныеСредстваСуммыПоКФО");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыСуммыПоКФО, "Видимость", НЕ Объект.ТолькоРегистрацияАкта);
		
	ЭтоРемонт = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС"));
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("СформироватьПеремещение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, Реквизиты,  "Видимость", ЭтоРемонт);

	Реквизиты = Новый Массив;
	Реквизиты.Добавить("ЦМОПолучатель");
	Реквизиты.Добавить("ОсновныеСредстваЦМОПолучатель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, 
		Реквизиты,  "Видимость", ЭтоРемонт И Объект.СформироватьПеремещение);

	Реквизиты = Новый Массив;
	Реквизиты.Добавить("ОсновныеСредстваПодборОС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, Реквизиты,  "Видимость", 
		Форма.ОбъектВложений_ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения") ИЛИ ЭтоРемонт);
		
	РеквизитыПрослеживаемости = Новый Массив;
	РеквизитыПрослеживаемости.Добавить("ГруппаРНПТ");
	РеквизитыПрослеживаемости.Добавить("РНПТ");
	РеквизитыПрослеживаемости.Добавить("ОчиститьРНПТ");
	РеквизитыПрослеживаемости.Добавить("ОсновныеСредстваРНПТ");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, РеквизитыПрослеживаемости, "Видимость",
		Не ЭтоРемонт И Форма.ВедетсяУчетПрослеживаемыхТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьСвязанныхРеквизитовОрганизации()

	МассивИмен = Новый Массив;
	МассивИмен.Добавить("КФО");
	МассивИмен.Добавить("КПС");
	МассивИмен.Добавить("ВнеоборотныйАктив");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		МассивИмен, "Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	Элементы.ПримечаниеКДоговору.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект)
	
	КоличествоСтрок = Объект.ОсновныеСредства.Количество();
	Если КоличествоСтрок = 0 Тогда
		Объект.ОсновныеСредства.Добавить();
	ИначеЕсли КоличествоСтрок > 1 Тогда
		Объект.ОсновныеСредства.Очистить();
		Объект.ОсновныеСредства.Добавить();
	КонецЕсли;
	
	Возврат Объект.ОсновныеСредства[0];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(Форма, Объект)
	
	Если Форма.РежимФормыСписокОбъектов Тогда
		// При режиме редактирования объектов ОС, НМА списком
		// эти реквизиты обновлять не нужно, т.к. они не отображаются.
		Возврат;
	КонецЕсли;
	
	ПерваяСтрокаТаблицыОС = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
	ЗаполнитьЗначенияСвойств(Форма, ПерваяСтрокаТаблицыОС,
		"ОсновноеСредство,ИнвентарныйНомер,СчетУчета,ЦМО, ЦМОПолучатель,ВидРаботы,
		|ВосстановительнаяСтоимость,ВосстановительнаяСтоимостьНУ,
		|ОстаточнаяСтоимость,ОстаточнаяСтоимостьНУ,
		|СтоимостьПоОкончанииРабот,СтоимостьПоОкончанииРаботНУ,ПредполагаемыйОбъемВыработкиПослеМодернизации,
		|СрокЭксплуатацииФакт,СрокПолезногоИспользованияПослеМодернизации,СрокПолезногоИспользованияПослеМодернизацииНУ,
		|СуммаКапитальныхВложенийВключаемыхВРасходыНУ,СчетУчетаЗатратПоАмортизационнойПремии,
		|СубконтоПоАмортизационнойПремии1,СубконтоПоАмортизационнойПремии2,СубконтоПоАмортизационнойПремии3");
	
	Форма.СрокПолезногоИспользованияПослеМодернизацииОставшийся   = ПерваяСтрокаТаблицыОС.ОставшийсяСрок;
	Форма.СрокПолезногоИспользованияПослеМодернизацииОставшийсяНУ = ПерваяСтрокаТаблицыОС.ОставшийсяСрокНУ;
//	Форма.РНПТ = ПерваяСтрокаТаблицыОС.РНПТ;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(Форма, Объект)
	
	Если Форма.РежимФормыСписокОбъектов Тогда
		// При режиме редактирования объектов ОС, НМА списком
		// эти реквизиты обновлять не нужно, т.к. они заполняются вручную в табличной части.
		Возврат;
	КонецЕсли;
	
	ПерваяСтрокаТаблицыОС = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
	ЗаполнитьЗначенияСвойств(ПерваяСтрокаТаблицыОС, Объект,
		"СуммаДемонтажа,СуммаТранспортировки,СуммаМодернизацииНУ,СуммаМодернизацииНеУчитываетсяНУ,СуммаМодернизацииЕНВД");
	
	ПерваяСтрокаТаблицыОС.СуммаМодернизации = Форма.СуммаМодернизации;
	ПерваяСтрокаТаблицыОС.СуммаРемонта      = Форма.СуммаРемонта;
	
	ЗаполнитьЗначенияСвойств(ПерваяСтрокаТаблицыОС, Форма,
		"СуммаКапитальныхВложенийВключаемыхВРасходыНУ,СчетУчетаЗатратПоАмортизационнойПремии,
		|СубконтоПоАмортизационнойПремии1,СубконтоПоАмортизационнойПремии2,СубконтоПоАмортизационнойПремии3");

	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(Форма);
КонецПроцедуры

// Подбор объектов ОС, НМА

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.Подразделение.АвтоОтметкаНезаполненного = Истина Тогда
			СтруктураРеквизитов.Вставить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("КПС");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00");	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.МодернизацияОС") Тогда
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00");
		ПараметрыПодбора.Отбор.Вставить("ГрупповойУчет", Ложь);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.МодернизацияНМА") Тогда
		ПараметрыПодбора.Отбор.Вставить("Счет", "102.00");
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.МодернизацияНПА") Тогда
		ПараметрыПодбора.Отбор.Вставить("Счет", "103.00");
	КонецЕсли;
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("КПС"			, Объект.КПС);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "Количество,Цена,Сумма");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаПодбораОСНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере	
Процедура ОбработкаПодбораОСНаСервере(Знач ВыбранноеЗначение)

	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновноеСредствоПриИзмененииНаСервере(СтрокаТаблицы.ПолучитьИдентификатор());
	КонецЦикла;
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
	
КонецПроцедуры

// Капитальные вложения

&НаКлиенте
Процедура ОбнулитьСуммы()
	
	Объект.СуммаДокумента                   = 0;
	Объект.СуммаМодернизацииНУ              = 0;
	Объект.СуммаМодернизацииНеУчитываетсяНУ = 0;
	Объект.СуммаМодернизацииЕНВД            = 0;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТаблицы.СуммаМодернизации                = 0;
		СтрокаТаблицы.СуммаМодернизацииНУ              = 0;
		СтрокаТаблицы.СуммаМодернизацииНеУчитываетсяНУ = 0;
		СтрокаТаблицы.СуммаМодернизацииЕНВД            = 0;
	КонецЦикла;
	
	СуммаМодернизации = 0;
	
	Объект.КапитальныеВложения.Очистить();
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(Форма, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("ВнеоборотныйАктив", "Объект вложений");
	РеквизитыДляПроверки.Вставить("СчетКредита", "Счет кредита");
	
	СвойстваСчетаКредита = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.СчетКредита);
	Если Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям И СвойстваСчетаКредита.УчетПоПодразделениям Тогда
		РеквизитыДляПроверки.Вставить("Подразделение", "Подразделение");
	КонецЕсли;
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыДляПроверки, Объект, Ложь, Ошибки);
	Возврат НЕ Отказ;

КонецФункции

&НаСервере
Процедура РассчитатьСуммуВложенийНаСервере(СчитатьБУ = Истина, СчитатьНУ = Истина)

	ПараметрыОстатков = Новый Структура;
	ПараметрыОстатков.Вставить("Дата",				Объект.Дата);
	ПараметрыОстатков.Вставить("Организация",		Объект.Организация);
	ПараметрыОстатков.Вставить("Подразделение",		Объект.Подразделение);
	ПараметрыОстатков.Вставить("ИФО",				Объект.ИФО);
	ПараметрыОстатков.Вставить("КФО",				Объект.КФО);
	ПараметрыОстатков.Вставить("ОбъектВложений",	Объект.ВнеоборотныйАктив);
	ПараметрыОстатков.Вставить("СчетВложений",		Объект.СчетКредита);
	ПараметрыОстатков.Вставить("ПериодОстатков",	ПериодПолученияОстатков(Объект));
	
	ОстаткиПоОбъектуВложений = УправлениеОсновнымиСредствами.ПолучитьТаблицуОстатковВложенийВНФА(ПараметрыОстатков);
	
	Если СчитатьБУ Тогда
		ОстаткиБУ = ОстаткиПоОбъектуВложений.ОстаткиБУ;
		
		ПерваяСтрока = Истина;
		Объект.КапитальныеВложения.Очистить();
		Для Каждого СтрокаОстатковБУ Из ОстаткиБУ Цикл
			
			Если ПерваяСтрока Тогда
				Если Не ЗначениеЗаполнено(Объект.СчетКредита) Тогда
					Объект.СчетКредита = СтрокаОстатковБУ.СчетВложений;
				КонецЕсли;
				ПерваяСтрока = Ложь;
			Иначе
				Если СтрокаОстатковБУ.СчетВложений <> Объект.СчетКредита Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаВложений = Объект.КапитальныеВложения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВложений, СтрокаОстатковБУ, "ЦМО, Договор, КПС, Сумма");
		
		КонецЦикла;
		
		Объект.СуммаДокумента = Объект.КапитальныеВложения.Итог("Сумма");
		УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);	
	КонецЕсли;	
	
	Если СчитатьНУ Тогда
		ОстаткиНУ = ОстаткиПоОбъектуВложений.ОстаткиНУ;
		Объект.СуммаМодернизацииНУ              = ОстаткиНУ.Итог("СуммаНУ");
		Объект.СуммаМодернизацииНеУчитываетсяНУ = ОстаткиНУ.Итог("СуммаНеУчитываетсяНУ");
		Объект.СуммаМодернизацииЕНВД            = ОстаткиНУ.Итог("СуммаЕНВД");
		
		ВедетсяУчетКапВложенийНУПоКПС = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(Объект.Дата);
		ВедетсяУчетКапВложенийНУПоЦМО = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(Объект.Дата);
		Если ВедетсяУчетКапВложенийНУПоКПС ИЛИ ВедетсяУчетКапВложенийНУПоЦМО Тогда
			
			Для Каждого СтрокаОстатковНУ Из ОстаткиНУ Цикл
				
				Отбор = Новый Структура;
				Если ВедетсяУчетКапВложенийНУПоКПС Тогда
					Отбор.Вставить("КПС", СтрокаОстатковНУ.КПС);
				КонецЕсли;
				Если ВедетсяУчетКапВложенийНУПоЦМО Тогда
					Отбор.Вставить("ЦМО", СтрокаОстатковНУ.ЦМО);
				КонецЕсли;
				
				НайденныеСтроки = Объект.КапитальныеВложения.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					СтрокаВложенийНУ = НайденныеСтроки[0];
					СтрокаВложенийНУ.СуммаНУ              = СтрокаВложенийНУ.СуммаНУ              + СтрокаОстатковНУ.СуммаНУ;
					СтрокаВложенийНУ.СуммаНеУчитываетсяНУ = СтрокаВложенийНУ.СуммаНеУчитываетсяНУ + СтрокаОстатковНУ.СуммаНеУчитываетсяНУ;
					СтрокаВложенийНУ.СуммаЕНВД            = СтрокаВложенийНУ.СуммаЕНВД            + СтрокаОстатковНУ.СуммаЕНВД;
				Иначе
					СтрокаВложенийНУ = Объект.КапитальныеВложения.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаВложенийНУ, СтрокаОстатковНУ, "ЦМО,КПС,СуммаНУ,СуммаНеУчитываетсяНУ,СуммаЕНВД");
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьСуммыМодернизацииРемонта(ЭтаФорма);
	
	Если РежимФормыСписокОбъектов Тогда
		Для каждого СтрокаОС из Объект.ОсновныеСредства Цикл
			РассчитатьСтоимостьПоОкончанииРабот(ЭтотОбъект, СтрокаОС);
		КонецЦикла;	
		РассчитатьРазницуСуммШапкиИТаблицыОС(ЭтотОбъект);
	Иначе
		ОбновитьПервуюСтрокуТаблицыОСПоДаннымРеквизитовФормы(ЭтаФорма, Объект);
		
		ПерваяСтрокаТаблицыОС = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		РассчитатьСтоимостьПоОкончанииРабот(ЭтаФорма, ПерваяСтрокаТаблицыОС);

		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
	КонецЕсли;
	
	ОпределитьНаличиеДоговораВложения();
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПериодПолученияОстатков(Объект)
	
	Возврат ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());
	
КонецФункции

// Основные средства

&НаКлиенте
Процедура ОсновноеСредствоПриИзмененииНаКлиенте()
	Если НЕ РежимФормыСписокОбъектов Тогда
		// Установим новое ОсновноеСредство в первой строке табличной части.
		ТекущаяСтрока = НайтиДобавитьПервуюСтрокуТаблицыОсновныеСредства(Объект);
		ТекущаяСтрока.ОсновноеСредство = ОсновноеСредство;
		
		// Обработаем изменение основного средства в строке табличной части.
		ОсновноеСредствоПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
		
		// Обновим реквизиты на форме из строки табличной части.
		ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтотОбъект, Объект);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаОС = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ЗначениеЗаполнено(СтрокаОС.ИнвентарныйНомер) 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОС.ИнвентарныйНомер, "ОС") <> СтрокаОС.ОсновноеСредство Тогда
		СтрокаОС.ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	КонецЕсли;		
	
	// Установим инвентарный номер и ЦМО в строку таб. части.
	ДанныеМестонахожденияОС = ДанныеМестонахожденияОС(СтрокаОС.ОсновноеСредство, СтрокаОС.ИнвентарныйНомер);
	ЗаполнитьЗначенияСвойств(СтрокаОС, ДанныеМестонахожденияОС);
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(СтрокаОС.ОсновноеСредство, Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(СтрокаОС.СчетУчета) 
		ИЛИ (ЗначениеЗаполнено(ДанныеОбъектаОС.СчетУчета) И СтрокаОС.СчетУчета <> ДанныеОбъектаОС.СчетУчета) Тогда
		СтрокаОС.СчетУчета = ДанныеОбъектаОС.СчетУчета;
	КонецЕсли;	
	Если Не РежимФормыСписокОбъектов Тогда
		Объект.КФО = ДанныеОбъектаОС.КФО;
		Объект.КПС = ДанныеОбъектаОС.КПС;
	КонецЕсли;
	
	ДатаСреза = ПериодПолученияОстатков(Объект);
	
	Если ЗаполненыРеквизитыДляРасчетаСрокаИспользования(СтрокаОС.ОсновноеСредство, СтрокаОС.ИнвентарныйНомер) Тогда
		СтрокаОС.СрокЭксплуатацииФакт = УправлениеОсновнымиСредствами.ФактическийСрокЭксплуатации(
			СтрокаОС.ОсновноеСредство, 
			СтрокаОС.ИнвентарныйНомер, 
			Объект.Организация, 
			Объект.Дата, 
			ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюПервымЧислом);
	Иначе
		СтрокаОС.СрокЭксплуатацииФакт = 0;
	КонецЕсли;
	
	СведенияОбОС = УправлениеОсновнымиСредствами.ПолучитьСведенияОбОС(ДатаСреза, СтрокаОС.ОсновноеСредство,
		"СрокПолезногоИспользования,СрокПолезногоИспользованияНУ");
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС
		ИЛИ НЕ ЗначениеЗаполнено(СтрокаОС.СрокПолезногоИспользованияПослеМодернизации) Тогда
			
		// Если это ремонт, то СПИ после модернизации устанавливаем из учетных данных, т.к. при ремонте
		// он не меняется. Если это не ремонт, то СПИ после модернизации меняем, только если он пустой, т.к.
		// в этом случае, он задается пользователем 	
		СтрокаОС.СрокПолезногоИспользованияПослеМодернизации = СведенияОбОС.СрокПолезногоИспользования;
	КонецЕсли;	
	СтрокаОС.ОставшийсяСрок = РассчитатьОставшийсяСрокПолезногоИспользования(
		СтрокаОС.СрокПолезногоИспользованияПослеМодернизации, СтрокаОС.СрокЭксплуатацииФакт);
	
	Если ОтражатьВНалоговомУчете Тогда
		СтрокаОС.СрокПолезногоИспользованияПослеМодернизацииНУ = СведенияОбОС.СрокПолезногоИспользованияНУ;
		СтрокаОС.ОставшийсяСрокНУ = РассчитатьОставшийсяСрокПолезногоИспользования(
			СтрокаОС.СрокПолезногоИспользованияПослеМодернизацииНУ, СтрокаОС.СрокЭксплуатацииФакт);
	Иначе
		СтрокаОС.СрокПолезногоИспользованияПослеМодернизацииНУ = 0;
		СтрокаОС.ОставшийсяСрокНУ = 0;
	КонецЕсли;
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСтоимостиОС(ЭтаФорма, СтрокаОС) Тогда
		РассчитатьСтоимостьОСНаСервере(СтрокаОС.ПолучитьИдентификатор());
		РассчитатьСтоимостьПоОкончанииРабот(ЭтаФорма, СтрокаОС);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДанныеМестонахожденияОС(ОС, ИнвНомер)

	ДанныеМестонахожденияОС = Новый Структура("ИнвентарныйНомер, ЦМО",
		Справочники.ИнвентарныеНомераОС.ПустаяСсылка(),
		Справочники.ЦМО.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И (ИнвентарныйНомер = &ИнвентарныйНомер
	|					ИЛИ &ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))) КАК СтоимостьОбъектовОСОстатки";
	Запрос.УстановитьПараметр("Период", 			ПериодПолученияОстатков(Объект));
	Запрос.УстановитьПараметр("Организация",		Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство",	ОС);
	Запрос.УстановитьПараметр("ИнвентарныйНомер",	ИнвНомер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеМестонахожденияОС, Выборка);
	КонецЕсли;
	
	Возврат ДанныеМестонахожденияОС;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСтоимостиОС(Форма, СтрокаТаблицыОС = Неопределено, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыШапки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыШапки.Вставить("КФО", "КФО");
	РеквизитыШапки.Вставить("КПС", "КПС");
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыШапки, Объект, Ложь, Ошибки);
	
	ОписаниеТабЧастиОС = Новый Структура("Имя,Синоним",
		"ОсновныеСредства", "Основные средства");
	РеквизитыТабЧастиОС = Новый Структура;
	РеквизитыТабЧастиОС.Вставить("ОсновноеСредство", "Основное средство");
	РеквизитыТабЧастиОС.Вставить("СчетУчета",        "Счет учета");
	Если СтрокаТаблицыОС = Неопределено Тогда // проверить во всех строках табличной части
		Отказ = Отказ ИЛИ ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитовТабличнойЧасти(
			РеквизитыТабЧастиОС, ОписаниеТабЧастиОС, Объект.ОсновныеСредства, Ложь, Ошибки);
	Иначе // проверить в указанной строке табличной части
		Отказ = Отказ ИЛИ ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитовТабличнойЧасти(
			РеквизитыТабЧастиОС, ОписаниеТабЧастиОС, СтрокаТаблицыОС, Ложь, Ошибки);
	КонецЕсли;
	
	Возврат НЕ Отказ;

КонецФункции

&НаСервере
Функция РассчитатьСтоимостьОСНаСервере(ИдентификаторСтрокиОС = Неопределено)
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков();
	ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыПолученияОстатков.Период = КонецДня(Объект.Дата);
	Иначе
		ПараметрыПолученияОстатков.Ссылка = Объект.Ссылка;
		ПараметрыПолученияОстатков.Период = Объект.Дата;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "Организация,ИФО,КФО,КПС,Подразделение");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		Если ИдентификаторСтрокиОС <> Неопределено И ИдентификаторСтрокиОС <> СтрокаТаблицы.ПолучитьИдентификатор() Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков,СтрокаТаблицы,"ОсновноеСредство,ИнвентарныйНомер,ЦМО");
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков);
		НайденнаяСтрока = ?(ТаблицаОстатков.Количество()=1, ТаблицаОстатков[0],
			ТаблицаОстатков.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство"));
		
		ВосстановительнаяСтоимость	= ?(НайденнаяСтрока<>Неопределено, НайденнаяСтрока.СтоимостьЕдиницы, 0);
		СуммаАмортизации			= ?(НайденнаяСтрока<>Неопределено, НайденнаяСтрока.Амортизация, 0);
		СуммаОбесценения			= УправлениеОсновнымиСредствами.СуммаОбесцененияОС(СтрокаТаблицы.ОсновноеСредство, КонецДня(Объект.Дата));
		
		СтрокаТаблицы.ВосстановительнаяСтоимость = ВосстановительнаяСтоимость;
		СтрокаТаблицы.ОстаточнаяСтоимость        = ВосстановительнаяСтоимость - СуммаАмортизации - СуммаОбесценения;
		
	КонецЦикла;
	
	Если ОтражатьВНалоговомУчете Тогда
		
		Если ИдентификаторСтрокиОС <> Неопределено Тогда
			СтрокаОС = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиОС);
			СписокОС = Новый Массив;
			СписокОС.Добавить(СтрокаОС.ОсновноеСредство);
		Иначе
			СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
		КонецЕсли;
		
		ТаблицаОС = НалоговыйУчет.ОпределитьСтоимостьСпискаОС(СписокОС, Объект, Ложь, ПериодПолученияОстатков(Объект));
		
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			
			Если ИдентификаторСтрокиОС <> Неопределено И ИдентификаторСтрокиОС <> СтрокаТаблицы.ПолучитьИдентификатор() Тогда
				Продолжить;
			КонецЕсли;
			
			НайденнаяСтрока = ?(ТаблицаОС.Количество()=1, ТаблицаОС[0],
				ТаблицаОС.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство"));
			
			ВосстановительнаяСтоимостьНУ = ?(НайденнаяСтрока<>Неопределено, НайденнаяСтрока.ВосстановительнаяСтоимость, 0);
			СуммаАмортизацииНУ           = ?(НайденнаяСтрока<>Неопределено, НайденнаяСтрока.СуммаНачисленнойАмортизации, 0);
			
			СтрокаТаблицы.ВосстановительнаяСтоимостьНУ = ВосстановительнаяСтоимостьНУ;
			СтрокаТаблицы.ОстаточнаяСтоимостьНУ = ВосстановительнаяСтоимостьНУ - СуммаАмортизацииНУ;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			
			Если ИдентификаторСтрокиОС <> Неопределено И ИдентификаторСтрокиОС <> СтрокаТаблицы.ПолучитьИдентификатор() Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы.ВосстановительнаяСтоимостьНУ = 0;
			СтрокаТаблицы.ОстаточнаяСтоимостьНУ = 0;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьРеквизитыФормыПоДаннымПервойСтрокиТаблицыОС(ЭтаФорма, Объект);
	
	Модифицированность = Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыМодернизацииРемонта(Форма)
	
	Объект = Форма.Объект;
	
	Форма.СуммаМодернизации = 0;
	Форма.СуммаРемонта = 0;
	
	Если Объект.СуммаДокумента > 0 Тогда
		СуммаРемонтаМодернизации = Объект.СуммаДокумента - Объект.СуммаДемонтажа - Объект.СуммаТранспортировки;
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
			Форма.СуммаРемонта = СуммаРемонтаМодернизации;
		Иначе	
			Форма.СуммаМодернизации = СуммаРемонтаМодернизации;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьСуммыВложенийПоСтрокамТаблицыОС()
	
	// Для распределения сумм из шапки по строкам сделаем копию таблицы объектов ОС, НМА.
	КопияТаблицыОС = Объект.ОсновныеСредства.Выгрузить();
	
	// Добавим колонку БазаРаспределения и заполним ее единицами,
	// т.к. суммы из шапки будем распределять равномерно по всем строкам таблицы ОС.
	КопияТаблицыОС.Колонки.Добавить("БазаРаспределения", Новый ОписаниеТипов("Число"));
	КопияТаблицыОС.ЗаполнитьЗначения(1, "БазаРаспределения");
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Объект.СуммаДемонтажа,
		КопияТаблицыОС, "СуммаДемонтажа", "БазаРаспределения");
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Объект.СуммаТранспортировки,
		КопияТаблицыОС, "СуммаТранспортировки", "БазаРаспределения");
	
	СуммаМодернизацииБУ = Объект.СуммаДокумента - Объект.СуммаДемонтажа - Объект.СуммаТранспортировки;
	Если Объект.ВидОперации = Перечисления.ВидыОперацийРеконструкцияОС.КапРемонтОС Тогда
		
		// Заполняем сумму ремонта.
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаМодернизацииБУ,
			КопияТаблицыОС, "СуммаРемонта", "БазаРаспределения");
		
		// Очищаем суммы модернизации.
		КопияТаблицыОС.ЗаполнитьЗначения(0, "СуммаМодернизации,
			|СуммаМодернизацииНУ,СуммаМодернизацииНеУчитываетсяНУ,СуммаМодернизацииЕНВД");
		
	Иначе
		
		// Заполняем суммы модернизации.
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаМодернизацииБУ,
			КопияТаблицыОС, "СуммаМодернизации", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Объект.СуммаМодернизацииНУ,
			КопияТаблицыОС, "СуммаМодернизацииНУ", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Объект.СуммаМодернизацииНеУчитываетсяНУ,
			КопияТаблицыОС, "СуммаМодернизацииНеУчитываетсяНУ", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Объект.СуммаМодернизацииЕНВД,
			КопияТаблицыОС, "СуммаМодернизацииЕНВД", "БазаРаспределения");
		
		// Очищаем сумму ремонта.
		КопияТаблицыОС.ЗаполнитьЗначения(0, "СуммаРемонта");
		
	КонецЕсли;
	
	// Загружаем таблицу ОС с распределенными суммами.
	Объект.ОсновныеСредства.Загрузить(КопияТаблицыОС);
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуСуммШапкиИТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	РазницаИтогаТЧРемонтРеконструкция = ?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС"),
		Объект.ОсновныеСредства.Итог("СуммаРемонта") - Форма.СуммаРемонта,
		Объект.ОсновныеСредства.Итог("СуммаМодернизации") - Форма.СуммаМодернизации);
	
	Форма.РазницаИтогаТЧДемонтаж = Объект.ОсновныеСредства.Итог("СуммаДемонтажа") - Объект.СуммаДемонтажа;
	
	Форма.РазницаИтогаТЧТранспортировка = Объект.ОсновныеСредства.Итог("СуммаТранспортировки") - Объект.СуммаТранспортировки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтоимостьПоОкончанииРабот(Форма, СтрокаОС)
	
	Если СтрокаОС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
		СтрокаОС.СтоимостьПоОкончанииРабот = СтрокаОС.ВосстановительнаяСтоимость; // При кап.ремонте стоимость ОС не меняется.
	Иначе
		СтрокаОС.СтоимостьПоОкончанииРабот = СтрокаОС.ВосстановительнаяСтоимость
		 + СтрокаОС.СуммаДемонтажа + СтрокаОС.СуммаТранспортировки + СтрокаОС.СуммаМодернизации;
	КонецЕсли;
	
	Если Форма.ОтражатьВНалоговомУчете Тогда
		СтрокаОС.СтоимостьПоОкончанииРаботНУ = СтрокаОС.ВосстановительнаяСтоимостьНУ + СтрокаОС.СуммаМодернизацииНУ;
	Иначе
		СтрокаОС.СтоимостьПоОкончанииРаботНУ = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыРеквизитыДляРасчетаСрокаИспользования(ОсновноеСредство, ИнвНомер)

	Возврат ЗначениеЗаполнено(ОсновноеСредство) И ЗначениеЗаполнено(ИнвНомер);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьОставшийсяСрокПолезногоИспользования(СрокПолезногоИспользованияПослеМодернизации, СрокЭксплуатацииФакт)
	
	ОставшийсяСрокПолезногоИспользования = СрокПолезногоИспользованияПослеМодернизации - СрокЭксплуатацииФакт;
	Возврат ?(ОставшийсяСрокПолезногоИспользования < 0, 0, ОставшийсяСрокПолезногоИспользования);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьОставшиесяСрокиИспользования(Форма)
	
	Объект = Форма.Объект;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ТекущаяСтрока.ОставшийсяСрок = РассчитатьОставшийсяСрокПолезногоИспользования(
			ТекущаяСтрока.СрокПолезногоИспользованияПослеМодернизации, ТекущаяСтрока.СрокЭксплуатацииФакт);
		ТекущаяСтрока.ОставшийсяСрокНУ = РассчитатьОставшийсяСрокПолезногоИспользования(
			ТекущаяСтрока.СрокПолезногоИспользованияПослеМодернизацииНУ, ТекущаяСтрока.СрокЭксплуатацииФакт);
	КонецЦикла;
	
	Если НЕ Форма.РежимФормыСписокОбъектов Тогда
		Форма.СрокПолезногоИспользованияПослеМодернизацииОставшийся   = ТекущаяСтрока.ОставшийсяСрок;
		Форма.СрокПолезногоИспользованияПослеМодернизацииОставшийсяНУ = ТекущаяСтрока.ОставшийсяСрокНУ;
	КонецЕсли;
	
КонецПроцедуры

// Прослеживаемость

&НаСервере
Процедура ЗаполнитьПредставлениеРНПТВоВсехСтроках()
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.ОсновныеСредства Цикл
		ЗаполнитьПредставлениеРНПТ(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеРНПТ(СтрокаТабличнойЧасти) Экспорт
	
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТабличнойЧасти.ИдентификаторСтроки));
	СтрокаТабличнойЧасти.РНПТ = ПрослеживаемостьФормыБГУКлиентСервер.ТекстПредставлениярРНПТ(СтрокиСРНПТ);

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	ПрослеживаемостьБГУ.УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	Если РежимФормыСписокОбъектов = 0 Тогда
		СтрокаТабличнойЧасти = ОБъект.ОсновныеСредства[0];
	Иначе
		СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	КонецЕсли;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	//ОбработкаВыбораРНПТННаСервере(ВыбранноеЗначение);
	//Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ЗаполнитьПредставлениеРНПТ(СтрокаТабличнойЧасти);
	Если РежимФормыСписокОбъектов = 0 Тогда
		УстановитьТекстПредставленияРНПТ();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьРНПТВХранилищеНаСервере(Знач Адрес = Неопределено, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если Адрес = Неопределено Тогда
		Адрес = УникальныйИдентификатор;
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецФункции

Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдаленииРНПТ(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиРНПТ(Объект.ОсновныеСредства[0].ИдентификаторСтроки);
		РНПТ = ТекстПредставленияРНПТНеВведены();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьТекстПредставленияРНПТ()
	Если Объект.СведенияПрослеживаемости.Количество() = 0 Тогда
		РНПТ = ТекстПредставленияРНПТНеВведены();
	Иначе
		РНПТ = ПрослеживаемостьФормыБГУКлиентСервер.ТекстПредставлениярРНПТ(Объект.СведенияПрослеживаемости);
	КонецЕсли
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПредставленияРНПТНеВведены()
	Возврат НСтр("ru = 'Не введены'");
КонецФункции

#Область НалоговыйУчет

// Амортизационная премия

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Форма)

	Если Форма.СуммаКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Форма.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Счет)
	
	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоПоАмортизационнойПремии1", "СубконтоПоАмортизационнойПремии1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоПоАмортизационнойПремии2", "СубконтоПоАмортизационнойПремии2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоПоАмортизационнойПремии3", "СубконтоПоАмортизационнойПремии3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Счет, Форма, Форма.Объект, МассивПолей);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)

	ЭлементыАмортизационнойПремии = Новый Массив;
	ЭлементыАмортизационнойПремии.Добавить("СуммаКапитальныхВложенийВключаемыхВРасходыНУ");
	ЭлементыАмортизационнойПремии.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
	ЭлементыАмортизационнойПремии.Добавить("СубконтоПоАмортизационнойПремии1");
	ЭлементыАмортизационнойПремии.Добавить("СубконтоПоАмортизационнойПремии2");
	ЭлементыАмортизационнойПремии.Добавить("СубконтоПоАмортизационнойПремии3");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыАмортизационнойПремии, "Видимость", Форма.ВключитьКапитальныеВложенияВРасходыНУ);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьПараметрыАмортизационнойПремии(Форма, Объект)

	Объект.СуммаКапитальныхВложенийВключаемыхВРасходыНУ = 0;
	Объект.СчетУчетаЗатратПоАмортизационнойПремии = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	Объект.СубконтоПоАмортизационнойПремии1 = Неопределено;
	Объект.СубконтоПоАмортизационнойПремии2 = Неопределено;
	Объект.СубконтоПоАмортизационнойПремии3 = Неопределено;
	
	//Если Форма.РежимФормыСписокОбъектов Тогда
	//	ЗаполнитьДобавленныеКолонкиОтражениеВУчете(Форма);
	//КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКФО",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет",  Ложь); // Выбирается только счет НУ, не нужно показывать отдельно еще один.
	
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетУчетаЗатратПоАмортизационнойПремии);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоПоАмортизационнойПремии1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоПоАмортизационнойПремии2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоПоАмортизационнойПремии3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения амортизационной премии в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет учета затрат'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов",
		НалоговыйУчетКлиентСервер.ВозможныеСчетаУчетаЗатратПоАмортизационнойПремии());
	
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете); 
	
	ТекущиеДанные.СчетУчетаЗатратПоАмортизационнойПремии = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоПоАмортизационнойПремии1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоПоАмортизационнойПремии2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоПоАмортизационнойПремии3 = СтруктураОтражениеВУчете.Субконто3;
		
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетУчетаЗатратПоАмортизационнойПремии", "СубконтоПоАмортизационнойПремии1", "СубконтоПоАмортизационнойПремии2", "СубконтоПоАмортизационнойПремии3");
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, Неопределено, ПоляФормы);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтражениеВУчете(Форма)
	
	Объект = Форма.Объект;
	
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетУчетаЗатратПоАмортизационнойПремии", "СубконтоПоАмортизационнойПремии1", "СубконтоПоАмортизационнойПремии2", "СубконтоПоАмортизационнойПремии3");
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, Неопределено, ПоляФормы);
	КонецЦикла;
	
КонецПроцедуры

