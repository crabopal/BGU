&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата);
	ДатаПереходаНаУСН = УчетнаяПолитика.ДатаПереходаНаУСН;
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	Для Каждого СтрокаТаблицы Из Объект.УменьшениеНалога Цикл
		
		// ПериодНачисления.
		НачалоПериода = ВыборПериодаКлиентСервер.НачалоПериодаОтчета(Перечисления.ДоступныеПериодыОтчета.Месяц, СтрокаТаблицы.ПериодНачисления);
		КонецПериода  = ВыборПериодаКлиентСервер.КонецПериодаОтчета(Перечисления.ДоступныеПериодыОтчета.Месяц, СтрокаТаблицы.ПериодНачисления);
		СтрокаТаблицы.ПериодСтрокой = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
			Перечисления.ДоступныеПериодыОтчета.Месяц, НачалоПериода, КонецПериода);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаУменьшениеНалога", "Видимость",
		Объект.Дата >= Отчеты.КнигаУчетаДоходовИРасходов.ДатаНачалаФормирования4РазделаКУДиР()
		И Объект.Дата < Отчеты.КнигаУчетаДоходовИРасходов.ДатаОтменыФормирования4РазделаКУДиР());
	
КонецПроцедуры

