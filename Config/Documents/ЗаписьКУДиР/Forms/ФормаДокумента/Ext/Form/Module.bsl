
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	УчетУСН.УстановитьУсловноеОформлениеПолейТаблицыРасходовНаОСиНМА(УсловноеОформление);
	
	// Активизировать первую непустую табличную часть
	СписокТабличныхЧастей = Новый СписокЗначений;
	СписокТабличныхЧастей.Добавить("Строки", "Строки");
	СписокТабличныхЧастей.Добавить("ОСиНМА", "ОСиНМА");
	СписокТабличныхЧастей.Добавить("УменьшениеНалога", "УменьшениеНалога");
	
	АктивизироватьТабличнуюЧасть = ОбщегоНазначенияБГУ.ПолучитьПервуюНепустуюВидимуюТабличнуюЧасть(
		ЭтаФорма, СписокТабличныхЧастей);
	ОбщегоНазначенияБГУКлиентСервер.АктивизироватьЭлементФормы(ЭтаФорма, АктивизироватьТабличнуюЧасть);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);                                                             
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОСиНМА

&НаКлиенте
Процедура ОСиНМАПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
		УстановитьЗначенияГрафРаздела2ПоУмолчанию(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАРасходыПроизведеныДоПереходаНаУСНПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	УстановитьЗначенияГрафРаздела2ПоУмолчанию(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАСрокПолезногоИспользованияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	
	ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод = УчетУСНКлиентСервер.ДоляСтоимостиОСиНМАЗаНалоговыйПериод(
		ТекущиеДанные.РасходыПроизведеныДоПереходаНаУСН,
		Объект.Дата, ДатаПереходаНаУСН, ТекущиеДанные.СрокПолезногоИспользования);
	РассчитатьДолюСтоимостиЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные);
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАОстаточнаяСтоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные);
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАКоличествоКварталовЭксплуатацииОбъектаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	Если ТекущиеДанные.КоличествоКварталовВНалоговомПериоде > 4 Тогда
		ТекущиеДанные.КоличествоКварталовВНалоговомПериоде = 4;
	КонецЕсли;
	
	РассчитатьДолюСтоимостиЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАДоляСтоимостиЗаНалоговыйПериодПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	Если ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод > 100 Тогда
		ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод = 100;
	КонецЕсли;
	
	РассчитатьДолюСтоимостиЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАДоляСтоимостиЗаКварталПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	Если ТекущиеДанные.ДоляСтоимостиЗаКвартал > 100 Тогда
		ТекущиеДанные.ДоляСтоимостиЗаКвартал = 100;
	КонецЕсли;
	
	РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАСуммаРасходовЗаНалоговыйПериодПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОСиНМАРасходыПрошлыхПериодовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОСиНМА.ТекущиеДанные;
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияГрафРаздела2ПоУмолчанию(ТекущиеДанные)
	
	Если ТекущиеДанные.РасходыПроизведеныДоПереходаНаУСН Тогда
		
		// Графа 6 ""Первоначальная стоимость"" не заполняется по ОС и НМА,
		// приобретенным (изготовленным, сооруженным, созданным) до перехода на УСН
		// (см. Порядок заполнения раздела II КУДиР).
		ТекущиеДанные.ПервоначальнаяСтоимость = 0;
		
		ТекущиеДанные.КоличествоКварталовВНалоговомПериоде = 4;
		ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод = 0;
		ТекущиеДанные.ДоляСтоимостиЗаКвартал = 0;
		
	Иначе
		
		// Графы 7,8,14,15 раздела II КУДиР не заполняются по ОС и НМА,
		// приобретенным (изготовленным, сооруженным, созданным) в период применения УСН
		// (см. Порядок заполнения раздела II КУДиР).
		ТекущиеДанные.ОстаточнаяСтоимость = 0;
		ТекущиеДанные.СрокПолезногоИспользования = 0;
		ТекущиеДанные.РасходыПрошлыхПериодов = 0;
		ТекущиеДанные.ОставшаясяЧастьРасходов = 0;
		
		ТекущиеДанные.КоличествоКварталовВНалоговомПериоде = 0;
		ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод = 100;
		ТекущиеДанные.ДоляСтоимостиЗаКвартал = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДолюСтоимостиЗаКвартал(ТекущиеДанные)
	
	ТекущиеДанные.ДоляСтоимостиЗаКвартал = ?(ТекущиеДанные.КоличествоКварталовВНалоговомПериоде = 0, 0,
		ТекущиеДанные.ДоляСтоимостиЗаНалоговыйПериод / ТекущиеДанные.КоличествоКварталовВНалоговомПериоде);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуРасходовЗаНалоговыйПериод(ТекущиеДанные)
	
	Если ТекущиеДанные.РасходыПроизведеныДоПереходаНаУСН Тогда
		ТекущиеДанные.СуммаРасходовЗаНалоговыйПериод =
			ТекущиеДанные.СуммаРасходовЗаКвартал * ТекущиеДанные.КоличествоКварталовВНалоговомПериоде;
	Иначе
		ТекущиеДанные.СуммаРасходовЗаНалоговыйПериод =
			ТекущиеДанные.ПервоначальнаяСтоимость; // Все расходы будут признаны в текущем году.
	КонецЕсли;
	
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуРасходовЗаКвартал(ТекущиеДанные)
	
	Если ТекущиеДанные.РасходыПроизведеныДоПереходаНаУСН Тогда
		ТекущиеДанные.СуммаРасходовЗаКвартал =
			ТекущиеДанные.ОстаточнаяСтоимость * ТекущиеДанные.ДоляСтоимостиЗаКвартал / 100;
	Иначе
		ТекущиеДанные.СуммаРасходовЗаКвартал = ?(ТекущиеДанные.КоличествоКварталовВНалоговомПериоде = 0, 0,
			ТекущиеДанные.ПервоначальнаяСтоимость / ТекущиеДанные.КоличествоКварталовВНалоговомПериоде);
	КонецЕсли;
	
	РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОставшуюсяЧастьРасходов(ТекущиеДанные)
	
	Если ТекущиеДанные.РасходыПроизведеныДоПереходаНаУСН Тогда
		ТекущиеДанные.ОставшаясяЧастьРасходов =
			  ТекущиеДанные.ОстаточнаяСтоимость
			- ТекущиеДанные.СуммаРасходовЗаНалоговыйПериод
			- ТекущиеДанные.РасходыПрошлыхПериодов;
	Иначе
		ТекущиеДанные.ОставшаясяЧастьРасходов = 0; // Не заполняется.
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_УменьшениеНалога

&НаКлиенте
Процедура УменьшениеНалогаПериодСтрокойНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.УменьшениеНалога.ТекущиеДанные;
	
	ВидПериода = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц");
	ОписаниеОповещения = Новый ОписаниеОповещения("УменьшениеНалогаПериодСтрокойНачалоВыбораЗавершение", ЭтотОбъект);
	ВыборПериодаКлиент.ПериодНачалоВыбора(ЭтаФорма, Элемент, СтандартнаяОбработка,
		ВидПериода, ТекущиеДанные.ПериодНачисления, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшениеНалогаПериодСтрокойНачалоВыбораЗавершение(СтруктураПериода, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.УменьшениеНалога.ТекущиеДанные;
	
	// Установим полученный период.
	Если СтруктураПериода <> Неопределено Тогда
		ТекущиеДанные.ПериодСтрокой = СтруктураПериода.Период;
		ТекущиеДанные.ПериодНачисления = СтруктураПериода.НачалоПериода;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшениеНалогаПериодСтрокойОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.УменьшениеНалога.ТекущиеДанные;
	
	ВидПериода = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц");
	КонецПериода = "";
	ВыборПериодаКлиент.ПериодОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка,
		ВидПериода, ТекущиеДанные.ПериодСтрокой, ТекущиеДанные.ПериодНачисления, КонецПериода);
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшениеНалогаПериодСтрокойПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УменьшениеНалога.ТекущиеДанные;
	
	КонецПериода = "";	
	ВыборПериодаКлиент.ПериодПриИзменении(Элемент,
		ТекущиеДанные.ПериодСтрокой, ТекущиеДанные.ПериодНачисления, КонецПериода);
	
КонецПроцедуры

