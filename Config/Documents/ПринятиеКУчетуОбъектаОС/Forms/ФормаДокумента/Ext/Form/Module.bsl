&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект)
	Перем МассивПолей;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КПС", "КПСЗатрат", "ЗаголовокКПСЗатрат", Ложь, "КПСЗатрат", Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КЭК", "КЭКЗатрат", "", Ложь, "КЭКЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ЗаголовокПодразделениеЗатрат", Ложь, "ПодразделениеЗатрат", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьНеиспользуемыеРеквизитыПередЗаписью(Объект)

	Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		Объект.ЦМООтправитель = Справочники.ЦМО.ПустаяСсылка();
		Объект.ПодразделениеОтправитель = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
	Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		Объект.ВнеоборотныйАктив = Справочники.ОсновныеСредства.ПустаяСсылка();
		Объект.СчетКредита = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

	#Область НалоговыйУчет

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Знач Объект)

	Если Объект.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(Форма)

	Если НЕ Форма.ОтражатьВНалоговомУчете Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
			И Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда

		Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы");
		Форма.ЗаблокироватьДанныеФормыДляРедактирования();
		Форма.Модифицированность = Истина;

		ШаблонСообщения = НСтр("ru = 'В поле ""Порядок включения стоимости в состав расходов:"" на закладке ""Налоговый учет"" установлено значение ""%1""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);

		УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПорядокВключенияСтоимостиВСоставРасходовНУ(Элемент)

	Если Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации")
	   И НЕ ЗначениеЗаполнено(Объект.СрокПолезногоИспользованияНУ) Тогда
		Объект.СрокПолезногоИспользованияНУ = Объект.СрокПолезногоИспользования;
	КонецЕсли;
	Объект.НачислятьАмортизациюНУ   = Истина;
	Объект.СпециальныйКоэффициентНУ = 1;
	
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Объект)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеПоАмортизационнойПремии", "ЗаголовокПодразделение", Истина, "ПодразделениеПоАмортизационнойПремии", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоПоАмортизационнойПремии1", "ЗаголовокСубконто1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоПоАмортизационнойПремии2", "ЗаголовокСубконто2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоПоАмортизационнойПремии3", "ЗаголовокСубконто3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатратПоАмортизационнойПремии, Форма, Объект, МассивПолей);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма, Объект)

	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете
		И Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления)
		И Объект.ВидПоступления <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21");
		
	Форма.Элементы.ГруппаНалоговыйУчет.Видимость                = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.Видимость = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.ПервоначальнаяСтоимостьНУ.Доступность        = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РасходыНеУчитываетсяНУ.Доступность           = ВидимостьЭлементовНалоговогоУчета;
	Форма.Элементы.РасходыЕНВД.Доступность                      = ВидимостьЭлементовНалоговогоУчета;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)

	Форма.Элементы.ГруппаСтраницыПараметрыАмортизационнойПремии.ТекущаяСтраница =
		?(Форма.ВключитьАмортизационнуюПремиюВСоставРасходов,
			Форма.Элементы.ГруппаПараметрыАмортизационнойПремии,
			Форма.Элементы.ГруппаАмортизационнаяПремияНеИспользуется);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма)

	СтарыйТекущийЭлемент = Форма.ТекущийЭлемент;
	ПорядокПогашенияСтоимости = Форма.Объект.ПорядокПогашенияСтоимости;
	Форма.Элементы.ГруппаСтраницыПорядокВключенияСтоимостиВСоставРасходовНУ.ТекущаяСтраница =
		?(ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается"),
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУТолькоПросмотр,
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ);
	Форма.ТекущийЭлемент = СтарыйТекущийЭлемент;

	ПорядокВключенияСтоимостиВСоставРасходовНУ = Форма.Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУНачислениеАмортизации;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУВключениеВРасходыПриПринятииКУчету;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУСтоимостьНеВключаетсяВРасходы;
	Иначе
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУПорядокВключенияСтоимостиВСоставРасходовНеУказан;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихРасходов(Форма)

	Объект = Форма.Объект;
	
	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете
		И Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
	
	ВыбранСчетПрочихРасходов = (БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("401.20").Найти(Объект.СчетУчетаЗатрат) <> Неопределено);
	
	Если ВидимостьЭлементовНалоговогоУчета И ВыбранСчетПрочихРасходов
	   И Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходов;
	Иначе
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходовНеТребуется;
	КонецЕсли;

КонецПроцедуры

