
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСписокВыбораВидаОперацииДокумента(
		Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС"), Элементы.ВидПоступления);
	
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитаФормыПоПлануСчетов(Объект.СчетУчета);
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитаФормыПоПлануСчетов(Объект.СчетКредита);
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитаФормыПоПлануСчетов(Объект.СчетУчетаЗатрат);
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	ЗаголовокПодразделениеЗатрат = НСТр("ru = 'Подразделение:'");
	ЗаголовокСчетаЗатрат = НСТр("ru = 'Счет учета затрат:'");
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ПостоянноДействующиеКомиссии.Форма.ФормаВыбора" Тогда
		УправлениеОсновнымиСредствамиКлиент.УстановитьКомиссиюВДокументОС(ВыбранноеЗначение, Объект, ЭтаФорма);
	ИначеЕсли Лев(ИсточникВыбора.ИмяФормы, 22) = "Справочник.Сотрудники." Тогда 
		УправлениеОсновнымиСредствамиКлиент.ОбработатьВыборПредседателяКомиссии(ЭтаФорма,
																				ВыбранноеЗначение, 
																				Ложь, 
																				Объект.ДолжностьПредседателяКомиссии,
																				Объект.ФамилияПредседателяКомиссии,
																				Объект.ИмяПредседателяКомиссии,
																				Объект.ОтчествоПредседателяКомиссии);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбработатьДанныеОС = Ложь;
	
	Если ИмяСобытия = "ЗаполнениеДанныхОС" И ТипЗнч(Параметр) = Тип("Структура") Тогда
		
		ОсновноеСредство = Неопределено;
		Параметр.Свойство("Ссылка", ОсновноеСредство);
		Если ОсновноеСредство = Объект.ОсновноеСредство Тогда
			ОбработатьДанныеОС = Истина;
			ЗначенияРеквизитов = Новый Структура("ВидНФА,АмортизационнаяГруппа");
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Параметр); 		
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_ОсновныеСредства" И Источник = Объект.ОсновноеСредство Тогда
		
		ОбработатьДанныеОС = Истина;
		ЗначенияРеквизитов = ЗначенияРеквизитовОС(Объект.ОсновноеСредство);
		
	КонецЕсли;
	
	Если ОбработатьДанныеОС Тогда
		
		ОС_Модифицированность = Ложь;
		
		Если ЗначенияРеквизитов.ВидНФА <> ОС_ВидНФА Тогда
			ОС_ВидНФА = ЗначенияРеквизитов.ВидНФА;
			ОС_Модифицированность = Истина;
		КонецЕсли;
		Если ЗначенияРеквизитов.АмортизационнаяГруппа <> ОС_АмортизационнаяГруппа Тогда
			ОС_АмортизационнаяГруппа = ЗначенияРеквизитов.АмортизационнаяГруппа;
			ОС_Модифицированность = Истина;
		КонецЕсли;
		Если ОС_Модифицированность Тогда
			ОсновноеСредствоПриИзмененииНаСервере(Ложь);
			ОсновноеСредствоПриИзмененииНаКлиенте();
			УстановитьСрокПолезногоИспользованияВГодах(ЭтаФорма, Объект);
			УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма, Объект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ПодготовитьФормуНаСервере();
	
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОчиститьНеиспользуемыеРеквизитыПередЗаписью(ТекущийОбъект);
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	Если ТекущийОбъект.ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		Если Объект.ОсновноеСредство.ГрупповойУчет Тогда
			ТекстСообщения = НСтр("ru='Порядок включения стоимости в состав расходов ""Начисление амортизации"" не может применяться к объектам основных средств, по которым ведется групповой учет.
				|Укажите другой порядок включения стоимости в состав расходов налогового учета.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	
	Оповестить("ДокументыПоУчетуОСИзменение");
	
	ЗаписаннаяДатаДокумента = Объект.Дата;
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьРеквизитыФормыПоСчетуУчета(ЭтаФорма, ТекущийОбъект);
	ЗаполнитьРеквизитыФормыПоОбъектуОС(ЭтаФорма, ТекущийОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеОсновнымиСредствамиКлиент.ПриОткрытииДокумента173н(ЭтотОбъект, "ПринятиеКУчетуОбъектовОС");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииТиповойОперации(Элемент)
	
	ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

	БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтаФорма, Команда);	

КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьДоговора(ЭтаФорма, Объект);
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ОрганизацияПриИзмененииНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ЭтаФорма.ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	// Общие проверки условий по датам.
	ТребуетсяВызовСервера = ОбщегоНазначенияБГУКлиент.ТребуетсяВызовСервераПриИзмененииДатыДокумента(Объект.Дата, ТекущаяДатаДокумента);

	// Если определили, что изменение даты может повлиять на какие-либо параметры, 
	// то передаем обработку на сервер.
	Если ТребуетсяВызовСервера Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	// Запомним новую дату документа.
	ТекущаяДатаДокумента = Объект.Дата;
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	ЭтаФорма.ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПоступленияПриИзменении(Элемент)
	
	ПроверитьОчиститьСчетаУчета();
	УстановитьДоступностьКапвложения(ЭтаФорма, Объект);
	УстановитьДоступностьСчетаУчета(ЭтаФорма, Объект);
	УстановитьВидимостьСтраницыЦМОПодразделение(ЭтаФорма, Объект);
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтаФорма, Объект);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	
	// Запомним новый вид поступления.
	ТекущийВидПоступления = Объект.ВидПоступления;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	УстановитьДоступностьСвязанныхРеквизитовКонтрагента(ЭтаФорма, Объект);
	Если НЕ ЗначениеЗаполнено(Объект.СчетКонтрагента) Тогда
		Объект.СчетКонтрагента = ПолучитьСчетКонтрагента(Объект.Контрагент);
	КонецЕсли;
	
КонецПроцедуры

// Страница "Основное средство"

&НаКлиенте
Процедура ЦМООтправительПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ЦМО) Тогда
		Объект.ЦМО = Объект.ЦМООтправитель;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеОтправительПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Объект.Подразделение = Объект.ПодразделениеОтправитель;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	ЭтаФорма.ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	
	ОбнулитьСуммы(Объект);
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КПСПриИзменении(Элемент)
	ОбнулитьСуммы(Объект);
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	
	ЗаполнитьРеквизитыФормыПоСчетуУчета(ЭтаФорма, Объект);
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОграниченияКПС = Новый Массив;
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
		СтандартнаяОбработка,
		Новый Структура("Счет, КФО, КПС", Объект.СчетУчета, Объект.КФО, Объект.КПС),
		Объект.Организация,
		Объект.ИФО,
		УправлениеОсновнымиСредствамиКлиент.ДоступныеСчетаУчетаПриПринятииКУчетуОС(Объект.ВидПоступления),
		Объект.КФО,
		ОграниченияКПС,
		ОБъект.Дата,,
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение, Объект.КПС, Объект.КФО);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если Текст <> "" Тогда 
		ПараметрыВыбораЗначения = Новый Структура;
		ПараметрыВыбораЗначения.Вставить("ОграниченияСписокСчетов", УправлениеОсновнымиСредствамиКлиент.ДоступныеСчетаУчетаПриПринятииКУчетуОС(Объект.ВидПоступления));
		ПараметрыВыбораЗначения.Вставить("ОграничениеПоСубконто",	ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
		ПараметрыВыбораЗначения.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
		ПараметрыВыбораЗначения.Вставить("СтрокаПоиска",			Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыВыбораЗначения);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Текст <> "" Тогда 
		ПараметрыВыбораЗначения = Новый Структура;
		ПараметрыВыбораЗначения.Вставить("ОграниченияСписокСчетов", УправлениеОсновнымиСредствамиКлиент.ДоступныеСчетаУчетаПриПринятииКУчетуОС(Объект.ВидПоступления));
		ПараметрыВыбораЗначения.Вставить("ОграничениеПоСубконто",	ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
		ПараметрыВыбораЗначения.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
		ПараметрыВыбораЗначения.Вставить("СтрокаПоиска",			Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыВыбораЗначения);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнеоборотныйАктивПриИзменении(Элемент)
	
	ТекущееОсновноеСредство = Объект.ОсновноеСредство;
	
	ВнеоборотныйАктивПриИзмененииНаСервере();
	
	Если ТекущееОсновноеСредство <> Объект.ОсновноеСредство Тогда
		ОсновноеСредствоПриИзмененииНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВнеоборотныйАктивПриИзмененииНаСервере()
	
	ДанныеОбъектаВложений = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.ВнеоборотныйАктив, Объект.Ссылка);
	
	Объект.СчетКредита = ДанныеОбъектаВложений.СчетВложений;
	
	Если ДанныеОбъектаВложений.ВидНФА <> Перечисления.ВидыНФА.КапВложения
		И Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Объект.ОсновноеСредство = Объект.ВнеоборотныйАктив;
		ОсновноеСредствоПриИзмененииНаСервере();
	КонецЕсли;
	
	РассчитатьСуммуВложений();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнеоборотныйАктивНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыВыбораОбъектаВложений(), Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнеоборотныйАктивАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) > 0 Тогда
		ПараметрыФормы = ПараметрыВыбораОбъектаВложений();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнеоборотныйАктивОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) > 0 Тогда
		ПараметрыФормы = ПараметрыВыбораОбъектаВложений();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормы);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКредитаПриИзменении(Элемент)
	ОбнулитьСуммы(Объект);
КонецПроцедуры

&НаКлиенте
Процедура СчетКредитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОграниченияСчета = Новый Массив;
	ОграниченияСчета.Добавить("106.00");
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			Объект.СчетКредита, 
																			Объект.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															ОграниченияСчета,
															Объект.КФО,
															,
															Объект.Дата,,ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
КонецПроцедуры

&НаКлиенте
Процедура СчетКредитаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															Объект.КПС,
															Объект.КФО,
															,);
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	ОсновноеСредствоПриИзмененииНаСервере();
	ОсновноеСредствоПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(УстанавливатьИнвентарныйНомер = Истина)

	Если УстанавливатьИнвентарныйНомер Тогда
		УстановитьИнвентарныйНомер(ЭтаФорма, Объект, Истина);
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		Объект.СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(Объект.ОсновноеСредство, Объект.Ссылка);
	КонецЕсли;
	
	ЗаполнитьРеквизитыФормыПоОбъектуОС(ЭтаФорма, Объект);

КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзмененииНаКлиенте()

	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	УстановитьОбязательностьИнвентарногоНомера(ЭтаФорма, Объект);
	УстановитьЗаголовокКомандыЗаполнитьДанныеОбОС(ЭтаФорма, Объект);
	УстановитьСрокПолезногоИспользования();
	УстановитьСрокПолезногоИспользованияВГодах(ЭтаФорма, Объект);
	УправлениеОсновнымиСредствамиКлиент.УстановитьПорядокПогашенияСтоимости(
								Объект.ПорядокПогашенияСтоимости,
								Объект.СпособНачисленияАмортизации,
								Объект.НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации());
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
								Объект.СпособНачисленияАмортизации,
								Объект.НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации());
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьСчетаУчета(ЭтаФорма, Объект);
	
	ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(ЭтаФорма);
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления)
	   И Не ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
		ТекстПредупреждения = НСтр(
			"ru='Перед выбором принимаемого к учету объекта необходимо выбрать объект капитальных вложений'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыВыбораОбъектаОС(), Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Текст) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = ПараметрыВыбораОбъектаОС();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Текст) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = ПараметрыВыбораОбъектаОС();
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("Отбор, НаДату, ТекущаяСтрока",
										Новый Структура("Владелец, ОС",
														Объект.Организация,
														Объект.ОсновноеСредство),
										?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата),
										Объект.ИнвентарныйНомер);
	Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления) Тогда
		
		//Параметры для формирования Инвентарных номеров
		ПараметрыФормы.Вставить("Дата",									Объект.Дата);
		ПараметрыФормы.Вставить("СчетУчета",							Объект.СчетУчета);
		ПараметрыФормы.Вставить("КФО",									Объект.КФО);
		ПараметрыФормы.Вставить("КПС",									Объект.КПС);
		ПараметрыФормы.Вставить("Организация",							Объект.Организация);
		ПараметрыФормы.Вставить("ОсновноеСредство",						Объект.ОсновноеСредство);
		ПараметрыФормы.Вставить("ИнвентарныйНомер",						Объект.ИнвентарныйНомер);
		ПараметрыФормы.Вставить("ФормированиеИзДокумента",				Истина);
		ПараметрыФормы.Вставить("Регистратор",							Объект.Ссылка);
		ПараметрыФормы.Вставить("ФормированиеИнвНомераБезОбработки",	Истина);
		ПараметрыФормы.Вставить("ПроверитьСоздатьИнвентарныйНомер",		Истина);
		
	КонецЕсли;
		
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеВсеРеквизитыЗаполненыНажатие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		СписокСпособов = Новый СписокЗначений;
		СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
		ПараметрыФормы = Новый Структура("Ключ, СпособыНачисленияАмортизации",
										Объект.ОсновноеСредство,
										СписокСпособов);
		ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаЭлемента", ПараметрыФормы);
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	УстановитьПорядокПогашенияСтоимостиПоУмолчанию();
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(
					Объект.СпособНачисленияАмортизации,
					Объект.НачислятьАмортизацию,
					ПараметрыВыбораПараметровНачисленияАмортизации());
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
	ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(ЭтаФорма);
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);
	
	Если Объект.ПервоначальнаяСтоимостьНУ = 0 И Объект.РасходыНеУчитываетсяНУ = 0 И Объект.РасходыЕНВД = 0 Тогда
		Объект.ПервоначальнаяСтоимостьНУ = Объект.ПервоначальнаяСтоимость;
	КонецЕсли;
	
КонецПроцедуры

// Страница "Амортизация"

&НаКлиенте
Процедура СрокПолезногоИспользованияПриИзменении(Элемент)
	
	УстановитьСрокПолезногоИспользованияВГодах(ЭтаФорма, Объект);
	
	Объект.ОставшийсяСрокПолезногоИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			Объект.ДатаВводаВЭксплуатацию, Объект.СрокПолезногоИспользования, Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокПогашенияСтоимостиПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(
		Объект.СпособНачисленияАмортизации,
		Объект.НачислятьАмортизацию,
		ПараметрыВыбораПараметровНачисленияАмортизации());
	УстановитьВидимостьПараметровАмортизации(ЭтаФорма, Объект);
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
	
	ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(ЭтаФорма);
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособНачисленияАмортизацииПриИзменении(Элемент)
	УстановитьДоступностьПараметровАмортизации(ЭтаФорма, Объект);
КонецПроцедуры

&НаКлиенте
Процедура СпособНачисленияАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыВыбораЗначения = ПараметрыВыбораПараметровНачисленияАмортизации();
	УправлениеОсновнымиСредствамиКлиент.СпособНачисленияАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораЗначения); 
	Если Не СтандартнаяОбработка И Элемент.СписокВыбора.Количество() > 0 Тогда
		Элемент.СписокВыбора.Очистить();
	КонецЕсли;
КонецПроцедуры

