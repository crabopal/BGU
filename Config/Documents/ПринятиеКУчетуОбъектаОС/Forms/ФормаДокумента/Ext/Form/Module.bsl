	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОграниченияСписокСчетов",
		НалоговыйУчетКлиентСервер.ВозможныеСчетаУчетаЗатратПоАмортизационнойПремии());
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.СчетУчетаЗатратПоАмортизационнойПремии);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
