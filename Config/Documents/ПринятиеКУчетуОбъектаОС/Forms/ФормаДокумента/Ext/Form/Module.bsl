														СтандартнаяОбработка,
														Новый Структура("Счет, КПС, КФО, Организация, ИФО, Дата",
																		Объект.СчетУчетаЗатрат,
																		Объект.КПСЗатрат,
																		Объект.КФО,
																		Объект.Организация,
																		Объект.ИФО,
																		Объект.Дата));
	
