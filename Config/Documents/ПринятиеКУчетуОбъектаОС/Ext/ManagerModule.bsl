#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата,КФО,
		|ВидПоступления,СчетУчетаЗатрат,ПорядокВключенияСтоимостиВСоставРасходовНУ,СтатьяПрочихРасходов,СчетУчета.Забалансовый");
	
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ЗначенияРеквизитов.ВидПоступления);
	ЭтоПоступлениеНаБаланс = Не ЭтоПоступлениеИзПользования И (ЗначенияРеквизитов.СчетУчетаЗабалансовый = Ложь); // СчетУчетаЗабалансовый может быть NULL
	
	// Параметры налогового учета
	ОтражатьВНалоговомУчете = УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ЗначенияРеквизитов);	
	СубконтоНУ = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
	Если ОтражатьВНалоговомУчете Тогда
		Если НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ЗначенияРеквизитов.СчетУчетаЗатрат)
			И ЗначенияРеквизитов.ПорядокВключенияСтоимостиВСоставРасходовНУ <> Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы Тогда
			СубконтоНУ = ЗначенияРеквизитов.СтатьяПрочихРасходов;
		КонецЕсли;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"						, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"				, "Принятие к учету объекта ОС (кроме зданий и сооружений) (ОС-1)");
	Запрос.УстановитьПараметр("ЭтоПоступлениеИзПользования"	, ЭтоПоступлениеИзПользования);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"		, УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	Запрос.УстановитьПараметр("СубконтоНУ"					, СубконтоНУ);
	Запрос.УстановитьПараметр("ЭтоПоступлениеНаБаланс"		, ЭтоПоступлениеНаБаланс);
	Запрос.УстановитьПараметр("Счет01"						, БухгалтерскийУчет.СписокСчетов("01"));
	Запрос.УстановитьПараметр("Счет02"						, БухгалтерскийУчет.СписокСчетов("02"));
	Запрос.УстановитьПараметр("Счет21"						, БухгалтерскийУчет.СписокСчетов("21"));
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("МестонахождениеОС", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуОбъектаОС.Организация КАК Организация,
	|	ПринятиеКУчетуОбъектаОС.ИнвентарныйНомер КАК ИнвНомер,
	|	ПринятиеКУчетуОбъектаОС.ЦМО КАК ЦМО,
	|	ПринятиеКУчетуОбъектаОС.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеИзПользования
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПринятиеКУчетуОбъектаОС.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
	|						ИЛИ ПринятиеКУчетуОбъектаОС.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|			КОНЕЦ
	|	КОНЕЦ КАК Состояние,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ПринятиеКУчетуОбъектаОС.Номер КАК НомерДокумента,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК ДатаДокумента,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК Период
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.Организация,
	|	СобытияОС.ИнвНомер,
	|	СобытияОС.Событие,
	|	СобытияОС.ДатаСобытия,
	|	СобытияОС.НомерДокумента,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	СобытияОС.Номер КАК НомерДокумента,
	|	СобытияОС.ДатаДокумента,
	|	СобытияОС.Период,
	|	&Ссылка КАК Регистратор
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПринятиеКУчетуОбъектаОС.Номер КАК Номер,
	|		ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|		ПринятиеКУчетуОбъектаОС.Организация КАК Организация,
	|		ПринятиеКУчетуОбъектаОС.ИнвентарныйНомер КАК ИнвНомер,
	|		ВЫБОР
	|			КОГДА ПринятиеКУчетуОбъектаОС.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзАренды)
	|			КОГДА ПринятиеКУчетуОбъектаОС.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|		КОНЕЦ КАК Событие,
	|		ПринятиеКУчетуОбъектаОС.Дата КАК ДатаСобытия,
	|		ПринятиеКУчетуОбъектаОС.Номер КАК НомерДокумента,
	|		ПринятиеКУчетуОбъектаОС.Дата КАК ДатаДокумента,
	|		1 КАК Порядок,
	|		ИСТИНА КАК Включать,
	|		ПринятиеКУчетуОбъектаОС.Дата КАК Период
	|	ИЗ
	|		Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|	ГДЕ
	|		ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПринятиеКУчетуОбъектаОС.Номер,
	|		ПринятиеКУчетуОбъектаОС.ОсновноеСредство,
	|		ПринятиеКУчетуОбъектаОС.Организация,
	|		ПринятиеКУчетуОбъектаОС.ИнвентарныйНомер,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|					ИЛИ ПринятиеКУчетуОбъектаОС.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ПринятиеКУчетуОбъектаОС.Дата
	|			ИНАЧЕ ПринятиеКУчетуОбъектаОС.ДатаВводаВЭксплуатацию
	|		КОНЕЦ,
	|		ПринятиеКУчетуОбъектаОС.Номер,
	|		ПринятиеКУчетуОбъектаОС.Дата,
	|		2,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|					ИЛИ ПринятиеКУчетуОбъектаОС.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
	|					ИЛИ ПринятиеКУчетуОбъектаОС.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ,
	|		ПринятиеКУчетуОбъектаОС.Дата
	|	ИЗ
	|		Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|	ГДЕ
	|		ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.Включать
	|
	|УПОРЯДОЧИТЬ ПО
	|	СобытияОС.Порядок";
	
	НомераТаблиц.Вставить("НачислениеАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуОбъектаОС.Организация КАК Организация,
	|	ПринятиеКУчетуОбъектаОС.НачислятьАмортизацию,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК Период
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
	|	И ПринятиеКУчетуОбъектаОС.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|	И ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуОбъектаОС.Организация КАК Организация,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК Период,
	|	ПринятиеКУчетуОбъектаОС.СпособНачисленияАмортизации,
	|	ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("АмортизацияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК Период,
	|	ПринятиеКУчетуОбъектаОС.СчетУчетаЗатрат,
	|	ПринятиеКУчетуОбъектаОС.КЭКЗатрат КАК КЭК,
	|	ПринятиеКУчетуОбъектаОС.СубконтоЗатрат1 КАК Субконто1,
	|	ПринятиеКУчетуОбъектаОС.СубконтоЗатрат2 КАК Субконто2,
	|	ПринятиеКУчетуОбъектаОС.СубконтоЗатрат3 КАК Субконто3,
	|	&СубконтоНУ КАК СубконтоНУ,
	|	ПринятиеКУчетуОбъектаОС.КПСЗатрат КАК КПС,
	|	ПринятиеКУчетуОбъектаОС.ПодразделениеЗатрат КАК Подразделение,
	|	ПринятиеКУчетуОбъектаОС.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
	|	И (ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ИЛИ ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))";
	
	НомераТаблиц.Вставить("РасчетАмортизацииОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектаОС.Дата КАК Период,
	|	ПринятиеКУчетуОбъектаОС.СрокПолезногоИспользования,
	|	ПринятиеКУчетуОбъектаОС.ОставшийсяСрокПолезногоИспользования КАК СрокИспользованияДляВычисленияАмортизации,
	|	МАКСИМУМ(ПринятиеКУчетуОбъектаОС.ПервоначальнаяСтоимость - ПринятиеКУчетуОбъектаОС.СуммаАмортизации) КАК СтоимостьДляВычисленияАмортизации,
	|	ПринятиеКУчетуОбъектаОС.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
	|	И (ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ИЛИ ПринятиеКУчетуОбъектаОС.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))
	|
	|СГРУППИРОВАТЬ ПО
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство,
	|	ПринятиеКУчетуОбъектаОС.Дата,
	|	ПринятиеКУчетуОбъектаОС.СрокПолезногоИспользования,
	|	ПринятиеКУчетуОбъектаОС.ОставшийсяСрокПолезногоИспользования,
	|	ПринятиеКУчетуОбъектаОС.Организация";
	
	НомераТаблиц.Вставить("ВТ_Стоимость", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СтоимостьОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
