		|	ПринятиеКУчетуОбъектаОС.ПодразделениеПоАмортизационнойПремии КАК ПодразделениеРасходов,
		|	&Ссылка КАК Регистратор,
		|	ПринятиеКУчетуОбъектаОС.Дата КАК Период
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
		|ГДЕ
		|	ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
		|	И ПринятиеКУчетуОбъектаОС.ПорядокВключенияСтоимостиВСоставРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)
		|	И ПринятиеКУчетуОбъектаОС.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ > 0";
		
		НомераТаблиц.Вставить("НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ПринятиеКУчетуОбъектаОС.Организация КАК Организация,
		|	ПринятиеКУчетуОбъектаОС.СпециальныйКоэффициентНУ КАК СпециальныйКоэффициент,
		|	&Ссылка КАК Регистратор,
		|	ПринятиеКУчетуОбъектаОС.Дата КАК Период
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
		|ГДЕ
		|	ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка
		|	И ПринятиеКУчетуОбъектаОС.ПорядокВключенияСтоимостиВСоставРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)";
		
		НомераТаблиц.Вставить("ПервоначальныеСведенияОСНалоговыйУчет", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство,
		|	ПринятиеКУчетуОбъектаОС.ПорядокВключенияСтоимостиВСоставРасходовНУ КАК ПорядокВключенияСтоимостиВСоставРасходов,
		|	ПринятиеКУчетуОбъектаОС.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ,
		|	ПринятиеКУчетуОбъектаОС.РасходыНеУчитываетсяНУ КАК РасходыНеУчитываетсяНУ,
		|	ПринятиеКУчетуОбъектаОС.РасходыЕНВД КАК РасходыЕНВД,
		|	ПринятиеКУчетуОбъектаОС.Дата КАК ДатаПринятияКУчету,
		|	&Ссылка КАК Регистратор,
		|	ПринятиеКУчетуОбъектаОС.Дата КАК Период,
		|	ПринятиеКУчетуОбъектаОС.Организация
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
		|ГДЕ
		|	ПринятиеКУчетуОбъектаОС.Ссылка = &Ссылка";
		
	КонецЕсли;
		
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
		
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПринятиеКУчетуОбъектаОС";
	КомандаПечати.Идентификатор		= "ОС1";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о приеме - передаче объекта ОС (ОС-1)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Перем ТабличныйДокумент;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОС1") Тогда
		
		ДанныеДокументов = УправлениеОсновнымиСредствами.ДокументыДляПечатиАктОС1_ПринятиеКУчету(МассивОбъектов, Истина, Ложь, Ложь);
		УправлениеОсновнымиСредствами.НапечататьОС1(ДанныеДокументов, ОбъектыПечати, ТабличныйДокумент); 
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1","ОС-1", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
