#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	РеквизитыОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, "ВидНФА,ТипНФА,ГрупповойУчет");
	
	Если ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды
		ИЛИ ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования Тогда
		
		УправлениеОсновнымиСредствами.ПроверитьСобытиеОСвПользовании(
			УправлениеОсновнымиСредствами.НоваяТаблицаОСИнвНомер(ОсновноеСредство, ИнвентарныйНомер),
			Организация,
			Дата,
			Ссылка,
			Ложь,
			?(ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды,
				Перечисления.ВидыСобытийОС.СдачаВАренду,
				Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование),
			Отказ);
			
		Если Отказ Тогда
			ПроверяемыеРеквизиты.Очистить();
		КонецЕсли;
		
		Если ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды Тогда
			СчетОбъекта = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("25");
		Иначе
			СчетОбъекта = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("26");
		КонецЕсли;
		
		ПризнакиУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(СчетОбъекта);
		
		МассивНепроверяемыхРеквизитов.Добавить("ВнеоборотныйАктив");
		МассивНепроверяемыхРеквизитов.Добавить("СчетКредита");
		МассивНепроверяемыхРеквизитов.Добавить("Количество");
		
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользования");
		МассивНепроверяемыхРеквизитов.Добавить("СчетУчетаЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат1");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат2");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат3");
		МассивНепроверяемыхРеквизитов.Добавить("КЭКЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеЗатрат");
		Если Не ПризнакиУчета.УчетПоКПС Тогда
			МассивНепроверяемыхРеквизитов.Добавить("КПС");
		КонецЕсли;
		Если Не ПризнакиУчета.УчетПоПодразделениям Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
			МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеОтправитель");
		КонецЕсли;
			
		МассивНепроверяемыхРеквизитов.Добавить("СпособНачисленияАмортизации");
		МассивНепроверяемыхРеквизитов.Добавить("ПорядокПогашенияСтоимости");
		МассивНепроверяемыхРеквизитов.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ");
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользованияНУ");
		МассивНепроверяемыхРеквизитов.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяПрочихРасходов");
		
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
		Возврат;
		
	Иначе
			
		МассивНепроверяемыхРеквизитов.Добавить("ЦМООтправитель");
		МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеОтправитель");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОсновноеСредство) И ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
		Если ОсновноеСредствоУжеПринятоКУчету(РеквизитыОС.ГрупповойУчет) Тогда
			Отказ = Истина;
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21 Тогда
		СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(
			УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(СчетУчета));
	Иначе
		СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	КонецЕсли;
	
	Если СвойстваСчетаУчета.Забалансовый Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИнвентарныйНомер");
	КонецЕсли;
	
	Если Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВнеоборотныйАктив");
		МассивНепроверяемыхРеквизитов.Добавить("СчетКредита");
		МассивНепроверяемыхРеквизитов.Добавить("Количество");
	КонецЕсли;		
	
	Если РеквизитыОС.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользования");
	КонецЕсли;
	
	Если НЕ СвойстваСчетаУчета.УчетПоКПС Тогда
		МассивНепроверяемыхРеквизитов.Добавить("КПС");	
	КонецЕсли;
	Если СвойстваСчетаУчета.Забалансовый Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользования");
		Если НЕ СвойстваСчетаУчета.УчетПоПодразделениям Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Подразделение");	
			МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеОтправитель");
		КонецЕсли;
	Иначе
		СписокСчетовПроверки	= БухгалтерскийУчет.СписокСчетов("101.00,106.00", Истина);
		СписокСчетовИсключений	= БухгалтерскийУчет.СписокСчетов("106.24,106.34,106.44", Истина);
		
		Если НЕ БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СписокСчетовПроверки, СписокСчетовИсключений) Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
			МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеОтправитель");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
			
			ТипыИсключения = Новый Массив;
			ТипыИсключения.Добавить(Перечисления.ТипыНФА.ЖилыеПомещения);
			ТипыИсключения.Добавить(Перечисления.ТипыНФА.НежилыеПомещения);
			ТипыИсключения.Добавить(Перечисления.ТипыНФА.Сооружения);
			ТипыИсключения.Добавить(Перечисления.ТипыНФА.БиблиотечныйФонд);
			
			Если РеквизитыОС.ВидНФА = Перечисления.ВидыНФА.ОС Тогда
				Если ТипыИсключения.Найти(РеквизитыОС.ТипНФА) <> Неопределено 
				ИЛИ ПервоначальнаяСтоимость <= УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПределыОС(Дата).ПервыйПределОС Тогда
					ТекстСообщения = НСтр("ru='Документ предназначен для принятия к учету ОС, стоимостью свыше %1 рублей, кроме зданий (сооружений) и библиотечного фонда.'");
					ОписаниеОшибки = "";
					Если ПервоначальнаяСтоимость <= УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПределыОС(Дата).ПервыйПределОС Тогда
						ОписаниеОшибки = НСтр("ru='Выбран объект основных средств стоимостью менее %1 рублей включительно.'");
					ИначеЕсли РеквизитыОС.ТипНФА <> Перечисления.ТипыНФА.БиблиотечныйФонд Тогда
						ОписаниеОшибки = НСтр("ru='Выбран объект основных средств относящийся к зданиям (сооружениям).'");
					Иначе
						ОписаниеОшибки = НСтр("ru='Выбран объект основных средств относящийся к библиотечному фонду.'");
					КонецЕсли;
					
					ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки;
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПределыОС(Дата).ПервыйПределОС); 
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
				Иначе
					Если СуммаАмортизации > ПервоначальнаяСтоимость Тогда
						ТекстСообщения = НСтр("ru='Переданная амортизация не может быть больше первоначальной стоимости.'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.СуммаАмортизации",,Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетКредита) ИЛИ ЗначениеЗаполнено(ВнеоборотныйАктив) Тогда
		Если ПроверяемыеРеквизиты.Найти("СчетКредита") = Неопределено Тогда
			ПроверяемыеРеквизиты.Добавить("СчетКредита");
		КонецЕсли;
		Если ПроверяемыеРеквизиты.Найти("ВнеоборотныйАктив") = Неопределено Тогда
			ПроверяемыеРеквизиты.Добавить("ВнеоборотныйАктив");
		КонецЕсли;
	КонецЕсли;
	
	СтоимостьНеПогашается = ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21;
	УправлениеОсновнымиСредствами.ДобавитьНепроверяемыеРеквизитыСчетаЗатрат(СтоимостьНеПогашается, ПорядокПогашенияСтоимости, СчетУчетаЗатрат, МассивНепроверяемыхРеквизитов);
	
	// Налоговый учет по налогу на прибыль
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО)
		И НЕ ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21;
	
	Если НЕ ОтражатьВНалоговомУчете Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ");
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользованияНУ");
		МассивНепроверяемыхРеквизитов.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяПрочихРасходов");
	КонецЕсли;
	
	ВыбранСчетПрочихРасходов = (БухгалтерскийУчет.СписокСчетов("401.20").Найти(СчетУчетаЗатрат) <> Неопределено);
	Если НЕ ВыбранСчетПрочихРасходов
	 ИЛИ ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СтатьяПрочихРасходов");
	КонецЕсли;
	
	Если НЕ ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользованияНУ");
	КонецЕсли;
	
	Если НЕ НачислятьАмортизациюНУ Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СрокПолезногоИспользованияНУ");
	КонецЕсли;
	
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ <> Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации
			ИЛИ ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0 Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СчетУчетаЗатратПоАмортизационнойПремии");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ПервоначальнаяСтоимость					= 0;
	ПервоначальнаяСтоимостьНУ				= 0;
	Количество								= 0;
	ИнвентарныйНомер						= Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	ДатаВводаВЭксплуатацию					= '00010101';
	ОставшийсяСрокПолезногоИспользования	= 0;
	СуммаАмортизации						= 0;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101 Тогда
		ДатаВводаВЭксплуатацию					= '00010101';
		ОставшийсяСрокПолезногоИспользования	= 0;
		СуммаАмортизации						= 0;
	КонецЕсли;
	
	Если ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21 Тогда
		ПорядокПогашенияСтоимости	= Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию;
		СпособНачисленияАмортизации	= Перечисления.СпособНачисленияАмортизации.ПустаяСсылка();
		СчетУчетаЗатрат				= Неопределено;
		КЭКЗатрат					= Неопределено;
		КПСЗатрат					= Неопределено;
		ПодразделениеЗатрат			= Неопределено;
		СубконтоЗатрат1				= Неопределено;
		СубконтоЗатрат2				= Неопределено;
		СубконтоЗатрат3				= Неопределено;
		ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = Истина;
	КонецЕсли;
	Если ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление
		И ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
		
		ВнеоборотныйАктив = Неопределено;
		СчетКредита = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОсновноеСредствоУжеПринятоКУчету(ГрупповойУчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПРЕДСТАВЛЕНИЕ(СобытияОС.Событие) КАК Событие,
	               |	СобытияОС.ДатаСобытия,
	               |	ВЫБОР
	               |		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	               |			ТОГДА 1
	               |		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	               |			ТОГДА 2
	               |		ИНАЧЕ 3
	               |	КОНЕЦ КАК Поле1,
	               |	СобытияОС.Регистратор,
	               |	ПРЕДСТАВЛЕНИЕ(СобытияОС.Регистратор) КАК ПредставлениеРегистратора
	               |ИЗ
	               |	РегистрСведений.СобытияОС КАК СобытияОС
	               |ГДЕ
	               |	СобытияОС.Организация = &Организация
	               |	И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |	И СобытияОС.ИнвНомер = &ИнвНомер";
	Если ЭтотОбъект.ЭтоНовый() Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	И СобытияОС.Период <= &Период";
		Запрос.УстановитьПараметр("Период", 		КонецДня(Дата));
	Иначе
		Запрос.Текст = Запрос.Текст + "
	               |	И СобытияОС.МоментВремени <= &МоментВремени
	               |	И СобытияОС.Регистратор <> &Регистратор";
		Запрос.УстановитьПараметр("МоментВремени",	МоментВремени());
		Запрос.УстановитьПараметр("Регистратор",	Ссылка);
	КонецЕсли;	
	Запрос.Текст = Запрос.Текст + "	
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Поле1";
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство",	ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер",			ИнвентарныйНомер);
	Результат = Запрос.Выполнить();
