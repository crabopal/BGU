// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Стандартная бухгалтерская справка
	
КонецПроцедуры

#КонецОбласти

Функция ШаблонЗаменыСчетовиКОСГУ() Экспорт
	
	ТипСтрока	= Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(6, ДопустимаяДлина.Переменная));
	ТипДата		= Новый ОписаниеТипов("Дата");
	ТипЧисло	= Новый ОписаниеТипов("Число");
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СчетИсточникКод"	, ТипСтрока);
	Таблица.Колонки.Добавить("СчетИсточникДата"	, ТипДата);
	Таблица.Колонки.Добавить("КОСГУИсточник"	, ТипСтрока);
	Таблица.Колонки.Добавить("КВД"				, ТипЧисло);
	Таблица.Колонки.Добавить("СчетПриемникКод"	, ТипСтрока);
	Таблица.Колонки.Добавить("СчетПриемникДата"	, ТипДата);
	Таблица.Колонки.Добавить("КОСГУПриемник"	, ТипСтрока);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПереносОстатков64нРасчеты.ШаблонПоУмолчанию");
		
	Для К = 3 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		СчетСтрока = СокрЛП(Макет.Область(к,1).Текст);
		ЧастиСчета = ПолучитьЧастиСчета(СчетСтрока);	
		НоваяСтрока.СчетИсточникКод  = ЧастиСчета.Код;
		НоваяСтрока.СчетИсточникДата = ЧастиСчета.Дата;
		
		НоваяСтрока.КОСГУИсточник = СокрЛП(Макет.Область(к,2).Текст);
		
		СчетСтрока = СокрЛП(Макет.Область(к,3).Текст);
		ЧастиСчета = ПолучитьЧастиСчета(СчетСтрока);	
		НоваяСтрока.СчетПриемникКод  = ЧастиСчета.Код;
		НоваяСтрока.СчетПриемникДата = ЧастиСчета.Дата;
		
		НоваяСтрока.КОСГУПриемник = СокрЛП(Макет.Область(к,4).Текст);
		
		КВДСтрока = СокрЛП(Макет.Область(к,5).Текст);		
		КВДМассив = СтрРазделить(КВДСтрока, ",", Ложь);
		Если КВДМассив.Количество() > 0 Тогда
			НоваяСтрока.КВД = Число(КВДМассив[0])-1;
		Иначе
			НоваяСтрока.КВД	= -1;
		КонецЕсли;
		
		Для Сч = 2 По КВДМассив.Количество() Цикл
			НоваяСтрока2 = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока2, НоваяСтрока);
			НоваяСтрока2.КВД = Число(КВДМассив[Сч-1])-1;
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.СчетИсточникКод КАК СчетИсточникКод,
	|	Таблица.СчетИсточникДата КАК СчетИсточникДата,
	|	Таблица.КОСГУИсточник КАК КОСГУИсточник,
	|	Таблица.КВД КАК КВД,
	|	Таблица.СчетПриемникКод КАК СчетПриемникКод,
	|	Таблица.СчетПриемникДата КАК СчетПриемникДата,
	|	Таблица.КОСГУПриемник КАК КОСГУПриемник
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетИсточник.Ссылка КАК СчетИсточник,
	|	СчетПриемник.Ссылка КАК СчетПриемник,
	|	ЕСТЬNULL(КФО.Ссылка, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	СпрКОСГУИсточник.Ссылка КАК КОСГУИсточник,
	|	СпрКОСГУПриемник.Ссылка КАК КОСГУПриемник
	|ИЗ
	|	Таблица КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК СчетИсточник
	|		ПО Таблица.СчетИсточникКод = СчетИсточник.Код
	|			И Таблица.СчетИсточникДата = СчетИсточник.ДатаНачалаДействия
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК СчетПриемник
	|		ПО Таблица.СчетПриемникКод = СчетПриемник.Код
	|			И Таблица.СчетПриемникДата = СчетПриемник.ДатаНачалаДействия
	|		ЛЕВОЕ СОЕДИНЕНИЕ Перечисление.КВД КАК КФО
	|		ПО Таблица.КВД = КФО.Порядок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СпрКОСГУИсточник
	|		ПО Таблица.КОСГУИсточник = СпрКОСГУИсточник.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СпрКОСГУПриемник
	|		ПО Таблица.КОСГУПриемник = СпрКОСГУПриемник.Код
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.СчетИсточникКод,
	|	Таблица.КОСГУИсточник,
	|	КФО.Порядок";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЧастиСчета(ТекКод)
	
	ЧастиСчета = Новый Структура("Код,Дата", ТекКод, '00010101');
	
	ПозицияТочек = Найти(ТекКод, ":");
	Если ПозицияТочек > 0 Тогда
		ЧастиСчета.Код = Лев(ТекКод, (ПозицияТочек - 1));
		ЧастиСчета.Дата = Дата(Сред(ТекКод, (ПозицияТочек + 1)));
	КонецЕсли;	
	
	Возврат ЧастиСчета;
	
КонецФункции

Функция ПустаяТаблицаОстатки() Экспорт
	
	ТипЧисло_18_2	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ТипЧисло_15_3	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ТипЧисло_15_2	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ТипСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипСубконто		= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	ПустаяТаблица.Колонки.Добавить("Период"					, Новый ОписаниеТипов("Дата"));
	ПустаяТаблица.Колонки.Добавить("Счет"					, ТипСчет);
	ПустаяТаблица.Колонки.Добавить("СчетПриемник"			, ТипСчет);
	ПустаяТаблица.Колонки.Добавить("Субконто1"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто2"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто3"				, ТипСубконто);
	ПустаяТаблица.Колонки.Добавить("КПС"					, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК"					, Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ИФО"					, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("Валюта"					, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("Подразделение"			, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("СчетАктивный"			, Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("КФО"					, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("Сумма"					, ТипЧисло_18_2);
	ПустаяТаблица.Колонки.Добавить("ВалютнаяСумма"			, ТипЧисло_18_2);
	ПустаяТаблица.Колонки.Добавить("Количество"				, ТипЧисло_15_3);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ"	, ТипЧисло_15_2);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВД"				, ТипЧисло_15_2);
	ПустаяТаблица.Колонки.Добавить("СуммаНДС"				, ТипЧисло_15_2);	
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ТаблицаОстатки(РеквизитыДокумента) Экспорт
	
	Если Не РеквизитыДокумента.Свойство("ДатаПерехода") Тогда
		ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата);
		РеквизитыДокумента.Вставить("ДатаПерехода", ДатаПерехода);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, НачалоГода(РеквизитыДокумента.ДатаПерехода) - 1);
	Запрос.УстановитьПараметр("ДатаОстатков"	, НачалоГода(РеквизитыДокумента.ДатаПерехода));
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("ТабШаблона"		, ШаблонЗаменыСчетовиКОСГУ());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Шаблоны.СчетИсточник КАК ПланСчетов.ЕПСБУ) КАК СчетИсточник,
	|	ВЫРАЗИТЬ(Шаблоны.СчетПриемник КАК ПланСчетов.ЕПСБУ) КАК СчетПриемник,
	|	Шаблоны.КФО КАК КФО,
	|	Шаблоны.КОСГУИсточник КАК КОСГУИсточник,
	|	Шаблоны.КОСГУПриемник КАК КОСГУПриемник
	|ПОМЕСТИТЬ Шаблон
	|ИЗ
	|	&ТабШаблона КАК Шаблоны
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Счет КАК Счет,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.Организация КАК Организация,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.ИФО КАК ИФО,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.ВалютнаяСуммаОстаток
	|	КОНЕЦ КАК ВалютнаяСумма,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.КоличествоОстаток
	|		ИНАЧЕ Остатки.КоличествоОстаток
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаНеУчитываетсяНУОстаток
	|		ИНАЧЕ Остатки.СуммаНеУчитываетсяНУОстаток
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУ,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ Остатки.СуммаЕНВДОстаток
	|	КОНЕЦ КАК СуммаЕНВД,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаНДСОстаток
	|		ИНАЧЕ Остатки.СуммаНДСОстаток
	|	КОНЕЦ КАК СуммаНДС
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,
	|			Счет В
	|				(ВЫБРАТЬ
	|					Таб.СчетИсточник
	|				ИЗ
	|					Шаблон КАК Таб),
	|			,
	|			Организация = &Организация) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Период КАК Период,
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Сумма КАК Сумма,
	|	Остатки.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Остатки.Количество КАК Количество,
	|	Остатки.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВД КАК СуммаЕНВД,
	|	Остатки.СуммаНДС КАК СуммаНДС,
	|	Шаблон.СчетПриемник КАК СчетПриемник,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК СчетАктивный
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Шаблон КАК Шаблон
	|		ПО (Остатки.Счет = Шаблон.СчетИсточник
	|				ИЛИ Остатки.КЭК = Шаблон.КОСГУИсточник)
	|			И (Шаблон.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|				ИЛИ Остатки.КФО = Шаблон.КФО)
	|ГДЕ
	|	Остатки.Счет <> Шаблон.СчетПриемник";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

Функция ПустаяТаблицаОбороты() Экспорт
	
	Возврат ТаблицаОбороты();	
	
КонецФункции

Функция ТаблицаОбороты(РеквизитыДокумента = Неопределено, ПоКассовымСчетам = Истина) Экспорт

	Период = '00010101';
	
	Если РеквизитыДокумента = Неопределено Тогда
		РеквизитыДокумента = Новый Структура;
		РеквизитыДокумента.Вставить("Организация"	, Справочники.Организации.ПустаяСсылка());
		РеквизитыДокумента.Вставить("ВидОперации"	, Неопределено);	
		РеквизитыДокумента.Вставить("НачалоПериода"	, '00010101');
		РеквизитыДокумента.Вставить("КонецПериода"	, '00010101');
	Иначе
		
		Если Не РеквизитыДокумента.Свойство("ДатаПерехода") Тогда
			ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата);
			РеквизитыДокумента.Вставить("ДатаПерехода", ДатаПерехода);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитыДокумента.ДатаПерехода)
			И НачалоДня(РеквизитыДокумента.ДатаПерехода) <> НачалоГода(РеквизитыДокумента.ДатаПерехода) Тогда
			Период = НачалоДня(РеквизитыДокумента.ДатаПерехода) - 1;
		КонецЕсли;
		
		РеквизитыДокумента.КонецПериода = КонецДня(РеквизитыДокумента.КонецПериода);

	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Шаблоны.СчетИсточник КАК ПланСчетов.ЕПСБУ) КАК СчетИсточник,
	|	ВЫРАЗИТЬ(Шаблоны.СчетПриемник КАК ПланСчетов.ЕПСБУ) КАК СчетПриемник,
	|	Шаблоны.КФО КАК КФО,
	|	Шаблоны.КОСГУИсточник КАК КОСГУИсточник,
	|	Шаблоны.КОСГУПриемник КАК КОСГУПриемник
	|ПОМЕСТИТЬ Шаблон
	|ИЗ
	|	&ТабШаблона КАК Шаблоны
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Период КАК Период,
	|	Обороты.Регистратор КАК Регистратор,
	|	Обороты.СчетДт КАК СчетДт,
	|	Обороты.СубконтоДт1 КАК СубконтоДт1,
	|	Обороты.СубконтоДт2 КАК СубконтоДт2,
	|	Обороты.СубконтоДт3 КАК СубконтоДт3,
	|	Обороты.СчетКт КАК СчетКт,
	|	Обороты.СубконтоКт1 КАК СубконтоКт1,
	|	Обороты.СубконтоКт2 КАК СубконтоКт2,
	|	Обороты.СубконтоКт3 КАК СубконтоКт3,
	|	Обороты.КПСДт КАК КПСДт,
	|	Обороты.КПСКт КАК КПСКт,
	|	Обороты.КЭКДт КАК КЭКДт,
	|	Обороты.КЭККт КАК КЭККт,
	|	Обороты.ИФО КАК ИФО,
	|	Обороты.ВалютаДт КАК ВалютаДт,
	|	Обороты.ВалютаКт КАК ВалютаКт,
	|	Обороты.ПодразделениеДт КАК ПодразделениеДт,
	|	Обороты.ПодразделениеКт КАК ПодразделениеКт,
	|	Обороты.ЖурналОпераций КАК ЖурналОпераций,
	|	Обороты.КФО КАК КФО,
	|	ЕСТЬNULL(Обороты.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(Обороты.ВалютнаяСуммаДт, 0) КАК ВалютнаяСуммаДт,
	|	ЕСТЬNULL(Обороты.ВалютнаяСуммаКт, 0) КАК ВалютнаяСуммаКт,
	|	ЕСТЬNULL(Обороты.КоличествоДт, 0) КАК КоличествоДт,
	|	ЕСТЬNULL(Обороты.КоличествоКт, 0) КАК КоличествоКт,
	|	ЕСТЬNULL(Обороты.СуммаНеУчитываетсяНУ, 0) КАК СуммаНеУчитываетсяНУ,
	|	ЕСТЬNULL(Обороты.СуммаЕНВД, 0) КАК СуммаЕНВД,
	|	ЕСТЬNULL(Обороты.СуммаНДС, 0) КАК СуммаНДС,
	|	Обороты.Содержание КАК Содержание,
	|	Обороты.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
	|	Обороты.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
	|	Обороты.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	Обороты.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	Обороты.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ПереводыДт.СчетПриемник КАК СчетПриемникДт,
	|	ПереводыДт.КОСГУПриемник КАК КОСГУПриемникДт,
	|	ПереводыДт.КОСГУИсточник КАК КОСГУИсточникДт,
	|	ПереводыКт.СчетПриемник КАК СчетПриемникКт,
	|	ПереводыКт.КОСГУПриемник КАК КОСГУПриемникКт,
	|	ПереводыКт.КОСГУИсточник КАК КОСГУИсточникКт,
	|	ЛОЖЬ КАК ЭтоСчетДН,
	|	Обороты.Период КАК ПериодПорядок
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&ПериодНачало,
	|			&ПериодКонец,
	|			&ПолучитьОбороты
	|				И Организация = &Организация
	|				И Активность
	|				И НЕ Регистратор ССЫЛКА Документ.ПереносОстатков64нРасчеты
	|				И (СчетДт В
	|						(ВЫБРАТЬ
	|							Таб.СчетИсточник
	|						ИЗ
	|							Шаблон КАК Таб)
	|					ИЛИ СчетКт В
	|						(ВЫБРАТЬ
	|							Таб.СчетИсточник
	|						ИЗ
	|							Шаблон КАК Таб)),
	|			,
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Шаблон КАК ПереводыДт
	|		ПО Обороты.СчетДт = ПереводыДт.СчетИсточник
	|			И (ПереводыДт.КФО = &ПустойКФО
	|				ИЛИ Обороты.КФО = ПереводыДт.КФО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Шаблон КАК ПереводыКт
	|		ПО Обороты.СчетКт = ПереводыКт.СчетИсточник
	|			И (ПереводыКт.КФО = &ПустойКФО
	|				ИЛИ Обороты.КФО = ПереводыКт.КФО)
	|ГДЕ
	|	&УсловиеОтбораСчетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодПорядок,
	|	Регистратор";

	УсловиеОтбораСчета = "ЛОЖЬ";
	СчетаКассовые = Новый Массив;
	
	Если РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОборотов Тогда
		УсловиеОтбораСчета = "НЕ (СчетДт = &Счет20521 И СчетКт = &Счет40110 И КЭККт = &КОСГУ120)";
	ИначеЕсли РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.СторнированиеНачисленийАрендодателя Тогда
		УсловиеОтбораСчета = "   (СчетДт = &Счет20521 И СчетКт = &Счет40110 И КЭККт = &КОСГУ120)";
	ИначеЕсли РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ЗаменаКЭКВХарактеристиках Тогда
		ТекстЗапроса = ТекстЗапросаЗаменаКЭКВХарактеристиках(ТекстЗапроса);
		СчетаКассовые = БухгалтерскийУчет.СписокСчетов("201.11,201.21,201.23,201.27,201.34");
	КонецЕсли;	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораСчетов", УсловиеОтбораСчета);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.УстановитьПараметр("ПериодНачало"	, Новый Граница(РеквизитыДокумента.НачалоПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодКонец"		, Новый Граница(РеквизитыДокумента.КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТабШаблона"		, ШаблонЗаменыСчетовиКОСГУ());	
	Запрос.УстановитьПараметр("Счет20521"		, БухгалтерскийУчет.СчетПоКоду("205.21", Период, РеквизитыДокумента.Организация));
	Запрос.УстановитьПараметр("Счет40110"		, БухгалтерскийУчет.СчетПоКоду("401.10", Период, РеквизитыДокумента.Организация));
	Запрос.УстановитьПараметр("КОСГУ120"		, Справочники.КОСГУ.НайтиПоКоду("120"));
	Запрос.УстановитьПараметр("ПустойКФО"		, Перечисления.КВД.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПолучитьОбороты"	, РеквизитыДокумента.КонецПериода > РеквизитыДокумента.НачалоПериода);
	Запрос.УстановитьПараметр("Счет_Кассовые"	, СчетаКассовые);
	
	Результат = Запрос.Выполнить().Выгрузить();	
	
	Если РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОборотов
		И ПоКассовымСчетам Тогда
		ДополнитьДвижениямиПоКассовымСчетам(Результат, Запрос);
	КонецЕсли;
	
	Результат.Колонки.Удалить("ПериодПорядок");
	
	Возврат Результат;	
	
КонецФункции

Процедура ДополнитьДвижениямиПоКассовымСчетам(Таблица, Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.Регистратор КАК Регистратор,
	|	Таблица.КОСГУИсточникДт КАК КОСГУИсточникДт,
	|	Таблица.КОСГУИсточникКт КАК КОСГУИсточникКт,
	|	Таблица.КОСГУПриемникДт КАК КОСГУПриемникДт,
	|	Таблица.КОСГУПриемникКт КАК КОСГУПриемникКт
	|ПОМЕСТИТЬ Табл
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Регистратор КАК Регистратор,
	|	Таблица.КОСГУИсточникДт КАК КОСГУИсточникДт,
	|	Таблица.КОСГУИсточникКт КАК КОСГУИсточникКт,
	|	Таблица.КОСГУПриемникДт КАК КОСГУПриемникДт,
	|	Таблица.КОСГУПриемникКт КАК КОСГУПриемникКт
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	Табл КАК Таблица
	|ГДЕ
	|	Таблица.Регистратор В
	|			(ВЫБРАТЬ
	|				ВТ.Регистратор КАК Регистратор
	|			ИЗ
	|				Табл КАК ВТ
	|			СГРУППИРОВАТЬ ПО
	|				ВТ.Регистратор
	|			ИМЕЮЩИЕ
	|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.Регистратор) = 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Период КАК Период,
	|	Обороты.Регистратор КАК Регистратор,
	|	Обороты.СчетДт КАК СчетДт,
	|	Обороты.СубконтоДт1 КАК СубконтоДт1,
	|	Обороты.СубконтоДт2 КАК СубконтоДт2,
	|	Обороты.СубконтоДт3 КАК СубконтоДт3,
	|	Обороты.СчетКт КАК СчетКт,
	|	Обороты.СубконтоКт1 КАК СубконтоКт1,
	|	Обороты.СубконтоКт2 КАК СубконтоКт2,
	|	Обороты.СубконтоКт3 КАК СубконтоКт3,
	|	Обороты.КПСДт КАК КПСДт,
	|	Обороты.КПСКт КАК КПСКт,
	|	Обороты.КЭКДт КАК КЭКДт,
	|	Обороты.КЭККт КАК КЭККт,
	|	Обороты.ИФО КАК ИФО,
	|	Обороты.ВалютаДт КАК ВалютаДт,
	|	Обороты.ВалютаКт КАК ВалютаКт,
	|	Обороты.ПодразделениеДт КАК ПодразделениеДт,
	|	Обороты.ПодразделениеКт КАК ПодразделениеКт,
	|	Обороты.ЖурналОпераций КАК ЖурналОпераций,
	|	Обороты.КФО КАК КФО,
	|	ЕСТЬNULL(Обороты.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(Обороты.ВалютнаяСуммаДт, 0) КАК ВалютнаяСуммаДт,
	|	ЕСТЬNULL(Обороты.ВалютнаяСуммаКт, 0) КАК ВалютнаяСуммаКт,
	|	ЕСТЬNULL(Обороты.КоличествоДт, 0) КАК КоличествоДт,
	|	ЕСТЬNULL(Обороты.КоличествоКт, 0) КАК КоличествоКт,
	|	ЕСТЬNULL(Обороты.СуммаНеУчитываетсяНУ, 0) КАК СуммаНеУчитываетсяНУ,
	|	ЕСТЬNULL(Обороты.СуммаЕНВД, 0) КАК СуммаЕНВД,
	|	ЕСТЬNULL(Обороты.СуммаНДС, 0) КАК СуммаНДС,
	|	Обороты.Содержание КАК Содержание,
	|	Обороты.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
	|	Обороты.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
	|	Обороты.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	Обороты.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	Обороты.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	Таблица.КОСГУПриемникДт КАК КОСГУПриемникДт,
	|	Таблица.КОСГУПриемникКт КАК КОСГУПриемникКт,
	|	ИСТИНА КАК ЭтоСчетДН,
	|	Обороты.Период КАК ПериодПорядок
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&ПериодНачало,
	|			&ПериодКонец,
	|			Организация = &Организация
	|				И Активность
	|				И (СчетДт В (&Счет)
	|					ИЛИ СчетКт В (&Счет)),
	|			,
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Таблица КАК Таблица
	|		ПО Обороты.Регистратор = Таблица.Регистратор
	|			И (Обороты.КЭКДт = Таблица.КОСГУИсточникДт
	|				ИЛИ Обороты.КЭКДт = Таблица.КОСГУИсточникКт
	|				ИЛИ Обороты.КЭККт = Таблица.КОСГУИсточникКт
	|				ИЛИ Обороты.КЭККт = Таблица.КОСГУИсточникДт)
	|ИТОГИ ПО
	|	Регистратор";
	
	Запрос.УстановитьПараметр("Счет", БухгалтерскийУчет.СписокСчетов("17,18,НД", Запрос.Параметры.Период));
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	ВыборкаДок = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДок.Следующий() Цикл
		
		Выборка = ВыборкаДок.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);	
		КонецЦикла;	
		
	КонецЦикла;
	
	Таблица.Сортировать("ПериодПорядок,Регистратор");
	
КонецПроцедуры

Функция ТекстЗапросаЗаменаКЭКВХарактеристиках(ТекстЗапроса)
	
	Результат = Лев(ТекстЗапроса, СтрНайти(ТекстЗапроса, "&ПолучитьОбороты")-1) + 
	"			&ПолучитьОбороты
	|				И Организация = &Организация
	|				И Активность
	|				И (СчетДт В (&Счет_Кассовые)
	|					ИЛИ СчетКт В (&Счет_Кассовые))
	|				И (ХарактеристикаДвиженияДт В
	|						(ВЫБРАТЬ
	|							Таб.КОСГУИсточник
	|						ИЗ
	|							Шаблон КАК Таб)
	|					ИЛИ ХарактеристикаДвиженияКт В
	|						(ВЫБРАТЬ
	|							Таб.КОСГУИсточник
	|						ИЗ
	|							Шаблон КАК Таб)),
	|			,
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Шаблон КАК ПереводыДт
	|		ПО Обороты.СчетДт = ПереводыДт.СчетПриемник
	|			И (ПереводыДт.КФО = &ПустойКФО
	|				ИЛИ Обороты.КФО = ПереводыДт.КФО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Шаблон КАК ПереводыКт
	|		ПО Обороты.СчетКт = ПереводыКт.СчетПриемник
	|			И (ПереводыКт.КФО = &ПустойКФО
	|				ИЛИ Обороты.КФО = ПереводыКт.КФО)
	|ГДЕ
	|	(НЕ ПереводыДт.СчетПриемник ЕСТЬ NULL
	|			ИЛИ НЕ ПереводыКт.СчетПриемник ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодПорядок,
	|	Регистратор";
	
	Возврат Результат;
	
КонецФункции

