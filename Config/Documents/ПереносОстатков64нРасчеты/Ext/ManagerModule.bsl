#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ВидОперации,Организация,Дата,НачалоПериода,КонецПериода");
	
	ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата);
	Если Не ЗначениеЗаполнено(ДатаПерехода) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента.Вставить("ДатаПерехода", ДатаПерехода);
		
	Если РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОстатков Тогда		
		ТаблицаОстатков = ТаблицаОстатки(РеквизитыДокумента);
		СформироватьДвиженияПоНДСОстатки(ТаблицаОстатков, РеквизитыДокумента, СтруктураДополнительныеСвойства.ТаблицыДляДвижений);
	ИначеЕсли РеквизитыДокумента.ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОборотов Тогда			
		Если НачалоДня(ДатаПерехода) <> НачалоГода(ДатаПерехода) Тогда
			ТаблицаОборотов = ТаблицаОбороты(РеквизитыДокумента, Ложь);
			СформироватьДвиженияПоНДСОбороты(ТаблицаОборотов, РеквизитыДокумента, СтруктураДополнительныеСвойства.ТаблицыДляДвижений);				
		КонецЕсли;		
	КонецЕсли;		
	
КонецПроцедуры

Процедура СформироватьДвиженияПоНДСОстатки(ТаблицаОстатков, РеквизитыДокумента, Движения)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таблица.Счет КАК СчетРасчетов,
	|	Таблица.Субконто1 КАК Контрагент,
	|	Таблица.Субконто2 КАК Договор,
	|	Таблица.КПС КАК КПССчетРасчетов,
	|	Таблица.КФО КАК КФО,
	|	Таблица.СчетПриемник КАК СчетПриемник
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.СчетРасчетов КАК СчетРасчетов,
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.Договор КАК Договор,
	|	Таблица.КПССчетРасчетов КАК КПССчетРасчетов,
	|	Таблица.КФО КАК КФО,
	|	Таблица.СчетПриемник КАК СчетПриемник
	|ПОМЕСТИТЬ НДС_АвансПолученный
	|ИЗ
	|	Таблица КАК Таблица
	|ГДЕ
	|	Таблица.СчетРасчетов В(&Счет_НДСАвансПолученный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.СчетРасчетов КАК СчетРасчетов,
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.Договор КАК Договор,
	|	Таблица.КПССчетРасчетов КАК КПССчетРасчетов,
	|	Таблица.КФО КАК КФО,
	|	Таблица.СчетПриемник КАК СчетПриемник
	|ПОМЕСТИТЬ НДС_Покупка
	|ИЗ
	|	Таблица КАК Таблица
	|ГДЕ
	|	Таблица.СчетРасчетов В(&Счет_НДСПокупка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.СчетРасчетов КАК СчетРасчетов,
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.Договор КАК Договор,
	|	Таблица.КПССчетРасчетов КАК КПССчетРасчетов,
	|	Таблица.КФО КАК КФО,
	|	Таблица.СчетПриемник КАК СчетПриемник
	|ПОМЕСТИТЬ НДС_Исходящий
	|ИЗ
	|	Таблица КАК Таблица
	|ГДЕ
	|	Таблица.СчетРасчетов В(&Счет_НДСИсходящий)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""ВходящийНДС"" КАК ИмяРН,
	|	НДС_Входящий.Организация КАК Организация,
	|	НДС_Входящий.СчетФактура КАК СчетФактура,
	|	НДС_Входящий.ПричинаНалогообложения КАК ПричинаНалогообложения,
	|	НДС_Входящий.ВидЦенности КАК ВидЦенности,
	|	НДС_Входящий.КФО КАК КФО,
	|	НДС_Входящий.СчетРасчетов КАК СчетРасчетов,
	|	НДС_Входящий.КПССчетРасчетов КАК КПССчетРасчетов,
	|	НДС_Входящий.СчетКредита КАК СчетКредита,
	|	НДС_Входящий.ОбъектНалогообложения КАК ОбъектНалогообложения,
	|	НДС_Входящий.СтавкаНДС КАК СтавкаНДС,
	|	НДС_Входящий.ДокументКорректировки КАК ДокументКорректировки,
	|	НДС_Входящий.МестоРегистрации КАК МестоРегистрации,
	|	НДС_Входящий.Сторно КАК Сторно,
