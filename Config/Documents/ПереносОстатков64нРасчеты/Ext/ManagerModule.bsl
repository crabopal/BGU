	|	НДС_Исходящий.СтавкаНДС КАК СтавкаНДС,
	|	НДС_Исходящий.КОСГУСчетДебета КАК КОСГУСчетДебета,
	|	НДС_Исходящий.ДокументКорректировки КАК ДокументКорректировки,
	|	НДС_Исходящий.МестоРегистрации КАК МестоРегистрации,
	|	НДС_Исходящий.Сторно КАК Сторно,
	|	НДС_Исходящий.СуммаБезНДСОстаток КАК СуммаБезНДС,
	|	НДС_Исходящий.СуммаНДСОстаток КАК СуммаНДС,
	|	НДС_Исходящий.СуммаБезНДСВалютнаяОстаток КАК СуммаБезНДСВалютная,
	|	НДС_Исходящий.СуммаНДСВалютнаяОстаток КАК СуммаНДСВалютная
	|ИЗ
	|	РегистрНакопления.ИсходящийНДС.Остатки(
	|			&ДатаЗапроса,
	|			Организация = &Организация
	|				И (СчетФактура.Контрагент, СчетФактура.Договор, СчетРасчетов, КПССчетРасчетов, КФО) В
	|					(ВЫБРАТЬ
	|						Таблица.Контрагент,
	|						Таблица.Договор,
	|						Таблица.СчетРасчетов,
	|						Таблица.КПССчетРасчетов,
	|						Таблица.КФО
	|					ИЗ
	|						НДС_Исходящий КАК Таблица)
	|				И ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансВыданный)) КАК НДС_Исходящий
	|		ЛЕВОЕ СОЕДИНЕНИЕ НДС_Исходящий КАК Таблица
	|		ПО НДС_Исходящий.СчетФактура.Контрагент = Таблица.Контрагент
	|			И НДС_Исходящий.СчетФактура.Договор = Таблица.Договор
	|			И НДС_Исходящий.СчетРасчетов = Таблица.СчетРасчетов
	|			И НДС_Исходящий.КПССчетРасчетов = Таблица.КПССчетРасчетов
	|			И НДС_Исходящий.КФО = Таблица.КФО
	|ГДЕ
	|	(НДС_Исходящий.СуммаБезНДСОстаток <> 0
	|			ИЛИ НДС_Исходящий.СуммаНДСОстаток <> 0
	|			ИЛИ НДС_Исходящий.СуммаНДСВалютнаяОстаток <> 0
	|			ИЛИ НДС_Исходящий.СуммаНДСВалютнаяОстаток <> 0)";
	
	
	ДатаОстатков = НачалоГода(РеквизитыДокумента.ДатаПерехода);
	
	ПериодДвижений = ДатаОстатков - 1;
	
	Счет_НДСАвансПолученный	= БухгалтерскийУчет.СписокСчетов("205.2А,205.3А,205.7А,205.8А,209.7А,209.8А");
	Счет_НДСПокупка			= БухгалтерскийУчет.СписокСчетов("302.00");
	Счет_НДСИсходящий		= БухгалтерскийУчет.СписокСчетов("206.00");

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаЗапроса"				, ДатаОстатков);
	Запрос.УстановитьПараметр("Организация"				, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Таблица"					, ТаблицаОстатков);
	Запрос.УстановитьПараметр("Счет_НДСАвансПолученный"	, Счет_НДСАвансПолученный);
	Запрос.УстановитьПараметр("Счет_НДСПокупка"			, Счет_НДСПокупка);
	Запрос.УстановитьПараметр("Счет_НДСИсходящий"		, Счет_НДСИсходящий);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Движения.Вставить("ВходящийНДС"					, РегистрыНакопления.ВходящийНДС.СоздатьНаборЗаписей().Выгрузить());
	Движения.Вставить("ВходящийНДСКРаспределению"	, РегистрыНакопления.ВходящийНДСКРаспределению.СоздатьНаборЗаписей().Выгрузить());
	Движения.Вставить("ИсходящийНДС"				, РегистрыНакопления.ИсходящийНДС.СоздатьНаборЗаписей().Выгрузить());
	
	Для Сч = 4 По 5 Цикл
		
		Выборка = Результат[Сч].Выбрать();
		Пока Выборка.Следующий() Цикл
			// Сторно по прежнему счету
			НоваяЗапись = Движения[Выборка.ИмяРН].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.Период = ПериодДвижений;
			НоваяЗапись.Активность = Истина;
			
			НоваяЗапись.СуммаБезНДС = - НоваяЗапись.СуммаБезНДС;
			НоваяЗапись.СуммаНДС    = - НоваяЗапись.СуммаНДС;
			
			НоваяЗапись.СуммаБезНДСВалютная = - НоваяЗапись.СуммаБезНДСВалютная;
			НоваяЗапись.СуммаНДСВалютная    = - НоваяЗапись.СуммаНДСВалютная;
			
			// Движение по новому счету
			НоваяЗапись = Движения[Выборка.ИмяРН].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.Период = ПериодДвижений;
			НоваяЗапись.Активность = Истина;
			
			НоваяЗапись.СчетРасчетов = Выборка.СчетПриемник;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура СформироватьДвиженияПоНДСОбороты(ТаблицаОборотов, РеквизитыДокумента, Движения)

	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все обороты регистра бухгалтерии по счетам расчетов
	|//
	|ВЫБРАТЬ
	|	Таблица.Регистратор КАК Регистратор,
	|	Таблица.СчетДт КАК СчетДт,
