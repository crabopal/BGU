	|	НДС_ВходящийКРаспределению.ОбъектНалогообложения,
	|	НДС_ВходящийКРаспределению.СтавкаНДС,
	|	НДС_ВходящийКРаспределению.ДокументКорректировки,
	|	НДС_ВходящийКРаспределению.МестоРегистрации,
	|	НДС_ВходящийКРаспределению.Сторно,
	|	НДС_ВходящийКРаспределению.СуммаБезНДСОстаток,
	|	НДС_ВходящийКРаспределению.СуммаНДСОстаток,
	|	НДС_ВходящийКРаспределению.СуммаБезНДСВалютнаяОстаток,
	|	НДС_ВходящийКРаспределению.СуммаНДСВалютнаяОстаток,
	|	Таблица.СчетПриемник
	|ИЗ
	|	РегистрНакопления.ВходящийНДСКРаспределению.Остатки(
	|			&ДатаЗапроса,
	|			Организация = &Организация
	|				И (СчетФактура.Контрагент, СчетФактура.Договор, СчетРасчетов, КПССчетРасчетов, КФО) В
	|					(ВЫБРАТЬ
	|						Таблица.Контрагент,
	|						Таблица.Договор,
	|						Таблица.СчетРасчетов,
	|						Таблица.КПССчетРасчетов,
	|						Таблица.КФО
	|					ИЗ
	|						НДС_АвансПолученный КАК Таблица)
	|				И ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)) КАК НДС_ВходящийКРаспределению
	|		ЛЕВОЕ СОЕДИНЕНИЕ НДС_АвансПолученный КАК Таблица
	|		ПО НДС_ВходящийКРаспределению.СчетФактура.Контрагент = Таблица.Контрагент
	|			И НДС_ВходящийКРаспределению.СчетФактура.Договор = Таблица.Договор
	|			И НДС_ВходящийКРаспределению.СчетРасчетов = Таблица.СчетРасчетов
