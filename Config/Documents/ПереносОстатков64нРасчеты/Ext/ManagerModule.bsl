	|	ИсходящийНДС.СуммаБезНДС КАК СуммаБезНДС,
	|	ИсходящийНДС.СуммаНДС КАК СуммаНДС,
	|	ИсходящийНДС.СуммаБезНДСВалютная КАК СуммаБезНДСВалютная,
	|	ИсходящийНДС.СуммаНДСВалютная КАК СуммаНДСВалютная,
	|	НДС_Исходящий.СчетПриемник КАК СчетПриемник
	|ИЗ
	|	РегистрНакопления.ИсходящийНДС КАК ИсходящийНДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ НДС_Исходящий КАК НДС_Исходящий
	|		ПО ИсходящийНДС.ОбъектНалогообложения = НДС_Исходящий.Регистратор
	|ГДЕ
	|	ИсходящийНДС.ОбъектНалогообложения В
	|			(ВЫБРАТЬ
	|				ВТ.Регистратор
	|			ИЗ
	|				НДС_Исходящий КАК ВТ)
	|	И НЕ ТИПЗНАЧЕНИЯ(ИсходящийНДС.Регистратор) = Тип(Документ.ПереносОстатков64нРасчеты)
	|;";
	
	Счет_НДСАвансПолученный	= БухгалтерскийУчет.СписокСчетов("205.2А,205.3А,205.7А,205.8А,209.7А,209.8А");
	Счет_НДСИсходящий		= БухгалтерскийУчет.СписокСчетов("206.00");
	Счет_Кассовые			= БухгалтерскийУчет.СписокСчетов("201.11,201.21,201.23,201.27,201.34");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация"				, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Таблица"					, ТаблицаОборотов);
	Запрос.УстановитьПараметр("Счет_НДСАвансПолученный"	, Счет_НДСАвансПолученный);
	Запрос.УстановитьПараметр("Счет_НДСИсходящий"		, Счет_НДСИсходящий);
	Запрос.УстановитьПараметр("Счет_Кассовые"			, Счет_Кассовые);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Движения.Вставить("ВходящийНДС"					, РегистрыНакопления.ВходящийНДС.СоздатьНаборЗаписей().Выгрузить());
	Движения.Вставить("ВходящийНДСКРаспределению"	, РегистрыНакопления.ВходящийНДСКРаспределению.СоздатьНаборЗаписей().Выгрузить());
	Движения.Вставить("ИсходящийНДС"				, РегистрыНакопления.ИсходящийНДС.СоздатьНаборЗаписей().Выгрузить());
	
	Период = НачалоДня(РеквизитыДокумента.ДатаПерехода) - 1;
	
	Для Сч = 4 По 5 Цикл
		
		Выборка = Результат[Сч].Выбрать();
		Пока Выборка.Следующий() Цикл
			// Сторно по прежнему счету
			НоваяЗапись = Движения[Выборка.ИмяРН].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.Период = Период;
			НоваяЗапись.Активность = Истина;
			
			НоваяЗапись.СуммаБезНДС = - НоваяЗапись.СуммаБезНДС;
			НоваяЗапись.СуммаНДС    = - НоваяЗапись.СуммаНДС;
			
			НоваяЗапись.СуммаБезНДСВалютная = - НоваяЗапись.СуммаБезНДСВалютная;
			НоваяЗапись.СуммаНДСВалютная    = - НоваяЗапись.СуммаНДСВалютная;
			
			// Движение по новому счету
			НоваяЗапись = Движения[Выборка.ИмяРН].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.Период = Период;
			НоваяЗапись.Активность = Истина;
			
			НоваяЗапись.СчетРасчетов = Выборка.СчетПриемник;
		КонецЦикла;	
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

