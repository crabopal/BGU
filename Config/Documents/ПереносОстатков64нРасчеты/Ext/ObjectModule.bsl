#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЗаполнитьПериодыОборотов();
	
	Для Каждого ТаблицаДвижений Из Движения Цикл
		ТаблицаДвижений.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
	КонецЦикла;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Проведен Тогда
		ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ЭтоПереносОборотов = (ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОборотов
		Или ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.СторнированиеНачисленийАрендодателя
		Или ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ЗаменаКЭКВХарактеристиках);
	
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Дата) И ЗначениеЗаполнено(ВидОперации) Тогда	
		
		ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(Организация, Дата);
		
		Если Не ЗначениеЗаполнено(ДатаПерехода) Тогда
			ТекстОшибки = Нстр("ru = 'Для выбранной организации не задана дата перехода на приказ 64н'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
			ЭтоПереносОборотов = Ложь;
		ИначеЕсли НачалоДня(ДатаПерехода) = НачалоГода(ДатаПерехода) И ЭтоПереносОборотов Тогда
			ТекстОшибки = Нстр("ru = 'Приказ 64 применяется с начала года, обороты не переносятся'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
			ЭтоПереносОборотов = Ложь;
		Иначе
			ЗаполнитьПериодыОборотов(ДатаПерехода);
		КонецЕсли;
		
	Иначе
		
		ЭтоПереносОборотов = Ложь;
		
	КонецЕсли;
	
	Если ЭтоПереносОборотов Тогда
		
		Если НачалоПериода < НачалоГода(ДатаПерехода) Тогда
			ТекстОшибки = Нстр("ru = 'Дата начала переноса оборотов должна быть с '") + Формат(НачалоГода(ДатаПерехода), "ДЛФ=D");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Объект.НачалоПериода",, Отказ);
		КонецЕсли;		
				
		Если КонецПериода >= ДатаПерехода Тогда
			ТекстОшибки = Нстр("ru = 'Дата окончания переноса оборотов должна быть до '") + Формат(ДатаПерехода, "ДЛФ=D");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Объект.КонецПериода",, Отказ);
		КонецЕсли;		
		
		Если Не Отказ И НачалоПериода > КонецПериода Тогда
			ТекстОшибки = Нстр("ru = 'Дата окончания переноса должна быть больше или равна дате начала.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Объект.КонецПериода",, Отказ);					
		КонецЕсли;
		
		Если Не Отказ И ЕстьПересечениеПериодов() Тогда
			ТекстОшибки = Нстр("ru = 'За период, указанный в документе, обороты уже перенесены.
				|Периоды документов по переносу оборотов не должны пересекаться.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Объект.НачалоПериода",, Отказ);	
		КонецЕсли;
		
	Иначе
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("НачалоПериода"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("КонецПериода"));
		
	КонецЕсли;			
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьПересечениеПериодов()
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ПереносОстатков64нРасчеты.НачалоПериода, ДЕНЬ) КАК ДатаНачала,
	|	КОНЕЦПЕРИОДА(ПереносОстатков64нРасчеты.КонецПериода, ДЕНЬ) КАК ДатаКонца
	|ИЗ
	|	Документ.ПереносОстатков64нРасчеты КАК ПереносОстатков64нРасчеты
	|ГДЕ
	|	ПереносОстатков64нРасчеты.Ссылка <> &Ссылка
	|	И ПереносОстатков64нРасчеты.Организация = &Организация
	|	И ПереносОстатков64нРасчеты.ВидОперации = &ВидОперации
	|	И ПереносОстатков64нРасчеты.Проведен
	|	И (&НачалоПериодаДока >= НАЧАЛОПЕРИОДА(ПереносОстатков64нРасчеты.НачалоПериода, ДЕНЬ)
	|				И &НачалоПериодаДока <= КОНЕЦПЕРИОДА(ПереносОстатков64нРасчеты.КонецПериода, ДЕНЬ)
	|			ИЛИ &КонецПериодаДока >= НАЧАЛОПЕРИОДА(ПереносОстатков64нРасчеты.НачалоПериода, ДЕНЬ)
	|				И &КонецПериодаДока <= КОНЕЦПЕРИОДА(ПереносОстатков64нРасчеты.КонецПериода, ДЕНЬ)
	|			ИЛИ &НачалоПериодаДока <= НАЧАЛОПЕРИОДА(ПереносОстатков64нРасчеты.НачалоПериода, ДЕНЬ)
	|				И &КонецПериодаДока >= КОНЕЦПЕРИОДА(ПереносОстатков64нРасчеты.КонецПериода, ДЕНЬ))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка"				, Ссылка);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ВидОперации"			, ВидОперации);
	Запрос.УстановитьПараметр("НачалоПериодаДока"	, НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериодаДока"	, КонецДня(КонецПериода));
	
	ЕстьДок = Не Запрос.Выполнить().Пустой();

	Возврат ЕстьДок;

КонецФункции	

Функция ЗаполнитьПериодыОборотов(ДатаПерехода = Неопределено)
	
	Если ВидОперации = Перечисления.ОперацииПереносОстатков64нРасчеты.ПереносОстатков Тогда
		НачалоПериода = '00010101';
		КонецПериода = '00010101';
	ИначеЕсли Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		пДатаПерехода = ?(ДатаПерехода = Неопределено, БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(Организация, Дата), ДатаПерехода);
		Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
			НачалоПериода = НачалоГода(пДатаПерехода);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(КонецПериода) Тогда
			КонецПериода = ?(ЗначениеЗаполнено(пДатаПерехода), НачалоДня(пДатаПерехода)-1, пДатаПерехода);  	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли