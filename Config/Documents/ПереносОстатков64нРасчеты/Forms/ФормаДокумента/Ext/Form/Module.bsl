#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ШаблонЗаменыКФО");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ШаблонЗамены.КФО", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<все>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ГруппаПериодПереноса.Видимость = (Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатков64нРасчеты.ПереносОстатков"));
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанные()
	
	Данные = Документы.ПереносОстатков64нРасчеты.ШаблонЗаменыСчетовиКОСГУ();
	
	ШаблонЗамены.Очистить();
	Для Каждого ТекСтрока Из Данные Цикл
		НоваяСтрока = ШаблонЗамены.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьДатуДокументаСервер(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РедакцияПС", Перечисления.РедакцииПланаСчетов.Приказ64н2018);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДатыПереходаНаПрименениеРедакцийПС.ДатаНачалаПрименения КАК ДатаНачалаПрименения
	|ИЗ
	|	РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС КАК ДатыПереходаНаПрименениеРедакцийПС
	|ГДЕ
	|	ДатыПереходаНаПрименениеРедакцийПС.Организация = &Организация
	|	И ДатыПереходаНаПрименениеРедакцийПС.РедакцияПС = &РедакцияПС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ДатаНачалаПрименения;
	Иначе
		Результат = '00010101';
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтразитьВидимостьДатыПС()
	
	Элементы.ДатаПС.Видимость = ЗначениеЗаполнено(ДатаПС);
	Элементы.ДатаПСЗадать.Видимость = Не ЗначениеЗаполнено(ДатаПС);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИПеречитатьДанные(Настройки); 
	
	УправлениеПечатью.ЗаписатьМакет(Настройки.ИмяОбъектаМетаданныхМакета,
		ПоместитьВоВременноеХранилище(Настройки.ТабличныйДокумент));
	
	ПрочитатьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Выбор, ДопПараметры) Экспорт
	
	Если ТипЗнч(Выбор) = Тип("Структура") Тогда
		Объект.НачалоПериода = Выбор.НачалоПериода;
		Объект.КонецПериода = Выбор.КонецПериода;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчаниюЗавершение(Ответ, Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьПользовательскиеПравилаЗамены();
		Элементы.ШаблонЗаменыНастройкиПоУмолчанию.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПользовательскиеПравилаЗамены()
	
	МенеджерЗаписи = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = "Документ.ПереносОстатков64нРасчеты";
	МенеджерЗаписи.ИмяМакета = "ШаблонПоУмолчанию";
	МенеджерЗаписи.Удалить();
	
	ПрочитатьДанные();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьПользовательскиеПравилаЗамены()
	
	МенеджерЗаписи = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = "Документ.ПереносОстатков64нРасчеты";
	МенеджерЗаписи.ИмяМакета = "ШаблонПоУмолчанию";
	МенеджерЗаписи.Прочитать();
	
	Возврат МенеджерЗаписи.Выбран();	
	
КонецФункции

