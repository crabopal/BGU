#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Договор") Тогда
		
		Договор = ДанныеЗаполнения.Договор;
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Организация,Контрагент");
		Организация = ?(ДанныеЗаполнения.Свойство("Организация"), ДанныеЗаполнения.Организация, РеквизитыДоговора.Организация);
		Контрагент  = ?(ДанныеЗаполнения.Свойство("Контрагент"),  ДанныеЗаполнения.Контрагент,  РеквизитыДоговора.Контрагент);
		
		Если ДанныеЗаполнения.Свойство("ВалютаДокумента") Тогда
			ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
		КонецЕсли;
		
		ВидГрафика = ?(ДанныеЗаполнения.Свойство("ВидГрафика"), ДанныеЗаполнения.ВидГрафика, "");
		
		Если ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			ЗаполнитьПоДоговору(ДанныеЗаполнения.Договор, ДанныеЗаполнения.ДокументОснование, ВидГрафика);
		Иначе
			ЗаполнитьПоДоговору(ДанныеЗаполнения.Договор, Неопределено, ВидГрафика);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Договоры") Тогда
		
		Договор = ДанныеЗаполнения;
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Организация,Контрагент");
		Организация = РеквизитыДоговора.Организация;
		Контрагент  = РеквизитыДоговора.Контрагент;
		
		ЗаполнитьПоДоговору(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияГрафиковИсполненияДоговоров") Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДанныеЗаполнения, "Организация,Контрагент,Договор,ВалютаДокумента");
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования);
		ЗаполнитьПоДоговору(РеквизитыОснования.Договор);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='В конфигурации отключены ведение и контроль исполнения графиков по договорам с контрагентами.
			|Для включения необходимо перейти в раздел 
			|""Администрирование"" - ""Настройки параметров учета"" - ""Ведение учета""'"), Ссылка, , , Отказ);
		Возврат;
	КонецЕсли;
	
	ЗаполненыСуммыКорректировки = Ложь;
	Для Каждого СтрокаТаблицы Из ГрафикПлатежей Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаВВалюте) Тогда
			ЗаполненыСуммыКорректировки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ГрафикИсполнения Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаВВалюте) Тогда
			ЗаполненыСуммыКорректировки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗаполненыСуммыКорректировки Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Укажите суммы платежей (обязательств) согласно графикам, установленным договором.'"), Ссылка, , , Отказ);
	КонецЕсли;
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	Если Не КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора) Тогда
		НепроверяемыеРеквизиты.Добавить("ГрафикПлатежей.КЭК");
		НепроверяемыеРеквизиты.Добавить("ГрафикИсполнения.КЭК");
	КонецЕсли;
	Если Не КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора) Тогда
		НепроверяемыеРеквизиты.Добавить("ГрафикПлатежей.ДопКлассификация");
		НепроверяемыеРеквизиты.Добавить("ГрафикПлатежей.КодМероприятия");
		НепроверяемыеРеквизиты.Добавить("ГрафикПлатежей.КодЦели");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") И Не ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	СуммаДокумента = ГрафикПлатежей.Итог("СуммаВВалюте") + ГрафикИсполнения.Итог("СуммаВВалюте");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоДоговору(Договор, ОснованиеЗаполнения = Неопределено, ВидГрафика = "")
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ЗаполнитьГрафикиИсполненияПоДоговору(ЭтотОбъект, Договор, ОснованиеЗаполнения, ВидГрафика);
	
КонецПроцедуры

#КонецОбласти 

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
