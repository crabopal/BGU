&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	ЗапомнитьПараметрыГрафиковВКэшеФормы();
	УстановитьВидимостьРеквизитов();
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитов()
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ВестиГрафикПлатежей = ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей;
		ВестиПланГрафикИсполнения  = ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения;
		ВидДоговора = ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора;
	Иначе
		ВестиГрафикПлатежей = Истина;
		ВестиПланГрафикИсполнения = Истина;
		ВидДоговора = Неопределено;
	КонецЕсли;
	
	ЗапомнитьПараметрыГрафиковВКэшеФормы();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейСкорректироватьГрафикПлатежейАвтоматически", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ДоступнаАвтокорректировкаГрафикаПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияСкорректироватьГрафикИсполненияАвтоматически", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ДоступнаАвтокорректировкаГрафикаИсполнения);
	
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график реализации'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график реализации'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный план-график реализации. Если полный график реализации на данный момент неизвестен, можно ввести данные об известных очередных отгрузках, либо ввести сводные данные об ожидаемых отгрузках (по месяцам, кварталам и т.п.). План-график реализации можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график закупок'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график закупок'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный план-график закупок. Если полный график закупок на данный момент неизвестен, можно ввести данные об известных очередных поставках, либо ввести сводные данные об ожидаемых закупках (по месяцам, кварталам и т.п.). График закупок можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график исполнения'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график исполнения'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный график исполнения договора (реализации, закупок). График исполнения можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	КонецЕсли;
	
	ВидимостьКонструктораГрафиков = (ВестиГрафикПлатежей ИЛИ ВестиПланГрафикИсполнения)
		И НЕ ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей
		И НЕ ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КнопкаКонструкторГрафиковИсполненияДоговоров", "Видимость", ВидимостьКонструктораГрафиков);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КнопкаКонструкторГрафиковИсполненияДоговоров", "Доступность", ВидимостьКонструктораГрафиков И Не ТолькоПросмотр);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДоговорВестиГрафикПлатежей", "Видимость",
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДоговорВестиПланГрафикИсполнения", "Видимость",
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	
	ЭлементыДоПослеИзменений = Новый Массив;
	ЭлементыДоПослеИзменений.Добавить("ГрафикПлатежейСуммаВВалютеДоИзменений");
	ЭлементыДоПослеИзменений.Добавить("ГрафикПлатежейСуммаВВалютеПослеИзменений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДоПослеИзменений, "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	
	ЭлементыДоПослеИзменений = Новый Массив;
	ЭлементыДоПослеИзменений.Добавить("ГрафикИсполненияСуммаВВалютеДоИзменений");
	ЭлементыДоПослеИзменений.Добавить("ГрафикИсполненияСуммаВВалютеПослеИзменений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДоПослеИзменений, "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейСуммаВВалюте", "Заголовок",
			?(ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей, НСтр("ru = 'Изменение'"), НСтр("ru = 'Сумма'")));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияСуммаВВалюте", "Заголовок",
			?(ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения, НСтр("ru = 'Изменение'"), НСтр("ru = 'Сумма'")));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВалютаДокумента", "ТолькоПросмотр",
		ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей
		ИЛИ ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейЗаполнитьГрафикПлатежей", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияЗаполнитьГрафикИсполнения", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	
	ИспользоватьДетализациюПоКОСГУВГрафиках = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора);
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКЭК");
	ЭлементыДопАналитика.Добавить("ГрафикИсполненияКЭК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", ИспользоватьДетализациюПоКОСГУВГрафиках);
	
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора);
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейДопКлассификация");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодМероприятия");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодЦели");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуПланированиеИКонтроль(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
