&НаСервере
Процедура СформироватьГрафикиИсполненияПоДоговоруНаСервере(ПараметрыГрафиков)
	
	// График платежей.
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
		Документы.РегистрацияГрафиковИсполненияДоговоров.ЗаполнитьГрафикПлатежейПоПараметрам(Объект, ПараметрыГрафиков,
			УчетРасчетовКлиентСервер.ДопустимыеСчетаРасчетовПоВидуДоговора(ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора));
	КонецЕсли;
	
	// График исполнения.
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		Документы.РегистрацияГрафиковИсполненияДоговоров.ЗаполнитьГрафикИсполненияПоПараметрам(Объект, ПараметрыГрафиков,
			УчетРасчетовКлиентСервер.ДопустимыеСчетаРасчетовПоВидуДоговора(ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьИзмененияВГрафике(ИмяТаблицы)
	
	Для Каждого СтрокаГрафика Из Объект[ИмяТаблицы] Цикл
		Если СтрокаГрафика.СуммаВВалюте <> 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОчиститьИзмененияГрафика(ТабличнаяЧастьГрафик, ТолькоСуммыИзменений)
	
	Если ТолькоСуммыИзменений Тогда // Очищаем суммы изменений.
		
		СтрокиКУдалению = Новый Массив;
		Для Каждого СтрокаГрафика Из ТабличнаяЧастьГрафик Цикл
			Если СтрокаГрафика.ЗапретИзменения Тогда
				СтрокаГрафика.СуммаВВалюте = 0;
				СтрокаГрафика.СуммаВВалютеПослеИзменений =
					СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
			Иначе
				СтрокиКУдалению.Добавить(СтрокаГрафика);
			КонецЕсли;
		КонецЦикла;
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ТабличнаяЧастьГрафик.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	Иначе // Очищаем весь график.
		ТабличнаяЧастьГрафик.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкорректироватьГрафикАвтоматическиНаСервере(ИмяТаблицы)
	
	ОчиститьИзмененияГрафика(Объект[ИмяТаблицы], Истина);
	
	КонтрольИсполненияДоговоров.СкорректироватьГрафикАвтоматически(Объект, ИмяТаблицы, ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	
	ИтогоИзменениеСуммаВВалюте = Объект[ИмяТаблицы].Итог("СуммаВВалюте");
	Если ИтогоИзменениеСуммаВВалюте <> 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось распределить сумму %1 по датам %2 автоматически!'"),
			ОбщегоНазначенияБГУ.ФорматСумм(ИтогоИзменениеСуммаВВалюте),
			?(ИмяТаблицы = "ГрафикПлатежей", НСтр("ru = 'оплаты'"), НСтр("ru = 'исполнения'")));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект");
		ОчиститьИзмененияГрафика(Объект[ИмяТаблицы], Истина);
	КонецЕсли;
	
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СчетПоКЭК(Знач КЭК, ДопустимыеСчета, Знач НаДату, Знач Организация, Знач ИФО)
	
	Возврат БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(КЭК, ДопустимыеСчета, , НаДату, Организация, ИФО);
	
КонецФункции

&НаСервере
Процедура ЗаписанНовыйДокумент()
	
	ЗапомнитьПараметрыГрафиковВКэшеФормы();
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПараметрыГрафиковВКэшеФормы()
	
	СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор,
		"Долгосрочный, ВидДоговора, ВестиГрафикПлатежей, ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидДоговора", СтруктураРеквизитов.ВидДоговора);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", СтруктураРеквизитов.ВестиГрафикПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", СтруктураРеквизитов.ВестиПланГрафикИсполнения);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДопустимыеСчетаПоВидуДоговора",
		УчетРасчетовКлиентСервер.ДопустимыеСчетаРасчетовПоВидуДоговора(СтруктураРеквизитов.ВидДоговора));
	
	ДоступнаАвтокорректировкаГрафикаПлатежей = Ложь;
	ЕстьСуммыДоИзмененийВГрафикеПлатежей = Ложь;
	Для Каждого СтрокаГрафика Из Объект.ГрафикПлатежей Цикл
		Если СтрокаГрафика.СуммаВВалютеДоИзменений <> 0 Тогда
			ЕстьСуммыДоИзмененийВГрафикеПлатежей = Истина;
			ДоступнаАвтокорректировкаГрафикаПлатежей = ДоступнаАвтокорректировкаГрафикаПлатежей ИЛИ (СтрокаГрафика.СуммаВВалютеДоИзменений < 0);
		КонецЕсли;
	КонецЦикла;
	ДоступнаАвтокорректировкаГрафикаИсполнения = Ложь;
	ЕстьСуммыДоИзмененийВГрафикеИсполнения = Ложь;
	Для Каждого СтрокаГрафика Из Объект.ГрафикИсполнения Цикл
		Если СтрокаГрафика.СуммаВВалютеДоИзменений <> 0 Тогда
			ЕстьСуммыДоИзмененийВГрафикеИсполнения = Истина;
			ДоступнаАвтокорректировкаГрафикаИсполнения = ДоступнаАвтокорректировкаГрафикаИсполнения ИЛИ (СтрокаГрафика.СуммаВВалютеДоИзменений < 0);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьСуммыДоИзмененийВГрафикеПлатежей",       ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьСуммыДоИзмененийВГрафикеИсполнения",     ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоступнаАвтокорректировкаГрафикаПлатежей",   ДоступнаАвтокорректировкаГрафикаПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоступнаАвтокорректировкаГрафикаИсполнения", ДоступнаАвтокорректировкаГрафикаИсполнения);
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда		
		ЭтоДолгосрочныйДоговор 	= СтруктураРеквизитов.Долгосрочный;
		ЭтоСПокупателем 		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		ЭтоСПоставщиком 		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		ЭтоСоглашениеОСубсидии 	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
		ЭтоПредоставленныйЗаем 	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит);
		ЭтоПолученныйКредит 	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
		ЭтоВыпускЦенныхБумаг 	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

