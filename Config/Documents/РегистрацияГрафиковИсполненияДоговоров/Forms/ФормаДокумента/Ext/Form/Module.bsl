		ТекстВопроса = НСтр("ru = 'Изменения плана-графика закупок, реализации, исполнения будут очищены. Продолжить?'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросСкорректироватьГрафикИсполненияАвтоматическиЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СкорректироватьГрафикАвтоматическиНаСервере("ГрафикИсполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСкорректироватьГрафикИсполненияАвтоматическиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СкорректироватьГрафикАвтоматическиНаСервере("ГрафикИсполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонструкторГрафиковИсполненияДоговоров(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Договор", Объект.Договор);
	ПараметрыФормы.Вставить("Валюта", Объект.ВалютаДокумента);
	ПараметрыФормы.Вставить("ДопустимыеСчета", ЭтотОбъект.КэшПараметров.Локальные.ДопустимыеСчетаПоВидуДоговора);
	ПараметрыФормы.Вставить("ВидДокумента", "РегистрацияГрафиковИсполненияДоговоров");
	
	ГрафикПлатежейИтог = Объект.ГрафикПлатежей.Итог("СуммаВВалюте");
	ГрафикИсполненияИтог = Объект.ГрафикИсполнения.Итог("СуммаВВалюте");
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей
		И ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		СуммаПоДоговору = ?(ГрафикПлатежейИтог = ГрафикИсполненияИтог, ГрафикПлатежейИтог, 0);
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
		СуммаПоДоговору = ГрафикПлатежейИтог;
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		СуммаПоДоговору = ГрафикИсполненияИтог;
	КонецЕсли;
	ПараметрыФормы.Вставить("СуммаПоДоговору", СуммаПоДоговору);
	
	ОткрытьФорму("Документ.РегистрацияГрафиковИсполненияДоговоров.Форма.КонструкторГрафиковИсполненияДоговоров",
		ПараметрыФормы, ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
