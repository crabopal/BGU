&НаКлиенте
Процедура ЗаполнитьГрафикПлатежей(Команда)
	
	ТекстВопроса = "";
	Если ЕстьИзмененияВГрафике("ГрафикПлатежей") Тогда
		Если ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей Тогда
			ТекстВопроса = НСтр("ru = 'Изменения графика платежей будут очищены.'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Данные на закладке ""График платежей"" будут очищены.'");
		КонецЕсли;
	КонецЕсли;
	Если Объект.Проведен Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Проведение документа будет отменено.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьГрафикПлатежейЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьГрафикПлатежейНаСервере();
	КонецЕсли;
	
КонецПроцедуры

