	ТекущиеДанные = Элементы.Ассигнования.ТекущиеДанные;
	
	ГруппаОтбора = Неопределено;
	
	Если Объект.ДетализацияПолученныхДанных
		И ЗначениеЗаполнено(ТекущиеДанные.КПСГруппа)
		И Объект.ВидДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
		ГруппаОтбора = ТекущиеДанные.КПСГруппа;
	КонецЕсли;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПС, 
													Объект.Организация,
													Объект.ИФО,
													,
													Объект.ВидДанных,
													Объект.Дата,
													ГруппаОтбора);
	
