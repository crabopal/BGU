&НаСервереБезКонтекста
Функция ПолучитьУчетнуюПолитику(Знач Организация, Дата)
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация,Дата);
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьРукводителяОрганизации(Знач Организация, Дата)
	
	Возврат ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Организация,Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,Дата);
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыОрганизации(Знач Организация, Дата)
	
	РеквизитыОрганизации = Новый Структура;
	РеквизитыОрганизации.Вставить("УчетнаяПолитика",	ПолучитьУчетнуюПолитику(Организация, Дата));
	РеквизитыОрганизации.Вставить("Руководитель",		ПолучитьРукводителяОрганизации(Организация, Дата));
	
	Возврат РеквизитыОрганизации;
	
КонецФункции	

&НаСервереБезКонтекста
Функция СформироватьСписокСсылокКОСГУ(ВидДанных)
	
	СписокКодов = "000";
	СписокКодовГрупп = "000";
	
	Если ВидДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
		
		СписокКодов = "200,300,310,320,330,340,500,530";
		
		СписокКодовГрупп = "000,200,210,220,230,240,250,260,300,500";
		
	ИначеЕсли ВидДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда
		
		СписокКодов = "310,410,500,520,540,550,600,620,630,640,650,700,710,720,800,810,820"; 
		
		СписокКодовГрупп = "000,300,400,500,600,700,800"; 
		
	КонецЕсли;	
	
    СпискиДопустимыхКОСГУ = Новый Структура;
	
	СписокСсылок = ПлатежноРасчетныеДокументыПовтИсп.СформироватьСписокСсылокПоКодуОбъекта("Справочник.КОСГУ", СписокКодов, Истина); 
	СписокСсылок.Вставить(0, БухгалтерскийУчетПовтИсп.КЭК0());
	
	СпискиДопустимыхКОСГУ.Вставить("Список", СписокСсылок);
	
	СпискиДопустимыхКОСГУ.Вставить("СписокГрупп", ПлатежноРасчетныеДокументыПовтИсп.СформироватьСписокСсылокПоКодуОбъекта("Справочник.КОСГУ",СписокКодовГрупп));
	
	Возврат СпискиДопустимыхКОСГУ;
	
КонецФункции	

&НаКлиенте
Процедура УстановитьБюджетныеПолномочия()
	
	Элементы.ВидДанных.СписокВыбора.Очистить();
	
	Если УчетнаяПолитика.ПолномочияГРБС или УчетнаяПолитика.ПолномочияРБС или УчетнаяПолитика.ПолномочияПБС Тогда
		Элементы.ВидДанных.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"), "Данные по расходам бюджета");	
	КонецЕсли;
	Если УчетнаяПолитика.ПолномочияГАИВФ ИЛИ УчетнаяПолитика.ПолномочияАИВФ 
		ИЛИ УчетнаяПолитика.ПолномочияГАИВнФ ИЛИ УчетнаяПолитика.ПолномочияАИВнФ Тогда 
		Элементы.ВидДанных.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"), "Данные по источникам финансирования дефицита бюджета");	
	КонецЕсли;	
	
	Элементы.Распорядитель.СписокВыбора.Очистить();
	Элементы.Распорядитель.СписокВыбора.Добавить(Объект.Организация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыРазделаЛицевогоСчета(Знач РазделЛицевогоСчета)
	
	РеквизитыРаздела = Новый Структура;
	
	РеквизитыРаздела.Вставить("ЛицевойСчет",РазделЛицевогоСчета.Владелец);
	
	РеквизитыРаздела.Вставить("Казначейства",ПлатежноРасчетныеДокументыПовтИсп.ПолучитьКазначействаЛицевогоСчета(РазделЛицевогоСчета.Владелец));
	
	Возврат РеквизитыРаздела;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьКассовыйОрганПолучателя(Знач СчетПолучателя)
	КассовыйОрган = Новый СписокЗначений;
	РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетПолучателя, "КассовыйОрган,ТипЛицевогоСчета");
	Если РеквизитыСчета.ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Казначейский") Тогда
		КассовыйОрган.Добавить(РеквизитыСчета.КассовыйОрган);
	КонецЕсли;	
	Возврат КассовыйОрган.ВыгрузитьЗначения();
КонецФункции

&НаКлиенте
Процедура ОчиститьКОСГУ_КПС()
	Для Каждого Стр Из Объект.Ассигнования Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Если СписокДопустимыхГруппКОСГУ.НайтиПоЗначению(Стр.КОСГУГруппа) = Неопределено Тогда
			Стр.КОСГУГруппа = "";
		КонецЕсли;
		
		Стр.КПС = "";
		Стр.КПСГруппа = "";
	КонецЦикла;	
	Для Каждого Стр Из Объект.ЛБО Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Стр.КПС = "";
		Стр.КПСГруппа = "";
	КонецЦикла;	
	Для Каждого Стр Из Объект.ПОФ Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Стр.КПС = "";
	КонецЦикла;	
	
КонецПРоцедуры	

&НаКлиенте
Процедура ПриИзмененииЛицевогоСчета()
	
	Если НЕ ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		Объект.ЛицевойСчет		 		= "";
		Объект.ЛицевойСчетПБС			= "";
		Объект.РазделЛицевогоСчетаПБС 	= "";
		Объект.ОрганКазначейства 		= "";
		Объект.ОрганКазначействаКуда	= "";
		Объект.Распорядитель			= "";
		
		Элементы.ОрганКазначейства.СписокВыбора.Очистить();
		Элементы.ОрганКазначействаКуда.СписокВыбора.Очистить();
		Возврат;
		
	КонецЕсли;
	
	РеквизитыРазделаЛицевогоСчета	= ПолучитьРеквизитыРазделаЛицевогоСчета(Объект.РазделЛицевогоСчета);
	
	Объект.ЛицевойСчет 				= РеквизитыРазделаЛицевогоСчета.ЛицевойСчет;
	Элементы.ОрганКазначейства.СписокВыбора.ЗагрузитьЗначения(РеквизитыРазделаЛицевогоСчета.Казначейства);
	
	Если Объект.ДоведениеДанныхСебеКакПБС Тогда
		
		Объект.ЛицевойСчетПБС 			= Объект.ЛицевойСчет;
		
		Объект.РазделЛицевогоСчетаПБС	= Объект.РазделЛицевогоСчета;
		
		Элементы.ОрганКазначействаКуда.СписокВыбора.ЗагрузитьЗначения(РеквизитыРазделаЛицевогоСчета.Казначейства);
		
	КонецЕсли;	
	
КонецПРоцедуры	

&НаКлиенте
Процедура ПриИзмененииФлагаДетализации()
	
	Элементы.ДоведениеДанныхСебеКакПБС.Видимость	= НЕ Объект.ДетализацияПолученныхДанных;
	Элементы.АссигнованияКОСГУГруппа.Видимость		= Объект.ДетализацияПолученныхДанных;
	Элементы.ЛБОКОСГУГруппа.Видимость				= Объект.ДетализацияПолученныхДанных;
	Элементы.АссигнованияКПСГруппа.Видимость		= Объект.ДетализацияПолученныхДанных;
	Элементы.ЛБОКПСГруппа.Видимость					= Объект.ДетализацияПолученныхДанных;
	
	УстановитьСтраницуПанелиКуда();
	
	Если Объект.ДетализацияПолученныхДанных Тогда
		
		Элементы.СчетОткуда.Видимость = Ложь;
		
	Иначе
		
		Элементы.СчетОткуда.Видимость = Истина;
		
	КонецЕсли;	
	
КонецПРОцедуры	

&НаКлиенте
Процедура УстановитьДоступностьПодразделенияИЛицСчета()

	Элементы.Подразделение.Доступность 	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЛицевойСчет.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьПодразделения()

&НаКлиенте
Процедура УстановитьСтраницуПанелиКуда()
	
	Если Объект.ДоведениеДанныхСебеКакПБС ИЛИ Объект.ДетализацияПолученныхДанных Тогда
		
		Элементы.КудаКонтрагентОрганизация.ТекущаяСтраница = Элементы.КудаОрганизация;
		
	Иначе
		
		Элементы.КудаКонтрагентОрганизация.ТекущаяСтраница = Элементы.КудаКонтрагент;
		
	КонецЕсли;
	
КонецПРоцедуры


