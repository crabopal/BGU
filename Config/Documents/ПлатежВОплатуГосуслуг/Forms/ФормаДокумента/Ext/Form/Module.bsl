&НаКлиенте
Процедура НачислениеНажатие(Элемент, СтандартнаяОбработка)
	
	Если Начисление = "<Распределить платежи>" Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Участник,Платеж",Объект.Организация,Объект.Ссылка);
		ОткрытьФорму("Обработка.РаспределениеПлатежейГИСГМП.Форма.Форма",ПараметрыФормы,ЭтотОбъект);
				
	ИначеЕсли Начисление = "<Без начисления>" Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Платеж",Объект.Ссылка));
		ОткрытьФорму("РегистрСведений.СоответствиеНачисленийИПлатежей.Форма.ФормаСписка",ПараметрыФормы,ЭтотОбъект);
		
	Иначе
		
		ПоказатьЗначение(Неопределено, Начисление);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

