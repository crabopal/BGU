			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПлатежВОплатуГосуслуг.Ссылка КАК Ссылка,
	ДокументПлатежВОплатуГосуслуг.ВерсияДанных КАК ВерсияДанных,
	ДокументПлатежВОплатуГосуслуг.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПлатежВОплатуГосуслуг.Номер КАК Номер,
	ДокументПлатежВОплатуГосуслуг.Дата КАК Дата,
	ДокументПлатежВОплатуГосуслуг.Проведен КАК Проведен,
	ДокументПлатежВОплатуГосуслуг.Организация КАК Организация,
	ДокументПлатежВОплатуГосуслуг.ИФО КАК ИФО,
	ДокументПлатежВОплатуГосуслуг.Подразделение КАК Подразделение,
	ДокументПлатежВОплатуГосуслуг.Комментарий КАК Комментарий,
	ДокументПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления,
	ДокументПлатежВОплатуГосуслуг.УникальныйИдентификаторЗаявки КАК УникальныйИдентификаторЗаявки,
	ДокументПлатежВОплатуГосуслуг.СуммаДокумента КАК СуммаДокумента,
	ДокументПлатежВОплатуГосуслуг.НазначениеПлатежа КАК НазначениеПлатежа,
	ДокументПлатежВОплатуГосуслуг.ИдентификаторПлательщика КАК ИдентификаторПлательщика,
	ДокументПлатежВОплатуГосуслуг.СтатусСоставителя КАК СтатусСоставителя,
	ДокументПлатежВОплатуГосуслуг.КодОКАТО КАК КодОКАТО,
	ДокументПлатежВОплатуГосуслуг.КодБКПлатежа КАК КодБКПлатежа,
	ДокументПлатежВОплатуГосуслуг.ПоказательТипа КАК ПоказательТипа,
	ДокументПлатежВОплатуГосуслуг.ПоказательОснования КАК ПоказательОснования,
	ДокументПлатежВОплатуГосуслуг.ПоказательПериода КАК ПоказательПериода,
	ДокументПлатежВОплатуГосуслуг.ПоказательНомера КАК ПоказательНомера,
	ДокументПлатежВОплатуГосуслуг.ПоказательДаты КАК ПоказательДаты,
	ДокументПлатежВОплатуГосуслуг.БанкПлательщика КАК БанкПлательщика,
	ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
	ДокументПлатежВОплатуГосуслуг.Номенклатура КАК Номенклатура,
	ДокументПлатежВОплатуГосуслуг.Плательщик КАК Плательщик,
	ДокументПлатежВОплатуГосуслуг.МоментВремени КАК МоментВремени,
	ВЫБОР
		КОГДА ПОДСТРОКА(ДокументПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления, 2, 1) = ""
				И ПОДСТРОКА(ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа, 2, 1) &lt;&gt; ""
			ТОГДА "Авансовый"
		КОГДА ПОДСТРОКА(ДокументПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления, 2, 1) &lt;&gt; ""
				И ПОДСТРОКА(ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа, 2, 1) &lt;&gt; ""
			ТОГДА "По начислению"
		ИНАЧЕ ""
	КОНЕЦ КАК ВидПлатежа,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
