#Область СлужебныеПроцедурыИФункции

Процедура УстановитьСоответствиеНачисленийПлатежей() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежВОплатуГосуслуг.Ссылка КАК Ссылка,
		|	ПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления
		|ПОМЕСТИТЬ НераспределенныеПлатежи
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ПО (СоответствиеНачисленийИПлатежей.Платеж = ПлатежВОплатуГосуслуг.Ссылка)
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление ЕСТЬ NULL
		|	И ПОДСТРОКА(ПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления, 2, 1) <> """"
		|	И ПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежаЗаполнен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НераспределенныеПлатежи.Ссылка КАК Платеж,
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Начисление,
		|	ИСТИНА КАК БанковскийИдентификаторПлатежаЗаполнен
		|ИЗ
		|	НераспределенныеПлатежи КАК НераспределенныеПлатежи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|		ПО НераспределенныеПлатежи.УникальныйИдентификаторНачисления = КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления
		|			И (КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ)";

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,ВыборкаДетальныеЗаписи);
		Запись.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры

