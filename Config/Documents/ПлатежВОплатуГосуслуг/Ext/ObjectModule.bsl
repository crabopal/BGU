#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Перем СуммаВозвратаИзменилась;
	
#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ)
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("УстановитьВСоответствиеНачисление") Тогда
		ГосУслуги.УстановитьВСоответствиеНачисление(ЭтотОбъект.Ссылка);
	КонецЕсли;
	
	НачислениеПоПлатежу = Неопределено;
	НужноПолучитьНачисление = Ложь;
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроверитьСтатусИсполнения")
		ИЛИ СуммаВозвратаИзменилась = Истина Тогда
		НужноПолучитьНачисление = Истина;
	КонецЕсли;
	
	Если НужноПолучитьНачисление Тогда
		НачислениеПоПлатежу = РегистрыСведений.СоответствиеНачисленийИПлатежей.ПолучитьНачислениеПоПлатежу(ЭтотОбъект.Ссылка);
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроверитьСтатусИсполнения") Тогда
		ГосУслуги.ПроверитьИсполнениеКвитанции(НачислениеПоПлатежу);
	КонецЕсли;
	
	Если СуммаВозвратаИзменилась = Истина
		И ЗначениеЗаполнено(НачислениеПоПлатежу) Тогда
		МассивНачислений = Новый Массив;
		МассивНачислений.Добавить(НачислениеПоПлатежу);
		РегистрыСведений.СоответствиеНачисленийИПлатежей.ОбновитьСуммыНачислений(МассивНачислений);
	КонецЕсли;	

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	СуммаВозвратаИзменилась = Ложь;
	
	//заполним обязательный признак
	БанковскийИдентификаторПлатежаЗаполнен = ЗначениеЗаполнено(БанковскийИдентификаторПлатежа);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если СтатусПлатежа = 3 Тогда
		//Платеж аннулирован
		СуммаДокумента = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда
		ПрошлаяСуммаВозврата = 0;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПлатежВОплатуГосуслуг.СуммаВозврата КАК СуммаВозврата
			|ИЗ
			|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
			|ГДЕ
			|	ПлатежВОплатуГосуслуг.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
        	ПрошлаяСуммаВозврата = ВыборкаДетальныеЗаписи.СуммаВозврата;
		КонецЕсли;
		
		Если ЭтотОбъект.СуммаВозврата <> ПрошлаяСуммаВозврата Тогда
			СуммаВозвратаИзменилась = Истина;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

