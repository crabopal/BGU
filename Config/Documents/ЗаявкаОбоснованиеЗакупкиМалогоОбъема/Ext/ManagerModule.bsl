	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ВЫБОР
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.Номенклатура.НаименованиеПолное = """"
	|				ТОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.Номенклатура.Наименование
	|			ИНАЧЕ ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.Номенклатура.НаименованиеПолное
	|		КОНЕЦ КАК НоменклатураПредставление,
	|		(ВЫРАЗИТЬ(ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.ОКПД.НаименованиеПолное КАК СТРОКА(1024))) + "" ("" + ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.ОКПД.Код + "")"" КАК ОКПДПредставление,
	|		ВЫБОР
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов)
	|				ТОГДА """"
	|			ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.ЕдиницаИзмерения)
	|		КОНЕЦ КАК ЕдиницаИзмерения,
	|		ВЫБОР
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов)
	|				ТОГДА 0
	|			ИНАЧЕ ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.Количество
	|		КОНЕЦ КАК Количество,
	|		ВЫБОР
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов)
	|				ТОГДА 0
	|			ИНАЧЕ ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.Цена
	|		КОНЕЦ КАК Цена,
	|		Сумма КАК Сумма,
	|		ФинансовыйГод КАК ФинансовыйГод,
	|		КФО КАК КФО,
	|		ЕстьNULL(Ссылка.Организация.КодПоППП.Код, ""000"") + КПС.Код КАК КБК,
	|		КЭК КАК КОСГУ,
	|		ВЫБОР
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов)
	|				ТОГДА """"
	|			КОГДА ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.НаличиеЛБО
	|				ТОГДА ""есть""
	|			ИНАЧЕ ""нет""
	|		КОНЕЦ КАК НаличиеЛБО,
	|		ДополнительнаяИнформация КАК ДополнительнаяИнформация
	|	) КАК ТоварыРаботыУслуги,
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Задолженность.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Валюта КАК Валюта,
	|		Валюта.Код КАК ВалютаКод,
	|		Сумма КАК Сумма,
	|		СуммаРуб КАК СуммаРуб,
	|		СуммаНаПроверке КАК СуммаНаПроверке,
	|		СуммаНаПроверкеРуб КАК СуммаНаПроверкеРуб,
	|		СуммаПросроченная КАК СуммаПросроченная,
	|		СуммаПросроченнаяРуб КАК СуммаПросроченнаяРуб
	|	) КАК Задолженность
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема КАК ЗаявкаОбоснованиеЗакупкиМалогоОбъема
	|ГДЕ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъема.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		Сотрудники = Новый Массив;
		Сотрудники.Добавить(СтруктураДанных.ПодотчетноеЛицо);
		Сотрудники.Добавить(СтруктураДанных.Руководитель);
		Сотрудники.Добавить(СтруктураДанных.РуководительПодразделения);
		Сотрудники.Добавить(СтруктураДанных.ОтветственныйФинЭкономПодразделения);
		Сотрудники.Добавить(СтруктураДанных.ОтветственныйКонтрактнойСлужбы);
		Сотрудники.Добавить(СтруктураДанных.ОтветственныйИсполнительБух);
		
		ТребуемыеДанные = Новый Массив;
		ТребуемыеДанные.Добавить("Фамилия");
		ТребуемыеДанные.Добавить("Имя");
		ТребуемыеДанные.Добавить("Отчество");
		ТребуемыеДанные.Добавить("Должность");
		
		ДанныеСотрудников = Справочники.Сотрудники.ПолучитьДанныеСотрудников(Сотрудники, ТребуемыеДанные, СтруктураДанных.Дата);
		
		СтруктрураФИО = Новый Структура;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ПодотчетноеЛицо) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.ПодотчетноеЛицо, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("СотрудникФамилия", 			ДанныеСотрудника.Фамилия);
			СтруктураДанных.Вставить("СотрудникИмя", 				ДанныеСотрудника.Имя);
			СтруктураДанных.Вставить("СотрудникОтчество", 			ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("СотрудникДолжность", 			ДанныеСотрудника.ДолжностьНаименование);
			СтруктураДанных.Вставить("СотрудникИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.Руководитель) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.Руководитель, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("РуководительИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("РуководительДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.РуководительПодразделения) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.РуководительПодразделения, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("РуководительПодразделенияИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("РуководительПодразделенияДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.ОтветственныйФинЭкономПодразделения) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.ОтветственныйФинЭкономПодразделения, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("ОтветственныйФЭПИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("ОтветственныйФЭПДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.ОтветственныйКонтрактнойСлужбы) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.ОтветственныйКонтрактнойСлужбы, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("ОтветственныйКонтрактнойСлужбыИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("ОтветственныйКонтрактнойСлужбыДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.ОтветственныйИсполнительБух) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.ОтветственныйИсполнительБух, "Ссылка");
			СтруктрураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктрураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктрураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("ОтветственныйИсполнительБухИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("ОтветственныйИсполнительБухДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.Дата);
		СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
		
		СтруктураДанных.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.Номер);
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ИтогоСумма = 0;
		
		СтрокиФинансовоеОбоснование = СтруктураДанных.ТоварыРаботыУслуги.Выбрать();
		Пока СтрокиФинансовоеОбоснование.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаФинансовоеОбоснование.Параметры, СтрокиФинансовоеОбоснование);
			ТабличныйДокумент.Вывести(ОбластьСтрокаФинансовоеОбоснование);
			ИтогоСумма = ИтогоСумма + СтрокиФинансовоеОбоснование.Сумма;
		КонецЦикла;
		
		ОбластьИтогоФинансовоеОбоснование.Параметры.ИтогоСумма = ИтогоСумма;
		ТабличныйДокумент.Вывести(ОбластьИтогоФинансовоеОбоснование);
		
		ОбластьПодвалФинансовоеОбоснование.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалФинансовоеОбоснование);
		
		ОбластьШапкаСведенияОМалойЗакупке.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаСведенияОМалойЗакупке);
		
		// Страница 2 выводится только при оплате через подотчетное лицо
		ОплатаЧерезПодотчетноеЛицо = СтруктураДанных.ВидОплаты <> ПредопределенноеЗначение("Перечисление.ВидыОплатыЗакупок.ПоСчету");
		
		Если ОплатаЧерезПодотчетноеЛицо Тогда
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ОбластьШапкаПодотчетноеЛицо.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьШапкаПодотчетноеЛицо);
			
			СтрокиЗадолженность = СтруктураДанных.Задолженность.Выбрать();
			
			Если СтрокиЗадолженность.Количество() = 0 Тогда
				ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьВсегоПервая);
				ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
				ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
			КонецЕсли;
			
			НомерОбхода = 0;
			Пока НомерОбхода < 3 Цикл
				НомерОбхода = НомерОбхода + 1;
				Пока СтрокиЗадолженность.Следующий() Цикл
					Если НомерОбхода = 1 Тогда
						ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьВсегоПервая, ОбластьСтрокаЗадолженностьВсего);
						ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
						Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
							ОбластьЗадолженность.Параметры.СуммаВал = 0;
						Иначе
							ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.Сумма;
						КонецЕсли;
						ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаРуб;
						ТабличныйДокумент.Вывести(ОбластьЗадолженность);
					ИначеЕсли НомерОбхода = 2 И СтрокиЗадолженность.СуммаНаПроверкеРуб <> 0 Тогда
						ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьНаПроверкеПервая, ОбластьСтрокаЗадолженностьНаПроверке);
						ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
						Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
							ОбластьЗадолженность.Параметры.СуммаВал = 0;
						Иначе
							ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаНаПроверке;
						КонецЕсли;
						ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаНаПроверкеРуб;
						ТабличныйДокумент.Вывести(ОбластьЗадолженность);
					ИначеЕсли НомерОбхода = 3 И СтрокиЗадолженность.СуммаПросроченнаяРуб <> 0 Тогда
						ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьПросроченнаяПервая, ОбластьСтрокаЗадолженностьПросроченная);
						ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
						Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
							ОбластьЗадолженность.Параметры.СуммаВал = 0;
						Иначе
							ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаПросроченная;
						КонецЕсли;
						ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаПросроченнаяРуб;
						ТабличныйДокумент.Вывести(ОбластьЗадолженность);
					КонецЕсли;
				КонецЦикла;
				СтрокиЗадолженность.Сбросить();
			КонецЦикла;
			
			ОбластьПодвалЗадолженность.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьПодвалЗадолженность);
			
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
