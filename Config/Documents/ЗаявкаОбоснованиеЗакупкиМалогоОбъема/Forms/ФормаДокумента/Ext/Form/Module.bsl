	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	ТекущаяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
	ТекущаяСтрока.ФинансовыйГод = Год(Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСпособОбеспеченияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	Если ТекущиеДанные.СпособОбеспечения =
		ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов")
		И ПустаяСтрока(ТекущиеДанные.ДополнительнаяИнформация) Тогда
		ТекущиеДанные.ДополнительнаяИнформация = НСтр("ru = 'денежные документы'");
	ИначеЕсли ТекущиеДанные.СпособОбеспечения <>
		ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов")
		И ТекущиеДанные.ДополнительнаяИнформация = НСтр("ru = 'денежные документы'") Тогда
		ТекущиеДанные.ДополнительнаяИнформация = "";
	КонецЕсли;
	
