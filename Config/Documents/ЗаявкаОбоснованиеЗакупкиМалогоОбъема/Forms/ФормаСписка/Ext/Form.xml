			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Ссылка КАК Ссылка,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Номер КАК Номер,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Дата КАК Дата,
	ВЫБОР
		КОГДА ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Проведен КАК Проведен,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Организация КАК Организация,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ИФО КАК ИФО,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Подразделение КАК Подразделение,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеВид КАК ДокументОснованиеВид,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеДата КАК ДокументОснованиеДата,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ПодотчетноеЛицо КАК ПодотчетноеЛицо,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Руководитель КАК Руководитель,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.РуководительПодразделения КАК РуководительПодразделения,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОтветственныйФинЭкономПодразделения КАК ОтветственныйФинЭкономПодразделения,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОтветственныйКонтрактнойСлужбы КАК ОтветственныйКонтрактнойСлужбы,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ОтветственныйИсполнительБух КАК ОтветственныйИсполнительБух,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Комментарий КАК Комментарий,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Ответственный КАК Ответственный,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.СрокВыдачиДней КАК СрокВыдачиДней,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ВидОплаты КАК ВидОплаты,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.СтатусЗакупки КАК СтатусЗакупки,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.НаименованиеЗакупки КАК НаименованиеЗакупки,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.НомерЗакупки КАК НомерЗакупки,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ДатаРазмещенияЗакупки КАК ДатаРазмещенияЗакупки,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Договор КАК Договор,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Номенклатура КАК Номенклатура,
		ОКПД КАК ОКПД,
		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		Количество КАК Количество,
		Цена КАК Цена,
		Сумма КАК Сумма,
		ФинансовыйГод КАК ФинансовыйГод,
		КФО КАК КФО,
		КПС КАК КПС,
		КЭК КАК КЭК,
		НаличиеЛБО КАК НаличиеЛБО,
		ДополнительнаяИнформация КАК ДополнительнаяИнформация,
		СпособОбеспечения КАК СпособОбеспечения,
		КодЦели КАК КодЦели,
		КодМероприятия КАК КодМероприятия,
		ДопКлассификация КАК ДопКлассификация,
		Подразделение КАК Подразделение
	) КАК ТоварыРаботыУслуги,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.Задолженность.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Валюта КАК Валюта,
		Сумма КАК Сумма,
		СуммаРуб КАК СуммаРуб,
		СуммаНаПроверке КАК СуммаНаПроверке,
		СуммаНаПроверкеРуб КАК СуммаНаПроверкеРуб,
		СуммаПросроченная КАК СуммаПросроченная,
		СуммаПросроченнаяРуб КАК СуммаПросроченнаяРуб
	) КАК Задолженность,
	ДокументЗаявкаОбоснованиеЗакупкиМалогоОбъема.МоментВремени КАК МоментВремени,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
