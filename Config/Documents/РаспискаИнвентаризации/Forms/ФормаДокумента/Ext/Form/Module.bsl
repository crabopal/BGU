&НаСервере
Процедура НастроитьФормуСерверПоКодуФормыОписи()
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	СтрокаТаблицыНастроек = ИнвентаризацияСервер.ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(Объект.ДокументОписи, ТаблицаНастроек);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтрокаТаблицыНастроек, "СодержаниеРасписки,НаименованиеОписи");
	
КонецПроцедуры

#Область ПанельОписи

&НаСервере
Процедура НастроитьПанельОписиСервер()
	
	ИнвентаризацияСервер.НастроитьПанельОписиНаФормеРасписки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьЗаписиДокумента()
	
	ЗапретитьЗапись = Объект.Ссылка.Пустая() И Не Параметры.СозданиеИзФормыОписи;
	
	Элементы.ГруппаПояснения.Видимость = ЗапретитьЗапись;
	
	Если ЗапретитьЗапись Тогда
		ОчищающаяСтруктура = Новый Структура("
			|Организация,
			|ДокументОписи,
			|Сотрудник");
		
		ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

