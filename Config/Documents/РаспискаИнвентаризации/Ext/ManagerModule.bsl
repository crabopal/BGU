Функция ПолучитьПечатныеФормыРасписокДляОписей(МассивОписей) Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Опись");
	Таблица.Колонки.Добавить("Расписка",					Новый ОписаниеТипов("ДокументСсылка.РаспискаИнвентаризации"));
	Таблица.Колонки.Добавить("ТабличныйДокументРасписки",	Новый ОписаниеТипов("ТабличныйДокумент"));
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивОписей", МассивОписей);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ДокументОписи		КАК ДокументОписи,
	|	ДокументРасписки	КАК ДокументРасписки
	|ИЗ
	|	РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок
	|ГДЕ
	|	ДокументОписи В(&МассивОписей)";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаРасписок = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаРасписок.Индексы.Добавить("ДокументОписи");
	
	МассивРасписок = ТаблицаРасписок.ВыгрузитьКолонку("ДокументРасписки");
	
	Данные = ПолучитьДанныеДляПечати(МассивРасписок);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	СтандартныеПараметры = Новый Структура();
	
	Поиск = Новый Структура("ДокументОписи");
	
	СтрокаШапкиОтсутствующейРасписки = Новый Структура("
		|Ссылка,
		|Дата,
		|Номер,
		|Организация,
		|КодФормыОписи,
		|ДокументОписи,
		|ДокументОписиНомер,
		|ДокументОписиДата,
		|Сотрудник,
		|ДатаОпределенияСведений");
	
	Для Каждого Опись Из МассивОписей Цикл
		Поиск.ДокументОписи = Опись;
		
		МассивСтрок = ТаблицаРасписок.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Расписка = МассивСтрок[0].ДокументРасписки;
		Иначе
			Расписка = Неопределено;
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Опись = Опись;
		НоваяСтрока.Расписка = Расписка;
		
		МассивСтрок = Данные.ТаблицаПечати.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаШапки = СтрокаШапкиОтсутствующейРасписки;
		Иначе
			СтрокаШапки = МассивСтрок[0];
		КонецЕсли;
		
		ТабДокумент = СформироватьПечатнуюФормуРасписки(СтрокаШапки, Данные, СтандартныеПараметры, ТаблицаНастроек);
		
		НоваяСтрока.ТабличныйДокументРасписки = ТабДокумент;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

