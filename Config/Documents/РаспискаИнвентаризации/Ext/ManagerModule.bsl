Функция ПечатьРасписки(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	СтандартныеПараметры = Новый Структура();
	СтандартныеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	СтандартныеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	СтандартныеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	СтандартныеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	СтандартныеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	Данные = ПолучитьДанныеДляПечати(МассивОбъектов);
	
	КлючПараметровПечати = "ПечатьРаспискиИнвентаризации";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ОбщийТабДокумент.Автомасштаб = Истина;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные.ТаблицаПечати Цикл
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ТабДокумент = СформироватьПечатнуюФормуРасписки(СтрокаШапки, Данные, СтандартныеПараметры, ТаблицаНастроек);
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			СтрокаШапки.Ссылка);
			
	КонецЦикла;
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуРасписки(СтрокаШапки, Данные, СтандартныеПараметры, ТаблицаНастроек)
	
	КлючПараметровПечати = "ПечатьРаспискиИнвентаризации";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.Автомасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РаспискаИнвентаризации.ПФ_MXL_РаспискаИнвентаризации");
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Заголовок",		Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("Расписка",		Макет.ПолучитьОбласть("Расписка"));
	
	СтрокаТаблицыНастроек = ИнвентаризацияСервер.ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(СтрокаШапки.ДокументОписи, ТаблицаНастроек);
	
	// ЗАГОЛОВОК
	
	Если ЗначениеЗаполнено(СтрокаШапки.ДокументОписи) Тогда
		Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.ДокументОписи,
			СтрокаШапки.ДокументОписиНомер);
	Иначе
		Номер = "";
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НаименованиеДокумента", СтрокаТаблицыНастроек.НаименованиеОписи);
	ЗначенияПараметров.Вставить("Дата", Формат(СтрокаШапки.ДокументОписиДата, "ДФ=""дд ММММ гггг"""));
	ЗначенияПараметров.Вставить("Номер", Номер);
	
	Область = ОбластиМакета["Заголовок"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАСПИСКА
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("СодержаниеРасписки", СтрокаТаблицыНастроек.СодержаниеРасписки);
	ЗначенияПараметров.Вставить("НаименованиеПодписи", СтрокаТаблицыНастроек.НаименованиеПодписиДляРасписки);
	
	Область = ОбластиМакета["Расписка"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ПолучитьДанныеСотрудника(СтрокаШапки, Данные));
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("ПустаяДата", '00010101');
	ЗапросПечать.Текст = "
	|ВЫБРАТЬ
	|	Ссылка										КАК Ссылка,
	|	Дата										КАК Дата,
	|	Номер										КАК Номер,
	|	Организация									КАК Организация,
	|	КодФормыОписи								КАК КодФормыОписи,
	|	ДокументОписи								КАК ДокументОписи,
	|	ЕСТЬNULL(ДокументОписи.Номер, """")			КАК ДокументОписиНомер,
	|	ЕСТЬNULL(ДокументОписи.Дата, &ПустаяДата)	КАК ДокументОписиДата,
	|	Сотрудник									КАК Сотрудник,
	|	Дата										КАК ДатаОпределенияСведений
	|ИЗ
	|	Документ.РаспискаИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаПечати = ЗапросПечать.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаПечати",		ТаблицаПечати);
	Данные.Вставить("ДанныеСотрудников",	ПолучитьДанныеСотрудников(ТаблицаПечати));
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеСотрудников(ТаблицаПечати)
	
	ВремТаблица = ТаблицаПечати.Скопировать(, "ДатаОпределенияСведений");
	ВремТаблица.Свернуть("ДатаОпределенияСведений");
	
	ДатыОпределенияСведений = ВремТаблица.ВыгрузитьКолонку("ДатаОпределенияСведений");
	
	Результат = Новый Соответствие();
	
	Для Каждого Дата Из ДатыОпределенияСведений Цикл
		ПорцияСведений = ИнвентаризацияСервер.ПолучитьПорциюСведенийСотрудниковНаДату(ТаблицаПечати, Дата);
		
		Результат.Вставить(Дата, ПорцияСведений);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСотрудника(СтрокаШапки, Данные)
	
	ДанныеСотрудника = Новый Структура("Должность,РасшифровкаПодписи");
	
	ТаблицаНаДату = Данные.ДанныеСотрудников.Получить(СтрокаШапки.ДатаОпределенияСведений);
	
	Если ТаблицаНаДату = Неопределено Тогда
		Возврат ДанныеСотрудника;
	КонецЕсли;
	
	Поиск = Новый Структура("Ссылка", СтрокаШапки.Сотрудник);
	
	МассивСтрок = ТаблицаНаДату.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат ДанныеСотрудника;
	КонецЕсли;
	
	СтрокаТаблицы = МассивСтрок[0];
	
	ДанныеСотрудника.Должность			= СтрокаТаблицы.ДолжностьНаименование;
	ДанныеСотрудника.РасшифровкаПодписи	= СтрокаТаблицы.НаименованиеПолное;
	
	Возврат ДанныеСотрудника;
	
КонецФункции

#КонецОбласти

