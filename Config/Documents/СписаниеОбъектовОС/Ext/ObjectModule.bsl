#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Возвращает таблицу значений по данным табличной части документа для формирования резерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений И Дата < '20210101' Тогда
		НеПроверяемыеРеквизиты.Добавить("ЦМО");
	КонецЕсли;
	
	СписокСчетов = ОсновныеСредства.ВыгрузитьКолонку("СчетУчета");
	СвойстваСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокСчетов, "УчетПоКПС");
	УчетПоКПС = Ложь;
	Для Каждого ДанныеСчета Из СвойстваСчетов Цикл
		Если ДанныеСчета.Значение Тогда
			УчетПоКПС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не УчетПоКПС Тогда
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.КПС");
	КонецЕсли;
	Если Не БухгалтерскийУчет.ПодразделениеОбязательно(СписокСчетов) Тогда
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
	КонецЕсли;
	
	НеПроверяемыеРеквизиты.Добавить(?(КФОВТабличнойЧасти, "КФО","ОсновныеСредства.КФО"));
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	ШаблонСообщения1 = НСтр("ru = 'В строке %1 не заполнена карточка капвложений'");
	Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) И СтрокаТаблицы.Количество>1 Тогда
			ТекстПредупреждения = НСтр("ru='Для объектов с присвоенным инвентарным номером количество должно быть равно 1.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,
				"Объект.ОсновныеСредства["+(СтрокаТаблицы.НомерСтроки-1)+"].Количество",,Отказ);
		КонецЕсли;
		
		Если СтрокаТаблицы.ОтразитьВКарточкеКапвложений
			И ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(СтрокаТаблицы.СчетУчета) 
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КарточкаКапвложений) Тогда

			Отказ = Истина;
			ТекстСообщения1 = СтрШаблон(ШаблонСообщения1, СтрокаТаблицы.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения1, Ссылка, 
				"ОсновныеСредства[" + ОсновныеСредства.Индекс(СтрокаТаблицы) + "].КарточкаКапвложений", "Объект");
		КонецЕсли;	
	КонецЦикла;
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС
		И ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет Тогда
		ПринятьНаХранение	= Ложь;
		ЦМОПолучатель		= Справочники.ЦМО.ПустаяСсылка();
		Контрагент			= Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Если ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет
		И ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении Тогда
		ВосстановитьНаБалансе = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Комиссия) Тогда
		Председатель = Справочники.Сотрудники.ПустаяСсылка();
		Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
			СтрокаКомиссии.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
			СтрокаКомиссии.Отсутствует = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	Если ОсновныеСредства.Количество() <> 0 Тогда
		ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ОсновныеСредства");
		ПрослеживаемостьБГУ.СписаниеОСПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	КонецЕсли;	

	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	Если НЕ Резервировать Тогда
		ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") И ДанныеЗаполнения.ВводНаОсновании
			И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			
			СтандартнаяОбработка = Ложь;
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
				ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения);
			Иначе	
				ЗаполнитьНаОсновании_РешениеОПрекращенииПризнанияАктивом(ДанныеЗаполнения);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	Если НЕ ПринятьНаХранение И НЕ ВосстановитьНаБалансе И НЕ ВключатьМЦВСоставКапвложений Тогда
	
		ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
		ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
		
		ЭтоСписаниеКапвложений = 
			ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		
		ВедетсяУчетДрагМатериаловВМЦКапвложений = ЭтоСписаниеКапвложений И
			(ДрагоценныеМатериалы.Количество() > 0 ИЛИ УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений());
	
		ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер");
		
		ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
		ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		
		Если ЭтоСписаниеКапвложений Тогда
			МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
		Иначе
			МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
		КонецЕсли;
		
		Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
			Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
				НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЦикла;	
		
		Для Каждого ТекСтрока Из ОбъектыДМ Цикл
			ОбъектНФА = ТекСтрока.ОбъектНФА;
			ИнвНомер = ТекСтрока.ИнвНомер;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
			ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
			НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

			Если НайденныеСтроки.Количество() = 0 Тогда
				ПараметрыОтбораОбъекта = Новый Структура;
				ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
				ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
				СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
				Если СтрокиСпискаДМ.Количество()=1 Тогда
					ТекстСтрокиДМ = "В строке ";
				Иначе
					ТекстСтрокиДМ = "В строках ";
				КонецЕсли;
				Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
					ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
				КонецЦикла;	
				
				ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОбъектНФА,
					ИнвНомер);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
				
			КонецЕсли;	
		КонецЦикла;	
		
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
		Для каждого ТекСтрока Из ОбъектыДМ Цикл
			//заполнение количества драг. камней
			Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
				ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			КонецЕсли;	
		КонецЦикла;
		
		//контроль содержания учетных драг. материалов в списываемых НФА
		Запрос = Новый Запрос;
		Запрос.Текст = УчетДрагМатериалов.ТекстЗапросаПроверкиЗаполненияСодержанияДрагМатериаловКапвложений(ВедетсяУчетДрагМатериаловВМЦКапвложений);
		
		Если ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда 
			
			ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ОбъектМЦ, МассаДМ, КоличествоДМ");   
			
			Капвложения = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, Количество");
			Капвложения.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
			
			ТаблицаОбъектовНФА = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Организация,Капвложения, Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
			
		Иначе
			ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер, МассаДМ, КоличествоДМ");  
			
			ТаблицаОбъектовНФА = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
		Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
			Если ЭтоСписаниеКапвложений Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта  вложений ""%1"" из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов по материальной ценности ""%2"". Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ОбъектМЦ);
			Иначе
				ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ИнвНомер);
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
		КонецЦикла;	
	Иначе
		Если ДрагоценныеМатериалы.Количество()>0 Тогда
			ТекстОшибки = НСтр("ru='На закладке ""Драгоценные материалы"" заполнен список драгоценных материалов, которые будут списаны для НФА принятых на хранение или восстановленных на балансе. Если драг. материалы не списываются, то следует очистить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗаполнитьНаОсновании_РешениеОПрекращенииПризнанияАктивом(ДанныеЗаполнения)
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	Решение = ДанныеЗаполнения.ДокументОснование;
	ЕстьРешениеОПрекращенииПризнанияАктивом = Истина;
	КФОВТабличнойЧасти = Истина;
	ДанныеРешения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Решение, "Дата, Организация");
	Счета = Документы.СписаниеОбъектовОС.СчетаУчетаОСПоВидуОперацииИИмущества(
		ДанныеРешения.Организация, ДанныеРешения.Дата, ВидОперации, ВидИмущества);
		
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Решение.Дата КАК Дата,
	|	Решение.Номер КАК Номер,
	|	Решение.Организация КАК Организация,
	|	Решение.ИФО КАК ИФО,
	|	Решение.ЦМО КАК ЦМО,
	|	Решение.Подразделение КАК Подразделение,
	|	Решение.АналитикаОперацииСДрагМатериалами КАК АналитикаОперацииСДрагМатериалами,
	|	Решение.НоменклатураЛома КАК НоменклатураЛома,
	|	Решение.Комиссия КАК Комиссия
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом КАК Решение
	|ГДЕ
	|	Решение.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.КоличествоВсегоДМ КАК КоличествоВсегоДМ,
	|	ОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
	|	ОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии
	|ПОМЕСТИТЬ ТЧ
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.СчетУчета В (&Счета)
	|	И ОсновныеСредства.ОсновноеСредство.ТипНФА <> Значение(Перечисление.ТипыНФА.Транспорт)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Сумма КАК Сумма,
	|	ТЧ.СуммаАмортизации КАК СуммаАмортизации,
	|	ТЧ.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	ТЧ.СуммаОбесценения КАК СуммаОбесценения,
	|	ТЧ.СчетУчета КАК СчетУчета,
	|	ТЧ.КПС КАК КПС,
	|	ТЧ.КФО КАК КФО,
	|	ТЧ.КоличествоВсегоДМ КАК КоличествоВсегоДМ,
	|	ТЧ.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧ.ПричинаСписания КАК ПричинаСписания,
	|	ТЧ.РезолюцияКомиссии КАК РезолюцияКомиссии
	|ИЗ
	|	ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	ДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ДрагоценныеМатериалы.ЛигатурнаяМассаЛома КАК ЛигатурнаяМассаЛома,
	|	ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	ДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И ДрагоценныеМатериалы.ОбъектНФА В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ТЧ КАК Таб)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.Количество КАК Количество,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка
	|	И СведенияПрослеживаемости.ИдентификаторСтроки В
	|		(ВЫБРАТЬ
	|			Таб.ИдентификаторСтроки
	|		ИЗ
	|			ТЧ КАК Таб)";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Решение);
	Запрос.УстановитьПараметр("Счета", Счета);

	Результат = Запрос.ВыполнитьПакет();
	Шапка = Результат[0].Выбрать();
	ТЧОС  = Результат[2].Выбрать();
	ТЧДМ  = Результат[3].Выбрать();
	ТЧПР  = Результат[4].Выбрать();

	Если Шапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Шапка,, "Номер, Комиссия");
		Дата = НачалоДня(Дата);
		// При вводе на основании "Решения о прекращении..." реквизит "Комиссия" ссылочного типа
		// не должен быть заполнен. Т.к. в данном случае комиссия в акте не голосует. 
		// Иначе в разделе 2 акта 0510454 будут заполняться результаты голосования.
		// А при пустом реквизите "Комиссия" результаты голосования не учитываются.
		Комиссия = Справочники.ПостоянноДействующиеКомиссии.ПустаяСсылка();

		ОснованиеДляАкта = УправлениеОсновнымиСредствами.НаименованиеПечатнойФормы("0510440");
		НомерОснованияДляАкта = Шапка.Номер;
		ДатаОснованияДляАкта = Шапка.Дата;

		ДопПараметры = ОбщегоНазначенияБГУКлиентСервер.СтруктураПараметровВыбораКомисии();
		ОбщегоНазначенияБГУКлиентСервер.ЗаполнитьКомиссиюВДокументе(Шапка.Комиссия, ДопПараметры, ЭтотОбъект);
	КонецЕсли;	

	ОсновныеСредства.Очистить();
	Пока ТЧОС.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТЧОС);
		НоваяСтрока.СтоимостьЕдиницы = 
			?(НоваяСтрока.Количество = 0, НоваяСтрока.Сумма, НоваяСтрока.Сумма / НоваяСтрока.Количество);
	КонецЦикла;	

	ДрагоценныеМатериалы.Очистить();
	Пока ТЧДМ.Следующий() Цикл
		НоваяСтрока = ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТЧДМ);
	КонецЦикла;	

	СведенияПрослеживаемости.Очистить();
	Пока ТЧПР.Следующий() Цикл
		НоваяСтрока = СведенияПрослеживаемости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТЧПР);
	КонецЦикла;
КонецПроцедуры	

Процедура ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения)
	ДокОснование = ДанныеЗаполнения.ДокументОснование;
	Разделитель = ДанныеЗаполнения.Разделитель;   
	
	Решение = ДокОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Разделитель);
	КФОВТабличнойЧасти = Истина;
	
	Если Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ОсобоценноеВложение") Тогда      
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ОсобоценноеНаБалансе") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ИноеДвижимоеВложение") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ИноеДвижимоеНаБалансе") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ПраваПользованияВложение") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		ВидИмущества = Перечисления.ВидыИмущества.ПраваПользованияНМА;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ПраваПользованияНаБалансе") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
		ВидИмущества = Перечисления.ВидыИмущества.ПраваПользованияНМА;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ВКонцессииВложение") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ВКонцессииНаБалансе") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
		ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("НедвижимостьВложение") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений;
		ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("НедвижимостьНаБалансе") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС;
		ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ОсобоценноеВПользовании") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование;
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ОсобоценноеНаХранении") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении;
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ОсобоценноеВОперУчете") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет;
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ИноеДвижимоеВПользовании") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование;
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ИноеДвижимоеНаХранении") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении;
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("ИноеДвижимоеВОперУчете") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет;
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("НедвижимостьВПользовании") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование;
		ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
	ИначеЕсли Разделитель.ВидУчета = Документы.СписаниеОбъектовОС.ПредставлениеВидаУчетаПоИмениПараметра("НедвижимостьНаХранении") Тогда
		ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении;
		ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
	КонецЕсли;	
	
	СсылкаЦелевогоДокумента = Неопределено;
	Если ДанныеЗаполнения.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = ДанныеЗаполнения.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаГруппы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&КодыСчетовГрупп)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.НФА КАК ОсновноеСредство,
	|	ДанныеИнвентаризации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеИнвентаризации.КПС КАК КПС,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено КАК Количество,
	|	ДанныеИнвентаризации.Счет КАК СчетУчета,
	|	ДанныеИнвентаризации.ЗаключениеКомиссии КАК РезолюцияКомиссии
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 2
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И ДанныеИнвентаризации.Подразделение = &Подразделение
	|	И ДанныеИнвентаризации.ЦМОРаздела1 = &ЦМО
	|	И ДанныеИнвентаризации.Счет В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				СчетаГруппы.Ссылка
	|			ИЗ
	|				СчетаГруппы)
	|	И (ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|			ИЛИ ДанныеИнвентаризации.СуммаНедостачаНеПодтверждено <> 0)";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	КодыСчетовГруппСтрокой = Документы.СписаниеОбъектовОС.КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества);
	КодыСчетовГрупп = СтрРазделить(КодыСчетовГруппСтрокой, ",", Ложь);
	Запрос.УстановитьПараметр("КодыСчетовГрупп", КодыСчетовГрупп);
	Запрос.УстановитьПараметр("Подразделение", Разделитель.Подразделение);
	Запрос.УстановитьПараметр("ЦМО", Разделитель.ЦМО);
	Запрос.УстановитьПараметр("ИФО", Разделитель.ИФО);
	Выборка = Запрос.Выполнить().Выбрать();    
	
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Организация, Дата, Комиссия, Номер");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование,, "Номер");
	Дата = НачалоДня(Дата);
	ДопПараметры = ОбщегоНазначенияБГУКлиентСервер.СтруктураПараметровВыбораКомисии();
	ОбщегоНазначенияБГУКлиентСервер.ЗаполнитьКомиссиюВДокументе(Комиссия, ДопПараметры, ЭтотОбъект);

	ОснованиеДляАкта = УправлениеОсновнымиСредствами.НаименованиеПечатнойФормы("0510466");
	НомерОснованияДляАкта = ДанныеДокОснование.Номер;
	ДатаОснованияДляАкта = ДанныеДокОснование.Дата;
	
	ОсновныеСредства.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
КонецПроцедуры

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	ТабТЧ = ОсновныеСредства.Выгрузить(, 
		"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, КФО, КПС, Договор, Контрагент, Количество, Сумма, НомерСтроки");
	ТабТЧ.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТабТЧ.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ТабТЧ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТабТЧ.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	Для каждого СтрокаТЧ из ТабТЧ Цикл
		СтрокаТЧ.Организация = Организация;
		СтрокаТЧ.ЦМО = ЦМО;
		СтрокаТЧ.Подразделение = Подразделение;
		СтрокаТЧ.ИФО = ИФО;
		Если НЕ КФОВТабличнойЧасти Тогда
			СтрокаТЧ.КФО = КФО;
		КонецЕсли;	
	КонецЦикла;	 
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.СчетУчета КАК Счет,
	|	ТабЧасть.КФО КАК КФО,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.Договор КАК Договор,
	|	ТабЧасть.Контрагент КАК Контрагент,
	|	ТабЧасть.Количество КАК Количество,
	|	ТабЧасть.Сумма КАК Сумма,
	|	ТабЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабЧасть.Организация КАК Организация,
	|	ТабЧасть.ЦМО КАК ЦМО,
	|	ТабЧасть.Подразделение КАК Подразделение,
	|	ТабЧасть.ИФО КАК ИФО
	|ПОМЕСТИТЬ ТЧ
	|ИЗ
	|	&ТабЧасть КАК ТабЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.Ссылка.УчетПоПодразделениям) КАК УчетПоПодразделениям,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.Ссылка.УчетПоКПС) КАК УчетПоКПС,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)) КАК УчетПоЦМО,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ) КАК ВидДопАналитики
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В
	|		(ВЫБРАТЬ
	|			ТЧ.Счет
	|		ИЗ
	|			ТЧ)
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ОсновныеСредства)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ КАК ОсновноеСредство,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Счета.ВидДопАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА ВЫБОР
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Договоры
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|			КОНЕЦ
	|		КОГДА Счета.ВидДопАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ТОГДА ВЫБОР
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты)
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты)
	|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Контрагенты
	|					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Контрагенты)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ) КАК ДопАналитика
	|ПОМЕСТИТЬ ДопАналитикаВОстатках
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет.Ссылка В
	|		(ВЫБРАТЬ
	|			Счета.Счет
	|		ИЗ
	|			Счета),, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет
	|ГДЕ
	|	Счета.ВидДопАналитики В (ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ОсновныеСредства)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Организация КАК Организация,
	|	ТЧ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧ.Счет КАК СчетУчета,
	|	ТЧ.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА НЕ Счета.УчетПоКПС ЕСТЬ NULL
	|		И Счета.УчетПоКПС
	|			ТОГДА ТЧ.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК КПС,
	|	ВЫБОР
	|		КОГДА НЕ Счета.ВидДопАналитики ЕСТЬ NULL
	|		И Счета.ВидДопАналитики <> НЕОПРЕДЕЛЕНО
	|			ТОГДА ВЫБОР
	|				КОГДА &ДоговорВТабличнойЧасти
	|					ТОГДА ВЫБОР
	|						КОГДА Счета.ВидДопАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|							ТОГДА ТЧ.Договор
	|						КОГДА Счета.ВидДопАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|							ТОГДА ТЧ.Контрагент
	|						ИНАЧЕ НЕОПРЕДЕЛЕНО
	|					КОНЕЦ
	|				КОГДА НЕ ДопАналитикаВОстатках.ДопАналитика ЕСТЬ NULL
	|				И НЕ ДопАналитикаВОстатках.ДопАналитика В (ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
	|					ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|					ТОГДА ДопАналитикаВОстатках.ДопАналитика
	|				ИНАЧЕ НЕОПРЕДЕЛЕНО
	|			КОНЕЦ
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопАналитика,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА НЕ Счета.УчетПоЦМО ЕСТЬ NULL
	|		И Счета.УчетПоЦМО
	|			ТОГДА ТЧ.ЦМО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ КАК ЦМО,
	|	ВЫБОР
	|		КОГДА НЕ Счета.УчетПоПодразделениям ЕСТЬ NULL
	|		И Счета.УчетПоПодразделениям
	|		И &УчетПоПодразделениям
	|			ТОГДА ТЧ.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &УчетПоИФО
	|			ТОГДА ТЧ.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	ЛОЖЬ КАК ПередачаЧастейОбъектов
	|ИЗ
	|	ТЧ КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ТЧ.Счет = Счета.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДопАналитикаВОстатках КАК ДопАналитикаВОстатках
	|		ПО ТЧ.ОсновноеСредство = ДопАналитикаВОстатках.ОсновноеСредство";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТабЧасть", ТабТЧ);
	Запрос.УстановитьПараметр("Дата1", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДоговорВТабличнойЧасти", ДоговорВТабличнойЧасти);
	Запрос.УстановитьПараметр("УчетПоИФО", УчетПоИФО);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПоПодразделениям);
		
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	Если ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		Возврат ЕстьОшибки;
	КонецЕсли;	
	
	ТаблицаДока = ТаблицаСписанияОС();

	МассивВОсКонтролемОбременений = Новый Массив;
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет);
	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(ТаблицаДока, ЭтотОбъект, 
		МассивВОсКонтролемОбременений.Найти(ВидОперации) <> Неопределено);
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецОбласти

#КонецЕсли