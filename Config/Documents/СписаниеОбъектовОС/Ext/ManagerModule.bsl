// Формирует данные табличной части (ТЧ) документа для проверки остатков в функции ПолучитьОстаткиОСЗабаланс
// общего модуля БухгалтерскиеОперацииПовтИсп
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.СписаниеОбъектовОС - документ, для которого собираем данные ТЧ
//
// Возвращаемое значение:
//  - ТаблицаЗначений - таблица, содержащая данные ТЧ 
Функция ДанныеТЧдляПроверкиОстатковЗабалансомВТО(ДокументСсылка) Экспорт
	ДоговорВТабличнойЧасти = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДоговорВТабличнойЧасти");
	
	Если ДоговорВТабличнойЧасти Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Сумма КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.СписаниеОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьДоговоры,		
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьКонтрагенты
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.Ссылка В
		|		(ВЫБРАТЬ
		|			Таб.СчетУчета
		|		ИЗ
		|			ТабЧасть КАК Таб)
		|	И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|	ИЛИ ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУВидыСубконто.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть.НомерСтроки КАК НомерСтроки,
		|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
		|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТабЧасть.КПС КАК КПС,
		|	ТабЧасть.Количество КАК Количество,
		|	ТабЧасть.Сумма КАК Сумма,
		|	ТабЧасть.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьКонтрагенты
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьДоговоры
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Договор
		|	КОНЕЦ КАК Договор
		|ИЗ
		|	ТабЧасть КАК ТабЧасть
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
		|		ПО Счета.Ссылка = ТабЧасть.СчетУчета
		|";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Сумма КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.СписаниеОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица проводок, которые будут сформированы
//  ДокументОбъект - ДокументОбъект - Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура - Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - ТаблицаЗначений - Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка - Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращаемое значение:
//  - Булево - Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ТекОрганизация = ДокументОбъект.Организация;
	ТекДата        = ДокументОбъект.Дата;

	ОтразитьВКарточкеКапвложений = Ложь;
	Если ДополнительныеРеквизиты.Свойство("ОтразитьВКарточкеКапвложений", ОтразитьВКарточкеКапвложений) 
		И ОтразитьВКарточкеКапвложений Тогда
			
		Если НЕ ЗначениеЗаполнено(ДополнительныеРеквизиты.КарточкаКапвложений) Тогда
			ТекстОшибки = НСтр("ru = 'На закладке документа ""Бухгалтерская операция"" включен флажок 
			|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
			Возврат Ложь;
		КонецЕсли;		

		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ТекОрганизация;
		НоваяСтрока.КарточкаКапвложений = ДополнительныеРеквизиты.КарточкаКапвложений;
		НоваяСтрока.Период              = ТекДата;
	КонецЕсли;		
	
	Для каждого СтрокаТЧ из ДокументОбъект.ОсновныеСредства Цикл
		Если НЕ ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(СтрокаТЧ.СчетУчета) Тогда
			Продолжить;
		ИначеЕсли НЕ СтрокаТЧ.ОтразитьВКарточкеКапвложений ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда
			Продолжить;
		ИначеЕсли ТабДвижений.Найти(СтрокаТЧ.КарточкаКапвложений, "КарточкаКапвложений") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ТекОрганизация;
		НоваяСтрока.КарточкаКапвложений = СтрокаТЧ.КарточкаКапвложений;
		НоваяСтрока.Период              = ТекДата;
	КонецЦикла;	

	Возврат Истина;
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Списание объектов ОС" на основании одного документа
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.РешениеОПрекращенииПризнанияАктивом,
//						ДокументСсылка.ИнвентаризационнаяОписьНФА  - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.СписаниеОбъектовОС - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- ТаблицаЗначений с полями:
//  * ВидУчета - Строка
//  * ЦМО - СправочникСсылка.ЦМО
//  * Подразделение - СправочникСсылка.Подразделения
//  * КФО - ПеречислениеСсылка.КФО
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт  
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом") Тогда
		Возврат ТаблицаРазделителейДокументов_РешениеОПрекращенииПризнанияАктивом(ДокументОснование);
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует массив счетов учета ОС, НМА, НПА по значеням вида имущества и вида операции
//
// Параметры:
//  - Организация - СправочникСсылка.Организации - организация
//  - Дата - Дата - дата документа
//  - ВидОперации - ПеречислениеСсылка.ВидыОперацийСписанияОС - вид операции, выбранный в документе
//  - ВидИмущества - ПеречислениеСсылка.ВидыИмущества - вид имущества, выбранный в документе
//  - ВосстановитьНаБалансе - Булево - значение реквизита ВосстановлениеНаБалансе
//
//  Возвращает массив счетов
Функция СчетаУчетаОСПоВидуОперацииИИмущества(Организация, Дата, ВидОперации, ВидИмущества, ВосстановитьНаБалансе = Ложь) Экспорт
	КодыСчетов = КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе);
	Счета = БухгалтерскийУчет.СписокСчетов(КодыСчетов, Дата,, Организация);
    Возврат Счета;
КонецФункции	

// Формирует строку кодов счетов учета ОС, НМА, НПА по значеням вида имущества и вида операции
//
// Параметры:
//  - ВидОперации - ПеречислениеСсылка.ВидыОперацийСписанияОС - вид операции, выбранный в документе
//  - ВидИмущества - ПеречислениеСсылка.ВидыИмущества - вид имущества, выбранный в документе
//  - ВосстановитьНаБалансе - Булево - значение реквизита ВосстановлениеНаБалансе
//
//  Возвращает строку счетов, разделенных запятыми
Функция КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе = Ложь) Экспорт
	КодыСчетов = "";
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении") Тогда
		КодыСчетов = "02.3";
		Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = КодыСчетов + ?(ВосстановитьНаБалансе, "", ",02.10") + ",02.1";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = КодыСчетов + ?(ВосстановитьНаБалансе, "", ",02.20") + ",02.1";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = КодыСчетов + ?(ВосстановитьНаБалансе, "", ",02.30") + ",02.1";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование") Тогда
		Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "01.10" + ",01.11,01.12";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "01.20" + ",01.21,01.22";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "01.30" + ",01.31,01.32";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет") Тогда
		Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "21.20";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "21.30";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений") Тогда
		Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "106.10";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "106.20";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "106.30";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
			КодыСчетов = "106.40";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
			КодыСчетов = "106.60";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "106.90";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОС") Тогда
		Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "101.10,102.10,103.10";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "101.20,102.20,103.20";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "101.30,102.30,103.30";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
			КодыСчетов = "101.40,102.40,103.40";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
			КодыСчетов = "111.60";
		ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "101.90,102.90,103.90";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КодыСчетов;
КонецФункции	

// Заполняет таб. часть "Восстановление на балансе" по данным учета объектов, при восстановлении объектов на баланс.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - основной объект формы документа
Процедура ЗаполнитьТЧВосстановлениеНаБалансе(Объект) Экспорт
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить(, "НомерСтроки,ОсновноеСредство,ИнвентарныйНомер,Количество");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);
	Запрос.УстановитьПараметр("ВидСубконтоЦМО", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("ЦМОИзОбъекта", Объект.ЦМО);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧ.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	&ТаблицаОС КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС
	|ПОМЕСТИТЬ ВТ_УчетныеДанные1
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, Организация = &Организация
	|	И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство
	|		ИЗ
	|			ВТ_ОС КАК ВТ)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет
	|ПОМЕСТИТЬ ВТ_СчетаСЦМО
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В
	|		(ВЫБРАТЬ
	|			Таб.СчетУчета
	|		ИЗ
	|			ВТ_УчетныеДанные1 КАК Таб)
	|	И ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_УчетныеДанные1.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_УчетныеДанные1.СчетУчета КАК СчетУчета,
	|	ВТ_УчетныеДанные1.КПС КАК КПС,
	|	НЕ ВТ_СчетаСЦМО.Счет ЕСТЬ NULL КАК ЕстьСубконтоЦМО
	|ПОМЕСТИТЬ ВТ_УчетныеДанные
	|ИЗ
	|	ВТ_УчетныеДанные1 КАК ВТ_УчетныеДанные1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СчетаСЦМО КАК ВТ_СчетаСЦМО
	|		ПО ВТ_УчетныеДанные1.СчетУчета = ВТ_СчетаСЦМО.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(АмортизацияОбъектовОС.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(АмортизацияОбъектовОС.СуммаОбесценения) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|ГДЕ
	|	АмортизацияОбъектовОС.Организация = &Организация
	|	И АмортизацияОбъектовОС.ЭтоСписание
	|	И АмортизацияОбъектовОС.Активность
	|	И АмортизацияОбъектовОС.Период < &Период
	|	И (АмортизацияОбъектовОС.ОсновноеСредство, АмортизацияОбъектовОС.ИнвентарныйНомер) В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство,
	|			ВТ.ИнвентарныйНомер
	|		ИЗ
	|			ВТ_ОС КАК ВТ)
	|СГРУППИРОВАТЬ ПО
	|	АмортизацияОбъектовОС.ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМО КАК ЦМО,
	|	СУММА(СтоимостьОбъектовОС.Стоимость) КАК Стоимость,
	|	СУММА(СтоимостьОбъектовОС.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация = &Организация
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период < &Период
	|	И (СтоимостьОбъектовОС.ОсновноеСредство, СтоимостьОбъектовОС.ИнвентарныйНомер) В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство,
	|			ВТ.ИнвентарныйНомер
	|		ИЗ
	|			ВТ_ОС КАК ВТ)
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОС.ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.НомерСтроки КАК НомерСтроки,
	|	ВТ_УчетныеДанные.СчетУчета КАК СчетУчетаВосстановление,
	|	ВТ_УчетныеДанные.КПС КАК КПСВосстановление,
	|	ВЫБОР
	|		КОГДА ВТ_УчетныеДанные.ЕстьСубконтоЦМО
	|			ТОГДА ВЫБОР
	|				КОГДА ЕСТЬNULL(ВТ_Стоимость.ЦМО, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|					ТОГДА &ЦМОИзОбъекта
	|				ИНАЧЕ ЕСТЬNULL(ВТ_Стоимость.ЦМО, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка))
	|			КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ КАК ЦМОВосстановление,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_Стоимость.Количество, 0) = 0
	|			ТОГДА ЕСТЬNULL(ВТ_Стоимость.Стоимость, 0)
	|		ИНАЧЕ ВТ_Стоимость.Стоимость / ВТ_Стоимость.Количество * ВТ_ОС.Количество
	|	КОНЕЦ КАК СуммаВосстановление,
	|	ВТ_Амортизация.СуммаАмортизации КАК СуммаАмортизации,
	|	ВТ_Амортизация.СуммаОбесценения КАК СуммаОбесценения
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УчетныеДанные КАК ВТ_УчетныеДанные
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_УчетныеДанные.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Стоимость КАК ВТ_Стоимость
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_Стоимость.ОсновноеСредство
	|		И ВТ_ОС.ИнвентарныйНомер = ВТ_Стоимость.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО ВТ_ОС.ОсновноеСредство = ВТ_Амортизация.ОсновноеСредство
	|		И ВТ_ОС.ИнвентарныйНомер = ВТ_Амортизация.ИнвентарныйНомер";
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаТаблицы = Объект.ОсновныеСредства[СтрокаДанных.НомерСтроки-1];
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);
	КонецЦикла;
	
КонецПроцедуры

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Ссылка.Решение КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача) КАК ВидОтклонения,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ОсновныеСредства.Количество КАК Количество
	|ИЗ
	|	Документ.СписаниеОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Решение В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &СписаниеОбъектовОССсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ПредставлениеВидаУчетаПоИмениПараметра(ИмяПараметра) Экспорт
	Результат = "";
	Если ИмяПараметра = "ОсобоценноеВложение" Тогда 
		Результат = НСтр("ru = 'Вложения в особоценное имущество (106.20)'");
	ИначеЕсли ИмяПараметра = "ОсобоценноеНаБалансе" Тогда 
		Результат = НСтр("ru = 'Особоценное имущество на балансе (101.20, 102.20, 103.20)'");
	ИначеЕсли ИмяПараметра = "ИноеДвижимоеВложение" Тогда 
		Результат = НСтр("ru = 'Вложения в иное движимое имущество (106.30)'");
	ИначеЕсли ИмяПараметра = "ИноеДвижимоеНаБалансе" Тогда 
		Результат = НСтр("ru = 'Иное движимое имущество на балансе (101.30, 102.30, 103.30)'");
	ИначеЕсли ИмяПараметра = "ПраваПользованияВложение" Тогда 
		Результат = НСтр("ru = 'Вложения в права пользования НМА (106.60)'");
	ИначеЕсли ИмяПараметра = "ПраваПользованияНаБалансе" Тогда 
		Результат = НСтр("ru = 'Права пользования НМА на балансе (111.60)'");
	ИначеЕсли ИмяПараметра = "ВКонцессииВложение" Тогда 
		Результат = НСтр("ru = 'Вложения в имущество в концессии (106.90)'");
	ИначеЕсли ИмяПараметра = "ВКонцессииНаБалансе" Тогда 
		Результат = НСтр("ru = 'Имущество в концессии на балансе (101.90, 102.90, 103.90)'");
	ИначеЕсли ИмяПараметра = "НедвижимостьВложение" Тогда 
		Результат = НСтр("ru = 'Вложения в недвижимость (106.10)'");
	ИначеЕсли ИмяПараметра = "НедвижимостьНаБалансе" Тогда 
		Результат = НСтр("ru = 'Недвижимость на балансе (101.10, 103.10)'");
	ИначеЕсли ИмяПараметра = "ОсобоценноеВПользовании" Тогда 
		Результат = НСтр("ru = 'Особоценное имущество в пользовании (01.20)'");
	ИначеЕсли ИмяПараметра = "ОсобоценноеНаХранении" Тогда 
		Результат = НСтр("ru = 'Особоценное имущество на хранении (02.20)'");
	ИначеЕсли ИмяПараметра = "ОсобоценноеВОперУчете" Тогда 
		Результат = НСтр("ru = 'Особоценное имущество в опер. учете (21.20)'");
	ИначеЕсли ИмяПараметра = "ИноеДвижимоеВПользовании" Тогда 
		Результат = НСтр("ru = 'Иное движимое имущество в пользовании (01.30)'");
	ИначеЕсли ИмяПараметра = "ИноеДвижимоеНаХранении" Тогда 
		Результат = НСтр("ru = 'Иное движимое имущество на хранении (02.30)'");
	ИначеЕсли ИмяПараметра = "ИноеДвижимоеВОперУчете" Тогда 
		Результат = НСтр("ru = 'Иное движимое имущество в опер. учете (21.30)'");
	ИначеЕсли ИмяПараметра = "НедвижимостьВПользовании" Тогда 
		Результат = НСтр("ru = 'Недвижимость в пользовании (01.10)'");
	ИначеЕсли ИмяПараметра = "НедвижимостьНаХранении" Тогда 
		Результат = НСтр("ru = 'Недвижимость на хранении (02.10)'");
	КонецЕсли;	                                                   
	
	Возврат Результат;
КонецФункции	
	
