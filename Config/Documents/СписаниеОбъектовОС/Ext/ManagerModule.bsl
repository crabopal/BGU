// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктСписания0510454") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510454(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктСписания0510454","Акт о списании объектов НФА (ф. 0510454)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктСписания0504104") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0504104(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктСписания0504104","Акт о списании объектов НФА (ф.0504104)", ТабличныйДокумент);
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктСписания0504104_103н") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0504104(МассивОбъектов, ОбъектыПечати, "103н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктСписания0504104_103н","Акт о списании объектов НФА (ф.0504104) (в ред.103н)", ТабличныйДокумент);
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОСодержанииДрагМатериаловПриСписании") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати, Ложь);
		Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
			КоллекцияПечатныхФорм[0].ИмяМакета = "СправкаОСодержанииДрагМатериалов";
			КоллекцияПечатныхФорм[0].ИмяВРЕГ = ВРЕГ("СправкаОСодержанииДрагМатериалов");
		КонецЕсли;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов","Справка о содержании драг. материалов при списании", ТабличныйДокумент);
		
	КонецЕсли;
	
	//Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьКарточекКапвложений") Тогда
	//	
	//	ДанныеДляПечати = 
	//		УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов, "КарточкаКапвложений");
	//	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
	//	"ПечатьКарточекКапвложений", НСтр("ru = 'Карточки капвложений (ф.0509211)'"), 
	//	Справочники.КарточкиКапвложений.Печать0509211(ДанныеДляПечати, ОбъектыПечати));
	//	
	//КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ТабличныйДокумент = Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки(ДанныеДляПечати, ОбъектыПечати, "103н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек","Инвентарные карточки объектов", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиИнвКарточек(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СписаниеОбъектовОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	СписаниеОбъектовОСОсновныеСредства.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СписаниеОбъектовОС.ОсновныеСредства КАК СписаниеОбъектовОСОсновныеСредства
	|ГДЕ
	|	СписаниеОбъектовОСОсновныеСредства.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
КонецФункции

#КонецОбласти

Функция ТаблицаРазделителейДокументов_РешениеОПрекращенииПризнанияАктивом(ДокументОснование)
	СвойстваОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
	Счета_ДвижимоеОсобоЦенное_ОперУчет = БухгалтерскийУчет.СписокСчетов(
		"21.20", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_ИноеДвижимое_ОперУчет = БухгалтерскийУчет.СписокСчетов(
