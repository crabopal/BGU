	Если НЕ ЭтоВО_СДоговоромВТЧ(ЭтотОбъект) И Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Ложь;
	ИначеЕсли ЭтоВО_СДоговоромВТЧ(ЭтотОбъект) И НЕ Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииВидаОперации()
	Если НЕ Объект.ВидОперации = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет")
		И НЕ Объект.ВидОперации = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении")
		И Объект.ВосстановитьНаБалансе Тогда
			
		// Реквизит "ВосстановитьНаБалансе" стал невидимым и если он включен, его нужно выключить. От этого
		// зависит выбор типовой бухгалтерской операции
		Объект.ВосстановитьНаБалансе = Ложь;
	КонецЕсли;		 

	УстановитьРеквизитДоговорВТабличнойЧасти();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьОбязательностьЭлементовФормы(ЭтотОбъект);
	УстановитьОтборСчетаУчетаОС();
	
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ОтключитьУчетВКарточкахКапвложений();
КонецПроцедуры	

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Решение сотрудника.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
КонецПроцедуры

// Обработчик выбора строки постоянно действующией комиссии. см.ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии.
// "Объект" передается явно, без этого данные объекта не заполняются в web-клиенте.
&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект)
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
	//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства");
	
	ЭтоСписаниеКапвложений = 	
		     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений"); 
	ВедетсяУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений()
		ИЛИ (ЭтоСписаниеКапвложений И Объект.ДрагоценныеМатериалы.Количество() > 0);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма);
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ();

	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ЦМО");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма)
	
	Объект = Форма.Объект;
	ЦМООбязательно = Объект.ВидОперации <> ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений");
	
	Если ЦМООбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"АвтоотметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ЦМО));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"АвтоотметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	Элементы = Форма.Элементы;
	
	ЭтоСписаниеКапвложений = 	
		     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений");
	
	ВО_СписаниеСобственныхОС = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОС");
	ВО_СписаниеСобственныхОСОперУчет = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет");
	ВО_СписаниеОСнаХранении = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении");
	ВО_СписаниеОСПолученныхВПользование = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование");
	ВО_СписаниеКапвложений = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений");
	
	ВидимостьРеквизитовАмортизации = (ВидОперации = ВО_СписаниеСобственныхОС);
	ВидимостьРеквизитовХранения =
		(ВидОперации = ВО_СписаниеСобственныхОС ИЛИ ВидОперации = ВО_СписаниеСобственныхОСОперУчет);
	ВидимостьРеквизитовВосстановления =
		(ВидОперации = ВО_СписаниеСобственныхОСОперУчет ИЛИ ВидОперации = ВО_СписаниеОСнаХранении);
		
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииНакопленная");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииЗаТекущийМесяц");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
		
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ВидимостьРеквизитовАмортизации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаПолучатель", "Видимость", ВидимостьРеквизитовХранения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВосстановитьНаБалансе", "Видимость", ВидимостьРеквизитовВосстановления);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаВосстановлениеОС", "Видимость", ВидимостьРеквизитовВосстановления И Объект.ВосстановитьНаБалансе);
	
	ВидимостьЭлементовКарточки = (ВидОперации = ВО_СписаниеКапвложений);
	ЭлементыКарточкаКапвложений = Новый Массив;
	ЭлементыКарточкаКапвложений.Добавить("ОсновныеСредстваГруппаКарточкаКапвложений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыКарточкаКапвложений, "Видимость", ВидимостьЭлементовКарточки);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВидОперации", "Доступность", НЕ Объект.ЕстьРешениеОПрекращенииПризнанияАктивом);

	ДоступностьКнопкиРассчитать = (
		(ВидОперации = ВО_СписаниеСобственныхОС
		ИЛИ ВидОперации = ВО_СписаниеКапвложений
		ИЛИ ВидОперации = ВО_СписаниеСобственныхОСОперУчет
		ИЛИ ВидОперации = ВО_СписаниеОСнаХранении
		ИЛИ ВидОперации = ВО_СписаниеОСПолученныхВПользование
		)
		И НЕ Объект.ЕстьРешениеОПрекращенииПризнанияАктивом
		);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКомандаРассчитатьСтоимостьОС", "Доступность", ДоступностьКнопкиРассчитать);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоговорВТабличнойЧасти", "Видимость", ЭтоВО_СДоговоромВТЧ(Форма));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКонтрагентДоговор", "Видимость", Объект.ДоговорВТабличнойЧасти);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КФО", "Видимость", НЕ Объект.КФОВТабличнойЧасти);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваКФО", "Видимость", Объект.КФОВТабличнойЧасти);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаМЦ", "Видимость", ЭтоСписаниеКапвложений И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыИнвНомер", "Видимость", НЕ (ЭтоСписаниеКапвложений И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"ВключатьМЦВСоставКапвложений",
		"Видимость", Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений И (ВидОперации = ВО_СписаниеСобственныхОС));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"ДрагоценныеМатериалы",
		"Доступность", НЕ (Объект.ВключатьМЦВСоставКапвложений И (ВидОперации = ВО_СписаниеСобственныхОС)));	
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваИнвентарныйНомер", "Видимость", НЕ ЭтоСписаниеКапвложений);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе) Экспорт
	Возврат Документы.СписаниеОбъектовОС.КодыСчетовУчетаОСПоВидуОперацииИИмущества(ВидОперации, ВидИмущества, ВосстановитьНаБалансе);
КонецФункции
	
&НаКлиенте
Процедура УстановитьОтборСчетаУчетаОС()
	КодыСчетов = КодыСчетовУчетаОСПоВидуОперацииИИмущества(Объект.ВидОперации, Объект.ВидИмущества, Объект.ВосстановитьНаБалансе);
	КодыСчетов = ?(КодыСчетов = "", "-", КодыСчетов);	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыФормы()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Получить(СтрокаТаблицы.ОсновноеСредство);
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС, "ГрупповойУчет,ВидНФА");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			СтрокаТаблицы.УчетПоКПС = Ложь;
		Иначе
			СтрокаТаблицы.УчетПоКПС = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета).УчетПоКПС;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомиссии()
	
	ЕстьКомиссия = ЗначениеЗаполнено(Объект.Комиссия);
	
	Элементы.ГруппаИндикаторКворумаПрисутствия.Видимость = ЕстьКомиссия;
	Элементы.ГруппаПриказОНазначенииКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	//Элементы.ГруппаПредседательКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.Председатель.Видимость = ЕстьКомиссия;
	Элементы.ВыбратьПредседателяКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии1.Видимость = ЕстьКомиссия;
	Элементы.ЗаключениеКомиссии.Видимость = Не ЕстьКомиссия;
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	// ИндикаторКворумаПрисутствия
