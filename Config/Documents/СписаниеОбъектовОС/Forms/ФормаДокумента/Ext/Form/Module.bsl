#Область ГолосованиеКомиссии

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РезультатыГолосованияСотрудника(ТаблицаДокумента)
	
	РезультатыГолосования = Новый Массив;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		Если ЗначениеЗаполнено(СтрокаДокумента.РешениеСотрудникаПоРезолюции) Тогда
			РезультатГолосования = Новый Структура("ИдентификаторСтроки,РешениеСотрудникаПоРезолюции",
				СтрокаДокумента.ИдентификаторСтроки, СтрокаДокумента.РешениеСотрудникаПоРезолюции);
			РезультатыГолосования.Добавить(РезультатГолосования);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатыГолосования;
	
КонецФункции

&НаКлиенте
Процедура УстановитьРешениеВСтрокахДокумента(РешениеСотрудника, ВоВсехСтроках = Истина)
	
	РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.ПустаяСсылка");
	Если РешениеСотрудника = "За" Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.За");
	ИначеЕсли РешениеСотрудника = "Против" Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.Против");
	КонецЕсли;
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
			СтрокаДокумента.РешениеСотрудникаПоРезолюции = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	Иначе
		Для Каждого ИдентификаторВыделеннойСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			СтрокаДокумента = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			СтрокаДокумента.РешениеСотрудникаПоРезолюции = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьРезультатыГолосованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьРезультатыГолосованияНаСервере(ДополнительныеПараметры.Сотрудник, ДополнительныеПараметры.РезультатыГолосования);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРезультатыГолосованияНаСервере(ЧленКомиссии, РезультатыГолосования)
	
	ОбщегоНазначенияБГУ.СохранитьРезультатыГолосованияНаСервере(Объект, ЧленКомиссии, РезультатыГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьРешениеЕдиногласноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		УстановитьРешениеЕдиногласноНаСервере(ДополнительныеПараметры);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРешениеЕдиногласноНаСервере(РезультатГолосования)
	
	ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "ОсновныеСредства", РезультатГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

// Файлы сотрудников
&НаКлиенте
Процедура ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора)
	
	РаботаСФайламиБГУ.ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОткрепитьФайлСотрудникаНаСервере()
	
	РаботаСФайламиБГУ.ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

// Конец Файлы сотрудников

#КонецОбласти

&НаКлиенте
Процедура ОтключитьУчетВКарточкахКапвложений()
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений") Тогда
		
		Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
			Если СтрокаТЧ.ОтразитьВКарточкеКапвложений Тогда
				СтрокаТЧ.ОтразитьВКарточкеКапвложений = Ложь;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;		
КонецПроцедуры	

&НаКлиенте
Процедура РешениеПриИзменении_Завершение(Результат, Параметры) Экспорт                     
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	ВвестиНаОснованииРешения(Объект.Решение, Результат, СсылкаЦелевогоДокумента);
	ПриИзмененииВидаОперации();
КонецПроцедуры	

&НаСервере
Процедура ВвестиНаОснованииРешения(ДокументОснования, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.СписаниеОбъектовОС"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокументОснования, Разделитель, Истина, СсылкаЦелевогоДокумента);
	
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	ЗаполнитьДанныеОСвТЧ();
КонецПроцедуры	

&НаСервереБезКонтекста
Функция НаименованиеПричиныСписания(ПричинаСсылка)
	Возврат Справочники.ПричиныСписанияНФА.НаименованиеПричиныСписания(ПричинаСсылка);
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбора_ОчисткаТабЧастей_Завершение(Результат, ДопПараметры) Экспорт
	Если ДопПараметры.Параметры.ИмяРеквизита = "Организация" Тогда
		ОрганизацияПриИзменении(ДопПараметры.Элемент);
	ИначеЕсли ДопПараметры.Параметры.ИмяРеквизита = "ИФО" Тогда
		ИФОПриИзменении(ДопПараметры.Элемент);
	ИначеЕсли ДопПараметры.Параметры.ИмяРеквизита = "ВидОперации" Тогда
		ВидОперацииПриИзменении(ДопПараметры.Элемент);
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеОСвТЧ()
	Для каждого СтрокаТЧ Из Объект.ОсновныеСредства Цикл
		ОсновноеСредствоПриИзмененииНаСервере(СтрокаТЧ.ПолучитьИдентификатор());
	КонецЦикла;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЕстьРешениеОПрекращенииПризнанияАктивом(Форма)
	Объект = Форма.Объект;
	ЕстьРешение = ЗначениеЗаполнено(Объект.Решение) 
		И ТипЗнч(Объект.Решение) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом");
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом <> ЕстьРешение Тогда
		 Объект.ЕстьРешениеОПрекращенииПризнанияАктивом = ЕстьРешение;
	КонецЕсли;		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВО_СДоговоромВТЧ(Форма)
	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	Возврат(
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений")
		И Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии")
	);
КонецФункции	

