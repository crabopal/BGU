	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьРеквизитыТЧЗавершение", ЭтотОбъект);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"СписаниеОбъектовОС", "ОсновныеСредства", "ОсновныеСредства", 
	Реквизиты, ОписаниеОповещения);
КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧВосстановление(Команда)
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("СчетУчетаВосстановление", Новый Структура);
	Реквизиты.СчетУчетаВосстановление.Вставить("Счета", "101.00");
	Реквизиты.СчетУчетаВосстановление.Вставить("ВИерархии", Истина);
	Реквизиты.СчетУчетаВосстановление.Вставить("Дата", Объект.Дата);

	Реквизиты.Вставить("КПСВосстановление", Новый Структура);
	Реквизиты.КПСВосстановление.Вставить("Дата", Объект.Дата);
	Реквизиты.КПСВосстановление.Вставить("Организация", Объект.Организация);
	Реквизиты.КПСВосстановление.Вставить("ИФО", Объект.ИФО);
	
	ВидыПоказателей = Новый Массив;
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	Реквизиты.КПСВосстановление.Вставить("ВидыПоказателей", ВидыПоказателей);
	
	Реквизиты.Вставить("ЦМОВосстановление", Новый Структура);
	Реквизиты.ЦМОВосстановление.Вставить("Организация", Объект.Организация);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"СписаниеОбъектовОС", "ОсновныеСредства", "ВосстановлениеОС", Реквизиты);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧЗавершение(Результат, ДопПараметры) Экспорт
	НаименованиеПричиныСписания = "";
	Если Результат.Свойство("ПричинаСписанияСсылка") И ЗначениеЗаполнено(Результат.ПричинаСписанияСсылка) Тогда
		НаименованиеПричиныСписания = НаименованиеПричиныСписания(Результат.ПричинаСписанияСсылка);
	КонецЕсли;	                                                                                  
	Если ЗначениеЗаполнено(НаименованиеПричиныСписания) Тогда
		Для каждого ИдентификаторСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			ТекущиеДанные.ПричинаСписания = НаименованиеПричиныСписания;
		КонецЦикла;                         
	КонецЕсли;	
КонецПроцедуры	
	
