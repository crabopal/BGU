// Конец ИнтеграцияС1САрхивом

&НаКлиенте
Процедура КФОВТабличнойЧастиПриИзменении(Элемент)
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПереключательРезервированиеПриИзменении(Элемент)
	РезервированиеНФАКлиент.ПриИзмененииПереключателяРезервирования(ЭтотОбъект, Объект);
	ПереключательРезервированиеПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АннулированПриИзменении(Элемент)
	РезервированиеНФАКлиент.ПриИзмененииФлажкаАннулирован(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	Если РешениеСотрудникаМодифицированность
		И ЗначениеЗаполнено(ВыбранныйСотрудник)
		И ВыбранныйСотрудник <> Сотрудник Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Сотрудник", ВыбранныйСотрудник);
		ДопПараметры.Вставить("РезультатыГолосования", РезультатыГолосованияСотрудника(Объект.ОсновныеСредства));
		
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), ВыбранныйСотрудник);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	СотрудникПриИзмененииНаСервере();
	
	ВыбранныйСотрудник = Сотрудник;
	
	РешениеСотрудникаМодифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОтборПрисутствующих = Новый Структура("Отсутствует", Ложь);
	ПрисутствующиеЧленыКомиссии = Объект.СоставКомиссии.НайтиСтроки(ОтборПрисутствующих);
	
	// Выбирается из присутствующих членов комиссии.
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.Добавить(Объект.Председатель);
	Для Каждого ЧленКомиссии Из ПрисутствующиеЧленыКомиссии Цикл
		Элемент.СписокВыбора.Добавить(ЧленКомиссии.Сотрудник);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ОбщегоНазначенияБГУКлиентСервер.ЗапрещеноДобавлениеСтрокВДокументыНФА(ЭтотОбъект) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Организация",,Отказ);
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ВидИмущества) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид имущества'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ВидИмущества",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРешениеСотрудникаПоРезолюцииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваПрослеживаемостиПриВыбореОсновногоСредства(ТекущиеДанные, ДанныеОбъектаОС)
	
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		ТекущиеДанные.ПрослеживаемыйТовар = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(ТекущиеДанные.ОсновноеСредство, Объект);
		Если ТекущиеДанные.ПрослеживаемыйТовар Тогда
			ТекущиеДанные.СтранаПроисхождения = ДанныеОбъектаОС.СтранаПроисхождения;
			Если НЕ ЕстьПрослеживаемыеТовары Тогда
				ЕстьПрослеживаемыеТовары = Истина;
				УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ОсновноеСредствоПриИзмененииНаСервере(Элементы.ОсновныеСредства.ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетУчетаОСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
		ТекущиеДанные.УчетПоКПС = Ложь;
	Иначе
		ТекущиеДанные.УчетПоКПС = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетУчета).УчетПоКПС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСтоимостьЕдиницыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ТекКоличество = ?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
	
	ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекКоличество;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Количество <> 0 Тогда
		ТекущиеДанные.СтоимостьЕдиницы = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений") Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(ТекущиеДанные);
	КонецЕсли;	

	ТекКоличество = ?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
	
	ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьЕдиницы * ТекКоличество;
	ТекущиеДанные.СуммаАмортизации = Мин(ТекущиеДанные.СуммаАмортизации, ТекущиеДанные.Сумма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	ОбъектНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		Шаблон =  НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ""%1"" на закладке ""Драгоценные материалы""?'");
		ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, СокрЛП(ОбъектНаУдаление)), РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);

		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений") 
			И НЕ ТекущиеДанные.ОтразитьВКарточкеКапвложений Тогда
			ТекущиеДанные.ОтразитьВКарточкеКапвложений = Истина;
		КонецЕсли;	
		
		//Если Не Копирование Тогда
		//	ТекущиеДанные.Количество = 1;
		//	ПересчитатьСуммыТекущейСтроки(ТекущиеДанные);
		//	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные);
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПрослеживаемостьФормыБГУКлиент.ОсновныеСредстваВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
	ОбщегоНазначенияБГУКлиент.РешениеСотрудникаПоРезолюцииВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПослеУдаления(Элемент)
	
	Если ВедетсяУчетПрослеживаемыхТоваров И ЕстьПрослеживаемыеТовары Тогда
		ОсновныеСредстваПослеУдаленияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваПослеУдаленияНаСервере()
	
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ПараметрыПодбора = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ОсновныеСредства");
	ПараметрыПодбора.ЭтоПоступление = Ложь;
	ПараметрыПодбора.ТекущийДокумент = Объект.Ссылка;
	ПараметрыПодбора.Период = Объект.Дата;
	ПараметрыПодбора.ВнеоборотныйАктив = ТекущиеДанные.ОсновноеСредство;
	ПараметрыПодбора.Организация = Объект.Организация;
	ПараметрыПодбора.ИмяКолонкиНоменклатура = "ОсновноеСредство";
	ПараметрыПодбора.ПредставлениеКолонкиНоменклатура = НСтр("ru = 'Основное средство'");
	ПараметрыПодбора.ИмяФормыПодбора = "ФормаПодбораРНПТДляОС";
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТОчистка(Элемент, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияНачалоВыбора(
		Элемент, Элементы.ОсновныеСредства.ТекущиеДанные, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПричинаСписанияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияОбработкаВыбора(
		Элементы.ОсновныеСредства.ТекущиеДанные, ВыбранноеЗначение);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокНФАДокументаОснования

&НаКлиенте
Процедура СписокНФАДокументаОснованияПриАктивизацииСтроки(Элемент)
	
	Если (Элемент.ТекущиеДанные <> Неопределено) И (ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА) Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДрагоценныеМатериалы

&НаКлиенте
Процедура ДрагоценныеМатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоСписаниеКапвложений = 
				Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений");
				
	Если НоваяСтрока И НЕ Копирование И ЭтоСписаниеКапвложений Тогда
		
		ТекущиеДанные = Элементы.ДрагоценныеМатериалы.ТекущиеДанные;
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущиеДанные);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДрагоценныеМатериалыОбъектМЦОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	Если НЕ Элемент.ТекстРедактирования = Строка(ВыбранноеЗначение) Тогда
		
		ТекущиеДанные = Элементы.ДрагоценныеМатериалы.ТекущиеДанные;
		ТекущиеДанные.ОбъектМЦ = ВыбранноеЗначение;
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущиеДанные);
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставКомиссии

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	УстановитьДоступностьКомиссии();
	
	Если Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
