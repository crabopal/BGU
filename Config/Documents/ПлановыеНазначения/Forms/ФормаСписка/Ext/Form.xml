	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ВидПоказателя</Field>
				<Field>Список.Ссылка</Field>
				<Field>Список.УточнениеПоказателя</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПлановыеНазначения.Ссылка КАК Ссылка,
	ДокументПлановыеНазначения.ВерсияДанных КАК ВерсияДанных,
	ДокументПлановыеНазначения.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПлановыеНазначения.Номер КАК Номер,
	ДокументПлановыеНазначения.Дата КАК Дата,
	ДокументПлановыеНазначения.Проведен КАК Проведен,
	ДокументПлановыеНазначения.Организация КАК Организация,
	ДокументПлановыеНазначения.ИФО КАК ИФО,
	ДокументПлановыеНазначения.ВидПоказателя КАК ВидПоказателя,
	ДокументПлановыеНазначения.УточнениеПоказателя КАК УточнениеПоказателя,
	ДокументПлановыеНазначения.КФО КАК КФО,
	ДокументПлановыеНазначения.Субсидия КАК Субсидия,
	ДокументПлановыеНазначения.ПланПоступленийВыбытий КАК ПланПоступленийВыбытий,
	ДокументПлановыеНазначения.Периодичность КАК Периодичность,
	ДокументПлановыеНазначения.ГодПлана КАК ГодПлана,
	ДокументПлановыеНазначения.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	ДокументПлановыеНазначения.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	ДокументПлановыеНазначения.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	ДокументПлановыеНазначения.Подразделение КАК Подразделение,
	ДокументПлановыеНазначения.Комментарий КАК Комментарий,
	ПлановыеНазначенияПоказателиПлана.Поступления КАК Поступления,
	ПлановыеНазначенияПоказателиПлана.Выбытия КАК Выбытия,
	ДокументПлановыеНазначения.МоментВремени КАК МоментВремени,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументПлановыеНазначения.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО
ИЗ
	Документ.ПлановыеНазначения КАК ДокументПлановыеНазначения
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументПлановыеНазначения.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
