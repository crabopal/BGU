КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ДоступностьПодразделения();
КонецПроцедуры

&НаКлиенте
Процедура УчреждениеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;	
КонецПроцедуры

&НаКлиенте
Процедура НадписьХарактеристикиПланаНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", 				Истина);
	ПараметрыФормы.Вставить("Организация", 				Объект.Организация);
	ПараметрыФормы.Вставить("Отбор", 					Новый Структура("Организация", Объект.Организация));
	ПараметрыФормы.Вставить("ИФО", 						Объект.ИФО);
    ПараметрыФормы.Вставить("ПланПоступленийВыбытий", 	Объект.ПланПоступленийВыбытий);
	ПараметрыФормы.Вставить("КлючЗаписи", Новый Структура("Организация, КФО, ВидПоказателя, Субсидия, ИФО, УточнениеПоказателя",	
	Объект.Организация, Объект.КФО, Объект.ВидПоказателя, Объект.Субсидия, Объект.ИФО, Объект.УточнениеПоказателя));	
	
	ОткрытьФорму("РегистрСведений.ПланыПоПоступлениямВыбытиямОрганизаций.ФормаСписка", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ Объект.Периодичность = ВыбранноеЗначение И Объект.ПоказателиПлана.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'При изменении периодичности будет очищена колонка""Отчетный период""!
									|Продолжить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Перезаполнить таблицу ""Материальные запасы""'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять документ-основание'"));

		ДополнительныеПараметры = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПериодичностьОбработкаВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);

		
		СтандартнаяОбработка = Ложь;
		
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьОбработкаВыбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;
	
	Объект.Периодичность = ДополнительныеПараметры.ВыбранноеЗначение;
    
    Для Каждого Стр Из Объект.ПоказателиПлана Цикл
		Стр.ОтчетныйПериод = "";
	КонецЦикла;	
	
	Модифицированность = Истина;
    
КонецПроцедуры

&НаКлиенте
Процедура ВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура();
