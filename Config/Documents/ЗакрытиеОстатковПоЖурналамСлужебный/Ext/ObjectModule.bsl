			// Уберем остаток по журналу на счет 000
			
			НовПроводка = ТаблицаПроводок.Добавить();
			
			НовПроводка.Активность = Истина;
			НовПроводка.Период = ДатаПроводки;
			НовПроводка.Организация = Организация;
			НовПроводка.УточнениеПериода = УточнениеПериода;
			НовПроводка.ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.СлужебныеОперации");
						
			НовПроводка.Содержание = НСтр("ru = 'Закрытие остатков по журналам'");
			
			НовПроводка.КФО = Выборка.КФО;
			НовПроводка.ИФО = Выборка.ИФО;
			НовПроводка.ЖурналОпераций = Выборка.ЖурналОпераций; 

			
			Если Выборка.Сторона = "Дт" Тогда
				
				НовПроводка.Сумма = Выборка.СуммаОстатокДт;
				НовПроводка["КоличествоКт"] = Выборка.КоличествоОстатокДт;
				НовПроводка["ВалютнаяСуммаКт"] = Выборка.ВалютнаяСуммаОстатокДт;
				НовПроводка["ВалютаКт"] = Выборка.Валюта;
				
