#Область ПрограммныйИнтерфейс

Процедура ОчиститьДвиженияВТЧ(ОбъектСсылка, ПометкаУдаления = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗакрытиеОстатковПоЖурналамСлужебныйДокументы.ДокСсылка КАК ДокСсылка
	|ИЗ
	|	Документ.ЗакрытиеОстатковПоЖурналамСлужебный.СписокДокументов КАК ЗакрытиеОстатковПоЖурналамСлужебныйДокументы
	|ГДЕ
	|	ЗакрытиеОстатковПоЖурналамСлужебныйДокументы.Ссылка = &Ссылка
	|	И ЗакрытиеОстатковПоЖурналамСлужебныйДокументы.ДокСсылка.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка",ОбъектСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ДокСсылка.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = ПометкаУдаления;
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	
КонецПроцедуры

