#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеВидимостьюЭлементов()
	Элементы.МаксимальноеКоличествоСтрокВДокументе.Видимость = Объект.МаксимальноеКоличествоПроводокВДокументе <> 0;
	Элементы.ОграничитьКоличествоПроводокВДокументе.Видимость = Объект.МаксимальноеКоличествоПроводокВДокументе = 0;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимуюТаблицу()
	
	ПроведенныеДокументы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументЗакрытиеГодаТехнологическое.ДокСсылка КАК ДокСсылка
	|ИЗ
	|	Документ.ЗакрытиеОстатковПоЖурналамСлужебный.СписокДокументов КАК ДокументЗакрытиеГодаТехнологическое
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ДокументЗакрытиеГодаТехнологическое.ДокСсылка = ОперацииДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|		ПО ДокументЗакрытиеГодаТехнологическое.ДокСсылка = ЖурналПроводокЕПСБУ.Регистратор
	|			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)}
	|ГДЕ
	|	ДокументЗакрытиеГодаТехнологическое.ДокСсылка В(&МассивСсылок)
	|	И НЕ ОперацииДокументов.Операция ЕСТЬ NULL 
	|	И НЕ ЖурналПроводокЕПСБУ.Период ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("МассивСсылок",Объект.СписокДокументов.Выгрузить().ВыгрузитьКолонку("ДокСсылка"));
	
	ПроведенныеДокументы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	НПП = 1;
	
	Для Каждого Строка Из ПроведенныеДокументы Цикл
		Строка.НомерСтроки = НПП;
		НПП = НПП + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроведенныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДокСсылка = Элемент.ТекущиеДанные.ДокСсылка;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Ключ", ДокСсылка);
	
	ФормаДокумента = ПолучитьФорму("Документ.ЗакрытиеГодаТехнологическое.Форма.ФормаДокумента", ПараметрыФормы);
	
	ФормаДокумента.ТолькоПросмотр = Истина;
	
	ФормаДокумента.Открыть();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Элементы.ФормаБухгалтерскиеПроводки.Доступность = Объект.Проведен;
	
КонецПроцедуры

