
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Документ = Параметры.Документ;
	ДатаОперации = Документ.Дата;
	Организация = Документ.Организация;
	
	Если ЗначениеЗаполнено(Параметры.Регистраторы) Тогда
		Регистраторы = Параметры.Регистраторы.Выгрузить(,"ДокСсылка").ВыгрузитьКолонку("ДокСсылка");
	Иначе
		Регистраторы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "СписокДокументов").Выгрузить().ВыгрузитьКолонку("ДокСсылка");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(БухгалтерскиеПроводки, "Регистраторы", Регистраторы, Истина);
	
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Бухгалтерская операция: %1'"), Строка(Документ));
	
КонецПроцедуры

&НаКлиенте
Процедура БухгалтерскиеПроводкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти
