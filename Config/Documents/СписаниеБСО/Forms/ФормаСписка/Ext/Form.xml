	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.ПервичныйДокумент</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументСписаниеБСО.Ссылка КАК Ссылка,
	ДокументСписаниеБСО.ВерсияДанных КАК ВерсияДанных,
	ДокументСписаниеБСО.ПометкаУдаления КАК ПометкаУдаления,
	ДокументСписаниеБСО.Номер КАК Номер,
	ДокументСписаниеБСО.Дата КАК Дата,
	ВЫБОР
		КОГДА ДокументСписаниеБСО.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ДокументСписаниеБСО.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ДокументСписаниеБСО.Проведен КАК Проведен,
	ДокументСписаниеБСО.Организация КАК Организация,
	ДокументСписаниеБСО.ИФО КАК ИФО,
	ДокументСписаниеБСО.ЦМО КАК ЦМО,
	ДокументСписаниеБСО.Подразделение КАК Подразделение,
	ЕСТЬNULL(ДокументСписаниеБСО.Комиссия.НомерПриказа, ДокументСписаниеБСО.НомерПриказа) КАК НомерПриказа,
	ЕСТЬNULL(ДокументСписаниеБСО.Комиссия.ДатаПриказа, ДокументСписаниеБСО.ДатаПриказа) КАК ДатаПриказа,
	ДокументСписаниеБСО.ДолжностьПредседательКомиссии КАК ДолжностьПредседательКомиссии,
	ДокументСписаниеБСО.ФамилияПредседательКомиссии КАК ФамилияПредседательКомиссии,
	ДокументСписаниеБСО.ИмяПредседательКомиссии КАК ИмяПредседательКомиссии,
	ДокументСписаниеБСО.ОтчествоПредседательКомиссии КАК ОтчествоПредседательКомиссии,
	ДокументСписаниеБСО.ДокументОснование КАК ДокументОснование,
	ДокументСписаниеБСО.ПериодСписанияДатаС КАК ПериодСписанияДатаС,
	ДокументСписаниеБСО.ПериодСписанияДатаПо КАК ПериодСписанияДатаПо,
	ДокументСписаниеБСО.Комментарий КАК Комментарий,
	ДокументСписаниеБСО.КФО КАК КФО,
	ДокументСписаниеБСО.МоментВремени КАК МоментВремени,
	ДокументСписаниеБСО.ПервичныйДокумент КАК ПервичныйДокумент,
	ОперацииДокументов.Операция КАК Операция,
	ДокументСписаниеБСО.СчетУчета КАК СчетУчета,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументСписаниеБСО.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
