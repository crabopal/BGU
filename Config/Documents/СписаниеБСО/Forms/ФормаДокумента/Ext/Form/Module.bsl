Процедура СоставБСОПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	УстановитьМаскуПолейПорядковогоНомера(ТекущиеДанные.ДлинаНомера);
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура  СоставБСООбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПричиныСписанияНФА") Тогда
		ЭтоАктОСписании0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н");
		ИмяКолонки = ?(ЭтоАктОСписании0510461, "ПричинаСписанияСсылка", "ПричинаСписания");

		МассивСтрок = Элементы.СоставБСО.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.СоставБСО.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр[ИмяКолонки] = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

