	Элементы52н.Добавить("ОтчествоПредседательКомиссии");
	Элементы52н.Добавить("ВыбратьПредседателя");
	Элементы52н.Добавить("ЗаключениеКомиссии");
	Элементы52н.Добавить("СоставБСОПричинаСписания");
	Элементы52н.Добавить("СоставБСОДатаУничтожения");
