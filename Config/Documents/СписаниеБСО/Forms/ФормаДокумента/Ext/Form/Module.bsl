	Элементы = Форма.Элементы;
	
	ЭтоАктОСписании0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н");
	
	// Элементы только акта списания 0510461
	Элементы61н = Новый Массив;
	Элементы61н.Добавить("ТребуетсяУтилизация");
	Элементы61н.Добавить("НадписьГолосование");
