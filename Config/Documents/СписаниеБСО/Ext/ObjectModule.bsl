#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	ОчиститьДублирующиесяИдентификаторыСтрок();
	ОбщегоНазначенияБГУ.ЗаполнитьИдентификаторыСтрок(СоставБСО, Ложь);
	ОбщегоНазначенияБГУ.ОчиститьВидМежотчетногоПериода(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.СписаниеБСО.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДвиженияБСО")
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	УправлениеМатериальнымиЗапасами.ПроверитьПравильностьЗаполненияТаблицыБСО(СоставБСО, Отказ);
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	Если Не ПодразделениеЗаполнятьОбязательно() Тогда
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения) Тогда
		ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокОснование = Неопределено;
		ДанныеЗаполнения.Свойство("Основание", ДокОснование);
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияКассы.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ОбщегоНазначенияБГУ.ОчиститьВидМежотчетногоПериода(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исправление ошибки 00-00764498.
// При добавлении строки в Подборе БСО возможно дублирование идентификатора строки.
// Если так получилось, то нужно очистить идентификатор, иначе неправильно выводятся существующие результаты голосования.
// А также нельзя записать новые результаты голосования.
Процедура ОчиститьДублирующиесяИдентификаторыСтрок()
	ИспользуемыеИдентификаторы = Новый Соответствие;
	Для Каждого Строка Из СоставБСО Цикл
		Если ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
			Если ИспользуемыеИдентификаторы.Получить(Строка.ИдентификаторСтроки) <> Неопределено Тогда
				// Дубль идентификатора строки
				Строка.ИдентификаторСтроки = "";
			Иначе
				ИспользуемыеИдентификаторы.Вставить(Строка.ИдентификаторСтроки, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПодразделениеЗаполнятьОбязательно()
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
		Возврат (СвойстваСчета.УчетПоПодразделениям И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение);
	КонецЕсли;
	Возврат Ложь
КонецФункции

Функция ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		И ДанныеЗаполнения.Свойство("Разделитель");
КонецФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДанныеЗаполнения - Структура:
//   * Разделитель - Структура
//   * ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьБСО
Процедура ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения)
	СоставБСО.Очистить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Разделитель);
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация"));
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору("АктОСписанииБСО0510461_157н");
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("03.1", Дата, Организация);
	КонецЕсли;
	Документы.СписаниеБСО.ЗаполнитьПоИнвентаризации0510465(
		ДанныеЗаполнения.ДокументОснование,
		ЭтотОбъект)
КонецПроцедуры

#КонецОбласти

#КонецЕсли