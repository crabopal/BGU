#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.Печать

// Заполняет список команд печати.
// 
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеБСО";
	КомандаПечати.Идентификатор		= "АктОСписанииБСО0510461_157н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт списания БСО'"), "0510461", "61н", "157н");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеБСО";
	КомандаПечати.Идентификатор		= "СписаниеБСО0504816_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Акт списания БСО'"), "0504816", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеБСО";
	КомандаПечати.Идентификатор		= "СписаниеБСО_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Акт списания БСО'"), "0504816", "52н", , Истина);
	КомандаПечати.Порядок			= 3;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеБСО";
	КомандаПечати.Идентификатор		= "СписаниеБСО";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт списания БСО'");
	КомандаПечати.Порядок			= 99;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписанииБСО0510461_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьАктОСписанииБСО0510461(МассивОбъектов,
			ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
			НСтр("ru = 'Акт списания БСО'"), "0510461", "61н", "157н");
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеБСО0504816_103н") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СписаниеБСО0504816_103н",
			"Акт списания БСО", ПечатьАкта(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияБСО0504816_103н"));

	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеБСО_52н") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СписаниеБСО_52н",
			"Акт списания БСО", ПечатьАкта(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияБСО_52н"));

	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеБСО") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СписаниеБСО", "Акт списания БСО",
			ПечатьАкта(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияБСО"));

	КонецЕсли;
	
КонецПроцедуры // Печать()

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область Печать

// Добавить данные для печати акта о списании БСО ф.0510461.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОСписанииБСО0510461
//  МассивОбъектов - Массив из ДокументСсылка.СписаниеБСО
Процедура ДобавитьДанныеДляПечатиАктаОСписанииБСО0510461(ДанныеДляПечати, МассивОбъектов) Экспорт

	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОСписанииБСО0510461());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыБСОДляПечатиАктаОСписанииБСО0510461());
	ЧастиЗапроса.Добавить(УправлениеПечатьюБГУ.ТекстЗапросаФайлыДляПечатиПриказ61н());
	ЧастиЗапроса.Добавить(ТекстЗапросаКомиссииДляПечатиАктаОСписанииБСО0510461());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать();
	ВыборкаФайлы = РезультатЗапроса[2].Выбрать();
	ВыборкаКомиссииСтарые = РезультатЗапроса[3].Выбрать();
	
	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");
	ОтборПоСсылке = Новый Структура("Ссылка", Неопределено);
	
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеДляПечати.Добавить();
		СтрокаШапки.СписываемыеБСО = УправлениеПечатьюБГУ.ТаблицаБСОДляПечатиАктаОСписанииБСО0510461();
		СтрокаШапки.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаОСписанииБСО0510461();
		СтрокаШапки.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиАктаОСписанииБСО0510461();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаШапка.УполномоченноеЛицо);
		СотрудникиДокумента.Добавить(ВыборкаШапка.Сотрудник);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия, Имя, Отчество, Должность, НаименованиеПолное", ВыборкаШапка.Дата);

		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.УполномоченноеЛицо);
		СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);

		ДанныеЦМО = ДанныеСотрудников.Получить(ВыборкаШапка.Сотрудник);
		Если ДанныеЦМО <> Неопределено Тогда
			СтрокаШапки.ЦМООтправитель = ДанныеЦМО.НаименованиеПолное;
		КонецЕсли;
		
		СтрокаШапки.МестонахождениеОбъектов = ВыборкаШапка.Местонахождение;
		АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			ВыборкаШапка.МестоХранения,
			Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			СтрокаШапки.МестонахождениеОбъектов = СтрШаблон(НСтр("ru = '%1, %2'"),
				СтрокаШапки.МестонахождениеОбъектов,
				АдресМестаХранения);
		КонецЕсли;
		
		ОтборПоСсылке.Ссылка = ВыборкаШапка.Ссылка;
		
		ТабличныеЧасти.Сбросить();
		Пока ТабличныеЧасти.НайтиСледующий(ОтборПоСсылке) Цикл
			СтрокаБСО = СтрокаШапки.СписываемыеБСО.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаБСО, ТабличныеЧасти);
			
			СтрокаБСО.Номера = УправлениеПечатьюБГУ.ПредставлениеНомеровБСОПоПриказу61н(ТабличныеЧасти.НомерНачальный,
				ТабличныеЧасти.НомерКонечный);
			// БСО учитываются только в условной оценке 1 шт. = 1 руб.
			СтрокаБСО.Сумма = СтрокаБСО.Количество;
			СтрокаБСО.Цена = 1;
			
			ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = ТабличныеЧасти.ИдентификаторСтроки;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаБСО, РезультатыГолосованияПоСтроке[0],
					"ИтогГолосования,РезолюцияКомиссииОдобрена,ГолосованиеПоСтрокеЗавершено");
			КонецЕсли;

		КонецЦикла;
	
		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(ОтборПоСсылке) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;

		ДанныеКомиссий = СтрокаШапки.СоставКомиссии;
		Если ЗначениеЗаполнено(ВыборкаШапка.Комиссия) Тогда
			// Председатель
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
			СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого Председатель Из СтрокиПредседатель Цикл
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, Председатель);
				СтрокаКомиссия.Председатель = Истина;
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(Председатель);
				СтрокаКомиссия.ИмяФайла = Председатель.ОсобыеОтметки;
			КонецЦикла;
		
			// Члены комиссии
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
			СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, ЧленКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
				СтрокаКомиссия.ИмяФайла = ЧленКомиссии.ОсобыеОтметки;
			КонецЦикла;
		Иначе
			// Председатель
			Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседательКомиссии) Тогда
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				СтрокаКомиссия.Председатель = Истина;
				ФИОПредседателя = Новый Структура;
				ФИОПредседателя.Вставить("Фамилия", ВыборкаШапка.ФамилияПредседательКомиссии);
				ФИОПредседателя.Вставить("Имя", ВыборкаШапка.ИмяПредседательКомиссии);
				ФИОПредседателя.Вставить("Отчество", ВыборкаШапка.ОтчествоПредседательКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОПредседателя);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаШапка.ДолжностьПредседательКомиссии;
			КонецЕсли;
			// Члены комиссии
			ВыборкаКомиссииСтарые.Сбросить();
			Пока ВыборкаКомиссииСтарые.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
				СтрокаКомиссия = ДанныеКомиссий.Добавить();
				ФИОЧленаКомиссии = Новый Структура;
				ФИОЧленаКомиссии.Вставить("Фамилия", ВыборкаКомиссииСтарые.ФамилияЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Имя", ВыборкаКомиссииСтарые.ИмяЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Отчество", ВыборкаКомиссииСтарые.ОтчествоЧленаКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОЧленаКомиссии);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаКомиссииСтарые.ДолжностьЧленаКомиссии;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.АктСписанияМЗ -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.СчетУчета КАК СчетУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 11
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И (ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|		ИЛИ ДанныеИнвентаризации.КоличествоНеСоответствует <> 0)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.СчетУчета КАК СчетУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И (СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 11
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И (ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|		ИЛИ ДанныеИнвентаризации.КоличествоНеСоответствует <> 0)";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = УправлениеНФА.УдалитьПолеИзТекстЗапроса(Запрос.Текст, "ИФО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	СписаниеБСО.Ссылка КАК Ссылка,
	|	СписаниеБСО.ДокументОснование,
	|	СоставДокумента.БСО,
	|	СоставДокумента.СерияБСО КАК СерияБСО,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача),
	|	СписаниеБСО.ЦМО.МестоХранения,
	|	СоставДокумента.Количество,
	|	СоставДокумента.НомерНачальный КАК НомерНачальный,
	|	СоставДокумента.НомерКонечный КАК НомерКонечный
	|ИЗ
	|	Документ.СписаниеБСО КАК СписаниеБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО.СоставБСО КАК СоставДокумента
	|		ПО СписаниеБСО.Ссылка = СоставДокумента.Ссылка
	|ГДЕ
	|	СписаниеБСО.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ СписаниеБСО.ПометкаУдаления
	|	И СписаниеБСО.Ссылка <> &СписаниеБСОСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ГолосованиеКомиссиии

// Заполнить результат голосования.
// 
// Параметры:
//  Форма - см. Документ.СписаниеБСО.Форма.ФормаДокумента
Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЭтоАктОСписании0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н");
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация)
		И ЭтоАктОСписании0510461;
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставБСО Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Управление элементами голосования.
// 
// Параметры:
//  Форма - см. Документ.СписаниеБСО.Форма.ФормаДокумента
Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоАктОСписании0510461 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "АктОСписанииБСО0510461_157н");
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация)
		И ЭтоАктОСписании0510461;
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СоставБСОИтогГолосования");
	ЭлементыГолосование.Добавить("СоставБСОРезолюцияКомиссииОдобрена");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ЭтоАктОСписании0510461);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("СоставБСОУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("СоставБСОРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник)
		И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДокументИнвентаризации - ДокументСсылка.ИнвентаризационнаяОписьБСО - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.СписаниеБСО, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510465(ДокументИнвентаризации, ЗаполняемыйДокумент) Экспорт 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НФАУчетныхДокументов.ДокументИнвентаризации,
	|	НФАУчетныхДокументов.НФА КАК БСО,
	|	НФАУчетныхДокументов.СерияБСО КАК СерияБСО,
	|	НФАУчетныхДокументов.МестоИнвентаризации КАК МестоИнвентаризации,
	|	НФАУчетныхДокументов.Количество КАК Количество,
	|	НФАУчетныхДокументов.НомерНачальный КАК НомерНачальный,
	|	НФАУчетныхДокументов.НомерКонечный КАК НомерКонечный
	|ИЗ
	|	НФАУчетныхДокументов1 КАК НФАУчетныхДокументов
	|ГДЕ
	|	НФАУчетныхДокументов.Ссылка ССЫЛКА Документ.СписаниеБСО
	|;
	|
	|ВЫБРАТЬ
	|	ДанныеДокументаИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокументаИнвентаризации.БСО КАК БСО,
	|	ДанныеДокументаИнвентаризации.Серия КАК СерияБСО,
	|	ДанныеДокументаИнвентаризации.НачальныйНомерНедостачаНеПодтверждено КАК НомерНачальный,
	|	ДанныеДокументаИнвентаризации.КонечныйНомерНедостачаНеПодтверждено КАК НомерКонечный,
	|	ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено КАК Количество
	|ИЗ
	|	ДанныеДокументаИнвентаризации2 КАК ДанныеДокументаИнвентаризации
	|ГДЕ
	|	ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|	И ДанныеДокументаИнвентаризации.БСО <> ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	РанееУчтенныеБСО = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить();
	НеУчтенныеБСО = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	НеУчтенныеБСО = УправлениеМатериальнымиЗапасами.ВычестьРанееУчтенныеБСОИзТаблицы(НеУчтенныеБСО, РанееУчтенныеБСО);
	
	Для Каждого СтрокаБСО Из НеУчтенныеБСО Цикл
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент.СоставБСО.Добавить(), СтрокаБСО);
	КонецЦикла;
	УправлениеМатериальнымиЗапасами.УстановитьФорматированныйНомерБСО(ЗаполняемыйДокумент.СоставБСО);

КонецПроцедуры

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка.СписаниеБСО - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	СчетУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "СчетУчета");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоПодразделениям;
											
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	СписаниеБСО.Ссылка.Организация КАК Организация,
	|	СписаниеБСО.Ссылка.ИФО КАК ИФО,
	|	СписаниеБСО.Ссылка.КФО КАК КФО,
	|	СписаниеБСО.Ссылка.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА СписаниеБСО.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	СписаниеБСО.БСО,
	|	СписаниеБСО.СерияБСО,
	|	СписаниеБСО.НомерНачальный,
	|	СписаниеБСО.НомерКонечный,
	|	СписаниеБСО.Количество,
	|	СписаниеБСО.Ссылка.Дата КАК Период,
	|	СписаниеБСО.Ссылка.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.СписаниеБСО.СоставБСО КАК СписаниеБСО
	|ГДЕ
	|	СписаниеБСО.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписаниеБСО.НомерСтроки";	
	
	Запрос.УстановитьПараметр("Ссылка", 							ДокументСсылка);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	
	ДвиженияБСО = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ДвиженияБСО",  ДвиженияБСО);

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область Печать

// Функция формирует печатные формы документов
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ИмяМакета - Строка
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьАкта(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписаниеБСО.Ссылка,
	               |	СписаниеБСО.Номер КАК пНомер,
	               |	СписаниеБСО.Дата КАК пДата,
	               |	СписаниеБСО.Организация,
	               |	СписаниеБСО.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	               |	СписаниеБСО.Организация.КодОКПО КАК пКодОКПО,
				   |	СписаниеБСО.Организация.ИНН КАК ИНН,
				   |	СписаниеБСО.Организация.КПП КАК КПП,
	               |	СписаниеБСО.ЦМО.Сотрудник КАК МОЛ,
	               |	СписаниеБСО.НомерПриказа КАК пНомерПриказа,
	               |	СписаниеБСО.ДатаПриказа КАК пДатаПриказа,
	               |	СписаниеБСО.ДолжностьПредседательКомиссии Как ДолжностьПредседателяКомиссии,
	               |	СписаниеБСО.ФамилияПредседательКомиссии Как ФамилияПредседателяКомиссии,
	               |	СписаниеБСО.ИмяПредседательКомиссии Как ИмяПредседателяКомиссии,
	               |	СписаниеБСО.ОтчествоПредседательКомиссии Как ОтчествоПредседателяКомиссии,
	               |	СписаниеБСО.ПериодСписанияДатаС КАК пНачПериода,
	               |	СписаниеБСО.ПериодСписанияДатаПо КАК пКонПериода,
	               |	СписаниеБСО.СоставБСО.(
	               |		БСО.Наименование КАК пБСО,
	               |		СерияБСО.Наименование КАК пСерияБСО,
	               |		Количество КАК пКоличество,
	               |		ПричинаСписания КАК пПричинаСписания,
	               |		ДатаУничтожения КАК пДатаУничтожения,
	               |		ВЫБОР
	               |			КОГДА СписаниеБСО.СоставБСО.НомерНачальный = """"
	               |					И СписаниеБСО.СоставБСО.НомерКонечный = """"
	               |				ТОГДА """"
	               |			КОГДА СписаниеБСО.СоставБСО.НомерНачальный = СписаниеБСО.СоставБСО.НомерКонечный
	               |				ТОГДА СписаниеБСО.СоставБСО.НомерНачальный
	               |			КОГДА СписаниеБСО.СоставБСО.НомерНачальный = """"
	               |				ТОГДА СписаниеБСО.СоставБСО.НомерКонечный
	               |			КОГДА СписаниеБСО.СоставБСО.НомерКонечный = """"
	               |				ТОГДА СписаниеБСО.СоставБСО.НомерНачальный
	               |			ИНАЧЕ СписаниеБСО.СоставБСО.НомерНачальный + ""-"" + СписаниеБСО.СоставБСО.НомерКонечный
	               |		КОНЕЦ КАК пНомерБланка,
	               |		НомерСтроки КАК НомерСтроки
	               |	),
	               |	СписаниеБСО.СоставКомиссии.(
	               |		Ссылка КАК Ссылка,
	               |		НомерСтроки,
	               |		ДолжностьЧленаКомиссии,
	               |		ФамилияЧленаКомиссии,
	               |		ИмяЧленаКомиссии,
	               |		ОтчествоЧленаКомиссии
	               |	)
	               |ИЗ
	               |	Документ.СписаниеБСО КАК СписаниеБСО
	               |ГДЕ
	               |	СписаниеБСО.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	пДата,
	               |	НомерСтроки,
	               |	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СписаниеБСО." + ИмяМакета);
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
	ОбластьКомиссия		= Макет.ПолучитьОбласть("Комиссия");
	ОбластьПодвал 		= Макет.ПолучитьОбласть("Подвал");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_АКТСПИСАНИЯБСО";	
	
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ВыборкаКомиссия = ВыборкаШапка.СоставКомиссии.Выбрать();
		СтрокаКомиссия = "";
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(ВыборкаШапка, ВыборкаКомиссия, ОбластьКомиссия, 3, СтрокаКомиссия, Истина);
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", ВыборкаШапка.Организация, ВыборкаШапка.пДата);
		пДиректор = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																		Руководитель.ОтветственноеЛицоФамилия,
																		Руководитель.ОтветственноеЛицоИмя,
																		Руководитель.ОтветственноеЛицоОтчество), Истина);
		ДанныеМОЛ = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное", ВыборкаШапка.МОЛ, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеМОЛ, Истина);
		ПараметрыЗаголовка = Новый Структура("пЧленыКомиссии, пНомер, пДиректор, пМОЛ, пДатаПриказа, пНомерПриказа, пНачПериода, пКонПериода",
												СтрокаКомиссия,
												ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.пНомер),
												пДиректор,
												ДанныеМОЛ.НаименованиеПолное,
												?(ЗначениеЗаполнено(ВыборкаШапка.пДатаПриказа), Формат(ВыборкаШапка.пДатаПриказа, "ДЛФ=D"), """__""________20____г."),
												?(ЗначениеЗаполнено(ВыборкаШапка.пНомерПриказа), ВыборкаШапка.пНомерПриказа, "___________"),
												?(ЗначениеЗаполнено(ВыборкаШапка.пНачПериода), Формат(ВыборкаШапка.пНачПериода, "ДЛФ=D"), """__""________20____г."),
												?(ЗначениеЗаполнено(ВыборкаШапка.пКонПериода), Формат(ВыборкаШапка.пКонПериода, "ДЛФ=D"), """__""________20____г."));
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		ОбластьЗаголовок.Параметры.Заполнить(ПараметрыЗаголовка);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Выборка = ВыборкаШапка.СоставБСО.Выбрать();
		КоличествоСтрок = Выборка.Количество();
		Пока Выборка.Следующий() Цикл
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			Если Выборка.НомерСтроки = КоличествоСтрок Тогда
				МассивВывода = Новый Массив;
				МассивВывода.Добавить(ОбластьСтрока);
				МассивВывода.Добавить(ОбластьВсяКомиссия);
				МассивВывода.Добавить(ОбластьПодвал);
				Если Не ТабличныйДокумент.ПроверитьВывод(МассивВывода) Тогда
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьШапка);
				КонецЕсли;
			ИначеЕсли НЕ ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьШапка);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьВсяКомиссия);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
													   НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ТекстЗапросаШапкиДляПечатиАктаОСписанииБСО0510461()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписаниеБСО.Ссылка,
	|	СписаниеБСО.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	СписаниеБСО.Комиссия.НомерПриказа КАК НомерПриказа,
	|	СписаниеБСО.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	СписаниеБСО.Руководитель КАК УполномоченноеЛицо,
	|	ЕСТЬNULL(СписаниеБСО.ЦМО.Сотрудник.Код, """") КАК УчетныйНомерОтправитель,
	|	ЕСТЬNULL(СписаниеБСО.ЦМО.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Сотрудник,
	|	ЕСТЬNULL(СписаниеБСО.ЦМО.МестоХранения.Наименование, """") КАК Местонахождение,
	|	ЕСТЬNULL(СписаниеБСО.ЦМО.МестоХранения, ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК МестоХранения,
	|	СписаниеБСО.ТребуетсяУтилизация КАК НеобходимостьУничтожения,
	|	"""" КАК МестонахождениеОбъектов,
	|	СписаниеБСО.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	СписаниеБСО.Дата КАК Дата,
	|	СписаниеБСО.Номер КАК Номер,
	|	СписаниеБСО.Организация КАК Организация,
	|	СписаниеБСО.КФО КАК КФО,
	|	СписаниеБСО.ИФО КАК ИФО,
	|	СписаниеБСО.ДолжностьПредседательКомиссии,
	|	СписаниеБСО.ФамилияПредседательКомиссии,
	|	СписаниеБСО.ИмяПредседательКомиссии,
	|	СписаниеБСО.ОтчествоПредседательКомиссии,
	|	СписаниеБСО.Комиссия
	|ИЗ
	|	Документ.СписаниеБСО КАК СписаниеБСО
	|ГДЕ
	|	СписаниеБСО.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
КонецФункции

Функция ТекстЗапросаТаблицыБСОДляПечатиАктаОСписанииБСО0510461()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписаниеБСОСоставБСО.Ссылка КАК Ссылка,
	|	СписаниеБСОСоставБСО.НомерСтроки КАК КодСтроки,
	|	СписаниеБСОСоставБСО.БСО КАК БСО,
	|	СписаниеБСОСоставБСО.СерияБСО КАК Серия,
	|	СписаниеБСОСоставБСО.Количество КАК Количество,
	|	СписаниеБСОСоставБСО.БСО.ЕдиницаИзмерения.Код КАК ЕдИзмКод,
	|	СписаниеБСОСоставБСО.БСО.ЕдиницаИзмерения.Наименование КАК ЕдИзмНаименование,
	|	СписаниеБСОСоставБСО.БСО.Наименование КАК БСОНаименование,
	|	СписаниеБСОСоставБСО.БСО.Код КАК БСОКод,
	|	СписаниеБСОСоставБСО.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	СписаниеБСОСоставБСО.НомерНачальный,
	|	СписаниеБСОСоставБСО.НомерКонечный,
	|	СписаниеБСОСоставБСО.ПричинаСписанияСсылка.Код КАК ПричинаСписанияКод,
	|	СписаниеБСОСоставБСО.ПричинаСписанияСсылка.Наименование КАК ПричинаСписанияНаименование
	|ИЗ
	|	Документ.СписаниеБСО.СоставБСО КАК СписаниеБСОСоставБСО
	|ГДЕ
	|	СписаниеБСОСоставБСО.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
КонецФункции

Функция ТекстЗапросаКомиссииДляПечатиАктаОСписанииБСО0510461()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписаниеБСОСоставКомиссии.Ссылка КАК Ссылка,
	|	СписаниеБСОСоставКомиссии.ДолжностьЧленаКомиссии,
	|	СписаниеБСОСоставКомиссии.ФамилияЧленаКомиссии,
	|	СписаниеБСОСоставКомиссии.ИмяЧленаКомиссии,
	|	СписаниеБСОСоставКомиссии.ОтчествоЧленаКомиссии,
	|	СписаниеБСОСоставКомиссии.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СписаниеБСО.СоставКомиссии КАК СписаниеБСОСоставКомиссии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО КАК СписаниеБСО
	|		ПО СписаниеБСОСоставКомиссии.Ссылка = СписаниеБСО.Ссылка
	|ГДЕ
	|	СписаниеБСО.Ссылка В(&МассивОбъектов)
	|	И СписаниеБСОСоставКомиссии.Ссылка В(&МассивОбъектов)
	|	И СписаниеБСО.Комиссия = ЗНАЧЕНИЕ(Справочник.ПостоянноДействующиеКомиссии.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Обработчик обновления. Версия 2.0.91
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписаниеБСО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеБСО.СоставБСО КАК СписаниеБСОСоставБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО КАК СписаниеБСО
	|		ПО СписаниеБСОСоставБСО.Ссылка = СписаниеБСО.Ссылка
	|ГДЕ
	|	СписаниеБСО.УдалитьИдентификаторПечатнойФормы = ""АктОСписанииБСО0510461_157н""
	|	И СписаниеБСОСоставБСО.ИдентификаторСтроки = """"";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СписаниеБСО";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); // ДокументОбъект.СписаниеБСО
			ОбъектИзменен = Ложь;
			Если Объект <> Неопределено Тогда
				Объект.Заблокировать();
				Если Объект.УдалитьИдентификаторПечатнойФормы = "АктОСписанииБСО0510461_157н" Тогда
					Для Каждого Строка Из Объект.СоставБСО Цикл
						Если Не ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
							Строка.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
							ОбъектИзменен = Истина;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
				
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.СписаниеБСО,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// Многопоточный обработчик обновления. Версия 2.0.97.
// Предыдущий обработчик выполнялся на версии 2.0.91. Маловероятно, что он еще не выполнился.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2(Параметры) Экспорт

	ПервичныеДокументыБГУ.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры,
		Тип("ДокументСсылка.СписаниеБСО"));	
	
КонецПроцедуры

// Парный обработчик к процедуре ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2
// 
// Параметры:
//  Параметры - Структура:
//   * ОбработкаЗавершена - Булево
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию2(Параметры) Экспорт
	
	ПервичныеДокументыБГУ.ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры, Тип("ДокументСсылка.СписаниеБСО"));
	
КонецПроцедуры

// Обработчик обновления. Версия 2.0.102
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию3(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписаниеБСО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеБСО КАК СписаниеБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБСО.СоставБСО КАК СписаниеБСОСоставБСО
	|		ПО СписаниеБСО.Ссылка = СписаниеБСОСоставБСО.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПервичныеДокументы КАК ПервичныеДокументы
	|		ПО СписаниеБСО.ПервичныйДокумент = ПервичныеДокументы.Ссылка
	|ГДЕ
	|	ПервичныеДокументы.Идентификатор = ""АктОСписанииБСО0510461_157н""
	|	И СписаниеБСОСоставБСО.ИдентификаторСтроки = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДокументыКОбработке = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		ДокументыКОбработке.Добавить(Выборка.Ссылка);
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
			ДокументыКОбработке.Очистить();
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
	КонецЕсли;
	
КонецПроцедуры

// Парный обработчик к процедуре ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2
// 
// Параметры:
//  Параметры - Структура -
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию3(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СписаниеБСО";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);

	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			УстановитьНовыйИдентификаторСтрокуИРегистрГолосование(Выборка.Ссылка);
			ОбъектовОбработано = ОбъектовОбработано + 1;
		Исключение
			// Если не удалось обработать какой-либо документ, повторяем попытку снова.
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.СписаниеБСО,
				Выборка.Ссылка,
				ТекстСообщения);
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось обработать некоторые ""%2"" (пропущены): %1'"), 
			ПроблемныхОбъектов,
			ПолноеИмяОбъекта);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта),,
			СтрШаблон(
				НСтр("ru = 'Обработана очередная порция ""%2"": %1'"),
				ОбъектовОбработано,
				ПолноеИмяОбъекта));
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьНовыйИдентификаторСтрокуИРегистрГолосование(Ссылка)
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.СписаниеБСО");
		Элемент.УстановитьЗначение("Ссылка", Ссылка);
		
		Элемент = Блокировка.Добавить("РегистрСведений.РезультатыГолосованияКомиссий");
		Элемент.УстановитьЗначение("ДокументОснование", Ссылка);
		
		Блокировка.Заблокировать();
		
		Объект = Ссылка.ПолучитьОбъект(); // ДокументОбъект.СписаниеБСО
		ОбъектИзменен = Ложь;
		
		Если Объект <> Неопределено Тогда
			Объект.Заблокировать();
		
			ИдентификаторПД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПервичныйДокумент, "Идентификатор");
			Если ИдентификаторПД <> "АктОСписанииБСО0510461_157н" Тогда
				Возврат;
			КонецЕсли;
			
			НаборРегистра = РегистрыСведений.РезультатыГолосованияКомиссий.СоздатьНаборЗаписей();
			НаборРегистра.Отбор.ДокументОснование.Установить(Объект.Ссылка);
			НаборРегистра.Прочитать();
			РегистрИзменен = Ложь;
			
			Для Каждого Строка Из Объект.СоставБСО Цикл
				Если Не ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
					Строка.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
					ОбъектИзменен = Истина;
					Для Каждого СтрокаРегистра Из НаборРегистра Цикл
						Если Не ЗначениеЗаполнено(СтрокаРегистра.ИдентификаторСтроки) Тогда
							СтрокаРегистра.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
							РегистрИзменен = Истина;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ОбъектИзменен Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект, Истина);
		Иначе
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Ссылка);
		КонецЕсли;
	
		Если РегистрИзменен Тогда
			НаборРегистра.Записать(Истина);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

