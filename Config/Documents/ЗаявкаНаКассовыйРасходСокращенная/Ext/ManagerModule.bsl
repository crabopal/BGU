Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531851") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531851",
		"Заявка на кассовый расход (сокращенная)",ПечатьЗаявкиНаРасход(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531851_16н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531851_16н",
		"Заявка на кассовый расход (сокращенная)(в ред. приказа 16н)", ПечатьЗаявкиНаРасход16н(МассивОбъектов, ОбъектыПечати, "_16н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531851_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531851_21н",
		"Заявка на кассовый расход (сокращенная)(в ред. приказа 21н)", ПечатьЗаявкиНаРасход16н(МассивОбъектов, ОбъектыПечати, "_21н"));
	КонецЕсли;    
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531851_19н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПФ_MXL_Форма0531851_19н",
		"Заявка на кассовый расход (сокращенная)(в ред. приказа 19н)", ПечатьЗаявкиНаРасход16н(МассивОбъектов, ОбъектыПечати, "_19н"));
	КонецЕсли;  

КонецПроцедуры

// Функция формирует табличный документ Заявка на кассовый расход (ф.0531851)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявкиНаРасход(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаКассовыйРасходСокращенная_ЗаявкаНаКассовыйРасходСокращенная";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаКассовыйРасходСокращенная.ПФ_MXL_Форма0531851");
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаКассовыйРасходСокращенная(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
