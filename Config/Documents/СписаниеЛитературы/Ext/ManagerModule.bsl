// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы:
// * Материалы - Массив из Строка - имена элементов
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("КПС");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

#Область Печать

// Добавить данные для печати акта списания литературы ф. 0504144.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаСписанияЛитературы0504144
//  МассивДокументов - Массив из ДокументСсылка.СписаниеЛитературы
Процедура ДобавитьДанныеДляПечатиАктаСписанияЛитературы0504144(ДанныеДляПечати, МассивДокументов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивДокументов);
	Запрос.Текст = ТекстЗапросаДляПечатиАкта0510144();	

	Результат			= Запрос.ВыполнитьПакет();
	ВыборкаШапка		= Результат[0].Выбрать(ОбходРезультатаЗапроса.Прямой);
	ВыборкаОС			= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПриложение	= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия		= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаСчета		= Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		НоваяСтрокаДокумента = ДанныеДляПечати.Добавить();
		НоваяСтрокаДокумента.СписокЛитературы = УправлениеПечатьюБГУ.ТаблицаСписокДляПечатиАктаСписанияЛитературы0504144();
		НоваяСтрокаДокумента.Комиссия = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаСписанияЛитературы0504144();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ВыборкаШапка);
		
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация,
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаШапка.Дата);
		НоваяСтрокаДокумента.ОргДиректор = Справочники.Сотрудники.ФамилияИО(Руководитель.ОтветственноеЛицоСсылка, Истина, ВыборкаШапка.Дата);
		
		ВыборкаКомиссия.Сбросить();
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
		Если ВыборкаКомиссия.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаКомиссияТекДок = ВыборкаКомиссия.Выбрать();
		Иначе
			ВыборкаКомиссияТекДок = Неопределено;
		КонецЕсли;
		Если ВыборкаКомиссияТекДок <> Неопределено Тогда
			ВыборкаКомиссияТекДок.Сбросить();
			Пока ВыборкаКомиссияТекДок.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента.Комиссия.Добавить(), ВыборкаКомиссияТекДок);
			КонецЦикла;
		КонецЕсли;

		ВыборкаОСТекДок = Неопределено;
		ВыборкаОС.Сбросить();
		Если ВыборкаОС.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			ВыборкаОСТекДок = ВыборкаОС.Выбрать();
			Пока ВыборкаОСТекДок.Следующий() Цикл
				НоваяСтрокаДокумента.СуммаИтого = НоваяСтрокаДокумента.СуммаИтого + ВыборкаОСТекДок.Сумма;
				НоваяСтрокаДокумента.КоличествоИтого = НоваяСтрокаДокумента.КоличествоИтого + ВыборкаОСТекДок.Количество;
			КонецЦикла;
		КонецЕсли;
		
		СпСчетовДт = Новый Массив;
		СпСчетовКт = Новый Массив;
		ВыборкаСчета.Сбросить();
		Если ВыборкаСчета.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			ВыборкаСчетаТекДок = ВыборкаСчета.Выбрать();
			Пока ВыборкаСчетаТекДок.Следующий() Цикл
				СпСчетовДт.Добавить(УправлениеПечатьюБГУ.ПредставлениеСчета(ВыборкаСчетаТекДок, "Дт"));
				СпСчетовКт.Добавить(УправлениеПечатьюБГУ.ПредставлениеСчета(ВыборкаСчетаТекДок, "Кт"));
			КонецЦикла;
		КонецЕсли;
		СпСчетовДт	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(СпСчетовДт);
		СпСчетовКт	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(СпСчетовКт);
		НоваяСтрокаДокумента.СчетДебета	 = СтрСоединить(СпСчетовДт, Символы.ПС);
		НоваяСтрокаДокумента.СчетКредита = СтрСоединить(СпСчетовКт, Символы.ПС);
		
		НоваяСтрокаДокумента.ПричинаСписания	= ВыборкаШапка.ПричинаСписания;
		
		ВыборкаЛитература = Неопределено;
		ВыборкаПриложение.Сбросить();
		Если ВыборкаПриложение.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка") Тогда
			ВыборкаЛитература = ВыборкаПриложение.Выбрать();
		ИначеЕсли ВыборкаОСТекДок<>Неопределено Тогда
			ВыборкаОСТекДок.Сбросить();
			ВыборкаЛитература = ВыборкаОСТекДок;
		КонецЕсли;
		
		Если ВыборкаЛитература<>Неопределено Тогда
			Пока ВыборкаЛитература.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента.СписокЛитературы.Добавить(), ВыборкаЛитература);
			КонецЦикла; 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументСсылка, "ПринятьНаХранение, Номер, Резервировать");
		
	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"	, НСтр("ru = 'Акт списания библиотечного фонда'"));
	Запрос.УстановитьПараметр("НомерДокумента"	, НомерДокумента);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка КАК Ссылка,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.ПричинаСписания КАК ПричинаСписания,
	|	ТаблицаОсновныеСредства.Ссылка.ПринятьНаХранение КАК ПринятьНаХранение
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.СписаниеЛитературы.ОсновныеСредства КАК ТаблицаОсновныеСредства 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.Ссылка КАК Регистратор,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|	И НЕ ТаблицаОсновныеСредства.ПринятьНаХранение
	|";
	
	// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
	ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления();
	Если РеквизитыДокумента.ПринятьНаХранение Тогда
		ПараметрыСписания.ВидРаспоряженияУКонтрагента	= Перечисления.ВидыРаспоряженияОС.НаХранении;
		ПараметрыСписания.ПоступлениеКонтрагенту		= Истина;
	КонецЕсли;
	УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц,
		ДокументСсылка, ПараметрыСписания);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеЛитературы";
	КомандаПечати.Идентификатор		= "ф0504144_52н";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о списании литературы (ф. 0504144) (52н)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СписаниеЛитературы";
	КомандаПечати.Идентификатор		= "ф0504144";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт о списании литературы (ф. 0504144) (173н)'");
	КомандаПечати.Порядок			= 101;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ф0504144") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ф0504144", "Акт о списании исключенных объектов библиотечного фонда",
			УправлениеПечатьюБГУ.НапечататьАктСписанияЛитературы0504144(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияЛитературы_0504144"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ф0504144_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ф0504144_52н", "Акт о списании исключенных объектов библиотечного фонда",
			УправлениеПечатьюБГУ.НапечататьАктСписанияЛитературы0504144(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияЛитературы_0504144_52н"));
		
	КонецЕсли;
	
КонецПроцедуры

