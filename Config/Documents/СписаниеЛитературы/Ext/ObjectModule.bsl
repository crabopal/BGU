#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры

// Возвращает таблицу значений по данным табличной части документа для формирования режерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
		
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	

	ТабЧасть = ОсновныеСредства.Выгрузить(, "НомерСтроки, ОсновноеСредство, ИнвентарныйНомер, Сумма, Количество, КПС");
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТабЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.Количество КАК Количество,
	|	ТабЧасть.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТабЧасть
	|ИЗ
	|	&ТабЧасть КАК ТабЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОС.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(УчетныеДанныеОС.СчетУчета) КАК СчетУчета
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Дата1, ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ТабЧасть КАК Таб)
	|	И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОС
	|СГРУППИРОВАТЬ ПО
	|	УчетныеДанныеОС.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.Количество КАК Количество,
	|	ТабЧасть.Сумма КАК Сумма,
	|	ЕСТЬNULL(Счета.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
	|ИЗ
	|	ТабЧасть КАК ТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ТабЧасть.ОсновноеСредство = Счета.ОсновноеСредство";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТабЧасть", ТабЧасть);
	Запрос.УстановитьПараметр("Дата1", Дата);
	ТабЧасть = Запрос.Выполнить().Выгрузить();
	
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(
		ТабЧасть.ВыгрузитьКолонку("СчетУчета"));
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Для каждого СтрокаТЧ из ТабЧасть Цикл
	
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, Количество, Сумма, НомерСтроки");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, КФО, ЦМО");
		НоваяСтрока.ПередачаЧастейОбъектов = Ложь;
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		
		Если СтрокаСчета = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрокаСчета.УчетПоКПС Тогда
			НоваяСтрока.КПС = СтрокаТЧ.КПС;
		КонецЕсли;	
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Подразделение;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	
	ТаблицаДока = ТаблицаСписанияОС();

	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(
	ТаблицаДока, ЭтотОбъект, Истина);
	
	Возврат ЕстьОшибки;
КонецФункции

#КонецОбласти		
	
#КонецЕсли