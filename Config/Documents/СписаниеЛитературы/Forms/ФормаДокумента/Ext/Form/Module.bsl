КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение,, "ОсновноеСредство,ИнвентарныйНомер");
		
	РассчитатьСуммуАмортизацииЗаТекущийМесяц(ДобавленныеСтроки);
		
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы()
	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Расчет доступен только в непроведенном документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	РассчитатьСуммыНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоличества(ТекущиеДанные)

	Элементы.ОсновныеСредстваКоличество.ТолькоПросмотр = Не ТекущиеДанные.ГрупповойУчет;
	Если Не ТекущиеДанные.ГрупповойУчет И ТекущиеДанные.Количество <> 1 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьГрупповойУчет()

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство"), "ГрупповойУчет");
	
	Для каждого ТекСтрОС Из Объект.ОсновныеСредства Цикл
		
		ТекОС = ЗначенияРеквизитов[ТекСтрОС.ОсновноеСредство];
		Если ТекОС <> Неопределено Тогда
			ТекСтрОС.ГрупповойУчет =  ТекОС.ГрупповойУчет;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуАмортизацииЗаТекущийМесяц(ДобавленныеСтроки = Неопределено)
	
	Если Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата).НачислятьАмортизациюПервымЧислом Тогда
		Возврат;
	КонецЕсли;
	
	Если ДобавленныеСтроки = Неопределено Тогда
		СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		СписокОС = Новый Массив;
		Для Каждого ДобавленнаяСтрока Из ДобавленныеСтроки Цикл
			СписокОС.Добавить(ДобавленнаяСтрока.ОсновноеСредство);
		КонецЦикла;
	КонецЕсли;

	ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(СписокОС, Объект, Ложь, Ложь, Ложь);
	
	СтрокиОбхода = ?(ДобавленныеСтроки = Неопределено, Объект.ОсновныеСредства, ДобавленныеСтроки); 
	
	Для Каждого СтрокаТаблицы Из СтрокиОбхода Цикл
		
		СтрокаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаАмортизации = Неопределено Тогда
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = 0;
		Иначе			
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = СтрокаАмортизации.СуммаАмортизацииБУ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

