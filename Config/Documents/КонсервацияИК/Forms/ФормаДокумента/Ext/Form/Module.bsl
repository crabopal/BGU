// Работа формы

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация", "Организация");
	СтруктураРеквизитов.Вставить("Дата", "Дата");
	
	Возврат СтруктураРеквизитов;

КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"		, ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ПараметрыПодбора.Отбор.Вставить("Счет"			, "108.00");
	
	Если Объект.ВидОперации < 2 Тогда
		ПараметрыПодбора.Отбор.Вставить("СпособНачисленияАмортизации", ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
		ПараметрыПодбора.Отбор.Вставить("ГрупповойУчет", Ложь);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"		, ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("НужнаАмортизация"	, Истина);
	ПараметрыПодбора.Вставить("СкрытьКолонки"		, "ВидНФА,ИФО,КФО,КПС,СчетУчета,ЦМО,Подразделение,Цена");
	ПараметрыПодбора.Вставить("КолонкиКорзины"		, Новый Структура("Сумма", "БалансоваяСтоимость"));
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОССервер(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	ТаблицаОС.Колонки.Добавить("Количество");
	ТаблицаОС.ЗаполнитьЗначения(1, "Количество");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(ВыбранноеЗначение)
	
	УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(Объект.ОсновныеСредства, ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваОсновноеСредствоПриИзмененииСервер(ТекущаяСтрока)
	
	ТекущаяСтрокаТаб = Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока);
	
	ТаблицаОС = ПолучитьДанныеОС(ТекущаяСтрокаТаб.ОсновноеСредство, Объект.Дата);
	
	Если ТаблицаОС.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрокаТаб, ТаблицаОС[0]);
	Иначе
		ТекущаяСтрокаТаб.ИнвентарныйНомер		= Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		ТекущаяСтрокаТаб.БалансоваяСтоимость	= 0;
		ТекущаяСтрокаТаб.СуммаАмортизации		= 0;
		ТекущаяСтрокаТаб.Срок					= 0;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОС(ОсновныеСредства, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОС", ОсновныеСредства);
	Запрос.УстановитьПараметр("Период", Период);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СобытияОССрезПоследних.ОсновноеСредство,
	               |	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	               |ПОМЕСТИТЬ ВТ_ИнвНомер
	               |ИЗ
	               |	РегистрСведений.СобытияОС.СрезПоследних(
	               |			&Период,
	               |			ОсновноеСредство В (&ОС)
	               |				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	               |	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК БалансоваяСтоимость
	               |ПОМЕСТИТЬ ВТ_Стоимость
	               |ИЗ
	               |	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Период, ОсновноеСредство В (&ОС)) КАК СтоимостьОбъектовОСОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АмортизацияОбъектовОСОстатки.ОсновноеСредство,
	               |	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации
	               |ПОМЕСТИТЬ ВТ_Амортизация
	               |ИЗ
	               |	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&Период, ОсновноеСредство В (&ОС)) КАК АмортизацияОбъектовОСОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	               |	ВТ_ИнвНомер.ИнвентарныйНомер,
	               |	ВТ_Стоимость.БалансоваяСтоимость,
	               |	ВТ_Амортизация.СуммаАмортизации
	               |ИЗ
	               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомер КАК ВТ_ИнвНомер
	               |		ПО ОсновныеСредства.Ссылка = ВТ_ИнвНомер.ОсновноеСредство
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Стоимость КАК ВТ_Стоимость
	               |		ПО ОсновныеСредства.Ссылка = ВТ_Стоимость.ОсновноеСредство
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	               |		ПО ОсновныеСредства.Ссылка = ВТ_Амортизация.ОсновноеСредство
	               |ГДЕ
	               |	ОсновныеСредства.Ссылка В(&ОС)";
				  
	Результат  = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

