// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.Аккредитив";
	КомандаПечати.Идентификатор		= "Аккредитив";
	КомандаПечати.Представление		= НСтр("ru = 'Аккредитив'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Устанавливаем признак доступности печати покомплектно.
	//ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

	// Проверяем, нужно ли для макета ЗаявкаНаКассовыйРасход0531801 формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Аккредитив") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Аккредитив",
			"Аккредитив",
			Печать0401063(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

// Функция формирует табличный документ аккредитив (ф 0401063)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0401063(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент 					= Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Аккредитив_Аккредитив";
	Макет 							= УправлениеПечатью.МакетПечатнойФормы("Документ.Аккредитив.ПФ_MXL_Аккредитив");
	Обл   							= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	
	Для НомерДокумента = 0 по МассивОбъектов.Количество()-1 цикл
	
		Обл.Параметры.Заполнить(ЗначенияРеквизитовАккредитив(МассивОбъектов[НомерДокумента]));
		
		ТабДокумент.Вывести(Обл);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			                                               НомерДокумента+1, ОбъектыПечати, МассивОбъектов[НомерДокумента]);
	КонецЦикла;	
	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

Функция ЗначенияРеквизитовАккредитив(Ссылка)
	
	СтруктураДанных = Новый Структура;

	// Значения реквизитов Платежного поручения 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Поручение.Номер 												КАК НомерДок,
	               |	Поручение.Дата 													КАК ДатаДок,
	               |	ВЫБОР
	               |		КОГДА Поручение.ВидПлатежа = ""1""
	               |			ТОГДА ""электронно""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ 															КАК ВидПлатежа,
	               |	Поручение.ИННПлательщика 										КАК ИноеИННПолучателя,
	               |	Поручение.КПППлательщика 										КАК ИноеКПППолучателя,
	               |	""ИНН "" + Поручение.ИННПлательщика 							КАК ИННПлательщика,
	               |	""КПП "" + Поручение.КПППлательщика								КАК КПППлательщика,
	               |	Поручение.СуммаДокумента 										КАК СуммаДокумента,
	               |	Поручение.ПлательщикНаименование 								КАК ТекстПлательщика,
	               |	Поручение.ПлательщикБанковскийСчет 								КАК НомерСчетаПлательщика,
	               |	Поручение.ПлательщикНаименованиеБанка 							КАК НаименованиеБанкаПлательщика,
	               |	Поручение.ПлательщикБИКБанка 									КАК БИКБанкаПлательщика,
	               |	Поручение.ПлательщикКорСчетБанка 								КАК СчетБанкаПлательщика,
	               |	Поручение.КонтрагентНаименованиеБанка 							КАК НаименованиеБанкаПолучателя,
	               |	Поручение.КонтрагентБИКБанка 									КАК БИКБанкаПолучателя,
	               |	Поручение.КонтрагентКорСчетБанка 								КАК СчетБанкаПолучателя,
	               |	Поручение.КонтрагентИНН 										КАК КонтрагентИНН,
	               |	Поручение.КонтрагентКПП 										КАК КонтрагентКПП,
	               |	""ИНН "" + Поручение.КонтрагентИНН 								КАК ИННПолучателя,
	               |	""КПП "" + Поручение.КонтрагентКПП 								КАК КПППолучателя,
	               |	Поручение.КонтрагентНаименование 								КАК ТекстПолучателя,
	               |	Поручение.КонтрагентБанковскийСчет 								КАК НомерСчетаПолучателя,
	               |	Поручение.СрокДействия 											КАК СрокДействия,
	               |	Поручение.НазначениеПлатежа 									КАК НазначениеПлатежа,
	               |	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.МесяцПрописью, ЛОЖЬ)	КАК МесяцПрописью,
	               |	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.СуммаБезКопеек, ЛОЖЬ) КАК СуммаБезКопеек,
	               |	Поручение.ЛицевойСчет 											КАК ЛицевойСчет,
	               |	Поручение.РеквизитыЛицевогоСчета 								КАК РеквизитыЛицевогоСчета,
	               |	Поручение.Организация 											КАК Организация,
	               |	Поручение.СчетКонтрагента 										КАК СчетКонтрагента,
	               |	Поручение.ВидАккредитива 										КАК ВидАккредитива,
	               |	Поручение.УсловиеОплаты 										КАК УсловиеОплаты,
	               |	Поручение.ПлатежПоПредставлению 								КАК ПлатежПоПредставлению,
	               |	Поручение.ДополнительныеУсловия 								КАК ДополнительныеУсловия,
	               |	ВЫБОР
	               |		КОГДА Поручение.ПризнакПокрытия = ""1""
	               |			ТОГДА Поручение.НомерСчетаПоУчетуАккредитивов
	               |		ИНАЧЕ """"
	               |	КОНЕЦ 															КАК НомерСчетаПоУчетуАккредитивов
	               |ИЗ
	               |	Документ.Аккредитив КАК Поручение
	               |ГДЕ
	               |	Поручение.Ссылка = &Ссылка";

	МассивРезультатов = Запрос.Выполнить();
	
	Выборка = МассивРезультатов.Выбрать();			   
	Выборка.Следующий();
	
	Для Каждого Колонка ИЗ МассивРезультатов.Колонки Цикл
		СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
	КонецЦикла;
	
	ДополнительныеРеквизиты = УправлениеСвойствами.ЗначенияСвойств(Ссылка, Истина, Ложь);
	
	СтруктураДопРеквизитов = Новый Структура;
	Для каждого ДопРеквизит из ДополнительныеРеквизиты цикл
		ИмяРеквизита = СтрЗаменить(ДопРеквизит.Свойство," ","_");
		Попытка 
			СтруктураДопРеквизитов.Вставить(ИмяРеквизита,ДопРеквизит.Значение);
		Исключение
			ЗаписьЖурналаРегистрации("Документ.Аккредитив", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Аккредитив, Ссылка, "Недопустимые символы идентификатора дополнительного реквизита документа. Печать значения дополнительного реквизита <"+ИмяРеквизита+"> невозможна.");
		КонецПопытки;	
	КонецЦикла;	
	
	Если ДополнительныеРеквизиты.Количество() <> СтруктураДопРеквизитов.Количество() тогда
		ОбщегоНазначения.СообщитьПользователю("Описание ошибки в журнале регистрации.");
	КонецЕсли;	
	
	
	Для каждого ДопРеквизит из СтруктураДопРеквизитов Цикл
		СтруктураДанных.Вставить(ДопРеквизит.Ключ,ДопРеквизит.Значение);
	КонецЦикла;
	
	
		
	// требует преобразования
	СтруктураДанных.Вставить("ДатаДокумента", 	Формат(СтруктураДанных.ДатаДок, "ДФ=" + ?(СтруктураДанных.МесяцПрописью, "'дд ММММ гггг'", "'дд.ММ.гггг'")));
	СтруктураДанных.Вставить("СуммаЧислом",		ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаДокумента, СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.Вставить("СуммаПрописью",	ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаДокумента, , СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.НомерДок = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Ссылка,СтруктураДанных.НомерДок);
	СтруктураДанных.Вставить("НаименованиеНомер","АККРЕДИТИВ № " + СтруктураДанных.НомерДок); 
    	
	
	Возврат СтруктураДанных;
		
КонецФункции	

#КонецОбласти

#КонецЕсли
