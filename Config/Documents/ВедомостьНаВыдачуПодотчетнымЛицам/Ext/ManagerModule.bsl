#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
		
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНаВыдачуПодотчетнымЛицам";
	КомандаПечати.Идентификатор		= "Ведомость0504501_52н";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость на выдачу подотчетным лицам (ф. 0504501)'");
	КомандаПечати.Порядок			= 1;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Ведомость0504501_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Ведомость0504501_52н", "Ведомость на выдачу подотчетным лицам (ф. 0504501)", ПечатьВедомости(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Ведомость0504501_52н"));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

// Заполняет документ данными Заявлений на выдачу аванса
//
// Параметры
//   Объект - ДокументОбъект.ВедомостьНаВыдачуДенегИзкассы, ДанныеФормыСтруктура
//   МассивЗаявлений  - Массив    - Массив ссылок на документы ЗаявлениеНаВыдачуАванса
//   Валюта - СправочникСсылка.Валюты
//   Организация - СправочникСсылка.Организации
//
Процедура ЗаполнитьПоЗаявлениямНаВыдачуАванса(Объект, МассивЗаявлений, Валюта, Организация) Экспорт
	
	Объект.ВалютаДокумента 	= Валюта;
	Объект.Организация 		= Организация;
	
	Объект.РасшифровкаПлатежа.Очистить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка,
	|	КОЛИЧЕСТВО(ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.НомерСтроки) КАК КоличествоСтрок
	|ПОМЕСТИТЬ Строки
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса КАК ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса
	|ГДЕ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка В(&МассивСсылок)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка.Сотрудник,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка КАК ДокументОснование,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка.Подразделение КАК ПодразделениеСотр,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КФО,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КПС,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КЭК,
	|	СУММА(ВЫБОР
	|			КОГДА &Валютный
	|				ТОГДА ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.СуммаВВалюте
	|			ИНАЧЕ ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Сумма
	|		КОНЕЦ) КАК Сумма,
	|	NULL КАК СуммаДокумента,
	|	1 КАК КоличествоСтрок
	|ПОМЕСТИТЬ ДанныеЗаявлений
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса КАК ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса
	|ГДЕ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка В(&МассивСсылок)
	|	И (&Валютный
	|				И ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.СуммаВВалюте > 0
	|			ИЛИ НЕ &Валютный
	|				И ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Сумма > 0
	|			ИЛИ ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.СуммаВВалюте = 0
	|				И ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Сумма = 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка.Подразделение,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КФО,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КЭК,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КПС,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка.Сотрудник
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАванса.Сотрудник,
	|	ЗаявлениеНаВыдачуАванса.Ссылка,
	|	ЗаявлениеНаВыдачуАванса.Подразделение,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	ВЫБОР
	|		КОГДА &Валютный
	|			ТОГДА ЗаявлениеНаВыдачуАванса.СуммаДокументаВВалюте
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.СуммаДокумента
	|	КОНЕЦ,
	|	Строки.КоличествоСтрок
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса КАК ЗаявлениеНаВыдачуАванса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Строки КАК Строки
	|		ПО (Строки.Ссылка = ЗаявлениеНаВыдачуАванса.Ссылка)
	|ГДЕ
	|	ЗаявлениеНаВыдачуАванса.Ссылка В(&МассивСсылок)
	|	И (&Валютный
	|				И ЗаявлениеНаВыдачуАванса.СуммаДокументаВВалюте > 0
	|			ИЛИ НЕ &Валютный
	|				И ЗаявлениеНаВыдачуАванса.СуммаДокумента > 0)
	|	И Строки.КоличествоСтрок ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеЗаявлений.Сотрудник,
	|	ДанныеЗаявлений.ДокументОснование,
	|	ДанныеЗаявлений.ПодразделениеСотр,
	|	ДанныеЗаявлений.КФО,
	|	ДанныеЗаявлений.КПС,
	|	ДанныеЗаявлений.КЭК,
	|	ВЫБОР
	|		КОГДА ДанныеЗаявлений.КоличествоСтрок ЕСТЬ NULL 
	|			ТОГДА ДанныеЗаявлений.СуммаДокумента
	|		ИНАЧЕ ДанныеЗаявлений.Сумма
	|	КОНЕЦ КАК Сумма,
	|	СоответствияАналитическихСчетовКЭК.Счет КАК КорСчет
	|ИЗ
	|	ДанныеЗаявлений КАК ДанныеЗаявлений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ДанныеЗаявлений.КЭК = СоответствияАналитическихСчетовКЭК.КЭК
	|			И (СоответствияАналитическихСчетовКЭК.Счет В (&Счет208))
	|			И (НЕ СоответствияАналитическихСчетовКЭК.Счет.ЭлементГруппа)");	
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаявлений);
	Запрос.УстановитьПараметр("Валютный", ЗначениеЗаполнено(Валюта) И НЕ Валюта = Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00", ТекущаяДатаСеанса()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтр = Объект.РасшифровкаПлатежа.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтр, Выборка);
		
	КонецЦикла;	
	
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
	
КонецПроцедуры	

// Заполняет документ подготовленными данными
//
// Параметры
//   Объект - ДокументОбъект.ВедомостьНаВыдачуДенегИзкассы, ДанныеФормыСтруктура
//   Параметры - Структура - Данные заполнения
//     * Организация - СправочникСсылка.Организации
//     * Валюта - СправочникСсылка.Валюты
//     * ИФО - СправочникСсылка.ИФО
//     * Организация - СправочникСсылка.Валюты
//     * РасшифровкаПлатежа - Массив структур с данными для табличной части
//       * Сотрудник - СправочникСсылка.Сотрудники
//       * ДокументОснование - ДокументСсылка
//       * КорСчет - ПланСчетовСсылка.ЕПСБУ
//       * ПодразделениеКор - СправочникСсылка.Подразделения
//       * КФО - ПеречислениеСсылка.КВД
//       * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//       * КЭК - СправочникСсылка.КОСГУ
//       * Сумма - Число
//
Процедура ЗаполнитьПоДаннымОснований(Объект, Параметры) Экспорт
	
	Объект.Организация = Параметры.Организация;
	Объект.ИФО = Параметры.ИФО;
	Объект.ВалютаДокумента = Параметры.Валюта;
	
	Объект.РасшифровкаПлатежа.Очистить();
	
	Для Каждого СтрокаТЧ Из Параметры.РасшифровкаПлатежа Цикл
		
		ЗаполнитьЗначенияСвойств(Объект.РасшифровкаПлатежа.Добавить(), СтрокаТЧ);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
	
КонецПроцедуры

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст="
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.ВалютаДокумента КАК Валюта,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО,
	|	СУММА(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Сумма) КАК Сумма,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Дата КАК Период
	|ИЗ
	|	Документ.ВедомостьНаВыдачуДенегИзКассы.РасшифровкаПлатежа КАК ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа
	|ГДЕ
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка = &Ссылка
	|	И ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Оплачено
	|	И ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Выплачено
	|
	|СГРУППИРОВАТЬ ПО
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.ВалютаДокумента,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Организация,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО,
	|	ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Дата,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ";
				 
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	НаличныеДенежныеСредстваДвижения = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("НаличныеДенежныеСредства",  НаличныеДенежныеСредстваДвижения);
	
КонецПроцедуры

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьВедомости(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ВедомостьНаВыдачуПодотчетнымЛицам";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВедомостьНаВыдачуПодотчетнымЛицам." + ИмяМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ВедомостьНаВыдачуДенегИзКассы.Ссылка КАК Ссылка,
	|	ВедомостьНаВыдачуДенегИзКассы.Дата КАК ДатаДок,
	|	ВедомостьНаВыдачуДенегИзКассы.Номер КАК НомерДок,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеПолное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеСокращенное = """"
	|						ТОГДА ВедомостьНаВыдачуДенегИзКассы.Организация.Наименование
	|					ИНАЧЕ ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеСокращенное
	|				КОНЕЦ
	|		ИНАЧЕ ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВедомостьНаВыдачуДенегИзКассы.Подразделение КАК Подразделение,
	|	ВедомостьНаВыдачуДенегИзКассы.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	ВедомостьНаВыдачуДенегИзКассы.Подразделение.Код КАК КодПодразделения,
	|	ВедомостьНаВыдачуДенегИзКассы.СуммаДокумента КАК СуммаДокумента,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассы.ВалютаДокумента = &ВалютаРегУчета
	|			ТОГДА ""руб""
	|		ИНАЧЕ ВедомостьНаВыдачуДенегИзКассы.ВалютаДокумента.НаименованиеПолное
	|	КОНЕЦ КАК ВалютаДокумента,
	|	ВедомостьНаВыдачуДенегИзКассы.ВалютаДокумента КАК Валюта,
	|	ВедомостьНаВыдачуДенегИзКассы.Руководитель КАК Руководитель,
	|	ВедомостьНаВыдачуДенегИзКассы.ГлБухгалтер КАК ГлБухгалтер,
	|	ВедомостьНаВыдачуДенегИзКассы.Кассир КАК Кассир,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.Префикс КАК ПрефиксОрганизации,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКорСчетов = 1
	|			ТОГДА ВложенныйЗапрос.КорСчет
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВложенныйЗапрос.КоличествоКорСчетРодитель = 1
	|					ТОГДА ВложенныйЗапрос.КорСчетРодитель
	|				ИНАЧЕ ВложенныйЗапрос.КорСчетРодительРодитель
	|			КОНЕЦ
	|	КОНЕЦ КАК КорСчет,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КолчиествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК КФО,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.КодОКПО КАК КодОКПО,
	|	ВедомостьНаВыдачуДенегИзКассы.РасшифровкаПлатежа.(
	|		КФО КАК КФО,
	|		Сумма КАК Сумма,
	|		Сотрудник КАК Сотрудник,
	|		ПодразделениеСотр.Наименование КАК ПодразделениеСотр,
	|		КорСчет КАК КорСчет
	|	) КАК РасшифровкаПлатежа,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.КодПоППП.Код КАК ГлаваПоБК,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	ВедомостьНаВыдачуДенегИзКассы.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.ВедомостьНаВыдачуПодотчетнымЛицам КАК ВедомостьНаВыдачуДенегИзКассы,
	|	(ВЫБРАТЬ
	|		ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|		МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО) КАК КФО,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО) КАК КолчиествоКФО,
	|		МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет) КАК КорСчет,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет) КАК КоличествоКорСчетов,
	|		МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель) КАК КорСчетРодитель,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель) КАК КоличествоКорСчетРодитель,
	|		МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель.Родитель) КАК КорСчетРодительРодитель,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель.Родитель) КАК КоличествоКорСчетРодительРодитель
	|	ИЗ
	|		Документ.ВедомостьНаВыдачуПодотчетнымЛицам.РасшифровкаПлатежа КАК ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа
	|	ГДЕ
	|		ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВедомостьНаВыдачуДенегИзКассы.Ссылка В(&МассивОбъектов)";
				 
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРегУчета", Константы.ВалютаРегламентированногоУчета.Получить());	
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
 	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;	
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;

		СтруктураДанных.Вставить("СуммаДокументаПрописью", ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Выборка.СуммаДокумента, Выборка.Валюта));
        СтруктураДанных.Вставить("СчетКассы", БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(БухгалтерскийУчет.СчетПоКоду("201.34", Выборка.ДатаДок, Выборка.Организация), , Выборка.КФО));
		СтруктураДанных.Вставить("КодКорСчет", ?(ЗначениеЗаполнено(Выборка.КорСчет), 	БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Выборка.КорСчет, , Выборка.КФО), 
																						БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Выборка.КорСчетОбщийРодитель, , Выборка.КФО)));
																						
		СписокОснований = Новый СписокЗначений;
		СписокОснований.Добавить("РасходныйКассовыйОрдер", "Расходный кассовый ордер");
		РасчетноПлатежныйДокумент = ПлатежноРасчетныеДокументы.ВведенныйНаОснованииРасчетноПлатежныйДокумент(Выборка.Ссылка, СписокОснований);
		Если ЗначениеЗаполнено(РасчетноПлатежныйДокумент) Тогда																		
			СтруктураДанных.Вставить("НомерРКО", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(РасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент.Номер));
			СтруктураДанных.Вставить("ДатаРКО", РасчетноПлатежныйДокумент.Дата);
		КонецЕсли;
	
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Руководитель, СтруктураДанных.ДатаДок);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РуководительФамилия", 			ДанныеСотрудника.Фамилия);
        СтруктураДанных.Вставить("РуководительИмя", 				ДанныеСотрудника.Имя);
		СтруктураДанных.Вставить("РуководительОтчество", 			ДанныеСотрудника.Отчество);
		СтруктураДанных.Вставить("РуководительИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));

		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ГлБухгалтер, СтруктураДанных.ДатаДок);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ГлБухгалтерФамилия", 			ДанныеСотрудника.Фамилия);
        СтруктураДанных.Вставить("ГлБухгалтерИмя", 				ДанныеСотрудника.Имя);
		СтруктураДанных.Вставить("ГлБухгалтерОтчество", 		ДанныеСотрудника.Отчество);
		СтруктураДанных.Вставить("ГлБухгалтерИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));

		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Кассир, СтруктураДанных.ДатаДок);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("КассирФамилия", 			ДанныеСотрудника.Фамилия);
        СтруктураДанных.Вставить("КассирИмя", 				ДанныеСотрудника.Имя);
		СтруктураДанных.Вставить("КассирОтчество", 			ДанныеСотрудника.Отчество);
		СтруктураДанных.Вставить("КассирИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
			// Исполнитель
		ТекПользователь = Пользователи.АвторизованныйПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			Исполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(ТекПользователь, СтруктураДанных.Организация);
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество,Должность", Исполнитель, ТекущаяДатаСеанса()); //СтруктураДанных.ДатаДок);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, , Истина);
			СтруктураДанных.Вставить("ФИОИсполнитель", Справочники.Сотрудники.ФамилияИО(Исполнитель, Истина, СтруктураДанных.ДатаДок));
			СтруктураДанных.Вставить("ДолжностьИсполнитель", ДанныеСотрудника.Должность); 
			СтруктураДанных.Вставить("ТелефонИсполнитель", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
			СтруктураДанных.Вставить("ЭлектроннаяПочтаИсполнитель", ДанныеСотрудника.EmailФизическиеЛица); 
		КонецЕсли;
			// Ответсвенный исполнитель
		ТекПользователь = Пользователи.АвторизованныйПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			Исполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(СтруктураДанных.Ответственный, СтруктураДанных.Организация);
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество,Должность", Исполнитель, ТекущаяДатаСеанса()); //СтруктураДанных.ДатаДок);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, , Истина);
			СтруктураДанных.Вставить("ФИООтИсполнитель	", Справочники.Сотрудники.ФамилияИО(Исполнитель, Истина, СтруктураДанных.ДатаДок));
			СтруктураДанных.Вставить("ДолжностьОтИсполнитель", ДанныеСотрудника.Должность); 
		КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ОбластьШапка.Параметры.Заполнить(СтруктураДанных);

        ТабличныйДокумент.Вывести(ОбластьШапка);

		СтрокиВедомости = СтруктураДанных.РасшифровкаПлатежа.Выгрузить();
		СтрокиВедомости.Свернуть("КФО, Сотрудник, ПодразделениеСотр, КорСчет", "Сумма");
		СтрокиВедомости.Сортировать("Сотрудник, КорСчет, КФО"); 
		СтрокиВедомости.Колонки.Добавить("ПодотчетникФамилия");
		СтрокиВедомости.Колонки.Добавить("ПодотчетникИмя");
        СтрокиВедомости.Колонки.Добавить("ПодотчетникОтчество");
		СтрокиВедомости.Колонки.Добавить("ПодотчетникФамилияИнициалы");
		СтрокиВедомости.Колонки.Добавить("СуммаПрописью");
		СтрокиВедомости.Колонки.Добавить("НомерСчетаПоДебету");

		Для Каждого СтрокаВедомости ИЗ СтрокиВедомости Цикл
			
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтрокаВедомости.Сотрудник, СтруктураДанных.ДатаДок);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтрокаВедомости.ПодотчетникФамилия			= ДанныеСотрудника.Фамилия;
			СтрокаВедомости.ПодотчетникИмя				= ДанныеСотрудника.Имя;
        	СтрокаВедомости.ПодотчетникОтчество			= ДанныеСотрудника.Отчество;
            СтрокаВедомости.ПодотчетникФамилияИнициалы 	= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника);
			
			СтрокаВедомости.СуммаПрописью 				= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтрокаВедомости.Сумма, СтруктураДанных.Валюта);
			
			СтрокаВедомости.НомерСчетаПоДебету 			= БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(СтрокаВедомости.КорСчет, , СтрокаВедомости.КФО);
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
						
			ОбластьСтрока.Параметры.Заполнить(СтрокаВедомости);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;

		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, СтруктураДанных.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьВедомости()

#КонецОбласти

#КонецЕсли

