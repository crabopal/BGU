&НаКлиенте
Процедура РасшифовкаПлатежаСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.РасшифровкаПлатежа.ТекущиеДанные.Сотрудник = ВыбранноеЗначение.Ссылка;
		Элементы.РасшифровкаПлатежа.ТекущиеДанные.ПодразделениеСотр = ВыбранноеЗначение.Подразделение;
	Иначе
		Элементы.РасшифровкаПлатежа.ТекущиеДанные.ПодразделениеСотр = "";
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура РасшифовкаПлатежаКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК); 
КонецПроцедуры

&НаКлиенте
Процедура РасшифовкаПлатежаКЭКПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ТекущиеДанные.КорСчет = СчетПоКЭК(ТекущиеДанные.КЭК, Объект.Дата, Объект.Организация, Объект.ИФО);

КонецПроцедуры 

#КонецОбласти

