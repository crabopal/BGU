&НаКлиенте
Процедура ЗаполнитьРКОЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ЗаполнитьРКОПоОснованию(ДополнительныеПараметры) Тогда
			ОповеститьОбИзменении(Объект.Ссылка);
			ПоказатьЗначение(, ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРКОПоОснованию(ДокументРКО)
	
	ДокументОбъект = ДокументРКО.ПолучитьОбъект();
	
	Попытка
		ДокументОбъект.Заблокировать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Расходный кассовый ордер занят. Необходимо завершить редактирование.'"));
		Возврат Ложь;
	КонецПопытки;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ПроверятьОснование", Ложь);
	
	Если ПроверитьЗаполнение() И Записать() Тогда
		
		ДокументОбъект.Заполнить(Объект.Ссылка);
		ДокументОбъект.Записать();
		ДокументОбъект.Разблокировать();
		
		Возврат Истина;
		
	Иначе
		ДокументОбъект.Разблокировать();
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьПлатежноРасчетныйДокумент()
	СписокОснований = Новый СписокЗначений;
	СписокОснований.Добавить("РасходныйКассовыйОрдер", "Расходный кассовый ордер");
	РасчетноПлатежныйДокумент = ПлатежноРасчетныеДокументы.ВведенныйНаОснованииРасчетноПлатежныйДокумент(Объект.Ссылка, СписокОснований);
	ВключенВОтчетКассира = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(РасчетноПлатежныйДокумент, ОтчетКассира);
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, ОтчетКассира, Элементы);
	УстановитьДоступностьИзменения();
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Организация, Подразделение, Дата, Руководитель, ГлБухгалтер, Кассир)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	Кассир = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Кассир", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетСуммыВыплачено()
	Результат = 0;
	Для каждого ТекСтр из Объект.РасшифровкаПлатежа Цикл
		Если ТекСтр.Выплачено Тогда
			Результат = Результат + ТекСтр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Объект.СуммаВыплачено = Результат;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ОрганизацияЗаполнена = ЗначениеЗаполнено(Объект.Организация);
	
	Элементы.Подразделение.Доступность						= ОрганизацияЗаполнена;
	Элементы.РасшифовкаПлатежаСотрудник.Доступность 		= ОрганизацияЗаполнена;
	Элементы.Руководитель.Доступность						= ОрганизацияЗаполнена;
	Элементы.ГлБухгалтер.Доступность						= ОрганизацияЗаполнена;
	Элементы.Кассир.Доступность								= ОрганизацияЗаполнена;

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаСервере
Процедура УстановитьДоступностьИзменения()

	ЭтотОбъект.ТолькоПросмотр = ЭтотОбъект.ТолькоПросмотр ИЛИ ВключенВОтчетКассира; 
	
КонецПроцедуры

