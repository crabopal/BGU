			ИтогоВесТонн = ИтогоВесТонн + ВыборкаЗадания.ПеревезтиТонн;
		КонецЦикла;
		
		СтруктураДанных.Вставить("ИтогоКоличествоЕздок", ИтогоКоличествоЕздок);
		СтруктураДанных.Вставить("ИтогоРасстояниеКм", ИтогоРасстояниеКм);
