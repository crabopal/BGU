		Область = Макет.ПолучитьОбласть("ПрицепыДвижениеГорючего");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		ЗачеркнутыйШрифт = Новый Шрифт("Arial",9,,,,Истина);
		Если ЗначениеЗаполнено(СтруктураДанных.ЛицензионнаяКарточка) Тогда
			Если СтруктураДанных.ЛицензионнаяКарточка.ОграниченнаяКарточка Тогда
				ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			Иначе
				ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			КонецЕсли;
		Иначе
			ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
		КонецЕсли;	
		
		Область = Макет.ПолучитьОбласть("ЗаданиеВодителю");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		
		Область = Макет.ПолучитьОбласть("ЗаголовокОборотнойСтороны");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ВыполнениеЗадания");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Таксировка");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("РезультатыРаботы");
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист4С";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист4С.ПФ_MXL_Форма0345004_368");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист4С.Ссылка КАК Ссылка,
	|	ПутевойЛист4С.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист4С.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист4С.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист4С.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист4С.СрокДействия,
	|	ПутевойЛист4С.ТранспортноеСредство,
	|	ПутевойЛист4С.Водитель,
	|	ПутевойЛист4С.ЛицензионнаяКарточка,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист4С.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛист4С.СопровождающиеЛица,
	|	ПутевойЛист4С.ВремяВыездаТС,
	|	ПутевойЛист4С.ВремяВозвращенияТС,
	|	ПутевойЛист4С.ВыпускающийТСДиспетчер,
	|	ПутевойЛист4С.ЛицоДопускающееВодителяПоСостояниюЗдоровья,
	|	ПутевойЛист4С.ОтметкиОрганизации,
	|	ПутевойЛист4С.ВодительПринялТС,
	|	ПутевойЛист4С.ВодительСдалТС,
	|	ПутевойЛист4С.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист4С.ВыездРазрешилМеханик,
	|	ПутевойЛист4С.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист4С.ПринялТСМеханик,
	|	ПутевойЛист4С.РасчетЗаработнойПлаты,
	|	ПутевойЛист4С.ТаксировщикПутевогоЛиста,
	|	ПутевойЛист4С.НулевойПробегПриВыезде,
	|	ПутевойЛист4С.НулевойПробегПриВозвращении,
	|	ПутевойЛист4С.ВремяВыездаТСФактическое,
	|	ПутевойЛист4С.ОсобыеОтметкиПриТаксировке,
	|	ПутевойЛист4С.ВремяВозвращенияТСФактическое,
	|	ПутевойЛист4С.ПриВозвращенииТСНеисправно,
	|	ПутевойЛист4С.РежимРаботы,
	|	ПутевойЛист4С.ВыдатьГорючего,
	|	ПутевойЛист4С.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист4С.ГаражныйНомер,
	|	ПутевойЛист4С.Бригада,
	|	ПутевойЛист4С.Колонна,
	|	ПутевойЛист4С.СведенияОПеревозке,
	|	ПутевойЛист4С.Прицепы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Прицеп,
	|		РегистрационныйНомернойЗнак,
	|		ГаражныйНомер
	|	),
	|	ПутевойЛист4С.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		АдресЗаказчика,
	|		ВремяПрибытия,
	|		АдресПунктаПогрузки,
	|		АдресПунктаРазгрузки,
	|		НаименованиеГруза,
	|		КоличествоЕздок,
	|		Расстояние,
	|		ПеревезтиТонн
	|	),
	|	ПутевойЛист4С.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВыезде,
	|		ОстатокГорючегоПриВозвращении,
	|		СданоГорючее,
	|		КоэффициентИзмененияНормы,
	|		ВремяРаботыСпецоборудования,
	|		ВремяРаботыДвигателя
	|	),
	|	ПутевойЛист4С.МаршрутДвижения.(
	|		Ссылка,
	|		НомерСтроки,
	|		ПунктПогрузкиРазгрузкиПерецепки,
	|		ДатаВремяПрибытия,
	|		ДатаВремяУбытия,
	|		НомераТТД,
	|		КоличествоТТД,
	|		НомераПрицеповПрибывших,
	|		НомераПрицеповУбывших,
	|		ПорожнийПробегПрицепа,
	|		НаименованиеГрузоотправителя
	|	)
	|ИЗ
	|	Документ.ПутевойЛист4С КАК ПутевойЛист4С
	|ГДЕ
	|	ПутевойЛист4С.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345004";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		
		СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьМаркуИМодельТС(СтруктураДанных.ТранспортноеСредство));	
		СтруктураДанных.Вставить("СведенияОПеревозке", СтруктураДанных.СведенияОПеревозке);
		
		СтруктураДанных.Вставить("ЧислоВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ГодВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""гггг"""));	
		СтруктураДанных.Вставить("ЧасВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ЧислоВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ГодВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""гггг"""));	
		СтруктураДанных.Вставить("ЧасВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращенияФактическое", Формат(ВыборкаДокументов.ВремяВозвращенияТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		//выдать горючего прописью
		КоличествоЛитровГСМ = "";
		ДробнаяЧасть = ВыборкаДокументов.ВыдатьГорючего - Цел(ВыборкаДокументов.ВыдатьГорючего);
		Если (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть = 0) Тогда
			ПараметрыПрописи = ",,,,,,,,0";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		ИначеЕсли (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть > 0) Тогда
			ПараметрыПрописи = "целая, целых, целых, ж, сотая, сотых, сотых, м, 2";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		КонецЕсли;	
		СтруктураДанных.Вставить("ВыдатьГорючегоПрописью", КоличествоЛитровГСМ);	
		
		//Прицепы
		ВыборкаПрицепы = ВыборкаДокументов.Прицепы.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаПрицепы.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 4 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьМаркуИМодельТС(ВыборкаПрицепы.Прицеп));
			СтруктураДанных.Вставить("ГосНомер"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ВыборкаПрицепы.Прицеп));
			СтруктураДанных.Вставить("ГаражныйНомер"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьГаражныйНомерТС(ВыборкаПрицепы.Прицеп));
		КонецЦикла;
		
		//Движение горючего
		ВыборкаГорючее = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаГорючее.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Горючего", ВыборкаГорючее.МаркаГорючего);
			СтруктураДанных.Вставить("КодМарки"+НомерСтроки+"Горючего", ВыборкаГорючее.КодМаркиГорючего);
			СтруктураДанных.Вставить("Выдано"+НомерСтроки+"Горючего", ВыборкаГорючее.ВыданоГорючее);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВыезде", ВыборкаГорючее.ОстатокГорючегоПриВыезде);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВозвращении", ВыборкаГорючее.ОстатокГорючегоПриВозвращении);
			СтруктураДанных.Вставить("Сдано"+НомерСтроки+"Горючего", ВыборкаГорючее.СданоГорючее);
			СтруктураДанных.Вставить("Коэффициент"+НомерСтроки+"Горючего", ВыборкаГорючее.КоэффициентИзмененияНормы);
			СтруктураДанных.Вставить("ВремяРаботы"+НомерСтроки+"Спецоборудования", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаГорючее.ВремяРаботыСпецоборудования));
			СтруктураДанных.Вставить("ВремяРаботы"+НомерСтроки+"Двигателя", УчетВремениКлиентСервер.ЧислоВСтроку(ВыборкаГорючее.ВремяРаботыДвигателя)); 
		КонецЦикла;
		
		//Задание водителю
		ИтогоКоличествоЕздок = 0;
		ИтогоРасстояниеКм = 0;
		ИтогоВесТонн = 0;
		
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 5 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Заказчик"+НомерСтроки+"НаименованиеАдрес", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика)+", "+СокрЛП(ВыборкаЗадания.АдресЗаказчика));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Прибытие", Формат(ВыборкаЗадания.ВремяПрибытия,"ДФ=""ЧЧ:мм"""));
			СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Погрузка", ВыборкаЗадания.АдресПунктаПогрузки);
			СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Разгрузка", ВыборкаЗадания.АдресПунктаРазгрузки);
			СтруктураДанных.Вставить("Груз"+НомерСтроки+"Наименование", ВыборкаЗадания.НаименованиеГруза);
			СтруктураДанных.Вставить("Ездки"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЕздок);
			СтруктураДанных.Вставить("Расстояние"+НомерСтроки+"Км", ВыборкаЗадания.Расстояние);
			СтруктураДанных.Вставить("Вес"+НомерСтроки+"Тонн", ВыборкаЗадания.ПеревезтиТонн);
			
