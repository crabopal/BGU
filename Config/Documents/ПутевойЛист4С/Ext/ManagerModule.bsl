			СтруктураДанных.Вставить("Вес"+НомерСтроки+"Тонн", ВыборкаЗадания.ПеревезтиТонн);
			
			ИтогоКоличествоЕздок = ИтогоКоличествоЕздок + ВыборкаЗадания.КоличествоЕздок;
			ИтогоРасстояниеКм = ИтогоРасстояниеКм + ВыборкаЗадания.Расстояние;
			ИтогоВесТонн = ИтогоВесТонн + ВыборкаЗадания.ПеревезтиТонн;
		КонецЦикла;
		
		СтруктураДанных.Вставить("ИтогоКоличествоЕздок", ИтогоКоличествоЕздок);
