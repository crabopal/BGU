			СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Погрузка", ВыборкаЗадания.АдресПунктаПогрузки);
			СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Разгрузка", ВыборкаЗадания.АдресПунктаРазгрузки);
			СтруктураДанных.Вставить("Груз"+НомерСтроки+"Наименование", ВыборкаЗадания.НаименованиеГруза);
