Процедура ЗаполнитьОрганизациюПоРеквизитам_2_0_97() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.ИНН КАК ИНН,
		|	Организации.КПП КАК КПП,
		|	Организации.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Организация ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьНастройкаОбмена
		|ПОМЕСТИТЬ ДанныеОрганизаций
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО НастройкаОрганизацийДляГИСГМП_УНП.Организация = Организации.Ссылка
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|	И ДЛИНАСТРОКИ(СОКРЛП(Организации.ИНН)) = 10
		|	И ДЛИНАСТРОКИ(СОКРЛП(Организации.КПП)) = 9
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИНН,
		|	КПП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НачислениеКонтрагентамГИСГМП.Ссылка КАК Ссылка,
		|	НачислениеКонтрагентамГИСГМП.Представление КАК Представление
		|ИЗ
		|	Документ.НачислениеКонтрагентамГИСГМП КАК НачислениеКонтрагентамГИСГМП
		|ГДЕ
		|	НачислениеКонтрагентамГИСГМП.Организация = &ПустаяОрганизация
		|	И (СОКРЛП(НачислениеКонтрагентамГИСГМП.ИННПлательщика), СОКРЛП(НачислениеКонтрагентамГИСГМП.КПППлательщика)) В
		|			(ВЫБРАТЬ
		|				ДанныеОрганизаций.ИНН КАК ИНН,
		|				ДанныеОрганизаций.КПП КАК КПП
		|			ИЗ
		|				ДанныеОрганизаций КАК ДанныеОрганизаций)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОрганизаций.ИНН КАК ИНН,
		|	ДанныеОрганизаций.КПП КАК КПП,
		|	ДанныеОрганизаций.Ссылка КАК Ссылка,
		|	ДанныеОрганизаций.ЕстьНастройкаОбмена КАК ЕстьНастройкаОбмена
		|ИЗ
		|	ДанныеОрганизаций КАК ДанныеОрганизаций";
	
	Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТабОрг = РезультатыЗапроса[2].Выгрузить();
	ТабОрг.Индексы.Добавить("ИНН,КПП,ЕстьНастройкаОбмена");
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	ОбъектМетаданных = Метаданные.Документы.НачислениеКонтрагентамГИСГМП;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеСсылки = ВыборкаДетальныеЗаписи.Представление;
			
			ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			
			СтруктураПоиска = Новый Структура("ИНН,КПП,ЕстьНастройкаОбмена",СокрЛП(ДокОбъект.ИННПлательщика),СокрЛП(ДокОбъект.КПППлательщика),Истина);
			
			НайденныеСтроки = ТабОрг.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество()=0 Тогда
				СтруктураПоиска.ЕстьНастройкаОбмена = Ложь;
				НайденныеСтроки = ТабОрг.НайтиСтроки(СтруктураПоиска);
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() Тогда
				ДокОбъект.Организация = НайденныеСтроки[0].Ссылка;		
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект,Ложь,Ложь);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
						
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеСсылки);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				ОбъектМетаданных,
				ВыборкаДетальныеЗаписи.Ссылка,
				ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
	
КонецПроцедуры

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаВыбора" Тогда
		//чтобы при программном открытии формы выбора установился режим выбора
		Параметры.Вставить("РежимВыбора", Истина);
		ВыбраннаяФорма = "ФормаСписка";
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
