	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаВнутреннееПеремещениеОС2";
	КомандаПечати.Идентификатор		= "Накладная0504102_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
