Функция ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("Счет10539"		, БухгалтерскийУчет.СчетПоКоду("105.39"));
	Запрос.УстановитьПараметр("Счет105"			, БухгалтерскийУчет.СчетПоКоду("105.00"));
	Запрос.УстановитьПараметр("Счета105"		, БухгалтерскийУчет.СписокСчетов("105.00,113.00"));
	Запрос.УстановитьПараметр("Счет106"			, БухгалтерскийУчет.СчетПоКоду("106.00"));
	Запрос.УстановитьПараметр("Счета106"		, БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТребованиеНакладная0315006.Ссылка КАК Ссылка,
	|	ТребованиеНакладная0315006.СчетУчета КАК СчетУчета,
