// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив из Строка - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	
	// Реквизит "НеПересчитыватьСумму" устанавливается только при загрузке данных
	НеРедактируемыеРеквизиты.Добавить("НеПересчитыватьСумму");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	ИменаСкрываемыхКнопок = Новый Массив;
	ИменаСкрываемыхКнопок.Добавить("МатериалыЗаполнитьПоСпецификации");
	ИменаСкрываемыхКнопок.Добавить("МатериалыЗаполнитьКПСНоменклатура");
	ИменаСкрываемыхКнопок.Добавить("МатериалыИзменитьРеквизитыСтрок");
	ИменаСкрываемыхКнопок.Добавить("МатериалыЗаполнитьКЭК");
	Результат.Вставить("ИменаСкрываемыхКнопок", ИменаСкрываемыхКнопок);
	Возврат Результат;
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗарегистрироватьДанныеКОбработкеДляПереходаНа_2_106");
	Методы.Вставить("ОбработатьДанныеДляПереходаНаВерсию_2_106");
КонецПроцедуры

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать106 - Булево - получать свойства счета 106
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Дт");
	Результат.Вставить("Включать106", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

// По операции и счету определяет относится ли операция к капвложению с
// точки зрения формирования карточки капвложений
//
// Параметры:
//	ТекОперация - ПеречислениеСсылка.ВидыПеремещенияМЗ - вид перемещения
//	ТекСчет - ПланСчетовСсылка - счет дебета, значение реквизита "Кор. счет"
//
// Возвращаемое значение:
//	Булево - флаг определяющий является ли операция капвложением
Функция ЭтоКапвложения(ТекОперация, ТекСчет) Экспорт
	МассивОперацийКапвложений = Новый Массив;
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов"));
	Возврат (МассивОперацийКапвложений.Найти(ТекОперация) <> Неопределено
		И ОбслуживаниеКарточекКапвложенийВызовСервера.ЭтоСчетКапвложений(ТекСчет));
КонецФункции
	
// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	Если НЕ ЭтоКапвложения(ДокументОбъект.ВидПеремещения, ДокументОбъект.КорСчет)
		ИЛИ НЕ ДокументОбъект.ОтразитьВКарточкеКапвложений Тогда
		Возврат Истина;	
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Стоимость вложений"" включен флажок 
		|""Отразить в:"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;	
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДокументОбъект.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;

	Возврат Истина;
КонецФункции	

