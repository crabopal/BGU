Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "ТребованиеНакладная0510451_100н", 1);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТребованиеНакладная0315006";
	КомандаПечати.Идентификатор		= "Накладная0510450";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на внутреннее перемещение НФА'"), "0510450", "61н");
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериаловПриСписании", 7);
