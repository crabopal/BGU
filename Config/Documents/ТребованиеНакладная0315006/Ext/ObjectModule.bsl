#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ЗаполнитьПоПоступлениюМЗ(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
		
		// При перемещении без изменения счета учета КПС и доп.аналитика не изменяются.
		Для Каждого СтрокаТаблицы Из Материалы Цикл
			СтрокаТаблицы.СчетДебета                         = СтрокаТаблицы.СчетУчета;
			СтрокаТаблицы.КПСДебета                          = СтрокаТаблицы.КПС;
			СтрокаТаблицы.ДополнительнаяАналитикаСчетаДебета = СтрокаТаблицы.ДополнительнаяАналитикаСчета;
		КонецЦикла;
		
	КонецЕсли;

	Если Не Документы.ТребованиеНакладная0315006.ЭтоКапвложения(ВидПеремещения, КорСчет) Тогда
		ОтразитьВКарточкеКапвложений = Ложь;
		КарточкаКапвложений = Справочники.КарточкиКапвложений.ПустаяСсылка();
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(Материалы);
	ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, "Материалы",, Отказ);
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Материалы", Истина);
	ПрослеживаемостьБГУ.СписаниеМЗПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	УправлениеМатериальнымиЗапасами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "Материалы", "Материалы", Отказ);
	ОбщегоНазначенияБГУ.ПроверитьДатаДокументаОснованияНеБольшеДатыДокумента(ЭтотОбъект,
		Новый Структура("Имя, Синоним", "ДокументОснованиеДата", НСтр("ru = 'Дата документа-основания'")),
		Отказ);
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Материалы.СтранаПроисхождения");
	
	Если ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.СчетДебета");
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(ВидПеремещения) И ВидПеремещения<>Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериалов) Тогда
		НепроверяемыеРеквизиты.Добавить("ЦМОПолучатель");
	КонецЕсли;
	
	Если ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ Тогда
		НепроверяемыеРеквизиты.Добавить("Материалы.СчетУчета");
	КонецЕслИ;
	
	Если НЕ ЗначениеЗаполнено(КорСчет) Тогда
		НепроверяемыеРеквизиты.Добавить("КорСубконто1");
		НепроверяемыеРеквизиты.Добавить("КорСубконто2");
		НепроверяемыеРеквизиты.Добавить("КорСубконто3");
	ИначеЕсли НЕ БухгалтерскийУчет.СчетВИерархии(КорСчет, "106.00,109.00,401.00") Тогда
		НепроверяемыеРеквизиты.Добавить("КорСубконто1");
		НепроверяемыеРеквизиты.Добавить("КорСубконто2");
		НепроверяемыеРеквизиты.Добавить("КорСубконто3");
	Иначе
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(КорСчет);
		Для Индекс = 1 По 3 Цикл
		
			Если НЕ СвойстваСчета["ВидСубконто" + Индекс + "Обязательный"] Тогда
			
				НепроверяемыеРеквизиты.Добавить("КорСубконто" + Индекс);
			
			КонецЕсли; 
		
		КонецЦикла; 
	КонецЕсли;
	
	Если Не Документы.ТребованиеНакладная0315006.ЭтоКапвложения(ВидПеремещения, КорСчет)
		Или Не ОтразитьВКарточкеКапвложений Тогда
		НепроверяемыеРеквизиты.Добавить("КарточкаКапвложений");	
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ПроверитьПередачуБАВРозницу(Отказ);
	
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
	Если НЕ БухгалтерскийУчет.СчетВИерархии(КорСчет, "105.00") Тогда 
		ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НеПересчитыватьСумму = Ложь;

	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	Если УправлениеМатериальнымиЗапасами.СчетУчетаРавен105(ЭтотОбъект)
		Или УправлениеМатериальнымиЗапасами.СчетУчетаРавен106(ЭтотОбъект) Тогда
			
		ОбязательноЗаполнитьКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ОбъектКопирования.Дата,
			ОбъектКопирования.Организация,
			ДатаНовогоДокумента,
			Организация);

		ПараметрыЗаполненияКЭК = Документы.ТребованиеНакладная0315006.ПараметрыЗаполненияКЭК();
		Если УправлениеМатериальнымиЗапасами.ТребованиеНакладнаяИспользуетКЭК440(ЭтотОбъект) Тогда
			ПараметрыЗаполненияКЭК.ДтКт = "Кт";
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
			ОбязательноЗаполнитьКЭК, ПараметрыЗаполненияКЭК);

		Если ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
			ПараметрыЗаполненияКЭК.Вставить("ИмяРеквизитаСчет", "СчетДебета");
			ПараметрыЗаполненияКЭК.Вставить("ИмяРеквизитаКЭК", "КЭКДебета");
			УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
				ОбязательноЗаполнитьКЭК);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоПоступлениюМЗ(ДанныеЗаполнения)

	ДокументОснование = ДанныеЗаполнения;
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, ИФО, Подразделение, ЦМО, СчетУчета");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования, "Организация, ИФО, СчетУчета");
	ЦМООтправитель				= РеквизитыОснования.ЦМО;
	ПодразделениеОтправитель	= РеквизитыОснования.Подразделение;
	
	Если СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.00") Тогда
		КорСчет = БухгалтерскийУчет.СчетПоКоду("106.00");
		ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериалов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗМатериалы.Количество КАК Количество,
	|	ПоступлениеМЗМатериалы.Количество КАК КоличествоЗатребовано,
	|	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗМатериалы.КФО КАК КФО,
	|	ПоступлениеМЗМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	ПоступлениеМЗМатериалы.КПС КАК КПС
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка = &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеМЗМатериалы.НомерСтроки";
	
	Материалы.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	Исп106КорСчет = СтрНайти(КорСчет, 106) > 0;
	
	ТаблицаВсехОбъектов = Материалы.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='%1 списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %2'");
			ТекстОшибки = СтрШаблон(ТекстОшибки,
				Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2),
				ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Если НЕ (ВключатьМЦВСоставКапвложений И Исп106КорСчет) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	&Организация КАК Организация,
		               |	ДрагМатериалыДокумента.ОбъектНФА,
		               |	ДрагМатериалыДокумента.МассаДМ,
		               |	ДрагМатериалыДокумента.ЛигатурнаяМасса,
		               |	ДрагМатериалыДокумента.ЧистаяМасса,
		               |	ДрагМатериалыДокумента.КоличествоДМ
		               |ПОМЕСТИТЬ ДрагМатериалыДокумента
		               |ИЗ
		               |	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	&Организация КАК Организация,
		               |	ОбъектыДокумента.Номенклатура
		               |ПОМЕСТИТЬ ОбъектыДокумента
		               |ИЗ
		               |	&ОбъектыДокумента КАК ОбъектыДокумента
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ОбъектыНФАДокумента.Организация,
		               |	ОбъектыНФАДокумента.Номенклатура КАК Номенклатура,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
		               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЛигатурнаяМасса, 0) = 0
		               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЧистаяМасса, 0) = 0
		               |				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
		               |			ТОГДА ЛОЖЬ
		               |		ИНАЧЕ ИСТИНА
		               |	КОНЕЦ КАК ЕстьДрагМатериалы
		               |ПОМЕСТИТЬ ОбъектыНФАДокумента
		               |ИЗ
		               |	ОбъектыДокумента КАК ОбъектыНФАДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
		               |		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
		               |			И ОбъектыНФАДокумента.Номенклатура = ДрагМатериалыДокумента.ОбъектНФА
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
		               |	0 КАК ЧистаяМассаОстаток,
		               |	0 КАК ЛигатурнаяМассаОстаток,
		               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
		               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
		               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
		               |ИЗ
		               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
		               |		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
		               |			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
		               |ГДЕ
		               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
		               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА,
		               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток,
		               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток,
		               |	0,
		               |	0,
		               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы
		               |ИЗ
		               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
		               |		ПО (НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
		               |			И (НаличиеДрагМатериаловВЛомеИОтходахОстатки.Организация = ОбъектыНФАДокумента.Организация)
		               |ГДЕ
		               |	ЕСТЬNULL(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА, 0) <> 0
		               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
					   
		ТаблицаОбъектовНФА = Материалы.Выгрузить(,"Номенклатура");
		
		Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
		Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = НСтр("ru='Для объекта ""%1"" из списка ""Материальные запасы"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПроверитьПередачуБАВРозницу(Отказ)
	
	Если ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ПеремещениеВНТТ
		И ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ
		И ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ВозвратИзНТТ Тогда
		Возврат;
	КонецЕсли;
	
	МатериалыДокумента = Материалы.ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	ТипыНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МатериалыДокумента, "ТипНоменклатуры");
	
	Для Каждого Строка Из Материалы Цикл
		Если ТипыНФА.Получить(Строка.Номенклатура) = Перечисления.ТипыНоменклатуры.БиологическиеАктивы Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",
				"Корректность",
				"Номенклатура",
				Строка.НомерСтроки,
				НСтр("ru = 'Материалы'"),
				НСтр("ru = 'Передача биологических активов в НТТ не предусмотрена'"));
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", Строка.НомерСтроки, "Номенклатура");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКПолю, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
