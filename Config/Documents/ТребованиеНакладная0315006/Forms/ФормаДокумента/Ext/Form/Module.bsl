&НаКлиентеНаСервереБезКонтекста
Функция СписокДляВыбораСчета(Форма)
	Если ЗначениеЗаполнено(Форма.Объект.ВидПеремещения) И ЭтоПеремещениеНТТ(Форма.Объект.ВидПеремещения) Тогда
		Возврат  Форма.СчетаРозницы;
	ИначеЕсли Форма.Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета") Тогда
		// Доступен только счет 105.00, 113.00
		ВременныйСписок = Новый СписокЗначений;
		ВременныйСписок.Добавить(Форма.ОграниченияСписокСчетов[0].Значение, Форма.ОграниченияСписокСчетов[0].Представление);
		Возврат ВременныйСписок;
	ИначеЕсли Форма.Объект.СчетУчета = Форма.Счет10600 Тогда
		ВременныйСписок = Новый СписокЗначений;
		ВременныйСписок.Добавить(Форма.Счет10600);
		Возврат ВременныйСписок;
	Иначе
		Возврат Форма.ОграниченияСписокСчетов;
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьИзСпискаВСписок(СписокПолучатель, СписокИсточник)
	СписокПолучатель.Очистить();
	Для Каждого ЭлементСписка Из СписокИсточник Цикл
		СписокПолучатель.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура КорСчетПриИзмененииНаСервере()
	
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьЗаголовкиКорСубконто(ЭтотОбъект, Объект);
	Объект.ПеремещениеДрагоценныхМатериалов = НЕ КорСчетСоответствуетСписаниюМЗ(ЭтотОбъект);
	ЗаполнитьСчетДебетаПоКорСчету();

	УстановитьЭтоСписаниеНаКапВложение();
	Если НЕ ЭтоСписаниеНаКапвложение И Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Ложь;
	ИначеЕсли ЭтоСписаниеНаКапвложение И НЕ Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	    
	
	Если СтрНайти(Объект.КорСчет, 106) = 0 Тогда
		Объект.ВключатьМЦВСоставКапвложений = Ложь;
	КонецЕсли;  
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЭтоСписаниеНаКапВложение()
	ЭтоСписаниеНаКапвложение = ЭтоКапвложения(Объект.ВидПеремещения, Объект.КорСчет);;
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или ((УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
				Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект))
			И УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
				ЭтотОбъект.КэшПараметров.Дата,
				ЭтотОбъект.КэшПараметров.Организация,
				Объект.Дата,
				Объект.Организация));
	
	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбновитьДанныеСчетовВФорме();
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		Если УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавенЗначению(ЭтотОбъект, "Счет0133") Тогда
			ИзменитьОтборКЭК();
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменилсяПорядокУчетаКЭК = (УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен105(ЭтотОбъект)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавен106(ЭтотОбъект)
			Или УправлениеМатериальнымиЗапасамиФормыКлиентСервер.СчетУчетаРавенЗначению(ЭтотОбъект, "Счет0133"))
		И УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация,
			Объект.Дата,
			Объект.Организация);
	Если ИзменилсяПорядокУчетаКЭК Тогда
		ПараметрыЗаполненияКЭК = Документы.ТребованиеНакладная0315006.ПараметрыЗаполненияКЭК();
		Если УправлениеМатериальнымиЗапасами.ТребованиеНакладнаяИспользуетКЭК440(Объект) Тогда
			ПараметрыЗаполненияКЭК.ДтКт = "Кт";
		КонецЕсли;
		УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(Объект, Объект.Дата, Истина,
			ПараметрыЗаполненияКЭК);
		Если Объект.ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
			ПараметрыЗаполненияКЭК.Вставить("ИмяРеквизитаСчет", "СчетДебета");
			ПараметрыЗаполненияКЭК.Вставить("ИмяРеквизитаКЭК", "КЭКДебета");
			УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(Объект, Объект.Дата, Истина,
				ПараметрыЗаполненияКЭК);
		КонецЕсли;
		ЗаполнитьДопустимыеКЭКДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	УстановитьРуководителя();
	ОбновитьДанныеСчетовВФорме();
	УправлениеМатериальнымиЗапасами.ПолучитьДанныеСчетовУчетаМЗ(Объект.Организация, Элементы.СчетУчета.СписокВыбора);
	Элементы.СчетУчета.СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("106.00", Объект.Дата, Объект.Организация),
		НСтр("ru = '106.хП. Вложения в материальные запасы'"));
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСчетаУчета(Результат, Параметры) Экспорт
	СчетУчетаПриИзмененииНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура ВидПеремещенияПриИзмененииНаСервере()
	
	ЗаполнитьСписокВыбораКорСчета(ЭтотОбъект);
	ОбработатьИзменениеПеремещениеВНТТ(ЭтотОбъект);
	Если НЕ ЭтоКапвложения(Объект.ВидПеремещения, Объект.КорСчет) И Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Ложь;
	КонецЕсли;
	Объект.ПеремещениеДрагоценныхМатериалов = НЕ КорСчетСоответствуетСписаниюМЗ(ЭтотОбъект);
		
	УстановитьОбязательностьЦМОПолучателя(ЭтотОбъект);
	УстановитьЗаголовкиКорСубконто(ЭтотОбъект, Объект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	Если ТребуетсяОбновитьКЭК(ЭтотОбъект) Тогда
		ОбновитьКЭКВСтроках();
	КонецЕсли;

	УстановитьДанныеДинамическихКолонокТаблицыМатериалы();
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНоменклатурыВСтроке(Знач ИдентификаторСтроки)
	ТекущиеДанные = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ЗначениеЗаполнено(Объект.ВидПеремещения)
		И Объект.ВидПеремещения<>ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов") Тогда
		Если ЗначениеЗаполнено(Объект.ТипЦеныНТТ) Тогда
			ТекущиеДанные.ЦенаПередачи = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатуры(Объект.Организация, 
																									ТекущиеДанные.Номенклатура, 
																									Объект.ТипЦеныНТТ, 
																									Объект.Дата);
		Иначе			
			ТекущиеДанные.ЦенаПередачи = 0;
		КонецЕсли;
		ПересчитатьСумму(ТекущиеДанные);
	КонецЕсли;
	
	РеквизитыНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры,
		"ПрослеживаемыйТовар, КомплектСПрослеживаемымиТоварами, СтранаПроисхождения, ТипНоменклатуры");

	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(ТекущиеДанные,
		РеквизитыНоменклатуры.ТипНоменклатуры);
	ТекущиеДанные.ЭтоБСО = РеквизитыНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БСО;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка();
	КонецЕсли;
	
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРуководителя()

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), Объект.Организация,
		Объект.Дата, Объект.ПодразделениеОтправитель);

	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаКлиенте
Процедура ВыборНоменклатурыПоСпецификации(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		ЗаполнитьПоСпецификацииНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСпецификацииНаСервере(АдресХранилища)
	
	Таблица = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	УправлениеМатериальнымиЗапасами.ДополнитьТаблицуДаннымиНоменклатуры(Таблица, Объект.Дата);
	Объект.Материалы.Загрузить(Таблица);
	
	Для Каждого СтрокаДокумента Из Объект.Материалы Цикл
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаДокумента, Истина);
		СтрокаДокумента.КоличествоЗатребовано = СтрокаДокумента.Количество;
	КонецЦикла;
	
	ЗаполнитьКПСнаСервере();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТребуетсяОбновитьКЭК(Форма)
	
	Если НЕ ЗначениеЗаполнено(Форма.ВидПеремещенияДоИзменения) ИЛИ НЕ ЗначениеЗаполнено(Форма.Объект.ВидПеремещения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ВидПеремещенияОтражаетсяКЭК440(Форма.ВидПеремещенияДоИзменения, Форма)
		<> ВидПеремещенияОтражаетсяКЭК440(Форма.Объект.ВидПеремещения, Форма);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидПеремещенияОтражаетсяКЭК440(ВидПеремещения, Форма)
	Возврат ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов")
		И Форма.Объект.КорСчет <> Форма.Счет10500
		И Форма.ВсеСчета105.НайтиПоЗначению(Форма.Объект.КорСчет) = Неопределено;
КонецФункции

&НаСервере
Процедура ОбновитьКЭКВСтроках()
	
	Для Каждого Строка Из Объект.Материалы Цикл
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, Строка, Ложь);
		Если Объект.ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
			ЗаполнитьДанныеСчетаДтВСтроке(ЭтотОбъект, Строка, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПараметрыВыбораКЭК();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораКЭК()
	
	Если Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ВозвратИзНТТ") Тогда
		ЗначениеДК = "Дт";
	ИначеЕсли Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета")
		Или Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов") Тогда
		ЗначениеДК = "";
	Иначе
		ЗначениеДК = "Кт";
	КонецЕсли;
	
	ПараметрыВыбораКЭК = Новый Массив;
	Для Каждого ПараметрВыбора Из Метаданные.Документы.ТребованиеНакладная0315006.ТабличныеЧасти.Материалы.Реквизиты.КЭК.ПараметрыВыбора Цикл
		ПараметрыВыбораКЭК.Добавить(ПараметрВыбора);
	КонецЦикла;
	ПараметрыВыбораКЭК.Добавить(Новый ПараметрВыбора("ДополнительныйОтбор.ВИерархии", Истина));
	
	Если Не ПустаяСтрока(ЗначениеДК) Тогда
		ПараметрыВыбораКЭК.Добавить(Новый ПараметрВыбора("ДополнительныйОтбор.ДК", ЗначениеДК));
	КонецЕсли;
	Элементы.МатериалыКЭК.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКЭК);

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьСпискиСчетов();
	ЗаполнитьСписокВыбораКорСчета(ЭтотОбъект);
	ИзменитьОтборКЭК();
	
	ВедетсяУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() 
		ИЛИ Объект.ВключатьМЦВСоставКапвложений;
	
	РассчитатьПрослеживаемыеТовары();
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект);
	УправлениеМатериальнымиЗапасами.УстановитьТипНоменклатурыВСтрокахДляБиологическихАктивов(Объект.Материалы);
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы();
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	
	УстановитьВедетсяКонтрольОстатковТоваровВыбытие(ЭтотОбъект);
	УстановитьВедетсяКонтрольОстатковТоваровПоступление(ЭтотОбъект);
	УстановитьЭтоСписаниеНаКапВложение();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьЗаголовкиКорСубконто(ЭтотОбъект, Объект);
	УстановитьОбязательностьЦМОПолучателя(ЭтотОбъект);
	УстановитьДоступностьКорСчета(ЭтотОбъект);
	УстановитьДоступностьСвязанныхЭлементов(ЭтотОбъект);
	УстановитьПараметрыВыбораКЭК();
	ЗаполнитьДопустимыеКЭКДокумента();
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	ПараметрыУО = УправлениеМатериальнымиЗапасами.ПараметрыУстановкиУсловногоОформленияСпискаМатериалов();
	ПараметрыУО.ИмяТаблицы = "Материалы";
	ПараметрыУО.ИспользуетсяКЭКАвто = Истина;
	ПараметрыУО.ИмяКолонкиУчетПоКЭК = "УчетПоКЭК";
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериаловПоПараметрам(
		ЭтотОбъект, ПараметрыУО);
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеПоляКЭК(УсловноеОформление,
		"МатериалыКЭКДебета", "Материалы", "КЭКДебета", "СчетДебета");
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеКолонкиСуммаСписанияНУ(ЭтотОбъект);
	ПрослеживаемостьФормыБГУ.УстановитьУсловноеОформление(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиФормы.УстановитьУсловноеОформлениеПолейБСОвДокументахМЗ(ЭтотОбъект);
	
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	// Условное оформление группы колонок изменения счета
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.Материалы.ЕстьДополнительноеСубконтоДебета", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",     ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",          НСтр("ru = '<не используется>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("МатериалыДополнительнаяАналитикаСчетаДебета");
	Поле.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект.Материалы.УчетПоКПСДебета", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",            ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",                 НСтр("ru = '<не используется>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",        Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("МатериалыКПСДебета");
	Поле.Использование = Истина;
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("МатериалыКЭКДебета");
	Поле.Использование = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)

	Объект = Форма.Объект;
	
	// КЭК в табличной части
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МатериалыКЭК",
		"Видимость", Объект.ВидПеремещения <> ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ"));
	
	// Элементы НТТ
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("МатериалыЦенаПередачи");
	МассивЭлементов.Добавить("МатериалыСуммаПередачи");
	МассивЭлементов.Добавить("ТипЦеныНТТ");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивЭлементов,
		"Видимость", ЭтоПеремещениеНТТ(Объект.ВидПеремещения));
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("МатериалыСчетУчета");
	МассивЭлементов.Добавить("МатериалыДополнительнаяАналитикаСчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивЭлементов, "Видимость",
		Объект.ВидПеремещения <> ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ"));
	
	// Изменение счета учета
	ИменаЭлементовСчетаДебета = Новый Массив;
	ИменаЭлементовСчетаДебета.Добавить("МатериалыСчетДебета");
	ИменаЭлементовСчетаДебета.Добавить("МатериалыКПСДебета");
	ИменаЭлементовСчетаДебета.Добавить("МатериалыКЭКДебета");
	ИменаЭлементовСчетаДебета.Добавить("МатериалыДополнительнаяАналитикаСчетаДебета");
	ИменаЭлементовСчетаДебета.Добавить("МатериалыЗаголовокКолонкиСчетУчетаДоИзменения");
	ИменаЭлементовСчетаДебета.Добавить("МатериалыЗаголовокКолонкиСчетУчетаПослеИзменения");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовСчетаДебета,
		"Видимость", Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета"));
	
	// Видимость команд
	ВидимостьЗаполнитьКПСНоменклатура = Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов")
		ИЛИ Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета")
		ИЛИ Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеВНТТ");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МатериалыЗаполнитьКПСНоменклатура",
		"Видимость", ВидимостьЗаполнитьКПСНоменклатура И НЕ ОбщегоНазначенияБГУКлиентСервер.ЗапрещеноДобавлениеСтрокВДокументыНФА(Форма));
	
	// Суммы для списания без пересчета себестоимости
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьВидимостьЭлементовЗагруженногоДокумента(Форма);
	
	// Прослеживаемость
	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров И ЭтоДвижениеПоСчету105(Форма) И Форма.ЕстьПрослеживаемыеТовары;
	
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОтражатьВПрослеживаемости");
	ИменаЭлементовПрослеживаемости.Добавить("МатериалыПрослеживаемыйТовар");
	ИменаЭлементовПрослеживаемости.Добавить("МатериалыСтранаПроисхождения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МатериалыРНПТ",
		"Видимость", ВидимостьЭлементовПрослеживаемости И Объект.ОтражатьВПрослеживаемости);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КодОперацииПрослеживаемости",
		"Видимость", ВидимостьЭлементовПрослеживаемости И Объект.ОтражатьВПрослеживаемости);
	
	УстановитьВидимостьЭлементовФормы_ДрагМатериалы(Форма);	
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма);
	УстановитьВидимостьЭлементовФормы_ТорговыеТочки(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ДрагМатериалы(Форма)
	
	Объект 	 = Форма.Объект;
	Элементы = Форма.Элементы;  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПеремещениеДрагоценныхМатериалов",
		"Видимость", НЕ КорСчетСоответствуетСписаниюМЗ(Форма));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АналитикаОперацииСДрагМатериалами",
		"Видимость", КорСчетСоответствуетСписаниюМЗ(Форма));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НоменклатураЛома",
		"Видимость", КорСчетСоответствуетСписаниюМЗ(Форма));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтраницаДрагМатериалы",
		"Видимость", КорСчетСоответствуетСписаниюМЗ(Форма) ИЛИ Форма.Элементы.СтраницаДрагМатериалы.Видимость);

	ВидимостьЗакладкиДрагМатериалы = ЗначениеЗаполнено(Форма.Объект.КорСчет)
		И (Не ЭтоВнутреннееПеремещениеПоСчету105(Форма) ИЛИ Форма.Объект.ДрагоценныеМатериалы.Количество() > 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаДрагМатериалы", "Видимость", ВидимостьЗакладкиДрагМатериалы);
	
	Исп106КорСчет = СтрНайти(Объект.КорСчет, 106) > 0;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"ВключатьМЦВСоставКапвложений",
		"Видимость", Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений И Исп106КорСчет);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"ДрагоценныеМатериалы",
		"Доступность", НЕ (Объект.ВключатьМЦВСоставКапвложений И Исп106КорСчет));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОтразитьВКарточкеКапвложений",
		"Видимость", Форма.ЭтоСписаниеНаКапвложение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КарточкаКапвложений",
		"Видимость", Форма.ЭтоСписаниеНаКапвложение И Форма.Объект.ОтразитьВКарточкеКапвложений);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ТорговыеТочки(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВыбытиеТоваровСоСкладаТорговойТочки", "Видимость", Форма.ВедетсяКонтрольОстатковТоваровВыбытие);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПоступлениеТоваровНаСкладТорговойТочки", "Видимость", Форма.ВедетсяКонтрольОстатковТоваровПоступление);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы()

	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект, Объект, , Истина, , Истина);
	Если Объект.ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета Тогда
		ИменаКолонок = Новый Структура;
		ИменаКолонок.Вставить("СчетУчета", "СчетДебета");
		ИменаКолонок.Вставить("УчетПоКПС", "УчетПоКПСДебета");
		ИменаКолонок.Вставить("ЕстьДополнительноеСубконто", "ЕстьДополнительноеСубконтоДебета");
		ИменаКолонок.Вставить("ДополнительнаяАналиткаВидСубконто", "ДополнительнаяАналиткаСчетаДебетаВидСубконто");
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтотОбъект, Объект, , Истина, ИменаКолонок, Истина);
	КонецЕсли;
	
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
		Объект.Материалы.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"), "ТипНоменклатуры");
	Для каждого ТекСтрока Из Объект.Материалы Цикл
		ЗаполнитьЗаголовкиСтрок(ТекСтрока);
		ТекСтрока.ЭтоБСО = ДанныеНоменклатуры.Получить(ТекСтрока.Номенклатура) = Перечисления.ТипыНоменклатуры.БСО;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДанныеДинамическихКолонокДебета(Объект, ТекущаяСтрока)

	ИменаКолонок = Новый Структура;
	ИменаКолонок.Вставить("СчетУчета", "СчетДебета");
	ИменаКолонок.Вставить("УчетПоКПС", "УчетПоКПСДебета");
	ИменаКолонок.Вставить("ЕстьДополнительноеСубконто", "ЕстьДополнительноеСубконтоДебета");
	ИменаКолонок.Вставить("ДополнительнаяАналиткаВидСубконто", "ДополнительнаяАналиткаСчетаДебетаВидСубконто");
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект,
		ТекущаяСтрока, Истина, ИменаКолонок, Истина);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтрок(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокКолонкиСчетУчетаДоИзменения = НСтр("ru = 'до:'");
	ТекущаяСтрока.ЗаголовокКолонкиСчетУчетаПослеИзменения = НСтр("ru = 'после:'");

КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()

	ПоказыватьОстатки = Объект.ВидПеремещения <> ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ВозвратИзНТТ")
		И Объект.ВидПеремещения <> ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ");
		
	ПараметрыПодбора = Новый Структура;
	Если ЭтоДвижениеПоСчету105(ЭтотОбъект) Тогда
		СписокСчетов = Новый СписокЗначений;
		СписокСчетов.Добавить(Счет10500);
		СписокСчетов.Добавить(Счет11300);
		ПараметрыПодбора.Вставить("СчетУчета", СписокСчетов);
	Иначе
		ПараметрыПодбора.Вставить("СчетУчета", Объект.СчетУчета);
	КонецЕсли;
	ПараметрыПодбора.Вставить("ЦМО", 					Объект.ЦМООтправитель);
	ПараметрыПодбора.Вставить("Подразделение",			Объект.ПодразделениеОтправитель);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		ПоказыватьОстатки);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета", ПоказыватьОстатки);
	ПараметрыПодбора.Вставить("ДополнитьСчетом113", Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	Если ЗначениеЗаполнено(Объект.ВидПеремещения) И НЕ Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов") Тогда
		ПараметрыПодбора.Вставить("ЕстьЦена",			Истина);
		ПараметрыПодбора.Вставить("ПоказыватьЦены",		Истина);
		ПараметрыПодбора.Вставить("ТипЦен",				Объект.ТипЦеныНТТ);
	КонецЕсли;
	
	Если СчетУчетаИмуществаВПользовании.Найти(Объект.СчетУчета) <> Неопределено Тогда
		ПараметрыПодбора.Вставить("ПодборОстатковВПользовании", Истина);
		ПараметрыПодбора.Вставить("СчетОстатковВПользовании", Объект.СчетУчета);
	КонецЕсли;
	
	ДополнительноеСубконтоСчета = УправлениеМатериальнымиЗапасамиКлиентСервер.ДополнительнаяАналитикаСчетаУчетаМатериалов(Объект.СчетУчета, Объект.Организация);
	Если ЗначениеЗаполнено(ДополнительноеСубконтоСчета) Тогда
		ПараметрыПодбора.Вставить("ВидСубконтоДополнительнойАналитикиСчета", ДополнительноеСубконтоСчета);
	КонецЕсли;
	Возврат ПараметрыПодбора;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхЭлементов(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ПодразделениеОтправитель");
	ИменаЭлементов.Добавить("ПодразделениеПолучатель");
	ИменаЭлементов.Добавить("ЦМООтправитель");
	ИменаЭлементов.Добавить("ЦМОПолучатель");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект.Материалы.Выгрузить();
		ВтМатериалы.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
		ВтМатериалы.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		ЭтоНТТ = ЭтоПеремещениеНТТ(Объект.ВидПеремещения);
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
		ТаблицаПодбора.ВыгрузитьКолонку("Номенклатура"), "ТипНоменклатуры");
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				СтрокаМатериалы.ЭтоБСО = ДанныеНоменклатуры.Получить(СтрокаМатериалы.Номенклатура) = Перечисления.ТипыНоменклатуры.БСО;
				Если ЭтоНТТ Тогда
					Если НЕ ЗначениеЗаполнено(СтрокаМатериалы.СчетУчета) Тогда
						СтрокаМатериалы.СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервера.СчетУчетаНоменклатуры(
						СтрокаМатериалы.Номенклатура);
					КонецЕсли;
					СтрокаМатериалы.ЦенаПередачи = СтрокаМатериалы.Цена;
					СтрокаМатериалы.СуммаПередачи = СтрокаМатериалы.Сумма;
				КонецЕсли;
				
				ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаМатериалы, Ложь);
				ЗаполнитьЗаголовкиСтрок(СтрокаМатериалы);
				СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			СтрокаМатериалы.КоличествоЗатребовано = СтрокаМатериалы.Количество;
		КонецЦикла;
		
		Объект.Материалы.Загрузить(ВтМатериалы);
		
		РассчитатьПрослеживаемыеТовары();
		УстановитьВидимостьЭлементов(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	Если ВидПеремещенияОтражаетсяКЭК440(Форма.Объект.ВидПеремещения, Форма) Тогда
		ПараметрыОбработки.Вставить("ДтКт", "Кт");
	Иначе
		ПараметрыОбработки.Вставить("ДтКт", "Дт");
	КонецЕсли;
	ПараметрыОбработки.Включать106 = Истина;
	ПараметрыОбработки.Включать113 = Истина;
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаДтВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка, "СчетДебета", "КЭКДебета");
	ПараметрыОбработки.ИмяРеквизитаУчетПоКПС                         = "УчетПоКПСДебета";
	ПараметрыОбработки.ИмяРеквизитаЕстьДополнительноеСубконто        = "ЕстьДополнительноеСубконтоДебета";
	ПараметрыОбработки.ИмяРеквизитаДополнительнаяАналиткаВидСубконто = "ДополнительнаяАналиткаСчетаДебетаВидСубконто";
	ПараметрыОбработки.ЗаполнятьСчет = Ложь;
	ПараметрыОбработки.ДтКт          = "Дт";
	ПараметрыОбработки.Включать113   = Истина;
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСумму(ТекущиеДанные)

	ТекущиеДанные.СуммаПередачи = ТекущиеДанные.ЦенаПередачи * ТекущиеДанные.Количество;

КонецПроцедуры // ПересчитатьСумму()

&НаСервере
Процедура ОбновитьДанныеСчетовВФорме()
	ЗаполнитьСпискиСчетов();
	ЗаполнитьСписокВыбораКорСчета(ЭтотОбъект);
	Если Элементы.СчетУчета.СписокВыбора.НайтиПоЗначению(Объект.СчетУчета) = Неопределено Тогда
		Объект.СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиСчетов()

	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;

	Счет10500 = БухгалтерскийУчет.СчетПоКоду("105.00");
	Счет10600 = БухгалтерскийУчет.СчетПоКоду("106.00");
	Счет11300 = БухгалтерскийУчет.СчетПоКоду("113.00");
	Счет0133 = БухгалтерскийУчет.СчетПоКоду("01.33");
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105", Счет10500);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет106", Счет10600);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0133", Счет0133);

	СчетаРозницы.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("105.28, 105.38", ДатаСчетов, Истина));
	
	ОграниченияСписокСчетов.Очистить();
	ОграниченияСписокСчетов.Добавить(Счет10500, УправлениеМатериальнымиЗапасамиФормы.НаименованиеСчета105_113(ДатаСчетов, Объект.Организация));
	ДополнительныеСчета = БухгалтерскийУчет.СписокСчетов("109.00, 110.00, 401.20, 106.11, 106.13, 106.21, 106.22, 106.2И, 106.31, 106.32, 106.3И", ДатаСчетов, , Объект.Организация);
	ДанныеДополнительныхСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДополнительныеСчета, "Код, Наименование");
	ШаблонСчета = НСтр("ru = '%1. %2'");
	Для Каждого ДопСчет Из ДополнительныеСчета Цикл
		ДанныеСчета = ДанныеДополнительныхСчетов.Получить(ДопСчет);
		Если ДанныеСчета <> Неопределено Тогда
			ПредставлениеСчета = СтрШаблон(ШаблонСчета, ДанныеСчета.Код, ДанныеСчета.Наименование);
		Иначе
			ПредставлениеСчета = Строка(ДопСчет);
		КонецЕсли;
		ОграниченияСписокСчетов.Добавить(ДопСчет, ПредставлениеСчета);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.КорСчет) И ОграниченияСписокСчетов.НайтиПоЗначению(Объект.КорСчет) = Неопределено Тогда
		ДанныеСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КорСчет, "Код, Наименование");
		ПредставлениеСчета = СтрШаблон(ШаблонСчета, ДанныеСчета.Код, ДанныеСчета.Наименование);
		ОграниченияСписокСчетов.Добавить(Объект.КорСчет, ПредставлениеСчета);
	КонецЕсли;
	
	СчетаСписания.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("106.00,109.00,401.20", ДатаСчетов));

	СчетУчетаИмуществаВПользовании = Новый ФиксированныйМассив(БухгалтерскийУчет.СписокСчетов("27, 27.02", ДатаСчетов, Истина));
		
	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Истина;
	ПараметрыЗаполненияСчета.Включать106 = Истина;
	ПараметрыЗаполненияСчета.СписокВыбора = Элементы.СчетУчета.СписокВыбора;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКорСчета(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("КорСчет");
	ИменаЭлементов.Добавить("ВидПеремещения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", Форма.Объект.СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("105.00"));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеКорСчета()

	Если Объект.СчетУчета <> Счет10500 Тогда
		Если Объект.СчетУчета = Счет10600 Тогда
			Объект.КорСчет = Счет10600;
		Иначе
			Объект.КорСчет = Счет10500;
		КонецЕсли;
		Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериалов");
		Если ЭтоПеремещениеНТТ(Объект.ВидПеремещения) Тогда
			ОбработатьИзменениеПеремещениеВНТТ(ЭтотОбъект);
		КонецЕсли;
	ИначеЕсли Объект.КорСчет = Счет10600 Тогда
		Объект.КорСчет = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзменениеПеремещениеВНТТ(Форма)
	
	Если ЭтоПеремещениеНТТ(Форма.Объект.ВидПеремещения) Тогда
		Если Форма.СчетаРозницы.НайтиПоЗначению(Форма.Объект.КорСчет) = Неопределено Тогда
			КоличествоСчетовРозницы = Форма.СчетаРозницы.Количество(); 
			Если КоличествоСчетовРозницы > 0 Тогда
				Форма.Объект.КорСчет = Форма.СчетаРозницы[КоличествоСчетовРозницы - 1].Значение;
			Иначе
				Форма.Объект.КорСчет = БухгалтерскийУчетВызовСервера.СчетПоКоду("105.38");
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Форма.ОграниченияСписокСчетов.НайтиПоЗначению(Форма.Объект.КорСчет) = Неопределено Тогда
			Форма.Объект.КорСчет = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПеремещениеНТТ(ВидПеремещения)

	Возврат ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеВНТТ")
		ИЛИ ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ПеремещениеМеждуНТТ")
		ИЛИ ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ВозвратИзНТТ");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЦМОПолучателя(Форма)

	ЦМООбязательный = ЭтоПеремещениеНТТ(Форма.Объект.ВидПеремещения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМОПолучатель",
		"АвтоОтметкаНезаполненного", ЦМООбязательный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМОПолучатель",
		"ОтметкаНезаполненного", ЦМООбязательный И НЕ ЗначениеЗаполнено(Форма.Объект.ЦМОПолучатель));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетДебетаПоКорСчету()

	Если НЕ (Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета")
		И ВсеСчета105.НайтиПоЗначению(Объект.КорСчет) <> Неопределено
		И Объект.КорСчет <> БухгалтерскийУчет.СчетПоКоду("105.00")) Тогда
		
		Возврат;
	КонецЕсли;
	
	Для каждого ТекСтрока Из Объект.Материалы Цикл
	
		ТекСтрока.СчетДебета = Объект.КорСчет;
		УстановитьДанныеДинамическихКолонокДебета(Объект, ТекСтрока);
		Если ТекСтрока.УчетПоКПСДебета И Не ЗначениеЗаполнено(ТекСтрока.КПСДебета) Тогда
			ТекСтрока.КПСДебета = ТекСтрока.КПС;
		КонецЕсли;
		
		Если ТекСтрока.ЕстьДополнительноеСубконтоДебета И Не ЗначениеЗаполнено(ТекСтрока.ДополнительнаяАналитикаСчетаДебета) Тогда
			ТекСтрока.ДополнительнаяАналитикаСчетаДебета = ТекСтрока.ДополнительнаяАналитикаСчета;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКПСнаСервере()

	УправлениеМатериальнымиЗапасами.ЗаполнитьКФОКПСвТабличнойЧастиДокументаМЗ(Объект.Материалы, Объект);

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииТипаЦен()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ТипЦен = &ТипЦен
		|				И Номенклатура В (&Номенклатура)) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Материалы.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипЦен", Объект.ТипЦеныНТТ);

	Результат = Запрос.Выполнить();

	ТаблицаЦенНоменклатуры = Результат.Выгрузить();

	Для каждого СтрокаТЧ из Объект.Материалы Цикл
		СтрокаЦены = ТаблицаЦенНоменклатуры.Найти(СтрокаТЧ.Номенклатура,"Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			СтрокаТЧ.ЦенаПередачи = СтрокаЦены.Цена;
		Иначе
			СтрокаТЧ.ЦенаПередачи = 0;
		КонецЕсли;
		ПересчитатьСумму(СтрокаТЧ);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСвойстваКорСчета(Знач Счет)

	Результат = Новый Структура;
	Результат.Вставить("ВидСубконто1Наименование");
	Результат.Вставить("ВидСубконто2Наименование");
	Результат.Вставить("ВидСубконто3Наименование");
	Результат.Вставить("ВидСубконто1");
	Результат.Вставить("ВидСубконто2");
	Результат.Вставить("ВидСубконто3");
	Результат.Вставить("ВидСубконто1Обязательный", Ложь);
	Результат.Вставить("ВидСубконто2Обязательный", Ложь);
	Результат.Вставить("ВидСубконто3Обязательный", Ложь);
	Результат.Вставить("ВидСубконто1ТипЗначения");
	Результат.Вставить("ВидСубконто2ТипЗначения");
	Результат.Вставить("ВидСубконто3ТипЗначения");
	
	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
		Если НЕ СвойстваСчета.ЭлементГруппа И НЕ Лев(СвойстваСчета.Код, 4) = "105." Тогда
			ЗаполнитьЗначенияСвойств(Результат, СвойстваСчета);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьСвойстваКорСчета()

&НаСервереБезКонтекста
Процедура УстановитьЗаголовкиКорСубконто(Форма, Объект)

	Наименования = Новый Массив(3);
	Обязательность = Новый Массив(3);
	
	Если ЗначениеЗаполнено(Объект.ВидПеремещения) И НЕ ЭтоПеремещениеНТТ(Объект.ВидПеремещения) Тогда
		СвойстваСчета = ПолучитьСвойстваКорСчета(Объект.КорСчет);
		
		Для Индекс = 1 По 3 Цикл
			
			СвойстваСчета.Свойство("ВидСубконто" + Индекс + "Наименование", Наименования[Индекс - 1]);
			Если ЗначениеЗаполнено(Наименования[Индекс - 1]) Тогда
				Наименования[Индекс - 1] = Наименования[Индекс - 1] + ":";
			КонецЕсли;
			СвойстваСчета.Свойство("ВидСубконто" + Индекс + "Обязательный", Обязательность[Индекс - 1]);
			
		КонецЦикла;
	КонецЕсли;
	
	Для Индекс = 1 По 3 Цикл
		
		Форма["КорСубконто" + Индекс + "Заголовок"] = Наименования[Индекс - 1];
		Если ЗначениеЗаполнено(Наименования[Индекс - 1]) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"Доступность", Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"АвтоотметкаНезаполненного", Обязательность[Индекс - 1] = Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"ОтметкаНезаполненного",
				Обязательность[Индекс - 1] = Истина И Не ЗначениеЗаполнено(Объект["КорСубконто" + Индекс]));
			Форма.Элементы["КорСубконто" + Индекс].СвязиПараметровВыбора =
				СвязиПараметровВыбораПоОписаниюТипов(СвойстваСчета["ВидСубконто" + Индекс + "ТипЗначения"]);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"Доступность", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"АвтоотметкаНезаполненного", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КорСубконто" + Индекс,
				"ОтметкаНезаполненного", Ложь);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Связи параметров выбора по описанию типов.
// 
// Параметры:
//  ОписаниеТиповРеквизита - ОписаниеТипов
// 
// Возвращаемое значение:
//  ФиксированныйМассив из СвязьПараметраВыбора
&НаСервереБезКонтекста
Функция СвязиПараметровВыбораПоОписаниюТипов(ОписаниеТиповРеквизита)
	Результат = Новый Массив;
	ОрганизацияМД = Метаданные.Справочники.Организации;
	Для Каждого ТипРеквизита Из ОписаниеТиповРеквизита.Типы() Цикл
		Если ОбщегоНазначения.ВидОбъектаПоТипу(ТипРеквизита) = "Справочник" Тогда
			ОбъектМД = Метаданные.НайтиПоТипу(ТипРеквизита); // ОбъектМетаданныхСправочник
			Если ОбъектМД.Владельцы.Содержит(ОрганизацияМД) Тогда
				Результат.Добавить(
					Новый СвязьПараметраВыбора("Отбор.Владелец",
						"Объект.Организация",
						РежимИзмененияСвязанногоЗначения.Очищать));
				Прервать;
			КонецЕсли;
		ИначеЕсли ОбщегоНазначения.ВидОбъектаПоТипу(ТипРеквизита) = "Документ" Тогда
			ОбъектМД = Метаданные.НайтиПоТипу(ТипРеквизита); // ОбъектМетаданныхДокумент
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если ОбъектМД.Реквизиты.Найти("Организация") <> Неопределено Тогда
			Результат.Добавить(
				Новый СвязьПараметраВыбора("Отбор.Организация",
					"Объект.Организация",
					РежимИзмененияСвязанногоЗначения.Очищать));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированныйМассив(Результат);
КонецФункции

&НаКлиенте
Процедура ТипЦеныНТТПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Ответ = РезультатВопроса;

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		ПриИзмененииТипаЦен();
	Иначе
		Объект.ТипЦеныНТТ = ПредыдущийТипЦены;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменениеРеквизитовСтрок(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипНоменклатуры = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ТипНоменклатуры");
	
	Для каждого Индекс Из Элементы.Материалы.ВыделенныеСтроки Цикл
	
		ТекСтрока = Объект.Материалы.НайтиПоИдентификатору(Индекс);
		
		Если ТипНоменклатуры <> Неопределено И ТекСтрока.ТипНоменклатуры <> ТипНоменклатуры Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекСтрока, Результат);
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(
			Объект, Элементы.Материалы.ТекущиеДанные, Истина, , Истина);
		Если НЕ ТекСтрока.ЕстьДополнительноеСубконто Тогда
			ТекСтрока.ДополнительнаяАналитикаСчета = Неопределено;
		КонецЕсли;
		Если Объект.ВидПеремещения = ПредопределенноеЗначение("Перечисление.ВидыПеремещенияМЗ.ДвижениеМатериаловСИзменениемСчета") Тогда
			УстановитьДанныеДинамическихКолонокДебета(Объект, ТекСтрока);
			Если НЕ ТекСтрока.ЕстьДополнительноеСубконтоДебета Тогда
				ТекСтрока.ДополнительнаяАналитикаСчетаДебета = Неопределено;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Функция СтруктураПараметровПолученияОстатков()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка",Объект.Ссылка);
	СтруктураПараметров.Вставить("Период",Объект.Дата);
	
	Если Объект.Ссылка.Пустая() Тогда
		СтруктураПараметров.Период = КонецДня(Объект.Дата);
	Иначе
		СтруктураПараметров.Период = Объект.Дата;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции
	
&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	ПараметрыПолученияОстатков = СтруктураПараметровПолученияОстатков();
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);

	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
	
	ЗаполнитьОбъектыСДрагМатериалами();
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	ТЧ = Объект.Материалы.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.Номенклатура,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.Номенклатура КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
			|	СписокНФАСписания.Количество
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания";
			
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТЧ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМЗ(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.Материалы Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.Номенклатура);
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);		
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ТекСтрокаМассива.КоличествоВсего; 
				Прервать;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, "");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.Материалы.Выгрузить(,"Номенклатура, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовМЗ = Новый ТаблицаЗначений;
	ТаблицаОбъектовМЗ.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	НеСодержатДрагМатериалы = УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НеСодержатДрагМатериалы.Найти(ТекСтрока.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
				НоваяСтрока = ТаблицаОбъектовМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.Номенклатура, ""); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовМЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПеремещениеДрагоценныхМатериалов",
		"Видимость", НЕ КорСчетСоответствуетСписаниюМЗ(ЭтотОбъект));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "АналитикаОперацииСДрагМатериалами",
		"Видимость", КорСчетСоответствуетСписаниюМЗ(ЭтотОбъект));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НоменклатураЛома",
