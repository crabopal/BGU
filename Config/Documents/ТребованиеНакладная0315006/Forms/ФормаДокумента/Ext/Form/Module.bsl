&НаКлиенте  
Процедура ТипЦеныНТТПриИзменении(Элемент)
	
	Если Объект.Материалы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Табличная часть документа содержит записи.
							|Пересчитать цены табличной части?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,     НСтр("ru = 'Да, пересчитать цены'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет,    НСтр("ru = 'Нет, не пересчитывать цены'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Не изменять тип цены'"));

	ПоказатьВопрос(Новый ОписаниеОповещения("ТипЦеныНТТПриИзмененииЗавершение", ЭтотОбъект),
		ТекстВопроса, Кнопки,,КодВозвратаДиалога.Отмена);

КонецПроцедуры

