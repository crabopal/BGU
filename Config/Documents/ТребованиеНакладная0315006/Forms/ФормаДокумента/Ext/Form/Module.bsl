&НаСервере
Процедура ЗаполнитьДопустимыеКЭКДокумента()
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	КЭК440 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("440");
	КЭК360 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("360");
	КЭК460 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("460");
	ДопустимыеКЭКДокумента.Очистить();
	ПрименяетсяДетальныйКЭК340и440 = БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Объект.Дата,
		Объект.Организация);
	Если ПрименяетсяДетальныйКЭК340и440 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Родитель В (&КЭК340, &КЭК440)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОСГУ.Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Ссылка В (&КЭК360, &КЭК460)";
		Запрос.УстановитьПараметр("КЭК340", КЭК340);
		Запрос.УстановитьПараметр("КЭК440", КЭК440);
		Запрос.УстановитьПараметр("КЭК360", КЭК360);
		Запрос.УстановитьПараметр("КЭК460", КЭК460);
		ДопустимыеКЭКДокумента.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Иначе
		ДопустимыеКЭКДокумента.Добавить(КЭК340);
		ДопустимыеКЭКДокумента.Добавить(КЭК440);
		ДопустимыеКЭКДокумента.Добавить(КЭК360);
		ДопустимыеКЭКДокумента.Добавить(КЭК460);
	КонецЕсли;

КонецПроцедуры

