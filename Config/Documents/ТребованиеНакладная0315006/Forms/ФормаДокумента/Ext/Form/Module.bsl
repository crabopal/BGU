	Если Не ЗначениеЗаполнено(Объект.КорСубконто1) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана номенклатура'"),, "КорСубконто1", "Объект");
		Возврат;
	ИначеЕсли ТипЗнч(Объект.КорСубконто1) <> Тип("СправочникСсылка.Номенклатура") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Тип субконто должен быть ""Номенклатура""'"),, "КорСубконто1", "Объект");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Номенклатура", Объект.КорСубконто1);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ЗаполнениеПоСпецификации", ПараметрыФормы, ЭтотОбъект,,,,
