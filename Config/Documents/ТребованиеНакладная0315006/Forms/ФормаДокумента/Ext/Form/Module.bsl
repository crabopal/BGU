&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ТипНоменклатуры", ТекущиеДанные.ТипНоменклатуры);
	ОбработкаЗавершения = Новый ОписаниеОповещения("ВыполнитьИзменениеРеквизитовСтрок", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура("Организация, ИФО, Дата, ВидПеремещения");
	ПараметрыФормы.Организация    = Объект.Организация;
	ПараметрыФормы.ИФО            = Объект.ИФО;
	ПараметрыФормы.Дата           = Объект.Дата;
	ПараметрыФормы.ВидПеремещения = Объект.ВидПеремещения;
	
	Если Объект.СчетУчета = Неопределено ИЛИ Объект.СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("105.00") Тогда
		Если ТекущиеДанные.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы") Тогда
			ПараметрыФормы.Вставить("МассивСчетов", ВсеСчета113.ВыгрузитьЗначения());
		Иначе
			ПараметрыФормы.Вставить("МассивСчетов", ВсеСчета105.ВыгрузитьЗначения());
		КонецЕсли;
	Иначе
		ПараметрыФормы.Вставить("МассивСчетов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.СчетУчета));
	КонецЕсли;
	
	НачальныеЗначения = Новый Структура("КФО, СчетУчета, КПС, ДополнительнаяАналитикаСчета, СчетДебета, КПСДебета, ДополнительнаяАналитикаСчетаДебета, Примечание");
	Если ВедетсяУчетПрослеживаемыхТоваров И ЕстьПрослеживаемыеТовары Тогда
		НачальныеЗначения.Вставить("СтранаПроисхождения");
		ПараметрыФормы.Вставить("ЕстьПрослеживаемыеТовары", Истина);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(НачальныеЗначения, ТекущиеДанные);
	ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	ОткрытьФорму("Документ.ТребованиеНакладная0315006.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,
		ЭтотОбъект,,,, ОбработкаЗавершения);
		
КонецПроцедуры

