// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

Функция ПечатьАкта(МассивОбъектов, ОбъектыПечати)
	
	Ссылка = МассивОбъектов[0];
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСдачиПриемкиРаботЗавершение";
	СтруктураДанных = ПолучитьДанныеДляПечатиАкта(Ссылка);
	ВыборкаШапка    = СтруктураДанных.ВыборкаШапка;
	ВыборкаТЧ       = СтруктураДанных.ВыборкаТЧ;
	
	Макет = ПолучитьМакет("ПФ_MXL_АктСдачиПриемкиРабот");
	ОбластьМакетаЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаЗаголовок1      = Макет.ПолучитьОбласть("Заголовок1");
	ОбластьМакетаЗаголовок2      = Макет.ПолучитьОбласть("Заголовок2");
	ОбластьМакетаНаимОрг         = Макет.ПолучитьОбласть("НаимОрг");
	ОбластьМакетаНаимОргДоп      = Макет.ПолучитьОбласть("НаимОргДоп");
	ОбластьМакетаПредОрг         = Макет.ПолучитьОбласть("ПредОрг");
	ОбластьМакетаПредОргДоп      = Макет.ПолучитьОбласть("ПредОргДоп");
	ОбластьМакетаНаимЗак         = Макет.ПолучитьОбласть("НаимЗак");
	ОбластьМакетаНаимЗакДоп      = Макет.ПолучитьОбласть("НаимЗакДоп");
	ОбластьМакетаПредЗак         = Макет.ПолучитьОбласть("ПредЗак");
	ОбластьМакетаПредЗакДоп      = Макет.ПолучитьОбласть("ПредЗакДоп");
	ОбластьМакетаСтрокаЭС        = Макет.ПолучитьОбласть("СтрокаЭС");
	ОбластьМакетаСтрокаЭВ        = Макет.ПолучитьОбласть("СтрокаЭВ");
	ОбластьМакетаИтог            = Макет.ПолучитьОбласть("Итог");
	ОбластьМакетаПодвал          = Макет.ПолучитьОбласть("Подвал");
	
	ВыборкаШапка.Следующий();
	ОбластьМакетаЗаголовок.Параметры.Заполнить(ВыборкаШапка);
	ОбластьМакетаЗаголовок.Параметры.ДатаДоговора = Формат(ВыборкаШапка.ДатаДоговора, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок);
	
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(ВыборкаШапка.НаименованиеОрганизации, 
																		ТабДокумент, 
																		ОбластьМакетаНаимОрг, 
																		ОбластьМакетаНаимОргДоп,
																		"НаимОргЯчейка",
																		"НаимОргДопЯчейка");
																		
	ПредставительОрганизацииДолжность = ВыборкаШапка.ПредставительОрганизацииДолжность;
	ПредставительОрганизации = ВыборкаШапка.ПредставительОрганизации;
	Корреспонденты.Просклонять(ПредставительОрганизацииДолжность, 2, ПредставительОрганизацииДолжность);
	Корреспонденты.Просклонять(ПредставительОрганизации, 2, ПредставительОрганизации);
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(?(ПредставительОрганизацииДолжность = Неопределено, "", ПредставительОрганизацииДолжность + " ") +
											  ?(ПредставительОрганизации = Неопределено, "", ПредставительОрганизации), 
												ТабДокумент, 
												ОбластьМакетаПредОрг, 
												ОбластьМакетаПредОргДоп,
												"ПредОргЯчейка",
												"ПредОргДопЯчейка");
																		
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок1);
	
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(ВыборкаШапка.НаименованиеЗаказчика, 
																		ТабДокумент, 
																		ОбластьМакетаНаимЗак, 
																		ОбластьМакетаНаимЗакДоп,
																		"НаимЗакЯчейка",
																		"НаимЗакДопЯчейка");
																		
	ПредставительЗаказчикаДолжность = ВыборкаШапка.ПредставительЗаказчикаДолжность;
	ПредставительЗаказчика = ВыборкаШапка.ПредставительЗаказчика;
	Корреспонденты.Просклонять(ПредставительЗаказчикаДолжность, 2, ПредставительЗаказчикаДолжность);
	Корреспонденты.Просклонять(ПредставительЗаказчика, 2, ПредставительЗаказчика);
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(?(ПредставительЗаказчикаДолжность = Неопределено, "", ПредставительЗаказчикаДолжность + " ") +
											  ?(ПредставительЗаказчика = Неопределено, "", ПредставительЗаказчика), 
												ТабДокумент, 
												ОбластьМакетаПредЗак, 
												ОбластьМакетаПредЗакДоп,
												"ПредЗакЯчейка",
												"ПредЗакДопЯчейка");
																		
	ОбластьМакетаЗаголовок2.Параметры.Заполнить(ВыборкаШапка);																	
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок2);
	
	СуммаИтого = ЗаполнитьМногострочнуюЧасть(ВыборкаТЧ, Макет, ТабДокумент, "Итог");
	
	ОбластьМакетаПодвал.Параметры.Заполнить(ВыборкаШапка);
	ОбластьМакетаПодвал.Параметры.ДатаДоговора = Формат(ВыборкаШапка.ДатаДоговора, "ДФ=dd.MM.yyyy");
	
	ОбластьМакетаПодвал.Параметры.Сумма    = СуммаИтого;
	ОбластьМакетаПодвал.Параметры.СуммаПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаИтого, ВыборкаШапка.ВалютаПечати);
	
	
	ЮрАдресУчреждения = "";
	ТелефонПоЮрАдресуУчреждения = "";
	ЮрАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	ТелефонПоЮрАдресуУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Организация, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	
	ОбластьМакетаПодвал.Параметры.СведенияОрганизации = "" + ВыборкаШапка.НаименованиеОрганизации + " (ИНН: " + ВыборкаШапка.ИННОрганизации + ")"
														+ " Адрес (юридический): " + ЮрАдресУчреждения + ", телефоны: " + ТелефонПоЮрАдресуУчреждения;
														
	ТелефонКонтра = "";
	ЮрАдресКонтрагента = "";
	Если Ссылка.Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		ЮрАдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
		ТелефонКонтра = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
	ИначеЕсли Ссылка.Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЮрАдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		ТелефонКонтра = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
	КонецЕсли;
	
	ОбластьМакетаПодвал.Параметры.СведенияЗаказчика = "" + ВыборкаШапка.НаименованиеЗаказчика + " (ИНН: " + ВыборкаШапка.ИННЗаказчика + ")"
														+ " Адрес (юридический): " + ЮрАдресКонтрагента + ", телефоны: " + ТелефонКонтра;
														
	ТабДокумент.Вывести(ОбластьМакетаПодвал);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечатиАкта(Ссылка)
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗавершениеРаботСостав.Ссылка.Дата,
	               |	ЗавершениеРаботСостав.ДокументСдачиЭтапа,
	               |	ЗавершениеРаботСостав.ДокументСдачиЭтапа.ЭтапСдачиРабот КАК ЭтапСдачиРаботы,
	               |	1 КАК КурсВзаиморасчетов,
	               |	1 КАК КратностьВзаиморасчетов,
	               |	&РегламентированнаяВалюта КАК ВалютаДокумента,
	               |	ЗавершениеРаботСостав.ДокументСдачиЭтапа.ВалютаДокумента КАК ВалютаДокументаЭтапа,
	               |	ВЫБОР
	               |		КОГДА ЗавершениеРаботСостав.ДокументСдачиЭтапа.ВалютаДокумента = &РегламентированнаяВалюта
	               |			ТОГДА 1
	               |		ИНАЧЕ Курсы.Курс
	               |	КОНЕЦ КАК КурсВзаиморасчетовЭтапа,
	               |	ВЫБОР
	               |		КОГДА ЗавершениеРаботСостав.ДокументСдачиЭтапа.ВалютаДокумента = &РегламентированнаяВалюта
	               |			ТОГДА 1
	               |		ИНАЧЕ Курсы.Кратность
	               |	КОНЕЦ КАК КратностьВзаиморасчетовЭтапа
	               |ПОМЕСТИТЬ ТабЧасть
	               |ИЗ
	               |	Документ.ЗавершениеРабот.СоставРаботы КАК ЗавершениеРаботСостав
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаДок, ) КАК Курсы
	               |		ПО ЗавершениеРаботСостав.ДокументСдачиЭтапа.ВалютаДокумента = Курсы.Валюта
	               |ГДЕ
	               |	ЗавершениеРаботСостав.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗавершениеРабот.Номер,
	               |	ЗавершениеРабот.Дата,
	               |	ЗавершениеРабот.Организация,
	               |	ЗавершениеРабот.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ЗавершениеРабот.Организация.ИНН КАК ИННОрганизации,
	               |	ВЫБОР
	               |		КОГДА ЗавершениеРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо) ТОГДА ЮрЛица.НаименованиеПолное
				   |		КОГДА ЗавершениеРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо) ТОГДА ФизЛица.Наименование
	               |	КОНЕЦ КАК НаименованиеЗаказчика,
	               |	ЗавершениеРабот.Контрагент КАК СсылкаЗаказчика,
	               |	ВЫБОР
	               |		КОГДА ЗавершениеРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |			ТОГДА ЮрЛица.ИНН
	               |		КОГДА ЗавершениеРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	               |			ТОГДА ФизЛица.ИНН
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК ИННЗаказчика,
	               |	ЗавершениеРабот.ИсполнительДолжность КАК ПредставительОрганизацииДолжность,
	               |	ЗавершениеРабот.Исполнитель КАК ПредставительОрганизации,
	               |	ЗавершениеРабот.ЗаказчикДолжность КАК ПредставительЗаказчикаДолжность,
	               |	ЗавершениеРабот.Заказчик КАК ПредставительЗаказчика,
	               |	ЗавершениеРабот.Договор.ДатаДоговора КАК ДатаДоговора,
	               |	ЗавершениеРабот.Договор.НомерДоговора КАК НомерДоговора,
	               |	ПРЕДСТАВЛЕНИЕ(&РегламентированнаяВалюта) КАК ВалютаПечатиПредставление,
	               |	&РегламентированнаяВалюта КАК ВалютаПечати
	               |ИЗ
	               |	Документ.ЗавершениеРабот КАК ЗавершениеРабот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
	               |		ПО ЗавершениеРабот.Контрагент.ЮридическоеФизическоеЛицо = ФизЛица.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮрЛица
	               |		ПО ЗавершениеРабот.Контрагент.ЮридическоеФизическоеЛицо = ЮрЛица.Ссылка
	               |ГДЕ
	               |	ЗавершениеРабот.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТабЧасть.Дата КАК Дата,
	               |	ТабЧасть.ЭтапСдачиРаботы.Наименование КАК ЭтапСдачи,
	               |	СдачаЭтапаРаботСоставЭтапа.НомерСтроки КАК НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА СдачаЭтапаРаботСоставЭтапа.Номенклатура.НаименованиеПолное = """"
	               |			ТОГДА СдачаЭтапаРаботСоставЭтапа.Номенклатура.Наименование
	               |		ИНАЧЕ СдачаЭтапаРаботСоставЭтапа.Номенклатура.НаименованиеПолное
	               |	КОНЕЦ + "". "" + СдачаЭтапаРаботСоставЭтапа.Содержание КАК ЭтапВыполнения,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.ВалютаДокумента = ТабЧасть.ВалютаДокументаЭтапа
	               |				ИЛИ ТабЧасть.ВалютаДокумента = &ПустаяВалюта
	               |					И ТабЧасть.ВалютаДокументаЭтапа = &РегламентированнаяВалюта
	               |				ИЛИ ТабЧасть.ВалютаДокумента = &РегламентированнаяВалюта
	               |					И ТабЧасть.ВалютаДокументаЭтапа = &ПустаяВалюта
	               |			ТОГДА СдачаЭтапаРаботСоставЭтапа.Всего
	               |		ИНАЧЕ СдачаЭтапаРаботСоставЭтапа.Всего * ТабЧасть.КурсВзаиморасчетовЭтапа * ТабЧасть.КратностьВзаиморасчетов / (ТабЧасть.КурсВзаиморасчетов * ТабЧасть.КратностьВзаиморасчетовЭтапа)
	               |	КОНЕЦ КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ТабЧасть.ВалютаДокумента = ТабЧасть.ВалютаДокументаЭтапа
	               |				ИЛИ ТабЧасть.ВалютаДокумента = &ПустаяВалюта
	               |					И ТабЧасть.ВалютаДокументаЭтапа = &РегламентированнаяВалюта
	               |				ИЛИ ТабЧасть.ВалютаДокумента = &РегламентированнаяВалюта
	               |					И ТабЧасть.ВалютаДокументаЭтапа = &ПустаяВалюта
	               |			ТОГДА СдачаЭтапаРаботСоставЭтапа.СуммаНДС
	               |		ИНАЧЕ СдачаЭтапаРаботСоставЭтапа.СуммаНДС * ТабЧасть.КурсВзаиморасчетовЭтапа * ТабЧасть.КратностьВзаиморасчетов / (ТабЧасть.КурсВзаиморасчетов * ТабЧасть.КратностьВзаиморасчетовЭтапа)
	               |	КОНЕЦ КАК СуммаНДС
	               |ИЗ
	               |	ТабЧасть КАК ТабЧасть
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СдачаЭтапаРабот.СоставЭтапаРабот КАК СдачаЭтапаРаботСоставЭтапа
	               |		ПО ТабЧасть.ДокументСдачиЭтапа = СдачаЭтапаРаботСоставЭтапа.Ссылка
	               |ГДЕ
	               |	СдачаЭтапаРаботСоставЭтапа.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ТабЧ.ДокументСдачиЭтапа
	               |			ИЗ
	               |				ТабЧасть КАК ТабЧ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	НомерСтроки
	               |ИТОГИ
	               |	СУММА(Сумма),
	               |	СУММА(СуммаНДС)
	               |ПО
	               |	ОБЩИЕ,
	               |	ЭтапСдачи";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ПустаяВалюта", Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ДатаДок", Ссылка.Дата);
	МассивРезультат = Запрос.ВыполнитьПакет();
	ВыборкаШапка = МассивРезультат[1].Выбрать();
	ВыборкаТЧ    = МассивРезультат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураДанных = Новый Структура("ВыборкаШапка, ВыборкаТЧ", ВыборкаШапка, ВыборкаТЧ);
	
	Возврат(СтруктураДанных);
КонецФункции	

Функция ЗаполнитьМногострочнуюЧасть(ТекВыборка, Макет, ТабДокумент, ИмяОбласти)
	ТекОбласть = Макет.ПолучитьОбласть(ИмяОбласти);
	СуммаИтого = 0;
	СуммаНДС   = 0;
	Пока ТекВыборка.Следующий() Цикл
		Если ТекВыборка.ТипЗаписи() = ТипЗаписиЗапроса.ОбщийИтог Тогда
			СуммаИтого = ТекВыборка.Сумма;
			СуммаНДС   = ТекВыборка.СуммаНДС;
			Выборка = ТекВыборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ЗаполнитьМногострочнуюЧасть(Выборка, Макет, ТабДокумент, "СтрокаЭС");
			Прервать;
		КонецЕсли;	
		
		ТекОбласть.Параметры.Заполнить(ТекВыборка);
		ТабДокумент.Вывести(ТекОбласть);
		
		Если ИмяОбласти = "СтрокаЭВ" Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка = ТекВыборка.Выбрать();
		ЗаполнитьМногострочнуюЧасть(Выборка, Макет, ТабДокумент, "СтрокаЭВ");
	КонецЦикла;	
	Если ИмяОбласти = "Итог" Тогда
		ТекОбласть.Параметры.СуммаИтого = СуммаИтого;
		ТекОбласть.Параметры.СуммаНДС   = СуммаНДС;
		ТабДокумент.Вывести(ТекОбласть);
	КонецЕсли;	
	
	Возврат СуммаИтого;
КонецФункции	

Функция СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ШиринаВСимволах) Экспорт
	ТекСтрока = "";
	ВсегоСимволов = 0;
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
		ТекСлово = МассивСлов[к];
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		Если ВсегоСимволов < ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
		ИначеЕсли ВсегоСимволов = ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		Иначе
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТекСтрока;
КонецФункции	

Функция ВывестиДлиннуюСтроку(Знач СтрокаВыода, ТабДокумент, Область1, Область2, НаименованиеЯчейкиОбласть1, НаименованиеЯчейкиОбласть2, 
								НачальныйИндексПараметра1 = 0) Экспорт
	СтрокаВыода = СтрЗаменить(СтрокаВыода, Символы.ПС, " ");
	МассивСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаВыода, " ");
	
	ЯчейкаОбласть1 = Область1.Область(НаименованиеЯчейкиОбласть1);
	ЯчейкаОбласть2 = Область2.Область(НаименованиеЯчейкиОбласть2);
	
	ТекШиринаКолонок1 = ?(ЯчейкаОбласть1.ШиринаКолонки = 0, 9, ЯчейкаОбласть1.ШиринаКолонки);
	ТекШиринаКолонок2 = ?(ЯчейкаОбласть2.ШиринаКолонки = 0, 9, ЯчейкаОбласть2.ШиринаКолонки);
	
	ЧислоСимволов1 = ТекШиринаКолонок1 * (ЯчейкаОбласть1.Право - ЯчейкаОбласть1.Лево + 1);
	ЧислоСимволов2 = ТекШиринаКолонок2 * (ЯчейкаОбласть2.Право - ЯчейкаОбласть2.Лево + 1);
	
	ТекИндекс = 0;
	Область1.Параметры.Установить(НачальныйИндексПараметра1, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов1));
	ТабДокумент.Вывести(Область1);
	КолВыведенныхСтрок = 0;
	Пока ТекИндекс <= МассивСлов.Количество() - 1 Цикл
		Область2.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов2));
		ТабДокумент.Вывести(Область2);
		КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
	КонецЦикла;	
	
	Возврат КолВыведенныхСтрок;
КонецФункции

