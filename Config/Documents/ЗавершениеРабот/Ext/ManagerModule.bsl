#Область ПрограммныйИнтерфейс

// Возвращает полный список номенклатуры выполненных работ
//  для заданного документа "Завершение работ".
//
Функция НоменклатураВыполненныхРабот(ДокументЗавершениеРабот) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Док.ДокументСдачиЭтапа КАК Ссылка
	|ПОМЕСТИТЬ ДокументыСдачиЭтапа
	|ИЗ
	|	Документ.ЗавершениеРабот.СоставРаботы КАК Док
	|ГДЕ
	|	Док.Ссылка = &ДокументЗавершениеРабот
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СдачаЭтапов.Номенклатура КАК НоменклатураРабот
	|ИЗ
	|	Документ.СдачаЭтапаРабот.СоставЭтапаРабот КАК СдачаЭтапов
	|ГДЕ
	|	СдачаЭтапов.Ссылка В
	|			(ВЫБРАТЬ
	|				ДокументыСдачиЭтапа.Ссылка
	|			ИЗ
	|				ДокументыСдачиЭтапа)";
	Запрос.УстановитьПараметр("ДокументЗавершениеРабот", ДокументЗавершениеРабот);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НоменклатураРабот");
	
КонецФункции

// Возвращает таблицу остатков накопленных ДБП за выполнение работ.
//
Функция НакопленныеДоходыБудущихПериодов(Период, Организация, ИФО, КФО, МассивРабот = Неопределено) Экспорт
	
	// Формируем запрос по остаткам доходов будущих периодов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.КЭК КАК КЭК,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ЕПСБУОстатки.Субконто1) КАК НоменклатураПредставление,
	|	ЕПСБУОстатки.Валюта КАК Валюта,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСумма,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонПериода,
	|			Счет В (&СчетаДБП),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И КФО = &КФО
	|				И &ОтборРабот) КАК ЕПСБУОстатки";
	
	Запрос.УстановитьПараметр("КонПериода",           Период);
	Запрос.УстановитьПараметр("Организация",          Организация);
	Запрос.УстановитьПараметр("КФО",                  КФО);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("СчетаДБП",             БухгалтерскийУчет.СписокСчетов("401.40"));
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.УстановитьПараметр("ИФО", ИФО);
	
	Если МассивРабот = Неопределено Тогда
		
		УслугиРаботы = Новый Массив;
		УслугиРаботы.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
		УслугиРаботы.Добавить(Перечисления.ТипыНоменклатуры.Работа);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборРабот", "ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ТипНоменклатуры В (&УслугиРаботы)");
		Запрос.УстановитьПараметр("УслугиРаботы", УслугиРаботы);
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборРабот", "Субконто1 В (&МассивРабот)");
		Запрос.УстановитьПараметр("МассивРабот", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(МассивРабот));
		
	КонецЕсли;
	
	ТаблицаОстатковДБП = Запрос.Выполнить().Выгрузить();
	ТаблицаОстатковДБП.Сортировать("Счет,НоменклатураПредставление");
	
	Возврат ТаблицаОстатковДБП;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗавершениеРабот";
	КомандаПечати.Идентификатор		= "ПФ_MXL_АктСдачиПриемкиРабот";
	КомандаПечати.Представление		= НСтр("ru = 'Акт сдачи-приемки работ'");
	КомандаПечати.Порядок			= 1;
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_АктСдачиПриемкиРабот") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_АктСдачиПриемкиРабот",
			"Акт сдачи-приемки работ",
			ПечатьАкта(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

