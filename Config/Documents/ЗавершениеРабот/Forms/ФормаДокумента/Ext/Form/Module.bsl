&НаСервере
Процедура ВидимостьЭлементов()
	
	Элементы.НоменклатураЭтаповИФО.Видимость = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
	Элементы.НоменклатураЭтаповПодразделение.Видимость = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭлементов()
	
	Элементы.НоменклатураРабот.Видимость = ОтображатьСоставЭтапов;
	
	Если ОтображатьСоставЭтапов Тогда
		Элементы.ОтображатьСоставЭтапов.Заголовок = "Скрыть состав этапов";
	Иначе
		Элементы.ОтображатьСоставЭтапов.Заголовок = "Отобразить состав этапов";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Объект.СоставРаботы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СдачаЭтапаРабот.Ссылка КАК ДокументСдачиЭтапа
	|ИЗ
	|	Документ.СдачаЭтапаРабот КАК СдачаЭтапаРабот
	|ГДЕ
	|	СдачаЭтапаРабот.Договор В ИЕРАРХИИ(&Договор)";
				   
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СоставРаботы.Загрузить(Результат.Выгрузить());
	
	Если ОтображатьСоставЭтапов Тогда
		ЗаполнитьНоменклатуруЭтапов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаИзДоговора(Договор)
	Возврат Договор.Контрагент;
КонецФункции

&НаСервере
Процедура ЗаполнитьНоменклатуруЭтапов()
	
	СписокДокументов = Объект.СоставРаботы.Выгрузить(, "ДокументСдачиЭтапа");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК ДокументСдачиЭтапа,
	|	ЖурналПроводокЕПСБУОбороты.КорСчет КАК Счет,
	|	ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОбороты.КПСКор КАК КПС,
	|	ЖурналПроводокЕПСБУОбороты.КЭККор КАК КЭК,
	|	ЖурналПроводокЕПСБУОбороты.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОбороты.ВалютаКор КАК Валюта,
	|	ЖурналПроводокЕПСБУОбороты.ПодразделениеКор КАК Подразделение,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборот КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			,
	|			,
	|			,
	|			КорСчет В
	|				(ВЫБРАТЬ
	|					ПланСчетов.Ссылка
	|				ИЗ
	|					ПланСчетов.ЕПСБУ КАК ПланСчетов
	|				ГДЕ
	|					ПланСчетов.Ссылка В ИЕРАРХИИ
	|						(ВЫБРАТЬ
	|							ПланСчетов.Ссылка
	|						ИЗ
	|							ПланСчетов.ЕПСБУ КАК ПланСчетов
	|						ГДЕ
	|							ПланСчетов.Код = ""401.40"")),
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|ГДЕ
	|	ЖурналПроводокЕПСБУОбороты.Регистратор В(&ДокументыСдачиЭтапов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументСдачиЭтапа,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Справочник.Номенклатура).Наименование
	|ИТОГИ ПО
	|	ДокументСдачиЭтапа ИЕРАРХИЯ";
	Запрос.УстановитьПараметр("ДокументыСдачиЭтапов", СписокДокументов);
	
	ВыборкаДокументы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоРабот = РеквизитФормыВЗначение("НоменклатураЭтапов");
	ДеревоРабот.Строки.Очистить();
	
	Пока ВыборкаДокументы.Следующий() Цикл
		СтрокаДерева = ДеревоРабот.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, ВыборкаДокументы);
		
		ВыборкаДетали = ВыборкаДокументы.Выбрать();
		Пока ВыборкаДетали.Следующий() Цикл
			СтрокаДереваДетали = СтрокаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДереваДетали, ВыборкаДетали);
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРабот, "НоменклатураЭтапов");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИсполнительОбработкаВыбораСервер(Сотрудник, Период)
	
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, Должность, ДолжностьНаименование",
	Сотрудник, 
	Период);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
	
	Возврат ДанныеСотрудника;
	
КонецФункции

