
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ПрочитатьРежимыЗаполненияДанных();
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.СрокДействия = КонецДня(ТекущаяДатаСеанса());
		Объект.ДатаВыездаТС = ТекущаяДатаСеанса();
        Объект.ДатаВозвращенияТС = КонецДня(ТекущаяДатаСеанса());

		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.НомерСмены = УчетГСМ.НомерСменыДляПутевогоЛиста(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата) + 1;
		КонецЕсли;	
		
		//заполнение показаний спидометра при выезде
		Если ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
			Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
				ЗаполнитьДанныеОПоказанияхСпидометра();
			КонецЕсли;	
			
			//очистка данных спидометра (одометра) при возвращении
			ОчиститьДанныеСпидометраПриВозвращении();
		КонецЕсли;
		
		//заполнение остатков горючего
		Если ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
			Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
				ЗаполнитьДанныеОбОстаткахГорючего();
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьДанныеМедосмотраДокумена();
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;	
	ЗаполнитьСписокВыбораВодителя();
	УстановитьСвойстваЭлементовНовыхРеквизитовФормы(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Если НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования.ВидПеревозки) Тогда
			Объект.ВидПеревозки = УчетГСМ.ДанныеСведенийОПеревозкеПоУмолчанию();
		КонецЕсли;
	КонецЕсли;	
	
	ПоказатьКоличествоВремени();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	СоздатьКнопкуДляАдреса(ЭтаФорма,"АдресПодачи",Элементы.ГруппаАдресПодачи);
	СоздатьКнопкуДляВидаПеревозки(ЭтаФорма,"ВидПеревозки",Элементы.ГруппаВидПеревозки);
	ПоказатьДанныеСпидометра();
	
	ЗаполнитьТекстПроТаксировку(); 
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	УстановитьВидимостьЭлементовМедосмотра();
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СуммаОплатыИтого = Объект.РасчетЗаработнойПлатыЗаКилометраж + Объект.РасчетЗаработнойПлатыЗаЧасы;
	
	ПерерасчетРасходаЭкономииПерерасходаПоСтрокам();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПроверитьДатуМедЛицензий() Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Выбранная медицинская лицензия не действует на дату путевого листа.
								|Следует выбрать действующую лицензию или очистить значение реквизита.'"));
		Отказ = Истина;
	КонецЕсли;
   
	УстановитьСрокДействияПоУмолчанию();
	
	Для Каждого ТекСтрока Из Объект.МаршрутДвижения Цикл
		ТекСтрока.ВремяПростоя = УчетВремениКлиентСервер.ЧислоИзСтроки(ТекСтрока.ВремяПростояСтр);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_Таксировка"
			И Параметр.ДокументыОснования.Найти(Объект.Ссылка) <> Неопределено Тогда
		ЗаполнитьТекстПроТаксировку();
		ПоказатьДанныеСпидометра();
	
	КонецЕсли;

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыМаршруты(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	ПоказатьКоличествоВремени();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПоказатьКоличествоВремени();
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПерерасчетРасходаЭкономииПерерасходаПоСтрокам();

	ПроверитьДанныеПутевогоЛиста();
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Объект.ТранспортноеСредство = ВыбранноеЗначение;
		ТранспортноеСредствоПриИзмененииНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СрокДействияПриИзменении(Элемент)
	СрокДействияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТранспортноеСредствоПриИзменении(Элемент)
	
	ТранспортноеСредствоПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТранспортноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура("Организация", Объект.Организация);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, РежимВыбора, ЗакрыватьПриВыборе, МножественныйВыбор, ТолькоАгрегаты, ТекущаяСтрока",
		Отбор, Истина, Истина, Истина, Ложь, Ложь, Объект.ТранспортноеСредство);
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаВыбораТранспортногоСредства", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	УстановитьСрокДействияПоУмолчанию();
	УстановитьСвойстваЭлементовНовыхРеквизитовФормы(ЭтотОбъект);	
	ПриИзмененииДатыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НадписьТаксировкаНажатие(Элемент, СтандартнаяОбработка)
	УчетГСМКлиент.ТаксировкаНажатие(ДокументТаксировка,ЭтаФорма,СтандартнаяОбработка);	
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Сотрудники.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеНаименованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		СписокСотрудников = ВыбранноеЗначение;
		СтрокаВРаспоряжениеНаименование = Объект.ВРаспоряжениеНаименование;
		Для н = 1 По ВыбранноеЗначение.Количество() Цикл
			СтрокаВРаспоряжениеНаименование = СтрокаВРаспоряжениеНаименование + ?(СокрЛП(СтрокаВРаспоряжениеНаименование) = "","",", ")+ КорреспондентыКлиентСервер.ФИО(Строка(ВыбранноеЗначение[н-1]), Ложь);
		КонецЦикла;	
		ВыбранноеЗначение = СтрокаВРаспоряжениеНаименование;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеОрганизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеОрганизацииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		СтрокаКонтрагентов = Объект.ВРаспоряжениеОрганизация;
		Для н = 1 По ВыбранноеЗначение.Количество() Цикл
			СтруктураДанных = ПолучитьНаименованиеКонтрагента(ВыбранноеЗначение[н-1], Объект.Дата);
			СтрокаКонтрагентов = СтрокаКонтрагентов + ?(СокрЛП(СтрокаКонтрагентов) = "","",", ")+ ?(ЗначениеЗаполнено(СтруктураДанных.НаименованиеСокращенное),СтруктураДанных.НаименованиеСокращенное,СтруктураДанных.НаименованиеПолное);
		КонецЦикла;	
		ВыбранноеЗначение = СтрокаКонтрагентов;
	КонецЕсли;
КонецПроцедуры

