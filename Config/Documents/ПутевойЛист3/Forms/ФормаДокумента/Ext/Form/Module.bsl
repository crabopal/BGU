&НаСервере
Процедура ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПутевойЛистТС)
	
	ДанныеГорючего = УчетГСМ.ДвиженияГорючегоРасчетные(ПутевойЛистТС);
	
	Для каждого ТекСтрока Из ДанныеГорючего Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ВидГСМ) Тогда
			Если ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
				ПараметрыОтбора = Новый Структура("ВидГСМ");
				ПараметрыОтбора.Вставить("ВидГСМ", ТекСтрока.ВидГСМ); 
				СтрокиНайденые = Объект.ДвижениеГорючего.НайтиСтроки(ПараметрыОтбора);
				Если СтрокиНайденые.Количество() = 0 Тогда
					НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
					НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
					НоваяСтрока.МаркаГорючего = ТекСтрока.ВидГСМ.МаркаГорючего;
					НоваяСтрока.КодМаркиГорючего = ТекСтрока.ВидГСМ.КодМаркиГорючего;
					НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
					НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении;
				Иначе
					Для Каждого ТекСтрокаНайденная Из СтрокиНайденые Цикл
						ТекСтрокаНайденная.ВидГСМ = ТекСтрока.ВидГСМ;
						ТекСтрокаНайденная.МаркаГорючего = ТекСтрока.ВидГСМ.МаркаГорючего;
						ТекСтрокаНайденная.КодМаркиГорючего = ТекСтрока.ВидГСМ.КодМаркиГорючего;
						ТекСтрокаНайденная.ЕдиницаИзмеренияГорючего = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
						ТекСтрокаНайденная.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении;
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКнопкуДляАдреса(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиЗаполненияАдреса";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить адрес'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОПоказанияхСпидометра()
	
	ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
				
	ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
		ДанныеСпидометра = УчетГСМ.ПоказанияСпидометраРасчетные(ПредыдущийПутевойЛист);
		Объект.ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	ИначеЕсли ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ Тогда
		Объект.ПоказанияСпидометраПриВыезде = ДанныеСпидометра;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеОбОстаткахГорючего()
	
	Если НЕ ЗначениеЗаполнено(ПредыдущийПутевойЛист) Тогда
		ПредыдущийПутевойЛист = УчетГСМ.НайтиПредыдущийПутевойЛист(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата);
	КонецЕсли;
				
	ДанныеГорючего = УчетГСМ.ОстаткиГорючегоПоПутевомуЛисту(ПредыдущийПутевойЛист);
	
	Если ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПредыдущийПутевойЛист);
	ИначеЕсли ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ Тогда
		Объект.ДвижениеГорючего.Очистить();
		Для Каждого ТекСтрока Из ДанныеГорючего Цикл
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			
			НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
			Если ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.ЕдиницаИзмерения;
			Иначе	
				Если ЗначениеЗаполнено(ТекСтрока.ВидГСМ) Тогда
					НоваяСтрока.ЕдиницаИзмеренияГорючего = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;	
			НоваяСтрока.МаркаГорючего = ТекСтрока.МаркаГСМ;
			НоваяСтрока.КодМаркиГорючего = ТекСтрока.КодМаркиГСМ;
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГСМ;
		КонецЦикла;	
		ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыМаршруты(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.МаршрутДвижения Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыМаршруты(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыМаршруты(ТекущаяСтрока)

	ТекущаяСтрока.КонтрагентЗаголовок = НСтр("ru = 'контрагент:'");
	ТекущаяСтрока.КодЗаказчикаЗаголовок = НСтр("ru = 'код:'");
	ТекущаяСтрока.МестоОтправленияЗаголовок = НСтр("ru = 'отправление:'");
	ТекущаяСтрока.МестоНазначенияЗаголовок = НСтр("ru = 'назначение:'");
	ТекущаяСтрока.ВремяВыездаЗаголовок = НСтр("ru = 'выезд:'");
	ТекущаяСтрока.ВремяВозвращенияЗаголовок = НСтр("ru = 'возвращение:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ДвижениеГорючего Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыДвижениеГорючего(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДвижениеГорючего(ТекущаяСтрока)

	ТекущаяСтрока.ВидГСМЗаголовок = НСтр("ru = 'вид ГСМ:'");
	ТекущаяСтрока.ЕдИзмЗаголовок = НСтр("ru = 'ед.изм.:'");
	ТекущаяСтрока.МаркаГорючегоЗаголовок = НСтр("ru = 'марка:'");
	ТекущаяСтрока.КодМаркиГорючегоЗаголовок = НСтр("ru = 'код марки:'");
	ТекущаяСтрока.ВыданоЗаголовок = НСтр("ru = 'количество:'");
	ТекущаяСтрока.НомерЗаправочногоЛистаЗаголовок = НСтр("ru = '№ зап.листа:'");
	ТекущаяСтрока.ОстатокПриВыездеЗаголовок = НСтр("ru = 'при выезде:'");
	ТекущаяСтрока.ОстатокПриВозвращенииЗаголовок = НСтр("ru = 'при возвращении:'");
	ТекущаяСтрока.НормативныйРасходЗаголовок = НСтр("ru = 'нормативный:'");
	ТекущаяСтрока.ФактическийРасходЗаголовок = НСтр("ru = 'фактический:'");
	ТекущаяСтрока.ЭкономияЗаголовок = НСтр("ru = 'экономия:'");
	ТекущаяСтрока.ПерерасходЗаголовок = НСтр("ru = 'перерасход:'");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыМаршруты(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеСпидометраПриВозвращении()
	
	Объект.ПоказанияСпидометраПриВозвращении = 0;
	
КонецПроцедуры	

&НаСервере
Процедура ТранспортноеСредствоПриИзмененииНаСервере()
	
	УстановитьНомераТС();
	ЗаполнитьНастройкиЗаполненияДокумента(Объект.ТранспортноеСредство);
	Объект.НомерСмены = УчетГСМ.НомерСменыДляПутевогоЛиста(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата) + 1;
		
	//заполнение показаний спидометра при выезде
	Если ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ Тогда
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
			ЗаполнитьДанныеОПоказанияхСпидометра();
		КонецЕсли;	
	КонецЕсли;
	
	//заполнение остатков горючего
	Если ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 
			ЗаполнитьДанныеОбОстаткахГорючего();
		КонецЕсли;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
		Объект.ВидПеревозки = УчетГСМ.ДанныеСведенийОПеревозкеПоУмолчанию();
	КонецЕсли;
	
	ЗаполнитьСписокВыбораВодителя();
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	
КонецПроцедуры	

