&НаКлиенте
Процедура МаршрутДвиженияРассчитатьПройденоКилометров()
	Объект.РезультатРаботыТСВсегоПробег = Объект.МаршрутДвижения.Итог("ПройденоКилометров");
	Если Объект.РезультатРаботыТСВсегоПробег >= 0 Тогда
		Объект.ПоказанияСпидометраПриВозвращении = Объект.ПоказанияСпидометраПриВыезде + Объект.РезультатРаботыТСВсегоПробег;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МаршрутДвиженияРассчитатьПродолжительностьПростояТС()
	ВсегоПростойТС = 0;
	Для Каждого ТекСтрока Из Объект.МаршрутДвижения Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ВремяПростоя) Тогда
			ПростойЧасов = ТекСтрока.ВремяПростоя / 3600;
			
			ВсегоПростойТС = ВсегоПростойТС + ПростойЧасов;
		КонецЕсли;
	КонецЦикла;	
	Объект.ПростойВсегоНеУчитываемыйВРезультатахРаботыТС = ВсегоПростойТС;
	РассчитатьРезультатЧасыРаботы();
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьРезультатЧасыРаботы()
	
	Если ЗначениеЗаполнено(Объект.ДатаВозвращенияТС)
		И ЗначениеЗаполнено(Объект.ДатаВыездаТС)
		И ЗначениеЗаполнено(Объект.ВремяВозвращенияТС)
		И ЗначениеЗаполнено(Объект.ВремяВыездаТС) Тогда
		
		НачалоПериодаДатаСтр = Формат(Объект.ДатаВыездаТС, "ДФ=""ггггММдд""");
		НачалоПериодаВремяСтр = Формат(Объект.ВремяВыездаТС, "ДФ=""ЧЧммсс""");
		НачалоПериода = Дата(НачалоПериодаДатаСтр + НачалоПериодаВремяСтр);
		
		КонецПериодаДатаСтр = Формат(Объект.ДатаВозвращенияТС, "ДФ=""ггггММдд""");
		КонецПериодаВремяСтр = Формат(Объект.ВремяВозвращенияТС, "ДФ=""ЧЧммсс""");
		КонецПериода = Дата(КонецПериодаДатаСтр + КонецПериодаВремяСтр);
		
		РазностьДат = КонецПериода - НачалоПериода;
		РазностьДатЧасов = РазностьДат / 3600 - Объект.ПростойВсегоНеУчитываемыйВРезультатахРаботыТС;
		
		Объект.РезультатРаботыТСВсегоВремя = Окр(РазностьДатЧасов, 2, РежимОкругления.Окр15как10);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьРезультатПробегРаботы()
	Объект.РезультатРаботыТСВсегоПробег = Объект.ПоказанияСпидометраПриВозвращении - Объект.ПоказанияСпидометраПриВыезде;
	Если Объект.РезультатРаботыТСВсегоПробег < 0 Тогда
		Объект.РезультатРаботыТСВсегоПробег = 0;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьДанныеПутевогоЛиста()
	Если НачалоДня(Объект.Дата) >= Дата(2021,1,1) Тогда
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
			МодельТС = МодельТС();
			Если НЕ ЗначениеЗаполнено(МодельТС) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = НСтр("ru='Не заполнена модель транспортного средства в сведениях паспорта. 
					|Чтобы заполненить эти сведения для соответствующего элемента справочника ""Основные средства"" (реквизит ""Транспортное средство"")
					|следует перейти по ссылке для реквизита ""Паспорт транспортного средства"" на закладке ""Инвентарный объект"".'");
				Сообщение.Сообщить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция МодельТС()
	Возврат УчетГСМ.ПолучитьМодельТС(Объект.ТранспортноеСредство);
КонецФункции	

&НаСервере
Процедура ПоказатьКоличествоВремени()
	Для Каждого ТекСтрока Из Объект.МаршрутДвижения Цикл
		ТекСтрока.ВремяПростояСтр = УчетВремениКлиентСервер.ЧислоВСтроку(ТекСтрока.ВремяПростоя);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовНовыхРеквизитовФормы(Форма)
	Объект = Форма.Объект;

	Если Объект.Дата < Дата('2023.03.01') Тогда
		ВидимостьРеквизитов2023 = Ложь;
	Иначе
		ВидимостьРеквизитов2023 = Истина;
	КонецЕсли;	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СведенияОПеревозке", "Видимость", НЕ ВидимостьРеквизитов2023);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаВидПеревозки", "Видимость", ВидимостьРеквизитов2023);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СведенияОВидахСообщения", "Видимость", ВидимостьРеквизитов2023);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВидСообщения", "Видимость", ВидимостьРеквизитов2023);
КонецПроцедуры

&НаСервере
Процедура СоздатьКнопкуДляВидаПеревозки(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиЗаполненияВидаПеревозки";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить вид перевозки'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКнопкиЗаполненияВидаПеревозки(КомандаФормы)
	
	Элемент = ЭтаФорма.Элементы.Найти(КомандаФормы.Имя);
	СписокВидыПеревоок = УчетГСМКлиент.СписокВидыПеревозок();
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораВидаПеревозки", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокВидыПеревоок, Элемент);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыполнитьПослеВыбораВидаПеревозки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Сред(ДополнительныеПараметры.Элемент.Имя,10);
	Объект[ИмяРеквизита] = ВыбранныйЭлемент; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРезультатВыбораВидовСообщения(Элементы, Параметры) Экспорт
	Результат = "";
	ПероеЗначение = Истина;
	Если НЕ Элементы = Неопределено Тогда
		Для Каждого ВыбранныйВидСообщения Из Элементы Цикл
			Если ВыбранныйВидСообщения.Пометка Тогда
				Если ПероеЗначение Тогда
					НовыйРезультат = СтрШаблон("%1", СокрЛП(ВыбранныйВидСообщения.Значение));
					
					ПероеЗначение = Ложь;
				Иначе	
					НовыйРезультат = СтрШаблон("%1, %2", Результат, СокрЛП(ВыбранныйВидСообщения.Значение));
				КонецЕсли;
				Результат = НовыйРезультат;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.СведенияОВидахСообщения = Результат;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьЭлементовМедосмотра()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОрганизацияПроводящаяПредрейсовыйМедосмотр", "Видимость", Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтороннееЛицоДопускающееВодителяПоСостояниюЗдоровья", "Видимость", Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицоДопускающееВодителяПоСостояниюЗдоровья", "Видимость", НЕ Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр", "Видимость", Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр", "Видимость", НЕ Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр);	
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОрганизацияПроводящаяПослерейсовыйМедосмотр", "Видимость", Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр); 
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтороннееЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья", "Видимость", Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр); 
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья", "Видимость", НЕ Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр", "Видимость", Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр", "Видимость", НЕ Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр);	
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыПредрейсовогоМедосмотра()
	
	Если Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр Тогда
		
		Объект.ЛицоДопускающееВодителяПоСостояниюЗдоровья 			= Неопределено;
		Объект.ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр 	= Неопределено;
		
	Иначе

		Объект.СтороннееЛицоДопускающееВодителяПоСостояниюЗдоровья 	= Неопределено;
		Объект.ОрганизацияПроводящаяПредрейсовыйМедосмотр 			= Неопределено;
		Объект.ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр 	= Неопределено;
		
	КонецЕсли; 
	
	УстановитьВидимостьЭлементовМедосмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыПослерейсовогоМедосмотра()
	
	Если Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр Тогда
		
		Объект.ЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья = Неопределено; 
		Объект.ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр 	= Неопределено;
		
	Иначе

		Объект.СтороннееЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья 	= Неопределено; 
		Объект.ОрганизацияПроводящаяПослерейсовыйМедосмотр 						= Неопределено; 
		Объект.ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр				= Неопределено;
						
	КонецЕсли;  
	
	УстановитьВидимостьЭлементовМедосмотра();
	
КонецПроцедуры
 
&НаСервереБезКонтекста
Функция ЛицензияМедОрганизации(Организация, ДатаДокумента)
	
	МетаданныеОрганизации = Метаданные.НайтиПоТипу(ТипЗнч(Организация));
	
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛицензииНаПроведениеМедосмотров.Ссылка КАК Ссылка
	               |ИЗ
	               |	&Справочник КАК ЛицензииНаПроведениеМедосмотров
	               |ГДЕ
	               |	ЛицензииНаПроведениеМедосмотров.Владелец = &Владелец
				   |	И ЛицензииНаПроведениеМедосмотров.ДатаНачала <= &ДатаДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛицензииНаПроведениеМедосмотров.ДатаНачала УБЫВ"; 
	
	Если МетаданныеОрганизации.Имя = "Организации" Тогда
		
		СправочникЛицензий = "Справочник.ЛицензииНаПроведениеМедосмотровОрганизаций";
		
	ИначеЕсли МетаданныеОрганизации.Имя = "Контрагенты" Тогда
		
		СправочникЛицензий = "Справочник.ЛицензииНаПроведениеМедосмотровКонтрагентов";	

	Иначе
		Возврат Неопределено;	
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(Текст,"&Справочник", СправочникЛицензий);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Владелец", Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из Результат Цикл 
		Возврат ТекСтрока.Ссылка;
	КонецЦикла;

КонецФункции  

&НаСервере
Функция ПроверитьДатуМедЛицензий()
	
	Если Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр Тогда
		ОбъектПредрейсовойЛицензии = Объект.ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр;
	Иначе
		ОбъектПредрейсовойЛицензии 	= Объект.ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр;
	КонецЕсли;
	
	Если Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр Тогда
		ОбъектПослерейсовойЛицензии = Объект.ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр;
	Иначе
		ОбъектПослерейсовойЛицензии = Объект.ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр;
	КонецЕсли;
	
	ЛицензияНедействительна = Ложь;
	
	Если ЗначениеЗаполнено(ОбъектПредрейсовойЛицензии) Тогда
		
		Если НачалоДня(ОбъектПредрейсовойЛицензии.ДатаНачала) > Объект.Дата Тогда
		 	ЛицензияНедействительна = Истина;
		ИначеЕсли КонецДня(ОбъектПредрейсовойЛицензии.ДатаОкончания) < Объект.Дата И НЕ ОбъектПредрейсовойЛицензии.ДатаОкончания = Дата(1,1,1) Тогда 
			ЛицензияНедействительна = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектПослерейсовойЛицензии) Тогда
		
		Если НачалоДня(ОбъектПослерейсовойЛицензии.ДатаНачала) > Объект.СрокДействия Тогда
		 	ЛицензияНедействительна = Истина;
		ИначеЕсли КонецДня(ОбъектПослерейсовойЛицензии.ДатаОкончания) < Объект.СрокДействия И НЕ ОбъектПослерейсовойЛицензии.ДатаОкончания = Дата(1,1,1) Тогда 
			ЛицензияНедействительна = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЛицензияНедействительна;

КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеМедосмотраДокумена()
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли; 
	
	ТаблицаНастроекМедосмотра = УчетГСМ.ДанныеНастроекЗаполненияМедосмотраДокумента(Объект.Организация);
	
	Для Каждого ТекСтрока Из ТаблицаНастроекМедосмотра Цикл
		
		Объект.ЛицоДопускающееВодителяПоСостояниюЗдоровья 						= ТекСтрока.ЛицоДопускающееВодителяПоСостояниюЗдоровья;
		Объект.ЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья 			= ТекСтрока.ЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья;
		Объект.ЗаполнятьОтметкуОПослерейсовомМедосмотре 						= ТекСтрока.ЗаполнятьОтметкуОПослерейсовомМедосмотре;
		Объект.ЗаполнятьОтметкуОПредрейсовомМедосмотре 							= ТекСтрока.ЗаполнятьОтметкуОПредрейсовомМедосмотре;
		Объект.ОрганизацияПроводящаяПослерейсовыйМедосмотр 						= ТекСтрока.ОрганизацияПроводящаяПослерейсовыйМедосмотр;
		Объект.ОрганизацияПроводящаяПредрейсовыйМедосмотр 						= ТекСтрока.ОрганизацияПроводящаяПредрейсовыйМедосмотр;
		Объект.СтороннееЛицоДопускающееВодителяПоСостояниюЗдоровья 				= ТекСтрока.СтороннееЛицоДопускающееВодителяПоСостояниюЗдоровья;
		Объект.СтороннееЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья 	= ТекСтрока.СтороннееЛицоПринимающееВодителяПослеРейсаПоСостояниюЗдоровья;
		Объект.ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр 				= ТекСтрока.ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр;
		Объект.ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр 				= ТекСтрока.ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр;  
		Объект.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр 				= ТекСтрока.СторонняяОрганизацияПроводитПослерейсовыйМедосмотр;
		Объект.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр 				= ТекСтрока.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр;
	    Объект.ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр				= ТекСтрока.ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр;
		Объект.ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр				= ТекСтрока.ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборМедЛицензииОрганизации(ПроводящаяОрганизация, ТипОрганизации, ТипМедосмотра)
 
	ДополнительныеПараметры = Новый Структура("ТипОрганизации, ТипМедосмотра", ТипОрганизации, ТипМедосмотра);
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьМедицинскуюЛицензиюПослеВыбора",ЭтотОбъект, ДополнительныеПараметры);
	
	СтруктураОтбора = Новый Структура; 
	СтруктураОтбора.Вставить("Владелец", ПроводящаяОрганизация);
	
	Если ТипМедосмотра = "Предрейсовый" Тогда
		ДатаДокумента = Объект.Дата;	
	ИначеЕсли  ТипМедосмотра = "Послерейсовый" Тогда
		ДатаДокумента = Объект.СрокДействия; 
	Иначе
		Возврат;
	КонецЕсли;  
		
	ДополнительныеПараметры.Вставить("ДатаДокумента", ДатаДокумента);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
	ПараметрыФормы.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если ТипОрганизации = "Контрагент" Тогда
		НаименованиеСправочникаЛицензий = "ЛицензииНаПроведениеМедосмотровКонтрагентов";	
	ИначеЕсли ТипОрганизации = "Организация" Тогда
		НаименованиеСправочникаЛицензий = "ЛицензииНаПроведениеМедосмотровОрганизаций";
	Иначе
		Возврат;
	КонецЕсли;

	ОткрытьФорму(
	"Справочник." + НаименованиеСправочникаЛицензий + ".ФормаВыбора", ПараметрыФормы,
	,,,,Оповещение,
	);
 
 КонецПроцедуры
 
&НаКлиенте
Процедура ЗаполнитьМедицинскуюЛицензиюПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТипОрганизации = "Контрагент" И ДополнительныеПараметры.ТипМедосмотра = "Предрейсовый" Тогда
		
		  Объект.ЛицензияКонтрагентаПроводящегоПредрейсовыйМедосмотр = Результат;
		
	ИначеЕсли ДополнительныеПараметры.ТипОрганизации = "Контрагент" И ДополнительныеПараметры.ТипМедосмотра = "Послерейсовый" Тогда
		
		  Объект.ЛицензияКонтрагентаПроводящегоПослерейсовыйМедосмотр = Результат;
		
	ИначеЕсли ДополнительныеПараметры.ТипОрганизации = "Организация" И ДополнительныеПараметры.ТипМедосмотра = "Предрейсовый" Тогда

		  Объект.ЛицензияОрганизацииПроводящейПредрейсовыйМедосмотр = Результат;
		
	ИначеЕсли ДополнительныеПараметры.ТипОрганизации = "Организация" И ДополнительныеПараметры.ТипМедосмотра = "Послерейсовый" Тогда

		  Объект.ЛицензияОрганизацииПроводящейПослерейсовыйМедосмотр = Результат;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры 

