&НаКлиенте
Процедура ПерерасчетРасходаГорючегоПоСтроке(РасчетФактическогоРасхода = Ложь)
	ТекущиеДанные = Элементы.ДвижениеГорючего.ТекущиеДанные;
	
	Если РасчетФактическогоРасхода Тогда
		ФактическийРасход = ТекущиеДанные.ОстатокГорючегоПриВыезде + ТекущиеДанные.ВыданоГорючее - ТекущиеДанные.ОстатокГорючегоПриВозвращении;
		Если ФактическийРасход < 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Фактический расход горючего меньше нуля. Возможно в исходных данных о расходе горючего ошибка.'");
			Сообщение.Сообщить();
			
			Возврат;
		КонецЕсли;	
		ТекущиеДанные.ФактическийРасходГорючего = ФактическийРасход;
		
		ПерерасчетРасходаЭкономииПерерасходаПоСтроке(ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ПерерасчетРасходаЭкономииПерерасходаПоСтрокам()
	Для Каждого ТекСтрока Из Объект.ДвижениеГорючего Цикл
		ПерерасчетРасходаЭкономииПерерасходаПоСтроке(ТекСтрока);
	КонецЦикла;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ПерерасчетРасходаЭкономииПерерасходаПоСтроке(ТекущиеДанныеСтроки)
	Если ТекущиеДанныеСтроки.НормативныйРасходГорючего <> 0 Тогда
		ЭкономияПерерасход = ТекущиеДанныеСтроки.НормативныйРасходГорючего - ТекущиеДанныеСтроки.ФактическийРасходГорючего;
		
		Если ЭкономияПерерасход < 0 Тогда
			ТекущиеДанныеСтроки.Перерасход = (-1)*ЭкономияПерерасход;
			ТекущиеДанныеСтроки.Экономия = 0;
		Иначе
			ТекущиеДанныеСтроки.Экономия = ЭкономияПерерасход;
			ТекущиеДанныеСтроки.Перерасход = 0;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДатыНаСервере()
	
	Объект.НомерСмены = УчетГСМ.НомерСменыДляПутевогоЛиста(Объект.Ссылка, Объект.ТранспортноеСредство, Объект.Дата) + 1;
	
	Объект.ДатаВыездаТС = Объект.Дата;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВодителя()
	Если НЕ ЗначениеЗаполнено(Объект.ТранспортноеСредство)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	ТаблицаВодителей = УчетГСМ.ДанныеНастроекВодителиТС(Объект.Организация, Объект.ТранспортноеСредство);
	Элементы.Водитель.СписокВыбора.Очистить();
	Для каждого ТекСтрока Из ТаблицаВодителей Цикл
		Элементы.Водитель.СписокВыбора.Добавить(ТекСтрока.Водитель);
	КонецЦикла;
КонецПроцедуры		

&НаСервере
Процедура СрокДействияПриИзмененииНаСервере()
	Объект.ДатаВозвращенияТС = КонецДня(Объект.СрокДействия);
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеМаршрутаДвижения(МаршрутДвижения)
