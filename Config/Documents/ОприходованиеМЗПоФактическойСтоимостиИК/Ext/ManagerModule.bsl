// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать105 - Булево - счета 105 не учитываются, при заполнении
//   * Включать108 - Булево - счета 108 учитываются
//   * ИмяРеквизитаКЭК - Строка - Имя реквизита табличной части
//   * ИмяРеквизитаДополнительнаяАналиткаВидСубконто - Строка - Имя реквизита "Вид субконто дополнительного реквизита"
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Дт");
	Результат.Вставить("Включать105", Ложь);
	Результат.Вставить("Включать108", Истина);
	Результат.Вставить("ИмяРеквизитаКЭК", "КЭКУчета");
	Результат.Вставить("ИмяРеквизитаДополнительнаяАналиткаВидСубконто", "ДополнительнаяАналитикаВидСубконто");
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует табличный документ Приходный ордер (ф.0504207)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0504207(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Ссылка КАК Ссылка,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Номер КАК Номер,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Дата КАК Дата,
	|	"""" КАК ВидПервичногоДокумента,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПервичногоДокумента,
	|	"""" КАК НомерПервичногоДокумента,
	|	"""" КАК КодАналитики,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ОприходованиеМЗПоФактическойСтоимостиИК.Организация.НаименованиеПолное = """"
	|			ТОГДА ОприходованиеМЗПоФактическойСтоимостиИК.Организация.Наименование
	|		ИНАЧЕ ОприходованиеМЗПоФактическойСтоимостиИК.Организация.НаименованиеПолное
	|	КОНЕЦ КАК Получатель,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Организация.КодОКПО КАК ОКПОПолучатель,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ОприходованиеМЗПоФактическойСтоимостиИК.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ОприходованиеМЗПоФактическойСтоимостиИК.Подразделение.Наименование
	|		ИНАЧЕ ОприходованиеМЗПоФактическойСтоимостиИК.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК ПодразделениеПолучатель,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ЮридическиеЛица.ПустаяСсылка) КАК ЮридическоеФизическоеЛицо,
	|	"""" КАК Поставщик,
	|	"""" КАК ОКПОПоставщик,
	|	"""" КАК ИННПоставщик,
	|	"""" КАК КПППоставщик,
	|	"""" КАК Договор,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.ЦМО.Сотрудник КАК Принял,
	|	"""" КАК Сдал,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаДокумента,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ОприходованиеМЗПоФактическойСтоимостиИК.ОтветственныйИсполнительБух КАК ОтветственныйИсполнительБух
	|ИЗ
	|	Документ.ОприходованиеМЗПоФактическойСтоимостиИК КАК ОприходованиеМЗПоФактическойСтоимостиИК
	|ГДЕ
	|	ОприходованиеМЗПоФактическойСтоимостиИК.Ссылка В (&МассивОбъектов)
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОприходованиеМЗМатериалыИК.Ссылка КАК Ссылка,
	|	МИНИМУМ(ОприходованиеМЗМатериалыИК.НомерСтроки) КАК НомерСтроки,
	|	ОприходованиеМЗМатериалыИК.Номенклатура КАК Номенклатура,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.НоменклатурныйНомер КАК НомерНоменклатурный,
	|	СУММА(ОприходованиеМЗМатериалыИК.Сумма) КАК Всего,
	|	0 КАК СуммаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	СУММА(ОприходованиеМЗМатериалыИК.Сумма) КАК Сумма,
	|	СУММА(ОприходованиеМЗМатериалыИК.Количество) КАК Количество,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОприходованиеМЗМатериалыИК.СчетУчета КАК СчетДт,
	|	ОприходованиеМЗМатериалыИК.КПСУчета КАК КПСДт,
	|	ОприходованиеМЗМатериалыИК.КПСКредита КАК КПСКт,
	|	ОприходованиеМЗМатериалыИК.СчетКредита КАК СчетКт,
	|	ОприходованиеМЗМатериалыИК.КЭКУчета КАК КЭКДт,
	|	ОприходованиеМЗМатериалыИК.КЭККредита КАК КЭККт,
	|	ОприходованиеМЗМатериалыИК.КФО КАК КФО,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаНаименование,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения.Код КАК ЕдиницаКод
	|ИЗ
	|	Документ.ОприходованиеМЗПоФактическойСтоимостиИК.Материалы КАК ОприходованиеМЗМатериалыИК
	|ГДЕ
	|	ОприходованиеМЗМатериалыИК.Ссылка В (&МассивОбъектов)
	|СГРУППИРОВАТЬ ПО
	|	ОприходованиеМЗМатериалыИК.Ссылка,
	|	ОприходованиеМЗМатериалыИК.Номенклатура,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.Наименование,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.НаименованиеПолное,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.НоменклатурныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка),
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения,
	|	ОприходованиеМЗМатериалыИК.СчетУчета,
	|	ОприходованиеМЗМатериалыИК.КПСУчета,
	|	ОприходованиеМЗМатериалыИК.КПСКредита,
	|	ОприходованиеМЗМатериалыИК.СчетКредита,
	|	ОприходованиеМЗМатериалыИК.КЭКУчета,
	|	ОприходованиеМЗМатериалыИК.КЭККредита,
	|	ОприходованиеМЗМатериалыИК.КФО,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения.Наименование,
	|	ОприходованиеМЗМатериалыИК.Номенклатура.ЕдиницаИзмерения.Код
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат УправлениеПечатьюБГУ.ПечатьПриходногоОрдера_0504207(РезультатЗапроса, ОбъектыПечати, , ИмяМакета);
	
КонецФункции

#КонецОбласти

#КонецЕсли
