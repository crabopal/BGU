	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКПСУчетаВСтрокахДокументаНаСервере(Знач ВыделенныеСтроки = Неопределено)
	
	Если ВыделенныеСтроки = Неопределено Тогда
		Для Каждого Строка Из Объект.Материалы Цикл
			Строка.КПСУчета = Объект.КПСУчета;
		КонецЦикла;
	Иначе
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
			Строка = Объект.Материалы.НайтиПоИдентификатору(Идентификатор);
			Строка.КПСУчета = Объект.КПСУчета;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОснованиюНаСервере()
	
	Если ТипЗнч(Объект.ПартияМПЗ) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Объект.ЦМООтправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПартияМПЗ, "ЦМО");
	КонецЕсли;
	
	Объект.Материалы.Очистить();
	ПараметрыРасчета = УправлениеМатериальнымиЗапасами.ДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии(Объект);
	ПараметрыРасчета.ПолучатьСчетИзНоменклатуры = Ложь;
	ПараметрыРасчета.СчетНоменклатуры = БухгалтерскийУчет.СчетПоКоду("108.56", Объект.Дата, Объект.Организация);
	ТаблицаОстатков = УправлениеМатериальнымиЗапасами.РассчитатьОприходованиеМПЗПоПартии(ПараметрыРасчета);
	
	Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков);
		НоваяСтрока.КПСУчета = Объект.КПСУчета;
		
	КонецЦикла;
	
КонецПроцедуры

