#Область ОбработчикиСобытийТаблицыФормыСоставПакета

&НаКлиенте
Процедура СоставПакетаНачислениеПриИзменении(Элемент)
	ТекДанные = Элементы.СоставПакета.ТекущиеДанные;
	ОбработатьВыборДокумента(ТекДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура СоставПакетаНачислениеОчистка(Элемент, СтандартнаяОбработка)
	ТекСтр = Элементы.СоставПакета.ТекущиеДанные;
	Если ТекСтр<>Неопределено Тогда
		ТекСтр.ВидНачисления = 0;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
   
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
	ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
	ОткрытьФорму("Документ.КвитанцияНаОплатуГосуслуг.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАН(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
	ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
	ОткрытьФорму("Документ.НачислениеОтПодведомственного.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

