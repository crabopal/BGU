#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработатьВыборДокумента(ИдентификаторСтр)
	
	ТекСтр = Объект.СоставПакета.НайтиПоИдентификатору(ИдентификаторСтр);	
	ВидНачисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.Начисление,"ВидКвитанции");
	
	ТекСтр.ВидНачисления = ВидНачисления;
		
КонецПроцедуры

&НаСервере 
Процедура ОбработатьВыборМассиваДокументов(МассивСсылок)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка,
		|	КвитанцияНаОплатуГосуслуг.ВидКвитанции
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.ВидКвитанции
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивСсылок)";
		
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	СтруктураПоиска = Новый Структура;
	Пока Выборка.Следующий() Цикл
		СтруктураПоиска.Вставить("Начисление",Выборка.Ссылка);
		Если Объект.СоставПакета.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
			НоваяСтрокаТЧ = Объект.СоставПакета.Добавить();
			НоваяСтрокаТЧ.Начисление = Выборка.Ссылка;
			НоваяСтрокаТЧ.ВидНачисления = Выборка.ВидКвитанции;			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

