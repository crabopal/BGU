	ТипЦеныДоИзменения = Объект.ТипЦены;
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
		
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		УстановитьДанныеДляПечатиЧековККМ(Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтраницыТЧПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ГруппаСкидкиНаценки" Тогда
		ОбновитьСкидкиНаценкиИИтогиНаСервере();
	КонецЕсли;	
	
	// СтандартныеПодсистемы.Свойства
	Если ЭтотОбъект.ПараметрыСвойств.Свойство(ТекущаяСтраница.Имя)
		И Не ЭтотОбъект.ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
		СвойстваВыполнитьОтложеннуюИнициализацию();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	УстановитьДоступностьДоговора(ЭтаФорма);
	ПерессчитатьВсеТоварыРаботыУслуги();
	
	ЗаполнениеДанныхДляЧекаККМ();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаОплатыПриИзменении(Элемент)
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		Если НЕ ИспользоватьОплатуПлатежнымиКартами Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включите флажок ""Оплата платежными картами (эквайринг)"" для возможности принимать оплату платежными картами.
			|Флажок следует включить на закладке ""Денежные средства"" (раздел ""Администрирование""/""Настройка параметров учета""). '");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли;
		
		Если Объект.ФормаОплаты = 1 И (НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга)) Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнены параметры договора эквайринга для рабочего места.
			|В разделе ""Администрирование"" в ""Настройки параметров учета/Денежные средства/Оплата платежными картами (эквайринг)"" следует открыть настройку  ""Настройки ККТ и эквайринга для рабочих мест"", указать параметры договора эквайринга для рабочего места и сохранить.'");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли;
		Если Объект.ФормаОплаты = 2 И (НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга)) Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнены параметры договора оплаты по QR-коду для рабочего места.
			|В разделе ""Администрирование"" в ""Настройки параметров учета/Денежные средства/Оплата платежными картами (эквайринг)"" следует открыть настройку  ""Настройки ККТ и эквайринга для рабочих мест"", указать параметры договора оплаты по QR-коду для рабочего места и сохранить.'");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли;
	КонецЕсли;	 
	
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		Если СуммаОплатыНаличными > 0 Тогда
			СуммаОплатыПлатежнойКартой = СуммаОплатыНаличными;	
		Конецесли;	
		
		Если Объект.ФормаОплаты = 1 Тогда 
			ПараметрыДоговораЭквайринга = ПараметрыДоговораОплатыПоКарте;
			ЭквайринговыйТерминал 		= ТерминалОплатыПоКарте;
		ИначеЕсли Объект.ФормаОплаты = 2 Тогда 
			ПараметрыДоговораЭквайринга = ПараметрыДоговораОплатыПоQRКоду;
			ЭквайринговыйТерминал 		= ТерминалОплатыПоQRКоду;
		КонецЕсли;	
		ВидПлатежнойКарты = Неопределено;
		
		УстановитьНастройкиОплатыПлатежнойКартой();
		ПересчитатьКомиссию(ЭтаФорма);
		УстановитьДанныеЭквайрингаНаСервере();
	Иначе
		Если СуммаОплатыПлатежнойКартой > 0 Тогда
			СуммаОплатыНаличными = СуммаОплатыПлатежнойКартой;	
		Конецесли;	
		УстановитьНастройкиНаличнойОплаты();
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовФормы();
	УстановитьКартинкиЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура СуммаОплатыНаличнымиПриИзменении(Элемент)
	Объект.Оплата[0].Сумма = СуммаОплатыНаличными;
	РассчитатьИтогиОплаты();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
КонецПроцедуры

&НаКлиенте
Процедура СуммаОплатыПлатежнойКартойПриИзменении(Элемент)
	Объект.Оплата[0].Сумма = СуммаОплатыПлатежнойКартой;
	ПересчитатьКомиссию(ЭтаФорма);
	УстановитьДанныеЭквайрингаНаСервере();
	РассчитатьИтогиОплаты();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
КонецПроцедуры

