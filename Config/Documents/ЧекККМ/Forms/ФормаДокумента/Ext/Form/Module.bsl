&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.ИспользоватьВалютныйУчет);
	
	Форма.НадписьТипЦенНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если СуммаВключаетНДСДоИзменения <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
			РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Сумма");
			РассчитатьИтоги();	
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	Если ТипЦеныДоИзменения <> Объект.ТипЦены Тогда
		
		Если Объект.ТоварыРаботыУслуги.Количество() = 0 ИЛИ Не ЗначениеЗаполнено(Объект.ТипЦены) Тогда
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Изменился тип цены.
							|Пересчитать цены в таблице документа?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Да, пересчитать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Нет, не пересчитывать цены");
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Не изменять тип цены");

		ПоказатьВопрос(Новый ОписаниеОповещения("ТипЦеныПриИзмененииЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Отмена);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);    
	
	Если СтрокаТЧ.КоличествоПервичныхУпаковок <> 0 Тогда 
		ПараметрыРасчета.Вставить("ИмяРеквизитаКоличество", "КоличествоПервичныхУпаковок");
	КонецЕсли;
	
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.СистемаНалогообложенияЧекаККМ = ПодключаемоеОборудованиеБГУ.ВидСистемыНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
		
		Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
			СтруктураРеквизитов = Новый Структура;
			СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ", "");
			СтруктураРеквизитов.Вставить("СуммаВключаетНДС", "");
			СтруктураРеквизитов.Вставить("ТипЦены", "");
			СтруктураРеквизитов.Вставить("Подразделение", "");
			СтруктураРеквизитов.Вставить("ЗаполнятьПокупателяДляРозничныхПродаж", "");
			
			РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, СтруктураРеквизитов);
			
			Объект.СистемаНалогообложенияЧекаККМ = РеквизитыККТ.СистемаНалогообложенияЧекаККМ;
			Объект.Подразделение = РеквизитыККТ.Подразделение;
			Если Параметры.Свойство("Основание") И ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.СчетНаОплату") Тогда 
				Объект.ТипЦены = РеквизитыККТ.ТипЦены;
				Объект.СуммаВключаетНДС = РеквизитыККТ.СуммаВключаетНДС;
			КонецЕсли;
			
			Объект.ЭтоРозничныйПокупатель = НЕ РеквизитыККТ.ЗаполнятьПокупателяДляРозничныхПродаж;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		Объект.КассоваяСмена = РозничныеПродажиБГУ.ТекущаяОткрытаяКассоваяСмена(Объект.Организация, Объект.КассаККМ);	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ПараметрыДоговораПлатежногоАгента) Тогда
		Объект.ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
	КонецЕсли;
	
	ПараметрыДоговораОплатыПоQRКоду = НастройкиОборудования.ПараметрыДоговораОплатыПоQRКоду;
	ПараметрыДоговораОплатыПоКарте = НастройкиОборудования.ПараметрыДоговораЭквайринга;
	Если НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Если Объект.ФормаОплаты = 2 Тогда 
			ПараметрыДоговораЭквайринга = ПараметрыДоговораОплатыПоQRКоду;
		Иначе 	
			ПараметрыДоговораЭквайринга = ПараметрыДоговораОплатыПоКарте;
		КонецЕсли;	
	КонецЕсли;
	
	Если ПараметрыДоговораОплатыПоQRКоду.Терминалы.Количество() > 0 Тогда 
		ТерминалОплатыПоQRКоду = ПараметрыДоговораОплатыПоQRКоду.Терминалы[0].ЭквайринговыйТерминал;
	Иначе	
		ТерминалОплатыПоQRКоду = Справочники.ЭквайринговыеТерминалы.ПустаяСсылка();
	КонецЕсли;	
	ТерминалОплатыПоКарте = НастройкиОборудования.ЭквайринговыйТерминал;
	Если НЕ ЗначениеЗаполнено(ЭквайринговыйТерминал) Тогда
		Если Объект.ФормаОплаты = 2 Тогда 
			ЭквайринговыйТерминал =  ТерминалОплатыПоQRКоду;
		Иначе	
			ЭквайринговыйТерминал = ТерминалОплатыПоКарте;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Если Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
			ИспользоватьПодключаемоеОборудование = Ложь;
		Иначе
			ИспользоватьПодключаемоеОборудование = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;	
	КонецЕсли;
	
	Если Объект.ДокументыОснования.Количество() > 0 Тогда
		Для каждого ТекДокументОснование Из Объект.ДокументыОснования Цикл
			ТекДокументОснование.СуммаДокумента = СуммаДокументаОснования(ТекДокументОснование.ДокументОснованиеЧекаККМ); 
		КонецЦикла;	
		
		Объект.ЭтоРозничныйПокупатель = Ложь;
		Объект.ОплатаПоДокументамОснованиям = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура.Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Функция ПолучитьДанныеНоменклатуры(НоменклатураСсылка) 
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка.Номенклатура, "СтавкаНДС");
	СтруктураДанных.Вставить("Количество", НоменклатураСсылка.Количество);
	
	Возврат СтруктураДанных;
КонецФункции

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ", "");
		СтруктураРеквизитов.Вставить("СуммаВключаетНДС", "");
		СтруктураРеквизитов.Вставить("ТипЦены", "");
		СтруктураРеквизитов.Вставить("Подразделение", "");
		
		РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, СтруктураРеквизитов);
		
		Объект.ТипЦены = РеквизитыККТ.ТипЦены;
		Объект.СуммаВключаетНДС = РеквизитыККТ.СуммаВключаетНДС;
		Объект.СистемаНалогообложенияЧекаККМ = РеквизитыККТ.СистемаНалогообложенияЧекаККМ;
		Объект.Подразделение = РеквизитыККТ.Подразделение;
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	УстановитьВидимостьУсловноеОформлениеМаркировка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭлектроннойПочты = РезультатОткрытияФормы.Email;
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонSMS = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			ТелефонSMS = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, ТелефонSMS, ТелефонСтрокой);
			АбонентскийНомерТелефона = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭлектроннойПочты = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ТелефонSMS = 0;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РассчитатьСкидку(КлючСвязи, Номенклатура, ЦенаБезСкидок)
	
	Покупатель = Объект.Контрагент;
	ПокупательНеопределен = Объект.ЭтоРозничныйПокупатель;
	
	ТЗ_ДействующиеСкидкиНаценки = ТаблицаДействующихСкидокНаценок(Объект.Организация);
	
	Номенклатура = Номенклатура;
	ЦенаНоменклатуры = ЦенаБезСкидок;
	
	ОбщаяСуммаСкидки = 0;
	
	Для каждого ТекСкидкаНаценка Из ТЗ_ДействующиеСкидкиНаценки Цикл
		СкидкаНаценка = ТекСкидкаНаценка.СкидкаНаценка;
		ДобавитьСкидкуНаценку = Ложь;
		
		Если СкидкаНаценка.Получатели.Количество()>0 Тогда
			Если ПокупательНеопределен Тогда
				Продолжить;
			Иначе
				ПараметрыОтбора = Новый Структура("Получатель", Покупатель); 	
				МассивПолучателей = СкидкаНаценка.Получатели.НайтиСтроки(ПараметрыОтбора);
				Если МассивПолучателей.Количество()>0 Тогда
					ДобавитьСкидкуНаценку = Истина;
				Иначе
					ДобавитьСкидкуНаценку = Ложь;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		Если ДобавитьСкидкуНаценку Тогда
			ПараметрыОтбора = Новый Структура("КлючСвязи, СкидкаНаценка", КлючСвязи, СкидкаНаценка);
			НайденныеСтроки = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = Объект.СкидкиНаценки.Добавить();
				НоваяСтрока.КлючСвязи = КлючСвязи;
				НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
				СуммаСкидки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
				НоваяСтрока.Сумма = СуммаСкидки;
				ОбщаяСуммаСкидки = ОбщаяСуммаСкидки + СуммаСкидки
			Иначе
				Для каждого ТекСкидка Из НайденныеСтроки Цикл
					СуммаСкидки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
					ТекСкидка.Сумма = СуммаСкидки;
					ОбщаяСуммаСкидки = ОбщаяСуммаСкидки + СуммаСкидки
				КонецЦикла;	
			КонецЕсли;	
				
		КонецЕсли;
		
	КонецЦикла;
	Результат = ОбщаяСуммаСкидки;
	ОбновитьВсеСкидки();
	
	Возврат Результат;		
КонецФункции	

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыСкидокПриАктивизацииНоменклатуры()
	Элемент = Элементы.ТоварыРаботыУслуги;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда 
		ОтборДляСкидок(Элемент.ТекущиеДанные.КлючСвязи);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляСкидок(КлючСвязи)
	
	Если Элементы.СкидкиНаценкиНоменклатуры.ОтборСтрок = Неопределено ИЛИ НЕ (Элементы.СкидкиНаценкиНоменклатуры.ОтборСтрок.Свойство("КлючСвязи") И Элементы.СкидкиНаценкиНоменклатуры.ОтборСтрок.КлючСвязи = КлючСвязи) Тогда
		Элементы.СкидкиНаценкиНоменклатуры.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСвязи",КлючСвязи));
	КонецЕсли;
	
КонецПРоцедуры	

&НаСервере
Функция ОбщаяСкидкаПоНоменклатуре(КлючСвязи)
	ПараметрыОтбора = Новый Структура("КлючСвязи", КлючСвязи); 	
	МассивОтбора = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Результат = 0;
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		Результат = Результат + СтрокаОтбора.Сумма;
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры)
	Возврат РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
КонецФункции

&НаСервере
Процедура ОбновитьВсеСкидки()

	ДанныеВсеСкидкиНаценки = ДанныеВсеСкидкиНаценки();
	
	ЭтаФорма.ВсеСкидкиНаценки.Загрузить(ДанныеВсеСкидкиНаценки);	
	
КонецПроцедуры

&НаСервере
Функция ДанныеВсеСкидкиНаценки()
	Скидки = Объект.СкидкиНаценки.Выгрузить();	
	Товары = Объект.ТоварыРаботыУслуги.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.КлючСвязи,
	               |	ТоварыРаботыУслуги.НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	ТоварыРаботыУслуги.Количество
	               |ПОМЕСТИТЬ ТоварыРаботыУслуги
	               |ИЗ
	               |	&ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СкидкиНаценки.КлючСвязи,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма
	               |ПОМЕСТИТЬ СкидкиНаценки
	               |ИЗ
	               |	&СкидкиНаценки КАК СкидкиНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма,
	               |	ТоварыРаботыУслуги.Количество,
	               |	ТоварыРаботыУслуги.Количество * СкидкиНаценки.Сумма КАК Всего
	               |ПОМЕСТИТЬ ИтогиСкидокНаценок
	               |ИЗ
	               |	ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СкидкиНаценки КАК СкидкиНаценки
	               |		ПО ТоварыРаботыУслуги.КлючСвязи = СкидкиНаценки.КлючСвязи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогиСкидокНаценок.НомерСтроки,
	               |	ИтогиСкидокНаценок.Номенклатура,
	               |	ИтогиСкидокНаценок.СкидкаНаценка,
	               |	ИтогиСкидокНаценок.Сумма,
	               |	ИтогиСкидокНаценок.Количество,
	               |	ИтогиСкидокНаценок.Всего
	               |ИЗ
	               |	ИтогиСкидокНаценок КАК ИтогиСкидокНаценок
	               |ГДЕ
	               |	ИтогиСкидокНаценок.Всего <> 0";
				   
	Запрос.УстановитьПараметр("ТоварыРаботыУслуги", Товары);
	Запрос.УстановитьПараметр("СкидкиНаценки", Скидки);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ТаблицаДействующихСкидокНаценок(Организация)
	ДатаСведений = Объект.Дата;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СкидкиНаценки.Ссылка КАК СкидкаНаценка
	               |ИЗ
	               |	Справочник.СкидкиНаценки КАК СкидкиНаценки
	               |ГДЕ
	               |	СкидкиНаценки.ДатаНачалаДействия <= &ДатаСведений
	               |	И (СкидкиНаценки.ДатаОкончанияДействия > &ДатаСведений ИЛИ СкидкиНаценки.ДатаОкончанияДействия = &ПустаяДата)
	               |	И СкидкиНаценки.СтатусДействия = &СтатусДействия
	               |	И СкидкиНаценки.Организация = &Организация
	               |	И СкидкиНаценки.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СтатусДействия", Перечисления.СтатусыДействияСкидок.Действует);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяДата", ДАТА(1,1,1));
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура РассчитатьИтоги()
	ИтогВсего = Объект.ТоварыРаботыУслуги.Итог("Всего");
	ИтогНДС   = Объект.ТоварыРаботыУслуги.Итог("СуммаНДС");
	
	Скидки = Объект.СкидкиНаценки.Выгрузить();	
	Товары = Объект.ТоварыРаботыУслуги.Выгрузить();
	
	ПризнакиПредметаРасчетаТовары = РозничныеПродажиБГУ.ПризнакиПредметаРасчетаТовары();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.КлючСвязи,
	               |	ТоварыРаботыУслуги.НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	ТоварыРаботыУслуги.СуммаНДС,
	               |	ТоварыРаботыУслуги.Всего
	               |ПОМЕСТИТЬ ТоварыРаботыУслуги
	               |ИЗ
	               |	&ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	ВЫРАЗИТЬ(ТоварыРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК НоменклатураПрейскуранта,
	               |	ТоварыРаботыУслуги.СуммаНДС,
	               |	ТоварыРаботыУслуги.Всего
	               |ПОМЕСТИТЬ ИтоговаяТаблица
	               |ИЗ
	               |	ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтоговаяТаблица.НомерСтроки,
	               |	ИтоговаяТаблица.Номенклатура,
	               |	ИтоговаяТаблица.НоменклатураПрейскуранта,
	               |	ВЫРАЗИТЬ(ИтоговаяТаблица.НоменклатураПрейскуранта КАК Справочник.Номенклатура).ТипНоменклатуры КАК ПризнакПредметаРасчета,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ИтоговаяТаблица.НоменклатураПрейскуранта КАК Справочник.Номенклатура).ТипНоменклатуры В (&ПризнакиПредметаРасчетаТовары)
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК КодТипаНоменклатуры,
	               |	ИтоговаяТаблица.СуммаНДС,
	               |	ИтоговаяТаблица.Всего
	               |ПОМЕСТИТЬ ИтогиПоТипам
	               |ИЗ
	               |	ИтоговаяТаблица КАК ИтоговаяТаблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогиПоТипам.КодТипаНоменклатуры,
	               |	СУММА(ИтогиПоТипам.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(ИтогиПоТипам.Всего) КАК Всего
	               |ИЗ
	               |	ИтогиПоТипам КАК ИтогиПоТипам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогиПоТипам.КодТипаНоменклатуры";
				   
	Запрос.УстановитьПараметр("ТоварыРаботыУслуги", Товары);
	Запрос.УстановитьПараметр("ПризнакиПредметаРасчетаТовары", ПризнакиПредметаРасчетаТовары);
	Результат = Запрос.Выполнить().Выгрузить();
	
	УслугиИтогВсего = 0;
	УслугиИтогСуммаНДС = 0;
	ТоварыИтогВсего = 0;
	ТоварыИтогСуммаНДС = 0;
	
	Для каждого ТекСтрока Из Результат Цикл
		Если ТекСтрока.КодТипаНоменклатуры = 1 Тогда
			ТоварыИтогВсего = ТоварыИтогВсего + ТекСтрока.Всего;
			ТоварыИтогСуммаНДС = ТоварыИтогСуммаНДС + ТекСтрока.СуммаНДС;
		ИначеЕсли ТекСтрока.КодТипаНоменклатуры = 2 Тогда
			УслугиИтогВсего = УслугиИтогВсего + ТекСтрока.Всего;
			УслугиИтогСуммаНДС = УслугиИтогСуммаНДС + ТекСтрока.СуммаНДС;
		КонецЕсли;	
	КонецЦикла;	
	
	//скидки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.КлючСвязи,
	               |	ТоварыРаботыУслуги.НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	ТоварыРаботыУслуги.Количество
	               |ПОМЕСТИТЬ ТоварыРаботыУслуги
	               |ИЗ
	               |	&ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СкидкиНаценки.КлючСвязи,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма
	               |ПОМЕСТИТЬ СкидкиНаценки
	               |ИЗ
	               |	&СкидкиНаценки КАК СкидкиНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.Номенклатура,
	               |	ВЫРАЗИТЬ(ТоварыРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК НоменклатураПрейскуранта,
	               |	СкидкиНаценки.СкидкаНаценка,
	               |	СкидкиНаценки.Сумма,
	               |	ТоварыРаботыУслуги.Количество,
	               |	ТоварыРаботыУслуги.Количество * СкидкиНаценки.Сумма КАК Всего
	               |ПОМЕСТИТЬ НоменклатураИСкидки
	               |ИЗ
	               |	ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СкидкиНаценки КАК СкидкиНаценки
	               |		ПО ТоварыРаботыУслуги.КлючСвязи = СкидкиНаценки.КлючСвязи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураИСкидки.Номенклатура,
	               |	НоменклатураИСкидки.НоменклатураПрейскуранта,
	               |	НоменклатураИСкидки.Всего КАК СуммаСкидки
	               |ПОМЕСТИТЬ ИтоговаяТаблица
	               |ИЗ
	               |	НоменклатураИСкидки КАК НоменклатураИСкидки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтоговаяТаблица.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ИтоговаяТаблица.НоменклатураПрейскуранта КАК Справочник.Номенклатура).ТипНоменклатуры В (&ПризнакиПредметаРасчетаТовары)
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК КодТипаНоменклатуры,
	               |	ИтоговаяТаблица.СуммаСкидки
	               |ПОМЕСТИТЬ ИтогиПоТипам
	               |ИЗ
	               |	ИтоговаяТаблица КАК ИтоговаяТаблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогиПоТипам.КодТипаНоменклатуры,
	               |	СУММА(ИтогиПоТипам.СуммаСкидки) КАК СуммаСкидки
	               |ИЗ
	               |	ИтогиПоТипам КАК ИтогиПоТипам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогиПоТипам.КодТипаНоменклатуры";
				   
	Запрос.УстановитьПараметр("ТоварыРаботыУслуги", Товары);
	Запрос.УстановитьПараметр("СкидкиНаценки", Скидки);
	Запрос.УстановитьПараметр("ПризнакиПредметаРасчетаТовары", ПризнакиПредметаРасчетаТовары);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Результат.Свернуть("КодТипаНоменклатуры", "СуммаСкидки");
	
	УслугиИтогСкидка = 0;
	ТоварыИтогСкидка = 0;
	
	Для каждого ТекСтрока Из Результат Цикл
		Если ТекСтрока.КодТипаНоменклатуры = 1 Тогда
			ТоварыИтогСкидка = ТоварыИтогСкидка + ТекСтрока.СуммаСкидки;
		ИначеЕсли ТекСтрока.КодТипаНоменклатуры = 2 Тогда
			УслугиИтогСкидка = УслугиИтогСкидка + ТекСтрока.СуммаСкидки;
		КонецЕсли;	
	КонецЦикла;
	
	ИтогСкидка = УслугиИтогСкидка + ТоварыИтогСкидка;
	
	СуммаКОплате = УслугиИтогВсего;
	
	ИтогКоличествоВсего = Товары.Итог("Количество");
	
	ТоварыИтогВсегоБезСкидок = ТоварыИтогВсего + ТоварыИтогСкидка;
	УслугиИтогВсегоБезСкидок = УслугиИтогВсего + УслугиИтогСкидка;
	ИтогВсегоБезСкидок = ТоварыИтогВсегоБезСкидок + УслугиИтогВсегоБезСкидок;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогиОплаты()

	ИтогОплатаВсего = Объект.Оплата.Итог("Сумма");
	ИтогОплатаНаличными = 0;
	ИтогОплатаЭлектронными = 0;
	
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		ИтогОплатаЭлектронными = Объект.Оплата[0].Сумма;
	КонецЕсли;	
	
	ИтогОплатаНаличными = ИтогОплатаВсего - ИтогОплатаЭлектронными; 
	
	Объект.СуммаДокумента = ИтогОплатаВсего;
	
	СуммаОплачено = ИтогОплатаВсего;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммыДокументовОснованийОплаты()
	Для каждого ТекСтрока Из Объект.ДокументыОснования Цикл
		ТекСтрока.СуммаДокумента = СуммаДокументаОснования(ТекСтрока.ДокументОснованиеЧекаККМ);
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма, НомерЧекаККМ = 0)
	
	ТекстЗаголовкаДанныхЧека = "";
	
	Объект = Форма.Объект;
	
	ТекстЗаголовкаДанныхОплатыИЧека = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 %2'"),
			Формат(Форма.ИтогОплатаВсего, "ЧЦ=15; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));
			
	НомерЧекаККМ = ?(НомерЧекаККМ<>0, НомерЧекаККМ, Объект.НомерЧекаККМ);
			
	Если ЗначениеЗаполнено(НомерЧекаККМ) Тогда
		ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
		
		Если ИспользуетсяККТСПередачейДанных Тогда
			ТекстНомераЧека = НСтр("ru='ФД № '")+Формат(НомерЧекаККМ,"ЧГ=");
		Иначе	
			ТекстНомераЧека = НСтр("ru='чек № '")+Формат(НомерЧекаККМ,"ЧГ=");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Форма.ЗаключительныйЧекИсправительный) Тогда
			ТекстНомераЧека = ТекстНомераЧека + " отменен";
		КонецЕсли;	
		
		Если НомерЧекаККМ<>0 Тогда
			ТекстЗаголовкаДанныхЧека = ТекстНомераЧека;
		КонецЕсли;	
		
		ТекстЗаголовкаДанныхОплатыИЧека = ТекстЗаголовкаДанныхОплатыИЧека + ", " + ТекстЗаголовкаДанныхЧека;
	
	КонецЕсли;
	
	Форма.ДанныеЗаголовкаОплата = ТекстЗаголовкаДанныхОплатыИЧека;
КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ДанныеЗаголовкаТоварыРаботыУслуги = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 ед. на %2 %3'"),
			Строка(Форма.ИтогКоличествоВсего),
			Формат(Форма.ИтогВсего, "ЧЦ=15; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));

КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДокументыОснования(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ДанныеЗаголовкаДокументыОснования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 %2'"),
			Формат(Объект.ДокументыОснования.Итог("СуммаДокумента"), "ЧЦ=15; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопокПроведенияКлиент()
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	ЗаполнятьКонтрагентаИДоговор = ЗаполнятьКонтрагентаИДоговор();
	
	ПоказыватьОплату = Истина;
	Если Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты Тогда
		ПоказыватьОплату = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Контрагент", "Видимость", ЗаполнятьКонтрагентаИДоговор);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Договор", "Видимость", ЗаполнятьКонтрагентаИДоговор);
	
	ВидимостьКомандККТ = ПодключаемоеОборудованиеБГУ.ВидимостьКомандККТПоТипуКассыККМ(Объект.КассаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаEmail", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаSMS", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтказКлиентаОтСохраненияТелефонаEmail", 		"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДанныеSMSИлиEmail", 									"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОчиститьEmailИSMS",								"Видимость", ВидимостьКомандККТ);
	
	ВидимостьРеквизитовЭквайринга = (Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2);
	
	Если НЕ ИспользоватьОплатуПлатежнымиКартами Тогда
		ВидимостьРеквизитовЭквайринга = Ложь;
	КонецЕсли;	
	
	ОплатаВыполнена = Объект.Оплата[0].ДанныеПереданыВБанк;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаОплатаНаличными", "Видимость", НЕ ВидимостьРеквизитовЭквайринга И ПоказыватьОплату);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ГруппаОплатаПлатежнойКартой", "Видимость", ВидимостьРеквизитовЭквайринга И ПоказыватьОплату);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ФормаОплатитьКартой", "Видимость", ВидимостьРеквизитовЭквайринга И НЕ ОплатаВыполнена И ПоказыватьОплату);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницыСтатусОперации", "Видимость", ВидимостьРеквизитовЭквайринга И ПоказыватьОплату И (Объект.ФормаОплаты <> 2 ));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаФормаОплаты", "Видимость", ПоказыватьОплату);
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	ВидимостьКнопкиПечатьЧекаККМ = Истина;
	ЕстьЗаключительныйЧекИсправительный = Ложь;
	
	Если СтатусЧекаККМПробит Тогда
		ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВидимостьКнопкиПечатьЧекаККМ = Истина;
			ЕстьЗаключительныйЧекИсправительный = Истина;
		Иначе
			ВидимостьКнопкиПечатьЧекаККМ = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
	
	Если ВидимостьРеквизитовЭквайринга Тогда	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ФормаНапечататьЧек", "Видимость", ВидимостьКнопкиПечатьЧекаККМ И ОплатаВыполнена);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 
			"Видимость", ВидимостьКнопкиПечатьЧекаККМ);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДокументыОснованияОплаты", 
		"Видимость", Объект.ОплатаПоДокументамОснованиям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТоварыРаботыУслугиЗаполнитьТоварыРаботыУслугиПоДокументамОснованиям", 
		"Видимость", Объект.ОплатаПоДокументамОснованиям);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТоварыРаботыУслугиГруппаУправлениеСкидками", 
		"Видимость", НЕ Объект.ОплатаПоДокументамОснованиям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСкидкиНаценки", 
		"Видимость", НЕ Объект.ОплатаПоДокументамОснованиям);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОплатаПоДокументамОснованиям", 
		"Видимость", НЕ Объект.ЭтоРозничныйПокупатель);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДополнительныеНастройки", 
		"Видимость", ЕстьПравоНастройкиРозничныхПродаж);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НомерЧекаККМ", 
		"Видимость", Объект.ВводДанныхЧекаВручную);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтатусЧекаККМ", 
		"Видимость", Объект.ВводДанныхЧекаВручную);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОплата", 
		"ТолькоПросмотр", НЕ ВидимостьКнопкиПечатьЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаполнитьСуммуОплатыНаличнымиСтоимостьюТоваровРаботУслуг", 
		"Доступность", ВидимостьКнопкиПечатьЧекаККМ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаполнитьСуммуОплатыПлатежнойКартойСтоимостьюТоваровРаботУслуг", 
		"Доступность", ВидимостьКнопкиПечатьЧекаККМ); 
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторКорзины) Тогда 
		Если Объект.ФормаОплаты = 0 Тогда 
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиНаличные", 
				"Видимость", Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиКарта", 
				"Видимость", Ложь);	
		Иначе 
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиНаличные", 
				"Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиКарта", 
				"Видимость", Истина);
		КонецЕсли;
	Иначе 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиНаличные", 
			"Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаОплатыСертификатамиКарта", 
			"Видимость", Ложь);
	КонецЕсли;
		
КонецПроцедуры // УстановитьВидимостьЭлементовФормы()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭквайринга(Форма, НомерКассовогоЧека)
	
	Объект = Форма.Объект;
	ИспользоватьОплатуПлатежнымиКартами = Форма.ИспользоватьОплатуПлатежнымиКартами;
	ВидимостьРеквизитовЭквайринга = (Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2);
	
	Если НЕ ИспользоватьОплатуПлатежнымиКартами Тогда
		ВидимостьРеквизитовЭквайринга = Ложь;
	КонецЕсли;	
	
	ОплатаВыполнена = Объект.Оплата[0].ДанныеПереданыВБанк;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаОплатитьКартой", "Видимость", (НЕ ОплатаВыполнена) И ВидимостьРеквизитовЭквайринга);
	
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	Если ВидимостьРеквизитовЭквайринга Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧек", "Видимость", НЕ СтатусЧекаККМПробит И ОплатаВыполнена);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧек", "Видимость", НЕ СтатусЧекаККМПробит);
	КонецЕсли;	
		
	Если ОплатаВыполнена Тогда
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаОперацияПроизведена;
	Иначе
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаОперацияНеПроизведена;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкиЭлементовФормы()
	
	Если Объект.ФормаОплаты = 1 Тогда
		Команда = Команды.Найти("ОплатитьКартой");
		Элементы.ГруппаОплата.Картинка 	= БиблиотекаКартинок.ПлатежнаяКарта;
		Команда.Картинка 				= БиблиотекаКартинок.ПодключаемоеОборудованиеЭквайринговыйТерминал32;
		Команда.Заголовок				= "Оплатить картой";
		Команда.Подсказка				= "Оплатить картой";
	ИначеЕсли Объект.ФормаОплаты = 2 Тогда	
		Команда = Команды.Найти("ОплатитьКартой");
		Элементы.ГруппаОплата.Картинка 	= БиблиотекаКартинок.QRКодОплата;
		Команда.Картинка 				= БиблиотекаКартинок.QRКодОплата;
		Команда.Заголовок				= "Оплатить по QR-коду";
		Команда.Подсказка				= "Оплатить по QR-коду";
	Иначе	
		Элементы.ГруппаОплата.Картинка = БиблиотекаКартинок.Наличные;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьОбщуюСкидкуНаКлиенте()
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораСкидокНаценок", ЭтотОбъект);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ОткрытьФорму("Справочник.СкидкиНаценки.ФормаВыбора", ,,,,, ОбработчикОповещения, Режим); 
КонецПроцедуры
	
&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценок(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДобавитьОбщуюСкидкуНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбщуюСкидкуНаСервере(СкидкаНаценка)
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
		НоваяСтрока = Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.КлючСвязи = ТекСтрока.КлючСвязи;
		НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
		
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		
		НоваяСтрока.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
			
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
			
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;	
	
	ОбновитьСкидкиНаценкиИИтогиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОбщуюСкидкуНаКлиенте()
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораСкидокНаценокОтмена", ЭтотОбъект);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ОткрытьФорму("Справочник.СкидкиНаценки.ФормаВыбора", ,,,,, ОбработчикОповещения, Режим); 
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокОтмена(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ОтменитьОбщуюСкидкуНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьОбщуюСкидкуНаСервере(СкидкаНаценка)
	ПараметрыОтбора = Новый Структура("СкидкаНаценка", СкидкаНаценка); 	
	МассивКУдалению = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СкидкиНаценки.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
			
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;
	
	ОбновитьСкидкиНаценкиИИтогиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиНоменклатурыПослеУдаления(Элемент)
	ТекСтрока = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
	ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;

	РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	РассчитатьИтоги();	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкидкиНаценкиИИтогиНаСервере()
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;
	КонецЦикла;
	
	ОбновитьВсеСкидки();
	РассчитатьИтоги();
	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ДействияСКонтактнымиДаннымиДляЧекаККМ()
	
	ЗаписатьДополнительныеДанныеЧековККМ();
	
	Если НЕ ОтказПокупателяОтСохраненияДанных Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьТелефонКонтрагента(Объект.Контрагент, АбонентскийНомерТелефона);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьEmailКонтрагента(Объект.Контрагент, АдресЭлектроннойПочты);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)
	Объект = Форма.Объект;
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиНаличнойОплаты()
	ТекущаяОплата = Объект.Оплата[0];
	
	ТекущаяОплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
	
	ТекущаяОплата.ЭквайринговыйТерминал = "";
	ТекущаяОплата.ПараметрыДоговораЭквайринга = "";
	ТекущаяОплата.ВидПлатежнойКарты = "";
	ТекущаяОплата.ПроцентКомиссии = 0;
	ТекущаяОплата.СуммаКомиссии = 0;
	ТекущаяОплата.СсылочныйНомер = "";
	ТекущаяОплата.НомерЧекаЭТ = "";
	ТекущаяОплата.НомерПлатежнойКарты = "";
	ТекущаяОплата.ДанныеПереданыВБанк = Ложь;
	
	ТекущаяОплата.КлючСвязиОплаты = 1;
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиОплатыПлатежнойКартой()
	ТекущаяОплата = Объект.Оплата[0];
	
	ТекущаяОплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		
	ТекущаяОплата.ЭквайринговыйТерминал = ЭквайринговыйТерминал;
	ТекущаяОплата.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
	ТекущаяОплата.ПроцентКомиссии = 0;
	ТекущаяОплата.СуммаКомиссии = 0;
	ТекущаяОплата.СсылочныйНомер = "";
	ТекущаяОплата.НомерЧекаЭТ = "";
	ТекущаяОплата.НомерПлатежнойКарты = "";
	ТекущаяОплата.ДанныеПереданыВБанк = Ложь;
	
	ТекущаяОплата.КлючСвязиОплаты = 1;
	
	ЗаполнитьСписокТерминаловПлатежныхКарт();
		
	ДанныеОВидеКартыИПроценте = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(
		ПараметрыДоговораЭквайринга, ВидПлатежнойКарты);
	Если ДанныеОВидеКартыИПроценте = Неопределено Тогда
		ТекстСообщения = "ru='Данные о виде платежной карты не определены! Следует указать вид платежной карты 
		|или определить основной вид платежной карты для параметров договора эквайринга для заполнения.'";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(ТекстСообщения));
		РезультатПроверки = Ложь;
		
		Возврат;
	КонецЕсли;		
		
	ВидПлатежнойКарты = ДанныеОВидеКартыИПроценте.ВидПлатежнойКарты;
	
	ТекущаяОплата.ВидПлатежнойКарты = ВидПлатежнойКарты;
	ПроцентКомиссииБанка = ДанныеОВидеКартыИПроценте.ПроцентТорговойУступки;	
	ТекущаяОплата.ПроцентКомиссии = ПроцентКомиссииБанка; 
	
	НДССКомиссииСверху = ДанныеОВидеКартыИПроценте.НДССКомиссииСверху;
	СтавкаНДССКомиссии = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ДанныеОВидеКартыИПроценте.СтавкаНДССКомисии, Не НДССКомиссииСверху);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеЭквайрингаНаСервере()
	
	ТекущаяОплата = Объект.Оплата[0];
	
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		ТекущаяОплата.Сумма = СуммаОплатыПлатежнойКартой;
		ТекущаяОплата.ЭквайринговыйТерминал = ЭквайринговыйТерминал;
		ТекущаяОплата.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
		ТекущаяОплата.ПроцентКомиссии = ПроцентКомиссииБанка;
		ТекущаяОплата.СуммаКомиссии = СуммаКомиссииБанка;
		ТекущаяОплата.ВидПлатежнойКарты = ВидПлатежнойКарты;
	Иначе
		ТекущаяОплата.Сумма = СуммаОплатыНаличными;
		ТекущаяОплата.ЭквайринговыйТерминал = "";
		ТекущаяОплата.ПараметрыДоговораЭквайринга = "";
		ТекущаяОплата.ПроцентКомиссии = 0;
		ТекущаяОплата.СуммаКомиссии = 0;
		ТекущаяОплата.ВидПлатежнойКарты = "";
	КонецЕсли;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьКомиссию(Форма)
	
	Объект = Форма.Объект;
	
	Форма.СуммаКомиссииБанка = Форма.СуммаОплатыПлатежнойКартой * Форма.ПроцентКомиссииБанка / 100;
	
	Если Форма.НДССКомиссииСверху Тогда 
		Форма.СуммаКомиссииБанка = Форма.СуммаКомиссииБанка + (Форма.СуммаКомиссииБанка * Форма.СтавкаНДССКомиссии)	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	ИспользоватьОплатуПлатежнымиКартами = ПолучитьФункциональнуюОпцию("ИспользоватьОплатуПлатежнымиКартами");
	
КонецПроцедуры

&НаКлиенте
Процедура ЭквайринговыйТерминалПриИзменении(Элемент)
	
	ВидПлатежнойКарты = Неопределено;
	ЗаполнитьСписокТерминаловПлатежныхКарт();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыДоговораЭквайрингаПриИзменении(Элемент)
	
	УстановитьНастройкиОплатыПлатежнойКартой();
	
КонецПроцедуры


#Область ОплатаКартой

&НаКлиенте
Процедура ОплатаКартой()
	Перем ПараметрыЭТ;
	
	Если НЕ ПроверкаВозможностиРаботыСКартой(ПараметрыЭТ) Тогда
		Возврат;
	КонецЕсли;
	
	// Предварительно авторизуем операцию
	ПараметрыФормы = Новый Структура("Сумма, ПределСуммы", СуммаОплатыПлатежнойКартой, СуммаОплатыПлатежнойКартой);
	ПараметрыФормы.Вставить("ЗапретРедактированияСуммы", Истина);
	Если ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда
		ПараметрыФормы.Вставить("ПоказыватьНомерКарты", НЕ ПараметрыЭТ.НеВводитьНомерПлатежнойКарты);
	КонецЕсли;
	
	ПараметрДействия = Новый Структура;
	ПараметрДействия.Вставить("ОписаниеОшибкиФР", "");
	ПараметрДействия.Вставить("ПараметрыЭТ", ПараметрыЭТ);
	ПараметрДействия.Вставить("СуммаОперации", 0);
	ПараметрДействия.Вставить("НомерКарты", "");
	
	ПараметрДействия.Вставить("НомерСсылкиОперации", "");
	ПараметрДействия.Вставить("НомерЧекаЭТ", 0);
	ПараметрДействия.Вставить("НомерЧекаККМ", Объект.Номер);
	ПараметрДействия.Вставить("СтрокаСлипЧека", "");
	
	ПараметрДействия.Вставить("ТипТранзакции", "AuthorizeSales");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрДействия", ПараметрДействия);
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуАвторизацииЭТ", ЭтотОбъект, ДополнительныеПараметры);
	Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	ОткрытьФорму("Справочник.ПодключаемоеОборудование.Форма.ФормаАвторизацииЭТ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим); 
КонецПроцедуры

&НаКлиенте
Функция ОплатаВыполнена()
	Возврат ?(Объект.Оплата.Количество()>0, Объект.Оплата[0].ДанныеПереданыВБанк, Ложь); 
КонецФункции	

&НаКлиенте
Функция ПроверкаВозможностиРаботыСКартой(ПараметрыЭТ)
	Перем Отказ;
	Перем ИспользоватьБезПодключенияОборудованияФР;
	
	Результат = Ложь;
	Отказ     = Ложь;
	ПараметрыЭТ = Новый Структура("УстройствоПодключено, УстройствоПечатиПодключено", Ложь, Ложь);
	
	РезультатПроверки = Истина;
	
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		Если ОплатаВыполнена() Тогда
			ТекстСообщения = "ru='Для данного документа уже выполнена оплата платежной картой.'";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(ТекстСообщения));
			РезультатПроверки = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ необходимо записать.'"));
		РезультатПроверки = Ложь;
	КонецЕсли; 
	
	Если НЕ РезультатПроверки Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ПолучитьНеобходимыеДанныеДляРаботыСКартой(ПараметрыЭТ, Отказ, ИспользоватьБезПодключенияОборудованияФР);
	
	Если Отказ  Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользоватьБезПодключенияОборудованияФР Тогда
		ПараметрыЭТ.УстройствоПодключено = Ложь;
	Иначе	
		ПараметрыЭТ.УстройствоПодключено = Истина;
	КонецЕсли;
	
	Если ПараметрыЭТ.ИспользоватьУстройствоПечатиСлипЧека Тогда
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Истина);
		ПараметрыЭТ.Вставить("РезультатФР", Истина);
	Иначе
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Ложь);
		ПараметрыЭТ.Вставить("РезультатФР", Ложь);
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПолучитьНеобходимыеДанныеДляРаботыСКартой(ПараметрыЭТ, Отказ, ИспользоватьБезПодключенияОборудованияФР = Ложь)
	
	ПараметрыЭТ = ЭквайрингВызовСервера.ПолучитьПараметрыЭТ(Объект.Оплата[0].ЭквайринговыйТерминал);
	ПараметрыЭТ.Вставить("УстройствоПодключено", Ложь);
	ПараметрыЭТ.Вставить("УстройствоПечатиПодключено", Ложь);
	
	ИспользоватьБезПодключенияОборудованияФР = РаботаБезПодключенияФР(Объект.КассаККМ);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РаботаБезПодключенияФР(ОбъектКасса)
	
	Если ЗначениеЗаполнено(ОбъектКасса) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектКасса, "ИспользоватьБезПодключенияОборудования");
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции


&НаКлиенте
Процедура ОповещениеВопросУспешностиОплатыКартой(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ПараметрДействия = ДополнительныеПараметры.ПараметрДействия;
	
	РезультатЭТ = (РезультатВопроса = КодВозвратаДиалога.Да);
	
	Если НЕ РезультатЭТ Тогда
		СтрокаСлипЧека = "";
		ТекстОписаниеОшибки = НСтр("ru = 'Операция отменена'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ЗавершитьОплатуКартой(ПараметрДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуАвторизацииЭТЗавершение(РезультатВыполнения, ПараметрДействия) Экспорт 
	
	ЭтаФорма.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При выполнении операции возникла ошибка:
			|""%ОписаниеОшибки%"".
			|Оплата по карте не была произведена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ПараметрДействия.НомерКарты          = РезультатВыполнения.НомерКарты;
		ПараметрДействия.НомерСсылкиОперации = РезультатВыполнения.СсылочныйНомер;
		ПараметрДействия.НомерЧекаЭТ         = РезультатВыполнения.НомерЧекаЭТ;
		ПараметрДействия.СтрокаСлипЧека      = РезультатВыполнения.ТекстСлипЧека;
		ЗавершитьОплатуКартой(ПараметрДействия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуАвторизацииЭТ(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	ПараметрДействия = ДополнительныеПараметры.ПараметрДействия;
	
	Если ТипЗнч(РезультатОткрытияФормы) = Тип("Структура") Тогда
		
		ПараметрДействия.СуммаОперации = РезультатОткрытияФормы.Сумма;
		
		Если НЕ ПараметрДействия.ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда
			
			ЭтаФорма.Доступность = Ложь;
			
			ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
			ПараметрыОперации.ТипТранзакции  = ПараметрДействия.ТипТранзакции;
			ПараметрыОперации.СуммаОперации  = РезультатОткрытияФормы.Сумма;
			ПараметрыОперации.НомерЧека      = РезультатОткрытияФормы.НомерЧека;
			ПараметрыОперации.СсылочныйНомер = РезультатОткрытияФормы.СсылочныйНомер;
			
			Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуАвторизацииЭТЗавершение", ЭтотОбъект, ПараметрДействия);
			ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение, УникальныйИдентификатор, 
				ПараметрДействия.ПараметрыЭТ.ИдентификаторУстройства, ПараметрыОперации,, ПараметрДействия.ПараметрыЭТ.ИдентификаторУстройстваПечатиСлипЧека);
			
		Иначе
			
			ПараметрДействия.НомерКарты          = РезультатОткрытияФормы.НомерКарты;
			ПараметрДействия.НомерСсылкиОперации = РезультатОткрытияФормы.СсылочныйНомер;
			ПараметрДействия.НомерЧекаЭТ         = РезультатОткрытияФормы.НомерЧека;
			
			ТекстВопроса = НСтр("ru = 'Требуется выполнить операцию оплаты на эквайринговом терминале.'") + Символы.ПС;
			ТекстВопроса = ТекстВопроса + НСтр("ru = 'Сумма операции:'") + " "+ ПараметрДействия.СуммаОперации  + Символы.ПС;
			ТекстВопроса = ТекстВопроса + Символы.ПС;
			ТекстВопроса = ТекстВопроса + НСтр("ru = 'Операция оплаты на эквайринговом терминале прошла успешно?'");
			
			ДополнительныеПараметры = Новый Структура; 
			ДополнительныеПараметры.Вставить("ПараметрДействия", ПараметрДействия);
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросУспешностиОплатыКартой", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОплатуКартой(ПараметрДействия)
	
	Объект.Оплата[0].СсылочныйНомер = ПараметрДействия.НомерСсылкиОперации;
	Объект.Оплата[0].НомерЧекаЭТ = ПараметрДействия.НомерЧекаЭТ;
	Объект.Оплата[0].НомерПлатежнойКарты = ПараметрДействия.НомерКарты;;
	Объект.Оплата[0].ДанныеПереданыВБанк = Истина;
	
	ИспользоватьБезПодключенияОборудованияФР = РаботаБезПодключенияФР(Объект.КассаККМ);
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	
	РезультатЗаписи = Записать(ПараметрыЗаписи);
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если РезультатЗаписи = Истина Тогда
		Если НомерКассовогоЧека = 0 Тогда
			ПробитьЧекНаКлиенте();
		КонецЕсли;
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовЭквайринга(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ТоварыРаботыУслугиПослеУдаленияНаСервере()
	РассчитатьИтоги();
	ОбновитьВсеСкидки();
КонецПроцедуры

&НаСервере
Процедура ЭтоРозничныйПокупательПриИзмененииНаСервере()
	Если Объект.ЭтоРозничныйПокупатель Тогда
		Объект.ОплатаПоДокументамОснованиям = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПоДокументамОснованиям", "Видимость", НЕ Объект.ЭтоРозничныйПокупатель);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДокументыОснованияОплаты", "Видимость", Объект.ОплатаПоДокументамОснованиям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТоварыРаботыУслугиЗаполнитьТоварыРаботыУслугиПоДокументамОснованиям", 
		"Видимость", Объект.ОплатаПоДокументамОснованиям);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТоварыРаботыУслугиГруппаУправлениеСкидками", 
		"Видимость", НЕ Объект.ОплатаПоДокументамОснованиям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСкидкиНаценки", 
		"Видимость", НЕ Объект.ОплатаПоДокументамОснованиям);
	
	ЗаполнятьКонтрагентаИДоговор = ЗаполнятьКонтрагентаИДоговор();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Контрагент", "Видимость", ЗаполнятьКонтрагентаИДоговор);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Договор", "Видимость", ЗаполнятьКонтрагентаИДоговор);
		
	Если НЕ ЗаполнятьКонтрагентаИДоговор Тогда
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();	
		Объект.Договор = Справочники.Договоры.ПустаяСсылка();
		
		Если НЕ ЗначениеЗаполнено(Объект.ПризнакСпособаРасчетаЧекаККМ) Тогда
			Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.ПризнакСпособаРасчетаЧекаККМ) Тогда
			Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПересчитатьЦеныНоменклатуры();
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Нет Тогда
		Объект.ТипЦены = ТипЦеныДоИзменения;
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныНоменклатуры()

	МассивНоменклатуры = МассивНоменклатуры(Объект.ТоварыРаботыУслуги.Выгрузить(, "Номенклатура"));
	
	ТаблицаЦен = ПолучитьЦенуНоменклатуры(МассивНоменклатуры,
		Объект.ТипЦены, Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
	
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрока.Номенклатура.Номенклатура, "Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			ТекСтрока.ЦенаБезСкидок = СтрокаЦены.Цена;
		Иначе
			ТекСтрока.ЦенаБезСкидок = 0;
		КонецЕсли;
		
		Скидка = РассчитатьСкидку(ТекСтрока.КлючСвязи, ТекСтрока.Номенклатура, ТекСтрока.ЦенаБезСкидок);
		ТекСтрока.Скидка = Скидка;
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - Скидка;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

	РассчитатьИтоги();	
	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
КонецПроцедуры // ПересчитатьЦеныНоменклатуры()

&НаСервере
Функция МассивНоменклатуры(МассивИзПрейскуранта)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Номенклатура
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Ссылка В(&МассивИзПрейскуранта)";
	Запрос.УстановитьПараметр("МассивИзПрейскуранта", МассивИзПрейскуранта);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.ВыгрузитьКолонку("Номенклатура");
КонецФункции

&НаСервере
Процедура ПерессчитатьВсеТоварыРаботыУслуги()
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
		Скидка = РассчитатьСкидку(ТекСтрока.КлючСвязи, ТекСтрока.Номенклатура, ТекСтрока.ЦенаБезСкидок);
		ТекСтрока.Скидка = Скидка;
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - Скидка;
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Количество");
	КонецЦикла;
	
	РассчитатьИтоги();	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПризнакСпособаРасчетаЧекаККМПриИзмененииНаСервере()
	УстановитьВидимостьЭлементовФормы();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПоискаПоШтрихкоду(Штрихкод, ДополнительныеПараметры) Экспорт          
	
	Если НЕ ПустаяСтрока(Штрихкод) Тогда
		СтруктураПараметровКлиента = ПолученШтрихкодИзСШК(Штрихкод);
		ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолученШтрихкодИзСШК(Штрихкод) Экспорт
	
	СтруктураРезультат = ПодключаемоеОборудованиеБГУВызовСервера.ПолученШтрихкодИзСШК(Штрихкод, ЭтотОбъект);
	Возврат СтруктураРезультат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента) Экспорт
	
	ОткрытаБлокирующаяФорма = Ложь;
	
	ПодключаемоеОборудованиеБГУКлиент.ОбработатьДанныеПоКоду(ЭтотОбъект, СтруктураПараметровКлиента, ОткрытаБлокирующаяФорма);
	
	Если СтруктураПараметровКлиента.Свойство("АктивизироватьСтроку") Тогда
		Элементы.ТоварыРаботыУслуги.ТекущаяСтрока = СтруктураПараметровКлиента.АктивизироватьСтроку;
		
		ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
		Если ТекущиеДанные.МаркируемыйТовар И РозничнаяРеализацияМаркированныхТоваров Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("Номенклатура"				, ТекущиеДанные.Номенклатура);
			ПараметрыОткрытияФормы.Вставить("СессияПроверкиКМОткрыта"	, СессияПроверкиКМОткрыта);
			ПараметрыОткрытияФормы.Вставить("КассаККМ"					, Объект.КассаККМ);
			ПараметрыОткрытияФормы.Вставить("АдресДанныхПроверкиКМ"		, ТекущиеДанные.АдресДанныхПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РезультатПроверкиКМ"		, ТекущиеДанные.РезультатПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РежимПродажи"				, 0);
			ПараметрыОткрытияФормы.Вставить("Организация"				, Объект.Организация); 
			ПараметрыОткрытияФормы.Вставить("ВидПродукцииИС"			, ВидПродукцииИС(ТекущиеДанные.Номенклатура));  
			ПараметрыОткрытияФормы.Вставить("ДокументОснование"			, Объект.Ссылка);

			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВводКодаМаркировки", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораДанныхПоиска(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьДанныеПоКодуСервер(Результат);
		ОбработатьДанныеПоКодуКлиент(Результат)
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДанныеПоКодуСервер(СтруктураРезультат) Экспорт
	
	ИдентификаторСтроки = Неопределено;
	СтрокаРезультата = СтруктураРезультат.ЗначенияПоиска[0];
	
	ИдентификаторСтроки = ДобавитьНайденныеПозицииТоваров(СтрокаРезультата);

	Если ИдентификаторСтроки <> Неопределено Тогда
		СтруктураРезультат.Вставить("АктивизироватьСтроку", ИдентификаторСтроки);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ДобавитьНайденныеПозицииТоваров(СтруктураПараметров) Экспорт 
	
	ИдентификаторСтроки = 1;
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		НоменклатураПрейскуранта = СтруктураПараметров.Номенклатура;
	Иначе
		НоменклатураПрейскуранта = СтруктураПараметров;
	КонецЕсли;	
		
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номенклатура", НоменклатураПрейскуранта);
	НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(ПараметрыОтбора);
	
	МаркируемыйТовар = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураПрейскуранта.Номенклатура, "ВидМаркируемойПродукции");
	
	Если НайденныеСтроки.Количество() = 0 ИЛИ (ЗначениеЗаполнено(МаркируемыйТовар) И РозничнаяРеализацияМаркированныхТоваров) Тогда
		НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
		НоваяСтрока.Номенклатура = НоменклатураПрейскуранта;
		НоваяСтрока.МаркируемыйТовар = ЗначениеЗаполнено(МаркируемыйТовар);
		
		Цена = ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура, Объект.ТипЦены, Объект.Дата, Объект.Организация);
		НоваяСтрока.Цена = Цена - НоваяСтрока.Скидка;
		НоваяСтрока.ЦенаБезСкидок = Цена;
		КоличествоПоУмолчанию = 1;
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(НоваяСтрока.Номенклатура);
			НоваяСтрока.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
			КоличествоПоУмолчанию = ДанныеНоменклатуры.Количество;
		КонецЕсли;
		
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
		
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество = КоличествоПоУмолчанию;
		КонецЕсли;	
		
		Скидка = РассчитатьСкидку(НоваяСтрока.КлючСвязи, НоваяСтрока.Номенклатура, НоваяСтрока.ЦенаБезСкидок);
		НоваяСтрока.Скидка = Скидка;
		НоваяСтрока.Цена = НоваяСтрока.ЦенаБезСкидок - Скидка;
		
		РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Количество");
		ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
		
		НоваяСтрока.ДополнениеНаименованияНоменклатуры = ТекстДополненияНаименованияНоменклатуры(Истина);
	Иначе
		ТекущиеДанные = НайденныеСтроки[0];
		КоличествоПоУмолчанию = 1;
		Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
			ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
			ТекущиеДанные.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
			КоличествоПоУмолчанию = ДанныеНоменклатуры.Количество;
		КонецЕсли;
		ТекущиеДанные.Количество = ТекущиеДанные.Количество + КоличествоПоУмолчанию;
		
		РассчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
		ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
		
		ТекущиеДанные.ДополнениеНаименованияНоменклатуры = ТекстДополненияНаименованияНоменклатуры(Истина);
	КонецЕсли;
	
	РассчитатьИтоги();	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
	Возврат ИдентификаторСтроки;
	
КонецФункции

&НаКлиенте
Функция ВозможностьВводаПоШК()
	
	Результат = Истина;
	
	Если ТолькоПросмотр Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ Результат Тогда
		ОчиститьСообщения();
		ТекстСообщения = НСтр("ru = 'Форма заблокирована. Ввод невозможен.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнятьКонтрагентаИДоговор()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, "ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя");
		ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя = ЗначенияРеквизитов.ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя;
	Иначе
		ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя = Ложь;
	КонецЕсли;	
	
	Если Объект.ЭтоРозничныйПокупатель Тогда
		Если ЗаполнятьКонтрагентаИДоговорДляРозничногоПокупателя Тогда
			ЗаполнятьКонтрагентаИДоговор = Истина;
		Иначе
			ЗаполнятьКонтрагентаИДоговор = Ложь;
		КонецЕсли;	
	Иначе	
		ЗаполнятьКонтрагентаИДоговор = Истина;
	КонецЕсли;
	
	Возврат ЗаполнятьКонтрагентаИДоговор;
КонецФункции

&НаСервере
Функция СуммаДокументаОснования(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") И ДокументОснование.Предоплата.Количество() > 0 Тогда 
		СуммаДокументаОснования = Объект.ТоварыРаботыУслуги.Итог("Всего");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда 	
		СуммаДокументаОснования = Объект.ТоварыРаботыУслуги.Итог("Всего");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда 	
		СуммаДокументаОснования = Объект.ТоварыРаботыУслуги.Итог("Всего");	
	Иначе	
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "СуммаДокумента");
		СуммаДокументаОснования = ЗначенияРеквизитов.СуммаДокумента;
	КонецЕсли;	
	
	Возврат СуммаДокументаОснования;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТоварыРаботыУслугиПоДокументамОснованиямНаСервере() Экспорт
	РозничныеПродажиБГУ.ЗаполнитьСписокТоваровРаботУслугПоДокументамОснованиям(Объект);
	РассчитатьИтоги();	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСдачу(ТекстПолучено = Неопределено)
	Если ТекстПолучено = Неопределено Тогда
		СуммаСдачи = Объект.ПолученоНаличными - СуммаОплатыНаличными;
	Иначе
		СуммаСдачи = Число(ТекстПолучено) - СуммаОплатыНаличными;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ПоказыватьОстатки", РозничныеПродажиБГУ.ВестиКонтрольОстатковТоваров(Объект.КассаККМ));
	ПараметрыПодбора.Вставить("ТипЦен", Объект.ТипЦены);
	ПараметрыПодбора.Вставить("ЦМО", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ЦМО"));
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда 
		ПараметрыПодбора.Вставить("Подразделение", Объект.Подразделение);
	КонецЕсли;  
	Возврат ПараметрыПодбора;
	
КонецФункции	

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение) 
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	СписокМаркируемыхТоваров = РозничныеПродажиБГУ.ПолучитьМаркируемыеТовары(СписокПодбора.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		Отбор = Новый Структура("Номенклатура", ЭлементПодбора.Номенклатура);
		НайденныеСтроки = СписокМаркируемыхТоваров.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() <> 0 И РозничнаяРеализацияМаркированныхТоваров Тогда 
			Для Счетчик = 1 По ЭлементПодбора.Количество Цикл 
				НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
				НоваяСтрока.ЦенаБезСкидок 		= ЭлементПодбора.Цена;
				НоваяСтрока.Количество 			= 1;
				НоваяСтрока.МаркируемыйТовар 	= Истина;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
				РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Цена");
			КонецЦикла;
		Иначе	
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура"	, ЭлементПодбора.Номенклатура);
			Отбор.Вставить("СтавкаНДС"		, ЭлементПодбора.СтавкаНДС);
			Отбор.Вставить("ЦенаБезСкидок"	, ЭлементПодбора.Цена);
			НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда 
				НоваяСтрока 			= НайденныеСтроки[0];
				НоваяСтрока.Количество 	= НоваяСтрока.Количество + ЭлементПодбора.Количество;
			Иначе
				НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
				НоваяСтрока.ЦенаБезСкидок 		= ЭлементПодбора.Цена;
				НоваяСтрока.МаркируемыйТовар 	= Ложь;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
			КонецЕсли;
			РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Цена");
		КонецЕсли;
		
	КонецЦикла;

	РассчитатьИтоги();	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);

КонецПроцедуры	

