&НаКлиенте
Процедура ТоварыРаботыУслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные.КлючСвязи = 0;
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, ТекущиеДанные, "КлючСвязи");
		ТекущиеДанные.ДополнениеНаименованияНоменклатуры = ТекстДополненияНаименованияНоменклатуры(Истина);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыСкидокПриАктивизацииНоменклатуры", 0.1, Истина);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиЦенаБезСкидокПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Цена = ТекущиеДанные.ЦенаБезСкидок - ТекущиеДанные.Скидка;
	ТекущиеДанные.Цена = ?(Цена < 0, 0, Цена);
	
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСкидкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	ТекущиеДанные.Цена = ТекущиеДанные.ЦенаБезСкидок - ТекущиеДанные.Скидка;
	
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	РассчитатьИтоги();	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("КлючСвязи", Элемент.ТекущиеДанные.КлючСвязи); 	
	МассивКУдалению = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СкидкиНаценки.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПослеУдаления(Элемент)
	ТоварыРаботыУслугиПослеУдаленияНаСервере();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если Поле.Имя = "ТоварыРаботыУслугиКодМаркировки" Тогда 
		СтандартнаяОбработка = Ложь;
		Если ТекущиеДанные <> Неопределено Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("Номенклатура"				, ТекущиеДанные.Номенклатура);
			ПараметрыОткрытияФормы.Вставить("КодМаркировки"				, ТекущиеДанные.КодМаркировки);
			ПараметрыОткрытияФормы.Вставить("СессияПроверкиКМОткрыта"	, СессияПроверкиКМОткрыта);
			ПараметрыОткрытияФормы.Вставить("КассаККМ"					, Объект.КассаККМ);
			ПараметрыОткрытияФормы.Вставить("АдресДанныхПроверкиКМ"		, ТекущиеДанные.АдресДанныхПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РезультатПроверкиКМ"		, ТекущиеДанные.РезультатПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РежимПродажи"				, 0);
			ПараметрыОткрытияФормы.Вставить("Организация"				, Объект.Организация); 
			ПараметрыОткрытияФормы.Вставить("ВидПродукцииИС"			, ВидПродукцииИС(ТекущиеДанные.Номенклатура));  
			ПараметрыОткрытияФормы.Вставить("ДокументОснование"			, Объект.Ссылка);
			ПараметрыОткрытияФормы.Вставить("Числитель"					, ТекущиеДанные.КоличествоПервичныхУпаковок);
			ПараметрыОткрытияФормы.Вставить("Знаменатель"				, КоличествоВоВторичнойУпаковке(ТекущиеДанные.Номенклатура));
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВводКодаМаркировки", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "ТоварыРаботыУслугиРецептВет" И РозничныеПродажиБГУВызовСервера.ЭтоВетеринарныйПрепарат(ТекущиеДанные.Номенклатура) Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекущиеДанные <> Неопределено Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("ТипДокумента"	, ТекущиеДанные.ТипДокументаВет);
			ПараметрыОткрытияФормы.Вставить("ДатаДокумента"	, ТекущиеДанные.ДатаДокументаВет);
			ПараметрыОткрытияФормы.Вставить("НомерДокумента", ТекущиеДанные.НомерДокументаВет);
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаДанныхРецептаВет", ЭтотОбъект);
			ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаДанныеРецептаВет", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСкидкиНаценкиНоменклатуры

&НаКлиенте
Процедура СкидкиНаценкиНоменклатурыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.ТоварыРаботыУслуги.ТекущиеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбрана номенклатура, для которой добавляется скидка.'");
		Сообщение.Сообщить();
		
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиНоменклатурыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Элементы.ТоварыРаботыУслуги.ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные = Элементы.СкидкиНаценкиНоменклатуры.ТекущиеДанные;
		ТекущиеДанные.КлючСвязи = Элементы.ТоварыРаботыУслуги.ТекущиеДанные.КлючСвязи;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиНоменклатурыСкидкаНаценкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СкидкиНаценкиНоменклатуры.ТекущиеДанные;
	ТекущиеДанныеНоменклатуры = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	ЦенаБезСкидок = ТекущиеДанныеНоменклатуры.ЦенаБезСкидок;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СкидкаНаценка) Тогда
		ТекущиеДанные.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(ТекущиеДанные.СкидкаНаценка, ЦенаБезСкидок);
		
		ТекущиеДанныеНоменклатуры.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекущиеДанные.КлючСвязи);
		
		ТекущиеДанныеНоменклатуры.Цена = ТекущиеДанныеНоменклатуры.ЦенаБезСкидок - ТекущиеДанныеНоменклатуры.Скидка;
		РассчитатьСтроку(ТекущиеДанныеНоменклатуры, Объект.СуммаВключаетНДС, "Цена");
		ОбновитьСкидкиНаценкиИИтогиНаСервере();
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыОснования

