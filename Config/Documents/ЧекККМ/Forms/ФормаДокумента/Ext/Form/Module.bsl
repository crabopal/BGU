&НаКлиенте
Процедура ЗаполнитьСуммуОплатыНаличнымиСтоимостьюТоваровРаботУслуг(Команда)
	
	СуммаОплатыНаличными = ИтогВсего;
	Объект.Оплата[0].Сумма = СуммаОплатыНаличными;
	
	РассчитатьИтогиОплаты();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммуОплатыПлатежнойКартойСтоимостьюТоваровРаботУслуг(Команда)
	СуммаОплатыПлатежнойКартой = ИтогВсего;
	Объект.Оплата[0].Сумма = СуммаОплатыПлатежнойКартой;
	
	ПересчитатьКомиссию(ЭтаФорма);
	УстановитьДанныеЭквайрингаНаСервере();
	
	РассчитатьИтогиОплаты();	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьКартой(Команда)
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;	
	
	Если ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ОплатаКартой();
	КонецЕсли;
