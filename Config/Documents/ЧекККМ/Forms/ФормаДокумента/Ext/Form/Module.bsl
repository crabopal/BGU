
&НаКлиенте
Перем СуммаВключаетНДСДоИзменения;
&НаКлиенте
Перем ТипЦеныДоИзменения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИспользоватьВалютныйУчет = Ложь;
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ПризнакСпособаРасчетаЧекаККМ) Тогда 
			Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
		КонецЕсли;
		
		Объект.КассоваяСмена = Документы.КассоваяСмена.ПустаяСсылка();
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
		
		Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		Если Объект.Оплата.Количество() = 0 Тогда 
			Объект.ЭтоРозничныйПокупатель = Истина;
			НоваяСтрока = Объект.Оплата.Добавить();
			УстановитьНастройкиНаличнойОплаты();
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьДанныеДляПечатиЧековККМ();
	ЗаполнитьСписокТерминаловПлатежныхКарт();
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
		
	Если Параметры.Ключ.Пустая() Тогда
		Если НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) И ТипЗнч(Параметры.Основание) <> Тип("ДокументСсылка.СчетНаОплату") Тогда
			Объект.ТипЦены = Объект.КассаККМ.ТипЦены;
			Объект.СуммаВключаетНДС = Объект.КассаККМ.СуммаВключаетНДС;
		КонецЕсли;
		
		Объект.НомерЧекаККМ = 0;
		Объект.НомерСменыККМ = 0;
		Объект.СтатусЧекаККМ = "";
		Объект.ИсправительныйЧекККМ = "";
	КонецЕсли;
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтаФорма);
	
	ОбновитьВсеСкидки();
	РассчитатьИтоги();
	РассчитатьИтогиОплаты();
	ЕстьПравоНастройкиРозничныхПродаж = РозничныеПродажиБГУ.ЕстьПравоНастройкиРозничныхПродаж();
	
	ПрочитатьДополнительныеДанныеЧековККМ();
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	ОбновитьДанныеЗаголовкаДокументыОснования(ЭтаФорма);
	
	УстановитьВидимостьЭлементовЭквайринга(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовФормы();
	УстановитьДоступностьДоговора(ЭтаФорма);
	УстановитьКартинкиЭлементовФормы();
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	УстановитьВидимостьУсловноеОформлениеМаркировка();

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, ЭтаФорма.Элементы.ИнформационныеСсылки);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьФункциональныеОпцииФормы();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ИспользоватьВалютныйУчет = Ложь;
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	ОбновитьДанныеЗаголовкаДокументыОснования(ЭтаФорма);
	
	ОбновитьСкидкиНаценкиИИтогиНаСервере();
	ОбновитьСуммыДокументовОснованийОплаты();
	РассчитатьИтогиОплаты();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ЗаполнитьДобавленныеКолонки();
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	УстановитьВидимостьЭлементовФормы();
	ОбновитьСуммыДокументовОснованийОплаты();
	Если НЕ Объект.ЭтоРозничныйПокупатель Тогда
		ДействияСКонтактнымиДаннымиДляЧекаККМ();
	Иначе
		ЗаписатьДополнительныеДанныеЧековККМ();
	КонецЕсли;
	
	ЗаполнитьДобавленныеКолонки();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьДоступностьДоговора(ЭтаФорма);
	
	Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.ГруппаТоварыРаботыУслуги;
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	ТекущаяОплата = Объект.Оплата[0];
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторКорзины) Тогда 
		СуммаОплаты 				= Объект.Оплата.Итог("Сумма"); 
		СуммаОплатыСертификатами 	= Объект.Оплата[1].Сумма; 
		СуммаКомиссии 				= Объект.Оплата.Итог("СуммаКомиссии");
	Иначе 
		СуммаОплаты					= ТекущаяОплата.Сумма;
		СуммаКомиссии	 			= ТекущаяОплата.СуммаКомиссии;
	КонецЕсли;	
	
	Если Объект.ФормаОплаты = 1 Или Объект.ФормаОплаты = 2 Тогда
		СуммаОплатыПлатежнойКартой = СуммаОплаты;
		ВидПлатежнойКарты = ТекущаяОплата.ВидПлатежнойКарты;
		ЭквайринговыйТерминал = ТекущаяОплата.ЭквайринговыйТерминал;
		ПараметрыДоговораЭквайринга = ТекущаяОплата.ПараметрыДоговораЭквайринга;
		ПроцентКомиссииБанка = ТекущаяОплата.ПроцентКомиссии;
		СуммаКомиссииБанка = СуммаКомиссии;
		ЗаполнитьПараметрыНДССКомиссии();
	Иначе
		СуммаОплатыНаличными = СуммаОплаты;
		РассчитатьСдачу();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ЭтоРозничныйПокупатель Тогда
		Если НЕ ЗначениеЗаполнено(ТекущийОбъект.КассаККМ.КонтрагентДляРозничныхПродаж) ИЛИ НЕ ЗначениеЗаполнено(ТекущийОбъект.КассаККМ.ДоговорДляРозничныхПродаж) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнены контрагент и договор соответствующие розничному покупателю для кассы ККМ из справочника ""Кассы ККМ (фискальные регистраторы)"".
			|Значение следует заполнить на закладке ""Настройки заполнения данных кассового чека"" (раздел ""Денежные средства""/""Управление ККТ""). '");
			Сообщение.Сообщить();
		КонецЕсли;	 
		
		Если НЕ ЗаполнятьКонтрагентаИДоговор() Тогда
			ТекущийОбъект.Контрагент = ТекущийОбъект.КассаККМ.КонтрагентДляРозничныхПродаж;
			ТекущийОбъект.Договор = ТекущийОбъект.КассаККМ.ДоговорДляРозничныхПродаж;
		Иначе
			Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Контрагент) Тогда
				ТекущийОбъект.Контрагент = ТекущийОбъект.КассаККМ.КонтрагентДляРозничныхПродаж;
				ТекущийОбъект.Договор = ТекущийОбъект.КассаККМ.ДоговорДляРозничныхПродаж;
			Конецесли;	
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Оплата.Количество() = 0 Тогда
		НоваяСтрока = Объект.Оплата.Добавить();
		УстановитьДанныеЭквайрингаНаСервере();
	КонецЕсли;	

	ТЗ_ТоварыУслуги = Новый ТаблицаЗначений;
	ТЗ_ТоварыУслуги.Колонки.Добавить("СтатьяАналитикиОплаты", Новый ОписаниеТипов("СправочникСсылка.СтатьиАналитикиОплатыЧекаККМ"));
	ТЗ_ТоварыУслуги.Колонки.Добавить("СуммаДляОплаты", Новый ОписаниеТипов("Число"));
	ТЗ_ТоварыУслуги.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТЗ_ТоварыУслуги.Колонки.Добавить("СуммаКомиссии", Новый ОписаниеТипов("Число"));
	ТЗ_ТоварыУслуги.Колонки.Добавить("КлючСвязиОплаты", Новый ОписаниеТипов("Число"));
 	
	ТЗ_ТоварыУслуги.Очистить();
	Для каждого ТекСтрока Из ТекущийОбъект.ТоварыРаботыУслуги Цикл
		НоваяСтрокаНоменклатуры = ТЗ_ТоварыУслуги.Добавить();
		НоваяСтрокаНоменклатуры.СтатьяАналитикиОплаты = ТекСтрока.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		НоваяСтрокаНоменклатуры.СуммаДляОплаты = ТекСтрока.Всего;
		НоваяСтрокаНоменклатуры.Сумма = 0;
		НоваяСтрокаНоменклатуры.СуммаКомиссии = 0;
		НоваяСтрокаНоменклатуры.КлючСвязиОплаты = 1;
	КонецЦикла;	
	
	ВсегоОплачено = Объект.Оплата[0].Сумма;
	ВсегоКомиссияБанка = Объект.Оплата[0].СуммаКомиссии;
	ПроцентБанка = Объект.Оплата[0].ПроцентКомиссии; 
	Для каждого ТекТоварУслуга Из ТЗ_ТоварыУслуги Цикл
		Если ВсегоОплачено = 0 Тогда 
			Прервать;
		КонецЕсли;
		
		ПолноеПогашение = Истина;
		Если ВсегоОплачено < ТекТоварУслуга.СуммаДляОплаты Тогда
			ПолноеПогашение = Ложь;
		КонецЕсли;	
		
		ТекТоварУслуга.Сумма = ?(ПолноеПогашение, ТекТоварУслуга.СуммаДляОплаты, ВсегоОплачено);
		Если ВсегоКомиссияБанка > 0 Тогда
			ТекТоварУслуга.СуммаКомиссии = Окр(ТекТоварУслуга.Сумма * ПроцентБанка / 100, 2);
			
			Если НДССКомиссииСверху Тогда 
				ТекТоварУслуга.СуммаКомиссии = ТекТоварУслуга.СуммаКомиссии + (ТекТоварУслуга.СуммаКомиссии * СтавкаНДССКомиссии)	
			КонецЕсли;	
			
			Если НЕ ПолноеПогашение Тогда
				ТекТоварУслуга.СуммаКомиссии = ВсегоКомиссияБанка;
			КонецЕсли;	
			
			ВсегоКомиссияБанка = ВсегоКомиссияБанка - ТекТоварУслуга.СуммаКомиссии;
		Конецесли;	
		
		ВсегоОплачено = ВсегоОплачено - ТекТоварУслуга.Сумма;
	КонецЦикла;	
	
	Если НЕ ТекущийОбъект.ОплатаПоДокументамОснованиям Тогда 
		ТекущийОбъект.ДокументыОснования.Очистить();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ИдентификаторКорзины) Тогда 
		ТекущийОбъект.РасшифровкаОплаты.Загрузить(ТЗ_ТоварыУслуги);
		
		Если Объект.Оплата.Количество() > 0 Тогда
			РасчетнаяСуммаКомиссииБанка = Объект.РасшифровкаОплаты.Итог("СуммаКомиссии");
			РазницаКомиссии = Объект.Оплата[0].СуммаКомиссии - РасчетнаяСуммаКомиссииБанка;
			Если НЕ РазницаКомиссии = 0 Тогда
				Если Объект.РасшифровкаОплаты.Количество() > 0 Тогда
					ТекущийОбъект.РасшифровкаОплаты[0].СуммаКомиссии = Объект.РасшифровкаОплаты[0].СуммаКомиссии + РазницаКомиссии;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	
	СохранитьДобавленныеКолонки();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВозможностьВводаПоШК() И ВводДоступен() Тогда
		ПодключаемоеОборудованиеБГУКлиент.ВнешнееСобытиеОборудования(ЭтотОбъект, Источник, Событие, Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если (ИмяСобытия = "ФискальныеОперацииБГУИзменение") Тогда
		УстановитьВидимостьЭлементовФормы();
		НомерКассовогоЧека  = НомерЧекаДляДокумента();
		ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

