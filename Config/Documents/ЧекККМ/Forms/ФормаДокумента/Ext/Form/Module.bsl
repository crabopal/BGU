Процедура ДокументыОснованияПослеУдаления(Элемент)
	ОбновитьДанныеЗаголовкаДокументыОснования(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияДокументОснованиеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДокументыОснования.ТекущиеДанные;
	ТекущиеДанные.СуммаДокумента = СуммаДокументаОснования(ТекущиеДанные.ДокументОснованиеЧекаККМ);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОснованиеЧекаККМ) Тогда
		Если ТипЗнч(ТекущиеДанные.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			Объект.ПризнакСпособаРасчетаЧекаККМ= ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная");
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьДанныеЗаголовкаДокументыОснования(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияДокументОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда
		ТекущиеДанные = Элементы.ДокументыОснования.ТекущиеДанные;
		ТекущиеДанные.СуммаДокумента = СуммаДокументаОснования(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

