	УстановитьДанныеЭквайрингаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СуммаКомиссииБанкаПриИзменении(Элемент)
	УстановитьДанныеЭквайрингаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидПлатежнойКартыПриИзменении(Элемент)
	ВыбранноеЗначение = ВидПлатежнойКарты;
	ДанныеОВидеКартыИПроценте = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(
		ПараметрыДоговораЭквайринга, ВыбранноеЗначение);
	Если ДанныеОВидеКартыИПроценте <> Неопределено Тогда
		ПроцентКомиссииБанка = ДанныеОВидеКартыИПроценте.ПроцентТорговойУступки;
		ПересчитатьКомиссию(ЭтаФорма);
	КонецЕсли;
	
	УстановитьДанныеЭквайрингаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОплатаВыполненаНажатие(Элемент)
	
	ДанныеБанковскойОперации = Новый Структура;
	ДанныеБанковскойОперации.Вставить("НомерПлатежнойКарты",Объект.Оплата[0].НомерПлатежнойКарты);
	ДанныеБанковскойОперации.Вставить("НомерЧекаЭТ",Объект.Оплата[0].НомерЧекаЭТ);
	ДанныеБанковскойОперации.Вставить("СсылочныйНомер",Объект.Оплата[0].СсылочныйНомер);
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	ДанныеБанковскойОперации.Вставить("НомерЧекаККМ",Формат(НомерКассовогоЧека,"ЧГ="));
	
	ОткрытьФорму("Документ.ЭквайринговаяОперация.Форма.ФормаДанныхБанковскойОперации",
		ДанныеБанковскойОперации, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиНоменклатурыСуммаПриИзменении(Элемент)
	ТекСтрока = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(ТекСтрока.КлючСвязи);
	ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;

	РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	РассчитатьИтоги();	
КонецПроцедуры

