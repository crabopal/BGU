
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ФормаВладельца = ЭтаФорма.ВладелецФормы;
	ВсеСкидкиНаценки.Очистить();
	Для каждого ТекСтрока Из ФормаВладельца.ВсеСкидкиНаценки Цикл
		НоваяСтрока = ВсеСкидкиНаценки.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	ИтогСкидка = ФормаВладельца.ИтогСкидка;
	ТоварыИтогСкидка = ФормаВладельца.ТоварыИтогСкидка;
	УслугиИтогСкидка = ФормаВладельца.УслугиИтогСкидка;
КонецПроцедуры

#КонецОбласти
