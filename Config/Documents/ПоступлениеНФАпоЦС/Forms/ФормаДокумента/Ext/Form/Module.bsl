КонецПроцедуры // ДоступностьЗависимыхРеквизитов()

&НаСервере
Процедура ОбновитьДанныеСчетовВФорме()
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	СчетОС = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "СчетОС");
	СчетМЗ = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "СчетМЗ");
	
	ДействующиеСчета = Новый Соответствие; 
	ДействующиеСчета.Вставить(СчетОС, Истина);
	ДействующиеСчета.Вставить(СчетМЗ, Истина);
	ДатаАктуальности = ДатаАктуальностиСчетов();
	УстановитьАктуальныеСчетаВТаблице(Объект.ОсновныеСредства, ДействующиеСчета, СчетОС, ДатаАктуальности);
	УстановитьАктуальныеСчетаВТаблице(Объект.Материалы, ДействующиеСчета, СчетМЗ, ДатаАктуальности);
	УстановитьАктуальныеСчетаВТаблице(Объект.ВозвратнаяТара, ДействующиеСчета, СчетМЗ, ДатаАктуальности);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьАктуальныеСчетаВТаблице(ТаблицаДокумента, ДействующиеСчета, СчетПоУмолчанию, ДатаАктуальности)
	Для Каждого Строка Из ТаблицаДокумента Цикл
	
		Если Не ЗначениеЗаполнено(Строка.СчетУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		СчетАктуальный = ДействующиеСчета.Получить(Строка.СчетУчета);
		
		Если СчетАктуальный = Неопределено Тогда
			СчетАктуальный = ПроверитьАктуальностьСчета(Строка.СчетУчета, ДатаАктуальности);
			ДействующиеСчета.Вставить(Строка.СчетУчета, СчетАктуальный);
		КонецЕсли;
		
		Если СчетАктуальный Тогда
			Продолжить;
		КонецЕсли;
		
		Строка.СчетУчета = СчетПоУмолчанию;
	
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПроверитьАктуальностьСчета(Счет, ДатаАктуальности)
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	СчетНеактуален = (ЗначениеЗаполнено(СвойстваСчета.ДатаНачалаДействия) И СвойстваСчета.ДатаНачалаДействия > ДатаАктуальности)
		Или (ЗначениеЗаполнено(СвойстваСчета.ДатаОкончанияДействия) И СвойстваСчета.ДатаОкончанияДействия < ДатаАктуальности);  
	
	Возврат Не СчетНеактуален;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКЭШПараметровФормыЛокальныеСчета()
	
	ДатаСчетов = ДатаАктуальностиСчетов();
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетОС",
		БухгалтерскийУчет.СчетПоКоду("22.1", ДатаСчетов, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетМЗ",
		БухгалтерскийУчет.СчетПоКоду("22.2", ДатаСчетов, Объект.Организация));
	
КонецПроцедуры

&НаСервере
Функция ДатаАктуальностиСчетов()
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		Возврат Объект.Дата;
	Иначе
		Возврат ОбщегоНазначения.ТекущаяДатаПользователя();
	КОнецЕсли;
КонецФункции
	
