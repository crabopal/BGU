
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НомераПриложенийСтрокой = Параметры.НомераПриложенийСтрокой;
	Дата = Параметры.Дата;
	НомераИзвещений = Параметры.НомераИзвещений;
	
	Если НомераИзвещений.Количество() > 0 Тогда
		ИспользоватьОтборПоНомерамПриложений = Истина;
		
		СвойстваДС = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СвойстваДС.ТекстЗапроса = ТекстЗапросаСНомерамиПриложений();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваДС);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаИзвещения", КонецДня(Дата));
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НомераПриложений", НомераИзвещений.ВыгрузитьЗначения());
		УстановитьИспользованиеОтбора(ЭтотОбъект);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НомераПриложенийСтрокой1",
			"Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИспользоватьОтборПоНомерамПриложений",
			"Видимость", Ложь);
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьОтборПоНомерамПриложенийПриИзменении(Элемент)
	УстановитьИспользованиеОтбора(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьИспользованиеОтбора(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "НеУчитыватьОтборПоНомерамПриложений",
		Не Форма.ИспользоватьОтборПоНомерамПриложений);
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаСНомерамиПриложений()
	Возврат
	"ВЫБРАТЬ
	|	ДокументПоступлениеНФАпоЦС.Ссылка КАК Ссылка,
	|	ДокументПоступлениеНФАпоЦС.ВерсияДанных КАК ВерсияДанных,
	|	ДокументПоступлениеНФАпоЦС.ПометкаУдаления КАК ПометкаУдаления,
	|	ДокументПоступлениеНФАпоЦС.Номер КАК Номер,
	|	ДокументПоступлениеНФАпоЦС.Дата КАК Дата,
	|	ДокументПоступлениеНФАпоЦС.Проведен КАК Проведен,
	|	ДокументПоступлениеНФАпоЦС.Организация КАК Организация,
	|	ДокументПоступлениеНФАпоЦС.ИФО КАК ИФО,
	|	ДокументПоступлениеНФАпоЦС.Подразделение КАК Подразделение,
	|	ДокументПоступлениеНФАпоЦС.Контрагент КАК Контрагент,
	|	ДокументПоступлениеНФАпоЦС.ЦМО КАК ЦМО,
	|	ДокументПоступлениеНФАпоЦС.Комментарий КАК Комментарий,
	|	ДокументПоступлениеНФАпоЦС.ИДИсточника КАК ИДИсточника,
	|	ДокументПоступлениеНФАпоЦС.СуммаДокумента КАК СуммаДокумента,
	|	ДокументПоступлениеНФАпоЦС.НомераПриложенийСтрокой КАК НомераПриложенийСтрокой,
	|	ОперацииДокументов.Операция КАК Операция,
	|	ВЫБОР
	|		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
	|		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки,
	|			ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода),
	|			ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	|	КОНЕЦ КАК СостояниеОперации,
	|	ВЫБОР
	|		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 4
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 3
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки,
	|			ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода),
	|			ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
	|			ТОГДА 5
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеОперацииКод,
	|	ДокументПоступлениеНФАпоЦС.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.ПоступлениеНФАпоЦС КАК ДокументПоступлениеНФАпоЦС
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО (ДокументПоступлениеНФАпоЦС.Ссылка = ОперацииДокументов.Документ)}
	|ГДЕ
	|	ДокументПоступлениеНФАпоЦС.Дата <= &ДатаИзвещения
	|	И (&НеУчитыватьОтборПоНомерамПриложений
	|	ИЛИ ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			Документ.ПоступлениеНФАпоЦС.Приложения КАК Т
	|		ГДЕ
	|			Т.Ссылка = ДокументПоступлениеНФАпоЦС.Ссылка
	|			И Т.НомерДокумента В (&НомераПриложений)))";
КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти
