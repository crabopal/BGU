		ТекстСообщения = НСтр("ru='Необходимо выбрать этап сдачи работ!'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ЭтапСдачиРабот");
		
		Возврат;
	КонецЕсли;
	
	Если Объект.СоставЭтапаРабот.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьОповещение", ЭтотОбъект);
