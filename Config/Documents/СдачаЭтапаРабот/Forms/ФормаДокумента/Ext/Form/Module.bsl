&НаКлиенте
Процедура СоставЭтапаРаботСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставЭтапаРабот.ТекущиеДанные;
	Количество = ?(ТекущиеДанные.Количество <>0, ТекущиеДанные.Количество, 1);
	
	ТекущиеДанные.Цена = ТекущиеДанные.Сумма / Количество;
	
	ПересчитатьСуммуНДС(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
	Если Объект.СуммаВключаетНДС Тогда
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма;
	Иначе
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ТекущиеДанные.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

