Функция ЭтапСдан(Ссылка)
	Возврат Ссылка.ЭтапСдан;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()
	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	Элементы.СоставЭтапаРаботСтавкаНДС.ТолькоПросмотр = Объект.РеализацияПоСтавке0;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Номенклатура КАК Номенклатура,
	|	Спр.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Спр.Номенклатура.НаименованиеПолное КАК Содержание,
	|	ВЫБОР
	|		КОГДА &Реализация0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|		ИНАЧЕ Спр.Номенклатура.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	ЦеныНоменклатуры.Цена КАК Цена,
	|	ЛОЖЬ КАК КомплектСПрослеживаемымиТоварами,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар
	|ИЗ
	|	Справочник.СоответствиеЭтаповРаботИНоменклатуры КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Дата,
	|				Организация = &Организация
	|					И ТипЦен = &ТипЦен) КАК ЦеныНоменклатуры
	|		ПО Спр.Номенклатура.Ссылка = ЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	Спр.Владелец = &Этап";
	
	ДатаДанные = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
	
	Запрос.УстановитьПараметр("Дата", ДатаДанные);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипЦен", Объект.ТипЦены);
	Запрос.УстановитьПараметр("Этап", Объект.ЭтапСдачиРабот);
	Запрос.УстановитьПараметр("Реализация0", Объект.РеализацияПоСтавке0);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		
		ТаблицаРезультата = Результат.Выгрузить();
		
		СвойстваНоменклатуры = УправлениеМатериальнымиЗапасами.ПризнакиПрослеживаемостиНоменклатуры(
		ТаблицаРезультата.ВыгрузитьКолонку("Номенклатура"),
		ДатаДанные);
		
		Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
			ЗаполнитьЗначенияСвойств(СтрокаРезультата, СвойстваНоменклатуры.Получить(СтрокаРезультата.Номенклатура));
			ЗаполнитьЗначенияСвойств(Объект.СоставЭтапаРабот.Добавить(), СтрокаРезультата);
		КонецЦикла;
			
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.СоставЭтапаРабот);
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);

	Иначе
		Объект.СоставЭтапаРабот.Загрузить(Результат.Выгрузить());
	КонецЕсли;
	
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.СоставЭтапаРабот);
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСтрокуТабличнойЧасти(ТекущиеДанные, СуммаВключаетНДС = Ложь)
	
	Количество = ?(ТекущиеДанные.Количество<>0, ТекущиеДанные.Количество, 1);
	ТекущиеДанные.Сумма = Количество*ТекущиеДанные.Цена;
	ПересчитатьСуммуНДС(ТекущиеДанные, СуммаВключаетНДС);
	
	Если СуммаВключаетНДС Тогда
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма;
	Иначе
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ТекущиеДанные.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммуНДС(ТекущиеДанные, СуммаВключаетНДС = Ложь)
	
	МножительСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ТекущиеДанные.СтавкаНДС, СуммаВключаетНДС, Не СуммаВключаетНДС);
	
	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * МножительСтавки;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ТабТЧ.Номенклатура КАК Номенклатура,
	|	ТабТЧ.Содержание КАК Содержание,
	|	ТабТЧ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТабТЧ.Количество КАК Количество,
	|	ТабТЧ.СтавкаНДС КАК СтавкаНДС
	|ПОМЕСТИТЬ ТабТЧ
	|ИЗ
	|	&ТабТЧ КАК ТабТЧ;
	|
	|ВЫБРАТЬ
	|	ТабТЧ.Номенклатура КАК Номенклатура,
	|	ТабТЧ.Содержание КАК Содержание,
	|	ТабТЧ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТабТЧ.Количество КАК Количество,
	|	ТабТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) КАК Цена
	|ИЗ ТабТЧ КАК ТабТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Дата,
	|				Организация = &Организация
	|					И ТипЦен = &ТипЦен) КАК ЦеныНоменклатуры
	|		ПО ТабТЧ.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипЦен", Объект.ТипЦены);
	Запрос.УстановитьПараметр("ТабТЧ", Объект.СоставЭтапаРабот.Выгрузить());
	
	ТаблицаСоставЭтапаРабот = Запрос.Выполнить().Выгрузить();
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	
	ТаблицаСоставЭтапаРабот.Колонки.Добавить("Сумма", ТипСумма);
	ТаблицаСоставЭтапаРабот.Колонки.Добавить("СуммаНДС", ТипСумма);
	ТаблицаСоставЭтапаРабот.Колонки.Добавить("Всего", ТипСумма);
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставЭтапаРабот Цикл
		ПересчитатьСтрокуТабличнойЧасти(СтрокаТаблицы, Объект.СуммаВключаетНДС);
	КонецЦикла;
	
	Объект.СоставЭтапаРабот.Загрузить(ТаблицаСоставЭтапаРабот);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИсполнительОбработкаВыбораСервер(Сотрудник, Период)
	
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, Должность, ДолжностьНаименование",
	Сотрудник, 
	Период);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
	
	Возврат ДанныеСотрудника;
	
КонецФункции

