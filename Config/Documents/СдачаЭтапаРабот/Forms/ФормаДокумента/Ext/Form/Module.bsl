#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЭтапСдачиРаботНачалоВыбораОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.СоставЭтапаРабот.Очистить();
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Владелец", Объект.Организация);
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ЭтапСдачиРабот);
		
		ОткрытьФорму("Справочник.ЭтапыСдачиРабот.Форма.ФормаВыбора", ПараметрыФормы, Элементы.ЭтапСдачиРабот, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапСдачиРаботОбработкаВыбораОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.ЭтапСдачиРабот = ДопПараметры;
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Владелец", Объект.Организация);
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ЭтапСдачиРабот);
		
		ОткрытьФорму("Справочник.ЭтапыСдачиРабот.Форма.ФормаВыбора", ПараметрыФормы, Элементы.ЭтапСдачиРабот, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаВключаетНДСПриИзмененииОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Для Каждого Строка Из Объект.СоставЭтапаРабот Цикл
			ПересчитатьСтрокуТабличнойЧасти(Строка, Объект.СуммаВключаетНДС);
		КонецЦикла;
	Иначе
		Объект.СуммаВключаетНДС = Не Объект.СуммаВключаетНДС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныНачалоВыбораОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьФорму("Справочник.ТипыЦенНоменклатуры.Форма.ФормаВыбора", , Элементы.ТипЦены, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныОчисткаОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.ТипЦены = ПредопределенноеЗначение("Справочник.ТипыЦенНоменклатуры.ПустаяСсылка");
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОповещение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

