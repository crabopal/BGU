	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Исполнитель = "";
		ИсполнительДолжность = "";
		Возврат;
	КонецЕсли;
	
	ДанныеСотрудника = ИсполнительОбработкаВыбораСервер(ВыбранноеЗначение, Объект.Дата);
	
	Объект.Исполнитель = ДанныеСотрудника.НаименованиеПолное;
	
