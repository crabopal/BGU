#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СдачаЭтапаРабот";
	КомандаПечати.Идентификатор		= "ПФ_MXL_АктСдачиПриемкиРабот";
	КомандаПечати.Представление		= НСтр("ru = 'Акт сдачи-приемки работ (этапа работ)'");
	КомандаПечати.Порядок			= 1;
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_АктСдачиПриемкиРабот") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_АктСдачиПриемкиРабот",
			"Акт сдачи-приемки работ (этапа работ)",
			ПечатьАкта(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
КонецПроцедуры // Печать()

Функция СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ШиринаВСимволах) Экспорт
	ТекСтрока = "";
	ВсегоСимволов = 0;
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
		ТекСлово = МассивСлов[к];
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		Если ВсегоСимволов < ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
		ИначеЕсли ВсегоСимволов = ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		Иначе
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТекСтрока;
КонецФункции	

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьАкта(МассивОбъектов, ОбъектыПечати)
	
	Ссылка = МассивОбъектов[0];
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСдачиПриемкиЭтапа";
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ВыборкаДанных = ПолучитьДанныеДляПечатиАкта(Ссылка);
	
	Макет = ПолучитьМакет("ПФ_MXL_АктСдачиПриемкиРабот");
	ОбластьМакетаЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаЗаголовок1      = Макет.ПолучитьОбласть("Заголовок1");
	ОбластьМакетаЗаголовок2      = Макет.ПолучитьОбласть("Заголовок2");
	ОбластьМакетаЗаголовок3      = Макет.ПолучитьОбласть("Заголовок3");
	ОбластьМакетаНаимОрг         = Макет.ПолучитьОбласть("НаимОрг");
	ОбластьМакетаНаимОргДоп      = Макет.ПолучитьОбласть("НаимОргДоп");
	ОбластьМакетаПредОрг         = Макет.ПолучитьОбласть("ПредОрг");
	ОбластьМакетаПредОргДоп      = Макет.ПолучитьОбласть("ПредОргДоп");
	ОбластьМакетаНаимЗак         = Макет.ПолучитьОбласть("НаимЗак");
	ОбластьМакетаНаимЗакДоп      = Макет.ПолучитьОбласть("НаимЗакДоп");
	ОбластьМакетаПредЗак         = Макет.ПолучитьОбласть("ПредЗак");
	ОбластьМакетаПредЗакДоп      = Макет.ПолучитьОбласть("ПредЗакДоп");
	
	ОбластьМакетаРаботы          = Макет.ПолучитьОбласть("Работы");
	ОбластьМакетаПодвал          = Макет.ПолучитьОбласть("Подвал");
	
	ВыборкаДанных.Следующий();
	ОбластьМакетаЗаголовок.Параметры.Заполнить(ВыборкаДанных);
	ОбластьМакетаЗаголовок.Параметры.ДатаДоговора = Формат(ВыборкаДанных.ДатаДоговора, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок);
	
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(ВыборкаДанных.НаименованиеОрганизации, 
																		ТабДокумент, 
																		ОбластьМакетаНаимОрг, 
																		ОбластьМакетаНаимОргДоп,
																		"НаимОргЯчейка",
																		"НаимОргДопЯчейка");
																		
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок1);
	
	ПредставительОрганизацииДолжность = ВыборкаДанных.ПредставительОрганизацииДолжность;
	ПредставительОрганизации = ВыборкаДанных.ПредставительОрганизации;
	Корреспонденты.Просклонять(ПредставительОрганизацииДолжность, 2, ПредставительОрганизацииДолжность);
	Корреспонденты.Просклонять(ПредставительОрганизации, 2, ПредставительОрганизации);
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(?(ПредставительОрганизацииДолжность = Неопределено, "", ПредставительОрганизацииДолжность + " ") + 
											  ?(ПредставительОрганизации = Неопределено, "", ПредставительОрганизации), 
												ТабДокумент, 
												ОбластьМакетаПредОрг, 
												ОбластьМакетаПредОргДоп,
												"ПредОргЯчейка",
												"ПредОргДопЯчейка");
																		
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок2);
	
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(ВыборкаДанных.НаименованиеЗаказчика, 
																		ТабДокумент, 
																		ОбластьМакетаНаимЗак, 
																		ОбластьМакетаНаимЗакДоп,
																		"НаимЗакЯчейка",
																		"НаимЗакДопЯчейка");
																		
	ПредставительЗаказчикаДолжность = ВыборкаДанных.ПредставительЗаказчикаДолжность;
	ПредставительЗаказчика = ВыборкаДанных.ПредставительЗаказчика;
	Корреспонденты.Просклонять(ПредставительЗаказчикаДолжность, 2, ПредставительЗаказчикаДолжность);
	Корреспонденты.Просклонять(ПредставительЗаказчика, 2, ПредставительЗаказчика);
	КолВыведенныхСтрок = ВывестиДлиннуюСтроку(?(ПредставительЗаказчикаДолжность = Неопределено, "", ПредставительЗаказчикаДолжность + " ") +
											  ?(ПредставительЗаказчика = Неопределено, "", ПредставительЗаказчика), 
												ТабДокумент, 
												ОбластьМакетаПредЗак, 
												ОбластьМакетаПредЗакДоп,
												"ПредЗакЯчейка",
												"ПредЗакДопЯчейка");
																		
	ОбластьМакетаЗаголовок3.Параметры.Заполнить(ВыборкаДанных);
	ТабДокумент.Вывести(ОбластьМакетаЗаголовок3);
	
	ВыборкаРабот = ВыборкаДанных.СоставЭтапаРабот.Выбрать();
	ИтогоСумма = 0;
	ИтогоНДС   = 0;
	Пока ВыборкаРабот.Следующий() Цикл
		ОбластьМакетаРаботы.Параметры.Номенклатура = "" + ВыборкаРабот.НомерСтроки + ". " + ВыборкаРабот.НоменклатураПредставление;
		ТабДокумент.Вывести(ОбластьМакетаРаботы);
		ИтогоСумма = ИтогоСумма + ВыборкаРабот.Сумма;
		ИтогоНДС   = ИтогоНДС + ВыборкаРабот.СуммаНДС;
	КонецЦикла;	
	
	ОбластьМакетаПодвал.Параметры.Заполнить(ВыборкаДанных);
	ОбластьМакетаПодвал.Параметры.ДатаДоговора = Формат(ВыборкаДанных.ДатаДоговора, "ДФ=dd.MM.yyyy");
	
	ОбластьМакетаПодвал.Параметры.Сумма = ИтогоСумма;
	ТекВалюта = ?(ЗначениеЗаполнено(Ссылка.ВалютаДокумента), Ссылка.ВалютаДокумента, Константы.ВалютаРегламентированногоУчета.Получить());
	ОбластьМакетаПодвал.Параметры.СуммаПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ИтогоСумма, ТекВалюта);
	ОбластьМакетаПодвал.Параметры.СуммаНДС = ИтогоНДС;
	
	ЮрАдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Организация, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	ОбластьМакетаПодвал.Параметры.СведенияОрганизации = "" + ВыборкаДанных.НаименованиеОрганизации + " (ИНН: " + ВыборкаДанных.ИННОрганизации + ")"
														+ " Адрес (юридический): " + ЮрАдресОрганизации + ", телефоны: " + ТелефонОрганизации;
														
	ТелефонКонтра = "";
	ЮрАдресКонтрагента = "";
	
	Если Ссылка.Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		ЮрАдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
		ТелефонКонтра = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
	ИначеЕсли Ссылка.Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЮрАдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		ТелефонКонтра = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка.Контрагент.ЮридическоеФизическоеЛицо, 
																							Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
	КонецЕсли;
	ОбластьМакетаПодвал.Параметры.СведенияЗаказчика = "" + ВыборкаДанных.НаименованиеЗаказчика + " (ИНН: " + ВыборкаДанных.ИННЗаказчика + ")"
														+ " Адрес (юридический): " + ЮрАдресКонтрагента + ", телефоны: " + ТелефонКонтра;
														
	ТабДокумент.Вывести(ОбластьМакетаПодвал);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечатиАкта(Ссылка)
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СдачаЭтапаРабот.Номер,
	               |	СдачаЭтапаРабот.Дата,
	               |	СдачаЭтапаРабот.Организация,
	               |	СдачаЭтапаРабот.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	СдачаЭтапаРабот.Организация.ИНН КАК ИННОрганизации,
	               |	ВЫБОР
	               |		КОГДА СдачаЭтапаРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо) ТОГДА ЮрЛица.НаименованиеПолное
				   |		КОГДА СдачаЭтапаРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо) ТОГДА ФизЛица.Наименование
	               |	КОНЕЦ КАК НаименованиеЗаказчика,
	               |	СдачаЭтапаРабот.Контрагент КАК СсылкаЗаказчика,
	               |	ВЫБОР
	               |		КОГДА СдачаЭтапаРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |			ТОГДА ЮрЛица.ИНН
	               |		КОГДА СдачаЭтапаРабот.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	               |			ТОГДА ФизЛица.ИНН
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК ИННЗаказчика,
				   |	СдачаЭтапаРабот.ИсполнительДолжность КАК ПредставительОрганизацииДолжность,
	               |	СдачаЭтапаРабот.Исполнитель КАК ПредставительОрганизации,
				   |	СдачаЭтапаРабот.ЗаказчикДолжность КАК ПредставительЗаказчикаДолжность,
	               |	СдачаЭтапаРабот.Заказчик КАК ПредставительЗаказчика,
	               |	СдачаЭтапаРабот.Договор.ДатаДоговора КАК ДатаДоговора,
	               |	СдачаЭтапаРабот.Договор.НомерДоговора КАК НомДоговора,
	               |	СдачаЭтапаРабот.ЭтапСдачиРабот.Наименование КАК ЭтапРаботы,
	               |	ВЫБОР
	               |		КОГДА СдачаЭтапаРабот.ВалютаДокумента = &ПустаяВалюта
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(&Руб)
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(СдачаЭтапаРабот.ВалютаДокумента)
	               |	КОНЕЦ КАК ВалютаПредставление,
	               |	СдачаЭтапаРабот.СоставЭтапаРабот.(
	               |		НомерСтроки КАК НомерСтроки,
	               |		ВЫБОР
	               |			КОГДА СдачаЭтапаРабот.СоставЭтапаРабот.Номенклатура.НаименованиеПолное = """"
	               |				ТОГДА СдачаЭтапаРабот.СоставЭтапаРабот.Номенклатура.НаименованиеПолное
	               |			ИНАЧЕ СдачаЭтапаРабот.СоставЭтапаРабот.Номенклатура.Наименование
	               |		КОНЕЦ + "". "" + СдачаЭтапаРабот.СоставЭтапаРабот.Содержание КАК НоменклатураПредставление,
	               |		Всего КАК Сумма,
	               |		СуммаНДС
	               |	)
	               |ИЗ
	               |	Документ.СдачаЭтапаРабот КАК СдачаЭтапаРабот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮрЛица
	               |		ПО СдачаЭтапаРабот.Контрагент.ЮридическоеФизическоеЛицо = ЮрЛица.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
	               |		ПО СдачаЭтапаРабот.Контрагент.ЮридическоеФизическоеЛицо = ФизЛица.Ссылка
	               |ГДЕ
	               |	СдачаЭтапаРабот.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ПустаяВалюта", Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("Руб", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Возврат(Запрос.Выполнить().Выбрать());
КонецФункции	

Функция ВывестиДлиннуюСтроку(Знач СтрокаВыода, ТабДокумент, Область1, Область2, НаименованиеЯчейкиОбласть1, НаименованиеЯчейкиОбласть2, 
								НачальныйИндексПараметра1 = 0) Экспорт
	СтрокаВыода = СтрЗаменить(СтрокаВыода, Символы.ПС, " ");
	МассивСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаВыода, " ");
	
	ЯчейкаОбласть1 = Область1.Область(НаименованиеЯчейкиОбласть1);
	ЯчейкаОбласть2 = Область2.Область(НаименованиеЯчейкиОбласть2);
	
	ТекШиринаКолонок1 = ?(ЯчейкаОбласть1.ШиринаКолонки = 0, 9, ЯчейкаОбласть1.ШиринаКолонки);
	ТекШиринаКолонок2 = ?(ЯчейкаОбласть2.ШиринаКолонки = 0, 9, ЯчейкаОбласть2.ШиринаКолонки);
	
	ЧислоСимволов1 = ТекШиринаКолонок1 * (ЯчейкаОбласть1.Право - ЯчейкаОбласть1.Лево + 1);
	ЧислоСимволов2 = ТекШиринаКолонок2 * (ЯчейкаОбласть2.Право - ЯчейкаОбласть2.Лево + 1);
	
	ТекИндекс = 0;
	Область1.Параметры.Установить(НачальныйИндексПараметра1, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов1));
	ТабДокумент.Вывести(Область1);
	КолВыведенныхСтрок = 0;
	Пока ТекИндекс <= МассивСлов.Количество() - 1 Цикл
		Область2.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов2));
		ТабДокумент.Вывести(Область2);
		КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
	КонецЦикла;	
	
	Возврат КолВыведенныхСтрок;
КонецФункции

#КонецОбласти

#КонецЕсли
