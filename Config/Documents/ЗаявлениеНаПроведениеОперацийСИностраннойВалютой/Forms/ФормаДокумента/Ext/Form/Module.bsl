	ДлинаИнформацииОтправителяПолучателю = " " + Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")+ " симв., макс. " + Формат(МаксимальнаяДлинаИнформацияОтправителяПолучателю, "ЧЦ=3; ЧН=0; ЧГ=0") + " симв."
	+ ?(ДлинаПоля > МаксимальнаяДлинаИнформацияОтправителяПолучателю, ", превышение " + Формат(ДлинаПоля - МаксимальнаяДлинаИнформацияОтправителяПолучателю, "ЧЦ=3; ЧГ=0") + " симв.", "");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Документ, ЭлементыФормы)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "ПокупкаПродажа", "Видимость", Документ.ТипОперации = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "ПереводСебеКакПБС", "Видимость", Документ.ТипОперации <> 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "Перевод", "Видимость", Документ.ТипОперации <> 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "НазначениеПлатежаПрочие", "Видимость", Документ.ТипОперации <> 0);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппыПолучателя()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы, "ПолучательОрганизация", "Видимость", Объект.ПереводСебеКакПБС);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы, "ПолучательКонтрагент", "Видимость", НЕ Объект.ПереводСебеКакПБС);
	
КонецПРоцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьВидимостьЭлементовФормы(Объект, ЭтотОбъект.Элементы);
	
	РеквизитыОрганКазначейства = РеквизитыКазначейства(Объект.ОрганКазначейства);
	Если Объект.ТипОперации > 0 Тогда
		Если Объект.ПереводСебеКакПБС Тогда
			РеквизитыПолучательОрганизация = РеквизитыПолучателя(Объект.Организация);
			РеквизитыБанкПолучателяОрганизации = РеквизитыБанка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчетаПБС, "КассовыйОрган"));
		Иначе
			РеквизитыПолучательКонтрагент = РеквизитыПолучателя(Объект.Получатель);
			РеквизитыБанкПолучателяКонтрагента = РеквизитыБанка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетПолучателя, "КассовыйОрган"));
		КонецЕсли;
		РеквизитыБанкКорреспондент = РеквизитыБанка(Объект.БанкКорреспондент);
		РеквизитыБанкПосредник1 = РеквизитыБанка(Объект.БанкПосредник1);
		РеквизитыБанкПосредник2 = РеквизитыБанка(Объект.БанкПосредник2);
		РеквизитыБанкПосредник3 = РеквизитыБанка(Объект.БанкПосредник3);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаСумма", "Заголовок", "Сумма, " + Объект.ВалютаДокумента);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыКазначейства(Казначейство)
	
	Если НЕ ЗначениеЗаполнено(Казначейство) Тогда
		Возврат "";
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Казначейство, "ИНН, НаименованиеЛатиницей");
	
	МеждународныйАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
		Казначейство, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКазначейства);
	
	Возврат "INN: " + Реквизиты.ИНН + ", " + Реквизиты.НаименованиеЛатиницей + ", " + МеждународныйАдрес;
	
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыПолучателя(Получатель)
	
	Если Не ЗначениеЗаполнено(Получатель) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Получатель) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЮридическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель, "ЮридическоеФизическоеЛицо");
		НаименованиеЛатиницей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮридическоеЛицо, "НаименованиеЛатиницей");
		МеждународныйАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			ЮридическоеЛицо, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКонтрагенты);
	ИначеЕсли ТипЗнч(Получатель) = Тип("СправочникСсылка.Организации") Тогда
		НаименованиеЛатиницей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель, "НаименованиеЛатиницей");
		МеждународныйАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			Получатель, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресОрганизации);
	Иначе
		ВызватьИсключение(НСтр("ru='Параметр ""Получатель"" неподходящего типа.'"));
	КонецЕсли;
	
	Возврат НаименованиеЛатиницей + ", " + МеждународныйАдрес;
	
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыБанка(Банк)
	
	Если НЕ ЗначениеЗаполнено(Банк) Тогда
		Возврат "";
	КонецЕсли;
	
	Реквизиты = "КоррСчет, СВИФТБИК, МеждународноеНаименование, Код, ГородМеждународный, АдресМеждународный";
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, Реквизиты);
	
	СтрокаРеквизитыБанка = "";
	
	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл
		
		Если Не ПустаяСтрока(СтрокаРеквизитыБанка) Тогда
			СтрокаРеквизитыБанка = СтрокаРеквизитыБанка + ", ";
		КонецЕсли;
		
		СтрокаРеквизитыБанка = СтрокаРеквизитыБанка + КлючЗначение.Значение;
		
	КонецЦикла;
	
	Возврат СтрокаРеквизитыБанка;
	
КонецФункции

