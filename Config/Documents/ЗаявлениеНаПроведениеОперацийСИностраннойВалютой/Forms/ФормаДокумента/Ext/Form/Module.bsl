	РеквизитыОрганКазначейства = РеквизитыКазначейства(Объект.ОрганКазначейства);
	
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета, "ПерваяПодпись, ВтораяПодпись");
	
КонецПроцедуры

