&НаКлиенте
Процедура УстановитьЗаголовокДлинаНазначенияПлатежаКлиент()
	
	ДлинаПоля = СтрДлина(СокрП(Объект.НазначениеПлатежа));
	
	ДлинаНазначенияПлатежа = " " + Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")+ " симв., макс. " + Формат(МаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧН=0; ЧГ=0") + " симв."
	+ ?(ДлинаПоля > МаксимальнаяДлинаНазначенияПлатежа, ", превышение " + Формат(ДлинаПоля - МаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧГ=0") + " симв.", "");
	
КонецПроцедуры

