КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции  

// Возвращает массив структур, содержащих значения реквизитов документа для выгрузки
//
// Параметры:
// МассивОбъектов               - Массив объектов данного вида
// ИспользоватьДопКл            - Признак применения доп. классификации и указании ее значений в структурах реквизитов документов
// ИспользоватьКодМероприятия   - Признак применения кодов мероприятий
// ИспользоватьКЭК              - Признак использования КЭК
// ИспользоватьАналитическийКод - Признак использования аналитического кода
// ИспользоватьКФО              - Признак применения КФО и указания значений КФО в структурах реквизитов документа
// ИспользоватьКОСГУПолучателя  - Признак использования КОСГУПолучателя
Функция ЗначенияРеквизитовДокумента(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт  
	
	Возврат ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявлениеНаПроведениеОперацийСИностраннойВалютой(МассивОбъектов);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати 	= "Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой";
	КомандаПечати.Идентификатор 	= "ПФ_MXL_Заявление";
	КомандаПечати.Представление 	= НСтр("ru = 'Заявление на проведение операций с иностранной валютой'");
	КомандаПечати.Порядок 			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Заявление") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Заявление",
			"Заявление на проведение операций с иностранной валютой",
			ПечатьЗаявленияНаПроведениеОперацийСИностраннойВалютой(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьЗаявленияНаПроведениеОперацийСИностраннойВалютой(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗаявлениеНаПроведениеОперацийСИностраннойВалютой";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.ПФ_MXL_Заявление");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьПокупкаПродажа = Макет.ПолучитьОбласть("ПокупкаПродажа");
	ОбластьПеревод = Макет.ПолучитьОбласть("Перевод");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявлениеНаПроведениеОперацийСИностраннойВалютой(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Если ДанныеДляПечати.ТипОперации = 0 Тогда
			ОбластьПокупкаПродажа.Параметры.Заполнить(ДанныеДляПечати);
		Иначе
			ОбластьПеревод.Параметры.Заполнить(ДанныеДляПечати);
			
			ПараметрыСНомерамиСчетов = Новый Массив;
			ПараметрыСНомерамиСчетов.Добавить("НомерСчетаПеревододателя");
			ПараметрыСНомерамиСчетов.Добавить("НомерСчетаПолучателя");
			ПараметрыСНомерамиСчетов.Добавить("БанкПолучателяНомерСчета");
			ПараметрыСНомерамиСчетов.Добавить("БанкКорреспондентНомерСчета");
			ПараметрыСНомерамиСчетов.Добавить("БанкПосредник1НомерСчета");
			ПараметрыСНомерамиСчетов.Добавить("БанкПосредник2НомерСчета");
			ПараметрыСНомерамиСчетов.Добавить("БанкПосредник3НомерСчета");
			
			Для Каждого Параметр Из ПараметрыСНомерамиСчетов Цикл
				Если ЗначениеЗаполнено(ОбластьПеревод.Параметры[Параметр]) Тогда
					ОбластьПеревод.Параметры[Параметр] = "/"+ОбластьПеревод.Параметры[Параметр];
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьПокупкаПродажа);
		ТабличныйДокумент.Вывести(ОбластьПеревод);
		
		ОбластьПодвал.Параметры.Заполнить(ДанныеДляПечати);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
