
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДанныеПрекращенияДоговора = ОбщегоНазначенияБГУВызовСервера.ДанныеПрекращенияДоговораСМОЛ(ПараметрКоманды);
	
	Если ДанныеПрекращенияДоговора.ДокументСсылка <> Неопределено Тогда
		ПоказатьОповещениеПользователя("Ввод на сновании", ПолучитьНавигационнуюСсылку(ДанныеПрекращенияДоговора.ДокументСсылка),
			СтрШаблон(НСтр("ru = 'Уже введен %1'"), ДанныеПрекращенияДоговора.ДокументСсылка), БиблиотекаКартинок.Информация32);
		Возврат;
	КонецЕсли;
	
	Основание = Новый Структура;
	Основание.Вставить("Основание", ПараметрКоманды);
	Основание.Вставить("ВводНаОсновании", Истина);
	
	ПараметрыФормы = Новый Структура("Основание", Основание);

	ОткрытьФорму("Документ.ПрекращениеДоговорМОЛ.Форма.ФормаДокумента", ПараметрыФормы,
			ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);

КонецПроцедуры
