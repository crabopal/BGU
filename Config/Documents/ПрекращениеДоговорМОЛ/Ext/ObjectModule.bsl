#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	КонтрольОстатковНФАПоСотруднику(РежимЗаписи, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("Основание") 
			И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ДоговорМОЛ") Тогда
			
			РеквизитыОснования = Новый Структура;
			РеквизитыОснования.Вставить("ДоговорОснование", "Ссылка");
			РеквизитыОснования.Вставить("Организация", "Организация");
			РеквизитыОснования.Вставить("Сотрудник", "Сотрудник");
			РеквизитыОснования.Вставить("Подразделение", "Подразделение");

			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.Основание, РеквизитыОснования);
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КонтрольОстатковНФАПоСотруднику(РежимЗаписи, Отказ)
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	МакетКомпоновки = Отчеты.ОстаткиНФАПоМОЛ.ПолучитьМакет("ПроверкаОстаковСотрудник");
	Запрос = Новый Запрос(МакетКомпоновки.НаборыДанных["ОстаткиЕПСБУ"].Запрос);
	
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Контрагент", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Контрагент"));
	Запрос.УстановитьПараметр("CчетаЛичногоПользования", БухгалтерскийУчет.СписокСчетов("27"));
	Запрос.УстановитьПараметр("Организация", Организация);

	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'У сотрудника %1 есть остатки по счетам учета НФА на дату прекращения договора'"), Сотрудник);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли