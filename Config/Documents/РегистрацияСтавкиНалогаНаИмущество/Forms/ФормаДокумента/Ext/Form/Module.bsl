&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	УсловноеОформлениеДолей(
		"Объект.ОсновныеСредства.ОбщаяСобственность",
		Элементы.ОсновныеСредстваДоляВПравеОбщейСобственностиЧислитель.Имя,
		Элементы.ОсновныеСредстваДоляВПравеОбщейСобственностиЗнаменатель.Имя);
		
	УсловноеОформлениеДолей(
		"Объект.ОсновныеСредства.КадастроваяСтоимостьОпределенаПоДолеПлощади",
		Элементы.ОсновныеСредстваДоляПлощадиЧислитель.Имя,
		Элементы.ОсновныеСредстваДоляПлощадиЗнаменатель.Имя);
	
	УсловноеОформлениеДолей(
		"Объект.ОсновныеСредства.ОтноситсяКТерриторииСубъектаРФВДоле",
		Элементы.ОсновныеСредстваДоляСтоимостиЧислитель.Имя,
		Элементы.ОсновныеСредстваДоляСтоимостиЗнаменатель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура УсловноеОформлениеДолей(ПолеФлага, ИмяПоляЧислитель, ИмяПоляЗнаменатель)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, ИмяПоляЧислитель);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, ИмяПоляЗнаменатель);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		ПолеФлага, ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста"				, ЦветаСтиля.НедоступныеДанныеЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного"	, Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст"					, НСтр("ru = '<не требуется>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр"			, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере();
	
	Если Объект.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению
		И Объект.ВариантРегистрации = 0 Тогда
		ПорядокНалогообложения = 2;
	ИначеЕсли Объект.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.ПоОбщейСтавке Тогда
		ПорядокНалогообложения = 1;
	Иначе
		ПорядокНалогообложения = 0;
	КонецЕсли;
	
	ПостановкаНаУчет = ?(ЗначениеЗаполнено(Объект.НалоговыйОрган) Или ЗначениеЗаполнено(Объект.КодПоОКТМО), 1, 0);
	КодОКТМОЗадан = ?(ЗначениеЗаполнено(Объект.КодПоОКТМО), 1, 0);
	ЗаполнитьСписокВыбораПорядокНалогообложения(ЭтотОбъект);
	ЗаполнитьКодЛьготы(ЭтотОбъект);
	РежимИсправленияСПрошлойДаты = ЗначениеЗаполнено(Объект.НачалоДействия);
		
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		СтрокаТаблицы.ОбщаяСобственность = СтрокаТаблицы.ДоляВПравеОбщейСобственностиЧислитель > 0 Или СтрокаТаблицы.ДоляВПравеОбщейСобственностиЗнаменатель > 0;
		СтрокаТаблицы.КадастроваяСтоимостьОпределенаПоДолеПлощади = СтрокаТаблицы.УдалитьДоляПлощадиЧислитель > 0 Или СтрокаТаблицы.УдалитьДоляПлощадиЗнаменатель > 0;
		СтрокаТаблицы.ОтноситсяКТерриторииСубъектаРФВДоле = СтрокаТаблицы.ДоляСтоимостиЧислитель > 0 Или СтрокаТаблицы.ДоляСтоимостиЗнаменатель > 0;
		
	КонецЦикла;
	
	СхемаКомпоновки = Отчеты.РасчетСреднегодовойСтоимостиИмущества.ПолучитьМакет("ДанныеЗаМесяц");
	СхемаКомпоновкиАдрес = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
	Если Не ПустаяСтрока(Объект.ОтборЗаполнения) Тогда
		ПараметрыНастройки = Новый Структура("СхемаКомпоновки,Отбор", СхемаКомпоновкиАдрес, Объект.ОтборЗаполнения);
		ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, ПредставлениеОтбора);
	КонецЕсли;
	
	Если ПустаяСтрока(ПредставлениеОтбора) Тогда
		ПредставлениеОтбора = "не установлен";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКодВидаИмущества()

	Объект.КодВидаИмущества = ?(Объект.НалоговаяБаза = 
		ПредопределенноеЗначение("Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость"),
		"11",
		"03");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокВыбораПорядокНалогообложения(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	СписокВыбора = Элементы.НалоговаяЛьгота.СписокВыбора;
	СписокВыбора.Очистить();
	
	СписокВыбора.Добавить(ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсобыеЛьготыНеУстановлены"), НСтр("ru='Не применяется'"));
	СписокВыбора.Добавить(ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке"));
	СписокВыбора.Добавить(ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения"));
		
	Если Объект.НалоговаяБаза = ПредопределенноеЗначение(
		"Перечисление.НалоговаяБазаПоНалогуНаИмущество.СреднегодоваяСтоимость") Тогда
	
		СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент"));
		СписокВыбора.Добавить(ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму"));

	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКодЛьготы(Форма)

	Объект = Форма.Объект;

	Если Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
				
		Форма.КодЛьготы = Объект.ОсвобождениеОтНалогообложенияКодЛьготы;
		
	ИначеЕсли Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке") Тогда
				
		Форма.КодЛьготы = "2012400";
		
	ИначеЕсли (Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент"))
		Или (Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму")) Тогда
				
		Форма.КодЛьготы = "2012500";
				
	Иначе
			
		Форма.КодЛьготы = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой()
	
	Облагается = ПорядокНалогообложения <> 2;
	
	Элементы.ПостановкаНаУчет.Видимость = Облагается;
	Элементы.НалоговыйОрган.Видимость = (ПостановкаНаУчет = 1) И Облагается;
	Элементы.ГруппаКодОКТМО.Видимость = (ПостановкаНаУчет = 1) И Облагается;
	
	Элементы.КодПоОКТМО.Доступность               = (КодОКТМОЗадан = 1);
	Элементы.КодПоОКТМО.АвтоОтметкаНезаполненного = (КодОКТМОЗадан = 1);
	Элементы.КодПоОКТМО.ОтметкаНезаполненного     = (КодОКТМОЗадан = 1) И ПустаяСтрока(Объект.КодПоОКТМО);
	
	Индивидуальный = (ПорядокНалогообложения = 0);
	
	Элементы.ГруппаСведения.Видимость = Индивидуальный;
	
	УправлениеВидимостьюКодЛьготы();
	УправлениеВидимостьюКодОснованияЛьготы();
	
	ВидимостьГруппыПериодДействияПараметров = (Объект.НалоговаяБаза = ПредопределенноеЗначение(
		"Перечисление.НалоговаяБазаПоНалогуНаИмущество.СреднегодоваяСтоимость"))
		Или ПорядокНалогообложения > 0;
		
	Элементы.РежимИсправленияСПрошлойДаты.Видимость = ВидимостьГруппыПериодДействияПараметров;
	Элементы.НачалоДействия.Видимость = ВидимостьГруппыПериодДействияПараметров;
	
	Элементы.НачалоДействия.АвтоОтметкаНезаполненного = РежимИсправленияСПрошлойДаты;
	Элементы.НачалоДействия.ОтметкаНезаполненного = РежимИсправленияСПрошлойДаты 
		И Не ЗначениеЗаполнено(Объект.НачалоДействия);
	Элементы.НачалоДействия.ТолькоПросмотр = Не РежимИсправленияСПрошлойДаты;
	Элементы.НачалоДействия.Доступность = РежимИсправленияСПрошлойДаты;
	
	ПоКадастровойСтоимости = (Объект.НалоговаяБаза = 
		ПредопределенноеЗначение("Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость"));
		
	ОтменаРегистрации = ПоКадастровойСтоимости И Объект.ВариантРегистрации = 1;

	Элементы.ВариантРегистрации.Видимость = Индивидуальный И ПоКадастровойСтоимости;

	Элементы.КодВидаИмущества.Видимость = Индивидуальный И Не ОтменаРегистрации;
	Элементы.НалоговаяСтавка.Видимость = Индивидуальный И Не ОтменаРегистрации;
	Элементы.ГруппаДанныеПоЛьготам.Видимость = Индивидуальный И Не ОтменаРегистрации;
	
	ПоКадастровойСтоимости = ПоКадастровойСтоимости И Не ОтменаРегистрации;
	
	Элементы.ОсновныеСредстваНеоблагаемаяКадастроваяСтоимость.Видимость = Индивидуальный И ПоКадастровойСтоимости;
	Элементы.ОсновныеСредстваГруппаОбщаяСобственность.Видимость = Индивидуальный И ПоКадастровойСтоимости;
	Элементы.ОсновныеСредстваГруппаДоляПлощади.Видимость = Индивидуальный И ПоКадастровойСтоимости;
	Элементы.ОсновныеСредстваГруппаНаТерриторииНесколькихСубъектов.Видимость = Индивидуальный
		И (ПоКадастровойСтоимости Или Объект.КодВидаИмущества = "02");
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКодЛьготы()

	ВидимостьКодЛьготы = Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения")
		Или (Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке"))
		Или (Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент"))
		Или (Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму"));
	
	Элементы.КодЛьготы.Видимость = ВидимостьКодЛьготы;

	Элементы.ПроцентУменьшенияСуммыНалога.Видимость = Объект.ПорядокНалогообложения =
		ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент");
				
	Элементы.СуммаУменьшенияСуммыНалога.Видимость = Объект.ПорядокНалогообложения =
		ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму");

КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКодОснованияЛьготы()
	
	РегиональныеЛьготы = Новый Соответствие;
	РегиональныеЛьготы.Вставить("2012000", Истина);
	РегиональныеЛьготы.Вставить("2012400", Истина);
	РегиональныеЛьготы.Вставить("2012500", Истина);
	
	ВидимостьКодОснованияЛьготы = Элементы.КодЛьготы.Видимость
		И РегиональныеЛьготы[КодЛьготы] <> Неопределено;
		
	Элементы.ДекорацияКодЛьготы.Видимость = ВидимостьКодОснованияЛьготы;
	Элементы.КодОснованияЛьготы.Видимость = ВидимостьКодОснованияЛьготы;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛишниеДанные()
	
	Если ПорядокНалогообложения = 2 Тогда
		ПостановкаНаУчет = 0;
	КонецЕсли;
	
	Если ПостановкаНаУчет = 0 Тогда
		Объект.НалоговыйОрган = ПредопределенноеЗначение("Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка");
		КодОКТМОЗадан = 0;
	КонецЕсли;
	
	Если КодОКТМОЗадан = 0 Тогда
		Объект.КодПоОКТМО = "";
	КонецЕсли;
	
	Если ПорядокНалогообложения > 0 Тогда
		
		Объект.НалоговаяБаза = ПредопределенноеЗначение(
			"Перечисление.НалоговаяБазаПоНалогуНаИмущество.СреднегодоваяСтоимость");
		Объект.НалоговаяСтавка = 0;
		Объект.ПорядокНалогообложения = ?(ПорядокНалогообложения = 1,
			ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.ПоОбщейСтавке"),
			ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению"));
		Объект.КодВидаИмущества = "";
		
	КонецЕсли;
	
	Если Объект.НалоговаяБаза <> ПредопределенноеЗначение(
		"Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость") Тогда
		Объект.ВариантРегистрации = 0;
	КонецЕсли;
	
	Если Объект.ВариантРегистрации = 1 Тогда

		Объект.НалоговаяСтавка = 0;
		Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению");
		Объект.КодВидаИмущества = "";

	КонецЕсли;
	
	Если Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
		Объект.ОсвобождениеОтНалогообложенияКодЛьготы = КодЛьготы;
	Иначе
		Объект.ОсвобождениеОтНалогообложенияКодЛьготы = "";
	КонецЕсли;
	
	Если Не Элементы.КодОснованияЛьготы.Видимость Тогда
		Объект.КодОснованияЛьготы = "";
	КонецЕсли;
	
	Если Объект.ПорядокНалогообложения <> ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент") Тогда
		Объект.ПроцентУменьшенияСуммыНалога = 0;
	КонецЕсли;
	
	Если Объект.ПорядокНалогообложения <> ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму") Тогда
		Объект.СуммаУменьшенияСуммыНалога = 0;
	КонецЕсли;
	
	Если ПорядокНалогообложения = 0	И Объект.НалоговаяБаза = ПредопределенноеЗначение(
		"Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость") Тогда
		РежимИсправленияСПрошлойДаты = Ложь;
		Объект.НачалоДействия = Дата(1, 1, 1);
	КонецЕсли;

	ПоКадастровой = Объект.НалоговаяБаза = ПредопределенноеЗначение(
		"Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость")
		И Объект.ВариантРегистрации = 0;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		Если ПорядокНалогообложения > 0 Или Не ПоКадастровой Тогда
			СтрокаТаблицы.НеоблагаемаяКадастроваяСтоимость = 0;
			СтрокаТаблицы.ОбщаяСобственность = Ложь;
			СтрокаТаблицы.КадастроваяСтоимостьОпределенаПоДолеПлощади = Ложь;
			Если Объект.КодВидаИмущества <> "02" Тогда
				СтрокаТаблицы.ОтноситсяКТерриторииСубъектаРФВДоле = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если Не СтрокаТаблицы.ОбщаяСобственность Тогда
			СтрокаТаблицы.ДоляВПравеОбщейСобственностиЧислитель = 0;
			СтрокаТаблицы.ДоляВПравеОбщейСобственностиЗнаменатель = 0;
		КонецЕсли;
		
		Если Не СтрокаТаблицы.КадастроваяСтоимостьОпределенаПоДолеПлощади Тогда
			СтрокаТаблицы.УдалитьДоляПлощадиЧислитель = 0;
			СтрокаТаблицы.УдалитьДоляПлощадиЗнаменатель = 0;
		КонецЕсли;
		
		Если Не СтрокаТаблицы.ОтноситсяКТерриторииСубъектаРФВДоле Тогда
			СтрокаТаблицы.ДоляСтоимостиЧислитель = 0;
			СтрокаТаблицы.ДоляСтоимостиЗнаменатель = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	
	СхемаКомпоновки = ПолучитьИзВременногоХранилища(СхемаКомпоновкиАдрес);
	ПараметрВидыНФА = СхемаКомпоновки.Параметры.Найти("ВидыНФА");
	Если ПараметрВидыНФА <> Неопределено Тогда
		ВидыНФА = Новый Массив;
		ВидыНФА.Добавить(Перечисления.ВидыНФА.ОС);
		ПараметрВидыНФА.Значение = ВидыНФА;
	КонецЕсли;	
	
	Настройки = СхемаКомпоновки.ВариантыНастроек["Основной"].Настройки;
	Настройки.Отбор.Элементы.Очистить();
	
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки.Отбор, "Организация", Объект.Организация);
	
	Если ЗначениеЗаполнено(Объект.ОтборЗаполнения) Тогда
		Отбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(Объект.ОтборЗаполнения);
		ОбщийМодульСКД.СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, Отбор);
	КонецЕсли;

	ПараметрыСхемы = Настройки.ПараметрыДанных.Элементы;

	Если Объект.Ссылка.Пустая() Тогда
		Период = ?(Объект.Дата = НачалоДня(Объект.Дата), КонецДня(Объект.Дата), Объект.Дата);
		ПериодСтавок = Период;
	Иначе
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		ПериодСтавок = Объект.Дата - 1;
	КонецЕсли;	

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "Период", Период);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "ПериодСтавок", ПериодСтавок);

	ВыбранныеПоля = Настройки.Выбор;
	ВыбранныеПоля.Элементы.Очистить();
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(ВыбранныеПоля, "ОсновноеСредство");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(ВыбранныеПоля, "ИнвентарныйНомер");
	
	ПолеПорядка = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядка.Поле = Новый ПолеКомпоновкиДанных("ОсновноеСредство");
	ПолеПорядка = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядка.Поле = Новый ПолеКомпоновкиДанных("ИнвентарныйНомер");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
		Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Объект.ОсновныеСредства.Загрузить(Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнвентарныйНомерОС(Организация, ОсновноеСредство, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвНомер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И НЕ ОсновноеСредство.ГрупповойУчет
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних";
	
	Результат = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ИнвНомер;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

