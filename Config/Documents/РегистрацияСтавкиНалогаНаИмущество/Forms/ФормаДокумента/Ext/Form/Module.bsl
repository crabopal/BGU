
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//// СтандартныеПодсистемы.Свойства
	//УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект);
	//// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	Если Параметры.Свойство("ЗаполнитьПриОткрытии") Тогда
		ЗаполнитьТаблицуСервер();
	КонецЕсли;
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеФормой();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			Объект.ОтборЗаполнения	= ВыбранноеЗначение.Отбор;
			ПредставлениеОтбора		= ВыбранноеЗначение.ПредставлениеОтбора;
			Если ПредставлениеОтбора = "" Тогда
				ПредставлениеОтбора = "не установлен";
			КонецЕсли;
			Модифицированность = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОчиститьЛишниеДанные();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПодготовитьФормуНаСервере();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ПостановкаНаУчет = 1 И Не ЗначениеЗаполнено(Объект.НалоговыйОрган) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен налоговый орган'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.НалоговыйОрган", , Отказ);
	КонецЕсли;
	
	Если КодОКТМОЗадан = 1 И Не ЗначениеЗаполнено(Объект.КодПоОКТМО) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен код по ОКТМО'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.КодПоОКТМО", , Отказ);
	КонецЕсли;
	
	Если Объект.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению
		И ПорядокНалогообложения = 0 И Объект.ВариантРегистрации = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена налоговая льгота'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ПорядокНалогообложения", , Отказ);
	КонецЕсли;
	
	Если Объект.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения
		И Не ЗначениеЗаполнено(КодЛьготы) 
		И ПорядокНалогообложения = 0 Тогда
		ТекстСообщения = НСтр("ru='Не заполнен код льготы'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "КодЛьготы", , Отказ);
	КонецЕсли;
	
	Если РежимИсправленияСПрошлойДаты И Не ЗначениеЗаполнено(Объект.НачалоДействия) Тогда
		ТекстСообщения = НСтр("ru='Не заполнена дата начала действия параметров'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.НачалоДействия", , Отказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.НачалоДействия) И Объект.НачалоДействия > Объект.Дата Тогда
		ТекстСообщения = НСтр("ru='Начало действия параметров не может быть позже даты документа'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.НачалоДействия", , Отказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПорядокНалогообложенияПриИзменении(Элемент)
	
	Если ПорядокНалогообложения = 0 Тогда
		Объект.ПорядокНалогообложения = 
			ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.ОсобыеЛьготыНеУстановлены");
		УстановитьКодВидаИмущества();
	КонецЕсли;
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПостановкаНаУчетПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура КодОКТМОЗаданПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговаяБазаПриИзменении(Элемент)
	
	УстановитьКодВидаИмущества();
	ЗаполнитьСписокВыбораПорядокНалогообложения(ЭтотОбъект);
	Если Элементы.НалоговаяЛьгота.СписокВыбора.НайтиПоЗначению(Объект.ПорядокНалогообложения) = Неопределено Тогда
		Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ПустаяСсылка");
	КонецЕсли;
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантРегистрацииПриИзменении(Элемент)
	
	Если Объект.ВариантРегистрации = 0
		И Не ЗначениеЗаполнено(Объект.КодВидаИмущества) Тогда
		УстановитьКодВидаИмущества();
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура КодВидаИмуществаПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура КодВидаИмуществаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Префикс = ?(Объект.НалоговаяБаза = ПредопределенноеЗначение("Перечисление.НалоговаяБазаПоНалогуНаИмущество.КадастроваяСтоимость"),
		"КодВидаИмРазделТри", "КодВидаИмущества");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"		, "Код вида имущества");
	ПараметрыФормы.Вставить("Префикс"		, Префикс);
	ПараметрыФормы.Вставить("ИмяМакета"		, "Документ.РегистрацияСтавкиНалогаНаИмущество.СпискиВыбора");
	ПараметрыФормы.Вставить("ТекущийПериод"	, Объект.Дата);
	ПараметрыФормы.Вставить("ТекущийКод"	, Объект.КодВидаИмущества);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговаяЛьготаПриИзменении(Элемент)
	
	ЗаполнитьКодЛьготы(ЭтотОбъект);
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура КодЛьготыПриИзменении(Элемент)

	УправлениеВидимостьюКодОснованияЛьготы();
	
	Если Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
			
		Объект.ОсвобождениеОтНалогообложенияКодЛьготы = КодЛьготы;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КодЛьготыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Код льготы");
	ПараметрыФормы.Вставить("ИмяМакета", "Документ.РегистрацияСтавкиНалогаНаИмущество.СпискиВыбора");
	ПараметрыФормы.Вставить("ТекущийПериод", Объект.Дата);
	ПараметрыФормы.Вставить("ТекущийКод", КодЛьготы);

	Если Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготы");

	ИначеЕсли Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготыСнижениеСтавки");
	
	ИначеЕсли Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент")
		Или Объект.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготыСнижениеСуммы");

	Иначе
		
		Возврат;
				
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КодОснованияЛьготыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОснованиеЛьготы", Элемент.ТекстРедактирования);
	ОткрытьФорму("ОбщаяФорма.ФормаВводаОснованияЛьготы", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура РежимИсправленияСПрошлойДатыПриИзменении(Элемент)

	Если Не РежимИсправленияСПрошлойДаты Тогда
		Объект.НачалоДействия = Дата(1,1,1);
	КонецЕсли;
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеОтбораНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("СхемаКомпоновки,Отбор", СхемаКомпоновкиАдрес, Объект.ОтборЗаполнения);
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для Каждого Значение Из ВыбранноеЗначение Цикл
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		НоваяСтрока.ОсновноеСредство = Значение;
		Если ЗначениеЗаполнено(Значение) Тогда
			НоваяСтрока.ИнвентарныйНомер = ИнвентарныйНомерОС(Объект.Организация, Значение, Объект.Дата);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		ТекущаяСтрока.ИнвентарныйНомер = ИнвентарныйНомерОС(Объект.Организация, ТекущаяСтрока.ОсновноеСредство, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКадастроваяСтоимостьОпределенаПоДолеПлощадиПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущаяСтрока.КадастроваяСтоимостьОпределенаПоДолеПлощади Тогда
		ТекущаяСтрока.КадастроваяСтоимостьОпределенаПоДолеПлощади = Ложь;
		ТекстПредупреждения = НСтр("ru='Установка признака ""Стоимость определена по доле площади"" перенесена в ""Сведения кадастрового учета"".'");
		ПоказатьПредупреждение(, ТекстПредупреждения);		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборОС(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("ЭтоГруппа", Ложь);
	
	ПараметрыФормы = Новый Структура("Отбор,ЗакрыватьПриВыборе, МножественныйВыбор", Отбор, Ложь, Истина);
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элементы.ОсновныеСредства);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОС(Команда)
	
	ЗаполнитьТаблицуСервер();
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
