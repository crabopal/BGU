#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению
		Или ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.ПоОбщейСтавке Тогда
		МассивНепроверяемыхРеквизитов.Добавить("КодВидаИмущества");
	КонецЕсли;

	МассивНепроверяемыхРеквизитов.Добавить("ПорядокНалогообложения");
	Если Не ЗначениеЗаполнено(ПорядокНалогообложения) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена налоговая льгота'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ПорядокНалогообложения", "Объект", Отказ);
	КонецЕсли;

	Если ПорядокНалогообложения <> Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ПроцентУменьшенияСуммыНалога");
	КонецЕсли;

	Если ПорядокНалогообложения <> Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СуммаУменьшенияСуммыНалога");
	КонецЕсли;

	МассивНепроверяемыхРеквизитов.Добавить("НачалоДействия");

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов); 
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроверитьДублиРегистраций(Отказ);
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И Не ДанныеЗаполнения.Свойство("НалоговаяСтавка") Тогда
		ДанныеЗаполнения.Вставить("НалоговаяСтавка",
			Документы.РегистрацияСтавкиНалогаНаИмущество.БазоваяСтавка());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиРегистраций(Отказ)
	
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам");
		ЭлементБлокировки.УстановитьЗначение("Период", Дата);
		ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
		ЭлементБлокировки.ИсточникДанных = ОсновныеСредства;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ОсновноеСредство", "ОсновноеСредство");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИнвентарныйНомер", "ИнвентарныйНомер");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.НомерСтроки КАК НомерСтроки,
			|	РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
			|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.Регистратор КАК Регистратор
			|ИЗ
			|	Документ.РегистрацияСтавкиНалогаНаИмущество.ОсновныеСредства КАК РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам КАК
			|			СтавкиНалогаНаИмуществоПоОсновнымСредствам
			|		ПО СтавкиНалогаНаИмуществоПоОсновнымСредствам.Активность
			|		И СтавкиНалогаНаИмуществоПоОсновнымСредствам.Период = &Период
			|		И СтавкиНалогаНаИмуществоПоОсновнымСредствам.Организация = &Организация
			|		И СтавкиНалогаНаИмуществоПоОсновнымСредствам.Регистратор <> &Ссылка
			|		И
			|			РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.ОсновноеСредство = СтавкиНалогаНаИмуществоПоОсновнымСредствам.ОсновноеСредство
			|		И
			|			РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.ИнвентарныйНомер = СтавкиНалогаНаИмуществоПоОсновнымСредствам.ИнвентарныйНомер
			|ГДЕ
			|	РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.Ссылка = &Ссылка
			|	И НЕ ((РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.ДоляСтоимостиЧислитель > 0
			|	ИЛИ РегистрацияСтавкиНалогаНаИмуществоОсновныеСредства.ДоляСтоимостиЗнаменатель > 0)
			|	И (СтавкиНалогаНаИмуществоПоОсновнымСредствам.ДоляСтоимостиЧислитель > 0
			|	ИЛИ СтавкиНалогаНаИмуществоПоОсновнымСредствам.ДоляСтоимостиЗнаменатель > 0))
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Период", Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		ИмяТабличнойЧасти = "ОсновныеСредства";
		ИмяРеквизита = "ОсновноеСредство";
		
		Пока Выборка.Следующий() Цикл

			ТекстСообщения = НСтр("ru='За период %1 для основного средства ""%2"" строка № %3 уже существует запись в регистре ""Ставки налога на имущество"".
								  |Запись в регистре сформирована документом %4.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Дата, Выборка.ОсновноеСредство, Выборка.НомерСтроки,
				Выборка.Регистратор);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Выборка.НомерСтроки,
				ИмяРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);

		КонецЦикла;
	
	Исключение
		
		ИмяСобытия = НСтр("ru = 'Проведение ""Регистрация порядка налогообложения имущества""'");
		
		ТекстСообщения = НСтр("ru = 'Не удалось провести документ ""Регистрация порядка налогообложения имущества"" по причине: %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.РегистрацияСтавкиНалогаНаИмущество,
			,
			ТекстСообщения);
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли