&НаКлиенте
Процедура ЗагрузитьИзТСДКлиент_Завершение(Результат, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		ЗагрузитьИзТСДСервер(Результат);
	КонецЕсли;
	
КонецПроцедуры	
&НаСервере
Процедура ЗагрузитьИзТСДСервер(Результат)
	
	ТаблицаЗагрузкиИзТСД = Новый ТаблицаЗначений();
	ТаблицаЗагрузкиИзТСД.Колонки.Добавить("Штрихкод",	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(13)));
	ТаблицаЗагрузкиИзТСД.Колонки.Добавить("Количество",	Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный)));
	
	// Гарантируем отсутствие дублей строк по штрихкоду в данных из ТСД
	Для Каждого СтруктураДанных Из Результат Цикл
		НоваяСтрока = ТаблицаЗагрузкиИзТСД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанных);
	КонецЦикла;
	ТаблицаЗагрузкиИзТСД.Свернуть("Штрихкод", "Количество");
	
	// Гарантируем заполненность колонки Штрихкод
	Поиск = Новый Структура("Штрихкод", "");
	МассивСтрок = Объект["Инвентаризация"].НайтиСтроки(Поиск);
	НезаполненныеШтрихкоды = Объект["Инвентаризация"].Выгрузить(МассивСтрок, "Штрихкод");
	ШтрихкодыНеЗаполнены = (НезаполненныеШтрихкоды.Количество() = Объект["Инвентаризация"].Количество());
	Если ШтрихкодыНеЗаполнены Тогда
		ТаблицаОСдляТСД();
	КонецЕсли;
	
	// Дозаполняем существующие строки
	Поиск = Новый Структура("Штрихкод");
	Для Каждого СтрокаТаблицы Из Объект["Инвентаризация"] Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		МассивСтрок = ТаблицаЗагрузкиИзТСД.НайтиСтроки(Поиск);
		Если МассивСтрок.Количество() = 0 Тогда
			Количество = 0;
		Иначе
			Количество = МассивСтрок[0]["Количество"];
			ТаблицаЗагрузкиИзТСД.Удалить(МассивСтрок[0]);
		КонецЕсли;
		
		СтрокаТаблицы["КоличествоФакт"]	= Количество;
		СтрокаТаблицы["СуммаФакт"]		= СтрокаТаблицы["КоличествоФакт"] * СтрокаТаблицы["Цена"];
		РассчитатьНедостачуИзлишекСервер(СтрокаТаблицы);
	КонецЦикла;
	
	// Добавляем новые строки
	Если ТаблицаЗагрузкиИзТСД.Количество() > 0 Тогда
		// Определяем ОС по штрихкодам
		ЗапросОС = Новый Запрос();
		ЗапросОС.УстановитьПараметр("ТЗ", ТаблицаЗагрузкиИзТСД);
		ЗапросОС.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ.Штрихкод		КАК Штрихкод,
		|	ТЗ.Количество	КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаЗагрузкиИзТСД
		|ИЗ
		|	&ТЗ	КАК ТЗ
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ШтрихКоды.Объект,
		|		ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка))		КАК ОсновноеСредство,
		|	ЕСТЬNULL(ШтрихКоды.ИнвентарныйНомер,
		|		ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер,
		|	ТаблицаЗагрузкиИзТСД.Штрихкод								КАК Штрихкод,
		|	ТаблицаЗагрузкиИзТСД.Количество								КАК Количество
		|ИЗ
		|	ТаблицаЗагрузкиИзТСД
		|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.ШтрихКоды	КАК ШтрихКоды
		|		ПО	ТаблицаЗагрузкиИзТСД.Штрихкод = ШтрихКоды.Штрихкод
		|;";
		ТаблицаОС = ЗапросОС.Выполнить().Выгрузить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаОС Цикл
			НоваяСтрока = Объект["Инвентаризация"].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока["КоличествоФакт"] = СтрокаТаблицы["Количество"];
			РассчитатьНедостачуИзлишекСервер(НоваяСтрока);
		КонецЦикла;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры	


&НаСервере
Процедура ВариантФормированияОписи0504087_ИзменитьВариант(НовоеЗначениеВарианта)
	
