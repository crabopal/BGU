&НаСервере
Функция ТаблицаОСдляТСД(ВозвратМассивОСБезШтрихкода = Неопределено)
	
	ВозвратМассивОСБезШтрихкода = Новый Массив;
	
	ЗапросШтрихкоды = Новый Запрос();
	ЗапросШтрихкоды.УстановитьПараметр("Инвентаризация", Объект["Инвентаризация"].Выгрузить());
	ЗапросШтрихкоды.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ОсновноеСредство	КАК ОсновноеСредство,
	|	Т.ИнвентарныйНомер	КАК ИнвентарныйНомер,
	|	Т.Цена				КАК Цена,
	|	Т.КоличествоУчет	КАК Количество
	|ПОМЕСТИТЬ
	|	Инвентаризация
	|ИЗ
	|	&Инвентаризация	КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Инвентаризация.ОсновноеСредство.Наименование	КАК ОсновноеСредство,
	|	Инвентаризация.ИнвентарныйНомер.Код				КАК ИнвентарныйНомер,
	|	Инвентаризация.Цена								КАК Цена,
	|	Инвентаризация.Количество						КАК Количество,
	|	ЕСТЬNULL(ШтрихКоды.Штрихкод, """")				КАК Штрихкод
	|ИЗ
	|	Инвентаризация	КАК Инвентаризация
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.ШтрихКоды	КАК ШтрихКоды
	|		ПО	Инвентаризация.ОсновноеСредство = ШтрихКоды.Объект
	|		И	Инвентаризация.ИнвентарныйНомер = ШтрихКоды.ИнвентарныйНомер
	|;";
	
	МассивТСД = Новый Массив();
	Выборка = ЗапросШтрихкоды.Выполнить().Выбрать();
	ИндексСтроки = -1;
	Пока Выборка.Следующий() Цикл
		ИндексСтроки = ИндексСтроки + 1;
		Объект["Инвентаризация"][ИндексСтроки]["Штрихкод"] = Выборка.Штрихкод;
		
		Если ПустаяСтрока(Выборка.Штрихкод) Тогда
			ВозвратМассивОСБезШтрихкода.Добавить(Новый Структура("Объект, ИнвентарныйНомер", 
													Выборка.ОсновноеСредство, 
													Выборка.ИнвентарныйНомер));
		Иначе
			НоваяСтрока = Новый Структура("Штрихкод, Номенклатура, Цена", 
										  Выборка.Штрихкод, 
										  СокрЛП(Выборка.ОсновноеСредство) + 
										  ?(ПустаяСтрока(Выборка.ИнвентарныйНомер), 
										  	"", 
											" инв:" + СокрЛП(Выборка.ИнвентарныйНомер)),
										  Выборка.Цена);
			МассивТСД.Добавить(НоваяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивТСД;

КонецФункции
&НаСервере
Функция АдресТаблицыДляСозданияШтрихкодов()
	
	ЗапросШтрихкоды = Новый Запрос();
	ЗапросШтрихкоды.УстановитьПараметр("ТаблицаОС", Объект["Инвентаризация"].Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер"));
	ЗапросШтрихкоды.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер
	|ПОМЕСТИТЬ
	|	ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер,
	|	ШтрихКоды.Штрихкод
	|ИЗ
	|	ТаблицаОС	КАК ТаблицаОС
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.ШтрихКоды	КАК ШтрихКоды
	|		ПО	ТаблицаОС.ОсновноеСредство = ШтрихКоды.Объект
	|		И	ТаблицаОС.ИнвентарныйНомер = ШтрихКоды.ИнвентарныйНомер";
	
	Возврат ПоместитьВоВременноеХранилище(ЗапросШтрихкоды.Выполнить().Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

