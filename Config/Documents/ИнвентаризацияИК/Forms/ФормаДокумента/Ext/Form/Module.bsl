	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок) Экспорт
	
	СвязиПараметровВыбора = Новый Структура("Дата, Организация, ИФО");
	ЗаполнитьЗначенияСвойств(СвязиПараметровВыбора, Объект);
	
	СвязиПараметровВыбора.Вставить("СчетГруппа", Объект["Счет"]);
	
	ЗначенияЗаполнения = Новый Структура();
	
	НеиспользуемыеПоля = Новый Массив();
	
	ПараметрыФормы = Новый Структура();
	
	Если ИмяТабличнойЧасти = "Инвентаризация" Тогда
		
		ЗначенияЗаполнения.Вставить("Счет", Объект["Счет"]);
		
		Если Объект["ВариантФормированияОписи"] = 1 Тогда
			// 1. Опись с 2018 г. Счет в таблице (26 знаков)
			
			ЗначенияЗаполнения.Вставить("КПС", Объект["КПС"]);
		Иначе
			// 2. Опись с 2018 г. Счет в таблице (5 знаков)
			// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
			
			НеиспользуемыеПоля.Добавить("КПС");
			НеиспользуемыеПоля.Добавить("КФО");
		КонецЕсли;
		
	ИначеЕсли ИмяТабличнойЧасти = "Излишки" ИЛИ ИмяТабличнойЧасти = "Недостачи" Тогда
		
		ЗначенияЗаполнения.Вставить("ИФО", Объект["ИФО"]);
		ЗначенияЗаполнения.Вставить("КПС", Объект["КПС"]);
		
		Если НастройкиДляРаботы["ЕстьСубконтоЦМО"] Тогда
			ЗначенияЗаполнения.Вставить("ЦМО", Объект["ЦМО"]);
		Иначе
			НеиспользуемыеПоля.Добавить("ЦМО");
		КонецЕсли;
		
		НеиспользуемыеПоля.Добавить("Счет");
		НеиспользуемыеПоля.Добавить("КФО");
		НеиспользуемыеПоля.Добавить("КЭК");
		
		Если ИмяТабличнойЧасти = "Излишки" Тогда
			
			СписокВыбора = ВидыДокументовИзлишки;
			
			ВидДокументаПоУмолчанию = ВидДокументаПоУмолчаниюИзлишки;
			
		ИначеЕсли ИмяТабличнойЧасти = "Недостачи" Тогда
			
			СписокВыбора = ВидыДокументовНедостачи;
			
			ВидДокументаПоУмолчанию = ВидДокументаПоУмолчаниюНедостачи
			
		КонецЕсли;
		
		ЗначенияЗаполнения.Вставить("ВидДокумента", ВидДокументаПоУмолчанию);
		
		ПараметрыФормы.Вставить("СписокВыбораВидДокумента", СписокВыбора);
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("НеиспользуемыеПоля",		НеиспользуемыеПоля);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = ПараметрыОповещения["ИмяТабличнойЧасти"];
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	Если ИмяТабличнойЧасти = "Инвентаризация" Тогда
		
		ИзмененаЦена = РезультатВыбора.Свойство("Цена");
		
		ИзмененоКоличествоНеСоответствует = РезультатВыбора.Свойство("КоличествоНеСоответствует");
		
		ЭлементЦены = Элементы["ИнвентаризацияЦена"];
		
		Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
			СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
			
			Если ИзмененаЦена Тогда
				РассчитатьЦенуСумму(СтрокаТаблицы, ЭлементЦены);
			КонецЕсли;
			
			Если ИзмененаЦена ИЛИ ИзмененоКоличествоНеСоответствует Тогда
				РассчитатьНедостачуИзлишек(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ИмяТабличнойЧасти = "Недостачи" ИЛИ ИмяТабличнойЧасти = "Излишки" Тогда
		
		Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
			СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
		КонецЦикла;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура КэшироватьСвойстваСчетаУчетаСервер()
	
	ВремСтруктура = Новый Структура("
		|ДатаНачалаДействия,
		|ДатаОкончанияДействия");
	
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		
		ВремСтруктура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Счет, "ДатаНачалаДействия,ДатаОкончанияДействия");
		
	КонецЕсли;
	
	КэшСвойстваСчетаУчета = Новый ФиксированнаяСтруктура(ВремСтруктура);
	
КонецПроцедуры

#Область РазбивкаСтрокиИнвентаризацииНФА

&НаКлиенте
Процедура ПослеРазбивкиСтрокиИнвентаризацииНфа(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Элементы.ИнвентаризацияСуммаФакт;
	
	ИндексыСтрок = РезультатВыбора;
	
	Для Каждого ИндексСтроки Из ИндексыСтрок Цикл
		СтрокаТаблицы = Объект.Инвентаризация[ИндексСтроки];
		
		РассчитатьЦенуСумму(СтрокаТаблицы, Элемент);
		
		РассчитатьНедостачуИзлишек(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры	

