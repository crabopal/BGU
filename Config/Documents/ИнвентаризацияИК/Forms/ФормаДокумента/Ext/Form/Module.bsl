&НаСервере
Процедура РассчитатьНедостачуИзлишекСервер(ТекДанные)
	
	Если Объект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г. Счет в шапке
		
		ДельтаКоличество	= ТекДанные["КоличествоУчет"]	- ТекДанные["КоличествоФакт"];
		ДельтаСумма			= ТекДанные["СуммаУчет"]		- ТекДанные["СуммаФакт"];
		
		ТекДанные["НедостачаСумма"]			= ?(ДельтаСумма>0, ДельтаСумма, 0);
		ТекДанные["НедостачаКоличество"]	= ?(ДельтаКоличество>0, ДельтаКоличество, 0);
		ТекДанные["ИзлишекСумма"]			= ?(ДельтаСумма<0, -ДельтаСумма, 0);
		ТекДанные["ИзлишекКоличество"]		= ?(ДельтаКоличество<0, -ДельтаКоличество, 0);
	
	Иначе
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		ИнвентаризацияСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(ЭтаФорма, ТекДанные);
		
	КонецЕсли;
	
КонецПроцедуры

