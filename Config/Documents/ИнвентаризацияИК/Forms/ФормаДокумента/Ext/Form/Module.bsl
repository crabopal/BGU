&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент()
	
	ЗаполнитьПоДаннымУчетаСервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["Инвентаризация"].Количество() = 0 Тогда
		ТекстВидНФА = ?(НастройкиДляРаботы["УказанСчетОС"],
			НСтр("ru='основных средств'"),
			НСтр("ru='материалов'"));
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Остатки %1, соответствующие условиям поиска, отсутствуют'"), ТекстВидНФА);
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
