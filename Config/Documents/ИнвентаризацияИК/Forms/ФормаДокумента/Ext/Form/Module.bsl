&НаКлиенте
Процедура ПроверитьИВыгрузитьВТСД()
	
	#Если ВебКлиент Тогда
	ТекстСообщения = НСтр("ru='Работа с торговым оборудованием не поддерживается в режиме веб-клиента.
		|Для использования терминала сбора данных запустите программу в режиме тонкого клиента.'");
	ПоказатьПредупреждение(, ТекстСообщения, 15, ТекстЗаголовкаСообщений);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Объекты не выгружены в ТСД'"));
	Возврат;
	#КонецЕсли
	
	ОСБезШтрихкода = Неопределено;
	ТаблицаТСД = ТаблицаОСдляТСД(ОСБезШтрихкода);
	
	Если ОСБезШтрихкода.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Обнаружены объекты без штрихкода.
			|Объекты без штрихкода не будут выгружены в ТСД.
			|
			|Открыть форму формирования штрихкода для данных объектов?'");
		Кнопки = Новый СписокЗначений();									
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Открыть форму формирования штрихкода'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Выгрузить в ТСД объекты со штрихкодом'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИВыгрузитьВТСД_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, Кнопки, 15, , ТекстЗаголовкаСообщений, КодВозвратаДиалога.Отмена);
	Иначе
		ВыгрузитьВТСД_ВыполнитьВыгрузку();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИВыгрузитьВТСД_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Открыть форму формирования штрихкода
		
		// после закрытия перезаполнить таблицу ТСД
		ПараметрыФормы = Новый Структура("МассивОбъектов", АдресТаблицыДляСозданияШтрихкодов());
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьВТСД_ВыполнитьВыгрузку", ЭтотОбъект);
		ОткрытьФорму("РегистрСведений.ШтрихКоды.Форма.ФормаСозданияШтрихкодовОС", ПараметрыФормы, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Выгрузить в ТСД объекты со штрихкодом
		
		ВыгрузитьВТСД_ВыполнитьВыгрузку();
	Иначе
		// Отмена
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Объекты не выгружены'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВТСД_ВыполнитьВыгрузку(Результат = Неопределено, ПараметрыОповещения = Неопределено) Экспорт
	
	ТаблицаТСД = ТаблицаОСдляТСД();
	
	Если ТаблицаТСД.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Нет объектов для выгрузки в ТСД'");
		ПоказатьПредупреждение(, ТекстСообщения, 15, ТекстЗаголовкаСообщений);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Объекты не выгружены'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВТСД_ПослеВыгрузки", ЭтотОбъект);
	ПараметрыОперации = ОборудованиеТерминалыСбораДанныхКлиентСервер.ПараметрыВыгрузкиВТСД();
    ПараметрыОперации.ТаблицаТоваров = ТаблицаТСД;
	ОборудованиеТерминалыСбораДанныхКлиент.НачатьВыгрузкуДанныеВТСД(Оповещение, УникальныйИдентификатор, , ПараметрыОперации);
	
КонецПроцедуры
