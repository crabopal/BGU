&НаКлиенте
Процедура РассчитатьЦенуСумму(ТекДанные, Элемент)
	
	ИмяЭлемента	= Элемент.Имя;
	
	Если Объект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г. Счет в шапке
		
		РассчитатьЦенуСумму_Инвентаризация_Вариант0(ТекДанные, ИмяЭлемента);
	Иначе
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		РассчитатьЦенуСумму_Инвентаризация_Вариант123(ТекДанные, ИмяЭлемента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦенуСумму_Инвентаризация_Вариант0(ТекДанные, ИмяЭлемента)
	
	Если ИмяЭлемента = "ИнвентаризацияЦена" Тогда
		ТекДанные["СуммаФакт"] = ТекДанные["КоличествоФакт"] * ТекДанные["Цена"];
		ТекДанные["СуммаУчет"] = ТекДанные["КоличествоУчет"] * ТекДанные["Цена"];
		
	ИначеЕсли ИмяЭлемента = "ИнвентаризацияКоличествоФакт" Тогда
		ТекДанные["СуммаФакт"] = ТекДанные["КоличествоФакт"] * ТекДанные["Цена"];
		
	ИначеЕсли ИмяЭлемента = "ИнвентаризацияКоличествоУчет" Тогда
		ТекДанные["СуммаУчет"] = ТекДанные["КоличествоУчет"] * ТекДанные["Цена"];
		
	ИначеЕсли ИмяЭлемента = "ИнвентаризацияСуммаФакт" Тогда
		// Новое значение цены
		Если ТекДанные["КоличествоФакт"] = 0 Тогда
			ТекДанные["Цена"] = 0;
		Иначе
			ТекДанные["Цена"] = ТекДанные["СуммаФакт"] / ТекДанные["КоличествоФакт"];
		КонецЕсли;
		
		// Пересчет смежной суммы по новой цене
		Если ТекДанные["КоличествоФакт"] = ТекДанные["КоличествоУчет"] Тогда
			ТекДанные["СуммаУчет"] = ТекДанные["СуммаФакт"];
		Иначе
			ТекДанные["СуммаУчет"] = ТекДанные["КоличествоУчет"] * ТекДанные["Цена"];;
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ИнвентаризацияСуммаУчет" Тогда
		// Новое значение цены
		Если ТекДанные["КоличествоУчет"] = 0 Тогда
			ТекДанные["Цена"] = 0;
		Иначе
			ТекДанные["Цена"] = ТекДанные["СуммаУчет"] / ТекДанные["КоличествоУчет"];
		КонецЕсли;
		
		// Пересчет смежной суммы по новой цене
		Если ТекДанные["КоличествоФакт"] = ТекДанные["КоличествоУчет"] Тогда
			ТекДанные["СуммаФакт"] = ТекДанные["СуммаУчет"];
		Иначе
			ТекДанные["СуммаФакт"] = ТекДанные["КоличествоФакт"] * ТекДанные["Цена"];
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦенуСумму_Инвентаризация_Вариант123(ТекущиеДанные, ИмяЭлемента)
	
	ИмяИзмененногоПоля = Сред(ИмяЭлемента, 15); // Длина("Инвентаризация")=14
	
	ИнвентаризацияКлиент.Редактирование0504087_РассчитатьФактическиеПоказатели(ЭтаФорма, ТекущиеДанные, ИмяИзмененногоПоля);
	
