КонецПроцедуры

&НаКлиенте
Процедура НадписьВсегоДокументовНажатие(Элемент)
	
	Если НастройкиДляРаботы["УказанСчетОС"] Тогда
		ДополнительныйПараметр = "ОС";
	ИначеЕсли НастройкиДляРаботы["УказанСчетМЗ"] Тогда
		ДополнительныйПараметр = "МЗ";
	Иначе
		ДополнительныйПараметр = Неопределено;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДокументОснованиеСсылка",	Объект["Ссылка"]);
	ПараметрыФормы.Вставить("ДополнительныйПараметр",	ДополнительныйПараметр);
	
	ОткрытьФорму("ОбщаяФорма.СписокДокументовВведенныхНаОсновании", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ВариантФормированияОписиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущееЗначениеВарианта = Объект["ВариантФормированияОписи"];
	
	НовоеЗначениеВарианта = ВыбранноеЗначение;
	
	БудутОчищеныКолонки = ИнвентаризацияКлиент.Редактирование0504087_БудутОчищеныКолонкиПриИзмененииВариантаФормированияОписи(
		ТекущееЗначениеВарианта,
		НовоеЗначениеВарианта);
	
	Если БудутОчищеныКолонки И Объект.Инвентаризация.Количество() > 0 Тогда
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("НовоеЗначениеВарианта", НовоеЗначениеВарианта);
		
		ТекстСообщения = НСтр("ru='Изменение варианта формирования описи вызовет очистку
			|некоторых колонок таблицы.
			|
			|Продолжить и сменить вариант формирования описи?'");
		ОписаниеОповещенияОтвет = Новый ОписаниеОповещения("ВариантФормированияОписиОбработкаВыбора_Ответ", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОтвет, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ВариантФормированияОписи0504087_ИзменитьВариант(НовоеЗначениеВарианта);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантФормированияОписиОбработкаВыбора_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		НовоеЗначениеВарианта = ПараметрыОповещения["НовоеЗначениеВарианта"];
		
		ВариантФормированияОписи0504087_ИзменитьВариант(НовоеЗначениеВарианта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИнвентаризацииПриИзменении(Элемент)
	
	Если ИнвентаризацияКлиент.СчетДействуетНаДату(КэшСвойстваСчетаУчета, Объект.ДатаИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Счет = Неопределено;
	
	КэшироватьСвойстваСчетаУчетаСервер();
	
КонецПроцедуры

