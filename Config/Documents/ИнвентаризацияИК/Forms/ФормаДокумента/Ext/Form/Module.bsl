	ТекстСообщения = НСтр("ru='Работа с торговым оборудованием не поддерживается в режиме веб-клиента.
		|Для использования терминала сбора данных запустите программу в режиме тонкого клиента.'");
	ПоказатьПредупреждение(, ТекстСообщения, 15, ТекстЗаголовкаСообщений);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Объекты не загружены из ТСД'"));
	Возврат;
	#КонецЕсли
	
	ТекстСообщения = НСтр("ru='Загрузить данные о фактическом количестве
		|из терминала сбора данных (ТСД)?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗагрузитьИзТСД_Выбор", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
