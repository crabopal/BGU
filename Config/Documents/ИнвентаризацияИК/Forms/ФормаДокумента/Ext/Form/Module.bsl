&НаСервере
Процедура ИнициализацияФормы()
	
	ИнвентаризацияСервер.ВариантФормированияОписи0504087_ИнициализироватьФорму(ЭтаФорма);
	
	НастроитьФормуСервер_ПоСчету();
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияИК.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	ОпределитьКоличествоДокументовВведенныхНаОсновании();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Таблица "Инвентаризация" - запрет редактирования колонок "По учету"
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Инвентаризация"" - запрет редактирования колонок ""По учету""'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РазрешитьРедактированиеПоУчету");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвентаризацияКоличествоУчет");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвентаризацияСуммаУчет");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Инвентаризация194нКоличествоУчет");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Инвентаризация194нСуммаУчет");

	
	//---
	// 2. Таблица "Инвентаризация" - текст "кол-во" для надписи
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Инвентаризация"" - текст ""кол-во"" для надписи'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Ложь;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "кол-во");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвентаризацияНадписьКоличество");


	//---
	// 3. Таблица "Инвентаризация" - текст "сумма" для надписи
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Инвентаризация"" - текст ""сумма"" для надписи'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Ложь;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "сумма");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвентаризацияНадписьСумма");

	
	ТаблицаВидыДокументов = Документы.ИнвентаризацияИК.ПолучитьТаблицуВидыДокументов();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВидыДокументов	Цикл
		//---
		// Таблица "Недостачи"
		//---
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Таблица ""Недостачи"" - представление колонки ВидДокумента при значении " + СтрокаТаблицы["Наименование"];
		// Условие:
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Недостачи.ВидДокумента");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = СтрокаТаблицы["Наименование"];
		// Оформление:
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", СтрокаТаблицы["Синоним"]);
		// Оформляемые поля:
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("НедостачиВидДокумента");
		
		//---
		// Таблица "Излишки"
		//---
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Таблица ""Излишки"" - представление колонки ВидДокумента при значении " + СтрокаТаблицы["Наименование"];
		// Условие:
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Излишки.ВидДокумента");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = СтрокаТаблицы["Наименование"];
		// Оформление:
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", СтрокаТаблицы["Синоним"]);
		// Оформляемые поля:
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИзлишкиВидДокумента");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТекстОтборЦМО(ЦМО, ЕстьСубконтоЦМО)
	
	Если ЕстьСубконтоЦМО И ЗначениеЗаполнено(ЦМО) Тогда
		Если ТипЗнч(ЦМО) = Тип("СправочникСсылка.Сотрудники") Тогда
			Результат = НСтр("ru='отбор по Сотруднику'");
		ИначеЕсли ТипЗнч(ЦМО) = Тип("СправочникСсылка.ЦМО") Тогда
			Результат = НСтр("ru='отбор по ЦМО'");
		КонецЕсли;
	Иначе
		Результат = НСтр("ru='без отбора'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыОС(Знач Организация, Знач ОсновноеСредство, Знач ЦМО, Знач ДатаДок)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И СчетУчета В (&Счет)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ЦМО = &ЦМО
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки";
	
	Если ЦМО = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЦМО = &ЦМО", "ИСТИНА");
	ИначеЕсли ТипЗнч(ЦМО) = Тип("СправочникСсылка.Сотрудники") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЦМО = &ЦМО", "ЦМО.Сотрудник = &ЦМО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период"				, ДатаДок);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("ЦМО"					, ЦМО);
	Запрос.УстановитьПараметр("Счет"				, БухгалтерскийУчет.СписокСчетов("108.00"));
	
	Результат = Новый Структура("Счет,ИнвентарныйНомер");
	
	Данные = Запрос.ВыполнитьПакет();
	
	Выборка = Данные[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Счет = Выборка.СчетУчета;
	КонецЕсли;
	
	Выборка = Данные[1].Выбрать();
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		Результат.ИнвентарныйНомер = Выборка.ИнвентарныйНомер;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьСчетПриИзменении()
	
	Если НЕ Объект["Счет"] = СчетПрежнееЗначение Тогда
		// Счет был изменен
		
		Если (Объект["Инвентаризация"].Количество() > 0
			ИЛИ	Объект["Недостачи"].Количество() > 0
			ИЛИ	Объект["Излишки"].Количество() > 0) Тогда
			// Уточним желание сменить счет
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Изменение счета учета вызовет очистку таблиц
					|""%1"", ""Недостачи"" и ""Излишки""
					|
					|Продолжить и сменить счет учета?'"),
				ЗаголовокСтраницыИнвентаризация);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьСчетПриИзменении_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			СчетПриИзмененииКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьСчетПриИзменении_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СчетПриИзмененииКлиент();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Восстанавливаем прежнее значение счета
		Объект["Счет"] = СчетПрежнееЗначение;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СчетПриИзмененииКлиент()
	
	Объект["Инвентаризация"].Очистить();
	Объект["Недостачи"].Очистить();
	Объект["Излишки"].Очистить();
	Объект["Остатки"].Очистить();
	Объект["ПорядокСписания"].Очистить();
	
	НастроитьФормуСервер_ПоСчету();
	
	СчетПрежнееЗначение = Объект["Счет"];
	
КонецПроцедуры
&НаСервере
Процедура НастроитьФормуСервер_ПоСчету()
	
	// Кэшируем применяемые настройки
	НастройкиДляРаботы = Новый ФиксированнаяСтруктура(Документы.ИнвентаризацияИК.ПолучитьНастройкиДляРаботы(Объект));
	
	КэшироватьСвойстваСчетаУчетаСервер();
	
	УказанСчетОС = НастройкиДляРаботы["УказанСчетОС"];
	УказанСчетМЗ = НастройкиДляРаботы["УказанСчетМЗ"];
	
	Если УказанСчетОС Тогда
		ЗаголовокСтраницыИнвентаризация = НСтр("ru='Основные средства'");
		ФорматПолейКоличество = "ЧДЦ=0;";
		
		ПоискВидовДокументов = Новый Структура("УказанСчетОС", Истина);
	Иначе
		ЗаголовокСтраницыИнвентаризация = НСтр("ru='Материалы'");
		ФорматПолейКоличество = "ЧДЦ=3;";
		
		ПоискВидовДокументов = Новый Структура("УказанСчетМЗ", Истина);
	КонецЕсли;
	
	// Списки видов документов
	ВидыДокументов = Документы.ИнвентаризацияИК.ПолучитьСпискиВидыДокументов(Объект);
	ВидыДокументовНедостачи				= ВидыДокументов["Недостачи"];
	ВидыДокументовИзлишки				= ВидыДокументов["Излишки"];
	ВидДокументаПоУмолчаниюНедостачи	= ВидыДокументов["ВидДокументаПоУмолчаниюНедостачи"];
	ВидДокументаПоУмолчаниюИзлишки		= ВидыДокументов["ВидДокументаПоУмолчаниюИзлишки"];
	Элементы["НедостачиВидДокумента"].СписокВыбора.Очистить();
	Для Каждого Элем Из ВидыДокументовНедостачи Цикл
		Элементы["НедостачиВидДокумента"].СписокВыбора.Добавить(Элем.Значение, Элем.Представление);
	КонецЦикла;
	Элементы["ИзлишкиВидДокумента"].СписокВыбора.Очистить();
	Для Каждого Элем Из ВидыДокументовИзлишки Цикл
		Элементы["ИзлишкиВидДокумента"].СписокВыбора.Добавить(Элем.Значение, Элем.Представление);
	КонецЦикла;
	
	// Колонки таблиц
	Элементы["ИнвентаризацияКоличествоФакт"].Формат			= ФорматПолейКоличество;
	Элементы["ИнвентаризацияКоличествоУчет"].Формат			= ФорматПолейКоличество;
	Элементы["ИнвентаризацияНедостачаКоличество"].Формат	= ФорматПолейКоличество;
	Элементы["ИнвентаризацияИзлишекКоличество"].Формат		= ФорматПолейКоличество;
	Элементы["НедостачиКоличество"].Формат					= ФорматПолейКоличество;
	Элементы["ИзлишкиКоличество"].Формат					= ФорматПолейКоличество;
	Элементы["ИнвентаризацияОсновноеСредство"].Видимость	= УказанСчетОС;
	Элементы["НедостачиОсновноеСредство"].Видимость			= УказанСчетОС;
	Элементы["ИзлишкиОсновноеСредство"].Видимость			= УказанСчетОС;
	Элементы["ИнвентаризацияПолеГрупповойУчет"].Видимость	= УказанСчетОС;
	Элементы["НедостачиПолеГрупповойУчет"].Видимость		= УказанСчетОС;
	Элементы["ИзлишкиПолеГрупповойУчет"].Видимость			= УказанСчетОС;
	Элементы["ИнвентаризацияИнвентарныйНомер"].Видимость	= УказанСчетОС И НастройкиДляРаботы["УчетПоАналитике"];
	Элементы["НедостачиИнвентарныйНомер"].Видимость			= УказанСчетОС И НастройкиДляРаботы["УчетПоАналитике"];
	Элементы["ИзлишкиИнвентарныйНомер"].Видимость			= УказанСчетОС И НастройкиДляРаботы["УчетПоАналитике"];
	Элементы["ИнвентаризацияНоменклатура"].Видимость		= УказанСчетМЗ;
	Элементы["НедостачиНоменклатура"].Видимость				= УказанСчетМЗ;
	Элементы["ИзлишкиНоменклатура"].Видимость				= УказанСчетМЗ;
	Элементы["ИнвентаризацияЕдИзм"].Видимость				= УказанСчетМЗ;
	Элементы["НедостачиЕдИзм"].Видимость					= УказанСчетМЗ;
	Элементы["ИзлишкиЕдИзм"].Видимость						= УказанСчетМЗ;
	Элементы["НедостачиЦМО"].Видимость						= НастройкиДляРаботы["ЕстьСубконтоЦМО"];
	Элементы["ИзлишкиЦМО"].Видимость						= НастройкиДляРаботы["ЕстьСубконтоЦМО"];
	Элементы["ПорядокСписанияЦМО"].Видимость				= НастройкиДляРаботы["ЕстьСубконтоЦМО"];
	
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСчета", Объект["Счет"]);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["ИнвентаризацияСчет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
	// Кнопки меню
	Элементы["ИзлишкиЗаполнитьИзлишки"].Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='По данным таблицы ""%1""'"),
		ЗаголовокСтраницыИнвентаризация);
	Элементы["НедостачиЗаполнитьНедостачи"].Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='По данным таблицы ""%1"" (с учетом порядка списания)'"),
		ЗаголовокСтраницыИнвентаризация);
	Элементы["ИнвентаризацияВыгрузитьВТСД"].Доступность		= УказанСчетОС;
	Элементы["ИнвентаризацияЗагрузитьИзТСД"].Доступность	= УказанСчетОС;

	// Прочие элементы
	Элементы["СтраницаИнвентаризация"].Заголовок			= ЗаголовокСтраницыИнвентаризация;
	
	УстановитьТекстПодсказкиМОЛ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстПодсказкиМОЛ(Форма)
	
	НастройкиДляРаботы		= Форма["НастройкиДляРаботы"];
	Объект					= Форма["Объект"];
	НастраиваемыйЭлемент	= Форма.Элементы["ЦМО"];
	
	ТекстПодсказки = ПолучитьТекстОтборЦМО(Объект["ЦМО"], НастройкиДляРаботы["ЕстьСубконтоЦМО"]);
	
	НастраиваемыйЭлемент.Подсказка = ТекстПодсказки;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьКоличествоДокументовВведенныхНаОсновании()
	
	// Общее количество документов
	КоличествоДокументов	= Документы.ИнвентаризацияИК.ПолучитьКоличествоДокументовВведенныхНаОсновании(Объект);
	КоличествоСписаний		= КоличествоДокументов["КоличествоСписаний"];
	КоличествоПоступлений	= КоличествоДокументов["КоличествоПоступлений"];
	
	// Надпись общее количество документов
	ТекстНадписи= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 шт'"),
		КоличествоПоступлений + КоличествоСписаний);
	Элементы["НадписьВсегоДокументов"].Заголовок = ТекстНадписи;
	
	// Категории для русского языка:
	//	Ноль	(-);
	//	Один	(1 шт);
	//	Два		(-);
	//	Немного	(2 шт);
	//	Много	(5 шт);
	//	Другое	(-)
	
	// Надпись Х списаний
	НадписьСписания = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 списание;;%1 списания;%1 списаний;'"),
		КоличествоСписаний);
		
	// Надпись У поступлений
	НадписьПоступления = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 поступление;;%1 поступления;%1 поступлений;'"),
		КоличествоПоступлений);
		
	// Надпись количество документов списаний и поступлений
	ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='(%1, %2)'"),
		НадписьСписания,
		НадписьПоступления);
	Элементы["НадписьВсегоДокументовКон"].Заголовок = ТекстНадписи;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ТекстСообщения = НСтр("ru='Изменение организации вызовет полную очистку
		|табличных частей документа.
		|
		|Продолжить и сменить организацию?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

