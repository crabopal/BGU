&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	ПараметрыФормы = ИнвентаризацияКлиент.ПараметрыФормыРазбивкиСтрокиИнвентаризацииНфа();
	
	ПараметрыФормы.ИмяТабличнойЧасти = "Инвентаризация";
	ПараметрыФормы.ТочностьКоличества = ?(НастройкиДляРаботы.УказанСчетМЗ, 3, 0);
	ПараметрыФормы.ТочностьЦены = 5;
	
	ПараметрыФормы.СоответствиеИмен.КоличествоФакт	= "КоличествоФакт";
	ПараметрыФормы.СоответствиеИмен.СуммаФакт		= "СуммаФакт";
	ПараметрыФормы.СоответствиеИмен.КоличествоУчет	= "КоличествоУчет";
	ПараметрыФормы.СоответствиеИмен.СуммаУчет		= "СуммаУчет";
	
	ИнвентаризацияКлиент.ОткрытьФормуРазбивкиСтрокиИнвентаризацииНфа(ЭтаФорма, Элементы.Инвентаризация.ТекущиеДанные, ПараметрыФормы);
	
