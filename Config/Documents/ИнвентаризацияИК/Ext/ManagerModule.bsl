Функция ПолучитьТаблицуРасхождений(ДокументОбъект, ЭтоНедостача, УказанСчетОС)
	
	ТаблицаРезультат = ДокументОбъект["Инвентаризация"].Выгрузить().СкопироватьКолонки();
	
	// Заполняем таблицу
	Для Каждого СтрокаТЧ Из ДокументОбъект["Инвентаризация"] Цикл
		СтрокаСодержитРасхождения = ?(ЭтоНедостача,
			СтрокаТЧ["НедостачаКоличество"] > 0 ИЛИ СтрокаТЧ["НедостачаСумма"] > 0,
			СтрокаТЧ["ИзлишекКоличество"] > 0 ИЛИ СтрокаТЧ["ИзлишекСумма"] > 0);
		Если СтрокаСодержитРасхождения Тогда
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;
	
	// Переименовываем колонки
	Если УказанСчетОС Тогда
		ИмяКолонкиНФА			= "ОсновноеСредство";
	Иначе
		ИмяКолонкиНФА			= "Номенклатура";
	КонецЕсли;
	Если ЭтоНедостача Тогда
		ИмяКолонкиКоличество	= "НедостачаКоличество";
		ИмяКолонкиСумма			= "НедостачаСумма";
	Иначе
		ИмяКолонкиКоличество	= "ИзлишекКоличество";
		ИмяКолонкиСумма			= "ИзлишекСумма";
	КонецЕсли;
	ТаблицаРезультат.Колонки.Найти(ИмяКолонкиНФА).Имя			= "НФА";
	ТаблицаРезультат.Колонки.Найти(ИмяКолонкиКоличество).Имя	= "Количество";
	ТаблицаРезультат.Колонки.Найти(ИмяКолонкиСумма).Имя			= "Сумма";
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура ЗаполнитьИнвентаризационнуюКомиссию(ДокОбъектНовый)
	
	// Настраиваем запрос
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ДокСсылка", ДокОбъектНовый["ДокументОснование"]);
	ЗапросВыборка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Председатель комиссии, прочие сведения о ней.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
	|	ФамилияПредседателяКомиссии		КАК ФамилияПредседателяКомиссии,
	|	ИмяПредседателяКомиссии			КАК ИмяПредседателяКомиссии,
	|	ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
	|	ДатаПриказаКомиссии				КАК ДатаПриказа,
	|	НомерПриказаКомиссии			КАК НомерПриказа
	|ИЗ
	|	Документ.ИнвентаризацияИК
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица ""Состав комиссии"".
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ФамилияЧленаКомиссии	КАК ФамилияЧленаКомиссии,
	|	ИмяЧленаКомиссии		КАК ИмяЧленаКомиссии,
	|	ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияИК.СоставКомиссии
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;";
	
	РезультатыВыборки = ЗапросВыборка.ВыполнитьПакет();
	
	// Шапка
	Выборка = РезультатыВыборки[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		// В выборке всего 0 или 1 запись
		ЗаполнитьЗначенияСвойств(ДокОбъектНовый, Выборка);
	КонецЦикла;
	
	// Табл.часть
	СоставКомиссии = РезультатыВыборки[1].Выгрузить();
	ДокОбъектНовый["СоставКомиссии"].Загрузить(СоставКомиссии);
	
КонецПроцедуры

Функция ПолучитьДатуОпределенияОстатков(Документ)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "ДатаСписанияСБухУчета") Тогда
		Значение = ?(ЗначениеЗаполнено(Документ.ДатаСписанияСБухУчета), 
			КонецДня(Документ.ДатаСписанияСБухУчета), 
			КонецДня(Документ.Дата));
	Иначе
		Значение = КонецДня(Документ.Дата);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

