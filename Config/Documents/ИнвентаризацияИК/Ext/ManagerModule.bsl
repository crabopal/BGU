			|			Остатки.КПС
			|		ИНАЧЕ
			|			ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
			|			Остатки.ИФО
			|		ИНАЧЕ
			|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР 
			|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
			|			Подразделение
			|		ИНАЧЕ
			|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто1) = ТИП(Справочник.Номенклатура) ТОГДА
			|			ВЫРАЗИТЬ(Остатки.Субконто1	КАК Справочник.Номенклатура)
			|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто2) = ТИП(Справочник.Номенклатура) ТОГДА
			|			ВЫРАЗИТЬ(Остатки.Субконто2	КАК Справочник.Номенклатура)
			|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто3) = ТИП(Справочник.Номенклатура) ТОГДА
			|			ВЫРАЗИТЬ(Остатки.Субконто3	КАК Справочник.Номенклатура)
			|		ИНАЧЕ
			|			ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
			|	КОНЕЦ
			|ИМЕЮЩИЕ
			|	НЕ СУММА(Остатки.КоличествоРазвернутыйОстатокДт - Остатки.КоличествоРазвернутыйОстатокКт) = 0
			|ИНДЕКСИРОВАТЬ ПО
			|	Счет,
			|	КПС,
			|	ИФО,
			|	Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|// [3]. (Подготовка) Получение сумм остатков номенклатуры (""балансовая стоимость"")
			|//		уже по выбранным ЦМО.
			|//
			|ВЫБРАТЬ
			|	ПоВсем.Счет								КАК Счет,
			|	ПоВсем.КПС								КАК КПС,
			|	ПоВсем.ИФО								КАК ИФО,
			|	ПоВсем.Подразделение					КАК Подразделение,
			|	ПоВсем.Номенклатура						КАК Номенклатура,
			|	ПоВыбранным.ЦМО							КАК ЦМО,
			|	СУММА(ПоВыбранным.Количество)			КАК Количество,
			|	// ""Балансовая стоимость"":
			|	СУММА(ВЫБОР
			|		КОГДА ПоВсем.Количество = 0 ТОГДА
			|			0
			|		ИНАЧЕ
			|			ПоВсем.Сумма * ПоВыбранным.Количество / ПоВсем.Количество
			|	КОНЕЦ)									КАК Сумма
			|ПОМЕСТИТЬ
			|	ОстаткиПоВыбраннымЦМОиСуммы
			|ИЗ
			|	ОстаткиПоВсемЦМО	КАК ПоВсем
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ОстаткиПоВыбраннымЦМО	КАК ПоВыбранным
			|		ПО	ПоВсем.Счет = ПоВыбранным.Счет
			|		И	ПоВсем.КПС = ПоВыбранным.КПС
			|		И	ПоВсем.ИФО = ПоВыбранным.ИФО
			|		И	ПоВсем.Номенклатура = ПоВыбранным.Номенклатура
			|СГРУППИРОВАТЬ ПО
			|	ПоВсем.Счет,
			|	ПоВсем.КПС,
			|	ПоВсем.ИФО,
			|	ПоВсем.Подразделение,
			|	ПоВсем.Номенклатура,
			|	ПоВыбранным.ЦМО
			|ИМЕЮЩИЕ
			|	НЕ (СУММА(ПоВыбранным.Количество) = 0)
			|;
			|"
			
			+ ТекстЗапросаБлижайшиеОбщиеРодителиСчетов
			
			+ "
			|////////////////////////////////////////////////////////////////////////////////
			|// [4]. Заполнение таблицы ""Инвентаризация"" по данным учета.
			|//		Поле ""Цена"" рассчитывается из ""балансовой стоимости"" и количества.
			|//		(Финальная таблица)
			|ВЫБРАТЬ
			|	Номенклатура								КАК Номенклатура,
			|	Количество									КАК КоличествоУчет,
			|	ВЫБОР
			|		" + ПолеВыборЦены + "
			|		КОГДА Количество = 0 ТОГДА
			|			0
			|		ИНАЧЕ
			|			Сумма / Количество
			|	КОНЕЦ										КАК Цена,
			|	Сумма										КАК СуммаУчет,"
			
			+ ВыборПолейСчета
			
			+ "
			|		
			|	// Недостача:
			|	ВЫБОР
			|		КОГДА Количество > 0 ТОГДА
			|			Количество
			|		ИНАЧЕ
			|			0
			|	КОНЕЦ										КАК НедостачаКоличество,
			|	ВЫБОР
			|		КОГДА Сумма > 0 ТОГДА
			|			Сумма
			|		ИНАЧЕ
			|			0
			|	КОНЕЦ										КАК НедостачаСумма,
			|	
			|	// Излишек:
			|	ВЫБОР
			|		КОГДА Количество < 0 ТОГДА
			|			-Количество
			|		ИНАЧЕ
			|			0
			|	КОНЕЦ										КАК ИзлишекКоличество,
			|	ВЫБОР
			|		КОГДА Сумма < 0 ТОГДА
			|			-Сумма
			|		ИНАЧЕ
			|			0
			|	КОНЕЦ										КАК ИзлишекСумма
			|ИЗ
			|	(ВЫБРАТЬ
			|		Т.Номенклатура		КАК Номенклатура,"
			
			+ ВыборПолейСчетаОстаткиСвернутые
			
			+ "
			|		СУММА(Т.Количество)	КАК Количество,
			|		СУММА(Т.Сумма)		КАК Сумма
			|	ИЗ
			|		ОстаткиПоВыбраннымЦМОиСуммы	КАК Т" + СоединениеСТаблицейСчетовБлижайшихРодителей + "
			|	СГРУППИРОВАТЬ ПО
			|		Т.Номенклатура"
			
			+ ГруппировкаПолейСчетаОстаткиСвернутые
			
			+ "
			|	)	КАК СвернутыеОстаткиПоВыбраннымЦМОиСуммы
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура.Наименование
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|// [5]. Заполнение таблицы ""Остатки"" по данным учета (балансовая стоимость)
			|//		(Финальная таблица)
			|//
			|ВЫБРАТЬ
			|	Номенклатура		КАК НФА,
			|	Счет				КАК Счет,
			|	ИФО					КАК ИФО,
			|	КПС					КАК КПС,
			|	ЦМО					КАК ЦМО,
			|	Подразделение		КАК Подразделение,
			|	СУММА(Количество)	КАК Количество,
			|	СУММА(Сумма)		КАК Сумма
			|ИЗ
			|	ОстаткиПоВыбраннымЦМОиСуммы
			|СГРУППИРОВАТЬ ПО
			|	Номенклатура,
			|	Счет,
			|	ИФО,
			|	КПС,
			|	ЦМО,
			|	Подразделение
			|УПОРЯДОЧИТЬ ПО
			|	Сумма УБЫВ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|// [6]. Данные для табл.части ""Настройка порядка списания""
			|//		(Финальная таблица)
			|//
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ИФО,
			|	КПС,
			|	ЦМО,
			|	Подразделение
			|ИЗ
			|	ОстаткиПоВыбраннымЦМОиСуммы
			|;";

	Иначе
		// Нереальная ветка.
		Возврат;
	КонецЕсли;
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [4]. Заполнение таблицы ""Инвентаризация"" по данным учета.
	ДокументОбъект["Инвентаризация"].Загрузить(РезультатыЗаполнения[4 + СдвигИндексаВсехТаблиц].Выгрузить());
	
	// [5]. Заполнение таблицы ""Остатки"" по данным учета (балансовая стоимость)
	ДокументОбъект["Остатки"].Загрузить(РезультатыЗаполнения[5 + СдвигИндексаВсехТаблиц].Выгрузить());
	
	// [6]. Данные для табл.части ""Настройка порядка списания""
	ДокументОбъект["ПорядокСписания"].Загрузить(РезультатыЗаполнения[6 + СдвигИндексаВсехТаблиц].Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьФактическоеНаличие(ДокументОбъект) Экспорт
	
	ТаблЧасть = ДокументОбъект["Инвентаризация"];
	
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЧ["КоличествоФакт"]	= СтрокаТЧ["КоличествоУчет"];
		СтрокаТЧ["СуммаФакт"]		= СтрокаТЧ["СуммаУчет"];
		
		СтрокаТЧ["НедостачаСумма"]		= 0;
		СтрокаТЧ["НедостачаКоличество"]	= 0;
		СтрокаТЧ["ИзлишекСумма"]		= 0;
		СтрокаТЧ["ИзлишекКоличество"]	= 0;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьРасхождения(ДокументОбъект, ЭтоНедостача) Экспорт
	
	// Входная проверка
	Если ЕстьОшибкиЗаполненияТаблицыИнвентаризация(ДокументОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НастройкиДляРаботы = ПолучитьНастройкиДляРаботы(ДокументОбъект);
	Если НастройкиДляРаботы["УказанСчетОС"] Тогда
		УказанСчетОС = Истина;
		УказанСчетМЗ = Ложь;
	Иначе
		УказанСчетОС = Ложь;
		УказанСчетМЗ = Истина;
	КонецЕсли;
	
	ТаблицаОстатки		= ДокументОбъект["Остатки"].Выгрузить();
	ТаблицаРасхождения	= ПолучитьТаблицуРасхождений(ДокументОбъект, ЭтоНедостача, УказанСчетОС);
	
	Если УказанСчетОС Тогда
		ИменаКолонокСвязи = "НФА, ИнвентарныйНомер";
	Иначе
		ИменаКолонокСвязи = "НФА";
	КонецЕсли;
	ИменаКолонокПоказателей = "Количество, Сумма";
	
	Если ЭтоНедостача Тогда
		// Недостачи заполняем с учетом таблицы "Порядок списания недостач"
		
		// Упорядочиваем остатки
		КолонкиСвязи = Новый Массив();
		КолонкиСвязи.Добавить("КПС");
		КолонкиСвязи.Добавить("ЦМО");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			КолонкиСвязи.Добавить("ИФО");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
			КолонкиСвязи.Добавить("Подразделение");
		КонецЕсли;
		ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоТаблицеПорядка(ТаблицаОстатки, ДокументОбъект["ПорядокСписания"].Выгрузить(), КолонкиСвязи);
		
		// Сравниваем показатели
		РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(ТаблицаРасхождения, ТаблицаОстатки, ИменаКолонокСвязи, ИменаКолонокПоказателей, "СписанияВТаблице2ВРазмереСоответствия");
		ТаблицаРезультат = РезультатыСравнения["СписанияВТаблице2ВРазмереСоответствия"];
	Иначе
		// Излишки заполняем в произвольном порядке
		
		// Сравниваем показатели
		РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(ТаблицаРасхождения, ТаблицаОстатки, ИменаКолонокСвязи, ИменаКолонокПоказателей, "СписанияВТаблице2ВРазмереСоответствия,ОстаткиВТаблице1");
		ТаблицаРезультат = РезультатыСравнения["СписанияВТаблице2ВРазмереСоответствия"];
		ТаблицаОстаткиИзлишков = РезультатыСравнения["ОстаткиВТаблице1"];
		Для Каждого СтрокаТаблицы Из ТаблицаОстаткиИзлишков Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
	// Обратно переименовываем колонку НФА
	Если УказанСчетОС Тогда
		ИмяКолонкиНФА = "ОсновноеСредство";
	Иначе
		ИмяКолонкиНФА = "Номенклатура";
	КонецЕсли;
	ТаблицаРезультат.Колонки.Найти("НФА").Имя = ИмяКолонкиНФА;
	
	ТабличнаяЧасть = ?(ЭтоНедостача,
		ДокументОбъект["Недостачи"],
		ДокументОбъект["Излишки"]);
	ТабличнаяЧасть.Загрузить(ТаблицаРезультат);
	
	// Заполняем колонки Цена и ВидДокумента
	ВидыДокументов = ПолучитьСпискиВидыДокументов(ДокументОбъект);
	Если ЭтоНедостача Тогда
		ВидДокумента = ВидыДокументов["ВидДокументаПоУмолчаниюНедостачи"];
	Иначе
		ВидДокумента = ВидыДокументов["ВидДокументаПоУмолчаниюИзлишки"];
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		Если СтрокаТаблицы["Количество"] = 0 Тогда
			СтрокаТаблицы["Цена"] = 0;
		Иначе
			СтрокаТаблицы["Цена"] = СтрокаТаблицы["Сумма"] / СтрокаТаблицы["Количество"];
		КонецЕсли;
		СтрокаТаблицы["ВидДокумента"] = ВидДокумента;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьКоличествоДокументовВведенныхНаОсновании(ДокументОбъект) Экспорт
	
	КоличествоСписаний		= 0;
	КоличествоПоступлений	= 0;
	
	ДокСсылка = ДокументОбъект["Ссылка"];
	
	Если НЕ ДокСсылка.Пустая() Тогда
		ТаблицаВидыДокументов = ПолучитьТаблицуВидыДокументов();
		
		ТекстШаблонСписание = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)	КАК КоличествоДокументов,
		|	ИСТИНА			КАК ЭтоСписание
		|ИЗ
		|	Документ.[ВидДокумента]	КАК Док
		|ГДЕ
		|	ДокументОснование = &ДокСсылка
		|;";
		
		ТекстШаблонПоступление = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)	КАК КоличествоДокументов,
		|	ЛОЖЬ			КАК ЭтоСписание
		|ИЗ
		|	Документ.[ВидДокумента]	КАК Док
		|ГДЕ
		|	ДокументОснование = &ДокСсылка
		|;";
		
		ТекстЗапроса = "";
		
		Для Каждого СтрокаТаблицы Из ТаблицаВидыДокументов Цикл
			ВидДокумента = СтрокаТаблицы["Наименование"];
			
			Если СтрокаТаблицы["ЭтоНедостача"] Тогда
				ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ТекстШаблонСписание, "[ВидДокумента]", ВидДокумента);
			Иначе
				ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ТекстШаблонПоступление, "[ВидДокумента]", ВидДокумента);
			КонецЕсли;
		КонецЦикла;
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", ДокСсылка);
		ЗапросПоиск.Текст = ТекстЗапроса;
		
		РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
		
		Для Индекс = 0 По РезультатыПоиска.Количество() - 1 Цикл
			Выборка = РезультатыПоиска[Индекс].Выбрать();
			Выборка.Следующий();
			
			Если Выборка["ЭтоСписание"] Тогда
				КоличествоСписаний = КоличествоСписаний + Выборка["КоличествоДокументов"];
			Иначе
				КоличествоПоступлений = КоличествоПоступлений + Выборка["КоличествоДокументов"];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("КоличествоСписаний",	КоличествоСписаний);
	Результат.Вставить("КоличествоПоступлений",	КоличествоПоступлений);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСчетаУчетаМЗ() Экспорт
	
	ЗапросПоиск = Новый Запрос("
		|ВЫБРАТЬ
		|	Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто
		|ГДЕ
		|	ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		|	И Ссылка.Код ПОДОБНО ""108.5%""");
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Флажок <без ограничения>
Функция ФлажокБезОграничения_ПолучитьНастройкиМеханизма() Экспорт
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяРеквизитаСсылка",	"ИФО");
	НастройкиМеханизма.Вставить("ИмяРеквизитаФлажок",	"БезУчетаИФО");
	
	Возврат НастройкиМеханизма;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0504087 (без фактического наличия)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504087";
	КомандаПечати.Представление = НСтр("ru='Инвентаризационная опись по объектам НФА (ф. 0504087)'");
	
	// Форма 0504087 (с фактическим наличием)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504087_ФактНаличие";
	КомандаПечати.Представление = НСтр("ru='Инвентаризационная опись по объектам НФА (ф. 0504087) (факт. наличие)'");

	// Форма 0317018 (ИНВ-22)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0317018";
	КомандаПечати.Представление = НСтр("ru='ИНВ-22 (приказ)'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ИнвентаризацияСервер.РаспечататьПриНеобходимости0504087(
		"ИнвентаризацияИК",
		МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0317018") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0317018",
			"ИНВ-22 (приказ)",
			ПечатьФормыИНВ22(МассивОбъектов, ОбъектыПечати));
			
	КонецЕсли;
		
КонецПроцедуры

