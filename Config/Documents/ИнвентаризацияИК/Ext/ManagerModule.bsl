	|					 ОсновноеСредство.НаименованиеПолное
	|			КОНЕЦ
	|	КОНЕЦ										КАК НаименованиеНФА,
	|	ВЫБОР
	|		КОГДА Ссылка.Счет В(&СчетМЗ) ТОГДА
	|			// Указан счет МЗ
	|			Номенклатура.НоменклатурныйНомер
	|		ИНАЧЕ
	|			// Указан счет ОС
	|			ПРЕДСТАВЛЕНИЕ(ИнвентарныйНомер)
	|	КОНЕЦ										КАК НомНомер,
	|	ВЫБОР
	|		КОГДА Ссылка.Счет В(&СчетМЗ) ТОГДА
	|			// Указан счет МЗ
	|			Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ
	|			// Указан счет ОС
	|			&ЕдИзмШт
	|	КОНЕЦ										КАК ЕдИзм,
	|	ВЫБОР
	|		КОГДА Ссылка.Счет В(&СчетМЗ) ТОГДА
	|			// Указан счет МЗ
	|			Номенклатура.ЕдиницаИзмерения.Наименование
	|		ИНАЧЕ
	|			// Указан счет ОС
	|			ВЫРАЗИТЬ(&ЕдИзмШт	КАК Справочник.КлассификаторЕдиницИзмерения).Наименование
	|	КОНЕЦ										КАК ЕдиницаИзмерения,
	|	Цена										КАК Цена,
	|	
	|	// По учету:
	|	КоличествоУчет								КАК КоличествоП,
	|	СуммаУчет									КАК Сумма,
	|	
	|	// По факту:
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(КоличествоФакт, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК КоличествоФ,
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(СуммаФакт, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК СуммаФ,
	|	
	|	// Недостача:
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(НедостачаКоличество, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК КоличествоН,
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(НедостачаСумма, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК СуммаН,
	|	
	|	// Излишек:
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(ИзлишекКоличество, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК КоличествоИ,
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие ТОГДА
	|			ЕСТЬNULL(ИзлишекСумма, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК СуммаИ
	|ИЗ
	|	Документ.ИнвентаризацияИК.Инвентаризация	КАК ТЧ
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка,
	|	Ном
	|ИТОГИ
	|	СУММА(Сумма)		КАК Сумма,
	|	СУММА(СуммаФ)		КАК СуммаФ,
	|	СУММА(СуммаН)		КАК СуммаН,
	|	СУММА(СуммаИ)		КАК СуммаИ,
	|	СУММА(КоличествоП)	КАК КоличествоП,
	|	СУММА(КоличествоФ)	КАК КоличествоФ,
	|	СУММА(КоличествоН)	КАК КоличествоН,
	|	СУММА(КоличествоИ)	КАК КоличествоИ
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;";
	
	Результаты = ЗапросПечать.ВыполнитьПакет();
	
	// [0]. Шапки документов
	ВыборкаШапка = Результаты[0].Выбрать();
	
	// [1]. Таблицы инвентаризационных комиссий
	ВыборкаДокКомиссия = Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// [2]. Таблицы НФА
	ВыборкаДокДанные = Результаты[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета:
		ОбластьТитул				= Макет.ПолучитьОбласть("Титул");
		ОбластьКомиссия 			= Макет.ПолучитьОбласть("Комиссия");
		ОбластьКонцовкаТитула 		= Макет.ПолучитьОбласть("КонцовкаТитула");
		ОбластьШапка 				= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока 				= Макет.ПолучитьОбласть("Строка");
		ОбластьПустаяСтрока 		= Макет.ПолучитьОбласть("ПустаяСтрока");
		ОбластьДопСтрока 			= Макет.ПолучитьОбласть("ДопСтрока");
		ОбластьИтоги 				= Макет.ПолучитьОбласть("Итоги");
		ОбластьИтогоПоСтранице 		= Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтогоПоОписиЧисло	= Макет.ПолучитьОбласть("ИтогоПоОписиЧисло");
		ОбластьИтогоПоСтраницеЗаг 	= Макет.ПолучитьОбласть("ИтогоПоСтраницеЗаг");
		ОбластьИтогоПоОписи 		= Макет.ПолучитьОбласть("ИтогоПоОписи");
		
		КоличествоЗнаковПослеЗапятойДляКоличества = ВыборкаШапка["КоличествоЗнаковПослеЗапятойДляКоличества"];
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокКомиссия	= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокДанные	= ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		ОбщееКоличествоПорядковыхНомеров = 0;
		
		//---------------------
		// с.1, Титульный лист
		//---------------------
		НомерСтраницы  = 1;
		// Подготовка:
		Параметр_ПолныйНомерСчета = ПолныйНомерСчета(
			ВыборкаШапка["КФО"],
			ВыборкаШапка["СчетПредставление"],
			ВыборкаШапка["СчетЗабалансовый"]);
		Параметр_ДатаОписи = Формат(ВыборкаШапка["Дата"], "ДЛФ=ДД");	
		//---
		// Сведения о МОЛ
		//---
		МОЛ				= ВыборкаШапка.МОЛ;
		МОЛДолжность	= "";
		МОЛФИО			= "";
		МОЛФИОПолное	= "";
		Если ЗначениеЗаполнено(МОЛ) Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность, НаименованиеПолное",
				МОЛ,
				ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			МОЛДолжность = ТребуемыеДанные.Должность;
			МОЛФИО       = Корреспонденты.ФИОПоОбъекту(МОЛ, Истина);
			МОЛФИОПолное = ТребуемыеДанные.НаименованиеПолное;
		КонецЕсли;
		// Заполняем значения параметров выводимой области:
		ОбластьТитул.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьТитул,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,Неопределено, Истина);
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("МОЛДолжность",		МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛНаименование",	МОЛФИО);
		ЗначенияПараметров.Вставить("ПолноеФИОМОЛ",		МОЛФИОПолное);
		ЗначенияПараметров.Вставить("ПолныйНомерСчета",	Параметр_ПолныйНомерСчета);
		ЗначенияПараметров.Вставить("ДатаОписи",		Параметр_ДатаОписи);
		ОбластьТитул.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьТитул);
		
		//---
		// Инвентаризационная комиссия
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		ТабДокумент.Вывести(ОбластьКонцовкаТитула);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//-----------------------------
		// с.2 и далее, Таблица док-та
		//-----------------------------
		//---
		// Шапка таблицы
		//---
		ТабДокумент.Вывести(ОбластьШапка);
		
		// Статистика по странице:
		ИтогоПоСтранице = ПолучитьСтруктуруИтоговПоСтранице();
		ТекущаяСтрока	= 0;
		
		Если ЕстьВыборкаДокДанные Тогда
			ВыборкаДанные = ВыборкаДокДанные.Выбрать();
			ОбщееКоличествоПорядковыхНомеров = ВыборкаДанные.Количество();
			Пока ВыборкаДанные.Следующий() Цикл
				
				ОбластьСтрока.Параметры.Заполнить(ВыборкаДанные);
				
				ЗначенияПараметров = Новый Структура();
				Печать0504087_ФорматироватьЧисловыеГрафы(ЗначенияПараметров, ВыборкаДанные, КоличествоЗнаковПослеЗапятойДляКоличества);
				ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
				
				Если НЕ ВыводитьФактНаличие Тогда
					ОбластьСтрока.Параметры.Заполнить(ОчищающаяСтруктураФактическогоНаличия);
				КонецЕсли;
				
				ТекущаяСтрока = ТекущаяСтрока + 1;
				
				// Выводимые одновременно на страницу области:
				МассивОбластей = Новый Массив();
				МассивОбластей.Добавить(ОбластьСтрока);
				МассивОбластей.Добавить(ОбластьИтогоПоСтранице);
				Если ТекущаяСтрока = ОбщееКоличествоПорядковыхНомеров Тогда
					МассивОбластей.Добавить(ОбластьИтогоПоОписиЧисло);
				КонецЕсли;
				МассивОбластей.Добавить(ОбластьИтогоПоСтраницеЗаг);
				МассивОбластей.Добавить(ОбластьИтоги);
				
				// Все области помещаются на лист?
				Если НЕ ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
					
					//---
					// Итого по странице
					//---
					ИспользуемыеОбласти = Новый Структура();
					ИспользуемыеОбласти.Вставить("ОбластьИтогоПоСтранице",			ОбластьИтогоПоСтранице);
					ИспользуемыеОбласти.Вставить("ОбластьИтогиЗаголовок",			ОбластьИтогоПоСтраницеЗаг);
					ИспользуемыеОбласти.Вставить("ОбластьИтоги",					ОбластьИтоги);
					ИспользуемыеВыборки = Новый Структура();
					ВывестиИтогиПоСтранице0504087(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, ИтогоПоСтранице, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества);
					
					ТабДокумент.Вывести(ОбластьШапка);
				КонецЕсли;
				
				//---
				// Строка таблицы
				//---
				ТабДокумент.Вывести(ОбластьСтрока);
				
				// Статистика по странице:
				ИтогоПоСтранице["Сумма"]		= ИтогоПоСтранице["Сумма"]			+ ВыборкаДанные["Сумма"];
				ИтогоПоСтранице["СуммаФ"]		= ИтогоПоСтранице["СуммаФ"]			+ ВыборкаДанные["СуммаФ"];
				ИтогоПоСтранице["СуммаН"]		= ИтогоПоСтранице["СуммаН"]			+ ВыборкаДанные["СуммаН"];
				ИтогоПоСтранице["СуммаИ"]		= ИтогоПоСтранице["СуммаИ"]			+ ВыборкаДанные["СуммаИ"];
				ИтогоПоСтранице["КоличествоП"]	= ИтогоПоСтранице["КоличествоП"]	+ ВыборкаДанные["КоличествоП"];
				ИтогоПоСтранице["КоличествоФ"]	= ИтогоПоСтранице["КоличествоФ"]	+ ВыборкаДанные["КоличествоФ"];
				ИтогоПоСтранице["КоличествоН"]	= ИтогоПоСтранице["КоличествоН"]	+ ВыборкаДанные["КоличествоН"];
				ИтогоПоСтранице["КоличествоИ"]	= ИтогоПоСтранице["КоличествоИ"]	+ ВыборкаДанные["КоличествоИ"];
				ИтогоПоСтранице["КоличествоПорядковыхНомеров"]	= ИтогоПоСтранице["КоличествоПорядковыхНомеров"]+ 1;
			КонецЦикла;	
		КонецЕсли;
		
		// Выводим пустые строки таблицы до конца страницы:
		МассивОбластей = Новый Массив;
		МассивОбластей.Добавить(ОбластьПустаяСтрока);
		МассивОбластей.Добавить(ОбластьПустаяСтрока);
		МассивОбластей.Добавить(ОбластьИтогоПоСтранице);
		МассивОбластей.Добавить(ОбластьИтогоПоОписиЧисло);
		МассивОбластей.Добавить(ОбластьИтогоПоСтраницеЗаг);
		МассивОбластей.Добавить(ОбластьИтоги);
		Пока ТабДокумент.ПроверитьВывод(МассивОбластей) Цикл
			ТабДокумент.Вывести(ОбластьПустаяСтрока);
		КонецЦикла;
		ТабДокумент.Вывести(ОбластьПустаяСтрока);
		
		//---
		// Итого по странице, включая строку итогов по всей описи
		//---
		ИспользуемыеОбласти = Новый Структура();
		ИспользуемыеОбласти.Вставить("ОбластьИтогоПоСтранице",			ОбластьИтогоПоСтранице);
		ИспользуемыеОбласти.Вставить("ОбластьИтогиЗаголовок",			ОбластьИтогоПоСтраницеЗаг);
		ИспользуемыеОбласти.Вставить("ОбластьИтоги",					ОбластьИтоги);
		ИспользуемыеОбласти.Вставить("ОбластьИтогоПоОписиЧисло",		ОбластьИтогоПоОписиЧисло);
		ИспользуемыеВыборки = Новый Структура();
		ИспользуемыеВыборки.Вставить("ВыборкаДокДанные",				ВыборкаДокДанные);
		ВывестиИтогиПоСтранице0504087(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, ИтогоПоСтранице, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества);
		
		//---
		// Итоги по всей описи, прописью
		//---
		ИспользуемыеОбласти = Новый Структура();
		ИспользуемыеОбласти.Вставить("ОбластьИтогиЗаголовок",		ОбластьИтогоПоОписи);
		ИспользуемыеОбласти.Вставить("ОбластьИтоги",				ОбластьИтоги);
		ПараметрыОбласти = ПолучитьСтруктуруИтоговПоСтранице();
		ЗаполнитьЗначенияСвойств(ПараметрыОбласти, ВыборкаДокДанные);
		ПараметрыОбласти.Вставить("КоличествоПорядковыхНомеров",	ОбщееКоличествоПорядковыхНомеров);
		ВывестиИтогиПрописью0504087(ТабДокумент, ИспользуемыеОбласти, ПараметрыОбласти, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества);
			
		//---
		// Инвентаризационная комиссия
		//---
		ТабДокумент.Вывести(ОбластьДопСтрока);
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиИтогиПоСтранице0504087(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, СтруктураИтоговПоСтранице, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества)
	
	ОбластьИтогоПоСтранице	= ИспользуемыеОбласти["ОбластьИтогоПоСтранице"];
	ОбластьИтоги			= ИспользуемыеОбласти["ОбластьИтоги"];
	ВыборкаДокДанные		= Неопределено;
	
	ОчищающаяСтруктураФактическогоНаличия = Печать0504087_ПолучитьОчищающуюСтруктуруФактическогоНаличия();
	
	//---
	// Итого по странице, числом
	//---
	ЗначенияПараметров = ПолучитьСтруктуруИтоговПоСтранице();
	ЗаполнитьЗначенияСвойств(ЗначенияПараметров, СтруктураИтоговПоСтранице);
	
	Печать0504087_ФорматироватьЧисловыеГрафы(ЗначенияПараметров, СтруктураИтоговПоСтранице, КоличествоЗнаковПослеЗапятойДляКоличества);
	
	ОбластьИтогоПоСтранице.Параметры.Заполнить(ЗначенияПараметров);
	
	Если НЕ ВыводитьФактНаличие Тогда
		ОбластьИтогоПоСтранице.Параметры.Заполнить(ОчищающаяСтруктураФактическогоНаличия);
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьИтогоПоСтранице);
	
	//---
	// Итого по всей описи, числом
	//---
	Если ИспользуемыеВыборки.Свойство("ВыборкаДокДанные", ВыборкаДокДанные) Тогда
		ОбластьИтогоПоОписиЧисло = ИспользуемыеОбласти["ОбластьИтогоПоОписиЧисло"];
		
		ВыборкаЗаполнена = НЕ (ВыборкаДокДанные["ДокСсылка"] = Неопределено);
		
		Если ВыборкаЗаполнена Тогда
			Выборка = ВыборкаДокДанные;
		Иначе
			Выборка = ПолучитьСтруктуруИтоговПоСтранице();
		КонецЕсли;
		
		ОбластьИтогоПоОписиЧисло.Параметры.Заполнить(Выборка);
		
		ЗначенияПараметров = Новый Структура();
		Печать0504087_ФорматироватьЧисловыеГрафы(ЗначенияПараметров, Выборка, КоличествоЗнаковПослеЗапятойДляКоличества);
		
		ОбластьИтогоПоОписиЧисло.Параметры.Заполнить(ЗначенияПараметров);
		
		Если НЕ ВыводитьФактНаличие Тогда
			ОбластьИтогоПоОписиЧисло.Параметры.Заполнить(ОчищающаяСтруктураФактическогоНаличия);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьИтогоПоОписиЧисло);
	КонецЕсли;
	
	//---
	// Итого по странице, прописью
	//---
	ВывестиИтогиПрописью0504087(ТабДокумент, ИспользуемыеОбласти, СтруктураИтоговПоСтранице, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества);
		
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Обнуляем статистику по странице:
	СтруктураИтоговПоСтранице = ПолучитьСтруктуруИтоговПоСтранице();

КонецПроцедуры

Процедура ВывестиИтогиПрописью0504087(ТабДокумент, ИспользуемыеОбласти, ПараметрыОбласти, ВыводитьФактНаличие, КоличествоЗнаковПослеЗапятойДляКоличества)
	
	ОбластьИтогиЗаголовок	= ИспользуемыеОбласти["ОбластьИтогиЗаголовок"];
	ОбластьИтоги			= ИспользуемыеОбласти["ОбластьИтоги"];
	
	КоличествоПорядковыхНомеров	= ПараметрыОбласти["КоличествоПорядковыхНомеров"];
	КоличествоФ					= ПараметрыОбласти["КоличествоФ"];
	СуммаФ						= ПараметрыОбласти["СуммаФ"];
	
	ТабДокумент.Вывести(ОбластьИтогиЗаголовок);
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("КоличествоПорядковыхНомеровПрописью",
		ЧислоПрописью(КоличествоПорядковыхНомеров,, ",,,м,,,,,0"));
		
	Если ВыводитьФактНаличие Тогда
		Если НЕ ЗначениеЗаполнено(КоличествоФ) Тогда
			КоличествоФ = 0;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СуммаФ) Тогда
			СуммаФ = 0;
		КонецЕсли;
		
		// Количество по факту
		Если КоличествоЗнаковПослеЗапятойДляКоличества = 0 Тогда
			ПараметрыПредметаИсчисления = ",,,,,,,,0";
		Иначе
			ПараметрыПредметаИсчисления = "целое,целых,целых,с,тысячная,тысячные,тысячных,ж,3";
		КонецЕсли;
		СтруктураПараметров.Вставить("КоличествоФактическоеПрописью", ЧислоПрописью(КоличествоФ,, ПараметрыПредметаИсчисления));
		
		// Сумма по факту
		СтруктураПараметров.Вставить("СтоимостьФактическаяПрописью", ЧислоПрописью(СуммаФ,, "рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2"));
			
	КонецЕсли;
	
	ОбластьИтоги.Параметры.Заполнить(СтруктураПараметров);
	ТабДокумент.Вывести(ОбластьИтоги);
	
КонецПроцедуры

Функция ПолныйНомерСчета(КФО, СчетПредставление, СчетЗабалансовый)

	КФОПредставление = ?(ЗначениеЗаполнено(КФО), Строка(КФО), "0");
	
	Возврат ?(СчетЗабалансовый,
		КФОПредставление + "." + СчетПредставление,
		"00000000000000000." + КФОПредставление + "." + СчетПредставление + ".000");
	
КонецФункции // НомерСчета()

Функция ПолучитьСтруктуруИтоговПоСтранице()
	
	Результат = Новый Структура();
	
	Результат.Вставить("Сумма",							0);
	Результат.Вставить("СуммаФ",						0);
	Результат.Вставить("СуммаН",						0);
	Результат.Вставить("СуммаИ",						0);
	Результат.Вставить("КоличествоП",					0);
	Результат.Вставить("КоличествоФ",					0);
	Результат.Вставить("КоличествоН",					0);
	Результат.Вставить("КоличествоИ",					0);
	Результат.Вставить("КоличествоПорядковыхНомеров",	0);
	
	Возврат Результат;
	
КонецФункции

Функция Печать0504087_ПолучитьОчищающуюСтруктуруФактическогоНаличия()
	
	// Исключаем вывод символа прочерка "-" в показателях фактического наличия
	// путем указания пустой строки
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("КоличествоФ",	""); // гр.6
	ОчищающаяСтруктура.Вставить("СуммаФ",		""); // гр.7
	ОчищающаяСтруктура.Вставить("КоличествоН",	""); // гр.10
	ОчищающаяСтруктура.Вставить("СуммаН",		""); // гр.11
	ОчищающаяСтруктура.Вставить("КоличествоИ",	""); // гр.12
	ОчищающаяСтруктура.Вставить("СуммаИ",		""); // гр.13
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Процедура Печать0504087_ФорматироватьЧисловыеГрафы(ЗначенияПараметров, Выборка, КоличествоЗнаковПослеЗапятойДляКоличества)
	
	ФорматнаяСтрокаКоличество = "ЧЦ=15; ЧДЦ=" + Строка(КоличествоЗнаковПослеЗапятойДляКоличества) + "; ЧН=-";
	
	ФорматнаяСтрокаСумма = "ЧЦ=15; ЧДЦ=2; ЧН=-";
	
	ЗначенияПараметров.Вставить("КоличествоП",	Формат(Выборка["КоличествоП"], ФорматнаяСтрокаКоличество));
	ЗначенияПараметров.Вставить("КоличествоФ",	Формат(Выборка["КоличествоФ"], ФорматнаяСтрокаКоличество));
	ЗначенияПараметров.Вставить("КоличествоН",	Формат(Выборка["КоличествоН"], ФорматнаяСтрокаКоличество));
	ЗначенияПараметров.Вставить("КоличествоИ",	Формат(Выборка["КоличествоИ"], ФорматнаяСтрокаКоличество));
	
	ЗначенияПараметров.Вставить("СуммаФ",	Формат(Выборка["СуммаФ"], ФорматнаяСтрокаСумма));
	ЗначенияПараметров.Вставить("СуммаН",	Формат(Выборка["СуммаН"], ФорматнаяСтрокаСумма));
	ЗначенияПараметров.Вставить("СуммаИ",	Формат(Выборка["СуммаИ"], ФорматнаяСтрокаСумма));
	
КонецПроцедуры


// ИНВ-22 = ф.0317018
Функция ПечатьФормыИНВ22(МассивОбъектов, ОбъектыПечати)
	
	// Возвращаемый таб.документ:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ИмяПараметровПечати = "ИнвентаризацияИК_ПечатьФормыИНВ22";
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИНВ22");

	// Настраиваем запрос:
	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("МассивСсылок",				МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("НаименованиеИмущества",	НСтр("ru='Имущество казны'"));
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапка документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	// Шапка:
	|	Ссылка							КАК ДокСсылка,
	|	Номер							КАК Номер,
	|	ДатаИнвентаризации				КАК Дата,
	|	Организация						КАК Организация,
	|	ВЫБОР
	|		КОГДА Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ТОГДА
	|			""""
	|		КОГДА НЕ Организация.НаименованиеПолное ПОДОБНО """" ТОГДА
	|			Организация.НаименованиеПолное
	|		КОГДА НЕ Организация.НаименованиеСокращенное ПОДОБНО """" ТОГДА
	|			Организация.НаименованиеСокращенное
	|		ИНАЧЕ
	|			Организация.Представление
	|	КОНЕЦ							КАК НаименованиеОрганизации,
	|	Организация.КодОКПО				КАК КодОКПО,
	|	Подразделение.Наименование		КАК НаименованиеПодразделения,
	|	НомерПриказаИнвентаризации		КАК НомерПриказаИнвентаризации,
	|	ДатаПриказаИнвентаризации		КАК ДатаПриказаИнвентаризации,
	|	&НаименованиеИмущества			КАК НаименованиеИмуществаОбязательств,
	|	
	|	// Председатель комиссии:
	|	ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
	|	ФамилияПредседателяКомиссии		КАК ФамилияПредседателяКомиссии,
	|	ИмяПредседателяКомиссии			КАК ИмяПредседателяКомиссии,
	|	ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
	|
	|	// Подвал:
	|	ДатаНачала						КАК ДатаНачала,
	|	ДатаОкончания					КАК ДатаОкончания,
	|	ПричинаИнвентаризации			КАК ПричинаПроведенияИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияИК	КАК Док
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица инвентаризационной комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии		КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии			КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияИК.СоставКомиссии	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;";
	
	// Выполняем запрос:
	ЗапросПечать.ВыполнитьПакет();
	
	Результаты = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= Результаты[0].Выбрать();
	ВыборкаДокКомиссия	= Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета:
		ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
		ОбластьКомиссия	= Макет.ПолучитьОбласть("Комиссия");
		ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокКомиссия = ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		КоличествоСтрок = 0;
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент	= Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//---
		// Шапка
		//---
		НомерСтраницы = 1;
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьШапка,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,Неопределено, Истина);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьШапка);
		
		//---
		// Инвентаризационная комиссия
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		//---
		// Подвал
		//---
		// Подготовка:
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ВыборкаШапка["Организация"],
			ВыборкаШапка["Дата"]);
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("ДолжностьРуководителя",	Руководитель["ДолжностьПредставление"]);
		ЗначенияПараметров.Вставить("ФИОРуководителя",			КорреспондентыКлиентСервер.ФИО(Руководитель["ОтветственноеЛицоФИО"]));
		ЗначенияПараметров.Вставить("ДатаНачала",		Формат(ВыборкаШапка["ДатаНачала"], "ДФ=dd.MM.yyyy"));
		ЗначенияПараметров.Вставить("ДатаОкончания",	Формат(ВыборкаШапка["ДатаОкончания"], "ДФ=dd.MM.yyyy"));
		// Заполняем значения параметров выводимой области:
		ОбластьПодвал.Параметры.Заполнить(ВыборкаШапка);
		ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьПодвал);
		
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции


Функция Печать0504087_194н_ПолучитьВыборкиДляПечати(МассивОбъектов) Экспорт
	
	ЗапросПечать = Новый Запрос;
	ЗапросПечать.УстановитьПараметр("МассивСсылок",	МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("Штука",		"шт.");
	ЗапросПечать.УстановитьПараметр("СчетаМЗ",		ПолучитьСчетаУчетаМЗ());
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка							КАК ДокументСсылка,
	|	Номер							КАК Номер,
	|	Дата 							КАК Дата,
	|	Организация						КАК Организация,
	|	Организация.НаименованиеПолное	КАК НаименованиеОрганизации,
	|	Подразделение.Наименование		КАК НаименованиеПодразделения,
