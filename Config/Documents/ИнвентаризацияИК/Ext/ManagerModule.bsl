		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Подразделение",	"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
	
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "ПоступлениеИК";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания	Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",							"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",					"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Номенклатура",			"Материалы.Номенклатура");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Количество",			"Материалы.Количество");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Сумма",				"Материалы.Сумма");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.КПС",					"КПС108");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.ЦМО",					"ЦМО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",						"ДокументОснование");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"ИФО",						"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Излишки.Подразделение",	"Подразделение");
	КонецЕсли;
	ТиповаяОперацияСсылка		= Справочники.ТиповыеОперации.ПоступлениеИК_ОприходованиеИзлишков;
	РеквизитыТиповойОперации	= Новый Массив();
	РеквизитыТиповойОперации.Добавить("КПС108");
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Номенклатура",			"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Сумма",				"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"КПС",					"КПС108");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ЦМО",					"ЦМО");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ИФО",				"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Подразделение",	"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
		
	
	//////////////////////////////////////////////////////////////////////////////
	// Общие настройки механизма (для всех видов документов)
	//
	РеквизитыТиповойОперацииОснование = Новый Массив();
	ЗаголовкиКолонокТаблицыОтметки = Новый Структура();
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ОсновноеСредство",	"Основное средство");
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ИнвентарныйНомер",	"Инвентарный номер");
	ВводНаОсновании.ДобавитьОбщиеНастройкиМеханизма(НастройкиМеханизма, РеквизитыТиповойОперацииОснование, ЗаголовкиКолонокТаблицыОтметки);
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ВводНаОсновании_НастройкиФормыСпискаДокументовВведенныхНаОсновании(ДополнительныйПараметр = Неопределено) Экспорт
	
	Перем	Таблица,
			МассивФлажков;
	
	// 1. Колонки
	
	//
	// Документы списания (недостачи)
	//
	
	ВидыДокументовСписания = Новый Массив();
	
	Если ДополнительныйПараметр = "ОС" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "СписаниеОбъектовИК";
		ВидыДокументовСписания.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО", "МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		
		ВидДокумента = "СписаниеАвтотранспортаИК";
		ВидыДокументовСписания.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО", "МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ОсновноеСредство", "Основное средство");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИнвентарныйНомер", "Инв. номер");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "КПС");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	КонецЕсли;
	
	Если ДополнительныйПараметр = "МЗ" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "ТребованиеНакладнаяИК";
		ВидыДокументовСписания.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО", "МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "КПС");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	КонецЕсли;
	
	//
	// Документы поступления (излишки)
	//
	
	ВидыДокументовПоступления = Новый Массив();
	
	Если ДополнительныйПараметр = "ОС" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "ПринятиеКУчетуОбъектовИК";
		ВидыДокументовПоступления.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО", "МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма", , "СуммаДокумента");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	КонецЕсли;
	
	Если ДополнительныйПараметр = "МЗ" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "ПоступлениеИК";
		ВидыДокументовПоступления.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО", "МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма", , "СуммаДокумента");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Подразделение");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	КонецЕсли;
	
	// 2. Флажки
	
	ЗаголовокФлажка = "Списания (недостачи)";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовСписания, ЗаголовокФлажка);
	
	ЗаголовокФлажка = "Поступления (излишки)";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовПоступления, ЗаголовокФлажка);
	
	
	НастройкиФормыСписка = Новый Структура();
	НастройкиФормыСписка.Вставить("ТаблицаОписаниеКолонок",	Таблица);
	НастройкиФормыСписка.Вставить("МассивФлажков",			МассивФлажков);
	
	Возврат НастройкиФормыСписка;
	
КонецФункции

// Позволяет переопределить имена колонок, определенные автоматически из настроек механизма.
Процедура ВводНаОсновании_Переопределяемый_КолонкиТаблицыОтметки(ПараметрыВводаНаОсновании, АвтоопределенныеИменаКолонок) Экспорт
	
	// Удаляем колонки, не используемые в текущем режиме работы с документом
	
	// Настройки режима работы с документом
	ИменаРеквизитовШапки = "Дата,Организация,Счет,ЦМО";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыВводаНаОсновании["ДокументОснованиеСсылка"], ИменаРеквизитовШапки);
	НастройкиДляРаботы = ПолучитьНастройкиДляРаботы(ЗначенияРеквизитов);
	
	Если НЕ НастройкиДляРаботы["ЕстьСубконтоЦМО"] Тогда
		ИмяКолонки = "ЦМО";
		Индекс = АвтоопределенныеИменаКолонок.Найти(ИмяКолонки);
		Если НЕ Индекс = Неопределено Тогда
			АвтоопределенныеИменаКолонок.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	ВводНаОсновании.ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения);
	
	// Продолжаем заполнение нового документа
	ВидДокумента = ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"]["ВидДокумента"];
	
	//---
	// Недостачи
	//---
	Если ВидДокумента = "СписаниеОбъектовИК" Тогда
		ЗаполняемыйДокумент["КФО"]						= Перечисления.КВД.Бюджет;
		ЗаполняемаяТабличнаяЧасть = ЗаполняемыйДокумент["ОсновныеСредства"];
		Для Каждого СтрокаТЧ Из ЗаполняемаяТабличнаяЧасть Цикл
			СтрокаТЧ["ПричинаСписания"]	= НСтр("ru='Недостача'");
		КонецЦикла;
		
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
		// Заполняем сумму амортизации
		ПараметрыЗапроса = Новый Структура("Организация, ИФО, КФО, Подразделение");
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, ЗаполняемыйДокумент);
		ПараметрыЗапроса.Вставить("Период", УправлениеОсновнымиСредствамиКлиентСервер.ПериодПолученияОстатковДляДокумента(ЗаполняемыйДокумент, ПолучитьДатуОпределенияОстатков(ЗаполняемыйДокумент)));
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ОстаткиИмуществаКазны(ПараметрыЗапроса, ЗаполняемыйДокумент["ОсновныеСредства"].Выгрузить(,"НомерСтроки, ОсновноеСредство, ИнвентарныйНомер"));
		Для каждого ТекСтр Из ЗаполняемыйДокумент["ОсновныеСредства"] Цикл
			СтрокаОстатков = ТаблицаОстатков.Найти(ТекСтр.НомерСтроки, "НомерСтроки");
			ТекСтр.СтоимостьЕдиницы = СтрокаОстатков.СтоимостьЕдиницы;
			Если ТекСтр.Количество = СтрокаОстатков.КоличествоВсего Тогда
				ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияВсего;
			Иначе
				ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияЕдиницы	* ТекСтр.Количество;
			КонецЕсли;
		КонецЦикла; 
		
	ИначеЕсли ВидДокумента = "СписаниеГруппОбъектовИК" Тогда
		ЗаполняемыйДокумент["КФО"]						= Перечисления.КВД.Бюджет;
		ЗаполняемаяТабличнаяЧасть = ЗаполняемыйДокумент["ОсновныеСредства"];
		Для Каждого СтрокаТЧ Из ЗаполняемаяТабличнаяЧасть Цикл
			СтрокаТЧ["ПричинаСписания"]	= НСтр("ru='Недостача'");
		КонецЦикла;
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
		// Заполняем сумму амортизации
		ПараметрыЗапроса = Новый Структура("Организация, ИФО, КПС, КФО, Подразделение");
		ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, ЗаполняемыйДокумент);
		ПараметрыЗапроса.Вставить("Период", УправлениеОсновнымиСредствамиКлиентСервер.ПериодПолученияОстатковДляДокумента(ЗаполняемыйДокумент, ПолучитьДатуОпределенияОстатков(ЗаполняемыйДокумент)));
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ОстаткиИмуществаКазны(ПараметрыЗапроса, ЗаполняемыйДокумент["ОсновныеСредства"].Выгрузить(,"НомерСтроки, ОсновноеСредство, ИнвентарныйНомер"));
		Для каждого ТекСтр Из ЗаполняемыйДокумент["ОсновныеСредства"] Цикл
			СтрокаОстатков = ТаблицаОстатков.Найти(ТекСтр.НомерСтроки, "НомерСтроки");
			Если ТекСтр.Количество = СтрокаОстатков.КоличествоВсего Тогда
				ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияВсего;
			Иначе
				ТекСтр.СуммаАмортизации = СтрокаОстатков.АмортизацияЕдиницы	* ТекСтр.Количество;
			КонецЕсли;
		КонецЦикла; 
		
	ИначеЕсли ВидДокумента = "СписаниеОбъектаИК" Тогда
		ЗаполняемыйДокумент["КФО"]						= Перечисления.КВД.Бюджет;
		ЗаполняемыйДокумент["ПричинаСписания"]			= НСтр("ru='Недостача'");
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
		// Заполняем сумму амортизации
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ЗаполняемыйДокумент, ПолучитьДатуОпределенияОстатков(ЗаполняемыйДокумент));
		ПараметрыПолученияОстатков.ПолучатьАмортизацию				= Истина;
		ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер	= Ложь;
		ПараметрыПолученияОстатков.УстанавливатьКПС					= Ложь;
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ОсновноеСредство",				"ОсновноеСредство");
		ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",				"ИнвентарныйНомер");
		ПараметрыЗаполнения.Вставить("СуммаАмортизации",				"СуммаАмортизации");
		ПараметрыЗаполнения.Вставить("ИсходноеКоличество",				1);
		ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер",	Ложь);
		УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, ЗаполняемыйДокумент, ПараметрыЗаполнения);
		
	ИначеЕсли ВидДокумента = "СписаниеТранспортаИК" Тогда
		ЗаполняемыйДокумент["КФО"]						= Перечисления.КВД.Бюджет;
		ЗаполняемыйДокумент["ПричинаСписания"]			= НСтр("ru='Недостача'");
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
		// Заполняем сумму амортизации
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ЗаполняемыйДокумент, ПолучитьДатуОпределенияОстатков(ЗаполняемыйДокумент));
		ПараметрыПолученияОстатков.ПолучатьАмортизацию				= Истина;
		ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер	= Ложь;
		ПараметрыПолученияОстатков.УстанавливатьКПС					= Ложь;
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ОсновноеСредство",				"ОсновноеСредство");
		ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",				"ИнвентарныйНомер");
		ПараметрыЗаполнения.Вставить("СуммаАмортизации",				"СуммаАмортизации");
		ПараметрыЗаполнения.Вставить("ИсходноеКоличество",				1);
		ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер",	Ложь);
		УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, ЗаполняемыйДокумент, ПараметрыЗаполнения);
		
	ИначеЕсли ВидДокумента = "СписаниеАвтотранспортаИК" Тогда
		ЗаполняемыйДокумент["КФО"]						= Перечисления.КВД.Бюджет;
		ЗаполняемыйДокумент["ПричинаСписания"]			= НСтр("ru='Недостача'");
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
		// Заполняем сумму амортизации
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ЗаполняемыйДокумент, ПолучитьДатуОпределенияОстатков(ЗаполняемыйДокумент));
		ПараметрыПолученияОстатков.ПолучатьАмортизацию				= Истина;
		ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер	= Ложь;
		ПараметрыПолученияОстатков.УстанавливатьКПС					= Ложь;
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ОсновноеСредство",				"ОсновноеСредство");
		ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",				"ИнвентарныйНомер");
		ПараметрыЗаполнения.Вставить("СуммаАмортизации",				"СуммаАмортизации");
		ПараметрыЗаполнения.Вставить("ИсходноеКоличество",				1);
		ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер",	Ложь);
		УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, ЗаполняемыйДокумент, ПараметрыЗаполнения);
		
	ИначеЕсли ВидДокумента = "ТребованиеНакладнаяИК" Тогда
		ЗаполняемыйДокумент["КФО"]				= Перечисления.КВД.Бюджет;
		
	//---
	// Излишки
	//---
	ИначеЕсли ВидДокумента = "ПринятиеКУчетуОбъектовИК" Тогда
		ЗаполняемыйДокумент["КФО"]				= Перечисления.КВД.Бюджет;
		ЗаполняемыйДокумент["ВидПоступления"]	= Перечисления.ВидыОперацийИК.Поступление;
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
	ИначеЕсли ВидДокумента = "ПринятиеКУчетуОбъектаИК" Тогда
		ЗаполняемыйДокумент["ВидПоступления"] = Перечисления.ВидыОперацийИК.Поступление;
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
		
	ИначеЕсли ВидДокумента = "ПринятиеКУчетуИК" Тогда
		ЗаполняемыйДокумент["ВидПоступления"] = Перечисления.ВидыОперацийИК.Поступление;
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);
	
	ИначеЕсли ВидДокумента = "ПринятиеКУчетуЗданияИК" Тогда
		ЗаполняемыйДокумент["ВидПоступления"] = Перечисления.ВидыОперацийИК.Поступление;
		ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент);

	ИначеЕсли ВидДокумента = "ПоступлениеИК" Тогда
		ЗаполняемаяТабличнаяЧасть = ЗаполняемыйДокумент["Материалы"];
		МассивНоменклатуры = ЗаполняемаяТабличнаяЧасть.Выгрузить(,"Номенклатура").ВыгрузитьКолонку("Номенклатура");
		ЕдиницыИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивНоменклатуры, "ЕдиницаИзмерения");
		Для Каждого СтрокаТЧ Из ЗаполняемаяТабличнаяЧасть Цикл
			СтрокаТЧ["ЕдиницаИзмерения"]	= ЕдиницыИзмерения[СтрокаТЧ["Номенклатура"]];
			СтрокаТЧ["КоличествоМест"]		= СтрокаТЧ["Количество"];
			СтрокаТЧ["Коэффициент"]			= 1;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

