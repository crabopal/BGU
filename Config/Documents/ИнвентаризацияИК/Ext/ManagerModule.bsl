#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполненияТаблицыИнвентаризация(ДокументОбъект) Экспорт
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	НастройкиДляРаботы = ПолучитьНастройкиДляРаботы(ДокументОбъект);
	Если НастройкиДляРаботы["УказанСчетОС"] Тогда
		УказанСчетОС = Истина;
		УказанСчетМЗ = Ложь;
		ТаблицаПредставление = НСтр("ru='Основные средства'");
	Иначе
		УказанСчетОС = Ложь;
		УказанСчетМЗ = Истина;
		ТаблицаПредставление = НСтр("ru='Материалы'");
	КонецЕсли;
	
	//---
	// Заполненность
	//---
	Если УказанСчетОС Тогда
		ПроверяемоеПоле					= "ОсновноеСредство";
		ПроверяемоеПолеПредставление	= НСтр("ru='Основное cредство'");
	ИначеЕсли УказанСчетМЗ Тогда
		ПроверяемоеПоле					= "Номенклатура";
		ПроверяемоеПолеПредставление	= НСтр("ru='Номенклатура'");
	КонецЕсли;
	КоличествоСтрок = ДокументОбъект["Инвентаризация"].Количество();
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ДокументОбъект["Инвентаризация"][НомерСтроки - 1];
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ПроверяемоеПоле]) Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Поле ""%1"" не заполнено (таблица ""%2"", строка %3)'"),
				ПроверяемоеПолеПредставление,
				ТаблицаПредставление,
				НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект.Инвентаризация[" + ИндексСтрокиТекст + "]." + ПроверяемоеПоле);
		КонецЕсли;
	КонецЦикла;
	
	//---
	// Дубли строк
	//---
	Если УказанСчетОС Тогда
		КоллекцияИменКолонокСвязи = "ОсновноеСредство, ИнвентарныйНомер";
	ИначеЕсли УказанСчетМЗ Тогда
		КоллекцияИменКолонокСвязи = "Номенклатура";
	КонецЕсли;
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ТаблицаИмя",				"Инвентаризация");
	ПараметрыВывода.Вставить("ТаблицаПредставление",	ТаблицаПредставление);
	ПараметрыВывода.Вставить("ОбъектСсылка",			ДокументОбъект["Ссылка"]);
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ДокументОбъект["Инвентаризация"], КоллекцияИменКолонокСвязи);
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

// Настройки, определяющие режим работы документа
//
// Анализируются свойства документа:
//	Дата
//	Организация
//	Счет
//	ЦМО
Функция ПолучитьНастройкиДляРаботы(ДокументОбъект) Экспорт
	
	Счет	= ДокументОбъект["Счет"];
	ЦМО		= ДокументОбъект["ЦМО"];
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если ЗначениеЗаполнено(Счет) Тогда
		СчетаМЗ = ПолучитьСчетаУчетаМЗ();
		УказанСчетМЗ = (СчетаМЗ.Найти(Счет) <> Неопределено);
		УказанСчетОС = НЕ УказанСчетМЗ;
		
		ЕстьСубконтоЦМО	= БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		СвойстваСчета	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Счет, "УчетПоПодразделениям,УчетПоКПС");
		
		УчетПоПодразделениям	= ИспользоватьУчетПоПодразделениям И СвойстваСчета["УчетПоПодразделениям"];
		УчетПоКПС				= СвойстваСчета["УчетПоКПС"];
	Иначе
		УказанСчетМЗ			= Ложь;
		УказанСчетОС			= Ложь;
		ЕстьСубконтоЦМО			= Ложь;
		УчетПоПодразделениям	= Ложь;
		УчетПоКПС				= Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦМО) Тогда
		УказанСотрудник	= (ТипЗнч(ЦМО) = Тип("СправочникСсылка.Сотрудники"));
		УказанЦМО		= (ТипЗнч(ЦМО) = Тип("СправочникСсылка.ЦМО"));
	Иначе
		УказанСотрудник	= Ложь;
		УказанЦМО		= Ложь;
	КонецЕсли;
	
	// Анализ учетной политики
	Если ЗначениеЗаполнено(ДокументОбъект["Организация"]) Тогда
		УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(
			ДокументОбъект["Организация"],
			ДокументОбъект["Дата"]);
			
		УчетПоАналитике = УчетнаяПолитика["ВедениеАналитическогоУчетаИмуществаКазны"];
		Если УчетПоАналитике = Неопределено Тогда
			УчетПоАналитике = Ложь;
		КонецЕсли;
	Иначе
		УчетПоАналитике = Ложь;
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	
	Результат.Вставить("УказанСчетОС",					УказанСчетОС);
	Результат.Вставить("УказанСчетМЗ",					УказанСчетМЗ);
	Результат.Вставить("УчетПоПодразделениям",			УчетПоПодразделениям);
	Результат.Вставить("УчетПоКПС",						УчетПоКПС);
	Результат.Вставить("УчетПоАналитике",				УчетПоАналитике);
	
	Результат.Вставить("УказанСотрудник",				УказанСотрудник);
	Результат.Вставить("УказанЦМО",						УказанЦМО);
	Результат.Вставить("ЕстьСубконтоЦМО",				ЕстьСубконтоЦМО);
	
	Результат.Вставить("ПрименитьОтбор",				ЕстьСубконтоЦМО И (УказанСотрудник ИЛИ УказанЦМО));
	Результат.Вставить("ПрименитьОтборПоЦМО",			ЕстьСубконтоЦМО И УказанЦМО);
	Результат.Вставить("ПрименитьОтборПоСотруднику",	ЕстьСубконтоЦМО И УказанСотрудник);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуВидыДокументов() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ВидыДокументов = Новый ТаблицаЗначений();
	ВидыДокументов.Колонки.Добавить("Наименование",				ТипСтрока);
	ВидыДокументов.Колонки.Добавить("Синоним",					ТипСтрока);
	
	ВидыДокументов.Колонки.Добавить("ЭтоНедостача",				ТипБулево);
	ВидыДокументов.Колонки.Добавить("УказанСчетОС",				ТипБулево);
	ВидыДокументов.Колонки.Добавить("УказанСчетМЗ",				ТипБулево);
	ВидыДокументов.Колонки.Добавить("ИспользоватьПоУмолчанию",	ТипБулево);
	
	// Недостачи
	НС = ВидыДокументов.Добавить();
	НС["Наименование"] = "СписаниеОбъектовИК";		НС["ЭтоНедостача"] = Истина;	НС["УказанСчетОС"] = Истина;
	НС = ВидыДокументов.Добавить();
	НС["Наименование"] = "СписаниеТранспортаИК";	НС["ЭтоНедостача"] = Истина;	НС["УказанСчетОС"] = Истина;
	НС = ВидыДокументов.Добавить();
	НС["Наименование"] = "ТребованиеНакладнаяИК";	НС["ЭтоНедостача"] = Истина;	НС["УказанСчетМЗ"] = Истина;	НС["ИспользоватьПоУмолчанию"] = Истина;
	
	// Излишки
	НС = ВидыДокументов.Добавить();
	НС["Наименование"] = "ПринятиеКУчетуОбъектовИК";НС["ЭтоНедостача"] = Ложь;		НС["УказанСчетОС"] = Истина;	НС["ИспользоватьПоУмолчанию"] = Истина;
	НС = ВидыДокументов.Добавить();
	НС["Наименование"] = "ПоступлениеИК";			НС["ЭтоНедостача"] = Ложь;		НС["УказанСчетМЗ"] = Истина;	НС["ИспользоватьПоУмолчанию"] = Истина;
	
	Для Каждого СтрокаТаблицы Из ВидыДокументов Цикл
		СтрокаТаблицы["Синоним"] = Метаданные.Документы[СтрокаТаблицы["Наименование"]].Синоним;
	КонецЦикла;
	
	Возврат ВидыДокументов;
	
КонецФункции

Функция ПолучитьСпискиВидыДокументов(ДокументОбъект) Экспорт
	
	СписокНедостачи						= Новый СписокЗначений();
	СписокИзлишки						= Новый СписокЗначений();
	ВидДокументаПоУмолчаниюНедостачи	= "";
	ВидДокументаПоУмолчаниюИзлишки		= "";
	
	ТаблицаВидыДокументов = ПолучитьТаблицуВидыДокументов();
	
	НастройкиДляРаботы = ПолучитьНастройкиДляРаботы(ДокументОбъект);
	Если НастройкиДляРаботы["УказанСчетОС"] Тогда
		ПоискВидовДокументов = Новый Структура("УказанСчетОС", Истина);
	Иначе
		ПоискВидовДокументов = Новый Структура("УказанСчетМЗ", Истина);
	КонецЕсли;
	МассивСтрок = ТаблицаВидыДокументов.НайтиСтроки(ПоискВидовДокументов);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ЗаполняемыйСписок = ?(СтрокаТаблицы["ЭтоНедостача"],
			СписокНедостачи,
			СписокИзлишки);
			
		ЗаполняемыйСписок.Добавить(СтрокаТаблицы["Наименование"], СтрокаТаблицы["Синоним"]);
		
		// Вид документа по умолчанию
		Если СтрокаТаблицы["ИспользоватьПоУмолчанию"] Тогда
			Если СтрокаТаблицы["ЭтоНедостача"] Тогда
				ВидДокументаПоУмолчаниюНедостачи	= СтрокаТаблицы["Наименование"];
			Иначе
				ВидДокументаПоУмолчаниюИзлишки		= СтрокаТаблицы["Наименование"];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("Недостачи",							СписокНедостачи);
	Результат.Вставить("Излишки",							СписокИзлишки);
	Результат.Вставить("ВидДокументаПоУмолчаниюНедостачи",	ВидДокументаПоУмолчаниюНедостачи);
	Результат.Вставить("ВидДокументаПоУмолчаниюИзлишки",	ВидДокументаПоУмолчаниюИзлишки);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект) Экспорт
	
	НастройкиДляРаботы = ПолучитьНастройкиДляРаботы(ДокументОбъект);
	
	ДатаОпределенияОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации);
	
	ИспользоватьОтборПоКПС				= НастройкиДляРаботы["УчетПоКПС"]				И ЗначениеЗаполнено(ДокументОбъект["КПС"]);
	ИспользоватьОтборПоПодразделению	= НастройкиДляРаботы["УчетПоПодразделениям"]	И ЗначениеЗаполнено(ДокументОбъект["Подразделение"]);
	
	// Настраиваем запрос
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДатаЗапроса",						ДатаОпределенияОстатков);
	ЗапросЗаполнение.УстановитьПараметр("Организация",						ДокументОбъект["Организация"]);
	ЗапросЗаполнение.УстановитьПараметр("ВестиПоАналитике",					НастройкиДляРаботы["УчетПоАналитике"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет",								ДокументОбъект["Счет"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",								Перечисления.КВД.Бюджет);
	ЗапросЗаполнение.УстановитьПараметр("КПС",								ДокументОбъект["КПС"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоКПС",			ИспользоватьОтборПоКПС);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",								ДокументОбъект["ИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("БезУчетаИФО",						ДокументОбъект["БезУчетаИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросЗаполнение.УстановитьПараметр("Подразделение",					ДокументОбъект["Подразделение"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ИспользоватьОтборПоПодразделению);
	ЗапросЗаполнение.УстановитьПараметр("ОтборПоЦМО_Использовать",			НастройкиДляРаботы["ПрименитьОтбор"]);
	ЗапросЗаполнение.УстановитьПараметр("ОтборПоЦМО_Значение",				ДокументОбъект["ЦМО"]);
	ЗапросЗаполнение.УстановитьПараметр("ОтборПоЦМО_УказанСотрудник",		НастройкиДляРаботы["УказанСотрудник"]);
	ЗапросЗаполнение.УстановитьПараметр("ОтборПоЦМО_УказанЦМО",				НастройкиДляРаботы["УказанЦМО"]);
	
	ЗапросЗаполнение.УстановитьПараметр("СчетГруппа",						ДокументОбъект["Счет"]);
	ЗапросЗаполнение.УстановитьПараметр("НеЗаполнятьЦену",					ДокументОбъект["НеЗаполнятьЦену"]);
	
	// Настройки для ВариантФормированияОписи
	Если ДокументОбъект["ВариантФормированияОписи"] = 0 Тогда
		
		ПолеВыборЦены = "";
		
		ВыборПолейСчета = "";
		
		ВыборПолейСчетаОстаткиСвернутые = "";
		
		ГруппировкаПолейСчетаОстаткиСвернутые = "";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	ИначеЕсли ДокументОбъект["ВариантФормированияОписи"] = 1 Тогда
		
		ПолеВыборЦены = "КОГДА &НеЗаполнятьЦену ТОГДА 0";
		
		ВыборПолейСчета = "Счет,КПС,";
		
		ВыборПолейСчетаОстаткиСвернутые = "
			|Т.Счет	КАК Счет,
			|Т.КПС	КАК КПС,";
		
		ГруппировкаПолейСчетаОстаткиСвернутые = ",Т.Счет,Т.КПС";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	ИначеЕсли ДокументОбъект["ВариантФормированияОписи"] = 2 Тогда
		
		ПолеВыборЦены = "КОГДА &НеЗаполнятьЦену ТОГДА 0";
		
		ВыборПолейСчета = "Счет,КПС,";
		
		ВыборПолейСчетаОстаткиСвернутые = "
			|Т.Счет	КАК Счет,
			|НЕОПРЕДЕЛЕНО	КАК КПС,";
		
		ГруппировкаПолейСчетаОстаткиСвернутые = ",Т.Счет";
		
		СоединениеСТаблицейСчетовБлижайшихРодителей = "";
		
		ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = "";
		
		СдвигИндексаВсехТаблиц = 0;
		
	Иначе
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		ПолеВыборЦены = "КОГДА &НеЗаполнятьЦену ТОГДА 0";
		
		ВыборПолейСчета = "Счет,КПС,";
		
		ВыборПолейСчетаОстаткиСвернутые = "
			|БлижайшиеОбщиеРодителиСчетов.Счет	КАК Счет,
			|НЕОПРЕДЕЛЕНО	КАК КПС,";
		
		ГруппировкаПолейСчетаОстаткиСвернутые = ",БлижайшиеОбщиеРодителиСчетов.Счет";
		
		Если НастройкиДляРаботы["УказанСчетОС"] Тогда
			
			СоединениеСТаблицейСчетовБлижайшихРодителей = "
				|ЛЕВОЕ СОЕДИНЕНИЕ	БлижайшиеОбщиеРодителиСчетов
				|	ПО	Т.ОсновноеСредство = БлижайшиеОбщиеРодителиСчетов.НФА
				|	И	Т.ИнвНомер = БлижайшиеОбщиеРодителиСчетов.ИнвНомер";
			
			ТекстЗапросаБлижайшиеОбщиеРодителиСчетов = ИнвентаризацияСервер.ПолучитьТекстЗапросаБлижайшиеОбщиеРодителиСчетов(
				"ОстаткиПоЦМОиИнвНомерам",
				"ОсновноеСредство",
				"ИнвНомер",
				СдвигИндексаВсехТаблиц);
				
