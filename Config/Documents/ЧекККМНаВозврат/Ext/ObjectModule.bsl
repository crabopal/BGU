#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	ЭтотОбъект.НомерЧекаККМ = 0;
	ЭтотОбъект.НомерСменыККМ = 0;
	ЭтотОбъект.СтатусЧекаККМ = "";
	
	Для каждого ТекСтрока Из ЭтотОбъект.Оплата Цикл
		ТекСтрока.ДанныеПереданыВБанк = Ложь;
		ТекСтрока.СсылочныйНомер = "";
		ТекСтрока.НомерЧекаЭТ = "";
		ТекСтрока.НомерПлатежнойКарты = "";
	КонецЦикла;	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	// Нижеперечисленные реквизиты будут проверяться по условиям
	Если ЭтоРозничныйПокупатель Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		МассивНепроверяемыхРеквизитов.Добавить("Договор");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЧекККМ") Тогда
		Если НЕ ЭтоВозвратДеньВДень(ДанныеЗаполнения) Тогда
			ТекстСообщения = НСтр("ru = 'Чек на возврат можно ввести только для чека на продажу по текущей кассовой смене!
			|Для оформления возврата денежных средств прошлых кассовых смен следует ввести на основании чека ККМ документ ""Заявление на возврат по чеку ККМ"" 
			|и указать этот документ в списке документов-оснований документа ""Расходный кассовый ордер"" или ""Эквайринговая операция"" с операцией возврата.'");
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ЗаполнитьПоЧекуККМ(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ЧекККМНаВозврат.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по учету остатков
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ТоварыВТорговыхТочках");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КодыИСМПБГУ");
	
	ПроверитьКодыМаркировки();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоЧекуККМ(ДокументОснование)

	ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
	|Телефон, АдресЭП, ТипЦены, СуммаВключаетНДС, ЭтоРозничныйПокупатель, ФормаОплаты, СуммаДокумента, ПризнакСпособаРасчетаЧекаККМ,
	|Подразделение, УчитыватьТолькоОплату, РасчетВИнтернете, АдресСайта";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");	
	ЭтотОбъект.ЧекККМПродажа = ДокументОснование;
	
	ТЧ_ТоварыРаботыУслуги = ДокументОснование.ТоварыРаботыуслуги.Выгрузить();
	ТЧ_Оплата = ДокументОснование.Оплата.Выгрузить();
	ТЧ_РасшифровкаОплаты = ДокументОснование.РасшифровкаОплаты.Выгрузить();
	
	МассивКС10 = Новый Массив;
	МассивКС100 = Новый Массив;
	МассивКС10.Добавить(Тип("Строка"));
	МассивКС100.Добавить(Тип("Строка"));
	КС10 = Новый КвалификаторыСтроки(10);
	КС100 = Новый КвалификаторыСтроки(100);
	ОписаниеТиповС10 = Новый ОписаниеТипов(МассивКС10, , , КС10);
	ОписаниеТиповС100 = Новый ОписаниеТипов(МассивКС100, , , КС100);
	ТЧ_Оплата.Колонки.Добавить("НомерЧекаЭТВозврата", ОписаниеТиповС10);
	ТЧ_Оплата.Колонки.Добавить("СсылочныйНомерВозврата", ОписаниеТиповС100);
	
	ЭтоВозвратДеньВДень = ЭтоВозвратДеньВДень(ДокументОснование); 
	
	Если ЭтотОбъект.ФормаОплаты = 2 Тогда 
		ЭтотОбъект.ФормаОплаты = 1;
	КонецЕсли;
	Если ДокументОснование.ФормаОплаты = 1 Или ДокументОснование.ФормаОплаты = 2 Тогда
		Для каждого ТекОплата Из ТЧ_Оплата Цикл
			Если ЗначениеЗаполнено(ТекОплата.ТипОплаты) Тогда
				НоваяСтрока = ЭтотОбъект.Оплата.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекОплата); 
				
				НоваяСтрока.НомерЧекаЭТВозврата = ТекОплата.НомерЧекаЭТ;
				НоваяСтрока.СсылочныйНомерВозврата = ТекОплата.СсылочныйНомер;
				НоваяСтрока.НомерПлатежнойКарты = ТекОплата.НомерПлатежнойКарты;
				
				НоваяСтрока.ДанныеПереданыВБанк = Ложь;
				НоваяСтрока.НомерЧекаЭТ = "";
				НоваяСтрока.СсылочныйНомер = "";
				НоваяСтрока.ПроцентКомиссии = ?(ЭтоВозвратДеньВДень, (-1)*ТекОплата.ПроцентКомиссии, 0);
				НоваяСтрока.СуммаКомиссии = ?(ЭтоВозвратДеньВДень, (-1)*ТекОплата.СуммаКомиссии, 0);
				
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	ЭтотОбъект.ТоварыРаботыуслуги.Загрузить(ТЧ_ТоварыРаботыУслуги);
	ЭтотОбъект.РасшифровкаОплаты.Загрузить(ТЧ_РасшифровкаОплаты);
	
КонецПроцедуры

Функция ЭтоВозвратДеньВДень(ДокументОснование)
	Результат = Ложь;
	
	ТекущаяКассоваяСмена = РозничныеПродажиБГУ.ТекущаяОткрытаяКассоваяСмена(ДокументОснование.Организация, ДокументОснование.КассаККМ);	
	КассоваяСменаЧекаОснования = ДокументОснование.КассоваяСмена;
	Если (КассоваяСменаЧекаОснования = ТекущаяКассоваяСмена) Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ПроверитьКодыМаркировки()
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	Если НЕ ДополнительныеСвойства.Свойство("СозданИзРМК") И РозничнаяРеализацияМаркированныхТоваров Тогда 
		Для Каждого СтрокаТаблицы Из ЭтотОбъект.ТоварыРаботыУслуги Цикл 
			Если СтрокаТаблицы.МаркируемыйТовар И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КодМаркировки) Тогда 
				ТекстОшибки = НСтр("ru='В строке %1 списка ""Товары, работы, услуги"" не заполнен код маркировки!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ТоварыРаботыУслуги", "Объект");
			КонецЕсли;
			Если СтрокаТаблицы.МаркируемыйТовар И СтрокаТаблицы.Количество <> 1 Тогда 
				ТекстОшибки = НСтр("ru='В строке %1 списка ""Товары, работы, услуги"" количество не равно 1!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ТоварыРаботыУслуги", "Объект");
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли