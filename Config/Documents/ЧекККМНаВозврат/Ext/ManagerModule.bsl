#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	ВестиКонтрольОстатковТоваров = РозничныеПродажиБГУ.ВестиКонтрольОстатковТоваров(ДокументСсылка.КассаККМ);
	Запрос.УстановитьПараметр("ВестиКонтрольОстатковТоваров", ВестиКонтрольОстатковТоваров);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслугРабот", РозничныеПродажиБГУ.ТипыУслугРабот());
	
	ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();

	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла; 
	
	ДобавитьДвиженияОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЧекККМНаВозврат";
	КомандаПечати.Идентификатор		= "ТоварныйЧек";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.Представление		= НСтр("ru = 'Товарный чек'");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ТоварныйЧек") Тогда
		
		ТабличныйДокумент = ПечатьТоварныйЧек(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ТоварныйЧек","Товарный чек", ТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьТоварныйЧек(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЧекаККМ_ТоварныйЧек";
	РеквизитыДокумента = Новый Структура("Номер, Дата, Префикс");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМ.Ссылка,
	               |	ЧекККМ.Номер,
	               |	ЧекККМ.Дата,
	               |	ЧекККМ.КассаККМ.НаименованиеМестаРасчета КАК МестоРасчета,
	               |	ЧекККМ.КассаККМ.АдресМестаРасчета КАК АдресМестаРасчета,
	               |	ЛОЖЬ КАК ЭтоВозврат,
	               |	ВЫБОР
	               |		КОГДА ЧекККМ.Организация.НаименованиеПолное = """"
	               |			ТОГДА ЧекККМ.Организация.Наименование
	               |		ИНАЧЕ ЧекККМ.Организация.НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеОрганизации,
	               |	ЧекККМ.Организация.ИНН,
	               |	ЧекККМ.Организация,
	               |	ЧекККМ.СуммаДокумента,
	               |	ЧекККМ.Ответственный КАК Ответственный
	               |ИЗ
	               |	Документ.ЧекККМНаВозврат КАК ЧекККМ
	               |ГДЕ
	               |	ЧекККМ.Ссылка В(&МассивОбъектов)
	               |	И ЧекККМ.Проведен = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЧекККМ.Ссылка,
	               |	ЧекККМ.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаОплата.ТипОплаты КАК ТипОплаты,
	               |	ТаблицаОплата.Ссылка КАК Ссылка,
	               |	ПРЕДСТАВЛЕНИЕ(ТаблицаОплата.ТипОплаты) КАК ПредставлениеТипОплаты,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТаблицаОплата.ТипОплаты <> ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
	               |				ТОГДА ТаблицаОплата.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаБезналичныхОплат,
	               |	СУММА(ТаблицаОплата.Сумма) КАК Сумма
	               |ИЗ
	               |	Документ.ЧекККМНаВозврат.Оплата КАК ТаблицаОплата
	               |ГДЕ
	               |	ТаблицаОплата.Ссылка В(&МассивОбъектов)
	               |	И ТаблицаОплата.Ссылка.Проведен
	               |	И ТаблицаОплата.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаОплата.Ссылка,
	               |	ТаблицаОплата.ТипОплаты
	               |
	               |ИМЕЮЩИЕ
	               |	НЕ СУММА(ТаблицаОплата.Сумма) = 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаТовары.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ТаблицаТовары.Номенклатура.Наименование КАК Товар,
	               |	ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК НоменклатураПредставление,
	               |	ТаблицаТовары.Номенклатура.Код КАК КолонкаКодов,
	               |	"""" КАК ХарактеристикаПредставление,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения) КАК ПредставлениеБазовойЕдиницыИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	               |	ТаблицаТовары.Количество КАК Количество,
	               |	ТаблицаТовары.Цена КАК Цена,
	               |	ТаблицаТовары.Сумма КАК Сумма,
	               |	ТаблицаТовары.Ссылка КАК Ссылка,
	               |	ТаблицаТовары.Скидка,
	               |	ТаблицаТовары.СтавкаНДС,
	               |	ТаблицаТовары.СуммаНДС,
	               |	ТаблицаТовары.Всего,
	               |	ТаблицаТовары.ЦенаБезСкидок,
	               |	ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК ПолноеНаименование
	               |ИЗ
	               |	Документ.ЧекККМНаВозврат.ТоварыРаботыУслуги КАК ТаблицаТовары
	               |ГДЕ
	               |	ТаблицаТовары.Ссылка В(&МассивОбъектов)
	               |	И ТаблицаТовары.Ссылка.Проведен
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка,
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка";
				   
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ТоварныйЧек");
	
	ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьПоставщик 	= Макет.ПолучитьОбласть("Поставщик");
	ОбластьИНН       	= Макет.ПолучитьОбласть("ИНН");
	ОбластьМестоРасчета = Макет.ПолучитьОбласть("Магазин");
	
	ОбластьШапкаНомера 	= Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
	ОбластьШапкаКодов  	= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаКодов");
	ОбластьШапкаДанных 	= Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	ОбластьШапкаСкидок 	= Макет.ПолучитьОбласть("ШапкаТаблицы|Скидка");
	ОбластьШапкаСуммы  	= Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма");
	
	ОбластьКолонкаТовар = Макет.Область("Товар");
	
	ОбластьСтрокаНомера = Макет.ПолучитьОбласть("Строка|НомерСтроки");
	ОбластьСтрокаКодов  = Макет.ПолучитьОбласть("Строка|КолонкаКодов");
	ОбластьСтрокаДанных = Макет.ПолучитьОбласть("Строка|Данные");
	ОбластьСтрокаСкидок = Макет.ПолучитьОбласть("Строка|Скидка");
	ОбластьСтрокаСуммы  = Макет.ПолучитьОбласть("Строка|Сумма");
	
	// Вывести Итого.
	ОбластьИтогоНомера = Макет.ПолучитьОбласть("Итого|НомерСтроки");
	ОбластьИтогоКодов  = Макет.ПолучитьОбласть("Итого|КолонкаКодов");
	ОбластьИтогоДанных = Макет.ПолучитьОбласть("Итого|Данные");
	ОбластьИтогоСкидок = Макет.ПолучитьОбласть("Итого|Скидка");
	ОбластьИтогоСуммы  = Макет.ПолучитьОбласть("Итого|Сумма");
	
	ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьПодписей      = Макет.ПолучитьОбласть("Подписи");
	
	ОбластьОплата = Макет.ПолучитьОбласть("Оплата");
	
	ВыборкаПоДокументам = Результаты[0].Выбрать();
	ВыборкаПоТабличнойЧастиОплата = Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПоТабличнымЧастям = Результаты[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		Если НЕ ВыборкаПоТабличнымЧастям.НайтиСледующий(Новый Структура("Ссылка",ВыборкаПоДокументам.Ссылка)) Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаПоСтрокамТЧ = ВыборкаПоТабличнымЧастям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если НЕ ПервыйДокумент Тогда
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СинонимДокумента   = НСтр("ru='Товарный чек (возврат)'");
		
		ЗаполнитьЗначенияСвойств(РеквизитыДокумента, ВыборкаПоДокументам);
		ОбластьЗаголовок.Параметры.ТекстЗаголовка = СформироватьЗаголовокДокумента(РеквизитыДокумента, СинонимДокумента);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьПоставщик.Параметры.ПредставлениеПоставщика = ВыборкаПоДокументам.НаименованиеОрганизации;
		ОбластьПоставщик.Параметры.Поставщик = ВыборкаПоДокументам.Организация;
		ТабличныйДокумент.Вывести(ОбластьПоставщик);
		

		ОбластьИНН.Параметры.ИНН = ВыборкаПоДокументам.ОрганизацияИНН;
		ТабличныйДокумент.Вывести(ОбластьИНН);

		ОбластьМестоРасчета.Параметры.ПредставлениеМагазина = ВыборкаПоДокументам.МестоРасчета + ", " + ВыборкаПоДокументам.АдресМестаРасчета;
		ТабличныйДокумент.Вывести(ОбластьМестоРасчета);
		
		// Шапка
		ТабличныйДокумент.Вывести(ОбластьШапкаНомера);
		
		ОбластьШапкаКодов.Параметры.ИмяКолонкиКодов = "Код";
		ТабличныйДокумент.Присоединить(ОбластьШапкаКодов);
		
		ТабличныйДокумент.Присоединить(ОбластьШапкаДанных);
		ТабличныйДокумент.Присоединить(ОбластьШапкаСкидок);
		ТабличныйДокумент.Присоединить(ОбластьШапкаСуммы);
		
		
		ВсегоНаименований = 0;
		Сумма             = 0;
		ВсегоСкидок       = 0;
		ВсегоБезСкидок    = 0;
		
		// СТРОКИ ТЧ
		Пока ВыборкаПоСтрокамТЧ.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаПоСтрокамТЧ.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			ОбластьСтрокаНомера.Параметры.Заполнить(ВыборкаПоСтрокамТЧ);
			ТабличныйДокумент.Вывести(ОбластьСтрокаНомера);

			ОбластьСтрокаКодов.Параметры.Артикул = ВыборкаПоСтрокамТЧ["КолонкаКодов"];
			ТабличныйДокумент.Присоединить(ОбластьСтрокаКодов);

			ОбластьСтрокаДанных.Параметры.Заполнить(ВыборкаПоСтрокамТЧ);
			
			НаименованиеНоменклатуры = ВыборкаПоСтрокамТЧ.НоменклатураПредставление;
			Если НЕ ЗначениеЗаполнено(НаименованиеНоменклатуры) Тогда
				НаименованиеНоменклатуры = ВыборкаПоСтрокамТЧ.ПолноеНаименование;
			КонецЕсли;	
			ОбластьСтрокаДанных.Параметры.Товар = НаименованиеНоменклатуры;
			
			ОбластьСтрокаДанных.Параметры.Цена = Окр(ВыборкаПоСтрокамТЧ.Всего / ВыборкаПоСтрокамТЧ.Количество, 2);
			ТабличныйДокумент.Присоединить(ОбластьСтрокаДанных);
			
			Скидка = Окр(ВыборкаПоСтрокамТЧ.Скидка * ВыборкаПоСтрокамТЧ.Количество, 2);
			ОбластьСтрокаСкидок.Параметры.Скидка = Скидка;
			ОбластьСтрокаСкидок.Параметры.СуммаБезСкидки = ВыборкаПоСтрокамТЧ.Всего + Скидка;
			ТабличныйДокумент.Присоединить(ОбластьСтрокаСкидок);

			ОбластьСтрокаСуммы.Параметры.Сумма = ВыборкаПоСтрокамТЧ.Всего;
			ТабличныйДокумент.Присоединить(ОбластьСтрокаСуммы);
			
			ВсегоНаименований = ВсегоНаименований + 1;
			
			Сумма          = Сумма + ВыборкаПоСтрокамТЧ.Всего;
			ВсегоСкидок    = ВсегоСкидок + Скидка;
			ВсегоБезСкидок = Сумма + ВсегоСкидок;
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьИтогоНомера);
		ТабличныйДокумент.Присоединить(ОбластьИтогоКодов);
		
		ТабличныйДокумент.Присоединить(ОбластьИтогоДанных);
		ОбластьИтогоСкидок.Параметры.ВсегоСкидок    = ВсегоСкидок;
		ОбластьИтогоСкидок.Параметры.ВсегоБезСкидок = ВсегоБезСкидок;
		ТабличныйДокумент.Присоединить(ОбластьИтогоСкидок);
		ОбластьИтогоСуммы.Параметры.Всего = Сумма;
		ТабличныйДокумент.Присоединить(ОбластьИтогоСуммы);
		
		// Вывести Сумму прописью.
		
		ТекстИтоговойСтроки = НСтр("ru = 'Всего наименований %ВсегоНаименований%, на сумму %Итого%'");
		
		ТекстИтоговойСтроки = СтрЗаменить(ТекстИтоговойСтроки,"%ВсегоНаименований%", ВсегоНаименований);
		ТекстИтоговойСтроки = СтрЗаменить(ТекстИтоговойСтроки,"%Итого%", Формат(Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧГ=0"));
		
		ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ОбластьСуммаПрописью.Параметры.ИтоговаяСтрока = ТекстИтоговойСтроки;
		ОбластьСуммаПрописью.Параметры.СуммаПрописью  = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Сумма, ВалютаРубли);
		
		ТабличныйДокумент.Вывести(ОбластьСуммаПрописью);
		
		// Оплата
		ВыводитьДанныеОСдаче = Ложь;
		
		Если ВыводитьДанныеОСдаче Тогда
			Если ВыборкаПоТабличнойЧастиОплата.НайтиСледующий(Новый Структура("Ссылка",ВыборкаПоДокументам.Ссылка)) Тогда
				
				ОплатаДобавлена = Ложь;
				СтрокаОплаты = "";
				СуммаБезналичныхОплат = 0;
				СуммаОплат = 0;
				
				ВыборкаПоОплата = ВыборкаПоТабличнойЧастиОплата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаПоОплата.Следующий() Цикл
					Если ОплатаДобавлена Тогда
						СтрокаОплаты = СтрокаОплаты + Символы.ПС;
					КонецЕсли;
					ОплатаДобавлена = Истина;
					СтрокаОплаты = СтрокаОплаты + ВыборкаПоОплата.ПредставлениеТипОплаты + ": "  + Формат(ВыборкаПоОплата.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧН=; ЧГ=0");
					СуммаБезналичныхОплат = СуммаБезналичныхОплат + ВыборкаПоОплата.СуммаБезналичныхОплат;
					СуммаОплат = СуммаОплат + ВыборкаПоОплата.Сумма;
				КонецЦикла;
				
				Если ВыборкаПоДокументам.ЭтоВозврат Тогда
					СуммаНаличных = ВыборкаПоДокументам.СуммаДокумента - СуммаБезналичныхОплат;
					Если СуммаНаличных > 0  Тогда
						Если ОплатаДобавлена Тогда
							СтрокаОплаты = СтрокаОплаты + Символы.ПС;
						КонецЕсли;
						СтрокаОплаты = СтрокаОплаты + НСтр("ru = 'Наличные:'") + " " + Формат(СуммаНаличных, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧН=; ЧГ=0");
					КонецЕсли;
					ОбластьОплата.Параметры.Сдача = "0,00";
				Иначе
					ОбластьОплата.Параметры.Сдача = Формат(СуммаОплат - ВыборкаПоДокументам.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧН=; ЧГ=0");
				КонецЕсли;
				
				ОбластьОплата.Параметры.Оплата = СтрокаОплаты;
				ТабличныйДокумент.Вывести(ОбластьОплата);
			КонецЕсли;
		КонецЕсли;
		
		// ПОДПИСИ
		ОбластьПодписей.Параметры.Заполнить(ВыборкаПоДокументам);
		РеквизитыКассир = ВыборкаПоДокументам.Ответственный.ФизическоеЛицо;
		ОбластьПодписей.Параметры.ФИО = РеквизитыКассир.Наименование;
		ТабличныйДокумент.Вывести(ОбластьПодписей);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаПоДокументам.Ссылка);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
КонецФункции // ПечатьТоварныйЧек

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьЗаголовокДокумента(Шапка, НазваниеДокумента = "", ФорматДаты = "") Экспорт
	
	Если НазваниеДокумента = ""
		И Шапка.Свойство("Представление")
		И ЗначениеЗаполнено(Шапка.Представление) Тогда
		
		ПоложениеНомера = Найти(Шапка.Представление,Шапка.Номер);
		
		Если ПоложениеНомера > 0 Тогда
			НазваниеДокумента = СокрЛП(Лев(Шапка.Представление,ПоложениеНомера-1));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ФорматДаты) Тогда
		ФорматДаты = "ДФ='дд ММММ гггг'";
	КонецЕсли;
	
	Возврат НазваниеДокумента + " № " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер, Ложь, Истина)
	                          + " от " + Формат(Шапка.Дата, ФорматДаты) + " г.";
	
КонецФункции // СформироватьЗаголовокДокумента()

Процедура ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ТоварыВТорговыхТочках", НомераТаблиц.Количество()+1);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата КАК Период,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка КАК Регистратор,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО КАК ЦМО,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК Номенклатура,
	|	СУММА(ИзмененияОстатковТоваровВТорговойТочкеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	Документ.ЧекККМНаВозврат.ТоварыРаботыУслуги КАК ИзмененияОстатковТоваровВТорговойТочкеТовары
	|ГДЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка = &Ссылка
	|	И &ВестиКонтрольОстатковТоваров = ИСТИНА
	|	И ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ПоступлениеТоваровНаСкладТорговойТочки = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДвиженияТоваров.Период КАК Период,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.Организация КАК Организация,
	|	ДвиженияТоваров.ЦМО КАК ЦМО,
	|	ДвиженияТоваров.Номенклатура КАК Номенклатура,
	|	ДвиженияТоваров.Количество КАК Количество
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров
	|ГДЕ
	|	НЕ ДвиженияТоваров.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслугРабот)";
	
КонецПроцедуры

Процедура ДобавитьДвиженияОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка"		, ДокументСсылка);  
	Запрос.УстановитьПараметр("КонтрольКодовИСМП"	, ОбменИСМПБГУ.ВедетсяКонтрольОстатковКодовИСМП(ДокументСсылка.Организация));
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.Организация КАК Организация,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.КодМаркировки КАК КодИСМП,
	               |	ВЫРАЗИТЬ(ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК Номенклатура,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.Дата КАК Период,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка КАК Регистратор,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Количество КАК Количество,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ВТКоды
	               |ИЗ
	               |	Документ.ЧекККМНаВозврат.ТоварыРаботыУслуги КАК ЧекККМНаВозвратТоварыРаботыУслуги
	               |ГДЕ
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка = &ДокументСсылка
	               |	И &КонтрольКодовИСМП = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТКоды.Организация КАК Организация,
	               |	ВТКоды.КодИСМП КАК КодИСМП,
	               |	ВТКоды.Номенклатура КАК Номенклатура,
	               |	ВТКоды.Период КАК Период,
	               |	ВТКоды.Регистратор КАК Регистратор,
	               |	СУММА(ВТКоды.Количество) КАК Количество,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения
	               |ИЗ
	               |	ВТКоды КАК ВТКоды
	               |ГДЕ
	               |	ВТКоды.КодИСМП <> """"
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТКоды.Организация,
	               |	ВТКоды.КодИСМП,
	               |	ВТКоды.Номенклатура,
	               |	ВТКоды.Период,
	               |	ВТКоды.Регистратор"; 
			
	ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();  
	
	Для Каждого СтрокаЗапроса Из ТаблицаДвиженийОстаткиКодовИСМП Цикл 
		КодМаркировки = МенеджерОборудованияКлиентСервер.Base64ВШтрихкод(СтрокаЗапроса.КодИСМП);
		СтрокаЗапроса.КодИСМП = СтрЗаменить(КодМаркировки, ОбщегоНазначенияБПОКлиентСервер.РазделительGS1(), "");
	КонецЦикла;	
	
	ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);  
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
