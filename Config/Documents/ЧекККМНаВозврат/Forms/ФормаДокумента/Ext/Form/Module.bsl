	ТипЦеныДоИзменения = Объект.ТипЦены;
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
		
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		УстановитьДанныеДляПечатиЧековККМ(Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	УстановитьДоступностьДоговора(ЭтаФорма);
	
	ЗаполнениеДанныхДляЧекаККМ();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаОплатыПриИзменении(Элемент)
	Если Объект.ФормаОплаты = 1 Тогда
		Если НЕ ИспользоватьОплатуПлатежнымиКартами Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включите флажок ""Оплата платежными картами (эквайринг)"" для возможности принимать оплату платежными картами. Флажок следует включить на закладке ""Денежные средства"" (раздел ""Администрирование""/""Настройка параметров учета""). '");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнены параметры договора эквайринга для рабочего места.
			|В разделе ""Администрирование"" в ""Настройки параметров учета/Денежные средства/Оплата платежными картами (эквайринг)"" следует открыть 
			|настройку  ""Настройки ККТ и эквайринга для рабочих мест"", указать параметры договора эквайринга для рабочего места и сохранить.'");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли;	
		
		ОплатаБылаНаличными = Ложь;
		Если ЗначениеЗаполнено(Объект.ЧекККМПродажа) Тогда
			ОплатаБылаНаличными = ?(ПолучитьФормуОплатыЧекаПродажи(Объект.ЧекККМПродажа)=0,Истина,Ложь);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не указан чек продажи. Если оплата была выполнена платежной картой, то укажите ""Номер платежной карты"",
			|""Номер чека ЭТ возврата"", ""Ссылочный номер возврата"" из слип-чека!'");
			Сообщение.Сообщить();
		КонецЕсли;	
		
		Если ОплатаБылаНаличными Тогда
			Объект.ФормаОплаты = 0;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Оплата была выполнена наличными. Нельзя провести возврат оплаты на платежную карту!'");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли
	Иначе
		ОплатаБылаПлатежнойКартой = Ложь;
		Если ЗначениеЗаполнено(Объект.ЧекККМПродажа) Тогда
			ОплатаБылаПлатежнойКартой = ?(ПолучитьФормуОплатыЧекаПродажи(Объект.ЧекККМПродажа)=1,Истина,Ложь);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не указан чек продажи. Если оплата была выполнена платежной картой, то укажите ""Номер платежной карты"",
			|""Номер чека ЭТ возврата"", ""Ссылочный номер возврата"" из слип-чека!'");
			Сообщение.Сообщить();
		КонецЕсли;	
		
		Если ОплатаБылаПлатежнойКартой Тогда
			Объект.ФормаОплаты = 1;
			 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Оплата была выполнена платежной картой. Возврат оплаты наличными можно выполнить только через ""Расходный кассовый ордер""!
			|Для оформления возврата следует ввести на основании чека продажи документ ""Перечень номенклатуры прейскуранта для возврата""
			|и затем в документе ""Расходный кассовый ордер"" указать его в списке документов-оснований для чека ККМ.'");
			Сообщение.Сообщить();
			 
			Возврат;
		КонецЕсли
		
	КонецЕсли;	 
	
	Если Объект.ФормаОплаты = 1 Тогда
		Если СуммаОплатыНаличными > 0 Тогда
			СуммаОплатыПлатежнойКартой = СуммаОплатыНаличными;	
		Конецесли;	
		УстановитьНастройкиОплатыПлатежнойКартой();
	Иначе
		Если СуммаОплатыПлатежнойКартой > 0 Тогда
			СуммаОплатыНаличными = СуммаОплатыПлатежнойКартой;	
		Конецесли;	
		УстановитьНастройкиНаличнойОплаты();
	КонецЕсли;	
	УстановитьВидимостьЭлементовФормы();
	УстановитьКартинкиЭлементовФормы();
КонецПроцедуры

Функция ПолучитьФормуОплатыЧекаПродажи(ЧекПродажи)
	Результат = 0;
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЧекПродажи, "ФормаОплаты");
	
	Результат = СтруктураДанных.ФормаОплаты;
	
	Если Результат = 2 Тогда 
		Результат = 1;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


