Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ФискальныеОперации

&НаКлиенте
Процедура ПробитьЧекВыполнить(ОповещениеПриЗавершении)
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если НомерКассовогоЧека <> 0 Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
		
		Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ);
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.КассаККМ];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		Если ИспользоватьБезПримененияККТ Тогда
			ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи);
			
			НомерДокументаКассыККМ[Объект.КассаККМ] = ПорядковыйНомерПродажи +	1;
				
			Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
			
			ЭтотОбъект.Доступность = Истина;
			НомерКассовогоЧека = НомерЧекаДляДокумента();
			ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
			УстановитьВидимостьЭлементовФормы();
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
		
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		ПроверитьКодыМаркировки(ИдентификаторУстройстваФР);
		
		ЭтотОбъект.Доступность = Ложь;

		// Готовим данные
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
			
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается при нажатии кнопки "НапечататьЧек" командной панели.
//
&НаКлиенте
Процедура ПробитьЧекНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ПробитьЧекСПроверкойСтавокНДС();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если ЧекПробит Тогда
		ТолькоПросмотр = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
	
	УстановитьВидимостьЭлементовЭквайринга(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьПриИсправленииЧека();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементовЭквайринга(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьПриИсправленииЧека();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаСервере
Функция ЕстьЧекНепримененияККТ()
	Результат = Ложь;
	
	ЧекНепримененияККТ = ПодключаемоеОборудованиеБГУ.ИсправительныйЧекККМОперацииНепримененияККТ(Объект.Ссылка);
	Если ЗначениеЗаполнено(ЧекНепримененияККТ) Тогда
		ТекстСообщения = НСтр("ru = 'Кассовый чек не может быть напечатан. Для документа %1 
		|введен документ ""Исправительный чек ККМ"" с видом операции ""Неприменение ККТ""!
		|Документ %2 можно открыть через ""Связанные документы"" меню навигации.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.Ссылка, ЧекНепримененияККТ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены(ПросмотрЧека = Ложь)
	Результат = Истина;
	
	Если НЕ ПросмотрЧека Тогда
		ЕстьЧекНепримененияККТ = ЕстьЧекНепримененияККТ();
		Если ЕстьЧекНепримененияККТ Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" реквизита ""Ответственный""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СистемаНалогообложенияЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
		Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Кассовая смена""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассоваяСмена");
			
			Результат = Ложь;	
		Иначе
			Если НЕ (Объект.КассоваяСмена.КассаККМ = Объект.КассаККМ) Тогда
				ТекстСообщения = НСтр("ru = 'Касса ККМ документа ""Кассовая смена"" не соответствует реквизиту ""Касса ККМ""!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассоваяСмена");
				
				Результат = Ложь;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ТипРасчета");
		
		Результат = Ложь;	
	КонецЕсли;
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	СуммаВсего = СтавкаДокумента.Всего;
	Если СуммаВсего <> Объект.СуммаДокумента Тогда
		Если НЕ(Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты) Тогда
			ТекстСообщения = НСтр("ru = 'Сумма оплаты не равна итоговой сумме товаров, работ, услуг! Следует использовать команду ""Заполнить"" справа от суммы оплаты'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка);
	ЕстьПустыеНаименованияТоваровУслуг = Ложь;
	ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
	НомераСтрокПустыхНаименований = "";
	НомераСтрокПустыхПредметовРасчета = "";
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Наименование) Тогда
			ЕстьПустыеНаименованияТоваровУслуг = Истина;
			НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета) Тогда
			ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
			НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
	КонецЦикла;	
	
	Если ЕстьПустыеНаименованияТоваровУслуг Тогда
		НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
		Если НомераСтрокПустыхНаименований = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека пустое наименование номенклатуры! 
			|Следует в документе-основании заполнить номенклатуру и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека пустые наименования номенклатуры!
			|Следует в документах-основаниях для этих строк заполнить номенклатуру и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
		НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
		Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета! 
			|Следует в документе-основании заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета!
			|Следует в документах-основаниях для этих строк заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	ПолучательЧекаККМ = Объект.Контрагент;
	Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
		ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.НомерТелефонаДляЭлектронногоЧекаКорректен(АбонентскийНомерТелефона) Тогда
			ТекстСообщения = НСтр("ru = 'Номер телефона для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АбонентскийНомерТелефона");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес электронной почты для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АдресЭлектроннойПочты");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			Попытка
				СохраненныйТелефон = Число(АбонентскийНомерТелефона);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"АбонентскийНомерТелефона");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонSMS = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, ТелефонSMS, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьЗаполненияСуммы(Форма) Экспорт
	
	Результат = Истина;
	
	Если Форма.Модифицированность Тогда
		
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после записи документа'"));
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПроверитьВозможностьПечатиЧека()

&НаСервере
Процедура ТоварыРаботыУслугиПослеУдаленияНаСервере()
	РассчитатьИтоги();
КонецПроцедуры

&НаСервере
Процедура ЭтоРозничныйПокупательПриИзмененииНаСервере()
	ЗаполнятьКонтрагентаИДоговор = ЗаполнятьКонтрагентаИДоговор();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Контрагент", "Видимость", ЗаполнятьКонтрагентаИДоговор);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Договор", "Видимость", ЗаполнятьКонтрагентаИДоговор);
	
	Если НЕ ЗаполнятьКонтрагентаИДоговор Тогда
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();	
		Объект.Договор = Справочники.Договоры.ПустаяСсылка();	
		
		Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	Иначе
		Объект.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Функция ЭтоВозвратДеньВДень()
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ЧекККМПродажа) Тогда
		КассоваяСменаЧекаОснования = Объект.ЧекККМПродажа.КассоваяСмена;
		Если (КассоваяСменаЧекаОснования = Объект.КассоваяСмена) Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЧекККМПродажаПриИзмененииНаСервере()
	ДокументОснование = Объект.ЧекККМПродажа;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ЗаполняемыеДанные = "Организация, КассаККМ, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, Контрагент, Договор, 
		|Телефон, АдресЭП, ТипЦены, СуммаВключаетНДС, ЭтоРозничныйПокупатель, ФормаОплаты, СуммаДокумента, ПризнакСпособаРасчетаЧекаККМ";
		ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
		ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
		
		Объект.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");	
		Объект.ЧекККМПродажа = ДокументОснование;
		
		ТЧ_ТоварыРаботыУслуги = ДокументОснование.ТоварыРаботыуслуги.Выгрузить();
		ТЧ_Оплата = ДокументОснование.Оплата.Выгрузить();
		ТЧ_РасшифровкаОплаты = ДокументОснование.РасшифровкаОплаты.Выгрузить();
		
		МассивКС10 = Новый Массив;
		МассивКС100 = Новый Массив;
		МассивКС10.Добавить(Тип("Строка"));
		МассивКС100.Добавить(Тип("Строка"));
		КС10 = Новый КвалификаторыСтроки(10);
		КС100 = Новый КвалификаторыСтроки(100);
		ОписаниеТиповС10 = Новый ОписаниеТипов(МассивКС10, , , КС10);
		ОписаниеТиповС100 = Новый ОписаниеТипов(МассивКС100, , , КС100);
		ТЧ_Оплата.Колонки.Добавить("НомерЧекаЭТВозврата", ОписаниеТиповС10);
		ТЧ_Оплата.Колонки.Добавить("СсылочныйНомерВозврата", ОписаниеТиповС100);
		
		Если ДокументОснование.ФормаОплаты = 1 Тогда
			Для каждого ТекОплата Из ТЧ_Оплата Цикл
				Если ЗначениеЗаполнено(ТекОплата.ТипОплаты) Тогда
					Если Объект.Оплата.Количество() > 0 Тогда 
						НоваяСтрока = Объект.Оплата[0];
					Иначе	
						НоваяСтрока = Объект.Оплата.Добавить();
					КонецЕсли;	
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекОплата); 
					
					НоваяСтрока.НомерЧекаЭТВозврата = ТекОплата.НомерЧекаЭТ;
					НоваяСтрока.СсылочныйНомерВозврата = ТекОплата.СсылочныйНомер;
					НоваяСтрока.НомерПлатежнойКарты = ТекОплата.НомерПлатежнойКарты;
					
					НоваяСтрока.ДанныеПереданыВБанк = Ложь;
					НоваяСтрока.НомерЧекаЭТ = "";
					НоваяСтрока.СсылочныйНомер = "";
					НоваяСтрока.ПроцентКомиссии = 0;
					НоваяСтрока.СуммаКомиссии = 0;
					
					Прервать;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
		
		Объект.ТоварыРаботыуслуги.Загрузить(ТЧ_ТоварыРаботыУслуги);
		Объект.РасшифровкаОплаты.Загрузить(ТЧ_РасшифровкаОплаты);
		
	КонецЕсли;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура ТипЦеныПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПересчитатьЦеныНоменклатуры();
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Нет Тогда
		Объект.ТипЦены = ТипЦеныДоИзменения;
		УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныНоменклатуры()

	МассивНоменклатуры = МассивНоменклатуры(Объект.ТоварыРаботыУслуги.Выгрузить(, "Номенклатура"));
	
	ТаблицаЦен = ПолучитьЦенуНоменклатуры(МассивНоменклатуры,
		Объект.ТипЦены, Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.ТоварыРаботыУслуги Цикл
	
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрока.Номенклатура.Номенклатура, "Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			ТекСтрока.Цена = СтрокаЦены.Цена;
		Иначе
			ТекСтрока.Цена = 0;
		КонецЕсли;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

	РассчитатьИтоги();	
	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
КонецПроцедуры // ПересчитатьЦеныНоменклатуры()

&НаСервере
Функция МассивНоменклатуры(МассивИзПрейскуранта)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Номенклатура
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Ссылка В(&МассивИзПрейскуранта)";
	Запрос.УстановитьПараметр("МассивИзПрейскуранта", МассивИзПрейскуранта);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.ВыгрузитьКолонку("Номенклатура");
КонецФункции

&НаСервере
Процедура ПризнакСпособаРасчетаЧекаККМПриИзмененииНаСервере()
	Объект.СуммаДокумента = 0;
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры

&НаСервере
Процедура УдалитьТоварыУслугиКромеОтмеченныхНаСервере()
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка", Ложь);
	НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(ПараметрыОтбора);
	ВсегоНайдено = НайденныеСтроки.Количество();
	Если ВсегоНайдено > 0 Тогда
		Для н = 1 По ВсегоНайдено Цикл
			Объект.ТоварыРаботыУслуги.Удалить(НайденныеСтроки[ВсегоНайдено-н].НомерСтроки-1);
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПометки(Пометка = Неопределено)

	Для каждого ТекСтр Из Объект.ТоварыРаботыУслуги Цикл
		
		НовоеЗначениеПометки = ?(Пометка = Неопределено, Не ТекСтр.Пометка, Пометка);
		
		ТекСтр.Пометка = НовоеЗначениеПометки;
	
	КонецЦикла;

КонецПроцедуры // ИзменитьПометки()

&НаКлиенте
Процедура УдалитьСтрокиТоваровУслугОбработатьОтвет(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	Иначе
		УдалитьТоварыУслугиКромеОтмеченныхНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВывестиПредставлениеЧека()
	ЕстьОшибки = Ложь;
	ЧекСформирован = Ложь;
	
	КассаККМЧека = Объект.КассаККМ;
	
	ОчиститьСообщения();
	
	Если ЭтаФорма.Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены(Истина) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ДанныеЧекаДляДокумента = ДанныеЧекаДляДокумента();
		
		НомерКассовогоЧека = ДанныеЧекаДляДокумента.НомерЧекаККМ;		
		
		Если (НомерКассовогоЧека = 0) ИЛИ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда   
			НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерДокКассыККМ = ?(НомерДокументаКассыККМ[Объект.КассаККМ]=Неопределено, 0, НомерДокументаКассыККМ[Объект.КассаККМ]);
			НомерЧека = НомерДокКассыККМ+1;
		Иначе
			НомерЧека = НомерКассовогоЧека;	
			ЧекСформирован = Истина;
		КонецЕсли;	
		
		ОбщиеПараметры = ПодготовитьДанныеДляПросмотраЧека(НомерЧека);
		
		Если ОбщиеПараметры = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Недостаточно данных для просмотра кассового чека.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли;
		
		Если ЧекСформирован Тогда
			ОбщиеПараметры.ДатаВремя = ДанныеЧекаДляДокумента.ДатаЧекаККМ;	
		КонецЕсли;	
		
		ВерсияФФД = ВерсияФФД(КассаККМЧека);
		
		ТекстЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 34, ВерсияФФД);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстЧека);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("ИдентификаторЗаписи", ДанныеЧекаДляДокумента.ИдентификаторЗаписи);

		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраЧекаККМ", ПараметрыФормы, , Объект,,,, Режим);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияФФД(КассаККМЧека) Экспорт
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
КонецФункции

&НаСервере
Функция НомерЧекаДляДокумента()
	Если Объект.НомерЧекаККМ<>0 Тогда
		Возврат Объект.НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Функция ДанныеЧекаДляДокумента()
	Результат = Новый Структура;
	Результат.Вставить("НомерЧекаККМ", 0);
	Результат.Вставить("ДатаЧекаККМ", Дата(1,1,1));
	Результат.Вставить("ФискальныйПризнак", "");
	Результат.Вставить("ИдентификаторЗаписи", "");
	
	Если Объект.НомерЧекаККМ<>0 Тогда
		Результат.НомерЧекаККМ = Объект.НомерЧекаККМ;
		Результат.ДатаЧекаККМ = Объект.Дата;
		
		Возврат Результат;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента(НомерЧека)
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека", ТекущаяДата());
	ПараметрыФискализации.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыФискализации.Вставить("Организация", Объект.Организация);
	ПараметрыФискализации.Вставить("ТипРасчета", Объект.ТипРасчета);
	ПараметрыФискализации.Вставить("НомерСменыККТ", 1);
	ПараметрыФискализации.Вставить("НомерЧекаККТ", НомерЧека);
	ПараметрыФискализации.Вставить("ФискальныйПризнак", Строка(НомерЧека));
	ПараметрыФискализации.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки", "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН", "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит", "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML", Неопределено);
	
	ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	СуммаЧека = 0;
	ОплатаНаличные = 0;
	ОплатаЭлектронно = 0;
	ОплатаПостоплата = 0;
	ОплатаПредоплата = 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека", СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные", ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно", ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата", ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата", ОплатаПостоплата);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьФискальнуюОперацию(ПараметрыФискализации);

КонецПроцедуры

&НаСервере
Функция ЗаключительныйЧекИсправительный()
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);

КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьПриИсправленииЧека()
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	ВидимостьКнопкиПечатьЧекаККМ = Истина;
	ЕстьЗаключительныйЧекИсправительный = Ложь;
	
	Если СтатусЧекаККМПробит Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВидимостьКнопкиПечатьЧекаККМ = Истина;
			ЕстьЗаключительныйЧекИсправительный = Истина;
		Иначе
			ВидимостьКнопкиПечатьЧекаККМ = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 		"Видимость", ВидимостьКнопкиПечатьЧекаККМ);
	
КонецПроцедуры	

&НаКлиенте
Функция ПодготовитьДанныеДляПросмотраЧека(НомерЧека)
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
		
		Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Возврат Результат;
	КонецЕсли;	
	
	ДанныеЧека = ДанныеЧекаДляДокумента();
	Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) И ЗначениеЗаполнено(ДанныеЧека.ТекстовыеДанныеXML) Тогда
		Результат = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ДанныеЧека.ТекстовыеДанныеXML);
		
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПробитьЧекСПроверкойСтавокНДС()
	ЕстьУстаревшиеСтавкиНДС = Ложь;
	ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(Объект.Ссылка, ЕстьУстаревшиеСтавкиНДС);
	
	Если ЕстьУстаревшиеСтавкиНДС Тогда
		ТекстСообщения = НСтр("ru='При формировании кассового чека используется устаревшая ставка НДС. Прервать печать чека?'");
		Оповещение = Новый ОписаниеОповещения("ПрерватьПечатьКассовогоЧекаПриЗамечаниях", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ЭтотОбъект.Доступность = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;	
КонецПроцедуры		

&НаКлиенте
Процедура ПрерватьПечатьКассовогоЧекаПриЗамечаниях(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ЭтотОбъект.Доступность = Ложь;
			
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(ДокументПечатиЧека, ЕстьУстаревшиеСтавкиНДС)
	
	УстаревшиеСтавкиНДС = ПодключаемоеОборудованиеБГУ.УстаревшиеСтавкиНДС();
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(ДокументПечатиЧека);
	ТаблицаНоменклатуры.Свернуть("СтавкаНДС");
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если НЕ УстаревшиеСтавкиНДС.Найти(ТекСтрока.СтавкаНДС) = Неопределено Тогда
			ЕстьУстаревшиеСтавкиНДС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДанныхДляЧекаККМ()

	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека); 
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека)
	
	Если Не ЗначениеЗаполнено(НомерКассовогоЧека) Тогда  
		Если ЗначениеЗаполнено(Объект.КассаККМ) И ЗаполнятьПочтуИТелефонДляОтправкиЧека() Тогда 	
			АдресПочты 		= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйАдресЭлектроннойПочтыПокупателя(Объект.Контрагент);
			НомерТелефона 	= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйНомерТелефонаПокупателя(Объект.Контрагент);
			Если ЗначениеЗаполнено(АдресПочты) Тогда 
				АдресЭлектроннойПочты = АдресПочты;
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
				ОтказПокупателяОтСохраненияДанных = Истина;
			ИначеЕсли ЗначениеЗаполнено(НомерТелефона) Тогда 
				ТелефонSMS = 0;
				ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(НомерТелефона, ТелефонSMS, ТелефонСтрокой);
				АбонентскийНомерТелефона = "7" + Формат(НомерТелефона, "ЧЦ=10; ЧДЦ=; ЧГ=0");
				АдресЭлектроннойПочты = "";
				ДанныеSMSИлиEmail = ТелефонСтрокой;
				ОтказПокупателяОтСохраненияДанных = Истина;  
			Иначе
				АдресЭлектроннойПочты = "";
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = "";
			КонецЕсли;  
			ЗаписатьДополнительныеДанныеЧековККМ();  
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = "";	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнятьПочтуИТелефонДляОтправкиЧека()
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ЗаполнятьПочтуИТелефонДляОтправкиЧека");
	
КонецФункции

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ДополнительныеДанныеЧекаККМ = Новый Структура;
		ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", Объект.Ссылка);
		ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", Объект.Контрагент);
		ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", АбонентскийНомерТелефона);
		ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
		ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказПокупателяОтСохраненияДанных);
		
		ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ);
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(Объект.Ссылка);
	АбонентскийНомерТелефона = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭлектроннойПочты = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	ОтказПокупателяОтСохраненияДанных = ДополнительныеСведенияКассовогоЧека.ОтказПокупателяОтСохраненияДанных;
	Если Объект.ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		ОтказПокупателяОтСохраненияДанных = Объект.ОтказКлиентаОтСохраненияТелефонаEmail;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область МаркировкаТоваров

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения <> Неопределено Тогда 
		Если РезультатВыполнения.УдалитьТоварИзСписка Тогда 
			Объект.ТоварыРаботыУслуги.Удалить(Элементы.ТоварыРаботыУслуги.ТекущиеДанные)
		Иначе	
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.КодМаркировки 		= РезультатВыполнения.КодМаркировки;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РезультатПроверкиКМ 	= РезультатВыполнения.РезультатПроверкиКМ;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.АдресДанныхПроверкиКМ	= РезультатВыполнения.АдресДанныхПроверкиКМ;
		КонецЕсли;	
		СессияПроверкиКМОткрыта = РезультатВыполнения.СессияПроверкиКМОткрыта;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьУсловноеОформлениеМаркировка()
	
	УсловноеОформление.Элементы.Очистить();
	
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКодМаркировки");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.КодМаркировки", ВидСравненияКомпоновкиДанных.Равно, "");
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКодМаркировки");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеРамкаСтрокиЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не используется'"));
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКодМаркировки");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.КодМаркировки", ВидСравненияКомпоновкиДанных.Равно, "");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеПлохаяОценкаЦвет);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКоличество");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеРамкаСтрокиЦвет);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКодМаркировки");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.КодМаркировки", ВидСравненияКомпоновкиДанных.НеРавно, "");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.РезультатПроверкиКМ", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеПлохаяОценкаЦвет);

		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиКодМаркировки");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.КодМаркировки", ВидСравненияКомпоновкиДанных.НеРавно, "");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.РезультатПроверкиКМ", ВидСравненияКомпоновкиДанных.Равно, Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветАкцента);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыРаботыУслугиКодМаркировки", "Видимость", РозничнаяРеализацияМаркированныхТоваров);

КонецПроцедуры

&НаСервере
Функция МаркируемыйТовар(ИдентификаторСтроки)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки).Номенклатура);
	СписокМаркируемыхТоваров = РозничныеПродажиБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ПроверитьЗакрытиеСессииПроверкиКМ()
	
	Если СессияПроверкиКМОткрыта Тогда 
		ПараметрыКассыККМ 			= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
		ИдентификаторУстройстваФР 	= ПараметрыКассыККМ.ИдентификаторУстройства;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеЗакрытиеСессииПроверкиКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытииСессииРегистрацииКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР);
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеЗакрытиеСессииПроверкиКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		СессияПроверкиКМОткрыта = Ложь;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура СохранитьДобавленныеКолонки()
	
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		АдресаРезультатовПроверкиКМ.Очистить();
		Для Каждого СтрокаАдреса Из Объект.ТоварыРаботыУслуги Цикл 
			АдресаРезультатовПроверкиКМ.Добавить(СтрокаАдреса.АдресДанныхПроверкиКМ);
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДобавленныеКолонки()
	
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		Для Каждого СтрокаАдреса Из Объект.ТоварыРаботыУслуги Цикл 
			СтрокаАдреса.АдресДанныхПроверкиКМ = АдресаРезультатовПроверкиКМ[СтрокаАдреса.НомерСтроки - 1].Значение;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодыМаркировки(ИдентификаторУстройстваФР)              
	
	МенеджерОборудованияКлиент.НачатьПодключениеОборудования(Неопределено, ЭтотОбъект, , ИдентификаторУстройстваФР);
	
	Если ИспользуетсяККТСПередачейДанных И РозничнаяРеализацияМаркированныхТоваров И ВерсияФФД(Объект.КассаККМ) = "1.2" Тогда 
		Для Каждого СтрокаТовар Из Объект.ТоварыРаботыУслуги Цикл 
			Если СтрокаТовар.МаркируемыйТовар И СтрокаТовар.АдресДанныхПроверкиКМ = "" Тогда 
				ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР);	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР)
	
	УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
	ПараметрыОперации.ИдентификаторЗапроса 			= УникальныйИдентификаторЗапроса;
	ПараметрыОперации.Количество 					= СтрокаТовар.Количество;  
	ПараметрыОперации.ДробноеКоличество.Числитель   = 0;     
	ПараметрыОперации.ДробноеКоличество.Знаменатель = 0;     
	ПараметрыОперации.МераКоличестваПредметаРасчета = ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Штука");
	ПараметрыОперации.ПланируемыйСтатусТовара 		= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	ПараметрыОперации.КонтрольнаяМарка 				= СтрокаТовар.КодМаркировки;
	ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ 	= Ложь;
	
	ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", УникальныйИдентификаторЗапроса, ИдентификаторУстройстваФР);
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМ", ЭтотОбъект, ДопПараметры);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗапросКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", Параметры.УникальныйИдентификаторЗапроса, Параметры.ИдентификаторУстройстваФР);
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПолучениеОтветаКМ", ЭтотОбъект, ДопПараметры);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолученияРезультатовЗапросаКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, Неопределено);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершениеПолучениеОтветаКМ(РезультатВыполнения, Параметры) Экспорт

	Если РезультатВыполнения.Результат Тогда
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		ПараметрыОперации.ИдентификаторЗапроса 	= Параметры.УникальныйИдентификаторЗапроса;
		ПараметрыОперации.Выбытие				= Истина;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПодтвержденияКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, ПараметрыОперации);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗавершениеПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

&НаСервере
Процедура ЗаполнитьПараметрыНДССКомиссии()
	
	ДанныеОВидеКартыИПроценте = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(ПараметрыДоговораЭквайринга, ВидПлатежнойКарты);
	Если ДанныеОВидеКартыИПроценте <> Неопределено Тогда 
		НДССКомиссииСверху = ДанныеОВидеКартыИПроценте.НДССКомиссииСверху;
		СтавкаНДССКомиссии = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ДанныеОВидеКартыИПроценте.СтавкаНДССКомисии, Не НДССКомиссииСверху);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

