&НаКлиенте
Процедура ТоварыРаботыУслугиКоличествоПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиЦенаПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	РассчитатьИтоги();	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.ТипЦены, Объект.Дата,
		Объект.Организация);
	ТекущиеДанные.Цена = Цена;
	КоличествоПоУмолчанию = 1;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
		ТекущиеДанные.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
		КоличествоПоУмолчанию = ДанныеНоменклатуры.Количество;
	КонецЕсли;
	
	РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, ТекущиеДанные, "КлючСвязи");
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = КоличествоПоУмолчанию;
		
	КонецЕсли;
	
	Если ТекущиеДанные.Количество <> 0 Тогда
		РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
		РассчитатьИтоги();	
	КонецЕсли;
	
	ТекущиеДанные.МаркируемыйТовар = МаркируемыйТовар(ТекущиеДанные.ПолучитьИдентификатор());
	
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСтавкаНДСПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "СтавкаНДС");
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСуммаПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "Сумма");
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСуммаНДСПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.ТоварыРаботыУслуги.ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДС");
	РассчитатьИтоги();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные.КлючСвязи = 0;
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, ТекущиеДанные, "КлючСвязи");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиПослеУдаления(Элемент)
	ТоварыРаботыУслугиПослеУдаленияНаСервере();
	ОбновитьДанныеЗаголовкаТоварыРаботыуслуги(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТоварыРаботыУслугиКодМаркировки" Тогда 
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("Номенклатура"				, ТекущиеДанные.Номенклатура);
			ПараметрыОткрытияФормы.Вставить("КодМаркировки"				, ТекущиеДанные.КодМаркировки);
			ПараметрыОткрытияФормы.Вставить("СессияПроверкиКМОткрыта"	, СессияПроверкиКМОткрыта);
			ПараметрыОткрытияФормы.Вставить("КассаККМ"					, Объект.КассаККМ);
			ПараметрыОткрытияФормы.Вставить("АдресДанныхПроверкиКМ"		, ТекущиеДанные.АдресДанныхПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РезультатПроверкиКМ"		, ТекущиеДанные.РезультатПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РежимПродажи"				, 1);
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВводКодаМаркировки", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

