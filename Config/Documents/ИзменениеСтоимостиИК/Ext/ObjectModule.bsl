#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ОсновныеСредства.ИнвентарныйНомер"));
	
	ПроверитьНомераОС = Новый Массив;	
	Для Каждого ТекущаяСтрока Из ОсновныеСредства Цикл		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) Тогда
			ПроверитьНомераОС.Добавить(ТекущаяСтрока.ОсновноеСредство);	
		КонецЕсли;
	КонецЦикла;
	
	Если ПроверитьНомераОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОС"		, ПроверитьНомераОС);
	Запрос.УстановитьПараметр("Период"	, Дата);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство В (&ОС)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ИнвНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Для Каждого ТекущаяСтрока Из ОсновныеСредства Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) И Результат.Найти(ТекущаяСтрока.ОсновноеСредство) <> Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнен инвентарный номер в строке %1'"), ТекущаяСтрока.НомерСтроки);
			Поле = СтрШаблон("Объект.ОсновныеСредства[%1].ИнвентарныйНомер", Формат(ТекущаяСтрока.НомерСтроки-1, "ЧН=0; ЧГ="));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,Поле,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("СтоимостьНовая") - ОсновныеСредства.Итог("Стоимость");
	Если СуммаДокумента = 0 Тогда
		СуммаДокумента = ОсновныеСредства.Итог("СуммаАмортизацииНовая") - ОсновныеСредства.Итог("СуммаАмортизации");
	КонецЕсли;
	Если ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Списание
		Или ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Передача Тогда
		СуммаДокумента = - СуммаДокумента;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли