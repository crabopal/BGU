Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,ВидОперации,Дата");
	
	ИзменениеАмортизации	= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Амортизация);
	УвеличениеСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Увеличение);
	СписаниеСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Списание);
	ПередачаСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Передача);
	ИзменениеНормы			= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Норма);
	
	УвеличениеАмортизации	= (ИзменениеАмортизации Или УвеличениеСтоимости);
	ИзменениеСтоимости		= (УвеличениеСтоимости Или СписаниеСтоимости Или ПередачаСтоимости);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"					, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"				, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("УвеличениеСтоимости"		, УвеличениеСтоимости);
	Запрос.УстановитьПараметр("СписаниеСтоимости"		, СписаниеСтоимости);
	Запрос.УстановитьПараметр("УвеличениеАмортизации"	, УвеличениеАмортизации);
	Запрос.УстановитьПараметр("ИзменениеСтоимости"		, ИзменениеСтоимости);
	Запрос.УстановитьПараметр("ИзменениеНормы"			, ИзменениеНормы);
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|				И ОсновныеСредства.ПорядокПогашенияСтоимостиНовый <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ТОГДА 0
	|		ИНАЧЕ ОсновныеСредства.СПИНовый 
	|	КОНЕЦ КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|				И ОсновныеСредства.ПорядокПогашенияСтоимостиНовый <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ТОГДА 0
	|		КОГДА ОсновныеСредства.ОставшийсяСрокНовый < 1
	|			ТОГДА 1
	|		ИНАЧЕ ОсновныеСредства.ОставшийсяСрокНовый
	|	КОНЕЦ КАК СрокИспользованияДляВычисленияАмортизации,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|				И ОсновныеСредства.ПорядокПогашенияСтоимостиНовый <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ТОГДА 0
	|		ИНАЧЕ ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.СуммаАмортизацииНовая 
	|	КОНЕЦ КАК СтоимостьДляВычисленияАмортизации
	|ИЗ
	|	Документ.ИзменениеСтоимостиИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.Ссылка.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияСтоимостиОС.Амортизация)
	|	И (ОсновныеСредства.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияСтоимостиОС.Норма)
	|			ИЛИ (ОсновныеСредства.Стоимость <> ОсновныеСредства.СтоимостьНовая
	|			И (ОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|				ИЛИ ОсновныеСредства.ПорядокПогашенияСтоимостиНовый = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)))
	|			ИЛИ ОсновныеСредства.СуммаАмортизации <> ОсновныеСредства.СуммаАмортизацииНовая
	|			ИЛИ ОсновныеСредства.СПИ <> ОсновныеСредства.СПИНовый
	|			ИЛИ ОсновныеСредства.ОставшийсяСрок <> ОсновныеСредства.ОставшийсяСрокНовый)";
	
	ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ПорядокПогашенияСтоимостиНовый КАК ПорядокПогашенияСтоимости,
	|	ОсновныеСредства.СпособНачисленияАмортизацииНовый КАК СпособНачисленияАмортизации
	|ИЗ
	|	Документ.ИзменениеСтоимостиИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И &ИзменениеСтоимости
	|	И (ОсновныеСредства.ПорядокПогашенияСтоимости <> ОсновныеСредства.ПорядокПогашенияСтоимостиНовый
	|			ИЛИ ОсновныеСредства.СпособНачисленияАмортизации <> ОсновныеСредства.СпособНачисленияАмортизацииНовый)";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.Стоимость КАК Стоимость,
	|	ОсновныеСредства.Причина КАК Причина
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ИзменениеСтоимостиИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И &ИзменениеСтоимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер
	|					ИЗ
	|						ВТ_Таблица КАК ВТ_Таблица
	|					ГДЕ
	|						ВТ_Таблица.Стоимость <> 0)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &УвеличениеСтоимости
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Договор КАК Договор,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ВЫБОР
	|		КОГДА &УвеличениеСтоимости
	|			ТОГДА ОсновныеСредства.Стоимость
	|		ИНАЧЕ -ОсновныеСредства.Стоимость
	|	КОНЕЦ КАК Стоимость,
	|	0 КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Прочее) КАК Событие,
	|	ОсновныеСредства.Ссылка.ВидПервичногоДокумента КАК НазваниеДокумента,
	|	ОсновныеСредства.Ссылка.НомерПервичногоДокумента КАК НомерДокумента,
	|	ОсновныеСредства.Ссылка.ДатаПервичногоДокумента КАК ДатаДокумента,
	|	ОсновныеСредства.Причина КАК Причина
	|ИЗ
	|	ВТ_Таблица КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ОсновныеСредства.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ОсновныеСредства.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|ГДЕ
	|	ОсновныеСредства.Стоимость <> 0";
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &УвеличениеАмортизации
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА &УвеличениеАмортизации
	|			ТОГДА ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаАмортизации
	|		ИНАЧЕ ОсновныеСредства.СуммаАмортизации - ОсновныеСредства.СуммаАмортизацииНовая
	|	КОНЕЦ КАК СуммаАмортизации,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	Документ.ИзменениеСтоимостиИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И НЕ &ИзменениеНормы
	|	И ОсновныеСредства.СуммаАмортизации <> ОсновныеСредства.СуммаАмортизацииНовая";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

