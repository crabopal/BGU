&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");	
	ТабДанных = Документы.ИзменениеСтоимостиОС.ПолучитьДанныеОС(Объект.Дата, Объект.Организация, ДобавленныеСтроки); 
	Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		ДанныеСтроки = ТабДанных.НайтиСтроки(Отбор);
		
		Если ТипЗнч(ДанныеСтроки) = Тип("Массив") И ДанныеСтроки.Количество() <> 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСтроки[0]);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	
	СхемаКомпоновки = ПолучитьИзВременногоХранилища(СхемаКомпоновкиАдрес);
	
	Настройки = СхемаКомпоновки.ВариантыНастроек["Основной"].Настройки;
	Настройки.Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ОтборЗаполнения) Тогда
		Отбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(Объект.ОтборЗаполнения);
		ОбщийМодульСКД.СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, Отбор);
	КонецЕсли;
	
	ПараметрыСхемы = Настройки.ПараметрыДанных.Элементы;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "Период"		, Объект.Дата);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "ИФО"			, Объект.ИФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "КФО"			, Объект.КФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрыСхемы, "Организация"	, Объект.Организация);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
		Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Объект.ОсновныеСредства.Очистить();

	Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");	
	ТабДанных = Документы.ИзменениеСтоимостиОС.ПолучитьДанныеОС(Объект.Дата, Объект.Организация, Результат); 
	Для Каждого СтрокаТаблицы Из Результат Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		ДанныеОС = ТабДанных.НайтиСтроки(Отбор);
		
		Если ТипЗнч(ДанныеОС) = Тип("Массив") И ДанныеОС.Количество() <> 0 Тогда
			ТекущаяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеОС[0]);
		КонецЕсли;
	КонецЦикла;		

КонецПроцедуры

