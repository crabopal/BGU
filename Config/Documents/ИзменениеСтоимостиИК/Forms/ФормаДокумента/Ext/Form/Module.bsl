&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	СхемаКомпоновки = Документы.ИзменениеСтоимостиОС.ПолучитьМакет("Отбор");
	СхемаКомпоновкиАдрес = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
	Если Не ПустаяСтрока(Объект.ОтборЗаполнения) Тогда
		ПараметрыНастройки = Новый Структура("СхемаКомпоновки,Отбор", СхемаКомпоновкиАдрес, Объект.ОтборЗаполнения);
		ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, ПредставлениеОтбора);
	КонецЕсли;
	
	Если ПустаяСтрока(ПредставлениеОтбора) Тогда
		ПредставлениеОтбора = "не установлен";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКолонок()
	
	НеАмортизация	= (Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияСтоимостиОС.Амортизация"));
	НеУвеличение	= (Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияСтоимостиОС.Увеличение"));
	НеНорма			= (Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийИзмененияСтоимостиОС.Норма"));
	
	АналитическийУчет		= ЭтаФорма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	НачислятьАмортизацию	= ЭтаФорма.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
	АнУчетСАмортизацией		= АналитическийУчет И НачислятьАмортизацию;
	
	Элементы.ОсновныеСредстваИнвентарныйНомер.Видимость					= АналитическийУчет;
	
	Элементы.ОсновныеСредстваСПИ.Видимость								= АнУчетСАмортизацией И НеАмортизация;
	Элементы.ОсновныеСредстваСПИНовый.Видимость							= АнУчетСАмортизацией И НеАмортизация;
	
	Элементы.ОсновныеСредстваОставшийсяСрок.Видимость					= АнУчетСАмортизацией И НеАмортизация;
	Элементы.ОсновныеСредстваОставшийсяСрокНовый.Видимость				= АнУчетСАмортизацией И НеАмортизация;
	
	Элементы.ОсновныеСредстваСпособНачисленияАмортизации.Видимость		= АнУчетСАмортизацией И НеАмортизация И НеНорма;
	Элементы.ОсновныеСредстваСпособНачисленияАмортизацииНовый.Видимость	= АнУчетСАмортизацией И НеНорма;
	
	Элементы.ОсновныеСредстваПорядокПогашенияСтоимости.Видимость		= АнУчетСАмортизацией И НеАмортизация И НеНорма;
	Элементы.ОсновныеСредстваПорядокПогашенияСтоимостиНовый.Видимость	= АнУчетСАмортизацией И НеАмортизация И НеНорма;
	
	Элементы.ОсновныеСредстваСпособНачисленияАмортизации.Видимость		= АнУчетСАмортизацией И НеАмортизация И НеНорма;
	Элементы.ОсновныеСредстваСпособНачисленияАмортизацииНовый.Видимость	= АнУчетСАмортизацией И НеАмортизация И НеНорма;
	
	Элементы.ОсновныеСредстваСтоимость.Видимость						= НеАмортизация;
	Элементы.ОсновныеСредстваСтоимостьНовая.Видимость					= НеАмортизация И НеНорма;
	Элементы.ОсновныеСредстваПричина.Видимость							= НеАмортизация И НеНорма;
	
	Элементы.ОсновныеСредстваСуммаАмортизации.Видимость					= АнУчетСАмортизацией;
	Элементы.ОсновныеСредстваСуммаАмортизацииНовая.Видимость			= АнУчетСАмортизацией И НеНорма;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОССтруктурой(Дата, Организация, ОсновноеСредство, ИнвентарныйНомер = Неопределено)
	Возврат Документы.ИзменениеСтоимостиОС.ДанныеОССтруктурой(Дата, Организация, ОсновноеСредство, ИнвентарныйНомер);
КонецФункции	
	
&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперации");
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, "108.00");
	
	СИнвНомером = ЭтаФорма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, ВидРаспоряжения);
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "СчетУчета,КПС,ЦМО,Количество,Сумма,СуммаОбесценения" + ?(СИнвНомером, "", ",ИнвентарныйНомер"));
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "Стоимость"));
	
КонецПроцедуры

