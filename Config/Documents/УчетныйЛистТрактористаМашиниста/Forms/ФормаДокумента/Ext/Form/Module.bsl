КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияДокумента(ОсновноеСредство)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	ТаблицаНастроек = УчетГСМ.ДанныеНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты, ИдентификаторДокумента, ОсновноеСредство);
	
	Для Каждого ТекСтрока Из ТаблицаНастроек Цикл
		ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
		ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = ТекСтрока.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
		
		Объект.МОЛ = ТекСтрока.Водитель;
		
		Если ЗначениеЗаполнено(ТекСтрока.Водитель) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Подразделение", ТекСтрока.Водитель, Объект.Дата);
			СотрудникСтруктура = ПолучитьДанныеСотрудника(ДанныеСотрудника);
			
			Объект.Бригада = СотрудникСтруктура.КодПодразделения;
		КонецЕсли;
		
		Объект.Подразделение = ТекСтрока.РЛАПодразделение;
		
		Объект.РуководительПодразделения = ТекСтрока.РЛАРуководительПодразделения;
		Объект.Прицепщик = ТекСтрока.Прицепщик;
		Объект.Бригадир = ТекСтрока.Бригадир;
		Объект.Участок = ТекСтрока.Участок;
		
		ОсновнойПараметрРасчета = ТекСтрока.РЛАОсновнойПараметрРасчета;
		ЕдиницаИзмеренияРаботы = ТекСтрока.ЕдиницаИзмеренияРаботы;
		
		//горючее
		НастройкиГорючего = УчетГСМ.ДанныеНастроекГорючегоТС(Объект.Организация, ОсновноеСредство);
		
		Объект.ДвижениеГорючего.Очистить();
		Для Каждого ТекСтрока Из НастройкиГорючего Цикл
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			НоваяСтрока.МаркаГорючего = ТекСтрока.МаркаГорючего.МаркаГорючего;
			НоваяСтрока.КодМаркиГорючего = ТекСтрока.МаркаГорючего.КодМаркиГорючего;
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура РезультатыРаботыАгрегатаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЭтоНоваяСтрока = НоваяСтрока;
	
	ТекущиеДанные = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
	ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущиеДанные);
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока тогда
		ТекущаяСтрока = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
		Если Копирование Тогда
			Возврат;
		КонецЕсли;
		ТекущаяСтрока.ПоказателиРасчета = НСтр("ru='Ввести данные о работе агрегата'");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РезультатыРаботыАгрегатаПриАктивизацииЯчейки(Элемент)
	Если Элементы.РезультатыРаботыАгрегата.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.РезультатыРаботыАгрегата.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "РезультатыРаботыАгрегатаПоказателиРасчета"
			И НЕ Элементы.РезультатыРаботыАгрегата.ТекущиеДанные.ПоказателиРасчетаЗаполнены Тогда
			ВыбраннаяСтрока = Элементы.РезультатыРаботыАгрегата.ТекущаяСтрока;
			ОткрытьФормуВводаПоказателейРасчета(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаПоказателейРасчета(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.РезультатыРаботыАгрегата.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ДатаРабот, ПродолжительностьРаботы, ПродолжительностьРаботыСтр, КоличествоОбработанныхМЦ,
		|ПоказанияСчетчикаНаНачало, ПоказанияСчетчикаНаКонец, ПоказанияСчетчика, ЕдиницаИзмеренияРаботы");
		
		
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ИдентификаторФормулыРасчета", 0);
	Если НЕ ЗначениеЗаполнено(ПараметрыФормы.ЕдиницаИзмеренияРаботы) Тогда
		ПараметрыФормы.ЕдиницаИзмеренияРаботы = ЕдиницаИзмеренияРаботы;
	КонецЕсли;
	
	Если ПараметрыФормы.ПродолжительностьРаботы > 0 Тогда
		ПараметрыФормы.ИдентификаторФормулыРасчета = 1;	
	ИначеЕсли ПараметрыФормы.КоличествоОбработанныхМЦ > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 2;	
	ИначеЕсли ПараметрыФормы.ПоказанияСчетчика > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
	Иначе
		Если ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПродолжительностьРаботы") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 1;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.КоличествоОбработанныхМЦ") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 2;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПоказанияСчетчика") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
		КонецЕсли;			
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВводаПоказателейРасчетаДляАгрегата", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбОстаткахГорючего(ПоДокументу, ПоТаксировке)
	
	ПредыдущийУчетныйЛист = УчетГСМ.НайтиПредыдущийУчетныйЛист(Объект.Ссылка, Объект.Агрегат, Объект.Дата);
	
	ДанныеГорючего = УчетГСМ.ОстаткиГорючегоПоПутевомуЛисту(ПредыдущийУчетныйЛист);
	
	Если ПоТаксировке Тогда
		ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПредыдущийУчетныйЛист);
	ИначеЕсли ПоДокументу Тогда
		Объект.ДвижениеГорючего.Очистить();
		Для Каждого ТекСтрока Из ДанныеГорючего Цикл
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГСМ;
			НоваяСтрока.МаркаГорючего = ТекСтрока.МаркаГСМ;
			НоваяСтрока.КодМаркиГорючего = ТекСтрока.КодМаркиГСМ;
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеТаксировкиОГорючемПриВозвращении(ПутевойЛистТС)
	
	ОстатокГСМ = 0;
	
	ДанныеГорючего = УчетГСМ.ДвиженияГорючегоРасчетные(ПутевойЛистТС);
	
	Объект.ДвижениеГорючего.Очистить();
	Для каждого ТекСтрока Из ДанныеГорючего Цикл
		Если ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
			НоваяСтрока = Объект.ДвижениеГорючего.Добавить();
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении;
			НоваяСтрока.МаркаГорючего = СокрЛП(ТекСтрока.ВидГСМ.МаркаГорючего);
			НоваяСтрока.КодМаркиГорючего = СокрЛП(ТекСтрока.ВидГСМ.КодМаркиГорючего);
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ДвижениеГорючего Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыДвижениеГорючего(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДвижениеГорючего(ТекущаяСтрока)

	ТекущаяСтрока.МаркаГорючегоЗаголовок = НСтр("ru = 'марка:'");
	ТекущаяСтрока.КодМаркиГорючегоЗаголовок = НСтр("ru = 'код марки:'");
	ТекущаяСтрока.ОстатокПриВыездеЗаголовок = НСтр("ru = 'выезд:'");
	ТекущаяСтрока.ОстатокПриВозвращенииЗаголовок = НСтр("ru = 'возвращение:'");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыРежимов()
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");
	Для Каждого СтрокаТаблицы Из Объект.РезультатыРаботыАгрегата Цикл
		ЗаполнитьДобавленныеКолонкиПоказателиРасчета(СтрокаТаблицы, ПоляФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ДанныеСтроки, ПоляФормы=Неопределено) Экспорт
	ПоказателиРасчетаТекст = НСтр("ru='Ввести данные о работе агрегата'");
	ПоказателиРасчетаЗаполнены = Ложь;
	
	Идентификатор = 0;
	Если ДанныеСтроки[ПоляФормы.Время]>0 Тогда
		Идентификатор = 1;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Количество]>0 Тогда         
		Идентификатор = 2;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Счетчик]>0 Тогда
		Идентификатор = 3;
	КонецЕсли;	
	
	Если Идентификатор = 1 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Продолжительность работы: %1'"),
		УчетВремениКлиентСервер.ЧислоВСтроку(ДанныеСтроки[ПоляФормы.Время]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 2 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объем работы: %1 %2'"),
		Формат(ДанныеСтроки[ПоляФормы.Количество], "ЧЦ=17; ЧДЦ=2; ЧН=-"), Строка(ДанныеСтроки[ПоляФормы.ЕдиницаИзмеренияРаботы]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 3 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Показания счетчика: %1'"),
		Формат(ДанныеСтроки[ПоляФормы.Счетчик], "ЧЦ=17; ЧН=-"));
		ПоказателиРасчетаЗаполнены = Истина;
	КонецЕсли;	
	
	ДанныеСтроки.ПоказателиРасчета          = ПоказателиРасчетаТекст;
	ДанныеСтроки.ПоказателиРасчетаЗаполнены = ПоказателиРасчетаЗаполнены;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПоказателейРасчетаНаКлиенте(СтруктураПоказателейРасчета)
	ТекущиеДанные = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
	ТекущиеДанные.ПродолжительностьРаботы = 0;
	ТекущиеДанные.КоличествоОбработанныхМЦ = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаНачало = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаКонец = 0;
	ТекущиеДанные.ПоказанияСчетчика = 0;
	
	ИдентификаторФормулыРасчета = СтруктураПоказателейРасчета.ИдентификаторФормулыРасчета;
	
	Если ИдентификаторФормулыРасчета = 1 Тогда
		Если СтруктураПоказателейРасчета.ПродолжительностьРаботы = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПродолжительностьРаботы = СтруктураПоказателейРасчета.ПродолжительностьРаботы;
			ТекущиеДанные.ПродолжительностьРаботыСтр = СтруктураПоказателейРасчета.ПродолжительностьРаботыСтр;
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 2 Тогда
		Если СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.КоличествоОбработанныхМЦ = СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ;
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 3 Тогда
		Если СтруктураПоказателейРасчета.ПоказанияСчетчика = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПоказанияСчетчикаНаНачало = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаНачало;
			ТекущиеДанные.ПоказанияСчетчикаНаКонец = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаКонец;
			ТекущиеДанные.ПоказанияСчетчика = СтруктураПоказателейРасчета.ПоказанияСчетчика;
		КонецЕсли;
	КонецЕсли;
	
	ТекущиеДанные.ЕдиницаИзмеренияРаботы = СтруктураПоказателейРасчета.ЕдиницаИзмеренияРаботы;
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");

	ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ТекущиеДанные, ПоляФормы);
		 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыАгрегата(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.РезультатыРаботыАгрегата Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущаяСтрока)

	ТекущаяСтрока.НаименованиеРаботыЗаголовок = НСтр("ru = 'наименование:'");
	ТекущаяСтрока.ОператорЗаголовок = НСтр("ru = 'оператор:'");
	
	ТекущаяСтрока.ГСМПолученоЗаголовок = НСтр("ru = 'получено:'");
	ТекущаяСтрока.ГСМИзрасходованоЗаголовок = НСтр("ru = 'израсходовано:'");
	
	
	ТекущаяСтрока.НормаВыработкиЗаголовок = НСтр("ru = 'норма:'");
	ТекущаяСтрока.РасценкаЗаголовок = НСтр("ru = 'расценка:'");
	
	ТекущаяСтрока.ОплатаОсновнаяЗаголовок = НСтр("ru = 'основная:'");
	ТекущаяСтрока.ОплатаДопЗаголовок = НСтр("ru = 'дополнительная:'");
	
	ТекущаяСтрока.ОплатаВсегоЗаголовок = НСтр("ru = 'всего:'");
	ТекущаяСтрока.ОплатаПрицепщикаЗаголовок = НСтр("ru = 'прицепщику:'");
	
	ТекущаяСтрока.РасходГорючегоПоНормамНаЕдиницуЗаголовок = НСтр("ru = 'на ед. работы:'");
	ТекущаяСтрока.РасходГорючегоПоНормамВсегоЗаголовок = НСтр("ru = 'всего:'");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ЗаполнитьДобавленныеКолонкиТаблицыРежимов();
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыАгрегата(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура УстановитьНомераТС()
	Объект.РегистрационныйНомернойЗнак = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(Объект.Агрегат); 
	Объект.ГаражныйНомер = УчетГСМ.ПолучитьГаражныйНомерТС(Объект.Агрегат);
	
	УстановитьДанныеТС();
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеТС()
	МаркаМашины = УчетГСМ.ПолучитьМаркуТС(Объект.Агрегат); 
	ИнвентарныйНомерМашины = УчетГСМ.ИнвентарныйНомерОбъекта(Объект.Агрегат);
КонецПроцедуры	

&НаСервере
Процедура УстановитьРуководителя()
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, Объект.Организация, Объект.Дата, Объект.Подразделение);	
	Объект.РуководительПодразделения = Руководитель.ОтветственноеЛицоСсылка;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеСотрудника(ДанныеСотрудника)
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
	КодПодразделения = "";
	Если ЗначениеЗаполнено(ДанныеСотрудника.Подразделение) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСотрудника.Подразделение, "Код");
		КодПодразделения = СтруктураДанных.Код;
	Иначе
		КодПодразделения = "";
	КонецЕсли;
	ДанныеСотрудника.Вставить("КодПодразделения", КодПодразделения);

	Возврат ДанныеСотрудника;
КонецФункции

&НаСервере
Процедура УстановитьСрокДействияПоУмолчанию()
	Объект.СрокДействия = КонецДня(Объект.Дата + 24*86400);
КонецПроцедуры	

&НаСервере
Процедура ПрочитатьРежимыЗаполненияДанных()
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	СтруктураРежимовЗаполнения = УчетГСМ.РежимыНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты, ИдентификаторДокумента, Объект.Агрегат);
	ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
	ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = СтруктураРежимовЗаполнения.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
КонецПроцедуры

&НаСервере
Процедура МашинаПриИзмененииНаСервере()

	УстановитьНомераТС();
	ЗаполнитьНастройкиЗаполненияДокумента(Объект.Агрегат);
	
	//заполнение остатков горючего
	Если ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ ИЛИ ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ Тогда
		Если ЗначениеЗаполнено(Объект.Агрегат) Тогда 
			ЗаполнитьДанныеОбОстаткахГорючего(ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ, ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ);
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Объект.РуководительПодразделения) Тогда
		УстановитьРуководителя();
	КонецЕсли;	
	
	ЗаполнитьСписокВыбораМОЛ();
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДвижениеГорючего(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеВидаГСМ(ВидГСМ)
	Возврат УчетГСМ.ПолучитьДанныеВидаГСМ(ВидГСМ);
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатуры(Номенклатура)
	Возврат УчетГСМ.ПолучитьДанныеНоменклатуры(Номенклатура);
КонецФункции

&НаСервере
Функция ПолучитьНаименованиеКультуры(Номенклатура)
	Возврат УчетГСМ.ПолучитьНаименованиеКультуры(Номенклатура);
КонецФункции

&НаСервере
Функция ПолучитьНаименованиеАгрегата(Оборудование)
	Возврат УчетГСМ.ПолучитьНаименованиеКультуры(Оборудование);
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораМОЛ()
	Если НЕ ЗначениеЗаполнено(Объект.Агрегат)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	ТаблицаМОЛ = УчетГСМ.ДанныеНастроекВодителиТС(Объект.Организация, Объект.Агрегат);
	Элементы.Машинист.СписокВыбора.Очистить();
	Для каждого ТекСтрока Из ТаблицаМОЛ Цикл
		Элементы.Машинист.СписокВыбора.Добавить(ТекСтрока.Водитель);
	КонецЦикла;
КонецПроцедуры	

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

