#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Выпуск продукции");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииПечати

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВыпускПродукции";
	КомандаПечати.Идентификатор		= "Накладная0504204_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВыпускПродукции";
	КомандаПечати.Идентификатор		= "Накладная0504204_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", , Истина);
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "ТребованиеНакладная0510451_100н", 3);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВыпускПродукции";
	КомандаПечати.Идентификатор		= "ТребованиеНакладнаяМ11";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Требование-накладная (М-11)'");
	КомандаПечати.Порядок			= 99;
	ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати(КомандаПечати);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - ТаблицаЗначений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ТребованиеНакладнаяМ11") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ТребованиеНакладнаяМ11","Требование-накладная (М-11)",ПечатьМ11(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_103н",
			"Требование-накладная (ф. 0504204) (ред. 103н)",
			ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204_103н"));
		
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_52н",
			"Требование-накладная (ф. 0504204) (ред. 52н)",
			ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204"));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

Функция ТекстЗапросаШапкиДляПечатиТребованияНакладной0510451() Экспорт
	
	Возврат
	"ВЫБРАТЬ
	|	ВыпускПродукции.Ссылка КАК Ссылка,
	|	ВыпускПродукции.Номер КАК Номер,
	|	ВыпускПродукции.Дата КАК Дата,
	|	ВыпускПродукции.Организация КАК Организация,
	|	ВыпускПродукции.Подразделение.Наименование КАК НаименованиеОтправитель,
	|	ВыпускПродукции.ЦМООтправитель.Сотрудник КАК СотрудникОтправитель,
	|	ВыпускПродукции.ЦМООтправитель.МестоХранения КАК МестоХраненияОтправитель,
	|	ВыпускПродукции.ПодразделениеПолучатель.Наименование КАК НаименованиеПолучатель,
	|	ВыпускПродукции.ЦМО.Сотрудник КАК СотрудникПолучатель,
	|	ВыпускПродукции.ЦМО.МестоХранения КАК МестоХраненияПолучатель,
	|	ВыпускПродукции.ДокументОснованиеВид КАК ДокументОснование,
	|	ВыпускПродукции.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ВыпускПродукции.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ВыпускПродукции.Затребовал КАК Затребовал,
	|	ВыпускПродукции.ОтпускРазрешил КАК ОтпускРазрешил,
	|	ВыпускПродукции.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ВыпускПродукции.ИФО КАК ИФО,
	|	ВыпускПродукции.Руководитель КАК УполномоченноеЛицо,
	|	ИСТИНА КАК СуммаУказанаВДокументе
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Ссылка В (&МассивОбъектов)";
	
КонецФункции

Функция ТекстЗапросаТаблицДляПечатиТребованияНакладной0510451() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Материалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА Материалы.Номенклатура.Наименование
	|		ИНАЧЕ Материалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НФАНаименование,
	|	Материалы.Номенклатура.НаименованиеДополнительное КАК НФАДопНаименование,
	|	Материалы.Номенклатура.НоменклатурныйНомер КАК НомерНоменклатурный,
	|	Материалы.ЕдиницаИзмерения.Код КАК ЕдИзмКод,
	|	Материалы.ЕдиницаИзмерения.НаименованиеПолное КАК ЕдИзмНаименование,
	|	Материалы.Количество КАК Затребовано,
	|	Материалы.Количество КАК Количество,
	|	Материалы.ПлановаяЦена КАК Цена,
	|	Материалы.Сумма КАК Сумма,
	|	Материалы.КПСДт КАК КПС,
	|	Материалы.СчетДт КАК СчетУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДополнительнаяАналитикаСчета,
	|	Материалы.КЭК КАК КЭК,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	Материалы.Номенклатура.Код КАК НФАКод,
	|	Материалы.Ссылка.КФО КАК КФО
	|ИЗ
	|	Документ.ВыпускПродукции.ГотоваяПродукция КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В (&МассивОбъектов)";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВыпускПродукцииДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	ВыпускПродукцииДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	ВыпускПродукцииДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	ВыпускПродукцииДрагоценныеМатериалы.Ссылка.Организация,
	 |	ВыпускПродукцииДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ВыпускПродукцииДрагоценныеМатериалы.ВидДрагМатериала,
	 |	ВыпускПродукцииДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	ВыпускПродукцииДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	ВыпускПродукцииДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	ВыпускПродукцииДрагоценныеМатериалы.ЕдИзм
	 |ИЗ
	 |	Документ.ВыпускПродукции.ДрагоценныеМатериалы КАК ВыпускПродукцииДрагоценныеМатериалы
	 |ГДЕ
	 |	ВыпускПродукцииДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И ВыпускПродукцииДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
КонецПроцедуры	

Функция ПечатьМ11(МассивОбъектов, ОбъектыПечати)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПродукции.Дата КАК Дата,
	|	ВыпускПродукции.Номер КАК Номер,
	|	ВыпускПродукции.Проведен КАК Проведен,
	|	ВыпускПродукции.Организация КАК Организация,
	|	ВыпускПродукции.ИФО КАК ИФО,
	|	ВыпускПродукции.СчетПроизводства.Код КАК пКоррСчет,
	|	ВыпускПродукции.ЦМО КАК ЦМО,
	|	ВыпускПродукции.ЦМООтправитель КАК ЦМООтправитель,
	|	ВыпускПродукции.Ссылка КАК Ссылка,
	|	ВыпускПродукции.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	ВыпускПродукции.Организация.КодОКПО КАК пКодОКПО,
	|	ВыпускПродукции.ЦМО.Сотрудник КАК МолПолучатель,
	|	ВыпускПродукции.ЦМООтправитель.Сотрудник КАК МолОтправитель,
	|	ВыпускПродукции.Подразделение.Наименование КАК пПодразделениеОтправитель,
	|	ВыпускПродукции.Подразделение.Код КАК пПодразделениеОтправительКод,
	|	ВыпускПродукции.ПодразделениеПолучатель.Наименование КАК пПодразделениеПолучатель,
	|	ВыпускПродукции.ПодразделениеПолучатель.Код КАК пПодразделениеПолучательКод,
	|	ВыпускПродукции.ОтпускРазрешил КАК ОтпускРазрешил
	|ИЗ
	|	Документ.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыпускПродукцииГотоваяПродукция.Ссылка КАК Ссылка,
	|	ВыпускПродукцииГотоваяПродукция.НомерСтроки КАК НомерСтроки,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура КАК Номенклатура,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.Код КАК пКодМЦ,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.Наименование КАК пНоменклатура,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.НоменклатурныйНомер КАК пНоменклатурныйНомер,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.ЕдиницаИзмерения.Код КАК пКодЕдиницы,
	|	ВыпускПродукцииГотоваяПродукция.Номенклатура.ЕдиницаИзмерения.Наименование КАК пЕдиница,
	|	ВыпускПродукцииГотоваяПродукция.Количество КАК пЗатребовано,
	|	ВыпускПродукцииГотоваяПродукция.Количество КАК пКоличество,
	|	ВЫБОР
	|		КОГДА ВыпускПродукцииГотоваяПродукция.Количество = 0
	|			ТОГДА ВыпускПродукцииГотоваяПродукция.Сумма
	|		ИНАЧЕ ВыпускПродукцииГотоваяПродукция.Сумма / ВыпускПродукцииГотоваяПродукция.Количество
	|	КОНЕЦ КАК пЦена,
	|	ВыпускПродукцииГотоваяПродукция.Сумма КАК пСумма,
	|	ВЫРАЗИТЬ(ВыпускПродукцииГотоваяПродукция.СчетДт КАК ПланСчетов.ЕПСБУ) КАК Счет,
	|	ВыпускПродукцииГотоваяПродукция.КЭК.Код КАК КЭК,
	|	ВыпускПродукцииГотоваяПродукция.Ссылка.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ВыпускПродукцииГотоваяПродукция.КПСДт = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА ВыпускПродукцииГотоваяПродукция.Ссылка.КПС
	|		ИНАЧЕ ВыпускПродукцииГотоваяПродукция.КПСДт
	|	КОНЕЦ КАК КПС
	|ИЗ
