#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Контрагент,
	ДокументОбъект.Контрагент,
	Форма.Элементы.ГруппаКонтрагент);
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти    

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
    	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента    

//  Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЗаявкаНаВозврат") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
КонецФункции	

Процедура ОтразитьРезультатОбработкиДокументаЕБП(ДокументСсылка, ДанныеКОбработке, ИнформацияОбОшибке = "", ЕстьВложения) Экспорт
	
	// Документ создается в ЕБП и выгружается в конечном статусе.
	// Повторная загрузка существующего документа невозможна
	
	ИнформацияОбОшибке = НСтр("ru = 'РСКП с идентификатором (%1), уже существует, обработка невозможна.'") + "
	|" + НСтр("ru = 'Документ: %2'"); ;
	ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ДокументСсылка.УникальныйИдентификатор(), ДокументСсылка); 
	
КонецПроцедуры

Процедура СоздатьНовыйРСКППоДаннымЕБП(ДанныеКОбработке, Организация, ИнформацияОбОшибке = "", РСКПСсылка, ЕстьВложения) Экспорт 
	
	ДопустимыеОснования = Новый Массив;
	ДопустимыеОснования.Добавить("Платежное поручение (входящее)");
	ДопустимыеОснования.Добавить("Поручение о перечислении (входящее)");
	ДопустимыеОснования.Добавить("Соглашение");
	ДопустимыеОснования.Добавить("Заявление");
	ДопустимыеОснования.Добавить("Договор");
	ДопустимыеОснования.Добавить("Контракт");
	
	ТекстСтатусаЕБП = "";
	Если НЕ ДанныеКОбработке.Свойство("СтатусРСКП", ТекстСтатусаЕБП) Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Не указан статус РСКП, присвоенный в ЕБП, обработка невозможна.'"); 
	Иначе  
		НовыйСтатусДокумента = ПлатежноРасчетныеДокументы.СтатусДокументаЕБП(ТекстСтатусаЕБП); 
		Если НовыйСтатусДокумента = Неопределено Тогда
			ИнформацияОбОшибке = НСтр("ru = 'Не удалось определить статус РСКП, присвоенный в ЕБП (%1), обработка невозможна.'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ТекстСтатусаЕБП); 
		ИначеЕсли НЕ (НовыйСтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")) Тогда
			ИнформацияОбОшибке = НСтр("ru = 'Документ может быть загружен только в статусе ""Исполнен"". Текущий статус: ""%1"".'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ТекстСтатусаЕБП); 
		КонецЕсли;  
	КонецЕсли;
	Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Не удалось создать РСКП (возврат) по переданным данным'"); 
		Возврат;
	КонецЕсли;  
	// Проверка наличия лицевого счета. Лицевой счет должен быть заведен до формирования документов.
	ЛицевойСчетДляЗагрузки = Справочники.ЛицевыеСчета.ЛицевойСчетПоНомеру(ДанныеКОбработке.ЛицевойСчет, Организация);
	Если Не ЗначениеЗаполнено(ЛицевойСчетДляЗагрузки) Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Не найден лицевой счет № %1. Документ %2 от %3 ID %4 не может быть обработан'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ИнформацияОбОшибке, 
		ДанныеКОбработке.ЛицевойСчет, 
		ДанныеКОбработке.НомерРСКП, 
		ДанныеКОбработке.ДатаРСКП, 
		ДанныеКОбработке.СсылкаВнешняя);
		Возврат;
	КонецЕсли; 
	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы.РСКПВозврат.СоздатьДокумент(); 
		НовыйДокумент.УстановитьСсылкуНового(РСКПСсылка); 
		НовыйДокумент.Заблокировать();  
		
		НовыйДокумент.Внешнее = Истина;
		НовыйДокумент.Организация = Организация; 
		НовыйДокумент.МодульИнтеграции = ДанныеКОбработке.МодульИнтеграции;
		
		//ЛицевойСчет   
		НовыйДокумент.ЛицевойСчет = ЛицевойСчетДляЗагрузки;
		
		ВидПлатежа = "";
		ДанныеКОбработке.Свойство("ВидПлатежа", ВидПлатежа);
		НовыйДокумент.ВидПлатежа = БиблиотекаФункцийОбмена.СтрокаВидаПлатежа(ВидПлатежа);
		НовыйДокумент.Дата = ТекущаяДатаСеанса(); 
		НовыйДокумент.ДатаРСКП = ДанныеКОбработке.ДатаРСКП; 
		НовыйДокумент.НомерРСКП = ДанныеКОбработке.НомерРСКП;  
		НовыйДокумент.ОчередностьПлатежа = ДанныеКОбработке.ОчередностьПлатежа; 
		НовыйДокумент.НазначениеПлатежа = ДанныеКОбработке.НазначениеПлатежа;
		
		НовыйДокумент.ВалютаДокумента = БиблиотекаФункцийОбмена.Валюта(ДанныеКОбработке.КодВалюты, "Код"); 
		Если НЕ ЗначениеЗаполнено(НовыйДокумент.ВалютаДокумента) Тогда
			НовыйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли; 
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(НовыйДокумент.ВалютаДокумента, НовыйДокумент.ДатаРСКП);
		НовыйДокумент.Курс	= КурсКратность.Курс;
		НовыйДокумент.Кратность = КурсКратность.Кратность;
		ВРублях = НовыйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		
		НовыйДокумент.СуммаДокументаВВалюте = ДанныеКОбработке.СуммаДокументаВВалюте;
		Если ВРублях Тогда
			НовыйДокумент.СуммаДокумента = НовыйДокумент.СуммаДокументаВВалюте;
		Иначе
			ДанныеКОбработке.Свойство("СуммаДокументаВРублях", НовыйДокумент.СуммаДокумента);
		КонецЕсли; 
		
		ВидВозврата = "";  
		ДанныеКОбработке.Свойство("ВидВозврата", ВидВозврата);  
		НовыйДокумент.ВидВозврата = ОбщегоНазначенияБГУ.ЗначениеПеречисленияПоСинониму("ВидыВозвратовЕБП", СокрЛП(ВидВозврата)); 
				
		Если НовыйДокумент.ВидВозврата = ПредопределенноеЗначение("Перечисление.ВидыВозвратовЕБП.ОстаткиСубсидийПрошлыхЛет") Тогда
			НовыйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("303.00", НовыйДокумент.Дата, Организация);
		ИначеЕсли НовыйДокумент.ВидВозврата = ПредопределенноеЗначение("Перечисление.ВидыВозвратовЕБП.ОбеспечениеКонтракта") Тогда	
			НовыйДокумент.КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();  
		Иначе	 
			НовыйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("205.00", НовыйДокумент.Дата, Организация);
		КонецЕсли;	 

		ЭтоКазенное = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, НовыйДокумент.Дата).ЭтоКазенноеУчреждение; 
		
		// Контрагент
		ДанныеКОбработке.Свойство("ВидБКПолучателя", НовыйДокумент.ВидБКПолучателя);
		ДанныеКОбработке.Свойство("КодБКПолучателя", НовыйДокумент.КодБКПолучателя);   
		ДанныеКОбработке.Свойство("КонтрагентУИНУИП", НовыйДокумент.УИНУИППолучателя);
		КонтрагентКодПоступленияЕБП = "";
		Если ДанныеКОбработке.Свойство("КонтрагентКодПоступленияЕБП", КонтрагентКодПоступленияЕБП) Тогда
			Если НЕ Метаданные.Перечисления.КодыПоступленийЕБП.ЗначенияПеречисления.Найти(КонтрагентКодПоступленияЕБП) = Неопределено Тогда
				НовыйДокумент.КодПоступленияЕБППолучателя = Перечисления.КодыПоступленийЕБП[КонтрагентКодПоступленияЕБП]; 	
			КонецЕсли;	
		КонецЕсли;    
		ДанныеКОбработке.Свойство("КонтрагентБанковскийСчет", НовыйДокумент.КонтрагентБанковскийСчет);
		ДанныеКОбработке.Свойство("КонтрагентБИКБанка", НовыйДокумент.КонтрагентБИКБанка);   
		ДанныеКОбработке.Свойство("КонтрагентКорСчетБанка", НовыйДокумент.КонтрагентКорСчетБанка); 
		ДанныеКОбработке.Свойство("КонтрагентЛицевойСчет", НовыйДокумент.КонтрагентЛицевойСчет);
		ДанныеКОбработке.Свойство("КонтрагентНаименованиеБанка", НовыйДокумент.КонтрагентНаименованиеБанка);
		ДанныеКОбработке.Свойство("КонтрагентНаименование", НовыйДокумент.КонтрагентНаименование); 
		ДанныеКОбработке.Свойство("КонтрагентИНН", НовыйДокумент.КонтрагентИНН);
		ДанныеКОбработке.Свойство("КонтрагентКПП", НовыйДокумент.КонтрагентКПП);
		
		КонтрагентНаименование = "";
		КонтрагентФИО = "";
		Если ЗначениеЗаполнено(НовыйДокумент.КонтрагентИНН) Тогда
			Если СтрДлина(НовыйДокумент.КонтрагентИНН) = 12 Тогда
				КонтрагентНаименование = "";
				КонтрагентФИО = НовыйДокумент.КонтрагентНаименование;
			Иначе
				КонтрагентНаименование = НовыйДокумент.КонтрагентНаименование;			
				КонтрагентФИО = ""; 
			КонецЕсли;
		Иначе // считаем, что физлицо
			КонтрагентНаименование = "";
			КонтрагентФИО = НовыйДокумент.КонтрагентНаименование;
		КонецЕсли;
		НовыйДокумент.Контрагент = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(НовыйДокумент.КонтрагентИНН, НовыйДокумент.КонтрагентКПП, КонтрагентНаименование, КонтрагентФИО,);
		
		// Документы - основания
		Для Каждого СтрокаОснования Из ДанныеКОбработке.РЕКВИЗИТЫДОКУМЕНТАОСНОВАНИЯ Цикл  
			СтрДок = НовыйДокумент.РеквизитыДокументаОснования.Добавить();
			СтрДок.ДокументОснованиеВид = СтрокаОснования.ДокументОснованиеВид; 
			Если ДопустимыеОснования.Найти(СтрокаОснования.ДокументОснованиеВид) = Неопределено Тогда
				ИнформацияОбОшибке = ИнформацияОбОшибке + "
				|" + НСтр("ru = 'Некорректное значение реквизита ""Вид документа-основания"" (documentType): %1'");
				ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, СтрокаОснования.ДокументОснованиеВид);
			КонецЕсли;
			СтрДок.ДокументОснованиеНомер = СтрокаОснования.ДокументОснованиеНомер;
			СтрДок.ДокументОснованиеДата = СтрокаОснования.ДокументОснованиеДата;
			СтрДок.ДокументОснованиеСумма = СтрокаОснования.СуммаВал;
			СтрДок.ИдентификаторДокументаОснования = СтрокаОснования.ИдентификаторДокументаОснования;  
			
			// Кассовое поступление, договор  
			Если СтрокаОснования.ДокументОснованиеВид = "Платежное поручение (входящее)" 
				ИЛИ СтрокаОснования.ДокументОснованиеВид = "Поручение о перечислении (входящее)" Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	ПоступлениеНаСчет.Ссылка КАК Ссылка,
				|	ПоступлениеНаСчетРасшифровкаПлатежа.Договор КАК Договор
				|ИЗ
				|	Документ.ПоступлениеНаСчет КАК ПоступлениеНаСчет
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаСчет.РасшифровкаПлатежа КАК ПоступлениеНаСчетРасшифровкаПлатежа
				|		ПО ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка = ПоступлениеНаСчет.Ссылка
				|ГДЕ
				|	ПоступлениеНаСчет.ДатаПервичногоДокумента = &ДатаПервичногоДокумента
				|	И ПоступлениеНаСчет.НомерПервичногоДокумента = &НомерПервичногоДокумента
				|	И ПоступлениеНаСчет.Организация = &Организация
				|	И ПоступлениеНаСчет.Контрагент = &Контрагент");   
				Запрос.УстановитьПараметр("ДатаПервичногоДокумента", СтрДок.ДокументОснованиеДата); 
				Запрос.УстановитьПараметр("НомерПервичногоДокумента", СтрДок.ДокументОснованиеНомер);
				Запрос.УстановитьПараметр("Организация", Организация);
				Запрос.УстановитьПараметр("Контрагент", НовыйДокумент.Контрагент); 
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда  
					СтрДок.ДокументПоступления = Выборка.Ссылка;  
					СтрДок.Договор = Выборка.Договор;
				КонецЕсли;
			Иначе // Договор
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	Договоры.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Договоры КАК Договоры
				|ГДЕ
				|	Договоры.ДатаДоговора = &ДатаДоговора
				|	И Договоры.НомерДоговора = &НомерДоговора
				|	И Договоры.Организация = &Организация");     
				Запрос.УстановитьПараметр("ДатаДоговора", СтрДок.ДокументОснованиеДата); 
				Запрос.УстановитьПараметр("НомерДоговора", СтрДок.ДокументОснованиеНомер);
				Запрос.УстановитьПараметр("Организация", Организация); 
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда  
					СтрДок.Договор = Выборка.Ссылка;
				КонецЕсли;
           КонецЕсли;
		КонецЦикла;	  
		
		// Расшифровка платежа    
		Для Каждого СтрокаРасшифровки Из ДанныеКОбработке.РАСШИФРОВКАПЛАТЕЖА Цикл 
			СтрДок = НовыйДокумент.РасшифровкаПлатежа.Добавить();
			СтрДок.ИдентификаторСтроки = Новый УникальныйИдентификатор();
			СтрДок.ИдентификаторСтрокиОснования = СтрокаРасшифровки.ИдентификаторСтрокиОснования; 
			
			// Договор
			СтрДоговор = НовыйДокумент.РеквизитыДокументаОснования.Найти(СтрДок.ИдентификаторСтрокиОснования, "ИдентификаторДокументаОснования"); 
			Если НЕ СтрДоговор = Неопределено Тогда
				СтрДок.Договор = СтрДоговор.Договор;
			КонецЕсли;
			
			// КПС
			Если ЗначениеЗаполнено(СтрокаРасшифровки.ТипКБК) Тогда
				ТипКБК = БиблиотекаФункцийОбмена.ПолучитьВидКБК(СтрокаРасшифровки.ТипКБК);	
			Иначе
				ТипКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ");
			КонецЕсли;
			Если ЭтоКазенное Тогда
				СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(СтрокаРасшифровки.КБКНазначениеПлатежа, ТипКБК,, НовыйДокумент.Дата, ИнформацияОбОшибке);
			Иначе
				СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(СтрокаРасшифровки.КБКНазначениеПлатежа, Перечисления.ВидыКБК.АУИБУ, ТипКБК, НовыйДокумент.Дата, ИнформацияОбОшибке); 
			КонецЕсли;	 
			
			// Раздел лицевого счета   
			Если ЗначениеЗаполнено(НовыйДокумент.ЛицевойСчет) Тогда 
				СтрДок.РазделЛС = Справочники.РазделыЛицевыхСчетов.РазделЛСПоКодуПоступленияЕБП(НовыйДокумент.ЛицевойСчет, СтрокаРасшифровки.РазделЛСКод, ИнформацияОбОшибке, Истина); 
			КонецЕсли;  
			
			СтрДок.КодЦели = Справочники.ВидыЦелевыхСредств.ВидЦелевыхТекстовомуКоду(СтрокаРасшифровки.КодЦели); 
			СтрДок.ОбъектФАИП = БиблиотекаФункцийОбмена.ОбъектФАИПКМИПоТекстовомуКоду(СтрокаРасшифровки.ОбъектФАИП, Организация);
			
			СтрДок.СуммаВал = СтрокаРасшифровки.СуммаВал;
			Если ВРублях Тогда
				СтрДок.Сумма = СтрДок.СуммаВал; 
			Иначе
				СтрДок.Сумма = СтрокаРасшифровки.СуммаРуб;
			КонецЕсли;  
			
			СтрДок.КодПрослеживаемости = СтрокаРасшифровки.КодПрослеживаемости;  
			
			// Добавляем одну строку в таблицу Детализация платежа
			// 
			СтрокаДетализации = НовыйДокумент.ДетализацияПлатежа.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДетализации, СтрДок); 
			СтрокаДетализации.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДетализации.РазделЛС, "КодПоступленияЕБП"));
			
		КонецЦикла;	
						
		Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
			ОтменитьТранзакцию(); 
			ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ИнформацияОбОшибке);
		Иначе
			
			НовыйДокумент.Записать(); 
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
			ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", НовыйДокумент.Ссылка); 
			Блокировка.Заблокировать();  
			
			НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(НовыйДокумент.Ссылка);
			НаборЗаписей.Прочитать(); 
			Если НаборЗаписей.Количество() = 0 Тогда
				Запись = НаборЗаписей.Добавить();
			Иначе
				Запись = НаборЗаписей[0];
			КонецЕсли;
			Запись.ПлатежноРасчетныйДокумент = НовыйДокумент.Ссылка; 
			Запись.Статус = НовыйСтатусДокумента; 
			ДатаИсполнения = Неопределено;
			ДанныеКОбработке.Свойство("ДатаИсполненияРСКП", ДатаИсполнения); 
			Если Не ЗначениеЗаполнено(ДатаИсполнения) Тогда
				ДатаИсполнения = ТекущаяДатаСеанса();  
			КонецЕсли;
			Запись.ДатаПроведения = ДатаИсполнения;
			НаборЗаписей.Записать();
			
			ЗафиксироватьТранзакцию(); 
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

#КонецЕсли
