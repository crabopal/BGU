#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Отказ = ПлатежноРасчетныеДокументы.ВыполнитьДвиженияПлатежноРасчетногоДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	// Очистка табличной части ДетализацияПлатежа от строк, не имеющих "родителя" в ТЧ 
	// РасшифровкаПлатежа 
	// Синхронизация общих реквизитов табличных частей
	//   
	
	ЛишниеСтроки = Новый Массив;
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		СтрокаСостава = РеквизитыДокументаОснования.Найти(СтрокаРасшифровки.ИдентификаторСтрокиОснования, "ИдентификаторДокументаОснования");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ДетализацияПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;	

	ЛишниеСтроки = Новый Массив;
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаСостава = РасшифровкаПлатежа.Найти(СтрокаРасшифровки.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаСостава,, "Сумма,СуммаВал,КБКНазначениеПлатежа,КодЦели");
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ДетализацияПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;	                          
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ТекстСообщения = НСтр("ru='Проведение невозможно.'"); 
		НельзяПровести = Ложь;
		
		Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
			Состав = ДетализацияПлатежа.Выгрузить(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
			Если НЕ Состав.Итог("СуммаВал") = СтрокаРасшифровки.СуммаВал Тогда  
				НельзяПровести = Истина;
				ТекстСообщения = ТекстСообщения + "
				|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В строке %1 сумма расшифровки не равна сумме детализации платежа. Не распределена сумма: %2'"),
				СтрокаРасшифровки.НомерСтроки, Формат((СтрокаРасшифровки.СуммаВал - Состав.Итог("СуммаВал")),"ЧДЦ=2"));
			КонецЕсли;  
		КонецЦикла;
		Если НЕ СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал") Тогда
			НельзяПровести = Истина;
			ТекстСообщения = ТекстСообщения + "
			|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: %1'"),
			Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2"));
		КонецЕсли;	
		
		Если НельзяПровести Тогда  
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка); 
		КонецЕсли;
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из ДетализацияПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла; 
	
	Внешнее = Ложь;  
	ДатаРСКП = "";
	НомерРСКП = "";
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли